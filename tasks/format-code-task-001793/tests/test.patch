+++ b/usercase-test-coderl/fixtures/acceptance_plugins/stateful_counter_vendor.py
@@ -0,0 +1,25 @@
+class stateful_counter_vendor(object):
+    supports = frozenset(["call"])
+    construct_calls = 0
+    cleanup_calls = 0
+    active_instances = 0
+    send_values = []
+
+    def __init__(self, config):
+        type(self).construct_calls += 1
+        type(self).active_instances += 1
+        self._next_value = 300
+        self._cleaned = False
+
+    def send(self, message):
+        self._next_value += 1
+        type(self).send_values.append(self._next_value)
+        return self._next_value
+
+    def cleanup(self):
+        type(self).cleanup_calls += 1
+        if not self._cleaned:
+            type(self).active_instances -= 1
+            self._cleaned = True
+
+
diff --git a/usercase-test-coderl/test_vendor_manager_stateful.py b/usercase-test-coderl/test_vendor_manager_stateful.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_vendor_manager_stateful.py
@@ -0,0 +1,199 @@
+import sys
+
+import pytest
+
+
+FIXTURES = "/workspace/repo/usercase-test-coderl/fixtures"
+if FIXTURES not in sys.path:
+    sys.path.insert(0, FIXTURES)
+
+from iris.vendors import IrisVendorException, IrisVendorManager
+from acceptance_plugins import retry_log
+from acceptance_plugins.cleanup_vendor import cleanup_vendor
+from acceptance_plugins.failing_vendor import failing_vendor
+from acceptance_plugins.stateful_counter_vendor import stateful_counter_vendor
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+def reset_stateful_counter_vendor():
+    stateful_counter_vendor.construct_calls = 0
+    stateful_counter_vendor.cleanup_calls = 0
+    stateful_counter_vendor.active_instances = 0
+    stateful_counter_vendor.send_values = []
+
+
+def test_dummy_default_application_wrapper_and_unknown_application_fallback():
+
+
+
+
+    manager = IrisVendorManager([{"type": "iris_dummy"}], ["dummy_app"])
+
+    assert manager.send_message({"mode": "call"}) == 1
+    assert manager.send_message({"application": "dummy app", "mode": "call"}) == 2
+    assert manager.send_message({"application": "unknown app", "mode": "call"}) == 1
+
+
+def test_single_vendor_instance_is_built_once_and_retained_across_sends():
+
+
+
+
+    reset_stateful_counter_vendor()
+    manager = IrisVendorManager(
+        [{"type": "acceptance_plugins.stateful_counter_vendor"}], []
+    )
+
+    assert stateful_counter_vendor.construct_calls == 1
+    assert stateful_counter_vendor.active_instances == 1
+    assert stateful_counter_vendor.cleanup_calls == 0
+    assert stateful_counter_vendor.send_values == []
+
+    assert manager.send_message({"mode": "call"}) == 301
+    assert manager.send_message({"mode": "call"}) == 302
+    assert stateful_counter_vendor.construct_calls == 1
+    assert stateful_counter_vendor.active_instances == 1
+    assert stateful_counter_vendor.cleanup_calls == 0
+    assert stateful_counter_vendor.send_values == [301, 302]
+
+    manager.cleanup()
+
+
+def test_vendor_is_registered_for_each_supported_mode():
+
+
+
+
+    manager = IrisVendorManager(
+        [
+            {
+                "type": "acceptance_plugins.multi_mode_vendor",
+                "returns": {"call": 401, "sms": 402},
+            }
+        ],
+        [],
+    )
+
+    assert manager.send_message({"mode": "call"}) == 401
+    assert manager.send_message({"mode": "sms"}) == 402
+
+
+def test_failed_vendor_send_retries_next_vendor_before_returning_success():
+
+
+
+
+    retry_log.events[:] = []
+    manager = IrisVendorManager(
+        [
+            {"type": "acceptance_plugins.flaky_retry_a"},
+            {"type": "acceptance_plugins.flaky_retry_b"},
+        ],
+        [],
+    )
+
+    assert manager.send_message({"mode": "call"}) == 77
+    assert retry_log.events.count("fail") == 2
+    assert retry_log.events.count("success") == 1
+    assert len(retry_log.events) == 3
+
+
+def test_exhausted_delivery_attempts_raise_specific_vendor_exception():
+
+
+
+
+    failing_vendor.attempts = 0
+    manager = IrisVendorManager([{"type": "acceptance_plugins.failing_vendor"}], [])
+
+    with pytest.raises(IrisVendorException) as exc_info:
+        manager.send_message({"mode": "call"})
+
+
+    assert str(exc_info.value).strip()
+    assert "call" in str(exc_info.value).lower()
+
+    assert failing_vendor.attempts >= 1
+
+
+def test_cleanup_calls_available_vendor_cleanup_and_ignores_missing_cleanup_twice():
+
+
+
+
+    cleanup_vendor.cleanup_calls = 0
+    manager = IrisVendorManager(
+        [
+            {"type": "acceptance_plugins.cleanup_vendor"},
+            {"type": "acceptance_plugins.no_cleanup_vendor"},
+        ],
+        [],
+    )
+
+    assert cleanup_vendor.cleanup_calls == 0
+    manager.cleanup()
+    assert cleanup_vendor.cleanup_calls == 1
+    manager.cleanup()
+
+    assert cleanup_vendor.cleanup_calls >= 1
+
+
+def test_two_managers_keep_independent_vendor_state():
+
+
+
+
+    reset_stateful_counter_vendor()
+    first = IrisVendorManager(
+        [{"type": "acceptance_plugins.stateful_counter_vendor"}], []
+    )
+    second = IrisVendorManager(
+        [{"type": "acceptance_plugins.stateful_counter_vendor"}], []
+    )
+
+    assert first.send_message({"mode": "call"}) == 301
+    assert first.send_message({"mode": "call"}) == 302
+    assert second.send_message({"mode": "call"}) == 301
+    assert stateful_counter_vendor.construct_calls == 2
+    assert stateful_counter_vendor.active_instances == 2
+    assert stateful_counter_vendor.send_values == [301, 302, 301]
+
+    first.cleanup()
+    second.cleanup()
+    assert stateful_counter_vendor.active_instances == 0
+    assert stateful_counter_vendor.cleanup_calls == 2
+
+
+def test_construct_use_cleanup_cycles_do_not_leave_vendor_instances_active():
+
+
+
+
+    reset_stateful_counter_vendor()
+
+    for _ in range(125):
+        manager = IrisVendorManager(
+            [{"type": "acceptance_plugins.stateful_counter_vendor"}], []
+        )
+        assert manager.send_message({"mode": "call"}) == 301
+        manager.cleanup()
+
+    assert stateful_counter_vendor.construct_calls == 125
+    assert stateful_counter_vendor.cleanup_calls == 125
+    assert stateful_counter_vendor.active_instances == 0
+    assert len(stateful_counter_vendor.send_values) == 125
