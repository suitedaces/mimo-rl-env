@@ -0,0 +1,367 @@
+from typing import Iterator, List
+
+import pytest
+import requests_mock
+from requests_mock import Mocker
+
+from alpaca.broker.client import BrokerClient
+from alpaca.broker.enums import (
+    ACHRelationshipStatus,
+    BankAccountType,
+    BankStatus,
+    IdentifierType,
+)
+from alpaca.broker.models import (
+    ACHRelationship,
+    Bank,
+    CreateACHRelationshipRequest,
+    CreateBankRequest,
+    CreatePlaidRelationshipRequest,
+)
+from alpaca.common.enums import BaseURL
+
+
+@pytest.fixture
+def reqmock() -> Iterator[Mocker]:
+    with requests_mock.Mocker() as m:
+        yield m
+
+
+@pytest.fixture
+def client():
+    client = BrokerClient(
+        "key-id",
+        "secret-key",
+        sandbox=True,
+    )
+    return client
+
+
+ACCOUNT_ID = "0d18ae51-3c94-4511-b412-6664530b6243"
+
+
+ACH_RELATIONSHIP_JSON = """
+{
+  "id": "794c5dba-7d3f-4f0a-8e44-1a0b1d6f9a2b",
+  "account_id": "0d18ae51-3c94-4511-b412-6664530b6243",
+  "created_at": "2022-04-12T12:00:00Z",
+  "updated_at": "2022-04-12T12:00:00Z",
+  "status": "APPROVED",
+  "account_owner_name": "John Doe",
+  "bank_account_type": "CHECKING",
+  "bank_account_number": "123456789abc",
+  "bank_routing_number": "121000358",
+  "nickname": "Bank of America Checking"
+}
+"""
+
+
+BANK_JSON = """
+{
+  "id": "9b0f0a3a-4f6e-4a3c-9c64-1b5d51d6f9a2",
+  "account_id": "0d18ae51-3c94-4511-b412-6664530b6243",
+  "created_at": "2022-04-12T12:00:00Z",
+  "updated_at": "2022-04-12T12:00:00Z",
+  "name": "my checking bank",
+  "status": "QUEUED",
+  "country": "",
+  "state_province": "",
+  "postal_code": "",
+  "city": "",
+  "street_address": "",
+  "account_number": "123456789abc",
+  "bank_code": "123456789",
+  "bank_code_type": "ABA"
+}
+"""
+
+
+
+
+
+def test_create_ach_relationship_for_account_with_raw_ach(
+    reqmock, client: BrokerClient
+):
+    reqmock.post(
+        BaseURL.BROKER_SANDBOX + f"/v1/accounts/{ACCOUNT_ID}/ach_relationships",
+        text=ACH_RELATIONSHIP_JSON,
+    )
+
+    result = client.create_ach_relationship_for_account(
+        account_id=ACCOUNT_ID,
+        ach_data=CreateACHRelationshipRequest(
+            account_owner_name="John Doe",
+            bank_account_type=BankAccountType.CHECKING,
+            bank_account_number="123456789abc",
+            bank_routing_number="121000358",
+            nickname="Bank of America Checking",
+        ),
+    )
+
+    assert reqmock.called_once
+    assert reqmock.request_history[0].method == "POST"
+
+    body = reqmock.request_history[0].json()
+    assert body["account_owner_name"] == "John Doe"
+    assert body["bank_account_type"] == "CHECKING"
+    assert body["bank_account_number"] == "123456789abc"
+    assert body["bank_routing_number"] == "121000358"
+
+    assert isinstance(result, ACHRelationship)
+    assert str(result.id) == "794c5dba-7d3f-4f0a-8e44-1a0b1d6f9a2b"
+    assert isinstance(result.status, ACHRelationshipStatus)
+    assert result.status == ACHRelationshipStatus.APPROVED
+    assert isinstance(result.bank_account_type, BankAccountType)
+    assert result.bank_account_type == BankAccountType.CHECKING
+
+
+def test_create_ach_relationship_for_account_with_plaid(
+    reqmock, client: BrokerClient
+):
+    reqmock.post(
+        BaseURL.BROKER_SANDBOX + f"/v1/accounts/{ACCOUNT_ID}/ach_relationships",
+        text=ACH_RELATIONSHIP_JSON,
+    )
+
+    result = client.create_ach_relationship_for_account(
+        account_id=ACCOUNT_ID,
+        ach_data=CreatePlaidRelationshipRequest(processor_token="processor-token-xyz"),
+    )
+
+    assert reqmock.called_once
+    assert reqmock.request_history[0].method == "POST"
+    assert reqmock.request_history[0].json()["processor_token"] == "processor-token-xyz"
+    assert isinstance(result, ACHRelationship)
+
+
+def test_create_ach_relationship_for_account_rejects_bad_data_type(
+    reqmock, client: BrokerClient
+):
+    with pytest.raises(ValueError):
+        client.create_ach_relationship_for_account(
+            account_id=ACCOUNT_ID,
+            ach_data={"account_owner_name": "John Doe"},
+        )
+
+    assert not reqmock.called
+
+
+def test_create_ach_relationship_for_account_validates_account_id(
+    reqmock, client: BrokerClient
+):
+    with pytest.raises(ValueError):
+        client.create_ach_relationship_for_account(
+            account_id="not a uuid",
+            ach_data=CreatePlaidRelationshipRequest(processor_token="tok"),
+        )
+
+    assert not reqmock.called
+
+
+def test_get_ach_relationships_for_account_no_statuses(reqmock, client: BrokerClient):
+    reqmock.get(
+        BaseURL.BROKER_SANDBOX + f"/v1/accounts/{ACCOUNT_ID}/ach_relationships",
+        text=f"[{ACH_RELATIONSHIP_JSON}]",
+    )
+
+    result = client.get_ach_relationships_for_account(account_id=ACCOUNT_ID)
+
+    assert reqmock.called_once
+    assert reqmock.request_history[0].method == "GET"
+    assert "statuses" not in reqmock.request_history[0].qs
+    assert isinstance(result, List)
+    assert len(result) == 1
+    assert isinstance(result[0], ACHRelationship)
+
+
+def test_get_ach_relationships_for_account_with_statuses(
+    reqmock, client: BrokerClient
+):
+    reqmock.get(
+        BaseURL.BROKER_SANDBOX + f"/v1/accounts/{ACCOUNT_ID}/ach_relationships",
+        text=f"[{ACH_RELATIONSHIP_JSON}]",
+    )
+
+    client.get_ach_relationships_for_account(
+        account_id=ACCOUNT_ID,
+        statuses=[ACHRelationshipStatus.APPROVED, ACHRelationshipStatus.PENDING],
+    )
+
+    assert reqmock.called_once
+
+    assert reqmock.request_history[0].qs == {"statuses": ["approved,pending"]}
+
+
+def test_get_ach_relationships_for_account_validates_account_id(
+    reqmock, client: BrokerClient
+):
+    with pytest.raises(ValueError):
+        client.get_ach_relationships_for_account(account_id="not a uuid")
+
+    assert not reqmock.called
+
+
+def test_delete_ach_relationship_for_account(reqmock, client: BrokerClient):
+    relationship_id = "794c5dba-7d3f-4f0a-8e44-1a0b1d6f9a2b"
+    reqmock.delete(
+        BaseURL.BROKER_SANDBOX
+        + f"/v1/accounts/{ACCOUNT_ID}/ach_relationships/{relationship_id}",
+        status_code=204,
+    )
+
+    result = client.delete_ach_relationship_for_account(
+        account_id=ACCOUNT_ID,
+        ach_relationship_id=relationship_id,
+    )
+
+    assert reqmock.called_once
+    assert reqmock.request_history[0].method == "DELETE"
+    assert result is None
+
+
+def test_delete_ach_relationship_for_account_validates_uuids(
+    reqmock, client: BrokerClient
+):
+    valid = "794c5dba-7d3f-4f0a-8e44-1a0b1d6f9a2b"
+
+    with pytest.raises(ValueError):
+        client.delete_ach_relationship_for_account(
+            account_id=ACCOUNT_ID, ach_relationship_id="not a uuid"
+        )
+
+    with pytest.raises(ValueError):
+        client.delete_ach_relationship_for_account(
+            account_id="not a uuid", ach_relationship_id=valid
+        )
+
+    assert not reqmock.called
+
+
+
+
+
+def test_create_bank_for_account(reqmock, client: BrokerClient):
+    reqmock.post(
+        BaseURL.BROKER_SANDBOX + f"/v1/accounts/{ACCOUNT_ID}/recipient_banks",
+        text=BANK_JSON,
+    )
+
+    result = client.create_bank_for_account(
+        account_id=ACCOUNT_ID,
+        bank_data=CreateBankRequest(
+            name="my checking bank",
+            bank_code_type=IdentifierType.ABA,
+            bank_code="123456789",
+            account_number="123456789abc",
+        ),
+    )
+
+    assert reqmock.called_once
+    assert reqmock.request_history[0].method == "POST"
+
+    body = reqmock.request_history[0].json()
+    assert body["name"] == "my checking bank"
+    assert body["bank_code_type"] == "ABA"
+    assert body["bank_code"] == "123456789"
+    assert body["account_number"] == "123456789abc"
+
+    assert isinstance(result, Bank)
+    assert str(result.id) == "9b0f0a3a-4f6e-4a3c-9c64-1b5d51d6f9a2"
+    assert isinstance(result.status, BankStatus)
+    assert result.status == BankStatus.QUEUED
+    assert isinstance(result.bank_code_type, IdentifierType)
+    assert result.bank_code_type == IdentifierType.ABA
+
+
+def test_get_banks_for_account(reqmock, client: BrokerClient):
+    reqmock.get(
+        BaseURL.BROKER_SANDBOX + f"/v1/accounts/{ACCOUNT_ID}/recipient_banks",
+        text=f"[{BANK_JSON}]",
+    )
+
+    result = client.get_banks_for_account(account_id=ACCOUNT_ID)
+
+    assert reqmock.called_once
+    assert reqmock.request_history[0].method == "GET"
+    assert isinstance(result, List)
+    assert len(result) == 1
+    assert isinstance(result[0], Bank)
+
+
+def test_delete_bank_for_account(reqmock, client: BrokerClient):
+    bank_id = "9b0f0a3a-4f6e-4a3c-9c64-1b5d51d6f9a2"
+    reqmock.delete(
+        BaseURL.BROKER_SANDBOX + f"/v1/accounts/{ACCOUNT_ID}/recipient_banks/{bank_id}",
+        status_code=204,
+    )
+
+    result = client.delete_bank_for_account(account_id=ACCOUNT_ID, bank_id=bank_id)
+
+    assert reqmock.called_once
+    assert reqmock.request_history[0].method == "DELETE"
+    assert result is None
+
+
+def test_delete_bank_for_account_validates_uuids(reqmock, client: BrokerClient):
+    valid = "9b0f0a3a-4f6e-4a3c-9c64-1b5d51d6f9a2"
+
+    with pytest.raises(ValueError):
+        client.delete_bank_for_account(account_id=ACCOUNT_ID, bank_id="not a uuid")
+
+    with pytest.raises(ValueError):
+        client.delete_bank_for_account(account_id="not a uuid", bank_id=valid)
+
+    assert not reqmock.called
+
+
+
+
+
+def test_create_bank_request_domestic_is_valid():
+    request = CreateBankRequest(
+        name="my checking bank",
+        bank_code_type=IdentifierType.ABA,
+        bank_code="123456789",
+        account_number="123456789abc",
+    )
+
+    assert request.bank_code_type == IdentifierType.ABA
+
+
+def test_create_bank_request_domestic_rejects_international_fields():
+    with pytest.raises(ValueError):
+        CreateBankRequest(
+            name="my checking bank",
+            bank_code_type=IdentifierType.ABA,
+            bank_code="123456789",
+            account_number="123456789abc",
+            country="USA",
+        )
+
+
+def test_create_bank_request_international_is_valid():
+    request = CreateBankRequest(
+        name="my international bank",
+        bank_code_type=IdentifierType.BIC,
+        bank_code="BUKBGB22",
+        account_number="123456789abc",
+        country="United Kingdom",
+        state_province="England",
+        postal_code="E14 5HP",
+        city="London",
+        street_address="1 Churchill Place",
+    )
+
+    assert request.bank_code_type == IdentifierType.BIC
+
+
+def test_create_bank_request_international_requires_location_fields():
+    with pytest.raises(ValueError):
+        CreateBankRequest(
+            name="my international bank",
+            bank_code_type=IdentifierType.BIC,
+            bank_code="BUKBGB22",
+            account_number="123456789abc",
+            country="United Kingdom",
+
+        )
