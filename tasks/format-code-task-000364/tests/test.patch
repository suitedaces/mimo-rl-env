+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+PYTEST="/testbed/.build_env/.venv/bin/python -m pytest"
+
+
+$PYTEST \
+    tests/broker/broker_client/test_documents_routes.py \
+    tests/broker/broker_client/test_accounts_routes.py \
+    tests/broker/broker_client/test_account_activities_routes.py \
+    tests/broker/test_models.py \
+    tests/broker/test_enums.py \
+    -q
+
+
+$PYTEST tests/broker/broker_client/test_funding_routes.py -q
