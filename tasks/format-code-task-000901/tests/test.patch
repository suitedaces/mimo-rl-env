+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+CACHED="$(ls /root/go/pkg/mod/cache/download/github.com/ethereum-optimism/op-geth/@v/*.zip 2>/dev/null | head -1 | sed -E 's#.*/(v[^/]+)\.zip#\1#')"
+if [ -n "${CACHED}" ]; then
+    go mod edit -replace "github.com/ethereum/go-ethereum@v1.12.0=github.com/ethereum-optimism/op-geth@${CACHED}"
+    GOFLAGS=-mod=mod GOPROXY=off GOSUMDB=off go mod download github.com/ethereum/go-ethereum
+fi
+
+
+
+GOPROXY=off GOSUMDB=off go test -skip 'TestOPB04' ./op-service/eth/
+
+
+GOPROXY=off GOSUMDB=off go test -run 'TestProtocolVersion' ./op-service/eth/
