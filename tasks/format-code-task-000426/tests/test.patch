diff --git a/usercase-test-coderl/stats_reducer.test.js b/usercase-test-coderl/stats_reducer.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/stats_reducer.test.js
@@ -0,0 +1,351 @@
+
+
+
+
+
+
+
+
+
+
+'use strict';
+
+const assert = require('assert');
+const os = require('os');
+const path = require('path');
+
+const PouchDB = require('../packages/node_modules/pouchdb-node');
+
+const TMP_ROOT = os.tmpdir();
+const DB_PREFIX = 'coderl-pouchdb-stats-';
+let dbCounter = 0;
+
+function nextDbName(label) {
+  dbCounter += 1;
+  return path.join(TMP_ROOT, `${DB_PREFIX}${process.pid}-${Date.now()}-${dbCounter}-${label}`);
+}
+
+async function destroyByName(name) {
+  try {
+    await new PouchDB(name).destroy();
+  } catch (error) {
+
+  }
+}
+
+async function withDb(label, fn) {
+  const name = nextDbName(label);
+  const db = new PouchDB(name);
+  try {
+    await fn(db, name);
+  } finally {
+    try {
+      await db.close();
+    } catch (error) {
+
+    }
+    await destroyByName(name);
+  }
+}
+
+const EMPTY_STATS_VALUE = {sum: 0, min: null, max: null, count: 0, sumsqr: 0};
+
+function assertGroupedRows(result, expectedByKey) {
+  assert.ok(result && Array.isArray(result.rows));
+  assert.strictEqual(result.rows.length, expectedByKey.length);
+  for (const [key, expectedValue] of expectedByKey) {
+    const row = result.rows.find((candidate) => candidate.key === key);
+    assert.ok(row, `expected grouped row for key ${key}`);
+    assert.deepStrictEqual(row.value, expectedValue);
+  }
+}
+
+async function assertInvalidStatsQuery(db, docs) {
+  await db.bulkDocs({docs});
+  let rejected = false;
+  try {
+    await db.query({
+      map: function (doc) {
+        emit('bad', doc.v);
+      },
+      reduce: '_stats'
+    }, {reduce: true, group_level: 999});
+  } catch (error) {
+    rejected = true;
+  }
+
+  assert.strictEqual(rejected, true);
+}
+
+describe('usercase _stats reducer acceptance', function () {
+  this.timeout(60000);
+
+  it('groups scalar number emits and updates after later writes', async function () {
+
+
+
+
+    await withDb('scalar', async (db) => {
+      await db.bulkDocs({
+        docs: [
+          {_id: 'a', val: 'bar'},
+          {_id: 'b', val: 'bar'},
+          {_id: 'c', val: 'baz'}
+        ]
+      });
+
+      const first = await db.query({
+        map: function (doc) {
+          emit(doc.val, 1);
+        },
+        reduce: '_stats'
+      }, {reduce: true, group_level: 999});
+
+      assertGroupedRows(first, [
+        ['bar', {sum: 2, min: 1, max: 1, count: 2, sumsqr: 2}],
+        ['baz', {sum: 1, min: 1, max: 1, count: 1, sumsqr: 1}]
+      ]);
+
+      await db.bulkDocs({docs: [{_id: 'd', val: 'bar'}]});
+      const second = await db.query({
+        map: function (doc) {
+          emit(doc.val, 1);
+        },
+        reduce: '_stats'
+      }, {reduce: true, group_level: 999});
+
+      assertGroupedRows(second, [
+        ['bar', {sum: 3, min: 1, max: 1, count: 3, sumsqr: 3}],
+        ['baz', {sum: 1, min: 1, max: 1, count: 1, sumsqr: 1}]
+      ]);
+    });
+  });
+
+  it('reduces array emits position by position', async function () {
+
+
+
+
+    await withDb('arrays', async (db) => {
+      await db.bulkDocs({
+        docs: [
+          {_id: 'one', nums: [1, 2, 3]},
+          {_id: 'two', nums: [4, 5, 6]},
+          {_id: 'three', nums: [7, 8, 9]}
+        ]
+      });
+      const result = await db.query({
+        map: function (doc) {
+          emit('all', doc.nums);
+        },
+        reduce: '_stats'
+      }, {reduce: true, group_level: 999});
+
+
+      assertGroupedRows(result, [
+        ['all', [
+          {sum: 12, min: 1, max: 7, count: 3, sumsqr: 66},
+          {sum: 15, min: 2, max: 8, count: 3, sumsqr: 93},
+          {sum: 18, min: 3, max: 9, count: 3, sumsqr: 126}
+        ]]
+      ]);
+    });
+  });
+
+  it('returns the public empty result when no values are emitted', async function () {
+
+
+
+
+    await withDb('empty', async (db) => {
+      const result = await db.query({
+        map: function (doc) {
+          emit(doc.val, 1);
+        },
+        reduce: '_stats'
+      }, {reduce: true});
+
+
+      assert.ok(result && Array.isArray(result.rows));
+      if (result.rows.length === 0) {
+        return;
+      }
+      assert.strictEqual(result.rows.length, 1);
+      assert.deepStrictEqual(result.rows[0].value, EMPTY_STATS_VALUE);
+    });
+  });
+
+  it('rejects string emitted values', async function () {
+
+
+
+
+    await withDb('string-invalid', async (db) => {
+      await assertInvalidStatsQuery(
+        db,
+        [{_id: 'a', v: 'not-a-number'}]
+      );
+    });
+  });
+
+  it('rejects mixed scalar and array emitted values', async function () {
+
+
+
+
+    await withDb('mixed-invalid', async (db) => {
+      await assertInvalidStatsQuery(
+        db,
+        [{_id: 'a', v: 1}, {_id: 'b', v: [2]}]
+      );
+    });
+  });
+
+  it('rejects arrays with inconsistent lengths', async function () {
+
+
+
+
+    await withDb('length-invalid', async (db) => {
+      await assertInvalidStatsQuery(
+        db,
+        [{_id: 'a', v: [1, 2]}, {_id: 'b', v: [3]}]
+      );
+    });
+  });
+
+  it('supports _stats queries before database cleanup', async function () {
+
+
+
+
+    const name = nextDbName('closed');
+    const db = new PouchDB(name);
+    try {
+      await db.bulkDocs({docs: [{_id: 'a', val: 'bar'}]});
+      const result = await db.query({
+        map: function (doc) {
+          emit(doc.val, 1);
+        },
+        reduce: '_stats'
+      }, {reduce: true, group_level: 999});
+
+      assertGroupedRows(result, [
+        ['bar', {sum: 1, min: 1, max: 1, count: 1, sumsqr: 1}]
+      ]);
+      await db.close();
+    } finally {
+      await destroyByName(name);
+    }
+  });
+
+  it('allows repeated public _stats query calls', async function () {
+
+
+
+
+    await withDb('repeated-query', async (db) => {
+      await db.bulkDocs({docs: [{_id: 'a', val: 'bar'}]});
+      const firstResult = await db.query({
+        map: function (doc) {
+          emit(doc.val, 1);
+        },
+        reduce: '_stats'
+      }, {reduce: true, group_level: 999});
+
+      assertGroupedRows(firstResult, [
+        ['bar', {sum: 1, min: 1, max: 1, count: 1, sumsqr: 1}]
+      ]);
+
+      const secondResult = await db.query({
+        map: function (doc) {
+          emit(doc.val, 1);
+        },
+        reduce: '_stats'
+      }, {reduce: true, group_level: 999});
+
+      assertGroupedRows(secondResult, [
+        ['bar', {sum: 1, min: 1, max: 1, count: 1, sumsqr: 1}]
+      ]);
+    });
+  });
+
+  it('keeps _stats view state independent across database instances', async function () {
+
+
+
+
+    const nameA = nextDbName('independent-a');
+    const nameB = nextDbName('independent-b');
+    const a = new PouchDB(nameA);
+    const b = new PouchDB(nameB);
+    try {
+      await a.bulkDocs({
+        docs: [
+          {_id: 'a1', val: 'bar'},
+          {_id: 'a2', val: 'bar'},
+          {_id: 'a3', val: 'baz'}
+        ]
+      });
+      await b.bulkDocs({docs: [{_id: 'b1', val: 'baz'}]});
+
+      const mapReduce = {
+        map: function (doc) {
+          emit(doc.val, 1);
+        },
+        reduce: '_stats'
+      };
+      const resultA = await a.query(mapReduce, {reduce: true, group_level: 999});
+      const resultB = await b.query(mapReduce, {reduce: true, group_level: 999});
+
+
+      assertGroupedRows(resultA, [
+        ['bar', {sum: 2, min: 1, max: 1, count: 2, sumsqr: 2}],
+        ['baz', {sum: 1, min: 1, max: 1, count: 1, sumsqr: 1}]
+      ]);
+
+      assertGroupedRows(resultB, [
+        ['baz', {sum: 1, min: 1, max: 1, count: 1, sumsqr: 1}]
+      ]);
+    } finally {
+      try {
+        await a.close();
+      } catch (error) {
+
+      }
+      try {
+        await b.close();
+      } catch (error) {
+
+      }
+      await destroyByName(nameA);
+      await destroyByName(nameB);
+    }
+  });
+
+  it('supports repeated _stats queries across database cleanup cycles', async function () {
+
+
+
+
+    const cleanupPrefix = `${DB_PREFIX}${process.pid}-cleanup-`;
+
+
+    for (let i = 0; i < 3; i += 1) {
+      const name = path.join(TMP_ROOT, `${cleanupPrefix}${i}`);
+      const db = new PouchDB(name);
+      await db.bulkDocs({docs: [{_id: 'doc', val: 'bar'}]});
+      const result = await db.query({
+        map: function (doc) {
+          emit(doc.val, 1);
+        },
+        reduce: '_stats'
+      }, {reduce: true, group_level: 999});
+
+      assertGroupedRows(result, [
+        ['bar', {sum: 1, min: 1, max: 1, count: 1, sumsqr: 1}]
+      ]);
+      await db.destroy();
+    }
+  });
+});
