+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export npm_config_audit=false
+export npm_config_fund=false
+export npm_config_update_notifier=false
+
+for module in mocha rollup rollup-plugin-node-resolve rollup-plugin-replace leveldown; do
+  node -e "require(process.argv[1])" "$module" >/dev/null
+done
+
+node ./bin/build-module.js packages/node_modules/pouchdb-node >/dev/null
+
+exec node --expose-gc ./node_modules/.bin/mocha --no-config --no-package --exit /workspace/repo/usercase-test-coderl/stats_reducer.test.js
