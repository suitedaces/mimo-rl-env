diff --git a/usercase-test-coderl/historical_plugin_test.go b/usercase-test-coderl/historical_plugin_test.go
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/historical_plugin_test.go
@@ -0,0 +1,413 @@
+package usercase_test_coderl
+
+import (
+	"errors"
+	"math/big"
+	"testing"
+
+	"cosmossdk.io/log"
+	"cosmossdk.io/store/metrics"
+	"cosmossdk.io/store/rootmulti"
+	storetypes "cosmossdk.io/store/types"
+	historical "github.com/berachain/polaris/cosmos/x/evm/plugins/historical"
+	"github.com/berachain/polaris/eth/core"
+	polarparams "github.com/berachain/polaris/eth/params"
+	cometproto "github.com/cometbft/cometbft/proto/tendermint/types"
+	dbm "github.com/cosmos/cosmos-db"
+	sdk "github.com/cosmos/cosmos-sdk/types"
+	"github.com/ethereum/go-ethereum/common"
+	ethtypes "github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/trie"
+)
+
+type session struct {
+	ctx sdk.Context
+	key storetypes.StoreKey
+	p   historical.Plugin
+}
+
+func newSession(t *testing.T, height int64) session {
+	t.Helper()
+
+	key := storetypes.NewKVStoreKey("historical_acceptance_evm")
+	db := dbm.NewMemDB()
+	logger := log.NewNopLogger()
+	ms := rootmulti.NewStore(db, logger, metrics.NewNoOpMetrics())
+	ms.MountStoreWithDB(key, storetypes.StoreTypeIAVL, db)
+	if err := ms.LoadLatestVersion(); err != nil {
+		t.Fatalf("load multistore: %v", err)
+	}
+
+	ctx := sdk.NewContext(ms, cometproto.Header{}, false, logger).WithBlockHeight(height)
+	p := historical.NewPlugin(polarparams.DefaultChainConfig, nil, nil, key)
+	return session{ctx: ctx, key: key, p: p}
+}
+
+func initGenesis(t *testing.T, s session) *ethtypes.Block {
+	t.Helper()
+
+	genesis := core.DefaultGenesis
+	genesis.Config = polarparams.DefaultChainConfig
+	if err := s.p.InitGenesis(s.ctx, genesis); err != nil {
+		t.Fatalf("init genesis: %v", err)
+	}
+	return genesis.ToBlock()
+}
+
+func prepareAtHeight(s session, height int64) session {
+	s.ctx = s.ctx.WithBlockHeight(height)
+	s.p.Prepare(sdk.WrapSDKContext(s.ctx))
+	return s
+}
+
+func blockOneFixture() (*ethtypes.Block, *ethtypes.Transaction, ethtypes.Receipts) {
+	tx := ethtypes.NewTransaction(
+		0, common.Address{0x1}, big.NewInt(1), 1000, big.NewInt(1), []byte{0x12},
+	)
+	receipts := ethtypes.Receipts{{
+		Type:              2,
+		Status:            1,
+		CumulativeGasUsed: 500,
+		ContractAddress:   common.Address{0x1},
+		GasUsed:           500,
+		BlockNumber:       big.NewInt(1),
+	}}
+	block := ethtypes.NewBlock(
+		&ethtypes.Header{Number: big.NewInt(1), GasLimit: 1000},
+		ethtypes.Transactions{tx},
+		nil,
+		receipts,
+		trie.NewStackTrie(nil),
+	)
+	return block, tx, receipts
+}
+
+func emptyBlockFixture(number uint64) *ethtypes.Block {
+	return ethtypes.NewBlock(
+		&ethtypes.Header{Number: new(big.Int).SetUint64(number), GasLimit: 1000},
+		nil,
+		nil,
+		nil,
+		trie.NewStackTrie(nil),
+	)
+}
+
+func storeBlockOne(t *testing.T, s session) (*ethtypes.Block, *ethtypes.Transaction, ethtypes.Receipts) {
+	t.Helper()
+
+	block, tx, receipts := blockOneFixture()
+	if err := s.p.StoreBlock(block); err != nil {
+		t.Fatalf("store block: %v", err)
+	}
+	if err := s.p.StoreReceipts(block.Hash(), receipts); err != nil {
+		t.Fatalf("store receipts: %v", err)
+	}
+	if err := s.p.StoreTransactions(1, block.Hash(), block.Transactions()); err != nil {
+		t.Fatalf("store transactions: %v", err)
+	}
+	return block, tx, receipts
+}
+
+func TestGenesisBlockReadableByNumberAndHash(t *testing.T) {
+
+
+	s := newSession(t, 0)
+	genesisBlock := initGenesis(t, s)
+	genesisHash := genesisBlock.Hash()
+
+	blockByNumber, err := s.p.GetBlockByNumber(0)
+	if err != nil {
+		t.Fatalf("get genesis by number: %v", err)
+	}
+	if got := blockByNumber.NumberU64(); got != 0 {
+		t.Fatalf("genesis number = %d, want 0", got)
+	}
+
+	if got := blockByNumber.Hash(); got != genesisHash {
+		t.Fatalf("genesis hash by number = %s, want %s", got.Hex(), genesisHash.Hex())
+	}
+
+	blockByHash, err := s.p.GetBlockByHash(genesisHash)
+	if err != nil {
+		t.Fatalf("get genesis by hash: %v", err)
+	}
+
+	if got := blockByHash.Hash(); got != genesisHash {
+		t.Fatalf("genesis hash by hash = %s, want %s", got.Hex(), genesisHash.Hex())
+	}
+}
+
+func TestPreparedSessionStoresAndReadsBlockReceiptsAndTransaction(t *testing.T) {
+
+
+	s := newSession(t, 0)
+	initGenesis(t, s)
+	s = prepareAtHeight(s, 1)
+
+
+	block, tx, storedReceipts := storeBlockOne(t, s)
+	blockHash := block.Hash()
+	txHash := tx.Hash()
+
+	blockByNumber, err := s.p.GetBlockByNumber(1)
+	if err != nil {
+		t.Fatalf("get block 1 by number: %v", err)
+	}
+	if got := blockByNumber.NumberU64(); got != 1 {
+		t.Fatalf("block number = %d, want 1", got)
+	}
+
+	if got := blockByNumber.Hash(); got != blockHash {
+		t.Fatalf("block hash by number = %s, want %s", got.Hex(), blockHash.Hex())
+	}
+	if got := len(blockByNumber.Transactions()); got != 1 {
+		t.Fatalf("transaction count = %d, want 1", got)
+	}
+
+	blockByHash, err := s.p.GetBlockByHash(blockHash)
+	if err != nil {
+		t.Fatalf("get block 1 by hash: %v", err)
+	}
+
+	if got := blockByHash.Hash(); got != blockHash {
+		t.Fatalf("block hash by hash = %s, want %s", got.Hex(), blockHash.Hex())
+	}
+	if got := blockByHash.NumberU64(); got != 1 {
+		t.Fatalf("block number by hash = %d, want 1", got)
+	}
+
+	entry, err := s.p.GetTransactionByHash(txHash)
+	if err != nil {
+		t.Fatalf("get tx lookup entry: %v", err)
+	}
+
+	if got := entry.Tx.Hash(); got != txHash {
+		t.Fatalf("lookup tx hash = %s, want %s", got.Hex(), txHash.Hex())
+	}
+	if got := entry.TxIndex; got != 0 {
+		t.Fatalf("lookup tx index = %d, want 0", got)
+	}
+	if got := entry.BlockNum; got != 1 {
+		t.Fatalf("lookup block num = %d, want 1", got)
+	}
+	if got := entry.BlockHash; got != blockHash {
+		t.Fatalf("lookup block hash = %s, want %s", got.Hex(), blockHash.Hex())
+	}
+
+	receipts, err := s.p.GetReceiptsByHash(blockHash)
+	if err != nil {
+		t.Fatalf("get receipts: %v", err)
+	}
+	if got := len(receipts); got != 1 {
+		t.Fatalf("receipt count = %d, want 1", got)
+	}
+	r := receipts[0]
+	storedReceipt := storedReceipts[0]
+
+	if got, want := r.Type, tx.Type(); got != want {
+		t.Fatalf("derived receipt type = %d, want %d", got, want)
+	}
+	if got, want := r.Status, storedReceipt.Status; got != want {
+		t.Fatalf("derived receipt status = %d, want %d", got, want)
+	}
+	if got, want := r.CumulativeGasUsed, storedReceipt.CumulativeGasUsed; got != want {
+		t.Fatalf("derived cumulative gas = %d, want %d", got, want)
+	}
+	if got, want := r.GasUsed, storedReceipt.GasUsed; got != want {
+		t.Fatalf("derived gas used = %d, want %d", got, want)
+	}
+
+	if got := r.TxHash; got != txHash {
+		t.Fatalf("derived receipt tx hash = %s, want %s", got.Hex(), txHash.Hex())
+	}
+
+	if got := r.BlockHash; got != blockHash {
+		t.Fatalf("derived receipt block hash = %s, want %s", got.Hex(), blockHash.Hex())
+	}
+	if got, want := r.BlockNumber.Uint64(), block.NumberU64(); got != want {
+		t.Fatalf("derived receipt block number = %d, want %d", got, want)
+	}
+	if got := r.TransactionIndex; got != 0 {
+		t.Fatalf("derived receipt tx index = %d, want 0", got)
+	}
+	if got, want := r.ContractAddress, (common.Address{}); got != want {
+		t.Fatalf("derived contract address = %s, want %s", got.Hex(), want.Hex())
+	}
+
+
+	blockTwo := emptyBlockFixture(2)
+	if err := s.p.StoreBlock(blockTwo); err != nil {
+		t.Fatalf("store in-sequence block 2: %v", err)
+	}
+	blockTwoByNumber, err := s.p.GetBlockByNumber(2)
+	if err != nil {
+		t.Fatalf("get block 2 by number: %v", err)
+	}
+	if got := blockTwoByNumber.Hash(); got != blockTwo.Hash() {
+		t.Fatalf("block 2 hash by number = %s, want %s", got.Hex(), blockTwo.Hash().Hex())
+	}
+}
+
+func TestUnknownLookupErrorsAreSpecificSentinels(t *testing.T) {
+
+
+	s := newSession(t, 0)
+	initGenesis(t, s)
+	s = prepareAtHeight(s, 1)
+	storeBlockOne(t, s)
+
+	_, blockErr := s.p.GetBlockByHash(common.HexToHash("0x99"))
+
+	if !errors.Is(blockErr, core.ErrBlockNotFound) {
+		t.Fatalf("unknown block error = %v, want core.ErrBlockNotFound", blockErr)
+	}
+
+	_, txErr := s.p.GetTransactionByHash(common.HexToHash("0x88"))
+
+	if !errors.Is(txErr, core.ErrTxNotFound) {
+		t.Fatalf("unknown tx error = %v, want core.ErrTxNotFound", txErr)
+	}
+}
+
+func TestReceiptsReportMissingReceiptAndMissingBlockErrors(t *testing.T) {
+
+
+	s := newSession(t, 0)
+	initGenesis(t, s)
+	s = prepareAtHeight(s, 1)
+
+	_, missingErr := s.p.GetReceiptsByHash(common.HexToHash("0x99"))
+
+	if missingErr == nil {
+		t.Fatal("missing receipts error = nil, want non-nil error")
+	}
+
+	_, _, receipts := blockOneFixture()
+	orphanHash := common.HexToHash("0x77")
+	if err := s.p.StoreReceipts(orphanHash, receipts); err != nil {
+		t.Fatalf("store orphan receipts: %v", err)
+	}
+	_, orphanErr := s.p.GetReceiptsByHash(orphanHash)
+
+	if !errors.Is(orphanErr, core.ErrBlockNotFound) {
+		t.Fatalf("orphan receipt error = %v, want core.ErrBlockNotFound", orphanErr)
+	}
+}
+
+func TestStoreBlockPanicsForOutOfSequenceNonGenesisWrite(t *testing.T) {
+
+
+	s := newSession(t, 0)
+	initGenesis(t, s)
+	s = prepareAtHeight(s, 2)
+
+	blockTwo := emptyBlockFixture(2)
+
+	defer func() {
+		r := recover()
+
+		if r == nil {
+			t.Fatal("StoreBlock panic = nil, want out-of-sequence panic")
+		}
+	}()
+
+	_ = s.p.StoreBlock(blockTwo)
+}
+
+func TestIndependentPluginInstancesKeepSeparateHistoricalState(t *testing.T) {
+
+
+	a := newSession(t, 0)
+	b := newSession(t, 0)
+	initGenesis(t, a)
+	initGenesis(t, b)
+	a = prepareAtHeight(a, 1)
+	b = prepareAtHeight(b, 1)
+
+	block, _, _ := storeBlockOne(t, a)
+	blockHash := block.Hash()
+
+	aBlock, err := a.p.GetBlockByHash(blockHash)
+	if err != nil {
+		t.Fatalf("get a block 1: %v", err)
+	}
+
+	if got := aBlock.Hash(); got != blockHash {
+		t.Fatalf("a block hash = %s, want %s", got.Hex(), blockHash.Hex())
+	}
+
+	_, bErr := b.p.GetBlockByHash(blockHash)
+	if !errors.Is(bErr, core.ErrBlockNotFound) {
+		t.Fatalf("b block 1 error = %v, want core.ErrBlockNotFound", bErr)
+	}
+	bGenesis, err := b.p.GetBlockByNumber(0)
+	if err != nil {
+		t.Fatalf("get b genesis: %v", err)
+	}
+	expectedBGenesis := core.DefaultGenesis
+	expectedBGenesis.Config = polarparams.DefaultChainConfig
+
+	if got, want := bGenesis.Hash(), expectedBGenesis.ToBlock().Hash(); got != want {
+		t.Fatalf("b genesis hash = %s, want %s", got.Hex(), want.Hex())
+	}
+
+
+	storeBlockOne(t, b)
+}
+
+func TestRepeatedPrepareWithSameContextIsIdempotent(t *testing.T) {
+
+
+	s := newSession(t, 0)
+	initGenesis(t, s)
+	s = prepareAtHeight(s, 1)
+	block, _, _ := storeBlockOne(t, s)
+	blockHash := block.Hash()
+
+	s.p.Prepare(sdk.WrapSDKContext(s.ctx))
+	s.p.Prepare(sdk.WrapSDKContext(s.ctx))
+
+	block, err := s.p.GetBlockByHash(blockHash)
+	if err != nil {
+		t.Fatalf("get block after repeated prepare: %v", err)
+	}
+
+	if got := block.Hash(); got != blockHash {
+		t.Fatalf("block hash after repeated prepare = %s, want %s", got.Hex(), blockHash.Hex())
+	}
+}
+
+func TestStoreBlockUpdatesSequenceThroughSequentialWrites(t *testing.T) {
+
+
+	s := newSession(t, 0)
+	initGenesis(t, s)
+	s = prepareAtHeight(s, 1)
+
+	blockOne, _, _ := blockOneFixture()
+	if err := s.p.StoreBlock(blockOne); err != nil {
+		t.Fatalf("store block 1: %v", err)
+	}
+
+
+	blockTwo := emptyBlockFixture(2)
+	if err := s.p.StoreBlock(blockTwo); err != nil {
+		t.Fatalf("store block 2 after block 1: %v", err)
+	}
+
+	blockTwoByNumber, err := s.p.GetBlockByNumber(2)
+	if err != nil {
+		t.Fatalf("get block 2 by number: %v", err)
+	}
+	if got := blockTwoByNumber.Hash(); got != blockTwo.Hash() {
+		t.Fatalf("block 2 by number hash = %s, want %s", got.Hex(), blockTwo.Hash().Hex())
+	}
+
+	blockTwoByHash, err := s.p.GetBlockByHash(blockTwo.Hash())
+	if err != nil {
+		t.Fatalf("get block 2 by hash: %v", err)
+	}
+	if got := blockTwoByHash.NumberU64(); got != 2 {
+		t.Fatalf("block 2 by hash number = %d, want 2", got)
+	}
+}
