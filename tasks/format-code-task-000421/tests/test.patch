+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+sys.path.insert(0, "/workspace/repo")
+
+from Agent_module.carbon_data import LambdaEmbedder, MemoryHit, MemoryItem, create
+
+
+VECTORS = {
+    "loves vim": [1.0, 0.0, 0.0],
+    "prefers emacs": [0.55, 0.83, 0.0],
+    "likes nano": [0.10, 0.0, 0.99],
+    "vim editor": [0.95, 0.05, 0.0],
+    "a": [1.0, 0.0, 0.0],
+    "b": [0.0, 1.0, 0.0],
+    "c": [0.0, 0.0, 1.0],
+    "doc-text": [1.0, 0.0, 0.0],
+    "mem-text": [1.0, 0.0, 0.0],
+    "old": [1.0, 0.0, 0.0],
+    "fresh": [0.4, 0.0, 0.0],
+    "q": [1.0, 0.0, 0.0],
+    "dot-high": [2.0, 0.0, 0.0],
+    "dot-low": [0.5, 0.0, 0.0],
+    "near": [0.8, 0.0, 0.0],
+    "far": [-1.0, 0.0, 0.0],
+}
+
+
+def fixed_embedder():
+    def encode(texts):
+        out = np.zeros((len(texts), 3), dtype=np.float32)
+        for i, text in enumerate(texts):
+            out[i] = np.asarray(VECTORS[text], dtype=np.float32)
+        return out
+
+    return LambdaEmbedder(encode, model="accept-model", dim=3)
+
+
+def hit_contents(hits):
+    return [hit.memory.content for hit in hits]
+
+
+def hit_scores(hits):
+    return [float(hit.score) for hit in hits]
+
+
+def assert_memory_hit_shape(hits):
+
+    assert all(isinstance(hit, MemoryHit) for hit in hits)
+    assert all(isinstance(hit.memory, MemoryItem) for hit in hits)
+    assert all(isinstance(hit.score, (int, float, np.floating)) for hit in hits)
+
+
+@pytest.fixture
+def store(tmp_path: Path):
+    s = create(tmp_path / "case.carbondata")
+    try:
+        yield s
+    finally:
+        s.close()
+
+
+def test_semantic_recall_returns_ranked_memory_hits(store):
+
+
+
+
+    emb = fixed_embedder()
+
+    store.remember("loves vim", embedder=emb, id="mem-loves-vim")
+    store.remember("prefers emacs", embedder=emb, id="mem-prefers-emacs")
+    store.remember("likes nano", embedder=emb, id="mem-likes-nano")
+
+    hits = store.recall("vim editor", top_k=3, embedder=emb)
+
+
+    assert hit_contents(hits) == ["loves vim", "prefers emacs", "likes nano"]
+    assert hit_scores(hits) == sorted(hit_scores(hits), reverse=True)
+    assert_memory_hit_shape(hits)
+
+
+def test_filters_compose_with_and_and_empty_match_returns_empty(store):
+
+
+
+
+    emb = fixed_embedder()
+    store.remember(
+        "a",
+        session_id="s1",
+        actor="bot",
+        namespace="alpha",
+        salience=0.9,
+        embedder=emb,
+        id="a-id",
+    )
+    store.remember(
+        "b",
+        session_id="s1",
+        actor="bot",
+        namespace="beta",
+        salience=0.8,
+        embedder=emb,
+        id="b-id",
+    )
+    store.remember(
+        "c",
+        session_id="s2",
+        actor="human",
+        namespace="alpha",
+        salience=0.4,
+        embedder=emb,
+        id="c-id",
+    )
+
+
+    session_hits = store.recall("a", session_id="s1", top_k=5, embedder=emb)
+    assert hit_contents(session_hits)[:1] == ["a"]
+    assert all(hit.memory.session_id == "s1" for hit in session_hits)
+    assert_memory_hit_shape(session_hits)
+
+    actor_hits = store.recall("a", actor="bot", top_k=5, embedder=emb)
+    assert hit_contents(actor_hits)[:1] == ["a"]
+    assert all(hit.memory.actor == "bot" for hit in actor_hits)
+    assert_memory_hit_shape(actor_hits)
+
+    namespace_hits = store.recall("a", namespace="alpha", top_k=5, embedder=emb)
+    assert hit_contents(namespace_hits)[:1] == ["a"]
+    assert all(hit.memory.namespace == "alpha" for hit in namespace_hits)
+    assert_memory_hit_shape(namespace_hits)
+
+    salience_hits = store.recall("a", min_salience=0.5, top_k=5, embedder=emb)
+    assert hit_contents(salience_hits)[:1] == ["a"]
+    assert all(hit.memory.salience >= 0.5 for hit in salience_hits)
+    assert_memory_hit_shape(salience_hits)
+
+    and_hits = store.recall(
+        "a",
+        session_id="s1",
+        actor="bot",
+        namespace="alpha",
+        min_salience=0.85,
+        top_k=5,
+        embedder=emb,
+    )
+    assert hit_contents(and_hits) == ["a"]
+    assert all(hit.memory.session_id == "s1" for hit in and_hits)
+    assert all(hit.memory.actor == "bot" for hit in and_hits)
+    assert all(hit.memory.namespace == "alpha" for hit in and_hits)
+    assert all(hit.memory.salience >= 0.85 for hit in and_hits)
+    assert_memory_hit_shape(and_hits)
+    assert store.recall("a", session_id="missing", top_k=5, embedder=emb) == []
+
+
+def test_recall_ignores_embedded_non_memory_entities(store):
+
+
+
+
+    emb = fixed_embedder()
+
+    store.put_entity(id="doc1", kind="document", content="doc-text")
+    store.add_chunks("doc1", ["doc-text"])
+    store.embed_chunks(emb, entity_id="doc1")
+    store.remember("mem-text", embedder=emb, id="memory1")
+
+
+    hits = store.recall("doc-text", top_k=5, embedder=emb)
+    assert hit_contents(hits) == ["mem-text"]
+    assert_memory_hit_shape(hits)
+
+
+def test_expired_memories_are_hidden_until_include_expired_is_true(store):
+
+
+
+
+    emb = fixed_embedder()
+
+    store.remember("old", expires_at=100.0, embedder=emb, id="old-id")
+    store.remember("fresh", embedder=emb, id="fresh-id")
+
+
+    default_hits = store.recall("old", top_k=5, embedder=emb)
+    assert hit_contents(default_hits) == ["fresh"]
+    assert_memory_hit_shape(default_hits)
+
+    with_expired_hits = store.recall("old", top_k=5, embedder=emb, include_expired=True)
+    assert set(hit_contents(with_expired_hits)) == {"old", "fresh"}
+    assert_memory_hit_shape(with_expired_hits)
+
+
+def test_vector_query_uses_model_without_embedder_and_dot_metric(store):
+
+
+
+
+    emb = fixed_embedder()
+
+    store.remember("dot-high", embedder=emb, id="dot-high-id")
+    store.remember("dot-low", embedder=emb, id="dot-low-id")
+
+    hits = store.recall(
+        np.array([1.0, 0.0, 0.0], dtype=np.float32),
+        model="accept-model",
+        top_k=5,
+        metric="dot",
+    )
+
+
+    assert hit_contents(hits) == ["dot-high", "dot-low"]
+    assert hit_scores(hits) == pytest.approx([2.0, 0.5])
+    assert_memory_hit_shape(hits)
+
+
+def test_l2_metric_returns_negative_distance_ranking(store):
+
+
+
+
+    emb = fixed_embedder()
+
+    store.remember("near", embedder=emb, id="near-id")
+    store.remember("far", embedder=emb, id="far-id")
+
+    hits = store.recall(
+        np.array([1.0, 0.0, 0.0], dtype=np.float32),
+        model="accept-model",
+        top_k=5,
+        metric="l2",
+    )
+
+
+    assert hit_contents(hits) == ["near", "far"]
+    assert hit_scores(hits) == pytest.approx([-0.2, -2.0])
+    assert_memory_hit_shape(hits)
+
+
+def test_string_query_requires_embedder(store):
+
+
+
+
+
+    with pytest.raises(Exception):
+        store.recall("q")
+
+
+    with pytest.raises(Exception):
+        store.recall("q", model="accept-model")
+
+
+def test_no_matching_memories_returns_empty_list(store):
+
+
+
+
+
+    emb = fixed_embedder()
+    assert store.recall("q", top_k=5, embedder=emb) == []
+
+
+def test_top_k_limits_ranked_memory_hits(store):
+
+
+
+
+
+    emb = fixed_embedder()
+    store.remember("a", embedder=emb, id="a-id")
+    store.remember("b", embedder=emb, id="b-id")
+
+    hits = store.recall("a", top_k=1, embedder=emb)
+
+    assert hit_contents(hits) == ["a"]
+    assert_memory_hit_shape(hits)
+
+
+def test_vector_query_with_model_uses_cosine_without_embedder(store):
+
+
+
+
+
+    emb = fixed_embedder()
+    store.remember("a", embedder=emb, id="a-id")
+    store.remember("b", embedder=emb, id="b-id")
+
+    hits = store.recall(
+        np.array([1.0, 0.0, 0.0], dtype=np.float32),
+        model="accept-model",
+        top_k=5,
+    )
+
+
+    assert hit_contents(hits)[:1] == ["a"]
+    assert hit_scores(hits) == sorted(hit_scores(hits), reverse=True)
+    assert_memory_hit_shape(hits)
+
+
+def test_filters_compose_to_empty_when_any_clause_rejects(store):
+
+
+
+
+
+    emb = fixed_embedder()
+    store.remember("a", session_id="s1", actor="bot", embedder=emb, id="a-id")
+    store.remember("b", session_id="s2", actor="human", embedder=emb, id="b-id")
+
+    assert store.recall("a", session_id="s1", actor="human", top_k=5, embedder=emb) == []
