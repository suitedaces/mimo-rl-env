diff --git a/tests/preprocessing/input_output/test_aminoseq.py b/tests/preprocessing/input_output/test_aminoseq.py
new file mode 100644
index 0000000..acd313b
--- /dev/null
+++ b/tests/preprocessing/input_output/test_aminoseq.py
@@ -0,0 +1,128 @@
+import pytest
+from rdkit.Chem import Mol, MolFromFASTA, MolToSmiles
+
+
+FASTA_INPUTS = [
+    ">alpha\nKWLRRVWRWWR\n",
+    ">beta\nAAAAAAAACC\n",
+    ">gamma\nTTTTTTTTTT\n",
+]
+PLAIN_INPUTS = ["KWLRRVWRWWR", "AAAAAAAACC", "TTTTTTTTTT"]
+
+
+def _smiles_list(mols):
+    return [MolToSmiles(mol) for mol in mols]
+
+
+def _rdkit_smiles(inputs, **kwargs):
+    return [MolToSmiles(MolFromFASTA(value, **kwargs)) for value in inputs]
+
+
+def test_public_imports_and_instantiation():
+    from skfp.preprocessing import MolFromAminoseqTransformer as TopLevel
+    from skfp.preprocessing.input_output import MolFromAminoseqTransformer as InputOutput
+
+    assert TopLevel is InputOutput
+    transformer = TopLevel(sanitize=False, flavor=1)
+    params = transformer.get_params()
+    assert params["sanitize"] is False
+    assert params["flavor"] == 1
+    assert callable(getattr(transformer, "transform"))
+
+
+def test_transform_accepts_mixed_fasta_and_plain_sequences():
+    from skfp.preprocessing import MolFromAminoseqTransformer
+
+    inputs = [FASTA_INPUTS[0], PLAIN_INPUTS[1], FASTA_INPUTS[2]]
+    mols = MolFromAminoseqTransformer().transform(inputs)
+    assert len(mols) == len(inputs)
+    assert all(isinstance(mol, Mol) for mol in mols)
+    assert _smiles_list(mols) == _rdkit_smiles(inputs)
+
+
+def test_plain_sequences_match_corresponding_fasta_records():
+    from skfp.preprocessing import MolFromAminoseqTransformer
+
+    fasta_mols = MolFromAminoseqTransformer().transform(FASTA_INPUTS)
+    plain_mols = MolFromAminoseqTransformer().transform(PLAIN_INPUTS)
+    assert _smiles_list(fasta_mols) == _smiles_list(plain_mols)
+
+
+def test_non_default_flavor_matches_rdkit_oracle_and_changes_result():
+    from skfp.preprocessing import MolFromAminoseqTransformer
+
+    sequence = "TTTTTTTTTT"
+    default_oracle = _rdkit_smiles([sequence], flavor=0)
+    flavor_two_oracle = _rdkit_smiles([sequence], flavor=2)
+    assert flavor_two_oracle != default_oracle
+
+    transformer_smiles = _smiles_list(
+        MolFromAminoseqTransformer(flavor=2).transform([sequence])
+    )
+    assert transformer_smiles == flavor_two_oracle
+
+
+@pytest.mark.parametrize("sanitize", [True, False])
+def test_sanitize_option_matches_rdkit_observable_behavior(sanitize):
+    from skfp.preprocessing import MolFromAminoseqTransformer
+
+    inputs = [FASTA_INPUTS[0], PLAIN_INPUTS[2]]
+    assert _smiles_list(
+        MolFromAminoseqTransformer(sanitize=sanitize).transform(inputs)
+    ) == _rdkit_smiles(inputs, sanitize=sanitize)
+
+
+@pytest.mark.parametrize("bad_flavor", [-1, 10])
+def test_invalid_flavor_is_rejected(bad_flavor):
+    from skfp.preprocessing import MolFromAminoseqTransformer
+
+    with pytest.raises(Exception):
+        MolFromAminoseqTransformer(flavor=bad_flavor).transform(["ACDE"])
+
+
+@pytest.mark.parametrize("bad_batch", [["ACD", 123], ["ACD", None]])
+def test_non_string_inputs_are_rejected(bad_batch):
+    from skfp.preprocessing import MolFromAminoseqTransformer
+
+    with pytest.raises((TypeError, ValueError)):
+        MolFromAminoseqTransformer().transform(bad_batch)
+
+
+def test_sklearn_style_fit_and_set_params_remain_available():
+    from skfp.preprocessing import MolFromAminoseqTransformer
+
+    transformer = MolFromAminoseqTransformer()
+    assert transformer.fit(["ACD"]) is transformer
+    assert transformer.set_params(sanitize=False, flavor=2) is transformer
+    params = transformer.get_params()
+    assert params["sanitize"] is False
+    assert params["flavor"] == 2
+
+
+def test_transform_preserves_larger_batches_and_duplicate_sequences():
+    from skfp.preprocessing import MolFromAminoseqTransformer
+
+    inputs = ["AAAA", "CCCC", "AAAA", "TTTT"]
+    mols = MolFromAminoseqTransformer().transform(inputs)
+    assert len(mols) == len(inputs)
+    assert _smiles_list(mols) == _rdkit_smiles(inputs)
+
+
+@pytest.mark.parametrize("flavor,sequence", [(1, "ACDEFGHIK"), (6, "TTTTTTTTTT")])
+def test_valid_non_default_flavors_match_rdkit_oracle(flavor, sequence):
+    from skfp.preprocessing import MolFromAminoseqTransformer
+
+    transformer_smiles = _smiles_list(
+        MolFromAminoseqTransformer(flavor=flavor).transform([sequence])
+    )
+    assert transformer_smiles == _rdkit_smiles([sequence], flavor=flavor)
+
+
+@pytest.mark.parametrize(
+    "bad_batch", [["ACD", "EFG", b"HI"], ["ACD", "EFG", ["HI"]]]
+)
+def test_non_string_inputs_are_rejected_for_all_positions_and_types(bad_batch):
+    from skfp.preprocessing import MolFromAminoseqTransformer
+
+    with pytest.raises((TypeError, ValueError)):
+        MolFromAminoseqTransformer().transform(bad_batch)
