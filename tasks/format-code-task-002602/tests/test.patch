+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+
+case "${1:-}" in
+  base)
+    cd /testbed/tests
+    python3 -m pytest \
+      preprocessing/input_output/smiles.py \
+      preprocessing/input_output/inchi.py \
+      preprocessing/input_output/sdf.py \
+      --rootdir=/testbed \
+      -q
+    ;;
+  new)
+    cd /testbed
+    python3 -m pytest \
+      tests/preprocessing/input_output/test_aminoseq.py \
+      tests/docs/test_preprocessing_docs.py \
+      --rootdir=/testbed \
+      -q
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
