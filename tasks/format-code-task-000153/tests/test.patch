@@ -0,0 +1,124 @@
+import re
+
+import pytest
+
+from robocop.linter.rules import (
+    Rule,
+    RuleSeverity,
+    filter_rules_by_pattern,
+)
+
+
+def make_rule(rule_id, name, severity=RuleSeverity.WARNING, deprecated=False):
+    return Rule(
+        rule_id=rule_id,
+        name=name,
+        msg="Some description",
+        severity=severity,
+        deprecated=deprecated,
+    )
+
+
+@pytest.fixture
+def rule_0101():
+    return make_rule("0101", "some-message")
+
+
+@pytest.fixture
+def rules_collection():
+    return {
+        "0101": make_rule("0101", "some-message", RuleSeverity.WARNING),
+        "0102": make_rule("0102", "other-message", RuleSeverity.ERROR),
+        "0204": make_rule("0204", "another-keyword", RuleSeverity.INFO),
+    }
+
+
+class TestMatchesPattern:
+    def test_exact_id_still_matches(self, rule_0101):
+        assert rule_0101.matches_pattern("0101")
+
+    def test_exact_name_still_matches(self, rule_0101):
+        assert rule_0101.matches_pattern("some-message")
+
+    def test_literal_non_match_returns_false(self, rule_0101):
+        assert not rule_0101.matches_pattern("0102")
+        assert not rule_0101.matches_pattern("other-message")
+
+    def test_literal_prefix_is_not_a_match(self, rule_0101):
+
+        assert not rule_0101.matches_pattern("01")
+
+    def test_star_matches_everything(self, rule_0101):
+        assert rule_0101.matches_pattern("*")
+
+    def test_star_prefix_matches_on_id(self, rule_0101):
+        assert rule_0101.matches_pattern("01*")
+
+    def test_star_suffix_matches_on_name(self, rule_0101):
+        assert rule_0101.matches_pattern("*-message")
+
+    def test_star_does_not_match_other_rules(self):
+        rule = make_rule("0204", "another-keyword")
+        assert not rule.matches_pattern("01*")
+        assert not rule.matches_pattern("*-message")
+
+    def test_question_mark_single_char(self, rule_0101):
+        assert rule_0101.matches_pattern("010?")
+        assert not rule_0101.matches_pattern("01?")
+
+    def test_character_class(self):
+        rule_a = make_rule("0101", "some-message")
+        rule_b = make_rule("0102", "other-message")
+        rule_c = make_rule("0204", "another-keyword")
+        assert rule_a.matches_pattern("010[12]")
+        assert rule_b.matches_pattern("010[12]")
+        assert not rule_c.matches_pattern("010[12]")
+
+    def test_negated_character_class(self):
+        rule_a = make_rule("0101", "some-message")
+        rule_b = make_rule("0102", "other-message")
+        assert rule_b.matches_pattern("010[!1]")
+        assert not rule_a.matches_pattern("010[!1]")
+
+    def test_case_insensitive_on_name(self, rule_0101):
+        assert rule_0101.matches_pattern("SOME-MESSAGE")
+        assert rule_0101.matches_pattern("Some-*")
+
+    def test_compiled_regex_still_supported(self, rule_0101):
+        assert rule_0101.matches_pattern(re.compile("some-.*"))
+        assert rule_0101.matches_pattern(re.compile("0101"))
+        assert not rule_0101.matches_pattern(re.compile("nomatch"))
+
+
+class TestFilterRulesByPattern:
+    def test_filter_by_id_prefix(self, rules_collection):
+        result = filter_rules_by_pattern(rules_collection, "01*")
+        assert [rule.rule_id for rule in result] == ["0101", "0102"]
+
+    def test_filter_by_name_suffix(self, rules_collection):
+        result = filter_rules_by_pattern(rules_collection, "*-message")
+        assert [rule.rule_id for rule in result] == ["0101", "0102"]
+
+    def test_star_selects_all(self, rules_collection):
+        result = filter_rules_by_pattern(rules_collection, "*")
+        assert [rule.rule_id for rule in result] == ["0101", "0102", "0204"]
+
+    def test_result_sorted_by_numeric_id(self):
+        rules = {
+            "0204": make_rule("0204", "another-keyword"),
+            "0101": make_rule("0101", "some-message"),
+            "0102": make_rule("0102", "other-message"),
+        }
+        result = filter_rules_by_pattern(rules, "*")
+        assert [rule.rule_id for rule in result] == ["0101", "0102", "0204"]
+
+    def test_deprecated_rules_excluded(self):
+        rules = {
+            "0101": make_rule("0101", "some-message"),
+            "0102": make_rule("0102", "other-message", deprecated=True),
+        }
+        result = filter_rules_by_pattern(rules, "*")
+        assert [rule.rule_id for rule in result] == ["0101"]
+
+    def test_no_match_returns_empty(self, rules_collection):
+        assert filter_rules_by_pattern(rules_collection, "99*") == []
