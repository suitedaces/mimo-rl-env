diff --git a/tests/dialects/test_clickhouse.py b/tests/dialects/test_clickhouse.py
index 1e4035ef2..94e586e15 100644
--- a/tests/dialects/test_clickhouse.py
+++ b/tests/dialects/test_clickhouse.py
@@ -375,3 +375,89 @@ SET
             },
             pretty=True,
         )
+
+    def test_approx_count_distinct_uniq(self):
+
+        self.validate_identity("SELECT uniq(x) FROM t")
+
+
+        self.validate_all(
+            "SELECT uniq(x) FROM t",
+            read={"bigquery": "SELECT APPROX_COUNT_DISTINCT(x) FROM t"},
+            write={"bigquery": "SELECT APPROX_COUNT_DISTINCT(x) FROM t"},
+        )
+
+    def test_any_value_to_any(self):
+
+        self.validate_identity("SELECT any(x) FROM t")
+
+
+        self.validate_all(
+            "SELECT any(x) FROM t",
+            read={"bigquery": "SELECT ANY_VALUE(x) FROM t"},
+            write={"bigquery": "SELECT ANY_VALUE(x) FROM t"},
+        )
+
+    def test_approx_count_distinct_any_value_combined(self):
+
+        self.assertEqual(
+            __import__("sqlglot").transpile(
+                "SELECT APPROX_COUNT_DISTINCT(x) FROM (SELECT ANY_VALUE(y) x FROM (SELECT 1 y))",
+                read="bigquery",
+                write="clickhouse",
+            )[0],
+            "SELECT uniq(x) FROM (SELECT any(y) AS x FROM (SELECT 1 AS y))",
+        )
+
+    def test_bigquery_approx_count_distinct_identity(self):
+        import sqlglot
+
+
+        self.assertEqual(
+            sqlglot.transpile(
+                "SELECT APPROX_COUNT_DISTINCT(x) FROM t",
+                read="bigquery",
+                write="bigquery",
+            )[0],
+            "SELECT APPROX_COUNT_DISTINCT(x) FROM t",
+        )
+
+    def test_bigquery_any_value_identity(self):
+        import sqlglot
+
+
+        self.assertEqual(
+            sqlglot.transpile(
+                "SELECT ANY_VALUE(x) FROM t",
+                read="bigquery",
+                write="bigquery",
+            )[0],
+            "SELECT ANY_VALUE(x) FROM t",
+        )
+
+    def test_clickhouse_uniq_to_bigquery(self):
+
+        import sqlglot
+
+        self.assertEqual(
+            sqlglot.transpile(
+                "SELECT uniq(x) FROM t",
+                read="clickhouse",
+                write="bigquery",
+            )[0],
+            "SELECT APPROX_COUNT_DISTINCT(x) FROM t",
+        )
+
+    def test_clickhouse_any_to_bigquery(self):
+
+        import sqlglot
+
+        self.assertEqual(
+            sqlglot.transpile(
+                "SELECT any(x) FROM t",
+                read="clickhouse",
+                write="bigquery",
+            )[0],
+            "SELECT ANY_VALUE(x) FROM t",
+        )
+
