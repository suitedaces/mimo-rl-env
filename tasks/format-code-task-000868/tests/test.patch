+/* eslint-disable no-console */
+
+
+
+
+
+const assert = require('assert')
+const childProcess = require('child_process')
+const fs = require('fs')
+const http = require('http')
+const https = require('https')
+const net = require('net')
+const os = require('os')
+const path = require('path')
+
+require('babel-register')({
+  babelrc: false,
+  presets: [['env', { modules: 'commonjs', targets: { node: 'current' } }], 'stage-2'],
+  plugins: ['transform-object-assign']
+})
+
+const { pie, ring } = require('/workspace/repo/src/packages/pie/main.js')
+
+function summary (options) {
+  return {
+    data: options.series[0].data,
+    legend: options.legend && options.legend.data,
+    legendShow: options.legend && options.legend.show
+  }
+}
+
+function assertSummary (options, expected) {
+
+  assert.deepStrictEqual(summary(options), expected)
+}
+
+function cloneJson (value) {
+  return JSON.parse(JSON.stringify(value))
+}
+
+function escapeRegExp (value) {
+  return String(value).replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+}
+
+function numericText (value) {
+  return Number(String(value).replace(/,/g, ''))
+}
+
+function assertOtherTooltip (formatter, item, expectedEntries) {
+  const actual = formatter(item)
+
+
+  assert.match(actual, /其他\s*:/)
+  expectedEntries.forEach(({ name, value, percent }) => {
+    const entry = new RegExp(`${escapeRegExp(name)}:\\s*([^()<>]+?)\\s*\\(([-+]?\\d+(?:\\.\\d+)?)%\\)`)
+    const match = actual.match(entry)
+    assert.ok(match, `expected tooltip entry for ${name} in ${actual}`)
+    assert.strictEqual(numericText(match[1]), value)
+    assert.ok(
+      Math.abs(Number(match[2]) - percent) < 0.01,
+      `expected ${name} percent ${percent}, got ${match[2]}`
+    )
+  })
+}
+
+function assertDeepFrozenCallInputs (fn, columns, rows, settings, extra) {
+  const before = {
+    columns: cloneJson(columns),
+    rows: cloneJson(rows),
+    settings: cloneJson(settings),
+    extra: cloneJson(extra)
+  }
+  fn(columns, rows, settings, extra)
+  assert.deepStrictEqual(columns, before.columns)
+  assert.deepStrictEqual(rows, before.rows)
+  assert.deepStrictEqual(settings, before.settings)
+  assert.deepStrictEqual(extra, before.extra)
+}
+
+function test (name, fn) {
+  try {
+    fn()
+    console.log('ok - ' + name)
+  } catch (err) {
+    console.error('not ok - ' + name)
+    console.error(err && err.stack ? err.stack : err)
+    process.exitCode = 1
+  }
+}
+
+test('pie collapses sorted over-limit slices and expands other tooltip', () => {
+
+
+
+
+  const actual = pie(
+    ['name', 'value'],
+    [
+      { name: 'A', value: 10 },
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 },
+      { name: 'D', value: 5 },
+      { name: 'E', value: 15 }
+    ],
+    { limitShowNum: 3 },
+    { tooltipVisible: true, legendVisible: true }
+  )
+
+  assertSummary(actual, {
+    data: [
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 },
+      { name: 'E', value: 15 },
+      { name: '其他', value: 15 }
+    ],
+    legend: ['B', 'C', 'E', '其他'],
+    legendShow: true
+  })
+  assertOtherTooltip(
+    actual.tooltip.formatter,
+    { color: '#abc', name: '其他', value: 15, percent: 15 },
+    [
+      { name: 'A', value: 10, percent: 10.00 },
+      { name: 'D', value: 5, percent: 5.00 }
+    ]
+  )
+})
+
+test('ring applies the same collapsed-slice behavior with ring radius', () => {
+
+
+
+
+  const actual = ring(
+    ['name', 'value'],
+    [
+      { name: 'X', value: 5 },
+      { name: 'Y', value: 7 },
+      { name: 'Z', value: 11 },
+      { name: 'W', value: 13 }
+    ],
+    { limitShowNum: 2 },
+    { tooltipVisible: true, legendVisible: true }
+  )
+
+  assertSummary(actual, {
+    data: [
+      { name: 'W', value: 13 },
+      { name: 'Z', value: 11 },
+      { name: '其他', value: 12 }
+    ],
+    legend: ['W', 'Z', '其他'],
+    legendShow: true
+  })
+  assertOtherTooltip(
+    actual.tooltip.formatter,
+    { color: '#abc', name: '其他', value: 12, percent: 33.33 },
+    [
+      { name: 'Y', value: 7, percent: 19.44 },
+      { name: 'X', value: 5, percent: 13.89 }
+    ]
+  )
+})
+
+test('pie with isRing true has collapsed ring data through the public pie call', () => {
+
+
+
+
+  const actual = pie(
+    ['name', 'value'],
+    [
+      { name: 'X', value: 5 },
+      { name: 'Y', value: 7 },
+      { name: 'Z', value: 11 },
+      { name: 'W', value: 13 }
+    ],
+    { limitShowNum: 2 },
+    { tooltipVisible: false, legendVisible: true },
+    true
+  )
+
+  assertSummary(actual, {
+    data: [
+      { name: 'W', value: 13 },
+      { name: 'Z', value: 11 },
+      { name: '其他', value: 12 }
+    ],
+    legend: ['W', 'Z', '其他'],
+    legendShow: true
+  })
+})
+
+test('positive boundary one keeps only the top slice and groups all others', () => {
+
+
+
+
+  const actual = pie(
+    ['name', 'value'],
+    [
+      { name: 'A', value: 10 },
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 },
+      { name: 'D', value: 5 }
+    ],
+    { limitShowNum: 1 },
+    { tooltipVisible: true, legendVisible: true }
+  )
+
+  assertSummary(actual, {
+    data: [
+      { name: 'B', value: 50 },
+      { name: '其他', value: 35 }
+    ],
+    legend: ['B', '其他'],
+    legendShow: true
+  })
+  assertOtherTooltip(
+    actual.tooltip.formatter,
+    { color: '#abc', name: '其他', value: 35, percent: 41.18 },
+    [
+      { name: 'C', value: 20, percent: 23.53 },
+      { name: 'A', value: 10, percent: 11.76 },
+      { name: 'D', value: 5, percent: 5.88 }
+    ]
+  )
+})
+
+test('custom dimension and selected metric drive sorting and remainder values', () => {
+
+
+
+
+  const actual = pie(
+    ['category', 'amount'],
+    [
+      { category: 'low', amount: 3 },
+      { category: 'peak', amount: 9 },
+      { category: 'mid', amount: 6 },
+      { category: 'tail', amount: 2 }
+    ],
+    { limitShowNum: 2, dimension: 'category', metrics: 'amount' },
+    { tooltipVisible: true, legendVisible: true }
+  )
+
+  assertSummary(actual, {
+    data: [
+      { name: 'peak', value: 9 },
+      { name: 'mid', value: 6 },
+      { name: '其他', value: 5 }
+    ],
+    legend: ['peak', 'mid', '其他'],
+    legendShow: true
+  })
+  assertOtherTooltip(
+    actual.tooltip.formatter,
+    { color: '#abc', name: '其他', value: 5, percent: 25 },
+    [
+      { name: 'low', value: 3, percent: 15.00 },
+      { name: 'tail', value: 2, percent: 10.00 }
+    ]
+  )
+})
+
+test('omitted limitShowNum preserves all rows without an other slice', () => {
+
+
+
+
+  const actual = pie(
+    ['name', 'value'],
+    [
+      { name: 'A', value: 10 },
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 }
+    ],
+    {},
+    { tooltipVisible: true, legendVisible: true }
+  )
+
+  assertSummary(actual, {
+    data: [
+      { name: 'A', value: 10 },
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 }
+    ],
+    legend: ['A', 'B', 'C'],
+    legendShow: true
+  })
+})
+
+test('zero limitShowNum preserves all rows without sorting or other slice', () => {
+
+
+
+
+  const actual = pie(
+    ['name', 'value'],
+    [
+      { name: 'A', value: 10 },
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 }
+    ],
+    { limitShowNum: 0 },
+    { tooltipVisible: false, legendVisible: true }
+  )
+
+  assertSummary(actual, {
+    data: [
+      { name: 'A', value: 10 },
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 }
+    ],
+    legend: ['A', 'B', 'C'],
+    legendShow: true
+  })
+})
+
+test('limitShowNum equal to row count sorts but does not add other slice', () => {
+
+
+
+
+  const actual = pie(
+    ['name', 'value'],
+    [
+      { name: 'A', value: 10 },
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 }
+    ],
+    { limitShowNum: 3 },
+    { tooltipVisible: false, legendVisible: true }
+  )
+
+  assertSummary(actual, {
+    data: [
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 },
+      { name: 'A', value: 10 }
+    ],
+    legend: ['B', 'C', 'A'],
+    legendShow: true
+  })
+})
+
+test('limitShowNum greater than row count sorts but does not add other slice', () => {
+
+
+
+
+  const actual = pie(
+    ['name', 'value'],
+    [
+      { name: 'A', value: 10 },
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 }
+    ],
+    { limitShowNum: 5 },
+    { tooltipVisible: false, legendVisible: true }
+  )
+
+  assertSummary(actual, {
+    data: [
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 },
+      { name: 'A', value: 10 }
+    ],
+    legend: ['B', 'C', 'A'],
+    legendShow: true
+  })
+})
+
+test('ring with omitted limitShowNum preserves all rows without an other slice', () => {
+
+  const actual = ring(
+    ['name', 'value'],
+    [
+      { name: 'X', value: 5 },
+      { name: 'Y', value: 7 },
+      { name: 'Z', value: 11 }
+    ],
+    {},
+    { tooltipVisible: true, legendVisible: true }
+  )
+
+  assertSummary(actual, {
+    data: [
+      { name: 'X', value: 5 },
+      { name: 'Y', value: 7 },
+      { name: 'Z', value: 11 }
+    ],
+    legend: ['X', 'Y', 'Z'],
+    legendShow: true
+  })
+})
+
+test('referential transparency returns the same literal option fragments for repeated calls', () => {
+  const args = [
+    ['name', 'value'],
+    [
+      { name: 'A', value: 10 },
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 },
+      { name: 'D', value: 5 }
+    ],
+    { limitShowNum: 2 },
+    { tooltipVisible: true, legendVisible: true }
+  ]
+  assertSummary(pie.apply(null, cloneJson(args)), {
+    data: [
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 },
+      { name: '其他', value: 15 }
+    ],
+    legend: ['B', 'C', '其他'],
+    legendShow: true
+  })
+  assertSummary(pie.apply(null, cloneJson(args)), {
+    data: [
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 },
+      { name: '其他', value: 15 }
+    ],
+    legend: ['B', 'C', '其他'],
+    legendShow: true
+  })
+})
+
+test('does not mutate caller-owned inputs', () => {
+  assertDeepFrozenCallInputs(
+    pie,
+    ['name', 'value'],
+    [
+      { name: 'A', value: 10 },
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 },
+      { name: 'D', value: 5 }
+    ],
+    { limitShowNum: 2, legendName: { B: 'Bee' } },
+    { tooltipVisible: true, legendVisible: true }
+  )
+})
+
+test('fresh process result matches in-process result to reject module-global state', () => {
+  const inProcess = summary(pie(
+    ['name', 'value'],
+    [
+      { name: 'A', value: 10 },
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 },
+      { name: 'D', value: 5 }
+    ],
+    { limitShowNum: 2 },
+    { tooltipVisible: true, legendVisible: true }
+  ))
+  const script = `
+    require('babel-register')({
+      babelrc: false,
+      presets: [['env', { modules: 'commonjs', targets: { node: 'current' } }], 'stage-2'],
+      plugins: ['transform-object-assign']
+    });
+    const { pie } = require('/workspace/repo/src/packages/pie/main.js');
+    const options = pie(
+      ['name', 'value'],
+      [
+        { name: 'A', value: 10 },
+        { name: 'B', value: 50 },
+        { name: 'C', value: 20 },
+        { name: 'D', value: 5 }
+      ],
+      { limitShowNum: 2 },
+      { tooltipVisible: true, legendVisible: true }
+    );
+    process.stdout.write(JSON.stringify({
+      data: options.series[0].data,
+      legend: options.legend && options.legend.data,
+      legendShow: options.legend && options.legend.show
+    }));
+  `
+  const fresh = JSON.parse(childProcess.execFileSync(process.execPath, ['-e', script], {
+    cwd: '/workspace/repo',
+    encoding: 'utf8'
+  }))
+
+  assert.deepStrictEqual(inProcess, {
+    data: [
+      { name: 'B', value: 50 },
+      { name: 'C', value: 20 },
+      { name: '其他', value: 15 }
+    ],
+    legend: ['B', 'C', '其他'],
+    legendShow: true
+  })
+  assert.deepStrictEqual(fresh, inProcess)
+})
+
+test('does not perform undeclared filesystem or network side effects', () => {
+  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'pie-limit-side-effects-'))
+  const originalCwd = process.cwd()
+  const original = {
+    writeFileSync: fs.writeFileSync,
+    appendFileSync: fs.appendFileSync,
+    writeFile: fs.writeFile,
+    appendFile: fs.appendFile,
+    createWriteStream: fs.createWriteStream,
+    mkdirSync: fs.mkdirSync,
+    netConnect: net.connect,
+    netCreateConnection: net.createConnection,
+    httpRequest: http.request,
+    httpGet: http.get,
+    httpsRequest: https.request,
+    httpsGet: https.get
+  }
+  const rejectSideEffect = () => {
+    throw new Error('undeclared side effect attempted')
+  }
+
+  try {
+    process.chdir(tmp)
+    const before = fs.readdirSync('.').sort()
+    fs.writeFileSync = rejectSideEffect
+    fs.appendFileSync = rejectSideEffect
+    fs.writeFile = rejectSideEffect
+    fs.appendFile = rejectSideEffect
+    fs.createWriteStream = rejectSideEffect
+    fs.mkdirSync = rejectSideEffect
+    net.connect = rejectSideEffect
+    net.createConnection = rejectSideEffect
+    http.request = rejectSideEffect
+    http.get = rejectSideEffect
+    https.request = rejectSideEffect
+    https.get = rejectSideEffect
+
+    const actual = pie(
+      ['name', 'value'],
+      [
+        { name: 'A', value: 10 },
+        { name: 'B', value: 50 },
+        { name: 'C', value: 20 },
+        { name: 'D', value: 5 }
+      ],
+      { limitShowNum: 2 },
+      { tooltipVisible: true, legendVisible: true }
+    )
+
+    assertSummary(actual, {
+      data: [
+        { name: 'B', value: 50 },
+        { name: 'C', value: 20 },
+        { name: '其他', value: 15 }
+      ],
+      legend: ['B', 'C', '其他'],
+      legendShow: true
+    })
+    assert.deepStrictEqual(fs.readdirSync('.').sort(), before)
+  } finally {
+    fs.writeFileSync = original.writeFileSync
+    fs.appendFileSync = original.appendFileSync
+    fs.writeFile = original.writeFile
+    fs.appendFile = original.appendFile
+    fs.createWriteStream = original.createWriteStream
+    fs.mkdirSync = original.mkdirSync
+    net.connect = original.netConnect
+    net.createConnection = original.netCreateConnection
+    http.request = original.httpRequest
+    http.get = original.httpGet
+    https.request = original.httpsRequest
+    https.get = original.httpsGet
+    process.chdir(originalCwd)
+    fs.rmdirSync(tmp)
+  }
+})
+
+process.on('exit', () => {
+  if (process.exitCode) process.exit(process.exitCode)
+})
