+
+  test('Grid.available is truthy in SSR (no window)', () => {
+    jest.isolateModules(() => {
+      const originalWindow = global.window;
+
+      delete global.window;
+      let availableInSSR;
+      try {
+        // eslint-disable-next-line global-require
+        availableInSSR = require('../Grid').Grid.available;
+      } finally {
+        global.window = originalWindow;
+      }
+
+
+
+      expect(availableInSSR).toBeTruthy();
+    });
+  });
 });
