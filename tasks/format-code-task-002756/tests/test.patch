diff --git a/tests/test_cache.py b/tests/test_cache.py
index 712d2c4f..14ac4441 100644
--- a/tests/test_cache.py
+++ b/tests/test_cache.py
@@ -106,3 +106,25 @@ class TestCache(unittest.TestCase):
         self.assertDictEqual(
             {"test1": 1},
             self.cache.get_all())
+
+    @patch('streamlink.cache.mktime', side_effect=OverflowError)
+    def test_set_expires_at_overflow_does_not_raise(self, mock_mktime):
+        try:
+            self.cache.set("value", 10, expires_at=datetime.datetime(1970, 1, 1))
+        except OverflowError:
+            self.fail("Cache.set() raised OverflowError on mktime overflow")
+
+    @patch('streamlink.cache.mktime', side_effect=OverflowError)
+    def test_set_expires_at_overflow_value_expired(self, mock_mktime):
+
+
+        self.cache.set("value", 10, expires_at=datetime.datetime(1970, 1, 1))
+        self.assertIsNone(self.cache.get("value"))
+
+    @patch('streamlink.cache.mktime', side_effect=OverflowError)
+    def test_set_expires_at_overflow_does_not_keep_default_expiry(self, mock_mktime):
+
+
+        self.cache.set("value", 10, expires=60 * 60 * 24 * 7,
+                       expires_at=datetime.datetime(1970, 1, 1))
+        self.assertIsNone(self.cache.get("value"))
