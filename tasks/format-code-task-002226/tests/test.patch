--- a/pandas/tests/indexes/base_class/test_formats.py
+++ b/pandas/tests/indexes/base_class/test_formats.py
@@ -146,3 +146,66 @@ class TestIndexRendering:
         idx = Index(["aaaaaaaaa", "b"])
         expected = ["aaaaaaaaa", "b"]
         assert idx.format() == expected
+
+    def test_index_format_none_distinct_from_nan(self):
+
+        import pandas as pd
+
+        idx = Index([True, None], dtype=object)
+        assert idx.format() == ["True", "None"]
+
+    def test_index_format_nat_distinct_from_nan(self):
+
+        import pandas as pd
+
+        idx = Index([True, pd.NaT], dtype=object)
+        assert idx.format() == ["True", "NaT"]
+
+    def test_index_format_float_nan_uses_na_rep(self):
+
+        idx = Index([True, np.nan], dtype=object)
+        assert idx.format() == ["True", "NaN"]
+
+    def test_index_format_pd_na_distinct_from_nan(self):
+
+        import pandas as pd
+
+        idx = Index([1, pd.NA], dtype=object)
+        assert idx.format() == ["1", "<NA>"]
+
+    def test_index_format_mixed_null_types(self):
+
+        import pandas as pd
+
+        idx = Index([True, None, np.nan, pd.NaT], dtype=object)
+        assert idx.format() == ["True", "None", "NaN", "NaT"]
+
+    def test_index_format_na_rep_only_replaces_float_nan(self):
+
+
+        import pandas as pd
+
+        idx = Index([1, None, np.nan, pd.NaT, pd.NA], dtype=object)
+        result = idx.format(na_rep="X")
+        assert result == ["1", "None", "X", "NaT", "<NA>"]
+
+    def test_series_repr_mixed_null_index(self):
+
+        import pandas as pd
+
+        s = pd.Series([1, 2, 3, 4], [True, None, np.nan, pd.NaT])
+        result = repr(s)
+
+        assert "None" in result
+        assert "NaT" in result
+        assert "NaN" in result
+
+
+
+        text = s.to_string()
+        lines = text.splitlines()
+
+        assert any(line.startswith("True") for line in lines)
+        assert any(line.startswith("None") for line in lines)
+        assert any(line.startswith("NaN") for line in lines)
+        assert any(line.startswith("NaT") for line in lines)
