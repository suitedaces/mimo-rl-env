+import re
+from pathlib import Path
+
+import torch
+import torchio as tio
+from torchio.transforms import Clamp as TransformsClamp
+
+from ...utils import TorchioTestCase
+
+
+class TestClamp(TorchioTestCase):
+    def assert_tensor_equal(self, actual, expected):
+        self.assertTrue(
+            torch.equal(actual, expected),
+            f'\nExpected:\n{expected}\nActual:\n{actual}',
+        )
+
+    def make_scalar_image(self, values):
+        tensor = torch.tensor(values, dtype=torch.float32).reshape(1, 1, 1, -1)
+        return tio.ScalarImage(tensor=tensor)
+
+    def test_public_imports_and_instantiation(self):
+        transforms = [
+            tio.Clamp(out_min=-2.5, out_max=4.5),
+            tio.Clamp(out_min=-1.5),
+            tio.Clamp(out_max=2.5),
+            TransformsClamp(out_min=-2.5, out_max=4.5),
+        ]
+        for transform in transforms:
+            self.assertTrue(callable(transform))
+
+    def test_clamps_scalar_image_to_two_sided_range(self):
+        image = self.make_scalar_image([-7.0, -2.5, -1.25, 3.0, 4.5, 9.0])
+        transformed = tio.Clamp(out_min=-2.5, out_max=4.5)(image)
+        expected = torch.tensor(
+            [-2.5, -2.5, -1.25, 3.0, 4.5, 4.5],
+            dtype=torch.float32,
+        ).reshape(1, 1, 1, -1)
+        self.assert_tensor_equal(transformed.data, expected)
+
+    def test_lower_only_clamp(self):
+        image = self.make_scalar_image([-9.0, -1.5, 0.0, 8.0])
+        transformed = tio.Clamp(out_min=-1.5)(image)
+        expected = torch.tensor([-1.5, -1.5, 0.0, 8.0]).reshape(1, 1, 1, -1)
+        self.assert_tensor_equal(transformed.data, expected)
+
+    def test_upper_only_clamp(self):
+        image = self.make_scalar_image([-9.0, 0.0, 2.5, 8.0])
+        transformed = tio.Clamp(out_max=2.5)(image)
+        expected = torch.tensor([-9.0, 0.0, 2.5, 2.5]).reshape(1, 1, 1, -1)
+        self.assert_tensor_equal(transformed.data, expected)
+
+    def test_preprocessing_docs_list_clamp(self):
+        docs_path = Path(__file__).parents[3] / 'docs/source/transforms/preprocessing.rst'
+        content = docs_path.read_text()
+        listed_transform_patterns = [
+            r'(?m)^\s*:class:`Clamp`\s*$',
+            r'(?m)^\s*\.\.\s+autoclass::\s+Clamp\b',
+            r'(?ms)^\s*\.\.\s+autosummary::.*?^\s+Clamp\s*$',
+            r'(?m)^\s*[*-]\s+.*\bClamp\b',
+            r'(?m)^\s*Clamp\s*$',
+        ]
+        self.assertTrue(any(re.search(pattern, content) for pattern in listed_transform_patterns))
