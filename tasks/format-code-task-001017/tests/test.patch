+#!/bin/bash
+set -euo pipefail
+
+
+COLLECTION_ROOT="$(mktemp -d)"
+trap 'unlink "${COLLECTION_ROOT}/ansible_collections/community/general" 2>/dev/null || true; rmdir "${COLLECTION_ROOT}/ansible_collections/community" "${COLLECTION_ROOT}/ansible_collections" "${COLLECTION_ROOT}" 2>/dev/null || true' EXIT
+mkdir -p "${COLLECTION_ROOT}/ansible_collections/community"
+ln -s "${PWD}" "${COLLECTION_ROOT}/ansible_collections/community/general"
+PYTHONPATH="${COLLECTION_ROOT}${PYTHONPATH:+:${PYTHONPATH}}" \
+  .build_env/venv/bin/python -m pytest -q \
+  tests/unit/plugins/modules/test_redis_tls_profile.py \
+  tests/unit/plugins/modules/test_redis_info.py
