+# -*- coding: utf-8 -*-
+
+from __future__ import absolute_import, division, print_function
+
+import pytest
+
+from ansible.module_utils import basic
+from ansible_collections.community.general.plugins.module_utils import redis as redis_utils
+from ansible_collections.community.general.plugins.modules import redis_data_info, redis_info
+from ansible_collections.community.general.tests.unit.plugins.modules.utils import (
+    AnsibleExitJson, AnsibleFailJson, ModuleTestCase, set_module_args,
+)
+from ansible_collections.community.general.tests.unit.compat.mock import MagicMock, patch
+
+
+class _FakeRedis(MagicMock):
+    def ping(self):
+        return True
+
+    def info(self):
+        return {'redis_version': '8.0.0'}
+
+    def get(self, key):
+        return 'value'
+
+
+class TestRedisTlsProfileModules(ModuleTestCase):
+    def test_redis_info_forwards_complete_client_profile(self):
+        with patch('ansible_collections.community.general.plugins.modules.redis_info.redis_client',
+                   side_effect=_FakeRedis) as client:
+            with self.assertRaises(AnsibleExitJson):
+                set_module_args({
+                    'tls': True,
+                    'ca_certs': '/etc/ssl/ca.pem',
+                    'client_cert_file': '/etc/redis/client.crt',
+                    'client_key_file': '/etc/redis/client.key',
+                    'client_key_password': 'secret',
+                })
+                redis_info.main()
+        kwargs = client.call_args.kwargs
+        self.assertEqual(kwargs['ssl'], True)
+        self.assertEqual(kwargs['ssl_ca_certs'], '/etc/ssl/ca.pem')
+        self.assertEqual(kwargs['ssl_certfile'], '/etc/redis/client.crt')
+        self.assertEqual(kwargs['ssl_keyfile'], '/etc/redis/client.key')
+        self.assertEqual(kwargs['ssl_password'], 'secret')
+
+    def test_redis_data_info_forwards_profile_without_optional_password(self):
+        with patch('ansible_collections.community.general.plugins.module_utils.redis.Redis',
+                   side_effect=_FakeRedis) as client:
+            with self.assertRaises(AnsibleExitJson):
+                set_module_args({
+                    'key': 'answer',
+                    'tls': True,
+                    'client_cert_file': '/etc/redis/client.crt',
+                    'client_key_file': '/etc/redis/client.key',
+                })
+                redis_data_info.main()
+        kwargs = client.call_args.kwargs
+        self.assertEqual(kwargs['ssl_certfile'], '/etc/redis/client.crt')
+        self.assertEqual(kwargs['ssl_keyfile'], '/etc/redis/client.key')
+        self.assertNotIn('ssl_password', kwargs)
+
+    def test_tls_defaults_and_ca_fallback_are_preserved(self):
+        with patch('ansible_collections.community.general.plugins.modules.redis_info.redis_client',
+                   side_effect=_FakeRedis) as info_client:
+            with self.assertRaises(AnsibleExitJson):
+                set_module_args({})
+                redis_info.main()
+        info_kwargs = info_client.call_args.kwargs
+        self.assertEqual(info_kwargs['ssl'], False)
+        self.assertIsNone(info_kwargs['ssl_ca_certs'])
+        self.assertNotIn('ssl_certfile', info_kwargs)
+
+        with patch('ansible_collections.community.general.plugins.module_utils.redis.Redis',
+                   side_effect=_FakeRedis) as data_client:
+            with self.assertRaises(AnsibleExitJson):
+                set_module_args({'key': 'answer'})
+                redis_data_info.main()
+        self.assertEqual(data_client.call_args.kwargs['ssl'], True)
+        self.assertEqual(data_client.call_args.kwargs['ssl_ca_certs'], redis_utils.certifi.where())
+
+    def test_legacy_password_and_username_are_unchanged(self):
+        with patch('ansible_collections.community.general.plugins.modules.redis_info.redis_client',
+                   side_effect=_FakeRedis) as client:
+            with self.assertRaises(AnsibleExitJson):
+                set_module_args({
+                    'login_user': 'app',
+                    'login_password': 'pw',
+                    'tls': False,
+                })
+                redis_info.main()
+        kwargs = client.call_args.kwargs
+        self.assertEqual(kwargs['username'], 'app')
+        self.assertEqual(kwargs['password'], 'pw')
+        self.assertEqual(kwargs['ssl'], False)
+
+
+@pytest.mark.parametrize('args, expected_names', [
+    ({'client_cert_file': '/tmp/client.crt'}, ('client_cert_file', 'client_key_file')),
+    ({'client_key_file': '/tmp/client.key'}, ('client_cert_file', 'client_key_file')),
+    ({'client_key_password': 'secret'}, ('client_key_password', 'client_key_file')),
+    ({'tls': False, 'client_cert_file': '/tmp/client.crt', 'client_key_file': '/tmp/client.key'},
+     ('tls', 'client_cert_file')),
+])
+def test_inconsistent_client_profile_is_rejected_by_module(args, expected_names):
+    def fail_json(module, **kwargs):
+        raise AnsibleFailJson(kwargs)
+
+    with patch.object(basic.AnsibleModule, 'fail_json', new=fail_json):
+        set_module_args(args)
+        with pytest.raises(AnsibleFailJson) as result:
+            redis_info.main()
+    message = result.value.args[0]['msg']
+    assert all(name in message for name in expected_names)
