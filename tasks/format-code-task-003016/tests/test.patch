--- a/tests/classes/test_hypergraph.py
+++ b/tests/classes/test_hypergraph.py
@@ -4,6 +4,48 @@ import xgi
 from xgi.exception import XGIError
 
 
+def _edge_memberships(raw_edges):
+    raw_edges = list(raw_edges)
+    if raw_edges and all(
+        not isinstance(edge, (frozenset, set, list, tuple)) for edge in raw_edges
+    ):
+        return {frozenset(raw_edges)}
+    return {frozenset(edge) for edge in raw_edges}
+
+
+def _find_duplicate_membership_helper(H, expected):
+    for name in dir(H):
+        lowered = name.lower()
+        if name.startswith("_") or "duplicate" not in lowered:
+            continue
+        helper = getattr(H, name)
+        if not callable(helper):
+            continue
+        try:
+            if _edge_memberships(helper()) == expected:
+                return name
+        except Exception:
+            continue
+    raise AssertionError("No public duplicate-membership helper found")
+
+
+def _test_reports_repeated_edge_memberships():
+    H = xgi.Hypergraph()
+    H.add_edges_from([[1, 2], [3, 4], [2, 1], [5, 6]])
+
+    expected = {frozenset({1, 2})}
+    helper_name = _find_duplicate_membership_helper(H, expected)
+    assert _edge_memberships(getattr(H, helper_name)()) == expected
+
+    unique = xgi.Hypergraph([[10, 11], [12, 13], [14, 15]])
+    assert _edge_memberships(getattr(unique, helper_name)()) == set()
+
+
+globals()["test_duplicate" + "_edges_reports_repeated_memberships"] = (
+    _test_reports_repeated_edge_memberships
+)
+
+
 def test_constructor(edgelist5, dict5, incidence5, dataframe5):
     H_list = xgi.Hypergraph(edgelist5)
     H_dict = xgi.Hypergraph(dict5)
diff --git a/tests/classes/test_simplicialcomplex.py b/tests/classes/test_simplicialcomplex.py
new file mode 100644
index 0000000..eaa38f5
--- /dev/null
+++ b/tests/classes/test_simplicialcomplex.py
@@ -0,0 +1,193 @@
+import itertools
+
+import pytest
+
+import xgi
+from xgi.exception import XGIError
+
+
+def _memberships(sc):
+    return {frozenset(sc.edges.members(edge_id)) for edge_id in sc.edges}
+
+
+_EDGE_MUTATION_METHODS = {
+    "add_edge",
+    "add_edges_from",
+    "add_weighted_edges_from",
+    "remove_edge",
+    "remove_edges_from",
+}
+
+
+def _expected_non_singleton_faces(nodes):
+    nodes = set(nodes)
+    return {
+        frozenset(face)
+        for size in range(2, len(nodes) + 1)
+        for face in itertools.combinations(nodes, size)
+    }
+
+
+def _public_simplex_callables(sc):
+    for name in dir(sc):
+        lowered = name.lower()
+        if name.startswith("_") or name in _EDGE_MUTATION_METHODS:
+            continue
+        if "simplex" not in lowered and "simplic" not in lowered:
+            continue
+        method = getattr(sc, name)
+        if callable(method):
+            yield name, method
+
+
+def _find_single_simplex_adder(simplex):
+    for name, _ in _public_simplex_callables(xgi.SimplicialComplex()):
+        lowered = name.lower()
+        if "add" not in lowered or "weighted" in lowered:
+            continue
+        trial = xgi.SimplicialComplex()
+        try:
+            getattr(trial, name)(list(simplex))
+        except Exception:
+            continue
+        if _memberships(trial) == _expected_non_singleton_faces(simplex):
+            return name
+    raise AssertionError("No public single-simplex add method found")
+
+
+def _add_one_simplex(sc, simplex):
+    getattr(sc, _find_single_simplex_adder(simplex))(list(simplex))
+
+
+def _find_bulk_simplex_adder(simplices):
+    expected = set().union(*(_expected_non_singleton_faces(s) for s in simplices))
+    for name, _ in _public_simplex_callables(xgi.SimplicialComplex()):
+        lowered = name.lower()
+        if "add" not in lowered or "weighted" in lowered:
+            continue
+        trial = xgi.SimplicialComplex()
+        try:
+            getattr(trial, name)([list(s) for s in simplices])
+        except Exception:
+            continue
+        if _memberships(trial) == expected:
+            return name
+    raise AssertionError("No public bulk simplex add method found")
+
+
+def _add_many_simplices(sc, simplices):
+    getattr(sc, _find_bulk_simplex_adder(simplices))([list(s) for s in simplices])
+
+
+def _simplex_is_present(sc, simplex):
+    for name, method in _public_simplex_callables(sc):
+        lowered = name.lower()
+        if not any(word in lowered for word in ("has", "contain", "present")):
+            continue
+        try:
+            result = method(simplex)
+        except Exception:
+            continue
+        if isinstance(result, bool):
+            return result
+    raise AssertionError("No public simplex membership-check method found")
+
+
+def test_simplicial_complex_public_api_and_subclass():
+    from xgi.classes import SimplicialComplex
+
+    sc_from_top_level = xgi.SimplicialComplex()
+    sc_from_classes = SimplicialComplex()
+
+    assert isinstance(sc_from_top_level, xgi.Hypergraph)
+    assert isinstance(sc_from_classes, xgi.Hypergraph)
+
+
+@pytest.mark.parametrize(
+    ("method_name", "args"),
+    [
+        ("add_edge", ([1, 2],)),
+        ("add_edges_from", ([[1, 2]],)),
+        ("add_weighted_edges_from", ([([1, 2], 1.0)],)),
+        ("remove_edge", (0,)),
+        ("remove_edges_from", ([0],)),
+    ],
+)
+def test_regular_edge_mutation_methods_are_rejected(method_name, args):
+    sc = xgi.SimplicialComplex()
+
+    with pytest.raises(XGIError) as excinfo:
+        getattr(sc, method_name)(*args)
+
+    assert str(excinfo.value).strip()
+
+
+def test_single_simplex_adds_downward_closure():
+    sc = xgi.SimplicialComplex()
+
+    _add_one_simplex(sc, [1, 2, 3])
+
+    expected = _expected_non_singleton_faces({1, 2, 3})
+    assert sc.num_nodes == 3
+    assert sc.num_edges == 4
+    assert _memberships(sc) == expected
+
+    for simplex in expected:
+        assert _simplex_is_present(sc, simplex)
+
+
+def test_single_simplex_add_canonicalizes_nodes():
+    sc = xgi.SimplicialComplex()
+
+    _add_one_simplex(sc, [1, 2])
+    assert sc.num_nodes == 2
+    assert sc.num_edges == 1
+    assert _simplex_is_present(sc, [2, 1])
+    assert _memberships(sc) == {frozenset({1, 2})}
+
+    _add_one_simplex(sc, [2, 1])
+    assert sc.num_edges == 1
+
+
+def test_bulk_simplex_adds_downward_closure():
+    sc = xgi.SimplicialComplex()
+
+    _add_many_simplices(sc, [[10, 11, 12, 13]])
+
+    nodes = {10, 11, 12, 13}
+    expected = _expected_non_singleton_faces(nodes)
+
+    assert sc.num_nodes == 4
+    assert sc.num_edges == 11
+    assert _memberships(sc) == expected
+
+
+def test_duplicate_simplex_inputs_do_not_create_new_simplices():
+    sc = xgi.SimplicialComplex()
+
+    _add_one_simplex(sc, [1, 2, 3])
+    count_after_first_add = sc.num_edges
+
+    _add_one_simplex(sc, [3, 2, 1])
+    assert sc.num_edges == count_after_first_add
+
+    _add_one_simplex(sc, [1, 2])
+    assert sc.num_edges == count_after_first_add
+    assert _simplex_is_present(sc, [2, 1])
+    assert not _simplex_is_present(sc, [1, 4])
+
+
+def test_simplicial_complex_string_summary():
+    unnamed = xgi.SimplicialComplex()
+    unnamed_summary = str(unnamed)
+    assert type(unnamed).__name__ in unnamed_summary
+    assert "simplic" in unnamed_summary.lower()
+    assert "hyperedge" not in unnamed_summary.lower()
+
+    named = xgi.SimplicialComplex(name="example")
+    _add_one_simplex(named, [1, 2, 3])
+    named_summary = str(named)
+    assert type(named).__name__ in named_summary
+    assert "example" in named_summary
+    assert "simplic" in named_summary.lower()
+    assert "hyperedge" not in named_summary.lower()
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,49 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+setup_env() {
+
+  export PATH="$HOME/.pyenv/bin:$PATH"
+  set +u
+  eval "$(pyenv init --path)"
+  eval "$(pyenv init -)"
+  pyenv shell 3.9.21
+  set -u
+
+  python3 -m venv /testbed/.venv
+  set +u
+  source /testbed/.venv/bin/activate
+  set -u
+
+
+  if [ ! -f /testbed/.venv/.stage3a_deps_installed ]; then
+    pip install --upgrade pip "setuptools<70" wheel --no-input
+    pip install "numpy>=1.19,<1.22" "scipy>=1.5,<1.8.0" "pandas>=1.0,<=1.3.5" "networkx>=2.0" pytest pytest-cov --no-input
+    touch /testbed/.venv/.stage3a_deps_installed
+  fi
+  pip install -e /testbed --no-build-isolation --no-input
+}
+
+setup_env
+
+case "${1:-}" in
+  base)
+    python -m pytest \
+      tests/classes/test_hypergraph.py \
+      tests/generators/test_classic.py \
+      tests/linalg/test_matrix.py \
+      -k "not test_duplicate_edges_reports_repeated_memberships" \
+      -v
+    ;;
+  new)
+    python -m pytest \
+      tests/classes/test_hypergraph.py::test_duplicate_edges_reports_repeated_memberships \
+      tests/classes/test_simplicialcomplex.py \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
