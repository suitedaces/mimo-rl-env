@@ -0,0 +1,30 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+run_proxy_tests() {
+python3 - "$@" <<'PY'
+import builtins
+import sys
+
+builtins.basestring = str
+builtins.unicode = str
+
+import pytest
+sys.exit(pytest.main(sys.argv[1:]))
+PY
+}
+
+case "${1:-}" in
+  base)
+    echo "No pre-existing regression tests are required for this Fixture.A patch."
+    exit 0
+    ;;
+  new)
+    run_proxy_tests -xvs --noconftest test/test_proxy.py
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
