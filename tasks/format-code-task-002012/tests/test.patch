diff --git a/test/test_proxy.py b/test/test_proxy.py
new file mode 100644
index 0000000..6943924
--- /dev/null
+++ b/test/test_proxy.py
@@ -0,0 +1,163 @@
+from mock import Mock, patch
+import pytest
+
+from nameko import proxy
+from nameko.testing.proxy import MockRPCProxy
+
+
+def _context_factory():
+    context = Mock()
+    return lambda: context
+
+
+@patch.object(proxy, 'rpc')
+def test_reset_restores_initial_fallback_false(rpc):
+    rpcproxy = MockRPCProxy(
+        context_factory=_context_factory(), fallback_to_call=False)
+    rpcproxy.fallback_to_call = True
+
+    rpcproxy.reset()
+
+    assert rpcproxy.fallback_to_call is False
+    with pytest.raises(RuntimeError):
+        rpcproxy.reset_service.reset_method()
+    assert rpc.call.call_count == 0
+
+
+@patch.object(proxy, 'rpc')
+def test_reset_restores_initial_fallback_true(rpc):
+    rpcproxy = MockRPCProxy(
+        context_factory=_context_factory(), fallback_to_call=True)
+    rpcproxy.fallback_to_call = False
+
+    rpcproxy.reset()
+
+    assert rpcproxy.fallback_to_call is True
+    rpcproxy.restored_service.restored_method()
+    assert rpc.call.call_count == 1
+    assert rpc.call.call_args[0][2] == 'restored_service'
+    assert rpc.call.call_args[0][3]['method'] == 'restored_method'
+
+
+@patch.object(proxy, 'rpc')
+def test_attribute_service_proxy_respects_disabled_fallback(rpc):
+    rpcproxy = MockRPCProxy(
+        context_factory=_context_factory(), fallback_to_call=True)
+    rpcproxy.fallback_to_call = False
+
+    with pytest.raises(RuntimeError):
+        rpcproxy(topic='direct_disabled', method='direct_method')
+    with pytest.raises(RuntimeError):
+        rpcproxy.attribute_disabled.attribute_method()
+    assert rpc.call.call_count == 0
+
+
+@patch.object(proxy, 'rpc')
+def test_attribute_service_proxy_respects_enabled_fallback(rpc):
+    rpcproxy = MockRPCProxy(
+        context_factory=_context_factory(), fallback_to_call=False)
+    rpcproxy.fallback_to_call = True
+
+    rpcproxy(topic='direct_enabled', method='direct_method', marker='one')
+    rpcproxy.attribute_enabled.attribute_method(marker='two')
+
+    assert rpc.call.call_count == 2
+    first_call = rpc.call.call_args_list[0][0]
+    second_call = rpc.call.call_args_list[1][0]
+    assert first_call[2] == 'direct_enabled'
+    assert first_call[3] == {
+        'method': 'direct_method',
+        'args': {'marker': 'one'},
+    }
+    assert second_call[2] == 'attribute_enabled'
+    assert second_call[3] == {
+        'method': 'attribute_method',
+        'args': {'marker': 'two'},
+    }
+
+
+@patch.object(proxy, 'rpc')
+def test_add_service_to_whitelist_allows_only_named_services(rpc):
+    rpcproxy = MockRPCProxy(
+        context_factory=_context_factory(), fallback_to_call=False)
+
+    rpcproxy.add_service_to_whitelist('allowed_service')
+    rpcproxy.allowed_service.allowed_method(token='allowed')
+
+    assert rpc.call.call_count == 1
+    assert rpc.call.call_args[0][2] == 'allowed_service'
+    assert rpc.call.call_args[0][3] == {
+        'method': 'allowed_method',
+        'args': {'token': 'allowed'},
+    }
+
+    with pytest.raises(RuntimeError):
+        rpcproxy.blocked_service.blocked_method()
+    assert rpc.call.call_count == 1
+
+
+@patch.object(proxy, 'rpc')
+def test_whitelist_is_cleared_by_reset(rpc):
+    rpcproxy = MockRPCProxy(
+        context_factory=_context_factory(), fallback_to_call=False)
+
+    rpcproxy.add_service_to_whitelist('first_allowed')
+    rpcproxy.add_service_to_whitelist('second_allowed')
+    rpcproxy.first_allowed.before_reset()
+    assert rpc.call.call_count == 1
+
+    rpcproxy.reset()
+
+    assert rpcproxy.fallback_to_call is False
+    with pytest.raises(RuntimeError):
+        rpcproxy.first_allowed.after_reset()
+    with pytest.raises(RuntimeError):
+        rpcproxy.second_allowed.after_reset()
+    assert rpc.call.call_count == 1
+
+
+@patch.object(proxy, 'rpc')
+def test_reset_without_mutation_keeps_initial_fallback_disabled(rpc):
+    rpcproxy = MockRPCProxy(
+        context_factory=_context_factory(), fallback_to_call=False)
+
+    rpcproxy.reset()
+
+    assert rpcproxy.fallback_to_call is False
+    with pytest.raises(RuntimeError):
+        rpcproxy.unmutated_service.unmutated_method()
+    assert rpc.call.call_count == 0
+
+
+@patch.object(proxy, 'rpc')
+def test_reset_without_mutation_keeps_initial_fallback_enabled(rpc):
+    rpcproxy = MockRPCProxy(
+        context_factory=_context_factory(), fallback_to_call=True)
+
+    rpcproxy.reset()
+
+    assert rpcproxy.fallback_to_call is True
+    rpcproxy.enabled_without_mutation.enabled_method()
+    assert rpc.call.call_count == 1
+    assert rpc.call.call_args[0][2] == 'enabled_without_mutation'
+    assert rpc.call.call_args[0][3]['method'] == 'enabled_method'
+
+
+@patch.object(proxy, 'rpc')
+def test_reset_keep_routings_still_resets_fallback_and_whitelist(rpc):
+    rpcproxy = MockRPCProxy(
+        context_factory=_context_factory(), fallback_to_call=False)
+    response = object()
+    rpcproxy.add_dummy('kept_service', 'kept_method', response)
+    rpcproxy.add_service_to_whitelist('temporary_service')
+    rpcproxy.temporary_service.before_reset()
+    assert rpc.call.call_count == 1
+    rpcproxy.fallback_to_call = True
+
+    rpcproxy.reset(keep_routings=True)
+
+    assert rpcproxy.fallback_to_call is False
+    assert rpcproxy.kept_service.kept_method() is response
+    with pytest.raises(RuntimeError):
+        rpcproxy.temporary_service.after_reset()
+    assert rpc.call.call_count == 1
