@@ -0,0 +1,16 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 openstack/compute_flavor_v2.go openstack/compute_flavor_v2_test.go
+    ;;
+  new)
+    go test -v -count=1 -run '^TestDNSRecordSetV2UpdatePreservesTTLSemanticsInRequestBody$' ./openstack/
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
