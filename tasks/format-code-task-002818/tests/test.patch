diff --git a/openstack/resource_openstack_dns_recordset_v2_ttl_request_test.go b/openstack/resource_openstack_dns_recordset_v2_ttl_request_test.go
new file mode 100644
index 00000000..8a44e875
--- /dev/null
+++ b/openstack/resource_openstack_dns_recordset_v2_ttl_request_test.go
@@ -0,0 +1,164 @@
+package openstack
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"testing"
+
+	"github.com/gophercloud/gophercloud"
+	"github.com/hashicorp/terraform/helper/schema"
+	"github.com/hashicorp/terraform/terraform"
+)
+
+func TestDNSRecordSetV2UpdatePreservesTTLSemanticsInRequestBody(t *testing.T) {
+	tests := []struct {
+		name       string
+		oldTTL     string
+		newTTL     string
+		records    []string
+		wantTTL    int
+	}{
+		{
+			name:    "records only update preserves server ttl",
+			oldTTL:  "4200",
+			newTTL:  "4200",
+			records: []string{"10.1.0.77"},
+			wantTTL: 4200,
+		},
+		{
+			name:    "positive ttl update persists configured value",
+			oldTTL:  "1800",
+			newTTL:  "4200",
+			records: []string{"10.1.0.55"},
+			wantTTL: 4200,
+		},
+		{
+			name:    "explicit ttl clear uses service default",
+			oldTTL:  "4200",
+			newTTL:  "0",
+			records: []string{"10.1.0.88"},
+			wantTTL: 0,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			gotTTL := applyRecordSetProviderUpdateAndReadTTL(t, tt.oldTTL, tt.newTTL, tt.records)
+			if gotTTL != tt.wantTTL {
+				t.Fatalf("server ttl after update = %d, want %d", gotTTL, tt.wantTTL)
+			}
+		})
+	}
+}
+
+func applyRecordSetProviderUpdateAndReadTTL(t *testing.T, oldTTL, newTTL string, records []string) int {
+	t.Helper()
+
+	serverTTL, err := strconv.Atoi(oldTTL)
+	if err != nil {
+		t.Fatalf("invalid old ttl %q: %s", oldTTL, err)
+	}
+	serverRecords := []string{"10.1.0.55"}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.Method {
+		case "PUT":
+			var body map[string]interface{}
+			if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+				t.Fatalf("could not decode request body: %s", err)
+			}
+			if ttl, ok := body["ttl"]; ok {
+				switch v := ttl.(type) {
+				case nil:
+					serverTTL = 0
+				case float64:
+					if v <= 0 {
+						serverTTL = 0
+					} else {
+						serverTTL = int(v)
+					}
+				default:
+					t.Fatalf("unexpected ttl value %#v", ttl)
+				}
+			}
+			if rawRecords, ok := body["records"].([]interface{}); ok {
+				serverRecords = make([]string, len(rawRecords))
+				for i, rawRecord := range rawRecords {
+					serverRecords[i], _ = rawRecord.(string)
+				}
+			}
+			writeRecordSetUpdateResponse(t, w, serverTTL, serverRecords)
+		case "GET":
+			writeRecordSetUpdateResponse(t, w, serverTTL, serverRecords)
+		default:
+			t.Fatalf("unexpected method %s", r.Method)
+		}
+	}))
+	defer server.Close()
+
+	provider := Provider().(*schema.Provider)
+
+	provider.SetMeta(&Config{
+		EndpointOverrides: map[string]interface{}{},
+		OsClient: &gophercloud.ProviderClient{
+			EndpointLocator: func(opts gophercloud.EndpointOpts) (string, error) {
+				return server.URL + "/", nil
+			},
+		},
+	})
+
+	info := &terraform.InstanceInfo{
+		Id:         "openstack_dns_recordset_v2.recordset_1",
+		Type:       "openstack_dns_recordset_v2",
+		ModulePath: []string{"root"},
+	}
+	state := &terraform.InstanceState{
+		ID: "zone-id/recordset-id",
+		Attributes: map[string]string{
+			"id":        "zone-id/recordset-id",
+			"zone_id":   "zone-id",
+			"name":      "example.com.",
+			"type":      "A",
+			"ttl":       oldTTL,
+			"records.#": "1",
+			"records.0": "10.1.0.55",
+		},
+		Meta: map[string]interface{}{},
+	}
+	diff := &terraform.InstanceDiff{
+		Attributes: map[string]*terraform.ResourceAttrDiff{
+			"records.#": {Old: "1", New: "1"},
+			"records.0": {Old: state.Attributes["records.0"], New: records[0]},
+			"ttl":       {Old: oldTTL, New: newTTL},
+		},
+		Meta: map[string]interface{}{},
+	}
+
+	newState, err := provider.Apply(info, state, diff)
+	if err != nil {
+		t.Fatalf("provider update failed: %s", err)
+	}
+
+	gotTTL, err := strconv.Atoi(newState.Attributes["ttl"])
+	if err != nil {
+		t.Fatalf("provider state ttl %q is not an integer: %s", newState.Attributes["ttl"], err)
+	}
+
+	return gotTTL
+}
+
+func writeRecordSetUpdateResponse(t *testing.T, w http.ResponseWriter, ttl int, records []string) {
+	t.Helper()
+
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusOK)
+	if err := json.NewEncoder(w).Encode(map[string]interface{}{
+		"id":      "recordset-id",
+		"ttl":     ttl,
+		"status":  "ACTIVE",
+		"records": records,
+	}); err != nil {
+		t.Fatalf("could not encode response: %s", err)
+	}
+}
