+def _make_n_step_replay_buffer(replay_buffer_type, num_steps):
+    if replay_buffer_type == 'ReplayBuffer':
+        return replay_buffer.ReplayBuffer(capacity=None, num_steps=num_steps)
+    if replay_buffer_type == 'PrioritizedReplayBuffer':
+        return replay_buffer.PrioritizedReplayBuffer(
+            capacity=None, num_steps=num_steps)
+    assert False
+
+
+def _append_marked_transition(rbuf, env_id, step, is_state_terminal=False):
+    rbuf.append(
+        state=(env_id, step),
+        action=(env_id, 'action', step),
+        reward=step,
+        next_state=(env_id, step + 1),
+        next_action=(env_id, 'action', step + 1),
+        is_state_terminal=is_state_terminal,
+        env_id=env_id)
+
+
+def _sample_all_sequences(rbuf):
+    return rbuf.sample(len(rbuf))
+
+
+def _sequence_envs(sequence):
+    return set(transition['state'][0] for transition in sequence)
+
+
+def _sequence_signature(sequence):
+    return (
+        next(iter(_sequence_envs(sequence))),
+        tuple(transition['state'][1] for transition in sequence),
+    )
+
+
+@testing.parameterize(*testing.product({
+    'replay_buffer_type': ['ReplayBuffer', 'PrioritizedReplayBuffer'],
+}))
+class TestReplayBufferWithEnvID(unittest.TestCase):
+
+    def test_interleaved_env_sequences_do_not_mix(self):
+        rbuf = _make_n_step_replay_buffer(self.replay_buffer_type, 3)
+
+        schedule = [
+            ('left', 0),
+            ('right', 0),
+            ('third', 0),
+            ('left', 1),
+            ('right', 1),
+            ('left', 2),
+            ('third', 1),
+            ('right', 2),
+        ]
+        for env_id, step in schedule:
+            _append_marked_transition(rbuf, env_id, step)
+
+        sequences = _sample_all_sequences(rbuf)
+        self.assertEqual(len(sequences), 2)
+        for sequence in sequences:
+            self.assertEqual(len(_sequence_envs(sequence)), 1)
+
+        observed = sorted(
+            (next(iter(_sequence_envs(sequence))), len(sequence))
+            for sequence in sequences)
+        self.assertEqual(observed, [('left', 3), ('right', 3)])
+
+    def test_stop_current_episode_is_env_scoped(self):
+        rbuf = _make_n_step_replay_buffer(self.replay_buffer_type, 3)
+
+        _append_marked_transition(rbuf, 'alpha', 0)
+        _append_marked_transition(rbuf, 'beta', 0)
+        _append_marked_transition(rbuf, 'alpha', 1)
+
+        rbuf.stop_current_episode(env_id='alpha')
+
+        _append_marked_transition(rbuf, 'beta', 1)
+        _append_marked_transition(rbuf, 'beta', 2)
+
+        sequences = _sample_all_sequences(rbuf)
+        observed = sorted(
+            _sequence_signature(sequence)
+            for sequence in sequences)
+        self.assertEqual(observed, [
+            ('alpha', (0, 1)),
+            ('alpha', (1,)),
+            ('beta', (0, 1, 2)),
+        ])
+        for sequence in sequences:
+            self.assertEqual(len(_sequence_envs(sequence)), 1)
+
+
+def _make_episodic_replay_buffer(replay_buffer_type):
+    if replay_buffer_type == 'EpisodicReplayBuffer':
+        return replay_buffer.EpisodicReplayBuffer(capacity=None)
+    if replay_buffer_type == 'PrioritizedEpisodicReplayBuffer':
+        return replay_buffer.PrioritizedEpisodicReplayBuffer(capacity=None)
+    assert False
+
+
+@testing.parameterize(*testing.product({
+    'replay_buffer_type': ['EpisodicReplayBuffer',
+                           'PrioritizedEpisodicReplayBuffer'],
+}))
+class TestEpisodicReplayBufferWithEnvID(unittest.TestCase):
+
+    def test_interleaved_episodes_do_not_mix(self):
+        rbuf = _make_episodic_replay_buffer(self.replay_buffer_type)
+
+        object_env = object()
+        _append_marked_transition(rbuf, 'left', 0)
+        _append_marked_transition(rbuf, 'right', 0)
+        _append_marked_transition(rbuf, 'left', 1, is_state_terminal=True)
+        _append_marked_transition(rbuf, object_env, 0)
+        _append_marked_transition(rbuf, 'right', 1)
+        _append_marked_transition(rbuf, 'right', 2,
+                                  is_state_terminal=True)
+
+        rbuf.stop_current_episode(env_id=object_env)
+
+        episodes = rbuf.sample_episodes(rbuf.n_episodes, max_len=10)
+        if isinstance(episodes, tuple):
+            episodes = episodes[0]
+        observed = sorted(
+            (repr(next(iter(_sequence_envs(episode)))), len(episode))
+            for episode in episodes)
+        expected = sorted([
+            (repr('left'), 2),
+            (repr('right'), 3),
+            (repr(object_env), 1),
+        ])
+        self.assertEqual(observed, expected)
+        for episode in episodes:
+            self.assertEqual(len(_sequence_envs(episode)), 1)
+
+
+class TestReplayBufferAppendKwargs(unittest.TestCase):
+
+    def test_extra_fields_are_sampled(self):
+        rbuf = replay_buffer.ReplayBuffer(capacity=None, num_steps=1)
+
+        rbuf.append(
+            state='state',
+            action='action',
+            reward=1,
+            next_state='next_state',
+            next_action='next_action',
+            custom_marker=('marker', 7))
+
+        experience = rbuf.sample(1)[0][0]
+        self.assertEqual(experience['custom_marker'], ('marker', 7))
+
