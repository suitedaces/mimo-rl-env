+import unittest
+
+from chainerrl.agents import ddpg
+from chainerrl.agents import dqn
+
+
+class _RecordingReplayBuffer(object):
+
+    def __init__(self):
+        self.append_env_ids = []
+        self.stop_env_ids = []
+
+    def append(self, state, action, reward, next_state=None, next_action=None,
+               is_state_terminal=False, **kwargs):
+        self.append_env_ids.append(kwargs.get('env_id', None))
+
+    def stop_current_episode(self, **kwargs):
+        self.stop_env_ids.append(kwargs.get('env_id', None))
+
+
+class _RecordingReplayUpdater(object):
+
+    def __init__(self):
+        self.calls = []
+
+    def update_if_necessary(self, t):
+        self.calls.append(t)
+
+
+def _make_minimal_agent(agent_type):
+    agent = agent_type.__new__(agent_type)
+    agent.batch_last_obs = ['prev0', 'prev1', 'prev2', 'prev3']
+    agent.batch_last_action = ['act0', 'act1', 'act2', 'act3']
+    agent.replay_buffer = _RecordingReplayBuffer()
+    agent.replay_updater = _RecordingReplayUpdater()
+    agent.t = 0
+    agent.target_update_interval = 100
+    agent.sync_target_network = lambda: None
+    return agent
+
+
+class TestBatchReplayEnvID(unittest.TestCase):
+
+    def _check_batch_observe_and_train_scopes_replay(self, agent_type):
+        agent = _make_minimal_agent(agent_type)
+
+        agent_type.batch_observe_and_train(
+            agent,
+            batch_obs=['obs0', 'obs1', 'obs2', 'obs3'],
+            batch_reward=[0.0, 1.0, 2.0, 3.0],
+            batch_done=[False, True, False, False],
+            batch_reset=[False, False, False, True])
+
+        append_env_ids = agent.replay_buffer.append_env_ids
+        stop_env_ids = agent.replay_buffer.stop_env_ids
+
+        self.assertEqual(len(append_env_ids), 4)
+        self.assertEqual(len(set(append_env_ids)), 4)
+        self.assertEqual(stop_env_ids,
+                         [append_env_ids[1], append_env_ids[3]])
+
+    def test_dqn_batch_observe_and_train_scopes_replay_by_batch_position(self):
+        self._check_batch_observe_and_train_scopes_replay(dqn.DQN)
+
+    def test_ddpg_batch_observe_and_train_scopes_replay_by_batch_position(self):
+        self._check_batch_observe_and_train_scopes_replay(ddpg.DDPG)
