@@ -0,0 +1,31 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+dev-switch python3 3.11 2>/dev/null || true
+python3 -m pip install --no-input -e . 'numpy<2' 'setuptools<60' opencv-python-headless pytest 2>/dev/null || true
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest tests/test_replay_buffer.py -v \
+      --ignore=tests/test_agent_batch_replay_env_id.py \
+      -k 'not TestReplayBufferWithEnvID and not TestEpisodicReplayBufferWithEnvID and not TestReplayBufferAppendKwargs'
+    ;;
+  new)
+    python3 -m pytest tests/test_replay_buffer.py \
+      -k 'TestReplayBufferWithEnvID or TestEpisodicReplayBufferWithEnvID or TestReplayBufferAppendKwargs' \
+      -v
+    replay_exit=$?
+    python3 -m pytest tests/test_agent_batch_replay_env_id.py -v
+    agent_exit=$?
+    if [ "$replay_exit" -ne 0 ] || [ "$agent_exit" -ne 0 ]; then
+      exit 1
+    fi
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
