+test('Parse Trans component with defaults attribute on self-closing tag', (t) => {
+    const parser = new Parser({
+        lngs: ['en'],
+        trans: {
+            fallbackKey: true
+        },
+        nsSeparator: false,
+        keySeparator: false,
+        fallbackLng: 'en'
+    });
+    parser.parseTransFromString('<Trans defaults="Hello <0>{val}</0>!" />');
+    t.same(parser.get(), {
+        en: {
+            translation: {
+                "Hello <0>{val}</0>!": "Hello <0>{val}</0>!"
+            }
+        }
+    });
+    t.end();
+});
+
+test('Parse Trans component defaults attribute overrides children fragment', (t) => {
+    const parser = new Parser({
+        lngs: ['en'],
+        nsSeparator: false,
+        keySeparator: false,
+        fallbackLng: 'en'
+    });
+    parser.parseTransFromString('<Trans i18nKey="myKey" defaults="From defaults attr">From child fragment</Trans>');
+    t.same(parser.get(), {
+        en: {
+            translation: {
+                "myKey": "From defaults attr"
+            }
+        }
+    });
+    t.end();
+});
+
+test('Parse Trans component preserves children when no defaults attribute', (t) => {
+    const parser = new Parser({
+        lngs: ['en'],
+        nsSeparator: false,
+        keySeparator: false,
+        fallbackLng: 'en'
+    });
+    parser.parseTransFromString('<Trans i18nKey="plainKey">Just children content</Trans>');
+    t.same(parser.get(), {
+        en: {
+            translation: {
+                "plainKey": "Just children content"
+            }
+        }
+    });
+    t.end();
+});
+
+test('Parse Trans component matches self-closing tag without defaults', (t) => {
+    const parser = new Parser({
+        lngs: ['en'],
+        nsSeparator: false,
+        keySeparator: false,
+        fallbackLng: 'en'
+    });
+    parser.parseTransFromString('<Trans i18nKey="selfClosingKey" />');
+    t.same(parser.get(), {
+        en: {
+            translation: {
+                "selfClosingKey": ""
+            }
+        }
+    });
+    t.end();
+});
