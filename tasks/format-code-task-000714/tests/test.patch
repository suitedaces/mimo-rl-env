+package bodyprocessors_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/corazawaf/coraza/v2"
+	"github.com/corazawaf/coraza/v2/bodyprocessors"
+	"github.com/corazawaf/coraza/v2/seclang"
+	"github.com/corazawaf/coraza/v2/types/variables"
+)
+
+func TestJSONProcessorFlattensTopLevelArraysAndScalars(t *testing.T) {
+	p, err := bodyprocessors.GetBodyProcessor("json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = p.Read(strings.NewReader(`["alpha", 2, true, null, ["nested"]]`), bodyprocessors.Options{})
+	if err != nil {
+		t.Fatalf("reading JSON array: %v", err)
+	}
+	args := p.Collections()[variables.Args]
+	want := map[string]string{
+		"json.0":   "alpha",
+		"json.1":   "2",
+		"json.2":   "true",
+		"json.3":   "",
+		"json.4.0": "nested",
+	}
+	for key, value := range want {
+		got := args[key]
+		if len(got) != 1 || got[0] != value {
+			t.Errorf("%s = %v, want %q", key, got, value)
+		}
+	}
+}
+
+func TestJSONProcessorFindsPathsForSecRule(t *testing.T) {
+	waf := coraza.NewWaf()
+	parser, err := seclang.NewParser(waf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := parser.FromString(`
+SecRuleEngine On
+SecRule JSON:user.name "alice" "id:9101,phase:2,pass"
+SecRule JSON:items.1 "2" "id:9102,phase:2,pass"
+SecRule JSON:user.missing ".+" "id:9103,phase:2,pass"
+`); err != nil {
+		t.Fatal(err)
+	}
+	tx := waf.NewTransaction()
+	tx.RequestBodyAccess = true
+	tx.GetCollection(variables.ReqbodyProcessor).Set("", []string{"JSON"})
+	if _, err := tx.RequestBodyBuffer.Write([]byte(`{"user":{"name":"alice"},"items":["x",2]}`)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := tx.ProcessRequestBody(); err != nil {
+		t.Fatal(err)
+	}
+	if got := tx.GetCollection(variables.ArgsPost).GetFirstString("json.user.name"); got != "alice" {
+		t.Fatalf("ARGS_POST did not receive JSON field: %q", got)
+	}
+	if got := tx.GetCollection(variables.Args).GetFirstString("json.items.1"); got != "2" {
+		t.Fatalf("ARGS did not receive JSON array field: %q", got)
+	}
+	matched := map[int]bool{}
+	for _, rule := range tx.MatchedRules {
+		matched[rule.Rule.ID] = true
+	}
+	if !matched[9101] || !matched[9102] {
+		t.Fatalf("JSON paths did not match: %#v", matched)
+	}
+	if matched[9103] {
+		t.Fatal("missing JSON path unexpectedly matched")
+	}
+}
+
+func TestJSONProcessorRejectsInvalidAndScalarRoots(t *testing.T) {
+	for _, body := range []string{`not-json`, `42`, `"text"`, `true`, `null`} {
+		p, err := bodyprocessors.GetBodyProcessor("json")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := p.Read(strings.NewReader(body), bodyprocessors.Options{}); err == nil {
+			t.Errorf("Read(%q) succeeded, want an error", body)
+		}
+	}
+}
