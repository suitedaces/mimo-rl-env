+const assert = require("node:assert/strict");
+const test = require("node:test");
+const path = require("node:path");
+
+
+
+
+
+
+
+
+
+
+function installDomStub() {
+    const element = () => ({
+        checked: false,
+        value: "0",
+        hidden: false,
+        innerHTML: "",
+        selectedIndex: 0,
+        oncontextmenu: null,
+        addEventListener() {},
+        appendChild() {},
+        setAttribute() {},
+        getContext() { return {}; },
+        preventDefault() {},
+        stopPropagation() {},
+    });
+
+    global.document = {
+        querySelector() { return element(); },
+        querySelectorAll() { return [element(), element(), element(), element()]; },
+        createElement() { return element(); },
+        body: element(),
+    };
+    global.window = {
+        addEventListener() {},
+        requestAnimationFrame() {},
+    };
+}
+
+let modulesPromise;
+
+async function loadPhysics() {
+    if (modulesPromise === undefined) {
+        installDomStub();
+        const out = "/workspace/repo/out";
+        modulesPromise = Promise.all([
+            import(path.join(out, "world.js")),
+            import(path.join(out, "distance.js")),
+            import(path.join(out, "circle.js")),
+            import(path.join(out, "rigidbody.js")),
+            import(path.join(out, "math.js")),
+            import(path.join(out, "settings.js")),
+        ]).then(([world, distance, circle, rigidbody, math, settings]) => ({
+            World: world.World,
+            DistanceJoint: distance.DistanceJoint,
+            Circle: circle.Circle,
+            Type: rigidbody.Type,
+            Vector2: math.Vector2,
+            Settings: settings.Settings,
+        }));
+    }
+
+    return modulesPromise;
+}
+
+function round(value) {
+    return Number(value.toFixed(12));
+}
+
+function vectorLiteral(v) {
+    return { x: round(v.x), y: round(v.y) };
+}
+
+function bodyLiteral(body) {
+    return {
+        x: round(body.position.x),
+        y: round(body.position.y),
+        vx: round(body.linearVelocity.x),
+        vy: round(body.linearVelocity.y),
+        rot: round(body.rotation),
+        av: round(body.angularVelocity),
+        resting: round(body.resting),
+    };
+}
+
+function anchorSeparation(joint) {
+    const anchorA = joint.bodyA.position.add(joint.bodyA.localToGlobal.mulVector2(joint.localAnchorA, 0));
+    const anchorB = joint.bodyB.position.add(joint.bodyB.localToGlobal.mulVector2(joint.localAnchorB, 0));
+    return round(anchorB.sub(anchorA).length);
+}
+
+function assertApprox(actual, expected, tolerance = 1e-9) {
+    assert.ok(
+        Math.abs(actual - expected) <= tolerance,
+        `expected ${actual} to be within ${tolerance} of ${expected}`,
+    );
+}
+
+function assertFiniteBodyState(body) {
+    for (const value of Object.values(bodyLiteral(body))) {
+        assert.ok(Number.isFinite(value), `expected finite body state value, got ${value}`);
+    }
+}
+
+function assertCloserToTarget(actual, previous, target) {
+    assert.ok(
+        Math.abs(actual - target) < Math.abs(previous - target),
+        `expected ${actual} to be closer to ${target} than ${previous}`,
+    );
+}
+
+function assertCenterJointPullsBodiesTogether(a, b, separation, previousSeparation, targetLength) {
+    assertCloserToTarget(separation, previousSeparation, targetLength);
+    assertFiniteBodyState(a);
+    assertFiniteBodyState(b);
+    assert.ok(a.position.x > 0, "body A should move toward body B");
+    assert.ok(b.position.x < 4, "body B should move toward body A");
+    assert.ok(a.linearVelocity.x > 0, "body A should receive a corrective linear impulse");
+    assert.ok(b.linearVelocity.x < 0, "body B should receive a corrective linear impulse");
+    assertApprox(a.linearVelocity.y, 0);
+    assertApprox(b.linearVelocity.y, 0);
+    assertApprox(a.angularVelocity, 0);
+    assertApprox(b.angularVelocity, 0);
+}
+
+function assertBodyStill(body, x, y) {
+    const state = bodyLiteral(body);
+    assert.deepEqual(
+        { x: state.x, y: state.y, vx: state.vx, vy: state.vy, rot: state.rot, av: state.av },
+        { x, y, vx: 0, vy: 0, rot: 0, av: 0 },
+    );
+}
+
+function resetSettings(Settings) {
+    Settings.applyGravity = false;
+    Settings.positionCorrection = true;
+    Settings.warmStarting = true;
+    Settings.sleepEnabled = false;
+    Settings.numIterations = 10;
+    Settings.dt = 1 / 60;
+    Settings.inv_dt = 60;
+}
+
+function makeCircle(api, x, y) {
+    const body = new api.Circle(1, api.Type.Dynamic, 12.5);
+    body.position = new api.Vector2(x, y);
+    return body;
+}
+
+test("constructor anchors, length defaults, clamp, and inherited stiffness are observable", async () => {
+
+
+
+
+    const api = await loadPhysics();
+    resetSettings(api.Settings);
+
+    const a = makeCircle(api, 1, 2);
+    const b = makeCircle(api, 4, 6);
+    const defaultJoint = new api.DistanceJoint(a, b);
+
+    assert.deepEqual(vectorLiteral(defaultJoint.localAnchorA), { x: 0, y: 0 });
+    assert.deepEqual(vectorLiteral(defaultJoint.localAnchorB), { x: 0, y: 0 });
+    assert.equal(round(defaultJoint.length), 5);
+
+    assert.ok(defaultJoint.frequency > 0);
+    assert.equal(defaultJoint.isSolid, false);
+
+    defaultJoint.length = 1;
+    assert.equal(round(defaultJoint.length), 1);
+    defaultJoint.length = -5;
+    assert.equal(round(defaultJoint.length), 0);
+
+    const c = makeCircle(api, 10, 20);
+    const d = makeCircle(api, 15, 24);
+    c.rotation = Math.PI / 2;
+    d.rotation = Math.PI;
+    const solidJoint = new api.DistanceJoint(
+        c,
+        d,
+        new api.Vector2(11, 22),
+        new api.Vector2(14, 24),
+        -1,
+        0,
+        0.5,
+        3,
+    );
+
+    assert.deepEqual(vectorLiteral(solidJoint.localAnchorA), { x: 2, y: -1 });
+    assert.deepEqual(vectorLiteral(solidJoint.localAnchorB), { x: 1, y: 0 });
+    assert.equal(round(solidJoint.length), 3.605551275464);
+
+    assert.ok(solidJoint.frequency <= 0);
+    assert.equal(solidJoint.isSolid, true);
+});
+
+test("registered center-anchor joint changes later solves and body state toward the target length", async () => {
+
+
+
+
+    const api = await loadPhysics();
+    resetSettings(api.Settings);
+
+    const world = new api.World();
+    const a = makeCircle(api, 0, 0);
+    const b = makeCircle(api, 4, 0);
+    const joint = new api.DistanceJoint(a, b, a.position, b.position, 2, 15, 1);
+
+    assert.equal(world.numBodies, 0);
+    assert.equal(world.numJoints, 0);
+    assert.equal(round(joint.length), 2);
+    assert.deepEqual(vectorLiteral(joint.localAnchorA), { x: 0, y: 0 });
+    assert.deepEqual(vectorLiteral(joint.localAnchorB), { x: 0, y: 0 });
+
+    world.register(a);
+    world.register(b);
+    world.register(joint);
+
+    assert.equal(world.numBodies, 2);
+    assert.equal(world.numJoints, 1);
+
+    assert.ok(joint.id >= 0);
+    assert.ok(a.jointIDs.includes(joint.id));
+    assert.ok(b.jointIDs.includes(joint.id));
+    assert.equal(anchorSeparation(joint), 4);
+
+    world.update(1 / 60);
+
+    assert.ok(world.numIslands >= 1);
+    const sepAfterFirst = anchorSeparation(joint);
+    assertCenterJointPullsBodiesTogether(a, b, sepAfterFirst, 4, 2);
+
+    world.update(1 / 60);
+
+    const sepAfterSecond = anchorSeparation(joint);
+    assertCenterJointPullsBodiesTogether(a, b, sepAfterSecond, sepAfterFirst, 2);
+
+    joint.length = 1;
+    assert.equal(round(joint.length), 1);
+    world.update(1 / 60);
+
+    const sepAfterLengthOne = anchorSeparation(joint);
+    assertCenterJointPullsBodiesTogether(a, b, sepAfterLengthOne, sepAfterSecond, 1);
+
+    joint.length = -5;
+    assert.equal(round(joint.length), 0);
+    world.update(1 / 60);
+
+    const sepAfterClamp = anchorSeparation(joint);
+    assertCenterJointPullsBodiesTogether(a, b, sepAfterClamp, sepAfterLengthOne, 0);
+});
+
+test("offset anchors apply linear and angular impulse, with warm-starting altering the second solve", async () => {
+
+
+
+
+    const api = await loadPhysics();
+
+    function run(warmStarting) {
+        resetSettings(api.Settings);
+        api.Settings.warmStarting = warmStarting;
+
+        const world = new api.World();
+        const a = makeCircle(api, 0, 0);
+        const b = makeCircle(api, 4, 0);
+        const joint = new api.DistanceJoint(
+            a,
+            b,
+            new api.Vector2(0, 1),
+            new api.Vector2(4, -1),
+            2,
+            15,
+            1,
+        );
+
+        world.register(a);
+        world.register(b);
+        world.register(joint);
+        world.update(1 / 60);
+        const first = { sep: anchorSeparation(joint), a: bodyLiteral(a), b: bodyLiteral(b) };
+        world.update(1 / 60);
+        return { first, second: { sep: anchorSeparation(joint), a: bodyLiteral(a), b: bodyLiteral(b) } };
+    }
+
+    const warm = run(true);
+
+    const initialOffsetSeparation = round(Math.sqrt(20));
+    assertCloserToTarget(warm.first.sep, initialOffsetSeparation, 2);
+    assertCloserToTarget(warm.second.sep, warm.first.sep, 2);
+    assert.ok(Math.abs(warm.first.a.vx) > 0);
+    assert.ok(Math.abs(warm.first.a.vy) > 0);
+    assert.ok(Math.abs(warm.first.b.vx) > 0);
+    assert.ok(Math.abs(warm.first.b.vy) > 0);
+    assert.ok(Math.abs(warm.first.a.av) > 0);
+    assert.ok(Math.abs(warm.first.b.av) > 0);
+    assert.ok(Math.abs(warm.first.a.rot) > 0);
+    assert.ok(Math.abs(warm.first.b.rot) > 0);
+
+    const cold = run(false);
+
+    assertCloserToTarget(cold.second.sep, cold.first.sep, 2);
+    assert.ok(
+        Math.abs(warm.second.sep - cold.second.sep) > 1e-6 ||
+        Math.abs(warm.second.a.av - cold.second.a.av) > 1e-6,
+    );
+});
+
+test("position correction toggle removes distance-error bias from the solve", async () => {
+
+
+
+
+    const api = await loadPhysics();
+    resetSettings(api.Settings);
+    api.Settings.positionCorrection = false;
+
+    const world = new api.World();
+    const a = makeCircle(api, 0, 0);
+    const b = makeCircle(api, 4, 0);
+    const joint = new api.DistanceJoint(
+        a,
+        b,
+        new api.Vector2(0, 1),
+        new api.Vector2(4, -1),
+        2,
+        15,
+        1,
+    );
+
+    world.register(a);
+    world.register(b);
+    world.register(joint);
+    world.update(1 / 60);
+
+
+    assertApprox(anchorSeparation(joint), Math.sqrt(20));
+    assertBodyStill(a, 0, 0);
+    assertBodyStill(b, 4, 0);
+
+    world.update(1 / 60);
+
+    assertApprox(anchorSeparation(joint), Math.sqrt(20));
+    assertBodyStill(a, 0, 0);
+    assertBodyStill(b, 4, 0);
+});
+
+test("registering the joint after both bodies attaches it to the world", async () => {
+
+
+
+
+    const api = await loadPhysics();
+    resetSettings(api.Settings);
+
+    const world = new api.World();
+    const a = makeCircle(api, 0, 0);
+    const b = makeCircle(api, 1, 0);
+    const joint = new api.DistanceJoint(a, b);
+
+
+    world.register(a);
+    world.register(b);
+    world.register(joint);
+    assert.equal(world.numBodies, 2);
+    assert.equal(world.numJoints, 1);
+    assert.ok(a.jointIDs.includes(joint.id));
+    assert.ok(b.jointIDs.includes(joint.id));
+});
+
+test("registered joint remains attached across repeated solves", async () => {
+
+
+
+
+    const api = await loadPhysics();
+    resetSettings(api.Settings);
+
+    const world = new api.World();
+    const a = makeCircle(api, 0, 0);
+    const b = makeCircle(api, 4, 0);
+    const joint = new api.DistanceJoint(a, b, a.position, b.position, 2, 15, 1);
+
+    world.register(a);
+    world.register(b);
+    world.register(joint);
+
+    assert.equal(world.numBodies, 2);
+    assert.equal(world.numJoints, 1);
+    assert.equal(a.jointIDs.length, 1);
+    assert.equal(b.jointIDs.length, 1);
+    const initial = anchorSeparation(joint);
+    world.update(1 / 60);
+    const first = anchorSeparation(joint);
+    world.update(1 / 60);
+    const second = anchorSeparation(joint);
+
+    assert.equal(world.numBodies, 2);
+    assert.equal(world.numJoints, 1);
+    assert.ok(a.jointIDs.includes(joint.id));
+    assert.ok(b.jointIDs.includes(joint.id));
+    assertCloserToTarget(first, initial, 2);
+    assertCloserToTarget(second, first, 2);
+});
+
+test("two worlds keep independent joint registration and simulation state", async () => {
+
+
+
+
+    const api = await loadPhysics();
+    resetSettings(api.Settings);
+
+    const worldA = new api.World();
+    const worldB = new api.World();
+    const a1 = makeCircle(api, 0, 0);
+    const b1 = makeCircle(api, 4, 0);
+    const a2 = makeCircle(api, 10, 0);
+    const b2 = makeCircle(api, 12, 0);
+    const jointA = new api.DistanceJoint(a1, b1, a1.position, b1.position, 2, 15, 1);
+    const jointB = new api.DistanceJoint(a2, b2, a2.position, b2.position, 1, 15, 1);
+
+    worldA.register(a1);
+    worldA.register(b1);
+    worldA.register(jointA);
+    worldB.register(a2);
+    worldB.register(b2);
+
+    assert.equal(worldA.numBodies, 2);
+    assert.equal(worldA.numJoints, 1);
+    assert.equal(worldB.numBodies, 2);
+    assert.equal(worldB.numJoints, 0);
+    assert.equal(a1.jointIDs.length, 1);
+    assert.equal(b1.jointIDs.length, 1);
+    assert.equal(a2.jointIDs.length, 0);
+    assert.equal(b2.jointIDs.length, 0);
+
+    worldB.register(jointB);
+    worldA.update(1 / 60);
+
+    assert.equal(worldA.numBodies, 2);
+    assert.equal(worldA.numJoints, 1);
+    assert.equal(worldB.numBodies, 2);
+    assert.equal(worldB.numJoints, 1);
+
+    assertCloserToTarget(anchorSeparation(jointA), 4, 2);
+    assert.equal(anchorSeparation(jointB), 2);
+    assert.ok(a1.position.x > 0);
+    assert.ok(b1.position.x < 4);
+    assertBodyStill(a2, 10, 0);
+    assertBodyStill(b2, 12, 0);
+});
+
+test("repeated construct, register, and solve cycles remain independent", async () => {
+
+
+
+
+    const api = await loadPhysics();
+    resetSettings(api.Settings);
+
+    for (let i = 0; i < 20; i++) {
+        const world = new api.World();
+        const a = makeCircle(api, 0, 0);
+        const b = makeCircle(api, 4, 0);
+        const joint = new api.DistanceJoint(a, b, a.position, b.position, 2, 15, 1);
+
+        world.register(a);
+        world.register(b);
+        world.register(joint);
+        world.update(1 / 60);
+
+        assert.equal(world.numBodies, 2);
+        assert.equal(world.numJoints, 1);
+        assert.equal(a.jointIDs.length, 1);
+        assert.equal(b.jointIDs.length, 1);
+
+        assertCloserToTarget(anchorSeparation(joint), 4, 2);
+    }
+});
