+  -Dsurefire.failIfNoSpecifiedTests=false \
+  -Dtest=ca.uhn.fhir.util.bundle.BundleUtilProcessingOrderContractTest,ca.uhn.fhir.util.bundle.BundleUtilTest \
+  test
