diff --git a/hapi-fhir-structures-r4/src/test/java/ca/uhn/fhir/util/bundle/BundleUtilProcessingOrderContractTest.java b/hapi-fhir-structures-r4/src/test/java/ca/uhn/fhir/util/bundle/BundleUtilProcessingOrderContractTest.java
new file mode 100644
index 00000000000..0b275f6fb39
--- /dev/null
+++ b/hapi-fhir-structures-r4/src/test/java/ca/uhn/fhir/util/bundle/BundleUtilProcessingOrderContractTest.java
@@ -0,0 +1,204 @@
+package ca.uhn.fhir.util.bundle;
+
+import ca.uhn.fhir.context.FhirContext;
+import ca.uhn.fhir.util.BundleUtil;
+import org.hl7.fhir.r4.model.Bundle;
+import org.hl7.fhir.r4.model.Bundle.BundleEntryComponent;
+import org.hl7.fhir.r4.model.Bundle.HTTPVerb;
+import org.hl7.fhir.r4.model.Observation;
+import org.hl7.fhir.r4.model.Organization;
+import org.hl7.fhir.r4.model.Patient;
+import org.hl7.fhir.r4.model.Practitioner;
+import org.hl7.fhir.r4.model.Reference;
+import org.hl7.fhir.r4.model.Resource;
+import org.junit.jupiter.api.Test;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+import java.util.stream.Collectors;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class BundleUtilProcessingOrderContractTest {
+
+	private static final FhirContext ourCtx = FhirContext.forR4Cached();
+
+	@Test
+	void sortsCreateDependencyChainUsingUrnFullUrls() {
+		Bundle bundle = new Bundle();
+		Observation observation = new Observation();
+		observation.setSubject(new Reference("urn:uuid:patient"));
+		Patient patient = new Patient();
+		patient.setManagingOrganization(new Reference("urn:uuid:organization"));
+		Organization organization = new Organization();
+
+		addEntry(bundle, "urn:uuid:observation", HTTPVerb.POST, observation);
+		addEntry(bundle, "urn:uuid:patient", HTTPVerb.POST, patient);
+		addEntry(bundle, "urn:uuid:organization", HTTPVerb.POST, organization);
+
+		BundleUtil.sortEntriesIntoProcessingOrder(ourCtx, bundle);
+
+		assertFullUrlOrder(bundle, "urn:uuid:organization", "urn:uuid:patient", "urn:uuid:observation");
+	}
+
+	@Test
+	void resolvesRelativeAndAbsoluteVersionedAliases() {
+		Bundle bundle = new Bundle();
+		Observation relativeReference = new Observation();
+		relativeReference.setId("Observation/relative");
+		relativeReference.setSubject(new Reference("Patient/p1/_history/99"));
+		Observation absoluteReference = new Observation();
+		absoluteReference.setId("Observation/absolute");
+		absoluteReference.setSubject(new Reference("https://example.test/fhir/Patient/p1/_history/12"));
+		Patient patient = new Patient();
+		patient.setId("Patient/p1/_history/4");
+
+		addEntry(bundle, "urn:uuid:relative-observation", HTTPVerb.PUT, relativeReference);
+		addEntry(bundle, "urn:uuid:absolute-observation", HTTPVerb.PUT, absoluteReference);
+		addEntry(bundle, "https://example.test/fhir/Patient/p1/_history/7", HTTPVerb.PUT, patient);
+
+		BundleUtil.sortEntriesIntoProcessingOrder(ourCtx, bundle);
+
+		assertFullUrlOrder(bundle,
+			"https://example.test/fhir/Patient/p1/_history/7",
+			"urn:uuid:relative-observation",
+			"urn:uuid:absolute-observation");
+	}
+
+	@Test
+	void appliesMethodPrecedenceAndStableOrderToResourceLessEntries() {
+		Bundle bundle = new Bundle();
+		BundleEntryComponent getOne = addEntry(bundle, "urn:test:get-1", HTTPVerb.GET, null);
+		BundleEntryComponent putOne = addEntry(bundle, "urn:test:put-1", HTTPVerb.PUT, patient("Patient/put-1"));
+		BundleEntryComponent deleteOne = addEntry(bundle, "urn:test:delete-1", HTTPVerb.DELETE, null);
+		BundleEntryComponent postOne = addEntry(bundle, "urn:test:post-1", HTTPVerb.POST, patient("Patient/post-1"));
+		BundleEntryComponent getTwo = addEntry(bundle, "urn:test:get-2", HTTPVerb.GET, null);
+		BundleEntryComponent deleteTwo = addEntry(bundle, "urn:test:delete-2", HTTPVerb.DELETE, null);
+		BundleEntryComponent postTwo = addEntry(bundle, "urn:test:post-2", HTTPVerb.POST, patient("Patient/post-2"));
+		BundleEntryComponent putTwo = addEntry(bundle, "urn:test:put-2", HTTPVerb.PUT, patient("Patient/put-2"));
+		List<BundleEntryComponent> expectedEntries = Arrays.asList(deleteOne, deleteTwo, postOne, postTwo, putOne, putTwo, getOne, getTwo);
+
+		BundleUtil.sortEntriesIntoProcessingOrder(ourCtx, bundle);
+		assertFullUrlOrder(bundle,
+			"urn:test:delete-1", "urn:test:delete-2",
+			"urn:test:post-1", "urn:test:post-2",
+			"urn:test:put-1", "urn:test:put-2",
+			"urn:test:get-1", "urn:test:get-2");
+		assertEntryIdentityOrder(bundle, expectedEntries);
+
+		BundleUtil.sortEntriesIntoProcessingOrder(ourCtx, bundle);
+		assertFullUrlOrder(bundle,
+			"urn:test:delete-1", "urn:test:delete-2",
+			"urn:test:post-1", "urn:test:post-2",
+			"urn:test:put-1", "urn:test:put-2",
+			"urn:test:get-1", "urn:test:get-2");
+		assertEntryIdentityOrder(bundle, expectedEntries);
+	}
+
+	@Test
+	void reversesDependenciesForDeletesIdentifiedByFullUrl() {
+		Bundle bundle = new Bundle();
+		Organization organization = new Organization();
+		Patient patient = new Patient();
+		patient.setManagingOrganization(new Reference("urn:uuid:delete-organization"));
+
+		addEntry(bundle, "urn:uuid:delete-organization", HTTPVerb.DELETE, organization);
+		addEntry(bundle, "urn:uuid:delete-patient", HTTPVerb.DELETE, patient);
+
+		BundleUtil.sortEntriesIntoProcessingOrder(ourCtx, bundle);
+
+		assertFullUrlOrder(bundle, "urn:uuid:delete-patient", "urn:uuid:delete-organization");
+	}
+
+	@Test
+	void detectsFullUrlCyclesWithoutPartiallyReorderingTheBundle() {
+		Bundle bundle = new Bundle();
+		Observation first = new Observation();
+		first.addHasMember(new Reference("urn:uuid:second"));
+		Observation second = new Observation();
+		second.addHasMember(new Reference("urn:uuid:first"));
+		addEntry(bundle, "urn:uuid:first", HTTPVerb.POST, first);
+		addEntry(bundle, "urn:uuid:second", HTTPVerb.POST, second);
+
+		IllegalStateException exception = assertThrows(IllegalStateException.class,
+			() -> BundleUtil.sortEntriesIntoProcessingOrder(ourCtx, bundle));
+
+		assertTrue(exception.getMessage().toLowerCase(Locale.ROOT).contains("cycle"));
+		assertFullUrlOrder(bundle, "urn:uuid:first", "urn:uuid:second");
+	}
+
+	@Test
+	void ignoresSelfReferences() {
+		Bundle bundle = new Bundle();
+		Organization organization = new Organization();
+		organization.setPartOf(new Reference("urn:uuid:self"));
+
+		addEntry(bundle, "urn:uuid:self", HTTPVerb.POST, organization);
+
+		BundleUtil.sortEntriesIntoProcessingOrder(ourCtx, bundle);
+
+		assertFullUrlOrder(bundle, "urn:uuid:self");
+	}
+
+	@Test
+	void ignoresContainedReferences() {
+		Bundle bundle = new Bundle();
+		Patient patient = new Patient();
+		patient.addGeneralPractitioner(new Reference("#contained-practitioner"));
+
+		addEntry(bundle, "urn:uuid:patient", HTTPVerb.POST, patient);
+		addEntry(bundle, "urn:uuid:contained-practitioner", HTTPVerb.POST, new Practitioner());
+
+		BundleUtil.sortEntriesIntoProcessingOrder(ourCtx, bundle);
+
+		assertFullUrlOrder(bundle, "urn:uuid:patient", "urn:uuid:contained-practitioner");
+	}
+
+	@Test
+	void ignoresExternalReferencesThatOnlyShareAResourcePath() {
+		Bundle bundle = new Bundle();
+		Patient patient = new Patient();
+		patient.setManagingOrganization(new Reference("https://outside.test/fhir/Organization/other"));
+
+		addEntry(bundle, "urn:uuid:patient", HTTPVerb.POST, patient);
+		addEntry(bundle, "https://inside.test/fhir/Organization/other", HTTPVerb.POST, new Organization());
+
+		BundleUtil.sortEntriesIntoProcessingOrder(ourCtx, bundle);
+
+		assertFullUrlOrder(bundle, "urn:uuid:patient", "https://inside.test/fhir/Organization/other");
+	}
+
+	private static Patient patient(String theId) {
+		Patient patient = new Patient();
+		patient.setId(theId);
+		return patient;
+	}
+
+	private static BundleEntryComponent addEntry(Bundle theBundle, String theFullUrl, HTTPVerb theMethod, Resource theResource) {
+		BundleEntryComponent entry = theBundle.addEntry();
+		entry.setFullUrl(theFullUrl);
+		entry.setResource(theResource);
+		entry.getRequest().setMethod(theMethod).setUrl(theResource != null ? theResource.fhirType() : theFullUrl);
+		return entry;
+	}
+
+	private static void assertFullUrlOrder(Bundle theBundle, String... theExpected) {
+		assertEquals(theExpected.length, theBundle.getEntry().size(), "sorting must preserve every bundle entry");
+		for (BundleEntryComponent entry : theBundle.getEntry()) {
+			assertNotNull(entry, "sorting must not replace an entry with null");
+		}
+		List<String> actual = theBundle.getEntry().stream().map(BundleEntryComponent::getFullUrl).collect(Collectors.toList());
+		assertEquals(Arrays.asList(theExpected), actual);
+	}
+
+	private static void assertEntryIdentityOrder(Bundle theBundle, List<BundleEntryComponent> theExpected) {
+		for (int i = 0; i < theExpected.size(); i++) {
+			assertSame(theExpected.get(i), theBundle.getEntry().get(i), "sorting must retain the original entry objects");
+		}
+	}
+}
