+package usercase_test_coderl
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+	"unsafe"
+
+	"github.com/rodrigocfd/windigo/wstr"
+)
+
+
+
+
+
+
+
+
+func TestEncodeArrToSliceTwoASCIIStrings(t *testing.T) {
+
+
+	actual := wstr.EncodeArrToSlice("ab", "cd")
+	expected := []uint16{97, 98, 0, 99, 100, 0, 0}
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("EncodeArrToSlice returned %#v, want %#v", actual, expected)
+	}
+}
+
+func TestEncodeArrToPtrTwoASCIIStrings(t *testing.T) {
+
+
+	ptr := wstr.EncodeArrToPtr("ab", "cd")
+	actual := unsafe.Slice(ptr, 7)
+	expected := []uint16{97, 98, 0, 99, 100, 0, 0}
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("EncodeArrToPtr block is %#v, want %#v", actual, expected)
+	}
+}
+
+func TestEncodeArrToBufExactFit(t *testing.T) {
+
+
+	dest := make([]uint16, 7)
+	written := wstr.EncodeArrToBuf(dest, "ab", "cd")
+	expected := []uint16{97, 98, 0, 99, 100, 0, 0}
+	if written != 7 {
+		t.Fatalf("EncodeArrToBuf wrote %d words, want 7", written)
+	}
+	if !reflect.DeepEqual(dest, expected) {
+		t.Fatalf("EncodeArrToBuf dest is %#v, want %#v", dest, expected)
+	}
+}
+
+func TestEncodeArrToBufTruncatesAndKeepsFinalDoubleNull(t *testing.T) {
+
+
+	dest := []uint16{0xffff, 0xffff, 0xffff, 0xffff}
+	written := wstr.EncodeArrToBuf(dest, "ab", "cd")
+	expected := []uint16{97, 98, 0, 0}
+	if written != 4 {
+		t.Fatalf("EncodeArrToBuf wrote %d words, want 4", written)
+	}
+	if !reflect.DeepEqual(dest, expected) {
+		t.Fatalf("EncodeArrToBuf dest is %#v, want %#v", dest, expected)
+	}
+}
+
+func TestEncodeArrToBufZeroLengthDestination(t *testing.T) {
+
+
+	var dest []uint16
+	written := wstr.EncodeArrToBuf(dest, "ab", "cd")
+	if written != 0 {
+		t.Fatalf("EncodeArrToBuf wrote %d words, want 0", written)
+	}
+	if !reflect.DeepEqual(dest, []uint16(nil)) {
+		t.Fatalf("zero-length dest was changed to %#v", dest)
+	}
+}
+
+func TestEncodeArrToBufOneWordDestination(t *testing.T) {
+
+
+	dest := []uint16{0xffff}
+	written := wstr.EncodeArrToBuf(dest, "ab", "cd")
+	expected := []uint16{0}
+	if written != 1 {
+		t.Fatalf("EncodeArrToBuf wrote %d words, want 1", written)
+	}
+	if !reflect.DeepEqual(dest, expected) {
+		t.Fatalf("EncodeArrToBuf dest is %#v, want %#v", dest, expected)
+	}
+}
+
+func TestEncodeArrToSliceNoStrings(t *testing.T) {
+
+
+	actual := wstr.EncodeArrToSlice()
+	expected := []uint16{0}
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("EncodeArrToSlice() returned %#v, want %#v", actual, expected)
+	}
+}
+
+func TestEncodeArrToSliceEmptyStringArgument(t *testing.T) {
+
+
+	actual := wstr.EncodeArrToSlice("")
+	expected := []uint16{0, 0}
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("EncodeArrToSlice(\"\") returned %#v, want %#v", actual, expected)
+	}
+}
+
+func TestEncodeArrToSliceSurrogatePairSizing(t *testing.T) {
+
+
+	actual := wstr.EncodeArrToSlice("a😀", "z")
+	expected := []uint16{97, 0xd83d, 0xde00, 0, 122, 0, 0}
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("EncodeArrToSlice with surrogate pair returned %#v, want %#v", actual, expected)
+	}
+}
+
+func TestEncodeArrToBufSurrogatePairDoesNotSplitWhenTruncated(t *testing.T) {
+
+
+	dest := []uint16{0xffff, 0xffff, 0xffff}
+	written := wstr.EncodeArrToBuf(dest, "😀")
+	expected := []uint16{0, 0, 0xffff}
+	if written != 2 {
+		t.Fatalf("EncodeArrToBuf wrote %d words, want 2", written)
+	}
+	if !reflect.DeepEqual(dest, expected) {
+		t.Fatalf("EncodeArrToBuf dest is %#v, want %#v", dest, expected)
+	}
+}
+
+func TestDecodeArrPtrTwoASCIIStrings(t *testing.T) {
+
+
+	block := []uint16{97, 98, 0, 99, 100, 0, 0}
+	actual := wstr.DecodeArrPtr(&block[0])
+	expected := []string{"ab", "cd"}
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("DecodeArrPtr returned %#v, want %#v", actual, expected)
+	}
+}
+
+func TestDecodeArrPtrNil(t *testing.T) {
+
+
+	actual := wstr.DecodeArrPtr(nil)
+
+	if len(actual) != 0 {
+		t.Fatalf("DecodeArrPtr(nil) returned %#v, want empty []string", actual)
+	}
+}
+
+func TestDecodeArrPtrStopsAtEmptyTerminator(t *testing.T) {
+
+
+	block := []uint16{65, 0, 0, 937, 0, 0}
+	actual := wstr.DecodeArrPtr(&block[0])
+	expected := []string{"A"}
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("DecodeArrPtr returned %#v, want %#v", actual, expected)
+	}
+}
+
+func TestDecodeArrPtrSurrogatePair(t *testing.T) {
+
+
+	block := []uint16{97, 0xd83d, 0xde00, 0, 122, 0, 0}
+	actual := wstr.DecodeArrPtr(&block[0])
+	expected := []string{"a😀", "z"}
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("DecodeArrPtr returned %#v, want %#v", actual, expected)
+	}
+}
+
+func TestReferentialTransparency(t *testing.T) {
+	x1 := wstr.EncodeArrToSlice("a😀", "z")
+	x2 := wstr.EncodeArrToSlice("a😀", "z")
+	if !reflect.DeepEqual(x1, x2) {
+		t.Fatalf("same input returned %#v then %#v", x1, x2)
+	}
+
+	block := []uint16{97, 0xd83d, 0xde00, 0, 122, 0, 0}
+	d1 := wstr.DecodeArrPtr(&block[0])
+	d2 := wstr.DecodeArrPtr(&block[0])
+	if !reflect.DeepEqual(d1, d2) {
+		t.Fatalf("same decode input returned %#v then %#v", d1, d2)
+	}
+}
+
+func TestNoMutationBeyondDestinationBuffer(t *testing.T) {
+	strs := []string{"ab", "cd"}
+	strsBefore := append([]string(nil), strs...)
+	dest := []uint16{0xffff, 0xffff, 0xffff, 0xffff, 0xbeef}
+	written := wstr.EncodeArrToBuf(dest[:4], strs...)
+
+	if written != 4 {
+		t.Fatalf("EncodeArrToBuf wrote %d words, want 4", written)
+	}
+	if !reflect.DeepEqual(strs, strsBefore) {
+		t.Fatalf("EncodeArrToBuf mutated variadic input slice to %#v, want %#v", strs, strsBefore)
+	}
+	if dest[4] != 0xbeef {
+		t.Fatalf("EncodeArrToBuf wrote past provided destination: guard is %#x, want 0xbeef", dest[4])
+	}
+
+	decodeBlock := []uint16{97, 98, 0, 99, 100, 0, 0}
+	decodeBefore := append([]uint16(nil), decodeBlock...)
+	_ = wstr.DecodeArrPtr(&decodeBlock[0])
+	if !reflect.DeepEqual(decodeBlock, decodeBefore) {
+		t.Fatalf("DecodeArrPtr mutated source block to %#v, want %#v", decodeBlock, decodeBefore)
+	}
+}
+
+func TestNoGlobalStateViaInProcessNoise(t *testing.T) {
+	baseline := wstr.EncodeArrToSlice("ab", "cd")
+	_ = wstr.EncodeArrToSlice()
+	_ = wstr.EncodeArrToSlice("a😀", "z")
+	afterNoise := wstr.EncodeArrToSlice("ab", "cd")
+	expected := []uint16{97, 98, 0, 99, 100, 0, 0}
+	if !reflect.DeepEqual(baseline, expected) {
+		t.Fatalf("baseline returned %#v, want %#v", baseline, expected)
+	}
+	if !reflect.DeepEqual(afterNoise, expected) {
+		t.Fatalf("after noise returned %#v, want %#v", afterNoise, expected)
+	}
+
+	block := []uint16{97, 98, 0, 99, 100, 0, 0}
+	decodedBaseline := wstr.DecodeArrPtr(&block[0])
+	noiseBlock := []uint16{97, 0xd83d, 0xde00, 0, 122, 0, 0}
+	_ = wstr.DecodeArrPtr(nil)
+	_ = wstr.DecodeArrPtr(&noiseBlock[0])
+	decodedAfterNoise := wstr.DecodeArrPtr(&block[0])
+	expectedDecoded := []string{"ab", "cd"}
+	if !reflect.DeepEqual(decodedBaseline, expectedDecoded) {
+		t.Fatalf("decode baseline returned %#v, want %#v", decodedBaseline, expectedDecoded)
+	}
+	if !reflect.DeepEqual(decodedAfterNoise, expectedDecoded) {
+		t.Fatalf("decode after noise returned %#v, want %#v", decodedAfterNoise, expectedDecoded)
+	}
+}
+
+func TestNoUndeclaredFilesystemSideEffects(t *testing.T) {
+	tempDir := t.TempDir()
+	oldWd, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd failed: %v", err)
+	}
+	if err := os.Chdir(tempDir); err != nil {
+		t.Fatalf("Chdir(%q) failed: %v", tempDir, err)
+	}
+	t.Cleanup(func() {
+		_ = os.Chdir(oldWd)
+	})
+
+	before := listRelativeFiles(t, tempDir)
+
+	_ = wstr.EncodeArrToSlice("ab", "cd")
+	dest := make([]uint16, 7)
+	_ = wstr.EncodeArrToBuf(dest, "ab", "cd")
+	ptr := wstr.EncodeArrToPtr("ab", "cd")
+	_ = unsafe.Slice(ptr, 7)
+	block := []uint16{97, 98, 0, 99, 100, 0, 0}
+	_ = wstr.DecodeArrPtr(&block[0])
+	_ = wstr.DecodeArrPtr(nil)
+
+	after := listRelativeFiles(t, tempDir)
+	if !reflect.DeepEqual(after, before) {
+		t.Fatalf("wstr multi-string calls changed cwd files from %#v to %#v", before, after)
+	}
+
+}
+
+func listRelativeFiles(t *testing.T, root string) []string {
+	t.Helper()
+	var files []string
+	err := filepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if path == root {
+			return nil
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		if d.IsDir() {
+			files = append(files, rel+"/")
+		} else {
+			files = append(files, rel)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("WalkDir(%q) failed: %v", root, err)
+	}
+	return files
+}
