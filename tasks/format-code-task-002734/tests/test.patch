+#!/usr/bin/env python3
+import json
+import os
+import sys
+from urllib.parse import urlparse
+
+
+REPO = "/workspace/repo"
+for rel in ["st2client", "st2common", "st2api"]:
+    path = os.path.join(REPO, rel)
+    if path not in sys.path:
+        sys.path.insert(0, path)
+
+os.environ["ST2_CLI_SKIP_CONFIG"] = "1"
+os.environ.setdefault("ST2_API_URL", "http://127.0.0.1:9101/v1")
+os.environ.setdefault("ST2_AUTH_URL", "http://127.0.0.1:9100")
+os.environ.setdefault("ST2_STREAM_URL", "http://127.0.0.1:9102")
+os.environ.setdefault("ST2_BASE_URL", "http://127.0.0.1")
+os.environ["ST2_AUTH_TOKEN"] = "acceptance-token"
+
+import requests
+
+
+CALLS_PATH = os.environ.get("ST2_ACCEPTANCE_CALLS")
+ORIGINAL_SESSION_REQUEST = requests.sessions.Session.request
+
+
+class FakeResponse(object):
+    status_code = 200
+    reason = "OK"
+    headers = {}
+
+    def __init__(self, text):
+        self.text = text
+        self.content = text
+
+    def json(self):
+        return json.loads(self.text)
+
+    def raise_for_status(self):
+        return None
+
+
+def fake_put(url, data=None, **kwargs):
+    if not is_loopback_url(url):
+        raise RuntimeError("isolated offline guard blocked remote PUT: %s" % url)
+
+    payload = json.loads(data or "{}")
+    call = {
+        "url": url,
+        "payload": payload,
+        "headers": kwargs.get("headers", {}),
+    }
+    if CALLS_PATH:
+        with open(CALLS_PATH, "a") as fp:
+            fp.write(json.dumps(call, sort_keys=True) + "\n")
+    return FakeResponse(json.dumps(payload, sort_keys=True))
+
+
+def is_loopback_url(url):
+    parsed = urlparse(url)
+    return parsed.hostname in ("localhost", "127.0.0.1", "0.0.0.0", "::1")
+
+
+def offline_guarded_request(session, method, url, **kwargs):
+
+    if not is_loopback_url(url):
+        raise RuntimeError("isolated offline guard blocked remote %s: %s" % (method, url))
+
+    if method.upper() == "PUT":
+        return fake_put(url, data=kwargs.get("data"), headers=kwargs.get("headers", {}))
+
+    return ORIGINAL_SESSION_REQUEST(session, method, url, **kwargs)
+
+
+requests.sessions.Session.request = offline_guarded_request
+requests.put = fake_put
+
+from st2client.shell import Shell
+
+sys.exit(Shell().run(sys.argv[1:]))
