+
+
+
+
+
+
+
+
+import dataclasses
+import importlib.util
+import os
+import sys
+import unittest
+
+def _find_repo_root(start):
+    cur = os.path.abspath(start)
+    while True:
+        if os.path.isdir(os.path.join(cur, "posthog", "temporal", "data_imports")):
+            return cur
+        parent = os.path.dirname(cur)
+        if parent == cur:
+            raise RuntimeError("Could not locate repository root")
+        cur = parent
+
+
+MODULE_PATH = os.path.join(
+    _find_repo_root(os.path.dirname(__file__)),
+    "posthog",
+    "temporal",
+    "data_imports",
+    "pipelines",
+    "source",
+    "config.py",
+)
+
+
+def _load_config_module():
+    parent = os.path.dirname(MODULE_PATH)
+    if parent not in sys.path:
+        sys.path.insert(0, parent)
+    spec = importlib.util.spec_from_file_location("source_config_under_test", MODULE_PATH)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+config_module = _load_config_module()
+config = config_module.config
+value = config_module.value
+str_to_bool = config_module.str_to_bool
+
+
+class TestDecoratorBasics(unittest.TestCase):
+    def test_bare_decorator_produces_dataclass(self):
+        @config
+        class A:
+            x: int
+            y: str
+
+        self.assertTrue(dataclasses.is_dataclass(A))
+        a = A(x=1, y="hi")
+        self.assertEqual(a.x, 1)
+        self.assertEqual(a.y, "hi")
+
+        self.assertEqual(a, A(x=1, y="hi"))
+        self.assertNotEqual(a, A(x=2, y="hi"))
+        self.assertIn("x=1", repr(a))
+
+    def test_decorator_with_call_no_args(self):
+        @config()
+        class A:
+            x: int = 5
+
+        self.assertTrue(dataclasses.is_dataclass(A))
+        self.assertEqual(A().x, 5)
+
+    def test_from_dict_is_classmethod_returning_instance(self):
+        @config
+        class A:
+            x: int
+            y: str
+
+        a = A.from_dict({"x": 1, "y": "hi"})
+        self.assertIsInstance(a, A)
+        self.assertEqual(a, A(x=1, y="hi"))
+
+
+class TestFlatScalarFields(unittest.TestCase):
+    def test_fields_read_by_name(self):
+        @config
+        class A:
+            host: str
+            port: int
+
+        a = A.from_dict({"host": "localhost", "port": 5432})
+        self.assertEqual(a.host, "localhost")
+        self.assertEqual(a.port, 5432)
+
+    def test_extra_keys_ignored(self):
+        @config
+        class A:
+            host: str
+
+        a = A.from_dict({"host": "localhost", "unrelated": "ignored", "foo": 1})
+        self.assertEqual(a.host, "localhost")
+
+    def test_absent_field_uses_default(self):
+        @config
+        class A:
+            host: str = "default-host"
+
+        self.assertEqual(A.from_dict({}).host, "default-host")
+        self.assertEqual(A.from_dict({"host": "other"}).host, "other")
+
+    def test_missing_required_field_raises_type_error(self):
+        @config
+        class A:
+            host: str
+
+        with self.assertRaises(TypeError):
+            A.from_dict({})
+
+
+class TestClassLevelPrefix(unittest.TestCase):
+    def test_prefix_applied_to_every_field(self):
+        @config(prefix="db")
+        class A:
+            host: str
+            port: int
+
+        a = A.from_dict({"db_host": "localhost", "db_port": 5432})
+        self.assertEqual(a.host, "localhost")
+        self.assertEqual(a.port, 5432)
+
+    def test_unprefixed_key_not_used(self):
+        @config(prefix="db")
+        class A:
+            host: str = "fallback"
+
+
+        self.assertEqual(A.from_dict({"host": "nope"}).host, "fallback")
+
+
+class TestValueHelper(unittest.TestCase):
+    def test_default(self):
+        @config
+        class A:
+            x: int = value(default=10)
+
+        self.assertEqual(A.from_dict({}).x, 10)
+        self.assertEqual(A.from_dict({"x": 3}).x, 3)
+
+    def test_default_factory(self):
+        @config
+        class A:
+            items: list = value(default_factory=list)
+
+        a = A.from_dict({})
+        self.assertEqual(a.items, [])
+        b = A.from_dict({})
+
+        a.items.append(1)
+        self.assertEqual(b.items, [])
+
+    def test_alias(self):
+        @config
+        class A:
+            host: str = value(alias="server")
+
+        self.assertEqual(A.from_dict({"server": "h"}).host, "h")
+
+    def test_field_prefix(self):
+        @config
+        class A:
+            host: str = value(prefix="db")
+
+        self.assertEqual(A.from_dict({"db_host": "h"}).host, "h")
+
+    def test_converter_applied_to_value(self):
+        @config
+        class A:
+            n: int = value(converter=lambda s: int(s) * 2)
+
+        self.assertEqual(A.from_dict({"n": "5"}).n, 10)
+
+    def test_converter_not_applied_to_default(self):
+        calls = []
+
+        def conv(x):
+            calls.append(x)
+            return x
+
+        @config
+        class A:
+            n: int = value(default=7, converter=conv)
+
+        self.assertEqual(A.from_dict({}).n, 7)
+        self.assertEqual(calls, [])
+
+
+class TestStrToBool(unittest.TestCase):
+    def test_bool_passthrough(self):
+        self.assertIs(str_to_bool(True), True)
+        self.assertIs(str_to_bool(False), False)
+
+    def test_truthy_strings(self):
+        for s in ["true", "True", "TRUE", "yes", "Yes", "1"]:
+            self.assertIs(str_to_bool(s), True, s)
+
+    def test_falsey_strings(self):
+        for s in ["false", "no", "0", "", "maybe", "2"]:
+            self.assertIs(str_to_bool(s), False, s)
+
+    def test_usable_as_converter(self):
+        @config
+        class A:
+            flag: bool = value(converter=str_to_bool)
+
+        self.assertIs(A.from_dict({"flag": "yes"}).flag, True)
+        self.assertIs(A.from_dict({"flag": "no"}).flag, False)
+
+
+class TestNestedDict(unittest.TestCase):
+    def test_nested_sub_dict_by_field_name(self):
+        @config
+        class Inner:
+            host: str
+            port: int
+
+        @config
+        class Outer:
+            inner: Inner
+
+        a = Outer.from_dict({"inner": {"host": "h", "port": 1}})
+        self.assertEqual(a.inner, Inner(host="h", port=1))
+
+    def test_nested_sub_dict_by_alias(self):
+        @config
+        class Inner:
+            host: str
+
+        @config
+        class Outer:
+            inner: Inner = value(alias="connection")
+
+        a = Outer.from_dict({"connection": {"host": "h"}})
+        self.assertEqual(a.inner.host, "h")
+
+
+class TestNestedFlatDerivedPrefix(unittest.TestCase):
+    def test_simple_derived_prefix(self):
+        @config
+        class DatabaseConnection:
+            host: str
+            port: int
+
+        @config
+        class Outer:
+            db: DatabaseConnection
+
+        a = Outer.from_dict({"database_connection_host": "h", "database_connection_port": 9})
+        self.assertEqual(a.db, DatabaseConnection(host="h", port=9))
+
+    def test_consecutive_capitals_prefix(self):
+        @config
+        class SSHTunnel:
+            host: str
+
+        @config
+        class Outer:
+            tunnel: SSHTunnel
+
+        a = Outer.from_dict({"ssh_tunnel_host": "h"})
+        self.assertEqual(a.tunnel.host, "h")
+
+    def test_trailing_config_word_dropped(self):
+        @config
+        class SSHTunnelConfig:
+            host: str
+
+        @config
+        class Outer:
+            tunnel: SSHTunnelConfig
+
+        a = Outer.from_dict({"ssh_tunnel_host": "h"})
+        self.assertEqual(a.tunnel.host, "h")
+
+
+class TestNestedFlatExplicitPrefix(unittest.TestCase):
+    def test_class_level_prefix_overrides_derived(self):
+        @config(prefix="tun")
+        class SSHTunnel:
+            host: str
+
+        @config
+        class Outer:
+            tunnel: SSHTunnel
+
+        a = Outer.from_dict({"tun_host": "h"})
+        self.assertEqual(a.tunnel.host, "h")
+
+    def test_field_level_prefix_overrides_class_prefix(self):
+        @config(prefix="tun")
+        class SSHTunnel:
+            host: str
+
+        @config
+        class Outer:
+            tunnel: SSHTunnel = value(prefix="override")
+
+        a = Outer.from_dict({"override_host": "h"})
+        self.assertEqual(a.tunnel.host, "h")
+
+
+class TestNestedAccumulatingPrefix(unittest.TestCase):
+    def test_double_nesting_accumulates_prefixes(self):
+        @config
+        class Credentials:
+            user: str
+
+        @config
+        class DatabaseConnection:
+            creds: Credentials
+
+        @config
+        class Outer:
+            db: DatabaseConnection
+
+        a = Outer.from_dict({"database_connection_credentials_user": "alice"})
+        self.assertEqual(a.db.creds.user, "alice")
+
+
+if __name__ == "__main__":
+    unittest.main()
