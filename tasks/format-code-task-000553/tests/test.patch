+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+
+
+set -euo pipefail
+cd /workspace/repo
+export GOPATH=/root/go
+export GOMODCACHE=/root/go/pkg/mod
+export GOPROXY=off
+export GOSUMDB=off
+export GOTOOLCHAIN=local
+GO_BIN=/root/go/pkg/mod/golang.org/toolchain@v0.0.1-go1.24.1.linux-amd64/bin/go
+exec "$GO_BIN" test -mod=readonly -v ./usercase-test-coderl -count=1
