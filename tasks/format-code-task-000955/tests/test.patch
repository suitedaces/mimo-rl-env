+import { execFileSync } from 'child_process';
+
+import { unserializeProfileOfArbitraryFormat } from 'firefox-profiler/profile-logic/process-profile';
+
+import type { Profile } from 'firefox-profiler/types';
+
+type ProfileSummary = {
+  product: string;
+  threadNames: string[];
+  sampleLength: number;
+  sampleTimes: number[];
+  sampleStacks: string[][];
+  sampleCategories: string[][];
+  stringArray: string[];
+  categoryNames: string[];
+};
+
+type ProfileExpectation = Pick<
+  ProfileSummary,
+  'product' | 'threadNames' | 'sampleLength' | 'sampleStacks' | 'sampleCategories'
+>;
+
+function getStackNames(profile: Profile, sampleIndex: number): string[] {
+  const thread = profile.threads[0];
+  const names: string[] = [];
+  let stackIndex = thread.samples.stack[sampleIndex];
+  while (stackIndex !== null) {
+    const frameIndex = profile.shared.stackTable.frame[stackIndex];
+    const funcIndex = profile.shared.frameTable.func[frameIndex];
+    const nameIndex = profile.shared.funcTable.name[funcIndex];
+    names.push(profile.shared.stringArray[nameIndex]);
+    stackIndex = profile.shared.stackTable.prefix[stackIndex];
+  }
+  return names.reverse();
+}
+
+function getStackCategories(profile: Profile, sampleIndex: number): string[] {
+  const thread = profile.threads[0];
+  const categories: string[] = [];
+  let stackIndex = thread.samples.stack[sampleIndex];
+  while (stackIndex !== null) {
+    const frameIndex = profile.shared.stackTable.frame[stackIndex];
+    const categoryIndex = profile.shared.frameTable.category[frameIndex];
+    categories.push(profile.meta.categories[categoryIndex].name);
+    stackIndex = profile.shared.stackTable.prefix[stackIndex];
+  }
+  return categories.reverse();
+}
+
+function summarizeProfile(profile: Profile): ProfileSummary {
+  const thread = profile.threads[0];
+  return {
+    product: profile.meta.product,
+    threadNames: profile.threads.map((thread) => thread.name),
+    sampleLength: thread.samples.length,
+    sampleTimes: thread.samples.time || [],
+    sampleStacks: Array.from({ length: thread.samples.length }, (_, i) =>
+      getStackNames(profile, i)
+    ),
+    sampleCategories: Array.from({ length: thread.samples.length }, (_, i) =>
+      getStackCategories(profile, i)
+    ),
+    stringArray: profile.shared.stringArray,
+    categoryNames: profile.meta.categories.map((category) => category.name),
+  };
+}
+
+function profileShape(summary: ProfileSummary): ProfileExpectation {
+
+
+  return {
+    product: summary.product,
+    threadNames: summary.threadNames,
+    sampleLength: summary.sampleLength,
+    sampleStacks: summary.sampleStacks,
+    sampleCategories: summary.sampleCategories,
+  };
+}
+
+function expectProfileShape(
+  summary: ProfileSummary,
+  expected: ProfileExpectation
+): void {
+  expect(profileShape(summary)).toEqual(expected);
+}
+
+function encodeInThisRealm(text: string): Uint8Array<ArrayBuffer> {
+  return new Uint8Array(new TextEncoder().encode(text));
+}
+
+const SIMPLE_FLAMEGRAPH_TEXT =
+  'func1;func2;func3 10\nfunc1;func2;func4 5\nfunc1;func5 3';
+
+const SIMPLE_FLAMEGRAPH_EXPECTATION: ProfileExpectation = {
+  product: 'Flamegraph',
+  threadNames: ['Program'],
+  sampleLength: 18,
+  sampleStacks: [
+    ['func1', 'func2', 'func3'],
+    ['func1', 'func2', 'func3'],
+    ['func1', 'func2', 'func3'],
+    ['func1', 'func2', 'func3'],
+    ['func1', 'func2', 'func3'],
+    ['func1', 'func2', 'func3'],
+    ['func1', 'func2', 'func3'],
+    ['func1', 'func2', 'func3'],
+    ['func1', 'func2', 'func3'],
+    ['func1', 'func2', 'func3'],
+    ['func1', 'func2', 'func4'],
+    ['func1', 'func2', 'func4'],
+    ['func1', 'func2', 'func4'],
+    ['func1', 'func2', 'func4'],
+    ['func1', 'func2', 'func4'],
+    ['func1', 'func5'],
+    ['func1', 'func5'],
+    ['func1', 'func5'],
+  ],
+  sampleCategories: [
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native', 'Native'],
+    ['Native', 'Native'],
+    ['Native', 'Native'],
+    ['Native', 'Native'],
+  ],
+};
+
+describe('unserializeProfileOfArbitraryFormat flamegraph imports', () => {
+  it('imports folded flamegraph text and expands counts into sequential samples', async () => {
+
+
+
+
+    const profile = await unserializeProfileOfArbitraryFormat(
+      SIMPLE_FLAMEGRAPH_TEXT
+    );
+
+
+    expectProfileShape(summarizeProfile(profile), SIMPLE_FLAMEGRAPH_EXPECTATION);
+  });
+
+  it('ignores empty lines while importing valid folded stacks', async () => {
+
+
+
+
+    const profile = await unserializeProfileOfArbitraryFormat(
+      'func1;func2 2\n\nfunc3 1\n'
+    );
+
+
+    expectProfileShape(summarizeProfile(profile), {
+      product: 'Flamegraph',
+      threadNames: ['Program'],
+      sampleLength: 3,
+      sampleStacks: [['func1', 'func2'], ['func1', 'func2'], ['func3']],
+      sampleCategories: [['Native', 'Native'], ['Native', 'Native'], ['Native']],
+    });
+  });
+
+  it('skips malformed non-empty lines after detection and keeps valid lines', async () => {
+
+
+
+
+    const profile = await unserializeProfileOfArbitraryFormat(
+      'root;leaf 2\nbad line without count\nalso bad\nsolo 1'
+    );
+
+
+
+    expectProfileShape(summarizeProfile(profile), {
+      product: 'Flamegraph',
+      threadNames: ['Program'],
+      sampleLength: 3,
+      sampleStacks: [['root', 'leaf'], ['root', 'leaf'], ['solo']],
+      sampleCategories: [['Native', 'Native'], ['Native', 'Native'], ['Native']],
+    });
+  });
+
+  it('strips Java frame suffixes and categorizes Java versus native frames', async () => {
+
+
+
+
+    const profile = await unserializeProfileOfArbitraryFormat(
+      'java.lang.Thread.run_[j];MyClass.method_[j] 5\nnative_func;cpp::function 3'
+    );
+
+
+    expectProfileShape(summarizeProfile(profile), {
+      product: 'Flamegraph',
+      threadNames: ['Program'],
+      sampleLength: 8,
+      sampleStacks: [
+        ['java.lang.Thread.run', 'MyClass.method'],
+        ['java.lang.Thread.run', 'MyClass.method'],
+        ['java.lang.Thread.run', 'MyClass.method'],
+        ['java.lang.Thread.run', 'MyClass.method'],
+        ['java.lang.Thread.run', 'MyClass.method'],
+        ['native_func', 'cpp::function'],
+        ['native_func', 'cpp::function'],
+        ['native_func', 'cpp::function'],
+      ],
+      sampleCategories: [
+        ['Java', 'Java'],
+        ['Java', 'Java'],
+        ['Java', 'Java'],
+        ['Java', 'Java'],
+        ['Java', 'Java'],
+        ['Native', 'Native'],
+        ['Native', 'Native'],
+        ['Native', 'Native'],
+      ],
+    });
+  });
+
+  it('recognizes folded flamegraph text supplied as an ArrayBuffer', async () => {
+
+
+
+
+    const bytes = encodeInThisRealm('byteRoot;byteLeaf 2\nbyteSolo 1');
+    const profile = await unserializeProfileOfArbitraryFormat(bytes.buffer);
+
+
+    expectProfileShape(summarizeProfile(profile), {
+      product: 'Flamegraph',
+      threadNames: ['Program'],
+      sampleLength: 3,
+      sampleStacks: [
+        ['byteRoot', 'byteLeaf'],
+        ['byteRoot', 'byteLeaf'],
+        ['byteSolo'],
+      ],
+      sampleCategories: [
+        ['Native', 'Native'],
+        ['Native', 'Native'],
+        ['Native'],
+      ],
+    });
+  });
+
+  it('recognizes folded flamegraph text supplied as a Uint8Array', async () => {
+
+
+
+
+    const profile = await unserializeProfileOfArbitraryFormat(
+      encodeInThisRealm('typedRoot;typedLeaf 2\ntypedSolo 1')
+    );
+
+
+    expectProfileShape(summarizeProfile(profile), {
+      product: 'Flamegraph',
+      threadNames: ['Program'],
+      sampleLength: 3,
+      sampleStacks: [
+        ['typedRoot', 'typedLeaf'],
+        ['typedRoot', 'typedLeaf'],
+        ['typedSolo'],
+      ],
+      sampleCategories: [
+        ['Native', 'Native'],
+        ['Native', 'Native'],
+        ['Native'],
+      ],
+    });
+  });
+
+  it('recognizes folded flamegraph text supplied as a Buffer', async () => {
+
+
+
+
+    const profile = await unserializeProfileOfArbitraryFormat(
+      Buffer.from('bufRoot;bufLeaf 2\nbufSolo 1', 'utf8')
+    );
+
+
+    expectProfileShape(summarizeProfile(profile), {
+      product: 'Flamegraph',
+      threadNames: ['Program'],
+      sampleLength: 3,
+      sampleStacks: [['bufRoot', 'bufLeaf'], ['bufRoot', 'bufLeaf'], ['bufSolo']],
+      sampleCategories: [['Native', 'Native'], ['Native', 'Native'], ['Native']],
+    });
+  });
+
+  it('does not misdetect JSON text beginning with an object as flamegraph text', async () => {
+
+
+
+
+    const jsonText = JSON.stringify({
+      meta: { version: 999999, product: 'TooNew' },
+      threads: [],
+      libs: [],
+      pages: [],
+      counters: [],
+    });
+    const errorSpy = jest.spyOn(console, 'error').mockImplementation(() => {});
+
+    await expect(
+      unserializeProfileOfArbitraryFormat(jsonText)
+    ).rejects.toMatchObject({
+      name: 'ProfileVersionError',
+      formatName: 'Gecko',
+      profileVersion: 999999,
+    });
+
+
+    expect(errorSpy).toHaveBeenCalledWith(
+      expect.anything(),
+      expect.objectContaining({
+        name: 'ProfileVersionError',
+        formatName: 'Gecko',
+        profileVersion: 999999,
+      })
+    );
+  });
+});
+
+describe('unserializeProfileOfArbitraryFormat lib-pure contract', () => {
+  it('returns equivalent processed profiles for repeated calls with the same folded text', async () => {
+    const first = await unserializeProfileOfArbitraryFormat(
+      SIMPLE_FLAMEGRAPH_TEXT
+    );
+    const second = await unserializeProfileOfArbitraryFormat(
+      SIMPLE_FLAMEGRAPH_TEXT
+    );
+
+
+    expectProfileShape(summarizeProfile(first), SIMPLE_FLAMEGRAPH_EXPECTATION);
+    expectProfileShape(summarizeProfile(second), SIMPLE_FLAMEGRAPH_EXPECTATION);
+    expect(profileShape(summarizeProfile(first))).toEqual(
+      profileShape(summarizeProfile(second))
+    );
+  });
+
+  it('does not mutate caller-supplied folded text input', async () => {
+    let text = 'mutRoot;mutLeaf 2\nmutSolo 1';
+    const before = text.slice();
+
+    const profile = await unserializeProfileOfArbitraryFormat(text);
+
+
+    expect(text).toEqual(before);
+
+    expectProfileShape(summarizeProfile(profile), {
+      product: 'Flamegraph',
+      threadNames: ['Program'],
+      sampleLength: 3,
+      sampleStacks: [['mutRoot', 'mutLeaf'], ['mutRoot', 'mutLeaf'], ['mutSolo']],
+      sampleCategories: [['Native', 'Native'], ['Native', 'Native'], ['Native']],
+    });
+  });
+
+  it('matches a fresh process for the same folded flamegraph input', async () => {
+    const inProcess = summarizeProfile(
+      await unserializeProfileOfArbitraryFormat(SIMPLE_FLAMEGRAPH_TEXT)
+    );
+    const script = `
+      const fs = require('fs');
+      const path = require('path');
+      const Module = require('module');
+      const babel = require('@babel/core');
+      const repo = ${JSON.stringify(process.cwd())};
+      const originalResolve = Module._resolveFilename;
+      Module._resolveFilename = function(request, parent, isMain, options) {
+        if (request === 'firefox-profiler' || request.startsWith('firefox-profiler/')) {
+          const relativePath = request === 'firefox-profiler'
+            ? 'index'
+            : request.slice('firefox-profiler/'.length);
+          const resolved = path.join(repo, 'src', relativePath);
+          for (const extension of ['.ts', '.tsx', '.js', '.jsx', '.json']) {
+            if (fs.existsSync(resolved + extension)) {
+              return resolved + extension;
+            }
+          }
+          for (const extension of ['.ts', '.tsx', '.js', '.jsx', '.json']) {
+            const indexPath = path.join(resolved, 'index' + extension);
+            if (fs.existsSync(indexPath)) {
+              return indexPath;
+            }
+          }
+          if (fs.existsSync(resolved)) {
+            return resolved;
+          }
+        }
+        return originalResolve.call(this, request, parent, isMain, options);
+      };
+      for (const extension of ['.ts', '.tsx']) {
+        require.extensions[extension] = function(module, filename) {
+          const result = babel.transformFileSync(filename, {
+            cwd: repo,
+            presets: [
+              ['@babel/preset-env', { targets: { node: 'current' } }],
+              ['@babel/preset-typescript', { isTSX: true, allExtensions: true }],
+            ],
+            plugins: ['@babel/plugin-transform-modules-commonjs'],
+            babelrc: false,
+            configFile: false,
+          });
+          module._compile(result.code, filename);
+        };
+      }
+      global.TextDecoder = require('util').TextDecoder;
+      global.TextEncoder = require('util').TextEncoder;
+      global.Buffer = Buffer;
+      const { unserializeProfileOfArbitraryFormat } = require('firefox-profiler/profile-logic/process-profile');
+      function getStackNames(profile, sampleIndex) {
+        const thread = profile.threads[0];
+        const names = [];
+        let stackIndex = thread.samples.stack[sampleIndex];
+        while (stackIndex !== null) {
+          const frameIndex = profile.shared.stackTable.frame[stackIndex];
+          const funcIndex = profile.shared.frameTable.func[frameIndex];
+          const nameIndex = profile.shared.funcTable.name[funcIndex];
+          names.push(profile.shared.stringArray[nameIndex]);
+          stackIndex = profile.shared.stackTable.prefix[stackIndex];
+        }
+        return names.reverse();
+      }
+      function getStackCategories(profile, sampleIndex) {
+        const thread = profile.threads[0];
+        const categories = [];
+        let stackIndex = thread.samples.stack[sampleIndex];
+        while (stackIndex !== null) {
+          const frameIndex = profile.shared.stackTable.frame[stackIndex];
+          const categoryIndex = profile.shared.frameTable.category[frameIndex];
+          categories.push(profile.meta.categories[categoryIndex].name);
+          stackIndex = profile.shared.stackTable.prefix[stackIndex];
+        }
+        return categories.reverse();
+      }
+      function summarizeProfile(profile) {
+        const thread = profile.threads[0];
+        return {
+          product: profile.meta.product,
+          threadNames: profile.threads.map((thread) => thread.name),
+          sampleLength: thread.samples.length,
+          sampleTimes: thread.samples.time || [],
+          sampleStacks: Array.from({ length: thread.samples.length }, (_, i) => getStackNames(profile, i)),
+          sampleCategories: Array.from({ length: thread.samples.length }, (_, i) => getStackCategories(profile, i)),
+          stringArray: profile.shared.stringArray,
+          categoryNames: profile.meta.categories.map((category) => category.name),
+        };
+      }
+      unserializeProfileOfArbitraryFormat(${JSON.stringify(
+        SIMPLE_FLAMEGRAPH_TEXT
+      )})
+        .then((profile) => process.stdout.write(JSON.stringify(summarizeProfile(profile))))
+        .catch((error) => { console.error(error); process.exit(1); });
+    `;
+    const freshProcess = JSON.parse(
+      execFileSync(process.execPath, ['-e', script], {
+        cwd: process.cwd(),
+        encoding: 'utf8',
+      })
+    );
+
+
+    expectProfileShape(inProcess, SIMPLE_FLAMEGRAPH_EXPECTATION);
+    expectProfileShape(freshProcess, SIMPLE_FLAMEGRAPH_EXPECTATION);
+    expect(profileShape(inProcess)).toEqual(profileShape(freshProcess));
+  });
+
+  it('does not rely on hidden global state between folded flamegraph imports', async () => {
+    const text = 'sideRoot;sideLeaf 2\nsideSolo 1';
+    const first = await unserializeProfileOfArbitraryFormat(text);
+    const second = await unserializeProfileOfArbitraryFormat(text);
+
+    const expected: ProfileExpectation = {
+      product: 'Flamegraph',
+      threadNames: ['Program'],
+      sampleLength: 3,
+      sampleStacks: [
+        ['sideRoot', 'sideLeaf'],
+        ['sideRoot', 'sideLeaf'],
+        ['sideSolo'],
+      ],
+      sampleCategories: [
+        ['Native', 'Native'],
+        ['Native', 'Native'],
+        ['Native'],
+      ],
+    };
+
+
+
+    expectProfileShape(summarizeProfile(first), expected);
+    expectProfileShape(summarizeProfile(second), expected);
+    expect(profileShape(summarizeProfile(first))).toEqual(
+      profileShape(summarizeProfile(second))
+    );
+  });
+});
