+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+if [ ! -x node_modules/.bin/jest ]; then
+  echo "Missing node_modules/.bin/jest; dependencies must be preinstalled in the image." >&2
+  exit 1
+fi
+
+exec env LC_ALL=C TZ=UTC NODE_ENV=test JEST_PROJECTS=browser \
+  node_modules/.bin/jest --runInBand \
+  --testMatch '**/usercase-test-coderl/flamegraph_arbitrary_format.test.ts'
