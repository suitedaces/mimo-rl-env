diff --git a/test/dialects/postgres_test.py b/test/dialects/postgres_test.py
index e4ac96bea..ecc9e1429 100644
--- a/test/dialects/postgres_test.py
+++ b/test/dialects/postgres_test.py
@@ -157,3 +157,105 @@ def test_get_keywords() -> None:
     expected_result_3 = ["B"]
 
     assert sorted(get_keywords(kw_list, "reserved")) == sorted(expected_result_3)
+
+
+def _fix_postgres(sql: str) -> str:
+    """Run sqlfluff fix on a postgres SQL string and return the fixed text."""
+    cfg = FluffConfig.from_string("[sqlfluff]\ndialect = postgres\n")
+    linter = Linter(config=cfg)
+    linted = linter.lint_string(sql, fix=True)
+    fixed, _ = linted.fix_string()
+    return fixed
+
+
+def test_postgres_on_conflict_do_update_indents_set_clause() -> None:
+    """Issue #6XXX: indentation after ON CONFLICT ... DO UPDATE was broken.
+
+    The exact reproduction from the issue: SET and the assignment must be
+    indented inside DO UPDATE.
+    """
+    in_sql = (
+        "insert into foo (\n"
+        "id,\n"
+        "bar\n"
+        ")\n"
+        "values (\n"
+        "$1,\n"
+        "$2\n"
+        ") on conflict (id) do update\n"
+        "set\n"
+        "bar = $2;\n"
+    )
+    expected = (
+        "insert into foo (\n"
+        "    id,\n"
+        "    bar\n"
+        ")\n"
+        "values (\n"
+        "    $1,\n"
+        "    $2\n"
+        ") on conflict (id) do update\n"
+        "    set\n"
+        "        bar = $2;\n"
+    )
+    assert _fix_postgres(in_sql) == expected
+
+
+def test_postgres_on_conflict_do_update_with_where_indents() -> None:
+    """ON CONFLICT ... DO UPDATE SET ... WHERE ... should indent SET/WHERE."""
+    in_sql = (
+        "INSERT INTO foo (bar, baz) VALUES (1, 2)\n"
+        "ON CONFLICT (bar) DO UPDATE\n"
+        "SET\n"
+        "baz = 3\n"
+        "WHERE\n"
+        "baz IS NULL;\n"
+    )
+    expected = (
+        "INSERT INTO foo (bar, baz) VALUES (1, 2)\n"
+        "ON CONFLICT (bar) DO UPDATE\n"
+        "    SET\n"
+        "        baz = 3\n"
+        "    WHERE\n"
+        "    baz IS NULL;\n"
+    )
+    assert _fix_postgres(in_sql) == expected
+
+
+def test_postgres_on_conflict_do_update_multiple_assignments() -> None:
+    """Multiple SET assignments inside DO UPDATE should all be indented."""
+    in_sql = (
+        "INSERT INTO foo (a, b, c) VALUES (1, 2, 3)\n"
+        "ON CONFLICT (a) DO UPDATE\n"
+        "SET\n"
+        "b = 2,\n"
+        "c = 3;\n"
+    )
+    expected = (
+        "INSERT INTO foo (a, b, c) VALUES (1, 2, 3)\n"
+        "ON CONFLICT (a) DO UPDATE\n"
+        "    SET\n"
+        "        b = 2,\n"
+        "        c = 3;\n"
+    )
+    assert _fix_postgres(in_sql) == expected
+
+
+def test_postgres_on_conflict_do_nothing_unchanged() -> None:
+    """ON CONFLICT ... DO NOTHING should not gain spurious indentation."""
+    in_sql = (
+        "INSERT INTO foo (bar) VALUES (1)\n"
+        "ON CONFLICT (bar) DO NOTHING;\n"
+    )
+    expected = (
+        "INSERT INTO foo (bar) VALUES (1)\n"
+        "ON CONFLICT (bar) DO NOTHING;\n"
+    )
+    assert _fix_postgres(in_sql) == expected
+
+
+def test_postgres_plain_update_set_indent_preserved() -> None:
+    """Plain UPDATE ... SET (without ON CONFLICT) should still indent assignment."""
+    in_sql = "update foo\nset\nbar = 1;\n"
+    expected = "update foo\nset\n    bar = 1;\n"
+    assert _fix_postgres(in_sql) == expected
