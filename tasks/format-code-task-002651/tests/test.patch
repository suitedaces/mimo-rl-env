diff --git a/test/range.js b/test/range.js
new file mode 100644
index 0000000..4478d3e
--- /dev/null
+++ b/test/range.js
@@ -0,0 +1,54 @@
+const { prettify } = require('./_utils');
+const test = require('ava').default;
+
+const codeWithUsedImport = 'import {foo} from "./foo";\n\nlet bar = foo;\n';
+const codeWithUnusedImport = 'import { unused } from "./foo";\n\nlet x = 1;\n';
+
+
+test('imports are preserved when rangeEnd is given (issue repro, rangeEnd=27)', async (t) => {
+	const formatted = await prettify(codeWithUsedImport, { filepath: 'bar.ts', rangeEnd: 27 });
+	t.true(formatted.includes('import'), `expected import to be preserved, got: ${JSON.stringify(formatted)}`);
+	t.true(formatted.includes('from "./foo"'), `expected import source preserved, got: ${JSON.stringify(formatted)}`);
+});
+
+
+test('imports are preserved with rangeEnd=1 (smallest range)', async (t) => {
+	const formatted = await prettify(codeWithUsedImport, { filepath: 'bar.ts', rangeEnd: 1 });
+	t.true(formatted.includes('import'), `expected import to be preserved, got: ${JSON.stringify(formatted)}`);
+});
+
+test('imports are preserved with rangeEnd=30 (upper boundary from issue)', async (t) => {
+	const formatted = await prettify(codeWithUsedImport, { filepath: 'bar.ts', rangeEnd: 30 });
+	t.true(formatted.includes('import'), `expected import to be preserved, got: ${JSON.stringify(formatted)}`);
+});
+
+
+test('imports are preserved with rangeStart > 0', async (t) => {
+	const formatted = await prettify(codeWithUsedImport, { filepath: 'bar.ts', rangeStart: 5 });
+	t.true(formatted.includes('import'), `expected import to be preserved, got: ${JSON.stringify(formatted)}`);
+	t.true(formatted.includes('from "./foo"'), `expected import source preserved, got: ${JSON.stringify(formatted)}`);
+});
+
+
+test('unused imports are not removed when rangeEnd is given', async (t) => {
+	const formatted = await prettify(codeWithUnusedImport, { filepath: 'bar.ts', rangeEnd: 27 });
+	t.true(formatted.includes('unused'), `expected "unused" import to be preserved, got: ${JSON.stringify(formatted)}`);
+});
+
+test('unused imports are not removed when rangeStart is given', async (t) => {
+	const formatted = await prettify(codeWithUnusedImport, { filepath: 'bar.ts', rangeStart: 5 });
+	t.true(formatted.includes('unused'), `expected "unused" import to be preserved, got: ${JSON.stringify(formatted)}`);
+});
+
+
+test('unused imports are still removed without range options', async (t) => {
+	const formatted = await prettify(codeWithUnusedImport, { filepath: 'bar.ts' });
+	t.false(formatted.includes('unused'), `expected unused import removed, got: ${JSON.stringify(formatted)}`);
+});
+
+
+test('imports are still sorted without range options', async (t) => {
+	const code = 'import { foo, bar } from "foobar";\n\nexport const fb = foo + bar;\n';
+	const formatted = await prettify(code, { filepath: 'file.ts' });
+	t.true(formatted.startsWith('import { bar, foo }'), `expected sorted imports, got: ${JSON.stringify(formatted)}`);
+});
