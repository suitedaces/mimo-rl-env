diff --git a/prebid_cache_client/prebid_cache_test.go b/prebid_cache_client/prebid_cache_test.go
index 6c134082..71256b26 100644
--- a/prebid_cache_client/prebid_cache_test.go
+++ b/prebid_cache_client/prebid_cache_test.go
@@ -136,3 +136,77 @@ func TestPrebidClient(t *testing.T) {
 		t.Fatalf("pbc put succeeded but should have timed out")
 	}
 }
+
+
+
+
+func TestPutEmptyDoesNotCallServer(t *testing.T) {
+	requestCount := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requestCount++
+		DummyPrebidCacheServer(w, r)
+	}))
+	defer server.Close()
+
+	InitPrebidCache(server.URL)
+
+	ctx := context.TODO()
+	err := Put(ctx, []*CacheObject{})
+	if err != nil {
+		t.Errorf("Put with empty objs returned error: %v", err)
+	}
+	if requestCount != 0 {
+		t.Errorf("Put with empty objs unexpectedly made %d HTTP request(s) to cache", requestCount)
+	}
+}
+
+
+
+func TestPutNilDoesNotCallServer(t *testing.T) {
+	requestCount := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requestCount++
+		DummyPrebidCacheServer(w, r)
+	}))
+	defer server.Close()
+
+	InitPrebidCache(server.URL)
+
+	ctx := context.TODO()
+	err := Put(ctx, nil)
+	if err != nil {
+		t.Errorf("Put with nil objs returned error: %v", err)
+	}
+	if requestCount != 0 {
+		t.Errorf("Put with nil objs unexpectedly made %d HTTP request(s) to cache", requestCount)
+	}
+}
+
+
+
+
+func TestPutNonEmptyStillCallsServer(t *testing.T) {
+	delay = 0
+	requestCount := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requestCount++
+		DummyPrebidCacheServer(w, r)
+	}))
+	defer server.Close()
+
+	InitPrebidCache(server.URL)
+
+	cobj := []*CacheObject{
+		{Value: &BidCache{Adm: "<b>x</b>", Width: 300, Height: 250}},
+	}
+	err := Put(context.TODO(), cobj)
+	if err != nil {
+		t.Fatalf("Put returned error: %v", err)
+	}
+	if requestCount != 1 {
+		t.Errorf("expected exactly 1 HTTP request to cache, got %d", requestCount)
+	}
+	if cobj[0].UUID != "UUID-1" {
+		t.Errorf("expected UUID-1, got %q", cobj[0].UUID)
+	}
+}
