+  describe('Custom changelog header', () => {
+    it('should pass custom changelogHeader to standard-version when provided (independent)', async () => {
+      const customHeader = '# My Custom Header\n\nWe own this changelog.\n';
+
+      const { success } = await runBuilder(
+        { ...options, changelogHeader: customHeader } as VersionBuilderSchema,
+        context
+      ).toPromise();
+
+      expect(success).toBe(true);
+      expect(standardVersion).toBeCalledWith(
+        expect.objectContaining({
+          header: customHeader,
+        })
+      );
+    });
+
+    it('should preserve default header when changelogHeader is not provided (independent)', async () => {
+      const { success } = await runBuilder(options, context).toPromise();
+
+      expect(success).toBe(true);
+      const callArgs = (standardVersion as jest.Mock).mock.calls[0][0];
+      expect(typeof callArgs.header).toBe('string');
+      expect(callArgs.header).toContain('Changelog');
+      expect(callArgs.header).toContain('@jscutlery/semver');
+    });
+
+    it('should pass custom changelogHeader to standard-version in sync versions mode', async () => {
+      const customHeader = '# Workspace Changelog\n\nMaintained by us.\n';
+      const syncContext = createFakeContext({
+        project: 'workspace',
+        projectRoot: '/root',
+        workspaceRoot: '/root',
+      });
+
+      const { success } = await runBuilder(
+        {
+          ...options,
+          syncVersions: true,
+          changelogHeader: customHeader,
+        } as VersionBuilderSchema,
+        syncContext
+      ).toPromise();
+
+      expect(success).toBe(true);
+      expect(standardVersion).toBeCalledWith(
+        expect.objectContaining({
+          header: customHeader,
+        })
+      );
+    });
+
+    it('should not treat changelogHeader as any other unrelated option', async () => {
+      const customHeader = 'UNIQUE-HEADER-MARKER-12345';
+
+      await runBuilder(
+        { ...options, changelogHeader: customHeader } as VersionBuilderSchema,
+        context
+      ).toPromise();
+
+      const callArgs = (standardVersion as jest.Mock).mock.calls[0][0];
+
+      expect(callArgs.header).toBe(customHeader);
+      expect(callArgs.infile).not.toBe(customHeader);
+      expect(callArgs.path).not.toBe(customHeader);
+    });
+  });
+
