diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+python -m pytest -v -rA gcovr/tests/test_args.py::test_print_summary_default_no_decisions_no_calls gcovr/tests/test_args.py::test_print_summary_with_decisions_prints_decisions gcovr/tests/test_args.py::test_print_summary_with_calls_prints_calls gcovr/tests/test_args.py::test_print_summary_with_decisions_and_calls gcovr/tests/test_args.py::test_print_summary_decisions_value gcovr/tests/test_args.py::test_print_summary_lines_order
+rc=$(( rc | $? ))
+exit $rc
