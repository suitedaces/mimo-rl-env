diff --git a/gcovr/tests/test_args.py b/gcovr/tests/test_args.py
index 976729918..95fa04eaa 100644
--- a/gcovr/tests/test_args.py
+++ b/gcovr/tests/test_args.py
@@ -516,3 +516,137 @@ def test_invalid_timestamp(capsys):
     assert c.out == ""
     assert "argument --timestamp: unknown timestamp format: 'foo'" in c.err
     assert c.exception.code != 0
+
+
+
+
+
+
+
+
+PRINT_SUMMARY_TRACEFILE = os.path.join(
+    os.path.dirname(__file__), "decisions", "reference", "gcc-8", "coverage.json"
+)
+
+
+def _summary_lines(out):
+    """Return the set of metric-name prefixes printed in the summary section."""
+    metrics = set()
+    for line in out.splitlines():
+        for name in ("lines:", "functions:", "branches:", "decisions:", "calls:"):
+            if line.startswith(name):
+                metrics.add(name.rstrip(":"))
+    return metrics
+
+
+def test_print_summary_default_no_decisions_no_calls(capsys):
+    c = capture(
+        capsys,
+        ["--add-tracefile", PRINT_SUMMARY_TRACEFILE, "--print-summary"],
+    )
+    assert c.exception.code == 0
+    metrics = _summary_lines(c.out)
+    assert "lines" in metrics
+    assert "functions" in metrics
+    assert "branches" in metrics
+
+    assert "calls" not in metrics
+
+    assert "decisions" not in metrics
+
+
+def test_print_summary_with_decisions_prints_decisions(capsys):
+    c = capture(
+        capsys,
+        [
+            "--add-tracefile",
+            PRINT_SUMMARY_TRACEFILE,
+            "--print-summary",
+            "--decisions",
+        ],
+    )
+    assert c.exception.code == 0
+    metrics = _summary_lines(c.out)
+
+    assert "decisions" in metrics
+
+    assert "calls" not in metrics
+
+
+def test_print_summary_with_calls_prints_calls(capsys):
+    c = capture(
+        capsys,
+        [
+            "--add-tracefile",
+            PRINT_SUMMARY_TRACEFILE,
+            "--print-summary",
+            "--calls",
+        ],
+    )
+    assert c.exception.code == 0
+    metrics = _summary_lines(c.out)
+    assert "calls" in metrics
+
+    assert "decisions" not in metrics
+
+
+def test_print_summary_with_decisions_and_calls(capsys):
+    c = capture(
+        capsys,
+        [
+            "--add-tracefile",
+            PRINT_SUMMARY_TRACEFILE,
+            "--print-summary",
+            "--decisions",
+            "--calls",
+        ],
+    )
+    assert c.exception.code == 0
+    metrics = _summary_lines(c.out)
+    assert "decisions" in metrics
+    assert "calls" in metrics
+
+
+def test_print_summary_decisions_value(capsys):
+    """When --decisions is given, the decisions line must report real counts
+    (not zeros) so it reflects actual decision coverage from the data."""
+    c = capture(
+        capsys,
+        [
+            "--add-tracefile",
+            PRINT_SUMMARY_TRACEFILE,
+            "--print-summary",
+            "--decisions",
+        ],
+    )
+    assert c.exception.code == 0
+    decisions_line = None
+    for line in c.out.splitlines():
+        if line.startswith("decisions:"):
+            decisions_line = line
+            break
+    assert decisions_line is not None, c.out
+
+    assert "33 out of 65" in decisions_line
+    assert "50.8%" in decisions_line
+
+
+def test_print_summary_lines_order(capsys):
+    """Verify summary order is lines, functions, branches, decisions, calls."""
+    c = capture(
+        capsys,
+        [
+            "--add-tracefile",
+            PRINT_SUMMARY_TRACEFILE,
+            "--print-summary",
+            "--decisions",
+            "--calls",
+        ],
+    )
+    assert c.exception.code == 0
+    order = []
+    for line in c.out.splitlines():
+        for name in ("lines", "functions", "branches", "decisions", "calls"):
+            if line.startswith(name + ":"):
+                order.append(name)
+    assert order == ["lines", "functions", "branches", "decisions", "calls"]
