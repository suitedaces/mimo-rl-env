+func TestController_CreateRepositoryDuplicateStatusCode(t *testing.T) {
+	clt, deps := setupClientWithAdmin(t)
+	ctx := context.Background()
+
+	t.Run("repeated create returns conflict each time", func(t *testing.T) {
+		repoName := testUniqueRepoName()
+		storageNS := onBlock(deps, "dup-status-bucket-1")
+
+
+		resp1, err := clt.CreateRepositoryWithResponse(ctx, &apigen.CreateRepositoryParams{}, apigen.CreateRepositoryJSONRequestBody{
+			DefaultBranch:    apiutil.Ptr("main"),
+			Name:             repoName,
+			StorageNamespace: storageNS,
+		})
+		if err != nil {
+			t.Fatal("first CreateRepository request failed:", err)
+		}
+		if resp1 == nil {
+			t.Fatal("first CreateRepository missing response")
+		}
+		if resp1.StatusCode() != http.StatusCreated {
+			t.Fatalf("first CreateRepository expected 201 Created, got %d", resp1.StatusCode())
+		}
+
+
+		resp2, err := clt.CreateRepositoryWithResponse(ctx, &apigen.CreateRepositoryParams{}, apigen.CreateRepositoryJSONRequestBody{
+			DefaultBranch:    apiutil.Ptr("main"),
+			Name:             repoName,
+			StorageNamespace: storageNS,
+		})
+		if err != nil {
+			t.Fatal("second CreateRepository request failed:", err)
+		}
+		if resp2 == nil {
+			t.Fatal("second CreateRepository missing response")
+		}
+		if resp2.StatusCode() != http.StatusConflict {
+			t.Fatalf("second CreateRepository expected 409 Conflict, got %d", resp2.StatusCode())
+		}
+
+
+
+		resp3, err := clt.CreateRepositoryWithResponse(ctx, &apigen.CreateRepositoryParams{}, apigen.CreateRepositoryJSONRequestBody{
+			DefaultBranch:    apiutil.Ptr("main"),
+			Name:             repoName,
+			StorageNamespace: storageNS,
+		})
+		if err != nil {
+			t.Fatal("third CreateRepository request failed:", err)
+		}
+		if resp3 == nil {
+			t.Fatal("third CreateRepository missing response")
+		}
+		if resp3.StatusCode() != http.StatusConflict {
+			t.Fatalf("third CreateRepository expected 409 Conflict, got %d", resp3.StatusCode())
+		}
+	})
+
+	t.Run("duplicate create with different storage namespace returns conflict", func(t *testing.T) {
+
+		repoName := testUniqueRepoName()
+		_, err := deps.catalog.CreateRepository(ctx, repoName, onBlock(deps, "dup-status-bucket-a"), "main")
+		if err != nil {
+			t.Fatal(err)
+		}
+		resp, err := clt.CreateRepositoryWithResponse(ctx, &apigen.CreateRepositoryParams{}, apigen.CreateRepositoryJSONRequestBody{
+			DefaultBranch:    apiutil.Ptr("main"),
+			Name:             repoName,
+			StorageNamespace: onBlock(deps, "dup-status-bucket-b"),
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if resp == nil {
+			t.Fatal("CreateRepository missing response")
+		}
+		if resp.StatusCode() != http.StatusConflict {
+			t.Fatalf("duplicate CreateRepository (different namespace) expected 409 Conflict, got %d", resp.StatusCode())
+		}
+	})
+
+	t.Run("repeated bare create returns conflict", func(t *testing.T) {
+		repoName := testUniqueRepoName()
+		bareRepo := true
+		storageNS := onBlock(deps, "dup-status-bare-bucket-1")
+
+		resp1, err := clt.CreateRepositoryWithResponse(ctx,
+			&apigen.CreateRepositoryParams{Bare: &bareRepo},
+			apigen.CreateRepositoryJSONRequestBody{
+				DefaultBranch:    apiutil.Ptr("main"),
+				Name:             repoName,
+				StorageNamespace: storageNS,
+			})
+		if err != nil {
+			t.Fatal("first bare CreateRepository request failed:", err)
+		}
+		if resp1.StatusCode() != http.StatusCreated {
+			t.Fatalf("first bare CreateRepository expected 201 Created, got %d", resp1.StatusCode())
+		}
+
+		resp2, err := clt.CreateRepositoryWithResponse(ctx,
+			&apigen.CreateRepositoryParams{Bare: &bareRepo},
+			apigen.CreateRepositoryJSONRequestBody{
+				DefaultBranch:    apiutil.Ptr("main"),
+				Name:             repoName,
+				StorageNamespace: storageNS,
+			})
+		if err != nil {
+			t.Fatal("second bare CreateRepository request failed:", err)
+		}
+		if resp2.StatusCode() != http.StatusConflict {
+			t.Fatalf("second bare CreateRepository expected 409 Conflict, got %d", resp2.StatusCode())
+		}
+	})
+
+	t.Run("create succeeds on different repo name after duplicate attempt", func(t *testing.T) {
+
+		existingRepoName := testUniqueRepoName()
+		storageNS1 := onBlock(deps, "dup-status-bucket-c")
+
+		resp, err := clt.CreateRepositoryWithResponse(ctx, &apigen.CreateRepositoryParams{}, apigen.CreateRepositoryJSONRequestBody{
+			DefaultBranch:    apiutil.Ptr("main"),
+			Name:             existingRepoName,
+			StorageNamespace: storageNS1,
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if resp.StatusCode() != http.StatusCreated {
+			t.Fatalf("expected 201, got %d", resp.StatusCode())
+		}
+
+
+		resp, err = clt.CreateRepositoryWithResponse(ctx, &apigen.CreateRepositoryParams{}, apigen.CreateRepositoryJSONRequestBody{
+			DefaultBranch:    apiutil.Ptr("main"),
+			Name:             existingRepoName,
+			StorageNamespace: storageNS1,
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if resp.StatusCode() != http.StatusConflict {
+			t.Fatalf("expected 409, got %d", resp.StatusCode())
+		}
+
+
+		newRepoName := testUniqueRepoName()
+		resp, err = clt.CreateRepositoryWithResponse(ctx, &apigen.CreateRepositoryParams{}, apigen.CreateRepositoryJSONRequestBody{
+			DefaultBranch:    apiutil.Ptr("main"),
+			Name:             newRepoName,
+			StorageNamespace: onBlock(deps, "dup-status-bucket-d"),
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if resp.StatusCode() != http.StatusCreated {
+			t.Fatalf("expected new repo create to succeed with 201, got %d", resp.StatusCode())
+		}
+	})
+}
