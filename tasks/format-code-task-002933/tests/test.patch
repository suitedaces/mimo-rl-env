diff --git a/usercase-test-coderl/test_nms_acceptance.py b/usercase-test-coderl/test_nms_acceptance.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_nms_acceptance.py
@@ -0,0 +1,203 @@
+
+
+
+
+
+
+import json
+import os
+import socket
+import subprocess
+import sys
+
+import numpy as np
+import pytest
+
+from bbox import BBox2DList
+from bbox.utils import nms
+
+
+def assert_int_array(actual, expected):
+
+    assert isinstance(actual, np.ndarray)
+    assert np.issubdtype(actual.dtype, np.integer)
+    np.testing.assert_array_equal(actual, np.array(expected, dtype=int))
+
+
+def test_keeps_highest_scoring_duplicate_and_independent_box():
+
+
+
+
+    bbl = BBox2DList([[0, 0, 10, 10], [0, 0, 10, 10], [20, 20, 5, 5]])
+    actual = nms(bbl, [0.2, 0.9, 0.5], 0.5)
+    assert_int_array(actual, [1, 2])
+
+
+def test_numpy_scores_preserve_below_threshold_boxes_in_score_order():
+
+
+
+
+    bbl = BBox2DList([[0, 0, 10, 10], [5, 5, 10, 10]])
+    actual = nms(bbl, np.array([0.6, 0.7]), 0.2)
+    assert_int_array(actual, [1, 0])
+
+
+def test_empty_box_list_returns_empty_integer_array():
+
+
+
+
+    actual = nms(BBox2DList([]), [], 0.5)
+    assert_int_array(actual, [])
+
+
+def test_single_box_returns_its_original_index():
+
+
+
+
+    actual = nms(BBox2DList([[3, 4, 8, 6]]), [0.3], 0.5)
+    assert_int_array(actual, [0])
+
+
+def test_boxes_below_threshold_are_kept():
+
+
+
+
+
+    actual = nms(BBox2DList([[0, 0, 10, 10], [8, 8, 10, 10]]), [0.9, 0.8], 0.1)
+    assert_int_array(actual, [0, 1])
+
+
+def test_threshold_below_iou_suppresses_lower_scoring_duplicate():
+
+
+
+
+    actual = nms(BBox2DList([[0, 0, 10, 10], [0, 0, 10, 10]]), [0.9, 0.8], 0.999)
+    assert_int_array(actual, [0])
+
+
+def test_non_overlapping_boxes_are_all_kept_in_descending_score_order():
+
+
+
+
+    bbl = BBox2DList([[0, 0, 10, 10], [40, 40, 6, 6], [20, 20, 5, 5]])
+    actual = nms(bbl, [0.4, 0.95, 0.7], 0.0)
+    assert_int_array(actual, [1, 2, 0])
+
+
+def test_mixed_cluster_suppression_keeps_best_cluster_representatives():
+
+
+
+
+    bbl = BBox2DList(
+        [[0, 0, 10, 10], [1, 1, 10, 10], [20, 20, 5, 5], [2, 2, 10, 10]]
+    )
+    actual = nms(bbl, [0.8, 0.7, 0.6, 0.9], 0.5)
+    assert_int_array(actual, [3, 0, 2])
+
+
+def test_equal_scores_keep_all_non_overlapping_boxes_without_tie_breaker_requirement():
+
+
+
+
+    bbl = BBox2DList([[0, 0, 10, 10], [20, 20, 5, 5], [40, 40, 6, 6]])
+    actual = nms(bbl, [0.5, 0.5, 0.5], 0.0)
+
+    assert isinstance(actual, np.ndarray)
+    assert np.issubdtype(actual.dtype, np.integer)
+    np.testing.assert_array_equal(np.sort(actual), np.array([0, 1, 2], dtype=int))
+
+
+def test_rejects_non_list_or_numpy_scores():
+
+    with pytest.raises(ValueError):
+        nms(BBox2DList([[0, 0, 10, 10]]), (0.5,), 0.5)
+
+
+def test_rejects_score_count_mismatch():
+
+    with pytest.raises(ValueError):
+        nms(BBox2DList([[0, 0, 10, 10], [20, 20, 5, 5]]), [0.5], 0.5)
+
+
+def test_referential_transparency_same_inputs_same_value():
+    bbl = BBox2DList([[0, 0, 10, 10], [1, 1, 10, 10], [20, 20, 5, 5]])
+    scores = [0.8, 0.9, 0.4]
+    first = nms(bbl, scores, 0.5)
+    second = nms(bbl, scores, 0.5)
+    assert_int_array(first, [1, 2])
+    assert_int_array(second, [1, 2])
+
+
+def test_does_not_mutate_box_list_or_score_objects():
+    list_score_bbl = BBox2DList([[0, 0, 10, 10], [1, 1, 10, 10], [20, 20, 5, 5]])
+    list_score_boxes_before = list_score_bbl.bboxes.copy()
+    list_scores = [0.8, 0.9, 0.4]
+    list_scores_before = list(list_scores)
+
+    array_score_bbl = BBox2DList([[0, 0, 10, 10], [5, 5, 10, 10]])
+    array_score_boxes_before = array_score_bbl.bboxes.copy()
+    array_scores = np.array([0.6, 0.7])
+    array_scores_before = array_scores.copy()
+
+    assert_int_array(nms(list_score_bbl, list_scores, 0.5), [1, 2])
+    assert_int_array(nms(array_score_bbl, array_scores, 0.2), [1, 0])
+
+    np.testing.assert_array_equal(list_score_bbl.bboxes, list_score_boxes_before, strict=True)
+    assert list_scores == list_scores_before
+    np.testing.assert_array_equal(array_score_bbl.bboxes, array_score_boxes_before, strict=True)
+    np.testing.assert_array_equal(array_scores, array_scores_before, strict=True)
+
+
+def test_no_global_state_across_fresh_python_process():
+    bbl = BBox2DList(
+        [[0, 0, 10, 10], [1, 1, 10, 10], [20, 20, 5, 5], [2, 2, 10, 10]]
+    )
+    in_process = nms(bbl, [0.8, 0.7, 0.6, 0.9], 0.5)
+    assert_int_array(in_process, [3, 0, 2])
+
+    script = """
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+from bbox import BBox2DList
+from bbox.utils import nms
+bbl = BBox2DList([[0, 0, 10, 10], [1, 1, 10, 10], [20, 20, 5, 5], [2, 2, 10, 10]])
+sys.stdout.write(json.dumps(nms(bbl, [0.8, 0.7, 0.6, 0.9], 0.5).tolist()))
+"""
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    fresh_process = json.loads(completed.stdout)
+    assert fresh_process == [3, 0, 2]
+    assert in_process.tolist() == [3, 0, 2]
+
+
+def test_no_filesystem_or_network_side_effects(tmp_path, monkeypatch):
+    def snapshot(root):
+        return sorted(str(path.relative_to(root)) for path in root.rglob("*"))
+
+    def blocked_socket(*args, **kwargs):
+        raise AssertionError("nms must not create network sockets")
+
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr(socket, "socket", blocked_socket)
+    before = snapshot(tmp_path)
+
+    actual = nms(BBox2DList([[0, 0, 10, 10], [20, 20, 5, 5]]), [0.9, 0.8], 0.5)
+
+    assert_int_array(actual, [0, 1])
+    assert snapshot(tmp_path) == before
+    assert os.getcwd() == str(tmp_path)
