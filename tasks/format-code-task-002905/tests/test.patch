index 0000000..8be5568
--- /dev/null
+++ b/modules/manifold/__tests__/package-dependencies.spec.js
@@ -0,0 +1,43 @@
+import fs from 'fs';
+import path from 'path';
+import pkg from '../package.json';
+
+const srcDir = path.resolve(__dirname, '../src');
+const collectJsFiles = dir => {
+  return fs.readdirSync(dir).reduce((files, entry) => {
+    const filePath = path.join(dir, entry);
+    const stat = fs.statSync(filePath);
+    if (stat.isDirectory()) {
+      return files.concat(collectJsFiles(filePath));
+    }
+    if (/\.(js|jsx)$/.test(entry)) {
+      return files.concat(filePath);
+    }
+    return files;
+  }, []);
+};
+
+const isTestFile = filePath => {
+  return (
+    filePath.includes(`${path.sep}__tests__${path.sep}`) ||
+    /\.(spec|test)\.jsx?$/.test(filePath)
+  );
+};
+
+test('does not declare antd as a manifold peer dependency', () => {
+  expect(pkg.peerDependencies || {}).not.toHaveProperty('antd');
+});
+
+test('does not depend on external segment-filters package', () => {
+  expect(pkg.dependencies || {}).not.toHaveProperty('@mlvis/segment-filters');
+  expect(pkg.peerDependencies || {}).not.toHaveProperty('@mlvis/segment-filters');
+});
+
+test('manifold source does not import the external segment-filters package', () => {
+  const offenders = collectJsFiles(srcDir).filter(filePath => {
+    if (isTestFile(filePath)) return false;
+    const source = fs.readFileSync(filePath, 'utf8');
+    return source.includes('@mlvis/segment-filters');
+  });
+  expect(offenders).toEqual([]);
+});
