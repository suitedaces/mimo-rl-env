+import React from 'react';
+import TestRenderer from 'react-test-renderer';
+import {FEATURE_TYPE} from '@mlvis/mlvis-common/constants';
+import FeatureListView from '..';
+
+const featureWithDateValues = () => ({
+  name: 'timestamp',
+  type: FEATURE_TYPE.NUMERICAL,
+  domain: [0, 1],
+  distributions: [[1], [1]],
+  distributionsNormalized: [[1], [1]],
+  divergence: 0,
+  values: [
+    [1, new Date(0), false],
+    ['comparison', 3.5, new Date(1)],
+  ],
+});
+
+test('accepts Date values in chart data without prop type warning', () => {
+  const spy = jest.spyOn(console, 'error').mockImplementation(() => {});
+  let rendered;
+  try {
+    rendered = TestRenderer.create(
+      <FeatureListView data={[featureWithDateValues()]} width={200} />
+    );
+    expect(spy).not.toHaveBeenCalled();
+  } finally {
+    if (rendered) {
+      rendered.unmount();
+    }
+    spy.mockRestore();
+  }
+});
diff --git a/modules/manifold/__tests__/package-dependencies.spec.js b/modules/manifold/__tests__/package-dependencies.spec.js
