--- /dev/null
+++ b/usercase-test-coderl/test_sublattice_decomposer.py
@@ -0,0 +1,234 @@
+
+
+
+
+
+
+
+
+import itertools
+
+import dimod
+import pytest
+
+from hybrid.core import State
+from hybrid.decomposers import SublatticeDecomposer
+
+
+def _query_bqm():
+    return dimod.BinaryQuadraticModel(
+        {(0,): 0, (1,): 1, (2,): 2},
+        {((0,), (1,)): 3, ((1,), (2,)): 4},
+        0,
+        dimod.BINARY,
+    )
+
+
+def _query_state(*, geometric_offset=(1,), origin_embedding_index=0):
+    bqm = _query_bqm()
+    return State.from_sample(
+        {(0,): 1, (1,): 0, (2,): 0},
+        bqm,
+        problem_dims=(3,),
+        geometric_offset=geometric_offset,
+        origin_embedding_index=origin_embedding_index,
+        origin_embeddings=[{(0,): [10], (1,): [11]}],
+    )
+
+
+def _random_bqm():
+    bqm = dimod.BinaryQuadraticModel({}, {}, 0, dimod.BINARY)
+    for i in range(3):
+        for j in range(4):
+            bqm.add_variable((i, j), i * 10 + j)
+    return bqm
+
+
+def _random_state(*, exclude_dims=None):
+    bqm = _random_bqm()
+    kwargs = {
+        "problem_dims": (3, 4),
+        "origin_embeddings": [
+            {(0, 0): ["a00"], (1, 0): ["a10"]},
+            {(0, 1): ["b01"], (1, 1): ["b11"]},
+            {(0, 2): ["c02"], (1, 2): ["c12"]},
+        ],
+    }
+    if exclude_dims is not None:
+        kwargs["exclude_dims"] = exclude_dims
+    return State.from_sample({v: 0 for v in bqm.variables}, bqm, **kwargs)
+
+
+def _linear_dict(bqm):
+    return {key: float(value) for key, value in sorted(bqm.linear.items())}
+
+
+def _quadratic_dict(bqm):
+    return {tuple(sorted(edge)): float(value) for edge, value in bqm.quadratic.items()}
+
+
+def _embedding_sequence(decomposer, state, count):
+    return [decomposer.next(state).embedding for _ in range(count)]
+
+
+def _canonical_embedding(embedding):
+    return tuple(sorted((key, tuple(value)) for key, value in embedding.items()))
+
+
+def _offset_embedding(origin_embedding, offset, problem_dims):
+    return {
+        tuple((coord + delta) % dim for coord, delta, dim in zip(key, offset, problem_dims)): value
+        for key, value in origin_embedding.items()
+    }
+
+
+def _valid_random_embeddings(state):
+    ranges = []
+    excluded = set(getattr(state, "exclude_dims", None) or ())
+    for dim_index, size in enumerate(state.problem_dims):
+        ranges.append([0] if dim_index in excluded else range(size))
+
+    return {
+        _canonical_embedding(_offset_embedding(origin_embedding, offset, state.problem_dims))
+        for origin_embedding in state.origin_embeddings
+        for offset in itertools.product(*ranges)
+    }
+
+
+def test_explicit_offset_conditions_boundary_biases():
+
+
+
+    result = SublatticeDecomposer(seed=None).next(_query_state(geometric_offset=(1,)))
+
+    assert result.embedding == {(1,): [10], (2,): [11]}
+    assert sorted(result.subproblem.variables) == [(1,), (2,)]
+    assert _quadratic_dict(result.subproblem) == {((1,), (2,)): 4.0}
+    assert result.subproblem.offset == 0.0
+    assert _linear_dict(result.subproblem) == {(1,): 4.0, (2,): 2.0}
+
+
+def test_explicit_offset_wraps_modulo_problem_dims():
+
+
+
+    result = SublatticeDecomposer(seed=None).next(_query_state(geometric_offset=(2,)))
+
+    assert result.embedding == {(2,): [10], (0,): [11]}
+    assert sorted(result.subproblem.variables) == [(0,), (2,)]
+    assert _quadratic_dict(result.subproblem) == {}
+    assert result.subproblem.offset == 0.0
+    assert _linear_dict(result.subproblem) == {(0,): 0.0, (2,): 2.0}
+
+
+def test_seeded_random_offsets_and_embedding_choices_advance_across_calls():
+
+
+
+    state = _random_state()
+    decomposer = SublatticeDecomposer(seed=123)
+    sequence = _embedding_sequence(decomposer, state, 40)
+
+
+    assert all(_canonical_embedding(embedding) in _valid_random_embeddings(state) for embedding in sequence)
+    assert len({_canonical_embedding(embedding) for embedding in sequence}) > 1
+
+
+def test_seeded_random_offset_sets_excluded_dimensions_to_zero():
+
+
+
+    state = _random_state(exclude_dims={1})
+    decomposer = SublatticeDecomposer(seed=123)
+    sequence = _embedding_sequence(decomposer, state, 40)
+
+
+    assert all(_canonical_embedding(embedding) in _valid_random_embeddings(state) for embedding in sequence)
+    assert len({_canonical_embedding(embedding) for embedding in sequence}) > 1
+
+
+def test_two_seeded_instances_have_independent_matching_random_sequences():
+
+
+
+    state = _random_state()
+    first = SublatticeDecomposer(seed=123)
+    second = SublatticeDecomposer(seed=123)
+    first_sequence = _embedding_sequence(first, state, 20)
+    second_sequence = _embedding_sequence(second, state, 20)
+
+
+    assert first_sequence == second_sequence
+    assert all(_canonical_embedding(embedding) in _valid_random_embeddings(state) for embedding in first_sequence)
+    assert len({_canonical_embedding(embedding) for embedding in first_sequence}) > 1
+
+
+def test_invalid_excluded_dimension_raises_value_error():
+
+
+
+
+    with pytest.raises(ValueError):
+        SublatticeDecomposer(seed=123).next(_random_state(exclude_dims={2}))
+
+
+def test_invalid_geometric_offset_length_raises_value_error():
+
+
+
+    state = _query_state(geometric_offset=(1,))
+    state.problem_dims = (3, 4)
+
+
+    with pytest.raises(ValueError):
+        SublatticeDecomposer(seed=123).next(state)
+
+
+@pytest.mark.parametrize("bad_offset", [(-1,), (3,)])
+def test_invalid_geometric_offset_range_raises_value_error(bad_offset):
+
+
+
+
+    with pytest.raises(ValueError):
+        SublatticeDecomposer(seed=123).next(_query_state(geometric_offset=bad_offset))
+
+
+@pytest.mark.parametrize("bad_index", [-2, 2])
+def test_invalid_origin_embedding_index_raises_value_error(bad_index):
+
+
+
+
+    with pytest.raises(ValueError):
+        SublatticeDecomposer(seed=123).next(_query_state(geometric_offset=(0,), origin_embedding_index=bad_index))
+
+
+def test_next_accepts_runopts_on_constructed_runnable():
+
+
+
+    decomposer = SublatticeDecomposer(seed=123)
+
+    result = decomposer.next(_query_state(geometric_offset=(1,)), ignored_runopt=True)
+
+
+    assert result.embedding == {(1,): [10], (2,): [11]}
+    assert sorted(result.subproblem.variables) == [(1,), (2,)]
+
+
+def test_construct_once_can_be_called_repeatedly():
+
+
+
+    decomposer = SublatticeDecomposer(seed=123)
+    expected_by_offset = {
+        (0,): {(0,): [10], (1,): [11]},
+        (1,): {(1,): [10], (2,): [11]},
+        (2,): {(2,): [10], (0,): [11]},
+    }
+
+    for offset, expected_embedding in expected_by_offset.items():
+        result = decomposer.next(_query_state(geometric_offset=offset))
+
+        assert result.embedding == expected_embedding
