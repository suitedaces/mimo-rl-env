diff --git a/receiver/k8sclusterreceiver/internal/container/metadata_fix_test.go b/receiver/k8sclusterreceiver/internal/container/metadata_fix_test.go
new file mode 100644
index 0000000000..58b5d48c15
--- /dev/null
+++ b/receiver/k8sclusterreceiver/internal/container/metadata_fix_test.go
@@ -0,0 +1,120 @@
+
+
+
+package container
+
+import (
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+	"go.opentelemetry.io/collector/receiver/receivertest"
+	"gopkg.in/yaml.v3"
+
+	imetadata "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/k8sclusterreceiver/internal/container/internal/metadata"
+)
+
+type metricSpec struct {
+	Unit string `yaml:"unit"`
+}
+
+type containerMetadataSpec struct {
+	Parent  string                `yaml:"parent"`
+	Metrics map[string]metricSpec `yaml:"metrics"`
+}
+
+func loadContainerMetadataYAML(t *testing.T) containerMetadataSpec {
+	data, err := os.ReadFile("metadata.yaml")
+	require.NoError(t, err)
+	var spec containerMetadataSpec
+	require.NoError(t, yaml.Unmarshal(data, &spec))
+	return spec
+}
+
+
+
+func TestContainerMetadataYAMLHasParent(t *testing.T) {
+	spec := loadContainerMetadataYAML(t)
+	assert.Equal(t, "k8s_cluster", spec.Parent,
+		"container metadata.yaml must declare 'parent: k8s_cluster'")
+}
+
+
+
+
+
+
+func TestContainerMetadataYAMLMetricUnits(t *testing.T) {
+	spec := loadContainerMetadataYAML(t)
+
+
+	expectedUnits := map[string][]string{
+		"k8s.container.cpu_request":              {"{cpu}", "{cores}"},
+		"k8s.container.cpu_limit":                {"{cpu}", "{cores}"},
+		"k8s.container.memory_request":           {"By"},
+		"k8s.container.memory_limit":             {"By"},
+		"k8s.container.storage_request":          {"By"},
+		"k8s.container.storage_limit":            {"By"},
+		"k8s.container.ephemeralstorage_request": {"By"},
+		"k8s.container.ephemeralstorage_limit":   {"By"},
+	}
+
+	for name, wantSet := range expectedUnits {
+		got, ok := spec.Metrics[name]
+		require.True(t, ok, "metric %s missing from metadata.yaml", name)
+		assert.Contains(t, wantSet, got.Unit,
+			"metric %s has wrong unit in metadata.yaml; got %q want one of %v",
+			name, got.Unit, wantSet)
+	}
+}
+
+
+
+
+
+
+func TestContainerMetricsBuilderRuntimeUnits(t *testing.T) {
+	settings := receivertest.NewNopCreateSettings()
+	mb := imetadata.NewMetricsBuilder(imetadata.DefaultMetricsBuilderConfig(), settings)
+	ts := pcommon.NewTimestampFromTime(pcommon.Timestamp(1_000_000_000).AsTime())
+
+	mb.RecordK8sContainerCPULimitDataPoint(ts, 1)
+	mb.RecordK8sContainerCPURequestDataPoint(ts, 1)
+	mb.RecordK8sContainerMemoryLimitDataPoint(ts, 1)
+	mb.RecordK8sContainerMemoryRequestDataPoint(ts, 1)
+	mb.RecordK8sContainerStorageLimitDataPoint(ts, 1)
+	mb.RecordK8sContainerStorageRequestDataPoint(ts, 1)
+	mb.RecordK8sContainerEphemeralstorageLimitDataPoint(ts, 1)
+	mb.RecordK8sContainerEphemeralstorageRequestDataPoint(ts, 1)
+
+	metrics := mb.Emit()
+	require.Equal(t, 1, metrics.ResourceMetrics().Len())
+	ms := metrics.ResourceMetrics().At(0).ScopeMetrics().At(0).Metrics()
+
+
+	expectedUnits := map[string][]string{
+		"k8s.container.cpu_limit":                {"{cpu}", "{cores}"},
+		"k8s.container.cpu_request":              {"{cpu}", "{cores}"},
+		"k8s.container.memory_limit":             {"By"},
+		"k8s.container.memory_request":           {"By"},
+		"k8s.container.storage_limit":            {"By"},
+		"k8s.container.storage_request":          {"By"},
+		"k8s.container.ephemeralstorage_limit":   {"By"},
+		"k8s.container.ephemeralstorage_request": {"By"},
+	}
+
+	gotUnits := map[string]string{}
+	for i := 0; i < ms.Len(); i++ {
+		gotUnits[ms.At(i).Name()] = ms.At(i).Unit()
+	}
+
+	for name, wantSet := range expectedUnits {
+		got, ok := gotUnits[name]
+		require.True(t, ok, "metric %s not emitted", name)
+		assert.Contains(t, wantSet, got,
+			"metric %s emitted with wrong Unit() %q want one of %v — metadata.yaml unit was not regenerated into code",
+			name, got, wantSet)
+	}
+}
