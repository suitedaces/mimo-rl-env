diff --git a/test/index.js b/test/index.js
index a1ebe82..0429458 100644
--- a/test/index.js
+++ b/test/index.js
@@ -995,3 +995,75 @@ test(
     'Lexical error on line 1: Unrecognized text.\n\n  Erroneous area:\n1: 10pc + unknown\n^.........^'
   )
 );
+
+test(
+  'calc-keyword infinity with seconds (issue reproduction)',
+  testValue('calc(infinity * 1s)', 'calc(infinity*1s)')
+);
+
+test(
+  'calc-keyword infinity with pixels',
+  testValue('calc(infinity * 1px)', 'calc(infinity*1px)')
+);
+
+test(
+  'calc-keyword pi with rem',
+  testValue('calc(pi * 1rem)', 'calc(pi*1rem)')
+);
+
+test(
+  'calc-keyword e with em',
+  testValue('calc(e * 1em)', 'calc(e*1em)')
+);
+
+test(
+  'calc-keyword infinity standalone',
+  testValue('calc(infinity)', 'calc(infinity)')
+);
+
+test(
+  'calc-keyword pi standalone',
+  testValue('calc(pi)', 'calc(pi)')
+);
+
+test(
+  'calc-keyword e standalone',
+  testValue('calc(e)', 'calc(e)')
+);
+
+test(
+  'calc-keyword in addition expression preserves keyword',
+  testValue('calc(1px + infinity * 1px)', 'calc(1px + infinity*1px)')
+);
+
+test(
+  'calc-keyword in larger expression preserves keyword',
+  testValue('calc(infinity * 1px + 5px)', 'calc(infinity*1px + 5px)')
+);
+
+test(
+  'calc-keyword does not warn (no NaN produced)',
+  testCssDoesNotThrow(
+    'foo{bar:calc(infinity * 1s)}',
+    'foo{bar:calc(infinity*1s)}'
+  )
+);
+
+test(
+  'regular calc still reduces (preservation)',
+  testValue('calc(1px + 2px)', '3px')
+);
+
+test(
+  'calc-keyword output does not contain NaN (negative assertion)',
+  async () => {
+    const result = await postcss(reduceCalc()).process(
+      'foo{bar:calc(infinity * 1s); baz:calc(pi * 1rem); qux:calc(e * 1em); quux:calc(infinity)}',
+      postcssOpts
+    );
+    assert.ok(
+      !result.css.includes('NaN'),
+      `Output should not contain NaN but got: ${result.css}`
+    );
+  }
+);
