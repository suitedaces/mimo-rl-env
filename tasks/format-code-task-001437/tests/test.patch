+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+npm install --no-audit --no-fund 2>/dev/null
+
+TAP=./node_modules/.bin/tap
+
+case "${1:-}" in
+  base)
+    "$TAP" ./test/stringify.js \
+      --grep="stringify retains explicit list when step would broaden day-of-week|fieldsToExpression retains explicit list for another non-equivalent stepped day-of-week field|stringify preserves safe stepped compression for day-of-week list" \
+      --invert
+    ;;
+  new)
+    "$TAP" ./test/stringify.js \
+      --grep="stringify retains explicit list when step would broaden day-of-week|fieldsToExpression retains explicit list for another non-equivalent stepped day-of-week field|stringify preserves safe stepped compression for day-of-week list"
+    ;;
+  *)
+    echo "usage: $0 base|new" >&2
+    exit 2
+    ;;
+esac
