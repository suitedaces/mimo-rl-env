+test('stringify retains explicit list when step would broaden day-of-week', function (t) {
+  try {
+    var expected = '0 * * * * 1,3,5';
+    var interval = CronParser.parseExpression('* * * * 1,3,5', {});
+    var str = interval.stringify(true);
+    t.equal(str, expected);
+
+    str = CronParser.fieldsToExpression(interval.fields).stringify(true);
+    t.equal(str, expected);
+
+    expected = '* * * * 1,3,5';
+    str = interval.stringify();
+    t.equal(str, expected);
+
+    str = CronParser.fieldsToExpression(interval.fields).stringify();
+    t.equal(str, expected);
+  } catch (err) {
+    t.error(err, 'Parse read error');
+  }
+
+  t.end();
+});
+
+test('fieldsToExpression retains explicit list for another non-equivalent stepped day-of-week field', function (t) {
+  try {
+    var expected = '0 * * * * 1,4';
+    var interval = CronParser.parseExpression('* * * * 1,4', {});
+    var str = CronParser.fieldsToExpression(interval.fields).stringify(true);
+    t.equal(str, expected);
+  } catch (err) {
+    t.error(err, 'Parse read error');
+  }
+
+  t.end();
+});
+
+test('stringify preserves safe stepped compression for day-of-week list', function (t) {
+  try {
+    var expected = '0 * * * * 0-6/2';
+    var interval = CronParser.parseExpression('* * * * 0,2,4,6', {});
+    var str = interval.stringify(true);
+    t.equal(str, expected);
+
+    str = CronParser.fieldsToExpression(interval.fields).stringify(true);
+    t.equal(str, expected);
+
+    expected = '0 5/5 * * * *';
+    interval = CronParser.parseExpression('5,10,15,20,25,30,35,40,45,50,55 * * * *', {});
+    str = interval.stringify(true);
+    t.equal(str, expected);
+
+    str = CronParser.fieldsToExpression(interval.fields).stringify(true);
+    t.equal(str, expected);
+  } catch (err) {
+    t.error(err, 'Parse read error');
+  }
+
+  t.end();
+});
