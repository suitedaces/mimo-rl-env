+            pretty=True,
+            pad=4,
+            indent=4,
+            leading_comma=False,
+        )
+
+    def test_leading_comma_default_pad_indent(self):
+
+
+        result = parse_one("select a, b, c from my_table").sql(
+            pretty=True, leading_comma=True
+        )
+        self.assertEqual(
+            result,
+            "SELECT\n    a\n  , b\n  , c\nFROM my_table",
