+    def test_leading_comma_pad_indent_consistency_pad2_indent4(self):
+
+        self.validate(
+            "select a, b, c from my_table",
+            "SELECT\n    a\n  , b\n  , c\nFROM my_table",
+            pretty=True,
+            pad=2,
+            indent=4,
+            leading_comma=True,
+        )
+
+    def test_leading_comma_preserves_non_leading_comma_pad4(self):
+
+        self.validate(
+            "select a, b, c from my_table",
