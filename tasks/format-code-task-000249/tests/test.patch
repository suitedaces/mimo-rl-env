+import React from 'react';
+import { expect } from 'chai';
+import { ComponentBuilder } from './ComponentBuilder';
+
+describe('ComponentBuilder (contract)', () => {
+  describe('getComponentFactory', () => {
+    it('should resolve Next.js default and SXA Default exports, and null for unknown', () => {
+      const Foo = { default: () => <div>Foo</div> };
+      const Bar = { default: () => <div>Bar</div> };
+      const Text = { Default: () => <div>Text</div> };
+      const components = new Map<string, unknown>();
+      components.set('Foo', Foo);
+      components.set('Bar', Bar);
+      components.set('Text', Text);
+
+      const builder = new ComponentBuilder({ components });
+      const componentFactory = builder.getComponentFactory({});
+
+      expect(componentFactory('Foo')).to.equal(Foo.default);
+      expect(componentFactory('Bar')).to.equal(Bar.default);
+      expect(componentFactory('Text')).to.equal(Text.Default);
+      expect(componentFactory('Unknown')).to.equal(null);
+    });
+
+    it('should prefer the SXA Default export over the Next.js default export', () => {
+      const Foo = { Default: () => <div>SXA</div>, default: () => <div>Next</div> };
+      const components = new Map<string, unknown>();
+      components.set('Foo', Foo);
+
+      const builder = new ComponentBuilder({ components });
+      const componentFactory = builder.getComponentFactory();
+
+      expect(componentFactory('Foo')).to.equal(Foo.Default);
+    });
+
+    it('should resolve a lazy component via its element function', () => {
+      const fooComponent = () => <div>Foo</div>;
+      const Foo = { element: () => fooComponent };
+      const Bar = { default: () => <div>Bar</div> };
+      const components = new Map<string, unknown>();
+      components.set('Foo', Foo);
+      components.set('Bar', Bar);
+
+      const builder = new ComponentBuilder({ components });
+      const componentFactory = builder.getComponentFactory({});
+
+      expect(componentFactory('Foo')).to.equal(fooComponent);
+      expect(componentFactory('Bar')).to.equal(Bar.default);
+    });
+
+    it('should pass the editing flag through to a lazy component element function', () => {
+      const editingComponent = () => <div>editing</div>;
+      const normalComponent = () => <div>normal</div>;
+      const Foo = {
+        element: (isEditing?: boolean) => (isEditing ? editingComponent : normalComponent),
+      };
+      const components = new Map<string, unknown>();
+      components.set('Foo', Foo);
+
+      const editingFactory = new ComponentBuilder({ components }).getComponentFactory({
+        isEditing: true,
+      });
+      const normalFactory = new ComponentBuilder({ components }).getComponentFactory({});
+      const defaultFactory = new ComponentBuilder({ components }).getComponentFactory();
+
+      expect(editingFactory('Foo')).to.equal(editingComponent);
+      expect(normalFactory('Foo')).to.equal(normalComponent);
+      expect(defaultFactory('Foo')).to.equal(normalComponent);
+    });
+
+    it('should resolve a custom named export when requested', () => {
+      const Foo = { default: () => <div>Foo</div>, text: () => <div>Text</div> };
+      const components = new Map<string, unknown>();
+      components.set('Foo', Foo);
+
+      const builder = new ComponentBuilder({ components });
+      const componentFactory = builder.getComponentFactory({});
+
+      expect(componentFactory('Foo')).to.equal(Foo.default);
+      expect(componentFactory('Foo', 'text')).to.equal(Foo.text);
+    });
+
+    it('should treat the "Default" export name as default resolution', () => {
+      const Foo = { default: () => <div>Foo</div> };
+      const components = new Map<string, unknown>();
+      components.set('Foo', Foo);
+
+      const builder = new ComponentBuilder({ components });
+      const componentFactory = builder.getComponentFactory({});
+
+
+
+      expect(componentFactory('Foo', 'Default')).to.equal(Foo.default);
+    });
+  });
+
+  describe('getModuleFactory', () => {
+    it('should resolve a static module and null for unknown', () => {
+      const Foo = { default: () => <div>Foo</div> };
+      const Bar = { default: () => <div>Bar</div>, getStaticProps: () => undefined };
+      const components = new Map<string, unknown>();
+      components.set('Foo', Foo);
+      components.set('Bar', Bar);
+
+      const builder = new ComponentBuilder({ components });
+      const moduleFactory = builder.getModuleFactory();
+
+      expect(moduleFactory('Foo')).to.equal(Foo);
+      expect(moduleFactory('Bar')).to.equal(Bar);
+      expect(moduleFactory('Unknown')).to.equal(null);
+    });
+
+    it('should resolve a lazy module via its module function', () => {
+      const fooModule = { default: () => <div>Foo</div> };
+      const Foo = { module: () => fooModule };
+      const Bar = { default: () => <div>Bar</div> };
+      const components = new Map<string, unknown>();
+      components.set('Foo', Foo);
+      components.set('Bar', Bar);
+
+      const builder = new ComponentBuilder({ components });
+      const moduleFactory = builder.getModuleFactory();
+
+      expect(moduleFactory('Foo')).to.equal(fooModule);
+      expect(moduleFactory('Bar')).to.equal(Bar);
+      expect(moduleFactory('Unknown')).to.equal(null);
+    });
+
+    it('should return a callable factory function from each method', () => {
+      const components = new Map<string, unknown>();
+      const builder = new ComponentBuilder({ components });
+
+      expect(builder.getModuleFactory()).to.be.a('function');
+      expect(builder.getComponentFactory()).to.be.a('function');
+      expect(builder.getComponentFactory({ isEditing: true })).to.be.a('function');
+    });
+  });
+});
