+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+( cd /workspace/repo && python - <<'PY'
+import django
+print(django.get_version())
+PY
+) >/dev/null || { echo "FAIL: build/import django" >&2; exit 1; }
+
+BIN=/workspace/repo/manage.py
+FIXTURES=/workspace/repo/usercase-test-coderl/fixtures
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+run_load_default_names() {
+    PYTHONPATH="$FIXTURES:/workspace/repo" \
+    DJANGO_SETTINGS_MODULE=acceptance_settings \
+    LEGEND_DB="$PWD/db.json" \
+    python "$BIN" load_default_names >out 2>err
+}
+
+
+
+
+
+
+
+
+case1="$TMP/case1"; mkdir -p "$case1/styles/fixtures" "$case1/styles/locale/cs"
+cat > "$case1/styles/fixtures/default_names.csv" <<'CSV'
+slug,group,order,name_en
+existing-full,trails,2,Updated English
+existing-blank,,9,
+new-full,points,5,New English
+new-partial,,7,
+CSV
+cat > "$case1/styles/locale/cs/names.csv" <<'CSV'
+slug,name_en,name_cs
+existing-full,Updated English,Prelozeno
+existing-blank,Keep English,
+new-full,New English,Novy
+unknown-slug,Ghost,Neznamy
+CSV
+cat > "$case1/db.json" <<'JSON'
+[{"slug":"existing-full","group":"old-group","order":1,"name_en":"Old English","name_cs":"Stary"},{"slug":"existing-blank","group":"keep-group","order":3,"name_en":"Keep English","name_cs":"Keep CS"}]
+JSON
+cd "$case1"
+run_load_default_names; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+
+[ -f db.json ] || fail "F1 db.json was not written"
+
+python - <<'PY' || fail "F1 db: $(cat db.json)"
+import json
+
+with open("db.json", "r") as handle:
+    rows = json.load(handle)
+
+by_slug = {}
+for row in rows:
+    slug = row.get("slug")
+    assert slug and slug not in by_slug, rows
+    by_slug[slug] = row
+
+assert set(by_slug) == {"existing-full", "existing-blank", "new-full", "new-partial"}, rows
+
+def order(row):
+    value = row.get("order")
+    return None if value is None else str(value)
+
+assert by_slug["existing-full"].get("group") == "trails"
+assert order(by_slug["existing-full"]) == "2"
+assert by_slug["existing-full"].get("name_en") == "Updated English"
+assert by_slug["existing-full"].get("name_cs") == "Prelozeno"
+
+assert by_slug["existing-blank"].get("group") == "keep-group"
+assert order(by_slug["existing-blank"]) == "9"
+assert by_slug["existing-blank"].get("name_en") == "Keep English"
+assert by_slug["existing-blank"].get("name_cs") == "Keep CS"
+
+assert by_slug["new-full"].get("group") == "points"
+assert order(by_slug["new-full"]) == "5"
+assert by_slug["new-full"].get("name_en") == "New English"
+assert by_slug["new-full"].get("name_cs") == "Novy"
+
+assert order(by_slug["new-partial"]) == "7"
+assert by_slug["new-partial"].get("group") in (None, "")
+assert by_slug["new-partial"].get("name_en") in (None, "")
+assert by_slug["new-partial"].get("name_cs") in (None, "")
+PY
+
+grep -q 'unknown-slug' err || fail "F1 missing unknown-slug warning: $(cat err)"
+! grep -q '"unknown-slug"' db.json || fail "F1 unknown translation slug created a row"
+
+
+
+
+case2="$TMP/case2"; mkdir -p "$case2/styles/locale/cs"
+cat > "$case2/styles/locale/cs/names.csv" <<'CSV'
+slug,name_en,name_cs
+x,X,Y
+CSV
+printf '[]' > "$case2/db.json"
+cd "$case2"
+run_load_default_names; ec=$?
+[ "$ec" -ne 0 ] || fail "F2 expected non-zero exit"
+
+[ -s err ] || fail "F2 expected diagnostic stderr"
+
+grep -q "styles/fixtures/default_names.csv" err || fail "F2 stderr: $(cat err)"
+
+
+
+
+case3="$TMP/case3"; mkdir -p "$case3/styles/fixtures" "$case3/styles/locale"
+cat > "$case3/styles/fixtures/default_names.csv" <<'CSV'
+slug,group,order,name_en
+x,g,1,X
+CSV
+printf '[]' > "$case3/db.json"
+cd "$case3"
+run_load_default_names; ec=$?
+[ "$ec" -ne 0 ] || fail "F3 expected non-zero exit"
+
+[ -s err ] || fail "F3 expected diagnostic stderr"
+
+grep -q "styles/locale/cs/names.csv" err || fail "F3 stderr: $(cat err)"
+
+
+
+
+case4="$TMP/case4"; mkdir -p "$case4/styles/fixtures" "$case4/styles/locale/cs"
+cat > "$case4/styles/fixtures/default_names.csv" <<'CSV'
+group,order,name_en
+g,1,X
+CSV
+cat > "$case4/styles/locale/cs/names.csv" <<'CSV'
+slug,name_en,name_cs
+x,X,Y
+CSV
+printf '[]' > "$case4/db.json"
+cd "$case4"
+run_load_default_names; ec=$?
+[ "$ec" -ne 0 ] || fail "F4 expected non-zero exit"
+
+[ -s err ] || fail "F4 expected diagnostic stderr"
+
+grep -q "slug" err || fail "F4 stderr: $(cat err)"
+
+
+
+
+case5="$TMP/case5"; mkdir -p "$case5/styles/fixtures" "$case5/styles/locale/cs"
+cat > "$case5/styles/fixtures/default_names.csv" <<'CSV'
+slug,group,order,name_en
+x,g,1,X
+CSV
+cat > "$case5/styles/locale/cs/names.csv" <<'CSV'
+slug,name_en
+x,X
+CSV
+printf '[]' > "$case5/db.json"
+cd "$case5"
+run_load_default_names; ec=$?
+[ "$ec" -ne 0 ] || fail "F5 expected non-zero exit"
+
+[ -s err ] || fail "F5 expected diagnostic stderr"
+
+grep -q "name_cs" err || fail "F5 stderr: $(cat err)"
+
+echo "PASS"
+exit 0
