+import csv
+import importlib.machinery
+import json
+import os
+import sys
+import types
+
+
+class CompatDict(dict):
+    def iteritems(self):
+        return self.items()
+
+
+_RealDictReader = csv.DictReader
+
+
+class CompatDictReader(_RealDictReader):
+    def __next__(self):
+        row = super(CompatDictReader, self).__next__()
+        return CompatDict(row)
+
+    next = __next__
+
+
+csv.DictReader = CompatDictReader
+
+
+class QuerySet(object):
+    def __init__(self, model, rows):
+        self.model = model
+        self.rows = rows
+
+    def count(self):
+        return len(self.rows)
+
+
+    def exists(self):
+        return bool(self.rows)
+
+
+    def first(self):
+        if not self.rows:
+            return None
+        return self.model._from_row(self.rows[0])
+
+
+    def __iter__(self):
+        for row in self.rows:
+            yield self.model._from_row(row)
+
+    def __getitem__(self, index):
+        return self.model._from_row(self.rows[index])
+
+    def update(self, **changed):
+        for row in self.rows:
+            row.update(changed)
+        self.model._save_db()
+
+
+class Manager(object):
+    def __init__(self, model):
+        self.model = model
+
+    def filter(self, **kwargs):
+        self.model._load_db()
+        rows = [
+            row
+            for row in self.model._rows
+            if all(str(row.get(key)) == str(value) for key, value in kwargs.items())
+        ]
+        return QuerySet(self.model, rows)
+
+    def get(self, **kwargs):
+        qs = self.filter(**kwargs)
+        if qs.count() != 1:
+            raise self.model.DoesNotExist()
+        return qs[0]
+
+
+    def create(self, **kwargs):
+        instance = self.model(**kwargs)
+        instance.save()
+        return instance
+
+
+    def get_or_create(self, defaults=None, **kwargs):
+        try:
+            return self.get(**kwargs), False
+        except self.model.DoesNotExist:
+            data = dict(kwargs)
+            if defaults:
+                data.update(defaults)
+            return self.create(**data), True
+
+
+    def update_or_create(self, defaults=None, **kwargs):
+        defaults = defaults or {}
+        try:
+            instance = self.get(**kwargs)
+            for key, value in defaults.items():
+                setattr(instance, key, value)
+            instance.save()
+            return instance, False
+        except self.model.DoesNotExist:
+            data = dict(kwargs)
+            data.update(defaults)
+            return self.create(**data), True
+
+
+class LegendItemName(object):
+    class DoesNotExist(Exception):
+        pass
+
+    _rows = []
+    objects = None
+
+    def __init__(self, **data):
+        self._persisted_slug = data.get("slug")
+        for key, value in data.items():
+            setattr(self, key, value)
+
+    def __getattr__(self, name):
+        if name.startswith("name_"):
+            return None
+        raise AttributeError(name)
+
+    @classmethod
+    def _db_path(cls):
+        path = os.environ.get("LEGEND_DB")
+        if not path:
+            raise RuntimeError("LEGEND_DB is required")
+        return path
+
+    @classmethod
+    def _load_db(cls):
+        path = cls._db_path()
+        if os.path.exists(path):
+            with open(path, "r") as handle:
+                cls._rows = json.load(handle)
+        else:
+            cls._rows = []
+
+    @classmethod
+    def _save_db(cls):
+        path = cls._db_path()
+        directory = os.path.dirname(path)
+        if directory and not os.path.exists(directory):
+            os.makedirs(directory)
+        with open(path, "w") as handle:
+            json.dump(cls._rows, handle, sort_keys=True, separators=(",", ":"))
+
+    @classmethod
+    def _from_row(cls, row):
+        instance = cls(**row)
+        instance._persisted_slug = row.get("slug")
+        return instance
+
+
+    def save(self, *args, **kwargs):
+        self.__class__._load_db()
+        row = dict(self.__dict__)
+        row.pop("_persisted_slug", None)
+        slug = self._persisted_slug or row.get("slug")
+        replaced = False
+        for index, existing in enumerate(self.__class__._rows):
+            if existing.get("slug") == slug:
+                self.__class__._rows[index] = row
+                replaced = True
+                break
+        if not replaced:
+            self.__class__._rows.append(row)
+        self._persisted_slug = row.get("slug")
+        self.__class__._save_db()
+
+
+LegendItemName.objects = Manager(LegendItemName)
+
+models = types.ModuleType("styles.models")
+models.LegendItemName = LegendItemName
+models.__file__ = "acceptance fake styles.models"
+models.__spec__ = importlib.machinery.ModuleSpec("styles.models", loader=None)
+sys.modules["styles.models"] = models
