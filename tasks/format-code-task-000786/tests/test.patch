@@ -0,0 +1,126 @@
+
+
+
+
+
+
+
+import random
+from pathlib import Path
+
+from farm.data_handler.utils import randomize_and_split_file
+
+
+def _write_corpus(path, num_docs, lines_per_doc, delimiter=""):
+
+
+    lines = []
+    for d in range(num_docs):
+        for s in range(lines_per_doc):
+            lines.append(f"doc{d}_sentence{s}\n")
+        lines.append(delimiter + "\n")
+    with open(path, "w", encoding="utf-8") as f:
+        f.writelines(lines)
+    return lines
+
+
+def _read_all_output_lines(output_dir):
+    lines = []
+    for p in sorted(Path(output_dir).iterdir()):
+        with open(p, encoding="utf-8") as f:
+            lines.extend(f.readlines())
+    return lines
+
+
+def _num_output_files(output_dir):
+    return sum(1 for _ in Path(output_dir).iterdir())
+
+
+def test_creates_output_directory(tmp_path):
+    corpus = tmp_path / "train.txt"
+    _write_corpus(corpus, num_docs=4, lines_per_doc=3)
+    output_dir = tmp_path / "missing" / "split_files"
+    assert not output_dir.exists()
+
+    randomize_and_split_file(corpus, output_dir, docs_per_file=2)
+
+    assert output_dir.is_dir()
+    assert _num_output_files(output_dir) >= 1
+
+
+def test_file_count_matches_docs_per_file(tmp_path):
+    corpus = tmp_path / "train.txt"
+    _write_corpus(corpus, num_docs=6, lines_per_doc=3)
+
+    out2 = tmp_path / "out2"
+    randomize_and_split_file(corpus, out2, docs_per_file=2)
+    assert _num_output_files(out2) == 3
+
+    out3 = tmp_path / "out3"
+    randomize_and_split_file(corpus, out3, docs_per_file=3)
+    assert _num_output_files(out3) == 2
+
+
+def test_single_file_when_corpus_fits(tmp_path):
+    corpus = tmp_path / "train.txt"
+    _write_corpus(corpus, num_docs=4, lines_per_doc=3)
+    output_dir = tmp_path / "out"
+
+    randomize_and_split_file(corpus, output_dir, docs_per_file=100)
+
+    assert _num_output_files(output_dir) == 1
+
+
+def test_split_is_lossless(tmp_path):
+    corpus = tmp_path / "train.txt"
+    expected = _write_corpus(corpus, num_docs=10, lines_per_doc=4)
+    output_dir = tmp_path / "out"
+
+    randomize_and_split_file(corpus, output_dir, docs_per_file=3)
+
+    produced = _read_all_output_lines(output_dir)
+
+    assert sorted(produced) == sorted(expected)
+
+
+def test_lines_are_shuffled(tmp_path):
+    random.seed(123)
+    corpus = tmp_path / "train.txt"
+
+    expected = _write_corpus(corpus, num_docs=1, lines_per_doc=300)
+    output_dir = tmp_path / "out"
+
+    randomize_and_split_file(corpus, output_dir, docs_per_file=10)
+
+    assert _num_output_files(output_dir) == 1
+    produced = _read_all_output_lines(output_dir)
+
+    assert sorted(produced) == sorted(expected)
+
+    assert produced != expected
+
+
+def test_custom_delimiter(tmp_path):
+    corpus = tmp_path / "train.txt"
+
+    _write_corpus(corpus, num_docs=4, lines_per_doc=3, delimiter="[DOC_SEP]")
+
+    out_custom = tmp_path / "out_custom"
+    randomize_and_split_file(corpus, out_custom, docs_per_file=2, delimiter="[DOC_SEP]")
+    assert _num_output_files(out_custom) == 2
+
+
+    out_default = tmp_path / "out_default"
+    randomize_and_split_file(corpus, out_default, docs_per_file=2)
+    assert _num_output_files(out_default) == 1
+
+
+def test_accepts_string_paths(tmp_path):
+    corpus = tmp_path / "train.txt"
+    expected = _write_corpus(corpus, num_docs=4, lines_per_doc=2)
+    output_dir = tmp_path / "out"
+
+    randomize_and_split_file(str(corpus), str(output_dir), docs_per_file=2)
+
+    assert _num_output_files(output_dir) == 2
+    assert sorted(_read_all_output_lines(output_dir)) == sorted(expected)
