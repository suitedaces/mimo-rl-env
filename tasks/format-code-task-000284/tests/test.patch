+++ b/test/alias-ref-dedup.test.ts
@@ -0,0 +1,56 @@
+import {assert} from "chai";
+import * as TJS from "../typescript-json-schema";
+import {readFileSync} from "fs";
+import {resolve} from "path";
+import * as Ajv from "ajv";
+
+const ajv = new Ajv();
+
+const base = "test/programs/";
+
+function generate(group: string, type: string, settings: any) {
+    const defaults = TJS.getDefaultArgs();
+    defaults.generateRequired = true;
+
+    for (let pref in defaults) {
+        if (!(pref in settings)) {
+            settings[pref] = defaults[pref];
+        }
+    }
+
+    return TJS.generateSchema(TJS.getProgramFromFiles([resolve(base + group + "/main.ts")]), type, settings);
+}
+
+function expected(group: string) {
+    return JSON.parse(readFileSync(base + group + "/schema.json", "utf8"));
+}
+
+describe("type alias reference deduplication", function() {
+    it("emits aliases of named types as $ref instead of duplicating their schema", function() {
+        const group = "type-alias-reference-dedup";
+        const actual = generate(group, "MyObject", {
+            useTypeAliasRef: true,
+            useRootRef: false
+        });
+
+        assert.isObject(actual);
+        assert.deepEqual(actual, expected(group), "The schema is not as expected");
+
+        ajv.validateSchema(actual);
+        assert.equal(ajv.errors, null, "The schema is not valid");
+    });
+
+    it("deduplicates recursive alias definitions", function() {
+        const group = "type-alias-recursive-dedup";
+        const actual = generate(group, "MyObject", {
+            useTypeAliasRef: true,
+            useRootRef: true
+        });
+
+        assert.isObject(actual);
+        assert.deepEqual(actual, expected(group), "The schema is not as expected");
+
+        ajv.validateSchema(actual);
+        assert.equal(ajv.errors, null, "The schema is not valid");
+    });
+});
