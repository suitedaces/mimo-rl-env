@@ -0,0 +1,334 @@
+from linkpreview import link_preview
+
+
+BASE_URL = "http://example.com/dir/page.html"
+
+
+def preview_values(preview):
+    return {
+        "site_name": preview.site_name,
+        "title": preview.title,
+        "description": preview.description,
+        "image": preview.image,
+        "favicon": preview.favicon,
+        "absolute_favicon": preview.absolute_favicon,
+        "to_dict": preview.to_dict(),
+    }
+
+
+def test_site_name_uses_hostname_without_credentials_or_port():
+
+
+
+
+    preview = link_preview(
+        "http://root:passwd@example.com:8080/page",
+        content="<html><body>OK</body></html>",
+    )
+
+    assert preview.site_name == "example.com"
+
+
+def test_title_prefers_title_tag_over_h1():
+
+
+
+
+    preview = link_preview(
+        BASE_URL,
+        content=(
+            "<html><head><title>Title Tag</title></head>"
+            "<body><h1>Heading</h1></body></html>"
+        ),
+    )
+
+    assert preview.title == "Title Tag"
+
+
+def test_title_falls_back_to_first_h1():
+
+
+
+
+    preview = link_preview(
+        BASE_URL,
+        content="<html><body><h1>Heading Only</h1></body></html>",
+    )
+
+    assert preview.title == "Heading Only"
+
+
+def test_description_prefers_meta_description():
+
+
+
+
+    preview = link_preview(
+        BASE_URL,
+        content='<meta name="description" content="Meta description"><p>Body text</p>',
+    )
+
+    assert preview.description == "Meta description"
+
+
+def test_description_falls_back_to_paragraph_after_h1():
+
+
+
+
+    preview = link_preview(
+        BASE_URL,
+        content=(
+            "<html><body><h1>Heading</h1><p>Intro paragraph</p>"
+            "<p>Second paragraph</p></body></html>"
+        ),
+    )
+
+    assert preview.description == "Intro paragraph"
+
+
+def test_description_uses_first_paragraph_when_no_heading():
+
+
+
+
+    preview = link_preview(
+        BASE_URL,
+        content=(
+            "<html><body><p>First paragraph text</p>"
+            "<p>Second paragraph</p></body></html>"
+        ),
+    )
+
+    assert preview.description == "First paragraph text"
+
+
+def test_image_uses_following_h1_sibling_image():
+
+
+
+
+    preview = link_preview(
+        BASE_URL,
+        content=(
+            '<html><body><h1>Heading</h1><img src="hero.jpg">'
+            '<img src="later.jpg"></body></html>'
+        ),
+    )
+
+
+    assert preview.image == "hero.jpg"
+
+
+def test_image_uses_later_image_after_h1_when_no_image_sibling_exists():
+
+
+
+
+    preview = link_preview(
+        BASE_URL,
+        content=(
+            '<html><body><h1>Heading</h1><section><img src="nested-hero.jpg">'
+            "</section><p>Later</p></body></html>"
+        ),
+    )
+
+
+    assert preview.image == "nested-hero.jpg"
+
+
+def test_image_uses_first_document_image_and_ignores_missing_src():
+
+
+
+
+    preview = link_preview(
+        BASE_URL,
+        content='<html><body><img><p>Text</p><img src="fallback.jpg"></body></html>',
+    )
+
+
+    assert preview.image == "fallback.jpg"
+
+
+def test_empty_html_leaves_fallback_fields_none():
+
+
+
+
+    preview = link_preview(BASE_URL, content="")
+
+    assert preview.title is None
+    assert preview.description is None
+    assert preview.image is None
+
+
+def test_malformed_html_leaves_fallback_fields_none():
+
+
+
+
+    preview = link_preview(BASE_URL, content="<html><body><h1></body>")
+
+    assert preview.title is None
+    assert preview.description is None
+    assert preview.image is None
+
+
+def test_favicon_valid_rels_sizes_order_duplicates_and_absolute_urls():
+
+
+
+
+    preview = link_preview(
+        BASE_URL,
+        content=(
+            "<html><head>"
+            '<link rel="shortcut icon" href="/favicon.ico">'
+            '<link rel="icon" href="icon-32.png" sizes="32x32 16x16">'
+            '<link rel="apple-touch-icon" href="touch.png" sizes="any">'
+            '<link rel="apple-touch-icon-precomposed" '
+            'href="https://cdn.example.com/apple.png" sizes="64×64">'
+            '<link rel="icon" href="dup.png" sizes="32x32">'
+            '<link rel="icon" href="dup.png" sizes="16x16">'
+            "</head></html>"
+        ),
+    )
+
+    expected_favicon = (
+        ("/favicon.ico", None, "shortcut icon"),
+        ("icon-32.png", ((32, 32), (16, 16)), "icon"),
+        ("touch.png", None, "apple-touch-icon"),
+        ("https://cdn.example.com/apple.png", ((64, 64),), "apple-touch-icon-precomposed"),
+        ("dup.png", ((32, 32),), "icon"),
+        ("dup.png", ((16, 16),), "icon"),
+    )
+    expected_absolute = (
+        ("http://example.com/favicon.ico", None, "shortcut icon"),
+        ("http://example.com/dir/icon-32.png", ((32, 32), (16, 16)), "icon"),
+        ("http://example.com/dir/touch.png", None, "apple-touch-icon"),
+        ("https://cdn.example.com/apple.png", ((64, 64),), "apple-touch-icon-precomposed"),
+        ("http://example.com/dir/dup.png", ((32, 32),), "icon"),
+        ("http://example.com/dir/dup.png", ((16, 16),), "icon"),
+    )
+
+    assert preview.favicon == expected_favicon
+    assert preview.absolute_favicon == expected_absolute
+    as_dict = preview.to_dict()
+    assert as_dict["favicon"] == expected_favicon
+    assert as_dict["absolute_favicon"] == expected_absolute
+
+
+def test_favicon_invalid_rel_empty_rel_and_empty_href_are_ignored():
+
+
+
+
+    preview = link_preview(
+        BASE_URL,
+        content=(
+            "<html><head>"
+            '<link rel="manifest" href="manifest.json">'
+            '<link rel="" href="empty-rel.ico">'
+            '<link rel="icon" href="">'
+            '<link href="no-rel.ico">'
+            "</head></html>"
+        ),
+    )
+
+    assert preview.favicon == ()
+    assert preview.absolute_favicon == ()
+    assert preview.to_dict()["favicon"] == ()
+    assert preview.to_dict()["absolute_favicon"] == ()
+
+
+def test_explicit_none_parser_preserves_fallback_metadata():
+    preview = link_preview(
+        BASE_URL,
+        content="<html><body><h1>Parser None</h1></body></html>",
+        parser=None,
+    )
+
+
+    assert preview.title == "Parser None"
+
+
+def test_referential_transparency_same_input_same_public_values():
+    content = (
+        "<html><head><title>Repeatable</title></head><body>"
+        '<h1>Heading</h1><img src="repeat.jpg"></body></html>'
+    )
+    expected = {
+        "site_name": "example.com",
+        "title": "Repeatable",
+        "description": None,
+        "image": "repeat.jpg",
+    }
+
+    first = preview_values(link_preview(BASE_URL, content=content))
+    second = preview_values(link_preview(BASE_URL, content=content))
+    for values in (first, second):
+
+        assert {
+            "site_name": values["site_name"],
+            "title": values["title"],
+            "description": values["description"],
+            "image": values["image"],
+        } == expected
+
+        assert values["to_dict"]["favicon"] == values["favicon"]
+        assert values["to_dict"]["absolute_favicon"] == values["absolute_favicon"]
+
+
+def test_does_not_mutate_caller_supplied_arguments():
+    preview = link_preview(
+        BASE_URL,
+        content='<html><body><h1>Immutable</h1><img src="still.jpg"></body></html>',
+    )
+
+
+    assert preview.title == "Immutable"
+
+
+def test_no_global_state_matches_fresh_process_for_same_input():
+    content = (
+        "<html><head>"
+        '<link rel="icon" href="state.ico" sizes="32x32">'
+        "</head><body><h1>State Title</h1><p>State paragraph</p></body></html>"
+    )
+    preview = link_preview(BASE_URL, content=content)
+
+
+    assert preview.site_name == "example.com"
+    assert preview.title == "State Title"
+    assert preview.description == "State paragraph"
+    assert preview.image is None
+    assert preview.favicon == (("state.ico", ((32, 32),), "icon"),)
+    assert preview.absolute_favicon == (
+        ("http://example.com/dir/state.ico", ((32, 32),), "icon"),
+    )
+    as_dict = preview.to_dict()
+    assert as_dict["favicon"] == preview.favicon
+    assert as_dict["absolute_favicon"] == preview.absolute_favicon
+
+
+def test_content_call_uses_supplied_content_for_spec_fields():
+
+    preview = link_preview(
+        BASE_URL,
+        content=(
+            "<html><head><title>No IO</title></head><body>"
+            '<h1>Ignored</h1><img src="local.jpg"></body></html>'
+        ),
+    )
+
+
+    assert preview.site_name == "example.com"
+    assert preview.title == "No IO"
+    assert preview.description is None
+    assert preview.image == "local.jpg"
+    assert preview.favicon == ()
+    assert preview.absolute_favicon == ()
+    as_dict = preview.to_dict()
+    assert as_dict["favicon"] == preview.favicon
+    assert as_dict["absolute_favicon"] == preview.absolute_favicon
