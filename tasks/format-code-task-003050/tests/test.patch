diff --git a/usercase-test-coderl/parser_list_test.go b/usercase-test-coderl/parser_list_test.go
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/parser_list_test.go
@@ -0,0 +1,359 @@
+package usercase_test_coderl
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/zegl/kube-score/domain"
+	parserpkg "github.com/zegl/kube-score/parser"
+)
+
+const listWithServiceAndDeployment = `apiVersion: v1
+kind: List
+items:
+  - apiVersion: v1
+    kind: Service
+    metadata:
+      name: list-service-test
+    spec:
+      ports:
+        - protocol: TCP
+          port: 80
+      selector:
+        app: list-deployment-test
+  - apiVersion: apps/v1
+    kind: Deployment
+    metadata:
+      name: list-deployment-test
+      labels:
+        app: list-deployment-test
+    spec:
+      replicas: 1
+      selector:
+        matchLabels:
+          app: list-deployment-test
+      template:
+        metadata:
+          labels:
+            app: list-deployment-test
+        spec:
+          containers:
+            - name: nginx
+              image: nginx
+`
+
+const separateServiceAndDeploymentDocuments = `apiVersion: v1
+kind: Service
+metadata:
+  name: list-service-test
+spec:
+  ports:
+    - protocol: TCP
+      port: 80
+  selector:
+    app: list-deployment-test
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: list-deployment-test
+  labels:
+    app: list-deployment-test
+spec:
+  replicas: 1
+  selector:
+    matchLabels:
+      app: list-deployment-test
+  template:
+    metadata:
+      labels:
+        app: list-deployment-test
+    spec:
+      containers:
+        - name: nginx
+          image: nginx
+`
+
+const emptyList = `apiVersion: v1
+kind: List
+items: []
+`
+
+const listWithMalformedServiceItem = `apiVersion: v1
+kind: List
+items:
+  - apiVersion: apps/v1
+    kind: Deployment
+    metadata:
+      name: list-deployment-test
+      labels:
+        app: list-deployment-test
+    spec:
+      replicas: 1
+      selector:
+        matchLabels:
+          app: list-deployment-test
+      template:
+        metadata:
+          labels:
+            app: list-deployment-test
+        spec:
+          containers:
+            - name: nginx
+              image: nginx
+  - apiVersion: v1
+    kind: Service
+    metadata:
+      name: malformed-list-service
+    spec:
+      ports:
+        - protocol: TCP
+          port: 80
+          nodePort: wrong-type
+`
+
+const listAlongsideStandaloneService = listWithServiceAndDeployment + `---
+apiVersion: v1
+kind: Service
+metadata:
+  name: standalone-service-test
+spec:
+  ports:
+    - protocol: TCP
+      port: 443
+  selector:
+    app: list-deployment-test
+`
+
+type namedStringReader struct {
+	*strings.Reader
+	name string
+}
+
+func newNamedReader(name string, contents string) *namedStringReader {
+	return &namedStringReader{
+		Reader: strings.NewReader(contents),
+		name:   name,
+	}
+}
+
+func (r *namedStringReader) Name() string {
+	return r.name
+}
+
+func newParser(t *testing.T) *parserpkg.Parser {
+	t.Helper()
+
+	p, err := parserpkg.New(nil)
+	if err != nil {
+		t.Fatalf("parser.New(nil) error = %v, want nil", err)
+	}
+
+	return p
+}
+
+func parseManifest(t *testing.T, p *parserpkg.Parser, name string, manifest string) (domain.AllTypes, error) {
+	t.Helper()
+	return p.ParseFiles([]domain.NamedReader{newNamedReader(name, manifest)})
+}
+
+type objectCounts struct {
+	Metas                    int
+	Pods                     int
+	PodSpeccers              int
+	Services                 int
+	StatefulSets             int
+	Deployments              int
+	NetworkPolicies          int
+	Ingresses                int
+	CronJobs                 int
+	PodDisruptionBudgets     int
+	HorizontalPodAutoscalers int
+}
+
+func countsOf(all domain.AllTypes) objectCounts {
+	return objectCounts{
+		Metas:                    len(all.Metas()),
+		Pods:                     len(all.Pods()),
+		PodSpeccers:              len(all.PodSpeccers()),
+		Services:                 len(all.Services()),
+		StatefulSets:             len(all.StatefulSets()),
+		Deployments:              len(all.Deployments()),
+		NetworkPolicies:          len(all.NetworkPolicies()),
+		Ingresses:                len(all.Ingresses()),
+		CronJobs:                 len(all.CronJobs()),
+		PodDisruptionBudgets:     len(all.PodDisruptionBudgets()),
+		HorizontalPodAutoscalers: len(all.HorizontalPodAutoscalers()),
+	}
+}
+
+func serviceNames(all domain.AllTypes) map[string]int {
+	names := make(map[string]int)
+	for _, service := range all.Services() {
+		names[service.Service().ObjectMeta.Name]++
+	}
+	return names
+}
+
+func deploymentNames(all domain.AllTypes) map[string]int {
+	names := make(map[string]int)
+	for _, deployment := range all.Deployments() {
+		names[deployment.Deployment().ObjectMeta.Name]++
+	}
+	return names
+}
+
+func assertCounts(t *testing.T, all domain.AllTypes, want objectCounts) {
+	t.Helper()
+
+	if got := countsOf(all); got != want {
+		t.Fatalf("object counts = %#v, want %#v", got, want)
+	}
+}
+
+func assertMap(t *testing.T, label string, got map[string]int, want map[string]int) {
+	t.Helper()
+
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("%s = %#v, want %#v", label, got, want)
+	}
+}
+
+func assertServiceDeploymentCounts(t *testing.T, all domain.AllTypes, wantServices int, wantDeployments int) {
+	t.Helper()
+
+	if got := len(all.Services()); got != wantServices {
+		t.Fatalf("Services() length = %d, want %d", got, wantServices)
+	}
+	if got := len(all.Deployments()); got != wantDeployments {
+		t.Fatalf("Deployments() length = %d, want %d", got, wantDeployments)
+	}
+}
+
+func TestParseFilesListReturnsServiceAndDeploymentLikeSeparateDocuments(t *testing.T) {
+
+
+	p := newParser(t)
+
+	listObjects, err := parseManifest(t, p, "list.yaml", listWithServiceAndDeployment)
+	if err != nil {
+		t.Fatalf("ParseFiles(list) error = %v, want nil", err)
+	}
+
+	assertServiceDeploymentCounts(t, listObjects, 1, 1)
+	assertMap(t, "service names", serviceNames(listObjects), map[string]int{"list-service-test": 1})
+	assertMap(t, "deployment names", deploymentNames(listObjects), map[string]int{"list-deployment-test": 1})
+
+	separateObjects, err := parseManifest(t, p, "separate.yaml", separateServiceAndDeploymentDocuments)
+	if err != nil {
+		t.Fatalf("ParseFiles(separate documents) error = %v, want nil", err)
+	}
+
+	if got, want := countsOf(listObjects), countsOf(separateObjects); got != want {
+		t.Fatalf("List object counts = %#v, separate-document object counts = %#v", got, want)
+	}
+	assertMap(t, "separate service names", serviceNames(separateObjects), map[string]int{"list-service-test": 1})
+	assertMap(t, "separate deployment names", deploymentNames(separateObjects), map[string]int{"list-deployment-test": 1})
+}
+
+func TestParseFilesEmptyListReturnsNoObjects(t *testing.T) {
+
+
+	objects, err := parseManifest(t, newParser(t), "empty-list.yaml", emptyList)
+	if err != nil {
+		t.Fatalf("ParseFiles(empty List) error = %v, want nil", err)
+	}
+
+	assertCounts(t, objects, objectCounts{
+		Metas:                    0,
+		Pods:                     0,
+		PodSpeccers:              0,
+		Services:                 0,
+		StatefulSets:             0,
+		Deployments:              0,
+		NetworkPolicies:          0,
+		Ingresses:                0,
+		CronJobs:                 0,
+		PodDisruptionBudgets:     0,
+		HorizontalPodAutoscalers: 0,
+	})
+}
+
+func TestParseFilesListPropagatesMalformedItemError(t *testing.T) {
+
+
+	_, err := parseManifest(t, newParser(t), "bad-list.yaml", listWithMalformedServiceItem)
+
+	if err == nil {
+		t.Fatal("ParseFiles(malformed List item) error = nil, want decode error")
+	}
+}
+
+func TestParseFilesListWorksAlongsideOtherYamlDocuments(t *testing.T) {
+
+
+	objects, err := parseManifest(t, newParser(t), "mixed-stream.yaml", listAlongsideStandaloneService)
+	if err != nil {
+		t.Fatalf("ParseFiles(List plus standalone document) error = %v, want nil", err)
+	}
+
+
+	assertServiceDeploymentCounts(t, objects, 2, 1)
+	names := serviceNames(objects)
+	if got := names["list-service-test"]; got != 1 {
+		t.Fatalf("service names contain list-service-test %d times, want 1: %#v", got, names)
+	}
+	if got := len(names); got != 2 {
+		t.Fatalf("distinct service names = %d, want 2: %#v", got, names)
+	}
+	assertMap(t, "deployment names", deploymentNames(objects), map[string]int{"list-deployment-test": 1})
+}
+
+func TestSeparateParserInstancesKeepTheirOwnParseResults(t *testing.T) {
+
+
+	parserA := newParser(t)
+	parserB := newParser(t)
+
+	objectsA, err := parseManifest(t, parserA, "a-list.yaml", listWithServiceAndDeployment)
+	if err != nil {
+		t.Fatalf("parser A ParseFiles error = %v, want nil", err)
+	}
+	objectsB, err := parseManifest(t, parserB, "b-empty-list.yaml", emptyList)
+	if err != nil {
+		t.Fatalf("parser B ParseFiles error = %v, want nil", err)
+	}
+
+
+	assertServiceDeploymentCounts(t, objectsA, 1, 1)
+	assertCounts(t, objectsB, objectCounts{
+		Metas:                    0,
+		Pods:                     0,
+		PodSpeccers:              0,
+		Services:                 0,
+		StatefulSets:             0,
+		Deployments:              0,
+		NetworkPolicies:          0,
+		Ingresses:                0,
+		CronJobs:                 0,
+		PodDisruptionBudgets:     0,
+		HorizontalPodAutoscalers: 0,
+	})
+}
+
+func TestRepeatedParserConstructionAndListParsingReturnsExpectedObjects(t *testing.T) {
+
+
+
+
+	for i := 0; i < 3; i++ {
+		objects, err := parseManifest(t, newParser(t), "cycle-list.yaml", listWithServiceAndDeployment)
+		if err != nil {
+			t.Fatalf("cycle %d ParseFiles error = %v, want nil", i, err)
+		}
+		assertServiceDeploymentCounts(t, objects, 1, 1)
+		assertMap(t, "cycle service names", serviceNames(objects), map[string]int{"list-service-test": 1})
+		assertMap(t, "cycle deployment names", deploymentNames(objects), map[string]int{"list-deployment-test": 1})
+	}
+}
