+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+unset TRAVIS_BRANCH GITHUB_TOKEN
+
+trap 'rm -rf /workspace/repo/dist /workspace/repo/libs/closure-library/closure/bin/build/__pycache__' EXIT
+
+python build.py compile -d -b bundle --output /workspace/repo/dist/js >/dev/null
+
+node --test /workspace/repo/usercase-test-coderl/calendar_data_view.test.js
