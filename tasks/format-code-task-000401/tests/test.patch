diff --git a/usercase-test-coderl/calendar_data_view.test.js b/usercase-test-coderl/calendar_data_view.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/calendar_data_view.test.js
@@ -0,0 +1,259 @@
+const assert = require('node:assert/strict');
+const test = require('node:test');
+
+function installBrowserShim() {
+  global.window = global;
+  global.navigator = {userAgent: 'node'};
+
+  const document = {
+    documentElement: {style: {}},
+    body: {
+      style: {},
+      appendChild() {},
+      removeChild() {}
+    },
+    createElement(tag) {
+      return {
+        tagName: String(tag).toUpperCase(),
+        style: {},
+        children: [],
+        ownerDocument: document,
+        appendChild() {},
+        removeChild() {},
+        setAttribute() {},
+        getAttribute() { return undefined; },
+        getElementsByTagName() { return []; }
+      };
+    },
+    createElementNS(_namespace, tag) {
+      return document.createElement(tag);
+    },
+    getElementsByTagName() { return []; },
+    addEventListener() {},
+    removeEventListener() {}
+  };
+
+  global.document = document;
+}
+
+installBrowserShim();
+require('/workspace/repo');
+const anychart = global.anychart;
+
+function collectCalendarRows(chart) {
+  const iterator = chart.data().getIterator();
+  const rows = [];
+  while (iterator.advance()) {
+    rows.push({
+      x: iterator.get('x'),
+
+      value: Number(iterator.get('value'))
+    });
+  }
+  return rows;
+}
+
+test('constructor data view keeps valid rows sorted by parsed date', () => {
+
+
+  const inputRows = [
+    {x: '2020-03-02', value: '5'},
+    {x: 'not-a-date', value: '7'},
+    {x: '2020-01-01', value: '10'},
+    {x: '2020-02-01', value: 'bad-number'}
+  ];
+
+  const chart = anychart.calendar(inputRows);
+
+
+  assert.deepStrictEqual(collectCalendarRows(chart), [
+    {x: '2020-01-01', value: 10},
+    {x: '2020-03-02', value: 5}
+  ]);
+  assert.strictEqual(chart.data().getIterator().getRowsCount(), 2);
+
+  chart.dispose();
+});
+
+test('chart.data(newRows) replaces the calendar view with the same filtering rules', () => {
+
+
+  const chart = anychart.calendar([
+    {x: '2020-03-02', value: '5'},
+    {x: 'not-a-date', value: '7'}
+  ]);
+
+  const replacementRows = [
+    {x: '2021-12-31', value: 1},
+    {x: null, value: 99},
+    {x: '2021-01-05', value: '2'},
+    {x: '2021-06-15', value: NaN},
+    {x: '2021-03-10T00:00:00Z', value: '3.5'}
+  ];
+
+  chart.data(replacementRows);
+
+  assert.deepStrictEqual(collectCalendarRows(chart), [
+    {x: '2021-01-05', value: 2},
+    {x: '2021-03-10T00:00:00Z', value: 3.5},
+    {x: '2021-12-31', value: 1}
+  ]);
+  assert.strictEqual(chart.data().getIterator().getRowsCount(), 3);
+
+  chart.dispose();
+});
+
+test('input rows remain unchanged after construction and replacement', () => {
+
+
+  const constructorRows = [
+    {x: '2020-03-02', value: '5'},
+    {x: 'not-a-date', value: '7'},
+    {x: '2020-01-01', value: '10'},
+    {x: '2020-02-01', value: 'bad-number'}
+  ];
+  const constructorRowsExpected = [
+    {x: '2020-03-02', value: '5'},
+    {x: 'not-a-date', value: '7'},
+    {x: '2020-01-01', value: '10'},
+    {x: '2020-02-01', value: 'bad-number'}
+  ];
+  const replacementRows = [
+    {x: '2021-12-31', value: 1},
+    {x: null, value: 99},
+    {x: '2021-01-05', value: '2'},
+    {x: '2021-06-15', value: NaN},
+    {x: '2021-03-10T00:00:00Z', value: '3.5'}
+  ];
+  const replacementRowsExpected = [
+    {x: '2021-12-31', value: 1},
+    {x: null, value: 99},
+    {x: '2021-01-05', value: '2'},
+    {x: '2021-06-15', value: NaN},
+    {x: '2021-03-10T00:00:00Z', value: '3.5'}
+  ];
+
+  const chart = anychart.calendar(constructorRows);
+  chart.data(replacementRows);
+
+  assert.deepStrictEqual(constructorRows, constructorRowsExpected);
+  assert.deepStrictEqual(replacementRows, replacementRowsExpected);
+
+  chart.dispose();
+});
+
+test('same input produces deterministic iterator output across charts', () => {
+
+
+  const rows = [
+    {x: '2020-03-02', value: '5'},
+    {x: 'not-a-date', value: '7'},
+    {x: '2020-01-01', value: '10'},
+    {x: '2020-02-01', value: 'bad-number'}
+  ];
+
+  const first = anychart.calendar(rows);
+  const second = anychart.calendar(rows);
+
+
+  assert.deepStrictEqual(collectCalendarRows(first), [
+    {x: '2020-01-01', value: 10},
+    {x: '2020-03-02', value: 5}
+  ]);
+
+  assert.deepStrictEqual(collectCalendarRows(second), [
+    {x: '2020-01-01', value: 10},
+    {x: '2020-03-02', value: 5}
+  ]);
+
+  first.dispose();
+  second.dispose();
+});
+
+test('two calendar instances keep independent data views', () => {
+
+
+  const a = anychart.calendar([
+    {x: '2022-01-02', value: 8},
+    {x: '2022-01-01', value: 7}
+  ]);
+  const b = anychart.calendar([
+    {x: '2023-05-02', value: 4},
+    {x: 'bad', value: 1},
+    {x: '2023-05-01', value: 6}
+  ]);
+
+  a.data([
+    {x: '2020-01-02', value: 12},
+    {x: '2020-01-01', value: 11}
+  ]);
+
+
+  assert.deepStrictEqual(collectCalendarRows(a), [
+    {x: '2020-01-01', value: 11},
+    {x: '2020-01-02', value: 12}
+  ]);
+
+  assert.deepStrictEqual(collectCalendarRows(b), [
+    {x: '2023-05-01', value: 6},
+    {x: '2023-05-02', value: 4}
+  ]);
+
+  a.dispose();
+  b.dispose();
+});
+
+test('calendar iterator visits retained rows and then exhausts', () => {
+
+
+  const chart = anychart.calendar([
+    {x: 'bad-date', value: 10},
+    {x: '2024-01-01', value: 1},
+    {x: '2024-01-02', value: NaN}
+  ]);
+  const iterator = chart.data().getIterator();
+
+
+  assert.strictEqual(iterator.advance(), true);
+  assert.strictEqual(iterator.get('x'), '2024-01-01');
+  assert.strictEqual(iterator.get('value'), 1);
+
+  assert.strictEqual(iterator.advance(), false);
+
+  chart.dispose();
+});
+
+test('all-invalid constructor data produces an empty calendar data view', () => {
+
+
+  const chart = anychart.calendar([
+    {x: 'not-a-date', value: 7},
+    {x: null, value: 8},
+    {x: '2024-01-01', value: NaN}
+  ]);
+
+
+  assert.deepStrictEqual(collectCalendarRows(chart), []);
+  assert.strictEqual(chart.data().getIterator().getRowsCount(), 0);
+
+  chart.dispose();
+});
+
+test('repeated calendar creations expose filtered data views deterministically', () => {
+
+
+  for (let i = 0; i < 120; i += 1) {
+    const chart = anychart.calendar([
+      {x: '2024-02-02', value: i},
+      {x: 'bad-date', value: i + 1000},
+      {x: '2024-01-01', value: String(i)}
+    ]);
+
+
+    assert.deepStrictEqual(collectCalendarRows(chart), [
+      {x: '2024-01-01', value: i},
+      {x: '2024-02-02', value: i}
+    ]);
+    chart.dispose();
+  }
+});
