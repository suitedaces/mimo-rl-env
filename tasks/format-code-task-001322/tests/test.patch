+class ExcludedSignatureSuppressionTests(ScannerTestCase):
+    """End-to-end coverage for the issue: when `exclude-signatures` contains
+    a hash, that literal hash string appearing in scanned content should not
+    generate an entropy or regex issue."""
+
+    def setUp(self) -> None:
+        super().setUp()
+        self.options.entropy = True
+        self.options.regex = True
+        self.options.default_regexes = True
+
+    @mock.patch("tartufo.scanner.ScannerBase.calculate_entropy")
+    @mock.patch("tartufo.util.get_strings_of_set")
+    def test_scan_entropy_skips_string_matching_an_excluded_signature(
+        self,
+        mock_strings: mock.MagicMock,
+        mock_calculate: mock.MagicMock,
+    ):
+
+
+        excluded_sig = (
+            "deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
+        )
+        self.options.exclude_signatures = (excluded_sig,)
+        chunk = types.Chunk(excluded_sig, "some/file.py", {})
+
+        mock_strings.side_effect = ([excluded_sig], [], [], [], [], [])
+        mock_calculate.return_value = 9.0
+        test_scanner = TestScanner(self.options)
+        issues = test_scanner.scan_entropy(chunk)
+        self.assertEqual(issues, [])
+
+    @mock.patch("tartufo.scanner.ScannerBase.calculate_entropy")
+    @mock.patch("tartufo.util.get_strings_of_set")
+    def test_scan_entropy_still_yields_issue_for_non_excluded_string(
+        self,
+        mock_strings: mock.MagicMock,
+        mock_calculate: mock.MagicMock,
+    ):
+
+
+        self.options.exclude_signatures = ("some-other-sig",)
+        chunk = types.Chunk("payload", "some/file.py", {})
+        mock_strings.side_effect = (["payload"], [], [], [], [], [])
+        mock_calculate.return_value = 9.0
+        test_scanner = TestScanner(self.options)
+        issues = test_scanner.scan_entropy(chunk)
+        self.assertEqual(len(issues), 1)
+        self.assertEqual(issues[0].matched_string, "payload")
+        self.assertEqual(issues[0].issue_type, types.IssueType.Entropy)
+
+    def test_scan_regex_skips_match_matching_an_excluded_signature(self):
+        excluded_sig = "abc123excluded"
+        self.options.exclude_signatures = (excluded_sig,)
+        test_scanner = TestScanner(self.options)
+        test_scanner._rules_regexes = {  # pylint: disable=protected-access
+            "rule": Rule(
+                name=None,
+                pattern=re.compile(re.escape(excluded_sig)),
+                path_pattern=None,
+            )
+        }
+        chunk = types.Chunk(excluded_sig, "file.py", {})
+        issues = test_scanner.scan_regex(chunk)
+        self.assertEqual(issues, [])
+
 
