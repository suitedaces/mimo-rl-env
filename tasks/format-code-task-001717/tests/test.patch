diff --git a/pkg/scheme/core/v1/pending_operation_test.go b/pkg/scheme/core/v1/pending_operation_test.go
new file mode 100644
index 0000000..4f7b9c5
--- /dev/null
+++ b/pkg/scheme/core/v1/pending_operation_test.go
@@ -0,0 +1,200 @@
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+package v1
+
+import (
+	"reflect"
+	"testing"
+)
+
+func ids(c *Cluster) []string {
+	out := make([]string, 0, len(c.PendingOperations))
+	for _, op := range c.PendingOperations {
+		out = append(out, op.OperationID)
+	}
+	return out
+}
+
+func TestAddPendingOperation_AppendsInOrder(t *testing.T) {
+	c := &Cluster{}
+	if err := c.AddPendingOperation(PendingOperation{OperationID: "a", OperationType: "AddNodes", Nodes: []string{"n1"}}); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if err := c.AddPendingOperation(PendingOperation{OperationID: "b", OperationType: "RemoveNodes"}); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if err := c.AddPendingOperation(PendingOperation{OperationID: "c", OperationType: "BackupCluster"}); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if got, want := ids(c), []string{"a", "b", "c"}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("queue order = %v, want %v", got, want)
+	}
+
+	first := c.PendingOperations[0]
+	if first.OperationType != "AddNodes" || !reflect.DeepEqual(first.Nodes, []string{"n1"}) {
+		t.Fatalf("first entry not preserved: %+v", first)
+	}
+}
+
+func TestAddPendingOperation_RejectsEmptyType(t *testing.T) {
+	c := &Cluster{}
+	if err := c.AddPendingOperation(PendingOperation{OperationID: "a", OperationType: ""}); err == nil {
+		t.Fatalf("expected error for empty operation type, got nil")
+	}
+	if len(c.PendingOperations) != 0 {
+		t.Fatalf("queue must be unchanged on rejection, got %v", ids(c))
+	}
+}
+
+func TestAddPendingOperation_RejectsSameTypeConcurrent(t *testing.T) {
+	c := &Cluster{}
+	if err := c.AddPendingOperation(PendingOperation{OperationID: "a", OperationType: "AddNodes"}); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	err := c.AddPendingOperation(PendingOperation{OperationID: "b", OperationType: "AddNodes"})
+	if err == nil {
+		t.Fatalf("expected error when queuing a second operation of the same type")
+	}
+
+	if got, want := ids(c), []string{"a"}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("queue after rejected enqueue = %v, want %v", got, want)
+	}
+}
+
+func TestAddPendingOperation_DifferentTypesCoexist(t *testing.T) {
+	c := &Cluster{}
+	if err := c.AddPendingOperation(PendingOperation{OperationID: "a", OperationType: "AddNodes"}); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if err := c.AddPendingOperation(PendingOperation{OperationID: "b", OperationType: "RemoveNodes"}); err != nil {
+		t.Fatalf("unexpected error for different type: %v", err)
+	}
+	if got, want := ids(c), []string{"a", "b"}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("queue = %v, want %v", got, want)
+	}
+}
+
+func TestNextPendingOperation_EmptyQueue(t *testing.T) {
+	c := &Cluster{}
+	op, ok := c.NextPendingOperation()
+	if ok {
+		t.Fatalf("expected ok=false on empty queue, got op=%+v", op)
+	}
+	if !reflect.DeepEqual(op, PendingOperation{}) {
+		t.Fatalf("expected zero value on empty queue, got %+v", op)
+	}
+}
+
+func TestNextPendingOperation_ReturnsOldestWithoutMutating(t *testing.T) {
+	c := &Cluster{}
+	_ = c.AddPendingOperation(PendingOperation{OperationID: "a", OperationType: "AddNodes"})
+	_ = c.AddPendingOperation(PendingOperation{OperationID: "b", OperationType: "RemoveNodes"})
+
+	op, ok := c.NextPendingOperation()
+	if !ok {
+		t.Fatalf("expected ok=true, got false")
+	}
+	if op.OperationID != "a" {
+		t.Fatalf("expected oldest operation 'a', got %q", op.OperationID)
+	}
+
+	op2, ok2 := c.NextPendingOperation()
+	if !ok2 || op2.OperationID != "a" {
+		t.Fatalf("peek mutated the queue: second peek = %+v ok=%v", op2, ok2)
+	}
+	if got, want := ids(c), []string{"a", "b"}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("queue changed after peek = %v, want %v", got, want)
+	}
+}
+
+func TestRemovePendingOperation_PreservesOrder(t *testing.T) {
+	c := &Cluster{}
+	_ = c.AddPendingOperation(PendingOperation{OperationID: "a", OperationType: "AddNodes"})
+	_ = c.AddPendingOperation(PendingOperation{OperationID: "b", OperationType: "RemoveNodes"})
+	_ = c.AddPendingOperation(PendingOperation{OperationID: "c", OperationType: "BackupCluster"})
+
+	c.RemovePendingOperation("b")
+	if got, want := ids(c), []string{"a", "c"}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("queue after remove = %v, want %v", got, want)
+	}
+
+
+	c.RemovePendingOperation("a")
+	op, ok := c.NextPendingOperation()
+	if !ok || op.OperationID != "c" {
+		t.Fatalf("expected next to be 'c' after removals, got %+v ok=%v", op, ok)
+	}
+}
+
+func TestRemovePendingOperation_Idempotent(t *testing.T) {
+	c := &Cluster{}
+
+	c.RemovePendingOperation("missing")
+	if len(c.PendingOperations) != 0 {
+		t.Fatalf("expected empty queue, got %v", ids(c))
+	}
+
+	_ = c.AddPendingOperation(PendingOperation{OperationID: "a", OperationType: "AddNodes"})
+	c.RemovePendingOperation("does-not-exist")
+	if got, want := ids(c), []string{"a"}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("removing absent id changed queue = %v, want %v", got, want)
+	}
+}
+
+func TestRemoveThenReAddSameType(t *testing.T) {
+	c := &Cluster{}
+	if err := c.AddPendingOperation(PendingOperation{OperationID: "a", OperationType: "AddNodes"}); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	c.RemovePendingOperation("a")
+
+	if err := c.AddPendingOperation(PendingOperation{OperationID: "b", OperationType: "AddNodes"}); err != nil {
+		t.Fatalf("expected re-add of same type after removal to succeed, got %v", err)
+	}
+	if got, want := ids(c), []string{"b"}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("queue = %v, want %v", got, want)
+	}
+}
+
+func TestPendingOperationsDeepCopyIsIndependent(t *testing.T) {
+	c := &Cluster{}
+	_ = c.AddPendingOperation(PendingOperation{OperationID: "a", OperationType: "AddNodes", Nodes: []string{"n1"}})
+	_ = c.AddPendingOperation(PendingOperation{OperationID: "b", OperationType: "RemoveNodes"})
+
+	cp := c.DeepCopy()
+	if got, want := ids(cp), []string{"a", "b"}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("deep copy queue = %v, want %v", got, want)
+	}
+
+
+	c.RemovePendingOperation("a")
+	_ = c.AddPendingOperation(PendingOperation{OperationID: "c", OperationType: "BackupCluster"})
+	if got, want := ids(cp), []string{"a", "b"}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("deep copy was affected by mutation of original = %v, want %v", got, want)
+	}
+
+
+	c2 := &Cluster{}
+	_ = c2.AddPendingOperation(PendingOperation{OperationID: "x", OperationType: "AddNodes", Nodes: []string{"n1"}})
+	cp2 := c2.DeepCopy()
+	c2.PendingOperations[0].Nodes[0] = "mutated"
+	if cp2.PendingOperations[0].Nodes[0] != "n1" {
+		t.Fatalf("deep copy shares nested Nodes slice with original")
+	}
+}
