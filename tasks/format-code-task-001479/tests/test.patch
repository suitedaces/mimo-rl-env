diff --git a/tests/test_entity_cli_tables.py b/tests/test_entity_cli_tables.py
new file mode 100644
index 0000000..a8f5da6
--- /dev/null
+++ b/tests/test_entity_cli_tables.py
@@ -0,0 +1,174 @@
+
+
+from click.testing import CliRunner
+
+import homeassistant_cli.cli as cli
+
+
+STATES = [
+    {
+        "entity_id": "sensor.temperature",
+        "attributes": {"friendly_name": "Temperature"},
+        "state": "21",
+        "last_changed": "2020-01-01T00:00:00+00:00",
+        "last_updated": "2020-01-01T00:30:00+00:00",
+    },
+    {
+        "entity_id": "sensor.humidity",
+        "attributes": {"friendly_name": "Humidity"},
+        "state": "45",
+        "last_changed": "2020-01-01T00:05:00+00:00",
+        "last_updated": "2020-01-01T00:35:00+00:00",
+    },
+    {
+        "entity_id": "light.kitchen",
+        "attributes": {"friendly_name": "Kitchen"},
+        "state": "on",
+        "last_changed": "2020-01-01T00:10:00+00:00",
+        "last_updated": "2020-01-01T00:40:00+00:00",
+    },
+    {
+        "entity_id": "switch.fan",
+        "attributes": {"friendly_name": "Fan"},
+        "state": "off",
+        "last_changed": "2020-01-01T00:15:00+00:00",
+        "last_updated": "2020-01-01T00:45:00+00:00",
+    },
+]
+
+
+HISTORY = [
+    [
+        {
+            "entity_id": "sensor.temperature",
+            "attributes": {"friendly_name": "Temperature"},
+            "state": "20",
+            "last_changed": "2020-01-01T00:00:00+00:00",
+            "last_updated": "2020-01-01T00:30:00+00:00",
+        },
+        {
+            "entity_id": "sensor.temperature",
+            "attributes": {"friendly_name": "Temperature"},
+            "state": "21",
+            "last_changed": "2020-01-01T01:00:00+00:00",
+            "last_updated": "2020-01-01T01:30:00+00:00",
+        },
+    ]
+]
+
+
+def run_entity_command(args):
+    result = CliRunner().invoke(
+        cli.cli, ["--output", "table", "entity"] + args
+    )
+    assert result.exit_code == 0, result.output
+    return result.output
+
+
+def assert_entity_columns(output):
+    assert "ENTITY" in output
+    assert "DESCRIPTION" in output
+    assert "STATE" in output
+    assert "CHANGED" in output
+
+
+def assert_not_listed(output, *entity_ids):
+    for entity_id in entity_ids:
+        assert entity_id not in output
+
+
+def mock_states(requests_mock):
+    requests_mock.get(
+        "http://localhost:8123/api/states", json=STATES, status_code=200
+    )
+
+
+def test_entity_filter(requests_mock):
+    mock_states(requests_mock)
+
+    output = run_entity_command(["list", "^sensor\\."])
+
+    assert "sensor.temperature" in output
+    assert "sensor.humidity" in output
+    assert_not_listed(output, "light.kitchen", "switch.fan")
+
+
+def test_entity_list_filter_supports_narrow_regex(requests_mock):
+    mock_states(requests_mock)
+
+    output = run_entity_command(["list", "humidity$"])
+
+    assert "sensor.humidity" in output
+    assert_not_listed(
+        output, "sensor.temperature", "light.kitchen", "switch.fan"
+    )
+
+
+def test_entity_list_filter_supports_non_sensor_domain(requests_mock):
+    mock_states(requests_mock)
+
+    output = run_entity_command(["list", "^light\\."])
+
+    assert "light.kitchen" in output
+    assert_not_listed(
+        output, "sensor.temperature", "sensor.humidity", "switch.fan"
+    )
+
+
+def test_entity_list_without_filter_lists_all_entities(requests_mock):
+    mock_states(requests_mock)
+
+    output = run_entity_command(["list"])
+
+    assert_entity_columns(output)
+    for entity in STATES:
+        assert entity["entity_id"] in output
+        assert entity["last_changed"] in output
+
+
+def test_entity_list_table_includes_changed_column_and_values(requests_mock):
+    mock_states(requests_mock)
+
+    output = run_entity_command(["list", "^sensor\\.temperature$"])
+
+    assert_entity_columns(output)
+    assert "sensor.temperature" in output
+    assert "Temperature" in output
+    assert "21" in output
+    assert "2020-01-01T00:00:00+00:00" in output
+    assert "2020-01-01T00:30:00+00:00" not in output
+    assert_not_listed(output, "sensor.humidity", "light.kitchen", "switch.fan")
+
+
+def test_entity_get_table_uses_entity_columns(requests_mock):
+    requests_mock.get(
+        "http://localhost:8123/api/states/sensor.temperature",
+        json=STATES[0],
+        status_code=200,
+    )
+
+    output = run_entity_command(["get", "sensor.temperature"])
+
+    assert_entity_columns(output)
+    assert "ALL" not in output
+
+
+def test_entity_history_table_uses_entity_columns_for_history_states(
+    requests_mock,
+):
+    requests_mock.get(
+        "http://localhost:8123/api/history/period",
+        json=HISTORY,
+        status_code=200,
+    )
+
+    output = run_entity_command(["history", "sensor.temperature"])
+
+    assert_entity_columns(output)
+    assert "sensor.temperature" in output
+    assert "20" in output
+    assert "21" in output
+    assert "2020-01-01T00:00:00+00:00" in output
+    assert "2020-01-01T01:00:00+00:00" in output
+    assert "2020-01-01T00:30:00+00:00" not in output
+    assert "2020-01-01T01:30:00+00:00" not in output
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,52 @@
+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+if [ ! -x /testbed/.venv/bin/python ]; then
+  python3 -m venv /testbed/.venv
+fi
+
+
+set +u
+source /testbed/.venv/bin/activate
+set -u
+
+
+if ! python - <<'PY'
+import click
+import click_log
+import jsonpath_rw
+import pytest
+import requests
+import requests_mock
+import tabulate
+import yaml
+import zeroconf
+PY
+then
+  python -m pip install -U pip "setuptools<81" wheel
+  python -m pip install \
+    "pytest>=7,<9" \
+    "click>=7,<8" \
+    "click-log>=0.3,<1" \
+    "requests>=2" \
+    "requests_mock>=1.5" \
+    "PyYAML>=6" \
+    "tabulate>=0.8" \
+    "jsonpath-rw>=1.4" \
+    "zeroconf>=0.132" \
+    "netdisco>=3"
+fi
+
+case "${1:-}" in
+  base)
+    python -m pytest tests/test_entity.py -v
+    ;;
+  new)
+    python -m pytest tests/test_entity_cli_tables.py -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
