+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+set +u
+source .build_env/.venv/bin/activate
+set -u
+
+
+case "${1:-}" in
+  base)
+    python -m pytest \
+      flocker/control/test/test_schemas.py \
+      flocker/control/test/test_httpapi.py \
+      -v \
+      -k "not CreateContainer and not test_duplicate_dataset_id_conflict_uses_description_not_message"
+    ;;
+  new)
+    python -m pytest \
+      flocker/control/test/test_httpapi.py \
+      -v \
+      -k "CreateContainer or test_duplicate_dataset_id_conflict_uses_description_not_message"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
