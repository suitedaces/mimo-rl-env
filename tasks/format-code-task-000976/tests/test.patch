diff --git a/tests/unit/neptune/new/internal/backends/test_nql_contract.py b/tests/unit/neptune/new/internal/backends/test_nql_contract.py
new file mode 100644
index 00000000..77337127
--- /dev/null
+++ b/tests/unit/neptune/new/internal/backends/test_nql_contract.py
@@ -0,0 +1,20 @@
+import json
+
+from neptune.internal.backends.nql import NQLAggregator, NQLAttributeOperator, NQLAttributeType, NQLEmptyQuery, NQLQueryAggregate, NQLQueryAttribute, RawNQLQuery
+
+def test_literals():
+    text = 'owner "quoted"\\line\nnext'
+    assert str(NQLQueryAttribute("sys/owner", NQLAttributeType.STRING, NQLAttributeOperator.EQUALS, text)) == f"(`sys/owner`:string = {json.dumps(text)})"
+    assert str(NQLQueryAttribute("count", NQLAttributeType.INTEGER, NQLAttributeOperator.GREATER_THAN, 7)) == "(`count`:integer > 7)"
+    assert str(NQLQueryAttribute("ratio", NQLAttributeType.FLOAT, NQLAttributeOperator.EQUALS, 1.25)) == "(`ratio`:float = 1.25)"
+    assert str(NQLQueryAttribute("sys/trashed", NQLAttributeType.BOOLEAN, NQLAttributeOperator.EQUALS, False)) == "(`sys/trashed`:bool = false)"
+
+def test_aggregate_preserves_items():
+    keep = NQLQueryAttribute("name", NQLAttributeType.STRING, NQLAttributeOperator.EQUALS, "alice")
+    original = [NQLEmptyQuery(), keep]
+    aggregate = NQLQueryAggregate(items=original, aggregator=NQLAggregator.AND)
+    assert aggregate.eval() == keep
+    assert aggregate.items == original
+
+def test_raw_whitespace_empty():
+    assert RawNQLQuery("   \t\n").eval() == NQLEmptyQuery()
