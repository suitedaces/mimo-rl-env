+#!/usr/bin/env python
+from __future__ import unicode_literals
+
+import copy
+import os
+import unittest
+
+os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'tests.test_settings')
+import django
+django.setup()
+
+from arches.app.utils.data_management.resources.formats.format import Writer
+from arches.app.utils.data_management.resources.formats.csvfile import CsvWriter
+
+
+class ExportWriterContractTests(unittest.TestCase):
+    def setUp(self):
+        self.writer = Writer.__new__(Writer)
+        self.writer.resource_type_configs = {
+            'TYPE': {
+                'name': 'Configured type',
+                'primary_name_lookup': {'entity_type': 'NAME'},
+            }
+        }
+        self.resource = {
+            '_type': 'TYPE',
+            '_source': {
+                'entitytypeid': 'TYPE',
+                'primaryname': 'Main name',
+                'entityid': 'resource-1',
+                'child_entities': [
+                    {'entitytypeid': 'NAME', 'label': 'Main name',
+                     'value': 'Main name', 'entityid': 'name-1'},
+                    {'entitytypeid': 'NAME', 'label': 'Alternate name',
+                     'value': 'Alternate name', 'entityid': 'name-2'},
+                    {'entitytypeid': 'STRING', 'label': 'String value',
+                     'value': 'child value', 'entityid': 'child-1'},
+                    {'entitytypeid': 'RELATED', 'label': 'Related parent',
+                     'value': 'Preferred domain', 'entityid': 'parent-1'},
+                    {'entitytypeid': 'RELATED', 'label': 'Other parent',
+                     'value': 'Other domain', 'entityid': 'parent-2'},
+                ],
+                'dates': [
+                    {'entitytypeid': 'DATE', 'value': '2020', 'entityid': 'date-1'},
+                ],
+                'numbers': [
+                    {'entitytypeid': 'NUMBER', 'value': 7, 'entityid': 'number-1'},
+                ],
+                'domains': [
+                    {'entitytypeid': 'E55', 'label': 'Preferred domain',
+                     'conceptid': 'concept-1', 'entityid': 'parent-1',
+                     'parentid': 'parent-1'},
+                    {'entitytypeid': 'E55', 'label': 'Other domain',
+                     'conceptid': 'concept-2', 'entityid': 'parent-2',
+                     'parentid': 'parent-2'},
+                    {'entitytypeid': 'ALT55', 'label': 'Alternate domain',
+                     'conceptid': 'concept-3', 'entityid': 'domain-3',
+                     'parentid': 'parent-3'},
+                ],
+            },
+        }
+
+    def test_template_record_maps_identity_and_alternate_name(self):
+        schema = [
+            {'field_name': 'type', 'source': 'resource_name'},
+            {'field_name': 'id', 'source': 'entityid'},
+            {'field_name': 'resource_type_id', 'source': 'entitytypeid'},
+            {'field_name': 'name', 'source': 'primaryname'},
+            {'field_name': 'alternate', 'source': 'alternatename'},
+            {'field_name': 'unmapped', 'source': 'unsupported'},
+        ]
+        record = self.writer.create_template_record(schema, self.resource, 'TYPE')
+        self.assertEqual(record['type'], 'Configured type')
+        self.assertEqual(record['id'], 'resource-1')
+        self.assertEqual(record['resource_type_id'], 'TYPE')
+        self.assertEqual(record['name'], 'Main name')
+        self.assertEqual(record['alternate'], ['Alternate name'])
+        self.assertEqual(record['unmapped'], [])
+
+        fallback = self.writer.create_template_record(
+            [{'field_name': 'type', 'source': 'resource_name'}],
+            self.resource, None)
+        self.assertEqual(fallback['type'], 'TYPE')
+
+    def test_field_map_merges_optional_collections_once_without_mutation(self):
+        source_before = copy.deepcopy(self.resource['_source'])
+        record = {'child': [], 'date': [], 'number': []}
+        field_map = [
+            {'field_name': 'child', 'entitytypeid': 'STRING'},
+            {'field_name': 'date', 'entitytypeid': 'DATE'},
+            {'field_name': 'number', 'entitytypeid': 'NUMBER'},
+        ]
+        self.writer.get_field_map_values(self.resource, record, field_map)
+        self.assertEqual(record, {
+            'child': ['child value'], 'date': ['2020'], 'number': [7],
+        })
+        self.assertEqual(self.resource['_source'], source_before)
+
+        sparse = copy.deepcopy(self.resource)
+        del sparse['_source']['dates']
+        del sparse['_source']['numbers']
+        self.writer.get_field_map_values(
+            sparse, {'child': []},
+            [{'field_name': 'child', 'entitytypeid': 'STRING'}])
+
+    def test_domain_concept_filter_and_alternate_fallback(self):
+        filtered = self.writer.get_field_map_values(
+            self.resource, {'domain': []},
+            [{'field_name': 'domain', 'entitytypeid': 'E55',
+              'value_type': 'concept-1'}])
+        self.assertEqual(filtered['domain'], ['Preferred domain'])
+
+        alternate = self.writer.get_field_map_values(
+            self.resource, {'domain': []},
+            [{'field_name': 'domain', 'entitytypeid': 'E55',
+              'value_type': 'missing-concept',
+              'alternate_entitytypeid': 'ALT55'}])
+        self.assertEqual(alternate['domain'], ['Alternate domain'])
+
+        child_alternate = self.writer.get_field_map_values(
+            self.resource, {'name': []},
+            [{'field_name': 'name', 'entitytypeid': 'MISSING',
+              'alternate_entitytypeid': 'STRING'}])
+        self.assertEqual(child_alternate['name'], ['child value'])
+
+    def test_concatenate_value_lists_is_sorted_and_handles_numbers(self):
+        values = ['beta', 'alpha']
+        result = self.writer.concatenate_value_lists(
+            {'labels': values, 'numbers': [10, 2], 'scalar': 'kept'})
+        self.assertEqual(result['labels'], 'alpha; beta')
+        self.assertEqual(result['numbers'], '2; 10')
+        self.assertEqual(result['scalar'], 'kept')
+        self.assertEqual(values, ['beta', 'alpha'])
+
+    def test_csv_writer_can_be_reused_without_duplicate_rows(self):
+        csv_writer = CsvWriter()
+        first = csv_writer.write_resources([self.resource], '')[0]['outputfile'].getvalue()
+        second = csv_writer.write_resources([self.resource], '')[0]['outputfile'].getvalue()
+        self.assertEqual(second, first)
+        self.assertEqual(first.count('resource-1'), 1)
+
+    def test_csv_writer_does_not_mutate_explicit_mapping(self):
+        config = {
+            'NAME': 'Export',
+            'SCHEMA': [
+                {'field_name': 'id', 'source': 'entityid'},
+                {'field_name': 'name', 'source': 'primaryname'},
+            ],
+            'RESOURCE_TYPES': {
+                'TYPE': {'FIELD_MAP': [], 'records': []},
+            },
+            'RECORDS': [],
+        }
+        before = copy.deepcopy(config)
+        CsvWriter().write_resources([self.resource], config)
+        self.assertEqual(config, before)
+
+
+if __name__ == '__main__':
+    unittest.main()
