+import mujoco
+import numpy as np
+import warp as wp
+from absl.testing import absltest
+from absl.testing import parameterized
+
+import mujoco_warp as mjwarp
+
+from . import test_util
+
+wp.config.verify_cuda = True
+
+_TOLERANCE = 5e-5
+
+
+def _assert_eq(a, b, name):
+  tol = _TOLERANCE * 10
+  err_msg = f"mismatch: {name}"
+  np.testing.assert_allclose(a, b, err_msg=err_msg, atol=tol, rtol=tol)
+
+
+def _mj_jac(mjm, mjd, point, body):
+  jacp = np.zeros((3, mjm.nv))
+  jacr = np.zeros((3, mjm.nv))
+  mujoco.mj_jac(mjm, mjd, jacp, jacr, np.asarray(point, dtype=float), body)
+  return jacp, jacr
+
+
+class JacTest(parameterized.TestCase):
+  @parameterized.parameters(2, 5, 9)
+  def test_jac_matches_mujoco(self, body):
+
+    np.random.seed(0)
+    mjm, mjd, m, d = test_util.fixture("pendula.xml")
+
+    point = mjd.xpos[body].copy()
+    mj_jacp, mj_jacr = _mj_jac(mjm, mjd, point, body)
+
+    wp_point = wp.from_numpy(
+      np.expand_dims(point, axis=0).astype(np.float32), dtype=wp.float32
+    )
+    jacp, jacr = mjwarp.jac(m, d, wp_point, body)
+
+    self.assertEqual(jacp.numpy().shape, (1, mjm.nv, 3))
+    self.assertEqual(jacr.numpy().shape, (1, mjm.nv, 3))
+
+    _assert_eq(jacp.numpy()[0], mj_jacp.T, f"jacp (body {body})")
+    _assert_eq(jacr.numpy()[0], mj_jacr.T, f"jacr (body {body})")
+
+  def test_jac_zero_for_uninvolved_dofs(self):
+
+    np.random.seed(0)
+    mjm, mjd, m, d = test_util.fixture("pendula.xml")
+
+    body = 2
+    point = mjd.xpos[body].copy()
+    wp_point = wp.from_numpy(
+      np.expand_dims(point, axis=0).astype(np.float32), dtype=wp.float32
+    )
+    jacp, jacr = mjwarp.jac(m, d, wp_point, body)
+
+
+    influences = np.zeros(mjm.nv, dtype=bool)
+    for dof in range(mjm.nv):
+      b = body
+      dof_body = mjm.dof_bodyid[dof]
+      while b != 0:
+        if b == dof_body:
+          influences[dof] = True
+          break
+        b = mjm.body_parentid[b]
+
+
+    self.assertTrue(influences.any())
+    self.assertFalse(influences.all())
+
+    jacp_np = jacp.numpy()[0]
+    jacr_np = jacr.numpy()[0]
+    for dof in range(mjm.nv):
+      if not influences[dof]:
+        _assert_eq(jacp_np[dof], np.zeros(3), f"jacp dof {dof}")
+        _assert_eq(jacr_np[dof], np.zeros(3), f"jacr dof {dof}")
+
+  def test_jac_world_body_is_zero(self):
+
+    np.random.seed(0)
+    mjm, mjd, m, d = test_util.fixture("pendula.xml")
+
+    point = np.array([0.1, 0.2, 0.3])
+    wp_point = wp.from_numpy(
+      np.expand_dims(point, axis=0).astype(np.float32), dtype=wp.float32
+    )
+    jacp, jacr = mjwarp.jac(m, d, wp_point, 0)
+
+    _assert_eq(jacp.numpy()[0], np.zeros((mjm.nv, 3)), "jacp world")
+    _assert_eq(jacr.numpy()[0], np.zeros((mjm.nv, 3)), "jacr world")
+
+  def test_jac_batched(self):
+
+    np.random.seed(0)
+    mjm = mujoco.MjModel.from_xml_path(
+      (test_util.epath.resource_path("mujoco_warp") / "test_data" / "pendula.xml").as_posix()
+    )
+    mjm.opt.jacobian = True
+    mjd0 = mujoco.MjData(mjm)
+    mjd0.qvel = np.random.uniform(-0.01, 0.01, mjm.nv)
+    mujoco.mj_step(mjm, mjd0, 3)
+    mujoco.mj_forward(mjm, mjd0)
+
+    mjd1 = mujoco.MjData(mjm)
+    mjd1.qvel = np.random.uniform(-0.01, 0.01, mjm.nv)
+    mujoco.mj_step(mjm, mjd1, 7)
+    mujoco.mj_forward(mjm, mjd1)
+
+    body = 5
+    m = mjwarp.put_model(mjm)
+
+    d = mjwarp.put_data(mjm, mjd0, nworld=2)
+    qpos = np.stack([mjd0.qpos, mjd1.qpos]).astype(np.float32)
+    qvel = np.stack([mjd0.qvel, mjd1.qvel]).astype(np.float32)
+    d.qpos = wp.from_numpy(qpos, dtype=wp.float32)
+    d.qvel = wp.from_numpy(qvel, dtype=wp.float32)
+    mjwarp.kinematics(m, d)
+    mjwarp.com_pos(m, d)
+    mjwarp.com_vel(m, d)
+
+    point0 = mjd0.xpos[body].copy()
+    point1 = mjd1.xpos[body].copy()
+    wp_point = wp.from_numpy(
+      np.stack([point0, point1]).astype(np.float32), dtype=wp.float32
+    )
+    jacp, jacr = mjwarp.jac(m, d, wp_point, body)
+    self.assertEqual(jacp.numpy().shape, (2, mjm.nv, 3))
+
+    mj0_p, mj0_r = _mj_jac(mjm, mjd0, point0, body)
+    mj1_p, mj1_r = _mj_jac(mjm, mjd1, point1, body)
+
+    _assert_eq(jacp.numpy()[0], mj0_p.T, "jacp world 0")
+    _assert_eq(jacr.numpy()[0], mj0_r.T, "jacr world 0")
+    _assert_eq(jacp.numpy()[1], mj1_p.T, "jacp world 1")
+    _assert_eq(jacr.numpy()[1], mj1_r.T, "jacr world 1")
+
+
+if __name__ == "__main__":
+  wp.init()
+  absltest.main()
