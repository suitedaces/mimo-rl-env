+def test_collapse_true_merges_identical_distributions_into_one_effective_test():
+
+
+
+    genedic = {
+        "gA": gene("nugnA", "annA", {"s1": 1, "s2": 1, "s3": 0, "s4": 0}),
+        "gB": gene("nugnB", "annB", {"s1": 1, "s2": 1, "s3": 0, "s4": 0}),
+    }
+    traitsdic = {"resistant": {"s1": "1", "s2": "1", "s3": "0", "s4": "0"}}
+
+    actual = normalize_numbers(call_setup(genedic, traitsdic, True))
+
+
+    assert_result_matches_spec_subset(actual, {
+        "Results": {
+            "resistant": {
+                "gA--gB": {
+                    "NUGN": "nugnA--nugnB",
+                    "Annotation": "annA--annB",
+                    "tpgp": 2,
+                    "tngp": 0,
+                    "tpgn": 0,
+                    "tngn": 2,
+                    "sens": 100.0,
+                    "spes": 100.0,
+                    "OR": math.inf,
+                    "p_v": 0.3333333333333333,
+                    "B_p": 0.3333333333333333,
+                    "BH_p": 0.3333333333333333,
+                }
+            }
+        },
+        "Gene_trait_combinations": {
+            "resistant": {
+                "gA--gB": {"s1": "AB", "s2": "AB", "s3": "ab", "s4": "ab"}
+            }
+        },
+    })
+
+
+def test_missing_gene_isolate_raises_system_exit_with_strain_name_message():
+
+
+
+    genedic = {"g_missing": gene("nugnM", "annM", {"s1": 1})}
+    traitsdic = {"resistant": {"s1": "1", "s2": "0"}}
+
+    with pytest.raises(SystemExit) as excinfo:
+        call_setup(genedic, traitsdic, False)
+
+    message = str(excinfo.value).lower()
+
+    assert "strains" in message
+    assert "same" in message
+    assert "traits" in message
+    assert "gene presence/absence" in message
+
+
+def test_referential_transparency_for_equal_calls():
+    genedic, traitsdic = basic_inputs()
+
+    first = normalize_numbers(call_setup(copy.deepcopy(genedic), copy.deepcopy(traitsdic), False))
+    second = normalize_numbers(call_setup(copy.deepcopy(genedic), copy.deepcopy(traitsdic), False))
+
+    assert first == second
+
+
+def test_inputs_are_not_mutated():
+    genedic, traitsdic = basic_inputs()
+    original_genedic = copy.deepcopy(genedic)
+    original_traitsdic = copy.deepcopy(traitsdic)
+
+    call_setup(genedic, traitsdic, False)
+
+    assert genedic == original_genedic
+    assert traitsdic == original_traitsdic
+
+
+def test_fresh_process_returns_same_value_for_same_input():
+    genedic, traitsdic = basic_inputs()
+    in_process = normalize_numbers(call_setup(copy.deepcopy(genedic), copy.deepcopy(traitsdic), False))
+    script = r"""
+import json
+import math
+import sys
+from contextlib import redirect_stdout
+from io import StringIO
+
+sys.path.insert(0, "/workspace/repo")
+from scoary.methods import Setup_results
+
+def gene(nugn, annotation, isolates):
+    record = {"Non-unique Gene name": nugn, "Annotation": annotation}
+    record.update(isolates)
+    return record
+
+def normalize(value):
+    if isinstance(value, dict):
+        return {key: normalize(item) for key, item in value.items()}
+    if hasattr(value, "item"):
+        item = value.item()
+        if isinstance(item, (int, float, str, bool)):
+            return item
+    return value
+
+genedic = {
+    "g1": gene("nugn1", "ann1", {"s1": 1, "s2": 1, "s3": 0, "s4": 0}),
+    "g2": gene("nugn2", "ann2", {"s1": 1, "s2": 0, "s3": 1, "s4": 0}),
+    "g_all": gene("nugn_all", "ann_all", {"s1": 1, "s2": 1, "s3": 1, "s4": 1}),
+    "g_absent": gene("nugn_absent", "ann_absent", {"s1": 0, "s2": 0, "s3": 0, "s4": 0}),
+}
+traitsdic = {"resistant": {"s1": "1", "s2": "1", "s3": "0", "s4": "0"}}
+
+with redirect_stdout(StringIO()):
+    result = Setup_results(genedic, traitsdic, False)
+sys.stdout.write(json.dumps(normalize(result), sort_keys=True, allow_nan=True))
+"""
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+
+    assert json.loads(completed.stdout) == in_process
+
+
+def test_invariant_genes_are_skipped_from_results_and_labels():
+    genedic, traitsdic = basic_inputs()
+
+    actual = normalize_numbers(call_setup(genedic, traitsdic, False))
+
+
+    assert set(actual["Results"]["resistant"]) == {"g1", "g2"}
+    assert set(actual["Gene_trait_combinations"]["resistant"]) == {"g1", "g2"}
+    assert actual["Results"]["resistant"]["g1"]["p_v"] == 0.3333333333333333
