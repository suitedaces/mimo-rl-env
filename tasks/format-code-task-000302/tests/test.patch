+import copy
+import json
+import math
+import subprocess
+import sys
+from contextlib import redirect_stdout
+from io import StringIO
+
+import pytest
+
+from scoary.methods import Setup_results
+
+
+def gene(nugn, annotation, isolates):
+    record = {"Non-unique Gene name": nugn, "Annotation": annotation}
+    record.update(isolates)
+    return record
+
+
+def call_setup(genedic, traitsdic, collapse):
+    with redirect_stdout(StringIO()):
+        return Setup_results(genedic, traitsdic, collapse)
+
+
+def normalize_numbers(value):
+    if isinstance(value, dict):
+        return {key: normalize_numbers(item) for key, item in value.items()}
+    if isinstance(value, list):
+        return [normalize_numbers(item) for item in value]
+    if isinstance(value, tuple):
+        return tuple(normalize_numbers(item) for item in value)
+    if isinstance(value, float):
+        return value
+    if hasattr(value, "item"):
+        item = value.item()
+        if isinstance(item, (int, float, str, bool)):
+            return item
+    return value
+
+
+def assert_result_matches_spec_subset(actual, expected):
+
+    assert set(actual) == {"Results", "Gene_trait_combinations"}
+    assert set(actual["Results"]) == set(expected["Results"])
+    assert set(actual["Gene_trait_combinations"]) == set(
+        expected["Gene_trait_combinations"]
+    )
+
+    for trait, expected_genes in expected["Results"].items():
+        assert set(actual["Results"][trait]) == set(expected_genes)
+        for gene_name, expected_record in expected_genes.items():
+            actual_record = actual["Results"][trait][gene_name]
+            for field, expected_value in expected_record.items():
+                assert actual_record[field] == expected_value
+
+    for trait, expected_genes in expected["Gene_trait_combinations"].items():
+        assert set(actual["Gene_trait_combinations"][trait]) == set(expected_genes)
+        for gene_name, expected_labels in expected_genes.items():
+            assert actual["Gene_trait_combinations"][trait][gene_name] == expected_labels
+
+
+def basic_inputs():
+    return (
+        {
+            "g1": gene("nugn1", "ann1", {"s1": 1, "s2": 1, "s3": 0, "s4": 0}),
+            "g2": gene("nugn2", "ann2", {"s1": 1, "s2": 0, "s3": 1, "s4": 0}),
+            "g_all": gene(
+                "nugn_all", "ann_all", {"s1": 1, "s2": 1, "s3": 1, "s4": 1}
+            ),
+            "g_absent": gene(
+                "nugn_absent", "ann_absent", {"s1": 0, "s2": 0, "s3": 0, "s4": 0}
+            ),
+        },
+        {"resistant": {"s1": "1", "s2": "1", "s3": "0", "s4": "0"}},
+    )
+
+
+def test_basic_counts_adjustments_labels_and_skipped_invariant_genes():
+
+
+
+    genedic, traitsdic = basic_inputs()
+
+    actual = normalize_numbers(call_setup(genedic, traitsdic, False))
+
+
+    assert_result_matches_spec_subset(actual, {
+        "Results": {
+            "resistant": {
+                "g1": {
+                    "NUGN": "nugn1",
+                    "Annotation": "ann1",
+                    "tpgp": 2,
+                    "tngp": 0,
+                    "tpgn": 0,
+                    "tngn": 2,
+                    "sens": 100.0,
+                    "spes": 100.0,
+                    "OR": math.inf,
+                    "p_v": 0.3333333333333333,
+                    "B_p": 0.6666666666666666,
+                    "BH_p": 0.6666666666666666,
+                },
+                "g2": {
+                    "NUGN": "nugn2",
+                    "Annotation": "ann2",
+                    "tpgp": 1,
+                    "tngp": 1,
+                    "tpgn": 1,
+                    "tngn": 1,
+                    "sens": 50.0,
+                    "spes": 50.0,
+                    "OR": 1.0,
+                    "p_v": 1.0,
+                    "B_p": 1.0,
+                    "BH_p": 1.0,
+                },
+            }
+        },
+        "Gene_trait_combinations": {
+            "resistant": {
+                "g1": {"s1": "AB", "s2": "AB", "s3": "ab", "s4": "ab"},
+                "g2": {"s1": "AB", "s2": "aB", "s3": "Ab", "s4": "ab"},
+            }
+        },
+    })
