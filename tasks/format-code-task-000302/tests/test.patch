+def test_three_isolate_boundary_counts_zero_sensitivity_and_one_negative_carrier():
+
+
+
+    genedic = {
+        "only_trait_pos": gene(
+            "nugn_tp", "only positive carrier", {"s1": 1, "s2": 0, "s3": 0}
+        ),
+        "only_trait_neg": gene(
+            "nugn_tn", "only negative carrier", {"s1": 0, "s2": 1, "s3": 0}
+        ),
+    }
+    traitsdic = {"resistant": {"s1": "1", "s2": "0", "s3": "0"}}
