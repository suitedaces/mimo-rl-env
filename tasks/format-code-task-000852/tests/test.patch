--- /dev/null
+++ b/usercase-test-coderl/test_yfinance_acceptance.py
@@ -0,0 +1,444 @@
+
+
+
+
+
+
+
+
+
+from unittest import mock
+
+import pandas as pd
+import yfinance
+
+from pybroker import YFinance, disable_data_source_cache
+from pybroker.data import DataSource
+
+
+START = "2023-01-01"
+END = "2023-01-05"
+
+
+def _single_symbol_daily(auto_adjust: bool) -> pd.DataFrame:
+    columns = {
+        "Open": [130.28, 126.89, 127.13],
+        "High": [130.90, 128.66, 127.77],
+        "Low": [124.17, 125.08, 124.76],
+        "Close": (
+            [123.63, 124.90, 123.58]
+            if auto_adjust
+            else [125.07, 126.36, 125.02]
+        ),
+        "Volume": [112117500, 89113600, 80962700],
+    }
+    if not auto_adjust:
+        columns["Adj Close"] = [123.63, 124.90, 123.58]
+    return pd.DataFrame(
+        columns,
+        index=pd.Index(
+            pd.to_datetime(["2023-01-03", "2023-01-04", "2023-01-05"]),
+            name="Date",
+        ),
+    )
+
+
+def _multi_symbol_daily() -> pd.DataFrame:
+    return pd.DataFrame(
+        [
+            [
+                130.28,
+                243.08,
+                130.90,
+                245.75,
+                124.17,
+                237.40,
+                125.07,
+                239.58,
+                123.63,
+                234.42,
+                112117500,
+                25740000,
+            ],
+            [
+                126.89,
+                232.28,
+                128.66,
+                232.87,
+                125.08,
+                225.96,
+                126.36,
+                229.10,
+                124.90,
+                224.17,
+                89113600,
+                50623400,
+            ],
+        ],
+        index=pd.Index(
+            pd.to_datetime(["2023-01-03", "2023-01-04"]),
+            name="Date",
+        ),
+        columns=pd.MultiIndex.from_tuples(
+            [
+                ("Open", "AAPL"),
+                ("Open", "MSFT"),
+                ("High", "AAPL"),
+                ("High", "MSFT"),
+                ("Low", "AAPL"),
+                ("Low", "MSFT"),
+                ("Close", "AAPL"),
+                ("Close", "MSFT"),
+                ("Adj Close", "AAPL"),
+                ("Adj Close", "MSFT"),
+                ("Volume", "AAPL"),
+                ("Volume", "MSFT"),
+            ]
+        ),
+    )
+
+
+def _assert_frame(actual: pd.DataFrame, rows: list[dict], columns: list[str]):
+    expected = pd.DataFrame(rows, columns=columns)
+    if "date" in expected:
+        expected["date"] = pd.to_datetime(expected["date"])
+
+    assert set(actual.columns) == set(columns)
+    actual_cmp = actual.loc[:, columns]
+    sort_cols = [col for col in ["date", "symbol"] if col in columns]
+    if sort_cols:
+        actual_cmp = actual_cmp.sort_values(sort_cols).reset_index(drop=True)
+        expected = expected.sort_values(sort_cols).reset_index(drop=True)
+    pd.testing.assert_frame_equal(
+        actual_cmp.reset_index(drop=True), expected, check_dtype=False
+    )
+
+
+def setup_function():
+    disable_data_source_cache()
+
+
+def _download_arg(call_args, index: int, *names: str):
+    if len(call_args.args) > index:
+        return call_args.args[index]
+    for name in names:
+        if name in call_args.kwargs:
+            return call_args.kwargs[name]
+    raise AssertionError(f"missing yfinance.download argument {names[0]}")
+
+
+def _assert_download_symbols(call_args, expected: set[str]):
+
+    actual = _download_arg(call_args, 0, "tickers", "symbols")
+    if isinstance(actual, str):
+        actual_symbols = set(actual.replace(",", " ").split())
+    else:
+        actual_symbols = set(actual)
+    assert actual_symbols == expected
+
+
+def _assert_download_dates(call_args):
+
+    assert pd.Timestamp(_download_arg(call_args, 1, "start")) == pd.Timestamp(START)
+    assert pd.Timestamp(_download_arg(call_args, 2, "end")) == pd.Timestamp(END)
+
+
+def _download_auto_adjust(call_args) -> bool:
+
+    return _download_arg(call_args, 7, "auto_adjust")
+
+
+def _assert_values_by_date(actual: pd.DataFrame, column: str, values: list[float]):
+
+    expected = pd.DataFrame(
+        {
+            "date": pd.to_datetime(["2023-01-03", "2023-01-04", "2023-01-05"]),
+            column: values,
+        }
+    )
+    actual_cmp = actual.loc[:, ["date", column]].sort_values("date")
+    pd.testing.assert_frame_equal(
+        actual_cmp.reset_index(drop=True), expected, check_dtype=False
+    )
+
+
+def test_single_symbol_auto_adjust_false_normalizes_yahoo_rows():
+
+
+
+    yf = YFinance(auto_adjust=False)
+    assert isinstance(yf, DataSource) is True
+
+    with mock.patch.object(
+        yfinance, "download", return_value=_single_symbol_daily(False)
+    ) as download:
+        result = yf.query("AAPL", START, END)
+
+    _assert_frame(
+        result,
+        [
+            {
+                "date": "2023-01-03",
+                "symbol": "AAPL",
+                "open": 130.28,
+                "high": 130.90,
+                "low": 124.17,
+                "close": 125.07,
+                "volume": 112117500,
+                "adj_close": 123.63,
+            },
+            {
+                "date": "2023-01-04",
+                "symbol": "AAPL",
+                "open": 126.89,
+                "high": 128.66,
+                "low": 125.08,
+                "close": 126.36,
+                "volume": 89113600,
+                "adj_close": 124.90,
+            },
+            {
+                "date": "2023-01-05",
+                "symbol": "AAPL",
+                "open": 127.13,
+                "high": 127.77,
+                "low": 124.76,
+                "close": 125.02,
+                "volume": 80962700,
+                "adj_close": 123.58,
+            },
+        ],
+        [
+            "date",
+            "symbol",
+            "open",
+            "high",
+            "low",
+            "close",
+            "volume",
+            "adj_close",
+        ],
+    )
+    _assert_download_symbols(download.call_args, {"AAPL"})
+    _assert_download_dates(download.call_args)
+    assert _download_auto_adjust(download.call_args) is False
+
+
+def test_multiple_symbols_are_row_oriented_and_timeframe_ignored_by_provider():
+
+
+
+    yf = YFinance(auto_adjust=False)
+
+    with mock.patch.object(
+        yfinance, "download", return_value=_multi_symbol_daily()
+    ) as download:
+        result = yf.query(["AAPL", "MSFT"], START, END, _timeframe="5m")
+
+    _assert_frame(
+        result,
+        [
+            {
+                "date": "2023-01-03",
+                "symbol": "AAPL",
+                "open": 130.28,
+                "high": 130.90,
+                "low": 124.17,
+                "close": 125.07,
+                "volume": 112117500,
+                "adj_close": 123.63,
+            },
+            {
+                "date": "2023-01-03",
+                "symbol": "MSFT",
+                "open": 243.08,
+                "high": 245.75,
+                "low": 237.40,
+                "close": 239.58,
+                "volume": 25740000,
+                "adj_close": 234.42,
+            },
+            {
+                "date": "2023-01-04",
+                "symbol": "AAPL",
+                "open": 126.89,
+                "high": 128.66,
+                "low": 125.08,
+                "close": 126.36,
+                "volume": 89113600,
+                "adj_close": 124.90,
+            },
+            {
+                "date": "2023-01-04",
+                "symbol": "MSFT",
+                "open": 232.28,
+                "high": 232.87,
+                "low": 225.96,
+                "close": 229.10,
+                "volume": 50623400,
+                "adj_close": 224.17,
+            },
+        ],
+        [
+            "date",
+            "symbol",
+            "open",
+            "high",
+            "low",
+            "close",
+            "volume",
+            "adj_close",
+        ],
+    )
+    _assert_download_symbols(download.call_args, {"AAPL", "MSFT"})
+    _assert_download_dates(download.call_args)
+    assert _download_auto_adjust(download.call_args) is False
+
+    assert download.call_args.kwargs.get("interval", "1d") == "1d"
+    assert download.call_args.kwargs.get("timeframe", "1d") == "1d"
+
+
+def test_auto_adjust_true_uses_adjusted_close_without_adj_close_column():
+
+
+
+    yf = YFinance(auto_adjust=True)
+
+    with mock.patch.object(
+        yfinance, "download", return_value=_single_symbol_daily(True)
+    ) as download:
+        result = yf.query("AAPL", START, END)
+
+    _assert_frame(
+        result,
+        [
+            {
+                "date": "2023-01-03",
+                "symbol": "AAPL",
+                "open": 130.28,
+                "high": 130.90,
+                "low": 124.17,
+                "close": 123.63,
+                "volume": 112117500,
+            },
+            {
+                "date": "2023-01-04",
+                "symbol": "AAPL",
+                "open": 126.89,
+                "high": 128.66,
+                "low": 125.08,
+                "close": 124.90,
+                "volume": 89113600,
+            },
+            {
+                "date": "2023-01-05",
+                "symbol": "AAPL",
+                "open": 127.13,
+                "high": 127.77,
+                "low": 124.76,
+                "close": 123.58,
+                "volume": 80962700,
+            },
+        ],
+        ["date", "symbol", "open", "high", "low", "close", "volume"],
+    )
+    _assert_download_symbols(download.call_args, {"AAPL"})
+    _assert_download_dates(download.call_args)
+    assert _download_auto_adjust(download.call_args) is True
+
+
+def test_empty_provider_result_returns_expected_schema_for_each_adjust_mode():
+
+
+
+    for auto_adjust, expected_columns in [
+        (
+            False,
+            [
+                "symbol",
+                "date",
+                "open",
+                "high",
+                "low",
+                "close",
+                "volume",
+                "adj_close",
+            ],
+        ),
+        (
+            True,
+            ["symbol", "date", "open", "high", "low", "close", "volume"],
+        ),
+    ]:
+        yf = YFinance(auto_adjust=auto_adjust)
+        with mock.patch.object(
+            yfinance, "download", return_value=pd.DataFrame()
+        ) as download:
+            result = yf.query("AAPL", START, END)
+
+        assert result.to_dict("records") == []
+
+        assert set(result.columns) == set(expected_columns)
+        assert result.shape == (0, len(expected_columns))
+        assert _download_auto_adjust(download.call_args) is auto_adjust
+
+
+def test_instances_keep_auto_adjust_settings_independently_across_calls():
+
+
+
+    unadjusted = YFinance(auto_adjust=False)
+    adjusted = YFinance(auto_adjust=True)
+
+    with mock.patch.object(
+        yfinance,
+        "download",
+        side_effect=[
+            _single_symbol_daily(False),
+            _single_symbol_daily(True),
+            _single_symbol_daily(False),
+        ],
+    ) as download:
+        first_unadjusted = unadjusted.query("AAPL", START, END)
+        adjusted_result = adjusted.query("AAPL", START, END)
+        second_unadjusted = unadjusted.query("AAPL", START, END)
+
+
+    assert set(first_unadjusted.columns) == {
+        "date",
+        "symbol",
+        "open",
+        "high",
+        "low",
+        "close",
+        "volume",
+        "adj_close",
+    }
+    _assert_values_by_date(first_unadjusted, "close", [125.07, 126.36, 125.02])
+    _assert_values_by_date(first_unadjusted, "adj_close", [123.63, 124.90, 123.58])
+
+    assert set(adjusted_result.columns) == {
+        "date",
+        "symbol",
+        "open",
+        "high",
+        "low",
+        "close",
+        "volume",
+    }
+    _assert_values_by_date(adjusted_result, "close", [123.63, 124.90, 123.58])
+
+    assert set(second_unadjusted.columns) == {
+        "date",
+        "symbol",
+        "open",
+        "high",
+        "low",
+        "close",
+        "volume",
+        "adj_close",
+    }
+    _assert_values_by_date(second_unadjusted, "close", [125.07, 126.36, 125.02])
+    assert [
+        _download_auto_adjust(call) for call in download.call_args_list
+    ] == [False, True, False]
