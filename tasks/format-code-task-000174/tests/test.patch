+func TestWebsocketHandlerCanWriteAdditionalMessage(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	observations := make(chan handlerWriteObservation, 2)
+	method := jsonrpc.Method{
+		Name:   "test_push",
+		Params: []jsonrpc.Parameter{{Name: "msg"}},
+		Handler: func(ctx context.Context, msg string) (string, *jsonrpc.Error) {
+			conn, ok := jsonrpc.ConnFromContext(ctx)
+			obs := handlerWriteObservation{ok: ok}
+			if ok {
+				obs.n, obs.err = conn.Write([]byte("ws-event:" + msg))
+			}
+			observations <- obs
+			return "handled:" + msg, nil
+		},
+	}
+	conn := testConnection(t, ctx, method, &CountingEventListener{})
+
+	requests := []struct {
+		id  int
+		msg string
+	}{
+		{id: 1, msg: "alpha-1"},
+		{id: 2, msg: "beta-2"},
+	}
+	for _, tc := range requests {
+		req := fmt.Sprintf(`{"jsonrpc":"2.0","method":"test_push","params":["%s"],"id":%d}`, tc.msg, tc.id)
+		err := conn.Write(context.Background(), websocket.MessageText, []byte(req))
+		require.NoError(t, err)
+
+		pushed := readWebsocketMessage(t, ctx, conn)
+		require.Equal(t, "ws-event:"+tc.msg, string(pushed))
+
+		obs := readHandlerWriteObservation(t, observations)
+		require.True(t, obs.ok)
+		require.NoError(t, obs.err)
+		require.Equal(t, len("ws-event:"+tc.msg), obs.n)
+
+		response := readWebsocketMessage(t, ctx, conn)
+		var got struct {
+			Result string `json:"result"`
+			ID     int    `json:"id"`
+		}
+		require.NoError(t, json.Unmarshal(response, &got))
+		require.Equal(t, "handled:"+tc.msg, got.Result)
+		require.Equal(t, tc.id, got.ID)
+	}
+
+	require.NoError(t, conn.Close(websocket.StatusNormalClosure, ""))
+}
+
+func readWebsocketMessage(t *testing.T, ctx context.Context, conn *websocket.Conn) []byte {
+	t.Helper()
+
+	readCtx, cancel := context.WithTimeout(ctx, time.Second)
+	defer cancel()
+
+	_, msg, err := conn.Read(readCtx)
+	require.NoError(t, err)
+	return msg
+}
+
+func readHandlerWriteObservation(t *testing.T, observations <-chan handlerWriteObservation) handlerWriteObservation {
+	t.Helper()
+
+	select {
+	case obs := <-observations:
+		return obs
+	case <-time.After(time.Second):
+		t.Fatal("handler did not report websocket write result")
+		return handlerWriteObservation{}
+	}
+}
diff --git a/pubsub/registry_test.go b/pubsub/registry_test.go
new file mode 100644
index 000000000..b3a56eab4
--- /dev/null
+++ b/pubsub/registry_test.go
@@ -0,0 +1,110 @@
+package pubsub_test
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+
+	"github.com/NethermindEth/juno/pubsub"
+	"github.com/NethermindEth/juno/utils"
+	"github.com/stretchr/testify/require"
+)
+
+type fakeSubscription struct {
+	mu    sync.Mutex
+	count int
+	errs  chan error
+}
+
+func newFakeSubscription() *fakeSubscription {
+	return &fakeSubscription{errs: make(chan error)}
+}
+
+func (s *fakeSubscription) Unsubscribe() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.count++
+}
+
+func (s *fakeSubscription) Err() <-chan error {
+	return s.errs
+}
+
+func (s *fakeSubscription) unsubscribeCount() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.count
+}
+
+func TestRegistryAddDeleteSubscription(t *testing.T) {
+	registry := pubsub.New(utils.NewNopZapLogger())
+	sub := newFakeSubscription()
+
+	var id uint64 = registry.Add(context.Background(), sub)
+
+	require.NoError(t, registry.Delete(id))
+	require.Equal(t, 1, sub.unsubscribeCount())
+}
+
+func TestRegistryDeleteMissingReturnsErrNotFound(t *testing.T) {
+	registry := pubsub.New(utils.NewNopZapLogger())
+
+	for _, id := range []uint64{0, 12345} {
+		err := registry.Delete(id)
+		require.Error(t, err)
+		require.True(t, errors.Is(err, pubsub.ErrNotFound), "id %d returned %v", id, err)
+	}
+}
+
+func TestRegistryDeleteTwiceReportsNotFound(t *testing.T) {
+	registry := pubsub.New(utils.NewNopZapLogger())
+	sub := newFakeSubscription()
+	id := registry.Add(context.Background(), sub)
+
+	require.NoError(t, registry.Delete(id))
+	err := registry.Delete(id)
+
+	require.Error(t, err)
+	require.True(t, errors.Is(err, pubsub.ErrNotFound), "got %v", err)
+	require.Equal(t, 1, sub.unsubscribeCount())
+}
+
+func TestRegistryConcurrentAddDelete(t *testing.T) {
+	registry := pubsub.New(utils.NewNopZapLogger())
+	const n = 64
+
+	subs := make([]*fakeSubscription, n)
+	ids := make([]uint64, n)
+
+	var addWG sync.WaitGroup
+	addWG.Add(n)
+	for i := 0; i < n; i++ {
+		i := i
+		subs[i] = newFakeSubscription()
+		go func() {
+			defer addWG.Done()
+			ids[i] = registry.Add(context.Background(), subs[i])
+		}()
+	}
+	addWG.Wait()
+
+	var deleteWG sync.WaitGroup
+	deleteWG.Add(n)
+	errs := make([]error, n)
+	for i := 0; i < n; i++ {
+		i := i
+		go func() {
+			defer deleteWG.Done()
+			errs[i] = registry.Delete(ids[i])
+		}()
+	}
+	deleteWG.Wait()
+
+	for i, err := range errs {
+		require.NoError(t, err, "delete %d for id %d", i, ids[i])
+	}
+	for i, sub := range subs {
+		require.Equal(t, 1, sub.unsubscribeCount(), "subscription %d", i)
+	}
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
