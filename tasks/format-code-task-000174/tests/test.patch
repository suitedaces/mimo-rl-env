@@ -505,3 +505,27 @@ func BenchmarkHandle(b *testing.B) {
 		require.NoError(b, err)
 	}
 }
+
+func TestConnFromContextAbsentForNonWebsocketHandle(t *testing.T) {
+	server := jsonrpc.NewServer(1, utils.NewNopZapLogger())
+	require.NoError(t, server.RegisterMethods(jsonrpc.Method{
+		Name: "test_no_conn",
+		Handler: func(ctx context.Context) (int, *jsonrpc.Error) {
+			w, ok := jsonrpc.ConnFromContext(ctx)
+			require.False(t, ok)
+			require.Nil(t, w)
+			return 7, nil
+		},
+	}))
+
+	res, err := server.Handle(context.Background(), []byte(`{"jsonrpc":"2.0","id":1,"method":"test_no_conn"}`))
+	require.NoError(t, err)
+
+	var got struct {
+		Result int `json:"result"`
+		ID     int `json:"id"`
+	}
+	require.NoError(t, json.Unmarshal(res, &got))
+	require.Equal(t, 7, got.Result)
+	require.Equal(t, 1, got.ID)
+}
