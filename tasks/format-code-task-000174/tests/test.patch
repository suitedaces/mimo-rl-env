+++ b/mimo_test_command.sh
@@ -0,0 +1,21 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export GOPROXY='https://goproxy.cn,https://proxy.golang.org,direct'
+export GOFLAGS='-mod=mod'
+
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 -timeout=10s ./jsonrpc/ -run '^(TestHTTP|TestServer_RegisterMethod|TestHandle|TestHandler)$'
+    ;;
+  new)
+    go test -v -count=1 -timeout=10s ./jsonrpc/ ./pubsub/ -run '^(TestConnFromContextAbsentForNonWebsocketHandle|TestWebsocketHandlerCanWriteAdditionalMessage|TestRegistryAddDeleteSubscription|TestRegistryDeleteMissingReturnsErrNotFound|TestRegistryDeleteTwiceReportsNotFound|TestRegistryConcurrentAddDelete)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
