diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,58 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+export PATH="$HOME/.rbenv/bin:$HOME/.rbenv/shims:$PATH"
+eval "$(rbenv init - bash)"
+
+
+
+
+
+cat > /testbed/.simplecov << 'RUBY'
+module SimpleCov
+  module ExitCodes
+    class MinimumOverallCoverageCheck
+      def failing?
+        false
+      end
+    end
+  end
+end
+RUBY
+
+set -e
+
+run_base_tests() {
+  ruby -I api/lib -I api/test api/test/opentelemetry/trace/event_test.rb
+  ruby -I api/lib -I api/test api/test/opentelemetry/trace/link_test.rb
+  ruby -I api/lib -I api/test api/test/opentelemetry/trace/span_test.rb
+  ruby -I api/lib -I sdk/lib -I sdk/test sdk/test/opentelemetry/sdk/trace/samplers/result_test.rb
+  ruby -I api/lib -I sdk/lib -I sdk/test sdk/test/opentelemetry/sdk/trace/span_test.rb \
+    -n '/sets an attribute|trims the oldest attribute|does not set an attribute if span is ended|counts attributes|add event with attributes|trims event attributes/'
+  ruby -I api/lib -I sdk/lib -I exporters/jaeger/lib -I exporters/jaeger/test \
+    exporters/jaeger/test/opentelemetry/exporters/jaeger/exporter/span_encoder_test.rb \
+    -n '/encodes a span_data|encodes attributes in events and the span/'
+}
+
+run_new_tests() {
+  ruby -I api/lib -I api/test api/test/opentelemetry/trace/event_test.rb
+  ruby -I api/lib -I api/test api/test/opentelemetry/trace/link_test.rb
+  ruby -I api/lib -I api/test api/test/opentelemetry/trace/span_test.rb
+  ruby -I api/lib -I sdk/lib -I sdk/test sdk/test/opentelemetry/sdk/trace/samplers/result_test.rb
+  ruby -I api/lib -I sdk/lib -I sdk/test sdk/test/opentelemetry/sdk/trace/span_test.rb
+  ruby -I api/lib -I sdk/lib -I exporters/jaeger/lib -I exporters/jaeger/test exporters/jaeger/test/opentelemetry/exporters/jaeger/exporter/span_encoder_test.rb
+}
+
+case "${1:-}" in
+  base)
+    run_base_tests
+    ;;
+  new)
+    run_new_tests
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
