@@ -0,0 +1,74 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+export PATH="/opt/node-24/bin:$PATH"
+
+
+ensure_node_deps() {
+  if [ ! -x node_modules/vitest/vitest.mjs ] || [ ! -x node_modules/typescript/bin/tsc ]; then
+    if ! command -v yarn >/dev/null 2>&1; then
+      npm install -g yarn@1.22.19
+      export PATH="/opt/node-24/bin:$PATH"
+    fi
+    yarn install --frozen-lockfile --ignore-engines
+  fi
+}
+
+run_large_button_typecheck() {
+  local tmp_config
+  tmp_config="$(mktemp /testbed/.fixture-largebutton-tsconfig.XXXXXX.json)"
+  cat > "$tmp_config" <<'JSON'
+{
+  "extends": "/testbed/tsconfig-base.json",
+  "compilerOptions": {
+    "emitDeclarationOnly": false,
+    "noEmit": true,
+    "baseUrl": "/testbed",
+    "paths": {
+      "@opentrons/components": ["components/src/index.ts"],
+      "@opentrons/components/styles": ["components/src/index.module.css"],
+      "@opentrons/shared-data": ["shared-data/js/index.ts"],
+      "@opentrons/shared-data/*": ["shared-data/js/*"],
+      "@opentrons/api-client": ["api-client/src/index.ts"],
+      "@opentrons/react-api-client": ["react-api-client/src/index.ts"],
+      "@opentrons/discovery-client": ["discovery-client/src/index.ts"]
+    }
+  },
+  "include": [
+    "/testbed/app/typings",
+    "/testbed/components/typings",
+    "/testbed/app/src/atoms/buttons/__tests__/LargeButton.types.test.tsx"
+  ]
+}
+JSON
+  node node_modules/typescript/bin/tsc --project "$tmp_config" --pretty false
+  local status=$?
+  rm -f "$tmp_config"
+  return "$status"
+}
+
+ensure_node_deps
+
+case "${1:-}" in
+  base)
+    node node_modules/vitest/vitest.mjs run \
+      app/src/atoms/buttons/__tests__/LargeButton.test.tsx \
+      -t 'renders the default button and it works as expected|renders the alert button|renders the secondary button|renders the button as disabled'
+    ;;
+  new)
+    node node_modules/vitest/vitest.mjs run \
+      app/src/atoms/buttons/__tests__/LargeButton.test.tsx \
+      -t 'renders onColor styling for label, icon, and border|renders disabled onColor styling|renders alertAlt styling for label and icon|renders disabled alertAlt styling|uses the selected button type rather than caller icon color overrides'
+    node node_modules/vitest/vitest.mjs run \
+      app/src/atoms/buttons/__tests__/LargeButton.types.test.tsx \
+      app/src/organisms/ErrorRecoveryFlows/__tests__/RunPausedSplash.largeButtonVariants.test.tsx
+    run_large_button_typecheck
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
