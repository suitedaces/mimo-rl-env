+import * as React from 'react'
+import { describe, expect, it, vi } from 'vitest'
+
+import { LargeButton } from '../LargeButton'
+
+describe('LargeButton public props', () => {
+  it('accepts the reusable on-color and alternate alert button types', () => {
+    expect(
+      <LargeButton
+        onClick={vi.fn()}
+        buttonText="On color"
+        buttonType="onColor"
+      />
+    ).toBeTruthy()
+    expect(
+      <LargeButton
+        onClick={vi.fn()}
+        buttonText="Alert alternate"
+        buttonType="alertAlt"
+      />
+    ).toBeTruthy()
+  })
+
+  it('does not expose iconColorOverride', () => {
+    const props: React.ComponentProps<typeof LargeButton> = {
+      onClick: vi.fn(),
+      buttonText: 'No override',
+      buttonType: 'alertAlt',
+      // @ts-expect-error icon color is controlled by the selected button type
+      iconColorOverride: 'red',
+    }
+
+    expect(props.buttonText).toBe('No override')
+  })
+})
