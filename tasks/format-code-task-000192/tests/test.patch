+import * as React from 'react'
+import { MemoryRouter } from 'react-router-dom'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import '@testing-library/jest-dom/vitest'
+import { screen } from '@testing-library/react'
+
+import { renderWithProviders } from '../../../__testing-utils__'
+import { i18n } from '../../../i18n'
+import { mockFailedCommand } from '../__fixtures__'
+import { RunPausedSplash } from '../RunPausedSplash'
+
+const largeButtonCalls = vi.hoisted(
+  (): Array<{
+    buttonText: React.ReactNode
+    buttonType?: string
+  }> => []
+)
+
+vi.mock('../../../atoms/buttons', async importOriginal => {
+  const actual = await importOriginal<typeof import('../../../atoms/buttons')>()
+  return {
+    ...actual,
+    LargeButton: (props: {
+      buttonText: React.ReactNode
+      buttonType?: string
+      onClick: () => unknown
+    }) => {
+      largeButtonCalls.push({
+        buttonText: props.buttonText,
+        buttonType: props.buttonType,
+      })
+      return <button onClick={props.onClick}>{props.buttonText}</button>
+    },
+  }
+})
+
+const render = (): void => {
+  renderWithProviders(
+    <MemoryRouter>
+      <RunPausedSplash
+        toggleERWiz={vi.fn(() => Promise.resolve())}
+        routeUpdateActions={{ proceedToRoute: vi.fn() } as any}
+        failedCommand={mockFailedCommand}
+      />
+    </MemoryRouter>,
+    {
+      i18nInstance: i18n,
+    }
+  )
+}
+
+describe('RunPausedSplash LargeButton variants', () => {
+  beforeEach(() => {
+    largeButtonCalls.length = 0
+  })
+
+  it('passes the standard LargeButton variants for paused run actions', () => {
+    render()
+
+    const cancelButton = screen.getByRole('button', { name: /cancel run/i })
+    const launchRecoveryButton = screen.getByRole('button', {
+      name: /launch recovery mode/i,
+    })
+
+    expect(cancelButton).toBeInTheDocument()
+    expect(launchRecoveryButton).toBeInTheDocument()
+
+    const cancelCall = largeButtonCalls.find(
+      call =>
+        typeof call.buttonText === 'string' &&
+        /cancel run/i.test(call.buttonText)
+    )
+    const launchRecoveryCall = largeButtonCalls.find(
+      call =>
+        typeof call.buttonText === 'string' &&
+        /launch recovery mode/i.test(call.buttonText)
+    )
+
+    expect(cancelCall).toMatchObject({ buttonType: 'alertAlt' })
+    expect(launchRecoveryCall).toMatchObject({ buttonType: 'onColor' })
+  })
+})
