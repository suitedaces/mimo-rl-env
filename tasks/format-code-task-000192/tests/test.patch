+const parseCssColor = (cssColor: string): [number, number, number] => {
+  const probe = document.createElement('span')
+  probe.style.color = cssColor
+  document.body.appendChild(probe)
+  const normalizedColor = window.getComputedStyle(probe).color
+  probe.remove()
+
+  const rgbParts = normalizedColor.match(/\d+(\.\d+)?/g)
+  if (rgbParts == null || rgbParts.length < 3) {
+    throw new Error(`Unable to parse CSS color: ${cssColor}`)
+  }
+  return [Number(rgbParts[0]), Number(rgbParts[1]), Number(rgbParts[2])]
+}
+
+const expectCssColorToBeWhite = (cssColor: string): void => {
+  expect(parseCssColor(cssColor)).toEqual([255, 255, 255])
+}
+
+const expectCssColorNotToBeWhite = (cssColor: string): void => {
+  expect(parseCssColor(cssColor)).not.toEqual([255, 255, 255])
+}
+
+const expectCssColorToBeRedTreatment = (cssColor: string): void => {
+  const [red, green, blue] = parseCssColor(cssColor)
+  expect(red).toBeGreaterThan(green)
+  expect(red).toBeGreaterThan(blue)
+}
+
+const expectCssColorNotToBeRedTreatment = (cssColor: string): void => {
+  const [red, green, blue] = parseCssColor(cssColor)
+  expect(red > green && red > blue).toBe(false)
+}
+
+const getCss = (element: Element): CSSStyleDeclaration =>
+  window.getComputedStyle(element)
+
