+
+
+
+
+
+
+
+
+
+import copy
+import json
+import os
+import socket
+import subprocess
+import sys
+
+import numpy as np
+import pytest
+
+from quantecon import tauchen
+
+
+
+ATOL = 1e-8
+
+
+def _assert_mc(actual, expected_state_values, expected_p):
+    np.testing.assert_allclose(
+        actual.state_values,
+        np.array(expected_state_values, dtype=float),
+        rtol=0,
+        atol=ATOL,
+    )
+    np.testing.assert_allclose(
+        actual.P,
+        np.array(expected_p, dtype=float),
+        rtol=0,
+        atol=ATOL,
+    )
+
+
+def test_three_state_zero_persistence_query_example():
+
+
+
+
+    actual = tauchen(3, 0.0, 1.0, 0.0, 1)
+
+    _assert_mc(
+        actual,
+        [-1.0, 0.0, 1.0],
+        [
+            [0.3085375387259869, 0.38292492254802624, 0.3085375387259869],
+            [0.3085375387259869, 0.38292492254802624, 0.3085375387259869],
+            [0.3085375387259869, 0.38292492254802624, 0.3085375387259869],
+        ],
+    )
+
+
+def test_two_state_shifted_mean_query_example():
+
+
+
+
+    actual = tauchen(2, 0.0, 2.0, 1.0, 1)
+
+    _assert_mc(
+        actual,
+        [-1.0, 3.0],
+        [
+            [0.5, 0.5],
+            [0.5, 0.5],
+        ],
+    )
+
+
+def test_default_n_std_positive_persistence_grid_and_transition_matrix():
+
+
+
+
+    actual = tauchen(4, 0.5, 0.2)
+
+    _assert_mc(
+        actual,
+        [
+            -0.6928203230275509,
+            -0.23094010767585033,
+            0.23094010767585027,
+            0.6928203230275509,
+        ],
+        [
+            [
+                0.28185143082538655,
+                0.6765163108428383,
+                0.041605697690978105,
+                2.6560640797090862e-05,
+            ],
+            [
+                0.04163225833177522,
+                0.6765163108428383,
+                0.2799052222639973,
+                0.0019462085613892732,
+            ],
+            [
+                0.0019462085613893136,
+                0.2799052222639972,
+                0.6765163108428383,
+                0.041632258331775196,
+            ],
+            [
+                2.6560640797058617e-05,
+                0.04160569769097816,
+                0.6765163108428383,
+                0.28185143082538655,
+            ],
+        ],
+    )
+
+
+def test_negative_mean_and_negative_persistence_shifted_even_grid():
+
+
+
+
+    actual = tauchen(5, -0.25, 0.7, -0.3, 2)
+
+    _assert_mc(
+        actual,
+        [
+            -1.6859137825841022,
+            -0.9629568912920511,
+            -0.24,
