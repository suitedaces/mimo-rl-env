+def test_referential_transparency_with_seeded_random_state():
+    random_seed(501)
+    first = diffev(
+        objective_around_1_5,
+        [(-5.0, 5.0)],
+        npop=6,
+        bounds=[(-5.0, 5.0)],
+        gtol=2,
+        disp=False,
+        full_output=True,
+    )
+    random_seed(501)
+    second = diffev(
+        objective_around_1_5,
+        [(-5.0, 5.0)],
+        npop=6,
+        bounds=[(-5.0, 5.0)],
+        gtol=2,
+        disp=False,
+        full_output=True,
+    )
+
+    expected = [[1.4955759312347094], 1.9572384440019507e-05, 2, 18, 0]
+
+    _assert_full_output(first, expected)
+    _assert_full_output(second, expected)
+    _assert_near_target(first, 1.5, tol=5e-2)
+    _assert_near_target(second, 1.5, tol=5e-2)
+
