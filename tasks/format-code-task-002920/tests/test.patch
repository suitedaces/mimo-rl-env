+def objective_around_1_5(x):
+    return (x[0] - 1.5) ** 2
+
+
+def objective_with_target(x, target):
+    return (x[0] - target) ** 2
+
+
+def _to_plain_full(result):
+    return [
+        [float(v) for v in result[0]],
+        float(result[1]),
+        int(result[2]),
+        int(result[3]),
+        int(result[4]),
+    ]
+
+
+def _assert_full_output_shape(result, warnflag=None):
+
+    assert isinstance(result, tuple)
+    assert len(result) in (5, 6)
+    xopt, fopt, iterations, funcalls, actual_warnflag = result[:5]
+    assert len(xopt) == 1
+    assert math.isfinite(float(xopt[0]))
+    assert math.isfinite(float(fopt))
+    assert int(iterations) >= 0
+    assert int(funcalls) > 0
+    if warnflag is not None:
+        assert int(actual_warnflag) == warnflag
+
+
+def _assert_plain_full(actual, expected):
+
+    assert len(actual) == 5
+    assert len(actual[0]) == 1
+    assert math.isfinite(float(actual[0][0]))
+    assert math.isfinite(float(actual[1]))
+    assert int(actual[2]) >= 0
+    assert int(actual[3]) > 0
+    assert int(actual[4]) == expected[4]
+
+
+def _assert_full_output(result, expected):
+    _assert_full_output_shape(result, warnflag=expected[4])
+
+
+def _assert_vector(actual, expected):
+    assert [float(v) for v in actual] == pytest.approx(
+        expected, rel=1e-12, abs=1e-12
+    )
+
+
+def _assert_scalar(actual, expected):
+    assert float(actual) == pytest.approx(expected, rel=1e-12, abs=1e-40)
+
+
+def _assert_history(actual, expected):
+
+    assert len(actual) > 0
+    for actual_row in actual:
+        assert len(actual_row) == 1
+        assert math.isfinite(float(actual_row[0]))
+
+
+def _assert_near_target(result, target, tol=1e-2):
+
+    assert float(result[0][0]) == pytest.approx(target, abs=tol)
+    assert float(result[1]) == pytest.approx((float(result[0][0]) - target) ** 2)
+
+
+def _assert_monitor_wired(monitor):
+
+    assert len(monitor.x) > 0
+    assert len(monitor.x) == len(monitor.y)
+    assert all(len(row) == 1 for row in monitor.x)
+
+
+def _assert_disp_mentions(captured, *terms):
+
+    out = captured.out.lower()
+    assert out.strip()
+    for term in terms:
+        assert term in out
+
+
+def test_diffev_bounded_objective_returns_full_output():
+
+
+
+    random_seed(100)
+    result = diffev(
+        objective_around_1_5,
+        [(-5.0, 5.0)],
+        npop=20,
+        bounds=[(-5.0, 5.0)],
+        gtol=40,
+        disp=False,
+        full_output=True,
+    )
+
+
+    _assert_full_output(result, [[1.4999999999999898], 1.0432685471547881e-28, 40, 818, 0])
+    _assert_near_target(result, 1.5)
+
+
+def test_diffev2_uses_extra_args_and_invariant_generation_variant():
+
+
+
+    random_seed(101)
+    result = diffev2(
+        objective_with_target,
+        [(-2.0, 2.0)],
+        npop=20,
+        args=(0.25,),
+        bounds=[(-2.0, 2.0)],
+        gtol=40,
+        disp=False,
+        full_output=True,
+    )
+
+    random_seed(101)
+    standard_result = diffev(
+        objective_with_target,
+        [(-2.0, 2.0)],
+        npop=20,
+        args=(0.25,),
+        bounds=[(-2.0, 2.0)],
+        gtol=40,
+        disp=False,
+        full_output=True,
+    )
+
+
+    _assert_full_output(result, [[0.24999999949334956], 2.5669467222416207e-19, 41, 836, 0])
+    _assert_near_target(result, 0.25)
+    assert _to_plain_full(result) != _to_plain_full(standard_result)
+
