+def test_fresh_process_result_ignores_prior_in_process_calls():
+    random_seed(700)
+    diffev(
+        lambda x: (x[0] + 0.5) ** 2,
+        [(-5.0, 5.0)],
+        npop=6,
+        bounds=[(-5.0, 5.0)],
+        gtol=2,
+        disp=False,
+        full_output=True,
+    )
+    random_seed(701)
+    diffev2(
+        lambda x: (x[0] - 0.25) ** 2,
+        [(-2.0, 2.0)],
+        npop=6,
+        bounds=[(-2.0, 2.0)],
+        gtol=2,
+        disp=False,
+        full_output=True,
+    )
+
+    random_seed(501)
+    in_process = _to_plain_full(
+        diffev(
+            objective_around_1_5,
+            [(-5.0, 5.0)],
+            npop=6,
+            bounds=[(-5.0, 5.0)],
+            gtol=2,
+            disp=False,
+            full_output=True,
+        )
+    )
+    script = """
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+from mystic.solvers import diffev
+from mystic.tools import random_seed
+
+def objective_around_1_5(x):
+    return (x[0] - 1.5) ** 2
+
+random_seed(501)
+result = diffev(
+    objective_around_1_5,
+    [(-5.0, 5.0)],
+    npop=6,
+    bounds=[(-5.0, 5.0)],
+    gtol=2,
+    disp=False,
+    full_output=True,
+)
+plain = [
+    [float(v) for v in result[0]],
+    float(result[1]),
+    int(result[2]),
+    int(result[3]),
+    int(result[4]),
+]
+sys.stdout.write(json.dumps(plain))
+"""
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    fresh_process = json.loads(completed.stdout)
+    expected = [[1.4955759312347094], 1.9572384440019507e-05, 2, 18, 0]
+
+
+    _assert_plain_full(in_process, expected)
+    _assert_plain_full(fresh_process, expected)
+    assert float(in_process[0][0]) == pytest.approx(1.5, abs=5e-2)
+    assert float(fresh_process[0][0]) == pytest.approx(1.5, abs=5e-2)
+
+
+def test_no_undeclared_cwd_writes_or_network_access(tmp_path, monkeypatch):
+    def deny_socket(*args, **kwargs):
+        raise AssertionError("network access is not declared by the query")
+
+    monkeypatch.setattr(socket, "socket", deny_socket)
+    monkeypatch.chdir(tmp_path)
+
+    random_seed(800)
+    result = diffev(
+        objective_around_1_5,
+        [(-5.0, 5.0)],
+        npop=6,
+        bounds=[(-5.0, 5.0)],
+        gtol=2,
+        disp=False,
+        full_output=True,
+    )
+
+
+    _assert_full_output(result, [[1.7136263472147544], 0.04563621622431879, 2, 15, 0])
+    assert float(result[1]) == pytest.approx((float(result[0][0]) - 1.5) ** 2)
+    assert tmp_path.exists()
