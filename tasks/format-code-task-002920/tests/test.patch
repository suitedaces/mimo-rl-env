+def test_custom_map_keyword_is_used_by_diffev2():
+
+
+
+    map_calls = []
+
+    def recording_map(func, iterable):
+        items = list(iterable)
+        map_calls.append(len(items))
+        return list(map(func, items))
+
+    random_seed(200)
+    result = diffev2(
+        lambda x: (x[0] - 0.25) ** 2,
+        [(-2.0, 2.0)],
+        npop=6,
+        bounds=[(-2.0, 2.0)],
+        gtol=2,
+        disp=False,
+        full_output=True,
+        map=recording_map,
+    )
+
+
+    _assert_full_output(result, [[0.17628327874139485], 0.005434154993118888, 2, 17, 0])
+    assert float(result[1]) == pytest.approx((float(result[0][0]) - 0.25) ** 2)
+    assert map_calls
+    assert all(call_size > 0 for call_size in map_calls)
+
