+def test_diffev2_does_not_mutate_input_sequences():
+    x0 = [(-5.0, 5.0)]
+    bounds = [(-5.0, 5.0)]
+
+    random_seed(600)
+    result = diffev2(
+        objective_with_target,
+        x0,
+        npop=6,
+        args=(0.25,),
+        bounds=bounds,
+        gtol=2,
+        disp=False,
+        full_output=True,
+    )
+
+
+    _assert_full_output(result, [[0.25], 0.0, 0, 1, 0])
+    _assert_near_target(result, 0.25, tol=5e-1)
+    assert len(result[0]) == len(x0) == len(bounds)
+
