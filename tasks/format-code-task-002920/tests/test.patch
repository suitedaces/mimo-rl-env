+def test_constraints_and_penalty_keywords_affect_solver_result():
+
+
+
+
+    def constraint_to_one(x):
+        return [1.0]
+
+    def penalty_one(x):
+        return (x[0] - 1.0) ** 2
+
+    random_seed(104)
+    result = diffev(
+        lambda x: (x[0] - 3.0) ** 2,
+        [(-5.0, 5.0)],
+        npop=8,
+        bounds=[(-5.0, 5.0)],
+        gtol=3,
+        disp=False,
+        full_output=True,
+        constraints=constraint_to_one,
+        penalty=penalty_one,
+    )
+
+
+    _assert_full_output(result, [[1.0], 4.0, 3, 32, 0])
+    assert float(result[0][0]) == pytest.approx(1.0)
+    assert float(result[1]) == pytest.approx(4.0)
+
