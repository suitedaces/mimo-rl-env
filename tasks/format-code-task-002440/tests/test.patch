diff --git a/test-data/unit/check-typeddict.test b/test-data/unit/check-typeddict.test
index 48bfa4bdb..6f27048b4 100644
--- a/test-data/unit/check-typeddict.test
+++ b/test-data/unit/check-typeddict.test
@@ -4151,3 +4151,66 @@ class Base:
                                         # E: TypedDict() expects a dictionary literal as the second argument
 [builtins fixtures/dict.pyi]
 [typing fixtures/typing-typeddict.pyi]
+
+[case testTypedDictAliasAsBaseFromIssue]
+from typing import TypedDict
+
+class A(TypedDict, total=False):
+    y: int
+class B(TypedDict, total=False):
+    x: str
+
+D = B
+
+class C(A, D):
+    pass
+
+c: C
+reveal_type(c)  # N: Revealed type is "TypedDict('__main__.C', {'x'?: builtins.str, 'y'?: builtins.int})"
+[builtins fixtures/dict.pyi]
+[typing fixtures/typing-typeddict.pyi]
+
+[case testTypedDictSingleAliasAsBase]
+from typing import TypedDict
+
+class B(TypedDict, total=False):
+    x: str
+
+D = B
+
+class C(D):
+    y: int
+
+c: C
+reveal_type(c)  # N: Revealed type is "TypedDict('__main__.C', {'x'?: builtins.str, 'y': builtins.int})"
+[builtins fixtures/dict.pyi]
+[typing fixtures/typing-typeddict.pyi]
+
+[case testTypedDictDuplicateAliasBase]
+from typing import TypedDict
+
+class B(TypedDict, total=False):
+    x: str
+
+D = B
+
+class C(B, D):  # E: Duplicate base class "B"
+    pass
+[builtins fixtures/dict.pyi]
+[typing fixtures/typing-typeddict.pyi]
+
+[case testTypedDictNonTypedDictAliasRejected]
+from typing import TypedDict
+
+class A(TypedDict):
+    x: str
+
+class NotTD:
+    pass
+
+D = NotTD
+
+class C(A, D):  # E: All bases of a new TypedDict must be TypedDict types
+    pass
+[builtins fixtures/dict.pyi]
+[typing fixtures/typing-typeddict.pyi]
