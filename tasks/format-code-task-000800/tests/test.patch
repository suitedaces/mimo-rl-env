+package usercase_test_coderl
+
+
+
+
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/url"
+	"reflect"
+	"strings"
+	"testing"
+
+	jwt "github.com/dgrijalva/jwt-go"
+	request "github.com/dgrijalva/jwt-go/request"
+)
+
+const (
+	mapClaimsToken    = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYWRtaW4iLCJzdWIiOiJhbGljZSJ9.E-gcxj5S3Qw-gOAgSKDFqNA-zNNDpWN0VQnyNB_faOw"
+	customClaimsToken = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzY29wZSI6InJlYWQ6YWxsIiwiaXNzIjoiaXNzdWVyLWEiLCJzdWIiOiJib2IifQ.PJpyvCWqRZfp_RbuLLciw32rbURyfH3KrSl9q_4nMT8"
+	numberClaimsToken = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJjb3VudCI6MTIzfQ._xkoIfbL-8Zo_bvpzhWykH6ZzIvPQcrRjQ_1rHQcqhQ"
+	signingKey        = "fixture-secret"
+)
+
+type customClaims struct {
+	Scope string `json:"scope"`
+	jwt.StandardClaims
+}
+
+func (c customClaims) Valid() error {
+	return c.StandardClaims.Valid()
+}
+
+type staticExtractor struct {
+	token string
+	err   error
+}
+
+func (s staticExtractor) ExtractToken(*http.Request) (string, error) {
+	return s.token, s.err
+}
+
+func newRequest(method, target string, headers map[string]string, body string, contentType string) *http.Request {
+	req, err := http.NewRequest(method, target, strings.NewReader(body))
+	if err != nil {
+		panic(err)
+	}
+	for name, value := range headers {
+		req.Header.Set(name, value)
+	}
+	if contentType != "" {
+		req.Header.Set("Content-Type", contentType)
+	}
+	return req
+}
+
+func assertExtract(t *testing.T, extractor request.Extractor, req *http.Request, wantToken string, wantErr error) {
+	t.Helper()
+	gotToken, gotErr := extractor.ExtractToken(req)
+	if gotToken != wantToken {
+		t.Fatalf("token mismatch: got %q want %q", gotToken, wantToken)
+	}
+
+	if gotErr != wantErr {
+		t.Fatalf("error mismatch: got %v want %v", gotErr, wantErr)
+	}
+}
+
+func keyFunc(*jwt.Token) (interface{}, error) {
+	return []byte(signingKey), nil
+}
+
+func TestHeaderExtractorReturnsFirstNonEmptyMatchingHeader(t *testing.T) {
+
+
+	req := newRequest("GET", "/", map[string]string{
+		"X-Empty": "",
+		"X-Token": "abc.def.ghi",
+		"X-Other": "other.value",
+	}, "", "")
+
+	assertExtract(t, request.HeaderExtractor{"X-Empty", "X-Token", "X-Other"}, req, "abc.def.ghi", nil)
+}
+
+func TestHeaderExtractorMissReturnsSharedNoTokenError(t *testing.T) {
+
+
+	req := newRequest("GET", "/", nil, "", "")
+
+	assertExtract(t, request.HeaderExtractor{"X-Token"}, req, "", request.ErrNoTokenInRequest)
+}
+
+func TestArgumentExtractorReadsQueryArgument(t *testing.T) {
+
+
+	req := newRequest("GET", "/?token=abc.def.ghi", nil, "", "")
+
+	assertExtract(t, request.ArgumentExtractor{"token"}, req, "abc.def.ghi", nil)
+}
+
+func TestArgumentExtractorReadsParsedFormArgument(t *testing.T) {
+
+
+	form := url.Values{"token": {"form.token.value"}}
+	req := newRequest("POST", "/", nil, form.Encode(), "application/x-www-form-urlencoded")
+
+	assertExtract(t, request.ArgumentExtractor{"token"}, req, "form.token.value", nil)
+}
+
+func TestArgumentExtractorMissReturnsSharedNoTokenError(t *testing.T) {
+
+
+	req := newRequest("GET", "/?other=abc.def.ghi", nil, "", "")
+
+	assertExtract(t, request.ArgumentExtractor{"token"}, req, "", request.ErrNoTokenInRequest)
+}
+
+func TestMultiExtractorReturnsFirstTokenInOrder(t *testing.T) {
+
+
+	req := newRequest("GET", "/?token=query.token", map[string]string{"X-Token": "header.token"}, "", "")
+	extractor := request.MultiExtractor{
+		request.HeaderExtractor{"X-Token"},
+		request.ArgumentExtractor{"token"},
+	}
+
+	assertExtract(t, extractor, req, "header.token", nil)
+}
+
+func TestMultiExtractorSkipsNoTokenAndFallsBack(t *testing.T) {
+
+
+	req := newRequest("GET", "/?token=query.token", nil, "", "")
+	extractor := request.MultiExtractor{
+		request.HeaderExtractor{"X-Missing"},
+		request.ArgumentExtractor{"token"},
+	}
+
+	assertExtract(t, extractor, req, "query.token", nil)
+}
+
+func TestMultiExtractorReturnsFirstOtherErrorImmediately(t *testing.T) {
+
+
+	boom := errors.New("boom extractor")
+	req := newRequest("GET", "/?token=query.token", nil, "", "")
+	extractor := request.MultiExtractor{
+		request.HeaderExtractor{"X-Missing"},
+		staticExtractor{"", boom},
+		request.ArgumentExtractor{"token"},
+	}
+
+	assertExtract(t, extractor, req, "", boom)
+}
+
+func TestMultiExtractorMissReturnsSharedNoTokenError(t *testing.T) {
+
+
+	req := newRequest("GET", "/?other=query.token", nil, "", "")
+	extractor := request.MultiExtractor{
+		request.HeaderExtractor{"X-Missing"},
+		request.ArgumentExtractor{"token"},
+	}
+
+	assertExtract(t, extractor, req, "", request.ErrNoTokenInRequest)
+}
+
+func TestPostExtractionFilterTransformsFoundToken(t *testing.T) {
+
+
+	req := newRequest("GET", "/", map[string]string{"X-Token": "abc.def.ghi"}, "", "")
+	extractor := &request.PostExtractionFilter{
+		Extractor: request.HeaderExtractor{"X-Token"},
+		Filter: func(token string) (string, error) {
+			return "filtered:" + token, nil
+		},
+	}
+
+	assertExtract(t, extractor, req, "filtered:abc.def.ghi", nil)
+}
+
+func TestPostExtractionFilterReturnsFilterError(t *testing.T) {
+
+
+	filterErr := errors.New("filter failed")
+	req := newRequest("GET", "/", map[string]string{"X-Token": "abc.def.ghi"}, "", "")
+	extractor := &request.PostExtractionFilter{
+		Extractor: request.HeaderExtractor{"X-Token"},
+		Filter: func(string) (string, error) {
+			return "", filterErr
+		},
+	}
+
+	assertExtract(t, extractor, req, "", filterErr)
+}
+
+func TestPostExtractionFilterPassesThroughWrappedMiss(t *testing.T) {
+
+
+	req := newRequest("GET", "/", nil, "", "")
+	extractor := &request.PostExtractionFilter{
+		Extractor: request.HeaderExtractor{"X-Token"},
+		Filter: func(token string) (string, error) {
+			return "filtered:" + token, nil
+		},
+	}
+
+	assertExtract(t, extractor, req, "", request.ErrNoTokenInRequest)
+}
+
+func TestAuthorizationHeaderExtractorStripsBearerPrefixCaseInsensitively(t *testing.T) {
+
+
+	upperReq := newRequest("GET", "/", map[string]string{"Authorization": "Bearer abc.def.ghi"}, "", "")
+	lowerReq := newRequest("GET", "/", map[string]string{"Authorization": "bearer lower.token"}, "", "")
+
+	assertExtract(t, request.AuthorizationHeaderExtractor, upperReq, "abc.def.ghi", nil)
+	assertExtract(t, request.AuthorizationHeaderExtractor, lowerReq, "lower.token", nil)
+}
+
+func TestAuthorizationHeaderExtractorReturnsNonBearerValueUnchanged(t *testing.T) {
+
+
+	req := newRequest("GET", "/", map[string]string{"Authorization": "Token raw.value"}, "", "")
+
+	assertExtract(t, request.AuthorizationHeaderExtractor, req, "Token raw.value", nil)
+}
+
+func TestOAuth2ExtractorPrefersAuthorizationHeaderOverAccessTokenArgument(t *testing.T) {
+
+
+	req := newRequest("GET", "/?access_token=query.token", map[string]string{"Authorization": "Bearer header.token"}, "", "")
+
+	assertExtract(t, request.OAuth2Extractor, req, "header.token", nil)
+}
+
+func TestOAuth2ExtractorFallsBackToAccessTokenArgument(t *testing.T) {
+
+
+	req := newRequest("GET", "/?access_token=query.token", nil, "", "")
+
+	assertExtract(t, request.OAuth2Extractor, req, "query.token", nil)
+}
+
+func TestOAuth2ExtractorMissReturnsSharedNoTokenError(t *testing.T) {
+
+
+	req := newRequest("GET", "/?token=query.token", nil, "", "")
+
+	assertExtract(t, request.OAuth2Extractor, req, "", request.ErrNoTokenInRequest)
+}
+
+func TestParseFromRequestUsesDefaultMapClaimsAndSuppliedKeyCallback(t *testing.T) {
+
+
+	req := newRequest("GET", "/", map[string]string{"X-Token": mapClaimsToken}, "", "")
+
+	token, err := request.ParseFromRequest(req, request.HeaderExtractor{"X-Token"}, keyFunc)
+	if err != nil {
+		t.Fatalf("ParseFromRequest error: %v", err)
+	}
+	if token.Raw != mapClaimsToken || !token.Valid || token.Method.Alg() != "HS256" {
+		t.Fatalf("parsed token summary mismatch: raw=%q valid=%v alg=%q", token.Raw, token.Valid, token.Method.Alg())
+	}
+	want := jwt.MapClaims{"role": "admin", "sub": "alice"}
+	if !reflect.DeepEqual(token.Claims, want) {
+		t.Fatalf("claims mismatch: got %#v want %#v", token.Claims, want)
+	}
+}
+
+func TestParseFromRequestWithClaimsParsesCustomClaims(t *testing.T) {
+
+
+	req := newRequest("GET", "/", map[string]string{"X-Token": customClaimsToken}, "", "")
+
+	token, err := request.ParseFromRequestWithClaims(req, request.HeaderExtractor{"X-Token"}, &customClaims{}, keyFunc)
+	if err != nil {
+		t.Fatalf("ParseFromRequestWithClaims error: %v", err)
+	}
+	want := &customClaims{
+		Scope: "read:all",
+		StandardClaims: jwt.StandardClaims{
+			Issuer:  "issuer-a",
+			Subject: "bob",
+		},
+	}
+	if token.Raw != customClaimsToken || !token.Valid || token.Method.Alg() != "HS256" {
+		t.Fatalf("parsed token summary mismatch: raw=%q valid=%v alg=%q", token.Raw, token.Valid, token.Method.Alg())
+	}
+	if !reflect.DeepEqual(token.Claims, want) {
+		t.Fatalf("custom claims mismatch: got %#v want %#v", token.Claims, want)
+	}
+}
+
+func TestParseFromRequestWithClaimsOptionParsesCustomClaims(t *testing.T) {
+
+
+	req := newRequest("GET", "/", map[string]string{"X-Token": customClaimsToken}, "", "")
+
+	token, err := request.ParseFromRequest(req, request.HeaderExtractor{"X-Token"}, keyFunc, request.WithClaims(&customClaims{}))
+	if err != nil {
+		t.Fatalf("ParseFromRequest WithClaims error: %v", err)
+	}
+	want := &customClaims{
+		Scope: "read:all",
+		StandardClaims: jwt.StandardClaims{
+			Issuer:  "issuer-a",
+			Subject: "bob",
+		},
+	}
+	if !reflect.DeepEqual(token.Claims, want) {
+		t.Fatalf("custom claims mismatch: got %#v want %#v", token.Claims, want)
+	}
+}
+
+func TestParseFromRequestWithParserOptionUsesCustomParser(t *testing.T) {
+
+
+	req := newRequest("GET", "/", map[string]string{"X-Token": numberClaimsToken}, "", "")
+
+	token, err := request.ParseFromRequest(req, request.HeaderExtractor{"X-Token"}, keyFunc, request.WithParser(&jwt.Parser{UseJSONNumber: true}))
+	if err != nil {
+		t.Fatalf("ParseFromRequest WithParser error: %v", err)
+	}
+	want := jwt.MapClaims{"count": json.Number("123")}
+	if !reflect.DeepEqual(token.Claims, want) {
+		t.Fatalf("json-number claims mismatch: got %#v want %#v", token.Claims, want)
+	}
+}
+
+func TestParseFromRequestWithOAuth2ExtractorParsesHeaderToken(t *testing.T) {
+
+
+	req := newRequest("GET", "/?access_token=other", map[string]string{"Authorization": "Bearer " + mapClaimsToken}, "", "")
+
+	token, err := request.ParseFromRequest(req, request.OAuth2Extractor, keyFunc)
+	if err != nil {
+		t.Fatalf("ParseFromRequest OAuth2 header error: %v", err)
+	}
+	want := jwt.MapClaims{"role": "admin", "sub": "alice"}
+	if token.Raw != mapClaimsToken || !token.Valid || !reflect.DeepEqual(token.Claims, want) {
+		t.Fatalf("parsed header token mismatch: raw=%q valid=%v claims=%#v", token.Raw, token.Valid, token.Claims)
+	}
+}
+
+func TestParseFromRequestWithOAuth2ExtractorParsesAccessTokenArgument(t *testing.T) {
+
+
+	req := newRequest("GET", "/?access_token="+url.QueryEscape(mapClaimsToken), nil, "", "")
+
+	token, err := request.ParseFromRequest(req, request.OAuth2Extractor, keyFunc)
+	if err != nil {
+		t.Fatalf("ParseFromRequest OAuth2 argument error: %v", err)
+	}
+	want := jwt.MapClaims{"role": "admin", "sub": "alice"}
+	if token.Raw != mapClaimsToken || !token.Valid || !reflect.DeepEqual(token.Claims, want) {
+		t.Fatalf("parsed argument token mismatch: raw=%q valid=%v claims=%#v", token.Raw, token.Valid, token.Claims)
+	}
+}
+
+func TestParseFromRequestReturnsExtractorErrorUnchanged(t *testing.T) {
+
+
+	extractorErr := errors.New("extractor failed")
+	req := newRequest("GET", "/", nil, "", "")
+
+	token, err := request.ParseFromRequest(req, staticExtractor{"", extractorErr}, keyFunc)
+	if token != nil {
+		t.Fatalf("expected no token, got %#v", token)
+	}
+
+	if err != extractorErr {
+		t.Fatalf("error mismatch: got %v want %v", err, extractorErr)
+	}
+}
+
+func TestParseFromRequestReturnsNoTokenErrorAndNoTokenWhenExtractorMisses(t *testing.T) {
+
+
+	req := newRequest("GET", "/?token=query.token", nil, "", "")
+
+	token, err := request.ParseFromRequest(req, request.OAuth2Extractor, keyFunc)
+	if token != nil {
+		t.Fatalf("expected no token, got %#v", token)
+	}
+
+	if err != request.ErrNoTokenInRequest {
+		t.Fatalf("error mismatch: got %v want %v", err, request.ErrNoTokenInRequest)
+	}
+}
+
+func TestReferentialTransparencyForSameRequestInput(t *testing.T) {
+	req1 := newRequest("GET", "/", map[string]string{"Authorization": "Bearer abc.def.ghi"}, "", "")
+	req2 := newRequest("GET", "/", map[string]string{"Authorization": "Bearer abc.def.ghi"}, "", "")
+
+
+	first, firstErr := request.AuthorizationHeaderExtractor.ExtractToken(req1)
+	second, secondErr := request.AuthorizationHeaderExtractor.ExtractToken(req2)
+	if first != "abc.def.ghi" || firstErr != nil {
+		t.Fatalf("first extraction mismatch: got (%q,%v)", first, firstErr)
+	}
+	if second != "abc.def.ghi" || secondErr != nil {
+		t.Fatalf("second extraction mismatch: got (%q,%v)", second, secondErr)
+	}
+}
+
+func TestOAuth2ExtractorHeaderPrecedenceWithQueryPresent(t *testing.T) {
+	req := newRequest("GET", "/?access_token=query.token", map[string]string{"Authorization": "Bearer header.token"}, "", "")
+
+
+	assertExtract(t, request.OAuth2Extractor, req, "header.token", nil)
+}
+
+func TestNoGlobalStateAcrossExtractorNoise(t *testing.T) {
+	req := newRequest("GET", "/", map[string]string{"Authorization": "Bearer stable.token"}, "", "")
+	first, err := request.AuthorizationHeaderExtractor.ExtractToken(req)
+	if err != nil {
+		t.Fatalf("first extraction error: %v", err)
+	}
+
+	assertExtract(t, request.ArgumentExtractor{"token"}, newRequest("GET", "/?token=query.token", nil, "", ""), "query.token", nil)
+	assertExtract(t, request.HeaderExtractor{"X-Token"}, newRequest("GET", "/", map[string]string{"X-Token": "header.token"}, "", ""), "header.token", nil)
+
+	again, err := request.AuthorizationHeaderExtractor.ExtractToken(req)
+	if err != nil {
+		t.Fatalf("second extraction error: %v", err)
+	}
+	if again != first || again != "stable.token" {
+		t.Fatalf("stateful result mismatch: first %q again %q", first, again)
+	}
+}
+
+func TestAuthorizationHeaderExtractorMissReturnsSharedNoTokenError(t *testing.T) {
+	req := newRequest("GET", "/", map[string]string{"Authorization": "Bearer abc.def.ghi"}, "", "")
+	req.Header.Del("Authorization")
+
+
+	assertExtract(t, request.AuthorizationHeaderExtractor, req, "", request.ErrNoTokenInRequest)
+}
