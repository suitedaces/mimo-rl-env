+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+REPO=/workspace/repo
+GOPATH_DIR=/tmp/fixture-jwt-go-gopath
+PKG_DIR="$GOPATH_DIR/src/github.com/dgrijalva/jwt-go"
+
+mkdir -p "$(dirname "$PKG_DIR")"
+rm -f "$PKG_DIR"
+ln -s "$REPO" "$PKG_DIR"
+
+cd "$PKG_DIR"
+export GO111MODULE=off
+export GOPATH="$GOPATH_DIR"
+export GOPROXY=off
+export GOSUMDB=off
+export GOTOOLCHAIN=local
+
+exec go test -v ./usercase-test-coderl/...
