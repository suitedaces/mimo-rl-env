+func TestNewAliasServiceAndRepeatedDoAreIdempotent(t *testing.T) {
+
+
+	var bodies []string
+	client, cleanup := newAliasTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		data, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("ReadAll body: %v", err)
+		}
+		bodies = append(bodies, string(data))
+		w.Header().Set("Content-Type", "application/json")
+		fmt.Fprint(w, `{"acknowledged":false,"shards_acknowledged":true}`)
+	})
+	defer cleanup()
+
+	service := elastic.NewAliasService(client).Add("index1", "alias1")
+	first, err := service.Do(context.Background())
+	if err != nil {
+		t.Fatalf("first Do returned error: %v", err)
+	}
+	second, err := service.Do(context.Background())
+	if err != nil {
+		t.Fatalf("second Do returned error: %v", err)
+	}
+
+	if len(bodies) != 2 {
+		t.Fatalf("bodies length: want 2, got %d", len(bodies))
+	}
+
+	assertJSONEqual(t, "first body", bodies[0], `{"actions":[{"add":{"alias":"alias1","index":"index1"}}]}`)
+	assertJSONEqual(t, "second body", bodies[1], `{"actions":[{"add":{"alias":"alias1","index":"index1"}}]}`)
+	if first.Acknowledged != false {
+		t.Fatalf("first Acknowledged: want false, got %v", first.Acknowledged)
+	}
+	if first.ShardsAcknowledged != true {
+		t.Fatalf("first ShardsAcknowledged: want true, got %v", first.ShardsAcknowledged)
+	}
+	if first.Index != "" {
+		t.Fatalf("first Index: want empty string, got %q", first.Index)
+	}
+	if second.Acknowledged != false {
+		t.Fatalf("second Acknowledged: want false, got %v", second.Acknowledged)
+	}
+	if second.ShardsAcknowledged != true {
+		t.Fatalf("second ShardsAcknowledged: want true, got %v", second.ShardsAcknowledged)
+	}
+	if second.Index != "" {
+		t.Fatalf("second Index: want empty string, got %q", second.Index)
+	}
+	client.Stop()
+	client.Stop()
+}
