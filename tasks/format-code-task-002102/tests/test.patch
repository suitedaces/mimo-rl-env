+func TestAliasDoCyclesDoNotLeakFDsOrGoroutines(t *testing.T) {
+
+
+	runtime.GC()
+	startFDs := countFDs(t)
+	startGoroutines := runtime.NumGoroutine()
+
+	for i := 0; i < 150; i++ {
+		client, cleanup := newAliasTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+			if r.Method != "POST" {
+				t.Fatalf("method: want POST, got %s", r.Method)
+			}
+			if r.URL.Path != "/_aliases" {
+				t.Fatalf("path: want /_aliases, got %s", r.URL.Path)
+			}
+			if !strings.Contains(r.URL.RawQuery, "pretty=false") {
+				t.Fatalf("rawQuery: want pretty=false in %q", r.URL.RawQuery)
+			}
+			w.Header().Set("Content-Type", "application/json")
+			fmt.Fprint(w, `{"acknowledged":true,"shards_acknowledged":true}`)
+		})
+		result, err := client.Alias().Pretty(false).Add("index1", "alias1").Do(context.Background())
+		if err != nil {
+			cleanup()
+			t.Fatalf("cycle %d Do returned error: %v", i, err)
+		}
+		if result.Acknowledged != true {
+			cleanup()
+			t.Fatalf("cycle %d Acknowledged: want true, got %v", i, result.Acknowledged)
+		}
+		if result.ShardsAcknowledged != true {
+			cleanup()
+			t.Fatalf("cycle %d ShardsAcknowledged: want true, got %v", i, result.ShardsAcknowledged)
+		}
+		if result.Index != "" {
+			cleanup()
+			t.Fatalf("cycle %d Index: want empty string, got %q", i, result.Index)
+		}
+		cleanup()
+	}
+
+	runtime.GC()
+	endFDs := countFDs(t)
+	endGoroutines := runtime.NumGoroutine()
+	if endFDs > startFDs+10 {
+		t.Fatalf("fd count grew beyond bound: start %d, end %d", startFDs, endFDs)
+	}
+	if endGoroutines > startGoroutines+10 {
+		t.Fatalf("goroutine count grew beyond bound: start %d, end %d", startGoroutines, endGoroutines)
+	}
+}
