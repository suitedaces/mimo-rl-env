+func TestAliasServiceBatchesActionsQueryParamsHeadersAndDecodesResult(t *testing.T) {
+
+
+	var requestCount int
+	var method, path, rawQuery, body string
+	var traceHeader, replaceHeader, opaqueHeader string
+	client, cleanup := newAliasTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		requestCount++
+		method = r.Method
+		path = r.URL.Path
+		rawQuery = r.URL.RawQuery
+		traceHeader = r.Header.Get("X-Trace")
+		replaceHeader = r.Header.Get("X-Replace")
+		opaqueHeader = r.Header.Get("X-Opaque-Id")
+		data, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("ReadAll body: %v", err)
+		}
+		body = string(data)
+		w.Header().Set("Content-Type", "application/json")
+		fmt.Fprint(w, `{"acknowledged":true,"shards_acknowledged":false,"index":"index-returned"}`)
+	})
+	defer cleanup()
+
+	result, err := client.Alias().
+		Pretty(true).
+		Human(false).
+		ErrorTrace(true).
+		FilterPath("acknowledged", "index").
+		Headers(http.Header{
+			"X-Trace":   []string{"trace-1"},
+			"X-Replace": []string{"replace-1"},
+		}).
+
+		Header("X-Opaque-Id", "opaque-1").
+		Add("index1", "alias1").
+		AddWithFilter("index2", "alias2", elastic.NewTermQuery("user", "olivere")).
+		Remove("index3", "alias3").
+		Action(elastic.NewAliasRemoveIndexAction("index4")).
+		Do(context.Background())
+	if err != nil {
+		t.Fatalf("Do returned error: %v", err)
+	}
+
+	if requestCount != 1 {
+		t.Fatalf("requestCount: want 1, got %d", requestCount)
+	}
+	if method != "POST" {
+		t.Fatalf("method: want POST, got %s", method)
+	}
+	if path != "/_aliases" {
+		t.Fatalf("path: want /_aliases, got %s", path)
+	}
+	assertQueryEqual(t, rawQuery, url.Values{
+		"error_trace": []string{"true"},
+		"filter_path": []string{"acknowledged,index"},
+		"human":       []string{"false"},
+		"pretty":      []string{"true"},
+	})
+	if traceHeader != "trace-1" {
+		t.Fatalf("X-Trace: want trace-1, got %s", traceHeader)
+	}
+	if replaceHeader != "replace-1" {
+		t.Fatalf("X-Replace: want replace-1, got %s", replaceHeader)
+	}
+	if opaqueHeader != "opaque-1" {
+		t.Fatalf("X-Opaque-Id: want opaque-1, got %q", opaqueHeader)
+	}
+	wantBody := `{"actions":[{"add":{"alias":"alias1","index":"index1"}},{"add":{"alias":"alias2","filter":{"term":{"user":"olivere"}},"index":"index2"}},{"remove":{"alias":"alias3","index":"index3"}},{"remove_index":{"index":"index4"}}]}`
+
+	assertJSONEqual(t, "body", body, wantBody)
+	if result.Acknowledged != true {
+		t.Fatalf("Acknowledged: want true, got %v", result.Acknowledged)
+	}
+	if result.ShardsAcknowledged != false {
+		t.Fatalf("ShardsAcknowledged: want false, got %v", result.ShardsAcknowledged)
+	}
+	if result.Index != "index-returned" {
+		t.Fatalf("Index: want index-returned, got %q", result.Index)
+	}
+}
