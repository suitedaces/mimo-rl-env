+func TestAliasActionBuildersSourceLiterals(t *testing.T) {
+
+
+	cases := []struct {
+		name string
+		got  string
+		want string
+	}{
+		{
+			name: "add single index",
+			got:  mustMarshalAction(t, elastic.NewAliasAddAction("alias1").Index("index1")),
+			want: `{"add":{"alias":"alias1","index":"index1"}}`,
+		},
+		{
+			name: "add two indices",
+			got:  mustMarshalAction(t, elastic.NewAliasAddAction("alias1").Index("index1", "index2")),
+			want: `{"add":{"alias":"alias1","indices":["index1","index2"]}}`,
+		},
+		{
+			name: "add filter",
+			got:  mustMarshalAction(t, elastic.NewAliasAddAction("alias1").Index("index1").Filter(elastic.NewTermQuery("user", "olivere"))),
+			want: `{"add":{"alias":"alias1","filter":{"term":{"user":"olivere"}},"index":"index1"}}`,
+		},
+		{
+			name: "add routing fields",
+			got:  mustMarshalAction(t, elastic.NewAliasAddAction("alias1").Index("index1").Routing("routing1").IndexRouting("indexRouting1").SearchRouting("r1", "r2").IsWriteIndex(false)),
+			want: `{"add":{"alias":"alias1","index":"index1","index_routing":"indexRouting1","is_write_index":false,"routing":"routing1","search_routing":"r1,r2"}}`,
+		},
+		{
+			name: "remove single index",
+			got:  mustMarshalAction(t, elastic.NewAliasRemoveAction("alias1").Index("index1")),
+			want: `{"remove":{"alias":"alias1","index":"index1"}}`,
+		},
+		{
+			name: "remove two indices",
+			got:  mustMarshalAction(t, elastic.NewAliasRemoveAction("alias1").Index("index1", "index2")),
+			want: `{"remove":{"alias":"alias1","indices":["index1","index2"]}}`,
+		},
+		{
+			name: "remove index",
+			got:  mustMarshalAction(t, elastic.NewAliasRemoveIndexAction("index1")),
+			want: `{"remove_index":{"index":"index1"}}`,
+		},
+	}
+	for _, tc := range cases {
+
+		assertJSONEqual(t, tc.name, tc.got, tc.want)
+	}
+}
