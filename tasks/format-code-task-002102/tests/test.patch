+func TestAliasServicesKeepIndependentPendingBatches(t *testing.T) {
+
+
+	var bodies []string
+	client, cleanup := newAliasTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		data, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("ReadAll body: %v", err)
+		}
+		bodies = append(bodies, string(data))
+		w.Header().Set("Content-Type", "application/json")
+		fmt.Fprint(w, `{"acknowledged":true,"shards_acknowledged":true}`)
+	})
+	defer cleanup()
+
+	a := client.Alias().Add("a-index-1", "a-alias").Remove("a-index-2", "a-alias")
+	b := client.Alias().Add("b-index-1", "b-alias")
+	if _, err := a.Do(context.Background()); err != nil {
+		t.Fatalf("a.Do returned error: %v", err)
+	}
+	if _, err := b.Do(context.Background()); err != nil {
+		t.Fatalf("b.Do returned error: %v", err)
+	}
+
+	if len(bodies) != 2 {
+		t.Fatalf("bodies length: want 2, got %d", len(bodies))
+	}
+
+	assertJSONEqual(t, "service a body", bodies[0], `{"actions":[{"add":{"alias":"a-alias","index":"a-index-1"}},{"remove":{"alias":"a-alias","index":"a-index-2"}}]}`)
+	assertJSONEqual(t, "service b body", bodies[1], `{"actions":[{"add":{"alias":"b-alias","index":"b-index-1"}}]}`)
+}
