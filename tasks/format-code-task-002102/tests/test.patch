+func mustMarshalAction(t *testing.T, action elastic.AliasAction) string {
+	t.Helper()
+	src, err := action.Source()
+	if err != nil {
+		t.Fatalf("Source returned error: %v", err)
+	}
+	b, err := json.Marshal(src)
+	if err != nil {
+		t.Fatalf("marshal Source: %v", err)
+	}
+	return string(b)
+}
+
+func assertJSONEqual(t *testing.T, name string, got string, want string) {
+	t.Helper()
+	var gotValue interface{}
+	if err := json.Unmarshal([]byte(got), &gotValue); err != nil {
+		t.Fatalf("%s: got invalid JSON %q: %v", name, got, err)
+	}
+	var wantValue interface{}
+	if err := json.Unmarshal([]byte(want), &wantValue); err != nil {
+		t.Fatalf("%s: test wanted invalid JSON %q: %v", name, want, err)
+	}
+
+	if !reflect.DeepEqual(gotValue, wantValue) {
+		t.Fatalf("%s: want JSON %s, got %s", name, want, got)
+	}
+}
+
+func assertQueryEqual(t *testing.T, raw string, want url.Values) {
+	t.Helper()
+	got, err := url.ParseQuery(raw)
+	if err != nil {
+		t.Fatalf("rawQuery: invalid query %q: %v", raw, err)
+	}
+
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("rawQuery: want %v, got %v from %q", want, got, raw)
+	}
+}
+
+func countFDs(t *testing.T) int {
+	t.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		t.Fatalf("read /proc/self/fd: %v", err)
+	}
+	return len(entries)
+}
+
+func newAliasTestClient(t *testing.T, handler http.HandlerFunc) (*elastic.Client, func()) {
+	t.Helper()
+	ts := httptest.NewServer(handler)
+	client, err := elastic.NewSimpleClient(elastic.SetURL(ts.URL))
+	if err != nil {
+		ts.Close()
+		t.Fatalf("NewSimpleClient: %v", err)
+	}
+	return client, ts.Close
+}
