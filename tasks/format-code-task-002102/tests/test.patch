+func TestDoReturnsValidationErrorBeforeHTTPRequest(t *testing.T) {
+
+
+	var requestCount int
+	client, cleanup := newAliasTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		requestCount++
+		t.Fatalf("unexpected HTTP request %s %s", r.Method, r.URL.String())
+	})
+	defer cleanup()
+
+	result, err := client.Alias().Action(elastic.NewAliasAddAction("alias1")).Do(context.Background())
+	if result != nil {
+		t.Fatalf("result: want nil, got %#v", result)
+	}
+	if err == nil {
+		t.Fatal("expected concrete validation error, got nil")
+	}
+	if got := err.Error(); got != "missing required fields: [Index]" {
+		t.Fatalf("error: want %q, got %q", "missing required fields: [Index]", got)
+	}
+	if requestCount != 0 {
+		t.Fatalf("requestCount: want 0, got %d", requestCount)
+	}
+}
