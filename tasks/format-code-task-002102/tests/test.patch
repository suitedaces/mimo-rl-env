+func TestAliasActionValidationErrors(t *testing.T) {
+
+
+	cases := []struct {
+		name string
+		err  error
+		want string
+	}{
+		{
+			name: "add missing both",
+			err:  elastic.NewAliasAddAction("").Validate(),
+			want: "missing required fields: [Alias Index]",
+		},
+		{
+			name: "add missing index",
+			err:  elastic.NewAliasAddAction("alias1").Validate(),
+			want: "missing required fields: [Index]",
+		},
+		{
+			name: "add missing alias",
+			err:  elastic.NewAliasAddAction("").Index("index1").Validate(),
+			want: "missing required fields: [Alias]",
+		},
+		{
+			name: "add write index with two indices",
+			err:  elastic.NewAliasAddAction("alias1").Index("index1", "index2").IsWriteIndex(true).Validate(),
+			want: "is_write_index",
+		},
+		{
+			name: "remove missing both",
+			err:  elastic.NewAliasRemoveAction("").Validate(),
+			want: "missing required fields: [Alias Index]",
+		},
+		{
+			name: "remove missing index",
+			err:  elastic.NewAliasRemoveAction("alias1").Validate(),
+			want: "missing required fields: [Index]",
+		},
+		{
+			name: "remove index missing index",
+			err:  elastic.NewAliasRemoveIndexAction("").Validate(),
+			want: "missing required field: index",
+		},
+	}
+	for _, tc := range cases {
+		if tc.err == nil {
+			t.Fatalf("%s: expected concrete error %q, got nil", tc.name, tc.want)
+		}
+		got := tc.err.Error()
+		switch tc.name {
+		case "add missing both", "remove missing both":
+
+			if !strings.Contains(got, "Alias") || !strings.Contains(got, "Index") {
+				t.Fatalf("%s: want error mentioning Alias and Index, got %q", tc.name, got)
+			}
+		case "add write index with two indices":
+
+			lower := strings.ToLower(got)
+			if !strings.Contains(lower, "is_write_index") || !strings.Contains(lower, "index") || !(strings.Contains(lower, "more") || strings.Contains(lower, "multiple")) {
+				t.Fatalf("%s: want explanatory is_write_index/multiple-index error, got %q", tc.name, got)
+			}
+		default:
+			if got != tc.want {
+				t.Fatalf("%s: want %q, got %q", tc.name, tc.want, got)
+			}
+		}
+	}
+}
