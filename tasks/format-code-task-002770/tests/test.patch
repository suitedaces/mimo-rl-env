diff --git a/test/FindAndReplaceManager.test.js b/test/FindAndReplaceManager.test.js
new file mode 100644
index 00000000..0886c66e
--- /dev/null
+++ b/test/FindAndReplaceManager.test.js
@@ -0,0 +1,193 @@
+import './testGlobals'
+import { test } from 'substance-test'
+import { FindAndReplaceManager } from '../index'
+import setupTestArticleSession from './setupTestArticleSession'
+
+function setup (paragraphs) {
+  return setupTestArticleSession((doc) => {
+    let body = doc.find('body')
+    paragraphs.forEach(([id, content]) => {
+      body.append(doc.create({ type: 'p', id, content }))
+    })
+  })
+}
+
+test('FindAndReplaceManager: counts non-overlapping, case-insensitive matches', (t) => {
+  let { editorSession } = setup([['p1', 'Hello world hello WORLD']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('hello')
+  t.equal(m.getMatchCount(), 2, 'should find both "Hello" and "hello" case-insensitively')
+  t.end()
+})
+
+test('FindAndReplaceManager: non-overlapping occurrences', (t) => {
+  let { editorSession } = setup([['p1', 'aaaa']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('aa')
+  t.equal(m.getMatchCount(), 2, '"aa" in "aaaa" should match twice')
+  t.end()
+})
+
+test('FindAndReplaceManager: pattern is matched literally', (t) => {
+  let { editorSession } = setup([['p1', 'a.b axb a.b']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('a.b')
+  t.equal(m.getMatchCount(), 2, 'the "." should be matched literally, not as wildcard')
+  t.end()
+})
+
+test('FindAndReplaceManager: empty pattern yields no matches', (t) => {
+  let { editorSession } = setup([['p1', 'some text here']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('')
+  t.equal(m.getMatchCount(), 0, 'empty pattern matches nothing')
+  t.isNil(m.getCurrentMatch(), 'there is no current match')
+  t.end()
+})
+
+test('FindAndReplaceManager: case sensitivity option', (t) => {
+  let { editorSession } = setup([['p1', 'Hello hello HELLO']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('hello')
+  t.equal(m.getMatchCount(), 3, 'case-insensitive by default')
+  m.setCaseSensitive(true)
+  t.equal(m.getMatchCount(), 1, 'only the exact-case occurrence matches')
+  m.setCaseSensitive(false)
+  t.equal(m.getMatchCount(), 3, 'turning it off re-runs case-insensitively')
+  t.end()
+})
+
+test('FindAndReplaceManager: whole-word option', (t) => {
+  let { editorSession } = setup([['p1', 'foo foobar food foo']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('foo')
+  t.equal(m.getMatchCount(), 4, 'substring matches by default (incl. foobar, food)')
+  m.setWholeWord(true)
+  t.equal(m.getMatchCount(), 2, 'only the standalone "foo" words match')
+  m.setWholeWord(false)
+  t.equal(m.getMatchCount(), 4, 'turning it off re-runs as substring search')
+  t.end()
+})
+
+test('FindAndReplaceManager: current match starts at first in document order', (t) => {
+  let { editorSession } = setup([['p1', 'zzqq mid zzqq'], ['p2', 'zzqq']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('zzqq')
+  t.equal(m.getMatchCount(), 3, 'three matches across two paragraphs')
+  let cur = m.getCurrentMatch()
+  t.notNil(cur, 'there is a current match')
+  t.deepEqual(cur.path, ['p1', 'content'], 'current match is in the first paragraph')
+  t.equal(cur.start, 0, '.. at offset 0')
+  t.equal(cur.end, 4, '.. ending at offset 4 (exclusive)')
+  t.end()
+})
+
+test('FindAndReplaceManager: navigation cycles in document order with wraparound', (t) => {
+  let { editorSession } = setup([['p1', 'zzqq mid zzqq'], ['p2', 'zzqq']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('zzqq')
+
+  m.selectNext()
+  let cur = m.getCurrentMatch()
+  t.deepEqual([cur.path, cur.start], [['p1', 'content'], 9], 'next -> second match in p1')
+
+  m.selectNext()
+  cur = m.getCurrentMatch()
+  t.deepEqual([cur.path, cur.start], [['p2', 'content'], 0], 'next -> match in p2')
+
+  m.selectNext()
+  cur = m.getCurrentMatch()
+  t.deepEqual([cur.path, cur.start], [['p1', 'content'], 0], 'next wraps back to first')
+
+  m.selectPrevious()
+  cur = m.getCurrentMatch()
+  t.deepEqual([cur.path, cur.start], [['p2', 'content'], 0], 'previous from first wraps to last')
+  t.end()
+})
+
+test('FindAndReplaceManager: navigation with no matches is a no-op', (t) => {
+  let { editorSession } = setup([['p1', 'nothing to see']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('absent')
+  t.equal(m.getMatchCount(), 0, 'no matches')
+  m.selectNext()
+  m.selectPrevious()
+  t.isNil(m.getCurrentMatch(), 'still no current match')
+  t.end()
+})
+
+test('FindAndReplaceManager: replaceNext replaces current match and advances', (t) => {
+  let { editorSession, doc } = setup([['p1', 'zzqq mid zzqq'], ['p2', 'zzqq']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('zzqq')
+  m.setReplacePattern('X')
+  m.replaceNext()
+  t.equal(doc.get(['p1', 'content']), 'X mid zzqq', 'first occurrence replaced in the document')
+  t.equal(m.getMatchCount(), 2, 'one fewer match remains')
+  let cur = m.getCurrentMatch()
+  t.deepEqual(cur.path, ['p1', 'content'], 'current match advanced to the following occurrence')
+  t.equal(cur.start, 6, '.. at the new offset after the replacement')
+  t.end()
+})
+
+test('FindAndReplaceManager: replaceNext wraps current to first when last was replaced', (t) => {
+  let { editorSession, doc } = setup([['p1', 'zzqq'], ['p2', 'zzqq']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('zzqq')
+  m.setReplacePattern('X')
+  m.selectNext()
+  m.replaceNext()
+  t.equal(doc.get(['p2', 'content']), 'X', 'last occurrence replaced')
+  t.equal(m.getMatchCount(), 1, 'one match remains')
+  let cur = m.getCurrentMatch()
+  t.deepEqual([cur.path, cur.start], [['p1', 'content'], 0], 'current wrapped back to the first match')
+  t.end()
+})
+
+test('FindAndReplaceManager: replaceNext on the last remaining match clears the current match', (t) => {
+  let { editorSession, doc } = setup([['p1', 'only zzqq here']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('zzqq')
+  m.setReplacePattern('X')
+  m.replaceNext()
+  t.equal(doc.get(['p1', 'content']), 'only X here', 'occurrence replaced')
+  t.equal(m.getMatchCount(), 0, 'no matches remain')
+  t.isNil(m.getCurrentMatch(), 'no current match')
+  t.end()
+})
+
+test('FindAndReplaceManager: replaceNext without a current match does nothing', (t) => {
+  let { editorSession, doc } = setup([['p1', 'plain text']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('absent')
+  m.setReplacePattern('X')
+  m.replaceNext()
+  t.equal(doc.get(['p1', 'content']), 'plain text', 'document is unchanged')
+  t.equal(m.getMatchCount(), 0, 'still no matches')
+  t.end()
+})
+
+test('FindAndReplaceManager: replaceAll replaces every match', (t) => {
+  let { editorSession, doc } = setup([['p1', 'zzqq mid zzqq'], ['p2', 'foo zzqq']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('zzqq')
+  m.setReplacePattern('X')
+  m.replaceAll()
+  t.equal(doc.get(['p1', 'content']), 'X mid X', 'both occurrences in p1 replaced')
+  t.equal(doc.get(['p2', 'content']), 'foo X', 'occurrence in p2 replaced')
+  t.equal(m.getMatchCount(), 0, 'no matches remain')
+  t.isNil(m.getCurrentMatch(), 'no current match')
+  t.end()
+})
+
+test('FindAndReplaceManager: replacements participate in the edit/undo flow', (t) => {
+  let { editorSession, doc } = setup([['p1', 'zzqq here']])
+  let m = new FindAndReplaceManager(editorSession)
+  m.setSearchPattern('zzqq')
+  m.setReplacePattern('X')
+  m.replaceNext()
+  t.equal(doc.get(['p1', 'content']), 'X here', 'occurrence replaced')
+  editorSession.undo()
+  t.equal(doc.get(['p1', 'content']), 'zzqq here', 'undo restores the original text')
+  t.end()
+})
