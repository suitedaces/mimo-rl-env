+import os
+import re
+import shutil
+import tempfile
+
+import nibabel
+import numpy as np
+from nose.tools import assert_equal, assert_true
+from numpy.testing import assert_array_almost_equal
+
+from nilearn.decomposition.canica import CanICA
+from nilearn.decomposition.dict_learning import DictLearning
+
+
+def _make_decomposition_data(shape=(6, 7, 5, 8), n_subjects=4):
+    rng = np.random.RandomState(42)
+    affine = np.eye(4)
+    mask_data = np.zeros(shape[:3], dtype=np.int8)
+    mask_data[1:-1, 1:-1, 1:-1] = 1
+    mask_img = nibabel.Nifti1Image(mask_data, affine)
+
+    data = []
+    for subject in range(n_subjects):
+        this_data = 0.01 * rng.normal(size=shape)
+        time_courses = rng.normal(size=(3, shape[-1]))
+        this_data[1:3, 1:3, 1:3, :] += time_courses[0]
+        this_data[3:5, 2:5, 2:4, :] += time_courses[1]
+        this_data[2:5, 4:6, 1:3, :] -= time_courses[2]
+        this_data += 0.001 * subject
+        data.append(nibabel.Nifti1Image(this_data, affine))
+    return data, mask_img
+
+
+def _assert_components_img_matches_manual_unmask(estimator, data,
+                                                 n_components):
+    assert_true(hasattr(estimator, 'components_img_'))
+    components_img = estimator.components_img_
+    assert_true(hasattr(components_img, 'shape'))
+    assert_true(hasattr(components_img, 'to_filename'))
+
+    expected_shape = data[0].shape[:3] + (n_components,)
+    assert_equal(components_img.shape, expected_shape)
+
+    tmpdir = tempfile.mkdtemp()
+    try:
+        filename = os.path.join(tmpdir, 'components_img.nii.gz')
+        components_img.to_filename(filename)
+        assert_true(os.path.exists(filename))
+        assert_true(os.path.getsize(filename) > 0)
+    finally:
+        shutil.rmtree(tmpdir)
+
+    manual_img = estimator.masker_.inverse_transform(estimator.components_)
+    assert_array_almost_equal(components_img.get_data(),
+                              manual_img.get_data())
+
+
+def test_canica_components_img_matches_manual_unmask():
+    data, mask_img = _make_decomposition_data()
+    n_components = 3
+    canica = CanICA(n_components=n_components, mask=mask_img,
+                    random_state=0, smoothing_fwhm=0., n_init=3,
+                    threshold=None)
+    canica.fit(data)
+    _assert_components_img_matches_manual_unmask(canica, data,
+                                                 n_components)
+
+
+def test_dictlearning_components_img_matches_manual_unmask():
+    data, mask_img = _make_decomposition_data()
+    n_components = 2
+    dict_learning = DictLearning(n_components=n_components, mask=mask_img,
+                                 random_state=0, smoothing_fwhm=0.,
+                                 alpha=1, n_epochs=2)
+    dict_learning.fit(data)
+    _assert_components_img_matches_manual_unmask(dict_learning, data,
+                                                 n_components)
+
+
+def test_components_img_supports_alternate_valid_configurations():
+    data, mask_img = _make_decomposition_data()
+    estimators = [
+        (CanICA(n_components=2, mask=mask_img, random_state=0,
+                smoothing_fwhm=0., n_init=3, threshold='auto'), 2),
+        (DictLearning(n_components=3, mask=mask_img, random_state=0,
+                      smoothing_fwhm=0., alpha=2, n_epochs=2), 3),
+    ]
+    for estimator, n_components in estimators:
+        estimator.fit(data)
+        _assert_components_img_matches_manual_unmask(estimator, data,
+                                                     n_components)
+
+
+def test_components_array_remains_available_after_fit():
+    data, mask_img = _make_decomposition_data()
+    estimators = [
+        (CanICA(n_components=3, mask=mask_img, random_state=0,
+                smoothing_fwhm=0., n_init=3, threshold=None), 3),
+        (DictLearning(n_components=2, mask=mask_img, random_state=0,
+                      smoothing_fwhm=0., alpha=1, n_epochs=2), 2),
+    ]
+    for estimator, n_components in estimators:
+        estimator.fit(data)
+        assert_true(hasattr(estimator, 'components_'))
+        components = np.asarray(estimator.components_)
+        assert_equal(components.ndim, 2)
+        assert_equal(components.shape[0], n_components)
+
+
+def _fit_transform_result(estimator, data):
+    assert_true(callable(getattr(estimator, 'fit_transform', None)))
+    result = estimator.fit_transform(data)
+    assert_true(hasattr(estimator, 'components_img_'))
+    return np.asarray(result)
+
+
+def test_canica_fit_transform_matches_fit_then_transform():
+    data, mask_img = _make_decomposition_data()
+    params = dict(n_components=3, mask=mask_img, random_state=0,
+                  smoothing_fwhm=0., n_init=3, threshold=None)
+    fit_transform_output = _fit_transform_result(CanICA(**params), data)
+    separate = CanICA(**params)
+    separate.fit(data)
+    transform_output = np.asarray(separate.transform(data))
+    assert_equal(fit_transform_output.shape, transform_output.shape)
+    assert_array_almost_equal(fit_transform_output, transform_output)
+
+
+def test_dictlearning_fit_transform_matches_fit_then_transform():
+    data, mask_img = _make_decomposition_data()
+    params = dict(n_components=2, mask=mask_img, random_state=0,
+                  smoothing_fwhm=0., alpha=1, n_epochs=2)
+    fit_transform_output = _fit_transform_result(DictLearning(**params), data)
+    separate = DictLearning(**params)
+    separate.fit(data)
+    transform_output = np.asarray(separate.transform(data))
+    assert_equal(fit_transform_output.shape, transform_output.shape)
+    assert_array_almost_equal(fit_transform_output, transform_output)
+
+
+def _project_root():
+    return os.path.abspath(os.path.join(os.path.dirname(__file__),
+                                        os.pardir, os.pardir, os.pardir))
+
+
+def _read_existing_text(*parts):
+    path = os.path.join(_project_root(), *parts)
+    if not os.path.exists(path):
+        return ''
+    with open(path, 'r') as f:
+        return f.read()
+
+
+def _relevant_docs_text():
+    texts = [
+        CanICA.__doc__ or '',
+        DictLearning.__doc__ or '',
+        _read_existing_text('doc', 'whats_new.rst'),
+        _read_existing_text('doc', 'connectivity',
+                            'resting_state_networks.rst'),
+        _read_existing_text('examples', '03_connectivity',
+                            'plot_canica_resting_state.py'),
+        _read_existing_text('examples', '03_connectivity',
+                            'plot_compare_resting_state_decomposition.py'),
+        _read_existing_text('examples', '03_connectivity',
+                            'plot_extract_regions_dictlearning_maps.py'),
+    ]
+    return '\n'.join(texts).lower()
+
+
+def _workflow_docs_text():
+    texts = [
+        _read_existing_text('doc', 'connectivity',
+                            'resting_state_networks.rst'),
+        _read_existing_text('examples', '03_connectivity',
+                            'plot_canica_resting_state.py'),
+        _read_existing_text('examples', '03_connectivity',
+                            'plot_compare_resting_state_decomposition.py'),
+        _read_existing_text('examples', '03_connectivity',
+                            'plot_extract_regions_dictlearning_maps.py'),
+    ]
+    return '\n'.join(texts).lower()
+
+
+def _assert_docs_explain_components_img_migration(text):
+    text = text.lower()
+    assert_true('components_img_' in text)
+    assert_true('components_' in text)
+    assert_true('older' in text)
+    assert_true(any(word in text for word in
+                    ['unmask', 'inverse_transform', 'inverse transform']))
+
+
+def test_decomposition_docs_describe_components_img_and_legacy_components():
+    _assert_docs_explain_components_img_migration(_relevant_docs_text())
+    _assert_docs_explain_components_img_migration(_workflow_docs_text())
+
+
+def test_connectivity_examples_use_components_img_for_current_workflow():
+    example_paths = [
+        ('examples', '03_connectivity', 'plot_canica_resting_state.py'),
+        ('examples', '03_connectivity',
+         'plot_compare_resting_state_decomposition.py'),
+        ('examples', '03_connectivity',
+         'plot_extract_regions_dictlearning_maps.py'),
+    ]
+    old_assignment = re.compile(
+        r'=\s*[^\n#]*\.masker_\.inverse_transform\([^\n]*\.components_')
+    for path_parts in example_paths:
+        text = _read_existing_text(*path_parts)
+        if not text:
+            continue
+        assert_true('.components_img_' in text)
+        assert_true(old_assignment.search(text) is None)
