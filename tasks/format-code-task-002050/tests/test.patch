+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+case "${1:-}" in
+  base)
+    python3 -m pytest \
+      nilearn/decomposition/tests/test_base.py::test_fast_svd \
+      nilearn/decomposition/tests/test_base.py::test_mask_reducer \
+      nilearn/decomposition/tests/test_canica.py \
+      nilearn/decomposition/tests/test_dict_learning.py \
+      nilearn/decomposition/tests/test_multi_pca.py \
+      -q
+    ;;
+  new)
+    python3 -m pytest nilearn/decomposition/tests/test_components_img_api.py -q
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
