diff --git a/tests/cupy_tests/sparse_tests/test_csc.py b/tests/cupy_tests/sparse_tests/test_csc.py
index 356430d61..a13845c24 100644
--- a/tests/cupy_tests/sparse_tests/test_csc.py
+++ b/tests/cupy_tests/sparse_tests/test_csc.py
@@ -1,3 +1,6 @@
+import os
+import subprocess
+import sys
 import unittest
 
 import numpy
@@ -229,6 +232,40 @@ class TestCscMatrixInit(unittest.TestCase):
                 shape=self.shape, dtype='i')
 
 
+class TestCscMatrixShapeInit(unittest.TestCase):
+
+    def test_init_with_shape_variants(self):
+        for shape in ((2, 3), (0, 4), (10, 20)):
+            s = cupy.sparse.csc_matrix(shape)
+            self.assertEqual(s.shape, shape)
+            self.assertEqual(s.dtype, numpy.float64)
+            self.assertEqual(s.nnz, 0)
+
+    def test_init_with_shape_and_dtype_variants(self):
+        for shape, dtype in (
+                ((3, 1), 'f'),
+                ((3, 1), numpy.float64),
+                ((4, 5), numpy.float32)):
+            s = cupy.sparse.csc_matrix(shape, dtype=dtype)
+            self.assertEqual(s.shape, shape)
+            self.assertEqual(s.dtype, numpy.dtype(dtype))
+            self.assertEqual(s.nnz, 0)
+
+    def test_shape_constructor_outside_pytest_env(self):
+        env = os.environ.copy()
+        env.pop('PYTEST_CURRENT_TEST', None)
+        code = (
+            'import cupy.sparse; '
+            's = cupy.sparse.csc_matrix((6, 7)); '
+            'assert s.shape == (6, 7); '
+            'assert s.nnz == 0')
+        subprocess.check_call([sys.executable, '-c', code], env=env)
+
+    def test_doc_mentions_shape_constructor_form(self):
+        self.assertIn('csc_matrix((M, N), [dtype])',
+                      cupy.sparse.csc_matrix.__doc__)
+
+
 @testing.parameterize(*testing.product({
     'dtype': [numpy.float32, numpy.float64],
 }))
