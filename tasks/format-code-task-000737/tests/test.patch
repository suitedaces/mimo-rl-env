diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,39 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+
+ensure_built() {
+  if python3 - <<'PY' >/dev/null 2>&1
+import cupy  # noqa: F401
+PY
+  then
+    return 0
+  fi
+  python3 setup.py --cupy-no-cuda build_ext --inplace
+}
+
+case "${1:-}" in
+  base)
+    ensure_built &&
+    python3 - <<'PY'
+import cupy.sparse
+assert cupy.sparse.csr_matrix is not None
+assert cupy.sparse.csc_matrix is not None
+PY
+    ;;
+  new)
+    ensure_built &&
+    python3 -m pytest \
+      tests/cupy_tests/sparse_tests/test_csr.py \
+      tests/cupy_tests/sparse_tests/test_csc.py \
+      -k "test_init_with_shape_variants or test_init_with_shape_and_dtype_variants or test_shape_constructor_outside_pytest_env or test_doc_mentions_shape_constructor_form" \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
