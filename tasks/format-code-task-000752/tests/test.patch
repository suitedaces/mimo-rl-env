+class GuardedMemmap(np.memmap):
+    def __array__(self, dtype=None, copy=None):
+        raise AssertionError("tokenization attempted to materialize the memmap")
+
+    def __reduce__(self):
+        raise AssertionError("tokenization attempted to pickle the memmap")
+
+    def __reduce_ex__(self, protocol):
+        raise AssertionError("tokenization attempted to pickle the memmap")
+
+    def tobytes(self, *args, **kwargs):
+        raise AssertionError("tokenization attempted to read the full memmap")
+
+    def __iter__(self):
+        raise AssertionError("tokenization attempted to iterate over the memmap")
+
+
+def test_tokenize_memmap_does_not_hash_contents(tmp_path):
+    from dask.base import tokenize
+
+    path = tmp_path / "large.dat"
+    data = np.arange(4096, dtype=np.int64)
+    data.tofile(os.fspath(path))
+    mm = np.memmap(path, dtype=data.dtype, mode="r", shape=data.shape)
+
+    token = tokenize(mm)
+
+    assert token == tokenize(mm)
+
+
+def test_tokenize_writable_memmap_does_not_use_object_fallback(tmp_path):
+    from dask.base import tokenize
+
+    path = tmp_path / "writable.dat"
+    data = np.arange(32, dtype=np.int64)
+    data.tofile(os.fspath(path))
+    mm = np.memmap(path, dtype=data.dtype, mode="r+", shape=data.shape).view(
+        GuardedMemmap
+    )
+
+    token = tokenize(mm)
+
+    assert token == tokenize(mm)
+
+
+def test_tokenize_larger_memmap_does_not_use_object_fallback(tmp_path):
+    from dask.base import tokenize
+
+    path = tmp_path / "larger.dat"
+    data = np.arange(8192, dtype=np.int64)
+    data.tofile(os.fspath(path))
+    mm = np.memmap(path, dtype=data.dtype, mode="r", shape=data.shape)
+
+    token = tokenize(mm)
+
+    assert token == tokenize(mm)
+
+
+def test_tokenize_non_tmp_memmap_does_not_use_object_fallback(tmp_path):
+    from dask.base import tokenize
+
+    path = tmp_path / f"{uuid.uuid4().hex}.dat"
+    np.arange(64, dtype=np.int64).tofile(os.fspath(path))
+    mm = np.memmap(path, dtype=np.int64, mode="r", shape=(64,)).view(GuardedMemmap)
+
+    token = tokenize(mm)
+
+    assert token == tokenize(mm)
+
+
+def test_from_array_memmap_graph_build_does_not_materialize_contents(
+    tmp_path
+):
+    import dask.array as da
+
+    path = tmp_path / "array.dat"
+    data = np.arange(4096, dtype=np.int64).reshape(512, 8)
+    data.tofile(os.fspath(path))
+    mm = np.memmap(path, dtype=data.dtype, mode="r", shape=data.shape)
+
+    arr = da.from_array(mm, chunks=(128, 8))
+
+    assert arr.shape == mm.shape
+    assert arr.chunks == ((128, 128, 128, 128), (8,))
+
+
+def test_memmap_token_uses_backing_metadata_and_is_stable(tmp_path):
+    from dask.base import tokenize
+
+    path = tmp_path / "stable.npy"
+    data = np.arange(32, dtype=np.int64)
+    np.save(path, data)
+
+    first = np.load(path, mmap_mode="r")
+    second = np.load(path, mmap_mode="r")
+
+    assert tokenize(first) == tokenize(second)
+
+    before = tokenize(first)
+    os.utime(path, (2_000_000_000, 2_000_000_000))
+    after = tokenize(np.load(path, mmap_mode="r"))
+
+    assert before != after
+
+
+def test_memmap_token_distinguishes_views_or_offsets(tmp_path):
+    from dask.base import tokenize
+
+    path = tmp_path / "offsets.dat"
+    np.zeros(32, dtype=np.uint8).tofile(os.fspath(path))
+
+    first = np.memmap(path, dtype=np.uint8, mode="r", offset=0, shape=(8,))
+    same_first = np.memmap(path, dtype=np.uint8, mode="r", offset=0, shape=(8,))
+    shifted = np.memmap(path, dtype=np.uint8, mode="r", offset=8, shape=(8,))
+
+    assert tokenize(first) == tokenize(same_first)
+    assert tokenize(first) != tokenize(shifted)
+
+
+def test_memmap_token_distinguishes_dtype_metadata(tmp_path):
+    from dask.base import tokenize
+
+    path = tmp_path / "dtype.dat"
+    np.zeros(16, dtype=np.uint8).tofile(os.fspath(path))
+
+    unsigned = np.memmap(path, dtype=np.uint8, mode="r", shape=(8,))
+    signed = np.memmap(path, dtype=np.int8, mode="r", shape=(8,))
+
+    assert unsigned.shape == signed.shape
+    assert unsigned.strides == signed.strides
+    assert tokenize(unsigned) != tokenize(signed)
+
