+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const workerConstructions = vi.hoisted(() => [] as Array<{ orchestratorUrl: string; groupKey: string; maxConcurrency: number }>);
+const workerStarts = vi.hoisted(() => [] as string[]);
+
+vi.mock('./processor.worker.js', () => {
+    return {
+        ProcessorWorker: class ProcessorWorker {
+            private readonly groupKey: string;
+
+            constructor(options: { orchestratorUrl: string; groupKey: string; maxConcurrency: number }) {
+                this.groupKey = options.groupKey;
+                workerConstructions.push(options);
+            }
+
+            start() {
+                workerStarts.push(this.groupKey);
+            }
+        }
+    };
+});
+
+import { Processor } from './processor.js';
+
+const taskFamilyKeys = ['sync', 'action', 'webhook', 'on-event'] as const;
+
+function matchesGroupKeyPattern(pattern: string, value: string): boolean {
+    const parts = pattern.split('*');
+    if (parts.length === 1) {
+        return pattern === value;
+    }
+
+    let cursor = 0;
+    const first = parts[0] ?? '';
+    if (first && !value.startsWith(first)) {
+        return false;
+    }
+    cursor = first.length;
+
+    for (const part of parts.slice(1, -1)) {
+        const next = value.indexOf(part, cursor);
+        if (next === -1) {
+            return false;
+        }
+        cursor = next + part.length;
+    }
+
+    const last = parts[parts.length - 1] ?? '';
+    if (!last) {
+        return true;
+    }
+
+    const next = value.indexOf(last, cursor);
+    return next !== -1 && next + last.length === value.length;
+}
+
+describe('Processor', () => {
+    beforeEach(() => {
+        workerConstructions.length = 0;
+        workerStarts.length = 0;
+    });
+
+    it('default task-family workers request partitioned group keys', () => {
+        const processor = new Processor('http://orchestrator.test');
+
+        processor.start();
+
+        expect(workerStarts).toEqual(workerConstructions.map((worker) => worker.groupKey));
+        expect(workerConstructions).toHaveLength(taskFamilyKeys.length);
+
+        const requestedGroupKeys = workerConstructions.map((worker) => worker.groupKey);
+        expect(new Set(requestedGroupKeys).size).toBe(requestedGroupKeys.length);
+
+        for (const family of taskFamilyKeys) {
+            const matchingPatterns = requestedGroupKeys.filter((groupKey) => {
+                return matchesGroupKeyPattern(groupKey, family) && matchesGroupKeyPattern(groupKey, `${family}:tenantA`);
+            });
+
+            expect(matchingPatterns).toHaveLength(1);
+            expect(matchingPatterns[0]).not.toBe('*');
+            expect(matchesGroupKeyPattern(matchingPatterns[0]!, `other-${family}:tenantA`)).toBe(false);
+        }
+    });
+});
