@@ -0,0 +1,24 @@
+import { describe, expect, it } from 'vitest';
+import { ProcessorWorker } from './processor.worker.js';
+
+describe('ProcessorWorker constructor options', () => {
+    it('accepts custom group key strings in constructor options', () => {
+        const customGroupKey = 'tenant-specific-custom-key';
+        const customPattern = `${customGroupKey}*`;
+
+        const patternOptions = {
+            orchestratorUrl: 'http://orchestrator.test',
+            groupKey: customPattern,
+            maxConcurrency: 1
+        } satisfies ConstructorParameters<typeof ProcessorWorker>[0];
+
+        const customOptions = {
+            orchestratorUrl: 'http://orchestrator.test',
+            groupKey: customGroupKey,
+            maxConcurrency: 1
+        } satisfies ConstructorParameters<typeof ProcessorWorker>[0];
+
+        expect(patternOptions.groupKey).toBe(customPattern);
+        expect(customOptions.groupKey).toBe(customGroupKey);
+    });
+});
