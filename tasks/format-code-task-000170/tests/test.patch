+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+if [ ! -d node_modules/vitest ]; then
+    npm ci
+fi
+if [ ! -d packages/utils/dist ]; then
+    fixturea_type_test_backup=""
+    if [ -f packages/jobs/lib/processor/processor.worker.types.test.ts ]; then
+        fixturea_type_test_backup="$(mktemp /tmp/fixturea-type-test.XXXXXX.ts)"
+        mv packages/jobs/lib/processor/processor.worker.types.test.ts "$fixturea_type_test_backup"
+    fi
+    npm run ts-build
+    if [ -n "$fixturea_type_test_backup" ]; then
+        mv "$fixturea_type_test_backup" packages/jobs/lib/processor/processor.worker.types.test.ts
+    fi
+fi
+
+pg_isready -h localhost -p 5432 || pg_ctlcluster 16 main start
+
+export NANGO_DB_USER=postgres
+export NANGO_DB_PASSWORD=nango_test
+export NANGO_DB_HOST=localhost
+export NANGO_DB_PORT=5432
+export NANGO_DB_NAME=postgres
+
+
+mkdir -p .build_env
+if [ ! -f .build_env/setup.ts ]; then
+    cat > .build_env/setup.ts <<'SETUP'
+export async function setup() {
+    process.env['NANGO_DB_PASSWORD'] = 'nango_test';
+    process.env['NANGO_DB_HOST'] = 'localhost';
+    process.env['NANGO_DB_USER'] = 'postgres';
+    process.env['NANGO_DB_PORT'] = '5432';
+    process.env['NANGO_DB_NAME'] = 'postgres';
+    process.env['RECORDS_DATABASE_URL'] = `postgres://postgres:nango_test@localhost:5432/postgres`;
+}
+
+export const teardown = async () => {};
+SETUP
+fi
+
+if [ ! -f .build_env/vite.integration.config.ts ]; then
+    cat > .build_env/vite.integration.config.ts <<'VITECONFIG'
+/// <reference types="vitest" />
+import { defineConfig } from 'vitest/config';
+
+process.env.TZ = 'UTC';
+
+export default defineConfig({
+    test: {
+        include: ['**/*.integration.{test,spec}.?(c|m)[jt]s?(x)'],
+        globalSetup: './.build_env/setup.ts',
+        setupFiles: './tests/setupFiles.ts',
+        testTimeout: 20000,
+        env: {
+            NANGO_ENCRYPTION_KEY: 'RzV4ZGo5RlFKMm0wYWlXdDhxTFhwb3ZrUG5KNGg3TmU=',
+            NANGO_LOGS_ENABLED: 'false',
+            FLAG_PLAN_ENABLED: 'true',
+            ORCHESTRATOR_SERVICE_URL: 'http://orchestrator'
+        },
+        fileParallelism: false,
+        pool: 'forks',
+        poolOptions: {
+            forks: {
+                singleFork: true
+            }
+        }
+    }
+});
+VITECONFIG
+fi
+
+cat > .build_env/tsconfig.fixturea.json <<'TSCONFIG'
+{
+  "extends": "../packages/jobs/tsconfig.json",
+  "compilerOptions": {
+    "noEmit": true,
+    "rootDir": "../packages/jobs/lib"
+  },
+  "include": [
+    "../packages/jobs/lib/**/*"
+  ]
+}
+TSCONFIG
+
+case "${1:-}" in
+    base)
+        npx vitest run --config .build_env/vite.integration.config.ts packages/scheduler/lib/models/tasks.integration.test.ts
+        ;;
+    new)
+        npx vitest run --config .build_env/vite.integration.config.ts \
+            packages/scheduler/lib/models/tasks.integration.test.ts \
+            packages/jobs/lib/processor/processor.integration.test.ts \
+            packages/jobs/lib/processor/processor.worker.types.test.ts &&
+        npx tsc --project .build_env/tsconfig.fixturea.json --noEmit
+        ;;
+    *)
+        echo "usage: $0 base|new"
+        exit 2
+        ;;
+esac
