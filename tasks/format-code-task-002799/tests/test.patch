+++ b/usercase-test-coderl/scroll_events.test.js
@@ -0,0 +1,376 @@
+import { mount } from '@vue/test-utils'
+import VirtualList from '../src/index'
+
+global.ResizeObserver = class {
+  observe () {}
+  disconnect () {}
+}
+
+const Item = {
+  name: 'acceptance-item',
+  props: {
+    index: Number,
+    source: Object
+  },
+  render (h) {
+    return h('div', `${this.index}:${this.source.id}`)
+  }
+}
+
+const makeItems = (count) => Array.from({ length: count }, (_, index) => ({
+  id: String(index),
+  text: `row-${index}`
+}))
+
+const setScrollGeometry = (el, { offset, clientSize, scrollSize, horizontal = false }) => {
+  const offsetKey = horizontal ? 'scrollLeft' : 'scrollTop'
+  const clientKey = horizontal ? 'clientWidth' : 'clientHeight'
+  const scrollKey = horizontal ? 'scrollWidth' : 'scrollHeight'
+
+  Object.defineProperty(el, offsetKey, {
+    configurable: true,
+    get () {
+      return offset
+    },
+    set (value) {
+      offset = value
+    }
+  })
+  Object.defineProperty(el, clientKey, {
+    configurable: true,
+    get () {
+      return clientSize
+    }
+  })
+  Object.defineProperty(el, scrollKey, {
+    configurable: true,
+    get () {
+      return scrollSize
+    }
+  })
+}
+
+const fireScroll = (wrapper, offset, options = {}) => {
+  const el = wrapper.vm.$el
+  setScrollGeometry(el, {
+    offset,
+    clientSize: options.clientSize === undefined ? 100 : options.clientSize,
+    scrollSize: options.scrollSize === undefined ? 400 : options.scrollSize,
+    horizontal: options.horizontal || false
+  })
+  const evt = new Event('scroll')
+  el.dispatchEvent(evt)
+  return evt
+}
+
+const snapshotRange = (range) => ({
+  start: range.start,
+  end: range.end,
+  padFront: range.padFront,
+  padBehind: range.padBehind
+})
+
+const expectRangePayload = (wrapper, range) => {
+
+  expect(range).toEqual(expect.objectContaining({
+    start: expect.any(Number),
+    end: expect.any(Number),
+    padFront: expect.any(Number),
+    padBehind: expect.any(Number)
+  }))
+  expect(snapshotRange(range)).toEqual(snapshotRange(wrapper.vm.range))
+}
+
+const mountList = (props = {}) => mount(VirtualList, {
+  propsData: {
+    dataKey: 'id',
+    dataSources: makeItems(20),
+    dataComponent: Item,
+    keeps: 5,
+    estimateSize: 20,
+    ...props
+  }
+})
+
+describe('usercase scroll events and edge thresholds', () => {
+  test('scroll event carries the original event and the updated vertical range', () => {
+
+
+    const wrapper = mountList()
+    const seen = []
+    wrapper.vm.$on('scroll', (evt, range) => {
+      seen.push({ evt, range: snapshotRange(range) })
+    })
+
+    const initialRange = snapshotRange(wrapper.vm.range)
+    const evt = fireScroll(wrapper, 80)
+
+    expect(seen.length).toBe(1)
+    expect(seen[0].evt).toBe(evt)
+    expectRangePayload(wrapper, seen[0].range)
+
+    expect(seen[0].range).not.toEqual(initialRange)
+
+    wrapper.destroy()
+  })
+
+  test('top threshold emits only while scrolling toward the front of a non-empty list', () => {
+
+
+    const wrapper = mountList({ topThreshold: 15, bottomThreshold: 20 })
+    const scrolls = []
+    const topPayloads = []
+    const bottomPayloads = []
+    wrapper.vm.$on('scroll', (evt, range) => {
+      scrolls.push({ evt, range: snapshotRange(range) })
+    })
+    wrapper.vm.$on('totop', (...payload) => {
+      topPayloads.push(payload)
+    })
+    wrapper.vm.$on('tobottom', (...payload) => {
+      bottomPayloads.push(payload)
+    })
+
+    const firstEvt = fireScroll(wrapper, 80)
+    expect(scrolls.length).toBe(1)
+    expect(scrolls[0].evt).toBe(firstEvt)
+    expectRangePayload(wrapper, scrolls[0].range)
+    expect(topPayloads.length).toBe(0)
+    expect(bottomPayloads.length).toBe(0)
+
+    const secondEvt = fireScroll(wrapper, 10)
+    expect(scrolls.length).toBe(2)
+    expect(scrolls[1].evt).toBe(secondEvt)
+    expectRangePayload(wrapper, scrolls[1].range)
+
+    expect(topPayloads.length).toBe(1)
+    expect(topPayloads[0].length).toBe(0)
+    expect(bottomPayloads.length).toBe(0)
+
+    wrapper.destroy()
+  })
+
+  test('bottom threshold emits only while scrolling toward the end', () => {
+
+
+    const wrapper = mountList({ topThreshold: 15, bottomThreshold: 20 })
+    const scrolls = []
+    const topPayloads = []
+    const bottomPayloads = []
+    wrapper.vm.$on('scroll', (evt, range) => {
+      scrolls.push({ evt, range: snapshotRange(range) })
+    })
+    wrapper.vm.$on('totop', (...payload) => {
+      topPayloads.push(payload)
+    })
+    wrapper.vm.$on('tobottom', (...payload) => {
+      bottomPayloads.push(payload)
+    })
+
+    const evt = fireScroll(wrapper, 280)
+
+    expect(scrolls.length).toBe(1)
+    expect(scrolls[0].evt).toBe(evt)
+    expectRangePayload(wrapper, scrolls[0].range)
+    expect(topPayloads.length).toBe(0)
+
+    expect(bottomPayloads.length).toBe(1)
+    expect(bottomPayloads[0].length).toBe(0)
+
+    wrapper.destroy()
+  })
+
+  test('direction gates edge notifications even when threshold math is satisfied', () => {
+
+
+    const nearTop = mountList({ topThreshold: 15 })
+    const nearTopScrolls = []
+    const nearTopPayloads = []
+    nearTop.vm.$on('scroll', (evt, range) => {
+      nearTopScrolls.push({ evt, range: snapshotRange(range) })
+    })
+    nearTop.vm.$on('totop', (...payload) => {
+      nearTopPayloads.push(payload)
+    })
+
+    const nearTopEvt = fireScroll(nearTop, 10)
+
+    expect(nearTopScrolls.length).toBe(1)
+    expect(nearTopScrolls[0].evt).toBe(nearTopEvt)
+    expectRangePayload(nearTop, nearTopScrolls[0].range)
+
+    expect(nearTopPayloads.length).toBe(0)
+    nearTop.destroy()
+
+    const nearBottom = mountList({ bottomThreshold: 20 })
+    const nearBottomScrolls = []
+    const bottomPayloads = []
+    nearBottom.vm.$on('scroll', (evt, range) => {
+      nearBottomScrolls.push({ evt, range: snapshotRange(range) })
+    })
+    nearBottom.vm.$on('tobottom', (...payload) => {
+      bottomPayloads.push(payload)
+    })
+
+    fireScroll(nearBottom, 300)
+    nearBottomScrolls.splice(0, nearBottomScrolls.length)
+    bottomPayloads.splice(0, bottomPayloads.length)
+    const nearBottomEvt = fireScroll(nearBottom, 299)
+
+    expect(nearBottomScrolls.length).toBe(1)
+    expect(nearBottomScrolls[0].evt).toBe(nearBottomEvt)
+    expectRangePayload(nearBottom, nearBottomScrolls[0].range)
+
+    expect(bottomPayloads.length).toBe(0)
+    nearBottom.destroy()
+  })
+
+  test('threshold props default to zero and exact-edge scrolls use those defaults', () => {
+
+
+    const wrapper = mountList()
+    const edgeEvents = []
+    wrapper.vm.$on('totop', (...payload) => {
+      edgeEvents.push(['totop', payload.length])
+    })
+    wrapper.vm.$on('tobottom', (...payload) => {
+      edgeEvents.push(['tobottom', payload.length])
+    })
+
+    expect(wrapper.vm.topThreshold).toBe(0)
+    expect(wrapper.vm.bottomThreshold).toBe(0)
+    fireScroll(wrapper, 0)
+    fireScroll(wrapper, 300)
+
+    expect(edgeEvents).toEqual([
+      ['totop', 0],
+      ['tobottom', 0]
+    ])
+
+    wrapper.destroy()
+  })
+
+  test('empty lists still report scroll range but do not emit edge notifications', () => {
+
+
+    const wrapper = mountList({ dataSources: [] })
+    const events = []
+    wrapper.vm.$on('scroll', (evt, range) => {
+      events.push(['scroll', snapshotRange(range)])
+    })
+    wrapper.vm.$on('totop', (...payload) => {
+      events.push(['totop', payload.length])
+    })
+    wrapper.vm.$on('tobottom', (...payload) => {
+      events.push(['tobottom', payload.length])
+    })
+
+    fireScroll(wrapper, 0)
+
+    expect(events.length).toBe(1)
+    expect(events[0][0]).toBe('scroll')
+    expectRangePayload(wrapper, events[0][1])
+
+    expect(events.filter(([name]) => name === 'totop' || name === 'tobottom')).toEqual([])
+
+    wrapper.destroy()
+  })
+
+  test('invalid scroll positions do not emit position or edge events', () => {
+
+
+    const wrapper = mountList({ topThreshold: 15, bottomThreshold: 20 })
+    const events = []
+    wrapper.vm.$on('scroll', () => {
+      events.push('scroll')
+    })
+    wrapper.vm.$on('totop', () => {
+      events.push('totop')
+    })
+    wrapper.vm.$on('tobottom', () => {
+      events.push('tobottom')
+    })
+
+    fireScroll(wrapper, -1)
+    fireScroll(wrapper, 302, { clientSize: 100, scrollSize: 400 })
+    fireScroll(wrapper, 0, { clientSize: 100, scrollSize: 0 })
+
+    expect(events).toEqual([])
+
+    wrapper.destroy()
+  })
+
+  test('two mounted instances keep independent ranges and event streams', () => {
+
+
+    const first = mountList()
+    const second = mountList({ bottomThreshold: 20 })
+    const firstEvents = []
+    const secondScrolls = []
+    const secondBottomPayloads = []
+    first.vm.$on('scroll', (evt, range) => {
+      firstEvents.push({ evt, range: snapshotRange(range) })
+    })
+    second.vm.$on('scroll', (evt, range) => {
+      secondScrolls.push({ evt, range: snapshotRange(range) })
+    })
+    second.vm.$on('tobottom', (...payload) => {
+      secondBottomPayloads.push(payload)
+    })
+
+    const firstEvt = fireScroll(first, 80)
+    const secondEvt = fireScroll(second, 280)
+
+    expect(firstEvents.length).toBe(1)
+    expect(firstEvents[0].evt).toBe(firstEvt)
+    expectRangePayload(first, firstEvents[0].range)
+    expect(secondScrolls.length).toBe(1)
+    expect(secondScrolls[0].evt).toBe(secondEvt)
+    expectRangePayload(second, secondScrolls[0].range)
+
+    expect(secondBottomPayloads.length).toBe(1)
+    expect(secondBottomPayloads[0].length).toBe(0)
+    expect(firstEvents[0].range).not.toEqual(secondScrolls[0].range)
+
+    first.destroy()
+    second.destroy()
+  })
+
+  test('component exposes scroll payload before ordinary cleanup', () => {
+
+
+    const wrapper = mountList()
+    const scrolls = []
+    wrapper.vm.$on('scroll', (evt, range) => {
+      scrolls.push({ evt, range: snapshotRange(range) })
+    })
+
+    const evt = fireScroll(wrapper, 80)
+
+    expect(scrolls.length).toBe(1)
+    expect(scrolls[0].evt).toBe(evt)
+
+    expectRangePayload(wrapper, scrolls[0].range)
+    wrapper.destroy()
+  })
+
+  test('repeated mounted instances expose independent scroll payloads', () => {
+
+
+    for (let index = 0; index < 3; index++) {
+      const wrapper = mountList()
+      const scrolls = []
+      wrapper.vm.$on('scroll', (evt, range) => {
+        scrolls.push({ evt, range: snapshotRange(range) })
+      })
+
+      const evt = fireScroll(wrapper, 80 + index)
+
+      expect(scrolls.length).toBe(1)
+      expect(scrolls[0].evt).toBe(evt)
+
+      expectRangePayload(wrapper, scrolls[0].range)
+      wrapper.destroy()
+    }
+  })
+})
