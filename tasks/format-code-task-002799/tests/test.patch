+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+export BROWSERSLIST_IGNORE_OLD_DATA=1
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+if [ ! -x /workspace/repo/node_modules/.bin/jest ]; then
+  echo "Missing local Jest install at /workspace/repo/node_modules/.bin/jest" >&2
+  exit 127
+fi
+
+exec /workspace/repo/node_modules/.bin/jest /workspace/repo/usercase-test-coderl/scroll_events.test.js --runInBand
