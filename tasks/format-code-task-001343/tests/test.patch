+  def test_flatten_dict_sep_string_keys(self):
+    cases = (
+        (('left',), 1, '/'),
+        (('outer', 'inner'), 2, '.'),
+        (('root', 'branch', 'leaf'), 3, ':'),
+    )
+    for path, value, sep in cases:
+      with self.subTest(path=path, sep=sep):
+        nested = value
+        for key in reversed(path):
+          nested = {key: nested}
+
+        flat = traverse_util.flatten_dict(nested, sep=sep)
+
+        self.assertLen(flat, 1)
+        flat_key, flat_value = next(iter(flat.items()))
+        self.assertEqual(flat_value, value)
+        self.assertIsInstance(flat_key, str)
+        self.assertEqual(flat_key.split(sep), list(path))
+
+    nested = {'left': {'right': 4}}
+    tuple_key, = traverse_util.flatten_dict(nested).keys()
+    self.assertEqual(tuple_key, ('left', 'right'))
+
+  def test_unflatten_dict_sep_string_keys(self):
+    cases = (
+        (('left',), 1, '/'),
+        (('outer', 'inner'), 2, '.'),
+        (('root', 'branch', 'leaf'), 3, ':'),
+    )
+    for path, value, sep in cases:
+      with self.subTest(path=path, sep=sep):
+        flat_key = sep.join(path)
+        unflattened = traverse_util.unflatten_dict({flat_key: value}, sep=sep)
+        cursor = unflattened
+        for key in path[:-1]:
+          self.assertIsInstance(cursor, dict)
+          cursor = cursor[key]
+        self.assertEqual(cursor[path[-1]], value)
+
+        round_trip = traverse_util.flatten_dict(unflattened, sep=sep)
+        self.assertEqual(round_trip, {flat_key: value})
+
+    self.assertEqual(
+        traverse_util.unflatten_dict({('left', 'right'): 4}),
+        {'left': {'right': 4}})
+
