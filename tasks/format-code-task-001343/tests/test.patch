+++ b/mimo_test_command.sh
@@ -0,0 +1,42 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set +u
+source /testbed/.build_env/.venv/bin/activate
+set -u
+
+pip install -e /testbed --no-deps -q 2>/dev/null || true
+
+LAXNUMPY=$(python -c "import jax._src.numpy.lax_numpy as m; print(m.__file__)")
+if ! grep -q "from jax._src.numpy.setops import isin" "$LAXNUMPY"; then
+  echo '
+# Compatibility shim: isin was moved to jax._src.numpy.setops
+from jax._src.numpy.setops import isin
+' >> "$LAXNUMPY"
+fi
+
+
+case "${1:-}" in
+  base)
+    python -m pytest \
+      tests/traverse_util_test.py::TraversalTest::test_flatten_dict \
+      tests/traverse_util_test.py::TraversalTest::test_unflatten_dict \
+      tests/traverse_util_test.py::TraversalTest::test_flatten_dict_keep_empty \
+      tests/traverse_util_test.py::TraversalTest::test_flatten_dict_is_leaf \
+      tests/traverse_util_test.py::ModelParamTraversalTest \
+      -v -o "filterwarnings="
+    ;;
+  new)
+    python -m pytest \
+      tests/traverse_util_test.py::TraversalTest::test_flatten_dict_sep_string_keys \
+      tests/traverse_util_test.py::TraversalTest::test_unflatten_dict_sep_string_keys \
+      tests/docs_update_test.py \
+      -v -o "filterwarnings="
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
