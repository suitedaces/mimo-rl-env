+func (l *fixtureFakeLibvirtConnection) addFakeImage(name string) {
+	layerName := virter.LayerVolumePrefix + "sha256:fixture-base-layer"
+	l.pools[fixturePoolName].vols[layerName] = fixtureStorageVol(layerName, nil, []byte("base image\n"))
+	l.pools[fixturePoolName].vols[virter.TagVolumePrefix+name] = fixtureStorageVol(
+		virter.TagVolumePrefix+name,
+		&lx.StorageVolumeBackingStore{Path: "./" + layerName, Format: &lx.StorageVolumeTargetFormat{Type: "qcow2"}},
+		nil,
+	)
+}
+
+func fixtureDomainXML(name string, active bool) *lx.Domain {
+	return &lx.Domain{
+		Name: name,
+		Devices: &lx.DomainDeviceList{
+			Disks: []lx.DomainDisk{
+				{
+					Device: "disk",
+					Driver: &lx.DomainDiskDriver{Name: "qemu", Type: "qcow2"},
+					Source: &lx.DomainDiskSource{Volume: &lx.DomainDiskSourceVolume{Pool: fixturePoolName, Volume: virter.DynamicLayerName(name)}},
+					Target: &lx.DomainDiskTarget{Dev: "vda", Bus: "virtio"},
+				},
+				{
+					Device: "cdrom",
+					Driver: &lx.DomainDiskDriver{Name: "qemu", Type: "raw"},
+					Source: &lx.DomainDiskSource{Volume: &lx.DomainDiskSourceVolume{Pool: fixturePoolName, Volume: virter.DynamicLayerName(name + "-cidata")}},
+					Target: &lx.DomainDiskTarget{Dev: "sda", Bus: "scsi"},
+				},
+			},
+			Interfaces: []lx.DomainInterface{{
+				MAC:    &lx.DomainInterfaceMAC{Address: fixtureVMMAC},
+				Source: &lx.DomainInterfaceSource{Network: &lx.DomainInterfaceSourceNetwork{Network: fixtureNetworkName}},
+			}},
+		},
+	}
+}
