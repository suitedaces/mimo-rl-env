+func fixtureStorageVol(name string, backing *lx.StorageVolumeBackingStore, content []byte) *fixtureFakeStorageVol {
+	return &fixtureFakeStorageVol{
+		description: &lx.StorageVolume{
+			Name:         name,
+			Key:          "/fixture/" + name,
+			Capacity:     &lx.StorageVolumeSize{Value: uint64(len(content)), Unit: "bytes"},
+			Physical:     &lx.StorageVolumeSize{Value: uint64(len(content)), Unit: "bytes"},
+			Target:       &lx.StorageVolumeTarget{Format: &lx.StorageVolumeTargetFormat{Type: "qcow2"}},
+			BackingStore: backing,
+		},
+		content: append([]byte(nil), content...),
+	}
+}
