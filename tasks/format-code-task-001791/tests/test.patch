+func (l *fixtureFakeLibvirtConnection) committedImage(t *testing.T, v *virter.Virter, name string) *virter.LocalImage {
+	t.Helper()
+	pool, err := l.StoragePoolLookupByName(fixturePoolName)
+	if err != nil {
+		t.Fatalf("StoragePoolLookupByName: %v", err)
+	}
+	img, err := v.FindImage(name, pool)
+	if err != nil {
+		t.Fatalf("FindImage(%q): %v", name, err)
+	}
+	if img == nil {
+		t.Fatalf("FindImage(%q) = nil", name)
+	}
+	return img
+}
