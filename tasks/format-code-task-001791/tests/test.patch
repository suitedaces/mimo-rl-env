+func (l *fixtureFakeLibvirtConnection) StorageVolCreateXML(pool libvirt.StoragePool, xml string, _ libvirt.StorageVolCreateFlags) (libvirt.StorageVol, error) {
+	p, ok := l.pools[pool.Name]
+	if !ok {
+		return libvirt.StorageVol{}, fixtureLibvirtError(libvirt.ErrNoStoragePool, "missing pool")
+	}
+	var desc lx.StorageVolume
+	if err := desc.Unmarshal(xml); err != nil {
+		return libvirt.StorageVol{}, err
+	}
+	desc.Key = "/fixture/" + desc.Name
+	if desc.Physical == nil {
+		desc.Physical = &lx.StorageVolumeSize{Value: desc.Capacity.Value, Unit: "bytes"}
+	}
+	p.vols[desc.Name] = &fixtureFakeStorageVol{description: &desc}
+	return libvirt.StorageVol{Pool: pool.Name, Name: desc.Name, Key: desc.Key}, nil
