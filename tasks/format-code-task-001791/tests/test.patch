+	img := l.committedImage(t, v, fixtureCustomImage)
+	if got, want := img.Name(), fixtureCustomImage; got != want {
+		t.Fatalf("image name = %q; want %q", got, want)
+	}
+	pool, _ := l.StoragePoolLookupByName(fixturePoolName)
+	defaultName, err := v.FindImage(fixtureVMName, pool)
+	if err != nil {
+		t.Fatalf("FindImage(%q): %v", fixtureVMName, err)
+	}
+	if defaultName != nil {
