new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,119 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+( cd /workspace/repo && make virter ) || { echo "FAIL: build" >&2; exit 1; }
+BIN=/workspace/repo/virter
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"; rm -f /workspace/repo/internal/virter/fixture_vm_commit_acceptance_test.go' EXIT
+cd "$TMP" || exit 1
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+write_config() {
+  local dir="$1"
+  cat >"$dir/virter.toml" <<EOF
+[auth]
+virter_public_key_path = "$dir/id_rsa.pub"
+virter_private_key_path = "$dir/id_rsa"
+EOF
+}
+
+
+
+
+HOME="$TMP/home-help" "$BIN" vm commit --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+
+grep -Fq "commit vm-name [image-name]" out || fail "F1 missing commit usage"
+grep -Fq -- "--reset-machine-id" out || fail "F1 missing --reset-machine-id flag"
+grep -Fq -- "--shutdown" out || fail "F1 missing --shutdown flag"
+
+
+
+
+mkdir -p "$TMP/missing"
+write_config "$TMP/missing"
+HOME="$TMP/missing" "$BIN" --config "$TMP/missing/virter.toml" --logformat short vm commit >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F2 exit 0; want non-zero"
+[ ! -s out ] || fail "F2 unexpected stdout: $(cat out)"
+
+grep -Eiq "arg|usage|vm-name" err || fail "F2 missing argument error"
+
+
+
+
+mkdir -p "$TMP/too-many"
+write_config "$TMP/too-many"
+HOME="$TMP/too-many" "$BIN" --config "$TMP/too-many/virter.toml" --logformat short vm commit alpha beta gamma >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F3 exit 0; want non-zero"
+[ ! -s out ] || fail "F3 unexpected stdout: $(cat out)"
+
+grep -Eiq "arg|usage|vm-name" err || fail "F3 missing argument error"
+
+
+
+
+mkdir -p "$TMP/one-arg"
+write_config "$TMP/one-arg"
+HOME="$TMP/one-arg" "$BIN" --config "$TMP/one-arg/virter.toml" --logformat short vm commit demo-vm >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F4 expected non-zero without libvirt in fixture environment"
+[ ! -s out ] || fail "F4 unexpected stdout: $(cat out)"
+
+[ -s err ] || fail "F4 expected stderr from attempted commit"
+
+
+
+
+mkdir -p "$TMP/two-args"
+write_config "$TMP/two-args"
+HOME="$TMP/two-args" "$BIN" --config "$TMP/two-args/virter.toml" --logformat short vm commit demo-vm committed-image --shutdown=false --reset-machine-id=false >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F5 expected non-zero without libvirt in fixture environment"
+[ ! -s out ] || fail "F5 unexpected stdout: $(cat out)"
+
+[ -s err ] || fail "F5 expected stderr from attempted commit"
+
+cp /workspace/repo/usercase-test-coderl/fixtures/fixture_vm_commit_acceptance_test.go /workspace/repo/internal/virter/fixture_vm_commit_acceptance_test.go
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+go_test_out="$TMP/go-test.out"
+( cd /workspace/repo && go test ./internal/virter -run 'TestFixtureAcceptance' -count=1 -v ) >"$go_test_out" 2>&1; ec=$?
+[ "$ec" -eq 0 ] || fail "F6-F12 go test exit $ec; output: $(cat "$go_test_out")"
+grep -Fq -- "--- PASS: TestFixtureAcceptanceCommitStoppedDefaultImageName" "$go_test_out" || fail "F6 did not run/pass"
+grep -Fq -- "--- PASS: TestFixtureAcceptanceCommitExplicitImageName" "$go_test_out" || fail "F7 did not run/pass"
+grep -Fq -- "--- PASS: TestFixtureAcceptanceRunningShutdownFalseError" "$go_test_out" || fail "F8 did not run/pass"
+grep -Fq -- "--- PASS: TestFixtureAcceptanceRunningShutdownTimeoutError" "$go_test_out" || fail "F9 did not run/pass"
+grep -Fq -- "--- PASS: TestFixtureAcceptanceRunningShutdownSuccess" "$go_test_out" || fail "F10 did not run/pass"
+grep -Fq -- "--- PASS: TestFixtureAcceptanceResetMachineIDStoppedError" "$go_test_out" || fail "F11 did not run/pass"
+grep -Fq -- "--- PASS: TestFixtureAcceptanceMissingRootLayerError" "$go_test_out" || fail "F12 did not run/pass"
+
+echo "PASS"
+exit 0
