+func TestFixtureAcceptanceCommitStoppedDefaultImageName(t *testing.T) {
+	l, v := fixtureCommitVM(t, false, true)
+
+	err := v.VMCommit(context.Background(), fixtureNeverTimeout{}, fixtureVMName, virter.CommitConfig{
+		ImageName:       fixtureVMName,
+		Shutdown:        true,
+		ShutdownTimeout: time.Second,
+		ResetMachineID:  false,
+	}, false)
+	if err != nil {
+		t.Fatalf("VMCommit returned error: %v", err)
+	}
+
+	img := l.committedImage(t, v, fixtureVMName)
+	if got, want := img.Name(), fixtureVMName; got != want {
+		t.Fatalf("image name = %q; want %q", got, want)
+	}
+
+	if top := img.TopLayer(); top == nil || !strings.HasPrefix(top.Name(), virter.LayerVolumePrefix) {
+		t.Fatalf("top layer = %v; want local immutable layer", top)
+	}
+	if got := string(l.pools[fixturePoolName].vols[img.TopLayer().Name()].content); got != fixtureLayerContent {
+		t.Fatalf("committed layer content = %q; want preserved root content", got)
+	}
+	if _, ok := l.pools[fixturePoolName].vols[virter.DynamicLayerName(fixtureVMName)]; ok {
+		t.Fatalf("root boot volume was not converted away from dynamic layer")
+	}
+	if _, err := l.DomainLookupByName(fixtureVMName); err == nil {
+		t.Fatalf("domain %q still exists after commit", fixtureVMName)
+	}
+
+	imgs, err := v.ImageList()
+	if err != nil {
+		t.Fatalf("ImageList: %v", err)
+	}
+	found := false
+	for _, listed := range imgs {
+		if listed.Name() == fixtureVMName {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("ImageList did not include committed image %q", fixtureVMName)
+	}
+}
