+func fixtureCommitVM(t *testing.T, active bool, withRoot bool) (*fixtureFakeLibvirtConnection, *virter.Virter) {
+	t.Helper()
+
+	l := newFixtureFakeLibvirtConnection()
+	l.addFakeImage(fixtureBaseImage)
+	l.domains[fixtureVMName] = &fixtureFakeDomain{
+		description:   fixtureDomainXML(fixtureVMName, active),
+		active:        active,
+		persistent:    true,
+		shutdownStops: true,
+	}
+	if withRoot {
+		l.pools[fixturePoolName].vols[virter.DynamicLayerName(fixtureVMName)] = fixtureStorageVol(
+			virter.DynamicLayerName(fixtureVMName),
+			&lx.StorageVolumeBackingStore{Path: "./" + virter.LayerVolumePrefix + "sha256:fixture-base-layer", Format: &lx.StorageVolumeTargetFormat{Type: "qcow2"}},
+			[]byte(fixtureLayerContent),
+		)
+	}
+	l.pools[fixturePoolName].vols[virter.DynamicLayerName(fixtureVMName+"-cidata")] = fixtureStorageVol(virter.DynamicLayerName(fixtureVMName+"-cidata"), nil, nil)
+
+	return l, virter.New(l, fixturePoolName, fixtureNetworkName, fixtureFakeKeyStore{})
+}
