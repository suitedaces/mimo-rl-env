+func (l *fixtureFakeLibvirtConnection) NetworkUpdate(net libvirt.Network, command, section uint32, _ int32, xml string, _ libvirt.NetworkUpdateFlags) error {
+	desc, ok := l.networks[net.Name]
+	if !ok {
+		return fixtureLibvirtError(libvirt.ErrNoNetwork, "missing network")
+	}
+	if command != uint32(libvirt.NetworkUpdateCommandDelete) || section != uint32(libvirt.NetworkSectionIPDhcpHost) {
+		return nil
+	}
+	for ipIdx := range desc.IPs {
+		if desc.IPs[ipIdx].DHCP == nil {
+			continue
+		}
+		hosts := desc.IPs[ipIdx].DHCP.Hosts
+		for hostIdx, host := range hosts {
+			if strings.Contains(xml, host.MAC) && strings.Contains(xml, host.IP) {
+				desc.IPs[ipIdx].DHCP.Hosts = append(hosts[:hostIdx], hosts[hostIdx+1:]...)
+				return nil
+			}
+		}
+	}
+	return nil
+}
