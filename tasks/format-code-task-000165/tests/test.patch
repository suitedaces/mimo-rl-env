@@ -0,0 +1,20 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+dev-switch go 1.23
+
+
+case "${1:-}" in
+  base)
+    go test ./archive/tar ./archive/gzip -count=1
+    ;;
+  new)
+    go test ./archive -run 'Test(Zstd|Documentation)' -count=1 -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
