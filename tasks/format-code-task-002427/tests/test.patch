diff --git a/mypy/test/testdaemoninstalltypes.py b/mypy/test/testdaemoninstalltypes.py
new file mode 100644
index 000000000..32755aeed
--- /dev/null
+++ b/mypy/test/testdaemoninstalltypes.py
@@ -0,0 +1,98 @@
+
+
+
+
+
+
+
+import os
+import tempfile
+
+import mypy.build
+from mypy.errors import CompileError
+from mypy.modulefinder import BuildSource
+from mypy.options import Options
+from mypy.test.helpers import Suite
+
+
+INSTALL_TYPES_HINT = 'mypy --install-types'
+PIP_HINT_PREFIX = 'Hint: "python3 -m pip install types-requests"'
+DOC_LINK_FRAGMENT = 'mypy.readthedocs.io'
+LIBRARY_STUBS_NOT_INSTALLED = 'Library stubs not installed for "requests"'
+
+
+def _run_build(tmpdir: str, fine_grained_incremental: bool):
+    src = os.path.join(tmpdir, 't.py')
+    with open(src, 'w') as f:
+        f.write('import requests\n')
+    options = Options()
+    options.cache_dir = os.devnull
+    options.show_traceback = True
+    if fine_grained_incremental:
+        options.incremental = True
+        options.fine_grained_incremental = True
+    sources = [BuildSource(src, 't', None)]
+    try:
+        result = mypy.build.build(sources=sources, options=options)
+        return list(result.errors)
+    except CompileError as e:
+        return list(e.messages)
+
+
+class DaemonInstallTypesHintSuite(Suite):
+
+    def test_non_daemon_includes_install_types_hint(self) -> None:
+
+        with tempfile.TemporaryDirectory() as td:
+            errors = _run_build(td, fine_grained_incremental=False)
+        joined = '\n'.join(errors)
+        assert INSTALL_TYPES_HINT in joined, (
+            'Expected install-types hint in non-daemon output:\n' + joined
+        )
+
+    def test_daemon_omits_install_types_hint(self) -> None:
+
+        with tempfile.TemporaryDirectory() as td:
+            errors = _run_build(td, fine_grained_incremental=True)
+        joined = '\n'.join(errors)
+        assert INSTALL_TYPES_HINT not in joined, (
+            'install-types hint must be suppressed in daemon mode:\n' + joined
+        )
+
+    def test_daemon_still_reports_library_stub_error(self) -> None:
+
+        with tempfile.TemporaryDirectory() as td:
+            errors = _run_build(td, fine_grained_incremental=True)
+        joined = '\n'.join(errors)
+        assert LIBRARY_STUBS_NOT_INSTALLED in joined, (
+            'Expected library stubs not installed error in daemon output:\n'
+            + joined
+        )
+
+    def test_daemon_still_includes_pip_install_hint(self) -> None:
+
+        with tempfile.TemporaryDirectory() as td:
+            errors = _run_build(td, fine_grained_incremental=True)
+        joined = '\n'.join(errors)
+        assert PIP_HINT_PREFIX in joined, (
+            'Expected pip install hint in daemon output:\n' + joined
+        )
+
+    def test_daemon_still_includes_doc_link(self) -> None:
+
+        with tempfile.TemporaryDirectory() as td:
+            errors = _run_build(td, fine_grained_incremental=True)
+        joined = '\n'.join(errors)
+        assert DOC_LINK_FRAGMENT in joined, (
+            'Expected docs link in daemon output:\n' + joined
+        )
+
+    def test_non_daemon_includes_all_three_notes(self) -> None:
+
+        with tempfile.TemporaryDirectory() as td:
+            errors = _run_build(td, fine_grained_incremental=False)
+        joined = '\n'.join(errors)
+        assert PIP_HINT_PREFIX in joined
+        assert INSTALL_TYPES_HINT in joined
+        assert DOC_LINK_FRAGMENT in joined
+        assert LIBRARY_STUBS_NOT_INSTALLED in joined
