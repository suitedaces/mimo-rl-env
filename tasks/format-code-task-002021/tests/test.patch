+
+
+import asyncio
+
+from textual.app import App
+
+from src.cell import SplitTextArea
+from src.notebook import CodeCell, MarkdownCell, Notebook
+
+
+class _TermApp:
+    def change_tab_name(self, *args):
+        pass
+
+    def remove_tab(self, *args):
+        pass
+
+
+class _NotebookHarness(App):
+    CSS = ""
+
+    def __init__(self, notebook_count: int = 1):
+        super().__init__()
+        self.notebooks = [
+            Notebook(f"erys_notebook{index + 1}", id=f"nb{index + 1}", term_app=_TermApp())
+            for index in range(notebook_count)
+        ]
+
+    def compose(self):
+        yield from self.notebooks
+
+
+def _cell_summary(notebook):
+    return [
+        (type(cell).__name__, cell.input_text.text)
+        for cell in notebook.cell_container.children
+    ]
+
+
+def _binding_parts(binding):
+    if isinstance(binding, tuple):
+        return binding[:3]
+    return (
+        getattr(binding, "key", None),
+        getattr(binding, "action", None),
+        getattr(binding, "description", None),
+    )
+
+
+def test_split_text_area_exposes_action_and_binding():
+
+
+
+
+
+    assert ("ctrl+backslash", "split_cell", "Split Cell") in [
+        _binding_parts(binding) for binding in SplitTextArea.BINDINGS
+    ]
+    assert callable(getattr(SplitTextArea, "action_split_cell", None))
+
+
+def test_code_cell_split_before_middle_line_mounts_and_links_inserted_cell():
+
+
+
+
+
+    async def run():
+        app = _NotebookHarness()
+        async with app.run_test() as pilot:
+            notebook = app.notebooks[0]
+            await pilot.pause()
+            first = await notebook.add_cell(
+                CodeCell, None, "after", source="alpha\nbeta\ngamma"
+            )
+            following = await notebook.add_cell(
+                CodeCell, first, "after", source="omega"
+            )
+            notebook.last_focused = first
+            await pilot.pause()
+
+            assert _cell_summary(notebook) == [
+                ("CodeCell", "alpha\nbeta\ngamma"),
+                ("CodeCell", "omega"),
+            ]
+            assert (
+                first.prev is None,
+                first.next is following,
+                following.prev is first,
+                following.next is None,
+            ) == (True, True, True, True)
+
+            first.input_text.cursor_location = (1, 0)
+            assert first.input_text.action_split_cell() is None
+            await pilot.pause()
+
+            cells = list(notebook.cell_container.children)
+            inserted = cells[1]
+            assert _cell_summary(notebook) == [
+                ("CodeCell", "alpha\n"),
+                ("CodeCell", "beta\ngamma"),
+                ("CodeCell", "omega"),
+            ]
+            assert [cell.notebook is notebook for cell in cells] == [True, True, True]
+            assert (
+                first.prev is None,
+                first.next is inserted,
+                inserted.prev is first,
+                inserted.next is following,
+                following.prev is inserted,
+                following.next is None,
+            ) == (True, True, True, True, True, True)
+
+    asyncio.run(run())
+
+
+def test_code_cell_split_at_start_moves_all_text_to_new_code_cell():
+
+
+
+
+
+    async def run():
+        app = _NotebookHarness()
+        async with app.run_test() as pilot:
+            notebook = app.notebooks[0]
+            await pilot.pause()
+            cell = await notebook.add_cell(CodeCell, None, "after", source="print(1)")
+            notebook.last_focused = cell
+            await pilot.pause()
+
+            assert _cell_summary(notebook) == [("CodeCell", "print(1)")]
+            cell.input_text.cursor_location = (0, 0)
+            assert cell.input_text.action_split_cell() is None
+            await pilot.pause()
+
+            assert _cell_summary(notebook) == [
+                ("CodeCell", ""),
+                ("CodeCell", "print(1)"),
+            ]
+            assert [new_cell.notebook is notebook for new_cell in notebook.cell_container.children] == [
+                True,
+                True,
+            ]
+
+    asyncio.run(run())
+
+
+def test_markdown_cell_split_at_end_keeps_text_and_inserts_empty_markdown_cell():
+
+
+
+
+
+    async def run():
+        app = _NotebookHarness()
+        async with app.run_test() as pilot:
+            notebook = app.notebooks[0]
+            await pilot.pause()
+            cell = await notebook.add_cell(MarkdownCell, None, "after", source="# title")
+            notebook.last_focused = cell
+            await pilot.pause()
+
+            assert _cell_summary(notebook) == [("MarkdownCell", "# title")]
+            cell.input_text.cursor_location = (0, 7)
+            assert cell.input_text.action_split_cell() is None
+            await pilot.pause()
+
+            assert _cell_summary(notebook) == [
+                ("MarkdownCell", "# title"),
+                ("MarkdownCell", ""),
+            ]
+            assert [new_cell.notebook is notebook for new_cell in notebook.cell_container.children] == [
+                True,
+                True,
+            ]
+
+    asyncio.run(run())
+
+
+def test_ctrl_backslash_invokes_split_cell_in_live_notebook_session():
+
+
+
+
+
+    async def run():
+        app = _NotebookHarness()
+        async with app.run_test() as pilot:
+            notebook = app.notebooks[0]
+            await pilot.pause()
+            cell = await notebook.add_cell(CodeCell, None, "after", source="alpha\nbeta")
+            notebook.last_focused = cell
+            cell.input_text.focus()
+            cell.input_text.cursor_location = (1, 0)
+            await pilot.pause()
+
+
+            await pilot.press("ctrl+backslash")
+            await pilot.pause()
+
+            assert _cell_summary(notebook) == [
+                ("CodeCell", "alpha\n"),
+                ("CodeCell", "beta"),
+            ]
+
+    asyncio.run(run())
+
+
+def test_deleting_inserted_cell_relinks_original_to_following_cell():
+
+
+
+
+
+    async def run():
+        app = _NotebookHarness()
+        async with app.run_test() as pilot:
+            notebook = app.notebooks[0]
+            await pilot.pause()
+            first = await notebook.add_cell(CodeCell, None, "after", source="alpha\nbeta")
+            following = await notebook.add_cell(CodeCell, first, "after", source="omega")
+            notebook.last_focused = first
+            first.input_text.cursor_location = (1, 0)
+            assert first.input_text.action_split_cell() is None
+            await pilot.pause()
+
+            inserted = list(notebook.cell_container.children)[1]
+            assert inserted.prev is first
+            assert inserted.next is following
+
+            notebook.last_focused = inserted
+            notebook.delete_cell()
+            await pilot.pause()
+
+            assert _cell_summary(notebook) == [
+                ("CodeCell", "alpha\n"),
+                ("CodeCell", "omega"),
+            ]
+            assert first.next is following
+            assert following.prev is first
+    asyncio.run(run())
+
+
+def test_splitting_one_notebook_does_not_mutate_another_notebook():
+
+
+
+
+
+    async def run():
+        app = _NotebookHarness(notebook_count=2)
+        async with app.run_test() as pilot:
+            notebook_a, notebook_b = app.notebooks
+            await pilot.pause()
+            cell_a = await notebook_a.add_cell(CodeCell, None, "after", source="left\nright")
+            await notebook_b.add_cell(MarkdownCell, None, "after", source="solo")
+            notebook_a.last_focused = cell_a
+            await pilot.pause()
+
+            assert _cell_summary(notebook_a) == [("CodeCell", "left\nright")]
+            assert _cell_summary(notebook_b) == [("MarkdownCell", "solo")]
+            cell_a.input_text.cursor_location = (1, 0)
+            assert cell_a.input_text.action_split_cell() is None
+            await pilot.pause()
+
+            assert _cell_summary(notebook_a) == [
+                ("CodeCell", "left\n"),
+                ("CodeCell", "right"),
+            ]
+            assert _cell_summary(notebook_b) == [("MarkdownCell", "solo")]
+            assert [cell.notebook is notebook_a for cell in notebook_a.cell_container.children] == [
+                True,
+                True,
+            ]
+            assert [cell.notebook is notebook_b for cell in notebook_b.cell_container.children] == [
+                True,
+            ]
+
+    asyncio.run(run())
+
+
+def test_repeated_splits_insert_each_new_cell_directly_after_source_cell():
+
+
+
+
+
+    async def run():
+        app = _NotebookHarness(notebook_count=3)
+        async with app.run_test() as pilot:
+            await pilot.pause()
+
+            for index, (cell_type, source, cursor, expected_original, expected_inserted) in enumerate([
+
+                (CodeCell, "one\ntwo\nthree", (1, 0), "one\n", "two\nthree"),
+                (MarkdownCell, "# heading\nbody", (1, 0), "# heading\n", "body"),
+                (CodeCell, "tail", (0, 0), "", "tail"),
+            ]):
+                notebook = app.notebooks[index]
+                cell = await notebook.add_cell(cell_type, None, "after", source=source)
+                following = await notebook.add_cell(
+                    cell_type, cell, "after", source=f"after {index}"
+                )
+                notebook.last_focused = cell
+                cell.input_text.cursor_location = cursor
+                await pilot.pause()
+
+                assert _cell_summary(notebook)[-2:] == [
+                    (cell_type.__name__, source),
+                    (cell_type.__name__, f"after {index}"),
+                ]
+                assert (
+                    cell.next is following,
+                    following.prev is cell,
+                ) == (True, True)
+
+                assert cell.input_text.action_split_cell() is None
+                await pilot.pause()
+
+                cells = list(notebook.cell_container.children)
+                position = cells.index(cell)
+                inserted = cells[position + 1]
+                assert _cell_summary(notebook)[position : position + 3] == [
+                    (cell_type.__name__, expected_original),
+                    (cell_type.__name__, expected_inserted),
+                    (cell_type.__name__, f"after {index}"),
+                ]
+                assert inserted.notebook is notebook
+                assert (
+                    cell.next is inserted,
+                    inserted.prev is cell,
+                    inserted.next is following,
+                    following.prev is inserted,
+                ) == (
+                    True,
+                    True,
+                    True,
+                    True,
+                )
+
+    asyncio.run(run())
