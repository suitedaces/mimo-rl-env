+func TestRoundRobinStrategyDoesNotWriteFilesInWorkingDirectory(t *testing.T) {
+	tempDir := t.TempDir()
+	oldDir, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd() error = %v", err)
+	}
+	if err := os.Chdir(tempDir); err != nil {
+		t.Fatalf("Chdir(%q) error = %v", tempDir, err)
+	}
+	defer func() {
+		if err := os.Chdir(oldDir); err != nil {
+			t.Fatalf("restore Chdir(%q) error = %v", oldDir, err)
+		}
+	}()
+
+	before := snapshotRelativeEntries(t, tempDir)
+	strategy := sarama.NewBalanceStrategyRoundRobin()
+	if _, err := strategy.Plan(
+		map[string]sarama.ConsumerGroupMemberMetadata{
+			"M1": {Topics: []string{"T1", "T2"}},
+			"M2": {Topics: []string{"T1", "T2"}},
+		},
+		map[string][]int32{"T1": []int32{0}, "T2": []int32{0}},
+	); err != nil {
+		t.Fatalf("Plan() error = %v, want nil", err)
+	}
+	if data, err := strategy.AssignmentData("M1", map[string][]int32{"T1": []int32{0}}, 7); err != nil || data != nil {
+		t.Fatalf("AssignmentData() = (%#v, %v), want (nil, nil)", data, err)
+	}
+	after := snapshotRelativeEntries(t, tempDir)
+
+	if !reflect.DeepEqual(after, before) {
+		t.Fatalf("working directory entries changed\nbefore: %#v\nafter:  %#v", before, after)
+	}
+}
+
+func assertPlanEqual(t *testing.T, got, want sarama.BalanceStrategyPlan) {
+	t.Helper()
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("Plan() mismatch\n got: %#v\nwant: %#v", got, want)
+	}
+}
+
+func assertEmptyInputError(t *testing.T, plan sarama.BalanceStrategyPlan, err error) {
+	t.Helper()
+	if plan != nil {
+		t.Fatalf("Plan() plan = %#v, want nil", plan)
+	}
+	if err == nil {
+		t.Fatal("Plan() error = nil, want non-nil error")
+	}
+
+}
+
+func assertPlanCoversTopicPartitionsOnce(t *testing.T, got sarama.BalanceStrategyPlan, topics map[string][]int32) {
+	t.Helper()
+	expected := make(map[string]int)
+	for topic, partitions := range topics {
+		for _, partition := range partitions {
+			expected[topicPartitionKey(topic, partition)]++
+		}
+	}
+	seen := make(map[string]int)
+	for memberID, assignment := range got {
+		for topic, partitions := range assignment {
+			for _, partition := range partitions {
+				key := topicPartitionKey(topic, partition)
+				if _, ok := expected[key]; !ok {
+					t.Fatalf("Plan() assigned unexpected partition %s to %s", key, memberID)
+				}
+				seen[key]++
+			}
+		}
+	}
+	if !reflect.DeepEqual(seen, expected) {
+		t.Fatalf("Plan() partition coverage mismatch\n got: %#v\nwant: %#v", seen, expected)
+	}
+}
+
+func assertPlanMemberLoadsNearlyEven(t *testing.T, got sarama.BalanceStrategyPlan, memberIDs []string, totalPartitions int) {
+	t.Helper()
+	minLoad := totalPartitions
+	maxLoad := 0
+	for _, memberID := range memberIDs {
+		load := 0
+		for _, partitions := range got[memberID] {
+			load += len(partitions)
+		}
+		if load < minLoad {
+			minLoad = load
+		}
+		if load > maxLoad {
+			maxLoad = load
+		}
+	}
+	if maxLoad-minLoad > 1 {
+		t.Fatalf("Plan() member loads differ by more than one partition: %#v", got)
+	}
+}
+
+func topicPartitionKey(topic string, partition int32) string {
+	return topic + "/" + strconv.FormatInt(int64(partition), 10)
+}
+
+func cloneMembers(in map[string]sarama.ConsumerGroupMemberMetadata) map[string]sarama.ConsumerGroupMemberMetadata {
+	out := make(map[string]sarama.ConsumerGroupMemberMetadata, len(in))
+	for memberID, metadata := range in {
+		metadata.Topics = append([]string(nil), metadata.Topics...)
+		metadata.UserData = append([]byte(nil), metadata.UserData...)
+		metadata.OwnedPartitions = append([]*sarama.OwnedPartition(nil), metadata.OwnedPartitions...)
+		out[memberID] = metadata
+	}
+	return out
+}
+
+func cloneTopics(in map[string][]int32) map[string][]int32 {
+	out := make(map[string][]int32, len(in))
+	for topic, partitions := range in {
+		out[topic] = append([]int32(nil), partitions...)
+	}
+	return out
+}
+
+func snapshotRelativeEntries(t *testing.T, root string) []string {
+	t.Helper()
+	var entries []string
+	err := filepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if path == root {
+			return nil
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		if d.IsDir() {
+			entries = append(entries, rel+"/")
+			return nil
+		}
+		entries = append(entries, rel)
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("snapshot %q error = %v", root, err)
+	}
+	sort.Strings(entries)
+	return entries
+}
