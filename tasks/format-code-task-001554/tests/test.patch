+	got, err := sarama.NewBalanceStrategyRoundRobin().Plan(members, topics)
+	if err != nil {
+		t.Fatalf("Plan() error = %v, want nil", err)
+	}
+	assertPlanEqual(t, got, want)
+}
+
+func TestRoundRobinPlanOrdersMembersTopicsAndPartitionsDeterministically(t *testing.T) {
+
+
+	strategy := sarama.NewBalanceStrategyRoundRobin()
+	members := map[string]sarama.ConsumerGroupMemberMetadata{
+		"M3": {Topics: []string{"Z", "A"}},
+		"M1": {Topics: []string{"Z", "A"}},
+		"M2": {Topics: []string{"Z", "A"}},
+	}
+	topics := map[string][]int32{
+		"Z": {2, 0, 1},
+		"A": {1, 0},
+	}
+	got, err := strategy.Plan(members, topics)
+	if err != nil {
+		t.Fatalf("Plan() error = %v, want nil", err)
+	}
+	canonical, err := strategy.Plan(
+		map[string]sarama.ConsumerGroupMemberMetadata{
+			"M1": {Topics: []string{"A", "Z"}},
+			"M2": {Topics: []string{"A", "Z"}},
+			"M3": {Topics: []string{"A", "Z"}},
+		},
+		map[string][]int32{
+			"A": {0, 1},
+			"Z": {0, 1, 2},
+		},
+	)
+	if err != nil {
+		t.Fatalf("canonical Plan() error = %v, want nil", err)
+	}
+
+	if !reflect.DeepEqual(got, canonical) {
+		t.Fatalf("Plan() changed when equivalent inputs were already ordered\nunsorted: %#v\nordered:  %#v", got, canonical)
+	}
+	assertPlanCoversTopicPartitionsOnce(t, got, topics)
+	assertPlanMemberLoadsNearlyEven(t, got, []string{"M1", "M2", "M3"}, 5)
+}
+
+func TestRoundRobinPlanSkipsMembersNotSubscribedToPartitionTopic(t *testing.T) {
