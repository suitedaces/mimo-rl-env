+
+func TestRoundRobinPlanIsReferentiallyTransparentForSameInput(t *testing.T) {
+	members := map[string]sarama.ConsumerGroupMemberMetadata{
+		"M1": {Topics: []string{"T1", "T2"}},
+		"M2": {Topics: []string{"T1", "T2"}},
+	}
+	topics := map[string][]int32{"T1": []int32{0}, "T2": []int32{0}}
+	want := sarama.BalanceStrategyPlan{
+		"M1": map[string][]int32{"T1": []int32{0}},
+		"M2": map[string][]int32{"T2": []int32{0}},
+	}
+	strategy := sarama.NewBalanceStrategyRoundRobin()
+
+	first, err := strategy.Plan(cloneMembers(members), cloneTopics(topics))
+	if err != nil {
+		t.Fatalf("first Plan() error = %v, want nil", err)
+	}
+	second, err := strategy.Plan(cloneMembers(members), cloneTopics(topics))
+	if err != nil {
+		t.Fatalf("second Plan() error = %v, want nil", err)
+	}
+
+	assertPlanEqual(t, first, want)
+	assertPlanEqual(t, second, want)
+	if !reflect.DeepEqual(first, second) {
+		t.Fatalf("Plan() repeated result mismatch\nfirst:  %#v\nsecond: %#v", first, second)
+	}
+}
+
+func TestRoundRobinPlanDoesNotMutateInputs(t *testing.T) {
+	members := map[string]sarama.ConsumerGroupMemberMetadata{
+		"M3": {Topics: []string{"T2", "T1"}},
+		"M1": {Topics: []string{"T1", "T2"}},
+		"M2": {Topics: []string{"T2"}},
+	}
+	topics := map[string][]int32{
+		"T2": {1, 0},
+		"T1": {0},
+	}
+	originalMembers := cloneMembers(members)
+	originalTopics := cloneTopics(topics)
+
+	_, err := sarama.NewBalanceStrategyRoundRobin().Plan(members, topics)
+	if err != nil {
+		t.Fatalf("Plan() error = %v, want nil", err)
+	}
+
+	if !reflect.DeepEqual(members, originalMembers) {
+		t.Fatalf("Plan() mutated members\nbefore: %#v\nafter:  %#v", originalMembers, members)
+	}
+	if !reflect.DeepEqual(topics, originalTopics) {
+		t.Fatalf("Plan() mutated topics\nbefore: %#v\nafter:  %#v", originalTopics, topics)
+	}
+}
+
+func TestRoundRobinPlanDoesNotReuseGlobalStateAcrossDifferentInputs(t *testing.T) {
+	strategy := sarama.NewBalanceStrategyRoundRobin()
+	baseMembers := map[string]sarama.ConsumerGroupMemberMetadata{
+		"M1": {Topics: []string{"T1", "T2"}},
+		"M2": {Topics: []string{"T1", "T2"}},
+	}
+	baseTopics := map[string][]int32{"T1": []int32{0}, "T2": []int32{0}}
+	want := sarama.BalanceStrategyPlan{
+		"M1": map[string][]int32{"T1": []int32{0}},
+		"M2": map[string][]int32{"T2": []int32{0}},
+	}
+
+	first, err := strategy.Plan(cloneMembers(baseMembers), cloneTopics(baseTopics))
+	if err != nil {
+		t.Fatalf("first Plan() error = %v, want nil", err)
+	}
+	assertPlanEqual(t, first, want)
+
+	if _, err := strategy.Plan(
+		map[string]sarama.ConsumerGroupMemberMetadata{
+			"A": {Topics: []string{"X"}},
+			"B": {Topics: []string{"X"}},
+		},
+		map[string][]int32{"X": []int32{0, 1}},
+	); err != nil {
+		t.Fatalf("noise Plan() error = %v, want nil", err)
+	}
+	if _, err := strategy.Plan(
+		map[string]sarama.ConsumerGroupMemberMetadata{
+			"C": {Topics: []string{"Y", "Z"}},
+			"D": {Topics: []string{"Y", "Z"}},
+			"E": {Topics: []string{"Y", "Z"}},
+		},
+		map[string][]int32{"Z": []int32{0}, "Y": []int32{0, 1}},
+	); err != nil {
+		t.Fatalf("second noise Plan() error = %v, want nil", err)
+	}
+
+	again, err := strategy.Plan(cloneMembers(baseMembers), cloneTopics(baseTopics))
+	if err != nil {
+		t.Fatalf("final Plan() error = %v, want nil", err)
+	}
+	assertPlanEqual(t, again, want)
+}
