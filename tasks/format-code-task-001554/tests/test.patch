+func TestRoundRobinStrategyName(t *testing.T) {
+
+
+	strategy := sarama.NewBalanceStrategyRoundRobin()
+
+	if got := strategy.Name(); got != "roundrobin" {
+		t.Fatalf("Name() = %q, want %q", got, "roundrobin")
+	}
+}
+
+func TestRoundRobinPlanAlternatesAcrossTwoSinglePartitionTopics(t *testing.T) {
+
+
+	members := map[string]sarama.ConsumerGroupMemberMetadata{
+		"M2": {Topics: []string{"T2", "T1"}},
+		"M1": {Topics: []string{"T1", "T2"}},
+	}
+	topics := map[string][]int32{
+		"T2": {0},
+		"T1": {0},
+	}
+	want := sarama.BalanceStrategyPlan{
+		"M1": map[string][]int32{"T1": []int32{0}},
+		"M2": map[string][]int32{"T2": []int32{0}},
+	}
+
+	got, err := sarama.NewBalanceStrategyRoundRobin().Plan(members, topics)
+	if err != nil {
+		t.Fatalf("Plan() error = %v, want nil", err)
+	}
+	assertPlanEqual(t, got, want)
+}
+
+func TestRoundRobinPlanAlternatesAcrossPartitionsOfOneTopic(t *testing.T) {
+
+
+	members := map[string]sarama.ConsumerGroupMemberMetadata{
