+
+
+
+
+
+
+
+import copy
+import io
+import json
+import os
+import socket
+import subprocess
+import sys
+from contextlib import redirect_stdout
+
+import pytest
+
+from mystic.bounds import Bounds
+from mystic.math.measures import (
+    expectation,
+    expected_variance,
+    impose_expected_mean_and_variance,
+)
+
+
+def identity_model(x):
+    return x[0]
+
+
+def sum_model(x):
+    return x[0] + x[1]
+
+
+def weighted_linear_model(x):
+    return x[0] + 2 * x[1]
+
+
+def rounded_axis_constraints(coords, weights):
+    return [[round(value, 1) for value in axis] for axis in coords]
+
+
+def call_impose(param, f, npts, bounds=None, weights=None, **kwds):
+    options = {
+        "debug": True,
+        "npop": kwds.pop("npop", 20),
+        "maxiter": kwds.pop("maxiter", 100),
+        "maxfun": kwds.pop("maxfun", 10000),
+    }
+    options.update(kwds)
+    with redirect_stdout(io.StringIO()):
+        return impose_expected_mean_and_variance(
+            param, f, npts, bounds=bounds, weights=weights, **options
+        )
+
+
+def float_samples(samples):
+    return [tuple(float(value) for value in sample) for sample in samples]
+
+
+def _product(values):
+    result = 1
+    for value in values:
+        result *= value
+    return result
+
+
+def _tolerances(param, tol):
+    if tol is None:
+        value = 0.01 * max(param)
+        return value, value
+    if isinstance(tol, tuple):
+        mean_tol, variance_tol = tol
+        default = 0.01 * max(param)
+        return mean_tol or default, variance_tol or default
+    return tol, tol
+
+
+def _bounds_lists(bounds):
+    if isinstance(bounds, Bounds):
+        return bounds.xlower, bounds.xupper
+    return bounds
+
+
+def assert_samples_meet_spec(samples, f, npts, bounds, weights, param, tol=None):
+
+
+    assert isinstance(samples, list)
+    assert len(samples) == _product(npts)
+    for sample in samples:
+        assert isinstance(sample, tuple)
+        assert len(sample) == len(npts)
+
+    lower, upper = _bounds_lists(bounds)
+    assert len(lower) == sum(npts)
+    assert len(upper) == sum(npts)
+    for sample in samples:
+        for value in sample:
+            assert min(lower) <= float(value) <= max(upper)
+
+    mean_tol, variance_tol = _tolerances(param, tol)
+    assert abs(float(expectation(f, samples, weights)) - param[0]) <= mean_tol
+    assert abs(float(expected_variance(f, samples, weights)) - param[1]) <= variance_tol
+
+
+def test_scalar_tolerance_tuple_bounds_one_dimensional_identity_model():
+
+
+
+
+    weights = [0.5, 0.5]
+
+    samples = call_impose(
+        (1.0, 0.25),
+        identity_model,
+        (2,),
+        bounds=([0.0, 0.0], [2.0, 2.0]),
+        weights=weights,
+        tol=0.05,
+    )
+
+    assert_samples_meet_spec(
+        samples,
+        identity_model,
+        (2,),
+        ([0.0, 0.0], [2.0, 2.0]),
+        weights,
+        (1.0, 0.25),
+        tol=0.05,
+    )
+
+
+def test_pair_tolerance_product_measure_sum_model():
+
+
+
+
+    weights = [0.25, 0.25, 0.25, 0.25]
+
+    samples = call_impose(
+        (2.0, 0.5),
+        sum_model,
+        (2, 2),
+        bounds=([0.0, 0.0, 0.0, 0.0], [2.0, 2.0, 2.0, 2.0]),
+        weights=weights,
+        tol=(0.1, 0.1),
+        npop=30,
+        maxiter=150,
+        maxfun=20000,
+    )
+
+    assert_samples_meet_spec(
+        samples,
+        sum_model,
+        (2, 2),
+        ([0.0, 0.0, 0.0, 0.0], [2.0, 2.0, 2.0, 2.0]),
+        weights,
+        (2.0, 0.5),
+        tol=(0.1, 0.1),
+    )
+
+
+def test_bounds_object_nonuniform_weights_and_default_tolerance():
+
+
+
+
+    weights = [0.1, 0.2, 0.3, 0.4]
+
+    samples = call_impose(
+        (3.0, 0.2),
+        weighted_linear_model,
+        (2, 2),
+        bounds=Bounds([0.0, 0.0], [2.0, 2.0], n=(2, 2)),
+        weights=weights,
+        npop=30,
+        maxiter=150,
+        maxfun=20000,
+    )
+
+    assert_samples_meet_spec(
+        samples,
+        weighted_linear_model,
+        (2, 2),
+        Bounds([0.0, 0.0], [2.0, 2.0], n=(2, 2)),
+        weights,
+        (3.0, 0.2),
+    )
+
+
+def test_constraints_are_applied_with_variance_penalty_k():
+
+
+
+
+    weights = [0.5, 0.5]
+
+    samples = call_impose(
+        (1.0, 0.25),
+        identity_model,
+        (2,),
+        bounds=([0.0, 0.0], [2.0, 2.0]),
+        weights=weights,
+        tol=(0.2, 0.2),
+        constraints=rounded_axis_constraints,
+        k=1000,
+    )
+
+    assert_samples_meet_spec(
+        samples,
+        identity_model,
+        (2,),
+        ([0.0, 0.0], [2.0, 2.0]),
+        weights,
+        (1.0, 0.25),
+        tol=(0.2, 0.2),
+    )
+
+
+    for sample in samples:
+        for value in sample:
+            assert float(value) == pytest.approx(round(float(value), 1))
+
+
+def test_size_one_zero_variance_boundary_is_allowed():
+
+
+
+
+    weights = [1.0]
+
+    samples = call_impose(
+        (1.0, 0.0),
+        identity_model,
+        (1,),
+        bounds=([0.0], [2.0]),
+        weights=weights,
+        tol=0.05,
+        npop=10,
+        maxiter=50,
+        maxfun=5000,
+    )
+
+    assert_samples_meet_spec(
+        samples,
+        identity_model,
+        (1,),
+        ([0.0], [2.0]),
+        weights,
+        (1.0, 0.0),
+        tol=0.05,
+    )
+    assert float(expected_variance(identity_model, samples, weights)) == 0.0
+
+
+def test_size_one_nonzero_variance_raises_specific_value_error():
+
+
+
+
+
+
+    with pytest.raises(ValueError) as excinfo:
+        call_impose(
+            (1.0, 0.25),
+            identity_model,
+            (1,),
+            bounds=([0.0], [2.0]),
+            weights=[1.0],
+            tol=0.05,
+            npop=10,
+            maxiter=10,
+            maxfun=1000,
+        )
+    message = str(excinfo.value).lower()
+    assert "size" in message
+    assert "variance" in message
+    assert "0" in message or "zero" in message
+
+
+def test_referential_transparency_same_input_same_value():
+    weights = [0.5, 0.5]
+    args = ((1.0, 0.25), identity_model, (2,), ([0.0, 0.0], [2.0, 2.0]))
+
+    first = call_impose(*args, weights=weights, tol=0.05)
+    second = call_impose(*args, weights=weights, tol=0.05)
+
+    assert float_samples(first) == pytest.approx(float_samples(second))
+
+
+def test_does_not_mutate_caller_inputs():
+    param = (1.0, 0.25)
+    npts = (2,)
+    bounds = ([0.0, 0.0], [2.0, 2.0])
+    weights = [0.5, 0.5]
+    before = copy.deepcopy((param, npts, bounds, weights))
+
+    call_impose(param, identity_model, npts, bounds=bounds, weights=weights, tol=0.05)
+
+    assert (param, npts, bounds, weights) == before
+
+
+def test_no_global_state_across_fresh_python_process():
+    weights = [0.5, 0.5]
+    in_process = call_impose(
+        (1.0, 0.25),
+        identity_model,
+        (2,),
+        bounds=([0.0, 0.0], [2.0, 2.0]),
+        weights=weights,
+        tol=0.05,
+    )
+    script = r'''
+import contextlib, io, json, sys
+sys.path.insert(0, "/workspace/repo")
+from mystic.math.measures import impose_expected_mean_and_variance
+
+def identity_model(x):
+    return x[0]
+
+with contextlib.redirect_stdout(io.StringIO()):
+    samples = impose_expected_mean_and_variance(
+        (1.0, 0.25),
+        identity_model,
+        (2,),
+        bounds=([0.0, 0.0], [2.0, 2.0]),
+        weights=[0.5, 0.5],
+        tol=0.05,
+        debug=True,
+        npop=20,
+        maxiter=100,
+        maxfun=10000,
+    )
+print(json.dumps([[float(value) for value in sample] for sample in samples]))
+'''
+
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+
+    fresh_process = [tuple(row) for row in json.loads(completed.stdout)]
+    assert len(fresh_process) == len(in_process)
+    for actual, expected in zip(fresh_process, float_samples(in_process)):
+        assert actual == pytest.approx(expected)
+
+
+def test_no_filesystem_or_network_side_effects(tmp_path, monkeypatch):
+    def blocked_socket(*args, **kwds):
+        raise AssertionError("network access is not declared for this pure function")
+
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr(socket, "socket", blocked_socket)
+    before = sorted(os.listdir(tmp_path))
+
+    samples = call_impose(
+        (1.0, 0.25),
+        identity_model,
+        (2,),
+        bounds=([0.0, 0.0], [2.0, 2.0]),
+        weights=[0.5, 0.5],
+        tol=0.05,
+    )
+
+    assert_samples_meet_spec(
+        samples,
+        identity_model,
+        (2,),
+        ([0.0, 0.0], [2.0, 2.0]),
+        [0.5, 0.5],
+        (1.0, 0.25),
+        tol=0.05,
+    )
+    assert sorted(os.listdir(tmp_path)) == before
