@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+
+
+SP="$PWD/.venv/lib/python3.12/site-packages"
+if [ ! -f "$SP/pytest/__init__.pyc" ]; then
+    find "$SP" -type d -name __pycache__ | while read -r d; do
+        parent="$(dirname "$d")"
+        for f in "$d"/*.cpython-312.pyc; do
+            [ -e "$f" ] || continue
+            base="$(basename "$f" .cpython-312.pyc)"
+            [ -e "$parent/$base.pyc" ] || cp "$f" "$parent/$base.pyc"
+        done
+    done
+fi
+export PYTHONPATH="$SP"
+
+
+
+
+python3 -c "import core, core.json_io, core.utils.chat_formatting"
+
+
+python3 -m pytest tests/core/test_config.py -q
