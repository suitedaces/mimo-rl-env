+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+cd /testbed/go-controller
+
+
+go test ./pkg/libovsdb/ops/ -count=1 \
+    -run 'TestFindNATsUsingPredicate|TestDeleteNATsFromRouter|TestDeleteRoutersWithPredicateOps'
+
+
+go test ./pkg/libovsdb/ops/ -count=1 -v \
+    -run 'TestGetRouterLogicalRouterStaticRoutesWithPredicate|TestDeleteLogicalRouterStaticRoutesOps'
