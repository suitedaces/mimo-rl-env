+package ops
+
+import (
+	"fmt"
+	"sort"
+	"testing"
+
+	libovsdbclient "github.com/ovn-org/libovsdb/client"
+	libovsdb "github.com/ovn-org/libovsdb/ovsdb"
+
+	"github.com/ovn-org/ovn-kubernetes/go-controller/pkg/nbdb"
+	libovsdbtest "github.com/ovn-org/ovn-kubernetes/go-controller/pkg/testing/libovsdb"
+)
+
+func prefixesOf(routes []*nbdb.LogicalRouterStaticRoute) []string {
+	out := make([]string, 0, len(routes))
+	for _, r := range routes {
+		out = append(out, r.IPPrefix)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func equalStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func TestGetRouterLogicalRouterStaticRoutesWithPredicate(t *testing.T) {
+	routeA := &nbdb.LogicalRouterStaticRoute{UUID: buildNamedUUID(), IPPrefix: "10.0.0.0/24", Nexthop: "1.1.1.1"}
+	routeB := &nbdb.LogicalRouterStaticRoute{UUID: buildNamedUUID(), IPPrefix: "10.0.1.0/24", Nexthop: "1.1.1.2"}
+	routeC := &nbdb.LogicalRouterStaticRoute{UUID: buildNamedUUID(), IPPrefix: "10.0.2.0/24", Nexthop: "1.1.1.3"}
+
+	rtr1 := &nbdb.LogicalRouter{Name: "rtr1", UUID: buildNamedUUID(), StaticRoutes: []string{routeA.UUID, routeB.UUID}}
+	rtr2 := &nbdb.LogicalRouter{Name: "rtr2", UUID: buildNamedUUID(), StaticRoutes: []string{routeC.UUID}}
+
+	initialNbdb := libovsdbtest.TestSetup{
+		NBData: []libovsdbtest.TestData{
+			routeA, routeB, routeC, rtr1, rtr2,
+		},
+	}
+
+	tests := []struct {
+		desc       string
+		router     *nbdb.LogicalRouter
+		pred       logicalRouterStaticRoutePredicate
+		expectErr  bool
+		expectPfxs []string
+	}{
+		{
+			desc:       "returns all routes referenced by the router",
+			router:     &nbdb.LogicalRouter{Name: "rtr1"},
+			pred:       func(*nbdb.LogicalRouterStaticRoute) bool { return true },
+			expectPfxs: []string{"10.0.0.0/24", "10.0.1.0/24"},
+		},
+		{
+			desc:       "does not return routes referenced by other routers",
+			router:     &nbdb.LogicalRouter{Name: "rtr2"},
+			pred:       func(*nbdb.LogicalRouterStaticRoute) bool { return true },
+			expectPfxs: []string{"10.0.2.0/24"},
+		},
+		{
+			desc:   "applies the predicate within the router's routes",
+			router: &nbdb.LogicalRouter{Name: "rtr1"},
+			pred: func(item *nbdb.LogicalRouterStaticRoute) bool {
+				return item.IPPrefix == "10.0.1.0/24"
+			},
+			expectPfxs: []string{"10.0.1.0/24"},
+		},
+		{
+			desc:   "predicate that would match another router's route returns nothing",
+			router: &nbdb.LogicalRouter{Name: "rtr1"},
+			pred: func(item *nbdb.LogicalRouterStaticRoute) bool {
+				return item.IPPrefix == "10.0.2.0/24"
+			},
+			expectPfxs: []string{},
+		},
+		{
+			desc:      "errors when the router does not exist",
+			router:    &nbdb.LogicalRouter{Name: "doesNotExist"},
+			pred:      func(*nbdb.LogicalRouterStaticRoute) bool { return true },
+			expectErr: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.desc, func(t *testing.T) {
+			nbClient, cleanup, err := libovsdbtest.NewNBTestHarness(initialNbdb, nil)
+			if err != nil {
+				t.Fatalf("failed to set up test harness: %v", err)
+			}
+			t.Cleanup(cleanup.Cleanup)
+
+			routes, err := GetRouterLogicalRouterStaticRoutesWithPredicate(nbClient, tt.router, tt.pred)
+			if tt.expectErr {
+				if err == nil {
+					t.Fatalf("expected an error but got none")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+
+			got := prefixesOf(routes)
+			if !equalStrings(got, tt.expectPfxs) {
+				t.Fatalf("expected prefixes %v, got %v", tt.expectPfxs, got)
+			}
+		})
+	}
+}
+
+func TestDeleteLogicalRouterStaticRoutesOps(t *testing.T) {
+	newData := func() (routeA, routeB, routeC *nbdb.LogicalRouterStaticRoute, rtr1, rtr2 *nbdb.LogicalRouter, initial libovsdbtest.TestSetup) {
+		routeA = &nbdb.LogicalRouterStaticRoute{UUID: buildNamedUUID(), IPPrefix: "10.0.0.0/24", Nexthop: "1.1.1.1"}
+		routeB = &nbdb.LogicalRouterStaticRoute{UUID: buildNamedUUID(), IPPrefix: "10.0.1.0/24", Nexthop: "1.1.1.2"}
+		routeC = &nbdb.LogicalRouterStaticRoute{UUID: buildNamedUUID(), IPPrefix: "10.0.2.0/24", Nexthop: "1.1.1.3"}
+		rtr1 = &nbdb.LogicalRouter{Name: "rtr1", UUID: buildNamedUUID(), StaticRoutes: []string{routeA.UUID, routeB.UUID}}
+		rtr2 = &nbdb.LogicalRouter{Name: "rtr2", UUID: buildNamedUUID(), StaticRoutes: []string{routeC.UUID}}
+		initial = libovsdbtest.TestSetup{
+			NBData: []libovsdbtest.TestData{routeA, routeB, routeC, rtr1, rtr2},
+		}
+		return
+	}
+
+
+
+
+	lookup := func(t *testing.T, nbClient libovsdbclient.Client, prefix string) *nbdb.LogicalRouterStaticRoute {
+		t.Helper()
+		routes, err := FindLogicalRouterStaticRoutesWithPredicate(nbClient, func(item *nbdb.LogicalRouterStaticRoute) bool {
+			return item.IPPrefix == prefix
+		})
+		if err != nil {
+			t.Fatalf("failed to look up route %s: %v", prefix, err)
+		}
+		if len(routes) != 1 {
+			t.Fatalf("expected exactly one route with prefix %s, got %d", prefix, len(routes))
+		}
+		return routes[0]
+	}
+
+	t.Run("deletes the routes and removes them from the router without transacting", func(t *testing.T) {
+		_, _, routeC, rtr1, rtr2, initial := newData()
+
+		nbClient, cleanup, err := libovsdbtest.NewNBTestHarness(initial, nil)
+		if err != nil {
+			t.Fatalf("failed to set up test harness: %v", err)
+		}
+		t.Cleanup(cleanup.Cleanup)
+
+		routeA := lookup(t, nbClient, "10.0.0.0/24")
+		routeB := lookup(t, nbClient, "10.0.1.0/24")
+
+		var ops []libovsdb.Operation
+		ops, err = DeleteLogicalRouterStaticRoutesOps(nbClient, ops, "rtr1", routeA)
+		if err != nil {
+			t.Fatalf("DeleteLogicalRouterStaticRoutesOps() error = %v", err)
+		}
+
+
+		matcher := libovsdbtest.HaveData(initial.NBData)
+		if success, _ := matcher.Match(nbClient); !success {
+			t.Fatalf("database changed before transacting: %v", matcher.FailureMessage(nbClient))
+		}
+
+		if _, err = TransactAndCheck(nbClient, ops); err != nil {
+			t.Fatalf("TransactAndCheck() error = %v", err)
+		}
+
+		expected := libovsdbtest.TestSetup{
+			NBData: []libovsdbtest.TestData{
+				routeB,
+				routeC,
+				&nbdb.LogicalRouter{Name: rtr1.Name, UUID: rtr1.UUID, StaticRoutes: []string{routeB.UUID}},
+				&nbdb.LogicalRouter{Name: rtr2.Name, UUID: rtr2.UUID, StaticRoutes: []string{routeC.UUID}},
+			},
+		}
+		matcher = libovsdbtest.HaveData(expected.NBData)
+		if success, err := matcher.Match(nbClient); !success {
+			t.Fatalf("unexpected db state: %v (err %v)", matcher.FailureMessage(nbClient), err)
+		}
+	})
+
+	t.Run("composes operations across multiple routers in one transaction", func(t *testing.T) {
+		_, _, _, rtr1, rtr2, initial := newData()
+
+		nbClient, cleanup, err := libovsdbtest.NewNBTestHarness(initial, nil)
+		if err != nil {
+			t.Fatalf("failed to set up test harness: %v", err)
+		}
+		t.Cleanup(cleanup.Cleanup)
+
+		routeA := lookup(t, nbClient, "10.0.0.0/24")
+		routeB := lookup(t, nbClient, "10.0.1.0/24")
+		routeC := lookup(t, nbClient, "10.0.2.0/24")
+
+		var ops []libovsdb.Operation
+		ops, err = DeleteLogicalRouterStaticRoutesOps(nbClient, ops, "rtr2", routeC)
+		if err != nil {
+			t.Fatalf("DeleteLogicalRouterStaticRoutesOps() error = %v", err)
+		}
+		ops, err = DeleteLogicalRouterStaticRoutesOps(nbClient, ops, "rtr1", routeA, routeB)
+		if err != nil {
+			t.Fatalf("DeleteLogicalRouterStaticRoutesOps() error = %v", err)
+		}
+
+		if _, err = TransactAndCheck(nbClient, ops); err != nil {
+			t.Fatalf("TransactAndCheck() error = %v", err)
+		}
+
+		expected := libovsdbtest.TestSetup{
+			NBData: []libovsdbtest.TestData{
+				&nbdb.LogicalRouter{Name: rtr1.Name, UUID: rtr1.UUID, StaticRoutes: []string{}},
+				&nbdb.LogicalRouter{Name: rtr2.Name, UUID: rtr2.UUID, StaticRoutes: []string{}},
+			},
+		}
+		matcher := libovsdbtest.HaveData(expected.NBData)
+		if success, err := matcher.Match(nbClient); !success {
+			t.Fatalf("unexpected db state: %v (err %v)", matcher.FailureMessage(nbClient), err)
+		}
+	})
+
+	t.Run("immediate delete helper keeps working", func(t *testing.T) {
+		_, _, routeC, rtr1, rtr2, initial := newData()
+
+		nbClient, cleanup, err := libovsdbtest.NewNBTestHarness(initial, nil)
+		if err != nil {
+			t.Fatalf("failed to set up test harness: %v", err)
+		}
+		t.Cleanup(cleanup.Cleanup)
+
+		routeA := lookup(t, nbClient, "10.0.0.0/24")
+		routeB := lookup(t, nbClient, "10.0.1.0/24")
+
+		if err := DeleteLogicalRouterStaticRoutes(nbClient, "rtr1", routeA, routeB); err != nil {
+			t.Fatal(fmt.Errorf("DeleteLogicalRouterStaticRoutes() error = %v", err))
+		}
+
+		expected := libovsdbtest.TestSetup{
+			NBData: []libovsdbtest.TestData{
+				routeC,
+				&nbdb.LogicalRouter{Name: rtr1.Name, UUID: rtr1.UUID, StaticRoutes: []string{}},
+				&nbdb.LogicalRouter{Name: rtr2.Name, UUID: rtr2.UUID, StaticRoutes: []string{routeC.UUID}},
+			},
+		}
+		matcher := libovsdbtest.HaveData(expected.NBData)
+		if success, err := matcher.Match(nbClient); !success {
+			t.Fatalf("unexpected db state: %v (err %v)", matcher.FailureMessage(nbClient), err)
+		}
+	})
+}
