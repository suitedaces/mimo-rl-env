index 000000000..b91d4ed94
--- /dev/null
+++ b/dask/tests/test_fuse.py
@@ -0,0 +1,136 @@
+from dask.core import fuse, subs
+
+
+def inc(x):
+    return x + 1
+
+
+def add(x, y):
+    return x + y
+
+
+def test_subs_replaces_key_in_task():
+    assert subs((inc, 'x'), 'x', 1) == (inc, 1)
+    assert subs((add, 'x', 'y'), 'x', 1) == (add, 1, 'y')
+
+
+def test_subs_recurses_into_nested_tasks():
+    assert subs((add, (inc, 'x'), 'y'), 'x', 1) == (add, (inc, 1), 'y')
+
+
+def test_subs_recurses_into_lists():
+    assert subs((sum, [1, 'x']), 'x', 2) == (sum, [1, 2])
+    assert subs((sum, [1, ['x']]), 'x', 2) == (sum, [1, [2]])
+
+
+def test_subs_leaves_callable_untouched():
+
+    assert subs((inc, 'y'), inc, 1) == (inc, 'y')
+
+
+def test_subs_on_bare_key():
+    assert subs('x', 'x', 1) == 1
+    assert subs('y', 'x', 1) == 'y'
+
+
+def test_subs_no_match_returns_unchanged():
+    assert subs((inc, 'a'), 'x', 1) == (inc, 'a')
+
+
+def test_fuse_single_chain():
+    assert fuse({
+        'w': (inc, 'x'),
+        'x': (inc, 'y'),
+        'y': (inc, 'z'),
+        'z': (add, 'a', 'b'),
+        'a': 1,
+        'b': 2,
+    }) == {
+        'w': (inc, (inc, (inc, (add, 'a', 'b')))),
+        'a': 1,
+        'b': 2,
+    }
+
+
+def test_fuse_chain_with_extra_dependent():
+    assert fuse({
+        'NEW': (inc, 'y'),
+        'w': (inc, 'x'),
+        'x': (inc, 'y'),
+        'y': (inc, 'z'),
+        'z': (add, 'a', 'b'),
+        'a': 1,
+        'b': 2,
+    }) == {
+        'NEW': (inc, 'y'),
+        'w': (inc, (inc, 'y')),
+        'y': (inc, (add, 'a', 'b')),
+        'a': 1,
+        'b': 2,
+    }
+
+
+def test_fuse_multiple_chains():
+    assert fuse({
+        'v': (inc, 'y'),
+        'u': (inc, 'w'),
+        'w': (inc, 'x'),
+        'x': (inc, 'y'),
+        'y': (inc, 'z'),
+        'z': (add, 'a', 'b'),
+        'a': (inc, 'c'),
+        'b': (inc, 'd'),
+        'c': 1,
+        'd': 2,
+    }) == {
+        'u': (inc, (inc, (inc, 'y'))),
+        'v': (inc, 'y'),
+        'y': (inc, (add, 'a', 'b')),
+        'a': (inc, 1),
+        'b': (inc, 2),
+    }
+
+
+def test_fuse_shared_dependency_not_fused():
+    assert fuse({
+        'a': (inc, 'x'),
+        'b': (inc, 'x'),
+        'c': (inc, 'x'),
+        'd': (inc, 'c'),
+        'x': (inc, 'y'),
+        'y': 0,
+    }) == {
+        'a': (inc, 'x'),
+        'b': (inc, 'x'),
+        'd': (inc, (inc, 'x')),
+        'x': (inc, 0),
+    }
+
+
+def test_fuse_duplicate_reference_not_fused():
+
+    assert fuse({
+        'a': 1,
+        'b': (inc, 'a'),
+        'c': (add, 'b', 'b'),
+    }) == {
+        'b': (inc, 1),
+        'c': (add, 'b', 'b'),
+    }
+
+
+def test_fuse_does_not_mutate_input():
+    dsk = {
+        'a': 1,
+        'b': (inc, 'a'),
+        'c': (inc, 'b'),
+    }
+    original = dict(dsk)
+    fuse(dsk)
+    assert dsk == original
+
+
+def test_fuse_no_chain_returns_equal():
+    assert fuse({}) == {}
+    assert fuse({'a': 1, 'b': 2}) == {'a': 1, 'b': 2}
+    assert fuse({'a': 1, 'b': (add, 'a', 'a')}) == {'a': 1, 'b': (add, 'a', 'a')}
