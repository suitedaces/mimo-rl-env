@@ -0,0 +1,31 @@
+#!/bin/bash
+set -uo pipefail
+
+SOURCE_DIR=/testbed
+WORK_DIR=/tmp/generator-jhipster
+
+prepare_workspace() {
+  mkdir -p "$WORK_DIR"
+  find "$WORK_DIR" -mindepth 1 -maxdepth 1 ! -name node_modules -exec rm -rf {} +
+  tar --exclude='.git' --exclude='node_modules' -cf - -C "$SOURCE_DIR" . | tar -xf - -C "$WORK_DIR"
+  cd "$WORK_DIR" || exit 1
+
+  if [ ! -x node_modules/.bin/esmocha ]; then
+    npm ci --no-audit --fund=false
+  fi
+}
+
+prepare_workspace
+
+case "${1:-}" in
+  base)
+    ./node_modules/.bin/esmocha generators/liquibase/generator.spec.ts --no-insight --forbid-only --no-parallel
+    ;;
+  new)
+    ./node_modules/.bin/esmocha generators/liquibase/fake-data-csv.spec.ts --no-insight --forbid-only --no-parallel
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
