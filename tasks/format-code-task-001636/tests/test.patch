+++ b/generators/liquibase/fake-data-csv.spec.ts
@@ -0,0 +1,149 @@
+import { after, before, describe, expect, it } from 'esmocha';
+
+import { GENERATOR_JDL } from '../generator-list.js';
+import { skipPrettierHelpers as helpers } from '../../test/support/index.js';
+
+const splitCsvLine = (line: string) => line.split(';');
+
+const readFakeDataCsv = (runResult, entityTableName: string) => {
+  const csvPathSuffix = `/src/main/resources/config/liquibase/fake-data/${entityTableName}.csv`;
+  const snapshot = runResult.getSnapshot(file => file.path.endsWith(csvPathSuffix));
+  const matches = Object.values(snapshot);
+  expect(matches).toHaveLength(1);
+
+  const csv = String(matches[0].contents).trim();
+  const [headerLine, ...dataLines] = csv.split(/\r?\n/);
+  const header = splitCsvLine(headerLine);
+  const rows = dataLines.filter(Boolean).map(splitCsvLine);
+  return { header, rows };
+};
+
+const expectRowsToMatchHeader = (header: string[], rows: string[][]) => {
+  expect(rows.length).toBeGreaterThan(0);
+  for (const row of rows) {
+    expect(row).toHaveLength(header.length);
+  }
+};
+
+describe('liquibase fake-data csv relationship columns', function () {
+  this.timeout(120000);
+
+  let relationshipRunResult;
+
+  before(async () => {
+    const jdl = `
+application {
+  config {
+    baseName relationshipCsvApp
+    applicationType monolith
+    packageName com.mycompany.relationshipcsv
+    authenticationType jwt
+    databaseType sql
+    devDatabaseType h2Disk
+    prodDatabaseType postgresql
+    buildTool maven
+    skipClient true
+  }
+  entities Operation, Label, Project, Department, Employee, Family, Child, Passport, Person
+}
+
+entity Operation {
+  name String required
+}
+
+entity Label {
+  name String required
+}
+
+entity Project {
+  name String required
+}
+
+entity Department {
+  name String required
+}
+
+entity Employee {
+  name String required
+}
+
+entity Family {
+  name String required
+}
+
+entity Child {
+  name String required
+}
+
+entity Passport {
+  code String required
+}
+
+entity Person {
+  name String required
+}
+
+relationship ManyToMany {
+  Operation{labels(name) required} to Label{operations(name)}
+  Family{children(name) required} to Child{families(name)}
+}
+
+relationship ManyToOne {
+  Operation{project(name) required} to Project
+  Employee{department(name) required} to Department{employees(name)}
+}
+
+relationship OneToOne {
+  Passport{person(name) required} to Person{passport(code) required}
+}
+`;
+
+    relationshipRunResult = await helpers.runJHipster(GENERATOR_JDL).withOptions({ inline: jdl });
+  });
+
+  after(() => relationshipRunResult?.cleanup());
+
+  it('does not emit many-to-many columns in the owning entity csv', () => {
+    const { header, rows } = readFakeDataCsv(relationshipRunResult, 'operation');
+
+    expect(header).not.toContain('labels_id');
+    expect(header.some(column => /^labels?_.*id$/i.test(column) || /^label.*_id$/i.test(column))).toBe(false);
+    expectRowsToMatchHeader(header, rows);
+  });
+
+  it('does not emit collection-side relationship columns in the collection owner csv', () => {
+    const { header, rows } = readFakeDataCsv(relationshipRunResult, 'department');
+
+    expect(header).not.toContain('employees_id');
+    expect(header.some(column => /^employees?_.*id$/i.test(column) || /^employee.*_id$/i.test(column))).toBe(false);
+    expectRowsToMatchHeader(header, rows);
+  });
+
+  it('filters collection relationship names beyond the initial fixture names', () => {
+    const { header, rows } = readFakeDataCsv(relationshipRunResult, 'family');
+
+    expect(header).not.toContain('children_id');
+    expect(header.some(column => /^children_.*id$/i.test(column) || /^child.*_id$/i.test(column))).toBe(false);
+    expectRowsToMatchHeader(header, rows);
+  });
+
+  it('keeps required singular relationship columns stored on the entity table', () => {
+    const operationCsv = readFakeDataCsv(relationshipRunResult, 'operation');
+    const employeeCsv = readFakeDataCsv(relationshipRunResult, 'employee');
+
+    expect(operationCsv.header).toContain('project_id');
+    expect(employeeCsv.header).toContain('department_id');
+    expectRowsToMatchHeader(operationCsv.header, operationCsv.rows);
+    expectRowsToMatchHeader(employeeCsv.header, employeeCsv.rows);
+  });
+
+  it('keeps owning one-to-one columns while excluding inverse singular columns', () => {
+    const passportCsv = readFakeDataCsv(relationshipRunResult, 'passport');
+    const personCsv = readFakeDataCsv(relationshipRunResult, 'person');
+
+    expect(passportCsv.header).toContain('person_id');
+    expect(personCsv.header).not.toContain('passport_id');
+    expectRowsToMatchHeader(passportCsv.header, passportCsv.rows);
+    expectRowsToMatchHeader(personCsv.header, personCsv.rows);
+  });
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
