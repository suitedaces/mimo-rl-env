+func dependencyCommandScript(t *testing.T, body string) string {
+	t.Helper()
+	dir, err := ioutil.TempDir("", "skaffold-dependency-command")
+	if err != nil {
+		t.Fatalf("creating temp dir: %v", err)
+	}
+	path := filepath.Join(dir, "deps.sh")
+	if err := ioutil.WriteFile(path, []byte("#!/bin/sh\n"+body), 0755); err != nil {
+		os.RemoveAll(dir)
+		t.Fatalf("writing dependency command: %v", err)
+	}
+	return path
+}
diff --git a/pkg/skaffold/schema/latest/custom_dependencies_public_surface_test.go b/pkg/skaffold/schema/latest/custom_dependencies_public_surface_test.go
new file mode 100644
index 000000000..f08b513d3
--- /dev/null
+++ b/pkg/skaffold/schema/latest/custom_dependencies_public_surface_test.go
@@ -0,0 +1,60 @@
+package latest
+
+import (
+	"bytes"
+	"encoding/json"
+	"io/ioutil"
+	"path/filepath"
+	"testing"
+)
+
+func TestCustomDependenciesCommandSchema(t *testing.T) {
+	schemaBytes, err := ioutil.ReadFile(filepath.Join(repoRootForPublicSurfaceTest(), "docs", "content", "en", "schemas", "v1beta10.json"))
+	if err != nil {
+		t.Fatalf("reading schema: %v", err)
+	}
+
+	var schema struct {
+		Definitions map[string]struct {
+			Properties map[string]struct {
+				Type        string `json:"type"`
+				Description string `json:"description"`
+			} `json:"properties"`
+		} `json:"definitions"`
+	}
+	if err := json.NewDecoder(bytes.NewReader(schemaBytes)).Decode(&schema); err != nil {
+		t.Fatalf("parsing schema: %v", err)
+	}
+
+	commandProperty, ok := schema.Definitions["CustomDependencies"].Properties["command"]
+	if !ok {
+		t.Fatalf("CustomDependencies schema does not expose command property")
+	}
+	if commandProperty.Type != "string" {
+		t.Fatalf("command schema type = %q, expected string", commandProperty.Type)
+	}
+	description := bytes.ToLower([]byte(commandProperty.Description))
+	for _, required := range []string{"command", "json", "array"} {
+		if !bytes.Contains(description, []byte(required)) {
+			t.Fatalf("command schema description %q does not describe %q", commandProperty.Description, required)
+		}
+	}
+}
+
+func TestCustomDependenciesCommandDocumentation(t *testing.T) {
+	docBytes, err := ioutil.ReadFile(filepath.Join(repoRootForPublicSurfaceTest(), "docs", "content", "en", "docs", "how-tos", "builders", "_index.md"))
+	if err != nil {
+		t.Fatalf("reading custom builder docs: %v", err)
+	}
+	doc := bytes.ToLower(docBytes)
+
+	for _, required := range []string{"command", "dependenc", "json", "array"} {
+		if !bytes.Contains(doc, []byte(required)) {
+			t.Fatalf("custom builder docs do not describe command dependency JSON array contract; missing %q", required)
+		}
+	}
+}
+
+func repoRootForPublicSurfaceTest() string {
+	return filepath.Clean(filepath.Join("..", "..", "..", ".."))
+}
