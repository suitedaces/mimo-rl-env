+func TestGetDependenciesCommandJSONOutput(t *testing.T) {
+	tests := []struct {
+		description string
+		output      string
+		expected    []string
+	}{
+		{
+			description: "source and asset files",
+			output:      `["src/a.go","assets/b.txt"]`,
+			expected:    []string{"src/a.go", "assets/b.txt"},
+		},
+		{
+			description: "different dependency names",
+			output:      `["another.yaml","dir/third.txt"]`,
+			expected:    []string{"another.yaml", "dir/third.txt"},
+		},
+		{
+			description: "third valid dependency set",
+			output:      `["cmd/generated.txt","pkg/fourth.go"]`,
+			expected:    []string{"cmd/generated.txt", "pkg/fourth.go"},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.description, func(t *testing.T) {
+			command := dependencyCommandScript(t, fmt.Sprintf("printf '%%s\n' '%s'\n", test.output))
+			customArtifact := &latest.CustomArtifact{
+				Dependencies: &latest.CustomDependencies{
+					Command: command,
+				},
+			}
+
+			deps, err := GetDependencies(context.Background(), "", customArtifact, nil)
+
+			testutil.CheckErrorAndDeepEqual(t, false, err, test.expected, deps)
+		})
+	}
+}
