diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+
+dev-switch go 1.23
+
+
+mkdir -p /root/go/src/github.com/GoogleContainerTools
+ln -sf /testbed /root/go/src/github.com/GoogleContainerTools/skaffold
+
+
+cd /root/go/src/github.com/GoogleContainerTools/skaffold
+
+
+case "${1:-}" in
+  base)
+    GO111MODULE=off go test -v ./pkg/skaffold/build/custom/ -run '^(TestGetDependenciesDockerfile|TestGetDependenciesPaths)$'
+    GO111MODULE=off go test -v ./pkg/skaffold/schema/validation/ -run '^TestValidateCustomDependencies/(no_errors|ignore_in_conjunction_with_dockerfile)$'
+    ;;
+  new)
+    GO111MODULE=off go test -v ./pkg/skaffold/build/custom/ -run '^TestGetDependenciesCommand(JSONOutput|InvalidOutput|Failure)$'
+    GO111MODULE=off go test -v ./pkg/skaffold/schema/validation/ -run '^TestValidateCustomDependencies/(ignore_in_conjunction_with_paths|ignore_in_conjunction_with_command)$'
+    GO111MODULE=off go test -v ./pkg/skaffold/schema/latest/ -run '^TestCustomDependenciesCommand(Schema|Documentation)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
