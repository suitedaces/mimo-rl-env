+  const log = [];
+  installLocationDelegate(Davis, log, '/');
+  const app = new Davis.App();
+
+  app.bind('stop', function () { log.push('event:stop:' + app.running); });
+  app.start();
+  assert.doesNotThrow(function () {
+    app.stop();
+    log.push('after-first-stop-running:' + app.running);
+    app.stop();
+    log.push('after-second-stop-running:' + app.running);
+  });
+
+  assert.deepStrictEqual(log, [
+    'delegate:onChange:1',
+    'event:stop:true',
+    'after-first-stop-running:false',
+    'event:stop:false',
+    'after-second-stop-running:false'
+  ]);
+
+  assertBindingLogEntries(harness.bindingLog, [
+    'delegate:form:submit',
+    'delegate:a:click',
+    'undelegate:a:click',
+    'undelegate:form:submit',
+    'undelegate:a:click',
+    'undelegate:form:submit'
+  ]);
+});
+
+test('two app instances keep independent running state', function () {
+
+
+
+
+  const harness = loadDavis('/');
+  const Davis = harness.Davis;
+  const log = [];
+  installLocationDelegate(Davis, log, '/');
+  const appA = new Davis.App();
+  const appB = new Davis.App();
+
+  appA.bind('start', function () { log.push('a:start:' + appA.running + ':' + appB.running); });
+  appA.bind('stop', function () { log.push('a:stop:' + appA.running + ':' + appB.running); });
+  appB.bind('start', function () { log.push('b:start:' + appA.running + ':' + appB.running); });
+
+  log.push('fresh:' + appA.running + ':' + appB.running);
+  appA.start();
+  log.push('after-a-start:' + appA.running + ':' + appB.running);
+  appB.start();
+  log.push('after-b-start:' + appA.running + ':' + appB.running);
+  appA.stop();
+  log.push('after-a-stop:' + appA.running + ':' + appB.running);
+
+
+  assert.deepStrictEqual(log.filter(function (entry) {
+    return entry.indexOf('delegate:onChange:') !== 0;
+  }), [
+    'fresh:false:false',
+    'a:start:false:false',
+    'after-a-start:true:false',
+    'b:start:true:false',
+    'after-b-start:true:true',
+    'a:stop:true:true',
+    'after-a-stop:false:true'
+  ]);
+  assert.deepStrictEqual(log.filter(function (entry) {
+    return entry.indexOf('delegate:onChange:') === 0;
+  }), ['delegate:onChange:1', 'delegate:onChange:2']);
+  assert.deepStrictEqual(harness.listenerStats(), {
+    activeDelegates: 2,
+    maxActiveDelegates: 4,
+    delegateCalls: 4,
+    undelegateCalls: 2
+  });
+});
+
+test('repeated construct start stop cycles do not leak delegated listeners', function () {
+
+
+
+
+  const harness = loadDavis('/');
+  const Davis = harness.Davis;
+  const log = [];
+  installLocationDelegate(Davis, log, '/');
+
+  for (let i = 0; i < 120; i += 1) {
+    const app = new Davis.App();
+    app.start();
+    app.stop();
+  }
+
+  assert.deepStrictEqual(harness.listenerStats(), {
+    activeDelegates: 0,
+    maxActiveDelegates: 2,
+    delegateCalls: 240,
+    undelegateCalls: 240
+  });
+});
