+test('route errors are rethrown when throwErrors is true', function () {
+
+
+
+
+  const harness = loadDavis('/');
+  const Davis = harness.Davis;
+  const log = [];
+  installLocationDelegate(Davis, log, '/');
+  const app = new Davis.App();
+
+  app.configure(function (settings) { settings.throwErrors = true; });
+  app.bind('routeError', function (request, route, error) {
+
+    log.push('event:routeError' + (error && error.name ? ':' + error.name : ''));
+  });
+  app.get('/boom', function () {
+    throw new TypeError('route exploded');
+  });
+
+  app.start();
+  assert.throws(function () {
+    Davis.location.assign(new Davis.Request('/boom'));
+  }, TypeError);
+  log.push('after-error-running:' + app.running);
+
+
+  assert.deepStrictEqual(log.filter(function (entry) {
+    return entry.indexOf('delegate:') === 0;
+  }), ['delegate:onChange:1', 'delegate:assign:GET /boom']);
+  assert(log.some(function (entry) { return entry.indexOf('event:routeError') === 0; }));
+  assert(log.indexOf('after-error-running:true') !== -1);
+});
+
+test('route errors are logged when throwErrors is false', function () {
+
+
+
+
+  const harness = loadDavis('/');
+  const Davis = harness.Davis;
+  const log = [];
+  installLocationDelegate(Davis, log, '/');
+  const app = new Davis.App();
+
+  app.configure(function (settings) { settings.throwErrors = false; });
+  app.logger.error = function (message) {
+    const rendered = message && message.message ? message.message : message;
+    log.push('logger:error:' + rendered);
+  };
+  app.bind('routeError', function (request, route, error) {
+
+    log.push('event:routeError' + (error && error.name ? ':' + error.name : ''));
+  });
+  app.get('/boom', function () {
+    throw new TypeError('route exploded');
+  });
+
+  app.start();
+  Davis.location.assign(new Davis.Request('/boom'));
+  log.push('assign:returned');
+  log.push('after-error-running:' + app.running);
+
+
+  assert.deepStrictEqual(log.filter(function (entry) {
+    return entry.indexOf('delegate:') === 0;
+  }), ['delegate:onChange:1', 'delegate:assign:GET /boom']);
+  assert(log.some(function (entry) { return entry.indexOf('event:routeError') === 0; }));
+  assert(log.some(function (entry) { return entry.indexOf('logger:error:') === 0 && entry !== 'logger:error:'; }));
+  assert(log.indexOf('assign:returned') !== -1);
+  assert(log.indexOf('after-error-running:true') !== -1);
+});
+
+test('stop can be called twice without throwing', function () {
