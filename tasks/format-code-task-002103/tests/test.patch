diff --git a/usercase-test-coderl/offline_network_guard.js b/usercase-test-coderl/offline_network_guard.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/offline_network_guard.js
@@ -0,0 +1,124 @@
+
+'use strict';
+
+const childProcess = require('child_process');
+const dgram = require('dgram');
+const dns = require('dns');
+const http = require('http');
+const https = require('https');
+const net = require('net');
+const tls = require('tls');
+
+function offlineError(target) {
+  return new Error('local offline network guard blocked ' + target);
+}
+
+function isLocalHost(host) {
+  if (host === undefined || host === null || host === '') return true;
+  host = String(host).replace(/^\[|\]$/g, '').toLowerCase();
+  return (
+    host === 'localhost' ||
+    host === '0.0.0.0' ||
+    host === '::' ||
+    host === '::1' ||
+    host === '127.0.0.1' ||
+    /^127\.\d+\.\d+\.\d+$/.test(host)
+  );
+}
+
+function hostFromRequestArgs(args) {
+  const first = args[0];
+  const second = args[1];
+  if (first instanceof URL) return first.hostname;
+  if (typeof first === 'string') return new URL(first).hostname;
+  if (first && typeof first === 'object') return first.hostname || first.host;
+  if (second && typeof second === 'object') return second.hostname || second.host;
+  return undefined;
+}
+
+function hostFromConnectArgs(args) {
+  const first = args[0];
+  if (first && typeof first === 'object') return first.hostname || first.host;
+  if (typeof first === 'number') return args[1];
+  return first;
+}
+
+function assertLocal(host, target) {
+  if (!isLocalHost(host)) throw offlineError(target + ' to ' + host);
+}
+
+function wrapRequest(module, name) {
+  const original = module[name];
+  module[name] = function () {
+    assertLocal(hostFromRequestArgs(arguments), module === https ? 'https.' + name : 'http.' + name);
+    return original.apply(this, arguments);
+  };
+}
+
+wrapRequest(http, 'request');
+wrapRequest(http, 'get');
+wrapRequest(https, 'request');
+wrapRequest(https, 'get');
+
+const originalNetConnect = net.connect;
+const originalNetCreateConnection = net.createConnection;
+const originalSocketConnect = net.Socket.prototype.connect;
+net.connect = function () {
+  assertLocal(hostFromConnectArgs(arguments), 'net.connect');
+  return originalNetConnect.apply(this, arguments);
+};
+net.createConnection = function () {
+  assertLocal(hostFromConnectArgs(arguments), 'net.createConnection');
+  return originalNetCreateConnection.apply(this, arguments);
+};
+net.Socket.prototype.connect = function () {
+  assertLocal(hostFromConnectArgs(arguments), 'net.Socket.connect');
+  return originalSocketConnect.apply(this, arguments);
+};
+
+const originalTlsConnect = tls.connect;
+tls.connect = function () {
+  assertLocal(hostFromConnectArgs(arguments), 'tls.connect');
+  return originalTlsConnect.apply(this, arguments);
+};
+
+const originalDgramCreateSocket = dgram.createSocket;
+dgram.createSocket = function () {
+  const socket = originalDgramCreateSocket.apply(this, arguments);
+  const originalSend = socket.send;
+  socket.send = function () {
+    const host = arguments.length >= 4 ? arguments[arguments.length - 2] : undefined;
+    assertLocal(host, 'dgram.send');
+    return originalSend.apply(this, arguments);
+  };
+  return socket;
+};
+
+const originalLookup = dns.lookup;
+dns.lookup = function (hostname) {
+  assertLocal(hostname, 'dns.lookup');
+  return originalLookup.apply(this, arguments);
+};
+if (dns.promises && dns.promises.lookup) {
+  const originalPromisesLookup = dns.promises.lookup;
+  dns.promises.lookup = function (hostname) {
+    assertLocal(hostname, 'dns.promises.lookup');
+    return originalPromisesLookup.apply(this, arguments);
+  };
+}
+
+if (globalThis.fetch) {
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = function (input) {
+    const url = typeof input === 'string' || input instanceof URL ? new URL(input) : new URL(input.url);
+    assertLocal(url.hostname, 'fetch');
+    return originalFetch.apply(this, arguments);
+  };
+}
+
+['exec', 'execFile', 'fork', 'spawn', 'execSync', 'execFileSync', 'spawnSync'].forEach(function (name) {
+  const original = childProcess[name];
+  childProcess[name] = function () {
+    throw offlineError('child_process.' + name);
+  };
+});
diff --git a/usercase-test-coderl/routing_lifecycle.test.js b/usercase-test-coderl/routing_lifecycle.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/routing_lifecycle.test.js
@@ -0,0 +1,716 @@
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+
+
+
+
+
+
+
+
+
+
+const REPO = '/workspace/repo';
+const PUBLIC_SCRIPTS = [
+  'lib/davis.js',
+  'lib/davis.utils.js',
+  'lib/davis.listener.js',
+  'lib/davis.event.js',
+  'lib/davis.logger.js',
+  'lib/davis.route.js',
+  'lib/davis.router.js',
+  'lib/davis.history.js',
+  'lib/davis.location.js',
+  'lib/davis.request.js',
+  'lib/davis.app.js'
+];
+
+function loadDavis(currentPath) {
+  const bindingLog = [];
+  const activeDelegates = {};
+  let activeDelegateCount = 0;
+  let maxActiveDelegateCount = 0;
+  let delegateCalls = 0;
+  let undelegateCalls = 0;
+
+  function keyFor(selector, eventName) {
+    return selector + ':' + eventName;
+  }
+
+  function JQueryObject(target) {
+    this.target = target;
+  }
+
+  JQueryObject.prototype.delegate = function (selector, eventName) {
+    const key = keyFor(selector, eventName);
+    activeDelegates[key] = (activeDelegates[key] || 0) + 1;
+    activeDelegateCount += 1;
+    maxActiveDelegateCount = Math.max(maxActiveDelegateCount, activeDelegateCount);
+    delegateCalls += 1;
+    bindingLog.push('delegate:' + selector + ':' + eventName);
+    return this;
+  };
+
+  JQueryObject.prototype.undelegate = function (selector, eventName) {
+    const key = keyFor(selector, eventName);
+    if (activeDelegates[key]) {
+      activeDelegates[key] -= 1;
+      activeDelegateCount -= 1;
+    }
+    undelegateCalls += 1;
+    bindingLog.push('undelegate:' + selector + ':' + eventName);
+    return this;
+  };
+
+  JQueryObject.prototype.prop = function () { return ''; };
+  JQueryObject.prototype.attr = function () { return ''; };
+  JQueryObject.prototype.serialize = function () { return ''; };
+  JQueryObject.prototype.submit = function () {
+    bindingLog.push('submit');
+    return this;
+  };
+
+  function $(target) {
+    return new JQueryObject(target);
+  }
+
+  $.extend = function () {
+    const out = {};
+    for (let i = 0; i < arguments.length; i += 1) {
+      const obj = arguments[i];
+      if (!obj) continue;
+      for (const key in obj) out[key] = obj[key];
+    }
+    return out;
+  };
+
+  $.param = function (obj) {
+    return Object.keys(obj).map(function (key) {
+      return encodeURIComponent(key) + '=' + encodeURIComponent(obj[key]);
+    }).join('&');
+  };
+
+  const consoleLog = [];
+  const context = {
+    console: {
+      log: function (message) { consoleLog.push('log:' + message); },
+      info: function (message) { consoleLog.push('info:' + message); },
+      warn: function (message) { consoleLog.push('warn:' + message); },
+      error: function (message) { consoleLog.push('error:' + message); }
+    },
+    window: {
+      jQuery: $,
+      console: {
+        info: function (message) { consoleLog.push('info:' + message); },
+        warn: function (message) { consoleLog.push('warn:' + message); },
+        error: function (message) { consoleLog.push('error:' + message); }
+      },
+      history: {
+        pushState: function () {},
+        replaceState: function () {}
+      },
+      addEventListener: function () {},
+      location: {
+        pathname: currentPath || '/',
+        search: '',
+        host: 'example.com',
+        protocol: 'http:'
+      }
+    },
+    document: {
+      title: 'Design Title',
+      createElement: function () {
+        return {
+          href: '',
+          host: 'example.com',
+          protocol: 'http:',
+          nodeName: 'A'
+        };
+      }
+    },
+    history: {
+      pushState: function () {},
+      replaceState: function () {}
+    },
+    setTimeout: setTimeout,
+    clearTimeout: clearTimeout
+  };
+
+  context.jQuery = $;
+  context.window.window = context.window;
+  context.window.document = context.document;
+
+  vm.createContext(context);
+  PUBLIC_SCRIPTS.forEach(function (scriptPath) {
+    vm.runInContext(
+      fs.readFileSync(path.join(REPO, scriptPath), 'utf8'),
+      context,
+      { filename: scriptPath }
+    );
+  });
+
+  return {
+    Davis: context.Davis,
+    bindingLog: bindingLog,
+    consoleLog: consoleLog,
+    listenerStats: function () {
+      return {
+        activeDelegates: activeDelegateCount,
+        maxActiveDelegates: maxActiveDelegateCount,
+        delegateCalls: delegateCalls,
+        undelegateCalls: undelegateCalls
+      };
+    }
+  };
+}
+
+function installLocationDelegate(Davis, log, currentPath) {
+  const handlers = [];
+  Davis.location.setLocationDelegate({
+    current: function () {
+      log.push('delegate:current');
+      return currentPath || '/';
+    },
+    onChange: function (handler) {
+      handlers.push(handler);
+      log.push('delegate:onChange:' + handlers.length);
+    },
+    assign: function (request) {
+      log.push('delegate:assign:' + request.toString());
+      handlers.forEach(function (handler) { handler(request); });
+    },
+    replace: function (request) {
+      log.push('delegate:replace:' + request.toString());
+      handlers.forEach(function (handler) { handler(request); });
+    }
+  });
+  return handlers;
+}
+
+function eventArgsToString(args) {
+  return Array.prototype.slice.call(args).map(function (arg) {
+    return arg && arg.toString ? arg.toString() : String(arg);
+  }).join('|');
+}
+
+function recordEvents(app, log, events) {
+  events.forEach(function (eventName) {
+    app.bind(eventName, function () {
+
+      log.push('event:' + eventName + ':' + eventArgsToString([arguments[0]]));
+    });
+  });
+}
+
+function assertBindingLogEntries(actual, expected) {
+  assert.deepStrictEqual(actual.slice().sort(), expected.slice().sort());
+}
+
+function test(name, fn) {
+  try {
+    fn();
+    console.log('ok - ' + name);
+  } catch (error) {
+    console.error('not ok - ' + name);
+    throw error;
+  }
+}
+
+test('start binds once and stop unbinds listeners', function () {
+
+
+
+
+  const harness = loadDavis('/');
+  const Davis = harness.Davis;
+  const log = [];
+  installLocationDelegate(Davis, log, '/');
+  const app = new Davis.App();
+
+  app.bind('start', function () { log.push('event:start:' + app.running); });
+  app.bind('stop', function () { log.push('event:stop:' + app.running); });
+
+  log.push('fresh:running:' + app.running);
+  app.start();
+  log.push('after-start:running:' + app.running);
+  app.start();
+  log.push('after-second-start:running:' + app.running);
+  app.stop();
+  log.push('after-stop:running:' + app.running);
+
+
+  assert.deepStrictEqual(log.filter(function (entry) {
+    return entry.indexOf('delegate:onChange:') !== 0;
+  }), [
+    'fresh:running:false',
+    'event:start:false',
+    'after-start:running:true',
+    'after-second-start:running:true',
+    'event:stop:true',
+    'after-stop:running:false'
+  ]);
+  assert.deepStrictEqual(log.filter(function (entry) {
+    return entry.indexOf('delegate:onChange:') === 0;
+  }), ['delegate:onChange:1']);
+
+  assertBindingLogEntries(harness.bindingLog, [
+    'delegate:form:submit',
+    'delegate:a:click',
+    'undelegate:a:click',
+    'undelegate:form:submit'
+  ]);
+  assert.deepStrictEqual(harness.listenerStats(), {
+    activeDelegates: 0,
+    maxActiveDelegates: 2,
+    delegateCalls: 2,
+    undelegateCalls: 2
+  });
+});
+
+test('unsupported browser triggers unsupported and remains stopped', function () {
+
+
+
+
+  const harness = loadDavis('/');
+  const Davis = harness.Davis;
+  const log = [];
+  installLocationDelegate(Davis, log, '/');
+  Davis.supported = function () { return false; };
+  const app = new Davis.App();
+
+  app.bind('unsupported', function () { log.push('event:unsupported:' + app.running); });
+
+  log.push('fresh:running:' + app.running);
+  app.start();
+  log.push('after-start:running:' + app.running);
+
+  assert.deepStrictEqual(log, [
+    'fresh:running:false',
+    'event:unsupported:false',
+    'after-start:running:false'
+  ]);
+  assert.deepStrictEqual(harness.bindingLog, []);
+  assert.deepStrictEqual(harness.listenerStats(), {
+    activeDelegates: 0,
+    maxActiveDelegates: 0,
+    delegateCalls: 0,
+    undelegateCalls: 0
+  });
+});
+
+test('request delivered before start is ignored by the app session', function () {
+
+
+
+
+  const harness = loadDavis('/');
+  const Davis = harness.Davis;
+  const log = [];
+  installLocationDelegate(Davis, log, '/');
+  const app = new Davis.App();
+
+  recordEvents(app, log, ['lookupRoute', 'runRoute', 'routeComplete', 'requestHalted', 'routeNotFound']);
+  app.get('/cold', function (request) { log.push('route:' + request.toString()); });
+
+  Davis.location.assign(new Davis.Request('/cold'));
+  log.push('after-request-running:' + app.running);
+
+  assert.deepStrictEqual(log, [
+    'delegate:assign:GET /cold',
+    'after-request-running:false'
+  ]);
+  assert.deepStrictEqual(harness.bindingLog, []);
+});
+
+test('matching request runs before filters route and after filters in order', function () {
+
+
+
+
+  const harness = loadDavis('/');
+  const Davis = harness.Davis;
+  const log = [];
+  installLocationDelegate(Davis, log, '/');
+  const app = new Davis.App();
+
+  recordEvents(app, log, ['lookupRoute', 'runRoute', 'routeComplete', 'requestHalted', 'routeNotFound']);
+  app.before('/alpha', function (request) {
+    log.push('before1:' + request.toString());
+    return true;
+  });
+  app.before('/alpha', function (request) {
+    log.push('before2:' + request.toString());
+  });
+  app.get('/alpha', function (request) {
+    log.push('route:' + request.toString());
+  });
+  app.after('/alpha', function (request) {
+    log.push('after:' + request.toString());
+    return true;
+  });
+
+  app.start();
+  log.push('running:' + app.running);
+  Davis.location.assign(new Davis.Request('/alpha'));
+  log.push('after-request-running:' + app.running);
+
+
+  assert.deepStrictEqual(log, [
+    'delegate:onChange:1',
+    'running:true',
+    'delegate:assign:GET /alpha',
+    'before1:GET /alpha',
+    'before2:GET /alpha',
+    'event:lookupRoute:GET /alpha',
+    'event:runRoute:GET /alpha',
+    'route:GET /alpha',
+    'event:routeComplete:GET /alpha',
+    'after:GET /alpha',
+    'after-request-running:true'
+  ]);
+
+  assertBindingLogEntries(harness.bindingLog, [
+    'delegate:form:submit',
+    'delegate:a:click'
+  ]);
+});
+
+test('before filter returning false halts the request', function () {
+
+
+
+
+  const harness = loadDavis('/');
+  const Davis = harness.Davis;
+  const log = [];
+  installLocationDelegate(Davis, log, '/');
+  const app = new Davis.App();
+
+  recordEvents(app, log, ['lookupRoute', 'runRoute', 'routeComplete', 'requestHalted', 'routeNotFound']);
+  app.before('/halt', function (request) {
+    log.push('before1:' + request.toString());
+    return false;
+  });
+  app.before('/halt', function (request) {
+    log.push('before2:' + request.toString());
+    return true;
+  });
+  app.get('/halt', function (request) {
+    log.push('route:' + request.toString());
+  });
+  app.after('/halt', function (request) {
+    log.push('after:' + request.toString());
+  });
+
+  app.start();
+  Davis.location.assign(new Davis.Request('/halt'));
+  log.push('after-request-running:' + app.running);
+
+  assert.deepStrictEqual(log, [
+    'delegate:onChange:1',
+    'delegate:assign:GET /halt',
+    'before1:GET /halt',
+    'event:requestHalted:GET /halt',
+    'after-request-running:true'
+  ]);
+});
