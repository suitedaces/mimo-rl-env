+++ b/usercase-test-coderl/test_app_command_sync_translations.py
@@ -0,0 +1,450 @@
+
+
+
+
+
+
+
+import pytest
+
+import discord
+from discord import app_commands
+
+
+APPLICATION_ID = 246813579
+GUILD_ID = 987654321
+
+
+class RecorderHTTP:
+    def __init__(self):
+        self.calls = []
+
+    async def bulk_upsert_global_commands(self, application_id, *, payload):
+        self.calls.append(("global", application_id, payload))
+        return []
+
+    async def bulk_upsert_guild_commands(self, application_id, guild_id, *, payload):
+        self.calls.append(("guild", application_id, guild_id, payload))
+        return []
+
+
+class Guild:
+    id = GUILD_ID
+
+
+class SelectiveTranslator(app_commands.Translator):
+    def __init__(self, prefix="xlat"):
+        self.prefix = prefix
+        self.loaded = 0
+        self.unloaded = 0
+        self.calls = []
+
+    async def load(self):
+        self.loaded += 1
+
+    async def unload(self):
+        self.unloaded += 1
+
+    async def translate(self, string, locale, context):
+        self.calls.append((str(string), locale.value, context.location.name))
+        if locale in (discord.Locale.german, discord.Locale.japanese):
+            return f"{self.prefix}:{context.location.name}:{str(string)}:{locale.value}"
+        return None
+
+
+class FailingTranslator(app_commands.Translator):
+    async def translate(self, string, locale, context):
+        raise RuntimeError("translation backend down")
+
+
+def make_tree(*, application_id=APPLICATION_ID):
+    client = discord.Client(intents=discord.Intents.none(), application_id=application_id)
+    http = RecorderHTTP()
+    client.http = http
+    return app_commands.CommandTree(client), http
+
+
+def add_full_global_command_set(tree):
+    @tree.command(name=app_commands.locale_str("launch"), description=app_commands.locale_str("Launch a ship"))
+    @app_commands.rename(style=app_commands.locale_str("ship-style"))
+    @app_commands.describe(style=app_commands.locale_str("Style to launch"))
+    @app_commands.choices(
+        style=[
+            app_commands.Choice(name=app_commands.locale_str("Scout"), value="scout"),
+            app_commands.Choice(name=app_commands.locale_str("Carrier"), value="carrier"),
+        ]
+    )
+    async def launch(interaction: discord.Interaction, style: app_commands.Choice[str]) -> None:
+        pass
+
+    fleet = app_commands.Group(
+        name=app_commands.locale_str("fleet"),
+        description=app_commands.locale_str("Fleet commands"),
+    )
+
+    @fleet.command(name=app_commands.locale_str("dock"), description=app_commands.locale_str("Dock a ship"))
+    @app_commands.rename(bay=app_commands.locale_str("dock-bay"))
+    @app_commands.describe(bay=app_commands.locale_str("Bay number"))
+    async def dock(interaction: discord.Interaction, bay: int) -> None:
+        pass
+
+    tree.add_command(fleet)
+
+    @tree.context_menu(name=app_commands.locale_str("Inspect Target"))
+    async def inspect_target(interaction: discord.Interaction, user: discord.User) -> None:
+        pass
+
+
+def add_simple_global_command(tree, *, name="ping", description="Ping command"):
+    @tree.command(name=app_commands.locale_str(name), description=app_commands.locale_str(description))
+    async def ping(interaction: discord.Interaction) -> None:
+        pass
+
+
+def add_simple_guild_command(tree, guild):
+    @tree.command(
+        name=app_commands.locale_str("guild-only"),
+        description=app_commands.locale_str("Guild command"),
+        guild=guild,
+    )
+    async def guild_only(interaction: discord.Interaction) -> None:
+        pass
+
+
+ALL_LOCALE_VALUES = {locale.value for locale in discord.Locale}
+
+
+def assert_translated_for_all_locales(translator, string, location):
+
+    seen = {
+        locale
+        for called_string, locale, called_location in translator.calls
+        if called_string == string and called_location == location
+    }
+    assert seen == ALL_LOCALE_VALUES
+
+
+def find_payload(payload, *, name, type=None):
+    for item in payload:
+        if item.get("name") == name and (type is None or item.get("type") == type):
+            return item
+    raise AssertionError(f"payload item not found: {name!r}")
+
+
+def assert_localizations(item, field, expected):
+
+    assert item.get(field) == expected
+
+
+def assert_no_localizations(item):
+
+    assert "name_localizations" not in item
+    assert "description_localizations" not in item
+
+
+@pytest.mark.asyncio
+async def test_global_sync_includes_localized_payload_for_commands_groups_params_choices_and_context_menus():
+
+
+
+    tree, http = make_tree()
+    add_full_global_command_set(tree)
+    translator = SelectiveTranslator()
+
+    assert tree.translator is None
+    await tree.set_translator(translator)
+    assert translator.loaded == 1
+    assert translator.unloaded == 0
+
+    synced = await tree.sync()
+
+    assert synced == []
+    for string, location in [
+        ("launch", "command_name"),
+        ("Launch a ship", "command_description"),
+        ("ship-style", "parameter_name"),
+        ("Style to launch", "parameter_description"),
+        ("Scout", "choice_name"),
+        ("Carrier", "choice_name"),
+        ("fleet", "group_name"),
+        ("Fleet commands", "group_description"),
+        ("dock", "command_name"),
+        ("Dock a ship", "command_description"),
+        ("dock-bay", "parameter_name"),
+        ("Bay number", "parameter_description"),
+        ("Inspect Target", "command_name"),
+    ]:
+        assert_translated_for_all_locales(translator, string, location)
+
+
+    assert len(http.calls) == 1
+    route, application_id, payload = http.calls[0]
+    assert route == "global"
+    assert application_id == APPLICATION_ID
+    assert len(payload) == 3
+
+    launch = find_payload(payload, name="launch", type=1)
+    assert launch["description"] == "Launch a ship"
+    assert_localizations(
+        launch,
+        "name_localizations",
+        {"de": "xlat:command_name:launch:de", "ja": "xlat:command_name:launch:ja"},
+    )
+    assert_localizations(
+        launch,
+        "description_localizations",
+        {
+            "de": "xlat:command_description:Launch a ship:de",
+            "ja": "xlat:command_description:Launch a ship:ja",
+        },
+    )
+    style = find_payload(launch["options"], name="ship-style", type=3)
+    assert style["description"] == "Style to launch"
+    assert_localizations(
+        style,
+        "name_localizations",
+        {"de": "xlat:parameter_name:ship-style:de", "ja": "xlat:parameter_name:ship-style:ja"},
+    )
+    assert_localizations(
+        style,
+        "description_localizations",
+        {
+            "de": "xlat:parameter_description:Style to launch:de",
+            "ja": "xlat:parameter_description:Style to launch:ja",
+        },
+    )
+    scout = find_payload(style["choices"], name="Scout")
+    carrier = find_payload(style["choices"], name="Carrier")
+    assert scout["value"] == "scout"
+    assert carrier["value"] == "carrier"
+    assert_localizations(
+        scout,
+        "name_localizations",
+        {"de": "xlat:choice_name:Scout:de", "ja": "xlat:choice_name:Scout:ja"},
+    )
+    assert_localizations(
+        carrier,
+        "name_localizations",
+        {"de": "xlat:choice_name:Carrier:de", "ja": "xlat:choice_name:Carrier:ja"},
+    )
+
+    fleet = find_payload(payload, name="fleet", type=1)
+    assert fleet["description"] == "Fleet commands"
+    assert_localizations(
+        fleet,
+        "name_localizations",
+        {"de": "xlat:group_name:fleet:de", "ja": "xlat:group_name:fleet:ja"},
+    )
+    assert_localizations(
+        fleet,
+        "description_localizations",
+        {"de": "xlat:group_description:Fleet commands:de", "ja": "xlat:group_description:Fleet commands:ja"},
+    )
+    dock = find_payload(fleet["options"], name="dock", type=1)
+    assert dock["description"] == "Dock a ship"
+    assert_localizations(
+        dock,
+        "name_localizations",
+        {"de": "xlat:command_name:dock:de", "ja": "xlat:command_name:dock:ja"},
+    )
+    assert_localizations(
+        dock,
+        "description_localizations",
+        {"de": "xlat:command_description:Dock a ship:de", "ja": "xlat:command_description:Dock a ship:ja"},
+    )
+    bay = find_payload(dock["options"], name="dock-bay", type=4)
+    assert bay["description"] == "Bay number"
+    assert_localizations(
+        bay,
+        "name_localizations",
+        {"de": "xlat:parameter_name:dock-bay:de", "ja": "xlat:parameter_name:dock-bay:ja"},
+    )
+    assert_localizations(
+        bay,
+        "description_localizations",
+        {"de": "xlat:parameter_description:Bay number:de", "ja": "xlat:parameter_description:Bay number:ja"},
+    )
+
+    inspect = find_payload(payload, name="Inspect Target", type=2)
+    assert_localizations(
+        inspect,
+        "name_localizations",
+        {"de": "xlat:command_name:Inspect Target:de", "ja": "xlat:command_name:Inspect Target:ja"},
+    )
+
+
+@pytest.mark.asyncio
+async def test_guild_sync_uses_guild_bulk_upsert_with_localized_payload():
+
+
+
+    guild = Guild()
+    tree, http = make_tree()
+    add_simple_guild_command(tree, guild)
+    translator = SelectiveTranslator()
+
+    await tree.set_translator(translator)
+    synced = await tree.sync(guild=guild)
+
+    assert synced == []
+    assert_translated_for_all_locales(translator, "guild-only", "command_name")
+    assert_translated_for_all_locales(translator, "Guild command", "command_description")
+
+
+    assert len(http.calls) == 1
+    route, application_id, guild_id, payload = http.calls[0]
+    assert route == "guild"
+    assert application_id == APPLICATION_ID
+    assert guild_id == GUILD_ID
+    assert len(payload) == 1
+    command = find_payload(payload, name="guild-only", type=1)
+    assert command["description"] == "Guild command"
+    assert_localizations(
+        command,
+        "name_localizations",
+        {"de": "xlat:command_name:guild-only:de", "ja": "xlat:command_name:guild-only:ja"},
+    )
+    assert_localizations(
+        command,
+        "description_localizations",
+        {
+            "de": "xlat:command_description:Guild command:de",
+            "ja": "xlat:command_description:Guild command:ja",
+        },
+    )
+
+
+@pytest.mark.asyncio
+async def test_translation_error_prevents_http_submission():
+
+
+
+    tree, http = make_tree()
+    add_simple_global_command(tree, name="fail", description="Fail command")
+    await tree.set_translator(FailingTranslator())
+
+    with pytest.raises(app_commands.TranslationError) as exc_info:
+        await tree.sync()
+
+    assert type(exc_info.value.__cause__) is RuntimeError
+
+    assert exc_info.value.string == app_commands.locale_str("fail")
+    assert exc_info.value.locale in set(discord.Locale)
+    assert http.calls == []
+
+
+@pytest.mark.asyncio
+async def test_sync_without_application_id_raises_missing_application_id_before_http():
+
+
+
+    tree, http = make_tree(application_id=None)
+    add_simple_global_command(tree, name="ping", description="Ping command")
+
+    with pytest.raises(app_commands.MissingApplicationID) as exc_info:
+        await tree.sync()
+
+
+    assert exc_info.type is app_commands.MissingApplicationID
+    assert http.calls == []
+
+
+@pytest.mark.asyncio
+async def test_set_translator_none_is_idempotent_cleanup():
+
+
+
+    tree, _ = make_tree()
+    translator = SelectiveTranslator()
+
+    assert tree.translator is None
+    await tree.set_translator(translator)
+    assert translator.loaded == 1
+    assert translator.unloaded == 0
+
+    await tree.set_translator(None)
+    assert tree.translator is None
+    assert translator.loaded == 1
+    assert translator.unloaded == 1
+
+    await tree.set_translator(None)
+    assert tree.translator is None
+    assert translator.loaded == 1
+    assert translator.unloaded == 1
+
+
+@pytest.mark.asyncio
+async def test_command_tree_translator_state_is_per_client_instance():
+
+
+
+    tree_a, http_a = make_tree()
+    tree_b, http_b = make_tree()
+    add_simple_global_command(tree_a, name="alpha", description="Alpha command")
+    add_simple_global_command(tree_b, name="beta", description="Beta command")
+    translator = SelectiveTranslator(prefix="a")
+
+    await tree_a.set_translator(translator)
+    synced_a = await tree_a.sync()
+    synced_b = await tree_b.sync()
+
+    assert synced_a == []
+    assert synced_b == []
+    assert translator.loaded == 1
+    assert translator.unloaded == 0
+    assert tree_b.translator is None
+    assert_translated_for_all_locales(translator, "alpha", "command_name")
+    assert_translated_for_all_locales(translator, "Alpha command", "command_description")
+
+
+    assert len(http_a.calls) == 1
+    route_a, application_id_a, payload_a = http_a.calls[0]
+    assert route_a == "global"
+    assert application_id_a == APPLICATION_ID
+    alpha = find_payload(payload_a, name="alpha", type=1)
+    assert alpha["description"] == "Alpha command"
+    assert_localizations(
+        alpha,
+        "name_localizations",
+        {"de": "a:command_name:alpha:de", "ja": "a:command_name:alpha:ja"},
+    )
+    assert_localizations(
+        alpha,
+        "description_localizations",
+        {"de": "a:command_description:Alpha command:de", "ja": "a:command_description:Alpha command:ja"},
+    )
+
+    assert len(http_b.calls) == 1
+    route_b, application_id_b, payload_b = http_b.calls[0]
+    assert route_b == "global"
+    assert application_id_b == APPLICATION_ID
+    beta = find_payload(payload_b, name="beta", type=1)
+    assert beta["description"] == "Beta command"
+    assert_no_localizations(beta)
+
+
+@pytest.mark.asyncio
+async def test_translator_install_use_cleanup_cycles_do_not_leave_translators_loaded():
+
+
+
+    translators = []
+    http_call_count = 0
+
+    for index in range(100):
+        tree, http = make_tree(application_id=APPLICATION_ID + index)
+        add_simple_global_command(tree, name=f"cycle-{index}", description="Cycle command")
+        translator = SelectiveTranslator()
+        await tree.set_translator(translator)
+        synced = await tree.sync()
+        await tree.set_translator(None)
+
+        assert synced == []
+        assert tree.translator is None
+        assert len(http.calls) == 1
+        translators.append(translator)
+        http_call_count += len(http.calls)
+
+    assert http_call_count == 100
+    assert sum(translator.loaded for translator in translators) == 100
+    assert sum(translator.unloaded for translator in translators) == 100
