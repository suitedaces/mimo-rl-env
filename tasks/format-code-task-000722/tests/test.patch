+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+export GO111MODULE=off
+SRC="$(go env GOPATH)/src/github.com/cortezaproject/corteza-server"
+cd "$SRC"
+
+
+go test ./compose/types/
+
+
+go test ./compose/decoder/
