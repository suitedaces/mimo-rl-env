diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,27 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+if [ ! -x node_modules/.bin/jest ] || \
+   ! node -e "require.resolve('intl-messageformat')" >/dev/null 2>&1 || \
+   (grep -q '"intl-pluralrules"' package.json && ! node -e "require.resolve('intl-pluralrules')" >/dev/null 2>&1); then
+  npm_config_loglevel=error npx --yes yarn@1.22.22 install --frozen-lockfile --ignore-engines --ignore-scripts --non-interactive
+fi
+
+TEST_FILE="lighthouse-core/test/lib/i18n/i18n-test.js"
+NEW_PATTERN='throws an error when values are needed but not provided|throws an error when a value is missing|throws an error when a plural control value is missing|throws contextual errors for longer messages with missing values|throws contextual errors for missing values inside plural branches|throws an error if a string value is used for a numeric placeholder|throws an error if undefined is used for a numeric placeholder|throws an error if a boolean value is used for a milliseconds placeholder|formats plural messages when Intl\.PluralRules is unavailable in the polyfill path'
+
+case "${1:-}" in
+  base)
+    node node_modules/.bin/jest "$TEST_FILE" --runInBand --testNamePattern="^(?!.*(${NEW_PATTERN})).*$"
+    ;;
+  new)
+    node node_modules/.bin/jest "$TEST_FILE" --runInBand --testNamePattern="$NEW_PATTERN"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
