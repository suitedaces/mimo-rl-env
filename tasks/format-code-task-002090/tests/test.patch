+import gc
+import socket
+import tracemalloc
+
+import pytest
+
+from octodns.record import Record
+from octodns.zone import Zone
+
+
+
+
+
+
+
+
+
+
+class Target:
+    SUPPORTS_GEO = False
+    SUPPORTS_DYNAMIC = False
+
+    def __init__(self, id='test', unsupported=()):
+        self.id = id
+        self.unsupported = set(unsupported)
+
+    def supports(self, record):
+        return record._type not in self.unsupported
+
+
+def make_zone(records):
+    zone = Zone('example.com.', [])
+    for name, data in records:
+        zone.add_record(Record.new(zone, name, data))
+    return zone
+
+
+def summarize_changes(changes):
+    return [
+        {
+            'class': change.__class__.__name__,
+
+
+            'existing_data': change.existing.data if change.existing else None,
+            'new_data': change.new.data if change.new else None,
+            'record_name': change.record.name,
+            'record_type': change.record._type,
+        }
+        for change in sorted(changes)
+    ]
+
+
+def summarize_records(zone):
+    return sorted((record.name, record._type, record.data) for record in zone.records)
+
+
+def test_changes_returns_delete_create_update_and_keeps_zones_unmodified():
+
+
+
+
+    existing = make_zone(
+        [
+            ('old', {'type': 'A', 'ttl': 300, 'value': '1.1.1.1'}),
+            ('same', {'type': 'A', 'ttl': 300, 'value': '4.4.4.4'}),
+            ('www', {'type': 'A', 'ttl': 300, 'value': '1.1.1.1'}),
+        ]
+    )
+    desired = make_zone(
+        [
+            ('new', {'type': 'A', 'ttl': 300, 'value': '3.3.3.3'}),
+            ('same', {'type': 'A', 'ttl': 300, 'value': '4.4.4.4'}),
+            ('www', {'type': 'A', 'ttl': 300, 'value': '2.2.2.2'}),
+        ]
+    )
+    target = Target()
+
+    expected = [
+        {
+            'class': 'Delete',
+            'existing_data': {'ttl': 300, 'value': '1.1.1.1'},
+            'new_data': None,
+            'record_name': 'old',
+            'record_type': 'A',
+        },
+        {
+            'class': 'Create',
+            'existing_data': None,
+            'new_data': {'ttl': 300, 'value': '3.3.3.3'},
+            'record_name': 'new',
+            'record_type': 'A',
+        },
+        {
+            'class': 'Update',
+            'existing_data': {'ttl': 300, 'value': '1.1.1.1'},
+            'new_data': {'ttl': 300, 'value': '2.2.2.2'},
+            'record_name': 'www',
+            'record_type': 'A',
+        },
+    ]
+    assert summarize_changes(existing.changes(desired, target)) == expected
+    assert summarize_changes(existing.changes(desired, target)) == expected
+    assert summarize_records(existing) == [
+        ('old', 'A', {'ttl': 300, 'value': '1.1.1.1'}),
+        ('same', 'A', {'ttl': 300, 'value': '4.4.4.4'}),
+        ('www', 'A', {'ttl': 300, 'value': '1.1.1.1'}),
+    ]
+    assert summarize_records(desired) == [
+        ('new', 'A', {'ttl': 300, 'value': '3.3.3.3'}),
+        ('same', 'A', {'ttl': 300, 'value': '4.4.4.4'}),
+        ('www', 'A', {'ttl': 300, 'value': '2.2.2.2'}),
+    ]
+
+
+def test_ignored_records_are_skipped_in_existing_and_desired_zones():
+
+
+
+
+    assert summarize_changes(
+        make_zone(
+            [
+                (
+                    'gone',
+                    {
+                        'type': 'A',
+                        'ttl': 60,
+                        'value': '9.9.9.9',
+                        'octodns': {'ignored': True},
+                    },
+                )
+            ]
+        ).changes(make_zone([]), Target())
+    ) == []
+    assert summarize_changes(
+        make_zone([]).changes(
+            make_zone(
+                [
+                    (
+                        'skip',
+                        {
+                            'type': 'A',
+                            'ttl': 60,
+                            'value': '9.9.9.9',
+                            'octodns': {'ignored': True},
+                        },
+                    )
+                ]
+            ),
+            Target(),
+        )
+    ) == []
+    assert summarize_changes(
+        make_zone(
+            [('www', {'type': 'A', 'ttl': 60, 'value': '1.1.1.1'})]
+        ).changes(
+            make_zone(
+                [
+                    (
+                        'www',
+                        {
+                            'type': 'A',
+                            'ttl': 60,
+                            'value': '2.2.2.2',
+                            'octodns': {'ignored': True},
+                        },
+                    )
+                ]
+            ),
+            Target(),
+        )
+    ) == []
+
+
+def test_included_and_excluded_metadata_filter_against_target_id():
+
+
+
+
+    assert summarize_changes(
+        make_zone([]).changes(
+            make_zone(
+                [
+                    (
+                        'match',
+                        {
+                            'type': 'A',
+                            'ttl': 60,
+                            'value': '5.5.5.5',
+                            'octodns': {'included': ['test']},
+                        },
+                    )
+                ]
+            ),
+            Target(),
+        )
+    ) == [
+        {
+            'class': 'Create',
+            'existing_data': None,
+            'new_data': {
+                'octodns': {'included': ['test']},
+                'ttl': 60,
+                'value': '5.5.5.5',
+            },
+            'record_name': 'match',
+            'record_type': 'A',
+        }
+    ]
+    assert summarize_changes(
+        make_zone([]).changes(
+            make_zone(
+                [
+                    (
+                        'nomatch',
+                        {
+                            'type': 'A',
+                            'ttl': 60,
+                            'value': '5.5.5.5',
+                            'octodns': {'included': ['other']},
+                        },
+                    )
+                ]
+            ),
+            Target(),
+        )
+    ) == []
+    assert summarize_changes(
+        make_zone([]).changes(
+            make_zone(
+                [
+                    (
+                        'excluded',
+                        {
+                            'type': 'A',
+                            'ttl': 60,
+                            'value': '5.5.5.5',
+                            'octodns': {'excluded': ['test']},
+                        },
+                    )
+                ]
+            ),
+            Target(),
+        )
+    ) == []
+
+
+def test_unsupported_missing_record_types_do_not_create_or_delete():
+
+
+
+
+    assert summarize_changes(
+        make_zone([]).changes(
+            make_zone(
+                [
+                    (
+                        'aaaa',
+                        {'type': 'AAAA', 'ttl': 60, 'value': '2001:db8::1'},
+                    )
+                ]
+            ),
+            Target(unsupported=('AAAA',)),
+        )
+    ) == []
+    assert summarize_changes(
+        make_zone(
+            [
+                (
+                    'aaaa',
+                    {'type': 'AAAA', 'ttl': 60, 'value': '2001:db8::1'},
+                )
+            ]
+        ).changes(make_zone([]), Target(unsupported=('AAAA',)))
+    ) == []
+
+
+def test_changes_requires_target_provider_shape_for_out_of_order_call():
+
+
+
+
+    existing = make_zone(
+        [('x', {'type': 'A', 'ttl': 30, 'value': '1.1.1.1'})]
+    )
+
+
+    with pytest.raises(Exception):
+        existing.changes(make_zone([]), object())
+
+
+def test_two_zone_instances_keep_independent_record_state():
+
+
+
+
+    first = make_zone(
+        [('one', {'type': 'A', 'ttl': 120, 'value': '10.0.0.1'})]
+    )
+    second = make_zone(
+        [('two', {'type': 'A', 'ttl': 180, 'value': '10.0.0.2'})]
+    )
+    first.add_record(
+        Record.new(
+            first, 'extra', {'type': 'A', 'ttl': 240, 'value': '10.0.0.3'}
+        )
+    )
+
+    assert summarize_records(first) == [
+        ('extra', 'A', {'ttl': 240, 'value': '10.0.0.3'}),
+        ('one', 'A', {'ttl': 120, 'value': '10.0.0.1'}),
+    ]
+    assert summarize_records(second) == [
+        ('two', 'A', {'ttl': 180, 'value': '10.0.0.2'})
+    ]
+    assert summarize_changes(first.changes(second, Target())) == [
+        {
+            'class': 'Delete',
+            'existing_data': {'ttl': 240, 'value': '10.0.0.3'},
+            'new_data': None,
+            'record_name': 'extra',
+            'record_type': 'A',
+        },
+        {
+            'class': 'Delete',
+            'existing_data': {'ttl': 120, 'value': '10.0.0.1'},
+            'new_data': None,
+            'record_name': 'one',
+            'record_type': 'A',
+        },
+        {
+            'class': 'Create',
+            'existing_data': None,
+            'new_data': {'ttl': 180, 'value': '10.0.0.2'},
+            'record_name': 'two',
+            'record_type': 'A',
+        },
+    ]
+
+
+def test_changes_does_not_open_files_or_sockets(monkeypatch):
+
+
+
+
+    existing = make_zone(
+        [('old', {'type': 'A', 'ttl': 300, 'value': '1.1.1.1'})]
+    )
+    desired = make_zone(
+        [('new', {'type': 'A', 'ttl': 300, 'value': '2.2.2.2'})]
+    )
+
+    def blocked_open(*args, **kwargs):
+        raise AssertionError('changes opened a file')
+
+    def blocked_socket(*args, **kwargs):
+        raise AssertionError('changes opened a socket')
+
+    monkeypatch.setattr('builtins.open', blocked_open)
+    monkeypatch.setattr(socket, 'socket', blocked_socket)
+
+    assert summarize_changes(existing.changes(desired, Target())) == [
+        {
+            'class': 'Delete',
+            'existing_data': {'ttl': 300, 'value': '1.1.1.1'},
+            'new_data': None,
+            'record_name': 'old',
+            'record_type': 'A',
+        },
+        {
+            'class': 'Create',
+            'existing_data': None,
+            'new_data': {'ttl': 300, 'value': '2.2.2.2'},
+            'record_name': 'new',
+            'record_type': 'A',
+        },
+    ]
+
+
+def test_repeated_construct_change_drop_cycles_keep_python_heap_bounded():
+
+
+
+
+    target = Target()
+
+    def run_cycle():
+        existing = make_zone(
+            [
+                ('old', {'type': 'A', 'ttl': 300, 'value': '1.1.1.1'}),
+                ('www', {'type': 'A', 'ttl': 300, 'value': '1.1.1.1'}),
+            ]
+        )
+        desired = make_zone(
+            [
+                ('new', {'type': 'A', 'ttl': 300, 'value': '2.2.2.2'}),
+                ('www', {'type': 'A', 'ttl': 300, 'value': '2.2.2.2'}),
+            ]
+        )
+        assert summarize_changes(existing.changes(desired, target)) == [
+            {
+                'class': 'Delete',
+                'existing_data': {'ttl': 300, 'value': '1.1.1.1'},
+                'new_data': None,
+                'record_name': 'old',
+                'record_type': 'A',
+            },
+            {
+                'class': 'Create',
+                'existing_data': None,
+                'new_data': {'ttl': 300, 'value': '2.2.2.2'},
+                'record_name': 'new',
+                'record_type': 'A',
+            },
+            {
+                'class': 'Update',
+                'existing_data': {'ttl': 300, 'value': '1.1.1.1'},
+                'new_data': {'ttl': 300, 'value': '2.2.2.2'},
+                'record_name': 'www',
+                'record_type': 'A',
+            },
+        ]
+
+    run_cycle()
+    gc.collect()
+    tracemalloc.start()
+    before = tracemalloc.get_traced_memory()[0]
+    for _ in range(150):
+        run_cycle()
+    gc.collect()
+    after = tracemalloc.get_traced_memory()[0]
+    tracemalloc.stop()
+
+    assert before == 0
+    assert after - before < 120_000
