+"use strict";
+
+const prettier = require("../../");
+
+function format(src) {
+  return prettier.format(src, { parser: "babylon" });
+}
+
+describe("NewExpression with multiline tagged template arg stays inline", () => {
+  test("throw new Error(tag`multi-line`) keeps single-arg call inline", () => {
+    const input =
+      "throw new Error(formatErrorMessage`\n" +
+      "    This a really bad error.\n" +
+      "    \n" +
+      "    Which has more than one line.\n" +
+      "`)\n";
+    const expected =
+      "throw new Error(formatErrorMessage`\n" +
+      "    This a really bad error.\n" +
+      "    \n" +
+      "    Which has more than one line.\n" +
+      "`);\n";
+    expect(format(input)).toBe(expected);
+  });
+
+  test("new Error(tag`multi-line`) does not split args onto new line", () => {
+    const input =
+      "new Error(formatErrorMessage`\n" +
+      "    multi\n" +
+      "    line\n" +
+      "`)\n";
+    const output = format(input);
+
+    expect(output).not.toMatch(/new Error\(\n\s+formatErrorMessage/);
+
+    expect(output).toMatch(/new Error\(formatErrorMessage`/);
+  });
+
+  test("new with untagged multiline template literal stays inline", () => {
+    const input =
+      "new Error(`\n" +
+      "    multi\n" +
+      "    line\n" +
+      "`)\n";
+    const output = format(input);
+    expect(output).toMatch(/new Error\(`/);
+    expect(output).not.toMatch(/new Error\(\n/);
+  });
+});
+
+describe("Chained CallExpression with multiline tagged template still breaks chain", () => {
+  test("func1(func2(func3(tag`multi`))) breaks outer calls but keeps template inline", () => {
+    const input =
+      "func1(func2(func3(formatErrorMessage`\n" +
+      "    This a really bad error.\n" +
+      "    \n" +
+      "    Which has more than one line.\n" +
+      "`)))\n";
+    const expected =
+      "func1(\n" +
+      "  func2(\n" +
+      "    func3(formatErrorMessage`\n" +
+      "    This a really bad error.\n" +
+      "    \n" +
+      "    Which has more than one line.\n" +
+      "`)\n" +
+      "  )\n" +
+      ");\n";
+    expect(format(input)).toBe(expected);
+  });
+});
+
+describe("Preservation of existing NewExpression behavior", () => {
+  test("new with many long args still breaks across lines", () => {
+    const input =
+      "new LongLongClassName(argOne, argTwo, argThree, argFour, argFive, argSix, argSeven)\n";
+    const output = format(input);
+
+    expect(output).toMatch(/new LongLongClassName\(\n\s+argOne,\n\s+argTwo,/);
+  });
+
+  test("new with short args stays on one line", () => {
+    expect(format("new Foo()\n")).toBe("new Foo();\n");
+    expect(format("new Foo(a, b)\n")).toBe("new Foo(a, b);\n");
+  });
+
+  test("single-line tagged template arg remains inline (CallExpression)", () => {
+    expect(format("f(`single line`)\n")).toBe("f(`single line`);\n");
+  });
+
+  test("single-arg multiline tagged template in CallExpression stays inline", () => {
+    const input =
+      "f(tag`\n" +
+      "    multi\n" +
+      "    line\n" +
+      "`)\n";
+    const expected =
+      "f(tag`\n" +
+      "    multi\n" +
+      "    line\n" +
+      "`);\n";
+    expect(format(input)).toBe(expected);
+  });
+});
