+python -m pytest --no-cov -v -rA tests/unit/test_deprecation_warning_issue.py::TestValidateRequestDeprecationWarning::test_no_warning_when_result_discarded tests/unit/test_deprecation_warning_issue.py::TestValidateRequestDeprecationWarning::test_returns_usable_result tests/unit/test_deprecation_warning_issue.py::TestValidateRequestDeprecationWarning::test_warns_on_result_use tests/unit/test_deprecation_warning_issue.py::TestValidateResponseDeprecationWarning::test_no_warning_when_result_discarded tests/unit/test_deprecation_warning_issue.py::TestValidateResponseDeprecationWarning::test_returns_usable_result tests/unit/test_deprecation_warning_issue.py::TestValidateResponseDeprecationWarning::test_warns_on_result_use tests/unit/test_deprecation_warning_issue.py::TestIssueExactReproduction::test_documented_usage_does_not_raise_deprecation_warning
+rc=$(( rc | $? ))
+exit $rc
