diff --git a/tests/unit/test_deprecation_warning_issue.py b/tests/unit/test_deprecation_warning_issue.py
new file mode 100644
index 0000000..1b67612
--- /dev/null
+++ b/tests/unit/test_deprecation_warning_issue.py
@@ -0,0 +1,147 @@
+
+
+
+
+
+
+
+import warnings
+
+import pytest
+
+from openapi_core import Spec
+from openapi_core import validate_request
+from openapi_core import validate_response
+from openapi_core.testing import MockRequest
+from openapi_core.testing import MockResponse
+
+
+SPEC_DICT = {
+    "openapi": "3.0.3",
+    "info": {"title": "test", "version": "0"},
+    "paths": {
+        "/test": {"post": {"responses": {"200": {"description": ""}}}},
+    },
+}
+
+
+@pytest.fixture
+def spec():
+    return Spec.from_dict(SPEC_DICT)
+
+
+@pytest.fixture
+def request_():
+    return MockRequest("http://localhost/", "post", "/test")
+
+
+@pytest.fixture
+def response():
+    return MockResponse("")
+
+
+def _get_deprecation_messages(records):
+    return [
+        str(r.message)
+        for r in records
+        if issubclass(r.category, DeprecationWarning)
+    ]
+
+
+class TestValidateRequestDeprecationWarning:
+    def test_no_warning_when_result_discarded(self, spec, request_):
+
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            validate_request(request_, spec=spec)
+
+        msgs = _get_deprecation_messages(w)
+        assert not any(
+            "validate_request is deprecated" in m for m in msgs
+        ), f"Unexpected DeprecationWarning emitted: {msgs}"
+
+    def test_returns_usable_result(self, spec, request_):
+
+
+
+
+        result = validate_request(request_, spec=spec)
+
+        assert result is not None
+
+        assert list(result.errors) == []
+
+    def test_warns_on_result_use(self, spec, request_):
+
+
+
+
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            result = validate_request(request_, spec=spec)
+
+            list(result.errors)
+
+        msgs = _get_deprecation_messages(w)
+        assert any(
+            "validate_request is deprecated" in m for m in msgs
+        ), (
+            "Expected a DeprecationWarning about validate_request when "
+            f"the result is used. Got: {msgs}"
+        )
+
+
+class TestValidateResponseDeprecationWarning:
+    def test_no_warning_when_result_discarded(
+        self, spec, request_, response
+    ):
+
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            validate_response(request_, response, spec=spec)
+
+        msgs = _get_deprecation_messages(w)
+        assert not any(
+            "validate_response is deprecated" in m for m in msgs
+        ), f"Unexpected DeprecationWarning emitted: {msgs}"
+
+    def test_returns_usable_result(self, spec, request_, response):
+
+        result = validate_response(request_, response, spec=spec)
+        assert result is not None
+        assert list(result.errors) == []
+
+    def test_warns_on_result_use(self, spec, request_, response):
+
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            result = validate_response(request_, response, spec=spec)
+            list(result.errors)
+
+        msgs = _get_deprecation_messages(w)
+        assert any(
+            "validate_response is deprecated" in m for m in msgs
+        ), (
+            "Expected a DeprecationWarning about validate_response when "
+            f"the result is used. Got: {msgs}"
+        )
+
+
+class TestIssueExactReproduction:
+
+
+    def test_documented_usage_does_not_raise_deprecation_warning(self):
+        spec = Spec.from_dict(SPEC_DICT)
+        request = MockRequest("http://localhost/", "post", "/test")
+        response = MockResponse("")
+
+
+
+        with warnings.catch_warnings():
+            warnings.simplefilter("error", DeprecationWarning)
+            validate_request(request, spec=spec)
+            validate_response(request, response, spec=spec)
