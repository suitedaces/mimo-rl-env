diff --git a/packages/eslint-plugin/tests/rules/no-deprecated-private-identifier.test.ts b/packages/eslint-plugin/tests/rules/no-deprecated-private-identifier.test.ts
new file mode 100644
index 000000000..1dcc32d3f
--- /dev/null
+++ b/packages/eslint-plugin/tests/rules/no-deprecated-private-identifier.test.ts
@@ -0,0 +1,178 @@
+import { RuleTester } from '@typescript-eslint/rule-tester';
+
+import rule from '../../src/rules/no-deprecated';
+import { getFixturesRootDir } from '../RuleTester';
+
+const rootDir = getFixturesRootDir();
+const ruleTester = new RuleTester({
+  languageOptions: {
+    parserOptions: {
+      ecmaFeatures: {
+        jsx: true,
+      },
+      project: './tsconfig.json',
+      tsconfigRootDir: rootDir,
+    },
+  },
+});
+
+ruleTester.run('no-deprecated', rule, {
+  valid: [
+
+    `
+      class T {
+        /** @deprecated */
+        #foo = () => {};
+      }
+    `,
+
+    `
+      class T {
+        #foo = () => {};
+
+        bar() {
+          this.#foo();
+        }
+      }
+    `,
+
+    `
+      class T {
+        /** @deprecated */
+        #foo = () => {};
+
+        #bar = () => {};
+
+        baz() {
+          this.#bar();
+        }
+      }
+    `,
+  ],
+  invalid: [
+
+    {
+      code: `
+class T {
+  /** @deprecated */
+  #foo = () => {
+    // ...
+  };
+
+  bar() {
+    this.#foo();
+  }
+}
+      `,
+      errors: [
+        {
+          data: { name: '#foo' },
+          line: 9,
+          messageId: 'deprecated',
+        },
+      ],
+    },
+
+    {
+      code: `
+class T {
+  /** @deprecated */
+  #foo = 1;
+
+  bar() {
+    return this.#foo;
+  }
+}
+      `,
+      errors: [
+        {
+          data: { name: '#foo' },
+          line: 7,
+          messageId: 'deprecated',
+        },
+      ],
+    },
+
+    {
+      code: `
+class T {
+  /** @deprecated */
+  #foo() {
+    return 1;
+  }
+
+  bar() {
+    return this.#foo();
+  }
+}
+      `,
+      errors: [
+        {
+          data: { name: '#foo' },
+          line: 9,
+          messageId: 'deprecated',
+        },
+      ],
+    },
+
+    {
+      code: `
+class T {
+  /** @deprecated use bar instead */
+  #foo = () => {};
+
+  bar() {
+    this.#foo();
+  }
+}
+      `,
+      errors: [
+        {
+          data: { name: '#foo', reason: 'use bar instead' },
+          line: 7,
+          messageId: 'deprecatedWithReason',
+        },
+      ],
+    },
+
+    {
+      code: `
+class T {
+  /** @deprecated */
+  static #foo = () => {};
+
+  static bar() {
+    T.#foo();
+  }
+}
+      `,
+      errors: [
+        {
+          data: { name: '#foo' },
+          line: 7,
+          messageId: 'deprecated',
+        },
+      ],
+    },
+
+    {
+      code: `
+class T {
+  /** @deprecated */
+  #foo = 1;
+
+  bar(o: unknown) {
+    return #foo in (o as object);
+  }
+}
+      `,
+      errors: [
+        {
+          data: { name: '#foo' },
+          line: 7,
+          messageId: 'deprecated',
+        },
+      ],
+    },
+  ],
+});
