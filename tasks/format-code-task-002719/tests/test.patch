diff --git a/test/dialects/snowflake_test.py b/test/dialects/snowflake_test.py
index 9600c3534..52d7a4d0c 100644
--- a/test/dialects/snowflake_test.py
+++ b/test/dialects/snowflake_test.py
@@ -69,3 +69,56 @@ def test_snowflake_queries(segment_cls, raw, caplog):
     child_segments = [seg for seg in parsed.tree.recursive_crawl(seg_type)]
     assert len(child_segments) > 0
     # If we get here the raw statement was parsed as expected
+
+
+
+
+
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+
+
+        "ALTER TABLE SAMPLE_DB.SAMPLE_SCHEMA.MY_TABLE UNSET COMMENT;",
+
+        "ALTER TABLE my_table UNSET COMMENT;",
+
+        "ALTER TABLE my_table UNSET DATA_RETENTION_TIME_IN_DAYS;",
+
+
+        "ALTER TABLE my_table UNSET COMMENT, DATA_RETENTION_TIME_IN_DAYS;",
+
+        "ALTER TABLE my_table UNSET DATA_RETENTION_TIME_IN_DAYS, "
+        "DEFAULT_DDL_COLLATION;",
+    ],
+)
+def test_snowflake_alter_table_unset_parses(raw):
+    """ALTER TABLE ... UNSET <options> should parse for Snowflake."""
+    lnt = Linter(dialect="snowflake")
+    parsed = lnt.parse_string(raw)
+    assert parsed.violations == [], (
+        f"Unexpected parse violations for {raw!r}: {parsed.violations}"
+    )
+    assert "unparsable" not in parsed.tree.type_set()
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+
+        "ALTER TABLE my_table SET COMMENT = 'my table comment';",
+
+        "ALTER SESSION UNSET ERROR_ON_NONDETERMINISTIC_MERGE;",
+        "ALTER SESSION UNSET TIME_OUTPUT_FORMAT, TWO_DIGIT_CENTURY_START;",
+    ],
+)
+def test_snowflake_alter_unset_preservation(raw):
+    """Previously-working SET/UNSET statements should still parse cleanly."""
+    lnt = Linter(dialect="snowflake")
+    parsed = lnt.parse_string(raw)
+    assert parsed.violations == [], (
+        f"Unexpected parse violations for {raw!r}: {parsed.violations}"
+    )
+    assert "unparsable" not in parsed.tree.type_set()
