+async def test_serviceregistry_supports_response_mixed_case(
+    hass: HomeAssistant,
+) -> None:
+    """Test supports_response is case-insensitive (regression test)."""
+
+    async def service_handler(call: ServiceCall) -> ServiceResponse:
+        return {"foo": "bar"}
+
+    hass.services.async_register(
+        "test_domain",
+        "Test_Service",
+        service_handler,
+        supports_response=SupportsResponse.OPTIONAL,
+    )
+
+
+
+    assert (
+        hass.services.supports_response("test_domain", "Test_Service")
+        == SupportsResponse.OPTIONAL
+    )
+
+    assert (
+        hass.services.supports_response("test_domain", "test_service")
+        == SupportsResponse.OPTIONAL
+    )
+
+    assert (
+        hass.services.supports_response("Test_Domain", "Test_Service")
+        == SupportsResponse.OPTIONAL
+    )
+
+
 async def test_config_defaults() -> None:
     """Test config defaults."""
     hass = Mock()
