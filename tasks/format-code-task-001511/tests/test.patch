--- a/tests/helpers/test_service.py
+++ b/tests/helpers/test_service.py
@@ -762,6 +762,85 @@ async def test_async_get_all_descriptions_dynamically_created_services(
     }
 
 
+async def test_async_set_service_schema_mixed_case_service(
+    hass: HomeAssistant,
+) -> None:
+    """Test async_set_service_schema with a mixed-case service name.
+
+    Regression test for
+    https://github.com/home-assistant/core/issues/95957 - services with
+    upper case characters fail to register schema.
+    """
+    logger = hass.components.logger
+    await async_setup_component(hass, logger.DOMAIN, {logger.DOMAIN: {}})
+
+
+    hass.services.async_register(
+        logger.DOMAIN,
+        "Callibrate",
+        lambda x: None,
+        None,
+        SupportsResponse.OPTIONAL,
+    )
+
+
+    service.async_set_service_schema(
+        hass,
+        logger.DOMAIN,
+        "Callibrate",
+        {"description": "calibrate the sensor", "fields": {}},
+    )
+
+    descriptions = await service.async_get_all_descriptions(hass)
+
+
+    assert "callibrate" in descriptions[logger.DOMAIN]
+
+
+
+    assert (
+        descriptions[logger.DOMAIN]["callibrate"]["description"]
+        == "calibrate the sensor"
+    )
+    assert descriptions[logger.DOMAIN]["callibrate"]["response"] == {
+        "optional": True
+    }
+
+
+async def test_async_set_service_schema_mixed_case_domain(
+    hass: HomeAssistant,
+) -> None:
+    """Test async_set_service_schema with a mixed-case domain name."""
+    logger = hass.components.logger
+    await async_setup_component(hass, logger.DOMAIN, {logger.DOMAIN: {}})
+
+
+    hass.services.async_register(
+        "Logger",
+        "mixed_domain_service",
+        lambda x: None,
+        None,
+    )
+
+
+
+    service.async_set_service_schema(
+        hass,
+        "Logger",
+        "mixed_domain_service",
+        {"description": "domain-cased schema"},
+    )
+
+    descriptions = await service.async_get_all_descriptions(hass)
+
+    assert "logger" in descriptions
+    assert "mixed_domain_service" in descriptions["logger"]
+    assert (
+        descriptions["logger"]["mixed_domain_service"]["description"]
+        == "domain-cased schema"
+    )
+
+
