+import { describe, expect, test } from '@jest/globals'
+import { functionFormula } from '@toddledev/core/dist/formula/formulaUtils'
+import {
+  hasCustomCode,
+  takeReferencedFormulasAndActions,
+} from './codeRefs'
+
+
+
+const codeFormula = (name: string) => ({
+  name,
+  arguments: [],
+  handler: `return '${name}'`,
+})
+
+const customAction = (name: string) => ({
+  name,
+  arguments: [],
+  variableArguments: false,
+  handler: `console.log('${name}')`,
+})
+
+
+const usesFormula = (name: string) => ({
+  variables: { [`var_${name}`]: { initialValue: functionFormula(name) } },
+})
+
+
+const usesAction = (name: string) => ({
+  onLoad: {
+    trigger: 'load',
+    actions: [{ type: 'Custom' as const, name, arguments: [] }],
+  },
+})
+
+const baseComponent = (name: string, extra: any = {}) => ({
+  name,
+  apis: {},
+  attributes: {},
+  variables: {},
+  workflows: {},
+  nodes: {},
+  ...extra,
+})
+
+const componentNode = (name: string, packageName?: string) => ({
+  type: 'component' as const,
+  name,
+  ...(packageName ? { package: packageName } : {}),
+  children: [],
+  attrs: {},
+  events: {},
+})
+
+
+
+
+
+
+
+
+
+
+const buildFiles = (): any => ({
+  formulas: {
+    projFormulaUsed: codeFormula('projFormulaUsed'),
+    projFormulaUnused: codeFormula('projFormulaUnused'),
+  },
+  actions: {
+    projActionUsed: customAction('projActionUsed'),
+    projActionUnused: customAction('projActionUnused'),
+  },
+  components: {
+    Page: baseComponent('Page', {
+      ...usesAction('projActionUsed'),
+      nodes: {
+        a: componentNode('Child'),
+        b: componentNode('Widget', 'pkgA'),
+      },
+    }),
+    Child: baseComponent('Child', usesFormula('projFormulaUsed')),
+  },
+  packages: {
+    pkgA: {
+      manifest: { name: 'pkgA', commit: 'x' },
+      components: {
+        Widget: baseComponent('Widget', {
+          ...usesFormula('pkgFormulaA'),
+          ...usesAction('pkgActionA'),
+        }),
+      },
+      formulas: {
+        pkgFormulaA: codeFormula('pkgFormulaA'),
+        pkgFormulaUnusedA: codeFormula('pkgFormulaUnusedA'),
+      },
+      actions: {
+        pkgActionA: customAction('pkgActionA'),
+      },
+    },
+    pkgB: {
+      manifest: { name: 'pkgB', commit: 'y' },
+      components: {},
+      formulas: { pkgFormulaB: codeFormula('pkgFormulaB') },
+      actions: { pkgActionB: customAction('pkgActionB') },
+    },
+  },
+})
+
+const keys = (o: Record<string, unknown>) => Object.keys(o).sort()
+
+describe('takeReferencedFormulasAndActions', () => {
+  test('with no entry component it returns every project and package definition', () => {
+    const files = buildFiles()
+    const result = takeReferencedFormulasAndActions({
+      component: undefined,
+      files,
+    })
+
+    expect(keys(result.__PROJECT__.formulas)).toEqual([
+      'projFormulaUnused',
+      'projFormulaUsed',
+    ])
+    expect(keys(result.__PROJECT__.actions)).toEqual([
+      'projActionUnused',
+      'projActionUsed',
+    ])
+
+
+    expect(keys(result.pkgA.formulas)).toEqual([
+      'pkgFormulaA',
+      'pkgFormulaUnusedA',
+    ])
+    expect(keys(result.pkgA.actions)).toEqual(['pkgActionA'])
+    expect(keys(result.pkgB.formulas)).toEqual(['pkgFormulaB'])
+    expect(keys(result.pkgB.actions)).toEqual(['pkgActionB'])
+  })
+
+  test('with an entry component it returns only the reachable code', () => {
+    const files = buildFiles()
+    const result = takeReferencedFormulasAndActions({
+      component: files.components.Page,
+      files,
+    })
+
+
+    expect(keys(result.__PROJECT__.formulas)).toEqual(['projFormulaUsed'])
+    expect(keys(result.__PROJECT__.actions)).toEqual(['projActionUsed'])
+
+
+    expect(keys(result.pkgA.formulas)).toEqual(['pkgFormulaA'])
+    expect(keys(result.pkgA.actions)).toEqual(['pkgActionA'])
+
+
+    expect(result.pkgB).toBeUndefined()
+  })
+
+  test('the returned definitions are the original formula/action objects', () => {
+    const files = buildFiles()
+    const result = takeReferencedFormulasAndActions({
+      component: files.components.Page,
+      files,
+    })
+
+    expect(result.__PROJECT__.formulas.projFormulaUsed).toMatchObject({
+      name: 'projFormulaUsed',
+      handler: "return 'projFormulaUsed'",
+    })
+    expect(result.__PROJECT__.actions.projActionUsed).toMatchObject({
+      name: 'projActionUsed',
+      handler: "console.log('projActionUsed')",
+    })
+    expect(result.pkgA.formulas.pkgFormulaA).toMatchObject({
+      name: 'pkgFormulaA',
+    })
+    expect(result.pkgA.actions.pkgActionA).toMatchObject({
+      name: 'pkgActionA',
+    })
+  })
+
+  test('the __PROJECT__ group is always present, even when empty', () => {
+    const files = buildFiles()
+    const lonely = baseComponent('Lonely', usesFormula('doesNotExist'))
+    const result = takeReferencedFormulasAndActions({
+      component: lonely,
+      files,
+    })
+
+    expect(result.__PROJECT__).toBeDefined()
+    expect(keys(result.__PROJECT__.formulas)).toEqual([])
+    expect(keys(result.__PROJECT__.actions)).toEqual([])
+  })
+
+  test('references to unknown formulas/actions contribute nothing', () => {
+    const files = buildFiles()
+    const ghost = baseComponent('Ghost', {
+      ...usesFormula('ghostFormula'),
+      ...usesAction('ghostAction'),
+    })
+    const result = takeReferencedFormulasAndActions({ component: ghost, files })
+
+    expect(keys(result.__PROJECT__.formulas)).toEqual([])
+    expect(keys(result.__PROJECT__.actions)).toEqual([])
+
+    expect(result.pkgA).toBeUndefined()
+    expect(result.pkgB).toBeUndefined()
+  })
+})
+
+describe('hasCustomCode', () => {
+  test('returns true when a project formula/action is referenced', () => {
+    const files = buildFiles()
+    expect(hasCustomCode(files.components.Page, files)).toBe(true)
+  })
+
+  test('returns true when only package code is referenced', () => {
+    const files = buildFiles()
+    const onlyPkg = baseComponent('OnlyPkg', {
+      nodes: { w: componentNode('Widget', 'pkgA') },
+    })
+    expect(hasCustomCode(onlyPkg, files)).toBe(true)
+  })
+
+  test('returns false when nothing custom is referenced', () => {
+    const files = buildFiles()
+    const plain = baseComponent('Plain', usesFormula('builtInLikeThing'))
+    expect(hasCustomCode(plain, files)).toBe(false)
+  })
+})
