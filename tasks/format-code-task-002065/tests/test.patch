+cd /testbed
+
+
+export PATH="$PATH:/root/.bun/bin"
+
+
+
+
+(cd packages/core && bun run build)
+
+
+bun test \
+    packages/ssr/src/components/utils.test.ts \
+    packages/ssr/src/routing/routing.test.ts
+
+
+bun test packages/ssr/src/custom-code/codeRefs.test.ts
