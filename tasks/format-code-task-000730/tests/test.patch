diff --git a/memiavl/load_version_test.go b/memiavl/load_version_test.go
new file mode 100644
index 00000000..a63759aa
--- /dev/null
+++ b/memiavl/load_version_test.go
@@ -0,0 +1,60 @@
+package memiavl
+
+import (
+	"strconv"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+
+
+
+
+func TestLoadTargetVersion(t *testing.T) {
+	dir := t.TempDir()
+	db, err := Load(dir, Options{
+		CreateIfMissing: true,
+		InitialStores:   []string{"test"},
+	})
+	require.NoError(t, err)
+
+
+	hashes := make(map[int64][]byte)
+	for _, changes := range ChangeSets {
+		cs := []*NamedChangeSet{{Name: "test", Changeset: changes}}
+		hash, v, err := db.Commit(cs)
+		require.NoError(t, err)
+		hashes[v] = hash
+	}
+	latest := db.Version()
+	require.Equal(t, int64(len(ChangeSets)), latest)
+	require.NoError(t, db.Close())
+
+
+	tmp, err := Load(dir, Options{})
+	require.NoError(t, err)
+	require.Equal(t, latest, tmp.Version())
+	require.Equal(t, hashes[latest], tmp.Hash())
+	require.NoError(t, tmp.Close())
+
+
+	for v := int64(1); v <= latest; v++ {
+		v := v
+		t.Run(strconv.FormatInt(v, 10), func(t *testing.T) {
+			tmp, err := Load(dir, Options{TargetVersion: uint32(v)})
+			require.NoError(t, err)
+			require.Equal(t, v, tmp.Version())
+			require.Equal(t, hashes[v], tmp.Hash())
+			require.NoError(t, tmp.Close())
+		})
+	}
+
+
+
+	tmp, err = Load(dir, Options{})
+	require.NoError(t, err)
+	require.Equal(t, latest, tmp.Version())
+	require.Equal(t, hashes[latest], tmp.Hash())
+	require.NoError(t, tmp.Close())
+}
