diff --git a/usercase-test-coderl/duration_iso.test.js b/usercase-test-coderl/duration_iso.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/duration_iso.test.js
@@ -0,0 +1,196 @@
+const assert = require('assert');
+
+const moment = require('/workspace/repo/build/umd/moment.js');
+
+
+
+
+
+
+
+
+
+
+function test(name, fn) {
+    try {
+        fn();
+        console.log('ok - ' + name);
+    } catch (err) {
+        console.error('not ok - ' + name);
+        throw err;
+    }
+}
+
+function parseIsoDurationComponents(isoString) {
+    const match = /^([+-])?P(?:([+-]?\d+(?:\.\d+)?)Y)?(?:([+-]?\d+(?:\.\d+)?)M)?(?:([+-]?\d+(?:\.\d+)?)D)?(?:T(?:([+-]?\d+(?:\.\d+)?)H)?(?:([+-]?\d+(?:\.\d+)?)M)?(?:([+-]?\d+(?:\.\d+)?)S)?)?$/.exec(
+        isoString
+    );
+
+    assert.ok(match, 'expected an ISO 8601 duration string, got ' + isoString);
+
+    const globalSign = match[1] === '-' ? -1 : 1;
+    return {
+        years: match[2] === undefined ? 0 : globalSign * Number(match[2]),
+        months: match[3] === undefined ? 0 : globalSign * Number(match[3]),
+        days: match[4] === undefined ? 0 : globalSign * Number(match[4]),
+        hours: match[5] === undefined ? 0 : globalSign * Number(match[5]),
+        minutes: match[6] === undefined ? 0 : globalSign * Number(match[6]),
+        seconds: match[7] === undefined ? 0 : globalSign * Number(match[7]),
+    };
+}
+
+test('serializes zero and positive day-time buckets as ISO durations', function () {
+
+
+    assert.strictEqual(moment.duration(0).toISOString(), 'P0D');
+    assert.strictEqual(
+        moment
+            .duration({
+                days: 1,
+                hours: 2,
+                minutes: 3,
+                seconds: 4,
+                milliseconds: 5,
+            })
+            .toISOString(),
+        'P1DT2H3M4.005S'
+    );
+});
+
+test('keeps month buckets separate from day and time buckets', function () {
+
+
+    assert.strictEqual(
+        moment.duration({ months: 14 }).toISOString(),
+        'P1Y2M'
+    );
+    assert.strictEqual(
+        moment.duration({ months: 16, days: 40, seconds: 86465 }).toISOString(),
+        'P1Y4M40DT24H1M5S'
+    );
+});
+
+test('preserves independent sign rules for mixed internal buckets', function () {
+
+
+
+    assert.deepStrictEqual(
+        parseIsoDurationComponents(
+            moment.duration({ years: -1, hours: 1 }).toISOString()
+        ),
+        { years: -1, months: 0, days: 0, hours: 1, minutes: 0, seconds: 0 }
+    );
+
+    assert.deepStrictEqual(
+        parseIsoDurationComponents(
+            moment.duration({ years: -1, days: 2 }).toISOString()
+        ),
+        { years: -1, months: 0, days: 2, hours: 0, minutes: 0, seconds: 0 }
+    );
+
+    assert.deepStrictEqual(
+        parseIsoDurationComponents(
+            moment
+                .duration({ years: -1, hours: 1, seconds: -1 })
+                .toISOString()
+        ),
+        { years: -1, months: 0, days: 0, hours: 0, minutes: 59, seconds: 59 }
+    );
+
+    assert.deepStrictEqual(
+        parseIsoDurationComponents(
+            moment
+                .duration({
+                    months: 2,
+                    days: -3,
+                    hours: 4,
+                    minutes: -5,
+                    milliseconds: 6,
+                })
+                .toISOString()
+        ),
+        {
+            years: 0,
+            months: 2,
+            days: -3,
+            hours: 3,
+            minutes: 55,
+            seconds: 0.006,
+        }
+    );
+});
+
+test('returns localized invalid-date text for invalid durations', function () {
+
+
+    const invalid = moment.duration.invalid();
+    const invalidDateText = invalid.localeData().invalidDate();
+
+
+    assert.strictEqual(invalidDateText, 'Invalid date');
+    assert.strictEqual(invalid.toISOString(), invalidDateText);
+    assert.strictEqual(invalid.toString(), invalidDateText);
+    assert.strictEqual(invalid.toJSON(), invalidDateText);
+});
+
+test('toString, implicit String, and toJSON expose the same ISO value', function () {
+
+
+    const duration = moment.duration({
+        days: 1,
+        hours: 2,
+        minutes: 3,
+        seconds: 4,
+        milliseconds: 5,
+    });
+
+    assert.strictEqual(duration.toISOString(), 'P1DT2H3M4.005S');
+    assert.strictEqual(duration.toString(), 'P1DT2H3M4.005S');
+    assert.strictEqual(String(duration), 'P1DT2H3M4.005S');
+    assert.strictEqual(duration.toJSON(), 'P1DT2H3M4.005S');
+    assert.strictEqual(
+        JSON.stringify({ elapsed: duration }),
+        '{"elapsed":"P1DT2H3M4.005S"}'
+    );
+});
+
+test('toIsoString delegates to the serializer and emits its deprecation warning', function () {
+
+
+    const oldSuppress = moment.suppressDeprecationWarnings;
+    const oldHandler = moment.deprecationHandler;
+    const warnings = [];
+
+    moment.suppressDeprecationWarnings = true;
+    moment.deprecationHandler = function (name, msg) {
+        warnings.push({ name: name, msg: msg });
+    };
+
+    try {
+        assert.strictEqual(
+            moment.duration({ months: 14 }).toIsoString(),
+            'P1Y2M'
+        );
+
+        assert.strictEqual(warnings.length, 1);
+        assert.strictEqual(typeof warnings[0].msg, 'string');
+        assert.ok(warnings[0].msg.indexOf('toIsoString()') !== -1);
+        assert.ok(warnings[0].msg.indexOf('toISOString()') !== -1);
+    } finally {
+        moment.suppressDeprecationWarnings = oldSuppress;
+        moment.deprecationHandler = oldHandler;
+    }
+});
+
+test('duration instances keep their own serialized state after one is mutated', function () {
+
+
+    const a = moment.duration({ months: 14 });
+    const b = moment.duration(0);
+
+    assert.strictEqual(a.toISOString(), 'P1Y2M');
+    assert.strictEqual(b.toISOString(), 'P0D');
+    a.add({ days: 1, hours: 2 });
+    assert.strictEqual(a.toISOString(), 'P1Y2M1DT2H');
+    assert.strictEqual(b.toISOString(), 'P0D');
+});
