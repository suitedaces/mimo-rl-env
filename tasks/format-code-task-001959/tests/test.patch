+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+if [ ! -x node_modules/.bin/grunt ]; then
+    echo "node_modules is missing the local grunt binary required for offline test execution" >&2
+    exit 1
+fi
+
+./node_modules/.bin/grunt transpile-raw
+node /workspace/repo/usercase-test-coderl/duration_iso.test.js
