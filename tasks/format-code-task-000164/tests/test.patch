diff --git a/duckdb_engine/tests/test_datatypes.py b/duckdb_engine/tests/test_datatypes.py
index 94dd230..c8f32a7 100644
--- a/duckdb_engine/tests/test_datatypes.py
+++ b/duckdb_engine/tests/test_datatypes.py
@@ -1,7 +1,9 @@
+import uuid
 from typing import Type
 
 from pytest import mark
 from sqlalchemy import Column, Integer
+from sqlalchemy.dialects.postgresql import UUID
 from sqlalchemy.engine import Engine
 from sqlalchemy.ext.declarative import declarative_base
 from sqlalchemy.orm import Session
@@ -52,3 +54,24 @@ def test_json(engine: Engine, session: Session) -> None:
     result = session.query(Entry).one()
 
     assert result.meta == {"hello": "world"}
+
+
+def test_uuid_roundtrip(engine: Engine, session: Session) -> None:
+    base = declarative_base()
+
+    class Entry(base):
+        __tablename__ = "test_uuid"
+
+        id = Column(Integer, primary_key=True, default=0)
+        u = Column(UUID, nullable=False)
+
+    base.metadata.create_all(bind=engine)
+
+    value = uuid.uuid4()
+    session.add(Entry(u=value))  # type: ignore[call-arg]
+    session.commit()
+
+    result = session.query(Entry).one()
+
+    assert isinstance(result.u, uuid.UUID)
+    assert result.u == value
