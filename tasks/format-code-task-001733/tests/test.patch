+func TestWCPCreateDeleteSnapshotLifecycle(t *testing.T) {
+	ct := getControllerTest(t)
+	ct.config.Snapshot.GlobalMaxSnapshotsPerBlockVolume = 3
+
+	volID, cleanup := createBlockVolumeForSnapshotTest(t, ct)
+	defer cleanup()
+
+	reqCreateSnapshot := &csi.CreateSnapshotRequest{
+		SourceVolumeId: volID,
+		Name:           "snapshot-" + uuid.New().String(),
+	}
+	respCreateSnapshot, err := ct.controller.CreateSnapshot(ctx, reqCreateSnapshot)
+	if err != nil {
+		t.Fatalf("CreateSnapshot failed: %v", err)
+	}
+	if respCreateSnapshot == nil || respCreateSnapshot.Snapshot == nil {
+		t.Fatalf("CreateSnapshot returned an empty response")
+	}
+	snap := respCreateSnapshot.Snapshot
+
+
+	if !strings.HasPrefix(snap.SnapshotId, volID+common.VSphereCSISnapshotIdDelimiter) {
+		t.Fatalf("unexpected SnapshotId %q, expected it to start with %q",
+			snap.SnapshotId, volID+common.VSphereCSISnapshotIdDelimiter)
+	}
+	parsedVolID, parsedSnapID, err := common.ParseCSISnapshotID(snap.SnapshotId)
+	if err != nil {
+		t.Fatalf("returned SnapshotId %q is not parseable: %v", snap.SnapshotId, err)
+	}
+	if parsedVolID != volID {
+		t.Fatalf("SnapshotId encodes volume %q, expected %q", parsedVolID, volID)
+	}
+	if parsedSnapID == "" {
+		t.Fatalf("SnapshotId %q does not contain a CNS snapshot id", snap.SnapshotId)
+	}
+
+	if snap.SourceVolumeId != volID {
+		t.Fatalf("SourceVolumeId = %q, expected %q", snap.SourceVolumeId, volID)
+	}
+	if snap.SizeBytes != 1*common.GbInBytes {
+		t.Fatalf("snapshot SizeBytes = %d, expected %d", snap.SizeBytes, 1*common.GbInBytes)
+	}
+	if !snap.ReadyToUse {
+		t.Fatalf("snapshot ReadyToUse = false, expected true")
+	}
+	if snap.CreationTime == nil {
+		t.Fatalf("snapshot CreationTime is nil")
+	}
+
+
+	snapList, _, err := common.QueryVolumeSnapshotsByVolumeID(ctx, ct.controller.manager.VolumeManager,
+		volID, common.QuerySnapshotLimit)
+	if err != nil {
+		t.Fatalf("failed to query snapshots for volume %s: %v", volID, err)
+	}
+	if len(snapList) != 1 {
+		t.Fatalf("expected 1 snapshot on volume %s, found %d", volID, len(snapList))
+	}
+
+
+	respDeleteSnapshot, err := ct.controller.DeleteSnapshot(ctx,
+		&csi.DeleteSnapshotRequest{SnapshotId: snap.SnapshotId})
+	if err != nil {
+		t.Fatalf("DeleteSnapshot failed: %v", err)
+	}
+	if respDeleteSnapshot == nil {
+		t.Fatalf("DeleteSnapshot returned a nil response")
+	}
+
+
+	snapList, _, err = common.QueryVolumeSnapshotsByVolumeID(ctx, ct.controller.manager.VolumeManager,
+		volID, common.QuerySnapshotLimit)
+	if err != nil {
+		t.Fatalf("failed to query snapshots for volume %s after deletion: %v", volID, err)
+	}
+	if len(snapList) != 0 {
+		t.Fatalf("expected 0 snapshots on volume %s after deletion, found %d", volID, len(snapList))
+	}
+}
