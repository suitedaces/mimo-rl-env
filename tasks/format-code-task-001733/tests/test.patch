+func TestWCPCreateSnapshotValidation(t *testing.T) {
+	ct := getControllerTest(t)
+	ct.config.Snapshot.GlobalMaxSnapshotsPerBlockVolume = 3
+
+
+	if _, err := ct.controller.CreateSnapshot(ctx, &csi.CreateSnapshotRequest{
+		Name: "snapshot-" + uuid.New().String(),
+	}); err == nil {
+		t.Fatalf("expected error for CreateSnapshot without a source volume id")
+	}
+
+
+	volID, cleanup := createBlockVolumeForSnapshotTest(t, ct)
+	defer cleanup()
+	if _, err := ct.controller.CreateSnapshot(ctx, &csi.CreateSnapshotRequest{
+		SourceVolumeId: volID,
+	}); err == nil {
+		t.Fatalf("expected error for CreateSnapshot without a snapshot name")
+	}
+}
+
+
+
+func TestWCPCreateSnapshotMigratedVolume(t *testing.T) {
+	ct := getControllerTest(t)
+	ct.config.Snapshot.GlobalMaxSnapshotsPerBlockVolume = 3
+
+	_, err := ct.controller.CreateSnapshot(ctx, &csi.CreateSnapshotRequest{
+		SourceVolumeId: "[datastore] path/volume.vmdk",
+		Name:           "snapshot-" + uuid.New().String(),
+	})
+	if err == nil {
+		t.Fatalf("expected error when snapshotting a migrated vSphere volume")
+	}
+	if status.Code(err) != codes.Unimplemented {
+		t.Fatalf("expected Unimplemented for migrated vSphere volume, got %v", status.Code(err))
+	}
+}
+
+
+
+func TestWCPCreateSnapshotMaxLimit(t *testing.T) {
+	ct := getControllerTest(t)
+	ct.config.Snapshot.GlobalMaxSnapshotsPerBlockVolume = 1
+
+	volID, cleanup := createBlockVolumeForSnapshotTest(t, ct)
+	defer cleanup()
+
+
+	respCreateSnapshot, err := ct.controller.CreateSnapshot(ctx, &csi.CreateSnapshotRequest{
+		SourceVolumeId: volID,
+		Name:           "snapshot-" + uuid.New().String(),
+	})
+	if err != nil {
+		t.Fatalf("first CreateSnapshot failed: %v", err)
+	}
+	firstSnapID := respCreateSnapshot.Snapshot.SnapshotId
+	defer func() {
+		_, _ = ct.controller.DeleteSnapshot(ctx, &csi.DeleteSnapshotRequest{SnapshotId: firstSnapID})
+	}()
+
+
+	_, err = ct.controller.CreateSnapshot(ctx, &csi.CreateSnapshotRequest{
+		SourceVolumeId: volID,
+		Name:           "snapshot-" + uuid.New().String(),
+	})
+	if err == nil {
+		t.Fatalf("expected error when exceeding the maximum number of snapshots per volume")
+	}
+	if status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("expected FailedPrecondition when exceeding the snapshot maximum, got %v", status.Code(err))
+	}
+}
