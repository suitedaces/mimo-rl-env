+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+export PYTHONDONTWRITEBYTECODE=1
+exec python -m pytest /workspace/repo/usercase-test-coderl/test_mmr_acceptance.py -v -p no:cacheprovider
