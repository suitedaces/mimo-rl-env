--- /dev/null
+++ b/usercase-test-coderl/test_mmr_acceptance.py
@@ -0,0 +1,287 @@
+
+
+import copy
+import json
+import numbers
+import re
+import subprocess
+import sys
+
+import pytest
+from scipy.sparse import csc_matrix, csr_matrix
+
+
+if not hasattr(csr_matrix, "A"):
+    csr_matrix.A = property(lambda self: self.toarray())
+if not hasattr(csc_matrix, "A"):
+    csc_matrix.A = property(lambda self: self.toarray())
+
+sys.path.insert(0, "/workspace/repo")
+from nlg_yongzhuo import mmr, text_summarize  # noqa: E402
+
+
+RAW_TEXT = (
+    "人工智能正在改变医疗诊断流程。医生使用算法分析影像。医生使用算法分析影像。"
+    "医院需要保护患者隐私。隐私保护技术帮助医院共享数据。"
+)
+
+LIST_TEXT = [
+    "机器学习模型需要大量训练数据。",
+    "训练数据质量会影响模型效果。",
+    "模型上线后需要持续监控。",
+    "监控指标可以发现数据漂移。",
+    "人工审核可以纠正错误预测。",
+]
+
+ALPHA_TEXT = [
+    "电商平台推出直播促销活动。",
+    "直播促销活动带动服装销量增长。",
+    "直播促销活动吸引年轻消费者。",
+    "博物馆修复古代壁画。",
+    "考古团队整理出土文物。",
+]
+
+DUPLICATE_TEXT = [
+    "城市更新改善老旧小区环境。",
+    "社区服务中心提供养老支持。",
+    "城市更新改善老旧小区环境。",
+    "公共交通优化减少通勤时间。",
+    "社区服务中心提供养老支持。",
+]
+
+
+def assert_ranked_pairs_close(actual, expected):
+    assert len(actual) == len(expected)
+    for (actual_score, actual_sentence), (expected_score, expected_sentence) in zip(actual, expected):
+        assert float(actual_score) == pytest.approx(float(expected_score), rel=1e-12, abs=1e-12)
+        assert actual_sentence == expected_sentence
+
+
+def normalize_sentence(sentence):
+    return str(sentence).strip().rstrip("。！？.!?；;").strip()
+
+
+def split_raw_sentences(text):
+    return [part.strip() for part in re.split(r"[。！？.!?；;]+", text) if part.strip()]
+
+
+def unique_normalized(sentences):
+    seen = []
+    for sentence in sentences:
+        normalized = normalize_sentence(sentence)
+        if normalized and normalized not in seen:
+            seen.append(normalized)
+    return seen
+
+
+def assert_valid_ranking(actual, source_sentences, expected_len):
+
+    actual = list(actual)
+    assert len(actual) == expected_len
+    assert len(actual) <= expected_len
+
+    previous_score = None
+    ranked_sentences = []
+    for pair in actual:
+        assert isinstance(pair, (list, tuple))
+        assert len(pair) == 2
+        score, sentence = pair
+        assert isinstance(score, numbers.Real)
+        assert not isinstance(score, bool)
+        assert isinstance(sentence, str)
+        assert normalize_sentence(sentence) != ""
+        if previous_score is not None:
+            assert float(previous_score) >= float(score)
+        previous_score = score
+        ranked_sentences.append(normalize_sentence(sentence))
+
+    assert len(ranked_sentences) == len(set(ranked_sentences))
+    assert set(ranked_sentences).issubset(set(unique_normalized(source_sentences)))
+    return actual
+
+
+def average_rank(result, predicate):
+    matching_ranks = [
+        rank for rank, (_, sentence) in enumerate(result, start=1)
+        if predicate(normalize_sentence(sentence))
+    ]
+    assert matching_ranks
+    return sum(matching_ranks) / len(matching_ranks)
+
+
+def test_raw_string_is_split_ranked_deduplicated_and_limited():
+
+
+
+
+    actual = mmr.summarize(text=RAW_TEXT, num=3, alpha=0.6)
+
+    assert_valid_ranking(actual, split_raw_sentences(RAW_TEXT), expected_len=3)
+
+
+def test_num_one_boundary_returns_only_highest_ranked_sentence():
+
+
+
+
+    actual = mmr.summarize(text=RAW_TEXT, num=1, alpha=0.6)
+
+    assert_valid_ranking(actual, split_raw_sentences(RAW_TEXT), expected_len=1)
+
+
+def test_list_input_returns_ranked_pairs_without_joining_sentences():
+
+
+
+
+    actual = mmr.summarize(text=LIST_TEXT, num=4, alpha=0.6)
+
+    assert_valid_ranking(actual, LIST_TEXT, expected_len=4)
+
+
+def test_high_alpha_favors_relevance_scoring_region():
+
+
+
+
+    actual = mmr.summarize(text=ALPHA_TEXT, num=5, alpha=0.9)
+
+    ranked = assert_valid_ranking(actual, ALPHA_TEXT, expected_len=5)
+
+    assert average_rank(ranked, lambda sentence: "直播促销活动" in sentence) < 3
+
+
+def test_low_alpha_favors_diversity_scoring_region():
+
+
+
+
+    high_alpha = assert_valid_ranking(
+        mmr.summarize(text=ALPHA_TEXT, num=5, alpha=0.9),
+        ALPHA_TEXT,
+        expected_len=5,
+    )
+    low_alpha = assert_valid_ranking(
+        mmr.summarize(text=ALPHA_TEXT, num=5, alpha=0.2),
+        ALPHA_TEXT,
+        expected_len=5,
+    )
+
+    relevant_topic = lambda sentence: "直播促销活动" in sentence
+    diverse_topic = lambda sentence: "直播促销活动" not in sentence
+
+    assert average_rank(low_alpha, relevant_topic) > average_rank(high_alpha, relevant_topic)
+    assert average_rank(low_alpha, diverse_topic) < average_rank(high_alpha, diverse_topic)
+
+
+def test_repeated_sentence_text_appears_once_when_num_exceeds_unique_count():
+
+
+
+
+    actual = mmr.summarize(text=DUPLICATE_TEXT, num=8, alpha=0.6)
+
+    assert_valid_ranking(actual, DUPLICATE_TEXT, expected_len=len(unique_normalized(DUPLICATE_TEXT)))
+
+
+def test_non_string_and_non_list_input_raises_runtime_error():
+
+
+
+
+    with pytest.raises(RuntimeError):
+        mmr.summarize(text={"not": "valid"}, num=2, alpha=0.6)
+
+
+
+def test_text_summarize_default_feature_set_includes_mmr(monkeypatch):
+
+
+
+
+    calls = []
+
+    def mmr_summarize(text, num=8, alpha=0.6):
+        calls.append((text, num, alpha))
+        return [(1.0, "MMR_SENTINEL")]
+
+    def other_summarize(text, num=8, **kwargs):
+        return [(1.0, "OTHER_SENTINEL")]
+
+    default_features = []
+    for default in text_summarize.__defaults__ or ():
+        if isinstance(default, (list, tuple)) and all(hasattr(feature, "summarize") for feature in default):
+            default_features.extend(default)
+
+    for feature in default_features:
+        if feature is mmr or getattr(feature, "algorithm", None) == "mmr":
+            monkeypatch.setattr(feature, "summarize", mmr_summarize)
+        else:
+            monkeypatch.setattr(feature, "summarize", other_summarize)
+
+    result = text_summarize(LIST_TEXT, num=1, multi_process=False)
+
+
+    assert calls
+    assert any(sentence == "MMR_SENTINEL" for _, sentence in result)
+
+
+def test_referential_transparency_same_input_same_value():
+    first = mmr.summarize(text=LIST_TEXT, num=3, alpha=0.6)
+    second = mmr.summarize(text=LIST_TEXT, num=3, alpha=0.6)
+
+    first = assert_valid_ranking(first, LIST_TEXT, expected_len=3)
+    second = assert_valid_ranking(second, LIST_TEXT, expected_len=3)
+
+    assert_ranked_pairs_close(first, second)
+
+
+def test_summarize_does_not_mutate_callers_sentence_list():
+    original = copy.deepcopy(DUPLICATE_TEXT)
+
+    mmr.summarize(text=DUPLICATE_TEXT, num=8, alpha=0.6)
+
+    assert DUPLICATE_TEXT == original
+
+
+def test_no_global_state_leaks_across_fresh_python_process():
+    in_process = mmr.summarize(text=ALPHA_TEXT, num=5, alpha=0.2)
+    script = r'''
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+from scipy.sparse import csc_matrix, csr_matrix
+if not hasattr(csr_matrix, "A"):
+    csr_matrix.A = property(lambda self: self.toarray())
+if not hasattr(csc_matrix, "A"):
+    csc_matrix.A = property(lambda self: self.toarray())
+from nlg_yongzhuo import mmr
+text = [
+    "电商平台推出直播促销活动。",
+    "直播促销活动带动服装销量增长。",
+    "直播促销活动吸引年轻消费者。",
+    "博物馆修复古代壁画。",
+    "考古团队整理出土文物。",
+]
+out = [(float(score), sentence) for score, sentence in mmr.summarize(text=text, num=5, alpha=0.2)]
+sys.stdout.write(json.dumps(out, ensure_ascii=False))
+'''
+
+    fresh = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    fresh_process = [(score, sentence) for score, sentence in json.loads(fresh.stdout)]
+
+    assert_ranked_pairs_close(in_process, fresh_process)
+
+
+def test_summarize_from_different_cwd_still_returns_valid_ranking(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+
+    actual = mmr.summarize(text=RAW_TEXT, num=1, alpha=0.6)
+
+
+    assert_valid_ranking(actual, split_raw_sentences(RAW_TEXT), expected_len=1)
