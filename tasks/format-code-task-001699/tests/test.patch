+
+func TestServiceDeleteAllMock(t *testing.T) {
+
+	client := clientservingv1.NewMockKnServiceClient(t)
+
+
+	r := client.Recorder()
+
+	service1 := getServiceWithNamespace("svc1", "default")
+	service2 := getServiceWithNamespace("svc2", "default")
+	service3 := getServiceWithNamespace("svc3", "default")
+	serviceList := &servingv1.ServiceList{Items: []servingv1.Service{*service1, *service2, *service3}}
+	r.ListServices(mock.Any(), serviceList, nil)
+
+	r.DeleteService("svc1", mock.Any(), nil)
+	r.DeleteService("svc2", mock.Any(), nil)
+	r.DeleteService("svc3", mock.Any(), nil)
+
+	output, err := executeServiceCommand(client, "delete", "--all")
+	assert.NilError(t, err)
+	assert.Assert(t, util.ContainsAll(output, "svc1", "svc2", "svc3", "deleted", "default"))
+
+	r.Validate()
+}
+
+func TestServiceDeleteAllNoServicesMock(t *testing.T) {
+
+	client := clientservingv1.NewMockKnServiceClient(t)
+
+
+	r := client.Recorder()
+
+	r.ListServices(mock.Any(), &servingv1.ServiceList{}, nil)
+
+	output, err := executeServiceCommand(client, "delete", "--all")
+	assert.NilError(t, err)
+	assert.Assert(t, util.ContainsAll(output, "No services found"))
+
+	r.Validate()
+}
+
+func TestServiceDeleteAllWithArgMock(t *testing.T) {
+
+	client := clientservingv1.NewMockKnServiceClient(t)
+
+
+	r := client.Recorder()
+
+	_, err := executeServiceCommand(client, "delete", "svc1", "--all")
+	assert.ErrorContains(t, err, "--all")
+
+	r.Validate()
+}
