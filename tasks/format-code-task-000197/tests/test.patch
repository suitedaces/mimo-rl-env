@@ -0,0 +1,29 @@
+import React from 'react';
+import { render, screen } from '@testing-library/react';
+import IconComponent from './IconComponent';
+
+describe('IconComponent — My Organizations fix', () => {
+  it('renders the Organizations icon (not default) when name="My Organizations"', () => {
+    render(<IconComponent name="My Organizations" />);
+
+    expect(screen.queryByTestId('Icon-Component-DefaultIcon')).toBeNull();
+  });
+
+  it('renders the default fallback when name="All Organizations" (old label removed)', () => {
+    render(<IconComponent name="All Organizations" />);
+
+    expect(screen.getByTestId('Icon-Component-DefaultIcon')).toBeInTheDocument();
+  });
+
+  it('preserves rendering of Dashboard icon', () => {
+    render(<IconComponent name="Dashboard" />);
+    expect(
+      screen.getByTestId('Icon-Component-DashboardIcon')
+    ).toBeInTheDocument();
+  });
+
+  it('preserves default fallback for an unknown name', () => {
+    render(<IconComponent name="completely-unknown-name" />);
+    expect(screen.getByTestId('Icon-Component-DefaultIcon')).toBeInTheDocument();
+  });
+});
diff --git a/src/state/reducers/routesReducer.fix.test.ts b/src/state/reducers/routesReducer.fix.test.ts
new file mode 100644
index 0000000000..c9596791b8
--- /dev/null
+++ b/src/state/reducers/routesReducer.fix.test.ts
@@ -0,0 +1,67 @@
+import reducer from './routesReducer';
+import expect from 'expect';
+
+describe('Routes reducer — My Organizations fix', () => {
+  const initialState = reducer(undefined, {
+    type: '',
+    payload: undefined,
+  });
+
+  it('places "My Organizations" first in the components list (before Dashboard)', () => {
+    expect(initialState.components[0]).toEqual({
+      name: 'My Organizations',
+      comp_id: 'orglist',
+      component: 'OrgList',
+    });
+  });
+
+  it('places "My Organizations" first in the navbar targets list', () => {
+    expect(initialState.targets[0]).toEqual({
+      name: 'My Organizations',
+      url: '/orglist/id=undefined',
+    });
+  });
+
+  it('places "Dashboard" after "My Organizations" in the components list', () => {
+    expect(initialState.components[1].name).toBe('Dashboard');
+  });
+
+  it('places "Dashboard" after "My Organizations" in the targets list', () => {
+    expect(initialState.targets[1].name).toBe('Dashboard');
+  });
+
+  it('does not contain a component named "All Organizations" anymore', () => {
+    const names = initialState.components.map((c: any) => c.name);
+    expect(names).not.toContain('All Organizations');
+  });
+
+  it('does not contain a navbar target named "All Organizations" anymore', () => {
+    const targetNames = initialState.targets.map((t: any) => t.name);
+    expect(targetNames).not.toContain('All Organizations');
+  });
+
+  it('still keeps the orglist route (renamed) — there is exactly one component with comp_id=orglist', () => {
+    const orglist = initialState.components.filter(
+      (c: any) => c.comp_id === 'orglist'
+    );
+    expect(orglist.length).toBe(1);
+    expect(orglist[0].name).toBe('My Organizations');
+    expect(orglist[0].component).toBe('OrgList');
+  });
+
+  it('UPDATE_TARGETS still appends payload after the renamed/moved menu', () => {
+    const result = reducer(undefined, {
+      type: 'UPDATE_TARGETS',
+      payload: { test: 'newtarget' },
+    });
+
+    expect(result.targets[0]).toEqual({
+      name: 'My Organizations',
+      url: '/orglist/id=undefined',
+    });
+
+    expect(result.targets[result.targets.length - 1]).toEqual({
+      test: 'newtarget',
+    });
+  });
+});
