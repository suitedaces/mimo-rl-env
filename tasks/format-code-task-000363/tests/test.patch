+def test_close_all_positions_for_account_partial_failed_body(
+    reqmock, client: BrokerClient
+):
+    """API returns failed-close body with only code/message — must parse successfully."""
+    account_id = "2a87c088-ffb6-472b-a4a3-cd9305c8605c"
+
+    reqmock.delete(
+        f"{BaseURL.BROKER_SANDBOX.value}/v1/trading/accounts/{account_id}/positions",
+        text="""
+        [
+            {
+                "symbol": "SQQQ",
+                "status": 403,
+                "body": {
+                    "code": 40310000,
+                    "message": "insufficient qty available for order (requested: 1000, available: 0)"
+                }
+            }
+        ]
+        """,
+    )
+
+    close_orders = client.close_all_positions_for_account(
+        account_id, cancel_orders=False
+    )
+
+    assert isinstance(close_orders, list)
+    assert len(close_orders) == 1
+    assert isinstance(close_orders[0], ClosePositionResponse)
+    assert close_orders[0].status == 403
+    assert close_orders[0].body is not None
+    assert close_orders[0].body.code == 40310000
+    assert close_orders[0].body.available is None
+    assert close_orders[0].body.existing_qty is None
+    assert close_orders[0].body.held_for_orders is None
+    assert close_orders[0].body.symbol is None
+
+
