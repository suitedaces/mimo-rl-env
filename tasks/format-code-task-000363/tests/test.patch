@@ -219,6 +219,46 @@ def test_close_all_positions(reqmock, trading_client: TradingClient):
     assert isinstance(close_orders[0], ClosePositionResponse)
 
 
+def test_close_all_positions_partial_failed_body(
+    reqmock, trading_client: TradingClient
+):
+    """Issue reproduction: API returns failed-close body with only code/message,
+    no available/existing_qty/held_for_orders/symbol — must parse successfully."""
+    reqmock.delete(
+        f"{BaseURL.TRADING_PAPER.value}/v2/positions",
+        text="""
+    [
+        {
+            "symbol": "SQQQ",
+            "status": 403,
+            "body": {
+                "code": 40310000,
+                "message": "insufficient qty available for order (requested: 1000, available: 0)"
+            }
+        }
+    ]
+        """,
+    )
+
+    close_orders = trading_client.close_all_positions(cancel_orders=False)
+
+    assert isinstance(close_orders, list)
+    assert len(close_orders) == 1
+    assert isinstance(close_orders[0], ClosePositionResponse)
+    assert close_orders[0].status == 403
+    assert close_orders[0].body is not None
+    assert close_orders[0].body.code == 40310000
+    assert (
+        close_orders[0].body.message
+        == "insufficient qty available for order (requested: 1000, available: 0)"
+    )
+
+    assert close_orders[0].body.available is None
+    assert close_orders[0].body.existing_qty is None
+    assert close_orders[0].body.held_for_orders is None
+    assert close_orders[0].body.symbol is None
+
+
 def test_close_position_with_id(reqmock, trading_client: TradingClient):
     asset_id = UUID("904837e3-3b76-47ec-b432-046db621571b")
 
