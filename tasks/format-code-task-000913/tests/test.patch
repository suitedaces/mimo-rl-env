diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,144 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+export PATH="/root/go/pkg/mod/golang.org/toolchain@v0.0.1-go1.22.8.linux-amd64/bin:$PATH"
+export GOTOOLCHAIN=local
+export GOPROXY=off
+export GOSUMDB=off
+export GOCACHE=/workspace/repo/.coderl-go-build-cache
+export GOFLAGS="${GOFLAGS:-} -mod=readonly"
+
+ROOT=/workspace/repo
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+assert_convert_msg() {
+    local case_name=$1 contract=$2 amount=$3 receiver=$4 sender=$5
+    python3 - "$case_name" "$contract" "$amount" "$receiver" "$sender" out <<'PY'
+import json
+import sys
+
+case_name, contract, amount, receiver, sender, output_path = sys.argv[1:]
+try:
+    with open(output_path, encoding="utf-8") as fh:
+        tx = json.load(fh)
+except Exception as exc:
+    raise SystemExit(f"{case_name} stdout is not JSON: {exc}")
+
+messages = tx.get("body", {}).get("messages")
+if not isinstance(messages, list) or len(messages) != 1:
+    raise SystemExit(f"{case_name} expected exactly one transaction message, got {messages!r}")
+
+msg = messages[0]
+checks = {
+    "@type": "/evmos.erc20.v1.MsgConvertERC20",
+    "contract_address": contract,
+    "amount": amount,
+    "receiver": receiver,
+    "sender": sender,
+}
+for key, expected in checks.items():
+    actual = msg.get(key)
+    if actual != expected:
+        raise SystemExit(f"{case_name} {key}: got {actual!r}, want {expected!r}")
+PY
+}
+
+BIN="$TMP/evmosd"
+( cd "$ROOT" && go build -tags netgo -o "$BIN" ./cmd/evmosd ) \
+    || fail "build evmosd"
+
+FROM=evmos1xetwysj3rcf80qxgnfnqstkwggne3d0xn2v7d0
+FROM_ETH=0x3656e242511e127780C89a66082EcE422798B5E6
+RECEIVER=evmos1g6dnx540jxf7gg9d4xhpcnqlm2zylnt847m4f4
+COMMON_FLAGS=(--from "$FROM" --generate-only --offline --account-number 7 --sequence 9)
+
+cd "$TMP" || fail "cd tmp"
+
+
+
+
+"$BIN" tx erc20 convert-erc20 --help --home "$TMP/help-home" >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F0 exit $ec; want 0"
+
+[ -s out ] || fail "F0 expected non-empty help output"
+grep -qF 'convert-erc20' out || fail "F0 missing convert-erc20 command"
+grep -qF 'CONTRACT_ADDRESS' out || fail "F0 missing CONTRACT_ADDRESS argument"
+grep -qF 'AMOUNT' out || fail "F0 missing AMOUNT argument"
+grep -qF 'RECEIVER' out || fail "F0 missing RECEIVER argument"
+grep -q -- '--generate-only' out || fail "F0 missing --generate-only"
+grep -q -- '--dry-run' out || fail "F0 missing --dry-run"
+grep -q -- '--broadcast-mode' out || fail "F0 missing --broadcast-mode"
+
+
+
+
+"$BIN" tx erc20 convert-erc20 0x1111111111111111111111111111111111111111 1 "${COMMON_FLAGS[@]}" --home "$TMP/f1-home" >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0; stderr: $(cat err)"
+
+assert_convert_msg F1 0x1111111111111111111111111111111111111111 1 "$FROM" "$FROM_ETH" || fail "F1 stdout: $(cat out)"
+
+
+
+
+"$BIN" tx erc20 convert-erc20 0x2222222222222222222222222222222222222222 999999999999999999999999 "$RECEIVER" "${COMMON_FLAGS[@]}" --home "$TMP/f2-home" >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0; stderr: $(cat err)"
+
+assert_convert_msg F2 0x2222222222222222222222222222222222222222 999999999999999999999999 "$RECEIVER" "$FROM_ETH" || fail "F2 stdout: $(cat out)"
+
+
+
+
+"$BIN" tx erc20 convert-erc20 not-a-hex 123 "${COMMON_FLAGS[@]}" --home "$TMP/f3-home" >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F3 want non-zero exit"
+[ ! -s out ] || fail "F3 unexpected stdout: $(cat out)"
+grep -q 'invalid ERC20 contract address' err || fail "F3 stderr missing invalid contract phrase: $(cat err)"
+
+
+
+
+"$BIN" tx erc20 convert-erc20 0x1234 123 "${COMMON_FLAGS[@]}" --home "$TMP/f4-home" >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F4 want non-zero exit"
+[ ! -s out ] || fail "F4 unexpected stdout: $(cat out)"
+grep -q 'invalid ERC20 contract address' err || fail "F4 stderr missing invalid contract phrase: $(cat err)"
+
+
+
+
+"$BIN" tx erc20 convert-erc20 0x3333333333333333333333333333333333333333 12.34 "${COMMON_FLAGS[@]}" --home "$TMP/f5-home" >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F5 want non-zero exit"
+[ ! -s out ] || fail "F5 unexpected stdout: $(cat out)"
+grep -q 'invalid amount 12.34' err || fail "F5 stderr missing invalid amount value: $(cat err)"
+
+
+
+
+"$BIN" tx erc20 convert-erc20 0x3333333333333333333333333333333333333333 123 evmos1bad "${COMMON_FLAGS[@]}" --home "$TMP/f6-home" >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F6 want non-zero exit"
+[ ! -s out ] || fail "F6 unexpected stdout: $(cat out)"
+
+[ -s err ] || fail "F6 expected receiver parse error on stderr"
+
+
+
+
+"$BIN" tx erc20 convert-erc20 0x3333333333333333333333333333333333333333 "${COMMON_FLAGS[@]}" --home "$TMP/f7-home" >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F7 want non-zero exit"
+[ ! -s out ] || fail "F7 unexpected stdout: $(cat out)"
+
+[ -s err ] || fail "F7 expected arity error on stderr"
+
+
+
+
+"$BIN" tx erc20 convert-erc20 0x3333333333333333333333333333333333333333 123 "$RECEIVER" extra "${COMMON_FLAGS[@]}" --home "$TMP/f8-home" >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F8 want non-zero exit"
+[ ! -s out ] || fail "F8 unexpected stdout: $(cat out)"
+
+[ -s err ] || fail "F8 expected arity error on stderr"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
