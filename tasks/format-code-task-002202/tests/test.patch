 \end{tabular}
 """
         assert observed == expected
+
+    def test_to_latex_escape_backslash_with_space(self):
+        # GH issue: backslash must be escaped to a *valid* LaTeX command,
+        # i.e. terminated with a space ("\textbackslash ") or with an
+        # empty group ("\textbackslash{}") - never the bare form
+        # "\textbackslash<letter>" (which forms an undefined command name)
+        # and never the double-escaped form "\textbackslash\{\}" (which
+        # would render the braces as literal characters).
+        df = DataFrame({'A': ['a\\b\\c']})
+        result = df.to_latex()
+        has_space_form = 'a\\textbackslash b\\textbackslash c' in result
+        has_brace_form = 'a\\textbackslash{}b\\textbackslash{}c' in result
+        assert has_space_form or has_brace_form
+        # bare form (no terminator) is the original bug
+        assert 'a\\textbackslashb' not in result
+        # double-escaped braces are an over-broad-fix bug
+        assert '\\textbackslash\\{' not in result
+
+    def test_to_latex_escape_tilde_with_space(self):
+        # tilde must be escaped to a *valid* LaTeX command:
+        # "\textasciitilde " (with space) or "\textasciitilde{}" (with
+        # empty group). The bare form "\textasciitilde<letter>" is invalid.
+        df = DataFrame({'A': ['a~b']})
+        result = df.to_latex()
+        has_space_form = 'a\\textasciitilde b' in result
+        has_brace_form = 'a\\textasciitilde{}b' in result
+        assert has_space_form or has_brace_form
+        # bare form (no terminator) is the original bug
+        assert 'a\\textasciitildeb' not in result
+
+    def test_to_latex_escape_caret_with_space(self):
+        # caret must be escaped to a *valid* LaTeX command:
+        # "\textasciicircum " (with space) or "\textasciicircum{}" (with
+        # empty group). The bare form "\textasciicircum<letter>" is invalid.
+        df = DataFrame({'A': ['a^b']})
+        result = df.to_latex()
+        has_space_form = 'a\\textasciicircum b' in result
+        has_brace_form = 'a\\textasciicircum{}b' in result
+        assert has_space_form or has_brace_form
+        # bare form (no terminator) is the original bug
+        assert 'a\\textasciicircumb' not in result
+
+    def test_to_latex_escape_false_preserves_backslash(self):
+        # escape=False should leave backslashes untouched
+        df = DataFrame({'A': ['a\\b\\c']})
+        result = df.to_latex(escape=False)
+        assert 'a\\b\\c' in result
+        assert '\\textbackslash' not in result
+
+    def test_to_latex_escape_backslash_at_end(self):
+        # backslash with no letter following must still be a valid
+        # \textbackslash command (either space-terminated or {}-terminated),
+        # never the double-escaped \textbackslash\{\} form (which renders
+        # as literal braces, not a backslash).
+        df = DataFrame({'A': ['a\\']})
+        result = df.to_latex()
+        # double-escaped braces are an over-broad-fix bug
+        assert '\\textbackslash\\{' not in result
+
+    def test_to_latex_escape_reproduce_issue(self):
+        # exact reproduction from the reported issue - all three backslashes
+        # must be valid \textbackslash commands (either space- or
+        # {}-terminated). The bare form is the original bug.
+        df = DataFrame({'A': ['a\\b\\c', 'p\\y\\c', 'a\\d\\x'],
+                        'B': [2, 9, 4]})
+        result = df.to_latex()
+        space_form = ('a\\textbackslash b\\textbackslash c' in result
+                      and 'p\\textbackslash y\\textbackslash c' in result
+                      and 'a\\textbackslash d\\textbackslash x' in result)
+        brace_form = ('a\\textbackslash{}b\\textbackslash{}c' in result
+                      and 'p\\textbackslash{}y\\textbackslash{}c' in result
+                      and 'a\\textbackslash{}d\\textbackslash{}x' in result)
+        assert space_form or brace_form
+        # bare form is the bug
+        assert 'a\\textbackslashb' not in result
