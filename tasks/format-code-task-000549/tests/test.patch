@@ -0,0 +1,240 @@
+
+
+package interp_test
+
+import (
+	"io/ioutil"
+	"strings"
+	"testing"
+
+	"github.com/benhoyt/goawk/interp"
+	"github.com/benhoyt/goawk/parser"
+)
+
+
+
+func runGoAWK(t *testing.T, src, in string) string {
+	t.Helper()
+	prog, err := parser.ParseProgram([]byte(src), nil)
+	if err != nil {
+		t.Fatalf("parse error: %v", err)
+	}
+
+	if err := prog.Disassemble(ioutil.Discard); err != nil {
+		t.Fatalf("disassemble error: %v", err)
+	}
+	var out strings.Builder
+	config := &interp.Config{
+		Stdin:  strings.NewReader(in),
+		Output: &out,
+		Error:  &out,
+	}
+	status, err := interp.ExecProgram(prog, config)
+	if err != nil {
+		t.Fatalf("exec error: %v", err)
+	}
+	if status != 0 {
+		t.Fatalf("expected status 0, got %d (output: %q)", status, out.String())
+	}
+	return out.String()
+}
+
+func assertOutput(t *testing.T, src, in, want string) {
+	t.Helper()
+	got := runGoAWK(t, src, in)
+	if got != want {
+		t.Fatalf("src: %s\ninput: %q\nexpected %q\ngot      %q", src, in, want, got)
+	}
+}
+
+
+
+func TestMatchRegexLiteralMultiline(t *testing.T) {
+	assertOutput(t,
+		`BEGIN{VAR="a\nb"; print match(VAR, /^a.*b$/)}`,
+		"",
+		"1\n")
+}
+
+
+
+func TestMatchRegexLiteralMultilineRstartRlength(t *testing.T) {
+	assertOutput(t,
+		`BEGIN{VAR="a\nb"; print match(VAR, /^a.*b$/), RSTART, RLENGTH}`,
+		"",
+		"1 1 3\n")
+}
+
+
+
+func TestMatchDynamicRegexMultiline(t *testing.T) {
+	assertOutput(t,
+		`BEGIN{VAR="a\nb"; print match(VAR, "^a.*b$")}`,
+		"",
+		"1\n")
+}
+
+
+func TestMatchExplicitSFlagPreserved(t *testing.T) {
+	assertOutput(t,
+		`BEGIN{VAR="a\nb"; print match(VAR, /(?s)^a.*b$/)}`,
+		"",
+		"1\n")
+}
+
+
+func TestMatchOperatorRegexLiteralMultiline(t *testing.T) {
+	assertOutput(t,
+		`BEGIN{VAR="a\nb"; if (VAR ~ /^a.*b$/) print "yes"; else print "no"}`,
+		"",
+		"yes\n")
+}
+
+
+func TestMatchOperatorDynamicRegexMultiline(t *testing.T) {
+	assertOutput(t,
+		`BEGIN{VAR="a\nb"; r="^a.*b$"; if (VAR ~ r) print "yes"; else print "no"}`,
+		"",
+		"yes\n")
+}
+
+
+
+func TestGsubRegexLiteralMultiline(t *testing.T) {
+	assertOutput(t,
+		`BEGIN{VAR="a\nb"; n=gsub(/.+/, "X", VAR); print n, VAR}`,
+		"",
+		"1 X\n")
+}
+
+
+func TestGsubDynamicRegexMultiline(t *testing.T) {
+	assertOutput(t,
+		`BEGIN{VAR="a\nb"; n=gsub(".+", "X", VAR); print n, VAR}`,
+		"",
+		"1 X\n")
+}
+
+
+func TestSubRegexLiteralMultiline(t *testing.T) {
+	assertOutput(t,
+		`BEGIN{VAR="a\nb"; n=sub(/.+/, "X", VAR); print n, VAR}`,
+		"",
+		"1 X\n")
+}
+
+
+
+
+
+
+func TestSplitRegexLiteralMultiline(t *testing.T) {
+	assertOutput(t,
+		`BEGIN{VAR="ax\nyb"; n=split(VAR, a, /x.y/); print n, "[" a[1] "][" a[2] "]"}`,
+		"",
+		"2 [a][b]\n")
+}
+
+
+
+
+func TestSplitDynamicRegexMultiline(t *testing.T) {
+
+
+
+	assertOutput(t,
+		`BEGIN{VAR="a1\nb"; n=split(VAR, a, ".."); print n, "[" a[1] "][" a[2] "][" a[3] "]"}`,
+		"",
+		"3 [][][]\n")
+}
+
+
+
+func TestMatchNoMatchStillReturnsZero(t *testing.T) {
+	assertOutput(t,
+		`BEGIN{VAR="a\nb"; print match(VAR, /^a.*z$/), RSTART, RLENGTH}`,
+		"",
+		"0 0 -1\n")
+}
+
+
+
+
+func TestMatchCharClassPreserved(t *testing.T) {
+
+	assertOutput(t,
+		`BEGIN{print match("abc", /^[abc]+$/), RSTART, RLENGTH}`,
+		"",
+		"1 1 3\n")
+}
+
+
+
+func TestMatchSingleLineUnchanged(t *testing.T) {
+	assertOutput(t,
+		`BEGIN{print match("foo", /^f.*o$/), RSTART, RLENGTH}`,
+		"",
+		"1 1 3\n")
+}
+
+
+
+
+func TestPatternRegexLiteralMultiline(t *testing.T) {
+
+
+	assertOutput(t,
+		`BEGIN{VAR="a\nb"; if (VAR ~ /a.b/) print "match"; else print "no"}`,
+		"",
+		"match\n")
+}
+
+
+
+
+
+func TestStandaloneRegexExprMultiline(t *testing.T) {
+
+
+	assertOutput(t,
+		`BEGIN{$0="a\nb"; print /a.b/}`,
+		"",
+		"1\n")
+}
+
+
+
+
+func TestPatternRuleRegexLiteralMultiline(t *testing.T) {
+
+
+	assertOutput(t,
+		`BEGIN{RS="@"} /a.b/ {print NR}`,
+		"a\nb@x\ny",
+		"1\n")
+}
+
+
+
+
+func TestRSRegexMultiline(t *testing.T) {
+	assertOutput(t,
+		`BEGIN{RS="a.b"} {print NR, $0}`,
+		"1a\nb2a\nb3",
+		"1 1\n2 2\n3 3\n")
+}
+
+
+
+
+
+
+func TestFSRegexMultiline(t *testing.T) {
+
+
+
+	assertOutput(t,
+		`BEGIN{FS="a.b"; RS="@"} {print NF, "[" $1 "][" $2 "]"}`,
+		"Xa\nbY",
+		"2 [X][Y]\n")
+}
