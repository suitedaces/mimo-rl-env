diff --git a/usercase-test-coderl/level_dispatch.test.js b/usercase-test-coderl/level_dispatch.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/level_dispatch.test.js
@@ -0,0 +1,235 @@
+'use strict'
+
+const assert = require('assert')
+const acho = require('/workspace/repo')
+
+function createTransport () {
+  const entries = []
+  const transport = line => entries.push(line)
+  transport.entries = entries
+  return transport
+}
+
+function defaultMethodTypes (log) {
+  return {
+    debug: typeof log.debug,
+    info: typeof log.info,
+    warn: typeof log.warn,
+    error: typeof log.error,
+    fatal: typeof log.fatal
+  }
+}
+
+function assertGeneratedLine (line, message) {
+  assert.strictEqual(typeof line, 'string')
+  assert.notStrictEqual(line.trim(), '')
+  assert.ok(line.includes(message), `expected ${JSON.stringify(line)} to include ${message}`)
+}
+
+function assertGeneratedEntries (entries, expected) {
+  assert.strictEqual(entries.length, expected.length)
+  expected.forEach((message, index) => {
+    assertGeneratedLine(entries[index], message)
+  })
+}
+
+describe('usercase level-aware log method dispatch', function () {
+  it('creates default level methods that format, transport, and chain', function () {
+
+
+
+
+    const transport = createTransport()
+    const log = acho({ transport, color: false, upper: true })
+
+    assert.deepStrictEqual(defaultMethodTypes(log), {
+      debug: 'function',
+      info: 'function',
+      warn: 'function',
+      error: 'function',
+      fatal: 'function'
+    })
+    assert.deepStrictEqual(transport.entries, [])
+
+    const result = log.warn('disk %s', 'low')
+
+    assert.strictEqual(result === log, true)
+
+    assertGeneratedEntries(transport.entries, ['disk low'])
+  })
+
+  it('supports construction with new and keeps instances independent', function () {
+
+
+
+
+    const transportA = createTransport()
+    const transportB = createTransport()
+    const a = acho({ transport: transportA, color: false })
+    const b = new acho({ transport: transportB, color: false, level: 'fatal' })
+
+    a.warn('a1')
+    b.error('b1')
+    b.fatal('b2')
+
+
+    assert.strictEqual(transportA.entries.length, 1)
+    assert.strictEqual(b.level, 'fatal')
+
+    assertGeneratedEntries(transportA.entries, ['a1'])
+    assertGeneratedEntries(transportB.entries, ['b2'])
+  })
+
+  it('filters the constructor level thresholds with permitted outputs', function () {
+
+
+
+
+    const calls = ['debug', 'info', 'warn', 'error', 'fatal']
+
+    const fatalTransport = createTransport()
+    const fatalLog = acho({ transport: fatalTransport, color: false, level: 'fatal' })
+    calls.forEach(method => fatalLog[method](`${method} message`))
+
+    assertGeneratedEntries(fatalTransport.entries, ['fatal message'])
+
+    const errorTransport = createTransport()
+    const errorLog = acho({ transport: errorTransport, color: false, level: 'error' })
+    calls.forEach(method => errorLog[method](`${method} message`))
+
+    assertGeneratedEntries(errorTransport.entries, [
+      'error message',
+      'fatal message'
+    ])
+
+    const mutedTransport = createTransport()
+    const mutedLog = acho({ transport: mutedTransport, color: false, level: 'muted' })
+    calls.forEach(method => mutedLog[method](`${method} message`))
+    assert.deepStrictEqual(mutedTransport.entries, [])
+
+    const allTransport = createTransport()
+    const allLog = acho({ transport: allTransport, color: false, level: 'all' })
+    calls.forEach(method => allLog[method](`${method} message`))
+
+    assertGeneratedEntries(allTransport.entries, [
+      'debug message',
+      'info message',
+      'warn message',
+      'error message',
+      'fatal message'
+    ])
+  })
+
+  it('uses runtime log.level state for later method calls', function () {
+
+
+
+
+    const transport = createTransport()
+    const log = acho({ transport, color: false, level: 'muted' })
+
+    assert.strictEqual(log.level, 'muted')
+    log.info('first')
+    assert.deepStrictEqual(transport.entries, [])
+
+    log.level = 'all'
+    assert.strictEqual(log.level, 'all')
+    log.debug('second')
+
+    assertGeneratedEntries(transport.entries, ['second'])
+
+    log.level = 'error'
+    assert.strictEqual(log.level, 'error')
+    log.warn('third')
+
+    assertGeneratedEntries(transport.entries, ['second'])
+    log.error('fourth')
+
+    assertGeneratedEntries(transport.entries, [
+      'second',
+      'fourth'
+    ])
+  })
+
+  it('generates custom type methods and orders them by configured severity', function () {
+
+
+
+
+    const transport = createTransport()
+    const log = acho({
+      transport,
+      color: false,
+      level: 'notice',
+      types: {
+        verbose: { level: 2, color: ['white'] },
+        notice: { level: 1, color: ['white'], separator: '|' },
+        panic: { level: 0, color: ['white'] }
+      }
+    })
+
+    assert.deepStrictEqual(
+      {
+        verbose: typeof log.verbose,
+        notice: typeof log.notice,
+        panic: typeof log.panic
+      },
+      {
+        verbose: 'function',
+        notice: 'function',
+        panic: 'function'
+      }
+    )
+
+    log.verbose('chatty')
+    log.notice('heads up')
+    log.panic('wake up')
+
+
+    assertGeneratedEntries(transport.entries, [
+      'heads up',
+      'wake up'
+    ])
+    assert.strictEqual(log.notice('again') === log, true)
+
+    assertGeneratedEntries(transport.entries, [
+      'heads up',
+      'wake up',
+      'again'
+    ])
+  })
+
+  it('creates callable methods for custom configured types', function () {
+
+
+
+
+    const transport = createTransport()
+    const log = acho({
+      transport,
+      color: false,
+      types: {
+        notice: { level: 0, color: ['white'] }
+      }
+    })
+
+
+    assert.strictEqual(typeof log.notice, 'function')
+    assert.strictEqual(log.notice('configured') === log, true)
+    assertGeneratedEntries(transport.entries, ['configured'])
+  })
+
+  it('sends one generated line per permitted repeated logger call', function () {
+
+
+
+
+    for (let i = 0; i < 150; i++) {
+      const transport = createTransport()
+      const log = acho({ transport, color: false, level: 'all' })
+      log.warn('cycle %d', i)
+
+      assertGeneratedEntries(transport.entries, [`cycle ${i}`])
+    }
+  })
+})
