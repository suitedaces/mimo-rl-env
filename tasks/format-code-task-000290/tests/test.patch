+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+for dep in mocha should chalk fmt-obj pretty-ms sliced; do
+  if [ ! -d "node_modules/$dep" ]; then
+    echo "Missing preinstalled npm dependency: $dep" >&2
+    exit 127
+  fi
+done
+
+exec node /workspace/repo/node_modules/mocha/bin/mocha \
+  /workspace/repo/usercase-test-coderl/level_dispatch.test.js
