+import boto3
+import pytest
+from botocore.exceptions import ClientError
+
+from moto import mock_ec2
+from moto.core import ACCOUNT_ID
+from tests import EXAMPLE_AMI_ID
+
+
+def _attribute_client_with_network_interface():
+    client = boto3.client("ec2", region_name="us-east-1")
+    vpc_id = client.create_vpc(CidrBlock="10.60.0.0/16")["Vpc"]["VpcId"]
+    subnet_id = client.create_subnet(VpcId=vpc_id, CidrBlock="10.60.1.0/24")[
+        "Subnet"
+    ]["SubnetId"]
+    return client, subnet_id
+
+
+@mock_ec2
+def test_describe_network_interface_attribute_reflects_description_and_groups():
+    client, subnet_id = _attribute_client_with_network_interface()
+    original_group = client.create_security_group(
+        GroupName="attribute-contract-original", Description="original"
+    )
+    replacement_group = client.create_security_group(
+        GroupName="attribute-contract-replacement", Description="replacement"
+    )
+    network_interface_id = client.create_network_interface(
+        SubnetId=subnet_id,
+        Description="created description",
+        Groups=[original_group["GroupId"]],
+    )["NetworkInterface"]["NetworkInterfaceId"]
+
+    description = client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="description"
+    )
+    assert description["NetworkInterfaceId"] == network_interface_id
+    assert description["Description"] == {"Value": "created description"}
+
+    groups = client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="groupSet"
+    )["Groups"]
+    assert groups == [
+        {"GroupId": original_group["GroupId"], "GroupName": "attribute-contract-original"}
+    ]
+
+    client.modify_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id,
+        Description={"Value": "changed description"},
+        Groups=[replacement_group["GroupId"]],
+    )
+
+    assert client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="description"
+    )["Description"] == {"Value": "changed description"}
+    assert client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="groupSet"
+    )["Groups"] == [
+        {
+            "GroupId": replacement_group["GroupId"],
+            "GroupName": "attribute-contract-replacement",
+        }
+    ]
+
+    client.modify_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Description={"Value": ""}
+    )
+    assert client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="description"
+    )["Description"] == {"Value": ""}
+
+
+@mock_ec2
+def test_describe_network_interface_attribute_tracks_boolean_settings():
+    client, subnet_id = _attribute_client_with_network_interface()
+    network_interface_id = client.create_network_interface(SubnetId=subnet_id)[
+        "NetworkInterface"
+    ]["NetworkInterfaceId"]
+
+    assert client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="sourceDestCheck"
+    )["SourceDestCheck"] == {"Value": True}
+    assert client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="associatePublicIpAddress"
+    )["AssociatePublicIpAddress"] is False
+
+    client.modify_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, SourceDestCheck={"Value": False}
+    )
+    client.modify_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, AssociatePublicIpAddress=True
+    )
+    assert client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="sourceDestCheck"
+    )["SourceDestCheck"] == {"Value": False}
+    assert client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="associatePublicIpAddress"
+    )["AssociatePublicIpAddress"] is True
+
+    client.modify_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, AssociatePublicIpAddress=False
+    )
+    assert client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="associatePublicIpAddress"
+    )["AssociatePublicIpAddress"] is False
+
+
+@mock_ec2
+def test_describe_network_interface_attribute_tracks_attachment_lifecycle():
+    client, subnet_id = _attribute_client_with_network_interface()
+    network_interface_id = client.create_network_interface(SubnetId=subnet_id)[
+        "NetworkInterface"
+    ]["NetworkInterfaceId"]
+    assert "Attachment" not in client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="attachment"
+    )
+
+    instance_id = client.run_instances(
+        ImageId=EXAMPLE_AMI_ID,
+        MinCount=1,
+        MaxCount=1,
+        NetworkInterfaces=[{"DeviceIndex": 0, "SubnetId": subnet_id}],
+    )["Instances"][0]["InstanceId"]
+    attachment_id = client.attach_network_interface(
+        NetworkInterfaceId=network_interface_id, InstanceId=instance_id, DeviceIndex=1
+    )["AttachmentId"]
+
+    attachment = client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="attachment"
+    )["Attachment"]
+    assert attachment["AttachmentId"] == attachment_id
+    assert attachment["DeleteOnTermination"] is False
+    assert attachment["DeviceIndex"] == 1
+    assert attachment["InstanceId"] == instance_id
+    assert attachment["InstanceOwnerId"] == ACCOUNT_ID
+    assert attachment["Status"] == "attached"
+
+    client.modify_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id,
+        Attachment={"AttachmentId": attachment_id, "DeleteOnTermination": True},
+    )
+    assert client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="attachment"
+    )["Attachment"]["DeleteOnTermination"] is True
+
+    client.detach_network_interface(AttachmentId=attachment_id)
+    assert "Attachment" not in client.describe_network_interface_attribute(
+        NetworkInterfaceId=network_interface_id, Attribute="attachment"
+    )
+
+
+@mock_ec2
+def test_describe_network_interface_attribute_rejects_missing_network_interface():
+    client, _ = _attribute_client_with_network_interface()
+    with pytest.raises(ClientError) as error:
+        client.describe_network_interface_attribute(
+            NetworkInterfaceId="eni-12345678", Attribute="description"
+        )
+
+    assert error.value.response["Error"]["Code"] == "InvalidNetworkInterfaceID.NotFound"
+    assert error.value.response["ResponseMetadata"]["HTTPStatusCode"] == 400
