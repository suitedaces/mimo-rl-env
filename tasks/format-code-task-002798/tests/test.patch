new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/html_string_typing.test.js
@@ -0,0 +1,336 @@
+
+
+
+
+jest.mock('raf', () => {
+  const callbacks = new Map();
+  let nextHandle = 1;
+
+  const raf = jest.fn(callback => {
+    const handle = nextHandle;
+    nextHandle += 1;
+    callbacks.set(handle, callback);
+    return handle;
+  });
+
+  const cancel = jest.fn(handle => {
+    callbacks.delete(handle);
+  });
+
+  return {
+    __esModule: true,
+    default: raf,
+    cancel,
+    __activeCount: () => callbacks.size,
+    __flushOneFrame: timestamp => {
+      const frameCallbacks = Array.from(callbacks.values());
+      callbacks.clear();
+      frameCallbacks.forEach(callback => callback(timestamp));
+    },
+    __reset: () => {
+      callbacks.clear();
+      nextHandle = 1;
+      raf.mockClear();
+      cancel.mockClear();
+    },
+  };
+});
+
+import Typewriter from '../src/core';
+import { __activeCount, __flushOneFrame, __reset } from 'raf';
+
+let now;
+
+const makeTypewriter = () => {
+  const container = document.createElement('div');
+  document.body.appendChild(container);
+  const instance = new Typewriter(container, {
+    delay: 1,
+    deleteSpeed: 1,
+    skipAddStyles: true,
+  });
+
+  return { container, instance };
+};
+
+const wrapperFor = container => container.querySelector('.Typewriter__wrapper');
+
+const runUntilIdle = instance => {
+  instance.start();
+
+  for(let i = 0; i < 200; i += 1) {
+    if(__activeCount() === 0) {
+      return;
+    }
+
+    now += 20;
+    __flushOneFrame(now);
+  }
+
+  throw new Error('Typewriter did not drain its animation queue');
+};
+
+const summarizeChildren = node => Array.from(node.childNodes).map(child => ({
+  nodeType: child.nodeType,
+  nodeName: child.nodeName,
+  textContent: child.textContent,
+  outerHTML: child.outerHTML || null,
+  children: Array.from(child.childNodes).map(grandchild => ({
+    nodeType: grandchild.nodeType,
+    nodeName: grandchild.nodeName,
+    textContent: grandchild.textContent,
+    outerHTML: grandchild.outerHTML || null,
+  })),
+}));
+
+const directTextBefore = (parent, boundaryNode) => {
+  const textNodes = [];
+  let current = parent.firstChild;
+
+  while(current && current !== boundaryNode) {
+    textNodes.push(current);
+    current = current.nextSibling;
+  }
+
+  return textNodes;
+};
+
+const directTextAfter = boundaryNode => {
+  const textNodes = [];
+  let current = boundaryNode.nextSibling;
+
+  while(current) {
+    textNodes.push(current);
+    current = current.nextSibling;
+  }
+
+  return textNodes;
+};
+
+const textContentOf = nodes => nodes.map(node => node.textContent).join('');
+
+const expectMixedStrongMarkup = wrapper => {
+  const strong = wrapper.querySelector('strong');
+  expect(strong).not.toBeNull();
+
+
+  expect(wrapper.innerHTML).toBe('Hello <strong>world</strong>!');
+  expect(wrapper.textContent).toBe('Hello world!');
+  expect(strong.parentNode).toBe(wrapper);
+  expect(strong.textContent).toBe('world');
+
+  const beforeStrong = directTextBefore(wrapper, strong);
+  const afterStrong = directTextAfter(strong);
+  expect(beforeStrong.length).toBeGreaterThan(0);
+  expect(afterStrong.length).toBeGreaterThan(0);
+  expect(beforeStrong.every(node => node.nodeType === 3)).toBe(true);
+  expect(afterStrong.every(node => node.nodeType === 3)).toBe(true);
+  expect(textContentOf(beforeStrong)).toBe('Hello ');
+  expect(textContentOf(afterStrong)).toBe('!');
+};
+
+const expectNestedMarkupInParent = parent => {
+  const em = parent.querySelector('em');
+  const strong = parent.querySelector('strong');
+  expect(em).not.toBeNull();
+  expect(strong).not.toBeNull();
+
+
+  expect(parent.innerHTML).toBe('<em>A <strong>B</strong></em>!');
+  expect(parent.textContent).toBe('A B!');
+  expect(em.parentNode).toBe(parent);
+  expect(strong.parentNode).toBe(em);
+  expect(strong.textContent).toBe('B');
+
+  const afterEm = directTextAfter(em);
+  expect(afterEm.length).toBeGreaterThan(0);
+  expect(afterEm.every(node => node.nodeType === 3)).toBe(true);
+  expect(textContentOf(afterEm)).toBe('!');
+};
+
+beforeEach(() => {
+  now = 1000;
+  jest.spyOn(Date, 'now').mockImplementation(() => now);
+  __reset();
+  document.body.innerHTML = '';
+  document.head.innerHTML = '';
+  window.___TYPEWRITER_JS_STYLES_ADDED___ = false;
+});
+
+afterEach(() => {
+  Date.now.mockRestore();
+  __reset();
+  document.body.innerHTML = '';
+  document.head.innerHTML = '';
+});
+
+test('typeString renders mixed text and markup as DOM nodes', () => {
+
+
+  const { container, instance } = makeTypewriter();
+
+  instance.typeString('Hello <strong>world</strong>!');
+  runUntilIdle(instance);
+
+  expectMixedStrongMarkup(wrapperFor(container));
+
+  instance.stop();
+});
+
+test('pasteString renders the same HTML structure as pasted chunks', () => {
+
+
+  const { container, instance } = makeTypewriter();
+
+  instance.pasteString('Hello <strong>world</strong>!');
+  runUntilIdle(instance);
+
+
+  expect(wrapperFor(container).innerHTML).toBe('Hello <strong>world</strong>!');
+  expect(summarizeChildren(wrapperFor(container))).toEqual([
+    { nodeType: 3, nodeName: '#text', textContent: 'Hello ', outerHTML: null, children: [] },
+    {
+      nodeType: 1,
+      nodeName: 'STRONG',
+      textContent: 'world',
+      outerHTML: '<strong>world</strong>',
+      children: [
+        { nodeType: 3, nodeName: '#text', textContent: 'world', outerHTML: null },
+      ],
+    },
+    { nodeType: 3, nodeName: '#text', textContent: '!', outerHTML: null, children: [] },
+  ]);
+
+  instance.stop();
+});
+
+test('nested markup can be inserted inside an explicit parent node', () => {
+
+
+  const { container, instance } = makeTypewriter();
+  const parent = document.createElement('section');
+  parent.className = 'slot';
+  wrapperFor(container).appendChild(parent);
+
+  instance.typeString('<em>A <strong>B</strong></em>!', parent);
+  runUntilIdle(instance);
+
+  expect(wrapperFor(container).firstChild).toBe(parent);
+  expectNestedMarkupInParent(parent);
+
+  instance.stop();
+});
+
+test('ordinary plain text still uses the typing path', () => {
+
+
+  const { container, instance } = makeTypewriter();
+
+  instance.typeString('Plain words!');
+  runUntilIdle(instance);
+
+  expect(wrapperFor(container).innerHTML).toBe('Plain words!');
+  expect(summarizeChildren(wrapperFor(container))).toEqual([
+    { nodeType: 3, nodeName: '#text', textContent: 'P', outerHTML: null, children: [] },
+    { nodeType: 3, nodeName: '#text', textContent: 'l', outerHTML: null, children: [] },
+    { nodeType: 3, nodeName: '#text', textContent: 'a', outerHTML: null, children: [] },
+    { nodeType: 3, nodeName: '#text', textContent: 'i', outerHTML: null, children: [] },
+    { nodeType: 3, nodeName: '#text', textContent: 'n', outerHTML: null, children: [] },
+    { nodeType: 3, nodeName: '#text', textContent: ' ', outerHTML: null, children: [] },
+    { nodeType: 3, nodeName: '#text', textContent: 'w', outerHTML: null, children: [] },
+    { nodeType: 3, nodeName: '#text', textContent: 'o', outerHTML: null, children: [] },
+    { nodeType: 3, nodeName: '#text', textContent: 'r', outerHTML: null, children: [] },
+    { nodeType: 3, nodeName: '#text', textContent: 'd', outerHTML: null, children: [] },
+    { nodeType: 3, nodeName: '#text', textContent: 's', outerHTML: null, children: [] },
+    { nodeType: 3, nodeName: '#text', textContent: '!', outerHTML: null, children: [] },
+  ]);
+
+  instance.stop();
+});
+
+test('ordinary plain text still uses the pasting path', () => {
+
+
+  const { container, instance } = makeTypewriter();
+
+  instance.pasteString('Plain words!');
+  runUntilIdle(instance);
+
+  expect(wrapperFor(container).innerHTML).toBe('Plain words!');
+  expect(summarizeChildren(wrapperFor(container))).toEqual([
+    { nodeType: 3, nodeName: '#text', textContent: 'Plain words!', outerHTML: null, children: [] },
+  ]);
+
+  instance.stop();
+});
+
+test('construction with an element supports HTML rendering', () => {
+
+
+  const { container, instance } = makeTypewriter();
+
+  instance.typeString('Hello <strong>world</strong>!');
+  runUntilIdle(instance);
+
+
+  expectMixedStrongMarkup(wrapperFor(container));
+
+  instance.stop();
+});
+
+test('started HTML typing produces the required DOM', () => {
+
+
+  const { container, instance } = makeTypewriter();
+
+  instance.typeString('Hello <strong>world</strong>!');
+  runUntilIdle(instance);
+
+
+  expectMixedStrongMarkup(wrapperFor(container));
+
+  instance.stop();
+});
+
+test('two instances keep independent DOM state for the same HTML input', () => {
+
+
+  const first = makeTypewriter();
+  const second = makeTypewriter();
+
+  first.instance.typeString('Hello <strong>world</strong>!');
+  runUntilIdle(first.instance);
+
+  expect(wrapperFor(first.container).innerHTML).toBe('Hello <strong>world</strong>!');
+  expect(wrapperFor(second.container).innerHTML).toBe('');
+
+  second.instance.typeString('Hello <strong>world</strong>!');
+  runUntilIdle(second.instance);
+
+  expect(wrapperFor(first.container).innerHTML).toBe('Hello <strong>world</strong>!');
+  expect(wrapperFor(second.container).innerHTML).toBe('Hello <strong>world</strong>!');
+
+  first.instance.stop();
+  second.instance.stop();
+});
+
+test('same HTML input renders consistently across fresh instances', () => {
+
+
+  const outputs = [];
+
+  for(let i = 0; i < 3; i += 1) {
+    const { container, instance } = makeTypewriter();
+    instance.typeString('Hello <strong>world</strong>!');
+    runUntilIdle(instance);
+    outputs.push(wrapperFor(container).innerHTML);
+    instance.stop();
+  }
+
+
+  expect(outputs).toEqual([
+    'Hello <strong>world</strong>!',
+    'Hello <strong>world</strong>!',
+    'Hello <strong>world</strong>!',
+  ]);
+});
