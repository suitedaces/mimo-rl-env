diff --git a/tests/unit/blueprints/adapter-test.js b/tests/unit/blueprints/adapter-test.js
new file mode 100644
index 000000000..22271ddbb
--- /dev/null
+++ b/tests/unit/blueprints/adapter-test.js
@@ -0,0 +1,89 @@
+'use strict';
+
+var Blueprint  = require('../../../lib/models/blueprint');
+var stringUtil = require('../../../lib/utilities/string');
+var assert     = require('assert');
+
+function callLocals(options) {
+  var blueprint = Blueprint.lookup('adapter');
+  try {
+    return { locals: blueprint.locals(options), threw: false };
+  } catch (e) {
+    return { error: e, threw: true };
+  }
+}
+
+
+function isSelfImport(locals, adapterName) {
+  if (!locals || !locals.importStatement) return false;
+  var importPattern = new RegExp("from\\s+['\"]\\./" + adapterName + "['\"]");
+  return importPattern.test(locals.importStatement);
+}
+
+describe('blueprint - adapter', function() {
+  describe('locals', function() {
+
+
+
+
+    it('does not produce a self-import for the application adapter (CLI default form)', function() {
+      var result = callLocals({
+        entity: { name: 'application' },
+        baseClass: 'application',
+        target: __dirname
+      });
+
+      if (!result.threw) {
+        assert.ok(!isSelfImport(result.locals, 'application'),
+          'Expected no self-import for application adapter, got: ' + JSON.stringify(result.locals));
+      }
+    });
+
+    it('does not produce a self-import for the application adapter (no base-class form)', function() {
+      var result = callLocals({
+        entity: { name: 'application' },
+        target: __dirname
+      });
+      if (!result.threw) {
+        assert.ok(!isSelfImport(result.locals, 'application'),
+          'Expected no self-import for application adapter, got: ' + JSON.stringify(result.locals));
+      }
+    });
+
+    it('extends ApplicationAdapter for non-application adapters with default base-class', function() {
+      var result = callLocals({
+        entity: { name: 'post' },
+        baseClass: 'application',
+        target: __dirname
+      });
+      assert.ok(!result.threw, 'should not throw for post adapter with default base-class');
+      assert.strictEqual(result.locals.baseClass, 'ApplicationAdapter');
+      assert.strictEqual(result.locals.importStatement, "import ApplicationAdapter from './application';");
+    });
+
+    it('extends from the specified base-class adapter', function() {
+      var result = callLocals({
+        entity: { name: 'post' },
+        baseClass: 'user',
+        target: __dirname
+      });
+      assert.ok(!result.threw);
+      assert.strictEqual(result.locals.baseClass, 'UserAdapter');
+      assert.strictEqual(result.locals.importStatement, "import UserAdapter from './user';");
+    });
+
+
+
+    it('does not produce a self-import when adapter name equals base-class (user --base-class=user)', function() {
+      var result = callLocals({
+        entity: { name: 'user' },
+        baseClass: 'user',
+        target: __dirname
+      });
+      if (!result.threw) {
+        assert.ok(!isSelfImport(result.locals, 'user'),
+          'Expected no self-import for user adapter with base-class=user, got: ' + JSON.stringify(result.locals));
+      }
+    });
+  });
+});
