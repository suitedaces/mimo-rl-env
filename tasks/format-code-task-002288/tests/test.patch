diff --git a/tests/page_test.go b/tests/page_test.go
index 215dbdb..5568936 100644
--- a/tests/page_test.go
+++ b/tests/page_test.go
@@ -924,3 +924,89 @@ func TestPageSetChecked(t *testing.T) {
 	require.NoError(t, err)
 	require.False(t, isChecked.(bool))
 }
+
+func TestPageWaitForRequestRespectsTimeoutOption(t *testing.T) {
+	BeforeEach(t)
+	defer AfterEach(t)
+	_, err := page.Goto(server.EMPTY_PAGE)
+	require.NoError(t, err)
+	start := time.Now()
+	req, err := page.WaitForRequest("**/never-fires-xyz", playwright.PageWaitForRequestOptions{
+		Timeout: playwright.Float(500),
+	})
+	elapsed := time.Since(start)
+	require.Error(t, err)
+	require.Nil(t, req)
+
+	require.Less(t, elapsed, 10*time.Second)
+}
+
+func TestPageWaitForResponseRespectsTimeoutOption(t *testing.T) {
+	BeforeEach(t)
+	defer AfterEach(t)
+	_, err := page.Goto(server.EMPTY_PAGE)
+	require.NoError(t, err)
+	start := time.Now()
+	resp, err := page.WaitForResponse("**/never-fires-xyz", playwright.PageWaitForResponseOptions{
+		Timeout: playwright.Float(500),
+	})
+	elapsed := time.Since(start)
+	require.Error(t, err)
+	require.Nil(t, resp)
+	require.Less(t, elapsed, 10*time.Second)
+}
+
+func TestPageWaitForRequestMatchingSucceeds(t *testing.T) {
+	BeforeEach(t)
+	defer AfterEach(t)
+	type result struct {
+		req playwright.Request
+		err error
+	}
+	ch := make(chan result, 1)
+	go func() {
+		r, e := page.WaitForRequest("**/empty.html", playwright.PageWaitForRequestOptions{
+			Timeout: playwright.Float(15000),
+		})
+		ch <- result{r, e}
+	}()
+
+	time.Sleep(200 * time.Millisecond)
+	_, err := page.Goto(server.EMPTY_PAGE)
+	require.NoError(t, err)
+	select {
+	case r := <-ch:
+		require.NoError(t, r.err)
+		require.NotNil(t, r.req)
+		require.Contains(t, r.req.URL(), "empty.html")
+	case <-time.After(20 * time.Second):
+		t.Fatal("WaitForRequest did not return in time")
+	}
+}
+
+func TestPageWaitForResponseMatchingSucceeds(t *testing.T) {
+	BeforeEach(t)
+	defer AfterEach(t)
+	type result struct {
+		resp playwright.Response
+		err  error
+	}
+	ch := make(chan result, 1)
+	go func() {
+		r, e := page.WaitForResponse("**/empty.html", playwright.PageWaitForResponseOptions{
+			Timeout: playwright.Float(15000),
+		})
+		ch <- result{r, e}
+	}()
+	time.Sleep(200 * time.Millisecond)
+	_, err := page.Goto(server.EMPTY_PAGE)
+	require.NoError(t, err)
+	select {
+	case r := <-ch:
+		require.NoError(t, r.err)
+		require.NotNil(t, r.resp)
+		require.Contains(t, r.resp.URL(), "empty.html")
+	case <-time.After(20 * time.Second):
+		t.Fatal("WaitForResponse did not return in time")
+	}
+}
