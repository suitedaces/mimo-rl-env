+++ b/usercase-test-coderl/test_dynamic_series_insertion.py
@@ -0,0 +1,223 @@
+
+
+
+
+
+
+
+
+
+
+from __future__ import annotations
+
+import re
+import sys
+from pathlib import Path
+
+import pytest
+from bokeh.document import Document
+
+from panel_highcharts import HighChart, HighGantt, HighMap, HighStock
+
+
+INITIAL_CONFIG = {"series": [{"name": "Initial", "data": [10, 20]}]}
+FORECAST_OPTIONS = {"name": "Forecast", "data": [3, 4, 5]}
+ACTUAL_OPTIONS = {"name": "Actual", "data": [1, 2, 3]}
+
+
+def _watch_param_changes(pane):
+    events = []
+    watcher = pane.param.watch(lambda event: events.append(event), list(pane.param))
+    return events, watcher
+
+
+def _series_payloads(events, options, redraw, animation):
+    matches = []
+    for event in events:
+        value = getattr(event, "new", event)
+        if not isinstance(value, dict):
+            continue
+        if value.get("options") != options:
+            continue
+        if value.get("redraw") is not redraw:
+            continue
+        if value.get("animation") is not animation:
+            continue
+        matches.append(value)
+    return matches
+
+
+def _assert_emitted_series_payload(events, options, redraw, animation):
+
+    assert _series_payloads(events, options, redraw, animation)
+
+
+def _typescript_without_comments(source: str) -> str:
+    source = re.sub(r"/\*.*?\*/", "", source, flags=re.S)
+    return re.sub(r"//.*", "", source)
+
+
+def test_highchart_repeated_add_series_emits_distinct_payloads_and_preserves_config():
+
+
+
+    chart = HighChart(object={"series": [{"name": "Initial", "data": [10, 20]}]})
+    events, watcher = _watch_param_changes(chart)
+
+    chart.add_series(
+        options={"name": "Forecast", "data": [3, 4, 5]}, redraw=False, animation=False
+    )
+    chart.add_series(options={"name": "Actual", "data": [1, 2, 3]})
+    chart.param.unwatch(watcher)
+
+
+    assert chart.object == {"series": [{"name": "Initial", "data": [10, 20]}]}
+
+    _assert_emitted_series_payload(
+        events, {"name": "Forecast", "data": [3, 4, 5]}, False, False
+    )
+
+    _assert_emitted_series_payload(events, {"name": "Actual", "data": [1, 2, 3]}, True, True)
+
+    assert callable(getattr(chart, "add_series", None))
+    assert chart.object == {"series": [{"name": "Initial", "data": [10, 20]}]}
+
+
+@pytest.mark.parametrize(
+    ("pane_class", "model_name"),
+    [
+        (HighChart, "HighChart"),
+        (HighStock, "HighStock"),
+        (HighMap, "HighMap"),
+        (HighGantt, "HighGantt"),
+    ],
+)
+def test_all_stateful_pane_classes_expose_add_series_and_model_transfer_property(
+    pane_class, model_name
+):
+
+
+
+    chart = pane_class(object={"series": [{"name": "Initial", "data": [10, 20]}]})
+    model = chart.get_root(Document())
+    events, watcher = _watch_param_changes(chart)
+
+
+    chart.add_series({"name": "Forecast", "data": [3, 4, 5]}, False, False)
+    chart.param.unwatch(watcher)
+
+
+    _assert_emitted_series_payload(events, {"name": "Forecast", "data": [3, 4, 5]}, False, False)
+
+    assert model is not None and "config" in model.properties()
+    assert pane_class.__name__ == model_name
+
+
+def test_add_series_requires_options_argument_with_specific_python_error_type():
+
+
+
+    chart = HighChart(object={"series": [{"name": "Initial", "data": [10, 20]}]})
+
+    with pytest.raises(TypeError):
+        chart.add_series()
+
+
+def test_add_series_state_is_independent_between_pane_instances():
+
+
+
+    first = HighChart(object={"series": [{"name": "Initial", "data": [10, 20]}]})
+    second = HighChart(object={"series": [{"name": "Initial", "data": [10, 20]}]})
+    first_events, first_watcher = _watch_param_changes(first)
+    second_events, second_watcher = _watch_param_changes(second)
+
+    first.add_series({"name": "Forecast", "data": [3, 4, 5]}, redraw=False, animation=False)
+
+    first.param.unwatch(first_watcher)
+    second.param.unwatch(second_watcher)
+
+
+    _assert_emitted_series_payload(
+        first_events, {"name": "Forecast", "data": [3, 4, 5]}, False, False
+    )
+    assert not _series_payloads(second_events, {"name": "Forecast", "data": [3, 4, 5]}, False, False)
+    assert first.object == {"series": [{"name": "Initial", "data": [10, 20]}]}
+    assert second.object == {"series": [{"name": "Initial", "data": [10, 20]}]}
+
+
+def test_panel_cleanup_is_idempotent_after_add_series_session():
+
+
+
+    chart = HighChart(object={"series": [{"name": "Initial", "data": [10, 20]}]})
+    root = chart.get_root(Document())
+    events, watcher = _watch_param_changes(chart)
+    chart.add_series({"name": "Forecast", "data": [3, 4, 5]}, redraw=False, animation=False)
+    chart.param.unwatch(watcher)
+
+
+    assert root is not None
+    _assert_emitted_series_payload(
+        events, {"name": "Forecast", "data": [3, 4, 5]}, False, False
+    )
+    chart._cleanup(root)
+
+    assert root.ref["id"] not in chart._models
+    chart._cleanup(root)
+
+    assert root.ref["id"] not in chart._models
+
+
+def test_construct_add_cycles_emit_series_payloads_without_mutating_config():
+
+
+
+    emitted_count = 0
+
+    for _ in range(5):
+        chart = HighChart(object={"series": [{"name": "Initial", "data": [10, 20]}]})
+        events, watcher = _watch_param_changes(chart)
+        chart.add_series({"name": "Forecast", "data": [3, 4, 5]}, redraw=False, animation=False)
+        chart.param.unwatch(watcher)
+
+        _assert_emitted_series_payload(
+            events, {"name": "Forecast", "data": [3, 4, 5]}, False, False
+        )
+        emitted_count += 1
+
+        assert chart.object == {"series": [{"name": "Initial", "data": [10, 20]}]}
+
+
+    assert emitted_count == 5
+
+
+def test_browser_view_cleans_series_options_and_calls_highcharts_add_series():
+
+
+
+    source = _typescript_without_comments(
+        Path("/workspace/repo/src/panel_highcharts/models/highbase.ts").read_text()
+    )
+
+
+    assert re.search(r"\.properties\.[A-Za-z0-9_]+\.change", source)
+
+    assert re.search(r"_clean_config\([^)]*options[^)]*\)", source)
+
+    assert re.search(r"\.addSeries\([^)]*options[^)]*redraw[^)]*animation[^)]*\)", source, re.S)
+
+    assert re.search(r"add[_A-Za-z0-9]*series|series[_A-Za-z0-9]*add", source, re.I)
+
+    assert "Any" in source and "Property" in source
+
+
+def test_public_import_path_is_the_only_required_pane_entry_point():
+
+
+
+    exported_names = [cls.__name__ for cls in [HighChart, HighStock, HighMap, HighGantt]]
+
+
+    assert set(exported_names) == {"HighChart", "HighStock", "HighMap", "HighGantt"}
+    assert sys.modules["panel_highcharts"].__name__ == "panel_highcharts"
