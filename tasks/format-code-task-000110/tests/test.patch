diff --git a/tests/apps/test_paint_annotations.py b/tests/apps/test_paint_annotations.py
index b349c03..bb54615 100644
--- a/tests/apps/test_paint_annotations.py
+++ b/tests/apps/test_paint_annotations.py
@@ -2,12 +2,161 @@ import json
 from pathlib import Path
 
 import numpy as np
+import pytest
 from matplotlib import cm
 from PIL import Image
 
 from pyodi.apps.paint_annotations import paint_annotations
 
 
+def _make_crowd_dataset(tmp_path):
+    """Helper: 1 image, 2 annotations - one normal (cat 0) and one crowd (cat 1)."""
+    images_folder = tmp_path / "images"
+    Path(images_folder).mkdir(exist_ok=True, parents=True)
+
+    output_folder = tmp_path / "test_result"
+    Path(output_folder).mkdir(exist_ok=True, parents=True)
+
+    images = [
+        {"id": 0, "width": 10, "height": 10, "file_name": "test_0.png"},
+    ]
+
+    annotations = [
+        {"image_id": 0, "category_id": 0, "bbox": [0, 0, 2, 2], "score": 1, "iscrowd": 0},
+        {"image_id": 0, "category_id": 1, "bbox": [5, 5, 2, 2], "score": 1, "iscrowd": 1},
+    ]
+
+    categories = [
+        {"id": 0, "name": "", "supercategory": "object"},
+        {"id": 1, "name": "", "supercategory": "object"},
+    ]
+
+    coco_data = dict(images=images, annotations=annotations, categories=categories)
+
+    image = np.zeros((10, 10, 3), dtype=np.uint8)
+    Image.fromarray(image).save(images_folder / "test_0.png")
+
+    annotation_path = tmp_path / "test_annotation.json"
+    with open(annotation_path, "w") as json_file:
+        json.dump(coco_data, json_file)
+
+    return annotation_path, images_folder, output_folder
+
+
+def _pixel_is_background(rgba_pixel):
+    """A non-painted pixel of a black source image should have R=G=B=0."""
+    return rgba_pixel[0] == 0 and rgba_pixel[1] == 0 and rgba_pixel[2] == 0
+
+
+def _pixel_is_painted(rgba_pixel):
+    return not _pixel_is_background(rgba_pixel)
+
+
+def test_default_filters_crowd_annotation(tmp_path):
+    """User calls paint_annotations with default args; crowd bbox area is NOT painted."""
+    annotation_path, images_folder, output_folder = _make_crowd_dataset(tmp_path)
+
+    paint_annotations(
+        annotation_path,
+        images_folder,
+        output_folder,
+        show_label=False,
+    )
+
+    result = np.asarray(Image.open(output_folder / "test_0_result.png"))
+
+    assert _pixel_is_background(result[6, 6]), (
+        f"Default should filter crowd box; pixel (6,6) is {result[6, 6]}"
+    )
+
+
+def test_filter_crowd_true_filters_crowd_annotation(tmp_path):
+    """Explicit filter_crowd=True: crowd bbox NOT painted."""
+    annotation_path, images_folder, output_folder = _make_crowd_dataset(tmp_path)
+
+    paint_annotations(
+        annotation_path,
+        images_folder,
+        output_folder,
+        show_label=False,
+        filter_crowd=True,
+    )
+
+    result = np.asarray(Image.open(output_folder / "test_0_result.png"))
+    assert _pixel_is_background(result[6, 6]), (
+        f"filter_crowd=True should not paint crowd; pixel (6,6) is {result[6, 6]}"
+    )
+
+
+def test_filter_crowd_false_paints_crowd_annotation(tmp_path):
+    """filter_crowd=False: crowd bbox IS painted."""
+    annotation_path, images_folder, output_folder = _make_crowd_dataset(tmp_path)
+
+    paint_annotations(
+        annotation_path,
+        images_folder,
+        output_folder,
+        show_label=False,
+        filter_crowd=False,
+    )
+
+    result = np.asarray(Image.open(output_folder / "test_0_result.png"))
+
+    assert _pixel_is_painted(result[6, 6]), (
+        f"filter_crowd=False should paint crowd box; pixel (6,6) is {result[6, 6]}"
+    )
+
+
+def test_non_crowd_annotation_painted_with_default(tmp_path):
+    """Default filter_crowd=True does NOT affect non-crowd annotations."""
+    annotation_path, images_folder, output_folder = _make_crowd_dataset(tmp_path)
+
+    paint_annotations(
+        annotation_path,
+        images_folder,
+        output_folder,
+        show_label=False,
+    )
+
+    result = np.asarray(Image.open(output_folder / "test_0_result.png"))
+
+    assert _pixel_is_painted(result[1, 1]), (
+        f"Non-crowd annotation must still be painted; pixel (1,1) is {result[1, 1]}"
+    )
+
+
+def test_annotation_without_iscrowd_key_is_painted(tmp_path):
+    """An annotation missing the iscrowd key is treated as non-crowd and painted."""
+    images_folder = tmp_path / "images"
+    Path(images_folder).mkdir(exist_ok=True, parents=True)
+    output_folder = tmp_path / "test_result"
+    Path(output_folder).mkdir(exist_ok=True, parents=True)
+
+    images = [{"id": 0, "width": 10, "height": 10, "file_name": "test_0.png"}]
+    annotations = [
+        {"image_id": 0, "category_id": 0, "bbox": [0, 0, 2, 2], "score": 1},
+    ]
+    categories = [{"id": 0, "name": "", "supercategory": "object"}]
+    coco_data = dict(images=images, annotations=annotations, categories=categories)
+
+    Image.fromarray(np.zeros((10, 10, 3), dtype=np.uint8)).save(images_folder / "test_0.png")
+    annotation_path = tmp_path / "test_annotation.json"
+    with open(annotation_path, "w") as f:
+        json.dump(coco_data, f)
+
+    paint_annotations(
+        annotation_path,
+        images_folder,
+        output_folder,
+        show_label=False,
+    )
+
+    result = np.asarray(Image.open(output_folder / "test_0_result.png"))
+    assert _pixel_is_painted(result[1, 1]), (
+        f"Annotation without iscrowd should still be painted; pixel (1,1) is {result[1, 1]}"
+    )
+
+
 def test_image_annotations(tmp_path):
 
