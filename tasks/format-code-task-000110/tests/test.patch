+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+python -m pytest -v -rA tests/apps/test_paint_annotations.py::test_default_filters_crowd_annotation tests/apps/test_paint_annotations.py::test_filter_crowd_true_filters_crowd_annotation tests/apps/test_paint_annotations.py::test_filter_crowd_false_paints_crowd_annotation tests/apps/test_paint_annotations.py::test_non_crowd_annotation_painted_with_default tests/apps/test_paint_annotations.py::test_annotation_without_iscrowd_key_is_painted
+rc=$(( rc | $? ))
+exit $rc
