+#!/bin/bash
+set -euo pipefail
+
+
+REPO_ROOT="$(git rev-parse --show-toplevel)"
+mkdir -p "${REPO_ROOT}/gopath/src/github.com/coreos"
+ln -sfn "${REPO_ROOT}" "${REPO_ROOT}/gopath/src/github.com/coreos/etcd"
+GO111MODULE=off \
+  GOPATH="${REPO_ROOT}/gopath:${REPO_ROOT}/Godeps/_workspace" \
+  go test github.com/coreos/etcd/client -run '^TestCodespec' -count=1
