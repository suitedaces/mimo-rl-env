--- /dev/null
+++ b/route/codespec_runner.js
@@ -0,0 +1,12 @@
+var fs = require('fs');
+var page = require('webpage').create();
+page.onConsoleMessage = function (message) { console.log(message); };
+page.onError = function (message) { console.log('PAGE_ERROR: ' + message); };
+page.open('file://' + fs.workingDirectory + '/route/codespec_test.html', function (status) {
+	if (status !== 'success') { phantom.exit(2); return; }
+	setTimeout(function () {
+		var title = page.evaluate(function () { return document.title; });
+		console.log('TITLE: ' + title);
+		phantom.exit(title === 'codespec-pass' ? 0 : 1);
+	}, 1800);
+});
