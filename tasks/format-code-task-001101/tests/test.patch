diff --git a/route/codespec_test.js b/route/codespec_test.js
new file mode 100644
index 000000000..bd067ede8
--- /dev/null
+++ b/route/codespec_test.js
@@ -0,0 +1,56 @@
+
+steal('can/route', function () {
+	var failures = [];
+	function fail(message) {
+		failures.push(message);
+		console.log('FAIL: ' + message);
+	}
+	function equal(actual, expected, message) {
+		if (actual !== expected) {
+			fail(message + ' expected=' + expected + ' actual=' + actual);
+		}
+	}
+	function deepEqual(actual, expected, message) {
+		if (JSON.stringify(actual) !== JSON.stringify(expected)) {
+			fail(message + ' expected=' + JSON.stringify(expected) + ' actual=' + JSON.stringify(actual));
+		}
+	}
+	function reset(routes) {
+		can.route._teardown();
+		can.route.routes = {};
+		can.route.location = { href: 'http://example.test/#!' };
+		routes();
+	}
+
+	reset(function () {
+		can.route('reports/:page/:includeArchived');
+	});
+	var routeData = { page: 7, includeArchived: true, route: 'reports/:page/:includeArchived', draft: false };
+	var routeDataSnapshot = JSON.stringify(routeData);
+	equal(can.route.param(routeData), 'reports/7/true&draft=false', 'parameterizes named route metadata');
+	equal(JSON.stringify(routeData), routeDataSnapshot, 'param leaves route metadata and values untouched');
+	var urlData = { page: 8, includeArchived: false, route: 'reports/:page/:includeArchived', draft: false };
+	var urlDataSnapshot = JSON.stringify(urlData);
+	equal(can.route.url(urlData, false), '#!reports/8/false&draft=false', 'url builds from explicit data');
+	equal(JSON.stringify(urlData), urlDataSnapshot, 'url leaves explicit data untouched');
+
+	deepEqual(can.route.deparam('reports/0/false'), { page: '0', includeArchived: 'false', route: 'reports/:page/:includeArchived' }, 'deparam preserves falsey route values');
+	equal(can.route.param({ page: 0, includeArchived: false }), 'reports/0/false', 'param preserves explicit zero and false values');
+
+	reset(function () {
+		can.route('dashboard/:id', { id: 0 });
+	});
+	can.route.location.href = 'http://example.test/#!dashboard/4&archived=true&sort=name&view=old';
+	var overrides = { id: 0, archived: false, view: '' };
+	var overrideSnapshot = JSON.stringify(overrides);
+	equal(can.route.url(overrides, true), '#!dashboard/&archived=false&sort=name&view=', 'merge preserves omitted state and honors falsey overrides');
+	equal(JSON.stringify(overrides), overrideSnapshot, 'url leaves merge overrides untouched');
+
+	can.route.location.href = 'http://example.test/#!dashboard/&archived=false&sort=name&view=';
+	var current = { id: 0, archived: false, sort: 'name', view: '' };
+	var currentSnapshot = JSON.stringify(current);
+	equal(can.route.current(current), true, 'current recognizes the canonical merged falsey state');
+	equal(can.route.current({ id: 0, archived: false, view: '' }), false, 'current rejects a missing current constraint');
+	equal(JSON.stringify(current), currentSnapshot, 'current leaves comparison data untouched');
+	document.title = failures.length ? 'codespec-fail' : 'codespec-pass';
+});
