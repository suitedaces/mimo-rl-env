+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export GOPATH="/go"
+export GOMODCACHE="/go/pkg/mod"
+export GOPROXY="off"
+export GOSUMDB="off"
+export GOVCS="*:off"
+export GOTOOLCHAIN="local"
+export GOFLAGS="-mod=readonly"
+export PROJ_NETWORK="OFF"
+
+go test -v -count=1 ./usercase-test-coderl/...
