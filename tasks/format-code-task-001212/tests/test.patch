diff --git a/erpnext/manufacturing/doctype/work_order/test_work_order_stock_reservation.py b/erpnext/manufacturing/doctype/work_order/test_work_order_stock_reservation.py
new file mode 100644
index 0000000000..ad16e22c8f
--- /dev/null
+++ b/erpnext/manufacturing/doctype/work_order/test_work_order_stock_reservation.py
@@ -0,0 +1,145 @@
+
+
+
+import frappe
+from frappe.tests import IntegrationTestCase
+from frappe.utils import flt
+
+from erpnext.manufacturing.doctype.production_plan.test_production_plan import make_bom
+from erpnext.manufacturing.doctype.work_order.test_work_order import make_wo_order_test_record
+from erpnext.stock.doctype.item.test_item import make_item
+from erpnext.stock.doctype.stock_entry.stock_entry_utils import make_stock_entry
+
+SOURCE_WAREHOUSE = "Stores - _TC"
+
+
+def _unique(prefix):
+	return f"{prefix} {frappe.generate_hash(length=8)}"
+
+
+def _setup_items_and_bom(rm_in_stock=10, qty=10):
+
+	production_item = make_item(_unique("Test WO SR FG"), {"is_stock_item": 1}).name
+	rm_item = make_item(_unique("Test WO SR RM"), {"is_stock_item": 1, "valuation_rate": 100}).name
+
+	bom = make_bom(
+		item=production_item,
+		source_warehouse=SOURCE_WAREHOUSE,
+		raw_materials=[rm_item],
+		operating_cost_per_bom_quantity=100,
+	)
+
+	if rm_in_stock:
+		make_stock_entry(item_code=rm_item, target=SOURCE_WAREHOUSE, qty=rm_in_stock, basic_rate=100)
+
+	return frappe._dict(production_item=production_item, rm_item=rm_item, bom=bom)
+
+
+def _make_reserved_work_order(production_item, qty=10, reserve_stock=1, submit=True):
+	wo = make_wo_order_test_record(
+		item=production_item,
+		qty=qty,
+		source_warehouse=SOURCE_WAREHOUSE,
+		do_not_submit=True,
+	)
+	wo.reserve_stock = reserve_stock
+	wo.save()
+	if submit:
+		wo.submit()
+		wo.reload()
+	return wo
+
+
+def _sre_for_wo(wo_name, docstatus=1):
+	filters = {"voucher_type": "Work Order", "voucher_no": wo_name}
+	if docstatus is not None:
+		filters["docstatus"] = docstatus
+	return frappe.get_all(
+		"Stock Reservation Entry",
+		filters=filters,
+		fields=["name", "item_code", "warehouse", "reserved_qty", "voucher_detail_no"],
+	)
+
+
+class TestWorkOrderStockReservation(IntegrationTestCase):
+	@IntegrationTestCase.change_settings("Stock Settings", {"enable_stock_reservation": 1})
+	def test_reserve_stock_field_default_off(self):
+		data = _setup_items_and_bom(rm_in_stock=10)
+		wo = make_wo_order_test_record(
+			item=data.production_item, qty=10, source_warehouse=SOURCE_WAREHOUSE, do_not_submit=True
+		)
+
+		self.assertTrue(wo.meta.has_field("reserve_stock"))
+		self.assertFalse(wo.reserve_stock)
+
+	@IntegrationTestCase.change_settings("Stock Settings", {"enable_stock_reservation": 1})
+	def test_full_reservation_on_submit(self):
+		data = _setup_items_and_bom(rm_in_stock=10)
+		wo = _make_reserved_work_order(data.production_item, qty=10)
+
+		entries = _sre_for_wo(wo.name)
+		self.assertEqual(len(entries), 1)
+		self.assertEqual(entries[0].item_code, data.rm_item)
+		self.assertEqual(entries[0].warehouse, SOURCE_WAREHOUSE)
+		self.assertEqual(flt(entries[0].reserved_qty), 10.0)
+
+		self.assertEqual(wo.status, "Stock Reserved")
+
+	@IntegrationTestCase.change_settings("Stock Settings", {"enable_stock_reservation": 1})
+	def test_partial_reservation_when_insufficient_stock(self):
+		data = _setup_items_and_bom(rm_in_stock=6)
+		wo = _make_reserved_work_order(data.production_item, qty=10)
+
+		entries = _sre_for_wo(wo.name)
+		self.assertEqual(len(entries), 1)
+		self.assertEqual(flt(entries[0].reserved_qty), 6.0)
+
+		self.assertEqual(wo.status, "Stock Partially Reserved")
+
+	@IntegrationTestCase.change_settings("Stock Settings", {"enable_stock_reservation": 1})
+	def test_availability_respects_existing_reservations(self):
+
+		data = _setup_items_and_bom(rm_in_stock=15)
+
+		wo1 = _make_reserved_work_order(data.production_item, qty=10)
+		self.assertEqual(flt(_sre_for_wo(wo1.name)[0].reserved_qty), 10.0)
+		self.assertEqual(wo1.status, "Stock Reserved")
+
+		wo2 = _make_reserved_work_order(data.production_item, qty=10)
+		entries2 = _sre_for_wo(wo2.name)
+
+		self.assertEqual(flt(entries2[0].reserved_qty), 5.0)
+		self.assertEqual(wo2.status, "Stock Partially Reserved")
+
+	@IntegrationTestCase.change_settings("Stock Settings", {"enable_stock_reservation": 1})
+	def test_no_reservation_when_nothing_available(self):
+		data = _setup_items_and_bom(rm_in_stock=10)
+
+		wo1 = _make_reserved_work_order(data.production_item, qty=10)
+		self.assertEqual(flt(_sre_for_wo(wo1.name)[0].reserved_qty), 10.0)
+
+
+		wo2 = _make_reserved_work_order(data.production_item, qty=10)
+		self.assertEqual(_sre_for_wo(wo2.name), [])
+		self.assertNotIn(wo2.status, ("Stock Reserved", "Stock Partially Reserved"))
+
+	def test_disabled_setting_clears_flag_and_skips_reservation(self):
+		with self.change_settings("Stock Settings", {"enable_stock_reservation": 0}):
+			data = _setup_items_and_bom(rm_in_stock=10)
+			wo = _make_reserved_work_order(data.production_item, qty=10)
+
+			self.assertFalse(wo.reserve_stock)
+			self.assertEqual(_sre_for_wo(wo.name), [])
+			self.assertNotIn(wo.status, ("Stock Reserved", "Stock Partially Reserved"))
+
+	@IntegrationTestCase.change_settings("Stock Settings", {"enable_stock_reservation": 1})
+	def test_cancelling_work_order_releases_reservation(self):
+		data = _setup_items_and_bom(rm_in_stock=10)
+		wo = _make_reserved_work_order(data.production_item, qty=10)
+
+		self.assertEqual(len(_sre_for_wo(wo.name)), 1)
+
+		wo.cancel()
+
+
+		self.assertEqual(_sre_for_wo(wo.name, docstatus=1), [])
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
