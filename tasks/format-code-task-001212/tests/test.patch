@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+BENCH_DIR=/home/frappe/frappe-bench
+SITE=test_site
+
+
+
+service mariadb start >/dev/null 2>&1 || true
+service redis-server start >/dev/null 2>&1 || true
+
+
+for _ in $(seq 1 30); do
+    if mysqladmin ping >/dev/null 2>&1 || [ -S /run/mysqld/mysqld.sock ]; then
+        break
+    fi
+    sleep 1
+done
+
+cd "$BENCH_DIR"
+
+bench --site "$SITE" migrate >/dev/null 2>&1
+
+
+bench --site "$SITE" run-tests --app erpnext \
+    --module erpnext.stock.doctype.stock_reservation_entry.test_stock_reservation_entry
+bench --site "$SITE" run-tests --app erpnext \
+    --module erpnext.manufacturing.doctype.work_order.test_work_order
+
+
+bench --site "$SITE" run-tests --app erpnext \
+    --module erpnext.manufacturing.doctype.work_order.test_work_order_stock_reservation
