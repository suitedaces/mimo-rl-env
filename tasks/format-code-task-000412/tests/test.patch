diff --git a/tests/serialization/test_serde.py b/tests/serialization/test_serde.py
index 1b2a426ac1..368726f781 100644
--- a/tests/serialization/test_serde.py
+++ b/tests/serialization/test_serde.py
@@ -343,3 +343,73 @@ class TestSerDe:
             TypeError, match="cannot serialize object of type <class 'tests.serialization.test_serde.C'>"
         ):
             serialize(i)
+
+    def test_backwards_compat_issue_xcom_dataset_single_nested(self):
+        """Issue 31866 reproduction: outer new-style Dataset wrapping inner old-style dict.
+
+        Loading XCom entries created on Airflow 2.5 used to raise
+        ``KeyError: '__var'`` because ``_convert`` indexed ``__var`` twice.
+        """
+        uri = "bq://google_cloud_default@?table=table_name&schema=schema_name"
+        data = {
+            "__classname__": "airflow.datasets.Dataset",
+            "__version__": 1,
+            "__data__": {
+                "__var": {"uri": uri, "extra": None},
+                "__type": "dict",
+            },
+        }
+        result = deserialize(data)
+        assert isinstance(result, Dataset)
+        assert result.uri == uri
+        assert result.extra is None
+
+    def test_backwards_compat_issue_xcom_list_of_datasets(self):
+        """Exact list-of-Datasets shape from the bug report deserializes."""
+        uri = "bq://google_cloud_default@?table=table_name&schema=schema_name"
+        value = [
+            {
+                "__classname__": "airflow.datasets.Dataset",
+                "__version__": 1,
+                "__data__": {
+                    "__var": {"uri": uri, "extra": None},
+                    "__type": "dict",
+                },
+            }
+        ]
+        result = deserialize(value)
+        assert isinstance(result, list)
+        assert len(result) == 1
+        assert isinstance(result[0], Dataset)
+        assert result[0].uri == uri
+
+    def test_backwards_compat_old_style_dict(self):
+        """Old-style ``{"__type": "dict", "__var": <dict>}`` becomes the plain dict."""
+        data = {"__type": "dict", "__var": {"a": 1, "b": 2}}
+        result = deserialize(data)
+        assert result == {"a": 1, "b": 2}
+
+    def test_backwards_compat_double_nested_preserved(self):
+        """Existing double-nested old-style Dataset must still deserialize."""
+        uri = "s3://does_not_exist"
+        data = {
+            "__type": "airflow.datasets.Dataset",
+            "__source": None,
+            "__var": {
+                "__var": {"uri": uri, "extra": None},
+                "__type": "dict",
+            },
+        }
+        dataset = deserialize(data)
+        assert isinstance(dataset, Dataset)
+        assert dataset.uri == uri
+
+    def test_backwards_compat_single_nested_non_dict_preserved(self):
+        """Single-nested old-style non-dict class (e.g., Dataset directly) still works."""
+        data = {
+            "__type": "airflow.datasets.Dataset",
+            "__var": {"uri": "s3://x", "extra": None},
+        }
+        result = deserialize(data)
+        assert isinstance(result, Dataset)
+        assert result.uri == "s3://x"
