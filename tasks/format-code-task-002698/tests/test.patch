+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set +u
+source /root/.venv/bin/activate
+set -u
+
+export PYTHONPATH="/testbed/lib/spack:/testbed/lib/spack/external"
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest \
+      lib/spack/spack/test/llnl/util/filesystem.py \
+      -v
+    ;;
+  new)
+    python3 -m pytest \
+      lib/spack/spack/test/llnl/util/test_tree_symlink_behavior.py \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new" >&2
+    exit 2
+    ;;
+esac
