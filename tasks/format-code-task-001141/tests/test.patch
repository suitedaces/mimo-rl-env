diff --git a/syft/pkg/cataloger/python/requirements_contract_test.go b/syft/pkg/cataloger/python/requirements_contract_test.go
new file mode 100644
index 00000000..84b282dd
--- /dev/null
+++ b/syft/pkg/cataloger/python/requirements_contract_test.go
@@ -0,0 +1,35 @@
+package python
+
+import (
+	"testing"
+
+	"github.com/anchore/syft/syft/pkg"
+	"github.com/anchore/syft/syft/pkg/cataloger/internal/pkgtest"
+)
+
+func TestRequirementsCatalogerRetainsUnknownVersions(t *testing.T) {
+	resolver := pkgtest.NewCatalogTester().FromDirectory(t, "test-fixtures/requires/contracts")
+	resolver.Expects([]pkg.Package{
+		{Name: "flask", Version: "4.0.0", PURL: "pkg:pypi/flask@4.0.0", Type: pkg.PythonPkg, Language: pkg.Python},
+		{Name: "sqlalchemy", PURL: "pkg:pypi/sqlalchemy", Type: pkg.PythonPkg, Language: pkg.Python},
+		{Name: "greater", PURL: "pkg:pypi/greater", Type: pkg.PythonPkg, Language: pkg.Python},
+		{Name: "less", PURL: "pkg:pypi/less", Type: pkg.PythonPkg, Language: pkg.Python},
+		{Name: "maximum", PURL: "pkg:pypi/maximum", Type: pkg.PythonPkg, Language: pkg.Python},
+		{Name: "numpy", PURL: "pkg:pypi/numpy", Type: pkg.PythonPkg, Language: pkg.Python},
+		{Name: "Mopidy-Dirble", PURL: "pkg:pypi/Mopidy-Dirble", Type: pkg.PythonPkg, Language: pkg.Python},
+		{Name: "coverage", PURL: "pkg:pypi/coverage", Type: pkg.PythonPkg, Language: pkg.Python},
+		{Name: "plain-package", PURL: "pkg:pypi/plain-package", Type: pkg.PythonPkg, Language: pkg.Python},
+		{Name: "continued-package", PURL: "pkg:pypi/continued-package", Type: pkg.PythonPkg, Language: pkg.Python},
+		{Name: "duplicate-package", Version: "1.0", PURL: "pkg:pypi/duplicate-package@1.0", Type: pkg.PythonPkg, Language: pkg.Python},
+		{Name: "duplicate-package", PURL: "pkg:pypi/duplicate-package", Type: pkg.PythonPkg, Language: pkg.Python},
+	}, nil)
+	resolver.IgnorePackageFields("FoundBy", "Locations").TestCataloger(t, NewPythonIndexCataloger())
+}
+
+func TestRequirementsCatalogerSkipsControlsAndMalformedLines(t *testing.T) {
+	resolver := pkgtest.NewCatalogTester().FromDirectory(t, "test-fixtures/requires/options")
+	resolver.Expects([]pkg.Package{{
+		Name: "visible-package", PURL: "pkg:pypi/visible-package", Type: pkg.PythonPkg, Language: pkg.Python,
+	}}, nil)
+	resolver.IgnorePackageFields("FoundBy", "Locations").TestCataloger(t, NewPythonIndexCataloger())
+}
diff --git a/syft/pkg/cataloger/python/test-fixtures/requires/contracts/requirements-contract.txt b/syft/pkg/cataloger/python/test-fixtures/requires/contracts/requirements-contract.txt
new file mode 100644
index 00000000..3e179e25
--- /dev/null
+++ b/syft/pkg/cataloger/python/test-fixtures/requires/contracts/requirements-contract.txt
@@ -0,0 +1,20 @@
+# exact pins remain versioned
+flask==4.0.0
+
+# ranges and bare declarations remain visible without inventing a version
+sqlalchemy >= 1.0.0
+greater > 1.0
+less < 2.0
+maximum <= 5.0
+numpy >= 3.4.1, < 4.0; python_version < "3.12"
+Mopidy-Dirble ~= 1.1
+coverage != 3.5
+plain-package
+
+# a continued declaration is one requirement; hashes and comments are not packages
+continued-package >= 2.0, \
+    < 3.0 --hash=sha256:deadbeef # wheel hash
+
+# duplicate declarations are retained
+duplicate-package==1.0
+duplicate-package>=1.0
diff --git a/syft/pkg/cataloger/python/test-fixtures/requires/options/requirements-options.txt b/syft/pkg/cataloger/python/test-fixtures/requires/options/requirements-options.txt
new file mode 100644
index 00000000..300c35bd
--- /dev/null
+++ b/syft/pkg/cataloger/python/test-fixtures/requires/options/requirements-options.txt
@@ -0,0 +1,13 @@
+# installer controls, editable/direct references, malformed and commented lines are ignored
+-r other.txt
+-c constraints-short.txt
+--constraint constraints.txt
+--index-url https://example.invalid/simple
+--find-links https://example.invalid/wheels
+--trusted-host example.invalid
+-e git+https://example.invalid/repo.git#egg=editable
+direct @ https://example.invalid/direct.whl
+== 2.0
+not a requirement
+# commented-package==9.9
+visible-package
