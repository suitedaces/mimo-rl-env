@@ -0,0 +1,75 @@
+
+
+
+
+
+
+from unittest import TestCase
+from mdutils.tools.Table import Table
+
+
+class TestTableDefaultAlign(TestCase):
+
+    def test_create_table_default_uses_plain_dashes(self):
+
+        table = Table()
+        result = table.create_table(columns=2, rows=2, text=['a', 'b', 'c', 'd'])
+        expected = '\n|a|b|\n| --- | --- |\n|c|d|\n'
+        self.assertEqual(result, expected)
+
+    def test_create_table_default_does_not_use_center(self):
+
+        table = Table()
+        result = table.create_table(columns=2, rows=2, text=['a', 'b', 'c', 'd'])
+        self.assertNotIn(':---:', result)
+        self.assertNotIn(':---', result)
+        self.assertNotIn('---:', result)
+
+    def test_create_table_explicit_none_uses_plain_dashes(self):
+
+        table = Table()
+        result = table.create_table(columns=2, rows=2,
+                                    text=['a', 'b', 'c', 'd'], text_align=None)
+        expected = '\n|a|b|\n| --- | --- |\n|c|d|\n'
+        self.assertEqual(result, expected)
+
+    def test_create_table_center_alignment_preserved(self):
+
+        table = Table()
+        result = table.create_table(columns=2, rows=2,
+                                    text=['a', 'b', 'c', 'd'], text_align='center')
+        expected = '\n|a|b|\n| :---: | :---: |\n|c|d|\n'
+        self.assertEqual(result, expected)
+
+    def test_create_table_left_alignment_preserved(self):
+
+        table = Table()
+        result = table.create_table(columns=2, rows=2,
+                                    text=['a', 'b', 'c', 'd'], text_align='left')
+        expected = '\n|a|b|\n| :--- | :--- |\n|c|d|\n'
+        self.assertEqual(result, expected)
+
+    def test_create_table_right_alignment_preserved(self):
+
+        table = Table()
+        result = table.create_table(columns=2, rows=2,
+                                    text=['a', 'b', 'c', 'd'], text_align='right')
+        expected = '\n|a|b|\n| ---: | ---: |\n|c|d|\n'
+        self.assertEqual(result, expected)
+
+    def test_create_table_invalid_text_align_raises(self):
+
+        table = Table()
+        with self.assertRaises(ValueError):
+            table.create_table(columns=2, rows=2,
+                               text=['a', 'b', 'c', 'd'],
+                               text_align='invalid')
+
+    def test_create_table_default_three_columns(self):
+
+        table = Table()
+        result = table.create_table(columns=3, rows=2,
+                                    text=['a', 'b', 'c', 'd', 'e', 'f'])
+        self.assertIn('| --- | --- | --- |', result)
+        self.assertNotIn(':---:', result)
+
