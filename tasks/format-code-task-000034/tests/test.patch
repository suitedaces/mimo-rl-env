+func TestDebugServicePanicErrorDetails(t *testing.T) {
+	rpcConn := debugRpcConn(t)
+
+	err := callTestPanicAsync(t, rpcConn, "panic probe alpha hidden")
+	assertDebugPanicError(t, err, "panic probe alpha hidden")
+}
+
+func TestDebugServicePanicDoesNotCloseConnection(t *testing.T) {
+	rpcConn := debugRpcConn(t)
+
+	firstErr := callTestPanicAsync(t, rpcConn, "panic probe beta one hidden")
+	assertDebugPanicError(t, firstErr, "panic probe beta one hidden")
+
+	secondErr := callTestPanicAsync(t, rpcConn, "panic probe beta two hidden")
+	assertDebugPanicError(t, secondErr, "panic probe beta two hidden")
+}
+
+func debugRpcConn(t *testing.T) jsonrpc2.Conn {
+	t.Helper()
+
+	debugServer := httptest.NewServer(newDebugService())
+	t.Cleanup(debugServer.Close)
+
+	serverUrl, err := url.Parse(debugServer.URL)
+	require.NoError(t, err)
+	serverUrl.Scheme = "ws"
+
+	wsConn, _, err := websocket.DefaultDialer.Dial(serverUrl.String(), nil)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		require.NoError(t, wsConn.Close())
+	})
+
+	rpcConn := jsonrpc2.NewConn(newWebSocketStream(wsConn))
+	rpcConn.Go(context.Background(), nil)
+
+	return rpcConn
+}
+
+func callTestPanicAsync(t *testing.T, rpcConn jsonrpc2.Conn, message string) error {
+	t.Helper()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+
+	_, err := rpcConn.Call(ctx, "TestPanicAsync", []any{message}, nil)
+	require.Error(t, err)
+
+	return err
+}
+
+func assertDebugPanicError(t *testing.T, err error, panicMessage string) {
+	t.Helper()
+
+	var rpcErr *jsonrpc2.Error
+	require.True(t, errors.As(err, &rpcErr), "expected JSON-RPC error, got %T: %v", err, err)
+	require.Equal(t, jsonrpc2.InternalError, rpcErr.Code)
+	require.True(t, strings.HasPrefix(rpcErr.Message, "panic:"), "message should start with panic:, got %q", rpcErr.Message)
+	require.Contains(t, rpcErr.Message, panicMessage)
+}
