+		{
+			name:    "action one arg",
+			message: "hidden action one panic",
+			handler: HandlerAction1(func(ctx context.Context, value string) error {
+				require.Equal(t, "alpha", value)
+				panicRpcTestFrame("hidden action one panic")
+				return nil
+			}),
+			request: requestWithParams(t, "alpha"),
+		},
+		{
+			name:    "action two args",
+			message: "hidden action two panic",
+			handler: HandlerAction2(func(ctx context.Context, value string, count int) error {
+				require.Equal(t, "bravo", value)
+				require.Equal(t, 42, count)
+				panicRpcTestFrame("hidden action two panic")
+				return nil
+			}),
+			request: requestWithParams(t, "bravo", 42),
+		},
+		{
+			name:    "action three args",
+			message: "hidden action three panic",
+			handler: HandlerAction3(func(ctx context.Context, value string, count int, flag bool) error {
+				require.Equal(t, "charlie", value)
+				require.Equal(t, 7, count)
+				require.True(t, flag)
+				panicRpcTestFrame("hidden action three panic")
+				return nil
+			}),
+			request: requestWithParams(t, "charlie", 7, true),
+		},
+		{
+			name:    "func zero args",
+			message: "hidden func zero panic",
+			handler: HandlerFunc0(func(context.Context) (string, error) {
+				panicRpcTestFrame("hidden func zero panic")
+				return "", nil
+			}),
+			request: requestWithParams(t),
+		},
+		{
+			name:    "func one arg",
+			message: "hidden func one panic",
+			handler: HandlerFunc1(func(ctx context.Context, value string) (string, error) {
+				require.Equal(t, "delta", value)
+				panicRpcTestFrame("hidden func one panic")
+				return "", nil
+			}),
+			request: requestWithParams(t, "delta"),
+		},
+		{
+			name:    "func two args",
+			message: "hidden func two panic",
+			handler: HandlerFunc2(func(ctx context.Context, value string, count int) (string, error) {
+				require.Equal(t, "echo", value)
+				require.Equal(t, 84, count)
+				panicRpcTestFrame("hidden func two panic")
+				return "", nil
+			}),
+			request: requestWithParams(t, "echo", 84),
+		},
+		{
+			name:    "func three args",
+			message: "hidden func three panic",
+			handler: HandlerFunc3(func(ctx context.Context, value string, count int, flag bool) (string, error) {
+				require.Equal(t, "foxtrot", value)
+				require.Equal(t, 21, count)
+				require.False(t, flag)
+				panicRpcTestFrame("hidden func three panic")
+				return "", nil
+			}),
+			request: requestWithParams(t, "foxtrot", 21, false),
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var repliedErr error
+			reply := func(ctx context.Context, result any, err error) error {
+				repliedErr = err
+				return err
+			}
+
+			var handlerErr error
+			require.NotPanics(t, func() {
+				handlerErr = tc.handler(context.Background(), nil, reply, tc.request)
+			})
+
+			require.Error(t, handlerErr)
+			require.Same(t, repliedErr, handlerErr)
+			assertPanicRpcError(t, handlerErr, tc.message)
+		})
+	}
+}
+
+func requestWithParams(t *testing.T, params ...any) jsonrpc2.Request {
+	t.Helper()
+
+	req, err := jsonrpc2.NewCall(jsonrpc2.NewNumberID(1), "hidden/test", params)
+	require.NoError(t, err)
+
+	return req
+}
+
+func assertPanicRpcError(t *testing.T, err error, panicMessage string) {
+	t.Helper()
+
+	var rpcErr *jsonrpc2.Error
+	require.True(t, errors.As(err, &rpcErr), "expected JSON-RPC error, got %T: %v", err, err)
+	require.Equal(t, jsonrpc2.InternalError, rpcErr.Code)
+	require.True(t, strings.HasPrefix(rpcErr.Message, "panic:"), "message should start with panic:, got %q", rpcErr.Message)
+	require.Contains(t, rpcErr.Message, panicMessage)
+}
+
+func panicRpcTestFrame(message string) {
+	panic(message)
+}
