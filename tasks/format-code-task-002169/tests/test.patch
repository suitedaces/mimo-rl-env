+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+if ! neo4j status >/dev/null 2>&1; then
+    neo4j start
+    sleep 8
+fi
+
+
+export INFRAHUB_DB_TYPE=neo4j
+
+
+neo4j_bolt_ready() {
+    python3 - <<'PY'
+import socket
+with socket.socket() as sock:
+    sock.settimeout(1)
+    sock.connect(("127.0.0.1", 7687))
+PY
+}
+
+if ! neo4j_bolt_ready >/dev/null 2>&1; then
+    neo4j stop >/dev/null 2>&1 || true
+    pid_file="/var/lib/neo4j/run/neo4j.pid"
+    if [ -f "$pid_file" ]; then
+        pid="$(cat "$pid_file" 2>/dev/null || true)"
+        if [ -n "$pid" ] && ps -p "$pid" >/dev/null 2>&1; then
+            kill "$pid" >/dev/null 2>&1 || true
+            sleep 2
+        fi
+        rm -f "$pid_file"
+    fi
+    neo4j start
+fi
+
+for _ in $(seq 1 60); do
+    if neo4j_bolt_ready >/dev/null 2>&1; then
+        break
+    fi
+    sleep 1
+done
+
+if ! neo4j_bolt_ready >/dev/null 2>&1; then
+    echo "Neo4j Bolt port 7687 did not become ready" >&2
+    exit 1
+fi
+
+DIFFSUMMARY_TESTS="test_query_diffsummary_returns_node_level_entries or test_query_diffsummary_honors_branch_only or test_query_diffsummary_honors_time_window or test_query_diffsummary_includes_relationship_only_node_as_updated"
+
+case "${1:-}" in
+    base)
+        python3 -m pytest backend/tests/unit/graphql/test_graphql_query.py -v -k "not (${DIFFSUMMARY_TESTS})"
+        ;;
+    new)
+        python3 -m pytest backend/tests/unit/graphql/test_graphql_query.py -v -k "(${DIFFSUMMARY_TESTS})"
+        ;;
+    *)
+        echo "usage: $0 base|new"
+        exit 2
+        ;;
+esac
