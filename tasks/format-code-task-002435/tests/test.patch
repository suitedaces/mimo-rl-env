         foo_method = cls.MY_MAP["foo"]
         return foo_method(Foo())
 [builtins fixtures/isinstancelist.pyi]
+
+[case testSelfTypeOverloadedCallableDunder]
+from typing import Awaitable, Callable, Generic, TypeVar, overload
+
+class Result: ...
+
+Handler = Callable[[], Result]
+AsyncHandler = Callable[[], Awaitable[Result]]
+
+T = TypeVar("T", Handler, AsyncHandler)
+
+class Middleware(Generic[T]):
+    def __init__(self, handler: T) -> None:
+        self.handler: T = handler
+
+    @overload
+    def __call__(self: "Middleware[Handler]") -> Result: ...
+    @overload
+    def __call__(self: "Middleware[AsyncHandler]") -> Awaitable[Result]: ...
+    def __call__(self):
+        return self.handler()
+
+    @overload
+    def call(self: "Middleware[Handler]") -> Result: ...
+    @overload
+    def call(self: "Middleware[AsyncHandler]") -> Awaitable[Result]: ...
+    def call(self):
+        return self.handler()
+
+def handler() -> Result: ...
+async def async_handler() -> Result: ...
+
+reveal_type(Middleware(handler)())  # N: Revealed type is "__main__.Result"
+reveal_type(Middleware(async_handler)())  # N: Revealed type is "typing.Awaitable[__main__.Result]"
+reveal_type(Middleware(handler).call())  # N: Revealed type is "__main__.Result"
+reveal_type(Middleware(async_handler).call())  # N: Revealed type is "typing.Awaitable[__main__.Result]"
+[builtins fixtures/async_await.pyi]
+[typing fixtures/typing-async.pyi]
+
+[case testSelfTypeOverloadedCallableDunderPicksSecondOverload]
+from typing import Generic, TypeVar, overload
+
+T = TypeVar("T", int, str)
+
+class Box(Generic[T]):
+    def __init__(self, value: T) -> None:
+        self.value: T = value
+
+    @overload
+    def __call__(self: "Box[int]") -> int: ...
+    @overload
+    def __call__(self: "Box[str]") -> str: ...
+    def __call__(self):
+        return self.value
+
+reveal_type(Box(1)())  # N: Revealed type is "builtins.int"
+reveal_type(Box("a")())  # N: Revealed type is "builtins.str"
+
+[case testSelfTypeOverloadedCallableDunderOnSubclass]
+from typing import Generic, TypeVar, overload
+
+T = TypeVar("T", int, str)
+
+class Base(Generic[T]):
+    def __init__(self, value: T) -> None:
+        self.value: T = value
+
+    @overload
+    def __call__(self: "Base[int]") -> int: ...
+    @overload
+    def __call__(self: "Base[str]") -> str: ...
+    def __call__(self):
+        return self.value
+
+class IntBase(Base[int]):
+    pass
+
+class StrBase(Base[str]):
+    pass
+
+reveal_type(IntBase(1)())  # N: Revealed type is "builtins.int"
+reveal_type(StrBase("a")())  # N: Revealed type is "builtins.str"
+
+[case testSelfTypeNonOverloadedCallableDunderInvalidSelf]
+from typing import Generic, TypeVar
+
+T = TypeVar("T", int, str)
+
+class Box(Generic[T]):
+    def __init__(self, value: T) -> None:
+        self.value: T = value
+
+    def __call__(self: "Box[int]") -> int:
+        return 0
+
+reveal_type(Box(1)())  # N: Revealed type is "builtins.int"
+Box("a")()  # E: Invalid self argument "Box[str]" to attribute function "__call__" with type "Callable[[Box[int]], int]"
