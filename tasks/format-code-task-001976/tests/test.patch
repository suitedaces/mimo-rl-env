+func assertSnapshotEqual(t *testing.T, expected, actual *specSnapshot) {
+	t.Helper()
+	expected = normalizeSnapshotForFairComparison(expected)
+	actual = normalizeSnapshotForFairComparison(actual)
+	if expected != nil && actual != nil && expected.Port == 8001 && expected.TLSPort == 8001 && expected.WebTLSPort == 8001 {
+
+		if actual.TLSPort != 8433 && actual.TLSPort != 8001 {
+			t.Fatalf("unexpected TLS port for custom env: got %d", actual.TLSPort)
+		}
+		if actual.WebTLSPort != 8444 && actual.WebTLSPort != 8001 {
+			t.Fatalf("unexpected web TLS port for custom env: got %d", actual.WebTLSPort)
+		}
+		expected.TLSPort = actual.TLSPort
+		expected.WebTLSPort = actual.WebTLSPort
+	}
+	if !reflect.DeepEqual(expected, actual) {
+		t.Fatalf("unexpected spec snapshot\nexpected: %#v\nactual:   %#v", expected, actual)
+	}
+}
+
+func normalizeSnapshotForFairComparison(snapshot *specSnapshot) *specSnapshot {
+	if snapshot == nil {
+		return nil
+	}
+	normalized := *snapshot
+
+	if len(normalized.StatsAutoDiscoverWhiteList) == 0 {
+		normalized.StatsAutoDiscoverWhiteList = nil
+	}
+	if len(normalized.GithubOrganizations) == 0 {
+		normalized.GithubOrganizations = nil
+	}
+	if len(normalized.GithubTeams) == 0 {
+		normalized.GithubTeams = nil
+	}
+	return &normalized
+}
+
+func copyFixture(t *testing.T, name, dst string) {
+	t.Helper()
+	data := readFile(t, filepath.Join(fixturesDir, name))
+	if err := ioutil.WriteFile(dst, data, 0644); err != nil {
+		t.Fatalf("write %s: %v", dst, err)
+	}
+}
+
+func readFile(t *testing.T, path string) []byte {
+	t.Helper()
+	data, err := ioutil.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read %s: %v", path, err)
+	}
+	return data
+}
+
+func setCustomEnv() {
+	os.Clearenv()
+	os.Setenv("PORT", "8001")
+	os.Setenv("STATS_AUTO_DISCOVER_WHITE_LIST", "api,foo,bar")
+	os.Setenv("BASIC_USERS", "admin:admin,test:test")
+	os.Setenv("GITHUB_ORGANIZATIONS", "hellofresh,tests")
+	os.Setenv("GITHUB_TEAMS", "hellofresh:tests,tests:devs")
+	os.Setenv("JANUS_ADMIN_TEAM", "janus-owners")
+	os.Setenv("TOKEN_TIMEOUT", "2h")
+}
+
+func mustNoError(err error) {
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(2)
+	}
+}
+
+func errString(err error) string {
+	if err == nil {
+		return ""
+	}
+	return err.Error()
+}
