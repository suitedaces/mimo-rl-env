+func TestUsercaseHelperProcess(t *testing.T) {
+	if os.Getenv("USERCASE_HELPER_PROCESS") != "1" {
+		return
+	}
+
+	args := os.Args
+	for len(args) > 0 && args[0] != "--" {
+		args = args[1:]
+	}
+	if len(args) < 2 {
+		fmt.Fprintln(os.Stderr, "missing helper scenario")
+		os.Exit(2)
+	}
+	scenario := args[1]
+	rest := args[2:]
+
+	payload := runScenario(scenario, rest)
+	if err := json.NewEncoder(os.Stdout).Encode(payload); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(2)
+	}
+	os.Exit(0)
+}
+
+func runScenario(scenario string, args []string) helperPayload {
+	switch scenario {
+	case "load-explicit":
+		spec, err := config.Load(args[0])
+		mustNoError(err)
+		return helperPayload{Spec: snapshot(spec)}
+	case "load-empty":
+		spec, err := config.Load("")
+		mustNoError(err)
+		return helperPayload{Spec: snapshot(spec)}
+	case "load-missing":
+		spec, err := config.Load(args[0])
+		return helperPayload{
+			NilSpec:        spec == nil,
+			ErrorMessage:   errString(err),
+			ErrorHasPrefix: strings.HasPrefix(errString(err), "config file not found:"),
+		}
+	case "load-env-default":
+		spec, err := config.LoadEnv()
+		mustNoError(err)
+		return helperPayload{Spec: snapshot(spec)}
+	case "load-env-custom":
+		spec, err := config.LoadEnv()
+		mustNoError(err)
+		return helperPayload{Spec: snapshot(spec)}
+	case "load-env-bad-duration":
+		spec, err := config.LoadEnv()
+		return helperPayload{
+			NilSpec:      spec == nil,
+			ErrorMessage: errString(err),
+		}
+	case "load-env-repeat-default":
+		first, err := config.LoadEnv()
+		mustNoError(err)
+		second, err := config.LoadEnv()
+		mustNoError(err)
+		return helperPayload{First: snapshot(first), Second: snapshot(second)}
+	case "load-env-no-global-state":
+		os.Clearenv()
+		first, err := config.LoadEnv()
+		mustNoError(err)
+		setCustomEnv()
+		noise, err := config.LoadEnv()
+		mustNoError(err)
+		os.Clearenv()
+		second, err := config.LoadEnv()
+		mustNoError(err)
+		return helperPayload{First: snapshot(first), Noise: snapshot(noise), Second: snapshot(second)}
+	default:
+		fmt.Fprintf(os.Stderr, "unknown helper scenario %q\n", scenario)
+		os.Exit(2)
+	}
+	return helperPayload{}
+}
+
+func runHelper(t *testing.T, dir string, env map[string]string, scenario string, args ...string) helperPayload {
+	t.Helper()
+	cmdArgs := append([]string{"-test.run=TestUsercaseHelperProcess", "--", scenario}, args...)
+	cmd := exec.Command(os.Args[0], cmdArgs...)
+	if dir != "" {
+		cmd.Dir = dir
+	}
+
+	cmd.Env = []string{
+		"USERCASE_HELPER_PROCESS=1",
+		"PATH=" + os.Getenv("PATH"),
+	}
+	for k, v := range env {
+		cmd.Env = append(cmd.Env, k+"="+v)
+	}
+
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("helper %s failed: %v\n%s", scenario, err, out)
+	}
+
+	var payload helperPayload
+	if err := json.Unmarshal(out, &payload); err != nil {
+		t.Fatalf("helper %s returned invalid JSON: %v\n%s", scenario, err, out)
+	}
+	return payload
+}
