+func snapshot(s *config.Specification) *specSnapshot {
+	if s == nil {
+		return nil
+	}
+	return &specSnapshot{
+		Port:                        s.Port,
+		WebPort:                     s.Web.Port,
+		DatabaseDSN:                 s.Database.DSN,
+		RequestID:                   s.RequestID,
+		TLSPort:                     s.TLS.Port,
+		WebTLSPort:                  s.Web.TLS.Port,
+		BackendFlushIntervalNanos:   s.BackendFlushInterval.Nanoseconds(),
+		RespondingIdleTimeoutNanos:  s.RespondingTimeouts.IdleTimeout.Nanoseconds(),
+		ClusterUpdateFrequencyNanos: s.Cluster.UpdateFrequency.Nanoseconds(),
+		CredentialsAlgorithm:        s.Web.Credentials.Algorithm,
+		CredentialsTimeoutNanos:     s.Web.Credentials.Timeout.Nanoseconds(),
+		BasicUsers:                  s.Web.Credentials.Basic.Users,
+		StatsDSN:                    s.Stats.DSN,
+		StatsErrorsSection:          s.Stats.ErrorsSection,
+		StatsAutoDiscoverWhiteList:  s.Stats.AutoDiscoverWhiteList,
+		GithubOrganizations:         s.Web.Credentials.Github.Organizations,
+		GithubTeams:                 s.Web.Credentials.Github.Teams,
+		JanusAdminTeam:              s.Web.Credentials.JanusAdminTeam,
+		TracingServiceName:          s.Tracing.ServiceName,
+		TracingSamplingStrategy:     s.Tracing.SamplingStrategy,
+		TracingSamplingParam:        s.Tracing.SamplingParam,
+		TracingIsPublicEndpoint:     s.Tracing.IsPublicEndpoint,
+	}
+}
