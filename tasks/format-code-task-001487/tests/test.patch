diff --git a/tests/components/myuplink/test_number.py b/tests/components/myuplink/test_number.py
index ef7b1749782..83de42ad888 100644
--- a/tests/components/myuplink/test_number.py
+++ b/tests/components/myuplink/test_number.py
@@ -96,3 +96,68 @@ async def test_number_states(
     """Test number entity state."""
 
     await snapshot_platform(hass, entity_registry, snapshot, mock_config_entry.entry_id)
+
+
+async def test_native_step_with_scale_value(
+    hass: HomeAssistant,
+    mock_myuplink_client: MagicMock,
+    setup_platform: None,
+) -> None:
+    """Test that native step is stepValue * scaleValue.
+
+    Regression test for issue where step size for room sensor set point
+    was using stepValue without applying scaleValue. For NIBE F2040 the
+    raw stepValue is 5.0 with scaleValue 0.1 → effective step 0.5.
+
+    In the f730 fixture, parameter 40940 (Degree minutes) has
+    stepValue=1, scaleValue="0.1" so the user-visible step must be 0.1.
+    """
+    state = hass.states.get("number.gotham_city_degree_minutes")
+    assert state is not None
+    assert state.attributes["step"] == pytest.approx(0.1)
+
+
+async def test_native_step_with_unit_scale(
+    hass: HomeAssistant,
+    mock_myuplink_client: MagicMock,
+    setup_platform: None,
+) -> None:
+    """Test that native step matches stepValue when scaleValue is 1.
+
+    In the f730 fixture, parameter 148072 (start diff additional heat)
+    has stepValue=10, scaleValue="1" → step must be 10.0.
+    """
+    state = hass.states.get("number.gotham_city_start_diff_additional_heat")
+    assert state is not None
+    assert state.attributes["step"] == pytest.approx(10.0)
+
+
+async def test_min_max_preserved(
+    hass: HomeAssistant,
+    mock_myuplink_client: MagicMock,
+    setup_platform: None,
+) -> None:
+    """Test min/max values are preserved.
+
+    Parameter 148072: minValue=100, maxValue=2000, scaleValue="1".
+    """
+    state = hass.states.get("number.gotham_city_start_diff_additional_heat")
+    assert state is not None
+    assert state.attributes["min"] == pytest.approx(100.0)
+    assert state.attributes["max"] == pytest.approx(2000.0)
+
+
+async def test_heating_offset_step(
+    hass: HomeAssistant,
+    mock_myuplink_client: MagicMock,
+    setup_platform: None,
+) -> None:
+    """Test heating offset entity (47011) step value.
+
+    Parameter 47011: stepValue=1, scaleValue="1" → step=1.0.
+    """
+    state = hass.states.get("number.gotham_city_heating_offset_climate_system_1")
+    assert state is not None
+    assert state.attributes["step"] == pytest.approx(1.0)
+    assert state.attributes["min"] == pytest.approx(-10.0)
+    assert state.attributes["max"] == pytest.approx(10.0)
