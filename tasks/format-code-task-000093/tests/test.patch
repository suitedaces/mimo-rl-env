diff --git a/pygmt/tests/test_show_versions.py b/pygmt/tests/test_show_versions.py
index f9b6d9926..2ce71f3f4 100644
--- a/pygmt/tests/test_show_versions.py
+++ b/pygmt/tests/test_show_versions.py
@@ -3,10 +3,12 @@ Test the pygmt.show_versions function.
 """
 
 import io
+import re
 from unittest.mock import patch
 
 import pygmt
 import pytest
+from pygmt._show_versions import _get_gdal_version
 
 
 def test_show_versions():
@@ -69,3 +71,73 @@ def test_show_versions_ghostscript_not_found():
         pygmt.show_versions(file=buf)
         assert "ghostscript: None" in buf.getvalue()
         assert "WARNING:" in buf.getvalue()
+
+
+def test_get_gdal_version_returns_clean_version_string():
+    """
+    Check that _get_gdal_version returns a clean version string like '3.10.3' (not a
+    verbose string with extra text such as 'GDAL 3.10.3, released ...') when the GDAL
+    C library is available on the system.
+    """
+    gdal_version = _get_gdal_version()
+    assert gdal_version is not None, (
+        "Expected _get_gdal_version() to detect GDAL via the C library, got None"
+    )
+
+    assert re.match(r"^\d+\.\d+", gdal_version), (
+        f"_get_gdal_version() returned non-version-like string: {gdal_version!r}"
+    )
+
+
+def test_show_versions_reports_gdal_version():
+    """
+    Check that pygmt.show_versions reports an actual GDAL version (not None) when the
+    GDAL C library is installed, even if the GDAL Python bindings are not installed.
+    This is the core regression covered by the bug fix.
+    """
+    buf = io.StringIO()
+    pygmt.show_versions(file=buf)
+    output = buf.getvalue()
+
+
+    match = re.search(r"^\s*gdal:\s*(.+)$", output, flags=re.MULTILINE)
+    assert match is not None, f"No 'gdal:' line found in output:\n{output}"
+    gdal_value = match.group(1).strip()
+    assert gdal_value != "None", (
+        "pygmt.show_versions reported gdal: None even though the GDAL C library "
+        "is available on the system."
+    )
+
+    assert re.match(r"^\d+\.\d+", gdal_value), (
+        f"Expected a version-like string for gdal, got: {gdal_value!r}"
+    )
+
+
+def test_show_versions_gdal_in_dependency_section():
+    """
+    Check that the 'gdal:' line appears in the Dependency information section of the
+    output (i.e., between the 'Dependency information:' header and the 'GMT library
+    information:' header).
+    """
+    buf = io.StringIO()
+    pygmt.show_versions(file=buf)
+    output = buf.getvalue()
+
+    dep_idx = output.index("Dependency information:")
+    gmt_idx = output.index("GMT library information:")
+    section = output[dep_idx:gmt_idx]
+    assert "gdal:" in section, (
+        f"'gdal:' not found in the Dependency information section:\n{section}"
+    )
+
+
+def test_show_versions_gdal_none_when_unavailable():
+    """
+    Check that pygmt.show_versions reports 'gdal: None' (without raising) when GDAL
+    cannot be detected.
+    """
+    with patch("pygmt._show_versions._get_gdal_version", return_value=None):
+        buf = io.StringIO()
+        pygmt.show_versions(file=buf)
+        output = buf.getvalue()
+        assert "gdal: None" in output
