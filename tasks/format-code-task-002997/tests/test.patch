+canonical_graph_file() {
+  python3 - "$1" <<'PY'
+import json
+import sys
+
+path = sys.argv[1]
+text = open(path, encoding="utf-8").read()
+stripped = text.strip()
+if stripped in ("", "[]"):
+    print("[]")
+    raise SystemExit(0)
+
+entries = []
+cur = None
+in_import = False
+
+def finish():
+    if cur is not None:
+        entries.append(cur)
+
+for raw in text.splitlines():
+    line = raw.rstrip()
+    if not line:
+        continue
+    if line.startswith("- image:"):
+        finish()
+        image = line[len("- image:"):].strip()
+        if not image:
+            raise SystemExit(f"{path}: empty image name")
+        cur = {"image": image}
+        in_import = False
+    elif cur is None:
+        raise SystemExit(f"{path}: graph output must start with an image entry, got {line!r}")
+    elif line == "  dependsOn:":
+        cur.setdefault("dependsOn", {})
+        in_import = False
+    elif line.startswith("    from:"):
+        cur.setdefault("dependsOn", {})["from"] = line[len("    from:"):].strip()
+        in_import = False
+    elif line == "    import:":
+        cur.setdefault("dependsOn", {})["import"] = []
+        in_import = True
+    elif in_import and line.startswith("    - "):
+        cur.setdefault("dependsOn", {}).setdefault("import", []).append(line[len("    - "):].strip())
+    else:
+        raise SystemExit(f"{path}: unexpected graph line {line!r}")
+
+finish()
+print(json.dumps(sorted(entries, key=lambda item: item["image"]), sort_keys=True, separators=(",", ":")))
+PY
+}
+
+assert_graph_set() {
+  local actual_file="$1"
+  local expected_file="$2"
+  local label="$3"
+  local actual expected
+
+  actual="$(canonical_graph_file "$actual_file")"
+  expected="$(canonical_graph_file "$expected_file")"
+  [ "$actual" = "$expected" ] || fail "$label: got canonical graph [$actual], want [$expected]"
+}
