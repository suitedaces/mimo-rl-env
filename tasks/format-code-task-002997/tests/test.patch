+make_project_all_final() {
+  local dir="$1"
+  mkdir -p "$dir" || fail "create project"
+  (
+    cd "$dir" || exit 1
+    git init -q
+    git config user.email test@example.com
+    git config user.name Test
+    cat > werf.yaml <<'EOF'
+project: graph-test
+configVersion: 1
+---
+image: app1
+fromImage: baseImage
+---
+image: app2
+fromImage: baseImage
+import:
+- image: app1
+  add: /app1
+  to: /app1
+  after: install
+---
+image: baseImage
+from: alpine:3.20
+EOF
+    git add werf.yaml
+    git commit -q -m init
+  ) || fail "initialize all-final project"
+}
+
+make_project_with_intermediate_base() {
+  local dir="$1"
+  mkdir -p "$dir" || fail "create project"
+  (
+    cd "$dir" || exit 1
+    git init -q
+    git config user.email test@example.com
+    git config user.name Test
