+project: graph-test
+configVersion: 1
+---
+image: app1
+fromImage: baseImage
+---
+image: app2
+fromImage: baseImage
+import:
+- image: app1
+  add: /app1
+  to: /app1
+  after: install
+---
+image: baseImage
+final: false
+from: alpine:3.20
+EOF
+    git add werf.yaml
+    git commit -q -m init
+  ) || fail "initialize intermediate-base project"
+}
