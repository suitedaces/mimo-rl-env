+run_graph() {
+  local project_dir="$1"
+  shift
+  mkdir -p "$TMP/werf-home" "$TMP/werf-tmp" || fail "create werf runtime dirs"
+  "$BIN" \
+    --dir "$project_dir" \
+    --home-dir "$TMP/werf-home" \
+    --tmp-dir "$TMP/werf-tmp" \
+    --log-color-mode=off \
+    config graph "$@"
+}
+
+PROJECT_ALL_FINAL="$TMP/project-all-final"
+PROJECT_INTERMEDIATE="$TMP/project-intermediate"
+make_project_all_final "$PROJECT_ALL_FINAL"
+make_project_with_intermediate_base "$PROJECT_INTERMEDIATE"
+
+
+
+
+"$BIN" config graph --help >"$TMP/help.out" 2>"$TMP/help.err"; ec=$?
+[ "$ec" -eq 0 ] || fail "F_help exit $ec; want 0"
+
+tr '[:upper:]' '[:lower:]' <"$TMP/help.out" >"$TMP/help.lower"
+grep -Eq "dependency graph.*werf\\.yaml|werf\\.yaml.*dependency graph" "$TMP/help.lower" || fail "F_help missing dependency graph description for werf.yaml"
+grep -Fxq "  werf config graph [IMAGE_NAME...] [options]" "$TMP/help.out" || fail "F_help missing usage syntax"
+
+[ ! -s "$TMP/help.err" ] || fail "F_help unexpected stderr: $(cat "$TMP/help.err")"
+
+
+
+
+run_graph "$PROJECT_ALL_FINAL" >"$TMP/all.out" 2>"$TMP/all.err"; ec=$?
+cat >"$TMP/all.expected" <<'EOF'
+- image: app1
+  dependsOn:
+    from: baseImage
+- image: app2
+  dependsOn:
+    from: baseImage
+    import:
+    - app1
+- image: baseImage
+EOF
+[ "$ec" -eq 0 ] || fail "F_all exit $ec; want 0"
+assert_graph_set "$TMP/all.out" "$TMP/all.expected" "F_all stdout"
+[ ! -s "$TMP/all.err" ] || fail "F_all unexpected stderr: $(cat "$TMP/all.err")"
+
+
+
+
+run_graph "$PROJECT_ALL_FINAL" app2 >"$TMP/app2.out" 2>"$TMP/app2.err"; ec=$?
+APP2_EXPECTED='- image: app2
+  dependsOn:
+    from: baseImage
+    import:
+    - app1'
+[ "$ec" -eq 0 ] || fail "F_one exit $ec; want 0"
+printf '%s\n' "$APP2_EXPECTED" >"$TMP/app2.expected"
+assert_graph_set "$TMP/app2.out" "$TMP/app2.expected" "F_one stdout"
+[ ! -s "$TMP/app2.err" ] || fail "F_one unexpected stderr: $(cat "$TMP/app2.err")"
+
+
+
+
+run_graph "$PROJECT_ALL_FINAL" app2 baseImage >"$TMP/many.out" 2>"$TMP/many.err"; ec=$?
+cat >"$TMP/many.expected" <<'EOF'
+- image: app2
+  dependsOn:
+    from: baseImage
+    import:
+    - app1
+- image: baseImage
+EOF
+[ "$ec" -eq 0 ] || fail "F_many exit $ec; want 0"
+assert_graph_set "$TMP/many.out" "$TMP/many.expected" "F_many stdout"
+[ ! -s "$TMP/many.err" ] || fail "F_many unexpected stderr: $(cat "$TMP/many.err")"
+
+
+
+
+run_graph "$PROJECT_INTERMEDIATE" --final-images-only >"$TMP/final.out" 2>"$TMP/final.err"; ec=$?
+cat >"$TMP/final.expected" <<'EOF'
+- image: app1
+  dependsOn:
+    from: baseImage
+- image: app2
+  dependsOn:
+    from: baseImage
+    import:
+    - app1
+EOF
+[ "$ec" -eq 0 ] || fail "F_final exit $ec; want 0"
+assert_graph_set "$TMP/final.out" "$TMP/final.expected" "F_final stdout"
+[ ! -s "$TMP/final.err" ] || fail "F_final unexpected stderr: $(cat "$TMP/final.err")"
+
+
+
+
+run_graph "$PROJECT_INTERMEDIATE" baseImage --final-images-only >"$TMP/final-empty.out" 2>"$TMP/final-empty.err"; ec=$?
+[ "$ec" -eq 0 ] || fail "F_final_empty exit $ec; want 0"
+
+[ "$(canonical_graph_file "$TMP/final-empty.out")" = "[]" ] || fail "F_final_empty stdout: $(cat "$TMP/final-empty.out")"
+[ ! -s "$TMP/final-empty.err" ] || fail "F_final_empty unexpected stderr: $(cat "$TMP/final-empty.err")"
+
+
+
+
+run_graph "$PROJECT_ALL_FINAL" missing-image >"$TMP/missing.out" 2>"$TMP/missing.err"; ec=$?
+[ "$ec" -ne 0 ] || fail "F_missing exit 0; want non-zero"
+[ ! -s "$TMP/missing.out" ] || fail "F_missing unexpected stdout: $(cat "$TMP/missing.out")"
+
+[ -s "$TMP/missing.err" ] || fail "F_missing expected selection error on stderr"
+grep -Fq "missing-image" "$TMP/missing.err" || fail "F_missing stderr should mention selector: $(cat "$TMP/missing.err")"
+
+echo "PASS"
+exit 0
