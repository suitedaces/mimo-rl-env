+def test_cv_brier_score_hasattr_false_for_svc_binary(binary_classification_data_svc):
+    """SVC has no `predict_proba`, so the `brier_score` method must NOT be
+    exposed on a CrossValidationReport's metrics either. This is the
+    user-observable contract of the fix applied in the cross-validation
+    metrics accessor.
+    """
+    estimator, X, y = binary_classification_data_svc
+    report = CrossValidationReport(estimator, X, y, cv_splitter=2)
+    assert hasattr(report.metrics, "brier_score") is False
+
+
+def test_cv_brier_score_raises_attribute_error_for_svc_binary(
+    binary_classification_data_svc,
+):
+    """Calling brier_score() on an SVC-backed CrossValidationReport must
+    raise AttributeError.
+    """
+    estimator, X, y = binary_classification_data_svc
+    report = CrossValidationReport(estimator, X, y, cv_splitter=2)
+    with pytest.raises(AttributeError):
+        report.metrics.brier_score()
+
+
+def test_cv_brier_score_hasattr_true_for_logreg_binary(binary_classification_data):
+    """Preservation: when the estimator supports `predict_proba`, the
+    `brier_score` method must still be available on CV reports.
+    """
+
+    estimator = LogisticRegression()
+    _, X, y = binary_classification_data
+    report = CrossValidationReport(estimator, X, y, cv_splitter=2)
+    assert hasattr(report.metrics, "brier_score") is True
