diff --git a/packages/utils/time.test.ts b/packages/utils/time.test.ts
index 19748fe8c..fc6aa6b6a 100644
--- a/packages/utils/time.test.ts
+++ b/packages/utils/time.test.ts
@@ -1,12 +1,63 @@
-import { formatMsToDurationLocal, Hour, Minute } from './time';
+import * as time from './time';
+import { Hour, Minute, Second } from './time';
+
+
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+const formatDuration: (ms: number) => string = ((time as any).formatMsToDurationCompat ?? (time as any).formatMsToDurationLocal);
+
+describe('formatMsToDuration', () => {
+	test('the duration-formatter is exported under one of the expected names', () => {
+		expect(typeof formatDuration).toBe('function');
+	});
 
-describe('time', () => {
 	test.each([
 		[0, '0:00'],
+		[Second * 1, '0:01'],
+		[Second * 59, '0:59'],
+		[Second * 60, '1:00'],
 		[Minute * 3, '3:00'],
-		[Hour * 4 + Minute * 3, '4:03:00'],
-		[Hour * 25, '0000-00-01T01:00'],
-	])('should support formatting durations', (input, expected) => {
-		expect(formatMsToDurationLocal(input)).toBe(expected);
+		[Minute + Second * 30, '1:30'],
+		[Minute * 9 + Second * 5, '9:05'],
+		[Minute * 59 + Second * 59, '59:59'],
+	])('formats sub-hour duration %d ms as "%s"', (input, expected) => {
+
+		expect(formatDuration(input)).toBe(expected);
+	});
+
+	test('seconds are zero-padded but minutes are not (sub-hour)', () => {
+		expect(formatDuration(Second * 5)).toBe('0:05');
+		expect(formatDuration(Minute * 9 + Second * 5)).toBe('9:05');
+	});
+
+	test('hour-or-greater durations return a non-empty digit-containing string', () => {
+
+
+
+
+		const result = formatDuration(Hour + Minute * 5 + Second * 30);
+		expect(typeof result).toBe('string');
+		expect(result.length).toBeGreaterThan(0);
+		expect(result).toMatch(/\d/);
+	});
+
+	test('does not crash when the dayjs duration plugin is unavailable (the iOS bug)', () => {
+
+
+
+		// eslint-disable-next-line @typescript-eslint/no-require-imports
+		const dayjs = require('dayjs');
+		const originalDuration = dayjs.duration;
+		try {
+
+			dayjs.duration = undefined;
+			expect(() => formatDuration(Minute * 5)).not.toThrow();
+
+			expect(formatDuration(Minute * 5)).toBe('5:00');
+			expect(() => formatDuration(Second * 30)).not.toThrow();
+			expect(formatDuration(Second * 30)).toBe('0:30');
+		} finally {
+			dayjs.duration = originalDuration;
+		}
 	});
 });
