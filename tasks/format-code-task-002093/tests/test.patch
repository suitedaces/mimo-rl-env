diff --git a/packages/cli/test/cli.test.js b/packages/cli/test/cli.test.js
new file mode 100644
index 00000000..cc4b19d9
--- /dev/null
+++ b/packages/cli/test/cli.test.js
@@ -0,0 +1,132 @@
+'use strict';
+
+
+
+
+
+
+const test = require('ava');
+const fs = require('fs');
+const path = require('path');
+
+const cli = require('..');
+const ohmCli = cli.ohmCli;
+
+const TESTDATA = path.join(__dirname, 'testdata');
+
+
+const noExit = {noProcessExit: true};
+
+function run(args, options) {
+  return ohmCli(args, Object.assign({}, noExit, options));
+}
+
+function sortedKeys(plan) {
+  return Object.keys(plan.filesToWrite).sort();
+}
+
+test('package exposes ohmCli', t => {
+  t.is(typeof ohmCli, 'function');
+});
+
+test('dry-run lists recipe files for matched .ohm files', t => {
+  const plan = run(['generateRecipes', '**/*.ohm', '--dryRun'], {cwd: TESTDATA});
+  t.deepEqual(sortedKeys(plan), [
+    'arithmetic.ohm-recipe.js',
+    'e/f/g.ohm-recipe.js'
+  ]);
+});
+
+test('-n is an alias for --dryRun', t => {
+  const plan = run(['generateRecipes', '**/*.ohm', '-n'], {cwd: TESTDATA});
+  t.deepEqual(sortedKeys(plan), [
+    'arithmetic.ohm-recipe.js',
+    'e/f/g.ohm-recipe.js'
+  ]);
+});
+
+test('non-.ohm files that match a pattern are ignored', t => {
+
+  const plan = run(['generateRecipes', '**/*', '-n'], {cwd: TESTDATA});
+  t.deepEqual(sortedKeys(plan), [
+    'arithmetic.ohm-recipe.js',
+    'e/f/g.ohm-recipe.js'
+  ]);
+});
+
+test('a narrower pattern only matches the intended files', t => {
+  const plan = run(['generateRecipes', '*.ohm', '-n'], {cwd: TESTDATA});
+  t.deepEqual(sortedKeys(plan), ['arithmetic.ohm-recipe.js']);
+});
+
+test('recipe contents are a usable standalone module', t => {
+  const plan = run(['generateRecipes', 'arithmetic.ohm', '-n'], {cwd: TESTDATA});
+  const contents = plan.filesToWrite['arithmetic.ohm-recipe.js'];
+  t.is(typeof contents, 'string');
+
+
+  const dir = fs.mkdtempSync(path.join(__dirname, 'tmp-'));
+  t.teardown(() => fs.rmSync(dir, {recursive: true, force: true}));
+  const file = path.join(dir, 'recipe.js');
+  fs.writeFileSync(file, contents);
+
+  const grammar = require(file);
+  t.is(grammar.name, 'Arithmetic');
+  t.true(grammar.match('1+2*3').succeeded());
+  t.false(grammar.match('1+').succeeded());
+});
+
+test('non dry-run writes files to disk under the base directory', t => {
+  const dir = fs.mkdtempSync(path.join(__dirname, 'tmp-'));
+  t.teardown(() => fs.rmSync(dir, {recursive: true, force: true}));
+  fs.writeFileSync(path.join(dir, 'g.ohm'), 'G { start = letter+ }');
+
+  const plan = run(['generateRecipes', '*.ohm'], {cwd: dir});
+  t.deepEqual(Object.keys(plan.filesToWrite), ['g.ohm-recipe.js']);
+
+  const outPath = path.join(dir, 'g.ohm-recipe.js');
+  t.true(fs.existsSync(outPath));
+  t.is(fs.readFileSync(outPath, 'utf-8'), plan.filesToWrite['g.ohm-recipe.js']);
+
+  const grammar = require(outPath);
+  t.is(grammar.name, 'G');
+  t.true(grammar.match('abc').succeeded());
+});
+
+test('nested output path mirrors the source path', t => {
+  const dir = fs.mkdtempSync(path.join(__dirname, 'tmp-'));
+  t.teardown(() => fs.rmSync(dir, {recursive: true, force: true}));
+  fs.mkdirSync(path.join(dir, 'a', 'b'), {recursive: true});
+  fs.writeFileSync(path.join(dir, 'a', 'b', 'g.ohm'), 'G { start = letter+ }');
+
+  const plan = run(['generateRecipes', '**/*.ohm'], {cwd: dir});
+  t.deepEqual(Object.keys(plan.filesToWrite), ['a/b/g.ohm-recipe.js']);
+  t.true(fs.existsSync(path.join(dir, 'a', 'b', 'g.ohm-recipe.js')));
+});
+
+test('dry-run writes nothing to disk', t => {
+  const dir = fs.mkdtempSync(path.join(__dirname, 'tmp-'));
+  t.teardown(() => fs.rmSync(dir, {recursive: true, force: true}));
+  fs.writeFileSync(path.join(dir, 'g.ohm'), 'G { start = letter+ }');
+
+  const plan = run(['generateRecipes', '*.ohm', '--dryRun'], {cwd: dir});
+  t.deepEqual(Object.keys(plan.filesToWrite), ['g.ohm-recipe.js']);
+  t.false(fs.existsSync(path.join(dir, 'g.ohm-recipe.js')));
+});
+
+test('missing required pattern argument is a usage error', t => {
+  const err = t.throws(() => run(['generateRecipes'], {cwd: TESTDATA}));
+  t.regex(err.message, /patterns/);
+});
+
+test('unknown option is a usage error', t => {
+  const err = t.throws(() =>
+    run(['generateRecipes', '*.ohm', '-z'], {cwd: TESTDATA})
+  );
+  t.regex(err.message, /-z/);
+});
+
+test('unknown command is a usage error', t => {
+  const err = t.throws(() => run(['blah'], {cwd: TESTDATA}));
+  t.regex(err.message, /blah/);
+});
diff --git a/packages/cli/test/testdata/arithmetic.ohm b/packages/cli/test/testdata/arithmetic.ohm
new file mode 100644
index 00000000..bbb2e7fe
--- /dev/null
+++ b/packages/cli/test/testdata/arithmetic.ohm
@@ -0,0 +1,21 @@
+Arithmetic {
+  Exp
+    = AddExp
+
+  AddExp
+    = AddExp "+" MulExp  -- plus
+    | AddExp "-" MulExp  -- minus
+    | MulExp
+
+  MulExp
+    = MulExp "*" PriExp  -- times
+    | MulExp "/" PriExp  -- divide
+    | PriExp
+
+  PriExp
+    = "(" Exp ")"  -- paren
+    | number
+
+  number
+    = digit+
+}
