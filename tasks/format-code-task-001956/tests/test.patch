+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+CMF_CONFIG="$(mktemp /tmp/cmf-jest.XXXXXX.js)"
+trap 'rm -f "$CMF_CONFIG"' EXIT
+cat > "$CMF_CONFIG" <<'EOF'
+const swc = require.resolve('@swc/jest', { paths: ['/testbed/node_modules'] });
+module.exports = {
+  rootDir: '/testbed/packages/create-module-federation',
+  testEnvironment: 'node',
+  transform: { '^.+\\.(t|j)sx?$': [swc, { jsc: { parser: { syntax: 'typescript' } } }] },
+  testMatch: ['<rootDir>/__tests__/**/*.spec.ts'],
+  moduleFileExtensions: ['ts', 'tsx', 'js', 'jsx', 'json'],
+};
+EOF
+
+
+npx jest --config packages/sdk/jest.config.js
+
+
+npx jest --config "$CMF_CONFIG"
