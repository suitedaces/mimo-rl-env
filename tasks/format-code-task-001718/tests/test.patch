+func hasPodSecurityPolicyError(errs field.ErrorList) bool {
+	for _, e := range errs {
+		msg := strings.ToLower(e.Error())
+		if strings.Contains(msg, "podsecuritypolicy") || strings.Contains(msg, "pod security policy") {
+			return true
+		}
+	}
+	return false
+}
+
+func TestValidateClusterSpecPodSecurityPolicy(t *testing.T) {
+	versionManager := version.New([]*version.Version{
+		{Version: semverlib.MustParse("1.24.0")},
+		{Version: semverlib.MustParse("1.24.99")},
+		{Version: semverlib.MustParse("1.25.0")},
+		{Version: semverlib.MustParse("1.26.0")},
+	}, nil, nil)
+
+	tests := []struct {
+		name      string
+		spec      *kubermaticv1.ClusterSpec
+		expectPSP bool
+	}{
+		{
+			name: "PSP via UsePodSecurityPolicyAdmissionPlugin on v1.25 should error",
+			spec: &kubermaticv1.ClusterSpec{
+				Version:                             *semver.NewSemverOrDie("1.25.0"),
+				UsePodSecurityPolicyAdmissionPlugin: true,
+			},
+			expectPSP: true,
+		},
+		{
+			name: "PSP via UsePodSecurityPolicyAdmissionPlugin on v1.26 should error",
+			spec: &kubermaticv1.ClusterSpec{
+				Version:                             *semver.NewSemverOrDie("1.26.0"),
+				UsePodSecurityPolicyAdmissionPlugin: true,
+			},
+			expectPSP: true,
+		},
+		{
+			name: "PSP via UsePodSecurityPolicyAdmissionPlugin on v1.24 should NOT error",
+			spec: &kubermaticv1.ClusterSpec{
+				Version:                             *semver.NewSemverOrDie("1.24.0"),
+				UsePodSecurityPolicyAdmissionPlugin: true,
+			},
+			expectPSP: false,
+		},
+		{
+			name: "PSP via UsePodSecurityPolicyAdmissionPlugin on boundary v1.24.99 should NOT error",
+			spec: &kubermaticv1.ClusterSpec{
+				Version:                             *semver.NewSemverOrDie("1.24.99"),
+				UsePodSecurityPolicyAdmissionPlugin: true,
+			},
+			expectPSP: false,
+		},
+		{
+			name: "no PSP enabled on v1.25 should NOT error",
+			spec: &kubermaticv1.ClusterSpec{
+				Version:                             *semver.NewSemverOrDie("1.25.0"),
+				UsePodSecurityPolicyAdmissionPlugin: false,
+			},
+			expectPSP: false,
+		},
+		{
+			name: "PSP via AdmissionPlugins list on v1.25 should error",
+			spec: &kubermaticv1.ClusterSpec{
+				Version:          *semver.NewSemverOrDie("1.25.0"),
+				AdmissionPlugins: []string{"PodSecurityPolicy"},
+			},
+			expectPSP: true,
+		},
+		{
+			name: "PSP via AdmissionPlugins list on v1.24 should NOT error",
+			spec: &kubermaticv1.ClusterSpec{
+				Version:          *semver.NewSemverOrDie("1.24.0"),
+				AdmissionPlugins: []string{"PodSecurityPolicy"},
+			},
+			expectPSP: false,
+		},
+		{
+			name: "non-PSP admission plugin on v1.25 should NOT error",
+			spec: &kubermaticv1.ClusterSpec{
+				Version:          *semver.NewSemverOrDie("1.25.0"),
+				AdmissionPlugins: []string{"EventRateLimit"},
+			},
+			expectPSP: false,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			errs := ValidateClusterSpec(test.spec, dc, features.FeatureGate{}, versionManager, nil)
+			got := hasPodSecurityPolicyError(errs)
+			if got != test.expectPSP {
+				t.Errorf("expected PSP error=%v, got=%v; full errors: %v", test.expectPSP, got, errs.ToAggregate())
+			}
+		})
+	}
+}
