+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+pip install 'scrapy==2.7.1' phonenumbers pytest 2>/dev/null
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest \
+      tests/test_country_utils.py \
+      tests/test_dict_parser.py \
+      tests/test_geo.py \
+      tests/test_google_url.py \
+      tests/test_ld_parser.py \
+      tests/test_og_parser.py \
+      tests/test_opening_hours.py \
+      tests/test_pipeline_assert_url_scheme.py \
+      tests/test_pipeline_country_code_cleanup.py \
+      tests/test_pipeline_extract_gb_postcode.py -q
+    ;;
+  new)
+    python3 -m pytest tests/test_phone_international_behavior.py -q
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
