+package clientgo
+
+import (
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+type contractRecordingRoundTripper struct {
+	seen *url.URL
+}
+
+func (r *contractRecordingRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	r.seen = req.URL
+	return &http.Response{
+		StatusCode: http.StatusNoContent,
+		Body:       io.NopCloser(strings.NewReader("")),
+		Header:     make(http.Header),
+		Request:    req,
+	}, nil
+}
+
+func TestRoundTripPathNormalizationContract(t *testing.T) {
+	tests := []struct {
+		name string
+		host string
+		path string
+		want string
+	}{
+		{
+			name: "core API with query",
+			host: "https://hub.example/proxy",
+			path: "https://hub.example/proxy/api/v1/namespaces/demo/pods?watch=true&resourceVersion=7",
+			want: "/proxy/apis/shadow/v1alpha1/namespaces/demo/pods?watch=true&resourceVersion=7",
+		},
+		{
+			name: "API root preserves trailing slash",
+			host: "https://hub.example/proxy",
+			path: "https://hub.example/proxy/api/v1/",
+			want: "/proxy/apis/shadow/v1alpha1/",
+		},
+		{
+			name: "group API with hyphenated non clusternet group",
+			host: "https://hub.example/proxy",
+			path: "https://hub.example/proxy/apis/apps.example/v1beta1/deployments",
+			want: "/proxy/apis/shadow/v1alpha1/deployments",
+		},
+		{
+			name: "clusternet group remains untouched",
+			host: "https://hub.example/proxy",
+			path: "https://hub.example/proxy/apis/foo-bar.clusternet.io/v1alpha1/widgets?x=1",
+			want: "/proxy/apis/foo-bar.clusternet.io/v1alpha1/widgets?x=1",
+		},
+		{
+			name: "invalid version remains untouched",
+			host: "https://hub.example/proxy",
+			path: "https://hub.example/proxy/apis/apps.example/vfuture/deployments",
+			want: "/proxy/apis/apps.example/vfuture/deployments",
+		},
+		{
+			name: "outside configured prefix remains untouched",
+			host: "https://hub.example/proxy",
+			path: "https://hub.example/other/proxy/api/v1/pods",
+			want: "/other/proxy/api/v1/pods",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			recorder := &contractRecordingRoundTripper{}
+			transport := NewClusternetTransport(tt.host, recorder)
+			reqURL, err := url.Parse(tt.path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			req := &http.Request{Method: http.MethodGet, URL: reqURL, Header: make(http.Header)}
+			if _, err := transport.RoundTrip(req); err != nil {
+				t.Fatalf("RoundTrip() error = %v", err)
+			}
+			if recorder.seen == nil {
+				t.Fatal("underlying transport did not receive a request")
+			}
+			wantURL, err := url.Parse("https://hub.example" + tt.want)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := recorder.seen.EscapedPath(); got != wantURL.EscapedPath() || recorder.seen.RawQuery != wantURL.RawQuery {
+				t.Fatalf("normalized URL = %q, want path/query %q", recorder.seen.EscapedPath()+"?"+recorder.seen.RawQuery, tt.want)
+			}
+		})
+	}
+}
+
+func TestRoundTripNormalizesVersionRoots(t *testing.T) {
+	for _, path := range []string{"/api/v1", "/apis/apps.example/v1"} {
+		recorder := &contractRecordingRoundTripper{}
+		transport := NewClusternetTransport("https://hub.example", recorder)
+		reqURL, _ := url.Parse("https://hub.example" + path)
+		if _, err := transport.RoundTrip(&http.Request{Method: http.MethodGet, URL: reqURL}); err != nil {
+			t.Fatal(err)
+		}
+		if got := recorder.seen.Path; got != "/apis/shadow/v1alpha1" {
+			t.Errorf("%s normalized to %q, want /apis/shadow/v1alpha1", path, got)
+		}
+	}
+}
