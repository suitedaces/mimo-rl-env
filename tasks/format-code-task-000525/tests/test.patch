@@ -0,0 +1,289 @@
+from enum import Enum
+
+import pytest
+
+from pyboy import PyBoy
+from pyboy.api.memory_scanner import (
+    DynamicComparisonType,
+    MemoryScanner,
+    ScanMode,
+    StandardComparisonType,
+)
+
+
+ROM = "/workspace/repo/pyboy/default_rom.gb"
+
+
+class UnsupportedStandardComparison(Enum):
+    NOPE = 99
+
+
+class UnsupportedDynamicComparison(Enum):
+    NOPE = 99
+
+
+def make_pyboy():
+    pyboy = PyBoy(ROM, window="null")
+    pyboy.set_emulation_speed(0)
+    return pyboy
+
+
+def test_pyboy_exposes_scanner_and_direct_construction_import():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+
+        assert callable(pyboy.memory_scanner.scan_memory)
+        assert callable(pyboy.memory_scanner.rescan_memory)
+        direct = MemoryScanner(pyboy)
+
+        assert callable(direct.scan_memory)
+        assert callable(direct.rescan_memory)
+
+        pyboy.memory[0xC000:0xC004] = [0, 7, 0, 9]
+        assert pyboy.memory_scanner.scan_memory(0, start_addr=0xC000, end_addr=0xC003) == [49152, 49154]
+        assert direct.scan_memory(None, start_addr=0xC000, end_addr=0xC003) == [49152, 49153, 49154, 49155]
+    finally:
+        pyboy.stop()
+
+
+def test_scan_memory_exact_none_and_inclusive_range():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+        pyboy.memory[0xC000:0xC004] = [0, 7, 0, 9]
+        assert pyboy.memory_scanner.scan_memory(0, start_addr=0xC000, end_addr=0xC003) == [49152, 49154]
+        assert pyboy.memory_scanner.scan_memory(None, start_addr=0xC000, end_addr=0xC003) == [
+            49152,
+            49153,
+            49154,
+            49155,
+        ]
+    finally:
+        pyboy.stop()
+
+
+def test_standard_comparison_types_return_captured_address_sets():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+        pyboy.memory[0xC010:0xC015] = [1, 3, 5, 7, 9]
+        assert pyboy.memory_scanner.scan_memory(
+            5, start_addr=0xC010, end_addr=0xC014, standard_comparison_type=StandardComparisonType.EXACT
+        ) == [49170]
+
+        pyboy.memory[0xC010:0xC015] = [1, 3, 5, 7, 9]
+        assert pyboy.memory_scanner.scan_memory(
+            5, start_addr=0xC010, end_addr=0xC014, standard_comparison_type=StandardComparisonType.LESS_THAN
+        ) == [49168, 49169]
+
+        pyboy.memory[0xC010:0xC015] = [1, 3, 5, 7, 9]
+        assert pyboy.memory_scanner.scan_memory(
+            5, start_addr=0xC010, end_addr=0xC014, standard_comparison_type=StandardComparisonType.GREATER_THAN
+        ) == [49171, 49172]
+
+        pyboy.memory[0xC010:0xC015] = [1, 3, 5, 7, 9]
+        assert pyboy.memory_scanner.scan_memory(
+            5,
+            start_addr=0xC010,
+            end_addr=0xC014,
+            standard_comparison_type=StandardComparisonType.LESS_THAN_OR_EQUAL,
+        ) == [49168, 49169, 49170]
+
+        pyboy.memory[0xC010:0xC015] = [1, 3, 5, 7, 9]
+        assert pyboy.memory_scanner.scan_memory(
+            5,
+            start_addr=0xC010,
+            end_addr=0xC014,
+            standard_comparison_type=StandardComparisonType.GREATER_THAN_OR_EQUAL,
+        ) == [49170, 49171, 49172]
+    finally:
+        pyboy.stop()
+
+
+def test_byte_width_two_combines_adjacent_bytes_and_skips_final_start():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+        pyboy.memory[0xC020:0xC024] = [1, 2, 3, 4]
+        assert pyboy.memory_scanner.scan_memory(
+            None, start_addr=0xC020, end_addr=0xC023, byte_width=2, byteorder="little"
+        ) == [49184, 49185, 49186]
+        assert pyboy.memory_scanner.scan_memory(
+            770, start_addr=0xC020, end_addr=0xC023, byte_width=2, byteorder="little"
+        ) == [49185]
+        assert pyboy.memory_scanner.scan_memory(
+            515, start_addr=0xC020, end_addr=0xC023, byte_width=2, byteorder="big"
+        ) == [49185]
+    finally:
+        pyboy.stop()
+
+
+def test_int_and_bcd_scan_modes_use_distinct_value_interpretations():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+        pyboy.memory[0xC030:0xC033] = [0x42, 0x18, 0x99]
+        assert pyboy.memory_scanner.scan_memory(
+            42, start_addr=0xC030, end_addr=0xC032, value_type=ScanMode.BCD
+        ) == [49200]
+        assert pyboy.memory_scanner.scan_memory(
+            42, start_addr=0xC030, end_addr=0xC032, value_type=ScanMode.INT
+        ) == []
+    finally:
+        pyboy.stop()
+
+
+def test_rescan_dynamic_comparisons_narrow_from_remembered_values():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+        pyboy.memory[0xC040:0xC044] = [5, 5, 7, 9]
+        assert pyboy.memory_scanner.scan_memory(5, start_addr=0xC040, end_addr=0xC043) == [49216, 49217]
+        pyboy.memory[0xC040:0xC044] = [5, 6, 8, 9]
+        assert pyboy.memory_scanner.rescan_memory(None, DynamicComparisonType.UNCHANGED) == [49216]
+        pyboy.memory[0xC040:0xC044] = [6, 6, 8, 9]
+        assert pyboy.memory_scanner.rescan_memory(None, DynamicComparisonType.CHANGED) == [49216]
+
+        pyboy.memory[0xC040:0xC044] = [5, 5, 7, 9]
+        assert pyboy.memory_scanner.scan_memory(5, start_addr=0xC040, end_addr=0xC043) == [49216, 49217]
+        pyboy.memory[0xC040:0xC044] = [5, 6, 8, 9]
+        assert pyboy.memory_scanner.rescan_memory(None, DynamicComparisonType.CHANGED) == [49217]
+
+        pyboy.memory[0xC040:0xC044] = [5, 5, 7, 9]
+        assert pyboy.memory_scanner.scan_memory(5, start_addr=0xC040, end_addr=0xC043) == [49216, 49217]
+        pyboy.memory[0xC040:0xC044] = [6, 5, 8, 9]
+        assert pyboy.memory_scanner.rescan_memory(None, DynamicComparisonType.INCREASED) == [49216]
+
+        pyboy.memory[0xC040:0xC044] = [5, 5, 7, 9]
+        assert pyboy.memory_scanner.scan_memory(5, start_addr=0xC040, end_addr=0xC043) == [49216, 49217]
+        pyboy.memory[0xC040:0xC044] = [4, 5, 8, 9]
+        assert pyboy.memory_scanner.rescan_memory(None, DynamicComparisonType.DECREASED) == [49216]
+
+        pyboy.memory[0xC040:0xC044] = [5, 5, 7, 9]
+        assert pyboy.memory_scanner.scan_memory(5, start_addr=0xC040, end_addr=0xC043) == [49216, 49217]
+        pyboy.memory[0xC040:0xC044] = [6, 5, 8, 9]
+        assert pyboy.memory_scanner.rescan_memory(6, DynamicComparisonType.MATCH) == [49216]
+    finally:
+        pyboy.stop()
+
+
+def test_rescan_updates_remembered_values_for_kept_addresses():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+        pyboy.memory[0xC050:0xC053] = [1, 2, 3]
+        assert pyboy.memory_scanner.scan_memory(None, start_addr=0xC050, end_addr=0xC052) == [49232, 49233, 49234]
+        pyboy.memory[0xC050:0xC053] = [2, 2, 4]
+        assert pyboy.memory_scanner.rescan_memory(None, DynamicComparisonType.INCREASED) == [49232, 49234]
+        pyboy.memory[0xC050:0xC053] = [3, 2, 4]
+        assert pyboy.memory_scanner.rescan_memory(None, DynamicComparisonType.INCREASED) == [49232]
+    finally:
+        pyboy.stop()
+
+
+def test_invalid_comparison_paths_raise_value_error():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+        pyboy.memory[0xC060] = 1
+        pyboy.memory_scanner.scan_memory(None, start_addr=0xC060, end_addr=0xC060)
+
+        with pytest.raises(ValueError):
+            pyboy.memory_scanner.rescan_memory(None, DynamicComparisonType.MATCH)
+
+
+        with pytest.raises(ValueError):
+            pyboy.memory_scanner.scan_memory(
+                1,
+                start_addr=0xC060,
+                end_addr=0xC060,
+                standard_comparison_type=UnsupportedStandardComparison.NOPE,
+        )
+
+        pyboy.memory_scanner.scan_memory(None, start_addr=0xC060, end_addr=0xC060)
+
+        with pytest.raises(ValueError):
+            pyboy.memory_scanner.rescan_memory(None, UnsupportedDynamicComparison.NOPE)
+    finally:
+        pyboy.stop()
+
+
+def test_two_pyboy_instances_keep_independent_scanner_state():
+
+
+
+
+    a = make_pyboy()
+    b = make_pyboy()
+    try:
+        a.memory[0xC070:0xC074] = [1, 1, 2, 2]
+        b.memory[0xC070:0xC074] = [3, 3, 4, 4]
+        assert a.memory_scanner.scan_memory(1, start_addr=0xC070, end_addr=0xC073) == [49264, 49265]
+        assert b.memory_scanner.scan_memory(3, start_addr=0xC070, end_addr=0xC073) == [49264, 49265]
+
+        a.memory[0xC070:0xC074] = [2, 1, 2, 2]
+        assert a.memory_scanner.rescan_memory(None, DynamicComparisonType.CHANGED) == [49264]
+        assert b.memory_scanner.rescan_memory(None, DynamicComparisonType.UNCHANGED) == [49264, 49265]
+    finally:
+        a.stop()
+        b.stop()
+
+
+def test_pyboy_exposed_scanner_is_usable_before_owner_stop():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+        pyboy.memory[0xC000:0xC004] = [0, 7, 0, 9]
+        assert pyboy.memory_scanner.scan_memory(0, start_addr=0xC000, end_addr=0xC003) == [49152, 49154]
+    finally:
+
+        pyboy.stop()
+
+
+def test_repeated_direct_scanner_construction_preserves_stateful_behavior():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+        pyboy.memory[0xC080:0xC0C0] = 0
+        for _ in range(3):
+            scanner = MemoryScanner(pyboy)
+
+            assert scanner.scan_memory(0, start_addr=0xC080, end_addr=0xC0BF) == list(range(0xC080, 0xC0C0))
+            pyboy.memory[0xC080] = 1
+
+            assert scanner.rescan_memory(None, DynamicComparisonType.UNCHANGED) == list(range(0xC081, 0xC0C0))
+            del scanner
+            pyboy.memory[0xC080] = 0
+    finally:
+        pyboy.stop()
