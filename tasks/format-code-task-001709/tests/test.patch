+
+import json
+from argparse import Namespace
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+import pytest
+
+from datamodel_code_generator.__main__ import Exit, main
+
+DATA_PATH: Path = Path(__file__).parent / 'data'
+OPEN_API_DATA_PATH: Path = DATA_PATH / 'openapi'
+
+
+@pytest.fixture(autouse=True)
+def reset_namespace(monkeypatch):
+    namespace_ = Namespace(no_color=False)
+    monkeypatch.setattr('datamodel_code_generator.__main__.namespace', namespace_)
+    monkeypatch.setattr('datamodel_code_generator.arguments.namespace', namespace_)
+
+
+ISSUE_SCHEMA = {
+    "$schema": "http://json-schema.org/draft-07/schema#",
+    "type": "object",
+    "title": "TestSchema",
+    "description": "For the test",
+    "properties": {
+        "numbers": {
+            "type": "array",
+            "description": "A list of numbers",
+            "items": {
+                "type": "string",
+                "pattern": "^\\d{1,15}$",
+                "description": "Just a number",
+                "examples": ["1", "5464446", "684572369854259"],
+            },
+        }
+    },
+    "required": ["numbers"],
+}
+
+
+def _run_issue_example_with_field_constraints():
+    with TemporaryDirectory() as d:
+        inp = Path(d) / 'schema.json'
+        inp.write_text(json.dumps(ISSUE_SCHEMA))
+        out = Path(d) / 'out.py'
+        rc = main(
+            [
+                '--input-file-type', 'jsonschema',
+                '--target-python-version', '3.9',
+                '--field-constraints',
+                '--collapse-root-models',
+                '--input', str(inp),
+                '--output', str(out),
+            ]
+        )
+        assert rc == Exit.OK
+        return out.read_text()
+
+
+def test_issue_example_collapses_to_list_str():
+
+    output = _run_issue_example_with_field_constraints()
+
+    assert 'numbers: List[str]' in output
+    assert 'List[Number]' not in output
+
+
+def test_issue_example_no_intermediate_root_model_class():
+
+    output = _run_issue_example_with_field_constraints()
+
+    assert '__root__' not in output
+
+    assert 'class Number' not in output
+
+
+def test_issue_example_regex_preserved_on_collapsed_field():
+
+    output = _run_issue_example_with_field_constraints()
+    assert "regex='^\\\\d{1,15}$'" in output or "regex=r'^\\d{1,15}$'" in output
+
+
+def test_issue_example_description_preserved_on_outer_field():
+
+    output = _run_issue_example_with_field_constraints()
+    assert "description='A list of numbers'" in output
+
+
+def test_issue_example_inner_extras_not_leaked_to_outer():
+
+
+
+
+
+    output = _run_issue_example_with_field_constraints()
+    assert "'Just a number'" not in output
+    assert "examples=" not in output
+    assert "'5464446'" not in output
+
+
+def test_openapi_filehashes_collapses_with_field_constraints():
+
+
+
+
+
+
+    with TemporaryDirectory() as d:
+        out = Path(d) / 'output.py'
+        rc = main(
+            [
+                '--input', str(OPEN_API_DATA_PATH / 'not_real_string.json'),
+                '--output', str(out),
+                '--collapse-root-models',
+                '--field-constraints',
+            ]
+        )
+        assert rc == Exit.OK
+        output = out.read_text()
+
+
+    assert 'List[FileHash]' not in output
+
+    assert "regex='^[a-fA-F\\\\d]{32}$'" in output
+
+
+
+    assert output.count('max_length=32') >= 2
+    assert output.count('min_length=32') >= 2
+
+
+def test_openapi_filehashes_no_filehash_root_class():
+
+
+
+    with TemporaryDirectory() as d:
+        out = Path(d) / 'output.py'
+        rc = main(
+            [
+                '--input', str(OPEN_API_DATA_PATH / 'not_real_string.json'),
+                '--output', str(out),
+                '--collapse-root-models',
+                '--field-constraints',
+            ]
+        )
+        assert rc == Exit.OK
+        output = out.read_text()
+
+
+
+    assert 'class FileHashes' in output
+    idx = output.index('class FileHashes')
+    block = output[idx:]
+    assert 'List[str]' in block
+    assert 'List[FileHash]' not in block
+
+
+def test_collapse_root_models_without_field_constraints_still_uses_constr():
+
+
+
+
+    with TemporaryDirectory() as d:
+        inp = Path(d) / 'schema.json'
+        inp.write_text(json.dumps(ISSUE_SCHEMA))
+        out = Path(d) / 'out.py'
+        rc = main(
+            [
+                '--input-file-type', 'jsonschema',
+                '--target-python-version', '3.9',
+                '--collapse-root-models',
+                '--input', str(inp),
+                '--output', str(out),
+            ]
+        )
+        assert rc == Exit.OK
+        output = out.read_text()
+
+    assert 'constr(regex=' in output
+    assert 'class Number' not in output
+    assert '__root__' not in output
