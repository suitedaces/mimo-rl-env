@@ -0,0 +1,124 @@
+import re
+
+from django.contrib.auth import get_user_model
+from django.core.urlresolvers import reverse
+from django.test import SimpleTestCase, TestCase
+
+from dynamic_preferences.models import GlobalPreferenceModel
+from dynamic_preferences.preferences import Section
+from dynamic_preferences.registries import global_preferences_registry
+from dynamic_preferences.types import StringPreference
+
+
+REGISTERED_ADMIN_SECTIONS = (
+    {
+        'key': 'admin_verbose_alpha',
+        'label': 'Alpha admin section',
+        'preference_name': 'AdminVerboseAlphaPreference',
+        'default': 'alpha value',
+        'preference_label': 'Alpha admin verbose preference',
+    },
+    {
+        'key': 'admin_verbose_beta',
+        'label': 'Beta admin section',
+        'preference_name': 'AdminVerboseBetaPreference',
+        'default': 'beta value',
+        'preference_label': 'Beta admin verbose preference',
+    },
+)
+UNRESOLVED_SECTION_KEY = 'admin_unresolved_section'
+UNRESOLVED_PREFERENCE_NAME = 'AdminUnresolvedPreference'
+UNRESOLVED_DEFAULT = 'fallback value'
+
+
+@global_preferences_registry.register
+class AdminVerboseAlphaPreference(StringPreference):
+    section = Section(REGISTERED_ADMIN_SECTIONS[0]['key'],
+                      verbose_name=REGISTERED_ADMIN_SECTIONS[0]['label'])
+    name = REGISTERED_ADMIN_SECTIONS[0]['preference_name']
+    default = REGISTERED_ADMIN_SECTIONS[0]['default']
+    verbose_name = REGISTERED_ADMIN_SECTIONS[0]['preference_label']
+
+
+@global_preferences_registry.register
+class AdminVerboseBetaPreference(StringPreference):
+    section = Section(REGISTERED_ADMIN_SECTIONS[1]['key'],
+                      verbose_name=REGISTERED_ADMIN_SECTIONS[1]['label'])
+    name = REGISTERED_ADMIN_SECTIONS[1]['preference_name']
+    default = REGISTERED_ADMIN_SECTIONS[1]['default']
+    verbose_name = REGISTERED_ADMIN_SECTIONS[1]['preference_label']
+
+
+class TestSectionVerboseNameApi(SimpleTestCase):
+    def test_section_str_uses_verbose_name_with_fallbacks(self):
+        examples = (
+            ('billing', 'Billing preferences'),
+            ('notifications', 'Notification preferences'),
+            ('support', 'Support center'),
+        )
+        for section_key, label in examples:
+            self.assertEqual(str(Section(section_key, verbose_name=label)), label)
+        self.assertEqual(str(Section(examples[0][0])), examples[0][0])
+        self.assertEqual(str(Section(None)), '')
+
+
+class TestSectionVerboseNameAdminDisplay(TestCase):
+    def setUp(self):
+        user_model = get_user_model()
+        user_model.objects.create_superuser('admin', 'admin@example.com', 'test')
+        self.client.login(username='admin', password='test')
+        self.registered_rows = []
+        for data in REGISTERED_ADMIN_SECTIONS:
+            row, _ = GlobalPreferenceModel.objects.get_or_create(
+                section=data['key'],
+                name=data['preference_name'],
+                defaults={'raw_value': data['default']})
+            self.registered_rows.append(row)
+        self.unresolved_row, _ = GlobalPreferenceModel.objects.get_or_create(
+            section=UNRESOLVED_SECTION_KEY,
+            name=UNRESOLVED_PREFERENCE_NAME,
+            defaults={'raw_value': UNRESOLVED_DEFAULT})
+
+    def _admin_changelist_html(self):
+        url = reverse('admin:dynamic_preferences_globalpreferencemodel_changelist')
+        response = self.client.get(url)
+        self.assertEqual(response.status_code, 200)
+        return response.content.decode('utf-8')
+
+    def _admin_change_html(self, obj):
+        url = reverse('admin:dynamic_preferences_globalpreferencemodel_change',
+                      args=(obj.pk,))
+        response = self.client.get(url)
+        self.assertEqual(response.status_code, 200)
+        return response.content.decode('utf-8')
+
+    def _fragment(self, html, start_pattern, end_pattern):
+        match = re.search(start_pattern, html)
+        self.assertIsNotNone(match, 'Expected admin page region was not found')
+        start = match.start()
+        end = html.find(end_pattern, start)
+        self.assertNotEqual(end, -1, 'Expected admin page region end was not found')
+        return html[start:end]
+
+    def test_admin_changelist_displays_section_verbose_names(self):
+        html = self._admin_changelist_html()
+        result_table = self._fragment(html, r'<table[^>]+id="result_list"', '</table>')
+
+        for data in REGISTERED_ADMIN_SECTIONS:
+            self.assertIn(data['label'], result_table)
+        self.assertIn(UNRESOLVED_SECTION_KEY, result_table)
+
+    def test_admin_section_filter_displays_verbose_names(self):
+        html = self._admin_changelist_html()
+        filter_sidebar = self._fragment(html, r'id="changelist-filter"', '</div>')
+
+        for data in REGISTERED_ADMIN_SECTIONS:
+            self.assertIn(data['label'], filter_sidebar)
+        self.assertIn(UNRESOLVED_SECTION_KEY, filter_sidebar)
+
+    def test_admin_change_form_displays_section_verbose_name(self):
+        for row, data in zip(self.registered_rows, REGISTERED_ADMIN_SECTIONS):
+            self.assertIn(data['label'], self._admin_change_html(row))
+
+        unresolved_html = self._admin_change_html(self.unresolved_row)
+        self.assertIn(UNRESOLVED_SECTION_KEY, unresolved_html)
