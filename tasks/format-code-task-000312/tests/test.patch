+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export PATH=/root/.venv/bin:$PATH
+
+pip install -e . --quiet
+
+case "${1:-}" in
+  base)
+    python -m pytest tests/test_global_preferences.py tests/test_app/dynamic_preferences_registry.py -v
+    ;;
+  new)
+    python -m pytest tests/test_section_verbose_names.py -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
