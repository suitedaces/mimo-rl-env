new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/encode_gray_test.go
@@ -0,0 +1,410 @@
+
+
+
+
+
+
+package usercase_test_coderl
+
+import (
+	"bytes"
+	"errors"
+	"image"
+	"image/color"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"testing"
+
+	"github.com/pixiv/go-libwebp/webp"
+)
+
+func mustDefaultConfig(t *testing.T) *webp.Config {
+	t.Helper()
+	c, err := webp.ConfigPreset(webp.PresetDefault, 100)
+	if err != nil {
+		t.Fatalf("ConfigPreset(PresetDefault, 100) returned error: %v", err)
+	}
+	return c
+}
+
+func invalidConfig(t *testing.T) *webp.Config {
+	t.Helper()
+	c := mustDefaultConfig(t)
+	c.SetQuality(-1)
+	return c
+}
+
+func oneByTenGradient() *image.Gray {
+	p := image.NewGray(image.Rect(0, 0, 1, 10))
+	for i := 0; i < 10; i++ {
+		p.SetGray(0, i, color.Gray{Y: uint8(float32(i) / 10 * 255)})
+	}
+	return p
+}
+
+func twoByTwoFourValues() *image.Gray {
+	p := image.NewGray(image.Rect(0, 0, 2, 2))
+	copy(p.Pix, []byte{0, 85, 170, 255})
+	return p
+}
+
+func paddedNonZeroRectGray() *image.Gray {
+	return &image.Gray{
+		Pix:    []byte{10, 200, 99, 99, 99, 120, 250, 99, 99, 99},
+		Stride: 5,
+		Rect:   image.Rect(3, 4, 5, 6),
+	}
+}
+
+func encodeGrayBytes(t *testing.T, p *image.Gray, c *webp.Config) []byte {
+	t.Helper()
+	var out bytes.Buffer
+	if err := webp.EncodeGray(&out, p, c); err != nil {
+		t.Fatalf("EncodeGray returned error: %v", err)
+	}
+	return out.Bytes()
+}
+
+func encodeGrayWithProgressBytes(t *testing.T, p *image.Gray, c *webp.Config, hook webp.ProgressHook) []byte {
+	t.Helper()
+	var out bytes.Buffer
+	if err := webp.EncodeGrayWithProgress(&out, p, c, hook); err != nil {
+		t.Fatalf("EncodeGrayWithProgress returned error: %v", err)
+	}
+	return out.Bytes()
+}
+
+func assertWebPDecode(t *testing.T, data []byte, wantWidth int, wantHeight int) *image.RGBA {
+	t.Helper()
+
+	if len(data) == 0 {
+		t.Fatal("encoded byte length = 0, want WebP bytes")
+	}
+	width, height := webp.GetInfo(data)
+	if width != wantWidth {
+		t.Fatalf("GetInfo width = %d, want %d", width, wantWidth)
+	}
+	if height != wantHeight {
+		t.Fatalf("GetInfo height = %d, want %d", height, wantHeight)
+	}
+	features, err := webp.GetFeatures(data)
+	if err != nil {
+		t.Fatalf("GetFeatures returned error: %v", err)
+	}
+
+	if features.Width != wantWidth || features.Height != wantHeight {
+		t.Fatalf("features dimensions = %dx%d, want %dx%d", features.Width, features.Height, wantWidth, wantHeight)
+	}
+	decoded, err := webp.DecodeRGBA(data, &webp.DecoderOptions{})
+	if err != nil {
+		t.Fatalf("DecodeRGBA returned error: %v", err)
+	}
+	if decoded.Rect.Dx() != wantWidth || decoded.Rect.Dy() != wantHeight {
+		t.Fatalf("decoded RGBA bounds = %dx%d, want %dx%d", decoded.Rect.Dx(), decoded.Rect.Dy(), wantWidth, wantHeight)
+	}
+	return decoded
+}
+
+func grayAt(t *testing.T, img *image.RGBA, x int, y int) int {
+	t.Helper()
+	rgba := img.RGBAAt(x+img.Rect.Min.X, y+img.Rect.Min.Y)
+
+	if absInt(int(rgba.R)-int(rgba.G)) > 8 || absInt(int(rgba.R)-int(rgba.B)) > 8 || absInt(int(rgba.G)-int(rgba.B)) > 8 {
+		t.Fatalf("decoded pixel (%d,%d) = %#v, want grayscale RGB channels", x, y, rgba)
+	}
+	if rgba.A < 240 {
+		t.Fatalf("decoded pixel (%d,%d) alpha = %d, want opaque image", x, y, rgba.A)
+	}
+	return (int(rgba.R) + int(rgba.G) + int(rgba.B)) / 3
+}
+
+func absInt(v int) int {
+	if v < 0 {
+		return -v
+	}
+	return v
+}
+
+func assertVerticalGrayGradient(t *testing.T, data []byte, wantWidth int, wantHeight int) {
+	t.Helper()
+	img := assertWebPDecode(t, data, wantWidth, wantHeight)
+	values := make([]int, wantHeight)
+	for y := 0; y < wantHeight; y++ {
+		values[y] = grayAt(t, img, 0, y)
+	}
+
+	if values[0] > 50 || values[len(values)-1] < 200 {
+		t.Fatalf("decoded gradient endpoints = %#v, want dark-to-light gradient", values)
+	}
+	for i := 1; i < len(values); i++ {
+		if values[i]+12 < values[i-1] {
+			t.Fatalf("decoded gradient = %#v, want nondecreasing up to lossy tolerance", values)
+		}
+	}
+}
+
+func assertFourValueGrayImage(t *testing.T, data []byte) {
+	t.Helper()
+	img := assertWebPDecode(t, data, 2, 2)
+	values := []int{
+		grayAt(t, img, 0, 0),
+		grayAt(t, img, 1, 0),
+		grayAt(t, img, 0, 1),
+		grayAt(t, img, 1, 1),
+	}
+
+	if !(values[0] < values[1] && values[1] < values[2] && values[2] < values[3]) {
+		t.Fatalf("decoded gray values = %#v, want increasing values for 0,85,170,255 input", values)
+	}
+	if values[0] > 40 || values[3] < 215 || values[3]-values[0] < 180 {
+		t.Fatalf("decoded gray values = %#v, want dark-to-light contrast", values)
+	}
+}
+
+func assertPaddedGrayImage(t *testing.T, data []byte) {
+	t.Helper()
+	img := assertWebPDecode(t, data, 2, 2)
+	values := []int{
+		grayAt(t, img, 0, 0),
+		grayAt(t, img, 1, 0),
+		grayAt(t, img, 0, 1),
+		grayAt(t, img, 1, 1),
+	}
+
+	if values[0] > 70 || values[1] < 150 || values[2] < 70 || values[2] > 180 || values[3] < 200 {
+		t.Fatalf("decoded padded gray values = %#v, want values matching non-contiguous Gray pixels", values)
+	}
+	if !(values[1] > values[2] && values[2] > values[0] && values[3] > values[2]) {
+		t.Fatalf("decoded padded gray values = %#v, want row/column relationships from source pixels", values)
+	}
+}
+
+func assertNoSuccessfulWebP(t *testing.T, data []byte, wantWidth int, wantHeight int) {
+	t.Helper()
+
+	if len(data) == 0 {
+		return
+	}
+	width, height := webp.GetInfo(data)
+	if width > 0 && height > 0 {
+		if _, err := webp.GetFeatures(data); err == nil {
+			t.Fatalf("writer contains a successful %dx%d WebP image after failure; original input was %dx%d", width, height, wantWidth, wantHeight)
+		}
+	}
+}
+
+func assertValidProgressUpdates(t *testing.T, progress []int) {
+	t.Helper()
+
+	if len(progress) == 0 {
+		t.Fatal("progress updates = nil, want at least one percentage update")
+	}
+	for _, percent := range progress {
+		if percent < 0 || percent > 100 {
+			t.Fatalf("progress update = %d, want percentage between 0 and 100", percent)
+		}
+	}
+}
+
+func referenceInvalidConfigError(t *testing.T) string {
+	t.Helper()
+	var out bytes.Buffer
+	err := webp.EncodeRGBA(&out, image.NewRGBA(image.Rect(0, 0, 1, 1)), invalidConfig(t))
+	if err == nil {
+		t.Fatal("EncodeRGBA invalid config error = nil, want reference invalid configuration error")
+	}
+	assertNoSuccessfulWebP(t, out.Bytes(), 1, 1)
+	return err.Error()
+}
+
+func snapshotDir(t *testing.T, root string) []string {
+	t.Helper()
+	var paths []string
+	err := filepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		if rel != "." {
+			paths = append(paths, rel)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("snapshotDir(%q) returned error: %v", root, err)
+	}
+	sort.Strings(paths)
+	return paths
+}
+
+func TestEncodeGrayOneByTenGradient(t *testing.T) {
+
+
+
+
+	data := encodeGrayBytes(t, oneByTenGradient(), mustDefaultConfig(t))
+	assertVerticalGrayGradient(t, data, 1, 10)
+}
+
+func TestEncodeGrayTwoByTwoFourValues(t *testing.T) {
+
+
+
+
+	data := encodeGrayBytes(t, twoByTwoFourValues(), mustDefaultConfig(t))
+	assertFourValueGrayImage(t, data)
+}
+
+func TestEncodeGrayWithProgressContinues(t *testing.T) {
+
+
+
+
+	var progress []int
+	data := encodeGrayWithProgressBytes(t, twoByTwoFourValues(), mustDefaultConfig(t), func(percent int) bool {
+		progress = append(progress, percent)
+		return true
+	})
+	assertValidProgressUpdates(t, progress)
+	assertFourValueGrayImage(t, data)
+}
+
+func TestEncodeGrayWithProgressAbortReturnsEncodeError(t *testing.T) {
+
+
+
+
+	var out bytes.Buffer
+	var progress []int
+	err := webp.EncodeGrayWithProgress(&out, oneByTenGradient(), mustDefaultConfig(t), func(percent int) bool {
+		progress = append(progress, percent)
+		return false
+	})
+	var encodeErr *webp.EncodeError
+	if !errors.As(err, &encodeErr) {
+		t.Fatalf("error = %T:%v, want *webp.EncodeError", err, err)
+	}
+	if encodeErr.EncodeErrorCode() != webp.EncodeErrorCodeVP8EncErrorUserAbort {
+		t.Fatalf("EncodeErrorCode = %v, want %v", encodeErr.EncodeErrorCode(), webp.EncodeErrorCodeVP8EncErrorUserAbort)
+	}
+	assertValidProgressUpdates(t, progress)
+
+	if len(progress) != 1 {
+		t.Fatalf("progress update count after abort = %d, want 1", len(progress))
+	}
+	assertNoSuccessfulWebP(t, out.Bytes(), 1, 10)
+}
+
+func TestEncodeGrayInvalidConfigFailsBeforeSuccessfulWrite(t *testing.T) {
+
+
+
+
+	var out bytes.Buffer
+	err := webp.EncodeGray(&out, oneByTenGradient(), invalidConfig(t))
+	if err == nil {
+		t.Fatal("EncodeGray invalid config error = nil, want invalid configuration")
+	}
+
+	if want := referenceInvalidConfigError(t); err.Error() != want {
+		t.Fatalf("EncodeGray invalid config error = %q, want EncodeRGBA invalid config behavior %q", err.Error(), want)
+	}
+	assertNoSuccessfulWebP(t, out.Bytes(), 1, 10)
+}
+
+func TestEncodeGrayWithProgressInvalidConfigFailsBeforeSuccessfulWrite(t *testing.T) {
+
+
+
+
+	var out bytes.Buffer
+	var progress []int
+	err := webp.EncodeGrayWithProgress(&out, oneByTenGradient(), invalidConfig(t), func(percent int) bool {
+		progress = append(progress, percent)
+		return true
+	})
+	if err == nil {
+		t.Fatal("EncodeGrayWithProgress invalid config error = nil, want invalid configuration")
+	}
+
+	if want := referenceInvalidConfigError(t); err.Error() != want {
+		t.Fatalf("EncodeGrayWithProgress invalid config error = %q, want EncodeRGBA invalid config behavior %q", err.Error(), want)
+	}
+
+	for _, percent := range progress {
+		if percent < 0 || percent > 100 {
+			t.Fatalf("progress update after invalid config = %d, want percentage between 0 and 100", percent)
+		}
+	}
+	assertNoSuccessfulWebP(t, out.Bytes(), 1, 10)
+}
+
+func TestEncodeGrayReferentialTransparency(t *testing.T) {
+	first := encodeGrayBytes(t, twoByTwoFourValues(), mustDefaultConfig(t))
+	second := encodeGrayBytes(t, twoByTwoFourValues(), mustDefaultConfig(t))
+
+	assertFourValueGrayImage(t, first)
+	assertFourValueGrayImage(t, second)
+}
+
+func TestEncodeGrayDoesNotMutateInput(t *testing.T) {
+	img := paddedNonZeroRectGray()
+	wantPix := append([]byte(nil), img.Pix...)
+	wantStride := img.Stride
+	wantRect := img.Rect
+
+	data := encodeGrayBytes(t, img, mustDefaultConfig(t))
+
+	if !bytes.Equal(img.Pix, wantPix) {
+		t.Fatalf("image Pix after EncodeGray = %#v, want %#v", img.Pix, wantPix)
+	}
+	if img.Stride != wantStride {
+		t.Fatalf("image Stride after EncodeGray = %d, want %d", img.Stride, wantStride)
+	}
+	if img.Rect != wantRect {
+		t.Fatalf("image Rect after EncodeGray = %v, want %v", img.Rect, wantRect)
+	}
+	assertPaddedGrayImage(t, data)
+}
+
+func TestEncodeGrayNoGlobalStateWithNoise(t *testing.T) {
+	baseline := encodeGrayBytes(t, oneByTenGradient(), mustDefaultConfig(t))
+	_ = encodeGrayBytes(t, twoByTwoFourValues(), mustDefaultConfig(t))
+	_ = encodeGrayWithProgressBytes(t, twoByTwoFourValues(), mustDefaultConfig(t), func(int) bool { return true })
+	actual := encodeGrayBytes(t, oneByTenGradient(), mustDefaultConfig(t))
+
+
+	assertVerticalGrayGradient(t, baseline, 1, 10)
+	assertVerticalGrayGradient(t, actual, 1, 10)
+}
+
+func TestEncodeGrayHasNoUndeclaredFileSideEffects(t *testing.T) {
+	tmp := t.TempDir()
+	oldWD, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd returned error: %v", err)
+	}
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatalf("Chdir(%q) returned error: %v", tmp, err)
+	}
+	defer func() {
+		if err := os.Chdir(oldWD); err != nil {
+			t.Fatalf("restoring cwd returned error: %v", err)
+		}
+	}()
+
+	before := snapshotDir(t, tmp)
+	data := encodeGrayBytes(t, twoByTwoFourValues(), mustDefaultConfig(t))
+	after := snapshotDir(t, tmp)
+
+	if !reflect.DeepEqual(after, before) {
+		t.Fatalf("cwd entries after EncodeGray = %#v, want %#v", after, before)
+	}
+
+	assertFourValueGrayImage(t, data)
+}
