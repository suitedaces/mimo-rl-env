diff --git a/packages/react-dom/src/__tests__/ReactDOMSelect-test.js b/packages/react-dom/src/__tests__/ReactDOMSelect-test.js
index 4332c52d12..8f62f70dff 100644
--- a/packages/react-dom/src/__tests__/ReactDOMSelect-test.js
+++ b/packages/react-dom/src/__tests__/ReactDOMSelect-test.js
@@ -1290,4 +1290,101 @@ describe('ReactDOMSelect', () => {
       );
     });
   });
+
+  describe('select controlled value warning message', () => {
+    it('should warn select with value and no onChange without mentioning readOnly', () => {
+      const container = document.createElement('div');
+      expect(() =>
+        ReactDOM.render(
+          <select value="giraffe">
+            <option value="monkey">A monkey!</option>
+            <option value="giraffe">A giraffe!</option>
+            <option value="gorilla">A gorilla!</option>
+          </select>,
+          container,
+        ),
+      ).toErrorDev(
+        'You provided a `value` prop to a form field without an `onChange` handler. ' +
+          'This will render a read-only field. If the field should be mutable use `defaultValue`. ' +
+          'Otherwise, set `onChange`.',
+      );
+    });
+
+    it('should warn select with value and no onChange (client render via renderIntoDocument) without mentioning readOnly', () => {
+      expect(() =>
+        ReactTestUtils.renderIntoDocument(
+          <select value="giraffe">
+            <option value="monkey">A monkey!</option>
+            <option value="giraffe">A giraffe!</option>
+          </select>,
+        ),
+      ).toErrorDev(
+        'You provided a `value` prop to a form field without an `onChange` handler. ' +
+          'This will render a read-only field. If the field should be mutable use `defaultValue`. ' +
+          'Otherwise, set `onChange`.',
+      );
+    });
+
+    it('should warn select with value and no onChange during server render without mentioning readOnly', () => {
+      expect(() =>
+        ReactDOMServer.renderToString(
+          <select value="giraffe">
+            <option value="monkey">A monkey!</option>
+            <option value="giraffe">A giraffe!</option>
+          </select>,
+        ),
+      ).toErrorDev(
+        'You provided a `value` prop to a form field without an `onChange` handler. ' +
+          'This will render a read-only field. If the field should be mutable use `defaultValue`. ' +
+          'Otherwise, set `onChange`.',
+      );
+    });
+
+    it('should not warn for select with value and onChange', () => {
+      const container = document.createElement('div');
+      ReactDOM.render(
+        <select value="giraffe" onChange={noop}>
+          <option value="monkey">A monkey!</option>
+          <option value="giraffe">A giraffe!</option>
+        </select>,
+        container,
+      );
+    });
+
+    it('should still warn input with value and no onChange using the readOnly message', () => {
+      const container = document.createElement('div');
+      expect(() =>
+        ReactDOM.render(<input type="text" value="hi" />, container),
+      ).toErrorDev(
+        'You provided a `value` prop to a form field without an `onChange` handler. ' +
+          'This will render a read-only field. If the field should be mutable use `defaultValue`. ' +
+          'Otherwise, set either `onChange` or `readOnly`.',
+      );
+    });
+
+    it('should still warn textarea with value and no onChange using the readOnly message', () => {
+      const container = document.createElement('div');
+      expect(() =>
+        ReactDOM.render(<textarea value="hi" />, container),
+      ).toErrorDev(
+        'You provided a `value` prop to a form field without an `onChange` handler. ' +
+          'This will render a read-only field. If the field should be mutable use `defaultValue`. ' +
+          'Otherwise, set either `onChange` or `readOnly`.',
+      );
+    });
+
+    it('should still warn input with checked and no onChange using the readOnly message', () => {
+      const container = document.createElement('div');
+      expect(() =>
+        ReactDOM.render(
+          <input type="checkbox" checked={false} />,
+          container,
+        ),
+      ).toErrorDev(
+        'You provided a `checked` prop to a form field without an `onChange` handler. ' +
+          'This will render a read-only field. If the field should be mutable use `defaultChecked`. ' +
+          'Otherwise, set either `onChange` or `readOnly`.',
+      );
+    });
+  });
 });
