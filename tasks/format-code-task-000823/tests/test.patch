+    def test_load_secrets_short_syntax_does_not_crash_project_build(self):
+
+
+
+        from compose.project import Project
+
+        config_data = config.load(build_config_details({
+            'version': '3.1',
+            'services': {
+                'b': {
+                    'image': 'tutum/hello-world',
+                    'secrets': ['my_file_secret'],
+                },
+            },
+            'secrets': {
+                'my_file_secret': {'file': '/tmp/my_file_secret.txt'},
+            },
+        }))
+        project = Project.from_config('composetest', config_data, client=None)
+        service = project.get_service('b')
+        assert len(service.secrets) == 1
+        secret_entry = service.secrets[0]
+        assert secret_entry['file'] == '/tmp/my_file_secret.txt'
+        assert secret_entry['secret'].source == 'my_file_secret'
+        assert secret_entry['secret'].target is None
+
+    def test_load_secrets_long_syntax_does_not_crash_project_build(self):
+        from compose.project import Project
+
+        config_data = config.load(build_config_details({
+            'version': '3.1',
+            'services': {
+                'b': {
+                    'image': 'tutum/hello-world',
+                    'secrets': [
+                        {'source': 'my_file_secret', 'target': 'special'},
+                    ],
+                },
+            },
+            'secrets': {
+                'my_file_secret': {'file': '/tmp/my_file_secret.txt'},
+            },
+        }))
+        project = Project.from_config('composetest', config_data, client=None)
+        service = project.get_service('b')
+        assert len(service.secrets) == 1
+        secret_entry = service.secrets[0]
+        assert secret_entry['file'] == '/tmp/my_file_secret.txt'
+        assert secret_entry['secret'].source == 'my_file_secret'
+        assert secret_entry['secret'].target == 'special'
+
+    def test_load_undefined_secret_short_syntax_raises_configuration_error(self):
+        from compose.project import Project
+
+        config_data = config.load(build_config_details({
+            'version': '3.1',
+            'services': {
+                'b': {
+                    'image': 'tutum/hello-world',
+                    'secrets': ['not_defined'],
+                },
+            },
+            'secrets': {
+                'my_file_secret': {'file': '/tmp/my_file_secret.txt'},
+            },
+        }))
+        with pytest.raises(ConfigurationError) as exc:
+            Project.from_config('composetest', config_data, client=None)
+        assert 'undefined secret "not_defined"' in exc.exconly()
+
+    def test_load_secrets_merge_across_compose_files(self):
+
+
+
+        from compose.config.config import ConfigDetails, ConfigFile
+
+        details = ConfigDetails(
+            'working_dir',
+            [
+                ConfigFile('base.yml', {
+                    'version': '3.1',
+                    'services': {
+                        'web': {
+                            'image': 'busybox',
+                            'secrets': ['s1'],
+                        },
+                    },
+                    'secrets': {
+                        's1': {'file': '/tmp/s1.txt'},
+                        's2': {'file': '/tmp/s2.txt'},
+                    },
+                }),
+                ConfigFile('override.yml', {
+                    'version': '3.1',
+                    'services': {
+                        'web': {'secrets': ['s2']},
+                    },
+                }),
+            ],
+        )
+        result = config.load(details)
+        secrets = result.services[0]['secrets']
+        sources = sorted(
+            s.source if hasattr(s, 'source') else s for s in secrets
+        )
+        assert sources == ['s1', 's2']
+
 
