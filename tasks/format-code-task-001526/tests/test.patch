+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export GOPROXY=off
+export GOSUMDB=off
+export GOTOOLCHAIN=local
+
+exec go test -mod=mod -v -count=1 ./usercase-test-coderl/...
