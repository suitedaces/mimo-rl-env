+import importlib
+import json
+import os
+import sys
+import types
+import warnings
+
+import pytest
+
+import can
+
+
+ENV_KEYS = (
+    "CAN_INTERFACE",
+    "CAN_CHANNEL",
+    "CAN_CONFIG",
+    "CAN_INTERFACE_CTXA",
+    "CAN_CHANNEL_CTXA",
+    "CAN_CONFIG_CTXA",
+    "CAN_INTERFACE_ALIASCTX",
+    "CAN_CHANNEL_ALIASCTX",
+    "CAN_CONFIG_ALIASCTX",
+)
+
+
+@pytest.fixture(autouse=True)
+def clean_configuration_sources(monkeypatch):
+    for key in ENV_KEYS:
+        monkeypatch.delenv(key, raising=False)
+    can.rc.clear()
+    yield
+    can.rc.clear()
+
+
+def test_virtual_bus_explicit_constructor_and_normal_bus_api():
+
+
+
+
+    bus = can.Bus(
+        interface="virtual",
+        channel="fixture-explicit",
+        receive_own_messages=True,
+        ignore_config=True,
+    )
+
+
+    assert isinstance(bus, can.BusABC)
+
+    bus.send(can.Message(arbitration_id=0x123, data=[1, 2, 3], is_extended_id=False))
+    received = bus.recv(timeout=0.01)
+    assert received.arbitration_id == 291
+    assert list(received.data) == [1, 2, 3]
+    assert received.channel == "fixture-explicit"
+
+    assert received is not None
+    assert bus.recv(timeout=0.0) is None
+
+    bus.shutdown()
+
+
+def test_config_context_merges_environment_configuration():
+
+
+
+
+    os.environ["CAN_INTERFACE_CTXA"] = "virtual"
+    os.environ["CAN_CHANNEL_CTXA"] = "fixture-context-channel"
+    os.environ["CAN_CONFIG_CTXA"] = json.dumps({"receive_own_messages": True})
+
+    bus = can.Bus(config_context="CTXA")
+
+
+    assert isinstance(bus, can.BusABC)
+    bus.send(can.Message(arbitration_id=0x55, data=[8], is_extended_id=False))
+    received = bus.recv(timeout=0.01)
+
+    assert received.arbitration_id == 0x55
+    assert received.channel == "fixture-context-channel"
+
+    bus.shutdown()
+
+
+def test_explicit_arguments_override_context_configuration():
+
+
+
+
+    os.environ["CAN_INTERFACE_CTXA"] = "virtual"
+    os.environ["CAN_CHANNEL_CTXA"] = "fixture-env-channel"
+    os.environ["CAN_CONFIG_CTXA"] = json.dumps({"receive_own_messages": True})
+
+    bus = can.Bus(
+        interface="virtual",
+        channel="fixture-explicit-over-env",
+        config_context="CTXA",
+    )
+
+
+    assert isinstance(bus, can.BusABC)
+    bus.send(can.Message(arbitration_id=0x56, data=[9], is_extended_id=False))
+    received = bus.recv(timeout=0.01)
+
+    assert received.arbitration_id == 0x56
+    assert received.channel == "fixture-explicit-over-env"
+
+    bus.shutdown()
+
+
+def test_ignore_config_skips_environment_and_uses_backend_default_channel():
+
+
+
+
+    os.environ["CAN_INTERFACE"] = "virtual"
+    os.environ["CAN_CHANNEL"] = "fixture-env-ignored"
+
+    bus = can.Bus(interface="virtual", ignore_config=True)
+    env_channel_peer = can.Bus(
+        interface="virtual",
+        channel="fixture-env-ignored",
+        receive_own_messages=True,
+        ignore_config=True,
+    )
+
+
+    assert isinstance(bus, can.BusABC)
+    bus.send(can.Message(arbitration_id=0x57, data=[10], is_extended_id=False))
+    assert env_channel_peer.recv(timeout=0.0) is None
+
+    env_channel_peer.shutdown()
+    bus.shutdown()
+
+
+class RecordingBus(can.BusABC):
+    calls = []
+
+    def __init__(self, *args, **kwargs):
+        channel = args[0] if args else "DEFAULT-FROM-BACKEND"
+        super().__init__(channel=channel, **kwargs)
+        self.args = args
+        self.kwargs = kwargs
+        self.channel_id = channel
+        self.channel_info = f"Recording bus channel {self.channel_id}"
+        type(self).calls.append((args, kwargs))
+
+    def send(self, msg, timeout=None):
+        return None
+
+    def _recv_internal(self, timeout):
+        return None, False
+
+
+@pytest.fixture
+def registered_recording_backend(monkeypatch):
+    module = types.ModuleType("fixture_recording_backend")
+    module.RecordingBus = RecordingBus
+    monkeypatch.setitem(sys.modules, "fixture_recording_backend", module)
+    monkeypatch.setitem(
+        can.interfaces.BACKENDS,
+        "fixture_recording",
+        ("fixture_recording_backend", "RecordingBus"),
+    )
+    RecordingBus.calls.clear()
+    yield RecordingBus
+    RecordingBus.calls.clear()
+
+
+def test_backend_receives_channel_positionally_and_no_interface_keyword(
+    registered_recording_backend,
+):
+
+
+
+
+    bus = can.Bus(
+        interface="fixture_recording",
+        channel="fixture-positional",
+        custom_option="custom-value",
+        ignore_config=True,
+    )
+
+    assert isinstance(bus, can.BusABC)
+    assert registered_recording_backend.calls == [
+        (("fixture-positional",), {"custom_option": "custom-value"})
+    ]
+
+    bus.shutdown()
+
+
+def test_unresolved_channel_is_not_passed_positionally(registered_recording_backend):
+
+
+
+
+    bus = can.Bus(
+        interface="fixture_recording",
+        custom_option="custom-value",
+        ignore_config=True,
+    )
+
+    assert isinstance(bus, can.BusABC)
+    assert registered_recording_backend.calls == [
+        ((), {"custom_option": "custom-value"})
+    ]
+
+    bus.shutdown()
+
+
+def test_unknown_interface_fails_before_backend_instance_is_created(
+    registered_recording_backend,
+):
+
+
+
+
+    with pytest.raises(can.CanInterfaceNotImplementedError) as exc_info:
+        can.Bus(interface="definitely_not_a_python_can_backend")
+
+
+    assert "definitely_not_a_python_can_backend" in str(exc_info.value)
+    assert registered_recording_backend.calls == []
+
+
+def test_backend_import_failure_is_reported_as_can_interface_not_implemented(
+    monkeypatch,
+):
+
+
+
+
+    monkeypatch.setitem(
+        can.interfaces.BACKENDS,
+        "fixture_missing_module",
+        ("fixture_missing_module_nope", "MissingBus"),
+    )
+
+    with pytest.raises(can.CanInterfaceNotImplementedError) as exc_info:
+        can.Bus(interface="fixture_missing_module", ignore_config=True)
+
+
+    assert isinstance(exc_info.value, can.CanInterfaceNotImplementedError)
+
+
+def test_backend_class_lookup_failure_is_reported_as_can_interface_not_implemented(
+    monkeypatch,
+):
+
+
+
+
+    module = types.ModuleType("fixture_empty_backend")
+    monkeypatch.setitem(sys.modules, "fixture_empty_backend", module)
+    monkeypatch.setitem(
+        can.interfaces.BACKENDS,
+        "fixture_missing_class",
+        ("fixture_empty_backend", "MissingBus"),
+    )
+
+    with pytest.raises(can.CanInterfaceNotImplementedError) as exc_info:
+        can.Bus(interface="fixture_missing_class", ignore_config=True)
+
+
+    assert isinstance(exc_info.value, can.CanInterfaceNotImplementedError)
+
+
+def test_deprecated_bustype_alias_uses_existing_warning_mechanism():
+
+
+
+
+    with warnings.catch_warnings(record=True) as captured:
+        warnings.simplefilter("always")
+        bus = can.Bus(
+            bustype="virtual",
+            channel="fixture-alias-bustype",
+            ignore_config=True,
+        )
+
+    assert bus.channel_id == "fixture-alias-bustype"
+
+    deprecation_messages = [
+        str(warning.message)
+        for warning in captured
+        if isinstance(warning.message, DeprecationWarning)
+    ]
+    assert len(deprecation_messages) >= 1
+    assert any("bustype" in message and "interface" in message for message in deprecation_messages)
+
+    bus.shutdown()
+
+
+def test_deprecated_context_alias_selects_configuration_context():
+
+
+
+
+    os.environ["CAN_INTERFACE_ALIASCTX"] = "virtual"
+    os.environ["CAN_CHANNEL_ALIASCTX"] = "fixture-context-alias-channel"
+
+    with warnings.catch_warnings(record=True) as captured:
+        warnings.simplefilter("always")
+        bus = can.Bus(context="ALIASCTX")
+
+    assert bus.channel_id == "fixture-context-alias-channel"
+
+    deprecation_messages = [
+        str(warning.message)
+        for warning in captured
+        if isinstance(warning.message, DeprecationWarning)
+    ]
+    assert len(deprecation_messages) >= 1
+    assert any("context" in message and "config_context" in message for message in deprecation_messages)
+
+    bus.shutdown()
+
+
+def test_operations_after_shutdown_raise_specific_error_type():
+
+
+
+
+    bus = can.Bus(
+        interface="virtual",
+        channel="fixture-after-shutdown",
+        receive_own_messages=True,
+        ignore_config=True,
+    )
+    bus.shutdown()
+
+    with pytest.raises(can.CanOperationError) as exc_info:
+        bus.recv(timeout=0.0)
+
+
+    assert exc_info.value is not None
+
+
+def test_shutdown_is_idempotent():
+
+
+
+
+    bus = can.Bus(
+        interface="virtual",
+        channel="fixture-double-shutdown",
+        ignore_config=True,
+    )
+
+    bus.shutdown()
+    after_first_shutdown = sorted(
+        cfg["channel"]
+        for cfg in can.detect_available_configs("virtual")
+        if cfg["channel"] == "fixture-double-shutdown"
+    )
+    assert after_first_shutdown == []
+    bus.shutdown()
+    after_second_shutdown = sorted(
+        cfg["channel"]
+        for cfg in can.detect_available_configs("virtual")
+        if cfg["channel"] == "fixture-double-shutdown"
+    )
+    assert after_second_shutdown == []
+
+
+def test_two_bus_instances_keep_independent_channels():
+
+
+
+
+    bus_a = can.Bus(
+        interface="virtual",
+        channel="fixture-a",
+        receive_own_messages=True,
+        ignore_config=True,
+    )
+    bus_b = can.Bus(
+        interface="virtual",
+        channel="fixture-b",
+        receive_own_messages=True,
+        ignore_config=True,
+    )
+
+    bus_a.send(can.Message(arbitration_id=0x321, data=[9], is_extended_id=False))
+    received_a = bus_a.recv(timeout=0.01)
+
+    assert received_a.arbitration_id == 801
+    assert list(received_a.data) == [9]
+    assert bus_b.recv(timeout=0.0) is None
+
+    bus_b.send(can.Message(arbitration_id=0x322, data=[10], is_extended_id=False))
+    received_b = bus_b.recv(timeout=0.01)
+    assert received_b.arbitration_id == 802
+    assert bus_a.recv(timeout=0.0) is None
+
+    bus_a.shutdown()
+    bus_b.shutdown()
+
+
+def test_same_channel_buses_exchange_messages_without_sender_echo():
+
+
+
+
+    sender = can.Bus(
+        interface="virtual",
+        channel="fixture-shared",
+        receive_own_messages=False,
+        ignore_config=True,
+    )
+    receiver = can.Bus(
+        interface="virtual",
+        channel="fixture-shared",
+        receive_own_messages=False,
+        ignore_config=True,
+    )
+
+    sender.send(can.Message(arbitration_id=0x456, data=[4, 5], is_extended_id=False))
+    received = receiver.recv(timeout=0.01)
+
+    assert sender.recv(timeout=0.0) is None
+    assert received.arbitration_id == 1110
+    assert list(received.data) == [4, 5]
+    assert received.channel == "fixture-shared"
+
+    assert received is not None
+
+    sender.shutdown()
+    receiver.shutdown()
+
+
+def test_repeated_construct_use_shutdown_cycles_do_not_leave_virtual_channels():
+
+
+
+
+    before = sorted(
+        cfg["channel"]
+        for cfg in can.detect_available_configs("virtual")
+        if str(cfg["channel"]).startswith("fixture-leak-")
+    )
+    assert before == []
+
+    for index in range(100):
+        bus = can.Bus(
+            interface="virtual",
+            channel=f"fixture-leak-{index}",
+            receive_own_messages=True,
+            ignore_config=True,
+        )
+        bus.send(can.Message(arbitration_id=index, data=[index % 256], is_extended_id=False))
+        received = bus.recv(timeout=0.01)
+        assert received.arbitration_id == index
+        bus.shutdown()
+
+    after = sorted(
+        cfg["channel"]
+        for cfg in can.detect_available_configs("virtual")
+        if str(cfg["channel"]).startswith("fixture-leak-")
+    )
+    assert after == []
+
+
+def test_bus_is_exported_from_public_package_and_interface_module():
+
+
+
+
+    assert callable(can.Bus) is True
+
+    from can import Bus as imported_bus
+
+    assert imported_bus is can.Bus
+
+    imported = importlib.import_module("can")
+    assert callable(imported.Bus) is True
