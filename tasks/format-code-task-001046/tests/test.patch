@@ -0,0 +1,167 @@
+package dijkstra
+
+import (
+	"math"
+	"reflect"
+	"testing"
+)
+
+func contractNode(name string) Node { return Node{Name: name} }
+
+func contractNames(path Path) []string {
+	if len(path.Edges) == 0 {
+		return nil
+	}
+	names := []string{path.Edges[0].NodeA.Name}
+	for _, edge := range path.Edges {
+		names = append(names, edge.NodeB.Name)
+	}
+	return names
+}
+
+func contractSPT(t *testing.T, topology *Topology, source Node) (result SPT) {
+	t.Helper()
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			t.Errorf("SPT panicked for source %q: %v", source.Name, recovered)
+			result = nil
+		}
+	}()
+	return topology.SPT(source)
+}
+
+func TestSPTContractDisconnectedAndUnknownSources(t *testing.T) {
+	a, b, c := contractNode("A"), contractNode("B"), contractNode("C")
+	topology := NewTopology([]Node{a, b, c}, []Edge{{NodeA: a, NodeB: b, Distance: 4}})
+
+	t.Run("disconnected node", func(t *testing.T) {
+		spt := contractSPT(t, topology, a)
+		if spt == nil {
+			return
+		}
+		if got := spt[c]; got.Distance != -1 || len(got.Edges) != 0 {
+			t.Fatalf("disconnected node should remain unreachable, got %+v", got)
+		}
+		if got := spt[b]; got.Distance != 4 || !reflect.DeepEqual(contractNames(got), []string{"A", "B"}) {
+			t.Fatalf("reachable neighbor was damaged by a disconnected node: %+v", got)
+		}
+	})
+
+	t.Run("unknown source", func(t *testing.T) {
+		spt := contractSPT(t, topology, contractNode("missing"))
+		if spt == nil {
+			return
+		}
+		if len(spt) != 3 {
+			t.Fatalf("unknown source changed the declared node set: got %d entries", len(spt))
+		}
+		for node, path := range spt {
+			if path.Distance != -1 || len(path.Edges) != 0 {
+				t.Fatalf("node %q should be unreachable from an unknown source: %+v", node.Name, path)
+			}
+		}
+	})
+}
+
+func TestSPTContractEdgeEndpointsAndDirection(t *testing.T) {
+	a, b, c := contractNode("A"), contractNode("B"), contractNode("C")
+	topology := NewTopology([]Node{a}, []Edge{
+		{NodeA: a, NodeB: b, Distance: 2},
+		{NodeA: b, NodeB: c, Distance: 3},
+	})
+
+	forward := contractSPT(t, topology, a)
+	if forward == nil {
+		return
+	}
+	if len(forward) != 3 || forward[c].Distance != 5 || !reflect.DeepEqual(contractNames(forward[c]), []string{"A", "B", "C"}) {
+		t.Fatalf("edge endpoints were not incorporated into the topology: %#v", forward)
+	}
+	reverse := contractSPT(t, topology, c)
+	if reverse == nil {
+		return
+	}
+	if reverse[a].Distance != -1 || reverse[b].Distance != -1 {
+		t.Fatalf("directed edges were traversed backwards: A=%+v B=%+v", reverse[a], reverse[b])
+	}
+}
+
+func TestSPTContractDuplicateEdgesChooseMinimum(t *testing.T) {
+	a, b := contractNode("A"), contractNode("B")
+	orders := [][]Edge{
+		{{NodeA: a, NodeB: b, Distance: 9}, {NodeA: a, NodeB: b, Distance: 3}},
+		{{NodeA: a, NodeB: b, Distance: 3}, {NodeA: a, NodeB: b, Distance: 9}},
+	}
+	for i, edges := range orders {
+		spt := contractSPT(t, NewTopology([]Node{a, b}, edges), a)
+		if spt == nil {
+			continue
+		}
+		path := spt[b]
+		if path.Distance != 3 || len(path.Edges) != 1 || path.Edges[0].Distance != 3 {
+			t.Fatalf("order %d did not retain the minimum duplicate edge: %+v", i, path)
+		}
+	}
+}
+
+func TestSPTContractEqualCostTieBreaksByFullNodeSequence(t *testing.T) {
+	a, z, b := contractNode("A"), contractNode("Z"), contractNode("B")
+	c, y, d := contractNode("C"), contractNode("Y"), contractNode("D")
+	nodes := []Node{a, z, b, c, y, d}
+	edges := []Edge{
+		{NodeA: a, NodeB: z, Distance: 1},
+		{NodeA: z, NodeB: b, Distance: 1},
+		{NodeA: b, NodeB: d, Distance: 1},
+		{NodeA: a, NodeB: c, Distance: 1},
+		{NodeA: c, NodeB: y, Distance: 1},
+		{NodeA: y, NodeB: d, Distance: 1},
+	}
+
+	orders := [][]Edge{edges, {edges[5], edges[4], edges[3], edges[2], edges[1], edges[0]}}
+	for i, order := range orders {
+		spt := contractSPT(t, NewTopology(nodes, order), a)
+		if spt == nil {
+			continue
+		}
+		path := spt[d]
+		want := []string{"A", "C", "Y", "D"}
+		if path.Distance != 3 || !reflect.DeepEqual(contractNames(path), want) {
+			t.Fatalf("order %d chose a non-canonical equal-cost path: distance=%d nodes=%v", i, path.Distance, contractNames(path))
+		}
+	}
+}
+
+func TestSPTContractZeroCyclesNegativeEdgesAndOverflow(t *testing.T) {
+	a, b, c, d := contractNode("A"), contractNode("B"), contractNode("C"), contractNode("D")
+	topology := NewTopology([]Node{a, b, c, d}, []Edge{
+		{NodeA: a, NodeB: a, Distance: 0},
+		{NodeA: a, NodeB: b, Distance: 0},
+		{NodeA: b, NodeB: a, Distance: 0},
+		{NodeA: a, NodeB: c, Distance: 5},
+		{NodeA: a, NodeB: c, Distance: -10},
+		{NodeA: a, NodeB: d, Distance: math.MaxInt64},
+		{NodeA: d, NodeB: c, Distance: 1},
+	})
+	spt := contractSPT(t, topology, a)
+	if spt == nil {
+		return
+	}
+	if got := spt[b]; got.Distance != 0 || !reflect.DeepEqual(contractNames(got), []string{"A", "B"}) {
+		t.Fatalf("zero-cost edge was not handled as a finite loop-free path: %+v", got)
+	}
+	if got := spt[c]; got.Distance != 5 || !reflect.DeepEqual(contractNames(got), []string{"A", "C"}) {
+		t.Fatalf("negative or overflowing route displaced the valid path: %+v", got)
+	}
+	if got := spt[d]; got.Distance != math.MaxInt64 || !reflect.DeepEqual(contractNames(got), []string{"A", "D"}) {
+		t.Fatalf("maximum finite distance was not retained: %+v", got)
+	}
+	for node, path := range spt {
+		seen := map[Node]bool{}
+		for _, edge := range path.Edges {
+			if seen[edge.NodeA] {
+				t.Fatalf("path to %q contains a cycle: %v", node.Name, contractNames(path))
+			}
+			seen[edge.NodeA] = true
+		}
+	}
+}
