+#!/bin/bash
+set -euo pipefail
+
+
+VERIFIER_GOMODCACHE="$(mktemp -d)"
+trap 'rmdir "${VERIFIER_GOMODCACHE}" 2>/dev/null || true' EXIT
+GOMODCACHE="${VERIFIER_GOMODCACHE}" GOPROXY=off GOSUMDB=off \
+  go test util/dijkstra/dijkstra.go util/dijkstra/spt_contract_test.go
