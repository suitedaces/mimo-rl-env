+import pathlib
+import subprocess
+import sys
+import tempfile
+import unittest
+
+
+REPO_ROOT = pathlib.Path(__file__).resolve().parents[2]
+SCRIPT = REPO_ROOT / "scripts" / "use_pd_array_in_core.py"
+MESSAGE = "Don't use pd.array in core, import array as pd_array instead"
+
+
+class TestUsePdArrayContract(unittest.TestCase):
+    def run_validator(self, files):
+        return subprocess.run(
+            [sys.executable, str(SCRIPT), *(str(path) for path in files)],
+            cwd=REPO_ROOT,
+            check=False,
+            capture_output=True,
+            text=True,
+        )
+
+    def test_reports_each_real_pandas_array_use_and_import(self):
+        content = "\n".join(
+            [
+                "import pandas as pd",
+                "import pandas",
+                "import pandas as p",
+                "import pandas.core as core",
+                "import unrelated as other",
+                "value1 = pd.array",
+                "value2 = pandas.array",
+                "value3 = p.array",
+                "value4 = core.array",
+                "value5 = other.array",
+                "from pandas import array",
+                "from pandas import array as arr",
+                "from pandas import array as pd_array",
+                "from unrelated import array",
+            ]
+        )
+        with tempfile.TemporaryDirectory() as directory:
+            path = pathlib.Path(directory) / "aliases.py"
+            path.write_text(content, encoding="utf-8")
+            result = self.run_validator([path])
+
+        expected = "\n".join(
+            [
+                f"{path}:6:9: {MESSAGE}",
+                f"{path}:7:9: {MESSAGE}",
+                f"{path}:8:9: {MESSAGE}",
+                f"{path}:11:0: {MESSAGE}",
+                f"{path}:12:0: {MESSAGE}",
+                "",
+            ]
+        )
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, expected)
+
+    def test_unrelated_names_are_not_reported(self):
+        content = "\n".join(
+            [
+                "pd = object()",
+                "first = pd.array",
+                "import pandas.core as pd_core",
+                "second = pd_core.array",
+                "from unrelated import array",
+                "from pandas.core import array as core_array",
+            ]
+        )
+        with tempfile.TemporaryDirectory() as directory:
+            path = pathlib.Path(directory) / "unrelated.py"
+            path.write_text(content, encoding="utf-8")
+            result = self.run_validator([path])
+
+        self.assertEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, "")
+
+    def test_scans_all_files_in_argument_order(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = pathlib.Path(directory)
+            first = root / "first.py"
+            second = root / "second.py"
+            first.write_text("import pandas as p\np.array\np.array\n", encoding="utf-8")
+            second.write_text("from pandas import array as wrong\n", encoding="utf-8")
+            result = self.run_validator([second, first])
+
+        expected = "\n".join(
+            [
+                f"{second}:1:0: {MESSAGE}",
+                f"{first}:2:0: {MESSAGE}",
+                f"{first}:3:0: {MESSAGE}",
+                "",
+            ]
+        )
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, expected)
+
+    def test_correct_alias_and_non_pandas_imports_are_clean(self):
+        content = "\n".join(
+            [
+                "from pandas import array as pd_array",
+                "from unrelated import array as other_array",
+                "import pandas as pd",
+                "result = pd_array([1, 2])",
+                "other_array([3])",
+            ]
+        )
+        with tempfile.TemporaryDirectory() as directory:
+            path = pathlib.Path(directory) / "clean.py"
+            path.write_text(content, encoding="utf-8")
+            result = self.run_validator([path])
+
+        self.assertEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, "")
+
+
+if __name__ == "__main__":
+    unittest.main()
