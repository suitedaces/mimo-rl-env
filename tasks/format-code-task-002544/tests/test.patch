diff --git a/test/yarp/encoding_test.rb b/test/yarp/encoding_test.rb
index 828b45be73..c2c9a3f4a1 100644
--- a/test/yarp/encoding_test.rb
+++ b/test/yarp/encoding_test.rb
@@ -96,5 +96,48 @@ def test_first_lexed_token
       encoding = YARP.lex("# encoding: ascii-8bit").value[0][0].value.encoding
       assert_equal Encoding.find("ascii-8bit"), encoding
     end
+
+    def test_parse_source_encoding_from_magic_comment
+      source = "# encoding: Shift_JIS\nア"
+      result = YARP.parse(source)
+
+      assert_equal Encoding::SHIFT_JIS, result.source.source.encoding
+    end
+
+    def test_parse_source_and_slice_encoding_from_non_magic_utf8_content
+      source = "\"中文\""
+      result = YARP.parse(source)
+
+      assert_equal Encoding::UTF_8, result.source.source.encoding
+
+      slice = result.value.slice
+      assert_equal source, slice
+      assert_equal Encoding::UTF_8, slice.encoding
+    end
+
+    def test_slice_encoding
+      slice = YARP.parse("# encoding: Shift_JIS\nア").value.slice
+      assert_equal (+"ア").force_encoding(Encoding::SHIFT_JIS), slice
+      assert_equal Encoding::SHIFT_JIS, slice.encoding
+    end
+
+    def test_load_source_and_slice_encoding_from_serialized_magic_comment
+      source = "# encoding: Shift_JIS\nア"
+      result = YARP.load(source, YARP.dump(source))
+
+      assert_equal Encoding::SHIFT_JIS, result.source.source.encoding
+      assert_equal Encoding::SHIFT_JIS, result.value.slice.encoding
+    end
+
+    def test_load_source_and_slice_encoding_from_serialized_non_magic_utf8_content
+      source = "\"中文\""
+      result = YARP.load(source, YARP.dump(source))
+
+      assert_equal Encoding::UTF_8, result.source.source.encoding
+
+      slice = result.value.slice
+      assert_equal source, slice
+      assert_equal Encoding::UTF_8, slice.encoding
+    end
   end
 end

diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,28 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+apt-get -o Acquire::AllowInsecureRepositories=true -o Acquire::AllowDowngradeToInsecureRepositories=true install -y -qq ruby ruby-dev build-essential > /dev/null 2>&1 || true
+
+
+gem install bundler --no-document > /dev/null 2>&1
+bundle install --quiet 2>&1
+
+
+bundle exec rake compile 2>&1
+
+
+case "${1:-}" in
+  base)
+    bundle exec ruby -Ilib -Itest test/yarp/encoding_test.rb --name '/^(?!test_(parse_source_encoding_from_magic_comment|parse_source_and_slice_encoding_from_non_magic_utf8_content|slice_encoding|load_source_and_slice_encoding_from_serialized_magic_comment|load_source_and_slice_encoding_from_serialized_non_magic_utf8_content)$)/'
+    ;;
+  new)
+    bundle exec ruby -Ilib -Itest test/yarp/encoding_test.rb --name '/^test_(parse_source_encoding_from_magic_comment|parse_source_and_slice_encoding_from_non_magic_utf8_content|slice_encoding|load_source_and_slice_encoding_from_serialized_magic_comment|load_source_and_slice_encoding_from_serialized_non_magic_utf8_content)$/'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
