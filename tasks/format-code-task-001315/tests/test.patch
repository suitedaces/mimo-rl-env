new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/syntax_parse_test.go
@@ -0,0 +1,317 @@
+package usercase_test_coderl
+
+
+
+
+
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"testing"
+
+	"github.com/gobwas/glob/syntax"
+	"github.com/gobwas/glob/syntax/ast"
+)
+
+type nodeSnap struct {
+
+	Kind     ast.Kind
+	Value    *valueSnap
+	Children []nodeSnap
+}
+
+type valueSnap struct {
+	Type  string
+	Text  string
+	Not   bool
+	Chars string
+	Lo    rune
+	Hi    rune
+}
+
+func snapNode(t *testing.T, n *ast.Node) nodeSnap {
+	t.Helper()
+	if n == nil {
+		t.Fatalf("Parse returned nil node without error")
+	}
+
+	out := nodeSnap{Kind: n.Kind}
+	switch n.Kind {
+	case ast.KindText:
+		v, ok := n.Value.(ast.Text)
+		if !ok {
+			t.Fatalf("KindText node has value type %T, want ast.Text", n.Value)
+		}
+		out.Value = &valueSnap{Type: "ast.Text", Text: v.Text}
+	case ast.KindList:
+		v, ok := n.Value.(ast.List)
+		if !ok {
+			t.Fatalf("KindList node has value type %T, want ast.List", n.Value)
+		}
+		out.Value = &valueSnap{Type: "ast.List", Not: v.Not, Chars: v.Chars}
+	case ast.KindRange:
+		v, ok := n.Value.(ast.Range)
+		if !ok {
+			t.Fatalf("KindRange node has value type %T, want ast.Range", n.Value)
+		}
+		out.Value = &valueSnap{Type: "ast.Range", Not: v.Not, Lo: v.Lo, Hi: v.Hi}
+	default:
+
+	}
+
+	if len(n.Children) > 0 {
+		out.Children = make([]nodeSnap, len(n.Children))
+		for i, child := range n.Children {
+			out.Children[i] = snapNode(t, child)
+		}
+	}
+	return out
+}
+
+func mustParseSnap(t *testing.T, pattern string) nodeSnap {
+	t.Helper()
+	n, err := syntax.Parse(pattern)
+	if err != nil {
+		t.Fatalf("Parse(%q) returned unexpected error: %v", pattern, err)
+	}
+	return snapNode(t, n)
+}
+
+func assertParseSnap(t *testing.T, pattern string, expected nodeSnap) {
+	t.Helper()
+	actual := mustParseSnap(t, pattern)
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("Parse(%q) snapshot mismatch\nactual:   %#v\nexpected: %#v", pattern, actual, expected)
+	}
+}
+
+func assertParseError(t *testing.T, pattern string) {
+	t.Helper()
+	n, err := syntax.Parse(pattern)
+	if n != nil {
+		t.Fatalf("Parse(%q) returned node %#v on error path", pattern, snapNode(t, n))
+	}
+	if err == nil {
+		t.Fatalf("Parse(%q) returned nil error", pattern)
+	}
+
+}
+
+func textNode(text string) nodeSnap {
+	return nodeSnap{Kind: ast.KindText, Value: &valueSnap{Type: "ast.Text", Text: text}}
+}
+
+func pattern(children ...nodeSnap) nodeSnap {
+	return nodeSnap{Kind: ast.KindPattern, Children: children}
+}
+
+func anyOf(children ...nodeSnap) nodeSnap {
+	return nodeSnap{Kind: ast.KindAnyOf, Children: children}
+}
+
+func list(chars string, not bool) nodeSnap {
+	return nodeSnap{Kind: ast.KindList, Value: &valueSnap{Type: "ast.List", Chars: chars, Not: not}}
+}
+
+func rangeNode(lo, hi rune, not bool) nodeSnap {
+	return nodeSnap{Kind: ast.KindRange, Value: &valueSnap{Type: "ast.Range", Lo: lo, Hi: hi, Not: not}}
+}
+
+func anyNode() nodeSnap {
+	return nodeSnap{Kind: ast.KindAny}
+}
+
+func superNode() nodeSnap {
+	return nodeSnap{Kind: ast.KindSuper}
+}
+
+func singleNode() nodeSnap {
+	return nodeSnap{Kind: ast.KindSingle}
+}
+
+func TestParseLiteralText(t *testing.T) {
+
+
+	assertParseSnap(t, "abc", pattern(textNode("abc")))
+}
+
+func TestParseAnyWildcard(t *testing.T) {
+
+
+	assertParseSnap(t, "a*c", pattern(textNode("a"), anyNode(), textNode("c")))
+}
+
+func TestParseSuperWildcard(t *testing.T) {
+
+
+	assertParseSnap(t, "a**c", pattern(textNode("a"), superNode(), textNode("c")))
+}
+
+func TestParseSingleWildcard(t *testing.T) {
+
+
+	assertParseSnap(t, "a?c", pattern(textNode("a"), singleNode(), textNode("c")))
+}
+
+func TestParseCharacterList(t *testing.T) {
+
+
+	assertParseSnap(t, "[az]", pattern(list("az", false)))
+}
+
+func TestParseNegatedCharacterRange(t *testing.T) {
+
+
+	assertParseSnap(t, "[!a-z]", pattern(rangeNode('a', 'z', true)))
+}
+
+func TestParseAlternativesWithSuffixWildcard(t *testing.T) {
+
+
+	assertParseSnap(t, "/{z,ab}*", pattern(
+		textNode("/"),
+		anyOf(
+			pattern(textNode("z")),
+			pattern(textNode("ab")),
+		),
+		anyNode(),
+	))
+}
+
+func TestParseNestedAlternativesAndMixedTerms(t *testing.T) {
+
+
+	assertParseSnap(t, "{a,{x,y},?,[a-z],[!qwe]}", pattern(
+		anyOf(
+			pattern(textNode("a")),
+			pattern(anyOf(
+				pattern(textNode("x")),
+				pattern(textNode("y")),
+			)),
+			pattern(singleNode()),
+			pattern(rangeNode('a', 'z', false)),
+			pattern(list("qwe", true)),
+		),
+	))
+}
+
+func TestParseCommaOutsideAlternativesAsText(t *testing.T) {
+
+
+	assertParseSnap(t, "hello,world", pattern(textNode("hello,world")))
+}
+
+func TestParseEscapedCommaInsideAlternativeTerms(t *testing.T) {
+
+
+	assertParseSnap(t, `{a\,b,c}`, pattern(
+		anyOf(
+			pattern(textNode("a,b")),
+			pattern(textNode("c")),
+		),
+	))
+}
+
+func TestParseEscapedGlobOperatorsAsText(t *testing.T) {
+
+
+	assertParseSnap(t, `\*\?\[\{\}\\\,`, pattern(textNode(`*?[{}\,`)))
+}
+
+func TestParseUnterminatedRangeError(t *testing.T) {
+
+
+	assertParseError(t, "[abc")
+}
+
+func TestParseImpossibleRangeError(t *testing.T) {
+
+
+	assertParseError(t, "[z-a]")
+}
+
+func TestParseInvalidUTF8Error(t *testing.T) {
+
+
+	assertParseError(t, string([]byte{0xff, 'a'}))
+}
+
+func TestParseUnexpectedRangeTokenError(t *testing.T) {
+
+
+	assertParseError(t, "[a-b-c]")
+}
+
+func TestParseReferentialTransparency(t *testing.T) {
+	first := mustParseSnap(t, "/{z,ab}*")
+	second := mustParseSnap(t, "/{z,ab}*")
+	if !reflect.DeepEqual(first, second) {
+		t.Fatalf("same input produced different AST snapshots\nfirst:  %#v\nsecond: %#v", first, second)
+	}
+}
+
+func TestParseDoesNotMutateInputString(t *testing.T) {
+	input := string([]byte(`\*\?\[\{\}\\\,`))
+	before := string([]byte(input))
+	_ = mustParseSnap(t, input)
+	if input != before {
+		t.Fatalf("Parse mutated input string: got %q, want %q", input, before)
+	}
+}
+
+func TestParseNoHiddenGlobalStateAcrossCalls(t *testing.T) {
+	expected := pattern(textNode("a"), anyNode(), textNode("c"))
+	assertParseSnap(t, "a*c", expected)
+	_ = mustParseSnap(t, "/{z,ab}*")
+	_ = mustParseSnap(t, "[!a-z]")
+	_ = mustParseSnap(t, `\*\?\[\{\}\\\,`)
+	assertParseSnap(t, "a*c", expected)
+}
+
+func TestParseDoesNotWriteCurrentWorkingDirectory(t *testing.T) {
+	originalCWD, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd failed: %v", err)
+	}
+	tmp := t.TempDir()
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatalf("Chdir(%q) failed: %v", tmp, err)
+	}
+	defer func() {
+		if err := os.Chdir(originalCWD); err != nil {
+			t.Fatalf("restore Chdir(%q) failed: %v", originalCWD, err)
+		}
+	}()
+
+	before := snapshotCWD(t)
+	_ = mustParseSnap(t, "{a,{x,y},?,[a-z],[!qwe]}")
+	after := snapshotCWD(t)
+	if !reflect.DeepEqual(before, after) {
+		t.Fatalf("Parse changed cwd contents\nbefore: %#v\nafter:  %#v", before, after)
+	}
+}
+
+func snapshotCWD(t *testing.T) []string {
+	t.Helper()
+	var entries []string
+	err := filepath.WalkDir(".", func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		info, err := d.Info()
+		if err != nil {
+			return err
+		}
+		entries = append(entries, fmt.Sprintf("%s|dir=%t|size=%d", filepath.ToSlash(path), d.IsDir(), info.Size()))
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("snapshot cwd failed: %v", err)
+	}
+	sort.Strings(entries)
+	return entries
+}
