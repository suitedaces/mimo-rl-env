+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+REPO=/workspace/repo
+GOPATH_DIR=/tmp/fixture-gopath-gobwas-glob
+
+rm -rf "$GOPATH_DIR"
+mkdir -p "$GOPATH_DIR/src/github.com/gobwas"
+ln -s "$REPO" "$GOPATH_DIR/src/github.com/gobwas/glob"
+
+cd "$REPO"
+exec env \
+  GO111MODULE=off \
+  GOPATH="$GOPATH_DIR" \
+  GOPROXY=off \
+  GOSUMDB=off \
+  GOVCS='*:off' \
+  go test -v github.com/gobwas/glob/usercase-test-coderl
