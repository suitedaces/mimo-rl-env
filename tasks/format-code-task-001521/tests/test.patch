+  geometry.setIndex(new THREE.BufferAttribute(new Uint32Array([0, 1, 2]), 1));
+  scene.add(new THREE.Mesh(geometry, new THREE.MeshStandardMaterial({ color: 0x224466 })));
+  return scene;
