+
+func TestSqlServer_IncludeQueryOnly(t *testing.T) {
+	s := &SQLServer{
+		QueryVersion: 2,
+		IncludeQuery: []string{"DatabaseIO"},
+	}
+
+	initQueries(s)
+
+	_, hasIO := s.queries["DatabaseIO"]
+	assert.True(t, hasIO, "DatabaseIO should be present when included")
+
+
+	for _, name := range []string{
+		"PerformanceCounters",
+		"WaitStatsCategorized",
+		"ServerProperties",
+		"MemoryClerk",
+		"Schedulers",
+		"SqlRequests",
+	} {
+		_, ok := s.queries[name]
+		assert.False(t, ok, "%s should NOT be present when only DatabaseIO is included", name)
+	}
+	assert.Equal(t, 1, len(s.queries), "queries map should contain exactly the included query")
+}
+
+
+
+func TestSqlServer_NoIncludeNoExcludeKeepsAll(t *testing.T) {
+	s := &SQLServer{
+		QueryVersion: 2,
+	}
+
+	initQueries(s)
+
+	for _, name := range []string{
+		"PerformanceCounters",
+		"WaitStatsCategorized",
+		"DatabaseIO",
+		"ServerProperties",
+		"MemoryClerk",
+		"Schedulers",
+		"SqlRequests",
+	} {
+		_, ok := s.queries[name]
+		assert.True(t, ok, "%s should be present when no include/exclude set", name)
+	}
+}
+
+
+
+func TestSqlServer_ExcludeQueryOnlyLegacy(t *testing.T) {
+	s := &SQLServer{
+		QueryVersion: 2,
+		ExcludeQuery: []string{"Schedulers"},
+	}
+
+	initQueries(s)
+
+	_, hasSched := s.queries["Schedulers"]
+	assert.False(t, hasSched, "Schedulers should be excluded")
+
+	for _, name := range []string{
+		"PerformanceCounters",
+		"DatabaseIO",
+		"WaitStatsCategorized",
+		"ServerProperties",
+		"MemoryClerk",
+		"SqlRequests",
+	} {
+		_, ok := s.queries[name]
+		assert.True(t, ok, "%s should still be present when only Schedulers excluded", name)
+	}
+}
+
+
+
+
+func TestSqlServer_IncludeAndExcludeOverlap(t *testing.T) {
+	s := &SQLServer{
+		QueryVersion: 2,
+		IncludeQuery: []string{"DatabaseIO", "Schedulers"},
+		ExcludeQuery: []string{"Schedulers"},
+	}
+
+	initQueries(s)
+
+	_, hasIO := s.queries["DatabaseIO"]
+	assert.True(t, hasIO, "DatabaseIO should be present (included, not excluded)")
+
+	_, hasSched := s.queries["Schedulers"]
+	assert.False(t, hasSched, "Schedulers should be excluded even though included")
+
+
+	for _, name := range []string{
+		"PerformanceCounters",
+		"WaitStatsCategorized",
+		"ServerProperties",
+		"MemoryClerk",
+		"SqlRequests",
+	} {
+		_, ok := s.queries[name]
+		assert.False(t, ok, "%s should NOT be present (not in include list)", name)
+	}
+	assert.Equal(t, 1, len(s.queries), "queries map should only contain DatabaseIO")
+}
+
+
+func TestSqlServer_IncludeQueryAzureDB(t *testing.T) {
+	s := &SQLServer{
+		QueryVersion: 2,
+		AzureDB:      true,
+		IncludeQuery: []string{"AzureDBResourceStats"},
+	}
+
+	initQueries(s)
+
+	_, hasStats := s.queries["AzureDBResourceStats"]
+	assert.True(t, hasStats, "AzureDBResourceStats should be present when included")
+
+	_, hasGov := s.queries["AzureDBResourceGovernance"]
+	assert.False(t, hasGov, "AzureDBResourceGovernance should not be present (not included)")
+
+	_, hasIO := s.queries["DatabaseIO"]
+	assert.False(t, hasIO, "DatabaseIO should not be present (not included)")
+
+	assert.Equal(t, 1, len(s.queries), "queries map should contain exactly the included query")
+}
