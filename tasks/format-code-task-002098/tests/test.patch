 }
+
+func TestBuildInfoSecretsUnmarshalling(t *testing.T) {
+	buildManifest := []byte(`my-image:
+  context: .
+  secrets:
+    id1: path1
+    id2: path2`)
+
+	var result ManifestBuild
+	err := yaml.UnmarshalStrict(buildManifest, &result)
+	assert.NoError(t, err)
+
+	svc, ok := result["my-image"]
+	assert.True(t, ok)
+	assert.Equal(t, BuildSecrets{
+		"id1": "path1",
+		"id2": "path2",
+	}, svc.Secrets)
+}
+
+func TestBuildInfoSecretsUnmarshalling_Empty(t *testing.T) {
+	buildManifest := []byte(`my-image:
+  context: .`)
+
+	var result ManifestBuild
+	err := yaml.UnmarshalStrict(buildManifest, &result)
+	assert.NoError(t, err)
+
+	svc, ok := result["my-image"]
+	assert.True(t, ok)
+	assert.Empty(t, svc.Secrets)
+}
