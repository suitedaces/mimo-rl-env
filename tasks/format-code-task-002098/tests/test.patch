+func Test_OptsFromBuildInfo_SingleManifestSecret(t *testing.T) {
+	okteto.CurrentStore = &okteto.OktetoContextStore{
+		Contexts: map[string]*okteto.OktetoContext{
+			"test": {
+				Namespace: "test",
+				IsOkteto:  false,
+			},
+		},
+		CurrentContext: "test",
+	}
+
+	buildInfo := &model.BuildInfo{
+		Secrets: model.BuildSecrets{
