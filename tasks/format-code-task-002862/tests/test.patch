+    def test_traverse_scope_update_issue_example(self):
+
+        sql = """
+        UPDATE customers
+        SET total_spent = (
+            SELECT SUM(amount)
+            FROM payments
+            WHERE payments.customer_id = customers.id
+        )
+        WHERE EXISTS (
+            SELECT 1
+            FROM payments
+            WHERE payments.customer_id = customers.id
+        )
+        """
+        parsed = parse_one(sql)
+        scopes = traverse_scope(parsed)
+
+
+        self.assertGreater(len(scopes), 0)
+
+        select_scopes = [s for s in scopes if isinstance(s.expression, exp.Select)]
+        select_sqls = [s.expression.sql() for s in select_scopes]
+
+        self.assertIn(
+            "SELECT SUM(amount) FROM payments WHERE payments.customer_id = customers.id",
+            select_sqls,
+        )
+        self.assertIn(
+            "SELECT 1 FROM payments WHERE payments.customer_id = customers.id",
+            select_sqls,
+        )
+
+
+        self.assertEqual(len(select_sqls), len(set(select_sqls)))
+
+    def test_traverse_scope_update_subquery_in_set(self):
+        sql = "UPDATE t SET x = (SELECT MAX(a) FROM u WHERE u.t_id = t.id)"
+        parsed = parse_one(sql)
+        scopes = traverse_scope(parsed)
+
+        select_scopes = [s for s in scopes if isinstance(s.expression, exp.Select)]
+        self.assertEqual(len(select_scopes), 1)
+        self.assertEqual(
+            select_scopes[0].expression.sql(),
+            "SELECT MAX(a) FROM u WHERE u.t_id = t.id",
+        )
+
+    def test_traverse_scope_update_subquery_in_where(self):
+        sql = "UPDATE t SET x = 1 WHERE EXISTS (SELECT 1 FROM u WHERE u.t_id = t.id)"
+        parsed = parse_one(sql)
+        scopes = traverse_scope(parsed)
+
+        select_scopes = [s for s in scopes if isinstance(s.expression, exp.Select)]
+        self.assertEqual(len(select_scopes), 1)
+        self.assertEqual(
+            select_scopes[0].expression.sql(),
+            "SELECT 1 FROM u WHERE u.t_id = t.id",
+        )
+
+    def test_traverse_scope_update_plain_no_subqueries(self):
+
+        parsed = parse_one("UPDATE t SET x = 1 WHERE y = 2")
+        scopes = traverse_scope(parsed)
+        self.assertEqual(scopes, [])
+
+    def test_traverse_scope_update_with_cte(self):
+        sql = "WITH cte AS (SELECT * FROM src) UPDATE t SET x = 1 WHERE id IN (SELECT id FROM cte)"
+        parsed = parse_one(sql)
+        scopes = traverse_scope(parsed)
+
+        select_scopes = [s for s in scopes if isinstance(s.expression, exp.Select)]
+        select_sqls = [s.expression.sql() for s in select_scopes]
+
+
+        self.assertIn("SELECT * FROM src", select_sqls)
+        self.assertIn("SELECT id FROM cte", select_sqls)
+
+
+        self.assertEqual(len(select_sqls), len(set(select_sqls)))
+
+    def test_traverse_scope_update_no_duplicate_subquery_in_set(self):
+
+        sql = "UPDATE t SET x = (SELECT MAX(a) FROM u)"
+        parsed = parse_one(sql)
+        scopes = traverse_scope(parsed)
+
+        select_scopes = [s for s in scopes if isinstance(s.expression, exp.Select)]
+        select_sqls = [s.expression.sql() for s in select_scopes]
+
+        self.assertEqual(select_sqls, ["SELECT MAX(a) FROM u"])
+
