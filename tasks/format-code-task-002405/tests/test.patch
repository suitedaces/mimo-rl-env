+package v1alpha1_test
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"sigs.k8s.io/yaml"
+
+	"github.com/pyrra-dev/pyrra/kubernetes/api/v1alpha1"
+)
+
+func loadServiceLevelObjectiveSpecProperties(t *testing.T, path string) map[string]interface{} {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read ServiceLevelObjective CRD: %v", err)
+	}
+
+	var crd map[string]interface{}
+	if err := yaml.Unmarshal(data, &crd); err != nil {
+		t.Fatalf("unmarshal ServiceLevelObjective CRD: %v", err)
+	}
+
+	spec, ok := crd["spec"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("CRD spec has unexpected type %T", crd["spec"])
+	}
+	versions, ok := spec["versions"].([]interface{})
+	if !ok || len(versions) == 0 {
+		t.Fatalf("CRD has no versions")
+	}
+	version, ok := versions[0].(map[string]interface{})
+	if !ok {
+		t.Fatalf("CRD version entry has unexpected type %T", versions[0])
+	}
+
+	schema, ok := version["schema"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("CRD version schema has unexpected type %T", version["schema"])
+	}
+	openAPI, ok := schema["openAPIV3Schema"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("CRD openAPIV3Schema has unexpected type %T", schema["openAPIV3Schema"])
+	}
+	rootProperties, ok := openAPI["properties"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("CRD root properties have unexpected type %T", openAPI["properties"])
+	}
+	specSchema, ok := rootProperties["spec"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("CRD spec schema has unexpected type %T", rootProperties["spec"])
+	}
+	specProperties, ok := specSchema["properties"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("CRD spec properties have unexpected type %T", specSchema["properties"])
+	}
+
+	return specProperties
+}
+
+func partialResponseStrategySchema(t *testing.T) map[string]interface{} {
+	t.Helper()
+
+	specProperties := loadServiceLevelObjectiveSpecProperties(t, filepath.Join("..", "..", "..", "examples", "kubernetes", "manifests", "setup", "pyrra-slo-CustomResourceDefinition.yaml"))
+	field, ok := specProperties["partial_response_strategy"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("spec.partial_response_strategy schema missing or has unexpected type %T", specProperties["partial_response_strategy"])
+	}
+
+	return field
+}
+
+func assertPartialResponseStrategySchema(t *testing.T, path string) {
+	t.Helper()
+
+	specProperties := loadServiceLevelObjectiveSpecProperties(t, path)
+	assertPartialResponseStrategyField(t, path, specProperties)
+}
+
+func assertPartialResponseStrategyField(t *testing.T, source string, specProperties map[string]interface{}) {
+	t.Helper()
+
+	field, ok := specProperties["partial_response_strategy"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("%s: spec.partial_response_strategy schema missing or has unexpected type %T", source, specProperties["partial_response_strategy"])
+	}
+	if got := field["type"]; got != "string" {
+		t.Fatalf("%s: spec.partial_response_strategy type = %v, want string", source, got)
+	}
+	if got := field["default"]; got != "abort" {
+		t.Fatalf("%s: spec.partial_response_strategy default = %v, want abort", source, got)
+	}
+
+	values, ok := field["enum"].([]interface{})
+	if !ok {
+		t.Fatalf("%s: spec.partial_response_strategy enum missing or has unexpected type %T", source, field["enum"])
+	}
+	allowed := map[interface{}]bool{}
+	for _, value := range values {
+		allowed[value] = true
+	}
+	for _, value := range []string{"abort", "warn"} {
+		if !allowed[value] {
+			t.Fatalf("%s: spec.partial_response_strategy enum does not allow %q; enum=%v", source, value, values)
+		}
+	}
+	if allowed["ignore"] {
+		t.Fatalf("%s: spec.partial_response_strategy enum allows unsupported value %q; enum=%v", source, "ignore", values)
+	}
+}
+
+func TestServiceLevelObjectiveCRDSchemaIncludesPartialResponseStrategy(t *testing.T) {
+	field := partialResponseStrategySchema(t)
+
+	if got := field["type"]; got != "string" {
+		t.Fatalf("spec.partial_response_strategy type = %v, want string", got)
+	}
+}
+
+func TestServiceLevelObjectiveCRDSchemaDefaultsPartialResponseStrategyToAbort(t *testing.T) {
+	field := partialResponseStrategySchema(t)
+
+	if got := field["default"]; got != "abort" {
+		t.Fatalf("spec.partial_response_strategy default = %v, want abort", got)
+	}
+}
+
+func TestServiceLevelObjectiveCRDSchemaValidatesPartialResponseStrategyEnum(t *testing.T) {
+	field := partialResponseStrategySchema(t)
+	values, ok := field["enum"].([]interface{})
+	if !ok {
+		t.Fatalf("spec.partial_response_strategy enum missing or has unexpected type %T", field["enum"])
+	}
+
+	allowed := map[interface{}]bool{}
+	for _, value := range values {
+		allowed[value] = true
+	}
+
+	for _, value := range []string{"abort", "warn"} {
+		if !allowed[value] {
+			t.Fatalf("spec.partial_response_strategy enum does not allow %q; enum=%v", value, values)
+		}
+	}
+	if allowed["ignore"] {
+		t.Fatalf("spec.partial_response_strategy enum allows unsupported value %q; enum=%v", "ignore", values)
+	}
+}
+
+func TestServiceLevelObjectivePublishedSchemasIncludePartialResponseStrategy(t *testing.T) {
+	paths := []string{
+		filepath.Join("..", "..", "..", "examples", "kubernetes", "manifests", "setup", "pyrra-slo-CustomResourceDefinition.yaml"),
+		filepath.Join("..", "..", "..", "examples", "kubernetes", "manifests-webhook", "setup", "pyrra-slo-CustomResourceDefinition.yaml"),
+		filepath.Join("..", "..", "..", "examples", "openshift", "manifests", "setup", "pyrra-slo-CustomResourceDefinition.yaml"),
+	}
+	for _, path := range paths {
+		t.Run(path, func(t *testing.T) {
+			assertPartialResponseStrategySchema(t, path)
+		})
+	}
+}
+
+func TestServiceLevelObjectiveControllerGenSchemaIncludesPartialResponseStrategy(t *testing.T) {
+	path := filepath.Join("..", "..", "..", "jsonnet", "controller-gen", "pyrra.dev_servicelevelobjectives.json")
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read controller-gen schema: %v", err)
+	}
+
+	var crd map[string]interface{}
+	if err := json.Unmarshal(data, &crd); err != nil {
+		t.Fatalf("unmarshal controller-gen schema: %v", err)
+	}
+
+	spec, ok := crd["spec"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("controller-gen spec has unexpected type %T", crd["spec"])
+	}
+	versions, ok := spec["versions"].([]interface{})
+	if !ok || len(versions) == 0 {
+		t.Fatalf("controller-gen schema has no versions")
+	}
+	version, ok := versions[0].(map[string]interface{})
+	if !ok {
+		t.Fatalf("controller-gen version entry has unexpected type %T", versions[0])
+	}
+	schema, ok := version["schema"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("controller-gen version schema has unexpected type %T", version["schema"])
+	}
+	openAPI, ok := schema["openAPIV3Schema"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("controller-gen openAPIV3Schema has unexpected type %T", schema["openAPIV3Schema"])
+	}
+	rootProperties, ok := openAPI["properties"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("controller-gen root properties have unexpected type %T", openAPI["properties"])
+	}
+	specSchema, ok := rootProperties["spec"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("controller-gen spec schema has unexpected type %T", rootProperties["spec"])
+	}
+	specProperties, ok := specSchema["properties"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("controller-gen spec properties have unexpected type %T", specSchema["properties"])
+	}
+
+	assertPartialResponseStrategyField(t, path, specProperties)
+}
+
+func TestServiceLevelObjectiveYAMLAcceptsPartialResponseStrategy(t *testing.T) {
+	data := []byte(`
+apiVersion: pyrra.dev/v1alpha1
+kind: ServiceLevelObjective
+metadata:
+  name: http-errors
+  namespace: monitoring
+spec:
+  target: 99
+  window: 1w
+  partial_response_strategy: warn
+  indicator:
+    ratio:
+      errors:
+        metric: http_requests_total{job="app",status=~"5.."}
+      total:
+        metric: http_requests_total{job="app"}
+`)
+
+	var objective v1alpha1.ServiceLevelObjective
+	if err := yaml.UnmarshalStrict(data, &objective); err != nil {
+		t.Fatalf("unmarshal ServiceLevelObjective with partial_response_strategy: %v", err)
+	}
+
+	encoded, err := json.Marshal(objective)
+	if err != nil {
+		t.Fatalf("marshal ServiceLevelObjective with partial_response_strategy: %v", err)
+	}
+	var got map[string]interface{}
+	if err := json.Unmarshal(encoded, &got); err != nil {
+		t.Fatalf("unmarshal encoded ServiceLevelObjective: %v", err)
+	}
+	spec, ok := got["spec"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("encoded ServiceLevelObjective spec has unexpected type %T", got["spec"])
+	}
+	if got := spec["partial_response_strategy"]; got != "warn" {
+		t.Fatalf("encoded spec.partial_response_strategy = %q, want warn", got)
+	}
+}
