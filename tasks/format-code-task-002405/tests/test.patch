+++ b/mimo_test_command.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+
+
+
+case "${1:-}" in
+  base)
+    go test ./kubernetes/api/v1alpha1 -run 'TestServiceLevelObjective_(Internal|Validate)$' -count=1 -v
+    ;;
+  new)
+    go test ./kubernetes/api/v1alpha1 -run 'TestServiceLevelObjective.*PartialResponseStrategy' -count=1 -v
+    go test ./kubernetes/controllers -run 'TestMake(PrometheusRule|ConfigMap)PropagatesPartialResponseStrategyToAllGroups$' -count=1 -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
