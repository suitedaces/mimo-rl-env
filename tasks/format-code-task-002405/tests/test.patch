+
+func httpSLOWithPartialResponseStrategy(t *testing.T, strategy string) pyrrav1alpha1.ServiceLevelObjective {
+	t.Helper()
+
+	data := fmt.Sprintf(`
+apiVersion: pyrra.dev/v1alpha1
+kind: ServiceLevelObjective
+metadata:
+  name: http
+  uid: "123"
+  labels:
+    pyrra.dev/team: foo
+    team: bar
+  annotations:
+    pyrra.dev/description: foo
+    description: bar
+spec:
+  target: 99.5
+  window: 28d
+  partial_response_strategy: %s
+  indicator:
+    ratio:
+      errors:
+        metric: http_requests_total{job="app",status=~"5.."}
+      total:
+        metric: http_requests_total{job="app"}
+`, strategy)
+
+	var objective pyrrav1alpha1.ServiceLevelObjective
+	if err := yaml.Unmarshal([]byte(data), &objective); err != nil {
+		t.Fatalf("unmarshal ServiceLevelObjective fixture: %v", err)
+	}
+
+	return objective
+}
+
+func TestMakePrometheusRulePropagatesPartialResponseStrategyToAllGroups(t *testing.T) {
+	for _, strategy := range []string{"warn", "abort"} {
+		t.Run(strategy, func(t *testing.T) {
+			objective := httpSLOWithPartialResponseStrategy(t, strategy)
+			rule, err := makePrometheusRule(objective, false)
+			require.NoError(t, err)
+			require.NotEmpty(t, rule.Spec.Groups)
+
+			for i, group := range rule.Spec.Groups {
+				if group.PartialResponseStrategy != strategy {
+					t.Fatalf("group %d partial response strategy = %q, want %q", i, group.PartialResponseStrategy, strategy)
+				}
+			}
+		})
+	}
+}
+
+func TestMakeConfigMapPropagatesPartialResponseStrategyToAllGroups(t *testing.T) {
+	for _, strategy := range []string{"warn", "abort"} {
+		t.Run(strategy, func(t *testing.T) {
+			objective := httpSLOWithPartialResponseStrategy(t, strategy)
+			configMap, err := makeConfigMap("test", objective, false)
+			require.NoError(t, err)
+
+			rulesYAML := generatedRulesYAML(t, configMap.Data)
+			var rules struct {
+				Groups []struct {
+					PartialResponseStrategy string `yaml:"partial_response_strategy"`
+				} `yaml:"groups"`
+			}
+			if err := yamlv3.Unmarshal([]byte(rulesYAML), &rules); err != nil {
+				t.Fatalf("unmarshal generated rules YAML: %v\n%s", err, rulesYAML)
+			}
+			require.NotEmpty(t, rules.Groups)
+
+			for i, group := range rules.Groups {
+				if group.PartialResponseStrategy != strategy {
+					t.Fatalf("group %d partial response strategy = %q, want %q\n%s", i, group.PartialResponseStrategy, strategy, rulesYAML)
+				}
+			}
+		})
+	}
+}
+
+func generatedRulesYAML(t *testing.T, data map[string]string) string {
+	t.Helper()
+
+	for key, value := range data {
+		if strings.Contains(value, "groups:") {
+			return value
+		}
+		if strings.Contains(key, "rule") || strings.Contains(key, "slo") {
+			return value
+		}
+	}
+
+	t.Fatalf("ConfigMap data does not contain generated rules YAML: keys=%v", mapKeys(data))
+	return ""
+}
+
+func mapKeys(values map[string]string) []string {
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		keys = append(keys, key)
+	}
+	return keys
+}
