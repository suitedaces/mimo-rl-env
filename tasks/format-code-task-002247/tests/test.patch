+package usercase_test_coderl
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"testing"
+
+	"pault.ag/go/debian/dependency"
+	"pault.ag/go/debian/version"
+)
+
+
+
+
+
+
+func concrete(name string) dependency.Possibility {
+	return dependency.Possibility{
+		Name:          name,
+		Architectures: &dependency.ArchSet{Architectures: []dependency.Arch{}},
+		StageSets:     []dependency.StageSet{},
+	}
+}
+
+func restricted(name string, not bool, arches ...dependency.Arch) dependency.Possibility {
+	return dependency.Possibility{
+		Name: name,
+		Architectures: &dependency.ArchSet{
+			Not:           not,
+			Architectures: append([]dependency.Arch{}, arches...),
+		},
+		StageSets: []dependency.StageSet{},
+	}
+}
+
+func substvar(name string) dependency.Possibility {
+	return dependency.Possibility{Name: name, Substvar: true}
+}
+
+func amd64() dependency.Arch {
+	return dependency.Arch{ABI: "base", Libc: "gnu", OS: "linux", CPU: "amd64"}
+}
+
+func sparc() dependency.Arch {
+	return dependency.Arch{ABI: "base", Libc: "gnu", OS: "linux", CPU: "sparc"}
+}
+
+func arm64() dependency.Arch {
+	return dependency.Arch{ABI: "base", Libc: "gnu", OS: "linux", CPU: "arm64"}
+}
+
+func native() dependency.Arch {
+	return dependency.Arch{ABI: "base", Libc: "gnu", OS: "linux", CPU: "native"}
+}
+
+func mustVersion(t *testing.T, input string) version.Version {
+	t.Helper()
+	v, err := version.Parse(input)
+	if err != nil {
+		t.Fatalf("version.Parse(%q): %v", input, err)
+	}
+	return v
+}
+
+func assertPossibilities(t *testing.T, actual, expected []dependency.Possibility) {
+	t.Helper()
+
+
+
+	normalizedActual := normalizePossibilities(actual)
+	normalizedExpected := normalizePossibilities(expected)
+	if !reflect.DeepEqual(normalizedActual, normalizedExpected) {
+		t.Fatalf("possibilities mismatch\nactual:   %#v\nexpected: %#v", normalizedActual, normalizedExpected)
+	}
+}
+
+func normalizePossibilities(possibilities []dependency.Possibility) []dependency.Possibility {
+	out := make([]dependency.Possibility, len(possibilities))
+	for i, possibility := range possibilities {
+		out[i] = normalizePossibility(possibility)
+	}
+	return out
+}
+
+func normalizePossibility(possibility dependency.Possibility) dependency.Possibility {
+	out := possibility
+	if out.Architectures == nil {
+		out.Architectures = &dependency.ArchSet{Architectures: []dependency.Arch{}}
+	} else {
+		architectures := append([]dependency.Arch{}, out.Architectures.Architectures...)
+		out.Architectures = &dependency.ArchSet{
+			Not:           out.Architectures.Not,
+			Architectures: architectures,
+		}
+	}
+	out.StageSets = normalizeStageSets(out.StageSets)
+	return out
+}
+
+func normalizeStageSets(stageSets []dependency.StageSet) []dependency.StageSet {
+	out := make([]dependency.StageSet, len(stageSets))
+	for i, stageSet := range stageSets {
+		out[i].Stages = append([]dependency.Stage{}, stageSet.Stages...)
+	}
+	return out
+}
+
+func relation(possibilities ...dependency.Possibility) dependency.Relation {
+	return dependency.Relation{Possibilities: possibilities}
+}
+
+func cloneDependency(dep *dependency.Dependency) dependency.Dependency {
+	out := dependency.Dependency{
+		Relations: make([]dependency.Relation, len(dep.Relations)),
+	}
+	for i, relation := range dep.Relations {
+		out.Relations[i].Possibilities = make([]dependency.Possibility, len(relation.Possibilities))
+		for j, possibility := range relation.Possibilities {
+			out.Relations[i].Possibilities[j] = clonePossibility(possibility)
+		}
+	}
+	return out
+}
+
+func clonePossibility(possibility dependency.Possibility) dependency.Possibility {
+	out := possibility
+	if possibility.Arch != nil {
+		arch := *possibility.Arch
+		out.Arch = &arch
+	}
+	if possibility.Architectures != nil {
+		out.Architectures = &dependency.ArchSet{
+			Not:           possibility.Architectures.Not,
+			Architectures: append([]dependency.Arch{}, possibility.Architectures.Architectures...),
+		}
+	}
+	if possibility.Version != nil {
+		versionRelation := *possibility.Version
+		out.Version = &versionRelation
+	}
+	if possibility.StageSets != nil {
+		out.StageSets = make([]dependency.StageSet, len(possibility.StageSets))
+		for i, stageSet := range possibility.StageSets {
+			out.StageSets[i].Stages = append([]dependency.Stage{}, stageSet.Stages...)
+		}
+	}
+	return out
+}
+
+func snapshotDir(t *testing.T, dir string) []string {
+	t.Helper()
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatalf("ReadDir(%q): %v", dir, err)
+	}
+	out := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		out = append(out, entry.Name())
+	}
+	sort.Strings(out)
+	return out
+}
