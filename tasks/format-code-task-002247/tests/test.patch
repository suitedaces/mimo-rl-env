+func TestGetAllPossibilitiesPreservesConcretePossibilityMetadata(t *testing.T) {
+
+
+	dep := &dependency.Dependency{
+		Relations: []dependency.Relation{
+			relation(dependency.Possibility{
+				Name: "libfoo",
+				Arch: &dependency.Arch{ABI: "any", Libc: "any", OS: "any", CPU: "any"},
+				Architectures: &dependency.ArchSet{
+					Architectures: []dependency.Arch{
+						{ABI: "base", Libc: "gnu", OS: "linux", CPU: "amd64"},
+					},
+				},
+				StageSets: []dependency.StageSet{
+					{Stages: []dependency.Stage{{Name: "stage1"}}},
+				},
+				Version: &dependency.VersionRelation{Operator: ">=", Number: "1.2"},
+			}),
+			relation(dependency.Possibility{
+				Name:          "libbar",
+				Arch:          &dependency.Arch{ABI: "base", Libc: "gnu", OS: "linux", CPU: "native"},
+				Architectures: &dependency.ArchSet{Architectures: []dependency.Arch{}},
+				StageSets:     []dependency.StageSet{},
+				Version:       &dependency.VersionRelation{Operator: "<<", Number: "2.0"},
+			}, substvar("alt:Depends")),
+		},
+	}
+
+	actual := dep.GetAllPossibilities()
+
+	expected := []dependency.Possibility{
+		{
+			Name: "libfoo",
+			Arch: &dependency.Arch{ABI: "any", Libc: "any", OS: "any", CPU: "any"},
+			Architectures: &dependency.ArchSet{
+				Architectures: []dependency.Arch{
+					{ABI: "base", Libc: "gnu", OS: "linux", CPU: "amd64"},
+				},
+			},
+			StageSets: []dependency.StageSet{
+				{Stages: []dependency.Stage{{Name: "stage1"}}},
+			},
+			Version: &dependency.VersionRelation{Operator: ">=", Number: "1.2"},
+		},
+		{
+			Name:          "libbar",
+			Arch:          &dependency.Arch{ABI: "base", Libc: "gnu", OS: "linux", CPU: "native"},
+			Architectures: &dependency.ArchSet{Architectures: []dependency.Arch{}},
+			StageSets:     []dependency.StageSet{},
+			Version:       &dependency.VersionRelation{Operator: "<<", Number: "2.0"},
+		},
