+func TestVersionRelationEqualIsSatisfiedOnlyByExactVersion(t *testing.T) {
+
+
+	relation := dependency.VersionRelation{Operator: "=", Number: "1.0.0"}
+
+	actualExact := relation.SatisfiedBy(mustVersion(t, "1.0.0"))
+	actualDifferent := relation.SatisfiedBy(mustVersion(t, "1.0.1"))
+
+	if actualExact != true {
+		t.Fatalf("exact version result = %v, expected true", actualExact)
+	}
+	if actualDifferent != false {
+		t.Fatalf("different version result = %v, expected false", actualDifferent)
+	}
+}
+
+func TestVersionRelationStrictlyEarlierUsesDebianOrdering(t *testing.T) {
+
+
+	relation := dependency.VersionRelation{Operator: "<<", Number: "2.0"}
+
+	actualEarlier := relation.SatisfiedBy(mustVersion(t, "1.0"))
+	actualLater := relation.SatisfiedBy(mustVersion(t, "3.0"))
+
+	if actualEarlier != true {
+		t.Fatalf("earlier version result = %v, expected true", actualEarlier)
+	}
+	if actualLater != false {
+		t.Fatalf("later version result = %v, expected false", actualLater)
+	}
+}
+
+func TestVersionRelationStrictlyLaterUsesDebianOrdering(t *testing.T) {
+
+
+	relation := dependency.VersionRelation{Operator: ">>", Number: "2.0"}
+
+	actualLater := relation.SatisfiedBy(mustVersion(t, "3.0"))
+	actualEarlier := relation.SatisfiedBy(mustVersion(t, "1.0"))
+
+	if actualLater != true {
+		t.Fatalf("later version result = %v, expected true", actualLater)
+	}
+	if actualEarlier != false {
+		t.Fatalf("earlier version result = %v, expected false", actualEarlier)
+	}
+}
+
+func TestVersionRelationGreaterOrEqualHonorsTildeBoundary(t *testing.T) {
+
+
+	relation := dependency.VersionRelation{Operator: ">=", Number: "1.0~"}
+
+	actualOnePointZero := relation.SatisfiedBy(mustVersion(t, "1.0"))
+	actualBefore := relation.SatisfiedBy(mustVersion(t, "0.9"))
+
+	if actualOnePointZero != true {
+		t.Fatalf("1.0 result = %v, expected true", actualOnePointZero)
+	}
+	if actualBefore != false {
+		t.Fatalf("0.9 result = %v, expected false", actualBefore)
+	}
+}
+
+func TestVersionRelationLessOrEqualIncludesExactTildeBoundary(t *testing.T) {
+
+
+	relation := dependency.VersionRelation{Operator: "<=", Number: "1.0~"}
+
+	actualExact := relation.SatisfiedBy(mustVersion(t, "1.0~"))
+	actualLater := relation.SatisfiedBy(mustVersion(t, "1.0"))
+
+	if actualExact != true {
+		t.Fatalf("exact tilde result = %v, expected true", actualExact)
+	}
+	if actualLater != false {
+		t.Fatalf("later version result = %v, expected false", actualLater)
+	}
+}
+
+func TestVersionRelationInvalidRelationReturnsFalse(t *testing.T) {
+
+
+	unknownOperator := dependency.VersionRelation{Operator: "???", Number: "1.0"}
+	invalidNumber := dependency.VersionRelation{Operator: ">=", Number: "not-a-version"}
+
+	actualUnknown := unknownOperator.SatisfiedBy(mustVersion(t, "1.0"))
+	actualInvalidNumber := invalidNumber.SatisfiedBy(mustVersion(t, "1.0"))
+
+	if actualUnknown != false {
+		t.Fatalf("unknown operator result = %v, expected false", actualUnknown)
+	}
+	if actualInvalidNumber != false {
+		t.Fatalf("invalid number result = %v, expected false", actualInvalidNumber)
+	}
+}
+
+func TestHelpersAreReferentiallyTransparentForSameInputs(t *testing.T) {
+	dep := &dependency.Dependency{
+		Relations: []dependency.Relation{
+			relation(restricted("bar", false, sparc()), concrete("baz")),
+		},
+	}
+	arch := amd64()
+	vr := dependency.VersionRelation{Operator: ">=", Number: "1.0~"}
+	ver := mustVersion(t, "1.0")
+
+	if !reflect.DeepEqual(dep.GetPossibilities(arch), dep.GetPossibilities(arch)) {
+		t.Fatalf("GetPossibilities returned different values for the same input")
+	}
+	if !reflect.DeepEqual(dep.GetAllPossibilities(), dep.GetAllPossibilities()) {
+		t.Fatalf("GetAllPossibilities returned different values for the same input")
+	}
+	if !reflect.DeepEqual(dep.GetSubstvars(), dep.GetSubstvars()) {
+		t.Fatalf("GetSubstvars returned different values for the same input")
+	}
+	if vr.SatisfiedBy(ver) != vr.SatisfiedBy(ver) {
+		t.Fatalf("SatisfiedBy returned different values for the same input")
+	}
+}
+
+func TestHelpersDoNotMutateReceiversOrArguments(t *testing.T) {
+	dep := &dependency.Dependency{
+		Relations: []dependency.Relation{
+			relation(substvar("foo:Depends"), concrete("alpha")),
+			relation(restricted("beta", false, arm64()), restricted("gamma", true, sparc())),
+		},
+	}
+	arch := amd64()
+	vr := dependency.VersionRelation{Operator: ">=", Number: "1.0~"}
+	ver := mustVersion(t, "1.0")
+
+	beforeDep := cloneDependency(dep)
+	beforeArch := arch
+	beforeVR := vr
+	beforeVer := ver
+
+	_ = dep.GetPossibilities(arch)
+	_ = dep.GetAllPossibilities()
+	_ = dep.GetSubstvars()
+	_ = vr.SatisfiedBy(ver)
+
+	afterDep := *dep
+	if !reflect.DeepEqual(afterDep, beforeDep) {
+		t.Fatalf("dependency receiver mutated\nafter:  %#v\nbefore: %#v", afterDep, beforeDep)
+	}
+	if !reflect.DeepEqual(arch, beforeArch) {
+		t.Fatalf("arch argument mutated: after %#v before %#v", arch, beforeArch)
+	}
+	if !reflect.DeepEqual(vr, beforeVR) {
+		t.Fatalf("version relation receiver mutated: after %#v before %#v", vr, beforeVR)
+	}
+	if !reflect.DeepEqual(ver, beforeVer) {
+		t.Fatalf("version argument mutated: after %#v before %#v", ver, beforeVer)
+	}
+}
+
+func TestHelpersDoNotDependOnCallOrderGlobalState(t *testing.T) {
+	dep := &dependency.Dependency{
+		Relations: []dependency.Relation{
+			relation(restricted("bar", false, sparc()), concrete("baz")),
+			relation(restricted("delta", true, arm64()), concrete("epsilon")),
+		},
+	}
+	arch := amd64()
+	vr := dependency.VersionRelation{Operator: "<<", Number: "2.0"}
+	ver := mustVersion(t, "1.0")
+
+	firstPossibilities := dep.GetPossibilities(arch)
+	firstAll := dep.GetAllPossibilities()
+	firstSubstvars := dep.GetSubstvars()
+	firstSatisfied := vr.SatisfiedBy(ver)
+
+	noiseDep := &dependency.Dependency{
+		Relations: []dependency.Relation{
+			relation(concrete("noise-one"), concrete("noise-two")),
+			relation(substvar("noise:Depends"), concrete("noise-three")),
+		},
+	}
+	_ = noiseDep.GetPossibilities(native())
+	_ = noiseDep.GetAllPossibilities()
+	_ = noiseDep.GetSubstvars()
+	_ = (dependency.VersionRelation{Operator: "=", Number: "3.0"}).SatisfiedBy(mustVersion(t, "3.0"))
+
+	assertPossibilities(t, dep.GetPossibilities(arch), firstPossibilities)
+	assertPossibilities(t, dep.GetAllPossibilities(), firstAll)
+	assertPossibilities(t, dep.GetSubstvars(), firstSubstvars)
+	if vr.SatisfiedBy(ver) != firstSatisfied {
+		t.Fatalf("SatisfiedBy changed after unrelated calls")
+	}
+}
+
+func TestHelpersDoNotCreateRelativeFilesystemSideEffects(t *testing.T) {
+	tmp := t.TempDir()
+	originalCWD, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd: %v", err)
+	}
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatalf("Chdir(%q): %v", tmp, err)
+	}
+	t.Cleanup(func() {
+		_ = os.Chdir(originalCWD)
+	})
+
+	before := snapshotDir(t, tmp)
+	dep := &dependency.Dependency{
+		Relations: []dependency.Relation{
+			relation(substvar("foo:Depends"), concrete("alpha")),
+			relation(restricted("beta", false, arm64()), concrete("gamma")),
+		},
+	}
+
+	_ = dep.GetPossibilities(amd64())
+	_ = dep.GetAllPossibilities()
+	_ = dep.GetSubstvars()
+	_ = (dependency.VersionRelation{Operator: ">=", Number: "1.0~"}).SatisfiedBy(mustVersion(t, "1.0"))
+
+	after := snapshotDir(t, tmp)
+	if !reflect.DeepEqual(after, before) {
+		t.Fatalf("relative filesystem entries changed in %s: before=%v after=%v", filepath.Clean(tmp), before, after)
+	}
+}
