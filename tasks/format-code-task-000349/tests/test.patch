+#!/usr/bin/env python3
+import hashlib
+import http.server
+import json
+import socketserver
+import sys
+
+
+MODE = sys.argv[1]
+LOG_PATH = sys.argv[2]
+
+
+LINUX_MANIFEST = json.dumps(
+    {
+        "schemaVersion": 2,
+        "mediaType": "application/vnd.docker.distribution.manifest.v2+json",
+        "config": {
+            "mediaType": "application/vnd.docker.container.image.v1+json",
+            "size": 2,
+            "digest": "sha256:" + "1" * 64,
+        },
+        "layers": [],
+    },
+    separators=(",", ":"),
+).encode()
+
+WINDOWS_MANIFEST = json.dumps(
+    {
+        "schemaVersion": 2,
+        "mediaType": "application/vnd.docker.distribution.manifest.v2+json",
+        "config": {
+            "mediaType": "application/vnd.docker.container.image.v1+json",
+            "size": 2,
+            "digest": "sha256:" + "2" * 64,
+        },
+        "layers": [],
+    },
+    separators=(",", ":"),
+).encode()
+
+LINUX_DIGEST = "sha256:" + hashlib.sha256(LINUX_MANIFEST).hexdigest()
+WINDOWS_DIGEST = "sha256:" + hashlib.sha256(WINDOWS_MANIFEST).hexdigest()
+
+MANIFEST_LIST = json.dumps(
+    {
+        "schemaVersion": 2,
+        "mediaType": "application/vnd.docker.distribution.manifest.list.v2+json",
+        "manifests": [
+            {
+                "mediaType": "application/vnd.docker.distribution.manifest.v2+json",
+                "size": len(LINUX_MANIFEST),
+                "digest": LINUX_DIGEST,
+                "platform": {"architecture": "amd64", "os": "linux"},
+            },
+            {
+                "mediaType": "application/vnd.docker.distribution.manifest.v2+json",
+                "size": len(WINDOWS_MANIFEST),
+                "digest": WINDOWS_DIGEST,
+                "platform": {"architecture": "arm64", "os": "windows"},
+            },
+        ],
+    },
+    separators=(",", ":"),
+).encode()
+
+
+class Handler(http.server.BaseHTTPRequestHandler):
+    def log_message(self, fmt, *args):
+        pass
+
+    def record(self):
+        with open(LOG_PATH, "a", encoding="utf-8") as f:
+            f.write(
+                f"{self.command} {self.path} AUTH={self.headers.get('Authorization')}\n"
+            )
+
+    def do_GET(self):
+        self.record()
+        if MODE == "auth401":
+            self.send_response(401)
+            self.send_header("WWW-Authenticate", 'Basic realm="mock"')
+            self.end_headers()
+            return
+
+        if self.path in {"/v2/", "/v2"}:
+            self.send_response(200)
+            self.end_headers()
+            return
+
+        if self.path.endswith("/manifests/v1"):
+            self.send_body(
+                MANIFEST_LIST,
+                "application/vnd.docker.distribution.manifest.list.v2+json",
+            )
+            return
+        if self.path.endswith("/manifests/" + LINUX_DIGEST):
+            self.send_body(
+                LINUX_MANIFEST,
+                "application/vnd.docker.distribution.manifest.v2+json",
+            )
+            return
+        if self.path.endswith("/manifests/" + WINDOWS_DIGEST):
+            self.send_body(
+                WINDOWS_MANIFEST,
+                "application/vnd.docker.distribution.manifest.v2+json",
+            )
+            return
+        if "/blobs/" in self.path:
+            self.send_body(b"{}", "application/octet-stream")
+            return
+
+        self.send_response(404)
+        self.end_headers()
+
+    def do_HEAD(self):
+
+        self.record()
+        self.send_response(404)
+        self.end_headers()
+
+    def do_POST(self):
+
+        self.record()
+        self.send_response(202)
+        self.send_header("Location", self.path.rstrip("/") + "/localb-upload")
+        self.send_header("Docker-Upload-UUID", "localb-upload")
+        self.send_header("Range", "0-0")
+        self.end_headers()
+
+    def do_PATCH(self):
+
+        self.record()
+        length = int(self.headers.get("Content-Length", "0"))
+        if length:
+            self.rfile.read(length)
+        self.send_response(202)
+        self.send_header("Location", self.path)
+        self.send_header("Docker-Upload-UUID", "localb-upload")
+        self.send_header("Range", "0-0")
+        self.end_headers()
+
+    def do_PUT(self):
+        self.record()
+        length = int(self.headers.get("Content-Length", "0"))
+        if length:
+            self.rfile.read(length)
+        self.send_response(201)
+        self.end_headers()
+
+    def send_body(self, body, media_type):
+        self.send_response(200)
+        self.send_header("Content-Type", media_type)
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+
+class ReusableTCPServer(socketserver.TCPServer):
+    allow_reuse_address = True
+
+
+with ReusableTCPServer(("127.0.0.1", 0), Handler) as httpd:
+    print(httpd.server_address[1], flush=True)
+    httpd.serve_forever()
