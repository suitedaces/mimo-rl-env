+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+if [ ! -x /testbed/.venv/bin/python ]; then
+  python3 -m venv /testbed/.venv
+fi
+
+set +u
+source /testbed/.venv/bin/activate
+set -u
+
+
+if ! python - <<'PY' >/dev/null 2>&1
+import hera
+import pytest
+import yaml
+PY
+then
+  python -m pip install --upgrade pip setuptools wheel
+  python -m pip install -e ".[yaml]" pytest jsonpath-ng
+fi
+
+case "${1:-}" in
+  base)
+    python -m pytest tests/test_hooks.py -q -o "addopts="
+    ;;
+  new)
+    python -m pytest tests/test_async_workflow_context_isolation.py -v -o "addopts="
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
