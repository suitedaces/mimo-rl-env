--- /dev/null
+++ b/src/js/plugin-bridge/__tests__/PluginModules-test.js
@@ -0,0 +1,24 @@
+jest.dontMock('../PluginModules');
+jest.dontMock('../../stores/BaseStore');
+
+var PluginModules = require('../PluginModules');
+
+describe('PluginModules', function () {
+  it('exposes BaseStore through the plugin stores registry', function () {
+    expect(PluginModules.stores.BaseStore).toEqual('BaseStore');
+  });
+
+  it('resolves BaseStore to the lean listener-only store base', function () {
+    var ResolvedBaseStore = require('../../stores/' + PluginModules.stores.BaseStore);
+    var instance = new ResolvedBaseStore();
+    var handler = jasmine.createSpy('pluginStoreHandler');
+
+    expect(typeof instance.get).not.toEqual('function');
+    expect(typeof instance.set).not.toEqual('function');
+
+    instance.addChangeListener('plugin-change', handler);
+    instance.emit('plugin-change', {source: 'plugin'});
+
+    expect(handler).toHaveBeenCalledWith({source: 'plugin'});
+  });
+});
