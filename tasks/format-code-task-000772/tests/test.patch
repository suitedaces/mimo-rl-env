diff --git a/src/js/stores/__tests__/StoreBaseCompatibility-test.js b/src/js/stores/__tests__/StoreBaseCompatibility-test.js
new file mode 100644
index 000000000..6ac1f18cb
--- /dev/null
+++ b/src/js/stores/__tests__/StoreBaseCompatibility-test.js
@@ -0,0 +1,115 @@
+var EventTypes = require('../../constants/EventTypes');
+
+jest.dontMock('../AuthStore');
+jest.dontMock('../ConfigStore');
+jest.dontMock('../CosmosPackagesStore');
+jest.dontMock('../HistoryStore');
+jest.dontMock('../MarathonStore');
+jest.dontMock('../MesosLogStore');
+jest.dontMock('../MesosStateStore');
+jest.dontMock('../MesosSummaryStore');
+jest.dontMock('../MetadataStore');
+jest.dontMock('../NodeHealthStore');
+jest.dontMock('../NotificationStore');
+jest.dontMock('../SidebarStore');
+jest.dontMock('../TaskDirectoryStore');
+jest.dontMock('../UnitHealthStore');
+jest.dontMock('../UsersStore');
+jest.dontMock('../VisibilityStore');
+jest.dontMock('../BaseStore');
+
+var dispatchSpy = jasmine.createSpy('dispatch');
+
+jest.setMock('PluginSDK', {
+  dispatch: dispatchSpy,
+  Hooks: {
+    applyFilter: function (name, value) {
+      return value;
+    }
+  }
+});
+
+var statefulStoreModules = [
+  ['AuthStore', '../AuthStore'],
+  ['ConfigStore', '../ConfigStore'],
+  ['CosmosPackagesStore', '../CosmosPackagesStore'],
+  ['HistoryStore', '../HistoryStore'],
+  ['MarathonStore', '../MarathonStore'],
+  ['MesosLogStore', '../MesosLogStore'],
+  ['MesosStateStore', '../MesosStateStore'],
+  ['MesosSummaryStore', '../MesosSummaryStore'],
+  ['MetadataStore', '../MetadataStore'],
+  ['NodeHealthStore', '../NodeHealthStore'],
+  ['NotificationStore', '../NotificationStore'],
+  ['SidebarStore', '../SidebarStore'],
+  ['TaskDirectoryStore', '../TaskDirectoryStore'],
+  ['UnitHealthStore', '../UnitHealthStore'],
+  ['UsersStore', '../UsersStore'],
+  ['VisibilityStore', '../VisibilityStore']
+];
+
+function getStoreInstance(modulePath) {
+  var StoreModule = require(modulePath);
+
+  if (typeof StoreModule === 'function') {
+    return new StoreModule();
+  }
+
+  return StoreModule;
+}
+
+describe('existing stateful stores', function () {
+  it('preserves get/set behavior for existing stateful stores', function () {
+    statefulStoreModules.forEach(function (storeEntry, index) {
+      var storeName = storeEntry[0];
+      var store = getStoreInstance(storeEntry[1]);
+      var keyToOverride = 'phase3_' + index + '_override';
+      var keyToKeep = 'phase3_' + index + '_keep';
+
+      expect(typeof store.get).toEqual('function');
+      expect(typeof store.set).toEqual('function');
+
+      store.set({
+        [keyToOverride]: storeName + '_initial',
+        [keyToKeep]: storeName + '_kept'
+      });
+      store.set({
+        [keyToOverride]: storeName + '_updated'
+      });
+
+      expect(store.get(keyToOverride)).toEqual(storeName + '_updated');
+      expect(store.get(keyToKeep)).toEqual(storeName + '_kept');
+    });
+  });
+
+  it('rejects invalid updates on existing stateful stores', function () {
+    statefulStoreModules.forEach(function (storeEntry) {
+      var store = getStoreInstance(storeEntry[1]);
+
+      expect(store.set.bind(store, 'not an object')).toThrow();
+      expect(store.set.bind(store, [])).toThrow();
+    });
+  });
+
+  it('dispatches app-store changes with updated data', function () {
+    statefulStoreModules.forEach(function (storeEntry, index) {
+      var storeName = storeEntry[0];
+      var store = getStoreInstance(storeEntry[1]);
+      var key = 'phase3_dispatch_' + index;
+
+      dispatchSpy.calls.reset();
+      store.set({
+        [key]: storeName + '_value'
+      });
+
+      expect(dispatchSpy).toHaveBeenCalled();
+      expect(dispatchSpy.calls.mostRecent().args[0]).toEqual(jasmine.objectContaining({
+        type: EventTypes.APP_STORE_CHANGE,
+        storeID: store.storeID,
+        data: jasmine.objectContaining({
+          [key]: storeName + '_value'
+        })
+      }));
+    });
+  });
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,34 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+if [ ! -d node_modules ]; then
+  npm install
+fi
+
+
+cp webpack/proxy.template.js webpack/proxy.dev.js
+cp src/js/config/Config.template.js src/js/config/Config.dev.js
+
+
+node jest/gen-config.js
+
+
+run_jest() {
+  NODE_PATH=node_modules node_modules/.bin/jest --config=jest/config.json --no-cache --testPathPattern="$1"
+}
+
+case "${1:-}" in
+  base)
+    run_jest 'AuthStore-test\.js$|ChronosStore-test\.js$|CosmosPackagesStore-test\.js$|DCOSStore-test\.js$|HistoryStore-test\.js$|MarathonStore-test\.js$|MesosLogStore-test\.js$|MesosStateStore-test\.js$|MesosSummaryStore-test\.js$|NodeHealthStore-test\.js$|NotificationStore-test\.js$|UnitHealthStore-test\.js$|UserSettingsStore-test\.js$|UsersStore-test\.js$|UserStore-test\.js$|VisibilityStore-test\.js$|PluginSDK-test\.js$|AppReducer-test\.js$|ActionsPubSub-test\.js$|Hooks-test\.js$'
+    ;;
+  new)
+    run_jest 'BaseStore-test\.js$|PluginModules-test\.js$|StoreBaseCompatibility-test\.js$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
