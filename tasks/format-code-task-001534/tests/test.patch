diff --git a/usercase-test-coderl/dashboard_manager.test.js b/usercase-test-coderl/dashboard_manager.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/dashboard_manager.test.js
@@ -0,0 +1,516 @@
+/* eslint-env jest */
+
+
+
+
+
+
+
+import DashboardManager from '../client/src/services/analytics/DashboardManager';
+
+const START_WITH_TIME = new Date('2024-01-01T15:45:00.000Z');
+const END_WITH_TIME = new Date('2024-01-03T02:15:00.000Z');
+const START_OF_RANGE = new Date('2024-01-01T00:00:00.000Z');
+const END_OF_RANGE = new Date('2024-01-03T23:59:59.999Z');
+
+const PERIOD_DAYS = [
+  { date: new Date('2024-01-01T00:00:00.000Z'), label: '01/01' },
+  { date: new Date('2024-01-02T00:00:00.000Z'), label: '01/02' },
+  { date: new Date('2024-01-03T00:00:00.000Z'), label: '01/03' }
+];
+
+const TASKS = [
+  {
+    id: 'a',
+    completedAt: '2024-01-01T10:00:00.000Z',
+    experience: 100,
+    earlyBonus: 20,
+    overduePenalty: -10
+  },
+  {
+    id: 'b',
+    completedAt: '2024-01-02T10:00:00.000Z',
+    experience: 50
+  },
+  {
+    id: 'invalid',
+    completedAt: 'not-a-date',
+    experience: 999
+  },
+  {
+    id: 'missing',
+    experience: 250
+  },
+  {
+    id: 'negative',
+    completedAt: '2024-01-02T20:00:00.000Z',
+    experience: 5,
+    overduePenalty: -20
+  },
+  {
+    id: 'outside',
+    completedAt: '2024-01-04T10:00:00.000Z',
+    experience: 700
+  }
+];
+
+const cloneTasks = () => TASKS.map((task) => ({ ...task }));
+
+const expectChartDatasetCount = (chartData) => {
+  expect(chartData).toEqual(expect.any(Object));
+  expect(chartData.datasets).toHaveLength(1);
+};
+
+const expectChartLabels = (labels, expectedLength) => {
+
+  expect(labels).toHaveLength(expectedLength);
+  labels.forEach((label) => expect(label).toEqual(expect.any(String)));
+};
+
+const expectXPChartData = (chartData, expectedData, manager) => {
+  expectChartDatasetCount(chartData);
+  const [dataset] = chartData.datasets;
+
+  expectChartLabels(chartData.labels, expectedData.length);
+  expect(dataset).toEqual(
+    expect.objectContaining({
+      label: 'XP Gained',
+      data: expectedData,
+      fill: false
+    })
+  );
+
+
+  if (manager.CHART_COLORS?.primary) {
+    expect(dataset.borderColor).toBe(manager.CHART_COLORS.primary);
+    expect(dataset.pointBackgroundColor).toBe(manager.CHART_COLORS.primary);
+  } else {
+    expect(dataset.borderColor).toBeTruthy();
+    expect(dataset.pointBackgroundColor).toBe(dataset.borderColor);
+  }
+
+  if (manager.CHART_COLORS?.background) {
+    expect(dataset.backgroundColor).toBe(manager.CHART_COLORS.background);
+  } else {
+    expect(dataset.backgroundColor).toBeTruthy();
+  }
+};
+
+const expectTasksChartData = (chartData, expectedData, manager) => {
+  expectChartDatasetCount(chartData);
+  const [dataset] = chartData.datasets;
+
+  expectChartLabels(chartData.labels, expectedData.length);
+  expect(dataset).toEqual(
+    expect.objectContaining({
+      label: 'Tasks Completed',
+      data: expectedData
+    })
+  );
+
+
+  if (manager.CHART_COLORS?.background) {
+    expect(dataset.backgroundColor).toBe(manager.CHART_COLORS.background);
+  } else {
+    expect(dataset.backgroundColor).toBeTruthy();
+  }
+
+  if (manager.CHART_COLORS?.primary) {
+    expect(dataset.borderColor).toBe(manager.CHART_COLORS.primary);
+  } else {
+    expect(dataset.borderColor).toBeTruthy();
+  }
+};
+
+const expectEmptyChartData = (chartData) => {
+
+  expectChartDatasetCount(chartData);
+  expectChartLabels(chartData.labels, 0);
+  expect(chartData.datasets[0].data).toEqual([]);
+};
+
+const expectMetricsPresent = (metrics) => {
+
+  expect(metrics).toEqual(expect.any(Object));
+  expect(Object.keys(metrics).length).toBeGreaterThan(0);
+};
+
+const expectZeroActivityMetrics = (metrics, days) => {
+  expectMetricsPresent(metrics);
+
+
+  if (Object.prototype.hasOwnProperty.call(metrics, 'weeklyXP')) {
+    expect(metrics.weeklyXP).toBe(0);
+  }
+  if (Object.prototype.hasOwnProperty.call(metrics, 'trendPercentage')) {
+    expect(metrics.trendPercentage).toBe(0);
+  }
+  if (Object.prototype.hasOwnProperty.call(metrics, 'activeDays')) {
+    expect(metrics.activeDays).toBe(`0/${days}`);
+  }
+};
+
+const expectMapKeys = (map, expectedKeys) => {
+
+  expect(new Set(map.keys())).toEqual(new Set(expectedKeys));
+};
+
+const expectTaskIdsForDay = (map, dayKey, expectedIds) => {
+
+  const actualIds = (map.get(dayKey) || []).map((task) => task.id);
+  expect(new Set(actualIds)).toEqual(new Set(expectedIds));
+};
+
+describe('DashboardManager analytics session', () => {
+  test('aggregates completed tasks into chart-ready metrics for a normalized local-day range', () => {
+
+
+
+
+    const manager = new DashboardManager();
+
+    const result = manager.calculateMetricsOptimized(
+      TASKS,
+      START_WITH_TIME,
+      END_WITH_TIME
+    );
+
+
+    expect(result).toEqual(
+      expect.objectContaining({
+        xpData: expect.any(Object),
+        completedTasksData: expect.any(Object),
+        periodXP: expect.any(Number),
+        metrics: expect.any(Object)
+      })
+    );
+    expectXPChartData(result.xpData, [110, 50, 0], manager);
+    expectTasksChartData(result.completedTasksData, [1, 2, 0], manager);
+    expect(result.periodXP).toBe(160);
+    expectMetricsPresent(result.metrics);
+  });
+
+  test('returns empty chart data and zero-activity metrics for an empty task list', () => {
+
+
+
+
+    const manager = new DashboardManager();
+
+    const result = manager.calculateMetricsOptimized(
+      [],
+      START_WITH_TIME,
+      END_WITH_TIME
+    );
+
+
+    expect(result).toEqual(
+      expect.objectContaining({
+        xpData: expect.any(Object),
+        completedTasksData: expect.any(Object),
+        periodXP: expect.any(Number),
+        metrics: expect.any(Object)
+      })
+    );
+    expectXPChartData(result.xpData, [], manager);
+    expectEmptyChartData(result.completedTasksData);
+    expect(result.periodXP).toBe(0);
+    expectZeroActivityMetrics(result.metrics, 3);
+  });
+
+  test('serves repeated aggregations from the instance cache until clearCache is called', () => {
+
+
+
+
+    const manager = new DashboardManager();
+
+    const first = manager.calculateMetricsOptimized(
+      TASKS,
+      START_WITH_TIME,
+      END_WITH_TIME
+    );
+    const second = manager.calculateMetricsOptimized(
+      TASKS,
+      START_WITH_TIME,
+      END_WITH_TIME
+    );
+
+    expect(first).toBe(second);
+    expect(second.periodXP).toBe(160);
+
+    manager.clearCache();
+
+    const third = manager.calculateMetricsOptimized(
+      TASKS,
+      START_WITH_TIME,
+      END_WITH_TIME
+    );
+
+    expect(third).not.toBe(first);
+    expect(third.periodXP).toBe(160);
+  });
+
+  test('expires cached aggregation results after the cache timeout', () => {
+
+
+
+
+    const manager = new DashboardManager();
+    const nowSpy = jest.spyOn(Date, 'now');
+
+    try {
+      nowSpy.mockReturnValue(1000);
+      const first = manager.calculateMetricsOptimized(
+        TASKS,
+        START_WITH_TIME,
+        END_WITH_TIME
+      );
+      const cached = manager.calculateMetricsOptimized(
+        TASKS,
+        START_WITH_TIME,
+        END_WITH_TIME
+      );
+
+      expect(cached).toBe(first);
+
+
+      if (Number.isFinite(manager.cacheTimeout)) {
+        nowSpy.mockReturnValue(1000 + manager.cacheTimeout + 1);
+        const expired = manager.calculateMetricsOptimized(
+          TASKS,
+          START_WITH_TIME,
+          END_WITH_TIME
+        );
+
+        expect(expired).not.toBe(first);
+        expect(expired.periodXP).toBe(160);
+      }
+    } finally {
+      nowSpy.mockRestore();
+    }
+  });
+
+  test('processTasksBatched groups only valid in-range tasks by local-day timestamp', () => {
+
+
+
+
+    const manager = new DashboardManager();
+
+    const batches = manager.processTasksBatched(
+      TASKS,
+      START_OF_RANGE,
+      END_OF_RANGE
+    );
+
+    expect(batches).toBeInstanceOf(Map);
+    expectMapKeys(batches, [1704067200000, 1704153600000]);
+    expectTaskIdsForDay(batches, 1704067200000, ['a']);
+    expectTaskIdsForDay(batches, 1704153600000, ['b', 'negative']);
+  });
+
+  test('calculateXPDataFromBatches builds the XP Gained line dataset with floored daily XP totals', () => {
+
+
+
+
+    const manager = new DashboardManager();
+    const batches = new Map([
+      [
+        1704067200000,
+        [
+          {
+            completedAt: '2024-01-01T10:00:00.000Z',
+            experience: 100,
+            earlyBonus: 20,
+            overduePenalty: -10
+          }
+        ]
+      ],
+      [
+        1704153600000,
+        [
+          { completedAt: '2024-01-02T10:00:00.000Z', experience: 50 },
+          {
+            completedAt: '2024-01-02T20:00:00.000Z',
+            experience: 5,
+            overduePenalty: -20
+          }
+        ]
+      ]
+    ]);
+
+    expectXPChartData(
+      manager.calculateXPDataFromBatches(batches, PERIOD_DAYS),
+      [110, 50, 0],
+      manager
+    );
+  });
+
+  test('calculateTasksDataFromBatches builds daily completed-task counts', () => {
+
+
+
+
+    const manager = new DashboardManager();
+    const batches = new Map([
+      [1704067200000, [{ id: 'a' }]],
+      [1704153600000, [{ id: 'b' }, { id: 'negative' }]]
+    ]);
+
+    expectTasksChartData(
+      manager.calculateTasksDataFromBatches(batches, PERIOD_DAYS),
+      [1, 2, 0],
+      manager
+    );
+  });
+
+  test('calculatePeriodXPFromBatches sums XP across grouped tasks', () => {
+
+
+
+
+    const manager = new DashboardManager();
+    const batches = new Map([
+      [
+        1704067200000,
+        [{ experience: 100, earlyBonus: 20, overduePenalty: -10 }]
+      ],
+      [
+        1704153600000,
+        [
+          { experience: 50 },
+          { experience: 5, overduePenalty: -20 }
+        ]
+      ]
+    ]);
+
+    expect(manager.calculatePeriodXPFromBatches(batches)).toBe(160);
+  });
+
+  test('createEmptyChartData returns an empty XP Gained dataset using manager colors', () => {
+
+
+
+
+    const manager = new DashboardManager();
+
+    expectXPChartData(manager.createEmptyChartData(), [], manager);
+  });
+
+  test('processTasksBatched returns an empty Map when no tasks are provided', () => {
+
+
+
+
+    const manager = new DashboardManager();
+
+
+    const batches = manager.processTasksBatched([], START_OF_RANGE, END_OF_RANGE);
+    expect(batches).toBeInstanceOf(Map);
+    expect(batches.size).toBe(0);
+  });
+
+  test('clearCache is idempotent when called twice', () => {
+
+
+
+
+    const manager = new DashboardManager();
+
+    const first = manager.calculateMetricsOptimized(
+      TASKS,
+      START_WITH_TIME,
+      END_WITH_TIME
+    );
+
+    manager.clearCache();
+
+    manager.clearCache();
+    const afterDoubleClear = manager.calculateMetricsOptimized(
+      TASKS,
+      START_WITH_TIME,
+      END_WITH_TIME
+    );
+
+    expect(afterDoubleClear).not.toBe(first);
+    expect(afterDoubleClear.periodXP).toBe(160);
+  });
+
+  test('two managers keep independent cache state and analytics results', () => {
+
+
+
+
+    const a = new DashboardManager();
+    const b = new DashboardManager();
+
+    const aResult = a.calculateMetricsOptimized(
+      TASKS,
+      START_WITH_TIME,
+      END_WITH_TIME
+    );
+
+    expect(aResult.periodXP).toBe(160);
+
+    const bResult = b.calculateMetricsOptimized(
+      [
+        {
+          id: 'solo',
+          completedAt: '2024-01-03T12:00:00.000Z',
+          experience: 7
+        }
+      ],
+      START_WITH_TIME,
+      END_WITH_TIME
+    );
+
+    expect(bResult.xpData.datasets[0].data).toEqual([0, 0, 7]);
+    expect(bResult.completedTasksData.datasets[0].data).toEqual([0, 0, 1]);
+    expect(bResult.periodXP).toBe(7);
+    expect(
+      a.calculateMetricsOptimized(TASKS, START_WITH_TIME, END_WITH_TIME)
+    ).toBe(aResult);
+    expect(
+      b.calculateMetricsOptimized(
+        [
+          {
+            id: 'solo',
+            completedAt: '2024-01-03T12:00:00.000Z',
+            experience: 7
+          }
+        ],
+        START_WITH_TIME,
+        END_WITH_TIME
+      )
+    ).toBe(bResult);
+  });
+
+  test('repeated construct-use-clear cycles keep cached results from being reused', () => {
+
+
+
+
+    for (let index = 0; index < 100; index += 1) {
+      const manager = new DashboardManager();
+      const result = manager.calculateMetricsOptimized(
+        cloneTasks(),
+        START_WITH_TIME,
+        END_WITH_TIME
+      );
+
+      expect(result.periodXP).toBe(160);
+
+      manager.clearCache();
+      const afterClear = manager.calculateMetricsOptimized(
+        cloneTasks(),
+        START_WITH_TIME,
+        END_WITH_TIME
+      );
+
+      expect(afterClear).not.toBe(result);
+      expect(afterClear.periodXP).toBe(160);
+    }
+  });
+});
