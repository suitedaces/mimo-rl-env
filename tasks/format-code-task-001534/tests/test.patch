+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+JEST_BIN=/workspace/repo/client/node_modules/jest/bin/jest.js
+JEST_CLI_MAIN=/workspace/repo/client/node_modules/jest-cli/build/index.js
+JEST_CORE_CLI=/workspace/repo/client/node_modules/@jest/core/build/cli/index.js
+BABEL_TRANSFORM=/workspace/repo/client/node_modules/react-scripts/config/jest/babelTransform.js
+BABEL_JEST_MAIN=/workspace/repo/client/node_modules/babel-jest/build/index.js
+BABEL_PRESET_REACT_APP=/workspace/repo/client/node_modules/babel-preset-react-app/create.js
+
+if [ ! -f "$JEST_BIN" ] || [ ! -f "$JEST_CLI_MAIN" ] || [ ! -f "$JEST_CORE_CLI" ] || [ ! -f "$BABEL_TRANSFORM" ] || [ ! -f "$BABEL_JEST_MAIN" ] || [ ! -f "$BABEL_PRESET_REACT_APP" ]; then
+  echo "Required client test dependencies are missing from client/node_modules; refusing to install during offline test run." >&2
+  exit 127
+fi
+
+export CI=true
+export TZ=UTC
+
+exec node "$JEST_BIN" \
+  --runTestsByPath /workspace/repo/usercase-test-coderl/dashboard_manager.test.js \
+  --config '{"rootDir":"/workspace/repo/usercase-test-coderl","testEnvironment":"node","transform":{"^.+\\.(js|jsx|mjs|cjs)$":"/workspace/repo/client/node_modules/react-scripts/config/jest/babelTransform.js"},"moduleDirectories":["node_modules","/workspace/repo/client/node_modules"],"testMatch":["<rootDir>/**/*.test.js"]}' \
+  --runInBand
