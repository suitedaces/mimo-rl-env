@@ -0,0 +1,96 @@
+"use strict";
+
+const needlessDisables = require("../needlessDisables");
+const standalone = require("../standalone");
+const stripIndent = require("common-tags").stripIndent;
+
+
+
+
+
+function getUnusedRule(range) {
+  if (range.unusedRule !== undefined) return range.unusedRule;
+
+  return range.rule;
+}
+
+it("needlessDisables annotates each unused range with its unused rule (rule-specific disable)", () => {
+  const config = { rules: { "color-named": "never" } };
+
+  const css = stripIndent`
+    /* stylelint-disable color-named */
+    a {}
+    /* stylelint-enable */
+    `;
+
+  return standalone({ config, code: css, ignoreDisables: true }).then(
+    linted => {
+      const report = needlessDisables(linted.results);
+
+      expect(report).toHaveLength(1);
+      expect(report[0].ranges).toHaveLength(1);
+      expect(getUnusedRule(report[0].ranges[0])).toBe("color-named");
+      expect(report[0].ranges[0].start).toBe(1);
+      expect(report[0].ranges[0].end).toBe(3);
+    }
+  );
+});
+
+it("needlessDisables annotates a bare /* stylelint-disable */ range with unused rule 'all'", () => {
+  const config = { rules: { "block-no-empty": true } };
+
+  const css = stripIndent`
+    /* stylelint-disable */
+    a { color: pink; }
+    /* stylelint-enable */
+    `;
+
+  return standalone({ config, code: css, ignoreDisables: true }).then(
+    linted => {
+      const report = needlessDisables(linted.results);
+
+      expect(report).toHaveLength(1);
+      expect(report[0].ranges).toHaveLength(1);
+      expect(getUnusedRule(report[0].ranges[0])).toBe("all");
+    }
+  );
+});
+
+it("needlessDisables annotates multiple ranges each with the correct unused rule (differential)", () => {
+  const config = {
+    rules: {
+      "block-no-empty": true,
+      "color-named": "never"
+    }
+  };
+
+
+
+
+  const css = stripIndent`
+    /* stylelint-disable color-named */
+    a { width: 10px; }
+    /* stylelint-enable */
+    /* stylelint-disable block-no-empty */
+    a { width: 10px; }
+    /* stylelint-enable */
+    `;
+
+  return standalone({ config, code: css, ignoreDisables: true }).then(
+    linted => {
+      const report = needlessDisables(linted.results);
+
+      expect(report).toHaveLength(1);
+      const ranges = report[0].ranges;
+
+
+      const colorNamedRange = ranges.find(r => r.start === 1);
+      const blockNoEmptyRange = ranges.find(r => r.start === 4);
+
+      expect(colorNamedRange).toBeDefined();
+      expect(blockNoEmptyRange).toBeDefined();
+      expect(getUnusedRule(colorNamedRange)).toBe("color-named");
+      expect(getUnusedRule(blockNoEmptyRange)).toBe("block-no-empty");
+    }
+  );
+});
diff --git a/lib/formatters/__tests__/needlessDisablesStringFormatter-newFormat.test.js b/lib/formatters/__tests__/needlessDisablesStringFormatter-newFormat.test.js
new file mode 100644
index 000000000..5396a3c91
--- /dev/null
+++ b/lib/formatters/__tests__/needlessDisablesStringFormatter-newFormat.test.js
@@ -0,0 +1,157 @@
+"use strict";
+
+const needlessDisables = require("../../needlessDisables");
+const needlessDisablesStringFormatter = require("../needlessDisablesStringFormatter");
+const standalone = require("../../standalone");
+const stripAnsi = require("strip-ansi");
+const stripIndent = require("common-tags").stripIndent;
+
+
+
+
+function syntheticRange(rule, start, end) {
+  const r = { unusedRule: rule, rule: rule, start: start };
+
+  if (end !== undefined) r.end = end;
+
+  return r;
+}
+
+describe("needlessDisablesStringFormatter (issue: better error output)", () => {
+  it("formats a range with a rule, start, and end as 'unused rule: X, start line: N, end line: M'", () => {
+    const actual = stripAnsi(
+      needlessDisablesStringFormatter([
+        {
+          source: "foo.css",
+          ranges: [syntheticRange("color-named", 2, 4)]
+        }
+      ])
+    );
+
+    let expected = stripIndent`
+      foo.css
+      unused rule: color-named, start line: 2, end line: 4`;
+
+    expected = `\n${expected}\n`;
+
+    expect(actual).toBe(expected);
+  });
+
+  it("formats a range with a rule and only start (no end) as 'unused rule: X, start line: N'", () => {
+    const actual = stripAnsi(
+      needlessDisablesStringFormatter([
+        {
+          source: "foo.css",
+          ranges: [syntheticRange("block-no-empty", 7)]
+        }
+      ])
+    );
+
+    let expected = stripIndent`
+      foo.css
+      unused rule: block-no-empty, start line: 7`;
+
+    expected = `\n${expected}\n`;
+
+    expect(actual).toBe(expected);
+  });
+
+  it("formats multiple ranges and multiple sources with the new format", () => {
+    const actual = stripAnsi(
+      needlessDisablesStringFormatter([
+        {
+          source: "foo.css",
+          ranges: [
+            syntheticRange("color-named", 1, 3),
+            syntheticRange("all", 7)
+          ]
+        },
+        {
+          source: "bar.css",
+          ranges: [
+            syntheticRange("block-no-empty", 19, 33),
+            syntheticRange("color-named", 99, 102)
+          ]
+        }
+      ])
+    );
+
+    let expected = stripIndent`
+      foo.css
+      unused rule: color-named, start line: 1, end line: 3
+      unused rule: all, start line: 7
+
+      bar.css
+      unused rule: block-no-empty, start line: 19, end line: 33
+      unused rule: color-named, start line: 99, end line: 102`;
+
+    expected = `\n${expected}\n`;
+
+    expect(actual).toBe(expected);
+  });
+
+  it("does not emit the old 'start: N, end: M' format (negative assertion)", () => {
+    const actual = stripAnsi(
+      needlessDisablesStringFormatter([
+        {
+          source: "foo.css",
+          ranges: [syntheticRange("color-named", 2, 4)]
+        }
+      ])
+    );
+
+
+
+    expect(actual).not.toMatch(/(^|[^a-z])start: 2(?![0-9])/);
+    expect(actual).not.toMatch(/(^|[^a-z])end: 4(?![0-9])/);
+
+    expect(actual).toContain("unused rule: color-named");
+    expect(actual).toContain("start line: 2");
+    expect(actual).toContain("end line: 4");
+  });
+
+
+
+
+  it("end-to-end: produces 'unused rule: X, start line: N, end line: M' from a real disable", () => {
+    const config = { rules: { "color-named": "never" } };
+    const css = stripIndent`
+      /* stylelint-disable color-named */
+      a {}
+      /* stylelint-enable */
+      `;
+
+    return standalone({ config, code: css, ignoreDisables: true }).then(
+      linted => {
+        const report = needlessDisables(linted.results);
+        const actual = stripAnsi(needlessDisablesStringFormatter(report));
+
+        expect(actual).toContain("unused rule: color-named");
+        expect(actual).toContain("start line: 1");
+        expect(actual).toContain("end line: 3");
+
+        expect(actual).not.toMatch(/(^|[^a-z])start: 1(?![0-9])/);
+        expect(actual).not.toMatch(/(^|[^a-z])end: 3(?![0-9])/);
+      }
+    );
+  });
+
+  it("end-to-end: a bare /* stylelint-disable */ produces 'unused rule: all'", () => {
+    const config = { rules: { "block-no-empty": true } };
+    const css = stripIndent`
+      /* stylelint-disable */
+      a { color: pink; }
+      /* stylelint-enable */
+      `;
+
+    return standalone({ config, code: css, ignoreDisables: true }).then(
+      linted => {
+        const report = needlessDisables(linted.results);
+        const actual = stripAnsi(needlessDisablesStringFormatter(report));
+
+        expect(actual).toContain("unused rule: all");
+        expect(actual).toContain("start line: 1");
+      }
+    );
+  });
+});
