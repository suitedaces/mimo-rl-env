@@ -0,0 +1,171 @@
+import pytest
+import numpy as np
+from datetime import timedelta as delta
+from operator import attrgetter
+
+from parcels import (
+    FieldSet,
+    JITParticle,
+    ParticleSet,
+    ScipyParticle,
+    Variable,
+)
+
+
+PTYPES = {"scipy": ScipyParticle, "jit": JITParticle}
+
+
+def _fieldset():
+    data = {
+        "U": np.zeros((2, 2), dtype=np.float32),
+        "V": np.zeros((2, 2), dtype=np.float32),
+    }
+    dimensions = {
+        "lon": np.array([0.0, 1.0], dtype=np.float32),
+        "lat": np.array([0.0, 1.0], dtype=np.float32),
+    }
+    return FieldSet.from_data(data, dimensions, mesh="flat")
+
+
+@pytest.mark.parametrize("mode", ["scipy", "jit"])
+def test_add_variable_from_name_works_in_particleset(mode):
+    ParticleClass = PTYPES[mode]
+    AddedParticle = ParticleClass.add_variable(
+        "custom_scalar", dtype=np.float32, initial=7.5
+    )
+    assert issubclass(AddedParticle, ParticleClass)
+
+    pset = ParticleSet(_fieldset(), pclass=AddedParticle, lon=[0.25], lat=[0.25])
+    particle = pset[0]
+    assert hasattr(particle, "custom_scalar")
+    assert particle.custom_scalar == pytest.approx(7.5)
+
+    def store_custom_scalar(particle, fieldset, time):
+        particle.custom_scalar = 11.25 + particle.lon
+
+    pset.execute(pset.Kernel(store_custom_scalar), runtime=delta(seconds=1), dt=1)
+    assert pset[0].custom_scalar == pytest.approx(11.5)
+
+
+@pytest.mark.parametrize("mode", ["scipy", "jit"])
+def test_add_variable_from_variable_instance_preserves_options(mode):
+    ParticleClass = PTYPES[mode]
+    variable = Variable(
+        "instance_marker", dtype=np.float32, initial=3.25, to_write=False
+    )
+    AddedParticle = ParticleClass.add_variable(variable)
+
+    pset = ParticleSet(_fieldset(), pclass=AddedParticle, lon=[0.5], lat=[0.25])
+    assert pset[0].instance_marker == pytest.approx(3.25)
+
+    def update_instance_marker(particle, fieldset, time):
+        particle.instance_marker = particle.instance_marker + 2.0
+
+    pset.execute(pset.Kernel(update_instance_marker), runtime=delta(seconds=1), dt=1)
+    assert pset[0].instance_marker == pytest.approx(5.25)
+
+
+@pytest.mark.parametrize("mode", ["scipy", "jit"])
+def test_add_variables_preserves_each_variable_configuration(mode):
+    ParticleClass = PTYPES[mode]
+    AddedParticle = ParticleClass.add_variables(
+        [
+            Variable("alpha", dtype=np.float32, initial=1.0),
+            Variable("beta", dtype=np.float64, initial=2.5),
+            Variable("lon_copy", dtype=np.float32, initial=attrgetter("lon")),
+        ]
+    )
+
+    pset = ParticleSet(
+        _fieldset(),
+        pclass=AddedParticle,
+        lon=[0.25, 0.75],
+        lat=[0.25, 0.25],
+    )
+    assert [(p.alpha, p.beta) for p in pset] == pytest.approx([(1.0, 2.5), (1.0, 2.5)])
+    assert [p.lon_copy for p in pset] == pytest.approx([0.25, 0.75])
+
+
+@pytest.mark.parametrize("mode", ["scipy", "jit"])
+def test_add_variables_kernel_can_update_all_added_fields(mode):
+    ParticleClass = PTYPES[mode]
+    AddedParticle = ParticleClass.add_variables(
+        [
+            Variable("left_value", dtype=np.float32, initial=0.0),
+            Variable("right_value", dtype=np.float32, initial=0.0),
+            Variable("combined_value", dtype=np.float32, initial=-1.0),
+        ]
+    )
+    pset = ParticleSet(_fieldset(), pclass=AddedParticle, lon=[0.5], lat=[0.5])
+
+    def update_all_added_fields(particle, fieldset, time):
+        particle.left_value = 5.0
+        particle.right_value = 7.0
+        particle.combined_value = particle.left_value + particle.right_value + particle.lon
+
+    pset.execute(pset.Kernel(update_all_added_fields), runtime=delta(seconds=1), dt=1)
+    particle = pset[0]
+    assert (particle.left_value, particle.right_value, particle.combined_value) == pytest.approx(
+        (5.0, 7.0, 12.5)
+    )
+
+
+@pytest.mark.parametrize("mode", ["scipy", "jit"])
+def test_add_variable_accepts_fresh_variable_names(mode):
+    ParticleClass = PTYPES[mode]
+    AddedParticle = ParticleClass.add_variable(
+        "fresh_marker", dtype=np.float32, initial=8.5
+    )
+
+    pset = ParticleSet(_fieldset(), pclass=AddedParticle, lon=[0.25], lat=[0.25])
+    assert hasattr(pset[0], "fresh_marker")
+    assert pset[0].fresh_marker == pytest.approx(8.5)
+
+
+@pytest.mark.parametrize("mode", ["scipy", "jit"])
+def test_add_variables_accepts_fresh_variable_sets(mode):
+    ParticleClass = PTYPES[mode]
+    AddedParticle = ParticleClass.add_variables(
+        [
+            Variable("gamma_value", dtype=np.float32, initial=6.0),
+            Variable("delta_value", dtype=np.float32, initial=9.0),
+        ]
+    )
+
+    pset = ParticleSet(_fieldset(), pclass=AddedParticle, lon=[0.75], lat=[0.25])
+    particle = pset[0]
+    assert (particle.gamma_value, particle.delta_value) == pytest.approx((6.0, 9.0))
+
+
+@pytest.mark.parametrize("mode", ["scipy", "jit"])
+def test_class_body_variable_declaration_still_works_like_new_api(mode):
+    ParticleClass = PTYPES[mode]
+
+    class LegacyParticle(ParticleClass):
+        legacy = Variable("legacy", dtype=np.float32, initial=4.0)
+
+    AddedParticle = ParticleClass.add_variable(
+        Variable("legacy", dtype=np.float32, initial=4.0)
+    )
+
+    legacy_pset = ParticleSet(_fieldset(), pclass=LegacyParticle, lon=[0.25], lat=[0.25])
+    added_pset = ParticleSet(_fieldset(), pclass=AddedParticle, lon=[0.25], lat=[0.25])
+    assert legacy_pset[0].legacy == pytest.approx(added_pset[0].legacy)
+
+    def update_legacy_value(particle, fieldset, time):
+        particle.legacy = particle.legacy * 3.0 + particle.lon
+
+    legacy_pset.execute(legacy_pset.Kernel(update_legacy_value), runtime=delta(seconds=1), dt=1)
+    added_pset.execute(added_pset.Kernel(update_legacy_value), runtime=delta(seconds=1), dt=1)
+    assert legacy_pset[0].legacy == pytest.approx(added_pset[0].legacy)
+
+
+@pytest.mark.parametrize("mode", ["scipy", "jit"])
+def test_class_body_variable_initial_value_is_preserved_on_particle(mode):
+    ParticleClass = PTYPES[mode]
+
+    class DirectLegacyParticle(ParticleClass):
+        direct_legacy = Variable("direct_legacy", dtype=np.float32, initial=6.5)
+
+    particle = DirectLegacyParticle(lon=0.2, lat=0.3, pid=1)
+    assert particle.direct_legacy == pytest.approx(6.5)
