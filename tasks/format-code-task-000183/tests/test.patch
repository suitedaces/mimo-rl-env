+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+python3 -m pip install --no-input --break-system-packages -e . 2>/dev/null
+
+case "${1:-}" in
+  base)
+    python3 -m pytest \
+      tests/test_advection.py \
+      tests/test_diffusion.py \
+      tests/test_fieldset.py \
+      tests/test_fieldset_sampling.py \
+      tests/test_grids.py \
+      tests/test_interaction.py \
+      tests/test_kernel_execution.py \
+      tests/test_kernel_language.py \
+      tests/test_particlefile.py \
+      tests/test_particles.py \
+      tests/test_particlesets.py \
+      -v --timeout=300 \
+      -k "not (test_from_netcdf_memory_containment or test_from_netcdf_chunking)"
+    ;;
+  new)
+    python3 -m pytest tests/test_particle_add_variables.py -v --timeout=300
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
