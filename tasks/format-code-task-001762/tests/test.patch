+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+PYTHON_BIN=/opt/stage4a-plumber-vmf-venv/bin/python
+if [ ! -x "$PYTHON_BIN" ]; then
+  echo "Missing offline pytest venv at $PYTHON_BIN" >&2
+  exit 127
+fi
+
+export PYTHONPATH=/workspace/repo${PYTHONPATH:+:$PYTHONPATH}
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+exec "$PYTHON_BIN" -m pytest /workspace/repo/usercase-test-coderl/test_parallel_import_builder_vmf.py -v
