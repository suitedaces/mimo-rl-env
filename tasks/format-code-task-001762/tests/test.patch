+++ b/usercase-test-coderl/test_parallel_import_builder_vmf.py
@@ -0,0 +1,329 @@
+
+
+
+
+
+
+
+
+
+
+from types import ModuleType, SimpleNamespace
+
+import pytest
+
+from plumber.api import AssetImportError, GameFileSystem, ParallelImportBuilder
+
+
+class NamedCollection:
+    def __init__(self, label):
+        self.label = label
+
+
+class FakeScene:
+    def __init__(self):
+        self.collection = NamedCollection("scene")
+
+
+class FakeContext:
+    def __init__(self):
+        self.scene = FakeScene()
+        self.preferences = SimpleNamespace(addons={})
+
+
+class RecordingAssetCallbacks:
+    instances = []
+
+    def __init__(
+        self,
+        context,
+        main_collection=None,
+        brush_collection=None,
+        overlay_collection=None,
+        prop_collection=None,
+        light_collection=None,
+        entity_collection=None,
+        apply_armatures=False,
+    ):
+        self.summary = {
+            "main_collection": main_collection.label,
+            "brush_collection": brush_collection.label,
+            "overlay_collection": overlay_collection.label,
+            "prop_collection": prop_collection.label,
+            "light_collection": light_collection.label,
+            "entity_collection": entity_collection.label,
+            "apply_armatures": apply_armatures,
+        }
+        RecordingAssetCallbacks.instances.append(self)
+
+
+class RecordingApiImporter:
+    instances = []
+    fail_on_execute = False
+
+    def __init__(self, file_system, callbacks, threads, **kwargs):
+        self.file_system = file_system
+        self.callbacks = callbacks
+        self.threads = threads
+        self.kwargs = kwargs
+        self.jobs = []
+        self.executed = 0
+        RecordingApiImporter.instances.append(self)
+
+    def add_vmf_job(self, path, from_game):
+        self.jobs.append(("vmf", path, from_game))
+
+    def add_mdl_job(self, path, from_game):
+        self.jobs.append(("mdl", path, from_game))
+
+    def add_vmt_job(self, path, from_game):
+        self.jobs.append(("vmt", path, from_game))
+
+    def add_vtf_job(self, path, from_game):
+        self.jobs.append(("vtf", path, from_game))
+
+    def execute_jobs(self):
+        if self.fail_on_execute:
+            raise RuntimeError("native boom")
+        self.executed += 1
+
+
+@pytest.fixture
+def public_import_environment(monkeypatch):
+    RecordingApiImporter.instances = []
+    RecordingApiImporter.fail_on_execute = False
+    RecordingAssetCallbacks.instances = []
+
+    fake_native = ModuleType("plumber.plumber")
+    fake_native.ApiImporter = RecordingApiImporter
+
+    fake_asset = ModuleType("plumber.asset")
+    fake_asset.AssetCallbacks = RecordingAssetCallbacks
+
+    import plumber
+
+    monkeypatch.setattr(plumber, "plumber", fake_native, raising=False)
+    monkeypatch.setitem(__import__("sys").modules, "plumber.plumber", fake_native)
+    monkeypatch.setitem(__import__("sys").modules, "plumber.asset", fake_asset)
+
+    return SimpleNamespace(
+        fs=GameFileSystem("filesystem-token"),
+        context=FakeContext(),
+        importer=RecordingApiImporter,
+    )
+
+
+def test_add_vmf_chains_and_job_count_progresses_with_other_asset_jobs(
+    public_import_environment,
+):
+
+
+
+
+    builder = ParallelImportBuilder(public_import_environment.fs)
+
+    assert builder.job_count == 0
+    returned = builder.add_vmf("maps/de_dust2.vmf")
+    assert returned is builder
+    assert builder.job_count == 1
+    builder.add_mdl("models/props_crates/static_crate.mdl")
+    assert builder.job_count == 2
+
+
+def test_execute_forwards_vmf_jobs_options_collections_and_clears_queue(
+    public_import_environment,
+):
+
+
+
+
+    builder = ParallelImportBuilder(
+        public_import_environment.fs,
+        material_import_materials=False,
+        material_simple_materials=True,
+        material_texture_format="Tga",
+        material_texture_interpolation="Closest",
+        material_allow_culling=True,
+        material_editor_materials=True,
+        vmf_import_lights=False,
+        vmf_light_factor=2.5,
+        vmf_sun_factor=3.5,
+        vmf_ambient_factor=0.25,
+        vmf_import_sky_camera=False,
+        vmf_sky_equi_height=512,
+        vmf_import_unknown_entities=True,
+        vmf_import_brushes=False,
+        vmf_import_overlays=False,
+        vmf_epsilon=0.125,
+        vmf_cut_threshold=0.75,
+        vmf_merge_solids="SEPARATE",
+        vmf_invisible_solids="IMPORT",
+        vmf_import_props=False,
+        vmf_import_entities=False,
+        vmf_import_sky=False,
+        vmf_scale=0.03125,
+        vmf_brush_collection=NamedCollection("brush"),
+        vmf_overlay_collection=NamedCollection("overlay"),
+        vmf_prop_collection=NamedCollection("prop"),
+        vmf_light_collection=NamedCollection("light"),
+        vmf_entity_collection=NamedCollection("entity"),
+        asset_search_path="/tmp/map-assets",
+        mdl_target_fps=24.0,
+        mdl_remove_animations=True,
+        mdl_import_animations=False,
+        mdl_apply_armatures=True,
+        main_collection=NamedCollection("main"),
+    )
+
+    assert builder.job_count == 0
+    builder.add_vmf("maps/de_dust2.vmf", True).add_vmf("/tmp/local_map.vmf", False)
+    assert builder.job_count == 2
+
+    result = builder.execute(public_import_environment.context)
+
+    assert result is None
+    assert builder.job_count == 0
+    assert len(RecordingApiImporter.instances) == 1
+    native_importer = RecordingApiImporter.instances[0]
+    assert native_importer.jobs == [
+        ("vmf", "maps/de_dust2.vmf", True),
+        ("vmf", "/tmp/local_map.vmf", False),
+    ]
+    assert native_importer.executed == 1
+    assert native_importer.file_system == "filesystem-token"
+
+    expected_vmf_kwargs = {
+        "ambient_factor": 0.25,
+        "cut_threshold": 0.75,
+        "epsilon": 0.125,
+        "import_brushes": False,
+        "import_lights": False,
+        "import_overlays": False,
+        "import_props": False,
+        "import_entities": False,
+        "import_sky": False,
+        "import_sky_camera": False,
+        "import_unknown_entities": True,
+        "invisible_solids": "IMPORT",
+        "light_factor": 2.5,
+        "merge_solids": "SEPARATE",
+        "scale": 0.03125,
+        "sky_equi_height": 512,
+        "sun_factor": 3.5,
+    }
+    for key, value in expected_vmf_kwargs.items():
+        assert native_importer.kwargs[key] == value
+
+
+    callback_summary = RecordingAssetCallbacks.instances[0].summary
+    assert {
+        key: callback_summary[key]
+        for key in (
+            "brush_collection",
+            "overlay_collection",
+            "prop_collection",
+            "light_collection",
+            "entity_collection",
+        )
+    } == {
+        "brush_collection": "brush",
+        "overlay_collection": "overlay",
+        "prop_collection": "prop",
+        "light_collection": "light",
+        "entity_collection": "entity",
+    }
+
+
+def test_native_vmf_read_or_parse_failure_can_be_logged_and_continue(
+    public_import_environment,
+):
+
+
+
+
+    builder = ParallelImportBuilder(public_import_environment.fs)
+    builder.add_vmf("maps/broken.vmf")
+
+    result = builder.execute(public_import_environment.context)
+
+    assert result is None
+    assert builder.job_count == 0
+    assert len(RecordingApiImporter.instances) == 1
+    assert RecordingApiImporter.instances[0].jobs == [
+        ("vmf", "maps/broken.vmf", True)
+    ]
+    assert RecordingApiImporter.instances[0].executed == 1
+
+
+def test_execute_native_failure_raises_specific_asset_import_error(
+    public_import_environment,
+):
+
+
+
+
+    RecordingApiImporter.fail_on_execute = True
+    builder = ParallelImportBuilder(public_import_environment.fs)
+    builder.add_vmf("maps/broken.vmf")
+
+
+    with pytest.raises(AssetImportError):
+        builder.execute(public_import_environment.context)
+
+    assert builder.job_count == 1
+
+
+def test_execute_cleanup_is_idempotent_after_queue_has_been_drained(
+    public_import_environment,
+):
+
+
+
+
+    builder = ParallelImportBuilder(public_import_environment.fs)
+    builder.add_vmf("maps/a.vmf")
+
+    assert builder.job_count == 1
+    first = builder.execute(public_import_environment.context)
+    assert first is None
+    assert builder.job_count == 0
+    second = builder.execute(public_import_environment.context)
+    assert second is None
+    assert builder.job_count == 0
+
+    assert len(RecordingApiImporter.instances) >= 1
+
+
+def test_two_builders_keep_independent_vmf_queues(public_import_environment):
+
+
+
+
+    first = ParallelImportBuilder(public_import_environment.fs)
+    second = ParallelImportBuilder(public_import_environment.fs)
+
+    first.add_vmf("maps/a.vmf").add_vmf("maps/b.vmf")
+    second.add_vmf("maps/c.vmf")
+
+    assert first.job_count == 2
+    assert second.job_count == 1
+
+
+def test_execute_cleanup_keeps_queued_job_counter_bounded_over_many_cycles(
+    public_import_environment,
+):
+
+
+
+
+    builder = ParallelImportBuilder(public_import_environment.fs)
+
+    for index in range(100):
+        builder.add_vmf(f"maps/cycle_{index}.vmf")
+        assert builder.job_count == 1
+        result = builder.execute(public_import_environment.context)
+        assert result is None
+        assert builder.job_count == 0
+
+
+    assert builder.job_count == 0
