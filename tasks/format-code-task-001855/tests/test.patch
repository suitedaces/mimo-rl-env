+func TestGetAuthURLUsesProviderStateAndStoresMarshaledSession(t *testing.T) {
+
+
+	store := installFaux(t)
+	res := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/auth?provider=faux&state=state_REAL", nil)
+
+	authURL, err := gothic.GetAuthURL(res, req)
+	if err != nil {
+		t.Fatalf("GetAuthURL: %v", err)
+	}
+
+	assertString(t, authURL, "http://example.com/auth?client_id=&response_type=code&state=state_REAL")
+	stored, err := gothic.GetFromSession("faux", req)
+	if err != nil {
+		t.Fatalf("GetFromSession faux: %v", err)
+	}
+	assertString(t, stored, storedAuthSession)
+
+	if store.saveCount() == 0 {
+		t.Fatal("GetAuthURL did not save through gothic.Store")
+	}
+}
+
+func TestGeneratedStateIsURLSafeAndDifferentAcrossAuthRequests(t *testing.T) {
+
+
+	installFaux(t)
+	firstURL, err := gothic.GetAuthURL(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/auth?provider=faux", nil))
+	if err != nil {
+		t.Fatalf("first GetAuthURL: %v", err)
+	}
+	secondURL, err := gothic.GetAuthURL(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/auth?provider=faux", nil))
+	if err != nil {
+		t.Fatalf("second GetAuthURL: %v", err)
+	}
+
+	firstState := mustQuery(t, firstURL, "state")
+	secondState := mustQuery(t, secondURL, "state")
+
+	assertURLSafeState(t, firstState)
+	assertURLSafeState(t, secondState)
+	if firstState == secondState {
+		t.Fatalf("got identical generated states %q", firstState)
+	}
+}
+
+func TestBeginAuthHandlerRedirectsOrWritesProviderError(t *testing.T) {
+
+
+	installFaux(t)
+	successRes := httptest.NewRecorder()
+	gothic.BeginAuthHandler(successRes, httptest.NewRequest(http.MethodGet, "/auth?provider=faux&state=state_REAL", nil))
+	assertInt(t, successRes.Code, 307)
+	assertString(t, successRes.Header().Get("Location"), "http://example.com/auth?client_id=&response_type=code&state=state_REAL")
+
+	errorRes := httptest.NewRecorder()
+	gothic.BeginAuthHandler(errorRes, httptest.NewRequest(http.MethodGet, "/auth", nil))
+	assertInt(t, errorRes.Code, 400)
+
+	assertString(t, strings.TrimSpace(errorRes.Body.String()), "you must select a provider")
+}
+
+func TestGetProviderNameAllPublicSourcesAndNoProviderError(t *testing.T) {
+
+
+	store := installFaux(t)
+
+	cases := []struct {
+		name string
+		req  *http.Request
+	}{
+		{"provider query", httptest.NewRequest(http.MethodGet, "/auth?provider=faux", nil)},
+		{":provider query", httptest.NewRequest(http.MethodGet, "/auth?:provider=faux", nil)},
+		{"mux vars", mux.SetURLVars(httptest.NewRequest(http.MethodGet, "/auth", nil), map[string]string{"provider": "faux"})},
+		{"context string", httptest.NewRequest(http.MethodGet, "/auth", nil).WithContext(context.WithValue(context.Background(), "provider", "faux"))},
+		{"path value", pathValueRequest()},
+		{"GetContextWithProvider", gothic.GetContextWithProvider(httptest.NewRequest(http.MethodGet, "/auth", nil), "faux")},
+	}
+
+	for _, tc := range cases {
+		got, err := gothic.GetProviderName(tc.req)
+		if err != nil {
+			t.Fatalf("%s GetProviderName: %v", tc.name, err)
+		}
+		assertString(t, got, "faux")
+	}
+
+	chiReq := httptest.NewRequest(http.MethodGet, "/auth/faux", nil)
+	routeCtx := chi.NewRouteContext()
+	routeCtx.URLParams.Add("provider", "faux")
+	chiReq = chiReq.WithContext(context.WithValue(chiReq.Context(), chi.RouteCtxKey, routeCtx))
+	got, err := gothic.GetProviderName(chiReq)
+	if err != nil {
+		t.Fatalf("chi GetProviderName: %v", err)
+	}
+	assertString(t, got, "faux")
+
+	fallbackReq := httptest.NewRequest(http.MethodGet, "/auth/callback", nil)
+	seedGothicSession(t, store, fallbackReq, existingUserSession)
+	got, err = gothic.GetProviderName(fallbackReq)
+	if err != nil {
+		t.Fatalf("session fallback GetProviderName: %v", err)
+	}
+	assertString(t, got, "faux")
+
+	_, err = gothic.GetProviderName(httptest.NewRequest(http.MethodGet, "/auth", nil))
+	if err == nil {
+		t.Fatal("missing provider returned nil error")
+	}
+	assertString(t, err.Error(), "you must select a provider")
+}
+
+func pathValueRequest() *http.Request {
+	req := httptest.NewRequest(http.MethodGet, "/auth/faux", nil)
+	req.SetPathValue("provider", "faux")
+	return req
+}
