+func TestCompleteUserAuthReturnsExistingUserAndClearsSession(t *testing.T) {
+
+
+	store := installFaux(t)
+	res := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/auth/callback?provider=faux", nil)
+	seedGothicSession(t, store, req, existingUserSession)
+
+	user, err := gothic.CompleteUserAuth(res, req)
+	if err != nil {
+		t.Fatalf("CompleteUserAuth: %v", err)
+	}
+
+	assertString(t, user.Name, "Homer Simpson")
+	assertString(t, user.Email, "homer@example.com")
+	assertString(t, user.Provider, "faux")
+	assertString(t, user.AccessToken, "token_EXISTING")
+
+	if got := store.savedValues(store.saveCount() - 1); len(got) != 0 {
+		t.Fatalf("cleanup saved values = %#v, want empty map", got)
+	}
+	assertInt(t, store.activeValueSessions(), 0)
+}
+
+func TestCompleteUserAuthAuthorizesFromPostFormAndPersistsBeforeCleanup(t *testing.T) {
+
+
+	store := installFaux(t)
+	res := httptest.NewRecorder()
+	form := url.Values{"code": {"code_REAL"}, "state": {"state_REAL"}}
+
+	req := gothic.GetContextWithProvider(httptest.NewRequest(http.MethodPost, "/auth/callback", strings.NewReader(form.Encode())), "faux")
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	seedGothicSession(t, store, req, needsAuthSession)
+
+	user, err := gothic.CompleteUserAuth(res, req)
+	if err != nil {
+		t.Fatalf("CompleteUserAuth POST: %v", err)
+	}
+
+	assertString(t, user.Name, "Homer Simpson")
+	assertString(t, user.Email, "homer@example.com")
+	assertString(t, user.AccessToken, "access")
+	assertString(t, gunzipString(t, store.savedValues(store.saveCount() - 2)["faux"].(string)), authorizedSession)
+
+	if got := store.savedValues(store.saveCount() - 1); len(got) != 0 {
+		t.Fatalf("cleanup saved values = %#v, want empty map", got)
+	}
+}
+
+func TestCompleteUserAuthStateMismatchAndOutOfOrderSessionError(t *testing.T) {
+
+
+	installFaux(t)
+	beginRes := httptest.NewRecorder()
+	beginReq := httptest.NewRequest(http.MethodGet, "/auth?provider=faux&state=state_REAL", nil)
+	if _, err := gothic.GetAuthURL(beginRes, beginReq); err != nil {
+		t.Fatalf("GetAuthURL: %v", err)
+	}
+	callbackReq := httptest.NewRequest(http.MethodGet, "/auth/callback?provider=faux&state=state_FAKE", nil)
+	carryCookies(callbackReq, beginRes)
+	_, err := gothic.CompleteUserAuth(httptest.NewRecorder(), callbackReq)
+	if err == nil {
+		t.Fatal("state mismatch returned nil error")
+	}
+	assertString(t, err.Error(), "state token mismatch")
+
+	_, err = gothic.CompleteUserAuth(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/auth/callback?provider=faux", nil))
+	if err == nil {
+		t.Fatal("out-of-order callback returned nil error")
+	}
+	assertString(t, err.Error(), "could not find a matching session for this request")
+}
+
+func TestSessionHelpersRoundTripCompressMissingAndSeparateBrowserSessions(t *testing.T) {
+
+
+	store := installFaux(t)
+	reqA := httptest.NewRequest(http.MethodGet, "/auth", nil)
+	reqB := httptest.NewRequest(http.MethodGet, "/auth", nil)
+
+	if err := gothic.StoreInSession("alpha", "value-A", reqA, httptest.NewRecorder()); err != nil {
+		t.Fatalf("StoreInSession alpha: %v", err)
+	}
+	if err := gothic.StoreInSession("alpha", "value-B", reqB, httptest.NewRecorder()); err != nil {
+		t.Fatalf("StoreInSession beta: %v", err)
+	}
+
+	valueA, err := gothic.GetFromSession("alpha", reqA)
+	if err != nil {
+		t.Fatalf("GetFromSession alpha A: %v", err)
+	}
+	valueB, err := gothic.GetFromSession("alpha", reqB)
+	if err != nil {
+		t.Fatalf("GetFromSession alpha B: %v", err)
+	}
+	assertString(t, valueA, "value-A")
+	assertString(t, valueB, "value-B")
+
+	raw := store.savedValues(0)["alpha"].(string)
+
+	if raw == "value-A" {
+		t.Fatal("stored session value was not compressed")
+	}
+	assertString(t, gunzipString(t, raw), "value-A")
+
+	_, err = gothic.GetFromSession("missing", reqA)
+	if err == nil {
+		t.Fatal("missing GetFromSession returned nil error")
+	}
+	assertString(t, err.Error(), "could not find a matching session for this request")
+}
+
+func TestLogoutIsIdempotentAndClearsStoredValues(t *testing.T) {
+
+
+	store := installFaux(t)
+	req := httptest.NewRequest(http.MethodGet, "/auth/callback?provider=faux", nil)
+	seedGothicSession(t, store, req, existingUserSession)
+
+	if err := gothic.Logout(httptest.NewRecorder(), req); err != nil {
+		t.Fatalf("first Logout: %v", err)
+	}
+	if err := gothic.Logout(httptest.NewRecorder(), req); err != nil {
+		t.Fatalf("second Logout: %v", err)
+	}
+	assertInt(t, store.savedMaxAge(store.saveCount()-1), -1)
+	if got := store.savedValues(store.saveCount() - 1); len(got) != 0 {
+		t.Fatalf("logout saved values = %#v, want empty map", got)
+	}
+	assertInt(t, store.activeValueSessions(), 0)
+}
+
+func TestRepeatedAuthAndLogoutCyclesLeaveNoActiveSessionValues(t *testing.T) {
+
+
+	store := installFaux(t)
+	for i := 0; i < 120; i++ {
+		req := httptest.NewRequest(http.MethodGet, fmt.Sprintf("/auth?provider=faux&state=state_%03d", i), nil)
+		res := httptest.NewRecorder()
+		if _, err := gothic.GetAuthURL(res, req); err != nil {
+			t.Fatalf("cycle %d GetAuthURL: %v", i, err)
+		}
+		if err := gothic.Logout(httptest.NewRecorder(), req); err != nil {
+			t.Fatalf("cycle %d Logout: %v", i, err)
+		}
+	}
+	assertInt(t, store.activeValueSessions(), 0)
+}
+
+func mustQuery(t *testing.T, rawURL, key string) string {
+	t.Helper()
+	parsed, err := url.Parse(rawURL)
+	if err != nil {
+		t.Fatalf("parse URL %q: %v", rawURL, err)
+	}
+	return parsed.Query().Get(key)
+}
+
+func assertURLSafeState(t *testing.T, state string) {
+	t.Helper()
+	if state == "" {
+		t.Fatal("generated state is empty")
+	}
+	seenPadding := false
+	for _, r := range state {
+		switch {
+		case r >= 'A' && r <= 'Z':
+			if seenPadding {
+				t.Fatalf("generated state %q has data after padding", state)
+			}
+		case r >= 'a' && r <= 'z':
+			if seenPadding {
+				t.Fatalf("generated state %q has data after padding", state)
+			}
+		case r >= '0' && r <= '9':
+			if seenPadding {
+				t.Fatalf("generated state %q has data after padding", state)
+			}
+		case r == '-' || r == '_':
+			if seenPadding {
+				t.Fatalf("generated state %q has data after padding", state)
+			}
+		case r == '=':
+			seenPadding = true
+		default:
+			t.Fatalf("generated state %q contains non URL-safe character %q", state, r)
+		}
+	}
+}
