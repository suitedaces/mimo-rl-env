+package usercase_test_coderl
+
+import (
+	"compress/gzip"
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"reflect"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/gorilla/mux"
+	"github.com/gorilla/sessions"
+	"github.com/markbates/goth"
+	"github.com/markbates/goth/gothic"
+	"github.com/markbates/goth/providers/faux"
+)
+
+
+
+
+
+
+
+
+const (
+	sessionCookieName   = "coderl_gothic_sid"
+	storedAuthSession   = `{"ID":"id","Name":"","Email":"","AuthURL":"http://example.com/auth?client_id=\u0026response_type=code\u0026state=state_REAL","AccessToken":""}`
+	existingUserSession = `{"ID":"","Name":"Homer Simpson","Email":"homer@example.com","AuthURL":"","AccessToken":"token_EXISTING"}`
+	needsAuthSession    = `{"ID":"","Name":"Homer Simpson","Email":"homer@example.com","AuthURL":"","AccessToken":""}`
+	authorizedSession   = `{"ID":"","Name":"Homer Simpson","Email":"homer@example.com","AuthURL":"","AccessToken":"access"}`
+)
+
+var (
+	initialStoreType     = reflect.TypeOf(gothic.Store).String()
+	initialStoreHTTPOnly = gothic.Store.(*sessions.CookieStore).Options.HttpOnly
+)
+
+type recordedSave struct {
+	sessionName string
+	maxAge      int
+	values      map[interface{}]interface{}
+}
+
+type recordingStore struct {
+	mu          sync.Mutex
+	nextID      int
+	byRequest   map[*http.Request]string
+	sessions    map[string]*sessions.Session
+	saveHistory []recordedSave
+}
+
+func newRecordingStore() *recordingStore {
+	return &recordingStore{
+		byRequest: make(map[*http.Request]string),
+		sessions:  make(map[string]*sessions.Session),
+	}
+}
+
+func (s *recordingStore) Get(r *http.Request, name string) (*sessions.Session, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	id := s.idForRequestLocked(r)
+	key := id + "\x00" + name
+	if existing := s.sessions[key]; existing != nil {
+		return cloneSession(s, existing), nil
+	}
+	return s.newSessionLocked(r, name, id), nil
+}
+
+func (s *recordingStore) New(r *http.Request, name string) (*sessions.Session, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	return s.newSessionLocked(r, name, s.idForRequestLocked(r)), nil
+}
+
+func (s *recordingStore) Save(r *http.Request, w http.ResponseWriter, session *sessions.Session) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	id := s.idForRequestLocked(r)
+	http.SetCookie(w, &http.Cookie{Name: sessionCookieName, Value: id, Path: "/"})
+	stored := cloneSession(s, session)
+	s.sessions[id+"\x00"+session.Name()] = stored
+	s.saveHistory = append(s.saveHistory, recordedSave{
+		sessionName: session.Name(),
+		maxAge:      session.Options.MaxAge,
+		values:      cloneValues(session.Values),
+	})
+	return nil
+}
+
+func (s *recordingStore) idForRequestLocked(r *http.Request) string {
+	if cookie, err := r.Cookie(sessionCookieName); err == nil && cookie.Value != "" {
+		s.byRequest[r] = cookie.Value
+		return cookie.Value
+	}
+	if id := s.byRequest[r]; id != "" {
+		return id
+	}
+	s.nextID++
+	id := fmt.Sprintf("sid-%03d", s.nextID)
+	s.byRequest[r] = id
+	return id
+}
+
+func (s *recordingStore) newSessionLocked(r *http.Request, name, id string) *sessions.Session {
+	session := sessions.NewSession(s, name)
+	session.Options = &sessions.Options{Path: "/", MaxAge: 2592000, HttpOnly: true}
+	s.byRequest[r] = id
+	return session
+}
+
+func (s *recordingStore) activeValueSessions() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	count := 0
+	for _, session := range s.sessions {
+		if len(session.Values) > 0 {
+			count++
+		}
+	}
+	return count
+}
+
+func (s *recordingStore) savedValues(index int) map[interface{}]interface{} {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return cloneValues(s.saveHistory[index].values)
+}
+
+func (s *recordingStore) savedMaxAge(index int) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.saveHistory[index].maxAge
+}
+
+func (s *recordingStore) saveCount() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return len(s.saveHistory)
+}
+
+func cloneSession(store sessions.Store, session *sessions.Session) *sessions.Session {
+	cloned := sessions.NewSession(store, session.Name())
+	cloned.IsNew = session.IsNew
+	cloned.Values = cloneValues(session.Values)
+	if session.Options != nil {
+		options := *session.Options
+		cloned.Options = &options
+	}
+	return cloned
+}
+
+func cloneValues(values map[interface{}]interface{}) map[interface{}]interface{} {
+	cloned := make(map[interface{}]interface{}, len(values))
+	for key, value := range values {
+		cloned[key] = value
+	}
+	return cloned
+}
+
+func installFaux(t *testing.T) *recordingStore {
+	t.Helper()
+	store := newRecordingStore()
+	gothic.Store = store
+	goth.ClearProviders()
+	goth.UseProviders(&faux.Provider{})
+	return store
+}
+
+func carryCookies(req *http.Request, res *httptest.ResponseRecorder) {
+	for _, cookie := range res.Result().Cookies() {
+		req.AddCookie(cookie)
+	}
+}
+
+func seedGothicSession(t *testing.T, store *recordingStore, req *http.Request, value string) {
+	t.Helper()
+	session, err := store.Get(req, gothic.SessionName)
+	if err != nil {
+		t.Fatalf("seed store get: %v", err)
+	}
+	session.Values["faux"] = gzipString(t, value)
+	if err := session.Save(req, httptest.NewRecorder()); err != nil {
+		t.Fatalf("seed store save: %v", err)
+	}
+}
+
+func gzipString(t *testing.T, value string) string {
+	t.Helper()
+	var b strings.Builder
+	gz := gzip.NewWriter(&b)
+	if _, err := gz.Write([]byte(value)); err != nil {
+		t.Fatalf("gzip write: %v", err)
+	}
+	if err := gz.Close(); err != nil {
+		t.Fatalf("gzip close: %v", err)
+	}
+	return b.String()
+}
+
+func gunzipString(t *testing.T, value string) string {
+	t.Helper()
+	reader, err := gzip.NewReader(strings.NewReader(value))
+	if err != nil {
+		t.Fatalf("gzip reader: %v", err)
+	}
+	raw, err := io.ReadAll(reader)
+	if err != nil {
+		t.Fatalf("gzip read: %v", err)
+	}
+	return string(raw)
+}
+
+func assertString(t *testing.T, got, want string) {
+	t.Helper()
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func assertInt(t *testing.T, got, want int) {
+	t.Helper()
+	if got != want {
+		t.Fatalf("got %d, want %d", got, want)
+	}
+}
+
+func TestDefaultExportsAndCookieStoreShape(t *testing.T) {
+
+
+	assertString(t, gothic.SessionName, "_gothic_session")
+	assertString(t, initialStoreType, "*sessions.CookieStore")
+	assertString(t, fmt.Sprint(initialStoreHTTPOnly), "true")
+}
