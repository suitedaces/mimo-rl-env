+++ b/usercase-test-coderl/test_collection_composer_failures.py
@@ -0,0 +1,144 @@
+import apache_beam as beam
+from apache_beam.testing.test_pipeline import TestPipeline
+from apache_beam.testing.util import assert_that, equal_to
+
+from asgarde.collection_composer import CollectionComposer
+from asgarde.failure import Failure
+
+
+
+
+
+
+
+
+def same_failure(expected, actual):
+    return (
+        expected.pipeline_step == actual.pipeline_step
+        and expected.input_element == actual.input_element
+
+        and type(expected.exception) is type(actual.exception)
+    )
+
+
+def map_step(element, suffix, prefix=""):
+    if element == "bad-map":
+        raise ValueError("map exploded on bad-map")
+    return f"{prefix}{element}{suffix}"
+
+
+def flat_map_step(element, joiner, label=""):
+    if "flat-fail" in element:
+        raise ValueError("flat map exploded on flat-fail")
+    if "filter-seed" in element:
+        return [f"{element}{joiner}keep", "bad-filter"]
+    return [f"{element}{joiner}keep"]
+
+
+def filter_step(element, allowed_prefix):
+    if element == "bad-filter":
+        raise ValueError("filter exploded on bad-filter")
+    return element.startswith(allowed_prefix)
+
+
+def test_of_starts_with_input_outputs_and_empty_failure_pcollection():
+
+
+
+    with TestPipeline() as pipeline:
+        inputs = pipeline | "source empty-start" >> beam.Create(["alpha", "beta"])
+
+        result = CollectionComposer.of(inputs)
+
+        assert_that(result.outputs, equal_to(["alpha", "beta"]), label="initial outputs")
+        assert_that(result.failures, equal_to([]), label="initial failures")
+
+
+def test_chained_map_flat_map_and_filter_accumulate_all_step_failures():
+
+
+
+
+
+    with TestPipeline() as pipeline:
+        inputs = pipeline | "source accumulated" >> beam.Create(
+            ["ok", "bad-map", "flat-fail", "filter-seed"]
+        )
+
+        result = (
+            CollectionComposer.of(inputs)
+            .map("map step", map_step, prefix="pre-", suffix="-post")
+            .flat_map("flat step", flat_map_step, joiner="-", label="ignored")
+            .filter("filter step", filter_step, "pre-")
+        )
+
+        assert_that(
+            result.outputs,
+            equal_to(["pre-ok-post-keep", "pre-filter-seed-post-keep"]),
+            label="accumulated outputs",
+        )
+        assert_that(
+            result.failures,
+            equal_to(
+                [
+                    Failure(
+                        pipeline_step="map step",
+                        input_element="bad-map",
+
+                        exception=ValueError(),
+                    ),
+                    Failure(
+                        pipeline_step="flat step",
+                        input_element="pre-flat-fail-post",
+
+                        exception=ValueError(),
+                    ),
+                    Failure(
+                        pipeline_step="filter step",
+                        input_element="bad-filter",
+
+                        exception=ValueError(),
+                    ),
+                ],
+                equals_fn=same_failure,
+            ),
+            label="accumulated failures",
+        )
+
+
+def test_independent_composers_keep_their_own_outputs_and_failures():
+
+
+
+
+    with TestPipeline() as pipeline:
+        inputs = pipeline | "source independent" >> beam.Create(["a", "b", "boom"])
+        base = CollectionComposer.of(inputs)
+
+        mapped = base.map("independent map", fail_on_boom_mapper)
+        filtered = base.filter("independent filter", lambda element: element == "b")
+
+        assert_that(mapped.outputs, equal_to(["mapped-a", "mapped-b"]), label="mapped outputs")
+        assert_that(
+            mapped.failures,
+            equal_to(
+                [
+                    Failure(
+                        pipeline_step="independent map",
+                        input_element="boom",
+
+                        exception=ValueError(),
+                    )
+                ],
+                equals_fn=same_failure,
+            ),
+            label="mapped failures",
+        )
+        assert_that(filtered.outputs, equal_to(["b"]), label="filtered outputs")
+        assert_that(filtered.failures, equal_to([]), label="filtered failures")
+
+
+def fail_on_boom_mapper(element):
+    if element == "boom":
+        raise ValueError("boom from independent map")
+    return f"mapped-{element}"
