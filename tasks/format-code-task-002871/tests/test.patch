+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+export PIP_NO_INDEX=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+
+exec /usr/local/bin/python -m pytest /workspace/repo/usercase-test-coderl/test_collection_composer_failures.py -v
