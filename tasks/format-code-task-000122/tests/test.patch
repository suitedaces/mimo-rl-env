+        with pytest.raises(Exception) as err:
+            set_param_from_config(m.b, "theta", config={"parameter_data": {}})
+        assert str(err.value)
+
+    def test_missing_param_attribute_raises(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {"theta": 5}
+
+        with pytest.raises(Exception) as err:
+            set_param_from_config(m.b, "theta")
+        assert str(err.value)
+
+    def test_missing_parameter_data_raises(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {}
+        m.b.theta = Var(initialize=1)
+
+        with pytest.raises(Exception) as err:
+            set_param_from_config(m.b, "theta")
+        assert str(err.value)
+
+    def test_indexed_parameter_data_sets_indexed_attr(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {
+            "coeff": {"A": (1, units.m), "B": (2, units.m)}
+        }
+        m.b.coeff_A = Var(initialize=11, units=units.cm)
+        m.b.coeff_B = Var(initialize=12, units=units.cm)
+
+        set_param_from_config(m.b, "coeff", index="B")
+
+        assert m.b.coeff_B.value == pytest.approx(200)
+        assert m.b.coeff_A.value == 11
+
+    def test_missing_indexed_param_attribute_raises(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {"coeff": {"B": 2}}
+
+        with pytest.raises(Exception) as err:
+            set_param_from_config(m.b, "coeff", index="B")
+        assert str(err.value)
+
+    def test_missing_indexed_parameter_data_raises(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {"coeff": {"A": 1}}
+        m.b.coeff_B = Var(initialize=12)
+
+        with pytest.raises(Exception) as err:
+            set_param_from_config(m.b, "coeff", index="B")
+        assert str(err.value)
