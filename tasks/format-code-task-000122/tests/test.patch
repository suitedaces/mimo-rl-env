+@pytest.mark.unit
+class TestSetParamFromConfig:
+    def test_default_config_scalar(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {"alpha": 42}
+        m.b.alpha = Var(initialize=1)
+
+        set_param_from_config(m.b, "alpha")
+
+        assert m.b.alpha.value == 42
+
+    def test_explicit_config_scalar(self):
+        m = ConcreteModel()
+        m.b = Block()
+        cfg = ConfigBlock(implicit=True)
+        cfg.parameter_data = {"beta": 17}
+        m.b.beta = Var(initialize=0)
+
+        set_param_from_config(m.b, "beta", config=cfg)
+
+        assert m.b.beta.value == 17
+
+    def test_explicit_config_positional_third_argument(self):
+        m = ConcreteModel()
+        m.b = Block()
+        cfg = ConfigBlock(implicit=True)
+        cfg.parameter_data = {"beta": 23}
+        m.b.beta = Var(initialize=0)
+
+        set_param_from_config(m.b, "beta", cfg)
+
+        assert m.b.beta.value == 23
+
+    def test_tuple_units_converted_to_parameter_units(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {"length": (2.5, units.m)}
+        m.b.length = Var(initialize=0, units=units.cm)
+
+        set_param_from_config(m.b, "length")
+
+        assert m.b.length.value == pytest.approx(250)
+
+    def test_tuple_units_converted_second_case(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {"energy": (1.2, units.kJ / units.mol)}
+        m.b.energy = Var(initialize=0, units=units.J / units.mol)
+
+        set_param_from_config(m.b, "energy")
+
+        assert m.b.energy.value == pytest.approx(1200)
+
+    def test_dimensionless_tuple_bypasses_conversion(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {"gamma": (3.14, units.dimensionless)}
+        m.b.gamma = Var(initialize=0, units=units.dimensionless)
+
+        set_param_from_config(m.b, "gamma")
+
+        assert m.b.gamma.value == pytest.approx(3.14)
+
+    def test_dimensionless_param_accepts_none_units(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {"gamma": (2.72, None)}
+        m.b.gamma = Var(initialize=0, units=units.dimensionless)
+
+        set_param_from_config(m.b, "gamma")
+
+        assert m.b.gamma.value == pytest.approx(2.72)
+
+    def test_unitless_param_accepts_dimensionless_units(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {"epsilon": (8.5, units.dimensionless)}
+        m.b.epsilon = Var(initialize=0, units=None)
+
+        set_param_from_config(m.b, "epsilon")
+
+        assert m.b.epsilon.value == pytest.approx(8.5)
+
+    def test_unitless_dimensionless_pairs_are_assigned(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {
+            "gamma": (2.72, None),
+            "epsilon": (8.5, units.dimensionless),
+        }
+        m.b.gamma = Var(initialize=0, units=units.dimensionless)
+        m.b.epsilon = Var(initialize=0, units=None)
