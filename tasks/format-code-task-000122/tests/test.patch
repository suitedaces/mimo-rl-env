+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export PATH="$HOME/.pyenv/bin:$PATH"
+eval "$(pyenv init -)"
+pyenv global 3.9.22
+: "${PYTHONPATH:=}"
+export PYTHONPATH=/testbed:$PYTHONPATH
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest \
+      idaes/core/util/tests/test_misc.py \
+      idaes/core/tests/test_components.py \
+      -v
+    ;;
+  new)
+    python3 -m pytest \
+      idaes/core/util/tests/test_misc.py::TestSetParamFromConfig \
+      idaes/core/tests/test_components_import.py \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
