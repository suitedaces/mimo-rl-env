+    def test_scalar_object_assigned_without_numeric_coercion(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        marker = object()
+        m.b.config.parameter_data = {"marker": marker}
+
+        class Holder:
+            def __init__(self):
+                self.value = None
+
+            def get_units(self):
+                return None
+
+        m.b.marker = Holder()
+
+        set_param_from_config(m.b, "marker")
+
+        assert m.b.marker.value is marker
+
