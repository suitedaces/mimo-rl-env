+import importlib
+import types
+
+import pytest
+from pyomo.environ import ConcreteModel, Param, Var, units as pyunits
+
+from idaes.core.property_meta import PropertyClassMetadata
+
+
+def _model_with_default_units():
+    m = ConcreteModel()
+    m.meta_object = PropertyClassMetadata()
+
+    def get_metadata(self):
+        return m.meta_object
+
+    m.get_metadata = types.MethodType(get_metadata, m)
+    m.get_metadata().default_units["amount"] = pyunits.mol
+    m.get_metadata().default_units["mass"] = pyunits.kg
+    m.get_metadata().default_units["time"] = pyunits.s
+    m.get_metadata().default_units["length"] = pyunits.m
+    m.get_metadata().default_units["temperature"] = pyunits.K
+    return m
+
+
+@pytest.mark.unit
+def test_core_components_imports_without_generic_property_package():
+    module = importlib.import_module("idaes.core.components")
+
+    assert module.Component is not None
+
+
+@pytest.mark.unit
+def test_component_build_populates_parameter_data_after_direct_import():
+    module = importlib.import_module("idaes.core.components")
+    m = _model_with_default_units()
+
+    m.comp = module.Component(default={
+        "parameter_data": {
+            "mw": (18, pyunits.g / pyunits.mol),
+            "pressure_crit": (2, pyunits.bar),
+            "temperature_crit": (540, pyunits.degR),
+            "omega": 0.25,
+        }
+    })
+
+    assert isinstance(m.comp.mw, Param)
+    assert m.comp.mw.value == pytest.approx(0.018)
+    assert isinstance(m.comp.pressure_crit, Var)
+    assert m.comp.pressure_crit.value == pytest.approx(2e5)
+    assert isinstance(m.comp.temperature_crit, Var)
+    assert m.comp.temperature_crit.value == pytest.approx(300)
+    assert isinstance(m.comp.omega, Var)
+    assert m.comp.omega.value == pytest.approx(0.25)
