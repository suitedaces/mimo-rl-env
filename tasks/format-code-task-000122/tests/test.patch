+
+        assert m.b.gamma.value == pytest.approx(2.72)
+        assert m.b.epsilon.value == pytest.approx(8.5)
+
+    def test_unitless_none_tuple_bypasses_conversion(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {"delta": (9, None)}
+        m.b.delta = Var(initialize=0, units=None)
+
+        set_param_from_config(m.b, "delta")
+
+        assert m.b.delta.value == 9
+
+    def test_scalar_zero_overwrites_initial_value(self):
+        m = ConcreteModel()
+        m.b = Block()
+        m.b.config = ConfigBlock(implicit=True)
+        m.b.config.parameter_data = {"zeta": 0}
