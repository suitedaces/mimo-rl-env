diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,49 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+dev-switch python3 3.12 2>/dev/null || true
+
+
+python3 -m pip install --no-input --break-system-packages \
+  "pydantic>=1.10,<2.0" \
+  "pydantic-factories>=1.17,<2.0" \
+  "pydantic-openapi-schema>=1.4,<2.0" \
+  "httpx>=0.22,<0.24" \
+  "starlette>=0.21,<0.26" \
+  pytest pytest-asyncio pytest-cov freezegun hypothesis \
+  anyio aiosqlite greenlet sqlalchemy redis fakeredis \
+  aiomcache beautifulsoup4 jinja2 mako cryptography picologging \
+  > /dev/null 2>&1
+
+
+python3 -m pip install --no-input --break-system-packages -e /testbed > /dev/null 2>&1
+
+
+python3 -m pip install --no-input --break-system-packages "pydantic>=1.10,<2.0" > /dev/null 2>&1
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest \
+      tests/middleware/session/test_middleware.py::test_integration \
+      tests/testing/test_testing.py::test_test_client_set_session_data \
+      tests/testing/test_testing.py::test_test_client_get_session_data \
+      -q
+    ;;
+  new)
+    python3 -m pytest \
+      tests/middleware/session/test_middleware.py::test_set_session_empty_clears_session_across_backends \
+      tests/middleware/session/test_middleware.py::test_empty_session_removes_server_side_data_for_existing_session_id \
+      tests/middleware/session/test_middleware.py::test_empty_dict_session_removes_server_side_data_for_existing_session_id \
+      tests/middleware/session/test_middleware.py::test_cookie_backend_empty_session_only_emits_clearing_cookie \
+      tests/testing/test_testing.py::test_create_test_client_session_config_annotation_accepts_server_side_backend_config \
+      tests/testing/test_testing.py::test_get_session_data_returns_empty_dict_for_missing_server_side_session \
+      -q
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
