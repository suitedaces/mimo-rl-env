+def test_empty_session_removes_server_side_data_for_existing_session_id(
+    memory_session_backend_config: "ServerSideSessionConfig",
+) -> None:
+    @post("/create-session")
+    def create_session_handler(request: Request) -> None:
+        request.set_session({"user": "alice", "nonce": "server-empty"})
+
+    @post("/clear-session")
+    def clear_session_handler(request: Request) -> None:
+        request.set_session(Empty)
+
+    @get("/read-session")
+    def read_session_handler(request: Request) -> Dict[str, Any]:
+        return request.session
+
+    route_handlers = [create_session_handler, clear_session_handler, read_session_handler]
+    with create_test_client(
+        route_handlers=route_handlers,
+        middleware=[memory_session_backend_config.middleware],
+        session_config=memory_session_backend_config,
+    ) as client:
+        assert client.post("/create-session").status_code == HTTP_201_CREATED
+        session_id = client.cookies[memory_session_backend_config.key]
+        assert client.get_session_data() == {"user": "alice", "nonce": "server-empty"}
+        assert client.post("/clear-session").status_code == HTTP_201_CREATED
+        stored_data = run_async(client.session_backend.get, session_id)
+        if stored_data:
+            assert client.session_backend.deserialize_data(stored_data) != {"user": "alice", "nonce": "server-empty"}
+        assert client.get_session_data() == {}
+
+    with create_test_client(
