+def test_set_session_empty_clears_session_across_backends(
+    session_backend_config_async_safe: "BaseBackendConfig",
+) -> None:
+    @post("/create-session")
+    def create_session_handler(request: Request) -> None:
+        request.set_session({"user": "alice", "nonce": "empty-marker"})
+
+    @post("/clear-session")
+    def clear_session_handler(request: Request) -> None:
+        request.set_session(Empty)
+
+    with create_test_client(
+        route_handlers=[create_session_handler, clear_session_handler],
+        middleware=[session_backend_config_async_safe.middleware],
+        session_config=session_backend_config_async_safe,
+    ) as client:
+        assert client.post("/create-session").status_code == HTTP_201_CREATED
+        assert client.get_session_data() == {"user": "alice", "nonce": "empty-marker"}
+
+        response = client.post("/clear-session")
+
+        assert response.status_code == HTTP_201_CREATED
+        assert client.get_session_data() == {}
+
