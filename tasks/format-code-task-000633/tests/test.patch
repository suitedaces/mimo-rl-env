--- /dev/null
+++ b/usercase-test-coderl/test_crontab_from_string.py
@@ -0,0 +1,209 @@
+
+
+
+
+
+
+
+from __future__ import annotations
+
+import copy
+import json
+import os
+import socket
+import subprocess
+import sys
+
+import pytest
+
+from celery.schedules import crontab
+
+
+def schedule_snapshot(schedule: crontab) -> dict[str, object]:
+
+
+    return {
+        "minute": sorted(schedule.minute),
+        "hour": sorted(schedule.hour),
+        "day_of_month": sorted(schedule.day_of_month),
+        "month_of_year": sorted(schedule.month_of_year),
+        "day_of_week": sorted(schedule.day_of_week),
+    }
+
+
+def test_every_field_wildcard_matches_default_crontab():
+
+
+
+
+    actual = crontab.from_string("* * * * *")
+    expected = crontab()
+
+    assert actual == expected
+
+
+    assert schedule_snapshot(actual) == schedule_snapshot(expected)
+
+
+def test_named_weekday_is_interpreted_as_fifth_cron_field():
+
+
+
+
+    actual = crontab.from_string("* * * * SUN")
+    expected = crontab(day_of_week="SUN")
+
+    assert actual == expected
+
+
+    assert schedule_snapshot(actual) == schedule_snapshot(expected)
+
+
+def test_numeric_minute_hour_and_day_of_month_keep_cron_field_order():
+
+
+
+
+    actual = crontab.from_string("0 8 5 * *")
+    expected = crontab(minute="0", hour="8", day_of_month="5")
+
+    assert actual == expected
+
+
+    assert schedule_snapshot(actual) == schedule_snapshot(expected)
+
+
+def test_all_five_fields_can_be_specific_values():
+
+
+
+
+    actual = crontab.from_string("15 0 1 1 MON")
+    expected = crontab(minute="15", hour="0", day_of_week="MON", day_of_month="1", month_of_year="1")
+
+    assert actual == expected
+
+
+    assert schedule_snapshot(actual) == schedule_snapshot(expected)
+
+
+def test_cron_steps_and_ranges_are_passed_to_normal_constructor_fields():
+
+
+
+
+    actual = crontab.from_string("*/20 9-17 * * MON-FRI")
+    expected = crontab(minute="*/20", hour="9-17", day_of_week="MON-FRI")
+
+    assert actual == expected
+
+
+    assert schedule_snapshot(actual) == schedule_snapshot(expected)
+
+
+def test_upper_bound_values_map_to_their_own_fields():
+
+
+
+
+    actual = crontab.from_string("59 23 31 12 SAT")
+    expected = crontab(minute="59", hour="23", day_of_week="SAT", day_of_month="31", month_of_year="12")
+
+    assert actual == expected
+
+
+    assert schedule_snapshot(actual) == schedule_snapshot(expected)
+
+
+
+
+@pytest.mark.parametrize("expression", ["", "*", "* * * *", "* * * * * *"])
+def test_rejects_inputs_without_exactly_five_space_separated_fields(expression: str):
+
+
+
+
+    with pytest.raises(ValueError):
+        crontab.from_string(expression)
+
+
+def test_referential_transparency_for_same_cron_string():
+    first = crontab.from_string("0 8 5 * *")
+    second = crontab.from_string("0 8 5 * *")
+
+    assert first == second
+
+    assert schedule_snapshot(first) == schedule_snapshot(second)
+
+
+def test_does_not_mutate_caller_input():
+    expression = "* * * * SUN"
+    before = copy.deepcopy(expression)
+
+    actual = crontab.from_string(expression)
+    expected = crontab(day_of_week="SUN")
+
+
+
+    assert schedule_snapshot(actual) == schedule_snapshot(expected)
+    assert expression == before
+
+
+def test_same_input_matches_fresh_process_result_after_other_calls():
+    expression = "*/20 9-17 * * MON-FRI"
+    in_process = schedule_snapshot(crontab.from_string(expression))
+
+
+
+    assert schedule_snapshot(crontab.from_string("* * * * *")) == schedule_snapshot(crontab())
+
+
+    assert schedule_snapshot(crontab.from_string("59 23 31 12 SAT")) == schedule_snapshot(
+        crontab(minute="59", hour="23", day_of_week="SAT", day_of_month="31", month_of_year="12")
+    )
+
+    script = f"""
+import json
+import sys
+sys.path.insert(0, {os.fsdecode('/workspace/repo')!r})
+from celery.schedules import crontab
+
+def schedule_snapshot(schedule):
+    return {{
+        "minute": sorted(schedule.minute),
+        "hour": sorted(schedule.hour),
+        "day_of_month": sorted(schedule.day_of_month),
+        "month_of_year": sorted(schedule.month_of_year),
+        "day_of_week": sorted(schedule.day_of_week),
+    }}
+
+sys.stdout.write(json.dumps(schedule_snapshot(crontab.from_string({expression!r})), sort_keys=True))
+"""
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    fresh_process = json.loads(completed.stdout)
+
+
+    assert in_process == fresh_process
+
+
+def test_no_filesystem_or_network_side_effects(tmp_path, monkeypatch):
+    def fail_socket(*args, **kwargs):
+        raise AssertionError("network access is not part of crontab.from_string")
+
+    monkeypatch.setattr(socket, "socket", fail_socket)
+    monkeypatch.chdir(tmp_path)
+    before = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob("*"))
+
+    actual = crontab.from_string("0 8 5 * *")
+    expected = crontab(minute="0", hour="8", day_of_month="5")
+
+    after = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob("*"))
+
+
+    assert schedule_snapshot(actual) == schedule_snapshot(expected)
+    assert after == before
