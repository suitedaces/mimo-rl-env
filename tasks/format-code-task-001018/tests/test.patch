@@ -0,0 +1,10 @@
+#!/bin/bash
+set -euo pipefail
+
+
+pytest -q \
+  tests/components/alexa/test_proactive_delta_codespec.py \
+  tests/components/alexa/test_state_report.py::test_report_state \
+  tests/components/alexa/test_smart_home.py::test_temp_sensor \
+  tests/components/alexa/test_smart_home.py::test_endpoint_good_health \
+  tests/components/alexa/test_smart_home.py::test_endpoint_bad_health
