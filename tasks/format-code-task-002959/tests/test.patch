diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+
+mkdir -p /root/go/src/volcano.sh
+ln -sfn /testbed /root/go/src/volcano.sh/volcano
+
+export GO111MODULE=off
+export GOPATH=/root/go
+
+cd /root/go/src/volcano.sh/volcano
+
+case "${1:-}" in
+  base)
+    go vet ./test/e2e/
+    go test -c -o /dev/null ./test/e2e/
+    go build ./...
+    ;;
+  new)
+    go test ./pkg/apis/batch/v1alpha1 -run 'TestJob(TTLFieldRoundTripAndDeepCopy|StateLastTransitionTimeDeepCopy)$' -count=1
+    go test ./cmd/controllers/app -run 'TestControllerManagerStartsTTLCleanup$' -count=1
+    go build ./...
+    go test -c -o /dev/null ./test/e2e/
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
