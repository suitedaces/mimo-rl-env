diff --git a/test/yargs-parser.js b/test/yargs-parser.js
index ee76e41..69a988d 100644
--- a/test/yargs-parser.js
+++ b/test/yargs-parser.js
@@ -2863,4 +2863,60 @@ describe('yargs-parser', function () {
     })
     argv.bar.should.equal('hello')
   })
+
+
+  describe('non-string values in argv array', function () {
+    it('should not throw a TypeError when a number is provided as a value', function () {
+      var fn = function () { parser(['--p', 2]) }
+      expect(fn).to.not.throw()
+    })
+
+    it('should parse number value passed in argv array to the same result as the equivalent string value', function () {
+      var parsed = parser(['--p', 2])
+      parsed.should.have.property('p', 2)
+      parsed.should.have.property('_').with.length(0)
+    })
+
+    it('should preserve correct parsing when a string number is provided (regression baseline)', function () {
+      var parsed = parser(['--p', '2'])
+      parsed.should.have.property('p', 2)
+      parsed.should.have.property('_').with.length(0)
+    })
+
+    it('should coerce boolean true in argv array to the string "true"', function () {
+      var parsed = parser(['--p', true])
+      parsed.should.have.property('p', 'true')
+      parsed.should.have.property('_').with.length(0)
+    })
+
+    it('should coerce boolean false in argv array to the string "false"', function () {
+      var parsed = parser(['--p', false])
+      parsed.should.have.property('p', 'false')
+      parsed.should.have.property('_').with.length(0)
+    })
+
+    it('should handle a short option with a numeric value', function () {
+      var parsed = parser(['-n', 123])
+      parsed.should.have.property('n', 123)
+      parsed.should.have.property('_').with.length(0)
+    })
+
+    it('should handle multiple options each with numeric values', function () {
+      var parsed = parser(['--a', 1, '--b', 2])
+      parsed.should.have.property('a', 1)
+      parsed.should.have.property('b', 2)
+      parsed.should.have.property('_').with.length(0)
+    })
+
+    it('should not throw when a non-string value appears as a positional bare argument', function () {
+      var fn = function () { parser([1, '--p', 2]) }
+      expect(fn).to.not.throw()
+    })
+
+    it('should parse positional bare number plus flag with numeric value', function () {
+      var parsed = parser([1, '--p', 2])
+      parsed.should.have.property('p', 2)
+      parsed._.should.deep.equal([1])
+    })
+  })
 })
