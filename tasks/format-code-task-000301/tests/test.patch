+++ b/usercase-test-coderl/overlap_lifecycle_test.go
@@ -0,0 +1,227 @@
+package usercase_test_coderl
+
+import (
+	"context"
+	"log"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/adhocore/gronx/pkg/tasker"
+)
+
+type discardWriter struct{}
+
+func (discardWriter) Write(p []byte) (int, error) {
+	return len(p), nil
+}
+
+func observeMax(max *int32, value int32) {
+	for {
+		current := atomic.LoadInt32(max)
+		if value <= current || atomic.CompareAndSwapInt32(max, current, value) {
+			return
+		}
+	}
+}
+
+func newQuietTasker() *tasker.Tasker {
+	t := tasker.New(tasker.Option{})
+	t.Log = log.New(discardWriter{}, "", 0)
+	return t
+}
+
+func runTaskerWithTimeout(t *testing.T, taskr *tasker.Tasker, limit time.Duration) {
+	t.Helper()
+
+	done := make(chan struct{})
+	go func() {
+		taskr.Run()
+		close(done)
+	}()
+
+	select {
+	case <-done:
+	case <-time.After(limit):
+		t.Fatalf("tasker.Run did not return within %s", limit)
+	}
+}
+
+func TestNonOverlappingRegistrationSkipsDueTicksWhileConcurrentRegistrationsContinue(t *testing.T) {
+
+
+	taskr := newQuietTasker()
+
+	var single int32
+	var omitted int32
+	var explicitTrue int32
+
+	taskr.Task("* * * * * *", func(context.Context) (int, error) {
+		atomic.AddInt32(&single, 1)
+		time.Sleep(2500 * time.Millisecond)
+		return 0, nil
+	}, false)
+	taskr.Task("* * * * * *", func(context.Context) (int, error) {
+		atomic.AddInt32(&omitted, 1)
+		time.Sleep(100 * time.Millisecond)
+		return 0, nil
+	})
+	taskr.Task("* * * * * *", func(context.Context) (int, error) {
+		atomic.AddInt32(&explicitTrue, 1)
+		time.Sleep(100 * time.Millisecond)
+		return 0, nil
+	}, true)
+
+	taskr.Until(3 * time.Second)
+	runTaskerWithTimeout(t, taskr, 6*time.Second)
+
+	if atomic.LoadInt32(&single) != 1 {
+		t.Fatalf("non-overlapping callback invocations = %d, want 1", atomic.LoadInt32(&single))
+	}
+
+	if atomic.LoadInt32(&omitted) < 2 {
+		t.Fatalf("omitted concurrent callback invocations = %d, want at least 2", atomic.LoadInt32(&omitted))
+	}
+
+	if atomic.LoadInt32(&explicitTrue) < 2 {
+		t.Fatalf("explicit true callback invocations = %d, want at least 2", atomic.LoadInt32(&explicitTrue))
+	}
+}
+
+func TestNonOverlappingRegistrationRunsAgainAfterPriorInvocationReturns(t *testing.T) {
+
+
+	taskr := newQuietTasker()
+	var starts int32
+	var active int32
+	var maxActive int32
+
+	taskr.Task("* * * * * *", func(context.Context) (int, error) {
+		nowActive := atomic.AddInt32(&active, 1)
+		observeMax(&maxActive, nowActive)
+		defer atomic.AddInt32(&active, -1)
+		atomic.AddInt32(&starts, 1)
+		time.Sleep(2500 * time.Millisecond)
+		return 0, nil
+	}, false)
+
+	taskr.Until(5 * time.Second)
+	runTaskerWithTimeout(t, taskr, 8*time.Second)
+
+
+	if atomic.LoadInt32(&starts) < 2 {
+		t.Fatalf("non-overlapping callback starts after a longer run = %d, want at least 2", atomic.LoadInt32(&starts))
+	}
+	if atomic.LoadInt32(&maxActive) > 1 {
+		t.Fatalf("non-overlapping callback max active invocations = %d, want at most 1", atomic.LoadInt32(&maxActive))
+	}
+}
+
+func TestNonOverlappingRegistrationsKeepOverlapStateIndependent(t *testing.T) {
+
+
+	taskr := newQuietTasker()
+
+	var aStarts int32
+	var bStarts int32
+
+	taskr.Task("* * * * * *", func(context.Context) (int, error) {
+		atomic.AddInt32(&aStarts, 1)
+		time.Sleep(2500 * time.Millisecond)
+		return 0, nil
+	}, false)
+	taskr.Task("* * * * * *", func(context.Context) (int, error) {
+		atomic.AddInt32(&bStarts, 1)
+		time.Sleep(100 * time.Millisecond)
+		return 0, nil
+	}, false)
+
+	taskr.Until(3 * time.Second)
+	runTaskerWithTimeout(t, taskr, 6*time.Second)
+
+	if atomic.LoadInt32(&aStarts) != 1 {
+		t.Fatalf("first non-overlapping registration callback starts = %d, want 1", atomic.LoadInt32(&aStarts))
+	}
+
+	if atomic.LoadInt32(&bStarts) < 2 {
+		t.Fatalf("second non-overlapping registration callback starts = %d, want at least 2", atomic.LoadInt32(&bStarts))
+	}
+}
+
+func TestTaskRegistrationBeforeRunStartsCallback(t *testing.T) {
+
+
+
+	taskr := newQuietTasker()
+	var starts int32
+
+	taskr.Task("* * * * * *", func(context.Context) (int, error) {
+		atomic.AddInt32(&starts, 1)
+		return 0, nil
+	}, false)
+
+	taskr.Until(1500 * time.Millisecond)
+	runTaskerWithTimeout(t, taskr, 4*time.Second)
+
+	if atomic.LoadInt32(&starts) < 1 {
+		t.Fatalf("registered callback starts = %d, want at least 1", atomic.LoadInt32(&starts))
+	}
+}
+
+func TestOmittedConcurrentArgumentAllowsOverlap(t *testing.T) {
+
+
+
+	taskr := newQuietTasker()
+	var starts int32
+	var active int32
+	var maxActive int32
+
+	taskr.Task("* * * * * *", func(context.Context) (int, error) {
+		nowActive := atomic.AddInt32(&active, 1)
+		observeMax(&maxActive, nowActive)
+		defer atomic.AddInt32(&active, -1)
+		atomic.AddInt32(&starts, 1)
+		time.Sleep(1500 * time.Millisecond)
+		return 0, nil
+	})
+
+	taskr.Until(3 * time.Second)
+	runTaskerWithTimeout(t, taskr, 6*time.Second)
+
+	if atomic.LoadInt32(&starts) < 2 {
+		t.Fatalf("omitted concurrent callback starts = %d, want at least 2", atomic.LoadInt32(&starts))
+	}
+	if atomic.LoadInt32(&maxActive) < 2 {
+		t.Fatalf("omitted concurrent callback max active invocations = %d, want at least 2", atomic.LoadInt32(&maxActive))
+	}
+}
+
+func TestExplicitTrueConcurrentArgumentAllowsOverlap(t *testing.T) {
+
+
+
+	taskr := newQuietTasker()
+	var starts int32
+	var active int32
+	var maxActive int32
+
+	taskr.Task("* * * * * *", func(context.Context) (int, error) {
+		nowActive := atomic.AddInt32(&active, 1)
+		observeMax(&maxActive, nowActive)
+		defer atomic.AddInt32(&active, -1)
+		atomic.AddInt32(&starts, 1)
+		time.Sleep(1500 * time.Millisecond)
+		return 0, nil
+	}, true)
+
+	taskr.Until(3 * time.Second)
+	runTaskerWithTimeout(t, taskr, 6*time.Second)
+
+	if atomic.LoadInt32(&starts) < 2 {
+		t.Fatalf("explicit true callback starts = %d, want at least 2", atomic.LoadInt32(&starts))
+	}
+	if atomic.LoadInt32(&maxActive) < 2 {
+		t.Fatalf("explicit true callback max active invocations = %d, want at least 2", atomic.LoadInt32(&maxActive))
+	}
+}
