--- /dev/null
+++ b/usercase-test-coderl/test_loader_load.py
@@ -0,0 +1,218 @@
+import io
+import sys
+
+import pytest
+import yaml
+
+from maestro import exceptions, loader
+
+
+def _write(path, text):
+    path.write_text(text, encoding="utf-8")
+    return str(path)
+
+
+def test_file_path_renders_env_and_adds_maestro_base_dir(tmp_path, monkeypatch):
+
+
+
+    env_dir = tmp_path / "envs"
+    env_dir.mkdir()
+    filename = _write(env_dir / "demo.yaml", "name: demo\nfoo: {{ env.BAR }}\n")
+    monkeypatch.setenv("BAR", "bar")
+
+    actual = loader.load(filename)
+
+    assert actual == {
+        "name": "demo",
+        "foo": "bar",
+        "__maestro": {"base_dir": str(env_dir)},
+    }
+
+
+def test_existing_maestro_keys_are_preserved_and_base_dir_is_set(tmp_path):
+
+
+
+    env_dir = tmp_path / "envs"
+    env_dir.mkdir()
+    filename = _write(
+        env_dir / "existing.yaml",
+        "__maestro:\n  owner: ops\nname: demo2\nnested:\n  flag: true\n",
+    )
+
+    actual = loader.load(filename)
+
+    assert actual == {
+        "__maestro": {"owner": "ops", "base_dir": str(env_dir)},
+        "name": "demo2",
+        "nested": {"flag": True},
+    }
+
+
+def test_custom_filters_and_functions_are_available_during_rendering(tmp_path, monkeypatch):
+
+
+
+    env_dir = tmp_path / "envs"
+    env_dir.mkdir()
+    filename = _write(
+        env_dir / "filter_global.yaml",
+        'name: {{ service_name("api")|shout }}\ncount: {{ "one"|length }}\ncolor: {{ env.COLOR }}\n',
+    )
+    monkeypatch.setenv("COLOR", "blue")
+
+    actual = loader.load(
+        filename,
+        filters={"shout": lambda value: value.upper() + "!"},
+        functions={"service_name": lambda name: "svc-" + name},
+    )
+
+    assert actual == {
+        "name": "SVC-API!",
+        "count": 3,
+        "color": "blue",
+        "__maestro": {"base_dir": str(env_dir)},
+    }
+
+
+def test_templates_are_resolved_relative_to_file_directory(tmp_path, monkeypatch):
+
+
+
+    env_dir = tmp_path / "envs"
+    env_dir.mkdir()
+    _write(env_dir / "fragment.yaml", "{{ env.BAR }}-fragment\n")
+    filename = _write(
+        env_dir / "include.yaml",
+        'name: include-demo\nchild: {% include "fragment.yaml" %}\n',
+    )
+    monkeypatch.setenv("BAR", "bar")
+
+    actual = loader.load(filename)
+
+    assert actual == {
+        "name": "include-demo",
+        "child": "bar-fragment",
+        "__maestro": {"base_dir": str(env_dir)},
+    }
+
+
+def test_stdin_template_uses_current_working_directory_as_base_dir(tmp_path, monkeypatch):
+
+
+
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("STDIN_VALUE", "from-stdin")
+    monkeypatch.setattr(
+        sys,
+        "stdin",
+        io.StringIO(
+            "name: stdin-demo\nfoo: {{ env.STDIN_VALUE }}\n__maestro:\n  channel: pipe\n"
+        ),
+    )
+
+    actual = loader.load("-")
+
+    assert actual == {
+        "name": "stdin-demo",
+        "foo": "from-stdin",
+        "__maestro": {"channel": "pipe", "base_dir": str(tmp_path)},
+    }
+
+
+def test_duplicate_yaml_mapping_keys_raise_constructor_error(tmp_path):
+
+
+
+    filename = _write(tmp_path / "duplicate.yaml", "name: first\nname: second\n")
+
+    with pytest.raises(yaml.constructor.ConstructorError) as excinfo:
+        loader.load(filename)
+
+
+    assert isinstance(excinfo.value, yaml.constructor.ConstructorError)
+
+
+def test_missing_named_template_file_raises_maestro_exception(tmp_path):
+
+
+
+    filename = str(tmp_path / "missing.yaml")
+
+    with pytest.raises(exceptions.MaestroException) as excinfo:
+        loader.load(filename)
+
+
+    assert "not found" in str(excinfo.value).lower()
+
+
+def test_template_read_failures_are_wrapped_as_maestro_exception(tmp_path):
+
+
+
+    filename = _write(tmp_path / "syntax.yaml", "name: {% if true %}\n")
+
+    with pytest.raises(exceptions.MaestroException) as excinfo:
+        loader.load(filename)
+
+
+    message = str(excinfo.value).lower()
+    assert message
+    assert "error" in message or "fail" in message or "read" in message
+
+
+def test_referential_transparency_same_input_returns_same_value(tmp_path, monkeypatch):
+    env_dir = tmp_path / "envs"
+    env_dir.mkdir()
+    filename = _write(env_dir / "same.yaml", "name: repeat\nfoo: {{ env.BAR }}\n")
+    monkeypatch.setenv("BAR", "bar")
+
+    assert loader.load(filename) == loader.load(filename)
+
+
+def test_load_does_not_mutate_caller_supplied_filter_or_function_mappings(tmp_path):
+    env_dir = tmp_path / "envs"
+    env_dir.mkdir()
+    filename = _write(
+        env_dir / "custom.yaml",
+        'name: {{ service_name("api")|shout }}\n',
+    )
+    inputs = {
+        "filters": {"shout": lambda value: value.upper() + "!"},
+        "functions": {"service_name": lambda name: "svc-" + name},
+    }
+
+    actual = loader.load(filename, filters=inputs["filters"], functions=inputs["functions"])
+
+
+    assert actual == {
+        "name": "SVC-API!",
+        "__maestro": {"base_dir": str(env_dir)},
+    }
+
+
+def test_load_has_no_same_key_process_global_cache(tmp_path, monkeypatch):
+    env_dir = tmp_path / "envs"
+    env_dir.mkdir()
+    filename = _write(env_dir / "fresh.yaml", "name: fresh\nfoo: {{ env.BAR }}\n")
+    monkeypatch.setenv("BAR", "first")
+    first = loader.load(filename)
+    monkeypatch.setenv("BAR", "second")
+    second = loader.load(filename)
+
+
+    assert first["foo"] == "first"
+    assert second["foo"] == "second"
+    assert first["__maestro"]["base_dir"] == str(env_dir)
+    assert second["__maestro"]["base_dir"] == str(env_dir)
+
+
+def test_load_does_not_create_cwd_files_or_open_network_sockets(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    filename = _write(tmp_path / "side_effect.yaml", "name: quiet\n")
+
+    actual = loader.load(filename)
+
+
+    assert actual == {"name": "quiet", "__maestro": {"base_dir": str(tmp_path)}}
