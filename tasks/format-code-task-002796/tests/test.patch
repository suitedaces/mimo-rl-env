diff --git a/packages/tailwindcss/src/utilities.test.ts b/packages/tailwindcss/src/utilities.test.ts
index 23d2bb21..d9c58ad0 100644
--- a/packages/tailwindcss/src/utilities.test.ts
+++ b/packages/tailwindcss/src/utilities.test.ts
@@ -15859,3 +15859,95 @@ describe('custom utilities', () => {
     )
   })
 })
+
+describe('logical inline/block precedence (issue: ps/pe vs px)', () => {
+  async function compile(candidates: string[]) {
+    return compileCss(
+      css`
+        @theme {
+          --spacing-5: 1.25rem;
+          --spacing-10: 2.5rem;
+        }
+        @tailwind utilities;
+      `,
+      candidates,
+    )
+  }
+
+
+
+
+  test('ps-10 overrides px-5 (ps rule comes after px rule)', async () => {
+    let out = await compile(['px-5', 'ps-10'])
+    let pxIdx = out.indexOf('.px-5')
+    let psIdx = out.indexOf('.ps-10')
+    expect(pxIdx).toBeGreaterThan(-1)
+    expect(psIdx).toBeGreaterThan(-1)
+    expect(psIdx).toBeGreaterThan(pxIdx)
+  })
+
+  test('pe-10 overrides px-5 (pe rule comes after px rule)', async () => {
+    let out = await compile(['px-5', 'pe-10'])
+    let pxIdx = out.indexOf('.px-5')
+    let peIdx = out.indexOf('.pe-10')
+    expect(pxIdx).toBeGreaterThan(-1)
+    expect(peIdx).toBeGreaterThan(-1)
+    expect(peIdx).toBeGreaterThan(pxIdx)
+  })
+
+  test('scroll-ps-10 overrides scroll-px-5 (scroll-ps rule comes after scroll-px rule)', async () => {
+    let out = await compile(['scroll-px-5', 'scroll-ps-10'])
+    let pxIdx = out.indexOf('.scroll-px-5')
+    let psIdx = out.indexOf('.scroll-ps-10')
+    expect(pxIdx).toBeGreaterThan(-1)
+    expect(psIdx).toBeGreaterThan(-1)
+    expect(psIdx).toBeGreaterThan(pxIdx)
+  })
+
+  test('scroll-pe-10 overrides scroll-px-5 (scroll-pe rule comes after scroll-px rule)', async () => {
+    let out = await compile(['scroll-px-5', 'scroll-pe-10'])
+    let pxIdx = out.indexOf('.scroll-px-5')
+    let peIdx = out.indexOf('.scroll-pe-10')
+    expect(pxIdx).toBeGreaterThan(-1)
+    expect(peIdx).toBeGreaterThan(-1)
+    expect(peIdx).toBeGreaterThan(pxIdx)
+  })
+
+  test('scroll-ms-10 overrides scroll-mx-5 (scroll-ms rule comes after scroll-mx rule)', async () => {
+    let out = await compile(['scroll-mx-5', 'scroll-ms-10'])
+    let mxIdx = out.indexOf('.scroll-mx-5')
+    let msIdx = out.indexOf('.scroll-ms-10')
+    expect(mxIdx).toBeGreaterThan(-1)
+    expect(msIdx).toBeGreaterThan(-1)
+    expect(msIdx).toBeGreaterThan(mxIdx)
+  })
+
+  test('scroll-me-10 overrides scroll-mx-5 (scroll-me rule comes after scroll-mx rule)', async () => {
+    let out = await compile(['scroll-mx-5', 'scroll-me-10'])
+    let mxIdx = out.indexOf('.scroll-mx-5')
+    let meIdx = out.indexOf('.scroll-me-10')
+    expect(mxIdx).toBeGreaterThan(-1)
+    expect(meIdx).toBeGreaterThan(-1)
+    expect(meIdx).toBeGreaterThan(mxIdx)
+  })
+
+
+
+  test('ms-10 overrides mx-5 (preservation, ms rule comes after mx rule)', async () => {
+    let out = await compile(['mx-5', 'ms-10'])
+    let mxIdx = out.indexOf('.mx-5')
+    let msIdx = out.indexOf('.ms-10')
+    expect(mxIdx).toBeGreaterThan(-1)
+    expect(msIdx).toBeGreaterThan(-1)
+    expect(msIdx).toBeGreaterThan(mxIdx)
+  })
+
+
+  test('px-5 still emits padding-left and padding-right', async () => {
+    let out = await compile(['px-5'])
+    expect(out).toContain('padding-left: var(--spacing-5, 1.25rem)')
+    expect(out).toContain('padding-right: var(--spacing-5, 1.25rem)')
+
+    expect(out).not.toContain('--tw-sort')
+  })
+})
