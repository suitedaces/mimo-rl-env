diff --git a/usercase-test-coderl/plugin_lifecycle.test.js b/usercase-test-coderl/plugin_lifecycle.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/plugin_lifecycle.test.js
@@ -0,0 +1,481 @@
+
+
+
+
+
+
+
+
+
+
+
+var expect = require('chai').expect;
+var fs = require('fs');
+var path = require('path');
+var vm = require('vm');
+
+function installWebAudioHarness() {
+  var nextNodeId = 1;
+  var activeConnections = [];
+
+  function removeConnection(source, target) {
+    for (var i = activeConnections.length - 1; i >= 0; i--) {
+      if (activeConnections[i].source === source && activeConnections[i].target === target) {
+        activeConnections.splice(i, 1);
+      }
+    }
+  }
+
+  function FakeAudioParam(defaultValue) {
+    this.value = defaultValue;
+    this.events = [];
+  }
+
+  FakeAudioParam.prototype.setValueAtTime = function(value, time) {
+    this.value = value;
+    this.events.push(['setValueAtTime', value, time]);
+  };
+
+  FakeAudioParam.prototype.linearRampToValueAtTime = function(value, time) {
+    this.value = value;
+    this.events.push(['linearRampToValueAtTime', value, time]);
+  };
+
+  FakeAudioParam.prototype.exponentialRampToValueAtTime = function(value, time) {
+    this.value = value;
+    this.events.push(['exponentialRampToValueAtTime', value, time]);
+  };
+
+  FakeAudioParam.prototype.setTargetAtTime = function(value, time, constant) {
+    this.value = value;
+    this.events.push(['setTargetAtTime', value, time, constant]);
+  };
+
+  FakeAudioParam.prototype.cancelScheduledValues = function(time) {
+    this.events.push(['cancelScheduledValues', time]);
+  };
+
+  function FakeAudioNode(kind) {
+    this.kind = kind;
+    this.id = nextNodeId++;
+    this.gain = new FakeAudioParam(1);
+    this._outgoing = [];
+    this._incoming = [];
+  }
+
+  FakeAudioNode.prototype.connect = function(target) {
+    if (!(target instanceof FakeAudioNode)) {
+      throw new TypeError('target must be an AudioNode');
+    }
+    this._outgoing.push(target);
+    target._incoming.push(this);
+    activeConnections.push({ source: this, target: target });
+  };
+
+  FakeAudioNode.prototype.disconnect = function() {
+    while (this._outgoing.length > 0) {
+      var target = this._outgoing.pop();
+      var incomingIndex = target._incoming.indexOf(this);
+      if (incomingIndex > -1) {
+        target._incoming.splice(incomingIndex, 1);
+      }
+      removeConnection(this, target);
+    }
+  };
+
+  FakeAudioNode.prototype.incomingConnectionCount = function() {
+    return this._incoming.length;
+  };
+
+  FakeAudioNode.prototype.outgoingConnectionCount = function() {
+    return this._outgoing.length;
+  };
+
+  FakeAudioNode.activeConnectionCount = function() {
+    return activeConnections.length;
+  };
+
+  function FakeAudioContext() {
+    this.currentTime = 1.25;
+    this.sampleRate = 44100;
+    this.destination = new FakeAudioNode('Destination');
+  }
+
+  FakeAudioContext.prototype.createGain = function() {
+    return new FakeAudioNode('Gain');
+  };
+
+  FakeAudioContext.prototype.createOscillator = function() {
+    var node = new FakeAudioNode('Oscillator');
+    node.start = function() {};
+    node.stop = function() {};
+    return node;
+  };
+
+  FakeAudioContext.prototype.createDelay = function() {
+    return new FakeAudioNode('Delay');
+  };
+
+  FakeAudioContext.prototype.createBiquadFilter = function() {
+    return new FakeAudioNode('BiquadFilter');
+  };
+
+  FakeAudioContext.prototype.createDynamicsCompressor = function() {
+    return new FakeAudioNode('DynamicsCompressor');
+  };
+
+  FakeAudioContext.prototype.createConvolver = function() {
+    return new FakeAudioNode('Convolver');
+  };
+
+  FakeAudioContext.prototype.createWaveShaper = function() {
+    return new FakeAudioNode('WaveShaper');
+  };
+
+  FakeAudioContext.prototype.createBufferSource = function() {
+    return new FakeAudioNode('BufferSource');
+  };
+
+  FakeAudioContext.prototype.createAnalyser = function() {
+    return new FakeAudioNode('Analyser');
+  };
+
+  FakeAudioContext.prototype.createPanner = function() {
+    return new FakeAudioNode('Panner');
+  };
+
+  FakeAudioContext.prototype.createPeriodicWave = function() {
+    return { kind: 'PeriodicWave' };
+  };
+
+  FakeAudioContext.prototype.createChannelSplitter = function() {
+    return new FakeAudioNode('ChannelSplitter');
+  };
+
+  FakeAudioContext.prototype.createChannelMerger = function() {
+    return new FakeAudioNode('ChannelMerger');
+  };
+
+  FakeAudioContext.prototype.createBuffer = function() {
+    return { kind: 'Buffer' };
+  };
+
+  global.window = global;
+  global.console = console;
+  global.AudioNode = FakeAudioNode;
+  global.AudioParam = FakeAudioParam;
+  global.AudioContext = FakeAudioContext;
+  delete global.webkitAudioContext;
+  delete global.WX;
+
+  return FakeAudioNode;
+}
+
+function loadScript(relativePath) {
+  var filename = path.join('/workspace/repo', relativePath);
+  var code = fs.readFileSync(filename, 'utf8');
+  vm.runInThisContext(code, { filename: filename });
+}
+
+function loadWaax() {
+  var FakeAudioNode = installWebAudioHarness();
+  loadScript('src/waax.js');
+  loadScript('src/waax.util.js');
+  loadScript('src/waax.extension.js');
+  loadScript('src/waax.core.js');
+  loadScript('src/plug_ins/Fader/fader.js');
+  WX.Log.setLevel(3);
+  return {
+    WX: WX,
+    FakeAudioNode: FakeAudioNode
+  };
+}
+
+function expectPlainObjectSnapshot(snapshot) {
+  expect(snapshot).to.be.an('object');
+  expect(snapshot).to.not.equal(null);
+  expect(Object.getPrototypeOf(snapshot)).to.equal(Object.prototype);
+}
+
+function installProbeParam(plugin, name, defaultValue) {
+  plugin.params[name] = {
+    value: defaultValue,
+    set: function(value, time, rampType) {
+      plugin.params[name].value = value;
+      plugin.events.push([value, time === undefined ? 'undefined' : time, rampType === undefined ? 'undefined' : rampType]);
+    },
+    get: function() {
+      return plugin.params[name].value;
+    }
+  };
+}
+
+function registerProbeFactories(WX) {
+  function ProbeGenerator(preset) {
+    this.events = [];
+    WX.PlugIn.defineType(this, 'Generator');
+    installProbeParam(this, 'gain', 0.2);
+    WX.PlugIn.initPreset(this, preset);
+  }
+
+  ProbeGenerator.prototype = {
+    info: {
+      name: 'ProbeGenerator',
+      api_version: '1.0.0-alpha',
+      type: 'Generator'
+    },
+    defaultPreset: {
+      gain: 0.2
+    },
+    $gain: function() {}
+  };
+
+  function ProbeProcessor(preset) {
+    this.events = [];
+    WX.PlugIn.defineType(this, 'Processor');
+    installProbeParam(this, 'gain', 0.4);
+    WX.PlugIn.initPreset(this, preset);
+  }
+
+  ProbeProcessor.prototype = {
+    info: {
+      name: 'ProbeProcessor',
+      api_version: '1.0.0-alpha',
+      type: 'Processor'
+    },
+    defaultPreset: {
+      gain: 0.4
+    },
+    $gain: function() {}
+  };
+
+  function ProbeAnalyzer(preset) {
+    this.events = [];
+    WX.PlugIn.defineType(this, 'Analyzer');
+    installProbeParam(this, 'gain', 0.6);
+    WX.PlugIn.initPreset(this, preset);
+  }
+
+  ProbeAnalyzer.prototype = {
+    info: {
+      name: 'ProbeAnalyzer',
+      api_version: '1.0.0-alpha',
+      type: 'Analyzer'
+    },
+    defaultPreset: {
+      gain: 0.6
+    },
+    $gain: function() {}
+  };
+
+  WX.PlugIn.extendPrototype(ProbeGenerator, 'Generator');
+  WX.PlugIn.extendPrototype(ProbeProcessor, 'Processor');
+  WX.PlugIn.extendPrototype(ProbeAnalyzer, 'Analyzer');
+  WX.PlugIn.register(ProbeGenerator);
+  WX.PlugIn.register(ProbeProcessor);
+  WX.PlugIn.register(ProbeAnalyzer);
+}
+
+describe('WAAX plug-in stateful control surface', function() {
+  it('updates Fader parameters immediately and reports unknown parameters as null', function() {
+
+
+
+
+    var env = loadWaax();
+    var fader = env.WX.Fader();
+
+
+    expect(fader.get('input')).to.not.equal(null);
+    expect(fader.get('output')).to.not.equal(null);
+    expect(fader.get('notAParam')).to.equal(null);
+    expect(fader.set('input', 0.25)).to.equal(fader);
+    expect(fader.get('input')).to.equal(0.25);
+    expect(fader.set('missing', 0.99)).to.equal(fader);
+    expect(fader.get('missing')).to.equal(null);
+    expect(fader.get('input')).to.equal(0.25);
+  });
+
+  it('applies envelope points to a registered processor parameter in order', function() {
+
+
+
+
+    var env = loadWaax();
+    registerProbeFactories(env.WX);
+    var processor = env.WX.ProbeProcessor();
+
+
+    expect(processor.get('gain')).to.not.equal(null);
+    processor.events = [];
+    expect(processor.set('gain', [[0.0], [1.0, 0.01, 1], [0.0, 0.5, 2]])).to.equal(processor);
+    expect(processor.get('gain')).to.equal(0);
+    expect(processor.events).to.deep.equal([
+      [0, 'undefined', 'undefined'],
+      [1, 0.01, 1],
+      [0, 0.5, 2]
+    ]);
+  });
+
+  it('sets and snapshots Fader presets as plain parameter objects', function() {
+
+
+
+
+    var env = loadWaax();
+    var fader = env.WX.Fader();
+
+
+    var initialPreset = fader.getPreset();
+    expectPlainObjectSnapshot(initialPreset);
+    expect(initialPreset).to.have.property('input');
+    expect(initialPreset).to.have.property('output');
+
+    expect(function() {
+      fader.setPreset({ input: 0.5, output: 0.75 });
+    }).to.not.throw(Error);
+    expect(fader.get('input')).to.equal(0.5);
+    expect(fader.get('output')).to.equal(0.75);
+    var appliedPreset = fader.getPreset();
+    expectPlainObjectSnapshot(appliedPreset);
+    expect(appliedPreset).to.include({ input: 0.5, output: 0.75 });
+  });
+
+  it('routes to plug-ins and native AudioNodes, returns targets, and cut disconnects outgoing patching', function() {
+
+
+
+
+    var env = loadWaax();
+    var source = env.WX.Fader();
+    var processorTarget = env.WX.Fader();
+    var nativeTarget = env.WX.Gain();
+
+
+    var baselineConnections = env.FakeAudioNode.activeConnectionCount();
+    expect(nativeTarget.incomingConnectionCount()).to.equal(0);
+    expect(source.to(processorTarget)).to.equal(processorTarget);
+    expect(env.FakeAudioNode.activeConnectionCount()).to.equal(baselineConnections + 1);
+    expect(processorTarget.to(nativeTarget)).to.equal(nativeTarget);
+    expect(nativeTarget.incomingConnectionCount()).to.equal(1);
+    expect(env.FakeAudioNode.activeConnectionCount()).to.equal(baselineConnections + 2);
+    source.cut();
+    expect(nativeTarget.incomingConnectionCount()).to.equal(1);
+    expect(env.FakeAudioNode.activeConnectionCount()).to.equal(baselineConnections + 1);
+    processorTarget.cut();
+    expect(nativeTarget.incomingConnectionCount()).to.equal(0);
+    expect(env.FakeAudioNode.activeConnectionCount()).to.equal(baselineConnections);
+  });
+
+  it('registered generator, processor, and analyzer factories expose the common surface independently', function() {
+
+
+
+
+    var env = loadWaax();
+    registerProbeFactories(env.WX);
+    var generator = env.WX.ProbeGenerator();
+    var processor = env.WX.ProbeProcessor();
+    var analyzer = env.WX.ProbeAnalyzer();
+    var sink = env.WX.Gain();
+
+
+    expect(env.WX.ProbeGenerator).to.be.a('function');
+    expect(env.WX.ProbeProcessor).to.be.a('function');
+    expect(env.WX.ProbeAnalyzer).to.be.a('function');
+
+    expectPlainObjectSnapshot(generator.getPreset());
+    expect(generator.getPreset()).to.have.property('gain');
+    expectPlainObjectSnapshot(processor.getPreset());
+    expect(processor.getPreset()).to.have.property('gain');
+    expectPlainObjectSnapshot(analyzer.getPreset());
+    expect(analyzer.getPreset()).to.have.property('gain');
+    expect(generator.set('gain', 0.3)).to.equal(generator);
+    expect(processor.set('gain', 0.7)).to.equal(processor);
+
+    expect(function() {
+      analyzer.setPreset({ gain: 0.8 });
+    }).to.not.throw(Error);
+    expect(generator.get('gain')).to.equal(0.3);
+    expect(processor.get('gain')).to.equal(0.7);
+    expect(analyzer.get('gain')).to.equal(0.8);
+    expect(generator.to(processor)).to.equal(processor);
+    expect(processor.to(analyzer)).to.equal(analyzer);
+    expect(analyzer.to(sink)).to.equal(sink);
+    expect(sink.incomingConnectionCount()).to.equal(1);
+    generator.cut();
+    processor.cut();
+    analyzer.cut();
+    expect(sink.incomingConnectionCount()).to.equal(0);
+  });
+
+  it('reports a WAAX connection error for an invalid routing target', function() {
+
+
+
+
+    var env = loadWaax();
+    var fader = env.WX.Fader();
+
+
+    expect(function() {
+      fader.to({ notAnAudioNode: true });
+    }).to.throw(Error);
+  });
+
+  it('keeps two Fader instances state-independent after mutating one', function() {
+
+
+
+
+    var env = loadWaax();
+    var a = env.WX.Fader();
+    var b = env.WX.Fader();
+    var bBefore = b.getPreset();
+    expectPlainObjectSnapshot(bBefore);
+
+    expect(a.set('input', 0.2)).to.equal(a);
+    expect(a.set('output', 0.4)).to.equal(a);
+
+    var aAfter = a.getPreset();
+    expectPlainObjectSnapshot(aAfter);
+    expect(aAfter).to.include({ input: 0.2, output: 0.4 });
+    expect(b.getPreset()).to.deep.equal(bBefore);
+  });
+
+  it('allows cut to be called twice and leaves outgoing patching disconnected', function() {
+
+
+
+
+    var env = loadWaax();
+    var fader = env.WX.Fader();
+    var sink = env.WX.Gain();
+
+    expect(sink.incomingConnectionCount()).to.equal(0);
+    expect(fader.to(sink)).to.equal(sink);
+    expect(sink.incomingConnectionCount()).to.equal(1);
+    expect(function() {
+      fader.cut();
+      fader.cut();
+    }).not.to.throw(Error);
+    expect(sink.incomingConnectionCount()).to.equal(0);
+  });
+
+  it('keeps native target incoming connections bounded across repeated construct-use-cut cycles', function() {
+
+
+
+
+    var env = loadWaax();
+    var sink = env.WX.Gain();
+
+    expect(sink.incomingConnectionCount()).to.equal(0);
+    for (var i = 0; i < 100; i++) {
+      var fader = env.WX.Fader();
+      expect(fader.to(sink)).to.equal(sink);
+      fader.cut();
+    }
+    expect(sink.incomingConnectionCount()).to.equal(0);
+  });
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
