diff --git a/tests/components/zeroconf/test_init.py b/tests/components/zeroconf/test_init.py
index 0c32e60ecca..9bd292efa63 100644
--- a/tests/components/zeroconf/test_init.py
+++ b/tests/components/zeroconf/test_init.py
@@ -314,3 +314,44 @@ async def test_get_instance(hass, mock_zeroconf):
     hass.bus.async_fire(EVENT_HOMEASSISTANT_STOP)
     await hass.async_block_till_done()
     assert len(mock_zeroconf.ha_close.mock_calls) == 1
+
+
+def get_service_info_mock_without_an_address(service_type, name):
+    """Return service info for get_service_info without any addresses."""
+    return ServiceInfo(
+        service_type,
+        name,
+        addresses=[],
+        port=80,
+        weight=0,
+        priority=0,
+        server="name.local.",
+        properties=PROPERTIES,
+    )
+
+
+async def test_info_from_service_returns_none_if_no_addresses(hass):
+    """Test info_from_service returns None when the service has no addresses."""
+    service_type = "_test._tcp.local."
+    info = zeroconf.info_from_service(
+        get_service_info_mock_without_an_address(
+            service_type, f"test.{service_type}"
+        )
+    )
+    assert info is None
+
+
+async def test_info_from_service_with_addresses_returns_info(hass):
+    """Test info_from_service returns an info dict when addresses are present."""
+    service_type = "_test._tcp.local."
+    info = zeroconf.info_from_service(
+        get_service_info_mock(service_type, f"test.{service_type}")
+    )
+    assert info is not None
+    assert info[zeroconf.ATTR_HOST] == "10.0.0.20"
+    assert info[zeroconf.ATTR_PORT] == 80
+    assert info[zeroconf.ATTR_HOSTNAME] == "name.local."
+    assert info[zeroconf.ATTR_TYPE] == service_type
+    assert info[zeroconf.ATTR_NAME] == f"test.{service_type}"
+
+
