+package sarama
+
+import (
+	"reflect"
+	"sort"
+	"testing"
+)
+
+func roundRobinTestMetadata(memberTopics map[string][]string) map[string]ConsumerGroupMemberMetadata {
+	members := make(map[string]ConsumerGroupMemberMetadata, len(memberTopics))
+	for memberID, topics := range memberTopics {
+		members[memberID] = ConsumerGroupMemberMetadata{Topics: topics}
+	}
+	return members
+}
+
+func assertRoundRobinPlan(t *testing.T, plan BalanceStrategyPlan, err error, expected BalanceStrategyPlan) {
+	t.Helper()
+	if err != nil {
+		t.Fatalf("BalanceStrategyRoundRobin.Plan returned error: %v", err)
+	}
+	normalizedPlan := normalizeRoundRobinPlan(plan)
+	normalizedExpected := normalizeRoundRobinPlan(expected)
+	if !reflect.DeepEqual(normalizedPlan, normalizedExpected) {
+		t.Fatalf("unexpected round-robin plan\nexpected: %#v\nactual:   %#v", normalizedExpected, normalizedPlan)
+	}
+}
+
+func normalizeRoundRobinPlan(plan BalanceStrategyPlan) BalanceStrategyPlan {
+	normalized := make(BalanceStrategyPlan, len(plan))
+	for memberID, topics := range plan {
+		topicCopy := make(map[string][]int32, len(topics))
+		for topic, partitions := range topics {
+			if len(partitions) == 0 {
+				continue
+			}
+			partitionsCopy := append([]int32(nil), partitions...)
+			sort.Slice(partitionsCopy, func(i, j int) bool {
+				return partitionsCopy[i] < partitionsCopy[j]
+			})
+			topicCopy[topic] = partitionsCopy
+		}
+		if len(topicCopy) > 0 {
+			normalized[memberID] = topicCopy
+		}
+	}
+	return normalized
+}
+
+func TestBalanceStrategyRoundRobinGlobalAcrossSinglePartitionTopics(t *testing.T) {
+	members := roundRobinTestMetadata(map[string][]string{
+		"M1": {"T1", "T2", "T3"},
+		"M2": {"T1", "T2", "T3"},
+		"M3": {"T1", "T2", "T3"},
+	})
+	topics := map[string][]int32{
+		"T1": {0},
+		"T2": {0},
+		"T3": {0},
+	}
+
+	plan, err := BalanceStrategyRoundRobin.Plan(members, topics)
+	assertRoundRobinPlan(t, plan, err, BalanceStrategyPlan{
+		"M1": map[string][]int32{"T1": {0}},
+		"M2": map[string][]int32{"T2": {0}},
+		"M3": map[string][]int32{"T3": {0}},
+	})
+}
+
+func TestBalanceStrategyRoundRobinGlobalAcrossMixedPartitionCounts(t *testing.T) {
+	members := roundRobinTestMetadata(map[string][]string{
+		"M1": {"T1", "T2", "T3"},
+		"M2": {"T1", "T2", "T3"},
+	})
+	topics := map[string][]int32{
+		"T1": {0},
+		"T2": {0, 1},
+		"T3": {0, 1, 2, 3},
+	}
+
+	plan, err := BalanceStrategyRoundRobin.Plan(members, topics)
+	assertRoundRobinPlan(t, plan, err, BalanceStrategyPlan{
+		"M1": map[string][]int32{"T1": {0}, "T2": {1}, "T3": {1, 3}},
+		"M2": map[string][]int32{"T2": {0}, "T3": {0, 2}},
+	})
+}
+
+func TestBalanceStrategyRoundRobinSkipsUnsubscribedMembersWithoutResettingProgress(t *testing.T) {
+	members := roundRobinTestMetadata(map[string][]string{
+		"M1": {"T1", "T2", "T3"},
+		"M2": {"T1", "T3"},
+	})
+	topics := map[string][]int32{
+		"T1": {0},
+		"T2": {0},
+		"T3": {0},
+	}
+
+	plan, err := BalanceStrategyRoundRobin.Plan(members, topics)
+	assertRoundRobinPlan(t, plan, err, BalanceStrategyPlan{
+		"M1": map[string][]int32{"T1": {0}, "T2": {0}},
+		"M2": map[string][]int32{"T3": {0}},
+	})
+}
+
+func TestBalanceStrategyRoundRobinSkipsMultipleIneligibleMembers(t *testing.T) {
+	members := roundRobinTestMetadata(map[string][]string{
+		"A": {"T1", "T2", "T3"},
+		"B": {"T1"},
+		"C": {"T1", "T3"},
+	})
+	topics := map[string][]int32{
+		"T1": {0},
+		"T2": {0},
+		"T3": {0, 1},
+	}
+
+	plan, err := BalanceStrategyRoundRobin.Plan(members, topics)
+	assertRoundRobinPlan(t, plan, err, BalanceStrategyPlan{
+		"A": map[string][]int32{"T1": {0}, "T2": {0}, "T3": {1}},
+		"C": map[string][]int32{"T3": {0}},
+	})
+}
