@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test -v -run '^TestBalanceStrategyRoundRobin$' -count=1 .
+    ;;
+  new)
+    go test -v -run '^(TestBalanceStrategyRoundRobin|TestBalanceStrategyRoundRobinGlobalAcrossSinglePartitionTopics|TestBalanceStrategyRoundRobinGlobalAcrossMixedPartitionCounts|TestBalanceStrategyRoundRobinSkipsUnsubscribedMembersWithoutResettingProgress|TestBalanceStrategyRoundRobinSkipsMultipleIneligibleMembers)$' -count=1 .
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
