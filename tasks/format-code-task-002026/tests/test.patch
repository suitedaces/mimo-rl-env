+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+
+if [ ! -d node_modules ]; then
+  echo "node_modules is required for the offline test image" >&2
+  exit 1
+fi
+
+exec node --expose-gc --import /workspace/repo/usercase-test-coderl/offline_network_guard.mjs --test /workspace/repo/usercase-test-coderl/opm_viewer.test.js
