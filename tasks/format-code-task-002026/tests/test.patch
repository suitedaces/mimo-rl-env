diff --git a/usercase-test-coderl/offline_network_guard.mjs b/usercase-test-coderl/offline_network_guard.mjs
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/offline_network_guard.mjs
@@ -0,0 +1,43 @@
+
+import childProcess from 'node:child_process';
+import dgram from 'node:dgram';
+import http from 'node:http';
+import https from 'node:https';
+import net from 'node:net';
+
+function blocked(name) {
+  return function offlineBlocked() {
+    throw new Error(`local offline network blocked: ${name}`);
+  };
+}
+
+for (const mod of [http, https]) {
+  mod.request = blocked(`${mod === http ? 'http' : 'https'}.request`);
+  mod.get = blocked(`${mod === http ? 'http' : 'https'}.get`);
+}
+
+net.connect = blocked('net.connect');
+net.createConnection = blocked('net.createConnection');
+net.Socket.prototype.connect = blocked('net.Socket.connect');
+dgram.createSocket = blocked('dgram.createSocket');
+
+if ('fetch' in globalThis) {
+  globalThis.fetch = blocked('fetch');
+}
+
+globalThis.XMLHttpRequest = class OfflineXMLHttpRequest {
+  constructor() {
+    throw new Error('local offline network blocked: XMLHttpRequest');
+  }
+};
+
+for (const name of ['exec', 'execFile', 'fork', 'spawn']) {
+  const original = childProcess[name];
+  childProcess[name] = function guardedChildProcess(command, ...args) {
+    const commandName = Array.isArray(command) ? command[0] : String(command);
+    if (/\b(?:curl|wget|npm|npx|pnpm|yarn|git|ssh|scp)\b/.test(commandName)) {
+      throw new Error(`local offline network blocked: child_process.${name} ${commandName}`);
+    }
+    return original.call(this, command, ...args);
+  };
+}
diff --git a/usercase-test-coderl/opm_viewer.test.js b/usercase-test-coderl/opm_viewer.test.js
