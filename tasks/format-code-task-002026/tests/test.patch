--- /dev/null
+++ b/usercase-test-coderl/opm_viewer.test.js
@@ -0,0 +1,383 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import test from 'node:test';
+
+const FIXTURES = '/workspace/repo/usercase-test-coderl/fixtures';
+const OPM_6JXR_URL = 'https://opm-assets.storage.googleapis.com/pdb/6jxr.pdb';
+const MISSING_OPM_MESSAGE =
+  'This is probably not a transmembrane protein. It has no data in Orientations of Proteins in Membranes(OPM) database.';
+const OPM_PDB = fs.readFileSync(`${FIXTURES}/6jxr.pdb`, 'utf8');
+const HALF_BILAYER_SIZE = parseHalfBilayerSize(OPM_PDB);
+
+const alerts = [];
+const ajaxRequests = [];
+const loggedCommands = [];
+
+function makeElement() {
+  return {
+    style: {},
+    addEventListener() {},
+    removeEventListener() {},
+    getContext() {
+      return null;
+    },
+    remove() {},
+    setAttribute() {},
+    getAttribute() {
+      return null;
+    },
+    appendChild() {},
+    blur() {},
+    focus() {},
+    innerHTML: '',
+  };
+}
+
+globalThis.window = { navigator: {}, __THREE__: '177' };
+Object.defineProperty(globalThis, 'navigator', {
+  value: globalThis.window.navigator,
+  configurable: true,
+});
+globalThis.document = {
+  createElement: makeElement,
+  getElementById: makeElement,
+  addEventListener() {},
+  removeEventListener() {},
+};
+globalThis.localStorage = {
+  getItem() {
+    return null;
+  },
+  setItem() {},
+  removeItem() {},
+};
+globalThis.sessionStorage = globalThis.localStorage;
+globalThis.alert = (message) => {
+  alerts.push(message);
+};
+
+function $(selector) {
+  const element = $.elements[selector] || ($.elements[selector] = makeElement());
+  const api = {
+    0: element,
+    length: 1,
+    selector,
+    width(value) {
+      return value === undefined ? '640px' : api;
+    },
+    height(value) {
+      return value === undefined ? '480px' : api;
+    },
+    css(name, value) {
+      if (value === undefined && typeof name === 'string') {
+        if (name === 'width') return '640px';
+        if (name === 'height') return '480px';
+        return '';
+      }
+      return api;
+    },
+    val(value) {
+      if (value === undefined) return $.values[selector];
+      $.values[selector] = value;
+      return api;
+    },
+    html(value) {
+      if (value === undefined) return $.htmls[selector] || '';
+      $.htmls[selector] = value;
+      return api;
+    },
+    text() {
+      return api;
+    },
+    get(index) {
+      return index === undefined ? [element] : element;
+    },
+  };
+
+  for (const name of [
+    'resizable',
+    'hide',
+    'show',
+    'append',
+    'prepend',
+    'empty',
+    'attr',
+    'prop',
+    'on',
+    'off',
+    'click',
+    'change',
+    'dialog',
+    'accordion',
+    'tabs',
+    'menu',
+    'button',
+    'selectmenu',
+    'checkboxradio',
+    'each',
+    'find',
+    'addClass',
+    'removeClass',
+    'parent',
+    'children',
+    'scroll',
+    'scrollTop',
+    'blur',
+    'keyup',
+    'keydown',
+    'mouseup',
+    'mousedown',
+    'mousemove',
+    'bind',
+    'unbind',
+  ]) {
+    api[name] = () => api;
+  }
+
+  api.ready = (fn) => {
+    if (fn) fn();
+    return api;
+  };
+  api.is = () => false;
+  return api;
+}
+
+$.values = {};
+$.htmls = {};
+$.elements = {};
+$.inArray = (item, array) => array.indexOf(item);
+$.extend = Object.assign;
+$.ajaxTransport = () => {};
+$.ui = { dialog: { prototype: {} } };
+$.ajax = ({ url, dataType, beforeSend, success, error }) => {
+  ajaxRequests.push({ url, dataType, beforeSend: Boolean(beforeSend) });
+  if (url === OPM_6JXR_URL && dataType === 'text') {
+    success(OPM_PDB);
+  } else {
+    error();
+  }
+};
+globalThis.$ = $;
+
+
+globalThis.fetch = async (input) => {
+  const url = typeof input === 'string' ? input : input?.url ?? String(input);
+  ajaxRequests.push({ url, dataType: 'text', beforeSend: false });
+
+  if (url === OPM_6JXR_URL) {
+    return {
+      ok: true,
+      status: 200,
+      text: async () => OPM_PDB,
+    };
+  }
+
+  return {
+    ok: false,
+    status: 404,
+    text: async () => '',
+  };
+};
+
+const { iCn3DUI } = await import('/workspace/repo/src/icn3dui.js');
+const originalSetIcn3d = iCn3DUI.prototype.setIcn3d;
+iCn3DUI.prototype.setIcn3d = function patchedSetIcn3d() {
+  originalSetIcn3d.call(this);
+  const ic = this.icn3d;
+  ic.renderer = { setSize() {}, render() {}, domElement: makeElement() };
+  ic.cam = {};
+  ic.controls = { update() {} };
+  ic.ParserUtilsCls.renderStructure = async () => {};
+  ic.setStyleCls.setAtomStyleByOptions = () => {};
+  ic.setColorCls.setColorByOptions = () => {};
+  ic.resizeCanvasCls.rotStruc = () => {};
+  ic.applyCenterCls.setWidthHeight = (width, height) => {
+    ic.WIDTH = width;
+    ic.HEIGHT = height;
+  };
+  ic.hlUpdateCls.updateHlAll = () => {};
+  this.htmlCls.clickMenuCls.getHiddenMenusFromCache = () => {};
+  this.htmlCls.clickMenuCls.applyShownMenus = () => {};
+  this.htmlCls.clickMenuCls.setLogCmd = (command) => {
+    loggedCommands.push(command);
+  };
+};
+
+function resetHarnessState() {
+  alerts.length = 0;
+  ajaxRequests.length = 0;
+  loggedCommands.length = 0;
+  $.values = {};
+  $.htmls = {};
+  $.elements = {};
+}
+
+function makeUi(divid, cfg) {
+  return new iCn3DUI({
+    divid,
+    width: '640px',
+    height: '480px',
+    showmenu: false,
+    showtitle: false,
+    showcommand: false,
+    rotate: 'right',
+    ...cfg,
+  });
+}
+
+function parseHalfBilayerSize(pdbText) {
+  const match = pdbText.match(/1\/2 of bilayer thickness:\s*([+-]?\d+(?:\.\d+)?)/i);
+  assert.ok(match, 'fixture must include an OPM half-bilayer size remark');
+  return Number(match[1]);
+}
+
+function snapshot(ui) {
+  const ic = ui.icn3d;
+  return {
+    inputid: ic.inputid,
+    bOpm: ic.bOpm,
+    bStopRotate: ic.bStopRotate,
+    atoms: Object.keys(ic.atoms || {}).length,
+    chains: Object.keys(ic.chains || {}).length,
+    residues: Object.keys(ic.residues || {}).length,
+    structures: Object.keys(ic.structures || {}),
+    selectplane_z1: $.values[`#${ui.cfg.divid}_selectplane_z1`],
+    selectplane_z2: $.values[`#${ui.cfg.divid}_selectplane_z2`],
+    extra_mem_z: $.values[`#${ui.cfg.divid}_extra_mem_z`],
+    intra_mem_z: $.values[`#${ui.cfg.divid}_intra_mem_z`],
+  };
+}
+
+function assertRequestedOpmUrl(url) {
+
+  assert.equal(ajaxRequests.some((request) => request.url === url), true);
+}
+
+function assertLoggedLoadOpmCommand() {
+
+  assert.equal(loggedCommands.includes('load opm 6JXR'), true);
+}
+
+function assertLoadedOpmState(ui) {
+  const state = snapshot(ui);
+
+  assert.equal(state.inputid, '6JXR');
+  assert.equal(state.bOpm, true);
+  assert.equal(state.bStopRotate, true);
+
+
+  assert.equal(state.atoms > 0, true);
+  assert.equal(state.chains > 0, true);
+  assert.equal(state.residues > 0, true);
+
+
+  assert.equal(Number(state.selectplane_z1), HALF_BILAYER_SIZE);
+  assert.equal(Number(state.selectplane_z2), -HALF_BILAYER_SIZE);
+  assert.equal(Number(state.extra_mem_z), HALF_BILAYER_SIZE);
+  assert.equal(Number(state.intra_mem_z), -HALF_BILAYER_SIZE);
+}
+
+async function assertMissingOpmRejects(promise) {
+  let rejected = false;
+  let rejectionMessage = '';
+
+  try {
+    await promise;
+  } catch (error) {
+    rejected = true;
+    rejectionMessage = error?.message ?? String(error);
+  }
+
+  assert.equal(rejected, true);
+
+  assert.equal(rejectionMessage === MISSING_OPM_MESSAGE || alerts.includes(MISSING_OPM_MESSAGE), true);
+}
+
+function assertNoLoadedStructure(ui) {
+  const state = snapshot(ui);
+
+
+  assert.notEqual(state.bOpm, true);
+  assert.equal(state.atoms, 0);
+  assert.equal(state.chains, 0);
+  assert.equal(state.residues, 0);
+  assert.equal(state.structures.length, 0);
+}
+
+test('startup cfg.opmid loads OPM PDB into viewer state', async () => {
+
+
+  resetHarnessState();
+  const ui = makeUi('startupdiv', { opmid: '6JXR' });
+
+  await ui.show3DStructure();
+
+  assertRequestedOpmUrl(OPM_6JXR_URL);
+  assertLoggedLoadOpmCommand();
+  assertLoadedOpmState(ui);
+});
+
+test('command script load opm reaches the same loaded OPM state', async () => {
+
+
+  resetHarnessState();
+  const ui = makeUi('commanddiv', { command: 'load opm 6JXR' });
+
+  await ui.show3DStructure();
+
+  assertRequestedOpmUrl(OPM_6JXR_URL);
+  assertLoadedOpmState(ui);
+});
+
+test('unavailable OPM ID rejects with the OPM-specific message and no empty structure', async () => {
+
+
+  resetHarnessState();
+  const ui = makeUi('missingdiv', { opmid: 'ZZZZ' });
+
+  await assertMissingOpmRejects(ui.show3DStructure());
+
+  assertRequestedOpmUrl('https://opm-assets.storage.googleapis.com/pdb/zzzz.pdb');
+  assertNoLoadedStructure(ui);
+});
+
+test('command script load opm is accepted through the public viewer path', async () => {
+
+
+
+  resetHarnessState();
+  const ui = makeUi('orderdiv', { command: 'load opm 6JXR' });
+
+  await ui.show3DStructure();
+
+  assertRequestedOpmUrl(OPM_6JXR_URL);
+  assertLoadedOpmState(ui);
+});
+
+test('separate viewer instances keep successful and failed OPM loads independent', async () => {
+
+
+  resetHarnessState();
+  const a = makeUi('instancediva', { opmid: '6JXR' });
+  const b = makeUi('instancedivb', { opmid: 'ZZZZ' });
+
+  await a.show3DStructure();
+  await assertMissingOpmRejects(b.show3DStructure());
+
+  assertLoadedOpmState(a);
+  assertNoLoadedStructure(b);
+});
+
+test('repeated construct load cycles keep OPM loading functional', async () => {
+
+
+
+  resetHarnessState();
+
+  for (let i = 0; i < 3; i += 1) {
+    resetHarnessState();
+    const ui = makeUi(`leakdiv${i}`, { opmid: '6JXR' });
+    await ui.show3DStructure();
+    assertLoadedOpmState(ui);
+  }
+});
