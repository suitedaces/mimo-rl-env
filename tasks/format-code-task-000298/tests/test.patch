--- /dev/null
+++ b/usercase-test-coderl/bytes.test.js
@@ -0,0 +1,347 @@
+
+
+
+
+var expect = require('chai').expect;
+var childProcess = require('child_process');
+var fs = require('fs');
+var http = require('http');
+var https = require('https');
+var net = require('net');
+var os = require('os');
+var path = require('path');
+var numeral = require('/workspace/repo');
+
+describe('usercase byte quantity formatting and parsing', function() {
+    afterEach(function() {
+        numeral.reset();
+    });
+
+    it('formats decimal bytes as adjacent B', function() {
+
+
+
+
+        expect(numeral(100).format('0b')).to.equal('100B');
+    });
+
+    it('formats null decimal bytes as spaced zero B', function() {
+
+
+
+
+        expect(numeral(null).format('0 b')).to.equal('0 B');
+    });
+
+    it('formats decimal kilobytes with a space before KB', function() {
+
+
+
+
+        expect(numeral(2000).format('0 b')).to.equal('2 KB');
+    });
+
+    it('formats decimal megabytes adjacent to MB', function() {
+
+
+
+
+        expect(numeral(Math.pow(1000, 2) * 5).format('0b')).to.equal('5MB');
+    });
+
+    it('formats decimal gigabytes with optional one-decimal output', function() {
+
+
+
+
+        expect(numeral(Math.pow(1000, 3) * 7.343).format('0.[0] b')).to.equal('7.3 GB');
+    });
+
+    it('formats decimal terabytes with fixed three-decimal rounding', function() {
+
+
+
+
+        expect(numeral(Math.pow(1000, 4) * 3.1536544).format('0.000b')).to.equal('3.154TB');
+    });
+
+    it('formats decimal petabytes with rounded integer output', function() {
+
+
+
+
+        expect(numeral(Math.pow(1000, 5) * 2.953454534534).format('0b')).to.equal('3PB');
+    });
+
+    it('formats binary bytes as spaced zero B', function() {
+
+
+
+
+        expect(numeral(0).format('0 ib')).to.equal('0 B');
+    });
+
+    it('formats binary kibibytes with a space before KiB', function() {
+
+
+
+
+        expect(numeral(1024 * 2).format('0 ib')).to.equal('2 KiB');
+    });
+
+    it('formats binary mebibytes adjacent to MiB', function() {
+
+
+
+
+        expect(numeral(Math.pow(1024, 2) * 5).format('0ib')).to.equal('5MiB');
+    });
+
+    it('formats binary gibibytes with optional one-decimal output', function() {
+
+
+
+
+        expect(numeral(Math.pow(1024, 3) * 7.343).format('0.[0] ib')).to.equal('7.3 GiB');
+    });
+
+    it('formats binary tebibytes with fixed three-decimal rounding', function() {
+
+
+
+
+        expect(numeral(Math.pow(1024, 4) * 3.1536544).format('0.000ib')).to.equal('3.154TiB');
+    });
+
+    it('formats binary pebibytes with rounded integer output', function() {
+
+
+
+
+        expect(numeral(Math.pow(1024, 5) * 2.953454534534).format('0ib')).to.equal('3PiB');
+    });
+
+    it('honors the public optional roundingFunction argument for byte formatting', function() {
+
+
+
+
+        expect(numeral(1999).format('0.0 b', Math.floor)).to.equal('1.9 KB');
+    });
+
+    it('parses zero decimal bytes as zero', function() {
+
+
+
+
+        expect(numeral('0B').value()).to.equal(0);
+    });
+
+    it('parses decimal bytes as raw bytes', function() {
+
+
+
+
+        expect(numeral('100B').value()).to.equal(100);
+    });
+
+    it('parses spaced decimal kilobytes as raw bytes', function() {
+
+
+
+
+        expect(numeral('2 KB').value()).to.equal(2000);
+    });
+
+    it('parses adjacent decimal megabytes as raw bytes', function() {
+
+
+
+
+        expect(numeral('5MB').value()).to.equal(5000000);
+    });
+
+    it('parses decimal gigabytes with a fractional quantity', function() {
+
+
+
+
+        expect(numeral('7.3 GB').value()).to.equal(7300000000);
+    });
+
+    it('parses adjacent decimal terabytes with a fractional quantity', function() {
+
+
+
+
+        expect(numeral('3.154TB').value()).to.equal(3154000000000);
+    });
+
+    it('parses adjacent decimal petabytes as raw bytes', function() {
+
+
+
+
+        expect(numeral('3PB').value()).to.equal(3000000000000000);
+    });
+
+    it('parses spaced binary kibibytes as raw bytes', function() {
+
+
+
+
+        expect(numeral('2 KiB').value()).to.equal(2048);
+    });
+
+    it('parses adjacent binary mebibytes as raw bytes', function() {
+
+
+
+
+        expect(numeral('5MiB').value()).to.equal(5242880);
+    });
+
+    it('parses binary gibibytes with a fractional quantity', function() {
+
+
+
+
+        expect(numeral('7.3 GiB').value()).to.equal(7838315315.2);
+    });
+
+    it('parses adjacent binary tebibytes with a fractional quantity', function() {
+
+
+
+
+        expect(numeral('3.154TiB').value()).to.equal(3467859674005.504);
+    });
+
+    it('parses adjacent binary pebibytes as raw bytes', function() {
+
+
+
+
+        expect(numeral('3PiB').value()).to.equal(3377699720527872);
+    });
+
+    it('leaves BPS strings for the basis-point parser instead of byte parsing', function() {
+
+
+
+
+        expect(numeral('1 BPS').value()).to.equal(0.0001);
+    });
+
+    it('uses the public roundingFunction callback during byte formatting', function() {
+        var calls = 0;
+        var floorAndCount = function(value) {
+            calls += 1;
+            return Math.floor(value);
+        };
+
+
+        expect(numeral(1999).format('0.0 b', floorAndCount)).to.equal('1.9 KB');
+        expect(calls).to.be.above(0);
+    });
+
+    it('is referentially transparent for the same input and byte format mask', function() {
+        expect(numeral(Math.pow(1024, 3) * 7.343).format('0.[0] ib')).to.equal('7.3 GiB');
+        expect(numeral(Math.pow(1024, 3) * 7.343).format('0.[0] ib')).to.equal('7.3 GiB');
+    });
+
+    it('does not mutate caller-provided number-like inputs', function() {
+        var input = new Number(2000);
+        input.metadata = {
+            label: 'decimal-kilobytes',
+            values: [1000, 2000]
+        };
+        var before = {
+            primitive: input.valueOf(),
+            metadata: JSON.parse(JSON.stringify(input.metadata)),
+            keys: Object.keys(input)
+        };
+
+        expect(numeral(input).format('0 b')).to.equal('2 KB');
+        expect(input.valueOf()).to.equal(before.primitive);
+        expect(input.metadata).to.deep.equal(before.metadata);
+        expect(Object.keys(input)).to.deep.equal(before.keys);
+    });
+
+    it('matches a fresh Node process for the same public byte call', function() {
+        var inProcess = numeral(Math.pow(1000, 4) * 3.1536544).format('0.000b');
+        var script = [
+            "var numeral = require('/workspace/repo');",
+            "process.stdout.write(JSON.stringify(numeral(Math.pow(1000, 4) * 3.1536544).format('0.000b')));"
+        ].join('');
+        var outOfProcess = JSON.parse(childProcess.execFileSync(process.execPath, ['-e', script], {
+            encoding: 'utf8'
+        }));
+
+        expect(inProcess).to.equal('3.154TB');
+        expect(outOfProcess).to.equal('3.154TB');
+    });
+
+    it('does not perform undeclared filesystem or network side effects', function() {
+        var previousCwd = process.cwd();
+        var tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'numeral-bytes-'));
+        var originalWriteFileSync = fs.writeFileSync;
+        var originalAppendFileSync = fs.appendFileSync;
+        var originalMkdirSync = fs.mkdirSync;
+        var originalOpenSync = fs.openSync;
+        var originalHttpRequest = http.request;
+        var originalHttpsRequest = https.request;
+        var originalNetSocket = net.Socket;
+        var writes = [];
+        var network = [];
+
+        function recordWrite(name) {
+            return function(target) {
+                writes.push(name + ':' + target);
+                throw new Error('unexpected filesystem write');
+            };
+        }
+
+        function recordNetwork(name) {
+            return function() {
+                network.push(name);
+                throw new Error('unexpected network access');
+            };
+        }
+
+        process.chdir(tmpDir);
+        try {
+            fs.writeFileSync = recordWrite('writeFileSync');
+            fs.appendFileSync = recordWrite('appendFileSync');
+            fs.mkdirSync = recordWrite('mkdirSync');
+            fs.openSync = function(target, flags) {
+                if (typeof flags === 'string' && /[wax+]/.test(flags)) {
+                    writes.push('openSync:' + target);
+                    throw new Error('unexpected filesystem write');
+                }
+                return originalOpenSync.apply(fs, arguments);
+            };
+            http.request = recordNetwork('http.request');
+            https.request = recordNetwork('https.request');
+            net.Socket = recordNetwork('net.Socket');
+
+            var before = fs.readdirSync(process.cwd()).sort();
+            expect(numeral(2000).format('0 b')).to.equal('2 KB');
+            expect(numeral('7.3 GiB').value()).to.equal(7838315315.2);
+            var after = fs.readdirSync(process.cwd()).sort();
+
+            expect(after).to.deep.equal(before);
+            expect(writes).to.deep.equal([]);
+            expect(network).to.deep.equal([]);
+        } finally {
+            fs.writeFileSync = originalWriteFileSync;
+            fs.appendFileSync = originalAppendFileSync;
+            fs.mkdirSync = originalMkdirSync;
+            fs.openSync = originalOpenSync;
+            http.request = originalHttpRequest;
+            https.request = originalHttpsRequest;
+            net.Socket = originalNetSocket;
+            process.chdir(previousCwd);
+        }
+    });
+});
diff --git a/usercase-test-coderl/offline-Gruntfile.js b/usercase-test-coderl/offline-Gruntfile.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/offline-Gruntfile.js
@@ -0,0 +1,108 @@
+
+module.exports = function(grunt) {
+
+    var compileType = function() {
+            var type = this.data.type;
+            var template = grunt.file.read('templates/types.js');
+            var anon = grunt.file.read('templates/anon.js');
+            var files = grunt.file.expand([
+                'src/' + type + '/*.js'
+            ]);
+            var regexp = /\}\(this, function \(numeral\) \{\s([\s\S]+)(?:\s\}\)\);)/;
+            var content = '';
+            var file;
+            var i;
+
+            for (i = 0; i < files.length; i++) {
+                file = grunt.file.read(files[i]);
+
+                content += '\n' + grunt.template.process(anon, {
+                    data: {
+                        content: file.match(regexp)[1]
+                    }
+                }) + '\n';
+            }
+
+            grunt.file.write('temp/' + type + '.js', content);
+
+            if (type === 'locales') {
+                grunt.file.write('locales.js', grunt.template.process(template, {
+                    data: {
+                        type: type,
+                        content: content
+                    }
+                }));
+            }
+        },
+        compileNumeral = function() {
+            var numeral = grunt.file.read('src/numeral.js');
+            var formats = grunt.file.read('temp/formats.js');
+            var index = numeral.indexOf('return numeral;');
+
+            numeral = numeral.substr(0, index) + '\n' + formats + numeral.substr(index);
+
+            grunt.file.write('numeral.js', numeral);
+        };
+
+    grunt.loadNpmTasks('grunt-contrib-jshint');
+    grunt.loadNpmTasks('grunt-contrib-copy');
+
+    grunt.initConfig({
+        copy: {
+            locales: {
+                files: [
+                    {
+                        expand: true,
+                        cwd: 'src/',
+                        src: [
+                            'locales/*.js'
+                        ],
+                        dest: './'
+                    }
+                ]
+            }
+        },
+        compile: {
+            locales: {
+                type: 'locales'
+            },
+            formats: {
+                type: 'formats'
+            }
+        },
+        jshint: {
+            all: [
+                'Gruntfile.js',
+                'src/**/*.js'
+            ],
+            options: {
+                'node': true,
+                'browser': true,
+                'curly': true,
+                'devel': false,
+                'eqeqeq': true,
+                'eqnull': true,
+                'newcap': true,
+                'noarg': true,
+                'undef': true,
+                'sub': true,
+                'strict': false,
+                'quotmark': 'single',
+                'globals': {
+                    'define': true
+                }
+            }
+        }
+    });
+
+    grunt.registerMultiTask('compile', compileType);
+
+    grunt.registerTask('compile:numeral', compileNumeral);
+
+    grunt.registerTask('build', [
+        'jshint',
+        'compile',
+        'compile:numeral',
+        'copy'
+    ]);
+};
