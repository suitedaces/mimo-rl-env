diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,23 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+if [ ! -x node_modules/.bin/tap ]; then
+  npm install 2>&1
+fi
+
+
+case "${1:-}" in
+  base)
+    node_modules/.bin/tap packages/dd-trace/test/plugins/util/env.spec.js
+    ;;
+  new)
+    node_modules/.bin/tap packages/dd-trace/test/plugins/util/test-environment.spec.js
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
