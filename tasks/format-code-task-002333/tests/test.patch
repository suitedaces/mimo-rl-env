diff --git a/usercase-test-coderl/fixtures/make_bad_shm.c b/usercase-test-coderl/fixtures/make_bad_shm.c
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/fixtures/make_bad_shm.c
@@ -0,0 +1,40 @@
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ipc.h>
+#include <sys/shm.h>
+
+int main(int argc, char **argv) {
+  key_t key;
+  int old_id;
+  int id;
+  void *ptr;
+
+  if (argc != 2) {
+    fprintf(stderr, "usage: make_bad_shm <key>\n");
+    return 2;
+  }
+
+  key = (key_t) strtol(argv[1], NULL, 10);
+  old_id = shmget(key, 0, 0);
+  if (old_id >= 0)
+    shmctl(old_id, IPC_RMID, NULL);
+
+  id = shmget(key, 4096, IPC_CREAT | IPC_EXCL | 0600);
+  if (id < 0) {
+    fprintf(stderr, "shmget: %s\n", strerror(errno));
+    return 1;
+  }
+
+  ptr = shmat(id, NULL, 0);
+  if (ptr == (void *) -1) {
+    fprintf(stderr, "shmat: %s\n", strerror(errno));
+    shmctl(id, IPC_RMID, NULL);
+    return 1;
+  }
+
+  memset(ptr, 0xa5, 4096);
+  shmdt(ptr);
+  return 0;
+}
diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,227 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+( cd /workspace/repo && ./compile.sh ) \
+  || { echo "FAIL: build wgdb" >&2; exit 1; }
+cc -O2 -Wall \
+  -o /workspace/repo/usercase-test-coderl/fixtures/make_bad_shm \
+  /workspace/repo/usercase-test-coderl/fixtures/make_bad_shm.c \
+  || { echo "FAIL: build make_bad_shm fixture" >&2; exit 1; }
+
+BIN=/workspace/repo/Main/wgdb
+BAD_SHM=/workspace/repo/usercase-test-coderl/fixtures/make_bad_shm
+
+TMP=$(mktemp -d)
+BASE=$((330000 + ($$ % 10000) * 10))
+KEYS=""
+trap 'for key in $KEYS; do "$BIN" "$key" free >/dev/null 2>/dev/null || true; ipcrm -M "$key" >/dev/null 2>/dev/null || true; done; "$BIN" free >/dev/null 2>/dev/null || true; rm -rf "$TMP"' EXIT
+cd "$TMP" || exit 1
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+add_key() { KEYS="$KEYS $1"; "$BIN" "$1" free >/dev/null 2>/dev/null || true; ipcrm -M "$1" >/dev/null 2>/dev/null || true; }
+
+expect_file() {
+  local label=$1 file=$2 expected=$3
+
+  printf '%s\n' "$expected" | cmp -s - "$file" \
+    || fail "$label: got [$(cat "$file")], want [$expected]"
+}
+
+expect_empty() {
+  local label=$1 file=$2
+  [ ! -s "$file" ] || fail "$label: got [$(cat "$file")]"
+}
+
+expect_help_entry() {
+  local label=$1 command=$2 token_regex=$3
+
+  awk -v command="$command" -v token_regex="$token_regex" '
+    BEGIN { found = 0 }
+    {
+      lower = tolower($0)
+      if (index(lower, command) && lower ~ token_regex && $0 ~ / - .+/)
+        found = 1
+    }
+    END { exit(found ? 0 : 1) }
+  ' out || fail "$label"
+}
+
+expect_index_table_shape() {
+  local label=$1 file=$2 expected_count=$3 header count
+
+  IFS= read -r header <"$file" || fail "$label missing header"
+  [ "$header" = $'col\ttype\tmulti\tid\tmask' ] \
+    || fail "$label header: got [$header]"
+  count=$(awk 'BEGIN { FS = "\t" } NR > 1 { c++ } END { print c + 0 }' "$file")
+  [ "$count" -eq "$expected_count" ] \
+    || fail "$label row count: got $count, want $expected_count; output: $(cat "$file")"
+  awk '
+    BEGIN { FS = "\t" }
+    NR == 1 { next }
+    NF != 5 || $1 !~ /^[0-9]+$/ || $2 !~ /^(T|TJ|#|#J)$/ ||
+      $3 !~ /^[0-9]+$/ || $4 !~ /^[0-9]+$/ || $5 !~ /^[-N]$/ { exit 1 }
+  ' "$file" || fail "$label row shape: $(cat "$file")"
+}
+
+expect_index_entry() {
+  local label=$1 file=$2 col=$3 type=$4 multi=$5 id
+  id=$(awk -v col="$col" -v type="$type" -v multi="$multi" '
+    BEGIN { FS = "\t"; matches = 0; id = "" }
+    NR > 1 && $1 == col && $2 == type && $3 == multi {
+      matches++
+      id = $4
+    }
+    END {
+      if (matches == 1)
+        print id
+      else
+        exit 1
+    }
+  ' "$file") || fail "$label missing unique row col=$col type=$type multi=$multi; output: $(cat "$file")"
+  printf '%s' "$id"
+}
+
+
+
+
+"$BIN" help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+
+expect_help_entry "F1 missing createindex help" "createindex" "<column>"
+expect_help_entry "F1 missing createhash help" "createhash" "column"
+expect_help_entry "F1 missing dropindex help" "dropindex" "id"
+expect_help_entry "F1 missing listindex help" "listindex" "."
+expect_empty "F1 stderr" err
+
+
+
+
+"$BIN" free >/dev/null 2>/dev/null || true
+"$BIN" listindex >out 2>err; ec=$?
+EXPECTED=$'No indexes in the database.'
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+expect_file "F2 stdout" out "$EXPECTED"
+expect_empty "F2 stderr" err
+"$BIN" free >/dev/null 2>/dev/null || true
+
+
+
+
+KEY=$((BASE + 1)); add_key "$KEY"
+"$BIN" "$KEY" createindex 0 >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 createindex exit $ec; want 0"
+expect_empty "F3 createindex stdout" out
+"$BIN" "$KEY" listindex >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 listindex exit $ec; want 0"
+
+expect_index_table_shape "F3 listindex stdout" out 1
+IDX=$(expect_index_entry "F3 listindex stdout" out 0 T 1)
+[ "$IDX" -gt 0 ] || fail "F3 index id should be positive decimal, got $IDX"
+expect_empty "F3 listindex stderr" err
+
+
+
+
+KEY=$((BASE + 2)); add_key "$KEY"
+"$BIN" "$KEY" createhash 9 >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F4 createhash exit $ec; want 0"
+expect_empty "F4 createhash stdout" out
+"$BIN" "$KEY" listindex >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F4 listindex exit $ec; want 0"
+
+expect_index_table_shape "F4 listindex stdout" out 1
+IDX=$(expect_index_entry "F4 listindex stdout" out 9 '#J' 1)
+[ "$IDX" -gt 0 ] || fail "F4 index id should be positive decimal, got $IDX"
+expect_empty "F4 listindex stderr" err
+
+
+
+
+KEY=$((BASE + 3)); add_key "$KEY"
+"$BIN" "$KEY" createhash 0 2 5 >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F5 createhash exit $ec; want 0"
+expect_empty "F5 createhash stdout" out
+"$BIN" "$KEY" listindex >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F5 listindex exit $ec; want 0"
+
+expect_index_table_shape "F5 listindex stdout" out 3
+IDX0=$(expect_index_entry "F5 listindex stdout" out 0 '#J' 3)
+IDX2=$(expect_index_entry "F5 listindex stdout" out 2 '#J' 3)
+IDX5=$(expect_index_entry "F5 listindex stdout" out 5 '#J' 3)
+[ "$IDX0" = "$IDX2" ] && [ "$IDX0" = "$IDX5" ] \
+  || fail "F5 multi-column hash entries should share one index id: $IDX0 $IDX2 $IDX5"
+expect_empty "F5 listindex stderr" err
+
+
+
+
+KEY=$((BASE + 4)); add_key "$KEY"
+"$BIN" "$KEY" createindex 7 >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F6 createindex exit $ec; want 0"
+expect_empty "F6 createindex stdout" out
+"$BIN" "$KEY" createhash 4 8 >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F6 createhash exit $ec; want 0"
+expect_empty "F6 createhash stdout" out
+"$BIN" "$KEY" listindex >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F6 listindex exit $ec; want 0"
+
+expect_index_table_shape "F6 stdout" out 3
+IDX_HASH_4=$(expect_index_entry "F6 stdout" out 4 '#J' 2)
+IDX_T=$(expect_index_entry "F6 stdout" out 7 T 1)
+IDX_HASH_8=$(expect_index_entry "F6 stdout" out 8 '#J' 2)
+[ "$IDX_HASH_4" = "$IDX_HASH_8" ] \
+  || fail "F6 hash entries should share one index id: $IDX_HASH_4 $IDX_HASH_8"
+[ "$IDX_T" != "$IDX_HASH_4" ] \
+  || fail "F6 T-tree and hash indexes should have distinct ids: $IDX_T"
+expect_empty "F6 stderr" err
+
+
+
+
+KEY=$((BASE + 5)); add_key "$KEY"
+"$BIN" "$KEY" createindex 2 >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F7 createindex exit $ec; want 0"
+expect_empty "F7 createindex stdout" out
+
+"$BIN" "$KEY" listindex >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F7 pre-drop listindex exit $ec; want 0"
+expect_index_table_shape "F7 pre-drop listindex stdout" out 1
+IDX=$(expect_index_entry "F7 pre-drop listindex stdout" out 2 T 1)
+expect_empty "F7 pre-drop listindex stderr" err
+"$BIN" "$KEY" dropindex "$IDX" >out 2>err; ec=$?
+EXPECTED=$'Index dropped.'
+[ "$ec" -eq 0 ] || fail "F7 dropindex exit $ec; want 0"
+expect_file "F7 stdout" out "$EXPECTED"
+expect_empty "F7 stderr" err
+"$BIN" "$KEY" listindex >out 2>err; ec=$?
+EXPECTED=$'No indexes in the database.'
+[ "$ec" -eq 0 ] || fail "F7 listindex exit $ec; want 0"
+expect_file "F7 listindex stdout" out "$EXPECTED"
+expect_empty "F7 listindex stderr" err
+
+
+
+
+KEY=$((BASE + 6)); add_key "$KEY"
+"$BIN" "$KEY" dropindex 12345 >out 2>err; ec=$?
+
+expect_empty "F8 stdout" out
+
+grep -Fqx 'Failed to drop index.' err || fail "F8 stderr missing required line: $(cat err)"
+
+
+
+
+KEY=$((BASE + 7)); add_key "$KEY"
+"$BAD_SHM" "$KEY" >helper.out 2>helper.err || fail "F9 make_bad_shm: $(cat helper.err)"
+"$BIN" "$KEY" listindex >out 2>err; ec=$?
+[ "$ec" -eq 1 ] || fail "F9 listindex exit $ec; want 1"
+expect_empty "F9 stdout" out
+
+grep -Fqx 'Failed to attach to database.' err || fail "F9 stderr missing required line: $(cat err)"
+ipcrm -M "$KEY" >/dev/null 2>/dev/null || true
+
+echo "PASS"
+exit 0
