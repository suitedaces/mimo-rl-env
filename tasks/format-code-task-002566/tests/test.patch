+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /testbed
+
+
+export PATH="$HOME/.pyenv/bin:$PATH"
+if command -v pyenv &>/dev/null; then
+    eval "$(pyenv init --path)"
+    eval "$(pyenv init -)"
+    pyenv global 3.6.15 2>/dev/null || true
+fi
+
+
+export PYTHONPATH=/testbed
+
+case "${1:-}" in
+  base)
+    python --version
+    python -m pytest \
+      tests/unit/modules/test_dockermod.py::DockerTestCase::test_check_mine_cache_is_refreshed_on_container_change_event \
+      -v --noconftest -o "addopts="
+    ;;
+  new)
+    python --version
+    python -m pytest \
+      tests/unit/modules/test_dockermod.py::DockerTestCase::test_docker_lifecycle_updates_mine_by_default \
+      tests/unit/modules/test_dockermod.py::DockerTestCase::test_docker_lifecycle_does_not_update_mine_when_disabled \
+      tests/unit/modules/test_dockermod.py::DockerTestCase::test_docker_update_mine_disabled_applies_to_repeated_lifecycle_changes \
+      tests/unit/modules/test_dockermod.py::DockerTestCase::test_docker_update_mine_disabled_applies_to_other_lifecycle_actions \
+      -v --noconftest -o "addopts="
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
