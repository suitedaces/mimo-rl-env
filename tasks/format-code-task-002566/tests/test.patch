+    def test_docker_lifecycle_updates_mine_by_default(self):
+        '''
+        Docker lifecycle changes keep updating the mine when no opt-out is set.
+        '''
+        mine_send = Mock()
+
+        def config_get(key, default=None):
+            if key == 'docker.update_mine':
+                return default
+            return docker_mod.NOTSET
+
+        with patch.dict(docker_mod.__salt__, {
+                    'config.get': MagicMock(side_effect=config_get),
+                    'mine.send': mine_send,
+                }), \
+                patch.dict(docker_mod.__context__, {'docker.client': Mock()}, clear=True), \
+                patch.object(docker_mod, 'state', MagicMock(return_value='stopped')):
+            docker_mod.stop('default-update-container', timeout=2)
+
+        self.assertEqual(mine_send.call_count, 1)
+
+    def test_docker_lifecycle_does_not_update_mine_when_disabled(self):
+        '''
+        docker.update_mine=False suppresses automatic Docker mine publication.
+        '''
+        mine_send = Mock()
+
+        def config_get(key, default=None):
+            if key == 'docker.update_mine':
+                return False
+            return docker_mod.NOTSET
+
+        with patch.dict(docker_mod.__salt__, {
+                    'config.get': MagicMock(side_effect=config_get),
+                    'mine.send': mine_send,
+                }), \
+                patch.dict(docker_mod.__context__, {'docker.client': Mock()}, clear=True), \
+                patch.object(docker_mod, 'state', MagicMock(return_value='stopped')):
+            docker_mod.stop('disabled-update-container', timeout=3)
+
+        mine_send.assert_not_called()
+
+    def test_docker_update_mine_disabled_applies_to_repeated_lifecycle_changes(self):
+        '''
+        The disabled setting is not limited to one sample container or first call.
+        '''
+        mine_send = Mock()
+
+        def config_get(key, default=None):
+            if key == 'docker.update_mine':
+                return False
+            return docker_mod.NOTSET
+
+        with patch.dict(docker_mod.__salt__, {
+                    'config.get': MagicMock(side_effect=config_get),
+                    'mine.send': mine_send,
+                }), \
+                patch.dict(docker_mod.__context__, {'docker.client': Mock()}, clear=True), \
+                patch.object(docker_mod, 'state', MagicMock(return_value='stopped')):
+            docker_mod.stop('disabled-update-container-a', timeout=1)
+            docker_mod.stop('disabled-update-container-b', timeout=7)
+
+        mine_send.assert_not_called()
+
+    def test_docker_update_mine_disabled_applies_to_other_lifecycle_actions(self):
+        '''
+        docker.update_mine=False applies beyond one container name or action.
+        '''
+        mine_send = Mock()
+
+        def config_get(key, default=None):
+            if key == 'docker.update_mine':
+                return False
+            return docker_mod.NOTSET
+
+        with patch.dict(docker_mod.__salt__, {
+                    'config.get': MagicMock(side_effect=config_get),
+                    'mine.send': mine_send,
+                }), \
+                patch.dict(docker_mod.__context__, {'docker.client': Mock()}, clear=True), \
+                patch.object(docker_mod, 'state', MagicMock(return_value='stopped')):
+            docker_mod.start_('unpublished-container-name')
+
+        mine_send.assert_not_called()
+
