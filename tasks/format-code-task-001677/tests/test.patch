+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+
+
+if [ ! -f node_modules/babel-core/register.js ] ||
+   [ ! -f node_modules/ffmpeg.js/ffmpeg-worker-webm.js ]; then
+  echo "offline dependencies are missing from /workspace/repo/node_modules" >&2
+  exit 1
+fi
+
+exec node /workspace/repo/usercase-test-coderl/pool.test.js
