--- /dev/null
+++ b/usercase-test-coderl/test_add_dp_noise.py
@@ -0,0 +1,382 @@
+
+
+import collections
+import numbers
+import re
+
+import pytest
+
+import pipeline_dp
+from pipeline_dp import report_generator
+
+
+def _new_engine(total_epsilon=2, total_delta=0, **accountant_kwargs):
+    accountant = pipeline_dp.NaiveBudgetAccountant(
+        total_epsilon=total_epsilon,
+        total_delta=total_delta,
+        **accountant_kwargs,
+    )
+    return pipeline_dp.DPEngine(accountant, pipeline_dp.LocalBackend()), accountant
+
+
+def _compute_and_list(accountant, output):
+    accountant.compute_budgets()
+    return list(output)
+
+
+def _assert_keys_match(rows, expected_keys):
+
+    assert collections.Counter(key for key, _ in rows) == collections.Counter(
+        expected_keys)
+
+
+def _assert_noise_result_fields(value):
+
+    assert hasattr(value, "noised_value")
+    assert hasattr(value, "noise_stddev")
+    assert isinstance(value.noised_value, numbers.Real)
+    assert isinstance(value.noise_stddev, numbers.Real)
+
+
+def _assert_bare_number(value):
+
+    assert isinstance(value, numbers.Real)
+    assert not hasattr(value, "noise_stddev")
+
+
+def _assert_report_describes_noise(report_text, noise_kind, parameter):
+
+    assert report_text.strip()
+    assert "add_dp_noise" in report_text
+    assert noise_kind.name in report_text or noise_kind.name.lower(
+    ) in report_text.lower()
+    noise_lines = [
+        re.sub(r"^\s*\d+\.\s*", "", line)
+        for line in report_text.splitlines()
+        if noise_kind.name.lower() in line.lower()
+    ]
+    numeric_tokens = [
+        float(match.group(0)) for line in noise_lines
+        for match in re.finditer(
+            r"[-+]?(?:\d+\.\d*|\.\d+|\d+)(?:[eE][-+]?\d+)?",
+            line,
+        )
+    ]
+    assert any(value == pytest.approx(parameter) for value in numeric_tokens)
+
+
+def _mechanism_summaries(accountant, include_budget):
+    if include_budget:
+        return [(spec.mechanism_type.name, spec.eps, spec.delta, spec.count)
+                for spec in accountant.mechanism_specs]
+    return [(spec.mechanism_type.name, spec.count)
+            for spec in accountant.mechanism_specs]
+
+
+def test_laplace_l0_linf_preserves_keys_reports_stddev_and_parameter():
+
+
+
+    engine, accountant = _new_engine(total_epsilon=2, total_delta=0)
+    report = report_generator.ExplainComputationReport()
+    params = pipeline_dp.AddDPNoiseParams(
+        noise_kind=pipeline_dp.NoiseKind.LAPLACE,
+        l0_sensitivity=5,
+        linf_sensitivity=15,
+        output_noise_stddev=True,
+    )
+
+    output = engine.add_dp_noise(
+        [(0, 0), (1, 1)],
+        params,
+        out_explain_computation_report=report,
+    )
+
+    assert accountant.finalized is False
+
+    assert _mechanism_summaries(accountant, include_budget=False) == [("LAPLACE",
+                                                                       1)]
+
+    rows = _compute_and_list(accountant, output)
+
+    assert accountant.finalized is True
+
+    assert _mechanism_summaries(accountant, include_budget=True) == [
+        ("LAPLACE", 2.0, 0, 1)
+    ]
+    _assert_keys_match(rows, [0, 1])
+    for _, value in rows:
+        _assert_noise_result_fields(value)
+    assert rows[0][1].noise_stddev == pytest.approx(53.033008588991066)
+    assert rows[1][1].noise_stddev == pytest.approx(53.033008588991066)
+    _assert_report_describes_noise(report.text(), pipeline_dp.NoiseKind.LAPLACE,
+                                   37.5)
+
+
+def test_laplace_direct_l1_sensitivity_uses_bare_numeric_outputs():
+
+
+
+    engine, accountant = _new_engine(total_epsilon=2, total_delta=0)
+    params = pipeline_dp.AddDPNoiseParams(
+        noise_kind=pipeline_dp.NoiseKind.LAPLACE,
+        l1_sensitivity=5,
+    )
+    report = report_generator.ExplainComputationReport()
+
+    output = engine.add_dp_noise(
+        [(10, 2), (11, 4)],
+        params,
+        out_explain_computation_report=report,
+    )
+    rows = _compute_and_list(accountant, output)
+
+    _assert_keys_match(rows, [10, 11])
+    for _, value in rows:
+        _assert_bare_number(value)
+
+    assert _mechanism_summaries(accountant, include_budget=True) == [
+        ("LAPLACE", 2.0, 0, 1)
+    ]
+    _assert_report_describes_noise(report.text(), pipeline_dp.NoiseKind.LAPLACE,
+                                   2.5)
+
+
+def test_gaussian_l2_uses_delta_and_reports_gaussian_stddev():
+
+
+
+    engine, accountant = _new_engine(total_epsilon=2, total_delta=1e-5)
+    params = pipeline_dp.AddDPNoiseParams(
+        noise_kind=pipeline_dp.NoiseKind.GAUSSIAN,
+        l2_sensitivity=3,
+        output_noise_stddev=True,
+    )
+    report = report_generator.ExplainComputationReport()
+
+    output = engine.add_dp_noise(
+        [(2, 0), (3, 1)],
+        params,
+        out_explain_computation_report=report,
+    )
+    rows = _compute_and_list(accountant, output)
+
+    _assert_keys_match(rows, [2, 3])
+    for _, value in rows:
+        _assert_noise_result_fields(value)
+    assert rows[0][1].noise_stddev == pytest.approx(5.982421875)
+    assert rows[1][1].noise_stddev == pytest.approx(5.982421875)
+
+    assert _mechanism_summaries(accountant, include_budget=True) == [
+        ("GAUSSIAN", 2.0, 1e-05, 1)
+    ]
+    _assert_report_describes_noise(report.text(), pipeline_dp.NoiseKind.GAUSSIAN,
+                                   5.982421875)
+
+
+def test_budget_weight_changes_allocated_budget_and_noise_per_session():
+
+
+
+    accountant = pipeline_dp.NaiveBudgetAccountant(
+        total_epsilon=9,
+        total_delta=0,
+        aggregation_weights=[1, 2],
+    )
+    engine_a = pipeline_dp.DPEngine(accountant, pipeline_dp.LocalBackend())
+    engine_b = pipeline_dp.DPEngine(accountant, pipeline_dp.LocalBackend())
+    report_a = report_generator.ExplainComputationReport()
+    report_b = report_generator.ExplainComputationReport()
+    output_a = engine_a.add_dp_noise(
+        [(100, 10)],
+        pipeline_dp.AddDPNoiseParams(
+            noise_kind=pipeline_dp.NoiseKind.LAPLACE,
+            l1_sensitivity=3,
+            budget_weight=1,
+            output_noise_stddev=True,
+        ),
+        out_explain_computation_report=report_a,
+    )
+    output_b = engine_b.add_dp_noise(
+        [(200, 20)],
+        pipeline_dp.AddDPNoiseParams(
+            noise_kind=pipeline_dp.NoiseKind.LAPLACE,
+            l1_sensitivity=3,
+            budget_weight=2,
+            output_noise_stddev=True,
+        ),
+        out_explain_computation_report=report_b,
+    )
+
+    accountant.compute_budgets()
+    rows_a = list(output_a)
+    rows_b = list(output_b)
+
+
+    assert sorted(_mechanism_summaries(accountant, include_budget=True)) == [
+        ("LAPLACE", 3.0, 0, 1),
+        ("LAPLACE", 6.0, 0, 1),
+    ]
+    assert [(key, value.noise_stddev) for key, value in rows_a] == pytest.approx(
+        [(100, 1.4142135623730951)])
+    assert [(key, value.noise_stddev) for key, value in rows_b] == pytest.approx(
+        [(200, 0.7071067811865476)])
+    _assert_report_describes_noise(report_a.text(), pipeline_dp.NoiseKind.LAPLACE,
+                                   1.0)
+    _assert_report_describes_noise(report_b.text(), pipeline_dp.NoiseKind.LAPLACE,
+                                   0.5)
+
+
+def test_two_independent_engine_instances_keep_their_own_report_state():
+
+
+
+    engine_a, accountant_a = _new_engine(total_epsilon=2, total_delta=0)
+    engine_b, accountant_b = _new_engine(total_epsilon=2, total_delta=0)
+    report_a = report_generator.ExplainComputationReport()
+    report_b = report_generator.ExplainComputationReport()
+
+    output_a = engine_a.add_dp_noise(
+        [(0, 0)],
+        pipeline_dp.AddDPNoiseParams(
+            noise_kind=pipeline_dp.NoiseKind.LAPLACE,
+            l1_sensitivity=5,
+            output_noise_stddev=True,
+        ),
+        out_explain_computation_report=report_a,
+    )
+
+
+    with pytest.raises(ValueError):
+        report_b.text()
+
+    _compute_and_list(accountant_a, output_a)
+    output_b = engine_b.add_dp_noise(
+        [(1, 1)],
+        pipeline_dp.AddDPNoiseParams(
+            noise_kind=pipeline_dp.NoiseKind.LAPLACE,
+            l1_sensitivity=5,
+            output_noise_stddev=True,
+        ),
+        out_explain_computation_report=report_b,
+    )
+    _compute_and_list(accountant_b, output_b)
+
+    _assert_report_describes_noise(report_a.text(), pipeline_dp.NoiseKind.LAPLACE,
+                                   2.5)
+    _assert_report_describes_noise(report_b.text(), pipeline_dp.NoiseKind.LAPLACE,
+                                   2.5)
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        ({
+            "l0_sensitivity": 0
+        }),
+        ({
+            "linf_sensitivity": -1
+        }),
+        ({
+            "l1_sensitivity": 0
+        }),
+        ({
+            "l2_sensitivity": -5
+        }),
+        ({
+            "l1_sensitivity": 5,
+            "budget_weight": 0
+        }),
+    ],
+)
+def test_add_dp_noise_params_reject_non_positive_values(kwargs):
+
+
+
+
+    with pytest.raises(ValueError):
+        pipeline_dp.AddDPNoiseParams(
+            noise_kind=pipeline_dp.NoiseKind.LAPLACE,
+            **kwargs,
+        )
+
+
+@pytest.mark.parametrize(
+    ("noise_kind", "kwargs", "total_delta"),
+    [
+        (
+            pipeline_dp.NoiseKind.LAPLACE,
+            {},
+            0,
+        ),
+        (
+            pipeline_dp.NoiseKind.LAPLACE,
+            {"l0_sensitivity": 5},
+            0,
+        ),
+        (
+            pipeline_dp.NoiseKind.GAUSSIAN,
+            {},
+            1e-5,
+        ),
+        (
+            pipeline_dp.NoiseKind.GAUSSIAN,
+            {"linf_sensitivity": 15},
+            1e-5,
+        ),
+    ],
+)
+def test_add_dp_noise_rejects_missing_required_sensitivity_shapes(
+        noise_kind, kwargs, total_delta):
+
+
+
+
+    with pytest.raises(ValueError):
+        engine, accountant = _new_engine(total_epsilon=2, total_delta=total_delta)
+        output = engine.add_dp_noise(
+            [(0, 0)],
+            pipeline_dp.AddDPNoiseParams(noise_kind=noise_kind, **kwargs),
+        )
+        accountant.compute_budgets()
+        list(output)
+
+
+def test_materializing_output_before_budget_computation_raises_assertion_error():
+
+
+
+    engine, accountant = _new_engine(total_epsilon=2, total_delta=0)
+    output = engine.add_dp_noise(
+        [(0, 0)],
+        pipeline_dp.AddDPNoiseParams(
+            noise_kind=pipeline_dp.NoiseKind.LAPLACE,
+            l1_sensitivity=5,
+        ),
+    )
+
+    assert accountant.finalized is False
+
+    with pytest.raises(AssertionError):
+        list(output)
+
+
+def test_construct_use_finalize_cycles_do_not_retain_python_session_state():
+
+
+
+    def run_cycle():
+        engine, accountant = _new_engine(total_epsilon=2, total_delta=0)
+        output = engine.add_dp_noise(
+            [(0, 0), (1, 1)],
+            pipeline_dp.AddDPNoiseParams(
+                noise_kind=pipeline_dp.NoiseKind.LAPLACE,
+                l1_sensitivity=5,
+            ),
+        )
+        return _compute_and_list(accountant, output)
+
+    for _ in range(100):
+        rows = run_cycle()
+
+        _assert_keys_match(rows, [0, 1])
