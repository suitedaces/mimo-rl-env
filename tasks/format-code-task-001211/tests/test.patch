+func TestInvalidForwardingHeaderReturnsErrorAndDoesNotQueueChannel(t *testing.T) {
+
+
+	conn := newFakeConnection(t, 7, 11)
+	conv := newServerConversation(t, conn, 4096)
+	h3Server := &http3.Server{}
+	server := ssh3.NewServer(4096, 3, h3Server, func(string, *ssh3.Conversation) error { return nil })
+	registerConversation(t, server, conn, conv)
+
+	badFamily := newMemoryStream(11, buildIncomingHeader(7, "direct-udp", 900, []byte{5, 198, 51, 100, 4, 15, 160}))
+	hijacked, err := h3Server.StreamHijacker(ssh3.SSH_FRAME_TYPE, conn, badFamily, nil)
+	if hijacked != false {
+		t.Fatalf("bad-family hijacked = %v, want false", hijacked)
+	}
+
+	if err == nil {
+		t.Fatal("bad-family err = nil, want invalid address family error")
+	}
+
+	shortIPv4 := newMemoryStream(15, buildIncomingHeader(7, "direct-tcp", 900, []byte{4, 203, 0, 113}))
+	hijacked, err = h3Server.StreamHijacker(ssh3.SSH_FRAME_TYPE, conn, shortIPv4, nil)
+	if hijacked != false {
+		t.Fatalf("short-header hijacked = %v, want false", hijacked)
+	}
+
+	if err == nil {
+		t.Fatal("short-header err = nil, want error")
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	accepted, acceptErr := conv.AcceptChannel(ctx)
+	if accepted != nil {
+		t.Fatalf("accepted channel = %v, want nil", accepted)
+	}
+	if !errors.Is(acceptErr, context.Canceled) {
+		t.Fatalf("accept err = %T %v, want context.Canceled", acceptErr, acceptErr)
+	}
+}
+
+func TestForwardingChannelCloseUsesEmbeddedChannel(t *testing.T) {
+
+
+	conn := newFakeConnection(t, 7, 11)
+	conv := newServerConversation(t, conn, 4096)
+	remote := &net.TCPAddr{IP: net.IPv4(192, 0, 2, 44).To4(), Port: 2222}
+	local := &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 0}
+
+	channel, err := conv.OpenTCPForwardingChannel(1200, 0, local, remote)
+	if err != nil {
+		t.Fatalf("OpenTCPForwardingChannel: %v", err)
+	}
+	channel.Close()
+
+	if len(conn.opened) != 1 {
+		t.Fatalf("opened stream count = %d, want 1", len(conn.opened))
+	}
+	if conn.opened[0].closeCalls != 1 {
+		t.Fatalf("forwarding channel close calls = %d, want 1", conn.opened[0].closeCalls)
+	}
+}
+
+func TestForwardingLifecycleRepeatedConstructUseCleanupCycles(t *testing.T) {
+
+
+	for i := 0; i < 100; i++ {
+		conn := newFakeConnection(t, 7, 11)
+		conv := newServerConversation(t, conn, 4096)
+		remote := &net.UDPAddr{IP: net.IPv4(192, 0, 2, byte(10+i%20)).To4(), Port: 4242}
+		local := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 5353}
+		channel, err := conv.OpenUDPForwardingChannel(1200, 5, local, remote)
+		if err != nil {
+			t.Fatalf("cycle %d open UDP forwarding: %v", i, err)
+		}
+		if err := channel.SendDatagram([]byte{1}); err != nil {
+			t.Fatalf("cycle %d send datagram: %v", i, err)
+		}
+		channel.Close()
+
+		if len(conn.opened) != 1 {
+			t.Fatalf("cycle %d opened stream count = %d, want 1", i, len(conn.opened))
+		}
+		if conn.opened[0].closeCalls != 1 {
+			t.Fatalf("cycle %d stream close calls = %d, want 1", i, conn.opened[0].closeCalls)
+		}
+		if len(conn.datagrams) != 1 || !bytes.Equal(conn.datagrams[0], []byte{7, 11, 1}) {
+			t.Fatalf("cycle %d sent datagrams = %v, want [[7 11 1]]", i, conn.datagrams)
+		}
+	}
+}
