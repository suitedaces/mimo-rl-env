+func buildIncomingHeader(conversationStreamID uint64, channelType string, maxPacketSize uint64, extra []byte) []byte {
+	buf := util.AppendVarInt(nil, conversationStreamID)
+	sshString := make([]byte, util.SSHStringLen(channelType))
+	if _, err := util.WriteSSHString(sshString, channelType); err != nil {
+		panic(err)
+	}
+	buf = append(buf, sshString...)
+	buf = util.AppendVarInt(buf, maxPacketSize)
+	buf = append(buf, extra...)
+	return buf
+}
+
+func decodeOutboundHeader(t *testing.T, data []byte) (uint64, uint64, string, uint64, []byte) {
+	t.Helper()
+	reader := util.NewReader(bytes.NewReader(data))
+	frameType, err := util.ReadVarInt(reader)
+	if err != nil {
+		t.Fatalf("frame type: %v", err)
+	}
+	conversationID, err := util.ReadVarInt(reader)
+	if err != nil {
+		t.Fatalf("conversation id: %v", err)
+	}
+	channelType, err := util.ParseSSHString(reader)
+	if err != nil {
+		t.Fatalf("channel type: %v", err)
+	}
+	maxPacketSize, err := util.ReadVarInt(reader)
+	if err != nil {
+		t.Fatalf("max packet size: %v", err)
+	}
+	remaining, err := io.ReadAll(reader)
+	if err != nil {
+		t.Fatalf("remaining bytes: %v", err)
+	}
+	return frameType, conversationID, channelType, maxPacketSize, remaining
+}
