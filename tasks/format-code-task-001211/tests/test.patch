+type memoryStream struct {
+	id         quic.StreamID
+	read       *bytes.Reader
+	written    bytes.Buffer
+	closeCalls int
+}
+
+func newMemoryStream(id int64, payload []byte) *memoryStream {
+	return &memoryStream{id: quic.StreamID(id), read: bytes.NewReader(payload)}
+}
+
+func (s *memoryStream) StreamID() quic.StreamID          { return s.id }
+func (s *memoryStream) Read(p []byte) (int, error)       { return s.read.Read(p) }
+func (s *memoryStream) Write(p []byte) (int, error)      { return s.written.Write(p) }
+func (s *memoryStream) Close() error                     { s.closeCalls++; return nil }
+func (s *memoryStream) CancelRead(quic.StreamErrorCode)  {}
+func (s *memoryStream) CancelWrite(quic.StreamErrorCode) {}
+func (s *memoryStream) Context() context.Context         { return context.Background() }
+func (s *memoryStream) SetDeadline(time.Time) error      { return nil }
+func (s *memoryStream) SetReadDeadline(time.Time) error  { return nil }
+func (s *memoryStream) SetWriteDeadline(time.Time) error { return nil }
+
+type fakeConnection struct {
+	ctx       context.Context
+	tlsState  tls.ConnectionState
+	control   *memoryStream
+	nextID    int64
+	opened    []*memoryStream
+	datagrams [][]byte
+	openErr   error
+}
+
+func newFakeConnection(t *testing.T, controlID int64, nextID int64) *fakeConnection {
+	t.Helper()
+	return &fakeConnection{
+		ctx:      context.Background(),
+		tlsState: realTLSState(t),
+		control:  newMemoryStream(controlID, nil),
+		nextID:   nextID,
+	}
+}
+
+func (c *fakeConnection) AcceptStream(context.Context) (quic.Stream, error) {
+	return nil, io.EOF
+}
+
+func (c *fakeConnection) AcceptUniStream(context.Context) (quic.ReceiveStream, error) {
+	return nil, io.EOF
+}
+
+func (c *fakeConnection) OpenStream() (quic.Stream, error) {
+	if c.openErr != nil {
+		return nil, c.openErr
+	}
+	stream := newMemoryStream(c.nextID, nil)
+	c.nextID += 4
+	c.opened = append(c.opened, stream)
+	return stream, nil
+}
+
+func (c *fakeConnection) OpenStreamSync(context.Context) (quic.Stream, error) {
+	return c.OpenStream()
+}
+
+func (c *fakeConnection) OpenUniStream() (quic.SendStream, error) {
