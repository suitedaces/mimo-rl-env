+func TestAcceptChannelReturnsUDPForwardingWrapperAndQueuedDatagram(t *testing.T) {
+
+
+	conn := newFakeConnection(t, 7, 11)
+	conv := newServerConversation(t, conn, 4096)
+	h3Server := &http3.Server{}
+	server := ssh3.NewServer(4096, 3, h3Server, func(string, *ssh3.Conversation) error { return nil })
+	registerConversation(t, server, conn, conv)
+
+	if err := conv.AddDatagram(context.Background(), []byte{11, 222, 173}); err == nil {
+		t.Fatal("AddDatagram err = nil, want ChannelNotFound")
+	} else {
+		var notFound util.ChannelNotFound
+		if !errors.As(err, &notFound) {
+			t.Fatalf("AddDatagram err = %T, want util.ChannelNotFound", err)
+		}
+	}
+	incoming := newMemoryStream(11, buildIncomingHeader(7, "direct-udp", 900, []byte{4, 198, 51, 100, 4, 15, 160}))
+	hijacked, err := h3Server.StreamHijacker(ssh3.SSH_FRAME_TYPE, conn, incoming, nil)
+	if err != nil {
+		t.Fatalf("hijack direct-udp: %v", err)
+	}
+	if hijacked != true {
+		t.Fatalf("hijacked = %v, want true", hijacked)
+	}
+	accepted, err := conv.AcceptChannel(context.Background())
+	if err != nil {
+		t.Fatalf("AcceptChannel: %v", err)
+	}
+	udp, ok := accepted.(*ssh3.UDPForwardingChannelImpl)
+	if !ok {
+		t.Fatalf("accepted type = %T, want *ssh3.UDPForwardingChannelImpl", accepted)
+	}
+	if accepted.ChannelID() != 11 {
+		t.Fatalf("accepted channel id = %d, want 11", accepted.ChannelID())
+	}
+	if accepted.ChannelType() != "direct-udp" {
+		t.Fatalf("accepted channel type = %q, want %q", accepted.ChannelType(), "direct-udp")
+	}
+	if accepted.MaxPacketSize() != 900 {
+		t.Fatalf("accepted max packet size = %d, want 900", accepted.MaxPacketSize())
+	}
+	if udp.RemoteAddr.String() != "198.51.100.4:4000" {
+		t.Fatalf("accepted remote = %q, want %q", udp.RemoteAddr.String(), "198.51.100.4:4000")
+	}
+	if !bytes.Equal(incoming.written.Bytes(), []byte{64, 91, 80, 0}) {
+		t.Fatalf("confirmation bytes = %v, want [64 91 80 0]", incoming.written.Bytes())
+	}
+	datagram, err := accepted.ReceiveDatagram(context.Background())
+	if err != nil {
+		t.Fatalf("ReceiveDatagram: %v", err)
+	}
+	if !bytes.Equal(datagram, []byte{222, 173}) {
+		t.Fatalf("queued datagram = %v, want [222 173]", datagram)
+	}
+	if err := accepted.SendDatagram([]byte{1, 2}); err != nil {
+		t.Fatalf("SendDatagram on accepted UDP channel: %v", err)
+	}
+	if !bytes.Equal(conn.datagrams[0], []byte{7, 11, 1, 2}) {
+		t.Fatalf("accepted sent datagram = %v, want [7 11 1 2]", conn.datagrams[0])
+	}
+}
