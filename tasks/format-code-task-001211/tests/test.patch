+func TestForwardingOpenStreamFailureReturnsNilAndDoesNotRegisterChannel(t *testing.T) {
+
+
+	conn := newFakeConnection(t, 7, 11)
+	conn.openErr = errors.New("open stream exploded")
+	conv := newServerConversation(t, conn, 4096)
+	remote := &net.UDPAddr{IP: net.IPv4(203, 0, 113, 2).To4(), Port: 6000}
+	local := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 5353}
+
+	channel, err := conv.OpenUDPForwardingChannel(1200, 5, local, remote)
+	if channel != nil {
+		t.Fatalf("channel = %v, want nil", channel)
+	}
+	if err == nil {
+		t.Fatal("err = nil, want open stream error")
+	}
+
+	if !errors.Is(err, conn.openErr) {
+		t.Fatalf("err = %T %v, want original open stream error", err, err)
+	}
+	if len(conn.opened) != 0 {
+		t.Fatalf("opened stream count = %d, want 0", len(conn.opened))
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	accepted, acceptErr := conv.AcceptChannel(ctx)
+	if accepted != nil {
+		t.Fatalf("accepted channel = %v, want nil", accepted)
+	}
+	if !errors.Is(acceptErr, context.Canceled) {
+		t.Fatalf("accept err = %T %v, want context.Canceled", acceptErr, acceptErr)
+	}
+}
