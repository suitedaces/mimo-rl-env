+func newServerConversation(t *testing.T, conn *fakeConnection, maxPacketSize uint64) *ssh3.Conversation {
+	t.Helper()
+	conv, err := ssh3.NewServerConversation(context.Background(), conn.control, conn, conn, maxPacketSize, ssh3.ThisVersion())
+	if err != nil {
+		t.Fatalf("NewServerConversation: %v", err)
+	}
+	return conv
+}
+
+func registerConversation(t *testing.T, server *ssh3.Server, conn *fakeConnection, conv *ssh3.Conversation) {
+	t.Helper()
+	req, err := http.NewRequest(http.MethodConnect, "https://ssh3.example/ssh", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Proto = "ssh3"
+	rec := &responseRecorderHijacker{conn: conn}
+	server.GetHTTPHandlerFunc(context.Background())("alice", conv, rec, req)
+	if rec.status != 200 {
+		t.Fatalf("registered status = %d, want 200", rec.status)
+	}
+}
