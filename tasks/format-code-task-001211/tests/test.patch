+func TestOpenUDPForwardingChannelWritesHeaderRegistersStateAndSendsDatagrams(t *testing.T) {
+
+
+	conn := newFakeConnection(t, 7, 11)
+	conv := newServerConversation(t, conn, 4096)
+	remote := &net.UDPAddr{IP: net.IPv4(192, 0, 2, 9).To4(), Port: 4242}
+	local := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 5353}
+
+	channel, err := conv.OpenUDPForwardingChannel(1200, 5, local, remote)
+	if err != nil {
+		t.Fatalf("OpenUDPForwardingChannel: %v", err)
+	}
+	udpChannel, ok := channel.(*ssh3.UDPForwardingChannelImpl)
+	if !ok {
+		t.Fatalf("channel type = %T, want *ssh3.UDPForwardingChannelImpl", channel)
+	}
+	if channel.ChannelID() != 11 {
+		t.Fatalf("ChannelID = %d, want 11", channel.ChannelID())
+	}
+	if channel.ConversationStreamID() != 7 {
+		t.Fatalf("ConversationStreamID = %d, want 7", channel.ConversationStreamID())
+	}
+	if channel.ChannelType() != "direct-udp" {
+		t.Fatalf("ChannelType = %q, want %q", channel.ChannelType(), "direct-udp")
+	}
+	if channel.MaxPacketSize() != 1200 {
+		t.Fatalf("MaxPacketSize = %d, want 1200", channel.MaxPacketSize())
+	}
+	if udpChannel.RemoteAddr.String() != "192.0.2.9:4242" {
+		t.Fatalf("RemoteAddr = %q, want %q", udpChannel.RemoteAddr.String(), "192.0.2.9:4242")
+	}
+	if len(conn.opened) != 1 {
+		t.Fatalf("opened stream count = %d, want 1", len(conn.opened))
+	}
+
+	frameType, conversationID, channelType, maxPacketSize, extra := decodeOutboundHeader(t, conn.opened[0].written.Bytes())
+	if frameType != 2939561958 {
+		t.Fatalf("frame type = %d, want 2939561958", frameType)
+	}
+	if conversationID != 7 {
+		t.Fatalf("wire conversation id = %d, want 7", conversationID)
+	}
+	if channelType != "direct-udp" {
+		t.Fatalf("wire channel type = %q, want %q", channelType, "direct-udp")
+	}
+	if maxPacketSize != 1200 {
+		t.Fatalf("wire max packet size = %d, want 1200", maxPacketSize)
+	}
+	if !bytes.Equal(extra, []byte{4, 192, 0, 2, 9, 16, 146}) {
+		t.Fatalf("wire forwarding bytes = %v, want [4 192 0 2 9 16 146]", extra)
+	}
+
+	if err := channel.SendDatagram([]byte{170, 187}); err != nil {
+		t.Fatalf("SendDatagram: %v", err)
+	}
+	if len(conn.datagrams) != 1 {
+		t.Fatalf("sent datagram count = %d, want 1", len(conn.datagrams))
+	}
+	if !bytes.Equal(conn.datagrams[0], []byte{7, 11, 170, 187}) {
+		t.Fatalf("sent datagram = %v, want [7 11 170 187]", conn.datagrams[0])
+	}
+}
