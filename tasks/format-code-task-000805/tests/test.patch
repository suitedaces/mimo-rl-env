+func TestKubernetesUpdateDoesNotSendAutoUpgradeWhenUnset(t *testing.T) {
+	cases := []struct {
+		name       string
+		configure  func(*CmdConfig)
+		assertBody func(*testing.T, *godo.KubernetesClusterUpdateRequest)
+	}{
+		{
+			name: "tags changed",
+			configure: func(config *CmdConfig) {
+				config.Doit.Set(config.NS, doctl.ArgTag, []string{"env:test"})
+			},
+			assertBody: func(t *testing.T, r *godo.KubernetesClusterUpdateRequest) {
+
+				if r.AutoUpgrade != nil {
+					t.Fatalf("expected auto-upgrade to be omitted when --auto-upgrade is unset, got %v", *r.AutoUpgrade)
+				}
+				assert.Equal(t, []string{"env:test"}, r.Tags)
+			},
+		},
+		{
+			name: "name changed",
+			configure: func(config *CmdConfig) {
+				config.Doit.Set(config.NS, doctl.ArgClusterName, "renamed-cluster")
+			},
+			assertBody: func(t *testing.T, r *godo.KubernetesClusterUpdateRequest) {
+
+				if r.AutoUpgrade != nil {
+					t.Fatalf("expected auto-upgrade to be omitted when --auto-upgrade is unset, got %v", *r.AutoUpgrade)
+				}
+				assert.Equal(t, "renamed-cluster", r.Name)
+			},
+		},
+		{
+			name: "cluster id, prod namespace",
+			configure: func(config *CmdConfig) {
+				config.NS = "prod"
+				config.Doit.Set(config.NS, doctl.ArgTag, []string{"env:prod"})
+				config.Doit.Set(config.NS, doctl.ArgMaintenanceWindow, "tuesday=01:00")
+			},
+			assertBody: func(t *testing.T, r *godo.KubernetesClusterUpdateRequest) {
+				if r.AutoUpgrade != nil {
+					t.Fatalf("expected auto-upgrade to be omitted when --auto-upgrade is unset, got %v", *r.AutoUpgrade)
+				}
+				assert.Equal(t, []string{"env:prod"}, r.Tags)
+			},
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			withTestClient(t, func(config *CmdConfig, tm *tcMocks) {
+				config.Args = append(config.Args, testCluster.ID)
+				config.Doit.Set(config.NS, doctl.ArgMaintenanceWindow, "any=00:00")
+				tc.configure(config)
+
+				tm.kubernetes.EXPECT().
+					Update(testCluster.ID, gomock.Any()).
+					DoAndReturn(func(_ string, r *godo.KubernetesClusterUpdateRequest) (*do.KubernetesCluster, error) {
+						tc.assertBody(t, r)
+						return &testCluster, nil
+					})
+
+				err := testK8sCmdService().RunKubernetesClusterUpdate(config)
+				assert.NoError(t, err)
+			})
+		})
+	}
+}
+
+func TestKubernetesUpdateSendsExplicitAutoUpgradeValues(t *testing.T) {
+	cases := []struct {
+		name string
+		want bool
+	}{
+		{name: "true", want: true},
+		{name: "false", want: false},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			withTestClient(t, func(config *CmdConfig, tm *tcMocks) {
+				config.Args = append(config.Args, testCluster.ID)
+				config.Doit.Set(config.NS, doctl.ArgTag, []string{"env:test"})
+				config.Doit.Set(config.NS, doctl.ArgMaintenanceWindow, "any=00:00")
+				config.Doit.Set(config.NS, doctl.ArgAutoUpgrade, tc.want)
+
+				tm.kubernetes.EXPECT().
+					Update(testCluster.ID, gomock.Any()).
+					DoAndReturn(func(_ string, r *godo.KubernetesClusterUpdateRequest) (*do.KubernetesCluster, error) {
+
+						if r.AutoUpgrade == nil {
+							t.Fatalf("expected explicit --auto-upgrade=%v to be sent", tc.want)
+						}
+						assert.Equal(t, tc.want, *r.AutoUpgrade)
+						return &testCluster, nil
+					})
+
+				err := testK8sCmdService().RunKubernetesClusterUpdate(config)
+				assert.NoError(t, err)
+			})
+		})
+	}
+	t.Run("true with prod namespace", func(t *testing.T) {
+		withTestClient(t, func(config *CmdConfig, tm *tcMocks) {
+			config.NS = "prod"
+			config.Args = append(config.Args, testCluster.ID)
+			config.Doit.Set(config.NS, doctl.ArgTag, []string{"env:prod"})
+			config.Doit.Set(config.NS, doctl.ArgMaintenanceWindow, "tuesday=01:00")
+			config.Doit.Set(config.NS, doctl.ArgAutoUpgrade, true)
+
+			tm.kubernetes.EXPECT().
+				Update(testCluster.ID, gomock.Any()).
+				DoAndReturn(func(_ string, r *godo.KubernetesClusterUpdateRequest) (*do.KubernetesCluster, error) {
+					if r.AutoUpgrade == nil {
+						t.Fatalf("expected explicit --auto-upgrade=true to be sent")
+					}
+					assert.True(t, *r.AutoUpgrade)
+					return &testCluster, nil
+				})
+
+			err := testK8sCmdService().RunKubernetesClusterUpdate(config)
+			assert.NoError(t, err)
+		})
+	})
+}
