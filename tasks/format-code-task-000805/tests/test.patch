+func TestKubernetesNodePoolUpdateDoesNotSendCountWhenUnset(t *testing.T) {
+	cases := []struct {
+		name       string
+		configure  func(*CmdConfig)
+		assertBody func(*testing.T, *godo.KubernetesNodePoolUpdateRequest)
+	}{
+		{
+			name: "tags changed",
+			configure: func(config *CmdConfig) {
+				config.Doit.Set(config.NS, doctl.ArgTag, []string{"role:web"})
+			},
+			assertBody: func(t *testing.T, r *godo.KubernetesNodePoolUpdateRequest) {
+
+				if r.Count != nil {
+					t.Fatalf("expected count to be omitted when --count is unset, got %v", *r.Count)
+				}
+				assert.Equal(t, []string{"role:web"}, r.Tags)
+			},
+		},
+		{
+			name: "name changed",
+			configure: func(config *CmdConfig) {
+				config.Doit.Set(config.NS, doctl.ArgNodePoolName, "renamed-pool")
+			},
+			assertBody: func(t *testing.T, r *godo.KubernetesNodePoolUpdateRequest) {
+
+				if r.Count != nil {
+					t.Fatalf("expected count to be omitted when --count is unset, got %v", *r.Count)
+				}
+				assert.Equal(t, "renamed-pool", r.Name)
+			},
+		},
+		{
+			name: "pool id with prod namespace",
+			configure: func(config *CmdConfig) {
+				config.NS = "prod"
+				config.Doit.Set(config.NS, doctl.ArgNodePoolName, "worker-pool")
+				config.Doit.Set(config.NS, doctl.ArgTag, []string{"role:worker"})
+			},
+			assertBody: func(t *testing.T, r *godo.KubernetesNodePoolUpdateRequest) {
+				if r.Count != nil {
+					t.Fatalf("expected count to be omitted when --count is unset, got %v", *r.Count)
+				}
+				assert.Equal(t, "worker-pool", r.Name)
+				assert.Equal(t, []string{"role:worker"}, r.Tags)
+			},
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			withTestClient(t, func(config *CmdConfig, tm *tcMocks) {
+				config.Args = append(config.Args, testCluster.ID, testNodePool.ID)
+				tc.configure(config)
+
+				tm.kubernetes.EXPECT().
+					UpdateNodePool(testCluster.ID, testNodePool.ID, gomock.Any()).
+					DoAndReturn(func(_, _ string, r *godo.KubernetesNodePoolUpdateRequest) (*do.KubernetesNodePool, error) {
+						tc.assertBody(t, r)
+						return &testNodePool, nil
+					})
+
+				err := testK8sCmdService().RunKubernetesNodePoolUpdate(config)
+				assert.NoError(t, err)
+			})
+		})
+	}
+	t.Run("prod namespace nonfixture pool id", func(t *testing.T) {
+		withTestClient(t, func(config *CmdConfig, tm *tcMocks) {
+			config.NS = "prod"
+			const otherPoolID = "11111111-2222-3333-4444-555555555555"
+			config.Args = append(config.Args, testCluster.ID, otherPoolID)
+			config.Doit.Set(config.NS, doctl.ArgNodePoolName, "worker-pool")
+			config.Doit.Set(config.NS, doctl.ArgTag, []string{"role:worker"})
+
+			tm.kubernetes.EXPECT().
+				UpdateNodePool(testCluster.ID, otherPoolID, gomock.Any()).
+				DoAndReturn(func(_, _ string, r *godo.KubernetesNodePoolUpdateRequest) (*do.KubernetesNodePool, error) {
+					if r.Count != nil {
+						t.Fatalf("expected count to be omitted when --count is unset, got %v", *r.Count)
+					}
+					assert.Equal(t, "worker-pool", r.Name)
+					assert.Equal(t, []string{"role:worker"}, r.Tags)
+					return &testNodePool, nil
+				})
+
+			err := testK8sCmdService().RunKubernetesNodePoolUpdate(config)
+			assert.NoError(t, err)
+		})
+	})
+}
