+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+export GOTOOLCHAIN=local
+export GOPROXY=off
+export GOSUMDB=off
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+fail() {
+    echo "FAIL: $*" >&2
+    exit 1
+}
+
+BIN="$TMP/linuxkit-under-test"
+
+cp -a /workspace/repo/usercase-test-coderl/fixtures/vendor_overlay/. /workspace/repo/ \
+    || fail "stage offline overlay"
+( cd /workspace/repo/src/cmd/linuxkit && CGO_ENABLED=0 go build -mod=vendor -o "$BIN" . ) \
+    || fail "build"
+
+export HOME="$TMP/home"
+mkdir -p "$HOME"
+cd "$TMP" || fail "cd tmp"
+
+make_empty_cache() {
+    local dir=$1
+    mkdir -p "$dir/blobs/sha256"
+    printf '{"imageLayoutVersion":"1.0.0"}' > "$dir/oci-layout"
+    printf '{"schemaVersion":2,"manifests":[]}' > "$dir/index.json"
+}
+
+make_one_ref_cache() {
+    local dir=$1
+    local name=$2
+    local digest=$3
+    mkdir -p "$dir/blobs/sha256"
+    printf '{"imageLayoutVersion":"1.0.0"}' > "$dir/oci-layout"
+    cat > "$dir/index.json" <<EOF
+{"schemaVersion":2,"manifests":[{"mediaType":"application/vnd.oci.image.manifest.v1+json","digest":"$digest","size":123,"annotations":{"org.opencontainers.image.ref.name":"$name"}}]}
+EOF
+}
+
+make_multi_ref_cache() {
+    local dir=$1
+    mkdir -p "$dir/blobs/sha256"
+    printf '{"imageLayoutVersion":"1.0.0"}' > "$dir/oci-layout"
+    cat > "$dir/index.json" <<'EOF'
+{"schemaVersion":2,"manifests":[{"mediaType":"application/vnd.oci.image.manifest.v1+json","digest":"sha256:1111111111111111111111111111111111111111111111111111111111111111","size":123,"annotations":{"org.opencontainers.image.ref.name":"alpine:edge"}},{"mediaType":"application/vnd.oci.image.manifest.v1+json","digest":"sha256:9999999999999999999999999999999999999999999999999999999999999999","size":999},{"mediaType":"application/vnd.oci.image.manifest.v1+json","digest":"sha256:2222222222222222222222222222222222222222222222222222222222222222","size":456,"annotations":{"org.opencontainers.image.ref.name":"docker.io/library/nginx:latest"}}]}
+EOF
+}
+
+make_bad_index_cache() {
+    local dir=$1
+    mkdir -p "$dir/blobs/sha256"
+    printf '{"imageLayoutVersion":"1.0.0"}' > "$dir/oci-layout"
+    printf '{bad json' > "$dir/index.json"
+}
+
+assert_emitted_output() {
+    local fixture=$1
+
+    cat out err > emitted
+    [ -s emitted ] || fail "$fixture emitted output should not be empty"
+}
+
+assert_table_header() {
+    local fixture=$1
+    local line_count=$2
+    [ "$(wc -l < emitted | tr -d ' ')" -eq "$line_count" ] \
+        || fail "$fixture line count $(wc -l < emitted | tr -d ' '); want $line_count"
+
+    awk 'NR==1 {
+        line = tolower($0)
+        image_col = index(line, "image name")
+        root_col = index(line, "root manifest hash")
+        if (image_col < 1 || root_col <= image_col) exit 1
+    }' emitted || fail "$fixture header missing mandated columns: $(sed -n '1p' emitted)"
+}
+
+assert_hashes_start_in_root_column() {
+    local fixture=$1
+
+    awk '
+        NR==1 { root_col = index(tolower($0), "root manifest hash"); next }
+        NR>1 {
+            digest_col = index($0, "sha256:")
+            if (digest_col < 2 || root_col < 2 || digest_col != root_col) exit 1
+        }
+    ' emitted || fail "$fixture hashes do not all start under the root manifest hash column"
+}
+
+actual_rows() {
+
+    tail -n +2 emitted | awk '{
+        digest_col = index($0, "sha256:")
+        if (digest_col == 0) next
+        name = substr($0, 1, digest_col - 1)
+        sub(/[ ]+$/, "", name)
+        digest = substr($0, digest_col)
+        print name " " digest
+    }' | sort
+}
+
+
+
+
+"$BIN" cache --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+
+cat out err > emitted
+awk '
+    tolower($1) == "ls" {
+        line = tolower($0)
+        if (line ~ /list(s)?/ && line ~ /images/ && line ~ /linuxkit cache/) found = 1
+    }
+    END { exit found ? 0 : 1 }
+' emitted || fail "F1 help missing ls row that lists images in the linuxkit cache"
+
+
+
+
+make_empty_cache "$TMP/cache-empty"
+"$BIN" --cache "$TMP/cache-empty" cache ls >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_emitted_output F2
+assert_table_header F2 1
+
+
