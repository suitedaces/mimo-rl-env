@@ -0,0 +1,90 @@
+import subprocess
+import tempfile
+import sys
+import unittest
+from pathlib import Path
+import runpy
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import version_utils
+
+
+class VersionUtilsContractTests(unittest.TestCase):
+    def make_repo(self):
+        root = Path(tempfile.mkdtemp(prefix="version-utils-repo-"))
+        subprocess.run(["git", "init", "-q", str(root)], check=True)
+        subprocess.run(["git", "-C", str(root), "config", "user.email", "tests@example.invalid"], check=True)
+        subprocess.run(["git", "-C", str(root), "config", "user.name", "Version Tests"], check=True)
+        (root / "marker.txt").write_text("contract\n")
+        subprocess.run(["git", "-C", str(root), "add", "marker.txt"], check=True)
+        subprocess.run(["git", "-C", str(root), "commit", "-qm", "contract commit"], check=True)
+        subprocess.run(["git", "-C", str(root), "tag", "v1.8.0"], check=True)
+        (root / "marker.txt").write_text("contract\nsecond\n")
+        subprocess.run(["git", "-C", str(root), "add", "marker.txt"], check=True)
+        subprocess.run(["git", "-C", str(root), "commit", "-qm", "second contract commit"], check=True)
+        return root
+
+    def test_git_version_reads_the_requested_repository(self):
+        root = self.make_repo()
+        revision, count = version_utils.git_version(str(root))
+        expected_revision = subprocess.check_output(
+            ["git", "-C", str(root), "rev-parse", "HEAD"], text=True
+        ).strip()[:7]
+        self.assertEqual(revision, expected_revision)
+        self.assertEqual(count, "1")
+
+    def test_git_version_reports_unknown_for_non_repository(self):
+        root = Path(tempfile.mkdtemp(prefix="version-utils-empty-"))
+        self.assertEqual(version_utils.git_version(str(root)), ("Unknown", "Unknown"))
+
+    def test_source_distribution_fallback_is_relative_to_source_root(self):
+        root = Path(tempfile.mkdtemp(prefix="version-utils-sdist-"))
+        package = root / "scipy"
+        package.mkdir()
+        (package / "version.py").write_text(
+            "short_version = '9.8.7'\n"
+            "version = '9.8.7.dev4'\n"
+            "full_version = '9.8.7.dev4+sdist'\n"
+            "git_revision = 'sdistrev'\n"
+            "commit_count = '42'\n"
+        )
+        self.assertEqual(
+            version_utils.get_version_info(str(root)),
+            ("9.8.7.dev4+sdist", "sdistrev", "42"),
+        )
+
+    def test_write_version_py_makes_parent_and_is_importable(self):
+        root = self.make_repo()
+        output = root / "generated" / "scipy" / "version.py"
+        version_utils.write_version_py(str(root), str(output))
+        self.assertTrue(output.is_file())
+        generated = runpy.run_path(str(output))
+        revision = subprocess.check_output(
+            ["git", "-C", str(root), "rev-parse", "HEAD"], text=True
+        ).strip()[:7]
+        self.assertEqual(generated["short_version"], version_utils.VERSION)
+        self.assertEqual(generated["full_version"],
+                         version_utils.VERSION + ".dev0+1." + revision)
+        self.assertEqual(generated["version"], generated["full_version"])
+        self.assertEqual(generated["git_revision"], revision)
+        self.assertEqual(generated["commit_count"], "1")
+        self.assertFalse(generated["release"])
+
+    def test_cli_accepts_source_root_and_filename(self):
+        root = self.make_repo()
+        output = root / "cli-out" / "version.py"
+        script = Path(__file__).resolve().parents[1] / "version_utils.py"
+        result = subprocess.run(
+            [sys.executable, str(script), "--source-root", str(root),
+             "--filename", str(output)],
+            cwd=str(Path(tempfile.gettempdir())),
+            capture_output=True, text=True,
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertTrue(output.is_file())
+        generated = runpy.run_path(str(output))
+        self.assertEqual(generated["commit_count"], "1")
+
+
+if __name__ == "__main__":
+    unittest.main()
