+import parseLinkHeader from 'sentry/utils/parseLinkHeader';
+
+describe('parseLinkHeader robust pagination parsing', () => {
+  it('keeps commas inside link targets and quoted parameter values', () => {
+    const parsed = parseLinkHeader(
+      '<https://sentry.example/api/items?labels=frontend,backend&cursor=a,b>; rel="next"; results="true"; cursor="page,2", ' +
+        '<https://sentry.example/api/items?cursor=previous>; rel="previous"; results="false"; cursor="page,0"'
+    );
+
+    expect(parsed).toEqual({
+      next: {
+        href: 'https://sentry.example/api/items?labels=frontend,backend&cursor=a,b',
+        results: true,
+        cursor: 'page,2',
+      },
+      previous: {
+        href: 'https://sentry.example/api/items?cursor=previous',
+        results: false,
+        cursor: 'page,0',
+      },
+    });
+  });
+
+  it('accepts parameters in any order with OWS, case-insensitive names, and token values', () => {
+    const parsed = parseLinkHeader(
+      '<https://sentry.example/api/items?page=1> ; CURSOR = first ; RESULTS = FALSE ; REL = previous, ' +
+        '<https://sentry.example/api/items?page=3>;results=TrUe;rel=next;cursor=third'
+    );
+
+    expect(parsed).toEqual({
+      previous: {
+        href: 'https://sentry.example/api/items?page=1',
+        results: false,
+        cursor: 'first',
+      },
+      next: {
+        href: 'https://sentry.example/api/items?page=3',
+        results: true,
+        cursor: 'third',
+      },
+    });
+  });
+
+  it('unescapes quoted-pairs and expands a relation list', () => {
+    const parsed = parseLinkHeader(
+      '<https://sentry.example/api/items>; cursor="page\\\\2"; rel="next alternate"; results="true"'
+    );
+
+    const expected = {
+      href: 'https://sentry.example/api/items',
+      results: true,
+      cursor: 'page\\2',
+    };
+    expect(parsed.next).toEqual(expected);
+    expect(parsed.alternate).toEqual(expected);
+  });
+
+  it('normalizes results while preserving href and optional cursor semantics', () => {
+    const parsed = parseLinkHeader(
+      '<../events?scope=all>; rel="next"; results="unknown", ' +
+        '<https://sentry.example/api/items>; rel="previous"; cursor=opaque%3Avalue'
+    );
+
+    expect(parsed.next).toEqual({
+      href: '../events?scope=all',
+      results: null,
+      cursor: undefined,
+    });
+    expect(parsed.previous).toEqual({
+      href: 'https://sentry.example/api/items',
+      results: null,
+      cursor: 'opaque%3Avalue',
+    });
+  });
+
+  it('isolates unusable entries and lets the later usable relation win', () => {
+    const parsed = parseLinkHeader(
+      'not a link, ' +
+        '<https://sentry.example/no-relation>; cursor=ignored, ' +
+        '<https://sentry.example/old>; rel=next; cursor=old; results=false, ' +
+        '<https://sentry.example/new>; rel="next"; cursor="new"; results="true", ' +
+        '<https://sentry.example/previous>; rel="previous"; cursor="prev"'
+    );
+
+    expect(parsed).toEqual({
+      next: {
+        href: 'https://sentry.example/new',
+        results: true,
+        cursor: 'new',
+      },
+      previous: {
+        href: 'https://sentry.example/previous',
+        results: null,
+        cursor: 'prev',
+      },
+    });
+    expect(parseLinkHeader(null)).toEqual({});
+    expect(parseLinkHeader('')).toEqual({});
+    expect(parseLinkHeader('not a link')).toEqual({});
+  });
+
+  it('returns reserved JavaScript property names as ordinary own relation keys', () => {
+    const parsed = parseLinkHeader(
+      '<https://sentry.example/prototype>; rel="__proto__"; cursor="safe"; results="true", ' +
+        '<https://sentry.example/constructor>; rel="constructor"; cursor="also-safe"; results="false"'
+    );
+
+    expect(Object.prototype.hasOwnProperty.call(parsed, '__proto__')).toBe(true);
+    expect(Reflect.get(parsed, '__proto__')).toEqual({
+      href: 'https://sentry.example/prototype',
+      results: true,
+      cursor: 'safe',
+    });
+    expect(Object.prototype.hasOwnProperty.call(parsed, 'constructor')).toBe(true);
+    expect(parsed.constructor).toEqual({
+      href: 'https://sentry.example/constructor',
+      results: false,
+      cursor: 'also-safe',
+    });
+  });
+});
