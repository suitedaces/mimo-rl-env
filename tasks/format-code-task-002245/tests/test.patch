diff --git a/packages/react-core/src/components/Select/__tests__/Select.test.tsx b/packages/react-core/src/components/Select/__tests__/Select.test.tsx
index 34c86f858..4fda9f3d9 100644
--- a/packages/react-core/src/components/Select/__tests__/Select.test.tsx
+++ b/packages/react-core/src/components/Select/__tests__/Select.test.tsx
@@ -560,3 +560,86 @@ test('applies focus styling to the create option when reached via keyboard navig
 
   expect(createOption.parentElement).toHaveClass('pf-m-focus');
 });
+
+describe('isCreateOptionOnTop', () => {
+  test('places the create option at the bottom of the typeahead list by default', async () => {
+    const user = userEvent.setup();
+
+    render(
+      <Select variant={SelectVariant.typeahead} onToggle={() => {}} isOpen isCreatable>
+        {selectOptions}
+      </Select>
+    );
+
+    const input = screen.getByRole('textbox');
+    await user.type(input, 'M');
+
+    const options = screen.getAllByRole('option');
+    const optionTexts = options.map(o => o.textContent);
+    const createIndex = optionTexts.findIndex(t => t && t.includes('Create') && t.includes('"M"'));
+
+    expect(createIndex).toBe(options.length - 1);
+    expect(createIndex).toBeGreaterThan(0);
+  });
+
+  test('places the create option at the top of the typeahead list when isCreateOptionOnTop is true', async () => {
+    const user = userEvent.setup();
+
+    render(
+      <Select variant={SelectVariant.typeahead} onToggle={() => {}} isOpen isCreatable isCreateOptionOnTop>
+        {selectOptions}
+      </Select>
+    );
+
+    const input = screen.getByRole('textbox');
+    await user.type(input, 'M');
+
+    const options = screen.getAllByRole('option');
+    const optionTexts = options.map(o => o.textContent);
+    const createIndex = optionTexts.findIndex(t => t && t.includes('Create') && t.includes('"M"'));
+
+    expect(createIndex).toBe(0);
+    expect(options.length).toBeGreaterThan(1);
+  });
+
+  test('places the create option at the bottom of the typeahead list when isCreateOptionOnTop is false', async () => {
+    const user = userEvent.setup();
+
+    render(
+      <Select
+        variant={SelectVariant.typeahead}
+        onToggle={() => {}}
+        isOpen
+        isCreatable
+        isCreateOptionOnTop={false}
+      >
+        {selectOptions}
+      </Select>
+    );
+
+    const input = screen.getByRole('textbox');
+    await user.type(input, 'M');
+
+    const options = screen.getAllByRole('option');
+    const optionTexts = options.map(o => o.textContent);
+    const createIndex = optionTexts.findIndex(t => t && t.includes('Create') && t.includes('"M"'));
+
+    expect(createIndex).toBe(options.length - 1);
+    expect(createIndex).toBeGreaterThan(0);
+  });
+
+  test('still renders the create option text "Create [value]" when isCreateOptionOnTop is true', async () => {
+    const user = userEvent.setup();
+
+    render(
+      <Select variant={SelectVariant.typeahead} onToggle={() => {}} isOpen isCreatable isCreateOptionOnTop>
+        {selectOptions}
+      </Select>
+    );
+
+    const input = screen.getByRole('textbox');
+    await user.type(input, 'xyz');
+
+    expect(screen.getByRole('option', { name: 'Create "xyz"' })).toBeInTheDocument();
+  });
+});
