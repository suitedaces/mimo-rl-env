+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set +u
+source /testbed/.build_env/venv/bin/activate
+set -u
+pip install -e . --no-input -q 2>/dev/null
+
+
+case "${1:-}" in
+  base)
+    python -m pytest tests/basics/test_ops.py::TestOps::test_pm -v
+    ;;
+  new)
+    python -m pytest \
+      tests/basics/test_ops.py::TestOps::test_cumprod_left_and_right_match_manual_noncommutative_chain \
+      tests/basics/test_ops.py::TestOps::test_cummul_left_and_right_match_manual_noncommutative_chain \
+      tests/basics/test_ops.py::TestOps::test_cumops_matches_prefix_first_custom_accumulation \
+      tests/basics/test_ops.py::TestOps::test_cumops_inplace_matches_prefix_first_custom_accumulation \
+      tests/basics/test_ops.py::TestOps::test_inplace_top_level_accepts_left_and_mutates_with_matching_direction \
+      tests/lietensor/test_lietensor.py::test_inplace_lie_tensor_methods_accept_left_and_mutate_with_matching_direction \
+      tests/lietensor/test_lietensor.py::test_lie_tensor_cummul_and_cumprod_methods_accept_left_and_match_functional_api \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
