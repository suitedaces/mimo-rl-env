@@ -2,6 +2,26 @@ import torch
 import pypose as pp
 
 
+def _sample_so3_chain():
+    data = torch.tensor([
+        [0.10, -0.20, 0.30, 0.93],
+        [-0.15, 0.25, 0.35, 0.89],
+        [0.22, 0.18, -0.27, 0.92],
+        [-0.31, -0.12, 0.21, 0.91],
+    ], dtype=torch.float64)
+    data = data / data.norm(dim=-1, keepdim=True)
+    return pp.SO3(data)
+
+
+def _manual_chain(x, op, left):
+    out = [x[0]]
+    accum = x[0]
+    for i in range(1, x.shape[0]):
+        accum = op(x[i], accum) if left else op(accum, x[i])
+        out.append(accum)
+    return pp.SO3(torch.stack([item.tensor() for item in out]))
+
+
 class TestOps:
 
