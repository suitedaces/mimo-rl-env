+def _sample_so3_chain_for_cumtests():
+    data = torch.tensor([
+        [0.10, -0.20, 0.30, 0.93],
+        [-0.15, 0.25, 0.35, 0.89],
+        [0.22, 0.18, -0.27, 0.92],
+        [-0.31, -0.12, 0.21, 0.91],
+    ], dtype=torch.float64)
+    data = data / data.norm(dim=-1, keepdim=True)
+    return pp.SO3(data)
+
+
+def _manual_chain_for_cumtests(x, op, left):
+    out = [x[0]]
+    accum = x[0]
+    for i in range(1, x.shape[0]):
+        accum = op(x[i], accum) if left else op(accum, x[i])
+        out.append(accum)
+    return pp.SO3(torch.stack([item.tensor() for item in out]))
+
+
+def test_inplace_lie_tensor_methods_accept_left_and_mutate_with_matching_direction():
+    x = _sample_so3_chain_for_cumtests()
+    cumprod_left = x.clone()
+    expected = _manual_chain_for_cumtests(x, lambda a, b: a @ b, left=True)
+    pp.testing.assert_close(cumprod_left.cumprod_(dim=0, left=True), expected, rtol=1e-5, atol=1e-6)
+    pp.testing.assert_close(cumprod_left, expected, rtol=1e-5, atol=1e-6)
+
+    cumprod_right = x.clone()
+    expected = _manual_chain_for_cumtests(x, lambda a, b: a @ b, left=False)
+    pp.testing.assert_close(cumprod_right.cumprod_(dim=0, left=False), expected, rtol=1e-5, atol=1e-6)
+    pp.testing.assert_close(cumprod_right, expected, rtol=1e-5, atol=1e-6)
+
+    cummul_left = x.clone()
+    expected = _manual_chain_for_cumtests(x, lambda a, b: a * b, left=True)
+    pp.testing.assert_close(cummul_left.cummul_(dim=0, left=True), expected, rtol=1e-5, atol=1e-6)
+    pp.testing.assert_close(cummul_left, expected, rtol=1e-5, atol=1e-6)
+
+    cummul_right = x.clone()
+    expected = _manual_chain_for_cumtests(x, lambda a, b: a * b, left=False)
+    pp.testing.assert_close(cummul_right.cummul_(dim=0, left=False), expected, rtol=1e-5, atol=1e-6)
+    pp.testing.assert_close(cummul_right, expected, rtol=1e-5, atol=1e-6)
+
+
+def test_lie_tensor_cummul_and_cumprod_methods_accept_left_and_match_functional_api():
+    x = _sample_so3_chain_for_cumtests()
+    pp.testing.assert_close(x.cummul(dim=0, left=True), pp.cummul(x, dim=0, left=True), rtol=1e-5, atol=1e-6)
+    pp.testing.assert_close(x.cummul(dim=0, left=False), pp.cummul(x, dim=0, left=False), rtol=1e-5, atol=1e-6)
+
+    pp.testing.assert_close(x.cumprod(dim=0, left=True), pp.cumprod(x, dim=0, left=True), rtol=1e-5, atol=1e-6)
+    pp.testing.assert_close(x.cumprod(dim=0, left=False), pp.cumprod(x, dim=0, left=False), rtol=1e-5, atol=1e-6)
