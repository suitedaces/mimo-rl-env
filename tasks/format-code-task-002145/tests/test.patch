diff --git a/test/transformRequest.test.js b/test/transformRequest.test.js
new file mode 100644
index 0000000..abdb426
--- /dev/null
+++ b/test/transformRequest.test.js
@@ -0,0 +1,126 @@
+import Map from 'ol/Map.js';
+import olms from '../src/index.js';
+import should from 'should';
+
+const origin = window.location.protocol + '//' + window.location.host;
+
+describe('transformRequest option', function () {
+  let target;
+
+  beforeEach(function () {
+    target = document.createElement('div');
+  });
+
+  it('calls transformRequest for the style document with resource type "Style" and uses the original url when nothing is returned', function (done) {
+    const seen = [];
+    olms(target, './fixtures/hot-osm/hot-osm.json', {
+      transformRequest: function (url, resourceType) {
+        seen.push([url, resourceType]);
+        return undefined;
+      },
+    })
+      .then(function (map) {
+        should(map).be.instanceof(Map);
+        const styleCalls = seen.filter(function (call) {
+          return call[1] === 'Style';
+        });
+        should(styleCalls.length).be.greaterThan(0);
+        should(styleCalls[0][0].indexOf('hot-osm.json')).be.greaterThan(-1);
+        map.setTarget(undefined);
+        done();
+      })
+      .catch(done);
+  });
+
+  it('calls transformRequest for the sprite index with resource type "Sprite" and uses the returned Request for the fetch', function (done) {
+    const seen = [];
+    const style = {
+      version: 8,
+      sprite: origin + '/fixtures/does-not-exist-sprite',
+      sources: {
+        geojson: {
+          type: 'geojson',
+          data: {
+            type: 'FeatureCollection',
+            features: [
+              {
+                type: 'Feature',
+                properties: {},
+                geometry: {type: 'Point', coordinates: [0, 0]},
+              },
+            ],
+          },
+        },
+      },
+      layers: [
+        {
+          id: 'points',
+          type: 'circle',
+          source: 'geojson',
+          paint: {'circle-color': '#ff0000', 'circle-radius': 5},
+        },
+      ],
+    };
+    olms(target, style, {
+      transformRequest: function (url, resourceType) {
+        seen.push([url, resourceType]);
+        if (resourceType === 'Sprite') {
+          const suffix = url.indexOf('@2x') > -1 ? '@2x' : '';
+          return new Request(
+            origin + '/fixtures/osm-liberty/osm-liberty' + suffix + '.json'
+          );
+        }
+        return undefined;
+      },
+    })
+      .then(function (map) {
+        should(map).be.instanceof(Map);
+        const spriteCalls = seen.filter(function (call) {
+          return call[1] === 'Sprite';
+        });
+        should(spriteCalls.length).be.greaterThan(0);
+        should(spriteCalls[0][0].indexOf('does-not-exist-sprite')).be.greaterThan(
+          -1
+        );
+        map.setTarget(undefined);
+        done();
+      })
+      .catch(done);
+  });
+
+  it('normalizes mapbox:// style urls using accessToken and passes the normalized url to transformRequest', function (done) {
+    const seen = [];
+    olms(target, 'mapbox://styles/mapbox/bright-v9', {
+      accessToken: 'tok',
+      transformRequest: function (url, resourceType) {
+        seen.push([url, resourceType]);
+        if (resourceType === 'Style') {
+          return new Request(origin + '/fixtures/transform-request/style.json');
+        }
+        return undefined;
+      },
+    })
+      .then(function (map) {
+        should(map).be.instanceof(Map);
+        should(map.get('mapbox-style')).be.an.Object();
+        should(seen[0][1]).be.exactly('Style');
+        should(seen[0][0]).be.exactly(
+          'https://api.mapbox.com/styles/v1/mapbox/bright-v9?access_token=tok'
+        );
+        map.setTarget(undefined);
+        done();
+      })
+      .catch(done);
+  });
+
+  it('works without an options argument', function (done) {
+    olms(target, './fixtures/transform-request/style.json')
+      .then(function (map) {
+        should(map).be.instanceof(Map);
+        should(map.get('mapbox-style')).be.an.Object();
+        map.setTarget(undefined);
+        done();
+      })
+      .catch(done);
+  });
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+cat > /testbed/karma.task.cjs <<'EOF'
+const base = require('./test/karma.conf.cjs');
+module.exports = function (karma) {
+  base(karma);
+  const files = (process.env.TASK_TEST_FILES || '').split(',').filter(Boolean);
+  karma.set({
+    basePath: 'test',
+    browsers: ['ChromeHeadlessNoSandbox'],
+    customLaunchers: {
+      ChromeHeadlessNoSandbox: {base: 'ChromeHeadless', flags: ['--no-sandbox']},
+    },
+    reporters: ['dots'],
+    files: [
+      ...files.map((f) => ({pattern: f, watched: false})),
+      {pattern: 'fixtures/**/*', included: false, watched: false},
+    ],
+    preprocessors: {'**/*.js': ['webpack', 'sourcemap']},
+  });
+};
+EOF
+trap 'rm -f /testbed/karma.task.cjs' EXIT
+
+run_karma() {
+  TASK_TEST_FILES="$1" ./node_modules/.bin/karma start /testbed/karma.task.cjs \
+    --single-run --log-level error
+}
+
+
+run_karma "applyStyle.test.js,finalizeLayer.test.js,index.test.js"
+
+
+run_karma "transformRequest.test.js"
