diff --git a/tests/core/test_datamodules.py b/tests/core/test_datamodules.py
index c8808ec37..801f69751 100644
--- a/tests/core/test_datamodules.py
+++ b/tests/core/test_datamodules.py
@@ -497,3 +497,70 @@ def test_dm_init_from_datasets(tmpdir):
     assert torch.all(next(iter(dm.val_dataloader()[1])) == torch.ones(4))
     assert torch.all(next(iter(dm.test_dataloader()[0])) == torch.ones(4))
     assert torch.all(next(iter(dm.test_dataloader()[1])) == torch.ones(4))
+
+
+class DummyIDS(torch.utils.data.IterableDataset):
+
+    def __iter__(self):
+        yield 1
+        yield 1
+        yield 1
+        yield 1
+
+
+def test_dm_init_from_datasets_iterable_train_single(tmpdir):
+    """Passing a single IterableDataset as train_dataset should not raise."""
+    train_ds = DummyIDS()
+    dm = LightningDataModule.from_datasets(train_ds, batch_size=4, num_workers=0)
+
+
+    batch = next(iter(dm.train_dataloader()))
+    assert torch.all(batch == torch.ones(4))
+
+
+def test_dm_init_from_datasets_iterable_train_sequence(tmpdir):
+    """Passing a Sequence of IterableDatasets as train_dataset should not raise."""
+    train_dss = [DummyIDS(), DummyIDS()]
+    dm = LightningDataModule.from_datasets(train_dss, batch_size=4, num_workers=0)
+    dls = dm.train_dataloader()
+    assert isinstance(dls, list) and len(dls) == 2
+    for dl in dls:
+        assert torch.all(next(iter(dl)) == torch.ones(4))
+
+
+def test_dm_init_from_datasets_iterable_train_mapping(tmpdir):
+    """Passing a Mapping of IterableDatasets as train_dataset should not raise."""
+    train_dss = {"a": DummyIDS(), "b": DummyIDS()}
+    dm = LightningDataModule.from_datasets(train_dss, batch_size=4, num_workers=0)
+    dls = dm.train_dataloader()
+    assert isinstance(dls, dict) and set(dls.keys()) == {"a", "b"}
+    for dl in dls.values():
+        assert torch.all(next(iter(dl)) == torch.ones(4))
+
+
+def test_dm_init_from_datasets_iterable_val_test(tmpdir):
+    """Passing IterableDatasets as val_dataset and test_dataset should not raise."""
+    train_ds = DummyIDS()
+    val_ds = DummyIDS()
+    test_ds = DummyIDS()
+    dm = LightningDataModule.from_datasets(train_ds, val_ds, test_ds, batch_size=4, num_workers=0)
+    assert torch.all(next(iter(dm.val_dataloader())) == torch.ones(4))
+    assert torch.all(next(iter(dm.test_dataloader())) == torch.ones(4))
+
+
+def test_dm_init_from_datasets_map_dataset_still_shuffled(tmpdir):
+    """Preservation: regular Datasets passed as train_dataset still get a shuffling sampler."""
+    from torch.utils.data.sampler import RandomSampler
+    train_ds = DummyDS()
+    dm = LightningDataModule.from_datasets(train_ds, batch_size=4, num_workers=0)
+    dl = dm.train_dataloader()
+    assert isinstance(dl.sampler, RandomSampler)
+
+
+def test_dm_init_from_datasets_iterable_train_no_random_sampler(tmpdir):
+    """Iterable train datasets must not be wrapped with a shuffling sampler."""
+    from torch.utils.data.sampler import RandomSampler
+    train_ds = DummyIDS()
+    dm = LightningDataModule.from_datasets(train_ds, batch_size=4, num_workers=0)
+    dl = dm.train_dataloader()
+    assert not isinstance(dl.sampler, RandomSampler)
