index 0000000000..a5264e1285
--- /dev/null
+++ b/python_modules/dagster/dagster_tests/declarative_automation_tests/automation_condition_tests/fundamentals/test_recursive_replace_wrappers.py
@@ -0,0 +1,57 @@
+from dagster import AutomationCondition
+
+
+def test_replace_recurses_through_since_and_preserves_outer_label() -> None:
+    original_reset = AutomationCondition.newly_requested()
+    condition = AutomationCondition.missing().with_label("trigger").since(original_reset).with_label(
+        "tracked"
+    )
+    replacement = AutomationCondition.code_version_changed()
+
+    updated = condition.replace("trigger", replacement)
+    snapshot = updated.get_snapshot()
+
+    assert snapshot.node_snapshot.label == "tracked"
+    assert snapshot.children[0].node_snapshot.name == replacement.name
+    assert snapshot.children[0].node_snapshot.label is None
+    assert snapshot.children[1].node_snapshot.name == original_reset.name
+    assert condition.get_snapshot().children[0].node_snapshot.name == "missing"
+
+
+def test_replace_recurses_through_newly_true_by_condition_object() -> None:
+    original = AutomationCondition.missing()
+    replacement = AutomationCondition.newly_updated()
+    condition = original.newly_true()
+
+    updated = condition.replace(original, replacement)
+
+    assert updated.get_snapshot().children[0].node_snapshot.name == replacement.name
+
+
+def test_replace_recurses_through_any_checks_and_keeps_configuration() -> None:
+    original = AutomationCondition.missing().with_label("check_state")
+    replacement = AutomationCondition.check_passed()
+    condition = AutomationCondition.any_checks_match(original, blocking_only=True).with_label(
+        "blocking checks"
+    )
+
+    updated = condition.replace("check_state", replacement)
+    snapshot = updated.get_snapshot()
+
+    assert snapshot.node_snapshot.label == "blocking checks"
+    assert snapshot.node_snapshot.name == "ANY_CHECKS_MATCH(blocking_only=True)"
+    assert snapshot.children[0].node_snapshot.name == replacement.name
+    assert snapshot.children[0].node_snapshot.label is None
+
+
+def test_replace_recurses_through_all_checks_and_keeps_configuration() -> None:
+    original = AutomationCondition.missing()
+    replacement = AutomationCondition.check_failed()
+    condition = AutomationCondition.all_checks_match(original).with_label("all checks")
+
+    updated = condition.replace(original, replacement)
+    snapshot = updated.get_snapshot()
+
+    assert snapshot.node_snapshot.label == "all checks"
+    assert snapshot.node_snapshot.name == "ALL_CHECKS_MATCH"
+    assert snapshot.children[0].node_snapshot.name == replacement.name
