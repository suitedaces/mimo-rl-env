 func TestUniqueValidationStructSlice(t *testing.T) {
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,16 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 . -run '^(TestUniqueValidationStructSlice|TestUniqueValidationStructPtrSlice)$'
+    ;;
+  new)
+    go test -v -count=1 . -run '^TestUniqueValidation$/struct'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
