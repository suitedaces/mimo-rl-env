diff --git a/pandas/tests/io/formats/test_style.py b/pandas/tests/io/formats/test_style.py
index a154e51f68..447d2f9aa6 100644
--- a/pandas/tests/io/formats/test_style.py
+++ b/pandas/tests/io/formats/test_style.py
@@ -305,6 +305,59 @@ class TestStyler:
         df = DataFrame({0: [1, 2, 3]})
         df.style._translate()
 
+    def test_index_name_row_has_col_classes(self):
+
+        df = DataFrame(0, index=["a"], columns=["A", "B"])
+        df.index.name = "foo"
+        result = df.style._translate()
+
+        index_name_row = result["head"][1]
+
+        assert index_name_row[0]["class"] == "index_name level0"
+        assert index_name_row[0]["value"] == "foo"
+        assert index_name_row[1]["class"] == "blank col0"
+        assert index_name_row[2]["class"] == "blank col1"
+
+    def test_index_name_row_three_columns_col_classes(self):
+
+        df = DataFrame({"A": [1, 2], "B": [3, 4], "C": [5, 6]})
+        result = df.set_index("A").style._translate()
+        index_name_row = result["head"][1]
+
+        assert index_name_row[0]["class"] == "index_name level0"
+        assert index_name_row[1]["class"] == "blank col0"
+        assert index_name_row[2]["class"] == "blank col1"
+
+    def test_multiindex_name_row_has_col_classes(self):
+
+        df = DataFrame({"A": [1, 2], "B": [3, 4], "C": [5, 6]})
+        result = df.set_index(["A", "B"]).style._translate()
+        index_name_row = result["head"][1]
+
+        assert index_name_row[0]["class"] == "index_name level0"
+        assert index_name_row[1]["class"] == "index_name level1"
+        assert index_name_row[2]["class"] == "blank col0"
+
+    def test_index_name_row_with_hidden_column(self):
+
+
+        df = DataFrame({"A": [1, 2], "B": [3, 4], "C": [5, 6]}).set_index("A")
+        result = df.style.hide_columns(["B"])._translate()
+        index_name_row = result["head"][1]
+
+        assert len(index_name_row) == 2
+        assert index_name_row[0]["class"] == "index_name level0"
+        assert index_name_row[1]["class"] == "blank col1"
+
+    def test_index_name_row_with_hidden_last_column(self):
+
+        df = DataFrame({"A": [1, 2], "B": [3, 4], "C": [5, 6]}).set_index("A")
+        result = df.style.hide_columns(["C"])._translate()
+        index_name_row = result["head"][1]
+        assert len(index_name_row) == 2
+        assert index_name_row[0]["class"] == "index_name level0"
+        assert index_name_row[1]["class"] == "blank col0"
+
