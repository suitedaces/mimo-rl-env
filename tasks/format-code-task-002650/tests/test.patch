@@ -0,0 +1,122 @@
+import axios from 'axios';
+import { HDF5Collection, HDF5LinkClass, HDF5TypeClass } from '../hdf5-models';
+import { EntityKind } from '../models';
+import { HsdsApi } from './api';
+
+jest.mock('axios');
+
+const mockClient = {
+  get: jest.fn(),
+};
+
+describe('HsdsApi unknown datatypes', () => {
+  beforeEach(() => {
+    (axios.create as jest.Mock).mockReturnValue(mockClient as never);
+    mockClient.get.mockReset();
+  });
+
+  it('getEntity returns an inspectable dataset for an unsupported type', async () => {
+    const rawType = {
+      class: 'VENDOR_DATASET_TYPE',
+      vendor: 'acme',
+    };
+
+    mockClient.get
+      .mockResolvedValueOnce({ data: { root: 'root-id' } })
+      .mockResolvedValueOnce({
+        data: { id: 'root-id', linkCount: 1, attributeCount: 0 },
+      })
+      .mockResolvedValueOnce({
+        data: {
+          links: [
+            {
+              class: HDF5LinkClass.Hard,
+              title: 'custom',
+              collection: HDF5Collection.Datasets,
+              id: 'dataset-id',
+            },
+          ],
+        },
+      })
+      .mockResolvedValueOnce({
+        data: {
+          id: 'dataset-id',
+          type: rawType,
+          shape: { class: 'H5S_SIMPLE', dims: [3] },
+          attributeCount: 0,
+        },
+      });
+
+    const api = new HsdsApi(
+      'http://example.test',
+      'user',
+      'password',
+      '/example-domain'
+    );
+    const entity = await api.getEntity('/custom');
+
+    expect(entity.kind).toBe(EntityKind.Dataset);
+    if (entity.kind !== EntityKind.Dataset) {
+      throw new Error('Expected dataset entity');
+    }
+    expect(entity.type).toEqual({
+      class: HDF5TypeClass.Unknown,
+    });
+    expect(entity.rawType).toEqual(rawType);
+  });
+
+  it('getEntity returns an inspectable committed datatype for an unsupported type', async () => {
+    const rawType = {
+      class: 'VENDOR_DATATYPE_TYPE',
+      tag: 'opaque-v2',
+    };
+
+    mockClient.get
+      .mockResolvedValueOnce({ data: { root: 'root-id' } })
+      .mockResolvedValueOnce({
+        data: { id: 'root-id', linkCount: 1, attributeCount: 0 },
+      })
+      .mockResolvedValueOnce({
+        data: {
+          links: [
+            {
+              class: HDF5LinkClass.Hard,
+              title: 'custom',
+              collection: HDF5Collection.Datatypes,
+              id: 'datatype-id',
+            },
+          ],
+        },
+      })
+      .mockResolvedValueOnce({
+        data: {
+          id: 'datatype-id',
+          type: rawType,
+        },
+      });
+
+    const api = new HsdsApi(
+      'http://example.test',
+      'user',
+      'password',
+      '/example-domain'
+    );
+    const root = await api.getEntity('/');
+
+    expect(root.kind).toBe(EntityKind.Group);
+    if (root.kind !== EntityKind.Group) {
+      throw new Error('Expected group entity');
+    }
+
+    const entity = root.children[0];
+
+    expect(entity.kind).toBe(EntityKind.Datatype);
+    if (entity.kind !== EntityKind.Datatype) {
+      throw new Error('Expected datatype entity');
+    }
+    expect(entity.type).toEqual({
+      class: HDF5TypeClass.Unknown,
+    });
+    expect(entity.rawType).toEqual(rawType);
+  });
+});
