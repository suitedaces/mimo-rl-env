@@ -0,0 +1,46 @@
+import axios from 'axios';
+import { EntityKind } from '../models';
+import { HDF5TypeClass } from '../hdf5-models';
+import { JupyterApi } from './api';
+
+jest.mock('axios');
+
+const mockClient = {
+  get: jest.fn(),
+};
+
+describe('JupyterApi unknown datatypes', () => {
+  beforeEach(() => {
+    (axios.create as jest.Mock).mockReturnValue(mockClient as never);
+    mockClient.get.mockReset();
+  });
+
+  it('getEntity returns an inspectable dataset for an unsupported dtype', async () => {
+    const rawDtype = '|vendorOpaque';
+
+    mockClient.get
+      .mockResolvedValueOnce({
+        data: {
+          id: 'dataset-id',
+          name: 'custom',
+          type: EntityKind.Dataset,
+          shape: [2],
+          dtype: rawDtype,
+          attributes: [],
+        },
+      })
+      .mockResolvedValueOnce({ data: {} });
+
+    const api = new JupyterApi('http://example.test', '/files/example.h5');
+    const entity = await api.getEntity('/custom');
+
+    expect(entity.kind).toBe(EntityKind.Dataset);
+    if (entity.kind !== EntityKind.Dataset) {
+      throw new Error('Expected dataset entity');
+    }
+    expect(entity.type).toEqual({
+      class: HDF5TypeClass.Unknown,
+    });
+    expect(entity.rawType).toBe(rawDtype);
+  });
+});
