diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+export CI=true
+export BROWSER=none
+
+if [ ! -x ./node_modules/.bin/react-scripts ]; then
+  npm ci
+fi
+
+case "${1:-}" in
+  base)
+    ./node_modules/.bin/react-scripts test --watchAll=false --testPathPattern="metadata-viewer/utils\.test\.ts$"
+    ;;
+  new)
+    ./node_modules/.bin/react-scripts test --watchAll=false --testPathPattern="(providers/(hsds|jupyter)/(utils|api\.unknown-types)|metadata-viewer/utils)\.test\.ts$" --testNamePattern="unknown dtype as an unknown HDF5 type|unknown type objects as unknown HDF5 types|getEntity returns an inspectable dataset for an unsupported dtype|getEntity returns an inspectable dataset for an unsupported type|getEntity returns an inspectable committed datatype for an unsupported type|renders unknown structured HDF5 type as unknown"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
