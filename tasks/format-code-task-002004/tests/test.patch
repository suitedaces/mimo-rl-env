+def test_tokenize_document_combines_title_url_extract_tokens_and_preserves_fields():
+
+
+
+
+    actual = tokenize_document(
+        "https://Example.com/docs/page_one.html",
+        "Rust Async Runtime",
+        "fast async runtime primitives",
+        0.75,
+    )
+
+    assert type(actual) is TokenizedDocument
+    assert actual.url == "https://Example.com/docs/page_one.html"
+    assert actual.title == "Rust Async Runtime"
+    assert actual.extract == "fast async runtime primitives"
+    assert actual.score == 0.75
+    assert set(actual.tokens) == {
+        "rust",
+        "async",
+        "runtime",
+        "rust async",
+        "async runtime",
+        "example",
+        "com",
+        "docs",
+        "page",
+        "one",
+        "html",
+        "example com",
+        "com docs",
+        "docs page",
+        "page one",
+        "one html",
+        "fast",
+        "primitives",
+        "fast async",
+        "runtime primitives",
