+def test_tokenize_document_is_referentially_transparent_for_same_inputs():
+    first = tokenize_document(
+        "https://Example.com/docs/page_one.html",
+        "Rust Async Runtime",
+        "fast async runtime primitives",
+        0.75,
+    )
+    second = tokenize_document(
+        "https://Example.com/docs/page_one.html",
+        "Rust Async Runtime",
+        "fast async runtime primitives",
+        0.75,
+    )
+
+    assert (first.url, first.title, first.extract, first.score, set(first.tokens)) == (
+        "https://Example.com/docs/page_one.html",
+        "Rust Async Runtime",
+        "fast async runtime primitives",
+        0.75,
+        {
+            "rust",
+            "async",
+            "runtime",
+            "rust async",
+            "async runtime",
+            "example",
+            "com",
+            "docs",
+            "page",
+            "one",
+            "html",
+            "example com",
+            "com docs",
+            "docs page",
+            "page one",
+            "one html",
+            "fast",
+            "primitives",
+            "fast async",
+            "runtime primitives",
+        },
+    )
+    assert (second.url, second.title, second.extract, second.score, set(second.tokens)) == (
+        "https://Example.com/docs/page_one.html",
+        "Rust Async Runtime",
+        "fast async runtime primitives",
