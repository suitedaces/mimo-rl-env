+def test_tokenize_document_has_no_hidden_state_across_fresh_process():
+    in_process = tokenize_document(
+        "https://Example.com/docs/page_one.html",
+        "Rust Async Runtime",
+        "fast async runtime primitives",
+        0.75,
+    )
+    script = """
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+from mwmbl.indexer.index import tokenize_document
+doc = tokenize_document(
+    "https://Example.com/docs/page_one.html",
+    "Rust Async Runtime",
+    "fast async runtime primitives",
+    0.75,
+)
+sys.stdout.write(json.dumps({
+    "url": doc.url,
+    "title": doc.title,
+    "extract": doc.extract,
+    "score": doc.score,
+    "tokens": sorted(set(doc.tokens)),
+}, ensure_ascii=False, sort_keys=True))
+"""
+
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+
+    expected = {
+        "url": "https://Example.com/docs/page_one.html",
+        "title": "Rust Async Runtime",
+        "extract": "fast async runtime primitives",
+        "score": 0.75,
+        "tokens": [
+            "async",
+            "async runtime",
+            "com",
+            "com docs",
+            "docs",
+            "docs page",
+            "example",
+            "example com",
+            "fast",
+            "fast async",
+            "html",
+            "one",
+            "one html",
+            "page",
+            "page one",
+            "primitives",
+            "runtime",
+            "runtime primitives",
+            "rust",
+            "rust async",
+        ],
+    }
+
+    assert {
+        "url": in_process.url,
+        "title": in_process.title,
+        "extract": in_process.extract,
+        "score": in_process.score,
+        "tokens": sorted(set(in_process.tokens)),
+    } == expected
+    assert json.loads(completed.stdout) == expected
+
+
+def test_token_selection_helpers_do_not_use_files_or_network(tmp_path, monkeypatch):
+    def blocked_socket(*args, **kwargs):
+        raise AssertionError("token-selection helpers must not open network sockets")
+
+    monkeypatch.setattr(socket, "socket", blocked_socket)
+    monkeypatch.chdir(tmp_path)
+    before = set(os.listdir(tmp_path))
+
+    assert prepare_url_for_tokenizing("https://Example.com/docs/page_one.html") == (
+        "Example com docs page one html"
+    )
+    assert get_index_tokens(["one", "two", "three", "four"]) == {
+        "one",
+        "two",
+        "three",
+        "four",
+        "one two",
+        "two three",
+        "three four",
+    }
+    doc = tokenize_document(
+        "https://Example.com/docs/page_one.html",
+        "Rust Async Runtime",
+        "fast async runtime primitives",
+        0.75,
+    )
+    assert set(doc.tokens) == {
+        "rust",
+        "async",
+        "runtime",
+        "rust async",
+        "async runtime",
+        "example",
+        "com",
+        "docs",
+        "page",
+        "one",
+        "html",
+        "example com",
+        "com docs",
+        "docs page",
+        "page one",
+        "one html",
+        "fast",
+        "primitives",
+        "fast async",
+        "runtime primitives",
+    }
+
+    after = set(os.listdir(tmp_path))
+    assert after == before
