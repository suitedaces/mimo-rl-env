+def test_get_index_tokens_short_list_includes_unigrams_and_available_bigrams():
+
+
+
+
+    tokens = ["one", "two", "three", "four"]
+    actual = get_index_tokens(tokens)
+
+    assert actual == {
+        "one",
+        "two",
+        "three",
+        "four",
+        "one two",
+        "two three",
+        "three four",
+    }
+
+
+def test_get_index_tokens_empty_list_returns_empty_set():
+
+
+
+
+    actual = get_index_tokens([])
+
+    assert actual == set()
