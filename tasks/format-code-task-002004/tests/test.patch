+def test_prepare_url_strips_https_and_replaces_separators():
+
+
+
+
+    actual = prepare_url_for_tokenizing("https://Example.com/docs/page_one.html")
+
+    assert actual == "Example com docs page one html"
+
+
+def test_prepare_url_strips_http_and_replaces_separators():
+
+
+
+
+    actual = prepare_url_for_tokenizing("http://example.com/a_b.c/d")
+
+    assert actual == "example com a b c d"
+
+
+def test_prepare_url_only_strips_leading_http_or_https():
+
+
+
+
+    actual = prepare_url_for_tokenizing("prefixhttps://Example.com/a_b.c/d")
+
+    assert actual == "prefixhttps:  Example com a b c d"
+
