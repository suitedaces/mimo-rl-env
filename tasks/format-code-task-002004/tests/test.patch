+def test_tokenize_document_uses_prepared_url_tokens_and_preserves_original_url():
+
+
+
+
+    actual = tokenize_document(
+        "https://example.com/encoded%20path/a_b",
+        "Mixed CASE Title",
+        "unicode café data",
+        1.25,
+    )
+
+    assert type(actual) is TokenizedDocument
+    assert actual.url == "https://example.com/encoded%20path/a_b"
+    assert actual.title == "Mixed CASE Title"
+    assert actual.extract == "unicode café data"
+    assert actual.score == 1.25
+    tokens = set(actual.tokens)
+
+    assert {
+        "mixed",
+        "case",
+        "title",
+        "mixed case",
+        "case title",
+        "example",
+        "com",
+        "a",
+        "b",
+        "example com",
+        "a b",
+        "unicode",
+        "café",
+        "data",
+        "unicode café",
+        "café data",
+    }.issubset(tokens)
