+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export npm_config_offline=true
+export npm_config_audit=false
+export npm_config_fund=false
+export npm_config_update_notifier=false
+
+test -x /workspace/repo/node_modules/.bin/qunit
+node -e "require.resolve('qunit'); require.resolve('jsdom'); require.resolve('jquery3')"
+
+exec /workspace/repo/node_modules/.bin/qunit --reporter tap /workspace/repo/usercase-test-coderl/mock_redirect_followthrough.test.js
