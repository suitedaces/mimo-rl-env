new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/mock_redirect_followthrough.test.js
@@ -0,0 +1,428 @@
+const QUnit = require('qunit')
+const { JSDOM } = require('jsdom')
+const jqueryFactory = require('jquery3')
+
+const dom = new JSDOM('<!doctype html><html><body></body></html>', {
+    url: 'http://localhost/'
+})
+const $ = jqueryFactory(dom.window)
+
+global.window = dom.window
+global.document = dom.window.document
+global.XMLHttpRequest = dom.window.XMLHttpRequest
+global.$ = $
+global.jQuery = $
+
+const attachModuleReady = import('../src/attach.mjs').then((attach) => {
+    if (!$.mockjax) {
+        attach.init()
+    }
+})
+
+function resetMockjaxState() {
+    $.mockjax.clearAll()
+    $.mockjax.clearRetainedAjaxCalls()
+    $.mockjax.resetSettings(true)
+    $.mockjaxSettings.logLevel = -1
+    $.mockjaxSettings.responseTime = 0
+    $.mockjaxSettings.retainAjaxCalls = -1
+    $.mockjaxSettings.throwUnmocked = false
+}
+
+function ajaxResult(options) {
+    return new Promise((resolve) => {
+        const result = {
+            successData: null,
+            successTextStatus: null,
+            successStatus: null,
+            successResponseText: null,
+            errorTextStatus: null,
+            errorThrown: null,
+            errorStatus: null,
+            errorResponseText: null,
+            completeTextStatus: null,
+            completeStatus: null,
+            completeResponseText: null
+        }
+
+        $.ajax({
+            ...options,
+            success(data, textStatus, xhr) {
+                result.successData = data
+                result.successTextStatus = textStatus
+                result.successStatus = xhr.status
+                result.successResponseText = xhr.responseText
+            },
+            error(xhr, textStatus, errorThrown) {
+                result.errorTextStatus = textStatus
+                result.errorThrown = String(errorThrown || '')
+                result.errorStatus = xhr.status
+                result.errorResponseText = xhr.responseText
+            },
+            complete(xhr, textStatus) {
+                result.completeTextStatus = textStatus
+                result.completeStatus = xhr.status
+                result.completeResponseText = xhr.responseText
+                setTimeout(() => resolve(result), 0)
+            }
+        })
+    })
+}
+
+function retainedCallByUrl(calls, url) {
+    return calls.find((call) => call.url === url)
+}
+
+QUnit.module('usercase redirect follow-through', (hooks) => {
+    hooks.before(async () => {
+        await attachModuleReady
+        $.mockjax.getLogger().disable()
+        resetMockjaxState()
+    })
+
+    hooks.afterEach(() => {
+        resetMockjaxState()
+    })
+
+    QUnit.test('global followRedirects setting exists and validates as boolean', (assert) => {
+
+
+        assert.strictEqual($.mockjaxSettings.followRedirects, true)
+
+        $.mockjaxSettings.followRedirects = 'yes'
+        let thrown = null
+        try {
+            $.mockjax.validateSettings()
+        } catch (error) {
+            thrown = error
+        }
+
+
+        assert.ok(thrown instanceof TypeError)
+        assert.ok(thrown && /followRedirects/.test(thrown.message))
+    })
+
+    QUnit.test('GET 301 with uppercase Location follows to mocked final response', async (assert) => {
+
+
+
+        assert.strictEqual(typeof $.mockjax, 'function')
+        assert.strictEqual(typeof $.ajax, 'function')
+        assert.strictEqual($.mockjaxSettings.followRedirects, true)
+
+        $.mockjax({
+            url: '/redirect-me',
+            method: 'GET',
+            status: 301,
+            responseHeaders: { Location: '/final' },
+            responseText: 'original redirect'
+        })
+        $.mockjax({
+            url: '/final',
+            method: 'GET',
+            status: 201,
+            responseText: 'redirected'
+        })
+
+        const result = await ajaxResult({ url: '/redirect-me', method: 'GET' })
+
+        assert.strictEqual(result.successData, 'redirected')
+        assert.strictEqual(result.successStatus, 201)
+        assert.strictEqual(result.successResponseText, 'redirected')
+        assert.strictEqual(result.completeStatus, 201)
+        assert.strictEqual(result.completeResponseText, 'redirected')
+
+        const mockedCalls = $.mockjax.mockedAjaxCalls()
+        const redirectCall = retainedCallByUrl(mockedCalls, '/redirect-me')
+        const finalCall = retainedCallByUrl(mockedCalls, '/final')
+
+        assert.strictEqual(mockedCalls.length, 2)
+        assert.strictEqual(redirectCall && redirectCall.method, 'GET')
+        assert.strictEqual(finalCall && finalCall.method, 'GET')
+        assert.strictEqual(finalCall && finalCall.headers.Referer, '/redirect-me')
+        assert.strictEqual($.mockjax.unmockedAjaxCalls().length, 0)
+    })
+
+    QUnit.test('GET 302 with lowercase location follows to mocked final response', async (assert) => {
+
+
+        $.mockjax({
+            url: '/old',
+            method: 'GET',
+            status: 302,
+            responseHeaders: { location: '/new' },
+            responseText: 'old body'
+        })
+        $.mockjax({
+            url: '/new',
+            method: 'GET',
+            status: 202,
+            responseText: 'new body'
+        })
+
+        const result = await ajaxResult({ url: '/old', method: 'GET' })
+
+        assert.strictEqual(result.successData, 'new body')
+        assert.strictEqual(result.successStatus, 202)
+        assert.strictEqual(result.completeStatus, 202)
+        assert.strictEqual(result.completeResponseText, 'new body')
+
+        const mockedCalls = $.mockjax.mockedAjaxCalls()
+        const oldCall = retainedCallByUrl(mockedCalls, '/old')
+        const newCall = retainedCallByUrl(mockedCalls, '/new')
+
+        assert.strictEqual(mockedCalls.length, 2)
+        assert.strictEqual(oldCall && oldCall.method, 'GET')
+        assert.strictEqual(newCall && newCall.method, 'GET')
+        assert.strictEqual(newCall && newCall.headers.Referer, '/old')
+        assert.strictEqual($.mockjax.unmockedAjaxCalls().length, 0)
+    })
+
+    QUnit.test('HEAD redirect follows and supplies Referer to the target mock', async (assert) => {
+
+
+        $.mockjax({
+            url: '/head-old',
+            method: 'HEAD',
+            status: 302,
+            responseHeaders: { location: '/head-new' },
+            responseText: 'head old body'
+        })
+        $.mockjax({
+            url: '/head-new',
+            method: 'HEAD',
+            requestHeaders: { Referer: '/head-old' },
+            status: 202,
+            responseText: 'head new body'
+        })
+
+        const result = await ajaxResult({ url: '/head-old', method: 'HEAD' })
+
+        assert.strictEqual(result.successStatus, 202)
+        assert.strictEqual(result.successResponseText, 'head new body')
+        assert.strictEqual(result.completeStatus, 202)
+        assert.strictEqual(result.completeResponseText, 'head new body')
+
+        const mockedCalls = $.mockjax.mockedAjaxCalls()
+        const headOldCall = retainedCallByUrl(mockedCalls, '/head-old')
+        const headNewCall = retainedCallByUrl(mockedCalls, '/head-new')
+
+        assert.strictEqual(mockedCalls.length, 2)
+        assert.strictEqual(headOldCall && headOldCall.method, 'HEAD')
+        assert.strictEqual(headNewCall && headNewCall.method, 'HEAD')
+        assert.strictEqual(headNewCall && headNewCall.headers.Referer, '/head-old')
+        assert.strictEqual($.mockjax.unmockedAjaxCalls().length, 0)
+    })
+
+    QUnit.test('unmocked redirect target falls through as the target URL', async (assert) => {
+
+
+        $.mockjax({
+            url: '/to-network',
+            method: 'GET',
+            status: 301,
+            responseHeaders: { Location: '/missing-target' },
+            responseText: 'go away'
+        })
+
+        const result = await ajaxResult({ url: '/to-network', method: 'GET' })
+
+
+        assert.notStrictEqual(result.completeStatus, 301)
+        assert.notStrictEqual(result.completeResponseText, 'go away')
+
+        const mockedCalls = $.mockjax.mockedAjaxCalls()
+        const toNetworkCall = retainedCallByUrl(mockedCalls, '/to-network')
+        assert.strictEqual(toNetworkCall && toNetworkCall.method, 'GET')
+
+        const unmockedCalls = $.mockjax.unmockedAjaxCalls()
+        assert.strictEqual(unmockedCalls.length, 1)
+        assert.strictEqual(unmockedCalls[0].url, '/missing-target')
+        assert.strictEqual(unmockedCalls[0].method, 'GET')
+        assert.strictEqual(unmockedCalls[0].headers.Referer, '/to-network')
+    })
+
+    QUnit.test('followRedirects false returns the original redirect response', async (assert) => {
+
+
+        $.mockjaxSettings.followRedirects = false
+        $.mockjax({
+            url: '/redirect-disabled',
+            method: 'GET',
+            status: 301,
+            responseHeaders: { Location: '/disabled-final' },
+            responseText: 'stay here'
+        })
+        $.mockjax({
+            url: '/disabled-final',
+            method: 'GET',
+            status: 299,
+            responseText: 'should not see'
+        })
+
+        const result = await ajaxResult({ url: '/redirect-disabled', method: 'GET' })
+
+
+        assert.strictEqual(result.completeStatus, 301)
+        assert.strictEqual(result.completeResponseText, 'stay here')
+
+        const mockedCalls = $.mockjax.mockedAjaxCalls()
+
+        assert.ok(retainedCallByUrl(mockedCalls, '/redirect-disabled'))
+        assert.strictEqual(retainedCallByUrl(mockedCalls, '/disabled-final'), undefined)
+        assert.strictEqual($.mockjax.unmockedAjaxCalls().length, 0)
+    })
+
+    QUnit.test('redirect status without Location header returns original response', async (assert) => {
+
+
+        $.mockjax({
+            url: '/redirect-no-location',
+            method: 'GET',
+            status: 302,
+            responseHeaders: { 'X-Other': '/not-used' },
+            responseText: 'no location body'
+        })
+        $.mockjax({
+            url: '/not-used',
+            method: 'GET',
+            status: 298,
+            responseText: 'unused'
+        })
+
+        const result = await ajaxResult({ url: '/redirect-no-location', method: 'GET' })
+
+
+        assert.strictEqual(result.completeStatus, 302)
+        assert.strictEqual(result.completeResponseText, 'no location body')
+
+        const mockedCalls = $.mockjax.mockedAjaxCalls()
+
+        assert.ok(retainedCallByUrl(mockedCalls, '/redirect-no-location'))
+        assert.strictEqual(retainedCallByUrl(mockedCalls, '/not-used'), undefined)
+        assert.strictEqual($.mockjax.unmockedAjaxCalls().length, 0)
+    })
+
+    QUnit.test('POST redirect response is not followed', async (assert) => {
+
+
+        $.mockjax({
+            url: '/redirect-post',
+            method: 'POST',
+            status: 301,
+            responseHeaders: { Location: '/post-final' },
+            responseText: 'post original'
+        })
+        $.mockjax({
+            url: '/post-final',
+            method: 'POST',
+            status: 297,
+            responseText: 'post final'
+        })
+
+        const result = await ajaxResult({ url: '/redirect-post', method: 'POST' })
+
+
+        assert.strictEqual(result.completeStatus, 301)
+        assert.strictEqual(result.completeResponseText, 'post original')
+
+        const mockedCalls = $.mockjax.mockedAjaxCalls()
+        const redirectPostCall = retainedCallByUrl(mockedCalls, '/redirect-post')
+
+        assert.strictEqual(redirectPostCall && redirectPostCall.method, 'POST')
+        assert.strictEqual(retainedCallByUrl(mockedCalls, '/post-final'), undefined)
+        assert.strictEqual($.mockjax.unmockedAjaxCalls().length, 0)
+    })
+
+    QUnit.test('registered redirect and direct handlers keep independent state', async (assert) => {
+
+
+        $.mockjax({
+            url: '/alpha-redirect',
+            method: 'GET',
+            status: 301,
+            responseHeaders: { Location: '/alpha-final' },
+            responseText: 'alpha original'
+        })
+        $.mockjax({
+            url: '/alpha-final',
+            method: 'GET',
+            status: 211,
+            responseText: 'alpha final'
+        })
+        $.mockjax({
+            url: '/beta-direct',
+            method: 'GET',
+            status: 212,
+            responseText: 'beta direct'
+        })
+
+        const alpha = await ajaxResult({ url: '/alpha-redirect', method: 'GET' })
+
+        assert.strictEqual(alpha.successData, 'alpha final')
+        assert.strictEqual(alpha.successStatus, 211)
+
+        const beta = await ajaxResult({ url: '/beta-direct', method: 'GET' })
+
+        assert.strictEqual(beta.successData, 'beta direct')
+        assert.strictEqual(beta.successStatus, 212)
+
+        assert.strictEqual(retainedCallByUrl($.mockjax.mockedAjaxCalls(), '/beta-direct').method, 'GET')
+    })
+
+    QUnit.test('GET 302 with uppercase Location follows to mocked final response', async (assert) => {
+
+        $.mockjax({
+            url: '/upper-302-old',
+            method: 'GET',
+            status: 302,
+            responseHeaders: { Location: '/upper-302-new' },
+            responseText: 'upper 302 original'
+        })
+        $.mockjax({
+            url: '/upper-302-new',
+            method: 'GET',
+            status: 203,
+            responseText: 'upper 302 final'
+        })
+
+        const result = await ajaxResult({ url: '/upper-302-old', method: 'GET' })
+
+        assert.strictEqual(result.successData, 'upper 302 final')
+        assert.strictEqual(result.successStatus, 203)
+        assert.strictEqual(result.completeStatus, 203)
+        assert.strictEqual(result.completeResponseText, 'upper 302 final')
+
+        const mockedCalls = $.mockjax.mockedAjaxCalls()
+        assert.strictEqual(mockedCalls.length, 2)
+        assert.strictEqual(retainedCallByUrl(mockedCalls, '/upper-302-new').headers.Referer, '/upper-302-old')
+    })
+
+    QUnit.test('GET 301 with lowercase location follows to mocked final response', async (assert) => {
+
+        $.mockjax({
+            url: '/lower-301-old',
+            method: 'GET',
+            status: 301,
+            responseHeaders: { location: '/lower-301-new' },
+            responseText: 'lower 301 original'
+        })
+        $.mockjax({
+            url: '/lower-301-new',
+            method: 'GET',
+            status: 201,
+            responseText: 'lower 301 final'
+        })
+
+        const result = await ajaxResult({ url: '/lower-301-old', method: 'GET' })
+
+        assert.strictEqual(result.successStatus, 201)
+        assert.strictEqual(result.successResponseText, 'lower 301 final')
+        assert.strictEqual(result.completeStatus, 201)
+        assert.strictEqual(result.completeResponseText, 'lower 301 final')
+
+        const mockedCalls = $.mockjax.mockedAjaxCalls()
+        assert.strictEqual(mockedCalls.length, 2)
+        assert.strictEqual(retainedCallByUrl(mockedCalls, '/lower-301-new').headers.Referer, '/lower-301-old')
+    })
+})
