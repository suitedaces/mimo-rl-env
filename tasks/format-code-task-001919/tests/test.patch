diff --git a/usercase-test-coderl/get-value.test.js b/usercase-test-coderl/get-value.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/get-value.test.js
@@ -0,0 +1,321 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const childProcess = require("node:child_process");
+const fs = require("node:fs");
+const http = require("node:http");
+const https = require("node:https");
+const net = require("node:net");
+const os = require("node:os");
+const path = require("node:path");
+const tls = require("node:tls");
+
+
+
+const createMapper = require("/workspace/repo/dist/lib/index.js");
+const { getValue } = createMapper;
+
+function clone(value) {
+  return JSON.parse(JSON.stringify(value));
+}
+
+function listTree(root) {
+  const entries = [];
+
+  function walk(current, relative) {
+    for (const dirent of fs.readdirSync(current, { withFileTypes: true })) {
+      const childRelative = relative ? `${relative}/${dirent.name}` : dirent.name;
+      const childPath = path.join(current, dirent.name);
+      entries.push(`${dirent.isDirectory() ? "dir" : "file"}:${childRelative}`);
+      if (dirent.isDirectory()) {
+        walk(childPath, childRelative);
+      }
+    }
+  }
+
+  walk(root, "");
+  return entries.sort();
+}
+
+test("reads a nested object property with dot syntax", () => {
+
+
+  const source = { foo: { bar: "baz" } };
+
+  const actual = getValue(source, "foo.bar");
+
+  assert.strictEqual(actual, "baz");
+});
+
+test("selects a root array item by bracket index", () => {
+
+
+  const source = ["foo", "bar"];
+
+  const actual = getValue(source, "[1]");
+
+  assert.strictEqual(actual, "bar");
+});
+
+test("preserves nested projection shape across two array traversals", () => {
+
+
+  const source = {
+    foo: [
+      {
+        baz: [
+          { fog: { baz: "bar" } },
+          { fog: { baz: "const" } }
+        ]
+      }
+    ]
+  };
+
+  const actual = getValue(source, "foo[].baz[].fog.baz");
+
+  assert.deepStrictEqual(actual, [["bar", "const"]]);
+});
+
+test("selects an indexed value from a property array", () => {
+
+
+  const source = { foo: { baz: ["bar", "foo"] } };
+
+  const actual = getValue(source, "foo.baz[1]");
+
+  assert.strictEqual(actual, "foo");
+});
+
+test("projects a property from every object in a property array", () => {
+
+
+  const source = { foo: { baz: [{ fog: "bar" }] } };
+
+  const actual = getValue(source, "foo.baz[].fog");
+
+  assert.deepStrictEqual(actual, ["bar"]);
+});
+
+test("returns undefined when a path cannot be resolved", () => {
+
+
+  const source = { foo: {} };
+
+  const actual = getValue(source, "fish[0].b");
+
+  assert.strictEqual(actual, undefined);
+});
+
+test("returns undefined when every projected value is undefined", () => {
+
+
+  const source = { foo: { baz: [{}, {}] } };
+
+  const actual = getValue(source, "foo.baz[].fog");
+
+  assert.strictEqual(actual, undefined);
+});
+
+test("returns undefined when every projected value is null", () => {
+
+
+  const source = { foo: { baz: [{ fog: null }, { fog: null }] } };
+
+  const actual = getValue(source, "foo.baz[].fog");
+
+  assert.strictEqual(actual, undefined);
+});
+
+test("keeps projection slots when at least one projected value is meaningful", () => {
+
+
+  const source = { foo: { baz: [{ fog: null }, { fog: "ok" }, {}] } };
+
+  const actual = getValue(source, "foo.baz[].fog");
+
+
+  assert.ok(Array.isArray(actual));
+  assert.strictEqual(actual.length, 3);
+  assert.ok(actual[0] === null || actual[0] === undefined);
+  assert.strictEqual(actual[1], "ok");
+  assert.ok(actual[2] === null || actual[2] === undefined);
+});
+
+test("mapper source paths use the same extraction behavior before writing the destination", () => {
+
+
+  const mapper = createMapper();
+  mapper
+    .map("foo.bar").to("read.dot")
+    .map("foo.baz[1]").to("read.second")
+    .map("foo.items[].fog").to("read.fogs");
+
+  const source = {
+    foo: {
+      bar: "baz",
+      baz: ["bar", "foo"],
+      items: [{ fog: "bar" }, { fog: "const" }]
+    }
+  };
+
+  const actual = mapper.execute(source);
+
+  assert.deepStrictEqual(actual, { read: { dot: "baz", second: "foo", fogs: ["bar", "const"] } });
+});
+
+test("raises TypeError for a non-string path", () => {
+  const source = { foo: "bar" };
+
+  assert.throws(() => getValue(source, 3), TypeError);
+});
+
+test("returns the same value for repeated calls with the same inputs", () => {
+  const source = {
+    foo: [
+      {
+        baz: [
+          { fog: { baz: "bar" } },
+          { fog: { baz: "const" } }
+        ]
+      }
+    ]
+  };
+
+  assert.deepStrictEqual(
+    getValue(source, "foo[].baz[].fog.baz"),
+    getValue(source, "foo[].baz[].fog.baz")
+  );
+});
+
+test("does not modify fromObject", () => {
+  const source = {
+    foo: [
+      {
+        baz: [
+          { fog: { baz: "bar" } },
+          { fog: { baz: "const" } }
+        ]
+      }
+    ],
+    untouched: { keep: ["alpha", "beta"] }
+  };
+  const before = clone(source);
+
+  const actual = getValue(source, "foo[].baz[].fog.baz");
+
+  assert.deepStrictEqual(actual, [["bar", "const"]]);
+  assert.deepStrictEqual(source, before);
+});
+
+test("matches a fresh-process result for the same input", () => {
+  const source = {
+    foo: [
+      {
+        baz: [
+          { fog: { baz: "bar" } },
+          { fog: { baz: "const" } }
+        ]
+      }
+    ]
+  };
+  const inProcess = getValue(source, "foo[].baz[].fog.baz");
+  const script = `
+    const createMapper = require("/workspace/repo/dist/lib/index.js");
+    const source = { foo: [{ baz: [{ fog: { baz: "bar" } }, { fog: { baz: "const" } }] }] };
+    process.stdout.write(JSON.stringify(createMapper.getValue(source, "foo[].baz[].fog.baz")));
+  `;
+
+  const freshProcess = JSON.parse(childProcess.execFileSync(process.execPath, ["-e", script], { encoding: "utf8" }));
+
+  assert.deepStrictEqual(freshProcess, inProcess);
+  assert.deepStrictEqual(freshProcess, [["bar", "const"]]);
+});
+
+test("does not perform undeclared filesystem, network, or global writes", () => {
+  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "map-factory-getvalue-"));
+  const originalCwd = process.cwd();
+  const globalKeysBefore = Object.keys(globalThis).sort();
+  const hadFetch = Object.prototype.hasOwnProperty.call(globalThis, "fetch");
+  const originalFetch = globalThis.fetch;
+  const originals = {
+    appendFile: fs.appendFile,
+    appendFileSync: fs.appendFileSync,
+    createWriteStream: fs.createWriteStream,
+    mkdir: fs.mkdir,
+    mkdirSync: fs.mkdirSync,
+    open: fs.open,
+    openSync: fs.openSync,
+    writeFile: fs.writeFile,
+    writeFileSync: fs.writeFileSync,
+    promisesWriteFile: fs.promises.writeFile,
+    httpGet: http.get,
+    httpRequest: http.request,
+    httpsGet: https.get,
+    httpsRequest: https.request,
+    netConnect: net.connect,
+    netSocketConnect: net.Socket.prototype.connect,
+    tlsConnect: tls.connect
+  };
+  const fail = () => {
+    throw new Error("getValue attempted undeclared IO");
+  };
+  const isWriteFlag = flags => {
+    if (typeof flags === "number") {
+      return Boolean(flags & (fs.constants.O_WRONLY | fs.constants.O_RDWR | fs.constants.O_APPEND | fs.constants.O_CREAT | fs.constants.O_TRUNC));
+    }
+    return typeof flags === "string" && /[wa+]/.test(flags);
+  };
+
+  try {
+    process.chdir(tmp);
+    const beforeTree = listTree(tmp);
+    fs.appendFile = fail;
+    fs.appendFileSync = fail;
+    fs.createWriteStream = fail;
+    fs.mkdir = fail;
+    fs.mkdirSync = fail;
+    fs.writeFile = fail;
+    fs.writeFileSync = fail;
+    fs.promises.writeFile = fail;
+    fs.open = (file, flags, ...rest) => isWriteFlag(flags) ? fail() : originals.open.call(fs, file, flags, ...rest);
+    fs.openSync = (file, flags, ...rest) => isWriteFlag(flags) ? fail() : originals.openSync.call(fs, file, flags, ...rest);
+    http.get = fail;
+    http.request = fail;
+    https.get = fail;
+    https.request = fail;
+    net.connect = fail;
+    net.Socket.prototype.connect = fail;
+    tls.connect = fail;
+    globalThis.fetch = fail;
+
+    const actual = getValue({ foo: { bar: "baz" } }, "foo.bar");
+
+    assert.strictEqual(actual, "baz");
+    assert.deepStrictEqual(listTree(tmp), beforeTree);
+    assert.deepStrictEqual(Object.keys(globalThis).sort(), globalKeysBefore);
+  } finally {
+    fs.appendFile = originals.appendFile;
+    fs.appendFileSync = originals.appendFileSync;
+    fs.createWriteStream = originals.createWriteStream;
+    fs.mkdir = originals.mkdir;
+    fs.mkdirSync = originals.mkdirSync;
+    fs.open = originals.open;
+    fs.openSync = originals.openSync;
+    fs.writeFile = originals.writeFile;
+    fs.writeFileSync = originals.writeFileSync;
+    fs.promises.writeFile = originals.promisesWriteFile;
+    http.get = originals.httpGet;
+    http.request = originals.httpRequest;
+    https.get = originals.httpsGet;
+    https.request = originals.httpsRequest;
+    net.connect = originals.netConnect;
+    net.Socket.prototype.connect = originals.netSocketConnect;
+    tls.connect = originals.tlsConnect;
+    if (hadFetch) {
+      globalThis.fetch = originalFetch;
+    } else {
+      delete globalThis.fetch;
+    }
+    process.chdir(originalCwd);
+    fs.rmSync(tmp, { recursive: true, force: true });
+  }
+});
