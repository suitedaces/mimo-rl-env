+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+export PATH="/workspace/repo/node_modules/.bin:${PATH}"
+test -x /workspace/repo/node_modules/.bin/rimraf
+test -x /workspace/repo/node_modules/.bin/babel
+/workspace/repo/node_modules/.bin/rimraf dist/*
+/workspace/repo/node_modules/.bin/babel ./src -d dist >/dev/null 2>&1
+cp ./src/lib/*.d.ts ./dist/lib/
+exec node --test /workspace/repo/usercase-test-coderl/get-value.test.js
