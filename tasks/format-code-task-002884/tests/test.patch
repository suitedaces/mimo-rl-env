@@ -0,0 +1,30 @@
+import os
+import sys
+
+
+_answers = None
+
+
+def _load_answers():
+    raw = os.environ.get("ONLYKEY_FAKE_PROMPTS", "")
+    return raw.splitlines()
+
+
+def prompt(message="", **kwargs):
+    global _answers
+    if _answers is None:
+        _answers = _load_answers()
+
+    if not _answers:
+        raise EOFError()
+
+    sys.stdout.write(str(message))
+    sys.stdout.flush()
+    answer = _answers.pop(0)
+    sys.stdout.write(answer + "\n")
+    sys.stdout.flush()
+    return answer
+
+
+class Application:
+    pass
