+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,236 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+export PYTHONDONTWRITEBYTECODE=1
+export PIP_NO_INDEX=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+FIXTURES=/workspace/repo/usercase-test-coderl/fixtures
+export PYTHONPATH="$FIXTURES:/workspace/repo${PYTHONPATH:+:$PYTHONPATH}"
+
+run_onlykey_cli() {
+
+
+
+    python "$FIXTURES/onlykey_cli_entrypoint.py" "$@"
+}
+
+assert_empty_file() {
+    local file=$1
+    [ ! -s "$file" ] || fail "$file should be empty; got: $(cat "$file")"
+}
+
+assert_file_eq() {
+    local actual=$1
+    local expected=$2
+    local label=$3
+    if ! cmp -s "$actual" "$expected"; then
+        echo "FAIL: $label" >&2
+        echo "--- expected" >&2
+        cat "$expected" >&2
+        echo "--- actual" >&2
+        cat "$actual" >&2
+        exit 1
+    fi
+}
+
+assert_wipe_log_eq() {
+    local actual=$1
+    local expected=$2
+    local label=$3
+    local filtered="$TMP/$(basename "$actual").filtered"
+
+    [ -e "$actual" ] || fail "$label missing"
+
+
+    awk '{print $1" "$2" "$3}' "$actual" >"$filtered"
+    assert_file_eq "$filtered" "$expected" "$label"
+}
+
+write_expected_wipe_stdout() {
+    local slot=$1
+    local file=$2
+    cat >"$file" <<EOF
+device response 1: wipe slot $slot via msg 231
+device response 2: wipe slot $slot via msg 231
+device response 3: wipe slot $slot via msg 231
+device response 4: wipe slot $slot via msg 231
+device response 5: wipe slot $slot via msg 231
+device response 6: wipe slot $slot via msg 231
+device response 7: wipe slot $slot via msg 231
+device response 8: wipe slot $slot via msg 231
+EOF
+}
+
+write_expected_wipe_log() {
+    local slot=$1
+    local file=$2
+    cat >"$file" <<EOF
+write msg=231 slot=$slot
+EOF
+}
+
+assert_interactive_stdout_behavior() {
+    local actual=$1
+    local filtered="$TMP/f11_interactive.behavior.out"
+    local expected="$TMP/f11_interactive.expected.behavior.out"
+
+
+
+
+    awk '/^device response [0-9]+: wipe slot .* via msg .*$/ || /^wipeslot \[id\]$/ || /^\[id\] must be a valid slot number$/ {print}' "$actual" >"$filtered"
+    cat >"$expected" <<'EOF'
+device response 1: wipe slot 1 via msg 231
+device response 2: wipe slot 1 via msg 231
+device response 3: wipe slot 1 via msg 231
+device response 4: wipe slot 1 via msg 231
+device response 5: wipe slot 1 via msg 231
+device response 6: wipe slot 1 via msg 231
+device response 7: wipe slot 1 via msg 231
+device response 8: wipe slot 1 via msg 231
+wipeslot [id]
+[id] must be a valid slot number
+wipeslot [id]
+[id] must be a valid slot number
+device response 1: wipe slot 24 via msg 231
+device response 2: wipe slot 24 via msg 231
+device response 3: wipe slot 24 via msg 231
+device response 4: wipe slot 24 via msg 231
+device response 5: wipe slot 24 via msg 231
+device response 6: wipe slot 24 via msg 231
+device response 7: wipe slot 24 via msg 231
+device response 8: wipe slot 24 via msg 231
+EOF
+    assert_file_eq "$filtered" "$expected" "F11 stdout behavior"
+}
+
+run_direct_success() {
+    local label=$1
+    local id=$2
+    local slot=$3
+    local out="$TMP/${label}.out"
+    local err="$TMP/${label}.err"
+    local log="$TMP/${label}.hid.log"
+    local expected_out="$TMP/${label}.expected.out"
+    local expected_log="$TMP/${label}.expected.log"
+
+    rm -f "$log"
+    ONLYKEY_FAKE_HID_LOG="$log" run_onlykey_cli wipeslot "$id" >"$out" 2>"$err"
+    local ec=$?
+
+    write_expected_wipe_stdout "$slot" "$expected_out"
+    write_expected_wipe_log "$slot" "$expected_log"
+
+    [ "$ec" -eq 0 ] || fail "$label exit $ec; want 0"
+    assert_file_eq "$out" "$expected_out" "$label stdout"
+    assert_empty_file "$err"
+    assert_wipe_log_eq "$log" "$expected_log" "$label HID write"
+}
+
+write_expected_validation_stdout() {
+    local file=$1
+    cat >"$file" <<'EOF'
+wipeslot [id]
+[id] must be a valid slot number
+EOF
+}
+
+run_direct_validation() {
+    local label=$1
+    shift
+    local out="$TMP/${label}.out"
+    local err="$TMP/${label}.err"
+    local log="$TMP/${label}.hid.log"
+    local expected_out="$TMP/${label}.expected.out"
+
+    rm -f "$log"
+    ONLYKEY_FAKE_HID_LOG="$log" run_onlykey_cli wipeslot "$@" >"$out" 2>"$err"
+    local ec=$?
+
+    write_expected_validation_stdout "$expected_out"
+    [ "$ec" -eq 0 ] || fail "$label exit $ec; want 0"
+    assert_file_eq "$out" "$expected_out" "$label stdout"
+    assert_empty_file "$err"
+    [ ! -e "$log" ] || assert_empty_file "$log"
+}
+
+
+
+
+run_direct_success "f1_direct_1a" "1a" "1"
+
+
+
+
+run_direct_success "f2_direct_6a" "6a" "6"
+
+
+
+
+run_direct_success "f3_direct_1b" "1b" "7"
+
+
+
+
+run_direct_success "f4_direct_6b" "6b" "12"
+
+
+
+
+run_direct_success "f5_direct_blue2b" "blue2b" "11"
+
+
+
+
+run_direct_success "f6_direct_yellow3a" "yellow3a" "15"
+
+
+
+
+run_direct_success "f7_direct_purple1b" "purple1b" "22"
+
+
+
+
+run_direct_success "f8_direct_numeric24" "24" "24"
+
+
+
+
+run_direct_validation "f9_direct_invalid" "not-a-slot"
+
+
+
+
+run_direct_validation "f10_direct_missing"
+
+
+
+
+interactive_out="$TMP/f11_interactive.out"
+interactive_err="$TMP/f11_interactive.err"
+interactive_log="$TMP/f11_interactive.hid.log"
+interactive_expected_log="$TMP/f11_interactive.expected.log"
+rm -f "$interactive_log"
+ONLYKEY_FAKE_HID_LOG="$interactive_log" \
+ONLYKEY_FAKE_PROMPTS=$'wipeslot green1a\nwipeslot not-a-slot\nwipeslot\nwipeslot 24' \
+    run_onlykey_cli >"$interactive_out" 2>"$interactive_err"
+interactive_ec=$?
+
+cat >"$interactive_expected_log" <<'EOF'
+write msg=231 slot=1
+write msg=231 slot=24
+EOF
+
+[ "$interactive_ec" -eq 0 ] || fail "F11 exit $interactive_ec; want 0"
+assert_interactive_stdout_behavior "$interactive_out"
+assert_empty_file "$interactive_err"
+assert_wipe_log_eq "$interactive_log" "$interactive_expected_log" "F11 HID writes"
+
+echo "PASS"
+exit 0
