diff --git a/tests/test_dataelem.py b/tests/test_dataelem.py
index 95bdfecf0..8e85268ab 100644
--- a/tests/test_dataelem.py
+++ b/tests/test_dataelem.py
@@ -82,6 +82,65 @@ class TestDataElement:
         """DataElement: return correct value multiplicity for VM = 1"""
         assert 1 == self.data_elementIS.VM
 
+    def test_VM_SQ_issue_reproducer(self):
+        """SQ element VM is 1 regardless of the number of items (issue repro)."""
+        ds = Dataset()
+        ds.BeamSequence = [Dataset(), Dataset()]
+        assert ds["BeamSequence"].VM == 1
+
+    def test_VM_SQ_empty(self):
+        """SQ element VM is 1 for an empty sequence."""
+        ds = Dataset()
+        ds.BeamSequence = []
+        assert ds["BeamSequence"].VM == 1
+
+    def test_VM_SQ_single_item(self):
+        """SQ element VM is 1 for a single-item sequence."""
+        ds = Dataset()
+        ds.BeamSequence = [Dataset()]
+        assert ds["BeamSequence"].VM == 1
+
+    def test_VM_SQ_three_items(self):
+        """SQ element VM is 1 even for sequences with 3 items."""
+        elem = DataElement(0x300A00B0, "SQ", [Dataset(), Dataset(), Dataset()])
+        assert elem.VM == 1
+
+    def test_VM_SQ_direct_constructor_default(self):
+        """SQ element built via DataElement(value=None) still reports VM=1."""
+        elem = DataElement(0x300A00B0, "SQ", None)
+        assert elem.VR == "SQ"
+        assert elem.VM == 1
+
+    def test_is_empty_SQ_empty(self):
+        """is_empty is True for an empty SQ element."""
+        ds = Dataset()
+        ds.BeamSequence = []
+        assert ds["BeamSequence"].is_empty is True
+
+    def test_is_empty_SQ_non_empty(self):
+        """is_empty is False for a non-empty SQ element."""
+        ds = Dataset()
+        ds.BeamSequence = [Dataset(), Dataset()]
+        assert ds["BeamSequence"].is_empty is False
+
+    def test_is_empty_SQ_single_item(self):
+        """is_empty is False for a single-item SQ element."""
+        ds = Dataset()
+        ds.BeamSequence = [Dataset()]
+        assert ds["BeamSequence"].is_empty is False
+
+    def test_VM_non_SQ_multivalue_preserved(self):
+        """Non-SQ multi-value elements still report len-based VM."""
+        elem = DataElement((1, 2), "DS", ["42.1", "42.2", "42.3"])
+        assert elem.VM == 3
+        assert elem.is_empty is False
+
+    def test_VM_non_SQ_empty_value_preserved(self):
+        """Non-SQ element with empty value still reports VM=0/is_empty."""
+        elem = DataElement((1, 2), "SH", "")
+        assert elem.VM == 0
+        assert elem.is_empty is True
+
     def test_DSFloat_conversion(self):
         """Test that strings are correctly converted if changing the value."""
