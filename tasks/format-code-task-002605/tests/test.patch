+func TestIdenticalInterfaceSequenceHandling(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+	g := graph.NewDefaultGraph(ctrl)
+
+	src := xtest.MustParseIA("1-ff00:0:111")
+	dst := xtest.MustParseIA("1-ff00:0:112")
+	ups := []*seg.PathSegment{
+		g.Beacon([]common.IFIDType{graph.If_120_X_111_B}),
+		g.Beacon([]common.IFIDType{graph.If_130_B_111_A}),
+	}
+	cores := []*seg.PathSegment{
+		g.Beacon([]common.IFIDType{graph.If_130_B_120_A}),
+		g.Beacon([]common.IFIDType{graph.If_120_A_130_B}),
+		g.Beacon([]common.IFIDType{graph.If_120_A_110_X, graph.If_110_X_130_A}),
+		g.Beacon([]common.IFIDType{graph.If_130_A_110_X, graph.If_110_X_120_A}),
+	}
+	downs := []*seg.PathSegment{
+		g.Beacon([]common.IFIDType{graph.If_130_A_112_X}),
+		g.Beacon([]common.IFIDType{graph.If_130_B_111_A, graph.If_111_A_112_X}),
+		g.Beacon([]common.IFIDType{graph.If_120_X_111_B, graph.If_111_A_112_X}),
+	}
+	downs[2].Info.Timestamp = time.Unix(10, 0)
+	downs[1].Info.Timestamp = time.Unix(20, 0)
+
+	defaultPaths := combineDefault(t, src, dst, ups, cores, downs)
+	allPaths := combineIncludingDuplicateSequences(t, src, dst, ups, cores, downs)
+
+	assertNoDuplicateInterfaceSequences(t, defaultPaths)
+	assertLatestExpiryRepresentatives(t, allPaths, defaultPaths)
+	assertNoExactForwardingPathDuplicates(t, allPaths)
+	if !hasDuplicateInterfaceSequence(allPaths) {
+		t.Fatalf("opt-out Combine result has no duplicate interface sequence")
+	}
+	if len(allPaths) <= len(defaultPaths) {
+		t.Fatalf("opt-out Combine result should expose more paths than default mode: opt-out=%d default=%d",
+			len(allPaths), len(defaultPaths))
+	}
+}
+
+func combineDefault(t *testing.T, src, dst addr.IA, ups, cores, downs []*seg.PathSegment) []Path {
+	t.Helper()
+	return callCombine(t, false, src, dst, ups, cores, downs)
+}
+
+func combineIncludingDuplicateSequences(t *testing.T, src, dst addr.IA,
+	ups, cores, downs []*seg.PathSegment) []Path {
+
+	t.Helper()
+	return callCombine(t, true, src, dst, ups, cores, downs)
+}
+
+func callCombine(t *testing.T, includeDuplicateSequences bool, src, dst addr.IA,
+	ups, cores, downs []*seg.PathSegment) []Path {
+
+	t.Helper()
+	fn := reflect.ValueOf(Combine)
+	fnType := fn.Type()
+	pathSliceType := reflect.TypeOf([]Path{})
+	if fnType.NumOut() != 1 || !fnType.Out(0).AssignableTo(pathSliceType) {
+		t.Fatalf("Combine must return []Path, got %s", fnType)
+	}
+
+	baseArgs := []reflect.Value{
+		reflect.ValueOf(src),
+		reflect.ValueOf(dst),
+		reflect.ValueOf(ups),
+		reflect.ValueOf(cores),
+		reflect.ValueOf(downs),
+	}
+	args, ok := combineArgs(fnType, baseArgs, reflect.ValueOf(includeDuplicateSequences))
+	if !ok {
+		t.Fatalf("Combine must expose a caller-visible boolean opt-out, got %s", fnType)
+	}
+
+	return fn.Call(args)[0].Interface().([]Path)
+}
+
+func combineArgs(fnType reflect.Type, baseArgs []reflect.Value, boolArg reflect.Value) ([]reflect.Value, bool) {
+	if !boolArg.Bool() && !fnType.IsVariadic() && fnType.NumIn() == len(baseArgs) &&
+		fixedCombineArgsMatch(fnType, baseArgs) {
+		return append([]reflect.Value{}, baseArgs...), true
+	}
+	if fnType.IsVariadic() {
+		if fnType.NumIn() != len(baseArgs)+1 ||
+			fnType.In(fnType.NumIn()-1).Elem() != boolArg.Type() ||
+			!fixedCombineArgsMatch(fnType, baseArgs) {
+			return nil, false
+		}
+		if boolArg.Bool() {
+			return append(append([]reflect.Value{}, baseArgs...), boolArg), true
+		}
+		return append([]reflect.Value{}, baseArgs...), true
+	}
+
+	if fnType.NumIn() != len(baseArgs)+1 {
+		return nil, false
+	}
+	args := make([]reflect.Value, 0, fnType.NumIn())
+	nextBase := 0
+	usedBool := false
+	for i := 0; i < fnType.NumIn(); i++ {
+		paramType := fnType.In(i)
+		if !usedBool && boolArg.Type().AssignableTo(paramType) {
+			args = append(args, boolArg)
+			usedBool = true
+			continue
+		}
+		if nextBase >= len(baseArgs) || !baseArgs[nextBase].Type().AssignableTo(paramType) {
+			return nil, false
+		}
+		args = append(args, baseArgs[nextBase])
+		nextBase++
+	}
+	return args, usedBool && nextBase == len(baseArgs)
+}
+
+func fixedCombineArgsMatch(fnType reflect.Type, baseArgs []reflect.Value) bool {
+	for i, arg := range baseArgs {
+		if !arg.Type().AssignableTo(fnType.In(i)) {
+			return false
+		}
+	}
+	return true
+}
+
+func interfaceSequenceKey(interfaces []snet.PathInterface) string {
+	var b strings.Builder
+	for _, intf := range interfaces {
+
+		fmt.Fprintf(&b, "%s#%d;", intf.IA, intf.ID)
+	}
+	return b.String()
+}
+
+func interfaceSequenceCounts(paths []Path) map[string]int {
+	counts := make(map[string]int)
+	for _, p := range paths {
+		counts[interfaceSequenceKey(p.Metadata.Interfaces)]++
+	}
+	return counts
+}
+
+func hasDuplicateInterfaceSequence(paths []Path) bool {
+	for _, count := range interfaceSequenceCounts(paths) {
+		if count > 1 {
+			return true
+		}
+	}
+	return false
+}
+
+func assertNoDuplicateInterfaceSequences(t *testing.T, paths []Path) {
+	t.Helper()
+	seen := make(map[string]int)
+	for i, p := range paths {
+		key := interfaceSequenceKey(p.Metadata.Interfaces)
+		if prev, ok := seen[key]; ok {
+			t.Fatalf("default Combine result contains duplicate interface sequence at indexes %d and %d: %s",
+				prev, i, key)
+		}
+		seen[key] = i
+	}
+}
+
+func assertLatestExpiryRepresentatives(t *testing.T, allPaths, defaultPaths []Path) {
+	t.Helper()
+
+	type candidateInfo struct {
+		count       int
+		latestIndex int
+	}
+	candidates := make(map[string]candidateInfo)
+	for i, p := range allPaths {
+		key := interfaceSequenceKey(p.Metadata.Interfaces)
+		info := candidates[key]
+		if info.count == 0 || p.Metadata.Expiry.After(allPaths[info.latestIndex].Metadata.Expiry) {
+			info.latestIndex = i
+		}
+		info.count++
+		candidates[key] = info
+	}
+
+	defaultByKey := make(map[string]Path)
+	for _, p := range defaultPaths {
+		key := interfaceSequenceKey(p.Metadata.Interfaces)
+		if _, ok := defaultByKey[key]; ok {
+			t.Fatalf("default Combine result contains more than one representative for interface sequence %s", key)
+		}
+		defaultByKey[key] = p
+	}
+
+	for key, info := range candidates {
+		if info.count <= 1 {
+			continue
+		}
+		got, ok := defaultByKey[key]
+		if !ok {
+			t.Fatalf("default Combine result dropped duplicated interface sequence %s entirely", key)
+		}
+		want := allPaths[info.latestIndex].Metadata.Expiry
+		if !got.Metadata.Expiry.Equal(want) {
+			t.Fatalf("default Combine kept wrong expiry for duplicated interface sequence %s: got %s want latest %s",
+				key, got.Metadata.Expiry, want)
+		}
+	}
+}
+
+func assertNoExactForwardingPathDuplicates(t *testing.T, paths []Path) {
+	t.Helper()
+	seen := make(map[string]int)
+	for i, p := range paths {
+		key := interfaceSequenceKey(p.Metadata.Interfaces) + "|" + string(p.SPath.Raw)
+		if prev, ok := seen[key]; ok {
+			t.Fatalf("opt-out Combine result contains exact duplicate forwarding paths at indexes %d and %d",
+				prev, i)
+		}
+		seen[key] = i
+	}
+}
