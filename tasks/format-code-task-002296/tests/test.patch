diff --git a/tests/deps/logrus_path_test.go b/tests/deps/logrus_path_test.go
new file mode 100644
index 00000000..098657cc
--- /dev/null
+++ b/tests/deps/logrus_path_test.go
@@ -0,0 +1,80 @@
+package deps_test
+
+import (
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func repoRoot(t *testing.T) string {
+	t.Helper()
+
+	dir, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "glide.yaml")); err == nil {
+			root, err := filepath.EvalSymlinks(dir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			return root
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			t.Fatal("could not find repository root")
+		}
+		dir = parent
+	}
+}
+
+func TestLogrusPathCanonicalized(t *testing.T) {
+	t.Helper()
+
+	root := repoRoot(t)
+	const oldPath = "github.com/Sirupsen/logrus"
+	const newPath = "github.com/sirupsen/logrus"
+	seenLowercase := false
+
+	err := filepath.Walk(root, func(path string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		if info.IsDir() {
+			name := info.Name()
+			if strings.HasPrefix(name, ".") || name == "vendor" {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if filepath.Ext(path) != ".go" {
+			return nil
+		}
+
+		f, err := parser.ParseFile(token.NewFileSet(), path, nil, parser.ImportsOnly)
+		if err != nil {
+			return err
+		}
+		for _, imp := range f.Imports {
+			got := strings.Trim(imp.Path.Value, "\"")
+			if got == oldPath {
+				t.Fatalf("found mixed-case logrus import in %s", path)
+			}
+			if got == newPath {
+				seenLowercase = true
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !seenLowercase {
+		t.Fatal("did not find the canonical lowercase logrus import")
+	}
+}
diff --git a/tests/deps/logrus_version_test.go b/tests/deps/logrus_version_test.go
new file mode 100644
index 00000000..232154ce
--- /dev/null
+++ b/tests/deps/logrus_version_test.go
@@ -0,0 +1,106 @@
+package deps_test
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"unicode"
+)
+
+const (
+	lowercaseLogrusPath = "github.com/sirupsen/logrus"
+	mixedCaseLogrusPath = "github.com/Sirupsen/logrus"
+	legacyLogrusRev     = "4b6ea7319e214d98c938f12692336f7ca9348d6b"
+)
+
+func TestLogrusVersionPinned(t *testing.T) {
+	t.Helper()
+
+	root := repoRoot(t)
+	manifest := dependencyBlock(t, filepath.Join(root, "glide.yaml"), "package", lowercaseLogrusPath)
+	if got := blockField(t, manifest, "version"); got != "v1.3.0" {
+		t.Fatalf("glide.yaml logrus version = %q, want v1.3.0", got)
+	}
+
+	lock := dependencyBlock(t, filepath.Join(root, "glide.lock"), "name", lowercaseLogrusPath)
+	lockVersion := blockField(t, lock, "version")
+	if !isGitRevision(lockVersion) {
+		t.Fatalf("glide.lock logrus version = %q, want a resolved revision", lockVersion)
+	}
+	if lockVersion == legacyLogrusRev {
+		t.Fatalf("glide.lock still points at the old mixed-case logrus revision %q", lockVersion)
+	}
+
+	mustNotContain(t, filepath.Join(root, "glide.yaml"), mixedCaseLogrusPath)
+	mustNotContain(t, filepath.Join(root, "glide.lock"), mixedCaseLogrusPath)
+}
+
+func dependencyBlock(t *testing.T, path, key, value string) []string {
+	t.Helper()
+
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	header := "- " + key + ": " + value
+	lines := strings.Split(string(data), "\n")
+	for i, line := range lines {
+		if strings.TrimSpace(line) != header {
+			continue
+		}
+		block := []string{strings.TrimSpace(line)}
+		for _, candidate := range lines[i+1:] {
+			trimmed := strings.TrimSpace(candidate)
+			if trimmed == "" {
+				continue
+			}
+			if strings.HasPrefix(trimmed, "- ") {
+				break
+			}
+			block = append(block, trimmed)
+		}
+		return block
+	}
+
+	t.Fatalf("did not find %q in %s", header, path)
+	return nil
+}
+
+func blockField(t *testing.T, block []string, key string) string {
+	t.Helper()
+
+	prefix := key + ": "
+	for _, line := range block {
+		if strings.HasPrefix(line, prefix) {
+			return strings.TrimSpace(strings.TrimPrefix(line, prefix))
+		}
+	}
+	t.Fatalf("did not find %q field in block %v", key, block)
+	return ""
+}
+
+func isGitRevision(s string) bool {
+	if len(s) != 40 {
+		return false
+	}
+	for _, r := range s {
+		if !unicode.IsDigit(r) && (r < 'a' || r > 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+func mustNotContain(t *testing.T, path, needle string) {
+	t.Helper()
+
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(data), needle) {
+		t.Fatalf("unexpected %q in %s", needle, path)
+	}
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,24 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export GOPATH=/root/go
+export GO111MODULE=off
+mkdir -p "$GOPATH/src/github.com/coreos"
+ln -sfn /testbed "$GOPATH/src/github.com/coreos/matchbox"
+cd "$GOPATH/src/github.com/coreos/matchbox"
+
+
+case "${1:-}" in
+  base)
+    go test -v ./matchbox/http/context.go ./matchbox/http/context_test.go
+    ;;
+  new)
+    go test -v ./tests/deps/
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
