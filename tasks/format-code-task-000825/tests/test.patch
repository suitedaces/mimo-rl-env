@@ -0,0 +1,192 @@
+from io import BytesIO
+
+import pytest
+from docling_core.types.doc import (
+    DocItemLabel,
+    DoclingDocument,
+    ListItem,
+    PictureItem,
+    SectionHeaderItem,
+    TableItem,
+    TextItem,
+)
+
+from docling.backend.abstract_backend import DeclarativeDocumentBackend
+from docling.backend.asciidoc_backend import AsciiDocBackend
+from docling.datamodel.base_models import (
+    FormatToExtensions,
+    FormatToMimeType,
+    InputFormat,
+    MimeTypeToFormat,
+)
+from docling.datamodel.document import InputDocument
+
+SAMPLE = """= The Document Title
+
+This is the first paragraph
+spanning two lines.
+
+== Introduction
+
+Some intro text here.
+
+=== Details
+
+* First bullet
+* Second bullet
+* Third bullet
+
+== Data
+
+|===
+| Name | Age | City
+| Alice | 30 | NYC
+| Bob | 25 | LA
+|===
+
+image::images/photo.png[]
+"""
+
+
+def _convert(text: str) -> DoclingDocument:
+    stream = BytesIO(text.encode("utf-8"))
+    in_doc = InputDocument(
+        path_or_stream=stream,
+        format=InputFormat.ASCIIDOC,
+        backend=AsciiDocBackend,
+        filename="sample.asciidoc",
+    )
+    backend = in_doc._backend
+    assert isinstance(backend, AsciiDocBackend)
+    assert backend.is_valid()
+    return backend.convert()
+
+
+
+
+
+
+
+def test_input_format_member_exists():
+    assert hasattr(InputFormat, "ASCIIDOC")
+    assert InputFormat.ASCIIDOC.value == "asciidoc"
+
+
+def test_format_extensions_registered():
+    exts = FormatToExtensions[InputFormat.ASCIIDOC]
+    assert "asciidoc" in exts
+    assert "adoc" in exts
+
+
+def test_mimetype_registered():
+    assert "text/asciidoc" in FormatToMimeType[InputFormat.ASCIIDOC]
+    assert MimeTypeToFormat["text/asciidoc"] == InputFormat.ASCIIDOC
+
+
+
+
+
+
+
+def test_backend_is_declarative():
+    assert issubclass(AsciiDocBackend, DeclarativeDocumentBackend)
+
+
+def test_backend_capabilities():
+    assert AsciiDocBackend.supported_formats() == {InputFormat.ASCIIDOC}
+    assert AsciiDocBackend.supports_pagination() is False
+
+
+def test_convert_returns_docling_document():
+    doc = _convert(SAMPLE)
+    assert isinstance(doc, DoclingDocument)
+
+
+
+
+
+
+
+def test_title_parsing():
+    doc = _convert(SAMPLE)
+    titles = [
+        item.text
+        for item, _ in doc.iterate_items()
+        if isinstance(item, TextItem) and item.label == DocItemLabel.TITLE
+    ]
+    assert titles == ["The Document Title"]
+
+
+def test_section_headers_and_levels():
+    doc = _convert(SAMPLE)
+    headers = [
+        (item.text, item.level)
+        for item, _ in doc.iterate_items()
+        if isinstance(item, SectionHeaderItem)
+    ]
+    assert headers == [
+        ("Introduction", 1),
+        ("Details", 2),
+        ("Data", 1),
+    ]
+
+
+def test_list_items():
+    doc = _convert(SAMPLE)
+    items = [
+        item.text for item, _ in doc.iterate_items() if isinstance(item, ListItem)
+    ]
+    assert items == ["First bullet", "Second bullet", "Third bullet"]
+
+
+def test_numbered_list_items():
+    text = """= T
+
+1. one
+2. two
+3. three
+"""
+    doc = _convert(text)
+    items = [
+        item.text for item, _ in doc.iterate_items() if isinstance(item, ListItem)
+    ]
+    assert items == ["one", "two", "three"]
+
+
+def test_paragraph_multiline_join():
+    doc = _convert(SAMPLE)
+    paragraphs = [
+        item.text
+        for item, _ in doc.iterate_items()
+        if isinstance(item, TextItem) and item.label == DocItemLabel.PARAGRAPH
+    ]
+    assert "This is the first paragraph spanning two lines." in paragraphs
+    assert "Some intro text here." in paragraphs
+
+
+def test_table_parsing():
+    doc = _convert(SAMPLE)
+    tables = [item for item, _ in doc.iterate_items() if isinstance(item, TableItem)]
+    assert len(tables) == 1
+
+    table = tables[0]
+    assert table.data.num_rows == 3
+    assert table.data.num_cols == 3
+
+    grid = {
+        (cell.start_row_offset_idx, cell.start_col_offset_idx): cell.text
+        for cell in table.data.table_cells
+    }
+    assert grid[(0, 0)] == "Name"
+    assert grid[(0, 1)] == "Age"
+    assert grid[(0, 2)] == "City"
+    assert grid[(1, 0)] == "Alice"
+    assert grid[(2, 2)] == "LA"
+
+
+def test_picture_parsing():
+    doc = _convert(SAMPLE)
+    pictures = [
+        item for item, _ in doc.iterate_items() if isinstance(item, PictureItem)
+    ]
+    assert len(pictures) == 1
