+    def test_split_uri_path_starts_with_double_slash(self):
+
+
+
+        self._callFUT(b'//testing/whatever')
+        self.assertEqual(self.proxy_scheme, '')
+        self.assertEqual(self.proxy_netloc, '')
+        self.assertEqual(self.path, '//testing/whatever')
+        self.assertEqual(self.query, '')
+        self.assertEqual(self.fragment, '')
+
+    def test_split_uri_path_starts_with_double_slash_with_query(self):
+        self._callFUT(b'//testing/whatever?a=1&b=2')
+        self.assertEqual(self.proxy_scheme, '')
+        self.assertEqual(self.proxy_netloc, '')
+        self.assertEqual(self.path, '//testing/whatever')
+        self.assertEqual(self.query, 'a=1&b=2')
+        self.assertEqual(self.fragment, '')
+
+    def test_split_uri_path_starts_with_double_slash_with_fragment(self):
+        self._callFUT(b'//testing/whatever#frag')
+        self.assertEqual(self.proxy_scheme, '')
+        self.assertEqual(self.proxy_netloc, '')
+        self.assertEqual(self.path, '//testing/whatever')
+        self.assertEqual(self.query, '')
+        self.assertEqual(self.fragment, 'frag')
+
+    def test_split_uri_path_starts_with_double_slash_with_query_and_fragment(self):
+        self._callFUT(b'//testing/whatever?a=1#frag')
+        self.assertEqual(self.proxy_scheme, '')
+        self.assertEqual(self.proxy_netloc, '')
+        self.assertEqual(self.path, '//testing/whatever')
+        self.assertEqual(self.query, 'a=1')
+        self.assertEqual(self.fragment, 'frag')
+
+    def test_split_uri_path_just_double_slash(self):
+
+
+        self._callFUT(b'//')
+        self.assertEqual(self.proxy_scheme, '')
+        self.assertEqual(self.proxy_netloc, '')
+        self.assertEqual(self.path, '//')
+        self.assertEqual(self.query, '')
+        self.assertEqual(self.fragment, '')
+
+    def test_parse_header_uri_starts_with_double_slash(self):
+
+
+
+        from waitress.parser import HTTPRequestParser
+        from waitress.adjustments import Adjustments
+        parser = HTTPRequestParser(Adjustments())
+        parser.parse_header(b'GET //testing/whatever HTTP/1.1\n')
+        self.assertEqual(parser.path, '//testing/whatever')
+        self.assertEqual(parser.proxy_netloc, '')
+        self.assertEqual(parser.proxy_scheme, '')
+        self.assertEqual(parser.command, 'GET')
+        self.assertEqual(parser.version, '1.1')
+
