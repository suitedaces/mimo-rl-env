diff --git a/tests/lax_numpy_reducers_test.py b/tests/lax_numpy_reducers_test.py
index 027eac86f..0090e9c74 100644
--- a/tests/lax_numpy_reducers_test.py
+++ b/tests/lax_numpy_reducers_test.py
@@ -930,5 +930,103 @@ class JaxNumpyReducerTests(jtu.JaxTestCase):
     self._CheckAgainstNumpy(np_fun, jnp_fun, args_maker)
     self._CompileAndCheck(jnp_fun, args_maker)
 
+  def _has_f32_intermediate(self, jaxpr):
+    """Return True iff any equation in the jaxpr produces a float32 output."""
+    for eqn in jaxpr.jaxpr.eqns:
+      for outvar in eqn.outvars:
+        if outvar.aval.dtype == np.float32:
+          return True
+    return False
+
+  def _has_dtype_intermediate(self, jaxpr, dtype):
+    for eqn in jaxpr.jaxpr.eqns:
+      for outvar in eqn.outvars:
+        if outvar.aval.dtype == dtype:
+          return True
+    return False
+
+  def testMeanExplicitBfloat16NoUpcast(self):
+
+    x = jnp.zeros((2, 3, 5), dtype=jnp.bfloat16)
+    f = lambda x: jnp.mean(x, axis=-1, keepdims=True, dtype=x.dtype)
+    jaxpr = jax.make_jaxpr(f)(x)
+
+    self.assertFalse(self._has_f32_intermediate(jaxpr),
+                     msg=f"Unexpected float32 intermediate in: {jaxpr}")
+
+    self.assertEqual(f(x).dtype, jnp.bfloat16)
+
+  def testMeanExplicitFloat16NoUpcast(self):
+    x = jnp.zeros((2, 3, 5), dtype=jnp.float16)
+    f = lambda x: jnp.mean(x, axis=-1, dtype=jnp.float16)
+    jaxpr = jax.make_jaxpr(f)(x)
+    self.assertFalse(self._has_f32_intermediate(jaxpr),
+                     msg=f"Unexpected float32 intermediate in: {jaxpr}")
+    self.assertEqual(f(x).dtype, jnp.float16)
+
+  def testMeanDefaultBfloat16StillUpcasts(self):
+
+    x = jnp.zeros((2, 3, 5), dtype=jnp.bfloat16)
+    f = lambda x: jnp.mean(x, axis=-1)
+    jaxpr = jax.make_jaxpr(f)(x)
+    self.assertTrue(self._has_f32_intermediate(jaxpr),
+                    msg=f"Expected float32 intermediate (default) in: {jaxpr}")
+    self.assertEqual(f(x).dtype, jnp.bfloat16)
+
+  def testMeanExplicitFloat32UpcastsBfloat16(self):
+
+    x = jnp.zeros((2, 3, 5), dtype=jnp.bfloat16)
+    f = lambda x: jnp.mean(x, axis=-1, dtype=jnp.float32)
+    jaxpr = jax.make_jaxpr(f)(x)
+    self.assertTrue(self._has_f32_intermediate(jaxpr),
+                    msg=f"Expected float32 intermediate in: {jaxpr}")
+    self.assertEqual(f(x).dtype, jnp.float32)
+
+  def testSumExplicitBfloat16NoUpcast(self):
+    x = jnp.zeros((2, 3, 5), dtype=jnp.bfloat16)
+    f = lambda x: jnp.sum(x, axis=-1, dtype=jnp.bfloat16)
+    jaxpr = jax.make_jaxpr(f)(x)
+    self.assertFalse(self._has_f32_intermediate(jaxpr),
+                     msg=f"Unexpected float32 intermediate in: {jaxpr}")
+    self.assertEqual(f(x).dtype, jnp.bfloat16)
+
+  def testSumExplicitFloat16NoUpcast(self):
+    x = jnp.zeros((2, 3, 5), dtype=jnp.float16)
+    f = lambda x: jnp.sum(x, axis=-1, dtype=jnp.float16)
+    jaxpr = jax.make_jaxpr(f)(x)
+    self.assertFalse(self._has_f32_intermediate(jaxpr),
+                     msg=f"Unexpected float32 intermediate in: {jaxpr}")
+    self.assertEqual(f(x).dtype, jnp.float16)
+
+  def testSumDefaultBfloat16StillUpcasts(self):
+    x = jnp.zeros((2, 3, 5), dtype=jnp.bfloat16)
+    f = lambda x: jnp.sum(x, axis=-1)
+    jaxpr = jax.make_jaxpr(f)(x)
+    self.assertTrue(self._has_f32_intermediate(jaxpr),
+                    msg=f"Expected float32 intermediate (default) in: {jaxpr}")
+    self.assertEqual(f(x).dtype, jnp.bfloat16)
+
+  def testProdExplicitBfloat16NoUpcast(self):
+    x = jnp.ones((2, 3, 5), dtype=jnp.bfloat16)
+    f = lambda x: jnp.prod(x, axis=-1, dtype=jnp.bfloat16)
+    jaxpr = jax.make_jaxpr(f)(x)
+    self.assertFalse(self._has_f32_intermediate(jaxpr),
+                     msg=f"Unexpected float32 intermediate in: {jaxpr}")
+    self.assertEqual(f(x).dtype, jnp.bfloat16)
+
+  def testProdDefaultBfloat16StillUpcasts(self):
+    x = jnp.ones((2, 3, 5), dtype=jnp.bfloat16)
+    f = lambda x: jnp.prod(x, axis=-1)
+    jaxpr = jax.make_jaxpr(f)(x)
+    self.assertTrue(self._has_f32_intermediate(jaxpr),
+                    msg=f"Expected float32 intermediate (default) in: {jaxpr}")
+
+  def testMeanFloat32DefaultUnaffected(self):
+
+    x = jnp.zeros((2, 3, 5), dtype=jnp.float32)
+    f = lambda x: jnp.mean(x, axis=-1)
+    self.assertEqual(f(x).dtype, jnp.float32)
+
+
 if __name__ == "__main__":
   absltest.main(testLoader=jtu.JaxTestLoader())
