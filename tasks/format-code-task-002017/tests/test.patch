diff --git a/napari/components/_tests/test_active_layer_highlight.py b/napari/components/_tests/test_active_layer_highlight.py
new file mode 100644
index 00000000..2c3838bd
--- /dev/null
+++ b/napari/components/_tests/test_active_layer_highlight.py
@@ -0,0 +1,176 @@
+
+
+
+
+
+
+import numpy as np
+
+from napari.components import ViewerModel
+
+
+def _make_viewer_with_points():
+    viewer = ViewerModel()
+    points = viewer.add_points([[10, 10], [20, 20], [30, 30]])
+    points.selected_data = {0, 1}
+    return viewer, points
+
+
+def _make_viewer_with_shapes(mode='pan_zoom'):
+    viewer = ViewerModel()
+    shapes = viewer.add_shapes(
+        [[[10, 10], [10, 30], [30, 30], [30, 10]]],
+        shape_type='rectangle',
+    )
+    shapes.mode = mode
+    shapes.selected_data = {0}
+    return viewer, shapes
+
+
+
+
+
+def test_points_highlight_visible_when_active():
+
+
+    viewer, points = _make_viewer_with_points()
+    assert viewer.layers.selection.active is points
+    assert list(points._highlight_index) == [0, 1]
+
+
+def test_points_highlight_hidden_when_other_layer_active():
+
+
+    viewer, points = _make_viewer_with_points()
+    viewer.add_image(np.zeros((50, 50)))
+
+    assert viewer.layers.selection.active is not points
+    assert list(points._highlight_index) == []
+
+
+def test_points_highlight_restored_when_reactivated():
+
+    viewer, points = _make_viewer_with_points()
+    viewer.add_image(np.zeros((50, 50)))
+
+    viewer.layers.selection.active = points
+    assert list(points._highlight_index) == [0, 1]
+
+
+def test_points_selected_data_preserved_across_layer_switch():
+
+
+    viewer, points = _make_viewer_with_points()
+    viewer.add_image(np.zeros((50, 50)))
+    assert set(points.selected_data) == {0, 1}
+    viewer.layers.selection.active = points
+    assert set(points.selected_data) == {0, 1}
+
+
+def test_points_highlight_hidden_when_no_active_layer():
+
+
+    viewer, points = _make_viewer_with_points()
+    viewer.add_image(np.zeros((50, 50)))
+    viewer.layers.selection.clear()
+    assert viewer.layers.selection.active is None
+    assert list(points._highlight_index) == []
+
+
+
+
+
+def test_shapes_outline_present_when_active():
+
+
+    viewer, shapes = _make_viewer_with_shapes()
+    assert viewer.layers.selection.active is shapes
+    vertices, triangles = shapes._outline_shapes()
+    assert vertices is not None
+    assert triangles is not None
+    assert len(vertices) > 0
+
+
+def test_shapes_outline_hidden_when_other_layer_active():
+
+
+    viewer, shapes = _make_viewer_with_shapes()
+    viewer.add_image(np.zeros((50, 50)))
+    assert viewer.layers.selection.active is not shapes
+    vertices, triangles = shapes._outline_shapes()
+    assert vertices is None
+    assert triangles is None
+
+
+def test_shapes_outline_restored_when_reactivated():
+
+
+    viewer, shapes = _make_viewer_with_shapes()
+    viewer.add_image(np.zeros((50, 50)))
+    viewer.layers.selection.active = shapes
+    vertices, triangles = shapes._outline_shapes()
+    assert vertices is not None
+    assert triangles is not None
+    assert len(vertices) > 0
+
+
+
+
+
+def test_shapes_box_present_in_select_mode_when_active():
+
+
+    viewer, shapes = _make_viewer_with_shapes(mode='select')
+    vertices, face_color, edge_color, pos, width = (
+        shapes._compute_vertices_and_box()
+    )
+    assert pos is not None
+    assert vertices.shape[0] > 0
+    assert width > 0
+
+
+def test_shapes_box_hidden_when_other_layer_active():
+
+
+    viewer, shapes = _make_viewer_with_shapes(mode='select')
+    viewer.add_image(np.zeros((50, 50)))
+    vertices, face_color, edge_color, pos, width = (
+        shapes._compute_vertices_and_box()
+    )
+    assert pos is None
+    assert vertices.shape == (0, 2)
+    assert width == 0
+
+
+def test_shapes_box_restored_when_reactivated():
+
+    viewer, shapes = _make_viewer_with_shapes(mode='select')
+    viewer.add_image(np.zeros((50, 50)))
+    viewer.layers.selection.active = shapes
+    vertices, face_color, edge_color, pos, width = (
+        shapes._compute_vertices_and_box()
+    )
+    assert pos is not None
+    assert vertices.shape[0] > 0
+    assert width > 0
+
+
+def test_shapes_selected_data_preserved_across_layer_switch():
+
+
+    viewer, shapes = _make_viewer_with_shapes(mode='select')
+    viewer.add_image(np.zeros((50, 50)))
+    assert set(shapes.selected_data) == {0}
+    viewer.layers.selection.active = shapes
+    assert set(shapes.selected_data) == {0}
+
+
+def test_shapes_outline_hidden_when_no_active_layer():
+
+    viewer, shapes = _make_viewer_with_shapes()
+    viewer.add_image(np.zeros((50, 50)))
+    viewer.layers.selection.clear()
+    assert viewer.layers.selection.active is None
+    vertices, triangles = shapes._outline_shapes()
+    assert vertices is None
+    assert triangles is None
