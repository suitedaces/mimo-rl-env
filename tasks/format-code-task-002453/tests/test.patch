diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,59 @@
+#!/bin/bash
+set -uo pipefail
+
+
+cd /testbed
+
+if [ ! -f satpy/version.py ]; then
+  printf '%s\n' 'version = "0+fixture"' > satpy/version.py
+fi
+
+PYTEST=(python3 -m pytest -q)
+
+BASE_TARGETS=(
+  satpy/tests/multiscene_tests/test_blend.py
+  satpy/tests/test_composites.py
+  satpy/tests/test_dataset.py
+  satpy/tests/test_file_handlers.py
+)
+
+DESELECT_NEW_OR_MODIFIED=(
+  --deselect=satpy/tests/multiscene_tests/test_blend.py::TestBlendFuncs::test_blend_two_scenes_using_stack_weighted
+  --deselect=satpy/tests/multiscene_tests/test_blend.py::TestBlendFuncs::test_blend_function_stack_weighted
+  --deselect=satpy/tests/test_composites.py::TestStaticImageCompositor::test_call
+  --deselect=satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_start_time_uses_earliest_datetime
+  --deselect=satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_end_time_uses_latest_datetime
+  --deselect=satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_ignores_none_and_non_datetime_for_boundaries
+  --deselect=satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_other_time_keys_still_average_valid_datetimes
+  --deselect=satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_omits_time_key_when_no_valid_datetimes
+  --deselect=satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_time_parameters_merges_child_time_values
+  --deselect=satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_average_times_warns_and_keeps_span_semantics
+  --deselect=satpy/tests/test_file_handlers.py::TestBaseFileHandler::test_combine_times
+)
+
+NEW_TARGETS=(
+  satpy/tests/multiscene_tests/test_blend.py::TestBlendFuncs::test_blend_two_scenes_using_stack_weighted
+  satpy/tests/multiscene_tests/test_blend.py::TestBlendFuncs::test_blend_function_stack_weighted
+  satpy/tests/test_composites.py::TestStaticImageCompositor::test_call
+  satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_start_time_uses_earliest_datetime
+  satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_end_time_uses_latest_datetime
+  satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_ignores_none_and_non_datetime_for_boundaries
+  satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_other_time_keys_still_average_valid_datetimes
+  satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_omits_time_key_when_no_valid_datetimes
+  satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_time_parameters_merges_child_time_values
+  satpy/tests/test_dataset.py::TestCombineMetadata::test_combine_metadata_average_times_warns_and_keeps_span_semantics
+  satpy/tests/test_file_handlers.py::TestBaseFileHandler::test_combine_times
+)
+
+case "${1:-}" in
+  base)
+    "${PYTEST[@]}" "${BASE_TARGETS[@]}" "${DESELECT_NEW_OR_MODIFIED[@]}"
+    ;;
+  new)
+    "${PYTEST[@]}" "${NEW_TARGETS[@]}"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
