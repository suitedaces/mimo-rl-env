diff --git a/usercase-test-coderl/test_multimeter_resistance.py b/usercase-test-coderl/test_multimeter_resistance.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_multimeter_resistance.py
@@ -0,0 +1,128 @@
+
+
+
+
+
+
+import math
+
+import pytest
+
+from pslab import Multimeter
+from pslab.connection import ConnectionHandler
+
+
+class ScriptedConnection(ConnectionHandler):
+
+
+    def __init__(self, raw_voltage_sums):
+        self._raw_voltage_sums = list(raw_voltage_sums)
+        self.writes = []
+
+    def connect(self):
+        return None
+
+    def disconnect(self):
+        return None
+
+    def write(self, data):
+        self.writes.append(bytes(data))
+        return len(data)
+
+    def read(self, numbytes):
+        if numbytes == 1:
+            return b"\x01"
+        if numbytes == 2:
+            return self._raw_voltage_sums.pop(0).to_bytes(2, "little")
+        raise AssertionError(f"unexpected read size: {numbytes}")
+
+
+class UnreadableMeasurementConnection(ScriptedConnection):
+    def read(self, numbytes):
+        if numbytes == 1:
+            return b"\x01"
+        if numbytes == 2:
+            raise ConnectionError("device not connected")
+        raise AssertionError(f"unexpected read size: {numbytes}")
+
+
+def test_resistance_uses_res_voltage_divider_formula_for_query_examples():
+
+
+
+    meter = Multimeter(ScriptedConnection([2730 * 16, 2048 * 16]))
+
+    first = meter.measure_resistance()
+    second = meter.measure_resistance()
+
+    assert isinstance(first, float) is True
+
+    assert first == pytest.approx(10200.0, rel=1e-3)
+    assert isinstance(second, float) is True
+
+    assert second == pytest.approx(5100.0, rel=1e-3)
+
+
+def test_repeated_calls_perform_fresh_measurements_on_same_instance():
+
+
+
+    meter = Multimeter(ScriptedConnection([2730 * 16, 2048 * 16, 4094 * 16]))
+
+
+    assert meter.measure_resistance() == pytest.approx(10200.0, rel=1e-3)
+
+    assert meter.measure_resistance() == pytest.approx(5100.0, rel=1e-3)
+    assert math.isinf(meter.measure_resistance()) is True
+
+
+def test_saturated_res_reading_returns_positive_infinity():
+
+
+
+    meter = Multimeter(ScriptedConnection([4094 * 16]))
+
+    resistance = meter.measure_resistance()
+
+    assert resistance == math.inf
+
+
+def test_measurement_read_failure_does_not_return_resistance():
+
+
+
+    meter = Multimeter(UnreadableMeasurementConnection([]))
+
+
+    with pytest.raises(Exception):
+        meter.measure_resistance()
+
+
+def test_two_multimeters_read_independent_device_state():
+
+
+
+    a = Multimeter(ScriptedConnection([2730 * 16]))
+    b = Multimeter(ScriptedConnection([2048 * 16]))
+
+
+    assert a.measure_resistance() == pytest.approx(10200.0, rel=1e-3)
+
+    assert b.measure_resistance() == pytest.approx(5100.0, rel=1e-3)
+
+
+def test_construct_measure_drop_cycles_return_float_resistance_values():
+
+
+
+    for raw_voltage_sum, expected_resistance in (
+        (2730 * 16, 10200.0),
+        (2048 * 16, 5100.0),
+    ):
+        meter = Multimeter(ScriptedConnection([raw_voltage_sum]))
+        resistance = meter.measure_resistance()
+
+
+        assert isinstance(resistance, float) is True
+        assert resistance == pytest.approx(expected_resistance, rel=1e-3)
+        del meter
