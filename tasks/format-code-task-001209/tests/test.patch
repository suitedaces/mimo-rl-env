+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+
+
+set -euo pipefail
+
+cd /workspace/repo
+
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+
+VENV_PYTHON="/opt/stage4a-pslab-venv/bin/python"
+if [ ! -x "$VENV_PYTHON" ]; then
+    echo "missing prepared offline Python environment: $VENV_PYTHON" >&2
+    exit 127
+fi
+
+exec "$VENV_PYTHON" -m pytest /workspace/repo/usercase-test-coderl/test_multimeter_resistance.py -v
