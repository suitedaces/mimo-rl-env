+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+if [ ! -x ./node_modules/.bin/mocha ]; then
+  echo "Missing ./node_modules/.bin/mocha; dependencies must be preinstalled in the image." >&2
+  exit 127
+fi
+exec ./node_modules/.bin/mocha /workspace/repo/usercase-test-coderl/bwtransform2.test.js
