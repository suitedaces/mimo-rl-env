diff --git a/usercase-test-coderl/bwtransform2.test.js b/usercase-test-coderl/bwtransform2.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/bwtransform2.test.js
@@ -0,0 +1,199 @@
+/* eslint-env mocha */
+'use strict';
+
+
+
+
+
+var assert = require('assert');
+var childProcess = require('child_process');
+var fs = require('fs');
+var os = require('os');
+var path = require('path');
+var net = require('net');
+var tls = require('tls');
+var dgram = require('dgram');
+var compressjs = require('/workspace/repo');
+
+var bwtransform2 = compressjs.BWT.bwtransform2;
+
+function codes(s) {
+    return Array.prototype.map.call(s, function(c) {
+        return c.charCodeAt(0);
+    });
+}
+
+function textFromBuffer(buf) {
+    return String.fromCharCode.apply(null, Array.prototype.slice.call(buf));
+}
+
+function runTransform(T, n, alphabetSize, OutputCtor) {
+    var U = new (OutputCtor || T.constructor)(n);
+    var pidx = (arguments.length >= 3 && alphabetSize !== undefined) ?
+        bwtransform2(T, U, n, alphabetSize) :
+        bwtransform2(T, U, n);
+    return { pidx: pidx, out: Array.prototype.slice.call(U), text: textFromBuffer(U) };
+}
+
+describe('compressjs.BWT.bwtransform2', function() {
+    it('transforms the queried repeated ASCII cyclic input with explicit alphabet size', function() {
+
+
+        var T = new Uint8Array(codes('bcababa'));
+        var actual = runTransform(T, 7, 256);
+
+        assert.strictEqual(actual.pidx, 5);
+        assert.deepStrictEqual(actual.out, [99, 98, 98, 97, 97, 97, 98]);
+        assert.strictEqual(actual.text, 'cbbaaab');
+    });
+
+    it('transforms ascending ASCII letters to the queried cyclic rotation', function() {
+
+
+        var T = new Uint8Array(codes('ABCDEFGHIJKLMNOPQRSTUVWXYZ'));
+        var actual = runTransform(T, 26, 256);
+
+        assert.strictEqual(actual.pidx, 0);
+        assert.deepStrictEqual(actual.out, [90, 65, 66, 67, 68, 69, 70, 71, 72, 73, 74, 75, 76, 77, 78, 79, 80, 81, 82, 83, 84, 85, 86, 87, 88, 89]);
+        assert.strictEqual(actual.text, 'ZABCDEFGHIJKLMNOPQRSTUVWXY');
+    });
+
+    it('transforms descending ASCII letters to the queried cyclic rotation', function() {
+
+
+        var T = new Uint8Array(codes('ZYXWVUTSRQPONMLKJIHGFEDCBA'));
+        var actual = runTransform(T, 26, 256);
+
+        assert.strictEqual(actual.pidx, 25);
+        assert.deepStrictEqual(actual.out, [66, 67, 68, 69, 70, 71, 72, 73, 74, 75, 76, 77, 78, 79, 80, 81, 82, 83, 84, 85, 86, 87, 88, 89, 90, 65]);
+        assert.strictEqual(actual.text, 'BCDEFGHIJKLMNOPQRSTUVWXYZA');
+    });
+
+    it('copies a one-symbol input and returns zero', function() {
+
+
+        var T = new Uint8Array([81]);
+        var actual = runTransform(T, 1, 256);
+
+        assert.strictEqual(actual.pidx, 0);
+        assert.deepStrictEqual(actual.out, [81]);
+        assert.strictEqual(actual.text, 'Q');
+    });
+
+    it('uses the Uint8Array omitted alphabet-size default for byte input', function() {
+
+
+        var T = new Uint8Array(codes('banana'));
+        var actual = runTransform(T, 6);
+
+        assert.strictEqual(actual.pidx, 3);
+        assert.deepStrictEqual(actual.out, [110, 110, 98, 97, 97, 97]);
+        assert.strictEqual(actual.text, 'nnbaaa');
+    });
+
+    it('uses only the first n input symbols when n is shorter than the buffer', function() {
+
+
+        var T = new Uint8Array(codes('banana!'));
+        var actual = runTransform(T, 6);
+
+        assert.strictEqual(actual.pidx, 3);
+        assert.deepStrictEqual(actual.out, [110, 110, 98, 97, 97, 97]);
+        assert.strictEqual(actual.text, 'nnbaaa');
+    });
+
+    it('uses the Uint16Array omitted alphabet-size default for two-byte input', function() {
+
+
+        var T = new Uint16Array([300, 1000, 300, 42, 1000]);
+        var actual = runTransform(T, 5);
+
+        assert.strictEqual(actual.pidx, 2);
+        assert.deepStrictEqual(actual.out, [300, 1000, 1000, 300, 42]);
+    });
+
+    it('raises a specific Error when alphabet size is omitted for a buffer without byte width', function() {
+
+
+        assert.throws(function() {
+            bwtransform2([98, 97], [0, 0], 2);
+        }, function(err) {
+            assert(err instanceof Error);
+            assert.strictEqual(err.message, 'Need to specify alphabetSize');
+            return true;
+        });
+    });
+
+    it('is referentially transparent for repeated calls with identical values', function() {
+        var first = runTransform(new Uint8Array(codes('bcababa')), 7, 256);
+        var second = runTransform(new Uint8Array(codes('bcababa')), 7, 256);
+
+        assert.deepStrictEqual(second, first);
+    });
+
+    it('does not mutate the first n symbols of caller input when using a fresh exact-size buffer', function() {
+        var T = new Uint8Array(codes('banana'));
+        var before = Array.prototype.slice.call(T);
+
+        var actual = runTransform(T, 6);
+
+        assert.strictEqual(actual.pidx, 3);
+        assert.deepStrictEqual(actual.out, [110, 110, 98, 97, 97, 97]);
+        assert.deepStrictEqual(Array.prototype.slice.call(T), before);
+    });
+
+    it('returns the same result in a fresh Node process after unrelated in-process calls', function() {
+        var inProcess = runTransform(new Uint8Array(codes('banana')), 6);
+
+        runTransform(new Uint8Array(codes('bcababa')), 7, 256);
+        runTransform(new Uint8Array(codes('ZYXWVUTSRQPONMLKJIHGFEDCBA')), 26, 256);
+        assert.deepStrictEqual(runTransform(new Uint8Array(codes('banana')), 6), inProcess);
+
+        var script = [
+            "const compressjs = require('/workspace/repo');",
+            "const BWT = compressjs.BWT;",
+            "const T = new Uint8Array([98,97,110,97,110,97]);",
+            "const U = new Uint8Array(6);",
+            "const pidx = BWT.bwtransform2(T, U, 6);",
+            "process.stdout.write(JSON.stringify({pidx:pidx,out:Array.prototype.slice.call(U)}));"
+        ].join('');
+        var fresh = JSON.parse(childProcess.execFileSync(process.execPath, ['-e', script], { encoding: 'utf8' }));
+
+        assert.deepStrictEqual(fresh, { pidx: 3, out: [110, 110, 98, 97, 97, 97] });
+        assert.deepStrictEqual(fresh, { pidx: inProcess.pidx, out: inProcess.out });
+    });
+
+    it('does not perform undeclared filesystem writes or network access', function() {
+        var tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'bwtransform2-side-effects-'));
+        var oldCwd = process.cwd();
+        var oldNetConnect = net.connect;
+        var oldCreateConnection = net.createConnection;
+        var oldTlsConnect = tls.connect;
+        var oldDgramCreateSocket = dgram.createSocket;
+        function failNetwork() {
+            throw new Error('Unexpected network access');
+        }
+
+        try {
+            net.connect = failNetwork;
+            net.createConnection = failNetwork;
+            tls.connect = failNetwork;
+            dgram.createSocket = failNetwork;
+            process.chdir(tmp);
+
+            var before = fs.readdirSync(tmp).sort();
+            var actual = runTransform(new Uint8Array(codes('bcababa')), 7, 256);
+            var after = fs.readdirSync(tmp).sort();
+
+            assert.deepStrictEqual(actual, { pidx: 5, out: [99, 98, 98, 97, 97, 97, 98], text: 'cbbaaab' });
+            assert.deepStrictEqual(after, before);
+        } finally {
+            process.chdir(oldCwd);
+            net.connect = oldNetConnect;
+            net.createConnection = oldCreateConnection;
+            tls.connect = oldTlsConnect;
+            dgram.createSocket = oldDgramCreateSocket;
+            fs.rmdirSync(tmp);
+        }
+    });
+});
