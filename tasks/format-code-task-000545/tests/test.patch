+def _write_pyproject_toml(tmpdir, content):
+    path = os.path.join(tmpdir, "pyproject.toml")
+    with open(path, "w") as f:
+        f.write(content)
+    return path
+
+
+class TestPyprojectTomlConfiguration(TestCase):
+    """Tests for [tool.behave] in pyproject.toml (PEP 518)."""
+
+    def _make_toml(self, content, suffix=".toml"):
+        fd, tn = tempfile.mkstemp(suffix=suffix)
+        os.close(fd)
+        with open(tn, "w") as f:
+            f.write(content)
+        self.addCleanup(self._safe_unlink, tn)
+        return tn
+
+    @staticmethod
+    def _safe_unlink(path):
+        try:
+            os.unlink(path)
+        except OSError:
+            pass
+
+    def test_read_toml_file_basic_options(self):
+        """Reading a .toml file returns the same option dict shape as INI."""
+        tn = self._make_toml(TEST_CONFIG_TOML)
+        tndir = os.path.dirname(tn)
+
+        d = configuration.read_configuration(tn)
+        assert d["default_tags"] == ["@foo,~@bar", "@zap"]
+        assert d["format"] == ["pretty", "tag-counter"]
+        assert d["stdout_capture"] is False
+
+        assert "bogus" not in d
+
+    def test_read_toml_file_userdata_subsection(self):
+        """[tool.behave.userdata] becomes userdata dict with stringified values."""
+        tn = self._make_toml(TEST_CONFIG_TOML)
+        d = configuration.read_configuration(tn)
+
+        assert d["userdata"] == {"foo": "bar", "answer": "42"}
+
+    def test_read_toml_file_paths_are_normalized(self):
+        """Relative paths are evaluated relative to the config file location."""
+        tn = self._make_toml(TEST_CONFIG_TOML)
+        tndir = os.path.dirname(tn)
+        d = configuration.read_configuration(tn)
+        assert d["paths"] == [
+            os.path.normpath(ROOTDIR_PREFIX + "/absolute/path3"),
+            os.path.normpath(os.path.join(tndir, "relative/path4")),
+        ]
+
+    def test_read_toml_file_outfiles_normalized(self):
+        tn = self._make_toml(TEST_CONFIG_TOML)
+        tndir = os.path.dirname(tn)
+        d = configuration.read_configuration(tn)
+        assert d["outfiles"] == [
+            os.path.normpath(ROOTDIR_PREFIX + "/absolute/path1"),
+            os.path.normpath(os.path.join(tndir, "relative/path2")),
+        ]
+
+    def test_read_toml_file_boolean_store_true(self):
+        """A boolean TOML value maps to a Python bool (not string)."""
+        content = (
+            "[tool.behave]\n"
+            "stdout_capture = false\n"
+            "stderr_capture = true\n"
+        )
+        tn = self._make_toml(content)
+        d = configuration.read_configuration(tn)
+        assert d["stdout_capture"] is False
+        assert d["stderr_capture"] is True
+
+    def test_read_toml_file_empty_tool_behave(self):
+        """A pyproject.toml without [tool.behave] yields no behave options."""
+        content = '[tool.other]\nfoo = "bar"\n'
+        tn = self._make_toml(content)
+        d = configuration.read_configuration(tn)
+
+        assert "default_tags" not in d
+        assert "format" not in d
+        assert "stdout_capture" not in d
+
+    def test_read_toml_file_list_format(self):
+        """TOML native arrays are used directly for append-type options."""
+        content = (
+            '[tool.behave]\n'
+            'format = ["pretty", "json"]\n'
+        )
+        tn = self._make_toml(content)
+        d = configuration.read_configuration(tn)
+        assert d["format"] == ["pretty", "json"]
+
+    def test_pyproject_toml_listed_in_config_filenames(self):
+        """config_filenames() picks up pyproject.toml in current directory."""
+        tmpd = tempfile.mkdtemp()
+        old_cwd = os.getcwd()
+        try:
+            os.chdir(tmpd)
+            _write_pyproject_toml(tmpd, '[tool.behave]\nstdout_capture = false\n')
+            files = list(configuration.config_filenames())
+            assert any(f.endswith("pyproject.toml") for f in files), \
+                "pyproject.toml not found in: %r" % files
+        finally:
+            os.chdir(old_cwd)
+
+    def test_load_configuration_with_pyproject_toml(self):
+        """load_configuration reads pyproject.toml [tool.behave] settings."""
+        tmpd = tempfile.mkdtemp()
+        old_cwd = os.getcwd()
+        try:
+            os.chdir(tmpd)
+            _write_pyproject_toml(tmpd, (
+                '[tool.behave]\n'
+                'stdout_capture = false\n'
+                'default_tags = ["@foo"]\n'
+                'format = ["pretty"]\n'
+                '\n'
+                '[tool.behave.userdata]\n'
+                'person = "Alice"\n'
+                'answer = 42\n'
+            ))
+            defaults = {}
+            configuration.load_configuration(defaults, verbose=False)
+            assert defaults.get("stdout_capture") is False
+            assert defaults.get("default_tags") == ["@foo"]
+            assert defaults.get("format") == ["pretty"]
+            assert defaults.get("userdata", {}).get("person") == "Alice"
+
+            assert defaults.get("userdata", {}).get("answer") == "42"
+        finally:
+            os.chdir(old_cwd)
