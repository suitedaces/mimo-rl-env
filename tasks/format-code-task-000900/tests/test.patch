new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    cd proxyd
+    if [ -f integration_tests/consensus_degraded_test.go ]; then
+      mv integration_tests/consensus_degraded_test.go integration_tests/consensus_degraded_test.go.fixturea-disabled
+      trap 'mv integration_tests/consensus_degraded_test.go.fixturea-disabled integration_tests/consensus_degraded_test.go' EXIT
+    fi
+    go test -v -run '^TestConsensus/(initial consensus|prevent using a backend with low peer count|prevent using a backend not in sync|advance consensus|broken consensus|broken consensus with depth 2|fork in advanced block)$' ./integration_tests/
+    ;;
+  new)
+    cd proxyd
+    go test -v -run '^(TestConsensus|TestConsensus/(load balancing should distribute across healthy consensus members|load balancing should not hit if node is not healthy)|TestConsensusAwareRoutingPrefersNonDegradedBeforeDegradedFallback)$' ./integration_tests/
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
