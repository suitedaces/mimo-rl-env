+import { commandRunner, initFixtureFactory } from "@lerna/test-helpers";
+import fs from "fs-extra";
+import path from "path";
+
+const initFixture = initFixtureFactory(__dirname);
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const lernaExec = commandRunner(require("../command"));
+
+const CAPTURE_KEYS = [
+  "CODESPEC_FILE_ONLY",
+  "CODESPEC_QUOTED",
+  "CODESPEC_COMMENTED",
+  "CODESPEC_IGNORED",
+  "CODESPEC_FILE_EMPTY",
+  "CODESPEC_ORDER",
+  "CODESPEC_PARENT",
+  "CODESPEC_INLINE",
+  "CODESPEC_INLINE_PARENT",
+  "CODESPEC_EQUALS",
+  "CODESPEC_EMPTY",
+  "CODESPEC_LAYER",
+  "CODESPEC_ROOT_ONLY",
+  "CODESPEC_PACKAGE_ONLY",
+  "LERNA_PACKAGE_NAME",
+  "LERNA_ROOT_PATH",
+];
+
+const initEnvFixture = async () => {
+  const cwd = await initFixture("basic");
+  const script = [
+    'const fs = require("fs");',
+    `const keys = ${JSON.stringify(CAPTURE_KEYS)};`,
+    "const captured = Object.fromEntries(keys.map((key) => [key, process.env[key]]));",
+    'fs.writeFileSync("codespec-env-capture.json", JSON.stringify(captured));',
+  ].join("\n");
+
+  await Promise.all(
+    ["package-1", "package-2"].map((name) =>
+      fs.writeFile(path.join(cwd, "packages", name, "codespec-capture-env.js"), script)
+    )
+  );
+
+  return cwd;
+};
+
+const readCapture = (cwd: string, packageName: string) =>
+  fs.readJson(path.join(cwd, "packages", packageName, "codespec-env-capture.json"));
+
+const captureExists = (cwd: string, packageName: string) =>
+  fs.pathExists(path.join(cwd, "packages", packageName, "codespec-env-capture.json"));
+
+const invoke = async (cwd: string, ...args: string[]) => {
+  try {
+    await lernaExec(cwd)(...args);
+    return { ok: true as const };
+  } catch (error) {
+    return { ok: false as const, message: (error as Error).message };
+  }
+};
+
+describe("lerna exec explicit environment overlays", () => {
+  const originalEnvironment = new Map(CAPTURE_KEYS.map((key) => [key, process.env[key]]));
+
+  beforeEach(() => {
+    for (const key of CAPTURE_KEYS) delete process.env[key];
+    process.env.CODESPEC_PARENT = "from-parent";
+    process.env.CODESPEC_INLINE_PARENT = "from-parent";
+  });
+
+  afterEach(() => {
+    expect(process.env.CODESPEC_PARENT).toBe("from-parent");
+    expect(process.env.CODESPEC_INLINE_PARENT).toBe("from-parent");
+    for (const key of CAPTURE_KEYS) {
+      if (key !== "CODESPEC_PARENT" && key !== "CODESPEC_INLINE_PARENT") {
+        expect(process.env[key]).toBeUndefined();
+      }
+    }
+    process.exitCode = undefined;
+  });
+
+  afterAll(() => {
+    for (const [key, value] of originalEnvironment) {
+      if (value === undefined) delete process.env[key];
+      else process.env[key] = value;
+    }
+  });
+
+  it("parses ordered root files and applies parent, inline, empty, and reserved-value precedence", async () => {
+    const cwd = await initEnvFixture();
+    await fs.writeFile(
+      path.join(cwd, "codespec-base.env"),
+      [
+        "CODESPEC_FILE_ONLY=from-file",
+        'CODESPEC_QUOTED="hello world"',
+        "# CODESPEC_IGNORED=bad",
+        "CODESPEC_COMMENTED=kept",
+        "CODESPEC_FILE_EMPTY=",
+        "CODESPEC_ORDER=base",
+        "CODESPEC_PARENT=from-file",
+        "CODESPEC_INLINE=from-file",
+        "CODESPEC_INLINE_PARENT=from-file",
+        "LERNA_PACKAGE_NAME=spoofed",
+        "LERNA_ROOT_PATH=/spoofed",
+        "",
+      ].join("\n")
+    );
+    await fs.writeFile(
+      path.join(cwd, "codespec-override.env"),
+      "CODESPEC_ORDER=override\nCODESPEC_INLINE=from-later-file\n"
+    );
+
+    const outcome = await invoke(
+      cwd,
+      "--no-sort",
+      "--env-file",
+      "codespec-base.env",
+      "--env-file",
+      "codespec-override.env",
+      "--env",
+      "CODESPEC_INLINE=first=with-equals",
+      "--env",
+      "CODESPEC_INLINE=last",
+      "--env",
+      "CODESPEC_INLINE_PARENT=from-inline",
+      "--env",
+      "CODESPEC_EQUALS=left=middle=right",
+      "--env",
+      "CODESPEC_EMPTY=",
+      "--env",
+      "LERNA_PACKAGE_NAME=inline-spoof",
+      "--env",
+      "LERNA_ROOT_PATH=/inline-spoof",
+      "--",
+      "node",
+      "codespec-capture-env.js"
+    );
+
+    expect(outcome).toEqual({ ok: true });
+    const packageOne = await readCapture(cwd, "package-1");
+    const packageTwo = await readCapture(cwd, "package-2");
+    for (const [capture, packageName] of [
+      [packageOne, "package-1"],
+      [packageTwo, "package-2"],
+    ] as const) {
+      expect(capture).toMatchObject({
+        CODESPEC_FILE_ONLY: "from-file",
+        CODESPEC_QUOTED: "hello world",
+        CODESPEC_COMMENTED: "kept",
+        CODESPEC_FILE_EMPTY: "",
+        CODESPEC_ORDER: "override",
+        CODESPEC_PARENT: "from-parent",
+        CODESPEC_INLINE: "last",
+        CODESPEC_INLINE_PARENT: "from-inline",
+        CODESPEC_EQUALS: "left=middle=right",
+        CODESPEC_EMPTY: "",
+        LERNA_PACKAGE_NAME: packageName,
+        LERNA_ROOT_PATH: cwd,
+      });
+      expect(capture).not.toHaveProperty("CODESPEC_IGNORED");
+    }
+  });
+
+  it("layers optional package-relative files in order during parallel execution", async () => {
+    const cwd = await initEnvFixture();
+    await fs.writeFile(
+      path.join(cwd, "codespec-common.env"),
+      "CODESPEC_LAYER=root\nCODESPEC_ROOT_ONLY=root\nCODESPEC_ORDER=root\n"
+    );
+    await fs.writeFile(
+      path.join(cwd, "packages/package-1/codespec-package.env"),
+      "CODESPEC_LAYER=package-one\nCODESPEC_PACKAGE_ONLY=one\nCODESPEC_ORDER=first\nCODESPEC_PARENT=package-one\n"
+    );
+    await fs.writeFile(
+      path.join(cwd, "packages/package-1/codespec-package-override.env"),
+      "CODESPEC_ORDER=package-one-later\n"
+    );
+    await fs.writeFile(
+      path.join(cwd, "packages/package-2/codespec-package-override.env"),
+      "CODESPEC_ORDER=package-two-later\n"
+    );
+
+    const outcome = await invoke(
+      cwd,
+      "--parallel",
+      "--env-file",
+      "codespec-common.env",
+      "--package-env-file",
+      "codespec-package.env",
+      "--package-env-file",
+      "codespec-package-override.env",
+      "--",
+      "node",
+      "codespec-capture-env.js"
+    );
+
+    expect(outcome).toEqual({ ok: true });
+    const packageOne = await readCapture(cwd, "package-1");
+    expect(packageOne).toMatchObject({
+      CODESPEC_LAYER: "package-one",
+      CODESPEC_ROOT_ONLY: "root",
+      CODESPEC_PACKAGE_ONLY: "one",
+      CODESPEC_ORDER: "package-one-later",
+      CODESPEC_PARENT: "from-parent",
+      LERNA_PACKAGE_NAME: "package-1",
+      LERNA_ROOT_PATH: cwd,
+    });
+    const packageTwo = await readCapture(cwd, "package-2");
+    expect(packageTwo).toMatchObject({
+      CODESPEC_LAYER: "root",
+      CODESPEC_ROOT_ONLY: "root",
+      CODESPEC_ORDER: "package-two-later",
+      CODESPEC_PARENT: "from-parent",
+      LERNA_PACKAGE_NAME: "package-2",
+      LERNA_ROOT_PATH: cwd,
+    });
+    expect(packageTwo).not.toHaveProperty("CODESPEC_PACKAGE_ONLY");
+    for (const capture of [packageOne, packageTwo]) {
+      expect(capture).not.toHaveProperty("CODESPEC_FILE_ONLY");
+      expect(capture).not.toHaveProperty("CODESPEC_INLINE");
+      expect(capture).not.toHaveProperty("CODESPEC_EMPTY");
+    }
+  });
+
+  it("rejects a missing root environment file before starting any package command", async () => {
+    const cwd = await initEnvFixture();
+
+    const outcome = await invoke(
+      cwd,
+      "--env-file",
+      "codespec-missing.env",
+      "--",
+      "node",
+      "codespec-capture-env.js"
+    );
+
+    expect(outcome).toEqual({
+      ok: false,
+      message: "Environment file not found: codespec-missing.env",
+    });
+    await expect(captureExists(cwd, "package-1")).resolves.toBe(false);
+    await expect(captureExists(cwd, "package-2")).resolves.toBe(false);
+  });
+
+  it("rejects an invalid inline assignment before starting any package command", async () => {
+    const cwd = await initEnvFixture();
+
+    const outcome = await invoke(
+      cwd,
+      "--env",
+      "CODESPEC_BROKEN",
+      "--",
+      "node",
+      "codespec-capture-env.js"
+    );
+
+    expect(outcome).toEqual({
+      ok: false,
+      message: 'Invalid environment assignment "CODESPEC_BROKEN"; expected KEY=VALUE',
+    });
+    await expect(captureExists(cwd, "package-1")).resolves.toBe(false);
+    await expect(captureExists(cwd, "package-2")).resolves.toBe(false);
+  });
+});
