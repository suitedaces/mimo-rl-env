+					nock.cleanAll();
+					return;
+				}
+				if (!firstError && result.error) {
+					firstError = result.error;
+				}
+			}
+			nock.cleanAll();
+			assert.fail(`No CLI invocation pattern produced expected output. Last error: ${firstError && firstError.message}`);
+		}
+
