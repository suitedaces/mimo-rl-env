+
+		async function tryCommand(config, args, mockSetup) {
+			nock.cleanAll();
+			mockSetup();
+			let captured = '';
+			let capturedErr = '';
+			const origStdoutWrite = process.stdout.write.bind(process.stdout);
+			const origStderrWrite = process.stderr.write.bind(process.stderr);
+			const origExit = process.exit;
+			process.stdout.write = (data) => { captured += data.toString(); return true; };
+			process.stderr.write = (data) => { capturedErr += data.toString(); return true; };
+
+			process.exit = (code) => { throw new Error(`process.exit(${code})`); };
+			try {
+				const [id, ...extra] = args;
+				await config.runHook('init', { id, argv: extra });
+				await config.runCommand(id, extra);
+				return { ok: true, output: captured, errOutput: capturedErr };
+			} catch (e) {
+				return { ok: false, error: e, output: captured, errOutput: capturedErr };
+			} finally {
+				process.stdout.write = origStdoutWrite;
+				process.stderr.write = origStderrWrite;
+				process.exit = origExit;
+			}
+		}
+
+		async function runWithAnySignature(extraFlags, expectedOutput) {
