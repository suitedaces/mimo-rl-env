diff --git a/operators/pkg/controller/apmserver/keystore_addcommand_test.go b/operators/pkg/controller/apmserver/keystore_addcommand_test.go
new file mode 100644
index 000000000..d5abdaf8d
--- /dev/null
+++ b/operators/pkg/controller/apmserver/keystore_addcommand_test.go
@@ -0,0 +1,81 @@
+
+
+
+
+package apmserver
+
+import (
+	"strings"
+	"testing"
+
+	apmv1alpha1 "github.com/elastic/cloud-on-k8s/operators/pkg/apis/apm/v1alpha1"
+	commonv1alpha1 "github.com/elastic/cloud-on-k8s/operators/pkg/apis/common/v1alpha1"
+	"github.com/elastic/cloud-on-k8s/operators/pkg/controller/common/keystore"
+	"github.com/elastic/cloud-on-k8s/operators/pkg/controller/common/watches"
+	"github.com/elastic/cloud-on-k8s/operators/pkg/utils/k8s"
+	"github.com/stretchr/testify/require"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes/scheme"
+	"k8s.io/client-go/tools/record"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+)
+
+
+
+
+func renderApmKeystoreInitScript(t *testing.T) string {
+	t.Helper()
+	secretName := "secure-settings-secret"
+	secret := &corev1.Secret{
+		ObjectMeta: metav1.ObjectMeta{
+			Namespace:       "ns",
+			Name:            secretName,
+			ResourceVersion: "1",
+		},
+	}
+	apm := &apmv1alpha1.ApmServer{
+		TypeMeta: metav1.TypeMeta{Kind: apmv1alpha1.Kind},
+		ObjectMeta: metav1.ObjectMeta{
+			Namespace: "ns",
+			Name:      "apm",
+		},
+		Spec: apmv1alpha1.ApmServerSpec{
+			SecureSettings: &commonv1alpha1.SecretRef{SecretName: secretName},
+		},
+	}
+	client := k8s.WrapClient(fake.NewFakeClient(secret))
+	w := watches.NewDynamicWatches()
+	require.NoError(t, w.InjectScheme(scheme.Scheme))
+	resources, err := keystore.NewResources(client, record.NewFakeRecorder(100), w, apm, initContainerParameters)
+	require.NoError(t, err)
+	require.NotNil(t, resources)
+	require.True(t, len(resources.InitContainer.Command) >= 4, "init container Command shorter than expected: %v", resources.InitContainer.Command)
+	return resources.InitContainer.Command[len(resources.InitContainer.Command)-1]
+}
+
+
+
+
+func TestApmKeystoreAddCommand_NoTwoArgs(t *testing.T) {
+	script := renderApmKeystoreInitScript(t)
+	bug := `apm-server keystore add "$key" "$filename"`
+	if strings.Contains(script, bug) {
+		t.Fatalf("APM keystore script still contains the buggy two-arg invocation %q\n--- script ---\n%s", bug, script)
+	}
+}
+
+
+
+func TestApmKeystoreAddCommand_UsesStdin(t *testing.T) {
+	script := renderApmKeystoreInitScript(t)
+	if !strings.Contains(script, "apm-server keystore add") {
+		t.Fatalf("APM keystore script does not invoke `apm-server keystore add`:\n%s", script)
+	}
+	if !strings.Contains(script, "--stdin") {
+		t.Fatalf("APM keystore script must pass --stdin to apm-server keystore add:\n%s", script)
+	}
+	if !strings.Contains(script, `"$filename"`) {
+		t.Fatalf("APM keystore script must reference the per-entry $filename variable:\n%s", script)
+	}
+}
