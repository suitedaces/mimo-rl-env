index 56d4449..a411fb9 100644
--- a/test/unit/transaction_test.js
+++ b/test/unit/transaction_test.js
@@ -400,6 +400,82 @@ describe('Transaction', function() {
     expect(typeof transaction.toXDR).to.be.equal('function');
     expect(transaction.toXDR()).to.be.equal(xdrString);
   });
+
+  describe('networkPassphrase validation', function() {
+    function buildEnvelopeBase64() {
+      const source = new StellarBase.Account(
+        'GBBM6BKZPEHWYO3E3YKREDPQXMS4VK35YLNU7NFBRI26RAN7GI5POFBB',
+        '0'
+      );
+      const destination =
+        'GDJJRRMBK4IWLEPJGIE6SXD2LP7REGZODU7WDC3I2D6MR37F4XSHBKX2';
+      const asset = StellarBase.Asset.native();
+      const amount = '2000.0000000';
+      return new StellarBase.TransactionBuilder(source, { fee: 100 })
+        .addOperation(
+          StellarBase.Operation.payment({ destination, asset, amount })
+        )
+        .setTimeout(StellarBase.TimeoutInfinite)
+        .build()
+        .toEnvelope()
+        .toXDR('base64');
+    }
+
+    it('throws when passphrase is a number', function() {
+      const envelope = buildEnvelopeBase64();
+      expect(() => new StellarBase.Transaction(envelope, 1234)).to.throw();
+    });
+
+    it('throws when passphrase is a plain object', function() {
+      const envelope = buildEnvelopeBase64();
+      expect(() => new StellarBase.Transaction(envelope, {})).to.throw();
+    });
+
+    it('throws when passphrase is boolean true', function() {
+      const envelope = buildEnvelopeBase64();
+      expect(() => new StellarBase.Transaction(envelope, true)).to.throw();
+    });
+
+    it('throws when passphrase is boolean false', function() {
+      const envelope = buildEnvelopeBase64();
+      expect(() => new StellarBase.Transaction(envelope, false)).to.throw();
+    });
+
+    it('throws when passphrase is the number 0', function() {
+      const envelope = buildEnvelopeBase64();
+      expect(() => new StellarBase.Transaction(envelope, 0)).to.throw();
+    });
+
+    it('throws when passphrase is an array', function() {
+      const envelope = buildEnvelopeBase64();
+      expect(() => new StellarBase.Transaction(envelope, [])).to.throw();
+    });
+
+    it('does not throw when passphrase is undefined (deprecation case)', function() {
+      const envelope = buildEnvelopeBase64();
+      expect(
+        () => new StellarBase.Transaction(envelope, undefined)
+      ).to.not.throw();
+    });
+
+    it('does not throw when passphrase argument is omitted', function() {
+      const envelope = buildEnvelopeBase64();
+      expect(() => new StellarBase.Transaction(envelope)).to.not.throw();
+    });
+
+    it('does not throw when passphrase is a valid string', function() {
+      const envelope = buildEnvelopeBase64();
+      expect(
+        () =>
+          new StellarBase.Transaction(envelope, StellarBase.Networks.TESTNET)
+      ).to.not.throw();
+    });
+
+    it('does not throw when passphrase is an empty string', function() {
+      const envelope = buildEnvelopeBase64();
+      expect(() => new StellarBase.Transaction(envelope, '')).to.not.throw();
+    });
+  });
 });
 
