+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+export npm_config_audit=false
+export npm_config_fund=false
+export npm_config_update_notifier=false
+export NO_UPDATE_NOTIFIER=1
+
+test -x /workspace/repo/node_modules/.bin/vite
+test -x /workspace/repo/node_modules/.bin/vitest
+
+/workspace/repo/node_modules/.bin/vite build >/dev/null
+exec /workspace/repo/node_modules/.bin/vitest run /workspace/repo/usercase-test-coderl/aspect_helpers.test.ts --environment node
