--- /dev/null
+++ b/usercase-test-coderl/aspect_helpers.test.ts
@@ -0,0 +1,214 @@
+import { execFileSync } from 'node:child_process'
+import { mkdtempSync, readdirSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+import { afterEach, expect, test, vi } from 'vitest'
+
+vi.mock('node:net', () => ({
+  connect: () => {
+    throw new Error('unexpected network access')
+  },
+  createConnection: () => {
+    throw new Error('unexpected network access')
+  },
+  Socket: class {
+    constructor() {
+      throw new Error('unexpected network access')
+    }
+  },
+}))
+
+vi.mock('node:http', () => ({
+  request: () => {
+    throw new Error('unexpected network access')
+  },
+  get: () => {
+    throw new Error('unexpected network access')
+  },
+}))
+
+vi.mock('node:https', () => ({
+  request: () => {
+    throw new Error('unexpected network access')
+  },
+  get: () => {
+    throw new Error('unexpected network access')
+  },
+}))
+
+import { centerCrop, makeAspectCrop } from '../src/index'
+
+
+
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+  vi.restoreAllMocks()
+})
+
+test('makeAspectCrop derives percent height from percent width', () => {
+
+
+  const actual = makeAspectCrop({ unit: '%', width: 50 }, 16 / 9, 400, 300)
+
+  expect(actual).toEqual({ unit: '%', x: 0, y: 0, width: 50, height: 37.5 })
+})
+
+test('makeAspectCrop derives percent width from percent height and preserves coordinates', () => {
+
+
+  const actual = makeAspectCrop({ unit: '%', x: 10, y: 5, height: 40 }, 4 / 3, 800, 600)
+
+  expect(actual).toEqual({ unit: '%', x: 10, y: 5, width: 40, height: 40 })
+})
+
+test('makeAspectCrop derives pixel height from pixel width', () => {
+
+
+  const actual = makeAspectCrop({ unit: 'px', x: 20, y: 30, width: 180 }, 3 / 2, 500, 400)
+
+  expect(actual).toEqual({ x: 20, y: 30, width: 180, height: 120, unit: 'px' })
+})
+
+test('makeAspectCrop derives pixel width from pixel height', () => {
+
+
+  const actual = makeAspectCrop({ unit: 'px', x: 25, y: 10, height: 90 }, 2, 500, 300)
+
+  expect(actual).toEqual({ x: 25, y: 10, width: 180, height: 90, unit: 'px' })
+})
+
+test('makeAspectCrop shrinks pixel crop width when it overflows right edge', () => {
+
+
+  const actual = makeAspectCrop({ unit: 'px', x: 300, y: 0, width: 200 }, 1, 400, 300)
+
+  expect(actual).toEqual({ x: 300, y: 0, width: 100, height: 100, unit: 'px' })
+})
+
+test('makeAspectCrop shrinks percent crop height when it overflows bottom edge', () => {
+
+
+  const actual = makeAspectCrop({ unit: '%', x: 0, y: 70, width: 80 }, 1, 400, 300)
+
+  expect(actual).toEqual({ unit: '%', x: 0, y: 70, width: 22.5, height: 30 })
+})
+
+test('makeAspectCrop shrinks percent crop width when it overflows right edge', () => {
+
+
+  const actual = makeAspectCrop({ unit: '%', x: 75, y: 0, height: 60 }, 1, 400, 300)
+
+  expect(actual).toEqual({ unit: '%', x: 75, y: 0, width: 25, height: 33.33333333333333 })
+})
+
+test('centerCrop centers a pixel crop and preserves pixel unit', () => {
+
+
+  const actual = centerCrop({ unit: 'px', width: 100, height: 50 }, 400, 300)
+
+  expect(actual).toEqual({ x: 150, y: 125, width: 100, height: 50, unit: 'px' })
+})
+
+test('centerCrop centers a percent crop and preserves percent unit', () => {
+
+
+  const actual = centerCrop({ unit: '%', width: 50, height: 25 }, 400, 200)
+
+  expect(actual).toEqual({ unit: '%', x: 25, y: 37.5, width: 50, height: 25 })
+})
+
+test('makeAspectCrop defaults omitted pixel coordinates to zero', () => {
+
+  expect(makeAspectCrop({ unit: 'px', width: 75 }, 3, 500, 500)).toEqual({
+    unit: 'px',
+    x: 0,
+    y: 0,
+    width: 75,
+    height: 25,
+  })
+})
+
+test('helpers are referentially transparent for repeated calls', () => {
+  const aspectInput = { unit: '%', x: 10, y: 5, height: 40 } as const
+  const centerInput = { unit: 'px', width: 120, height: 80 } as const
+
+  expect(makeAspectCrop(aspectInput, 4 / 3, 800, 600)).toEqual(makeAspectCrop(aspectInput, 4 / 3, 800, 600))
+  expect(centerCrop(centerInput, 500, 300)).toEqual(centerCrop(centerInput, 500, 300))
+})
+
+test('helpers do not mutate caller-owned crop objects', () => {
+  const aspectInput = { unit: 'px', x: 300, y: 0, width: 200 } as const
+  const centerInput = { unit: '%', width: 20, height: 60 } as const
+  const aspectBefore = structuredClone(aspectInput)
+  const centerBefore = structuredClone(centerInput)
+
+  makeAspectCrop(aspectInput, 1, 400, 300)
+  centerCrop(centerInput, 1000, 500)
+
+  expect(aspectInput).toEqual(aspectBefore)
+  expect(centerInput).toEqual(centerBefore)
+})
+
+test('helpers do not depend on process-global state between calls', () => {
+  const inProcess = {
+    aspect: makeAspectCrop({ unit: '%', x: 10, y: 5, height: 40 }, 4 / 3, 800, 600),
+    centered: centerCrop({ unit: 'px', width: 120, height: 80 }, 500, 300),
+  }
+  makeAspectCrop({ unit: 'px', x: 20, y: 30, width: 180 }, 3 / 2, 500, 400)
+  centerCrop({ unit: '%', width: 50, height: 25 }, 400, 200)
+
+  const script = `
+    import { makeAspectCrop, centerCrop } from 'file:///workspace/repo/dist/index.js';
+    const result = {
+      aspect: makeAspectCrop({ unit: '%', x: 10, y: 5, height: 40 }, 4 / 3, 800, 600),
+      centered: centerCrop({ unit: 'px', width: 120, height: 80 }, 500, 300),
+    };
+    process.stdout.write(JSON.stringify(result));
+  `
+  const freshProcess = JSON.parse(execFileSync(process.execPath, ['--input-type=module', '-e', script], { encoding: 'utf8' }))
+
+  expect(inProcess).toEqual({
+    aspect: { unit: '%', x: 10, y: 5, width: 40, height: 40 },
+    centered: { x: 190, y: 110, width: 120, height: 80, unit: 'px' },
+  })
+  expect(freshProcess).toEqual(inProcess)
+})
+
+test('helpers do not perform filesystem, network, or other undeclared side effects', () => {
+  const originalCwd = process.cwd()
+  const isolatedCwd = mkdtempSync(join(tmpdir(), 'react-image-crop-pure-'))
+  const throwingNetwork = () => {
+    throw new Error('unexpected network access')
+  }
+
+  vi.stubGlobal('fetch', throwingNetwork)
+  vi.stubGlobal('XMLHttpRequest', throwingNetwork)
+  vi.stubGlobal('WebSocket', throwingNetwork)
+
+  try {
+    process.chdir(isolatedCwd)
+    const before = readdirSync(isolatedCwd)
+
+    expect(makeAspectCrop({ unit: '%', width: 50 }, 16 / 9, 400, 300)).toEqual({
+      unit: '%',
+      x: 0,
+      y: 0,
+      width: 50,
+      height: 37.5,
+    })
+    expect(centerCrop({ unit: 'px', width: 100, height: 50 }, 400, 300)).toEqual({
+      x: 150,
+      y: 125,
+      width: 100,
+      height: 50,
+      unit: 'px',
+    })
+
+    expect(readdirSync(isolatedCwd)).toEqual(before)
+  } finally {
+    process.chdir(originalCwd)
+    rmSync(isolatedCwd, { recursive: true, force: true })
+  }
+})
