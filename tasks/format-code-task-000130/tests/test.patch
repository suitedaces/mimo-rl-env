diff --git a/test/Utils/HyperplaneSampler.jl b/test/Utils/HyperplaneSampler.jl
new file mode 100644
index 000000000..a5af6ae8d
--- /dev/null
+++ b/test/Utils/HyperplaneSampler.jl
@@ -0,0 +1,102 @@
+using Test
+using Random
+using LazySets
+
+mutable struct CyclingVectorSource{N}
+    values::Vector{Vector{N}}
+    index::Int
+end
+
+function Base.rand(rng::AbstractRNG, d::CyclingVectorSource, n::Int)
+    x = d.values[d.index]
+    d.index = d.index == length(d.values) ? 1 : d.index + 1
+    @test length(x) == n
+    return copy(x)
+end
+
+function _on_set(x, S)
+    return isapproxzero(dot(S.a, x) - S.b)
+end
+
+@testset "project point to Hyperplane" begin
+    H = Hyperplane([2.0, 1.0, -2.0], 3.0)
+
+    y = project([1.0, 2.0, 0.0], H)
+    @test y ≈ [7 / 9, 17 / 9, 2 / 9]
+    @test _on_set(y, H)
+    @test length(y) == dim(H)
+
+    member = [1.0, 1.0, 0.0]
+    @test project(member, H) ≈ member
+end
+
+@testset "project point to Line2D" begin
+    L = Line2D([2.0, 1.0], 3.0)
+
+    y = project([0.0, 0.0], L)
+    @test y ≈ [6 / 5, 3 / 5]
+    @test _on_set(y, L)
+    @test length(y) == dim(L)
+
+    member = [1.0, 1.0]
+    @test project(member, L) ≈ member
+end
+
+@testset "explicit HyperplaneSampler" begin
+    H = Hyperplane([2.0, -1.0, 1.0], 1.0)
+    xs = sample(H, 8; sampler=LazySets.HyperplaneSampler())
+    @test length(xs) == 8
+    for x in xs
+        @test length(x) == dim(H)
+        @test _on_set(x, H)
+    end
+
+    L = Line2D([2.0, 1.0], 3.0)
+    ys = sample(L, 8; sampler=LazySets.HyperplaneSampler())
+    @test length(ys) == 8
+    for y in ys
+        @test length(y) == dim(L)
+        @test _on_set(y, L)
+    end
+end
+
+@testset "default sample from hyperplane-like sets" begin
+    H = Hyperplane([1.0, 2.0, -1.0], 2.0)
+    xs = sample(H, 7)
+    @test length(xs) == 7
+    for x in xs
+        @test length(x) == dim(H)
+        @test _on_set(x, H)
+    end
+
+    L = Line2D([3.0, -1.0], 2.0)
+    ys = sample(L, 7)
+    @test length(ys) == 7
+    for y in ys
+        @test length(y) == dim(L)
+        @test _on_set(y, L)
+    end
+end
+
+@testset "HyperplaneSampler default and custom source" begin
+    H = Hyperplane([2.0, -1.0, 1.0], 1.0)
+
+    default_samples = sample(H, 3; sampler=LazySets.HyperplaneSampler())
+    @test length(default_samples) == 3
+    for x in default_samples
+        @test length(x) == dim(H)
+        @test _on_set(x, H)
+    end
+
+    L = Line2D([1.0, 1.0], 1.0)
+    source = CyclingVectorSource([[3.0, 0.0], [0.0, 4.0]], 1)
+    sampler = LazySets.HyperplaneSampler(source)
+
+    ys = sample(L, 2; sampler=sampler)
+    @test length(ys) == 2
+    @test ys[1] ≈ [2.0, -1.0]
+    @test ys[2] ≈ [-1.5, 2.5]
+    for y in ys
+        @test _on_set(y, L)
+    end
+end
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,70 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+BASE_COMMIT="d8a1b83626d985ad6f0d52914500a456d6083ca9"
+
+run_julia() {
+    local mode="$1"
+    local script
+    script="$(mktemp)"
+    cat > "$script" <<'JL'
+using Pkg
+ENV["JULIA_PKG_PRECOMPILE_AUTO"] = "0"
+redirect_stdout(devnull) do
+    redirect_stderr(devnull) do
+        Pkg.instantiate(; verbose=false)
+    end
+end
+
+using LazySets, Test, LinearAlgebra
+using LazySets: isapproxzero, ispermutation
+using Random
+Random.seed!(1234)
+
+mode = ARGS[1]
+base_commit = ARGS[2]
+global test_suite_polyhedra = false
+
+if mode == "base"
+    tmp = mktempdir()
+    try
+        for rel in ("test/Sets/Hyperplane.jl", "test/Sets/Line2D.jl")
+            dest = joinpath(tmp, basename(rel))
+            content = read(`git show $(base_commit):$(rel)`, String)
+            write(dest, content)
+        end
+        @testset "Hyperplane base" begin
+            include(joinpath(tmp, "Hyperplane.jl"))
+        end
+        @testset "Line2D base" begin
+            include(joinpath(tmp, "Line2D.jl"))
+        end
+    finally
+        rm(tmp; recursive=true, force=true)
+    end
+elseif mode == "new"
+    @testset "Hyperplane" begin
+        include("/testbed/test/Sets/Hyperplane.jl")
+    end
+    @testset "Line2D" begin
+        include("/testbed/test/Sets/Line2D.jl")
+    end
+    @testset "HyperplaneSampler" begin
+        include("/testbed/test/Utils/HyperplaneSampler.jl")
+    end
+else
+    error("usage: test.sh base|new")
+end
+JL
+    julia --project=. "$script" "$mode" "$BASE_COMMIT"
+    local status=$?
+    rm -f "$script"
+    return "$status"
+}
+
+case "${1:-}" in
+  base) run_julia base ;;
+  new) run_julia new ;;
+  *) echo "usage: $0 base|new"; exit 2 ;;
+esac
