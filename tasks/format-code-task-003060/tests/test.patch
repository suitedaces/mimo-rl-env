diff --git a/packages/zowe-explorer/__tests__/__unit__/commands/UnixCommandHandler.unit.test.ts b/packages/zowe-explorer/__tests__/__unit__/commands/UnixCommandHandler.unit.test.ts
index 0d0f68ebe..78f5f72a8 100644
--- a/packages/zowe-explorer/__tests__/__unit__/commands/UnixCommandHandler.unit.test.ts
+++ b/packages/zowe-explorer/__tests__/__unit__/commands/UnixCommandHandler.unit.test.ts
@@ -652,4 +652,97 @@ describe("UnixCommand Actions Unit Testing", () => {
 
         expect(showInformationMessage.mock.calls.length).toBe(0);
     });
+
+    describe("Issue #3650: SSH profile name shown in command output", () => {
+        const nodeProf: imperative.IProfileLoaded = {
+            name: "rightClickedZosmfProfile",
+            type: "zosmf",
+            profile: { user: "nodeUser" },
+            message: "",
+            failNotFound: false,
+        };
+        const sshProf: imperative.IProfileLoaded = {
+            name: "selectedSshProfile",
+            type: "ssh",
+            profile: { user: "sshUser", host: "ssh.host.com", port: 22 },
+            message: "",
+            failNotFound: false,
+        };
+
+        it("formatCommandLine outputs the SSH profile's name when an SSH profile was selected", () => {
+            const handler = getUnixActions();
+            (handler as any).nodeProfile = nodeProf;
+            handler.sshProfile = sshProf;
+            handler.isSshRequiredForProf = true;
+            handler.sshCwd = "/u/userdir";
+
+
+
+
+
+
+
+
+            const expected = "> sshUser@selectedSshProfile:/u/userdir $ ls -la";
+            const outViaNode = handler.formatCommandLine("ls -la", nodeProf);
+            const outViaSsh = handler.formatCommandLine("ls -la", sshProf);
+            expect([outViaNode, outViaSsh]).toContain(expected);
+        });
+
+        it("formatCommandLine falls back to nodeProfile when no SSH profile was selected (preservation)", () => {
+            const handler = getUnixActions();
+            (handler as any).nodeProfile = nodeProf;
+            handler.sshProfile = undefined;
+            handler.isSshRequiredForProf = false;
+            handler.sshCwd = "/home/dir";
+            const out = handler.formatCommandLine("uname -a");
+            expect(out).toBe("> nodeUser@rightClickedZosmfProfile:/home/dir $ uname -a");
+        });
+
+        it("formatCommandLine uses the profile argument when neither nodeProfile nor sshProfile is set", () => {
+            const handler = getUnixActions();
+            (handler as any).nodeProfile = undefined;
+            handler.sshProfile = undefined;
+            handler.isSshRequiredForProf = false;
+            handler.sshCwd = "/tmp";
+            const argProf: imperative.IProfileLoaded = {
+                name: "fallbackArgProfile",
+                type: "zosmf",
+                profile: { user: "argUser" },
+                message: "",
+                failNotFound: false,
+            };
+            const out = handler.formatCommandLine("pwd", argProf);
+            expect(out).toBe("> argUser@fallbackArgProfile:/tmp $ pwd");
+        });
+
+        it("after runCommand clears state, formatCommandLine no longer shows the previously-selected SSH profile name", async () => {
+            const handler = getUnixActions();
+            (handler as any).nodeProfile = nodeProf;
+            handler.sshProfile = sshProf;
+            handler.sshCwd = "/u/dir";
+            const issueUnixCommandMock = jest.fn().mockResolvedValue("ok");
+            const getCommandApiSpy = jest
+                .spyOn(ZoweExplorerApiRegister, "getCommandApi")
+                .mockReturnValue({ issueUnixCommand: issueUnixCommandMock } as any);
+            try {
+                await handler.runCommand(sshProf, "ls");
+
+
+
+                const followUpProf: imperative.IProfileLoaded = {
+                    name: "followUpProfile",
+                    type: "zosmf",
+                    profile: { user: "followUpUser" },
+                    message: "",
+                    failNotFound: false,
+                };
+                const out = handler.formatCommandLine("ls", followUpProf);
+                expect(out).toBe("> followUpUser@followUpProfile:/u/dir $ ls");
+                expect(out).not.toContain("selectedSshProfile");
+            } finally {
+                getCommandApiSpy.mockRestore();
+            }
+        });
+    });
 });
