diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,288 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+fail() {
+  echo "FAIL: $*" >&2
+  exit 1
+}
+
+assert_empty_file() {
+  local path=$1
+  local label=$2
+  [ ! -s "$path" ] || fail "$label not empty: $(cat "$path")"
+}
+
+assert_output_capture_files_exist() {
+  local stdout=$1
+  local stderr=$2
+  local label=$3
+
+
+  [ -e "$stdout" ] || fail "$label stdout capture missing"
+  [ -e "$stderr" ] || fail "$label stderr capture missing"
+}
+
+assert_file_eq() {
+  local expected=$1
+  local actual=$2
+  local label=$3
+  if ! cmp -s "$expected" "$actual"; then
+    echo "FAIL: $label mismatch" >&2
+    diff -u "$expected" "$actual" >&2 || true
+    exit 1
+  fi
+}
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || fail "cd tmp"
+
+PYSHIM="$TMP/pyshim"
+mkdir -p "$PYSHIM/tensorflow/compat/v1" || fail "mkdir pyshim"
+
+cat >"$PYSHIM/sitecustomize.py" <<'PY'
+try:
+    import nltk
+    def _sent_tokenize(text):
+        text = text.strip()
+        return [text] if text else []
+    def _word_tokenize(text):
+        return text.split()
+    nltk.sent_tokenize = _sent_tokenize
+    nltk.word_tokenize = _word_tokenize
+except Exception:
+    pass
+PY
+
+cat >"$PYSHIM/tqdm.py" <<'PY'
+def tqdm(iterable, *args, **kwargs):
+    return iterable
+PY
+
+cat >"$PYSHIM/tensorflow/__init__.py" <<'PY'
+import os
+class _App(object):
+    def run(self, main=None, argv=None):
+        if main:
+            return main(None)
+app = _App()
+class _GFile(object):
+    GFile = staticmethod(open)
+    Open = staticmethod(open)
+    Exists = staticmethod(os.path.exists)
+    exists = staticmethod(os.path.exists)
+    IsDirectory = staticmethod(os.path.isdir)
+    isdir = staticmethod(os.path.isdir)
+    MakeDirs = staticmethod(os.makedirs)
+    MkDir = staticmethod(os.mkdir)
+gfile = _GFile()
+class _IO(object):
+    gfile = gfile
+io = _IO()
+PY
+
+cat >"$PYSHIM/tensorflow/compat/__init__.py" <<'PY'
+PY
+
+cat >"$PYSHIM/tensorflow/compat/v1/__init__.py" <<'PY'
+import os
+class _App(object):
+    def run(self, main=None, argv=None):
+        if main:
+            return main(None)
+app = _App()
+class _GFile(object):
+    GFile = staticmethod(open)
+    Open = staticmethod(open)
+    Exists = staticmethod(os.path.exists)
+    exists = staticmethod(os.path.exists)
+    IsDirectory = staticmethod(os.path.isdir)
+    isdir = staticmethod(os.path.isdir)
+    MakeDirs = staticmethod(os.makedirs)
+    MkDir = staticmethod(os.mkdir)
+gfile = _GFile()
+class _IO(object):
+    gfile = gfile
+io = _IO()
+PY
+
+export PYTHONPATH="$PYSHIM:/workspace/repo${PYTHONPATH:+:$PYTHONPATH}"
+
+( cd /workspace/repo && python3 -m compileall -q airdialogue ) || fail "build"
+BIN=/workspace/repo/airdialogue/bin/airdialogue
+[ -f "$BIN" ] || fail "missing CLI entry point"
+
+run_prepro() {
+  python3 "$BIN" prepro "$@"
+}
+
+write_main_data() {
+  cat >main_data.jsonl <<'JSON'
+   
+{"correct_sample": true, "intent": {"departure_airport": "SFO", "return_airport": "LAX", "departure_month": "jan", "return_month": "feb", "departure_day": 1, "return_day": 2, "departure_time": "morning", "return_time": "evening", "name": "Ada Lovelace", "class": "economy", "max_price": 500, "max_connections": 0, "airline_preference": "delta", "goal": "book"}, "dialogue": ["customer: hello agent", "agent: flight ready"]}
+{"correct_sample": false, "intent": {"departure_airport": "NYC", "return_airport": "BOS", "departure_month": "mar", "return_month": "apr", "departure_day": 3, "return_day": 4, "departure_time": "all", "return_time": "all", "name": "Grace Hopper", "class": "business", "max_price": 700, "max_connections": 1, "airline_preference": "united", "goal": "change"}, "dialogue": ["customer: skip me"]}
+JSON
+  printf '%b\n' '{"intent": {"departure_airport": "SEA", "return_airport": "DEN", "departure_month": "may", "return_month": "jun", "departure_day": 5, "return_day": 6, "departure_time": "afternoon", "return_time": "morning", "name": "Zo\xc3\xab Ray", "class": "first", "max_price": 900, "max_connections": 2, "airline_preference": "all", "goal": "cancel"}, "dialogue": ["customer: caf\xc3\xa9 please"]}' >>main_data.jsonl
+
+  cat >main_kb.jsonl <<'JSON'
+{"reservation": 1, "kb": [{"departure_airport":"SFO","return_airport":"LAX","departure_month":"jan","return_month":"feb","departure_day":1,"return_day":2,"departure_time_num":"0900","return_time_num":"1700","class":"economy","price":450,"num_connections":0,"airline":"delta","flight_number":101}]}
+{"reservation": 0, "kb": []}
+JSON
+  printf '%b\n' '{"reservation": 1, "kb": [{"departure_airport":"SEA","return_airport":"DEN","departure_month":"may","return_month":"jun","departure_day":5,"return_day":6,"departure_time_num":"1200","return_time_num":"0800","class":"first","price":880,"num_connections":2,"airline":"\xc3\xa5lpha","flight_number":303}]}' >>main_kb.jsonl
+}
+
+write_empty_data() {
+  cat >empty_data.jsonl <<'JSON'
+{"correct_sample": true, "intent": {"departure_airport": "A", "return_airport": "B", "departure_month": "jul", "return_month": "aug", "departure_day": 7, "return_day": 8, "departure_time": "all", "return_time": "all", "name": "Empty Case", "class": "economy", "max_price": 100, "max_connections": 0, "airline_preference": "all", "goal": "book"}, "dialogue": []}
+JSON
+}
+
+write_padding_data() {
+  cat >pad_data.jsonl <<'JSON'
+{"correct_sample": true, "intent": {"departure_airport": "A", "return_airport": "B", "departure_month": "one", "return_month": "two", "departure_day": 1, "return_day": 2, "departure_time": "all", "return_time": "all", "name": "Pad First", "class": "economy", "max_price": 10, "max_connections": 0, "airline_preference": "all", "goal": "book"}, "dialogue": ["customer: first"]}
+{"correct_sample": false, "intent": {"departure_airport": "C", "return_airport": "D", "departure_month": "three", "return_month": "four", "departure_day": 3, "return_day": 4, "departure_time": "all", "return_time": "all", "name": "Pad Skip", "class": "economy", "max_price": 20, "max_connections": 0, "airline_preference": "all", "goal": "book"}, "dialogue": ["customer: skip"]}
+{"correct_sample": true, "intent": {"departure_airport": "E", "return_airport": "F", "departure_month": "five", "return_month": "six", "departure_day": 5, "return_day": 6, "departure_time": "all", "return_time": "all", "name": "Pad Last", "class": "economy", "max_price": 30, "max_connections": 0, "airline_preference": "all", "goal": "book"}, "dialogue": ["customer: last"]}
+JSON
+  cat >pad_kb.jsonl <<'JSON'
+{"reservation": 0, "kb": []}
+   
+{"reservation": 0, "kb": []}
+{"reservation": 0, "kb": []}
+JSON
+}
+
+
+
+
+run_prepro --help >help.out 2>help.err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F_help exit $ec; want 0"
+grep -q -- '--infer_src_data_file' help.out || fail "F_help missing --infer_src_data_file"
+grep -q -- '--infer_kb_file' help.out || fail "F_help missing --infer_kb_file"
+grep -q -- '--self_play_start_turn' help.out || fail "F_help missing --self_play_start_turn"
+assert_output_capture_files_exist help.out help.err "F_help"
+
+
+
+
+
+
+
+
+
+write_main_data
+run_prepro --job_type '0|0|1|0|0' --input_type dialogue --output_dir out_default --output_prefix dev --infer_src_data_file main_data.jsonl --infer_kb_file main_kb.jsonl >default.out 2>default.err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F_default exit $ec; want 0"
+[ -d out_default ] || fail "F_default output dir not created"
+assert_output_capture_files_exist default.out default.err "F_default"
+[ -f out_default/dev.infer.src.data ] || fail "F_default missing infer src data"
+[ -f out_default/dev.infer.kb ] || fail "F_default missing infer kb"
+[ ! -e out_default/dev.infer.tar.data ] || fail "F_default created infer tar data"
+cat >expected_default_src <<'EOF_EXPECTED'
+<a1_SFO> <a2_LAX> <m1_jan> <m2_feb> <d1_1> <d2_2> <t1_morning> <t2_evening> Ada Lovelace <cl_economy> <pr_500> <cn_0> <al_delta> <gl_book>|<t1> hello agent <t2> flight ready <t1>
+<a1_SEA> <a2_DEN> <m1_may> <m2_jun> <d1_5> <d2_6> <t1_afternoon> <t2_morning> Zo Ray <cl_first> <pr_900> <cn_2> <al_all> <gl_cancel>|<t1> caf please <t2>
+EOF_EXPECTED
+cat >expected_default_kb <<'EOF_EXPECTED'
+<res_has_res> <a1_SFO> <a2_LAX> <m1_jan> <m2_feb> <d1_1> <d2_2> <tn1_0900> <tn2_1700> <cl_economy> <pr_450> <cn_0> <al_delta> <fl_101>
+<res_has_res> <a1_SEA> <a2_DEN> <m1_may> <m2_jun> <d1_5> <d2_6> <tn1_1200> <tn2_0800> <cl_first> <pr_880> <cn_2> <al_lpha> <fl_303>
+EOF_EXPECTED
+assert_file_eq expected_default_src out_default/dev.infer.src.data "F_default src"
+assert_file_eq expected_default_kb out_default/dev.infer.kb "F_default kb"
+
+
+
+
+run_prepro --job_type '0|0|1|0|0' --input_type dialogue --output_dir out_keep --output_prefix dev --infer_src_data_file main_data.jsonl --infer_kb_file main_kb.jsonl --keep_incorrect true >keep.out 2>keep.err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F_keep_incorrect exit $ec; want 0"
+assert_output_capture_files_exist keep.out keep.err "F_keep_incorrect"
+cat >expected_keep_src <<'EOF_EXPECTED'
+<a1_SFO> <a2_LAX> <m1_jan> <m2_feb> <d1_1> <d2_2> <t1_morning> <t2_evening> Ada Lovelace <cl_economy> <pr_500> <cn_0> <al_delta> <gl_book>|<t1> hello agent <t2> flight ready <t1>
+<a1_NYC> <a2_BOS> <m1_mar> <m2_apr> <d1_3> <d2_4> <t1_all> <t2_all> Grace Hopper <cl_business> <pr_700> <cn_1> <al_united> <gl_change>|<t1> skip me <t2>
+<a1_SEA> <a2_DEN> <m1_may> <m2_jun> <d1_5> <d2_6> <t1_afternoon> <t2_morning> Zo Ray <cl_first> <pr_900> <cn_2> <al_all> <gl_cancel>|<t1> caf please <t2>
+EOF_EXPECTED
+cat >expected_keep_kb <<'EOF_EXPECTED'
+<res_has_res> <a1_SFO> <a2_LAX> <m1_jan> <m2_feb> <d1_1> <d2_2> <tn1_0900> <tn2_1700> <cl_economy> <pr_450> <cn_0> <al_delta> <fl_101>
+<res_no_res> 
+<res_has_res> <a1_SEA> <a2_DEN> <m1_may> <m2_jun> <d1_5> <d2_6> <tn1_1200> <tn2_0800> <cl_first> <pr_880> <cn_2> <al_lpha> <fl_303>
+EOF_EXPECTED
+assert_file_eq expected_keep_src out_keep/dev.infer.src.data "F_keep_incorrect src"
+assert_file_eq expected_keep_kb out_keep/dev.infer.kb "F_keep_incorrect kb"
+[ ! -e out_keep/dev.infer.tar.data ] || fail "F_keep_incorrect created infer tar data"
+
+
+
+
+
+write_empty_data
+run_prepro --job_type '0|0|1|0|0' --input_type dialogue --output_dir out_missing_agent --output_prefix dev --infer_src_data_file empty_data.jsonl --infer_kb_file absent-kb.jsonl --self_play_start_turn agent >missing_agent.out 2>missing_agent.err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F_missing_kb_agent exit $ec; want 0"
+assert_output_capture_files_exist missing_agent.out missing_agent.err "F_missing_kb_agent"
+cat >expected_missing_agent_src <<'EOF_EXPECTED'
+<a1_A> <a2_B> <m1_jul> <m2_aug> <d1_7> <d2_8> <t1_all> <t2_all> Empty Case <cl_economy> <pr_100> <cn_0> <al_all> <gl_book>|<t2>
+EOF_EXPECTED
+cat >expected_missing_kb <<'EOF_EXPECTED'
+no_res
+EOF_EXPECTED
+assert_file_eq expected_missing_agent_src out_missing_agent/dev.infer.src.data "F_missing_kb_agent src"
+assert_file_eq expected_missing_kb out_missing_agent/dev.infer.kb "F_missing_kb_agent kb"
+
+
+
+
+run_prepro --job_type '0|0|1|0|0' --input_type dialogue --output_dir out_missing_customer --output_prefix dev --infer_src_data_file empty_data.jsonl --infer_kb_file absent-kb.jsonl --self_play_start_turn customer >missing_customer.out 2>missing_customer.err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F_missing_kb_customer exit $ec; want 0"
+assert_output_capture_files_exist missing_customer.out missing_customer.err "F_missing_kb_customer"
+cat >expected_missing_customer_src <<'EOF_EXPECTED'
+<a1_A> <a2_B> <m1_jul> <m2_aug> <d1_7> <d2_8> <t1_all> <t2_all> Empty Case <cl_economy> <pr_100> <cn_0> <al_all> <gl_book>|<t1>
+EOF_EXPECTED
+assert_file_eq expected_missing_customer_src out_missing_customer/dev.infer.src.data "F_missing_kb_customer src"
+assert_file_eq expected_missing_kb out_missing_customer/dev.infer.kb "F_missing_kb_customer kb"
+
+
+
+
+write_padding_data
+run_prepro --job_type '0|0|1|0|0' --input_type dialogue --output_dir out_pad --output_prefix pad --infer_src_data_file pad_data.jsonl --infer_kb_file pad_kb.jsonl >pad.out 2>pad.err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F_kb_padding exit $ec; want 0"
+assert_output_capture_files_exist pad.out pad.err "F_kb_padding"
+cat >expected_pad_src <<'EOF_EXPECTED'
+<a1_A> <a2_B> <m1_one> <m2_two> <d1_1> <d2_2> <t1_all> <t2_all> Pad First <cl_economy> <pr_10> <cn_0> <al_all> <gl_book>|<t1> first <t2>
+<a1_E> <a2_F> <m1_five> <m2_six> <d1_5> <d2_6> <t1_all> <t2_all> Pad Last <cl_economy> <pr_30> <cn_0> <al_all> <gl_book>|<t1> last <t2>
+EOF_EXPECTED
+cat >expected_pad_kb <<'EOF_EXPECTED'
+<res_no_res> 
+<res_no_res> 
+EOF_EXPECTED
+assert_file_eq expected_pad_src out_pad/pad.infer.src.data "F_kb_padding src"
+assert_file_eq expected_pad_kb out_pad/pad.infer.kb "F_kb_padding kb"
+
+
+
+
+cat >bad_source.jsonl <<'JSON'
+{"correct_sample": true, "intent": 
+JSON
+run_prepro --job_type '0|0|1|0|0' --input_type dialogue --output_dir out_bad --output_prefix dev --infer_src_data_file bad_source.jsonl --infer_kb_file absent-kb.jsonl >bad.out 2>bad.err
+ec=$?
+[ "$ec" -ne 0 ] || fail "F_malformed_source exit 0; want non-zero"
+
+
+
+
+
+
+run_prepro --job_type '0|0|1|0|0' --input_type dialogue --output_dir out_missing_source --output_prefix dev --infer_src_data_file no-such-source.jsonl --infer_kb_file absent-kb.jsonl >missing_source.out 2>missing_source.err
+ec=$?
+[ "$ec" -ne 0 ] || fail "F_missing_source exit 0; want non-zero"
+
+
+
+echo "PASS"
+exit 0
