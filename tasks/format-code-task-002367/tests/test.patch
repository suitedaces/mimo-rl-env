diff --git a/tests/test_merge_writer_over.py b/tests/test_merge_writer_over.py
new file mode 100644
index 00000000..82c8f15e
--- /dev/null
+++ b/tests/test_merge_writer_over.py
@@ -0,0 +1,118 @@
+
+
+
+
+
+
+
+
+from io import BytesIO
+from pathlib import Path
+
+import pytest
+
+from pypdf import PdfReader, PdfWriter, Transformation
+
+TESTS_ROOT = Path(__file__).parent.resolve()
+PROJECT_ROOT = TESTS_ROOT.parent
+RESOURCE_ROOT = PROJECT_ROOT / "resources"
+
+
+BASE_PDF = RESOURCE_ROOT / "crazyones.pdf"
+
+OVERLAY_PDF = RESOURCE_ROOT / "AutoCad_Simple.pdf"
+
+BASE_MARKER = "Crazy"
+OVERLAY_MARKER = "EXAMPLE"
+
+
+def _write_read_text(writer: PdfWriter) -> str:
+
+    buf = BytesIO()
+    writer.write(buf)
+    buf.seek(0)
+    return PdfReader(buf).pages[0].extract_text()
+
+
+def test_merge_into_writer_blank_page_keeps_content():
+
+
+    reader = PdfReader(BASE_PDF)
+    src = reader.pages[0]
+
+    writer = PdfWriter()
+    page = writer.add_blank_page(src.mediabox.width, src.mediabox.height)
+    page.merge_page(src)
+
+    text = _write_read_text(writer)
+    assert BASE_MARKER in text
+
+
+def test_merge_transformed_page_is_not_deprecated():
+
+
+    base = PdfReader(BASE_PDF).pages[0]
+    overlay = PdfReader(OVERLAY_PDF).pages[0]
+
+    writer = PdfWriter()
+    page = writer.add_page(base)
+
+    page.merge_transformed_page(overlay, Transformation())
+
+    text = _write_read_text(writer)
+    assert BASE_MARKER in text
+    assert OVERLAY_MARKER in text
+
+
+def test_merge_transformed_page_over_true_default():
+
+
+    base = PdfReader(BASE_PDF).pages[0]
+    overlay = PdfReader(OVERLAY_PDF).pages[0]
+
+    writer = PdfWriter()
+    page = writer.add_page(base)
+    page.merge_transformed_page(overlay, Transformation())
+
+    text = _write_read_text(writer)
+    assert text.index(BASE_MARKER) < text.index(OVERLAY_MARKER)
+
+
+def test_merge_transformed_page_over_false_places_under():
+
+
+    base = PdfReader(BASE_PDF).pages[0]
+    overlay = PdfReader(OVERLAY_PDF).pages[0]
+
+    writer = PdfWriter()
+    page = writer.add_page(base)
+    page.merge_transformed_page(overlay, Transformation(), over=False)
+
+    text = _write_read_text(writer)
+    assert text.index(OVERLAY_MARKER) < text.index(BASE_MARKER)
+
+
+def test_over_parameter_flips_layer_order():
+
+
+    base = PdfReader(BASE_PDF).pages[0]
+    overlay = PdfReader(OVERLAY_PDF).pages[0]
+
+    w_over = PdfWriter()
+    p_over = w_over.add_page(base)
+    p_over.merge_transformed_page(overlay, Transformation(), over=True)
+    t_over = _write_read_text(w_over)
+
+    w_under = PdfWriter()
+    p_under = w_under.add_page(base)
+    p_under.merge_transformed_page(overlay, Transformation(), over=False)
+    t_under = _write_read_text(w_under)
+
+
+    for t in (t_over, t_under):
+        assert BASE_MARKER in t
+        assert OVERLAY_MARKER in t
+
+
+    assert t_over.index(BASE_MARKER) < t_over.index(OVERLAY_MARKER)
+    assert t_under.index(OVERLAY_MARKER) < t_under.index(BASE_MARKER)
