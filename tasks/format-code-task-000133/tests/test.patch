+      expect(response.body).toBe(new Buffer('tls-vhost-response').toString('base64'));
+    } finally {
+      dns.lookup = originalLookup;
+      if (server) {
+        server.close();
+      }
+    }
+  });
+
+  it('keeps cookie jar state across redirects and writes response cookies back', async () => {
+    const originalLookup = dns.lookup;
+    let server;
+    const loopback = await new Promise((resolve, reject) => {
+      originalLookup('127.0.0.1', (err, address, family) => err ? reject(err) : resolve({address, family}));
+    });
+    dns.lookup = (hostname, options, callback) => {
+      const cb = typeof options === 'function' ? options : callback;
+      const wantsAll = options && options.all;
+      const result = {address: '127.0.0.1', family: loopback.family};
+
+      if (wantsAll) {
+        cb(null, [result]);
+      } else {
+        cb(null, result.address, result.family);
+      }
+    };
+
+    try {
+      const workspace = await models.workspace.create();
+      const settings = await models.settings.create();
+      const nonce = `${Date.now()}${Math.floor(Math.random() * 100000)}`;
+      const seedName = `seed_${nonce}`;
+      const seedValue = `seed-value-${nonce}`;
+      const redirectName = `redirect_${nonce}`;
+      const redirectValue = `redirect-value-${nonce}`;
+
+      const cookieJar = await models.cookieJar.create({
+        parentId: workspace._id,
+        cookies: [
+          {
+            key: seedName,
+            value: seedValue,
+            domain: 'cookie-flow.insomnia.test',
+            path: '/',
+            secure: false,
+            httpOnly: false,
+            expires: new Date('2096-10-12T04:40:49.000Z'),
+          },
+        ],
+      });
+
+      let firstHopCookie = '';
+      let secondHopCookie = '';
+      server = await new Promise(resolve => {
+        const s = http.createServer((req, res) => {
+          if (req.url === '/start') {
+            firstHopCookie = req.headers.cookie || '';
+            if (!firstHopCookie.includes(`${seedName}=${seedValue}`)) {
+              res.writeHead(400);
+              res.end('missing-seed-cookie');
+              return;
+            }
+
+            res.writeHead(302, {
+              Location: '/after-redirect',
+              'Set-Cookie': `${redirectName}=${redirectValue}; Path=/`,
+            });
+            res.end();
+          } else if (req.url === '/after-redirect') {
+            secondHopCookie = req.headers.cookie || '';
+            if (
+              secondHopCookie.includes(`${seedName}=${seedValue}`) &&
+              secondHopCookie.includes(`${redirectName}=${redirectValue}`)
+            ) {
+              res.writeHead(200);
+              res.end('redirected-cookie-ok');
+            } else {
+              res.writeHead(400);
+              res.end('missing-redirect-cookie');
+            }
+          } else {
+            res.writeHead(404);
+            res.end('not-found');
+          }
+        });
+
+        s.listen(0, '127.0.0.1', () => resolve(s));
+      });
+
+      const port = server.address().port;
+
+      const request = await models.request.create({
+        parentId: workspace._id,
+        method: 'GET',
+        url: `http://cookie-flow.insomnia.test:${port}/start`,
+      });
+
+      const response = await networkUtils._actuallySend(
+        await getRenderedRequest(request),
+        workspace,
+        settings
+      );
+
+      const updatedJar = await models.cookieJar.getById(cookieJar._id);
+      const storedCookie = updatedJar.cookies.find(cookie => cookie.key === redirectName);
+
+      expect(firstHopCookie).toContain(`${seedName}=${seedValue}`);
+      expect(secondHopCookie).toContain(`${seedName}=${seedValue}`);
+      expect(secondHopCookie).toContain(`${redirectName}=${redirectValue}`);
+      expect(response.error).toBe('');
+      expect(response.body).toBe(new Buffer('redirected-cookie-ok').toString('base64'));
+      expect(storedCookie).toBeTruthy();
+      expect(storedCookie.value).toBe(redirectValue);
+    } finally {
+      dns.lookup = originalLookup;
+      if (server) {
+        server.close();
+      }
+    }
+  });
 });
