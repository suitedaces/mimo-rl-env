+      )));
+
+      server = await new Promise(resolve => {
+        const s = https.createServer({key, cert}, (req, res) => {
+          const host = req.headers.host || '';
+          const servername = req.socket.servername || '';
+
+          if (
+            req.url === '/secure-host-check' &&
+            /^tls\.insomnia\.test:/.test(host) &&
+            servername === 'tls.insomnia.test'
+          ) {
+            res.writeHead(200);
+            res.end('tls-vhost-response');
+          } else {
+            res.writeHead(421);
+            res.end(`wrong-tls-vhost:${host}:${servername}`);
+          }
+        });
+
+        s.listen(0, '127.0.0.1', () => resolve(s));
+      });
+
+      const port = server.address().port;
