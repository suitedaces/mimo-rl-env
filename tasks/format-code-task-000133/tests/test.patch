+++ b/mimo_test_command.sh
@@ -0,0 +1,31 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+dev-switch node 20 2>/dev/null || true
+
+if [ ! -d node_modules ]; then
+  cp package.json /tmp/package.json.orig
+  sed -i 's|"httpsnippet": "git@github.com:getinsomnia/httpsnippet.git#a3a2c0a0167fa844bf92df52a1442fa1d68a9053"|"httpsnippet": "2.0.0"|' package.json
+  sed -i 's|"srp": "git@github.com:getinsomnia/srp-js.git#6ebd8c3acfbcf69645e4c6e6f8f6b55138ff22c3"|"srp": "0.2.0"|' package.json
+  git config --global url."https://github.com/".insteadOf "git@github.com:" 2>/dev/null || true
+  npm install --legacy-peer-deps --ignore-scripts
+  cp /tmp/package.json.orig package.json
+fi
+
+
+case "${1:-}" in
+  base)
+    npx jest --silent --testPathPattern="app/common/__tests__/network\\.test\\.js" \
+      --testNamePattern="builds a default config|builds a complex config"
+    ;;
+  new)
+    npx jest --silent --testPathPattern="app/common/__tests__/network\\.test\\.js" \
+      --testNamePattern="does something|sends a file|sends multipart form data|preserves the requested hostname for virtual-host routing|preserves the requested hostname for HTTPS virtual-host routing|keeps cookie jar state across redirects and writes response cookies back"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
