+  it('preserves the requested hostname for HTTPS virtual-host routing', async () => {
+    const originalLookup = dns.lookup;
+    let server;
+    const loopback = await new Promise((resolve, reject) => {
+      originalLookup('127.0.0.1', (err, address, family) => err ? reject(err) : resolve({address, family}));
+    });
+    dns.lookup = (hostname, options, callback) => {
+      const cb = typeof options === 'function' ? options : callback;
+      const wantsAll = options && options.all;
+      const result = {address: '127.0.0.1', family: loopback.family};
+
+      if (wantsAll) {
+        cb(null, [result]);
+      } else {
+        cb(null, result.address, result.family);
+      }
+    };
+
+    try {
+      const workspace = await models.workspace.create();
+      const settings = await models.settings.create({validateSSL: false});
+      await models.cookieJar.create({parentId: workspace._id});
+
+      const key = fs.readFileSync(pathResolve(pathJoin(
+        __dirname,
