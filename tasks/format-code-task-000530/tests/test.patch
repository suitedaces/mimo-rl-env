diff --git a/tests/basilisp/core_test.py b/tests/basilisp/core_test.py
index 1432407..f658326 100644
--- a/tests/basilisp/core_test.py
+++ b/tests/basilisp/core_test.py
@@ -471,6 +471,72 @@ def test_sort():
     assert llist.l(1, 2, 3, 4, 5) == core.sort(vec.v(5, 3, 1, 2, 4))
 
 
+_EMPTY_LIST = llist.PersistentList.empty()
+
+
+def test_sort_none_returns_empty_seq():
+
+    result = core.sort(None)
+    assert result is not None
+    assert _EMPTY_LIST == result
+
+
+def test_sort_of_seq_on_empty_vector_returns_empty_seq():
+
+
+    empty_seq = core.seq(vec.PersistentVector.empty())
+    assert empty_seq is None
+    result = core.sort(empty_seq)
+    assert _EMPTY_LIST == result
+
+
+def test_sort_of_empty_map_returns_empty_seq():
+
+    result = core.sort(lmap.PersistentMap.empty())
+    assert _EMPTY_LIST == result
+
+
+def test_sort_of_empty_vector_returns_empty_seq():
+
+    result = core.sort(vec.PersistentVector.empty())
+    assert _EMPTY_LIST == result
+
+
+def test_sort_non_empty_preserved():
+
+    assert llist.l(1, 2, 3, 4, 5) == core.sort(vec.v(5, 3, 1, 2, 4))
+
+
+def test_sort_by_none_returns_empty_seq():
+    result = core.sort_by(lambda x: x, None)
+    assert result is not None
+    assert _EMPTY_LIST == result
+
+
+def test_sort_by_of_seq_on_empty_vector_returns_empty_seq():
+    empty_seq = core.seq(vec.PersistentVector.empty())
+    assert empty_seq is None
+    result = core.sort_by(lambda x: x, empty_seq)
+    assert _EMPTY_LIST == result
+
+
+def test_sort_by_of_empty_map_returns_empty_seq():
+    result = core.sort_by(lambda x: x, lmap.PersistentMap.empty())
+    assert _EMPTY_LIST == result
+
+
+def test_sort_by_of_empty_vector_returns_empty_seq():
+    result = core.sort_by(lambda x: x, vec.PersistentVector.empty())
+    assert _EMPTY_LIST == result
+
+
+def test_sort_by_non_empty_preserved():
+
+    assert llist.l(1, 2, 3, 4, 5) == core.sort_by(
+        lambda x: x, vec.v(5, 3, 1, 2, 4)
+    )
+
+
 class TestIsAny:
