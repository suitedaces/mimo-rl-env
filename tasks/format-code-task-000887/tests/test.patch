diff --git a/tests/acls_test.py b/tests/acls_test.py
new file mode 100644
index 00000000..cf8e9e18
--- /dev/null
+++ b/tests/acls_test.py
@@ -0,0 +1,91 @@
+
+
+
+
+
+
+import pytest
+
+from errbot.core_plugins.acls import glob, ciglob
+
+
+
+
+def test_glob_int_text_wildcard_pattern_matches():
+
+    assert glob(123456, "*") is True
+
+
+def test_glob_int_text_exact_str_pattern_matches():
+
+    assert glob(123456, "123456") is True
+
+
+def test_glob_int_text_str_pattern_no_match():
+
+    assert glob(123456, "999") is False
+
+
+def test_glob_int_text_str_pattern_prefix_wildcard():
+
+    assert glob(123456, "123*") is True
+
+
+def test_glob_int_text_list_of_str_patterns_match():
+
+    assert glob(123, ["456", "123"]) is True
+
+
+def test_glob_int_text_list_of_str_patterns_no_match():
+
+    assert glob(123, ["456", "789"]) is False
+
+
+
+
+def test_glob_str_text_int_pattern_in_list_matches():
+
+    assert glob("123", [123]) is True
+
+
+def test_glob_int_text_int_pattern_in_list_matches():
+
+    assert glob(123, [123]) is True
+
+
+def test_glob_int_text_int_pattern_in_list_no_match():
+
+    assert glob(123, [456]) is False
+
+
+
+
+def test_glob_str_text_str_pattern_match():
+    assert glob("alice", "alice") is True
+
+
+def test_glob_str_text_str_pattern_no_match():
+    assert glob("alice", "bob") is False
+
+
+def test_glob_str_text_str_pattern_wildcard():
+    assert glob("alice", "a*") is True
+
+
+def test_glob_str_text_list_str_patterns():
+    assert glob("alice", ["bob", "alice"]) is True
+    assert glob("alice", ["bob", "carol"]) is False
+
+
+
+
+def test_ciglob_str_str_case_insensitive_match():
+    assert ciglob("ALICE", "alice") is True
+
+
+def test_ciglob_str_str_case_insensitive_pattern_upper():
+    assert ciglob("alice", "ALICE") is True
+
+
+def test_ciglob_str_str_no_match():
+    assert ciglob("alice", "bob") is False
