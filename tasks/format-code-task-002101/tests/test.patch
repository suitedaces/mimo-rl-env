+func TestMultiSearchBuildsTwoRequestBatchWithDefaultIndexAndQueryOptions(t *testing.T) {
+
+
+	var gotMethod, gotPath, gotBody string
+	var gotQuery url.Values
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotMethod = r.Method
+		gotPath = r.URL.Path
+		gotQuery = r.URL.Query()
+		b, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("ReadAll(request body) error = %v", err)
+		}
+		gotBody = string(b)
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"took":17,"responses":[{"took":5,"timed_out":false,"hits":{"total":{"value":2,"relation":"eq"},"hits":[]},"status":200},{"took":7,"timed_out":true,"hits":{"total":{"value":4,"relation":"gte"},"hits":[]},"status":206}]}`)
+	}))
+	defer ts.Close()
+
+	client := newClient(t, ts.URL)
+	req1 := elastic.NewSearchRequest().Source(`{"query":{"match_all":{}},"size":1}`)
+	req2 := elastic.NewSearchRequest().
+		Index("explicit-a", "explicit-b").
+		Routing("r-9").
+		RequestCache(true).
+		Source(`{"query":{"term":{"level":"error"}}}`)
+
+	result, err := client.MultiSearch().
+		Add(req1, req2).
+		Index("logs").
+		Pretty(true).
+		Human(false).
+		ErrorTrace(true).
+		FilterPath("responses.hits", "took").
+		MaxConcurrentSearches(3).
+		PreFilterShardSize(11).
+		Do(context.Background())
+	if err != nil {
+		t.Fatalf("MultiSearch Do() error = %v", err)
+	}
+
+	if gotMethod != "GET" {
+		t.Fatalf("request method = %q, want %q", gotMethod, "GET")
+	}
+	if gotPath != "/_msearch" {
+		t.Fatalf("request path = %q, want %q", gotPath, "/_msearch")
+	}
+	if gotQuery.Get("pretty") != "true" {
+		t.Fatalf("query pretty = %q, want %q", gotQuery.Get("pretty"), "true")
+	}
+	if gotQuery.Get("human") != "false" {
+		t.Fatalf("query human = %q, want %q", gotQuery.Get("human"), "false")
+	}
+	if gotQuery.Get("error_trace") != "true" {
+		t.Fatalf("query error_trace = %q, want %q", gotQuery.Get("error_trace"), "true")
+	}
+	if gotQuery.Get("filter_path") != "responses.hits,took" {
+		t.Fatalf("query filter_path = %q, want %q", gotQuery.Get("filter_path"), "responses.hits,took")
+	}
+	if gotQuery.Get("max_concurrent_searches") != "3" {
+		t.Fatalf("query max_concurrent_searches = %q, want %q", gotQuery.Get("max_concurrent_searches"), "3")
+	}
+	if gotQuery.Get("pre_filter_shard_size") != "11" {
+		t.Fatalf("query pre_filter_shard_size = %q, want %q", gotQuery.Get("pre_filter_shard_size"), "11")
+	}
+
+
+	bodyLines := splitNDJSONLines(t, gotBody, 4)
+	assertHeaderIndices(t, bodyLines[0], []string{"logs"})
+	assertJSONLineEqual(t, bodyLines[1], `{"query":{"match_all":{}},"size":1}`)
+	assertHeaderIndices(t, bodyLines[2], []string{"explicit-a", "explicit-b"})
+	assertJSONLineEqual(t, bodyLines[3], `{"query":{"term":{"level":"error"}}}`)
+	if result.TookInMillis != 17 {
+		t.Fatalf("result TookInMillis = %d, want %d", result.TookInMillis, int64(17))
+	}
+	if len(result.Responses) != 2 {
+		t.Fatalf("len(result.Responses) = %d, want %d", len(result.Responses), 2)
+	}
+	if result.Responses[0].TookInMillis != 5 {
+		t.Fatalf("response[0] TookInMillis = %d, want %d", result.Responses[0].TookInMillis, int64(5))
+	}
+	if result.Responses[0].TotalHits() != 2 {
+		t.Fatalf("response[0] TotalHits() = %d, want %d", result.Responses[0].TotalHits(), int64(2))
+	}
+	if result.Responses[0].Status != 200 {
+		t.Fatalf("response[0] Status = %d, want %d", result.Responses[0].Status, 200)
+	}
+	if result.Responses[1].TookInMillis != 7 {
+		t.Fatalf("response[1] TookInMillis = %d, want %d", result.Responses[1].TookInMillis, int64(7))
+	}
+	if result.Responses[1].TotalHits() != 4 {
+		t.Fatalf("response[1] TotalHits() = %d, want %d", result.Responses[1].TotalHits(), int64(4))
+	}
+	if result.Responses[1].Status != 206 {
+		t.Fatalf("response[1] Status = %d, want %d", result.Responses[1].Status, 206)
+	}
+	if result.Responses[1].TimedOut != true {
+		t.Fatalf("response[1] TimedOut = %t, want %t", result.Responses[1].TimedOut, true)
+	}
+}
