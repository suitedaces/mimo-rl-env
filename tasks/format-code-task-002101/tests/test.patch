+func assertNDJSONLinesEqual(t *testing.T, got string, wantLines []string) {
+	t.Helper()
+
+	gotLines := splitNDJSONLines(t, got, len(wantLines))
+	for i := range wantLines {
+		assertJSONLineEqual(t, gotLines[i], wantLines[i])
+	}
+}
+
+func splitNDJSONLines(t *testing.T, got string, wantCount int) []string {
+	t.Helper()
+
+	if !strings.HasSuffix(got, "\n") {
+		t.Fatalf("request body %q does not have required trailing newline", got)
+	}
+	gotLines := strings.Split(strings.TrimSuffix(got, "\n"), "\n")
+	if len(gotLines) != wantCount {
+		t.Fatalf("request body line count = %d, want %d; body = %q", len(gotLines), wantCount, got)
+	}
+	return gotLines
+}
+
+func assertJSONLineEqual(t *testing.T, got string, want string) {
+	t.Helper()
+
+	gotJSON := decodeJSONLine(t, got, "got")
+	wantJSON := decodeJSONLine(t, want, "want")
+	if !reflect.DeepEqual(gotJSON, wantJSON) {
+		t.Fatalf("request body line = %s, want JSON-equivalent to %s", got, want)
+	}
+}
+
+func assertHeaderIndices(t *testing.T, line string, want []string) {
+	t.Helper()
+
+	raw := decodeJSONLine(t, line, "header")
+	header, ok := raw.(map[string]interface{})
+	if !ok {
+		t.Fatalf("request header line = %s, want JSON object", line)
+	}
+
+	var got []string
+	if v, ok := header["index"]; ok {
+		got = appendIndexValues(t, got, v, "index")
+	}
+	if v, ok := header["indices"]; ok {
+		got = appendIndexValues(t, got, v, "indices")
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("request header indices = %#v, want %#v; line = %s", got, want, line)
+	}
+}
+
+func appendIndexValues(t *testing.T, got []string, value interface{}, field string) []string {
+	t.Helper()
+
+	switch v := value.(type) {
+	case string:
+		return append(got, v)
+	case []interface{}:
+		for _, item := range v {
+			s, ok := item.(string)
+			if !ok {
+				t.Fatalf("request header %s item = %#v, want string", field, item)
+			}
+			got = append(got, s)
+		}
+		return got
+	default:
+		t.Fatalf("request header %s = %#v, want string or string array", field, value)
+		return got
+	}
+}
+
+func decodeJSONLine(t *testing.T, line string, label string) interface{} {
+	t.Helper()
+
+	var v interface{}
+	if err := json.Unmarshal([]byte(line), &v); err != nil {
+		t.Fatalf("%s request body line is invalid JSON: %v; line = %q", label, err, line)
+	}
+	return v
+}
