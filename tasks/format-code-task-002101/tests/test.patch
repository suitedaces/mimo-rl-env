+func TestMultiSearchDoSucceedsAcrossManyCycles(t *testing.T) {
+
+
+	requests := 0
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests++
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, oneResponseBody(1, 1, 200, false))
+	}))
+	defer ts.Close()
+
+
+	for i := 0; i < 10; i++ {
+		result, err := newClient(t, ts.URL).MultiSearch().
+			Add(elastic.NewSearchRequest().Source(`{"query":{"match_all":{}}}`)).
+			Do(context.Background())
+		if err != nil {
+			t.Fatalf("cycle %d Do() error = %v", i, err)
+		}
+		if result.TookInMillis != 1 {
+			t.Fatalf("cycle %d TookInMillis = %d, want %d", i, result.TookInMillis, int64(1))
+		}
+		if len(result.Responses) != 1 {
+			t.Fatalf("cycle %d len(result.Responses) = %d, want %d", i, len(result.Responses), 1)
+		}
+	}
+
+	if requests != 10 {
+		t.Fatalf("server requests = %d, want %d", requests, 10)
+	}
+}
