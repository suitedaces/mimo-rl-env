+func newClient(t *testing.T, serverURL string) *elastic.Client {
+	t.Helper()
+
+	client, err := elastic.NewSimpleClient(elastic.SetURL(serverURL))
+	if err != nil {
+		t.Fatalf("NewSimpleClient() error = %v", err)
+	}
+	return client
+}
+
+func oneResponseBody(took int64, total int64, status int, timedOut bool) string {
+	return fmt.Sprintf(`{"took":%d,"responses":[{"took":5,"timed_out":%t,"hits":{"total":{"value":%d,"relation":"eq"},"hits":[]},"status":%d}]}`,
+		took, timedOut, total, status)
+}
