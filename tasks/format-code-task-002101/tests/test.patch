+func TestMultiSearchAddRetainsStateAcrossSeparateCallsAndRepeatedDo(t *testing.T) {
+
+
+	var bodies []string
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		b, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("ReadAll(request body) error = %v", err)
+		}
+		bodies = append(bodies, string(b))
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"took":9,"responses":[{"took":1,"hits":{"total":{"value":1,"relation":"eq"},"hits":[]},"status":200},{"took":2,"hits":{"total":{"value":2,"relation":"eq"},"hits":[]},"status":200}]}`)
+	}))
+	defer ts.Close()
+
+	service := newClient(t, ts.URL).MultiSearch()
+	service.Add(elastic.NewSearchRequest().Source(`{"query":{"match_all":{}}}`))
+	service.Add(elastic.NewSearchRequest().Source(`{"query":{"term":{"user":"olivere"}}}`))
+
+	first, err := service.Do(context.Background())
+	if err != nil {
+		t.Fatalf("first Do() error = %v", err)
+	}
+	second, err := service.Do(context.Background())
+	if err != nil {
+		t.Fatalf("second Do() error = %v", err)
+	}
+
+	if len(bodies) != 2 {
+		t.Fatalf("captured request bodies = %d, want %d", len(bodies), 2)
+	}
+
+	wantLines := []string{
+		`{}`,
+		`{"query":{"match_all":{}}}`,
+		`{}`,
+		`{"query":{"term":{"user":"olivere"}}}`,
+	}
+	assertNDJSONLinesEqual(t, bodies[0], wantLines)
+	assertNDJSONLinesEqual(t, bodies[1], wantLines)
+	if first.TookInMillis != 9 {
+		t.Fatalf("first TookInMillis = %d, want %d", first.TookInMillis, int64(9))
+	}
+	if second.TookInMillis != 9 {
+		t.Fatalf("second TookInMillis = %d, want %d", second.TookInMillis, int64(9))
+	}
+	if len(second.Responses) != 2 {
+		t.Fatalf("len(second.Responses) = %d, want %d", len(second.Responses), 2)
+	}
+}
