+func TestMultiSearchServicesKeepIndependentBuilderState(t *testing.T) {
+
+
+	var bodies []string
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		b, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("ReadAll(request body) error = %v", err)
+		}
+		bodies = append(bodies, string(b))
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, oneResponseBody(6, 1, 200, false))
+	}))
+	defer ts.Close()
+
+	client := newClient(t, ts.URL)
+	a := client.MultiSearch().Index("logs-a").Add(elastic.NewSearchRequest().Source(`{"query":{"match_all":{}}}`))
+	b := client.MultiSearch().Add(elastic.NewSearchRequest().Source(`{"query":{"term":{"level":"warn"}}}`))
+
+	resultA, err := a.Do(context.Background())
+	if err != nil {
+		t.Fatalf("service a Do() error = %v", err)
+	}
+	resultB, err := b.Do(context.Background())
+	if err != nil {
+		t.Fatalf("service b Do() error = %v", err)
+	}
+
+	if len(bodies) != 2 {
+		t.Fatalf("captured request bodies = %d, want %d", len(bodies), 2)
+	}
+
+	bodyLinesA := splitNDJSONLines(t, bodies[0], 2)
+	assertHeaderIndices(t, bodyLinesA[0], []string{"logs-a"})
+	assertJSONLineEqual(t, bodyLinesA[1], `{"query":{"match_all":{}}}`)
+	assertNDJSONLinesEqual(t, bodies[1], []string{
+		`{}`,
+		`{"query":{"term":{"level":"warn"}}}`,
+	})
+	if resultA.TookInMillis != 6 {
+		t.Fatalf("service a TookInMillis = %d, want %d", resultA.TookInMillis, int64(6))
+	}
+	if resultB.TookInMillis != 6 {
+		t.Fatalf("service b TookInMillis = %d, want %d", resultB.TookInMillis, int64(6))
+	}
+}
