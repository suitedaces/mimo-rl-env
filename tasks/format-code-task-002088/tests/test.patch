diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,253 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+
+PYTHON=/workspace/repo/.venv/bin/python
+[ -x "$PYTHON" ] || fail "missing preinstalled Python venv"
+
+BIN=("$PYTHON" -m ocrmypdf)
+PLUGIN=/workspace/repo/tests/plugins/tesseract_noop.py
+
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || fail "cd temp"
+
+run_ocrmypdf() {
+    "${BIN[@]}" "$@"
+}
+
+pdf_summary() {
+    "$PYTHON" - "$1" <<'PY'
+from decimal import Decimal
+import sys
+import pikepdf
+
+pdf = pikepdf.open(sys.argv[1])
+
+def fmt(value):
+    text = format(value, 'f') if isinstance(value, Decimal) else str(value)
+    return text.rstrip('0').rstrip('.') if '.' in text else text
+
+print(f"pages={len(pdf.pages)}")
+print("mediabox=" + ",".join(fmt(v) for v in pdf.pages[0].MediaBox))
+PY
+}
+
+assert_pdf_layout() {
+    "$PYTHON" - "$1" "$2" "$3" "$4" <<'PY'
+import sys
+import pikepdf
+
+path, expected_width, expected_height, label = sys.argv[1], float(sys.argv[2]), float(sys.argv[3]), sys.argv[4]
+pdf = pikepdf.open(path)
+if len(pdf.pages) != 1:
+    raise SystemExit(f"{label}: pages={len(pdf.pages)}; want 1")
+box = [float(v) for v in pdf.pages[0].MediaBox]
+width = box[2] - box[0]
+height = box[3] - box[1]
+if abs(width - expected_width) > 0.05 or abs(height - expected_height) > 0.05:
+    raise SystemExit(f"{label}: mediabox width={width:.4f} height={height:.4f}; want {expected_width}x{expected_height}")
+PY
+}
+
+require_no_traceback() {
+    ! grep -Fq "Traceback" out err || fail "$1 emitted traceback"
+}
+
+require_err_regex() {
+    local label=$1
+    local pattern=$2
+    grep -Eiq -- "$pattern" err || fail "$label"
+}
+
+"$PYTHON" - "$TMP" <<'PY' || fail "fixture generation"
+from pathlib import Path
+from PIL import Image
+
+root = Path(__import__('sys').argv[1])
+Image.new('RGB', (100, 50), 'white').save(root / 'nodpi_rgb.png')
+Image.new('RGB', (120, 60), 'white').save(root / 'embedded_300.png', dpi=(300, 300))
+Image.new('RGB', (80, 40), 'white').save(root / 'low_30.png', dpi=(30, 30))
+Image.new('RGB', (90, 30), 'white').save(root / 'low_override.png', dpi=(30, 30))
+Image.new('RGB', (64, 32), 'white').save(root / 'stdin_rgb.png')
+Image.new('RGBA', (10, 10), (255, 0, 0, 128)).save(root / 'rgba.png')
+Image.new('LA', (10, 10), (255, 128)).save(root / 'la.png')
+Image.new('CMYK', (10, 10), (0, 255, 255, 0)).save(root / 'cmyk_no_icc.jpg')
+(root / 'empty.bin').write_bytes(b'')
+(root / 'regular_nonimage.bin').write_bytes(b'not a pdf or image\n')
+(root / 'input_dir').mkdir()
+PY
+
+
+
+
+run_ocrmypdf --image-dpi 200 --output-type pdf --plugin "$PLUGIN" \
+    "$TMP/nodpi_rgb.png" "$TMP/f1.pdf" >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+
+require_no_traceback F1
+[ -s "$TMP/f1.pdf" ] || fail "F1 did not create output PDF"
+
+assert_pdf_layout "$TMP/f1.pdf" 36 18 F1 || fail "F1 PDF summary: $(pdf_summary "$TMP/f1.pdf")"
+
+
+
+
+run_ocrmypdf --output-type pdf --plugin "$PLUGIN" \
+    "$TMP/embedded_300.png" "$TMP/f2.pdf" >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+
+require_no_traceback F2
+[ -s "$TMP/f2.pdf" ] || fail "F2 did not create output PDF"
+
+assert_pdf_layout "$TMP/f2.pdf" 28.8 14.4 F2 || fail "F2 PDF summary: $(pdf_summary "$TMP/f2.pdf")"
+
+
+
+
+run_ocrmypdf --image-dpi 150 --output-type pdf --plugin "$PLUGIN" \
+    "$TMP/low_override.png" "$TMP/f3.pdf" >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+
+require_no_traceback F3
+[ -s "$TMP/f3.pdf" ] || fail "F3 did not create output PDF"
+
+assert_pdf_layout "$TMP/f3.pdf" 43.2 14.4 F3 || fail "F3 PDF summary: $(pdf_summary "$TMP/f3.pdf")"
+
+
+
+
+run_ocrmypdf --image-dpi 100 --output-type pdf --plugin "$PLUGIN" \
+    - "$TMP/f4.pdf" <"$TMP/stdin_rgb.png" >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+
+require_no_traceback F4
+[ -s "$TMP/f4.pdf" ] || fail "F4 did not create output PDF"
+
+assert_pdf_layout "$TMP/f4.pdf" 46.08 23.04 F4 || fail "F4 PDF summary: $(pdf_summary "$TMP/f4.pdf")"
+
+
+
+
+run_ocrmypdf --output-type pdf --plugin "$PLUGIN" \
+    "$TMP/nodpi_rgb.png" "$TMP/f5.pdf" >out 2>err; ec=$?
+[ "$ec" -eq 2 ] || fail "F5 exit $ec; want 2"
+
+require_no_traceback F5
+
+require_err_regex "F5 missing no-DPI error" "(no|missing|without|lacks|does not have).*(dpi|resolution)|(dpi|resolution).*(no|missing|without|lacks|does not have)"
+require_err_regex "F5 missing estimate instruction" "estimate"
+require_err_regex "F5 missing --image-dpi instruction" "--image-dpi"
+[ ! -e "$TMP/f5.pdf" ] || fail "F5 created output PDF"
+
+
+
+
+run_ocrmypdf --output-type pdf --plugin "$PLUGIN" \
+    "$TMP/low_30.png" "$TMP/f6.pdf" >out 2>err; ec=$?
+[ "$ec" -eq 2 ] || fail "F6 exit $ec; want 2"
+
+require_no_traceback F6
+
+require_err_regex "F6 missing not-credible error" "(not credible|low|too low|invalid|unusable).*(dpi|resolution)|(dpi|resolution).*(not credible|low|too low|invalid|unusable)"
+require_err_regex "F6 missing estimate instruction" "estimate"
+require_err_regex "F6 missing --image-dpi instruction" "--image-dpi"
+[ ! -e "$TMP/f6.pdf" ] || fail "F6 created output PDF"
+
+
+
+
+run_ocrmypdf --image-dpi 200 --output-type pdf --plugin "$PLUGIN" \
+    "$TMP/rgba.png" "$TMP/f7.pdf" >out 2>err; ec=$?
+[ "$ec" -eq 2 ] || fail "F7 exit $ec; want 2"
+
+require_no_traceback F7
+
+require_err_regex "F7 missing alpha error" "alpha"
+require_err_regex "F7 missing alpha-removal guidance" "remov"
+[ ! -e "$TMP/f7.pdf" ] || fail "F7 created output PDF"
+
+
+
+
+run_ocrmypdf --image-dpi 200 --output-type pdf --plugin "$PLUGIN" \
+    "$TMP/la.png" "$TMP/f8.pdf" >out 2>err; ec=$?
+[ "$ec" -eq 2 ] || fail "F8 exit $ec; want 2"
+
+require_no_traceback F8
+
+require_err_regex "F8 missing alpha error" "alpha"
+require_err_regex "F8 missing alpha-removal guidance" "remov"
+[ ! -e "$TMP/f8.pdf" ] || fail "F8 created output PDF"
+
+
+
+
+run_ocrmypdf --image-dpi 200 --output-type pdf --plugin "$PLUGIN" \
+    "$TMP/cmyk_no_icc.jpg" "$TMP/f9.pdf" >out 2>err; ec=$?
+[ "$ec" -eq 2 ] || fail "F9 exit $ec; want 2"
+
+require_no_traceback F9
+
+require_err_regex "F9 missing CMYK ICC error" "cmyk"
+require_err_regex "F9 missing ICC-profile error" "icc"
+require_err_regex "F9 missing no-ICC wording" "no|missing|without|lacks|does not have"
+[ ! -e "$TMP/f9.pdf" ] || fail "F9 created output PDF"
+
+
+
+
+run_ocrmypdf --image-dpi 200 --output-type pdf --plugin "$PLUGIN" \
+    "$TMP/empty.bin" "$TMP/f10.pdf" >out 2>err; ec=$?
+[ "$ec" -eq 2 ] || fail "F10 exit $ec; want 2"
+
+require_no_traceback F10
+
+require_err_regex "F10 missing unreadable-image diagnostic" "image|unsupported|readable|identify"
+require_err_regex "F10 missing regular-file diagnostic" "regular[ -]file|is a file|file is regular"
+require_err_regex "F10 missing empty-file diagnostic" "empty"
+[ ! -e "$TMP/f10.pdf" ] || fail "F10 created output PDF"
+
+
+
+
+run_ocrmypdf --image-dpi 200 --output-type pdf --plugin "$PLUGIN" \
+    "$TMP/regular_nonimage.bin" "$TMP/f11.pdf" >out 2>err; ec=$?
+[ "$ec" -eq 2 ] || fail "F11 exit $ec; want 2"
+
+require_no_traceback F11
+
+require_err_regex "F11 missing unreadable-image diagnostic" "image|unsupported|readable|identify"
+require_err_regex "F11 missing regular-file diagnostic" "regular[ -]file|is a file|file is regular"
+[ ! -e "$TMP/f11.pdf" ] || fail "F11 created output PDF"
+
+
+
+
+run_ocrmypdf --image-dpi 200 --output-type pdf --plugin "$PLUGIN" \
+    "$TMP/input_dir" "$TMP/f12.pdf" >out 2>err; ec=$?
+[ "$ec" -eq 2 ] || fail "F12 exit $ec; want 2"
+
+require_no_traceback F12
+
+require_err_regex "F12 missing directory diagnostic" "dir|directory"
+[ ! -e "$TMP/f12.pdf" ] || fail "F12 created output PDF"
+
+
+
+
+run_ocrmypdf --image-dpi 200 --output-type pdf --plugin "$PLUGIN" \
+    "$TMP/missing.bin" "$TMP/f13.pdf" >out 2>err; ec=$?
+[ "$ec" -eq 2 ] || fail "F13 exit $ec; want 2"
+
+require_no_traceback F13
+
+require_err_regex "F13 missing not-found diagnostic" "not found|missing|does not exist|no such file"
+require_err_regex "F13 missing input filename diagnostic" "missing\\.bin"
+[ ! -e "$TMP/f13.pdf" ] || fail "F13 created output PDF"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
