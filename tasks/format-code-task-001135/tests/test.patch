diff --git a/test/lib/commands/pkg-edge-cases.js b/test/lib/commands/pkg-edge-cases.js
new file mode 100644
index 000000000..9c7ed1b81
--- /dev/null
+++ b/test/lib/commands/pkg-edge-cases.js
@@ -0,0 +1,130 @@
+'use strict'
+
+const t = require('tap')
+const { load: loadMockNpm } = require('../../fixtures/mock-npm')
+
+const makePkg = async (t, content, config = {}) => {
+  const res = await loadMockNpm(t, {
+    command: 'pkg',
+    config,
+    prefixDir: {
+      'package.json': JSON.stringify(content),
+    },
+  })
+
+  return {
+    ...res,
+    read: () => JSON.parse(require('fs').readFileSync(
+      require('path').resolve(res.prefix, 'package.json'), 'utf8'
+    )),
+  }
+}
+
+t.test('set accepts an explicit empty string and preserves equals signs', async t => {
+  const { npm, read } = await makePkg(t, { name: 'edge-pkg' })
+
+  await npm.exec('pkg', ['set', 'description='])
+  await npm.exec('pkg', ['set', 'repository.url=https://example.test/a=b'])
+
+  t.same(read(), {
+    name: 'edge-pkg',
+    description: '',
+    repository: { url: 'https://example.test/a=b' },
+  })
+})
+
+t.test('array append accepts an explicit empty string', async t => {
+  const { npm, read } = await makePkg(t, { name: 'edge-pkg', keywords: ['one'] })
+
+  await npm.exec('pkg', ['set', 'keywords[]='])
+
+  t.same(read().keywords, ['one', ''])
+})
+
+t.test('--json preserves false, zero, null, and empty string types', async t => {
+  const { npm, read } = await makePkg(t, { name: 'edge-pkg' }, { json: true })
+
+  await npm.exec('pkg', ['set', 'enabled=false', 'retries=0', 'note=null', 'label=""'])
+
+  t.same(read(), {
+    name: 'edge-pkg',
+    enabled: false,
+    retries: 0,
+    note: null,
+    label: '',
+  })
+})
+
+t.test('an assignment without an equals sign is rejected', async t => {
+  const initial = { name: 'edge-pkg', version: '1.0.0' }
+  const { npm, read } = await makePkg(t, initial)
+
+  await t.rejects(npm.exec('pkg', ['set', 'missingEquals']), { code: 'EUSAGE' })
+  t.same(read(), initial)
+})
+
+t.test('an assignment with an empty key is rejected', async t => {
+  const initial = { name: 'edge-pkg', version: '1.0.0' }
+  const { npm, read } = await makePkg(t, initial)
+
+  await t.rejects(npm.exec('pkg', ['set', '=missing-key']), { code: 'EUSAGE' })
+  t.same(read(), initial)
+})
+
+t.test('malformed assignments fail before saving any earlier update', async t => {
+  const initial = { name: 'edge-pkg', version: '1.0.0' }
+  const { npm, read } = await makePkg(t, initial)
+
+  await t.rejects(npm.exec('pkg', ['set', 'description=ok', 'missingEquals']), { code: 'EUSAGE' })
+  t.same(read(), initial)
+})
+
+t.test('get treats null intermediates as absent', async t => {
+  const { npm, joinedOutput } = await makePkg(t, {
+    name: 'edge-pkg',
+    config: null,
+  })
+
+  await npm.exec('pkg', ['get', 'config.mode'])
+
+  t.same(JSON.parse(joinedOutput()), {})
+})
+
+t.test('get skips null entries while expanding arrays', async t => {
+  const { npm, joinedOutput } = await makePkg(t, {
+    name: 'edge-pkg',
+    contributors: [null, { name: 'Ada' }],
+  })
+
+  await npm.exec('pkg', ['get', 'contributors.name'])
+
+  t.same(JSON.parse(joinedOutput()), { 'contributors[1].name': 'Ada' })
+})
+
+t.test('workspace selection scopes reads and writes to the selected package', async t => {
+  const res = await loadMockNpm(t, {
+    command: 'pkg',
+    config: { workspace: ['packages/a'] },
+    prefixDir: {
+      'package.json': JSON.stringify({ name: 'root-pkg', version: '1.0.0', workspaces: ['packages/*'] }),
+      packages: {
+        a: {
+          'package.json': JSON.stringify({ name: 'workspace-a', version: '1.0.0' }),
+        },
+        b: {
+          'package.json': JSON.stringify({ name: 'workspace-b', version: '1.0.0' }),
+        },
+      },
+    },
+  })
+
+  await res.npm.exec('pkg', ['set', 'description=only-a'])
+  await res.npm.exec('pkg', ['get', 'name'])
+
+  const read = dir => JSON.parse(require('fs').readFileSync(
+    require('path').resolve(res.prefix, dir, 'package.json'), 'utf8'
+  ))
+  t.same(read('packages/a').description, 'only-a')
+  t.same(read('packages/b'), { name: 'workspace-b', version: '1.0.0' })
+  t.same(JSON.parse(res.outputs[res.outputs.length - 1][0]), { 'workspace-a': 'workspace-a' })
+})
