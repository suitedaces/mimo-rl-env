diff --git a/tests/executors/test_celery_kubernetes_executor.py b/tests/executors/test_celery_kubernetes_executor.py
index 84ca14c5f0..9a17f90d83 100644
--- a/tests/executors/test_celery_kubernetes_executor.py
+++ b/tests/executors/test_celery_kubernetes_executor.py
@@ -223,3 +223,23 @@ class TestCeleryKubernetesExecutor:
         assert k8s_executor_mock.kubernetes_queue == conf.get(
             'celery_kubernetes_executor', 'kubernetes_queue'
         )
+
+    def test_send_callback_method_exists(self):
+        cel_exec = CeleryExecutor()
+        k8s_exec = KubernetesExecutor()
+        cke = CeleryKubernetesExecutor(cel_exec, k8s_exec)
+
+        assert hasattr(cke, 'send_callback')
+        assert callable(cke.send_callback)
+
+    def test_send_callback_dispatches_to_sink(self):
+        cel_exec = CeleryExecutor()
+        k8s_exec = KubernetesExecutor()
+        cke = CeleryKubernetesExecutor(cel_exec, k8s_exec)
+        callback_sink = mock.MagicMock()
+        cke.callback_sink = callback_sink
+
+        request = mock.MagicMock()
+        cke.send_callback(request)
+
+        callback_sink.send.assert_called_once_with(request)
