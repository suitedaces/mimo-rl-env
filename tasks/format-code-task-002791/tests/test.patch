+namespace detail
+{
+inline double &sim_time()
+{
+  static double value = 0.0;
+  return value;
+}
+
+inline size_t &sleep_count()
+{
+  static size_t value = 0;
+  return value;
+}
+
+inline size_t &shutdown_after()
+{
+  static size_t value = std::numeric_limits<size_t>::max();
+  return value;
+}
+
+inline bool &ok_flag()
+{
+  static bool value = true;
+  return value;
+}
+
+template <typename M>
+struct Bus
+{
+  std::vector<std::function<void(const M &)>> subscribers;
+};
+
+template <typename M>
+std::unordered_map<std::string, std::shared_ptr<Bus<M>>> &registries()
+{
+  static std::unordered_map<std::string, std::shared_ptr<Bus<M>>> *value =
+      new std::unordered_map<std::string, std::shared_ptr<Bus<M>>>();
+  return *value;
+}
+
+template <typename M>
+std::shared_ptr<Bus<M>> bus_for(const std::string &topic)
+{
+  auto &registry = registries<M>();
+  auto it = registry.find(topic);
+  if(it != registry.end())
+  {
+    return it->second;
+  }
+
+  std::shared_ptr<Bus<M>> bus(new Bus<M>());
+  registry[topic] = bus;
+  return bus;
+}
+
+template <typename M, typename C>
+void add_subscriber(const std::string &topic, void (C::*cb)(const typename M::ConstPtr &), C *obj)
+{
+  auto bus = bus_for<M>(topic);
+  bus->subscribers.push_back([obj, cb](const M &msg) {
+    typename M::ConstPtr ptr = &msg;
+    (obj->*cb)(ptr);
+  });
+}
+
+template <typename M>
+void publish(const std::string &topic, const M &msg)
+{
+  auto bus = bus_for<M>(topic);
+  for(const auto &subscriber : bus->subscribers)
+  {
+    subscriber(msg);
+  }
+}
+
+inline void advance_time(double sec)
+{
+  sim_time() += sec;
+}
+}
+
+inline void reset()
+{
+  detail::sim_time() = 0.0;
+  detail::sleep_count() = 0;
+  detail::shutdown_after() = std::numeric_limits<size_t>::max();
+  detail::ok_flag() = true;
+}
+
+inline void set_shutdown_after(size_t count)
+{
+  detail::shutdown_after() = count;
+}
+
+inline bool ok()
+{
