+class Rate
+{
+  public:
+    explicit Rate(double hz) : hz_(hz) {}
+
+    void sleep()
+    {
+      detail::sleep_count() += 1;
+      detail::advance_time(1.0 / hz_);
+      if(detail::sleep_count() >= detail::shutdown_after())
+      {
+        detail::ok_flag() = false;
+      }
+    }
+
+  private:
+    double hz_;
+};
+
+class NodeHandle
+{
+  public:
+    NodeHandle() = default;
+
+    template <typename M, typename C>
+    Subscriber subscribe(const std::string &topic, int, void (C::*cb)(const typename M::ConstPtr &), C *obj)
+    {
+      detail::add_subscriber<M>(topic, cb, obj);
+      return Subscriber(topic);
+    }
+
+    template <typename M>
+    Publisher advertise(const std::string &topic, int)
+    {
+      return Publisher(topic);
+    }
+
+    template <typename Srv>
+    ServiceClient serviceClient(const std::string &topic)
+    {
+      return ServiceClient(topic);
+    }
+
+    void setParam(const std::string &, double)
