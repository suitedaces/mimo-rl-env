+#include "include/drone_control.h"
+
+#include <iomanip>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+
+extern int offboard_control_real_main(int argc, char **argv);
+
+namespace
+{
+geometry_msgs::PoseArray make_marker(double x, double y, double z)
+{
+  geometry_msgs::PoseArray arr;
+  arr.header.stamp = ros::Time::now();
+  arr.header.frame_id = "world";
+  geometry_msgs::Pose pose;
+  pose.position.x = x;
+  pose.position.y = y;
+  pose.position.z = z;
+  pose.orientation = tf::createQuaternionMsgFromYaw(0.0);
+  arr.poses.push_back(pose);
+  return arr;
+}
+
+geometry_msgs::PoseArray make_stale_marker(double x, double y, double z)
+{
+  geometry_msgs::PoseArray arr = make_marker(x, y, z);
+  arr.header.stamp = ros::Time(-100.0);
+  return arr;
+}
+
+double yaw_from_pose(const geometry_msgs::PoseStamped &pose)
+{
+  tf::Quaternion q;
+  tf::quaternionMsgToTF(pose.pose.orientation, q);
+  double roll = 0.0;
+  double pitch = 0.0;
+  double yaw = 0.0;
+  tf::Matrix3x3(q).getRPY(roll, pitch, yaw);
+  return yaw;
+}
+
+std::string fmt(double value)
+{
+  std::ostringstream out;
+  out.setf(std::ios::fixed);
+  out << std::setprecision(6) << value;
+  return out.str();
+}
+
+class ScenarioRunner
+{
+  public:
+
+    explicit ScenarioRunner(const std::string &scenario)
+        : scenario_(scenario),
+          follow_scan_endpoints_(scenario != "warning"),
+          endpoint_sub_(nh_.subscribe<geometry_msgs::PoseStamped>("/trajectory/endpoint_position", 10,
+                                                                  &ScenarioRunner::endpoint_cb, this)),
+          command_sub_(nh_.subscribe<std_msgs::String>("/trajectory/command", 10,
+                                                       &ScenarioRunner::command_cb, this)),
+          setpoint_sub_(nh_.subscribe<geometry_msgs::PoseStamped>("/mavros/setpoint_position/local", 10,
+                                                                  &ScenarioRunner::setpoint_cb, this)),
+          local_pub_(nh_.advertise<geometry_msgs::PoseStamped>("/mavros/local_position/pose", 10)),
+          marker_pub_(nh_.advertise<geometry_msgs::PoseArray>("/whycon/poses", 10))
+    {
+    }
+
+    void command_cb(const std_msgs::String::ConstPtr &msg)
+    {
+      if(msg->data == "s" && !scan_started_)
+      {
+        scan_started_ = true;
+        scan_active_ = true;
+        if(scenario_ == "fresh-marker")
+        {
+          publish_marker(true);
+        }
+      }
+    }
+
+    void endpoint_cb(const geometry_msgs::PoseStamped::ConstPtr &msg)
+    {
+      if(!scan_started_)
+      {
+        return;
+      }
+
+      if(scan_endpoints_.size() < 5)
+      {
+        scan_endpoints_.push_back(*msg);
+        if(follow_scan_endpoints_)
+        {
+          local_pub_.publish(*msg);
+        }
+        if(scan_endpoints_.size() == 5)
+        {
+
+          publish_marker(scenario_ == "fresh-marker");
+          ros::set_shutdown_after(ros::detail::sleep_count() + 45);
+        }
+        return;
+      }
+
+      scan_active_ = false;
+      ros::set_shutdown_after(ros::detail::sleep_count() + 80);
+    }
+
+    void setpoint_cb(const geometry_msgs::PoseStamped::ConstPtr &msg)
+    {
+      if(scan_active_)
+      {
+        scan_setpoints_.push_back(*msg);
+      }
+      else
+      {
+        local_pub_.publish(*msg);
+      }
+    }
+
+    const std::vector<geometry_msgs::PoseStamped> &endpoints() const
+    {
+      return scan_endpoints_;
+    }
+
+    const std::vector<geometry_msgs::PoseStamped> &setpoints() const
+    {
+      return scan_setpoints_;
+    }
+
+  private:
+    void publish_marker(bool fresh)
+    {
+      if(fresh)
+      {
+        marker_pub_.publish(make_marker(1.0, 2.0, 2.0));
+      }
+      else
+      {
+        marker_pub_.publish(make_stale_marker(1.0, 2.0, 2.0));
+      }
+    }
+
+    std::string scenario_;
+    bool follow_scan_endpoints_;
+    bool scan_started_ = false;
+    bool scan_active_ = false;
+    ros::NodeHandle nh_;
+    ros::Subscriber endpoint_sub_;
+    ros::Subscriber command_sub_;
+    ros::Subscriber setpoint_sub_;
+    ros::Publisher local_pub_;
+    ros::Publisher marker_pub_;
+    std::vector<geometry_msgs::PoseStamped> scan_endpoints_;
+    std::vector<geometry_msgs::PoseStamped> scan_setpoints_;
+};
+
+void print_summary(const std::string &name, const ScenarioRunner &runner)
+{
+  std::cout << "scenario=" << name << '\n';
+  std::cout << "endpoint_count=" << runner.endpoints().size() << '\n';
+  for(size_t i = 0; i < runner.endpoints().size(); ++i)
+  {
+    const auto &pose = runner.endpoints()[i];
+    std::cout << "endpoint[" << i << "]="
+              << fmt(pose.pose.position.x) << ','
+              << fmt(pose.pose.position.y) << ','
+              << fmt(pose.pose.position.z) << ','
+              << fmt(yaw_from_pose(pose)) << '\n';
+  }
+  std::cout << "setpoint_count=" << runner.setpoints().size() << '\n';
+  if(!runner.setpoints().empty())
+  {
+    const auto &pose = runner.setpoints().front();
+    std::cout << "setpoint[0]="
+              << fmt(pose.pose.position.x) << ','
+              << fmt(pose.pose.position.y) << ','
+              << fmt(pose.pose.position.z) << ','
+              << fmt(yaw_from_pose(pose)) << '\n';
+  }
+}
+}
+
+int main(int argc, char **argv)
+{
+  std::string scenario = argc > 1 ? argv[1] : "steady";
+  ScenarioRunner runner(scenario);
+
+  offboard_control_real_main(argc, argv);
+  print_summary(scenario, runner);
+  return 0;
+}
