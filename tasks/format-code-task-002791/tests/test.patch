+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+REPO=/workspace/repo
+FIXTURES=$REPO/usercase-test-coderl/fixtures
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+fail() {
+  echo "FAIL: $*" >&2
+  exit 1
+}
+
+assert_line() {
+  name=$1
+  expected=$2
+  grep -Fxq "$expected" out || {
+    echo "FAIL: $name missing line: $expected" >&2
+    echo "actual:" >&2
+    cat out >&2
+    exit 1
+  }
+}
+
+value_for() {
+  key=$1
+  sed -n "s/^$key=//p" out | head -n 1
+}
+
+assert_count_between() {
+  name=$1
+  key=$2
+  min=$3
+  max=$4
+  value=$(value_for "$key")
+  case "$value" in
+    ''|*[!0-9]*) fail "$name invalid $key: $value" ;;
+  esac
+  [ "$value" -ge "$min" ] && [ "$value" -le "$max" ] \
+    || fail "$name $key=$value outside [$min,$max]"
+}
+
+assert_scan_endpoints() {
+  name=$1
+  assert_line "$name" "endpoint_count=5"
+  assert_line "$name" "endpoint[0]=4.000000,-5.000000,1.500000,0.000000"
+  assert_line "$name" "endpoint[1]=4.000000,-7.000000,1.500000,0.000000"
+  assert_line "$name" "endpoint[2]=4.000000,-7.000000,10.000000,0.000000"
+  assert_line "$name" "endpoint[3]=4.000000,-3.000000,10.000000,0.000000"
+  assert_line "$name" "endpoint[4]=4.000000,-3.000000,1.500000,0.000000"
+}
+
+assert_current_setpoint_published() {
+  name=$1
+  assert_line "$name" "setpoint[0]=4.000000,-5.000000,10.000000,0.000000"
+}
+
+make_wrapper() {
+  header=$1
+  mkdir -p "$TMP/stubs/$(dirname "$header")"
+  printf '#pragma once\n#include "%s/common.hpp"\n' "$FIXTURES" > "$TMP/stubs/$header"
+}
+
+for header in \
+  ros/ros.h \
+  std_msgs/String.h \
+  mavros_msgs/State.h \
+  mavros_msgs/ExtendedState.h \
+  mavros_msgs/CommandBool.h \
+  mavros_msgs/CommandTOL.h \
+  mavros_msgs/SetMode.h \
+  mavros_msgs/GlobalPositionTarget.h \
+  geometry_msgs/PoseStamped.h \
+  geometry_msgs/PoseWithCovarianceStamped.h \
+  geometry_msgs/PoseArray.h \
+  geometry_msgs/TransformStamped.h \
+  sensor_msgs/NavSatFix.h \
+  tf/tf.h \
+  tf2/LinearMath/Quaternion.h \
+  tf2_ros/transform_listener.h \
+  tf2_ros/static_transform_broadcaster.h \
+  tf2_ros/transform_broadcaster.h
+do
+  make_wrapper "$header"
+done
+
+CXX=${CXX:-g++}
+OBJDIR=$TMP/obj
+mkdir -p "$OBJDIR"
+
+for src in "$REPO"/src/offboard_control/*.cpp
+do
+  obj="$OBJDIR/$(basename "$src" .cpp).o"
+  "$CXX" -std=c++11 -Dmain=offboard_control_real_main \
+    -I"$TMP/stubs" -I"$REPO/src/offboard_control" \
+    -c "$src" -o "$obj" >"$TMP/build.out" 2>"$TMP/build.err" \
+    || { cat "$TMP/build.err" >&2; fail "build object $(basename "$src")"; }
+done
+
+"$CXX" -std=c++11 \
+  -I"$TMP/stubs" -I"$REPO/src/offboard_control" \
+  -c "$FIXTURES/harness.cpp" -o "$OBJDIR/harness.o" >"$TMP/build.out" 2>"$TMP/build.err" \
+  || { cat "$TMP/build.err" >&2; fail "build harness"; }
+
+BIN=$TMP/offboard_scan_harness
+"$CXX" "$OBJDIR"/*.o -o "$BIN" >"$TMP/build.out" 2>"$TMP/build.err" \
+  || { cat "$TMP/build.err" >&2; fail "link"; }
+
+cd "$TMP"
+
+
+
+
+"$BIN" steady >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_line F1 "scenario=steady"
+assert_scan_endpoints F1
+
+assert_count_between F1 setpoint_count 200 205
+assert_current_setpoint_published F1
+grep -Fq "Scanning building" err || fail "F1 missing scan log"
+! grep -Fq "2*MAX_ATTEMPTS reached while scanning building. Aborting." err \
+  || fail "F1 unexpected warning"
+
+
+
+
+"$BIN" fresh-marker >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_line F2 "scenario=fresh-marker"
+assert_scan_endpoints F2
+
+assert_count_between F2 setpoint_count 0 5
+if [ "$(value_for setpoint_count)" -gt 0 ]; then
+  assert_current_setpoint_published F2
+fi
+grep -Fq "Scanning building" err || fail "F2 missing scan log"
+! grep -Fq "2*MAX_ATTEMPTS reached while scanning building. Aborting." err \
+  || fail "F2 unexpected warning"
+
+
+
+
+"$BIN" warning >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+assert_line F3 "scenario=warning"
+assert_scan_endpoints F3
+
+assert_count_between F3 setpoint_count 600 4000
+assert_current_setpoint_published F3
+grep -Fq "Scanning building" err || fail "F3 missing scan log"
+
+grep -R --include='*.cpp' --include='*.h' -Fq \
+  "2*MAX_ATTEMPTS reached while scanning building. Aborting." "$REPO/src/offboard_control" \
+  || fail "F3 missing warning text"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
