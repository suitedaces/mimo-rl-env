+class Duration
+{
+  public:
+    explicit Duration(double sec = 0.0) : sec_(sec) {}
+
+    double toSec() const { return sec_; }
+
+  private:
+    double sec_;
+
+    friend Duration operator-(const Time &lhs, const Time &rhs);
+    friend Time operator+(const Time &lhs, const Duration &rhs);
+    friend bool operator<(const Duration &lhs, const Duration &rhs);
+    friend bool operator>(const Duration &lhs, const Duration &rhs);
+    friend bool operator<=(const Duration &lhs, const Duration &rhs);
+    friend bool operator>=(const Duration &lhs, const Duration &rhs);
+  };
+
+inline Duration operator-(const Time &lhs, const Time &rhs)
+{
+  return Duration(lhs.sec_ - rhs.sec_);
+}
+
+inline Time operator+(const Time &lhs, const Duration &rhs)
+{
+  return Time(lhs.sec_ + rhs.sec_);
+}
+
+inline bool operator<(const Duration &lhs, const Duration &rhs)
+{
+  return lhs.sec_ < rhs.sec_;
+}
+
+inline bool operator>(const Duration &lhs, const Duration &rhs)
+{
+  return lhs.sec_ > rhs.sec_;
+}
+
+inline bool operator<=(const Duration &lhs, const Duration &rhs)
+{
+  return lhs.sec_ <= rhs.sec_;
+}
+
+inline bool operator>=(const Duration &lhs, const Duration &rhs)
+{
+  return lhs.sec_ >= rhs.sec_;
+}
