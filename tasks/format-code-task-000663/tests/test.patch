diff --git a/test/specs/core.controller.tests.js b/test/specs/core.controller.tests.js
index 12045a78..4efda349 100644
--- a/test/specs/core.controller.tests.js
+++ b/test/specs/core.controller.tests.js
@@ -1440,4 +1440,62 @@ describe('Chart', function() {
 			expect(chart.getDataVisibility(1)).toBe(false);
 		});
 	});
+
+	describe('Chart.getChart', function() {
+		it('should expose a static getChart function', function() {
+			expect(typeof Chart.getChart).toBe('function');
+		});
+
+		it('should return the chart instance when passed the canvas element', function() {
+			var chart = acquireChart({type: 'line'});
+			expect(Chart.getChart(chart.canvas)).toBe(chart);
+		});
+
+		it('should return the chart instance when passed the rendering context', function() {
+			var chart = acquireChart({type: 'line'});
+			expect(Chart.getChart(chart.ctx)).toBe(chart);
+		});
+
+		it('should return the chart instance when passed the canvas id string', function() {
+			var chart = acquireChart({type: 'line'});
+			chart.canvas.id = 'chart-getchart-by-id';
+			expect(Chart.getChart('chart-getchart-by-id')).toBe(chart);
+		});
+
+		it('should return undefined when no chart exists for the canvas', function() {
+			var lonelyCanvas = document.createElement('canvas');
+			expect(Chart.getChart(lonelyCanvas)).toBeUndefined();
+		});
+
+		it('should return a falsy "not found" value when passed an unknown id string', function() {
+
+
+			var result = Chart.getChart('non-existent-canvas-id-xyz');
+			expect(result == null).toBe(true);
+		});
+
+		it('should return undefined after the chart has been destroyed', function() {
+			var canvas = document.createElement('canvas');
+			document.body.appendChild(canvas);
+			var chart = new Chart(canvas, {type: 'line', options: {responsive: false, animation: false}});
+			expect(Chart.getChart(canvas)).toBe(chart);
+			chart.destroy();
+			expect(Chart.getChart(canvas)).toBeUndefined();
+			document.body.removeChild(canvas);
+		});
+
+		it('should allow constructing a chart on the same canvas after destroy', function() {
+			var canvas = document.createElement('canvas');
+			document.body.appendChild(canvas);
+			var chart1 = new Chart(canvas, {type: 'line', options: {responsive: false, animation: false}});
+			chart1.destroy();
+			var chart2;
+			expect(function() {
+				chart2 = new Chart(canvas, {type: 'bar', options: {responsive: false, animation: false}});
+			}).not.toThrow();
+			expect(Chart.getChart(canvas)).toBe(chart2);
+			chart2.destroy();
+			document.body.removeChild(canvas);
+		});
+	});
 });
