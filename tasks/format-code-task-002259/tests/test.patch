+import sys
+import types
+
+import pytest
+
+
+class DictatorSpy:
+    def __init__(self):
+        self.entries = {}
+        self.calls = []
+        self.stop_calls = 0
+
+    def clear(self):
+        self.entries.clear()
+        self.calls.clear()
+        self.stop_calls = 0
+
+    def active_entries(self):
+        return len(self.entries)
+
+    def add(self, kind, path, value):
+        self.entries[path] = (kind, value)
+        self.calls.append((kind, path, value))
+
+    def module(self):
+        mod = types.ModuleType("pybindlibs.dictator")
+        mod.add_int = lambda path, val: self.add("int", path, int(val))
+        mod.add_bool = lambda path, val: self.add("bool", path, bool(val))
+        mod.add_double = lambda path, val: self.add("double", path, float(val))
+        mod.add_size_t = lambda path, val: self.add("size_t", path, int(val))
+        mod.add_optional_size_t = lambda path, val: self.add(
+            "optional_size_t", path, None if val is None else int(val)
+        )
+        mod.add_vector_int = lambda path, val: self.add(
+            "vector_int", path, list(val)
+        )
+        mod.add_vector_string = lambda path, val: self.add(
+            "vector_string", path, list(val)
+        )
+        mod.add_string = lambda path, val: self.add("string", path, str(val))
+        mod.add_array_as_vector = lambda path, val: self.add(
+            "array_as_vector", path, list(val)
+        )
+        mod.addInitFunction1D = self._add_init_function(1)
+        mod.addInitFunction2D = self._add_init_function(2)
+        mod.addInitFunction3D = self._add_init_function(3)
+        mod.stop = self.stop
+        return mod
+
+    def _add_init_function(self, ndim):
+        def add_init(path, fn):
+            raw_fn = getattr(fn, "fn", None)
+            if ndim == 1:
+                sample = raw_fn(2.0)
+            elif ndim == 2:
+                sample = raw_fn(2.0, 3.0)
+            else:
+                sample = raw_fn(2.0, 3.0, 4.0)
+            self.add(f"init{ndim}D", path, sample)
+
+        return add_init
+
+    def stop(self):
+        self.stop_calls += 1
+        self.entries.clear()
+        self.calls.clear()
+
+
+SPY = DictatorSpy()
+_pybindlibs = types.ModuleType("pybindlibs")
+_dictator = SPY.module()
+_pybindlibs.dictator = _dictator
+sys.modules["pybindlibs"] = _pybindlibs
+sys.modules["pybindlibs.dictator"] = _dictator
+
+import pyphare.pharein as ph  # noqa: E402
+from pyphare.simulator.simulator import Simulator  # noqa: E402
+import pyphare.simulator.simulator as simulator_module  # noqa: E402
+
+
+@pytest.fixture(autouse=True)
+def clean_session():
+    SPY.clear()
+    ph.global_vars.sim = None
+    yield
+    ph.global_vars.sim = None
+    ph.clearDict()
+    SPY.clear()
+
+
+def make_mhd_simulation(**overrides):
+    kwargs = {
+        "cells": [40, 40],
+        "dl": [0.1, 0.2],
+        "time_step_nbr": 3,
+        "time_step": 0.05,
+        "boundary_types": ["periodic", "periodic"],
+        "refinement": "tagging",
+        "max_nbr_levels": 2,
+        "max_mhd_level": 1,
+        "nesting_buffer": 0,
+        "strict": True,
+        "model_options": ["MHDModel"],
+        "eta": 0.1,
+        "nu": 0.01,
+        "gamma": 2.0,
+        "hyper_mode": "constant",
+        "smallest_patch_size": [10, 10],
+        "largest_patch_size": [20, 20],
+    }
+    kwargs.update(overrides)
+    return ph.Simulation(**kwargs)
+
+
+def register_mhd_model():
+    ph.MHDModel(
+        density=lambda x, y: 10.0 + x,
+        vx=lambda x, y: 20.0 + x,
+        vy=lambda x, y: 30.0 + y,
+        vz=lambda x, y: 40.0 + x + y,
+        bx=lambda x, y: 50.0 + x,
+        by=lambda x, y: 60.0 + y,
+        bz=lambda x, y: 70.0 + x + y,
+        p=lambda x, y: 80.0 + x - y,
+    )
+
+
+REQUIRED_MHD_ENTRIES_2D = {
+    "simulation/models": ("vector_string", ["MHDModel"]),
+    "simulation/AMR/max_mhd_level": ("int", 1),
+    "simulation/AMR/refinement/tagging/mhd_method": ("string", "default"),
+    "simulation/algo/fv_method/resistivity": ("double", 0.1),
+    "simulation/algo/fv_method/hyper_resistivity": ("double", 0.01),
+    "simulation/algo/fv_method/heat_capacity_ratio": ("double", 2.0),
+    "simulation/algo/fv_method/hyper_mode": ("string", "constant"),
+    "simulation/algo/to_primitive/heat_capacity_ratio": ("double", 2.0),
+    "simulation/algo/to_conservative/heat_capacity_ratio": ("double", 2.0),
+    "simulation/algo/constrained_transport/resistivity": ("double", 0.1),
+    "simulation/algo/constrained_transport/hyper_resistivity": ("double", 0.01),
+    "simulation/algo/constrained_transport/hyper_mode": ("string", "constant"),
+    "simulation/mhd_state/name": ("string", "mhd_state"),
+    "simulation/mhd_state/to_conservative_init/heat_capacity_ratio": (
+        "double",
+        2.0,
+    ),
+    "simulation/mhd_state/density/initializer": ("init2D", 12.0),
+    "simulation/mhd_state/velocity/initializer/x_component": ("init2D", 22.0),
+    "simulation/mhd_state/velocity/initializer/y_component": ("init2D", 33.0),
+    "simulation/mhd_state/velocity/initializer/z_component": ("init2D", 45.0),
+    "simulation/mhd_state/magnetic/initializer/x_component": ("init2D", 52.0),
+    "simulation/mhd_state/magnetic/initializer/y_component": ("init2D", 63.0),
+    "simulation/mhd_state/magnetic/initializer/z_component": ("init2D", 75.0),
+    "simulation/mhd_state/pressure/initializer": ("init2D", 79.0),
+}
+
+
+def assert_required_mhd_entries_2d():
+    for path, literal in REQUIRED_MHD_ENTRIES_2D.items():
+        assert SPY.entries[path] == literal
+
+
+def test_populate_dict_registers_mhd_algorithm_state_and_2d_initializers():
+
+
+
+
+    sim = make_mhd_simulation()
+    assert sim.ndim == 2
+    assert sim.model_options == ["MHDModel"]
+    assert sim.model is None
+    assert sim.max_mhd_level == 1
+    assert sim.gamma == 2.0
+    assert sim.eta == 0.1
+    assert sim.nu == 0.01
+    assert sim.hyper_mode == "constant"
+    assert sim.refinement == "tagging"
+
+    register_mhd_model()
+
+    assert sim.model is not None
+
+    ph.populateDict(sim)
+
+
+    assert_required_mhd_entries_2d()
+    assert len([call for call in SPY.calls if call[0] == "init2D"]) == 8
+
+
+def test_simulator_setup_populates_mhd_dictionary_before_cpp_construction(monkeypatch):
+
+
+
+
+    sim = make_mhd_simulation(dry_run=True)
+    register_mhd_model()
+
+    monkeypatch.setattr(simulator_module, "startMPI", lambda: None)
+    monkeypatch.setattr(
+        simulator_module.cpp.validate,
+        "check_build_config_is_runtime_compatible",
+        lambda: None,
+    )
+
+    construction_events = []
+
+    class FakeEtc:
+        def make_hierarchy(self):
+            construction_events.append(("make_hierarchy", dict(SPY.entries)))
+            return object()
+
+    monkeypatch.setattr(simulator_module.cpp, "cpp_etc_lib", lambda: FakeEtc())
+
+    def fake_cpp_lib(simulation):
+        construction_events.append(("cpp_lib", dict(SPY.entries)))
+        return object()
+
+    monkeypatch.setattr(simulator_module.cpp, "cpp_lib", fake_cpp_lib)
+    monkeypatch.setattr(
+        simulator_module,
+        "make_cpp_simulator",
+        lambda cpp_lib, hier: object(),
+    )
+
+    simulator = Simulator(sim, log_to_file=False).setup()
+
+
+    assert simulator is not None
+    cpp_lib_entries = next(
+        entries for name, entries in construction_events if name == "cpp_lib"
+    )
+    assert cpp_lib_entries["simulation/mhd_state/name"] == ("string", "mhd_state")
+    assert cpp_lib_entries["simulation/algo/fv_method/resistivity"] == (
+        "double",
+        0.1,
+    )
+    assert cpp_lib_entries["simulation/mhd_state/pressure/initializer"] == (
+        "init2D",
+        79.0,
+    )
+    assert SPY.entries["simulation/mhd_state/name"] == ("string", "mhd_state")
+    assert SPY.entries["simulation/algo/fv_method/resistivity"] == ("double", 0.1)
+    assert SPY.entries["simulation/mhd_state/pressure/initializer"] == (
+        "init2D",
+        79.0,
+    )
+
+
+def test_hybrid_model_population_keeps_existing_hybrid_path_without_mhd_entries():
+
+
+
+
+    sim = ph.Simulation(
+        cells=[20],
+        dl=[0.1],
+        time_step_nbr=1,
+        time_step=0.1,
+        boundary_types=["periodic"],
+        refinement="tagging",
+        max_nbr_levels=1,
+        max_mhd_level=0,
+        nesting_buffer=0,
+        strict=True,
+        model_options=["HybridModel"],
+        smallest_patch_size=[10],
+        largest_patch_size=[20],
+        resistivity=0.2,
+        hyper_resistivity=0.03,
+        hyper_mode="constant",
+        dry_run=True,
+    )
+    ph.MaxwellianFluidModel(
+        bx=lambda x: 1.0,
+        by=lambda x: 2.0,
+        bz=lambda x: 3.0,
+        protons={
+            "charge": 1,
+            "mass": 1,
+            "density": lambda x: 4.0,
+            "vbulkx": lambda x: 5.0,
+            "vbulky": lambda x: 6.0,
+            "vbulkz": lambda x: 7.0,
+            "vthx": lambda x: 8.0,
+            "vthy": lambda x: 9.0,
+            "vthz": lambda x: 10.0,
+            "nbr_part_per_cell": 100,
+        },
+    )
+    ph.ElectronModel(closure="isothermal", Te=0.11)
+
+    ph.populateDict(sim)
+
+    assert SPY.entries["simulation/models"] == ("vector_string", ["HybridModel"])
+    assert SPY.entries["simulation/algo/ohm/resistivity"] == ("double", 0.2)
+    assert SPY.entries["simulation/algo/ohm/hyper_resistivity"] == ("double", 0.03)
+    assert SPY.entries["simulation/algo/ohm/hyper_mode"] == ("string", "constant")
+    assert SPY.entries["simulation/ions/nbrPopulations"] == ("size_t", 1)
+    assert SPY.entries["simulation/electromag/name"] == ("string", "EM")
+    assert SPY.entries["simulation/AMR/refinement/tagging/hybrid_method"] == (
+        "string",
+        "default",
+    )
+    assert "simulation/mhd_state/name" not in SPY.entries
+    assert "simulation/algo/fv_method/resistivity" not in SPY.entries
+    assert len(
+        [
+            key
+            for key in SPY.entries
+            if "/mhd_state/" in key
+            or "/fv_method/" in key
+            or "/constrained_transport/" in key
+        ]
+    ) == 0
+
+    assert len([call for call in SPY.calls if call[0] == "init1D"]) >= 10
+
+
+def test_mhd_model_before_simulation_raises_specific_runtime_error():
+
+
+
+
+    with pytest.raises(RuntimeError) as excinfo:
+        ph.MHDModel(density=lambda x, y: 1.0)
+
+
+    assert isinstance(excinfo.value, RuntimeError)
+
+
+def test_second_model_registration_raises_specific_runtime_error():
+
+
+
+
+    make_mhd_simulation()
+    register_mhd_model()
+
+    with pytest.raises(RuntimeError) as excinfo:
+        ph.MHDModel(density=lambda x, y: 2.0)
+
+
+    assert isinstance(excinfo.value, RuntimeError)
+
+
+def test_clear_dict_is_idempotent_cleanup():
+
+
+
+
+    sim = make_mhd_simulation()
+    register_mhd_model()
+    ph.populateDict(sim)
+
+    assert_required_mhd_entries_2d()
+    assert SPY.active_entries() >= len(REQUIRED_MHD_ENTRIES_2D)
+
+    ph.clearDict()
+
+    assert SPY.stop_calls >= 1
+    assert SPY.active_entries() == 0
+
+    ph.clearDict()
+
+    assert SPY.stop_calls >= 2
+    assert SPY.active_entries() == 0
+
+
+def test_separate_sessions_after_cleanup_do_not_share_model_state():
+
+
+
+
+    a = ph.Simulation(
+        cells=[20],
+        dl=[0.1],
+        time_step_nbr=1,
+        time_step=0.1,
+        boundary_types=["periodic"],
+        refinement="tagging",
+        max_nbr_levels=1,
+        max_mhd_level=0,
+        nesting_buffer=0,
+        strict=True,
+        model_options=["MHDModel"],
+        eta=0.1,
+        nu=0.01,
+        gamma=2.0,
+        hyper_mode="constant",
+        smallest_patch_size=[10],
+        largest_patch_size=[20],
+    )
+    ph.MHDModel(
+        density=lambda x: 101.0,
+        vx=lambda x: 102.0,
+        vy=lambda x: 103.0,
+        vz=lambda x: 104.0,
+        bx=lambda x: 105.0,
+        by=lambda x: 106.0,
+        bz=lambda x: 107.0,
+        p=lambda x: 108.0,
+    )
+    assert a.ndim == 1
+    assert a.model_options == ["MHDModel"]
+
+    ph.populateDict(a)
+    assert SPY.entries["simulation/mhd_state/density/initializer"] == (
+        "init1D",
+        101.0,
+    )
+
+    ph.global_vars.sim = None
+    ph.clearDict()
+
+    b = ph.Simulation(
+        cells=[20],
+        dl=[0.1],
+        time_step_nbr=1,
+        time_step=0.1,
+        boundary_types=["periodic"],
+        refinement="tagging",
+        max_nbr_levels=1,
+        max_mhd_level=0,
+        nesting_buffer=0,
+        strict=True,
+        model_options=["MHDModel"],
+        eta=0.1,
+        nu=0.01,
+        gamma=2.0,
+        hyper_mode="constant",
+        smallest_patch_size=[10],
+        largest_patch_size=[20],
+    )
+    assert b.ndim == 1
+    assert b.model is None
+    ph.MHDModel(
+        density=lambda x: 201.0,
+        vx=lambda x: 202.0,
+        vy=lambda x: 203.0,
+        vz=lambda x: 204.0,
+        bx=lambda x: 205.0,
+        by=lambda x: 206.0,
+        bz=lambda x: 207.0,
+        p=lambda x: 208.0,
+    )
+
+    assert b.ndim == 1
+    assert b.model_options == ["MHDModel"]
+
+    ph.populateDict(b)
+    assert SPY.entries["simulation/mhd_state/density/initializer"] == (
+        "init1D",
+        201.0,
+    )
+    assert a.ndim == 1
+    assert a.model_options == ["MHDModel"]
+
+
+def test_repeated_mhd_population_cleanup_cycles_leave_dictionary_empty():
+
+
+
+
+    for _ in range(100):
+        ph.global_vars.sim = None
+        sim = make_mhd_simulation()
+        register_mhd_model()
+        ph.populateDict(sim)
+
+        assert_required_mhd_entries_2d()
+        assert SPY.active_entries() >= len(REQUIRED_MHD_ENTRIES_2D)
+        ph.clearDict()
+        assert SPY.active_entries() == 0
+
+
+    assert SPY.stop_calls >= 100
+    assert SPY.active_entries() == 0
