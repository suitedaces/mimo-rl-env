+  }
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,62 @@
+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+
+set +u
+
+eval $(opam env --switch=system 2>/dev/null) 2>/dev/null || true
+set -u
+
+
+if [ ! -d node_modules/semver ]; then
+  npm ci --ignore-scripts
+fi
+
+build_compiler() {
+  if [ -f .fixturea_build_done ] && [ -x linux/rescript.exe ]; then
+    echo "=== Reusing Fixture.A compiler build ==="
+    return
+  fi
+
+  echo "=== Building ninja binary ==="
+  cd ninja
+  python3 configure.py --bootstrap --verbose 2>&1 | tail -3
+  cd /testbed
+
+  echo "=== Building compiler ==="
+  OCAMLPARAM="_,w=-53" dune build
+
+  mkdir -p lib
+
+  echo "=== Copying executables ==="
+  node scripts/copyExes.js
+
+  echo "=== Configuring ninja builds ==="
+  node scripts/ninja.js config
+
+  echo "=== Building runtime and test files ==="
+  node scripts/ninja.js build
+
+  echo "=== Populating lib/ocaml ==="
+  node scripts/prebuilt.js
+
+  touch .fixturea_build_done
+}
+
+case "${1:-}" in
+  base)
+    build_compiler
+    ;;
+  new)
+    build_compiler
+    node jscomp/build_tests/unboxed_bool_payload/input.js
+    node jscomp/build_tests/unboxed_bool_payload_any_name/input.js
+    node jscomp/build_tests/unboxed_bool_conflict/input.js
+    node jscomp/build_tests/unboxed_bool_false_conflict/input.js
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
