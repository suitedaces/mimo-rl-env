+
+var Main = require("./src/Main.bs.js");
+
+assert.strictEqual(Main.classify(true), "flag:true");
+assert.strictEqual(Main.classify(false), "flag:false");
+assert.strictEqual(Main.classify("abc"), "text");
+assert.strictEqual(Main.classify(3.5), "num");
+assert.strictEqual(Main.classify({name: "Ada"}), "obj:Ada");
diff --git a/jscomp/build_tests/unboxed_bool_payload/src/Main.res b/jscomp/build_tests/unboxed_bool_payload/src/Main.res
new file mode 100644
index 000000000..b75e327ee
--- /dev/null
+++ b/jscomp/build_tests/unboxed_bool_payload/src/Main.res
@@ -0,0 +1,14 @@
+@unboxed
+type t =
+  | Text(string)
+  | Num(float)
+  | Flag(bool)
+  | Obj({name: string})
+
+let classify = x =>
+  switch x {
+  | Text(_) => "text"
+  | Num(_) => "num"
+  | Flag(flag) => if flag {"flag:true"} else {"flag:false"}
+  | Obj({name}) => "obj:" ++ name
+  }
