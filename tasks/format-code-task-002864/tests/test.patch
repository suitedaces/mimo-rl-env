diff --git a/tests/dialects/test_trino.py b/tests/dialects/test_trino.py
index d597ef40a..ef2506d30 100644
--- a/tests/dialects/test_trino.py
+++ b/tests/dialects/test_trino.py
@@ -17,6 +17,57 @@ class TestTrino(Validator):
             "JSON_QUERY(content, 'strict $.HY.*' WITH UNCONDITIONAL WRAPPER KEEP QUOTES)"
         )
 
+    def test_json_query_with_array_wrapper(self):
+
+        self.validate_identity(
+            "JSON_QUERY(description, 'strict $.comment' WITH ARRAY WRAPPER)"
+        )
+
+    def test_json_query_without_array_wrapper(self):
+
+        self.validate_identity(
+            "JSON_QUERY(description, 'strict $.comment' WITHOUT ARRAY WRAPPER)"
+        )
+
+    def test_json_query_with_wrapper(self):
+
+        self.validate_identity(
+            "JSON_QUERY(description, 'strict $.comment' WITH WRAPPER)"
+        )
+
+    def test_json_query_without_wrapper(self):
+
+        self.validate_identity(
+            "JSON_QUERY(description, 'strict $.comment' WITHOUT WRAPPER)"
+        )
+
+    def test_json_query_preserves_existing_options(self):
+
+        self.validate_identity(
+            "JSON_QUERY(content, 'strict $.HY.*' WITH UNCONDITIONAL WRAPPER)"
+        )
+        self.validate_identity(
+            "JSON_QUERY(content, 'strict $.HY.*' WITHOUT CONDITIONAL WRAPPER)"
+        )
+        self.validate_identity(
+            "JSON_QUERY(content, 'strict $.HY.*' WITH UNCONDITIONAL ARRAY WRAPPER)"
+        )
+
+    def test_json_query_issue_full_statement(self):
+
+        import sqlglot
+        sql = (
+            "SELECT id, "
+            "json_query(description, 'strict $.comment' WITH ARRAY WRAPPER) AS with_array, "
+            "json_query(description, 'strict $.comment' WITHOUT ARRAY WRAPPER) AS without_array "
+            "FROM customers"
+        )
+
+        expr = sqlglot.parse_one(sql, read="trino")
+        out = expr.sql(dialect="trino")
+        self.assertIn("WITH ARRAY WRAPPER", out)
+        self.assertIn("WITHOUT ARRAY WRAPPER", out)
+
