+func TestCodespecConfigIncludePrecedenceAndAbsolutePaths(t *testing.T) {
+	dir := t.TempDir()
+	writeCodespecConfig(t, dir, "first.hujson", `{
+  "version": "alpha0",
+  "hostname": "first",
+  "acceptDNS": true
+}`)
+	second := writeCodespecConfig(t, dir, "second absolute.hujson", `{
+  "version": "alpha0",
+  "hostname": "second",
+  "acceptDNS": false
+}`)
+	root := writeCodespecConfig(t, dir, "root.hujson", fmt.Sprintf(`{
+  "version": "alpha0",
+  "include": ["first.hujson", %q],
+  "acceptDNS": true
+}`, second))
+
+	c := loadCodespecConfig(t, root)
+	if c.Parsed.Hostname == nil || *c.Parsed.Hostname != "second" {
+		t.Errorf("hostname = %v, want later include to win", c.Parsed.Hostname)
+	}
+	if !c.Parsed.AcceptDNS.EqualBool(true) {
+		t.Errorf("acceptDNS = %q, want including document to win", c.Parsed.AcceptDNS)
+	}
+}
+
+func TestCodespecConfigIncludeSharedDependencyIsNotCycle(t *testing.T) {
+	dir := t.TempDir()
+	writeCodespecConfig(t, dir, "shared.hujson", `{
+  "version": "alpha0",
+  "operatorUser": "shared-user"
+}`)
+	writeCodespecConfig(t, dir, "left.hujson", `{
+  "version": "alpha0",
+  "include": "shared.hujson",
+  "hostname": "left"
+}`)
+	writeCodespecConfig(t, dir, "right.hujson", `{
+  "version": "alpha0",
+  "include": "shared.hujson",
+  "acceptDNS": false
+}`)
+	root := writeCodespecConfig(t, dir, "root.hujson", `{
+  "version": "alpha0",
+  "include": ["left.hujson", "right.hujson"]
+}`)
+
+	c := loadCodespecConfig(t, root)
+	if c.Parsed.OperatorUser == nil || *c.Parsed.OperatorUser != "shared-user" {
+		t.Errorf("operatorUser = %v, want value from shared dependency", c.Parsed.OperatorUser)
+	}
+	if !c.Parsed.AcceptDNS.EqualBool(false) {
+		t.Errorf("acceptDNS = %q, want right branch value", c.Parsed.AcceptDNS)
+	}
+}
+
+func TestCodespecConfigIncludeCycleDiagnostics(t *testing.T) {
+	t.Run("self", func(t *testing.T) {
+		dir := t.TempDir()
+		root := writeCodespecConfig(t, dir, "self-ref.hujson", `{
+  "version": "alpha0",
+  "include": "self-ref.hujson"
+}`)
+		msg := requireCodespecLoadError(t, root, "self-ref.hujson")
+		lower := strings.ToLower(strings.ReplaceAll(msg, dir, ""))
+		if !strings.Contains(lower, "cycle") && !strings.Contains(lower, "cyclic") && !strings.Contains(lower, "recursive") {
+			t.Errorf("cycle error %q does not describe an include cycle", msg)
+		}
+	})
+
+	t.Run("indirect", func(t *testing.T) {
+		dir := t.TempDir()
+		a := writeCodespecConfig(t, dir, "graph-a.hujson", `{
+  "version": "alpha0",
+  "include": "nested/graph-b.hujson"
+}`)
+		writeCodespecConfig(t, dir, "nested/graph-b.hujson", `{
+  "version": "alpha0",
+  "include": "../graph-a.hujson"
+}`)
+		msg := requireCodespecLoadError(t, a, "graph-a.hujson", "graph-b.hujson")
+		lower := strings.ToLower(strings.ReplaceAll(msg, dir, ""))
+		if !strings.Contains(lower, "cycle") && !strings.Contains(lower, "cyclic") && !strings.Contains(lower, "recursive") {
+			t.Errorf("cycle error %q does not describe an include cycle", msg)
+		}
+	})
+}
+
+func TestCodespecConfigIncludeSourceErrors(t *testing.T) {
+	t.Run("missing", func(t *testing.T) {
+		dir := t.TempDir()
+		root := writeCodespecConfig(t, dir, "root.hujson", `{
+  "version": "alpha0",
+  "include": "missing-layer.hujson"
+}`)
+		requireCodespecLoadError(t, root, "missing-layer.hujson")
+	})
+
+	t.Run("malformed", func(t *testing.T) {
+		dir := t.TempDir()
+		writeCodespecConfig(t, dir, "malformed-layer.hujson", `{"version":"alpha0",`)
+		root := writeCodespecConfig(t, dir, "root.hujson", `{
+  "version": "alpha0",
+  "include": "malformed-layer.hujson"
+}`)
+		requireCodespecLoadError(t, root, "malformed-layer.hujson")
+	})
+
+	t.Run("missing-version", func(t *testing.T) {
+		dir := t.TempDir()
+		writeCodespecConfig(t, dir, "unversioned-layer.hujson", `{"hostname":"old"}`)
+		root := writeCodespecConfig(t, dir, "root.hujson", `{
+  "version": "alpha0",
+  "include": "unversioned-layer.hujson"
+}`)
+		requireCodespecLoadError(t, root, "unversioned-layer.hujson", "version")
+	})
+
+	t.Run("unsupported-version", func(t *testing.T) {
+		dir := t.TempDir()
+		writeCodespecConfig(t, dir, "future-layer.hujson", `{"version":"beta9"}`)
+		root := writeCodespecConfig(t, dir, "root.hujson", `{
+  "version": "alpha0",
+  "include": "future-layer.hujson"
+}`)
+		requireCodespecLoadError(t, root, "future-layer.hujson", "beta9")
+	})
+}
+
+func TestCodespecConfigIncludeStrictEffectiveSchema(t *testing.T) {
+	dir := t.TempDir()
+	writeCodespecConfig(t, dir, "unknown-field-layer.hujson", `{
+  "version": "alpha0",
+  "futureOption": true
+}`)
+	root := writeCodespecConfig(t, dir, "root.hujson", `{
+  "version": "alpha0",
+  "include": "unknown-field-layer.hujson"
+}`)
+	requireCodespecLoadError(t, root, "futureOption")
+}
+
+func TestCodespecConfigIncludeShapeErrors(t *testing.T) {
+	for _, tt := range []struct {
+		name    string
+		include string
+	}{
+		{name: "boolean", include: `true`},
+		{name: "object", include: `{"path":"layer.hujson"}`},
+		{name: "non-string-list-entry", include: `["layer.hujson", 7]`},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			dir := t.TempDir()
+			writeCodespecConfig(t, dir, "layer.hujson", `{"version":"alpha0"}`)
+			root := writeCodespecConfig(t, dir, "root.hujson", fmt.Sprintf(`{
+  "version": "alpha0",
+  "include": %s
+}`, tt.include))
+			requireCodespecLoadError(t, root, "include")
+		})
+	}
+}
+
+func TestCodespecConfigRootRawAndStandaloneCompatibility(t *testing.T) {
+	dir := t.TempDir()
+	raw := `{
+  // A normal standalone HuJSON file must keep working.
+  "version": "alpha0",
+  "enabled": false,
+  "hostname": "",
+}`
+	path := writeCodespecConfig(t, dir, "standalone.hujson", raw)
+	c := loadCodespecConfig(t, path)
+
+	if c.Path != path {
+		t.Errorf("Config.Path = %q, want %q", c.Path, path)
+	}
+	if !bytes.Equal(c.Raw, []byte(raw)) {
+		t.Error("Config.Raw changed for a standalone file")
+	}
+	if !json.Valid(c.Std) {
+		t.Fatalf("Config.Std is not standardized JSON: %q", c.Std)
+	}
+	if !c.Parsed.Enabled.EqualBool(false) {
+		t.Errorf("enabled = %q, want false", c.Parsed.Enabled)
+	}
+	if c.Parsed.Hostname == nil || *c.Parsed.Hostname != "" {
+		t.Errorf("hostname = %v, want explicit empty string", c.Parsed.Hostname)
+	}
+}
