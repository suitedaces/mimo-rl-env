+		var dexCfg map[string]interface{}
+		err = yaml.Unmarshal(config, &dexCfg)
+		if err != nil {
+			panic(err.Error())
+		}
+		oauth2Cfg, ok := dexCfg["oauth2"].(map[string]interface{})
+		assert.True(t, ok)
+		assert.Equal(t, "ldap", oauth2Cfg["passwordConnector"])
+
+		assert.Equal(t, true, oauth2Cfg["skipApprovalScreen"])
+	})
+
+	t.Run("OAuth2 skipApprovalScreen false preserved when user provides it", func(t *testing.T) {
+		dexConfig := `
+oauth2:
+  skipApprovalScreen: false
+  passwordConnector: ldap
+connectors:
+- type: ldap
+  name: LDAP
+  id: ldap
+  config:
+    host: myldap.company.com
+`
+		s := settings.ArgoCDSettings{
+			URL:       "http://localhost",
+			DexConfig: dexConfig,
+		}
+		config, err := GenerateDexConfigYAML(&s)
+		assert.NoError(t, err)
+		assert.NotNil(t, config)
+		var dexCfg map[string]interface{}
+		err = yaml.Unmarshal(config, &dexCfg)
+		if err != nil {
+			panic(err.Error())
+		}
+		oauth2Cfg, ok := dexCfg["oauth2"].(map[string]interface{})
+		assert.True(t, ok)
+		assert.Equal(t, false, oauth2Cfg["skipApprovalScreen"])
+		assert.Equal(t, "ldap", oauth2Cfg["passwordConnector"])
+	})
+
+	t.Run("OAuth2 default skipApprovalScreen true when user provides no oauth2", func(t *testing.T) {
+		s := settings.ArgoCDSettings{
+			URL:       "http://localhost",
+			DexConfig: goodDexConfig,
+		}
+		config, err := GenerateDexConfigYAML(&s)
+		assert.NoError(t, err)
+		assert.NotNil(t, config)
+		var dexCfg map[string]interface{}
+		err = yaml.Unmarshal(config, &dexCfg)
+		if err != nil {
+			panic(err.Error())
+		}
+		oauth2Cfg, ok := dexCfg["oauth2"].(map[string]interface{})
+		assert.True(t, ok)
+		assert.Equal(t, true, oauth2Cfg["skipApprovalScreen"])
+
+		assert.Equal(t, 1, len(oauth2Cfg))
