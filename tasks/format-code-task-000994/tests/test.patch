index 000000000..8e5fb8770
--- /dev/null
+++ b/socorro/unittest/processor/test_breakpad_pipe_to_json_edge_cases.py
@@ -0,0 +1,97 @@
+
+
+
+
+from nose.tools import eq_, ok_
+
+from socorro.processor.breakpad_pipe_to_json import pipe_dump_to_json_dump
+from socorro.unittest.testbase import TestCase
+
+
+class TestBreakpadPipeEdgeCases(TestCase):
+
+    def test_sparse_threads_and_malformed_rows_are_safe(self):
+        dump = pipe_dump_to_json_dump([
+            "Crash|SIGSEGV|0x10|2",
+            "2|4|libtwo.so|top||0|0x40",
+            "0|0|libzero.so|first||0|0x00",
+            "2|1|libtwo.so|earlier||0|0x10",
+            "-1|0|bad.so|negative||0|0x01",
+            "2|not-a-frame|libtwo.so|bad||0|0x41",
+            "x|1|libbad.so|bad||0|0x42",
+            "garbage",
+        ])
+
+
+
+        eq_(dump.thread_count, 3)
+        eq_(dump.threads[0].frame_count, 1)
+        eq_(dump.threads[1].frame_count, 0)
+        eq_(dump.threads[2].frame_count, 2)
+        eq_([frame.function for frame in dump.threads[2].frames],
+            ['earlier', 'top'])
+
+    def test_duplicate_frame_numbers_preserve_records_and_counts(self):
+        dump = pipe_dump_to_json_dump([
+            "1|7|lib.so|first||0|0x70",
+            "1|7|lib.so|second||0|0x71",
+            "1|8|lib.so|third||0|0x72",
+        ])
+
+
+
+        eq_(dump.thread_count, 2)
+        eq_(dump.threads[1].frame_count, 3)
+        eq_([frame.function for frame in dump.threads[1].frames],
+            ['first', 'second', 'third'])
+
+    def test_empty_crashing_thread_omits_summary(self):
+        empty_thread = pipe_dump_to_json_dump([
+            "Crash|SIGSEGV|0x10|0",
+            "1|0|lib.so|other||0|0x20",
+        ])
+
+
+        ok_('crashing_thread' not in empty_thread)
+        eq_(empty_thread.crash_info.crashing_thread, 0)
+
+    def test_invalid_crashing_thread_index_omits_summary(self):
+        invalid_thread = pipe_dump_to_json_dump([
+            "Crash|SIGSEGV|0x10|9",
+            "0|0|lib.so|only||0|0x20",
+        ])
+        ok_('crashing_thread' not in invalid_thread)
+        eq_(invalid_thread.crash_info.crashing_thread, 9)
+
+
+    def test_negative_crashing_thread_index_omits_summary(self):
+        negative_thread = pipe_dump_to_json_dump([
+            "Crash|SIGSEGV|0x10|-1",
+            "0|0|lib.so|only||0|0x20",
+        ])
+        ok_('crashing_thread' not in negative_thread)
+        eq_(negative_thread.crash_info.crashing_thread, -1)
+
+    def test_valid_crashing_thread_summary_is_consistent(self):
+        rows = ["Crash|SIGSEGV|0x10|2"]
+        rows.extend(
+            "2|%d|lib.so|frame%d||0|0x20" % (number, number)
+            for number in reversed(range(12))
+        )
+        dump = pipe_dump_to_json_dump(rows)
+
+        eq_(dump.crashing_thread.threads_index, 2)
+        eq_(dump.crashing_thread.total_frames, 12)
+        eq_(dump.crashing_thread.frames, dump.threads[2].frames[:10])
+        eq_([frame.frame for frame in dump.crashing_thread.frames],
+            list(range(10)))
+
+    def test_status_record_is_exposed(self):
+        successful = pipe_dump_to_json_dump(["Status|OK"])
+        failed = pipe_dump_to_json_dump([
+            "Status|ERROR_NO_THREAD_LIST",
+            "unrecognized|content",
+        ])
+
+        eq_(successful.status, 'OK')
+        eq_(failed.status, 'ERROR_NO_THREAD_LIST')
