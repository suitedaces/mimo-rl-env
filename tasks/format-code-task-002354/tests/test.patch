diff --git a/tests/test_docstring_backslash_whitespace.py b/tests/test_docstring_backslash_whitespace.py
new file mode 100644
index 0000000..1e836e8
--- /dev/null
+++ b/tests/test_docstring_backslash_whitespace.py
@@ -0,0 +1,127 @@
+
+
+
+
+
+
+
+
+
+
+
+
+
+import pytest
+
+import black
+
+pytestmark = pytest.mark.filterwarnings(
+    "ignore:invalid escape sequence.*:DeprecationWarning"
+)
+
+
+def _format(src: str) -> str:
+    return black.format_str(src, mode=black.Mode())
+
+
+def test_issue_repro_backslash_space_newline_in_docstring() -> None:
+
+    src = (
+        "class Database:\n"
+        '    """\n'
+        "    ## Database Base Class\n"
+        "    The custom ORM specificaly created for the project.\\ \n"
+        "    Provides a lot of functions to interact with the database in a"
+        " pythonic, easy and\n"
+        "    fast way.\n"
+        '    """\n'
+        "    def __init__(self):\n"
+        "        ...\n"
+    )
+    out = _format(src)
+    black.assert_equivalent(src, out)
+    assert "\\ \n" in out
+
+
+def test_backslash_single_space_newline_preserved() -> None:
+    src = (
+        "def foo():\n"
+        '    """line one.\\ \n'
+        "    line two.\n"
+        '    """\n'
+        "    pass\n"
+    )
+    out = _format(src)
+    black.assert_equivalent(src, out)
+    assert "\\ \n" in out
+
+
+def test_backslash_tab_newline_preserved() -> None:
+    src = (
+        "def foo():\n"
+        '    """line one.\\\t\n'
+        "    line two.\n"
+        '    """\n'
+        "    pass\n"
+    )
+    out = _format(src)
+    black.assert_equivalent(src, out)
+    assert "\\\t\n" in out
+
+
+def test_backslash_multiple_spaces_newline_preserved() -> None:
+    src = (
+        "def foo():\n"
+        '    """line one.\\   \n'
+        "    line two.\n"
+        '    """\n'
+        "    pass\n"
+    )
+    out = _format(src)
+    black.assert_equivalent(src, out)
+    assert "\\   \n" in out
+
+
+def test_plain_backslash_newline_still_preserved() -> None:
+
+
+    src = (
+        "def foo():\n"
+        '    """line one.\\\n'
+        "    line two.\n"
+        '    """\n'
+        "    pass\n"
+    )
+    out = _format(src)
+    black.assert_equivalent(src, out)
+    assert "\\\n" in out
+
+
+def test_docstring_without_backslash_still_normalized() -> None:
+
+
+    src = 'def foo():\n    """  hi  """\n    pass\n'
+    out = _format(src)
+    assert out == 'def foo():\n    """hi"""\n    pass\n'
+
+
+def test_format_file_contents_does_not_raise_on_backslash_space_newline() -> None:
+
+
+    src = (
+        "class Database:\n"
+        '    """\n'
+        "    Header.\n"
+        "    Content.\\ \n"
+        "    More content here so the docstring is non-trivial.\n"
+        '    """\n'
+        "    def __init__(self):\n"
+        "        ...\n"
+    )
+
+
+    try:
+        out = black.format_file_contents(src, fast=False, mode=black.Mode())
+    except black.NothingChanged:
+        out = src
+    assert "\\ \n" in out
