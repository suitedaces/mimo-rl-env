+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+PYTHONPATH=src python -m pytest -v -rA tests/test_docstring_backslash_whitespace.py::test_issue_repro_backslash_space_newline_in_docstring tests/test_docstring_backslash_whitespace.py::test_backslash_single_space_newline_preserved tests/test_docstring_backslash_whitespace.py::test_backslash_tab_newline_preserved tests/test_docstring_backslash_whitespace.py::test_backslash_multiple_spaces_newline_preserved tests/test_docstring_backslash_whitespace.py::test_plain_backslash_newline_still_preserved tests/test_docstring_backslash_whitespace.py::test_docstring_without_backslash_still_normalized tests/test_docstring_backslash_whitespace.py::test_format_file_contents_does_not_raise_on_backslash_space_newline
+rc=$(( rc | $? ))
+exit $rc
