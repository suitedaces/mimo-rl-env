@@ -56,6 +56,56 @@ class GiniTests(TestCase):
         with self.assertRaises(ValueError):
             _lorenz_curve_integrator(self.lorenz_curve_points, 'brofist')
 
+    def test_gini_index_uniform_default_method(self):
+
+        obs = gini_index([2, 2, 2, 2, 2])
+        self.assertAlmostEqual(obs, 0.0)
+
+    def test_gini_index_uniform_rectangles(self):
+
+        obs = gini_index([2, 2, 2, 2, 2], 'rectangles')
+        self.assertAlmostEqual(obs, 0.0)
+
+    def test_gini_index_uniform_trapezoids(self):
+
+        obs = gini_index([2, 2, 2, 2, 2], 'trapezoids')
+        self.assertAlmostEqual(obs, 0.0)
+
+    def test_gini_index_uniform_not_negative(self):
+
+        obs = gini_index([2, 2, 2, 2, 2])
+        self.assertGreaterEqual(obs, 0.0)
+
+    def test_gini_index_near_uniform_rectangles_not_negative(self):
+
+
+        obs = gini_index([2, 2, 2, 2, 3], 'rectangles')
+        self.assertAlmostEqual(obs, 0.0)
+        self.assertGreaterEqual(obs, 0.0)
+
+    def test_gini_index_rectangles_preserved(self):
+
+        exp = 0.20271210013908214
+        obs = gini_index(self.data, 'rectangles')
+        self.assertAlmostEqual(obs, exp)
+
+    def test_gini_index_trapezoids_preserved(self):
+
+        exp = 0.32771210013908214
+        obs = gini_index(self.data, 'trapezoids')
+        self.assertAlmostEqual(obs, exp)
+
+    def test_gini_index_default_is_rectangles(self):
+
+        obs_default = gini_index(self.data)
+        obs_rectangles = gini_index(self.data, 'rectangles')
+        self.assertAlmostEqual(obs_default, obs_rectangles)
+
+    def test_gini_index_invalid_method_raises(self):
+
+        with self.assertRaises(ValueError):
+            gini_index([1.0, 2.0, 3.0], method='brofist')
+
 
 if __name__ == '__main__':
