+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+
+
+set -euo pipefail
+
+export LANG=C.UTF-8
+export LC_ALL=C.UTF-8
+export LANGUAGE=en_US
+export GOPATH=/root/go
+export GOMODCACHE=/root/go/pkg/mod
+export GOCACHE=/opt/coderl-go-build-cache
+export GOPROXY=off
+export GOSUMDB=off
+export GOVCS='*:off'
+export GOTOOLCHAIN=local
+
+cd /workspace/repo
+exec go test -mod=readonly -v -count=1 ./usercase-test-coderl
