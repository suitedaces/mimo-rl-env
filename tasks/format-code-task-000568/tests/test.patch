diff --git a/usercase-test-coderl/fixtures/playlist_cli_harness.py b/usercase-test-coderl/fixtures/playlist_cli_harness.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/fixtures/playlist_cli_harness.py
@@ -0,0 +1,84 @@
+#!/usr/bin/env python
+from __future__ import unicode_literals
+
+import importlib
+import sys
+
+sys.path.insert(0, '/workspace/repo')
+
+import youtube_dlc
+from youtube_dlc.extractor.common import InfoExtractor
+from youtube_dlc.utils import OnDemandPagedList
+
+ytdl_mod = importlib.import_module('youtube_dlc.YoutubeDL')
+
+
+def video_entry(idx):
+    return {
+        'id': 'v%s' % idx,
+        'title': 'Video %s' % idx,
+        'url': 'http://media.example.invalid/video%s.mp4' % idx,
+        'ext': 'mp4',
+    }
+
+
+class OfflineListIE(InfoExtractor):
+    IE_NAME = 'offline:list'
+    _VALID_URL = r'offline:list$'
+
+    def _real_extract(self, url):
+        return {
+            '_type': 'playlist',
+            'id': 'loaded',
+            'title': 'Loaded Fixture',
+            'entries': [video_entry(i) for i in range(1, 5)],
+            'extractor': self.IE_NAME,
+            'extractor_key': self.ie_key(),
+            'webpage_url': url,
+        }
+
+
+class OfflinePagedIE(InfoExtractor):
+    IE_NAME = 'offline:paged'
+    _VALID_URL = r'offline:paged$'
+
+    def _real_extract(self, url):
+        def pagefunc(page_num):
+            start = page_num * 2 + 1
+            if start > 4:
+                return []
+            return [video_entry(i) for i in range(start, min(start + 2, 5))]
+
+        return {
+            '_type': 'playlist',
+            'id': 'paged',
+            'title': 'Paged Fixture',
+            'entries': OnDemandPagedList(pagefunc, 2),
+            'extractor': self.IE_NAME,
+            'extractor_key': self.ie_key(),
+            'webpage_url': url,
+        }
+
+
+class OfflineIterableIE(InfoExtractor):
+    IE_NAME = 'offline:iterable'
+    _VALID_URL = r'offline:iterable$'
+
+    def _real_extract(self, url):
+        def entries():
+            for i in range(1, 5):
+                yield video_entry(i)
+
+        return {
+            '_type': 'playlist',
+            'id': 'iterable',
+            'title': 'Iterable Fixture',
+            'entries': entries(),
+            'extractor': self.IE_NAME,
+            'extractor_key': self.ie_key(),
+            'webpage_url': url,
+        }
+
+
+ytdl_mod.gen_extractor_classes = lambda: [OfflineListIE(), OfflinePagedIE(), OfflineIterableIE()]
+youtube_dlc.main(sys.argv[1:])
diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,152 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC PYTHONPATH=/workspace/repo PYTHONDONTWRITEBYTECODE=1
+
+
+
+( cd /workspace/repo && python -B -m youtube_dlc --ignore-config --version >/dev/null ) \
+    || { echo "FAIL: build" >&2; exit 1; }
+
+BIN="python -B /workspace/repo/usercase-test-coderl/fixtures/playlist_cli_harness.py"
+HELP_BIN="python -B -m youtube_dlc --ignore-config"
+
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || exit 1
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+assert_file_eq() {
+    local label=$1 expected=$2 actual_file=$3
+    local actual
+    actual=$(cat "$actual_file")
+    [ "$actual" = "$expected" ] || fail "$label: got [$actual]"
+}
+
+assert_no_crash_stderr() {
+    local label=$1 stderr_file=$2
+
+    ! grep -Eiq 'Traceback \(most recent call last\)|SyntaxError|ImportError|ModuleNotFoundError' "$stderr_file" \
+        || fail "$label stderr shows internal crash: $(cat "$stderr_file")"
+}
+
+
+
+
+$HELP_BIN --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+grep -q -- '--playlist-items ITEM_SPEC' out || fail "F1 missing --playlist-items ITEM_SPEC"
+
+grep -qi -- 'comma' out || fail "F1 missing comma-separated description"
+grep -qi -- 'range' out || fail "F1 missing range description"
+assert_no_crash_stderr "F1" err
+
+
+
+
+$BIN --playlist-items 2,4 --get-id offline:list >out 2>err; ec=$?
+EXPECTED=$'v2\nv4'
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_file_eq "F2 stdout" "$EXPECTED" out
+assert_no_crash_stderr "F2" err
+
+
+
+
+$BIN --playlist-items 2-4 --get-id offline:list >out 2>err; ec=$?
+EXPECTED=$'v2\nv3\nv4'
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+assert_file_eq "F3 stdout" "$EXPECTED" out
+assert_no_crash_stderr "F3" err
+
+
+
+
+$BIN --playlist-items 2-4,3-4,3 --get-id offline:list >out 2>err; ec=$?
+EXPECTED=$'v2\nv3\nv4'
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+assert_file_eq "F4 stdout" "$EXPECTED" out
+assert_no_crash_stderr "F4" err
+
+
+
+
+$BIN --playlist-items 3-10 --get-id offline:list >out 2>err; ec=$?
+EXPECTED=$'v3\nv4'
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+assert_file_eq "F5 stdout" "$EXPECTED" out
+assert_no_crash_stderr "F5" err
+
+
+
+
+$BIN --playlist-items 10 --get-id offline:list >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+[ ! -s out ] || fail "F6 stdout should be empty: $(cat out)"
+assert_no_crash_stderr "F6" err
+
+
+
+
+$BIN --playlist-items 2,4 --simulate offline:list >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F7 exit $ec; want 0"
+
+grep -Eiq -- '(downloading[^0-9]*2|2[^0-9]*videos|of[[:space:]]+2)' out || fail "F7 stdout missing selected download count: $(cat out)"
+! grep -Eiq -- '(downloading[^0-9]*4|of[[:space:]]+4)' out || fail "F7 stdout reported full playlist count: $(cat out)"
+assert_no_crash_stderr "F7" err
+
+
+
+
+$BIN --playlist-items 4,2 --dump-json offline:list >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F8 exit $ec; want 0"
+python - "$PWD/out" <<'PY' || exit 1
+from __future__ import print_function
+import json
+import sys
+
+with open(sys.argv[1], 'r') as f:
+    rows = [json.loads(line) for line in f if line.strip()]
+expected = [('v4', 4), ('v2', 2)]
+actual = [(row.get('id'), row.get('playlist_index')) for row in rows]
+if actual != expected:
+    print('FAIL: F8 JSON id/index: %r' % (actual,), file=sys.stderr)
+    sys.exit(1)
+PY
+assert_no_crash_stderr "F8" err
+
+
+
+
+$BIN --playlist-items 2,4 --get-id offline:paged >out 2>err; ec=$?
+EXPECTED=$'v2\nv4'
+[ "$ec" -eq 0 ] || fail "F9 exit $ec; want 0"
+assert_file_eq "F9 stdout" "$EXPECTED" out
+assert_no_crash_stderr "F9" err
+
+
+
+
+$BIN --playlist-items 3-10 --get-id offline:iterable >out 2>err; ec=$?
+EXPECTED=$'v3\nv4'
+[ "$ec" -eq 0 ] || fail "F10 exit $ec; want 0"
+assert_file_eq "F10 stdout" "$EXPECTED" out
+assert_no_crash_stderr "F10" err
+
+
+
+
+$BIN --playlist-items abc --get-id offline:list >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F11 exit should be non-zero"
+
+! grep -Eq '^v[1-4]$' out || fail "F11 malformed spec downloaded entries: $(cat out)"
+
+
+
+
+$BIN --playlist-items 2-x --get-id offline:list >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F12 exit should be non-zero"
+
+! grep -Eq '^v[1-4]$' out || fail "F12 malformed spec downloaded entries: $(cat out)"
+
+echo "PASS"
+exit 0
