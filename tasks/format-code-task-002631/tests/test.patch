     });
+
+  });
+
+  describe('#getValueFromFile() fallback integration', () => {
+    it('should fall back to self value when file is missing using overwrite syntax', () => {
+      const serverless = new Serverless();
+      const tmpDirPath = testUtils.getTmpDirPath();
+      serverless.config.update({ servicePath: tmpDirPath });
+      serverless.variables.service = {
+        custom: {
+          configuration: {
+            iamRoleARN: 'arn:aws:iam::890665980307:role/AA-Lambda-Execution-Role',
+          },
+        },
+        defaults: serverless.service.defaults,
+      };
+      serverless.variables.loadVariableSyntax();
+
+      const result = serverless.variables
+        .overwrite('file(./.slsconfig):iamRoleARN,self:custom.configuration.iamRoleARN');
+      expect(result).to.equal('arn:aws:iam::890665980307:role/AA-Lambda-Execution-Role');
+    });
+
+    it('should fall back to populated property when file is missing', () => {
+      const serverless = new Serverless();
+      const tmpDirPath = testUtils.getTmpDirPath();
+      serverless.config.update({ servicePath: tmpDirPath });
+      serverless.service.custom = {
+        configuration: {
+          iamRoleARN: 'fallback-role',
+        },
+      };
+      serverless.service.provider = {
+        name: 'aws',
+        iamRoleARN: '${file(./.slsconfig):iamRoleARN, self:custom.configuration.iamRoleARN}',
+      };
+
+      serverless.variables.populateService();
+      expect(serverless.service.provider.iamRoleARN).to.equal('fallback-role');
+    });
+
+    it('should not crash populateService when file is missing and no fallback given', () => {
+      const serverless = new Serverless();
+      const tmpDirPath = testUtils.getTmpDirPath();
+      serverless.config.update({ servicePath: tmpDirPath });
+      serverless.service.custom = {};
+      serverless.service.provider = {
+        name: 'aws',
+        iamRoleARN: '${file(./missing.yml):iamRoleARN}',
+      };
+
+      expect(() => serverless.variables.populateService()).to.not.throw();
+    });
+
+    it('should use file value when file exists with fallback present', () => {
+      const serverless = new Serverless();
+      const SUtils = new Utils();
+      const tmpDirPath = testUtils.getTmpDirPath();
+      SUtils.writeFileSync(path.join(tmpDirPath, 'slsconfig.yml'),
+        YAML.dump({ iamRoleARN: 'from-file-role' }));
+      serverless.config.update({ servicePath: tmpDirPath });
+      serverless.service.custom = {
+        configuration: {
+          iamRoleARN: 'fallback-role',
+        },
+      };
+      serverless.service.provider = {
+        name: 'aws',
+        iamRoleARN: '${file(./slsconfig.yml):iamRoleARN, self:custom.configuration.iamRoleARN}',
+      };
+
+      serverless.variables.populateService();
+      expect(serverless.service.provider.iamRoleARN).to.equal('from-file-role');
+    });
   });
 
