@@ -0,0 +1,163 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+( cd /workspace/repo && python3 -m compileall -q udiskie usercase-test-coderl/fixtures ) \
+    || fail "build"
+
+BIN=(python3 /workspace/repo/usercase-test-coderl/fixtures/run_umount_fixture.py)
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+export HOME="$TMP/home"
+export XDG_CONFIG_HOME="$TMP/config"
+mkdir -p "$HOME" "$XDG_CONFIG_HOME"
+cd "$TMP" || fail "cd temp"
+
+run_umount() {
+    local scenario=$1
+    shift
+    : >trace
+    UDISKIE_FAKE_SCENARIO="$scenario" UDISKIE_FAKE_TRACE="$TMP/trace" "${BIN[@]}" "$@" >out 2>err
+    ec=$?
+}
+
+assert_sorted_trace() {
+    local expected=$1
+    sort trace >trace.sorted
+    [ "$(cat trace.sorted)" = "$expected" ] || fail "$2 operations: $(cat trace)"
+}
+
+has_line() {
+    grep -Fqx "$1" "$2"
+}
+
+
+
+
+run_umount default --all
+EXPECTED_F1=$(cat <<'EOF'
+lock /dev/cryptdisk1
+unmount /dev/mapper/secret
+unmount /dev/rootdisk1
+unmount /dev/standalone
+EOF
+)
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+
+assert_sorted_trace "$EXPECTED_F1" "F1"
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+
+
+
+
+run_umount default -a
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+
+assert_sorted_trace "$EXPECTED_F1" "F2"
+[ ! -s err ] || fail "F2 unexpected stderr: $(cat err)"
+
+
+
+
+run_umount strategy --all --detach --eject --no-lock
+EXPECTED_F3=$(cat <<'EOF'
+detach /dev/usbA
+detach /dev/usbB
+eject /dev/usbA
+eject /dev/usbB
+unmount /dev/usbA
+unmount /dev/usbB
+EOF
+)
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+
+assert_sorted_trace "$EXPECTED_F3" "F3"
+[ ! -s err ] || fail "F3 unexpected stderr: $(cat err)"
+
+
+
+
+run_umount strategy --all --no-detach --no-eject --lock
+EXPECTED_F4=$(cat <<'EOF'
+unmount /dev/usbA
+unmount /dev/usbB
+EOF
+)
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+
+assert_sorted_trace "$EXPECTED_F4" "F4"
+[ ! -s err ] || fail "F4 unexpected stderr: $(cat err)"
+
+
+
+
+run_umount failure --all
+[ "$ec" -eq 1 ] || fail "F5 exit $ec; want 1"
+
+has_line "unmount /dev/good1" trace || fail "F5 missing successful root operation: $(cat trace)"
+has_line "unmount /dev/fail1" trace || fail "F5 missing failing root attempt: $(cat trace)"
+
+
+
+
+run_umount default --all /dev/standalone
+
+[ "$ec" -ne 0 ] || fail "F6 exit $ec; want nonzero"
+[ ! -s out ] || fail "F6 unexpected stdout: $(cat out)"
+
+[ ! -s trace ] || fail "F6 should not attempt removals: $(cat trace)"
+grep -Fq "udiskie-umount" err || fail "F6 stderr missing command usage"
+
+
+
+
+"${BIN[@]}" --help >out 2>err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F7 exit $ec; want 0"
+
+grep -Eq "udiskie-umount .*\\((-a|--all)[^)]*\\|[^)]*(DEVICE|PATH)" out \
+    || fail "F7 help missing all-or-device usage"
+
+grep -Eq -- "-a([^[:alnum:]-]+.*)?--all|--all([^[:alnum:]-]+.*)?-a" out \
+    || fail "F7 help missing -a, --all option"
+[ ! -s err ] || fail "F7 unexpected stderr: $(cat err)"
+
+
+
+
+
+grep -Eq -- "(^|[^[:alnum:]-])-a([^[:alnum:]]|$)" /workspace/repo/completions/bash/udiskie-umount \
+    || fail "F8 bash completion missing -a"
+
+grep -Eq -- "(^|[^[:alnum:]-])--all([^[:alnum:]]|$)" /workspace/repo/completions/bash/udiskie-umount \
+    || fail "F8 bash completion missing --all"
+
+grep -Eq -- "(^|[^[:alnum:]-])-a([^[:alnum:]]|$)" /workspace/repo/completions/zsh/_udiskie-umount \
+    || fail "F8 zsh completion missing -a"
+
+grep -Eq -- "(^|[^[:alnum:]-])--all([^[:alnum:]]|$)" /workspace/repo/completions/zsh/_udiskie-umount \
+    || fail "F8 zsh completion missing --all"
+
+
+
+
+
+grep -Eq "udiskie-umount.*\\((-a|--all)[^)]*\\|[^)]*(PATH|DEVICE)" /workspace/repo/doc/udiskie.8.txt \
+    || fail "F9 manpage missing all-or-path synopsis"
+MAN_UNMOUNT_SECTION=$(sed -n '/^Unmount options$/,/^Example Usage/p' /workspace/repo/doc/udiskie.8.txt)
+
+grep -Eq -- "(^|[^[:alnum:]-])-a([^[:alnum:]]|$)" <<<"$MAN_UNMOUNT_SECTION" \
+    || fail "F9 manpage missing -a option"
+
+grep -Eq -- "(^|[^[:alnum:]-])\\\\?--all([^[:alnum:]]|$)" <<<"$MAN_UNMOUNT_SECTION" \
+    || fail "F9 manpage missing --all option"
+
+grep -Eiq "unmount .*all .*handle" <<<"$MAN_UNMOUNT_SECTION" \
+    || fail "F9 manpage missing unmount-all description"
+
+echo "PASS"
+exit 0
