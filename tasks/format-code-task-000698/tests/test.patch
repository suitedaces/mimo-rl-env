new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/fixtures/run_umount_fixture.py
@@ -0,0 +1,242 @@
+#!/usr/bin/env python3
+import os
+import sys
+
+sys.path.insert(0, "/workspace/repo")
+
+
+def trace(action, device):
+    path = os.environ.get("UDISKIE_FAKE_TRACE")
+    if path:
+        with open(path, "a", encoding="utf-8") as fp:
+            fp.write(f"{action} {device}\n")
+
+
+class FakeDevice:
+    def __init__(self, name, parent="/", **kw):
+        self.object_path = kw.pop("object_path", "/fake/" + name.strip("/").replace("/", "_"))
+        self.parent_object_path = parent
+        self.device_presentation = name
+        self.device_file = name
+        self.mount_paths = kw.pop("mount_paths", ["/mnt/" + name.rsplit("/", 1)[-1]])
+        self.mount_path = self.mount_paths[0] if self.mount_paths else None
+        self.is_drive = kw.pop("is_drive", False)
+        self.is_block = kw.pop("is_block", True)
+        self.is_partition_table = kw.pop("is_partition_table", False)
+        self.is_partition = kw.pop("is_partition", False)
+        self.is_filesystem = kw.pop("is_filesystem", False)
+        self.is_luks = kw.pop("is_luks", False)
+        self.is_loop = kw.pop("is_loop", False)
+        self.is_loopfile = kw.pop("is_loopfile", False)
+        self.is_toplevel = kw.pop("is_toplevel", parent == "/")
+        self.is_detachable = kw.pop("is_detachable", False)
+        self.is_ejectable = kw.pop("is_ejectable", False)
+        self.has_media = kw.pop("has_media", False)
+        self.is_crypto = kw.pop("is_crypto", False)
+        self.is_ignored = kw.pop("is_ignored", False)
+        self.id_type = kw.pop("id_type", "")
+        self.id_usage = kw.pop("id_usage", "")
+        self.id_label = kw.pop("id_label", "")
+        self.id_uuid = kw.pop("id_uuid", "")
+        self.device_id = kw.pop("device_id", "")
+        self.device_size = kw.pop("device_size", 0)
+        self.is_luks_cleartext = kw.pop("is_luks_cleartext", False)
+        self.is_external = kw.pop("is_external", True)
+        self.is_systeminternal = kw.pop("is_systeminternal", False)
+        self.is_mounted = kw.pop("is_mounted", False)
+        self.is_unlocked = kw.pop("is_unlocked", False)
+        self.in_use = kw.pop("in_use", False)
+        self.should_automount = kw.pop("should_automount", True)
+        self.ui_label = kw.pop("ui_label", name)
+        self.ui_label_dialog = kw.pop("ui_label_dialog", name)
+        self.loop_file = kw.pop("loop_file", "")
+        self.setup_by_uid = kw.pop("setup_by_uid", 1000)
+        self.autoclear = kw.pop("autoclear", False)
+        self.symlinks = kw.pop("symlinks", [])
+        self.drive_model = kw.pop("drive_model", "")
+        self.drive_vendor = kw.pop("drive_vendor", "")
+        self.drive_label = kw.pop("drive_label", "")
+        self.ui_device_label = kw.pop("ui_device_label", name)
+        self.ui_device_presentation = kw.pop("ui_device_presentation", name)
+        self.ui_id_label = kw.pop("ui_id_label", "")
+        self.ui_id_uuid = kw.pop("ui_id_uuid", "")
+        self.partition_slave = kw.pop("partition_slave", None)
+        self.luks_cleartext_slave = kw.pop("luks_cleartext_slave", None)
+        self.luks_cleartext_holder = kw.pop("luks_cleartext_holder", None)
+        self.drive = kw.pop("drive", self)
+        self.root = kw.pop("root", self)
+        self.fail_unmount = kw.pop("fail_unmount", False)
+        if kw:
+            raise TypeError("unused fake device args: " + ", ".join(sorted(kw)))
+
+    def __str__(self):
+        return self.device_presentation
+
+    async def unmount(self):
+
+        trace("unmount", self.device_presentation)
+        if self.fail_unmount:
+            raise RuntimeError("busy")
+        self.is_mounted = False
+
+    async def lock(self):
+
+        trace("lock", self.device_presentation)
+        self.is_unlocked = False
+
+    async def eject(self):
+
+        trace("eject", self.device_presentation)
+        self.has_media = False
+
+    async def detach(self):
+
+        trace("detach", self.device_presentation)
+        self.is_detachable = False
+
+    async def delete(self):
+
+        trace("delete", self.device_presentation)
+        self.is_loop = False
+
+
+class FakeUDisks:
+    keyfile_support = False
+    version_info = (2, 10, 0)
+
+    def __init__(self, scenario):
+        self.devices = make_devices(scenario)
+        self.by_path = {}
+        for dev in self.devices:
+            self.by_path[dev.object_path] = dev
+            self.by_path[dev.device_presentation] = dev
+            self.by_path[dev.device_file] = dev
+            for path in dev.mount_paths:
+                self.by_path[path] = dev
+
+    def __iter__(self):
+        return iter(self.devices)
+
+    def __getitem__(self, path):
+        return self.by_path[path]
+
+    def find(self, path):
+        if isinstance(path, FakeDevice):
+            return path
+        try:
+            return self.by_path[path]
+        except KeyError:
+            raise FileNotFoundError(path)
+
+    async def _sync(self):
+        return None
+
+
+def make_drive(name, **kw):
+    return FakeDevice(
+        name,
+        is_drive=True,
+        is_toplevel=True,
+        is_detachable=kw.pop("is_detachable", True),
+        is_ejectable=kw.pop("is_ejectable", True),
+        has_media=kw.pop("has_media", True),
+        **kw
+    )
+
+
+def make_devices(scenario):
+    if scenario == "strategy":
+        usb_a = make_drive("/dev/usbA", is_filesystem=True, is_mounted=True)
+        usb_b = make_drive("/dev/usbB", is_filesystem=True, is_mounted=True)
+        return [usb_b, usb_a]
+
+    if scenario == "failure":
+        fail_root = make_drive("/dev/faildisk", is_filesystem=False)
+        fail_part = FakeDevice(
+            "/dev/fail1",
+            parent=fail_root.object_path,
+            is_partition=True,
+            is_filesystem=True,
+            is_mounted=True,
+            partition_slave=fail_root,
+            drive=fail_root,
+            root=fail_root,
+            fail_unmount=True,
+        )
+        good_root = make_drive("/dev/gooddisk", is_filesystem=False)
+        good_part = FakeDevice(
+            "/dev/good1",
+            parent=good_root.object_path,
+            is_partition=True,
+            is_filesystem=True,
+            is_mounted=True,
+            partition_slave=good_root,
+            drive=good_root,
+            root=good_root,
+        )
+        return [good_part, fail_root, good_root, fail_part]
+
+    root_disk = make_drive("/dev/rootdisk", is_filesystem=False)
+    root_part = FakeDevice(
+        "/dev/rootdisk1",
+        parent=root_disk.object_path,
+        is_partition=True,
+        is_filesystem=True,
+        is_mounted=True,
+        partition_slave=root_disk,
+        drive=root_disk,
+        root=root_disk,
+    )
+    crypt_disk = make_drive("/dev/cryptdisk", is_filesystem=False)
+    crypt_part = FakeDevice(
+        "/dev/cryptdisk1",
+        parent=crypt_disk.object_path,
+        is_partition=True,
+        is_crypto=True,
+        is_unlocked=True,
+        partition_slave=crypt_disk,
+        drive=crypt_disk,
+        root=crypt_disk,
+    )
+    clear = FakeDevice(
+        "/dev/mapper/secret",
+        parent=crypt_part.object_path,
+        is_filesystem=True,
+        is_luks_cleartext=True,
+        is_mounted=True,
+        is_toplevel=False,
+        luks_cleartext_slave=crypt_part,
+        drive=crypt_disk,
+        root=crypt_disk,
+    )
+    crypt_part.luks_cleartext_holder = clear
+    standalone = FakeDevice(
+        "/dev/standalone",
+        is_filesystem=True,
+        is_mounted=True,
+        is_toplevel=True,
+    )
+    ignored = make_drive(
+        "/dev/internal",
+        is_external=False,
+        is_detachable=False,
+        is_ejectable=False,
+        has_media=False,
+    )
+    return [root_part, ignored, clear, crypt_disk, standalone, root_disk, crypt_part]
+
+
+async def fake_create():
+    return FakeUDisks(os.environ.get("UDISKIE_FAKE_SCENARIO", "default"))
+
+
+def main():
+    import udiskie.udisks2
+    from udiskie.cli import Umount
+
+    udiskie.udisks2.Daemon.create = staticmethod(fake_create)
+    sys.exit(Umount.main())
+
+
+if __name__ == "__main__":
+    main()
