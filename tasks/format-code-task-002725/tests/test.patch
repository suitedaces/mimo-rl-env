diff --git a/test/rules/std_RF02_test.py b/test/rules/std_RF02_test.py
index e9a774693..3a1a51843 100644
--- a/test/rules/std_RF02_test.py
+++ b/test/rules/std_RF02_test.py
@@ -13,3 +13,146 @@ def test__rules__std_RF02_wildcard_single_count():
     result = sqlfluff.lint(sql)
     assert "RF02" in [r["code"] for r in result]
     assert [r["code"] for r in result].count("RF02") == 1
+
+
+def _rf02_count(sql, dialect="ansi"):
+    return [r["code"] for r in sqlfluff.lint(sql, dialect=dialect)].count("RF02")
+
+
+def test__rules__std_RF02_issue_repro_trino():
+    """Issue 6649: a FROM-subquery with one inner table must not trigger RF02 (Trino)."""
+    sql = (
+        "SELECT\n"
+        "    a.id AS a_id,\n"
+        "    b.id AS b_id\n"
+        "FROM\n"
+        "    (\n"
+        "        SELECT id\n"
+        "        FROM foo\n"
+        "    ) AS a\n"
+        "JOIN bar AS b ON a.id = b.ib\n"
+    )
+    assert _rf02_count(sql, dialect="trino") == 0
+
+
+def test__rules__std_RF02_issue_repro_ansi():
+    """Issue 6649: same as above but in ANSI dialect — must not trigger RF02."""
+    sql = (
+        "SELECT\n"
+        "    a.id AS a_id,\n"
+        "    b.id AS b_id\n"
+        "FROM\n"
+        "    (\n"
+        "        SELECT id\n"
+        "        FROM foo\n"
+        "    ) AS a\n"
+        "JOIN bar AS b ON a.id = b.ib\n"
+    )
+    assert _rf02_count(sql, dialect="ansi") == 0
+
+
+def test__rules__std_RF02_from_subquery_single_table_unqualified():
+    """A FROM-subquery referencing only one inner table must not trigger RF02
+    even though the outer query has multiple tables.
+    """
+    sql = (
+        "SELECT a.x, b.y\n"
+        "FROM (SELECT id, x FROM only_one) AS a\n"
+        "JOIN other AS b ON a.id = b.id\n"
+    )
+    assert _rf02_count(sql) == 0
+
+
+def test__rules__std_RF02_from_subquery_multi_table_unqualified_still_fails():
+    """Preservation: a FROM-subquery whose inner SELECT itself has multiple tables
+    and unqualified columns must still trigger RF02 inside the subquery.
+    """
+    sql = (
+        "SELECT a\n"
+        "FROM (\n"
+        "    SELECT a, b\n"
+        "    FROM foo\n"
+        "    LEFT JOIN vee ON vee.a = foo.a\n"
+        ")\n"
+    )
+    assert _rf02_count(sql) >= 1
+
+
+def test__rules__std_RF02_from_subquery_multi_table_qualified_passes():
+    """Preservation: a FROM-subquery with multiple inner tables but fully qualified
+    references must not trigger RF02.
+    """
+    sql = (
+        "SELECT a\n"
+        "FROM (\n"
+        "    SELECT foo.a, vee.b\n"
+        "    FROM foo\n"
+        "    LEFT JOIN vee ON vee.a = foo.a\n"
+        ")\n"
+    )
+    assert _rf02_count(sql) == 0
+
+
+def test__rules__std_RF02_where_subquery_unreferenced_still_fails():
+    """Preservation (issue 6067): a WHERE subquery with an unqualified reference
+    that is ambiguous between the inner and outer table must still trigger RF02.
+    """
+    sql = (
+        "SELECT a\n"
+        "FROM foo\n"
+        "WHERE a IN (SELECT a FROM bar)\n"
+    )
+    assert _rf02_count(sql) >= 1
+
+
+def test__rules__std_RF02_where_subquery_referenced_passes():
+    """Preservation (issue 6067): a WHERE subquery with a fully qualified reference
+    inside must not trigger RF02.
+    """
+    sql = (
+        "SELECT a\n"
+        "FROM foo\n"
+        "WHERE a IN (SELECT bar.a FROM bar)\n"
+    )
+    assert _rf02_count(sql) == 0
+
+
+def test__rules__std_RF02_basic_multi_table_unqualified_still_fails():
+    """Preservation: the canonical RF02 trigger – multiple tables with
+    unqualified column references at the top level – must still fail.
+    """
+    sql = (
+        "SELECT a, b\n"
+        "FROM foo\n"
+        "LEFT JOIN vee ON vee.a = foo.a\n"
+    )
+    assert _rf02_count(sql) >= 1
+
+
+def test__rules__std_RF02_basic_multi_table_qualified_passes():
+    """Preservation: the canonical RF02 happy path – multiple tables with
+    fully qualified references – must not trigger.
+    """
+    sql = (
+        "SELECT foo.a, vee.b\n"
+        "FROM foo\n"
+        "LEFT JOIN vee ON vee.a = foo.a\n"
+    )
+    assert _rf02_count(sql) == 0
+
+
+def test__rules__std_RF02_nested_correlated_where_in_from_subquery_fails():
+    """Discriminator: a correlated-looking WHERE subquery inside a FROM subquery
+    must still surface its unqualified-reference ambiguity. The inner subquery's
+    parent is a single-table query, so 'id' is ambiguous between the inner
+    'bar' table and the outer 'foo' table and RF02 must trigger.
+    """
+    sql = (
+        "SELECT *\n"
+        "FROM (\n"
+        "    SELECT id\n"
+        "    FROM foo\n"
+        "    WHERE id IN (SELECT id FROM bar)\n"
+        ") AS sub\n"
+    )
+    assert _rf02_count(sql) >= 1
