diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,143 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+export PATH="/root/go/pkg/mod/golang.org/toolchain@v0.0.1-go1.23.0.linux-amd64/bin:${PATH}"
+export GOTOOLCHAIN=local
+export GOPROXY=off
+export GOSUMDB=off
+export GOFLAGS="${GOFLAGS:-} -mod=readonly"
+
+( cd /workspace/repo && go build -mod=readonly -o /tmp/fzf-coderl-acceptance . ) \
+  || { echo "FAIL: build" >&2; exit 1; }
+BIN=/tmp/fzf-coderl-acceptance
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+assert_line_present() {
+  local file=$1
+  local line=$2
+  local name=$3
+
+  grep -Fxq "$line" "$file" || fail "$name missing $line: $(cat "$file")"
+}
+
+assert_line_absent_prefix() {
+  local file=$1
+  local prefix=$2
+  local name=$3
+
+  ! grep -Eq "(^|/)$prefix(/|$)" "$file" || fail "$name unexpectedly included $prefix: $(cat "$file")"
+}
+
+run_walker() {
+  local tree=$1
+  local cmd=$2
+  local name=$3
+  (
+    cd "$tree" || exit 97
+    env -u FZF_DEFAULT_COMMAND -u FZF_DEFAULT_OPTS \
+      script -qfec "$cmd" /dev/null
+  ) >"$TMP/${name}.rawout" 2>"$TMP/${name}.err"
+  local ec=$?
+  tr -d '\r' <"$TMP/${name}.rawout" >"$TMP/${name}.out"
+  return "$ec"
+}
+
+
+
+
+tree="$TMP/default-tree"
+mkdir -p "$tree/src" "$tree/.git" "$tree/node_modules/pkg" "$tree/target"
+touch "$tree/src/main.go" "$tree/.git/config" "$tree/node_modules/pkg/index.js" "$tree/target/app.log"
+run_walker "$tree" "$BIN --filter ''" f1; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_line_present "$TMP/f1.out" "src/main.go" "F1"
+assert_line_present "$TMP/f1.out" "target/app.log" "F1"
+assert_line_absent_prefix "$TMP/f1.out" "\\.git" "F1"
+assert_line_absent_prefix "$TMP/f1.out" "node_modules" "F1"
+[ ! -s "$TMP/f1.err" ] || fail "F1 unexpected stderr: $(cat "$TMP/f1.err")"
+
+
+
+
+tree="$TMP/explicit-tree"
+mkdir -p "$tree/src" "$tree/.git" "$tree/node_modules/pkg" "$tree/target"
+touch "$tree/src/main.go" "$tree/.git/config" "$tree/node_modules/pkg/index.js" "$tree/target/app.log"
+run_walker "$tree" "$BIN --walker-skip .git,node_modules,target --filter ''" f2; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_line_present "$TMP/f2.out" "src/main.go" "F2"
+assert_line_absent_prefix "$TMP/f2.out" "\\.git" "F2"
+assert_line_absent_prefix "$TMP/f2.out" "node_modules" "F2"
+assert_line_absent_prefix "$TMP/f2.out" "target" "F2"
+[ ! -s "$TMP/f2.err" ] || fail "F2 unexpected stderr: $(cat "$TMP/f2.err")"
+
+
+
+
+tree="$TMP/empty-entry-tree"
+mkdir -p "$tree/src" "$tree/.git" "$tree/node_modules/pkg" "$tree/target"
+touch "$tree/src/main.go" "$tree/.git/config" "$tree/node_modules/pkg/index.js" "$tree/target/app.log"
+run_walker "$tree" "$BIN --walker-skip ,,target,, --filter ''" f3; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+assert_line_present "$TMP/f3.out" "src/main.go" "F3"
+assert_line_present "$TMP/f3.out" ".git/config" "F3"
+assert_line_present "$TMP/f3.out" "node_modules/pkg/index.js" "F3"
+assert_line_absent_prefix "$TMP/f3.out" "target" "F3"
+[ ! -s "$TMP/f3.err" ] || fail "F3 unexpected stderr: $(cat "$TMP/f3.err")"
+
+
+
+
+tree="$TMP/path-pattern-tree"
+mkdir -p "$tree/foo/bar" "$tree/baz/foo/bar" "$tree/bazfoo/bar" "$tree/keep"
+touch "$tree/foo/bar/root.txt" "$tree/baz/foo/bar/nested.txt" "$tree/bazfoo/bar/notmatch.txt" "$tree/keep/file.txt"
+run_walker "$tree" "$BIN --walker-skip foo/bar --filter ''" f4; ec=$?
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+assert_line_present "$TMP/f4.out" "bazfoo/bar/notmatch.txt" "F4"
+assert_line_present "$TMP/f4.out" "keep/file.txt" "F4"
+assert_line_absent_prefix "$TMP/f4.out" "foo/bar" "F4"
+assert_line_absent_prefix "$TMP/f4.out" "baz/foo/bar" "F4"
+[ ! -s "$TMP/f4.err" ] || fail "F4 unexpected stderr: $(cat "$TMP/f4.err")"
+
+
+
+
+cd "$TMP"
+env -u FZF_DEFAULT_COMMAND -u FZF_DEFAULT_OPTS "$BIN" --walker-skip >f5.out 2>f5.err; ec=$?
+[ "$ec" -ne 0 ] || fail "F5 exit $ec; want non-zero"
+[ ! -s f5.out ] || fail "F5 unexpected stdout: $(cat f5.out)"
+
+grep -Eq 'directory|directories' f5.err || fail "F5 stderr missing directory diagnostic: $(cat f5.err)"
+grep -Eq 'ignore|skip' f5.err || fail "F5 stderr missing ignore/skip diagnostic: $(cat f5.err)"
+grep -Eq 'required|missing' f5.err || fail "F5 stderr missing required/missing diagnostic: $(cat f5.err)"
+
+
+
+
+"$BIN" --help >f6.out 2>f6.err; ec=$?
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+[ ! -s f6.err ] || fail "F6 unexpected stderr: $(cat f6.err)"
+help_block=$(sed -n '/DIRECTORY TRAVERSAL/,/HISTORY/p' f6.out)
+
+printf '%s\n' "$help_block" | grep -Fq 'DIRECTORY TRAVERSAL' || fail "F6 missing directory traversal section: $help_block"
+printf '%s\n' "$help_block" | grep -Fq -- '--walker-skip=DIRS' || fail "F6 missing --walker-skip=DIRS: $help_block"
+printf '%s\n' "$help_block" | grep -Fq -- '.git,node_modules' || fail "F6 missing default skip list: $help_block"
+
+
+
+
+"$BIN" --bash >f7.out 2>f7.err; ec=$?
+[ "$ec" -eq 0 ] || fail "F7 exit $ec; want 0"
+[ ! -s f7.err ] || fail "F7 unexpected stderr: $(cat f7.err)"
+completion_block=$(sed -n '/    --walker$/,/    --with-nth$/p' f7.out)
+
+printf '%s\n' "$completion_block" | grep -Fxq '    --walker' || fail "F7 missing --walker: $completion_block"
+printf '%s\n' "$completion_block" | grep -Fxq '    --walker-root' || fail "F7 missing --walker-root: $completion_block"
+printf '%s\n' "$completion_block" | grep -Fxq '    --walker-skip' || fail "F7 missing --walker-skip: $completion_block"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+
+export PATH="/root/go/pkg/mod/golang.org/toolchain@v0.0.1-go1.23.0.linux-amd64/bin:${PATH}"
+export GOTOOLCHAIN=local
+export GOPROXY=off
+export GOSUMDB=off
+export GOFLAGS="${GOFLAGS:-} -mod=readonly"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
