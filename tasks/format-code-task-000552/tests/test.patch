+import json
+import threading
+from datetime import datetime, timedelta
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.parse import parse_qs, urlparse
+
+import pytest
+
+from nse import NSE
+
+
+
+
+
+
+
+
+
+
+RESPONSES = {
+    "/corporates-corporateActions": [{"symbol": "HDFCBANK"}],
+    "/corporate-announcements": [{"symbol": "INFY", "subject": "Board"}],
+    "/corporate-board-meetings": [{"symbol": "TCS", "purpose": "Results"}],
+    "/annual-reports": {"data": [{"fileName": "HDFC-2025.pdf"}]},
+    "/corporate-share-holdings-master": [
+        {"symbol": "RELIANCE", "date": "30-Jun-2025"}
+    ],
+    "/public-past-issues": [{"symbol": "IPOCO"}],
+    "/circulars": {"data": []},
+}
+
+
+class RecordingNSEServer:
+    def __init__(self):
+        self.logs = []
+        owner = self
+
+        class Handler(BaseHTTPRequestHandler):
+            protocol_version = "HTTP/1.1"
+
+            def log_message(self, *_):
+                return
+
+            def do_GET(self):
+                parsed = urlparse(self.path)
+                body = json.dumps(RESPONSES[parsed.path]).encode("utf-8")
+                owner.logs.append(
+                    {
+                        "path": parsed.path,
+                        "query": dict(parse_qs(parsed.query)),
+                        "cookie": self.headers.get("Cookie", ""),
+                    }
+                )
+                self.send_response(200)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Set-Cookie", "nse-stage=observed; Path=/")
+                self.send_header("Connection", "close")
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+        self._server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        self.base_url = f"http://127.0.0.1:{self._server.server_port}"
+        self._thread = threading.Thread(target=self._server.serve_forever, daemon=True)
+
+    def __enter__(self):
+        self._thread.start()
+        return self
+
+    def __exit__(self, *_):
+        self._server.shutdown()
+        self._server.server_close()
+
+
+@pytest.fixture
+def nse_server():
+    with RecordingNSEServer() as server:
+        yield server
+
+
+def make_client(tmp_path, nse_server, name="client"):
+    client = NSE(tmp_path / name, server=False)
+    client.base_url = nse_server.base_url
+    return client
+
+
+def parsed_query_date(log, key):
+    value = log["query"].get(key)
+    assert value is not None
+    assert len(value) == 1
+    return datetime.strptime(value[0], "%d-%m-%Y").date()
+
+
+def test_actions_announcements_boardmeetings_session_params_and_cookie_state(
+    tmp_path, nse_server
+):
+
+
+
+
+    client = make_client(tmp_path, nse_server)
+
+    actions = client.actions(
+        symbol="HDFCBANK",
+        from_date=datetime(2025, 1, 2),
+        to_date=datetime(2025, 1, 31),
+    )
+    assert actions == [{"symbol": "HDFCBANK"}]
+    assert nse_server.logs[0] == {
+        "path": "/corporates-corporateActions",
+        "query": {
+            "index": ["equities"],
+            "symbol": ["HDFCBANK"],
+            "from_date": ["02-01-2025"],
+            "to_date": ["31-01-2025"],
+        },
+        "cookie": "",
+    }
+
+    announcements = client.announcements(
+        index="sme",
+        symbol="INFY",
+        fno=True,
+        from_date=datetime(2025, 2, 1),
+        to_date=datetime(2025, 2, 5),
+    )
+    assert announcements == [{"symbol": "INFY", "subject": "Board"}]
+    assert nse_server.logs[1] == {
+        "path": "/corporate-announcements",
+        "query": {
+            "index": ["sme"],
+            "symbol": ["INFY"],
+            "fo_sec": ["True"],
+            "from_date": ["01-02-2025"],
+            "to_date": ["05-02-2025"],
+        },
+        "cookie": "nse-stage=observed",
+    }
+
+    meetings = client.boardMeetings(
+        index="sme",
+        symbol="TCS",
+        fno=True,
+        from_date=datetime(2025, 3, 4),
+        to_date=datetime(2025, 3, 6),
+    )
+    assert meetings == [{"symbol": "TCS", "purpose": "Results"}]
+    assert nse_server.logs[2] == {
+        "path": "/corporate-board-meetings",
+        "query": {
+            "index": ["sme"],
+            "symbol": ["TCS"],
+            "fo_sec": ["True"],
+            "from_date": ["04-03-2025"],
+            "to_date": ["06-03-2025"],
+        },
+        "cookie": "nse-stage=observed",
+    }
+
+    client.__exit__(None, None, None)
+
+
+def test_default_and_single_date_omission_for_corporate_queries(tmp_path, nse_server):
+
+
+
+
+    client = make_client(tmp_path, nse_server)
+
+    actions = client.actions()
+    assert actions == [{"symbol": "HDFCBANK"}]
+    assert nse_server.logs[0] == {
+        "path": "/corporates-corporateActions",
+        "query": {"index": ["equities"]},
+        "cookie": "",
+    }
+
+    announcements = client.announcements(from_date=datetime(2025, 2, 1))
+    assert announcements == [{"symbol": "INFY", "subject": "Board"}]
+    assert nse_server.logs[1] == {
+        "path": "/corporate-announcements",
+        "query": {"index": ["equities"]},
+        "cookie": "nse-stage=observed",
+    }
+
+    meetings = client.boardMeetings(to_date=datetime(2025, 3, 6))
+    assert meetings == [{"symbol": "TCS", "purpose": "Results"}]
+    assert nse_server.logs[2] == {
+        "path": "/corporate-board-meetings",
+        "query": {"index": ["equities"]},
+        "cookie": "nse-stage=observed",
+    }
+
+    client.__exit__(None, None, None)
+
+
+def test_invalid_corporate_date_order_raises_value_error(tmp_path, nse_server):
+
+
+
+
+    client = make_client(tmp_path, nse_server)
+
+    for call in (client.actions, client.announcements, client.boardMeetings):
+        with pytest.raises(ValueError) as error:
+            call(from_date=datetime(2025, 6, 2), to_date=datetime(2025, 6, 1))
+        assert str(error.value) == "'from_date' cannot be greater than 'to_date'"
+
+    assert nse_server.logs == []
+    client.__exit__(None, None, None)
+
+
+def test_annual_reports_and_shareholding_params_and_return_shapes(tmp_path, nse_server):
+
+
+
+
+    client = make_client(tmp_path, nse_server)
+
+    annual_reports = client.annual_reports("HDFCBANK", segment="sme")
+    assert annual_reports == {"data": [{"fileName": "HDFC-2025.pdf"}]}
+    assert nse_server.logs[0] == {
+        "path": "/annual-reports",
+        "query": {"index": ["sme"], "symbol": ["HDFCBANK"]},
+        "cookie": "",
+    }
+
+    shareholding = client.shareholding("reliance", index="sme")
+    assert shareholding == [{"symbol": "RELIANCE", "date": "30-Jun-2025"}]
+    assert nse_server.logs[1] == {
+        "path": "/corporate-share-holdings-master",
+        "query": {"index": ["sme"], "symbol": ["RELIANCE"]},
+        "cookie": "nse-stage=observed",
+    }
+
+    client.__exit__(None, None, None)
+
+
+def test_list_past_ipo_explicit_default_and_invalid_windows(tmp_path, nse_server):
+
+
+
+
+    client = make_client(tmp_path, nse_server)
+
+    explicit = client.listPastIPO(
+        from_date=datetime(2025, 4, 1), to_date=datetime(2025, 4, 30)
+    )
+    assert explicit == [{"symbol": "IPOCO"}]
+    assert nse_server.logs[0] == {
+        "path": "/public-past-issues",
+        "query": {"from_date": ["01-04-2025"], "to_date": ["30-04-2025"]},
+        "cookie": "",
+    }
+
+    before_default = datetime.now().date()
+    defaulted = client.listPastIPO()
+    after_default = datetime.now().date()
+    assert defaulted == [{"symbol": "IPOCO"}]
+
+    assert nse_server.logs[1]["path"] == "/public-past-issues"
+    assert nse_server.logs[1]["cookie"] == "nse-stage=observed"
+    assert set(nse_server.logs[1]["query"]) == {"from_date", "to_date"}
+    default_to_date = parsed_query_date(nse_server.logs[1], "to_date")
+    default_from_date = parsed_query_date(nse_server.logs[1], "from_date")
+    assert before_default <= default_to_date <= after_default
+    assert default_from_date == default_to_date - timedelta(days=90)
+
+    with pytest.raises(ValueError) as error:
+        client.listPastIPO(
+            from_date=datetime(2025, 5, 2), to_date=datetime(2025, 5, 1)
+        )
+    assert str(error.value) == "Argument `to_date` cannot be less than `from_date`"
+    assert len(nse_server.logs) == 2
+
+    client.__exit__(None, None, None)
+
+
+def test_circulars_explicit_default_filters_and_invalid_windows(tmp_path, nse_server):
+
+
+
+
+    client = make_client(tmp_path, nse_server)
+
+    explicit = client.circulars(
+        subject="holidays",
+        dept_code="cc",
+        from_date=datetime(2025, 5, 1),
+        to_date=datetime(2025, 5, 8),
+    )
+    assert explicit == {"data": []}
+    assert nse_server.logs[0] == {
+        "path": "/circulars",
+        "query": {
+            "from_date": ["01-05-2025"],
+            "to_date": ["08-05-2025"],
+            "sub": ["holidays"],
+            "dept": ["CC"],
+        },
+        "cookie": "",
+    }
+
+    before_default = datetime.now().date()
+    defaulted = client.circulars()
+    after_default = datetime.now().date()
+    assert defaulted == {"data": []}
+
+    assert nse_server.logs[1]["path"] == "/circulars"
+    assert nse_server.logs[1]["cookie"] == "nse-stage=observed"
+    assert set(nse_server.logs[1]["query"]) == {"from_date", "to_date"}
+    default_to_date = parsed_query_date(nse_server.logs[1], "to_date")
+    default_from_date = parsed_query_date(nse_server.logs[1], "from_date")
+    assert before_default <= default_to_date <= after_default
+    assert default_from_date == default_to_date - timedelta(days=7)
+
+    with pytest.raises(ValueError) as error:
+        client.circulars(from_date=datetime(2025, 7, 2), to_date=datetime(2025, 7, 1))
+    assert str(error.value) == "Argument `to_date` cannot be less than `from_date`"
+    assert len(nse_server.logs) == 2
+
+    client.__exit__(None, None, None)
+
+
+def test_context_cleanup_is_idempotent(tmp_path, nse_server):
+
+
+
+
+    client = make_client(tmp_path, nse_server)
+    assert len(list(tmp_path.rglob("nse_cookies_requests.json"))) == 1
+
+    client.__exit__(None, None, None)
+    assert len(list(tmp_path.rglob("nse_cookies_requests.json"))) == 0
+
+    client.__exit__(None, None, None)
+    assert len(list(tmp_path.rglob("nse_cookies_requests.json"))) == 0
+
+
+def test_two_instances_keep_session_cookies_independent(tmp_path, nse_server):
+
+
+
+
+    first = make_client(tmp_path, nse_server, "first")
+    second = make_client(tmp_path, nse_server, "second")
+
+    first_actions = first.actions()
+    assert first_actions == [{"symbol": "HDFCBANK"}]
+    assert nse_server.logs[0] == {
+        "path": "/corporates-corporateActions",
+        "query": {"index": ["equities"]},
+        "cookie": "",
+    }
+
+    second_announcements = second.announcements()
+    assert second_announcements == [{"symbol": "INFY", "subject": "Board"}]
+    assert nse_server.logs[1] == {
+        "path": "/corporate-announcements",
+        "query": {"index": ["equities"]},
+        "cookie": "",
+    }
+
+    first_meetings = first.boardMeetings()
+    assert first_meetings == [{"symbol": "TCS", "purpose": "Results"}]
+    assert nse_server.logs[2] == {
+        "path": "/corporate-board-meetings",
+        "query": {"index": ["equities"]},
+        "cookie": "nse-stage=observed",
+    }
+
+    first.__exit__(None, None, None)
+    second.__exit__(None, None, None)
+
+
+def test_repeated_context_cycles_do_not_leave_cookie_files(tmp_path, nse_server):
+
+
+
+
+    for i in range(100):
+        client = make_client(tmp_path, nse_server, f"cycle-{i}")
+        result = client.actions()
+        assert result == [{"symbol": "HDFCBANK"}]
+        client.__exit__(None, None, None)
+
+    assert len(nse_server.logs) == 100
+    assert nse_server.logs[0] == {
+        "path": "/corporates-corporateActions",
+        "query": {"index": ["equities"]},
+        "cookie": "",
+    }
+    assert nse_server.logs[99] == {
+        "path": "/corporates-corporateActions",
+        "query": {"index": ["equities"]},
+        "cookie": "",
+    }
+    assert len(list(tmp_path.rglob("nse_cookies_requests.json"))) == 0
