+package usercase_test_coderl
+
+
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+
+	lo "github.com/samber/lo"
+)
+
+func TestAttemptSucceedsAtSixthInvocation(t *testing.T) {
+
+
+	fail := errors.New("attempt failed")
+	var indexes []int
+
+	count, err := lo.Attempt(42, func(index int) error {
+		indexes = append(indexes, index)
+		if index == 5 {
+			return nil
+		}
+		return fail
+	})
+
+	if count != 6 {
+		t.Fatalf("count = %d, want 6", count)
+	}
+	if err != nil {
+		t.Fatalf("err = %v, want nil", err)
+	}
+	wantIndexes := []int{0, 1, 2, 3, 4, 5}
+	if !reflect.DeepEqual(indexes, wantIndexes) {
+		t.Fatalf("indexes = %#v, want %#v", indexes, wantIndexes)
+	}
+}
+
+func TestAttemptReturnsLastErrorWhenBoundedAttemptsExhaust(t *testing.T) {
+
+
+	firstErr := errors.New("first failure")
+	lastErr := errors.New("last failure")
+	var indexes []int
+
+	count, err := lo.Attempt(2, func(index int) error {
+		indexes = append(indexes, index)
+		if index == 0 {
+			return firstErr
+		}
+		return lastErr
+	})
+
+	if count != 2 {
+		t.Fatalf("count = %d, want 2", count)
+	}
+	if !errors.Is(err, lastErr) {
+		t.Fatalf("err = %v, want sentinel %q", err, lastErr)
+	}
+	wantIndexes := []int{0, 1}
+	if !reflect.DeepEqual(indexes, wantIndexes) {
+		t.Fatalf("indexes = %#v, want %#v", indexes, wantIndexes)
+	}
+}
+
+func TestAttemptUnlimitedWhenMaxIterationIsZero(t *testing.T) {
+
+
+	fail := errors.New("attempt failed")
+	var indexes []int
+
+	count, err := lo.Attempt(0, func(index int) error {
+		indexes = append(indexes, index)
+		if index < 42 {
+			return fail
+		}
+		return nil
+	})
+
+	if count != 43 {
+		t.Fatalf("count = %d, want 43", count)
+	}
+	if err != nil {
+		t.Fatalf("err = %v, want nil", err)
+	}
+	if len(indexes) != 43 || indexes[0] != 0 || indexes[42] != 42 {
+		t.Fatalf("indexes summary = len:%d first:%d last:%d, want len:43 first:0 last:42", len(indexes), indexes[0], indexes[len(indexes)-1])
+	}
+}
+
+func TestAttemptUnlimitedWhenMaxIterationIsNegative(t *testing.T) {
+
+
+	fail := errors.New("attempt failed")
+
+	count, err := lo.Attempt(-3, func(index int) error {
+		if index < 2 {
+			return fail
+		}
+		return nil
+	})
+
+	if count != 3 {
+		t.Fatalf("count = %d, want 3", count)
+	}
+	if err != nil {
+		t.Fatalf("err = %v, want nil", err)
+	}
+}
+
+func TestAttemptWithDelaySuccessReturnsElapsedDurationAndIndexes(t *testing.T) {
+
+
+	fail := errors.New("attempt failed")
+	var indexes []int
+	var callbackDurations []time.Duration
+
+	count, elapsed, err := lo.AttemptWithDelay(42, 10*time.Millisecond, func(index int, duration time.Duration) error {
+		indexes = append(indexes, index)
+		callbackDurations = append(callbackDurations, duration)
+		if index == 3 {
+			return nil
+		}
+		return fail
+	})
+
+	if count != 4 {
+		t.Fatalf("count = %d, want 4", count)
+	}
+	if err != nil {
+		t.Fatalf("err = %v, want nil", err)
+	}
+	assertDurationBetween(t, "elapsed", elapsed, 30*time.Millisecond, 250*time.Millisecond)
+	wantIndexes := []int{0, 1, 2, 3}
+	if !reflect.DeepEqual(indexes, wantIndexes) {
+		t.Fatalf("indexes = %#v, want %#v", indexes, wantIndexes)
+	}
+	if len(callbackDurations) != 4 {
+		t.Fatalf("callbackDurations length = %d, want 4", len(callbackDurations))
+	}
+	assertDurationBetween(t, "fourth callback duration", callbackDurations[3], 30*time.Millisecond, 250*time.Millisecond)
+}
+
+func TestAttemptWithDelayBoundedExhaustionSleepsOnceAndReturnsLastError(t *testing.T) {
+
+
+	firstErr := errors.New("first delayed failure")
+	lastErr := errors.New("last delayed failure")
+	var indexes []int
+
+	count, elapsed, err := lo.AttemptWithDelay(2, 10*time.Millisecond, func(index int, duration time.Duration) error {
+		indexes = append(indexes, index)
+		if index == 0 {
+			return firstErr
+		}
+		return lastErr
+	})
+
+	if count != 2 {
+		t.Fatalf("count = %d, want 2", count)
+	}
+	if !errors.Is(err, lastErr) {
+		t.Fatalf("err = %v, want sentinel %q", err, lastErr)
+	}
+	assertDurationBetween(t, "elapsed", elapsed, 10*time.Millisecond, 250*time.Millisecond)
+	wantIndexes := []int{0, 1}
+	if !reflect.DeepEqual(indexes, wantIndexes) {
+		t.Fatalf("indexes = %#v, want %#v", indexes, wantIndexes)
+	}
+}
+
+func TestAttemptWhileUnlimitedStopsOnFalseWithNilError(t *testing.T) {
+
+
+	fail := errors.New("while failed")
+	var indexes []int
+
+	count, err := lo.AttemptWhile(0, func(index int) (error, bool) {
+		indexes = append(indexes, index)
+		if index == 5 {
+			return nil, false
+		}
+		return fail, true
+	})
+
+	if count != 6 {
+		t.Fatalf("count = %d, want 6", count)
+	}
+	if err != nil {
+		t.Fatalf("err = %v, want nil", err)
+	}
+	wantIndexes := []int{0, 1, 2, 3, 4, 5}
+	if !reflect.DeepEqual(indexes, wantIndexes) {
+		t.Fatalf("indexes = %#v, want %#v", indexes, wantIndexes)
+	}
+}
+
+func TestAttemptWhileImmediateFalseNilReturnsOne(t *testing.T) {
+
+
+	count, err := lo.AttemptWhile(42, func(index int) (error, bool) {
+		if index != 0 {
+			t.Fatalf("index = %d, want only 0", index)
+		}
+		return nil, false
+	})
+
+	if count != 1 {
+		t.Fatalf("count = %d, want 1", count)
+	}
+	if err != nil {
+		t.Fatalf("err = %v, want nil", err)
+	}
+}
+
+func TestAttemptWhileImmediateFalseReturnsCurrentError(t *testing.T) {
+
+
+	currentErr := errors.New("stop with current error")
+
+	count, err := lo.AttemptWhile(7, func(index int) (error, bool) {
+		return currentErr, false
+	})
+
+	if count != 1 {
+		t.Fatalf("count = %d, want 1", count)
+	}
+	if !errors.Is(err, currentErr) {
+		t.Fatalf("err = %v, want sentinel %q", err, currentErr)
+	}
+}
+
+func TestAttemptWhileBoundedExhaustionReturnsLastError(t *testing.T) {
+
+
+	firstErr := errors.New("first while failure")
+	lastErr := errors.New("last while failure")
+
+	count, err := lo.AttemptWhile(2, func(index int) (error, bool) {
+		if index == 0 {
+			return firstErr, true
+		}
+		return lastErr, true
+	})
+
+	if count != 2 {
+		t.Fatalf("count = %d, want 2", count)
+	}
+	if !errors.Is(err, lastErr) {
+		t.Fatalf("err = %v, want sentinel %q", err, lastErr)
+	}
+}
+
+func TestAttemptWhileWithDelayEarlyStopReturnsElapsedDuration(t *testing.T) {
+
+
+	fail := errors.New("while delayed failure")
+	var indexes []int
+	var callbackDurations []time.Duration
+
+	count, elapsed, err := lo.AttemptWhileWithDelay(0, 10*time.Millisecond, func(index int, duration time.Duration) (error, bool) {
+		indexes = append(indexes, index)
+		callbackDurations = append(callbackDurations, duration)
+		if index == 3 {
+			return nil, false
+		}
+		return fail, true
+	})
+
+	if count != 4 {
+		t.Fatalf("count = %d, want 4", count)
+	}
+	if err != nil {
+		t.Fatalf("err = %v, want nil", err)
+	}
+	assertDurationBetween(t, "elapsed", elapsed, 30*time.Millisecond, 250*time.Millisecond)
+	wantIndexes := []int{0, 1, 2, 3}
+	if !reflect.DeepEqual(indexes, wantIndexes) {
+		t.Fatalf("indexes = %#v, want %#v", indexes, wantIndexes)
+	}
+	if len(callbackDurations) != 4 {
+		t.Fatalf("callbackDurations length = %d, want 4", len(callbackDurations))
+	}
+	assertDurationBetween(t, "fourth callback duration", callbackDurations[3], 30*time.Millisecond, 250*time.Millisecond)
+}
+
+func TestAttemptWhileWithDelayBoundedExhaustionReturnsLastErrorAndElapsedDuration(t *testing.T) {
+
+
+	firstErr := errors.New("first while delayed failure")
+	lastErr := errors.New("last while delayed failure")
+	var indexes []int
+
+	count, elapsed, err := lo.AttemptWhileWithDelay(2, 10*time.Millisecond, func(index int, duration time.Duration) (error, bool) {
+		indexes = append(indexes, index)
+		if index == 0 {
+			return firstErr, true
+		}
+		return lastErr, true
+	})
+
+	if count != 2 {
+		t.Fatalf("count = %d, want 2", count)
+	}
+	if !errors.Is(err, lastErr) {
+		t.Fatalf("err = %v, want sentinel %q", err, lastErr)
+	}
+	assertDurationBetween(t, "elapsed", elapsed, 10*time.Millisecond, 250*time.Millisecond)
+	wantIndexes := []int{0, 1}
+	if !reflect.DeepEqual(indexes, wantIndexes) {
+		t.Fatalf("indexes = %#v, want %#v", indexes, wantIndexes)
+	}
+}
+
+func TestAttemptImmediateSuccessStopsAfterOneInvocation(t *testing.T) {
+
+	var indexes []int
+
+	count, err := lo.Attempt(42, func(index int) error {
+		indexes = append(indexes, index)
+		return nil
+	})
+
+	if count != 1 {
+		t.Fatalf("count = %d, want 1", count)
+	}
+	if err != nil {
+		t.Fatalf("err = %v, want nil", err)
+	}
+	wantIndexes := []int{0}
+	if !reflect.DeepEqual(indexes, wantIndexes) {
+		t.Fatalf("indexes = %#v, want %#v", indexes, wantIndexes)
+	}
+}
+
+func TestAttemptWithDelayImmediateSuccessStopsAfterOneInvocation(t *testing.T) {
+
+	var indexes []int
+	var callbackDurations []time.Duration
+
+	count, elapsed, err := lo.AttemptWithDelay(3, 10*time.Millisecond, func(index int, duration time.Duration) error {
+		indexes = append(indexes, index)
+		callbackDurations = append(callbackDurations, duration)
+		return nil
+	})
+
+	if count != 1 {
+		t.Fatalf("count = %d, want 1", count)
+	}
+	if err != nil {
+		t.Fatalf("err = %v, want nil", err)
+	}
+	wantIndexes := []int{0}
+	if !reflect.DeepEqual(indexes, wantIndexes) {
+		t.Fatalf("indexes = %#v, want %#v", indexes, wantIndexes)
+	}
+	if len(callbackDurations) != 1 {
+		t.Fatalf("callbackDurations length = %d, want 1", len(callbackDurations))
+	}
+	if elapsed < callbackDurations[0] {
+		t.Fatalf("elapsed = %s, want at least callback duration %s", elapsed, callbackDurations[0])
+	}
+}
+
+func TestAttemptWhileWithDelayUnlimitedSuccessWhenContinueRemainsTrue(t *testing.T) {
+
+	fail := errors.New("while delayed unlimited failure")
+	var indexes []int
+
+	count, elapsed, err := lo.AttemptWhileWithDelay(0, 10*time.Millisecond, func(index int, duration time.Duration) (error, bool) {
+		indexes = append(indexes, index)
+		if index < 2 {
+			return fail, true
+		}
+		return nil, true
+	})
+
+	if count != 3 {
+		t.Fatalf("count = %d, want 3", count)
+	}
+	if err != nil {
+		t.Fatalf("err = %v, want nil", err)
+	}
+	assertDurationBetween(t, "elapsed", elapsed, 20*time.Millisecond, 250*time.Millisecond)
+	wantIndexes := []int{0, 1, 2}
+	if !reflect.DeepEqual(indexes, wantIndexes) {
+		t.Fatalf("indexes = %#v, want %#v", indexes, wantIndexes)
+	}
+}
+
+func TestAttemptWhileWithDelayImmediateFalseReturnsCurrentError(t *testing.T) {
+
+	currentErr := errors.New("stop delayed with current error")
+	var indexes []int
+
+	count, elapsed, err := lo.AttemptWhileWithDelay(42, 10*time.Millisecond, func(index int, duration time.Duration) (error, bool) {
+		indexes = append(indexes, index)
+		return currentErr, false
+	})
+
+	if count != 1 {
+		t.Fatalf("count = %d, want 1", count)
+	}
+	if !errors.Is(err, currentErr) {
+		t.Fatalf("err = %v, want sentinel %q", err, currentErr)
+	}
+	wantIndexes := []int{0}
+	if !reflect.DeepEqual(indexes, wantIndexes) {
+		t.Fatalf("indexes = %#v, want %#v", indexes, wantIndexes)
+	}
+	if elapsed < 0 {
+		t.Fatalf("elapsed = %s, want non-negative duration", elapsed)
+	}
+}
+
+func assertDurationBetween(t *testing.T, name string, got, min, max time.Duration) {
+	t.Helper()
+	if got < min || got > max {
+		t.Fatalf("%s = %s, want between %s and %s", name, got, min, max)
+	}
+}
