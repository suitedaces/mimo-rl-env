diff --git a/test/wsdl-recursive-describe-test.js b/test/wsdl-recursive-describe-test.js
new file mode 100644
index 000000000..3f0a1b2c3
--- /dev/null
+++ b/test/wsdl-recursive-describe-test.js
@@ -0,0 +1,311 @@
+'use strict';
+
+var assert = require('assert');
+var fs = require('fs');
+var os = require('os');
+var path = require('path');
+var soap = require('..');
+
+function writeWsdl(name, contents) {
+  var dir = path.join(os.tmpdir(), 'node-soap-recursive-' + process.pid + '-' + Date.now() + '-' + Math.floor(Math.random() * 1000000));
+  fs.mkdirSync(dir);
+  var file = path.join(dir, name + '.wsdl');
+  fs.writeFileSync(file, contents, 'utf8');
+  return file;
+}
+
+function describeClient(wsdlPath, done, verify) {
+  soap.createClient(wsdlPath, function(err, client) {
+    if (err) {
+      return done(err);
+    }
+
+    var description;
+    try {
+      description = client.describe();
+    }
+    catch (e) {
+      return done(e);
+    }
+
+    try {
+      verify(description);
+    }
+    catch (verifyErr) {
+      return done(verifyErr);
+    }
+
+    done();
+  });
+}
+
+function walk(value, visitor, state) {
+  state = state || { seen: [], count: 0 };
+
+  if (value === null || typeof value !== 'object') {
+    return;
+  }
+
+  if (state.seen.indexOf(value) !== -1) {
+    return;
+  }
+
+  state.seen.push(value);
+  state.count += 1;
+  assert.ok(state.count < 1000, 'description should remain a bounded object graph');
+
+  visitor(value);
+
+  Object.keys(value).forEach(function(key) {
+    walk(value[key], visitor, state);
+  });
+}
+
+function findValueForKey(root, keyName) {
+  var found;
+
+  walk(root, function(obj) {
+    if (found !== undefined) {
+      return;
+    }
+    if (Object.prototype.hasOwnProperty.call(obj, keyName)) {
+      found = obj[keyName];
+    }
+    else if (Object.prototype.hasOwnProperty.call(obj, keyName + '[]')) {
+      found = obj[keyName + '[]'];
+    }
+  });
+
+  return found;
+}
+
+function assertHasKey(root, keyName) {
+  var value = findValueForKey(root, keyName);
+  assert.notStrictEqual(value, undefined, 'expected describe() output to contain key "' + keyName + '"');
+  return value;
+}
+
+function assertObjectField(root, keyName) {
+  var value = assertHasKey(root, keyName);
+  assert.ok(value && typeof value === 'object' && !Array.isArray(value), 'expected "' + keyName + '" to describe a complex field');
+  return value;
+}
+
+function indirectRecursiveWsdl() {
+  return [
+    '<?xml version="1.0" encoding="utf-8"?>',
+    '<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:s="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://example.com/recursive" targetNamespace="http://example.com/recursive">',
+    '  <wsdl:types>',
+    '    <s:schema elementFormDefault="qualified" targetNamespace="http://example.com/recursive">',
+    '      <s:element name="FetchForest">',
+    '        <s:complexType/>',
+    '      </s:element>',
+    '      <s:element name="FetchForestResponse">',
+    '        <s:complexType>',
+    '          <s:sequence>',
+    '            <s:element minOccurs="0" maxOccurs="1" name="FetchForestResult" type="tns:TreeNode"/>',
+    '          </s:sequence>',
+    '        </s:complexType>',
+    '      </s:element>',
+    '      <s:complexType name="TreeNode">',
+    '        <s:sequence>',
+    '          <s:element minOccurs="0" maxOccurs="1" name="Title" type="s:string"/>',
+    '          <s:element minOccurs="0" maxOccurs="1" name="Branches" type="tns:TreeNodeList"/>',
+    '        </s:sequence>',
+    '      </s:complexType>',
+    '      <s:complexType name="TreeNodeList">',
+    '        <s:sequence>',
+    '          <s:element minOccurs="0" maxOccurs="unbounded" name="Branch" type="tns:TreeNode"/>',
+    '        </s:sequence>',
+    '      </s:complexType>',
+    '    </s:schema>',
+    '  </wsdl:types>',
+    '  <wsdl:message name="FetchForestSoapIn">',
+    '    <wsdl:part name="parameters" element="tns:FetchForest"/>',
+    '  </wsdl:message>',
+    '  <wsdl:message name="FetchForestSoapOut">',
+    '    <wsdl:part name="parameters" element="tns:FetchForestResponse"/>',
+    '  </wsdl:message>',
+    '  <wsdl:portType name="RecursiveSoap">',
+    '    <wsdl:operation name="FetchForest">',
+    '      <wsdl:input message="tns:FetchForestSoapIn"/>',
+    '      <wsdl:output message="tns:FetchForestSoapOut"/>',
+    '    </wsdl:operation>',
+    '  </wsdl:portType>',
+    '  <wsdl:binding name="RecursiveSoap" type="tns:RecursiveSoap">',
+    '    <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>',
+    '    <wsdl:operation name="FetchForest">',
+    '      <soap:operation soapAction="http://example.com/recursive/FetchForest" style="document"/>',
+    '      <wsdl:input><soap:body use="literal"/></wsdl:input>',
+    '      <wsdl:output><soap:body use="literal"/></wsdl:output>',
+    '    </wsdl:operation>',
+    '  </wsdl:binding>',
+    '  <wsdl:service name="RecursiveService">',
+    '    <wsdl:port name="RecursiveSoap" binding="tns:RecursiveSoap">',
+    '      <soap:address location="http://localhost/recursive"/>',
+    '    </wsdl:port>',
+    '  </wsdl:service>',
+    '</wsdl:definitions>'
+  ].join('\n');
+}
+
+function directRecursiveWsdl() {
+  return [
+    '<?xml version="1.0" encoding="utf-8"?>',
+    '<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:s="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://example.com/recursive" targetNamespace="http://example.com/recursive">',
+    '  <wsdl:types>',
+    '    <s:schema elementFormDefault="qualified" targetNamespace="http://example.com/recursive">',
+    '      <s:element name="ReadCategory">',
+    '        <s:complexType/>',
+    '      </s:element>',
+    '      <s:element name="ReadCategoryResponse">',
+    '        <s:complexType>',
+    '          <s:sequence>',
+    '            <s:element minOccurs="0" maxOccurs="1" name="ReadCategoryResult" type="tns:Category"/>',
+    '          </s:sequence>',
+    '        </s:complexType>',
+    '      </s:element>',
+    '      <s:complexType name="Category">',
+    '        <s:sequence>',
+    '          <s:element minOccurs="0" maxOccurs="1" name="Name" type="s:string"/>',
+    '          <s:element minOccurs="0" maxOccurs="1" name="Parent" type="tns:Category"/>',
+    '        </s:sequence>',
+    '      </s:complexType>',
+    '    </s:schema>',
+    '  </wsdl:types>',
+    '  <wsdl:message name="ReadCategorySoapIn">',
+    '    <wsdl:part name="parameters" element="tns:ReadCategory"/>',
+    '  </wsdl:message>',
+    '  <wsdl:message name="ReadCategorySoapOut">',
+    '    <wsdl:part name="parameters" element="tns:ReadCategoryResponse"/>',
+    '  </wsdl:message>',
+    '  <wsdl:portType name="CategorySoap">',
+    '    <wsdl:operation name="ReadCategory">',
+    '      <wsdl:input message="tns:ReadCategorySoapIn"/>',
+    '      <wsdl:output message="tns:ReadCategorySoapOut"/>',
+    '    </wsdl:operation>',
+    '  </wsdl:portType>',
+    '  <wsdl:binding name="CategorySoap" type="tns:CategorySoap">',
+    '    <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>',
+    '    <wsdl:operation name="ReadCategory">',
+    '      <soap:operation soapAction="http://example.com/recursive/ReadCategory" style="document"/>',
+    '      <wsdl:input><soap:body use="literal"/></wsdl:input>',
+    '      <wsdl:output><soap:body use="literal"/></wsdl:output>',
+    '    </wsdl:operation>',
+    '  </wsdl:binding>',
+    '  <wsdl:service name="CategoryService">',
+    '    <wsdl:port name="CategorySoap" binding="tns:CategorySoap">',
+    '      <soap:address location="http://localhost/category"/>',
+    '    </wsdl:port>',
+    '  </wsdl:service>',
+    '</wsdl:definitions>'
+  ].join('\n');
+}
+
+function multiLevelRecursiveWsdl() {
+  return [
+    '<?xml version="1.0" encoding="utf-8"?>',
+    '<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:s="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://example.com/accounts" targetNamespace="http://example.com/accounts">',
+    '  <wsdl:types>',
+    '    <s:schema elementFormDefault="qualified" targetNamespace="http://example.com/accounts">',
+    '      <s:element name="LoadLedger">',
+    '        <s:complexType/>',
+    '      </s:element>',
+    '      <s:element name="LoadLedgerResponse">',
+    '        <s:complexType>',
+    '          <s:sequence>',
+    '            <s:element minOccurs="0" maxOccurs="1" name="LoadLedgerResult" type="tns:LedgerRoot"/>',
+    '          </s:sequence>',
+    '        </s:complexType>',
+    '      </s:element>',
+    '      <s:complexType name="LedgerRoot">',
+    '        <s:sequence>',
+    '          <s:element minOccurs="0" maxOccurs="1" name="Label" type="s:string"/>',
+    '          <s:element minOccurs="0" maxOccurs="1" name="Accounts" type="tns:LedgerEntry"/>',
+    '        </s:sequence>',
+    '      </s:complexType>',
+    '      <s:complexType name="LedgerEntry">',
+    '        <s:sequence>',
+    '          <s:element minOccurs="0" maxOccurs="1" name="Name" type="s:string"/>',
+    '          <s:element minOccurs="0" maxOccurs="1" name="Details" type="tns:LedgerDetails"/>',
+    '        </s:sequence>',
+    '      </s:complexType>',
+    '      <s:complexType name="LedgerDetails">',
+    '        <s:sequence>',
+    '          <s:element minOccurs="0" maxOccurs="1" name="Code" type="s:string"/>',
+    '          <s:element minOccurs="0" maxOccurs="1" name="Root" type="tns:LedgerRoot"/>',
+    '        </s:sequence>',
+    '      </s:complexType>',
+    '    </s:schema>',
+    '  </wsdl:types>',
+    '  <wsdl:message name="LoadLedgerSoapIn">',
+    '    <wsdl:part name="parameters" element="tns:LoadLedger"/>',
+    '  </wsdl:message>',
+    '  <wsdl:message name="LoadLedgerSoapOut">',
+    '    <wsdl:part name="parameters" element="tns:LoadLedgerResponse"/>',
+    '  </wsdl:message>',
+    '  <wsdl:portType name="LedgerSoap">',
+    '    <wsdl:operation name="LoadLedger">',
+    '      <wsdl:input message="tns:LoadLedgerSoapIn"/>',
+    '      <wsdl:output message="tns:LoadLedgerSoapOut"/>',
+    '    </wsdl:operation>',
+    '  </wsdl:portType>',
+    '  <wsdl:binding name="LedgerSoap" type="tns:LedgerSoap">',
+    '    <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>',
+    '    <wsdl:operation name="LoadLedger">',
+    '      <soap:operation soapAction="http://example.com/accounts/LoadLedger" style="document"/>',
+    '      <wsdl:input><soap:body use="literal"/></wsdl:input>',
+    '      <wsdl:output><soap:body use="literal"/></wsdl:output>',
+    '    </wsdl:operation>',
+    '  </wsdl:binding>',
+    '  <wsdl:service name="LedgerService">',
+    '    <wsdl:port name="LedgerSoap" binding="tns:LedgerSoap">',
+    '      <soap:address location="http://localhost/ledger"/>',
+    '    </wsdl:port>',
+    '  </wsdl:service>',
+    '</wsdl:definitions>'
+  ].join('\n');
+}
+
+describe('recursive WSDL describe()', function() {
+  it('describes an indirectly recursive complex type without overflowing', function(done) {
+    var wsdlPath = writeWsdl('indirect-recursive', indirectRecursiveWsdl());
+
+    describeClient(wsdlPath, done, function(description) {
+      assert.ok(description && typeof description === 'object', 'describe() should return an object');
+      assertHasKey(description, 'FetchForest');
+      assertHasKey(description, 'FetchForestResult');
+      assertHasKey(description, 'Title');
+      assertObjectField(description, 'Branches');
+      assertObjectField(description, 'Branch');
+    });
+  });
+
+  it('describes a longer indirect recursive complex type in another namespace', function(done) {
+    var wsdlPath = writeWsdl('longer-indirect-recursive', multiLevelRecursiveWsdl());
+
+    describeClient(wsdlPath, done, function(description) {
+      assert.ok(description && typeof description === 'object', 'describe() should return an object');
+      assertHasKey(description, 'LoadLedger');
+      assertHasKey(description, 'LoadLedgerResult');
+      assertHasKey(description, 'Label');
+      assertObjectField(description, 'Accounts');
+      assertHasKey(description, 'Name');
+      assertObjectField(description, 'Details');
+      assertHasKey(description, 'Code');
+      assertObjectField(description, 'Root');
+    });
+  });
+
+  it('describes a directly recursive complex type without unbounded expansion', function(done) {
+    var wsdlPath = writeWsdl('direct-recursive', directRecursiveWsdl());
+
+    describeClient(wsdlPath, done, function(description) {
+      assert.ok(description && typeof description === 'object', 'describe() should return an object');
+      assertHasKey(description, 'ReadCategory');
+      assertHasKey(description, 'ReadCategoryResult');
+      assertHasKey(description, 'Name');
+      assertObjectField(description, 'Parent');
+    });
+  });
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,38 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+npm install --no-audit --no-fund 2>/dev/null
+
+
+
+
+mkdir -p /testbed/.build_env
+if [ ! -f /testbed/.build_env/force-ipv4.js ]; then
+  {
+    printf '%s\n' "var http = require('http');"
+    printf '%s\n' "var origListen = http.Server.prototype.listen;"
+    printf '%s\n' "http.Server.prototype.listen = function() {"
+    printf '%s\n' "  var args = Array.prototype.slice.call(arguments);"
+    printf '%s\n' "  if (args.length >= 2 && (args[1] === null || args[1] === undefined)) {"
+    printf '%s\n' "    args[1] = '0.0.0.0';"
+    printf '%s\n' "  }"
+    printf '%s\n' "  return origListen.apply(this, args);"
+    printf '%s\n' "};"
+  } > /testbed/.build_env/force-ipv4.js
+fi
+export NODE_OPTIONS="-r /testbed/.build_env/force-ipv4.js"
+
+case "${1:-}" in
+  base)
+    node ./node_modules/.bin/_mocha -R spec -u exports --grep "stockquote.wsdl" test/wsdl-test.js
+    ;;
+  new)
+    node ./node_modules/.bin/_mocha -R spec test/wsdl-recursive-describe-test.js
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
