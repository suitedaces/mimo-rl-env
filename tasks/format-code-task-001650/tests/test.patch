diff --git a/test/unit/4_dispatch/permissions_issue.spec.js b/test/unit/4_dispatch/permissions_issue.spec.js
new file mode 100644
index 00000000..5cf13a77
--- /dev/null
+++ b/test/unit/4_dispatch/permissions_issue.spec.js
@@ -0,0 +1,166 @@
+
+
+
+
+
+
+
+var assert = require('assert');
+var path = require('path');
+
+describe('permissions name discrepancy issue', function () {
+  this.timeout(30000);
+
+  var engine;
+  var ctx;
+
+  before(function (done) {
+    process.env.JOOLA_NO_DOMAIN = '1';
+    process.env.NODE_TLS_REJECT_UNAUTHORIZED = '0';
+    process.env.JOOLA_CONFIG_INTERFACES_WEBSERVER_SECUREONLY = 'false';
+    process.env.JOOLA_CONFIG_AUTHENTICATION_BASICAUTH_ENABLED = 'true';
+    process.env.JOOLA_CONFIG_STORE_LOGGER_CONSOLE_LEVEL = 'error';
+
+    require('../../../joola.js').init({}, function (err, eng) {
+      if (err) return done(err);
+      eng.state.once('state:change', function (state) {
+        if (state !== 'online') return done(new Error('engine state: ' + state));
+        engine = eng;
+        ctx = { user: { permissions: ['superuser'] } };
+        done();
+      });
+    });
+  });
+
+  after(function (done) {
+    if (engine && engine.shutdown) {
+      engine.shutdown(0, function () { done(); });
+    } else {
+      done();
+    }
+  });
+
+  it('list includes query:fetch (the actual permission used by query.fetch)', function (done) {
+    engine.permissions.list(ctx, function (err, list) {
+      if (err) return done(err);
+      assert(Array.isArray(list), 'expected an array');
+      assert(list.indexOf('query:fetch') !== -1,
+        'expected list to contain "query:fetch", got: ' + JSON.stringify(list));
+      done();
+    });
+  });
+
+  it('list includes query:stop', function (done) {
+    engine.permissions.list(ctx, function (err, list) {
+      if (err) return done(err);
+      assert(list.indexOf('query:stop') !== -1,
+        'expected list to contain "query:stop", got: ' + JSON.stringify(list));
+      done();
+    });
+  });
+
+  it('list includes beacon:insert (actual beacon insert permission)', function (done) {
+    engine.permissions.list(ctx, function (err, list) {
+      if (err) return done(err);
+      assert(list.indexOf('beacon:insert') !== -1,
+        'expected list to contain "beacon:insert", got: ' + JSON.stringify(list));
+      done();
+    });
+  });
+
+  it('list reconciles legacy "query" name with the actual query permission', function (done) {
+
+
+
+    engine.permissions.list(ctx, function (err, list) {
+      if (err) return done(err);
+      assert(list.indexOf('query:fetch') !== -1,
+        'list must contain the actual permission "query:fetch"; full list: ' + JSON.stringify(list));
+      done();
+    });
+  });
+
+  it('list reconciles legacy "beacon_insert" name with the actual beacon permission', function (done) {
+    engine.permissions.list(ctx, function (err, list) {
+      if (err) return done(err);
+      assert(list.indexOf('beacon:insert') !== -1,
+        'list must contain the actual permission "beacon:insert"; full list: ' + JSON.stringify(list));
+      done();
+    });
+  });
+
+  it('list includes namespaced permissions from multiple modules', function (done) {
+    engine.permissions.list(ctx, function (err, list) {
+      if (err) return done(err);
+      var expected = [
+        'roles:add',
+        'users:list',
+        'collections:list',
+        'workspaces:list',
+        'system:version'
+      ];
+      expected.forEach(function (p) {
+        assert(list.indexOf(p) !== -1,
+          'expected list to contain "' + p + '"; full list: ' + JSON.stringify(list));
+      });
+      done();
+    });
+  });
+
+  it('get("query:fetch") succeeds and returns the permission', function (done) {
+    engine.permissions.get(ctx, 'query:fetch', function (err, result) {
+      if (err) return done(err);
+      assert(Array.isArray(result), 'expected array result');
+      assert.strictEqual(result[0], 'query:fetch');
+      done();
+    });
+  });
+
+  it('get("beacon:insert") succeeds', function (done) {
+    engine.permissions.get(ctx, 'beacon:insert', function (err, result) {
+      if (err) return done(err);
+      assert.strictEqual(result[0], 'beacon:insert');
+      done();
+    });
+  });
+
+  it('get("query") behaves consistently with list (legacy name reconciliation)', function (done) {
+
+
+
+    engine.permissions.list(ctx, function (err, list) {
+      if (err) return done(err);
+      var inList = list.indexOf('query') !== -1;
+      engine.permissions.get(ctx, 'query', function (gerr, result) {
+        if (inList) {
+          assert(!gerr, 'list contains "query" but get() errored: ' + gerr);
+        } else {
+          assert(gerr, 'list omits "query"; expected get() to error too');
+        }
+        done();
+      });
+    });
+  });
+
+  it('get("beacon_insert") behaves consistently with list (legacy name reconciliation)', function (done) {
+    engine.permissions.list(ctx, function (err, list) {
+      if (err) return done(err);
+      var inList = list.indexOf('beacon_insert') !== -1;
+      engine.permissions.get(ctx, 'beacon_insert', function (gerr, result) {
+        if (inList) {
+          assert(!gerr, 'list contains "beacon_insert" but get() errored: ' + gerr);
+        } else {
+          assert(gerr, 'list omits "beacon_insert"; expected get() to error too');
+        }
+        done();
+      });
+    });
+  });
+
+  it('get("nonexistent_permission_xyz") still returns an error (preservation)', function (done) {
+    engine.permissions.get(ctx, 'nonexistent_permission_xyz', function (err, result) {
+      assert(err, 'expected error for unknown permission');
+      done();
+    });
+  });
+});
