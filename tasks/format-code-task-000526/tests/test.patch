diff --git a/usercase-test-coderl/test_gameshark_stateful.py b/usercase-test-coderl/test_gameshark_stateful.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_gameshark_stateful.py
@@ -0,0 +1,290 @@
+
+
+
+
+
+
+
+import gc
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, "/workspace/repo")
+
+from pyboy import PyBoy
+from pyboy.utils import PyBoyInvalidInputException
+
+
+ROM = "/tmp/pyboy_gameshark_minimal.gb"
+BOOTROM = "/tmp/pyboy_gameshark_bootrom.bin"
+CODE_CD38 = "010138CD"
+CODE_CE38 = "010138CE"
+ADDR_CD38 = 0xCD38
+ADDR_CE38 = 0xCE38
+
+
+def ensure_test_rom():
+
+    rom_path = Path(ROM)
+    bootrom_path = Path(BOOTROM)
+
+    rom = bytearray([0] * 0x4000)
+    rom[0x100:0x103] = b"\xC3\x00\x01"
+    rom[0x134:0x140] = b"TSTGAMESHARK"
+    rom[0x147] = 0x00
+    rom[0x148] = 0x00
+    rom[0x149] = 0x00
+
+    checksum = 0
+    for address in range(0x134, 0x14D):
+        checksum = (checksum - rom[address] - 1) & 0xFF
+    rom[0x14D] = checksum
+    rom_path.write_bytes(rom)
+
+    bootrom = bytearray([0] * 0x100)
+    bootrom[0:3] = b"\xC3\x00\x00"
+    bootrom_path.write_bytes(bootrom)
+
+
+def make_pyboy(**kwargs):
+    ensure_test_rom()
+    return PyBoy(ROM, window="null", bootrom=BOOTROM, cgb=False, **kwargs)
+
+
+def stop_pyboy(pyboy):
+    pyboy.stop(save=False)
+
+
+def assert_gameshark_public_api(pyboy):
+
+    assert pyboy.gameshark is not None
+    assert callable(pyboy.gameshark.add)
+    assert callable(pyboy.gameshark.remove)
+    assert callable(pyboy.gameshark.clear_all)
+
+
+def test_add_tick_remove_restore_and_remove_without_restore():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+        pyboy.tick(60)
+        assert_gameshark_public_api(pyboy)
+
+        original_cd38 = pyboy.memory[ADDR_CD38]
+        assert original_cd38 != 0x01
+
+        pyboy.gameshark.add(CODE_CD38)
+
+        assert pyboy.memory[ADDR_CD38] == original_cd38
+
+        pyboy.tick()
+        assert pyboy.memory[ADDR_CD38] == 0x01
+
+        pyboy.gameshark.remove(CODE_CD38)
+
+        assert pyboy.memory[ADDR_CD38] == original_cd38
+
+        pyboy.gameshark.add(CODE_CD38)
+        pyboy.tick()
+        assert pyboy.memory[ADDR_CD38] == 0x01
+
+        pyboy.gameshark.remove(CODE_CD38, False)
+        assert pyboy.memory[ADDR_CD38] == 0x01
+    finally:
+        stop_pyboy(pyboy)
+
+
+def test_multiple_cheats_clear_all_restores_each_address():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+        pyboy.tick(60)
+        assert_gameshark_public_api(pyboy)
+
+        original_cd38 = pyboy.memory[ADDR_CD38]
+        original_ce38 = pyboy.memory[ADDR_CE38]
+        assert original_cd38 != 0x01
+        assert original_ce38 != 0x01
+
+        pyboy.gameshark.add(CODE_CD38)
+
+        assert pyboy.memory[ADDR_CD38] == original_cd38
+
+        pyboy.gameshark.add(CODE_CE38)
+
+        assert pyboy.memory[ADDR_CE38] == original_ce38
+
+        pyboy.tick()
+        assert pyboy.memory[ADDR_CD38] == 0x01
+        assert pyboy.memory[ADDR_CE38] == 0x01
+
+        pyboy.gameshark.clear_all()
+
+        assert pyboy.memory[ADDR_CD38] == original_cd38
+        assert pyboy.memory[ADDR_CE38] == original_ce38
+
+        pyboy.tick()
+        assert pyboy.memory[ADDR_CD38] == original_cd38
+        assert pyboy.memory[ADDR_CE38] == original_ce38
+    finally:
+        stop_pyboy(pyboy)
+
+
+def test_constructor_registers_comma_separated_startup_cheats_with_whitespace():
+
+
+
+
+    pyboy = make_pyboy(gameshark="010138CD, 010138CE")
+    try:
+        assert_gameshark_public_api(pyboy)
+        pyboy.tick(60)
+        assert pyboy.memory[ADDR_CD38] == 0x01
+        assert pyboy.memory[ADDR_CE38] == 0x01
+
+        pyboy.tick()
+        assert pyboy.memory[ADDR_CD38] == 0x01
+        assert pyboy.memory[ADDR_CE38] == 0x01
+    finally:
+        stop_pyboy(pyboy)
+
+
+def test_invalid_add_inputs_raise_specific_exceptions():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+
+        with pytest.raises(ValueError):
+            pyboy.gameshark.add("010138C")
+
+
+        with pytest.raises(ValueError):
+            pyboy.gameshark.add("0101387F")
+
+
+        with pytest.raises(ValueError):
+            pyboy.gameshark.add("020138CD")
+
+        pyboy.gameshark.add(CODE_CD38)
+        pyboy.tick()
+        assert pyboy.memory[ADDR_CD38] == 0x01
+    finally:
+        stop_pyboy(pyboy)
+
+
+def test_duplicate_add_and_missing_remove_raise_specific_exceptions():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+        pyboy.tick(60)
+
+        original_cd38 = pyboy.memory[ADDR_CD38]
+        assert original_cd38 != 0x01
+
+        pyboy.gameshark.add(CODE_CD38)
+
+
+        with pytest.raises(PyBoyInvalidInputException):
+            pyboy.gameshark.add(CODE_CD38)
+        pyboy.tick()
+        assert pyboy.memory[ADDR_CD38] == 0x01
+
+        pyboy.gameshark.remove(CODE_CD38)
+        assert pyboy.memory[ADDR_CD38] == original_cd38
+
+
+        with pytest.raises(ValueError):
+            pyboy.gameshark.remove(CODE_CD38)
+    finally:
+        stop_pyboy(pyboy)
+
+
+def test_two_pyboy_instances_keep_gameshark_state_independent():
+
+
+
+
+    first = make_pyboy()
+    second = make_pyboy()
+    try:
+        first.tick(60)
+        second.tick(60)
+        assert_gameshark_public_api(first)
+        assert_gameshark_public_api(second)
+
+        first_original = first.memory[ADDR_CD38]
+        second_original = second.memory[ADDR_CD38]
+        assert first_original != 0x01
+        assert second_original != 0x01
+
+        first.gameshark.add(CODE_CD38)
+        first.tick()
+        assert first.memory[ADDR_CD38] == 0x01
+        assert second.memory[ADDR_CD38] == second_original
+
+        second.tick()
+        assert first.memory[ADDR_CD38] == 0x01
+        assert second.memory[ADDR_CD38] == second_original
+    finally:
+        stop_pyboy(first)
+        stop_pyboy(second)
+
+
+def test_pyboy_stop_is_idempotent_after_gameshark_session():
+
+
+
+
+    pyboy = make_pyboy()
+    try:
+        pyboy.tick(60)
+        original_cd38 = pyboy.memory[ADDR_CD38]
+        assert original_cd38 != 0x01
+
+        pyboy.gameshark.add(CODE_CD38)
+        pyboy.tick()
+        assert pyboy.memory[ADDR_CD38] == 0x01
+
+
+        pyboy.gameshark.clear_all()
+        assert pyboy.memory[ADDR_CD38] == original_cd38
+    finally:
+        stop_pyboy(pyboy)
+
+
+def test_repeated_gameshark_sessions_do_not_retain_unbounded_resources():
+
+
+
+
+
+    gc.collect()
+
+    for _ in range(5):
+        pyboy = make_pyboy()
+        try:
+            pyboy.tick(60)
+            original_cd38 = pyboy.memory[ADDR_CD38]
+            assert original_cd38 != 0x01
+
+            pyboy.gameshark.add(CODE_CD38)
+            pyboy.tick()
+            assert pyboy.memory[ADDR_CD38] == 0x01
+            pyboy.gameshark.clear_all()
+            assert pyboy.memory[ADDR_CD38] == original_cd38
+        finally:
+            pyboy.stop(save=False)
