@@ -0,0 +1,16 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test ./desc/protoparse/ -run "TestLexer$|TestLexerErrors" -v -count=1
+    ;;
+  new)
+    go test ./desc/protoparse/ -run "TestNumericOptionLiteralCompatibility" -v -count=1
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
