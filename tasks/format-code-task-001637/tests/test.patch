diff --git a/desc/protoparse/numeric_options_compat_test.go b/desc/protoparse/numeric_options_compat_test.go
new file mode 100644
index 0000000..f44d5e0
--- /dev/null
+++ b/desc/protoparse/numeric_options_compat_test.go
@@ -0,0 +1,74 @@
+package protoparse
+
+import (
+	"fmt"
+	"math"
+	"strings"
+	"testing"
+
+	dpb "github.com/golang/protobuf/protoc-gen-go/descriptor"
+)
+
+func TestNumericOptionLiteralCompatibility(t *testing.T) {
+	testCases := []struct {
+		name    string
+		literal string
+		wantInt uint64
+		wantInf bool
+	}{
+		{name: "leading zero eight", literal: "08", wantInt: 8},
+		{name: "leading zero nine", literal: "09", wantInt: 9},
+		{name: "leading zero decimal non sample", literal: "089", wantInt: 89},
+		{name: "leading zero decimal second non sample", literal: "098", wantInt: 98},
+		{name: "existing accepted leading zero form", literal: "010", wantInt: 8},
+		{name: "positive float overflow", literal: "1e10000", wantInf: true},
+		{name: "positive float overflow non sample", literal: "1.25e10000", wantInf: true},
+		{name: "positive float overflow second non sample", literal: "2e10000", wantInf: true},
+		{name: "positive digit only overflow", literal: strings.Repeat("9", 10000), wantInf: true},
+		{name: "positive digit only overflow non sample", literal: strings.Repeat("8", 10000), wantInf: true},
+	}
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			uo := parseNumericCompatOption(t, tc.literal)
+			if tc.wantInf {
+				if uo.DoubleValue == nil {
+					t.Fatalf("option literal %q stored no double value", tc.literal)
+				}
+				if !math.IsInf(uo.GetDoubleValue(), 1) {
+					t.Fatalf("option literal %q double value = %v, want positive infinity", tc.literal, uo.GetDoubleValue())
+				}
+				return
+			}
+			if uo.PositiveIntValue == nil {
+				t.Fatalf("option literal %q stored no positive int value", tc.literal)
+			}
+			if got := uo.GetPositiveIntValue(); got != tc.wantInt {
+				t.Fatalf("option literal %q positive int value = %d, want %d", tc.literal, got, tc.wantInt)
+			}
+		})
+	}
+}
+
+func parseNumericCompatOption(t *testing.T, literal string) *dpb.UninterpretedOption {
+	t.Helper()
+	const filename = "numeric_compat.proto"
+	p := Parser{
+		Accessor: FileContentsFromMap(map[string]string{
+			filename: fmt.Sprintf(`syntax = "proto2"; option (numeric.compat) = %s; message M {}`, literal),
+		}),
+		ValidateUnlinkedFiles:           true,
+		InterpretOptionsInUnlinkedFiles: true,
+	}
+	fds, err := p.ParseFilesButDoNotLink(filename)
+	if err != nil {
+		t.Fatalf("ParseFilesButDoNotLink(%q) failed for literal %q: %v", filename, literal, err)
+	}
+	if len(fds) != 1 {
+		t.Fatalf("ParseFilesButDoNotLink(%q) returned %d files, want 1", filename, len(fds))
+	}
+	opts := fds[0].GetOptions().GetUninterpretedOption()
+	if len(opts) != 1 {
+		t.Fatalf("literal %q produced %d uninterpreted options, want 1", literal, len(opts))
+	}
+	return opts[0]
+}
