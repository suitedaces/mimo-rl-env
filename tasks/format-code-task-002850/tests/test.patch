+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+export PIP_NO_INDEX=1
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+export SQLMESH__DISABLE_ANONYMIZED_ANALYTICS=true
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+python -m pip install -e . --no-index --no-deps --no-build-isolation >/dev/null 2>&1
+
+exec python -m pytest \
+  -p xdist.plugin \
+  -p pytest_rerunfailures \
+  -p pytest_asyncio.plugin \
+  /workspace/repo/usercase-test-coderl/test_native_yaml_model_tests.py -v
