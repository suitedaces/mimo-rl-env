+
+def test_repeated_context_load_cycles_do_not_duplicate_loaded_metadata(tmp_path: Path) -> None:
+
+
+
+
+    _write(
+        tmp_path / "tests/test_one.yaml",
+        """
+test_one:
+  model: sushi.one
+  inputs:
+    source.one:
+      - marker: "{{ var('gateway_marker') }}"
+  outputs:
+    query:
+      - limit_seen: {{ var('item_limit') }}
+""",
+    )
+
+    context = Context(
+        paths=tmp_path,
+        config=_config(),
+        gateway="primary",
+        load=True,
+        load_state=False,
+    )
+    try:
+        for _ in range(5):
+
+            context.load(update_schemas=False)
+            metadata = context.select_tests()
+            assert [item.test_name for item in metadata] == ["test_one"]
+            assert metadata[0].body == {
+                "model": "sushi.one",
+                "inputs": {"source.one": [{"marker": "primary_marker"}]},
+                "outputs": {"query": [{"limit_seen": 3}]},
+            }
+    finally:
+        context.close()
