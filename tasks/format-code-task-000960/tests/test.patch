@@ -0,0 +1,108 @@
+
+
+import dataclasses
+
+from absl.testing import absltest
+import numpy as np
+from torax._src import interpolated_param
+from torax._src.geometry import geometry
+from torax._src.geometry import geometry_provider
+from torax._src.geometry import pydantic_model
+
+
+class GeometryInterpolationContractTest(absltest.TestCase):
+
+  def _geometries(self):
+    return (
+        pydantic_model.CircularConfig(R_major=6.0, a_minor=2.0).build_geometry(),
+        pydantic_model.CircularConfig(R_major=8.0, a_minor=1.0).build_geometry(),
+    )
+
+  def test_unsorted_schedule_is_sorted_for_linear_interpolation(self):
+    geo_0, geo_1 = self._geometries()
+    schedule = {10.0: geo_1, 0.0: geo_0}
+    provider = geometry_provider.TimeDependentGeometryProvider.create_provider(
+        schedule
+    )
+
+    np.testing.assert_allclose(provider(5.0).R_major, 7.0)
+    np.testing.assert_allclose(
+        provider(5.0).Phi, (geo_0.Phi + geo_1.Phi) / 2.0
+    )
+    np.testing.assert_allclose(provider(-1.0).R_major, 6.0)
+    np.testing.assert_allclose(provider(11.0).R_major, 8.0)
+    self.assertEqual(list(schedule), [10.0, 0.0])
+
+  def test_step_mode_is_wired_through_pydantic_config(self):
+    geo_0, _ = self._geometries()
+    cfg = pydantic_model.Geometry.from_dict({
+        'geometry_type': 'circular',
+        'geometry_interpolation_mode': 'StEp',
+        'geometry_configs': {
+            10.0: {'R_major': 8.0, 'a_minor': 1.0},
+            0.0: {'R_major': 6.0, 'a_minor': 2.0},
+        },
+    })
+    provider = cfg.build_provider
+
+    np.testing.assert_allclose(provider(-1.0).R_major, 6.0)
+    np.testing.assert_allclose(provider(5.0).R_major, 6.0)
+    np.testing.assert_allclose(provider(5.0).Phi, geo_0.Phi)
+    np.testing.assert_allclose(provider(10.0).R_major, 8.0)
+    np.testing.assert_allclose(provider(11.0).a_minor, 1.0)
+
+  def test_interpolation_mode_accepts_enum_directly(self):
+    geo_0, geo_1 = self._geometries()
+    provider = geometry_provider.TimeDependentGeometryProvider.create_provider(
+        {0.0: geo_0, 10.0: geo_1},
+        interpolation_mode=interpolated_param.InterpolationMode.STEP,
+    )
+    np.testing.assert_allclose(provider(5.0).R_major, 6.0)
+
+  def test_empty_or_nonfinite_schedule_is_rejected(self):
+    geo_0, _ = self._geometries()
+    for schedule in ({}, {np.inf: geo_0}, {np.nan: geo_0}):
+      with self.subTest(schedule=schedule):
+        with self.assertRaises(ValueError):
+          geometry_provider.TimeDependentGeometryProvider.create_provider(
+              schedule
+          )
+
+  def test_empty_geometry_configs_are_not_static_fallback(self):
+    with self.assertRaises(ValueError):
+      pydantic_model.Geometry.from_dict({
+          'geometry_type': 'circular',
+          'geometry_configs': {},
+      })
+
+  def test_invalid_interpolation_mode_is_rejected(self):
+    geo_0, _ = self._geometries()
+    with self.assertRaises(ValueError):
+      geometry_provider.TimeDependentGeometryProvider.create_provider(
+          {0.0: geo_0}, interpolation_mode='cubic'
+      )
+    with self.assertRaises(ValueError):
+      pydantic_model.Geometry.from_dict({
+          'geometry_type': 'circular',
+          'geometry_interpolation_mode': 'cubic',
+          'geometry_configs': {0.0: {}},
+      })
+
+  def test_existing_geometry_compatibility_checks_remain(self):
+    geo_0, _ = self._geometries()
+    wrong_type = dataclasses.replace(
+        geo_0, geometry_type=geometry.GeometryType.FBT
+    )
+    wrong_mesh = pydantic_model.CircularConfig(n_rho=50).build_geometry()
+    with self.assertRaisesRegex(ValueError, 'same geometry type'):
+      geometry_provider.TimeDependentGeometryProvider.create_provider(
+          {0.0: geo_0, 1.0: wrong_type}
+      )
+    with self.assertRaisesRegex(ValueError, 'same mesh'):
+      geometry_provider.TimeDependentGeometryProvider.create_provider(
+          {0.0: geo_0, 1.0: wrong_mesh}
+      )
+
+
+if __name__ == '__main__':
+  absltest.main()
