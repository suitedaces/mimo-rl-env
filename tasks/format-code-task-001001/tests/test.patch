+++ b/web/src/search/input/codespec_filter_normalization.test.ts
@@ -0,0 +1,78 @@
+import { FilterType, isNegatedFilter, resolveNegatedFilter } from '../../../../shared/src/search/interactive/util'
+import { isFiniteFilter, isTextFilter } from './interactive/filters'
+import { convertPlainTextToInteractiveQuery } from './helpers'
+import { isSingularFilter } from '../../../../shared/src/search/parser/filters'
+
+describe('interactive filter normalization', () => {
+    test('classifies filter names case-insensitively', () => {
+        expect(isSingularFilter('CASE')).toBe(true)
+        expect(isSingularFilter('Case')).toBe(true)
+        expect(isFiniteFilter('ARCHIVED' as FilterType)).toBe(true)
+        expect(isTextFilter('RePo' as FilterType)).toBe(true)
+    })
+
+    test('canonicalizes filter types and preserves aliases and negation', () => {
+        const result = convertPlainTextToInteractiveQuery('needle RePo:^acme/one$ CASE:no -F:^generated/')
+        expect(result.navbarQuery).toBe('needle')
+        expect(result.filtersInQuery).toEqual(
+            expect.objectContaining({
+                case: {
+                    type: FilterType.case,
+                    value: 'no',
+                    editable: false,
+                    negated: false,
+                },
+            })
+        )
+
+        const filters = Object.values(result.filtersInQuery)
+        expect(filters).toEqual(
+            expect.arrayContaining([
+                {
+                    type: FilterType.repo,
+                    value: '^acme/one$',
+                    editable: false,
+                    negated: false,
+                },
+                {
+                    type: FilterType.file,
+                    value: '^generated/',
+                    editable: false,
+                    negated: true,
+                },
+            ])
+        )
+
+        const repeated = convertPlainTextToInteractiveQuery('repo:one r:two')
+        expect(Object.values(repeated.filtersInQuery)).toEqual(
+            expect.arrayContaining([
+                expect.objectContaining({ type: FilterType.repo, value: 'one' }),
+                expect.objectContaining({ type: FilterType.repo, value: 'two' }),
+            ])
+        )
+        expect(Object.keys(repeated.filtersInQuery)).toHaveLength(2)
+    })
+
+    test('later occurrences replace earlier singular filters regardless of spelling', () => {
+        const result = convertPlainTextToInteractiveQuery('case:no CASE:yes')
+        expect(Object.keys(result.filtersInQuery)).toEqual(['case'])
+        expect(result.filtersInQuery.case).toEqual({
+            type: FilterType.case,
+            value: 'yes',
+            editable: false,
+            negated: false,
+        })
+    })
+
+    test('invalid filters remain in the navbar query', () => {
+        const result = convertPlainTextToInteractiveQuery('RePoS:foo UNKNOWN:bar')
+        expect(result.filtersInQuery).toEqual({})
+        expect(result.navbarQuery).toBe('RePoS:foo UNKNOWN:bar')
+    })
+
+    test('negated filter detection accepts case-insensitive spellings', () => {
+        expect(isNegatedFilter('-REPO')).toBe(true)
+        expect(isNegatedFilter('-f')).toBe(true)
+        expect(resolveNegatedFilter('-REPO' as any)).toBe(FilterType.repo)
+    })
+})
