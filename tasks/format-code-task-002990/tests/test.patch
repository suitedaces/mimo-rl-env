+#!/usr/bin/env node
+'use strict'
+
+const path = require('path')
+const { pathToFileURL } = require('url')
+const tape = require('tape')
+
+const testFile = path.resolve(__dirname, 'client_announce_lifecycle.test.js')
+
+tape.wait()
+tape.createStream().pipe(process.stdout)
+tape.onFinish(() => {
+
+
+  process.exit(tape.getHarness()._exitCode)
+})
+
+import(pathToFileURL(testFile).href)
+  .then(() => {
+    tape.run()
+  })
+  .catch(err => {
+    console.error(err)
+    process.exit(1)
+  })
