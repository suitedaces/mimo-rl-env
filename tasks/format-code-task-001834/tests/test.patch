+++ b/python/tests/nonreg/arcticdb/adapters/test_azure_library_adapter.py
@@ -0,0 +1,139 @@
+
+
+
+
+
+
+
+import re
+
+import pytest
+
+from arcticdb import Arctic
+from arcticdb.encoding_version import EncodingVersion
+
+
+
+
+ENDPOINT = (
+    "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;"
+    "AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;"
+    "BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1"
+)
+
+
+def _make_adapter(uri):
+
+
+
+
+
+    selected = [cls for cls in Arctic._LIBRARY_ADAPTERS if cls.supports_uri(uri)]
+    assert len(selected) == 1, f"Expected exactly one backend to handle {uri!r}, got {selected!r}"
+    cls = selected[0]
+    try:
+        return cls(uri, EncodingVersion.V1)
+    except TypeError:
+        return cls(uri)
+
+
+def _endpoint_from_repr(adapter):
+    match = re.fullmatch(r"azure\(endpoint=(?P<endpoint>.*), container=(?P<container>.*)\)", repr(adapter))
+    assert match is not None, f"Unexpected repr format: {repr(adapter)!r}"
+    return match
+
+
+
+
+
+
+
+def test_azure_uri_is_recognised():
+    selected = [cls for cls in Arctic._LIBRARY_ADAPTERS if cls.supports_uri(f"azure://{ENDPOINT};Container=foo")]
+    assert len(selected) == 1
+
+
+@pytest.mark.parametrize("uri", ["s3://endpoint:bucket", "s3s://endpoint:bucket", "lmdb:///tmp/foo"])
+def test_azure_backend_rejects_other_schemes(uri):
+    azure_backends = [cls for cls in Arctic._LIBRARY_ADAPTERS if cls.supports_uri(f"azure://{ENDPOINT};Container=foo")]
+    assert len(azure_backends) == 1
+    azure_cls = azure_backends[0]
+    assert not azure_cls.supports_uri(uri)
+
+
+def test_other_backends_reject_azure():
+    azure_uri = f"azure://{ENDPOINT};Container=foo"
+    azure_backends = [cls for cls in Arctic._LIBRARY_ADAPTERS if cls.supports_uri(azure_uri)]
+    azure_cls = azure_backends[0]
+    for cls in Arctic._LIBRARY_ADAPTERS:
+        if cls is azure_cls:
+            continue
+        assert not cls.supports_uri(azure_uri)
+
+
+
+
+
+
+
+def test_connection_string_and_container_basic():
+    adapter = _make_adapter(f"azure://{ENDPOINT};Container=mycontainer")
+    match = _endpoint_from_repr(adapter)
+    assert match["endpoint"] == ENDPOINT
+    assert match["container"] == "mycontainer"
+
+
+def test_arctic_options_are_stripped_from_connection_string():
+    uri = f"azure://{ENDPOINT};Container=mycontainer;Path_prefix=some/prefix;CA_cert_path=/etc/ssl/cert.pem"
+    adapter = _make_adapter(uri)
+    endpoint = _endpoint_from_repr(adapter)["endpoint"]
+    assert endpoint == ENDPOINT
+    for stripped in ("Container=", "Path_prefix=", "CA_cert_path="):
+        assert stripped not in endpoint
+
+
+def test_connection_string_preserves_order():
+    uri = "azure://Container=c;B=2;A=1;C=3"
+    adapter = _make_adapter(uri)
+    assert _endpoint_from_repr(adapter)["endpoint"] == "B=2;A=1;C=3"
+
+
+def test_value_with_equals_is_preserved():
+    uri = f"azure://{ENDPOINT};Container=c"
+    adapter = _make_adapter(uri)
+    endpoint = _endpoint_from_repr(adapter)["endpoint"]
+    assert "AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==" in endpoint
+
+
+def test_key_matched_exactly_not_substring():
+
+    uri = "azure://AccountName=Containerxyz;Container=realcontainer"
+    adapter = _make_adapter(uri)
+    match = _endpoint_from_repr(adapter)
+    assert match["endpoint"] == "AccountName=Containerxyz"
+    assert match["container"] == "realcontainer"
+
+
+
+
+
+
+
+def test_path_prefix_stripped():
+    adapter = _make_adapter(f"azure://{ENDPOINT};Container=c;Path_prefix=/foo/bar/")
+    assert adapter.path_prefix == "foo/bar"
+
+
+def test_path_prefix_absent_is_none():
+    adapter = _make_adapter(f"azure://{ENDPOINT};Container=c")
+    assert adapter.path_prefix is None
+
+
+
+
+
+
+
+def test_empty_query_raises_value_error():
+    with pytest.raises(ValueError):
+        _make_adapter("azure://")
