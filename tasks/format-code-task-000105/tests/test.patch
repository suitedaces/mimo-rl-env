+++ b/pkg/util/fs_util_test.go
@@ -536,3 +536,82 @@ func TestExtractFile(t *testing.T) {
 		})
 	}
 }
+
+func Test_CopySymlink(t *testing.T) {
+	type setup func(t *testing.T, dest string)
+	tests := []struct {
+		name      string
+		linkTgt   string
+		setupDest setup
+	}{
+		{
+			name:    "dest does not exist, relative target",
+			linkTgt: "the-target",
+			setupDest: func(t *testing.T, dest string) {
+
+			},
+		},
+		{
+			name:    "dest does not exist, absolute target",
+			linkTgt: "/usr/local/lib/libpython3.7m.so",
+			setupDest: func(t *testing.T, dest string) {
+
+			},
+		},
+		{
+			name:    "dest is existing symlink, relative target",
+			linkTgt: "the-target",
+			setupDest: func(t *testing.T, dest string) {
+				if err := os.Symlink("some-other-target", dest); err != nil {
+					t.Fatal(err)
+				}
+			},
+		},
+		{
+			name:    "dest is existing symlink, absolute target",
+			linkTgt: "/usr/local/lib/libpython3.7m.so",
+			setupDest: func(t *testing.T, dest string) {
+				if err := os.Symlink("/some/other/path", dest); err != nil {
+					t.Fatal(err)
+				}
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			testDir, err := ioutil.TempDir("", "copysymlink")
+			if err != nil {
+				t.Fatalf("err creating tempdir: %v", err)
+			}
+			defer os.RemoveAll(testDir)
+
+			src := filepath.Join(testDir, "src.link")
+			if err := os.Symlink(tt.linkTgt, src); err != nil {
+				t.Fatalf("err creating src symlink: %v", err)
+			}
+
+			dest := filepath.Join(testDir, "dest.link")
+			tt.setupDest(t, dest)
+
+			if err := CopySymlink(src, dest); err != nil {
+				t.Fatalf("CopySymlink returned error: %v", err)
+			}
+
+			fi, err := os.Lstat(dest)
+			if err != nil {
+				t.Fatalf("Lstat(dest) failed: %v", err)
+			}
+			if fi.Mode()&os.ModeSymlink == 0 {
+				t.Fatalf("expected dest to be a symlink, mode=%v", fi.Mode())
+			}
+
+			got, err := os.Readlink(dest)
+			if err != nil {
+				t.Fatalf("Readlink(dest) failed: %v", err)
+			}
+			if got != tt.linkTgt {
+				t.Errorf("symlink target mismatch: got %q, want %q", got, tt.linkTgt)
+			}
+		})
+	}
+}
