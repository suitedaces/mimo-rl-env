diff --git a/test-data/unit/check-statements.test b/test-data/unit/check-statements.test
index 33e106504..180665301 100644
--- a/test-data/unit/check-statements.test
+++ b/test-data/unit/check-statements.test
@@ -1795,3 +1795,47 @@ def foo2():
     bar2 = []  # type: List[str]
     bar2
 [builtins fixtures/list.pyi]
+
+[case testImplicitInstantiationOfRaiseClassWithRequiredArg]
+class SomeException(Exception):
+    def __init__(self, thing: str) -> None: ...
+def a() -> None:
+    raise SomeException  # E: Too few arguments for "SomeException"
+def b() -> None:
+    raise SomeException()  # E: Missing positional argument "thing" in call to "SomeException"
+def c() -> None:
+    raise SomeException(thing="snake")
+[builtins fixtures/exception.pyi]
+
+[case testImplicitInstantiationOfRaiseClassNoRequiredArgs]
+class NoArgError(Exception): pass
+class OptionalArgError(Exception):
+    def __init__(self, x: int = 0) -> None: ...
+def f1() -> None:
+    raise NoArgError
+def f2() -> None:
+    raise OptionalArgError
+def f3() -> None:
+    raise BaseException
+[builtins fixtures/exception.pyi]
+
+[case testImplicitInstantiationOfRaiseClassMultipleRequiredArgs]
+class MultiArg(Exception):
+    def __init__(self, a: str, b: int) -> None: ...
+def f() -> None:
+    raise MultiArg  # E: Too few arguments for "MultiArg"
+[builtins fixtures/exception.pyi]
+
+[case testImplicitInstantiationOfRaiseClassKeywordOnlyArg]
+class OnlyKw(Exception):
+    def __init__(self, *, name: str) -> None: ...
+def f() -> None:
+    raise OnlyKw  # E: Missing named argument "name" for "OnlyKw"
+[builtins fixtures/exception.pyi]
+
+[case testImplicitInstantiationOfRaiseFromClassWithRequiredArg]
+class SomeException(Exception):
+    def __init__(self, thing: str) -> None: ...
+def f() -> None:
+    raise BaseException from SomeException  # E: Too few arguments for "SomeException"
+[builtins fixtures/exception.pyi]
