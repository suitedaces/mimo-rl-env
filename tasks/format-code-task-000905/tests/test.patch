diff --git a/tests/utils/test_weight.py b/tests/utils/test_weight.py
index 13243e6..718509b 100644
--- a/tests/utils/test_weight.py
+++ b/tests/utils/test_weight.py
@@ -53,3 +53,51 @@ class TestWeight:
             "\x1b[33mModerate Risk\x1b[0m",
             "\x1b[91mHigh Risk\x1b[0m",
         ]
+
+
+LOW_RISK = "\x1b[92mLow Risk\x1b[0m"
+MODERATE_RISK = "\x1b[33mModerate Risk\x1b[0m"
+HIGH_RISK = "\x1b[91mHigh Risk\x1b[0m"
+
+
+class TestWeightNegativeAndHighFix:
+    """Tests for the fix: Weight.calculate() must not raise ValueError
+    for negative weight_sum (benign APK with new rule weights), and must
+    classify weight_sum exceeding score_sum as High Risk instead of raising.
+    """
+
+    def test_small_negative_weight_returns_low_risk(self):
+
+
+        assert Weight(20, -10).calculate() == LOW_RISK
+
+    def test_negative_weight_does_not_raise(self):
+
+        Weight(29, -5).calculate()
+
+    def test_large_negative_weight_returns_low_risk(self):
+
+
+        assert Weight(20, -50).calculate() == LOW_RISK
+
+    def test_weight_far_exceeding_score_returns_high_risk(self):
+
+
+        assert Weight(20, 100).calculate() == HIGH_RISK
+
+    def test_weight_equal_to_score_returns_high_risk(self):
+
+        assert Weight(20, 20).calculate() == HIGH_RISK
+
+    def test_normal_low_risk_preserved(self):
+
+
+        assert Weight(20, 1).calculate() == LOW_RISK
+
+    def test_normal_moderate_risk_preserved(self):
+
+        assert Weight(20, 8).calculate() == MODERATE_RISK
+
+    def test_normal_high_risk_preserved(self):
+
+        assert Weight(20, 15).calculate() == HIGH_RISK
