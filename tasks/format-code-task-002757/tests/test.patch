@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+PYTHONPATH=src python -m pytest -rA tests/stream/dash/test_manifest.py::TestMPDParser::test_segment_list_dynamic_reload_yields_only_new_segments tests/stream/dash/test_manifest.py::TestMPDParser::test_segment_list_reload_no_new_segments tests/stream/dash/test_manifest.py::TestMPDParser::test_segment_list_static_unchanged
+rc=$(( rc | $? ))
+exit $rc
