diff --git a/tests/stream/dash/test_manifest.py b/tests/stream/dash/test_manifest.py
index 4d6ede52..8e3671ad 100644
--- a/tests/stream/dash/test_manifest.py
+++ b/tests/stream/dash/test_manifest.py
@@ -494,3 +494,86 @@ class TestMPDParser:
         assert getattr(mpd.get_representation(("period-0", "0", "audio2")), "mimeType", None) == "audio/mp4"
         assert getattr(mpd.get_representation(("period-0", None, "video1")), "mimeType", None) == "video/mp4"
         assert getattr(mpd.get_representation(("period-0", None, "video2")), "mimeType", None) == "video/mp4"
+
+    def test_segment_list_dynamic_reload_yields_only_new_segments(self):
+        """
+        https://github.com/streamlink/streamlink/issues/5478
+        After a manifest reload of a dynamic SegmentList, only new SegmentURLs
+        should be yielded - not the already-downloaded ones from the top.
+        """
+        with xml("dash/test_segment_list_p1.mpd") as mpd_xml_p1:
+            mpd_p1 = MPD(mpd_xml_p1, base_url="http://test/", url="http://test/manifest.mpd")
+            rep_p1 = mpd_p1.periods[0].adaptationSets[0].representations[0]
+            iter_p1 = rep_p1.segments()
+            segments_p1 = [(seg.uri, seg.num, seg.init, seg.content) for seg in iter_p1]
+
+
+        assert segments_p1 == [
+            ("http://test/init-video-p1.mp4", -1, True, False),
+            ("http://test/seg-2.mp4", 2, False, True),
+            ("http://test/seg-3.mp4", 3, False, True),
+            ("http://test/seg-4.mp4", 4, False, True),
+            ("http://test/seg-5.mp4", 5, False, True),
+            ("http://test/seg-6.mp4", 6, False, True),
+            ("http://test/seg-7.mp4", 7, False, True),
+            ("http://test/seg-8.mp4", 8, False, True),
+            ("http://test/seg-9.mp4", 9, False, True),
+            ("http://test/seg-10.mp4", 10, False, True),
+            ("http://test/seg-11.mp4", 11, False, True),
+            ("http://test/seg-12.mp4", 12, False, True),
+            ("http://test/seg-13.mp4", 13, False, True),
+            ("http://test/seg-14.mp4", 14, False, True),
+            ("http://test/seg-15.mp4", 15, False, True),
+            ("http://test/seg-16.mp4", 16, False, True),
+            ("http://test/seg-17.mp4", 17, False, True),
+        ]
+
+
+        with xml("dash/test_segment_list_p2.mpd") as mpd_xml_p2:
+            mpd_p2 = MPD(mpd_xml_p2, base_url=mpd_p1.base_url, url=mpd_p1.url, timelines=mpd_p1.timelines)
+            rep_p2 = mpd_p2.periods[0].adaptationSets[0].representations[0]
+            iter_p2 = rep_p2.segments(init=False)
+            segments_p2 = [(seg.uri, seg.num, seg.init, seg.content) for seg in iter_p2]
+
+
+        assert segments_p2 == [
+            ("http://test/seg-18.mp4", 18, False, True),
+            ("http://test/seg-19.mp4", 19, False, True),
+        ]
+
+    def test_segment_list_reload_no_new_segments(self):
+        """When the manifest is reloaded with no new SegmentURLs, no segments should be yielded."""
+        with xml("dash/test_segment_list_p1.mpd") as mpd_xml_p1:
+            mpd_p1 = MPD(mpd_xml_p1, base_url="http://test/", url="http://test/manifest.mpd")
+            rep_p1 = mpd_p1.periods[0].adaptationSets[0].representations[0]
+
+            list(rep_p1.segments())
+
+
+        with xml("dash/test_segment_list_p1.mpd") as mpd_xml_p1b:
+            mpd_p1b = MPD(mpd_xml_p1b, base_url=mpd_p1.base_url, url=mpd_p1.url, timelines=mpd_p1.timelines)
+            rep_p1b = mpd_p1b.periods[0].adaptationSets[0].representations[0]
+            segments_after_reload = list(rep_p1b.segments(init=False))
+
+        assert segments_after_reload == []
+
+    def test_segment_list_static_unchanged(self):
+        """Preservation: static SegmentList default invocation still yields init + all segments."""
+        with xml("dash/test_segment_list.mpd") as mpd_xml:
+            mpd = MPD(mpd_xml, base_url="http://test/", url="http://test/manifest.mpd")
+
+        segments = list(mpd.periods[0].adaptationSets[0].representations[0].segments())
+        uris = [seg.uri for seg in segments]
+
+        assert uris == [
+            "http://test/chunk_ctvideo_ridp0va0br4332748_cinit_mpd.m4s",
+            "http://test/chunk_ctvideo_ridp0va0br4332748_cn1_mpd.m4s",
+            "http://test/chunk_ctvideo_ridp0va0br4332748_cn2_mpd.m4s",
+            "http://test/chunk_ctvideo_ridp0va0br4332748_cn3_mpd.m4s",
+            "http://test/chunk_ctvideo_ridp0va0br4332748_cn4_mpd.m4s",
+            "http://test/chunk_ctvideo_ridp0va0br4332748_cn5_mpd.m4s",
+            "http://test/chunk_ctvideo_ridp0va0br4332748_cn6_mpd.m4s",
+            "http://test/chunk_ctvideo_ridp0va0br4332748_cn7_mpd.m4s",
+            "http://test/chunk_ctvideo_ridp0va0br4332748_cn8_mpd.m4s",
+            "http://test/chunk_ctvideo_ridp0va0br4332748_cn9_mpd.m4s",
+        ]
