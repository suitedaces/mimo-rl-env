     assert not simple_file.read_text()
+
+
+def test_addheader_gitignore(fake_repository, stringio, mock_date_today):
+    """Add a header to a .gitignore file (recognised by full filename)."""
+    simple_file = fake_repository / ".gitignore"
+    simple_file.write_text("*.pyc\nbuild/\n")
+
+    result = main(
+        [
+            "addheader",
+            "--license",
+            "CC0-1.0",
+            "--copyright",
+            "Mary Sue",
+            ".gitignore",
+        ],
+        out=stringio,
+    )
+
+    assert result == 0
+    assert (
+        simple_file.read_text()
+        == cleandoc(
+            """
+            # spdx-FileCopyrightText: 2018 Mary Sue
+            #
+            # spdx-License-Identifier: CC0-1.0
+
+            *.pyc
+            build/
+            """
+        ).replace("spdx", "SPDX")
+    )
+
+
+def test_addheader_gitattributes(fake_repository, stringio, mock_date_today):
+    """Add a header to a .gitattributes file (recognised by full filename)."""
+    simple_file = fake_repository / ".gitattributes"
+    simple_file.write_text("*.png binary\n")
+
+    result = main(
+        [
+            "addheader",
+            "--license",
+            "CC0-1.0",
+            "--copyright",
+            "Mary Sue",
+            ".gitattributes",
+        ],
+        out=stringio,
+    )
+
+    assert result == 0
+    text = simple_file.read_text()
+    assert "# SPDX-FileCopyrightText: 2018 Mary Sue" in text
+    assert "# SPDX-License-Identifier: CC0-1.0" in text
+    assert "*.png binary" in text
+
+
+def test_addheader_gitmodules(fake_repository, stringio, mock_date_today):
+    """Add a header to a .gitmodules file (recognised by full filename)."""
+    simple_file = fake_repository / ".gitmodules"
+    simple_file.write_text('[submodule "foo"]\n\tpath = foo\n')
+
+    result = main(
+        [
+            "addheader",
+            "--license",
+            "CC0-1.0",
+            "--copyright",
+            "Mary Sue",
+            ".gitmodules",
+        ],
+        out=stringio,
+    )
+
+    assert result == 0
+    text = simple_file.read_text()
+    assert "# SPDX-FileCopyrightText: 2018 Mary Sue" in text
+    assert "# SPDX-License-Identifier: CC0-1.0" in text
+    assert '[submodule "foo"]' in text
+
+
+def test_addheader_unrecognised_filename_no_extension(fake_repository):
+    """A text file with no extension and an unknown filename should still
+    error out — addheader must not silently treat every extensionless file
+    as a Python-style comment file."""
+    simple_file = fake_repository / "Randomfile"
+    simple_file.write_text("some text content\n")
+
+    with pytest.raises(SystemExit):
+        main(
+            [
+                "addheader",
+                "--license",
+                "CC0-1.0",
+                "--copyright",
+                "Mary Sue",
+                "Randomfile",
+            ]
+        )
