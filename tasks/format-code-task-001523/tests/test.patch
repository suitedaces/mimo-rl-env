diff --git a/usercase-test-coderl/raw_reader.test.js b/usercase-test-coderl/raw_reader.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/raw_reader.test.js
@@ -0,0 +1,315 @@
+
+
+
+
+
+
+
+
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+
+function loadHproseFromPublicSource() {
+  const fallbackFiles = [
+    'src/Init.js',
+    'src/Helper.js',
+    'src/Polyfill.js',
+    'src/BytesIO.js',
+    'src/Tags.js',
+    'src/ClassManager.js',
+    'src/Writer.js',
+    'src/Reader.js',
+    'src/Formatter.js',
+    'src/Loader.js'
+  ];
+  let files = fallbackFiles;
+  try {
+    const gulpfile = fs.readFileSync('/workspace/repo/gulpfile.js', 'utf8');
+    const concatSourceList = gulpfile.match(/gulp\.src\(\[([\s\S]*?)\]\)\s*\.pipe\(concat\('hprose-html5\.src\.js'\)\)/);
+    if (concatSourceList) {
+      const parsedFiles = [];
+      const sourceFilePattern = /['"](src\/[^'"]+\.js)['"]/g;
+      let match;
+      while ((match = sourceFilePattern.exec(concatSourceList[1])) !== null) {
+        parsedFiles.push(match[1]);
+      }
+      if (parsedFiles.length > 0) {
+
+        files = parsedFiles;
+      }
+    }
+  }
+  catch (error) {
+    files = fallbackFiles;
+  }
+  const source = files.map((file) => fs.readFileSync(`/workspace/repo/${file}`, 'utf8')).join('\n');
+  const moduleObject = { exports: {} };
+  return new Function('module', 'define', `${source}\nreturn module.exports;`)(moduleObject, undefined);
+}
+
+const hprose = loadHproseFromPublicSource();
+
+function rawToString(raw) {
+  return hprose.BytesIO.toString(raw);
+}
+
+function readRawObservation(reader, stream) {
+  const before = stream.position;
+  const raw = reader.readRaw();
+  return {
+    before,
+    after: stream.position,
+    text: rawToString(raw),
+    length: raw.length
+  };
+}
+
+function test(name, fn) {
+  try {
+    fn();
+    console.log(`ok - ${name}`);
+  }
+  catch (error) {
+    console.error(`not ok - ${name}`);
+    throw error;
+  }
+}
+
+test('RawReader returns exact raw bytes for one string value', () => {
+
+
+
+
+  const stream = new hprose.BytesIO('s5"Hello"');
+  const reader = new hprose.RawReader(stream);
+
+  assert.strictEqual(stream.position, 0);
+  assert.deepStrictEqual(readRawObservation(reader, stream), {
+    before: 0,
+    after: 9,
+    text: 's5"Hello"',
+    length: 9
+  });
+  assert.strictEqual(stream.position, 9);
+});
+
+test('RawReader advances through adjacent values one complete value at a time', () => {
+
+
+
+
+  const stream = new hprose.BytesIO('i123;s3"abc"');
+  const reader = new hprose.RawReader(stream);
+
+  assert.deepStrictEqual(readRawObservation(reader, stream), {
+    before: 0,
+    after: 5,
+    text: 'i123;',
+    length: 5
+  });
+  assert.deepStrictEqual(readRawObservation(reader, stream), {
+    before: 5,
+    after: 12,
+    text: 's3"abc"',
+    length: 7
+  });
+});
+
+test('RawReader includes the full nested list structure', () => {
+
+
+
+
+  const stream = new hprose.BytesIO('a2{12}');
+  const reader = new hprose.RawReader(stream);
+
+  assert.deepStrictEqual(readRawObservation(reader, stream), {
+    before: 0,
+    after: 6,
+    text: 'a2{12}',
+    length: 6
+  });
+});
+
+test('RawReader includes class definition bytes and the following object bytes', () => {
+
+
+
+
+  const stream = new hprose.BytesIO('c4"User"2{s4"name"s3"age"}o0{s3"Bob"i42;}');
+  const reader = new hprose.RawReader(stream);
+
+  assert.deepStrictEqual(readRawObservation(reader, stream), {
+    before: 0,
+    after: 41,
+    text: 'c4"User"2{s4"name"s3"age"}o0{s3"Bob"i42;}',
+    length: 41
+  });
+});
+
+test('RawReader preserves raw error payloads', () => {
+
+
+
+
+  const stream = new hprose.BytesIO('Es4"fail"');
+  const reader = new hprose.RawReader(stream);
+
+  assert.deepStrictEqual(readRawObservation(reader, stream), {
+    before: 0,
+    after: 9,
+    text: 'Es4"fail"',
+    length: 9
+  });
+});
+
+test('Reader exposes readRaw and uses its current stream position', () => {
+
+
+
+
+  const stream = new hprose.BytesIO('i123;s3"abc"');
+  const reader = new hprose.Reader(stream);
+
+  assert.strictEqual(typeof reader.readRaw, 'function');
+  assert.deepStrictEqual(readRawObservation(reader, stream), {
+    before: 0,
+    after: 5,
+    text: 'i123;',
+    length: 5
+  });
+  assert.deepStrictEqual(readRawObservation(reader, stream), {
+    before: 5,
+    after: 12,
+    text: 's3"abc"',
+    length: 7
+  });
+});
+
+test('Reader readRaw does not decode objects or update reference tables', () => {
+
+
+
+
+  function User() {
+    constructed += 1;
+    this.name = '';
+    this.age = 0;
+  }
+  let constructed = 0;
+  hprose.ClassManager.register(User, 'User');
+
+  const rawBytes = 'c4"User"2{s4"name"s3"age"}o0{s3"Bob"i42;}';
+  const trailingObjectBytes = 'o0{s3"Ada"i7;}';
+  const stream = new hprose.BytesIO(rawBytes + trailingObjectBytes);
+  const reader = new hprose.Reader(stream);
+
+  assert.strictEqual(constructed, 0);
+  assert.deepStrictEqual(readRawObservation(reader, stream), {
+    before: 0,
+    after: 41,
+    text: 'c4"User"2{s4"name"s3"age"}o0{s3"Bob"i42;}',
+    length: 41
+  });
+
+  assert.strictEqual(constructed, 0);
+
+  assert.throws(
+    () => reader.unserialize(),
+    (error) => error instanceof Error || error instanceof TypeError
+  );
+
+  assert.ok(stream.position >= 41);
+
+  const decodeStream = new hprose.BytesIO(rawBytes);
+  const decodingReader = new hprose.Reader(decodeStream);
+  const decoded = decodingReader.unserialize();
+  assert.strictEqual(decoded.constructor.name, 'User');
+  assert.strictEqual(decoded.name, 'Bob');
+  assert.strictEqual(decoded.age, 42);
+
+  assert.strictEqual(constructed, 1);
+  assert.strictEqual(decodeStream.position, 41);
+});
+
+test('readRaw rejects an invalid serialization tag with the Reader unexpected-tag Error', () => {
+
+
+
+
+  const rawStream = new hprose.BytesIO('x');
+  const rawReader = new hprose.RawReader(rawStream);
+  assert.throws(
+    () => rawReader.readRaw(),
+
+    (error) => error.constructor === Error &&
+               /unexpected/i.test(error.message) &&
+               /tag/i.test(error.message)
+  );
+
+  assert.ok(rawStream.position >= 0);
+
+  const readerStream = new hprose.BytesIO('x');
+  const reader = new hprose.Reader(readerStream);
+  assert.throws(
+    () => reader.readRaw(),
+
+    (error) => error.constructor === Error &&
+               /unexpected/i.test(error.message) &&
+               /tag/i.test(error.message)
+  );
+
+  assert.ok(readerStream.position >= 0);
+});
+
+test('independent RawReader instances advance only their own streams', () => {
+
+
+
+
+  const aStream = new hprose.BytesIO('i1;i2;');
+  const bStream = new hprose.BytesIO('s3"abc"');
+  const a = new hprose.RawReader(aStream);
+  const b = new hprose.RawReader(bStream);
+
+  assert.deepStrictEqual(readRawObservation(a, aStream), {
+    before: 0,
+    after: 3,
+    text: 'i1;',
+    length: 3
+  });
+  assert.deepStrictEqual(readRawObservation(b, bStream), {
+    before: 0,
+    after: 7,
+    text: 's3"abc"',
+    length: 7
+  });
+  assert.deepStrictEqual(readRawObservation(a, aStream), {
+    before: 3,
+    after: 6,
+    text: 'i2;',
+    length: 3
+  });
+  assert.strictEqual(bStream.position, 7);
+});
+
+test('construct-read-drop cycles remain independent', () => {
+
+
+
+
+  const observations = [];
+  for (let i = 0; i < 200; i += 1) {
+    const stream = new hprose.BytesIO('c4"User"2{s4"name"s3"age"}o0{s3"Bob"i42;}');
+    const reader = new hprose.RawReader(stream);
+    const raw = reader.readRaw();
+    assert.strictEqual(rawToString(raw), 'c4"User"2{s4"name"s3"age"}o0{s3"Bob"i42;}');
+    assert.strictEqual(stream.position, 41);
+    observations.push(stream.position);
+  }
+
+
+  assert.deepStrictEqual(observations, new Array(200).fill(41));
+});
