+func TestServerTransportCredentialsEmptySANs(t *testing.T) {
+	goodCert, err := core.LoadCert("../../test/grpc-creds/boulder-client/cert.pem")
+	test.AssertNotError(t, err, "core.LoadCert('../../grpc-creds/boulder-client/cert.pem') failed")
+	badCert, err := core.LoadCert("../../test/test-root.pem")
+	test.AssertNotError(t, err, "core.LoadCert('../../test-root.pem') failed")
+	servTLSConfig := &tls.Config{}
+
+
+
+	emptySANs := make(map[string]struct{})
+	bcreds := &serverTransportCredentials{servTLSConfig, emptySANs}
+
+
+
+
+	emptyState := tls.ConnectionState{}
+	err = bcreds.validateClient(emptyState)
+	test.AssertNotError(t, err, "validateClient() errored for emptyState with an empty (non-nil) acceptedSANs")
+
+
+
+
+	wrongState := tls.ConnectionState{
+		PeerCertificates: []*x509.Certificate{badCert},
+	}
+	err = bcreds.validateClient(wrongState)
+	test.AssertNotError(t, err, "validateClient(wrongState) errored with an empty (non-nil) acceptedSANs")
+
+
+
+
+	rightState := tls.ConnectionState{
+		PeerCertificates: []*x509.Certificate{goodCert},
+	}
+	err = bcreds.validateClient(rightState)
+	test.AssertNotError(t, err, "validateClient(rightState) errored with an empty (non-nil) acceptedSANs")
+
+
+	nilSANCreds := &serverTransportCredentials{servTLSConfig, nil}
+	err = nilSANCreds.validateClient(wrongState)
+	test.AssertNotError(t, err, "validateClient(wrongState) errored with nil acceptedSANs")
+
+
+
+	populatedSANs := map[string]struct{}{
+		"boulder-client": struct{}{},
+	}
+	populatedCreds := &serverTransportCredentials{servTLSConfig, populatedSANs}
+	err = populatedCreds.validateClient(wrongState)
+	test.AssertEquals(t, err, SANNotAcceptedErr)
+
+
+
+
+	err = populatedCreds.validateClient(emptyState)
+	test.AssertEquals(t, err, EmptyPeerCertsErr)
+
+
+
+	err = populatedCreds.validateClient(rightState)
+	test.AssertNotError(t, err, "validateClient(rightState) failed for populated acceptedSANs")
+}
