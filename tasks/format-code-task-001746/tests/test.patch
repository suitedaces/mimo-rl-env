new file mode 100644
index 000000000..3d71fc59d
--- /dev/null
+++ b/benchmark/pkg/metricsfetcher/runselector/schemes/last_n_hours_sparse_test.go
@@ -0,0 +1,88 @@
+package schemes
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	"k8s.io/perf-tests/benchmark/pkg/metricsfetcher/util"
+)
+
+func sparseTimedUtils(builds []int, timestamps map[int]uint64, finished ...int) util.MockJobLogUtils {
+	statuses := map[int]bool{}
+	for _, run := range finished {
+		statuses[run] = true
+	}
+	return util.MockJobLogUtils{
+		MockBuildNumbers:     builds,
+		MockStartTimestamps:  timestamps,
+		MockFinishedStatuses: statuses,
+	}
+}
+
+func TestGetJobRunsFromLastNHoursUsesSparseAvailableBuildNumbers(t *testing.T) {
+	now := uint64(time.Now().Unix())
+	utils := sparseTimedUtils(
+		[]int{4, 10, 25},
+		map[int]uint64{
+			25: now - 10*60,
+			10: now - 20*60,
+			4:  now - 3*60*60,
+		},
+		25, 10, 4)
+
+	runs, err := GetJobRunsFromLastNHours("sparse-job", 2, utils)
+	if err != nil {
+		t.Fatalf("GetJobRunsFromLastNHours returned error: %v", err)
+	}
+
+	want := []int{25, 10}
+	if !reflect.DeepEqual(runs, want) {
+		t.Fatalf("GetJobRunsFromLastNHours() = %v, want %v", runs, want)
+	}
+}
+
+func TestGetJobRunsFromLastNHoursDoesNotBackfillPastOlderAvailableBuild(t *testing.T) {
+	now := uint64(time.Now().Unix())
+	utils := sparseTimedUtils(
+		[]int{1, 50, 100},
+		map[int]uint64{
+			100: now - 5*60,
+			50:  now - 3*60*60,
+			1:   now - 10*60,
+		},
+		100, 50, 1)
+
+	runs, err := GetJobRunsFromLastNHours("sparse-job", 2, utils)
+	if err != nil {
+		t.Fatalf("GetJobRunsFromLastNHours returned error: %v", err)
+	}
+
+	want := []int{100}
+	if !reflect.DeepEqual(runs, want) {
+		t.Fatalf("GetJobRunsFromLastNHours() = %v, want %v", runs, want)
+	}
+}
+
+func TestGetJobRunsFromLastNHoursDoesNotUseLatestNumberFallback(t *testing.T) {
+	now := uint64(time.Now().Unix())
+	utils := sparseTimedUtils(
+		[]int{2, 70, 40, 60},
+		map[int]uint64{
+			70: now - 5*60,
+			60: now - 15*60,
+			40: now - 3*60*60,
+			2:  now - 10*60,
+		},
+		70, 60, 40, 2)
+
+	runs, err := GetJobRunsFromLastNHours("another-sparse-job", 2, utils)
+	if err != nil {
+		t.Fatalf("GetJobRunsFromLastNHours returned error: %v", err)
+	}
+
+	want := []int{70, 60}
+	if !reflect.DeepEqual(runs, want) {
+		t.Fatalf("GetJobRunsFromLastNHours() = %v, want %v", runs, want)
+	}
+}
