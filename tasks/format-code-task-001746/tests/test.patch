diff --git a/benchmark/pkg/metricsfetcher/util/build_numbers_test.go b/benchmark/pkg/metricsfetcher/util/build_numbers_test.go
new file mode 100644
index 000000000..3f7cb204f
--- /dev/null
+++ b/benchmark/pkg/metricsfetcher/util/build_numbers_test.go
@@ -0,0 +1,61 @@
+package util
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"sort"
+	"testing"
+
+	gcsutils "k8s.io/contrib/test-utils/utils"
+)
+
+type buildNumberProvider interface {
+	GetBuildNumbersForJob(string) ([]int, error)
+}
+
+var _ JobLogUtils = MockJobLogUtils{}
+var _ JobLogUtils = GCSLogUtils{}
+var _ buildNumberProvider = MockJobLogUtils{}
+var _ buildNumberProvider = GCSLogUtils{}
+
+func TestMockJobLogUtilsReturnsAvailableBuildNumbers(t *testing.T) {
+	utils := MockJobLogUtils{MockBuildNumbers: []int{8, 2, 13}}
+
+	got, err := utils.GetBuildNumbersForJob("sparse-job")
+	if err != nil {
+		t.Fatalf("GetBuildNumbersForJob returned error: %v", err)
+	}
+
+	want := []int{8, 2, 13}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("GetBuildNumbersForJob() = %v, want %v", got, want)
+	}
+}
+
+func TestGCSLogUtilsReturnsAvailableBuildNumbers(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.Write([]byte(`{"prefixes":["logs/sparse-job/101/","logs/sparse-job/77/","logs/sparse-job/9/"]}`))
+	}))
+	defer server.Close()
+
+	utils := GCSLogUtils{
+		googleGCSBucketUtils: gcsutils.NewTestUtils("test-bucket", "logs", server.URL),
+	}
+	got, err := utils.GetBuildNumbersForJob("sparse-job")
+	if err != nil {
+		t.Fatalf("GetBuildNumbersForJob returned error: %v", err)
+	}
+
+	want := []int{101, 77, 9}
+	if !reflect.DeepEqual(sortedInts(got), sortedInts(want)) {
+		t.Fatalf("GetBuildNumbersForJob() = %v, want %v", got, want)
+	}
+}
+
+func sortedInts(values []int) []int {
+	result := append([]int(nil), values...)
+	sort.Ints(result)
+	return result
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+
+
+
+
+rm -rf /root/gopath/src/k8s.io/perf-tests
+mkdir -p /root/gopath/src/k8s.io
+cp -a /testbed /root/gopath/src/k8s.io/perf-tests
+
+export GOPATH=/root/gopath
+export GO111MODULE=off
+
+
+case "${1:-}" in
+  base)
+    go test -v k8s.io/perf-tests/benchmark/pkg/metricsfetcher/runselector/schemes \
+      -run '^(TestGetLastNJobRuns|TestGetJobRunsFromLastNHours)$'
+    ;;
+  new)
+    go test -v k8s.io/perf-tests/benchmark/pkg/metricsfetcher/runselector/schemes \
+      -run '^(TestGetLastNJobRunsUsesSparseAvailableBuildNumbers|TestGetLastNJobRunsSkipsUnavailableAndUnfinishedSparseRuns|TestGetLastNJobRunsDoesNotUseLatestNumberFallback|TestGetJobRunsFromLastNHoursUsesSparseAvailableBuildNumbers|TestGetJobRunsFromLastNHoursDoesNotBackfillPastOlderAvailableBuild|TestGetJobRunsFromLastNHoursDoesNotUseLatestNumberFallback)$'
+    go test -v k8s.io/perf-tests/benchmark/pkg/metricsfetcher/util \
+      -run '^(TestMockJobLogUtilsReturnsAvailableBuildNumbers|TestGCSLogUtilsReturnsAvailableBuildNumbers)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
