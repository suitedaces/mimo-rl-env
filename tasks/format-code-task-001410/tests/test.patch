diff --git a/src/js/components/Heading/__tests__/Heading-test.tsx b/src/js/components/Heading/__tests__/Heading-test.tsx
index 5770d98a8..b218f0c86 100644
--- a/src/js/components/Heading/__tests__/Heading-test.tsx
+++ b/src/js/components/Heading/__tests__/Heading-test.tsx
@@ -254,3 +254,120 @@ test('Heading fill renders', () => {
 
   expect(container.firstChild).toMatchSnapshot();
 });
+
+test('Heading weight prop bold', () => {
+  const { getByRole } = render(
+    <Grommet>
+      <Heading level={1}>bold heading</Heading>
+    </Grommet>,
+  );
+
+  expect(getByRole('heading')).toHaveStyleRule('font-weight', '600');
+});
+
+test('Heading weight prop applies string bold', () => {
+  const { getByRole } = render(
+    <Grommet>
+      <Heading level={1} weight="bold">
+        bold heading
+      </Heading>
+    </Grommet>,
+  );
+  expect(getByRole('heading')).toHaveStyleRule('font-weight', 'bold');
+});
+
+test('Heading weight prop applies lighter', () => {
+  const { getByRole } = render(
+    <Grommet>
+      <Heading level={2} weight="lighter">
+        lighter heading
+      </Heading>
+    </Grommet>,
+  );
+  expect(getByRole('heading')).toHaveStyleRule('font-weight', 'lighter');
+});
+
+test('Heading weight prop applies numeric value', () => {
+  const { getByRole } = render(
+    <Grommet>
+      <Heading level={3} weight={500}>
+        numeric weight heading
+      </Heading>
+    </Grommet>,
+  );
+  expect(getByRole('heading')).toHaveStyleRule('font-weight', '500');
+});
+
+test('Heading weight prop overrides theme.heading.weight', () => {
+  const customTheme = {
+    heading: {
+      weight: 700,
+    },
+  };
+  const { getByRole } = render(
+    <Grommet theme={customTheme}>
+      <Heading level={4} weight={300}>
+        override theme weight
+      </Heading>
+    </Grommet>,
+  );
+  expect(getByRole('heading')).toHaveStyleRule('font-weight', '300');
+});
+
+test('Heading weight prop overrides level-specific theme weight', () => {
+  const customTheme = {
+    heading: {
+      weight: 600,
+      level: {
+        1: {
+          font: {
+            weight: '700',
+          },
+        },
+      },
+    },
+  };
+  const { getByRole } = render(
+    <Grommet theme={customTheme}>
+      <Heading level={1} weight={200}>
+        override level weight
+      </Heading>
+    </Grommet>,
+  );
+  expect(getByRole('heading')).toHaveStyleRule('font-weight', '200');
+});
+
+test('Heading without weight prop falls back to theme weight', () => {
+  const customTheme = {
+    heading: {
+      weight: 800,
+    },
+  };
+  const { getByRole } = render(
+    <Grommet theme={customTheme}>
+      <Heading level={4}>default theme weight</Heading>
+    </Grommet>,
+  );
+  expect(getByRole('heading')).toHaveStyleRule('font-weight', '800');
+});
+
+test('Heading without weight prop uses level-specific weight if defined', () => {
+  const customTheme = {
+    heading: {
+      weight: 600,
+      level: {
+        2: {
+          font: {
+            weight: '400',
+          },
+        },
+      },
+    },
+  };
+  const { getByRole } = render(
+    <Grommet theme={customTheme}>
+      <Heading level={2}>level weight</Heading>
+    </Grommet>,
+  );
+  expect(getByRole('heading')).toHaveStyleRule('font-weight', '400');
+});
