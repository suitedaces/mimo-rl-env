+++ b/test/unit-tests/relativeSelectorDesc.test.js
@@ -0,0 +1,121 @@
+const expect = require('chai').expect;
+const rewire = require('rewire');
+
+describe('relative selector descriptions (issue: should not be capitalized)', () => {
+  let taiko;
+
+  before(() => {
+    taiko = rewire('../../lib/taiko');
+
+
+    taiko.__set__('validate', () => {});
+  });
+
+  describe('below()', () => {
+    it('returns a description starting with lowercase "below" for string selectors', () => {
+      const rel = taiko.below('Postcode');
+      expect(rel.desc).to.equal('below Postcode');
+    });
+
+    it('does not start description with capitalized "Below"', () => {
+      const rel = taiko.below('Postcode');
+      expect(rel.desc).to.not.equal('Below Postcode');
+      expect(rel.desc.startsWith('Below')).to.be.false;
+    });
+
+    it('returns a description starting with lowercase "below" for object selectors with description', () => {
+      const rel = taiko.below({ description: 'Postcode' });
+      expect(rel.desc).to.equal('below Postcode');
+    });
+  });
+
+  describe('above()', () => {
+    it('returns a description starting with lowercase "above" for string selectors', () => {
+      const rel = taiko.above('Header');
+      expect(rel.desc).to.equal('above Header');
+    });
+
+    it('does not start description with capitalized "Above"', () => {
+      const rel = taiko.above('Header');
+      expect(rel.desc.startsWith('Above')).to.be.false;
+    });
+
+    it('returns a description starting with lowercase "above" for object selectors with description', () => {
+      const rel = taiko.above({ description: 'Header' });
+      expect(rel.desc).to.equal('above Header');
+    });
+  });
+
+  describe('toLeftOf()', () => {
+    it('returns a description starting with lowercase "to left of" for string selectors', () => {
+      const rel = taiko.toLeftOf('Submit');
+      expect(rel.desc).to.equal('to left of Submit');
+    });
+
+    it('does not start description with capitalized "To left of"', () => {
+      const rel = taiko.toLeftOf('Submit');
+      expect(rel.desc.startsWith('To left of')).to.be.false;
+    });
+
+    it('returns a description starting with lowercase "to left of" for object selectors with description', () => {
+      const rel = taiko.toLeftOf({ description: 'Submit' });
+      expect(rel.desc).to.equal('to left of Submit');
+    });
+  });
+
+  describe('toRightOf()', () => {
+    it('returns a description starting with lowercase "to right of" for string selectors', () => {
+      const rel = taiko.toRightOf('Name');
+      expect(rel.desc).to.equal('to right of Name');
+    });
+
+    it('does not start description with capitalized "To right of"', () => {
+      const rel = taiko.toRightOf('Name');
+      expect(rel.desc.startsWith('To right of')).to.be.false;
+    });
+
+    it('returns a description starting with lowercase "to right of" for object selectors with description', () => {
+      const rel = taiko.toRightOf({ description: 'Name' });
+      expect(rel.desc).to.equal('to right of Name');
+    });
+  });
+
+  describe('near()', () => {
+    it('returns a description starting with lowercase "near" for string selectors', () => {
+      const rel = taiko.near('Logo');
+      expect(rel.desc).to.equal('near Logo');
+    });
+
+    it('does not start description with capitalized "Near"', () => {
+      const rel = taiko.near('Logo');
+      expect(rel.desc.startsWith('Near')).to.be.false;
+    });
+
+    it('returns a description starting with lowercase "near" for object selectors with description', () => {
+      const rel = taiko.near({ description: 'Logo' });
+      expect(rel.desc).to.equal('near Logo');
+    });
+  });
+
+  describe('toString() reflects the lowercase description', () => {
+    it('below(...).toString() begins with lowercase "below"', () => {
+      expect(taiko.below('Postcode').toString()).to.equal('below Postcode');
+    });
+
+    it('above(...).toString() begins with lowercase "above"', () => {
+      expect(taiko.above('Header').toString()).to.equal('above Header');
+    });
+
+    it('toLeftOf(...).toString() begins with lowercase "to left of"', () => {
+      expect(taiko.toLeftOf('Submit').toString()).to.equal('to left of Submit');
+    });
+
+    it('toRightOf(...).toString() begins with lowercase "to right of"', () => {
+      expect(taiko.toRightOf('Name').toString()).to.equal('to right of Name');
+    });
+
+    it('near(...).toString() begins with lowercase "near"', () => {
+      expect(taiko.near('Logo').toString()).to.equal('near Logo');
+    });
+  });
+});
