+@requires_h5py
+@requires_pandas
+def test_io_epochstfr_metadata_roundtrip():
+    """Test that EpochsTFR.save preserves metadata, events and event_id."""
+    from pandas import DataFrame
+    tempdir = _TempDir()
+    fname = op.join(tempdir, 'test-tfr.h5')
+    info = create_info(['MEG 001', 'MEG 002', 'MEG 003'], 1000.,
+                       ['mag', 'mag', 'mag'])
+    data = np.zeros((5, 3, 2, 3))
+    times = np.array([.1, .2, .3])
+    freqs = np.array([.10, .20])
+
+
+
+    meta = DataFrame(dict(RT=np.array([0.11, 0.22, 0.33, 0.44, 0.55]),
+                          Trial=['face', 'place', 'face', 'place', 'face']))
+    events = np.array([[10, 0, 1],
+                       [20, 0, 2],
+                       [30, 0, 1],
+                       [40, 0, 2],
+                       [50, 0, 1]])
+    event_id = {'face': 1, 'place': 2}
+
+    tfr = EpochsTFR(info, data=data, times=times, freqs=freqs,
+                    comment='test', method='crazy-tfr',
+                    events=events, event_id=event_id, metadata=meta)
+    tfr.save(fname, True)
+    read_tfr = read_tfrs(fname)[0]
+
+
+    assert_array_equal(tfr.data, read_tfr.data)
+
+    assert read_tfr.events is not None
+    assert_array_equal(read_tfr.events, events)
+
+    assert read_tfr.event_id == event_id
+
+    assert read_tfr.metadata is not None
+    assert_metadata_equal(read_tfr.metadata, meta)
+
+
+@requires_h5py
+@requires_pandas
+def test_io_epochstfr_metadata_none_roundtrip():
+    """EpochsTFR with metadata=None should round-trip with metadata None."""
+    tempdir = _TempDir()
+    fname = op.join(tempdir, 'test-tfr.h5')
+    info = create_info(['MEG 001', 'MEG 002', 'MEG 003'], 1000.,
+                       ['mag', 'mag', 'mag'])
+    data = np.zeros((4, 3, 2, 3))
+    times = np.array([.1, .2, .3])
+    freqs = np.array([.10, .20])
+
+    events = np.array([[5, 0, 7],
+                       [15, 0, 7],
+                       [25, 0, 8],
+                       [35, 0, 8]])
+    event_id = {'seven': 7, 'eight': 8}
+
+    tfr = EpochsTFR(info, data=data, times=times, freqs=freqs,
+                    events=events, event_id=event_id, metadata=None)
+    tfr.save(fname, True)
+    read_tfr = read_tfrs(fname)[0]
+
+    assert read_tfr.metadata is None
+    assert_array_equal(read_tfr.events, events)
+    assert read_tfr.event_id == event_id
+
+
