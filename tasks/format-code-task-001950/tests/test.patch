+@requires_testing_data
+def test_io_egi_mff_crop_then_load_data():
+    """Test that lazy MFF read + crop + load_data does not crash and is correct.
+
+    Regression test for issue where reading raw MFF without preload,
+    then cropping, then calling load_data() (or any access that triggers
+    _read_segment_file across block boundaries) raised IndexError.
+    """
+    egi_fname_mff = op.join(data_path(), 'EGI', 'test_egi.mff')
+
+
+    raw_full = read_raw_egi(egi_fname_mff, include=None, preload=True,
+                            verbose='error')
+    raw_full.crop(tmin=2.5)
+
+
+    raw_lazy = read_raw_egi(egi_fname_mff, include=None, preload=False,
+                            verbose='error')
+    raw_lazy.crop(tmin=2.5)
+    raw_lazy.load_data()
+
+
+
+
+    assert_allclose(raw_lazy._data, raw_full._data)
+
+
+@requires_testing_data
+def test_io_egi_mff_crop_then_find_events():
+    """Test that find_events works correctly after lazy MFF read + crop.
+
+    Exact reproduction of the issue snippet.
+    """
+    egi_fname_mff = op.join(data_path(), 'EGI', 'test_egi.mff')
+
+
+    raw_full = read_raw_egi(egi_fname_mff, include=None, preload=True,
+                            verbose='error')
+    raw_full.crop(tmin=2.5)
+    events_full = find_events(raw_full, stim_channel='STI 014')
+
+
+    raw_lazy = read_raw_egi(egi_fname_mff, include=None, preload=False,
+                            verbose='error')
+    raw_lazy.crop(tmin=2.5)
+    events_lazy = find_events(raw_lazy, stim_channel='STI 014')
+
+    assert_array_equal(events_lazy, events_full)
+
+
+@requires_testing_data
+def test_io_egi_mff_crop_event_channel_correct():
+    """After crop on lazy MFF, event channel data must reflect cropped range.
+
+    Catches a bug where events were indexed from absolute zero rather than
+    from the crop start, producing event channel values from the wrong time.
+    """
+    egi_fname_mff = op.join(data_path(), 'EGI', 'test_egi.mff')
+
+    raw_full = read_raw_egi(egi_fname_mff, include=None, preload=True,
+                            verbose='error')
+    raw_full.crop(tmin=2.5)
+
+    raw_lazy = read_raw_egi(egi_fname_mff, include=None, preload=False,
+                            verbose='error')
+    raw_lazy.crop(tmin=2.5)
+
+
+
+    sti_idx = raw_lazy.ch_names.index('STI 014')
+    data_lazy, _ = raw_lazy[sti_idx, :]
+    data_full, _ = raw_full[sti_idx, :]
+    assert_array_equal(data_lazy, data_full)
+
+
+    n_eeg = sum(1 for n in raw_lazy.ch_names if n.startswith('E'))
+    data_lazy_ev, _ = raw_lazy[n_eeg:, :]
+    data_full_ev, _ = raw_full[n_eeg:, :]
+    assert_array_equal(data_lazy_ev, data_full_ev)
+
+
+@requires_testing_data
+def test_io_egi_mff_crop_eeg_data_correct():
+    """After crop on lazy MFF, EEG data must match preloaded+cropped EEG data.
+
+    Catches a regression in the offset_samples handling in the EEG read path
+    where samples in blocks after the first were incorrectly skipped.
+    """
+    egi_fname_mff = op.join(data_path(), 'EGI', 'test_egi.mff')
+
+    raw_full = read_raw_egi(egi_fname_mff, include=None, preload=True,
+                            verbose='error')
+    raw_full.crop(tmin=2.5)
+
+    raw_lazy = read_raw_egi(egi_fname_mff, include=None, preload=False,
+                            verbose='error')
+    raw_lazy.crop(tmin=2.5)
+
+    eeg_picks = pick_types(raw_lazy.info, eeg=True)
+    data_lazy, _ = raw_lazy[eeg_picks, :]
+    data_full, _ = raw_full[eeg_picks, :]
+    assert_allclose(data_lazy, data_full)
+
+
