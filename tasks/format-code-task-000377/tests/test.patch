@@ -0,0 +1,375 @@
+
+
+
+
+import re
+import sys
+import types
+
+import numpy as np
+import pytest
+from PIL import Image
+from PIL import ImageColor
+
+
+def _install_query_integral_image_fallback():
+
+    module_name = "wordcloud.query_integral_image"
+    if module_name in sys.modules:
+        return
+
+    fallback = types.ModuleType(module_name)
+
+    def query_integral_image(integral_image, size_x, size_y, random_state):
+        x, y = integral_image.shape
+        hits = 0
+        for i in range(max(0, x - size_x)):
+            for j in range(max(0, y - size_y)):
+                area = int(integral_image[i, j])
+                area += int(integral_image[i + size_x, j + size_y])
+                area -= int(integral_image[i + size_x, j])
+                area -= int(integral_image[i, j + size_y])
+                if not area:
+                    hits += 1
+        if not hits:
+            return None
+
+        goal = random_state.randint(0, hits)
+        if goal == 0:
+            return None
+        hits = 0
+        for i in range(max(0, x - size_x)):
+            for j in range(max(0, y - size_y)):
+                area = int(integral_image[i, j])
+                area += int(integral_image[i + size_x, j + size_y])
+                area -= int(integral_image[i + size_x, j])
+                area -= int(integral_image[i, j + size_y])
+                if not area:
+                    hits += 1
+                    if hits == goal:
+                        return i, j
+        return None
+
+    fallback.query_integral_image = query_integral_image
+
+    sys.modules[module_name] = fallback
+
+
+_install_query_integral_image_fallback()
+
+from wordcloud import WordCloud  # noqa: E402
+
+
+TEXT = "alpha beta beta gamma gamma gamma"
+BASE_OPTIONS = {
+    "random_state": 0,
+    "width": 220,
+    "height": 120,
+    "max_words": 3,
+    "collocations": False,
+    "background_color": "white",
+}
+
+
+def _layout_public(wc):
+    return [
+        (
+            (word, freq),
+            int(font_size),
+            (int(position[0]), int(position[1])),
+            orientation,
+            color,
+        )
+        for (word, freq), font_size, position, orientation, color in wc.layout_
+    ]
+
+
+def _layout_shape_by_word(wc):
+    return {
+        word: (freq, int(font_size), (int(position[0]), int(position[1])), orientation)
+        for (word, freq), font_size, position, orientation, _ in wc.layout_
+    }
+
+
+def _layout_colors_by_word(wc):
+    return {word: color for (word, _), _, _, _, color in wc.layout_}
+
+
+def _rgb_tuple(color):
+    if isinstance(color, str):
+        return ImageColor.getrgb(color)[:3]
+    return tuple(int(channel) for channel in color[:3])
+
+
+def _svg_word_fills(wc):
+    return re.findall(
+        r'<text[^>]+style="fill:([^"]+)"[^>]*>([^<]+)</text>',
+        wc.to_svg(),
+    )
+
+
+def _assert_layout_shape_preserved(before_shape, wc):
+
+    assert _layout_shape_by_word(wc) == before_shape
+
+
+def _assert_all_layout_colors(wc, expected_color):
+
+    assert set(_layout_colors_by_word(wc).values()) == {expected_color}
+
+
+def _assert_array_uses_red_words(array):
+    assert array.shape == (BASE_OPTIONS["height"], BASE_OPTIONS["width"], 3)
+    non_background = np.any(array != np.array([255, 255, 255]), axis=2)
+
+    assert np.any(non_background)
+    assert np.all(array[:, :, 0][non_background] == 255)
+    assert np.all(array[:, :, 1][non_background] == array[:, :, 2][non_background])
+    assert np.all(array[:, :, 1][non_background] < 255)
+
+
+def _assert_svg_fills(wc, expected_by_word):
+    fills = _svg_word_fills(wc)
+
+    assert {word: fill for fill, word in fills} == expected_by_word
+
+
+def _assert_colors_from_colormap(colors, colormap_name):
+    import matplotlib.pyplot as plt
+
+    cmap = plt.get_cmap(colormap_name)
+    samples = np.array([np.array(cmap(i / 1023.0)[:3]) * 255 for i in range(1024)])
+    for color in colors:
+        rgb = np.array(_rgb_tuple(color), dtype=float)
+
+        assert np.min(np.abs(samples - rgb).sum(axis=1)) <= 6
+
+
+def test_recolor_with_custom_color_func_preserves_layout_and_updates_outputs(tmp_path):
+
+
+
+
+    wc = WordCloud(**BASE_OPTIONS)
+    generated = wc.generate(TEXT)
+    assert generated is wc
+    assert len(wc.layout_) == 3
+    before_words = dict(wc.words_)
+    before_shape = _layout_shape_by_word(wc)
+
+    calls = []
+
+    def red(**kwargs):
+        calls.append(
+            {
+                "word": kwargs["word"],
+                "font_size": int(kwargs["font_size"]),
+                "position": (int(kwargs["position"][0]), int(kwargs["position"][1])),
+                "orientation": kwargs["orientation"],
+                "font_path": kwargs["font_path"],
+                "has_random_state": "random_state" in kwargs,
+            }
+        )
+        return "rgb(255, 0, 0)"
+
+    same = wc.recolor(color_func=red)
+    assert same is wc
+
+    assert len(calls) == len(before_shape)
+    assert {call["word"] for call in calls} == set(before_shape)
+    for call in calls:
+        freq, font_size, position, orientation = before_shape[call["word"]]
+        assert freq > 0
+        assert call["font_size"] == font_size
+        assert call["position"] == position
+        assert call["orientation"] == orientation
+        assert call["font_path"] == wc.font_path
+        assert call["has_random_state"]
+    assert dict(wc.words_) == before_words
+    _assert_layout_shape_preserved(before_shape, wc)
+    _assert_all_layout_colors(wc, "rgb(255, 0, 0)")
+
+    image = wc.to_image()
+    assert image.size == (BASE_OPTIONS["width"], BASE_OPTIONS["height"])
+    _assert_array_uses_red_words(np.asarray(image.convert("RGB")))
+
+    array = wc.to_array()
+    _assert_array_uses_red_words(array)
+    _assert_svg_fills(
+        wc,
+        {word: "rgb(255, 0, 0)" for word in before_shape},
+    )
+
+    out_path = tmp_path / "red-cloud.png"
+    file_result = wc.to_file(str(out_path))
+    assert file_result is wc
+    file_array = np.asarray(Image.open(out_path).convert("RGB"))
+    _assert_array_uses_red_words(file_array)
+
+
+def test_recolor_without_color_func_uses_current_instance_color_func():
+
+
+
+
+    recolor_calls = []
+    expected_colors = {
+        "gamma": "rgb(11, 21, 31)",
+        "beta": "rgb(41, 51, 61)",
+        "alpha": "rgb(71, 81, 91)",
+    }
+
+    def phase_color(*args, **kwargs):
+        if args:
+            return "rgb(0, 0, 255)"
+        recolor_calls.append(kwargs["word"])
+        return expected_colors[kwargs["word"]]
+
+    wc = WordCloud(**BASE_OPTIONS, color_func=phase_color).generate(TEXT)
+    before_shape = _layout_shape_by_word(wc)
+    assert set(_layout_colors_by_word(wc).values()) == {"rgb(0, 0, 255)"}
+
+    same = wc.recolor()
+    assert same is wc
+
+    assert set(recolor_calls) == set(before_shape)
+    assert len(recolor_calls) == len(before_shape)
+    _assert_layout_shape_preserved(before_shape, wc)
+    assert _layout_colors_by_word(wc) == {
+        word: expected_colors[word] for word in before_shape
+    }
+    _assert_svg_fills(wc, {word: expected_colors[word] for word in before_shape})
+
+
+def test_recolor_with_colormap_draws_replacement_colors_from_that_colormap():
+
+
+
+
+    wc = WordCloud(**BASE_OPTIONS).generate(TEXT)
+    before_shape = _layout_shape_by_word(wc)
+    before_colors = _layout_colors_by_word(wc)
+
+    same = wc.recolor(random_state=10, colormap="plasma")
+    assert same is wc
+    _assert_layout_shape_preserved(before_shape, wc)
+    after_colors = _layout_colors_by_word(wc)
+
+    assert after_colors != before_colors
+    _assert_colors_from_colormap(after_colors.values(), "plasma")
+    _assert_svg_fills(wc, after_colors)
+
+
+def test_integer_random_state_is_passed_to_color_func_as_seeded_random():
+
+
+
+
+    calls = []
+
+    def seeded_color(**kwargs):
+        random_state = kwargs["random_state"]
+        draw = random_state.random()
+        calls.append(
+            {
+                "word": kwargs["word"],
+                "font_size": int(kwargs["font_size"]),
+                "position": (int(kwargs["position"][0]), int(kwargs["position"][1])),
+                "orientation": kwargs["orientation"],
+                "font_path": kwargs["font_path"],
+                "random_draw": draw,
+            }
+        )
+        channel = int(draw * 200) + 1
+        return "rgb({}, 2, 3)".format(channel)
+
+    wc = WordCloud(**BASE_OPTIONS).generate(TEXT)
+    before_shape = _layout_shape_by_word(wc)
+    same = wc.recolor(random_state=10, color_func=seeded_color)
+    assert same is wc
+
+    assert len(calls) == len(before_shape)
+    assert {call["word"] for call in calls} == set(before_shape)
+    assert all(0 <= call["random_draw"] < 1 for call in calls)
+    for call in calls:
+        _, font_size, position, orientation = before_shape[call["word"]]
+        assert call["font_size"] == font_size
+        assert call["position"] == position
+        assert call["orientation"] == orientation
+        assert call["font_path"] == wc.font_path
+    _assert_layout_shape_preserved(before_shape, wc)
+
+
+def test_same_integer_random_state_recolor_is_repeatable_on_same_layout():
+
+
+
+
+    wc = WordCloud(**BASE_OPTIONS).generate(TEXT)
+    before_shape = _layout_shape_by_word(wc)
+    first_same = wc.recolor(random_state=10)
+    first_shape = _layout_shape_by_word(wc)
+    first_colors = _layout_colors_by_word(wc)
+    first_array = wc.to_array()
+    second_same = wc.recolor(random_state=10)
+    second_shape = _layout_shape_by_word(wc)
+    second_colors = _layout_colors_by_word(wc)
+    second_array = wc.to_array()
+
+    assert first_same is wc
+    assert second_same is wc
+
+    assert first_shape == before_shape
+    assert second_shape == before_shape
+    assert first_colors == second_colors
+    assert np.array_equal(first_array, second_array)
+
+
+def test_recolor_before_generate_raises_value_error():
+
+
+
+
+
+    with pytest.raises(ValueError):
+        WordCloud().recolor()
+
+
+def test_recolor_state_is_independent_between_instances():
+
+
+
+
+    red = lambda *args, **kwargs: "rgb(255, 0, 0)"
+    blue = lambda *args, **kwargs: "rgb(0, 0, 255)"
+
+    a = WordCloud(**BASE_OPTIONS, color_func=blue).generate(TEXT)
+    b = WordCloud(**BASE_OPTIONS, color_func=blue).generate(TEXT)
+    a_before_shape = _layout_shape_by_word(a)
+    b_before_layout = _layout_public(b)
+    a_result = a.recolor(color_func=red)
+
+    assert a_result is a
+    _assert_layout_shape_preserved(a_before_shape, a)
+    _assert_all_layout_colors(a, "rgb(255, 0, 0)")
+
+    assert _layout_public(b) == b_before_layout
+    assert set(_layout_colors_by_word(b).values()) == {"rgb(0, 0, 255)"}
+
+
+def test_repeated_recolor_sessions_preserve_layout_size_and_remain_renderable():
+
+
+
+
+    red = lambda *args, **kwargs: "rgb(255, 0, 0)"
+
+
+    for _ in range(8):
+        wc = WordCloud(**BASE_OPTIONS).generate(TEXT)
+        before_shape = _layout_shape_by_word(wc)
+        same = wc.recolor(color_func=red)
+        assert same is wc
+        _assert_layout_shape_preserved(before_shape, wc)
+        _assert_all_layout_colors(wc, "rgb(255, 0, 0)")
+        _assert_array_uses_red_words(wc.to_array())
