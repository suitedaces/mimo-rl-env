     hash_matches,
     temporary_file,
     unique_file_name,
@@ -266,6 +267,107 @@ def test_hash_matches_none():
     assert hash_matches(fname, known_hash=None, strict=True)
 
 
+TINY_DATA_HASH = "baee0894dba14b12085eacb204284b97e362f4f3e5a5807693cc90ef415c1b2d"
+
+
+def test_hash_matches_uppercase_known_hash():
+    "PowerShell Get-FileHash produces uppercase; should still match (no re-download)"
+    fname = os.path.join(DATA_DIR, "tiny-data.txt")
+    check_tiny_data(fname)
+    upper_hash = TINY_DATA_HASH.upper()
+    assert upper_hash != TINY_DATA_HASH
+    assert hash_matches(fname, upper_hash)
+
+
+def test_hash_matches_uppercase_known_hash_strict():
+    "Strict mode should not raise when uppercase hash matches"
+    fname = os.path.join(DATA_DIR, "tiny-data.txt")
+    check_tiny_data(fname)
+    upper_hash = TINY_DATA_HASH.upper()
+    assert hash_matches(fname, upper_hash, strict=True)
+
+
+def test_hash_matches_uppercase_with_algorithm_prefix():
+    "Uppercase algorithm prefix + uppercase hash should match"
+    fname = os.path.join(DATA_DIR, "tiny-data.txt")
+    check_tiny_data(fname)
+    known = "SHA256:" + TINY_DATA_HASH.upper()
+    assert hash_matches(fname, known)
+    assert hash_matches(fname, known, strict=True)
+
+
+def test_hash_matches_mixed_case_hash():
+    "Mixed case hashes (some caps, some not) should match"
+    fname = os.path.join(DATA_DIR, "tiny-data.txt")
+    check_tiny_data(fname)
+    mixed = TINY_DATA_HASH[:20].upper() + TINY_DATA_HASH[20:]
+    assert mixed != TINY_DATA_HASH
+    assert mixed != TINY_DATA_HASH.upper()
+    assert hash_matches(fname, mixed)
+
+
+def test_hash_matches_lowercase_preserved():
+    "Preservation: lowercase hashes (original behavior) still work"
+    fname = os.path.join(DATA_DIR, "tiny-data.txt")
+    check_tiny_data(fname)
+    assert hash_matches(fname, TINY_DATA_HASH)
+    assert hash_matches(fname, "sha256:" + TINY_DATA_HASH)
+    assert hash_matches(fname, TINY_DATA_HASH, strict=True)
+
+
+def test_hash_matches_uppercase_wrong_hash_still_fails():
+    "An uppercase but actually wrong hash should still NOT match"
+    fname = os.path.join(DATA_DIR, "tiny-data.txt")
+    check_tiny_data(fname)
+    bad_hash = ("0" * 64).upper()
+    assert not hash_matches(fname, bad_hash)
+    with pytest.raises(ValueError):
+        hash_matches(fname, bad_hash, strict=True)
+
+
+def test_hash_algorithm_uppercase_prefix():
+    "hash_algorithm should return lowercase algorithm name for uppercase prefix"
+    assert hash_algorithm("SHA256:abc123") == "sha256"
+    assert hash_algorithm("MD5:abc123") == "md5"
+    assert hash_algorithm("SHA512:abc123") == "sha512"
+
+
+def test_hash_algorithm_mixed_case_prefix():
+    "hash_algorithm should return lowercase even for mixed case prefix"
+    assert hash_algorithm("Sha256:abc123") == "sha256"
+    assert hash_algorithm("Md5:abc123") == "md5"
+
+
+def test_hash_algorithm_lowercase_preserved():
+    "Preservation: existing lowercase behavior unchanged"
+    assert hash_algorithm("sha256:abc") == "sha256"
+    assert hash_algorithm("md5:abc") == "md5"
+    assert hash_algorithm("abc") == "sha256"
+    assert hash_algorithm(None) == "sha256"
+
+
+def test_pooch_load_registry_uppercase_hash():
+    "Loading a registry with PowerShell-style uppercase hash should match the file"
+    pup = Pooch(path=DATA_DIR, base_url="")
+    tiny_hash_lower = (
+        "baee0894dba14b12085eacb204284b97e362f4f3e5a5807693cc90ef415c1b2d"
+    )
+    content = f"tiny-data.txt {tiny_hash_lower.upper()}\n"
+    tmp = NamedTemporaryFile(mode="w", delete=False, suffix=".txt")
+    try:
+        tmp.write(content)
+        tmp.close()
+        pup.load_registry(tmp.name)
+
+
+        stored_hash = pup.registry["tiny-data.txt"]
+        fname = os.path.join(DATA_DIR, "tiny-data.txt")
+        assert hash_matches(fname, stored_hash)
+        assert hash_matches(fname, stored_hash, strict=True)
+    finally:
+        os.remove(tmp.name)
+
+
