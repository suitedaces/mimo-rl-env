diff --git a/usercase-test-coderl/test_linked_worktree_repo.py b/usercase-test-coderl/test_linked_worktree_repo.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_linked_worktree_repo.py
@@ -0,0 +1,214 @@
+
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+from pathlib import Path
+from typing import Optional, Union
+
+import pytest
+
+from git import InvalidGitRepositoryError, Repo
+from git.repo.fun import find_worktree_git_dir
+
+
+FIXTURE_ROOT = "/workspace/repo/usercase-test-coderl/fixtures/linked_worktree_state"
+MAIN_REPO = "/workspace/repo/usercase-test-coderl/fixtures/linked_worktree_state/main"
+ABS_WORKTREE = "/workspace/repo/usercase-test-coderl/fixtures/linked_worktree_state/linked_abs"
+REL_WORKTREE = "/workspace/repo/usercase-test-coderl/fixtures/linked_worktree_state/linked_rel"
+ENV_WORKTREE = "/workspace/repo/usercase-test-coderl/fixtures/linked_worktree_state/env_worktree_override"
+ABS_GIT_DIR = "/workspace/repo/usercase-test-coderl/fixtures/linked_worktree_state/main/.git/worktrees/linked_abs"
+REL_GIT_DIR = "/workspace/repo/usercase-test-coderl/fixtures/linked_worktree_state/main/.git/worktrees/linked_rel"
+INITIAL_COMMIT = "be0390947541c84c41af034449d92c1b9c5e2cbe"
+Pathish = Union[str, os.PathLike[str]]
+
+
+def _run_git(*args: str, cwd: Optional[str] = None) -> None:
+    env = os.environ.copy()
+    env.update(
+        {
+            "GIT_AUTHOR_NAME": "Acceptance Test",
+            "GIT_AUTHOR_EMAIL": "acceptance@example.invalid",
+            "GIT_COMMITTER_NAME": "Acceptance Test",
+            "GIT_COMMITTER_EMAIL": "acceptance@example.invalid",
+            "GIT_AUTHOR_DATE": "2001-02-03T04:05:06+0000",
+            "GIT_COMMITTER_DATE": "2001-02-03T04:05:06+0000",
+        }
+    )
+    subprocess.run(["git", *args], cwd=cwd, env=env, check=True, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+def _assert_same_path(actual: Pathish, expected: Pathish) -> None:
+    assert os.path.normcase(os.path.abspath(os.fspath(actual))) == os.path.normcase(
+        os.path.abspath(os.fspath(expected))
+    )
+
+
+def _assert_repo_locations(repo: Repo, git_dir: Pathish, worktree: Pathish) -> None:
+
+    _assert_same_path(repo.git_dir, git_dir)
+    _assert_same_path(repo.working_tree_dir, worktree)
+
+    _assert_same_path(repo.working_dir, worktree)
+
+
+def _reset_fixture_repo() -> None:
+    root = Path(FIXTURE_ROOT)
+    if root.exists():
+        shutil.rmtree(root)
+    root.mkdir(parents=True)
+
+    _run_git("init", MAIN_REPO)
+    _run_git("config", "user.email", "acceptance@example.invalid", cwd=MAIN_REPO)
+    _run_git("config", "user.name", "Acceptance Test", cwd=MAIN_REPO)
+    Path(MAIN_REPO, "tracked.txt").write_text("root\n")
+    _run_git("add", "tracked.txt", cwd=MAIN_REPO)
+    _run_git("commit", "-m", "initial", cwd=MAIN_REPO)
+    _run_git("branch", "abs_branch", cwd=MAIN_REPO)
+    _run_git("branch", "rel_branch", cwd=MAIN_REPO)
+    _run_git("worktree", "add", ABS_WORKTREE, "abs_branch", cwd=MAIN_REPO)
+    _run_git("worktree", "add", REL_WORKTREE, "rel_branch", cwd=MAIN_REPO)
+
+    relative_gitdir = os.path.relpath(REL_GIT_DIR, REL_WORKTREE)
+    Path(REL_WORKTREE, ".git").write_text(f"gitdir: {relative_gitdir}\n")
+    Path(ENV_WORKTREE).mkdir()
+
+
+@pytest.fixture()
+def linked_worktrees() -> None:
+    _reset_fixture_repo()
+    yield
+    shutil.rmtree(FIXTURE_ROOT, ignore_errors=True)
+
+
+def test_repo_path_opens_absolute_linked_worktree_and_exposes_state(linked_worktrees: None) -> None:
+
+
+
+    repo = Repo(ABS_WORKTREE)
+    _assert_repo_locations(repo, ABS_GIT_DIR, ABS_WORKTREE)
+
+    assert repo.bare is False
+    assert repo.head.commit.hexsha == "be0390947541c84c41af034449d92c1b9c5e2cbe"
+    repo.close()
+
+
+def test_repo_path_resolves_relative_linked_worktree_gitdir(linked_worktrees: None) -> None:
+
+
+
+    repo = Repo(REL_WORKTREE)
+    assert find_worktree_git_dir(Path(REL_WORKTREE, ".git")) == "../main/.git/worktrees/linked_rel"
+    _assert_repo_locations(repo, REL_GIT_DIR, REL_WORKTREE)
+
+    assert repo.head.commit.hexsha == "be0390947541c84c41af034449d92c1b9c5e2cbe"
+    repo.close()
+
+
+def test_repo_autodiscovers_worktree_from_git_dir_environment(linked_worktrees: None, monkeypatch: pytest.MonkeyPatch) -> None:
+
+
+
+    monkeypatch.setenv("GIT_DIR", ABS_GIT_DIR)
+    monkeypatch.delenv("GIT_WORK_TREE", raising=False)
+    monkeypatch.delenv("GIT_COMMON_DIR", raising=False)
+
+    repo = Repo()
+    _assert_repo_locations(repo, ABS_GIT_DIR, ABS_WORKTREE)
+
+    assert repo.head.commit.hexsha == "be0390947541c84c41af034449d92c1b9c5e2cbe"
+    repo.close()
+
+
+def test_repo_autodiscovery_uses_explicit_git_work_tree(linked_worktrees: None, monkeypatch: pytest.MonkeyPatch) -> None:
+
+
+
+    monkeypatch.setenv("GIT_DIR", ABS_GIT_DIR)
+    monkeypatch.setenv("GIT_WORK_TREE", ENV_WORKTREE)
+    monkeypatch.delenv("GIT_COMMON_DIR", raising=False)
+
+    repo = Repo()
+    _assert_repo_locations(repo, ABS_GIT_DIR, ENV_WORKTREE)
+
+    repo.close()
+
+
+def test_find_worktree_git_dir_returns_values_and_none_cases(linked_worktrees: None) -> None:
+
+
+
+    missing = Path(FIXTURE_ROOT, "missing_dotgit")
+    directory = Path(FIXTURE_ROOT, "directory_dotgit")
+    plain = Path(FIXTURE_ROOT, "plain_dotgit")
+    malformed = Path(FIXTURE_ROOT, "malformed_dotgit")
+    directory.mkdir()
+    plain.write_text("not a gitdir line\n")
+    malformed.write_text("badline\ngitdir: ok\n")
+
+    assert find_worktree_git_dir(Path(ABS_WORKTREE, ".git")) == "/workspace/repo/usercase-test-coderl/fixtures/linked_worktree_state/main/.git/worktrees/linked_abs"
+    assert find_worktree_git_dir(Path(REL_WORKTREE, ".git")) == "../main/.git/worktrees/linked_rel"
+    assert find_worktree_git_dir(missing) is None
+    assert find_worktree_git_dir(directory) is None
+    assert find_worktree_git_dir(plain) is None
+    assert find_worktree_git_dir(malformed) is None
+
+
+def test_malformed_worktree_gitfile_does_not_open_as_repository(linked_worktrees: None) -> None:
+
+
+
+    bad_repo = Path(FIXTURE_ROOT, "bad_repo")
+    bad_repo.mkdir()
+    bad_repo.joinpath(".git").write_text("badline\ngitdir: ok\n")
+
+    with pytest.raises(InvalidGitRepositoryError):
+        Repo(str(bad_repo))
+
+
+def test_repo_close_is_idempotent_for_linked_worktree(linked_worktrees: None) -> None:
+
+
+
+    repo = Repo(ABS_WORKTREE)
+    _assert_repo_locations(repo, ABS_GIT_DIR, ABS_WORKTREE)
+    repo.close()
+
+    reopened = Repo(ABS_WORKTREE)
+    _assert_repo_locations(reopened, ABS_GIT_DIR, ABS_WORKTREE)
+    reopened.close()
+
+
+def test_two_linked_worktree_repo_instances_keep_independent_state(linked_worktrees: None) -> None:
+
+
+
+    first = Repo(ABS_WORKTREE)
+    second = Repo(REL_WORKTREE)
+    _assert_repo_locations(first, ABS_GIT_DIR, ABS_WORKTREE)
+    _assert_repo_locations(second, REL_GIT_DIR, REL_WORKTREE)
+
+    first.close()
+
+    _assert_repo_locations(second, REL_GIT_DIR, REL_WORKTREE)
+    second.close()
+
+
+def test_repeated_open_read_close_cycles_do_not_leave_git_processes(linked_worktrees: None) -> None:
+
+
+
+    retained_repos = []
+
+
+    for _ in range(5):
+        repo = Repo(ABS_WORKTREE)
+        _assert_repo_locations(repo, ABS_GIT_DIR, ABS_WORKTREE)
+        assert repo.head.commit.hexsha == "be0390947541c84c41af034449d92c1b9c5e2cbe"
+        repo.close()
+        retained_repos.append(repo)
+
+    assert len(retained_repos) == 5
+    retained_repos.clear()
