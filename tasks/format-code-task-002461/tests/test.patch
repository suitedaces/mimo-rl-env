+def test_random_two_qubit_default_seed_52_with_final_layer() -> None:
+
+
+
+    q0, q1 = cirq.LineQubit.range(2)
+
+    circuit = rqcg.random_rotations_between_two_qubit_circuit(q0, q1, 4, seed=52)
+
+    assert len(circuit.moments) == 9
+    assert tuple(repr(q) for q in sorted(circuit.all_qubits())) == ("cirq.LineQubit(0)", "cirq.LineQubit(1)")
+
+
+    for index in (0, 2, 4, 6, 8):
+        _assert_single_qubit_layer(circuit.moments[index], q0, q1)
+    for index in (1, 3, 5, 7):
+        _assert_two_qubit_layer(circuit.moments[index], q0, q1, cirq.CZ)
+    _assert_no_adjacent_repeated_single_gates(circuit, q0, q1, (0, 2, 4, 6, 8))
+
