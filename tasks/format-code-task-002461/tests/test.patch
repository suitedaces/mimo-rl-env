+def _circuit_signature(circuit: cirq.Circuit) -> tuple[tuple[tuple[str, tuple[str, ...], tuple[str, ...]], ...], ...]:
+    return tuple(
+        tuple(
+            (repr(op.gate), tuple(repr(q) for q in op.qubits), tuple(repr(t) for t in op.tags))
+            for op in moment.operations
+        )
+        for moment in circuit.moments
+    )
+
+
+def _single_gate_layers(circuit: cirq.Circuit) -> tuple[tuple[str, ...], ...]:
+    return tuple(tuple(repr(op.gate) for op in moment.operations) for moment in circuit.moments[::2])
+
+
+def _two_qubit_layer_signature(circuit: cirq.Circuit) -> tuple[tuple[str, tuple[str, ...], tuple[str, ...]], ...]:
+    return tuple(
+        (
+            repr(next(iter(moment.operations)).gate),
+            tuple(repr(q) for q in next(iter(moment.operations)).qubits),
+            tuple(repr(t) for t in next(iter(moment.operations)).tags),
+        )
+        for moment in circuit.moments[1::2]
+    )
+
+
+def _single_qubit_gate_by_qubit(moment: cirq.Moment) -> dict[cirq.Qid, cirq.Gate]:
+    assert len(moment.operations) == 2
+    by_qubit = {}
+    for op in moment.operations:
+        assert len(op.qubits) == 1
+        assert op.tags == ()
+        by_qubit[op.qubits[0]] = op.gate
+    return by_qubit
+
+
+def _assert_single_qubit_layer(
+    moment: cirq.Moment, q0: cirq.Qid, q1: cirq.Qid, expected_gate: cirq.Gate | None = None
+) -> None:
+    gates_by_qubit = _single_qubit_gate_by_qubit(moment)
+    assert set(gates_by_qubit) == {q0, q1}
+    if expected_gate is not None:
+        assert gates_by_qubit[q0] == expected_gate
+        assert gates_by_qubit[q1] == expected_gate
+
+
+def _assert_two_qubit_layer(
+    moment: cirq.Moment,
+    q0: cirq.Qid,
+    q1: cirq.Qid,
+    expected_gate: cirq.Gate,
+    expected_tags: tuple[Any, ...] = (),
+) -> None:
+    assert len(moment.operations) == 1
+    op = next(iter(moment.operations))
+    assert op.qubits == (q0, q1)
+    assert op.gate == expected_gate
+    assert op.tags == expected_tags
+
+
+def _assert_no_adjacent_repeated_single_gates(
+    circuit: cirq.Circuit, q0: cirq.Qid, q1: cirq.Qid, single_layer_indices: tuple[int, ...]
+) -> None:
+    previous: dict[cirq.Qid, cirq.Gate] | None = None
+    for index in single_layer_indices:
+        current = _single_qubit_gate_by_qubit(circuit.moments[index])
+        assert set(current) == {q0, q1}
+        if previous is not None:
+            assert current[q0] != previous[q0]
+            assert current[q1] != previous[q1]
+        previous = current
+
