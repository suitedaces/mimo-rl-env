+def test_seeded_results_match_in_fresh_python_process() -> None:
+    q0, q1 = cirq.LineQubit.range(2)
+    in_process = {
+        "random": _circuit_signature(
+            rqcg.random_rotations_between_two_qubit_circuit(q0, q1, 3, seed=17)
+        ),
+        "library": tuple(
+            _single_gate_layers(c)
+            for c in rqcg.generate_library_of_2q_circuits(2, cirq.CNOT, max_cycle_depth=2, random_state=17)
+        ),
+    }
+    script = r"""
+import json
+import sys
+sys.path.insert(0, "/workspace/repo/cirq-core")
+import cirq
+from cirq.experiments import random_quantum_circuit_generation as rqcg
+
+def circuit_signature(circuit):
+    return tuple(
+        tuple((repr(op.gate), tuple(repr(q) for q in op.qubits), tuple(repr(t) for t in op.tags)) for op in moment.operations)
+        for moment in circuit.moments
+    )
+
+def single_gate_layers(circuit):
+    return tuple(tuple(repr(op.gate) for op in moment.operations) for moment in circuit.moments[::2])
+
+q0, q1 = cirq.LineQubit.range(2)
+out = {
+    "random": circuit_signature(rqcg.random_rotations_between_two_qubit_circuit(q0, q1, 3, seed=17)),
+    "library": tuple(single_gate_layers(c) for c in rqcg.generate_library_of_2q_circuits(2, cirq.CNOT, max_cycle_depth=2, random_state=17)),
+}
+print(json.dumps(out))
+"""
+    completed = subprocess.run(
+        [sys.executable, "-c", script], check=True, text=True, capture_output=True
+    )
+
+    assert json.loads(completed.stdout) == json.loads(json.dumps(in_process))
+
+
+def test_no_cwd_or_network_side_effects_for_pure_generation(
+    tmp_path: Any, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    def raise_on_socket(*args: Any, **kwargs: Any) -> None:
+        raise AssertionError("network access is not declared for random circuit generation")
+
+    monkeypatch.setattr(socket, "socket", raise_on_socket)
