+def test_random_two_qubit_multi_operation_factory_uses_one_prng_stream() -> None:
+
+
+
+    q0, q1 = cirq.LineQubit.range(2)
+    factory_prng_ids = []
+    factory_exponents = []
+
+    def multi_factory(a: cirq.Qid, b: cirq.Qid, prng: Any) -> cirq.OP_TREE:
+        exponent = prng.randint(1, 4) / 4
+        factory_prng_ids.append(id(prng))
+        factory_exponents.append(exponent)
+        return [cirq.CNOT(a, b), (cirq.ISWAP**exponent)(a, b)]
+
+    circuit = rqcg.random_rotations_between_two_qubit_circuit(
+        q0,
+        q1,
+        2,
+        two_qubit_op_factory=multi_factory,
+        single_qubit_gates=[cirq.X**0.5, cirq.Y**0.5],
+        seed=7,
+    )
+
+
+
+    assert len(factory_prng_ids) == 2
+    assert len(set(factory_prng_ids)) == 1
+    assert len(circuit.moments) == 7
+    for index in (0, 3, 6):
+        _assert_single_qubit_layer(circuit.moments[index], q0, q1)
+    _assert_two_qubit_layer(circuit.moments[1], q0, q1, cirq.CNOT)
+    _assert_two_qubit_layer(circuit.moments[2], q0, q1, cirq.ISWAP**factory_exponents[0])
+    _assert_two_qubit_layer(circuit.moments[4], q0, q1, cirq.CNOT)
+    _assert_two_qubit_layer(circuit.moments[5], q0, q1, cirq.ISWAP**factory_exponents[1])
+
