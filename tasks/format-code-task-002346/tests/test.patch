+package exporter
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func writeCustomMetricsConfigForTest(t *testing.T, body string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "custom-metrics.yml")
+	if err := os.WriteFile(path, []byte(body), 0600); err != nil {
+		t.Fatalf("write temp config: %v", err)
+	}
+	return path
+}
+
+func requireBoolPtrValue(t *testing.T, got *bool, want bool, field string) {
+	t.Helper()
+	if got == nil {
+		t.Fatalf("%s = nil, want %v", field, want)
+	}
+	if *got != want {
+		t.Fatalf("%s = %v, want %v", field, *got, want)
+	}
+}
+
+func TestCustomMetricsConfigLoadAndDefaults(t *testing.T) {
+	configPath := writeCustomMetricsConfigForTest(t, `
+apiVersion: v1alpha1
+customMetrics:
+  - name: arbitraryCustomJob
+    namespace: Team/AppTelemetry
+    regions:
+      - us-west-2
+      - eu-central-1
+    statistics:
+      - Sum
+      - SampleCount
+    nilToZero: false
+    period: 120
+    length: 600
+    delay: 60
+    addCloudwatchTimestamp: false
+    metrics:
+      - name: queue_depth_total
+      - name: request_latency_ms
+        statistics:
+          - p99
+        period: 240
+`)
+
+	config := ScrapeConf{}
+	if err := config.Load(&configPath); err != nil {
+		t.Fatalf("Load(customMetrics config) returned error: %v", err)
+	}
+
+	if len(config.CustomMetrics) != 1 {
+		t.Fatalf("len(CustomMetrics) = %d, want 1", len(config.CustomMetrics))
+	}
+
+	job := config.CustomMetrics[0]
+	if job.Name != "arbitraryCustomJob" {
+		t.Fatalf("job.Name = %q", job.Name)
+	}
+	if job.Namespace != "Team/AppTelemetry" {
+		t.Fatalf("job.Namespace = %q", job.Namespace)
+	}
+	if strings.Join(job.Regions, ",") != "us-west-2,eu-central-1" {
+		t.Fatalf("job.Regions = %#v", job.Regions)
+	}
+	if len(job.Roles) != 1 || job.Roles[0] != (Role{}) {
+		t.Fatalf("omitted customMetrics roles should default to current identity, got %#v", job.Roles)
+	}
+	if len(job.Metrics) != 2 {
+		t.Fatalf("len(job.Metrics) = %d, want 2", len(job.Metrics))
+	}
+
+	firstMetric := job.Metrics[0]
+	if firstMetric.Name != "queue_depth_total" {
+		t.Fatalf("first metric name = %q", firstMetric.Name)
+	}
+	if strings.Join(firstMetric.Statistics, ",") != "Sum,SampleCount" {
+		t.Fatalf("first metric statistics = %#v", firstMetric.Statistics)
+	}
+	if firstMetric.Period != 120 || firstMetric.Length != 600 || firstMetric.Delay != 60 {
+		t.Fatalf("first metric defaults period/length/delay = %d/%d/%d", firstMetric.Period, firstMetric.Length, firstMetric.Delay)
+	}
+	requireBoolPtrValue(t, firstMetric.NilToZero, false, "firstMetric.NilToZero")
+	requireBoolPtrValue(t, firstMetric.AddCloudwatchTimestamp, false, "firstMetric.AddCloudwatchTimestamp")
+
+	secondMetric := job.Metrics[1]
+	if secondMetric.Name != "request_latency_ms" {
+		t.Fatalf("second metric name = %q", secondMetric.Name)
+	}
+	if strings.Join(secondMetric.Statistics, ",") != "p99" {
+		t.Fatalf("explicit metric statistics should be preserved, got %#v", secondMetric.Statistics)
+	}
+	if secondMetric.Period != 240 {
+		t.Fatalf("explicit metric period should be preserved, got %d", secondMetric.Period)
+	}
+	if secondMetric.Length != 600 || secondMetric.Delay != 60 {
+		t.Fatalf("second metric inherited length/delay = %d/%d, want 600/60", secondMetric.Length, secondMetric.Delay)
+	}
+}
+
+func TestCustomMetricsOnlyConfigIsNonEmpty(t *testing.T) {
+	configPath := writeCustomMetricsConfigForTest(t, `
+apiVersion: v1alpha1
+customMetrics:
+  - name: onlyCustomJob
+    namespace: Example/OnlyCustom
+    regions:
+      - ap-southeast-2
+    metrics:
+      - name: workers_busy
+        statistics:
+          - Sum
+        period: 301
+        length: 301
+`)
+
+	config := ScrapeConf{}
+	if err := config.Load(&configPath); err != nil {
+		t.Fatalf("custom-only config should load and validate: %v", err)
+	}
+	if len(config.CustomMetrics) != 1 {
+		t.Fatalf("len(CustomMetrics) = %d, want 1", len(config.CustomMetrics))
+	}
+	if len(config.CustomMetrics[0].Roles) != 1 || config.CustomMetrics[0].Roles[0] != (Role{}) {
+		t.Fatalf("custom-only config with omitted roles should use current identity, got %#v", config.CustomMetrics[0].Roles)
+	}
+}
+
+func TestCustomMetricsConfigRejectsMissingRequiredFields(t *testing.T) {
+	testCases := []struct {
+		name       string
+		yaml       string
+	}{
+		{
+			name: "missing name",
+			yaml: `
+apiVersion: v1alpha1
+customMetrics:
+  - namespace: Example/MissingName
+    regions: [us-east-2]
+    metrics:
+      - name: packets_seen
+        statistics: [Sum]
+`,
+		},
+		{
+			name: "missing namespace",
+			yaml: `
+apiVersion: v1alpha1
+customMetrics:
+  - name: missingNamespaceJob
+    regions: [us-east-2]
+    metrics:
+      - name: packets_seen
+        statistics: [Sum]
+`,
+		},
+		{
+			name: "missing regions",
+			yaml: `
+apiVersion: v1alpha1
+customMetrics:
+  - name: missingRegionsJob
+    namespace: Example/MissingRegions
+    metrics:
+      - name: packets_seen
+        statistics: [Sum]
+`,
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			configPath := writeCustomMetricsConfigForTest(t, tc.yaml)
+			config := ScrapeConf{}
+			err := config.Load(&configPath)
+			if err == nil {
+				t.Fatalf("Load() succeeded, want validation error")
+			}
+		})
+	}
+}
