+package exporter
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestReadmeDocumentsCustomMetricsConfiguration(t *testing.T) {
+	body, err := os.ReadFile("../README.md")
+	if err != nil {
+		t.Fatalf("read README.md: %v", err)
+	}
+	readme := string(body)
+	lowerReadme := strings.ToLower(readme)
+
+	if !strings.Contains(readme, "customMetrics") {
+		t.Fatalf("README.md should mention customMetrics for custom metrics configuration")
+	}
+
+	requiredConcepts := []string{
+		"custom",
+		"namespace",
+		"regions",
+		"roles",
+		"metrics",
+		"dimensions",
+	}
+	for _, want := range requiredConcepts {
+		if !strings.Contains(lowerReadme, want) {
+			t.Fatalf("README.md should document custom metrics concept %q", want)
+		}
+	}
+}
