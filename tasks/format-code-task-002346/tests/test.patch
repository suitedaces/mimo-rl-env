+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+
+
+case "${1:-}" in
+  base)
+    go test ./pkg/ -run "^(TestConfLoad|TestBadConfigs|TestNewSessionCache)$" -v
+    ;;
+  new)
+    go test ./pkg/ -run "^(TestCustomMetricsConfigLoadAndDefaults|TestCustomMetricsOnlyConfigIsNonEmpty|TestCustomMetricsConfigRejectsMissingRequiredFields|TestReadmeDocumentsCustomMetricsConfiguration|TestScrapeCustomMetricsExportsConfiguredNamespaceMetrics|TestScrapeCustomMetricsPreservesCloudWatchDimensionsAsLabels|TestScrapeCustomMetricsSkipsMetricsWithNoDatapoints|TestCustomMetricsUseEachConfiguredRoleRegion)$" -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
