+import { proxy } from 'comlink'
+import { BehaviorSubject } from 'rxjs'
+
+import { SettingsCascade } from '../../../settings/settings'
+import { MainThreadAPI } from '../../contract'
+import { pretendRemote } from '../../util'
+import { proxySubscribable } from '../api/common'
+import { createExtensionAPI } from '../extensionApi'
+import { createExtensionHostAPI } from '../extensionHostApi'
+import { createExtensionHostState } from '../extensionHostState'
+
+const settingsCascade = (final: Record<string, any>): SettingsCascade => ({
+    subjects: [],
+    final,
+})
+
+interface SetupResult {
+    logExtensionMessage: jest.Mock
+    extensionHostAPI: ReturnType<typeof createExtensionHostAPI>
+    extensionAPI: ReturnType<typeof createExtensionAPI>
+}
+
+function setup(extensionID: string | undefined, final: Record<string, any>): SetupResult {
+    const logExtensionMessage = jest.fn()
+
+    const mainAPI = pretendRemote<MainThreadAPI>({
+        getScriptURLForExtension: proxy(() => undefined),
+        getEnabledExtensions: () => proxySubscribable(new BehaviorSubject([])),
+        logExtensionMessage,
+    })
+
+    const state = createExtensionHostState(
+        { initialSettings: settingsCascade(final), clientApplication: 'sourcegraph' },
+        mainAPI
+    )
+    const extensionHostAPI = createExtensionHostAPI(state)
+    const extensionAPI = createExtensionAPI(state, mainAPI, extensionID)
+
+    return { logExtensionMessage, extensionHostAPI, extensionAPI }
+}
+
+describe('ExtensionHost: app.log', () => {
+    test('app.log is a callable function', () => {
+        const { extensionAPI } = setup('my-extension', { 'extensions.activeLoggers': ['my-extension'] })
+        expect(typeof extensionAPI.app.log).toBe('function')
+    })
+
+    test('forwards the message to the main thread when the extension is an active logger', () => {
+        const { extensionAPI, logExtensionMessage } = setup('my-extension', {
+            'extensions.activeLoggers': ['my-extension'],
+        })
+
+        extensionAPI.app.log('hello', 42)
+
+        expect(logExtensionMessage).toHaveBeenCalledTimes(1)
+        const args = logExtensionMessage.mock.calls[0]
+
+        expect(args.slice(-2)).toEqual(['hello', 42])
+
+        expect(args.some(argument => typeof argument === 'string' && argument.includes('my-extension'))).toBe(true)
+    })
+
+    test('does not forward when the extension is not an active logger', () => {
+        const { extensionAPI, logExtensionMessage } = setup('my-extension', {
+            'extensions.activeLoggers': ['some-other-extension'],
+        })
+
+        extensionAPI.app.log('hello')
+
+        expect(logExtensionMessage).not.toHaveBeenCalled()
+    })
+
+    test('does not forward when there are no active loggers configured', () => {
+        const { extensionAPI, logExtensionMessage } = setup('my-extension', {})
+
+        extensionAPI.app.log('hello')
+
+        expect(logExtensionMessage).not.toHaveBeenCalled()
+    })
+
+    test('does not throw and does not forward when activeLoggers is not an array', () => {
+        const { extensionAPI, logExtensionMessage } = setup('my-extension', {
+            'extensions.activeLoggers': 'my-extension',
+        })
+
+        expect(() => extensionAPI.app.log('hello')).not.toThrow()
+        expect(logExtensionMessage).not.toHaveBeenCalled()
+    })
+
+    test('gating reflects settings changes at runtime', () => {
+        const { extensionAPI, extensionHostAPI, logExtensionMessage } = setup('my-extension', {
+            'extensions.activeLoggers': [],
+        })
+
+
+        extensionAPI.app.log('first')
+        expect(logExtensionMessage).not.toHaveBeenCalled()
+
+
+        extensionHostAPI.syncSettingsData({ subjects: [], final: { 'extensions.activeLoggers': ['my-extension'] } })
+        extensionAPI.app.log('second')
+        expect(logExtensionMessage).toHaveBeenCalledTimes(1)
+        expect(logExtensionMessage.mock.calls[0].slice(-1)).toEqual(['second'])
+
+
+        extensionHostAPI.syncSettingsData({ subjects: [], final: { 'extensions.activeLoggers': [] } })
+        extensionAPI.app.log('third')
+        expect(logExtensionMessage).toHaveBeenCalledTimes(1)
+    })
+
+    test('only forwards for the bound extension ID', () => {
+        const { extensionAPI, logExtensionMessage } = setup('extension-a', {
+            'extensions.activeLoggers': ['extension-b'],
+        })
+
+        extensionAPI.app.log('hello')
+        expect(logExtensionMessage).not.toHaveBeenCalled()
+    })
+
+    test('log is a safe no-op when constructed without an extension ID', () => {
+        const { extensionAPI, logExtensionMessage } = setup(undefined, {
+            'extensions.activeLoggers': ['my-extension'],
+        })
+
+        expect(typeof extensionAPI.app.log).toBe('function')
+        expect(() => extensionAPI.app.log('hello')).not.toThrow()
+        expect(logExtensionMessage).not.toHaveBeenCalled()
+    })
+})
