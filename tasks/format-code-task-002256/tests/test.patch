+    def test_full_default_maxsize_empty_queue(self, queue_path):
+
+
+        q = Queue(queue_path)
+        assert q.qsize() == 0
+        assert q.empty() is True
+        assert q.full() is False
+
+    def test_full_default_maxsize_with_items(self, queue_path):
+
+        q = Queue(queue_path)
+        q.put('foo')
+        assert q.qsize() == 1
+        assert q.empty() is False
+        assert q.full() is False
+        q.put('bar')
+        assert q.qsize() == 2
+        assert q.full() is False
+
+    def test_full_default_maxsize_after_drain(self, queue_path):
+
+
+        q = Queue(queue_path)
+        q.put('foo')
+        q.put('bar')
+        assert q.get(block=False) == 'foo'
+        assert q.full() is False
+        assert q.get(block=False) == 'bar'
+        assert q.qsize() == 0
+        assert q.empty() is True
+        assert q.full() is False
+
+    def test_full_explicit_zero_maxsize(self, queue_path):
+
+        q = Queue(queue_path, maxsize=0)
+        assert q.full() is False
+        q.put('item')
+        assert q.full() is False
+
+    def test_full_bounded_queue_empty(self, queue_path):
+
+        q = Queue(queue_path, maxsize=2)
+        assert q.qsize() == 0
+        assert q.empty() is True
+        assert q.full() is False
+
+    def test_full_bounded_queue_at_capacity(self, queue_path):
+
+        q = Queue(queue_path, maxsize=2)
+        q.put('foo')
+        assert q.full() is False
+        q.put('bar')
+        assert q.qsize() == 2
+        assert q.full() is True
+
+    def test_full_bounded_queue_after_get(self, queue_path):
+
+        q = Queue(queue_path, maxsize=2)
+        q.put('foo')
+        q.put('bar')
+        assert q.full() is True
+        q.get(block=False)
+        assert q.full() is False
+        q.get(block=False)
+        assert q.qsize() == 0
+        assert q.full() is False
+
