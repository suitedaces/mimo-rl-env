--- /dev/null
+++ b/tests/common/schemas/test_api_gateway.py
@@ -0,0 +1,31 @@
+import pytest
+
+import mlrun.common.schemas
+
+
+@pytest.mark.parametrize(
+    "host,path,expected",
+    [
+        (
+            "https://gateway-one.example.com",
+            "/invoke/",
+            "https://gateway-one.example.com/invoke",
+        ),
+        ("https://gateway-two.example.com/", "", "https://gateway-two.example.com"),
+    ],
+)
+def test_schema_invoke_url_does_not_keep_trailing_slash_variants(host, path, expected):
+    gateway = mlrun.common.schemas.APIGateway(
+        metadata=mlrun.common.schemas.APIGatewayMetadata(name="test-gateway"),
+        spec=mlrun.common.schemas.APIGatewaySpec(
+            name="test-gateway",
+            host=host,
+            path=path,
+            upstreams=[
+                mlrun.common.schemas.APIGatewayUpstream(
+                    nucliofunction={"name": "test-function"}
+                )
+            ],
+        ),
+    )
+    assert gateway.get_invoke_url() == expected
