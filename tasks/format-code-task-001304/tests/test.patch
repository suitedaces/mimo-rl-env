+func TestPublisherEndpointReturnsEncodeErrorBeforePublishOrConsume(t *testing.T) {
+
+
+	channel := &recordingChannel{}
+	publisher := amqptransport.NewPublisher(
+		channel,
+		&amqp.Queue{Name: "some queue"},
+		func(context.Context, *amqp.Publishing, interface{}) error { return errors.New("err!") },
+		decodeJSONResponse,
+	)
+
+	actual, err := publisher.Endpoint()(context.Background(), squadronRequest{Squadron: 437})
+
+	if actual != nil {
+		t.Fatalf("response = %#v, want nil", actual)
+	}
+	if err == nil {
+		t.Fatal("error = nil, want errors.New(\"err!\")")
+	}
+	if err.Error() != "err!" {
+		t.Fatalf("error message = %q, want %q", err.Error(), "err!")
+	}
+	if len(channel.publishes) != 0 {
+		t.Fatalf("publish call count = %d, want 0", len(channel.publishes))
+	}
+	if len(channel.consumes) != 0 {
+		t.Fatalf("consume call count = %d, want 0", len(channel.consumes))
+	}
+}
