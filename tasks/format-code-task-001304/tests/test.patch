+func TestPublisherTimeoutReturnsContextDeadlineExceeded(t *testing.T) {
+
+
+	channel := &recordingChannel{}
+	publisher := amqptransport.NewPublisher(
+		channel,
+		&amqp.Queue{Name: "some queue"},
+		encodeJSONRequest,
+		decodeJSONResponse,
+		amqptransport.PublisherBefore(amqptransport.SetCorrelationID("missing")),
+		amqptransport.PublisherTimeout(5*time.Millisecond),
+	)
+
+	actual, err := publisher.Endpoint()(context.Background(), squadronRequest{Squadron: 437})
+
+	if actual != nil {
+		t.Fatalf("response = %#v, want nil", actual)
+	}
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("error = %#v, want context.DeadlineExceeded", err)
+	}
+
+	if err == nil {
+		t.Fatal("error = nil, want context.DeadlineExceeded")
+	}
+	if len(channel.publishes) != 1 {
+		t.Fatalf("publish call count = %d, want 1", len(channel.publishes))
+	}
+	if len(channel.consumes) != 1 {
+		t.Fatalf("consume call count = %d, want 1", len(channel.consumes))
+	}
+}
