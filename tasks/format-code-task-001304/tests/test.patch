+package usercase_test_coderl
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"testing"
+	"time"
+
+	amqptransport "github.com/go-kit/kit/transport/amqp"
+	amqp "github.com/rabbitmq/amqp091-go"
+)
+
+type squadronRequest struct {
+	Squadron int `json:"s"`
+}
+
+type squadronResponse struct {
+	Squadron int    `json:"s"`
+	Name     string `json:"n"`
+}
+
+type publishCall struct {
+	Exchange  string
+	Key       string
+	Mandatory bool
+	Immediate bool
+	Message   amqp.Publishing
+}
+
+type consumeCall struct {
+	Queue     string
+	Consumer  string
+	AutoAck   bool
+	Exclusive bool
+	NoLocal   bool
+	NoWait    bool
+	Args      amqp.Table
+}
+
+type recordingChannel struct {
+	publishes  []publishCall
+	consumes   []consumeCall
+	deliveries []amqp.Delivery
+}
+
+func (ch *recordingChannel) Publish(exchange, key string, mandatory, immediate bool, msg amqp.Publishing) error {
+	ch.publishes = append(ch.publishes, publishCall{
+		Exchange:  exchange,
+		Key:       key,
+		Mandatory: mandatory,
+		Immediate: immediate,
+		Message:   msg,
+	})
+	return nil
+}
+
+func (ch *recordingChannel) Consume(queue, consumer string, autoAck, exclusive, noLocal, noWait bool, args amqp.Table) (<-chan amqp.Delivery, error) {
+	ch.consumes = append(ch.consumes, consumeCall{
+		Queue:     queue,
+		Consumer:  consumer,
+		AutoAck:   autoAck,
+		Exclusive: exclusive,
+		NoLocal:   noLocal,
+		NoWait:    noWait,
+		Args:      args,
+	})
+	out := make(chan amqp.Delivery, len(ch.deliveries))
+	for _, delivery := range ch.deliveries {
+		out <- delivery
+	}
+	return out, nil
+}
+
+type ackRecorder struct {
+	count    int
+	tags     []uint64
+	multiple []bool
+}
+
+func (a *ackRecorder) Ack(tag uint64, multiple bool) error {
+	a.count++
+	a.tags = append(a.tags, tag)
+	a.multiple = append(a.multiple, multiple)
+	return nil
+}
+
+func (a *ackRecorder) Nack(tag uint64, multiple bool, requeue bool) error {
+	return nil
+}
+
+func (a *ackRecorder) Reject(tag uint64, requeue bool) error {
+	return nil
+}
+
+func encodeJSONRequest(_ context.Context, pub *amqp.Publishing, request interface{}) error {
+	body, err := json.Marshal(request)
+	if err != nil {
+		return err
+	}
+	pub.Body = body
+	pub.ContentType = "application/json"
+	return nil
+}
+
+func decodeJSONResponse(_ context.Context, delivery *amqp.Delivery) (interface{}, error) {
+	var response squadronResponse
+	if err := json.Unmarshal(delivery.Body, &response); err != nil {
+		return nil, err
+	}
+	return response, nil
+}
+
+func mustResponseBody(t *testing.T, response squadronResponse) []byte {
+	t.Helper()
+	body, err := json.Marshal(response)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return body
+}
+
+func TestPublisherEndpointPublishesConsumesMatchesAcksAndDecodes(t *testing.T) {
+
+
+	acker := &ackRecorder{}
+	channel := &recordingChannel{
+		deliveries: []amqp.Delivery{
+			{CorrelationId: "wrong", Body: []byte(`{"s":1,"n":"wrong"}`)},
+			{CorrelationId: "correlation", Body: []byte(`{"s":437,"n":"husky"}`), Acknowledger: acker, DeliveryTag: 9},
+		},
+	}
+	queue := &amqp.Queue{Name: "some queue"}
+	afterSeen := ""
+
+	publisher := amqptransport.NewPublisher(
+		channel,
+		queue,
+		encodeJSONRequest,
+		decodeJSONResponse,
+		amqptransport.PublisherBefore(
+			amqptransport.SetCorrelationID("correlation"),
+			amqptransport.SetPublishExchange("fleet"),
+			amqptransport.SetPublishKey("requests"),
+			amqptransport.SetConsumeAutoAck(false),
+			amqptransport.SetConsumeArgs(amqp.Table{"priority": "gold"}),
+		),
+		amqptransport.PublisherAfter(func(ctx context.Context, delivery *amqp.Delivery) context.Context {
+			afterSeen = delivery.CorrelationId + ":" + string(delivery.Body)
+			return ctx
+		}),
+	)
+
+	actual, err := publisher.Endpoint()(context.Background(), squadronRequest{Squadron: 437})
+	if err != nil {
+		t.Fatalf("unexpected endpoint error: %v", err)
+	}
+
+	if got := actual.(squadronResponse); got != (squadronResponse{Squadron: 437, Name: "husky"}) {
+		t.Fatalf("decoded response = %#v, want %#v", got, squadronResponse{Squadron: 437, Name: "husky"})
+	}
+	if len(channel.publishes) != 1 {
+		t.Fatalf("publish call count = %d, want 1", len(channel.publishes))
+	}
+	if channel.publishes[0].Exchange != "fleet" {
+		t.Fatalf("publish exchange = %q, want %q", channel.publishes[0].Exchange, "fleet")
+	}
+	if channel.publishes[0].Key != "requests" {
+		t.Fatalf("publish key = %q, want %q", channel.publishes[0].Key, "requests")
+	}
+
+	if channel.publishes[0].Message.CorrelationId != "correlation" {
+		t.Fatalf("publishing CorrelationId = %q, want %q", channel.publishes[0].Message.CorrelationId, "correlation")
+	}
+	if channel.publishes[0].Message.ContentType != "application/json" {
+		t.Fatalf("publishing ContentType = %q, want %q", channel.publishes[0].Message.ContentType, "application/json")
+	}
+	if string(channel.publishes[0].Message.Body) != `{"s":437}` {
+		t.Fatalf("publishing Body = %s, want %s", string(channel.publishes[0].Message.Body), `{"s":437}`)
+	}
+	if len(channel.consumes) != 1 {
+		t.Fatalf("consume call count = %d, want 1", len(channel.consumes))
+	}
+	if channel.consumes[0].Queue != "some queue" {
+		t.Fatalf("consume queue = %q, want %q", channel.consumes[0].Queue, "some queue")
+	}
+
+	if channel.consumes[0].AutoAck != false {
+		t.Fatalf("consume autoAck = %v, want false", channel.consumes[0].AutoAck)
+	}
+	if got := channel.consumes[0].Args["priority"]; got != "gold" {
+		t.Fatalf("consume args priority = %#v, want %q", got, "gold")
+	}
+	if acker.count != 1 {
+		t.Fatalf("ack count = %d, want 1", acker.count)
+	}
+	if len(acker.tags) != 1 || acker.tags[0] != 9 {
+		t.Fatalf("ack tags = %#v, want []uint64{9}", acker.tags)
+	}
+
+	if afterSeen != `correlation:{"s":437,"n":"husky"}` {
+		t.Fatalf("after hook saw %q, want %q", afterSeen, `correlation:{"s":437,"n":"husky"}`)
+	}
+}
