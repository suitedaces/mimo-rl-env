+func TestSendAndForgetDelivererPublishesWithoutConsuming(t *testing.T) {
+
+
+	channel := &recordingChannel{}
+	publisher := amqptransport.NewPublisher(
+		channel,
+		&amqp.Queue{Name: "some queue"},
+		encodeJSONRequest,
+		func(context.Context, *amqp.Delivery) (interface{}, error) { return "forgotten", nil },
+		amqptransport.PublisherBefore(
+			amqptransport.SetCorrelationID("fire"),
+			amqptransport.SetPublishExchange("fleet"),
+			amqptransport.SetPublishKey("events"),
+		),
+		amqptransport.PublisherDeliverer(amqptransport.SendAndForgetDeliverer),
+		amqptransport.PublisherTimeout(time.Hour),
+	)
+
+	actual, err := publisher.Endpoint()(context.Background(), squadronRequest{Squadron: 437})
+	if err != nil {
+		t.Fatalf("unexpected endpoint error: %v", err)
+	}
+	if actual != "forgotten" {
+		t.Fatalf("response = %#v, want %q", actual, "forgotten")
+	}
+	if len(channel.publishes) != 1 {
+		t.Fatalf("publish call count = %d, want 1", len(channel.publishes))
+	}
+	if len(channel.consumes) != 0 {
+		t.Fatalf("consume call count = %d, want 0", len(channel.consumes))
+	}
+	if channel.publishes[0].Exchange != "fleet" {
+		t.Fatalf("publish exchange = %q, want %q", channel.publishes[0].Exchange, "fleet")
+	}
+	if channel.publishes[0].Key != "events" {
+		t.Fatalf("publish key = %q, want %q", channel.publishes[0].Key, "events")
+	}
+	if channel.publishes[0].Message.CorrelationId != "fire" {
+		t.Fatalf("publishing CorrelationId = %q, want %q", channel.publishes[0].Message.CorrelationId, "fire")
+	}
+}
