+func TestPublisherConstructUseCyclesDoNotLeakGoroutinesOrFDs(t *testing.T) {
+
+
+	body := mustResponseBody(t, squadronResponse{Squadron: 437, Name: "husky"})
+	totalPublishes := 0
+	totalConsumes := 0
+
+	for i := 0; i < 100; i++ {
+		channel := &recordingChannel{
+			deliveries: []amqp.Delivery{
+				{CorrelationId: "correlation", Body: body},
+			},
+		}
+		publisher := amqptransport.NewPublisher(
+			channel,
+			&amqp.Queue{Name: "some queue"},
+			encodeJSONRequest,
+			decodeJSONResponse,
+			amqptransport.PublisherBefore(amqptransport.SetCorrelationID("correlation")),
+		)
+		actual, err := publisher.Endpoint()(context.Background(), squadronRequest{Squadron: 437})
+		if err != nil {
+			t.Fatalf("cycle %d endpoint error = %v, want nil", i, err)
+		}
+		if got := actual.(squadronResponse); got != (squadronResponse{Squadron: 437, Name: "husky"}) {
+			t.Fatalf("cycle %d response = %#v, want %#v", i, got, squadronResponse{Squadron: 437, Name: "husky"})
+		}
+		totalPublishes += len(channel.publishes)
+		totalConsumes += len(channel.consumes)
+	}
+
+
+	if totalPublishes != 100 {
+		t.Fatalf("publish calls across cycles = %d, want 100", totalPublishes)
+	}
+	if totalConsumes != 100 {
+		t.Fatalf("consume calls across cycles = %d, want 100", totalConsumes)
+	}
+}
