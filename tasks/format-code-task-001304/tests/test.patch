+func TestPublisherInstancesKeepIndependentState(t *testing.T) {
+
+
+	channelA := &recordingChannel{
+		deliveries: []amqp.Delivery{
+			{CorrelationId: "a", Body: []byte(`{"s":101,"n":"alpha"}`)},
+		},
+	}
+	channelB := &recordingChannel{
+		deliveries: []amqp.Delivery{
+			{CorrelationId: "b", Body: []byte(`{"s":202,"n":"bravo"}`)},
+		},
+	}
+	publisherA := amqptransport.NewPublisher(
+		channelA,
+		&amqp.Queue{Name: "qa"},
+		encodeJSONRequest,
+		decodeJSONResponse,
+		amqptransport.PublisherBefore(
+			amqptransport.SetCorrelationID("a"),
+			amqptransport.SetPublishKey("ka"),
+		),
+	)
+	publisherB := amqptransport.NewPublisher(
+		channelB,
+		&amqp.Queue{Name: "qb"},
+		encodeJSONRequest,
+		decodeJSONResponse,
+		amqptransport.PublisherBefore(
+			amqptransport.SetCorrelationID("b"),
+			amqptransport.SetPublishKey("kb"),
+		),
+	)
+
+	actualA, errA := publisherA.Endpoint()(context.Background(), squadronRequest{Squadron: 101})
+	actualB, errB := publisherB.Endpoint()(context.Background(), squadronRequest{Squadron: 202})
+
+	if errA != nil {
+		t.Fatalf("publisher A error = %v, want nil", errA)
+	}
+	if errB != nil {
+		t.Fatalf("publisher B error = %v, want nil", errB)
+	}
+	if got := actualA.(squadronResponse); got != (squadronResponse{Squadron: 101, Name: "alpha"}) {
+		t.Fatalf("publisher A response = %#v, want %#v", got, squadronResponse{Squadron: 101, Name: "alpha"})
+	}
+	if got := actualB.(squadronResponse); got != (squadronResponse{Squadron: 202, Name: "bravo"}) {
+		t.Fatalf("publisher B response = %#v, want %#v", got, squadronResponse{Squadron: 202, Name: "bravo"})
+	}
+
+	if channelA.consumes[0].Queue != "qa" {
+		t.Fatalf("publisher A consume queue = %q, want %q", channelA.consumes[0].Queue, "qa")
+	}
+	if channelB.consumes[0].Queue != "qb" {
+		t.Fatalf("publisher B consume queue = %q, want %q", channelB.consumes[0].Queue, "qb")
+	}
+	if channelA.publishes[0].Key != "ka" {
+		t.Fatalf("publisher A key = %q, want %q", channelA.publishes[0].Key, "ka")
+	}
+	if channelB.publishes[0].Key != "kb" {
+		t.Fatalf("publisher B key = %q, want %q", channelB.publishes[0].Key, "kb")
+	}
+	if channelA.publishes[0].Message.CorrelationId != "a" {
+		t.Fatalf("publisher A correlation = %q, want %q", channelA.publishes[0].Message.CorrelationId, "a")
+	}
+	if channelB.publishes[0].Message.CorrelationId != "b" {
+		t.Fatalf("publisher B correlation = %q, want %q", channelB.publishes[0].Message.CorrelationId, "b")
+	}
+}
