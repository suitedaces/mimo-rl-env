+func TestSetConsumeAutoAckTrueDoesNotAckMatchedDelivery(t *testing.T) {
+
+
+	acker := &ackRecorder{}
+	channel := &recordingChannel{
+		deliveries: []amqp.Delivery{
+			{CorrelationId: "correlation", Body: []byte(`{"s":437,"n":"husky"}`), Acknowledger: acker, DeliveryTag: 10},
+		},
+	}
+	publisher := amqptransport.NewPublisher(
+		channel,
+		&amqp.Queue{Name: "some queue"},
+		encodeJSONRequest,
+		decodeJSONResponse,
+		amqptransport.PublisherBefore(
+			amqptransport.SetCorrelationID("correlation"),
+			amqptransport.SetConsumeAutoAck(true),
+		),
+	)
+
+	actual, err := publisher.Endpoint()(context.Background(), squadronRequest{Squadron: 437})
+	if err != nil {
+		t.Fatalf("unexpected endpoint error: %v", err)
+	}
+	if got := actual.(squadronResponse); got != (squadronResponse{Squadron: 437, Name: "husky"}) {
+		t.Fatalf("decoded response = %#v, want %#v", got, squadronResponse{Squadron: 437, Name: "husky"})
+	}
+	if channel.consumes[0].AutoAck != true {
+		t.Fatalf("consume autoAck = %v, want true", channel.consumes[0].AutoAck)
+	}
+	if acker.count != 0 {
+		t.Fatalf("ack count = %d, want 0", acker.count)
+	}
+}
