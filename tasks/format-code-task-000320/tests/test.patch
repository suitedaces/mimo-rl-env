+from __future__ import annotations
+
+import copy
+import json
+import os
+import sys
+
+import pytest
+
+sys.path.insert(0, "/workspace/repo/ants")
+from ants import Ants  # noqa: E402
+
+
+BASE_OPTIONS = {
+    "turns": 7,
+    "loadtime": 1000,
+    "turntime": 100,
+    "viewradius2": 5,
+    "attackradius2": 0,
+    "spawnradius2": 1,
+    "engine_seed": 12345,
+    "player_seed": 67890,
+    "food": "none",
+    "food_rate": 0,
+    "food_turn": 1,
+    "food_start": 0,
+    "food_visible": 0,
+    "scenario": True,
+}
+
+FRESH_SCENARIO_MAP = """players 2
+rows 5
+cols 5
+m A%*..
+m .....
+m .....
+m ..b..
+m ....1
+"""
+
+FOOD_GATHER_MAP = """players 2
+rows 5
+cols 5
+m A*...
+m .....
+m .....
+m .....
+m ....B
+"""
+
+COLLISION_MAP = """players 2
+rows 5
+cols 5
+m A...B
+m .....
+m .a.b.
+m .....
+m .....
+"""
+
+RAZE_MAP = """players 2
+rows 5
+cols 5
+m A...B
+m .....
+m .....
+m .....
+m ..a1.
+"""
+
+FINISH_MAP = """players 2
+rows 5
+cols 5
+m A...B
+m .....
+m .....
+m .....
+m .....
+"""
+
+
+REQUIRED_REPLAY_KEYS = {
+    "revision",
+    "players",
+    "loadtime",
+    "turntime",
+    "turns",
+    "viewradius2",
+    "attackradius2",
+    "spawnradius2",
+    "engine_seed",
+    "player_seed",
+    "food_rate",
+    "food_turn",
+    "food_start",
+    "map",
+    "food",
+    "ants",
+    "hills",
+    "scores",
+    "bonus",
+    "hive_history",
+    "winning_turn",
+    "ranking_turn",
+    "cutoff",
+}
+
+
+def make_game(map_text, **overrides):
+    options = dict(BASE_OPTIONS)
+    options.update(overrides)
+    options["map"] = map_text
+    return Ants(options)
+
+
+def assert_entries_unordered(actual, expected):
+
+    assert sorted(map(tuple, actual)) == sorted(map(tuple, expected))
+
+
+def assert_replay_summary(
+    replay,
+    *,
+    options=None,
+    map_data,
+    food,
+    ants,
+    hills,
+    scores,
+    bonus,
+    hive_history,
+    winning_turn,
+    ranking_turn,
+    cutoff,
+):
+    options = BASE_OPTIONS if options is None else options
+
+
+    assert REQUIRED_REPLAY_KEYS.issubset(replay.keys())
+    assert replay["revision"] == 3
+    assert replay["players"] == 2
+    assert replay["loadtime"] == options["loadtime"]
+    assert replay["turntime"] == options["turntime"]
+    assert replay["turns"] == options["turns"]
+    assert replay["viewradius2"] == options["viewradius2"]
+    assert replay["attackradius2"] == options["attackradius2"]
+    assert replay["spawnradius2"] == options["spawnradius2"]
+    assert replay["engine_seed"] == options["engine_seed"]
+    assert replay["player_seed"] == options["player_seed"]
+    assert replay["food_rate"] == options["food_rate"]
+    assert replay["food_turn"] == options["food_turn"]
+    assert replay["food_start"] == options["food_start"]
+    assert replay["map"] == {"rows": 5, "cols": 5, "data": map_data}
+    assert_entries_unordered(replay["food"], food)
+    assert_entries_unordered(replay["ants"], ants)
+    assert_entries_unordered(replay["hills"], hills)
+    assert replay["scores"] == scores
+    assert replay["bonus"] == bonus
+    assert replay["hive_history"] == hive_history
+    assert replay["winning_turn"] == winning_turn
+    assert replay["ranking_turn"] == ranking_turn
+    assert replay["cutoff"] == cutoff
+
+
+def test_initialized_scenario_replay_summary_is_revision_3_and_json_serializable():
+
+
+
+    game = make_game(FRESH_SCENARIO_MAP)
+
+    replay = game.get_replay()
+
+    assert_replay_summary(
+        replay,
+        map_data=["a%*..", ".....", ".....", "..b..", "....."],
+        food=[[0, 2, 0, 1]],
+        ants=[[0, 0, 0, 1, 0, ""], [3, 2, 0, 1, 1, ""]],
+        hills=[[0, 0, 0, 1], [4, 4, 1, 1]],
+        scores=[[1], [1]],
+        bonus=[0, 0],
+        hive_history=[[0], [0]],
+        winning_turn=0,
+        ranking_turn=0,
+        cutoff=None,
+    )
+
+    assert isinstance(json.dumps(replay, sort_keys=True, separators=(",", ":")), str)
+
+
+def test_gathered_food_and_stationary_ant_orders_reflect_turn_one_state():
+
+
+
+    game = make_game(FOOD_GATHER_MAP)
+    game.start_turn()
+    game.finish_turn()
+
+    assert_replay_summary(
+        game.get_replay(),
+        map_data=["a*...", ".....", ".....", ".....", "....b"],
+        food=[[0, 1, 0, 1, 0]],
+        ants=[[0, 0, 0, 2, 0, "-"], [4, 4, 0, 2, 1, "-"]],
+        hills=[[0, 0, 0, 2], [4, 4, 1, 2]],
+        scores=[[1, 1], [1, 1]],
+        bonus=[0, 0],
+        hive_history=[[0, 1], [0, 0]],
+        winning_turn=1,
+        ranking_turn=1,
+        cutoff=None,
+    )
+
+
+def test_killed_ants_use_death_turn_and_concatenated_orders():
+
+
+
+    game = make_game(COLLISION_MAP)
+    game.start_turn()
+    assert game.do_moves(0, ["o 2 1 e"]) == (["o 2 1 e"], [], [])
+    assert game.do_moves(1, ["o 2 3 w"]) == (["o 2 3 w"], [], [])
+    game.finish_turn()
+
+    assert_replay_summary(
+        game.get_replay(),
+        map_data=["a...b", ".....", ".a.b.", ".....", "....."],
+        food=[],
+        ants=[
+            [0, 0, 0, 2, 0, "-"],
+            [2, 1, 0, 1, 0, "e"],
+            [0, 4, 0, 2, 1, "-"],
+            [2, 3, 0, 1, 1, "w"],
+        ],
+        hills=[[0, 0, 0, 2], [0, 4, 1, 2]],
+        scores=[[1, 1], [1, 1]],
+        bonus=[0, 0],
+        hive_history=[[0, 0], [0, 0]],
+        winning_turn=1,
+        ranking_turn=1,
+        cutoff=None,
+    )
+
+
+def test_razed_hill_uses_hill_end_turn_and_updates_score_history():
+
+
+
+    game = make_game(RAZE_MAP)
+    game.start_turn()
+    assert game.do_moves(0, ["o 4 2 e"]) == (["o 4 2 e"], [], [])
+    assert game.do_moves(1, []) == ([], [], [])
+    game.finish_turn()
+
+    assert_replay_summary(
+        game.get_replay(),
+        map_data=["a...b", ".....", ".....", ".....", "..a.."],
+        food=[],
+        ants=[[0, 0, 0, 2, 0, "-"], [4, 2, 0, 2, 0, "e"], [0, 4, 0, 2, 1, "-"]],
+        hills=[[0, 0, 0, 2], [0, 4, 1, 2], [4, 3, 1, 1]],
+        scores=[[1, 3], [1, 0]],
+        bonus=[0, 0],
+        hive_history=[[0, 0], [0, 0]],
+        winning_turn=1,
+        ranking_turn=1,
+        cutoff=None,
+    )
+
+
+def test_finished_game_replay_keeps_terminal_cutoff_and_bonus_fields():
+
+
+
+    game = make_game(FINISH_MAP)
+    game.kill_player(1)
+    game.finish_game()
+
+    assert_replay_summary(
+        game.get_replay(),
+        map_data=["a...b", ".....", ".....", ".....", "....."],
+        food=[],
+        ants=[[0, 0, 0, 1, 0, ""], [0, 4, 0, 1, 1, ""]],
+        hills=[[0, 0, 0, 1], [0, 4, 1, 1]],
+        scores=game.score_history,
+        bonus=game.bonus,
+        hive_history=game.hive_history,
+        winning_turn=game.winning_turn,
+        ranking_turn=game.ranking_turn,
+        cutoff=game.cutoff,
+    )
+
+
+def test_get_replay_takes_no_arguments():
+
+
+
+    game = make_game(FRESH_SCENARIO_MAP)
+
+    with pytest.raises(TypeError) as excinfo:
+        game.get_replay("unexpected")
+
+
+    assert isinstance(excinfo.value, TypeError)
+
+
+def test_repeated_get_replay_does_not_mutate_state_or_write_files(tmp_path):
+
+
+
+    previous_cwd = os.getcwd()
+    os.chdir(str(tmp_path))
+    try:
+        game = make_game(FOOD_GATHER_MAP)
+        game.start_turn()
+        game.finish_turn()
+        before = (
+            game.turn,
+            copy.deepcopy(game.get_scores()),
+            copy.deepcopy(game.get_state_changes()),
+            copy.deepcopy(game.hive_history),
+            [(food.loc, food.start_turn, food.end_turn, food.owner) for food in game.all_food],
+            os.listdir(str(tmp_path)),
+        )
+
+        first = game.get_replay()
+        second = game.get_replay()
+        after = (
+            game.turn,
+            copy.deepcopy(game.get_scores()),
+            copy.deepcopy(game.get_state_changes()),
+            copy.deepcopy(game.hive_history),
+            [(food.loc, food.start_turn, food.end_turn, food.owner) for food in game.all_food],
+            os.listdir(str(tmp_path)),
+        )
+    finally:
+        os.chdir(previous_cwd)
+
+    assert_replay_summary(
+        first,
+        map_data=["a*...", ".....", ".....", ".....", "....b"],
+        food=[[0, 1, 0, 1, 0]],
+        ants=[[0, 0, 0, 2, 0, "-"], [4, 4, 0, 2, 1, "-"]],
+        hills=[[0, 0, 0, 2], [4, 4, 1, 2]],
+        scores=[[1, 1], [1, 1]],
+        bonus=[0, 0],
+        hive_history=[[0, 1], [0, 0]],
+        winning_turn=1,
+        ranking_turn=1,
+        cutoff=None,
+    )
+    assert second == first
+
+    assert after == before
+
+
+def test_finish_game_lifecycle_is_idempotent_for_finished_replay_sessions():
+
+
+
+    game = make_game(FINISH_MAP)
+    game.kill_player(1)
+    game.finish_game()
+    game.finish_game()
+
+    assert_replay_summary(
+        game.get_replay(),
+        map_data=["a...b", ".....", ".....", ".....", "....."],
+        food=[],
+        ants=[[0, 0, 0, 1, 0, ""], [0, 4, 0, 1, 1, ""]],
+        hills=[[0, 0, 0, 1], [0, 4, 1, 1]],
+        scores=game.score_history,
+        bonus=game.bonus,
+        hive_history=game.hive_history,
+        winning_turn=game.winning_turn,
+        ranking_turn=game.ranking_turn,
+        cutoff=game.cutoff,
+    )
+
+
+def test_two_games_keep_independent_replay_state():
+
+
+
+    game_a = make_game(FOOD_GATHER_MAP)
+    game_b = make_game(FRESH_SCENARIO_MAP, turns=9, engine_seed=222, player_seed=333)
+
+    game_a.start_turn()
+    game_a.finish_turn()
+
+    assert_replay_summary(
+        game_a.get_replay(),
+        map_data=["a*...", ".....", ".....", ".....", "....b"],
+        food=[[0, 1, 0, 1, 0]],
+        ants=[[0, 0, 0, 2, 0, "-"], [4, 4, 0, 2, 1, "-"]],
+        hills=[[0, 0, 0, 2], [4, 4, 1, 2]],
+        scores=[[1, 1], [1, 1]],
+        bonus=[0, 0],
+        hive_history=[[0, 1], [0, 0]],
+        winning_turn=1,
+        ranking_turn=1,
+        cutoff=None,
+    )
+    options_b = dict(BASE_OPTIONS, turns=9, engine_seed=222, player_seed=333)
+    assert_replay_summary(
+        game_b.get_replay(),
+        options=options_b,
+        map_data=["a%*..", ".....", ".....", "..b..", "....."],
+        food=[[0, 2, 0, 1]],
+        ants=[[0, 0, 0, 1, 0, ""], [3, 2, 0, 1, 1, ""]],
+        hills=[[0, 0, 0, 1], [4, 4, 1, 1]],
+        scores=[[1], [1]],
+        bonus=[0, 0],
+        hive_history=[[0], [0]],
+        winning_turn=0,
+        ranking_turn=0,
+        cutoff=None,
+    )
+
+
+def test_replay_repeated_lifecycle_cycles_keep_required_state_stable():
+
+
+
+    for _ in range(120):
+        game = make_game(FOOD_GATHER_MAP)
+        game.start_turn()
+        game.finish_turn()
+        replay = game.get_replay()
+
+        assert_entries_unordered(replay["food"], [[0, 1, 0, 1, 0]])
+        assert game.get_replay() == replay
+        game.kill_player(1)
+        game.finish_game()
