+from .. utils import TranspileTestCase
+
+
+class FloatFloorDivModTests(TranspileTestCase):
+
+
+
+    def test_floor_divide_int(self):
+        self.assertCodeExecution("""
+            for x in [9.9, -9.9, 0.0, 5.5]:
+                for y in [2, -2, 5]:
+                    print(x // y)
+            """)
+
+    def test_floor_divide_float(self):
+        self.assertCodeExecution("""
+            for x in [9.9, -9.9, 2.0, 7.5, -7.5, 0.0]:
+                for y in [2.0, -2.5, 0.5]:
+                    print(x // y)
+            """)
+
+    def test_floor_divide_bool(self):
+        self.assertCodeExecution("""
+            x = 9.9
+            y = True
+            print(x // y)
+            x = -9.9
+            print(x // y)
+            """)
+
+    def test_modulo_int(self):
+        self.assertCodeExecution("""
+            for x in [5.5, -5.5, 9.9, 7.0, -7.0]:
+                for y in [2, -2, 7]:
+                    print(x % y)
+            """)
+
+    def test_modulo_float(self):
+        self.assertCodeExecution("""
+            for x in [5.5, -5.5, 9.9, 3.5, -7.0, 7.0]:
+                for y in [2.0, -2.0, 2.5, 7.0, -7.0]:
+                    print(x % y)
+            """)
+
+    def test_modulo_bool(self):
+        self.assertCodeExecution("""
+            x = 5.5
+            y = True
+            print(x % y)
+            x = -5.5
+            print(x % y)
+            """)
+
+    def test_signed_zero_results(self):
+        self.assertCodeExecution("""
+            for x in [0.0, -7.0, 7.0, 6.0, -6.0]:
+                for y in [3, -3, 7.0, -7.0]:
+                    print(x % y)
+            """)
+
+    def test_floor_divide_by_zero_int(self):
+        self.assertCodeExecution("""
+            x = 1.5
+            y = 0
+            print(x // y)
+            """)
+
+    def test_floor_divide_by_zero_float(self):
+        self.assertCodeExecution("""
+            x = 1.5
+            y = 0.0
+            print(x // y)
+            """)
+
+    def test_floor_divide_by_false(self):
+        self.assertCodeExecution("""
+            x = 1.5
+            y = False
+            print(x // y)
+            """)
+
+    def test_modulo_by_zero_int(self):
+        self.assertCodeExecution("""
+            x = 1.5
+            y = 0
+            print(x % y)
+            """)
+
+    def test_modulo_by_zero_float(self):
+        self.assertCodeExecution("""
+            x = 1.5
+            y = 0.0
+            print(x % y)
+            """)
+
+    def test_modulo_by_false(self):
+        self.assertCodeExecution("""
+            x = 1.5
+            y = False
+            print(x % y)
+            """)
+
+    def test_floor_divide_type_error_str(self):
+        self.assertCodeExecution("""
+            x = 1.5
+            y = 'a'
+            print(x // y)
+            """)
+
+    def test_floor_divide_type_error_list(self):
+        self.assertCodeExecution("""
+            x = 1.5
+            y = [1]
+            print(x // y)
+            """)
+
+    def test_modulo_type_error_str(self):
+        self.assertCodeExecution("""
+            x = 1.5
+            y = 'a'
+            print(x % y)
+            """)
