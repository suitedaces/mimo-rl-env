@@ -0,0 +1,25 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+set +u
+export PATH="$HOME/.rbenv/bin:$HOME/.rbenv/plugins/ruby-build/bin:$PATH"
+eval "$(rbenv init - bash)"
+rbenv global 2.7.8
+set -u
+
+
+case "${1:-}" in
+  base)
+    ruby -e 'puts "No pre-existing postgresql_psql unit specs in base checkout; base regression scope is empty."'
+    ;;
+  new)
+    ruby -S rspec /testbed/spec/unit/puppet/type/postgresql_psql_refreshonly_spec.rb
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
