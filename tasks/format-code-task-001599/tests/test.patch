diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,190 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+export DVC_NO_ANALYTICS=1
+export DVC_TEST=true
+export DVC_STUDIO_OFFLINE=true
+export DVC_EXP_AUTO_PUSH=false
+export PYTHONDONTWRITEBYTECODE=1
+export PYTHONPATH="/workspace/repo${PYTHONPATH:+:$PYTHONPATH}"
+
+( cd /workspace/repo && python -c 'import dvc.cli' ) \
+    || { echo "FAIL: build" >&2; exit 1; }
+
+DVC=(python -m dvc)
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+names_from_csv() {
+    tr -d '\r' <"$1" | awk -F, 'NR > 1 && $1 != "" { print $1 }'
+}
+
+run_ok() {
+    local label="$1"
+    local expected="$2"
+    shift 2
+
+    "${DVC[@]}" exp show --no-pager --csv --drop='rev|Created' "$@" \
+        >"$TMP/$label.out" 2>"$TMP/$label.err"
+    local ec=$?
+    local actual
+    actual="$(names_from_csv "$TMP/$label.out")"
+
+    [ "$ec" -eq 0 ] || fail "$label exit $ec; want 0; stderr: $(cat "$TMP/$label.err")"
+
+    ! grep -qi "error" "$TMP/$label.err" || fail "$label stderr reports error: $(cat "$TMP/$label.err")"
+    [ "$actual" = "$expected" ] || fail "$label experiment order: [$actual], want [$expected]"
+}
+
+run_err() {
+    local label="$1"
+    shift
+
+    set +e
+    "${DVC[@]}" exp show --no-pager --csv --drop='rev|Created' "$@" \
+        >"$TMP/$label.out" 2>"$TMP/$label.err"
+    local ec=$?
+    set -e
+
+    [ "$ec" -ne 0 ] || fail "$label exit 0; want non-zero"
+
+    ! grep -q "^Experiment," "$TMP/$label.out" || fail "$label produced experiment table on failure: $(cat "$TMP/$label.out")"
+    [ -s "$TMP/$label.err" ] || fail "$label missing stderr"
+}
+
+setup_repo() {
+    local repo_dir="$1"
+    mkdir -p "$repo_dir"
+    cd "$repo_dir" || exit 1
+    git init -q
+    git config user.email test@example.com
+    git config user.name "Test User"
+    "${DVC[@]}" init -q || exit 1
+
+    cat >params.yaml <<'EOF'
+foo: 10
+alpha: 100
+EOF
+    cat >metrics.yaml <<'EOF'
+foo: 10
+score: 10
+EOF
+    cat >'metrics:1.json' <<'EOF'
+{"my::metric": 10, "other_metric": 10}
+EOF
+    cat >dvc.yaml <<'EOF'
+metrics:
+  - metrics.yaml
+  - metrics:1.json
+params:
+  - params.yaml
+EOF
+    git add .
+    git commit -q -m baseline
+
+    cat >params.yaml <<'EOF'
+foo: 3
+alpha: 300
+EOF
+    cat >metrics.yaml <<'EOF'
+foo: 1
+score: 1
+EOF
+    cat >'metrics:1.json' <<'EOF'
+{"my::metric": 2, "other_metric": 20}
+EOF
+    "${DVC[@]}" exp save -q -n low || exit 1
+
+    cat >params.yaml <<'EOF'
+alpha: 900
+EOF
+    cat >metrics.yaml <<'EOF'
+foo: 5
+score: 5
+EOF
+    cat >'metrics:1.json' <<'EOF'
+{"my::metric": 1}
+EOF
+    "${DVC[@]}" exp save -q -n missing_param || exit 1
+
+    cat >params.yaml <<'EOF'
+foo: 7
+alpha: 700
+EOF
+    cat >metrics.yaml <<'EOF'
+foo: 9
+score: 9
+EOF
+    cat >'metrics:1.json' <<'EOF'
+{"my::metric": 3, "other_metric": 10}
+EOF
+    "${DVC[@]}" exp save -q -n high || exit 1
+}
+
+WORK="$TMP/work"
+setup_repo "$WORK"
+cd "$WORK" || exit 1
+
+
+
+
+run_ok "metric_qualified_asc" $'low\nmissing_param\nhigh' --sort-by=metrics.yaml:foo
+
+
+
+
+run_ok "param_qualified_missing_last" $'low\nhigh\nmissing_param' --sort-by=params.yaml:foo
+
+
+
+
+run_ok "param_qualified_desc" $'missing_param\nhigh\nlow' --sort-by=params.yaml:foo --sort-order desc
+
+
+
+
+run_ok "metric_unqualified_unique" $'low\nmissing_param\nhigh' --sort-by=score
+
+
+
+
+run_ok "param_unqualified_unique" $'low\nhigh\nmissing_param' --sort-by=alpha
+
+
+
+
+run_ok "colon_qualified" $'missing_param\nlow\nhigh' '--sort-by=metrics:1.json:my::metric'
+
+
+
+
+run_ok "leading_colon" $'high\nlow\nmissing_param' '--sort-by=:other_metric'
+
+
+
+
+run_err "unknown_column" --sort-by=missing
+
+grep -Eiq "(unknown.*sort column|sort column.*unknown)" "$TMP/unknown_column.err" \
+    || fail "unknown_column stderr: $(cat "$TMP/unknown_column.err")"
+grep -q "missing" "$TMP/unknown_column.err" \
+    || fail "unknown_column stderr: $(cat "$TMP/unknown_column.err")"
+
+
+
+
+run_err "ambiguous_column" --sort-by=foo
+
+grep -Eiq "(ambiguous.*sort column|sort column.*ambiguous)" "$TMP/ambiguous_column.err" \
+    || fail "ambiguous_column missing ambiguous error: $(cat "$TMP/ambiguous_column.err")"
+grep -q "foo" "$TMP/ambiguous_column.err" \
+    || fail "ambiguous_column missing requested name: $(cat "$TMP/ambiguous_column.err")"
+grep -q "metrics.yaml:foo" "$TMP/ambiguous_column.err" \
+    || fail "ambiguous_column missing metrics match: $(cat "$TMP/ambiguous_column.err")"
+grep -q "params.yaml:foo" "$TMP/ambiguous_column.err" \
+    || fail "ambiguous_column missing params match: $(cat "$TMP/ambiguous_column.err")"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
