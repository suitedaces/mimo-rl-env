+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+export GO111MODULE=off
+REPO_DIR="$(go env GOPATH)/src/github.com/rancher/rancher"
+cd "$REPO_DIR"
+
+
+go test ./pkg/node/ -run 'TestIsNodeForNode'
+
+
+go test ./pkg/node/ -run 'TestIsNodeUnreachable|TestShouldDeleteUnreachableNode'
