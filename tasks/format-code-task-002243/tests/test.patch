diff --git a/spec/features_contract.test.js b/spec/features_contract.test.js
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/spec/features_contract.test.js
@@ -0,0 +1,72 @@
+'use strict';
+
+const assert = require('assert');
+
+function freshFeatures() {
+  const modulePath = require.resolve('../src/features');
+  delete require.cache[modulePath];
+  return require('../src/features');
+}
+
+
+
+{
+  const features = freshFeatures();
+  features.setFeature('serverVersion', '2.1.5');
+  assert.strictEqual(features.getFeatures().serverVersion, '2.1.5');
+}
+
+
+
+{
+  const features = freshFeatures();
+  features.setFeature('schemas', { addField: true });
+  assert.deepStrictEqual(features.getFeatures().schemas, { addField: true });
+  features.setFeatureSwitch('schemas', false);
+  assert.ok(!Object.prototype.hasOwnProperty.call(features.getFeatures(), 'schemas'));
+  features.setFeatureSwitch('schemas', true);
+  assert.deepStrictEqual(features.getFeatures().schemas, { addField: true });
+
+  features.setFeatureSwitch('adapterInfo', false);
+  features.setFeature('adapterInfo', { name: 'mongo', retries: 2 });
+  assert.ok(!Object.prototype.hasOwnProperty.call(features.getFeatures(), 'adapterInfo'));
+  features.setFeatureSwitch('adapterInfo', true);
+  assert.deepStrictEqual(features.getFeatures().adapterInfo, { name: 'mongo', retries: 2 });
+}
+
+
+
+{
+  for (const value of [false, 0, null, {}]) {
+    const features = freshFeatures();
+    features.setFeature('sentinel', value);
+    assert.deepStrictEqual(features.getFeatures().sentinel, value);
+  }
+}
+
+
+
+{
+  const features = freshFeatures();
+  const input = { nested: { enabled: true }, list: ['a'] };
+  features.setFeature('push', input);
+  input.nested.enabled = false;
+  input.list.push('b');
+  const snapshot = features.getFeatures();
+  assert.deepStrictEqual(snapshot.push, { nested: { enabled: true }, list: ['a'] });
+  snapshot.push.nested.enabled = false;
+  snapshot.push.list.push('c');
+  assert.deepStrictEqual(features.getFeatures().push, { nested: { enabled: true }, list: ['a'] });
+  features.setFeature('push', { replacement: true });
+  assert.deepStrictEqual(features.getFeatures().push, { replacement: true });
+}
+
+
+
+{
+  const features = freshFeatures();
+  assert.throws(() => features.setFeatureSwitch('push', 'false'), TypeError);
+  assert.throws(() => features.setFeatureSwitch('push', 0), TypeError);
+}
+
+console.log('feature registry contract passed');
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
