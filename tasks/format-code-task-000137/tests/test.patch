+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+update-alternatives --set php /usr/bin/php7.4 2>/dev/null
+
+
+if [ ! -d /testbed/vendor ]; then
+    composer install --ignore-platform-reqs --no-interaction
+fi
+
+
+case "$1" in
+  base)
+    ./vendor/bin/phpunit --no-configuration --bootstrap ./autoload.php.dist \
+      src/Kunstmaan/GeneratorBundle/Tests/Helper/GeneratorUtilsTest.php
+    ;;
+  new)
+    ./vendor/bin/phpunit --no-configuration --bootstrap ./autoload.php.dist \
+      src/Kunstmaan/GeneratorBundle/Tests/Generator/DefaultSiteGeneratorTest.php
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
