--- /dev/null
+++ b/usercase-test-coderl/test_retry_state_feature.py
@@ -0,0 +1,283 @@
+
+
+
+
+
+
+
+
+
+
+import pytest
+
+from transitions import Machine, MachineError
+from transitions.extensions.states import Retry, add_state_features
+
+
+@add_state_features(Retry)
+class RetryMachine(Machine):
+    pass
+
+
+class RetryModel(object):
+    def __init__(self, name):
+        self.name = name
+        self.entered = []
+        self.failures = 0
+
+    def mark_work(self):
+        self.entered.append("work")
+
+    def note_failure(self):
+        self.failures += 1
+        self.to_failed()
+
+
+STATES = [
+    "idle",
+    {
+        "name": "work",
+        "retries": 2,
+        "on_failure": "note_failure",
+        "on_enter": "mark_work",
+    },
+    "failed",
+]
+
+TRANSITIONS = [
+    {"trigger": "start", "source": "idle", "dest": "work"},
+    {"trigger": "retry", "source": "work", "dest": "work"},
+    {"trigger": "reset", "source": "work", "dest": "idle"},
+]
+
+
+def build_machine(model=None, transitions=None):
+    return RetryMachine(
+        model=model,
+        states=STATES,
+        transitions=TRANSITIONS if transitions is None else transitions,
+        initial="idle",
+    )
+
+
+def test_retry_limit_invokes_failure_instead_of_normal_entry():
+
+
+
+    model = RetryModel("single")
+    build_machine(model)
+
+    assert model.state == "idle"
+    assert model.entered == []
+    assert model.failures == 0
+
+    assert model.start() is True
+    assert model.state == "work"
+    assert model.entered == ["work"]
+    assert model.failures == 0
+
+    assert model.retry() is True
+    assert model.state == "work"
+    assert model.entered == ["work", "work"]
+    assert model.failures == 0
+
+    assert model.retry() is True
+    assert model.state == "work"
+    assert model.entered == ["work", "work", "work"]
+    assert model.failures == 0
+
+    assert model.retry() is True
+    assert model.state == "failed"
+    assert model.entered == ["work", "work", "work"]
+    assert model.failures == 1
+
+
+def test_leaving_work_resets_retry_count_for_later_entry_from_other_source():
+
+
+
+    model = RetryModel("resetting")
+    build_machine(model)
+
+    model.start()
+    model.retry()
+    model.retry()
+    assert model.reset() is True
+    assert model.state == "idle"
+    assert model.entered == ["work", "work", "work"]
+    assert model.failures == 0
+
+    assert model.start() is True
+    assert model.state == "work"
+    assert model.entered == ["work", "work", "work", "work"]
+    assert model.failures == 0
+
+    model.retry()
+    model.retry()
+    model.retry()
+    assert model.state == "failed"
+    assert model.entered == ["work", "work", "work", "work", "work", "work"]
+    assert model.failures == 1
+
+
+def test_retry_counts_are_independent_for_two_models_on_same_machine():
+
+
+
+    first = RetryModel("first")
+    second = RetryModel("second")
+    build_machine([first, second])
+
+    first.start()
+    first.retry()
+    first.retry()
+    second.start()
+    assert first.state == "work"
+    assert first.entered == ["work", "work", "work"]
+    assert first.failures == 0
+    assert second.state == "work"
+    assert second.entered == ["work"]
+    assert second.failures == 0
+
+    first.retry()
+    assert first.state == "failed"
+    assert first.entered == ["work", "work", "work"]
+    assert first.failures == 1
+    assert second.state == "work"
+    assert second.entered == ["work"]
+    assert second.failures == 0
+
+    second.retry()
+    second.retry()
+    assert first.state == "failed"
+    assert first.entered == ["work", "work", "work"]
+    assert first.failures == 1
+    assert second.state == "work"
+    assert second.entered == ["work", "work", "work"]
+    assert second.failures == 0
+
+
+def test_positive_retries_require_on_failure_when_constructing_or_adding_state():
+
+
+
+    with pytest.raises(AttributeError) as constructed:
+        RetryMachine(
+            states=["idle", {"name": "work", "retries": 1}],
+            initial="idle",
+        )
+
+    constructed_message = str(constructed.value).lower()
+    assert "retry" in constructed_message
+    assert "on_failure" in constructed_message
+    assert "retries" in constructed_message
+
+    machine = RetryMachine(states=["idle"], initial="idle")
+    with pytest.raises(AttributeError) as added:
+        machine.add_states({"name": "work", "retries": 1})
+
+    added_message = str(added.value).lower()
+    assert "retry" in added_message
+    assert "on_failure" in added_message
+    assert "retries" in added_message
+
+
+def test_retry_before_entering_work_raises_specific_machine_error():
+
+
+
+    model = RetryModel("invalid-order")
+    build_machine(model)
+
+    with pytest.raises(MachineError) as raised:
+        model.retry()
+
+    assert raised.value is not None
+    assert model.state == "idle"
+    assert model.entered == []
+    assert model.failures == 0
+
+
+def test_two_machine_instances_do_not_share_retry_state():
+
+
+
+    first = RetryModel("first")
+    second = RetryModel("second")
+    build_machine(first)
+    build_machine(second)
+
+    first.start()
+    first.retry()
+    first.retry()
+
+    assert first.state == "work"
+    assert first.entered == ["work", "work", "work"]
+    assert first.failures == 0
+    assert second.state == "idle"
+    assert second.entered == []
+    assert second.failures == 0
+
+
+def test_repeated_leave_cleanup_keeps_retry_session_reusable():
+
+
+
+    model = RetryModel("cleanup")
+    transitions = [
+        {"trigger": "start", "source": "idle", "dest": "work"},
+        {"trigger": "retry", "source": "work", "dest": "work"},
+        {"trigger": "leave", "source": "*", "dest": "idle"},
+    ]
+    build_machine(model, transitions=transitions)
+
+    model.start()
+    assert model.state == "work"
+    assert model.entered == ["work"]
+    assert model.failures == 0
+
+    assert model.leave() is True
+    assert model.state == "idle"
+    assert model.entered == ["work"]
+    assert model.failures == 0
+
+    assert model.leave() is True
+    assert model.state == "idle"
+    assert model.entered == ["work"]
+    assert model.failures == 0
+
+    assert model.start() is True
+    assert model.state == "work"
+    assert model.entered == ["work", "work"]
+    assert model.failures == 0
+
+
+def test_retry_bookkeeping_stays_bounded_across_many_leave_and_reenter_cycles():
+
+
+
+    model = RetryModel("bounded")
+    build_machine(model)
+
+    for _ in range(120):
+        model.start()
+        model.retry()
+        model.retry()
+        model.reset()
+
+    assert model.state == "idle"
+    assert len(model.entered) == 360
+    assert model.failures == 0
+
+
+    assert model.start() is True
+    assert model.retry() is True
+    assert model.retry() is True
+    assert model.state == "work"
+    assert len(model.entered) == 363
+    assert model.failures == 0
+
+    assert model.retry() is True
+    assert model.state == "failed"
+    assert len(model.entered) == 363
+    assert model.failures == 1
