--- /dev/null
+++ b/usercase-test-coderl/mfa-method.test.ts
@@ -0,0 +1,287 @@
+import assert from 'node:assert/strict';
+import { describe, test } from 'node:test';
+import { MFAMethod } from '../app/src/lib/icloud/mfa/mfa-method';
+
+
+
+
+
+
+
+
+
+type MethodSnapshot = {
+    isDevice: boolean;
+    isSMS: boolean;
+    isVoice: boolean;
+    string: string;
+    resendURL: string;
+    resendPayload: unknown;
+    resend202: boolean;
+    resend200: boolean;
+    resend204: boolean;
+    enterURL: string;
+    enterPayload: unknown;
+    enter204: boolean;
+    enter200: boolean;
+    enter202: boolean;
+};
+
+const snapshot = (method: MFAMethod): MethodSnapshot => ({
+    isDevice: method.isDevice,
+    isSMS: method.isSMS,
+    isVoice: method.isVoice,
+    string: method.toString(),
+    resendURL: method.getResendURL(),
+    resendPayload: method.getResendPayload(),
+    resend202: method.resendSuccessful(202),
+    resend200: method.resendSuccessful(200),
+    resend204: method.resendSuccessful(204),
+    enterURL: method.getEnterURL(),
+    enterPayload: method.getEnterPayload('123456'),
+    enter204: method.enterSuccessful(204),
+    enter200: method.enterSuccessful(200),
+    enter202: method.enterSuccessful(202),
+});
+
+const deviceSnapshot: MethodSnapshot = {
+    isDevice: true,
+    isSMS: false,
+    isVoice: false,
+    string: '\'Device\'',
+    resendURL: 'https://idmsa.apple.com/appleauth/auth/verify/trusteddevice',
+    resendPayload: undefined,
+    resend202: true,
+    resend200: false,
+    resend204: false,
+    enterURL: 'https://idmsa.apple.com/appleauth/auth/verify/trusteddevice/securitycode',
+    enterPayload: { securityCode: { code: '123456' } },
+    enter204: true,
+    enter200: false,
+    enter202: false,
+};
+
+describe('MFAMethod acceptance behavior', () => {
+    test('default construction selects trusted device request details', () => {
+
+
+
+
+        const method = new MFAMethod();
+
+        assert.deepStrictEqual(snapshot(method), deviceSnapshot);
+    });
+
+    test('sms construction uses provided phone number id', () => {
+
+
+
+
+        const method = new MFAMethod('sms', 7);
+
+        assert.deepStrictEqual(snapshot(method), {
+            isDevice: false,
+            isSMS: true,
+            isVoice: false,
+            string: '\'SMS\' (Number ID: 7)',
+            resendURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone',
+            resendPayload: { phoneNumber: { id: 7 }, mode: 'sms' },
+            resend202: false,
+            resend200: true,
+            resend204: false,
+            enterURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone/securitycode',
+            enterPayload: { securityCode: { code: '123456' }, phoneNumber: { id: 7 }, mode: 'sms' },
+            enter204: false,
+            enter200: true,
+            enter202: false,
+        });
+    });
+
+    test('voice construction uses provided phone number id', () => {
+
+
+
+
+        const method = new MFAMethod('voice', 3);
+
+        assert.deepStrictEqual(snapshot(method), {
+            isDevice: false,
+            isSMS: false,
+            isVoice: true,
+            string: '\'Voice\' (Number ID: 3)',
+            resendURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone',
+            resendPayload: { phoneNumber: { id: 3 }, mode: 'voice' },
+            resend202: false,
+            resend200: true,
+            resend204: false,
+            enterURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone/securitycode',
+            enterPayload: { securityCode: { code: '123456' }, phoneNumber: { id: 3 }, mode: 'voice' },
+            enter204: false,
+            enter200: true,
+            enter202: false,
+        });
+    });
+
+    test('phone-based flows default to phone number id 1', () => {
+
+
+
+
+        const sms = new MFAMethod('sms');
+        const voice = new MFAMethod('voice');
+
+        assert.deepStrictEqual(snapshot(sms), {
+            isDevice: false,
+            isSMS: true,
+            isVoice: false,
+            string: '\'SMS\' (Number ID: 1)',
+            resendURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone',
+            resendPayload: { phoneNumber: { id: 1 }, mode: 'sms' },
+            resend202: false,
+            resend200: true,
+            resend204: false,
+            enterURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone/securitycode',
+            enterPayload: { securityCode: { code: '123456' }, phoneNumber: { id: 1 }, mode: 'sms' },
+            enter204: false,
+            enter200: true,
+            enter202: false,
+        });
+        assert.deepStrictEqual(snapshot(voice), {
+            isDevice: false,
+            isSMS: false,
+            isVoice: true,
+            string: '\'Voice\' (Number ID: 1)',
+            resendURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone',
+            resendPayload: { phoneNumber: { id: 1 }, mode: 'voice' },
+            resend202: false,
+            resend200: true,
+            resend204: false,
+            enterURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone/securitycode',
+            enterPayload: { securityCode: { code: '123456' }, phoneNumber: { id: 1 }, mode: 'voice' },
+            enter204: false,
+            enter200: true,
+            enter202: false,
+        });
+    });
+
+    test('update replaces all later getter and helper method state', () => {
+
+
+
+
+        const method = new MFAMethod('sms', 7);
+
+        assert.deepStrictEqual(snapshot(method), {
+            isDevice: false,
+            isSMS: true,
+            isVoice: false,
+            string: '\'SMS\' (Number ID: 7)',
+            resendURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone',
+            resendPayload: { phoneNumber: { id: 7 }, mode: 'sms' },
+            resend202: false,
+            resend200: true,
+            resend204: false,
+            enterURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone/securitycode',
+            enterPayload: { securityCode: { code: '123456' }, phoneNumber: { id: 7 }, mode: 'sms' },
+            enter204: false,
+            enter200: true,
+            enter202: false,
+        });
+
+        method.update('device');
+        assert.deepStrictEqual(snapshot(method), deviceSnapshot);
+
+        method.update('voice', 4);
+        assert.deepStrictEqual(snapshot(method), {
+            isDevice: false,
+            isSMS: false,
+            isVoice: true,
+            string: '\'Voice\' (Number ID: 4)',
+            resendURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone',
+            resendPayload: { phoneNumber: { id: 4 }, mode: 'voice' },
+            resend202: false,
+            resend200: true,
+            resend204: false,
+            enterURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone/securitycode',
+            enterPayload: { securityCode: { code: '123456' }, phoneNumber: { id: 4 }, mode: 'voice' },
+            enter204: false,
+            enter200: true,
+            enter202: false,
+        });
+    });
+
+    test('unknown method strings fall back to device state without throwing', () => {
+
+
+
+
+        const constructed = new MFAMethod('pager', 9);
+        const updated = new MFAMethod('sms', 7);
+
+        assert.deepStrictEqual(snapshot(constructed), deviceSnapshot);
+        assert.doesNotThrow(() => updated.update('email', 5));
+        assert.deepStrictEqual(snapshot(updated), deviceSnapshot);
+    });
+
+    test('separate instances keep independent mutable state', () => {
+
+
+
+
+        const a = new MFAMethod('sms', 7);
+        const b = new MFAMethod('voice', 3);
+
+        a.update('device');
+
+        assert.deepStrictEqual(snapshot(a), deviceSnapshot);
+        assert.deepStrictEqual(snapshot(b), {
+            isDevice: false,
+            isSMS: false,
+            isVoice: true,
+            string: '\'Voice\' (Number ID: 3)',
+            resendURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone',
+            resendPayload: { phoneNumber: { id: 3 }, mode: 'voice' },
+            resend202: false,
+            resend200: true,
+            resend204: false,
+            enterURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone/securitycode',
+            enterPayload: { securityCode: { code: '123456' }, phoneNumber: { id: 3 }, mode: 'voice' },
+            enter204: false,
+            enter200: true,
+            enter202: false,
+        });
+    });
+
+    test('construct-update cycles preserve per-instance observable state', () => {
+
+
+
+
+        for (let i = 0; i < 150; i += 1) {
+            const method = new MFAMethod('sms', 7);
+            const other = new MFAMethod('voice', 3);
+            assert.equal(method.toString(), '\'SMS\' (Number ID: 7)');
+            method.update('voice', 4);
+            assert.equal(method.toString(), '\'Voice\' (Number ID: 4)');
+            method.update('device');
+            assert.equal(method.toString(), '\'Device\'');
+
+            assert.deepStrictEqual(snapshot(other), {
+                isDevice: false,
+                isSMS: false,
+                isVoice: true,
+                string: '\'Voice\' (Number ID: 3)',
+                resendURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone',
+                resendPayload: { phoneNumber: { id: 3 }, mode: 'voice' },
+                resend202: false,
+                resend200: true,
+                resend204: false,
+                enterURL: 'https://idmsa.apple.com/appleauth/auth/verify/phone/securitycode',
+                enterPayload: { securityCode: { code: '123456' }, phoneNumber: { id: 3 }, mode: 'voice' },
+                enter204: false,
+                enter200: true,
+                enter202: false,
+            });
+        }
+    });
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo/app
+
+if [ ! -d node_modules ] || [ ! -f node_modules/tsx/dist/loader.mjs ]; then
+  echo "Required npm dependencies are missing from /workspace/repo/app/node_modules; refusing to install in offline test mode." >&2
+  exit 1
+fi
+
+SCHEMA_DIR=/workspace/repo/app/src/lib/resources/schemas
+mkdir -p "$SCHEMA_DIR"
+for schema in \
+  pcs-response \
+  photos-setup-response \
+  auth-information-response \
+  resend-mfa-device-response \
+  resend-mfa-phone-response \
+  resource-file \
+  push-subscription \
+  setup-response \
+  signin-init-response \
+  signin-response \
+  trust-response
+do
+  if [ ! -f "$SCHEMA_DIR/$schema.json" ]; then
+
+    printf '{"type":"object"}\n' > "$SCHEMA_DIR/$schema.json"
+  fi
+done
+
+exec node --import tsx --test /workspace/repo/usercase-test-coderl/mfa-method.test.ts
