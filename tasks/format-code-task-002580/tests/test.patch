diff --git a/test/pluck.js b/test/pluck.js
index 05c7062..10ce345 100644
--- a/test/pluck.js
+++ b/test/pluck.js
@@ -1,22 +1,47 @@
 'use strict';
 
+var assert = require('assert');
+
 var S = require('..');
 
 var eq = require('./internal/eq');
-var throws = require('./internal/throws');
 
 
 test('pluck', function() {
 
   eq(typeof S.pluck, 'function');
   eq(S.pluck.length, 2);
-  eq(S.pluck.toString(), 'pluck :: Accessible a => String -> Array a -> Array b');
-
-  throws(function() { S.pluck('a', [{a: 1}, {b: 2}]); },
-         TypeError,
-         '‘pluck’ expected object at index 1 to have a property named ‘a’; {"b": 2} does not');
+  eq(S.pluck.toString(), 'pluck :: (Accessible a, Functor f) => String -> f a -> f b');
 
+
   eq(S.pluck('x', []), []);
   eq(S.pluck('x', [{x: 1}, {x: 2}, {x: 3}]), [1, 2, 3]);
 
+
+
+  assert.throws(
+    function() { S.pluck('a', [{a: 1}, {b: 2}]); },
+    function(err) {
+      return err.constructor === TypeError &&
+             /property named ‘a’/.test(err.message) &&
+             /\{"b": 2\}/.test(err.message);
+    }
+  );
+
+
+  eq(S.pluck('x', S.Just({x: 1, y: 2, z: 3})), S.Just(1));
+
+
+  eq(S.pluck('x', S.Nothing), S.Nothing);
+
+
+  assert.throws(
+    function() { S.pluck('a', S.Just({b: 2})); },
+    function(err) {
+      return err.constructor === TypeError &&
+             /property named ‘a’/.test(err.message) &&
+             /\{"b": 2\}/.test(err.message);
+    }
+  );
+
 });
