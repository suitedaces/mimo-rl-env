+++ b/usercase-test-coderl/responsive-media.test.js
@@ -0,0 +1,397 @@
+'use strict';
+
+
+
+
+
+
+
+
+
+require('jsdom-global')('', { url: 'http://localhost/' });
+require('angular/angular');
+
+var expect = require('chai').expect;
+var angular = window.angular;
+
+global.angular = angular;
+require('angular-mocks/angular-mocks');
+
+var angularCssModuleName = require('/workspace/repo');
+
+function makeMatchMedia(initialMatches) {
+  var records = {};
+
+  function getRecord(query) {
+    if (!records[query]) {
+      records[query] = {
+        media: query,
+        matches: !!initialMatches[query],
+        listeners: [],
+        addListener: function addListener(listener) {
+          this.listeners.push(listener);
+        },
+        removeListener: function removeListener(listener) {
+          var index = this.listeners.indexOf(listener);
+          if (index !== -1) {
+            this.listeners.splice(index, 1);
+          }
+        },
+
+        addEventListener: function addEventListener(type, listener) {
+          if (type === 'change') {
+            this.addListener(listener);
+          }
+        },
+
+        removeEventListener: function removeEventListener(type, listener) {
+          if (type === 'change') {
+            this.removeListener(listener);
+          }
+        },
+        fire: function fire(matches) {
+          this.matches = matches;
+          this.listeners.slice().forEach(function notify(listener) {
+            listener(this);
+          }, this);
+          if (typeof this.onchange === 'function') {
+            this.onchange(this);
+          }
+        }
+      };
+    }
+    return records[query];
+  }
+
+  function matchMedia(query) {
+    return getRecord(query);
+  }
+
+  matchMedia.records = records;
+  matchMedia.get = getRecord;
+  return matchMedia;
+}
+
+function createHarness(options) {
+  options = options || {};
+  document.head.innerHTML = '';
+
+  if (options.matchMedia === false) {
+    delete window.matchMedia;
+  } else {
+    window.matchMedia = makeMatchMedia(options.matches || {});
+  }
+
+  var moduleName = 'usercaseResponsiveMedia' + createHarness.nextId++;
+  angular.module(moduleName, [angularCssModuleName]).config(['$cssProvider', function configure($cssProvider) {
+    if (options.breakpoints) {
+      $cssProvider.defaults.breakpoints = options.breakpoints;
+    }
+  }]);
+
+  var injector = angular.injector(['ng', 'ngMock', moduleName]);
+  var $css = injector.get('$css');
+  var $rootScope = injector.get('$rootScope');
+  var $timeout = injector.get('$timeout');
+
+  function flushAngular() {
+    try {
+      $timeout.flush();
+    } catch (error) {
+      if (!/No deferred tasks/.test(error.message)) {
+        throw error;
+      }
+    }
+    $rootScope.$digest();
+  }
+
+  flushAngular();
+
+  return {
+    $css: $css,
+    $rootScope: $rootScope,
+    matchMedia: window.matchMedia,
+    flushAngular: flushAngular
+  };
+}
+
+createHarness.nextId = 1;
+
+function renderedLinks() {
+  return Array.prototype.slice.call(document.querySelectorAll('link')).map(function mapLink(link) {
+    return {
+      href: link.getAttribute('href'),
+      media: link.getAttribute('media')
+    };
+  });
+}
+
+function listenerCount(query) {
+  return query.listeners.length + (typeof query.onchange === 'function' ? 1 : 0);
+}
+
+function totalListenerCount(matchMedia) {
+  return Object.keys(matchMedia.records).reduce(function sum(total, query) {
+    return total + listenerCount(matchMedia.records[query]);
+  }, 0);
+}
+
+describe('responsive media-query stylesheet loading', function () {
+  it('resolves a configured breakpoint and toggles the link when the MediaQueryList changes', function () {
+
+
+    var env = createHarness({
+      breakpoints: { mobile: '(max-width: 480px)' },
+      matches: { '(max-width: 480px)': false }
+    });
+    var query = env.matchMedia.get('(max-width: 480px)');
+
+
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(listenerCount(query)).to.equal(0);
+
+    env.$css.add({ href: 'mobile.css', breakpoint: 'mobile' });
+    env.flushAngular();
+
+
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(renderedLinks()).to.deep.equal([]);
+
+    expect(listenerCount(query)).to.be.greaterThan(0);
+
+    query.fire(true);
+    env.flushAngular();
+
+
+    expect(renderedLinks()).to.deep.equal([
+      { href: 'mobile.css', media: '(max-width: 480px)' }
+    ]);
+    expect(renderedLinks()).to.deep.equal([
+      { href: 'mobile.css', media: '(max-width: 480px)' }
+    ]);
+
+    expect(listenerCount(query)).to.be.greaterThan(0);
+
+    query.fire(false);
+    env.flushAngular();
+
+
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(renderedLinks()).to.deep.equal([]);
+
+    expect(listenerCount(query)).to.be.greaterThan(0);
+  });
+
+  it('uses a direct media query immediately when it matches and removes it when it stops matching', function () {
+
+
+    var env = createHarness({
+      matches: { '(min-width: 768px)': true }
+    });
+    var query = env.matchMedia.get('(min-width: 768px)');
+
+
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(listenerCount(query)).to.equal(0);
+
+    env.$css.add({ href: 'tablet.css', media: '(min-width: 768px)' });
+    env.flushAngular();
+
+
+    expect(renderedLinks()).to.deep.equal([
+      { href: 'tablet.css', media: '(min-width: 768px)' }
+    ]);
+    expect(renderedLinks()).to.deep.equal([
+      { href: 'tablet.css', media: '(min-width: 768px)' }
+    ]);
+
+    expect(listenerCount(query)).to.be.greaterThan(0);
+
+    query.fire(false);
+    env.flushAngular();
+
+
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(renderedLinks()).to.deep.equal([]);
+
+    expect(listenerCount(query)).to.be.greaterThan(0);
+  });
+
+  it('unregisters a direct media listener on remove and ignores later media changes', function () {
+
+
+    var env = createHarness({
+      matches: { '(min-width: 768px)': true }
+    });
+    var query = env.matchMedia.get('(min-width: 768px)');
+
+    env.$css.add({ href: 'tablet.css', media: '(min-width: 768px)' });
+    env.flushAngular();
+
+
+    expect(renderedLinks()).to.deep.equal([
+      { href: 'tablet.css', media: '(min-width: 768px)' }
+    ]);
+    expect(renderedLinks()).to.deep.equal([
+      { href: 'tablet.css', media: '(min-width: 768px)' }
+    ]);
+
+    expect(listenerCount(query)).to.be.greaterThan(0);
+
+    env.$css.remove({ href: 'tablet.css', media: '(min-width: 768px)' });
+    env.flushAngular();
+
+
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(listenerCount(query)).to.equal(0);
+
+    query.fire(false);
+    env.flushAngular();
+    query.fire(true);
+    env.flushAngular();
+
+
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(listenerCount(query)).to.equal(0);
+  });
+
+  it('falls back to normal stylesheet behavior for print media', function () {
+
+
+    var env = createHarness({ matches: {} });
+
+    env.$css.add({ href: 'print.css', media: 'print' });
+    env.flushAngular();
+
+
+    expect(renderedLinks()).to.deep.equal([
+      { href: 'print.css', media: 'print' }
+    ]);
+    expect(renderedLinks()).to.deep.equal([
+      { href: 'print.css', media: 'print' }
+    ]);
+
+    expect(totalListenerCount(env.matchMedia)).to.equal(0);
+  });
+
+  it('falls back to normal stylesheet behavior when matchMedia is unavailable', function () {
+
+
+    var env = createHarness({ matchMedia: false });
+
+    env.$css.add({ href: 'nomm.css', media: '(orientation: portrait)' });
+    env.flushAngular();
+
+
+    expect(renderedLinks()).to.deep.equal([
+      { href: 'nomm.css', media: '(orientation: portrait)' }
+    ]);
+    expect(renderedLinks()).to.deep.equal([
+      { href: 'nomm.css', media: '(orientation: portrait)' }
+    ]);
+    expect(typeof window.matchMedia).to.equal('undefined');
+  });
+
+  it('supports configured breakpoints from a freshly injected service instance', function () {
+
+
+
+    createHarness({
+      breakpoints: { mobile: '(max-width: 480px)' },
+      matches: { '(max-width: 480px)': true }
+    });
+
+    var b = createHarness({
+      breakpoints: { mobile: '(max-width: 480px)' },
+      matches: { '(max-width: 480px)': false }
+    });
+    var bQuery = b.matchMedia.get('(max-width: 480px)');
+
+    b.$css.add({ href: 'mobile-b.css', breakpoint: 'mobile' });
+    b.flushAngular();
+
+    expect(renderedLinks()).to.deep.equal([]);
+
+    expect(listenerCount(bQuery)).to.be.greaterThan(0);
+
+    bQuery.fire(true);
+    b.flushAngular();
+
+    expect(renderedLinks()).to.deep.equal([
+      { href: 'mobile-b.css', media: '(max-width: 480px)' }
+    ]);
+  });
+
+  it('unregisters a pending responsive listener when remove is called before a match', function () {
+
+
+
+    var env = createHarness({
+      matches: { '(min-width: 768px)': false }
+    });
+    var query = env.matchMedia.get('(min-width: 768px)');
+
+    env.$css.add({ href: 'tablet.css', media: '(min-width: 768px)' });
+    env.flushAngular();
+
+
+    expect(renderedLinks()).to.deep.equal([]);
+
+    expect(listenerCount(query)).to.be.greaterThan(0);
+
+    env.$css.remove({ href: 'tablet.css', media: '(min-width: 768px)' });
+    env.flushAngular();
+
+
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(listenerCount(query)).to.equal(0);
+
+    query.fire(true);
+    env.flushAngular();
+
+    expect(renderedLinks()).to.deep.equal([]);
+  });
+
+  it('keeps the media-query listener count bounded across repeated add and remove cycles', function () {
+
+
+    var env = createHarness({
+      matches: { '(min-width: 768px)': true }
+    });
+    var query = env.matchMedia.get('(min-width: 768px)');
+
+    expect(listenerCount(query)).to.equal(0);
+
+    for (var i = 0; i < 100; i++) {
+      env.$css.add({ href: 'tablet-' + i + '.css', media: '(min-width: 768px)' });
+      env.flushAngular();
+
+      expect(listenerCount(query)).to.be.greaterThan(0);
+
+      expect(renderedLinks()).to.deep.equal([
+        { href: 'tablet-' + i + '.css', media: '(min-width: 768px)' }
+      ]);
+
+      env.$css.remove({ href: 'tablet-' + i + '.css', media: '(min-width: 768px)' });
+      env.flushAngular();
+      expect(listenerCount(query)).to.equal(0);
+
+      expect(renderedLinks()).to.deep.equal([]);
+    }
+
+    query.fire(false);
+    env.flushAngular();
+    query.fire(true);
+    env.flushAngular();
+
+    expect(listenerCount(query)).to.equal(0);
+
+    expect(renderedLinks()).to.deep.equal([]);
+    expect(renderedLinks()).to.deep.equal([]);
+  });
+});
