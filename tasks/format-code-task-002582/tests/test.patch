+from collections import namedtuple
+
+import numpy as np
+
+
+Batch = namedtuple("Batch", ("state", "action", "mask", "next_state", "reward"))
+
+
+class Agent:
+    def __init__(
+        self,
+        env,
+        policy,
+        device,
+        custom_reward=None,
+        mean_action=False,
+        render=False,
+        running_state=None,
+        num_threads=1,
+    ):
+        self.env = env
+        self.policy = policy
+        self.device = device
+        self.custom_reward = custom_reward
+        self.mean_action = mean_action
+        self.render = render
+        self.running_state = running_state
+        self.num_threads = num_threads
+
+    def collect_samples(self, min_batch_size):
+        states = [
+            np.array([0.10, -0.20, 0.30, -0.40], dtype=np.float64),
+            np.array([0.20, 0.10, -0.10, 0.05], dtype=np.float64),
+            np.array([-0.30, 0.40, 0.20, -0.10], dtype=np.float64),
+            np.array([0.00, -0.10, 0.20, 0.30], dtype=np.float64),
+        ]
+        actions = [0, 1, 0, 1]
+        masks = [1.0, 1.0, 1.0, 0.0]
+        next_states = [
+            np.array([0.11, -0.19, 0.31, -0.39], dtype=np.float64),
+            np.array([0.21, 0.11, -0.09, 0.06], dtype=np.float64),
+            np.array([-0.29, 0.39, 0.21, -0.09], dtype=np.float64),
+            np.array([0.01, -0.09, 0.21, 0.31], dtype=np.float64),
+        ]
+        rewards = [1.0, 0.5, -0.25, 0.75]
+
+        batch = Batch(states, actions, masks, next_states, rewards)
+        log = {
+            "sample_time": 0.125,
+            "std_reward": 0.0,
+            "env_avg_reward": 5.0,
+            "num_steps": 4,
+            "num_episodes": 1,
+            "action_mean": np.array([0.5]),
+            "action_min": np.array([0]),
+            "action_max": np.array([1]),
+        }
+        return batch, log
