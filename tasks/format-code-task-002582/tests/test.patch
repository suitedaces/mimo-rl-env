+import numpy as np
+
+
+class _Space:
+    def __init__(self, shape, n=None):
+        self.shape = shape
+        self.n = n
+
+
+class _Env:
+    def __init__(self):
+        self.observation_space = _Space((4,))
+        self.action_space = _Space((), 2)
+        self._seed = None
+
+    def seed(self, seed):
+        self._seed = seed
+
+    def reset(self):
+        return np.zeros(4, dtype=np.float64)
+
+    def step(self, action):
+        return np.zeros(4, dtype=np.float64), 1.0, True, {}
+
+
+def make(name):
+    if name != "CartPole-v0":
+        raise ValueError("fixture only supports CartPole-v0")
+    return _Env()
