+import argparse
+import math
+import pickle
+from pathlib import Path
+
+import torch
+from tensorboard.backend.event_processing.event_accumulator import EventAccumulator
+
+from models.critic import Value
+from models.discrete_policy import DiscretePolicy
+
+
+def die(message):
+    raise SystemExit(message)
+
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--exp-name", required=True)
+args = parser.parse_args()
+
+base = Path("/workspace/repo/assets/learned_models") / args.exp_name
+run_dirs = sorted(base.glob("*-CartPole-v0"))
+if len(run_dirs) != 1:
+    die(f"{args.exp_name}: expected one CartPole run directory, found {len(run_dirs)}")
+run_dir = run_dirs[0]
+
+
+def load_pickle(name):
+    with open(run_dir / name, "rb") as handle:
+        return pickle.load(handle)
+
+
+def scalar_float(value, label):
+    if hasattr(value, "detach"):
+        value = value.detach().cpu().item()
+    try:
+        value = float(value)
+    except (TypeError, ValueError):
+        die(f"{args.exp_name}: {label} is not scalar numeric: {value!r}")
+    if not math.isfinite(value):
+        die(f"{args.exp_name}: {label} is not finite: {value!r}")
+    return value
+
+
+v_losses = load_pickle("true_v_loss_list.p")
+if len(v_losses) != 1:
+    die(f"{args.exp_name}: expected one value loss, found {len(v_losses)}")
+
+
+actual_v_loss = scalar_float(v_losses[0], "value loss")
+if actual_v_loss < 0.0:
+    die(f"{args.exp_name}: value loss should be non-negative, got {actual_v_loss!r}")
+
+p_losses = load_pickle("p_loss_list.p")
+if len(p_losses) != 1:
+    die(f"{args.exp_name}: expected one policy loss, found {len(p_losses)}")
+
+
+scalar_float(p_losses[0], "policy loss")
+
+exact_lists = {
+    "env_avg_reward.p": [5.0],
+    "eval_avg_R.p": [5.0],
+    "eval_avg_R_std.p": [0.0],
+    "num_of_steps.p": [4],
+    "num_of_episodes.p": [1],
+}
+for name, expected in exact_lists.items():
+    actual = load_pickle(name)
+    if actual != expected:
+        die(f"{args.exp_name}: {name} {actual!r} != {expected!r}")
+
+avg_reward = load_pickle("avg_reward.p")
+
+
+if not isinstance(avg_reward, list) or len(avg_reward) != 1:
+    die(f"{args.exp_name}: avg_reward.p should contain one entry, got {avg_reward!r}")
+
+policy, value, _running_state = load_pickle("model.p")
+
+
+def flat_params(model):
+    params = [param.detach().cpu().reshape(-1) for param in model.parameters()]
+    if not params:
+        die(f"{args.exp_name}: saved model has no parameters")
+    return torch.cat(params)
+
+
+policy_flat = flat_params(policy)
+value_flat = flat_params(value)
+torch.set_default_dtype(torch.float64)
+torch.manual_seed(7)
+initial_policy = DiscretePolicy(4, 2)
+initial_value = Value(4)
+initial_policy_flat = flat_params(initial_policy)
+initial_value_flat = flat_params(initial_value)
+
+
+
+if policy_flat.numel() == initial_policy_flat.numel() and torch.allclose(policy_flat, initial_policy_flat, rtol=1e-7, atol=1e-9):
+    die(f"{args.exp_name}: policy network was not mutated")
+if value_flat.numel() == initial_value_flat.numel() and torch.allclose(value_flat, initial_value_flat, rtol=1e-7, atol=1e-9):
+    die(f"{args.exp_name}: value network was not mutated")
+
+cost_event_dirs = sorted((run_dir / "runs" / "losses_cost_loss").glob("events.out.tfevents.*"))
+if len(cost_event_dirs) != 1:
+    die(f"{args.exp_name}: expected one cost-loss event file, found {len(cost_event_dirs)}")
+accumulator = EventAccumulator(str(cost_event_dirs[0]))
+accumulator.Reload()
+scalars = accumulator.Scalars("losses")
+actual_scalars = [(item.step, item.value) for item in scalars]
+if actual_scalars != [(0, 0.0)]:
+    die(f"{args.exp_name}: cost-loss scalars {actual_scalars!r} != [(0, 0.0)]")
