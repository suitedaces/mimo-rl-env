+def test_read_mosaic_no_trailing_slash_direct(app):
+    """GET /mosaicjson (no trailing slash) returns 200 directly (deprecated route)."""
+    response = app.get(
+        "/mosaicjson", params={"url": MOSAICJSON_FILE}, allow_redirects=False
+    )
+    assert response.status_code == 200
+    MosaicJSON(**response.json())
+
+
+def test_read_mosaic_trailing_slash_direct(app):
+    """GET /mosaicjson/ (with trailing slash) returns 200 directly (new route)."""
+    response = app.get(
+        "/mosaicjson/", params={"url": MOSAICJSON_FILE}, allow_redirects=False
+    )
+    assert response.status_code == 200
+    MosaicJSON(**response.json())
+
+
+def test_read_mosaic_openapi_deprecated(app):
+    """OpenAPI schema marks /mosaicjson (no slash) as deprecated and /mosaicjson/ as not deprecated."""
+    schema = app.get("/openapi.json").json()
+    assert "/mosaicjson" in schema["paths"]
+    assert "/mosaicjson/" in schema["paths"]
+    assert schema["paths"]["/mosaicjson"]["get"].get("deprecated") is True
+    assert not schema["paths"]["/mosaicjson/"]["get"].get("deprecated", False)
+
+
+def test_MosaicTilerFactory_has_both_read_routes():
+    """Factory router exposes both '' and '/' read routes (smooth deprecation transition)."""
+    from titiler.endpoints import factory
+
+    f = factory.MosaicTilerFactory()
+    read_paths = [r.path for r in f.router.routes if getattr(r, "name", "") == "read"]
+    assert "" in read_paths
+    assert "/" in read_paths
+
+
