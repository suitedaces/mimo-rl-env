+func TestCodespecLegacyNestedVolumeIDRemainsUsable(t *testing.T) {
+	tests := []struct {
+		name     string
+		volumeID string
+		wantID   string
+	}{
+		{name: "legacy slash ID with nested base", volumeID: "nfs.example/exports/team/source-pv", wantID: "nfs.example#exports/team#snap-safe#snap-safe#source-pv"},
+		{name: "compact three-field ID", volumeID: "nfs.example#exports/team#source-pv", wantID: "nfs.example#exports/team#snap-safe#snap-safe#source-pv"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			cs, _, _, workingDir := codespecConfinementServers(t)
+			sourcePath := filepath.Join(workingDir, "source-pv", "source-pv")
+			if err := os.MkdirAll(sourcePath, 0755); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(sourcePath, "payload"), []byte("compatible"), 0644); err != nil {
+				t.Fatal(err)
+			}
+			resp, err := cs.CreateSnapshot(context.Background(), &csi.CreateSnapshotRequest{
+				Name:           "snap-safe",
+				SourceVolumeId: tc.volumeID,
+			})
+			if err != nil {
+				t.Fatalf("valid volume ID was rejected: %v", err)
+			}
+			if got := resp.GetSnapshot().GetSnapshotId(); got != tc.wantID {
+				t.Fatalf("unexpected snapshot ID: got %q, want %q", got, tc.wantID)
+			}
+			if !resp.GetSnapshot().GetReadyToUse() {
+				t.Fatal("snapshot from valid volume ID is not ready")
+			}
+		})
+	}
+}
