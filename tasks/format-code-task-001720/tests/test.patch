+func TestCodespecCreateVolumeRejectsUnsafeGeneratedPaths(t *testing.T) {
+	tests := []struct {
+		name       string
+		volumeName string
+		parameters map[string]string
+	}{
+		{name: "unsafe default subdirectory", volumeName: "../escape", parameters: map[string]string{paramServer: "nfs.example", paramShare: "/exports"}},
+		{name: "delimiter in volume name", volumeName: "pv#other", parameters: map[string]string{paramServer: "nfs.example", paramShare: "/exports"}},
+		{name: "parent subdirectory", volumeName: "pv-safe", parameters: map[string]string{paramServer: "nfs.example", paramShare: "/exports", paramSubDir: "tenant/../escape"}},
+		{name: "absolute subdirectory", volumeName: "pv-safe", parameters: map[string]string{paramServer: "nfs.example", paramShare: "/exports", paramSubDir: "/escape"}},
+		{name: "unsafe metadata expansion", volumeName: "pv-safe", parameters: map[string]string{paramServer: "nfs.example", paramShare: "/exports", paramSubDir: "tenant/" + pvcNameMetadata + "/data", pvcNameKey: "../escape"}},
+		{name: "unsafe share", volumeName: "pv-safe", parameters: map[string]string{paramServer: "nfs.example", paramShare: "/exports/../private", paramSubDir: "data"}},
+		{name: "delimiter in server", volumeName: "pv-safe", parameters: map[string]string{paramServer: "nfs.example#other", paramShare: "/exports", paramSubDir: "data"}},
+		{name: "delimiter in share", volumeName: "pv-safe", parameters: map[string]string{paramServer: "nfs.example", paramShare: "/exports#other", paramSubDir: "data"}},
+		{name: "delimiter in subdirectory", volumeName: "pv-safe", parameters: map[string]string{paramServer: "nfs.example", paramShare: "/exports", paramSubDir: "data#other"}},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			cs, _, mounter, workingDir := codespecConfinementServers(t)
+			_, err := cs.CreateVolume(context.Background(), &csi.CreateVolumeRequest{
+				Name:               tc.volumeName,
+				Parameters:         tc.parameters,
+				VolumeCapabilities: []*csi.VolumeCapability{codespecMountCapability()},
+			})
+			codespecAssertCode(t, err, codes.InvalidArgument)
+			codespecAssertNoControllerSideEffects(t, mounter, workingDir)
+		})
+	}
+}
