+func TestCodespecUnsafeDeleteIDsStayIdempotentWithoutSideEffects(t *testing.T) {
+	t.Run("volumes", func(t *testing.T) {
+		ids := []string{
+			"nfs.example#exports###delete",
+			"nfs.example#exports#../sentinel#safe#delete",
+			"nfs.example#exports#data#../safe#delete",
+			"nfs.example#exports/../private#data#safe#delete",
+			"nfs.example#exports#data#.#delete",
+			"nfs.example#exports#data#safe#delete#extra",
+			"nfs.example/exports/.",
+		}
+		for _, id := range ids {
+			t.Run(id, func(t *testing.T) {
+				cs, _, mounter, workingDir := codespecConfinementServers(t)
+				if err := os.MkdirAll(filepath.Join(workingDir, "sentinel"), 0755); err != nil {
+					t.Fatal(err)
+				}
+				mounter.ResetLog()
+				resp, err := cs.DeleteVolume(context.Background(), &csi.DeleteVolumeRequest{VolumeId: id})
+				if err != nil || resp == nil {
+					t.Fatalf("unsafe delete was not idempotent: resp=%v err=%v", resp, err)
+				}
+				if actions := mounter.GetLog(); len(actions) != 0 {
+					t.Fatalf("unsafe volume ID reached the mounter: %+v", actions)
+				}
+				if _, statErr := os.Stat(filepath.Join(workingDir, "sentinel")); statErr != nil {
+					t.Fatalf("unsafe volume ID changed local data: %v", statErr)
+				}
+			})
+		}
+	})
+
+	t.Run("snapshots", func(t *testing.T) {
+		ids := []string{
+			"nfs.example#exports###source-pv",
+			"nfs.example#exports#snap-safe#snap-safe#",
+			"nfs.example#exports#snap-safe#different-path#source-pv",
+			"nfs.example#exports#snap-safe#snap-safe#../source-pv",
+			"nfs.example#exports#.#.#source-pv",
+		}
+		for _, id := range ids {
+			t.Run(id, func(t *testing.T) {
+				cs, _, mounter, workingDir := codespecConfinementServers(t)
+				if err := os.MkdirAll(filepath.Join(workingDir, "sentinel"), 0755); err != nil {
+					t.Fatal(err)
+				}
+				mounter.ResetLog()
+				resp, err := cs.DeleteSnapshot(context.Background(), &csi.DeleteSnapshotRequest{SnapshotId: id})
+				if err != nil || resp == nil {
+					t.Fatalf("unsafe delete was not idempotent: resp=%v err=%v", resp, err)
+				}
+				if actions := mounter.GetLog(); len(actions) != 0 {
+					t.Fatalf("unsafe snapshot ID reached the mounter: %+v", actions)
+				}
+				if _, statErr := os.Stat(filepath.Join(workingDir, "sentinel")); statErr != nil {
+					t.Fatalf("unsafe snapshot ID changed local data: %v", statErr)
+				}
+			})
+		}
+	})
+
+	cs, _, mounter, workingDir := codespecConfinementServers(t)
+	resp, err := cs.DeleteVolume(context.Background(), &csi.DeleteVolumeRequest{VolumeId: "malformed-id"})
+	if err != nil || resp == nil {
+		t.Fatalf("malformed delete compatibility changed: resp=%v err=%v", resp, err)
+	}
+	codespecAssertNoControllerSideEffects(t, mounter, workingDir)
+}
