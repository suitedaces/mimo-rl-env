+func codespecConfinementServers(t *testing.T) (*ControllerServer, *NodeServer, *mount.FakeMounter, string) {
+	t.Helper()
+	workingDir := t.TempDir()
+	mounter := mount.NewFakeMounter(nil)
+	driver := NewDriver(&DriverOptions{
+		DriverName:            DefaultDriverName,
+		WorkingMountDir:       workingDir,
+		MountPermissions:      0755,
+		DefaultOnDeletePolicy: delete,
+	})
+	ns := NewNodeServer(driver, mounter)
+	driver.ns = ns
+	return NewControllerServer(driver), ns, mounter, workingDir
+}
+
+func codespecMountCapability() *csi.VolumeCapability {
+	return &csi.VolumeCapability{
+		AccessType: &csi.VolumeCapability_Mount{Mount: &csi.VolumeCapability_MountVolume{}},
+		AccessMode: &csi.VolumeCapability_AccessMode{
+			Mode: csi.VolumeCapability_AccessMode_MULTI_NODE_MULTI_WRITER,
+		},
+	}
+}
+
+func codespecAssertNoControllerSideEffects(t *testing.T, mounter *mount.FakeMounter, workingDir string) {
+	t.Helper()
+	if actions := mounter.GetLog(); len(actions) != 0 {
+		t.Fatalf("request reached the mounter: %+v", actions)
+	}
+	entries, err := os.ReadDir(workingDir)
+	if err != nil {
+		t.Fatalf("working directory was changed or removed: %v", err)
+	}
+	if len(entries) != 0 {
+		t.Fatalf("working directory was populated: %v", entries)
+	}
+}
+
+func codespecAssertCode(t *testing.T, err error, want codes.Code) {
+	t.Helper()
+	if got := status.Code(err); got != want {
+		t.Fatalf("unexpected gRPC result: got %v (%v), want %v", got, err, want)
+	}
+}
