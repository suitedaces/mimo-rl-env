+func TestCodespecNodePublishConfinesShareAndSubDir(t *testing.T) {
+	tests := []struct {
+		name    string
+		context map[string]string
+	}{
+		{name: "parent subdirectory", context: map[string]string{paramServer: "nfs.example", paramShare: "/exports", paramSubDir: "tenant/../private"}},
+		{name: "absolute subdirectory", context: map[string]string{paramServer: "nfs.example", paramShare: "/exports", paramSubDir: "/private"}},
+		{name: "dot component", context: map[string]string{paramServer: "nfs.example", paramShare: "/exports", paramSubDir: "tenant/./private"}},
+		{name: "unsafe substituted metadata", context: map[string]string{paramServer: "nfs.example", paramShare: "/exports", paramSubDir: "tenant/" + pvcNamespaceMetadata + "/data", pvcNamespaceKey: "../private"}},
+		{name: "parent share component", context: map[string]string{paramServer: "nfs.example", paramShare: "/exports/../private", paramSubDir: "data"}},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			_, ns, mounter, _ := codespecConfinementServers(t)
+			target := filepath.Join(t.TempDir(), "target")
+			_, err := ns.NodePublishVolume(context.Background(), &csi.NodePublishVolumeRequest{
+				VolumeId:         "volume-safe",
+				TargetPath:       target,
+				VolumeContext:    tc.context,
+				VolumeCapability: codespecMountCapability(),
+			})
+			codespecAssertCode(t, err, codes.InvalidArgument)
+			if actions := mounter.GetLog(); len(actions) != 0 {
+				t.Fatalf("invalid publish reached the mounter: %+v", actions)
+			}
+			if _, statErr := os.Stat(target); !os.IsNotExist(statErr) {
+				t.Fatalf("invalid publish created its target: %v", statErr)
+			}
+		})
+	}
+}
