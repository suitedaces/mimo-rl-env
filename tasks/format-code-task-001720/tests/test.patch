+func TestCodespecCreateVolumePreservesSafeNestedSubDir(t *testing.T) {
+	cs, _, mounter, _ := codespecConfinementServers(t)
+	resp, err := cs.CreateVolume(context.Background(), &csi.CreateVolumeRequest{
+		Name: "pv-safe",
+		Parameters: map[string]string{
+			paramServer: "nfs.example",
+			paramShare:  "/exports/team/",
+			paramSubDir: "tenant/project/.data",
+		},
+		VolumeCapabilities: []*csi.VolumeCapability{codespecMountCapability()},
+	})
+	if err != nil {
+		t.Fatalf("safe nested provisioning failed: %v", err)
+	}
+	if got, want := resp.GetVolume().GetVolumeId(), "nfs.example#exports/team#tenant/project/.data#pv-safe#"; got != want {
+		t.Fatalf("unexpected volume ID: got %q, want %q", got, want)
+	}
+	if got := resp.GetVolume().GetVolumeContext()[paramSubDir]; got != "tenant/project/.data" {
+		t.Fatalf("nested subdirectory changed: got %q", got)
+	}
+	found := false
+	for _, action := range mounter.GetLog() {
+		if action.Action == mount.FakeActionMount && (action.Source == "nfs.example:/exports/team" || action.Source == "nfs.example:/exports/team/") {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("safe share was not mounted; actions: %+v", mounter.GetLog())
+	}
+}
