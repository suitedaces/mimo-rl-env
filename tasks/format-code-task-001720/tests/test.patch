+func TestCodespecNodePublishAllowsSafeNestedSubDir(t *testing.T) {
+	tests := []struct {
+		name       string
+		share      string
+		subDir     string
+		wantSource string
+	}{
+		{name: "nested export and subdirectory", share: "/exports/team/", subDir: "tenant/project/.data", wantSource: "[2001:db8::1]:/exports/team/tenant/project/.data"},
+		{name: "root export", share: "/", subDir: "tenant/data", wantSource: "[2001:db8::1]:/tenant/data"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			_, ns, mounter, _ := codespecConfinementServers(t)
+			target := filepath.Join(t.TempDir(), "target")
+			_, err := ns.NodePublishVolume(context.Background(), &csi.NodePublishVolumeRequest{
+				VolumeId:   "volume-safe",
+				TargetPath: target,
+				VolumeContext: map[string]string{
+					paramServer: "2001:db8::1",
+					paramShare:  tc.share,
+					paramSubDir: tc.subDir,
+				},
+				VolumeCapability: codespecMountCapability(),
+			})
+			if err != nil {
+				t.Fatalf("safe nested publish failed: %v", err)
+			}
+			found := false
+			for _, action := range mounter.GetLog() {
+				if action.Action == mount.FakeActionMount && action.Source == tc.wantSource && action.Target == target {
+					found = true
+				}
+			}
+			if !found {
+				t.Fatalf("safe source was not mounted; actions: %+v", mounter.GetLog())
+			}
+		})
+	}
+}
