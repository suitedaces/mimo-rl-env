diff --git a/tests/test_codespec_progress_telemetry.py b/tests/test_codespec_progress_telemetry.py
new file mode 100644
index 00000000..6788a502
--- /dev/null
+++ b/tests/test_codespec_progress_telemetry.py
@@ -0,0 +1,143 @@
+import io
+from typing import Tuple
+
+import pytest
+
+from rich.console import Console
+from rich.progress import Progress
+
+
+class Clock:
+    def __init__(self) -> None:
+        self.value = 0.0
+
+    def __call__(self) -> float:
+        return self.value
+
+
+def make_progress(clock: Clock, *, total: float = 100.0) -> Tuple[Progress, int]:
+    progress = Progress(
+        console=Console(file=io.StringIO()),
+        get_time=clock,
+        auto_refresh=False,
+        speed_estimate_period=30.0,
+    )
+    return progress, progress.add_task("work", total=total)
+
+
+def test_speed_includes_every_positive_increment() -> None:
+    clock = Clock()
+    progress, task_id = make_progress(clock)
+
+    clock.value = 2.0
+    progress.advance(task_id, 2)
+    clock.value = 5.0
+    progress.advance(task_id, 4)
+
+
+    assert progress.tasks[task_id].speed == 2.0
+
+
+def test_absolute_completed_updates_feed_the_same_rate_estimator() -> None:
+    clock = Clock()
+    progress, task_id = make_progress(clock)
+
+    clock.value = 1.0
+    progress.update(task_id, completed=2)
+    clock.value = 4.0
+    progress.update(task_id, completed=8)
+
+    assert progress.tasks[task_id].speed == pytest.approx(8 / 3)
+
+
+def test_non_positive_advance_does_not_create_progress() -> None:
+    clock = Clock()
+    progress, task_id = make_progress(clock)
+
+    clock.value = 1.0
+    progress.advance(task_id, 5)
+    clock.value = 2.0
+    progress.advance(task_id, 0)
+    clock.value = 3.0
+    progress.advance(task_id, -2)
+    clock.value = 5.0
+    progress.advance(task_id, 5)
+
+
+    assert progress.tasks[task_id].completed == 8
+    assert progress.tasks[task_id].speed == 2.5
+
+
+def test_time_remaining_uses_the_observed_speed() -> None:
+    clock = Clock()
+    progress, task_id = make_progress(clock, total=20)
+
+    clock.value = 2.0
+    progress.advance(task_id, 4)
+    clock.value = 6.0
+    progress.advance(task_id, 4)
+
+    task = progress.tasks[task_id]
+    assert task.speed == 2.0
+    assert task.time_remaining == 6
+
+
+def test_completion_via_update_records_and_freezes_finished_speed() -> None:
+    clock = Clock()
+    progress, task_id = make_progress(clock, total=10)
+
+    clock.value = 1.0
+    progress.update(task_id, completed=4)
+    clock.value = 3.0
+    progress.update(task_id, completed=10)
+    task = progress.tasks[task_id]
+
+    assert task.finished
+    assert task.finished_speed == 5.0
+    finished_time = task.finished_time
+
+    clock.value = 20.0
+    progress.update(task_id, advance=1)
+    assert task.finished_time == finished_time
+    assert task.finished_speed == 5.0
+
+
+def test_reset_clears_old_speed_samples() -> None:
+    clock = Clock()
+    progress, task_id = make_progress(clock, total=20)
+
+    clock.value = 1.0
+    progress.advance(task_id, 4)
+    clock.value = 3.0
+    progress.advance(task_id, 4)
+    assert progress.tasks[task_id].speed == 4.0
+
+    progress.reset(task_id, total=20)
+    assert progress.tasks[task_id].speed is None
+    assert progress.tasks[task_id].finished_speed is None
+
+
+def test_changing_total_invalidates_old_speed_samples() -> None:
+    clock = Clock()
+    progress, task_id = make_progress(clock, total=50)
+
+    clock.value = 1.0
+    progress.advance(task_id, 4)
+    clock.value = 3.0
+    progress.advance(task_id, 4)
+    assert progress.tasks[task_id].speed == 4.0
+
+    progress.update(task_id, total=80)
+    assert progress.tasks[task_id].speed is None
+
+
+def test_new_samples_after_reset_are_used_for_speed() -> None:
+    clock = Clock()
+    progress, task_id = make_progress(clock, total=20)
+    progress.reset(task_id)
+
+    clock.value = 4.0
+    progress.advance(task_id, 2)
+    clock.value = 6.0
+    progress.advance(task_id, 2)
+    assert progress.tasks[task_id].speed == 2.0
