@@ -0,0 +1,89 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export AEROSPIKE_HOST="${AEROSPIKE_HOST:-127.0.0.1}"
+export AEROSPIKE_PORT="${AEROSPIKE_PORT:-3000}"
+export GOPROXY=off
+export GOSUMDB=off
+export GOTOOLCHAIN=local
+export GOFLAGS="-mod=mod"
+unset AEROSPIKE_CLIENT_CONFIG_URL
+
+if ! (exec 3<>"/dev/tcp/${AEROSPIKE_HOST}/${AEROSPIKE_PORT}") >/dev/null 2>&1; then
+  work=/tmp/aerospike-fixture-coderl
+  root=/opt/aerospike-stage3-coderl/root
+  mkdir -p "${work}/work/smd" "${work}/udf/lua"
+
+  if [ ! -x "${root}/usr/bin/asd" ]; then
+    echo "missing staged Aerospike server at ${root}/usr/bin/asd" >&2
+    exit 1
+  fi
+
+  cat > "${work}/aerospike.conf" <<EOF
+service {
+  proto-fd-max 15000
+  cluster-name fixture-coderl
+  work-directory ${work}/work
+}
+logging {
+  file ${work}/aerospike.log {
+    context any warning
+  }
+}
+network {
+  service {
+    address ${AEROSPIKE_HOST}
+    port ${AEROSPIKE_PORT}
+  }
+  heartbeat {
+    mode mesh
+    address ${AEROSPIKE_HOST}
+    port 3002
+    interval 150
+    timeout 10
+  }
+  fabric {
+    address ${AEROSPIKE_HOST}
+    port 3001
+  }
+  admin {
+    address ${AEROSPIKE_HOST}
+    port 3003
+  }
+}
+namespace test {
+  replication-factor 1
+  storage-engine memory {
+    data-size 512M
+  }
+}
+mod-lua {
+  user-path ${work}/udf/lua
+}
+EOF
+
+  "${root}/usr/bin/asd" --foreground --config-file "${work}/aerospike.conf" &
+  asd_pid=$!
+  trap 'kill "${asd_pid}" >/dev/null 2>&1 || true; wait "${asd_pid}" >/dev/null 2>&1 || true' EXIT
+
+  for _ in $(seq 1 100); do
+    if (exec 3<>"/dev/tcp/${AEROSPIKE_HOST}/${AEROSPIKE_PORT}") >/dev/null 2>&1; then
+      break
+    fi
+    sleep 0.2
+  done
+fi
+
+go test -v -count=1 ./usercase-test-coderl/...
