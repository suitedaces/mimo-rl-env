diff --git a/nilearn/glm/tests/test_first_level.py b/nilearn/glm/tests/test_first_level.py
index 82582e366..696040e39 100644
--- a/nilearn/glm/tests/test_first_level.py
+++ b/nilearn/glm/tests/test_first_level.py
@@ -630,3 +630,68 @@ def test_first_level_predictions_r_square():
 
     r_square_2d = model.masker_.transform(r_square_3d)
     assert_array_less(0., r_square_2d)
+
+
+def test_fit_warns_when_design_matrices_and_confounds():
+    """User provides design_matrices and confounds together: must warn that
+    confounds will be ignored."""
+    shapes, rk = [(7, 8, 9, 15)], 3
+    mask, fmri_data, design_matrices = generate_fake_fmri_data_and_design(
+        shapes, rk)
+    confounds = pd.DataFrame({'conf1': np.zeros(15)})
+    with pytest.warns(UserWarning, match='ignored'):
+        FirstLevelModel(mask_img=None).fit(
+            fmri_data[0],
+            confounds=confounds,
+            design_matrices=design_matrices[0])
+
+
+def test_fit_warns_when_design_matrices_and_events():
+    """User provides design_matrices and events together: must warn that
+    events will be ignored. This is the discriminating case that
+    candidate fixes which only check for confounds will fail."""
+    shapes, rk = [(7, 8, 9, 15)], 3
+    mask, fmri_data, design_matrices = generate_fake_fmri_data_and_design(
+        shapes, rk)
+    events = pd.DataFrame({'trial_type': ['a', 'b'],
+                           'onset': [0.0, 1.0],
+                           'duration': [1.0, 1.0]})
+    with pytest.warns(UserWarning, match='ignored'):
+        FirstLevelModel(mask_img=None).fit(
+            fmri_data[0],
+            events=events,
+            design_matrices=design_matrices[0])
+
+
+def test_fit_warns_when_design_matrices_with_both_events_and_confounds():
+    """User provides all three: must warn that confounds and events
+    will be ignored."""
+    shapes, rk = [(7, 8, 9, 15)], 3
+    mask, fmri_data, design_matrices = generate_fake_fmri_data_and_design(
+        shapes, rk)
+    events = pd.DataFrame({'trial_type': ['a', 'b'],
+                           'onset': [0.0, 1.0],
+                           'duration': [1.0, 1.0]})
+    confounds = pd.DataFrame({'conf1': np.zeros(15)})
+    with pytest.warns(UserWarning, match='ignored'):
+        FirstLevelModel(mask_img=None).fit(
+            fmri_data[0],
+            events=events,
+            confounds=confounds,
+            design_matrices=design_matrices[0])
+
+
+def test_fit_no_ignored_warning_when_only_design_matrices():
+    """Preservation: user provides only design_matrices (no events,
+    no confounds) — no 'ignored' warning should be emitted."""
+    shapes, rk = [(7, 8, 9, 15)], 3
+    mask, fmri_data, design_matrices = generate_fake_fmri_data_and_design(
+        shapes, rk)
+    with warnings.catch_warnings(record=True) as record:
+        warnings.simplefilter('always')
+        FirstLevelModel(mask_img=None).fit(
+            fmri_data[0],
+            design_matrices=design_matrices[0])
+    assert not any('ignored' in str(w.message).lower() for w in record), (
+        "No 'ignored' warning should be emitted when only design_matrices "
+        "is provided.")
