+func newResourceLogsWithAttrs(resourceAttrs map[string]interface{}, logAttrs map[string]interface{}) pdata.Logs {
+	logs := pdata.NewLogs()
+	logs.ResourceLogs().Resize(1)
+	rl := logs.ResourceLogs().At(0)
+	for k, v := range resourceAttrs {
+		switch val := v.(type) {
+		case string:
+			rl.Resource().Attributes().InsertString(k, val)
+		case int:
+			rl.Resource().Attributes().InsertInt(k, int64(val))
+		case float64:
+			rl.Resource().Attributes().InsertDouble(k, val)
+		case bool:
+			rl.Resource().Attributes().InsertBool(k, val)
+		}
+	}
+	rl.InstrumentationLibraryLogs().Resize(1)
+	ill := rl.InstrumentationLibraryLogs().At(0)
+	logRecord := pdata.NewLogRecord()
+	logRecord.Body().SetStringVal("mylog")
+	logRecord.SetTimestamp(pdata.Timestamp(123))
+	for k, v := range logAttrs {
+		switch val := v.(type) {
+		case string:
+			logRecord.Attributes().InsertString(k, val)
+		}
+	}
+	ill.Logs().Append(logRecord)
+	return logs
+}
