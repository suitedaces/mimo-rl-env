+func captureSplunkEvents(t *testing.T, c *client, logs pdata.Logs) []*splunk.Event {
+	t.Helper()
+	var captured []byte
+	send := func(_ context.Context, buf *bytes.Buffer) error {
+		captured = append(captured, buf.Bytes()...)
+		return nil
+	}
+	err := c.pushLogDataInBatches(context.Background(), logs, send)
+	require.NoError(t, err)
+
+	events := []*splunk.Event{}
+	for _, part := range strings.Split(string(captured), "\r\n\r\n") {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			continue
+		}
+		dec := json.NewDecoder(strings.NewReader(part))
+		for {
+			var ev splunk.Event
+			if err := dec.Decode(&ev); err != nil {
+				break
+			}
+			events = append(events, &ev)
+		}
+	}
+	return events
+}
