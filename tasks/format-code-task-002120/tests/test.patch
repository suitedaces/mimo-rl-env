+func Test_pushLogData_IssueReproScenario(t *testing.T) {
+	cfg := NewFactory().CreateDefaultConfig().(*Config)
+	c := newTestClient(cfg)
+
+	resAttrs := map[string]interface{}{
+		"k8spoduid":                              "eda0a956-99ec-49cb-a954-d733e2f881dd",
+		"k8s.pod.annotations.splunk.com/index":   "test",
+		"k8s.pod.name":                           "loggen-zjklf",
+		"k8s.namespace.name":                     "default",
+		"k8s.pod.startTime":                      "2021-03-20 00:03:32 +0000 UTC",
+		"k8s.pod.uid":                            "eda0a956-99ec-49cb-a954-d733e2f881dd",
+		"k8s.node.name":                          "ip-192-168-82-91.us-west-1.compute.internal",
+		"k8s.pod.labels.hello":                   "loggen",
+		"k8s.pod.labels.app":                     "loggen",
+	}
+	logAttrs := map[string]interface{}{
+		"k8s.pod.uid":        "eda0a956-99ec-49cb-a954-d733e2f881dd",
+		"run_id":             "0",
+		"stream":             "stdout",
+		"k8s.container.name": "loggen",
+		"k8s.namespace.name": "default",
+		"k8s.pod.name":       "loggen-zjklf",
+	}
+	logs := newResourceLogsWithAttrs(resAttrs, logAttrs)
+
+	events := captureSplunkEvents(t, c, logs)
+	require.Len(t, events, 1)
+	ev := events[0]
+
+	assert.Equal(t, "ip-192-168-82-91.us-west-1.compute.internal", ev.Fields["k8s.node.name"])
+	assert.Equal(t, "loggen", ev.Fields["k8s.pod.labels.hello"])
+	assert.Equal(t, "loggen", ev.Fields["k8s.pod.labels.app"])
+	assert.Equal(t, "test", ev.Fields["k8s.pod.annotations.splunk.com/index"])
+	assert.Equal(t, "2021-03-20 00:03:32 +0000 UTC", ev.Fields["k8s.pod.startTime"])
+	assert.Equal(t, "eda0a956-99ec-49cb-a954-d733e2f881dd", ev.Fields["k8spoduid"])
+
+	assert.Equal(t, "0", ev.Fields["run_id"])
+	assert.Equal(t, "stdout", ev.Fields["stream"])
+	assert.Equal(t, "loggen", ev.Fields["k8s.container.name"])
+}
