+import os
+
+import pytest
+
+from pyftpdlib.authorizers import DummyAuthorizer
+from pyftpdlib.exceptions import AuthenticationFailed
+
+
+
+
+HOME = "/workspace/repo/usercase-test-coderl/fixtures/stateful_authorizer/home"
+SUBDIR = (
+    "/workspace/repo/usercase-test-coderl/fixtures/stateful_authorizer/home/sub"
+)
+NESTED = (
+    "/workspace/repo/usercase-test-coderl/fixtures/stateful_authorizer/home/sub/"
+    "nested"
+)
+DIRECT_FILE = (
+    "/workspace/repo/usercase-test-coderl/fixtures/stateful_authorizer/home/sub/"
+    "file.txt"
+)
+NESTED_FILE = (
+    "/workspace/repo/usercase-test-coderl/fixtures/stateful_authorizer/home/sub/"
+    "nested/deep.txt"
+)
+HOME_FILE = (
+    "/workspace/repo/usercase-test-coderl/fixtures/stateful_authorizer/home/"
+    "home-file.txt"
+)
+OUTSIDE = (
+    "/workspace/repo/usercase-test-coderl/fixtures/stateful_authorizer/outside"
+)
+MISSING_HOME = (
+    "/workspace/repo/usercase-test-coderl/fixtures/stateful_authorizer/missing-home"
+)
+MISSING_INSIDE_HOME = (
+    "/workspace/repo/usercase-test-coderl/fixtures/stateful_authorizer/home/"
+    "missing-dir"
+)
+
+
+@pytest.fixture(autouse=True)
+def authorizer_fixture_tree():
+    os.makedirs(NESTED, exist_ok=True)
+    os.makedirs(OUTSIDE, exist_ok=True)
+    for path in (DIRECT_FILE, NESTED_FILE, HOME_FILE):
+        with open(path, "w", encoding="utf8") as file:
+            file.write("fixture\n")
+    if os.path.exists(MISSING_HOME):
+        raise AssertionError(f"unexpected fixture path exists: {MISSING_HOME}")
+    if os.path.exists(MISSING_INSIDE_HOME):
+        raise AssertionError(
+            f"unexpected fixture path exists: {MISSING_INSIDE_HOME}"
+        )
+    yield
+
+
+def test_added_user_exposes_configured_state_and_authentication_results():
+
+
+
+    auth = DummyAuthorizer()
+    assert auth.has_user("alice") is False
+
+    auth.add_user(
+        "alice",
+        "secret",
+        HOME,
+        perm="elr",
+        msg_login="Welcome.",
+        msg_quit="Bye.",
+    )
+
+    assert auth.has_user("alice") is True
+
+    assert auth.get_home_dir("alice") == os.path.realpath(HOME)
+    assert auth.get_perms("alice") == "elr"
+    assert auth.get_msg_login("alice") == "Welcome."
+    assert auth.get_msg_quit("alice") == "Bye."
+    assert auth.validate_authentication("alice", "secret", None) is None
+
+    with pytest.raises(AuthenticationFailed) as wrong_password:
+        auth.validate_authentication("alice", "wrong", None)
+
+    assert str(wrong_password.value).strip() != ""
+
+    with pytest.raises(AuthenticationFailed) as unknown_user:
+        auth.validate_authentication("bob", "secret", None)
+
+    assert str(unknown_user.value).strip() != ""
+
+
+def test_validate_anonymous_before_configuration_is_specific_ordering_error():
+
+
+
+    auth = DummyAuthorizer()
+    assert auth.has_user("anonymous") is False
+
+    with pytest.raises(AuthenticationFailed) as exc:
+        auth.validate_authentication("anonymous", "anything", None)
+
+
+    assert "anonymous" in str(exc.value).lower()
+
+
+def test_anonymous_user_defaults_to_read_only_and_accepts_any_password():
+
+
+
+    auth = DummyAuthorizer()
+    assert auth.has_user("anonymous") is False
+
+    auth.add_anonymous(HOME)
+
+    assert auth.has_user("anonymous") is True
+
+    assert auth.get_home_dir("anonymous") == os.path.realpath(HOME)
+    assert auth.get_perms("anonymous") == "elr"
+    assert auth.has_perm("anonymous", "e") is True
+    assert auth.has_perm("anonymous", "l") is True
+    assert auth.has_perm("anonymous", "r") is True
+    assert auth.has_perm("anonymous", "w") is False
+    assert auth.validate_authentication("anonymous", "anything", None) is None
+    assert auth.validate_authentication("anonymous", "", None) is None
+
+
+def test_permission_letters_invalid_inputs_and_anonymous_write_warning():
+
+
+
+    auth = DummyAuthorizer()
+    auth.add_user("alice", "secret", HOME, perm="elradfmwMT")
+
+    assert auth.get_perms("alice") == "elradfmwMT"
+    assert auth.has_perm("alice", "e") is True
+    assert auth.has_perm("alice", "l") is True
+    assert auth.has_perm("alice", "r") is True
+    assert auth.has_perm("alice", "a") is True
+    assert auth.has_perm("alice", "d") is True
+    assert auth.has_perm("alice", "f") is True
+    assert auth.has_perm("alice", "m") is True
+    assert auth.has_perm("alice", "w") is True
+    assert auth.has_perm("alice", "M") is True
+    assert auth.has_perm("alice", "T") is True
+
+
+    with pytest.raises(ValueError):
+        DummyAuthorizer().add_user("bad", "secret", HOME, perm="?")
+
+
+    with pytest.raises(ValueError):
+        DummyAuthorizer().add_anonymous(HOME, perm="?")
+
+
+    with pytest.raises(ValueError):
+        auth.override_perm("alice", SUBDIR, perm="?")
+
+
+    with pytest.warns(RuntimeWarning):
+        DummyAuthorizer().add_anonymous(HOME, perm="w")
+
+
+def test_duplicate_missing_and_remove_user_state_transitions():
+
+
+
+    auth = DummyAuthorizer()
+
+
+    with pytest.raises(ValueError):
+        auth.add_user("alice", "secret", MISSING_HOME)
+
+
+    with pytest.raises(ValueError):
+        auth.add_anonymous(MISSING_HOME)
+
+    auth.add_user("alice", "secret", HOME)
+    auth.add_anonymous(HOME)
+    assert auth.has_user("alice") is True
+    assert auth.has_user("anonymous") is True
+
+
+    with pytest.raises(ValueError):
+        auth.add_user("alice", "secret", HOME)
+
+
+    with pytest.raises(ValueError):
+        auth.add_anonymous(HOME)
+
+    auth.remove_user("alice")
+    assert auth.has_user("alice") is False
+
+    with pytest.raises(Exception):
+        auth.get_home_dir("alice")
+
+
+def test_recursive_permission_override_changes_path_specific_state():
+
+
+
+    auth = DummyAuthorizer()
+    auth.add_user("alice", "secret", HOME, perm="elr")
+
+    assert auth.has_perm("alice", "w", HOME) is False
+    assert auth.has_perm("alice", "r", HOME) is True
+    assert auth.has_perm("alice", "w", SUBDIR) is False
+
+    auth.override_perm("alice", SUBDIR, "w", recursive=True)
+
+    assert auth.has_perm("alice", "w", HOME) is False
+    assert auth.has_perm("alice", "w", SUBDIR) is True
+    assert auth.has_perm("alice", "w", DIRECT_FILE) is True
+    assert auth.has_perm("alice", "w", NESTED) is True
+    assert auth.has_perm("alice", "w", NESTED_FILE) is True
+    assert auth.has_perm("alice", "w", SUBDIR + "@") is False
+
+
+def test_nonrecursive_permission_override_excludes_nested_descendants():
+
+
+
+    auth = DummyAuthorizer()
+    auth.add_user("alice", "secret", HOME, perm="elr")
+
+    assert auth.has_perm("alice", "w", HOME) is False
+    assert auth.has_perm("alice", "w", SUBDIR) is False
+
+    auth.override_perm("alice", SUBDIR, "w", recursive=False)
+
+    assert auth.has_perm("alice", "w", HOME) is False
+    assert auth.has_perm("alice", "w", SUBDIR) is True
+    assert auth.has_perm("alice", "w", DIRECT_FILE) is True
+    assert auth.has_perm("alice", "w", NESTED) is False
+    assert auth.has_perm("alice", "w", NESTED_FILE) is False
+    assert auth.has_perm("alice", "w", SUBDIR + "@") is False
+
+
+def test_override_permission_rejects_invalid_directory_targets():
+
+
+
+    auth = DummyAuthorizer()
+    auth.add_user("alice", "secret", HOME, perm="elr")
+
+
+    with pytest.raises(ValueError):
+        auth.override_perm("alice", HOME, "w")
+
+
+    with pytest.raises(ValueError):
+        auth.override_perm("alice", OUTSIDE, "w")
+
+
+    with pytest.raises(ValueError):
+        auth.override_perm("alice", MISSING_INSIDE_HOME, "w")
+
+
+    with pytest.raises(ValueError):
+        auth.override_perm("alice", HOME_FILE, "w")
+
+
+def test_noop_impersonation_hooks_are_idempotent_cleanup_methods():
+
+
+
+    auth = DummyAuthorizer()
+    auth.add_user("alice", "secret", HOME)
+
+    assert auth.impersonate_user("alice", "secret") is None
+    assert auth.terminate_impersonation("alice") is None
+    assert auth.terminate_impersonation("alice") is None
+    assert auth.has_user("alice") is True
+
+
+def test_two_authorizers_keep_independent_session_state():
+
+
+
+    first = DummyAuthorizer()
+    second = DummyAuthorizer()
+
+    assert first.has_user("alice") is False
+    assert second.has_user("alice") is False
+    assert first.has_user("bob") is False
+    assert second.has_user("bob") is False
+
+    first.add_user("alice", "secret", HOME, perm="elr")
+    second.add_user("bob", "password", HOME, perm="w")
+
+    assert first.has_user("alice") is True
+    assert first.has_user("bob") is False
+    assert first.get_perms("alice") == "elr"
+    assert second.has_user("alice") is False
+    assert second.has_user("bob") is True
+    assert second.get_perms("bob") == "w"
+
+    first.remove_user("alice")
+
+    assert first.has_user("alice") is False
+    assert second.has_user("bob") is True
+    assert second.get_perms("bob") == "w"
+
+
+def test_repeated_add_remove_cycles_do_not_retain_python_heap():
+
+
+
+    auth = DummyAuthorizer()
+
+    for index in range(150):
+        username = f"user-{index}"
+        auth.add_user(username, "secret", HOME, perm="elr")
+        assert auth.has_user(username) is True
+        auth.remove_user(username)
+        assert auth.has_user(username) is False
+
+
+    assert all(not auth.has_user(f"user-{index}") for index in range(150))
