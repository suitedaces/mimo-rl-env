+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+export PYTHONNOUSERSITE=1
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+export PIP_NO_INDEX=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+export UV_OFFLINE=1
+
+VENV_PYTHON="/workspace/repo/.venv/bin/python"
+if [[ ! -x "${VENV_PYTHON}" ]]; then
+  echo "Expected offline test virtualenv at ${VENV_PYTHON}" >&2
+  exit 127
+fi
+
+exec "${VENV_PYTHON}" -m pytest -o addopts="" /workspace/repo/usercase-test-coderl/test_to_values.py -v
