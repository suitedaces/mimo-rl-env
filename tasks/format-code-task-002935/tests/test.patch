+++ b/usercase-test-coderl/test_to_values.py
@@ -0,0 +1,259 @@
+
+
+
+
+from __future__ import annotations
+
+import builtins
+import copy
+import json
+import socket
+import subprocess
+import sys
+from datetime import date
+
+import narwhals.stable.v1 as nw
+import pandas as pd
+import polars as pl
+import pytest
+
+import altair as alt
+
+
+class GeoFeatureCollection:
+    def __init__(self) -> None:
+        self.interface = {
+            "type": "FeatureCollection",
+            "features": [
+                {
+                    "type": "Feature",
+                    "geometry": {"type": "Point", "coordinates": (1.5, 2.5)},
+                    "properties": {"name": "A", "missing": None},
+                },
+                {
+                    "type": "Feature",
+                    "geometry": {
+                        "type": "LineString",
+                        "coordinates": [(0, 0), (1, 1)],
+                    },
+                    "properties": {"name": "B"},
+                },
+            ],
+        }
+
+    @property
+    def __geo_interface__(self):
+        return self.interface
+
+
+def test_pandas_dataframe_returns_inline_rows() -> None:
+
+
+
+
+    data = pd.DataFrame({"x": [1, 2], "y": ["a", "b"]})
+
+    actual = alt.to_values(data)
+
+    assert actual == {"values": [{"x": 1, "y": "a"}, {"x": 2, "y": "b"}]}
+
+
+def test_pandas_dataframe_applies_altair_sanitization() -> None:
+
+
+
+
+    data = pd.DataFrame(
+        {
+            "when": pd.to_datetime(["2020-01-01 01:02:03", None]),
+            "score": [1.25, float("inf")],
+            "flag": [True, False],
+        }
+    )
+
+    actual = alt.to_values(data)
+
+    assert actual == {
+        "values": [
+            {"when": "2020-01-01T01:02:03", "score": 1.25, "flag": True},
+            {"when": "", "score": None, "flag": False},
+        ]
+    }
+
+
+def test_values_dictionary_is_returned_unchanged_as_data_dictionary() -> None:
+
+
+
+
+    data = {"values": [{"x": 1}], "name": "kept"}
+
+    actual = alt.to_values(data)
+
+    assert actual == {"values": [{"x": 1}], "name": "kept"}
+
+
+def test_geo_interface_feature_collection_returns_sanitized_values() -> None:
+
+
+
+
+    data = GeoFeatureCollection()
+
+    actual = alt.to_values(data)
+
+    assert actual == {
+        "values": [
+            {
+                "name": "A",
+                "missing": None,
+                "type": "Feature",
+                "geometry": {"type": "Point", "coordinates": [1.5, 2.5]},
+            },
+            {
+                "name": "B",
+                "type": "Feature",
+                "geometry": {
+                    "type": "LineString",
+                    "coordinates": [[0, 0], [1, 1]],
+                },
+            },
+        ]
+    }
+
+
+def test_narwhals_dataframe_returns_sanitized_named_rows() -> None:
+
+
+
+
+    native = pl.DataFrame(
+        {
+            "x": [1, 2],
+            "when": [date(2021, 5, 17), date(2021, 5, 18)],
+            "label": ["left", None],
+        }
+    )
+    data = nw.from_native(native, eager_only=True)
+
+    actual = alt.to_values(data)
+
+    assert actual == {
+        "values": [
+            {"x": 1, "when": "2021-05-17T00:00:00", "label": "left"},
+            {"x": 2, "when": "2021-05-18T00:00:00", "label": None},
+        ]
+    }
+
+
+def test_dictionary_without_values_key_raises_key_error() -> None:
+
+
+
+
+    with pytest.raises(KeyError) as excinfo:
+        alt.to_values({"x": [1]})
+
+
+    assert isinstance(excinfo.value, KeyError)
+
+
+def test_unsupported_object_raises_type_error() -> None:
+
+
+
+
+    with pytest.raises(TypeError) as excinfo:
+        alt.to_values(0)
+
+
+    assert isinstance(excinfo.value, TypeError)
+
+
+def test_referential_transparency_for_same_input() -> None:
+    data = pd.DataFrame({"x": [3, 4], "y": ["c", "d"]})
+
+    assert alt.to_values(data) == alt.to_values(data)
+
+
+def test_does_not_mutate_caller_inputs() -> None:
+    dict_data = {"values": [{"x": 1, "tags": ["a", "b"]}]}
+    dict_before = copy.deepcopy(dict_data)
+    frame_data = pd.DataFrame(
+        {"when": pd.to_datetime(["2022-02-03 04:05:06"]), "score": [float("inf")]}
+    )
+    frame_before = frame_data.copy(deep=True)
+    native_narwhals_data = pl.DataFrame(
+        {"x": [1], "when": [date(2023, 1, 2)], "label": ["stable"]}
+    )
+    narwhals_data = nw.from_native(native_narwhals_data, eager_only=True)
+    narwhals_before = narwhals_data.rows(named=True)
+    geo_data = GeoFeatureCollection()
+    geo_before = copy.deepcopy(geo_data.interface)
+
+    alt.to_values(dict_data)
+    alt.to_values(frame_data)
+    alt.to_values(narwhals_data)
+    alt.to_values(geo_data)
+
+    assert dict_data == dict_before
+    pd.testing.assert_frame_equal(frame_data, frame_before)
+    assert narwhals_data.rows(named=True) == narwhals_before
+    assert geo_data.interface == geo_before
+
+
+def test_no_global_state_across_fresh_python_process() -> None:
+    data = pd.DataFrame({"x": [9, 10], "y": ["i", "j"]})
+    in_process = alt.to_values(data)
+    script = """
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+import pandas as pd
+import altair as alt
+out = alt.to_values(pd.DataFrame({"x": [9, 10], "y": ["i", "j"]}))
+sys.stdout.write(json.dumps(out, sort_keys=True))
+"""
+
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        capture_output=True,
+    )
+    fresh_process = json.loads(completed.stdout)
+
+    assert in_process == {"values": [{"x": 9, "y": "i"}, {"x": 10, "y": "j"}]}
+    assert fresh_process == in_process
+
+
+def test_does_not_write_files_use_network_or_change_transformer_state(
+    monkeypatch: pytest.MonkeyPatch, tmp_path
+) -> None:
+    before_active = alt.data_transformers.active
+    before_options = alt.data_transformers.options.copy()
+    before_consolidate = alt.data_transformers.consolidate_datasets
+
+    def fail_socket(*args, **kwargs):
+        raise AssertionError("alt.to_values must not open network sockets")
+
+    real_open = builtins.open
+
+    def guarded_open(file, mode="r", *args, **kwargs):
+        if any(flag in mode for flag in ("w", "a", "x", "+")):
+            raise AssertionError(f"alt.to_values must not write files: {file!r}")
+        return real_open(file, mode, *args, **kwargs)
+
+    monkeypatch.setattr(socket, "socket", fail_socket)
+    monkeypatch.setattr(builtins, "open", guarded_open)
+    monkeypatch.chdir(tmp_path)
+    before_entries = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob("*"))
+
+    actual = alt.to_values({"values": [{"x": 42}]})
+
+    after_entries = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob("*"))
+    assert actual == {"values": [{"x": 42}]}
+    assert after_entries == before_entries
+    assert alt.data_transformers.active == before_active
+    assert alt.data_transformers.options == before_options
+    assert alt.data_transformers.consolidate_datasets is before_consolidate
