diff --git a/usercase-test-coderl/test_logic_analyzer_get_xy.py b/usercase-test-coderl/test_logic_analyzer_get_xy.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_logic_analyzer_get_xy.py
@@ -0,0 +1,263 @@
+
+
+import numpy as np
+
+from pslab import LogicAnalyzer
+
+
+class ScriptedDevice:
+
+
+    def __init__(self, initial_before=0, initial_after=0):
+        self.initial_before = initial_before
+        self.initial_after = initial_after
+        self.ack_count = 0
+        self.byte_writes = []
+        self.int_writes = []
+        self._int_reads = []
+        self._byte_reads = []
+
+    def send_byte(self, value):
+        self.byte_writes.append(value)
+
+    def send_int(self, value):
+        self.int_writes.append(value)
+
+    def get_ack(self):
+        self.ack_count += 1
+
+    def get_int(self):
+        return self._int_reads.pop(0) if self._int_reads else 0
+
+    def get_byte(self):
+        return self._byte_reads.pop(0) if self._byte_reads else 0
+
+    def prime_initial_state_read(self):
+        self._int_reads = [0, 0, 0, 0, 0]
+        self._byte_reads = [self.initial_before, self.initial_after]
+
+
+def assert_arrays(actual, expected):
+    assert len(actual) == len(expected)
+    for actual_array, expected_list in zip(actual, expected):
+        assert actual_array.tolist() == expected_list
+
+
+def test_any_mode_one_channel_uses_initial_state_and_toggles_each_event():
+
+
+
+
+    analyzer = LogicAnalyzer(ScriptedDevice())
+    analyzer.capture("LA1", events=2, modes=["any"], block=False)
+
+    xy = analyzer.get_xy([np.array([2.0, 5.0])], {"LA1": False})
+
+    assert_arrays(
+        xy,
+        [
+            [0.0, 2.0, 2.0, 2.0, 5.0, 5.0, 5.0],
+            [False, False, True, True, True, False, False],
+        ],
+    )
+
+
+def test_rising_mode_one_channel_builds_rising_pulses():
+
+
+
+
+    analyzer = LogicAnalyzer(ScriptedDevice())
+    analyzer.capture("LA1", events=2, modes=["rising"], block=False)
+
+    xy = analyzer.get_xy([np.array([3.0, 7.0])], {"LA1": True})
+
+    assert_arrays(
+        xy,
+        [
+            [0.0, 3.0, 3.0, 3.0, 7.0, 7.0, 7.0],
+            [False, False, True, False, False, True, False],
+        ],
+    )
+
+
+def test_falling_mode_one_channel_builds_falling_pulse():
+
+
+
+
+    analyzer = LogicAnalyzer(ScriptedDevice())
+    analyzer.capture("LA1", events=1, modes=["falling"], block=False)
+
+    xy = analyzer.get_xy([np.array([4.0])], {"LA1": False})
+
+    assert_arrays(
+        xy,
+        [
+            [0.0, 4.0, 4.0, 4.0],
+            [True, True, False, True],
+        ],
+    )
+
+
+def test_multiple_channels_are_flattened_in_active_capture_order():
+
+
+
+
+    analyzer = LogicAnalyzer(ScriptedDevice())
+    analyzer.capture(["LA3", "LA1"], events=2, modes=["falling", "any"], block=False)
+
+    xy = analyzer.get_xy(
+        [np.array([1.5]), np.array([2.5, 4.5])],
+        {"LA3": True, "LA1": False},
+    )
+
+    assert_arrays(
+        xy,
+        [
+            [0.0, 1.5, 1.5, 1.5],
+            [True, True, False, True],
+            [0.0, 2.5, 2.5, 2.5, 4.5, 4.5, 4.5],
+            [False, False, True, True, True, False, False],
+        ],
+    )
+
+
+def test_omitted_initial_states_are_read_from_current_capture():
+
+
+
+
+    device = ScriptedDevice(initial_before=1, initial_after=1)
+    device.prime_initial_state_read()
+    analyzer = LogicAnalyzer(device)
+    analyzer.capture("LA1", events=2, modes=["any"], block=False)
+
+    xy = analyzer.get_xy([np.array([1.0, 2.0])])
+
+    assert_arrays(
+        xy,
+        [
+            [0.0, 1.0, 1.0, 1.0, 2.0, 2.0, 2.0],
+            [True, True, False, False, False, True, True],
+        ],
+    )
+
+
+def test_get_xy_uses_active_capture_session_state():
+
+
+
+
+    analyzer = LogicAnalyzer(ScriptedDevice())
+
+    analyzer.capture("LA1", events=1, modes=["rising"], block=False)
+    after_capture = analyzer.get_xy([np.array([9.0])], {"LA1": False})
+
+
+    assert_arrays(
+        after_capture,
+        [
+            [0.0, 9.0, 9.0, 9.0],
+            [False, False, True, False],
+        ],
+    )
+
+
+def test_get_xy_returns_flat_numpy_array_list():
+
+
+
+
+    analyzer = LogicAnalyzer(ScriptedDevice())
+    analyzer.capture("LA1", events=1, modes=["any"], block=False)
+
+    xy = analyzer.get_xy([np.array([6.0])], {"LA1": False})
+
+
+
+    assert isinstance(xy, list)
+    assert len(xy) == 2
+    assert all(isinstance(array, np.ndarray) for array in xy)
+
+
+def test_get_xy_honors_non_la1_single_channel_capture():
+
+
+
+
+    analyzer = LogicAnalyzer(ScriptedDevice())
+    analyzer.capture("LA2", events=1, modes=["any"], block=False)
+
+    xy = analyzer.get_xy([np.array([6.0])], {"LA2": True})
+
+
+
+    assert_arrays(
+        xy,
+        [
+            [0.0, 6.0, 6.0, 6.0],
+            [True, True, False, False],
+        ],
+    )
+
+
+def test_two_logic_analyzers_keep_capture_state_independent():
+
+
+
+
+    analyzer_a = LogicAnalyzer(ScriptedDevice())
+    analyzer_b = LogicAnalyzer(ScriptedDevice())
+
+    analyzer_a.capture("LA1", events=2, modes=["any"], block=False)
+    analyzer_b.capture("LA1", events=1, modes=["rising"], block=False)
+
+    xy_a = analyzer_a.get_xy([np.array([2.0, 5.0])], {"LA1": False})
+    xy_b = analyzer_b.get_xy([np.array([3.0])], {"LA1": True})
+
+    assert_arrays(
+        xy_a,
+        [
+            [0.0, 2.0, 2.0, 2.0, 5.0, 5.0, 5.0],
+            [False, False, True, True, True, False, False],
+        ],
+    )
+    assert_arrays(
+        xy_b,
+        [
+            [0.0, 3.0, 3.0, 3.0],
+            [False, False, True, False],
+        ],
+    )
+
+
+def test_repeated_construct_capture_get_xy_cycles_stay_spec_consistent():
+
+
+
+
+    for _ in range(20):
+        analyzer = LogicAnalyzer(ScriptedDevice())
+        analyzer.capture("LA1", events=2, modes=["any"], block=False)
+        xy = analyzer.get_xy([np.array([2.0, 5.0])], {"LA1": False})
+        assert xy[0].tolist() == [0.0, 2.0, 2.0, 2.0, 5.0, 5.0, 5.0]
+        assert xy[1].tolist() == [
+            False,
+            False,
+            True,
+            True,
+            True,
+            False,
+            False,
+        ]
+
+
+    assert_arrays(
+        xy,
+        [
+            [0.0, 2.0, 2.0, 2.0, 5.0, 5.0, 5.0],
+            [False, False, True, True, True, False, False],
+        ],
+    )
