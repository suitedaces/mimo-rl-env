+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+
+
+set -euo pipefail
+
+cd /workspace/repo
+
+export PYTHONPATH="/workspace/repo${PYTHONPATH:+:${PYTHONPATH}}"
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+export PIP_NO_INDEX=1
+
+exec python -m pytest /workspace/repo/usercase-test-coderl/test_logic_analyzer_get_xy.py -v
