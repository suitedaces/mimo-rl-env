diff --git a/go/tools/bazel/runfiles_manifest_test.go b/go/tools/bazel/runfiles_manifest_test.go
new file mode 100644
index 00000000..e6e60e82
--- /dev/null
+++ b/go/tools/bazel/runfiles_manifest_test.go
@@ -0,0 +1,213 @@
+package bazel
+
+import (
+	"io/ioutil"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+)
+
+func writeManifest(t *testing.T, contents string) string {
+	t.Helper()
+	dir, err := ioutil.TempDir("", "manifest_test")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	manifest := filepath.Join(dir, "MANIFEST")
+	if err := ioutil.WriteFile(manifest, []byte(contents), 0644); err != nil {
+		t.Fatal(err)
+	}
+	return manifest
+}
+
+
+
+
+func resetRunfilesAndSetManifest(t *testing.T, manifest string) {
+	t.Helper()
+	saved := runfiles
+	savedManifest, hadManifest := os.LookupEnv("RUNFILES_MANIFEST_FILE")
+	savedDir, hadDir := os.LookupEnv("RUNFILES_DIR")
+	savedTestSrc, hadTestSrc := os.LookupEnv("TEST_SRCDIR")
+
+	t.Cleanup(func() {
+		runfiles.once = sync.Once{}
+		runfiles.listOnce = sync.Once{}
+		runfiles.list = saved.list
+		runfiles.index = saved.index
+		runfiles.dir = saved.dir
+		runfiles.workspace = saved.workspace
+		runfiles.workspaces = saved.workspaces
+		runfiles.err = saved.err
+
+		if hadManifest {
+			os.Setenv("RUNFILES_MANIFEST_FILE", savedManifest)
+		} else {
+			os.Unsetenv("RUNFILES_MANIFEST_FILE")
+		}
+		if hadDir {
+			os.Setenv("RUNFILES_DIR", savedDir)
+		} else {
+			os.Unsetenv("RUNFILES_DIR")
+		}
+		if hadTestSrc {
+			os.Setenv("TEST_SRCDIR", savedTestSrc)
+		} else {
+			os.Unsetenv("TEST_SRCDIR")
+		}
+	})
+
+	runfiles.once = sync.Once{}
+	runfiles.listOnce = sync.Once{}
+	runfiles.list = nil
+	runfiles.index = nil
+	runfiles.dir = ""
+	runfiles.workspace = ""
+	runfiles.workspaces = nil
+	runfiles.err = nil
+
+	os.Setenv("RUNFILES_MANIFEST_FILE", manifest)
+
+
+	os.Setenv("RUNFILES_DIR", filepath.Dir(manifest))
+	os.Unsetenv("TEST_SRCDIR")
+}
+
+func findEntry(list []RunfileEntry, workspace, shortPath string) *RunfileEntry {
+	for i := range list {
+		if list[i].Workspace == workspace && list[i].ShortPath == shortPath {
+			return &list[i]
+		}
+	}
+	return nil
+}
+
+
+
+func TestManifestStandardLine(t *testing.T) {
+	manifest := writeManifest(t, "myws/foo/bar.txt /absolute/path/to/bar.txt\n")
+	resetRunfilesAndSetManifest(t, manifest)
+
+	list, err := ListRunfiles()
+	if err != nil {
+		t.Fatalf("ListRunfiles returned error: %v", err)
+	}
+	if len(list) != 1 {
+		t.Fatalf("expected 1 entry, got %d: %+v", len(list), list)
+	}
+	got := list[0]
+	if got.Workspace != "myws" {
+		t.Errorf("Workspace: want %q, got %q", "myws", got.Workspace)
+	}
+	if got.ShortPath != "foo/bar.txt" {
+		t.Errorf("ShortPath: want %q, got %q", "foo/bar.txt", got.ShortPath)
+	}
+	if got.Path != "/absolute/path/to/bar.txt" {
+		t.Errorf("Path: want %q, got %q", "/absolute/path/to/bar.txt", got.Path)
+	}
+}
+
+
+
+
+func TestManifestRulesPythonTrailingSpaceNoErr(t *testing.T) {
+
+
+	manifest := writeManifest(t, "myws/foo/__init__.py \n")
+	resetRunfilesAndSetManifest(t, manifest)
+
+	list, err := ListRunfiles()
+	if err != nil {
+		t.Fatalf("expected no parse error, got: %v", err)
+	}
+	if len(list) != 1 {
+		t.Fatalf("expected 1 entry, got %d: %+v", len(list), list)
+	}
+}
+
+
+
+func TestManifestRulesPythonTrailingSpaceShortPath(t *testing.T) {
+	manifest := writeManifest(t, "myws/foo/__init__.py \n")
+	resetRunfilesAndSetManifest(t, manifest)
+
+	list, err := ListRunfiles()
+	if err != nil {
+		t.Fatalf("ListRunfiles returned error: %v", err)
+	}
+	entry := findEntry(list, "myws", "foo/__init__.py")
+	if entry == nil {
+		t.Fatalf("expected entry with Workspace=myws ShortPath=foo/__init__.py, got list: %+v", list)
+	}
+}
+
+
+
+
+
+
+func TestManifestRulesPythonTrailingSpaceEmptyPath(t *testing.T) {
+	manifest := writeManifest(t, "myws/foo/__init__.py \n")
+	resetRunfilesAndSetManifest(t, manifest)
+
+	list, err := ListRunfiles()
+	if err != nil {
+		t.Fatalf("ListRunfiles returned error: %v", err)
+	}
+	entry := findEntry(list, "myws", "foo/__init__.py")
+	if entry == nil {
+		t.Fatalf("entry not found, list: %+v", list)
+	}
+	if entry.Path != "" && !filepath.IsAbs(entry.Path) {
+		t.Errorf("Path must be empty or an absolute path (per RunfileEntry docstring), got %q", entry.Path)
+	}
+}
+
+
+
+
+func TestManifestMixedLines(t *testing.T) {
+	contents := "" +
+		"myws/normal.txt /abs/path/normal.txt\n" +
+		"myws/dir/__init__.py \n" +
+		"myws/dir/another.txt /abs/path/another.txt\n"
+	manifest := writeManifest(t, contents)
+	resetRunfilesAndSetManifest(t, manifest)
+
+	list, err := ListRunfiles()
+	if err != nil {
+		t.Fatalf("ListRunfiles returned error: %v", err)
+	}
+	if len(list) != 3 {
+		t.Fatalf("expected 3 entries, got %d: %+v", len(list), list)
+	}
+
+	if e := findEntry(list, "myws", "normal.txt"); e == nil || e.Path != "/abs/path/normal.txt" {
+		t.Errorf("normal entry incorrect: %+v", e)
+	}
+	if e := findEntry(list, "myws", "dir/__init__.py"); e == nil || (e.Path != "" && !filepath.IsAbs(e.Path)) {
+		t.Errorf("__init__.py entry incorrect (Path must be empty or absolute): %+v", e)
+	}
+	if e := findEntry(list, "myws", "dir/another.txt"); e == nil || e.Path != "/abs/path/another.txt" {
+		t.Errorf("another.txt entry incorrect: %+v", e)
+	}
+}
+
+
+
+
+func TestManifestRunfileLookupReturnsAbsPath(t *testing.T) {
+	contents := "myws/dir/file.txt /abs/different/file.txt\n"
+	manifest := writeManifest(t, contents)
+	resetRunfilesAndSetManifest(t, manifest)
+
+	got, err := Runfile("dir/file.txt")
+	if err != nil {
+		t.Fatalf("Runfile returned error: %v", err)
+	}
+	if got != "/abs/different/file.txt" {
+		t.Errorf("Runfile: want %q, got %q", "/abs/different/file.txt", got)
+	}
+}
