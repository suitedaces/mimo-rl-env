diff --git a/tests/rules/single-line-per-selector.js b/tests/rules/single-line-per-selector.js
index 68c4925..8d82b55 100644
--- a/tests/rules/single-line-per-selector.js
+++ b/tests/rules/single-line-per-selector.js
@@ -18,6 +18,35 @@ describe('single line per selector - scss', function () {
   });
 });
 
+describe('single line per selector - scss with inline comments (issue)', function () {
+  var file = lint.file('single-line-per-selector-comments.scss');
+
+  it('inline and block comments after selector comma should not be reported', function (done) {
+    lint.test(file, {
+      'single-line-per-selector': 1
+    }, function (data) {
+      lint.assert.equal(0, data.warningCount);
+      done();
+    });
+  });
+});
+
+describe('single line per selector - scss with mixed comments and violations', function () {
+  var file = lint.file('single-line-per-selector-mixed.scss');
+
+  it('reports only actual same-line selectors, not comments', function (done) {
+    lint.test(file, {
+      'single-line-per-selector': 1
+    }, function (data) {
+
+
+      lint.assert.equal(2, data.warningCount);
+      lint.assert.equal('Selectors must be placed on new lines', data.messages[0].message);
+      done();
+    });
+  });
+});
+
