+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+export COREPACK_ENABLE_NETWORK=0
+export npm_config_offline=true
+export npm_config_audit=false
+export npm_config_fund=false
+test -x /workspace/repo/node_modules/.bin/rollup
+rm -rf /workspace/repo/dist/index.js
+/workspace/repo/node_modules/.bin/rollup -c /workspace/repo/rollup.config.js --bundleConfigAsCjs >/dev/null
+exec node --no-warnings --test /workspace/repo/usercase-test-coderl/query_helpers.test.js
