diff --git a/usercase-test-coderl/query_helpers.test.js b/usercase-test-coderl/query_helpers.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/query_helpers.test.js
@@ -0,0 +1,425 @@
+
+
+const assert = require('node:assert/strict')
+const { execFileSync } = require('node:child_process')
+const fs = require('node:fs')
+const os = require('node:os')
+const path = require('node:path')
+const http = require('node:http')
+const https = require('node:https')
+const net = require('node:net')
+const tls = require('node:tls')
+const test = require('node:test')
+
+const mql = require('@microlink/mql')
+
+const clonePlain = value => JSON.parse(JSON.stringify(value))
+
+const assertApiUrl = (actual, expectedBaseUrl, expectedParams) => {
+  const parsed = new URL(actual)
+  assert.equal(`${parsed.origin}${parsed.pathname}`, expectedBaseUrl)
+  assert.deepStrictEqual(
+    [...parsed.searchParams.keys()].sort(),
+    Object.keys(expectedParams).sort()
+  )
+  for (const [key, value] of Object.entries(expectedParams)) {
+    assert.equal(parsed.searchParams.get(key), value)
+  }
+}
+
+const listEntries = root => {
+  const entries = []
+  const visit = dir => {
+    for (const dirent of fs.readdirSync(dir, { withFileTypes: true })) {
+      const fullPath = path.join(dir, dirent.name)
+      const relative = path.relative(root, fullPath)
+      entries.push(`${dirent.isDirectory() ? 'dir' : 'file'}:${relative}`)
+      if (dirent.isDirectory()) visit(fullPath)
+    }
+  }
+  visit(root)
+  return entries.sort()
+}
+
+test('commonjs default export exposes query helpers', () => {
+
+
+  assert.equal(typeof mql.getApiUrl, 'function')
+  assert.equal(typeof mql.mapRules, 'function')
+  assert.deepStrictEqual(mql.getApiUrl('https://kikobeats.com'), [
+    'https://api.microlink.io/?url=https%3A%2F%2Fkikobeats.com',
+    { responseType: 'json', headers: {} }
+  ])
+  assert.deepStrictEqual(
+    mql.mapRules({
+      avatar: {
+        type: 'image',
+        selectors: { selector: '#avatar' }
+      }
+    }),
+    {
+      'data.avatar.type': 'image',
+      'data.avatar.selectors.selector': '#avatar'
+    }
+  )
+})
+
+test('esm entry exposes named query helpers', async () => {
+
+
+  const { getApiUrl, mapRules } = await import('@microlink/mql')
+  assert.equal(typeof getApiUrl, 'function')
+  assert.equal(typeof mapRules, 'function')
+  const [apiUrl, fetchOptions] = getApiUrl('https://kikobeats.com', {
+    overlay: { browser: 'dark' }
+  })
+
+  assertApiUrl(apiUrl, 'https://api.microlink.io/', {
+    url: 'https://kikobeats.com',
+    'overlay.browser': 'dark'
+  })
+  assert.deepStrictEqual(fetchOptions, { responseType: 'json', headers: {} })
+  assert.deepStrictEqual(
+    mapRules({
+      avatar: {
+        type: 'image',
+        selectors: { selector: '#avatar' }
+      }
+    }),
+    {
+      'data.avatar.type': 'image',
+      'data.avatar.selectors.selector': '#avatar'
+    }
+  )
+})
+
+test('getApiUrl builds the free endpoint request by default', () => {
+
+
+  assert.deepStrictEqual(mql.getApiUrl('https://kikobeats.com'), [
+    'https://api.microlink.io/?url=https%3A%2F%2Fkikobeats.com',
+    { responseType: 'json', headers: {} }
+  ])
+})
+
+test('getApiUrl switches to the pro endpoint and api key header', () => {
+
+
+  assert.deepStrictEqual(mql.getApiUrl('https://kikobeats.com', { apiKey: 'foobar' }), [
+    'https://pro.microlink.io/?url=https%3A%2F%2Fkikobeats.com',
+    { responseType: 'json', headers: { 'x-api-key': 'foobar' } }
+  ])
+})
+
+test('getApiUrl uses an explicit endpoint instead of default selection', () => {
+
+
+  const [apiUrl, fetchOptions] = mql.getApiUrl('https://kikobeats.com', {
+    apiKey: 'foobar',
+    endpoint: 'https://edge.example.test/mql/'
+  })
+
+  assertApiUrl(apiUrl, 'https://edge.example.test/mql/', {
+    url: 'https://kikobeats.com'
+  })
+  assert.deepStrictEqual(fetchOptions, {
+    responseType: 'json',
+    headers: { 'x-api-key': 'foobar' }
+  })
+})
+
+test('getApiUrl carries got options and merges request headers', () => {
+
+
+  assert.deepStrictEqual(
+    mql.getApiUrl(
+      'https://kikobeats.com',
+      { apiKey: 'foobar' },
+      { headers: { accept: 'application/json' }, timeout: 15000, retry: 0 }
+    ),
+    [
+      'https://pro.microlink.io/?url=https%3A%2F%2Fkikobeats.com',
+      {
+        timeout: 15000,
+        retry: 0,
+        responseType: 'json',
+        headers: { accept: 'application/json', 'x-api-key': 'foobar' }
+      }
+    ]
+  )
+})
+
+test('getApiUrl flattens nested option objects into dotted query parameters', () => {
+
+
+  const [apiUrl, fetchOptions] = mql.getApiUrl('https://kikobeats.com', {
+    overlay: { browser: 'dark' }
+  })
+
+  assertApiUrl(apiUrl, 'https://api.microlink.io/', {
+    url: 'https://kikobeats.com',
+    'overlay.browser': 'dark'
+  })
+  assert.deepStrictEqual(fetchOptions, { responseType: 'json', headers: {} })
+})
+
+test('getApiUrl changes responseType when stream is truthy', () => {
+
+
+  const [apiUrl, fetchOptions] = mql.getApiUrl(
+    'https://kikobeats.com',
+    { stream: 1 },
+    { responseType: 'text', headers: { accept: 'text/plain' } }
+  )
+  const parsed = new URL(apiUrl)
+
+  assert.equal(`${parsed.origin}${parsed.pathname}`, 'https://api.microlink.io/')
+  assert.equal(parsed.searchParams.get('url'), 'https://kikobeats.com')
+  assert.deepStrictEqual(fetchOptions, {
+    responseType: 'arrayBuffer',
+    headers: { accept: 'text/plain' }
+  })
+})
+
+test('getApiUrl encodes target URLs that already contain query strings', () => {
+
+
+  assert.deepStrictEqual(mql.getApiUrl('https://example.com/path?x=1&y=two'), [
+    'https://api.microlink.io/?url=https%3A%2F%2Fexample.com%2Fpath%3Fx%3D1%26y%3Dtwo',
+    { responseType: 'json', headers: {} }
+  ])
+})
+
+test('getApiUrl includes flattened data rules in query parameters', () => {
+
+
+  const [apiUrl, fetchOptions] = mql.getApiUrl('https://kikobeats.com', {
+    data: {
+      avatar: {
+        type: 'image',
+        selectors: { selector: '#avatar' }
+      }
+    }
+  })
+
+  assertApiUrl(apiUrl, 'https://api.microlink.io/', {
+    url: 'https://kikobeats.com',
+    'data.avatar.type': 'image',
+    'data.avatar.selectors.selector': '#avatar'
+  })
+  assert.deepStrictEqual(fetchOptions, { responseType: 'json', headers: {} })
+})
+
+test('mapRules flattens object selectors and prefixes data keys', () => {
+
+
+  assert.deepStrictEqual(
+    mql.mapRules({
+      avatar: {
+        type: 'image',
+        selectors: { selector: '#avatar' }
+      }
+    }),
+    {
+      'data.avatar.type': 'image',
+      'data.avatar.selectors.selector': '#avatar'
+    }
+  )
+})
+
+test('mapRules flattens array selectors and stringifies numeric leaves', () => {
+
+
+  assert.deepStrictEqual(
+    mql.mapRules({
+      article: {
+        type: 'text',
+        selectors: [
+          { selector: 'h1', attr: 'text' },
+          { selector: '.lead', attr: 'text' }
+        ],
+        wait: 250
+      }
+    }),
+    {
+      'data.article.type': 'text',
+      'data.article.selectors.0.selector': 'h1',
+      'data.article.selectors.0.attr': 'text',
+      'data.article.selectors.1.selector': '.lead',
+      'data.article.selectors.1.attr': 'text',
+      'data.article.wait': '250'
+    }
+  )
+})
+
+test('mapRules returns undefined for missing and non-object rules', () => {
+
+
+  assert.equal(mql.mapRules(), undefined)
+  assert.equal(mql.mapRules(false), undefined)
+  assert.equal(mql.mapRules('false'), undefined)
+})
+
+test('mapRules returns an empty object for empty object and array inputs', () => {
+
+
+  assert.deepStrictEqual(mql.mapRules({}), {})
+  assert.deepStrictEqual(mql.mapRules([]), {})
+})
+
+test('getApiUrl accepts an empty opts object', () => {
+
+
+
+  assert.deepStrictEqual(mql.getApiUrl('https://kikobeats.com', {}), [
+    'https://api.microlink.io/?url=https%3A%2F%2Fkikobeats.com',
+    { responseType: 'json', headers: {} }
+  ])
+})
+
+test('query helpers are referentially transparent for repeated calls', () => {
+  const getArgs = [
+    'https://kikobeats.com',
+    { overlay: { browser: 'dark' }, data: { avatar: { type: 'image' } } },
+    { headers: { accept: 'application/json' }, timeout: 5000 }
+  ]
+  const rules = {
+    avatar: {
+      type: 'image',
+      selectors: { selector: '#avatar' }
+    }
+  }
+  assert.deepStrictEqual(mql.getApiUrl(...getArgs), mql.getApiUrl(...getArgs))
+  assert.deepStrictEqual(mql.mapRules(rules), mql.mapRules(rules))
+})
+
+test('query helpers do not mutate caller-owned input objects', () => {
+  const opts = {
+    apiKey: 'foobar',
+    overlay: { browser: 'dark' },
+    data: {
+      avatar: {
+        type: 'image',
+        selectors: [{ selector: '#avatar', attr: 'src' }]
+      }
+    }
+  }
+  const gotOpts = {
+    headers: { accept: 'application/json' },
+    timeout: 15000
+  }
+  const rules = {
+    avatar: {
+      type: 'image',
+      selectors: [{ selector: '#avatar', attr: 'src' }]
+    }
+  }
+  const originalOpts = clonePlain(opts)
+  const originalGotOpts = clonePlain(gotOpts)
+  const originalRules = clonePlain(rules)
+
+  mql.getApiUrl('https://kikobeats.com', opts, gotOpts)
+  mql.mapRules(rules)
+
+  assert.deepStrictEqual(opts, originalOpts)
+  assert.deepStrictEqual(gotOpts, originalGotOpts)
+  assert.deepStrictEqual(rules, originalRules)
+})
+
+test('query helpers return the same values in a fresh process', () => {
+  const inProcess = {
+    getApiUrl: mql.getApiUrl('https://kikobeats.com', {
+      overlay: { browser: 'dark' },
+      data: { avatar: { type: 'image' } }
+    }),
+    mapRules: mql.mapRules({
+      avatar: {
+        type: 'image',
+        selectors: { selector: '#avatar' }
+      }
+    })
+  }
+  const script = `
+    const mql = require('@microlink/mql')
+    const out = {
+      getApiUrl: mql.getApiUrl('https://kikobeats.com', {
+        overlay: { browser: 'dark' },
+        data: { avatar: { type: 'image' } }
+      }),
+      mapRules: mql.mapRules({
+        avatar: {
+          type: 'image',
+          selectors: { selector: '#avatar' }
+        }
+      })
+    }
+    process.stdout.write(JSON.stringify(out))
+  `
+  const freshProcess = JSON.parse(
+    execFileSync(process.execPath, ['-e', script], {
+      cwd: '/workspace/repo',
+      encoding: 'utf8'
+    })
+  )
+
+  assert.deepStrictEqual(freshProcess, inProcess)
+})
+
+test('query helpers do not touch cwd files or network APIs', () => {
+  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'mql-query-helpers-'))
+  const originalCwd = process.cwd()
+  const before = listEntries(tmpDir)
+  const blocked = () => {
+    throw new Error('network access is not declared for query helpers')
+  }
+  const originals = {
+    netConnect: net.connect,
+    socketConnect: net.Socket.prototype.connect,
+    tlsConnect: tls.connect,
+    httpRequest: http.request,
+    httpsRequest: https.request,
+    fetch: globalThis.fetch
+  }
+
+  try {
+    process.chdir(tmpDir)
+    net.connect = blocked
+    net.Socket.prototype.connect = blocked
+    tls.connect = blocked
+    http.request = blocked
+    https.request = blocked
+    globalThis.fetch = blocked
+
+    const [apiUrl, fetchOptions] = mql.getApiUrl('https://kikobeats.com', {
+      overlay: { browser: 'dark' }
+    })
+
+    assertApiUrl(apiUrl, 'https://api.microlink.io/', {
+      url: 'https://kikobeats.com',
+      'overlay.browser': 'dark'
+    })
+    assert.deepStrictEqual(fetchOptions, { responseType: 'json', headers: {} })
+    assert.deepStrictEqual(
+      mql.mapRules({
+        avatar: {
+          type: 'image',
+          selectors: { selector: '#avatar' }
+        }
+      }),
+      {
+        'data.avatar.type': 'image',
+        'data.avatar.selectors.selector': '#avatar'
+      }
+    )
+    assert.deepStrictEqual(listEntries(tmpDir), before)
+  } finally {
+    net.connect = originals.netConnect
+    net.Socket.prototype.connect = originals.socketConnect
+    tls.connect = originals.tlsConnect
+    http.request = originals.httpRequest
+    https.request = originals.httpsRequest
+    globalThis.fetch = originals.fetch
+    process.chdir(originalCwd)
+    fs.rmSync(tmpDir, { recursive: true, force: true })
+  }
+})
