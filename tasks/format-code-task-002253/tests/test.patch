diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,280 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+
+VENV="/opt/coderl-pearl-venv"
+BIN="$VENV/bin/pearl"
+[ -x "$BIN" ] || fail "pearl entry point was not built"
+cd "$TMP" || fail "cd temp dir"
+
+make_example_env() {
+    local name="$1"
+    local root="$TMP/$name"
+    mkdir -p "$root/data/pearl" "$root/config" "$root/home"
+    cat >"$root/config/pearl.conf" <<'CONF'
+PEARL_REPO_NAME = "repo-test"
+PEARL_PACKAGES = {
+    "pkg-b-test": {
+        "url": "/tmp/pkg-b-test",
+        "description": "Beta package plugin",
+        "keywords": ("beta-key",),
+    },
+    "pkg-a-test": {
+        "url": "/tmp/pkg-a-test",
+        "description": "Awesome git dotfiles",
+        "keywords": ("pkg-manager", "alpha-key"),
+        "depends": ("pkg-b-test",),
+    },
+}
+CONF
+    mkdir -p "$root/data/pearl/packages/repo-test/pkg-a-test"
+    printf '%s\n' "$root"
+}
+
+make_rich_env() {
+    local name="$1"
+    local root="$TMP/$name"
+    mkdir -p "$root/data/pearl" "$root/config" "$root/home"
+    cat >"$root/config/pearl.conf" <<'CONF'
+PEARL_REPO_NAME = "repo-test"
+PEARL_PACKAGES = {
+    "pkg-top-test": {
+        "url": "/tmp/pkg-top-test",
+        "description": "Top layer package",
+        "keywords": ("top-key",),
+        "depends": ("pkg-mid-test",),
+    },
+    "pkg-mid-test": {
+        "url": "/tmp/pkg-mid-test",
+        "description": "Middle layer package",
+        "keywords": ("mid-key",),
+        "depends": ("pkg-core-test",),
+    },
+    "pkg-core-test": {
+        "url": "/tmp/pkg-core-test",
+        "description": "Core layer package",
+        "keywords": ("core-key",),
+    },
+    "notes-tool": {
+        "url": "/tmp/notes-tool",
+        "description": "Handles PKG documentation",
+        "keywords": ("docs",),
+    },
+    "editor-helper": {
+        "url": "/tmp/editor-helper",
+        "description": "Editor integration helper",
+        "keywords": ("pkg-manager",),
+    },
+}
+CONF
+    mkdir -p "$root/data/pearl/packages/repo-test/editor-helper"
+    printf '%s\n' "$root"
+}
+
+make_empty_env() {
+    local name="$1"
+    local root="$TMP/$name"
+    mkdir -p "$root/data/pearl" "$root/config" "$root/home"
+    : >"$root/config/pearl.conf"
+    printf '%s\n' "$root"
+}
+
+run_pearl() {
+    local root="$1"
+    shift
+    HOME="$root/home" XDG_DATA_HOME="$root/data" "$BIN" -c "$root/config/pearl.conf" "$@" >out 2>err
+}
+
+assert_stdout_eq() {
+    local fixture="$1"
+    local expected_file="$2"
+    cmp -s out "$expected_file" || {
+        echo "Actual stdout for $fixture:" >&2
+        sed -n l out >&2
+        echo "Expected stdout for $fixture:" >&2
+        sed -n l "$expected_file" >&2
+        fail "$fixture stdout mismatch"
+    }
+}
+
+
+
+
+ROOT=$(make_example_env f1)
+run_pearl "$ROOT" list --package-only; ec=$?
+cat >expected <<'EOF'
+repo-test/pkg-b-test
+repo-test/pkg-a-test
+EOF
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_stdout_eq F1 expected
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+
+
+
+
+ROOT=$(make_example_env f2)
+run_pearl "$ROOT" list --package-only --installed-only; ec=$?
+cat >expected <<'EOF'
+repo-test/pkg-a-test
+EOF
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_stdout_eq F2 expected
+[ ! -s err ] || fail "F2 unexpected stderr: $(cat err)"
+
+
+
+
+ROOT=$(make_example_env f3)
+run_pearl "$ROOT" list; ec=$?
+
+
+sed -E $'s/\033\\[[0-9;]*m//g; s/[[:space:]]+$//' out >normalized
+cat >expected <<'EOF'
+repo-test/pkg-b-test
+    Beta package plugin
+repo-test/pkg-a-test [installed]
+    Awesome git dotfiles
+EOF
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+cmp -s normalized expected || {
+    echo "Actual ANSI-stripped stdout for F3:" >&2
+    sed -n l normalized >&2
+    echo "Expected stdout for F3:" >&2
+    sed -n l expected >&2
+    fail "F3 stdout mismatch"
+}
+[ ! -s err ] || fail "F3 unexpected stderr: $(cat err)"
+
+
+
+
+ROOT=$(make_rich_env f4)
+run_pearl "$ROOT" list --package-only --dependency-tree; ec=$?
+
+
+cat >expected <<'EOF'
+repo-test/pkg-core-test
+repo-test/pkg-mid-test
+repo-test/pkg-top-test
+repo-test/notes-tool
+repo-test/editor-helper
+EOF
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+sort out >actual_sorted
+sort expected >expected_sorted
+cmp -s actual_sorted expected_sorted || fail "F4 result set mismatch"
+core_line=$(grep -n '^repo-test/pkg-core-test$' out | cut -d: -f1)
+mid_line=$(grep -n '^repo-test/pkg-mid-test$' out | cut -d: -f1)
+top_line=$(grep -n '^repo-test/pkg-top-test$' out | cut -d: -f1)
+[ "$core_line" -lt "$mid_line" ] || fail "F4 core must precede mid"
+[ "$mid_line" -lt "$top_line" ] || fail "F4 mid must precede top"
+editor_line=$(grep -n '^repo-test/editor-helper$' out | cut -d: -f1)
+[ "$editor_line" -eq 5 ] || fail "F4 uninstalled packages must precede installed packages"
+[ ! -s err ] || fail "F4 unexpected stderr: $(cat err)"
+
+
+
+
+ROOT=$(make_rich_env f5)
+run_pearl "$ROOT" search 'PKG-(TOP|CORE)-TEST' --package-only; ec=$?
+
+
+cat >expected <<'EOF'
+repo-test/pkg-top-test
+repo-test/pkg-core-test
+EOF
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+sort out >actual_sorted
+sort expected >expected_sorted
+cmp -s actual_sorted expected_sorted || fail "F5 result set mismatch"
+[ ! -s err ] || fail "F5 unexpected stderr: $(cat err)"
+
+
+
+
+ROOT=$(make_rich_env f6)
+run_pearl "$ROOT" search documentation --package-only; ec=$?
+cat >expected <<'EOF'
+repo-test/notes-tool
+EOF
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+assert_stdout_eq F6 expected
+[ ! -s err ] || fail "F6 unexpected stderr: $(cat err)"
+
+
+
+
+ROOT=$(make_example_env f7)
+run_pearl "$ROOT" search pkg-manager --package-only; ec=$?
+cat >expected <<'EOF'
+repo-test/pkg-a-test
+EOF
+[ "$ec" -eq 0 ] || fail "F7 exit $ec; want 0"
+assert_stdout_eq F7 expected
+[ ! -s err ] || fail "F7 unexpected stderr: $(cat err)"
+
+
+
+
+ROOT=$(make_rich_env f8)
+run_pearl "$ROOT" search nomatch --package-only; ec=$?
+: >expected
+[ "$ec" -eq 0 ] || fail "F8 exit $ec; want 0"
+assert_stdout_eq F8 expected
+[ ! -s err ] || fail "F8 unexpected stderr: $(cat err)"
+
+
+
+
+ROOT=$(make_empty_env f9)
+run_pearl "$ROOT" list --help; ec=$?
+
+
+[ "$ec" -eq 0 ] || fail "F9 exit $ec; want 0"
+[ -s out ] || fail "F9 help output is empty"
+grep -Fq 'usage: pearl list' out || fail "F9 missing list usage"
+grep -Fq -- '-p, --package-only' out || fail "F9 missing package-only flag"
+grep -Fq -- '-t, --dependency-tree' out || fail "F9 missing dependency-tree flag"
+grep -Fq -- '-i, --installed-only' out || fail "F9 missing installed-only flag"
+[ ! -s err ] || fail "F9 unexpected stderr: $(cat err)"
+
+
+
+
+ROOT=$(make_empty_env f10)
+run_pearl "$ROOT" search --help; ec=$?
+
+
+[ "$ec" -eq 0 ] || fail "F10 exit $ec; want 0"
+[ -s out ] || fail "F10 help output is empty"
+grep -Fq 'usage: pearl search' out || fail "F10 missing search usage"
+grep -Fq 'PATTERN' out || fail "F10 missing PATTERN"
+grep -Fq -- '-p, --package-only' out || fail "F10 missing package-only flag"
+grep -Fq -- '-t, --dependency-tree' out || fail "F10 missing dependency-tree flag"
+grep -Fq -- '-i, --installed-only' out || fail "F10 missing installed-only flag"
+[ ! -s err ] || fail "F10 unexpected stderr: $(cat err)"
+
+
+
+
+ROOT=$(make_empty_env f11)
+run_pearl "$ROOT" search; ec=$?
+
+
+[ "$ec" -eq 2 ] || fail "F11 exit $ec; want 2"
+[ ! -s out ] || fail "F11 unexpected stdout: $(cat out)"
+[ -s err ] || fail "F11 stderr is empty"
+grep -Eq '^usage: .*pearl search .*PATTERN' err || fail "F11 missing argparse usage"
+grep -Fq 'error:' err || fail "F11 missing argparse error"
+grep -Fq 'PATTERN' err || fail "F11 missing PATTERN error"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
