+def test_create_model_configured_but_unsupported_class_raises_invalid_model_error(monkeypatch):
+
+
+
+
+    original_open = open
+
+    def fake_open(path, *args, **kwargs):
+        if str(path).endswith("/configs/experiment/ghost.yaml"):
+            return io.StringIO("# @package _global_\ndefaults:\n  - override /model: parseq\nmodel:\n  name: ghost\n")
+        return original_open(path, *args, **kwargs)
+
+    monkeypatch.setattr("builtins.open", fake_open)
+    with pytest.raises(InvalidModelError) as excinfo:
+        create_model("ghost", pretrained=False)
+
+    assert excinfo.value is not None
