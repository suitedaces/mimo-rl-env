+def test_load_from_checkpoint_pretrained_shortcut_uses_factory_and_overrides(monkeypatch):
+
+
+
+
+    calls = []
+
+    def fake_download(**kwargs):
+        calls.append(("download", kwargs))
+        return {"sentinel": torch.tensor([1])}
+
+    def fake_load_state_dict(self, state_dict, *args, **kwargs):
+        calls.append(("load", type(self).__name__, sorted(state_dict)))
+        return torch.nn.modules.module._IncompatibleKeys([], [])
+
+    monkeypatch.setattr(torch.hub, "load_state_dict_from_url", fake_download)
+    monkeypatch.setattr(torch.nn.Module, "load_state_dict", fake_load_state_dict)
+    model = load_from_checkpoint("pretrained=parseq", decode_ar=False, refine_iters=2)
+    summary = _summary(model)
+
+    assert summary["class"] == "PARSeq"
+    assert summary["hparams"]["name"] == "parseq"
+    assert summary["hparams"]["decode_ar"] is False
+    assert summary["hparams"]["refine_iters"] == 2
+
+    assert len(calls) == 2
+    assert calls[0][0] == "download"
+    assert "/releases/download/" in calls[0][1]["url"]
+    assert Path(calls[0][1]["url"]).name.startswith("parseq")
+    assert calls[1] == ("load", "PARSeq", ["sentinel"])
