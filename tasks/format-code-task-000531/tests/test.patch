+CHARSET_TEST = "0123456789abcdefghijklmnopqrstuvwxyz"
+CHARSET_TRAIN = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"
+
+
+def _plain(value):
+    if isinstance(value, tuple):
+        return list(value)
+    return value
+
+
+def _summary(model):
+    hparams = dict(model.hparams)
+    selected = [
+        "name",
+        "img_size",
+        "patch_size",
+        "embed_dim",
+        "enc_num_heads",
+        "dec_num_heads",
+        "decode_ar",
+        "refine_iters",
+        "iter_size",
+        "batch_size",
+        "lr",
+        "max_label_length",
+        "charset_test",
+        "charset_train",
+    ]
+    result = {
+        "class": type(model).__name__,
+        "hparams": {key: _plain(hparams[key]) for key in selected if key in hparams},
+    }
+    if hasattr(model, "model"):
+        inner = model.model
+        result["inner_class"] = type(inner).__name__
+        if hasattr(inner, "head") and hasattr(inner.head, "out_features"):
+            result["head_out_features"] = inner.head.out_features
+        if hasattr(inner, "encoder") and hasattr(inner.encoder, "patch_embed"):
+            patch_embed = inner.encoder.patch_embed
+            result["patch_embed"] = {
+                "img_size": list(patch_embed.img_size),
+                "patch_size": list(patch_embed.patch_size),
+                "num_patches": patch_embed.num_patches,
+            }
+        if hasattr(inner, "decoder") and hasattr(inner.decoder, "layers"):
+            result["decoder_layers"] = len(inner.decoder.layers)
+    return result
+
+
+def test_create_model_parseq_base_defaults():
+
+
+
+
+    summary = _summary(create_model("parseq", pretrained=False))
+
+    assert summary["class"] == "PARSeq"
+    assert summary["hparams"]["name"] == "parseq"
+    assert summary["hparams"]["decode_ar"] is True
+    assert summary["hparams"]["refine_iters"] == 1
+
+
