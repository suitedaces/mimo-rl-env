+
+def test_no_mutation_of_caller_provided_inputs():
+    overrides = {"img_size": [32, 96], "decode_ar": False, "refine_iters": 2}
+    before = copy.deepcopy(overrides)
+    summary = _summary(create_model("parseq", pretrained=False, **overrides))
+
+    assert summary["class"] == "PARSeq"
+    assert summary["hparams"]["name"] == "parseq"
+    assert summary["hparams"]["img_size"] == [32, 96]
+    assert summary["hparams"]["decode_ar"] is False
+    assert summary["hparams"]["refine_iters"] == 2
+    assert overrides == before
+
+
+def test_no_global_state_matches_fresh_python_process():
+    in_process = _summary(create_model("parseq-tiny", pretrained=False))
+    script = r'''
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+from strhub.models.utils import create_model
+
+def plain(value):
+    if isinstance(value, tuple):
+        return list(value)
+    return value
+
+def summary(model):
+    hparams = dict(model.hparams)
+    selected = [
+        "name", "embed_dim", "enc_num_heads", "dec_num_heads",
+    ]
+    #
+    return {
+        "class": type(model).__name__,
+        "hparams": {key: plain(hparams[key]) for key in selected if key in hparams},
+    }
+
+sys.stdout.write(json.dumps(summary(create_model("parseq-tiny", pretrained=False)), sort_keys=True))
+'''
+    completed = subprocess.run([sys.executable, "-c", script], check=True, text=True, capture_output=True)
+    fresh_process = json.loads(completed.stdout)
+
+    assert fresh_process["class"] == in_process["class"] == "PARSeq"
+    assert fresh_process["hparams"]["name"] == in_process["hparams"]["name"] == "parseq-tiny"
+    assert fresh_process["hparams"]["embed_dim"] == in_process["hparams"]["embed_dim"] == 192
+    assert fresh_process["hparams"]["enc_num_heads"] == in_process["hparams"]["enc_num_heads"] == 3
+    assert fresh_process["hparams"]["dec_num_heads"] == in_process["hparams"]["dec_num_heads"] == 6
+
+
+def test_no_undeclared_network_or_relative_filesystem_side_effects(tmp_path, monkeypatch):
+    def blocked_socket(*args, **kwargs):
+        raise AssertionError("network access is not declared for pretrained=False model construction")
+
+    monkeypatch.setattr(socket, "socket", blocked_socket)
+    monkeypatch.chdir(tmp_path)
+    before = sorted(path.relative_to(tmp_path).as_posix() for path in Path(tmp_path).rglob("*"))
+    summary = _summary(create_model("crnn", pretrained=False))
+
+    assert summary["class"] == "CRNN"
+    assert summary["hparams"]["name"] == "crnn"
+    after = sorted(path.relative_to(tmp_path).as_posix() for path in Path(tmp_path).rglob("*"))
+    assert after == before
