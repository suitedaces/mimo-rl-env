+def test_hub_entry_functions_delegate_to_factory_with_documented_defaults(monkeypatch):
+
+
+
+
+    hubconf = importlib.import_module("hubconf")
+    calls = []
+
+    def fake_create_model(experiment, pretrained=False, **kwargs):
+        calls.append((experiment, pretrained, kwargs))
+        return {"experiment": experiment, "pretrained": pretrained, "kwargs": kwargs}
+
+    monkeypatch.setattr(hubconf, "create_model", fake_create_model)
+    assert hubconf.parseq(pretrained=True) == {
+        "experiment": "parseq",
+        "pretrained": True,
+        "kwargs": {"decode_ar": True, "refine_iters": 1},
+    }
+    assert hubconf.parseq_tiny(pretrained=False, refine_iters=4) == {
+        "experiment": "parseq-tiny",
+        "pretrained": False,
+        "kwargs": {"decode_ar": True, "refine_iters": 4},
+    }
+    assert hubconf.parseq_patch16_224(pretrained=False, decode_ar=False) == {
+        "experiment": "parseq-patch16-224",
+        "pretrained": False,
+        "kwargs": {"decode_ar": False, "refine_iters": 1},
+    }
+    assert hubconf.abinet(pretrained=False) == {
+        "experiment": "abinet",
+        "pretrained": False,
+        "kwargs": {"iter_size": 3},
+    }
+    assert hubconf.trba(pretrained=False, batch_size=16) == {
+        "experiment": "trba",
+        "pretrained": False,
+        "kwargs": {"batch_size": 16},
+    }
+    assert hubconf.vitstr(pretrained=True, img_size=[32, 96]) == {
+        "experiment": "vitstr",
+        "pretrained": True,
+        "kwargs": {"img_size": [32, 96]},
+    }
+    assert hubconf.crnn(pretrained=False, lr=0.001) == {
+        "experiment": "crnn",
+        "pretrained": False,
+        "kwargs": {"lr": 0.001},
+    }
+    assert calls == [
+        ("parseq", True, {"decode_ar": True, "refine_iters": 1}),
+        ("parseq-tiny", False, {"decode_ar": True, "refine_iters": 4}),
+        ("parseq-patch16-224", False, {"decode_ar": False, "refine_iters": 1}),
+        ("abinet", False, {"iter_size": 3}),
+        ("trba", False, {"batch_size": 16}),
+        ("vitstr", True, {"img_size": [32, 96]}),
+        ("crnn", False, {"lr": 0.001}),
+    ]
+
