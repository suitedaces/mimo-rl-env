+def test_referential_transparency_same_input_same_value():
+    first = _summary(create_model("parseq-tiny", pretrained=False))
+    second = _summary(create_model("parseq-tiny", pretrained=False))
+
+    assert first["class"] == "PARSeq"
+    assert first["hparams"]["name"] == "parseq-tiny"
+    assert first["hparams"]["embed_dim"] == 192
+    assert first["hparams"]["enc_num_heads"] == 3
+    assert first["hparams"]["dec_num_heads"] == 6
+    assert second == first
+
+
+def test_repeated_call_returns_fresh_model_with_same_resolved_configuration():
+    first = create_model("parseq", pretrained=False)
+    second = create_model("parseq", pretrained=False)
+    assert first is not second
+
+    assert _summary(second) == _summary(first)
+    assert _summary(second)["class"] == "PARSeq"
+    assert _summary(second)["hparams"]["name"] == "parseq"
+    assert _summary(second)["hparams"]["decode_ar"] is True
+    assert _summary(second)["hparams"]["refine_iters"] == 1
