+++ b/mimo_test_command.sh
@@ -0,0 +1,27 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+export PATH="/opt/node-22/bin:$PATH"
+
+if [ ! -x /testbed/node_modules/.bin/vitest ] || [ ! -d /testbed/node_modules/typescript ]; then
+    yarn install --frozen-lockfile --ignore-engines --ignore-scripts --silent
+fi
+
+cd apps/comments-ui
+
+case "${1:-}" in
+    base)
+        /testbed/node_modules/.bin/vitest run src/utils/helpers.test.ts
+        ;;
+    new)
+        /testbed/node_modules/.bin/vitest run src/AppContext.null-member.test.ts src/components/content/Avatar.null-member.test.tsx
+        /testbed/node_modules/.bin/vitest run --mode production src/components/content/Avatar.null-member.test.tsx
+        ;;
+    *)
+        echo "usage: $0 base|new"
+        exit 2
+        ;;
+esac
