--- /dev/null
+++ b/apps/comments-ui/src/components/content/Avatar.null-member.test.tsx
@@ -0,0 +1,105 @@
+import {cleanup, render, screen} from '@testing-library/react';
+import {afterEach, describe, expect, it, vi} from 'vitest';
+import type {Comment, Member} from '../../AppContext';
+import {Avatar} from './Avatar';
+
+const contextState = vi.hoisted(() => ({
+    memberName: 'Current User'
+}));
+
+vi.mock('../../AppContext', async () => {
+    const actual = await vi.importActual<typeof import('../../AppContext')>('../../AppContext');
+
+    return {
+        ...actual,
+        useAppContext: () => ({
+            member: makeMember(contextState.memberName),
+            t: (value: string) => value
+        })
+    };
+});
+
+afterEach(() => {
+    contextState.memberName = 'Current User';
+    cleanup();
+});
+
+const makeMember = (name: string): Member => {
+    return {
+        id: `${name || 'anonymous'}-id`,
+        uuid: `${name || 'anonymous'}-uuid`,
+        name,
+        avatar: '',
+        expertise: ''
+    };
+};
+
+const makeComment = (member: Comment['member'], override: Partial<Comment> = {}): Comment => {
+    return {
+        id: 'comment-under-test',
+        post_id: 'post-under-test',
+        replies: [],
+        status: 'published',
+        liked: false,
+        count: {
+            replies: 0,
+            likes: 0
+        },
+        member,
+        edited_at: '',
+        created_at: '2024-01-01T00:00:00.000Z',
+        html: '<p>Comment body</p>',
+        ...override
+    };
+};
+
+const getRenderedAvatarText = () => {
+    return screen.getByTestId('avatar-background').textContent?.trim();
+};
+
+describe('Avatar comment author initials', function () {
+    it('does not use the current member initials when no comment is bound', function () {
+        render(<Avatar />);
+
+        const background = screen.getByTestId('avatar-background');
+        expect(background.textContent).not.toBe('CU');
+        expect(background.textContent?.trim().length ?? 0).toBe(0);
+    });
+
+    it('does not use any current member initials when no comment is bound', function () {
+        contextState.memberName = 'Different Reader';
+
+        render(<Avatar />);
+
+        const background = screen.getByTestId('avatar-background');
+        expect(background.textContent).not.toBe('DR');
+        expect(background.textContent?.trim().length ?? 0).toBe(0);
+    });
+
+    it('uses the bound comment author instead of the current member', function () {
+        render(<Avatar comment={makeComment(makeMember('External Author'))} />);
+
+        const background = screen.getByTestId('avatar-background');
+        expect(background.textContent).toBe('EA');
+        expect(background.textContent).not.toBe('CU');
+    });
+
+    it('keeps deleted and anonymous comment author fallbacks distinct', function () {
+        render(<Avatar comment={makeComment(null, {id: 'deleted-author-comment'})} />);
+        const deletedAuthorText = getRenderedAvatarText();
+        expect(deletedAuthorText).toBeTruthy();
+
+        cleanup();
+
+        const reply = makeComment(makeMember('Reply Author'), {id: 'reply-comment'});
+        render(<Avatar comment={makeComment(null, {id: 'another-deleted-comment', replies: [reply]})} />);
+        expect(getRenderedAvatarText()).toBe(deletedAuthorText);
+
+        cleanup();
+
+        render(<Avatar comment={makeComment(makeMember(''), {id: 'anonymous-author-comment'})} />);
+        const anonymousAuthorText = getRenderedAvatarText();
+        expect(anonymousAuthorText).toBeTruthy();
+        expect(anonymousAuthorText).not.toBe(deletedAuthorText);
+    });
+});
