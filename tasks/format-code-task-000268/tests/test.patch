@@ -0,0 +1,42 @@
+import type {Comment} from './AppContext';
+import path from 'path';
+import ts from 'typescript';
+
+const commentMemberTypeIncludesNull = () => {
+    const fileName = path.resolve(process.cwd(), 'src/AppContext.ts');
+    const program = ts.createProgram([fileName], {
+        jsx: ts.JsxEmit.ReactJSX,
+        lib: ['lib.dom.d.ts', 'lib.dom.iterable.d.ts', 'lib.esnext.d.ts'],
+        module: ts.ModuleKind.ESNext,
+        moduleResolution: ts.ModuleResolutionKind.Bundler,
+        skipLibCheck: true,
+        strictNullChecks: true,
+        target: ts.ScriptTarget.ESNext
+    });
+    const checker = program.getTypeChecker();
+    const source = program.getSourceFile(fileName);
+    const moduleSymbol = source && checker.getSymbolAtLocation(source);
+    const exportedCommentSymbol = moduleSymbol && checker.getExportsOfModule(moduleSymbol).find((symbol) => {
+        return symbol.getName() === 'Comment';
+    });
+    const commentSymbol = exportedCommentSymbol && (exportedCommentSymbol.flags & ts.SymbolFlags.Alias ?
+        checker.getAliasedSymbol(exportedCommentSymbol) :
+        exportedCommentSymbol);
+    const commentType = commentSymbol && checker.getDeclaredTypeOfSymbol(commentSymbol);
+    const memberSymbol = commentType && commentType.getProperty('member');
+    const memberType = memberSymbol && checker.getTypeOfSymbolAtLocation(memberSymbol, source!);
+
+    return Boolean(memberType?.isUnion() && memberType.types.some((type) => {
+        return Boolean(type.flags & ts.TypeFlags.Null);
+    }));
+};
+
+describe('Comment deleted member contract', function () {
+    it('allows deleted comment authors to be represented as member null', function () {
+        type MemberCanBeNull = null extends Comment['member'] ? true : false;
+        const memberCanBeNull: MemberCanBeNull = true;
+
+        expect(memberCanBeNull).to.equal(true);
+        expect(commentMemberTypeIncludesNull()).to.equal(true);
+    });
+});
diff --git a/apps/comments-ui/src/components/content/Avatar.null-member.test.tsx b/apps/comments-ui/src/components/content/Avatar.null-member.test.tsx
