+package org.sakaiproject.gradebookng.business.util;
+
+import java.io.ByteArrayInputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.junit.Assert;
+import org.junit.Test;
+import org.mockito.Mockito;
+import org.sakaiproject.gradebookng.business.exception.GbImportExportInvalidFileTypeException;
+import org.sakaiproject.gradebookng.business.model.GbGradeInfo;
+import org.sakaiproject.gradebookng.business.model.GbStudentGradeInfo;
+import org.sakaiproject.gradebookng.business.model.ImportedCell;
+import org.sakaiproject.gradebookng.business.model.ImportedColumn;
+import org.sakaiproject.gradebookng.business.model.ImportedRow;
+import org.sakaiproject.gradebookng.business.model.ImportedSpreadsheetWrapper;
+import org.sakaiproject.gradebookng.business.model.ProcessedGradeItem;
+import org.sakaiproject.service.gradebook.shared.Assignment;
+import org.sakaiproject.service.gradebook.shared.GradeDefinition;
+import org.sakaiproject.user.api.User;
+
+public class TestImportGradesHardening {
+
+    @Test
+    public void when_csvMimeHasMixedCase_thenCsvIsParsed() throws Exception {
+        final ImportedSpreadsheetWrapper result = parseCsv("TeXt/CsV", "Ada");
+
+        Assert.assertEquals(1, result.getRows().size());
+        Assert.assertEquals("8", result.getRows().get(0).getCellMap().get("Quiz").getScore());
+    }
+
+    @Test
+    public void when_csvMimeHasParameters_thenCsvIsParsed() throws Exception {
+        final ImportedSpreadsheetWrapper result = parseCsv("text/csv ; charset=UTF-8", "Ada");
+
+        Assert.assertEquals(1, result.getRows().size());
+        Assert.assertEquals("8", result.getRows().get(0).getCellMap().get("Quiz").getScore());
+    }
+
+    @Test
+    public void when_csvContainsUnicode_thenUtf8TextIsPreserved() throws Exception {
+        final ImportedSpreadsheetWrapper result = parseCsv("text/csv", "\u00C9lodie");
+
+        Assert.assertEquals("\u00C9lodie", result.getRows().get(0).getStudentName());
+    }
+
+    private ImportedSpreadsheetWrapper parseCsv(final String mimetype, final String studentName) throws Exception {
+        final String csv = "Student ID,Student Name,Quiz [10.0]\nstudent1," + studentName + ",8\n";
+        final Map<String, String> users = new HashMap<String, String>();
+        users.put("student1", "uuid-1");
+
+        return ImportGradesHelper.parseImportedGradeFile(
+                new ByteArrayInputStream(csv.getBytes(StandardCharsets.UTF_8)), mimetype, users);
+    }
+
+    @Test
+    public void when_gradeTitleContainsPunctuation_thenItemAndCommentColumnsAreMapped() throws Exception {
+        final String csv = "Student ID,Student Name,Lab-1 (Final) [10.0],* Lab-1 (Final)\n"
+                + "student1,Ada,9,ready\n";
+        final Map<String, String> users = new HashMap<String, String>();
+        users.put("student1", "uuid-1");
+
+        final ImportedSpreadsheetWrapper result = ImportGradesHelper.parseImportedGradeFile(
+                new ByteArrayInputStream(csv.getBytes(StandardCharsets.UTF_8)), "text/csv", users);
+
+        Assert.assertEquals(4, result.getColumns().size());
+        Assert.assertEquals("Lab-1 (Final)", result.getColumns().get(2).getColumnTitle());
+        Assert.assertEquals("10.0", result.getColumns().get(2).getPoints());
+        Assert.assertEquals(ImportedColumn.Type.GB_ITEM_WITH_POINTS, result.getColumns().get(2).getType());
+        Assert.assertEquals(ImportedColumn.Type.COMMENTS, result.getColumns().get(3).getType());
+        Assert.assertEquals("ready", result.getRows().get(0).getCellMap().get("Lab-1 (Final)").getComment());
+    }
+
+    @Test
+    public void when_importedDecimalOnlyChangesFormatting_thenStatusIsSkip() {
+        final ProcessedGradeItem item = processWithScore("7.00");
+        Assert.assertEquals(ProcessedGradeItem.Status.SKIP, item.getStatus());
+    }
+
+    @Test
+    public void when_importedDecimalChangesValue_thenStatusIsUpdate() {
+        final ProcessedGradeItem item = processWithScore("7.01");
+        Assert.assertEquals(ProcessedGradeItem.Status.UPDATE, item.getStatus());
+    }
+
+    @Test(expected = GbImportExportInvalidFileTypeException.class)
+    public void when_mimeIsUnsupported_thenImportIsRejected() throws Exception {
+        final Map<String, String> users = new HashMap<String, String>();
+        users.put("student1", "uuid-1");
+        ImportGradesHelper.parseImportedGradeFile(new ByteArrayInputStream(new byte[0]), "application/octet-stream", users);
+    }
+
+    private ProcessedGradeItem processWithScore(final String importedScore) {
+        final Assignment assignment = new Assignment();
+        assignment.setId(41L);
+        assignment.setName("Quiz");
+        assignment.setPoints(10.0);
+
+        final User user = Mockito.mock(User.class);
+        Mockito.when(user.getId()).thenReturn("uuid-1");
+        Mockito.when(user.getEid()).thenReturn("student1");
+        final GbStudentGradeInfo current = new GbStudentGradeInfo(user);
+        final GradeDefinition existingDefinition = new GradeDefinition();
+        existingDefinition.setGrade("7");
+        current.addGrade(41L, new GbGradeInfo(existingDefinition));
+
+        final ImportedSpreadsheetWrapper wrapper = new ImportedSpreadsheetWrapper();
+        wrapper.setColumns(new ArrayList<ImportedColumn>());
+        wrapper.getColumns().add(new ImportedColumn("Quiz", "10.0", ImportedColumn.Type.GB_ITEM_WITH_POINTS));
+        final ImportedRow row = new ImportedRow();
+        row.setStudentEid("student1");
+        row.setStudentUuid("uuid-1");
+        final ImportedCell cell = new ImportedCell();
+        cell.setScore(importedScore);
+        row.getCellMap().put("Quiz", cell);
+        final List<ImportedRow> rows = new ArrayList<ImportedRow>();
+        rows.add(row);
+        wrapper.setRows(rows);
+
+        final List<Assignment> assignments = new ArrayList<Assignment>();
+        assignments.add(assignment);
+        final List<GbStudentGradeInfo> currentGrades = new ArrayList<GbStudentGradeInfo>();
+        currentGrades.add(current);
+        return ImportGradesHelper.processImportedGrades(wrapper, assignments, currentGrades).get(0);
+    }
+}

