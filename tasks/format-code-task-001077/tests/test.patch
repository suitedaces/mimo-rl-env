+#!/bin/bash
+set -euo pipefail
+
+
+BUILD_DIR="$(mktemp -d /tmp/codespec-gradebookng.XXXXXX)"
+CLASSPATH=""
+while IFS= read -r classes_dir; do
+  CLASSPATH="${CLASSPATH:+${CLASSPATH}:}${classes_dir}"
+done < <(find . -type d -path '*/target/classes' -print)
+
+for artifact in \
+  gradebookng/tool/target/gradebookng-tool-12-SNAPSHOT/WEB-INF/lib/*.jar \
+  /root/.m2/repository/commons-lang/commons-lang/2.6/commons-lang-2.6.jar \
+  /root/.m2/repository/net/sf/opencsv/opencsv/2.3/opencsv-2.3.jar \
+  /root/.m2/repository/org/projectlombok/lombok/1.16.8/lombok-1.16.8.jar \
+  /root/.m2/repository/org/mockito/mockito-all/1.10.19/mockito-all-1.10.19.jar \
+  /root/.m2/repository/junit/junit/4.12/junit-4.12.jar \
+  /root/.m2/repository/org/hamcrest/hamcrest-core/1.3/hamcrest-core-1.3.jar \
+  /root/.m2/repository/org/slf4j/slf4j-api/1.7.21/slf4j-api-1.7.21.jar; do
+  test -f "${artifact}"
+  CLASSPATH="${CLASSPATH}:${artifact}"
+done
+
+javac -source 8 -target 8 \
+  -cp "${CLASSPATH}" \
+  -sourcepath gradebookng/tool/src/java \
+  -d "${BUILD_DIR}" \
+  gradebookng/tool/src/java/org/sakaiproject/gradebookng/business/util/ImportGradesHelper.java \
+  gradebookng/tool/src/java/org/sakaiproject/gradebookng/business/model/GbGradeInfo.java \
+  gradebookng/tool/src/java/org/sakaiproject/gradebookng/business/model/GbStudentGradeInfo.java \
+  gradebookng/tool/src/java/org/sakaiproject/gradebookng/business/model/ImportedCell.java \
+  gradebookng/tool/src/java/org/sakaiproject/gradebookng/business/model/ImportedColumn.java \
+  gradebookng/tool/src/java/org/sakaiproject/gradebookng/business/model/ImportedRow.java \
+  gradebookng/tool/src/java/org/sakaiproject/gradebookng/business/model/ImportedSpreadsheetWrapper.java \
+  gradebookng/tool/src/java/org/sakaiproject/gradebookng/business/model/ProcessedGradeItem.java \
+  gradebookng/tool/src/java/org/sakaiproject/gradebookng/business/model/ProcessedGradeItemDetail.java \
+  gradebookng/tool/src/java/org/sakaiproject/gradebookng/tool/model/AssignmentStudentGradeInfo.java \
+  gradebookng/tool/src/java/org/sakaiproject/gradebookng/business/exception/*.java \
+  gradebookng/tool/src/test/org/sakaiproject/gradebookng/business/util/TestImportGradesHelper.java \
+  gradebookng/tool/src/test/org/sakaiproject/gradebookng/business/util/TestImportGradesHardening.java
+
+java -Dfile.encoding=ISO-8859-1 \
+  -cp "${BUILD_DIR}:${CLASSPATH}:gradebookng/tool/src/test/resources" \
+  org.junit.runner.JUnitCore \
+  org.sakaiproject.gradebookng.business.util.TestImportGradesHelper \
+  org.sakaiproject.gradebookng.business.util.TestImportGradesHardening
