diff --git a/internal/domain/iam_domain_contract_test.go b/internal/domain/iam_domain_contract_test.go
new file mode 100644
index 000000000..e1d48e36a
--- /dev/null
+++ b/internal/domain/iam_domain_contract_test.go
@@ -0,0 +1,94 @@
+package domain
+
+import (
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/zitadel/zitadel/internal/zerrors"
+)
+
+func TestNewIAMDomainNameContractNormalization(t *testing.T) {
+	tests := []struct {
+		name, org, iam, want string
+	}{
+		{
+			name: "trim and collapse all whitespace",
+			org:  "  My\tOrg   Name  ",
+			iam:  "Example.LOCAL",
+			want: "my-org-name.example.local",
+		},
+		{
+			name: "remove punctuation but preserve unicode letters",
+			org:  "Mí >** 名?",
+			iam:  "LOCALHOST",
+			want: "mí-名.localhost",
+		},
+		{
+			name: "trim separators introduced by invalid characters",
+			org:  "---Acme---",
+			iam:  "localhost",
+			want: "acme.localhost",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := NewIAMDomainName(tt.org, tt.iam)
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			if got != tt.want {
+				t.Fatalf("got %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestNewIAMDomainNameContractUnicodeAndLength(t *testing.T) {
+
+	org := strings.Repeat("é", 40)
+	got, err := NewIAMDomainName(org, "localhost")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	label := strings.TrimSuffix(got, ".localhost")
+	if !utf8.ValidString(label) {
+		t.Fatalf("label is not valid UTF-8: %q", label)
+	}
+	if len(label) > 63 || len([]rune(label)) != 31 {
+		t.Fatalf("label %q has %d bytes and %d runes; want 31 runes and <=63 bytes", label, len(label), len([]rune(label)))
+	}
+}
+
+func TestNewIAMDomainNameContractRejectsOversizedDomain(t *testing.T) {
+
+
+	tooLong := strings.Repeat("x", 254)
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("NewIAMDomainName panicked for oversized base domain: %v", r)
+		}
+	}()
+	if _, err := NewIAMDomainName("acme", tooLong); !zerrors.IsErrorInvalidArgument(err) {
+		t.Fatalf("oversized base domain error = %v, want invalid argument", err)
+	}
+}
+
+func TestNewIAMDomainNameContractBoundaries(t *testing.T) {
+
+	org := strings.Repeat("a", 62) + "-suffix"
+	got, err := NewIAMDomainName(org, "localhost")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	label := strings.TrimSuffix(got, ".localhost")
+	if len(label) != 62 || strings.HasPrefix(label, "-") || strings.HasSuffix(label, "-") {
+		t.Fatalf("label %q violates boundary rules", label)
+	}
+
+	for _, org := range []string{"", "!!!", "---"} {
+		if _, err := NewIAMDomainName(org, "localhost"); !zerrors.IsErrorInvalidArgument(err) {
+			t.Errorf("org %q error = %v, want invalid argument", org, err)
+		}
+	}
+}
