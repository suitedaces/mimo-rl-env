+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096 --require=/opt/stage4a/offline-network-guard.cjs"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+export npm_config_audit=false
+export npm_config_fund=false
+export npm_config_offline=true
+export npm_config_update_notifier=false
+
+test -x ./node_modules/.bin/del-cli
+test -x ./node_modules/.bin/sass
+test -x ./node_modules/.bin/rollup
+test -x ./node_modules/.bin/vitest
+
+./node_modules/.bin/del-cli build src/style.ts
+./build-style.sh
+./node_modules/.bin/rollup -c >/dev/null
+exec ./node_modules/.bin/vitest run --config ./vitest.config.ts /workspace/repo/usercase-test-coderl/spec_loading_embed_options.test.ts
