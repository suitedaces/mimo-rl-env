+import {execFileSync} from 'node:child_process';
+import {expect, test, vi} from 'vitest';
+import embed, {vega} from '../src/embed';
+
+type ResourceMap = Record<string, string>;
+
+function makeLoader(resources: ResourceMap) {
+  const calls: string[] = [];
+  return {
+    calls,
+    async load(uri: string) {
+      calls.push(uri);
+      if (!(uri in resources)) {
+        throw new Error(`unexpected load: ${uri}`);
+      }
+      return resources[uri];
+    },
+    async sanitize(uri: string) {
+      return {href: uri};
+    },
+  };
+}
+
+const urlLoadedVlSpec = {
+  $schema: 'https://vega.github.io/schema/vega-lite/v6.json',
+  description: 'Remote bar chart',
+  data: {values: [{category: 'A', amount: 2}, {category: 'B', amount: 5}]},
+  mark: 'bar',
+  encoding: {
+    x: {field: 'category', type: 'nominal'},
+    y: {field: 'amount', type: 'quantitative'},
+  },
+};
+
+const configLoadedVlSpec = {
+  $schema: 'https://vega.github.io/schema/vega-lite/v6.json',
+  data: {values: [{category: 'A', amount: 2}]},
+  mark: 'bar',
+  encoding: {
+    x: {field: 'category', type: 'nominal'},
+    y: {field: 'amount', type: 'quantitative'},
+  },
+};
+
+const patchLoadedVlSpec = {
+  $schema: 'https://vega.github.io/schema/vega-lite/v6.json',
+  data: {values: [{x: 1}, {x: 2}]},
+  mark: 'point',
+  encoding: {x: {field: 'x', type: 'quantitative'}},
+};
+
+function cloneJson<T>(value: T): T {
+  return JSON.parse(JSON.stringify(value));
+}
+
+async function resolvedProjection(spec = urlLoadedVlSpec) {
+  const loader = makeLoader({'/remote.vl.json': JSON.stringify(spec)});
+  const result = await embed(document.createElement('div'), '/remote.vl.json', {
+    loader,
+    actions: false,
+    defaultStyle: false,
+  });
+
+  const projection = {
+    calls: loader.calls,
+    spec: cloneJson(result.spec),
+    embedOptions: {
+      actions: result.embedOptions.actions,
+      defaultStyle: result.embedOptions.defaultStyle,
+      config: result.embedOptions.config,
+    },
+    vgSpec: {
+      description: result.vgSpec.description,
+    },
+  };
+  result.finalize();
+  return projection;
+}
+
+test('loads a URL spec through opts.loader and returns the parsed Vega-Lite object', async () => {
+
+
+  const actual = await resolvedProjection();
+
+
+  expect(actual.calls).toContain('/remote.vl.json');
+  expect(actual.spec).toEqual(urlLoadedVlSpec);
+  expect(actual.embedOptions.actions).toBe(false);
+  expect(actual.embedOptions.defaultStyle).toBe(false);
+  expect(actual.vgSpec.description).toBe('Remote bar chart');
+});
+
+test('applies usermeta embed options and builds the view with the resolved loader options', async () => {
+
+
+  const spec = {
+    $schema: 'https://vega.github.io/schema/vega-lite/v6.json',
+    data: {values: [{x: 1}, {x: 2}]},
+    mark: 'point',
+    encoding: {x: {field: 'x', type: 'quantitative'}},
+    usermeta: {
+      embedOptions: {
+        loader: {target: '_blank'},
+        logLevel: vega.None,
+        actions: false,
+        renderer: 'svg',
+      },
+    },
+  };
+
+  const result = await embed(document.createElement('div'), spec, {defaultStyle: false});
+  const sanitized = await result.view.loader().sanitize('https://example.test/thing.png');
+
+
+  expect(result.embedOptions).toMatchObject({
+    loader: {target: '_blank'},
+    logLevel: vega.None,
+    actions: false,
+    renderer: 'svg',
+  });
+
+  expect(sanitized).toMatchObject({target: '_blank'});
+  result.finalize();
+});
+
+test('sanitizes string defaultStyle from usermeta embed options', async () => {
+
+
+  document.head.querySelector('style#vega-embed-style')?.remove();
+  const spec = {
+    $schema: 'https://vega.github.io/schema/vega-lite/v6.json',
+    data: {values: [{x: 1}]},
+    mark: 'point',
+    encoding: {x: {field: 'x', type: 'quantitative'}},
+    usermeta: {
+      embedOptions: {
+        defaultStyle: 'body{background:url(https://evil.example/x)}',
+        actions: false,
+      },
+    },
+  };
+
+  const result = await embed(document.createElement('div'), spec);
+
+  expect(result.embedOptions.defaultStyle).toBe(false);
+
+  expect(document.head.innerHTML.includes('body{background:url(https://evil.example/x)}')).toBe(false);
+  result.finalize();
+});
+
+test('loads string config through the resolved loader before rendering', async () => {
+
+
+  const loader = makeLoader({
+    '/chart-config.json': JSON.stringify({background: 'white', axis: {labelColor: 'firebrick'}}),
+  });
+
+  const result = await embed(document.createElement('div'), configLoadedVlSpec, {
+    loader,
+    config: '/chart-config.json',
+    actions: false,
+    defaultStyle: false,
+  });
+
+
+  expect(loader.calls).toContain('/chart-config.json');
+  expect(result.embedOptions.config).toEqual({background: 'white', axis: {labelColor: 'firebrick'}});
+  expect(result.vgSpec.background).toBe('white');
+  result.finalize();
+});
+
+test('loads string patch through the resolved loader before rendering', async () => {
+
+
+  const loader = makeLoader({
+    '/chart-patch.json': JSON.stringify([{op: 'add', path: '/description', value: 'Hello World!'}]),
+  });
+
+  const result = await embed(document.createElement('div'), patchLoadedVlSpec, {
+    loader,
+    patch: '/chart-patch.json',
+    actions: false,
+    defaultStyle: false,
+  });
+
+
+  expect(loader.calls).toContain('/chart-patch.json');
+  expect(result.embedOptions.patch).toEqual([{op: 'add', path: '/description', value: 'Hello World!'}]);
+  expect(result.vgSpec.description).toBe('Hello World!');
+  result.finalize();
+});
+
+test('uses explicit opts.loader to load external options from usermeta', async () => {
+
+
+  const explicitLoader = makeLoader({
+    '/meta-config.json': JSON.stringify({background: 'mintcream'}),
+  });
+  const spec = {
+    $schema: 'https://vega.github.io/schema/vega-lite/v6.json',
+    data: {values: [{x: 1}]},
+    mark: 'point',
+    encoding: {x: {field: 'x', type: 'quantitative'}},
+    usermeta: {
+      embedOptions: {
+        loader: {target: '_blank'},
+        config: '/meta-config.json',
+        actions: false,
+      },
+    },
+  };
+
+  const result = await embed(document.createElement('div'), spec, {
+    loader: explicitLoader,
+    defaultStyle: false,
+  });
+
+
+  expect(explicitLoader.calls).toContain('/meta-config.json');
+  expect(result.embedOptions.config).toEqual({background: 'mintcream'});
+  expect(result.vgSpec.background).toBe('mintcream');
+  result.finalize();
+});
+
+test('rejects invalid loaded spec JSON with SyntaxError', async () => {
+
+
+  const loader = makeLoader({'/bad-spec.json': '{bad'});
+
+  await expect(
+    embed(document.createElement('div'), '/bad-spec.json', {loader, actions: false, defaultStyle: false}),
+  ).rejects.toThrow(SyntaxError);
+
+  expect(loader.calls).toContain('/bad-spec.json');
+});
+
+test('rejects invalid loaded config JSON with SyntaxError', async () => {
+
+
+  const loader = makeLoader({'/bad-config.json': '{bad'});
+
+  await expect(
+    embed(document.createElement('div'), configLoadedVlSpec, {
+      loader,
+      config: '/bad-config.json',
+      actions: false,
+      defaultStyle: false,
+    }),
+  ).rejects.toThrow(SyntaxError);
+
+  expect(loader.calls).toContain('/bad-config.json');
+});
+
+test('rejects invalid loaded patch JSON with SyntaxError', async () => {
+
+
+  const loader = makeLoader({'/bad-patch.json': '[{"op":"add"'});
+
+  await expect(
+    embed(document.createElement('div'), patchLoadedVlSpec, {
+      loader,
+      patch: '/bad-patch.json',
+      actions: false,
+      defaultStyle: false,
+    }),
+  ).rejects.toThrow(SyntaxError);
+
+  expect(loader.calls).toContain('/bad-patch.json');
+});
+
+test('is referentially transparent for repeated URL spec resolution values', async () => {
+  const first = await resolvedProjection();
+  const second = await resolvedProjection();
+
+
+  expect(first.calls).toContain('/remote.vl.json');
+  expect(first.spec).toEqual(urlLoadedVlSpec);
+  expect(first.vgSpec.description).toBe('Remote bar chart');
+  expect(second).toEqual(first);
+});
+
+test('applies usermeta embed options and explicit opts on a parsed Vega spec', async () => {
+  const spec = {
+    $schema: 'https://vega.github.io/schema/vega/v6.json',
+    width: 220,
+    height: 120,
+    marks: [],
+    usermeta: {
+      embedOptions: {
+        actions: false,
+        renderer: 'svg',
+      },
+    },
+  };
+  const opts = {defaultStyle: false, width: 220, height: 120};
+
+  const result = await embed(document.createElement('div'), spec, opts);
+
+
+  expect(result.spec).toBe(spec);
+  expect(result.embedOptions).toMatchObject({
+    actions: false,
+    renderer: 'svg',
+    defaultStyle: false,
+    width: 220,
+    height: 120,
+  });
+  result.finalize();
+});
+
+test('does not reuse in-process state across different spec inputs', async () => {
+  const original = await resolvedProjection();
+  const noise = await resolvedProjection({
+    $schema: 'https://vega.github.io/schema/vega-lite/v6.json',
+    description: 'Noise line chart',
+    data: {values: [{x: 0, y: 1}, {x: 1, y: 3}]},
+    mark: 'line',
+    encoding: {
+      x: {field: 'x', type: 'quantitative'},
+      y: {field: 'y', type: 'quantitative'},
+    },
+  });
+  const afterNoise = await resolvedProjection();
+
+
+  expect(noise.spec.description).toBe('Noise line chart');
+  expect(noise.vgSpec.description).toBe('Noise line chart');
+  expect(afterNoise.spec).toEqual(original.spec);
+  expect(afterNoise.vgSpec.description).toBe(original.vgSpec.description);
+});
+
+test('matches fresh-process URL spec resolution output', async () => {
+  const inProcess = await resolvedProjection();
+  const script = String.raw`
+    import {JSDOM} from 'jsdom';
+    const dom = new JSDOM('<!doctype html><html><head></head><body></body></html>', {resources: 'usable'});
+    globalThis.window = dom.window;
+    globalThis.document = dom.window.document;
+    globalThis.HTMLElement = dom.window.HTMLElement;
+    globalThis.ShadowRoot = dom.window.ShadowRoot;
+    const embed = (await import('./build/embed.js')).default;
+    const spec = {
+      $schema: 'https://vega.github.io/schema/vega-lite/v6.json',
+      description: 'Remote bar chart',
+      data: {values: [{category: 'A', amount: 2}, {category: 'B', amount: 5}]},
+      mark: 'bar',
+      encoding: {
+        x: {field: 'category', type: 'nominal'},
+        y: {field: 'amount', type: 'quantitative'},
+      },
+    };
+    const calls = [];
+    const loader = {
+      calls,
+      async load(uri) {
+        calls.push(uri);
+        if (uri !== '/remote.vl.json') throw new Error('unexpected load: ' + uri);
+        return JSON.stringify(spec);
+      },
+      async sanitize(uri) {
+        return {href: uri};
+      },
+    };
+    const result = await embed(document.createElement('div'), '/remote.vl.json', {
+      loader,
+      actions: false,
+      defaultStyle: false,
+    });
+    const projection = {
+      calls,
+      spec: result.spec,
+      embedOptions: {
+        actions: result.embedOptions.actions,
+        defaultStyle: result.embedOptions.defaultStyle,
+      },
+      vgSpec: {
+        description: result.vgSpec.description,
+      },
+    };
+    result.finalize();
+    process.stdout.write(JSON.stringify(projection));
+  `;
+
+  const freshProcess = JSON.parse(
+    execFileSync(process.execPath, ['--input-type=module', '-e', script], {
+      cwd: '/workspace/repo',
+      encoding: 'utf8',
+    }),
+  );
+
+
+  expect(freshProcess.calls).toContain('/remote.vl.json');
+  expect(freshProcess.spec).toEqual(inProcess.spec);
+  expect(freshProcess.embedOptions).toMatchObject({
+    actions: false,
+    defaultStyle: false,
+  });
+  expect(freshProcess.vgSpec.description).toBe(inProcess.vgSpec.description);
+});
+
+test('uses declared loader loads rather than global fetch for URL specs', async () => {
+  const fetchSpy = vi.fn(async () => {
+    throw new Error('unexpected network fetch');
+  });
+  vi.stubGlobal('fetch', fetchSpy);
+
+  try {
+    const loader = makeLoader({'/declared-spec.json': JSON.stringify(urlLoadedVlSpec)});
+    const result = await embed(document.createElement('div'), '/declared-spec.json', {
+      loader,
+      actions: false,
+      defaultStyle: false,
+    });
+
+
+    expect(cloneJson(result.spec)).toEqual(urlLoadedVlSpec);
+    expect(loader.calls).toContain('/declared-spec.json');
+    expect(fetchSpy).toHaveBeenCalledTimes(0);
+    result.finalize();
+  } finally {
+    vi.unstubAllGlobals();
+  }
+});
