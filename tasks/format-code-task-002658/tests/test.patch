+test('use extendEnv with shell:true and explicit empty env (sync)', t => {
+	const {stdout} = m.sync('echo $FOO', {shell: true, env: {}, extendEnv: true});
+	t.is(stdout, 'foo');
+});
+
+test('use extendEnv with shell:true and explicit empty env (async)', async t => {
+	const {stdout} = await m('echo $FOO', {shell: true, env: {}, extendEnv: true});
+	t.is(stdout, 'foo');
+});
+
+test('default extendEnv with shell:true merges process.env and provided env (sync)', t => {
+	const {stdout} = m.sync('echo $FOO+$BAR', {shell: true, env: {BAR: 'bar'}});
+	t.is(stdout, 'foo+bar');
+});
+
+test('default extendEnv with m.shell() merges process.env and provided env', async t => {
+	const {stdout} = await m.shell('echo $FOO+$BAR', {env: {BAR: 'bar'}});
+	t.is(stdout, 'foo+bar');
+});
+
+test('extendEnv:false with shell:true uses only provided env, not process.env', t => {
+	const {stdout} = m.sync('echo $FOO+$BAR', {shell: true, env: {BAR: 'bar'}, extendEnv: false});
+	t.is(stdout, '+bar');
+});
