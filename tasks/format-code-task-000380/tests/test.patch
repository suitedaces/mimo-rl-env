@@ -0,0 +1,137 @@
+package file
+
+import "testing"
+
+func TestCodespecGlobMatchSegmentWildcards(t *testing.T) {
+	tests := []struct {
+		name    string
+		pattern string
+		path    string
+		want    bool
+	}{
+		{name: "star within one segment", pattern: "/opt/*/config.json", path: "/opt/app/config.json", want: true},
+		{name: "star may be empty", pattern: "/opt/*/config.json", path: "/opt//config.json", want: true},
+		{name: "star cannot cross separator", pattern: "/opt/*/config.json", path: "/opt/app/cache/config.json", want: false},
+		{name: "question matches one ASCII rune", pattern: "/opt/?/config.json", path: "/opt/x/config.json", want: true},
+		{name: "question matches one Unicode rune", pattern: "/cafe/?.txt", path: "/cafe/猫.txt", want: true},
+		{name: "question does not match two Unicode runes", pattern: "/cafe/?.txt", path: "/cafe/猫犬.txt", want: false},
+		{name: "question cannot match separator", pattern: "/opt/?/config.json", path: "/opt//config.json", want: false},
+	}
+
+	assertCodespecGlobCases(t, tests)
+}
+
+func TestCodespecGlobMatchRecursiveComponents(t *testing.T) {
+	tests := []struct {
+		name    string
+		pattern string
+		path    string
+		want    bool
+	}{
+		{name: "middle globstar matches zero components", pattern: "/usr/**/package.json", path: "/usr/package.json", want: true},
+		{name: "middle globstar matches several components", pattern: "/usr/**/package.json", path: "/usr/lib/node/package.json", want: true},
+		{name: "leading globstar matches root file", pattern: "/**/manifest.*", path: "/manifest.json", want: true},
+		{name: "leading globstar matches nested file", pattern: "/**/manifest.*", path: "/a/b/manifest.xml", want: true},
+		{name: "trailing globstar includes base directory", pattern: "/var/lib/**", path: "/var/lib", want: true},
+		{name: "trailing globstar includes descendants", pattern: "/var/lib/**", path: "/var/lib/a/b", want: true},
+		{name: "globstar is still anchored", pattern: "/usr/**/package.json", path: "/tmp/usr/package.json", want: false},
+		{name: "bare globstar matches separators", pattern: "**", path: "a/b/c", want: true},
+		{name: "bare globstar matches empty path", pattern: "**", path: "", want: true},
+	}
+
+	assertCodespecGlobCases(t, tests)
+}
+
+func TestCodespecGlobMatchNonComponentStarRuns(t *testing.T) {
+	tests := []struct {
+		name    string
+		pattern string
+		path    string
+		want    bool
+	}{
+		{name: "double star inside component behaves as star", pattern: "/root/ab**cd/end", path: "/root/abXYZcd/end", want: true},
+		{name: "double star inside component cannot cross separator", pattern: "/root/ab**cd/end", path: "/root/ab/x/cd/end", want: false},
+		{name: "three stars as component are not recursive", pattern: "/root/***/end", path: "/root/a/b/end", want: false},
+		{name: "three stars as component match one segment", pattern: "/root/***/end", path: "/root/segment/end", want: true},
+	}
+
+	assertCodespecGlobCases(t, tests)
+}
+
+func TestCodespecGlobMatchCharacterClasses(t *testing.T) {
+	tests := []struct {
+		name    string
+		pattern string
+		path    string
+		want    bool
+	}{
+		{name: "ASCII range", pattern: "/logs/file[0-9].txt", path: "/logs/file7.txt", want: true},
+		{name: "range is one rune", pattern: "/logs/file[0-9].txt", path: "/logs/file12.txt", want: false},
+		{name: "listed characters", pattern: "/logs/[abc].txt", path: "/logs/b.txt", want: true},
+		{name: "bang negation accepts outside", pattern: "/logs/[!a-c].txt", path: "/logs/z.txt", want: true},
+		{name: "bang negation rejects inside", pattern: "/logs/[!a-c].txt", path: "/logs/b.txt", want: false},
+		{name: "caret negation", pattern: "/logs/[^0-9].txt", path: "/logs/x.txt", want: true},
+		{name: "Unicode range", pattern: "/letters/[α-ω].txt", path: "/letters/λ.txt", want: true},
+		{name: "class cannot match separator", pattern: "/logs/[a-z].txt", path: "/logs//.txt", want: false},
+	}
+
+	assertCodespecGlobCases(t, tests)
+}
+
+func TestCodespecGlobMatchEscapesAndMalformedPatterns(t *testing.T) {
+	tests := []struct {
+		name    string
+		pattern string
+		path    string
+		want    bool
+	}{
+		{name: "escaped star is literal", pattern: `/data/\*.txt`, path: "/data/*.txt", want: true},
+		{name: "escaped star is not wildcard", pattern: `/data/\*.txt`, path: "/data/report.txt", want: false},
+		{name: "escaped question is literal", pattern: `/data/file\?.txt`, path: "/data/file?.txt", want: true},
+		{name: "escaped brackets are literal", pattern: `/data/\[draft\].txt`, path: "/data/[draft].txt", want: true},
+		{name: "escaped backslash is literal", pattern: `/data/back\\slash`, path: `/data/back\slash`, want: true},
+		{name: "unclosed class", pattern: "/data/file[0-9.txt", path: "/data/file7.txt", want: false},
+		{name: "empty class", pattern: "/data/file[].txt", path: "/data/file7.txt", want: false},
+		{name: "descending range", pattern: "/data/file[z-a].txt", path: "/data/filem.txt", want: false},
+		{name: "trailing escape", pattern: "/data/file\\", path: "/data/file", want: false},
+	}
+
+	assertCodespecGlobCases(t, tests)
+}
+
+func TestCodespecGlobMatchAnchoringAndLiteralPaths(t *testing.T) {
+	tests := []struct {
+		name    string
+		pattern string
+		path    string
+		want    bool
+	}{
+		{name: "literal exact match", pattern: "/a/b", path: "/a/b", want: true},
+		{name: "matching is case sensitive", pattern: "/a/B", path: "/a/b", want: false},
+		{name: "leading slash is significant", pattern: "/a/b", path: "a/b", want: false},
+		{name: "repeated separator is significant", pattern: "/a/b", path: "/a//b", want: false},
+		{name: "dot component is significant", pattern: "/a/b", path: "/a/./b", want: false},
+		{name: "prefix is not enough", pattern: "a*b", path: "xaZZb", want: false},
+		{name: "suffix is not enough", pattern: "a*b", path: "aZZbx", want: false},
+		{name: "empty matches empty", pattern: "", path: "", want: true},
+		{name: "empty does not match nonempty", pattern: "", path: "x", want: false},
+	}
+
+	assertCodespecGlobCases(t, tests)
+}
+
+func assertCodespecGlobCases(t *testing.T, tests []struct {
+	name    string
+	pattern string
+	path    string
+	want    bool
+}) {
+	t.Helper()
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := GlobMatch(tt.pattern, tt.path); got != tt.want {
+				t.Errorf("GlobMatch(%q, %q) = %v, want %v", tt.pattern, tt.path, got, tt.want)
+			}
+		})
+	}
+}
