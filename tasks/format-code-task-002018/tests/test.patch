--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,30 @@
+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+
+dev-switch node 20 2>/dev/null || true
+if [ ! -x node_modules/.bin/jest ]; then
+  npm ci --legacy-peer-deps 2>&1 | tail -5
+fi
+cp secret.config.json.example secret.config.json
+unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
+
+case "${1:-}" in
+  base)
+    npx jest --no-cache --runInBand \
+      serverless/src/generateGibsTags/__tests__/getSupportedGibsLayers.test.js \
+      serverless/src/generateGibsTags/__tests__/handler.test.js \
+      --testNamePattern='correctly excludes layers with faulty projections|correctly generates and queues tag data when no collections are to be tagged'
+    ;;
+  new)
+    npx jest --no-cache --runInBand \
+      serverless/src/generateGibsTags/__tests__/getSupportedGibsLayers.test.js \
+      serverless/src/generateGibsTags/__tests__/handler.test.js \
+      --testNamePattern='returns_layers_from_the_current_upstream_response_only|returns_layers_from_larger_upstream_responses_without_static_overlay|returns_layers_from_upstream_response_outside_jest_environment|sends_tags_only_for_upstream_supported_concepts'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
