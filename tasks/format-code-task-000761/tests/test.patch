+type recordingFS struct {
+	fs.Filesystem
+	writes []string
+}
+
+func (r *recordingFS) WriteFileReader(path string, data io.Reader) (int64, bool, error) {
+	r.writes = append(r.writes, "WriteFileReader:"+path)
+	return r.Filesystem.WriteFileReader(path, data)
+}
+
+func (r *recordingFS) WriteFile(path string, data []byte) (int64, bool, error) {
+	r.writes = append(r.writes, "WriteFile:"+path)
+	return r.Filesystem.WriteFile(path, data)
+}
+
+func (r *recordingFS) WriteFileSafe(path string, data []byte) (int64, bool, error) {
+	r.writes = append(r.writes, "WriteFileSafe:"+path)
+	return r.Filesystem.WriteFileSafe(path, data)
+}
+
+func (r *recordingFS) MkdirAll(path string, perm os.FileMode) error {
+	r.writes = append(r.writes, "MkdirAll:"+path)
+	return r.Filesystem.MkdirAll(path, perm)
+}
+
+func (r *recordingFS) Rename(src, dst string) error {
+	r.writes = append(r.writes, "Rename:"+src+"->"+dst)
+	return r.Filesystem.Rename(src, dst)
+}
+
+func (r *recordingFS) Copy(src, dst string) error {
+	r.writes = append(r.writes, "Copy:"+src+"->"+dst)
+	return r.Filesystem.Copy(src, dst)
+}
+
+func (r *recordingFS) Remove(path string) int64 {
+	r.writes = append(r.writes, "Remove:"+path)
+	return r.Filesystem.Remove(path)
+}
+
+func (r *recordingFS) RemoveAll() int64 {
+	r.writes = append(r.writes, "RemoveAll")
+	return r.Filesystem.RemoveAll()
+}
