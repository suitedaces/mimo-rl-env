+func upgradeSummary(data *config.Data) v3Summary {
+	var auth0Users []string
+	if len(data.API.Auth.Auth0.Tenants) != 0 {
+		auth0Users = data.API.Auth.Auth0.Tenants[0].Users
+	}
+	return v3Summary{
+		Version:       data.Version,
+		ID:            data.ID,
+		Name:          data.Name,
+		HostName:      data.Host.Name,
+		Routes:        data.Router.Routes,
+		Allow:         data.Storage.Disk.Cache.Types.Allow,
+		Block:         data.Storage.Disk.Cache.Types.Block,
+		MemoryLimit:   data.Debug.MemoryLimit,
+		S3Len:         len(data.Storage.S3),
+		APIAccessHTTP: data.API.Access.HTTP.Allow,
+		Auth0Users:    auth0Users,
+		SRTTopics:     data.SRT.Log.Topics,
+		Prefixes:      data.Router.BlockedPrefixes,
+	}
+}
+
+func downgradeSummary(data *v2.Data) v2Summary {
+	var auth0Users []string
+	if len(data.API.Auth.Auth0.Tenants) != 0 {
+		auth0Users = data.API.Auth.Auth0.Tenants[0].Users
+	}
+	return v2Summary{
+		Version:      data.Version,
+		CacheTypes:   data.Storage.Disk.Cache.Types,
+		TLSEnable:    data.TLS.Enable,
+		TLSAddress:   data.TLS.Address,
+		TLSAuto:      data.TLS.Auto,
+		TLSCertFile:  data.TLS.CertFile,
+		TLSKeyFile:   data.TLS.KeyFile,
+		MimeTypes:    data.Storage.MimeTypes,
+		MemoryAuth:   data.Storage.Memory.Auth.Enable,
+		MemoryUser:   data.Storage.Memory.Auth.Username,
+		MemoryPass:   data.Storage.Memory.Auth.Password,
+		MemorySize:   data.Storage.Memory.Size,
+		MemoryPurge:  data.Storage.Memory.Purge,
+		DebugProfile: data.Debug.Profiling,
+		DebugForceGC: data.Debug.ForceGC,
+		HostName:     data.Host.Name,
+		Routes:       data.Router.Routes,
+		Auth0Users:   auth0Users,
+	}
+}
