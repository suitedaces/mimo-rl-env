+func TestUpgradeV2ToV3SpecifiedFieldsAndDefaults(t *testing.T) {
+	mem := newMemFS(t)
+	src := v2SourceFixture()
+
+	actual, err := config.UpgradeV2ToV3(src, mem)
+	if err != nil {
+		t.Fatalf("UpgradeV2ToV3 returned error: %v", err)
+	}
+
+	want := v3Summary{
+		Version:       3,
+		ID:            "core-a",
+		Name:          "studio",
+		HostName:      []string{"example.com"},
+		Routes:        map[string]string{"/live": "/memfs/live"},
+		Allow:         []string{".ts", ".mp4"},
+		Block:         []string{".m3u8", ".mpd"},
+		MemoryLimit:   0,
+		S3Len:         0,
+		APIAccessHTTP: []string{"10.0.0.0/8"},
+		Auth0Users:    []string{"alice", "bob"},
+		SRTTopics:     []string{"connect", "stats"},
+		Prefixes:      []string{"/internal", "/debug"},
+	}
+	assertEqual(t, upgradeSummary(actual), want)
+}
