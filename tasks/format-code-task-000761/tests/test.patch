+func TestMergeV2ToV3OverlaysCallerDestination(t *testing.T) {
+	mem := newMemFS(t)
+	src := v2SourceFixture()
+	dst := config.New(mem)
+	dst.Storage.Disk.Cache.Types.Block = []string{".deny"}
+
+	actual, err := config.MergeV2toV3(&dst.Data, src)
+	if err != nil {
+		t.Fatalf("MergeV2toV3 returned error: %v", err)
+	}
+	if actual != &dst.Data {
+		t.Fatalf("MergeV2toV3 returned same destination pointer = %v, want true", actual == &dst.Data)
+	}
+
+	want := v3Summary{
+		Version:       3,
+		ID:            "core-a",
+		Name:          "studio",
+		HostName:      []string{"example.com"},
+		Routes:        map[string]string{"/live": "/memfs/live"},
+		Allow:         []string{".ts", ".mp4"},
+		Block:         []string{".deny"},
+		MemoryLimit:   0,
+		S3Len:         0,
+		APIAccessHTTP: []string{"10.0.0.0/8"},
+		Auth0Users:    []string{"alice", "bob"},
+		SRTTopics:     []string{"connect", "stats"},
+		Prefixes:      []string{"/internal", "/debug"},
+	}
+	assertEqual(t, upgradeSummary(actual), want)
+}
