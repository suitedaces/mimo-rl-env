+func TestReturnedSliceAndMapFieldsDoNotAliasSources(t *testing.T) {
+	mem := newMemFS(t)
+
+	upgradeSrc := v2SourceFixture()
+	upgraded, err := config.UpgradeV2ToV3(upgradeSrc, mem)
+	if err != nil {
+		t.Fatalf("UpgradeV2ToV3 returned error: %v", err)
+	}
+	mutateV3CopiedFields(upgraded)
+	assertV2SourceStillFixture(t, upgradeSrc)
+
+	mergeSrc := v2SourceFixture()
+	dst := config.New(mem)
+	merged, err := config.MergeV2toV3(&dst.Data, mergeSrc)
+	if err != nil {
+		t.Fatalf("MergeV2toV3 returned error: %v", err)
+	}
+	mutateV3CopiedFields(merged)
+	assertV2SourceStillFixture(t, mergeSrc)
+
+	downgradeSrc := v3SourceFixture()
+	downgraded, err := config.DowngradeV3toV2(downgradeSrc)
+	if err != nil {
+		t.Fatalf("DowngradeV3toV2 returned error: %v", err)
+	}
+	downgraded.Host.Name[0] = "mutated.example.com"
+	downgraded.API.Auth.Auth0.Tenants[0].Users[0] = "mutated"
+	downgraded.Router.Routes["/vod"] = "/mutated"
+	assertEqual(t, downgradeSrc.Host.Name, []string{"v3.example.com"})
+	assertEqual(t, downgradeSrc.API.Auth.Auth0.Tenants[0].Users, []string{"carol"})
+	assertEqual(t, downgradeSrc.Router.Routes, map[string]string{"/vod": "/data/vod"})
+}
