+func TestHelpersDoNotWriteFilesOrReadEnvironmentOverrides(t *testing.T) {
+	mem := newMemFS(t)
+	rec := &recordingFS{Filesystem: mem, writes: []string{}}
+	t.Setenv("CORE_STORAGE_DISK_CACHE_TYPES_BLOCK", ".envblock")
+	t.Setenv("CORE_DEBUG_MEMORY_LIMIT_MBYTES", "999")
+	t.Setenv("CORE_STORAGE_S3", "https://access:secret@us-east-1.s3.example/bucket?name=envs3&mount=/env")
+
+	previousDir, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd failed: %v", err)
+	}
+	tmp := t.TempDir()
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatalf("Chdir temp failed: %v", err)
+	}
+	t.Cleanup(func() {
+		if err := os.Chdir(previousDir); err != nil {
+			t.Fatalf("restore cwd failed: %v", err)
+		}
+	})
+	before := snapshotCWD(t)
+
+	upgraded, err := config.UpgradeV2ToV3(v2SourceFixture(), rec)
+	if err != nil {
+		t.Fatalf("UpgradeV2ToV3 returned error: %v", err)
+	}
+	dst := config.New(rec)
+	dst.Storage.Disk.Cache.Types.Block = []string{".deny"}
+	if _, err := config.MergeV2toV3(&dst.Data, v2SourceFixture()); err != nil {
+		t.Fatalf("MergeV2toV3 returned error: %v", err)
+	}
+	if _, err := config.DowngradeV3toV2(v3SourceFixture()); err != nil {
+		t.Fatalf("DowngradeV3toV2 returned error: %v", err)
+	}
+
+	assertEqual(t, rec.writes, []string{})
+	assertEqual(t, snapshotCWD(t), before)
+	assertEqual(t, upgradeSummary(upgraded), v3Summary{Version: 3, ID: "core-a", Name: "studio", HostName: []string{"example.com"}, Routes: map[string]string{"/live": "/memfs/live"}, Allow: []string{".ts", ".mp4"}, Block: []string{".m3u8", ".mpd"}, MemoryLimit: 0, S3Len: 0, APIAccessHTTP: []string{"10.0.0.0/8"}, Auth0Users: []string{"alice", "bob"}, SRTTopics: []string{"connect", "stats"}, Prefixes: []string{"/internal", "/debug"}})
+}
