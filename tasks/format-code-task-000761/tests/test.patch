+func cloneJSON[T any](t *testing.T, src *T) *T {
+	t.Helper()
+	data, err := json.Marshal(src)
+	if err != nil {
+		t.Fatalf("json marshal clone failed: %v", err)
+	}
+	var dst T
+	if err := json.Unmarshal(data, &dst); err != nil {
+		t.Fatalf("json unmarshal clone failed: %v", err)
+	}
+	return &dst
+}
