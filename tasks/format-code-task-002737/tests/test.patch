+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+source /testbed/.venv/bin/activate
+
+PYTEST_OPTS="-p no:cacheprovider -o filterwarnings= -o addopts="
+
+
+python -m pytest statsmodels/distributions/copula/tests/test_copula.py \
+    statsmodels/distributions/tests/test_bernstein.py $PYTEST_OPTS
+
+
+python -m pytest statsmodels/distributions/copula/tests/test_copula_args.py $PYTEST_OPTS
