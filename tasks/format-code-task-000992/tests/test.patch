@@ -0,0 +1,19 @@
+#!/bin/bash
+set -euo pipefail
+
+
+COLLECTION_ROOT="$(mktemp -d)"
+mkdir -p "${COLLECTION_ROOT}/ansible_collections/cisco"
+ln -s "${PWD}" "${COLLECTION_ROOT}/ansible_collections/cisco/ios"
+cleanup() {
+  unlink "${COLLECTION_ROOT}/ansible_collections/cisco/ios"
+  rmdir "${COLLECTION_ROOT}/ansible_collections/cisco"
+  rmdir "${COLLECTION_ROOT}/ansible_collections"
+  rmdir "${COLLECTION_ROOT}"
+}
+trap cleanup EXIT
+
+PYTHONPATH="${COLLECTION_ROOT}:/opt${PYTHONPATH:+:${PYTHONPATH}}" \
+  pytest -q \
+  tests/unit/modules/network/ios/test_ios_l2_interfaces.py \
+  tests/unit/modules/network/ios/test_ios_l2_interfaces_selective_deleted.py
