+import gzip
+import unittest
+import zlib
+
+from scrapy.downloadermiddlewares.httpcompression import HttpCompressionMiddleware
+from scrapy.http import HtmlResponse, Request, Response
+
+
+class HttpCompressionContractTest(unittest.TestCase):
+
+    def setUp(self):
+        self.middleware = HttpCompressionMiddleware()
+
+    def _response(self, body, encoding, content_type='text/html'):
+        return Response(
+            'http://example.test/page',
+            body=body,
+            headers={
+                'Content-Type': content_type,
+                'Content-Encoding': encoding,
+                'Content-Length': str(len(body)),
+            },
+            flags=['original'],
+            request=Request('http://example.test/page', meta={'trace': 'kept'}),
+        )
+
+    def test_decodes_comma_separated_codings_in_wire_reverse_order(self):
+        original = b'<html><body>stacked</body></html>'
+        encoded = zlib.compress(gzip.compress(original))
+        response = self._response(encoded, ' GZip , DeFlAtE ')
+
+        result = self.middleware.process_response(response.request, response, None)
+
+        self.assertIsInstance(result, HtmlResponse)
+        self.assertEqual(result.body, original)
+        self.assertNotIn('Content-Encoding', result.headers)
+        self.assertEqual(result.headers['Content-Length'], str(len(original)).encode('ascii'))
+        self.assertEqual(result.flags, ['original'])
+        self.assertEqual(result.meta, {'trace': 'kept'})
+
+    def test_decodes_repeated_content_encoding_header_values(self):
+        original = b'header values are also stacked'
+        encoded = zlib.compress(gzip.compress(original))
+        response = self._response(encoded, ['x-gzip', 'deflate'])
+
+        result = self.middleware.process_response(response.request, response, None)
+
+        self.assertEqual(result.body, original)
+        self.assertNotIn('Content-Encoding', result.headers)
+        self.assertEqual(result.headers['Content-Length'], str(len(original)).encode('ascii'))
+
+    def test_unsupported_coding_does_not_corrupt_response(self):
+        body = b'opaque payload'
+        response = self._response(body, 'gzip, br')
+
+        result = self.middleware.process_response(response.request, response, None)
+
+        self.assertEqual(result.body, body)
+        self.assertEqual(result.headers['Content-Encoding'], b'gzip, br')
+        self.assertEqual(result.headers['Content-Length'], str(len(body)).encode('ascii'))
+
+    def test_supported_outer_layer_is_decoded_before_unknown_inner_layer(self):
+        original = b'payload behind an unknown inner coding'
+        response = self._response(gzip.compress(original), 'br, gzip')
+
+        result = self.middleware.process_response(response.request, response, None)
+
+        self.assertIsInstance(result, HtmlResponse)
+        self.assertEqual(result.body, original)
+        self.assertEqual(result.headers['Content-Encoding'], b'br')
+        self.assertEqual(result.headers['Content-Length'], str(len(original)).encode('ascii'))
+
+    def test_malformed_supported_payload_raises(self):
+        response = self._response(b'not a gzip stream', 'gzip')
+
+        with self.assertRaises(Exception):
+            self.middleware.process_response(response.request, response, None)
+
+    def test_head_responses_are_left_untouched(self):
+        body = gzip.compress(b'head body')
+        response = self._response(body, 'gzip')
+        request = response.request.replace(method='HEAD')
+
+        result = self.middleware.process_response(request, response, None)
+
+        self.assertIs(result, response)
+        self.assertEqual(result.body, body)
+        self.assertEqual(result.headers['Content-Encoding'], b'gzip')
+        self.assertEqual(result.headers['Content-Length'], str(len(body)).encode('ascii'))
+
+    def test_non_response_values_are_passed_through(self):
+        request = Request('http://example.test/page')
+        marker = object()
+
+        self.assertIs(self.middleware.process_response(request, marker, None), marker)
+
+
+if __name__ == '__main__':
+    unittest.main()
