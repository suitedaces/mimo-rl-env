+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+test -x ./node_modules/.bin/rollup
+test -x ./node_modules/.bin/mocha
+mkdir -p build
+./node_modules/.bin/rollup -c >/dev/null
+exec ./node_modules/.bin/mocha /workspace/repo/usercase-test-coderl/buffer-list.test.js --reporter spec
