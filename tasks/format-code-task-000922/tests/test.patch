diff --git a/packages/babel-plugin/__tests__/validation-error-messages-test.js b/packages/babel-plugin/__tests__/validation-error-messages-test.js
new file mode 100644
index 0000000..7edeabb
--- /dev/null
+++ b/packages/babel-plugin/__tests__/validation-error-messages-test.js
@@ -0,0 +1,263 @@
+
+
+
+
+
+
+
+
+
+'use strict';
+
+jest.autoMockOff();
+
+import { transformSync } from '@babel/core';
+import stylexPlugin from '../src/index';
+
+const defaultOpts = {
+  unstable_moduleResolution: { rootDir: '/stylex/packages/', type: 'commonJS' },
+};
+
+function transform(source, opts = {}) {
+  return transformSync(source, {
+    filename: opts.filename || '/stylex/packages/TestTheme.stylex.js',
+    parserOpts: { flow: 'all' },
+    babelrc: false,
+    plugins: [[stylexPlugin, { ...defaultOpts, ...opts }]],
+  });
+}
+
+function getErrorMessage(fn) {
+  try {
+    fn();
+  } catch (e) {
+    return String(e.message);
+  }
+  throw new Error('expected the call to throw, but it did not');
+}
+
+describe('error messages reference the correct API', () => {
+  describe('stylex.defineConsts()', () => {
+    test('unbound call mentions defineConsts (not create/defineVars)', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          stylex.defineConsts({YELLOW: 'yellow'});
+        `),
+      );
+      expect(msg).toMatch(/defineConsts/);
+      expect(msg).not.toMatch(/\bdefineVars\b/);
+      expect(msg).not.toMatch(/stylex\.create\b/);
+      expect(msg).not.toMatch(/stylex\.createTheme/);
+    });
+
+    test('not exported mentions defineConsts (not defineVars/create)', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          const constants = stylex.defineConsts({YELLOW: 'yellow'});
+        `),
+      );
+      expect(msg).toMatch(/defineConsts/);
+      expect(msg).not.toMatch(/\bdefineVars\b/);
+      expect(msg).not.toMatch(/stylex\.create\b/);
+    });
+
+    test('zero arguments mentions defineConsts', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          export const constants = stylex.defineConsts();
+        `),
+      );
+      expect(msg).toMatch(/defineConsts/);
+      expect(msg).not.toMatch(/stylex\.create\b/);
+      expect(msg).not.toMatch(/\bdefineVars\b/);
+    });
+
+    test('too many arguments mentions defineConsts', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          export const constants = stylex.defineConsts({}, {});
+        `),
+      );
+      expect(msg).toMatch(/defineConsts/);
+      expect(msg).not.toMatch(/stylex\.create\b/);
+      expect(msg).not.toMatch(/\bdefineVars\b/);
+    });
+
+    test('non-object argument mentions defineConsts', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          export const constants = stylex.defineConsts(1);
+        `),
+      );
+      expect(msg).toMatch(/defineConsts/);
+      expect(msg).not.toMatch(/stylex\.create\b/);
+      expect(msg).not.toMatch(/\bdefineVars\b/);
+    });
+
+    test('non-static argument mentions defineConsts', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          export const constants = stylex.defineConsts(genStyles());
+        `),
+      );
+      expect(msg).toMatch(/defineConsts/);
+      expect(msg).not.toMatch(/stylex\.create\b/);
+      expect(msg).not.toMatch(/\bdefineVars\b/);
+    });
+  });
+
+  describe('stylex.defineVars()', () => {
+    test('unbound call mentions defineVars (not create/defineConsts)', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          stylex.defineVars({YELLOW: 'yellow'});
+        `),
+      );
+      expect(msg).toMatch(/defineVars/);
+      expect(msg).not.toMatch(/\bdefineConsts\b/);
+      expect(msg).not.toMatch(/stylex\.create\b/);
+    });
+
+    test('not exported mentions defineVars (not create)', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          const vars = stylex.defineVars({YELLOW: 'yellow'});
+        `),
+      );
+      expect(msg).toMatch(/defineVars/);
+      expect(msg).not.toMatch(/\bdefineConsts\b/);
+      expect(msg).not.toMatch(/stylex\.create\b/);
+    });
+
+    test('zero arguments mentions defineVars', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          export const vars = stylex.defineVars();
+        `),
+      );
+      expect(msg).toMatch(/defineVars/);
+      expect(msg).not.toMatch(/stylex\.create\b/);
+      expect(msg).not.toMatch(/\bdefineConsts\b/);
+    });
+
+    test('non-object argument mentions defineVars', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          export const vars = stylex.defineVars(1);
+        `),
+      );
+      expect(msg).toMatch(/defineVars/);
+      expect(msg).not.toMatch(/stylex\.create\b/);
+      expect(msg).not.toMatch(/\bdefineConsts\b/);
+    });
+
+    test('non-static argument mentions defineVars', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          export const vars = stylex.defineVars(genStyles());
+        `),
+      );
+      expect(msg).toMatch(/defineVars/);
+      expect(msg).not.toMatch(/stylex\.create\b/);
+      expect(msg).not.toMatch(/\bdefineConsts\b/);
+    });
+  });
+
+  describe('stylex.keyframes()', () => {
+    test('zero arguments mentions keyframes (not create)', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          export const fade = stylex.keyframes();
+        `),
+      );
+      expect(msg).toMatch(/keyframes/);
+      expect(msg).not.toMatch(/stylex\.create\b/);
+    });
+
+    test('non-static inside object mentions keyframes (not create)', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          export const fade = stylex.keyframes({
+            from: { color: someValue },
+            to: { color: 'blue' },
+          });
+        `),
+      );
+      expect(msg).toMatch(/keyframes/);
+      expect(msg).not.toMatch(/stylex\.create\b/);
+    });
+  });
+
+  describe('stylex.createTheme()', () => {
+    test('unbound call mentions createTheme (not create alone)', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          stylex.createTheme({__themeName__: 'x568ih9'}, {});
+        `),
+      );
+      expect(msg).toMatch(/createTheme/);
+
+      expect(msg).not.toMatch(/stylex\.create\(\)/);
+      expect(msg).not.toMatch(/\bdefineVars\b/);
+      expect(msg).not.toMatch(/\bdefineConsts\b/);
+    });
+
+    test('wrong argument count mentions createTheme', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          export const t = stylex.createTheme({__themeName__: 'x568ih9'});
+        `),
+      );
+      expect(msg).toMatch(/createTheme/);
+      expect(msg).not.toMatch(/stylex\.create\(\)/);
+    });
+
+    test('non-object overrides mentions createTheme', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          export const t = stylex.createTheme({__themeName__: 'x568ih9'}, 1);
+        `),
+      );
+      expect(msg).toMatch(/createTheme/);
+      expect(msg).not.toMatch(/stylex\.create\(\)/);
+    });
+  });
+
+  describe('stylex.create() error messages still mention create', () => {
+    test('unbound call still mentions create', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          stylex.create({});
+        `),
+      );
+      expect(msg).toMatch(/\bcreate\b/);
+    });
+
+    test('too many args still mentions create', () => {
+      const msg = getErrorMessage(() =>
+        transform(`
+          import * as stylex from '@stylexjs/stylex';
+          export const s = stylex.create({}, {});
+        `),
+      );
+      expect(msg).toMatch(/\bcreate\b/);
+    });
+  });
+});
