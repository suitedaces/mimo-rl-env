@@ -0,0 +1,144 @@
+import datetime
+
+from aiogram.client.default import DefaultBotProperties
+from aiogram.methods import SendPoll
+from aiogram.types import (
+    Chat,
+    InputPollOption,
+    Message,
+    MessageEntity,
+    Poll,
+    PollOption,
+)
+from tests.mocked_bot import MockedBot
+
+
+def _entity_dict():
+    return {"type": "bold", "offset": 0, "length": 1}
+
+
+class TestInputPollOption:
+    def test_minimal(self):
+        option = InputPollOption(text="Option A")
+        assert option.text == "Option A"
+        assert option.text_parse_mode is None
+        assert option.text_entities is None
+
+    def test_serializes_only_provided_fields(self):
+        option = InputPollOption(text="Option A")
+        assert option.model_dump(exclude_none=True) == {"text": "Option A"}
+
+    def test_text_entities_parsed(self):
+        option = InputPollOption(text="Option A", text_entities=[_entity_dict()])
+        assert isinstance(option.text_entities[0], MessageEntity)
+        assert option.text_entities[0].type == "bold"
+
+
+class TestSendPollOptions:
+    def test_accepts_plain_strings(self):
+        method = SendPoll(chat_id=42, question="Q?", options=["A", "B"])
+        assert method.options == ["A", "B"]
+        assert all(isinstance(item, str) for item in method.options)
+
+    def test_accepts_input_poll_options(self):
+        method = SendPoll(
+            chat_id=42,
+            question="Q?",
+            options=[InputPollOption(text="A"), InputPollOption(text="B")],
+        )
+        assert all(isinstance(item, InputPollOption) for item in method.options)
+        assert [item.text for item in method.options] == ["A", "B"]
+
+    def test_accepts_mixed_options(self):
+        method = SendPoll(
+            chat_id=42,
+            question="Q?",
+            options=["A", InputPollOption(text="B")],
+        )
+        assert method.options[0] == "A"
+        assert isinstance(method.options[0], str)
+        assert isinstance(method.options[1], InputPollOption)
+        assert method.options[1].text == "B"
+
+    async def test_bot_helper_accepts_mixed_options(self, bot: MockedBot):
+        bot.add_result_for(
+            SendPoll,
+            ok=True,
+            result=Message(
+                message_id=42,
+                date=datetime.datetime.now(),
+                chat=Chat(id=42, type="private"),
+            ),
+        )
+        await bot.send_poll(
+            chat_id=42,
+            question="Q?",
+            options=["A", InputPollOption(text="B")],
+        )
+        request: SendPoll = bot.get_request()
+        assert request.options[0] == "A"
+        assert isinstance(request.options[1], InputPollOption)
+        assert request.options[1].text == "B"
+
+
+class TestSendPollQuestionFormatting:
+    def test_question_parse_mode_is_a_field(self):
+        assert "question_parse_mode" in SendPoll.model_fields
+        assert "question_entities" in SendPoll.model_fields
+
+    def test_question_parse_mode_falls_back_to_default(self):
+        bot = MockedBot(default=DefaultBotProperties(parse_mode="HTML"))
+        method = SendPoll(chat_id=42, question="Q?", options=["A", "B"])
+        resolved = bot.session.prepare_value(
+            method.question_parse_mode, bot=bot, files={}
+        )
+        assert resolved == "HTML"
+
+    def test_question_parse_mode_explicit_value_is_kept(self):
+        bot = MockedBot(default=DefaultBotProperties(parse_mode="HTML"))
+        method = SendPoll(
+            chat_id=42,
+            question="Q?",
+            options=["A", "B"],
+            question_parse_mode="MarkdownV2",
+        )
+        resolved = bot.session.prepare_value(
+            method.question_parse_mode, bot=bot, files={}
+        )
+        assert resolved == "MarkdownV2"
+
+    def test_question_entities_parsed(self):
+        method = SendPoll(
+            chat_id=42,
+            question="Q?",
+            options=["A", "B"],
+            question_entities=[_entity_dict()],
+        )
+        assert isinstance(method.question_entities[0], MessageEntity)
+        assert method.question_entities[0].type == "bold"
+
+
+class TestPollResultEntities:
+    def test_poll_question_entities_parsed(self):
+        poll = Poll(
+            id="QA",
+            question="Q",
+            options=[PollOption(text="A", voter_count=0)],
+            total_voter_count=0,
+            is_closed=False,
+            is_anonymous=False,
+            type="regular",
+            allows_multiple_answers=False,
+            question_entities=[_entity_dict()],
+        )
+        assert isinstance(poll.question_entities[0], MessageEntity)
+        assert poll.question_entities[0].type == "bold"
+
+    def test_poll_option_text_entities_parsed(self):
+        option = PollOption(
+            text="A",
+            voter_count=0,
+            text_entities=[_entity_dict()],
+        )
+        assert isinstance(option.text_entities[0], MessageEntity)
+        assert option.text_entities[0].type == "bold"
