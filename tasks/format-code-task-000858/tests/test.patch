 		})
 	})
 
+	When("taints with value:effect format are set on the node config", func() {
+		BeforeEach(func() {
+			ng.Taints = map[string]string{"controller": "true:NoSchedule"}
+			bootstrapper = nodebootstrap.NewUbuntuBootstrapper(clusterName, ng)
+		})
+
+		It("does not prepend a colon to a value that already has value:effect form", func() {
+			userData, err := bootstrapper.UserData()
+			Expect(err).NotTo(HaveOccurred())
+
+			cloudCfg := decode(userData)
+			Expect(cloudCfg.WriteFiles[2].Path).To(Equal("/etc/eksctl/kubelet.env"))
+			Expect(cloudCfg.WriteFiles[2].Content).To(ContainSubstring("NODE_TAINTS=controller=true:NoSchedule"))
+			Expect(cloudCfg.WriteFiles[2].Content).NotTo(ContainSubstring("controller=:true:NoSchedule"))
+			Expect(cloudCfg.WriteFiles[2].Permissions).To(Equal("0644"))
+		})
+	})
+
+	When("a taint with effect-only value is set on the node config", func() {
+		BeforeEach(func() {
+			ng.Taints = map[string]string{"dedicated": "NoSchedule"}
+			bootstrapper = nodebootstrap.NewUbuntuBootstrapper(clusterName, ng)
+		})
+
+		It("prepends a colon so the value parses as an effect-only taint", func() {
+			userData, err := bootstrapper.UserData()
+			Expect(err).NotTo(HaveOccurred())
+
+			cloudCfg := decode(userData)
+			Expect(cloudCfg.WriteFiles[2].Path).To(Equal("/etc/eksctl/kubelet.env"))
+			Expect(cloudCfg.WriteFiles[2].Content).To(ContainSubstring("NODE_TAINTS=dedicated=:NoSchedule"))
+			Expect(cloudCfg.WriteFiles[2].Permissions).To(Equal("0644"))
+		})
+	})
+
