+    def test_format_with_culture(self):
+
+        e = parse_one(
+            "SELECT FORMAT(TimeStart, 'dddd', 'de-CH') FROM TableName", read="tsql"
+        )
+        self.assertEqual(
+            e.sql(dialect="tsql"),
+            "SELECT FORMAT(TimeStart, 'dddd', 'de-CH') FROM TableName",
+        )
+
+
+        self.validate_identity("SELECT FORMAT(TimeStart, 'dddd', 'de-CH') FROM TableName")
+
+
+        self.validate_identity("SELECT FORMAT(12345, '###.###.###', 'de-CH')")
+
+
+        self.validate_identity("SELECT FORMAT(TimeStart, 'dddd', 'en-US') FROM TableName")
+
+
+        self.validate_identity("SELECT FORMAT(TimeStart, 'dddd') FROM TableName")
+
+
+        e = parse_one("SELECT FORMAT(12345, '###.###.###', 'de-CH')", read="tsql")
+        fmt_node = e.find(exp.NumberToStr)
+        self.assertIsNotNone(fmt_node)
+        culture = fmt_node.args.get("culture")
+        self.assertIsNotNone(culture)
+        self.assertEqual(culture.name, "de-CH")
+
+
+        e = parse_one(
+            "SELECT FORMAT(TimeStart, 'dddd', 'de-CH') FROM TableName", read="tsql"
+        )
+        fmt_node = e.find(exp.TimeToStr)
+        self.assertIsNotNone(fmt_node)
+        culture = fmt_node.args.get("culture")
+        self.assertIsNotNone(culture)
+        self.assertEqual(culture.name, "de-CH")
+
