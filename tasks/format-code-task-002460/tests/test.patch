+def test_tagged_measurement_with_measurement_key_mapping():
+    a, b = cirq.LineQubit.range(2)
+    op = cirq.measure(a, key='m').with_tags('outer', 'metadata')
+
+    remapped = cirq.with_measurement_key_mapping(op, {'m': 'k'})
+    assert remapped.tags == ('outer', 'metadata')
+    assert cirq.measurement_keys(remapped) == {'k'}
+
+    unchanged = cirq.with_measurement_key_mapping(op, {'x': 'k'})
+    assert unchanged == op
+    assert unchanged.tags == ('outer', 'metadata')
+    assert cirq.measurement_keys(unchanged) == {'m'}
+
+    differently_tagged = cirq.measure(b, key='alpha').with_tags('secondary')
+    differently_remapped = cirq.with_measurement_key_mapping(
+        differently_tagged, {'alpha': 'renamed'})
+    assert differently_remapped.tags == ('secondary',)
+    assert cirq.measurement_keys(differently_remapped) == {'renamed'}
