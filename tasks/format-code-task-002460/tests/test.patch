+def test_circuit_with_measurement_key_mapping():
+    a, b = cirq.LineQubit.range(2)
+    circuit = cirq.Circuit(
+        cirq.X(a),
+        cirq.measure(a, key='m1'),
+        cirq.measure(b, key='m2'),
+    )
+
+    remapped = cirq.with_measurement_key_mapping(circuit, {'m1': 'p1'})
+
+    assert remapped.all_measurement_keys() == {'p1', 'm2'}
+    assert cirq.X(a) in set(remapped.all_operations())
+    assert circuit.all_measurement_keys() == {'m1', 'm2'}
+
+
+def test_circuit_key_swap_changes_result_keys_without_changing_operations():
+    a, b = cirq.LineQubit.range(2)
+    circuit = cirq.Circuit(
+        cirq.X(a),
+        cirq.measure(a, key='m1'),
+        cirq.measure(b, key='m2'),
+    )
+
+    swapped = cirq.with_measurement_key_mapping(
+        circuit, {'m1': 'm2', 'm2': 'm1'})
+
+    assert swapped.all_measurement_keys() == {'m1', 'm2'}
+
+    simulator = cirq.Simulator()
+    original_result = simulator.run(circuit)
+    swapped_result = simulator.run(swapped)
+    assert original_result.measurements['m1'].tolist() == [[1]]
+    assert original_result.measurements['m2'].tolist() == [[0]]
+    assert swapped_result.measurements['m1'].tolist() == [[0]]
+    assert swapped_result.measurements['m2'].tolist() == [[1]]
+
+
