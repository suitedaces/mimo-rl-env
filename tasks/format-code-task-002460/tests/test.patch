                         ]).without_operations_touching([a, c]) == cirq.Moment())
 
 
+def test_moment_with_measurement_key_mapping_preserves_non_measurements():
+    a, b, c = cirq.LineQubit.range(3)
+    non_measurement = cirq.X(c)
+    moment = cirq.Moment(
+        cirq.measure(a, key='m1'),
+        cirq.measure(b, key='m2'),
+        non_measurement,
+    )
+
+    remapped = cirq.with_measurement_key_mapping(moment, {'m1': 'p1'})
+
+    assert non_measurement in remapped.operations
+    measurement_ops = [
+        op for op in remapped.operations if cirq.measurement_keys(op)
+    ]
+    assert len(measurement_ops) == 2
+    assert {frozenset(cirq.measurement_keys(op)) for op in measurement_ops} == {
+        frozenset({'p1'}), frozenset({'m2'})}
+
