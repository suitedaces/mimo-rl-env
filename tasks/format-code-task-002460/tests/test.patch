diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,39 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export PATH="$HOME/.pyenv/bin:$PATH"
+set +u
+eval "$(pyenv init -)"
+set -u
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest -xvs \
+      cirq/circuits/circuit_test.py::test_inverse \
+      cirq/ops/gate_operation_test.py::test_with_gate \
+      cirq/ops/measurement_gate_test.py::test_measurement_with_key \
+      cirq/ops/moment_test.py::test_without_operations_touching \
+      cirq/ops/raw_types_test.py::test_tagged_operation \
+      cirq/protocols/measurement_key_protocol_test.py::test_measurement_keys
+    ;;
+  new)
+    python3 -m pytest -xvs \
+      cirq/circuits/circuit_test.py::test_circuit_with_measurement_key_mapping \
+      cirq/circuits/circuit_test.py::test_circuit_key_swap_changes_result_keys_without_changing_operations \
+      cirq/ops/gate_operation_test.py::test_gate_operation_with_measurement_key_mapping \
+      cirq/ops/gate_operation_test.py::test_gate_operation_mapping_unsupported_gate \
+      cirq/ops/measurement_gate_test.py::test_measurement_gate_with_measurement_key_mapping \
+      cirq/ops/moment_test.py::test_moment_with_measurement_key_mapping_preserves_non_measurements \
+      cirq/ops/raw_types_test.py::test_tagged_measurement_with_measurement_key_mapping \
+      cirq/ops/raw_types_test.py::test_tagged_mapping_unsupported_sub_operation \
+      cirq/protocols/measurement_key_protocol_test.py::test_with_measurement_key_mapping_public_entrypoint \
+      cirq/protocols/measurement_key_protocol_test.py::test_with_measurement_key_mapping_unsupported_value
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
