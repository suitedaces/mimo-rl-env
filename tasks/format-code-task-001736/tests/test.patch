+package usercase_test_coderl
+
+
+
+
+
+
+import (
+	"io/fs"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"os"
+	"path/filepath"
+
+	"k8s.io/client-go/tools/clientcmd"
+)
+
+func TestParseTimeoutBareZeroSeconds(t *testing.T) {
+
+
+	actual, err := clientcmd.ParseTimeout("0")
+	if err != nil {
+		t.Fatalf("ParseTimeout(\"0\") returned unexpected error: %v", err)
+	}
+	if actual != time.Duration(0) {
+		t.Fatalf("ParseTimeout(\"0\") = %v, want %v", actual, time.Duration(0))
+	}
+}
+
+func TestParseTimeoutBarePositiveIntegerAsSeconds(t *testing.T) {
+
+
+	actual, err := clientcmd.ParseTimeout("15")
+	if err != nil {
+		t.Fatalf("ParseTimeout(\"15\") returned unexpected error: %v", err)
+	}
+	if actual != time.Duration(15_000_000_000) {
+		t.Fatalf("ParseTimeout(\"15\") = %v, want %v", actual, time.Duration(15_000_000_000))
+	}
+}
+
+func TestParseTimeoutGoDurationMinutes(t *testing.T) {
+
+
+	actual, err := clientcmd.ParseTimeout("2m")
+	if err != nil {
+		t.Fatalf("ParseTimeout(\"2m\") returned unexpected error: %v", err)
+	}
+	if actual != time.Duration(120_000_000_000) {
+		t.Fatalf("ParseTimeout(\"2m\") = %v, want %v", actual, time.Duration(120_000_000_000))
+	}
+}
+
+func TestParseTimeoutGoDurationMilliseconds(t *testing.T) {
+
+
+	actual, err := clientcmd.ParseTimeout("1500ms")
+	if err != nil {
+		t.Fatalf("ParseTimeout(\"1500ms\") returned unexpected error: %v", err)
+	}
+	if actual != time.Duration(1_500_000_000) {
+		t.Fatalf("ParseTimeout(\"1500ms\") = %v, want %v", actual, time.Duration(1_500_000_000))
+	}
+}
+
+func TestParseTimeoutGoDurationCompoundFractional(t *testing.T) {
+
+
+	actual, err := clientcmd.ParseTimeout("1h2m3.5s")
+	if err != nil {
+		t.Fatalf("ParseTimeout(\"1h2m3.5s\") returned unexpected error: %v", err)
+	}
+	if actual != time.Duration(3_723_500_000_000) {
+		t.Fatalf("ParseTimeout(\"1h2m3.5s\") = %v, want %v", actual, time.Duration(3_723_500_000_000))
+	}
+}
+
+func TestParseTimeoutGoDurationSigned(t *testing.T) {
+
+
+	actual, err := clientcmd.ParseTimeout("-1s")
+	if err != nil {
+		t.Fatalf("ParseTimeout(\"-1s\") returned unexpected error: %v", err)
+	}
+	if actual != time.Duration(-1_000_000_000) {
+		t.Fatalf("ParseTimeout(\"-1s\") = %v, want %v", actual, time.Duration(-1_000_000_000))
+	}
+}
+
+func TestParseTimeoutBareNegativeIntegerIsInvalid(t *testing.T) {
+
+
+	actual, err := clientcmd.ParseTimeout("-1")
+	if actual != time.Duration(0) {
+		t.Fatalf("ParseTimeout(\"-1\") duration = %v, want %v", actual, time.Duration(0))
+	}
+	if err == nil {
+		t.Fatal("ParseTimeout(\"-1\") returned nil error, want an error")
+	}
+	const expectedSubstring = "Invalid timeout value"
+
+	if !strings.Contains(err.Error(), expectedSubstring) {
+		t.Fatalf("ParseTimeout(\"-1\") error = %q, want substring %q", err.Error(), expectedSubstring)
+	}
+}
+
+func TestParseTimeoutAlphabeticInvalidInput(t *testing.T) {
+
+
+	actual, err := clientcmd.ParseTimeout("abc")
+	if actual != time.Duration(0) {
+		t.Fatalf("ParseTimeout(\"abc\") duration = %v, want %v", actual, time.Duration(0))
+	}
+	if err == nil {
+		t.Fatal("ParseTimeout(\"abc\") returned nil error, want an error")
+	}
+	const expectedSubstring = "Invalid timeout value"
+
+	if !strings.Contains(err.Error(), expectedSubstring) {
+		t.Fatalf("ParseTimeout(\"abc\") error = %q, want substring %q", err.Error(), expectedSubstring)
+	}
+	if !strings.Contains(err.Error(), "Invalid timeout value") {
+		t.Fatalf("ParseTimeout(\"abc\") error = %q, want substring %q", err.Error(), "Invalid timeout value")
+	}
+}
+
+func TestParseTimeoutEmptyStringInvalidInput(t *testing.T) {
+
+
+	actual, err := clientcmd.ParseTimeout("")
+	if actual != time.Duration(0) {
+		t.Fatalf("ParseTimeout(\"\") duration = %v, want %v", actual, time.Duration(0))
+	}
+	if err == nil {
+		t.Fatal("ParseTimeout(\"\") returned nil error, want an error")
+	}
+	const expectedSubstring = "Invalid timeout value"
+
+	if !strings.Contains(err.Error(), expectedSubstring) {
+		t.Fatalf("ParseTimeout(\"\") error = %q, want substring %q", err.Error(), expectedSubstring)
+	}
+}
+
+func TestParseTimeoutReferentialTransparency(t *testing.T) {
+	first, firstErr := clientcmd.ParseTimeout("1500ms")
+	second, secondErr := clientcmd.ParseTimeout("1500ms")
+	if first != second {
+		t.Fatalf("two ParseTimeout(\"1500ms\") calls returned %v and %v", first, second)
+	}
+	if (firstErr == nil) != (secondErr == nil) {
+		t.Fatalf("two ParseTimeout(\"1500ms\") calls returned error states %v and %v", firstErr, secondErr)
+	}
+	if firstErr != nil && firstErr.Error() != secondErr.Error() {
+		t.Fatalf("two ParseTimeout(\"1500ms\") calls returned errors %q and %q", firstErr.Error(), secondErr.Error())
+	}
+}
+
+func TestParseTimeoutDoesNotMutateCallerInput(t *testing.T) {
+	input := "2m"
+	before := input
+	actual, err := clientcmd.ParseTimeout(input)
+	if err != nil {
+		t.Fatalf("ParseTimeout(%q) returned unexpected error: %v", input, err)
+	}
+	if actual != time.Duration(120_000_000_000) {
+		t.Fatalf("ParseTimeout(%q) = %v, want %v", input, actual, time.Duration(120_000_000_000))
+	}
+	if input != before {
+		t.Fatalf("ParseTimeout mutated caller input from %q to %q", before, input)
+	}
+}
+
+func TestParseTimeoutNoGlobalStateWithNoise(t *testing.T) {
+	baseline, err := clientcmd.ParseTimeout("15")
+	if err != nil {
+		t.Fatalf("baseline ParseTimeout(\"15\") returned unexpected error: %v", err)
+	}
+	if baseline != time.Duration(15_000_000_000) {
+		t.Fatalf("baseline ParseTimeout(\"15\") = %v, want %v", baseline, time.Duration(15_000_000_000))
+	}
+
+	noiseCases := []string{"0", "2m", "abc", "1h2m3.5s", "-1s"}
+	for _, input := range noiseCases {
+		_, _ = clientcmd.ParseTimeout(input)
+	}
+
+	afterNoise, err := clientcmd.ParseTimeout("15")
+	if err != nil {
+		t.Fatalf("post-noise ParseTimeout(\"15\") returned unexpected error: %v", err)
+	}
+	if afterNoise != time.Duration(15_000_000_000) {
+		t.Fatalf("post-noise ParseTimeout(\"15\") = %v, want %v", afterNoise, time.Duration(15_000_000_000))
+	}
+}
+
+func TestParseTimeoutDoesNotWriteInWorkingDirectory(t *testing.T) {
+	originalWD, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd failed: %v", err)
+	}
+	tempDir := t.TempDir()
+	if err := os.Chdir(tempDir); err != nil {
+		t.Fatalf("Chdir(%q) failed: %v", tempDir, err)
+	}
+	defer func() {
+		if err := os.Chdir(originalWD); err != nil {
+			t.Fatalf("restore Chdir(%q) failed: %v", originalWD, err)
+		}
+	}()
+
+	before := snapshotDir(t, tempDir)
+	for _, input := range []string{"0", "15", "2m", "1500ms", "abc"} {
+		_, _ = clientcmd.ParseTimeout(input)
+	}
+	after := snapshotDir(t, tempDir)
+	if !reflect.DeepEqual(after, before) {
+		t.Fatalf("ParseTimeout changed working directory contents: before=%v after=%v", before, after)
+	}
+}
+
+func snapshotDir(t *testing.T, root string) map[string]string {
+	t.Helper()
+	entries := map[string]string{}
+	err := filepath.WalkDir(root, func(path string, d fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if path == root {
+			return nil
+		}
+		info, err := d.Info()
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		entries[rel] = info.Mode().String()
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("snapshotDir(%q) failed: %v", root, err)
+	}
+	return entries
+}
