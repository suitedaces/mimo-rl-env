+import path from "node:path";
+import { defineConfig } from "vitest/config";
+
+export default defineConfig({
+  root: "/workspace/repo",
+  test: {
+    environment: "node",
+    include: ["usercase-test-coderl/**/*.test.ts"],
+  },
+  resolve: {
+    alias: {
+      "@": path.resolve("/workspace/repo/apps/desktop/src"),
+    },
+  },
+});
