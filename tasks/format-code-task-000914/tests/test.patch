diff --git a/usercase-test-coderl/latex-entry-file.test.ts b/usercase-test-coderl/latex-entry-file.test.ts
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/latex-entry-file.test.ts
@@ -0,0 +1,378 @@
+
+
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import http from "node:http";
+import https from "node:https";
+import { createRequire } from "node:module";
+import net from "node:net";
+import os from "node:os";
+import path from "node:path";
+import type { MockInstance } from "vitest";
+import { describe, expect, it, vi } from "vitest";
+import type { FileNode } from "@lmms-lab/writer-shared";
+import { findMainTexFile, findTexFiles } from "@/lib/latex";
+
+const requireFromHere = createRequire(import.meta.url);
+
+function file(name: string, filePath = name): FileNode {
+  return { name, path: filePath, type: "file" };
+}
+
+function dir(name: string, children: FileNode[], dirPath = name): FileNode {
+  return { name, path: dirPath, type: "directory", children };
+}
+
+function cloneFiles(files: FileNode[]): FileNode[] {
+  return JSON.parse(JSON.stringify(files)) as FileNode[];
+}
+
+function runFreshProcessProbe(): { texFiles: string[]; mainFile: string | null } {
+  const testFile = "/workspace/repo/usercase-test-coderl/latex-entry-file.test.ts";
+  const vitestPackage = requireFromHere.resolve("vitest/package.json", {
+    paths: ["/workspace/repo/apps/desktop"],
+  });
+  const vitestBin = path.join(path.dirname(vitestPackage), "vitest.mjs");
+  const output = execFileSync(
+    process.execPath,
+    [
+      vitestBin,
+      "run",
+      "--config",
+
+      "/workspace/repo/usercase-test-coderl/vitest.config.ts",
+      testFile,
+      "--reporter=verbose",
+    ],
+    {
+      cwd: "/workspace/repo/apps/desktop",
+      env: { ...process.env, TST_FRESH_PROCESS_PROBE: "1" },
+      encoding: "utf8",
+    },
+  );
+  const markerLine = output
+    .split(/\r?\n/)
+    .find((line) => line.includes("TST_FRESH_PROCESS_RESULT="));
+
+  if (!markerLine) {
+    throw new Error(`Fresh-process probe did not print a result:\n${output}`);
+  }
+
+  const json = markerLine.slice(markerLine.indexOf("TST_FRESH_PROCESS_RESULT=") + 25).trim();
+  return JSON.parse(json) as { texFiles: string[]; mainFile: string | null };
+}
+
+if (process.env.TST_FRESH_PROCESS_PROBE === "1") {
+  it("prints a fresh-process result for the no-global-state check", () => {
+    const files = [
+      file("notes.md"),
+      dir("src", [file("alpha.tex", "src/alpha.tex"), file("paper.tex", "src/paper.tex")]),
+    ];
+    const result = {
+      texFiles: findTexFiles(files),
+      mainFile: findMainTexFile(files),
+    };
+    console.log(`TST_FRESH_PROCESS_RESULT=${JSON.stringify(result)}`);
+  });
+} else {
+  describe("findTexFiles", () => {
+    it("returns only root .tex file paths and skips non-tex root files", () => {
+
+
+
+
+      const files = [file("main.tex"), file("README.md"), file("refs.bib")];
+
+      expect(findTexFiles(files)).toEqual(["main.tex"]);
+    });
+
+    it("walks directories depth-first after earlier root files", () => {
+
+
+
+
+      const files = [
+        file("main.tex"),
+        dir("chapters", [file("ch1.tex", "chapters/ch1.tex"), file("ch2.tex", "chapters/ch2.tex")]),
+      ];
+
+      expect(findTexFiles(files)).toEqual(["main.tex", "chapters/ch1.tex", "chapters/ch2.tex"]);
+    });
+
+    it("continues depth-first through nested directories before later siblings", () => {
+
+
+
+
+      const files = [
+        dir("frontmatter", [
+          file("abstract.tex", "frontmatter/abstract.tex"),
+          dir("deep", [file("notes.tex", "frontmatter/deep/notes.tex")], "frontmatter/deep"),
+        ]),
+        file("tail.tex"),
+      ];
+
+      expect(findTexFiles(files)).toEqual([
+        "frontmatter/abstract.tex",
+        "frontmatter/deep/notes.tex",
+        "tail.tex",
+      ]);
+    });
+
+    it("ignores directories named with a .tex suffix and files whose names do not end with lowercase .tex", () => {
+
+
+
+
+      const files = [
+        dir("fake.tex", [file("inside.tex", "fake.tex/inside.tex")]),
+        file("draft.tex.bak"),
+        file("UPPER.TEX"),
+        file("final.tex"),
+      ];
+
+      expect(findTexFiles(files)).toEqual(["fake.tex/inside.tex", "final.tex"]);
+    });
+
+    it("returns an empty array when there are no .tex file nodes", () => {
+
+
+
+
+      const files = [file("README.md"), file("Makefile")];
+
+      expect(findTexFiles(files)).toEqual([]);
+    });
+  });
+
+  describe("findMainTexFile", () => {
+    it("prefers root main.tex over other root .tex files", () => {
+
+
+
+
+      const files = [file("intro.tex"), file("main.tex"), file("appendix.tex")];
+
+      expect(findMainTexFile(files)).toBe("main.tex");
+    });
+
+    it("prefers root paper.tex when present", () => {
+
+
+
+
+      const files = [file("paper.tex"), file("appendix.tex")];
+
+      expect(findMainTexFile(files)).toBe("paper.tex");
+    });
+
+    it("recognizes thesis.tex as a common root main file", () => {
+
+
+
+
+      const files = [file("notes.md"), file("thesis.tex"), file("appendix.tex")];
+
+      expect(findMainTexFile(files)).toBe("thesis.tex");
+    });
+
+    it("recognizes document.tex as a common root main file", () => {
+
+
+
+
+      const files = [file("appendix.tex"), file("document.tex")];
+
+      expect(findMainTexFile(files)).toBe("document.tex");
+    });
+
+    it("recognizes report.tex as a common root main file", () => {
+
+
+
+
+      const files = [file("README.md"), file("report.tex")];
+
+      expect(findMainTexFile(files)).toBe("report.tex");
+    });
+
+    it("falls back to the first root-level .tex file", () => {
+
+
+
+
+      const files = [file("README.md"), file("myfile.tex")];
+
+      expect(findMainTexFile(files)).toBe("myfile.tex");
+    });
+
+    it("uses a root-level arbitrary .tex file before a recursive common basename", () => {
+
+
+
+
+      const files = [file("zeta.tex"), dir("src", [file("main.tex", "src/main.tex")])];
+
+      expect(findMainTexFile(files)).toBe("zeta.tex");
+    });
+
+    it("returns a recursive main.tex when no root .tex files exist", () => {
+
+
+
+
+      const files = [file("README.md"), dir("src", [file("main.tex", "src/main.tex")])];
+
+      expect(findMainTexFile(files)).toBe("src/main.tex");
+    });
+
+    it("prefers recursive common basenames over the first recursive arbitrary .tex path", () => {
+
+
+
+
+      const files = [
+        file("README.md"),
+        dir("src", [file("alpha.tex", "src/alpha.tex"), file("paper.tex", "src/paper.tex")]),
+      ];
+
+      expect(findMainTexFile(files)).toBe("src/paper.tex");
+    });
+
+    it("falls back to the first recursive .tex path when no common basename exists", () => {
+
+
+
+
+      const files = [
+        dir("src", [file("alpha.tex", "src/alpha.tex")]),
+        dir("appendix", [file("notes.tex", "appendix/notes.tex")]),
+      ];
+
+      expect(findMainTexFile(files)).toBe("src/alpha.tex");
+    });
+
+    it("returns null when the tree contains no .tex files", () => {
+
+
+
+
+      const files = [file("README.md"), file("Makefile")];
+
+      expect(findMainTexFile(files)).toBeNull();
+    });
+  });
+
+  describe("Lib-Pure contract checks", () => {
+    it("handles an empty root file tree", () => {
+
+      expect(findTexFiles([])).toEqual([]);
+      expect(findMainTexFile([])).toBeNull();
+    });
+
+    it("is referentially transparent for repeated calls on the same tree", () => {
+      const files = [
+        file("notes.md"),
+        dir("src", [file("alpha.tex", "src/alpha.tex"), file("paper.tex", "src/paper.tex")]),
+      ];
+
+      expect(findTexFiles(files)).toEqual(["src/alpha.tex", "src/paper.tex"]);
+      expect(findTexFiles(files)).toEqual(["src/alpha.tex", "src/paper.tex"]);
+      expect(findMainTexFile(files)).toBe("src/paper.tex");
+      expect(findMainTexFile(files)).toBe("src/paper.tex");
+    });
+
+    it("does not mutate the caller's file tree", () => {
+      const files = [
+        file("README.md"),
+        dir("src", [
+          file("alpha.tex", "src/alpha.tex"),
+          dir("deep", [file("report.tex", "src/deep/report.tex")], "src/deep"),
+        ]),
+      ];
+      const before = cloneFiles(files);
+
+      expect(findTexFiles(files)).toEqual(["src/alpha.tex", "src/deep/report.tex"]);
+      expect(findMainTexFile(files)).toBe("src/deep/report.tex");
+      expect(files).toEqual(before);
+      expect(files).toEqual([
+        { name: "README.md", path: "README.md", type: "file" },
+        {
+          name: "src",
+          path: "src",
+          type: "directory",
+          children: [
+            { name: "alpha.tex", path: "src/alpha.tex", type: "file" },
+            {
+              name: "deep",
+              path: "src/deep",
+              type: "directory",
+              children: [{ name: "report.tex", path: "src/deep/report.tex", type: "file" }],
+            },
+          ],
+        },
+      ]);
+    });
+
+    it("does not depend on module-level state across noisy in-process calls or a fresh process", () => {
+      const target = [
+        file("notes.md"),
+        dir("src", [file("alpha.tex", "src/alpha.tex"), file("paper.tex", "src/paper.tex")]),
+      ];
+      const noise = [file("main.tex"), dir("chapters", [file("ch1.tex", "chapters/ch1.tex")])];
+
+      expect(findTexFiles(target)).toEqual(["src/alpha.tex", "src/paper.tex"]);
+      expect(findMainTexFile(target)).toBe("src/paper.tex");
+      expect(findTexFiles(noise)).toEqual(["main.tex", "chapters/ch1.tex"]);
+      expect(findMainTexFile(noise)).toBe("main.tex");
+      expect(findTexFiles(target)).toEqual(["src/alpha.tex", "src/paper.tex"]);
+      expect(findMainTexFile(target)).toBe("src/paper.tex");
+
+      expect(runFreshProcessProbe()).toEqual({
+        texFiles: ["src/alpha.tex", "src/paper.tex"],
+        mainFile: "src/paper.tex",
+      });
+    });
+
+    it("does not perform filesystem or network side effects", () => {
+      const originalCwd = process.cwd();
+      const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "latex-entry-file-pure-"));
+      const failIo = () => {
+        throw new Error("undeclared filesystem or network side effect");
+      };
+      let spies: MockInstance[] = [];
+
+      try {
+        process.chdir(tempDir);
+        const before = fs.readdirSync(tempDir).sort();
+        spies = [
+          vi.spyOn(fs, "readFileSync").mockImplementation(failIo as never),
+          vi.spyOn(fs, "writeFileSync").mockImplementation(failIo as never),
+          vi.spyOn(fs, "appendFileSync").mockImplementation(failIo as never),
+          vi.spyOn(fs, "openSync").mockImplementation(failIo as never),
+          vi.spyOn(net, "connect").mockImplementation(failIo as never),
+          vi.spyOn(net, "createConnection").mockImplementation(failIo as never),
+          vi.spyOn(http, "request").mockImplementation(failIo as never),
+          vi.spyOn(https, "request").mockImplementation(failIo as never),
+        ];
+
+        const files = [file("README.md"), dir("src", [file("main.tex", "src/main.tex")])];
+        expect(findTexFiles(files)).toEqual(["src/main.tex"]);
+        expect(findMainTexFile(files)).toBe("src/main.tex");
+
+        for (const spy of spies) {
+          spy.mockRestore();
+        }
+        spies = [];
+        const after = fs.readdirSync(tempDir).sort();
+        expect(after).toEqual(before);
+      } finally {
+        for (const spy of spies) {
+          spy.mockRestore();
+        }
+        process.chdir(originalCwd);
+        fs.rmSync(tempDir, { recursive: true, force: true });
+      }
+    });
+  });
+}
