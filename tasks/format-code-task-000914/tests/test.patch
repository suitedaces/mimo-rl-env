+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo/apps/desktop
+exec node /workspace/repo/apps/desktop/node_modules/vitest/vitest.mjs run --config /workspace/repo/usercase-test-coderl/vitest.config.ts /workspace/repo/usercase-test-coderl/latex-entry-file.test.ts --reporter=verbose
