@@ -0,0 +1,16 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test ./rules/aip0215/ -run 'Test(AddRules|VersionedPackages)$' -v
+    ;;
+  new)
+    go test ./rules/aip0215/ -run '^TestForeignTypeReference_' -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
