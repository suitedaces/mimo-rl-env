diff --git a/__tests__/src/LocalManifests.test.js b/__tests__/src/LocalManifests.test.js
new file mode 100644
index 00000000..f52d0219
--- /dev/null
+++ b/__tests__/src/LocalManifests.test.js
@@ -0,0 +1,173 @@
+import React from 'react';
+import { shallow } from 'enzyme';
+import { call, select } from 'redux-saga/effects';
+import { expectSaga } from 'redux-saga-test-plan';
+
+import * as actions from '../../src/state/actions';
+import { catalogReducer } from '../../src/state/reducers/catalog';
+import { fetchResourceManifest } from '../../src/state/sagas/iiif';
+import {
+  fetchWindowManifest,
+  setWindowDefaultSearchQuery,
+  setWindowStartingCanvas,
+} from '../../src/state/sagas/windows';
+import { fetchManifest } from '../../src/state/sagas/iiif';
+import { getConfig, getManifests } from '../../src/state/selectors';
+import { ManifestListItem } from '../../src/components/ManifestListItem';
+
+
+function buildAddWindowAction(options) {
+  const mockState = {
+    config: {
+      thumbnailNavigation: { defaultPosition: 'off' },
+      window: { defaultSideBarPanel: 'info', sideBarOpenByDefault: false },
+    },
+    windows: {},
+  };
+
+  let captured;
+  const dispatch = (action) => { captured = action; return action; };
+  actions.addWindow(options)(dispatch, () => mockState);
+  return captured;
+}
+
+describe('Local (inline) manifests', () => {
+  describe('adding a resource to the catalog', () => {
+    it('merges supplied extra properties onto the catalog entry', () => {
+      const action = actions.addResource('m1', { foo: 'bar' }, { provider: 'file' });
+
+      expect(catalogReducer([], action)).toEqual([
+        { manifestId: 'm1', provider: 'file' },
+      ]);
+    });
+
+    it('stores only the manifestId when no extra properties are supplied', () => {
+      const action = actions.addResource('m1');
+
+      expect(catalogReducer([], action)).toEqual([
+        { manifestId: 'm1' },
+      ]);
+    });
+
+    it('keeps prepending and de-duplicating entries', () => {
+      const action = actions.addResource('m1', undefined, { provider: 'file' });
+
+      expect(catalogReducer([{ manifestId: 'm2' }], action)).toEqual([
+        { manifestId: 'm1', provider: 'file' },
+        { manifestId: 'm2' },
+      ]);
+
+      const dupe = actions.addResource('m2');
+      expect(catalogReducer([{ manifestId: 'm2' }], dupe)).toEqual([
+        { manifestId: 'm2' },
+      ]);
+    });
+  });
+
+  describe('fetching a resource manifest', () => {
+    it('stores supplied JSON directly and does not fetch over the network', () => {
+      fetch.resetMocks();
+      const manifestJson = { data: 'inline-resource' };
+      const action = actions.addResource('m1', manifestJson, { provider: 'file' });
+
+      return expectSaga(fetchResourceManifest, action)
+        .provide([
+          [select(getConfig), {}],
+          [select(getManifests), {}],
+        ])
+        .put(actions.receiveManifest('m1', manifestJson))
+        .run()
+        .then(() => {
+          expect(fetch).not.toHaveBeenCalled();
+        });
+    });
+
+    it('still fetches over the network when no JSON is supplied', () => {
+      fetch.resetMocks();
+      fetch.mockResponseOnce(JSON.stringify({ data: '12345' }));
+      const action = actions.addResource('m1');
+
+      return expectSaga(fetchResourceManifest, action)
+        .provide([
+          [select(getConfig), {}],
+          [select(getManifests), {}],
+        ])
+        .put(actions.receiveManifest('m1', { data: '12345' }))
+        .run()
+        .then(() => {
+          expect(fetch).toHaveBeenCalled();
+        });
+    });
+  });
+
+  describe('opening a window', () => {
+    it('stores an inline manifest directly without fetching it', () => {
+      const manifestJson = { data: 'inline-window' };
+      const action = buildAddWindowAction({ id: 'w1', manifest: manifestJson, manifestId: 'm1' });
+
+      return expectSaga(fetchWindowManifest, action)
+        .provide([
+          [select(getManifests), {}],
+          [call(setWindowStartingCanvas, action)],
+          [call(setWindowDefaultSearchQuery, action)],
+        ])
+        .put(actions.receiveManifest('m1', manifestJson))
+        .not.call(fetchManifest, { manifestId: 'm1' })
+        .run();
+    });
+
+    it('still fetches the manifest when no inline manifest is provided', () => {
+      const action = buildAddWindowAction({ id: 'w1', manifestId: 'm1' });
+
+      return expectSaga(fetchWindowManifest, action)
+        .provide([
+          [select(getManifests), {}],
+          [call(fetchManifest, { manifestId: 'm1' }), {}],
+          [call(setWindowStartingCanvas, action)],
+          [call(setWindowDefaultSearchQuery, action)],
+        ])
+        .call(fetchManifest, { manifestId: 'm1' })
+        .run();
+    });
+
+    it('does not fetch when the manifest is already available', () => {
+      const action = buildAddWindowAction({ id: 'w1', manifestId: 'm1' });
+
+      return expectSaga(fetchWindowManifest, action)
+        .provide([
+          [select(getManifests), { m1: {} }],
+          [call(setWindowStartingCanvas, action)],
+          [call(setWindowDefaultSearchQuery, action)],
+        ])
+        .not.call(fetchManifest, { manifestId: 'm1' })
+        .run();
+    });
+  });
+
+  describe('resource list item for a local manifest', () => {
+
+    function createWrapper(props) {
+      return shallow(
+        <ManifestListItem
+          manifestId="http://example.com"
+          addWindow={() => {}}
+          fetchManifest={props.fetchManifest}
+          t={k => k}
+          {...props}
+        />,
+      );
+    }
+
+    it('does not fetch when the provider is "file"', () => {
+      const fetchManifestFn = jest.fn();
+      createWrapper({ fetchManifest: fetchManifestFn, provider: 'file' });
+      expect(fetchManifestFn).not.toHaveBeenCalled();
+    });
+
+    it('fetches manifests that are not local', () => {
+      const fetchManifestFn = jest.fn();
+      createWrapper({ fetchManifest: fetchManifestFn });
+      expect(fetchManifestFn).toHaveBeenCalledWith('http://example.com');
+    });
+  });
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+JEST_CONFIG="$(mktemp /tmp/jest.unit.XXXXXX.json)"
+trap 'rm -f "$JEST_CONFIG"' EXIT
+cat > "$JEST_CONFIG" <<'EOF'
+{
+  "rootDir": "/testbed",
+  "collectCoverage": false,
+  "moduleNameMapper": {
+    "\\.s?css$": "<rootDir>/__mocks__/css.js"
+  },
+  "setupFiles": [
+    "<rootDir>/setupJest.js"
+  ],
+  "testEnvironment": "jsdom",
+  "testMatch": [
+    "<rootDir>/__tests__/src/**/?(*.)(spec|test|unit).{js,jsx}"
+  ],
+  "transformIgnorePatterns": [
+    "<rootDir>/node_modules/(?!manifesto.js)"
+  ]
+}
+EOF
+
+JEST="node_modules/.bin/jest -c $JEST_CONFIG"
+
+
+$JEST \
+  __tests__/src/actions/catalog.test.js \
+  __tests__/src/actions/window.test.js \
+  __tests__/src/reducers/catalog.test.js \
+  __tests__/src/sagas/iiif.test.js \
+  __tests__/src/sagas/windows.test.js \
+  __tests__/src/components/ManifestListItem.test.js
+
+
+$JEST __tests__/src/LocalManifests.test.js
