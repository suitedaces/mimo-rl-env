diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,35 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+if [ ! -f node_modules/.yarn-state.yml ]; then
+  yarn install --immutable
+fi
+
+run_setup() {
+  for pkg in packages/*/; do
+    if grep -q 'genversion' "$pkg/package.json" 2>/dev/null; then
+      npx genversion --semi "$pkg/lib/version.js" 2>/dev/null
+    fi
+  done
+}
+
+run_database_jest() {
+  local pattern="$1"
+  run_setup
+  yarn jest packages/database/__tests__/database.test.ts --no-coverage --runInBand --testNamePattern="$pattern"
+}
+
+case "${1:-}" in
+  base)
+    run_database_jest '^(?!.*(`enableLogging`.*properly exposed|`enableLogging`.*reports native non-support|`off`.*properly exposed|`off`.*reports native non-support)).*$'
+    ;;
+  new)
+    run_database_jest '`enableLogging`.*properly exposed|`enableLogging`.*reports native non-support|`off`.*properly exposed|`off`.*reports native non-support'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
