+#!/usr/bin/env bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    cd v2
+    go test -v -run '^(TestOverrideExample|TestGetCommands|TestGetSubCommand|TestGetConfig|TestGetConfigPath|TestLogErrors|TestAppRun|TestGoDog|TestStringArray|TestCommandLineParsing|TestSetupApp|TestFlagParsing|TestBooleanFlags|TestFlagValidation)$' .
+    ;;
+  new)
+    cd v2
+    go test -v -run '^(TestCommandDescriptionShownInSubcommandHelp|TestCommandDescriptionWorksForArbitraryCommandName|TestMultilineDescriptionPreservedInSubcommandHelp|TestGlobalHelpIncludesDescriptionsWhenPresent|TestGlobalHelpDoesNotAttachDescriptionsToUndescribedCommands|TestRepoV2AhoyYMLReleaseCommand|TestRepoV2AhoyYMLBuildCommandsUseGoreleaser|TestRepoV2AhoyYMLDoesNotDefineGodep)$' .
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
