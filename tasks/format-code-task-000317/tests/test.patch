diff --git a/v2/description_help_test.go b/v2/description_help_test.go
new file mode 100644
index 0000000..feb4e5c
--- /dev/null
+++ b/v2/description_help_test.go
@@ -0,0 +1,173 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func writeDescriptionFixture(t *testing.T) string {
+	t.Helper()
+	body := `ahoyapi: v2
+commands:
+  spotlight:
+    usage: Show spotlight usage
+    description: This single-line description should appear in command help.
+    cmd: echo spotlight
+
+  chaptered:
+    usage: Show chaptered usage
+    description: |
+      First paragraph for chaptered command.
+
+      Second paragraph keeps its own line.
+      - alpha item remains visible
+    cmd: echo chaptered
+
+  alpha-cmd:
+    usage: Alpha usage summary
+    description: Alpha command extended help text for global output.
+    cmd: echo alpha
+
+  beta-cmd:
+    usage: Beta usage summary
+    description: |
+      Beta command has a multiline global description.
+      Beta second line remains visible.
+    cmd: echo beta
+
+  lantern:
+    usage: Show lantern usage
+    description: Lantern command proves descriptions work for arbitrary command names.
+    cmd: echo lantern
+
+  codex-global:
+    usage: Codex global usage summary
+    description: Codex global description proves global help is not fixture-name hardcoded.
+    cmd: echo codex
+
+  plain-cmd:
+    usage: Plain usage summary
+    cmd: echo plain
+`
+	path := filepath.Join(t.TempDir(), "description-help.ahoy.yml")
+	if err := os.WriteFile(path, []byte(body), 0600); err != nil {
+		t.Fatalf("write temporary ahoy config: %v", err)
+	}
+	return path
+}
+
+func runAhoyForHelp(t *testing.T, config string, args ...string) string {
+	t.Helper()
+	goArgs := []string{"run", ".", "-f", config}
+	goArgs = append(goArgs, args...)
+	cmd := exec.Command("go", goArgs...)
+	var output bytes.Buffer
+	cmd.Stdout = &output
+	cmd.Stderr = &output
+	if err := cmd.Run(); err != nil {
+
+
+		if !strings.Contains(output.String(), "COMMANDS:") &&
+			!strings.Contains(output.String(), "USAGE:") {
+			t.Fatalf("ahoy help command failed: %v\n%s", err, output.String())
+		}
+	}
+	return output.String()
+}
+
+func assertContains(t *testing.T, output, want string) {
+	t.Helper()
+	if !strings.Contains(output, want) {
+		t.Fatalf("expected output to contain %q\nfull output:\n%s", want, output)
+	}
+}
+
+func assertInOrder(t *testing.T, output string, wants ...string) {
+	t.Helper()
+	offset := 0
+	for _, want := range wants {
+		index := strings.Index(output[offset:], want)
+		if index < 0 {
+			t.Fatalf("expected output to contain %q after byte offset %d\nfull output:\n%s", want, offset, output)
+		}
+		offset += index + len(want)
+	}
+}
+
+func TestCommandDescriptionShownInSubcommandHelp(t *testing.T) {
+	config := writeDescriptionFixture(t)
+
+	output := runAhoyForHelp(t, config, "--help", "spotlight")
+
+	assertContains(t, output, "Show spotlight usage")
+	assertContains(t, output, "This single-line description should appear in command help.")
+}
+
+func TestCommandDescriptionWorksForArbitraryCommandName(t *testing.T) {
+	config := writeDescriptionFixture(t)
+
+	output := runAhoyForHelp(t, config, "--help", "lantern")
+
+	assertContains(t, output, "Show lantern usage")
+	assertContains(t, output, "Lantern command proves descriptions work for arbitrary command names.")
+}
+
+func TestMultilineDescriptionPreservedInSubcommandHelp(t *testing.T) {
+	config := writeDescriptionFixture(t)
+
+	output := runAhoyForHelp(t, config, "--help", "chaptered")
+
+	assertContains(t, output, "Show chaptered usage")
+	assertInOrder(t, output,
+		"First paragraph for chaptered command.",
+		"Second paragraph keeps its own line.",
+		"- alpha item remains visible",
+	)
+}
+
+func TestGlobalHelpIncludesDescriptionsWhenPresent(t *testing.T) {
+	config := writeDescriptionFixture(t)
+
+	output := runAhoyForHelp(t, config, "--help")
+
+	assertContains(t, output, "COMMANDS:")
+	assertContains(t, output, "alpha-cmd")
+	assertContains(t, output, "Alpha usage summary")
+	assertContains(t, output, "Alpha command extended help text for global output.")
+	assertContains(t, output, "beta-cmd")
+	assertContains(t, output, "Beta usage summary")
+	assertInOrder(t, output,
+		"Beta command has a multiline global description.",
+		"Beta second line remains visible.",
+	)
+	assertContains(t, output, "codex-global")
+	assertContains(t, output, "Codex global usage summary")
+	assertContains(t, output, "Codex global description proves global help is not fixture-name hardcoded.")
+	assertContains(t, output, "plain-cmd")
+	assertContains(t, output, "Plain usage summary")
+}
+
+func TestGlobalHelpDoesNotAttachDescriptionsToUndescribedCommands(t *testing.T) {
+	config := writeDescriptionFixture(t)
+
+	output := runAhoyForHelp(t, config, "--help")
+
+	plainIndex := strings.Index(output, "plain-cmd")
+	if plainIndex < 0 {
+		t.Fatalf("expected global help to list plain-cmd\nfull output:\n%s", output)
+	}
+	plainSegment := output[plainIndex:]
+	for _, leaked := range []string{
+		"Alpha command extended help text for global output.",
+		"Beta command has a multiline global description.",
+		"Beta second line remains visible.",
+	} {
+		if strings.Contains(plainSegment, leaked) {
+			t.Fatalf("undescribed command appears to include neighboring description %q\nplain segment:\n%s\nfull output:\n%s", leaked, plainSegment, output)
+		}
+	}
+}
diff --git a/v2/repo_ahoy_config_test.go b/v2/repo_ahoy_config_test.go
new file mode 100644
index 0000000..2b36bf1
--- /dev/null
+++ b/v2/repo_ahoy_config_test.go
@@ -0,0 +1,71 @@
+package main
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+func repoAhoyCommandBlocks(t *testing.T) map[string]string {
+	t.Helper()
+	data, err := os.ReadFile(".ahoy.yml")
+	if err != nil {
+		t.Fatalf("read repository v2 .ahoy.yml: %v", err)
+	}
+
+	blocks := make(map[string]string)
+	var current string
+	var block []string
+	flush := func() {
+		if current != "" {
+			blocks[current] = strings.Join(block, "\n")
+		}
+	}
+
+	for _, line := range strings.Split(string(data), "\n") {
+		if strings.HasPrefix(line, "  ") && !strings.HasPrefix(line, "    ") && strings.HasSuffix(strings.TrimSpace(line), ":") {
+			flush()
+			current = strings.TrimSuffix(strings.TrimSpace(line), ":")
+			block = []string{line}
+			continue
+		}
+		if current != "" {
+			block = append(block, line)
+		}
+	}
+	flush()
+	return blocks
+}
+
+func assertRepoCommand(t *testing.T, blocks map[string]string, name, wantCmd string) {
+	t.Helper()
+	block, ok := blocks[name]
+	if !ok {
+		t.Fatalf("repository v2 .ahoy.yml does not define %s command", name)
+	}
+	wantLine := "    cmd: " + wantCmd
+	if !strings.Contains(block, wantLine) {
+		t.Fatalf("%s command mismatch:\nwant line: %q\nblock:\n%s", name, wantLine, block)
+	}
+}
+
+func TestRepoV2AhoyYMLReleaseCommand(t *testing.T) {
+	blocks := repoAhoyCommandBlocks(t)
+
+	assertRepoCommand(t, blocks, "release", "goreleaser release --config ../.goreleaser.yml --clean")
+}
+
+func TestRepoV2AhoyYMLBuildCommandsUseGoreleaser(t *testing.T) {
+	blocks := repoAhoyCommandBlocks(t)
+
+	assertRepoCommand(t, blocks, "build", "goreleaser build --config ../.goreleaser.yml --snapshot --clean --single-target")
+	assertRepoCommand(t, blocks, "build-all", "goreleaser build --config ../.goreleaser.yml --snapshot --clean")
+}
+
+func TestRepoV2AhoyYMLDoesNotDefineGodep(t *testing.T) {
+	blocks := repoAhoyCommandBlocks(t)
+
+	if _, ok := blocks["godep"]; ok {
+		t.Fatalf("repository v2 .ahoy.yml should not define the old godep alias command")
+	}
+}
