+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test -v -run '^TestReferenceConstructor_Construct$' ./pkg/zeaburpack/
+    ;;
+  new)
+    go test -v -run '^TestDockerfileProxyRewrite(PreservesStageAlias|HandlesLowercaseAsDeclaration|LeavesMultipleStageReferencesUnproxied|PlainFromStillUsesProxy|PlainFromUsesConfiguredProxy)$' ./pkg/zeaburpack/
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
