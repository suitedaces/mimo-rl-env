diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,47 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+export PATH="$HOME/.pyenv/versions/3.8.20/bin:$PATH"
+
+
+redis-cli ping > /dev/null 2>&1 || redis-server --daemonize yes --port 6379
+
+
+pg_isready > /dev/null 2>&1 || pg_ctlcluster 16 main start
+
+
+COMMON_ARGS=(-x -o "filterwarnings=")
+
+case "${1:-}" in
+  base)
+    SENTRY_LIGHT_BUILD=1 python3 -m pytest "${COMMON_ARGS[@]}" \
+      tests/sentry/api/endpoints/test_external_team.py \
+      tests/sentry/api/endpoints/test_external_team_details.py \
+      tests/sentry/api/endpoints/test_external_user.py \
+      tests/sentry/api/endpoints/test_external_user_details.py \
+      -k "not (test_create_with_external_id_persists or test_external_id_optional_values_are_accepted or test_create_with_invalid_external_id or test_create_rejects_too_long_external_id or test_external_team_update_with_external_id_persists or test_external_team_external_id_optional_values_are_accepted_on_update or test_external_team_rejects_too_long_external_id_on_update or test_external_user_create_with_external_id_persists or test_external_user_external_id_optional_values_are_accepted or test_external_user_rejects_invalid_external_id or test_external_user_update_with_external_id_persists or test_external_user_external_id_optional_values_are_accepted_on_update or test_external_user_rejects_too_long_external_id_on_update)"
+    ;;
+  new)
+    SENTRY_LIGHT_BUILD=1 python3 -m pytest "${COMMON_ARGS[@]}" \
+      tests/sentry/api/endpoints/test_external_team.py::ExternalTeamTest::test_create_with_external_id_persists \
+      tests/sentry/api/endpoints/test_external_team.py::ExternalTeamTest::test_external_id_optional_values_are_accepted \
+      tests/sentry/api/endpoints/test_external_team.py::ExternalTeamTest::test_create_with_invalid_external_id \
+      tests/sentry/api/endpoints/test_external_team.py::ExternalTeamTest::test_create_rejects_too_long_external_id \
+      tests/sentry/api/endpoints/test_external_team_details.py::ExternalTeamDetailsTest::test_external_team_update_with_external_id_persists \
+      tests/sentry/api/endpoints/test_external_team_details.py::ExternalTeamDetailsTest::test_external_team_external_id_optional_values_are_accepted_on_update \
+      tests/sentry/api/endpoints/test_external_team_details.py::ExternalTeamDetailsTest::test_external_team_rejects_too_long_external_id_on_update \
+      tests/sentry/api/endpoints/test_external_user.py::ExternalUserTest::test_external_user_create_with_external_id_persists \
+      tests/sentry/api/endpoints/test_external_user.py::ExternalUserTest::test_external_user_external_id_optional_values_are_accepted \
+      tests/sentry/api/endpoints/test_external_user.py::ExternalUserTest::test_external_user_rejects_invalid_external_id \
+      tests/sentry/api/endpoints/test_external_user_details.py::ExternalUserDetailsTest::test_external_user_update_with_external_id_persists \
+      tests/sentry/api/endpoints/test_external_user_details.py::ExternalUserDetailsTest::test_external_user_external_id_optional_values_are_accepted_on_update \
+      tests/sentry/api/endpoints/test_external_user_details.py::ExternalUserDetailsTest::test_external_user_rejects_too_long_external_id_on_update
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
