diff --git a/tests/apps/core/test_context_processors_frontend.py b/tests/apps/core/test_context_processors_frontend.py
new file mode 100644
index 000000000..b6e301beb
--- /dev/null
+++ b/tests/apps/core/test_context_processors_frontend.py
@@ -0,0 +1,145 @@
+
+
+
+
+import json
+
+from django.test import override_settings
+
+from cms.test_utils.testcases import CMSTestCase
+
+from richie.apps.core.factories import PageFactory
+
+AUTHENTICATION = {
+    "BASE_URL": "https://auth.example.com",
+    "BACKEND": "openedx-hawthorn",
+    "PROFILE_URLS": [
+        {"label": "Profile", "href": "{base_url}/u/(username)"},
+        {"label": "Account", "href": "{base_url}/account/settings"},
+    ],
+}
+
+LMS_BACKENDS = [
+    {
+        "BASE_URL": "https://lms-one.example.com",
+        "BACKEND": "richie.apps.courses.lms.edx.TokenEdXLMSBackend",
+        "JS_COURSE_REGEX": "^.*/courses/(?<course_id>.*)/info$",
+        "JS_SELECTOR_REGEX": "^.*lms-one.example.com.*$",
+
+        "SELECTOR_REGEX": "^.*lms-one.example.com.*$",
+        "COURSE_REGEX": "^.*/courses/(?P<course_id>.*)/info$",
+    },
+    {
+        "BASE_URL": "https://lms-two.example.com",
+        "BACKEND": "richie.apps.courses.lms.base.BaseLMSBackend",
+        "JS_COURSE_REGEX": "^.*/course/(?<course_id>.*)$",
+        "JS_SELECTOR_REGEX": "^.*lms-two.example.com.*$",
+    },
+]
+
+
+def _get_frontend_context(response):
+
+    return json.loads(response.context["FRONTEND_CONTEXT"])["context"]
+
+
+class FrontendContextAuthenticationTestCase(CMSTestCase):
+
+
+    @override_settings(AUTHENTICATION_DELEGATION=AUTHENTICATION)
+    def test_frontend_context_authentication(self):
+
+
+
+
+        page = PageFactory(should_publish=True, template="richie/single_column.html")
+        response = self.client.get(page.get_public_url(), follow=True)
+        self.assertEqual(response.status_code, 200)
+
+        context = _get_frontend_context(response)
+        self.assertEqual(
+            context["authentication"],
+            {"endpoint": "https://auth.example.com", "backend": "openedx-hawthorn"},
+        )
+
+    @override_settings(AUTHENTICATION_DELEGATION=AUTHENTICATION)
+    @override_settings(LMS_BACKENDS=LMS_BACKENDS)
+    def test_frontend_context_lms_backends(self):
+
+
+
+
+        page = PageFactory(should_publish=True, template="richie/single_column.html")
+        response = self.client.get(page.get_public_url(), follow=True)
+        self.assertEqual(response.status_code, 200)
+
+        context = _get_frontend_context(response)
+        self.assertEqual(
+            context["lms_backends"],
+            [
+                {
+                    "endpoint": "https://lms-one.example.com",
+                    "backend": "richie.apps.courses.lms.edx.TokenEdXLMSBackend",
+                    "course_regexp": "^.*/courses/(?<course_id>.*)/info$",
+                    "selector_regexp": "^.*lms-one.example.com.*$",
+                },
+                {
+                    "endpoint": "https://lms-two.example.com",
+                    "backend": "richie.apps.courses.lms.base.BaseLMSBackend",
+                    "course_regexp": "^.*/course/(?<course_id>.*)$",
+                    "selector_regexp": "^.*lms-two.example.com.*$",
+                },
+            ],
+        )
+
+    @override_settings(AUTHENTICATION_DELEGATION=AUTHENTICATION)
+    @override_settings(LMS_BACKENDS=[])
+    def test_frontend_context_lms_backends_empty(self):
+
+        page = PageFactory(should_publish=True, template="richie/single_column.html")
+        response = self.client.get(page.get_public_url(), follow=True)
+        self.assertEqual(response.status_code, 200)
+
+        context = _get_frontend_context(response)
+        self.assertEqual(context["lms_backends"], [])
+
+    @override_settings(SENTRY_DSN="https://example.com/sentry/dsn")
+    @override_settings(RELEASE="9.8.7")
+    @override_settings(ENVIRONMENT="test_frontend_context")
+    @override_settings(AUTHENTICATION_DELEGATION=AUTHENTICATION)
+    def test_frontend_context_keeps_generic_values(self):
+
+        page = PageFactory(should_publish=True, template="richie/single_column.html")
+        response = self.client.get(page.get_public_url(), follow=True)
+        self.assertEqual(response.status_code, 200)
+
+        context = _get_frontend_context(response)
+        self.assertEqual(context["environment"], "test_frontend_context")
+        self.assertEqual(context["release"], "9.8.7")
+        self.assertEqual(context["sentry_dsn"], "https://example.com/sentry/dsn")
+        self.assertIn("csrftoken", context)
+
+    @override_settings(AUTHENTICATION_DELEGATION=AUTHENTICATION)
+    def test_authentication_profile_urls_context(self):
+
+
+
+
+        page = PageFactory(should_publish=True, template="richie/single_column.html")
+        response = self.client.get(page.get_public_url(), follow=True)
+        self.assertEqual(response.status_code, 200)
+
+        profile_urls = json.loads(response.context["AUTHENTICATION"]["PROFILE_URLS"])
+        self.assertEqual(
+            profile_urls,
+            [
+                {
+                    "label": "Profile",
+                    "action": "https://auth.example.com/u/(username)",
+                },
+                {
+                    "label": "Account",
+                    "action": "https://auth.example.com/account/settings",
+                },
+            ],
+        )
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+export DJANGO_SETTINGS_MODULE=settings
+export DJANGO_CONFIGURATION=Development
+export DJANGO_SECRET_KEY=grading-secret-key
+export DB_ENGINE=django.db.backends.sqlite3
+export DB_NAME=/tmp/richie_grading.sqlite3
+export PYTHONPATH=/testbed/sandbox
+rm -f /tmp/richie_grading.sqlite3
+
+PYTEST_OPTS="-p no:cacheprovider --no-cov -q"
+
+
+python -m pytest $PYTEST_OPTS \
+    tests/apps/core/test_pages.py \
+    tests/apps/courses/lms/ \
+    tests/sandbox/test_settings.py
+
+
+python -m pytest $PYTEST_OPTS \
+    tests/apps/core/test_context_processors_frontend.py
