diff --git a/test/test_excerpt.rb b/test/test_excerpt.rb
index 24647deca..ef5e12fe2 100644
--- a/test/test_excerpt.rb
+++ b/test/test_excerpt.rb
@@ -264,4 +264,117 @@ class TestExcerpt < JekyllUnitTest
       assert_equal true, @excerpt.is_a?(Jekyll::Excerpt)
     end
   end
+
+  context "with multiple Liquid blocks before an excerpt boundary" do
+    setup do
+      clear_dest
+      @site = fixture_site
+      @post = setup_post("2018-01-28-later-liquid-block-cut-excerpt.markdown")
+      @excerpt = @post.data["excerpt"]
+    end
+
+    should "render when a later block is cut after an earlier closed block" do
+      rendered = nil
+
+      assert_silent do
+        rendered = do_render(@excerpt)
+      end
+
+      assert_includes rendered, "earlier closed block rendered"
+      assert_includes rendered, "captured before the separator"
+      refute_match %r!\{%-?\s*unless\b!, rendered
+      refute_match %r!\{%-?\s*endunless\b!, rendered
+    end
+  end
+
+  context "with balanced Liquid blocks before an excerpt boundary" do
+    setup do
+      clear_dest
+      @site = fixture_site
+      @post = setup_post("2018-01-28-balanced-liquid-blocks-before-excerpt.markdown")
+      @excerpt = @post.data["excerpt"]
+    end
+
+    should "not break the excerpt when all blocks are already balanced" do
+      rendered = nil
+
+      assert_silent do
+        rendered = do_render(@excerpt)
+      end
+
+      assert_includes rendered, "balanced conditional text"
+      assert_includes rendered, "balanced capture text"
+      refute_match %r!\{%-?\s*(?:end)?if\b!, rendered
+      refute_match %r!\{%-?\s*(?:end)?capture\b!, rendered
+    end
+  end
+
+  class ExcerptCustomBlockBaseFor7352 < Liquid::Block
+    def render(context)
+      "custom-block: #{super.to_s.strip}"
+    end
+  end
+
+  class ExcerptCustomAlphaFor7352 < ExcerptCustomBlockBaseFor7352
+  end
+
+  class ExcerptCustomBetaFor7352 < ExcerptCustomBlockBaseFor7352
+  end
+
+  context "with registered custom Liquid block tags" do
+    setup do
+      clear_dest
+      @site = fixture_site
+
+      Liquid::Template.register_tag(
+        "excerptcustomalpha7352",
+        ExcerptCustomAlphaFor7352
+      )
+      Liquid::Template.register_tag(
+        "excerptcustombeta7352",
+        ExcerptCustomBetaFor7352
+      )
+
+      @post = setup_post("2018-01-28-custom-liquid-block-excerpt.markdown")
+      @excerpt = @post.data["excerpt"]
+    end
+
+    should "render a registered custom block tag when cut by the excerpt separator" do
+      rendered = nil
+
+      assert_silent do
+        rendered = do_render(@excerpt)
+      end
+
+      assert_includes rendered, "custom-block: alpha body before separator"
+      assert_includes rendered, "custom-block: custom body before separator"
+      refute_match %r!\{%-?\s*excerptcustom(?:alpha|beta)7352\b!, rendered
+      refute_match %r!\{%-?\s*endexcerptcustom(?:alpha|beta)7352\b!, rendered
+    end
+  end
+
+  context "when excerpt generation adjusts a cut Liquid block" do
+    should "warn with the affected document, separator, adjustment, and user guidance" do
+      warnings = []
+      logger = Jekyll.logger
+
+      logger.stub(:warn, proc { |*args| warnings << args.join(" ") }) do
+        clear_dest
+        @site = fixture_site
+        post = setup_post("2018-01-28-later-liquid-block-cut-excerpt.markdown")
+        do_render(post.data["excerpt"])
+      end
+
+      warning_text = warnings.join(" ")
+
+      assert_includes warning_text,
+        "2018-01-28-later-liquid-block-cut-excerpt.markdown"
+      assert_includes warning_text, "<!--cut-later-block-->"
+      assert_match %r!\b(?:adjusted|modified|changed)\b!i, warning_text
+      assert_match %r!\bexcerpt_separator\b!, warning_text
+      assert_match %r!\bcustom\s+excerpt\b!i, warning_text
+      assert_match %r!\bfront\s+matter\b!i, warning_text
+    end
+  end
+
 end
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,23 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export PATH="$HOME/.rbenv/bin:$PATH"
+eval "$(rbenv init - bash)"
+
+
+case "${1:-}" in
+  base)
+    ruby -Ilib -Itest test/test_excerpt.rb \
+      --exclude '/multiple Liquid blocks before an excerpt boundary|balanced Liquid blocks before an excerpt boundary|registered custom Liquid block tags|excerpt generation adjusts a cut Liquid block/'
+    ;;
+  new)
+    ruby -Ilib -Itest test/test_excerpt.rb \
+      --name '/later block is cut after an earlier closed block|all blocks are already balanced|registered custom block tag when cut by the excerpt separator|affected document, separator, adjustment, and user guidance/'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
