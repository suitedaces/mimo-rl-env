+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+REG_BUILD="$(mktemp -d)"
+cmake -D CMAKE_BUILD_TYPE=Release -S /testbed/src -B "$REG_BUILD" >/dev/null
+cmake --build "$REG_BUILD" --target base
+
+
+TEST_BIN="$(mktemp -d)/permutationsutil_test"
+g++ -std=c++14 -Wall -I /testbed/src/base \
+    /testbed/src/tests/permutationsutil_test.cpp \
+    -lgtest -lgtest_main -lpthread -o "$TEST_BIN"
+"$TEST_BIN"
