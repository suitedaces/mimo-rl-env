diff --git a/src/tests/permutationsutil_test.cpp b/src/tests/permutationsutil_test.cpp
new file mode 100644
index 0000000..dada1c9
--- /dev/null
+++ b/src/tests/permutationsutil_test.cpp
@@ -0,0 +1,124 @@
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+#include <algorithm>
+#include <vector>
+#include <unordered_set>
+
+#include "gtest/gtest.h"
+
+#include "permutationsutil.h"
+
+namespace {
+
+
+bool IsPermutationOf(std::vector<int> a, std::vector<int> b) {
+  std::sort(a.begin(), a.end());
+  std::sort(b.begin(), b.end());
+  return a == b;
+}
+
+}
+
+TEST(ComputeAllPermutationsTest, EnumeratesAllPermutationsOfDistinctElements) {
+  std::vector<int> v = {1, 2, 3};
+  std::unordered_set<std::vector<int>> permutations;
+  ComputeAllPermutations(v, &permutations, 1000);
+
+
+  EXPECT_EQ(6u, permutations.size());
+  for (const std::vector<int>& p : permutations) {
+    EXPECT_TRUE(IsPermutationOf(p, v));
+  }
+
+  EXPECT_EQ(1u, permutations.count(v));
+}
+
+TEST(ComputeAllPermutationsTest, CollapsesRepeatedArrangementsFromDuplicateValues) {
+  std::vector<int> v = {1, 1, 2};
+  std::unordered_set<std::vector<int>> permutations;
+  ComputeAllPermutations(v, &permutations, 1000);
+
+
+  EXPECT_EQ(3u, permutations.size());
+  for (const std::vector<int>& p : permutations) {
+    EXPECT_TRUE(IsPermutationOf(p, v));
+  }
+}
+
+TEST(ComputeAllPermutationsTest, StopsNearTheBeamSize) {
+  std::vector<int> v = {1, 2, 3, 4, 5};
+  std::unordered_set<std::vector<int>> permutations;
+  const size_t beam = 10;
+  ComputeAllPermutations(v, &permutations, beam);
+
+
+
+  EXPECT_GE(permutations.size(), beam);
+  EXPECT_LE(permutations.size(), beam + 1);
+  for (const std::vector<int>& p : permutations) {
+    EXPECT_TRUE(IsPermutationOf(p, v));
+  }
+}
+
+TEST(ComputeRandomPermutationsTest, CollectsEveryPermutationWhenBeamExceedsThem) {
+  std::vector<int> v = {1, 2};
+  std::unordered_set<std::vector<int>> permutations;
+  ComputeRandomPermutations(v, &permutations, 100, 50);
+
+  EXPECT_EQ(2u, permutations.size());
+  EXPECT_EQ(1u, permutations.count(std::vector<int>({1, 2})));
+  EXPECT_EQ(1u, permutations.count(std::vector<int>({2, 1})));
+}
+
+TEST(ComputeRandomPermutationsTest, SingleElementYieldsOnePermutation) {
+  std::vector<int> v = {5};
+  std::unordered_set<std::vector<int>> permutations;
+  ComputeRandomPermutations(v, &permutations, 100, 10);
+
+  EXPECT_EQ(1u, permutations.size());
+  EXPECT_EQ(1u, permutations.count(std::vector<int>({5})));
+}
+
+TEST(ComputeRandomPermutationsTest, NeverExceedsTheBeamSize) {
+  std::vector<int> v = {1, 2, 3, 4};
+  std::unordered_set<std::vector<int>> permutations;
+  const size_t beam = 3;
+  ComputeRandomPermutations(v, &permutations, beam, 100000);
+
+  EXPECT_GE(permutations.size(), 1u);
+  EXPECT_LE(permutations.size(), beam);
+  for (const std::vector<int>& p : permutations) {
+    EXPECT_TRUE(IsPermutationOf(p, v));
+  }
+}
+
+TEST(CalculateFactorialTest, ComputesSmallFactorials) {
+  EXPECT_EQ(1u, CalculateFactorial(0));
+  EXPECT_EQ(1u, CalculateFactorial(1));
+  EXPECT_EQ(120u, CalculateFactorial(5));
+  EXPECT_EQ(3628800u, CalculateFactorial(10));
+}
+
+TEST(CalculateFactorialTest, ComputesLargestValueThatFits) {
+  EXPECT_EQ(2432902008176640000ULL, CalculateFactorial(20));
+}
+
+TEST(CalculateFactorialTest, ReturnsSentinelOnOverflow) {
+  const uint64 overflow = static_cast<uint64>(-1);
+  EXPECT_EQ(overflow, CalculateFactorial(21));
+  EXPECT_EQ(overflow, CalculateFactorial(25));
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
