diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,215 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+export PYTHONPATH="/workspace/repo${PYTHONPATH:+:$PYTHONPATH}"
+
+PYTHON=${PYTHON:-/usr/local/bin/python}
+
+( cd /workspace/repo && "$PYTHON" - <<'PY'
+import psutil  # noqa: F401
+import six     # noqa: F401
+import trashcli.list.main  # noqa: F401
+PY
+) || { echo "FAIL: build/import" >&2; exit 1; }
+
+BIN=/workspace/repo/trash-list
+ROOT=/tmp/trashcli-fixture-coderl
+UID_VALUE=$(id -u)
+
+rm -rf "$ROOT"
+mkdir -p "$ROOT"
+trap 'rm -rf "$ROOT"' EXIT
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+run_trash_list() {
+    "$PYTHON" "$BIN" "$@" >out 2>err
+    ec=$?
+}
+
+assert_file_eq() {
+    name=$1
+    file=$2
+    expected=$3
+    actual=$(cat "$file")
+    [ "$actual" = "$expected" ] || fail "$name: got [$actual]"
+}
+
+assert_file_empty() {
+    name=$1
+    file=$2
+    [ ! -s "$file" ] || fail "$name unexpected output: $(cat "$file")"
+}
+
+assert_file_line_count() {
+    name=$1
+    file=$2
+    expected=$3
+    actual=$(wc -l <"$file" | tr -d ' ')
+    [ "$actual" = "$expected" ] || fail "$name: got $actual lines; want $expected: $(cat "$file")"
+}
+
+assert_file_has_line() {
+    name=$1
+    file=$2
+    expected=$3
+    grep -Fx -- "$expected" "$file" >/dev/null || fail "$name missing line [$expected]; got [$(cat "$file")]"
+}
+
+assert_file_contains() {
+    name=$1
+    file=$2
+    expected=$3
+    grep -F -- "$expected" "$file" >/dev/null || fail "$name missing text [$expected]; got [$(cat "$file")]"
+}
+
+write_trashinfo() {
+    path=$1
+    original=$2
+    deletion_date=$3
+    cat >"$path" <<EOF
+[Trash Info]
+Path=$original
+DeletionDate=$deletion_date
+EOF
+}
+
+cd "$ROOT"
+
+
+
+
+export HOME="$ROOT/home-default"
+export XDG_DATA_HOME="$ROOT/xdg-default"
+export TRASH_VOLUMES="$ROOT/vol-default"
+mkdir -p "$XDG_DATA_HOME/Trash/info" "$XDG_DATA_HOME/Trash/files"
+mkdir -p "$ROOT/vol-default/.Trash/$UID_VALUE/info" "$ROOT/vol-default/.Trash/$UID_VALUE/files"
+chmod +t "$ROOT/vol-default/.Trash"
+write_trashinfo "$XDG_DATA_HOME/Trash/info/home.trashinfo" "/file1" "2000-01-01T00:00:01"
+printf 'home' >"$XDG_DATA_HOME/Trash/files/home"
+write_trashinfo "$ROOT/vol-default/.Trash/$UID_VALUE/info/vol.trashinfo" "dir%20with%20space/name.txt" "2001-02-03T04:05:06"
+printf 'vol' >"$ROOT/vol-default/.Trash/$UID_VALUE/files/vol"
+run_trash_list
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+
+assert_file_line_count "F1 stdout" out 2
+assert_file_has_line "F1 stdout" out "2000-01-01 00:00:01 /file1"
+assert_file_has_line "F1 stdout" out "2001-02-03 04:05:06 /tmp/trashcli-fixture-coderl/vol-default/dir with space/name.txt"
+assert_file_empty "F1 stderr" err
+
+
+
+
+unset XDG_DATA_HOME
+export HOME="$ROOT/home-explicit"
+export TRASH_VOLUMES=":"
+mkdir -p "$ROOT/explicit-a/info" "$ROOT/explicit-a/files"
+mkdir -p "$ROOT/explicit-b/info" "$ROOT/explicit-b/files"
+write_trashinfo "$ROOT/explicit-a/info/a.trashinfo" "/alpha" "2010-10-10T10:10:10"
+printf 'A' >"$ROOT/explicit-a/files/a"
+write_trashinfo "$ROOT/explicit-b/info/b.trashinfo" "/beta" "2011-11-11T11:11:11"
+printf 'B' >"$ROOT/explicit-b/files/b"
+run_trash_list --trash-dir "$ROOT/explicit-a" --trash-dir "$ROOT/explicit-b"
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+
+assert_file_line_count "F2 stdout" out 2
+assert_file_has_line "F2 stdout" out "2010-10-10 10:10:10 /alpha"
+assert_file_has_line "F2 stdout" out "2011-11-11 11:11:11 /beta"
+assert_file_empty "F2 stderr" err
+
+
+
+
+mkdir -p "$ROOT/size-trash/info" "$ROOT/size-trash/files"
+write_trashinfo "$ROOT/size-trash/info/empty.trashinfo" "/empty.bin" "2020-01-01T00:00:00"
+: >"$ROOT/size-trash/files/empty"
+write_trashinfo "$ROOT/size-trash/info/payload.trashinfo" "/payload.bin" "2020-01-01T00:00:01"
+printf 'hello world' >"$ROOT/size-trash/files/payload"
+run_trash_list --trash-dir "$ROOT/size-trash" --size
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+
+assert_file_line_count "F3 stdout" out 2
+assert_file_has_line "F3 stdout" out "0 /empty.bin"
+assert_file_has_line "F3 stdout" out "11 /payload.bin"
+assert_file_empty "F3 stderr" err
+
+
+
+
+mkdir -p "$ROOT/files-trash/info" "$ROOT/files-trash/files"
+write_trashinfo "$ROOT/files-trash/info/base-name.trashinfo" "/original.txt" "2022-02-02T02:02:02"
+printf 'backing' >"$ROOT/files-trash/files/base-name"
+run_trash_list --trash-dir "$ROOT/files-trash" --files
+EXPECTED='2022-02-02 02:02:02 /original.txt -> /tmp/trashcli-fixture-coderl/files-trash/files/base-name'
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+assert_file_eq "F4 stdout" out "$EXPECTED"
+assert_file_empty "F4 stderr" err
+
+
+
+
+run_trash_list --trash-dir "$ROOT/files-trash" --size --files
+EXPECTED='7 /original.txt -> /tmp/trashcli-fixture-coderl/files-trash/files/base-name'
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+assert_file_eq "F5 stdout" out "$EXPECTED"
+assert_file_empty "F5 stderr" err
+
+
+
+
+mkdir -p "$ROOT/errors-trash/info" "$ROOT/errors-trash/files"
+write_trashinfo "$ROOT/errors-trash/info/good.trashinfo" "/still-listed" "2030-03-03T03:03:03"
+printf 'good' >"$ROOT/errors-trash/files/good"
+cat >"$ROOT/errors-trash/info/nopath.trashinfo" <<'EOF'
+[Trash Info]
+DeletionDate=2031-03-03T03:03:03
+EOF
+ln -s "$ROOT/errors-trash/info/does-not-exist" "$ROOT/errors-trash/info/unreadable.trashinfo"
+run_trash_list --trash-dir "$ROOT/errors-trash"
+EXPECTED_OUT='2030-03-03 03:03:03 /still-listed'
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+assert_file_eq "F6 stdout" out "$EXPECTED_OUT"
+
+assert_file_contains "F6 stderr" err "Parse Error: /tmp/trashcli-fixture-coderl/errors-trash/info/nopath.trashinfo: Unable to parse Path."
+assert_file_contains "F6 stderr" err "No such file or directory"
+assert_file_contains "F6 stderr" err "/tmp/trashcli-fixture-coderl/errors-trash/info/unreadable.trashinfo"
+
+
+
+
+export HOME="$ROOT/home-skip"
+export XDG_DATA_HOME="$ROOT/xdg-skip-empty"
+export TRASH_VOLUMES="$ROOT/nosticky-vol"
+mkdir -p "$XDG_DATA_HOME" "$ROOT/nosticky-vol/.Trash/$UID_VALUE"
+chmod 0755 "$ROOT/nosticky-vol/.Trash"
+run_trash_list
+EXPECTED="TrashDir skipped because parent not sticky: /tmp/trashcli-fixture-coderl/nosticky-vol/.Trash/$UID_VALUE"
+[ "$ec" -eq 0 ] || fail "F7a exit $ec; want 0"
+assert_file_empty "F7a stdout" out
+assert_file_eq "F7a stderr" err "$EXPECTED"
+
+export XDG_DATA_HOME="$ROOT/xdg-skip-empty2"
+export TRASH_VOLUMES="$ROOT/symlink-vol"
+mkdir -p "$XDG_DATA_HOME" "$ROOT/symlink-target/$UID_VALUE" "$ROOT/symlink-vol"
+chmod +t "$ROOT/symlink-target"
+ln -s "$ROOT/symlink-target" "$ROOT/symlink-vol/.Trash"
+run_trash_list
+EXPECTED="TrashDir skipped because parent is symlink: /tmp/trashcli-fixture-coderl/symlink-vol/.Trash/$UID_VALUE"
+[ "$ec" -eq 0 ] || fail "F7b exit $ec; want 0"
+assert_file_empty "F7b stdout" out
+assert_file_eq "F7b stderr" err "$EXPECTED"
+
+
+
+
+run_trash_list --trash-dir
+
+[ "$ec" -ne 0 ] || fail "F8 exit $ec; want nonzero"
+assert_file_empty "F8 stdout" out
+
+[ -s err ] || fail "F8 stderr empty"
+assert_file_contains "F8 stderr" err "--trash-dir"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
