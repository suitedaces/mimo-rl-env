diff --git a/test/data/references_resolution.test.js b/test/data/references_resolution.test.js
new file mode 100644
index 0000000..d1df847
--- /dev/null
+++ b/test/data/references_resolution.test.js
@@ -0,0 +1,68 @@
+
+'use strict';
+
+var assert = require('assert');
+var getData = require('../../src/file').getData;
+var postProcess = require('../../src/parser').postProcess;
+
+describe('#cross-reference resolution', function () {
+  var data;
+
+  before(function (done) {
+    getData('test/data/fixture/references').then(function (result) {
+      data = result;
+      done();
+    }, done);
+  });
+
+  it('links untyped and explicitly typed aliases to their targets', function () {
+    assert.deepEqual(data.function.core.aliased, ['legacy-core', 'legacy-core-two']);
+    assert.deepEqual(data.mixin['mix-core'].aliased, ['legacy-mix', 'legacy-mix-bare']);
+    assert.strictEqual(Object.prototype.hasOwnProperty.call(data.function['mix-core'], 'aliased'), false);
+  });
+
+  it('leaves an unresolved alias declaration intact without changing other items', function () {
+    assert.deepEqual(data.function['broken-alias'].alias, ['does-not-exist']);
+    assert.strictEqual(Object.prototype.hasOwnProperty.call(data.function['broken-alias'], 'aliased'), false);
+    assert.strictEqual(Object.prototype.hasOwnProperty.call(data.function.consumer, 'aliased'), false);
+  });
+
+  it('resolves direct requirements and records reverse users once', function () {
+    var consumer = data.function.consumer;
+    var requiredNames = consumer.requires.map(function (req) {
+      return req.item && req.item.context.name;
+    });
+
+    assert.strictEqual(requiredNames[0], 'legacy-core');
+    assert.strictEqual(requiredNames[1], 'core');
+    assert.strictEqual(requiredNames[2], 'core');
+    assert.strictEqual(consumer.requires[3].item.context.name, 'legacy-mix');
+    assert.deepEqual(data.function.core.usedBy.map(function (item) {
+      return item.context.name;
+    }), ['consumer']);
+    assert.deepEqual(data.function['legacy-core'].usedBy.map(function (item) {
+      return item.context.name;
+    }), ['consumer']);
+  });
+
+  it('keeps external and unresolved requirements as metadata without reverse links', function () {
+    var consumer = data.function.consumer;
+    var external = consumer.requires[4];
+    var missing = consumer.requires[5];
+
+    assert.strictEqual(external.external, true);
+    assert.strictEqual(external.url, 'https://vendor.example/utility');
+    assert.strictEqual(Object.prototype.hasOwnProperty.call(external, 'item'), false);
+    assert.strictEqual(missing.external, false);
+    assert.strictEqual(Object.prototype.hasOwnProperty.call(missing, 'item'), false);
+    assert.strictEqual(Object.prototype.hasOwnProperty.call(data.function['missing-local'] || {}, 'usedBy'), false);
+  });
+
+  it('is idempotent when post-processing the same parsed graph again', function () {
+    postProcess(data);
+    assert.deepEqual(data.function.core.aliased, ['legacy-core', 'legacy-core-two']);
+    assert.deepEqual(data.function.core.usedBy.map(function (item) {
+      return item.context.name;
+    }), ['consumer']);
+  });
+});
