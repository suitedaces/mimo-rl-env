+def make_table(
+    values,
+    page=1,
+    order=1,
+    accuracy=95.0,
+    whitespace=5.0,
+    x_step=100,
+    top=300,
+    row_height=20,
+):
+    ncols = len(values[0]) if values else 0
+    xs = [i * x_step for i in range(ncols + 1)]
+    ys = [top - i * row_height for i in range(len(values) + 1)]
+    cols = list(zip(xs[:-1], xs[1:]))
+    rows = list(zip(ys[:-1], ys[1:]))
+    table = Table(cols=cols, rows=rows)
+    table.df = pd.DataFrame(values)
+    table.shape = table.df.shape
+    table.page = page
+    table.order = order
+    table.accuracy = accuracy
+    table.whitespace = whitespace
+    table._bbox = (min(xs), min(ys), max(xs), max(ys)) if xs and ys else None
+    return table
+
+
+def table_summary(table):
+    return {
+        "df": table.df.values.tolist(),
+        "shape": list(table.df.shape),
+        "page": table.page,
+        "order": table.order,
+        "accuracy": table.accuracy,
+        "whitespace": table.whitespace,
+        "confidence": table.confidence,
+        "parsing_report": table.parsing_report,
+        "rows": [list(row) for row in table.rows],
+        "first_cell": [
+            table.cells[0][0].x1,
+            table.cells[0][0].y1,
+            table.cells[0][0].x2,
+            table.cells[0][0].y2,
+        ],
+        "last_cell": [
+            table.cells[-1][-1].x1,
+            table.cells[-1][-1].y1,
+            table.cells[-1][-1].x2,
+            table.cells[-1][-1].y2,
+        ],
+    }
+
+
+def table_list_summary(table_list):
+    return [table_summary(table) for table in table_list]
+
+
+GEOMETRY_KEYS = {"rows", "first_cell", "last_cell"}
+
+
+def assert_spec_value(actual, expected):
+    if isinstance(expected, float):
+
+        assert actual == pytest.approx(expected)
+    elif isinstance(expected, dict):
+        assert actual.keys() == expected.keys()
+        for key, expected_value in expected.items():
+            assert_spec_value(actual[key], expected_value)
+    elif isinstance(expected, list):
+        assert len(actual) == len(expected)
+        for actual_value, expected_value in zip(actual, expected):
+            assert_spec_value(actual_value, expected_value)
+    else:
+        assert actual == expected
+
+
+def assert_summary_matches_spec(actual, expected):
+
+
+
+    assert len(actual) == len(expected)
+    for table, expected_table in zip(actual, expected):
+        actual_non_geometry = {
+            key: value for key, value in table.items() if key not in GEOMETRY_KEYS
+        }
+        expected_non_geometry = {
+            key: value
+            for key, value in expected_table.items()
+            if key not in GEOMETRY_KEYS
+        }
+        assert_spec_value(actual_non_geometry, expected_non_geometry)
+        assert len(table["rows"]) >= len(table["df"])
+        assert len(table["first_cell"]) == 4
+        assert len(table["last_cell"]) == 4
+        assert table["first_cell"][1] == table["rows"][0][1]
+        assert table["first_cell"][3] == table["rows"][0][0]
+        assert table["last_cell"][1] == table["rows"][-1][1]
+        assert table["last_cell"][3] == table["rows"][-1][0]
+        for top, bottom in table["rows"]:
+            assert top >= bottom
+        for previous, current in zip(table["rows"], table["rows"][1:]):
+            assert previous[1] >= current[0]
+
