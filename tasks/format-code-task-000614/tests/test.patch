+    xs = [i * 100 for i in range(len(values[0]) + 1)]
+    ys = [300 - i * 20 for i in range(len(values) + 1)]
+    table = Table(cols=list(zip(xs[:-1], xs[1:])), rows=list(zip(ys[:-1], ys[1:])))
+    table.df = pd.DataFrame(values)
+    table.shape = table.df.shape
+    table.page = page
+    table.order = order
+    table.accuracy = accuracy
+    table.whitespace = whitespace
+    table._bbox = (min(xs), min(ys), max(xs), max(ys))
+    return table
+
+def table_summary(table):
+    return {
+        "df": table.df.values.tolist(),
+        "shape": list(table.df.shape),
+        "page": table.page,
+        "order": table.order,
+        "accuracy": table.accuracy,
+        "whitespace": table.whitespace,
+        "confidence": table.confidence,
+        "parsing_report": table.parsing_report,
+        "rows": [list(row) for row in table.rows],
+        "first_cell": [table.cells[0][0].x1, table.cells[0][0].y1, table.cells[0][0].x2, table.cells[0][0].y2],
+        "last_cell": [table.cells[-1][-1].x1, table.cells[-1][-1].y1, table.cells[-1][-1].x2, table.cells[-1][-1].y2],
+    }
+
+out = TableList([
+    make_table([["ID", "Name"], ["1", "Alice"]], page=71, order=1),
+    make_table([["ID", "Name"], ["2", "Bob"]], page=72, order=1),
+]).stack_contiguous(match="first_row")
+print(json.dumps([table_summary(table) for table in out], sort_keys=True))
+"""
