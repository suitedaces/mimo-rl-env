@@ -1104,3 +1104,148 @@ def test_filter_filterset_based_on_mixin():
 
     assert not result.errors
     assert result.data == expected
+
+
+def _build_pet_ordering_schema():
+    """Helper: build a schema where PetNode supports ordering by name
+    via the standard django_filters.OrderingFilter."""
+    from django_filters import FilterSet, OrderingFilter as DFOrderingFilter
+
+    class PetOrderingFilter(FilterSet):
+        class Meta:
+            model = Pet
+            fields = ["name"]
+
+        order_by = DFOrderingFilter(fields=("name",))
+
+    class PetOrderType(DjangoObjectType):
+        class Meta:
+            model = Pet
+            interfaces = (Node,)
+
+    class Query(ObjectType):
+        all_pets = DjangoFilterConnectionField(
+            PetOrderType, filterset_class=PetOrderingFilter
+        )
+
+    return Schema(query=Query)
+
+
+def test_order_by_camelcase_single_word_field_works():
+    """User passes orderBy: "name" (single word). Should order ascending."""
+    Pet.objects.all().delete()
+    Pet.objects.create(name="Charlie", age=3)
+    Pet.objects.create(name="Alice", age=5)
+    Pet.objects.create(name="Bob", age=4)
+
+    schema = _build_pet_ordering_schema()
+    query = """
+        query {
+            allPets(orderBy: "name") {
+                edges { node { name } }
+            }
+        }
+    """
+    result = schema.execute(query)
+    assert not result.errors, result.errors
+    names = [e["node"]["name"] for e in result.data["allPets"]["edges"]]
+    assert names == ["Alice", "Bob", "Charlie"]
+
+
+def _build_article_ordering_schema():
+    """Helper: build a schema where ArticleNode supports ordering by
+    pub_date (snake_case) via the standard django_filters.OrderingFilter."""
+    from django_filters import FilterSet, OrderingFilter as DFOrderingFilter
+
+    class ArticleOrderingFilter(FilterSet):
+        class Meta:
+            model = Article
+            fields = ["headline"]
+
+        order_by = DFOrderingFilter(fields=("pub_date",))
+
+    class ArticleOrderType(DjangoObjectType):
+        class Meta:
+            model = Article
+            interfaces = (Node,)
+
+    class Query(ObjectType):
+        all_articles = DjangoFilterConnectionField(
+            ArticleOrderType, filterset_class=ArticleOrderingFilter
+        )
+
+    return Schema(query=Query)
+
+
+def _mk_reporter(first):
+    return Reporter.objects.create(
+        first_name=first, last_name=first, email="{}@x.com".format(first)
+    )
+
+
+def test_order_by_camelcase_descending_multiword_field_works():
+    """User passes orderBy: "-pubDate"; should order Articles by pub_date desc."""
+    Article.objects.all().delete()
+    Reporter.objects.all().delete()
+    r = _mk_reporter("rA")
+    Article.objects.create(
+        headline="old",
+        pub_date=datetime(2020, 1, 1),
+        pub_date_time=datetime(2020, 1, 1),
+        reporter=r,
+        editor=r,
+    )
+    Article.objects.create(
+        headline="new",
+        pub_date=datetime(2024, 1, 1),
+        pub_date_time=datetime(2024, 1, 1),
+        reporter=r,
+        editor=r,
+    )
+
+    schema = _build_article_ordering_schema()
+    query = """
+        query {
+            allArticles(orderBy: "-pubDate") {
+                edges { node { headline } }
+            }
+        }
+    """
+    result = schema.execute(query)
+    assert not result.errors, result.errors
+    headlines = [e["node"]["headline"] for e in result.data["allArticles"]["edges"]]
+    assert headlines == ["new", "old"]
+
+
+def test_order_by_camelcase_ascending_multiword_field_works():
+    """User passes orderBy: "pubDate"; should order Articles by pub_date asc."""
+    Article.objects.all().delete()
+    Reporter.objects.all().delete()
+    r = _mk_reporter("rB")
+    Article.objects.create(
+        headline="newer",
+        pub_date=datetime(2024, 6, 1),
+        pub_date_time=datetime(2024, 6, 1),
+        reporter=r,
+        editor=r,
+    )
+    Article.objects.create(
+        headline="older",
+        pub_date=datetime(2010, 3, 1),
+        pub_date_time=datetime(2010, 3, 1),
+        reporter=r,
+        editor=r,
+    )
+
+    schema = _build_article_ordering_schema()
+    query = """
+        query {
+            allArticles(orderBy: "pubDate") {
+                edges { node { headline } }
+            }
+        }
+    """
+    result = schema.execute(query)
+    assert not result.errors, result.errors
+    headlines = [e["node"]["headline"] for e in result.data["allArticles"]["edges"]]
+    assert headlines == ["older", "newer"]
