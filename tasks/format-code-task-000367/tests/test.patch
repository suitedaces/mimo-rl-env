new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/unleash-module-registration.test.ts
@@ -0,0 +1,400 @@
+
+
+
+
+
+
+
+import { execFileSync } from 'node:child_process';
+import * as fs from 'node:fs';
+import * as http from 'node:http';
+import * as https from 'node:https';
+import * as net from 'node:net';
+import * as os from 'node:os';
+import * as path from 'node:path';
+
+jest.mock('unleash-client', () => ({
+  Unleash: jest.fn().mockImplementation(() => ({
+    destroy: jest.fn(),
+    getFeatureToggleDefinition: jest.fn(),
+    isEnabled: jest.fn(),
+    on: jest.fn(),
+  })),
+}));
+
+import { Module } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { Unleash } from 'unleash-client';
+
+import {
+  UNLEASH_CLIENT_CONFIG,
+  UNLEASH_CLIENT_MODULE_OPTIONS,
+  UnleashClientModule,
+  UnleashClientProvider,
+  UnleashGuard,
+} from '../src';
+
+class ImportedAlphaModule {}
+Module({})(ImportedAlphaModule);
+
+class ImportedBetaModule {}
+Module({})(ImportedBetaModule);
+
+class ConfigService {}
+
+type ProviderRecord = Record<string, any>;
+
+function tokenName(value: unknown): string {
+  if (typeof value === 'string') return value;
+  if (typeof value === 'function') return value.name;
+  if (value && typeof value === 'object' && 'module' in value) {
+    return `DynamicModule(${tokenName((value as ProviderRecord).module)})`;
+  }
+  return String(value);
+}
+
+function providerShape(provider: unknown): ProviderRecord {
+  if (typeof provider === 'function') {
+    return { kind: 'class', token: provider.name };
+  }
+
+  const record = provider as ProviderRecord;
+  const shape: ProviderRecord = {
+    kind: record.useValue !== undefined ? 'value' : record.useFactory ? 'factory' : 'unknown',
+    provide: tokenName(record.provide),
+  };
+
+  if ('useValue' in record) {
+    shape.useValue = record.useValue;
+  }
+  if (record.useFactory) {
+    shape.hasFactory = true;
+  }
+  if (record.inject) {
+    shape.inject = record.inject.map(tokenName);
+  }
+
+  return shape;
+}
+
+function moduleShape(moduleMetadata: ProviderRecord): ProviderRecord {
+  const byJson = (left: ProviderRecord | string, right: ProviderRecord | string) =>
+    JSON.stringify(left).localeCompare(JSON.stringify(right));
+
+  return {
+    module: tokenName(moduleMetadata.module),
+    global: moduleMetadata.global,
+    imports: (moduleMetadata.imports || []).map(tokenName),
+    exports: (moduleMetadata.exports || []).map(tokenName).sort(),
+    providers: (moduleMetadata.providers || []).map(providerShape).sort(byJson),
+  };
+}
+
+function findProvider(moduleMetadata: ProviderRecord, token: unknown): ProviderRecord {
+  const provider = (moduleMetadata.providers || []).find((candidate: unknown) => {
+    return typeof candidate === 'function'
+      ? candidate === token
+      : (candidate as ProviderRecord).provide === token;
+  });
+  if (!provider || typeof provider === 'function') {
+    throw new Error(`Expected object provider for ${tokenName(token)}`);
+  }
+  return provider as ProviderRecord;
+}
+
+const syncTrueConfig = {
+  config: { url: 'http://unleash.test/api/', appName: 'api' },
+  isGlobal: true,
+};
+
+const syncFalseConfig = {
+  config: { url: 'http://unleash.test/api/', appName: 'api' },
+  isGlobal: false,
+};
+
+const asyncFactory = (configService: ConfigService) => ({
+  config: { url: 'http://async-unleash.test/api/', appName: configService.constructor.name },
+});
+
+const promiseFactory = jest.fn(async () => ({
+  config: { url: 'http://promise-unleash.test/api/', appName: 'promise-api' },
+}));
+
+function expectCommonMetadata(moduleMetadata: ProviderRecord, isGlobal: boolean): void {
+  expect(moduleMetadata.module).toBe(UnleashClientModule);
+  expect(moduleMetadata.global).toBe(isGlobal);
+
+  expect(moduleMetadata.exports).toEqual(
+    expect.arrayContaining([UnleashClientProvider, UNLEASH_CLIENT_CONFIG, Reflector]),
+  );
+
+  expect(moduleMetadata.providers).toEqual(expect.arrayContaining([Reflector, UnleashGuard]));
+}
+
+function expectClientProviderInitializesWith(
+  createdProvider: UnleashClientProvider,
+  expectedConfig: ProviderRecord,
+): void {
+  const unleashConstructor = Unleash as unknown as jest.Mock;
+  unleashConstructor.mockClear();
+
+  createdProvider.onModuleInit();
+
+
+  expect(unleashConstructor).toHaveBeenCalledWith(expectedConfig);
+}
+
+function expectAsyncConfigProviderResolves(
+  configProvider: ProviderRecord,
+  resolvedOptions: ProviderRecord,
+): void {
+
+  if (configProvider.useFactory) {
+    expect(configProvider.useFactory(resolvedOptions)).toBe(resolvedOptions);
+  } else {
+    expect(configProvider.useExisting).toBe(UNLEASH_CLIENT_MODULE_OPTIONS);
+  }
+}
+
+describe('UnleashClientModule public registration API', () => {
+  it('returns synchronous global module metadata with the configured providers', () => {
+
+
+
+
+    const moduleMetadata = UnleashClientModule.forRoot(syncTrueConfig);
+
+    expectCommonMetadata(moduleMetadata, true);
+
+    const configProvider = findProvider(moduleMetadata, UNLEASH_CLIENT_CONFIG);
+    expect(configProvider.useValue).toBe(syncTrueConfig);
+
+    const clientFactoryProvider = findProvider(moduleMetadata, UnleashClientProvider);
+
+    expect(clientFactoryProvider.useFactory).toEqual(expect.any(Function));
+    expect(clientFactoryProvider.inject).toEqual(expect.arrayContaining([UNLEASH_CLIENT_CONFIG]));
+    const createdProvider = clientFactoryProvider.useFactory(syncTrueConfig);
+    expect(createdProvider).toBeInstanceOf(UnleashClientProvider);
+    expectClientProviderInitializesWith(createdProvider, {
+      url: 'http://unleash.test/api/',
+      appName: 'api',
+    });
+  });
+
+  it('returns equivalent synchronous metadata with the same config and global false', () => {
+
+
+
+
+    const moduleMetadata = UnleashClientModule.forRoot(syncFalseConfig);
+
+    expectCommonMetadata(moduleMetadata, false);
+    expect(findProvider(moduleMetadata, UNLEASH_CLIENT_CONFIG).useValue).toBe(syncFalseConfig);
+  });
+
+  it('preserves async imports, injects, and factory options in global metadata', () => {
+
+
+
+
+    const imports = [ImportedAlphaModule, ImportedBetaModule];
+    const inject = [ConfigService, 'TENANT'];
+    const moduleMetadata = UnleashClientModule.forRootAsync({
+      imports,
+      useFactory: asyncFactory,
+      inject,
+      isGlobal: true,
+    });
+
+    expect(moduleMetadata.imports).toEqual(imports);
+    expectCommonMetadata(moduleMetadata, true);
+
+    const optionsProvider = findProvider(moduleMetadata, UNLEASH_CLIENT_MODULE_OPTIONS);
+    expect(optionsProvider.useFactory).toBe(asyncFactory);
+    expect(optionsProvider.inject).toBe(inject);
+
+    const resolvedOptions = {
+      config: { url: 'http://async-unleash.test/api/', appName: 'async-api' },
+    };
+    const configProvider = findProvider(moduleMetadata, UNLEASH_CLIENT_CONFIG);
+    expectAsyncConfigProviderResolves(configProvider, resolvedOptions);
+
+    const clientProvider = findProvider(moduleMetadata, UnleashClientProvider);
+
+    expect(clientProvider.useFactory).toEqual(expect.any(Function));
+    const createdProvider = clientProvider.useFactory(resolvedOptions);
+    expect(createdProvider).toBeInstanceOf(UnleashClientProvider);
+    expectClientProviderInitializesWith(createdProvider, {
+      url: 'http://async-unleash.test/api/',
+      appName: 'async-api',
+    });
+  });
+
+  it('returns minimal async metadata without an options factory when only global false is supplied', () => {
+
+
+
+
+    const moduleMetadata = UnleashClientModule.forRootAsync({ isGlobal: false });
+
+    expect(moduleMetadata.imports).toEqual([]);
+    expectCommonMetadata(moduleMetadata, false);
+    expect(
+      (moduleMetadata.providers || []).some(
+        (provider: unknown) =>
+          typeof provider !== 'function' &&
+          (provider as ProviderRecord).provide === UNLEASH_CLIENT_MODULE_OPTIONS,
+      ),
+    ).toBe(false);
+
+    expect(findProvider(moduleMetadata, UNLEASH_CLIENT_CONFIG)).toBeDefined();
+    expect(findProvider(moduleMetadata, UnleashClientProvider).useFactory).toEqual(
+      expect.any(Function),
+    );
+  });
+
+  it('registers a promise-returning async options factory without invoking it', () => {
+
+
+
+
+    promiseFactory.mockClear();
+    const moduleMetadata = UnleashClientModule.forRootAsync({
+      useFactory: promiseFactory,
+      inject: [],
+      isGlobal: true,
+    });
+
+    expectCommonMetadata(moduleMetadata, true);
+    expect(findProvider(moduleMetadata, UNLEASH_CLIENT_MODULE_OPTIONS).useFactory).toBe(
+      promiseFactory,
+    );
+    expect(findProvider(moduleMetadata, UNLEASH_CLIENT_MODULE_OPTIONS).inject).toEqual([]);
+    expect(promiseFactory).not.toHaveBeenCalled();
+  });
+
+  it('raises a specific TypeError when the required sync config object is missing', () => {
+    expect(() => UnleashClientModule.forRoot(undefined as any)).toThrow(TypeError);
+  });
+
+  it('is referentially transparent for repeated calls with the same synchronous input', () => {
+    const firstShape = moduleShape(UnleashClientModule.forRoot(syncTrueConfig));
+    const secondShape = moduleShape(UnleashClientModule.forRoot(syncTrueConfig));
+
+
+    expect(firstShape).toEqual(secondShape);
+    expectCommonMetadata(UnleashClientModule.forRoot(syncTrueConfig), true);
+  });
+
+  it('does not mutate the caller supplied configuration object', () => {
+    const input = {
+      config: { url: 'http://unleash.test/api/', appName: 'api' },
+      isGlobal: true,
+    };
+    const before = JSON.parse(JSON.stringify(input));
+
+    UnleashClientModule.forRoot(input);
+
+    expect(input).toEqual(before);
+  });
+
+  it('returns the same metadata after unrelated in-process calls and from a fresh Node process', () => {
+    const inProcessShape = moduleShape(UnleashClientModule.forRoot(syncTrueConfig));
+    UnleashClientModule.forRoot(syncFalseConfig);
+    UnleashClientModule.forRootAsync({ isGlobal: false });
+
+    expect(moduleShape(UnleashClientModule.forRoot(syncTrueConfig))).toEqual(inProcessShape);
+
+    const script = `
+      const { UnleashClientModule } = require('/workspace/repo/src');
+      function tokenName(value) {
+        if (typeof value === 'string') return value;
+        if (typeof value === 'function') return value.name;
+        if (value && typeof value === 'object' && 'module' in value) {
+          return 'DynamicModule(' + tokenName(value.module) + ')';
+        }
+        return String(value);
+      }
+      function providerShape(provider) {
+        if (typeof provider === 'function') return { kind: 'class', token: provider.name };
+        const shape = {
+          kind: provider.useValue !== undefined ? 'value' : provider.useFactory ? 'factory' : 'unknown',
+          provide: tokenName(provider.provide),
+        };
+        if ('useValue' in provider) shape.useValue = provider.useValue;
+          if (provider.useFactory) shape.hasFactory = true;
+          if (provider.inject) shape.inject = provider.inject.map(tokenName);
+          return shape;
+        }
+        function moduleShape(moduleMetadata) {
+          const byJson = (left, right) => JSON.stringify(left).localeCompare(JSON.stringify(right));
+          return {
+            module: tokenName(moduleMetadata.module),
+            global: moduleMetadata.global,
+            imports: (moduleMetadata.imports || []).map(tokenName),
+            exports: (moduleMetadata.exports || []).map(tokenName).sort(),
+            providers: (moduleMetadata.providers || []).map(providerShape).sort(byJson),
+          };
+        }
+      process.stdout.write(JSON.stringify(moduleShape(UnleashClientModule.forRoot({
+        config: { url: 'http://unleash.test/api/', appName: 'api' },
+        isGlobal: true,
+      }))));
+    `;
+    const freshProcessShape = JSON.parse(
+      execFileSync(process.execPath, ['-r', 'ts-node/register', '-e', script], {
+        cwd: '/workspace/repo',
+        encoding: 'utf8',
+      }),
+    );
+
+    expectCommonMetadata(UnleashClientModule.forRoot(syncTrueConfig), true);
+    expect(freshProcessShape).toEqual(inProcessShape);
+  });
+
+  it('only constructs metadata and performs no undeclared filesystem or network side effects', () => {
+    const previousCwd = process.cwd();
+    const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'unleash-module-registration-'));
+    const before = fs.readdirSync(tempDir).sort();
+    process.chdir(tempDir);
+    const unleashConstructor = Unleash as unknown as jest.Mock;
+    unleashConstructor.mockClear();
+
+    const writeFileSyncSpy = jest.spyOn(fs, 'writeFileSync').mockImplementation(() => {
+      throw new Error('unexpected writeFileSync');
+    });
+    const appendFileSyncSpy = jest.spyOn(fs, 'appendFileSync').mockImplementation(() => {
+      throw new Error('unexpected appendFileSync');
+    });
+    const createWriteStreamSpy = jest.spyOn(fs, 'createWriteStream').mockImplementation(() => {
+      throw new Error('unexpected createWriteStream');
+    });
+    const socketConnectSpy = jest
+      .spyOn(net.Socket.prototype, 'connect')
+      .mockImplementation(function unexpectedConnect() {
+        throw new Error('unexpected socket connect');
+      } as any);
+    const httpRequestSpy = jest.spyOn(http, 'request').mockImplementation(() => {
+      throw new Error('unexpected http request');
+    });
+    const httpsRequestSpy = jest.spyOn(https, 'request').mockImplementation(() => {
+      throw new Error('unexpected https request');
+    });
+
+    try {
+      expectCommonMetadata(UnleashClientModule.forRoot(syncTrueConfig), true);
+      expectCommonMetadata(UnleashClientModule.forRootAsync({ isGlobal: false }), false);
+      expect(unleashConstructor).not.toHaveBeenCalled();
+      expect(fs.readdirSync(tempDir).sort()).toEqual(before);
+    } finally {
+      process.chdir(previousCwd);
+      writeFileSyncSpy.mockRestore();
+      appendFileSyncSpy.mockRestore();
+      createWriteStreamSpy.mockRestore();
+      socketConnectSpy.mockRestore();
+      httpRequestSpy.mockRestore();
+      httpsRequestSpy.mockRestore();
+      fs.rmSync(tempDir, { recursive: true, force: true });
+    }
+  });
+});
