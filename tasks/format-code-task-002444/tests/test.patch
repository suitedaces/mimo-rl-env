+[case testInitSubclassSuperCallNoArgs]
+class A:
+    def __init_subclass__(cls):
+        super().__init_subclass__()
+
+class B(A):
+    pass
+[builtins fixtures/object_with_init_subclass.pyi]
+
+[case testInitSubclassWithRegisterKwarg]
+class A:
+    def __init_subclass__(cls, *args, register: bool = True, **kwargs):
+        pass
+
+class B(A):
+    pass
+
+class C(A, register=False):
+    pass
+
+class D(C):
+    pass
+[builtins fixtures/object_with_init_subclass.pyi]
+
+[case testInitSubclassMissingRequiredKwargStillErrors]
+class A:
+    def __init_subclass__(cls, *, x: int) -> None:
+        pass
+
+class B(A):  # E: Missing named argument "x" for "__init_subclass__" of "A"
+    pass
+
+class C(A, x=1):
+    pass
+[builtins fixtures/object_with_init_subclass.pyi]
