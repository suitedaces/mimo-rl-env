diff --git a/usercase-test-coderl/test_space_timesteps.py b/usercase-test-coderl/test_space_timesteps.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_space_timesteps.py
@@ -0,0 +1,144 @@
+
+
+
+
+
+
+import builtins
+import copy
+import json
+import os
+import socket
+import subprocess
+import sys
+
+import pytest
+
+from sdg.respace import space_timesteps
+
+
+def test_single_sequence_section_rounds_evenly_across_whole_timeline():
+
+
+
+    assert space_timesteps(10, [5]) == {0, 2, 4, 7, 9}
+
+
+def test_two_sequence_sections_split_evenly_and_reset_offsets():
+
+
+
+    assert space_timesteps(12, [3, 3]) == {0, 2, 5, 6, 8, 11}
+
+
+def test_sequence_sections_distribute_remainder_to_earliest_sections():
+
+
+
+    assert space_timesteps(11, [2, 3, 1]) == {0, 3, 4, 6, 7, 8}
+
+
+def test_sequence_sections_handle_one_requested_step_boundary():
+
+
+
+    assert space_timesteps(9, [1, 2, 3]) == {0, 3, 5, 6, 7, 8}
+
+
+def test_comma_string_single_count_matches_integer_list():
+
+
+
+    assert space_timesteps(10, "5") == {0, 2, 4, 7, 9}
+
+
+def test_comma_string_multiple_counts_matches_integer_list():
+
+
+
+    assert space_timesteps(12, "3,3") == {0, 2, 5, 6, 8, 11}
+
+
+def test_ddim_string_uses_integer_stride_for_requested_count():
+
+
+
+    assert space_timesteps(10, "ddim5") == {0, 2, 4, 6, 8}
+
+
+def test_ddim_string_can_use_nontrivial_stride_boundary():
+
+
+
+    assert space_timesteps(12, "ddim3") == {0, 4, 8}
+
+
+def test_sequence_request_larger_than_section_raises_value_error():
+
+
+
+
+    with pytest.raises(ValueError):
+        space_timesteps(4, [5])
+
+
+def test_ddim_request_without_integer_stride_raises_value_error():
+
+
+
+
+    with pytest.raises(ValueError):
+        space_timesteps(10, "ddim7")
+
+
+def test_referential_transparency_for_repeated_same_input():
+    first = space_timesteps(11, [2, 3, 1])
+    second = space_timesteps(11, [2, 3, 1])
+    assert first == {0, 3, 4, 6, 7, 8}
+    assert second == {0, 3, 4, 6, 7, 8}
+    assert first == second
+
+
+def test_does_not_mutate_section_counts_list():
+    section_counts = [2, 3, 1]
+    original = copy.deepcopy(section_counts)
+    assert space_timesteps(11, section_counts) == {0, 3, 4, 6, 7, 8}
+    assert section_counts == original
+
+
+def test_no_global_state_across_fresh_python_process():
+    in_process = sorted(space_timesteps(12, [3, 3]))
+    script = (
+        "import json, sys; "
+        "sys.path.insert(0, '/workspace/repo'); "
+        "from sdg.respace import space_timesteps; "
+        "sys.stdout.write(json.dumps(sorted(space_timesteps(12, [3, 3]))))"
+    )
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    fresh_process = json.loads(completed.stdout)
+    assert in_process == [0, 2, 5, 6, 8, 11]
+    assert fresh_process == [0, 2, 5, 6, 8, 11]
+    assert fresh_process == in_process
+
+
+def test_no_filesystem_network_or_open_side_effects(tmp_path, monkeypatch):
+    def fail_socket(*args, **kwargs):
+        raise AssertionError("space_timesteps must not open network sockets")
+
+    def fail_open(*args, **kwargs):
+        raise AssertionError("space_timesteps must not access files")
+
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr(socket, "socket", fail_socket)
+    monkeypatch.setattr(builtins, "open", fail_open)
+
+    before = sorted(os.listdir(tmp_path))
+    assert space_timesteps(10, "ddim5") == {0, 2, 4, 6, 8}
+    after = sorted(os.listdir(tmp_path))
+    assert after == before == []
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -euo pipefail
+cd /workspace/repo
+export PYTHONPATH="/workspace/repo${PYTHONPATH:+:${PYTHONPATH}}"
+export PYTHONDONTWRITEBYTECODE=1
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+exec python -m pytest -p no:cacheprovider /workspace/repo/usercase-test-coderl/test_space_timesteps.py -v
