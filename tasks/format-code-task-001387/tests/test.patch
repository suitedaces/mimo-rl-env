+
+  describe('setItem fallback to localStorage on API errors', () => {
+    it('falls back to localStorage when the GET (init) request fails with non-404 (e.g. 403 Forbidden)', async () => {
+      request.mockReturnValue(Promise.reject({ status: 403 } as FetchError));
+      const storage = usePluginUserStorage();
+      await storage.setItem('key', 'value');
+      expect(localStorage.setItem).toHaveBeenCalledWith('plugin-id:abc:key', 'value');
+    });
+
+    it('falls back to localStorage when the POST request fails (creating new storage)', async () => {
+
+      request.mockReturnValueOnce(Promise.reject({ status: 404 } as FetchError));
+      request.mockReturnValueOnce(Promise.reject({ status: 403 } as FetchError));
+      const storage = usePluginUserStorage();
+      await storage.setItem('key', 'value');
+      expect(localStorage.setItem).toHaveBeenCalledWith('plugin-id:abc:key', 'value');
+    });
+
+    it('falls back to localStorage when the PATCH request fails (updating existing storage)', async () => {
+
+      request.mockReturnValueOnce(
+        Promise.resolve({
+          status: 200,
+          data: { metadata: { name: 'plugin-id:abc' }, spec: { data: { key: 'value' } } },
+        } as FetchResponse)
+      );
+      request.mockReturnValueOnce(Promise.reject({ status: 403 } as FetchError));
+      const storage = usePluginUserStorage();
+      await storage.setItem('key', 'new-value');
+      expect(localStorage.setItem).toHaveBeenCalledWith('plugin-id:abc:key', 'new-value');
+    });
+
+    it('does not show error alert when POST request is made (creating new storage)', async () => {
+      request.mockReturnValueOnce(Promise.reject({ status: 404 } as FetchError));
+      request.mockReturnValueOnce(
+        Promise.resolve({ status: 200, data: { spec: { data: { key: 'value' } } } } as FetchResponse)
+      );
+      const storage = usePluginUserStorage();
+      await storage.setItem('key', 'value');
+      const postCall = request.mock.calls.find((call) => call[0].method === 'POST');
+      expect(postCall).toBeDefined();
+      expect(postCall![0].showErrorAlert).toBe(false);
+    });
+
+    it('does not show error alert when PATCH request is made (updating existing storage)', async () => {
+      request.mockReturnValueOnce(
+        Promise.resolve({
+          status: 200,
+          data: { metadata: { name: 'plugin-id:abc' }, spec: { data: { key: 'value' } } },
+        } as FetchResponse)
+      );
+      request.mockReturnValueOnce(
+        Promise.resolve({ status: 200, data: { spec: { data: { key: 'new-value' } } } } as FetchResponse)
+      );
+      const storage = usePluginUserStorage();
+      await storage.setItem('key', 'new-value');
+      const patchCall = request.mock.calls.find((call) => call[0].method === 'PATCH');
+      expect(patchCall).toBeDefined();
+      expect(patchCall![0].showErrorAlert).toBe(false);
+    });
+  });
 });
