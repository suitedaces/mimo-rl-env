--- /dev/null
+++ b/posthog/tasks/test/test_calculate_cohort.py
@@ -0,0 +1,39 @@
+from unittest.mock import patch
+
+from dateutil.relativedelta import relativedelta
+from django.utils import timezone
+
+from posthog.models import Cohort
+from posthog.tasks.calculate_cohort import calculate_cohorts
+from posthog.test.base import BaseTest
+
+
+class TestCalculateCohort(BaseTest):
+    def _stale_cohort_with_failures(self, failures):
+        cohort = Cohort.objects.create(
+            team=self.team,
+            groups=[{"properties": {"$some_prop": "nomatchihope"}}],
+            name="cohort-%s" % failures,
+            last_calculation=timezone.now() - relativedelta(hours=2),
+        )
+        cohort.groups = [{"action_id": 999999999}]
+        cohort.save()
+        for _ in range(failures):
+            cohort.calculate_people()
+            cohort.refresh_from_db()
+        cohort.is_calculating = False
+        cohort.last_calculation = timezone.now() - relativedelta(hours=2)
+        cohort.save()
+        return cohort
+
+    def test_periodic_recalculation_skips_cohorts_after_three_failures(self):
+        no_failures = self._stale_cohort_with_failures(0)
+        two_failures = self._stale_cohort_with_failures(2)
+        three_failures = self._stale_cohort_with_failures(3)
+        four_failures = self._stale_cohort_with_failures(4)
+
+        with patch("posthog.tasks.calculate_cohort.calculate_cohort.delay") as delay:
+            calculate_cohorts()
+
+        enqueued_ids = {call.args[0] if call.args else call.kwargs["cohort_id"] for call in delay.call_args_list}
+        self.assertEqual(enqueued_ids, {no_failures.pk, two_failures.pk})
