+    def _cohort_response(self, cohort):
+        response = self.client.get("/api/cohort/%s/" % cohort.pk)
+        self.assertEqual(response.status_code, 200)
+        return response.json()
+
+    def _fail_cohort_calculation(self, cohort):
+        cohort.groups = [{"action_id": 999999999}]
+        cohort.save()
+        cohort.calculate_people()
+        cohort.refresh_from_db()
+        return cohort
+
+    def test_failed_calculation_clears_calculating_and_increments_error_count(self):
+        cohort = Cohort.objects.create(
+            team=self.team,
+            groups=[{"properties": {"$some_prop": "nomatchihope"}}],
+            name="cohort1",
+        )
+
+        cohort = self._fail_cohort_calculation(cohort)
+        cohort = self._fail_cohort_calculation(cohort)
+        self.assertEqual(self._cohort_response(cohort)["errors_calculating"], 2)
+
+        cohort.is_calculating = True
+        cohort.save()
+        cohort = self._fail_cohort_calculation(cohort)
+
+        self.assertFalse(cohort.is_calculating)
+        self.assertEqual(self._cohort_response(cohort)["errors_calculating"], 3)
+
+    def test_successful_calculation_clears_prior_error_count(self):
+        cohort = Cohort.objects.create(
+            team=self.team,
+            groups=[{"properties": {"$some_prop": "nomatchihope"}}],
+            name="cohort1",
+        )
+        cohort = self._fail_cohort_calculation(cohort)
+        cohort = self._fail_cohort_calculation(cohort)
+
+        cohort.groups = [{"properties": {"$some_prop": "nomatchihope"}}]
+        cohort.save()
+        cohort.calculate_people()
+        cohort.refresh_from_db()
+        self.assertEqual(self._cohort_response(cohort)["errors_calculating"], 0)
+        self.assertFalse(cohort.is_calculating)
+        self.assertIsNotNone(cohort.last_calculation)
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,33 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+pg_isready -q 2>/dev/null || pg_ctlcluster 16 main start 2>/dev/null
+
+
+redis-cli ping >/dev/null 2>&1 || redis-server --daemonize yes 2>/dev/null
+
+export DATABASE_URL="postgres://postgres:postgres@localhost:5432/posthog"
+export REDIS_URL="redis://localhost/"
+export TEST="true"
+export DJANGO_SETTINGS_MODULE="posthog.settings"
+
+case "${1:-}" in
+  base)
+    python3 -m pytest posthog/test/test_cohort_model.py -x -v \
+      -k "not test_failed_calculation_clears_calculating_and_increments_error_count and not test_successful_calculation_clears_prior_error_count" 2>&1
+    ;;
+  new)
+    python3 -m pytest \
+      posthog/api/test/test_cohort.py::TestCohort::test_cohort_api_includes_errors_calculating \
+      posthog/test/test_cohort_model.py::TestCohort::test_failed_calculation_clears_calculating_and_increments_error_count \
+      posthog/test/test_cohort_model.py::TestCohort::test_successful_calculation_clears_prior_error_count \
+      posthog/tasks/test/test_calculate_cohort.py::TestCalculateCohort::test_periodic_recalculation_skips_cohorts_after_three_failures \
+      -x -v 2>&1
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
