diff --git a/tests/test_pillow.py b/tests/test_pillow.py
index 90d56cc..0404d4f 100644
--- a/tests/test_pillow.py
+++ b/tests/test_pillow.py
@@ -705,3 +705,113 @@ def test_writable_output():
 
     frame = iio.imread(buffer, writeable_output=False, plugin="pillow")
     assert not frame.flags["WRITEABLE"]
+
+
+def test_gif_fps_v2_writer_no_typeerror(tmp_path):
+    """Issue reproduction: v2 get_writer with fps must not raise TypeError."""
+    import warnings as _warnings
+    import imageio as _imageio
+
+    path = tmp_path / "test_fps_v2.gif"
+    with _warnings.catch_warnings():
+        _warnings.simplefilter("ignore", DeprecationWarning)
+        writer = _imageio.get_writer(path, fps=20)
+        try:
+            for i in range(5):
+                writer.append_data(
+                    np.full((32, 32), i * 40, dtype=np.uint8)
+                )
+        finally:
+            writer.close()
+    assert path.exists()
+
+
+def test_gif_fps_v2_writer_emits_deprecation_warning(tmp_path):
+    """v2 get_writer with fps should emit a DeprecationWarning."""
+    import warnings as _warnings
+    import imageio as _imageio
+
+    path = tmp_path / "test_fps_v2_warn.gif"
+    with _warnings.catch_warnings(record=True) as caught:
+        _warnings.simplefilter("always")
+        writer = _imageio.get_writer(path, fps=20)
+        for i in range(5):
+            writer.append_data(np.full((32, 32), i * 40, dtype=np.uint8))
+        writer.close()
+
+    deprecations = [
+        rec
+        for rec in caught
+        if issubclass(rec.category, DeprecationWarning)
+        and "fps" in str(rec.message)
+    ]
+    assert len(deprecations) >= 1
+
+
+def test_gif_fps_v2_writer_sets_duration(tmp_path):
+    """fps=20 should result in GIF frame duration of 50ms (1000/fps)."""
+    import warnings as _warnings
+    import imageio as _imageio
+
+    path = tmp_path / "test_fps_v2_dur.gif"
+    with _warnings.catch_warnings():
+        _warnings.simplefilter("ignore", DeprecationWarning)
+        writer = _imageio.get_writer(path, fps=20)
+        for i in range(5):
+            writer.append_data(np.full((32, 32), i * 40, dtype=np.uint8))
+        writer.close()
+
+    img = Image.open(path)
+
+    assert img.info.get("duration") == 50
+
+
+def test_gif_fps_v3_imwrite_no_typeerror(tmp_path):
+    """v3 imwrite with fps must not raise TypeError."""
+    import warnings as _warnings
+
+    frames = np.array(
+        [np.full((32, 32), i * 40, dtype=np.uint8) for i in range(5)]
+    )
+    path = tmp_path / "test_fps_v3.gif"
+    with _warnings.catch_warnings():
+        _warnings.simplefilter("ignore", DeprecationWarning)
+        iio.imwrite(path, frames, fps=20, extension=".gif")
+    assert path.exists()
+
+
+def test_gif_fps_v3_imwrite_emits_deprecation_warning(tmp_path):
+    """v3 imwrite with fps should emit a DeprecationWarning."""
+    import warnings as _warnings
+
+    frames = np.array(
+        [np.full((32, 32), i * 40, dtype=np.uint8) for i in range(5)]
+    )
+    path = tmp_path / "test_fps_v3_warn.gif"
+    with _warnings.catch_warnings(record=True) as caught:
+        _warnings.simplefilter("always")
+        iio.imwrite(path, frames, fps=20, extension=".gif")
+
+    deprecations = [
+        rec
+        for rec in caught
+        if issubclass(rec.category, DeprecationWarning)
+        and "fps" in str(rec.message)
+    ]
+    assert len(deprecations) >= 1
+
+
+def test_gif_fps_v3_imwrite_sets_duration(tmp_path):
+    """v3 imwrite with fps=20 should yield GIF duration metadata of 50ms."""
+    import warnings as _warnings
+
+    frames = np.array(
+        [np.full((32, 32), i * 40, dtype=np.uint8) for i in range(5)]
+    )
+    path = tmp_path / "test_fps_v3_dur.gif"
+    with _warnings.catch_warnings():
+        _warnings.simplefilter("ignore", DeprecationWarning)
+        iio.imwrite(path, frames, fps=20, extension=".gif")
+
+    img = Image.open(path)
+    assert img.info.get("duration") == 50
