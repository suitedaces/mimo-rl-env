@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+REPO_PATH="$(go env GOPATH)/src/github.com/evergreen-ci/evergreen"
+
+if ! pgrep -x mongod >/dev/null 2>&1; then
+    mkdir -p /tmp/mongo-grade
+    mongod --dbpath /tmp/mongo-grade --port 27017 --nounixsocket --fork \
+        --logpath /tmp/mongo-grade/mongod.log >/dev/null 2>&1
+fi
+
+LDFLAGS='-X=github.com/evergreen-ci/evergreen/testutil.ExecutionEnvironmentType=test'
+
+
+( cd "$REPO_PATH" && EVGHOME="$REPO_PATH" GO111MODULE=off go test -ldflags="$LDFLAGS" -count=1 \
+    ./model/ \
+    -run 'TestAbortTask$|TestBuildRestart$|TestClearAndResetExecTask$|TestClearAndResetStrandedTask$|TestDisplayTaskDelayedRestart$|TestDisplayTaskRestart$|TestDisplayTaskUpdates$|TestFailedTaskRestart$|TestMarkEnd$|TestTryResetTask$|TestVersionRestart$' )
+
+
+( cd "$REPO_PATH" && EVGHOME="$REPO_PATH" GO111MODULE=off go test -ldflags="$LDFLAGS" -count=1 \
+    ./model/ \
+    -run 'TestSetResetWhenFinishedForTaskGroup$|TestMarkEndResetsSingleHostTaskGroup$|TestTryResetTaskResetsSingleHostTaskGroup$' )
