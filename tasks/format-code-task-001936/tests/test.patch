@@ -0,0 +1,42 @@
+import subprocess
+import sys
+import textwrap
+
+
+def test_replay_worker_does_not_block_process_exit():
+    script = textwrap.dedent(
+        """
+        import queue
+        import sys
+        import threading
+        import time
+
+        from mitmproxy import options
+        from mitmproxy.proxy.protocol import http_replay
+        from mitmproxy.test import tflow
+
+        def block_forever(self):
+            while True:
+                time.sleep(60)
+
+        http_replay.RequestReplayThread.run = block_forever
+
+        worker = http_replay.RequestReplayThread(
+            options.Options(),
+            tflow.tflow(),
+            queue.Queue(),
+            threading.Event(),
+        )
+        worker.start()
+        sys.exit(0)
+        """
+    )
+
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=3,
+    )
+
+    assert completed.returncode == 0, completed.stderr.decode("utf8", "replace")
