@@ -0,0 +1,120 @@
+from unittest import mock
+
+from mitmproxy.addons import clientplayback
+from mitmproxy.test import taddons
+from mitmproxy.test import tflow
+
+
+class ControlledThread:
+    def __init__(self):
+        self.alive = True
+
+    def is_alive(self):
+        return self.alive
+
+
+def _event_names(trigger_mock):
+    return [
+        call.args[0]
+        for call in trigger_mock.call_args_list
+        if call.args
+    ]
+
+
+def test_clientplayback_count_includes_active_replay():
+    cp = clientplayback.ClientPlayback()
+    first = ControlledThread()
+    second = ControlledThread()
+    flows = [tflow.tflow(), tflow.tflow()]
+
+    with taddons.context() as tctx:
+        tctx.master.addons.trigger = mock.Mock()
+        tctx.master.replay_request = mock.Mock(side_effect=[first, second])
+
+        cp.start_replay(flows)
+        cp.tick()
+        assert cp.count() == 2
+
+        first.alive = False
+        cp.tick()
+        assert cp.count() == 1
+
+        second.alive = False
+        cp.tick()
+        assert cp.count() == 0
+
+
+def test_clientplayback_update_on_replay_finish():
+    cp = clientplayback.ClientPlayback()
+    worker = ControlledThread()
+
+    with taddons.context() as tctx:
+        tctx.master.addons.trigger = mock.Mock()
+        tctx.master.replay_request = mock.Mock(return_value=worker)
+
+        cp.start_replay([tflow.tflow()])
+        cp.tick()
+        tctx.master.addons.trigger.reset_mock()
+
+        worker.alive = False
+        cp.tick()
+
+        assert "update" in _event_names(tctx.master.addons.trigger)
+
+
+def test_clientplayback_processing_complete_once_after_final_finish():
+    cp = clientplayback.ClientPlayback()
+    first = ControlledThread()
+    second = ControlledThread()
+
+    with taddons.context() as tctx:
+        tctx.master.addons.trigger = mock.Mock()
+        tctx.master.replay_request = mock.Mock(side_effect=[first, second])
+
+        cp.start_replay([tflow.tflow(), tflow.tflow()])
+        cp.tick()
+        tctx.master.addons.trigger.reset_mock()
+
+        first.alive = False
+        cp.tick()
+
+        tctx.master.addons.trigger.reset_mock()
+        second.alive = False
+        cp.tick()
+
+        completion_calls = [
+            call
+            for call in tctx.master.addons.trigger.call_args_list
+            if call.args and call.args[0] == "processing_complete"
+        ]
+        assert len(completion_calls) == 1
+
+        cp.tick()
+        cp.tick()
+        completion_calls = [
+            call
+            for call in tctx.master.addons.trigger.call_args_list
+            if call.args and call.args[0] == "processing_complete"
+        ]
+        assert len(completion_calls) == 1
+
+
+def test_start_replay_does_not_mutate_caller_sequence():
+    cp = clientplayback.ClientPlayback()
+    first = ControlledThread()
+    second = ControlledThread()
+    caller_flows = [tflow.tflow(), tflow.tflow()]
+    original_flows = list(caller_flows)
+
+    with taddons.context() as tctx:
+        tctx.master.addons.trigger = mock.Mock()
+        tctx.master.replay_request = mock.Mock(side_effect=[first, second])
+
+        cp.start_replay(caller_flows)
+        cp.tick()
+        first.alive = False
+        cp.tick()
+        second.alive = False
+        cp.tick()
+
+    assert caller_flows == original_flows
