@@ -0,0 +1,24 @@
+import copy
+
+from mitmproxy.test import tflow
+
+
+def test_flow_set_state_does_not_mutate_input():
+    flow = tflow.tflow()
+    state = flow.get_state()
+    expected = copy.deepcopy(state)
+
+    flow.set_state(state)
+
+    assert state == expected
+
+
+def test_http_request_set_state_does_not_mutate_input():
+    request = tflow.tflow().request
+    state = request.get_state()
+    state["extra_regression_sentinel"] = {"nested": ["value"]}
+    expected = copy.deepcopy(state)
+
+    request.set_state(state)
+
+    assert state == expected
