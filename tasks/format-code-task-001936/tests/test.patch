@@ -0,0 +1,50 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+run_pytest() {
+    python3 - "$@" <<'PY'
+import collections
+import collections.abc
+import sys
+
+for name in [
+    "MutableMapping",
+    "MutableSequence",
+    "MutableSet",
+    "Mapping",
+    "Sequence",
+    "Callable",
+    "Iterable",
+    "Iterator",
+    "ByteString",
+    "Set",
+    "Hashable",
+    "Sized",
+    "Container",
+]:
+    if not hasattr(collections, name):
+        setattr(collections, name, getattr(collections.abc, name))
+
+import pytest
+
+sys.exit(pytest.main(["-v"] + sys.argv[1:]))
+PY
+}
+
+case "${1:-}" in
+    base)
+        run_pytest \
+            test/mitmproxy/test_flow.py
+        ;;
+    new)
+        run_pytest \
+            test/mitmproxy/addons/test_clientplayback_replay_lifecycle.py \
+            test/mitmproxy/proxy/protocol/test_http_replay_shutdown.py \
+            test/mitmproxy/test_flow_state_immutability.py
+        ;;
+    *)
+        echo "usage: $0 base|new"
+        exit 2
+        ;;
+esac
