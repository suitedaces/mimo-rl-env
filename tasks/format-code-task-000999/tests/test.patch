+++ b/tests/codespec_apply_diff.py
@@ -0,0 +1,132 @@
+import importlib.util
+import pathlib
+import sys
+import types
+import unittest
+
+
+class _StringTrie:
+    pass
+
+
+_pygtrie = types.ModuleType("pygtrie")
+_pygtrie.StringTrie = _StringTrie
+try:
+    import pygtrie  # noqa: F401
+except ImportError:
+    sys.modules["pygtrie"] = _pygtrie
+
+
+_MODULE_PATH = pathlib.Path(__file__).parents[1] / "dvc" / "utils" / "collections.py"
+_SPEC = importlib.util.spec_from_file_location("codespec_collections", _MODULE_PATH)
+_MODULE = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(_MODULE)
+apply_diff = _MODULE.apply_diff
+
+
+def run_apply(src, dest):
+    try:
+        return apply_diff(src, dest)
+    except Exception as exc:
+        raise AssertionError(
+            "apply_diff must return a synchronized value, but raised "
+            f"{type(exc).__name__}: {exc}"
+        ) from exc
+
+
+class AttrDict(dict):
+    pass
+
+
+class AttrList(list):
+    pass
+
+
+class ApplyDiffContractTests(unittest.TestCase):
+    def test_mapping_sync_is_in_place_and_returns_destination(self):
+        nested = AttrDict({"keep": 2, "stale": 9})
+        dest = AttrDict({"nested": nested, "remove": True})
+        dest.marker = "preserve"
+        src = {"nested": {"keep": 2, "add": 3}}
+
+        result = run_apply(src, dest)
+
+        self.assertIs(result, dest)
+        self.assertIs(dest["nested"], nested)
+        self.assertEqual(dest, {"nested": {"keep": 2, "add": 3}})
+        self.assertEqual(dest.marker, "preserve")
+        self.assertEqual(src, {"nested": {"keep": 2, "add": 3}})
+
+    def test_mapping_and_sequence_kind_changes_are_replaced(self):
+        dest = {"mapping_to_list": {"old": 1}, "list_to_mapping": [1, 2]}
+        src = {"mapping_to_list": [1, 2, 3], "list_to_mapping": {"new": 4}}
+
+        result = run_apply(src, dest)
+
+        self.assertIs(result, dest)
+        self.assertEqual(dest, src)
+        self.assertIsInstance(dest["mapping_to_list"], list)
+        self.assertIsInstance(dest["list_to_mapping"], dict)
+
+    def test_list_sync_preserves_identity_metadata_and_handles_resize(self):
+        child = AttrDict({"value": 1})
+        dest = AttrList([child, "remove"])
+        dest.marker = 42
+        src = [{"value": 2}, "new", "another"]
+
+        result = run_apply(src, dest)
+
+        self.assertIs(result, dest)
+        self.assertIs(dest[0], child)
+        self.assertEqual(dest, src)
+        self.assertEqual(dest.marker, 42)
+        self.assertEqual(src, [{"value": 2}, "new", "another"])
+
+    def test_equal_values_keep_destination_scalar_subclasses(self):
+        class TaggedInt(int):
+            pass
+
+        tagged = TaggedInt(7)
+        dest = {"same": tagged, "changed": tagged}
+        src = {"same": 7, "changed": 8}
+
+        run_apply(src, dest)
+
+        self.assertIs(dest["same"], tagged)
+        self.assertEqual(dest["changed"], 8)
+        self.assertIs(type(dest["changed"]), int)
+
+    def test_tuple_roots_return_replacements(self):
+        src = (1, 2, 3)
+        dest = (1, 9)
+
+        result = run_apply(src, dest)
+
+        self.assertEqual(result, src)
+        self.assertIsInstance(result, tuple)
+        self.assertIsNot(result, dest)
+
+    def test_nested_immutable_sequences_are_installed_by_parent(self):
+        dest = {"values": (1, 2), "pair": ("old",)}
+        src = {"values": [1, 2, 3], "pair": ["new", "extra"]}
+
+        result = run_apply(src, dest)
+
+        self.assertIs(result, dest)
+        self.assertEqual(dest, src)
+        self.assertIsInstance(dest["values"], list)
+        self.assertIsInstance(dest["pair"], list)
+
+    def test_incompatible_root_returns_source_shape(self):
+        src = {"key": "value"}
+        dest = ["outdated"]
+
+        result = run_apply(src, dest)
+
+        self.assertEqual(result, src)
+        self.assertIsInstance(result, dict)
+        self.assertIsNot(result, dest)
+
+
+if __name__ == "__main__":
+    unittest.main()
