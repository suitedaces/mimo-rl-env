 """Test Home Assistant scenes."""
 from unittest.mock import patch
 
+import pytest
+import voluptuous as vol
+
+from homeassistant.const import ATTR_ENTITY_ID, STATE_OFF
 from homeassistant.setup import async_setup_component
 
+from tests.common import async_mock_service
+
 
 async def test_reload_config_service(hass):
     """Test the reload config service."""
@@ -28,3 +34,115 @@ async def test_reload_config_service(hass):
 
     assert hass.states.get("scene.hallo") is None
     assert hass.states.get("scene.bye") is not None
+
+
+async def test_apply_service(hass):
+    """Test the scene.apply service applies entity states from service data."""
+    assert await async_setup_component(hass, "scene", {})
+
+
+    assert hass.services.has_service("scene", "apply")
+
+    hass.states.async_set("light.bed_light", STATE_OFF)
+    hass.states.async_set("light.ceiling", STATE_OFF)
+
+    turn_on_calls = async_mock_service(hass, "light", "turn_on")
+
+    await hass.services.async_call(
+        "scene",
+        "apply",
+        {
+            "entities": {
+                "light.bed_light": "on",
+                "light.ceiling": {"state": "on", "brightness": 100},
+            }
+        },
+        blocking=True,
+    )
+
+
+    assert len(turn_on_calls) == 2
+
+    calls_by_entity = {}
+    for call in turn_on_calls:
+        entity_ids = call.data[ATTR_ENTITY_ID]
+        if isinstance(entity_ids, str):
+            entity_ids = [entity_ids]
+        for entity_id in entity_ids:
+            calls_by_entity[entity_id] = call
+
+    assert "light.bed_light" in calls_by_entity
+    assert "light.ceiling" in calls_by_entity
+
+    assert "brightness" not in calls_by_entity["light.bed_light"].data
+
+    assert calls_by_entity["light.ceiling"].data.get("brightness") == 100
+
+
+async def test_apply_service_yaml_bool(hass):
+    """Test the scene.apply service handles YAML boolean state values."""
+    assert await async_setup_component(hass, "scene", {})
+
+    hass.states.async_set("light.bed_light", STATE_OFF)
+
+    turn_on_calls = async_mock_service(hass, "light", "turn_on")
+
+
+    await hass.services.async_call(
+        "scene",
+        "apply",
+        {"entities": {"light.bed_light": True}},
+        blocking=True,
+    )
+
+    assert len(turn_on_calls) == 1
+    entity_ids = turn_on_calls[0].data[ATTR_ENTITY_ID]
+    if isinstance(entity_ids, str):
+        entity_ids = [entity_ids]
+    assert "light.bed_light" in entity_ids
+
+
+async def test_apply_service_missing_entities(hass):
+    """Test the scene.apply service rejects calls with no entities field."""
+    assert await async_setup_component(hass, "scene", {})
+
+    with pytest.raises(vol.Invalid):
+        await hass.services.async_call(
+            "scene",
+            "apply",
+            {},
+            blocking=True,
+        )
+
+
+async def test_apply_service_issue_example(hass):
+    """Test the exact example from the issue: light.kitchen: on / light.ceiling: state: on."""
+    assert await async_setup_component(hass, "scene", {})
+
+    hass.states.async_set("light.kitchen", STATE_OFF)
+    hass.states.async_set("light.ceiling", STATE_OFF)
+
+    turn_on_calls = async_mock_service(hass, "light", "turn_on")
+
+    await hass.services.async_call(
+        "scene",
+        "apply",
+        {
+            "entities": {
+                "light.kitchen": "on",
+                "light.ceiling": {"state": "on"},
+            }
+        },
+        blocking=True,
+    )
+
+    affected = set()
+    for call in turn_on_calls:
+        entity_ids = call.data[ATTR_ENTITY_ID]
+        if isinstance(entity_ids, str):
+            affected.add(entity_ids)
+        else:
+            affected.update(entity_ids)
+
+    assert "light.kitchen" in affected
+    assert "light.ceiling" in affected
