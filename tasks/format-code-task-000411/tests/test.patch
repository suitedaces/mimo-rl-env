             w = captured.pop()
             assert "your `conf.get*` call to use the new name" in str(w.message)
             assert w.category == FutureWarning
+
+
+class TestWebserverConfigPath:
+    """Tests for customizing the webserver_config.py location."""
+
+    def test_default_config_template_has_webserver_config_file_option(self):
+        """The default config template must expose [webserver] config_file option."""
+        from airflow.configuration import (
+            AirflowConfigParser,
+            _parameterized_config_from_template,
+        )
+
+        with mock.patch.dict("os.environ"):
+            os.environ.pop("AIRFLOW__WEBSERVER__CONFIG_FILE", None)
+            default_config = _parameterized_config_from_template("default_airflow.cfg")
+            parser = AirflowConfigParser(default_config=default_config)
+            value = parser.get("webserver", "config_file")
+        assert value.endswith("/webserver_config.py")
+
+    def test_webserver_config_overridden_via_env_var(self):
+        """Setting AIRFLOW__WEBSERVER__CONFIG_FILE updates WEBSERVER_CONFIG."""
+        from airflow import configuration as airflow_configuration
+
+        original_webserver_config = airflow_configuration.WEBSERVER_CONFIG
+        original_conf = airflow_configuration.conf
+        tmp_dir = tempfile.mkdtemp()
+        custom_path = os.path.join(tmp_dir, "my_custom_webserver_config.py")
+        try:
+            with mock.patch.dict(
+                "os.environ",
+                {"AIRFLOW__WEBSERVER__CONFIG_FILE": custom_path},
+            ):
+                airflow_configuration.initialize_config()
+                assert airflow_configuration.WEBSERVER_CONFIG == custom_path
+        finally:
+            airflow_configuration.WEBSERVER_CONFIG = original_webserver_config
+            airflow_configuration.conf = original_conf
+            import shutil as _shutil
+
+            _shutil.rmtree(tmp_dir, ignore_errors=True)
+
+    def test_webserver_config_default_path_uses_airflow_home(self):
+        """Default WEBSERVER_CONFIG resolves to {AIRFLOW_HOME}/webserver_config.py."""
+        from airflow import configuration as airflow_configuration
+
+        original_webserver_config = airflow_configuration.WEBSERVER_CONFIG
+        original_conf = airflow_configuration.conf
+        try:
+            with mock.patch.dict("os.environ"):
+                os.environ.pop("AIRFLOW__WEBSERVER__CONFIG_FILE", None)
+                airflow_configuration.initialize_config()
+                expected = os.path.join(
+                    airflow_configuration.AIRFLOW_HOME, "webserver_config.py"
+                )
+                assert airflow_configuration.WEBSERVER_CONFIG == expected
+        finally:
+            airflow_configuration.WEBSERVER_CONFIG = original_webserver_config
+            airflow_configuration.conf = original_conf
