@@ -0,0 +1,31 @@
+from django.test import TestCase
+
+from ipam.models import ASN, RIR
+from ipam.tables import ASNTable
+
+
+class ASNAsdotOrderingTest(TestCase):
+
+    @classmethod
+    def setUpTestData(cls):
+        rir = RIR.objects.create(name='Hidden RIR', slug='hidden-rir', is_private=True)
+
+        ASN.objects.create(asn=65546, rir=rir)
+        ASN.objects.create(asn=65537, rir=rir)
+        ASN.objects.create(asn=65538, rir=rir)
+
+    def _ordered_asns(self, order_by):
+        table = ASNTable(ASN.objects.all(), order_by=order_by)
+        return [row.record.asn for row in table.rows]
+
+    def test_asdot_column_sorts_by_numeric_asn_ascending(self):
+        self.assertEqual(
+            self._ordered_asns('asn_asdot'),
+            [65537, 65538, 65546]
+        )
+
+    def test_asdot_column_sorts_by_numeric_asn_descending(self):
+        self.assertEqual(
+            self._ordered_asns('-asn_asdot'),
+            [65546, 65538, 65537]
+        )
