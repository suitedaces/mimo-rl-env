@@ -0,0 +1,45 @@
+from django.core.exceptions import ValidationError
+from django.test import TestCase
+
+from core.choices import ManagedFileRootPathChoices
+from core.models import ManagedFile
+
+
+class ManagedFilePathUniquenessTest(TestCase):
+
+    def _managed_file(self, file_root, file_path):
+        return ManagedFile(
+            file_root=file_root,
+            file_path=file_path,
+        )
+
+    def test_duplicate_managed_file_same_root_and_path_is_invalid(self):
+        first = self._managed_file(ManagedFileRootPathChoices.SCRIPTS, 'hidden-unique-a.txt')
+        first.full_clean()
+        first.save()
+
+        duplicate = self._managed_file(ManagedFileRootPathChoices.SCRIPTS, 'hidden-unique-a.txt')
+
+        with self.assertRaises(ValidationError):
+            duplicate.full_clean()
+
+    def test_same_path_under_different_roots_is_allowed(self):
+        first = self._managed_file(ManagedFileRootPathChoices.SCRIPTS, 'hidden-unique-b.txt')
+        first.full_clean()
+        first.save()
+
+        second = self._managed_file(ManagedFileRootPathChoices.REPORTS, 'hidden-unique-b.txt')
+        second.full_clean()
+        second.save()
+
+        self.assertEqual(
+            ManagedFile.objects.filter(file_path='hidden-unique-b.txt').count(),
+            2
+        )
+
+    def test_existing_managed_file_can_be_cleaned_without_self_duplicate(self):
+        managed_file = self._managed_file(ManagedFileRootPathChoices.SCRIPTS, 'hidden-unique-c.txt')
+        managed_file.full_clean()
+        managed_file.save()
+
+        managed_file.full_clean()
