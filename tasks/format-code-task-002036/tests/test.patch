@@ -0,0 +1,41 @@
+from datetime import datetime
+from unittest.mock import patch
+
+from django.contrib.auth import get_user_model
+from django.contrib.contenttypes.models import ContentType
+from django.test import TestCase
+
+from core.models import Job
+from extras.constants import EVENT_JOB_END
+from extras.models import Webhook
+
+
+class JobWebhookTimestampFormatTest(TestCase):
+
+    @patch('core.models.jobs.django_rq.get_queue')
+    def test_job_triggered_webhook_payload_timestamp_uses_iso_separator(self, mock_get_queue):
+        user = get_user_model().objects.create_user(username='webhook-format-user')
+        object_type = ContentType.objects.get_for_model(get_user_model())
+        webhook = Webhook.objects.create(
+            name='Job timestamp format webhook',
+            payload_url='http://example.com/webhook/',
+            type_job_end=True,
+        )
+        webhook.content_types.set([object_type])
+        job = Job(
+            object_type=object_type,
+            object_id=user.pk,
+            name='hidden.webhook.timestamp.Check',
+            data={'result': 'ok'},
+            user=user,
+        )
+
+        job.trigger_webhooks(EVENT_JOB_END)
+
+        enqueue = mock_get_queue.return_value.enqueue
+        self.assertGreaterEqual(enqueue.call_count, 1)
+        timestamp = enqueue.call_args.kwargs['timestamp']
+
+        self.assertIsInstance(timestamp, str)
+        self.assertIn('T', timestamp)
+        datetime.fromisoformat(timestamp)
diff --git a/netbox/core/tests/test_managed_file_path_uniqueness.py b/netbox/core/tests/test_managed_file_path_uniqueness.py
