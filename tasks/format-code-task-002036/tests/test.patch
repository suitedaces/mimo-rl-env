@@ -0,0 +1,43 @@
+from datetime import datetime
+from unittest.mock import patch
+
+from django.contrib.contenttypes.models import ContentType
+from django.test import TestCase
+
+from extras.choices import ObjectChangeActionChoices
+from extras.models import Webhook
+from extras.webhooks import flush_webhooks
+from users.models import User
+
+
+class WebhookTimestampFormatTest(TestCase):
+
+    @patch('extras.webhooks.get_queue')
+    def test_flushed_webhook_payload_timestamp_uses_iso_separator(self, mock_get_queue):
+        content_type = ContentType.objects.get_for_model(User)
+        webhook = Webhook.objects.create(
+            name='Timestamp format webhook',
+            payload_url='http://example.com/webhook/',
+            type_update=True,
+        )
+        webhook.content_types.set([content_type])
+        queue = [
+            {
+                'content_type': content_type,
+                'event': ObjectChangeActionChoices.ACTION_UPDATE,
+                'data': {'name': 'device-a'},
+                'snapshots': {'prechange': None, 'postchange': None},
+                'username': 'alice',
+                'request_id': 'hidden-request-1',
+            }
+        ]
+
+        flush_webhooks(queue)
+
+        enqueue = mock_get_queue.return_value.enqueue
+        self.assertEqual(enqueue.call_count, 1)
+        timestamp = enqueue.call_args.kwargs['timestamp']
+
+        self.assertIsInstance(timestamp, str)
+        self.assertIn('T', timestamp)
+        datetime.fromisoformat(timestamp)
