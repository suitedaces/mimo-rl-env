@@ -0,0 +1,54 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+if [ ! -x /testbed/.venv/bin/python ]; then
+    python3 -m venv /testbed/.venv
+fi
+
+
+set +u
+source /testbed/.venv/bin/activate
+set -u
+
+REQ_HASH=$(sha256sum /testbed/requirements.txt | awk '{print $1}')
+REQ_MARKER=/testbed/.venv/.stage3_requirements_${REQ_HASH}
+if [ ! -f "$REQ_MARKER" ]; then
+    python -m pip install -q --upgrade pip setuptools wheel
+    python -m pip install -q -r /testbed/requirements.txt
+    touch "$REQ_MARKER"
+fi
+
+
+service postgresql start 2>/dev/null || true
+service redis-server start 2>/dev/null || true
+
+
+if [ ! -f /testbed/netbox/netbox/configuration.py ]; then
+    cp /testbed/netbox/netbox/configuration_testing.py /testbed/netbox/netbox/configuration.py
+fi
+
+cd /testbed/netbox
+
+case "${1:-}" in
+  base)
+    python manage.py test \
+      extras.tests.test_webhooks \
+      core.tests.test_api \
+      ipam.tests.test_ordering \
+      --verbosity=2 --keepdb
+    ;;
+  new)
+    python manage.py test \
+      extras.tests.test_webhook_timestamp_format \
+      core.tests.test_job_webhook_timestamp_format \
+      core.tests.test_managed_file_path_uniqueness \
+      ipam.tests.test_asn_asdot_ordering \
+      --verbosity=2 --keepdb
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
