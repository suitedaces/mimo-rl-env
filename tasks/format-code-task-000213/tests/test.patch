--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,38 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export PATH="$HOME/.pyenv/bin:$PATH"
+set +u
+eval "$(pyenv init -)"
+pyenv global 3.8.20
+set -u
+
+
+pip install -e . --no-deps -q
+
+case "${1:-}" in
+  base)
+    python -m pytest \
+      tests/client/test_client.py::test_client_initializes_from_config \
+      tests/client/test_client.py::test_get_flow_run_info_raises_informative_error \
+      tests/engine/cloud/test_cloud_flow_runner.py::test_task_runner_cls_is_cloud_task_runner \
+      tests/engine/cloud/test_cloud_flows.py::test_scheduled_start_time_is_in_context \
+      -v
+    ;;
+  new)
+    python -m pytest \
+      tests/client/test_client.py::test_get_flow_run_info \
+      tests/client/test_client.py::test_flow_run_info_returns_dynamic_context_field \
+      tests/engine/cloud/test_cloud_flow_runner.py::test_flow_runner_loads_context_from_cloud \
+      tests/engine/cloud/test_cloud_flow_runner.py::test_flow_runner_prefers_runtime_metadata_over_cloud_context \
+      tests/engine/cloud/test_cloud_flow_runner.py::test_cloud_run_context_accepts_unexpected_keys_and_versions \
+      tests/engine/cloud/test_cloud_flow_runner.py::test_cloud_runtime_metadata_wins_for_arbitrary_conflicts \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
