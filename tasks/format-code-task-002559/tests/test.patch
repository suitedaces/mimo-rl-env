+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+service postgresql start
+
+for _ in $(seq 1 30); do
+    if su postgres -c "psql -tAc 'SELECT 1'" >/dev/null 2>&1; then
+        break
+    fi
+    sleep 1
+done
+
+PYTEST_ARGS="-p no:cacheprovider -o addopts=--ds=saleor.tests.settings"
+
+
+python -m pytest saleor/checkout/tests/test_cart.py $PYTEST_ARGS -q
+
+
+python -m pytest saleor/checkout/tests/test_tasks.py $PYTEST_ARGS -q
