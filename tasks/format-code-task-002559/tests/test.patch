@@ -0,0 +1,189 @@
+from datetime import timedelta
+
+from django.conf import settings
+from django.utils import timezone
+
+from ..models import Checkout, CheckoutLine
+from ..tasks import delete_expired_checkouts
+
+
+def _make_checkout(channel, *, email="", user=None):
+    return Checkout.objects.create(
+        currency=channel.currency_code,
+        channel=channel,
+        email=email,
+        user=user,
+    )
+
+
+def _add_line(checkout, variant):
+    CheckoutLine.objects.create(checkout=checkout, variant=variant, quantity=1)
+
+
+def _age(checkout, delta):
+
+    Checkout.objects.filter(pk=checkout.pk).update(
+        last_change=timezone.now() - delta
+    )
+
+
+def _exists(checkout):
+    return Checkout.objects.filter(pk=checkout.pk).exists()
+
+
+def test_delete_expired_checkouts_removes_stale_empty_checkout(channel_USD):
+    checkout = _make_checkout(channel_USD)
+    _age(checkout, timedelta(hours=12))
+
+    delete_expired_checkouts()
+
+    assert not _exists(checkout)
+
+
+def test_delete_expired_checkouts_keeps_recent_empty_checkout(channel_USD):
+    checkout = _make_checkout(channel_USD)
+    _age(checkout, timedelta(hours=2))
+
+    delete_expired_checkouts()
+
+    assert _exists(checkout)
+
+
+def test_delete_expired_checkouts_removes_stale_empty_checkout_with_email(channel_USD):
+
+
+    checkout = _make_checkout(channel_USD, email="customer@example.com")
+    _age(checkout, timedelta(hours=12))
+
+    delete_expired_checkouts()
+
+    assert not _exists(checkout)
+
+
+def test_delete_expired_checkouts_removes_stale_anonymous_checkout_with_lines(
+    channel_USD, variant
+):
+    checkout = _make_checkout(channel_USD)
+    _add_line(checkout, variant)
+    _age(checkout, timedelta(days=45))
+
+    delete_expired_checkouts()
+
+    assert not _exists(checkout)
+
+
+def test_delete_expired_checkouts_keeps_recent_anonymous_checkout_with_lines(
+    channel_USD, variant
+):
+    checkout = _make_checkout(channel_USD)
+    _add_line(checkout, variant)
+    _age(checkout, timedelta(days=10))
+
+    delete_expired_checkouts()
+
+    assert _exists(checkout)
+
+
+def test_delete_expired_checkouts_keeps_checkout_with_email_within_user_window(
+    channel_USD, variant
+):
+
+    checkout = _make_checkout(channel_USD, email="customer@example.com")
+    _add_line(checkout, variant)
+    _age(checkout, timedelta(days=45))
+
+    delete_expired_checkouts()
+
+    assert _exists(checkout)
+
+
+def test_delete_expired_checkouts_keeps_checkout_with_user_within_user_window(
+    channel_USD, variant, customer_user
+):
+    checkout = _make_checkout(channel_USD, user=customer_user)
+    _add_line(checkout, variant)
+    _age(checkout, timedelta(days=45))
+
+    delete_expired_checkouts()
+
+    assert _exists(checkout)
+
+
+def test_delete_expired_checkouts_removes_stale_checkout_with_email(
+    channel_USD, variant
+):
+    checkout = _make_checkout(channel_USD, email="customer@example.com")
+    _add_line(checkout, variant)
+    _age(checkout, timedelta(days=120))
+
+    delete_expired_checkouts()
+
+    assert not _exists(checkout)
+
+
+def test_delete_expired_checkouts_removes_stale_checkout_with_user(
+    channel_USD, variant, customer_user
+):
+    checkout = _make_checkout(channel_USD, user=customer_user)
+    _add_line(checkout, variant)
+    _age(checkout, timedelta(days=120))
+
+    delete_expired_checkouts()
+
+    assert not _exists(checkout)
+
+
+def test_delete_expired_checkouts_keeps_fresh_checkouts_and_does_not_error(
+    channel_USD, variant
+):
+    fresh_empty = _make_checkout(channel_USD)
+    fresh_with_lines = _make_checkout(channel_USD, email="customer@example.com")
+    _add_line(fresh_with_lines, variant)
+
+
+    delete_expired_checkouts()
+
+    assert _exists(fresh_empty)
+    assert _exists(fresh_with_lines)
+
+
+def test_delete_expired_checkouts_mixed_population(channel_USD, variant, customer_user):
+
+    stale_empty = _make_checkout(channel_USD)
+    _age(stale_empty, timedelta(hours=12))
+
+    stale_anonymous = _make_checkout(channel_USD)
+    _add_line(stale_anonymous, variant)
+    _age(stale_anonymous, timedelta(days=45))
+
+    stale_user = _make_checkout(channel_USD, email="customer@example.com")
+    _add_line(stale_user, variant)
+    _age(stale_user, timedelta(days=120))
+
+
+    fresh_empty = _make_checkout(channel_USD)
+    _age(fresh_empty, timedelta(hours=2))
+
+    recent_anonymous = _make_checkout(channel_USD)
+    _add_line(recent_anonymous, variant)
+    _age(recent_anonymous, timedelta(days=10))
+
+    mid_user = _make_checkout(channel_USD, user=customer_user)
+    _add_line(mid_user, variant)
+    _age(mid_user, timedelta(days=45))
+
+    delete_expired_checkouts()
+
+    survivors = set(Checkout.objects.values_list("pk", flat=True))
+    assert survivors == {fresh_empty.pk, recent_anonymous.pk, mid_user.pk}
+
+
+def test_delete_expired_checkouts_is_scheduled_periodically():
+    schedule = settings.CELERY_BEAT_SCHEDULE
+    entries = [
+        entry
+        for entry in schedule.values()
+        if entry.get("task") == "saleor.checkout.tasks.delete_expired_checkouts"
+    ]
+    assert len(entries) == 1
+    assert entries[0]["schedule"] == timedelta(days=1)
