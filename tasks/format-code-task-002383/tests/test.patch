diff --git a/tests/test_python_lexer.py b/tests/test_python_lexer.py
new file mode 100644
index 00000000..94e177c6
--- /dev/null
+++ b/tests/test_python_lexer.py
@@ -0,0 +1,119 @@
+
+
+
+
+
+
+
+
+
+
+
+
+
+import pytest
+
+from pygments.lexers.python import PythonTracebackLexer, Python2TracebackLexer
+from pygments.token import Operator, Generic
+
+
+@pytest.fixture(scope='module')
+def lexer3():
+    yield PythonTracebackLexer()
+
+
+@pytest.fixture(scope='module')
+def lexer2():
+    yield Python2TracebackLexer()
+
+
+PEP657_TRACEBACK = (
+    'Traceback (most recent call last):\n'
+    '  File "test.py", line 2, in <module>\n'
+    "    x['a']['b']['c']['d'] = 1\n"
+    '    ^^^^^^^^^^^^^^^^\n'
+    "TypeError: 'NoneType' object is not subscriptable\n"
+)
+
+SYNTAXERROR_TRACEBACK_PY3 = (
+    '  File "test.py", line 1\n'
+    '    foo bar\n'
+    '        ^\n'
+    'SyntaxError: invalid syntax\n'
+)
+
+SYNTAXERROR_TRACEBACK_PY2 = (
+    '  File "test.py", line 1\n'
+    '    foo bar\n'
+    '        ^\n'
+    'SyntaxError: invalid syntax\n'
+)
+
+NO_MARKER_TRACEBACK = (
+    'Traceback (most recent call last):\n'
+    '  File "test.py", line 2, in <module>\n'
+    '    1 / 0\n'
+    'ZeroDivisionError: division by zero\n'
+)
+
+
+def _tokens(lexer, text):
+    return list(lexer.get_tokens(text))
+
+
+def test_pythontb_pep657_caret_not_operator(lexer3):
+
+    tokens = _tokens(lexer3, PEP657_TRACEBACK)
+    for tok, val in tokens:
+        if '^' in val:
+            assert tok is not Operator, (
+                "caret %r unexpectedly tokenized as Operator" % val
+            )
+
+
+def test_pythontb_pep657_marker_present(lexer3):
+
+
+    tokens = _tokens(lexer3, PEP657_TRACEBACK)
+    carets_seen = ''.join(val for _t, val in tokens if set(val) <= {'^', ' ', '\n'} and '^' in val)
+    assert '^^^^^^^^^^^^^^^^' in carets_seen, (
+        "expected the full ^^^^^^^^^^^^^^^^ marker text in the token stream"
+    )
+
+
+def test_pythontb_preserves_code_line(lexer3):
+
+    tokens = _tokens(lexer3, PEP657_TRACEBACK)
+    values = [v for _t, v in tokens]
+    assert any(v == "'a'" or v == 'a' for v in values), (
+        "expected the indexed string literal pieces to still be tokenized"
+    )
+
+
+def test_pythontb_no_marker_line_unchanged(lexer3):
+
+    tokens = _tokens(lexer3, NO_MARKER_TRACEBACK)
+
+    found_error = any(tok is Generic.Error and val == 'ZeroDivisionError'
+                      for tok, val in tokens)
+    assert found_error, "expected ZeroDivisionError to be Generic.Error"
+
+
+def test_pythontb_syntaxerror_single_caret_not_operator(lexer3):
+
+    tokens = _tokens(lexer3, SYNTAXERROR_TRACEBACK_PY3)
+    for tok, val in tokens:
+        if val.strip() == '^':
+            assert tok is not Operator, (
+                "single caret unexpectedly tokenized as Operator"
+            )
+
+
+def test_python2tb_syntaxerror_caret_not_operator(lexer2):
+
+    tokens = _tokens(lexer2, SYNTAXERROR_TRACEBACK_PY2)
+    for tok, val in tokens:
+        if '^' in val:
+            assert tok is not Operator, (
+                "py2 caret %r unexpectedly tokenized as Operator" % val
+            )
