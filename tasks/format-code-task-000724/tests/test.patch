+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 ./rest/adminapitest/ -run 'TestPersistentConfigConcurrency'
+    ;;
+  new)
+    go test -v -count=1 ./rest/adminapitest/ -run 'TestDatabaseConfigAuditAPI'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
