+export DESECSTACK_API_ADMIN="admin@desec.io"
+export DESECSTACK_NSLORD_APIKEY="test"
+export DESECSTACK_API_SEPA_CREDITOR_ID="test"
+export DESECSTACK_NORECAPTCHA_SITE_KEY="test"
+export DESECSTACK_NORECAPTCHA_SECRET_KEY="test"
