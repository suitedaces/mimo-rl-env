+package v2alpha1
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"sigs.k8s.io/yaml"
+)
+
+func TestDatadogAgentOverrideUpdateStrategyIsExposedInCRDSchema(t *testing.T) {
+
+	crdPath := filepath.Join("..", "..", "..", "config", "crd", "bases", "v1", "datadoghq.com_datadogagents.yaml")
+	raw, err := os.ReadFile(crdPath)
+	require.NoError(t, err)
+
+	var crd map[string]interface{}
+	require.NoError(t, yaml.Unmarshal(raw, &crd))
+
+	var updateStrategySchema map[string]interface{}
+	for _, candidate := range findObjectProperties(crd, "updateStrategy") {
+		candidateProperties := properties(candidate)
+		rollingUpdate, hasRollingUpdate := candidateProperties["rollingUpdate"]
+		rollingProperties := properties(rollingUpdate)
+		if _, hasType := candidateProperties["type"]; hasType && hasRollingUpdate && rollingProperties["maxUnavailable"] != nil && rollingProperties["maxSurge"] != nil {
+			updateStrategySchema = candidate
+			break
+		}
+	}
+	require.NotNil(t, updateStrategySchema, "component override schema should expose updateStrategy with rollingUpdate limits")
+
+	strategyType, ok := properties(updateStrategySchema)["type"]
+	require.True(t, ok, "updateStrategy should expose a strategy type")
+	assert.Equal(t, "string", fieldString(strategyType, "type"))
+
+	rollingUpdate, ok := properties(updateStrategySchema)["rollingUpdate"]
+	require.True(t, ok, "updateStrategy should expose rollingUpdate limits")
+
+	rollingProperties := properties(rollingUpdate)
+	assertIntOrStringSchema(t, rollingProperties["maxUnavailable"], "maxUnavailable")
+	assertIntOrStringSchema(t, rollingProperties["maxSurge"], "maxSurge")
+}
+
+func findObjectProperties(node interface{}, property string) []map[string]interface{} {
+	switch value := node.(type) {
+	case map[string]interface{}:
+		var matches []map[string]interface{}
+		if props := properties(value); props != nil {
+			if found, ok := props[property].(map[string]interface{}); ok {
+				matches = append(matches, found)
+			}
+		}
+		for _, child := range value {
+			matches = append(matches, findObjectProperties(child, property)...)
+		}
+		return matches
+	case []interface{}:
+		var matches []map[string]interface{}
+		for _, child := range value {
+			matches = append(matches, findObjectProperties(child, property)...)
+		}
+		return matches
+	default:
+		return nil
+	}
+}
+
+func properties(schema interface{}) map[string]interface{} {
+	value, ok := schema.(map[string]interface{})
+	if !ok {
+		return nil
+	}
+	props, ok := value["properties"].(map[string]interface{})
+	if !ok {
+		return nil
+	}
+	return props
+}
+
+func assertIntOrStringSchema(t *testing.T, schema interface{}, field string) {
+	t.Helper()
+
+	value := requireMap(t, schema, field)
+
+	assert.Equal(t, true, value["x-kubernetes-int-or-string"], "%s should preserve Kubernetes IntOrString schema semantics", field)
+
+	branches, ok := value["anyOf"].([]interface{})
+	require.True(t, ok, "%s should allow integer and string branches", field)
+
+	seen := map[string]bool{}
+	for _, branch := range branches {
+		seen[fieldString(branch, "type")] = true
+	}
+	assert.True(t, seen["integer"], "%s should allow integer values", field)
+	assert.True(t, seen["string"], "%s should allow string values", field)
+}
+
+func requireMap(t *testing.T, value interface{}, name string) map[string]interface{} {
+	t.Helper()
+
+	result, ok := value.(map[string]interface{})
+	require.True(t, ok, "%s should be an object schema", name)
+	return result
+}
+
+func fieldString(value interface{}, field string) string {
+	object, ok := value.(map[string]interface{})
+	if !ok {
+		return ""
+	}
+	text, _ := object[field].(string)
+	return text
+}
