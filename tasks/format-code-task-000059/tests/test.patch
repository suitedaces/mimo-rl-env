+package override
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/DataDog/datadog-operator/apis/datadoghq/v2alpha1"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	appsv1 "k8s.io/api/apps/v1"
+	"k8s.io/apimachinery/pkg/util/intstr"
+)
+
+func TestDaemonSetAppliesUpdateStrategyFromJSONOverride(t *testing.T) {
+	tests := []struct {
+		name                string
+		overrideJSON        string
+		expectedType        appsv1.DaemonSetUpdateStrategyType
+		expectedUnavailable *intstr.IntOrString
+		expectedSurge       *intstr.IntOrString
+	}{
+		{
+			name: "rolling update keeps percentage limits",
+			overrideJSON: `{
+				"updateStrategy": {
+					"type": "RollingUpdate",
+					"rollingUpdate": {
+						"maxUnavailable": "30%",
+						"maxSurge": "20%"
+					}
+				}
+			}`,
+			expectedType:        appsv1.RollingUpdateDaemonSetStrategyType,
+			expectedUnavailable: intOrStringPtr(intstr.FromString("30%")),
+			expectedSurge:       intOrStringPtr(intstr.FromString("20%")),
+		},
+		{
+			name: "rolling update keeps numeric limits",
+			overrideJSON: `{
+				"updateStrategy": {
+					"type": "RollingUpdate",
+					"rollingUpdate": {
+						"maxUnavailable": 3,
+						"maxSurge": 2
+					}
+				}
+			}`,
+			expectedType:        appsv1.RollingUpdateDaemonSetStrategyType,
+			expectedUnavailable: intOrStringPtr(intstr.FromInt(3)),
+			expectedSurge:       intOrStringPtr(intstr.FromInt(2)),
+		},
+		{
+			name: "non rolling strategy keeps the requested type",
+			overrideJSON: `{
+				"updateStrategy": {
+					"type": "OnDelete"
+				}
+			}`,
+			expectedType: appsv1.OnDeleteDaemonSetStrategyType,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			daemonSet := appsv1.DaemonSet{}
+			override := componentOverrideFromJSON(t, tt.overrideJSON)
+
+			DaemonSet(&daemonSet, &override)
+
+			assert.Equal(t, tt.expectedType, daemonSet.Spec.UpdateStrategy.Type)
+			if tt.expectedUnavailable != nil || tt.expectedSurge != nil {
+				require.NotNil(t, daemonSet.Spec.UpdateStrategy.RollingUpdate)
+			}
+			if tt.expectedUnavailable != nil {
+				require.NotNil(t, daemonSet.Spec.UpdateStrategy.RollingUpdate.MaxUnavailable)
+				assert.Equal(t, *tt.expectedUnavailable, *daemonSet.Spec.UpdateStrategy.RollingUpdate.MaxUnavailable)
+			}
+			if tt.expectedSurge != nil {
+				require.NotNil(t, daemonSet.Spec.UpdateStrategy.RollingUpdate.MaxSurge)
+				assert.Equal(t, *tt.expectedSurge, *daemonSet.Spec.UpdateStrategy.RollingUpdate.MaxSurge)
+			}
+		})
+	}
+}
+
+func componentOverrideFromJSON(t *testing.T, payload string) v2alpha1.DatadogAgentComponentOverride {
+	t.Helper()
+
+	var override v2alpha1.DatadogAgentComponentOverride
+	require.NoError(t, json.Unmarshal([]byte(payload), &override))
+	return override
+}
+
+func intOrStringPtr(value intstr.IntOrString) *intstr.IntOrString {
+	return &value
+}
