+import { expect, it, vi } from 'vitest';
+import axios from 'axios';
+import { getTransactions as getZkSyncTransactions } from '../src/blockchains/zksync/transaction.ts';
+
+vi.mock('axios', () => ({
+  default: {
+    get: vi.fn(),
+  },
+}));
+
+it('returns the pinned zkSync transaction in a fresh process', async () => {
+  vi.mocked(axios.get).mockResolvedValueOnce({
+    status: 200,
+    data: {
+      status: '1',
+      result: [
+        {
+          blockNumber: 101,
+          timeStamp: 1700000001,
+          hash: '0xzkA',
+          from: '0xabc',
+          to: '0x111',
+          value: 7,
+          gas: 21000,
+          gasPrice: 11,
+          gasUsed: 21000,
+          input: '0x',
+          contractAddress: '',
+          transfers: [{ tokenSymbol: 'ETH', transferPrice: 12.5 }],
+        },
+      ],
+    },
+  });
+
+  await expect(getZkSyncTransactions('0xabc')).resolves.toEqual([
+    {
+      blockNumber: 101,
+      timeStamp: 1700000001,
+      hash: '0xzkA',
+      from: '0xabc',
+      to: '0x111',
+      value: 7,
+      gas: 21000,
+      gasPrice: 11,
+      gasUsed: 21000,
+      input: '0x',
+      contractAddress: '',
+      transfers: [{ tokenSymbol: 'ETH', transferPrice: 12.5 }],
+    },
+  ]);
+});
diff --git a/usercase-test-coderl/transactions.test.ts b/usercase-test-coderl/transactions.test.ts
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/transactions.test.ts
@@ -0,0 +1,437 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import axios from 'axios';
+import { getTransactions as getScrollTransactions } from '../src/blockchains/scroll/transaction.ts';
+import { getTransactions as getZkSyncTransactions } from '../src/blockchains/zksync/transaction.ts';
+
+vi.mock('axios', () => ({
+  default: {
+    get: vi.fn(),
+  },
+}));
+
+const mockedAxiosGet = vi.mocked(axios.get);
+
+const zksyncUrl = 'https://block-explorer-api.mainnet.zksync.io/api';
+const scrollUrl = 'https://api.scrollscan.com/api';
+
+const txA = {
+  blockNumber: 101,
+  timeStamp: 1700000001,
+  hash: '0xzkA',
+  from: '0xabc',
+  to: '0x111',
+  value: 7,
+  gas: 21000,
+  gasPrice: 11,
+  gasUsed: 21000,
+  input: '0x',
+  contractAddress: '',
+  transfers: [{ tokenSymbol: 'ETH', transferPrice: 12.5 }],
+};
+
+const txB = {
+  blockNumber: 5252,
+  timeStamp: 1700000525,
+  hash: '0xzkB',
+  from: '0x222',
+  to: '0xabc',
+  value: 19,
+  gas: 44000,
+  gasPrice: 13,
+  gasUsed: 33000,
+  input: '0x1234',
+  contractAddress: '0xcontractB',
+  transfers: [],
+};
+
+const normalTx = {
+  blockNumber: 700,
+  timeStamp: 1700000700,
+  hash: '0xscrollNormal',
+  nonce: 9,
+  blockHash: '0xblockNormal',
+  transactionIndex: 4,
+  from: '0xdef',
+  to: '0x999',
+  value: 123,
+  gas: 50000,
+  gasPrice: 22,
+  isError: 0,
+  txreceipt_status: 1,
+  input: '0xabcd',
+  contractAddress: '',
+  cumulativeGasUsed: 60000,
+  gasUsed: 49000,
+  confirmations: 88,
+  methodId: '0xabcd1234',
+  functionName: 'swap()',
+  transfers: [{ tokenSymbol: 'ETH', transferPrice: 42 }],
+};
+
+const internalDifferentHash = {
+  blockNumber: 710,
+  timeStamp: 1700000710,
+  hash: '0xscrollInternalOnly',
+  from: '0xbridge',
+  to: '0xdef',
+  value: 321,
+  gas: 81000,
+  gasUsed: 80000,
+  input: '0xfeed',
+  contractAddress: '0xinternalContract',
+  isError: 0,
+};
+
+const zksyncInitialParams = (address: string, startblock = 0) => ({
+  params: {
+    module: 'account',
+    action: 'txlist',
+    address,
+    startblock,
+    endblock: 99999999999999,
+    sort: 'asc',
+    offset: 1000,
+  },
+});
+
+const scrollParams = (action: 'txlist' | 'txlistinternal', address: string, startblock = 0) => ({
+  params: {
+    module: 'account',
+    action,
+    address,
+    startblock,
+    endblock: 99999999999999,
+    sort: 'asc',
+    offset: 1000,
+  },
+});
+
+const okPage = (result: unknown[]) => ({
+  status: 200,
+  data: {
+    status: '1',
+    result,
+  },
+});
+
+const statusZeroPage = (message: string) => ({
+  status: 200,
+  data: {
+    status: '0',
+    message,
+    result: [],
+  },
+});
+
+const generatedTxPage = (prefix: string, lastBlock: number) =>
+  Array.from({ length: 1000 }, (_, index) => ({
+    blockNumber: index === 999 ? lastBlock : 1000 + index,
+    timeStamp: 1710000000 + index,
+    hash: `${prefix}${index}`,
+    from: '0xpageFrom',
+    to: '0xpageTo',
+    value: index,
+    gas: 21000 + index,
+    gasPrice: 30,
+    gasUsed: 20000 + index,
+    input: '0x',
+    contractAddress: '',
+
+    isError: 0,
+    transfers: [],
+  }));
+
+beforeEach(() => {
+  mockedAxiosGet.mockReset();
+  vi.spyOn(console, 'error').mockImplementation(() => undefined);
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+describe('chain transaction history retrieval', () => {
+  it('returns the first successful zkSync txlist page and sends the declared explorer params', async () => {
+
+
+    mockedAxiosGet.mockResolvedValueOnce(okPage([txA]));
+
+    const actual = await getZkSyncTransactions('0xabc');
+
+    expect(actual).toEqual([
+      {
+        blockNumber: 101,
+        timeStamp: 1700000001,
+        hash: '0xzkA',
+        from: '0xabc',
+        to: '0x111',
+        value: 7,
+        gas: 21000,
+        gasPrice: 11,
+        gasUsed: 21000,
+        input: '0x',
+        contractAddress: '',
+        transfers: [{ tokenSymbol: 'ETH', transferPrice: 12.5 }],
+      },
+    ]);
+    expect(mockedAxiosGet).toHaveBeenCalledTimes(1);
+    expect(mockedAxiosGet).toHaveBeenNthCalledWith(1, zksyncUrl, zksyncInitialParams('0xabc'));
+  });
+
+  it('continues zkSync pagination after a full 1000 item page and concatenates fetch-order pages', async () => {
+
+
+    const firstPage = generatedTxPage('0xzkBulk', 4242);
+    mockedAxiosGet.mockResolvedValueOnce(okPage(firstPage)).mockResolvedValueOnce(okPage([txB]));
+
+    const actual = await getZkSyncTransactions('0xabc');
+
+    expect(actual).toEqual([...firstPage, txB]);
+    expect(mockedAxiosGet).toHaveBeenNthCalledWith(1, zksyncUrl, zksyncInitialParams('0xabc', 0));
+    expect(mockedAxiosGet).toHaveBeenNthCalledWith(2, zksyncUrl, zksyncInitialParams('0xabc', 4242));
+  });
+
+  it('keeps only the normal Scroll transaction when an internal transaction has the same hash', async () => {
+
+
+    mockedAxiosGet
+      .mockResolvedValueOnce(okPage([normalTx]))
+      .mockResolvedValueOnce(okPage([{ ...internalDifferentHash, hash: '0xscrollNormal' }]));
+
+    const actual = await getScrollTransactions('0xdef');
+
+    expect(actual).toEqual([
+      {
+        blockNumber: 700,
+        timeStamp: 1700000700,
+        hash: '0xscrollNormal',
+        nonce: 9,
+        blockHash: '0xblockNormal',
+        transactionIndex: 4,
+        from: '0xdef',
+        to: '0x999',
+        value: 123,
+        gas: 50000,
+        gasPrice: 22,
+        isError: 0,
+        txreceipt_status: 1,
+        input: '0xabcd',
+        contractAddress: '',
+        cumulativeGasUsed: 60000,
+        gasUsed: 49000,
+        confirmations: 88,
+        methodId: '0xabcd1234',
+        functionName: 'swap()',
+        transfers: [{ tokenSymbol: 'ETH', transferPrice: 42 }],
+      },
+    ]);
+    expect(mockedAxiosGet).toHaveBeenNthCalledWith(1, scrollUrl, scrollParams('txlist', '0xdef'));
+    expect(mockedAxiosGet).toHaveBeenNthCalledWith(2, scrollUrl, scrollParams('txlistinternal', '0xdef'));
+  });
+
+  it('appends a different-hash Scroll internal transaction with unsupported fields filled by defaults', async () => {
+
+
+    mockedAxiosGet.mockResolvedValueOnce(okPage([normalTx])).mockResolvedValueOnce(okPage([internalDifferentHash]));
+
+    const actual = await getScrollTransactions('0xdef');
+
+    expect(actual).toEqual([
+      normalTx,
+      {
+        blockHash: '',
+        confirmations: 0,
+        contractAddress: '0xinternalContract',
+        cumulativeGasUsed: 0,
+        from: '0xbridge',
+        functionName: '',
+        gas: 81000,
+        gasPrice: 0,
+        gasUsed: 80000,
+        hash: '0xscrollInternalOnly',
+        input: '0xfeed',
+        isError: 0,
+        methodId: '',
+        nonce: 0,
+        timeStamp: 1700000710,
+        to: '0xdef',
+        transactionIndex: 0,
+        transfers: [],
+        txreceipt_status: 0,
+        value: 321,
+        blockNumber: 710,
+      },
+    ]);
+  });
+
+  it('pages Scroll internal transactions with txlistinternal and the same startblock boundary behavior', async () => {
+
+
+    const firstInternalPage = generatedTxPage('0xscrollInternalBulk', 9090);
+    const finalInternalTx = {
+      ...internalDifferentHash,
+      hash: '0xscrollInternalFinal',
+      blockNumber: 9091,
+      timeStamp: 1700009091,
+    };
+    mockedAxiosGet
+      .mockResolvedValueOnce(okPage([]))
+      .mockResolvedValueOnce(okPage(firstInternalPage))
+      .mockResolvedValueOnce(okPage([finalInternalTx]));
+
+    const actual = await getScrollTransactions('0xdef');
+
+    expect(actual).toEqual([
+      ...firstInternalPage.map((internalTransaction) => ({
+        blockHash: '',
+        confirmations: 0,
+        contractAddress: internalTransaction.contractAddress,
+        cumulativeGasUsed: 0,
+        from: internalTransaction.from,
+        functionName: '',
+        gas: internalTransaction.gas,
+        gasPrice: 0,
+        gasUsed: internalTransaction.gasUsed,
+        hash: internalTransaction.hash,
+        input: internalTransaction.input,
+        isError: internalTransaction.isError,
+        methodId: '',
+        nonce: 0,
+        timeStamp: internalTransaction.timeStamp,
+        to: internalTransaction.to,
+        transactionIndex: 0,
+        transfers: [],
+        txreceipt_status: 0,
+        value: internalTransaction.value,
+        blockNumber: internalTransaction.blockNumber,
+      })),
+      {
+        blockHash: '',
+        confirmations: 0,
+        contractAddress: '0xinternalContract',
+        cumulativeGasUsed: 0,
+        from: '0xbridge',
+        functionName: '',
+        gas: 81000,
+        gasPrice: 0,
+        gasUsed: 80000,
+        hash: '0xscrollInternalFinal',
+        input: '0xfeed',
+        isError: 0,
+        methodId: '',
+        nonce: 0,
+        timeStamp: 1700009091,
+        to: '0xdef',
+        transactionIndex: 0,
+        transfers: [],
+        txreceipt_status: 0,
+        value: 321,
+        blockNumber: 9091,
+      },
+    ]);
+    expect(mockedAxiosGet).toHaveBeenNthCalledWith(1, scrollUrl, scrollParams('txlist', '0xdef', 0));
+    expect(mockedAxiosGet).toHaveBeenNthCalledWith(2, scrollUrl, scrollParams('txlistinternal', '0xdef', 0));
+    expect(mockedAxiosGet).toHaveBeenNthCalledWith(3, scrollUrl, scrollParams('txlistinternal', '0xdef', 9090));
+  });
+
+  it('logs an explorer status zero message and returns transactions accumulated so far', async () => {
+
+
+    const firstPage = generatedTxPage('0xzkBeforeStatusZero', 8080);
+    mockedAxiosGet
+      .mockResolvedValueOnce(okPage(firstPage))
+      .mockResolvedValueOnce(statusZeroPage('NOTOK: rate limit'));
+
+    const actual = await getZkSyncTransactions('0xabc');
+
+    expect(actual).toEqual(firstPage);
+    expect(console.error).toHaveBeenCalledWith('Error occurred while retrieving transactions:', 'NOTOK: rate limit');
+  });
+
+  it('logs a thrown HTTP request error and resolves with transactions accumulated so far', async () => {
+
+
+    const requestError = new TypeError('network down');
+    mockedAxiosGet.mockResolvedValueOnce(okPage([normalTx])).mockRejectedValueOnce(requestError);
+
+    const actual = await getScrollTransactions('0xdef');
+
+    expect(actual).toEqual([normalTx]);
+    expect(console.error).toHaveBeenCalledWith('Error occurred while making the request:', requestError);
+  });
+});
+
+describe('additional transaction history contract checks', () => {
+  it('performs the declared zkSync explorer request for repeated calls', async () => {
+    mockedAxiosGet.mockResolvedValue(okPage([txA]));
+
+    const first = await getZkSyncTransactions('0xabc');
+    const second = await getZkSyncTransactions('0xabc');
+
+
+    expect(first).toEqual([
+      {
+        blockNumber: 101,
+        timeStamp: 1700000001,
+        hash: '0xzkA',
+        from: '0xabc',
+        to: '0x111',
+        value: 7,
+        gas: 21000,
+        gasPrice: 11,
+        gasUsed: 21000,
+        input: '0x',
+        contractAddress: '',
+        transfers: [{ tokenSymbol: 'ETH', transferPrice: 12.5 }],
+      },
+    ]);
+    expect(second).toEqual(first);
+    expect(mockedAxiosGet).toHaveBeenCalledTimes(2);
+    expect(mockedAxiosGet).toHaveBeenNthCalledWith(1, zksyncUrl, zksyncInitialParams('0xabc'));
+    expect(mockedAxiosGet).toHaveBeenNthCalledWith(2, zksyncUrl, zksyncInitialParams('0xabc'));
+  });
+
+  it('uses the caller-provided address value in the zkSync explorer request', async () => {
+    mockedAxiosGet.mockResolvedValueOnce(okPage([txA]));
+    const callerInput = { address: '0xabc' };
+
+    await getZkSyncTransactions(callerInput.address);
+
+
+    expect(mockedAxiosGet).toHaveBeenNthCalledWith(1, zksyncUrl, zksyncInitialParams('0xabc'));
+  });
+
+  it('resolves with the first successful zkSync page in the current test process', async () => {
+    mockedAxiosGet.mockResolvedValueOnce(okPage([txA]));
+    const inProcess = await getZkSyncTransactions('0xabc');
+
+
+    expect(inProcess).toEqual([
+      {
+        blockNumber: 101,
+        timeStamp: 1700000001,
+        hash: '0xzkA',
+        from: '0xabc',
+        to: '0x111',
+        value: 7,
+        gas: 21000,
+        gasPrice: 11,
+        gasUsed: 21000,
+        input: '0x',
+        contractAddress: '',
+        transfers: [{ tokenSymbol: 'ETH', transferPrice: 12.5 }],
+      },
+    ]);
+  });
+
+  it('performs the declared zkSync explorer request for a short successful page', async () => {
+    mockedAxiosGet.mockResolvedValueOnce(okPage([txA]));
+
+    const actual = await getZkSyncTransactions('0xabc');
+
+    expect(actual).toEqual([txA]);
+
+    expect(mockedAxiosGet).toHaveBeenCalledTimes(1);
+    expect(mockedAxiosGet).toHaveBeenNthCalledWith(1, zksyncUrl, zksyncInitialParams('0xabc'));
+  });
+});
