+++ b/mimo_test_command.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+if [ ! -x ./node_modules/.bin/vitest ]; then
+  echo "Missing prepared offline dependency: ./node_modules/.bin/vitest" >&2
+  exit 127
+fi
+exec ./node_modules/.bin/vitest run /workspace/repo/usercase-test-coderl/transactions.test.ts --reporter=verbose --pool=forks
