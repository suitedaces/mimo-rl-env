diff --git a/tests/unit/utils/helper-functions-test.js b/tests/unit/utils/helper-functions-test.js
new file mode 100644
index 00000000..0f6f6f6
--- /dev/null
+++ b/tests/unit/utils/helper-functions-test.js
@@ -0,0 +1,36 @@
+import { module, test } from 'qunit';
+import { isEquivalent } from 'ember-data-factory-guy/utils/helper-functions';
+
+module('isEquivalent | Helper Function');
+
+test('isEquivalent treats arrays with same ordered contents as equivalent', function(assert) {
+  assert.ok(isEquivalent(['red', 'blue'], ['red', 'blue']), 'arrays with the same ordered contents are equivalent');
+  assert.ok(isEquivalent(['alpha', 'omega'], ['alpha', 'omega']), 'different array values with the same ordered contents are equivalent');
+  assert.ok(isEquivalent({ filters: ['new', 'popular'] }, { filters: ['new', 'popular'] }), 'array values inside objects are compared by contents');
+  assert.ok(isEquivalent({ labels: ['cold', 'hot'] }, { labels: ['cold', 'hot'] }), 'different object array values are compared by contents');
+  assert.ok(isEquivalent([1, ['x', { ok: true }]], [1, ['x', { ok: true }]]), 'nested arrays and objects are compared recursively');
+});
+
+test('isEquivalent rejects reordered or different-length arrays', function(assert) {
+  assert.notOk(isEquivalent(['red', 'blue'], ['blue', 'red']), 'arrays with the same values in a different order are not equivalent');
+  assert.notOk(isEquivalent([1, 2], [1, 2, 3]), 'arrays with different lengths are not equivalent');
+});
+
+test('isEquivalent rejects values of different kinds without matching them', function(assert) {
+  assert.notOk(isEquivalent([], {}), 'an array and an object are not equivalent');
+  assert.notOk(isEquivalent({ a: 1 }, 'a'), 'an object and a primitive value are not equivalent');
+  assert.notOk(isEquivalent(1, '1'), 'a number and a string are not equivalent');
+});
+
+test('isEquivalent checks later object properties after nested matches', function(assert) {
+  assert.notOk(isEquivalent({ a: { x: 1 }, b: 2 }, { a: { x: 1 }, b: 3 }), 'a later differing property prevents equivalence after a nested property matches');
+  assert.notOk(isEquivalent({ first: { ok: true }, second: ['x'] }, { first: { ok: true }, second: ['y'] }), 'all object properties are considered when nested values match');
+});
+
+test('isEquivalent preserves strict scalar equality', function(assert) {
+  assert.ok(isEquivalent(1, 1), 'equal numbers are equivalent');
+  assert.notOk(isEquivalent(1, 2), 'different numbers are not equivalent');
+  assert.ok(isEquivalent('x', 'x'), 'equal strings are equivalent');
+  assert.ok(isEquivalent(false, false), 'equal booleans are equivalent');
+  assert.notOk(isEquivalent(true, false), 'different booleans are not equivalent');
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,86 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd /testbed
+
+
+
+
+
+if [ ! -f node_modules/.package-lock.json ]; then
+  cp package.json /tmp/package.json.orig
+  sed -i \
+    -e 's/"ember-cli-babel": "latest"/"ember-cli-babel": "5.2.8"/' \
+    -e 's/"ember-cli-htmlbars": "latest"/"ember-cli-htmlbars": "1.0.11"/' \
+    -e 's/"ember-cli-ic-ajax": "latest"/"ember-cli-ic-ajax": "1.0.0"/' \
+    -e 's/"ember-export-application-global": "latest"/"ember-export-application-global": "1.1.1"/' \
+    package.json
+  npm install
+  cp /tmp/package.json.orig package.json
+fi
+
+SHIMS_FILE=node_modules/ember-cli-shims/index.js
+if grep -q "projectBowerDeps\['ember-cli-shims'\]" "$SHIMS_FILE" 2>/dev/null; then
+  sed -i \
+    "s/    var projectBowerDeps = this.project.bowerDependencies();/    \/\/ Patched: allow ember-cli-shims in both bower and npm\n    \/\/ var projectBowerDeps = this.project.bowerDependencies();/" \
+    "$SHIMS_FILE"
+  sed -i \
+    "s/    if (projectBowerDeps\['ember-cli-shims'\]) {/    \/\/ if (projectBowerDeps['ember-cli-shims']) {/" \
+    "$SHIMS_FILE"
+  sed -i \
+    "s/      throw new SilentError('Using ember-cli-shims as both a bower dependency and an npm dependency is not supported. Please remove \`ember-cli-shims\` from \`bower.json\`.');/    \/\/   throw new SilentError('Using ember-cli-shims as both a bower dependency and an npm dependency is not supported. Please remove \`ember-cli-shims\` from \`bower.json\`.');/" \
+    "$SHIMS_FILE"
+  sed -i \
+    "s/    }/    \/\/ }/" \
+    "$SHIMS_FILE"
+fi
+
+QUNIT_FILE=node_modules/ember-cli-qunit/index.js
+if grep -q "_shouldImportEmberQUnit = !dep.gt" "$QUNIT_FILE" 2>/dev/null; then
+  sed -i "s/this._shouldImportEmberQUnit = !dep.gt('2.2.0-alpha');/this._shouldImportEmberQUnit = false; \/\/ Patched: use treeForAddonTestSupport with transpilation/" "$QUNIT_FILE"
+fi
+if grep -q "return new MergeTrees(this._getDependencyTrees())" "$QUNIT_FILE" 2>/dev/null; then
+  sed -i '/treeForAddonTestSupport: function() {/,/  },/c\  treeForAddonTestSupport: function() {\n    \/\/ Patched: transpile ES6 source trees to AMD for ember-cli 2.3+\n    var depTree = new MergeTrees(this._getDependencyTrees());\n    return new BabelTranspiler(depTree, {\n      loose: true,\n      moduleIds: true,\n      modules: '\''amdStrict'\''\n    });\n  },' "$QUNIT_FILE"
+fi
+
+
+
+
+if [ ! -f bower_components/sinon/index.js ]; then
+  npm pack sinon@1.12.2 --pack-destination /tmp >/dev/null
+  mkdir -p /tmp/sinon-1.12.2 bower_components/sinon
+  tar -xzf /tmp/sinon-1.12.2.tgz -C /tmp/sinon-1.12.2
+  cp /tmp/sinon-1.12.2/package/pkg/sinon-1.12.2.js bower_components/sinon/index.js
+fi
+if [ ! -d bower_components/ember ]; then
+  cp bower.json /tmp/bower.json.orig
+  node -e "const fs=require('fs'); const p=JSON.parse(fs.readFileSync('bower.json')); delete p.devDependencies.sinon; fs.writeFileSync('bower.json', JSON.stringify(p, null, 2));"
+  npx bower install --allow-root
+  cp /tmp/bower.json.orig bower.json
+fi
+
+if [ ! -f /usr/bin/google-chrome-stable-real ]; then
+  cp /usr/bin/google-chrome-stable /usr/bin/google-chrome-stable-real 2>/dev/null || true
+fi
+cat > /usr/bin/google-chrome-stable <<'WRAP'
+#!/bin/bash
+exec /usr/bin/google-chrome-stable-real --no-sandbox --headless --disable-gpu "$@"
+WRAP
+chmod +x /usr/bin/google-chrome-stable
+
+run_ember_tests() {
+  EMBER_DATA_SKIP_VERSION_CHECKING_DO_NOT_USE_THIS_ENV_VARIABLE=1 \
+    npx ember test --launch Chrome "$@"
+}
+
+case "${1:-}" in
+  base)
+    run_ember_tests
+    ;;
+  new)
+    run_ember_tests --filter='isEquivalent'
+    ;;
+  *)
+    echo "usage: $0 base|new" >&2
+    exit 2
+    ;;
+esac
