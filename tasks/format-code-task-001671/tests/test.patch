+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+VENV=/opt/coderl-stage4a-venv
+PYTHON="$VENV/bin/python"
+
+export PIP_NO_INDEX=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+
+if [ ! -x "$PYTHON" ]; then
+  echo "local offline venv missing: $PYTHON" >&2
+  exit 1
+fi
+
+exec "$PYTHON" -m pytest /workspace/repo/usercase-test-coderl/test_slugs.py -v
