diff --git a/pandas/tests/reshape/merge/test_merge.py b/pandas/tests/reshape/merge/test_merge.py
index a0a20d1da6..51d9fe11f4 100644
--- a/pandas/tests/reshape/merge/test_merge.py
+++ b/pandas/tests/reshape/merge/test_merge.py
@@ -4,6 +4,7 @@ from collections import OrderedDict
 from datetime import date, datetime
 import random
 import re
+import warnings
 
 import numpy as np
 from numpy import nan
@@ -1526,3 +1527,78 @@ def test_merge_series(on, left_on, right_on, left_index, right_index, nm):
         with pytest.raises(ValueError, match=msg):
             result = pd.merge(a, b, on=on, left_on=left_on, right_on=right_on,
                               left_index=left_index, right_index=right_index)
+
+
+class TestMergeSuffixNone(object):
+
+
+    def test_merge_suffix_none_left_preserves_label(self):
+
+
+
+        df = pd.DataFrame([1])
+        result = df.merge(df, left_index=True, right_index=True,
+                          suffixes=(None, '_dup'))
+        assert list(result.columns) == [0, '0_dup']
+
+    def test_merge_suffix_none_right_preserves_label(self):
+
+
+        df = pd.DataFrame([1])
+        result = df.merge(df, left_index=True, right_index=True,
+                          suffixes=('_x', None))
+        assert list(result.columns) == ['0_x', 0]
+
+    def test_merge_suffix_none_no_warning(self):
+
+
+        df = pd.DataFrame([1])
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always")
+            df.merge(df, left_index=True, right_index=True,
+                     suffixes=(None, '_dup'))
+        relevant = [w for w in caught
+                    if issubclass(w.category, (FutureWarning,
+                                               DeprecationWarning))
+                    and 'suffix' in str(w.message).lower()]
+        assert relevant == [], (
+            "Unexpected suffix-related warning(s): "
+            "{}".format([str(w.message) for w in relevant]))
+
+    def test_merge_suffix_empty_string_keeps_existing_behavior(self):
+
+
+        df = pd.DataFrame([1])
+        result = df.merge(df, left_index=True, right_index=True,
+                          suffixes=('', '_dup'))
+        assert list(result.columns) == ['0', '0_dup']
+
+    def test_merge_suffix_both_none_raises(self):
+
+
+        df = pd.DataFrame([1])
+        with pytest.raises(ValueError, match='columns overlap'):
+            df.merge(df, left_index=True, right_index=True,
+                     suffixes=(None, None))
+
+    def test_merge_suffix_none_preserves_dtype(self):
+
+
+        df = pd.DataFrame([1])
+        result = df.merge(df, left_index=True, right_index=True,
+                          suffixes=(None, '_dup'))
+
+        assert 0 in result.columns
+
+        assert '0' not in result.columns
+
+        assert '0None' not in result.columns
+
+    def test_merge_suffix_none_preserves_dtype_right(self):
+
+        df = pd.DataFrame([1])
+        result = df.merge(df, left_index=True, right_index=True,
+                          suffixes=('_x', None))
+        assert 0 in result.columns
+        assert '0' not in result.columns
+        assert '0None' not in result.columns
