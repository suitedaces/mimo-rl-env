@@ -0,0 +1,20 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+set -e
+
+case "${1:-}" in
+  base)
+    go test ./pkg/reconciler/validator/ -count=1 -run 'TestValidateInterStepBuffer|TestValidateMonoVertex|TestValidatePipeline|TestValidateReducePipeline|TestValidateVertex|TestValidateUDF|Test_validateSideInputs|Test_getCyclesFromVertex|Test_validateCycles|Test_validateIdleSource|TestValidateSink|TestIsValidSinkRetryStrategy' -v
+    go test ./pkg/apis/numaflow/v1alpha1/ -count=1 -run 'TestOwnedBuffers|TestOwnedBuffersSource|TestGetFromBuckets|TestGetToBuffers|TestGetToBuffersSink|TestWithoutReplicas|TestGetVertexReplicas|TestGetHeadlessSvcSpec|TestGetServiceObjs|TestGetHeadlessServiceName|Test_getType|TestVertexMarkPhase|TestVertexMarkPhaseRunning|TestVertexMarkPhaseFailed|Test_VertexMarkPodNotHealthy|Test_VertexMarkPodHealthy|Test_VertexMarkDeployed|Test_VertexMarkDeployFailed|TestGetPipelineSpec|TestUpdateVertexCondition' -v
+    ;;
+  new)
+    go test ./pkg/apis/numaflow/v1alpha1/ -count=1 -run 'TestServingSourcePodSpecUsesMainContainerOnlyForServing|TestServingSourcePodSpecRejectsSidecarForAlternateServingInputs|TestServingSourceMainContainerHasServingRuntimeEnv|TestServingSourceMainContainerRuntimeEnvForSingleEdgePipeline|TestCallbackEnvOnlyForPipelinesWithServingSource|TestCallbackEnvEnabledForSinkInServingPipeline' -v
+    go test ./pkg/reconciler/validator/ -count=1 -run 'TestValidatePipelineRejectsServingSourceWithReduce|TestValidatePipelineRejectsServingReduceWhenServingSourceIsNotFirstOrTwoHop|TestValidatePipelineAllowsServingWithoutReduceAndReduceWithoutServing' -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
