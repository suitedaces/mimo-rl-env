+package validator
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+
+	dfv1 "github.com/numaproj/numaflow/pkg/apis/numaflow/v1alpha1"
+)
+
+func fixturePipelineWithVertices(vertices []dfv1.AbstractVertex, edges []dfv1.Edge) *dfv1.Pipeline {
+	pl := testPipeline.DeepCopy()
+	pl.Spec.Vertices = vertices
+	pl.Spec.Edges = edges
+	return pl
+}
+
+func fixtureReduceUDF() *dfv1.UDF {
+	return &dfv1.UDF{
+		Container: &dfv1.Container{Image: "my-image"},
+		GroupBy: &dfv1.GroupBy{
+			Window: dfv1.Window{
+				Fixed: &dfv1.FixedWindow{
+					Length: &metav1.Duration{Duration: time.Minute},
+				},
+			},
+			Keyed: true,
+			Storage: &dfv1.PBQStorage{
+				EmptyDir: &corev1.EmptyDirVolumeSource{},
+			},
+		},
+	}
+}
+
+func fixtureServingSource() *dfv1.ServingSource {
+	url := "redis://redis:6379"
+	return &dfv1.ServingSource{
+		Store: &dfv1.ServingStore{URL: &url},
+	}
+}
+
+func TestValidatePipelineRejectsServingSourceWithReduce(t *testing.T) {
+	cases := []struct {
+		name       string
+		serving    string
+		reduce     string
+		throughMap string
+	}{
+		{
+			name:       "direct names",
+			serving:    "serving-in",
+			reduce:     "reduce-vtx",
+			throughMap: "map-before-reduce",
+		},
+		{
+			name:       "different names to prevent hardcoding",
+			serving:    "http-in",
+			reduce:     "aggregate",
+			throughMap: "normalize",
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			pl := fixturePipelineWithVertices(
+				[]dfv1.AbstractVertex{
+					{Name: tc.serving, Source: &dfv1.Source{Serving: fixtureServingSource()}},
+					{Name: tc.throughMap, UDF: &dfv1.UDF{Builtin: &dfv1.Function{Name: "cat"}}},
+					{Name: tc.reduce, UDF: fixtureReduceUDF()},
+					{Name: "out", Sink: &dfv1.Sink{}},
+				},
+				[]dfv1.Edge{
+					{From: tc.serving, To: tc.throughMap},
+					{From: tc.throughMap, To: tc.reduce},
+					{From: tc.reduce, To: "out"},
+				},
+			)
+
+			err := ValidatePipeline(pl)
+			require.Error(t, err)
+		})
+	}
+}
+
+func TestValidatePipelineRejectsServingReduceWhenServingSourceIsNotFirstOrTwoHop(t *testing.T) {
+	pl := fixturePipelineWithVertices(
+		[]dfv1.AbstractVertex{
+			{Name: "plain-source", Source: &dfv1.Source{}},
+			{Name: "late-source", Source: &dfv1.Source{Serving: fixtureServingSource()}},
+			{Name: "direct-reduce", UDF: fixtureReduceUDF()},
+			{Name: "joined-sink", Sink: &dfv1.Sink{}},
+		},
+		[]dfv1.Edge{
+			{From: "plain-source", To: "direct-reduce"},
+			{From: "late-source", To: "direct-reduce"},
+			{From: "direct-reduce", To: "joined-sink"},
+		},
+	)
+
+	err := ValidatePipeline(pl)
+	require.Error(t, err)
+}
+
+func TestValidatePipelineAllowsServingWithoutReduceAndReduceWithoutServing(t *testing.T) {
+	t.Run("serving source without reduce remains valid", func(t *testing.T) {
+		pl := fixturePipelineWithVertices(
+			[]dfv1.AbstractVertex{
+				{Name: "serving-ok", Source: &dfv1.Source{Serving: fixtureServingSource()}},
+				{Name: "map-ok", UDF: &dfv1.UDF{Builtin: &dfv1.Function{Name: "cat"}}},
+				{Name: "sink-ok", Sink: &dfv1.Sink{}},
+			},
+			[]dfv1.Edge{
+				{From: "serving-ok", To: "map-ok"},
+				{From: "map-ok", To: "sink-ok"},
+			},
+		)
+
+		assert.NoError(t, ValidatePipeline(pl))
+	})
+
+	t.Run("reduce without serving source remains valid", func(t *testing.T) {
+		pl := fixturePipelineWithVertices(
+			[]dfv1.AbstractVertex{
+				{Name: "input-ok", Source: &dfv1.Source{}},
+				{Name: "reduce-ok", UDF: fixtureReduceUDF()},
+				{Name: "sink-ok", Sink: &dfv1.Sink{}},
+			},
+			[]dfv1.Edge{
+				{From: "input-ok", To: "reduce-ok"},
+				{From: "reduce-ok", To: "sink-ok"},
+			},
+		)
+
+		assert.NoError(t, ValidatePipeline(pl))
+	})
+}
