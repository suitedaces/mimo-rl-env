+def test_scan_plated_discrete_uniform():
+    def model():
+        def transition(carry, x):
+            with numpyro.plate("p", 4):
+                v = numpyro.sample("v", dist.DiscreteUniform(0, 5))
+            return carry + 1, v
+
+        _, vs = scan(transition, jnp.array(0), jnp.arange(3))
+        return vs
+
+    seeded_model = seed(model, rng_seed=0)
+    out = seeded_model()
+    assert out.shape == (3, 4)
+    assert jnp.all((out >= 0) & (out <= 5))
+
+
+def test_scan_plated_truncated_normal():
+    def model():
+        def transition(carry, x):
+            with numpyro.plate("p", 4):
+                v = numpyro.sample(
+                    "v",
+                    dist.TruncatedNormal(loc=0.0, scale=1.0, low=-1.0, high=1.0),
+                )
+            return carry + 1, v
+
+        _, vs = scan(transition, jnp.array(0), jnp.arange(3))
+        return vs
+
+    seeded_model = seed(model, rng_seed=0)
+    out = seeded_model()
+    assert out.shape == (3, 4)
+    assert jnp.all(jnp.isfinite(out))
+    assert jnp.all((out >= -1.0) & (out <= 1.0))
+
+
+def test_scan_wishart():
+    def model():
+        def transition(carry, x):
+            v = numpyro.sample(
+                "v",
+                dist.Wishart(concentration=4.0, scale_tril=jnp.eye(3)),
+            )
+            return carry + 1, v
+
+        _, vs = scan(transition, jnp.array(0), jnp.arange(3))
+        return vs
+
+    seeded_model = seed(model, rng_seed=0)
+    out = seeded_model()
+    assert out.shape == (3, 3, 3)
+    assert jnp.all(jnp.isfinite(out))
