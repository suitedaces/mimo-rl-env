+# vim:fileencoding=utf-8:noet
+from __future__ import (unicode_literals, division, absolute_import, print_function)
+
+import powerline.segments.i3wm as segments_i3wm
+import powerline.listers.i3wm as listers_i3wm
+
+from tests.modules.lib import Args, replace_attr, Pl
+from tests.modules import TestCase
+
+
+class FakeWS(object):
+
+	def __init__(self, name, output, focused=False, urgent=False, visible=False):
+		self.name = name
+		self.output = output
+		self.focused = focused
+		self.urgent = urgent
+		self.visible = visible
+
+
+def make_workspaces():
+	return iter([
+		FakeWS('1: w1', 'LVDS1'),
+		FakeWS('2: w2', 'LVDS1', visible=True),
+		FakeWS('3: w3', 'HDMI1', urgent=True, visible=True),
+		FakeWS('4: w4', 'DVI01', focused=True, urgent=True, visible=True),
+	])
+
+
+def make_conn():
+	return Args(get_workspaces=make_workspaces)
+
+
+class TestI3WMSegmentsAttrAccess(TestCase):
+	def test_workspaces_lists_all(self):
+		pl = Pl()
+		with replace_attr(segments_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = segments_i3wm.workspaces(pl=pl, segment_info={})
+		self.assertEqual(result, [
+			{'contents': '1: w1', 'highlight_groups': ['workspace']},
+			{'contents': '2: w2', 'highlight_groups': ['w_visible', 'workspace']},
+			{'contents': '3: w3', 'highlight_groups': ['w_urgent', 'w_visible', 'workspace']},
+			{'contents': '4: w4', 'highlight_groups': ['w_focused', 'w_urgent', 'w_visible', 'workspace']},
+		])
+
+	def test_workspaces_only_show_focused_urgent(self):
+		pl = Pl()
+		with replace_attr(segments_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = segments_i3wm.workspaces(
+				pl=pl, segment_info={}, only_show=['focused', 'urgent'])
+		self.assertEqual(result, [
+			{'contents': '3: w3', 'highlight_groups': ['w_urgent', 'w_visible', 'workspace']},
+			{'contents': '4: w4', 'highlight_groups': ['w_focused', 'w_urgent', 'w_visible', 'workspace']},
+		])
+
+	def test_workspaces_only_show_visible(self):
+		pl = Pl()
+		with replace_attr(segments_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = segments_i3wm.workspaces(
+				pl=pl, segment_info={}, only_show=['visible'])
+		self.assertEqual(result, [
+			{'contents': '2: w2', 'highlight_groups': ['w_visible', 'workspace']},
+			{'contents': '3: w3', 'highlight_groups': ['w_urgent', 'w_visible', 'workspace']},
+			{'contents': '4: w4', 'highlight_groups': ['w_focused', 'w_urgent', 'w_visible', 'workspace']},
+		])
+
+	def test_workspaces_output_filter(self):
+		pl = Pl()
+		with replace_attr(segments_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = segments_i3wm.workspaces(
+				pl=pl, segment_info={}, output='LVDS1')
+		self.assertEqual(result, [
+			{'contents': '1: w1', 'highlight_groups': ['workspace']},
+			{'contents': '2: w2', 'highlight_groups': ['w_visible', 'workspace']},
+		])
+
+	def test_workspaces_strip(self):
+		pl = Pl()
+		with replace_attr(segments_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = segments_i3wm.workspaces(
+				pl=pl, segment_info={}, only_show=['visible'], strip=3)
+		self.assertEqual(result, [
+			{'contents': 'w2', 'highlight_groups': ['w_visible', 'workspace']},
+			{'contents': 'w3', 'highlight_groups': ['w_urgent', 'w_visible', 'workspace']},
+			{'contents': 'w4', 'highlight_groups': ['w_focused', 'w_urgent', 'w_visible', 'workspace']},
+		])
+
+	def test_workspaces_segment_info_output(self):
+		pl = Pl()
+		with replace_attr(segments_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = segments_i3wm.workspaces(
+				pl=pl, segment_info={'output': 'HDMI1'})
+		self.assertEqual(result, [
+			{'contents': '3: w3', 'highlight_groups': ['w_urgent', 'w_visible', 'workspace']},
+		])
+
+	def test_workspace_by_name(self):
+		pl = Pl()
+		with replace_attr(segments_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = segments_i3wm.workspace(
+				pl=pl, segment_info={}, workspace='3: w3')
+		self.assertEqual(result, [
+			{'contents': '3: w3', 'highlight_groups': ['w_urgent', 'w_visible', 'workspace']},
+		])
+
+	def test_workspace_by_name_strip(self):
+		pl = Pl()
+		with replace_attr(segments_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = segments_i3wm.workspace(
+				pl=pl, segment_info={}, workspace='3: w3', strip=True)
+		self.assertEqual(result, [
+			{'contents': 'w3', 'highlight_groups': ['w_urgent', 'w_visible', 'workspace']},
+		])
+
+	def test_workspace_not_found(self):
+		pl = Pl()
+		with replace_attr(segments_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = segments_i3wm.workspace(
+				pl=pl, segment_info={}, workspace='999: nope')
+		self.assertIsNone(result)
+
+	def test_workspace_default_returns_focused(self):
+		pl = Pl()
+		with replace_attr(segments_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = segments_i3wm.workspace(pl=pl, segment_info={})
+		self.assertEqual(result, [
+			{'contents': '4: w4', 'highlight_groups': ['w_focused', 'w_urgent', 'w_visible', 'workspace']},
+		])
+
+
+class TestI3WMListerAttrAccess(TestCase):
+	def test_lister_lists_all(self):
+		pl = Pl()
+		with replace_attr(listers_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = list(listers_i3wm.workspace_lister(pl=pl, segment_info={'a': 1}))
+		self.assertEqual(len(result), 4)
+		outputs = [info['output'] for (info, _) in result]
+		self.assertEqual(outputs, ['LVDS1', 'LVDS1', 'HDMI1', 'DVI01'])
+		for (info, opts) in result:
+			self.assertEqual(opts, {'draw_inner_divider': None})
+			self.assertEqual(info['a'], 1)
+			self.assertIn('workspace', info)
+
+	def test_lister_output_filter(self):
+		pl = Pl()
+		with replace_attr(listers_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = list(listers_i3wm.workspace_lister(
+				pl=pl, segment_info={'a': 1}, output='LVDS1'))
+		self.assertEqual(len(result), 2)
+		self.assertEqual([info['output'] for (info, _) in result], ['LVDS1', 'LVDS1'])
+
+	def test_lister_only_show(self):
+		pl = Pl()
+		with replace_attr(listers_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = list(listers_i3wm.workspace_lister(
+				pl=pl, segment_info={'a': 1}, only_show=['focused', 'urgent']))
+		self.assertEqual(len(result), 2)
+		self.assertEqual([info['output'] for (info, _) in result], ['HDMI1', 'DVI01'])
+
+	def test_lister_segment_info_output(self):
+		pl = Pl()
+		with replace_attr(listers_i3wm, 'get_i3_connection', lambda: make_conn()):
+			result = list(listers_i3wm.workspace_lister(
+				pl=pl, segment_info={'a': 1, 'output': 'HDMI1'}))
+		self.assertEqual(len(result), 1)
+		self.assertEqual(result[0][0]['output'], 'HDMI1')
+
+	def test_lister_workspace_carries_to_workspace_segment(self):
+
+
+
+		pl = Pl()
+		with replace_attr(listers_i3wm, 'get_i3_connection', lambda: make_conn()):
+			tuples = list(listers_i3wm.workspace_lister(pl=pl, segment_info={'a': 1}))
+		info_for_focused = tuples[3][0]
+		with replace_attr(segments_i3wm, 'get_i3_connection', lambda: make_conn()):
+			out = segments_i3wm.workspace(pl=pl, segment_info=info_for_focused)
+		self.assertEqual(out, [
+			{'contents': '4: w4', 'highlight_groups': ['w_focused', 'w_urgent', 'w_visible', 'workspace']},
+		])
+
+
+class TestI3WMScratchpadDescendants(TestCase):
+	def test_scratchpad_returns_correct_output(self):
+
+
+
+
+
+
+
+		nodes_focused = [Args(focused=True)]
+		nodes_unfocused = [Args(focused=False)]
+		ws_scratch = lambda: Args(name='__i3_scratch')
+		ws_other = lambda: Args(name='2: www')
+
+		def make_descendants():
+			return [
+				Args(scratchpad_state='fresh', urgent=False,
+				     workspace=ws_scratch, nodes=nodes_unfocused),
+				Args(scratchpad_state='changed', urgent=True,
+				     workspace=ws_other, nodes=nodes_focused),
+			]
+
+		class Tree(object):
+			def descendants(self):
+				return make_descendants()
+
+			def descendents(self):
+				return make_descendants()
+
+		class Conn(object):
+			def get_tree(self):
+				return Tree()
+
+		pl = Pl()
+		with replace_attr(segments_i3wm, 'get_i3_connection', lambda: Conn()):
+			out = segments_i3wm.scratchpad(pl=pl)
+
+		self.assertEqual(out, [
+			{'contents': 'O', 'highlight_groups': ['scratchpad']},
+			{'contents': 'X', 'highlight_groups': [
+				'scratchpad:urgent', 'scratchpad:focused', 'scratchpad:visible', 'scratchpad']},
+		])
+
+
+if __name__ == '__main__':
+	from tests.modules import main
+	main()
