new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/plane_stateful.test.js
@@ -0,0 +1,454 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+
+
+
+
+
+
+const observedElements = new Set()
+const listeners = new Map()
+
+class TestElement {
+  constructor(tagName = 'div') {
+    this.tagName = tagName.toUpperCase()
+    this.children = []
+    this.parentNode = null
+    this.style = {}
+    this.attributes = {}
+    this.id = ''
+    this.className = ''
+    this.width = 300
+    this.height = 150
+    this._rect = { top: 20, left: 10, width: 200, height: 100 }
+  }
+
+  setAttribute(name, value) {
+    this.attributes[name] = String(value)
+    if (name === 'id') this.id = String(value)
+    if (name === 'class') this.className = String(value)
+  }
+
+  appendChild(child) {
+    child.parentNode = this
+    this.children.push(child)
+    return child
+  }
+
+  removeChild(child) {
+    this.children = this.children.filter((entry) => entry !== child)
+    child.parentNode = null
+    return child
+  }
+
+  getBoundingClientRect() {
+    const { top, left, width, height } = this._rect
+    return { top, left, width, height, right: left + width, bottom: top + height, x: left, y: top }
+  }
+
+  isSameNode(other) {
+    return this === other
+  }
+
+  querySelector(selector) {
+    return findIn(this, selector)
+  }
+
+  querySelectorAll(selector) {
+    const found = []
+    collectIn(this, selector, found)
+    return found
+  }
+}
+
+class TestDocument {
+  constructor() {
+    this.body = new TestElement('body')
+  }
+
+  createElement(tagName) {
+    return new TestElement(tagName)
+  }
+
+  querySelector(selector) {
+    return this.body.querySelector(selector)
+  }
+
+  querySelectorAll(selector) {
+    return this.body.querySelectorAll(selector)
+  }
+}
+
+class TestResizeObserver {
+  observe(element) {
+    observedElements.add(element)
+  }
+
+  unobserve(element) {
+    observedElements.delete(element)
+  }
+
+  disconnect() {
+    observedElements.clear()
+  }
+}
+
+function matches(element, selector) {
+  if (selector.startsWith('#')) return element.id === selector.slice(1)
+  if (selector.startsWith('.')) return String(element.className).split(/\s+/).includes(selector.slice(1))
+  return element.tagName.toLowerCase() === selector.toLowerCase()
+}
+
+function findIn(root, selector) {
+  if (matches(root, selector)) return root
+
+  for (const child of root.children) {
+    const found = findIn(child, selector)
+    if (found) return found
+  }
+
+  return null
+}
+
+function collectIn(root, selector, found) {
+  if (matches(root, selector)) found.push(root)
+  for (const child of root.children) collectIn(child, selector, found)
+}
+
+function installBrowserShim() {
+  observedElements.clear()
+  listeners.clear()
+
+  globalThis.window = {
+    devicePixelRatio: 2,
+    pageXOffset: 0,
+    pageYOffset: 0,
+    location: { protocol: 'http:' },
+    ResizeObserver: TestResizeObserver,
+    addEventListener(type) {
+      listeners.set(type, (listeners.get(type) ?? 0) + 1)
+    },
+    removeEventListener(type) {
+      listeners.set(type, Math.max(0, (listeners.get(type) ?? 0) - 1))
+    },
+  }
+
+  globalThis.document = new TestDocument()
+  globalThis.Element = TestElement
+  globalThis.HTMLElement = TestElement
+  globalThis.HTMLCanvasElement = TestElement
+  globalThis.HTMLImageElement = class HTMLImageElement extends TestElement {}
+  globalThis.HTMLVideoElement = class HTMLVideoElement extends TestElement {}
+  globalThis.HTMLIFrameElement = class HTMLIFrameElement extends TestElement {}
+  globalThis.HTMLCanvasElement = TestElement
+  globalThis.OffscreenCanvas = class OffscreenCanvas {}
+  globalThis.ResizeObserver = TestResizeObserver
+  globalThis.WebGLRenderingContext = {
+    BYTE: 5120,
+    UNSIGNED_BYTE: 5121,
+    SHORT: 5122,
+    UNSIGNED_SHORT: 5123,
+    INT: 5124,
+    UNSIGNED_INT: 5125,
+    FLOAT: 5126,
+    HALF_FLOAT: 5131,
+    ARRAY_BUFFER: 34962,
+    ELEMENT_ARRAY_BUFFER: 34963,
+  }
+  globalThis.navigator = { gpu: undefined }
+  globalThis.requestAnimationFrame = () => 1
+  globalThis.cancelAnimationFrame = () => {}
+}
+
+function appendElement(id, rect = { top: 20, left: 10, width: 200, height: 100 }) {
+  const element = document.createElement('div')
+  element.setAttribute('id', id)
+  element._rect = rect
+  document.body.appendChild(element)
+  return element
+}
+
+function setupDOM() {
+  installBrowserShim()
+
+  appendElement('canvas', { top: 0, left: 0, width: 800, height: 600 })
+  appendElement('card', { top: 25, left: 40, width: 320, height: 180 })
+  appendElement('other', { top: 70, left: 80, width: 120, height: 90 })
+}
+
+async function loadPublicAPI() {
+  return import('/workspace/repo/dist/esm/index.mjs')
+}
+
+function createCurtains(GPUCurtains, container = '#canvas') {
+  return new GPUCurtains({
+    container,
+    autoRender: false,
+    watchScroll: false,
+    pixelRatio: 1,
+    lights: false,
+  })
+}
+
+test('default Plane construction creates a DOM-backed quad with default geometry', async () => {
+
+
+
+
+  setupDOM()
+  const { GPUCurtains, Plane } = await loadPublicAPI()
+
+  const gpuCurtains = createCurtains(GPUCurtains)
+  assert.equal(gpuCurtains.renderers.length, 1)
+  assert.equal(gpuCurtains.domMeshes.length, 0)
+  assert.equal(gpuCurtains.planes.length, 0)
+
+  assert.ok((listeners.get('scroll') ?? 0) >= 0)
+
+  const plane = new Plane(gpuCurtains, '#card')
+
+  assert.equal(typeof Plane, 'function')
+  assert.equal(plane.type, 'Plane')
+
+  assert.equal(gpuCurtains.domMeshes.includes(plane), true)
+  assert.equal(plane.domElement.element.id, 'card')
+  assert.equal(plane.options.label, 'Plane')
+
+  assert.equal('autoloadSources' in plane, true)
+  assert.equal('watchScroll' in plane, true)
+
+  assert.equal(Array.isArray(plane.domTextures), true)
+  assert.equal(gpuCurtains.renderer.domMeshes.length, 1)
+  assert.equal(gpuCurtains.domMeshes.length, 1)
+  assert.equal(gpuCurtains.planes.length, 1)
+  assert.equal(plane.geometry.type, 'PlaneGeometry')
+  assert.equal(plane.geometry.definition.width, 1)
+  assert.equal(plane.geometry.definition.height, 1)
+  assert.equal(plane.geometry.instancesCount, 1)
+  assert.equal(plane.geometry.options.vertexBuffers.length, 0)
+
+  assert.equal(plane.geometry.definition.width * plane.geometry.definition.height, 1)
+  assert.equal(plane.boundingRect.width, 320)
+  assert.equal(plane.boundingRect.height, 180)
+
+
+  const rendererPlane = new Plane(gpuCurtains.renderer, '#other')
+  assert.equal(rendererPlane.type, 'Plane')
+  assert.equal(rendererPlane.domElement.element.id, 'other')
+  assert.equal(gpuCurtains.planes.includes(rendererPlane), true)
+})
+
+test('Plane parameters derive and cache matching geometry while preserving DOM mesh options', async () => {
+
+
+
+
+  setupDOM()
+  const { GPUCurtains, Plane } = await loadPublicAPI()
+
+  const gpuCurtains = createCurtains(GPUCurtains)
+  const other = document.querySelector('#other')
+  const first = new Plane(gpuCurtains, other, {
+    label: 'Custom label',
+    widthSegments: 3,
+    heightSegments: 2,
+    instancesCount: 4,
+    autoloadSources: false,
+    watchScroll: false,
+  })
+
+  assert.equal(first.type, 'Plane')
+  assert.equal(first.domElement.element.id, 'other')
+  assert.equal(first.options.label, 'Custom label')
+  assert.equal(first.autoloadSources, false)
+  assert.equal(first.watchScroll, false)
+  assert.equal(gpuCurtains.planes.length, 1)
+  assert.equal(first.geometry.type, 'PlaneGeometry')
+  assert.equal(first.geometry.definition.width, 3)
+  assert.equal(first.geometry.definition.height, 2)
+
+  assert.equal(first.geometry.definition.width * first.geometry.definition.height, 6)
+  assert.equal(first.geometry.options.vertexBuffers.length, 0)
+  assert.equal(first.geometry.instancesCount, 4)
+
+  assert.equal(first.geometry.definition.width * first.geometry.definition.height, 6)
+
+  const second = new Plane(gpuCurtains, '#card', { widthSegments: 3, heightSegments: 2, instancesCount: 7 })
+
+  assert.equal(second.geometry === first.geometry, true)
+  assert.equal(first.geometry.instancesCount, 7)
+  assert.equal(second.geometry.instancesCount, 7)
+  assert.equal(gpuCurtains.planes.length, 2)
+
+  const customPlane = new Plane(gpuCurtains, '#card', {
+    widthSegments: 3,
+    heightSegments: 2,
+    instancesCount: 2,
+    vertexBuffers: [
+      {
+        name: 'customInstances',
+        stepMode: 'instance',
+        attributes: [
+          {
+            name: 'customPlaneId',
+            size: 1,
+            type: 'f32',
+            bufferFormat: 'float32',
+            array: new Float32Array([1, 2]),
+          },
+        ],
+      },
+    ],
+  })
+
+  assert.equal(customPlane.geometry.type, 'PlaneGeometry')
+  assert.equal(customPlane.geometry.definition.width, 3)
+  assert.equal(customPlane.geometry.definition.height, 2)
+  assert.equal(customPlane.geometry.instancesCount, 2)
+
+  assert.notEqual(customPlane.geometry, first.geometry)
+  assert.ok(customPlane.geometry.getVertexBufferByName('customInstances'))
+  assert.equal(gpuCurtains.planes.length, 3)
+})
+
+test('explicit PlaneGeometry is used directly and invalid geometry falls back to derived PlaneGeometry', async () => {
+
+
+
+
+  setupDOM()
+  const { GPUCurtains, Plane, PlaneGeometry, BoxGeometry } = await loadPublicAPI()
+
+  const gpuCurtains = createCurtains(GPUCurtains)
+  const explicitGeometry = new PlaneGeometry({ widthSegments: 5, heightSegments: 4, instancesCount: 6 })
+  const explicitPlane = new Plane(gpuCurtains, '#other', { geometry: explicitGeometry, instancesCount: 9 })
+
+  assert.equal(explicitPlane.geometry === explicitGeometry, true)
+  assert.equal(explicitPlane.geometry.definition.width, 5)
+  assert.equal(explicitPlane.geometry.definition.height, 4)
+  assert.equal(explicitPlane.geometry.instancesCount, 6)
+  assert.equal(gpuCurtains.planes.length, 1)
+
+  const invalidGeometry = new BoxGeometry()
+  const fallbackPlane = new Plane(gpuCurtains, '#other', {
+    geometry: invalidGeometry,
+    heightSegments: 3,
+    instancesCount: 2,
+  })
+
+  assert.equal(fallbackPlane.geometry === invalidGeometry, false)
+  assert.equal(fallbackPlane.geometry.type, 'PlaneGeometry')
+  assert.equal(fallbackPlane.geometry.definition.width, 1)
+  assert.equal(fallbackPlane.geometry.definition.height, 3)
+  assert.equal(fallbackPlane.geometry.instancesCount, 2)
+  assert.equal(gpuCurtains.planes.length, 2)
+})
+
+test('out-of-order Plane construction before renderer setup fails without pinning message text', async () => {
+
+
+
+
+  setupDOM()
+  const { GPUCurtains, Plane } = await loadPublicAPI()
+
+  const unready = new GPUCurtains({ autoRender: false, watchScroll: false, pixelRatio: 1, lights: false })
+
+
+  assert.throws(() => new Plane(unready, '#card'), Error)
+})
+
+test('selector lookup failure throws without pinning message text', async () => {
+
+
+
+
+  setupDOM()
+  const { GPUCurtains, Plane } = await loadPublicAPI()
+
+  const gpuCurtains = createCurtains(GPUCurtains)
+
+
+  assert.throws(() => new Plane(gpuCurtains, '#missing'), Error)
+})
+
+test('Plane cleanup updates Plane and DOM mesh collections', async () => {
+
+
+
+
+  setupDOM()
+  const { GPUCurtains, Plane } = await loadPublicAPI()
+
+  const gpuCurtains = createCurtains(GPUCurtains)
+  const firstPlane = new Plane(gpuCurtains, '#card')
+  const secondPlane = new Plane(gpuCurtains, '#other')
+
+  assert.equal(gpuCurtains.planes.length, 2)
+  assert.doesNotThrow(() => firstPlane.remove())
+
+  assert.equal(gpuCurtains.planes.includes(firstPlane), false)
+  assert.equal(gpuCurtains.planes.length, 1)
+  assert.equal(gpuCurtains.domMeshes.length, 1)
+  assert.doesNotThrow(() => secondPlane.remove())
+
+  assert.equal(gpuCurtains.planes.includes(secondPlane), false)
+  assert.equal(gpuCurtains.planes.length, 0)
+  assert.equal(gpuCurtains.domMeshes.length, 0)
+})
+
+test('Plane collections are independent across GPUCurtains instances', async () => {
+
+
+
+
+  setupDOM()
+  const { GPUCurtains, Plane } = await loadPublicAPI()
+
+  appendElement('a-canvas', { top: 0, left: 0, width: 400, height: 300 })
+  appendElement('b-canvas', { top: 0, left: 0, width: 500, height: 350 })
+  appendElement('a-el', { top: 10, left: 20, width: 100, height: 80 })
+  appendElement('b-el', { top: 30, left: 40, width: 150, height: 90 })
+
+  const a = createCurtains(GPUCurtains, '#a-canvas')
+  const b = createCurtains(GPUCurtains, '#b-canvas')
+
+  new Plane(a, '#a-el')
+  new Plane(a, '#card')
+  new Plane(b, '#b-el')
+
+  assert.equal(a.planes.length, 2)
+  assert.equal(a.domMeshes.length, 2)
+  assert.equal(b.planes.length, 1)
+  assert.equal(b.domMeshes.length, 1)
+})
+
+test('Plane cleanup keeps resize-observer resource count bounded over repeated cycles', async () => {
+
+
+
+
+  setupDOM()
+  const { GPUCurtains, Plane } = await loadPublicAPI()
+
+  const gpuCurtains = createCurtains(GPUCurtains)
+  const observedBaseline = observedElements.size
+
+  assert.ok(observedBaseline >= 0)
+
+  for (let index = 0; index < 150; index++) {
+    const id = `cycle-${index}`
+    appendElement(id, { top: index, left: index, width: 20, height: 10 })
+    const plane = new Plane(gpuCurtains, `#${id}`)
+
+    assert.equal(plane.type, 'Plane')
+    assert.equal(plane.geometry.definition.width, 1)
+    assert.equal(plane.geometry.definition.height, 1)
+    plane.remove()
+  }
+
+  assert.equal(gpuCurtains.planes.length, 0)
+  assert.equal(gpuCurtains.domMeshes.length, 0)
+
+  assert.ok(observedElements.size <= observedBaseline)
+})
