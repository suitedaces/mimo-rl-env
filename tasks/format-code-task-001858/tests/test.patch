+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+if [ ! -x node_modules/.bin/tsc ] || [ ! -x node_modules/.bin/rolldown ]; then
+  echo "Required node_modules binaries are missing; dependencies must be preinstalled before offline test execution." >&2
+  exit 1
+fi
+
+rm -rf dist/types
+node_modules/.bin/tsc
+rm -rf dist/esm
+node_modules/.bin/rolldown -c >/dev/null
+exec node --test /workspace/repo/usercase-test-coderl/plane_stateful.test.js
