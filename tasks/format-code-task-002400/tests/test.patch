diff --git a/test/crs/test_crs.py b/test/crs/test_crs.py
index 47be8177..81cb6d87 100644
--- a/test/crs/test_crs.py
+++ b/test/crs/test_crs.py
@@ -1608,3 +1608,129 @@ def test_list_authority__multiple():
     auth_list = CRS("+proj=longlat").list_authority()
     assert AuthorityMatchInfo(auth_name="OGC", code="CRS84", confidence=70) in auth_list
     assert AuthorityMatchInfo(auth_name="EPSG", code="4326", confidence=70) in auth_list
+
+
+
+
+
+_UNCONVERTIBLE_WKT = (
+    'PROJCRS["unknown",BASEGEOGCRS["unknown",DATUM["unknown",'
+    'ELLIPSOID["WGS 84",6378137,298.257223563,LENGTHUNIT["metre",1,'
+    'ID["EPSG",9001]]]],PRIMEM["Greenwich",0,ANGLEUNIT["degree",0.0174532925199],'
+    'ID["EPSG",8901]]],CONVERSION["unknown",METHOD["Equidistant Cylindrical",'
+    'ID["EPSG",1028]],PARAMETER["Latitude of 1st standard parallel",0,'
+    'ANGLEUNIT["degree",0.0174532925199433],ID["EPSG",8823]],'
+    'PARAMETER["Longitude of natural origin",0,ANGLEUNIT["degree",0.0174532925199],'
+    'ID["EPSG",8802]],PARAMETER["False easting",0,'
+    'LENGTHUNIT["unknown",111319.490793274],ID["EPSG",8806]],'
+    'PARAMETER["False northing",0,LENGTHUNIT["unknown",111319.490793274],'
+    'ID["EPSG",8807]]],CS[Cartesian,3],AXIS["(E)",east,ORDER[1],'
+    'LENGTHUNIT["unknown",111319.490793274]],AXIS["(N)",north,ORDER[2],'
+    'LENGTHUNIT["unknown",111319.490793274]],AXIS["ellipsoidal height (h)",up,'
+    'ORDER[3],LENGTHUNIT["metre",1,ID["EPSG",9001]]]]'
+)
+
+
+def test_to_wkt_wkt1_esri_raises_crserror():
+    crs = CRS.from_wkt(_UNCONVERTIBLE_WKT)
+    with pytest.raises(CRSError, match="CRS cannot be converted to a WKT string"):
+        crs.to_wkt(version="WKT1_ESRI")
+
+
+def test_to_wkt_wkt1_gdal_raises_crserror():
+    crs = CRS.from_wkt(_UNCONVERTIBLE_WKT)
+    with pytest.raises(CRSError, match="CRS cannot be converted to a WKT string"):
+        crs.to_wkt(version="WKT1_GDAL")
+
+
+def test_to_wkt_wkt2_2015_raises_crserror():
+    crs = CRS.from_wkt(_UNCONVERTIBLE_WKT)
+    with pytest.raises(CRSError, match="CRS cannot be converted to a WKT string"):
+        crs.to_wkt(version="WKT2_2015")
+
+
+def test_to_wkt_failure_does_not_emit_future_warning():
+    crs = CRS.from_wkt(_UNCONVERTIBLE_WKT)
+    import warnings as _warnings
+
+    with _warnings.catch_warnings(record=True) as caught:
+        _warnings.simplefilter("always")
+        try:
+            crs.to_wkt(version="WKT1_ESRI")
+        except CRSError:
+            pass
+    assert not any(
+        issubclass(rec.category, FutureWarning) for rec in caught
+    ), "FutureWarning should not be emitted on conversion failure"
+
+
+def test_to_wkt_valid_crs_returns_string():
+    crs = CRS.from_epsg(4326)
+    result_default = crs.to_wkt()
+    assert isinstance(result_default, str) and result_default
+    result_esri = crs.to_wkt(version="WKT1_ESRI")
+    assert isinstance(result_esri, str) and result_esri
+    result_gdal = crs.to_wkt(version="WKT1_GDAL")
+    assert isinstance(result_gdal, str) and result_gdal
+
+
+def test_to_json_valid_crs_returns_string():
+    crs = CRS.from_epsg(4326)
+    result = crs.to_json()
+    assert isinstance(result, str)
+    assert result.lstrip().startswith("{")
+
+
+def test_to_proj4_engineering_crs_raises_crserror():
+    eng_wkt = (
+        'ENGCRS["Test",EDATUM["Test"],CS[Cartesian,2],'
+        'AXIS["x",east],AXIS["y",north],LENGTHUNIT["metre",1]]'
+    )
+    crs = CRS.from_wkt(eng_wkt)
+    import warnings as _warnings
+
+    with _warnings.catch_warnings():
+        _warnings.simplefilter("ignore", UserWarning)
+        with pytest.raises(CRSError, match="CRS cannot be converted to a PROJ string"):
+            crs.to_proj4()
+
+
+def test_to_proj4_temporal_crs_raises_crserror():
+    time_wkt = (
+        'TIMECRS["GPS Time",TDATUM["Time origin",TIMEORIGIN["1980-01-01"]],'
+        'CS[temporal,1],AXIS["time (T)",future]]'
+    )
+    crs = CRS.from_wkt(time_wkt)
+    import warnings as _warnings
+
+    with _warnings.catch_warnings():
+        _warnings.simplefilter("ignore", UserWarning)
+        with pytest.raises(CRSError, match="CRS cannot be converted to a PROJ string"):
+            crs.to_proj4()
+
+
+def test_to_proj4_failure_does_not_emit_future_warning():
+    eng_wkt = (
+        'ENGCRS["Test",EDATUM["Test"],CS[Cartesian,2],'
+        'AXIS["x",east],AXIS["y",north],LENGTHUNIT["metre",1]]'
+    )
+    crs = CRS.from_wkt(eng_wkt)
+    import warnings as _warnings
+
+    with _warnings.catch_warnings(record=True) as caught:
+        _warnings.simplefilter("always")
+        try:
+            crs.to_proj4()
+        except CRSError:
+            pass
+    assert not any(
+        issubclass(rec.category, FutureWarning) for rec in caught
+    ), "FutureWarning should not be emitted on to_proj4 conversion failure"
+
+
+def test_to_proj4_valid_crs_returns_string():
+    crs = CRS.from_epsg(4326)
+    with pytest.warns(UserWarning):
+        result = crs.to_proj4()
+    assert isinstance(result, str)
+    assert "+proj=longlat" in result
