@@ -0,0 +1,247 @@
+
+
+from __future__ import annotations
+
+import copy
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from hazm import Lemmatizer
+from hazm import default_verbs
+from hazm import default_words
+
+
+FIXTURES = Path("/workspace/repo/usercase-test-coderl/fixtures")
+
+
+@pytest.fixture(scope="module")
+def default_lemmatizer() -> Lemmatizer:
+    return Lemmatizer(
+        words_file=default_words,
+        verbs_file=default_verbs,
+        joined_verb_parts=True,
+    )
+
+
+def test_default_data_stems_inflected_known_noun(default_lemmatizer: Lemmatizer) -> None:
+
+
+
+    actual = default_lemmatizer.lemmatize("کتاب‌ها")
+
+    assert actual == "کتاب"
+
+
+def test_default_data_preserves_known_word(default_lemmatizer: Lemmatizer) -> None:
+
+
+
+    actual = default_lemmatizer.lemmatize("آتشفشان")
+
+    assert actual == "آتشفشان"
+
+
+def test_default_data_preserves_unknown_unsupported_token(default_lemmatizer: Lemmatizer) -> None:
+
+
+
+    actual = default_lemmatizer.lemmatize("این_توکن_ساختگی_نیست")
+
+    assert actual == "این_توکن_ساختگی_نیست"
+
+
+def test_default_data_recognizes_present_conjugated_verb(default_lemmatizer: Lemmatizer) -> None:
+
+
+
+    actual = default_lemmatizer.lemmatize("می‌روم")
+
+    assert actual == "رفت#رو"
+
+
+def test_default_data_recognizes_joined_passive_perfect_verb(default_lemmatizer: Lemmatizer) -> None:
+
+
+
+    actual = default_lemmatizer.lemmatize("گفته_شده_است")
+
+    assert actual == "گفت#گو"
+
+
+def test_default_data_recognizes_joined_negative_perfect_verb(default_lemmatizer: Lemmatizer) -> None:
+
+
+
+    actual = default_lemmatizer.lemmatize("نچشیده_است")
+
+    assert actual == "چشید#چش"
+
+
+def test_known_word_with_pos_hint_remains_unchanged(default_lemmatizer: Lemmatizer) -> None:
+
+
+
+    actual = default_lemmatizer.lemmatize("مردم", pos="NOUN")
+
+    assert actual == "مردم"
+
+
+def test_pronoun_pos_hint_remains_unchanged(default_lemmatizer: Lemmatizer) -> None:
+
+
+
+    actual = default_lemmatizer.lemmatize("من", pos="PRON")
+
+    assert actual == "من"
+
+
+def test_adjective_pos_hint_preserves_y_ending_word(default_lemmatizer: Lemmatizer) -> None:
+
+
+
+    actual = default_lemmatizer.lemmatize("اجتماعی", pos="ADJ")
+
+    assert actual == "اجتماعی"
+
+
+def test_verb_pos_hint_uses_verb_lookup(default_lemmatizer: Lemmatizer) -> None:
+
+
+
+    actual = default_lemmatizer.lemmatize("می‌روم", pos="VERB")
+
+    assert actual == "رفت#رو"
+
+
+def test_nonverb_pos_hint_does_not_use_verb_lookup(default_lemmatizer: Lemmatizer) -> None:
+
+
+
+    actual = default_lemmatizer.lemmatize("می‌روم", pos="NOUN")
+
+    assert actual == "می‌روم"
+
+
+def test_custom_files_provide_custom_words_and_verbs() -> None:
+
+
+
+    lemmatizer = Lemmatizer(
+        words_file=FIXTURES / "custom_words.dat",
+        verbs_file=FIXTURES / "custom_verbs.dat",
+        joined_verb_parts=True,
+    )
+
+    assert lemmatizer.lemmatize("خانه‌ها") == "خانه"
+    assert lemmatizer.lemmatize("می‌دوزم") == "دوخت#دوز"
+
+
+def test_custom_joined_verb_parts_are_in_lookup_when_enabled() -> None:
+
+
+
+    lemmatizer = Lemmatizer(
+        words_file=FIXTURES / "custom_words.dat",
+        verbs_file=FIXTURES / "custom_verbs.dat",
+        joined_verb_parts=True,
+    )
+
+    assert lemmatizer.lemmatize("دوخته_است") == "دوخت#دوز"
+    assert lemmatizer.lemmatize("ندوخته_است") == "دوخت#دوز"
+    assert lemmatizer.lemmatize("خواهد_دوخت") == "دوخت#دوز"
+
+
+def test_lookup_is_built_at_initialization_time(tmp_path: Path) -> None:
+
+
+
+    words_path = tmp_path / "words.dat"
+    verbs_path = tmp_path / "verbs.dat"
+    words_path.write_text("دوخت\t10\tV\nدوز\t10\tV\n", encoding="utf-8")
+    verbs_path.write_text("دوخت#دوز\n", encoding="utf-8")
+    lemmatizer = Lemmatizer(
+        words_file=words_path,
+        verbs_file=verbs_path,
+        joined_verb_parts=True,
+    )
+    verbs_path.write_text("بافت#باف\n", encoding="utf-8")
+
+    actual = lemmatizer.lemmatize("می‌دوزم")
+
+    assert actual == "دوخت#دوز"
+
+
+def test_constructor_raises_specific_error_for_missing_words_file() -> None:
+
+    with pytest.raises(Exception):
+        Lemmatizer(
+            words_file=FIXTURES / "missing_words.dat",
+            verbs_file=FIXTURES / "custom_verbs.dat",
+            joined_verb_parts=True,
+        )
+
+
+def test_lemmatize_is_referentially_transparent(default_lemmatizer: Lemmatizer) -> None:
+    first = default_lemmatizer.lemmatize("می‌روم")
+    second = default_lemmatizer.lemmatize("می‌روم")
+
+    assert first == second
+    assert first == "رفت#رو"
+    assert second == "رفت#رو"
+
+
+def test_lemmatize_does_not_mutate_input_token(default_lemmatizer: Lemmatizer) -> None:
+    token = "کتاب‌ها"
+    pos = "NOUN"
+    before = copy.deepcopy((token, pos))
+
+    actual = default_lemmatizer.lemmatize(token, pos=pos)
+
+    assert (token, pos) == before
+    assert actual == "کتاب"
+
+
+def test_same_input_matches_fresh_process_result(default_lemmatizer: Lemmatizer) -> None:
+    in_process = default_lemmatizer.lemmatize("گفته_شده_است")
+    script = (
+        "import sys; "
+        "sys.path.insert(0, '/workspace/repo'); "
+        "from hazm import Lemmatizer, default_words, default_verbs; "
+        "lemmatizer = Lemmatizer(words_file=default_words, verbs_file=default_verbs, joined_verb_parts=True); "
+        "sys.stdout.write(lemmatizer.lemmatize('گفته_شده_است'))"
+    )
+
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+
+    assert in_process == "گفت#گو"
+    assert completed.stdout == "گفت#گو"
+
+
+def test_constructor_and_lemmatize_do_no_undeclared_side_effects(tmp_path: Path) -> None:
+    words_path = tmp_path / "words.dat"
+    verbs_path = tmp_path / "verbs.dat"
+    words_path.write_text("دوخت\t10\tV\nدوز\t10\tV\nخانه\t8\tN\n", encoding="utf-8")
+    verbs_path.write_text("دوخت#دوز\n", encoding="utf-8")
+
+    lemmatizer = Lemmatizer(
+        words_file=words_path,
+        verbs_file=verbs_path,
+        joined_verb_parts=True,
+    )
+    token = "می‌دوزم"
+    before = token
+    first = lemmatizer.lemmatize(token)
+    second = lemmatizer.lemmatize(token)
+
+
+    assert first == "دوخت#دوز"
+    assert second == "دوخت#دوز"
+    assert token == before
