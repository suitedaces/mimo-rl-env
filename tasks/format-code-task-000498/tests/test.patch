+def test_additional_service_error_classes_exist():
+
+
+    from http import HTTPStatus
+
+    from aws_lambda_powertools.event_handler.exceptions import (
+        ForbiddenError,
+        RequestEntityTooLargeError,
+        RequestTimeoutError,
+        ServiceError,
+        ServiceUnavailableError,
+    )
+
+
+    fe = ForbiddenError("forbidden msg")
+    assert isinstance(fe, ServiceError)
+    assert fe.status_code == HTTPStatus.FORBIDDEN
+    assert fe.status_code == 403
+    assert fe.msg == "forbidden msg"
+
+    rte = RequestTimeoutError("timeout msg")
+    assert isinstance(rte, ServiceError)
+    assert rte.status_code == HTTPStatus.REQUEST_TIMEOUT
+    assert rte.status_code == 408
+    assert rte.msg == "timeout msg"
+
+    rel = RequestEntityTooLargeError("too large msg")
+    assert isinstance(rel, ServiceError)
+    assert rel.status_code == HTTPStatus.REQUEST_ENTITY_TOO_LARGE
+    assert rel.status_code == 413
+    assert rel.msg == "too large msg"
+
+    sue = ServiceUnavailableError("unavailable msg")
+    assert isinstance(sue, ServiceError)
+    assert sue.status_code == HTTPStatus.SERVICE_UNAVAILABLE
+    assert sue.status_code == 503
+    assert sue.msg == "unavailable msg"
+
+
+def test_forbidden_error_response(json_dump):
+
+    from aws_lambda_powertools.event_handler.exceptions import ForbiddenError
+
+    app = ApiGatewayResolver()
+
+    @app.get(rule="/forbidden-error")
+    def forbidden_error():
+        raise ForbiddenError("Forbidden")
+
+
+    result = app({"path": "/forbidden-error", "httpMethod": "GET"}, None)
+
+
+    assert result["statusCode"] == 403
+    assert result["multiValueHeaders"]["Content-Type"] == [content_types.APPLICATION_JSON]
+    expected = {"statusCode": 403, "message": "Forbidden"}
+    assert result["body"] == json_dump(expected)
+
+
+def test_request_timeout_error_response(json_dump):
+
+    from aws_lambda_powertools.event_handler.exceptions import RequestTimeoutError
+
+    app = ApiGatewayResolver()
+
+    @app.get(rule="/request-timeout-error")
+    def request_timeout_error():
+        raise RequestTimeoutError("Request timed out")
+
+
+    result = app({"path": "/request-timeout-error", "httpMethod": "GET"}, None)
+
+
+    assert result["statusCode"] == 408
+    assert result["multiValueHeaders"]["Content-Type"] == [content_types.APPLICATION_JSON]
+    expected = {"statusCode": 408, "message": "Request timed out"}
+    assert result["body"] == json_dump(expected)
+
+
+def test_request_entity_too_large_error_response(json_dump):
+
+    from aws_lambda_powertools.event_handler.exceptions import RequestEntityTooLargeError
+
+    app = ApiGatewayResolver()
+
+    @app.get(rule="/payload-too-large-error")
+    def payload_too_large_error():
+        raise RequestEntityTooLargeError("Payload too large")
+
+
+    result = app({"path": "/payload-too-large-error", "httpMethod": "GET"}, None)
+
+
+    assert result["statusCode"] == 413
+    assert result["multiValueHeaders"]["Content-Type"] == [content_types.APPLICATION_JSON]
+    expected = {"statusCode": 413, "message": "Payload too large"}
+    assert result["body"] == json_dump(expected)
+
+
+def test_service_unavailable_error_response(json_dump):
+
+    from aws_lambda_powertools.event_handler.exceptions import ServiceUnavailableError
