diff --git a/packages/zenn-cli/src/server/__tests__/commands/new-article.test.ts b/packages/zenn-cli/src/server/__tests__/commands/new-article.test.ts
index 8002c530..e8993928 100644
--- a/packages/zenn-cli/src/server/__tests__/commands/new-article.test.ts
+++ b/packages/zenn-cli/src/server/__tests__/commands/new-article.test.ts
@@ -92,4 +92,84 @@ describe('cli exec new:article', () => {
       )
     );
   });
+
+
+
+  test('should accept --publication-name option without ARG_UNKNOWN_OPTION error', () => {
+    exec(['--publication-name', 'myPublication']);
+
+    expect(Log.error).not.toHaveBeenCalled();
+  });
+
+  test('should include publication name line in frontmatter when --publication-name is specified', () => {
+    exec(['--publication-name', 'myPublication']);
+    const calls = (helper.generateFileIfNotExist as jest.Mock).mock.calls;
+    expect(calls.length).toBeGreaterThan(0);
+    const fileBody: string = calls[0][1];
+
+
+
+    expect(fileBody).toMatch(/^publication[-_]name:\s*"?myPublication"?\s*$/m);
+  });
+
+  test('should include publication name line BEFORE the closing --- delimiter', () => {
+    exec(['--publication-name', 'myPublication']);
+    const calls = (helper.generateFileIfNotExist as jest.Mock).mock.calls;
+    expect(calls.length).toBeGreaterThan(0);
+    const fileBody: string = calls[0][1];
+    const lines = fileBody.split('\n');
+    const pubIdx = lines.findIndex((l) => /^publication[-_]name:/.test(l));
+    const closingDelimIdx = lines.findIndex(
+      (l, i) => i > 0 && l === '---'
+    );
+    expect(pubIdx).toBeGreaterThan(-1);
+    expect(closingDelimIdx).toBeGreaterThan(pubIdx);
+  });
+
+  test('should NOT include any publication-name/publication_name line when --publication-name is not specified', () => {
+    exec(['--emoji', '💭']);
+    const calls = (helper.generateFileIfNotExist as jest.Mock).mock.calls;
+    expect(calls.length).toBeGreaterThan(0);
+    const fileBody: string = calls[0][1];
+    expect(fileBody).not.toMatch(/publication[-_]name/);
+  });
+
+  test('should NOT include publication-name line when --publication-name is empty string', () => {
+    exec(['--publication-name', '']);
+    const calls = (helper.generateFileIfNotExist as jest.Mock).mock.calls;
+    expect(calls.length).toBeGreaterThan(0);
+    const fileBody: string = calls[0][1];
+    expect(fileBody).not.toMatch(/publication[-_]name/);
+  });
+
+  test('should preserve other frontmatter fields when --publication-name is specified', () => {
+    exec([
+      '--publication-name',
+      'myPublication',
+      '--title',
+      'Hello',
+      '--published',
+      'true',
+      '--emoji',
+      '🔥',
+    ]);
+    const calls = (helper.generateFileIfNotExist as jest.Mock).mock.calls;
+    expect(calls.length).toBeGreaterThan(0);
+    const fileBody: string = calls[0][1];
+    expect(fileBody).toMatch(/^title: "Hello"$/m);
+    expect(fileBody).toMatch(/^emoji: "🔥"$/m);
+    expect(fileBody).toMatch(/^type: "tech"/m);
+    expect(fileBody).toMatch(/^published: true$/m);
+    expect(fileBody).toMatch(/^publication[-_]name:\s*"?myPublication"?\s*$/m);
+  });
+
+  test('should call Log.created (not error) when --publication-name is specified with valid args', () => {
+    const createdSpy = jest.spyOn(Log, 'created').mockImplementation();
+    exec(['--publication-name', 'myPublication', '--slug', 'example-article']);
+    expect(createdSpy).toHaveBeenCalledWith(
+      expect.stringContaining('articles/example-article.md')
+    );
+    expect(Log.error).not.toHaveBeenCalled();
+    createdSpy.mockRestore();
+  });
 });
