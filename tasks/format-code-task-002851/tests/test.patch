diff --git a/tests/dialects/test_clickhouse.py b/tests/dialects/test_clickhouse.py
index 58f23b202..444347c2f 100644
--- a/tests/dialects/test_clickhouse.py
+++ b/tests/dialects/test_clickhouse.py
@@ -62,6 +62,57 @@ class TestClickhouse(Validator):
             write={"clickhouse": "SELECT position(haystack, needle)"},
         )
 
+    def test_ternary(self):
+        import sqlglot
+        from sqlglot import exp
+
+        def assert_ternary(sql, cond_sql, true_sql, false_sql):
+
+            expr = sqlglot.parse_one(sql, read="clickhouse")
+
+
+            self.assertIsInstance(expr, exp.If)
+            self.assertEqual(expr.this.sql(dialect="clickhouse"), cond_sql)
+            self.assertEqual(expr.args["true"].sql(dialect="clickhouse"), true_sql)
+            self.assertIsNotNone(expr.args.get("false"))
+            self.assertEqual(expr.args["false"].sql(dialect="clickhouse"), false_sql)
+
+            regenerated = expr.sql(dialect="clickhouse")
+            reparsed = sqlglot.parse_one(regenerated, read="clickhouse")
+            self.assertEqual(
+                reparsed.sql(dialect="clickhouse"),
+                regenerated,
+            )
+
+
+        assert_ternary("flagcolumn ? created : now()", "flagcolumn", "created", "now()")
+
+
+        assert_ternary("a ? b : c", "a", "b", "c")
+
+
+        assert_ternary("a > 1 ? b : c", "a > 1", "b", "c")
+
+
+        assert_ternary("a ? b + 1 : c - 1", "a", "b + 1", "c - 1")
+
+
+        assert_ternary("a AND b ? c : d", "a AND b", "c", "d")
+
+
+
+        select = sqlglot.parse_one("SELECT a ? b : c FROM t", read="clickhouse")
+        select_exprs = select.args.get("expressions") or []
+        self.assertEqual(len(select_exprs), 1)
+        inner = select_exprs[0]
+        self.assertIsInstance(inner, exp.If)
+
+        regenerated = select.sql(dialect="clickhouse")
+        self.assertEqual(
+            sqlglot.parse_one(regenerated, read="clickhouse").sql(dialect="clickhouse"),
+            regenerated,
+        )
+
     def test_cte(self):
