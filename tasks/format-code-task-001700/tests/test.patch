@@ -0,0 +1,188 @@
+package v1beta1
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"knative.dev/pkg/apis"
+	duckv1 "knative.dev/pkg/apis/duck/v1"
+)
+
+var _ *duckv1.KReference = (&BrokerSpec{}).Config
+
+func validConfigRef(ns string) *duckv1.KReference {
+	return &duckv1.KReference{
+		Namespace:  ns,
+		Name:       "config",
+		Kind:       "ConfigMap",
+		APIVersion: "v1",
+	}
+}
+
+func validateBroker(b *Broker) *apis.FieldError {
+	return b.Validate(context.Background())
+}
+
+func TestBrokerConfigValidationMissingRequiredFields(t *testing.T) {
+	tests := []struct {
+		name   string
+		mutate func(*duckv1.KReference)
+		want   string
+	}{{
+		name:   "missing name",
+		mutate: func(ref *duckv1.KReference) { ref.Name = "" },
+		want:   "spec.config.name",
+	}, {
+		name:   "missing apiVersion",
+		mutate: func(ref *duckv1.KReference) { ref.APIVersion = "" },
+		want:   "spec.config.apiVersion",
+	}, {
+		name:   "missing kind",
+		mutate: func(ref *duckv1.KReference) { ref.Kind = "" },
+		want:   "spec.config.kind",
+	}}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			ref := validConfigRef("parent-a")
+			test.mutate(ref)
+			b := &Broker{
+				ObjectMeta: metav1.ObjectMeta{Namespace: "parent-a"},
+				Spec:       BrokerSpec{Config: ref},
+			}
+			got := validateBroker(b)
+			if got == nil {
+				t.Fatalf("Validate() = nil, want missing-field error at %q", test.want)
+			}
+			if got.Error() != apis.ErrMissingField(test.want).Error() {
+				t.Fatalf("Validate() = %q, want missing-field error at %q", got, test.want)
+			}
+		})
+	}
+}
+
+func TestBrokerConfigValidationAllowsEmptyNamespace(t *testing.T) {
+	b := &Broker{
+		ObjectMeta: metav1.ObjectMeta{Namespace: "broker-ns"},
+		Spec:       BrokerSpec{Config: validConfigRef("")},
+	}
+
+	if got := validateBroker(b); got != nil {
+		t.Fatalf("Validate() = %q, want empty namespace in config reference to be allowed", got)
+	}
+}
+
+func TestBrokerConfigValidationRejectsMismatchedNamespace(t *testing.T) {
+	tests := []struct {
+		parentNS string
+		refNS    string
+	}{{
+		parentNS: "parent-ns",
+		refNS:    "ref-ns",
+	}, {
+		parentNS: "alpha",
+		refNS:    "beta",
+	}}
+
+	for _, test := range tests {
+		t.Run(test.parentNS+"_to_"+test.refNS, func(t *testing.T) {
+			b := &Broker{
+				ObjectMeta: metav1.ObjectMeta{Namespace: test.parentNS},
+				Spec:       BrokerSpec{Config: validConfigRef(test.refNS)},
+			}
+
+			got := validateBroker(b)
+			if got == nil {
+				t.Fatal("Validate() = nil, want namespace mismatch error")
+			}
+			if !hasFieldErrorPath(got, "spec.config.namespace") {
+				t.Fatalf("Validate() = %#v, want error path spec.config.namespace", got)
+			}
+			if !fieldErrorDetailsContain(got, test.parentNS, test.refNS) {
+				t.Fatalf("Validate() = %#v, want details to include parent namespace %q and ref namespace %q", got, test.parentNS, test.refNS)
+			}
+		})
+	}
+}
+
+func TestBrokerConfigValidationAllowsMatchingNamespace(t *testing.T) {
+	for _, ns := range []string{"same-ns", "tenant-a"} {
+		t.Run(ns, func(t *testing.T) {
+			b := &Broker{
+				ObjectMeta: metav1.ObjectMeta{Namespace: ns},
+				Spec:       BrokerSpec{Config: validConfigRef(ns)},
+			}
+
+			if got := validateBroker(b); got != nil {
+				t.Fatalf("Validate() = %q, want matching broker/config namespace %q to be allowed", got, ns)
+			}
+		})
+	}
+}
+
+func hasFieldErrorPath(fe *apis.FieldError, path string) bool {
+	if fe == nil {
+		return false
+	}
+	for _, got := range fe.Paths {
+		if got == path {
+			return true
+		}
+	}
+	return strings.Contains(fe.Error(), path)
+}
+
+func fieldErrorDetailsContain(fe *apis.FieldError, values ...string) bool {
+	if fe == nil {
+		return false
+	}
+	got := fe.Details
+	if got == "" {
+		got = fe.Error()
+	}
+	for _, value := range values {
+		if !strings.Contains(got, value) {
+			return false
+		}
+	}
+	return true
+}
+
+func TestBrokerConfigKReferenceDeepCopy(t *testing.T) {
+	original := &Broker{
+		ObjectMeta: metav1.ObjectMeta{Namespace: "copy-ns"},
+		Spec:       BrokerSpec{Config: validConfigRef("copy-ns")},
+	}
+
+	copied := original.DeepCopy()
+	if copied.Spec.Config == nil || copied.Spec.Config.Name != original.Spec.Config.Name || copied.Spec.Config.Namespace != original.Spec.Config.Namespace {
+		t.Fatalf("DeepCopy() config = %#v, want copied public KReference fields from %#v", copied.Spec.Config, original.Spec.Config)
+	}
+
+	copied.Spec.Config.Name = "changed"
+	if original.Spec.Config.Name == copied.Spec.Config.Name {
+		t.Fatalf("DeepCopy() aliased config: original name changed to %q", original.Spec.Config.Name)
+	}
+}
+
+func TestBrokerConfigJSONUsesConfigField(t *testing.T) {
+	b := &Broker{
+		ObjectMeta: metav1.ObjectMeta{Namespace: "json-ns"},
+		Spec:       BrokerSpec{Config: validConfigRef("json-ns")},
+	}
+
+	got, err := json.Marshal(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded := string(got)
+	if !strings.Contains(encoded, `"config":`) {
+		t.Fatalf("Marshal() = %s, want spec.config field to be serialized as config", encoded)
+	}
+	if strings.Contains(encoded, `"configuration":`) {
+		t.Fatalf("Marshal() = %s, config reference serialized under unexpected field name", encoded)
+	}
+}
