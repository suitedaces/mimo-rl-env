diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,30 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+export GOPATH=/root/go
+mkdir -p "$GOPATH/src/knative.dev"
+ln -sfn /testbed "$GOPATH/src/knative.dev/eventing"
+
+
+export GO111MODULE=off
+export PATH="/opt/go-1.24/bin:$PATH"
+
+
+cd "$GOPATH/src/knative.dev/eventing"
+
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 ./pkg/apis/eventing/v1beta1/ -run 'TestValidate|TestValidSpec|TestBrokerImmutableFields'
+    ;;
+  new)
+    go test -v -count=1 ./pkg/apis/eventing/v1beta1/ -run 'TestBrokerConfigValidationMissingRequiredFields|TestBrokerConfigValidationAllowsEmptyNamespace|TestBrokerConfigValidationRejectsMismatchedNamespace|TestBrokerConfigValidationAllowsMatchingNamespace|TestBrokerConfigKReferenceDeepCopy|TestBrokerConfigJSONUsesConfigField'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
