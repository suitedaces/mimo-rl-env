diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,16 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test -v -race -count=1 -timeout 5m ./tests/integration/view/one_to_many/ -run '^(TestView_OneToMany|TestView_OneToManyWithMixedSDL_Errors|TestView_OneToManyFromInnerSide_Errors|TestView_OneToManyOuterToInnerToOuter_Errors|TestView_OneToManyWithRelationInQueryButNotInSDL|TestView_OneToManyMultipleViewsWithEmbeddedSchema)$'
+    ;;
+  new)
+    go test -v -race -count=1 -timeout 5m ./tests/integration/view/one_to_many/ -run '^(TestView_OneToManyWithDoubleSidedRelation_Errors|TestView_OneToManyWithDoubleSidedRelation_AlternateNames_Errors|TestView_OneToManyWithSingleSidedRelation_Succeeds|TestView_OneToOneWithDoubleSidedRelation_Errors)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
