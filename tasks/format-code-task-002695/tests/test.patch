+						stories {
+							title
+						}
+					}
+				`,
+				SDL: `
+					type WriterResult {
+						displayName: String
+						stories: [StoryResult]
+					}
+					interface StoryResult {
+						title: String
+						writtenBy: WriterResult
+					}
+				`,
+
+				ExpectedErrorAlternatives: []string{
+					"relations in views must only be defined on one schema. Field: stories, Type: StoryResult",
+					"relations in views must only be defined on one schema. Field: writtenBy, Type: WriterResult",
+				},
+			},
+		},
+	}
