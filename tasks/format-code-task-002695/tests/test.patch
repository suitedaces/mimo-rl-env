+
+func TestView_OneToManyWithDoubleSidedRelation_Errors(t *testing.T) {
+	test := testUtils.TestCase{
+		Description: "Double-sided relations between view result types are rejected",
+		Actions: []any{
+			testUtils.SchemaUpdate{
+				Schema: `
+					type Author {
+						name: String
+						books: [Book]
+					}
+					type Book {
+						name: String
+						author: Author
+					}
+				`,
+			},
+			testUtils.CreateView{
+				Query: `
+					Author {
+						name
+						books {
+							name
+						}
+					}
+				`,
+				SDL: `
+					type AuthorView {
+						name: String
+						books: [BookView]
+					}
+					interface BookView {
+						name: String
+						author: AuthorView
+					}
+				`,
+
+				ExpectedErrorAlternatives: []string{
+					"relations in views must only be defined on one schema. Field: books, Type: BookView",
+					"relations in views must only be defined on one schema. Field: author, Type: AuthorView",
+				},
+			},
+		},
+	}
+
+	testUtils.ExecuteTestCase(t, test)
+}
+
+func TestView_OneToManyWithDoubleSidedRelation_AlternateNames_Errors(t *testing.T) {
+	test := testUtils.TestCase{
+		Description: "Double-sided view relations are rejected for non-example names",
+		Actions: []any{
+			testUtils.SchemaUpdate{
+				Schema: `
