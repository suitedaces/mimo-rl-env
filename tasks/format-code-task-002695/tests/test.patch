+func AssertErrorEqualsAny(err error, expectedErrors []string) bool {
+	if err == nil {
+		return false
+	}
+
+	for _, expectedError := range expectedErrors {
+		if err.Error() == expectedError {
+			return true
+		}
+	}
+	return false
+}
+
+func assertExpectedAnyErrorRaised(t *testing.T, description string, expectedErrors []string, wasRaised bool) {
+	if len(expectedErrors) != 0 && !wasRaised {
+		assert.Fail(t, "Expected one of the acceptable errors however none was raised.", description)
+	}
+}
