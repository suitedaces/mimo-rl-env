+class TestStyleSheets(object):
+    def _leaf_shapes(self, node):
+        children = getattr(node, 'contents', None)
+        if children:
+            for child in children:
+                for leaf in self._leaf_shapes(child):
+                    yield leaf
+        else:
+            yield node
+
+    def test_style_rules_apply_to_id_class_and_element_selectors(self):
+        drawing = svglib.svg2rlg(io.StringIO(textwrap.dedent(u'''\
+            <?xml version="1.0"?>
+            <svg width="120" height="80" xml:space="preserve">
+              <defs>
+                <style type="text/css">
+                  #idStyled { fill: rgb(255, 0, 0); }
+                  .wideStroke { stroke: rgb(0, 0, 255); stroke-width: 2.5; }
+                  rect { fill: rgb(0, 128, 0); }
+                </style>
+              </defs>
+              <g>
+                <path id="idStyled" d="M 0 0 H 20 V 20 H 0 Z"/>
+                <path class="wideStroke" d="M 30 0 H 55 V 20 H 30 Z"/>
+                <rect x="65" y="0" width="20" height="20"/>
+              </g>
+            </svg>
+        ''')))
+
+        shapes = list(self._leaf_shapes(drawing))
+        stylesheet_green = colors.Color(0, 128 / 255.0, 0)
+
+        assert any(getattr(shape, 'fillColor', None) == colors.red
+                   for shape in shapes)
+        assert any(getattr(shape, 'strokeColor', None) == colors.blue
+                   for shape in shapes)
+        assert any(abs(getattr(shape, 'strokeWidth', 0) - 2.5) < 1e-9
+                   for shape in shapes)
+        assert any(getattr(shape, 'fillColor', None) == stylesheet_green
+                   for shape in shapes)
+
+    def test_explicit_presentation_attributes_override_stylesheet_rules(self):
+        drawing = svglib.svg2rlg(io.StringIO(textwrap.dedent(u'''\
+            <?xml version="1.0"?>
+            <svg width="80" height="40" xml:space="preserve">
+              <style type="text/css">
+                .conflictRule {
+                  fill: rgb(255, 0, 0);
+                  stroke-width: 9;
+                  stroke: rgb(0, 128, 0);
+                }
+              </style>
+              <path class="conflictRule"
+                    fill="blue"
+                    stroke-width="1"
+                    d="M 0 0 H 30 V 30 H 0 Z"/>
+            </svg>
+        ''')))
+
+        shapes = list(self._leaf_shapes(drawing))
+        stylesheet_green = colors.Color(0, 128 / 255.0, 0)
+        conflicted_shapes = [
+            shape for shape in shapes
+            if getattr(shape, 'strokeColor', None) == stylesheet_green
+        ]
+
+        assert conflicted_shapes
+        assert any(shape.fillColor == colors.blue for shape in conflicted_shapes)
+        assert any(abs(shape.strokeWidth - 1) < 1e-9
+                   for shape in conflicted_shapes)
+
