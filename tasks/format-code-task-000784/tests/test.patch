@@ -0,0 +1,21 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    python3 -m pytest tests/test_basic.py -v \
+      --ignore=tests/test_readme.py \
+      -k 'not TestStyleSheets' 2>&1
+    ;;
+  new)
+    python3 -m pytest -v \
+      tests/test_basic.py::TestStyleSheets::test_style_rules_apply_to_id_class_and_element_selectors \
+      tests/test_basic.py::TestStyleSheets::test_explicit_presentation_attributes_override_stylesheet_rules \
+      tests/test_readme.py::test_readme_describes_stylesheet_support_as_experimental 2>&1
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
