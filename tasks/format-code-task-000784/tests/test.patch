index 0000000..93cf624
--- /dev/null
+++ b/tests/test_readme.py
@@ -0,0 +1,12 @@
+import os
+
+
+def test_readme_describes_stylesheet_support_as_experimental():
+    root_dir = os.path.dirname(os.path.dirname(__file__))
+    with open(os.path.join(root_dir, 'README.rst'), encoding='utf-8') as readme:
+        contents = readme.read().lower()
+
+    assert 'stylesheets are not supported' not in contents
+    assert 'stylesheet' in contents or 'stylesheets' in contents
+    assert 'experimental' in contents
+    assert any(word in contents for word in ('bug', 'shortcoming', 'issue', 'tracker'))
