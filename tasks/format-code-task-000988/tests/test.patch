+	"volcano.sh/volcano/pkg/scheduler/conf"
+	"volcano.sh/volcano/pkg/scheduler/framework"
+	"volcano.sh/volcano/pkg/scheduler/util"
+)
+
+const codeSpecRejectingScorerName = "codespec-rejecting-scorer"
+
+type codeSpecRejectingScorer struct{}
+
+func (p *codeSpecRejectingScorer) Name() string { return codeSpecRejectingScorerName }
+
+func (p *codeSpecRejectingScorer) OnSessionOpen(ssn *framework.Session) {
+	ssn.AddNodeOrderFn(p.Name(), func(_ *api.TaskInfo, _ *api.NodeInfo) (float64, error) {
+		return 0, errors.New("scoring backend unavailable")
+	})
+}
+
+func (p *codeSpecRejectingScorer) OnSessionClose(_ *framework.Session) {}
+
+type codeSpecRecordingBinder struct {
+	sync.Mutex
+	binds map[string]string
+}
+
+func (b *codeSpecRecordingBinder) Bind(pod *v1.Pod, hostname string) error {
+	b.Lock()
+	defer b.Unlock()
+	b.binds[pod.Namespace+"/"+pod.Name] = hostname
+	return nil
+}
+
+func (b *codeSpecRecordingBinder) count() int {
+	b.Lock()
+	defer b.Unlock()
+	return len(b.binds)
+}
+
+func TestCodeSpecAllocateLeavesTaskPendingWhenScoringRejectsEveryNode(t *testing.T) {
+	framework.RegisterPluginBuilder(codeSpecRejectingScorerName, func(framework.Arguments) framework.Plugin {
+		return &codeSpecRejectingScorer{}
+	})
+	defer framework.CleanupPluginBuilders()
+
+	options.ServerOpts = &options.ServerOption{
+		MinNodesToFind:             100,
+		MinPercentageOfNodesToFind: 5,
+		PercentageOfNodesToFind:    100,
+	}
+
+	binder := &codeSpecRecordingBinder{binds: map[string]string{}}
+	schedulerCache := &cache.SchedulerCache{
+		Nodes:         make(map[string]*api.NodeInfo),
+		Jobs:          make(map[api.JobID]*api.JobInfo),
+		Queues:        make(map[api.QueueID]*api.QueueInfo),
+		Binder:        binder,
+		StatusUpdater: &util.FakeStatusUpdater{},
+		VolumeBinder:  &util.FakeVolumeBinder{},
+		Recorder:      record.NewFakeRecorder(10),
+	}
+
+	schedulerCache.AddNode(util.BuildNode("only-node", util.BuildResourceList("4", "8Gi"), nil))
+	pod := util.BuildPod("codespec", "pending-task", "", v1.PodPending,
+		util.BuildResourceList("1", "1Gi"), "scoring-job", nil, nil)
+	pod.Annotations[schedulingv1.NumaPolicyKey] = "single-numa-node"
+	schedulerCache.AddPod(pod)
+	schedulerCache.AddPodGroupV1beta1(&schedulingv1.PodGroup{
+		ObjectMeta: metav1.ObjectMeta{Name: "scoring-job", Namespace: "codespec"},
+		Spec: schedulingv1.PodGroupSpec{
+			Queue: "codespec-queue",
+		},
+		Status: schedulingv1.PodGroupStatus{Phase: schedulingv1.PodGroupInqueue},
+	})
+	schedulerCache.AddQueueV1beta1(&schedulingv1.Queue{
+		ObjectMeta: metav1.ObjectMeta{Name: "codespec-queue"},
+		Spec:       schedulingv1.QueueSpec{Weight: 1},
+	})
+
+	enabled := true
+	ssn := framework.OpenSession(schedulerCache, []conf.Tier{{Plugins: []conf.PluginOption{{
+		Name:             codeSpecRejectingScorerName,
+		EnabledNodeOrder: &enabled,
+	}}}}, nil)
+	defer framework.CloseSession(ssn)
+
+	New().Execute(ssn)
+
+	if got := binder.count(); got != 0 {
+		t.Errorf("expected no binding when every node score failed, got %d", got)
+	}
+	job := ssn.Jobs[api.JobID("codespec/scoring-job")]
+	if job == nil || len(job.TaskStatusIndex[api.Pending]) != 1 {
+		t.Fatalf("task must remain pending after scoring failure, job state: %#v", job)
+	}
+}
diff --git a/pkg/scheduler/util/codespec_node_scoring_test.go b/pkg/scheduler/util/codespec_node_scoring_test.go
