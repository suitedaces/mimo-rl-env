diff --git a/usercase-test-coderl/test_bigbench_adapter.py b/usercase-test-coderl/test_bigbench_adapter.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_bigbench_adapter.py
@@ -0,0 +1,186 @@
+import os
+
+import pytest
+
+from tasks import get_task
+
+
+FIXTURES = "/workspace/repo/usercase-test-coderl/fixtures"
+
+def _make_task(filename, train_size=2, eval_size=2):
+    CustomTask = get_task("bigbench")
+    assert CustomTask.__name__ == "CustomTask"
+    return CustomTask(
+        train_size,
+        eval_size,
+        task_name="bigbench",
+        task_description="task from bigbench",
+        data_dir=os.path.join(FIXTURES, filename),
+        seed=None,
+        post_instruction=True,
+        option_num=5,
+    )
+
+
+def test_get_task_constructs_prefixed_bigbench_examples():
+
+
+
+
+    task = _make_task("bigbench_shapes.json")
+
+    assert task.task_name == "bigbench"
+    assert task.task_description == "Pick a shape"
+    assert task.option_num == 3
+    assert len(task.train_size) == 2
+    assert len(task.eval_size) == 2
+    assert len(task.test_size) == 2
+    assert task.dataset == {
+        "train": [
+            {
+                "question": "Choose the best answer.\nWhat shape has three sides?\nOptions:\n(A) circle\n(B) triangle\n(C) square\n",
+                "answer": "B",
+            },
+            {
+                "question": "Choose the best answer.\nWhat shape is round?\nOptions:\n(A) circle\n(B) triangle\n(C) square\n",
+                "answer": "A",
+            },
+        ],
+        "eval": [
+            {
+                "question": "Choose the best answer.\nWhat shape has three sides?\nOptions:\n(A) circle\n(B) triangle\n(C) square\n",
+                "answer": "B",
+            },
+            {
+                "question": "Choose the best answer.\nWhat shape is round?\nOptions:\n(A) circle\n(B) triangle\n(C) square\n",
+                "answer": "A",
+            },
+        ],
+        "test": [
+            {
+                "question": "Choose the best answer.\nWhat shape has three sides?\nOptions:\n(A) circle\n(B) triangle\n(C) square\n",
+                "answer": "B",
+            },
+            {
+                "question": "Choose the best answer.\nWhat shape is round?\nOptions:\n(A) circle\n(B) triangle\n(C) square\n",
+                "answer": "A",
+            },
+        ],
+    }
+
+
+def test_formats_examples_without_task_prefix():
+
+
+
+
+    task = _make_task("bigbench_shapes_no_prefix.json")
+
+    assert task.task_description == "Pick a shape"
+    assert task.option_num == 3
+    assert task.dataset["train"] == [
+        {
+            "question": "What shape has three sides?\nOptions:\n(A) circle\n(B) triangle\n(C) square\n",
+            "answer": "B",
+        },
+        {
+            "question": "What shape is round?\nOptions:\n(A) circle\n(B) triangle\n(C) square\n",
+            "answer": "A",
+        },
+    ]
+
+
+def test_option_num_uses_largest_target_scores_example():
+
+
+
+
+    task = _make_task("bigbench_mixed_options.json")
+
+    assert task.task_description == "Pick an object"
+    assert task.option_num == 4
+    assert task.dataset["train"] == [
+        {
+            "question": "Choose the best answer.\nWhich object is used for writing?\nOptions:\n(A) pen\n(B) cup\n",
+            "answer": "A",
+        },
+        {
+            "question": "Choose the best answer.\nWhich object tells time?\nOptions:\n(A) spoon\n(B) clock\n(C) blanket\n(D) lamp\n",
+            "answer": "B",
+        },
+    ]
+    assert task.clean_response("<answer>(D)</answer>") == "D"
+    assert task.clean_response("<answer>d</answer>") == "D"
+    assert task.clean_response("<answer>E</answer>") == "N/A: Format error"
+
+
+def test_clean_response_parses_tags_fallbacks_and_format_errors():
+
+
+
+
+    task = _make_task("bigbench_shapes.json")
+
+    assert task.clean_response("<answer>(B)</answer>") == "B"
+    assert task.clean_response("<answer>b</answer>") == "B"
+    assert task.clean_response("I choose triangle") == "B"
+    assert task.clean_response("<answer></answer>") == "N/A: Format error"
+    assert task.clean_response("<answer>Z</answer>") == "N/A: Format error"
+    assert task.clean_response("No known option here") == "N/A: Format error"
+
+
+def test_instances_keep_option_text_fallbacks_independent():
+
+
+
+
+    shapes = _make_task("bigbench_shapes.json")
+    colors = _make_task("bigbench_colors.json")
+
+    assert shapes.task_description == "Pick a shape"
+    assert shapes.option_num == 3
+    assert shapes.clean_response("I choose triangle") == "B"
+    assert shapes.clean_response("I choose blue") == "N/A: Format error"
+    assert colors.task_description == "Pick a color"
+    assert colors.option_num == 4
+    assert colors.clean_response("I choose triangle") == "N/A: Format error"
+    assert colors.clean_response("I choose blue") == "B"
+
+
+def test_missing_bigbench_json_reports_failure():
+
+
+
+
+    CustomTask = get_task("bigbench")
+
+
+    with pytest.raises(Exception):
+        CustomTask(
+            1,
+            1,
+            data_dir=os.path.join(FIXTURES, "missing.json"),
+            seed=None,
+            post_instruction=True,
+            option_num=5,
+        )
+
+
+def test_repeated_construct_parse_drop_cycles_keep_fallback_maps_independent():
+
+
+
+
+    for _ in range(25):
+        shapes = _make_task("bigbench_shapes.json")
+        colors = _make_task("bigbench_colors.json")
+
+
+
+        assert shapes.clean_response("I choose triangle") == "B"
+        assert shapes.clean_response("I choose blue") == "N/A: Format error"
+        assert colors.clean_response("I choose blue") == "B"
+        assert colors.clean_response("I choose triangle") == "N/A: Format error"
+
+        del shapes
+        del colors
