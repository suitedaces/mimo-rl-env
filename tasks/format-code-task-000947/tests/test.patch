diff --git a/spec/ffi/pointer_spec.rb b/spec/ffi/pointer_spec.rb
index f75d28d..f49a69c 100644
--- a/spec/ffi/pointer_spec.rb
+++ b/spec/ffi/pointer_spec.rb
@@ -233,10 +233,24 @@ describe "Pointer" do
       expect(FFI::Pointer.new(0).size_limit?).to be false
     end
 
+    it "is available on memory pointers" do
+      memory_pointer = FFI::MemoryPointer.new(:int, 10)
+
+      expect(memory_pointer).to respond_to(:size_limit?)
+      expect { memory_pointer.size_limit? }.not_to raise_error
+      expect([true, false]).to include(memory_pointer.size_limit?)
+    end
+
+    it "returns true for bounded memory pointers" do
+      expect(FFI::MemoryPointer.new(:int, 10).size_limit?).to be true
+      expect(FFI::MemoryPointer.new(:char, 4).size_limit?).to be true
+      expect(FFI::Buffer.new(:int, 2).size_limit?).to be true
+    end
+
     it "should have size limit" do
       expect(FFI::Pointer.new(0).slice(0, 10).size_limit?).to be true
     end
-  end if RUBY_ENGINE != "truffleruby"
+  end
 end
 
