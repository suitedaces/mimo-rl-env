+func TestExtendedPath_PreservesTrailingSlash(t *testing.T) {
+	t.Parallel()
+
+	cases := []struct {
+		name        string
+		startingURL string
+		path        string
+		expectedURL string
+	}{
+		{
+			"empty string extPath preserves trailing slash",
+			"http://example.com/foo/",
+			`""`,
+			"http://example.com/foo/",
+		},
+		{
+			"nil extPath preserves trailing slash",
+			"http://example.com/foo/",
+			"",
+			"http://example.com/foo/",
+		},
+		{
+			"nasa-style URL with query params and empty extPath",
+			"https://api.nasa.gov/insight_weather/?api_key=eTitgeQIgcVYEqKbEfToPyG1r1GVVbaV4SKC7vwe&feedtype=json&ver=1.0",
+			`""`,
+			"https://api.nasa.gov/insight_weather/?api_key=eTitgeQIgcVYEqKbEfToPyG1r1GVVbaV4SKC7vwe&feedtype=json&ver=1.0",
+		},
+		{
+			"nasa-style URL with query params and nil extPath",
+			"https://api.nasa.gov/insight_weather/?api_key=eTitgeQIgcVYEqKbEfToPyG1r1GVVbaV4SKC7vwe&feedtype=json&ver=1.0",
+			"",
+			"https://api.nasa.gov/insight_weather/?api_key=eTitgeQIgcVYEqKbEfToPyG1r1GVVbaV4SKC7vwe&feedtype=json&ver=1.0",
+		},
+		{
+			"trailing slash with non-empty extPath appends without double slash",
+			"http://example.com/foo/",
+			`"bar"`,
+			"http://example.com/foo/bar",
+		},
+		{
+			"no trailing slash with non-empty extPath inserts slash",
+			"http://example.com/foo",
+			`"bar"`,
+			"http://example.com/foo/bar",
+		},
+	}
+
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			ep := adapters.ExtendedPath{}
+			if test.path != "" {
+				err := json.Unmarshal([]byte(test.path), &ep)
+				require.NoError(t, err)
+			}
+			hga := adapters.HTTPGet{
+				URL:          cltest.WebURL(t, test.startingURL),
+				ExtendedPath: ep,
+			}
+			hpa := adapters.HTTPPost{
+				URL:          cltest.WebURL(t, test.startingURL),
+				ExtendedPath: ep,
+			}
+			requestGET, err := hga.GetRequest()
+			require.NoError(t, err)
+			assert.Equal(t, test.expectedURL, requestGET.URL.String())
+			requestPOST, err := hpa.GetRequest("")
+			require.NoError(t, err)
+			assert.Equal(t, test.expectedURL, requestPOST.URL.String())
+		})
+	}
+}
