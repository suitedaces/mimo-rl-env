+func TestFormOnlyMethodsPostAndDecodeTypedResults(t *testing.T) {
+
+
+	var mu sync.Mutex
+	seen := make([]string, 0, 2)
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := ioutil.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("read body: %v", err)
+		}
+		if err := r.Body.Close(); err != nil {
+			t.Fatalf("close request body: %v", err)
+		}
+
+		mu.Lock()
+		defer mu.Unlock()
+		switch len(seen) {
+		case 0:
+			assertString(t, "getMe method", r.Method, "POST")
+			assertString(t, "getMe path", r.URL.Path, "/botTOKEN/getMe")
+
+			assertFormContentType(t, "getMe content-type", r.Header.Get("Content-Type"), true)
+			assertString(t, "getMe body", string(body), "")
+			seen = append(seen, "getMe")
+			fmt.Fprint(w, `{"ok":true,"result":{"id":1,"is_bot":true,"first_name":"Bot"}}`)
+		case 1:
+			assertString(t, "sendMessage method", r.Method, "POST")
+			assertString(t, "sendMessage path", r.URL.Path, "/botTOKEN/sendMessage")
+
+			assertFormContentType(t, "sendMessage content-type", r.Header.Get("Content-Type"), false)
+
+			assertURLEncodedBody(t, "sendMessage body", string(body), map[string]string{
+				"chat_id": "123",
+				"text":    "hello",
+			})
+			seen = append(seen, "sendMessage")
+			fmt.Fprint(w, `{"ok":true,"result":{"message_id":7,"chat":{"id":123},"text":"hello"}}`)
+		default:
+			t.Fatalf("unexpected extra request %d to %s", len(seen)+1, r.URL.Path)
+		}
+	}))
+	defer server.Close()
+
+	client := tbot.NewClient(token, server.Client(), server.URL)
+
+	me, err := client.GetMe()
+	if err != nil {
+		t.Fatalf("GetMe error = %v", err)
+	}
+	assertInt(t, "GetMe ID", me.ID, 1)
+	assertBool(t, "GetMe IsBot", me.IsBot, true)
+	assertString(t, "GetMe FirstName", me.FirstName, "Bot")
+
+	msg, err := client.SendMessage("123", "hello")
+	if err != nil {
+		t.Fatalf("SendMessage error = %v", err)
+	}
+	assertInt(t, "SendMessage MessageID", msg.MessageID, 7)
+	assertString(t, "SendMessage Chat.ID", msg.Chat.ID, "123")
+	assertString(t, "SendMessage Text", msg.Text, "hello")
+	assertInt(t, "request count", len(seen), 2)
+}
