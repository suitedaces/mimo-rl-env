+func TestSendPhotoFileStreamsMultipartAndDecodesResult(t *testing.T) {
+
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		assertString(t, "method", r.Method, "POST")
+		assertString(t, "path", r.URL.Path, "/botTOKEN/sendPhoto")
+		mediaType, _, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+		if err != nil {
+			t.Fatalf("parse multipart content-type: %v", err)
+		}
+		assertString(t, "multipart media type", mediaType, "multipart/form-data")
+
+		if err := r.ParseMultipartForm(1024 * 1024); err != nil {
+			t.Fatalf("ParseMultipartForm error = %v", err)
+		}
+		assertString(t, "chat_id field", r.MultipartForm.Value["chat_id"][0], "123")
+
+		file, header, err := r.FormFile("photo")
+		if err != nil {
+			t.Fatalf("FormFile(photo) error = %v", err)
+		}
+		defer file.Close()
+		uploaded, err := ioutil.ReadAll(file)
+		if err != nil {
+			t.Fatalf("read uploaded file: %v", err)
+		}
+		assertString(t, "file field filename", header.Filename, "photo.jpg")
+		assertString(t, "file contents", string(uploaded), "fixture photo fixture\n")
+
+		fmt.Fprint(w, `{"ok":true,"result":{"message_id":8,"chat":{"id":123},"caption":"sent photo"}}`)
+	}))
+	defer server.Close()
+
+	oldWD, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd error = %v", err)
+	}
+	if err := os.Chdir(fixtures); err != nil {
+		t.Fatalf("Chdir fixtures error = %v", err)
+	}
+	defer os.Chdir(oldWD)
+
+	client := tbot.NewClient(token, server.Client(), server.URL)
+	msg, err := client.SendPhotoFile("123", "photo.jpg")
+	if err != nil {
+		t.Fatalf("SendPhotoFile error = %v", err)
+	}
+	assertInt(t, "photo MessageID", msg.MessageID, 8)
+	assertString(t, "photo Chat.ID", msg.Chat.ID, "123")
+	assertString(t, "photo Caption", msg.Caption, "sent photo")
+}
