+func assertString(t *testing.T, label, got, want string) {
+	t.Helper()
+	if got != want {
+		t.Fatalf("%s = %q, want %q", label, got, want)
+	}
+}
+
+func assertFormContentType(t *testing.T, label, got string, allowEmpty bool) {
+	t.Helper()
+	if allowEmpty && got == "" {
+		return
+	}
+	mediaType, _, err := mime.ParseMediaType(got)
+	if err != nil {
+		t.Fatalf("%s parse error = %v", label, err)
+	}
+	if mediaType != "application/x-www-form-urlencoded" {
+		t.Fatalf("%s = %q, want form media type", label, got)
+	}
+}
+
+func assertURLEncodedBody(t *testing.T, label, body string, want map[string]string) {
+	t.Helper()
+	values, err := url.ParseQuery(body)
+	if err != nil {
+		t.Fatalf("%s parse error = %v", label, err)
+	}
+	if len(values) != len(want) {
+		t.Fatalf("%s field count = %d, want %d (%q)", label, len(values), len(want), body)
+	}
+	for key, wantValue := range want {
+		gotValues, ok := values[key]
+		if !ok {
+			t.Fatalf("%s missing field %q in %q", label, key, body)
+		}
+		if len(gotValues) != 1 || gotValues[0] != wantValue {
+			t.Fatalf("%s[%s] = %q, want [%q]", label, key, gotValues, wantValue)
+		}
+	}
+}
+
+func assertNoPartialUser(t *testing.T, label string, user *tbot.User) {
+	t.Helper()
+	if user == nil {
+		return
+	}
+	if user.ID != 0 || user.IsBot || user.FirstName != "" {
+		t.Fatalf("%s = %+v, want nil or zero-value user", label, user)
+	}
+}
+
+func assertNoPartialMessage(t *testing.T, label string, msg *tbot.Message) {
+	t.Helper()
+	if msg == nil {
+		return
+	}
+	if msg.MessageID != 0 || msg.Chat.ID != "" || msg.Text != "" || msg.Caption != "" {
+		t.Fatalf("%s = %+v, want nil or zero-value message", label, msg)
+	}
+}
+
+func assertInt(t *testing.T, label string, got, want int) {
+	t.Helper()
+	if got != want {
+		t.Fatalf("%s = %d, want %d", label, got, want)
+	}
+}
+
+func assertInt64(t *testing.T, label string, got, want int64) {
+	t.Helper()
+	if got != want {
+		t.Fatalf("%s = %d, want %d", label, got, want)
+	}
+}
+
+func assertBool(t *testing.T, label string, got, want bool) {
+	t.Helper()
+	if got != want {
+		t.Fatalf("%s = %t, want %t", label, got, want)
+	}
+}
