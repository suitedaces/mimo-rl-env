+func TestRepeatedCallsCleanEachResponseBody(t *testing.T) {
+
+
+	transport := &countingTransport{}
+
+	for i := 0; i < 120; i++ {
+		client := tbot.NewClient(token, &http.Client{Transport: transport}, "https://example.invalid")
+		me, err := client.GetMe()
+		if err != nil {
+			t.Fatalf("GetMe iteration %d error = %v", i, err)
+		}
+		assertInt(t, "loop User ID", me.ID, 1)
+	}
+
+	assertInt64(t, "total response bodies", atomic.LoadInt64(&transport.total), 120)
+
+}
+
+type failingRoundTripper struct{}
+
+func (failingRoundTripper) RoundTrip(*http.Request) (*http.Response, error) {
+	return nil, errors.New("dial blocked")
+}
+
+type countingTransport struct {
+	open  int64
+	total int64
+}
+
+func (t *countingTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.Method != "POST" {
+		return nil, fmt.Errorf("method %s", req.Method)
+	}
+	if req.URL.String() != "https://example.invalid/botTOKEN/getMe" {
+		return nil, fmt.Errorf("url %s", req.URL.String())
+	}
+	atomic.AddInt64(&t.open, 1)
+	atomic.AddInt64(&t.total, 1)
+	return &http.Response{
+		StatusCode: http.StatusOK,
+		Status:     "200 OK",
+		Header:     make(http.Header),
+		Body:       &countingBody{reader: strings.NewReader(`{"ok":true,"result":{"id":1,"is_bot":true,"first_name":"Bot"}}`), transport: t},
+		Request:    req,
+	}, nil
+}
+
+type countingBody struct {
+	reader    *strings.Reader
+	transport *countingTransport
+	closed    int32
+}
+
+func (b *countingBody) Read(p []byte) (int, error) {
+	return b.reader.Read(p)
+}
+
+func (b *countingBody) Close() error {
+	if atomic.CompareAndSwapInt32(&b.closed, 0, 1) {
+		atomic.AddInt64(&b.transport.open, -1)
+	}
+	return nil
+}
