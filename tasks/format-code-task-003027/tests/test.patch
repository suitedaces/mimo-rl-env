+func TestIndependentClientsKeepOwnEndpointState(t *testing.T) {
+
+
+	var mu sync.Mutex
+	aGetMe := 0
+	aSendMessage := 0
+	bGetMe := 0
+
+	serverA := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		defer mu.Unlock()
+		switch r.URL.Path {
+		case "/botALPHA/getMe":
+			aGetMe++
+			fmt.Fprint(w, `{"ok":true,"result":{"id":11,"is_bot":true,"first_name":"Alpha"}}`)
+		case "/botALPHA/sendMessage":
+			aSendMessage++
+			fmt.Fprint(w, `{"ok":true,"result":{"message_id":17,"chat":{"id":123},"text":"from alpha"}}`)
+		default:
+			t.Fatalf("server A unexpected path %q", r.URL.Path)
+		}
+	}))
+	defer serverA.Close()
+
+	serverB := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		defer mu.Unlock()
+		assertString(t, "server B path", r.URL.Path, "/botBETA/getMe")
+		bGetMe++
+		fmt.Fprint(w, `{"ok":true,"result":{"id":22,"is_bot":true,"first_name":"Beta"}}`)
+	}))
+	defer serverB.Close()
+
+	a := tbot.NewClient("ALPHA", serverA.Client(), serverA.URL)
+	b := tbot.NewClient("BETA", serverB.Client(), serverB.URL)
+
+	aUser, err := a.GetMe()
+	if err != nil {
+		t.Fatalf("a.GetMe error = %v", err)
+	}
+	aMsg, err := a.SendMessage("123", "from alpha")
+	if err != nil {
+		t.Fatalf("a.SendMessage error = %v", err)
+	}
+	bUser, err := b.GetMe()
+	if err != nil {
+		t.Fatalf("b.GetMe error = %v", err)
+	}
+
+	assertInt(t, "a user ID", aUser.ID, 11)
+	assertString(t, "a user FirstName", aUser.FirstName, "Alpha")
+	assertInt(t, "a message ID", aMsg.MessageID, 17)
+	assertString(t, "a message Text", aMsg.Text, "from alpha")
+	assertInt(t, "b user ID", bUser.ID, 22)
+	assertString(t, "b user FirstName", bUser.FirstName, "Beta")
+	assertInt(t, "server A getMe count", aGetMe, 1)
+	assertInt(t, "server A sendMessage count", aSendMessage, 1)
+	assertInt(t, "server B getMe count", bGetMe, 1)
+}
