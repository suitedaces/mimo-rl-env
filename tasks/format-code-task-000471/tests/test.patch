+    def test_serialization_with_use_regex(self):
+        """Trigger constructed with use_regex=True must serialize that fact."""
+        trigger = S3KeyTrigger(
+            bucket_key=[r"^dataset\d+\.csv$"],
+            bucket_name="test_bucket",
+            wildcard_match=False,
+            use_regex=True,
+        )
+        classpath, kwargs = trigger.serialize()
+        assert classpath == "astronomer.providers.amazon.aws.triggers.s3.S3KeyTrigger"
+        assert kwargs.get("use_regex") is True
+
+    @pytest.mark.asyncio
+    @mock.patch("astronomer.providers.amazon.aws.triggers.s3.S3HookAsync.check_key")
+    @mock.patch("astronomer.providers.amazon.aws.triggers.s3.S3HookAsync.get_client_async")
+    async def test_run_passes_use_regex_to_check_key(self, mock_client, mock_check_key):
+        """trigger.run must forward use_regex to S3HookAsync.check_key."""
+        mock_check_key.return_value = False
+        trigger = S3KeyTrigger(
+            bucket_key=[r"^dataset\d+\.csv$"],
+            bucket_name="test_bucket",
+            wildcard_match=False,
+            use_regex=True,
+        )
+        with mock_client:
+            task = asyncio.create_task(trigger.run().__anext__())
+            await asyncio.sleep(0.5)
+            asyncio.get_event_loop().stop()
+
+        assert mock_check_key.await_count >= 1
+        call_args = mock_check_key.await_args
+
+        passed = call_args.kwargs.get("use_regex")
+        if passed is None and len(call_args.args) >= 5:
+            passed = call_args.args[4]
+        assert passed is True
+
 
