 import pytest
+from requests.exceptions import ConnectionError as RequestsConnectionError
+from urllib3.exceptions import MaxRetryError, NewConnectionError, ProtocolError
 
-from schemathesis.exceptions import truncated_json, prepare_response_payload
+from schemathesis.exceptions import (
+    extract_requests_exception_details,
+    truncated_json,
+    prepare_response_payload,
+)
 
 
 def test_truncate_simple_dict():
@@ -24,3 +30,60 @@ def test_truncate_simple_dict():
 )
 def test_prepare_response_payload(payload, expected):
     assert prepare_response_payload(payload, max_size=10) == expected
+
+
+def test_extract_protocol_error_does_not_raise():
+
+
+    inner = ProtocolError(
+        "Connection aborted.",
+        Exception("Remote end closed connection without response"),
+    )
+    exc = RequestsConnectionError(inner)
+    message, extras = extract_requests_exception_details(exc)
+    assert message == "Connection failed"
+    assert isinstance(extras, list)
+    assert len(extras) == 1
+
+
+def test_extract_protocol_error_extra_is_readable():
+
+
+
+    inner = ProtocolError(
+        "Connection aborted.",
+        Exception("Remote end closed connection without response"),
+    )
+    exc = RequestsConnectionError(inner)
+    _, extras = extract_requests_exception_details(exc)
+    assert isinstance(extras, list) and len(extras) == 1
+    assert isinstance(extras[0], str)
+    assert "Connection aborted." in extras[0]
+    assert "Remote end closed connection without response" in extras[0]
+
+
+def test_extract_max_retry_error_normal():
+
+
+    reason = NewConnectionError(
+        None,
+        "Failed to establish a new connection: [Errno 111] Connection refused",
+    )
+    mre = MaxRetryError(None, "/", reason=reason)
+    exc = RequestsConnectionError(mre)
+    message, extras = extract_requests_exception_details(exc)
+    assert message == "Connection failed"
+    assert extras == [
+        "Failed to establish a new connection: [Errno 111] Connection refused"
+    ]
+
+
+def test_extract_max_retry_error_with_none_reason():
+
+
+    mre = MaxRetryError(None, "/some-url", reason=None)
+    exc = RequestsConnectionError(mre)
+    message, extras = extract_requests_exception_details(exc)
+    assert message == "Connection failed"
+    assert isinstance(extras, list)
+    assert len(extras) == 1
