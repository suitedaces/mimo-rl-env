+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 ./pkg/util/resource ./pkg/util/limiter ./pkg/cortex -run 'Test_NoopScanner|TestResponseSizeLimiter_AddDataBytes|TestRateLimiter_RecheckPeriod|TestRateLimiter_AllowN|TestQueryLimiter_AddSeries_ShouldReturnNoErrorOnLimitNotExceeded|TestQueryLimiter_AddSeriers_ShouldReturnErrorOnLimitExceeded|TestQueryLimiter_AddSeriesBatch_ShouldReturnErrorOnLimitExceeded|TestQueryLimiter_AddChunkBytes|TestQueryLimiter_AddDataBytes|TestAPIConfig|TestCortex_InitRulerStorage|Test_setupModuleManager'
+    ;;
+  new)
+    go test -v -count=1 ./pkg/util/resource ./pkg/util/limiter ./pkg/cortex -run 'Test(HeapScannerReportsHeapUsageAtRealisticMagnitude|ResourceMonitorRecordsHeapUtilizationWithoutPanic|ResourceBasedLimiterLimitMetricHasResourceLabelForEachResource|InitResourceMonitorRejectsUnsupportedResource|InitResourceMonitorSkipsUnsetOrEffectivelyEmptyResources)$'
+    ;;
+  *)
+    echo "usage: $0 base|new" >&2
+    exit 2
+    ;;
+esac
