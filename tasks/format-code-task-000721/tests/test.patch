 	require.NoError(t, err)
 	require.Zero(t, val)
 }
+
+func TestHeapScannerReportsHeapUsageAtRealisticMagnitude(t *testing.T) {
+	scanner, err := newHeapScanner()
+	require.NoError(t, err)
+
+	const allocationSize = 32 * 1024 * 1024
+	buf := make([]byte, allocationSize)
+	for i := 0; i < len(buf); i += 4096 {
+		buf[i] = byte(i)
+	}
+
+	value, err := scanner.scan()
+	require.NoError(t, err)
+	require.True(t, !math.IsNaN(value) && !math.IsInf(value, 0), "heap scan should return a finite value, got %v", value)
+	require.Greater(
+		t,
+		value,
+		float64(8*1024*1024),
+		"heap scan should reflect real heap usage, not zero or a fixed small sentinel",
+	)
+
+	runtime.KeepAlive(buf)
+}
