+func TestInitResourceMonitorRejectsUnsupportedResource(t *testing.T) {
+	tests := map[string][]string{
+		"single unsupported resource":              {"definitely-unsupported-resource-a"},
+		"different unsupported resource":           {"definitely-unsupported-resource-b"},
+		"unsupported resource after supported one": {"heap", "definitely-unsupported-resource-c"},
+	}
+
+	errorMessages := map[string]string{}
+	for name, resources := range tests {
+		t.Run(name, func(t *testing.T) {
+			cortex := &Cortex{
+				Server: &server.Server{},
+				Cfg: Config{
+					MonitoredResources: resources,
+				},
+			}
+
+			svc, err := cortex.initResourceMonitor()
+			require.Nil(t, svc)
+			require.Error(t, err)
+			require.NotEmpty(t, err.Error())
+			errorMessages[name] = err.Error()
+		})
+	}
+
+	require.NotEqual(
+		t,
+		errorMessages["single unsupported resource"],
+		errorMessages["different unsupported resource"],
+		"error should identify which unsupported monitored resource caused the failure",
+	)
+}
+
+func TestInitResourceMonitorSkipsUnsetOrEffectivelyEmptyResources(t *testing.T) {
+	tests := map[string][]string{
