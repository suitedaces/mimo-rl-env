diff --git a/pkg/util/limiter/resource_based_limiter_test.go b/pkg/util/limiter/resource_based_limiter_test.go
new file mode 100644
index 0000000000..9c1c9b4af9
--- /dev/null
+++ b/pkg/util/limiter/resource_based_limiter_test.go
@@ -0,0 +1,90 @@
+package limiter
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/prometheus/client_golang/prometheus"
+	dto "github.com/prometheus/client_model/go"
+	"github.com/stretchr/testify/require"
+
+	"github.com/cortexproject/cortex/pkg/util/resource"
+)
+
+func TestResourceBasedLimiterLimitMetricHasResourceLabelForEachResource(t *testing.T) {
+	tests := []struct {
+		component string
+		cpuLimit  float64
+		heapLimit float64
+	}{
+		{component: "ingester", cpuLimit: 0.61, heapLimit: 0.73},
+		{component: "store-gateway", cpuLimit: 0.42, heapLimit: 0.88},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.component, func(t *testing.T) {
+			registry := prometheus.NewRegistry()
+			limits := map[resource.Type]float64{
+				resource.CPU:  tc.cpuLimit,
+				resource.Heap: tc.heapLimit,
+			}
+
+			_, err := NewResourceBasedLimiter(&mockMonitor{}, limits, registry, tc.component)
+			require.NoError(t, err)
+
+			metrics, err := registry.Gather()
+			require.NoError(t, err)
+
+			require.InDelta(t, tc.cpuLimit, findLimitMetric(t, metrics, tc.component, "cpu"), 0.000001)
+			require.InDelta(t, tc.heapLimit, findLimitMetric(t, metrics, tc.component, "heap"), 0.000001)
+		})
+	}
+}
+
+func findLimitMetric(t *testing.T, families []*dto.MetricFamily, component, monitoredResource string) float64 {
+	t.Helper()
+
+	for _, family := range families {
+		if family.GetName() != "cortex_resource_based_limiter_limit" {
+			continue
+		}
+
+		for _, metric := range family.GetMetric() {
+			if labelValue(metric, "component") == component && hasLabelValue(metric, monitoredResource) {
+				require.NotNil(t, metric.GetGauge(), "limit metric for component=%s monitored resource=%s should be a gauge", component, monitoredResource)
+				return metric.GetGauge().GetValue()
+			}
+		}
+	}
+
+	require.FailNow(t, fmt.Sprintf("missing limit metric for component=%s monitored resource=%s", component, monitoredResource))
+	return 0
+}
+
+func labelValue(metric *dto.Metric, name string) string {
+	for _, label := range metric.GetLabel() {
+		if label.GetName() == name {
+			return label.GetValue()
+		}
+	}
+	return ""
+}
+
+func hasLabelValue(metric *dto.Metric, value string) bool {
+	for _, label := range metric.GetLabel() {
+		if label.GetValue() == value {
+			return true
+		}
+	}
+	return false
+}
+
+type mockMonitor struct{}
+
+func (m *mockMonitor) GetCPUUtilization() float64 {
+	return 0
+}
+
+func (m *mockMonitor) GetHeapUtilization() float64 {
+	return 0
+}
diff --git a/pkg/util/resource/monitor_test.go b/pkg/util/resource/monitor_test.go
new file mode 100644
index 0000000000..e99a3327a1
--- /dev/null
+++ b/pkg/util/resource/monitor_test.go
@@ -0,0 +1,50 @@
+package resource
+
+import (
+	"context"
+	"math"
+	"runtime"
+	"testing"
+	"time"
+
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/stretchr/testify/require"
+)
+
+func TestResourceMonitorRecordsHeapUtilizationWithoutPanic(t *testing.T) {
+	m, err := NewMonitor(map[Type]float64{
+		Heap: float64(64 * 1024 * 1024),
+	}, prometheus.NewRegistry())
+	require.NoError(t, err)
+
+	buf := make([]byte, 16*1024*1024)
+	for i := 0; i < len(buf); i += 4096 {
+		buf[i] = byte(i)
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	require.NoError(t, m.StartAsync(ctx))
+	require.NoError(t, m.AwaitRunning(ctx))
+
+	deadline := time.Now().Add(2 * time.Second)
+	var heapUtilization float64
+	for time.Now().Before(deadline) {
+		heapUtilization = m.GetHeapUtilization()
+		if !math.IsNaN(heapUtilization) && !math.IsInf(heapUtilization, 0) && heapUtilization > 0 {
+			break
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+
+	m.StopAsync()
+	stopCtx, stopCancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer stopCancel()
+	require.NoError(t, m.AwaitTerminated(stopCtx))
+
+	require.True(t, !math.IsNaN(heapUtilization) && !math.IsInf(heapUtilization, 0), "heap utilization should be finite")
+	require.Greater(t, heapUtilization, float64(0), "heap utilization should be recorded")
+
+	runtime.KeepAlive(buf)
+}
