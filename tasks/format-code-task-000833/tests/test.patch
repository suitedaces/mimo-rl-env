+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+
+
+export PIP_NO_INDEX=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+export PIP_NO_INPUT=1
+unset PIP_INDEX_URL PIP_EXTRA_INDEX_URL PIP_FIND_LINKS
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+
+python -m pip install --no-index --disable-pip-version-check --no-input --no-build-isolation --no-deps -e . pytest >/dev/null
+
+exec python -m pytest /workspace/repo/usercase-test-coderl/test_sqla_interface_mutations.py -v
