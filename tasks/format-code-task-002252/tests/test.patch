diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,124 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+export AWS_EC2_METADATA_DISABLED=true AWS_REGION=us-east-1 AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+BIN="/tmp/s5cmd-usecase-coderl-$$"
+( cd /workspace/repo && go build -mod=vendor -o "$BIN" . ) || fail "build"
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"; rm -f "$BIN"' EXIT
+cd "$TMP" || fail "cd temp"
+
+mkdir -p work/dataA/nested work/dataB
+printf 'alpha' > work/a.txt
+printf 'beta!!' > work/b.txt
+printf 'log' > work/c.log
+printf 'long' > work/cc.log
+printf 'nestedA' > work/dataA/nested/item.txt
+printf 'rootA' > work/dataA/root.bin
+printf 'rootB' > work/dataB/only.txt
+ln -s dataA work/data_link
+touch -h -t 202001020304.05 \
+  work/a.txt work/b.txt work/c.log work/cc.log \
+  work/dataA work/dataA/nested work/dataA/nested/item.txt work/dataA/root.bin \
+  work/dataB work/dataB/only.txt work/data_link 2>/dev/null || true
+
+expect_file() {
+  label=$1
+  path=$2
+  expected=$3
+  actual=$(cat "$path")
+  [ "$actual" = "$expected" ] || fail "$label: got [$actual]"
+}
+
+expect_last_fields() {
+  label=$1
+  path=$2
+  expected=$3
+  actual=$(awk 'NF { print $NF }' "$path" | sed 's#^\./##; s#^work/##' | sort)
+  [ "$actual" = "$expected" ] || fail "$label: got [$actual]"
+}
+
+
+
+
+"$BIN" ls 'work/*.txt' >out 2>err; ec=$?
+EXPECTED_F1='a.txt
+b.txt'
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+
+expect_last_fields "F1 listed paths" out "$EXPECTED_F1"
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+
+
+
+
+"$BIN" ls 'work/?.log' >out 2>err; ec=$?
+EXPECTED_F2='c.log'
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+
+expect_last_fields "F2 listed paths" out "$EXPECTED_F2"
+[ ! -s err ] || fail "F2 unexpected stderr: $(cat err)"
+
+
+
+
+"$BIN" ls 'work/*.missing' >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F3 exit 0; want non-zero"
+[ ! -s out ] || fail "F3 unexpected stdout: $(cat out)"
+
+grep -Eiq 'no[[:space:]-]*match' err || fail "F3 stderr lacks no-match message: $(cat err)"
+grep -Fq 'work/*.missing' err || fail "F3 stderr lacks source pattern: $(cat err)"
+
+
+
+
+"$BIN" ls 'work/*[bad' >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F4 exit 0; want non-zero"
+[ ! -s out ] || fail "F4 unexpected stdout: $(cat out)"
+
+[ -s err ] || fail "F4 expected stderr for invalid pattern"
+
+
+
+
+"$BIN" --dry-run cp 'work/*.txt' 's3://bucket/prefix/' >out 2>err; ec=$?
+sort out >out.sorted
+EXPECTED_F5='cp work/a.txt s3://bucket/prefix/a.txt
+cp work/b.txt s3://bucket/prefix/b.txt'
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+expect_file "F5 stdout" out.sorted "$EXPECTED_F5"
+[ ! -s err ] || fail "F5 unexpected stderr: $(cat err)"
+
+
+
+
+"$BIN" --dry-run cp 'work/data*' 's3://bucket/prefix/' >out 2>err; ec=$?
+sort out >out.sorted
+EXPECTED_F6='cp work/dataA/nested/item.txt s3://bucket/prefix/dataA/nested/item.txt
+cp work/dataA/root.bin s3://bucket/prefix/dataA/root.bin
+cp work/dataB/only.txt s3://bucket/prefix/dataB/only.txt
+cp work/data_link/nested/item.txt s3://bucket/prefix/data_link/nested/item.txt
+cp work/data_link/root.bin s3://bucket/prefix/data_link/root.bin'
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+expect_file "F6 stdout" out.sorted "$EXPECTED_F6"
+[ ! -s err ] || fail "F6 unexpected stderr: $(cat err)"
+
+
+
+
+"$BIN" --dry-run cp --no-follow-symlinks 'work/data*' 's3://bucket/prefix/' >out 2>err; ec=$?
+sort out >out.sorted
+EXPECTED_F7='cp work/dataA/nested/item.txt s3://bucket/prefix/dataA/nested/item.txt
+cp work/dataA/root.bin s3://bucket/prefix/dataA/root.bin
+cp work/dataB/only.txt s3://bucket/prefix/dataB/only.txt'
+[ "$ec" -eq 0 ] || fail "F7 exit $ec; want 0"
+expect_file "F7 stdout" out.sorted "$EXPECTED_F7"
+[ ! -s err ] || fail "F7 unexpected stderr: $(cat err)"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+
+
+export GOFLAGS="${GOFLAGS:-} -mod=vendor"
+export GOPROXY=off
+export GOSUMDB=off
+export GOTOOLCHAIN=local
+
+
+export AWS_SDK_LOAD_CONFIG=0
+export AWS_EC2_METADATA_DISABLED=true
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
