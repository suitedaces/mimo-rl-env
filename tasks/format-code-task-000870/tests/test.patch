+from sciencebeam_parser.document.layout_document import (
+    LayoutBlock,
+    LayoutDocument,
+    LayoutGraphic,
+    LayoutLineMeta,
+    LayoutPage,
+    LayoutPageCoordinates,
+    LayoutPageMeta,
+)
+from sciencebeam_parser.document.semantic_document import (
+    SemanticFigure,
+    SemanticGraphic,
+    SemanticLabel,
+    SemanticRawFigure,
+    SemanticTable,
+    iter_by_semantic_type_recursively,
+)
+from sciencebeam_parser.ocr_models.ocr_model import (
+    OpticalCharacterRecognitionModel,
+    SimpleOpticalCharacterRecognitionModelResult,
+)
+from sciencebeam_parser.processors.fulltext.api import (
+    FullTextProcessor,
+    FullTextProcessorConfig,
+    load_models,
+)
+from sciencebeam_parser.processors.fulltext.models import FullTextModels
+from sciencebeam_parser.processors.graphic_matching import (
+    OpticalCharacterRecognitionGraphicMatcher,
+)
+from sciencebeam_parser.resources.default_config import DEFAULT_CONFIG_FILE
+
+
+PAGE_META = LayoutPageMeta.for_coordinates(LayoutPageCoordinates(
+    x=0,
+    y=0,
+    width=400,
+    height=600,
+    page_number=1,
+))
+LINE_META = LayoutLineMeta(line_id=1, page_meta=PAGE_META)
+GRAPHIC_COORDINATES = LayoutPageCoordinates(
+    x=300,
+    y=500,
+    width=40,
+    height=40,
+    page_number=1,
+)
+
+
+class RecordingOcrModel:
+    def __init__(self, text_results: Sequence[str]):
+        self.text_results = list(text_results)
+        self.image_sizes: List[Tuple[int, int]] = []
+        self.call_count = 0
+
+    def predict_single(self, image):
+        self.image_sizes.append(image.size)
+        if self.call_count < len(self.text_results):
+            text = self.text_results[self.call_count]
+        else:
+            text = self.text_results[-1]
+        self.call_count += 1
+        return SimpleOpticalCharacterRecognitionModelResult(text)
+
+
+def _block(text: str, coordinates: LayoutPageCoordinates) -> LayoutBlock:
+    return LayoutBlock.for_text(text, coordinates=coordinates, line_meta=LINE_META)
+
+
+def _write_png(path: Path, size: Tuple[int, int] = (10, 10)) -> Path:
+    PIL.Image.new('RGB', size, (0, 1, 2)).save(path)
+    return path
+
+
+def _semantic_graphic(
+    local_file_path: Optional[Path] = None,
+    graphic_type: Optional[str] = None,
+    coordinates: LayoutPageCoordinates = GRAPHIC_COORDINATES,
+) -> SemanticGraphic:
+    return SemanticGraphic(layout_graphic=LayoutGraphic(
+        coordinates=coordinates,
+        local_file_path=str(local_file_path) if local_file_path else None,
+        graphic_type=graphic_type,
+        page_meta=PAGE_META,
+    ))
+
+
+def _figure(
+    label_text: str,
+    coordinates: Optional[LayoutPageCoordinates] = None
+) -> SemanticFigure:
+    return SemanticFigure([
+        SemanticLabel(layout_block=_block(
+            label_text,
+            coordinates or LayoutPageCoordinates(
+                x=10,
+                y=10,
+                width=80,
+                height=20,
+                page_number=1,
+            ),
+        ))
+    ])
+
+
+def _table(label_text: str) -> SemanticTable:
+    return SemanticTable([
+        SemanticLabel(layout_block=_block(
+            label_text,
+            LayoutPageCoordinates(x=10, y=40, width=80, height=20, page_number=1),
+        ))
+    ])
+
+
+def _snapshot_graphic_match_result(result, ocr_model: RecordingOcrModel):
+    return {
+        'matches': len(result.graphic_matches),
+        'unmatched': len(result.unmatched_graphics),
+        'matched_labels': [
+            match.candidate_semantic_content.get_text_by_type(SemanticLabel)
+            for match in result.graphic_matches
+        ],
+        'ocr_call_count': ocr_model.call_count,
+    }
+
+
+def _fd_count() -> int:
+    return len(list(Path('/proc/self/fd').iterdir()))
+
+
+class FakeSegmentationLabelResult:
+    def __init__(self, body_document: LayoutDocument):
+        self.body_document = body_document
+
+    def get_filtered_document_by_label(self, label: str) -> LayoutDocument:
+        if label == '<body>':
+            return self.body_document
+        return LayoutDocument(pages=[])
+
+
+class FakeSegmentationModel:
+    def __init__(self, body_document: LayoutDocument):
+        self.body_document = body_document
+
+    def get_label_layout_document_result(self, layout_document, app_features_context):
+        return FakeSegmentationLabelResult(self.body_document)
+
+
+class FakeFullTextModel:
+    def __init__(self, raw_figure_block: LayoutBlock):
+        self.raw_figure_block = raw_figure_block
+
+    def predict_labels_for_layout_document(self, layout_document, app_features_context):
+        return ['fulltext-labels']
+
+    def iter_entity_layout_blocks_for_labeled_layout_tokens(self, labeled_layout_tokens):
+        return [('<figure>', self.raw_figure_block)]
+
+    def update_section_with_entity_blocks(self, parent_section, entity_blocks, section_type):
+        for tag, block in entity_blocks:
+            assert tag == '<figure>'
+            parent_section.add_content(SemanticRawFigure(layout_block=block))
+
+
+class FakeFigureModel:
+    def __init__(self, figures: Sequence[SemanticFigure]):
+        self.figures = list(figures)
+
+    def predict_labels_for_layout_documents(self, layout_documents, app_features_context):
+        return [['figure-labels']]
+
+    def iter_semantic_content_for_labeled_layout_tokens(self, labeled_layout_tokens):
+        assert labeled_layout_tokens == ['figure-labels']
+        return list(self.figures)
+
+
+def _fulltext_models_for_figures(
+    raw_figure_block: LayoutBlock,
+    figures: Sequence[SemanticFigure],
+    ocr_model: RecordingOcrModel,
+) -> FullTextModels:
+    body_document = LayoutDocument(pages=[LayoutPage(
+        blocks=[raw_figure_block],
+        meta=PAGE_META,
+    )])
+    return FullTextModels(
+        segmentation_model=FakeSegmentationModel(body_document),
+        header_model=MagicMock(name='header_model'),
+        name_header_model=MagicMock(name='name_header_model'),
+        name_citation_model=MagicMock(name='name_citation_model'),
+        affiliation_address_model=MagicMock(name='affiliation_address_model'),
+        fulltext_model=FakeFullTextModel(raw_figure_block),
+        figure_model=FakeFigureModel(figures),
+        table_model=MagicMock(name='table_model'),
+        reference_segmenter_model=MagicMock(name='reference_segmenter_model'),
+        citation_model=MagicMock(name='citation_model'),
+        ocr_model=ocr_model,
+    )
+
+
+def test_load_models_populates_ocr_model_only_when_fulltext_config_enables_it():
+
+
+
+
+    app_config = yaml.safe_load(Path(DEFAULT_CONFIG_FILE).read_text(encoding='utf-8'))
+
+    default_config = FullTextProcessorConfig.from_app_config(app_config)
+
+    enabled_models = load_models(
+        app_config=app_config,
+        app_context=MagicMock(name='AppContext'),
+        fulltext_processor_config=default_config._replace(use_ocr_model=True),
+    )
+
+
+    assert isinstance(enabled_models.ocr_model, OpticalCharacterRecognitionModel)
+
+
+def test_ocr_matcher_matches_exact_abbreviated_and_multiline_figure_labels(tmp_path: Path):
+
+
+
+
+    image_path = _write_png(tmp_path / 'figure.png')
+    semantic_graphic = _semantic_graphic(image_path)
+    ocr_model = RecordingOcrModel([
+        'Figure 1',
+        'Fig 1',
+        'Figure 1',
+        'F 1',
+        'Other\nFigure 1\nMore',
+    ])
+    matcher = OpticalCharacterRecognitionGraphicMatcher(ocr_model=ocr_model)
+
+    snapshots = []
+    for candidate in [
+        _figure('Figure 1'),
+        _figure('Figure 1'),
+        _figure('Figure 2'),
+        _figure('Figure 1'),
+        _figure('Figure 1'),
+    ]:
+        snapshots.append(_snapshot_graphic_match_result(
+            matcher.get_graphic_matches([semantic_graphic], [candidate]),
+            ocr_model,
+        ))
+
+    assert snapshots == [
+        {'matches': 1, 'unmatched': 0, 'matched_labels': ['Figure 1'], 'ocr_call_count': 1},
+        {'matches': 1, 'unmatched': 0, 'matched_labels': ['Figure 1'], 'ocr_call_count': 2},
+        {'matches': 0, 'unmatched': 1, 'matched_labels': [], 'ocr_call_count': 3},
+        {'matches': 0, 'unmatched': 1, 'matched_labels': [], 'ocr_call_count': 4},
+        {'matches': 1, 'unmatched': 0, 'matched_labels': ['Figure 1'], 'ocr_call_count': 5},
+    ]
+    assert ocr_model.image_sizes == [(10, 10), (10, 10), (10, 10), (10, 10), (10, 10)]
+
+
+def test_ocr_matcher_matches_table_labels(tmp_path: Path):
+
+
+
+
+    image_path = _write_png(tmp_path / 'table.png')
+    ocr_model = RecordingOcrModel(['Table 1'])
+    result = OpticalCharacterRecognitionGraphicMatcher(
+        ocr_model=ocr_model
+    ).get_graphic_matches(
+        semantic_graphic_list=[_semantic_graphic(image_path)],
+        candidate_semantic_content_list=[_table('Table 1')],
+    )
+
+    assert {
+        'matches': len(result.graphic_matches),
+        'unmatched': len(result.unmatched_graphics),
+        'matched_types': [
+            type(match.candidate_semantic_content).__name__
+            for match in result.graphic_matches
+        ],
+        'matched_labels': [
+            match.candidate_semantic_content.get_text_by_type(SemanticLabel)
+            for match in result.graphic_matches
+        ],
+        'ocr_call_count': ocr_model.call_count,
+    } == {
+        'matches': 1,
+        'unmatched': 0,
+        'matched_types': ['SemanticTable'],
+        'matched_labels': ['Table 1'],
+        'ocr_call_count': 1,
+    }
+
+
+def test_ocr_matcher_scales_large_non_svg_image_before_prediction(tmp_path: Path):
+
+
+
+
+    image_path = _write_png(tmp_path / 'large.png', size=(200, 100))
+    ocr_model = RecordingOcrModel(['Figure 1'])
+    result = OpticalCharacterRecognitionGraphicMatcher(
+        ocr_model=ocr_model,
+        max_resolution=50,
+    ).get_graphic_matches(
+        semantic_graphic_list=[_semantic_graphic(image_path)],
+        candidate_semantic_content_list=[_figure('Figure 1')],
+    )
+
+    assert _snapshot_graphic_match_result(result, ocr_model) == {
+        'matches': 1,
+        'unmatched': 0,
+        'matched_labels': ['Figure 1'],
+        'ocr_call_count': 1,
+    }
+    assert ocr_model.image_sizes == [(50, 25)]
+
+
+def test_ocr_matcher_leaves_missing_path_and_svg_graphics_unmatched_without_ocr(tmp_path: Path):
+
+
+
+
+    svg_path = _write_png(tmp_path / 'svg.png')
+    missing_path_graphic = _semantic_graphic(local_file_path=None)
+    svg_graphic = _semantic_graphic(local_file_path=svg_path, graphic_type='svg')
+    ocr_model = RecordingOcrModel(['Figure 1'])
+    result = OpticalCharacterRecognitionGraphicMatcher(
+        ocr_model=ocr_model
+    ).get_graphic_matches(
+        semantic_graphic_list=[
+            missing_path_graphic,
+            svg_graphic,
+        ],
+        candidate_semantic_content_list=[_figure('Figure 1')],
+    )
+
+    assert len(result.graphic_matches) == 0
+    assert len(result.unmatched_graphics) == 2
+
+    assert {id(graphic) for graphic in result.unmatched_graphics} == {
+        id(missing_path_graphic),
+        id(svg_graphic),
+    }
+    assert ocr_model.call_count == 0
+    assert ocr_model.image_sizes == []
+
+
+def test_ocr_matcher_ignores_missing_local_file_path_before_matching():
+
+
+
+
+    semantic_graphic = _semantic_graphic(local_file_path=None)
