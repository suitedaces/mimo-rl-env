+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+export PYTHONPATH=/workspace/repo
+export TF_CPP_MIN_LOG_LEVEL="${TF_CPP_MIN_LOG_LEVEL:-3}"
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+export PIP_NO_INDEX=1
+export HF_HUB_OFFLINE=1
+export TRANSFORMERS_OFFLINE=1
+
+if [[ -x /workspace/repo/.venv/bin/python ]]; then
+  PYTHON_BIN=/workspace/repo/.venv/bin/python
+else
+  echo "error: required offline Python venv missing at /workspace/repo/.venv" >&2
