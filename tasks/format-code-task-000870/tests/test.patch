+
+def test_matcher_instances_keep_independent_ocr_state(tmp_path: Path):
+
+
+
+
+    image_a_path = _write_png(tmp_path / 'a.png')
+    image_b_path = _write_png(tmp_path / 'b.png')
+    ocr_model_a = RecordingOcrModel(['Figure 1'])
+    ocr_model_b = RecordingOcrModel(['Figure 2'])
+    matcher_a = OpticalCharacterRecognitionGraphicMatcher(ocr_model=ocr_model_a)
+    matcher_b = OpticalCharacterRecognitionGraphicMatcher(ocr_model=ocr_model_b)
+
+    result_a = matcher_a.get_graphic_matches(
+        semantic_graphic_list=[_semantic_graphic(image_a_path)],
+        candidate_semantic_content_list=[_figure('Figure 1')],
+    )
+    assert _snapshot_graphic_match_result(result_a, ocr_model_a) == {
+        'matches': 1,
+        'unmatched': 0,
+        'matched_labels': ['Figure 1'],
+        'ocr_call_count': 1,
+    }
+    assert ocr_model_b.call_count == 0
+
+    result_b = matcher_b.get_graphic_matches(
+        semantic_graphic_list=[_semantic_graphic(image_b_path)],
+        candidate_semantic_content_list=[_figure('Figure 2')],
+    )
+    assert _snapshot_graphic_match_result(result_b, ocr_model_b) == {
+        'matches': 1,
+        'unmatched': 0,
+        'matched_labels': ['Figure 2'],
+        'ocr_call_count': 1,
+    }
+    assert [ocr_model_a.call_count, ocr_model_b.call_count] == [1, 1]
+
+
+def test_same_matcher_can_reopen_image_on_repeated_calls(tmp_path: Path):
+
+
+
+
+    image_path = _write_png(tmp_path / 'repeat.png')
+    ocr_model = RecordingOcrModel(['Figure 1', 'Figure 1'])
+    matcher = OpticalCharacterRecognitionGraphicMatcher(ocr_model=ocr_model)
+
+    snapshots = []
+    for _ in range(2):
+        snapshots.append(_snapshot_graphic_match_result(
+            matcher.get_graphic_matches(
+                semantic_graphic_list=[_semantic_graphic(image_path)],
+                candidate_semantic_content_list=[_figure('Figure 1')],
+            ),
+            ocr_model,
+        ))
+
+    assert snapshots == [
+        {'matches': 1, 'unmatched': 0, 'matched_labels': ['Figure 1'], 'ocr_call_count': 1},
+        {'matches': 1, 'unmatched': 0, 'matched_labels': ['Figure 1'], 'ocr_call_count': 2},
+    ]
+    assert ocr_model.image_sizes == [(10, 10), (10, 10)]
+
+
+def test_fulltext_processor_uses_ocr_after_bounding_box_matching(tmp_path: Path):
+
+
+
+
+    near_path = _write_png(tmp_path / 'near.png')
+    far_path = _write_png(tmp_path / 'far.png')
+    figure_1_label_block = _block(
+        'Figure 1',
+        LayoutPageCoordinates(x=10, y=10, width=80, height=20, page_number=1),
+    )
+    figure_2_label_block = _block(
+        'Figure 2',
+        LayoutPageCoordinates(x=10, y=200, width=80, height=20, page_number=1),
+    )
+    raw_figure_block = _block(
+        'raw figure text',
+        LayoutPageCoordinates(x=10, y=10, width=80, height=210, page_number=1),
+    )
+    near_graphic = LayoutGraphic(
+        coordinates=LayoutPageCoordinates(x=10, y=10, width=80, height=20, page_number=1),
+        local_file_path=str(near_path),
+        page_meta=PAGE_META,
+    )
+    far_graphic = LayoutGraphic(
+        coordinates=LayoutPageCoordinates(x=300, y=500, width=40, height=40, page_number=1),
+        local_file_path=str(far_path),
+        page_meta=PAGE_META,
+    )
+    layout_document = LayoutDocument(pages=[LayoutPage(
+        blocks=[raw_figure_block],
+        graphics=[near_graphic, far_graphic],
+        meta=PAGE_META,
+    )])
+    ocr_model = RecordingOcrModel(['Figure 2'])
+    fulltext_models = _fulltext_models_for_figures(
+        raw_figure_block=raw_figure_block,
+        figures=[
+            SemanticFigure([SemanticLabel(layout_block=figure_1_label_block)]),
+            SemanticFigure([SemanticLabel(layout_block=figure_2_label_block)]),
+        ],
+        ocr_model=ocr_model,
+    )
+
+    semantic_document = FullTextProcessor(
+        fulltext_models,
+        FullTextProcessorConfig(
+            extract_front=False,
+            extract_acknowledgements=False,
+            extract_back_sections=False,
+            extract_references=False,
+            extract_citation_fields=False,
+            extract_figure_fields=True,
+            extract_table_fields=False,
+            extract_graphic_bounding_boxes=True,
+            use_ocr_model=True,
+            max_graphic_distance=0.01,
+        ),
+    ).get_semantic_document_for_layout_document(layout_document=layout_document)
+
+    figure_graphic_file_names_by_label = {}
+    for figure in iter_by_semantic_type_recursively(
+        [semantic_document.body_section, semantic_document.back_section],
+        SemanticFigure,
+    ):
+        graphics = list(figure.iter_by_type(SemanticGraphic))
+        figure_graphic_file_names_by_label[
+        figure.get_text_by_type(SemanticLabel)
+    ] = [
+            Path(graphic.layout_graphic.local_file_path).name
+            for graphic in graphics
+        ]
+    all_graphics = list(iter_by_semantic_type_recursively(
+        [semantic_document.body_section, semantic_document.back_section],
+        SemanticGraphic,
+    ))
+
+
+    assert figure_graphic_file_names_by_label == {
+        'Figure 1': ['near.png'],
+        'Figure 2': ['far.png'],
+    }
+    assert len(all_graphics) == 2
+    assert ocr_model.call_count == 1
+    assert ocr_model.image_sizes == [(10, 10)]
+
+
+def test_repeated_ocr_matcher_cycles_do_not_leak_image_file_descriptors(tmp_path: Path):
+
+
+
+
+    image_path = _write_png(tmp_path / 'leak-floor.png')
+    gc.collect()
+    fd_count_before = _fd_count()
+
+    for _ in range(120):
+        ocr_model = RecordingOcrModel(['Figure 1'])
+        matcher = OpticalCharacterRecognitionGraphicMatcher(ocr_model=ocr_model)
+        result = matcher.get_graphic_matches(
+            semantic_graphic_list=[_semantic_graphic(image_path)],
+            candidate_semantic_content_list=[_figure('Figure 1')],
+        )
+        assert len(result.graphic_matches) == 1
+        assert len(result.unmatched_graphics) == 0
+        assert ocr_model.call_count == 1
+        del matcher
+        del ocr_model
+
+    gc.collect()
+    assert _fd_count() <= fd_count_before + 3
