+func TestDatabaseInitSQLSpecField(t *testing.T) {
+	var cluster PostgresCluster
+	cluster.Spec.DatabaseInitSQL = &DatabaseInitSQL{
+		Name: "my-config-map",
+		Key:  "init.sql",
+	}
+
+	b, err := yaml.Marshal(cluster.Spec.DatabaseInitSQL)
+	assert.NilError(t, err)
+	assert.DeepEqual(t, string(b), "key: init.sql\nname: my-config-map\n")
+
+
+	specYAML, err := yaml.Marshal(cluster.Spec)
+	assert.NilError(t, err)
+	assert.Assert(t, strings.Contains(string(specYAML), "databaseInitSQL:"))
+}
+
+
+
+func TestDatabaseInitSQLStatusField(t *testing.T) {
+	var cluster PostgresCluster
+
+
+	statusYAML, err := yaml.Marshal(cluster.Status)
+	assert.NilError(t, err)
+	assert.Assert(t, !strings.Contains(string(statusYAML), "databaseInitSQL"))
+
+
+	applied := "my-config-map"
+	cluster.Status.DatabaseInitSQL = &applied
+	statusYAML, err = yaml.Marshal(cluster.Status)
+	assert.NilError(t, err)
+	assert.Assert(t, strings.Contains(string(statusYAML), "databaseInitSQL: my-config-map"))
+}
+
+
+
+func TestDatabaseInitSQLDeepCopy(t *testing.T) {
+	cluster := &PostgresCluster{}
+	cluster.Spec.DatabaseInitSQL = &DatabaseInitSQL{
+		Name: "original-name",
+		Key:  "original-key",
+	}
+	applied := "original-status"
+	cluster.Status.DatabaseInitSQL = &applied
+
+	out := cluster.DeepCopy()
+
+
+	assert.Assert(t, out.Spec.DatabaseInitSQL != cluster.Spec.DatabaseInitSQL)
+	assert.Equal(t, *out.Spec.DatabaseInitSQL, *cluster.Spec.DatabaseInitSQL)
+	assert.Assert(t, out.Status.DatabaseInitSQL != cluster.Status.DatabaseInitSQL)
+	assert.Equal(t, *out.Status.DatabaseInitSQL, *cluster.Status.DatabaseInitSQL)
+
+
+	cluster.Spec.DatabaseInitSQL.Name = "changed"
+	*cluster.Status.DatabaseInitSQL = "changed"
+	assert.Equal(t, out.Spec.DatabaseInitSQL.Name, "original-name")
+	assert.Equal(t, *out.Status.DatabaseInitSQL, "original-status")
+}
