+func writableObservedInstance(namespace string) *observedInstances {
+	return &observedInstances{forCluster: []*Instance{
+		{
+			Name: "instance",
+			Pods: []*corev1.Pod{{
+				ObjectMeta: metav1.ObjectMeta{
+					Namespace: namespace,
+					Name:      "pod",
+					Annotations: map[string]string{
+						"status": `{"role":"master"}`,
+					},
+				},
+				Status: corev1.PodStatus{
+					ContainerStatuses: []corev1.ContainerStatus{{
+						Name: naming.ContainerDatabase,
+						State: corev1.ContainerState{
+							Running: new(corev1.ContainerStateRunning),
+						},
+					}},
+				},
+			}},
+			Runner: &appsv1.StatefulSet{},
+		},
+	}}
+}
+
+func TestReconcileDatabaseInitSQLStatusHandling(t *testing.T) {
+	ctx := context.Background()
+	var called bool
+
+	env, tClient, _ := setupTestEnv(t, ControllerName)
+	t.Cleanup(func() { teardownTestEnv(t, env) })
+
+	r := &Reconciler{
+		Client: tClient,
+		PodExec: func(namespace, pod, container string, stdin io.Reader, stdout,
+			stderr io.Writer, command ...string) error {
+			called = true
+			return nil
+		},
+	}
+
+	ns := &corev1.Namespace{}
+	ns.GenerateName = "postgres-operator-test-"
+	ns.Labels = labels.Set{"postgres-operator-test": ""}
+	assert.NilError(t, tClient.Create(ctx, ns))
+	t.Cleanup(func() { assert.Check(t, tClient.Delete(ctx, ns)) })
+
+	observed := writableObservedInstance(ns.Name)
+
+
+	path := "init.sql"
+	cm := corev1.ConfigMap{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "test-cm",
+			Namespace: ns.Name,
+		},
+		Data: map[string]string{path: "SELECT 1;"},
+	}
+	assert.NilError(t, tClient.Create(ctx, cm.DeepCopy()))
+
+	base := testCluster()
+	base.Namespace = ns.Name
+	base.Spec.DatabaseInitSQL = &v1beta1.DatabaseInitSQL{
+		Name: cm.Name,
+		Key:  path,
+	}
+
+	applied := "already-applied"
+
+	t.Run("spec absent clears status", func(t *testing.T) {
+		called = false
+		cluster := base.DeepCopy()
+		cluster.Spec.DatabaseInitSQL = nil
+		cluster.Status.DatabaseInitSQL = &applied
+
+		assert.NilError(t, r.reconcileDatabaseInitSQL(ctx, cluster, observed))
+		assert.Assert(t, !called, "SQL must not be executed when spec is absent")
+		assert.Assert(t, cluster.Status.DatabaseInitSQL == nil,
+			"status must be cleared when spec is absent")
+	})
+
+	t.Run("spec absent and status already nil", func(t *testing.T) {
+		called = false
+		cluster := base.DeepCopy()
+		cluster.Spec.DatabaseInitSQL = nil
+
+		assert.NilError(t, r.reconcileDatabaseInitSQL(ctx, cluster, observed))
+		assert.Assert(t, !called)
+		assert.Assert(t, cluster.Status.DatabaseInitSQL == nil)
+	})
+
+	t.Run("already applied is a no-op", func(t *testing.T) {
+		called = false
+		cluster := base.DeepCopy()
+		cluster.Status.DatabaseInitSQL = &applied
+
+		assert.NilError(t, r.reconcileDatabaseInitSQL(ctx, cluster, observed))
+		assert.Assert(t, !called, "SQL must not run again once status is set")
+		assert.Assert(t, cluster.Status.DatabaseInitSQL != nil)
+		assert.Equal(t, *cluster.Status.DatabaseInitSQL, applied,
+			"status must be left unchanged when already applied")
+	})
+
+	t.Run("no writable instance", func(t *testing.T) {
+		called = false
+		cluster := base.DeepCopy()
+
+
+
+		replica := &observedInstances{forCluster: []*Instance{
+			{
+				Name: "replica",
+				Pods: []*corev1.Pod{{
+					ObjectMeta: metav1.ObjectMeta{
+						Namespace: ns.Name,
+						Name:      "replica-pod",
+						Annotations: map[string]string{
+							"status": `{"role":"replica"}`,
+						},
+					},
+					Status: corev1.PodStatus{
+						ContainerStatuses: []corev1.ContainerStatus{{
+							Name: naming.ContainerDatabase,
+							State: corev1.ContainerState{
+								Running: new(corev1.ContainerStateRunning),
+							},
+						}},
+					},
+				}},
+				Runner: &appsv1.StatefulSet{},
+			},
+		}}
+
+		assert.NilError(t, r.reconcileDatabaseInitSQL(ctx, cluster, replica))
+		assert.Assert(t, !called, "SQL cannot run without a writable instance")
+		assert.Assert(t, cluster.Status.DatabaseInitSQL == nil,
+			"status must stay unset so it is retried later")
+	})
+
+	t.Run("applies and records status on success", func(t *testing.T) {
+		called = false
+		cluster := base.DeepCopy()
+
+		assert.NilError(t, r.reconcileDatabaseInitSQL(ctx, cluster, observed))
+		assert.Assert(t, called, "SQL must be executed against the writable pod")
+		assert.Assert(t, cluster.Status.DatabaseInitSQL != nil,
+			"status must be recorded after a successful run")
+	})
+}
