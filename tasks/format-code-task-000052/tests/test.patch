+func TestReconcileDatabaseInitSQLConfigMapErrors(t *testing.T) {
+	ctx := context.Background()
+	var called bool
+
+	env, tClient, _ := setupTestEnv(t, ControllerName)
+	t.Cleanup(func() { teardownTestEnv(t, env) })
+
+	r := &Reconciler{
+		Client: tClient,
+		PodExec: func(namespace, pod, container string, stdin io.Reader, stdout,
+			stderr io.Writer, command ...string) error {
+			called = true
+			return nil
+		},
+	}
+
+	ns := &corev1.Namespace{}
+	ns.GenerateName = "postgres-operator-test-"
+	ns.Labels = labels.Set{"postgres-operator-test": ""}
+	assert.NilError(t, tClient.Create(ctx, ns))
+	t.Cleanup(func() { assert.Check(t, tClient.Delete(ctx, ns)) })
+
+	observed := writableObservedInstance(ns.Name)
+
+	base := testCluster()
+	base.Namespace = ns.Name
+
+	t.Run("configmap not found", func(t *testing.T) {
+		called = false
+		cluster := base.DeepCopy()
+		cluster.Spec.DatabaseInitSQL = &v1beta1.DatabaseInitSQL{
+			Name: "does-not-exist",
+			Key:  "init.sql",
+		}
+
+		err := r.reconcileDatabaseInitSQL(ctx, cluster, observed)
+		assert.Assert(t, apierrors.IsNotFound(err), "expected a not-found error, got: %v", err)
+		assert.Assert(t, !called)
+		assert.Assert(t, cluster.Status.DatabaseInitSQL == nil)
+	})
+
+	t.Run("missing key", func(t *testing.T) {
+		called = false
+		cm := &corev1.ConfigMap{
+			ObjectMeta: metav1.ObjectMeta{
+				Name:      "no-key",
+				Namespace: ns.Name,
+			},
+		}
+		assert.NilError(t, tClient.Create(ctx, cm))
+
+		cluster := base.DeepCopy()
+		cluster.Spec.DatabaseInitSQL = &v1beta1.DatabaseInitSQL{
+			Name: cm.Name,
+			Key:  "missing-key",
+		}
+
+		err := r.reconcileDatabaseInitSQL(ctx, cluster, observed)
+		assert.Assert(t, err != nil, "expected an error for the missing key")
+		assert.Assert(t, strings.Contains(err.Error(), "missing-key"),
+			"error must identify the missing key, got: %v", err)
+		assert.Assert(t, !called)
+		assert.Assert(t, cluster.Status.DatabaseInitSQL == nil)
+	})
+
+	t.Run("found with data", func(t *testing.T) {
+		called = false
+		path := "init.sql"
+		cm := &corev1.ConfigMap{
+			ObjectMeta: metav1.ObjectMeta{
+				Name:      "with-data",
+				Namespace: ns.Name,
+			},
+			Data: map[string]string{path: "SELECT 1;"},
+		}
+		assert.NilError(t, tClient.Create(ctx, cm))
+
+		cluster := base.DeepCopy()
+		cluster.Spec.DatabaseInitSQL = &v1beta1.DatabaseInitSQL{
+			Name: cm.Name,
+			Key:  path,
+		}
+
+		assert.NilError(t, r.reconcileDatabaseInitSQL(ctx, cluster, observed))
+		assert.Assert(t, called)
+		assert.Assert(t, cluster.Status.DatabaseInitSQL != nil)
+	})
+}
