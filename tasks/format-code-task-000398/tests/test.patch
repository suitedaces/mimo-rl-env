+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+cd /testbed
+
+set -e
+
+
+case "${1:-}" in
+  base)
+    go test ./pkg/util/env -count=1
+    ;;
+  new)
+    go test -v ./build/yamls -run 'Test(InstallManifestsIncludeClusterIdentityConfigMap|InstallManifestsIncludeScopedClusterIdentityReaderRole|ControllerRoleCanPersistClusterIdentity|FlowAggregatorBindsClusterIdentityReader|BaseKustomizationReferencesClusterIdentityReader)$' -count=1
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
