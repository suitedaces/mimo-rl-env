diff --git a/test/new-unit/pgp-keyparams-test.js b/test/new-unit/pgp-keyparams-test.js
new file mode 100644
index 0000000..76daff6
--- /dev/null
+++ b/test/new-unit/pgp-keyparams-test.js
@@ -0,0 +1,116 @@
+define(function(require) {
+    'use strict';
+
+    var PGP = require('js/crypto/pgp'),
+        expect = chai.expect;
+
+    describe('PGP key params unit tests', function() {
+        var pgp,
+            passphrase = 'asdf',
+            keyId = 'F6F60E9B42CDFF4C',
+            fingerprint = '5856CEF789C3A307E8A1B976F6F60E9B42CDFF4C',
+            emailAddress = 'whiteout.test@t-online.de',
+            userName = 'Whiteout User',
+            bitSize = 512,
+            pubkey = '-----BEGIN PGP PUBLIC KEY BLOCK-----\r\n' +
+                'Version: OpenPGP.js v0.3.0\r\n' +
+                'Comment: http://openpgpjs.org\r\n' +
+                '\r\n' +
+                'xk0EUlhMvAEB/2MZtCUOAYvyLFjDp3OBMGn3Ev8FwjzyPbIF0JUw+L7y2XR5\r\n' +
+                'RVGvbK88unV3cU/1tOYdNsXI6pSp/Ztjyv7vbBUAEQEAAc0pV2hpdGVvdXQg\r\n' +
+                'VXNlciA8d2hpdGVvdXQudGVzdEB0LW9ubGluZS5kZT7CXAQQAQgAEAUCUlhM\r\n' +
+                'vQkQ9vYOm0LN/0wAAAW4Af9C+kYW1AvNWmivdtr0M0iYCUjM9DNOQH1fcvXq\r\n' +
+                'IiN602mWrkd8jcEzLsW5IUNzVPLhrFIuKyBDTpLnC07Loce1\r\n' +
+                '=6XMW\r\n' +
+                '-----END PGP PUBLIC KEY BLOCK-----\r\n\r\n',
+            privkey = '-----BEGIN PGP PRIVATE KEY BLOCK-----\r\n' +
+                'Version: OpenPGP.js v0.3.0\r\n' +
+                'Comment: http://openpgpjs.org\r\n' +
+                '\r\n' +
+                'xcBeBFJYTLwBAf9jGbQlDgGL8ixYw6dzgTBp9xL/BcI88j2yBdCVMPi+8tl0\r\n' +
+                'eUVRr2yvPLp1d3FP9bTmHTbFyOqUqf2bY8r+72wVABEBAAH+AwMIhNB4ivtv\r\n' +
+                'Y2xg6VeMcjjHxZayESHACV+nQx5Tx6ev6xzIF1Qh72fNPDppLhFSFOuTTMsU\r\n' +
+                'kTN4c+BVYt29spH+cA1jcDAxQ2ULrNAXo+hheOqhpedTs8aCbcLFkJAS16hk\r\n' +
+                'YSk4OnJgp/z24rVju1SHRSFbgundPzmNgXeX9e8IkviGhhQ11Wc5YwVkx03t\r\n' +
+                'Z3MdDMF0jyhopbPIoBdyJB0dhvBh98w3JmwpYh9wjUA9MBHD1tvHpRmSZ3BM\r\n' +
+                'UCmATn2ZLWBRWiYqFbgDnL1GM80pV2hpdGVvdXQgVXNlciA8d2hpdGVvdXQu\r\n' +
+                'dGVzdEB0LW9ubGluZS5kZT7CXAQQAQgAEAUCUlhMvQkQ9vYOm0LN/0wAAAW4\r\n' +
+                'Af9C+kYW1AvNWmivdtr0M0iYCUjM9DNOQH1fcvXqIiN602mWrkd8jcEzLsW5\r\n' +
+                'IUNzVPLhrFIuKyBDTpLnC07Loce1\r\n' +
+                '=ULta\r\n' +
+                '-----END PGP PRIVATE KEY BLOCK-----\r\n';
+
+        beforeEach(function() {
+            pgp = new PGP();
+        });
+
+        afterEach(function() {});
+
+        describe('from an armored public key', function() {
+            it('should read the key parameters', function() {
+                var params = pgp.getKeyParams(pubkey);
+
+                expect(params._id).to.equal(keyId);
+                expect(params.fingerprint).to.equal(fingerprint);
+                expect(params.userId).to.equal(emailAddress);
+                expect(params.bitSize).to.equal(bitSize);
+                expect(params.userIds).to.deep.equal([{
+                    name: userName,
+                    emailAddress: emailAddress
+                }]);
+            });
+        });
+
+        describe('from an armored private key', function() {
+            it('should read the same key parameters', function() {
+                var params = pgp.getKeyParams(privkey);
+
+                expect(params._id).to.equal(keyId);
+                expect(params.fingerprint).to.equal(fingerprint);
+                expect(params.userId).to.equal(emailAddress);
+                expect(params.bitSize).to.equal(bitSize);
+                expect(params.userIds).to.deep.equal([{
+                    name: userName,
+                    emailAddress: emailAddress
+                }]);
+            });
+        });
+
+        describe('from the currently imported key', function() {
+            it('should describe the imported key when no argument is given', function(done) {
+                pgp.importKeys({
+                    passphrase: passphrase,
+                    privateKeyArmored: privkey,
+                    publicKeyArmored: pubkey
+                }, function(err) {
+                    expect(err).to.not.exist;
+
+                    var params = pgp.getKeyParams();
+                    expect(params._id).to.equal(keyId);
+                    expect(params.fingerprint).to.equal(fingerprint);
+                    expect(params.userId).to.equal(emailAddress);
+                    expect(params.bitSize).to.equal(bitSize);
+                    expect(params.userIds).to.deep.equal([{
+                        name: userName,
+                        emailAddress: emailAddress
+                    }]);
+                    done();
+                });
+            });
+        });
+
+        describe('error handling', function() {
+            it('should throw when no key is available', function() {
+                expect(function() {
+                    pgp.getKeyParams();
+                }).to.throw(Error);
+            });
+
+            it('should throw on unparseable input', function() {
+                expect(function() {
+                    pgp.getKeyParams('this is not a valid armored key');
+                }).to.throw(Error);
+            });
+        });
+    });
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+TD=/testbed/.build_env/test_deps/node_modules
+RUNNER="$(mktemp /tmp/mrun.XXXXXX.js)"
+trap 'rm -f "$RUNNER"' EXIT
+cat > "$RUNNER" <<'EOF'
+var TD = '/testbed/.build_env/test_deps/node_modules/';
+global.requirejs = require(TD + 'requirejs');
+global.chai = require(TD + 'chai');
+global.sinon = require(TD + 'sinon');
+var Mocha = require(TD + 'mocha');
+var mocha = new Mocha({ ui: 'bdd', reporter: 'spec', timeout: 20000 });
+mocha.suite.emit('pre-require', global, 'global-mocha', mocha);
+
+global.requirejs.config({
+    baseUrl: '/testbed/src/lib',
+    paths: {
+        js: '../js',
+        test: '../../test',
+        cryptoLib: '../js/crypto',
+        underscore: 'underscore/underscore-min',
+        openpgp: 'openpgp/openpgp.min'
+    },
+    nodeRequire: require
+});
+
+var testModule = process.argv[2];
+global.requirejs([testModule], function() {
+    mocha.run(function(failures) {
+        process.exit(failures ? 1 : 0);
+    });
+}, function(err) {
+    console.error('LOAD_ERROR', err && err.message);
+    process.exit(2);
+});
+EOF
+
+
+node "$RUNNER" test/new-unit/pgp-test
+
+
+node "$RUNNER" test/new-unit/pgp-keyparams-test
