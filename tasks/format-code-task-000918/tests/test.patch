@@ -0,0 +1,31 @@
+import pathlib
+import unittest
+
+
+class TestReleaseScripts(unittest.TestCase):
+    def test_packaging_version_commands_do_not_pipe_placeholder_svg(self):
+        scripts = (
+            pathlib.Path("Makefile"),
+            pathlib.Path("distribute/distribute.sh"),
+        )
+
+        for script in scripts:
+            text = script.read_text(encoding="utf-8")
+            version_lines = [
+                line
+                for line in text.splitlines()
+                if "sendto_silhouette.py" in line
+                and "--version" in line
+                and not line.lstrip().startswith("#")
+            ]
+
+            self.assertTrue(
+                version_lines,
+                "%s should invoke sendto_silhouette.py --version" % script,
+            )
+
+            for line in version_lines:
+                before_command = line.split("sendto_silhouette.py", 1)[0]
+                self.assertNotIn("|", before_command, line)
+                self.assertNotIn("<svg", line.lower(), line)
+                self.assertNotIn("placeholder", line.lower(), line)
