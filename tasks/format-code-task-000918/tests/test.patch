+    def _run_cli(self, *args):
+        return subprocess.run(
+            [sys.executable, "sendto_silhouette.py", *args],
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            timeout=20,
+        )
+
+    def _assert_success(self, result):
+        self.assertEqual(
+            result.returncode,
+            0,
+            "stdout:\n%s\nstderr:\n%s" % (result.stdout, result.stderr),
+        )
+
+    def _version_output(self, *args):
+        result = self._run_cli(*args)
+        self._assert_success(result)
+        output = result.stdout.strip()
+        self.assertTrue(output, "version command should print a non-empty version")
+        self.assertNotIn("Traceback", result.stdout + result.stderr)
+        return output
+
+    def test_version_without_svg_input_long_option(self):
+        output = self._version_output("--version")
+
+        self.assertRegex(output, r"^\d+(?:\.\d+)+")
+
+    def test_version_without_svg_input_short_option(self):
+        expected = self._version_output("--version")
+        actual = self._version_output("-V")
+
+        self.assertEqual(actual, expected)
+
+    def test_comma_separated_viewbox_is_accepted(self):
