+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest test/test_run.py -v \
+      --ignore=test/test_release_scripts.py \
+      -k 'not test_version_without_svg_input_long_option and not test_version_without_svg_input_short_option and not test_comma_separated_viewbox_is_accepted'
+    ;;
+  new)
+    python3 -m pytest \
+      test/test_run.py::TestRun::test_version_without_svg_input_long_option \
+      test/test_run.py::TestRun::test_version_without_svg_input_short_option \
+      test/test_run.py::TestRun::test_comma_separated_viewbox_is_accepted \
+      test/test_release_scripts.py::TestReleaseScripts::test_packaging_version_commands_do_not_pipe_placeholder_svg \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
