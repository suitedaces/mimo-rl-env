+def test_adfuller_constant_series_exact_issue():
+
+
+    with pytest.raises(ValueError, match="constant"):
+        adfuller(np.full(8, 5.0))
+
+
+def test_adfuller_constant_zero_series():
+
+    with pytest.raises(ValueError, match="constant"):
+        adfuller(np.zeros(20))
+
+
+def test_adfuller_constant_negative_value():
+
+    with pytest.raises(ValueError, match="constant"):
+        adfuller(np.full(15, -3.5))
+
+
+def test_adfuller_constant_with_regression_ct():
+
+    with pytest.raises(ValueError, match="constant"):
+        adfuller(np.full(20, 7.0), regression="ct")
+
+
+def test_adfuller_constant_with_autolag_none():
+
+    with pytest.raises(ValueError, match="constant"):
+        adfuller(np.full(20, 7.0), autolag=None, maxlag=2)
+
+
+def test_adfuller_constant_no_runtime_warning():
+
+    with warnings.catch_warnings():
+        warnings.simplefilter("error", RuntimeWarning)
+        with pytest.raises(ValueError, match="constant"):
+            adfuller(np.full(8, 5.0))
+
+
+def test_adfuller_non_constant_series_preserved():
+
+    rng = np.random.default_rng(42)
+    y = rng.standard_normal(100)
+    result = adfuller(y)
+
+    assert len(result) == 6
+    adf_stat, pvalue, usedlag, nobs, crit, icbest = result
+    assert np.isfinite(adf_stat)
+    assert 0.0 <= pvalue <= 1.0
+    assert isinstance(usedlag, (int, np.integer))
+    assert isinstance(nobs, (int, np.integer))
+    assert set(crit.keys()) == {"1%", "5%", "10%"}
+
+
