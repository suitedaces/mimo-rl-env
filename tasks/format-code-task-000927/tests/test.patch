--- a/tests/test_api.py
+++ b/tests/test_api.py
@@ -725,3 +725,118 @@ class TestSyntaxErrorReporting(util.TestCase):
         self.assertEqual(e.line, None)
         self.assertEqual(e.col, None)
         self.assertEqual(str(e), 'Syntax Message')
+
+
+class TestEscape(util.TestCase):
+    """Tests for the public ``escape`` CSS-identifier escape API."""
+
+    def test_escape_api_exists(self):
+        """``sv.escape`` must be exposed as a callable public API."""
+
+        self.assertTrue(hasattr(sv, 'escape'))
+        self.assertTrue(callable(sv.escape))
+
+    def test_escape_typical_alpha(self):
+        """Plain ASCII alphabetic identifier passes through unchanged."""
+
+        self.assertEqual(sv.escape('hello'), 'hello')
+
+    def test_escape_empty_string(self):
+        """Empty input returns empty output."""
+
+        self.assertEqual(sv.escape(''), '')
+
+    def test_escape_null_char_becomes_replacement(self):
+        """NULL (U+0000) is replaced by REPLACEMENT CHARACTER (U+FFFD)."""
+
+        self.assertEqual(sv.escape('\x00'), '\ufffd')
+
+    def test_escape_null_in_middle(self):
+        """NULL in middle of identifier is replaced by U+FFFD."""
+
+        self.assertEqual(sv.escape('a\x00b'), 'a\ufffdb')
+
+    def test_escape_control_low(self):
+        """U+0001 is escaped as code point ``\\1 ``."""
+
+        self.assertEqual(sv.escape('\x01'), '\\1 ')
+
+    def test_escape_control_high(self):
+        """U+001F is escaped as code point ``\\1f ``."""
+
+        self.assertEqual(sv.escape('\x1f'), '\\1f ')
+
+    def test_escape_del_char(self):
+        """U+007F (DEL) is escaped as code point ``\\7f ``."""
+
+        self.assertEqual(sv.escape('\x7f'), '\\7f ')
+
+    def test_escape_first_digit(self):
+        """First character is a digit -> escaped as code point."""
+
+        self.assertEqual(sv.escape('1abc'), '\\31 abc')
+
+    def test_escape_non_first_digit(self):
+        """Digits that are not the first character pass through."""
+
+        self.assertEqual(sv.escape('a1'), 'a1')
+
+    def test_escape_dash_then_digit(self):
+        """First char ``-`` followed by digit: digit escaped as code point."""
+
+        self.assertEqual(sv.escape('-1abc'), '-\\31 abc')
+
+    def test_escape_single_dash(self):
+        """A single ``-`` with no second char is escaped to ``\\-``."""
+
+        self.assertEqual(sv.escape('-'), '\\-')
+
+    def test_escape_double_dash_no_escape(self):
+        """``--abc`` is not escaped (second char is ``-``, not a digit)."""
+
+        self.assertEqual(sv.escape('--abc'), '--abc')
+
+    def test_escape_dash_then_alpha(self):
+        """``-a`` passes through unchanged."""
+
+        self.assertEqual(sv.escape('-a'), '-a')
+
+    def test_escape_underscore(self):
+        """Underscore is a valid identifier char and passes through."""
+
+        self.assertEqual(sv.escape('a_b'), 'a_b')
+
+    def test_escape_internal_dash(self):
+        """Internal dash passes through."""
+
+        self.assertEqual(sv.escape('a-b'), 'a-b')
+
+    def test_escape_high_unicode(self):
+        """Characters >= U+0080 pass through unchanged."""
+
+        self.assertEqual(sv.escape('\u00ff'), '\u00ff')
+
+    def test_escape_high_unicode_bmp(self):
+        """Characters >= U+0080 in BMP pass through unchanged."""
+
+        self.assertEqual(sv.escape('caf\u00e9'), 'caf\u00e9')
+
+    def test_escape_special_char_dot(self):
+        """``.`` is not a valid identifier char, gets escaped as ``\\.``."""
+
+        self.assertEqual(sv.escape('a.b'), 'a\\.b')
+
+    def test_escape_special_char_space(self):
+        """Space is not a valid identifier char, escaped as ``\\ ``."""
+
+        self.assertEqual(sv.escape('a b'), 'a\\ b')
+
+    def test_escape_uppercase_passthrough(self):
+        """Uppercase A-Z characters pass through unchanged."""
+
+        self.assertEqual(sv.escape('ABCxyz'), 'ABCxyz')
+
+    def test_escape_dash_underscore_first(self):
+        """``-_abc`` passes through (second char is ``_``, not a digit)."""
+
+        self.assertEqual(sv.escape('-_abc'), '-_abc')
