diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,25 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+dev-switch node 22
+npm install 2>&1 | tail -3
+
+
+case "${1:-}" in
+  base)
+    git apply --reverse --whitespace=nowarn /testbed/mimo_test.patch
+    status=0
+    npx mocha test/subgenerators.js test/test-core.js || status=$?
+    git apply --whitespace=nowarn /testbed/mimo_test.patch
+    exit "$status"
+    ;;
+  new)
+    npx mocha test/subgenerators.js test/test-core.js
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
