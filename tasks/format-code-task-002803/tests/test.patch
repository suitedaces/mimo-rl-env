new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/fixtures/offline-recorder.js
@@ -0,0 +1,146 @@
+const fs = require("fs");
+const Module = require("module");
+
+const outPath = process.env.TEDICROSS_RECORDER_OUT;
+const records = [];
+
+function write(type, payload) {
+	records.push({ type, payload });
+	if (outPath) {
+		fs.writeFileSync(outPath, JSON.stringify(records, null, 2));
+	}
+}
+
+const originalLoad = Module._load;
+
+Module._load = function (request, parent, isMain) {
+	if (request === "sqlite3") {
+
+		return {
+			Database: class {},
+			verbose() {
+				return this;
+			}
+		};
+	}
+
+	if (request === "sqlite") {
+
+		return {
+			open: () => Promise.resolve({}),
+			Database: class {}
+		};
+	}
+
+	if (request === "telegraf") {
+		class Telegraf {
+			constructor(token) {
+				write("telegraf.constructor", { token });
+				if (token === "env" || token === undefined || token === null || token === "") {
+					console.error("Bot Token is required");
+					process.exit(1);
+				}
+				this.telegram = {
+					getMe: () => new Promise(() => {}),
+					getUpdates: () => Promise.resolve([]),
+					setMyCommands: () => Promise.resolve(),
+					getMyCommands: () => Promise.resolve([{ command: "chatinfo" }, { command: "threadinfo" }]),
+					setMyDefaultAdministratorRights: () => Promise.resolve(),
+					sendMessage: () => Promise.resolve({ message_id: 1 }),
+					deleteMessage: () => Promise.resolve(true)
+				};
+				this.context = {};
+			}
+			command() {}
+			use() {}
+			on() {}
+			catch() {}
+			startPolling() {
+				write("telegraf.startPolling", {});
+				return Promise.resolve();
+			}
+		}
+		return { Telegraf };
+	}
+
+	if (request === "discord.js") {
+		class Collection extends Map {}
+		class Client {
+			constructor(options) {
+				write("discord.constructor", { options });
+				this.options = options;
+				this.user = { id: "probe-discord", username: "ProbeDiscord" };
+				this.commands = new Collection();
+			}
+			on(event) {
+				write("discord.on", { event });
+				return this;
+			}
+			once(event) {
+				write("discord.once", { event });
+				return this;
+			}
+			login(token) {
+				write("discord.login", { token });
+				if (token === "env" || token === undefined || token === null || token === "") {
+					console.error("Invalid token");
+					process.exit(1);
+				}
+				return Promise.resolve(token);
+			}
+		}
+
+		class SlashCommandBuilder {
+			constructor() {
+				this.obj = {};
+			}
+			setName(name) {
+				this.obj.name = name;
+				return this;
+			}
+			setDescription(description) {
+				this.obj.description = description;
+				return this;
+			}
+			setDefaultMemberPermissions(permissions) {
+				this.obj.default_member_permissions = permissions;
+				return this;
+			}
+			toJSON() {
+				return this.obj;
+			}
+		}
+
+		class REST {
+			setToken(token) {
+				write("discord.rest.setToken", { token });
+				return this;
+			}
+			put(route, body) {
+				write("discord.rest.put", { route, body });
+				return Promise.resolve([]);
+			}
+		}
+
+		return {
+			Client,
+			Collection,
+			GatewayIntentBits: { Guilds: 1, GuildMessages: 2, MessageContent: 4 },
+			ActivityType: { Custom: 4 },
+			MessageReferenceType: { Forward: 1 },
+			MessageType: {},
+			REST,
+			Routes: { applicationCommands: id => `/applications/${id}/commands` },
+			TextChannel: class {},
+			SlashCommandBuilder,
+			PermissionFlagsBits: { Administrator: "8" }
+		};
+	}
+
+	return originalLoad.apply(this, arguments);
+};
+
+setTimeout(() => {
+	write("probe.exit", {});
+	process.exit(0);
+}, 25);
diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
