+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,300 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+( cd /workspace/repo && test -x node_modules/.bin/tsc && node_modules/.bin/tsc --noEmitOnError false || test -f dist/main.js ) \
+	|| { echo "FAIL: build" >&2; exit 1; }
+
+BIN=/workspace/repo/dist/main.js
+RECORDER=/workspace/repo/usercase-test-coderl/fixtures/offline-recorder.js
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || exit 1
+
+fail() {
+	echo "FAIL: $*" >&2
+	exit 1
+}
+
+extract_record_token() {
+	node - "$1" "$2" <<'NODE'
+const fs = require("fs");
+const file = process.argv[2];
+const type = process.argv[3];
+const records = JSON.parse(fs.readFileSync(file, "utf8"));
+const record = records.find(item => item.type === type);
+if (!record) process.exit(2);
+process.stdout.write(String(record.payload.token));
+NODE
+}
+
+settings_snapshot() {
+	node - "$1" <<'NODE'
+const fs = require("fs");
+const yaml = require("/workspace/repo/node_modules/js-yaml");
+const settings = yaml.load(fs.readFileSync(process.argv[2], "utf8"));
+const snapshot = {
+	telegram: {
+		token: settings.telegram.token,
+		useFirstNameInsteadOfUsername: settings.telegram.useFirstNameInsteadOfUsername,
+		colonAfterSenderName: settings.telegram.colonAfterSenderName,
+		skipOldMessages: settings.telegram.skipOldMessages,
+		sendEmojiWithStickers: settings.telegram.sendEmojiWithStickers,
+		useCustomEmojiFilter: settings.telegram.useCustomEmojiFilter,
+		replaceAtWithHash: settings.telegram.replaceAtWithHash,
+		replaceExcessiveSpaces: settings.telegram.replaceExcessiveSpaces,
+		removeNewlineSpaces: settings.telegram.removeNewlineSpaces,
+		suppressFileTooBigMessages: settings.telegram.suppressFileTooBigMessages,
+		suppressThisIsPrivateBotMessage: settings.telegram.suppressThisIsPrivateBotMessage
+	},
+	discord: {
+		token: settings.discord.token,
+		skipOldMessages: settings.discord.skipOldMessages,
+		useNickname: settings.discord.useNickname,
+		replyLength: settings.discord.replyLength,
+		maxReplyLines: settings.discord.maxReplyLines,
+		suppressThisIsPrivateBotMessage: settings.discord.suppressThisIsPrivateBotMessage,
+		enableCustomStatus: settings.discord.enableCustomStatus,
+		customStatusMessage: settings.discord.customStatusMessage,
+		useEmbeds: settings.discord.useEmbeds
+	}
+};
+process.stdout.write(JSON.stringify(snapshot));
+NODE
+}
+
+run_offline_startup() {
+	local name=$1
+	local config=$2
+	local out=$TMP/$name.out
+	local err=$TMP/$name.err
+	local records=$TMP/$name.records.json
+	mkdir -p "$TMP/$name-data"
+	TELEGRAM_BOT_TOKEN='tg-env-value' \
+		DISCORD_BOT_TOKEN='dc-env-value' \
+		TEDICROSS_RECORDER_OUT="$records" \
+		node -r "$RECORDER" "$BIN" --config "$config" --data-dir "$TMP/$name-data" >"$out" 2>"$err"
+	local ec=$?
+	[ "$ec" -eq 0 ] || fail "$name exit $ec; want 0"
+	[ -f "$records" ] || fail "$name did not write recorder output"
+}
+
+
+
+
+cat > f1.yaml <<'YAML'
+telegram:
+  token: env
+  useFirstNameInsteadOfUsername: true
+  colonAfterSenderName: true
+  skipOldMessages: false
+  sendEmojiWithStickers: false
+  useCustomEmojiFilter: true
+  replaceAtWithHash: true
+  replaceExcessiveSpaces: true
+  removeNewlineSpaces: true
+  suppressFileTooBigMessages: true
+  suppressThisIsPrivateBotMessage: true
+discord:
+  token: env
+  skipOldMessages: false
+  useNickname: true
+  replyLength: 321
+  maxReplyLines: 7
+  suppressThisIsPrivateBotMessage: true
+  enableCustomStatus: true
+  customStatusMessage: 'Probe Status'
+  useEmbeds: never
+bridges: []
+debug: false
+messageTimeoutAmount: 24
+messageTimeoutUnit: hours
+persistentMessageMap: false
+YAML
+run_offline_startup f1 "$TMP/f1.yaml"
+[ "$(extract_record_token "$TMP/f1.records.json" telegraf.constructor)" = "tg-env-value" ] \
+	|| fail "F1 Telegram token was not read from TELEGRAM_BOT_TOKEN"
+[ "$(extract_record_token "$TMP/f1.records.json" discord.login)" = "dc-env-value" ] \
+	|| fail "F1 Discord token was not read from DISCORD_BOT_TOKEN"
+EXPECTED_F1='{"telegram":{"token":"env","useFirstNameInsteadOfUsername":true,"colonAfterSenderName":true,"skipOldMessages":false,"sendEmojiWithStickers":false,"useCustomEmojiFilter":true,"replaceAtWithHash":true,"replaceExcessiveSpaces":true,"removeNewlineSpaces":true,"suppressFileTooBigMessages":true,"suppressThisIsPrivateBotMessage":true},"discord":{"token":"env","skipOldMessages":false,"useNickname":true,"replyLength":321,"maxReplyLines":7,"suppressThisIsPrivateBotMessage":true,"enableCustomStatus":true,"customStatusMessage":"Probe Status","useEmbeds":"never"}}'
+[ "$(settings_snapshot "$TMP/f1.yaml")" = "$EXPECTED_F1" ] || fail "F1 normalized settings changed unexpectedly"
+
+
+
+
+cat > f2.yaml <<'YAML'
+telegram:
+  useFirstNameInsteadOfUsername: true
+  colonAfterSenderName: true
+  skipOldMessages: false
+  sendEmojiWithStickers: false
+  useCustomEmojiFilter: true
+  replaceAtWithHash: true
+  replaceExcessiveSpaces: true
+  removeNewlineSpaces: true
+  suppressFileTooBigMessages: true
+  suppressThisIsPrivateBotMessage: true
+discord:
+  skipOldMessages: false
+  useNickname: true
+  replyLength: 321
+  maxReplyLines: 7
+  suppressThisIsPrivateBotMessage: true
+  enableCustomStatus: true
+  customStatusMessage: 'Probe Status'
+  useEmbeds: never
+bridges: []
+debug: false
+messageTimeoutAmount: 24
+messageTimeoutUnit: hours
+persistentMessageMap: false
+YAML
+run_offline_startup f2 "$TMP/f2.yaml"
+[ "$(extract_record_token "$TMP/f2.records.json" telegraf.constructor)" = "tg-env-value" ] \
+	|| fail "F2 Telegram omitted token did not default to env lookup"
+[ "$(extract_record_token "$TMP/f2.records.json" discord.login)" = "dc-env-value" ] \
+	|| fail "F2 Discord omitted token did not default to env lookup"
+[ "$(settings_snapshot "$TMP/f2.yaml")" = "$EXPECTED_F1" ] || fail "F2 normalized settings did not add env tokens while preserving other values"
+
+
+
+
+cat > f3.yaml <<'YAML'
+telegram:
+  token: 12345:abc
+  useFirstNameInsteadOfUsername: false
+  colonAfterSenderName: true
+  skipOldMessages: false
+  sendEmojiWithStickers: true
+  useCustomEmojiFilter: false
+  replaceAtWithHash: true
+  replaceExcessiveSpaces: false
+  removeNewlineSpaces: true
+  suppressFileTooBigMessages: false
+  suppressThisIsPrivateBotMessage: true
+discord:
+  token: discord-secret
+  skipOldMessages: false
+  useNickname: true
+  replyLength: 44
+  maxReplyLines: 3
+  suppressThisIsPrivateBotMessage: true
+  enableCustomStatus: false
+  customStatusMessage: 'Literal Status'
+  useEmbeds: always
+bridges: []
+debug: false
+messageTimeoutAmount: 24
+messageTimeoutUnit: hours
+persistentMessageMap: false
+YAML
+run_offline_startup f3 "$TMP/f3.yaml"
+[ "$(extract_record_token "$TMP/f3.records.json" telegraf.constructor)" = "12345:abc" ] \
+	|| fail "F3 Telegram literal token was not passed unchanged"
+[ "$(extract_record_token "$TMP/f3.records.json" discord.login)" = "discord-secret" ] \
+	|| fail "F3 Discord literal token was not passed unchanged"
+EXPECTED_F3='{"telegram":{"token":"12345:abc","useFirstNameInsteadOfUsername":false,"colonAfterSenderName":true,"skipOldMessages":false,"sendEmojiWithStickers":true,"useCustomEmojiFilter":false,"replaceAtWithHash":true,"replaceExcessiveSpaces":false,"removeNewlineSpaces":true,"suppressFileTooBigMessages":false,"suppressThisIsPrivateBotMessage":true},"discord":{"token":"discord-secret","skipOldMessages":false,"useNickname":true,"replyLength":44,"maxReplyLines":3,"suppressThisIsPrivateBotMessage":true,"enableCustomStatus":false,"customStatusMessage":"Literal Status","useEmbeds":"always"}}'
+[ "$(settings_snapshot "$TMP/f3.yaml")" = "$EXPECTED_F3" ] || fail "F3 literal settings were not serialized unchanged"
+
+
+
+
+cat > f4a.yaml <<'YAML'
+telegram:
+  token: 12345:abc
+  useFirstNameInsteadOfUsername: true
+  colonAfterSenderName: false
+  skipOldMessages: true
+  sendEmojiWithStickers: false
+  useCustomEmojiFilter: true
+  replaceAtWithHash: false
+  replaceExcessiveSpaces: true
+  removeNewlineSpaces: false
+  suppressFileTooBigMessages: true
+  suppressThisIsPrivateBotMessage: false
+discord:
+  token: env
+  skipOldMessages: true
+  useNickname: false
+  replyLength: 55
+  maxReplyLines: 4
+  suppressThisIsPrivateBotMessage: false
+  enableCustomStatus: false
+  customStatusMessage: 'Mixed Status'
+  useEmbeds: auto
+bridges: []
+debug: false
+messageTimeoutAmount: 24
+messageTimeoutUnit: hours
+persistentMessageMap: false
+YAML
+cp f4a.yaml f4b.yaml
+run_offline_startup f4a "$TMP/f4a.yaml"
+run_offline_startup f4b "$TMP/f4b.yaml"
+[ "$(extract_record_token "$TMP/f4a.records.json" telegraf.constructor)" = "12345:abc" ] \
+	|| fail "F4 Telegram literal token was not preserved in mixed case"
+[ "$(extract_record_token "$TMP/f4a.records.json" discord.login)" = "dc-env-value" ] \
+	|| fail "F4 Discord env token was not resolved in mixed case"
+[ "$(extract_record_token "$TMP/f4b.records.json" telegraf.constructor)" = "12345:abc" ] \
+	|| fail "F4 repeat Telegram token differed"
+[ "$(extract_record_token "$TMP/f4b.records.json" discord.login)" = "dc-env-value" ] \
+	|| fail "F4 repeat Discord token differed"
+EXPECTED_F4='{"telegram":{"token":"12345:abc","useFirstNameInsteadOfUsername":true,"colonAfterSenderName":false,"skipOldMessages":true,"sendEmojiWithStickers":false,"useCustomEmojiFilter":true,"replaceAtWithHash":false,"replaceExcessiveSpaces":true,"removeNewlineSpaces":false,"suppressFileTooBigMessages":true,"suppressThisIsPrivateBotMessage":false},"discord":{"token":"env","skipOldMessages":true,"useNickname":false,"replyLength":55,"maxReplyLines":4,"suppressThisIsPrivateBotMessage":false,"enableCustomStatus":false,"customStatusMessage":"Mixed Status","useEmbeds":"auto"}}'
+[ "$(settings_snapshot "$TMP/f4a.yaml")" = "$EXPECTED_F4" ] || fail "F4 mixed settings snapshot was wrong"
+[ "$(settings_snapshot "$TMP/f4b.yaml")" = "$EXPECTED_F4" ] || fail "F4 repeated mixed settings snapshot was wrong"
+
+
+
+
+cat > ferr.yaml <<'YAML'
+telegram:
+  token: env
+  useFirstNameInsteadOfUsername: false
+  colonAfterSenderName: false
+  skipOldMessages: true
+  sendEmojiWithStickers: true
+  useCustomEmojiFilter: false
+  replaceAtWithHash: false
+  replaceExcessiveSpaces: false
+  removeNewlineSpaces: false
+  suppressFileTooBigMessages: false
+  suppressThisIsPrivateBotMessage: false
+discord:
+  token: env
+  skipOldMessages: true
+  useNickname: false
+  replyLength: 100
+  maxReplyLines: 2
+  suppressThisIsPrivateBotMessage: false
+  enableCustomStatus: false
+  customStatusMessage: TediCross
+  useEmbeds: auto
+bridges: []
+debug: false
+messageTimeoutAmount: 24
+messageTimeoutUnit: hours
+persistentMessageMap: false
+YAML
+mkdir -p "$TMP/ferr-data"
+env -u TELEGRAM_BOT_TOKEN -u DISCORD_BOT_TOKEN \
+	TEDICROSS_RECORDER_OUT="$TMP/ferr.records.json" \
+	timeout 10s node -r "$RECORDER" "$BIN" --config "$TMP/ferr.yaml" --data-dir "$TMP/ferr-data" >ferr.out 2>ferr.err
+ec=$?
+[ "$ec" -ne 0 ] || fail "F_err exit $ec; want non-zero"
+
+if [ -f "$TMP/ferr.records.json" ]; then
+	node - "$TMP/ferr.records.json" <<'NODE' || fail "F_err passed literal env to a bot client"
+const fs = require("fs");
+const records = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
+for (const record of records) {
+	if ((record.type === "telegraf.constructor" || record.type === "discord.login") && record.payload.token === "env") {
+		process.exit(1);
+	}
+}
+NODE
+fi
+
+echo "PASS"
+exit 0
