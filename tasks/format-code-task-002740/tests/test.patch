diff --git a/tests/test_sync_committee_cache.nim b/tests/test_sync_committee_cache.nim
new file mode 100644
index 000000000..644cee4b7
--- /dev/null
+++ b/tests/test_sync_committee_cache.nim
@@ -0,0 +1,72 @@
+
+
+
+
+
+
+
+{.used.}
+
+import
+  std/[options],
+  chronicles,
+  unittest2,
+  eth/keys, taskpools,
+  ../beacon_chain/spec/datatypes/base,
+  ../beacon_chain/spec/[beaconstate, forks, helpers, state_transition],
+  ../beacon_chain/[beacon_chain_db],
+  ../beacon_chain/consensus_object_pools/[blockchain_dag, block_quarantine],
+  ./testutil, ./testdbutil, ./testblockutil
+
+suite "Sync committee index cache" & preset():
+  setup:
+    var
+      cfg = defaultRuntimeConfig
+    cfg.ALTAIR_FORK_EPOCH = Epoch(1)
+
+    var
+      db = makeTestDB(SLOTS_PER_EPOCH)
+      dag = init(ChainDAGRef, cfg, db, {})
+      taskpool = Taskpool.new()
+      quarantine = QuarantineRef.init(keys.newRng(), taskpool)
+      state = newClone(dag.headState.data)
+      cache = StateCache()
+      info = ForkedEpochInfo()
+
+
+    check:
+      process_slots(
+        cfg, state[], cfg.ALTAIR_FORK_EPOCH.compute_start_slot_at_epoch(), cache,
+        info, {})
+
+      state[].kind == BeaconStateFork.Altair
+
+  test "Resolves committee seats to validator indices" & preset():
+    let s = state[].altairData.data
+
+    var c = StateCache()
+    let scc = get_sync_committee_cache(s, c)
+
+    for i in 0 ..< SYNC_COMMITTEE_SIZE:
+      check:
+        s.validators[scc.current_sync_committee[i]].pubkey ==
+          s.current_sync_committee.pubkeys[i]
+        s.validators[scc.next_sync_committee[i]].pubkey ==
+          s.next_sync_committee.pubkeys[i]
+
+  test "Stable across repeated calls" & preset():
+    let s = state[].altairData.data
+
+    var c = StateCache()
+    let
+      first = get_sync_committee_cache(s, c)
+      second = get_sync_committee_cache(s, c)
+
+    var freshCache = StateCache()
+    let third = get_sync_committee_cache(s, freshCache)
+
+    check:
+      first.current_sync_committee == second.current_sync_committee
+      first.next_sync_committee == second.next_sync_committee
+      first.current_sync_committee == third.current_sync_committee
+      first.next_sync_committee == third.next_sync_committee
