diff --git a/mne/time_frequency/tests/test_psd.py b/mne/time_frequency/tests/test_psd.py
index 674b0e484..02d5ca060 100644
--- a/mne/time_frequency/tests/test_psd.py
+++ b/mne/time_frequency/tests/test_psd.py
@@ -289,3 +289,115 @@ def test_compares_psd():
 
     assert (np.sum(psds_welch < 0) == 0)
     assert (np.sum(psds_mpl < 0) == 0)
+
+
+def _expected_median_bias(n):
+    ii_2 = 2 * np.arange(1., (n - 1) // 2 + 1)
+    return 1 + np.sum(1. / (ii_2 + 1) - 1. / ii_2)
+
+
+def test_psd_welch_median_bias_correction():
+    """Median average should divide by Allen-2012 bias factor.
+
+    Verifies that ``psd_array_welch(..., average='median')`` returns the
+    median of the unaggregated periodograms divided by the median bias
+    correction factor (Appendix B of Allen et al. 2012, also used by
+    SciPy's welch).
+    """
+    rng = np.random.RandomState(0)
+    sfreq = 1000.
+    n_per_seg = 128
+    n_overlap = 0
+
+    n_times = n_per_seg * 8
+    x = rng.randn(2, n_times)
+
+    psd_med, _ = psd_array_welch(
+        x, sfreq, n_fft=n_per_seg, n_per_seg=n_per_seg,
+        n_overlap=n_overlap, average='median')
+    psd_unagg, _ = psd_array_welch(
+        x, sfreq, n_fft=n_per_seg, n_per_seg=n_per_seg,
+        n_overlap=n_overlap, average=None)
+
+    n_segments = psd_unagg.shape[-1]
+    assert n_segments == 8
+    bias = _expected_median_bias(n_segments)
+
+    assert not np.isclose(bias, 1.0)
+    expected = np.median(psd_unagg, axis=-1) / bias
+    assert_allclose(psd_med, expected)
+
+    assert not np.allclose(psd_med, np.median(psd_unagg, axis=-1))
+
+
+def test_psd_welch_median_bias_value():
+    """Median PSD must be scaled down by the exact bias factor.
+
+    Pins the numerical value of the bias for 8 segments, ensuring
+    candidates that compute a different bias (or skip the correction)
+    are rejected.
+    """
+    rng = np.random.RandomState(42)
+    sfreq = 1000.
+    n_per_seg = 64
+
+    n_times = n_per_seg * 8
+    x = rng.randn(1, n_times)
+
+    psd_med, _ = psd_array_welch(
+        x, sfreq, n_fft=n_per_seg, n_per_seg=n_per_seg,
+        n_overlap=0, average='median')
+    psd_unagg, _ = psd_array_welch(
+        x, sfreq, n_fft=n_per_seg, n_per_seg=n_per_seg,
+        n_overlap=0, average=None)
+
+    n = psd_unagg.shape[-1]
+    assert n == 8
+
+
+    expected_bias = 1 + (1./3 - 1./2) + (1./5 - 1./4) + (1./7 - 1./6)
+    assert_allclose(expected_bias, 0.7595238095238095)
+    expected = np.median(psd_unagg, axis=-1) / expected_bias
+    assert_allclose(psd_med, expected)
+
+
+def test_psd_welch_mean_unchanged_by_bias_fix():
+    """Mean averaging must not be affected by the median bias fix."""
+    rng = np.random.RandomState(1)
+    sfreq = 1000.
+    n_per_seg = 128
+    n_times = n_per_seg * 5
+    x = rng.randn(2, n_times)
+
+    psd_mean, _ = psd_array_welch(
+        x, sfreq, n_fft=n_per_seg, n_per_seg=n_per_seg,
+        n_overlap=0, average='mean')
+    psd_unagg, _ = psd_array_welch(
+        x, sfreq, n_fft=n_per_seg, n_per_seg=n_per_seg,
+        n_overlap=0, average=None)
+
+    assert_allclose(psd_mean, psd_unagg.mean(axis=-1))
+
+
+def test_psd_welch_median_matches_scipy():
+    """psd_array_welch median must agree with scipy's welch median.
+
+    SciPy's ``welch`` with ``average='median'`` applies the same Allen
+    bias correction. mne should produce equivalent values.
+    """
+    from scipy.signal import welch as sp_welch
+    rng = np.random.RandomState(7)
+    sfreq = 1000.
+    n_per_seg = 128
+    n_times = n_per_seg * 6
+    x = rng.randn(1, n_times)
+
+    psd_med, freqs = psd_array_welch(
+        x, sfreq, n_fft=n_per_seg, n_per_seg=n_per_seg,
+        n_overlap=0, average='median', window='hamming')
+
+    sp_freqs, sp_psd = sp_welch(
+        x[0], fs=sfreq, nperseg=n_per_seg, nfft=n_per_seg,
+        noverlap=0, average='median', window='hamming')
+    assert_allclose(freqs, sp_freqs)
+    assert_allclose(psd_med[0], sp_psd)
