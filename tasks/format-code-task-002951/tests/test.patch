@@ -0,0 +1,370 @@
+package usercase_test_coderl
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/vmware-tanzu/sonobuoy/pkg/config"
+)
+
+const fixtures = "/workspace/repo/usercase-test-coderl/fixtures"
+
+type configSummary struct {
+	Description   string
+	UUID          string
+	LoadedPlugins []string
+}
+
+func summarizeConfig(cfg *config.Config) configSummary {
+
+	pluginNames := make([]string, 0, len(cfg.LoadedPlugins))
+	for _, p := range cfg.LoadedPlugins {
+		pluginNames = append(pluginNames, p.GetName())
+	}
+	sort.Strings(pluginNames)
+
+	return configSummary{
+		Description:   cfg.Description,
+		UUID:          cfg.UUID,
+		LoadedPlugins: pluginNames,
+	}
+}
+
+func assertSummary(t *testing.T, got, want configSummary) {
+	t.Helper()
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("unexpected config summary:\n got: %#v\nwant: %#v", got, want)
+	}
+}
+
+func assertErrorContains(t *testing.T, err error, substrings ...string) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("expected error containing %q, got nil", substrings)
+	}
+	errMessage := strings.ToLower(err.Error())
+	for _, substring := range substrings {
+
+		if !strings.Contains(errMessage, strings.ToLower(substring)) {
+			t.Fatalf("expected error %q to contain %q", err.Error(), substring)
+		}
+	}
+}
+
+func assertErrorPrefix(t *testing.T, err error, prefix string) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("expected error with prefix %q, got nil", prefix)
+	}
+
+	if !strings.HasPrefix(err.Error(), prefix) {
+		t.Fatalf("expected error %q to have prefix %q", err.Error(), prefix)
+	}
+}
+
+func isolateLoadConfigEnv(t *testing.T) {
+	t.Helper()
+	for _, key := range []string{"SONOBUOY_CONFIG", "RESULTS_DIR", "SONOBUOY_ADVERTISE_IP"} {
+		key := key
+		old, ok := os.LookupEnv(key)
+		if err := os.Unsetenv(key); err != nil {
+			t.Fatalf("unset %s: %v", key, err)
+		}
+		t.Cleanup(func() {
+			if ok {
+				_ = os.Setenv(key, old)
+			} else {
+				_ = os.Unsetenv(key)
+			}
+		})
+	}
+}
+
+func setEnv(t *testing.T, key, value string) {
+	t.Helper()
+	if err := os.Setenv(key, value); err != nil {
+		t.Fatalf("set %s: %v", key, err)
+	}
+}
+
+func chdir(t *testing.T, dir string) {
+	t.Helper()
+	old, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chdir(dir); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		_ = os.Chdir(old)
+	})
+}
+
+func writeFile(t *testing.T, path, body string) {
+	t.Helper()
+	if err := os.WriteFile(path, []byte(body), 0644); err != nil {
+		t.Fatalf("write %s: %v", path, err)
+	}
+}
+
+func loadSummary(t *testing.T, paths ...string) configSummary {
+	t.Helper()
+	cfg, err := config.LoadConfig(paths...)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return summarizeConfig(cfg)
+}
+
+func TestLoadConfigSkipsMissingExplicitPathAndLoadsNext(t *testing.T) {
+
+
+
+
+	isolateLoadConfigEnv(t)
+	setEnv(t, "SONOBUOY_ADVERTISE_IP", "198.51.100.7")
+
+	got := loadSummary(t, fixtures+"/missing.json", fixtures+"/good.json")
+	assertSummary(t, got, configSummary{
+		Description:   "smoke",
+		UUID:          "fixed",
+		LoadedPlugins: []string{},
+	})
+}
+
+func TestLoadConfigWithNoPathsUsesSonobuoyConfigEnv(t *testing.T) {
+
+
+
+
+	isolateLoadConfigEnv(t)
+	setEnv(t, "SONOBUOY_CONFIG", fixtures+"/env_config.json")
+	setEnv(t, "SONOBUOY_ADVERTISE_IP", "192.0.2.10")
+
+	got := loadSummary(t)
+	assertSummary(t, got, configSummary{
+		Description:   "env-picked",
+		UUID:          "env-uuid",
+		LoadedPlugins: []string{},
+	})
+}
+
+func TestLoadConfigWithNoPathsUsesDefaultConfigJSON(t *testing.T) {
+
+
+
+
+	isolateLoadConfigEnv(t)
+	setEnv(t, "SONOBUOY_ADVERTISE_IP", "198.51.100.11")
+	tmp := t.TempDir()
+	writeFile(t, filepath.Join(tmp, "config.json"), `{"Description":"default-file","UUID":"default-uuid","Server":{"bindport":6060},"PluginSearchPath":[],"Plugins":[]}`)
+	chdir(t, tmp)
+
+	got := loadSummary(t)
+	assertSummary(t, got, configSummary{
+		Description:   "default-file",
+		UUID:          "default-uuid",
+		LoadedPlugins: []string{},
+	})
+}
+
+func TestLoadConfigWithNoPathsFallsBackToEtcPath(t *testing.T) {
+
+
+
+
+	isolateLoadConfigEnv(t)
+	tmp := t.TempDir()
+	chdir(t, tmp)
+
+	cfg, err := config.LoadConfig()
+	if cfg != nil {
+		t.Fatalf("expected nil config, got %#v", summarizeConfig(cfg))
+	}
+	assertErrorContains(t, err, "open config", "/etc/sonobuoy/config.json")
+}
+
+func TestLoadConfigBadPathErrorIncludesOpenConfig(t *testing.T) {
+
+
+
+
+	isolateLoadConfigEnv(t)
+
+	cfg, err := config.LoadConfig("bad\x00path.json")
+	if cfg != nil {
+		t.Fatalf("expected nil config, got %#v", summarizeConfig(cfg))
+	}
+	assertErrorContains(t, err, "open config")
+}
+
+func TestLoadConfigMalformedJSONReportsUnmarshalForFile(t *testing.T) {
+
+
+
+
+	isolateLoadConfigEnv(t)
+
+	cfg, err := config.LoadConfig(fixtures + "/malformed.json")
+	if cfg != nil {
+		t.Fatalf("expected nil config, got %#v", summarizeConfig(cfg))
+	}
+	assertErrorContains(t, err, "unmarshal", "malformed.json")
+}
+
+func TestLoadConfigResolveAppliesEnvironmentOverridesAndFillsUUID(t *testing.T) {
+
+
+
+
+	isolateLoadConfigEnv(t)
+	setEnv(t, "RESULTS_DIR", "/override/results")
+	setEnv(t, "SONOBUOY_ADVERTISE_IP", "203.0.113.8")
+
+	cfg, err := config.LoadConfig(fixtures + "/resolve_empty_uuid.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := summarizeConfig(cfg)
+	generatedUUID := got.UUID
+	got.UUID = "<generated>"
+	assertSummary(t, got, configSummary{
+		Description:   "resolve",
+		UUID:          "<generated>",
+		LoadedPlugins: []string{},
+	})
+
+	if cfg.ResultsDir != "/override/results" {
+		t.Fatalf("expected RESULTS_DIR override, got %q", cfg.ResultsDir)
+	}
+	if generatedUUID == "" {
+		t.Fatal("expected LoadConfig to replace empty UUID with a generated value; got empty string")
+	}
+}
+
+func TestLoadConfigInitializesSelectedPlugins(t *testing.T) {
+
+
+
+
+	isolateLoadConfigEnv(t)
+	setEnv(t, "SONOBUOY_ADVERTISE_IP", "198.51.100.12")
+
+	got := loadSummary(t, fixtures+"/plugins.json")
+	assertSummary(t, got, configSummary{
+		Description:   "plugins",
+		UUID:          "plugins-uuid",
+		LoadedPlugins: []string{"alpha", "beta"},
+	})
+}
+
+func TestLoadConfigMissingSelectedPluginReturnsConfiguredPluginError(t *testing.T) {
+
+
+
+
+	isolateLoadConfigEnv(t)
+
+	cfg, err := config.LoadConfig(fixtures + "/missing_plugin.json")
+	if cfg != nil {
+		t.Fatalf("expected nil config, got %#v", summarizeConfig(cfg))
+	}
+	assertErrorContains(t, err, "Configured plugin", "missing", "does not exist")
+}
+
+func TestLoadConfigValidationErrorsArePrefixed(t *testing.T) {
+
+
+
+
+	isolateLoadConfigEnv(t)
+
+	cfg, err := config.LoadConfig(fixtures + "/invalid_config.json")
+	if cfg != nil {
+		t.Fatalf("expected nil config, got %#v", summarizeConfig(cfg))
+	}
+	assertErrorPrefix(t, err, "invalid configuration:")
+}
+
+func TestLoadConfigReferentialTransparencyForStableInputs(t *testing.T) {
+	isolateLoadConfigEnv(t)
+	setEnv(t, "SONOBUOY_ADVERTISE_IP", "198.51.100.7")
+	want := configSummary{
+		Description:   "smoke",
+		UUID:          "fixed",
+		LoadedPlugins: []string{},
+	}
+
+	first := loadSummary(t, fixtures+"/good.json")
+	second := loadSummary(t, fixtures+"/good.json")
+	assertSummary(t, first, want)
+	assertSummary(t, second, want)
+	assertSummary(t, second, first)
+}
+
+func TestLoadConfigAcceptsCallerPathSlice(t *testing.T) {
+	isolateLoadConfigEnv(t)
+	setEnv(t, "SONOBUOY_ADVERTISE_IP", "198.51.100.7")
+	paths := append([]string(nil), fixtures+"/missing.json", fixtures+"/good.json")
+
+	got := loadSummary(t, paths...)
+
+	assertSummary(t, got, configSummary{
+		Description:   "smoke",
+		UUID:          "fixed",
+		LoadedPlugins: []string{},
+	})
+}
+
+func TestLoadConfigNoGlobalStateWithInProcessNoise(t *testing.T) {
+	isolateLoadConfigEnv(t)
+	setEnv(t, "SONOBUOY_ADVERTISE_IP", "198.51.100.7")
+	wantStable := configSummary{
+		Description:   "smoke",
+		UUID:          "fixed",
+		LoadedPlugins: []string{},
+	}
+
+	first := loadSummary(t, fixtures+"/good.json")
+	setEnv(t, "SONOBUOY_ADVERTISE_IP", "192.0.2.10")
+	noise := loadSummary(t, fixtures+"/env_config.json")
+	setEnv(t, "SONOBUOY_ADVERTISE_IP", "198.51.100.12")
+	pluginNoise := loadSummary(t, fixtures+"/plugins.json")
+	setEnv(t, "SONOBUOY_ADVERTISE_IP", "198.51.100.7")
+	again := loadSummary(t, fixtures+"/good.json")
+
+	assertSummary(t, first, wantStable)
+	assertSummary(t, noise, configSummary{
+		Description:   "env-picked",
+		UUID:          "env-uuid",
+		LoadedPlugins: []string{},
+	})
+	assertSummary(t, pluginNoise, configSummary{
+		Description:   "plugins",
+		UUID:          "plugins-uuid",
+		LoadedPlugins: []string{"alpha", "beta"},
+	})
+	assertSummary(t, again, wantStable)
+}
+
+func TestLoadConfigLoadsDefaultConfigJSONFromWorkingDirectory(t *testing.T) {
+	isolateLoadConfigEnv(t)
+	setEnv(t, "SONOBUOY_ADVERTISE_IP", "198.51.100.13")
+	tmp := t.TempDir()
+	writeFile(t, filepath.Join(tmp, "config.json"), `{"Description":"side-effects","UUID":"side-effects-uuid","Server":{"bindport":5050},"PluginSearchPath":[],"Plugins":[]}`)
+	chdir(t, tmp)
+
+	got := loadSummary(t)
+
+
+	assertSummary(t, got, configSummary{
+		Description:   "side-effects",
+		UUID:          "side-effects-uuid",
+		LoadedPlugins: []string{},
+	})
+}
