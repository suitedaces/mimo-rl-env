+export GOTOOLCHAIN=local
+export GOPROXY=off
+export GOSUMDB=off
+export GOFLAGS="${GOFLAGS:-} -mod=readonly"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+exec go test -v ./usercase-test-coderl/...
