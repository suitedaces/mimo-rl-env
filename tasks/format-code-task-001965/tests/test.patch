+func newProjectAPIKeysLocalServer(t *testing.T, assignments map[string][]string, assignStatus int) *httptest.Server {
+	t.Helper()
+	projectJSON := map[string]interface{}{
+		"id":           "project-id",
+		"orgId":        "org-id",
+		"name":         "project-with-api-keys",
+		"clusterCount": 0,
+		"created":      "2021-01-01T00:00:00Z",
+	}
+	teamsJSON := map[string]interface{}{
+		"links":      []interface{}{},
+		"results":    []interface{}{},
+		"totalCount": 0,
+	}
+	apiKeysJSON := map[string]interface{}{
+		"links": []interface{}{},
+		"results": []interface{}{
+			map[string]interface{}{
+				"id": "key-1",
+				"roles": []interface{}{
+					map[string]interface{}{"roleName": "GROUP_READ_ONLY"},
+					map[string]interface{}{"roleName": "ORG_MEMBER"},
+				},
+			},
+			map[string]interface{}{
+				"id": "key-2",
+				"roles": []interface{}{
+					map[string]interface{}{"roleName": "GROUP_DATA_ACCESS_READ_ONLY"},
+					map[string]interface{}{"roleName": "GROUP_CLUSTER_MANAGER"},
+					map[string]interface{}{"roleName": "ORG_OWNER"},
+				},
+			},
+		},
+		"totalCount": 2,
+	}
+
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case r.Method == http.MethodPost && r.URL.Path == "/api/atlas/v1.0/groups":
+			writeJSON(t, w, projectJSON)
+		case r.Method == http.MethodGet && r.URL.Path == "/api/atlas/v1.0/groups":
+			writeJSON(t, w, map[string]interface{}{
+				"links":      []interface{}{},
+				"results":    []interface{}{projectJSON},
+				"totalCount": 1,
+			})
+		case r.Method == http.MethodGet && r.URL.Path == "/api/atlas/v1.0/groups/project-id":
+			writeJSON(t, w, projectJSON)
+		case r.Method == http.MethodGet && r.URL.Path == "/api/atlas/v1.0/groups/project-id/teams":
+			writeJSON(t, w, teamsJSON)
+		case r.Method == http.MethodGet && r.URL.Path == "/api/atlas/v1.0/groups/project-id/apiKeys":
+			writeJSON(t, w, apiKeysJSON)
+		case r.Method == http.MethodPatch && strings.HasPrefix(r.URL.Path, "/api/atlas/v1.0/groups/project-id/apiKeys/"):
+			keyID := strings.TrimPrefix(r.URL.Path, "/api/atlas/v1.0/groups/project-id/apiKeys/")
+			var body struct {
+				Roles []string `json:"roles"`
+			}
+			raw, err := io.ReadAll(r.Body)
+			if err != nil {
+				t.Fatalf("reading assign body: %s", err)
+			}
+			if err := json.Unmarshal(raw, &body); err != nil {
+				t.Fatalf("decoding assign body %q: %s", string(raw), err)
+			}
+			assignments[keyID] = append([]string(nil), body.Roles...)
+			if assignStatus != 0 {
+				http.Error(w, `{"error":"assign failed"}`, assignStatus)
+				return
+			}
+			w.WriteHeader(http.StatusOK)
+			_, _ = w.Write([]byte(`{}`))
+		default:
+			t.Fatalf("unexpected request: %s %s", r.Method, r.URL.String())
+		}
+	}))
+}
+
+func writeJSON(t *testing.T, w http.ResponseWriter, value interface{}) {
+	t.Helper()
+	if err := json.NewEncoder(w).Encode(value); err != nil {
+		t.Fatalf("writing JSON response: %s", err)
+	}
+}
+
+func apiKeysFromResourceData(t *testing.T, d *schema.ResourceData, key string) map[string][]string {
+	t.Helper()
+	return apiKeysFromRawValue(t, d.Get(key))
+}
+
+func apiKeysFromRawValue(t *testing.T, raw interface{}) map[string][]string {
+	t.Helper()
+	items, ok := raw.([]interface{})
+	if !ok {
+		t.Fatalf("api_keys has unexpected type %T: %#v", raw, raw)
+	}
+	result := make(map[string][]string, len(items))
+	for _, item := range items {
+		entry, ok := item.(map[string]interface{})
+		if !ok {
+			t.Fatalf("api_keys entry has unexpected type %T: %#v", item, item)
+		}
+		id, ok := entry["api_key_id"].(string)
+		if !ok || id == "" {
+			t.Fatalf("api_key_id missing in %#v", entry)
+		}
+		result[id] = stringSliceFromRaw(t, entry["role_names"])
+	}
+	return result
+}
+
+func stringSliceFromRaw(t *testing.T, raw interface{}) []string {
+	t.Helper()
+	switch v := raw.(type) {
+	case []interface{}:
+		values := make([]string, 0, len(v))
+		for _, item := range v {
+			values = append(values, item.(string))
+		}
+		sort.Strings(values)
+		return values
+	case []string:
+		values := append([]string(nil), v...)
+		sort.Strings(values)
+		return values
+	default:
+		t.Fatalf("role_names has unexpected type %T: %#v", raw, raw)
+		return nil
+	}
+}
+
+func assertStringSliceMap(t *testing.T, expected, actual map[string][]string) {
+	t.Helper()
+	normalizedExpected := normalizeStringSliceMap(expected)
+	normalizedActual := normalizeStringSliceMap(actual)
+	if !reflect.DeepEqual(normalizedExpected, normalizedActual) {
+		t.Fatalf("api key map mismatch:\nexpected: %#v\nactual:   %#v", normalizedExpected, normalizedActual)
+	}
+}
+
+func normalizeStringSliceMap(values map[string][]string) map[string][]string {
+	normalized := make(map[string][]string, len(values))
+	for key, roles := range values {
+		copyRoles := append([]string(nil), roles...)
+		sort.Strings(copyRoles)
+		normalized[key] = copyRoles
+	}
+	return normalized
+}
