+func TestReadmeProjectEnvVarsMentionAPIKeyIDs(t *testing.T) {
+	content, err := os.ReadFile("../README.md")
+	if err != nil {
+		t.Fatalf("reading README.md: %s", err)
+	}
+
+	readme := string(content)
+	sectionStart := strings.Index(readme, "For `Project(s)` resource configuration:")
+	if sectionStart < 0 {
+		t.Fatalf("README.md does not contain Project(s) resource configuration section")
+	}
+	section := readme[sectionStart:]
+	if next := strings.Index(section[len("For `Project(s)` resource configuration:"):], "\n- "); next >= 0 {
+		section = section[:len("For `Project(s)` resource configuration:")+next]
+	}
+
+	if !strings.Contains(section, "MONGODB_ATLAS_API_KEYS_IDS=<API_KEYS_IDS>") {
+		t.Fatalf("README Project(s) resource configuration section must mention MONGODB_ATLAS_API_KEYS_IDS=<API_KEYS_IDS>")
+	}
+}
