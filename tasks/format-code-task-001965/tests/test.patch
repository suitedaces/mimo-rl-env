+func TestProjectAPIKeysLocalResourceAssignsAllDeclaredKeysAndRoles(t *testing.T) {
+	assignments := map[string][]string{}
+	server := newProjectAPIKeysLocalServer(t, assignments, 0)
+	defer server.Close()
+
+	r := resourceMongoDBAtlasProject()
+	d := schema.TestResourceDataRaw(t, r.Schema, map[string]interface{}{
+		"name":   "project-with-api-keys",
+		"org_id": "org-id",
+		"api_keys": []interface{}{
+			map[string]interface{}{
+				"api_key_id": "key-1",
+				"role_names": []interface{}{"GROUP_READ_ONLY"},
+			},
+			map[string]interface{}{
+				"api_key_id": "key-2",
+				"role_names": []interface{}{"GROUP_DATA_ACCESS_READ_ONLY", "GROUP_CLUSTER_MANAGER"},
+			},
+		},
+	})
+
+	diags := resourceMongoDBAtlasProjectCreate(context.Background(), d, testProjectAPIKeysClient(t, server.URL))
+	if diags.HasError() {
+		t.Fatalf("resource create returned diagnostics: %#v", diags)
+	}
+
+	expected := map[string][]string{
+		"key-1": {"GROUP_READ_ONLY"},
+		"key-2": {"GROUP_DATA_ACCESS_READ_ONLY", "GROUP_CLUSTER_MANAGER"},
+	}
+	assertStringSliceMap(t, expected, assignments)
+}
