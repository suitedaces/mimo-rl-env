+func testAccCheckNoOrgRolesInAttributes(attrs map[string]string, apiKeysPrefix string) error {
+	for attr, value := range attrs {
+		if !strings.HasPrefix(attr, apiKeysPrefix+".") || !strings.Contains(attr, ".role_names.") {
+			continue
+		}
+		if strings.HasPrefix(value, "ORG_") {
+			return fmt.Errorf("unexpected org-level role %q in %s", value, attr)
+		}
+	}
+	return nil
+}
+
+func collectAPIKeysFromAttributes(attrs map[string]string, apiKeysPrefix string) (map[string][]string, error) {
+	count := atoiStateValue(attrs[apiKeysPrefix+".#"])
+	if count == 0 {
+		return map[string][]string{}, nil
+	}
+
+	actual := make(map[string][]string)
+	for i := 0; i < count; i++ {
+		prefix := fmt.Sprintf("%s.%d", apiKeysPrefix, i)
+		id := attrs[prefix+".api_key_id"]
+		if id == "" {
+			return nil, fmt.Errorf("missing api_key_id at %s", prefix)
+		}
+		roleCount := atoiStateValue(attrs[prefix+".role_names.#"])
+		roles := make([]string, 0, roleCount)
+		for j := 0; j < roleCount; j++ {
+			if role := attrs[fmt.Sprintf("%s.role_names.%d", prefix, j)]; role != "" {
+				roles = append(roles, role)
+			}
+		}
+		sort.Strings(roles)
+		actual[id] = roles
+	}
+	return actual, nil
+}
+
+func compareAPIKeys(expected, actual map[string][]string) error {
+	if len(actual) != len(expected) {
+		return fmt.Errorf("expected %d api keys, got %d: %#v", len(expected), len(actual), actual)
+	}
+	for id, expectedRoles := range expected {
+		actualRoles, ok := actual[id]
+		if !ok {
+			return fmt.Errorf("expected api key %q not found in %#v", id, actual)
+		}
+		if !sameStringSet(expectedRoles, actualRoles) {
+			return fmt.Errorf("api key %q roles mismatch: expected %#v, got %#v", id, expectedRoles, actualRoles)
+		}
+	}
+	return nil
+}
+
+func sameStringSet(expected, actual []string) bool {
+	expectedCopy := append([]string(nil), expected...)
+	actualCopy := append([]string(nil), actual...)
+	sort.Strings(expectedCopy)
+	sort.Strings(actualCopy)
+	if len(expectedCopy) != len(actualCopy) {
+		return false
+	}
+	for i := range expectedCopy {
+		if expectedCopy[i] != actualCopy[i] {
+			return false
+		}
+	}
+	return true
+}
