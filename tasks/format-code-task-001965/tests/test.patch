+func testAccProjectAPIKeysResourceConfig(projectName, orgID string, apiKeys map[string][]string) string {
+	var blocks strings.Builder
+	for _, id := range sortedMapKeys(apiKeys) {
+		blocks.WriteString(fmt.Sprintf(`
+	api_keys {
+		api_key_id = %q
+		role_names = %s
+	}
+`, id, hclStringList(apiKeys[id])))
+	}
+
+	return fmt.Sprintf(`
+resource "mongodbatlas_project" "test" {
+	name   = %q
+	org_id = %q
+%s
+}
+`, projectName, orgID, blocks.String())
+}
+
+func testAccProjectAPIKeysConfigWithProjectDS(projectName, orgID string, apiKeys map[string][]string, dsName string, byID bool) string {
+	lookup := `name = mongodbatlas_project.test.name`
+	if byID {
+		lookup = `project_id = mongodbatlas_project.test.id`
+	}
+
+	return fmt.Sprintf(`
+%s
+
+data "mongodbatlas_project" "%s" {
+	%s
+	depends_on = [mongodbatlas_project.test]
+}
+`, testAccProjectAPIKeysResourceConfig(projectName, orgID, apiKeys), dsName, lookup)
+}
+
+func sortedMapKeys(m map[string][]string) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func hclStringList(values []string) string {
+	quoted := make([]string, len(values))
+	for i, value := range values {
+		quoted[i] = fmt.Sprintf("%q", value)
+	}
+	return "[" + strings.Join(quoted, ", ") + "]"
+}
+
+func atoiStateValue(value string) int {
+	var n int
+	_, _ = fmt.Sscanf(value, "%d", &n)
+	return n
+}
