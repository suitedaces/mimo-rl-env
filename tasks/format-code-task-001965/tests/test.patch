+func testAccAPIKeyIDs(t *testing.T, min int) []string {
+	t.Helper()
+	raw := os.Getenv("MONGODB_ATLAS_API_KEYS_IDS")
+	if raw == "" {
+		t.Skip("MONGODB_ATLAS_API_KEYS_IDS must be set for project API-key acceptance tests")
+	}
+
+	parts := strings.Split(raw, ",")
+	ids := make([]string, 0, len(parts))
+	for _, part := range parts {
+		if trimmed := strings.TrimSpace(part); trimmed != "" {
+			ids = append(ids, trimmed)
+		}
+	}
+	if len(ids) < min {
+		t.Skipf("MONGODB_ATLAS_API_KEYS_IDS must contain at least %d API key IDs", min)
+	}
+	return ids
+}
