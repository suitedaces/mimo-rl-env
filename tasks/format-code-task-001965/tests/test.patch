+		rs, ok := s.RootModule().Resources[resourceName]
+		if !ok {
+			return fmt.Errorf("resource %s not found in state", resourceName)
+		}
+		return testAccCheckNoOrgRolesInAttributes(rs.Primary.Attributes, "api_keys")
+	}
+}
