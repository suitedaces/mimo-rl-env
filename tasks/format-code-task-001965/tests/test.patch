+func testAccCheckAPIKeysInState(resourceName string, expected map[string][]string) resource.TestCheckFunc {
+	return func(s *terraform.State) error {
+		rs, ok := s.RootModule().Resources[resourceName]
+		if !ok {
+			return fmt.Errorf("resource %s not found in state", resourceName)
+		}
+
+		actual, err := collectAPIKeysFromAttributes(rs.Primary.Attributes, "api_keys")
+		if err != nil {
+			return fmt.Errorf("%s: %w", resourceName, err)
+		}
+		return compareAPIKeys(expected, actual)
+	}
+}
+
+func testAccCheckProjectsResultAPIKeys(resourceName, projectName string, expected map[string][]string) resource.TestCheckFunc {
+	return func(s *terraform.State) error {
+		rs, ok := s.RootModule().Resources[resourceName]
+		if !ok {
+			return fmt.Errorf("resource %s not found in state", resourceName)
+		}
+
+		count := atoiStateValue(rs.Primary.Attributes["results.#"])
+		for i := 0; i < count; i++ {
+			prefix := fmt.Sprintf("results.%d", i)
+			if rs.Primary.Attributes[prefix+".name"] != projectName {
+				continue
+			}
+			actual, err := collectAPIKeysFromAttributes(rs.Primary.Attributes, prefix+".api_keys")
+			if err != nil {
+				return fmt.Errorf("%s result %q: %w", resourceName, projectName, err)
+			}
+			if err := compareAPIKeys(expected, actual); err != nil {
+				return err
+			}
+			return testAccCheckNoOrgRolesInAttributes(rs.Primary.Attributes, prefix+".api_keys")
+		}
+		return fmt.Errorf("project %q not found in %s results", projectName, resourceName)
+	}
+}
+
+func testAccCheckNoOrgRoles(resourceName string) resource.TestCheckFunc {
