+func TestKubernetesHandler_GetUpgrades_ReturnsAvailableVersions(t *testing.T) {
+	setup()
+	defer teardown()
+
+	vkeID := "cluster-upgrade-test"
+	expectedPath := fmt.Sprintf("/v2/kubernetes/clusters/%s/available-upgrades", vkeID)
+	expected := []string{"v1.23.15+1", "v1.24.9+2"}
+	called := false
+
+	mux.HandleFunc(expectedPath, func(writer http.ResponseWriter, request *http.Request) {
+		called = true
+		if request.Method != http.MethodGet {
+			t.Errorf("Kubernetes.GetUpgrades request method = %s, expected %s", request.Method, http.MethodGet)
+		}
+		if request.URL.Path != expectedPath {
+			t.Errorf("Kubernetes.GetUpgrades request path = %s, expected %s", request.URL.Path, expectedPath)
+		}
+
+		fmt.Fprint(writer, `{"available_upgrades":["v1.23.15+1","v1.24.9+2"]}`)
+	})
+
+	upgrades, err := client.Kubernetes.GetUpgrades(ctx, vkeID)
+	if err != nil {
+		t.Fatalf("Kubernetes.GetUpgrades returned error: %+v", err)
+	}
+	if !called {
+		t.Fatal("Kubernetes.GetUpgrades did not send a request to the expected endpoint")
+	}
+	if !reflect.DeepEqual(upgrades, expected) {
+		t.Errorf("Kubernetes.GetUpgrades returned %+v, expected %+v", upgrades, expected)
+	}
+}
+
+func TestKubernetesHandler_GetUpgrades_PropagatesRequestError(t *testing.T) {
+	setup()
+	defer teardown()
+
+	canceledCtx, cancel := context.WithCancel(ctx)
+	cancel()
+
+	_, err := client.Kubernetes.GetUpgrades(canceledCtx, "cluster-upgrade-test")
+	if err == nil {
+		t.Fatal("Kubernetes.GetUpgrades returned nil error for a canceled context")
+	}
+}
+
+func TestKubernetesHandler_Upgrade_PostsRequestBody(t *testing.T) {
+	setup()
+	defer teardown()
+
+	vkeID := "cluster-upgrade-test"
+	expectedPath := fmt.Sprintf("/v2/kubernetes/clusters/%s/upgrades", vkeID)
+	requestedVersion := "v1.24.3+1"
+	called := false
+
+	mux.HandleFunc(expectedPath, func(writer http.ResponseWriter, request *http.Request) {
+		called = true
+		if request.Method != http.MethodPost {
+			t.Errorf("Kubernetes.Upgrade request method = %s, expected %s", request.Method, http.MethodPost)
+		}
+		if request.URL.Path != expectedPath {
+			t.Errorf("Kubernetes.Upgrade request path = %s, expected %s", request.URL.Path, expectedPath)
+		}
+
+		var body map[string]string
+		if err := json.NewDecoder(request.Body).Decode(&body); err != nil {
+			t.Fatalf("Kubernetes.Upgrade request body was not valid JSON: %+v", err)
+		}
+		if body["upgrade_version"] != requestedVersion {
+			t.Errorf("Kubernetes.Upgrade request upgrade_version = %q, expected %q", body["upgrade_version"], requestedVersion)
+		}
+
+		writer.WriteHeader(http.StatusNoContent)
+	})
+
+	err := client.Kubernetes.Upgrade(ctx, vkeID, &ClusterUpgradeReq{UpgradeVersion: requestedVersion})
+	if err != nil {
+		t.Fatalf("Kubernetes.Upgrade returned error: %+v", err)
+	}
+	if !called {
+		t.Fatal("Kubernetes.Upgrade did not send a request to the expected endpoint")
+	}
+}
+
+func TestKubernetesHandler_Upgrade_PropagatesServerError(t *testing.T) {
+	setup()
+	defer teardown()
+
+	vkeID := "cluster-upgrade-test"
+	expectedPath := fmt.Sprintf("/v2/kubernetes/clusters/%s/upgrades", vkeID)
+
+	mux.HandleFunc(expectedPath, func(writer http.ResponseWriter, request *http.Request) {
+		http.Error(writer, "upgrade failed", http.StatusInternalServerError)
+	})
+
+	err := client.Kubernetes.Upgrade(ctx, vkeID, &ClusterUpgradeReq{UpgradeVersion: "v1.24.3+1"})
+	if err == nil {
+		t.Fatal("Kubernetes.Upgrade returned nil error for a server error")
+	}
+}
+
+func TestClusterUpgradeReq_JSONSerialization(t *testing.T) {
+	requestedVersion := "v1.24.3+1"
+
+	withVersion, err := json.Marshal(&ClusterUpgradeReq{UpgradeVersion: requestedVersion})
+	if err != nil {
+		t.Fatalf("json.Marshal returned error for ClusterUpgradeReq with version: %+v", err)
+	}
+	var encodedWithVersion map[string]string
+	if err := json.Unmarshal(withVersion, &encodedWithVersion); err != nil {
+		t.Fatalf("json.Unmarshal returned error for ClusterUpgradeReq with version: %+v", err)
+	}
+	if encodedWithVersion["upgrade_version"] != requestedVersion {
+		t.Errorf("ClusterUpgradeReq upgrade_version = %q, expected %q", encodedWithVersion["upgrade_version"], requestedVersion)
+	}
+
+	withoutVersion, err := json.Marshal(&ClusterUpgradeReq{})
+	if err != nil {
+		t.Fatalf("json.Marshal returned error for empty ClusterUpgradeReq: %+v", err)
+	}
+	var encodedWithoutVersion map[string]interface{}
+	if err := json.Unmarshal(withoutVersion, &encodedWithoutVersion); err != nil {
+		t.Fatalf("json.Unmarshal returned error for empty ClusterUpgradeReq: %+v", err)
+	}
+	if _, ok := encodedWithoutVersion["upgrade_version"]; ok {
+		t.Errorf("ClusterUpgradeReq with empty UpgradeVersion included upgrade_version field: %s", string(withoutVersion))
+	}
+}
