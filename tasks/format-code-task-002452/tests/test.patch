@@ -0,0 +1,34 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+if [ ! -x /testbed/.venv/bin/python3 ] || [ ! -f /testbed/.venv/pyvenv.cfg ]; then
+  rm -rf /testbed/.venv
+  python3 -m venv /testbed/.venv
+fi
+/testbed/.venv/bin/python3 -m pip install -U pip setuptools wheel
+/testbed/.venv/bin/python3 -m pip install -e '.[cf]' pytest dask[array] netCDF4 h5netcdf 'numpy<2.0' 'zarr<3' 'xarray==2022.12.0' 'pandas<2.0'
+
+
+NEW_TESTS=(
+  satpy/tests/writer_tests/test_cf.py::test_cf_writer_geographic_area_writes_lonlat_xy_metadata
+  satpy/tests/writer_tests/test_cf.py::test_da2cf_custom_geographic_area_encodes_lonlat_xy_metadata
+  satpy/tests/writer_tests/test_cf.py::test_da2cf_uses_crs_not_area_name_or_existing_xy_units
+  satpy/tests/writer_tests/test_cf.py::test_da2cf_projected_area_preserves_projected_xy_metadata
+  satpy/tests/writer_tests/test_cf.py::test_da2cf_indeterminate_projection_warns_and_defaults_to_projected
+)
+
+case "${1:-}" in
+  base)
+    /testbed/.venv/bin/python3 -m pytest satpy/tests/writer_tests/test_cf.py -x -v \
+      -k 'not test_cf_writer_geographic_area_writes_lonlat_xy_metadata and not test_da2cf_custom_geographic_area_encodes_lonlat_xy_metadata and not test_da2cf_uses_crs_not_area_name_or_existing_xy_units and not test_da2cf_projected_area_preserves_projected_xy_metadata and not test_da2cf_indeterminate_projection_warns_and_defaults_to_projected'
+    ;;
+  new)
+    /testbed/.venv/bin/python3 -m pytest "${NEW_TESTS[@]}" -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
