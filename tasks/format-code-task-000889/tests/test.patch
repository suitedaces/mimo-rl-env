diff --git a/usercase-test-coderl/resize_test.go b/usercase-test-coderl/resize_test.go
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/resize_test.go
@@ -0,0 +1,206 @@
+package usercase_test_coderl
+
+import (
+	"image"
+	"image/color"
+	"testing"
+
+	caire "github.com/esimov/caire"
+)
+
+
+
+
+
+
+
+
+func patternedNRGBA(width, height int) *image.NRGBA {
+	img := image.NewNRGBA(image.Rect(0, 0, width, height))
+	for y := 0; y < height; y++ {
+		for x := 0; x < width; x++ {
+			img.SetNRGBA(x, y, color.NRGBA{
+				R: uint8((x*3 + y*5) % 256),
+				G: uint8((x*7 + y*11) % 256),
+				B: uint8((x*13 + y*17) % 256),
+				A: 255,
+			})
+		}
+	}
+	return img
+}
+
+func patternedMask(width, height int) *image.NRGBA {
+	img := image.NewNRGBA(image.Rect(0, 0, width, height))
+	for y := 0; y < height; y++ {
+		for x := 0; x < width; x++ {
+			if (x+y)%7 == 0 {
+				img.SetNRGBA(x, y, color.NRGBA{R: 255, G: 255, B: 255, A: 255})
+			} else {
+				img.SetNRGBA(x, y, color.NRGBA{A: 255})
+			}
+		}
+	}
+	return img
+}
+
+func requireBounds(t *testing.T, img image.Image, width, height int) {
+	t.Helper()
+	bounds := img.Bounds()
+	if bounds.Dx() != width || bounds.Dy() != height {
+		t.Fatalf("bounds = %dx%d, want %dx%d", bounds.Dx(), bounds.Dy(), width, height)
+	}
+}
+
+func TestResizeWidthHeightAndBothAxes(t *testing.T) {
+
+
+	widthOnly := &caire.Processor{NewWidth: 60}
+	widthImg, err := widthOnly.Resize(patternedNRGBA(100, 80))
+	if err != nil {
+		t.Fatalf("width-only Resize error = %v, want nil", err)
+	}
+	requireBounds(t, widthImg, 60, 80)
+
+
+	heightOnly := &caire.Processor{NewHeight: 40}
+	heightImg, err := heightOnly.Resize(patternedNRGBA(100, 80))
+	if err != nil {
+		t.Fatalf("height-only Resize error = %v, want nil", err)
+	}
+	requireBounds(t, heightImg, 100, 40)
+
+
+	bothAxes := &caire.Processor{NewWidth: 60, NewHeight: 40}
+	bothImg, err := bothAxes.Resize(patternedNRGBA(100, 80))
+	if err != nil {
+		t.Fatalf("both-axes Resize error = %v, want nil", err)
+	}
+	requireBounds(t, bothImg, 60, 40)
+
+}
+
+func TestResizeSupportsEnlargementPerAxis(t *testing.T) {
+
+
+	widthGrow := &caire.Processor{NewWidth: 120}
+	widthImg, err := widthGrow.Resize(patternedNRGBA(100, 80))
+	if err != nil {
+		t.Fatalf("width enlargement Resize error = %v, want nil", err)
+	}
+	requireBounds(t, widthImg, 120, 80)
+
+
+	heightGrow := &caire.Processor{NewHeight: 100}
+	heightImg, err := heightGrow.Resize(patternedNRGBA(100, 80))
+	if err != nil {
+		t.Fatalf("height enlargement Resize error = %v, want nil", err)
+	}
+	requireBounds(t, heightImg, 100, 100)
+
+}
+
+func TestResizePercentageModeReducesAndRejectsEnlargement(t *testing.T) {
+
+
+	reduce := &caire.Processor{NewWidth: 50, NewHeight: 50, Percentage: true}
+	reducedImg, err := reduce.Resize(patternedNRGBA(100, 80))
+	if err != nil {
+		t.Fatalf("percentage reduction Resize error = %v, want nil", err)
+	}
+	requireBounds(t, reducedImg, 50, 40)
+
+
+	enlarge := &caire.Processor{NewWidth: 150, Percentage: true}
+	enlargedImg, err := enlarge.Resize(patternedNRGBA(100, 80))
+	if err == nil {
+		t.Fatalf("percentage enlargement Resize error = nil, want exact error")
+	}
+
+	_ = enlargedImg
+	if err.Error() != "cannot use the percentage flag for image enlargement" {
+		t.Fatalf("percentage enlargement error = %q, want %q", err.Error(), "cannot use the percentage flag for image enlargement")
+	}
+
+}
+
+func TestResizeSquareModeUsesSmallerSideAndRequiresBothTargets(t *testing.T) {
+
+
+	square := &caire.Processor{NewWidth: 70, NewHeight: 50, Square: true}
+	squareImg, err := square.Resize(patternedNRGBA(120, 80))
+	if err != nil {
+		t.Fatalf("square Resize error = %v, want nil", err)
+	}
+	requireBounds(t, squareImg, 50, 50)
+
+
+	missingHeight := &caire.Processor{NewWidth: 50, Square: true}
+	missingImg, err := missingHeight.Resize(patternedNRGBA(120, 80))
+	if err == nil {
+		t.Fatalf("square missing-height Resize error = nil, want exact error")
+	}
+
+	_ = missingImg
+	if err.Error() != "please provide a new WIDTH and HEIGHT when using the square option" {
+		t.Fatalf("square missing-height error = %q, want %q", err.Error(), "please provide a new WIDTH and HEIGHT when using the square option")
+	}
+
+}
+
+func TestResizeVerticalWithMaskAndRMask(t *testing.T) {
+
+
+	withMask := &caire.Processor{
+		NewHeight: 40,
+		MaskPath:  "mask.png",
+		Mask:      patternedMask(100, 80),
+	}
+	maskImg, err := withMask.Resize(patternedNRGBA(100, 80))
+	if err != nil {
+		t.Fatalf("masked vertical Resize error = %v, want nil", err)
+	}
+	requireBounds(t, maskImg, 100, 40)
+	if withMask.Mask == nil {
+		t.Fatalf("withMask.Mask = nil, want resized mask")
+	}
+	requireBounds(t, withMask.Mask, 100, 40)
+
+
+	withRMask := &caire.Processor{
+		NewHeight: 40,
+		RMaskPath: "rmask.png",
+		RMask:     patternedMask(100, 80),
+	}
+	rmaskImg, err := withRMask.Resize(patternedNRGBA(100, 80))
+	if err != nil {
+		t.Fatalf("removal-masked vertical Resize error = %v, want nil", err)
+	}
+	requireBounds(t, rmaskImg, 100, 40)
+
+	if withRMask.RMask == nil {
+		t.Fatalf("withRMask.RMask = nil, want resized mask")
+	}
+	requireBounds(t, withRMask.RMask, 100, 40)
+}
+
+func TestResizeProcessorInstancesRemainIndependent(t *testing.T) {
+
+
+	a := &caire.Processor{NewWidth: 50, NewHeight: 50, Percentage: true}
+	b := &caire.Processor{NewWidth: 70, NewHeight: 50, Square: true}
+
+	aImg, err := a.Resize(patternedNRGBA(100, 80))
+	if err != nil {
+		t.Fatalf("processor a Resize error = %v, want nil", err)
+	}
+	requireBounds(t, aImg, 50, 40)
+
+
+	bImg, err := b.Resize(patternedNRGBA(120, 80))
+	if err != nil {
+		t.Fatalf("processor b Resize error = %v, want nil", err)
+	}
+	requireBounds(t, bImg, 50, 50)
+
+}
