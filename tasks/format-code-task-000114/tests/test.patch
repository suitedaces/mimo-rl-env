diff --git a/hypothesis-python/tests/py3/test_lookup.py b/hypothesis-python/tests/py3/test_lookup.py
index 459b9d250..ad8124a16 100644
--- a/hypothesis-python/tests/py3/test_lookup.py
+++ b/hypothesis-python/tests/py3/test_lookup.py
@@ -367,6 +367,36 @@ def test_required_args(target, args, kwargs):
               **{k: st.just(v) for k, v in kwargs.items()}).example()
 
 
+Point = typing.NamedTuple('Point', [('x', int), ('y', int)])
+Labelled = typing.NamedTuple('Labelled', [('name', str), ('count', int)])
+
+
+@given(st.builds(Point))
+def test_builds_infers_all_fields_for_namedtuple(thing):
+    assert isinstance(thing, Point)
+    assert isinstance(thing.x, int)
+    assert isinstance(thing.y, int)
+
+
+@given(st.builds(Point, st.just(5)))
+def test_builds_infers_remaining_fields_after_positional_namedtuple_arg(thing):
+    assert thing.x == 5
+    assert isinstance(thing.y, int)
+
+
+@given(st.builds(Labelled, name=st.just('fixed')))
+def test_builds_infers_remaining_fields_after_keyword_namedtuple_arg(thing):
+    assert thing.name == 'fixed'
+    assert isinstance(thing.count, int)
+
+
+@given(st.from_type(Point))
+def test_from_type_resolves_namedtuple(thing):
+    assert isinstance(thing, Point)
+    assert isinstance(thing.x, int)
+    assert isinstance(thing.y, int)
+
+
 @pytest.mark.parametrize('thing', [
     typing.Optional, typing.List, getattr(typing, 'Type', typing.Set)
 ])  # check Type if it's available, otherwise Set is redundant but harmless
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,44 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+if [ -x /testbed/.venv/bin/python ] && /testbed/.venv/bin/python -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 6))'; then
+    :
+else
+    rm -rf /testbed/.venv
+    /root/.pyenv/versions/3.6.15/bin/python -m venv /testbed/.venv
+fi
+set +u
+source /testbed/.venv/bin/activate
+set -u
+
+pip install -e hypothesis-python/".[pytest]" --no-input 2>&1 | tail -3
+pip install "coverage<5" --no-input 2>&1 | tail -3
+
+
+NEW_TESTS=(
+  hypothesis-python/tests/py3/test_lookup.py::test_builds_infers_all_fields_for_namedtuple
+  hypothesis-python/tests/py3/test_lookup.py::test_builds_infers_remaining_fields_after_positional_namedtuple_arg
+  hypothesis-python/tests/py3/test_lookup.py::test_builds_infers_remaining_fields_after_keyword_namedtuple_arg
+  hypothesis-python/tests/py3/test_lookup.py::test_from_type_resolves_namedtuple
+)
+
+case "${1:-}" in
+  base)
+    python -m pytest hypothesis-python/tests/py3/test_lookup.py \
+      --deselect=hypothesis-python/tests/py3/test_lookup.py::test_builds_infers_all_fields_for_namedtuple \
+      --deselect=hypothesis-python/tests/py3/test_lookup.py::test_builds_infers_remaining_fields_after_positional_namedtuple_arg \
+      --deselect=hypothesis-python/tests/py3/test_lookup.py::test_builds_infers_remaining_fields_after_keyword_namedtuple_arg \
+      --deselect=hypothesis-python/tests/py3/test_lookup.py::test_from_type_resolves_namedtuple \
+      -x -v
+    ;;
+  new)
+    python -m pytest "${NEW_TESTS[@]}" -x -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
