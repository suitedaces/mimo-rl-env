+    levels = np.array([912., 905.3, 874.4, 850., 815.1, 786.6, 759.1,
+                       748., 732.2, 700., 654.8]) * units.mbar
+    temperatures = np.array([29.4, 28.7, 25.2, 22.4, 19.4, 16.8,
+                             14.3, 13.2, 12.6, 11.4, 7.1]) * units.celsius
