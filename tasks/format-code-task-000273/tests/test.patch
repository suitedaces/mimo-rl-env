diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,30 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+python3 -m pip install --break-system-packages -e . >/tmp/metpy_fixturea_pip_install.log 2>&1
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest \
+      metpy/calc/tests/test_thermo.py::test_no_lfc \
+      metpy/calc/tests/test_thermo.py::test_lfc_inversion \
+      metpy/calc/tests/test_thermo.py::test_no_el \
+      -q
+    ;;
+  new)
+    python3 -m pytest \
+      metpy/calc/tests/test_thermo.py::test_lfc_equals_lcl_matches_public_lcl_for_uncapped_profile \
+      metpy/calc/tests/test_thermo.py::test_lfc_equals_lcl_for_synthetic_uncapped_profile \
+      metpy/calc/tests/test_thermo.py::test_el_lfc_equals_lcl \
+      metpy/calc/tests/test_thermo.py::test_el_lfc_equals_lcl_for_synthetic_profile \
+      -q
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
