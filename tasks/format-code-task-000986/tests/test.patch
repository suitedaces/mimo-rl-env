+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from siuba import _, group_by, separate
+
+
+def assert_frame_equal_missing(left, right):
+
+    left = left.astype(object).where(left.notna(), pd.NA)
+    right = right.astype(object).where(right.notna(), pd.NA)
+    assert_frame_equal(left, right, check_dtype=False)
+
+
+def test_separate_extra_drop_preserves_position_and_index():
+    data = pd.DataFrame(
+        {"id": [2, 1], "label": ["a-b-c", "d-e-f"], "tail": ["x", "y"]},
+        index=[10, 20],
+    )
+    dropped = separate(data, "label", ["first", "rest"], sep="-", extra="drop")
+    expected = pd.DataFrame(
+        {"id": [2, 1], "first": ["a", "d"], "rest": ["b", "e"], "tail": ["x", "y"]},
+        index=[10, 20],
+    )
+    assert_frame_equal(dropped, expected)
+
+
+def test_separate_extra_merge_joins_remaining_pieces():
+    data = pd.DataFrame(
+        {"id": [2, 1], "label": ["a-b-c", "d-e-f"], "tail": ["x", "y"]},
+        index=[10, 20],
+    )
+    merged = separate(data, _.label, ["first", "rest"], sep="-", extra="merge")
+    expected = pd.DataFrame(
+        {"id": [2, 1], "first": ["a", "d"], "rest": ["b-c", "e-f"], "tail": ["x", "y"]},
+        index=[10, 20],
+    )
+    assert_frame_equal(merged, expected)
+
+
+def test_separate_extra_warn_truncates_and_default_fill_warns():
+    data = pd.DataFrame({"label": ["a-b-c", "d"]})
+    with pytest.warns(UserWarning):
+        out = separate(data, "label", ["x", "y"], sep="-", extra="warn")
+    assert_frame_equal_missing(out, pd.DataFrame({"x": ["a", "d"], "y": ["b", None]}))
+
+    with pytest.warns(UserWarning):
+        padded = separate(pd.DataFrame({"label": ["a"]}), "label", ["x", "y"])
+    assert_frame_equal_missing(padded, pd.DataFrame({"x": ["a"], "y": [None]}))
+
+
+def test_separate_fill_right_aligns_missing_pieces():
+    data = pd.DataFrame({"label": ["a-b", "c"]})
+    right = separate(data, "label", ["x", "y", "z"], sep="-", fill="right")
+    assert_frame_equal_missing(
+        right,
+        pd.DataFrame({"x": ["a", "c"], "y": ["b", None], "z": [None, None]}),
+    )
+
+
+def test_separate_fill_left_aligns_missing_pieces():
+    data = pd.DataFrame({"label": ["a-b", "c"]})
+    left = separate(data, "label", ["x", "y", "z"], sep="-", fill="left")
+    assert_frame_equal_missing(
+        left,
+        pd.DataFrame({"x": [None, None], "y": ["a", None], "z": ["b", "c"]}),
+    )
+
+
+def test_separate_remove_false_convert_and_generated_column_order():
+    data = pd.DataFrame({"prefix": ["p", "q"], "label": ["1-2", "3-4"], "suffix": ["u", "v"]})
+    out = separate(data, "label", ["season", "episode"], sep="-", remove=False, convert=True)
+    expected = pd.DataFrame(
+        {
+            "prefix": ["p", "q"],
+            "label": ["1-2", "3-4"],
+            "season": [1, 3],
+            "episode": [2, 4],
+            "suffix": ["u", "v"],
+        }
+    )
+    assert_frame_equal(out, expected)
+    assert out["label"].tolist() == ["1-2", "3-4"]
+
+
+def test_separate_grouped_preserves_grouping_metadata():
+    data = pd.DataFrame(
+        {"g": ["b", "a", "b"], "label": ["2-x", "1-y", None], "value": [8, 9, 10]},
+        index=[5, 1, 9],
+    )
+    out = separate(group_by(data, _.g), _.label, ["num", "code"], sep="-", fill="right")
+    assert [group.name for group in out.grouper.groupings] == ["g"]
+
+
+def test_separate_grouped_preserves_row_order_and_index():
+    data = pd.DataFrame(
+        {"g": ["b", "a", "b"], "label": ["2-x", "1-y", None], "value": [8, 9, 10]},
+        index=[5, 1, 9],
+    )
+    out = separate(group_by(data, _.g), _.label, ["num", "code"], sep="-", fill="right")
+    expected = pd.DataFrame(
+        {
+            "g": ["b", "a", "b"],
+            "num": ["2", "1", None],
+            "code": ["x", "y", None],
+            "value": [8, 9, 10],
+        },
+        index=[5, 1, 9],
+    )
+    assert_frame_equal_missing(out.obj, expected)
+
+
+def test_separate_rejects_invalid_policies_duplicate_targets_and_missing_source():
+    data = pd.DataFrame({"label": ["a-b"]})
+    with pytest.raises(ValueError):
+        separate(data, "label", ["x", "y"], sep="-", extra="invalid")
+    with pytest.raises(ValueError):
+        separate(data, "label", ["x", "y"], sep="-", fill="invalid")
+    with pytest.raises(ValueError):
+        separate(data, "label", ["x", "x"], sep="-")
+    with pytest.raises(KeyError):
+        separate(data, "missing", ["x"])
