+})
+
+test.serial('same input result survives a fresh Node process', async t => {
+  const url =
+    'https://api.microlink.io/?url=https%3A%2F%2Ffresh.example%2Fasset&pdf=true'
+  const routes = {
+    [url]: {
+      status: 207,
+      headers: {
+        'content-type': 'application/pdf',
+        'x-fixture': 'fresh-process'
+      },
+      body: [10, 11, 12]
+    }
+  }
+
+  const inProcess = await withFetchMock(routes, async () => {
+    return envelope(
+      await mql.arrayBuffer('https://fresh.example/asset', { pdf: true })
+    )
+  })
+
+  const freshScript = `
+    const mql = require('@microlink/mql')
+    const routes = ${JSON.stringify(routes)}
+    globalThis.fetch = async input => {
+      const url = String(input.url || input)
+      const queryEntries = url => {
+        const parsed = new URL(url)
+        return {
+          base: parsed.origin + parsed.pathname,
+          entries: [...parsed.searchParams.entries()].sort(([a], [b]) => a.localeCompare(b))
+        }
+      }
+      const sameUrlIgnoringQueryOrder = (left, right) => {
+        const leftUrl = queryEntries(left)
+        const rightUrl = queryEntries(right)
+        return leftUrl.base === rightUrl.base && JSON.stringify(leftUrl.entries) === JSON.stringify(rightUrl.entries)
+      }
+      const routeUrl = Object.keys(routes).find(route => sameUrlIgnoringQueryOrder(url, route))
+      const fixture = routes[routeUrl]
+      if (!fixture) throw new Error('Unexpected fetch URL: ' + url)
+      const response = new Response(Uint8Array.from(fixture.body), {
+        status: fixture.status,
+        headers: fixture.headers
+      })
+      Object.defineProperty(response, 'url', { value: url })
+      return response
+    }
+    const envelope = response => ({
+      url: response.url,
+      statusCode: response.statusCode,
+      contentType: response.headers.get('content-type'),
+      body: Array.from(new Uint8Array(response.body))
+    })
+    mql.arrayBuffer('https://fresh.example/asset', { pdf: true })
+      .then(response => {
+        process.stdout.write(JSON.stringify(envelope(response)))
+      })
+      .catch(error => {
+        console.error(error)
+        process.exit(1)
+      })
+  `
+  const freshProcess = JSON.parse(
+    execFileSync(process.execPath, ['-e', freshScript], {
+      cwd: REPO,
+      encoding: 'utf8'
+    })
+  )
+
+
+  t.deepEqual(inProcess, freshProcess)
+  t.like(freshProcess, {
+    statusCode: 207,
+    contentType: 'application/pdf',
+    body: [10, 11, 12]
+  })
+  assertApiUrl(t, freshProcess.url, {
+    url: 'https://fresh.example/asset',
+    pdf: 'true'
+  })
+})
+
+test.serial('raw helpers fetch only declared API and direct URLs', async t => {
+  const apiUrl =
+    'https://api.microlink.io/?url=https%3A%2F%2Fside-effects.example%2Fasset&video=true'
+  const directUrl = 'https://assets.example.test/side-effects.bin'
+
+  await withFetchMock(
+    {
+      [apiUrl]: {
+        status: 208,
+        headers: {
+          'content-type': 'application/octet-stream',
+          'x-fixture': 'side-effects-api'
+        },
+        body: [6, 7]
+      },
+      [directUrl]: {
+        status: 200,
+        headers: {
+          'content-type': 'application/octet-stream'
+        },
+        body: [8, 9]
+      }
+    },
+    async calls => {
+      const raw = await mql.arrayBuffer('https://side-effects.example/asset', {
+        video: true
+      })
+      const readable = await mql.stream(directUrl)
+
+      assertRawEnvelope(t, raw, {
+        statusCode: 208,
+        contentType: 'application/octet-stream',
+        body: [6, 7]
+      })
+      t.is(typeof readable.getReader, 'function')
+      t.is(calls.length, 2)
+      assertApiUrl(t, calls[0].url, {
+        url: 'https://side-effects.example/asset',
+        video: 'true'
+      })
+      t.is(calls[1].url, 'https://assets.example.test/side-effects.bin')
+    }
+  )
+})
