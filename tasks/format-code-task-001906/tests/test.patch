+  const opts = {
+    screenshot: { type: 'png', fullPage: false },
+    stream: 'screenshot'
+  }
+  const gotOpts = { headers: { 'x-test': 'mutation' } }
+  const url =
+    'https://api.microlink.io/?url=https%3A%2F%2Fexample.com%2Fcard&screenshot.type=png&screenshot.fullPage=false&stream=screenshot'
+
+  await withFetchMock(
+    {
+      [url]: {
+        status: 200,
+        headers: {
+          'content-type': 'image/png',
+          'x-fixture': 'mutation'
+        },
+        body: [4]
+      }
+    },
+    async calls => {
+      const actual = await mql('https://example.com/card', opts, gotOpts)
+      assertRawEnvelope(t, actual, {
+        statusCode: 200,
+        contentType: 'image/png',
+        body: [4]
+      })
+      assertApiUrl(t, actual.url, {
+        url: 'https://example.com/card',
+        'screenshot.type': 'png',
+        'screenshot.fullPage': 'false',
