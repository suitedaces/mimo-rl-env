+'use strict'
+
+const { execFileSync } = require('child_process')
+const test = require('ava')
+
+const mql = require('@microlink/mql')
+
+const REPO = '/workspace/repo'
+
+const asBytes = body => Array.from(new Uint8Array(body))
+
+const envelope = response => ({
+  url: response.url,
+  statusCode: response.statusCode,
+
+  contentType: response.headers.get('content-type'),
+  body: asBytes(response.body)
+})
+
+const queryEntries = url => {
+  const parsed = new URL(url)
+  return {
+    base: `${parsed.origin}${parsed.pathname}`,
+    entries: [...parsed.searchParams.entries()].sort(([a], [b]) =>
+      a.localeCompare(b)
+    )
+  }
+}
+
+const sameUrlIgnoringQueryOrder = (left, right) => {
+  const leftUrl = queryEntries(left)
+  const rightUrl = queryEntries(right)
+  return (
+    leftUrl.base === rightUrl.base &&
+    JSON.stringify(leftUrl.entries) === JSON.stringify(rightUrl.entries)
+  )
+}
+
+
+const assertApiUrl = (t, actual, expectedParams) => {
+  const parsed = new URL(actual)
+  t.is(`${parsed.origin}${parsed.pathname}`, 'https://api.microlink.io/')
+  for (const [key, value] of Object.entries(expectedParams)) {
+    t.is(parsed.searchParams.get(key), value)
+  }
+  t.is([...parsed.searchParams.keys()].length, Object.keys(expectedParams).length)
+}
+
+const assertRawEnvelope = (t, actual, expected) => {
+  t.true(actual.body instanceof ArrayBuffer)
+  t.true(actual.headers instanceof Headers)
+  t.is(actual.statusCode, expected.statusCode)
+  t.is(actual.headers.get('content-type'), expected.contentType)
+  t.deepEqual(asBytes(actual.body), expected.body)
+}
+
+const installFetchMock = routes => {
+  const originalFetch = globalThis.fetch
+  const calls = []
+
+  globalThis.fetch = async input => {
+    const url = String(input.url || input)
+    const requestHeaders =
+      input.headers && typeof input.headers.entries === 'function'
+        ? Object.fromEntries(input.headers.entries())
+        : {}
+
+    calls.push({
+      url,
+      method: input.method || 'GET',
+      headers: requestHeaders
+    })
+
+    const routeUrl = Object.keys(routes).find(route =>
+      sameUrlIgnoringQueryOrder(url, route)
+    )
+    const fixture = routes[routeUrl]
+    if (!fixture) throw new Error(`Unexpected fetch URL: ${url}`)
+
+    const response = new Response(Uint8Array.from(fixture.body), {
+      status: fixture.status,
+      headers: fixture.headers
+    })
+    Object.defineProperty(response, 'url', { value: url })
+    return response
+  }
+
+  return {
+    calls,
+    restore: () => {
+      globalThis.fetch = originalFetch
+    }
+  }
+}
+
+const withFetchMock = async (routes, fn) => {
+  const mock = installFetchMock(routes)
+  try {
+    return await fn(mock.calls)
+  } finally {
+    mock.restore()
+  }
+}
+
+test.serial('mql with stream option returns raw ArrayBuffer envelope', async t => {
+
+
+
+
+  const url =
+    'https://api.microlink.io/?url=https%3A%2F%2Fexample.com&screenshot=true&stream=screenshot'
+
+  await withFetchMock(
+    {
+      [url]: {
+        status: 200,
+        headers: {
+          'content-type': 'image/png',
+          'x-fixture': 'stream-screenshot'
+        },
+        body: [1, 2, 3]
+      }
+    },
+    async calls => {
+      const actual = await mql(
+        'https://example.com',
+        { screenshot: true, stream: 'screenshot' },
+        { headers: { 'x-test': 'case-a' } }
+      )
+
+      assertRawEnvelope(t, actual, {
+        statusCode: 200,
+        contentType: 'image/png',
+        body: [1, 2, 3]
+      })
+      assertApiUrl(t, actual.url, {
+        url: 'https://example.com',
+        screenshot: 'true',
+        stream: 'screenshot'
+      })
+      t.is(calls.length, 1)
+      assertApiUrl(t, calls[0].url, {
+        url: 'https://example.com',
+        screenshot: 'true',
+        stream: 'screenshot'
+      })
+      t.is(calls[0].method, 'GET')
+
+      t.is(calls[0].headers['x-test'], 'case-a')
+    }
+  )
+})
+
+test.serial('arrayBuffer helper returns raw envelope for an API option object', async t => {
+
+
+
+
+  const url =
+    'https://api.microlink.io/?url=https%3A%2F%2Fexample.org%2Freport&pdf=true'
+
+  await withFetchMock(
+    {
+      [url]: {
+        status: 202,
+        headers: {
+          'content-type': 'application/pdf',
+          'x-fixture': 'array-buffer-pdf'
+        },
+        body: [37, 80, 68, 70, 45]
+      }
+    },
+    async calls => {
+      const actual = await mql.arrayBuffer('https://example.org/report', {
+        pdf: true
+      })
+
+      assertRawEnvelope(t, actual, {
+        statusCode: 202,
+        contentType: 'application/pdf',
+        body: [37, 80, 68, 70, 45]
+      })
+      assertApiUrl(t, actual.url, {
+        url: 'https://example.org/report',
+        pdf: 'true'
+      })
+      t.is(calls.length, 1)
+      assertApiUrl(t, calls[0].url, {
+        url: 'https://example.org/report',
+        pdf: 'true'
+      })
+    }
+  )
+})
+
+test.serial('arrayBuffer helper works when optional opts are omitted', async t => {
+
+
+
+
+  const url =
+    'https://api.microlink.io/?url=https%3A%2F%2Fexample.edu%2Fno-opts'
+
+  await withFetchMock(
+    {
+      [url]: {
+        status: 201,
+        headers: {
+          'content-type': 'application/octet-stream',
+          'x-fixture': 'no-opts'
+        },
+        body: [9, 8]
+      }
+    },
+    async calls => {
+      const actual = await mql.arrayBuffer('https://example.edu/no-opts')
+
+      assertRawEnvelope(t, actual, {
+        statusCode: 201,
+        contentType: 'application/octet-stream',
+        body: [9, 8]
+      })
+      assertApiUrl(t, actual.url, {
+        url: 'https://example.edu/no-opts'
+      })
+      t.is(calls.length, 1)
+      assertApiUrl(t, calls[0].url, {
+        url: 'https://example.edu/no-opts'
+      })
+      t.is(calls[0].method, 'GET')
+    }
+  )
+})
+
+test.serial('buffer helper is the arrayBuffer alias with equivalent behavior', async t => {
+
+
+
+
+  const url =
+    'https://api.microlink.io/?url=https%3A%2F%2Fexample.net%2Faudio&audio=true'
+
+  await withFetchMock(
+    {
+      [url]: {
+        status: 206,
+        headers: {
+          'content-type': 'audio/mpeg',
+          'x-fixture': 'buffer-audio'
+        },
+        body: [255, 251, 144, 100]
+      }
+    },
+    async calls => {
+      const actual = await mql.buffer('https://example.net/audio', {
+        audio: true
+      })
+
+
+      assertRawEnvelope(t, actual, {
+        statusCode: 206,
+        contentType: 'audio/mpeg',
+        body: [255, 251, 144, 100]
+      })
+      assertApiUrl(t, actual.url, {
+        url: 'https://example.net/audio',
+        audio: 'true'
+      })
+      t.is(calls.length, 1)
+      assertApiUrl(t, calls[0].url, {
+        url: 'https://example.net/audio',
+        audio: 'true'
+      })
+    }
+  )
+})
+
+test.serial('direct stream helper returns the readable response body', async t => {
+
+
+
+
+  const url = 'https://assets.example.test/logo.png'
+
+  await withFetchMock(
+    {
+      [url]: {
+        status: 200,
+        headers: {
+          'content-type': 'image/png'
+        },
+        body: [137, 80, 78, 71]
+      }
+    },
+    async calls => {
+      const actual = await mql.stream(url, {
+        headers: { accept: 'image/png' }
+      })
+
+
+      t.is(typeof actual.getReader, 'function')
+      t.deepEqual(calls.map(call => call.url), [
+        'https://assets.example.test/logo.png'
+      ])
+      t.is(calls[0].method, 'GET')
+      t.is(calls[0].headers.accept, 'image/png')
+    }
+  )
+})
+
+test('CommonJS and ESM public exports include raw helpers', t => {
+
+
+
+
+  const commonJsSummary = {
+    default: typeof mql,
+    arrayBuffer: typeof mql.arrayBuffer,
+    buffer: typeof mql.buffer,
+    stream: typeof mql.stream
+  }
+
+  const esmSummary = JSON.parse(
+    execFileSync(
+      process.execPath,
+      [
+        '--input-type=module',
+        '-e',
+        `
+          import mql, { arrayBuffer, buffer, stream } from '@microlink/mql'
+          console.log(JSON.stringify({
+            default: typeof mql,
+            arrayBuffer: typeof arrayBuffer,
+            buffer: typeof buffer,
+            stream: typeof stream
+          }))
+        `
+      ],
+      { cwd: REPO, encoding: 'utf8' }
+    )
+  )
+
+
+  t.deepEqual(commonJsSummary, {
+    default: 'function',
+    arrayBuffer: 'function',
+    buffer: 'function',
+    stream: 'function'
+  })
+  t.deepEqual(esmSummary, {
+    default: 'function',
+    arrayBuffer: 'function',
+    buffer: 'function',
+    stream: 'function'
+  })
+})
+
+test('invalid raw-mode URL raises the public MicrolinkError type', async t => {
+  const error = await t.throwsAsync(
+    mql.arrayBuffer('notaurl', { screenshot: true }),
+    { instanceOf: mql.MicrolinkError }
+  )
+
+
+  t.is(error.name, 'MicrolinkError')
+  t.is(error.url, 'notaurl')
+})
+
+test.serial('referential transparency for identical raw response calls', async t => {
+  const url =
+    'https://api.microlink.io/?url=https%3A%2F%2Frepeat.example%2Fasset&screenshot=true&stream=screenshot'
+
+  await withFetchMock(
+    {
+      [url]: {
+        status: 203,
+        headers: {
+          'content-type': 'image/png',
+          'x-fixture': 'repeat'
+        },
+        body: [5, 5, 5]
+      }
+    },
+    async () => {
+      const first = await mql('https://repeat.example/asset', {
+        screenshot: true,
+        stream: 'screenshot'
+      })
+      const second = await mql('https://repeat.example/asset', {
+        screenshot: true,
+        stream: 'screenshot'
+      })
+
+
+      t.deepEqual(envelope(first), envelope(second))
+      assertRawEnvelope(t, first, {
+        statusCode: 203,
+        contentType: 'image/png',
+        body: [5, 5, 5]
+      })
+      assertApiUrl(t, first.url, {
+        url: 'https://repeat.example/asset',
+        screenshot: 'true',
+        stream: 'screenshot'
+      })
+    }
+  )
+})
+
