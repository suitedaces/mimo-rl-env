diff --git a/tests/dialects/test_bigquery.py b/tests/dialects/test_bigquery.py
index a01ff292a..438ff93d8 100644
--- a/tests/dialects/test_bigquery.py
+++ b/tests/dialects/test_bigquery.py
@@ -5,7 +5,9 @@ from sqlglot import (
     ParseError,
     TokenError,
     UnsupportedError,
+    exp,
     parse,
+    parse_one,
     transpile,
 )
 from sqlglot.helper import logger as helper_logger
@@ -1088,3 +1090,38 @@ OPTIONS (
 
         with self.assertRaises(ParseError):
             transpile("SELECT JSON_OBJECT('a', 1, 'b') AS json_data", read="bigquery")
+
+    def test_countif(self):
+
+        ast_lower = parse_one("SELECT countif(x) FROM t", read="bigquery")
+        self.assertIsInstance(ast_lower.expressions[0], exp.CountIf)
+        self.assertNotIsInstance(ast_lower.expressions[0], exp.Anonymous)
+
+        ast_upper = parse_one("SELECT COUNTIF(x) FROM t", read="bigquery")
+        self.assertIsInstance(ast_upper.expressions[0], exp.CountIf)
+
+
+        ast_underscore = parse_one("SELECT COUNT_IF(x) FROM t")
+        self.assertIsInstance(ast_underscore.expressions[0], exp.CountIf)
+
+
+        ast_from_default = parse_one("SELECT COUNT_IF(x) FROM t")
+        self.assertEqual(ast_from_default.sql(dialect="bigquery"), "SELECT COUNTIF(x) FROM t")
+
+
+        self.assertEqual(
+            transpile("SELECT COUNTIF(x) FROM t", read="bigquery", write="bigquery")[0],
+            "SELECT COUNTIF(x) FROM t",
+        )
+        self.assertEqual(
+            transpile("SELECT COUNTIF(x) FROM t", read="bigquery", write="duckdb")[0],
+            "SELECT COUNT_IF(x) FROM t",
+        )
+        self.assertEqual(
+            transpile("SELECT COUNT_IF(x) FROM t", read="spark", write="bigquery")[0],
+            "SELECT COUNTIF(x) FROM t",
+        )
+        self.assertEqual(
+            transpile("SELECT COUNT_IF(x) FROM t", write="bigquery")[0],
+            "SELECT COUNTIF(x) FROM t",
+        )
