+import 'reflect-metadata';
+import { container } from 'tsyringe';
+import { FolderTreeService } from '../folderTreeService';
+import { FileTypes } from 'mo/model/workbench/explorer/folderTree';
+
+const folderTreeService = container.resolve(FolderTreeService);
+
+const buildTree = () => ({
+    id: 1,
+    name: 'root',
+    fileType: FileTypes.RootFolder,
+    location: 'root',
+    children: [
+        {
+            id: 2,
+            name: 'src',
+            fileType: FileTypes.Folder,
+            location: 'root/src',
+            children: [
+                {
+                    id: 3,
+                    name: 'index.ts',
+                    fileType: FileTypes.File,
+                    location: 'root/src/index.ts',
+                },
+            ],
+        },
+        {
+            id: 4,
+            name: 'a.ts',
+            fileType: FileTypes.File,
+            location: 'root/a.ts',
+        },
+    ],
+});
+
+const childIds = (node: any): number[] =>
+    (node?.children || []).map((c: any) => c.id);
+
+describe('Unified node CRUD on the folder-tree service', () => {
+    beforeEach(() => {
+        folderTreeService.setState({
+            folderTree: {
+                data: [buildTree()],
+                current: null,
+            },
+        });
+    });
+
+    describe('get', () => {
+        test('returns the node found anywhere in the hierarchy', () => {
+            expect(folderTreeService.get(1)?.name).toBe('root');
+            expect(folderTreeService.get(2)?.name).toBe('src');
+            expect(folderTreeService.get(3)?.name).toBe('index.ts');
+            expect(folderTreeService.get(4)?.name).toBe('a.ts');
+        });
+
+        test('returns null when no node matches', () => {
+            expect(folderTreeService.get(999)).toBeNull();
+        });
+    });
+
+    describe('add', () => {
+        test('adds the node as a child of a referenced folder', () => {
+            folderTreeService.add(
+                { id: 10, name: 'utils.ts', fileType: FileTypes.File },
+                2
+            );
+
+            expect(folderTreeService.get(10)?.name).toBe('utils.ts');
+            expect(childIds(folderTreeService.get(2))).toContain(10);
+        });
+
+        test('adds the node as a child of a referenced root folder', () => {
+            folderTreeService.add(
+                { id: 11, name: 'lib', fileType: FileTypes.Folder },
+                1
+            );
+
+            expect(folderTreeService.get(11)?.name).toBe('lib');
+            expect(childIds(folderTreeService.get(1))).toContain(11);
+        });
+
+        test('places the node alongside a referenced file in the same parent', () => {
+
+            folderTreeService.add(
+                { id: 12, name: 'extra.ts', fileType: FileTypes.File },
+                3
+            );
+
+            expect(folderTreeService.get(12)?.name).toBe('extra.ts');
+            expect(childIds(folderTreeService.get(2))).toContain(12);
+
+            expect(childIds(folderTreeService.get(3))).not.toContain(12);
+        });
+
+        test('adds a new root entry when no reference id is given', () => {
+            const before = folderTreeService.getState().folderTree?.data
+                ?.length;
+
+            folderTreeService.add({
+                id: 20,
+                name: 'root2',
+                fileType: FileTypes.RootFolder,
+            });
+
+            const data = folderTreeService.getState().folderTree?.data || [];
+            expect(data.length).toBe((before || 0) + 1);
+            expect(folderTreeService.get(20)?.name).toBe('root2');
+            expect(data.map((n: any) => n.id)).toContain(20);
+        });
+    });
+
+    describe('update', () => {
+        test('merges the given fields into the existing node in place', () => {
+            folderTreeService.update({ id: 2, name: 'lib', isEditable: true });
+
+            const node = folderTreeService.get(2);
+            expect(node?.name).toBe('lib');
+            expect(node?.isEditable).toBe(true);
+
+            expect(node?.location).toBe('root/src');
+
+            expect(childIds(folderTreeService.get(1))).toContain(2);
+
+            expect(childIds(node)).toContain(3);
+        });
+
+        test('does nothing when no node matches the id', () => {
+            const before = JSON.stringify(
+                folderTreeService.getState().folderTree?.data
+            );
+            folderTreeService.update({ id: 999, name: 'nope' });
+            const after = JSON.stringify(
+                folderTreeService.getState().folderTree?.data
+            );
+            expect(after).toBe(before);
+        });
+    });
+
+    describe('remove', () => {
+        test('removes the node and its subtree', () => {
+            folderTreeService.remove(2);
+
+            expect(folderTreeService.get(2)).toBeNull();
+
+            expect(folderTreeService.get(3)).toBeNull();
+
+            expect(childIds(folderTreeService.get(1))).not.toContain(2);
+        });
+
+        test('leaves sibling nodes untouched', () => {
+            folderTreeService.remove(2);
+
+            expect(folderTreeService.get(4)?.name).toBe('a.ts');
+            expect(childIds(folderTreeService.get(1))).toContain(4);
+        });
+
+        test('does nothing when no node matches the id', () => {
+            const before = JSON.stringify(
+                folderTreeService.getState().folderTree?.data
+            );
+            folderTreeService.remove(999);
+            const after = JSON.stringify(
+                folderTreeService.getState().folderTree?.data
+            );
+            expect(after).toBe(before);
+        });
+    });
+});
