+func Test_ValidateNodeWithSpotWorkerLabel(t *testing.T) {
+
+
+
+	groups := make(map[string]*cloudinstances.CloudInstanceGroup)
+	groups["node-1"] = &cloudinstances.CloudInstanceGroup{
+		MinSize: 1,
+		InstanceGroup: &kopsapi.InstanceGroup{
+			ObjectMeta: metav1.ObjectMeta{
+				Name: "node-1",
+			},
+			Spec: kopsapi.InstanceGroupSpec{
+				Role: kopsapi.InstanceGroupRoleNode,
+			},
+		},
+		Ready: []*cloudinstances.CloudInstanceGroupMember{
+			{
+				ID: "i-00001",
+				Node: &v1.Node{
+					ObjectMeta: metav1.ObjectMeta{
+						Name: "node-1a",
+						Labels: map[string]string{
+							"node-role.kubernetes.io/spot-worker": "true",
+						},
+					},
+					Status: v1.NodeStatus{
+						Conditions: []v1.NodeCondition{
+							{Type: "Ready", Status: v1.ConditionTrue},
+						},
+					},
+				},
+			},
+		},
+	}
+
+	v, err := testValidate(t, groups, nil)
+	require.NoError(t, err)
+
+	if !assert.Empty(t, v.Failures, "spot-worker node should not produce failures") {
+		printDebug(t, v)
+	}
+
+
+	if !assert.Len(t, v.Nodes, 1, "spot-worker node should be included in validation result") {
+		printDebug(t, v)
+		return
+	}
+	assert.Equal(t, "node-1a", v.Nodes[0].Name)
+	assert.Equal(t, "node", v.Nodes[0].Role,
+		"node's role should be derived from InstanceGroup spec (node), not the spot-worker label")
+}
+
+func Test_ValidateNotReadyNodeWithSpotWorkerLabel(t *testing.T) {
+
+
+
+	groups := make(map[string]*cloudinstances.CloudInstanceGroup)
+	groups["node-1"] = &cloudinstances.CloudInstanceGroup{
+		MinSize: 1,
+		InstanceGroup: &kopsapi.InstanceGroup{
+			ObjectMeta: metav1.ObjectMeta{
+				Name: "node-1",
+			},
+			Spec: kopsapi.InstanceGroupSpec{
+				Role: kopsapi.InstanceGroupRoleNode,
+			},
+		},
+		Ready: []*cloudinstances.CloudInstanceGroupMember{
+			{
+				ID: "i-00001",
+				Node: &v1.Node{
+					ObjectMeta: metav1.ObjectMeta{
+						Name: "node-1a",
+						Labels: map[string]string{
+							"node-role.kubernetes.io/spot-worker": "true",
+						},
+					},
+					Status: v1.NodeStatus{
+						Conditions: []v1.NodeCondition{
+							{Type: "Ready", Status: v1.ConditionFalse},
+						},
+					},
+				},
+			},
+		},
+	}
+
+	v, err := testValidate(t, groups, nil)
+	require.NoError(t, err)
+
+	if !assert.Len(t, v.Failures, 1, "not-ready spot-worker node should produce one failure") {
+		printDebug(t, v)
+		return
+	}
+	assert.Equal(t, "Node", v.Failures[0].Kind)
+	assert.Equal(t, "node-1a", v.Failures[0].Name)
+	assert.Equal(t, "node \"node-1a\" is not ready", v.Failures[0].Message)
+
+	if !assert.Len(t, v.Nodes, 1) {
+		printDebug(t, v)
+		return
+	}
+	assert.Equal(t, "node", v.Nodes[0].Role)
+}
