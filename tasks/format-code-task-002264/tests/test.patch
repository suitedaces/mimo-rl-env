diff --git a/json_arrayagg_hidden_test.go b/json_arrayagg_hidden_test.go
new file mode 100644
index 000000000..111111111
--- /dev/null
+++ b/json_arrayagg_hidden_test.go
@@ -0,0 +1,33 @@
+package parser_test
+
+import (
+	"strings"
+
+	"github.com/pingcap/parser"
+	"github.com/pingcap/parser/ast"
+	. "github.com/pingcap/check"
+)
+
+func (s *testParserSuite) TestJsonArrayaggParsesAsAggregate(c *C) {
+	p := parser.New()
+	cases := []string{
+		"select json_arrayagg(c2) from t group by c1",
+		"select JSON_ARRAYAGG(a) from t",
+	}
+	for _, sql := range cases {
+		stmt, err := p.ParseOneStmt(sql, "", "")
+		c.Assert(err, IsNil)
+		selectStmt, ok := stmt.(*ast.SelectStmt)
+		c.Assert(ok, IsTrue)
+		c.Assert(selectStmt.Fields.Fields, HasLen, 1)
+		agg, ok := selectStmt.Fields.Fields[0].Expr.(*ast.AggregateFuncExpr)
+		c.Assert(ok, IsTrue)
+		c.Assert(strings.EqualFold(agg.F, ast.AggFuncJsonArrayagg), IsTrue)
+	}
+	_, err := p.ParseOneStmt("select json_arrayagg(c1, c2) from t", "", "")
+	c.Assert(err, NotNil)
+}
+
+func (s *testParserSuite) TestAggFuncJsonArrayaggConstant(c *C) {
+	c.Assert(ast.AggFuncJsonArrayagg, Equals, "json_arrayagg")
+}
