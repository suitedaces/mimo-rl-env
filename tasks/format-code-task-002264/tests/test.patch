@@ -0,0 +1,16 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test -v -run TestT -check.f TestSimple -count=1 .
+    ;;
+  new)
+    go test -v -run TestT -check.f 'TestBuiltin|TestJsonArrayaggParsesAsAggregate|TestAggFuncJsonArrayaggConstant' -count=1 .
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
