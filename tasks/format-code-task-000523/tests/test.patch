+from __future__ import annotations
+
+from copy import deepcopy
+
+import pytest
+
+from b2sdk.v3 import RawSimulator
+from b2sdk.v3.exception import NonExistentBucket, Unauthorized
+from b2sdk._internal.exception import ResourceNotFound
+
+
+
+
+
+
+
+
+
+
+BASE_RULE = {
+    'eventTypes': ['b2:ObjectCreated:*'],
+    'isEnabled': True,
+    'name': 'test-rule',
+    'objectNamePrefix': '',
+    'targetConfiguration': {
+        'customHeaders': [],
+        'targetType': 'webhook',
+        'url': 'https://example.com/webhook',
+    },
+}
+
+BASE_RULE_RESPONSE = [
+    {
+        'eventTypes': ['b2:ObjectCreated:*'],
+        'isEnabled': True,
+        'isSuspended': False,
+        'name': 'test-rule',
+        'objectNamePrefix': '',
+        'suspensionReason': '',
+        'targetConfiguration': {
+            'customHeaders': [],
+            'targetType': 'webhook',
+            'url': 'https://example.com/webhook',
+        },
+    }
+]
+
+
+def _authorized_simulator_with_bucket(bucket_name='bucket-one'):
+    raw = RawSimulator()
+    account_id, master_key = raw.create_account()
+    auth = raw.authorize_account('production', account_id, master_key)
+    api_url = auth['apiInfo']['storageApi']['apiUrl']
+    auth_token = auth['authorizationToken']
+    bucket = raw.create_bucket(api_url, auth_token, account_id, bucket_name, 'allPrivate')
+    return raw, account_id, api_url, auth_token, bucket['bucketId']
+
+
+def _application_token(raw, api_url, master_token, account_id, capabilities, key_name):
+    key = raw.create_key(api_url, master_token, account_id, capabilities, key_name, None, None, None)
+    auth = raw.authorize_account('production', key['applicationKeyId'], key['applicationKey'])
+    return auth['apiInfo']['storageApi']['apiUrl'], auth['authorizationToken']
+
+
+def _assert_exact_resource_not_found(exc):
+
+    assert isinstance(exc, ResourceNotFound)
+
+
+def test_new_set_get_and_clear_notification_rules_persist_bucket_state():
+
+
+
+
+    raw, _account_id, api_url, auth_token, bucket_id = _authorized_simulator_with_bucket()
+
+    assert raw.get_bucket_notification_rules(api_url, auth_token, bucket_id) == []
+    assert raw.set_bucket_notification_rules(api_url, auth_token, bucket_id, [deepcopy(BASE_RULE)]) == (
+        BASE_RULE_RESPONSE
+    )
+    assert raw.get_bucket_notification_rules(api_url, auth_token, bucket_id) == BASE_RULE_RESPONSE
+    assert raw.set_bucket_notification_rules(api_url, auth_token, bucket_id, []) == []
+    assert raw.get_bucket_notification_rules(api_url, auth_token, bucket_id) == []
+    assert raw.set_bucket_notification_rules(api_url, auth_token, bucket_id, []) == []
+    assert raw.get_bucket_notification_rules(api_url, auth_token, bucket_id) == []
+
+
+def test_set_ignores_client_supplied_suspension_fields():
+
+
+
+
+    raw, _account_id, api_url, auth_token, bucket_id = _authorized_simulator_with_bucket()
+    rule = deepcopy(BASE_RULE)
+    rule['name'] = 'ignored-fields'
+    rule['isSuspended'] = True
+    rule['suspensionReason'] = 'client supplied'
+
+    expected = [
+        {
+            'eventTypes': ['b2:ObjectCreated:*'],
+            'isEnabled': True,
+            'isSuspended': False,
+            'name': 'ignored-fields',
+            'objectNamePrefix': '',
+            'suspensionReason': '',
+            'targetConfiguration': {
+                'customHeaders': [],
+                'targetType': 'webhook',
+                'url': 'https://example.com/webhook',
+            },
+        }
+    ]
+    assert raw.set_bucket_notification_rules(api_url, auth_token, bucket_id, [rule]) == expected
+    assert raw.get_bucket_notification_rules(api_url, auth_token, bucket_id) == expected
+
+
+def test_setting_same_rule_name_merges_target_configuration():
+
+
+
+
+    raw, _account_id, api_url, auth_token, bucket_id = _authorized_simulator_with_bucket()
+
+    first_rule = {
+        'eventTypes': ['b2:ObjectCreated:*'],
+        'isEnabled': True,
+        'name': 'merge-rule',
+        'objectNamePrefix': 'photos/',
+        'targetConfiguration': {
+            'customHeaders': [{'name': 'X-Trace', 'value': 'one'}],
+            'targetType': 'webhook',
+            'url': 'https://example.com/one',
+        },
+    }
+    second_rule = {
+        'eventTypes': ['b2:ObjectCreated:Upload'],
+        'isEnabled': False,
+        'name': 'merge-rule',
+        'objectNamePrefix': 'photos/2026/',
+        'targetConfiguration': {
+            'url': 'https://example.com/two',
+        },
+    }
+
+    assert raw.set_bucket_notification_rules(api_url, auth_token, bucket_id, [first_rule]) == [
+        {
+            'eventTypes': ['b2:ObjectCreated:*'],
+            'isEnabled': True,
+            'isSuspended': False,
+            'name': 'merge-rule',
+            'objectNamePrefix': 'photos/',
+            'suspensionReason': '',
+            'targetConfiguration': {
+                'customHeaders': [{'name': 'X-Trace', 'value': 'one'}],
+                'targetType': 'webhook',
+                'url': 'https://example.com/one',
+            },
+        }
+    ]
+    expected_after_merge = [
+        {
+            'eventTypes': ['b2:ObjectCreated:Upload'],
+            'isEnabled': False,
+            'isSuspended': False,
+            'name': 'merge-rule',
+            'objectNamePrefix': 'photos/2026/',
+            'suspensionReason': '',
+            'targetConfiguration': {
+                'customHeaders': [{'name': 'X-Trace', 'value': 'one'}],
+                'targetType': 'webhook',
+                'url': 'https://example.com/two',
+            },
+        }
+    ]
+    assert raw.set_bucket_notification_rules(api_url, auth_token, bucket_id, [second_rule]) == (
+        expected_after_merge
+    )
+    assert raw.get_bucket_notification_rules(api_url, auth_token, bucket_id) == expected_after_merge
+
+
+def test_simulate_notification_rule_suspension_updates_matching_rule():
+
+
+
+
+    raw, _account_id, api_url, auth_token, bucket_id = _authorized_simulator_with_bucket()
+    assert raw.set_bucket_notification_rules(api_url, auth_token, bucket_id, [deepcopy(BASE_RULE)]) == (
+        BASE_RULE_RESPONSE
+    )
+
+    bucket_simulator = raw.bucket_id_to_bucket[bucket_id]
+    assert bucket_simulator.simulate_notification_rule_suspension(
+        'test-rule', 'simulated suspension'
+    ) is None
+    assert raw.get_bucket_notification_rules(api_url, auth_token, bucket_id) == [
+        {
+            'eventTypes': ['b2:ObjectCreated:*'],
+            'isEnabled': True,
+            'isSuspended': True,
+            'name': 'test-rule',
+            'objectNamePrefix': '',
+            'suspensionReason': 'simulated suspension',
+            'targetConfiguration': {
+                'customHeaders': [],
+                'targetType': 'webhook',
+                'url': 'https://example.com/webhook',
+            },
+        }
+    ]
+
+    assert bucket_simulator.simulate_notification_rule_suspension(
+        'test-rule', 'manual clear', False
+    ) is None
+    assert raw.get_bucket_notification_rules(api_url, auth_token, bucket_id) == [
+        {
+            'eventTypes': ['b2:ObjectCreated:*'],
+            'isEnabled': True,
+            'isSuspended': False,
+            'name': 'test-rule',
+            'objectNamePrefix': '',
+            'suspensionReason': 'manual clear',
+            'targetConfiguration': {
+                'customHeaders': [],
+                'targetType': 'webhook',
+                'url': 'https://example.com/webhook',
+            },
+        }
+    ]
+
+    assert bucket_simulator.simulate_notification_rule_suspension('test-rule', '') is None
+    assert raw.get_bucket_notification_rules(api_url, auth_token, bucket_id) == BASE_RULE_RESPONSE
+
+
+def test_simulate_notification_rule_suspension_missing_name_raises_resource_not_found():
+
+
+
+
+    raw, _account_id, api_url, auth_token, bucket_id = _authorized_simulator_with_bucket()
+    assert raw.set_bucket_notification_rules(api_url, auth_token, bucket_id, [deepcopy(BASE_RULE)]) == (
+        BASE_RULE_RESPONSE
+    )
+
+    try:
+        raw.bucket_id_to_bucket[bucket_id].simulate_notification_rule_suspension(
+            'missing-rule', 'x'
+        )
+    except BaseException as exc:
+        _assert_exact_resource_not_found(exc)
+    else:
+        pytest.fail('simulate_notification_rule_suspension accepted a missing rule name')
+
+
+def test_notification_rule_methods_enforce_read_and_write_capabilities():
+
+
+
+
+    raw, account_id, api_url, master_token, bucket_id = _authorized_simulator_with_bucket()
+    read_api_url, read_token = _application_token(
+        raw, api_url, master_token, account_id, ['readBucketNotifications'], 'read-notify'
+    )
+    write_api_url, write_token = _application_token(
+        raw, api_url, master_token, account_id, ['writeBucketNotifications'], 'write-notify'
+    )
+
+    assert raw.get_bucket_notification_rules(read_api_url, read_token, bucket_id) == []
+    with pytest.raises(Unauthorized) as read_only_write_error:
+        raw.set_bucket_notification_rules(read_api_url, read_token, bucket_id, [])
+
+    assert isinstance(read_only_write_error.value, Unauthorized)
+
+    assert raw.set_bucket_notification_rules(write_api_url, write_token, bucket_id, [deepcopy(BASE_RULE)]) == (
+        BASE_RULE_RESPONSE
+    )
+    with pytest.raises(Unauthorized) as write_only_read_error:
+        raw.get_bucket_notification_rules(write_api_url, write_token, bucket_id)
+
+    assert isinstance(write_only_read_error.value, Unauthorized)
+
+
+def test_unknown_bucket_id_uses_normal_nonexistent_bucket_error():
+
+
+
+
+    raw, _account_id, api_url, auth_token, _bucket_id = _authorized_simulator_with_bucket()
+
+    with pytest.raises(NonExistentBucket) as get_error:
+        raw.get_bucket_notification_rules(api_url, auth_token, 'bucket_missing')
+
+    assert isinstance(get_error.value, NonExistentBucket)
+
+    with pytest.raises(NonExistentBucket) as set_error:
+        raw.set_bucket_notification_rules(api_url, auth_token, 'bucket_missing', [])
+
+    assert isinstance(set_error.value, NonExistentBucket)
+
+
+def test_notification_rules_are_independent_between_raw_simulator_instances():
+
+
+
+
+    raw_a, _account_a, api_url_a, token_a, bucket_a = _authorized_simulator_with_bucket('bucket-a')
+    raw_b, _account_b, api_url_b, token_b, bucket_b = _authorized_simulator_with_bucket('bucket-b')
+
+    assert raw_a.set_bucket_notification_rules(api_url_a, token_a, bucket_a, [deepcopy(BASE_RULE)]) == (
+        BASE_RULE_RESPONSE
+    )
+    assert raw_a.get_bucket_notification_rules(api_url_a, token_a, bucket_a) == BASE_RULE_RESPONSE
+    assert raw_b.get_bucket_notification_rules(api_url_b, token_b, bucket_b) == []
+
+
+def test_repeated_rule_set_and_clear_cycles_leave_notification_rule_counter_bounded():
+
+
+
+
+    raw, _account_id, api_url, auth_token, bucket_id = _authorized_simulator_with_bucket()
+
+    for _ in range(150):
+        assert raw.set_bucket_notification_rules(
+            api_url, auth_token, bucket_id, [deepcopy(BASE_RULE)]
+        ) == BASE_RULE_RESPONSE
+        assert raw.set_bucket_notification_rules(api_url, auth_token, bucket_id, []) == []
+
+    persisted_rule_count = len(raw.get_bucket_notification_rules(api_url, auth_token, bucket_id))
+    assert persisted_rule_count == 0
