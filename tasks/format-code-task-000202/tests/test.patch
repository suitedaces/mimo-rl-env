@@ -0,0 +1,101 @@
+
+
+
+
+
+import pytest
+
+import pennylane as qml
+
+
+class TestObservableAddZero:
+    def test_sum_of_observables_reproduction(self):
+
+        H = sum([qml.PauliX(i) for i in range(10)])
+        expected = qml.Hamiltonian([1.0] * 10, [qml.PauliX(i) for i in range(10)])
+        assert isinstance(H, qml.Hamiltonian)
+        assert H.compare(expected)
+
+    def test_observable_plus_zero_returns_self(self):
+
+        obs = qml.PauliX(0)
+        result = obs + 0
+
+        assert isinstance(result, type(obs)) or result.compare(obs)
+
+    def test_zero_plus_observable_returns_self(self):
+
+        obs = qml.PauliY(2)
+        result = 0 + obs
+        assert isinstance(result, type(obs)) or result.compare(obs)
+
+    def test_observable_plus_zero_float(self):
+
+        obs = qml.PauliZ(1)
+        result = obs + 0.0
+        assert result.compare(obs)
+
+    def test_observable_plus_nonzero_raises(self):
+
+        obs = qml.PauliX(0)
+        with pytest.raises((ValueError, TypeError)):
+            _ = obs + 5
+
+    def test_observable_plus_observable_still_works(self):
+
+        result = qml.PauliX(0) + qml.PauliZ(1)
+        expected = qml.Hamiltonian([1.0, 1.0], [qml.PauliX(0), qml.PauliZ(1)])
+        assert isinstance(result, qml.Hamiltonian)
+        assert result.compare(expected)
+
+
+class TestTensorAddZero:
+    def test_tensor_plus_zero(self):
+
+        T = qml.PauliX(0) @ qml.PauliZ(1)
+        result = T + 0
+        assert result.compare(T)
+
+    def test_zero_plus_tensor(self):
+
+        T = qml.PauliX(0) @ qml.PauliZ(1)
+        result = 0 + T
+        assert result.compare(T)
+
+
+class TestHamiltonianAddZero:
+    def test_hamiltonian_plus_zero(self):
+
+        H = qml.Hamiltonian([1.0, 2.0], [qml.PauliX(0), qml.PauliZ(1)])
+        result = H + 0
+        assert result.compare(H)
+
+    def test_zero_plus_hamiltonian(self):
+
+        H = qml.Hamiltonian([1.0, 2.0], [qml.PauliX(0), qml.PauliZ(1)])
+        result = 0 + H
+        assert result.compare(H)
+
+    def test_hamiltonian_iadd_zero(self):
+
+        H = qml.Hamiltonian([1.0, 2.0], [qml.PauliX(0), qml.PauliZ(1)])
+        expected = qml.Hamiltonian([1.0, 2.0], [qml.PauliX(0), qml.PauliZ(1)])
+        H += 0
+        assert H.compare(expected)
+
+    def test_hamiltonian_plus_nonzero_raises(self):
+
+        H = qml.Hamiltonian([1.0], [qml.PauliX(0)])
+        with pytest.raises((ValueError, TypeError)):
+            _ = H + 5
+
+    def test_sum_of_hamiltonians(self):
+
+        terms = [qml.Hamiltonian([1.0], [qml.PauliX(i)]) for i in range(3)]
+        H = sum(terms)
+        expected = qml.Hamiltonian(
+            [1.0, 1.0, 1.0],
+            [qml.PauliX(0), qml.PauliX(1), qml.PauliX(2)],
+        )
+        assert isinstance(H, qml.Hamiltonian)
+        assert H.compare(expected)
