+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 -run 'TestClusterApplyKIND$|TestClusterApplyMinikubeVersion$' ./pkg/cluster/
+    ;;
+  new)
+    go test -v -count=1 -run 'TestKindClusterSpecAcceptsKubernetesVersion$|TestKindCreateWithKubernetesVersionAddsCompatibleVersionPin$|TestKindCreateWithoutKubernetesVersionDoesNotForceVersionPin$|TestKindCreatePatchVersionsWithinSameMinorSelectSameCompatibleVersionPin$|TestKindCreateUnknownKindVersionReturnsClearError$|TestKindCreateUnsupportedKubernetesMinorReturnsClearError$|TestKindCreateInvalidKubernetesVersionReturnsParseError$|TestKindCreateMalformedKindVersionOutputReturnsParseError$' ./pkg/cluster/
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
