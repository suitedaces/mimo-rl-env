@@ -0,0 +1,208 @@
+'use strict'
+
+const chai = require('chai')
+const expect = chai.expect
+
+const EventValidators = require('../src/utils/event-validators')
+const validateTwitter = EventValidators.TWITTER
+
+
+
+function expectShareContent(result, content) {
+  expect(result).to.be.a('string')
+  expect(result.trim()).to.equal(content)
+}
+
+describe('Twitter event validation', () => {
+  describe('FOLLOW', () => {
+    it('always validates to true', () => {
+      expect(validateTwitter({ type: 'FOLLOW', event: {} })).to.equal(true)
+    })
+  })
+
+  describe('SHARE - existing behavior', () => {
+    it('accepts an exact match and returns the content', () => {
+      const content = 'Hello world'
+      const event = { text: 'Hello world', entities: { urls: [] } }
+      expectShareContent(validateTwitter({ type: 'SHARE', content, event }), content)
+    })
+
+    it('ignores leading/trailing whitespace differences', () => {
+      const content = 'Hello world'
+      const event = { text: '   Hello world  ', entities: { urls: [] } }
+      expectShareContent(validateTwitter({ type: 'SHARE', content, event }), content)
+    })
+
+    it('rejects content that does not match', () => {
+      const event = { text: 'Something else entirely', entities: { urls: [] } }
+      expect(
+        validateTwitter({ type: 'SHARE', content: 'Hello world', event })
+      ).to.equal(false)
+    })
+
+    it('expands shortened t.co URLs before comparing', () => {
+      const content = 'Check out http://www.originprotocol.com now'
+      const event = {
+        text: 'Check out https://t.co/abc123 now',
+        entities: {
+          urls: [
+            { url: 'https://t.co/abc123', expanded_url: 'http://www.originprotocol.com' }
+          ]
+        }
+      }
+      expectShareContent(validateTwitter({ type: 'SHARE', content, event }), content)
+    })
+
+    it('uses the extended payload full text for truncated tweets', () => {
+      const content =
+        'This is a very long tweet body that got truncated by the API for sure'
+      const event = {
+        text: 'This is a very long tweet body that got truncated by the…',
+        extended_tweet: {
+          full_text:
+            'This is a very long tweet body that got truncated by the API for sure',
+          entities: { urls: [] }
+        }
+      }
+      expectShareContent(validateTwitter({ type: 'SHARE', content, event }), content)
+    })
+
+    it('HTML-decodes the tweet text before comparing', () => {
+      const content = `Buy & sell on Origin's <marketplace>`
+      const event = {
+        text: `Buy &amp; sell on Origin&#x27;s &lt;marketplace&gt;`,
+        entities: { urls: [] }
+      }
+      expectShareContent(validateTwitter({ type: 'SHARE', content, event }), content)
+    })
+  })
+
+  describe('SHARE - attached media', () => {
+    it('strips a media link listed under entities.media', () => {
+      const content = 'Look at this listing on Origin'
+      const event = {
+        text: 'Look at this listing on Origin https://t.co/pic123',
+        entities: {
+          urls: [],
+          media: [{ url: 'https://t.co/pic123' }]
+        }
+      }
+      expectShareContent(validateTwitter({ type: 'SHARE', content, event }), content)
+    })
+
+    it('strips a media link listed only under extended_entities.media', () => {
+      const content = 'Look at this listing on Origin'
+      const event = {
+        text: 'Look at this listing on Origin https://t.co/pic456',
+        entities: { urls: [] },
+        extended_entities: {
+          media: [{ url: 'https://t.co/pic456' }]
+        }
+      }
+      expectShareContent(validateTwitter({ type: 'SHARE', content, event }), content)
+    })
+
+    it('strips multiple media links', () => {
+      const content = 'Two photos here'
+      const event = {
+        text: 'Two photos here https://t.co/p1 https://t.co/p2',
+        entities: {
+          urls: [],
+          media: [{ url: 'https://t.co/p1' }, { url: 'https://t.co/p2' }]
+        }
+      }
+      expectShareContent(validateTwitter({ type: 'SHARE', content, event }), content)
+    })
+
+    it('handles media on a truncated tweet (extended payload)', () => {
+      const content =
+        'A long tweet with an attached photo that gets truncated here ok'
+      const event = {
+        text: 'A long tweet with an attached photo…',
+        extended_tweet: {
+          full_text:
+            'A long tweet with an attached photo that gets truncated here ok https://t.co/picXt',
+          entities: { urls: [] },
+          extended_entities: { media: [{ url: 'https://t.co/picXt' }] }
+        }
+      }
+      expectShareContent(validateTwitter({ type: 'SHARE', content, event }), content)
+    })
+
+    it('still rejects a media share whose text does not match', () => {
+      const event = {
+        text: 'Completely different text https://t.co/picZ',
+        entities: {
+          urls: [],
+          media: [{ url: 'https://t.co/picZ' }]
+        }
+      }
+      expect(
+        validateTwitter({ type: 'SHARE', content: 'Look at this listing on Origin', event })
+      ).to.equal(false)
+    })
+  })
+
+  describe('SHARE - retweets', () => {
+    it('validates the original tweet, not the RT wrapper', () => {
+      const content = 'Original promoted content'
+      const event = {
+        text: 'RT @originprotocol: Original promoted content',
+        entities: { urls: [] },
+        retweeted_status: {
+          text: 'Original promoted content',
+          entities: { urls: [] }
+        }
+      }
+      expectShareContent(validateTwitter({ type: 'SHARE', content, event }), content)
+    })
+
+    it('uses the original tweet full text when the original is truncated', () => {
+      const content =
+        'Original promoted content that is quite long and was truncated here yes'
+      const event = {
+        text: 'RT @originprotocol: Original promoted content that is quite…',
+        entities: { urls: [] },
+        retweeted_status: {
+          text: 'Original promoted content that is quite…',
+          extended_tweet: {
+            full_text:
+              'Original promoted content that is quite long and was truncated here yes',
+            entities: { urls: [] }
+          }
+        }
+      }
+      expectShareContent(validateTwitter({ type: 'SHARE', content, event }), content)
+    })
+
+    it('applies URL expansion and media stripping to the retweeted tweet', () => {
+      const content = 'Promo http://www.originprotocol.com with pic'
+      const event = {
+        text: 'RT @originprotocol: Promo https://t.co/u1 with pic https://t.co/m1',
+        entities: { urls: [] },
+        retweeted_status: {
+          text: 'Promo https://t.co/u1 with pic https://t.co/m1',
+          entities: {
+            urls: [{ url: 'https://t.co/u1', expanded_url: 'http://www.originprotocol.com' }],
+            media: [{ url: 'https://t.co/m1' }]
+          }
+        }
+      }
+      expectShareContent(validateTwitter({ type: 'SHARE', content, event }), content)
+    })
+
+    it('rejects a retweet whose original content does not match', () => {
+      const event = {
+        text: 'RT @someoneelse: Totally unrelated tweet',
+        entities: { urls: [] },
+        retweeted_status: {
+          text: 'Totally unrelated tweet',
+          entities: { urls: [] }
+        }
+      }
+      expect(
+        validateTwitter({ type: 'SHARE', content: 'Original promoted content', event })
+      ).to.equal(false)
+    })
+  })
+})
