+func TestMain(m *testing.M) {
+	tmpDir, err := os.MkdirTemp("", "goby-http-one-shot-")
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	defer os.RemoveAll(tmpDir)
+
+	gobyBinary = filepath.Join(tmpDir, "goby")
+	build := exec.Command("go", "build", "-o", gobyBinary, ".")
+	build.Dir = "/workspace/repo"
+	build.Env = append(os.Environ(), "GOBY_ROOT=/workspace/repo")
+	if out, err := build.CombinedOutput(); err != nil {
+		fmt.Fprintf(os.Stderr, "failed to build Goby binary: %v\n%s", err, out)
+		os.Exit(1)
+	}
+
+	shutdown, baseURL, err := startFixtureServer()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	serverBaseURL = baseURL
+	code := m.Run()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	_ = shutdown(ctx)
+	os.Exit(code)
+}
+
+func startFixtureServer() (func(context.Context) error, string, error) {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Add("X-Fixture", "root-one")
+		w.Header().Add("X-Fixture", "root-two")
+		w.Header().Set("X-Method", r.Method)
+		w.WriteHeader(http.StatusOK)
+		fmt.Fprintf(w, "ROOT %s %s", r.Method, r.URL.Path)
+	})
+	mux.HandleFunc("/index", func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		w.Header().Add("X-Fixture", "index-one")
+		w.Header().Add("X-Fixture", "index-two")
+		w.Header().Set("X-Method", r.Method)
+		w.Header().Set("X-Path", r.URL.Path)
+		if r.Method == http.MethodPost {
+			w.Header().Set("X-Content-Type", r.Header.Get("Content-Type"))
+			fmt.Fprintf(w, "POST ACK path=%s type=%s body=%s", r.URL.Path, r.Header.Get("Content-Type"), string(body))
+			return
+		}
+		fmt.Fprintf(w, "%s RESPONSE path=%s", r.Method, r.URL.Path)
+	})
+	mux.HandleFunc("/deep/nested", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-Method", r.Method)
+		w.Header().Set("X-Path", r.URL.Path)
+		fmt.Fprintf(w, "%s DEEP %s", r.Method, r.URL.Path)
+	})
+	mux.HandleFunc("/not-found", func(w http.ResponseWriter, r *http.Request) {
+		http.Error(w, "missing", http.StatusTeapot)
+	})
+
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		return nil, "", err
+	}
+	srv := &http.Server{Handler: mux}
+	go func() {
+		if err := srv.Serve(ln); err != nil && err != http.ErrServerClosed {
+			panic(err)
+		}
+	}()
+	return srv.Shutdown, "http://" + ln.Addr().String(), nil
+}
+
+type runResult struct {
+	stdout string
+	stderr string
+	code   int
+}
+
+func runGoby(t *testing.T, source string) runResult {
+	t.Helper()
+	dir := t.TempDir()
+	return runGobyInDir(t, dir, source)
+}
+
+func runGobyInDir(t *testing.T, dir string, source string) runResult {
+	t.Helper()
+	path := filepath.Join(dir, "case.gb")
+	if err := os.WriteFile(path, []byte(source), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	cmd := exec.Command(gobyBinary, path)
+	cmd.Dir = dir
+	cmd.Env = append(os.Environ(), "GOBY_ROOT=/workspace/repo")
+	out, err := cmd.Output()
+	stderrBytes := []byte{}
+	if ee, ok := err.(*exec.ExitError); ok {
+		stderrBytes = ee.Stderr
+	}
+	code := 0
+	if err != nil {
+		code = 1
+		if ee, ok := err.(*exec.ExitError); ok {
+			code = ee.ExitCode()
+		}
+	}
+
+	return runResult{
+		stdout: strings.TrimRight(string(out), "\n"),
+		stderr: strings.TrimRight(string(stderrBytes), "\n"),
+		code:   code,
+	}
+}
+
+func gobyProgram(body string) string {
+	return "require \"net/http\"\n" + body
+}
+
+func assertSuccessOutput(t *testing.T, result runResult, expected string) {
+	t.Helper()
+	if result.code != 0 {
+		t.Fatalf("expected exit 0, got %d with stderr:\n%s", result.code, result.stderr)
+	}
+	if result.stdout != expected {
+		t.Fatalf("expected stdout %q, got %q", expected, result.stdout)
+	}
+	if result.stderr != "" {
+		t.Fatalf("expected empty stderr, got %q", result.stderr)
+	}
+}
+
+func assertFailureFirstLine(t *testing.T, result runResult, expected string) {
+	t.Helper()
+	if result.code == 0 {
+		t.Fatalf("expected non-zero exit with %q, got stdout %q", expected, result.stdout)
+	}
+	lines := strings.Split(result.stderr, "\n")
+	if lines[0] != expected {
+		t.Fatalf("expected first stderr line %q, got %q; full stderr:\n%s", expected, lines[0], result.stderr)
+	}
+}
+
+func assertFailureClass(t *testing.T, result runResult, className string) string {
+	t.Helper()
+	if result.code == 0 {
+		t.Fatalf("expected non-zero exit with %s, got stdout %q", className, result.stdout)
+	}
+	lines := strings.Split(result.stderr, "\n")
+	if !strings.HasPrefix(lines[0], className+":") {
+		t.Fatalf("expected first stderr line to start with %q, got %q; full stderr:\n%s", className+":", lines[0], result.stderr)
+	}
+	return lines[0]
+}
+
+func assertSuccessLines(t *testing.T, result runResult, count int) []string {
+	t.Helper()
+	if result.code != 0 {
+		t.Fatalf("expected exit 0, got %d with stderr:\n%s", result.code, result.stderr)
+	}
+	if result.stderr != "" {
+		t.Fatalf("expected empty stderr, got %q", result.stderr)
+	}
+	lines := strings.Split(result.stdout, "\n")
+	if len(lines) != count {
+		t.Fatalf("expected %d stdout lines, got %d: %q", count, len(lines), result.stdout)
+	}
+	return lines
+}
+
+func assertSpaceJoinedValues(t *testing.T, got string, expected ...string) {
+	t.Helper()
+	fields := strings.Fields(got)
+	if strings.Join(fields, " ") != got {
+		t.Fatalf("expected values to be joined with spaces, got %q", got)
+	}
+	if len(fields) != len(expected) {
+		t.Fatalf("expected %d joined values in %q, got %d", len(expected), got, len(fields))
+	}
+	seen := make(map[string]int, len(fields))
+	for _, value := range fields {
+		seen[value]++
+	}
+	for _, value := range expected {
+		if seen[value] == 0 {
+			t.Fatalf("expected joined values %q to include %q", got, value)
+		}
+		seen[value]--
+	}
+}
