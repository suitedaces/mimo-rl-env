+h = Net::HTTP.head("%s", "index")
+puts(h["X-Method"])
+puts(Net::HTTP.get("%s", "index"))
+`, serverBaseURL, serverBaseURL, serverBaseURL, serverBaseURL))
+
+	result := runGoby(t, source)
+	assertSuccessOutput(t, result, "GET RESPONSE path=/index\nPOST ACK path=/index type=text/plain body=Hi Again\nHEAD\nGET RESPONSE path=/index")
+}
