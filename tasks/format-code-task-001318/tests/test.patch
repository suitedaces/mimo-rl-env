+
+	lines := assertSuccessLines(t, result, 3)
+	assertSpaceJoinedValues(t, lines[0], "index-one", "index-two")
+	if lines[1] != "HEAD" || lines[2] != "/index" {
+		t.Fatalf("expected HEAD headers for /index, got %q", result.stdout)
