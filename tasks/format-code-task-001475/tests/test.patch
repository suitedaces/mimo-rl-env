diff --git a/test/toplevel.js b/test/toplevel.js
index 91f58e7..3250d86 100644
--- a/test/toplevel.js
+++ b/test/toplevel.js
@@ -58,3 +58,71 @@ function sortByKey (a, b) {
   var bKey = Buffer.isBuffer(b) ? b : b.key
   return aKey.toString('hex').localeCompare(bKey.toString('hex'))
 }
+
+var FIXTURE_KEY_HEX = 'f4d436e799f5466fa98eee04d52354e155bce62ba584393c2907a38b02d96a19'
+var FIXTURE_KEY_BUF = Buffer.from(FIXTURE_KEY_HEX, 'hex')
+var OTHER_KEY_HEX = 'a1b2c3d4e5f6071829304152637485969a7b8c5d4e3f2a1b0c0d0e0f10111213'
+var OTHER_KEY_BUF = Buffer.from(OTHER_KEY_HEX, 'hex')
+
+tape('createFeed: opts.key as matching hex string does not throw', function (t) {
+  var hc = hypercore()
+  var feed
+  t.doesNotThrow(function () {
+    feed = hc.createFeed(FIXTURE_KEY_BUF, { key: FIXTURE_KEY_HEX })
+  })
+  t.ok(feed && Buffer.isBuffer(feed.key), 'feed.key is a Buffer')
+  t.equal(feed && feed.key && feed.key.length, 32, 'feed.key is 32 bytes')
+  t.equal(feed && feed.key && feed.key.toString('hex'), FIXTURE_KEY_HEX, 'feed.key matches the requested key')
+  t.end()
+})
+
+tape('createFeed: first-arg buffer is not silently overridden by differing opts.key', function (t) {
+
+
+
+
+  var hc = hypercore()
+  var feed
+  var threw = false
+  try {
+    feed = hc.createFeed(FIXTURE_KEY_BUF, { key: OTHER_KEY_BUF })
+  } catch (e) {
+    threw = true
+  }
+  if (threw) {
+    t.pass('threw on conflicting key argument and opts.key (valid)')
+  } else {
+    t.ok(feed && Buffer.isBuffer(feed.key), 'feed.key is a Buffer')
+    t.equal(feed.key.toString('hex'), FIXTURE_KEY_HEX, 'first-argument key was used (opts.key did not silently override)')
+    t.notEqual(feed.key.toString('hex'), OTHER_KEY_HEX, 'opts.key was not silently used')
+  }
+  t.end()
+})
+
+tape('createFeed: opts.key as hex string is converted to Buffer when no first arg', function (t) {
+  var hc = hypercore()
+  var feed
+  t.doesNotThrow(function () {
+    feed = hc.createFeed({ key: FIXTURE_KEY_HEX })
+  })
+  t.ok(feed && Buffer.isBuffer(feed.key), 'feed.key is a Buffer')
+  t.equal(feed && feed.key && feed.key.length, 32, 'feed.key is 32 bytes')
+  t.equal(feed && feed.key && feed.key.toString('hex'), FIXTURE_KEY_HEX, 'feed.key matches the hex string')
+  t.end()
+})
+
+tape('createFeed: buffer key argument only', function (t) {
+  var hc = hypercore()
+  var feed = hc.createFeed(FIXTURE_KEY_BUF)
+  t.ok(Buffer.isBuffer(feed.key), 'feed.key is a Buffer')
+  t.equal(feed.key.toString('hex'), FIXTURE_KEY_HEX, 'feed.key equals argument')
+  t.end()
+})
+
+tape('createFeed: no args generates a 32-byte key', function (t) {
+  var hc = hypercore()
+  var feed = hc.createFeed()
+  t.ok(Buffer.isBuffer(feed.key), 'feed.key is a Buffer')
+  t.equal(feed.key.length, 32, 'feed.key is 32 bytes')
+  t.end()
+})
