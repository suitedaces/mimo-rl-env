+func TestTrackableDataTrie_SaveKeyValueRejectsOversizedValueAndDoesNotDirty(t *testing.T) {
+	t.Parallel()
+
+	identifier := []byte("identifier")
+	trie := &mock.TrieStub{}
+	tdaw := state.NewTrackableDataTrie(identifier, trie)
+	key := []byte("account-data-key")
+
+	require.NoError(t, tdaw.SaveKeyValue(key, []byte("small value")))
+	dirtyBeforeOversizedWrite := append([]byte(nil), tdaw.DirtyData()[string(key)]...)
+
+	err := tdaw.SaveKeyValue(key, oversizedAccountData(1))
+	errAgain := tdaw.SaveKeyValue([]byte("account-data-key-again"), oversizedAccountData(2))
+
+	require.Error(t, err)
+	require.Error(t, errAgain)
+	assert.True(t, errors.Is(errAgain, err) || errors.Is(err, errAgain))
+	assert.Equal(t, dirtyBeforeOversizedWrite, tdaw.DirtyData()[string(key)])
+}
+
+func TestTrackableDataTrie_SaveKeyValueRejectsDifferentOversizedInputs(t *testing.T) {
+	t.Parallel()
+
+	identifier := []byte("identifier")
+	trie := &mock.TrieStub{}
+	tdaw := state.NewTrackableDataTrie(identifier, trie)
+	key := []byte("another-account-data-key")
+
+	err := tdaw.SaveKeyValue(key, oversizedAccountData(3))
+
+	require.Error(t, err)
+	assert.NotContains(t, tdaw.DirtyData(), string(key))
+}
+
+func TestTrackableDataTrie_SaveKeyValueAcceptsValueAtLimit(t *testing.T) {
+	t.Parallel()
+
+	identifier := []byte("identifier")
+	trie := &mock.TrieStub{}
+	tdaw := state.NewTrackableDataTrie(identifier, trie)
+	key := []byte("limit-sized-value")
+	maxAcceptedSize := findLargestAcceptedSaveKeyValueSize(t, tdaw)
+	value := bytes.Repeat([]byte{7}, maxAcceptedSize)
+
+	err := tdaw.SaveKeyValue(key, value)
+
+	require.NoError(t, err)
+	savedValue, found := tdaw.DirtyData()[string(key)]
+	require.True(t, found)
+	assert.True(t, bytes.HasPrefix(savedValue, value))
+}
+
+func TestTrackableDataTrie_SaveKeyValueAcceptsNilAndEmptyValues(t *testing.T) {
+	t.Parallel()
+
+	identifier := []byte("identifier")
+	trie := &mock.TrieStub{}
+	tdaw := state.NewTrackableDataTrie(identifier, trie)
+
+	nilKey := []byte("nil-value")
+	err := tdaw.SaveKeyValue(nilKey, nil)
+	require.NoError(t, err)
+	nilSavedValue, found := tdaw.DirtyData()[string(nilKey)]
+	require.True(t, found)
+	assert.Empty(t, nilSavedValue)
+
+	emptyKey := []byte("empty-value")
+	err = tdaw.SaveKeyValue(emptyKey, []byte{})
+	require.NoError(t, err)
+	emptySavedValue, found := tdaw.DirtyData()[string(emptyKey)]
+	require.True(t, found)
+	assert.Empty(t, emptySavedValue)
+}
+
+func TestTrackableDataTrie_SaveKeyValueReturnsErrorInInterface(t *testing.T) {
