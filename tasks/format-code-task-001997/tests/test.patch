+const oversizedAccountDataSize = 4 * 1024 * 1024
+
+func oversizedAccountData(fill byte) []byte {
+	return bytes.Repeat([]byte{fill}, oversizedAccountDataSize)
+}
+
+func findLargestAcceptedSaveKeyValueSize(t *testing.T, tracker state.DataTrieTracker) int {
+	t.Helper()
+
+	probeKey := []byte("limit-probe")
+	require.Error(t, tracker.SaveKeyValue(probeKey, make([]byte, oversizedAccountDataSize)))
+
+	low := 0
+	high := oversizedAccountDataSize
+	for low < high {
+		mid := low + (high-low+1)/2
+		err := tracker.SaveKeyValue(probeKey, make([]byte, mid))
+		if err == nil {
+			low = mid
+			continue
+		}
+		high = mid - 1
+	}
+
+	require.Greater(t, low, 0)
+	return low
+}
