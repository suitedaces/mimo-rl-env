+func TestSaveKeyValueStorage_ProcessBuiltinFunctionShouldSurfaceOversizedValueError(t *testing.T) {
+	t.Parallel()
+
+	funcGasCost := uint64(1)
+	gasConfig := BaseOperationCost{
+		StorePerByte:    1,
+		ReleasePerByte:  1,
+		DataCopyPerByte: 1,
+		PersistPerByte:  1,
+		CompilePerByte:  1,
+	}
+	skv, err := NewSaveKeyValueStorageFunc(gasConfig, funcGasCost)
+	require.NoError(t, err)
+
+	addr := []byte("addr")
+	acc, err := state.NewUserAccount(addr)
+	require.NoError(t, err)
+	key := []byte("oversized-storage-key")
+	value := oversizedAccountData(1)
+	leafSizeErr := acc.DataTrieTracker().SaveKeyValue([]byte("leaf-size-probe"), value)
+	require.Error(t, leafSizeErr)
+	vmInput := &vmcommon.ContractCallInput{
+		VMInput: vmcommon.VMInput{
+			CallerAddr:  addr,
+			GasProvided: uint64(len(value) * 3),
+			CallValue:   big.NewInt(0),
+		},
+		RecipientAddr: addr,
+	}
+	vmInput.Arguments = [][]byte{key, value}
+
+	vmOutput, err := skv.ProcessBuiltinFunction(nil, acc, vmInput)
+
+	require.Error(t, err)
+	assert.True(t, errors.Is(err, leafSizeErr) || errors.Is(leafSizeErr, err))
+	assert.Nil(t, vmOutput)
+	assert.NotContains(t, acc.DataTrieTracker().DirtyData(), string(key))
+}
