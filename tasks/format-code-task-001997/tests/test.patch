diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+export ARWEN_PATH=/usr/local/bin/arwen
+
+case "${1:-}" in
+  base)
+    go test -count=1 -timeout 600s \
+      ./data/state \
+      ./process/smartContract/builtInFunctions
+    ;;
+  new)
+    go test -count=1 -timeout 600s ./data/state -run 'TestTrackableDataTrie_(RetrieveValueShouldCheckDirtyDataFirst|SaveKeyValueShouldSaveOnlyInDirty|ClearDataCachesValidDataShouldWork|SaveKeyValueRejectsOversizedValueAndDoesNotDirty|SaveKeyValueRejectsDifferentOversizedInputs|SaveKeyValueAcceptsValueAtLimit|SaveKeyValueAcceptsNilAndEmptyValues|SaveKeyValueReturnsErrorInInterface)$'
+    state_exit=$?
+    go test -count=1 -timeout 600s ./process/smartContract/builtInFunctions -run 'TestSaveKeyValueStorage_ProcessBuiltinFunctionShouldSurfaceOversizedValueError$'
+    builtin_exit=$?
+    go test -count=1 -timeout 600s ./process/smartContract -run 'TestScProcessor_processSCOutputAccountsShouldSurfaceOversizedStorageUpdateError$'
+    sc_process_exit=$?
+    if [ "$state_exit" -ne 0 ]; then
+      exit "$state_exit"
+    fi
+    if [ "$builtin_exit" -ne 0 ]; then
+      exit "$builtin_exit"
+    fi
+    exit "$sc_process_exit"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
