diff --git a/tests/properties/dsl-test.js b/tests/properties/dsl-test.js
index 3963a82..f47e7b3 100644
--- a/tests/properties/dsl-test.js
+++ b/tests/properties/dsl-test.js
@@ -1,5 +1,5 @@
 import { moduleForProperty } from '../helpers/properties';
-import { create } from 'ember-cli-page-object';
+import { create, collection, text } from 'ember-cli-page-object';
 
 moduleForProperty('dsl', function(test) {
   test('generates .isVisible', function(assert) {
@@ -172,4 +172,85 @@ moduleForProperty('dsl', function(test) {
     assert.ok(typeof (page.then) === 'function');
     assert.ok(typeof (page.foo.then) === 'function');
   });
+
+  test('generates .as', function(assert) {
+    let page = create({
+      foo: {}
+    });
+
+    this.adapter.createTemplate(this, page);
+
+    assert.ok(typeof (page.as) === 'function', 'page.as is a function');
+    assert.ok(typeof (page.foo.as) === 'function', 'page.foo.as is a function');
+  });
+
+  test('.as invokes callback with the node as argument', function(assert) {
+    assert.expect(3);
+
+    let page = create({
+      foo: {}
+    });
+
+    this.adapter.createTemplate(this, page);
+
+    let calledWith;
+    let callCount = 0;
+    page.as((node) => {
+      callCount++;
+      calledWith = node;
+    });
+
+    assert.equal(callCount, 1, 'callback invoked exactly once');
+    assert.strictEqual(calledWith, page, 'callback received the page as argument');
+
+    let nestedCalledWith;
+    page.foo.as((node) => {
+      nestedCalledWith = node;
+    });
+    assert.strictEqual(nestedCalledWith, page.foo, 'nested .as callback received the nested node');
+  });
+
+  test('.as returns the node for chaining', function(assert) {
+    let page = create({
+      foo: {}
+    });
+
+    this.adapter.createTemplate(this, page);
+
+    let result = page.as(() => {});
+    assert.strictEqual(result, page, 'page.as returns the page');
+
+    let nestedResult = page.foo.as(() => {});
+    assert.strictEqual(nestedResult, page.foo, 'nested .as returns the nested node');
+  });
+
+  test('.as works on collection items and exposes item properties', function(assert) {
+    assert.expect(4);
+
+    let page = create({
+      users: collection({
+        itemScope: 'span',
+
+        item: {
+          name: text()
+        }
+      })
+    });
+
+    this.adapter.createTemplate(this, page, `
+      <span>Lorem</span>
+      <span>Ipsum</span>
+    `);
+
+    page.users(0).as((user) => {
+      assert.equal(user.name, 'Lorem', 'first user name read from inside .as callback');
+    });
+
+    page.users(1).as((user) => {
+      assert.equal(user.name, 'Ipsum', 'second user name read from inside .as callback');
+    });
+
+    assert.ok(typeof (page.users(0).as) === 'function', 'collection item has .as');
+    assert.ok(typeof (page.users().as) === 'function', 'collection container has .as');
+  });
 });
