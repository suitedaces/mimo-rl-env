diff --git a/nilearn/glm/tests/test_stat_type_deprecation.py b/nilearn/glm/tests/test_stat_type_deprecation.py
new file mode 100644
index 000000000..fbe5cf39c
--- /dev/null
+++ b/nilearn/glm/tests/test_stat_type_deprecation.py
@@ -0,0 +1,133 @@
+
+
+
+
+
+
+
+
+
+import warnings
+
+import numpy as np
+import pytest
+from numpy.testing import assert_almost_equal
+
+from nilearn.glm.contrasts import Contrast, compute_contrast
+from nilearn.glm.first_level import run_glm
+
+
+@pytest.fixture
+def _glm_setup(rng):
+    n, p, q = 100, 80, 10
+    X = rng.standard_normal(size=(p, q))
+    Y = rng.standard_normal(size=(p, n))
+    labels, results = run_glm(Y, X, "ar1")
+    con_val = np.eye(q)[:3]
+    return labels, results, con_val
+
+
+
+
+
+
+
+def test_compute_contrast_stat_type_kwarg_works(_glm_setup):
+
+
+    labels, results, con_val = _glm_setup
+    con = compute_contrast(labels, results, con_val, stat_type="F")
+
+    z = con.z_score()
+    assert z is not None
+
+
+def test_compute_contrast_contrast_type_kwarg_deprecation_warning(_glm_setup):
+
+
+    labels, results, con_val = _glm_setup
+    with pytest.warns(DeprecationWarning):
+        compute_contrast(labels, results, con_val, contrast_type="F")
+
+
+def test_compute_contrast_old_and_new_kwarg_equivalent(_glm_setup):
+
+
+    labels, results, con_val = _glm_setup
+    new_con = compute_contrast(labels, results, con_val, stat_type="F")
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", DeprecationWarning)
+        old_con = compute_contrast(labels, results, con_val, contrast_type="F")
+    assert_almost_equal(new_con.effect, old_con.effect)
+    assert_almost_equal(new_con.variance, old_con.variance)
+
+
+
+
+
+
+
+def test_Contrast_stat_type_kwarg_works():
+
+    effect = np.ones((1, 3))
+    variance = np.ones(3)
+    c = Contrast(effect, variance, stat_type="t")
+
+
+
+
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", DeprecationWarning)
+        kind = getattr(c, "stat_type", None) or getattr(
+            c, "contrast_type", None
+        )
+    assert kind == "t"
+
+
+def test_Contrast_stat_type_kwarg_no_deprecation():
+
+
+    effect = np.ones((1, 3))
+    variance = np.ones(3)
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always")
+        Contrast(effect, variance, stat_type="t")
+    contrast_type_deprecations = [
+        w for w in caught
+        if issubclass(w.category, DeprecationWarning)
+        and "contrast_type" in str(w.message)
+    ]
+    assert contrast_type_deprecations == []
+
+
+def test_Contrast_contrast_type_kwarg_deprecation_warning():
+
+
+    effect = np.ones((1, 3))
+    variance = np.ones(3)
+    with pytest.warns(DeprecationWarning):
+        Contrast(effect, variance, contrast_type="t")
+
+
+def test_Contrast_old_and_new_kwarg_equivalent():
+
+
+    effect = np.ones((1, 3))
+    variance = np.ones(3)
+    new_c = Contrast(effect.copy(), variance.copy(), stat_type="t")
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", DeprecationWarning)
+        old_c = Contrast(effect.copy(), variance.copy(), contrast_type="t")
+    assert_almost_equal(new_c.effect, old_c.effect)
+    assert_almost_equal(new_c.variance, old_c.variance)
+
+
+
+
+    new_kind = getattr(new_c, "stat_type", None) or getattr(
+        new_c, "contrast_type", None
+    )
+    old_kind = getattr(old_c, "stat_type", None) or getattr(
+        old_c, "contrast_type", None
+    )
+    assert new_kind == old_kind == "t"
