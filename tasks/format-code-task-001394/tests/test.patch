+    make_channel_filter(
+        arc,
+        is_default=True,
+        notify_in_slack=False,
+        notification_backends={"MSTEAMS": {"channel": "test", "enabled": True}},
+    )
+    make_channel_filter(arc, is_default=False)
+    make_channel_filter(arc, is_default=False)
+
+    results = list(org.get_notifiable_direct_paging_integrations())
+
+    assert arc in results
+    assert len(results) < 3
+    assert results.count(arc) < 3
