+@pytest.mark.django_db
+def test_get_notifiable_direct_paging_integrations_no_duplicates_two_routes_escalation(
+    make_organization,
+    make_alert_receive_channel,
+    make_channel_filter,
+    make_escalation_chain,
+):
+    """
+    Regression test for:
+    /escalate Slack Dropdown Duplicates Teams for Each Route in Direct Paging.
+
+    Minimal reproduction: a Direct Paging integration with 2 routes (1 default
+    wired to an escalation chain + 1 non-default) must appear exactly once,
+    not once per route.
+    """
+    org = make_organization()
+    arc = make_alert_receive_channel(org, integration=AlertReceiveChannel.INTEGRATION_DIRECT_PAGING)
+    escalation_chain = make_escalation_chain(org)
+    make_channel_filter(arc, is_default=True, notify_in_slack=False, escalation_chain=escalation_chain)
+    make_channel_filter(arc, is_default=False)
+
+    results = list(org.get_notifiable_direct_paging_integrations())
+
+    assert arc in results
+    assert results.count(arc) == 1
+    assert len(results) == 1
+
+
+@pytest.mark.django_db
+def test_get_notifiable_direct_paging_integrations_no_duplicates_two_routes_notification_backend(
+    make_organization,
+    make_alert_receive_channel,
+    make_channel_filter,
+):
+    """
+    Direct Paging integration whose default route uses a custom messaging
+    backend, plus one extra non-default route, must appear exactly once.
+    """
+    org = make_organization()
+    arc = make_alert_receive_channel(org, integration=AlertReceiveChannel.INTEGRATION_DIRECT_PAGING)
+    make_channel_filter(
+        arc,
+        is_default=True,
+        notify_in_slack=False,
+        notification_backends={"MSTEAMS": {"channel": "test", "enabled": True}},
+    )
+    make_channel_filter(arc, is_default=False)
+
+    results = list(org.get_notifiable_direct_paging_integrations())
+
+    assert arc in results
+    assert results.count(arc) == 1
+    assert len(results) == 1
+
+
+@pytest.mark.django_db
+def test_get_notifiable_direct_paging_integrations_three_routes_no_full_duplication(
+    make_organization,
+    make_alert_receive_channel,
+    make_channel_filter,
+    make_escalation_chain,
+):
+    """
+    Issue reproduction: integration with 3 routes (1 default + 2 non-default)
+    must NOT appear 3 times in the queryset. The user-visible bug was that the
+    same team was shown once per route in the Slack /escalate dropdown.
+    """
+    org = make_organization()
+    arc = make_alert_receive_channel(org, integration=AlertReceiveChannel.INTEGRATION_DIRECT_PAGING)
+    escalation_chain = make_escalation_chain(org)
+    make_channel_filter(arc, is_default=True, notify_in_slack=False, escalation_chain=escalation_chain)
+    make_channel_filter(arc, is_default=False)
+    make_channel_filter(arc, is_default=False)
+
+    results = list(org.get_notifiable_direct_paging_integrations())
+
+
+    assert arc in results
+    assert len(results) < 3
+    assert results.count(arc) < 3
+
+
+@pytest.mark.django_db
+def test_get_notifiable_direct_paging_integrations_five_routes_no_full_duplication(
+    make_organization,
+    make_alert_receive_channel,
+    make_channel_filter,
+    make_escalation_chain,
+):
+    """
+    Integration with many routes (5: 1 default + 4 non-default) must NOT appear
+    once per route. (Per the bug report, BASE happens to cap at 3 entries
+    irrespective of route count, so a strict `<3` upper bound here catches the
+    duplicate-team behavior.)
+    """
+    org = make_organization()
+    arc = make_alert_receive_channel(org, integration=AlertReceiveChannel.INTEGRATION_DIRECT_PAGING)
+    escalation_chain = make_escalation_chain(org)
+    make_channel_filter(arc, is_default=True, notify_in_slack=False, escalation_chain=escalation_chain)
+    for _ in range(4):
+        make_channel_filter(arc, is_default=False)
+
+    results = list(org.get_notifiable_direct_paging_integrations())
+
+    assert arc in results
+    assert len(results) < 3
+    assert results.count(arc) < 3
+
+
