diff --git a/packages/protocol/test-sol/utils/UtilsHelpers.t.sol b/packages/protocol/test-sol/utils/UtilsHelpers.t.sol
new file mode 100644
index 00000000000..1c1b0b0b0b0
--- /dev/null
+++ b/packages/protocol/test-sol/utils/UtilsHelpers.t.sol
@@ -0,0 +1,116 @@
+
+pragma solidity ^0.5.13;
+
+import { Constants } from "../constants.sol";
+import { Utils } from "../utils.sol";
+
+contract ConstantsHarness is Constants {}
+
+contract UtilsHelpersTest is Utils {
+  ConstantsHarness private constants;
+
+  function setUp() public {
+    constants = new ConstantsHarness();
+  }
+
+  function testConstantsExposeDurationsExternally() public {
+    assertEq(constants.DAY(), 24 * 60 * 60);
+    assertEq(constants.WEEK(), 7 * constants.DAY());
+    assertEq(constants.YEAR(), 365 * constants.DAY());
+  }
+
+  function testAssertAlmostEqualPassesWithinMargin() public {
+    assertAlmostEqual(100, 105, 5);
+    assertAlmostEqual(105, 100, 5);
+    assertAlmostEqual(100, 100, 0);
+  }
+
+  function testAssertAlmostEqualFailsOutsideMarginWithDifferenceMessage() public {
+    assertAlmostEqual(100, 106, 5);
+  }
+
+  function testAssertAlmostEqualHandlesReverseDifference() public {
+    assertAlmostEqual(106, 100, 5);
+  }
+
+  function testArraysEqualReturnsTrueForSameSetDifferentOrder() public {
+    address[] memory arr1 = new address[](3);
+    address[] memory arr2 = new address[](3);
+    arr1[0] = address(uint160(0x1111));
+    arr1[1] = address(uint160(0xBEEF));
+    arr1[2] = address(uint160(0xCAFE));
+    arr2[0] = address(uint160(0xCAFE));
+    arr2[1] = address(uint160(0x1111));
+    arr2[2] = address(uint160(0xBEEF));
+    assertTrue(arraysEqual(arr1, arr2));
+  }
+
+  function testArraysEqualReturnsFalseForDifferentLengths() public {
+    address[] memory arr1 = new address[](2);
+    address[] memory arr2 = new address[](3);
+    arr1[0] = address(uint160(0x1234));
+    arr1[1] = address(uint160(0x5678));
+    arr2[0] = address(uint160(0x1234));
+    arr2[1] = address(uint160(0x5678));
+    arr2[2] = address(uint160(0x9ABC));
+    assertTrue(!arraysEqual(arr1, arr2));
+  }
+
+  function testArraysEqualReturnsFalseForSameLengthDifferentSet() public {
+    address[] memory arr1 = new address[](3);
+    address[] memory arr2 = new address[](3);
+    arr1[0] = address(uint160(0x1234));
+    arr1[1] = address(uint160(0x5678));
+    arr1[2] = address(uint160(0x9ABC));
+    arr2[0] = address(uint160(0x1234));
+    arr2[1] = address(uint160(0x5678));
+    arr2[2] = address(uint160(0xDEF0));
+    assertTrue(!arraysEqual(arr1, arr2));
+  }
+
+  function testArraysEqualDoesNotLeakStateAcrossCalls() public {
+    address[] memory firstA = new address[](2);
+    address[] memory firstB = new address[](2);
+    address[] memory secondA = new address[](2);
+    address[] memory secondB = new address[](2);
+    firstA[0] = address(uint160(0xAAAA));
+    firstA[1] = address(uint160(0xCCCC));
+    firstB[0] = address(uint160(0xCCCC));
+    firstB[1] = address(uint160(0xAAAA));
+    secondA[0] = address(uint160(0xAAAA));
+    secondA[1] = address(uint160(0xBBBB));
+    secondB[0] = address(uint160(0xAAAA));
+    secondB[1] = address(uint160(0xCCCC));
+    assertTrue(arraysEqual(firstA, firstB));
+    assertTrue(!arraysEqual(secondA, secondB));
+  }
+
+  function testGeneratePRNReturnsWithinInclusiveRangeForDifferentRanges() public {
+    uint256 small = generatePRN(1, 10, 123);
+    assertTrue(small >= 1 && small <= 10);
+    uint256 medium = generatePRN(50, 75, 456);
+    assertTrue(medium >= 50 && medium <= 75);
+    uint256 wide = generatePRN(1000, 1000000, 789);
+    assertTrue(wide >= 1000 && wide <= 1000000);
+  }
+
+  function testGeneratePRNAllowsDegenerateRange() public {
+    assertEq(generatePRN(42, 42, 999), 42);
+  }
+
+  function testGeneratePRNVariesAcrossSaltsForNonDegenerateRange() public {
+    uint256 min = 1000;
+    uint256 max = 1000000;
+    uint256 first = generatePRN(min, max, 1);
+    assertTrue(first >= min && first <= max);
+    bool sawDifferent = false;
+    for (uint256 salt = 2; salt <= 12; salt++) {
+      uint256 next = generatePRN(min, max, salt);
+      assertTrue(next >= min && next <= max);
+      if (next != first) {
+        sawDifferent = true;
+      }
+    }
+    assertTrue(sawDifferent);
+  }
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,53 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+git submodule update --init --recursive || exit $?
+
+
+cd packages/protocol
+
+case "${1:-}" in
+  base)
+    forge test --match-path test-sol/voting/Election.t.sol --optimize --optimizer-runs 200 -vv || exit $?
+    ;;
+  new)
+    forge test \
+      --match-path test-sol/utils/UtilsHelpers.t.sol \
+      --no-match-test 'testAssertAlmostEqual(FailsOutsideMarginWithDifferenceMessage|HandlesReverseDifference)' \
+      --optimize \
+      --optimizer-runs 200 \
+      -vv || exit $?
+
+    for test_name in \
+      testAssertAlmostEqualFailsOutsideMarginWithDifferenceMessage \
+      testAssertAlmostEqualHandlesReverseDifference
+    do
+      out_file="$(mktemp)"
+      forge test \
+        --match-path test-sol/utils/UtilsHelpers.t.sol \
+        --match-test "${test_name}" \
+        --optimize \
+        --optimizer-runs 200 \
+        -vv >"${out_file}" 2>&1
+      status=$?
+      cat "${out_file}"
+      if [ "${status}" -eq 0 ]; then
+        echo "expected ${test_name} to fail outside the allowed margin"
+        rm -f "${out_file}"
+        exit 1
+      fi
+      if ! grep -Eq 'Difference is[[:space:]]+6' "${out_file}"; then
+        echo "expected ${test_name} output to report the absolute difference"
+        rm -f "${out_file}"
+        exit 1
+      fi
+      rm -f "${out_file}"
+    done
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
