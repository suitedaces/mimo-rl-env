diff --git a/tests/modules/test_tautulli.py b/tests/modules/test_tautulli.py
index cca6615..2e9dbf6 100644
--- a/tests/modules/test_tautulli.py
+++ b/tests/modules/test_tautulli.py
@@ -134,3 +134,73 @@ def test_get_activity(
     mock_prepare_activity_entry.assert_called_once_with(
         {"rating_key": "123", "stopped": "2022-01-02"}, {"guid": "guid"}
     )
+
+
+@patch("app.config.Config", Mock())
+@patch("app.modules.tautulli.RawAPI", Mock())
+def test_calculate_min_date_both_thresholds_missing():
+    """Issue repro: empty library_config must not raise TypeError.
+
+    Reference behavior: missing keys default to 0 days, so result is ~now.
+    """
+    with patch("tautulli.RawAPI", Mock()):
+        tautulli = Tautulli("url", "api_key")
+        before = datetime.now()
+        result = tautulli._calculate_min_date({})
+        after = datetime.now()
+
+
+    assert isinstance(result, datetime)
+    assert result >= before - timedelta(seconds=5)
+    assert result <= after + timedelta(seconds=5)
+
+
+@patch("app.config.Config", Mock())
+@patch("app.modules.tautulli.RawAPI", Mock())
+def test_calculate_min_date_only_last_watched_threshold_present():
+    """When added_at_threshold is missing, last_watched_threshold drives the result.
+
+    Reference treats missing key as 0 days, so min(now - 30d, now) == now - 30d.
+    """
+    with patch("tautulli.RawAPI", Mock()):
+        tautulli = Tautulli("url", "api_key")
+        expected = datetime.now() - timedelta(days=30)
+        result = tautulli._calculate_min_date({"last_watched_threshold": 30})
+
+    assert isinstance(result, datetime)
+    assert result.date() == expected.date()
+
+
+@patch("app.config.Config", Mock())
+@patch("app.modules.tautulli.RawAPI", Mock())
+def test_calculate_min_date_only_added_at_threshold_present():
+    """When last_watched_threshold is missing, added_at_threshold drives the result.
+
+    Reference treats missing key as 0 days, so min(now, now - 45d) == now - 45d.
+    """
+    with patch("tautulli.RawAPI", Mock()):
+        tautulli = Tautulli("url", "api_key")
+        expected = datetime.now() - timedelta(days=45)
+        result = tautulli._calculate_min_date({"added_at_threshold": 45})
+
+    assert isinstance(result, datetime)
+    assert result.date() == expected.date()
+
+
+@patch("app.config.Config", Mock())
+@patch("app.modules.tautulli.RawAPI", Mock())
+def test_calculate_min_date_both_thresholds_missing_returns_recent_datetime():
+    """Stricter: empty config must NOT return datetime.min, None, or raise.
+
+    Discriminates candidates returning datetime.min / None / raising ValueError.
+    """
+    with patch("tautulli.RawAPI", Mock()):
+        tautulli = Tautulli("url", "api_key")
+        result = tautulli._calculate_min_date({})
+
+
+    assert isinstance(result, datetime)
+
+    assert result != datetime.min
+
+    assert result > datetime.now() - timedelta(days=1)
