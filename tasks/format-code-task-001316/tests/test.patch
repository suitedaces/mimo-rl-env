diff --git a/usercase-test-coderl/brace_alternatives_test.go b/usercase-test-coderl/brace_alternatives_test.go
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/brace_alternatives_test.go
@@ -0,0 +1,233 @@
+package usercase_test_coderl
+
+import (
+	"reflect"
+	"testing"
+
+	glob "github.com/gobwas/glob"
+)
+
+func mustCompile(t *testing.T, pattern string, separators ...rune) glob.Glob {
+	t.Helper()
+	g, err := glob.Compile(pattern, separators...)
+	if err != nil {
+		t.Fatalf("Compile(%q, %q) returned unexpected error: %v", pattern, string(separators), err)
+	}
+	return g
+}
+
+func matchTable(g glob.Glob, inputs []string) map[string]bool {
+	actual := make(map[string]bool, len(inputs))
+	for _, input := range inputs {
+		actual[input] = g.Match(input)
+	}
+	return actual
+}
+
+func TestStandaloneBraceAlternativesMatchWholeInput(t *testing.T) {
+
+
+	g := mustCompile(t, "{cat,dog}")
+
+	actual := matchTable(g, []string{"cat", "dog", "cow", "catdog", ""})
+	expected := map[string]bool{
+		"cat":    true,
+		"dog":    true,
+		"cow":    false,
+		"catdog": false,
+		"":       false,
+	}
+
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("Match table for {cat,dog} = %#v; want %#v", actual, expected)
+	}
+}
+
+func TestEmptyAlternativeComposesAfterPrefix(t *testing.T) {
+
+
+	g := mustCompile(t, "file{,.bak}")
+
+	actual := matchTable(g, []string{"file", "file.bak", "file.tmp", "file.bak.tmp", ""})
+	expected := map[string]bool{
+		"file":         true,
+		"file.bak":     true,
+		"file.tmp":     false,
+		"file.bak.tmp": false,
+		"":             false,
+	}
+
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("Match table for file{,.bak} = %#v; want %#v", actual, expected)
+	}
+}
+
+func TestAlternativesComposeBeforeSuffix(t *testing.T) {
+
+
+	g := mustCompile(t, "{api,web}.example.com")
+
+	actual := matchTable(g, []string{"api.example.com", "web.example.com", "db.example.com", "api.example.com.au", ""})
+	expected := map[string]bool{
+		"api.example.com":    true,
+		"web.example.com":    true,
+		"db.example.com":     false,
+		"api.example.com.au": false,
+		"":                   false,
+	}
+
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("Match table for {api,web}.example.com = %#v; want %#v", actual, expected)
+	}
+}
+
+func TestRepeatedBraceAlternativesComposeAcrossPattern(t *testing.T) {
+
+
+	g := mustCompile(t, "{a,ab}{bc,f}")
+
+	actual := matchTable(g, []string{"abc", "af", "abbc", "abf", "a", "bc", ""})
+	expected := map[string]bool{
+		"abc":  true,
+		"af":   true,
+		"abbc": true,
+		"abf":  true,
+		"a":    false,
+		"bc":   false,
+		"":     false,
+	}
+
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("Match table for {a,ab}{bc,f} = %#v; want %#v", actual, expected)
+	}
+}
+
+func TestAlternativesContainGlobSyntaxBranches(t *testing.T) {
+
+
+	g := mustCompile(t, "{abc?def,abc[zte]def}")
+
+	actual := matchTable(g, []string{"abcqdef", "abczdef", "abczzdef", "abc1deg", ""})
+	expected := map[string]bool{
+		"abcqdef":  true,
+		"abczdef":  true,
+		"abczzdef": false,
+		"abc1deg":  false,
+		"":         false,
+	}
+
+
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("Match table for glob-syntax alternatives = %#v; want %#v", actual, expected)
+	}
+}
+
+func TestAlternativesCanAppearAfterPrefixAndBeforeSuffix(t *testing.T) {
+
+
+	g := mustCompile(t, "svc-{api,web}-v1")
+
+	actual := matchTable(g, []string{"svc-api-v1", "svc-web-v1", "svc-db-v1", "api", ""})
+	expected := map[string]bool{
+		"svc-api-v1": true,
+		"svc-web-v1": true,
+		"svc-db-v1":  false,
+		"api":        false,
+		"":           false,
+	}
+
+
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("Match table for middle-position alternatives = %#v; want %#v", actual, expected)
+	}
+}
+
+func TestSeparatorAwareWildcardAlternatives(t *testing.T) {
+
+
+	g := mustCompile(t, "{*.google.*,*.yandex.*}", '.')
+
+	actual := matchTable(g, []string{"www.google.com", "www.yandex.com", "yandex.com", "google.com", "mail.google.com", ""})
+	expected := map[string]bool{
+		"www.google.com":  true,
+		"www.yandex.com":  true,
+		"yandex.com":      false,
+		"google.com":      false,
+		"mail.google.com": true,
+		"":                false,
+	}
+
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("Match table for separator-aware alternatives = %#v; want %#v", actual, expected)
+	}
+}
+
+func TestCompileAcceptsSpecBraceExamples(t *testing.T) {
+	for _, pattern := range []string{"{cat,dog}", "file{,.bak}", "{api,web}.example.com"} {
+
+		if _, err := glob.Compile(pattern); err != nil {
+			t.Fatalf("Compile(%q) returned unexpected error: %v", pattern, err)
+		}
+	}
+}
+
+func TestMatchReferentialTransparency(t *testing.T) {
+	g := mustCompile(t, "{api,web}.example.com")
+
+	first := g.Match("api.example.com")
+	second := g.Match("api.example.com")
+
+	if first != true || second != true {
+		t.Fatalf("two Match calls for api.example.com = %v, %v; want true, true", first, second)
+	}
+}
+
+func TestCompileAndMatchDoNotMutateCallerInputs(t *testing.T) {
+	input := "api.example.com"
+	originalInput := input
+
+	g := mustCompile(t, "{api,web}.example.com")
+	first := g.Match(input)
+	second := g.Match(input)
+
+
+	if input != originalInput {
+		t.Fatalf("input string mutated to %q; want %q", input, originalInput)
+	}
+	if first != true || second != true {
+		t.Fatalf("two Match calls for %q = %v, %v; want true, true", input, first, second)
+	}
+}
+
+func TestMatchNoGlobalStateAfterNoiseCalls(t *testing.T) {
+	g := mustCompile(t, "{cat,dog}")
+
+	baseline := g.Match("cat")
+	noiseDog := g.Match("dog")
+	noiseCow := g.Match("cow")
+	afterNoise := g.Match("cat")
+
+	if baseline != true {
+		t.Fatalf("baseline Match(\"cat\") = %v; want true", baseline)
+	}
+	if noiseDog != true {
+		t.Fatalf("noise Match(\"dog\") = %v; want true", noiseDog)
+	}
+	if noiseCow != false {
+		t.Fatalf("noise Match(\"cow\") = %v; want false", noiseCow)
+	}
+	if afterNoise != true {
+		t.Fatalf("Match(\"cat\") after noise = %v; want true", afterNoise)
+	}
+}
+
+func TestRepeatedMatchIsStableForEmptyAlternative(t *testing.T) {
+	g := mustCompile(t, "file{,.bak}")
+	first := g.Match("file.bak")
+	second := g.Match("file.bak")
+
+
+	if first != true || second != true {
+		t.Fatalf("two Match calls for file.bak = %v, %v; want true, true", first, second)
+	}
+}
