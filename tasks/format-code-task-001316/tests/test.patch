@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+repo=/workspace/repo
+gopath=/tmp/fixture-gopath
+
+mkdir -p "$gopath/src/github.com/gobwas"
+ln -sfn "$repo" "$gopath/src/github.com/gobwas/glob"
+
+cd "$gopath/src/github.com/gobwas/glob"
+GO111MODULE=off GOPATH="$gopath" GOPROXY=off GOSUMDB=off GOVCS='*:off' exec go test -v ./usercase-test-coderl/...
