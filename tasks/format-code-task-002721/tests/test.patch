diff --git a/test/dialects/tsql_partition_ddl_test.py b/test/dialects/tsql_partition_ddl_test.py
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/test/dialects/tsql_partition_ddl_test.py
@@ -0,0 +1,65 @@
+
+
+from sqlfluff.core import Linter
+
+
+def _parse_tsql(sql: str):
+    parsed = Linter(dialect="tsql").parse_string(sql)
+    assert parsed.tree is not None
+    return parsed.tree
+
+
+def _assert_parses_as(sql: str, statement_type: str):
+    tree = _parse_tsql(sql)
+    unparsables = list(tree.recursive_crawl("unparsable"))
+    assert not unparsables, f"Unexpected unparsable segments: {unparsables!r}"
+    matches = list(tree.recursive_crawl(statement_type))
+    assert matches, f"Expected {statement_type} in parse tree"
+
+
+def test_parse_tsql_create_partition_function_variants():
+    _assert_parses_as(
+        "CREATE PARTITION FUNCTION pf_sales_amount (BIGINT) "
+        "AS RANGE LEFT FOR VALUES (100, 1000, 10000);",
+        "create_partition_function_statement",
+    )
+    _assert_parses_as(
+        "CREATE PARTITION FUNCTION [pf_order_dates] (date) "
+        "AS RANGE RIGHT FOR VALUES ('20240101', '20240201');",
+        "create_partition_function_statement",
+    )
+
+
+def test_parse_tsql_alter_partition_function_split_and_merge():
+    _assert_parses_as(
+        "ALTER PARTITION FUNCTION pf_sales_amount() SPLIT RANGE (5000);",
+        "alter_partition_function_statement",
+    )
+    _assert_parses_as(
+        "ALTER PARTITION FUNCTION [pf_order_dates]() MERGE RANGE ('20240301');",
+        "alter_partition_function_statement",
+    )
+
+
+def test_parse_tsql_create_partition_scheme_variants():
+    _assert_parses_as(
+        "CREATE PARTITION SCHEME ps_sales AS PARTITION pf_sales_amount "
+        "TO (fg_sales_1, [fg_sales_2]);",
+        "create_partition_scheme_statement",
+    )
+    _assert_parses_as(
+        "CREATE PARTITION SCHEME [ps_archive] AS PARTITION pf_order_dates "
+        "ALL TO ([PRIMARY]);",
+        "create_partition_scheme_statement",
+    )
+
+
+def test_parse_tsql_alter_partition_scheme_next_used_optional_target():
+    _assert_parses_as(
+        "ALTER PARTITION SCHEME ps_sales NEXT USED fg_sales_next;",
+        "alter_partition_scheme_statement",
+    )
+    _assert_parses_as(
+        "ALTER PARTITION SCHEME [ps_archive] NEXT USED;",
+        "alter_partition_scheme_statement",
+    )
