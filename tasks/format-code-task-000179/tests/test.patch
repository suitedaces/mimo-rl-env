@@ -0,0 +1,44 @@
+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+
+set +u
+source /opt/odoo-venv/bin/activate
+set -u
+
+pg_ctlcluster 16 main start 2>/dev/null || true
+
+
+ADDONS_PATH="/opt/odoo-venv/src/odoo/addons,/opt/odoo-venv/src/odoo/odoo/addons,/testbed"
+MODULE="sale_order_carrier_auto_assign"
+CLASS="TestSaleOrderCarrierAutoAssign"
+
+run_odoo_tests() {
+    local db_name="$1"
+    local tags="$2"
+
+    dropdb --if-exists "$db_name"
+    createdb "$db_name"
+
+    odoo -d "$db_name" \
+        -i "$MODULE" \
+        --addons-path="$ADDONS_PATH" \
+        --test-enable \
+        --stop-after-init \
+        --log-level=test \
+        --test-tags="$tags"
+}
+
+case "${1:-}" in
+    base)
+        run_odoo_tests "test_sale_carrier_fixturea_base" "/${MODULE}:${CLASS}.test_confirm_auto_assign_uses_existing_confirm_setting"
+        ;;
+    new)
+        run_odoo_tests "test_sale_carrier_fixturea_new" "/${MODULE}:${CLASS}.test_settings_field_persists_and_is_independent,/${MODULE}:${CLASS}.test_create_quote_assigns_matching_carrier_when_enabled,/${MODULE}:${CLASS}.test_create_quote_does_not_override_existing_carrier,/${MODULE}:${CLASS}.test_create_quote_leaves_carrier_empty_when_disabled,/${MODULE}:${CLASS}.test_create_quote_assigns_carrier_for_service_only_order,/${MODULE}:${CLASS}.test_onchange_partner_refreshes_carrier,/${MODULE}:${CLASS}.test_onchange_shipping_partner_refreshes_carrier,/${MODULE}:${CLASS}.test_confirm_auto_assign_uses_existing_confirm_setting,/${MODULE}:${CLASS}.test_confirm_not_enabled_by_create_setting_alone"
+        ;;
+    *)
+        echo "usage: $0 base|new"
+        exit 2
+        ;;
+esac
