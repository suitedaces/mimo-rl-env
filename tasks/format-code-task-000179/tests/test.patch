+    @classmethod
+    def _create_order(cls, partner, with_line=True, product=None, **extra_vals):
+        order_product = product or cls.product
+        vals = {
+            "partner_id": partner.id,
+            "order_line": [
+                (0, 0, {"product_id": order_product.id, "product_uom_qty": 1})
+            ]
+            if with_line
+            else [],
+        }
+        vals.update(extra_vals)
+        return cls.env["sale.order"].create(vals)
+
+    def test_settings_field_persists_and_is_independent(self):
+        self._set_settings(on_create=True, on_confirm=False)
+        self.assertTrue(self.company.carrier_on_create)
