diff --git a/usercase-test-coderl/rule-assembly.test.ts b/usercase-test-coderl/rule-assembly.test.ts
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/rule-assembly.test.ts
@@ -0,0 +1,280 @@
+import scriptlint = require("../src");
+
+const validMinimumScripts = {
+	dev: "echo 1",
+	start: "echo 1",
+	test: "echo 1",
+};
+
+const companyRule = {
+	name: "company-scripts",
+	isObjectRule: true,
+	message: "company scripts policy failed",
+	validate: () => false,
+};
+
+const issueNames = (config: Parameters<typeof scriptlint>[0]) =>
+	scriptlint(config).issues.map((issue) => issue.name);
+
+describe("scriptlint public rule assembly", () => {
+	test("uses the minimum built-in rules when strict is omitted", () => {
+
+
+		expect(issueNames({ packageScripts: {} })).toEqual([
+			"mandatory-test",
+			"mandatory-start",
+			"mandatory-dev",
+		]);
+	});
+
+	test("does not select strict-only rules when strict is false", () => {
+
+
+		expect(
+			issueNames({
+				strict: false,
+				packageScripts: {
+					dev: "echo 1",
+					start: "echo 1",
+					test: "echo 1",
+					jest: "jest",
+				},
+			})
+		).toEqual([]);
+	});
+
+	test("selects strict built-ins for the query's strict example", () => {
+
+
+		expect(
+			issueNames({
+				strict: true,
+				packageScripts: {
+					dev: "echo 1",
+					jest: "jest",
+					start: "echo 1",
+					test: "echo 1",
+				},
+			})
+		).toEqual(["no-aliases", "uses-allowed-namespace"]);
+	});
+
+	test("strict mode keeps the mandated minimum built-ins", () => {
+
+
+
+		expect(issueNames({ strict: true, packageScripts: {} })).toEqual([
+			"mandatory-test",
+			"mandatory-start",
+			"mandatory-dev",
+		]);
+	});
+
+	test("minimum built-ins include no-default-test after mandatory rules", () => {
+
+
+		expect(
+			issueNames({
+				packageScripts: {
+					dev: "echo 1",
+					start: "echo 1",
+					test: 'echo "Error: no test specified" && exit 1',
+				},
+			})
+		).toEqual(["no-default-test"]);
+	});
+
+	test("strict omitted and strict false select the same minimum built-ins", () => {
+
+
+
+		const expected = [
+			"mandatory-test",
+			"mandatory-start",
+			"mandatory-dev",
+		];
+		expect(issueNames({ packageScripts: {} })).toEqual(expected);
+		expect(issueNames({ strict: false, packageScripts: {} })).toEqual(expected);
+	});
+
+	test("strict built-ins can be disabled through rules config", () => {
+
+
+
+		expect(
+			issueNames({
+				strict: true,
+				packageScripts: {
+					dev: "echo 1",
+					jest: "jest",
+					start: "echo 1",
+					test: "echo 1",
+				},
+				rules: { "no-aliases": false },
+			})
+		).toEqual(["uses-allowed-namespace"]);
+	});
+
+	test("reports only spec-mandated issue names and returned scripts shape", () => {
+		const config = { packageScripts: {} };
+		const first = scriptlint(config);
+		const second = scriptlint(config);
+
+
+		expect(first.issues.map((issue) => issue.name)).toEqual([
+			"mandatory-test",
+			"mandatory-start",
+			"mandatory-dev",
+		]);
+		expect(second.issues.map((issue) => issue.name)).toEqual([
+			"mandatory-test",
+			"mandatory-start",
+			"mandatory-dev",
+		]);
+		expect(first.scripts).toEqual({});
+		expect(second.scripts).toEqual({});
+	});
+
+	test("strict rule assembly is deterministic for the same public config", () => {
+		const config = {
+			strict: true,
+			packageScripts: {
+				dev: "echo 1",
+				jest: "jest",
+				start: "echo 1",
+				test: "echo 1",
+			},
+		};
+
+
+		expect(issueNames(config)).toEqual(["no-aliases", "uses-allowed-namespace"]);
+		expect(issueNames(config)).toEqual(["no-aliases", "uses-allowed-namespace"]);
+	});
+
+	test("minimum mode still runs no-default-test for packageScripts input", () => {
+
+
+
+		expect(
+			issueNames({
+				packageScripts: {
+					dev: "echo 1",
+					start: "echo 1",
+					test: 'echo "Error: no test specified" && exit 1',
+				},
+			})
+		).toEqual(["no-default-test"]);
+	});
+
+	test("empty rules config does not disable strict built-ins", () => {
+
+
+
+		expect(
+			issueNames({
+				strict: true,
+				packageScripts: {
+					dev: "echo 1",
+					jest: "jest",
+					start: "echo 1",
+					test: "echo 1",
+				},
+				rules: {},
+			})
+		).toEqual(["no-aliases", "uses-allowed-namespace"]);
+	});
+
+	test("disables a selected mandatory built-in rule through rules config", () => {
+
+
+		expect(
+			issueNames({
+				packageScripts: {},
+				rules: { "mandatory-test": false },
+			})
+		).toEqual(["mandatory-start", "mandatory-dev"]);
+	});
+
+	test("disables a selected non-mandatory minimum built-in rule", () => {
+
+
+		expect(
+			issueNames({
+				packageScripts: {
+					dev: "echo 1",
+					start: "echo 1",
+					test: 'echo "Error: no test specified" && exit 1',
+				},
+				rules: { "no-default-test": false },
+			})
+		).toEqual([]);
+	});
+
+	test("runs an explicitly enabled custom object rule with otherwise valid minimum scripts", () => {
+
+
+		expect(
+			issueNames({
+				packageScripts: validMinimumScripts,
+				customRules: [companyRule],
+				rules: { "company-scripts": true },
+			})
+		).toEqual(["company-scripts"]);
+	});
+
+	test("prepends enabled custom rules before built-in rules", () => {
+
+
+		expect(
+			issueNames({
+				packageScripts: {},
+				customRules: [companyRule],
+				rules: { "company-scripts": true },
+			})
+		).toEqual([
+			"company-scripts",
+			"mandatory-test",
+			"mandatory-start",
+			"mandatory-dev",
+		]);
+	});
+
+	test("does not run a supplied custom rule when the rules entry is omitted", () => {
+
+
+
+		expect(
+			issueNames({
+				packageScripts: {},
+				customRules: [companyRule],
+				rules: {},
+			})
+		).toEqual(["mandatory-test", "mandatory-start", "mandatory-dev"]);
+	});
+
+	test("does not run a supplied custom rule when rules config is omitted", () => {
+
+
+
+		expect(
+			issueNames({
+				packageScripts: {},
+				customRules: [companyRule],
+			})
+		).toEqual(["mandatory-test", "mandatory-start", "mandatory-dev"]);
+	});
+
+	test("does not run a supplied custom rule when the rules entry is false", () => {
+
+
+
+		expect(
+			issueNames({
+				packageScripts: {},
+				customRules: [companyRule],
+				rules: { "company-scripts": false },
+			})
+		).toEqual(["mandatory-test", "mandatory-start", "mandatory-dev"]);
+	});
+
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+export npm_config_audit=false
+export npm_config_fund=false
+export npm_config_offline=true
+export npm_config_update_notifier=false
+export BROWSERSLIST_IGNORE_OLD_DATA=true
+
+JEST_BIN="/workspace/repo/node_modules/.bin/jest"
+if [ ! -x "$JEST_BIN" ]; then
+	echo "Missing local Jest binary at $JEST_BIN; dependencies must be preinstalled for offline test execution." >&2
+	exit 127
+fi
+exec "$JEST_BIN" --runTestsByPath /workspace/repo/usercase-test-coderl/rule-assembly.test.ts --config /workspace/repo/jest.config.ts
