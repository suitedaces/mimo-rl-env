diff --git a/tests/test_codespec_pass_culture.py b/tests/test_codespec_pass_culture.py
new file mode 100644
index 000000000..92942798f
--- /dev/null
+++ b/tests/test_codespec_pass_culture.py
@@ -0,0 +1,198 @@
+
+
+import pytest
+
+from openfisca_core.model_api import MONTH
+from openfisca_france.scenarios import init_single_entity
+
+from .cache import tax_benefit_system
+
+
+PUBLIC_VARIABLES = {
+    "pass_culture_compte_active": (bool, False),
+    "pass_culture_autorisation_parentale": (bool, False),
+    "pass_culture_eligibilite": (bool, False),
+    "pass_culture_montant": (float, 0),
+    "pass_culture_plafond_numerique": (float, 0),
+    }
+
+
+def calculate(variable_name, period, **inputs):
+    scenario = init_single_entity(
+        tax_benefit_system.new_scenario(),
+        period = period,
+        parent1 = inputs,
+        )
+    return scenario.new_simulation().calculate(variable_name, period = period)[0]
+
+
+def test_pass_culture_public_monthly_surface():
+    missing = sorted(set(PUBLIC_VARIABLES) - set(tax_benefit_system.variables))
+    assert not missing, "Missing public Pass Culture variables: {}".format(", ".join(missing))
+
+    for variable_name, (value_type, default_value) in PUBLIC_VARIABLES.items():
+        variable = tax_benefit_system.variables[variable_name]
+        assert variable.entity.key == "individu"
+        assert variable.definition_period == MONTH
+        assert variable.value_type is value_type
+        assert variable.default_value == default_value
+
+
+@pytest.mark.parametrize(
+    "period,age,expected",
+    [
+        ("2021-04", 18, False),
+        ("2021-05", 17, False),
+        ("2021-05", 18, True),
+        ("2021-05", 19, False),
+        ("2021-12", 17, False),
+        ("2022-01", 14, False),
+        ("2022-01", 15, True),
+        ("2022-01", 16, True),
+        ("2022-01", 17, True),
+        ("2022-01", 18, True),
+        ("2022-01", 19, False),
+        ],
+    )
+def test_pass_culture_calendar_and_age_boundaries(period, age, expected):
+    assert calculate(
+        "pass_culture_eligibilite",
+        period,
+        age = age,
+        nationalite = "FR",
+        ressortissant_eee = False,
+        residence_continue_annees = 0,
+        ) == expected
+
+
+@pytest.mark.parametrize(
+    "nationalite,ressortissant_eee,residence_continue_annees,expected",
+    [
+        ("FR", False, 0, True),
+        ("DE", True, 0, True),
+        ("XX", False, 0.99, False),
+        ("XX", False, 1, True),
+        ("XX", False, 4, True),
+        ],
+    )
+def test_pass_culture_nationality_and_residence_paths(
+        nationalite,
+        ressortissant_eee,
+        residence_continue_annees,
+        expected,
+        ):
+    assert calculate(
+        "pass_culture_eligibilite",
+        "2022-06",
+        age = 18,
+        nationalite = nationalite,
+        ressortissant_eee = ressortissant_eee,
+        residence_continue_annees = residence_continue_annees,
+        ) == expected
+
+
+def test_pass_culture_eligibility_is_independent_of_account_controls():
+    assert calculate(
+        "pass_culture_eligibilite",
+        "2022-06",
+        age = 15,
+        nationalite = "FR",
+        pass_culture_compte_active = False,
+        pass_culture_autorisation_parentale = False,
+        )
+
+
+@pytest.mark.parametrize(
+    "age,active,authorized,expected_amount,expected_digital",
+    [
+        (15, False, True, 0, 0),
+        (15, True, False, 0, 0),
+        (15, True, True, 20, 20),
+        (18, True, False, 300, 100),
+        (19, True, True, 0, 0),
+        ],
+    )
+def test_pass_culture_account_and_parental_authorization_gates(
+        age,
+        active,
+        authorized,
+        expected_amount,
+        expected_digital,
+        ):
+    inputs = dict(
+        age = age,
+        nationalite = "FR",
+        pass_culture_compte_active = active,
+        pass_culture_autorisation_parentale = authorized,
+        )
+    assert calculate("pass_culture_montant", "2022-06", **inputs) == expected_amount
+    assert calculate("pass_culture_plafond_numerique", "2022-06", **inputs) == expected_digital
+
+
+def test_pass_culture_default_inactive_account_has_no_credit():
+    inputs = dict(
+        age = 18,
+        nationalite = "FR",
+        )
+    assert calculate("pass_culture_eligibilite", "2022-06", **inputs)
+    assert calculate("pass_culture_montant", "2022-06", **inputs) == 0
+    assert calculate("pass_culture_plafond_numerique", "2022-06", **inputs) == 0
+
+
+def test_pass_culture_ineligible_resident_has_no_credit():
+    inputs = dict(
+        age = 18,
+        nationalite = "XX",
+        ressortissant_eee = False,
+        residence_continue_annees = 0.99,
+        pass_culture_compte_active = True,
+        )
+    assert not calculate("pass_culture_eligibilite", "2022-06", **inputs)
+    assert calculate("pass_culture_montant", "2022-06", **inputs) == 0
+    assert calculate("pass_culture_plafond_numerique", "2022-06", **inputs) == 0
+
+
+@pytest.mark.parametrize(
+    "period,age,expected",
+    [
+        ("2021-04", 18, 0),
+        ("2021-05", 17, 0),
+        ("2021-05", 18, 300),
+        ("2022-01", 15, 20),
+        ("2022-01", 16, 30),
+        ("2022-01", 17, 30),
+        ("2022-01", 18, 300),
+        ],
+    )
+def test_pass_culture_full_credit_schedule(period, age, expected):
+    assert calculate(
+        "pass_culture_montant",
+        period,
+        age = age,
+        nationalite = "FR",
+        pass_culture_compte_active = True,
+        pass_culture_autorisation_parentale = True,
+        ) == expected
+
+
+@pytest.mark.parametrize(
+    "period,age,expected",
+    [
+        ("2021-04", 18, 0),
+        ("2021-05", 17, 0),
+        ("2021-05", 18, 100),
+        ("2022-06", 15, 20),
+        ("2022-06", 16, 30),
+        ("2022-06", 17, 30),
+        ("2022-06", 18, 100),
+        ],
+    )
+def test_pass_culture_digital_credit_cap(period, age, expected):
+    assert calculate(
+        "pass_culture_plafond_numerique",
+        period,
+        age = age,
+        nationalite = "FR",
+        pass_culture_compte_active = True,
+        pass_culture_autorisation_parentale = True,
+        ) == expected
