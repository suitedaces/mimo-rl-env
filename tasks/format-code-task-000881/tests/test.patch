@@ -0,0 +1,11 @@
+from pathlib import Path
+
+
+def test_layer_status_assets_are_available_from_consolidated_api():
+    import chaco.overlays.api as overlays_api
+
+    for layer_class in (overlays_api.ErrorLayer, overlays_api.WarningLayer):
+        layer = layer_class(component=None)
+        layer_asset = Path(layer.filename)
+        assert layer_asset.is_file()
+        assert layer_asset.stat().st_size > 0
