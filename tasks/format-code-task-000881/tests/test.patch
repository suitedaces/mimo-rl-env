@@ -0,0 +1,121 @@
+import inspect
+
+
+CLASS_EXPORTS = (
+    "AlignedContainerOverlay",
+    "ColormappedSelectionOverlay",
+    "ContainerOverlay",
+    "CoordinateLineOverlay",
+    "DataBox",
+    "DataLabel",
+    "LassoOverlay",
+    "Legend",
+    "PlotLabel",
+    "ScatterInspectorOverlay",
+    "SimpleInspectorOverlay",
+    "TextBoxOverlay",
+    "TextGridOverlay",
+    "ToolTip",
+    "ImageInspectorOverlay",
+    "ErrorLayer",
+    "StatusLayer",
+    "WarningLayer",
+)
+
+FORMATTER_EXPORTS = (
+    "basic_formatter",
+    "datetime_formatter",
+    "date_formatter",
+    "time_formatter",
+)
+
+REPRESENTATIVE_TRAIT_CHECKS = {
+    "PlotLabel": ("text",),
+    "DataLabel": ("data_point",),
+    "SimpleInspectorOverlay": (),
+    "StatusLayer": (),
+}
+
+NO_ARG_CONSTRUCTIBLE_EXPORTS = (
+    "PlotLabel",
+    "DataLabel",
+    "SimpleInspectorOverlay",
+)
+
+
+def _assert_traits_public_class(obj, name):
+    assert inspect.isclass(obj), f"{name} should be a class"
+    assert hasattr(obj, "class_traits"), f"{name} should be a Traits class"
+    assert obj.class_traits(), f"{name} should expose Traits metadata"
+
+
+def test_overlays_api_exports_overlay_classes():
+    import chaco.overlays.api as overlays_api
+
+    for name in CLASS_EXPORTS:
+        obj = getattr(overlays_api, name)
+        _assert_traits_public_class(obj, name)
+
+
+def test_overlays_api_exports_formatter_helpers():
+    import chaco.overlays.api as overlays_api
+
+    for name in FORMATTER_EXPORTS:
+        obj = getattr(overlays_api, name)
+        assert callable(obj), f"{name} should be callable"
+
+
+def test_chaco_api_reexports_overlay_classes():
+    import chaco.api as chaco_api
+
+    for name in CLASS_EXPORTS:
+        obj = getattr(chaco_api, name)
+        _assert_traits_public_class(obj, name)
+
+
+def test_chaco_api_reexports_formatter_helpers():
+    import chaco.api as chaco_api
+
+    for name in FORMATTER_EXPORTS:
+        obj = getattr(chaco_api, name)
+        assert callable(obj), f"{name} should be callable"
+
+
+def test_chaco_api_and_overlays_api_objects_are_identical():
+    import chaco.api as chaco_api
+    import chaco.overlays.api as overlays_api
+
+    for name in CLASS_EXPORTS + FORMATTER_EXPORTS:
+        assert getattr(chaco_api, name) is getattr(overlays_api, name)
+
+
+def test_representative_exports_are_real_traits_classes():
+    import chaco.overlays.api as overlays_api
+
+    for name, required_traits in REPRESENTATIVE_TRAIT_CHECKS.items():
+        cls = getattr(overlays_api, name)
+        traits = cls.class_traits()
+        for trait_name in required_traits:
+            assert trait_name in traits
+
+    for name in NO_ARG_CONSTRUCTIBLE_EXPORTS:
+        cls = getattr(overlays_api, name)
+        instance = cls()
+        assert instance.__class__ is cls
+
+
+def test_formatter_helpers_return_text_for_public_inputs():
+    import chaco.overlays.api as overlays_api
+
+    basic = overlays_api.basic_formatter("sample_key", 1)
+    assert callable(basic)
+    first_result = basic(sample_key=12.5)
+    second_result = basic(sample_key=13.5)
+    assert isinstance(first_result, str)
+    assert isinstance(second_result, str)
+    assert first_result != second_result
+
+    for name in ("datetime_formatter", "date_formatter", "time_formatter"):
+        formatter = getattr(overlays_api, name)("when")
+        assert callable(formatter)
+        assert isinstance(formatter(when=0), str)
