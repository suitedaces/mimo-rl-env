+test('bracket-issue-fix: theme value with bracket notation resolves dotted key (single quotes outside)', () => {
+  let input = css`
+    .dialog {
+      font-size: theme('spacing[4.5]');
+    }
+  `
+
+  let output = css`
+    .dialog {
+      font-size: 1.125rem;
+    }
+  `
+
+  return run(input, {
+    theme: {
+      spacing: {
+        '4.5': '1.125rem',
+      },
+    },
+  }).then((result) => {
+    expect(result.css).toEqual(output)
+    expect(result.warnings().length).toBe(0)
+  })
+})
+
+test('bracket-issue-fix: theme value with bracket notation resolves dotted key (double quotes outside)', () => {
+  let input = css`
+    .dialog {
+      font-size: theme("spacing[4.5]");
+    }
+  `
+
+  let output = css`
+    .dialog {
+      font-size: 1.125rem;
+    }
+  `
+
+  return run(input, {
+    theme: {
+      spacing: {
+        '4.5': '1.125rem',
+      },
+    },
+  }).then((result) => {
+    expect(result.css).toEqual(output)
+    expect(result.warnings().length).toBe(0)
+  })
+})
+
+test('bracket-issue-fix: theme bracket notation resolves key containing dot', () => {
+  let input = css`
+    .heading {
+      color: theme('colors[the.brand]');
+    }
+  `
+
+  let output = css`
+    .heading {
+      color: #abcdef;
+    }
+  `
+
+  return run(input, {
+    theme: {
+      colors: {
+        'the.brand': '#abcdef',
+      },
+    },
+  }).then((result) => {
+    expect(result.css).toEqual(output)
+    expect(result.warnings().length).toBe(0)
+  })
+})
+
+test('bracket-issue-fix: regular dot notation still resolves after fix', () => {
+  let input = css`
+    .heading {
+      color: theme('colors.yellow');
+    }
+  `
+
+  let output = css`
