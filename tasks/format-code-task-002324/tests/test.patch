+"use strict";
+
+const prettier = require("prettier/local");
+
+
+
+
+test("preserves /*! at start of block comment (exact issue reproduction)", () => {
+  const input = `/*!
+ * Extracted from vue codebase
+ * https://github.com/vuejs/vue/blob/cfd73c2386623341fdbb3ac636c4baf84ea89c2c/src/compiler/parser/html-parser.js
+ * HTML Parser By John Resig (ejohn.org)
+ * Modified by Juriy "kangax" Zaytsev
+ * Original code by Erik Arvidsson, Mozilla Public License
+ * http://erik.eae.net/simplehtmlparser/simplehtmlparser.js
+ */
+`;
+  const output = prettier.format(input, { parser: "babylon" });
+  expect(output).toBe(input);
+
+  expect(output).not.toMatch(/\/\* !/);
+});
+
+test("preserves /*! with simple jsdoc-like body", () => {
+  const input = `/*!\n * Foo\n */\n`;
+  expect(prettier.format(input, { parser: "babylon" })).toBe(input);
+});
+
+test("preserves /*? (non-! non-* non-space first char) at start of block comment", () => {
+
+  const input = `/*?\n * Foo\n */\n`;
+  expect(prettier.format(input, { parser: "babylon" })).toBe(input);
+});
+
+test("preserves /*@ at start of block comment", () => {
+  const input = `/*@preserve\n * Foo\n */\n`;
+  expect(prettier.format(input, { parser: "babylon" })).toBe(input);
+});
+
+test("preserves /*! when input has indented inner lines", () => {
+
+
+  const input = `  /*!\n   * Foo\n   */\n  let x = 1;\n`;
+  const output = prettier.format(input, { parser: "babylon" });
+  expect(output).toMatch(/^\/\*!/m);
+  expect(output).not.toMatch(/\/\* !/);
+});
+
+test("preserves /* (empty first line) indentable jsdoc comment", () => {
+  const input = `/*\n * Foo\n */\n`;
+  expect(prettier.format(input, { parser: "babylon" })).toBe(input);
+});
+
+test("preserves /** (double-star) jsdoc comment", () => {
+  const input = `/**\n * Foo\n */\n`;
+  expect(prettier.format(input, { parser: "babylon" })).toBe(input);
+});
+
+test("preserves /* X (text starting with non-! non-* non-whitespace) on same line as opener", () => {
+  const input = `/* @ts-ignore\n * Foo\n */\n`;
+  expect(prettier.format(input, { parser: "babylon" })).toBe(input);
+});
