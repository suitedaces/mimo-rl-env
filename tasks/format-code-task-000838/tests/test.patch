diff --git a/tests/test_cli.py b/tests/test_cli.py
index 1faf0a3..dfed839 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -173,5 +173,111 @@ class TestWatchPID(TestCase):
         self.assertRaises(SystemExit, run_cmd, args)
 
 
+class TestHideCommand(TestCase):
+    @patch('ntfy.cli.Popen')
+    def test_hide_command_succeeded(self, mock_Popen):
+        mock_Popen.return_value = process_mock()
+        args = MagicMock()
+        args.longer_than = -1
+        args.command = ['true']
+        args.pid = None
+        args.unfocused_only = False
+        args.hide_command = True
+        args.no_emoji = True
+        message, retcode = run_cmd(args)
+        self.assertEqual(0, retcode)
+
+        self.assertRegex(
+            message, r'^"?Your command"? succeeded in 0:00 minutes$')
+
+    @patch('ntfy.cli.Popen')
+    def test_hide_command_failure(self, mock_Popen):
+        mock_Popen.return_value = process_mock(42)
+        args = MagicMock()
+        args.longer_than = -1
+        args.command = ['false']
+        args.pid = None
+        args.unfocused_only = False
+        args.hide_command = True
+        args.no_emoji = True
+        message, retcode = run_cmd(args)
+        self.assertEqual(42, retcode)
+        self.assertRegex(
+            message,
+            r'^"?Your command"? failed \(code 42\) in 0:00 minutes$')
+
+    @patch('ntfy.cli.Popen')
+    def test_hide_command_with_emoji(self, mock_Popen):
+        mock_Popen.return_value = process_mock()
+        args = MagicMock()
+        args.longer_than = -1
+        args.command = ['true']
+        args.pid = None
+        args.unfocused_only = False
+        args.hide_command = True
+        args.no_emoji = False
+        message, retcode = run_cmd(args)
+        self.assertRegex(
+            message,
+            r'^:white_check_mark: "?Your command"? succeeded in 0:00 minutes$')
+
+    @patch('ntfy.cli.Popen')
+    def test_hide_command_with_stdout(self, mock_Popen):
+        mock_Popen.return_value = process_mock(stdout='output')
+        args = MagicMock()
+        args.longer_than = -1
+        args.command = ['true']
+        args.pid = None
+        args.unfocused_only = False
+        args.stdout = True
+        args.stderr = False
+        args.hide_command = True
+        args.no_emoji = True
+        message, retcode = run_cmd(args)
+        self.assertRegex(
+            message,
+            r'^"?Your command"? succeeded in 0:00 minutes:\noutput$')
+
+    @patch('ntfy.cli.Popen')
+    def test_hide_command_does_not_include_actual_command(self, mock_Popen):
+
+
+        mock_Popen.return_value = process_mock()
+        args = MagicMock()
+        args.longer_than = -1
+        args.command = ['secret-cmd', '--secret-arg']
+        args.pid = None
+        args.unfocused_only = False
+        args.hide_command = True
+        args.no_emoji = True
+        message, _ = run_cmd(args)
+        self.assertNotIn('secret-cmd', message)
+        self.assertNotIn('--secret-arg', message)
+
+    @patch('ntfy.cli.Popen')
+    def test_hide_command_false_preserves_existing_format(self, mock_Popen):
+
+        mock_Popen.return_value = process_mock()
+        args = MagicMock()
+        args.longer_than = -1
+        args.command = ['true']
+        args.pid = None
+        args.unfocused_only = False
+        args.hide_command = False
+        args.no_emoji = True
+        message, retcode = run_cmd(args)
+        self.assertEqual('"true" succeeded in 0:00 minutes', message)
+
+    def test_cli_flag_hide_command_parses(self):
+        from ntfy.cli import parser
+        args = parser.parse_args(['done', '--hide-command', 'true'])
+        self.assertTrue(args.hide_command)
+
+    def test_cli_flag_hide_command_default_false(self):
+        from ntfy.cli import parser
+        args = parser.parse_args(['done', 'true'])
+        self.assertFalse(args.hide_command)
+
+
 if __name__ == '__main__':
     main()
