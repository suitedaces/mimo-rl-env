+func TestCardFetchesWellKnownAgentJSONAndReportsStatus(t *testing.T) {
+
+
+
+
+	var paths []string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		paths = append(paths, r.Method+" "+r.URL.Path)
+		switch r.URL.Path {
+		case "/missing/.well-known/agent.json":
+			http.Error(w, "not found", http.StatusNotFound)
+		default:
+			writeJSON(w, 200, a2a.AgentCard{
+				Name:               "echo",
+				Description:        "card fixture",
+				URL:                serverURLFromRequest(r),
+				Version:            "1.0.0",
+				ProtocolVersion:    "0.3.0",
+				Capabilities:       a2a.Capabilities{Streaming: false, PushNotifications: false},
+				DefaultInputModes:  []string{"text/plain"},
+				DefaultOutputModes: []string{"text/plain"},
+				Skills:             []a2a.Skill{{ID: "chat", Name: "Chat", Tags: []string{"ops"}}},
+			})
+		}
+	}))
+	defer server.Close()
+
+	card, err := a2a.NewClient(server.URL).Card(context.Background())
+	if err != nil {
+		t.Fatalf("Card error = %v, want nil", err)
+	}
+	if card.Name != "echo" {
+		t.Fatalf("card name = %q, want %q", card.Name, "echo")
+	}
+	if card.Description != "card fixture" {
+		t.Fatalf("card description = %q, want %q", card.Description, "card fixture")
+	}
+	if card.URL != server.URL {
+		t.Fatalf("card url = %q, want %q", card.URL, server.URL)
+	}
+	if card.DefaultInputModes[0] != "text/plain" {
+		t.Fatalf("card defaultInputModes[0] = %q, want %q", card.DefaultInputModes[0], "text/plain")
+	}
+	if card.Skills[0].Tags[0] != "ops" {
+		t.Fatalf("card skill tag = %q, want %q", card.Skills[0].Tags[0], "ops")
+	}
+
+	_, err = a2a.NewClient(server.URL + "/missing").Card(context.Background())
+	if err == nil {
+		t.Fatalf("Card 404 error = nil, want %q", "agent card: status 404")
+	}
+
+	if !strings.Contains(err.Error(), "agent card") || !strings.Contains(err.Error(), "404") {
+		t.Fatalf("Card 404 error = %q, want agent card context and status 404", err.Error())
+	}
+
+	if !slices.Contains(paths, "GET /.well-known/agent.json") || !slices.Contains(paths, "GET /missing/.well-known/agent.json") {
+		t.Fatalf("card request paths = %q, want both well-known agent card fetches", strings.Join(paths, ","))
+	}
+}
