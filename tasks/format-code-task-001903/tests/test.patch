+func TestSendPostsUserTextAndReturnsMessageTextParts(t *testing.T) {
+
+
+
+
+	var captured normalizedSendRequest
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			t.Fatalf("method = %q, want %q", r.Method, http.MethodPost)
+		}
+		if r.URL.Path != "/" {
+			t.Fatalf("path = %q, want %q", r.URL.Path, "/")
+		}
+		contentType, _, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+		if err != nil || contentType != "application/json" {
+
+			t.Fatalf("content-type = %q, want JSON media type", r.Header.Get("Content-Type"))
+		}
+		captured = decodeSendRequest(t, r.Body)
+		writeRPCResult(w, map[string]any{
+			"kind": "message",
+			"role": "agent",
+			"parts": []map[string]string{
+				{"kind": "text", "text": "hel"},
+				{"kind": "text", "text": "lo"},
+			},
+		})
+	}))
+	defer server.Close()
+
+	text, err := a2a.NewClient(server.URL).Send(context.Background(), "hi")
+	if err != nil {
+		t.Fatalf("Send error = %v, want nil", err)
+	}
+	if text != "hello" {
+		t.Fatalf("Send text = %q, want %q", text, "hello")
+	}
+	want := normalizedSendRequest{
+		JSONRPC:     "2.0",
+		Method:      "message/send",
+		MessageRole: "user",
+		MessageKind: "message",
+		PartKind:    "text",
+		PartText:    "hi",
+	}
+	if captured != want {
+		t.Fatalf("normalized request = %+v, want %+v", captured, want)
+	}
+}
