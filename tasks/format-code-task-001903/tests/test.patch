+func TestRepeatedConstructUseCyclesKeepFDsAndGoroutinesBounded(t *testing.T) {
+
+
+
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		writeRPCResult(w, completedTask("task-leak", "ok"))
+	}))
+	defer server.Close()
+
+	runtime.GC()
+	time.Sleep(50 * time.Millisecond)
+	baseFDs := openFDs(t)
+	baseGoroutines := runtime.NumGoroutine()
+
+	for i := 0; i < 120; i++ {
+		text, err := a2a.NewClient(server.URL).Send(context.Background(), "cycle")
+		if err != nil {
+			t.Fatalf("cycle %d Send error = %v, want nil", i, err)
+		}
+		if text != "ok" {
+			t.Fatalf("cycle %d Send text = %q, want %q", i, text, "ok")
+		}
+	}
+
+	runtime.GC()
+	time.Sleep(200 * time.Millisecond)
+	afterFDs := openFDs(t)
+	afterGoroutines := runtime.NumGoroutine()
+
+	if (afterFDs-baseFDs <= 40) != true {
+		t.Fatalf("fd delta <= 40 = %t, want %t (before %d after %d)", afterFDs-baseFDs <= 40, true, baseFDs, afterFDs)
+	}
+
+	if (afterGoroutines-baseGoroutines <= 60) != true {
+		t.Fatalf("goroutine delta <= 60 = %t, want %t (before %d after %d)", afterGoroutines-baseGoroutines <= 60, true, baseGoroutines, afterGoroutines)
+	}
+}
