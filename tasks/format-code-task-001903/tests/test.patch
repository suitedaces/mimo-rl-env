+func TestWithHTTPClientNilAndNonNilArePerInstance(t *testing.T) {
+
+
+
+
+	ctx := context.Background()
+	requests := 0
+	transport := roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		requests++
+		if r.Method != http.MethodGet {
+			t.Fatalf("method = %q, want %q", r.Method, http.MethodGet)
+		}
+		if r.URL.String() != "http://agent.example/rpc/.well-known/agent.json" {
+			t.Fatalf("url = %q, want %q", r.URL.String(), "http://agent.example/rpc/.well-known/agent.json")
+		}
+		return jsonResponse(200, `{"name":"alpha","url":"http://agent.example/rpc","version":"1.0.0","protocolVersion":"0.3.0","capabilities":{"streaming":false,"pushNotifications":false},"defaultInputModes":["text/plain"],"defaultOutputModes":["text/plain"],"skills":[{"id":"chat","name":"Chat"}]}`), nil
+	})
+
+	client := a2a.NewClient("http://agent.example/rpc")
+	chained := client.WithHTTPClient(&http.Client{Transport: transport})
+	if (chained == client) != true {
+		t.Fatalf("WithHTTPClient(non-nil) returned same pointer = %t, want %t", chained == client, true)
+	}
+	chainedAgain := client.WithHTTPClient(nil)
+	if (chainedAgain == client) != true {
+		t.Fatalf("WithHTTPClient(nil) returned same pointer = %t, want %t", chainedAgain == client, true)
+	}
+
+	card, err := client.Card(ctx)
+	if err != nil {
+		t.Fatalf("Card error = %v, want nil", err)
+	}
+	if requests != 1 {
+		t.Fatalf("transport requests = %d, want %d", requests, 1)
+	}
+	if card.Name != "alpha" {
+		t.Fatalf("card name = %q, want %q", card.Name, "alpha")
+	}
+	if card.URL != "http://agent.example/rpc" {
+		t.Fatalf("card url = %q, want %q", card.URL, "http://agent.example/rpc")
+	}
+	if card.ProtocolVersion != "0.3.0" {
+		t.Fatalf("card protocolVersion = %q, want %q", card.ProtocolVersion, "0.3.0")
+	}
+}
