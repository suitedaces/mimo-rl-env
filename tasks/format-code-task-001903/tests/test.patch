+func TestSendTerminalFailureStatesReturnSpecificErrors(t *testing.T) {
+
+
+
+
+	cases := []struct {
+		state string
+		want  string
+	}{
+		{state: "failed", want: "remote task task-failed ended in state \"failed\""},
+		{state: "canceled", want: "remote task task-canceled ended in state \"canceled\""},
+		{state: "rejected", want: "remote task task-rejected ended in state \"rejected\""},
+	}
+	for _, tc := range cases {
+		t.Run(tc.state, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				writeRPCResult(w, terminalTask("task-"+tc.state, tc.state))
+			}))
+			defer server.Close()
+
+			text, err := a2a.NewClient(server.URL).Send(context.Background(), "stop")
+			if text != "" {
+				t.Fatalf("Send text = %q, want %q", text, "")
+			}
+			if err == nil {
+				t.Fatalf("Send error = nil, want %q", tc.want)
+			}
+
+			if !strings.Contains(err.Error(), "task-"+tc.state) || !strings.Contains(err.Error(), tc.state) {
+				t.Fatalf("Send error = %q, want task id and terminal state %q", err.Error(), tc.state)
+			}
+		})
+	}
+}
