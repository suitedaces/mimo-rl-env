+func TestTwoClientsKeepIndependentURLsAndTransports(t *testing.T) {
+
+
+
+
+	aRequests := 0
+	aTransport := roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		aRequests++
+		if r.URL.String() != "http://alpha.invalid/rpc/.well-known/agent.json" {
+			t.Fatalf("client A url = %q, want %q", r.URL.String(), "http://alpha.invalid/rpc/.well-known/agent.json")
+		}
+		return jsonResponse(200, `{"name":"alpha","url":"http://alpha.invalid/rpc","version":"1.0.0","protocolVersion":"0.3.0","capabilities":{"streaming":false,"pushNotifications":false},"defaultInputModes":["text/plain"],"defaultOutputModes":["text/plain"],"skills":[{"id":"chat","name":"Chat"}]}`), nil
+	})
+	bRequests := 0
+	bServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		bRequests++
+		if r.URL.Path != "/.well-known/agent.json" {
+			t.Fatalf("client B path = %q, want %q", r.URL.Path, "/.well-known/agent.json")
+		}
+		writeJSON(w, 200, a2a.AgentCard{
+			Name:               "bravo",
+			URL:                bServerURL(r),
+			Version:            "1.0.0",
+			ProtocolVersion:    "0.3.0",
+			Capabilities:       a2a.Capabilities{Streaming: false, PushNotifications: false},
+			DefaultInputModes:  []string{"text/plain"},
+			DefaultOutputModes: []string{"text/plain"},
+			Skills:             []a2a.Skill{{ID: "chat", Name: "Chat"}},
+		})
+	}))
+	defer bServer.Close()
+
+	aClient := a2a.NewClient("http://alpha.invalid/rpc").WithHTTPClient(&http.Client{Transport: aTransport})
+	bClient := a2a.NewClient(bServer.URL)
+
+	aCard, err := aClient.Card(context.Background())
+	if err != nil {
+		t.Fatalf("client A Card error = %v, want nil", err)
+	}
+	bCard, err := bClient.Card(context.Background())
+	if err != nil {
+		t.Fatalf("client B Card error = %v, want nil", err)
+	}
+	if aCard.Name != "alpha" {
+		t.Fatalf("client A card name = %q, want %q", aCard.Name, "alpha")
+	}
+	if bCard.Name != "bravo" {
+		t.Fatalf("client B card name = %q, want %q", bCard.Name, "bravo")
+	}
+	if aRequests != 1 {
+		t.Fatalf("client A transport requests = %d, want %d", aRequests, 1)
+	}
+	if bRequests != 1 {
+		t.Fatalf("client B server requests = %d, want %d", bRequests, 1)
+	}
