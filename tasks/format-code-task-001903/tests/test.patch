+func TestSendPollsPendingTaskUntilCompleted(t *testing.T) {
+
+
+
+
+	var mu sync.Mutex
+	var methods []string
+	var getID string
+	var sendAt, getAt time.Time
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		req := decodeRPCRequest(t, r.Body)
+		mu.Lock()
+		methods = append(methods, req.Method)
+		switch req.Method {
+		case "message/send":
+			sendAt = time.Now()
+			mu.Unlock()
+			writeRPCResult(w, map[string]any{
+				"kind":      "task",
+				"id":        "task-pending",
+				"contextId": "ctx-pending",
+				"status": map[string]string{
+					"state":     "working",
+					"timestamp": "2026-06-29T00:00:00Z",
+				},
+			})
+		case "tasks/get":
+			getAt = time.Now()
+			getID = taskGetID(t, req.Params)
+			mu.Unlock()
+			writeRPCResult(w, completedTask("task-pending", "done"))
+		default:
+			mu.Unlock()
+			t.Fatalf("method = %q, want %q or %q", req.Method, "message/send", "tasks/get")
+		}
+	}))
+	defer server.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	text, err := a2a.NewClient(server.URL).Send(ctx, "wait")
+	if err != nil {
+		t.Fatalf("Send error = %v, want nil", err)
+	}
+	if text != "done" {
+		t.Fatalf("Send text = %q, want %q", text, "done")
+	}
+	if strings.Join(methods, ",") != "message/send,tasks/get" {
+		t.Fatalf("methods = %q, want %q", strings.Join(methods, ","), "message/send,tasks/get")
+	}
+	if getID != "task-pending" {
+		t.Fatalf("tasks/get id = %q, want %q", getID, "task-pending")
+	}
+	delay := getAt.Sub(sendAt)
+
+	if delay < 200*time.Millisecond || delay > 750*time.Millisecond {
+		t.Fatalf("poll delay = %s, want about 300ms", delay)
+	}
+}
