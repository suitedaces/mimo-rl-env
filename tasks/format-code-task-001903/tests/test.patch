+type rpcRequest struct {
+	JSONRPC string          `json:"jsonrpc"`
+	ID      json.RawMessage `json:"id"`
+	Method  string          `json:"method"`
+	Params  json.RawMessage `json:"params"`
+}
+
+type normalizedSendRequest struct {
+	JSONRPC     string
+	Method      string
+	MessageRole string
+	MessageKind string
+	PartKind    string
+	PartText    string
+}
+
+func decodeSendRequest(t *testing.T, body io.Reader) normalizedSendRequest {
+	t.Helper()
+	req := decodeRPCRequest(t, body)
+	var params struct {
+		Message struct {
+			Role  string `json:"role"`
+			Kind  string `json:"kind"`
+			Parts []struct {
+				Kind string `json:"kind"`
+				Text string `json:"text"`
+			} `json:"parts"`
+		} `json:"message"`
+	}
+	if err := json.Unmarshal(req.Params, &params); err != nil {
+		t.Fatalf("decode params: %v", err)
+	}
+	return normalizedSendRequest{
+		JSONRPC:     req.JSONRPC,
+		Method:      req.Method,
+		MessageRole: params.Message.Role,
+		MessageKind: params.Message.Kind,
+		PartKind:    params.Message.Parts[0].Kind,
+		PartText:    params.Message.Parts[0].Text,
+	}
+}
+
+func decodeRPCRequest(t *testing.T, body io.Reader) rpcRequest {
+	t.Helper()
+	var req rpcRequest
+	if err := json.NewDecoder(body).Decode(&req); err != nil {
+		t.Fatalf("decode rpc request: %v", err)
+	}
+	return req
+}
+
+func taskGetID(t *testing.T, raw json.RawMessage) string {
+	t.Helper()
+	var params struct {
+		ID string `json:"id"`
+	}
+	if err := json.Unmarshal(raw, &params); err != nil {
+		t.Fatalf("decode tasks/get params: %v", err)
+	}
+	return params.ID
+}
+
+func completedTask(id string, parts ...string) map[string]any {
+	textParts := make([]map[string]string, 0, len(parts))
+	for _, part := range parts {
+		textParts = append(textParts, map[string]string{"kind": "text", "text": part})
+	}
+	return map[string]any{
+		"kind":      "task",
+		"id":        id,
+		"contextId": "ctx-" + id,
+		"status": map[string]string{
+			"state":     "completed",
+			"timestamp": "2026-06-29T00:00:00Z",
+		},
+		"artifacts": []map[string]any{{
+			"artifactId": "artifact-" + id,
+			"parts":      textParts,
+		}},
+	}
+}
+
+func terminalTask(id, state string) map[string]any {
+	return map[string]any{
+		"kind":      "task",
+		"id":        id,
+		"contextId": "ctx-" + id,
+		"status": map[string]string{
+			"state":     state,
+			"timestamp": "2026-06-29T00:00:00Z",
+		},
+	}
+}
+
+func writeRPCResult(w http.ResponseWriter, result any) {
+	writeJSON(w, 200, map[string]any{
+		"jsonrpc": "2.0",
+		"id":      "response-id",
+		"result":  result,
+	})
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(v)
+}
+
+func jsonResponse(status int, body string) *http.Response {
+	return &http.Response{
+		StatusCode: status,
+		Header:     make(http.Header),
+		Body:       io.NopCloser(bytes.NewBufferString(body)),
+	}
+}
+
+func openFDs(t *testing.T) int {
+	t.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		t.Fatalf("read /proc/self/fd: %v", err)
+	}
+	return len(entries)
+}
+
+func serverURLFromRequest(r *http.Request) string {
+	return fmt.Sprintf("http://%s", r.Host)
+}
+
+func bServerURL(r *http.Request) string {
+	return fmt.Sprintf("http://%s", r.Host)
+}
