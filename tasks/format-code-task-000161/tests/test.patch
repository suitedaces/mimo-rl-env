@@ -943,3 +943,76 @@ def test_sim904():
 a['b'] = 'c'"""
     )
     assert results == {"1:0 SIM904 Initialize dictionary 'a' directly"}
+
+
+def _sim905_results(code: str):
+    return [r for r in _results(code) if " SIM905 " in r]
+
+
+def test_sim905():
+    sim905 = _sim905_results('domains = "de com net org".split()')
+    # Exactly one SIM905 fired on line 1
+    assert len(sim905) == 1
+    msg = next(iter(sim905))
+    assert msg.startswith("1:")
+    assert " SIM905 " in msg
+    # Suggestion mentions all four split parts
+    for token in ("de", "com", "net", "org"):
+        assert token in msg
+    # Suggestion references the original split call
+    assert ".split()" in msg
+
+
+def test_sim905_already_list_not_flagged():
+    results = _results('domains = ["de", "com", "net", "org"]')
+    assert not any("SIM905" in r for r in results)
+
+
+def test_sim905_variable_split_not_flagged():
+    results = _results("x = y.split()")
+    assert not any("SIM905" in r for r in results)
+
+
+def test_sim905_fstring_not_flagged():
+    results = _results('x = f"a b c".split()')
+    assert not any("SIM905" in r for r in results)
+
+
+def test_sim905_non_split_method_not_flagged():
+    results = _results('x = "a b c".upper()')
+    assert not any("SIM905" in r for r in results)
+
+
+def test_sim905_non_constant_value_not_flagged():
+    results = _results("x = (a + b).split()")
+    assert not any("SIM905" in r for r in results)
+
+
+def test_sim905_empty_string():
+    sim905 = _sim905_results('x = "".split()')
+    assert len(sim905) == 1
+    msg = next(iter(sim905))
+    assert msg.startswith("1:")
+    assert " SIM905 " in msg
+    # The empty list should appear in the suggestion
+    assert "[]" in msg
+
+
+def test_sim905_single_word():
+    sim905 = _sim905_results('x = "hello".split()')
+    assert len(sim905) == 1
+    msg = next(iter(sim905))
+    assert msg.startswith("1:")
+    assert " SIM905 " in msg
+    assert "hello" in msg
+
+
+def test_sim905_inside_function_call():
+    """SIM905 should fire even when not part of an assignment."""
+    sim905 = _sim905_results('print("a b c".split())')
+    assert len(sim905) == 1
+    msg = next(iter(sim905))
+    assert msg.startswith("1:")
+    assert " SIM905 " in msg
+    for token in ("a", "b", "c"):
+        assert token in msg
