diff --git a/alicloud/resource_alicloud_emrv2_cluster_unit_test.go b/alicloud/resource_alicloud_emrv2_cluster_unit_test.go
new file mode 100644
index 000000000..de8a9df17
--- /dev/null
+++ b/alicloud/resource_alicloud_emrv2_cluster_unit_test.go
@@ -0,0 +1,91 @@
+package alicloud
+
+import (
+	"testing"
+
+	"github.com/hashicorp/terraform-plugin-sdk/helper/schema"
+	"github.com/stretchr/testify/assert"
+)
+
+
+
+func emrV2NestedBlockSchema(t *testing.T, block string) map[string]*schema.Schema {
+	r := resourceAlicloudEmrV2Cluster()
+	s, ok := r.Schema[block]
+	assert.Truef(t, ok, "%q block should exist on the resource schema", block)
+	res, ok := s.Elem.(*schema.Resource)
+	assert.Truef(t, ok, "%q block should be a nested resource block", block)
+	return res.Schema
+}
+
+
+
+func valueAccepted(vf schema.SchemaValidateFunc, val interface{}, key string) bool {
+	if vf == nil {
+		return true
+	}
+	ws, es := vf(val, key)
+	return len(ws) == 0 && len(es) == 0
+}
+
+func TestUnitEmrV2SystemDiskEncryptedSchema(t *testing.T) {
+	na := emrV2NestedBlockSchema(t, "node_attributes")
+
+	f, ok := na["system_disk_encrypted"]
+	assert.True(t, ok, "node_attributes should expose system_disk_encrypted")
+	if ok {
+		assert.Equal(t, schema.TypeBool, f.Type, "system_disk_encrypted should be a boolean")
+		assert.True(t, f.Optional, "system_disk_encrypted should be optional")
+		assert.True(t, f.ForceNew, "system_disk_encrypted should force recreation")
+	}
+}
+
+func TestUnitEmrV2SystemDiskKmsKeyIdSchema(t *testing.T) {
+	na := emrV2NestedBlockSchema(t, "node_attributes")
+
+	f, ok := na["system_disk_kms_key_id"]
+	assert.True(t, ok, "node_attributes should expose system_disk_kms_key_id")
+	if !ok {
+		return
+	}
+	assert.Equal(t, schema.TypeString, f.Type, "system_disk_kms_key_id should be a string")
+	assert.True(t, f.Optional, "system_disk_kms_key_id should be optional")
+	assert.True(t, f.ForceNew, "system_disk_kms_key_id should force recreation")
+
+	assert.False(t, valueAccepted(f.ValidateFunc, "", "system_disk_kms_key_id"),
+		"an empty system_disk_kms_key_id should be rejected")
+	assert.True(t, valueAccepted(f.ValidateFunc, "alias/my-key", "system_disk_kms_key_id"),
+		"a non-empty system_disk_kms_key_id should be accepted")
+}
+
+func TestUnitEmrV2NodeGroupTypeAcceptsMasterExtend(t *testing.T) {
+	ng := emrV2NestedBlockSchema(t, "node_groups")
+	f, ok := ng["node_group_type"]
+	assert.True(t, ok, "node_groups should expose node_group_type")
+	if !ok {
+		return
+	}
+
+	for _, v := range []string{"MASTER", "CORE", "TASK", "GATEWAY", "MASTER-EXTEND"} {
+		assert.Truef(t, valueAccepted(f.ValidateFunc, v, "node_group_type"),
+			"node_group_type should accept %q", v)
+	}
+	assert.False(t, valueAccepted(f.ValidateFunc, "NOT_A_TYPE", "node_group_type"),
+		"node_group_type should reject values outside the accepted set")
+}
+
+func TestUnitEmrV2ExecutionMomentAcceptsBeforeStart(t *testing.T) {
+	bs := emrV2NestedBlockSchema(t, "bootstrap_scripts")
+	f, ok := bs["execution_moment"]
+	assert.True(t, ok, "bootstrap_scripts should expose execution_moment")
+	if !ok {
+		return
+	}
+
+	for _, v := range []string{"BEFORE_INSTALL", "AFTER_STARTED", "BEFORE_START"} {
+		assert.Truef(t, valueAccepted(f.ValidateFunc, v, "execution_moment"),
+			"execution_moment should accept %q", v)
+	}
+	assert.False(t, valueAccepted(f.ValidateFunc, "NOT_A_MOMENT", "execution_moment"),
+		"execution_moment should reject values outside the accepted set")
+}
