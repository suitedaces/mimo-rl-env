+
+
+
+
+
+export GOFLAGS=-mod=vendor
+GOGC=10 go test -c -o /tmp/alicloud_grade.test ./alicloud/
+
+
+/tmp/alicloud_grade.test -test.run '^(TestProvider|TestProvider_impl)$' -test.v
+
+
