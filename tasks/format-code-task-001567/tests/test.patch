+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+if [[ -x /workspace/repo/.venv/bin/python ]]; then
+  PYTHON_BIN=/workspace/repo/.venv/bin/python
+else
+  PYTHON_BIN=${PYTHON:-python3}
+fi
+
+export PYTHONPATH="/workspace/repo${PYTHONPATH:+:${PYTHONPATH}}"
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+export PIP_NO_INDEX=1
+export UV_NO_NETWORK=1
+export AWS_EC2_METADATA_DISABLED=true
+
+exec "${PYTHON_BIN}" -m pytest /workspace/repo/usercase-test-coderl/test_lazy_getitem.py -v
