@@ -0,0 +1,144 @@
+import ast
+import textwrap
+import unittest
+
+from bugbear import BugBearChecker
+
+
+B028_MESSAGE = "B028 No explicit stacklevel argument found."
+
+
+def b028_diagnostics(source):
+    source = textwrap.dedent(source).lstrip("\n")
+    checker = BugBearChecker(
+        tree=ast.parse(source),
+        lines=source.splitlines(keepends=True),
+        filename="b028_contract_sample.py",
+    )
+    return [
+        (line, column, message)
+        for line, column, message, _ in checker.run()
+        if message.startswith("B028")
+    ]
+
+
+class B028StacklevelContractTests(unittest.TestCase):
+    def test_reports_standard_warn_calls_through_supported_import_forms(self):
+        source = """
+            import warnings
+            import warnings as warning_tools
+            from warnings import warn
+            from warnings import warn as emit_warning
+
+            warnings.warn("canonical")
+            warning_tools.warn("module alias")
+            warn("direct import")
+            emit_warning("direct alias")
+        """
+        self.assertEqual(
+            b028_diagnostics(source),
+            [
+                (6, 0, B028_MESSAGE),
+                (7, 0, B028_MESSAGE),
+                (8, 0, B028_MESSAGE),
+                (9, 0, B028_MESSAGE),
+            ],
+        )
+
+    def test_call_shape_distinguishes_explicit_and_unknown_stacklevel(self):
+        source = """
+            import warnings
+
+            warnings.warn("keyword", stacklevel=2)
+            warnings.warn("positional", UserWarning, 2)
+            warnings.warn("expanded", **warning_options)
+            warnings.warn("two positional", UserWarning)
+            warnings.warn(message="message only", category=UserWarning)
+        """
+        self.assertEqual(
+            b028_diagnostics(source),
+            [
+                (6, 0, B028_MESSAGE),
+                (7, 0, B028_MESSAGE),
+            ],
+        )
+
+    def test_unrelated_warn_symbols_are_not_reported(self):
+        source = """
+            import logging
+            from another_warnings_package import warn
+
+            logging.getLogger(__name__).warn("logger")
+            service.warn("method")
+            warn("other import")
+
+            def warn(message):
+                return message
+
+            warn("plain function")
+        """
+        self.assertEqual(b028_diagnostics(source), [])
+
+    def test_rebinding_and_reimport_change_which_calls_are_standard_warn(self):
+        source = """
+            import warnings as warning_api
+            from warnings import warn as emit
+
+            warning_api.warn("before module rebind")
+            emit("before function rebind")
+
+            warning_api = custom_warning_api
+            emit = custom_emit
+            warning_api.warn("after module rebind")
+            emit("after function rebind")
+
+            import warnings as warning_api
+            from warnings import warn as emit
+            warning_api.warn("after module reimport")
+            emit("after function reimport")
+        """
+        self.assertEqual(
+            b028_diagnostics(source),
+            [
+                (4, 0, B028_MESSAGE),
+                (5, 0, B028_MESSAGE),
+                (14, 0, B028_MESSAGE),
+                (15, 0, B028_MESSAGE),
+            ],
+        )
+
+    def test_outer_aliases_are_inherited_but_function_parameters_shadow_them(self):
+        source = """
+            import warnings
+            from warnings import warn as emit
+
+            def inherited_aliases():
+                warnings.warn("module from child")
+                emit("function from child")
+
+            def shadowed_aliases(warnings, emit):
+                warnings.warn("shadowed module")
+                emit("shadowed function")
+
+            def locally_imported_aliases():
+                import warnings as local_warnings
+                from warnings import warn as local_emit
+                local_warnings.warn("local module")
+                local_emit("local function")
+
+            local_warnings.warn("local import must not leak")
+            local_emit("local direct import must not leak")
+        """
+        self.assertEqual(
+            b028_diagnostics(source),
+            [
+                (5, 4, B028_MESSAGE),
+                (6, 4, B028_MESSAGE),
+                (15, 4, B028_MESSAGE),
+                (16, 4, B028_MESSAGE),
+            ],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
