+++ b/packages/backend-core/src/__tests__/apis/OrganizationAdministrationContract.test.ts
@@ -0,0 +1,343 @@
+import { ClerkBackendAPI } from '../../api/ClerkBackendAPI';
+import * as BackendResources from '../../api/resources';
+
+type CapturedRequest = {
+  url: string;
+  options: {
+    method: string;
+    body?: Record<string, unknown>;
+  };
+};
+
+const organizationJSON = {
+  object: 'organization',
+  id: 'org_alpha',
+  name: 'Alpha Labs',
+  created_at: 1640000001,
+  updated_at: 1640000002,
+  server_only: 'ignored',
+};
+
+const membershipJSON = {
+  object: 'organization_membership',
+  id: 'orgmem_alpha',
+  organization: organizationJSON,
+  public_user_data: {
+    object: 'public_user_data',
+    id: 'public_user_record_beta',
+    user_id: 'user_beta',
+    first_name: 'Bea',
+    last_name: 'Tester',
+    profile_image_url: 'https://img.test/bea.png',
+    identifier: 'bea@example.test',
+  },
+  role: 'admin',
+  created_at: 1640000003,
+  updated_at: 1640000004,
+  server_only: 'ignored',
+};
+
+const invitationJSON = {
+  object: 'organization_invitation',
+  id: 'orginv_gamma',
+  organization_id: 'org_alpha',
+  email_address: 'gamma@example.test',
+  role: 'basic_member',
+  status: 'pending',
+  created_at: 1640000005,
+  updated_at: 1640000006,
+  server_only: 'ignored',
+};
+
+function makeClient(reply: (request: CapturedRequest) => unknown) {
+  const requests: CapturedRequest[] = [];
+  const client = new ClerkBackendAPI({
+    apiKey: 'test_key',
+    apiVersion: 'v9',
+    serverApiUrl: 'https://backend.test',
+    libName: 'contract-test',
+    libVersion: '1.0.0',
+    packageRepo: 'local',
+    fetcher: async (url, options) => {
+      const request = { url, options } as CapturedRequest;
+      requests.push(request);
+      return reply(request);
+    },
+  });
+
+  return { client, requests };
+}
+
+function method(client: ClerkBackendAPI, name: string): (...args: any[]) => Promise<any> {
+  const candidate = (client.organizations as any)[name];
+  expect(candidate).toEqual(expect.any(Function));
+  return candidate.bind(client.organizations);
+}
+
+function requestPath(request: CapturedRequest) {
+  return new URL(request.url).pathname;
+}
+
+function requestQuery(request: CapturedRequest) {
+  return Object.fromEntries(new URL(request.url).searchParams.entries());
+}
+
+test('exports the organization administration resources and methods', () => {
+  const { client } = makeClient(() => organizationJSON);
+
+  expect((BackendResources as any).OrganizationMembership).toEqual(expect.any(Function));
+  expect((BackendResources as any).OrganizationInvitation).toEqual(expect.any(Function));
+  expect(client.organizations).toEqual(
+    expect.objectContaining({
+      getOrganizationList: expect.any(Function),
+      getOrganization: expect.any(Function),
+      updateOrganization: expect.any(Function),
+      deleteOrganization: expect.any(Function),
+      getOrganizationMembershipList: expect.any(Function),
+      createOrganizationMembership: expect.any(Function),
+      updateOrganizationMembership: expect.any(Function),
+      deleteOrganizationMembership: expect.any(Function),
+      getOrganizationInvitationList: expect.any(Function),
+      createOrganizationInvitation: expect.any(Function),
+      revokeOrganizationInvitation: expect.any(Function),
+    }),
+  );
+});
+
+test('lists organizations with optional pagination and no stray query parameters', async () => {
+  const { client, requests } = makeClient(() => [organizationJSON]);
+  const list = method(client, 'getOrganizationList');
+
+  const paged = await list({ limit: 2, offset: 3 });
+  const unpaged = await list();
+
+  expect(requests).toHaveLength(2);
+  expect(requests.map(requestPath)).toEqual(['/v9/organizations', '/v9/organizations']);
+  expect(requests[0].options.method).toBe('GET');
+  expect(requestQuery(requests[0])).toEqual({ limit: '2', offset: '3' });
+  expect(new URL(requests[1].url).search).toBe('');
+  expect(paged).toHaveLength(1);
+  expect(unpaged).toHaveLength(1);
+  expect(paged[0]).toBeInstanceOf(BackendResources.Organization);
+});
+
+test('gets, updates, and deletes organizations through their canonical paths', async () => {
+  const { client, requests } = makeClient(() => organizationJSON);
+
+  const fetched = await method(client, 'getOrganization')('org_alpha');
+  const updated = await method(client, 'updateOrganization')('org_alpha', { name: 'Renamed Labs' });
+  const deleted = await method(client, 'deleteOrganization')('org_alpha');
+
+  expect(requests.map(requestPath)).toEqual([
+    '/v9/organizations/org_alpha',
+    '/v9/organizations/org_alpha',
+    '/v9/organizations/org_alpha',
+  ]);
+  expect(requests.map(x => x.options.method)).toEqual(['GET', 'PATCH', 'DELETE']);
+  expect(requests[0].options.body).toBeUndefined();
+  expect(requests[1].options.body).toEqual({ name: 'Renamed Labs' });
+  expect(requests[2].options.body).toBeUndefined();
+  for (const result of [fetched, updated, deleted]) {
+    expect(result).toBeInstanceOf(BackendResources.Organization);
+    expect(result).toMatchObject({
+      id: 'org_alpha',
+      name: 'Alpha Labs',
+      createdAt: 1640000001,
+      updatedAt: 1640000002,
+    });
+  }
+});
+
+test('lists memberships and converts nested public data and organization resources', async () => {
+  const { client, requests } = makeClient(() => [membershipJSON]);
+  const list = method(client, 'getOrganizationMembershipList');
+
+  const paged = await list({ organizationId: 'org_alpha', limit: 4, offset: 5 });
+  const unpaged = await list({ organizationId: 'org_delta' });
+
+  expect(requests.map(requestPath)).toEqual([
+    '/v9/organizations/org_alpha/memberships',
+    '/v9/organizations/org_delta/memberships',
+  ]);
+  expect(requestQuery(requests[0])).toEqual({ limit: '4', offset: '5' });
+  expect(new URL(requests[1].url).search).toBe('');
+  expect(requests[0].options.method).toBe('GET');
+
+  const member = paged[0];
+  expect(member).toBeInstanceOf((BackendResources as any).OrganizationMembership);
+  expect(member.organization).toBeInstanceOf(BackendResources.Organization);
+  expect(member).toMatchObject({
+    id: 'orgmem_alpha',
+    role: 'admin',
+    createdAt: 1640000003,
+    updatedAt: 1640000004,
+    publicUserData: {
+      userId: 'user_beta',
+      firstName: 'Bea',
+      lastName: 'Tester',
+      profileImageUrl: 'https://img.test/bea.png',
+      identifier: 'bea@example.test',
+    },
+  });
+  expect(member).not.toHaveProperty('serverOnly');
+  expect(member.organization).not.toHaveProperty('serverOnly');
+  expect(unpaged[0]).toBeInstanceOf((BackendResources as any).OrganizationMembership);
+});
+
+test('creates, updates, and deletes memberships with role and user serialization', async () => {
+  const { client, requests } = makeClient(() => membershipJSON);
+
+  const created = await method(client, 'createOrganizationMembership')({
+    organizationId: 'org_alpha',
+    userId: 'user_beta',
+    role: 'basic_member',
+  });
+  const updated = await method(client, 'updateOrganizationMembership')({
+    organizationId: 'org_alpha',
+    userId: 'user_beta',
+    role: 'admin',
+  });
+  const deleted = await method(client, 'deleteOrganizationMembership')({
+    organizationId: 'org_alpha',
+    userId: 'user_beta',
+  });
+
+  expect(requests.map(requestPath)).toEqual([
+    '/v9/organizations/org_alpha/memberships',
+    '/v9/organizations/org_alpha/memberships/user_beta',
+    '/v9/organizations/org_alpha/memberships/user_beta',
+  ]);
+  expect(requests.map(x => x.options.method)).toEqual(['POST', 'PATCH', 'DELETE']);
+  expect(requests[0].options.body).toEqual({ user_id: 'user_beta', role: 'basic_member' });
+  expect(requests[1].options.body).toEqual({ role: 'admin' });
+  expect(requests[2].options.body).toBeUndefined();
+  for (const result of [created, updated, deleted]) {
+    expect(result).toBeInstanceOf((BackendResources as any).OrganizationMembership);
+  }
+});
+
+test('lists invitations with pagination and converts invitation resources', async () => {
+  const { client, requests } = makeClient(() => [invitationJSON]);
+  const list = method(client, 'getOrganizationInvitationList');
+
+  const paged = await list({ organizationId: 'org_alpha', limit: 6, offset: 7 });
+  const unpaged = await list({ organizationId: 'org_delta' });
+
+  expect(requests.map(requestPath)).toEqual([
+    '/v9/organizations/org_alpha/invitations',
+    '/v9/organizations/org_delta/invitations',
+  ]);
+  expect(requestQuery(requests[0])).toEqual({ limit: '6', offset: '7' });
+  expect(new URL(requests[1].url).search).toBe('');
+  expect(requests[0].options.method).toBe('GET');
+
+  const invitation = paged[0];
+  expect(invitation).toBeInstanceOf((BackendResources as any).OrganizationInvitation);
+  expect(invitation).toMatchObject({
+    id: 'orginv_gamma',
+    organizationId: 'org_alpha',
+    emailAddress: 'gamma@example.test',
+    role: 'basic_member',
+    status: 'pending',
+    createdAt: 1640000005,
+    updatedAt: 1640000006,
+  });
+  expect(invitation).not.toHaveProperty('serverOnly');
+  expect(unpaged[0]).toBeInstanceOf((BackendResources as any).OrganizationInvitation);
+});
+
+test('creates and revokes invitations while omitting an absent redirect URL', async () => {
+  const { client, requests } = makeClient(() => invitationJSON);
+  const create = method(client, 'createOrganizationInvitation');
+
+  const withRedirect = await create({
+    organizationId: 'org_alpha',
+    emailAddress: 'gamma@example.test',
+    role: 'admin',
+    redirectUrl: 'https://app.test/welcome',
+  });
+  const withoutRedirect = await create({
+    organizationId: 'org_delta',
+    emailAddress: 'delta@example.test',
+    role: 'basic_member',
+  });
+  const revoked = await method(client, 'revokeOrganizationInvitation')({
+    organizationId: 'org_alpha',
+    invitationId: 'orginv_gamma',
+  });
+
+  expect(requests.map(requestPath)).toEqual([
+    '/v9/organizations/org_alpha/invitations',
+    '/v9/organizations/org_delta/invitations',
+    '/v9/organizations/org_alpha/invitations/orginv_gamma/revoke',
+  ]);
+  expect(requests.map(x => x.options.method)).toEqual(['POST', 'POST', 'POST']);
+  expect(requests[0].options.body).toEqual({
+    email_address: 'gamma@example.test',
+    role: 'admin',
+    redirect_url: 'https://app.test/welcome',
+  });
+  expect(requests[1].options.body).toEqual({
+    email_address: 'delta@example.test',
+    role: 'basic_member',
+  });
+  expect(requests[1].options.body).not.toHaveProperty('redirect_url');
+  for (const result of [withRedirect, withoutRedirect, revoked]) {
+    expect(result).toBeInstanceOf((BackendResources as any).OrganizationInvitation);
+  }
+});
+
+test('rejects missing organization IDs before making a request', async () => {
+  const { client, requests } = makeClient(() => organizationJSON);
+  const cases: Array<[string, any[]]> = [
+    ['getOrganization', ['']],
+    ['updateOrganization', ['', { name: 'No request' }]],
+    ['deleteOrganization', ['']],
+    ['getOrganizationMembershipList', [{ organizationId: '' }]],
+    [
+      'createOrganizationMembership',
+      [{ organizationId: '', userId: 'user_beta', role: 'admin' }],
+    ],
+    [
+      'updateOrganizationMembership',
+      [{ organizationId: '', userId: 'user_beta', role: 'basic_member' }],
+    ],
+    ['deleteOrganizationMembership', [{ organizationId: '', userId: 'user_beta' }]],
+    ['getOrganizationInvitationList', [{ organizationId: '' }]],
+    [
+      'createOrganizationInvitation',
+      [{ organizationId: '', emailAddress: 'gamma@example.test', role: 'admin' }],
+    ],
+    ['revokeOrganizationInvitation', [{ organizationId: '', invitationId: 'orginv_gamma' }]],
+  ];
+
+  for (const [name, args] of cases) {
+    await expect(Promise.resolve().then(() => method(client, name)(...args))).rejects.toThrow(
+      'A valid ID is required.',
+    );
+  }
+  expect(requests).toHaveLength(0);
+});
+
+test('rejects missing user and invitation IDs independently before making a request', async () => {
+  const { client, requests } = makeClient(() => organizationJSON);
+  const cases: Array<[string, any[]]> = [
+    [
+      'createOrganizationMembership',
+      [{ organizationId: 'org_alpha', userId: '', role: 'admin' }],
+    ],
+    [
+      'updateOrganizationMembership',
+      [{ organizationId: 'org_alpha', userId: '', role: 'basic_member' }],
+    ],
+    ['deleteOrganizationMembership', [{ organizationId: 'org_alpha', userId: '' }]],
+    ['revokeOrganizationInvitation', [{ organizationId: 'org_alpha', invitationId: '' }]],
+  ];
+
+  for (const [name, args] of cases) {
+    await expect(Promise.resolve().then(() => method(client, name)(...args))).rejects.toThrow(
+      'A valid ID is required.',
+    );
+  }
+  expect(requests).toHaveLength(0);
+});
