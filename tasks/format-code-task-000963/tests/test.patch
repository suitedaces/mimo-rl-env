@@ -0,0 +1,79 @@
+import {
+  ClerkBackendAPI,
+  Organization,
+  OrganizationInvitation,
+  OrganizationMembership,
+} from '../index';
+
+declare const client: ClerkBackendAPI;
+
+async function organizationAdministrationTypeContract() {
+  const organizations: Organization[] = await client.organizations.getOrganizationList({ limit: 10, offset: 0 });
+  const organization: Organization = await client.organizations.getOrganization('org_1');
+  const updatedOrganization: Organization = await client.organizations.updateOrganization('org_1', { name: 'One' });
+  const deletedOrganization: Organization = await client.organizations.deleteOrganization('org_1');
+
+  const memberships: OrganizationMembership[] = await client.organizations.getOrganizationMembershipList({
+    organizationId: 'org_1',
+    limit: 10,
+    offset: 0,
+  });
+  const createdMembership: OrganizationMembership = await client.organizations.createOrganizationMembership({
+    organizationId: 'org_1',
+    userId: 'user_1',
+    role: 'admin',
+  });
+  client.organizations.createOrganizationMembership({
+    organizationId: 'org_1',
+    userId: 'user_1',
+    // @ts-expect-error Membership roles are a closed public union.
+    role: 'owner',
+  });
+  const updatedMembership: OrganizationMembership = await client.organizations.updateOrganizationMembership({
+    organizationId: 'org_1',
+    userId: 'user_1',
+    role: 'basic_member',
+  });
+  const deletedMembership: OrganizationMembership = await client.organizations.deleteOrganizationMembership({
+    organizationId: 'org_1',
+    userId: 'user_1',
+  });
+
+  const invitations: OrganizationInvitation[] = await client.organizations.getOrganizationInvitationList({
+    organizationId: 'org_1',
+    limit: 10,
+    offset: 0,
+  });
+  const invitation: OrganizationInvitation = await client.organizations.createOrganizationInvitation({
+    organizationId: 'org_1',
+    emailAddress: 'member@example.test',
+    role: 'admin',
+    redirectUrl: 'https://app.example.test/welcome',
+  });
+  client.organizations.createOrganizationInvitation({
+    organizationId: 'org_1',
+    emailAddress: 'member@example.test',
+    // @ts-expect-error Invitation roles use the same closed public union.
+    role: 'owner',
+  });
+  const revokedInvitation: OrganizationInvitation = await client.organizations.revokeOrganizationInvitation({
+    organizationId: 'org_1',
+    invitationId: 'orginv_1',
+  });
+
+  return {
+    organizations,
+    organization,
+    updatedOrganization,
+    deletedOrganization,
+    memberships,
+    createdMembership,
+    updatedMembership,
+    deletedMembership,
+    invitations,
+    invitation,
+    revokedInvitation,
+  };
+}
+
+void organizationAdministrationTypeContract;
