diff --git a/pandas/tests/tools/test_to_numeric.py b/pandas/tests/tools/test_to_numeric.py
index 643a5617ab..e10f22e717 100644
--- a/pandas/tests/tools/test_to_numeric.py
+++ b/pandas/tests/tools/test_to_numeric.py
@@ -789,3 +789,88 @@ def test_to_numeric_scientific_notation():
     result = to_numeric("1.7e+308")
     expected = np.float64(1.7e308)
     assert result == expected
+
+
+
+
+
+
+
+
+def test_to_numeric_downcast_float_precision_loss_large_int_series():
+
+
+    result = to_numeric(Series([608202549]), downcast="float")
+    expected = Series([608202549.0], dtype=np.float64)
+    tm.assert_series_equal(result, expected)
+
+
+def test_to_numeric_downcast_float_precision_loss_large_float_series():
+
+    result = to_numeric(Series([608202549.0]), downcast="float")
+    expected = Series([608202549.0], dtype=np.float64)
+    tm.assert_series_equal(result, expected)
+
+
+def test_to_numeric_downcast_float_precision_loss_list():
+
+    result = to_numeric([608202548, 608202549], downcast="float")
+    expected = np.array([608202548.0, 608202549.0], dtype=np.float64)
+    tm.assert_numpy_array_equal(result, expected)
+
+
+def test_to_numeric_downcast_float_at_16777216_boundary():
+
+
+    result = to_numeric(Series([16777216]), downcast="float")
+    expected = Series([16777216.0], dtype=np.float32)
+    tm.assert_series_equal(result, expected)
+
+
+def test_to_numeric_downcast_float_at_16777217_boundary():
+
+
+    result = to_numeric(Series([16777217]), downcast="float")
+    expected = Series([16777217.0], dtype=np.float64)
+    tm.assert_series_equal(result, expected)
+
+
+def test_to_numeric_downcast_float_small_loss_still_downcasts():
+
+
+    result = to_numeric(Series([1000.1]), downcast="float")
+    assert result.dtype == np.float32
+
+    tm.assert_numpy_array_equal(
+        result.to_numpy(), np.array([1000.1], dtype=np.float32)
+    )
+
+
+def test_to_numeric_downcast_float_small_ints_preserved():
+
+    result = to_numeric(Series([1, 2, 3]), downcast="float")
+    expected = Series([1.0, 2.0, 3.0], dtype=np.float32)
+    tm.assert_series_equal(result, expected)
+
+
+def test_to_numeric_downcast_float_small_floats_preserved():
+
+    result = to_numeric(Series([1.5, 2.5, 3.5]), downcast="float")
+    expected = Series([1.5, 2.5, 3.5], dtype=np.float32)
+    tm.assert_series_equal(result, expected)
+
+
+def test_to_numeric_downcast_float_with_nan():
+
+    result = to_numeric(Series([np.nan, 1.0, 2.0]), downcast="float")
+    assert result.dtype == np.float32
+    assert np.isnan(result.iloc[0])
+    assert result.iloc[1] == 1.0
+    assert result.iloc[2] == 2.0
+
+
+def test_to_numeric_downcast_float_scalar_unchanged():
+
+
+    result = to_numeric(608202549, downcast="float")
+    assert result == 608202549
