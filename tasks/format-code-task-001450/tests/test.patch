+						"fields": {
+							Nesting: configschema.NestingList,
+							Block: configschema.Block{
+								Attributes: map[string]*configschema.Attribute{
+									"name":  {Type: cty.String, Optional: true},
+									"value": {Type: cty.String, Optional: true, Sensitive: true},
+								},
+							},
+						},
+					},
+				},
+			},
+		},
+	}
+
+	planned := cty.ObjectVal(map[string]cty.Value{
+		"configuration": cty.ListVal([]cty.Value{
+			cty.ObjectVal(map[string]cty.Value{
+				"fields": cty.ListVal([]cty.Value{
+					cty.ObjectVal(map[string]cty.Value{
+						"name":  cty.StringVal("Password"),
+						"value": cty.StringVal("planned-secret"),
+					}),
+				}).Mark("sensitive"),
+			}),
+		}),
+	})
+	actual := cty.ObjectVal(map[string]cty.Value{
+		"configuration": cty.ListVal([]cty.Value{
+			cty.ObjectVal(map[string]cty.Value{
+				"fields": cty.ListVal([]cty.Value{
+					cty.ObjectVal(map[string]cty.Value{
+						"name":  cty.StringVal("Password"),
+						"value": cty.StringVal("actual-secret"),
+					}),
+				}).Mark("sensitive"),
+			}),
+		}),
+	})
+
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("AssertObjectCompatible panicked: %v", r)
+		}
+	}()
+
+
+	_ = AssertObjectCompatible(schema, planned, actual)
+}
