+func TestAssertObjectCompatible_sensitiveNestedListBlock(t *testing.T) {
+	schema := &configschema.Block{
+		BlockTypes: map[string]*configschema.NestedBlock{
+			"configuration": {
+				Nesting: configschema.NestingList,
+				Block: configschema.Block{
+					BlockTypes: map[string]*configschema.NestedBlock{
+						"fields": {
+							Nesting: configschema.NestingList,
+							Block: configschema.Block{
+								Attributes: map[string]*configschema.Attribute{
+									"name":  {Type: cty.String, Optional: true},
+									"value": {Type: cty.String, Optional: true, Sensitive: true},
+								},
+							},
+						},
+					},
+				},
+			},
+		},
+	}
+
+	val := cty.ObjectVal(map[string]cty.Value{
+		"configuration": cty.ListVal([]cty.Value{
+			cty.ObjectVal(map[string]cty.Value{
+				"fields": cty.ListVal([]cty.Value{
+					cty.ObjectVal(map[string]cty.Value{
+						"name":  cty.StringVal("Password"),
+						"value": cty.StringVal("secret"),
+					}),
+				}).Mark("sensitive"),
+			}),
+		}),
+	})
+
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("AssertObjectCompatible panicked on sensitive nested list block: %v", r)
+		}
+	}()
+
+	errs := AssertObjectCompatible(schema, val, val)
+	if len(errs) != 0 {
+		t.Fatalf("expected no errors when planned and actual are identical; got: %v", errs)
+	}
+}
