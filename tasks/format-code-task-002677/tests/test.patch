diff --git a/core/networking/peerstore_test.go b/core/networking/peerstore_test.go
new file mode 100644
index 0000000000..847f2cc415
--- /dev/null
+++ b/core/networking/peerstore_test.go
@@ -0,0 +1,99 @@
+package networking_test
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+	"time"
+
+	p2ppeer "github.com/libp2p/go-libp2p-core/peer"
+	ma "github.com/multiformats/go-multiaddr"
+	"github.com/smartcontractkit/chainlink/core/internal/cltest"
+	"github.com/smartcontractkit/chainlink/core/networking"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNewPeerstorePersistsPeerDataAcrossReconstruction(t *testing.T) {
+	_, orm, cleanup := cltest.BootstrapThrowawayORM(t, "peerstore_addr", true)
+	defer cleanup()
+	db := orm.DB.DB()
+	ctx := context.Background()
+
+	first, err := networking.NewPeerstore(ctx, db)
+	require.NoError(t, err)
+	peerID := mustPeerID(t, "12D3KooWL1yndUw9T2oWXjhfjdwSscWA78YCpUdduA3Cnn4dCtph")
+	addr := mustMultiaddr(t, "/ip4/127.0.0.1/tcp/12000/p2p/12D3KooWL1yndUw9T2oWXjhfjdwSscWA78YCpUdduA3Cnn4dCtph")
+
+	first.AddAddr(peerID, addr, time.Hour)
+	require.GreaterOrEqual(t, peerstoreRowCount(t, db), 1)
+
+	second, err := networking.NewPeerstore(ctx, db)
+	require.NoError(t, err)
+	require.Contains(t, peerIDsAsStrings(second.Peers()), peerID.String())
+	require.Contains(t, multiaddrsAsStrings(second.Addrs(peerID)), addr.String())
+}
+
+func TestNewPeerstorePersistsProtocolsAcrossReconstruction(t *testing.T) {
+	_, orm, cleanup := cltest.BootstrapThrowawayORM(t, "peerstore_protocols", true)
+	defer cleanup()
+	db := orm.DB.DB()
+	ctx := context.Background()
+
+	first, err := networking.NewPeerstore(ctx, db)
+	require.NoError(t, err)
+	peerID := mustPeerID(t, "12D3KooWPCUQczn5M34VZvj6kMkyWkYqM2seFxF6cE2bSwjfRRr2")
+	protocols := []string{
+		"/chainlink/ocr/1.0.0",
+		"/chainlink/ocr/2.0.0",
+	}
+
+	require.NoError(t, first.AddProtocols(peerID, protocols...))
+	require.GreaterOrEqual(t, peerstoreRowCount(t, db), 1)
+
+	second, err := networking.NewPeerstore(ctx, db)
+	require.NoError(t, err)
+	got, err := second.GetProtocols(peerID)
+	require.NoError(t, err)
+	require.Contains(t, got, protocols[0])
+	require.Contains(t, got, protocols[1])
+}
+
+func peerstoreRowCount(t *testing.T, db *sql.DB) int {
+	t.Helper()
+
+	var count int
+	require.NoError(t, db.QueryRow(`SELECT COUNT(*) FROM p2p_peerstore`).Scan(&count))
+	return count
+}
+
+func mustPeerID(t *testing.T, value string) p2ppeer.ID {
+	t.Helper()
+
+	peerID, err := p2ppeer.Decode(value)
+	require.NoError(t, err)
+	return peerID
+}
+
+func mustMultiaddr(t *testing.T, value string) ma.Multiaddr {
+	t.Helper()
+
+	addr, err := ma.NewMultiaddr(value)
+	require.NoError(t, err)
+	return addr
+}
+
+func peerIDsAsStrings(peers []p2ppeer.ID) []string {
+	values := make([]string, 0, len(peers))
+	for _, peerID := range peers {
+		values = append(values, peerID.String())
+	}
+	return values
+}
+
+func multiaddrsAsStrings(addrs []ma.Multiaddr) []string {
+	values := make([]string, 0, len(addrs))
+	for _, addr := range addrs {
+		values = append(values, addr.String())
+	}
+	return values
+}
diff --git a/core/store/migrations/p2p_peerstore_test.go b/core/store/migrations/p2p_peerstore_test.go
