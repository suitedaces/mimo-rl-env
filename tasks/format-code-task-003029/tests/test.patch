--- a/test/validation.js
+++ b/test/validation.js
@@ -560,6 +560,71 @@ describe('validation tests', function () {
         })
         .argv
     })
+
+
+    it('correctly populates positional after command without extra args (regression)', function () {
+      var handlerCalled = false
+      var argv = yargs('command foo')
+        .command('command <param>', 'sub-command', function (y) { return y }, function (args) {
+          handlerCalled = true
+          args.param.should.equal('foo')
+        })
+        .strict()
+        .fail(function (msg) {
+          expect.fail(null, null, 'should not fail: ' + msg)
+        })
+        .argv
+      handlerCalled.should.equal(true)
+      argv.param.should.equal('foo')
+    })
+
+
+    it('fails in strict mode when extra arg precedes the command', function (done) {
+      yargs('imposter command foo')
+        .command('command <param>', 'sub-command', function (y) { return y }, function (args) {
+          expect.fail(null, null, 'handler should not be called with param=' + args.param)
+        })
+        .strict()
+        .fail(function (msg) {
+          msg.should.match(/imposter/)
+          return done()
+        })
+        .argv
+    })
+
+
+    it('does not treat extra preceding arg as the command (non-strict)', function () {
+      var capturedParam
+      var argv = yargs('imposter command foo')
+        .command('command <param>', 'sub-command', function (y) { return y }, function (args) {
+          capturedParam = args.param
+        })
+        .argv
+
+
+      expect(capturedParam).to.not.equal('command')
+      expect(argv.param).to.not.equal('command')
+
+
+
+      argv._.should.include('imposter')
+    })
+
+
+    it('fails in strict mode when extra arg precedes a nested sub-command', function (done) {
+      yargs('parent imposter child arg')
+        .command('parent', 'parent command', function (y) {
+          return y.command('child <p>', 'child command', function (yy) { return yy }, function (args) {
+            expect.fail(null, null, 'child handler should not be called')
+          })
+        })
+        .strict()
+        .fail(function (msg) {
+          msg.should.match(/imposter/)
+          return done()
+        })
+        .argv
+    })
   })
 
