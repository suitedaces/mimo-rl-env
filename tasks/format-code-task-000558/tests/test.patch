diff --git a/tests/adapters/api/gsheets/fields_test.py b/tests/adapters/api/gsheets/fields_test.py
index d6a041f..87c0604 100644
--- a/tests/adapters/api/gsheets/fields_test.py
+++ b/tests/adapters/api/gsheets/fields_test.py
@@ -217,5 +217,41 @@ def test_GSheetsString() -> None:
     assert GSheetsString().format("test") == "test"
 
     assert GSheetsString().quote(None) == "null"
-    assert GSheetsString().quote("") == "null"
+    assert GSheetsString().quote("") == "''"
     assert GSheetsString().quote("test") == "'test'"
+
+
+def test_GSheetsString_quote_empty_string_not_null() -> None:
+    """
+    Empty strings must be quoted as ``''`` (the empty SQL literal), NOT as
+    ``null``. Previously, quoting ``""`` returned ``"null"`` which produced
+    invalid GSheets queries like ``WHERE country != null`` and triggered
+    ``Invalid query: NO_COLUMN: null``.
+    """
+    assert GSheetsString().quote("") == "''"
+
+    assert GSheetsString().quote(None) == "null"
+
+    assert GSheetsString().quote("hello") == "'hello'"
+
+
+def test_GSheetsString_build_sql_not_equal_empty_string() -> None:
+    """
+    ``WHERE country != ''`` must produce a SQL fragment that compares
+    against the empty string literal, not against ``null`` and not using
+    ``IS NOT NULL`` (which has different semantics).
+    """
+    from shillelagh.filters import Equal, NotEqual
+    from shillelagh.lib import build_sql
+
+    columns = {"country": GSheetsString()}
+
+    sql = build_sql(columns, {"country": NotEqual("")}, [])
+    assert sql == "SELECT * WHERE country != ''"
+
+    sql = build_sql(columns, {"country": Equal("")}, [])
+    assert sql == "SELECT * WHERE country = ''"
+
+
+    sql = build_sql(columns, {"country": NotEqual("BR")}, [])
+    assert sql == "SELECT * WHERE country != 'BR'"
