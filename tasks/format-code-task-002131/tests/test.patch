+++ b/src/openapi-formats.test.ts
@@ -0,0 +1,219 @@
+import { OpenAPIValidator } from './index';
+
+const headers = { accept: 'application/json' };
+
+const meta = {
+  openapi: '3.0.0',
+  info: {
+    title: 'api',
+    version: '1.0.0',
+  },
+};
+
+
+function captureWarn<T>(fn: () => T): { result: T; warn: jest.Mock } {
+  const origWarn = console.warn;
+  const mock = jest.fn();
+  console.warn = mock;
+  try {
+    const result = fn();
+    return { result, warn: mock };
+  } finally {
+    console.warn = origWarn;
+  }
+}
+
+describe('OpenAPI default formats', () => {
+  describe('issue reproduction (int32 + byte in requestBody)', () => {
+    const buildPaths = () => ({
+      '/foo': {
+        post: {
+          operationId: 'foo',
+          responses: { 200: { description: 'ok' } },
+          requestBody: {
+            content: {
+              'application/json': {
+                schema: {
+                  type: 'object',
+                  properties: {
+                    foo: { type: 'integer', format: 'int32' },
+                    bar: { type: 'string', format: 'byte' },
+                  },
+                },
+              },
+            },
+          },
+        },
+      },
+    });
+
+    test('constructor does not warn about int32 or byte formats', () => {
+      const { result, warn } = captureWarn(
+        () => new OpenAPIValidator({ definition: { ...meta, paths: buildPaths() } as any }),
+      );
+      expect(result).toBeInstanceOf(OpenAPIValidator);
+      expect(warn).not.toHaveBeenCalled();
+    });
+
+    test('valid int32 + valid base64 byte passes validation', () => {
+      const validator = new OpenAPIValidator({ definition: { ...meta, paths: buildPaths() } as any });
+      const valid = validator.validateRequest({
+        path: '/foo',
+        method: 'post',
+        headers: { ...headers, 'content-type': 'application/json' },
+        body: { foo: 100, bar: 'aGVsbG8=' },
+      });
+      expect(valid.errors).toBeFalsy();
+    });
+
+    test('integer larger than int32 max fails validation (signed 32-bit range enforced)', () => {
+      const validator = new OpenAPIValidator({ definition: { ...meta, paths: buildPaths() } as any });
+      const valid = validator.validateRequest({
+        path: '/foo',
+        method: 'post',
+        headers: { ...headers, 'content-type': 'application/json' },
+        body: { foo: 9999999999, bar: 'aGVsbG8=' },
+      });
+      expect(valid.valid).toBe(false);
+      expect(valid.errors).toBeTruthy();
+      expect(valid.errors!.some((e) => e.keyword === 'format' && (e.params as any).format === 'int32')).toBe(true);
+    });
+
+    test('non-base64 string fails byte format validation', () => {
+      const validator = new OpenAPIValidator({ definition: { ...meta, paths: buildPaths() } as any });
+      const valid = validator.validateRequest({
+        path: '/foo',
+        method: 'post',
+        headers: { ...headers, 'content-type': 'application/json' },
+        body: { foo: 1, bar: 'not!base64!' },
+      });
+      expect(valid.valid).toBe(false);
+      expect(valid.errors).toBeTruthy();
+      expect(valid.errors!.some((e) => e.keyword === 'format' && (e.params as any).format === 'byte')).toBe(true);
+    });
+  });
+
+  describe('all OpenAPI 3.0 formats register without warnings', () => {
+    const formatPath = (
+      type: 'integer' | 'number' | 'string',
+      format: string,
+    ) => ({
+      '/x': {
+        post: {
+          operationId: `op_${format}`,
+          responses: { 200: { description: 'ok' } },
+          requestBody: {
+            content: {
+              'application/json': {
+                schema: {
+                  type: 'object',
+                  properties: { x: { type, format } as any },
+                },
+              },
+            },
+          },
+        },
+      },
+    });
+
+    test.each([
+      ['integer', 'int32'],
+      ['integer', 'int64'],
+      ['number', 'float'],
+      ['number', 'double'],
+      ['string', 'byte'],
+      ['string', 'binary'],
+      ['string', 'password'],
+    ])('format %s/%s does not produce a console.warn', (type, format) => {
+      const { result, warn } = captureWarn(
+        () =>
+          new OpenAPIValidator({
+            definition: { ...meta, paths: formatPath(type as any, format) } as any,
+          }),
+      );
+      expect(result).toBeInstanceOf(OpenAPIValidator);
+      expect(warn).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('int64 numeric range', () => {
+    const buildPaths = () => ({
+      '/n': {
+        post: {
+          operationId: 'opInt64',
+          responses: { 200: { description: 'ok' } },
+          requestBody: {
+            content: {
+              'application/json': {
+                schema: {
+                  type: 'object',
+                  properties: {
+                    n: { type: 'integer', format: 'int64' },
+                  },
+                },
+              },
+            },
+          },
+        },
+      },
+    });
+
+    test('int64 in range passes', () => {
+      const validator = new OpenAPIValidator({ definition: { ...meta, paths: buildPaths() } as any });
+      const valid = validator.validateRequest({
+        path: '/n',
+        method: 'post',
+        headers: { ...headers, 'content-type': 'application/json' },
+        body: { n: 1234567890 },
+      });
+      expect(valid.errors).toBeFalsy();
+    });
+  });
+
+  describe('byte format validation', () => {
+    const buildPaths = () => ({
+      '/b': {
+        post: {
+          operationId: 'opByte',
+          responses: { 200: { description: 'ok' } },
+          requestBody: {
+            content: {
+              'application/json': {
+                schema: {
+                  type: 'object',
+                  properties: {
+                    b: { type: 'string', format: 'byte' },
+                  },
+                },
+              },
+            },
+          },
+        },
+      },
+    });
+
+    test('valid base64 string passes', () => {
+      const validator = new OpenAPIValidator({ definition: { ...meta, paths: buildPaths() } as any });
+      const valid = validator.validateRequest({
+        path: '/b',
+        method: 'post',
+        headers: { ...headers, 'content-type': 'application/json' },
+        body: { b: 'YWJjZA==' },
+      });
+      expect(valid.errors).toBeFalsy();
+    });
+
+    test('string with non-base64 chars fails', () => {
+      const validator = new OpenAPIValidator({ definition: { ...meta, paths: buildPaths() } as any });
+      const valid = validator.validateRequest({
+        path: '/b',
+        method: 'post',
+        headers: { ...headers, 'content-type': 'application/json' },
+        body: { b: '!!!not-base64!!!' },
+      });
+      expect(valid.valid).toBe(false);
+      expect(valid.errors).toBeTruthy();
+      expect(valid.errors!.some((e) => e.keyword === 'format' && (e.params as any).format === 'byte')).toBe(true);
+    });
+  });
+});
