+func TestFormatDoesNotWriteFilesInWorkingDirectory(t *testing.T) {
+	root := t.TempDir()
+	original, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := os.Chdir(original); err != nil {
+			t.Fatalf("failed to restore working directory: %v", err)
+		}
+	})
+	if err := os.Chdir(root); err != nil {
+		t.Fatal(err)
+	}
+	before := listRelativeEntries(t, root)
+
+	out := proxy.NewEntityFormatter(&config.Backend{Target: "profile"}).Format(proxy.Response{
+		Data:       map[string]interface{}{"profile": map[string]interface{}{"name": "Ada"}},
+		IsComplete: true,
+	})
+
+	after := listRelativeEntries(t, root)
+	expectedOut := proxy.Response{Data: map[string]interface{}{"name": "Ada"}, IsComplete: true}
+	if !reflect.DeepEqual(expectedOut, out) {
+		t.Fatalf("unexpected output during side-effect check:\nexpected %#v\nactual   %#v", expectedOut, out)
+	}
+	if !reflect.DeepEqual(before, after) {
+		t.Fatalf("Format wrote to the working directory:\nbefore %#v\nafter  %#v", before, after)
+	}
+}
+
+func deepCopyResponse(in proxy.Response) proxy.Response {
+	out := in
+	out.Data = deepCopyMap(in.Data)
+	out.Metadata.Headers = deepCopyStringSlices(in.Metadata.Headers)
+	return out
+}
+
+func deepCopyMap(in map[string]interface{}) map[string]interface{} {
+	if in == nil {
+		return nil
+	}
+	out := make(map[string]interface{}, len(in))
+	for k, v := range in {
+		out[k] = deepCopyValue(v)
+	}
+	return out
+}
+
+func deepCopyValue(v interface{}) interface{} {
+	switch typed := v.(type) {
+	case map[string]interface{}:
+		return deepCopyMap(typed)
+	case []interface{}:
+		out := make([]interface{}, len(typed))
+		for i, item := range typed {
+			out[i] = deepCopyValue(item)
+		}
+		return out
+	default:
+		return typed
+	}
+}
+
+func deepCopyStringSlices(in map[string][]string) map[string][]string {
+	if in == nil {
+		return nil
+	}
+	out := make(map[string][]string, len(in))
+	for k, v := range in {
+		out[k] = append([]string(nil), v...)
+	}
+	return out
+}
+
+func listRelativeEntries(t *testing.T, root string) []string {
+	t.Helper()
+	var entries []string
+	err := filepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if path == root {
+			return nil
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		entries = append(entries, rel)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sort.Strings(entries)
+	return entries
+}
