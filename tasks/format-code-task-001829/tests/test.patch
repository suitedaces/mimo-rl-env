+func TestFormatHasNoObservableGlobalStateAcrossNoiseCalls(t *testing.T) {
+	backend := &config.Backend{Target: "profile"}
+	formatter := proxy.NewEntityFormatter(backend)
+	base := proxy.Response{Data: map[string]interface{}{"profile": map[string]interface{}{"name": "Ada", "active": true}}, IsComplete: true}
+
+	first := formatter.Format(deepCopyResponse(base))
+	_ = formatter.Format(proxy.Response{Data: map[string]interface{}{"payload": map[string]interface{}{"debug": true}}, IsComplete: false})
+	_ = proxy.NewEntityFormatter(&config.Backend{Target: "payload.user"}).Format(proxy.Response{Data: map[string]interface{}{"payload": map[string]interface{}{"user": map[string]interface{}{"name": "Grace"}}}, IsComplete: true})
+	again := formatter.Format(deepCopyResponse(base))
+
+	expected := proxy.Response{Data: map[string]interface{}{"name": "Ada", "active": true}, IsComplete: true}
+	if !reflect.DeepEqual(expected, first) || !reflect.DeepEqual(expected, again) {
+		t.Fatalf("format changed across noise calls:\nexpected %#v\nfirst    %#v\nagain    %#v", expected, first, again)
+	}
+}
