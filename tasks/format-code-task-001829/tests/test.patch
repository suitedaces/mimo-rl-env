+func TestJSONConfigKeyTargetPopulatesBackendTarget(t *testing.T) {
+
+
+	parser := config.NewParserWithFileReader(func(_ string) ([]byte, error) {
+		return []byte(`{
+			"version": 3,
+			"name": "target-json",
+			"host": ["http://example.com"],
+			"endpoints": [{
+				"endpoint": "/profile",
+				"backend": [{
+					"host": ["http://example.com"],
+					"url_pattern": "/users",
+					"target": "payload.user"
+				}]
+			}]
+		}`), nil
+	})
+
+	cfg, err := parser.Parse("inline.json")
+	if err != nil {
+		t.Fatalf("unexpected parser error: %v", err)
+	}
+	expected := "payload.user"
+	actual := cfg.Endpoints[0].Backend[0].Target
+	if actual != expected {
+		t.Fatalf("unexpected parsed target: expected %q, got %q", expected, actual)
+	}
+}
