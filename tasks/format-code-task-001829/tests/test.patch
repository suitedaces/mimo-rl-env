+			"payload": map[string]interface{}{"name": "Ada", "secret": "x"},
+			"ignored": true,
+		},
+		IsComplete: true,
+		Metadata:   proxy.Metadata{StatusCode: 202, Headers: map[string][]string{"X-Trace": {"original"}}},
