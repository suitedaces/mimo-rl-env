+func TestFormatIsReferentiallyTransparentForEquivalentInputs(t *testing.T) {
+	backend := &config.Backend{Target: "profile"}
+	formatter := proxy.NewEntityFormatter(backend)
+	response := proxy.Response{
+		Data:       map[string]interface{}{"id": 1, "profile": map[string]interface{}{"name": "Ada", "active": true}},
+		IsComplete: true,
+	}
+
+	first := formatter.Format(deepCopyResponse(response))
+	second := formatter.Format(deepCopyResponse(response))
+	expected := proxy.Response{
+		Data:       map[string]interface{}{"name": "Ada", "active": true},
+		IsComplete: true,
+	}
+	if !reflect.DeepEqual(expected, first) || !reflect.DeepEqual(expected, second) || !reflect.DeepEqual(first, second) {
+		t.Fatalf("format is not referentially transparent:\nexpected %#v\nfirst    %#v\nsecond   %#v", expected, first, second)
+	}
+}
