+	before := deepCopyResponse(response)
+
+	_ = proxy.NewEntityFormatter(backend).Format(response)
+	if !reflect.DeepEqual(before, response) {
+		t.Fatalf("Format mutated caller-owned input:\nbefore %#v\nafter  %#v", before, response)
