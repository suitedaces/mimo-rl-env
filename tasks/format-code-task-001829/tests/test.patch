+func TestTargetRunsBeforeBackendFlatmapAndGroupWrapsAfter(t *testing.T) {
+
+
+	formatter := proxy.NewEntityFormatter(&config.Backend{
+		Target: "payload",
+		Group:  "user",
+		ExtraConfig: config.ExtraConfig{
+			proxy.Namespace: map[string]interface{}{
+				"flatmap_filter": []interface{}{
+					map[string]interface{}{"type": "move", "args": []interface{}{"profile.name", "display_name"}},
+					map[string]interface{}{"type": "append", "args": []interface{}{"roles", "all_roles"}},
+					map[string]interface{}{"type": "del", "args": []interface{}{"secret"}},
+				},
+			},
+		},
+	})
+	out := formatter.Format(proxy.Response{
+		Data: map[string]interface{}{
+			"payload": map[string]interface{}{
+				"profile":   map[string]interface{}{"name": "Ada"},
+				"roles":     []interface{}{"admin"},
+				"all_roles": []interface{}{"reader"},
+				"secret":    "x",
+			},
+			"ignored": true,
+		},
+		IsComplete: true,
+	})
+
+
+
+	user, ok := out.Data["user"].(map[string]interface{})
+	if !ok || len(out.Data) != 1 || !out.IsComplete {
+		t.Fatalf("unexpected grouped response shape: %#v", out)
+	}
+	if user["display_name"] != "Ada" {
+		t.Fatalf("flatmap move did not run against targeted object: %#v", out)
+	}
+	if !reflect.DeepEqual([]interface{}{"reader", "admin"}, user["all_roles"]) {
+		t.Fatalf("flatmap append did not run against targeted object: %#v", out)
+	}
+	if _, ok := user["secret"]; ok {
+		t.Fatalf("flatmap delete did not run against targeted object: %#v", out)
+	}
+}
