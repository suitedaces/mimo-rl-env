+func TestTargetExtractsTopLevelObjectAndPreservesCompletion(t *testing.T) {
+
+
+	formatter := proxy.NewEntityFormatter(&config.Backend{Target: "profile"})
+	out := formatter.Format(proxy.Response{
+		Data: map[string]interface{}{
+			"id":      1,
+			"profile": map[string]interface{}{"name": "Ada", "active": true},
+		},
+		IsComplete: true,
+	})
+
+	expected := proxy.Response{
+		Data:       map[string]interface{}{"name": "Ada", "active": true},
+		IsComplete: true,
+	}
+	if !reflect.DeepEqual(expected, out) {
+		t.Fatalf("unexpected formatted response:\nexpected %#v\nactual   %#v", expected, out)
+	}
+}
