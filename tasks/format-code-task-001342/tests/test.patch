+class ModelParamTraversalCompatTest(absltest.TestCase):
+
+  def test_optim_entry_still_constructs_and_behaves(self):
+    params = {
+        'x': {'scale': 1, 'offset': 2},
+        'y': {'scale': 3, 'offset': 4},
+    }
+    expected = {
+        'x': {'scale': 1, 'offset': 12},
+        'y': {'scale': 3, 'offset': 14},
+    }
+    traversal = optim.ModelParamTraversal(lambda path, _: path.endswith('/offset'))
+
+    self.assertEqual(set(traversal.iterate(params)), {2, 4})
+    self.assertEqual(traversal.update(lambda x: x + 10, params), expected)
+
+    frozen = FrozenDict(params)
+    self.assertEqual(set(traversal.iterate(frozen)), {2, 4})
+    self.assertEqual(traversal.update(lambda x: x + 10, frozen),
+                     FrozenDict(expected))
+
+    model = nn.Model(None, params)
+    expected_model = nn.Model(None, expected)
+    self.assertEqual(set(traversal.iterate(model)), {2, 4})
+    self.assertEqual(traversal.update(lambda x: x + 10, model),
+                     expected_model)
+
