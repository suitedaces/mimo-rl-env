+import copy
+
+from pbxproj import XcodeProject
+
+
+PROJECT_TREE = {
+    "objects": {
+        "PROJ": {"isa": "PBXProject", "buildConfigurationList": "PROJECTCFGS"},
+        "APP": {
+            "isa": "PBXNativeTarget",
+            "name": "app",
+            "buildConfigurationList": "APPCFGS",
+            "buildPhases": ["COMPILE"],
+        },
+        "REPORT": {
+            "isa": "PBXAggregateTarget",
+            "name": "report",
+            "buildConfigurationList": "REPORTCFGS",
+            "buildPhases": ["COMPILE"],
+        },
+        "APPCFGS": {
+            "isa": "XCConfigurationList",
+            "buildConfigurations": ["APPREL", "APPDBG"],
+        },
+        "REPORTCFGS": {
+            "isa": "XCConfigurationList",
+            "buildConfigurations": ["REPORTREL", "REPORTDBG"],
+        },
+        "PROJECTCFGS": {
+            "isa": "XCConfigurationList",
+            "buildConfigurations": ["PROJREL", "PROJDBG"],
+        },
+        "APPREL": {
+            "isa": "XCBuildConfiguration",
+            "name": "Release",
+            "buildSettings": {"base": "a"},
+        },
+        "APPDBG": {"isa": "XCBuildConfiguration", "name": "Debug", "id": "APPDBG"},
+        "REPORTREL": {
+            "isa": "XCBuildConfiguration",
+            "name": "Release",
+            "id": "REPORTREL",
+        },
+        "REPORTDBG": {
+            "isa": "XCBuildConfiguration",
+            "name": "Debug",
+            "id": "REPORTDBG",
+        },
+        "PROJREL": {"isa": "XCBuildConfiguration", "name": "Release", "id": "PROJREL"},
+        "PROJDBG": {
+            "isa": "XCBuildConfiguration",
+            "name": "Debug",
+            "id": "PROJDBG",
+            "buildSettings": {"base": "x"},
+        },
+    },
+    "rootObject": "PROJ",
+}
+
+PROJECT_PBXPROJ = """// !$*UTF8*$!
+{
+    objects = {
+        APP = { isa = PBXNativeTarget; buildConfigurationList = APPCFGS; buildPhases = ( COMPILE, ); name = app; };
+        REPORT = { isa = PBXAggregateTarget; buildConfigurationList = REPORTCFGS; buildPhases = ( COMPILE, ); name = report; };
+        PROJ = { isa = PBXProject; buildConfigurationList = PROJECTCFGS; };
+        APPREL = { isa = XCBuildConfiguration; buildSettings = { base = a; }; name = Release; };
+        APPDBG = { isa = XCBuildConfiguration; id = APPDBG; name = Debug; };
+        REPORTREL = { isa = XCBuildConfiguration; id = REPORTREL; name = Release; };
+        REPORTDBG = { isa = XCBuildConfiguration; id = REPORTDBG; name = Debug; };
+        PROJREL = { isa = XCBuildConfiguration; id = PROJREL; name = Release; };
+        PROJDBG = { isa = XCBuildConfiguration; buildSettings = { base = x; }; id = PROJDBG; name = Debug; };
+        APPCFGS = { isa = XCConfigurationList; buildConfigurations = ( APPREL, APPDBG, ); };
+        PROJECTCFGS = { isa = XCConfigurationList; buildConfigurations = ( PROJREL, PROJDBG, ); };
+        REPORTCFGS = { isa = XCConfigurationList; buildConfigurations = ( REPORTREL, REPORTDBG, ); };
+    };
+    rootObject = PROJ;
+}
+"""
+
+
+def _new_project():
+    return XcodeProject(copy.deepcopy(PROJECT_TREE))
+
+
+def _setting(project, target_name, configuration_name, key):
+    target = project.get_target_by_name(target_name)
+    configuration_list = project.get_object(target.buildConfigurationList)
+    for configuration_id in configuration_list.buildConfigurations:
+        configuration = project.get_object(configuration_id)
+        if configuration.name == configuration_name:
+            build_settings = configuration["buildSettings"]
+            if build_settings is None:
+                return None
+            return build_settings[key]
+    raise AssertionError("configuration not found")
+
+
+def _target_state(project, key):
+    return {
+        "app": {
+            "Release": _setting(project, "app", "Release", key),
+            "Debug": _setting(project, "app", "Debug", key),
+        },
+        "report": {
+            "Release": _setting(project, "report", "Release", key),
+            "Debug": _setting(project, "report", "Debug", key),
+        },
+    }
+
+
+def _values(value):
+    if value is None:
+        return set()
+    if isinstance(value, list):
+        return set(value)
+    return {value}
+
+
+def _assert_target_state(project, key, expected):
+    actual = _target_state(project, key)
+    for target_name, configurations in expected.items():
+        for configuration_name, expected_value in configurations.items():
+
+            assert _values(actual[target_name][configuration_name]) == _values(expected_value)
+
+
+def test_header_search_paths_mutate_all_targets_then_remove():
+
+
+
+
+    project = _new_project()
+
+    assert callable(project.add_header_search_paths)
+
+    project.add_header_search_paths("path/to/search")
+    _assert_target_state(project, "HEADER_SEARCH_PATHS", {
+        "app": {"Release": "path/to/search/**", "Debug": "path/to/search/**"},
+        "report": {"Release": "path/to/search/**", "Debug": "path/to/search/**"},
+    })
+
+    project.add_header_search_paths("path/to/search")
+
+    _assert_target_state(project, "HEADER_SEARCH_PATHS", {
+        "app": {"Release": "path/to/search/**", "Debug": "path/to/search/**"},
+        "report": {"Release": "path/to/search/**", "Debug": "path/to/search/**"},
+    })
+
+    project.remove_header_search_paths("path/to/search/**")
+
+    _assert_target_state(project, "HEADER_SEARCH_PATHS", {
+        "app": {"Release": None, "Debug": None},
+        "report": {"Release": None, "Debug": None},
+    })
+
+
+def test_library_search_paths_filter_target_configuration_and_escape_list():
+
+
+
+
+    project = _new_project()
+
+    assert callable(project.add_library_search_paths)
+
+    project.add_library_search_paths(
+        ["Libraries", "Vendor Libs"],
+        recursive=False,
+        escape=True,
+        target_name="app",
+        configuration_name="Debug",
+    )
+
+    _assert_target_state(project, "LIBRARY_SEARCH_PATHS", {
+        "app": {"Release": None, "Debug": ['"Libraries"', '"Vendor Libs"']},
+        "report": {"Release": None, "Debug": None},
+    })
+
+
+def test_framework_search_paths_loaded_project_formatting_edges(tmp_path):
+
+
+
+
+    project_path = tmp_path / "project.pbxproj"
+    project_path.write_text(PROJECT_PBXPROJ)
+    project = XcodeProject.load(str(project_path))
+
+    project.add_framework_search_paths("Frameworks", recursive=True, escape=True)
+
+    _assert_target_state(project, "FRAMEWORK_SEARCH_PATHS", {
+        "app": {"Release": '"Frameworks"/**', "Debug": '"Frameworks"/**'},
+        "report": {"Release": '"Frameworks"/**', "Debug": '"Frameworks"/**'},
+    })
+
+    project.add_framework_search_paths("$(inherited)", recursive=True, escape=True)
+
+    _assert_target_state(project, "FRAMEWORK_SEARCH_PATHS", {
+        "app": {
+            "Release": ['"Frameworks"/**', "$(inherited)"],
+            "Debug": ['"Frameworks"/**', "$(inherited)"],
+        },
+        "report": {
+            "Release": ['"Frameworks"/**', "$(inherited)"],
+            "Debug": ['"Frameworks"/**', "$(inherited)"],
+        },
+    })
+
+    project.add_framework_search_paths("Already/**", recursive=True, escape=False)
+
+    _assert_target_state(project, "FRAMEWORK_SEARCH_PATHS", {
+        "app": {
+            "Release": ['"Frameworks"/**', "$(inherited)", "Already/**"],
+            "Debug": ['"Frameworks"/**', "$(inherited)", "Already/**"],
+        },
+        "report": {
+            "Release": ['"Frameworks"/**', "$(inherited)", "Already/**"],
+            "Debug": ['"Frameworks"/**', "$(inherited)", "Already/**"],
+        },
+    })
+
+
+def test_remove_methods_respect_filters_for_each_search_path_type():
+
+
+
+
+    project = _new_project()
+    project.add_library_search_paths(
+        ["Libraries", "Vendor Libs"],
+        recursive=False,
+        escape=True,
+        target_name="app",
+        configuration_name="Debug",
+    )
+    project.remove_library_search_paths(
+        '"Libraries"', target_name="app", configuration_name="Debug"
+    )
+
+    _assert_target_state(project, "LIBRARY_SEARCH_PATHS", {
+        "app": {"Release": None, "Debug": '"Vendor Libs"'},
+        "report": {"Release": None, "Debug": None},
+    })
+
+    project.add_framework_search_paths("Frameworks", recursive=True, escape=True)
+    project.remove_framework_search_paths(
+        '"Frameworks"/**', target_name="report", configuration_name="Release"
+    )
+
+    _assert_target_state(project, "FRAMEWORK_SEARCH_PATHS", {
+        "app": {"Release": '"Frameworks"/**', "Debug": '"Frameworks"/**'},
+        "report": {"Release": None, "Debug": '"Frameworks"/**'},
+    })
+
+    project.add_search_paths(
+        "USER_HEADER_SEARCH_PATHS",
+        ["Custom", "Custom/**"],
+        recursive=True,
+        escape=False,
+        target_name=["app", "report"],
+        configuration_name="Release",
+    )
+    project.remove_search_paths(
+        "USER_HEADER_SEARCH_PATHS",
+        ["Custom/**"],
+        target_name="app",
+        configuration_name="Release",
+    )
+
+    _assert_target_state(project, "USER_HEADER_SEARCH_PATHS", {
+        "app": {"Release": None, "Debug": None},
+        "report": {"Release": "Custom/**", "Debug": None},
+    })
+
+
+def test_empty_project_exposes_search_path_helpers():
+
+
+
+
+    project = XcodeProject(tree=None, path=None)
+
+    assert callable(project.add_header_search_paths)
+    assert callable(project.remove_header_search_paths)
+
+
+def test_save_after_mutation_is_repeatable(tmp_path):
+
+
+
+
+    project = _new_project()
+    project.add_header_search_paths("path/to/search")
+    output = tmp_path / "project.pbxproj"
+
+    project.save(str(output))
+    first_text = output.read_text()
+
+    assert first_text.count("HEADER_SEARCH_PATHS") >= 4
+    assert first_text.count("path/to/search/**") >= 4
+
+    project.save(str(output))
+    second_text = output.read_text()
+
+    assert second_text.count("HEADER_SEARCH_PATHS") >= 4
+    assert second_text.count("path/to/search/**") >= 4
+
+
+def test_two_project_instances_keep_independent_search_path_state():
+
+
+
+
+    first = _new_project()
+    second = _new_project()
+
+    first.add_header_search_paths("Headers")
+
+    _assert_target_state(first, "HEADER_SEARCH_PATHS", {
+        "app": {"Release": "Headers/**", "Debug": "Headers/**"},
+        "report": {"Release": "Headers/**", "Debug": "Headers/**"},
+    })
+
+    _assert_target_state(second, "HEADER_SEARCH_PATHS", {
+        "app": {"Release": None, "Debug": None},
+        "report": {"Release": None, "Debug": None},
+    })
+
+    second.add_library_search_paths("Libraries", recursive=False)
+
+    _assert_target_state(first, "LIBRARY_SEARCH_PATHS", {
+        "app": {"Release": None, "Debug": None},
+        "report": {"Release": None, "Debug": None},
+    })
+
+    _assert_target_state(second, "LIBRARY_SEARCH_PATHS", {
+        "app": {"Release": "Libraries", "Debug": "Libraries"},
+        "report": {"Release": "Libraries", "Debug": "Libraries"},
+    })
+
+
+def test_repeated_construct_mutate_remove_cycles():
+
+
+
+
+    observed = []
+    for index in range(150):
+        project = _new_project()
+        project.add_header_search_paths("Headers")
+        project.add_library_search_paths(
+            ["Libraries", "Vendor Libs"],
+            recursive=False,
+            escape=True,
+            target_name="app",
+            configuration_name="Debug",
+        )
+        project.remove_header_search_paths("Headers/**")
+        observed.append(
+            (
+                _target_state(project, "HEADER_SEARCH_PATHS"),
+                _target_state(project, "LIBRARY_SEARCH_PATHS"),
+            )
+        )
+        del project
+
+
+    assert all(
+        all(
+            _values(value) == set()
+            for target in header_state.values()
+            for value in target.values()
+        )
+        and _values(library_state["app"]["Debug"]) == {'"Libraries"', '"Vendor Libs"'}
+        and all(
+            _values(library_state[target_name][configuration_name]) == set()
+            for target_name, configuration_name in (
+                ("app", "Release"),
+                ("report", "Release"),
+                ("report", "Debug"),
+            )
+        )
+        for header_state, library_state in observed
+    )
