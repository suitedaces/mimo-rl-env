+func TestReliabilityContractDeleteFailuresAreFailFast(t *testing.T) {
+	cases := []struct {
+		name, resource string
+		existing       func(*rbacmanagerv1beta1.RBACDefinition) []runtime.Object
+		prepare        func(*rbacmanagerv1beta1.RBACDefinition)
+		laterResource  string
+	}{
+		{
+			name: "service account", resource: "serviceaccounts", laterResource: "clusterrolebindings",
+			existing: func(def *rbacmanagerv1beta1.RBACDefinition) []runtime.Object {
+				return []runtime.Object{
+					&corev1.ServiceAccount{ObjectMeta: metav1.ObjectMeta{Name: "stale-one", Namespace: "bots", Labels: Labels, OwnerReferences: reliabilityOwnerRefs(def)}},
+					&corev1.ServiceAccount{ObjectMeta: metav1.ObjectMeta{Name: "stale-two", Namespace: "bots", Labels: Labels, OwnerReferences: reliabilityOwnerRefs(def)}},
+				}
+			},
+			prepare: func(*rbacmanagerv1beta1.RBACDefinition) {},
+		},
+		{
+			name: "cluster role binding", resource: "clusterrolebindings", laterResource: "rolebindings",
+			existing: func(def *rbacmanagerv1beta1.RBACDefinition) []runtime.Object {
+				return []runtime.Object{reliabilityClusterRoleBinding(def, "stale-one"), reliabilityClusterRoleBinding(def, "stale-two")}
+			},
+			prepare: func(def *rbacmanagerv1beta1.RBACDefinition) { def.RBACBindings[0].ClusterRoleBindings = nil },
+		},
+		{
+			name: "role binding", resource: "rolebindings",
+			existing: func(def *rbacmanagerv1beta1.RBACDefinition) []runtime.Object {
+				return []runtime.Object{
+					reliabilityRoleBinding(def, "apps", "stale-one", def.RBACBindings[0].Subjects),
+					reliabilityRoleBinding(def, "apps", "stale-two", def.RBACBindings[0].Subjects),
+				}
+			},
+			prepare: func(def *rbacmanagerv1beta1.RBACDefinition) { def.RBACBindings[0].ClusterRoleBindings = nil },
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			def := reliabilityDefinition("delete-failure")
+			tc.prepare(def)
+			client := fake.NewSimpleClientset(tc.existing(def)...)
+			cause := errors.New("injected " + tc.resource + " delete failure")
+			client.PrependReactor("delete", tc.resource, func(k8stesting.Action) (bool, runtime.Object, error) {
+				return true, nil, cause
+			})
+
+			err := (&Reconciler{Clientset: client}).Reconcile(def)
+			if !errors.Is(err, cause) {
+				t.Fatalf("got error %v, want cause %v", err, cause)
+			}
+			deletes := 0
+			for _, action := range reliabilityActionsForResource(client, tc.resource) {
+				if action.GetVerb() == "delete" {
+					deletes++
+				}
+				if action.GetVerb() == "create" {
+					t.Fatalf("create followed failed delete for %s", tc.resource)
+				}
+			}
+			if deletes != 1 {
+				t.Fatalf("got %d delete attempts for %s after first failure, want 1", deletes, tc.resource)
+			}
+			if tc.laterResource != "" && len(reliabilityActionsForResource(client, tc.laterResource)) != 0 {
+				t.Fatalf("later resource phase %s ran after failure", tc.laterResource)
+			}
+		})
+	}
+}
