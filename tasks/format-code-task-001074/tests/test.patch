+func TestReliabilityContractSubjectOrderIsIdempotent(t *testing.T) {
+	def := reliabilityDefinition("stable-order")
+	reversed := append([]rbacv1.Subject(nil), def.RBACBindings[0].Subjects...)
+	reversed[0], reversed[1] = reversed[1], reversed[0]
+	existing := reliabilityRoleBinding(def, "apps", "edit", reversed)
+	def.RBACBindings[0].ClusterRoleBindings = nil
+	def.RBACBindings[0].RoleBindings = def.RBACBindings[0].RoleBindings[:1]
+	client := fake.NewSimpleClientset(existing)
+
+	r := Reconciler{Clientset: client}
+	if err := r.Reconcile(def); err != nil {
+		t.Fatalf("reconcile reordered subjects: %v", err)
+	}
+	if got := reliabilityMutationActions(client); len(got) != 0 {
+		t.Fatalf("subject reordering caused API mutations: %#v", got)
+	}
+	client.ClearActions()
+	if err := r.Reconcile(def); err != nil {
+		t.Fatalf("repeat reconcile: %v", err)
+	}
+	if got := reliabilityMutationActions(client); len(got) != 0 {
+		t.Fatalf("repeat reconcile was not idempotent: %#v", got)
+	}
+}
