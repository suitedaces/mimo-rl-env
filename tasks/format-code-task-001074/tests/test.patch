+func TestReliabilityContractControllerReturnsReconcileFailure(t *testing.T) {
+	def := reliabilityDefinition("controller-failure")
+	def.RBACBindings[0].Subjects = []rbacv1.Subject{{Kind: rbacv1.ServiceAccountKind, Name: "robot", Namespace: "bots"}}
+	scheme := runtime.NewScheme()
+	if err := rbacmanagerv1beta1.AddToScheme(scheme); err != nil {
+		t.Fatal(err)
+	}
+	clientset := fake.NewSimpleClientset()
+	cause := errors.New("injected controller create failure")
+	clientset.PrependReactor("create", "serviceaccounts", func(k8stesting.Action) (bool, runtime.Object, error) {
+		return true, nil, cause
+	})
+	controller := &ReconcileRBACDefinition{
+		Client:    clientfake.NewFakeClientWithScheme(scheme, def),
+		clientset: clientset,
+		scheme:    scheme,
+	}
+
+	_, err := controller.Reconcile(reconcile.Request{NamespacedName: types.NamespacedName{Name: def.Name}})
+	if !errors.Is(err, cause) {
+		t.Fatalf("controller returned error %v, want cause %v", err, cause)
