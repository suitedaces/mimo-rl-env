+func TestReliabilityContractForeignOwnerCollisionIsPreservedAndReported(t *testing.T) {
+	def := reliabilityDefinition("owner-collision")
+	def.RBACBindings[0].ClusterRoleBindings = nil
+	def.RBACBindings[0].RoleBindings = def.RBACBindings[0].RoleBindings[:1]
+	existing := reliabilityRoleBinding(def, "apps", "edit", def.RBACBindings[0].Subjects)
+	existing.OwnerReferences[0].UID = types.UID("different-owner-uid")
+	client := fake.NewSimpleClientset(existing)
+
+	err := (&Reconciler{Clientset: client}).Reconcile(def)
+	if err == nil {
+		t.Fatal("expected the same-name foreign-owner collision to be reported")
+	}
+	got, getErr := client.RbacV1().RoleBindings("apps").Get(existing.Name, metav1.GetOptions{})
+	if getErr != nil {
+		t.Fatalf("foreign-owned object was removed: %v", getErr)
+	}
+	if got.OwnerReferences[0].UID != types.UID("different-owner-uid") {
+		t.Fatalf("foreign ownership was changed: %#v", got.OwnerReferences)
+	}
+}
