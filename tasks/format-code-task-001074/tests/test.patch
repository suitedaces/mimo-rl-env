+func reliabilityDefinition(name string) *rbacmanagerv1beta1.RBACDefinition {
+	return &rbacmanagerv1beta1.RBACDefinition{
+		ObjectMeta: metav1.ObjectMeta{Name: name, UID: types.UID(name + "-uid")},
+		RBACBindings: []rbacmanagerv1beta1.RBACBinding{{
+			Name: "operators",
+			Subjects: []rbacv1.Subject{
+				{Kind: rbacv1.UserKind, APIGroup: reliabilityAPIGroup, Name: "alice"},
+				{Kind: rbacv1.GroupKind, APIGroup: reliabilityAPIGroup, Name: "platform"},
+			},
+			ClusterRoleBindings: []rbacmanagerv1beta1.ClusterRoleBinding{{ClusterRole: "admin"}},
+			RoleBindings: []rbacmanagerv1beta1.RoleBinding{
+				{Namespace: "apps", ClusterRole: "edit"},
+				{Namespace: "ops", ClusterRole: "view"},
+			},
+		}},
+	}
+}
+
+func reliabilityOwnerRefs(def *rbacmanagerv1beta1.RBACDefinition) []metav1.OwnerReference {
+	return []metav1.OwnerReference{*metav1.NewControllerRef(def, schema.GroupVersionKind{
+		Group: rbacmanagerv1beta1.SchemeGroupVersion.Group, Version: rbacmanagerv1beta1.SchemeGroupVersion.Version, Kind: "RBACDefinition",
+	})}
+}
+
+func reliabilityRoleBinding(def *rbacmanagerv1beta1.RBACDefinition, namespace, role string, subjects []rbacv1.Subject) *rbacv1.RoleBinding {
+	return &rbacv1.RoleBinding{
+		ObjectMeta: metav1.ObjectMeta{
+			Name: def.Name + "-operators-" + role, Namespace: namespace,
+			Labels: Labels, OwnerReferences: reliabilityOwnerRefs(def),
+		},
+		RoleRef:  rbacv1.RoleRef{Kind: "ClusterRole", Name: role},
+		Subjects: subjects,
+	}
+}
+
+func reliabilityClusterRoleBinding(def *rbacmanagerv1beta1.RBACDefinition, role string) *rbacv1.ClusterRoleBinding {
+	return &rbacv1.ClusterRoleBinding{
+		ObjectMeta: metav1.ObjectMeta{Name: def.Name + "-operators-" + role, Labels: Labels, OwnerReferences: reliabilityOwnerRefs(def)},
+		RoleRef:    rbacv1.RoleRef{Kind: "ClusterRole", Name: role},
+		Subjects:   append([]rbacv1.Subject(nil), def.RBACBindings[0].Subjects...),
+	}
+}
+
+func reliabilityMutationActions(client *fake.Clientset) []k8stesting.Action {
+	var mutations []k8stesting.Action
+	for _, action := range client.Actions() {
+		if action.GetVerb() == "create" || action.GetVerb() == "delete" || action.GetVerb() == "update" || action.GetVerb() == "patch" {
+			mutations = append(mutations, action)
+		}
+	}
+	return mutations
+}
+
+func reliabilityActionsForResource(client *fake.Clientset, resource string) []k8stesting.Action {
+	var matches []k8stesting.Action
+	for _, action := range client.Actions() {
+		if action.GetResource().Resource == resource {
+			matches = append(matches, action)
+		}
+	}
+	return matches
+}
