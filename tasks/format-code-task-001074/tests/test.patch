+	driftedSubjects := append([]rbacv1.Subject(nil), def.RBACBindings[0].Subjects...)
+	driftedSubjects[0].APIGroup = "legacy.example.test"
+	client := fake.NewSimpleClientset(reliabilityRoleBinding(def, "apps", "edit", driftedSubjects))
+
+	if err := (&Reconciler{Clientset: client}).Reconcile(def); err != nil {
+		t.Fatalf("reconcile subject APIGroup drift: %v", err)
+	}
+	got, err := client.RbacV1().RoleBindings("apps").Get(def.Name+"-operators-edit", metav1.GetOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got.Subjects, def.RBACBindings[0].Subjects) {
+		t.Fatalf("subject drift remains: got %#v, want %#v", got.Subjects, def.RBACBindings[0].Subjects)
+	}
+}
