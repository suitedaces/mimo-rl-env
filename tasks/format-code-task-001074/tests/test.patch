+func TestReliabilityContractListFailuresPreserveCauseAndStop(t *testing.T) {
+	cases := []struct {
+		name, resource string
+	}{
+		{name: "service accounts", resource: "serviceaccounts"},
+		{name: "cluster role bindings", resource: "clusterrolebindings"},
+		{name: "role bindings", resource: "rolebindings"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			def := reliabilityDefinition("list-failure")
+			client := fake.NewSimpleClientset()
+			cause := errors.New("injected " + tc.resource + " list failure")
+			client.PrependReactor("list", tc.resource, func(k8stesting.Action) (bool, runtime.Object, error) {
+				return true, nil, cause
+			})
+
+			err := (&Reconciler{Clientset: client}).Reconcile(def)
+			if !errors.Is(err, cause) {
+				t.Fatalf("got error %v, want cause %v", err, cause)
+			}
+			seenFailure := false
+			for _, action := range client.Actions() {
+				if seenFailure {
+					t.Fatalf("API action followed the failing list: %#v", action)
+				}
+				if action.GetVerb() == "list" && action.GetResource().Resource == tc.resource {
+					seenFailure = true
+				}
+			}
+			if !seenFailure {
+				t.Fatalf("failing list action for %s was not observed", tc.resource)
+			}
+			if tc.resource == "rolebindings" {
+				if _, getErr := client.RbacV1().ClusterRoleBindings().Get(def.Name+"-operators-admin", metav1.GetOptions{}); getErr != nil {
+					t.Fatalf("successful earlier phase was rolled back: %v", getErr)
+				}
+			}
+		})
+	}
+}
