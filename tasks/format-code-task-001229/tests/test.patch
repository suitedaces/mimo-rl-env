diff --git a/gammapy/datasets/tests/test_spectrum.py b/gammapy/datasets/tests/test_spectrum.py
index 3e5505cb6..b5a6d10a6 100644
--- a/gammapy/datasets/tests/test_spectrum.py
+++ b/gammapy/datasets/tests/test_spectrum.py
@@ -1154,3 +1154,43 @@ class TestFit:
         profile = fit.stat_profile(datasets=[dataset], parameter="index", values=values)
         actual = values[np.argmin(profile["stat_scan"])]
         assert_allclose(actual, true_idx, rtol=0.01)
+
+
+def _make_npred_signal_dataset():
+    """Build a small SpectrumDataset with two named SkyModels."""
+    e_reco = MapAxis.from_energy_bounds("1 TeV", "10 TeV", nbin=3)
+    geom = RegionGeom(region=None, axes=[e_reco])
+    dataset = SpectrumDataset.create(geom=geom)
+    dataset.exposure.quantity = 1e10 * u.Unit("cm2 h")
+
+    pwl_1 = PowerLawSpectralModel(index=2)
+    pwl_2 = PowerLawSpectralModel(index=3)
+    model_1 = SkyModel(spectral_model=pwl_1, name="m1")
+    model_2 = SkyModel(spectral_model=pwl_2, name="m2")
+    dataset.models = Models([model_1, model_2])
+    dataset.npred_signal()
+    return dataset
+
+
+def test_npred_signal_by_model_name():
+    """User: npred_signal(model_name=name) returns npred for that component."""
+    dataset = _make_npred_signal_dataset()
+    npred_m1 = dataset.npred_signal(model_name="m1")
+    assert_allclose(npred_m1.data.sum(), 32.4)
+
+
+def test_npred_signal_by_model_name_differentiates():
+    """User: different model names produce different npred outputs."""
+    dataset = _make_npred_signal_dataset()
+    npred_m1 = dataset.npred_signal(model_name="m1")
+    npred_m2 = dataset.npred_signal(model_name="m2")
+    assert_allclose(npred_m1.data.sum(), 32.4)
+    assert_allclose(npred_m2.data.sum(), 17.82)
+    assert npred_m1.data.sum() != npred_m2.data.sum()
+
+
+def test_npred_signal_total_preserved():
+    """User: calling npred_signal() with no argument returns total signal counts."""
+    dataset = _make_npred_signal_dataset()
+    npred_total = dataset.npred_signal()
+    assert_allclose(npred_total.data.sum(), 50.22)
