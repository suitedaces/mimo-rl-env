+func TestS3SinkAwaitCompletionIsIdempotentAfterDone(t *testing.T) {
+
+
+	ctx := context.Background()
+	server := newFakeS3Server(nil, 1)
+	defer server.close()
+	sink := connector.NewS3Sink(ctx, server.client(), &connector.S3SinkConfig{
+		Bucket:      "fixture-bucket",
+		Parallelism: 1,
+	}, nil)
+
+	close(sink.In())
