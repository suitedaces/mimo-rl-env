+	"sort"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	awssdk "github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/aws/aws-sdk-go-v2/service/s3"
+	"github.com/reugn/go-streams"
+	connector "github.com/reugn/go-streams/aws"
+	"github.com/reugn/go-streams/flow"
+)
+
+
+
+
+
+
+type listBucketResult struct {
+	XMLName               xml.Name        `xml:"ListBucketResult"`
+	Xmlns                 string          `xml:"xmlns,attr,omitempty"`
+	Name                  string          `xml:"Name"`
+	Prefix                string          `xml:"Prefix"`
+	KeyCount              int             `xml:"KeyCount"`
+	MaxKeys               int             `xml:"MaxKeys"`
+	IsTruncated           bool            `xml:"IsTruncated"`
+	NextContinuationToken string          `xml:"NextContinuationToken,omitempty"`
+	Contents              []objectContent `xml:"Contents"`
+}
+
+type objectContent struct {
+	Key  string `xml:"Key"`
+	Size int    `xml:"Size"`
+}
+
+type fakeS3Server struct {
+	server      *httptest.Server
+	mu          sync.Mutex
+	objects     map[string][]byte
+	putBodies   map[string]string
+	listCalls   []string
+	getCalls    []string
+	putCalls    []string
+	listPageLen int
+	getDelay    time.Duration
+	putDelay    time.Duration
+	activeGets  int
+	maxGets     int
+	activePuts  int
+	maxPuts     int
+}
+
+func newFakeS3Server(initial map[string]string, listPageLen int) *fakeS3Server {
+	f := &fakeS3Server{
+		objects:     make(map[string][]byte),
+		putBodies:   make(map[string]string),
+		listPageLen: listPageLen,
+	}
+	for key, value := range initial {
+		f.objects[key] = []byte(value)
+	}
+	f.server = httptest.NewServer(http.HandlerFunc(f.serveHTTP))
+	return f
+}
+
+func (f *fakeS3Server) close() {
+	f.server.Close()
+}
+
+func (f *fakeS3Server) client() *s3.Client {
+	return s3.New(s3.Options{
+		Region:       "us-east-1",
+		BaseEndpoint: awssdk.String(f.server.URL),
+		UsePathStyle: true,
+		Credentials: awssdk.CredentialsProviderFunc(func(context.Context) (awssdk.Credentials, error) {
+			return awssdk.Credentials{
+				AccessKeyID:     "test-access-key",
+				SecretAccessKey: "test-secret-key",
+				SessionToken:    "test-session-token",
+				Source:          "usercase-test-coderl",
+			}, nil
+		}),
+	})
+}
+
+func (f *fakeS3Server) serveHTTP(w http.ResponseWriter, r *http.Request) {
+	key := strings.TrimPrefix(r.URL.Path, "/fixture-bucket/")
+	switch r.Method {
+	case http.MethodGet:
+		if _, ok := r.URL.Query()["list-type"]; ok {
+			f.handleList(w, r)
+			return
+		}
+		f.handleGet(w, key)
+	case http.MethodPut:
+		f.handlePut(w, r, key)
+	default:
+		http.Error(w, "unsupported method", http.StatusMethodNotAllowed)
+	}
+}
+
+func (f *fakeS3Server) handleList(w http.ResponseWriter, r *http.Request) {
+	prefix := r.URL.Query().Get("prefix")
+	token := r.URL.Query().Get("continuation-token")
+
+	f.mu.Lock()
+	f.listCalls = append(f.listCalls, prefix+"|"+token)
+	keys := make([]string, 0, len(f.objects))
+	for key := range f.objects {
+		if strings.HasPrefix(key, prefix) {
+			keys = append(keys, key)
+		}
+	}
+	sort.Strings(keys)
+
+	start := 0
+	if token != "" {
+		for i, key := range keys {
+			if key == token {
+				start = i + 1
+				break
+			}
+		}
+	}
+	pageLen := f.listPageLen
+	if pageLen < 1 {
+		pageLen = len(keys)
+	}
+	end := start + pageLen
+	if end > len(keys) {
+		end = len(keys)
+	}
+	page := keys[start:end]
+	truncated := end < len(keys)
+	nextToken := ""
+	if truncated {
+		nextToken = page[len(page)-1]
+	}
+
+	result := listBucketResult{
+		Xmlns:       "http://s3.amazonaws.com/doc/2006-03-01/",
+		Name:        "fixture-bucket",
+		Prefix:      prefix,
+		KeyCount:    len(page),
+		MaxKeys:     1000,
+		IsTruncated: truncated,
+	}
+	if truncated {
+		result.NextContinuationToken = nextToken
+	}
+	for _, key := range page {
+		result.Contents = append(result.Contents, objectContent{Key: key, Size: len(f.objects[key])})
+	}
+	f.mu.Unlock()
+
+	w.Header().Set("Content-Type", "application/xml")
+	if err := xml.NewEncoder(w).Encode(result); err != nil {
+		panic(err)
+	}
+}
+
+func (f *fakeS3Server) handleGet(w http.ResponseWriter, key string) {
+	f.mu.Lock()
+	f.activeGets++
+	if f.activeGets > f.maxGets {
+		f.maxGets = f.activeGets
+	}
+	f.getCalls = append(f.getCalls, key)
+	body, ok := f.objects[key]
+	delay := f.getDelay
+	f.mu.Unlock()
+	defer func() {
+		f.mu.Lock()
+		f.activeGets--
+		f.mu.Unlock()
+	}()
+	if delay > 0 {
+		time.Sleep(delay)
+	}
+	if !ok {
+		http.Error(w, "not found", http.StatusNotFound)
+		return
+	}
+	_, _ = w.Write(body)
+}
+
+func (f *fakeS3Server) handlePut(w http.ResponseWriter, r *http.Request, key string) {
+	f.mu.Lock()
+	f.activePuts++
+	if f.activePuts > f.maxPuts {
+		f.maxPuts = f.activePuts
+	}
+	delay := f.putDelay
+	f.mu.Unlock()
+	defer func() {
+		f.mu.Lock()
+		f.activePuts--
+		f.mu.Unlock()
+	}()
+	if delay > 0 {
+		time.Sleep(delay)
+	}
+
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		http.Error(w, "bad body", http.StatusBadRequest)
+		return
+	}
+
+	f.mu.Lock()
+	f.objects[key] = body
+	f.putBodies[key] = string(body)
+	f.putCalls = append(f.putCalls, key)
+	f.mu.Unlock()
+
+	w.Header().Set("Content-Type", "application/xml")
+	_, _ = w.Write([]byte(`<PutObjectResult><ETag>"fixture-etag"</ETag></PutObjectResult>`))
+}
+
+func (f *fakeS3Server) listCallSnapshot() []string {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	out := append([]string(nil), f.listCalls...)
+	return out
+}
+
+func (f *fakeS3Server) getCallSnapshot() []string {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	out := append([]string(nil), f.getCalls...)
+	sort.Strings(out)
+	return out
+}
+
+func (f *fakeS3Server) maxGetActiveSnapshot() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.maxGets
+}
+
+func (f *fakeS3Server) putBodySnapshot() map[string]string {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	out := make(map[string]string, len(f.putBodies))
+	for key, value := range f.putBodies {
+		out[key] = value
+	}
+	return out
+}
+
+func (f *fakeS3Server) maxPutActiveSnapshot() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.maxPuts
+}
+
+func collectSourceObjects(t *testing.T, out <-chan any) []sourceObservation {
+	t.Helper()
+
+	var observations []sourceObservation
+	for value := range out {
+		object, ok := value.(*connector.S3Object)
+		if !ok {
+			t.Fatalf("source emitted %T, want *aws.S3Object", value)
+		}
+		data, err := io.ReadAll(object.Data)
+		if err != nil {
+			t.Fatalf("read emitted object: %v", err)
+		}
+
+		if len(data) < 7 {
+			t.Fatalf("source object %q length = %d, want at least 7 bytes", object.Key, len(data))
+		}
+		observations = append(observations, sourceObservation{
+			Key:    object.Key,
+			Len:    len(data),
+			Prefix: string(data[:7]),
+		})
+	}
+
+	sort.Slice(observations, func(i, j int) bool {
+		return observations[i].Key < observations[j].Key
+	})
+	return observations
+}
+
+type sourceObservation struct {
+	Key    string
+	Len    int
+	Prefix string
+}
+
+func silentLogger() *slog.Logger {
+	return slog.New(slog.NewTextHandler(io.Discard, nil))
+}
+
+func waitUntilClosed(t *testing.T, ch <-chan any) {
+	t.Helper()
+	select {
+	case value, ok := <-ch:
+		if ok {
+			t.Fatalf("channel produced %T instead of being closed", value)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for closed source output")
+	}
+}
+
+func fdCount(t *testing.T) int {
+	t.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		t.Fatalf("read fd directory: %v", err)
+	}
+	return len(entries)
+}
+
+func TestS3SourceListsPaginatedPrefixFetchesObjectsAndDefaultsConfig(t *testing.T) {
+
+
+	ctx := context.Background()
+	alphaBody := strings.Repeat("alpha-A", 750000)
+	bravoBody := strings.Repeat("bravo-B", 750000)
+	charlieBody := strings.Repeat("charlie", 750000)
+	server := newFakeS3Server(map[string]string{
+		"source/a.txt":  alphaBody,
+		"source/b.txt":  bravoBody,
+		"source/c.txt":  charlieBody,
+		"other/skip.md": "ignored",
+	}, 2)
+	server.getDelay = 20 * time.Millisecond
+	defer server.close()
+
+	config := &connector.S3SourceConfig{
+		Bucket:      "fixture-bucket",
+		Path:        "source/",
+		Parallelism: 0,
+		ChunkSize:   0,
+	}
+	source := connector.NewS3Source(ctx, server.client(), config, nil)
+
+	if source == nil {
+		t.Fatal("NewS3Source returned nil")
+	}
+
+	observations := collectSourceObjects(t, source.Out())
+
+	wantObjects := map[string]struct {
+		minLen int
+		prefix string
+	}{
+		"source/a.txt": {minLen: 5242880, prefix: "alpha-A"},
+		"source/b.txt": {minLen: 5242880, prefix: "bravo-B"},
+		"source/c.txt": {minLen: 5242880, prefix: "charlie"},
+	}
+
+	if len(observations) != len(wantObjects) {
+		t.Fatalf("observation count = %d, want %d: %#v", len(observations), len(wantObjects), observations)
+	}
+	for _, observation := range observations {
+		want, ok := wantObjects[observation.Key]
+		if !ok {
+			t.Fatalf("unexpected source object key %q in %#v", observation.Key, observations)
+		}
+		if observation.Len < want.minLen {
+			t.Fatalf("object %q length = %d, want at least %d", observation.Key, observation.Len, want.minLen)
+		}
+		if observation.Prefix != want.prefix {
+			t.Fatalf("object %q prefix = %q, want %q", observation.Key, observation.Prefix, want.prefix)
+		}
+	}
+	if got := server.listCallSnapshot(); fmt.Sprintf("%#v", got) != `[]string{"source/|", "source/|source/b.txt"}` {
+		t.Fatalf("list calls = %#v, want []string{\"source/|\", \"source/|source/b.txt\"}", got)
+	}
+	if got := server.getCallSnapshot(); fmt.Sprintf("%#v", got) != `[]string{"source/a.txt", "source/b.txt", "source/c.txt"}` {
+		t.Fatalf("get calls = %#v, want []string{\"source/a.txt\", \"source/b.txt\", \"source/c.txt\"}", got)
+	}
+
+	if got := server.maxGetActiveSnapshot(); got > 1 {
+		t.Fatalf("max concurrent GetObject calls = %d, want <= 1", got)
+	}
+}
+
+func TestS3SourceViaStreamsIntoFlowAndReturnsSameFlow(t *testing.T) {
+
+
+	ctx := context.Background()
+	server := newFakeS3Server(map[string]string{
+		"via/one.txt": "one",
+		"via/two.txt": "two",
+	}, 10)
+	defer server.close()
+
+	source := connector.NewS3Source(ctx, server.client(), &connector.S3SourceConfig{
+		Bucket:      "fixture-bucket",
+		Path:        "via/",
+		Parallelism: 1,
+		ChunkSize:   8,
+	}, silentLogger())
+	operator := flow.NewMap(func(object *connector.S3Object) string {
+		data, err := io.ReadAll(object.Data)
+		if err != nil {
+			t.Fatalf("read flow object: %v", err)
+		}
+		return object.Key + "=" + strings.TrimRight(string(data), "\x00")
+	}, 1)
+
+	returned := source.Via(operator)
+	if returned != streams.Flow(operator) {
+		t.Fatal("Via returned a different flow instance")
+	}
+
+	var got []string
+	for value := range returned.Out() {
+		got = append(got, value.(string))
+	}
+	sort.Strings(got)
+	if fmt.Sprintf("%#v", got) != `[]string{"via/one.txt=one", "via/two.txt=two"}` {
+		t.Fatalf("flow output = %#v, want []string{\"via/one.txt=one\", \"via/two.txt=two\"}", got)
+	}
+}
+
+func TestS3SourceCancellationClosesOutWithoutEmittingObjects(t *testing.T) {
+
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	server := newFakeS3Server(map[string]string{
+		"cancel/never.txt": "not-read",
+	}, 10)
+	defer server.close()
+
+	source := connector.NewS3Source(ctx, server.client(), &connector.S3SourceConfig{
+		Bucket:      "fixture-bucket",
+		Path:        "cancel/",
+		Parallelism: 1,
+		ChunkSize:   4,
+	}, silentLogger())
+
+	waitUntilClosed(t, source.Out())
+	if got := server.getCallSnapshot(); len(got) != 0 {
+		t.Fatalf("get call count = %d, want 0", len(got))
+	}
+}
