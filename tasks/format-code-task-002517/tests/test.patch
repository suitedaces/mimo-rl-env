+func TestS3ConnectorConstructUseCleanupCyclesStayBounded(t *testing.T) {
+
+
+	ctx := context.Background()
+	server := newFakeS3Server(nil, 1)
+	defer server.close()
+	client := server.client()
+	runtime.GC()
+	beforeGoroutines := runtime.NumGoroutine()
+	beforeFDs := fdCount(t)
+
+	for i := 0; i < 120; i++ {
+		sink := connector.NewS3Sink(ctx, client, &connector.S3SinkConfig{
+			Bucket:      "fixture-bucket",
+			Parallelism: 2,
+		}, silentLogger())
+		sink.In() <- &connector.S3Object{
+			Key:  fmt.Sprintf("cycle/%03d.txt", i),
+			Data: bytes.NewReader([]byte("cycle-body")),
+		}
+		close(sink.In())
+		sink.AwaitCompletion()
+	}
+
+	time.Sleep(100 * time.Millisecond)
+	runtime.GC()
+	afterGoroutines := runtime.NumGoroutine()
+	afterFDs := fdCount(t)
+
+	if beforeGoroutines > 0 && afterGoroutines-beforeGoroutines > 10 {
+		t.Fatalf("goroutines before/after = %d/%d, want increase <= 10", beforeGoroutines, afterGoroutines)
+	}
+	if beforeFDs > 0 && afterFDs-beforeFDs > 10 {
+		t.Fatalf("fds before/after = %d/%d, want increase <= 10", beforeFDs, afterFDs)
+	}
+}
