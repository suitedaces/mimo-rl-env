+func TestS3SinkUploadsValuePointerSkipsUnsupportedAndDefaultsParallelism(t *testing.T) {
+
+
+	ctx := context.Background()
+	server := newFakeS3Server(nil, 1)
+	server.putDelay = 20 * time.Millisecond
+	defer server.close()
+	config := &connector.S3SinkConfig{Bucket: "fixture-bucket", Parallelism: 0}
+	sink := connector.NewS3Sink(ctx, server.client(), config, silentLogger())
+
+	if sink == nil {
+		t.Fatal("NewS3Sink returned nil")
+	}
+
+	sink.In() <- connector.S3Object{Key: "sink/value.txt", Data: strings.NewReader("value-body")}
+	sink.In() <- &connector.S3Object{Key: "sink/pointer.txt", Data: strings.NewReader("pointer-body")}
+	sink.In() <- "not-an-s3-object"
+	close(sink.In())
+	sink.AwaitCompletion()
+
+	want := map[string]string{
+		"sink/pointer.txt": "pointer-body",
+		"sink/value.txt":   "value-body",
+	}
+	if got := server.putBodySnapshot(); fmt.Sprintf("%#v", got) != fmt.Sprintf("%#v", want) {
+		t.Fatalf("put bodies = %#v, want %#v", got, want)
+	}
+
+	if got := server.maxPutActiveSnapshot(); got > 1 {
+		t.Fatalf("max concurrent PutObject calls = %d, want <= 1", got)
+	}
+}
