diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,36 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export GOROOT=/opt/go-1.19
+export PATH=/usr/local/bin:$GOROOT/bin:$PATH
+
+
+
+
+if ! command -v terraform &>/dev/null; then
+  cat > /usr/local/bin/terraform << 'SHIM'
+#!/bin/sh
+if [ "$1" = "--version" ]; then
+    echo "Terraform v1.5.0"
+    exit 0
+fi
+exit 0
+SHIM
+  chmod +x /usr/local/bin/terraform
+fi
+
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 -timeout 600s -gcflags=all=-l ./pkg/cmd/apply -run '^TestApplyCommandRun$'
+    ;;
+  new)
+    go test -v -count=1 -timeout 600s -gcflags=all=-l ./pkg/cmd/apply -run '^(TestApplyCommandDoesNotExposeBackendFlags|TestApplyCommandRejectsLegacyBackendFlag|TestApplyRunAssociatesPreviewWithDefaultWorkspace|TestApplyRunSendsDefaultWorkspaceToApplyRequest|TestApplyRequestCarriesChangesWorkspaceAndDoesNotForwardCluster|Test_apply)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
