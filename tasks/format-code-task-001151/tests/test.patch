@@ -0,0 +1,8 @@
+#!/bin/bash
+set -euo pipefail
+
+tmpg=$(mktemp -d)
+trap 'rm -rf "$tmpg"' EXIT
+mkdir -p "$tmpg/src/github.com/attic-labs"
+ln -s "$PWD" "$tmpg/src/github.com/attic-labs/noms"
+GOPATH="$tmpg" GO111MODULE=off go test github.com/attic-labs/noms/cmd/noms/diff -run 'TestStructDiffUsesCurrentNamesForAddedFields|TestStructDiffOrdersInterleavedSchemaChanges|TestDiffRendersLeadingStructFieldAddition|TestDiffRendersInterleavedStructSchemaChanges|TestDiffRendersNestedStructFieldAddition' -count=1
