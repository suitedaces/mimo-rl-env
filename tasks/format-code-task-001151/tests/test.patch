diff --git a/cmd/noms/diff/schema_diff_regression_test.go b/cmd/noms/diff/schema_diff_regression_test.go
new file mode 100644
index 00000000..c763615e
--- /dev/null
+++ b/cmd/noms/diff/schema_diff_regression_test.go
@@ -0,0 +1,111 @@
+package diff
+
+import (
+	"testing"
+
+	"github.com/attic-labs/noms/go/types"
+	"github.com/attic-labs/testify/assert"
+	"github.com/syndtr/goleveldb/leveldb/util"
+)
+
+func collectSchemaChanges(previous, current types.Struct) []types.ValueChanged {
+	changes := make(chan types.ValueChanged)
+	go func() {
+		previous.Diff(current, changes, nil)
+		close(changes)
+	}()
+
+	var result []types.ValueChanged
+	for change := range changes {
+		result = append(result, change)
+	}
+	return result
+}
+
+func TestStructDiffUsesCurrentNamesForAddedFields(t *testing.T) {
+	previous := types.NewStruct("Record", map[string]types.Value{
+		"b": types.String("bee"),
+	})
+	current := types.NewStruct("Record", map[string]types.Value{
+		"a": types.String("aye"),
+		"b": types.String("bee"),
+	})
+
+	assert.Equal(t, []types.ValueChanged{
+		{ChangeType: types.DiffChangeAdded, V: types.String("a")},
+	}, collectSchemaChanges(previous, current))
+}
+
+func TestStructDiffOrdersInterleavedSchemaChanges(t *testing.T) {
+	previous := types.NewStruct("Record", map[string]types.Value{
+		"b": types.String("bee"),
+		"d": types.String("dee"),
+	})
+	current := types.NewStruct("Record", map[string]types.Value{
+		"a": types.String("aye"),
+		"b": types.String("bee"),
+		"c": types.String("see"),
+	})
+
+	assert.Equal(t, []types.ValueChanged{
+		{ChangeType: types.DiffChangeAdded, V: types.String("a")},
+		{ChangeType: types.DiffChangeAdded, V: types.String("c")},
+		{ChangeType: types.DiffChangeRemoved, V: types.String("d")},
+	}, collectSchemaChanges(previous, current))
+}
+
+func TestDiffRendersLeadingStructFieldAddition(t *testing.T) {
+	previous := types.NewStruct("Record", map[string]types.Value{
+		"b": types.String("bee"),
+	})
+	current := types.NewStruct("Record", map[string]types.Value{
+		"a": types.String("aye"),
+		"b": types.String("bee"),
+	})
+
+	buf := util.NewBuffer(nil)
+	assert.NotPanics(t, func() {
+		assert.NoError(t, Diff(buf, previous, current))
+	})
+	assert.Equal(t, "(root) {\n+   a: \"aye\"\n  }\n", buf.String())
+}
+
+func TestDiffRendersInterleavedStructSchemaChanges(t *testing.T) {
+	previous := types.NewStruct("Record", map[string]types.Value{
+		"b": types.String("bee"),
+		"d": types.String("dee"),
+	})
+	current := types.NewStruct("Record", map[string]types.Value{
+		"a": types.String("aye"),
+		"b": types.String("bee"),
+		"c": types.String("see"),
+	})
+
+	buf := util.NewBuffer(nil)
+	assert.NotPanics(t, func() {
+		assert.NoError(t, Diff(buf, previous, current))
+	})
+	assert.Equal(t, "(root) {\n+   a: \"aye\"\n+   c: \"see\"\n-   d: \"dee\"\n  }\n", buf.String())
+}
+
+func TestDiffRendersNestedStructFieldAddition(t *testing.T) {
+	previous := types.NewStruct("Outer", map[string]types.Value{
+		"child": types.NewStruct("Inner", map[string]types.Value{
+			"b": types.String("bee"),
+		}),
+		"keep": types.Bool(true),
+	})
+	current := types.NewStruct("Outer", map[string]types.Value{
+		"child": types.NewStruct("Inner", map[string]types.Value{
+			"a": types.String("aye"),
+			"b": types.String("bee"),
+		}),
+		"keep": types.Bool(true),
+	})
+
+	buf := util.NewBuffer(nil)
+	assert.NotPanics(t, func() {
+		assert.NoError(t, Diff(buf, previous, current))
+	})
+	assert.Equal(t, ".child {\n+   a: \"aye\"\n  }\n", buf.String())
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
