+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+export GOTOOLCHAIN=local
+export GOWORK=off
+export GOPROXY=off
+export GOSUMDB=off
+export GOFLAGS="${GOFLAGS:-} -mod=readonly"
+go test -v -count=1 ./usercase-test-coderl/...
+exec go test -v -count=1 ./x/mongo/driver/topology -run '^TestTSTSRVServiceNameControlsPollingLookup$'
