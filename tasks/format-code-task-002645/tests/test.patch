+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export npm_config_offline=true
+export YARN_ENABLE_NETWORK=0
+export BROWSERSLIST_IGNORE_OLD_DATA=1
+
+if [ ! -x ./node_modules/.bin/tsc ]; then
+  echo "offline dependency tree is missing the local TypeScript compiler" >&2
+  exit 1
+fi
+
+./node_modules/.bin/tsc \
+  --noEmit \
+  --jsx react \
+  --module commonjs \
+  --moduleResolution node \
+  --baseUrl /workspace/repo/src \
+  --target es2018 \
+  --strict \
+  --esModuleInterop \
+  --allowSyntheticDefaultImports \
+  --skipLibCheck \
+  --types jest,node \
+  /workspace/repo/usercase-test-coderl/spacing_shorthand.test.ts
+
+runtime_dir="$(mktemp -d /tmp/restyle-coderl-runtime.XXXXXX)"
+runner="$runtime_dir/run-tests.cjs"
+trap 'rm -rf "$runtime_dir"' EXIT
+
+./node_modules/.bin/tsc \
+  --outDir "$runtime_dir" \
+  --rootDir /workspace/repo \
+  --jsx react \
+  --module commonjs \
+  --moduleResolution node \
+  --baseUrl /workspace/repo/src \
+  --target es2018 \
+  --strict \
+  --esModuleInterop \
+  --allowSyntheticDefaultImports \
+  --skipLibCheck \
+  --types jest,node \
+  /workspace/repo/usercase-test-coderl/spacing_shorthand.test.ts
+
+cat > "$runner" <<'NODE'
+const assert = require('assert');
+const Module = require('module');
+
+const originalLoad = Module._load;
+const React = require('/workspace/repo/node_modules/react');
+
+const createHostComponent = displayName => {
+  const Component = React.forwardRef((props, ref) =>
+    React.createElement(displayName, {...props, ref}, props.children),
+  );
+  Component.displayName = displayName;
+  return Component;
+};
+
+const reactNativeStub = {
+  StyleSheet: {
+    create: styles => styles,
+    flatten: style => {
+      if (Array.isArray(style)) {
+        return style.filter(Boolean).reduce((acc, item) => {
+          const flattened = reactNativeStub.StyleSheet.flatten(item);
+          return flattened == null ? acc : Object.assign(acc, flattened);
+        }, {});
+      }
+      return style || undefined;
+    },
+  },
+  View: createHostComponent('View'),
+  Text: createHostComponent('Text'),
+  useWindowDimensions: () => ({fontScale: 1, height: 0, scale: 1, width: 0}),
+};
+
+Module._load = function patchedLoad(request, parent, isMain) {
+  if (request === 'react-native') {
+    return reactNativeStub;
+  }
+  if (request === 'react') {
+    return React;
+  }
+  return originalLoad.apply(this, arguments);
+};
+
+const tests = [];
+global.describe = (_name, fn) => fn();
+global.test = (name, fn) => tests.push({name, fn});
+
+const makeExpectation = actual => ({
+  toBe(expected) {
+    assert.strictEqual(actual, expected);
+  },
+  toStrictEqual(expected) {
+    assert.deepStrictEqual(actual, expected);
+  },
+  toThrow(expected) {
+    assert.strictEqual(typeof actual, 'function', 'toThrow expects a function');
+    let thrown;
+    try {
+      actual();
+    } catch (error) {
+      thrown = error;
+    }
+    assert.ok(thrown, 'expected function to throw');
+    if (expected instanceof RegExp) {
+      assert.match(String(thrown && thrown.message), expected);
+    } else if (typeof expected === 'string') {
+      assert.ok(
+        String(thrown && thrown.message).includes(expected),
+        `expected error message to include ${JSON.stringify(expected)}, got ${JSON.stringify(
+          thrown && thrown.message,
+        )}`,
+      );
+    }
+  },
+});
+
+global.expect = makeExpectation;
+
+require(process.argv[2]);
+
+let failures = 0;
+for (const {name, fn} of tests) {
+  try {
+    fn();
+    console.log(`ok - ${name}`);
+  } catch (error) {
+    failures += 1;
+    console.error(`not ok - ${name}`);
+    console.error(error && error.stack ? error.stack : error);
+  }
+}
+
+if (failures > 0) {
+  process.exit(1);
+}
+console.log(`ran ${tests.length} tests`);
+NODE
+
+NODE_PATH="$runtime_dir/src:/workspace/repo/node_modules" \
+  node "$runner" "$runtime_dir/usercase-test-coderl/spacing_shorthand.test.js"
