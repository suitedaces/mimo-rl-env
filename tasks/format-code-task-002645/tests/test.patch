@@ -0,0 +1,386 @@
+import React from 'react';
+import {create as render} from 'react-test-renderer';
+import {Text as RNText, View} from '../src/reactNative';
+
+import {
+  BoxProps,
+  composeRestyleFunctions,
+  createBox,
+  createText,
+  spacingShorthand,
+  SpacingShorthandProps,
+  TextProps,
+  ThemeProvider,
+} from '../src';
+
+const theme = {
+  colors: {
+    black: '#000000',
+  },
+  spacing: {
+    s: 8,
+    m: 16,
+    l: 24,
+  },
+  breakpoints: {
+    phone: 0,
+    tablet: 376,
+  },
+  textVariants: {
+    defaults: {},
+  },
+};
+
+type Theme = typeof theme;
+
+const phoneDimensions = {width: 320, height: 640};
+const tabletDimensions = {width: 768, height: 1024};
+
+const {buildStyle, properties} = composeRestyleFunctions<
+  Theme,
+  SpacingShorthandProps<Theme>
+>(spacingShorthand);
+
+const allSpacingShorthandProps: SpacingShorthandProps<Theme> = {
+  m: 's',
+  mt: 's',
+  mr: 's',
+  mb: 's',
+  ml: 's',
+  mx: 's',
+  my: 's',
+  ms: 's',
+  me: 's',
+  p: 's',
+  pt: 's',
+  pr: 's',
+  pb: 's',
+  pl: 's',
+  px: 's',
+  py: 's',
+  ps: 's',
+  pe: 's',
+  g: 's',
+  rg: 's',
+  cg: 's',
+};
+
+const responsiveSpacingProps: SpacingShorthandProps<Theme> = {
+  mt: {phone: 's', tablet: 'm'},
+};
+
+const Box = createBox<Theme>();
+const Text = createText<Theme>();
+
+const typedBoxProps: BoxProps<Theme> = {
+  m: 's',
+  px: 'm',
+  rg: 'l',
+};
+
+const typedTextProps: TextProps<Theme> = {
+  mt: 's',
+  pe: 'm',
+  cg: 'l',
+};
+
+const typedBoxElement: React.ReactElement = React.createElement(Box, {
+  m: 's',
+  px: 'm',
+  rg: 'l',
+});
+const typedTextElement: React.ReactElement = React.createElement(
+  Text,
+  {
+    mt: 's',
+    pe: 'm',
+    cg: 'l',
+  },
+  'Text',
+);
+
+const expectedShorthandNames = [
+  'm',
+  'mt',
+  'mr',
+  'mb',
+  'ml',
+  'mx',
+  'my',
+  'ms',
+  'me',
+  'p',
+  'pt',
+  'pr',
+  'pb',
+  'pl',
+  'px',
+  'py',
+  'ps',
+  'pe',
+  'g',
+  'rg',
+  'cg',
+];
+
+const expectSameMembers = (actual: string[], expected: string[]) => {
+  expect(new Set(actual)).toStrictEqual(new Set(expected));
+  expect(actual.length).toBe(expected.length);
+};
+
+const flattenStyle = (style: unknown): {[key: string]: unknown} => {
+  if (Array.isArray(style)) {
+    return style
+      .filter(Boolean)
+      .reduce(
+        (acc, item) => ({...acc, ...flattenStyle(item)}),
+        {} as {[key: string]: unknown},
+      );
+  }
+
+  return style == null ? {} : (style as {[key: string]: unknown});
+};
+
+describe('spacingShorthand acceptance', () => {
+  test('exports the public shorthand function set and prop type vocabulary', () => {
+
+
+
+    expectSameMembers(properties as string[], expectedShorthandNames);
+    expectSameMembers(Object.keys(allSpacingShorthandProps), expectedShorthandNames);
+  });
+
+  test('maps margin shorthands through theme.spacing to React Native margin styles', () => {
+
+
+    expect(
+      buildStyle(
+        {
+          m: 's',
+          mt: 'm',
+          mr: 'l',
+          mb: 's',
+          ml: 'm',
+          mx: 'l',
+          my: 's',
+          ms: 'm',
+          me: 'l',
+        },
+        {theme, dimensions: phoneDimensions},
+      ),
+    ).toStrictEqual({
+      margin: 8,
+      marginTop: 16,
+      marginRight: 24,
+      marginBottom: 8,
+      marginLeft: 16,
+      marginHorizontal: 24,
+      marginVertical: 8,
+      marginStart: 16,
+      marginEnd: 24,
+    });
+  });
+
+  test('maps padding shorthands through theme.spacing to React Native padding styles', () => {
+
+
+    expect(
+      buildStyle(
+        {
+          p: 's',
+          pt: 'm',
+          pr: 'l',
+          pb: 's',
+          pl: 'm',
+          px: 'l',
+          py: 's',
+          ps: 'm',
+          pe: 'l',
+        },
+        {theme, dimensions: phoneDimensions},
+      ),
+    ).toStrictEqual({
+      padding: 8,
+      paddingTop: 16,
+      paddingRight: 24,
+      paddingBottom: 8,
+      paddingLeft: 16,
+      paddingHorizontal: 24,
+      paddingVertical: 8,
+      paddingStart: 16,
+      paddingEnd: 24,
+    });
+  });
+
+  test('maps gap shorthands through theme.spacing to React Native gap styles', () => {
+
+
+    expect(
+      buildStyle(
+        {
+          g: 's',
+          rg: 'm',
+          cg: 'l',
+        },
+        {theme, dimensions: phoneDimensions},
+      ),
+    ).toStrictEqual({
+      gap: 8,
+      rowGap: 16,
+      columnGap: 24,
+    });
+  });
+
+  test('resolves responsive shorthand values at the phone breakpoint', () => {
+
+
+    expect(
+      buildStyle(responsiveSpacingProps, {
+        theme,
+        dimensions: phoneDimensions,
+      }),
+    ).toStrictEqual({
+      marginTop: 8,
+    });
+  });
+
+  test('resolves responsive shorthand values at the tablet breakpoint', () => {
+
+
+    expect(
+      buildStyle(responsiveSpacingProps, {
+        theme,
+        dimensions: tabletDimensions,
+      }),
+    ).toStrictEqual({
+      marginTop: 16,
+    });
+  });
+
+  test('createBox public props accept and apply spacing shorthands', () => {
+
+
+    expect(typedBoxElement.type).toBe(Box);
+    const {root} = render(
+      React.createElement(
+        ThemeProvider,
+        {theme, children: React.createElement(Box, typedBoxProps)},
+      ),
+    );
+
+
+    expect(flattenStyle(root.findByType(View).props.style)).toStrictEqual({
+      margin: 8,
+      paddingHorizontal: 16,
+      rowGap: 24,
+    });
+  });
+
+  test('createText public props accept and apply spacing shorthands', () => {
+
+
+    expect(typedTextElement.type).toBe(Text);
+    const {root} = render(
+      React.createElement(
+        ThemeProvider,
+        {theme, children: React.createElement(Text, typedTextProps, 'Text')},
+      ),
+    );
+
+
+    expect(flattenStyle(root.findByType(RNText).props.style)).toStrictEqual({
+      marginTop: 8,
+      paddingEnd: 16,
+      columnGap: 24,
+    });
+  });
+
+  test('rejects a missing spacing token instead of treating it as a style value', () => {
+
+    expect(() =>
+      buildStyle({m: 'missing' as keyof Theme['spacing']}, {
+        theme,
+        dimensions: phoneDimensions,
+      }),
+    ).toThrow();
+  });
+
+  test('is referentially transparent for the same shorthand input', () => {
+    const props: SpacingShorthandProps<Theme> = {m: 's', px: 'm', rg: 'l'};
+
+    expect(
+      buildStyle(props, {theme, dimensions: phoneDimensions}),
+    ).toStrictEqual(buildStyle(props, {theme, dimensions: phoneDimensions}));
+  });
+
+  test('resolves a reusable responsive shorthand object at multiple breakpoints', () => {
+    const props: SpacingShorthandProps<Theme> = {
+      mt: {phone: 's', tablet: 'm'},
+      px: 'l',
+    };
+
+    expect(
+      buildStyle(props, {theme, dimensions: phoneDimensions}),
+    ).toStrictEqual({
+      marginTop: 8,
+      paddingHorizontal: 24,
+    });
+
+    expect(
+      buildStyle(props, {theme, dimensions: tabletDimensions}),
+    ).toStrictEqual({
+      marginTop: 16,
+      paddingHorizontal: 24,
+    });
+  });
+
+  test('composed shorthand builders consistently produce the specified style output', () => {
+    const firstBuilder = composeRestyleFunctions<
+      Theme,
+      SpacingShorthandProps<Theme>
+    >(spacingShorthand);
+    const secondBuilder = composeRestyleFunctions<
+      Theme,
+      SpacingShorthandProps<Theme>
+    >(spacingShorthand);
+
+
+    expect(
+      firstBuilder.buildStyle(
+        {m: 's', px: 'm', rg: 'l'},
+        {theme, dimensions: phoneDimensions},
+      ),
+    ).toStrictEqual({
+      margin: 8,
+      paddingHorizontal: 16,
+      rowGap: 24,
+    });
+    expect(
+      secondBuilder.buildStyle(
+        {m: 's', px: 'm', rg: 'l'},
+        {theme, dimensions: phoneDimensions},
+      ),
+    ).toStrictEqual({
+      margin: 8,
+      paddingHorizontal: 16,
+      rowGap: 24,
+    });
+  });
+
+  test('writes React Native style property names instead of shorthand prop names', () => {
+    const style = buildStyle(
+      {m: 's', px: 'm', rg: 'l'},
+      {theme, dimensions: phoneDimensions},
+    );
+
+
+    expect(style).toStrictEqual({
+      margin: 8,
+      paddingHorizontal: 16,
+      rowGap: 24,
+    });
+    expect(Object.keys(style).sort()).toStrictEqual(
+      ['margin', 'paddingHorizontal', 'rowGap'].sort(),
+    );
+  });
+});
