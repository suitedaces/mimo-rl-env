diff --git a/test-data/unit/check-dataclasses.test b/test-data/unit/check-dataclasses.test
index 57ed2813c..57130e603 100644
--- a/test-data/unit/check-dataclasses.test
+++ b/test-data/unit/check-dataclasses.test
@@ -1337,3 +1337,49 @@ class Foo:
 
 reveal_type(Foo(bar=1.5))  # N: Revealed type is "__main__.Foo"
 [builtins fixtures/dataclasses.pyi]
+
+
+[case testDataclassFieldDoesNotFailOnPositionalArgs]
+# flags: --python-version 3.7
+# https://github.com/python/mypy/issues/10905
+from dataclasses import dataclass, field
+
+@dataclass
+class C:
+    x: int = field(15)  # type: ignore[call-overload]  # E: "field()" does not accept positional arguments
+[builtins fixtures/dataclasses.pyi]
+
+
+[case testDataclassFieldDefaultFactoryAsPositionalArg]
+# flags: --python-version 3.7
+# https://github.com/python/mypy/issues/10905
+from dataclasses import dataclass, field
+
+@dataclass
+class C:
+    attribute: int = field(int)  # type: ignore[call-overload]  # E: "field()" does not accept positional arguments
+[builtins fixtures/dataclasses.pyi]
+
+
+[case testDataclassFieldDoesNotFailOnPositionalArgWithKeywordArg]
+# flags: --python-version 3.7
+# https://github.com/python/mypy/issues/10905
+from dataclasses import dataclass, field
+
+@dataclass
+class C:
+    x: int = field(15, repr=True)  # type: ignore[call-overload]  # E: "field()" does not accept positional arguments
+[builtins fixtures/dataclasses.pyi]
+
+
+[case testDataclassFieldDefaultFactoryKeywordArgStillWorks]
+# flags: --python-version 3.7
+from dataclasses import dataclass, field
+
+@dataclass
+class C:
+    attribute: int = field(default_factory=int)
+
+c = C()
+reveal_type(c.attribute)  # N: Revealed type is "builtins.int"
+[builtins fixtures/dataclasses.pyi]
