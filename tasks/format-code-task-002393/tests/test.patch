 PKG_INFO = """\
@@ -262,3 +264,119 @@ def test_convert_bdist_wininst(
         assert wf.read("sampledist-1.0.0.dist-info/entry_points.txt") == b""
 
     assert capsys.readouterr().out == f"{bdist_wininst_path}...OK\n"
