+
+def test_convert_pkg_info_empty_description_does_not_raise() -> None:
+    """Empty Description field must not raise IndexError (the reported bug)."""
+    metadata = Message()
+    pkginfo = "Metadata-Version: 2.1\nName: test\nVersion: 1.0\nDescription:\n"
+    convert_pkg_info(pkginfo, metadata)
+
+
+def test_convert_pkg_info_empty_description_issue_repro() -> None:
+    """Exact reproduction style from the bug report: description with no body."""
+    from email.parser import Parser
+
+    parsed = Parser().parsestr("description:\n")
+    assert parsed["description"] == ""
+
+    metadata = Message()
+
+    convert_pkg_info("Metadata-Version: 2.1\ndescription:\n", metadata)
+
+
+def test_convert_pkg_info_empty_description_payload() -> None:
+    """When description is empty, payload must be empty/blank.
+
+    Any of None, "", or "\\n" is acceptable — these all serialize to an
+    equivalent METADATA file. What is NOT acceptable is junk content
+    (e.g. a stray "Description" written into the payload body).
+    """
+    metadata = Message()
+    pkginfo = "Metadata-Version: 2.1\nName: test\nVersion: 1.0\nDescription:\n"
+    convert_pkg_info(pkginfo, metadata)
+    payload = metadata.get_payload()
+    assert payload in (None, "", "\n")
+
+
+def test_convert_pkg_info_empty_description_not_added_as_header() -> None:
+    """Empty description must not be added as a 'Description' header.
+
+    The description belongs in the payload (body), never as a header.
+    """
+    metadata = Message()
+    pkginfo = "Metadata-Version: 2.1\nName: test\nVersion: 1.0\nDescription:\n"
+    convert_pkg_info(pkginfo, metadata)
+    assert metadata.get("Description") is None
+    assert metadata.get("description") is None
+
+
+def test_convert_pkg_info_empty_description_preserves_other_headers() -> None:
+    """Empty description must not prevent processing of other headers."""
+    metadata = Message()
+    pkginfo = (
+        "Metadata-Version: 2.1\n"
+        "Name: testpkg\n"
+        "Version: 9.8.7\n"
+        "Author: Somebody\n"
+        "Description:\n"
+    )
+    convert_pkg_info(pkginfo, metadata)
+    assert metadata.get("Name") == "testpkg"
+    assert metadata.get("Version") == "9.8.7"
+    assert metadata.get("Author") == "Somebody"
+    assert metadata.get("Metadata-Version") == "2.4"
+
+
+def test_convert_pkg_info_empty_non_description_header_preserved() -> None:
+    """A non-description header with an empty value must still be added.
+
+    The fix is scoped to the description handling; it must not strip
+    other empty-valued headers.
+    """
+    metadata = Message()
+    pkginfo = (
+        "Metadata-Version: 2.1\n"
+        "Name: test\n"
+        "Version: 1.0\n"
+        "Author:\n"
+        "Description: Hello\n"
+    )
+    convert_pkg_info(pkginfo, metadata)
+
+    assert metadata.get("Author") is not None
+
+
+def test_convert_pkg_info_non_empty_description_preserved() -> None:
+    """Non-empty descriptions still produce the expected dedented payload."""
+    metadata = Message()
+    pkginfo = (
+        "Metadata-Version: 2.1\n"
+        "Name: test\n"
+        "Version: 1.0\n"
+        "Description: First line\n"
+        "    Second line\n"
+        "    Third line\n"
+    )
+    convert_pkg_info(pkginfo, metadata)
+    payload = metadata.get_payload()
+    assert payload is not None
+    assert "First line" in payload
+    assert "Second line" in payload
+    assert "Third line" in payload
+
+    assert "\n    Second line" not in payload
+
+
+def test_convert_pkg_info_unknown_value_still_skipped() -> None:
+    """The pre-existing UNKNOWN-skip behavior must be preserved."""
+    metadata = Message()
+    pkginfo = (
+        "Metadata-Version: 2.1\n"
+        "Name: test\n"
+        "Version: 1.0\n"
+        "Author: UNKNOWN\n"
+        "Description:\n"
+    )
+    convert_pkg_info(pkginfo, metadata)
+    assert metadata.get("Author") is None
