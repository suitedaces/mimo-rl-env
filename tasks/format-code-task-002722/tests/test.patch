diff --git a/test/rules/std_RF02_test.py b/test/rules/std_RF02_test.py
index e9a774693..87deb3531 100644
--- a/test/rules/std_RF02_test.py
+++ b/test/rules/std_RF02_test.py
@@ -13,3 +13,72 @@ def test__rules__std_RF02_wildcard_single_count():
     result = sqlfluff.lint(sql)
     assert "RF02" in [r["code"] for r in result]
     assert [r["code"] for r in result].count("RF02") == 1
+
+
+def test__rules__std_RF02_unaliased_subquery_single_table():
+    """Inner select with single table should not raise RF02 (issue #5811).
+
+    Reproduces the exact snippet from the GitHub issue.
+    """
+    sql = "SELECT *\nFROM (SELECT a FROM table_a)\n"
+    result = sqlfluff.lint(sql, dialect="postgres")
+    rf02 = [r for r in result if r["code"] == "RF02"]
+    assert rf02 == [], f"Unexpected RF02 violations: {rf02}"
+
+
+def test__rules__std_RF02_aliased_subquery_single_table():
+    """Inner select with single table inside an ALIASED subquery.
+
+    Discriminates fixes that skip only unnamed subqueries (ref_str filter).
+    """
+    sql = "SELECT *\nFROM (SELECT a FROM tab) AS sub\n"
+    result = sqlfluff.lint(sql, dialect="postgres")
+    rf02 = [r for r in result if r["code"] == "RF02"]
+    assert rf02 == [], f"Unexpected RF02 violations: {rf02}"
+
+
+def test__rules__std_RF02_subquery_mix_with_outer_join_still_flagged():
+    """Preservation: subquery whose parent has another real table.
+
+    Outer scope is (subquery_alias, vee). After excluding the subquery
+    itself, the inner SELECT still sees a sibling table (vee), so the
+    unqualified reference `c` inside the subquery should be flagged.
+    """
+    sql = (
+        "SELECT foo.a, vee.b\n"
+        "FROM (\n"
+        "    SELECT c\n"
+        "    FROM bar\n"
+        ") AS foo\n"
+        "LEFT JOIN vee ON vee.a = foo.a\n"
+    )
+    result = sqlfluff.lint(sql, dialect="postgres")
+    rf02 = [r for r in result if r["code"] == "RF02"]
+    inner_c = [r for r in rf02 if "'c'" in r.get("description", "")]
+    assert inner_c, f"Expected RF02 violation for inner 'c'; got {rf02}"
+
+
+def test__rules__std_RF02_nested_subquery_single_table():
+    """Doubly-nested subquery, each level with one table — no RF02."""
+    sql = "SELECT *\nFROM (SELECT * FROM (SELECT a FROM tab))\n"
+    result = sqlfluff.lint(sql, dialect="postgres")
+    rf02 = [r for r in result if r["code"] == "RF02"]
+    assert rf02 == [], f"Unexpected RF02 violations: {rf02}"
+
+
+def test__rules__std_RF02_multitable_inner_still_flagged():
+    """Preservation: inner select with multiple tables still flags unqualified refs."""
+    sql = (
+        "SELECT a\n"
+        "FROM (\n"
+        "    SELECT a, b\n"
+        "    FROM foo\n"
+        "    LEFT JOIN vee ON vee.a = foo.a\n"
+        ")\n"
+    )
+    result = sqlfluff.lint(sql, dialect="postgres")
+    rf02 = [r for r in result if r["code"] == "RF02"]
+    inner_a = [r for r in rf02 if "'a'" in r.get("description", "")]
+    inner_b = [r for r in rf02 if "'b'" in r.get("description", "")]
+    assert inner_a, f"Expected RF02 for inner unqualified 'a'; got {rf02}"
+    assert inner_b, f"Expected RF02 for inner unqualified 'b'; got {rf02}"
