diff --git a/config/v20_parse_test.go b/config/v20_parse_test.go
new file mode 100644
index 00000000..9d1af58f
--- /dev/null
+++ b/config/v20_parse_test.go
@@ -0,0 +1,287 @@
+package config
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/coreos/ignition/config/types"
+	"github.com/coreos/ignition/config/validate/report"
+)
+
+func TestParseAcceptsIgnitionV20Minimal(t *testing.T) {
+	cfg, rpt, err := Parse([]byte(`{"ignition":{"version":"2.0.0"}}`))
+	if err != nil {
+		t.Fatalf("expected 2.0.0 config to parse, got error: %v", err)
+	}
+	if rpt.IsFatal() {
+		t.Fatalf("expected non-fatal report for minimal 2.0.0 config, got: %#v", rpt)
+	}
+	if cfg.Ignition.Version != types.IgnitionVersion(types.MaxVersion) {
+		t.Fatalf("expected parsed 2.0.0 config to be returned as current version %v, got %v", types.MaxVersion, cfg.Ignition.Version)
+	}
+}
+
+func TestParseAcceptsIgnitionV20PreservesUsersAndUnits(t *testing.T) {
+	raw := []byte(`{
+		"ignition": {"version": "2.0.0"},
+		"passwd": {
+			"users": [
+				{
+					"name": "core",
+					"sshAuthorizedKeys": ["ssh-rsa AAAATEST core@example"]
+				},
+				{
+					"name": "builder",
+					"passwordHash": "locked",
+					"create": {
+						"uid": 1234,
+						"gecos": "Build User",
+						"homedir": "/home/builder",
+						"noCreateHome": true,
+						"primaryGroup": "builders",
+						"groups": ["wheel", "docker"],
+						"noUserGroup": true,
+						"system": true,
+						"noLogInit": true,
+						"shell": "/bin/bash"
+					}
+				}
+			],
+			"groups": [
+				{"name": "builders", "gid": 2234, "passwordHash": "group-hash", "system": true}
+			]
+		},
+		"systemd": {
+			"units": [
+				{
+					"name": "alpha.service",
+					"enable": true,
+					"contents": "[Service]\nExecStart=/usr/bin/true\n",
+					"dropins": [
+						{"name": "10-extra.conf", "contents": "[Service]\nEnvironment=A=1\n"},
+						{"name": "20-more.conf", "contents": "[Service]\nEnvironment=B=2\n"}
+					]
+				},
+				{
+					"name": "masked.service",
+					"mask": true,
+					"contents": "[Service]\nExecStart=/usr/bin/false\n"
+				}
+			]
+		}
+	}`)
+
+	cfg, rpt, err := Parse(raw)
+	if err != nil {
+		t.Fatalf("expected 2.0.0 config with users and units to parse, got error: %v", err)
+	}
+	if rpt.IsFatal() {
+		t.Fatalf("expected non-fatal report, got: %#v", rpt)
+	}
+	if cfg.Ignition.Version != types.IgnitionVersion(types.MaxVersion) {
+		t.Fatalf("expected current version %v, got %v", types.MaxVersion, cfg.Ignition.Version)
+	}
+
+	if len(cfg.Passwd.Users) != 2 {
+		t.Fatalf("expected 2 users, got %d: %#v", len(cfg.Passwd.Users), cfg.Passwd.Users)
+	}
+	if cfg.Passwd.Users[0].Name != "core" {
+		t.Fatalf("expected first user name core, got %q", cfg.Passwd.Users[0].Name)
+	}
+	if !reflect.DeepEqual(cfg.Passwd.Users[0].SSHAuthorizedKeys, []string{"ssh-rsa AAAATEST core@example"}) {
+		t.Fatalf("expected ssh key to be preserved, got %#v", cfg.Passwd.Users[0].SSHAuthorizedKeys)
+	}
+	if cfg.Passwd.Users[1].Name != "builder" || cfg.Passwd.Users[1].PasswordHash != "locked" {
+		t.Fatalf("expected second user identity fields to be preserved, got %#v", cfg.Passwd.Users[1])
+	}
+	if cfg.Passwd.Users[1].Create == nil {
+		t.Fatalf("expected create settings for builder user")
+	}
+	create := cfg.Passwd.Users[1].Create
+	if create.Uid == nil || *create.Uid != 1234 || create.GECOS != "Build User" || create.Homedir != "/home/builder" || !create.NoCreateHome {
+		t.Fatalf("expected builder create basics to be preserved, got %#v", create)
+	}
+	if create.PrimaryGroup != "builders" || !reflect.DeepEqual(create.Groups, []string{"wheel", "docker"}) {
+		t.Fatalf("expected builder group settings to be preserved, got %#v", create)
+	}
+	if !create.NoUserGroup || !create.System || !create.NoLogInit || create.Shell != "/bin/bash" {
+		t.Fatalf("expected builder create flags to be preserved, got %#v", create)
+	}
+
+	if len(cfg.Passwd.Groups) != 1 {
+		t.Fatalf("expected 1 group, got %d: %#v", len(cfg.Passwd.Groups), cfg.Passwd.Groups)
+	}
+	if cfg.Passwd.Groups[0].Name != "builders" || cfg.Passwd.Groups[0].Gid == nil || *cfg.Passwd.Groups[0].Gid != 2234 || cfg.Passwd.Groups[0].PasswordHash != "group-hash" || !cfg.Passwd.Groups[0].System {
+		t.Fatalf("expected group fields to be preserved, got %#v", cfg.Passwd.Groups[0])
+	}
+
+	if len(cfg.Systemd.Units) != 2 {
+		t.Fatalf("expected 2 systemd units, got %d: %#v", len(cfg.Systemd.Units), cfg.Systemd.Units)
+	}
+	if cfg.Systemd.Units[0].Name != "alpha.service" || !cfg.Systemd.Units[0].Enable {
+		t.Fatalf("expected enabled alpha.service, got %#v", cfg.Systemd.Units[0])
+	}
+	if cfg.Systemd.Units[0].Contents != "[Service]\nExecStart=/usr/bin/true\n" {
+		t.Fatalf("expected alpha.service contents to be preserved, got %q", cfg.Systemd.Units[0].Contents)
+	}
+	if len(cfg.Systemd.Units[0].DropIns) != 2 {
+		t.Fatalf("expected 2 dropins, got %d: %#v", len(cfg.Systemd.Units[0].DropIns), cfg.Systemd.Units[0].DropIns)
+	}
+	if cfg.Systemd.Units[0].DropIns[1].Name != "20-more.conf" || cfg.Systemd.Units[0].DropIns[1].Contents != "[Service]\nEnvironment=B=2\n" {
+		t.Fatalf("expected second dropin to be preserved, got %#v", cfg.Systemd.Units[0].DropIns[1])
+	}
+	if cfg.Systemd.Units[1].Name != "masked.service" || !cfg.Systemd.Units[1].Mask {
+		t.Fatalf("expected masked.service to be preserved, got %#v", cfg.Systemd.Units[1])
+	}
+}
+
+func TestParseAcceptsIgnitionV20PreservesStorageNetworkAndRefs(t *testing.T) {
+	raw := []byte(`{
+		"ignition": {
+			"version": "2.0.0",
+			"config": {
+				"append": [
+					{
+						"source": "http://example.com/append-a",
+						"verification": {"hash": "sha512-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
+					}
+				],
+				"replace": {
+					"source": "https://example.com/replace-b",
+					"verification": {"hash": "sha512-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}
+				}
+			}
+		},
+		"storage": {
+			"disks": [
+				{
+					"device": "/dev/vda",
+					"wipeTable": true,
+					"partitions": [
+						{"label": "ROOTX", "number": 4, "size": 2097152, "start": 1048576, "typeGuid": "11111111-2222-3333-4444-555555555555"}
+					]
+				}
+			],
+			"filesystems": [
+				{
+					"name": "rootfs",
+					"mount": {
+						"device": "/dev/disk/by-partlabel/ROOTX",
+						"format": "ext4",
+						"create": {"force": true, "options": ["-L", "ROOTX"]}
+					}
+				}
+			],
+			"files": [
+				{
+					"filesystem": "rootfs",
+					"path": "/etc/example.conf",
+					"mode": 420,
+					"user": {"id": 100},
+					"group": {"id": 101},
+					"contents": {"source": "https://example.com/example"}
+				}
+			]
+		},
+		"networkd": {
+			"units": [
+				{"name": "10-eth0.network", "contents": "[Match]\nName=eth0\n"}
+			]
+		}
+	}`)
+
+	cfg, rpt, err := Parse(raw)
+	if err != nil {
+		t.Fatalf("expected 2.0.0 config with storage/network data to parse, got error: %v", err)
+	}
+	if rpt.IsFatal() {
+		t.Fatalf("expected non-fatal report, got: %#v", rpt)
+	}
+	if cfg.Ignition.Version != types.IgnitionVersion(types.MaxVersion) {
+		t.Fatalf("expected current version %v, got %v", types.MaxVersion, cfg.Ignition.Version)
+	}
+
+	if len(cfg.Ignition.Config.Append) != 1 || cfg.Ignition.Config.Append[0].Source.String() != "http://example.com/append-a" {
+		t.Fatalf("expected append config reference to be preserved, got %#v", cfg.Ignition.Config.Append)
+	}
+	if cfg.Ignition.Config.Append[0].Verification.Hash == nil || cfg.Ignition.Config.Append[0].Verification.Hash.Function != "sha512" || cfg.Ignition.Config.Append[0].Verification.Hash.Sum != "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" {
+		t.Fatalf("expected append verification hash to be preserved, got %#v", cfg.Ignition.Config.Append[0].Verification)
+	}
+	if cfg.Ignition.Config.Replace == nil || cfg.Ignition.Config.Replace.Source.String() != "https://example.com/replace-b" {
+		t.Fatalf("expected replace config reference to be preserved, got %#v", cfg.Ignition.Config.Replace)
+	}
+	if cfg.Ignition.Config.Replace.Verification.Hash == nil || cfg.Ignition.Config.Replace.Verification.Hash.Function != "sha512" || cfg.Ignition.Config.Replace.Verification.Hash.Sum != "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" {
+		t.Fatalf("expected replace verification hash to be preserved, got %#v", cfg.Ignition.Config.Replace.Verification)
+	}
+
+	if len(cfg.Storage.Disks) != 1 || cfg.Storage.Disks[0].Device != "/dev/vda" || !cfg.Storage.Disks[0].WipeTable {
+		t.Fatalf("expected disk fields to be preserved, got %#v", cfg.Storage.Disks)
+	}
+	if len(cfg.Storage.Disks[0].Partitions) != 1 {
+		t.Fatalf("expected 1 partition, got %#v", cfg.Storage.Disks[0].Partitions)
+	}
+	part := cfg.Storage.Disks[0].Partitions[0]
+	if part.Label != "ROOTX" || part.Number != 4 || part.Size != 2097152 || part.Start != 1048576 || part.TypeGUID != "11111111-2222-3333-4444-555555555555" {
+		t.Fatalf("expected partition fields to be preserved, got %#v", part)
+	}
+
+	if len(cfg.Storage.Filesystems) != 1 || cfg.Storage.Filesystems[0].Mount == nil || cfg.Storage.Filesystems[0].Mount.Create == nil {
+		t.Fatalf("expected filesystem mount/create to be preserved, got %#v", cfg.Storage.Filesystems)
+	}
+	mount := cfg.Storage.Filesystems[0].Mount
+	if mount.Device != "/dev/disk/by-partlabel/ROOTX" || mount.Format != "ext4" || !mount.Create.Force || !reflect.DeepEqual([]string(mount.Create.Options), []string{"-L", "ROOTX"}) {
+		t.Fatalf("expected filesystem mount/create fields to be preserved, got %#v", mount)
+	}
+
+	if len(cfg.Storage.Files) != 1 {
+		t.Fatalf("expected 1 file, got %#v", cfg.Storage.Files)
+	}
+	file := cfg.Storage.Files[0]
+	if file.Node.Filesystem != "rootfs" || file.Node.Path != "/etc/example.conf" || file.Node.Mode != 0644 || file.Node.User.Id != 100 || file.Node.Group.Id != 101 {
+		t.Fatalf("expected file node fields to be preserved, got %#v", file.Node)
+	}
+	if file.Contents.Source.String() != "https://example.com/example" {
+		t.Fatalf("expected file contents source to be preserved, got %#v", file.Contents)
+	}
+
+	if len(cfg.Networkd.Units) != 1 || cfg.Networkd.Units[0].Name != "10-eth0.network" || cfg.Networkd.Units[0].Contents != "[Match]\nName=eth0\n" {
+		t.Fatalf("expected networkd unit to be preserved, got %#v", cfg.Networkd.Units)
+	}
+}
+
+func TestParseRejectsInvalidIgnitionV20(t *testing.T) {
+	cfg, rpt, err := Parse([]byte(`{
+		"ignition": {"version": "2.0.0"},
+		"storage": {
+			"disks": [
+				{
+					"device": "/dev/vda",
+					"partitions": [
+						{"number": 1, "start": 1, "size": 4096}
+					]
+				}
+			]
+		}
+	}`))
+	if err == nil {
+		t.Fatalf("expected invalid 2.0.0 config to return an error")
+	}
+	if !reportHasProblem(rpt) {
+		t.Fatalf("expected invalid 2.0.0 config to return an error report, got %#v", rpt)
+	}
+	if !reflect.DeepEqual(cfg, types.Config{}) {
+		t.Fatalf("expected invalid 2.0.0 config to return zero config, got %#v", cfg)
+	}
+}
+
+func reportHasProblem(rpt report.Report) bool {
+	if rpt.IsFatal() {
+		return true
+	}
+	for _, entry := range rpt.Entries {
+		if entry.Kind == report.EntryError {
+			return true
+		}
+	}
+	return false
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+export GOPATH=/root/go
+mkdir -p "$GOPATH/src/github.com/coreos"
+rm -rf "$GOPATH/src/github.com/coreos/ignition"
+cp -a /testbed "$GOPATH/src/github.com/coreos/ignition"
+
+export GO111MODULE=off
+
+
+case "${1:-}" in
+  base)
+    go test \
+      github.com/coreos/ignition/config/types \
+      github.com/coreos/ignition/config/v1/... \
+      github.com/coreos/ignition/config/validate/...
+    ;;
+  new)
+    cd "$GOPATH/src/github.com/coreos/ignition/config"
+    go test $(find . -maxdepth 1 -name '*.go' ! -name '*_test.go' | sort) v20_parse_test.go \
+      -run 'TestParseAcceptsIgnitionV20|TestParseRejectsInvalidIgnitionV20' \
+      -count=1
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
