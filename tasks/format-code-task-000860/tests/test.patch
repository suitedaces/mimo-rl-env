+func TestIndexSupport_LowerCase(t *testing.T) {
+
+	ilmSupportedHandler := newMockClientHandler("7.2.0")
+
+	type tcase struct {
+		name     string
+		cfg      common.MapStr
+		fields   common.MapStr
+		meta     common.MapStr
+		expected string
+	}
+
+	cases := []tcase{
+		{
+			name: "CustomIndexUpperCase",
+
+			cfg: common.MapStr{
+				"apm-server.ilm.enabled":      false,
+				"output.elasticsearch.index": "Apm-CUSTOMIZED",
+			},
+			fields:   common.MapStr{"processor.event": "metric"},
+			expected: "apm-customized",
+		},
+		{
+			name: "CustomIndicesUpperCase",
+
+			cfg: common.MapStr{
+				"apm-server.ilm.enabled": false,
+				"output.elasticsearch.indices": []common.MapStr{{
+					"index": "Apm-CUSTOM-%{[observer.version]}-METRIC",
+					"when": map[string]interface{}{
+						"contains": map[string]interface{}{"processor.event": "metric"}}}},
+			},
+			fields:   common.MapStr{"processor.event": "metric"},
+			expected: "apm-custom-7.0.0-metric",
+		},
+		{
+			name:     "MetaAliasUpperCase",
+			cfg:      common.MapStr{"apm-server.ilm.enabled": false},
+			fields:   common.MapStr{"processor.event": "span"},
+			meta:     common.MapStr{"alias": "APM-7.0.0-Meta"},
+			expected: "apm-7.0.0-meta",
+		},
+		{
+			name:     "MetaIndexUpperCase",
+			cfg:      common.MapStr{"apm-server.ilm.enabled": false},
+			fields:   common.MapStr{"processor.event": "span"},
+			meta:     common.MapStr{"index": "APM-Custom"},
+			expected: fmt.Sprintf("apm-custom-%s", day),
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			supporter := defaultSupporter(t, tc.cfg)
+			supporter.setIlmState(ilmSupportedHandler)
+
+			s, err := supporter.BuildSelector(nil)
+			require.NoError(t, err)
+
+			idx, err := s.Select(testEvent(tc.fields, tc.meta))
+			require.NoError(t, err)
+			assert.Equal(t, tc.expected, idx)
+		})
+	}
+}
+
 func testEvent(fields, meta common.MapStr) *beat.Event {
 	// needs to be set for indices with unmanaged lifecycle (not ILM)
 	// as the version replacement happens on every event and not on initialization
