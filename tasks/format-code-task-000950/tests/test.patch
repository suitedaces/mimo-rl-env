diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,141 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+BIN=/workspace/repo/tools/filter.py
+
+fail() {
+    echo "FAIL: $*" >&2
+    exit 1
+}
+
+[ -x "$BIN" ] || fail "tools/filter.py is not executable"
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || exit 1
+
+assert_file_equals() {
+    local actual=$1
+    local expected=$2
+    local label=$3
+
+    if ! cmp -s "$actual" "$expected"; then
+        echo "FAIL: $label" >&2
+        echo "--- actual ---" >&2
+        sed -n l "$actual" >&2
+        echo "--- expected ---" >&2
+        sed -n l "$expected" >&2
+        exit 1
+    fi
+}
+
+
+
+
+cat > trace.txt <<'EOF'
+X|stale|caller||
+E|main|root|/bin/app|/bin/app
+E|child|main|/bin/app|/bin/app
+X|child|main|/bin/app|/bin/app
+X|main|root|/bin/app|/bin/app
+EOF
+"$BIN" -f trace.txt >out 2>err
+ec=$?
+cat >expected_out <<'EOF'
+E|main|root|main|root|/bin/app|/bin/app
+E|child|main|child|main|/bin/app|/bin/app
+X|child|main|0x0|0x0||
+X|main|root|0x0|0x0||
+EOF
+: >expected_err
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_file_equals out expected_out "F1 stdout"
+assert_file_equals err expected_err "F1 stderr"
+
+
+
+
+cat > trace.txt <<'EOF'
+E|0x401000|0x0|/tmp/a.out|
+X|0x401000|0x0|/tmp/a.out|
+EOF
+"$BIN" -f trace.txt >out 2>err
+ec=$?
+cat >expected_out <<'EOF'
+E|0x401000|0x0|0x401000|0x0|/tmp/a.out|
+X|0x401000|0x0|0x0|0x0||
+EOF
+: >expected_err
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_file_equals out expected_out "F2 stdout"
+assert_file_equals err expected_err "F2 stderr"
+
+
+
+
+cat > trace.txt <<'EOF'
+E|outer|root||
+E|inner|outer||
+X|outer|root||
+EOF
+"$BIN" -f trace.txt >out 2>err
+ec=$?
+cat >expected_out <<'EOF'
+E|outer|root|outer|root||
+E|inner|outer|inner|outer||
+X|inner|outer|0x0|0x0||
+X|outer|root|0x0|0x0||
+EOF
+cat >expected_err <<'EOF'
+Filter - Warning: Incorrect exit func: outer(3), expect: inner(2)
+EOF
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+assert_file_equals out expected_out "F3 stdout"
+assert_file_equals err expected_err "F3 stderr"
+
+
+
+
+cat > trace.txt <<'EOF'
+Q|bad|row||
+EOF
+"$BIN" -f trace.txt >out 2>err
+ec=$?
+: >expected_out
+cat >expected_err <<'EOF'
+Filter - Warning: Incorrect type: Q at line 1, the type must be E or X
+EOF
+[ "$ec" -ne 0 ] || fail "F4 exit $ec; want non-zero"
+assert_file_equals out expected_out "F4 stdout"
+assert_file_equals err expected_err "F4 stderr"
+
+
+
+
+"$BIN" -h >out 2>err
+ec=$?
+cat >expected_out <<'EOF'
+usage: filter.py -f trace.txt
+EOF
+: >expected_err
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+assert_file_equals out expected_out "F5 stdout"
+assert_file_equals err expected_err "F5 stderr"
+
+
+
+
+"$BIN" >out 2>err
+ec=$?
+cat >expected_out <<'EOF'
+usage: filter.py -f trace.txt
+EOF
+: >expected_err
+[ "$ec" -ne 0 ] || fail "F6 exit $ec; want non-zero"
+assert_file_equals out expected_out "F6 stdout"
+assert_file_equals err expected_err "F6 stderr"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
