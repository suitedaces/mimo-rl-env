diff --git a/tests/stream/test_hls_playlist_define.py b/tests/stream/test_hls_playlist_define.py
new file mode 100644
index 00000000..ba0394ca
--- /dev/null
+++ b/tests/stream/test_hls_playlist_define.py
@@ -0,0 +1,133 @@
+from streamlink.stream.hls_playlist import ByteRange, Key, Map, load
+
+
+def test_define_value_exposes_variables():
+    playlist = load(
+        """#EXTM3U
+#EXT-X-DEFINE:NAME="host",VALUE="https://cdn.example.test"
+#EXT-X-DEFINE:NAME="token",VALUE="episode-7"
+""",
+        "https://origin.example.test/live/index.m3u8",
+    )
+
+    assert playlist.variables == {
+        "host": "https://cdn.example.test",
+        "token": "episode-7",
+    }
+
+
+def test_define_value_expands_segment_uri():
+    playlist = load(
+        """#EXTM3U
+#EXT-X-DEFINE:NAME="host",VALUE="https://cdn.example.test"
+#EXT-X-DEFINE:NAME="token",VALUE="episode-7"
+#EXTINF:4,
+{$host}/segments/{$token}.ts
+""",
+        "https://origin.example.test/live/index.m3u8",
+    )
+
+    assert playlist.segments[0].uri == "https://cdn.example.test/segments/episode-7.ts"
+
+
+def test_define_value_expands_key_and_map_uri_attributes():
+    playlist = load(
+        """#EXTM3U
+#EXT-X-DEFINE:NAME="host",VALUE="https://cdn.example.test"
+#EXT-X-DEFINE:NAME="token",VALUE="episode-7"
+#EXT-X-KEY:METHOD=AES-128,URI="{$host}/keys/{$token}.key"
+#EXT-X-MAP:URI="{$host}/init-{$token}.mp4",BYTERANGE="12@4"
+#EXTINF:4,
+segment.ts
+""",
+        "https://origin.example.test/live/index.m3u8",
+    )
+
+    assert playlist.segments[0].key == Key(
+        method="AES-128",
+        uri="https://cdn.example.test/keys/episode-7.key",
+        iv=None,
+        key_format=None,
+        key_format_versions=None,
+    )
+    assert playlist.segments[0].map == Map(
+        uri="https://cdn.example.test/init-episode-7.mp4",
+        byterange=ByteRange(range=12, offset=4),
+    )
+
+
+def test_define_query_param_and_nested_values_expand_master_attributes():
+    playlist = load(
+        """#EXTM3U
+#EXT-X-DEFINE:QUERYPARAM="token"
+#EXT-X-DEFINE:NAME="path",VALUE="v1/{$token}"
+#EXT-X-DEFINE:NAME="language",VALUE="en"
+#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID="{$language}",NAME="{$language}",URI="audio/{$path}.m3u8"
+#EXT-X-STREAM-INF:BANDWIDTH=128000,CODECS="avc1.{$token}",AUDIO="{$language}"
+video/{$path}.m3u8
+""",
+        "https://origin.example.test/master.m3u8?token=abc123",
+    )
+
+    assert playlist.variables == {
+        "token": "abc123",
+        "path": "v1/abc123",
+        "language": "en",
+    }
+
+
+def test_define_nested_values_expand_rendition_and_variant_uris_and_attributes():
+    playlist = load(
+        """#EXTM3U
+#EXT-X-DEFINE:QUERYPARAM="token"
+#EXT-X-DEFINE:NAME="path",VALUE="v1/{$token}"
+#EXT-X-DEFINE:NAME="language",VALUE="en"
+#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID="{$language}",NAME="{$language}",URI="audio/{$path}.m3u8"
+#EXT-X-STREAM-INF:BANDWIDTH=128000,CODECS="avc1.{$token}",AUDIO="{$language}"
+video/{$path}.m3u8
+""",
+        "https://origin.example.test/master.m3u8?token=abc123",
+    )
+
+    assert playlist.media[0].group_id == "en"
+    assert playlist.media[0].name == "en"
+    assert playlist.media[0].uri == "https://origin.example.test/audio/v1/abc123.m3u8"
+    assert playlist.playlists[0].uri == "https://origin.example.test/video/v1/abc123.m3u8"
+    assert playlist.playlists[0].stream_info.codecs == ["avc1.abc123"]
+    assert playlist.playlists[0].stream_info.audio == "en"
+
+
+def test_define_is_ordered_redefinition_is_local_and_missing_names_are_preserved():
+    playlist = load(
+        """#EXTM3U
+#EXT-X-DEFINE:NAME="name",VALUE="old"
+#EXTINF:1,
+{$name}.ts
+#EXT-X-DEFINE:NAME="name",VALUE="new"
+#EXTINF:1,
+{$name}.ts
+#EXTINF:1,
+{$missing}.ts
+""",
+        "https://example.test/live.m3u8",
+    )
+
+    assert [segment.uri for segment in playlist.segments] == [
+        "https://example.test/old.ts",
+        "https://example.test/new.ts",
+        "https://example.test/{$missing}.ts",
+    ]
+
+
+def test_define_missing_query_param_remains_unresolved():
+    playlist = load(
+        """#EXTM3U
+#EXT-X-DEFINE:QUERYPARAM="token"
+#EXTINF:1,
+segment-{$token}.ts
+""",
+        "https://example.test/live.m3u8?other=value",
+    )
+
+    assert playlist.segments[0].uri == "https://example.test/segment-{$token}.ts"
+    assert playlist.variables == {}
