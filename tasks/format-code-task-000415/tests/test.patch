diff --git a/tests/providers/ftp/hooks/test_ftp.py b/tests/providers/ftp/hooks/test_ftp.py
index 2f4239b243..ebc44f0565 100644
--- a/tests/providers/ftp/hooks/test_ftp.py
+++ b/tests/providers/ftp/hooks/test_ftp.py
@@ -183,3 +183,143 @@ class TestIntegrationFTPHook:
         from airflow.providers.ftp.hooks.ftp import FTPSHook
 
         self._test_mode(FTPSHook, "ftp_active", False)
+
+
+@pytest.mark.db_test
+class TestFTPHookPort:
+    """Verify that FTPHook.get_conn honors the port set on the Connection."""
+
+    def setup_method(self):
+        from airflow.models import Connection
+        from airflow.utils import db
+
+        db.merge_conn(
+            Connection(
+                conn_id="ftp_custom_port",
+                conn_type="ftp",
+                host="some-ftp-host",
+                login="user",
+                password="pwd",
+                port=2121,
+            )
+        )
+        db.merge_conn(
+            Connection(
+                conn_id="ftp_no_port",
+                conn_type="ftp",
+                host="some-ftp-host",
+                login="user",
+                password="pwd",
+            )
+        )
+
+    @mock.patch("ftplib.FTP")
+    def test_ftp_get_conn_uses_custom_port(self, mock_ftp):
+        """When Connection.port is set, FTPHook must propagate it to the FTP server."""
+        from airflow.providers.ftp.hooks.ftp import FTPHook
+
+        hook = FTPHook("ftp_custom_port")
+        hook.get_conn()
+
+        mock_ftp.return_value.connect.assert_called_once()
+        call_args = mock_ftp.return_value.connect.call_args
+
+        port_value = None
+        host_value = None
+        if len(call_args.args) >= 1:
+            host_value = call_args.args[0]
+        if len(call_args.args) >= 2:
+            port_value = call_args.args[1]
+        if "host" in call_args.kwargs:
+            host_value = call_args.kwargs["host"]
+        if "port" in call_args.kwargs:
+            port_value = call_args.kwargs["port"]
+
+        assert host_value == "some-ftp-host"
+        assert port_value == 2121, (
+            f"Expected FTP.connect to be called with port=2121, got port={port_value!r} "
+            f"(full call: {call_args!r})"
+        )
+
+    @mock.patch("ftplib.FTP")
+    def test_ftp_get_conn_default_port_when_unset(self, mock_ftp):
+        """When Connection.port is not set, FTPHook must still produce a working
+        connection on the default FTP port (21). Any of these are valid:
+          - connect(host)            (lets ftplib use self.port == FTP_PORT)
+          - connect(host, 21)
+          - connect(host, 0)         (ftplib treats port=0 as "keep self.port")
+        """
+        import ftplib as _ftplib
+
+        from airflow.providers.ftp.hooks.ftp import FTPHook
+
+        hook = FTPHook("ftp_no_port")
+        hook.get_conn()
+
+        mock_ftp.return_value.connect.assert_called_once()
+        call_args = mock_ftp.return_value.connect.call_args
+
+
+        host_value = None
+        port_value = "<unset>"
+        if len(call_args.args) >= 1:
+            host_value = call_args.args[0]
+        if len(call_args.args) >= 2:
+            port_value = call_args.args[1]
+        if "host" in call_args.kwargs:
+            host_value = call_args.kwargs["host"]
+        if "port" in call_args.kwargs:
+            port_value = call_args.kwargs["port"]
+
+        assert host_value == "some-ftp-host"
+
+        assert port_value in ("<unset>", 0, None, _ftplib.FTP_PORT), (
+            f"Default-port connection produced unexpected port arg: {port_value!r}"
+        )
+
+    @mock.patch("ftplib.FTP")
+    def test_ftp_get_conn_custom_port_does_not_use_constructor_host(self, mock_ftp):
+        """The fix should build FTP() without immediately constructing it with the
+        host (the buggy form ``FTP(host, login, password)`` ignores port). Verify the
+        connection is established explicitly via FTP().connect(...) so the custom port
+        actually reaches the server.
+        """
+        from airflow.providers.ftp.hooks.ftp import FTPHook
+
+        hook = FTPHook("ftp_custom_port")
+        hook.get_conn()
+
+
+
+
+        mock_ftp.return_value.connect.assert_called_once()
+
+        call_args = mock_ftp.return_value.connect.call_args
+        all_values = list(call_args.args) + list(call_args.kwargs.values())
+        assert 2121 in all_values, (
+            f"Port 2121 was not propagated to FTP.connect (got args={call_args!r})"
+        )
+
+    @mock.patch("ftplib.FTP")
+    def test_ftp_get_conn_passive_mode_preserved_with_custom_port(self, mock_ftp):
+        """Passive-mode behavior must continue to work when a custom port is set."""
+        from airflow.models import Connection
+        from airflow.providers.ftp.hooks.ftp import FTPHook
+        from airflow.utils import db
+
+        db.merge_conn(
+            Connection(
+                conn_id="ftp_custom_port_active",
+                conn_type="ftp",
+                host="some-ftp-host",
+                login="user",
+                password="pwd",
+                port=2121,
+                extra='{"passive": false}',
+            )
+        )
+
+        hook = FTPHook("ftp_custom_port_active")
+        conn = hook.get_conn()
+
+        conn.set_pasv.assert_called_once_with(False)
