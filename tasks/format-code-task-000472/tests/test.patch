diff --git a/specutils/tests/test_region_extract.py b/specutils/tests/test_region_extract.py
index 96789038..96de3017 100644
--- a/specutils/tests/test_region_extract.py
+++ b/specutils/tests/test_region_extract.py
@@ -265,3 +265,137 @@ def test_slab_multid_flux():
 
     assert extracted.shape == (10, 11)
     assert extracted[0,0].flux == spec[0,9].flux
+
+
+def test_return_single_spectrum_default_returns_list():
+    """Default behavior preserved: multi-region returns list of Spectrum1D."""
+    spec = Spectrum1D(spectral_axis=np.arange(50) * u.nm,
+                      flux=np.arange(50) * u.Jy)
+    region = SpectralRegion([(5 * u.nm, 10 * u.nm), (20 * u.nm, 25 * u.nm)])
+
+    result = extract_region(spec, region)
+
+    assert isinstance(result, list)
+    assert len(result) == 2
+    assert isinstance(result[0], Spectrum1D)
+    assert isinstance(result[1], Spectrum1D)
+
+
+def test_return_single_spectrum_true_returns_spectrum1d():
+    """return_single_spectrum=True returns a single Spectrum1D, not a list."""
+    spec = Spectrum1D(spectral_axis=np.arange(50) * u.nm,
+                      flux=np.arange(50) * u.Jy)
+    region = SpectralRegion([(5 * u.nm, 10 * u.nm), (20 * u.nm, 25 * u.nm)])
+
+    result = extract_region(spec, region, return_single_spectrum=True)
+
+    assert isinstance(result, Spectrum1D)
+    assert not isinstance(result, list)
+
+
+def test_return_single_spectrum_flux_concatenated():
+    """Flux array should be concatenation of all sub-regions' fluxes."""
+    spec = Spectrum1D(spectral_axis=np.arange(50) * u.nm,
+                      flux=np.arange(50) * u.Jy)
+    region = SpectralRegion([(5 * u.nm, 10 * u.nm), (20 * u.nm, 25 * u.nm)])
+
+    result = extract_region(spec, region, return_single_spectrum=True)
+
+    expected_flux = np.array([5., 6., 7., 8., 9., 10.,
+                              20., 21., 22., 23., 24., 25.])
+    assert quantity_allclose(result.flux, expected_flux * u.Jy)
+
+
+def test_return_single_spectrum_spectral_axis_concatenated():
+    """Spectral axis should contain values from all sub-regions."""
+    spec = Spectrum1D(spectral_axis=np.arange(50) * u.nm,
+                      flux=np.arange(50) * u.Jy)
+    region = SpectralRegion([(5 * u.nm, 10 * u.nm), (20 * u.nm, 25 * u.nm)])
+
+    result = extract_region(spec, region, return_single_spectrum=True)
+
+    expected_axis = np.array([5., 6., 7., 8., 9., 10.,
+                              20., 21., 22., 23., 24., 25.])
+    assert quantity_allclose(result.spectral_axis, expected_axis * u.nm)
+
+
+def test_return_single_spectrum_length_sum_of_subregions():
+    """Length of returned spectrum equals the sum of sub-region lengths."""
+    spec = Spectrum1D(spectral_axis=np.arange(50) * u.nm,
+                      flux=np.arange(50) * u.Jy)
+    region = SpectralRegion([(5 * u.nm, 10 * u.nm), (20 * u.nm, 25 * u.nm)])
+
+    list_result = extract_region(spec, region)
+    expected_len = len(list_result[0].spectral_axis) + len(list_result[1].spectral_axis)
+
+    single_result = extract_region(spec, region, return_single_spectrum=True)
+
+    assert len(single_result.spectral_axis) == expected_len
+    assert len(single_result.flux) == expected_len
+
+
+def test_return_single_spectrum_with_uncertainty():
+    """Uncertainty is concatenated when return_single_spectrum=True."""
+    flux = np.arange(50, dtype=float) * u.Jy
+    uncert = StdDevUncertainty(0.1 * np.arange(50, dtype=float))
+    spec = Spectrum1D(spectral_axis=np.arange(50) * u.nm,
+                      flux=flux, uncertainty=uncert)
+    region = SpectralRegion([(5 * u.nm, 10 * u.nm), (20 * u.nm, 25 * u.nm)])
+
+    result = extract_region(spec, region, return_single_spectrum=True)
+
+    assert result.uncertainty is not None
+    expected = np.array([0.5, 0.6, 0.7, 0.8, 0.9, 1.0,
+                         2.0, 2.1, 2.2, 2.3, 2.4, 2.5])
+    assert np.allclose(result.uncertainty.array, expected)
+
+
+def test_return_single_spectrum_with_mask():
+    """Mask is concatenated when return_single_spectrum=True."""
+    mask = np.zeros(50, dtype=bool)
+
+    mask[7] = True
+    mask[22] = True
+    spec = Spectrum1D(spectral_axis=np.arange(50) * u.nm,
+                      flux=np.arange(50) * u.Jy,
+                      mask=mask)
+    region = SpectralRegion([(5 * u.nm, 10 * u.nm), (20 * u.nm, 25 * u.nm)])
+
+    result = extract_region(spec, region, return_single_spectrum=True)
+
+    assert result.mask is not None
+
+
+    expected_mask = np.zeros(12, dtype=bool)
+    expected_mask[2] = True
+    expected_mask[8] = True
+    assert np.array_equal(np.asarray(result.mask), expected_mask)
+
+
+def test_return_single_spectrum_single_subregion():
+    """Single-subregion case still returns a Spectrum1D when flag is True."""
+    spec = Spectrum1D(spectral_axis=np.arange(50) * u.nm,
+                      flux=np.arange(50) * u.Jy)
+    region = SpectralRegion(5 * u.nm, 10 * u.nm)
+
+    result = extract_region(spec, region, return_single_spectrum=True)
+
+    assert isinstance(result, Spectrum1D)
+    assert quantity_allclose(result.flux,
+                             np.array([5., 6., 7., 8., 9., 10.]) * u.Jy)
+
+
+def test_return_single_spectrum_three_subregions():
+    """Three sub-regions concatenated correctly into a single spectrum."""
+    spec = Spectrum1D(spectral_axis=np.arange(50) * u.nm,
+                      flux=np.arange(50) * u.Jy)
+    region = SpectralRegion([(2 * u.nm, 4 * u.nm),
+                             (10 * u.nm, 12 * u.nm),
+                             (30 * u.nm, 32 * u.nm)])
+
+    result = extract_region(spec, region, return_single_spectrum=True)
+
+    assert isinstance(result, Spectrum1D)
+    expected_flux = np.array([2., 3., 4., 10., 11., 12., 30., 31., 32.])
+    assert quantity_allclose(result.flux, expected_flux * u.Jy)
+    assert quantity_allclose(result.spectral_axis, expected_flux * u.nm)
