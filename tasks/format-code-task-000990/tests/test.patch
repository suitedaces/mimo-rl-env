+<?php
+
+namespace Spatie\Sluggable\Test\Integration;
+
+use Illuminate\Database\Schema\Blueprint;
+use Spatie\Sluggable\InvalidOption;
+use Spatie\Sluggable\SlugOptions;
+
+class SingleScopeCodespecModel extends TestModel
+{
+    public function getSlugOptions() : SlugOptions
+    {
+        return SlugOptions::create()
+            ->generateSlugsFrom('name')
+            ->saveSlugsTo('url')
+            ->scopeUniqueSlugsBy('tenant_id');
+    }
+}
+
+class CompoundScopeCodespecModel extends TestModel
+{
+    public function getSlugOptions() : SlugOptions
+    {
+        return SlugOptions::create()
+            ->generateSlugsFrom('name')
+            ->saveSlugsTo('url')
+            ->scopeUniqueSlugsBy(['tenant_id', 'locale_code']);
+    }
+}
+
+class DuplicateScopeCodespecModel extends TestModel
+{
+    public function getSlugOptions() : SlugOptions
+    {
+        return SlugOptions::create()
+            ->generateSlugsFrom('name')
+            ->saveSlugsTo('url')
+            ->scopeUniqueSlugsBy('tenant_id')
+            ->allowDuplicateSlugs();
+    }
+}
+
+class ScopedUniqueSlugsCodespecTest extends TestCase
+{
+    public function setUp()
+    {
+        parent::setUp();
+
+        $this->app['db']->connection()->getSchemaBuilder()->table('test_models', function (Blueprint $table) {
+            $table->integer('tenant_id')->nullable();
+            $table->string('locale_code')->nullable();
+        });
+    }
+
+    /** @test */
+    public function the_scope_option_is_a_public_fluent_api()
+    {
+        $options = SlugOptions::create();
+        $methodExists = method_exists($options, 'scopeUniqueSlugsBy');
+
+        $this->assertTrue($methodExists, 'SlugOptions must expose scopeUniqueSlugsBy().');
+
+        if ($methodExists) {
+            $this->assertSame($options, $options->scopeUniqueSlugsBy('tenant_id'));
+        }
+    }
+
+    /** @test */
+    public function an_empty_scope_list_is_rejected_before_persistence()
+    {
+        if (!$this->scopeApiIsAvailable()) {
+            return;
+        }
+
+        $this->assertInvalidScope([]);
+    }
+
+    /** @test */
+    public function a_blank_single_scope_field_is_rejected_before_persistence()
+    {
+        if (!$this->scopeApiIsAvailable()) {
+            return;
+        }
+
+        $this->assertInvalidScope('');
+    }
+
+    /** @test */
+    public function a_blank_compound_scope_field_is_rejected_before_persistence()
+    {
+        if (!$this->scopeApiIsAvailable()) {
+            return;
+        }
+
+        $this->assertInvalidScope(['tenant_id', '']);
+    }
+
+    /** @test */
+    public function equal_slugs_are_available_in_different_single_field_scopes()
+    {
+        if (!$this->scopeApiIsAvailable()) {
+            return;
+        }
+
+        $first = $this->createSingleScopedModel('Release Notes', 10);
+        $second = $this->createSingleScopedModel('Release Notes', 20);
+
+        $this->assertSame('release-notes', SingleScopeCodespecModel::find($first->id)->url);
+        $this->assertSame('release-notes', SingleScopeCodespecModel::find($second->id)->url);
+    }
+
+    /** @test */
+    public function collisions_inside_one_scope_receive_the_normal_suffix()
+    {
+        if (!$this->scopeApiIsAvailable()) {
+            return;
+        }
+
+        $this->createSingleScopedModel('Release Notes', 10);
+        $second = $this->createSingleScopedModel('Release Notes', 10);
+
+        $this->assertSame('release-notes-1', SingleScopeCodespecModel::find($second->id)->url);
+    }
+
+    /** @test */
+    public function every_compound_scope_field_must_match_for_a_collision()
+    {
+        if (!$this->scopeApiIsAvailable()) {
+            return;
+        }
+
+        $this->createCompoundScopedModel('Guide', 10, 'en');
+        $differentLocale = $this->createCompoundScopedModel('Guide', 10, 'fr');
+        $differentTenant = $this->createCompoundScopedModel('Guide', 20, 'en');
+        $sameScope = $this->createCompoundScopedModel('Guide', 10, 'en');
+
+        $this->assertSame('guide', CompoundScopeCodespecModel::find($differentLocale->id)->url);
+        $this->assertSame('guide', CompoundScopeCodespecModel::find($differentTenant->id)->url);
+        $this->assertSame('guide-1', CompoundScopeCodespecModel::find($sameScope->id)->url);
+    }
+
+    /** @test */
+    public function null_scope_values_match_each_other_but_not_non_null_values()
+    {
+        if (!$this->scopeApiIsAvailable()) {
+            return;
+        }
+
+        $this->createSingleScopedModel('Draft', null);
+        $secondNull = $this->createSingleScopedModel('Draft', null);
+        $numberedTenant = $this->createSingleScopedModel('Draft', 10);
+
+        $this->assertSame('draft-1', SingleScopeCodespecModel::find($secondNull->id)->url);
+        $this->assertSame('draft', SingleScopeCodespecModel::find($numberedTenant->id)->url);
+    }
+
+    /** @test */
+    public function moving_a_model_uses_its_destination_scope_for_uniqueness()
+    {
+        if (!$this->scopeApiIsAvailable()) {
+            return;
+        }
+
+        $this->createSingleScopedModel('Handbook', 10);
+        $moving = $this->createSingleScopedModel('Handbook', 20);
+
+        $moving->tenant_id = 10;
+        $moving->save();
+
+        $this->assertSame('handbook-1', SingleScopeCodespecModel::find($moving->id)->url);
+    }
+
+    /** @test */
+    public function an_update_does_not_treat_the_current_model_as_a_collision()
+    {
+        if (!$this->scopeApiIsAvailable()) {
+            return;
+        }
+
+        $this->createSingleScopedModel('Handbook', 10);
+        $second = $this->createSingleScopedModel('Handbook', 10);
+
+        $second->other_field = 'edited';
+        $second->save();
+
+        $this->assertSame('handbook-1', SingleScopeCodespecModel::find($second->id)->url);
+    }
+
+    /** @test */
+    public function duplicate_mode_still_bypasses_scoped_uniqueness()
+    {
+        if (!$this->scopeApiIsAvailable()) {
+            return;
+        }
+
+        $first = $this->createDuplicateScopedModel('Bulletin', 10);
+        $second = $this->createDuplicateScopedModel('Bulletin', 10);
+
+        $this->assertSame('bulletin', DuplicateScopeCodespecModel::find($first->id)->url);
+        $this->assertSame('bulletin', DuplicateScopeCodespecModel::find($second->id)->url);
+    }
+
+    private function scopeApiIsAvailable() : bool
+    {
+        return method_exists(SlugOptions::class, 'scopeUniqueSlugsBy');
+    }
+
+    private function assertInvalidScope($scopeFields)
+    {
+        try {
+            $options = SlugOptions::create()
+                ->generateSlugsFrom('name')
+                ->saveSlugsTo('url')
+                ->scopeUniqueSlugsBy($scopeFields);
+
+            $model = new TestModel();
+            $model->setSlugOptions($options);
+            $model->name = 'Invalid scope';
+            $model->save();
+            $this->fail('Saving with an invalid uniqueness scope must throw InvalidOption.');
+        } catch (InvalidOption $exception) {
+            $this->assertSame(0, TestModel::count());
+        }
+    }
+
+    private function createSingleScopedModel(string $name, $tenantId) : SingleScopeCodespecModel
+    {
+        $model = new SingleScopeCodespecModel();
+        $model->name = $name;
+        $model->tenant_id = $tenantId;
+        $model->save();
+
+        return $model;
+    }
+
+    private function createCompoundScopedModel(string $name, $tenantId, string $locale) : CompoundScopeCodespecModel
+    {
+        $model = new CompoundScopeCodespecModel();
+        $model->name = $name;
+        $model->tenant_id = $tenantId;
+        $model->locale_code = $locale;
+        $model->save();
+
+        return $model;
+    }
+
+    private function createDuplicateScopedModel(string $name, $tenantId) : DuplicateScopeCodespecModel
+    {
+        $model = new DuplicateScopeCodespecModel();
+        $model->name = $name;
+        $model->tenant_id = $tenantId;
+        $model->save();
+
+        return $model;
+    }
+}

