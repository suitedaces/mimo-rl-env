+
+async def test_report_speaker_volume_no_level(hass):
+    """Speaker volume should not be reported when volume_level is missing.
+
+    Regression test for a TypeError raised when current_level was None.
+    """
+    hass.states.async_set(
+        "media_player.test_speaker_none",
+        "on",
+        {
+            "friendly_name": "Test speaker no volume",
+            "supported_features": SUPPORT_VOLUME_MUTE | SUPPORT_VOLUME_SET,
+            "volume_level": None,
+            "device_class": "speaker",
+        },
+    )
+
+    properties = await reported_properties(hass, "media_player#test_speaker_none")
+    properties.assert_not_has_property("Alexa.Speaker", "volume")
+
+
+async def test_report_speaker_volume_typical(hass):
+    """Speaker volume reports volume_level as 0-100."""
+    hass.states.async_set(
+        "media_player.test_speaker_typical",
+        "on",
+        {
+            "friendly_name": "Test speaker typical",
+            "supported_features": SUPPORT_VOLUME_MUTE | SUPPORT_VOLUME_SET,
+            "volume_level": 0.75,
+            "device_class": "speaker",
+        },
+    )
+
+    properties = await reported_properties(hass, "media_player#test_speaker_typical")
+    properties.assert_equal("Alexa.Speaker", "volume", 75)
+
+
+async def test_report_speaker_volume_zero(hass):
+    """Speaker volume of 0 is reported as 0."""
+    hass.states.async_set(
+        "media_player.test_speaker_zero",
+        "on",
+        {
+            "friendly_name": "Test speaker zero",
+            "supported_features": SUPPORT_VOLUME_MUTE | SUPPORT_VOLUME_SET,
+            "volume_level": 0,
+            "device_class": "speaker",
+        },
+    )
+
+    properties = await reported_properties(hass, "media_player#test_speaker_zero")
+    properties.assert_equal("Alexa.Speaker", "volume", 0)
