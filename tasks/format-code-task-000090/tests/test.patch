@@ -0,0 +1,33 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+dev-switch python3 3.12 2>/dev/null || true
+python3 -m pip install --break-system-packages -q -e . 2>/dev/null
+python3 -m pip install --break-system-packages -q pytest 2>/dev/null
+SITECUSTOMIZE=$(python3 -c "import site; print([p for p in site.getsitepackages() if 'dist-packages' in p][0])")/sitecustomize.py
+if ! grep -q "collections.abc" "$SITECUSTOMIZE" 2>/dev/null; then
+    cat >> "$SITECUSTOMIZE" <<'PATCH'
+
+# Monkey-patch for older code that uses collections.Iterable (removed in Python 3.10)
+import collections, collections.abc
+for _name in ('Iterable', 'Mapping', 'MutableMapping', 'MutableSet', 'Callable'):
+    if not hasattr(collections, _name):
+        setattr(collections, _name, getattr(collections.abc, _name))
+PATCH
+fi
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest tests/tests_server.py tests/tests_subscriptions.py -v -k 'not event'
+    ;;
+  new)
+    python3 -m pytest tests/test_event_emitting_node.py -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
