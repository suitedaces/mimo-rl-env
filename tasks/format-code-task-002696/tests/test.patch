+++ b/tests/test_cmd_signature.py
@@ -945,3 +945,72 @@ def test_import_export_2(c):
     compare = sourmash.load_one_signature(sig1, ksize=21, select_moltype='DNA')
 
     assert imported.minhash == compare.minhash
+
+
+
+
+
+def test_signature_alias_not_invalid_choice():
+
+
+    status, out, err = utils.runscript('sourmash', ['signature'], fail_ok=True)
+    combined = (out or '') + (err or '')
+    assert "invalid choice: 'signature'" not in combined, combined
+
+
+def test_signature_alias_merge_missing_arg_message():
+
+
+
+    status, out, err = utils.runscript(
+        'sourmash', ['signature', 'merge'], fail_ok=True)
+    combined = (out or '') + (err or '')
+    assert status != 0
+    assert "invalid choice: 'signature'" not in combined, combined
+    assert "the following arguments are required: signatures" in combined, combined
+
+
+def test_sig_alias_merge_missing_arg_message():
+
+    status, out, err = utils.runscript(
+        'sourmash', ['sig', 'merge'], fail_ok=True)
+    combined = (out or '') + (err or '')
+    assert status != 0
+    assert "the following arguments are required: signatures" in combined, combined
+
+
+@utils.in_tempdir
+def test_signature_alias_merge_executes(c):
+
+
+    sig47 = utils.get_test_data('47.fa.sig')
+    sig63 = utils.get_test_data('63.fa.sig')
+    sig47and63 = utils.get_test_data('47+63.fa.sig')
+
+    c.run_sourmash('signature', 'merge', sig47, sig63)
+    out = c.last_result.out
+
+    test_merge_sig = sourmash.load_one_signature(sig47and63)
+    actual_merge_sig = sourmash.load_one_signature(out)
+
+    assert actual_merge_sig.minhash == test_merge_sig.minhash
+
+
+@utils.in_tempdir
+def test_signature_alias_describe_executes(c):
+
+    sig47 = utils.get_test_data('47.fa.sig')
+    c.run_sourmash('signature', 'describe', sig47)
+    out = c.last_result.out
+
+    assert '47.fa.sig' in out
+
+
+def test_signature_alias_help_lists_merge():
+
+    status, out, err = utils.runscript(
+        'sourmash', ['signature', '--help'], fail_ok=True)
+    combined = (out or '') + (err or '')
+    assert status == 0
+    assert "invalid choice: 'signature'" not in combined, combined
+    assert 'merge' in combined, combined
