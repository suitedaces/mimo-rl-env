+    def test_sign_plus_issue_reproduction(self):
+
+        r = parse.parse('{:+05d}', '+1234')
+        self.assertIsNotNone(r)
+        self.assertEqual(r.fixed[0], 1234)
+
+    def test_sign_plus_only_positive(self):
+
+        r = parse.parse('{:+d}', '12')
+        self.assertIsNotNone(r)
+        self.assertEqual(r.fixed[0], 12)
+
+    def test_sign_plus_only_with_explicit_plus(self):
+
+        r = parse.parse('{:+d}', '+12')
+        self.assertIsNotNone(r)
+        self.assertEqual(r.fixed[0], 12)
+
+    def test_sign_plus_allows_negative(self):
+
+        r = parse.parse('{:+d}', '-12')
+        self.assertIsNotNone(r)
+        self.assertEqual(r.fixed[0], -12)
+
+    def test_sign_minus_only(self):
+
+        r = parse.parse('{:-d}', '12')
+        self.assertIsNotNone(r)
+        self.assertEqual(r.fixed[0], 12)
+
+    def test_sign_space_only(self):
+
+        r = parse.parse('{: d}', '12')
+        self.assertIsNotNone(r)
+        self.assertEqual(r.fixed[0], 12)
+
+    def test_sign_plus_zero_width_negative(self):
+
+        r = parse.parse('{:+05d}', '-1234')
+        self.assertIsNotNone(r)
+        self.assertEqual(r.fixed[0], -1234)
+
+    def test_sign_minus_with_zero_pad(self):
+
+        r = parse.parse('{:-05d}', '00012')
+        self.assertIsNotNone(r)
+        self.assertEqual(r.fixed[0], 12)
+
+    def test_sign_plus_with_float(self):
+
+        r = parse.parse('{:+f}', '+1.5')
+        self.assertIsNotNone(r)
+        self.assertEqual(r.fixed[0], 1.5)
+
+    def test_sign_plus_with_align(self):
+
+        r = parse.parse('{:>+5d}', '   12')
+        self.assertIsNotNone(r)
+        self.assertEqual(r.fixed[0], 12)
+
+    def test_sign_plus_with_fill_and_align(self):
+
+        r = parse.parse('{:0>+5d}', '00012')
+        self.assertIsNotNone(r)
+        self.assertEqual(r.fixed[0], 12)
+
+    def test_no_sign_preservation_zero_pad(self):
+
+        r = parse.parse('{:05d}', '00012')
+        self.assertIsNotNone(r)
+        self.assertEqual(r.fixed[0], 12)
+
+    def test_no_sign_preservation_plain_d(self):
+
+        r = parse.parse('{:d}', '12')
+        self.assertIsNotNone(r)
+        self.assertEqual(r.fixed[0], 12)
+
+    def test_unknown_spec_still_raises(self):
+
+
+        with self.assertRaises(ValueError):
+            parse.parse('{:#d}', '12')
+
 
