--- /dev/null
+++ b/cmd/boulder-wfe/config_test.go
@@ -0,0 +1,19 @@
+package main
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestWFEConfigDoesNotExposeAcceptRevocationReason(t *testing.T) {
+	configType := reflect.TypeOf(config{})
+	wfeField, ok := configType.FieldByName("WFE")
+	if !ok {
+		t.Fatal("config type does not expose WFE section")
+	}
+
+
+	if _, ok := wfeField.Type.FieldByName("AcceptRevocationReason"); ok {
+		t.Fatal("WFE config still exposes AcceptRevocationReason")
+	}
+}
