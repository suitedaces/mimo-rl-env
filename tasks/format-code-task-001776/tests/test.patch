diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,23 @@
+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+
+
+
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 ./wfe/ ./wfe2/
+    ;;
+  new)
+    go test -v -count=1 ./wfe/ -run '^(TestRevokeCertificateCertKey|TestRevokeCertificateReasons)$'
+    go test -v -count=1 ./wfe2/ -run '^(TestRevokeCertificateCertKey|TestRevokeCertificateReasons)$'
+    go test -v -count=1 ./cmd/boulder-wfe/ -run '^TestWFEConfigDoesNotExposeAcceptRevocationReason$'
+    go test -v -count=1 ./cmd/boulder-wfe2/ -run '^TestWFEConfigDoesNotExposeAcceptRevocationReason$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
