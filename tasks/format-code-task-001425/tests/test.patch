+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+ln -sfn /workspace/repo /workspace/htk
+cd /workspace/repo
+
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+export PIP_NO_INDEX=1
+export PYTHONPATH="/workspace:/workspace/repo:${PYTHONPATH:-}"
+exec python -m pytest /workspace/repo/usercase-test-coderl/test_stripe_subscription_lifecycle.py -v
