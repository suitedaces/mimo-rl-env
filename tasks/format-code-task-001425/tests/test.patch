+
+def test_change_subscription_plan_rejects_unsupported_type(stripe_backend):
+
+
+
+    customer = make_customer()
+    created = customer.create_subscription("price_basic", invoice=False)
+    subscription_id = created["id"]
+
+    with pytest.raises(Exception) as excinfo:
+        customer.change_subscription_plan(subscription_id, 42)
