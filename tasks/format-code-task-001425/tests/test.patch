+    assert excinfo.type is Exception
+
+    assert "unsupported" in str(excinfo.value).lower()
+    assert "int" in str(excinfo.value).lower()
+    assert_no_calls_named(stripe_backend, "subscription.modify")
+    assert_no_calls_named(stripe_backend, "invoice.create")
+    assert_no_calls_named(stripe_backend, "invoice.pay")
+
+
+def test_free_upgrade_or_downgrade_disables_proration_and_invoice(
+    stripe_backend,
+):
+
+
+
+    customer = make_customer()
+    created = customer.create_subscription("price_basic", invoice=False)
+    subscription_id = created["id"]
+    item_id = created["items"]["data"][0]["id"]
+
+    updated = customer.free_upgrade_or_downgrade(subscription_id, "price_free")
+
+
+    assert_single_item_subscription(updated, "cus_fixture", {"price": "price_free"})
+    assert updated["id"] == subscription_id
+    assert updated["status"] == "active"
+    assert updated["proration_behavior"] == "none"
+    assert_call_present(stripe_backend, ("subscription.retrieve", subscription_id))
+    assert_call_present(
+        stripe_backend,
+        (
+            "subscription.modify",
+            subscription_id,
+            {
+                "items": [{"id": item_id, "price": "price_free"}],
+                "proration_behavior": "none",
+            },
+        ),
+    )
+    assert_no_calls_named(stripe_backend, "invoice.create")
+    assert_no_calls_named(stripe_backend, "invoice.pay")
+
+
+def test_cancel_subscription_active_already_canceled_and_missing(
+    stripe_backend,
+):
+
+
+
+    customer = make_customer()
+    created = customer.create_subscription("price_basic", invoice=False)
+    subscription_id = created["id"]
+
+
+    assert customer.cancel_subscription(subscription_id) is True
+    retrieved = customer.retrieve_subscription(subscription_id)
+    assert_single_item_subscription(retrieved, "cus_fixture", {"price": "price_basic"})
+    assert retrieved["id"] == subscription_id
+    assert retrieved["status"] == "canceled"
+    assert customer.cancel_subscription(subscription_id) is True
+    assert customer.cancel_subscription("sub_missing") is False
+    assert_call_present(stripe_backend, ("subscription.delete", subscription_id))
+
+
+def test_live_mode_customer_initializes_live_key(stripe_backend):
+
+
+
+    customer = make_customer(stripe_id="cus_live", live_mode=True)
+
+    subscription = customer.create_subscription("price_live", invoice=False)
+
+
+    assert_single_item_subscription(subscription, "cus_live", {"price": "price_live"})
+    assert subscription["status"] == "active"
+    assert stripe.api_key == "sk_live_fixture"
+    assert_call_present(
+        stripe_backend,
+        (
+            "subscription.create",
+            {
+                "customer": "cus_live",
+                "items": [{"price": "price_live"}],
+            },
+        ),
+    )
+    assert_no_calls_named(stripe_backend, "invoice.create")
+    assert_no_calls_named(stripe_backend, "invoice.pay")
+
+
+def test_two_customers_keep_subscription_state_independent(stripe_backend):
+
+
+
+    customer_a = make_customer(stripe_id="cus_alpha")
+    customer_b = make_customer(stripe_id="cus_beta")
+
+    subscription_a = customer_a.create_subscription("price_alpha", invoice=False)
+    subscription_b = customer_b.create_subscription("price_beta", invoice=False)
+    canceled_a = customer_a.cancel_subscription(subscription_a["id"])
+
+
+    assert_single_item_subscription(subscription_a, "cus_alpha", {"price": "price_alpha"})
+    assert_single_item_subscription(subscription_b, "cus_beta", {"price": "price_beta"})
+    assert subscription_a["id"] != subscription_b["id"]
+    assert subscription_a["status"] == "active"
+    assert subscription_b["status"] == "active"
+    assert canceled_a is True
+    retrieved_a = customer_a.retrieve_subscription(subscription_a["id"])
+    retrieved_b = customer_b.retrieve_subscription(subscription_b["id"])
+    assert_single_item_subscription(retrieved_a, "cus_alpha", {"price": "price_alpha"})
+    assert_single_item_subscription(retrieved_b, "cus_beta", {"price": "price_beta"})
+    assert retrieved_a["status"] == "canceled"
+    assert retrieved_b["status"] == "active"
+
+
+def test_repeated_create_and_cancel_cycles_leave_no_active_subscriptions(
+    stripe_backend,
+):
+
+
+
+    for index in range(100):
+        customer = make_customer(stripe_id=f"cus_cycle_{index:03d}")
+        subscription = customer.create_subscription("price_basic", invoice=False)
+
+        assert subscription["id"]
+        assert customer.cancel_subscription(subscription["id"]) is True
+
+    assert stripe_backend.active_subscription_count() == 0
+
+    assert sum(1 for call in stripe_backend.calls if call[0] == "subscription.create") == 100
