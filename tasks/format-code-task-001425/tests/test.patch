+def test_change_subscription_plan_missing_subscription_returns_none(
+    stripe_backend,
+):
+
+
+
+    customer = make_customer()
+
+
+    assert customer.change_subscription_plan("sub_missing", "price_pro") is None
+    assert_call_present(stripe_backend, ("subscription.retrieve", "sub_missing"))
+    assert_no_calls_named(stripe_backend, "subscription.modify")
+    assert_no_calls_named(stripe_backend, "invoice.create")
