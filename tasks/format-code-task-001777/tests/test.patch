+func TestDirectoryGETPreserved(t *testing.T) {
+	wfe, _ := setupWFE(t)
+	mux := wfe.Handler()
+	core.RandReader = fakeRand{}
+	defer func() { core.RandReader = rand.Reader }()
+
+	req := &http.Request{
+		Method: "GET",
+		URL:    mustParseURL(directoryPath),
+		Host:   "localhost",
+	}
+	responseWriter := httptest.NewRecorder()
+	mux.ServeHTTP(responseWriter, req)
+	test.AssertEquals(t, responseWriter.Code, http.StatusOK)
+	test.AssertEquals(t, responseWriter.Header().Get("Content-Type"), "application/json")
+	test.Assert(t, strings.Contains(responseWriter.Body.String(), `"newAccount"`),
+		"GET /directory should still return directory JSON")
+}
+
+
+
+func TestNonceGETPreserved(t *testing.T) {
+	wfe, _ := setupWFE(t)
+	mux := wfe.Handler()
+
+	responseWriter := httptest.NewRecorder()
+	mux.ServeHTTP(responseWriter, &http.Request{
+		Method: "GET",
+		URL:    mustParseURL(newNoncePath),
+	})
+	test.AssertEquals(t, responseWriter.Code, http.StatusNoContent)
+	nonce := responseWriter.Header().Get("Replay-Nonce")
+	test.AssertEquals(t, wfe.nonceService.Valid(nonce), true)
+}
