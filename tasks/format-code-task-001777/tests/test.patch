+func TestDirectoryPOSTGarbageBody(t *testing.T) {
+	wfe, _ := setupWFE(t)
+	mux := wfe.Handler()
+
+	req := makePostRequestWithPath(directoryPath, "this is not a JWS")
+	responseWriter := httptest.NewRecorder()
+	mux.ServeHTTP(responseWriter, req)
+
+
+	test.AssertNotEquals(t, responseWriter.Code, http.StatusOK)
+	test.AssertEquals(t, responseWriter.Header().Get("Content-Type"), "application/problem+json")
+
+	test.Assert(t,
+		!strings.Contains(responseWriter.Body.String(), `"newAccount"`),
+		"Directory JSON was returned despite invalid JWS body")
+}
+
+
+
+func TestNoncePOSTGarbageBody(t *testing.T) {
+	wfe, _ := setupWFE(t)
+	mux := wfe.Handler()
+
+	req := makePostRequestWithPath(newNoncePath, "this is not a JWS")
+	responseWriter := httptest.NewRecorder()
+	mux.ServeHTTP(responseWriter, req)
+
+
+
+	test.AssertEquals(t, responseWriter.Code, http.StatusBadRequest)
+	test.AssertEquals(t, responseWriter.Header().Get("Content-Type"), "application/problem+json")
+}
