+def test_insert_virtual_entity_skip_is_logged_only_for_skipped_virtual_entities(monkeypatch):
+    doc = ezdxf.new()
+    block = doc.blocks.new('SKIP_LOG_BLOCK')
+    block.add_line((0, 0), (1, 0))
+    msp = doc.modelspace()
+    control_insert = msp.add_blockref('SKIP_LOG_BLOCK', (0, 0))
+    skipped_insert = msp.add_blockref('SKIP_LOG_BLOCK', (2, 0))
+    skipped_entity = block.add_line((0, 1), (1, 1))
+    original_virtual_entities = Insert.virtual_entities
+
+    def virtual_entities_with_one_skip(insert, *args, **kwargs):
+        callback = kwargs.get('skipped_entity_callback')
+        if insert is skipped_insert and callback is not None:
+            callback(skipped_entity, 'synthetic skipped virtual entity')
+        yield from original_virtual_entities(insert, *args, **kwargs)
+
+    monkeypatch.setattr(Insert, 'virtual_entities', virtual_entities_with_one_skip)
+
+    control_backend = BasicBackend()
+    control_frontend = LoggingFrontend(RenderContext(doc), control_backend)
+    control_frontend.draw_entities([control_insert])
+    assert control_frontend.messages == []
+    assert any(record[0] == 'line' for record in control_backend.collector)
+
+    skipped_backend = BasicBackend()
+    skipped_frontend = LoggingFrontend(RenderContext(doc), skipped_backend)
+    skipped_frontend.draw_entities([skipped_insert])
+    assert len(skipped_frontend.messages) == 1
+    assert any(record[0] == 'line' for record in skipped_backend.collector)
+
