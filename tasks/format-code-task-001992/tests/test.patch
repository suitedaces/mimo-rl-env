diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,49 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+set +u
+source /root/ezdxf_venv/bin/activate
+set -u
+pip install -e . --no-deps --no-input 2>/dev/null
+
+case "${1:-}" in
+  base)
+    QT_QPA_PLATFORM=offscreen xvfb-run -a python3 -m pytest \
+      tests/test_06_math/test_630_bezier4p.py \
+      tests/test_08_addons/test_811_drawing_frontend.py \
+      integration_tests/test_drawing_matplotlib_backend.py \
+      -k 'not approximate_rejects_non_positive_segments and not approximate_positive_segments_unchanged and not insert_virtual_entity_skip_is_logged_only_for_skipped_virtual_entities and not get_text_width_whitespace_only_is_zero and not draw_text_ignores_whitespace_only_text' \
+      -v
+    base_non_pyqt=$?
+    QT_QPA_PLATFORM=offscreen xvfb-run -a python3 -m pytest \
+      integration_tests/test_drawing_pyqt5_backend.py \
+      -k 'not get_text_width_whitespace_only_is_zero' \
+      -v
+    base_pyqt=$?
+    if [ "$base_non_pyqt" -ne 0 ] || [ "$base_pyqt" -ne 0 ]; then
+      exit 1
+    fi
+    ;;
+  new)
+    QT_QPA_PLATFORM=offscreen xvfb-run -a python3 -m pytest \
+      tests/test_06_math/test_630_bezier4p.py::test_approximate_rejects_non_positive_segments \
+      tests/test_06_math/test_630_bezier4p.py::test_approximate_positive_segments_unchanged \
+      tests/test_08_addons/test_811_drawing_frontend.py::test_insert_virtual_entity_skip_is_logged_only_for_skipped_virtual_entities \
+      integration_tests/test_drawing_matplotlib_backend.py::test_get_text_width_whitespace_only_is_zero \
+      integration_tests/test_drawing_matplotlib_backend.py::test_draw_text_ignores_whitespace_only_text \
+      -v
+    new_non_pyqt=$?
+    QT_QPA_PLATFORM=offscreen xvfb-run -a python3 -m pytest \
+      integration_tests/test_drawing_pyqt5_backend.py::test_get_text_width_whitespace_only_is_zero \
+      -v
+    new_pyqt=$?
+    if [ "$new_non_pyqt" -ne 0 ] || [ "$new_pyqt" -ne 0 ]; then
+      exit 1
+    fi
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
