diff --git a/tests/codespec-config-inheritance.php b/tests/codespec-config-inheritance.php
new file mode 100644
index 000000000..ea3e146c8
--- /dev/null
+++ b/tests/codespec-config-inheritance.php
@@ -0,0 +1,335 @@
+<?php
+
+require_once getcwd() . '/vendor/autoload.php';
+require_once getcwd() . '/php/utils.php';
+
+use WP_CLI\Configurator;
+
+class CodespecConfigAssertionFailure extends Exception {}
+
+function codespec_fail( $message ) {
+	throw new CodespecConfigAssertionFailure( $message );
+}
+
+function codespec_assert_same( $expected, $actual, $message ) {
+	if ( $expected !== $actual ) {
+		codespec_fail( $message . "\nExpected: " . var_export( $expected, true ) . "\nActual: " . var_export( $actual, true ) );
+	}
+}
+
+function codespec_assert_true( $condition, $message ) {
+	if ( ! $condition ) {
+		codespec_fail( $message );
+	}
+}
+
+function codespec_assert_contains( $needle, $haystack, $message ) {
+	if ( false === strpos( $haystack, $needle ) ) {
+		codespec_fail( $message . "\nMissing: " . $needle . "\nActual: " . $haystack );
+	}
+}
+
+function codespec_write_fixture( $root, $relative_path, $contents ) {
+	$path = $root . '/' . $relative_path;
+	$directory = dirname( $path );
+	if ( ! is_dir( $directory ) && ! mkdir( $directory, 0777, true ) ) {
+		codespec_fail( 'Unable to create fixture directory: ' . $directory );
+	}
+	if ( false === file_put_contents( $path, $contents ) ) {
+		codespec_fail( 'Unable to write fixture: ' . $path );
+	}
+	return $path;
+}
+
+function codespec_remove_fixture_tree( $path ) {
+	if ( ! is_dir( $path ) ) {
+		return;
+	}
+	$items = new RecursiveIteratorIterator(
+		new RecursiveDirectoryIterator( $path, FilesystemIterator::SKIP_DOTS ),
+		RecursiveIteratorIterator::CHILD_FIRST
+	);
+	foreach ( $items as $item ) {
+		if ( $item->isDir() ) {
+			rmdir( $item->getPathname() );
+		} else {
+			unlink( $item->getPathname() );
+		}
+	}
+	rmdir( $path );
+}
+
+function codespec_new_configurator() {
+	return new Configurator( getcwd() . '/php/config-spec.php' );
+}
+
+function codespec_test_reserved_metadata() {
+	global $codespec_fixture_root;
+	$path = codespec_write_fixture(
+		$codespec_fixture_root,
+		'metadata.yml',
+		"_:\n  merge: true\nfeature:\n  enabled: yes\n"
+	);
+	$configurator = codespec_new_configurator();
+	$configurator->merge_yml( $path );
+	list( $config, $extra ) = $configurator->to_array();
+	codespec_assert_same( array( 'feature' => array( 'enabled' => true ) ), $extra, 'The reserved _ inheritance metadata must not leak into extra command configuration.' );
+}
+
+function codespec_test_nested_relative_paths() {
+	global $codespec_fixture_root;
+	codespec_write_fixture(
+		$codespec_fixture_root,
+		'shared/base.yml',
+		"path: wordpress\nrequire:\n  - base.php\nbase-option: retained\n"
+	);
+	codespec_write_fixture(
+		$codespec_fixture_root,
+		'config/parent.yml',
+		"_:\n  inherit: ../shared/base.yml\nrequire: parent.php\nparent-option: retained\n"
+	);
+	$main = codespec_write_fixture(
+		$codespec_fixture_root,
+		'main.yml',
+		"_:\n  inherit: config/parent.yml\nrequire: main.php\nurl: child.example\n"
+	);
+
+	$configurator = codespec_new_configurator();
+	$configurator->merge_yml( $main );
+	list( $config, $extra ) = $configurator->to_array();
+	$root = realpath( $codespec_fixture_root );
+	codespec_assert_same( $root . '/shared/wordpress', $config['path'], 'An inherited path setting must be resolved relative to the file that declares it.' );
+	codespec_assert_same(
+		array( $root . '/shared/base.php', $root . '/config/parent.php', $root . '/main.php' ),
+		$config['require'],
+		'Relative require entries must retain depth-first inheritance order and each declaring file\'s base directory.'
+	);
+	codespec_assert_same( 'child.example', $config['url'], 'The child file must still supply ordinary declared configuration.' );
+	codespec_assert_same(
+		array( 'base-option' => 'retained', 'parent-option' => 'retained' ),
+		$extra,
+		'Nested scalar inheritance must retain unrelated extra configuration from every level.'
+	);
+}
+
+function codespec_test_ordered_parents_and_merge_modes() {
+	global $codespec_fixture_root;
+	codespec_write_fixture(
+		$codespec_fixture_root,
+		'ordered/left.yml',
+		"color: left\nrequire: left.php\nsettings:\n  left: L\n  conflict: left\nreplace-me:\n  old: value\n"
+	);
+	codespec_write_fixture(
+		$codespec_fixture_root,
+		'ordered/middle.yml',
+		"color: middle\nrequire: middle.php\nsettings:\n  middle: M\n  conflict: middle\nreplace-me:\n  newer: value\n"
+	);
+	codespec_write_fixture(
+		$codespec_fixture_root,
+		'ordered/right.yml',
+		"_:\n  merge: true\ncolor: right\nrequire: right.php\nsettings:\n  right: R\n  conflict: right\n"
+	);
+	$main = codespec_write_fixture(
+		$codespec_fixture_root,
+		'ordered/main.yml',
+		"_:\n  inherit:\n    - left.yml\n    - middle.yml\n    - right.yml\n  merge: true\ncolor: child\nrequire: child.php\nsettings:\n  child: C\n  conflict: child\n"
+	);
+
+	$configurator = codespec_new_configurator();
+	$configurator->merge_yml( $main );
+	list( $config, $extra ) = $configurator->to_array();
+	$root = realpath( $codespec_fixture_root ) . '/ordered';
+	codespec_assert_same( 'child', $config['color'], 'Later parents and then the child must override single-valued declared settings.' );
+	codespec_assert_same(
+		array( $root . '/left.php', $root . '/middle.php', $root . '/right.php', $root . '/child.php' ),
+		$config['require'],
+		'Multiple-valued declared settings must accumulate in parent-list order before child values.'
+	);
+	codespec_assert_same(
+		array( 'middle' => 'M', 'conflict' => 'child', 'right' => 'R', 'child' => 'C' ),
+		$extra['settings'],
+		'Each inherited or child file with merge enabled must shallow-merge its extra array over the latest inherited value.'
+	);
+	codespec_assert_same(
+		array( 'newer' => 'value' ),
+		$extra['replace-me'],
+		'An extra array in a file without merge enabled must replace the inherited array.'
+	);
+}
+
+function codespec_test_alias_precedence() {
+	global $codespec_fixture_root;
+	codespec_write_fixture(
+		$codespec_fixture_root,
+		'aliases/left.yml',
+		"@stable:\n  user: editor\n@target:\n  user: left-user\n  url: left.example\n"
+	);
+	codespec_write_fixture(
+		$codespec_fixture_root,
+		'aliases/right.yml',
+		"@target:\n  path: /srv/right\n  unsupported: ignored\n"
+	);
+	$main = codespec_write_fixture(
+		$codespec_fixture_root,
+		'aliases/main.yml',
+		"_:\n  inherit:\n    - left.yml\n    - right.yml\n@child:\n  ssh: deploy@example.test\n"
+	);
+
+	$configurator = codespec_new_configurator();
+	$configurator->merge_yml( $main );
+	codespec_assert_same(
+		array(
+			'@stable' => array( 'user' => 'editor' ),
+			'@target' => array( 'path' => '/srv/right' ),
+			'@child' => array( 'ssh' => 'deploy@example.test' ),
+		),
+		$configurator->get_aliases(),
+		'Inherited aliases must follow file precedence, replace colliding aliases as a whole, and retain only supported alias fields.'
+	);
+}
+
+function codespec_test_diamond_is_per_call() {
+	global $codespec_fixture_root;
+	$shared = codespec_write_fixture( $codespec_fixture_root, 'diamond/shared.yml', "require: shared.php\n" );
+	codespec_write_fixture( $codespec_fixture_root, 'diamond/branches/left.yml', "_:\n  inherit: ../shared.yml\nrequire: left.php\n" );
+	codespec_write_fixture( $codespec_fixture_root, 'diamond/branches/right.yml', "_:\n  inherit: .././shared.yml\nrequire: right.php\n" );
+	$main = codespec_write_fixture(
+		$codespec_fixture_root,
+		'diamond/main.yml',
+		"_:\n  inherit:\n    - branches/left.yml\n    - branches/right.yml\nrequire: main.php\n"
+	);
+
+	$configurator = codespec_new_configurator();
+	$configurator->merge_yml( $main );
+	list( $config ) = $configurator->to_array();
+	$root = realpath( $codespec_fixture_root ) . '/diamond';
+	codespec_assert_same(
+		array( $root . '/shared.php', $root . '/branches/left.php', $root . '/branches/right.php', $root . '/main.php' ),
+		$config['require'],
+		'A shared ancestor reached through two branches must be applied only once during one merge call.'
+	);
+
+	$configurator->merge_yml( $shared );
+	list( $config ) = $configurator->to_array();
+	codespec_assert_same(
+		array( $root . '/shared.php', $root . '/branches/left.php', $root . '/branches/right.php', $root . '/main.php', $root . '/shared.php' ),
+		$config['require'],
+		'Deduplication must be scoped to one top-level merge_yml call, not the lifetime of the Configurator.'
+	);
+}
+
+function codespec_test_missing_parent_is_transactional() {
+	global $codespec_fixture_root;
+	$baseline = codespec_write_fixture(
+		$codespec_fixture_root,
+		'failure/baseline.yml',
+		"url: original.example\nstable-option: original\n@stable:\n  user: administrator\n"
+	);
+	codespec_write_fixture( $codespec_fixture_root, 'failure/good.yml', "url: mutated.example\nnew-option: should-not-stick\n" );
+	$broken = codespec_write_fixture(
+		$codespec_fixture_root,
+		'failure/broken.yml',
+		"_:\n  inherit:\n    - good.yml\n    - absent-parent.yml\nurl: child.example\n"
+	);
+
+	$configurator = codespec_new_configurator();
+	$configurator->merge_yml( $baseline );
+	$before_config = $configurator->to_array();
+	$before_aliases = $configurator->get_aliases();
+	$caught = null;
+	try {
+		$configurator->merge_yml( $broken );
+	} catch ( Throwable $error ) {
+		$caught = $error;
+	}
+	codespec_assert_true( $caught instanceof RuntimeException, 'A missing inherited file must throw RuntimeException rather than warning, returning, or throwing another error type.' );
+	codespec_assert_contains( 'absent-parent.yml', $caught->getMessage(), 'The missing-parent exception must identify the path that could not be loaded.' );
+	codespec_assert_same( $before_config, $configurator->to_array(), 'A failed merge must leave declared and extra configuration unchanged.' );
+	codespec_assert_same( $before_aliases, $configurator->get_aliases(), 'A failed merge must leave aliases unchanged.' );
+}
+
+function codespec_run_cycle_child( $fixture_root ) {
+	codespec_write_fixture( $fixture_root, 'cycle/baseline.yml', "url: original.example\n@stable:\n  user: administrator\n" );
+	codespec_write_fixture( $fixture_root, 'cycle/a.yml', "_:\n  inherit: b.yml\nurl: a.example\n" );
+	codespec_write_fixture( $fixture_root, 'cycle/b.yml', "_:\n  inherit: nested/c.yml\n" );
+	codespec_write_fixture( $fixture_root, 'cycle/nested/c.yml', "_:\n  inherit: ../a.yml\n" );
+	$configurator = codespec_new_configurator();
+	$configurator->merge_yml( $fixture_root . '/cycle/baseline.yml' );
+	$before_config = $configurator->to_array();
+	$before_aliases = $configurator->get_aliases();
+	try {
+		$configurator->merge_yml( $fixture_root . '/cycle/a.yml' );
+	} catch ( Throwable $error ) {
+		if ( ! $error instanceof RuntimeException ) {
+			fwrite( STDERR, 'wrong exception type: ' . get_class( $error ) . "\n" );
+			return 2;
+		}
+		foreach ( array( 'a.yml', 'b.yml', 'c.yml' ) as $name ) {
+			if ( false === strpos( $error->getMessage(), $name ) ) {
+				fwrite( STDERR, 'cycle message omitted ' . $name . "\n" );
+				return 3;
+			}
+		}
+		if ( $before_config !== $configurator->to_array() || $before_aliases !== $configurator->get_aliases() ) {
+			fwrite( STDERR, "cycle failure changed Configurator state\n" );
+			return 4;
+		}
+		echo "cycle-contract-ok\n";
+		return 0;
+	}
+	fwrite( STDERR, "cycle did not throw\n" );
+	return 5;
+}
+
+function codespec_test_cycle_is_transactional() {
+	global $codespec_fixture_root;
+	$command = escapeshellarg( PHP_BINARY )
+		. ' -d memory_limit=32M '
+		. escapeshellarg( __FILE__ )
+		. ' --cycle-child '
+		. escapeshellarg( $codespec_fixture_root . '/cycle-child' )
+		. ' 2>&1';
+	$output = array();
+	$status = 0;
+	exec( $command, $output, $status );
+	codespec_assert_same( 0, $status, "Cyclic inheritance must fail with a transactional RuntimeException.\nChild output: " . implode( "\n", $output ) );
+	codespec_assert_contains( 'cycle-contract-ok', implode( "\n", $output ), 'The isolated cycle check did not complete its public-behavior assertions.' );
+}
+
+if ( isset( $argv[1] ) && '--cycle-child' === $argv[1] ) {
+	exit( codespec_run_cycle_child( $argv[2] ) );
+}
+
+$codespec_fixture_root = sys_get_temp_dir() . '/wp-cli-codespec-config-inheritance-' . getmypid();
+codespec_remove_fixture_tree( $codespec_fixture_root );
+mkdir( $codespec_fixture_root, 0777, true );
+
+$tests = array(
+	'reserved inheritance metadata' => 'codespec_test_reserved_metadata',
+	'nested relative inheritance' => 'codespec_test_nested_relative_paths',
+	'ordered parents and merge modes' => 'codespec_test_ordered_parents_and_merge_modes',
+	'alias precedence' => 'codespec_test_alias_precedence',
+	'diamond deduplication scope' => 'codespec_test_diamond_is_per_call',
+	'missing parent rollback' => 'codespec_test_missing_parent_is_transactional',
+	'cycle rollback' => 'codespec_test_cycle_is_transactional',
+);
+
+$failures = 0;
+foreach ( $tests as $name => $test ) {
+	try {
+		$test();
+		echo 'PASS ' . $name . "\n";
+	} catch ( Throwable $error ) {
+		$failures++;
+		echo 'FAIL ' . $name . ': ' . $error->getMessage() . "\n";
+	}
+}
+
+codespec_remove_fixture_tree( $codespec_fixture_root );
+
+if ( $failures ) {
+	fwrite( STDERR, $failures . " configuration inheritance assertion group(s) failed.\n" );
+	exit( 1 );
+}
+
+echo "All configuration inheritance assertions passed.\n";
