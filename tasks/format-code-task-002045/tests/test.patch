+++ b/src/datepicker/date-range.spec.ts
@@ -0,0 +1,144 @@
+import 'reflect-metadata';
+import {NgbDate} from './ngb-date';
+import {NgbCalendarGregorian} from './ngb-calendar';
+import {NgbDatepickerService} from './datepicker-service';
+
+
+
+function rangeType(): any { return (<any>require('./datepicker.module')).NgbDateRange; }
+
+function makeRange(from: any, to: any): any {
+  const Range = rangeType();
+  return typeof Range === 'function' ? new Range(from, to) : null;
+}
+
+describe('NgbDateRange', () => {
+  it('is exported by both the datepicker module and the package entry point', () => {
+    expect(typeof rangeType()).toBe('function');
+    expect(typeof (<any>require('../index')).NgbDateRange).toBe('function');
+  });
+
+  it('normalizes reversed endpoints without aliasing inputs', () => {
+    const Range = rangeType();
+    expect(typeof Range).toBe('function');
+    if (typeof Range !== 'function') { return; }
+
+    const from = {year: 2017, month: 3, day: 20};
+    const to = {year: 2017, month: 3, day: 10};
+    const range = new Range(from, to);
+
+    expect(range.from).toEqual(new NgbDate(2017, 3, 10));
+    expect(range.to).toEqual(new NgbDate(2017, 3, 20));
+    from.day = 1;
+    expect(range.from.day).toBe(10);
+  });
+
+  it('represents incomplete selections and reports completion separately', () => {
+    const range = makeRange({year: 2017, month: 3, day: 10}, null);
+    expect(range).not.toBeNull();
+    if (!range) { return; }
+    expect(range.from).toEqual(new NgbDate(2017, 3, 10));
+    expect(range.to).toBeNull();
+    expect(range.isComplete()).toBeFalsy();
+    expect(makeRange(null, null).isComplete()).toBeFalsy();
+    expect(makeRange({year: 2017, month: 3, day: 10}, {year: 2017, month: 3, day: 10}).isComplete())
+        .toBeTruthy();
+  });
+
+  it('contains both endpoints and dates between them, but not dates outside', () => {
+    const range = makeRange({year: 2017, month: 3, day: 10}, {year: 2017, month: 3, day: 20});
+    expect(range).not.toBeNull();
+    if (!range) { return; }
+    expect(range.contains(new NgbDate(2017, 3, 10))).toBeTruthy();
+    expect(range.contains(new NgbDate(2017, 3, 15))).toBeTruthy();
+    expect(range.contains(new NgbDate(2017, 3, 20))).toBeTruthy();
+    expect(range.contains(new NgbDate(2017, 3, 9))).toBeFalsy();
+    expect(range.contains(null)).toBeFalsy();
+  });
+
+  it('treats touching ranges as overlapping and rejects disjoint or incomplete ranges', () => {
+    const range = makeRange({year: 2017, month: 3, day: 10}, {year: 2017, month: 3, day: 20});
+    expect(range).not.toBeNull();
+    if (!range) { return; }
+    expect(range.overlaps(makeRange({year: 2017, month: 3, day: 20}, {year: 2017, month: 3, day: 25})))
+        .toBeTruthy();
+    expect(range.overlaps(makeRange({year: 2017, month: 3, day: 21}, {year: 2017, month: 3, day: 25})))
+        .toBeFalsy();
+    expect(range.overlaps(makeRange({year: 2017, month: 3, day: 15}, null))).toBeFalsy();
+  });
+
+  it('returns a new normalized intersection or null without mutating either range', () => {
+    const left = makeRange({year: 2017, month: 3, day: 10}, {year: 2017, month: 3, day: 20});
+    const right = makeRange({year: 2017, month: 3, day: 15}, {year: 2017, month: 3, day: 25});
+    expect(left).not.toBeNull();
+    expect(right).not.toBeNull();
+    if (!left || !right) { return; }
+    const intersection = left.intersection(right);
+    expect(intersection).not.toBe(left);
+    expect(intersection).not.toBe(right);
+    expect(intersection.from).toEqual(new NgbDate(2017, 3, 15));
+    expect(intersection.to).toEqual(new NgbDate(2017, 3, 20));
+    expect(left.intersection(makeRange({year: 2017, month: 4, day: 1}, {year: 2017, month: 4, day: 2})))
+        .toBeNull();
+    expect(left.intersection(makeRange({year: 2017, month: 3, day: 15}, null))).toBeNull();
+  });
+
+  it('compares ranges by endpoint values and does not equate partial ranges with complete ones', () => {
+    const range = makeRange({year: 2017, month: 3, day: 10}, {year: 2017, month: 3, day: 20});
+    expect(range).not.toBeNull();
+    if (!range) { return; }
+    expect(range.equals(makeRange({year: 2017, month: 3, day: 10}, {year: 2017, month: 3, day: 20}))).toBeTruthy();
+    expect(range.equals(makeRange({year: 2017, month: 3, day: 11}, {year: 2017, month: 3, day: 20}))).toBeFalsy();
+    expect(range.equals(makeRange({year: 2017, month: 3, day: 10}, null))).toBeFalsy();
+  });
+});
+
+describe('NgbDatepickerService range annotations', () => {
+  it('marks complete ranges inclusively, including both endpoints and interior dates', () => {
+    const calendar = new NgbCalendarGregorian();
+    const service = new NgbDatepickerService(calendar);
+    const generate: any = (<any>service).generateMonthViewModel;
+    expect(typeof generate).toBe('function');
+
+    const range = makeRange({year: 2017, month: 1, day: 10}, {year: 2017, month: 1, day: 12});
+    const model: any = generate.call(
+        service, new NgbDate(2017, 1, 1), null, null, 1, null, range);
+    expect(model.weeks.some(week => week.days.some(day => day.date.day === 9 && day.inRange === false))).toBeTruthy();
+    expect(model.weeks.some(week => week.days.some(day => day.date.day === 10 && day.inRange === true))).toBeTruthy();
+    expect(model.weeks.some(week => week.days.some(day => day.date.day === 11 && day.inRange === true))).toBeTruthy();
+    expect(model.weeks.some(week => week.days.some(day => day.date.day === 12 && day.inRange === true))).toBeTruthy();
+
+  });
+
+  it('does not annotate an incomplete range', () => {
+    const calendar = new NgbCalendarGregorian();
+    const service = new NgbDatepickerService(calendar);
+    const range = makeRange({year: 2017, month: 1, day: 10}, null);
+    const model: any = (<any>service).generateMonthViewModel(
+        new NgbDate(2017, 1, 1), null, null, 1, null, range);
+    const days = [].concat.apply([], model.weeks.map(week => week.days));
+    expect(days.every(day => day.inRange === undefined)).toBeTruthy();
+  });
+
+  it('preserves the legacy day shape when no range is provided', () => {
+    const calendar = new NgbCalendarGregorian();
+    const service = new NgbDatepickerService(calendar);
+    const legacy: any = (<any>service).generateMonthViewModel(
+        new NgbDate(2017, 1, 1), null, null, 1, null);
+    const days = [].concat.apply([], legacy.weeks.map(week => week.days));
+    expect(days.every(day => day.inRange === undefined)).toBeTruthy();
+  });
+
+  it('annotates visible cells across month boundaries, even when a day is disabled by bounds', () => {
+    const calendar = new NgbCalendarGregorian();
+    const service = new NgbDatepickerService(calendar);
+    const range = makeRange({year: 2016, month: 12, day: 31}, {year: 2017, month: 2, day: 2});
+    const model: any = (<any>service).generateMonthViewModel(
+        new NgbDate(2017, 1, 1), new NgbDate(2017, 1, 15), null, 1, null, range);
+    const days = [].concat.apply([], model.weeks.map(week => week.days));
+    expect(days.filter(day => day.date.month === 12 && day.date.day === 31)[0].inRange).toBeTruthy();
+    expect(days.filter(day => day.date.month === 2 && day.date.day === 2)[0].inRange).toBeTruthy();
+    expect(days.filter(day => day.date.day === 10 && day.date.month === 1)[0].inRange).toBeTruthy();
+    expect(days.filter(day => day.date.day === 10 && day.date.month === 1)[0].disabled).toBeTruthy();
+  });
+});
