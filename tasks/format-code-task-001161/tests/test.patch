index 0000000..42f7b6a
--- /dev/null
+++ b/tests/test_structured_wrapping_codespec.py
@@ -0,0 +1,263 @@
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def run_formatter(source, *args, structured=False):
+    with tempfile.TemporaryDirectory() as directory:
+        path = Path(directory) / "sample.py"
+        path.write_text(source)
+        command = [sys.executable, "-m", "docformatter", "--in-place"]
+        if structured:
+            config = Path(directory) / "pyproject.toml"
+            config.write_text("[tool.docformatter]\nwrap-structured = true\n")
+            command.extend(["--config", str(config)])
+        result = subprocess.run(
+            [*command, *args, str(path)],
+            cwd=ROOT,
+            text=True,
+            capture_output=True,
+        )
+        assert result.returncode in (0, 3), result.stderr
+        return path.read_text()
+
+
+def test_structured_mode_wraps_prose_around_directive_but_preserves_body():
+    source = '''\
+def render():
+    """mixed structured description
+
+    This prose before the directive is deliberately long enough to wrap at the configured width.
+
+    .. code-block:: python
+       :caption: Keep   option spacing
+
+       result = call_with_a_very_long_argument(first, second)
+       # spacing   inside the directive body stays
+
+    Trailing prose after the directive also needs to wrap instead of being left untouched.
+    """
+'''
+    expected = '''\
+def render():
+    """Mixed structured description.
+
+    This prose before the directive is deliberately
+    long enough to wrap at the configured width.
+
+    .. code-block:: python
+       :caption: Keep   option spacing
+
+       result = call_with_a_very_long_argument(first, second)
+       # spacing   inside the directive body stays
+
+    Trailing prose after the directive also needs to
+    wrap instead of being left untouched.
+    """
+'''
+    formatted = run_formatter(
+        source, "--wrap-descriptions", "52", structured=True
+    )
+    assert formatted == expected
+    assert (
+        run_formatter(formatted, "--wrap-descriptions", "52", structured=True)
+        == expected
+    )
+
+
+def test_structured_mode_preserves_literal_and_doctest_regions_and_resumes():
+    source = '''\
+def examples():
+    """structured examples
+
+    Introductory prose before the literal block should be wrapped without changing the example.
+
+    Example::
+
+        mapping = {"spacing":   "must stay", "value": call(argument_one, argument_two)}
+
+    >>> very_long_function_name(argument_one, argument_two)
+    123
+
+    Closing prose after the interactive example should also wrap to the requested length.
+    """
+'''
+    expected = '''\
+def examples():
+    """Structured examples.
+
+    Introductory prose before the literal block
+    should be wrapped without changing the example.
+
+    Example::
+
+        mapping = {"spacing":   "must stay", "value": call(argument_one, argument_two)}
+
+    >>> very_long_function_name(argument_one, argument_two)
+    123
+
+    Closing prose after the interactive example
+    should also wrap to the requested length.
+    """
+'''
+    assert run_formatter(source, "--wrap-descriptions", "52", structured=True) == expected
+
+
+def test_structured_mode_wraps_around_but_does_not_reflow_list_items():
+    source = '''\
+def choices():
+    """list-aware description
+
+    Text before this list is long enough to wrap and demonstrate that list detection is local.
+
+    * first item keeps   its spacing
+      continuation text keeps   authored spacing
+      - nested item remains nested
+    * second item remains on its authored line even when it is very long
+
+    Text after this list is also long enough to wrap and demonstrate that formatting resumes.
+    """
+'''
+    expected = '''\
+def choices():
+    """List-aware description.
+
+    Text before this list is long enough to wrap and
+    demonstrate that list detection is local.
+
+    * first item keeps   its spacing
+      continuation text keeps   authored spacing
+      - nested item remains nested
+    * second item remains on its authored line even when it is very long
+
+    Text after this list is also long enough to wrap
+    and demonstrate that formatting resumes.
+    """
+'''
+    assert run_formatter(source, "--wrap-descriptions", "52", structured=True) == expected
+
+
+def test_structured_mode_keeps_sphinx_fields_wrappable_next_to_directive():
+    source = '''\
+def convert(value):
+    """Convert a value.
+
+    :param value: This parameter explanation is deliberately long enough that the normal Sphinx field formatter must wrap it.
+
+    .. warning:: Keep this directive body untouched even though it is long and appears here.
+
+    :returns: This return explanation is also deliberately long enough to wrap after the protected directive.
+    """
+'''
+    expected = '''\
+def convert(value):
+    """Convert a value.
+
+    :param value: This parameter explanation is
+        deliberately long enough that the normal
+        Sphinx field formatter must wrap it.
+
+    .. warning:: Keep this directive body untouched even though it is long and appears here.
+
+    :returns: This return explanation is also
+        deliberately long enough to wrap after the
+        protected directive.
+    """
+'''
+    assert run_formatter(source, "--wrap-descriptions", "52", structured=True) == expected
+
+
+def test_structured_mode_can_be_enabled_from_pyproject_configuration():
+    source = '''\
+def configured():
+    """configured behavior
+
+    This prose is long enough to prove that configuration enables structured wrapping around directives.
+
+    .. note:: Keep this directive line unchanged.
+    """
+'''
+    with tempfile.TemporaryDirectory() as directory:
+        config = Path(directory) / "pyproject.toml"
+        config.write_text("[tool.docformatter]\nwrap-structured = true\nwrap-descriptions = 52\n")
+        with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False) as handle:
+            handle.write(source)
+            path = Path(handle.name)
+        try:
+            result = subprocess.run(
+                [
+                    sys.executable,
+                    "-m",
+                    "docformatter",
+                    "--in-place",
+                    "--config",
+                    str(config),
+                    str(path),
+                ],
+                cwd=ROOT,
+                text=True,
+                capture_output=True,
+            )
+            assert result.returncode in (0, 3), result.stderr
+            assert path.read_text() == '''\
+def configured():
+    """Configured behavior.
+
+    This prose is long enough to prove that
+    configuration enables structured wrapping around
+    directives.
+
+    .. note:: Keep this directive line unchanged.
+    """
+'''
+        finally:
+            path.unlink()
+
+
+def test_structured_mode_is_available_as_a_command_line_option():
+    source = '''\
+def cli():
+    """cli behavior
+
+    This prose is deliberately long enough to wrap before the protected directive marker.
+
+    .. note:: Keep this line unchanged.
+    """
+'''
+    expected = '''\
+def cli():
+    """Cli behavior.
+
+    This prose is deliberately long enough to wrap
+    before the protected directive marker.
+
+    .. note:: Keep this line unchanged.
+    """
+'''
+    assert (
+        run_formatter(
+            source,
+            "--wrap-structured",
+            "--wrap-descriptions",
+            "52",
+        )
+        == expected
+    )
+
+
+def test_default_mode_retains_cautious_directive_behavior():
+    source = '''\
+def unchanged():
+    """mixed description
+
+    This prose is deliberately long and would be wrapped if structured mode were enabled.
+
+    .. note:: Existing default behavior keeps this document untouched.
+    """
+'''
+    expected = source.replace('"""mixed description', '"""Mixed description.')
+    assert run_formatter(source, "--wrap-descriptions", "52") == expected
