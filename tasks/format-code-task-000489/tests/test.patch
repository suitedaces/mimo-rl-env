+
+
+
+
+
+
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import textwrap
+
+import pytest
+
+
+FIXTURES = "/workspace/repo/usercase-test-coderl/fixtures"
+RESULT_PREFIX = "USERCASE_RESULT="
+MISSING_ENV_FILE = "/workspace/repo/usercase-test-coderl/fixtures/missing_taipy_env_config.toml"
+
+
+def normalize_backup_value(value):
+    if value == "True:bool":
+        return True
+    if value == "False:bool":
+        return False
+    if isinstance(value, str) and value.endswith(":int"):
+        return int(value.removesuffix(":int"))
+    return value
+
+
+def run_config_session(code: str) -> tuple[dict, str]:
+    env = os.environ.copy()
+    env.pop("TAIPY_CONFIG_PATH", None)
+    env["PYTHONPATH"] = "/workspace/repo" + os.pathsep + env.get("PYTHONPATH", "")
+    completed = subprocess.run(
+        [sys.executable, "-c", textwrap.dedent(code)],
+        cwd="/workspace/repo",
+        env=env,
+        text=True,
+        capture_output=True,
+    )
+    output = completed.stdout + completed.stderr
+    if completed.returncode != 0:
+        pytest.fail(output)
+
+    for line in reversed(output.splitlines()):
+        if line.startswith(RESULT_PREFIX):
+            return json.loads(line.removeprefix(RESULT_PREFIX)), output
+    pytest.fail(f"missing {RESULT_PREFIX!r} line in subprocess output:\n{output}")
+
+
+def test_env_file_has_highest_precedence_after_load():
+
+
+
+    result, _ = run_config_session(
+        f"""
+        import json
+        import os
+        from taipy.common.config import Config
+
+        os.environ["TAIPY_CONFIG_PATH"] = "{FIXTURES}/env_overlay.toml"
+        Config.load("{FIXTURES}/base.toml")
+        result = {{
+            "after_load": {{
+                "custom_property_not_overwritten": Config.global_config.custom_property_not_overwritten,
+                "custom_property_overwritten": Config.global_config.custom_property_overwritten,
+                "foo": Config.global_config.foo,
+            }}
+        }}
+        print("{RESULT_PREFIX}" + json.dumps(result, sort_keys=True))
+        """
+    )
+
+
+    assert result["after_load"]["custom_property_not_overwritten"] is True
+    assert result["after_load"]["custom_property_overwritten"] == 11
+    assert result["after_load"]["foo"] == 2
+
+
+def test_env_file_overlays_python_configuration():
+
+
+
+    result, _ = run_config_session(
+        f"""
+        import json
+        import os
+        from taipy.common.config import Config
+
+        os.environ["TAIPY_CONFIG_PATH"] = "{FIXTURES}/env_overlay.toml"
+        Config.configure_global_app(foo=1)
+        result = {{
+            "global": {{
+                "foo": Config.global_config.foo,
+                "custom_property_overwritten": Config.global_config.custom_property_overwritten,
+            }},
+        }}
+        print("{RESULT_PREFIX}" + json.dumps(result, sort_keys=True))
+        """
+    )
+
+
+    assert result["global"]["foo"] == 2
+    assert result["global"]["custom_property_overwritten"] == 11
+
+
+def test_env_file_has_highest_precedence_after_override():
+
+
+
+    result, _ = run_config_session(
+        f"""
+        import json
+        import os
+        from taipy.common.config import Config
+
+        os.environ["TAIPY_CONFIG_PATH"] = "{FIXTURES}/env_overlay.toml"
+        Config.configure_global_app(foo=1)
+        result = {{
+            "after_python": {{
+                "foo": Config.global_config.foo,
+                "custom_property_overwritten": Config.global_config.custom_property_overwritten,
+            }}
+        }}
+        Config.override("{FIXTURES}/override.toml")
+        result["after_override"] = {{
+            "foo": Config.global_config.foo,
+            "custom_property_overwritten": Config.global_config.custom_property_overwritten,
+            "override_only": Config.global_config.override_only,
+        }}
+        print("{RESULT_PREFIX}" + json.dumps(result, sort_keys=True))
+        """
+    )
+
+
+    assert result["after_python"]["foo"] == 2
+    assert result["after_python"]["custom_property_overwritten"] == 11
+    assert result["after_override"]["foo"] == 2
+    assert result["after_override"]["custom_property_overwritten"] == 11
+    assert result["after_override"]["override_only"] == "override"
+
+
+def test_missing_environment_file_logs_and_uses_normal_layers():
+
+
+
+    result, output = run_config_session(
+        f"""
+        import json
+        import os
+        from taipy.common.config import Config
+
+        os.environ["TAIPY_CONFIG_PATH"] = "{MISSING_ENV_FILE}"
+        Config.configure_global_app(foo=1)
+        result = {{
+            "after_python_missing_env": {{
+                "foo": Config.global_config.foo,
+                "custom_property_overwritten": Config.global_config.custom_property_overwritten,
+            }}
+        }}
+        Config.load("{FIXTURES}/base.toml")
+        result["after_load_missing_env"] = {{
+            "custom_property_not_overwritten": Config.global_config.custom_property_not_overwritten,
+            "custom_property_overwritten": Config.global_config.custom_property_overwritten,
+            "foo": Config.global_config.foo,
+        }}
+        print("{RESULT_PREFIX}" + json.dumps(result, sort_keys=True))
+        """
+    )
+
+
+    assert result["after_python_missing_env"]["foo"] == 1
+    assert result["after_python_missing_env"]["custom_property_overwritten"] is None
+    assert result["after_load_missing_env"]["custom_property_not_overwritten"] is True
+    assert result["after_load_missing_env"]["custom_property_overwritten"] == 10
+    assert result["after_load_missing_env"]["foo"] is None
+
+    assert MISSING_ENV_FILE in output
+    assert "TAIPY_CONFIG_PATH" in output
+    assert any(phrase in output.lower() for phrase in ("does not exist", "not found", "missing"))
+
+
+def test_backup_writes_applied_environment_overlay():
+
+
+
+    result, _ = run_config_session(
+        f"""
+        import json
+        import os
+        import tempfile
+        import toml
+        from pathlib import Path
+        from taipy.common.config import Config
+
+        os.environ["TAIPY_CONFIG_PATH"] = "{FIXTURES}/env_overlay.toml"
+        with tempfile.TemporaryDirectory() as directory:
+            backup = Path(directory) / "backup.toml"
+            Config.load("{FIXTURES}/base.toml")
+            Config.configure_global_app(foo=1)
+            Config.backup(str(backup))
+            backed_up = toml.load(str(backup))["TAIPY"]
+        print("{RESULT_PREFIX}" + json.dumps({{"taipy": backed_up}}, sort_keys=True))
+        """
+    )
+
+    backed_up = {key: normalize_backup_value(value) for key, value in result["taipy"].items()}
+
+    assert backed_up["custom_property_not_overwritten"] is True
+    assert backed_up["custom_property_overwritten"] == 11
+    assert backed_up["foo"] == 2
+
+
+def test_environment_path_is_applied_on_later_compilation():
+
+
+
+    result, _ = run_config_session(
+        f"""
+        import json
+        import os
+        from taipy.common.config import Config
+
+        Config.load("{FIXTURES}/base.toml")
+        before = {{
+            "custom_property_not_overwritten": Config.global_config.custom_property_not_overwritten,
+            "custom_property_overwritten": Config.global_config.custom_property_overwritten,
+        }}
+        os.environ["TAIPY_CONFIG_PATH"] = "{FIXTURES}/env_overlay.toml"
+        Config.load("{FIXTURES}/base.toml")
+        after = {{
+            "custom_property_not_overwritten": Config.global_config.custom_property_not_overwritten,
+            "custom_property_overwritten": Config.global_config.custom_property_overwritten,
+        }}
+        print("{RESULT_PREFIX}" + json.dumps({{"before": before, "after": after}}, sort_keys=True))
+        """
+    )
+
+
+    assert result["before"] == {"custom_property_not_overwritten": True, "custom_property_overwritten": 10}
+    assert result["after"] == {"custom_property_not_overwritten": True, "custom_property_overwritten": 11}
+
+
+def test_environment_path_set_before_compilation_overlays_load():
+
+
+
+    result, _ = run_config_session(
+        f"""
+        import json
+        import os
+        from taipy.common.config import Config
+
+        os.environ["TAIPY_CONFIG_PATH"] = "{FIXTURES}/env_overlay.toml"
+        Config.load("{FIXTURES}/base.toml")
+        result = {{
+            "custom_property_not_overwritten": Config.global_config.custom_property_not_overwritten,
+            "custom_property_overwritten": Config.global_config.custom_property_overwritten,
+            "foo": Config.global_config.foo,
+        }}
+        print("{RESULT_PREFIX}" + json.dumps(result, sort_keys=True))
+        """
+    )
+
+
+    assert result["custom_property_not_overwritten"] is True
+    assert result["custom_property_overwritten"] == 11
+    assert result["foo"] == 2
+
+
+def test_independent_process_wide_config_sessions_do_not_share_state():
+
+
+
+    session_a, _ = run_config_session(
+        f"""
+        import json
+        import os
+        from taipy.common.config import Config
+
+        os.environ["TAIPY_CONFIG_PATH"] = "{FIXTURES}/env_overlay_alt.toml"
+        Config.load("{FIXTURES}/base.toml")
+        result = {{
+            "custom_property_overwritten": Config.global_config.custom_property_overwritten,
+            "session_marker": Config.global_config.session_marker,
+        }}
+        print("{RESULT_PREFIX}" + json.dumps(result, sort_keys=True))
+        """
+    )
+    session_b, _ = run_config_session(
+        f"""
+        import json
+        from taipy.common.config import Config
+
+        Config.load("{FIXTURES}/session_b_base.toml")
+        result = {{
+            "custom_property_overwritten": Config.global_config.custom_property_overwritten,
+            "session_marker": Config.global_config.session_marker,
+        }}
+        print("{RESULT_PREFIX}" + json.dumps(result, sort_keys=True))
+        """
+    )
+
+
+    assert session_a == {"custom_property_overwritten": 101, "session_marker": "a-env"}
+    assert session_b == {"custom_property_overwritten": 20, "session_marker": "b-base"}
+
+
+def test_repeated_environment_compile_and_backup_cycles_keep_overlay_applied():
+
+
+
+    result, _ = run_config_session(
+        f"""
+        import json
+        import logging
+        import os
+        import tempfile
+        import toml
+        from pathlib import Path
+        from taipy.common.config import Config
+
+        logging.getLogger("Taipy").disabled = True
+        os.environ["TAIPY_CONFIG_PATH"] = "{FIXTURES}/env_overlay.toml"
+        with tempfile.TemporaryDirectory() as directory:
+            backup = Path(directory) / "backup.toml"
+            for i in range(5):
+                Config.load("{FIXTURES}/base.toml")
+                Config.configure_global_app(iteration=i)
+                Config.backup(str(backup))
+            backed_up = toml.load(str(backup))["TAIPY"]
+            result = {{
+                "cycles": 5,
+                "custom_property_overwritten": Config.global_config.custom_property_overwritten,
+                "foo": Config.global_config.foo,
+                "backup_exists": backup.exists(),
+                "backed_up": backed_up,
+            }}
+        print("{RESULT_PREFIX}" + json.dumps(result, sort_keys=True))
+        """
+    )
+
+    backed_up = {key: normalize_backup_value(value) for key, value in result["backed_up"].items()}
+
+    assert result["cycles"] == 5
+    assert result["custom_property_overwritten"] == 11
+    assert result["foo"] == 2
+    assert result["backup_exists"] is True
+    assert backed_up["custom_property_overwritten"] == 11
+    assert backed_up["foo"] == 2
