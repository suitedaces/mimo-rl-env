diff --git a/test/EmbeddableDashboardTests.js b/test/EmbeddableDashboardTests.js
index 94404ef..475d6bf 100644
--- a/test/EmbeddableDashboardTests.js
+++ b/test/EmbeddableDashboardTests.js
@@ -72,4 +72,44 @@ describe('EmbeddableDashboard', function() {
     it ('should set correct scrolling attribute for the iframe', () => {
         expect(iFrame.scrolling).to.equal('yes');
     });
+
+    it ('should use default class name on iframe when className not provided', () => {
+        const opts = Object.assign({}, mockOptions, {container: document.createElement('div')});
+        delete opts.className;
+        const d = new EmbeddableDashboard(opts);
+        expect(d.iframe.className).to.equal('quicksight-embedding-iframe');
+    });
+
+    it ('should append user className to default class on the iframe', () => {
+        const opts = Object.assign({}, mockOptions, {
+            container: document.createElement('div'),
+            className: 'my-apps-classname'
+        });
+        const d = new EmbeddableDashboard(opts);
+        const classNames = d.iframe.className.split(/\s+/);
+        expect(classNames).to.contain('quicksight-embedding-iframe');
+        expect(classNames).to.contain('my-apps-classname');
+    });
+
+    it ('should support the issue example invocation with className option', () => {
+        const opts = {
+            url: mockUrl,
+            container: document.createElement('div'),
+            scrolling: 'no',
+            height: '600px',
+            loadingHeight: '400px',
+            className: 'my-apps-classname'
+        };
+        const d = new EmbeddableDashboard(opts);
+        const classNames = d.iframe.className.split(/\s+/);
+        expect(classNames).to.contain('quicksight-embedding-iframe');
+        expect(classNames).to.contain('my-apps-classname');
+    });
+
+    it ('should not include literal "undefined" in className when className not provided', () => {
+        const opts = Object.assign({}, mockOptions, {container: document.createElement('div')});
+        delete opts.className;
+        const d = new EmbeddableDashboard(opts);
+        expect(d.iframe.className).to.not.contain('undefined');
+    });
 });
