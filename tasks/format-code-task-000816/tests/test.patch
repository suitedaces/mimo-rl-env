diff --git a/usercase-test-coderl/finite_automaton_facade.test.js b/usercase-test-coderl/finite_automaton_facade.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/finite_automaton_facade.test.js
@@ -0,0 +1,251 @@
+
+
+
+
+
+
+
+'use strict';
+
+const childProcess = require('child_process');
+const fs = require('fs');
+const net = require('net');
+const os = require('os');
+const path = require('path');
+
+const regexpTree = require('/workspace/repo');
+const {fa} = regexpTree;
+
+function matcherMap(automaton, strings) {
+  return Object.fromEntries(strings.map(string => [string, automaton.matches(string)]));
+}
+
+function sortedSet(set) {
+  return Array.from(set).sort((a, b) => String(a).localeCompare(String(b)));
+}
+
+describe('public finite-automaton facade', () => {
+  test('toNFA builds an NFA for RegExp input and its matcher accepts exactly the captured a* cases', () => {
+
+
+    const nfa = fa.toNFA(/a*/);
+
+    expect(nfa).toBeInstanceOf(fa.NFA);
+
+    expect(matcherMap(nfa, ['aaa', 'b', 'ba', 'aab'])).toEqual({
+      aaa: true,
+      b: false,
+      ba: false,
+      aab: false,
+    });
+    expect(matcherMap(nfa, ['', 'a', 'aa', 'ab'])).toEqual({
+      '': true,
+      a: true,
+      aa: true,
+      ab: false,
+    });
+  });
+
+  test('toDFA builds a DFA for RegExp input and its matcher accepts exactly the captured a* cases', () => {
+
+
+    const dfa = fa.toDFA(/a*/);
+
+    expect(dfa).toBeInstanceOf(fa.DFA);
+    expect(matcherMap(dfa, ['', 'a', 'aa', 'ab'])).toEqual({
+      '': true,
+      a: true,
+      aa: true,
+      ab: false,
+    });
+
+    expect(matcherMap(dfa, ['aaa', 'b', 'ba', 'aab'])).toEqual({
+      aaa: true,
+      b: false,
+      ba: false,
+      aab: false,
+    });
+  });
+
+  test('test handles disjunction, concatenation, and star through the public one-shot helper', () => {
+
+
+    expect({
+      ab: fa.test(/ab|c*/, 'ab'),
+      empty: fa.test(/ab|c*/, ''),
+      c: fa.test(/ab|c*/, 'c'),
+      ccc: fa.test(/ab|c*/, 'ccc'),
+      a_or_b_rejects_c: fa.test(/a|b/, 'c'),
+    }).toEqual({
+      ab: true,
+      empty: true,
+      c: true,
+      ccc: true,
+      a_or_b_rejects_c: false,
+    });
+  });
+
+  test('regexp string input supports grouped concatenation with plus and optional quantifiers', () => {
+
+
+    const dfa = fa.toDFA('/(ab)+c?/');
+
+    expect(matcherMap(dfa, ['', 'ab', 'abc', 'abab', 'ababc', 'aba', 'ac'])).toEqual({
+      '': false,
+      ab: true,
+      abc: true,
+      abab: true,
+      ababc: true,
+      aba: false,
+      ac: false,
+    });
+
+    expect(matcherMap(dfa, ['a', 'abb', 'abcabc', 'ababcc'])).toEqual({
+      a: false,
+      abb: false,
+      abcabc: false,
+      ababcc: false,
+    });
+  });
+
+  test('AST input is accepted by the facade and produces the captured disjunction automaton', () => {
+
+
+    const ast = regexpTree.parse('/a|b/');
+    const dfa = fa.toDFA(ast);
+
+    expect(matcherMap(dfa, ['', 'a', 'b', 'c', 'ab'])).toEqual({
+      '': false,
+      a: true,
+      b: true,
+      c: false,
+      ab: false,
+    });
+
+    expect(matcherMap(dfa, ['aa', 'bb', 'ba'])).toEqual({
+      aa: false,
+      bb: false,
+      ba: false,
+    });
+  });
+
+  test('equivalent RegExp, string, and AST inputs produce the captured grouped quantifier booleans', () => {
+
+
+    const ast = regexpTree.parse('/(ab)+c?/');
+    const strings = ['', 'ab', 'abc', 'abab', 'ababc', 'aba', 'ac'];
+
+    expect({
+      regexp: Object.fromEntries(strings.map(string => [string, fa.test(/(ab)+c?/, string)])),
+      string: Object.fromEntries(strings.map(string => [string, fa.test('/(ab)+c?/', string)])),
+      ast: Object.fromEntries(strings.map(string => [string, fa.test(ast, string)])),
+    }).toEqual({
+      regexp: {'': false, ab: true, abc: true, abab: true, ababc: true, aba: false, ac: false},
+      string: {'': false, ab: true, abc: true, abab: true, ababc: true, aba: false, ac: false},
+      ast: {'': false, ab: true, abc: true, abab: true, ababc: true, aba: false, ac: false},
+    });
+  });
+
+  test('flags are rejected with the captured public Error message', () => {
+
+
+    expect(() => fa.toNFA(/a/i)).toThrow(Error);
+
+    expect(() => fa.toNFA(/a/i)).toThrow(/flags/i);
+  });
+
+  test('unsupported AST node types are rejected with the captured public Error message', () => {
+
+
+    expect(() => fa.toNFA({type: 'Assertion', kind: '^'})).toThrow(Error);
+
+    expect(() => fa.toNFA({type: 'Assertion', kind: '^'})).toThrow(/unsupported|not supported/i);
+  });
+
+  test('non-simple character AST nodes are rejected with the captured public Error message', () => {
+
+
+    const ast = {
+      type: 'RegExp',
+      body: {type: 'Char', value: '\\d', symbol: '\\d', kind: 'meta'},
+      flags: '',
+    };
+
+    expect(() => fa.toNFA(ast)).toThrow(Error);
+
+    expect(() => fa.toNFA(ast)).toThrow(/simple|unsupported|not supported/i);
+  });
+
+  test('referential transparency returns the same value for the same call', () => {
+    expect(fa.test(/ab|c*/, 'ccc')).toBe(true);
+    expect(fa.test(/ab|c*/, 'ccc')).toBe(true);
+  });
+
+  test('does not mutate caller-owned AST input', () => {
+    const ast = regexpTree.parse('/(ab)+c?/');
+    const before = JSON.parse(JSON.stringify(ast));
+
+    expect(fa.test(ast, 'ababc')).toBe(true);
+
+    expect(ast).toEqual(before);
+  });
+
+  test('fresh Node process produces the same value after in-process noise calls', () => {
+    const inProcess = {
+      target: fa.test('/(ab)+c?/', 'ababc'),
+      noise1: fa.test(/a*/, 'ab'),
+      noise2: fa.test(regexpTree.parse('/a|b/'), 'b'),
+      targetAgain: fa.test('/(ab)+c?/', 'ababc'),
+    };
+
+    const script = `
+      const regexpTree = require('/workspace/repo');
+      process.stdout.write(JSON.stringify({
+        target: regexpTree.fa.test('/(ab)+c?/', 'ababc')
+      }));
+    `;
+    const fresh = JSON.parse(
+      childProcess.execFileSync(process.execPath, ['-e', script], {encoding: 'utf8'})
+    );
+
+    expect(inProcess).toEqual({
+      target: true,
+      noise1: false,
+      noise2: true,
+      targetAgain: true,
+    });
+    expect(fresh).toEqual({target: true});
+  });
+
+  test('does not write cwd files or open network sockets for pure automaton helpers', () => {
+    const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'regexp-tree-fa-'));
+    const originalCwd = process.cwd();
+    const originalSocket = net.Socket;
+    const originalConnect = net.connect;
+    const originalCreateConnection = net.createConnection;
+
+    function forbiddenNetwork() {
+      throw new Error('network access is not declared for finite-automaton helpers');
+    }
+
+    try {
+      process.chdir(tempDir);
+      const before = fs.readdirSync(tempDir).sort();
+      net.Socket = forbiddenNetwork;
+      net.connect = forbiddenNetwork;
+      net.createConnection = forbiddenNetwork;
+
+      expect(fa.test('/(ab)+c?/', 'abc')).toBe(true);
+      expect(fa.test(/a|b/, 'c')).toBe(false);
+
+      const after = fs.readdirSync(tempDir).sort();
+      expect({before, after}).toEqual({before: [], after: []});
+    } finally {
+      net.Socket = originalSocket;
+      net.connect = originalConnect;
+      net.createConnection = originalCreateConnection;
+      process.chdir(originalCwd);
+      fs.rmSync(tempDir, {recursive: true, force: true});
+    }
+  });
+});
