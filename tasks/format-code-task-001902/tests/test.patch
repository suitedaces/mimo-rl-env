diff --git a/usercase-test-coderl/session-store.test.js b/usercase-test-coderl/session-store.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/session-store.test.js
@@ -0,0 +1,212 @@
+'use strict';
+
+
+
+
+
+
+
+
+
+
+
+const tap = require('tap');
+
+const simples = require('simples');
+
+const expectRejectsWithError = async (test, promise, message) => {
+	try {
+		await promise;
+		test.fail(message);
+	} catch (error) {
+		test.equal(error.constructor, Error);
+	}
+};
+
+const expectSameRejection = async (test, promise, expectedError, expectedConstructor, expectedMessage) => {
+	try {
+		await promise;
+		test.fail(`${expectedMessage} should reject`);
+	} catch (error) {
+		test.equal(error, expectedError);
+		test.equal(error.constructor, expectedConstructor);
+		test.equal(error.message, expectedMessage);
+	}
+};
+
+tap.test('default memory store keeps, expires, removes, and does not reanimate sessions', async (test) => {
+
+
+
+
+	const store = simples.store();
+
+	test.equal(await store.get('sid'), null);
+	test.equal(await store.set('sid', { user: 'ada' }, 1000), undefined);
+	test.same(await store.get('sid'), { user: 'ada' });
+	test.equal(await store.update('sid', -1), undefined);
+	test.equal(await store.get('sid'), null);
+
+	test.equal(await store.set('sid', 'value', 1000), undefined);
+	test.equal(await store.get('sid'), 'value');
+	test.equal(await store.remove('sid'), undefined);
+	test.equal(await store.update('sid', 1000), undefined);
+	test.equal(await store.get('sid'), null);
+});
+
+tap.test('two default stores keep independent state', async (test) => {
+
+
+
+
+	const a = simples.store();
+	const b = simples.store();
+
+	test.equal(await a.set('sid', { owner: 'a' }, 1000), undefined);
+	test.same(await a.get('sid'), { owner: 'a' });
+	test.equal(await b.get('sid'), null);
+});
+
+tap.test('custom async implementations receive matching method arguments', async (test) => {
+
+
+
+
+	const calls = [];
+	const store = simples.store({
+		get(id) {
+			calls.push(['get', id]);
+			return Promise.resolve({ from: id });
+		},
+		set(id, session, timeout) {
+			calls.push(['set', id, session, timeout]);
+			return Promise.resolve('SET_OK');
+		},
+		remove(id) {
+			calls.push(['remove', id]);
+			return Promise.resolve('REMOVE_OK');
+		},
+		update(id, timeout) {
+			calls.push(['update', id, timeout]);
+			return Promise.resolve('UPDATE_OK');
+		}
+	});
+
+
+	await store.set('abc', { role: 'admin' }, 25);
+	test.same(await store.get('abc'), { from: 'abc' });
+	await store.update('abc', 50);
+	await store.remove('abc');
+	test.same(calls, [
+		['set', 'abc', { role: 'admin' }, 25],
+		['get', 'abc'],
+		['update', 'abc', 50],
+		['remove', 'abc']
+	]);
+});
+
+tap.test('custom thrown errors reject with the same specific error object for every method', async (test) => {
+
+
+
+
+	const thrownGet = new TypeError('get boom');
+	const thrownSet = new RangeError('set boom');
+	const thrownUpdate = new SyntaxError('update boom');
+	const thrownRemove = new ReferenceError('remove boom');
+	const store = simples.store({
+		get() {
+			throw thrownGet;
+		},
+		set() {
+			throw thrownSet;
+		},
+		update() {
+			throw thrownUpdate;
+		},
+		remove() {
+			throw thrownRemove;
+		}
+	});
+
+	await expectSameRejection(test, store.get('sid'), thrownGet, TypeError, 'get boom');
+	await expectSameRejection(test, store.set('sid', 'value', 1000), thrownSet, RangeError, 'set boom');
+	await expectSameRejection(test, store.update('sid', 1000), thrownUpdate, SyntaxError, 'update boom');
+	await expectSameRejection(test, store.remove('sid'), thrownRemove, ReferenceError, 'remove boom');
+});
+
+tap.test('custom methods that return non-promises reject with Error', async (test) => {
+
+
+
+
+	const store = simples.store({
+		get() {
+			return 'plain';
+		},
+		set() {
+			return 5;
+		},
+		update() {
+			return false;
+		},
+		remove() {
+			return null;
+		}
+	});
+
+	await expectRejectsWithError(test, store.get('sid'), 'get should reject on non-Promise return');
+	await expectRejectsWithError(test, store.set('sid', 'x', 1), 'set should reject on non-Promise return');
+	await expectRejectsWithError(test, store.update('sid', 1), 'update should reject on non-Promise return');
+	await expectRejectsWithError(test, store.remove('sid'), 'remove should reject on non-Promise return');
+});
+
+tap.test('null and empty options construct but unimplemented methods reject with Error', async (test) => {
+
+
+
+
+	for (const config of [null, {}]) {
+		const store = simples.store(config);
+
+		await expectRejectsWithError(test, store.get('sid'), 'get should reject when unimplemented');
+		await expectRejectsWithError(test, store.set('sid', 'x', 1), 'set should reject when unimplemented');
+		await expectRejectsWithError(test, store.update('sid', 1), 'update should reject when unimplemented');
+		await expectRejectsWithError(test, store.remove('sid'), 'remove should reject when unimplemented');
+	}
+});
+
+tap.test('removed entries are not restored by later updates', async (test) => {
+
+
+
+
+	const store = simples.store();
+
+
+	test.equal(await store.set('sid', 'value', 1000), undefined);
+	test.equal(await store.remove('sid'), undefined);
+	test.equal(await store.update('sid', 1000), undefined);
+	test.equal(await store.get('sid'), null);
+});
+
+tap.test('removed entries stay absent across many store-use-cleanup cycles', async (test) => {
+
+
+
+
+	const store = simples.store();
+
+	for (let index = 0; index < 120; index += 1) {
+		const id = `sid-${index}`;
+		const session = { user: `user-${index}`, ordinal: index };
+
+		test.equal(await store.set(id, session, 1000), undefined);
+		test.same(await store.get(id), session);
+		test.equal(await store.remove(id), undefined);
+	}
+
+	test.equal(await store.get('sid-0'), null);
+	test.equal(await store.get('sid-59'), null);
+	test.equal(await store.get('sid-119'), null);
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export npm_config_offline=true
+export npm_config_audit=false
+export npm_config_fund=false
+export NO_UPDATE_NOTIFIER=1
+
+if [ ! -x /workspace/repo/node_modules/.bin/tap ]; then
+	echo "local tap runner is missing; refusing to install dependencies in offline test command" >&2
+	exit 1
+fi
+
+exec /workspace/repo/node_modules/.bin/tap --no-coverage -b /workspace/repo/usercase-test-coderl/session-store.test.js
