+
+    def _costs_org_unit_response(self, org_unit_id="R_001", extra_qs=""):
+        """Return the AWS costs response for an org unit group-by request."""
+        qs = f"?group_by[org_unit_id]={org_unit_id}{extra_qs}"
+        url = reverse("reports-aws-costs") + qs
+        response = self.client.get(url, **self.headers)
+        self.assertEqual(response.status_code, status.HTTP_200_OK)
+        return response
+
+    def _nested_value_for_key(self, data, key):
+        if isinstance(data, dict):
+            if key in data:
+                return data[key]
+            for value in data.values():
+                nested_value = self._nested_value_for_key(value, key)
+                if nested_value is not None:
+                    return nested_value
+        return None
+
+    def _org_entity_ids_by_date(self, response_data):
+        return {
+            entry.get("date"): [org_entity.get("id") for org_entity in entry.get("org_entities", [])]
+            for entry in response_data.get("data", [])
+        }
+
+    def _org_entity_costs(self, entry):
+        return [
+            org_entity["values"][0]["cost"]["total"]["value"]
+            for org_entity in entry.get("org_entities", [])
+        ]
+
+    def _unique_org_entity_ids(self, response_data):
+        org_ids = set()
+        for entry in response_data.get("data", []):
+            org_ids.update(
+                org_entity.get("id")
+                for org_entity in entry.get("org_entities", [])
+                if org_entity.get("id") is not None
+            )
+        return org_ids
+
+    @RbacPermissions({"aws.account": {"read": ["*"]}, "aws.organizational_unit": {"read": ["*"]}})
+    def test_group_by_org_unit_wildcard_costs_reports(self):
+        """Test that grouping by org unit with a wildcard raises a validation error."""
+        qs = "?group_by[org_unit_id]=*"
+        url = reverse("reports-aws-costs") + qs
+        response = self.client.get(url, **self.headers)
+
+        self.assertEqual(response.status_code, status.HTTP_400_BAD_REQUEST)
+        response_data = response.json()
+        org_unit_error = self._nested_value_for_key(response_data, "org_unit_id")
+        self.assertIsNotNone(org_unit_error)
+
+        self.assertIn("Unsupported parameter or invalid value", str(org_unit_error))
+
+    @RbacPermissions({"aws.account": {"read": ["*"]}, "aws.organizational_unit": {"read": ["*"]}})
+    def test_ou_group_by_pagination_count_uses_unpaged_unique_entities(self):
+        """Test org unit pagination count before page slicing."""
+        unpaged_response = self._costs_org_unit_response()
+        unpaged_data = unpaged_response.json()
+        unique_org_ids = self._unique_org_entity_ids(unpaged_data)
+        self.assertTrue(unique_org_ids)
+
+        limited_response = self._costs_org_unit_response(extra_qs="&filter[limit]=1&filter[offset]=0")
+        limited_data = limited_response.json()
+        meta = limited_data.get("meta", {})
+
+        self.assertEqual(meta.get("count"), len(unique_org_ids))
+        if len(unique_org_ids) > 1:
+            first_day_entities = limited_data.get("data", [{}])[0].get("org_entities", [])
+            self.assertLess(len(first_day_entities), meta.get("count"))
+
+    @RbacPermissions({"aws.account": {"read": ["*"]}, "aws.organizational_unit": {"read": ["*"]}})
+    def test_ou_group_by_filter_limit_offset_pagination(self):
+        """Test that org unit pagination applies the requested limit."""
+        limit = 1
+        response = self._costs_org_unit_response(extra_qs=f"&filter[limit]={limit}&filter[offset]=0")
+        response_data = response.json()
+        meta = response_data.get("meta", {})
+
+        self.assertIn("total", meta)
+        self.assertIn("filter", meta)
+        self.assertIn("count", meta)
+
+        for entry in response_data.get("data", []):
+            org_entities = entry.get("org_entities", [])
+            self.assertLessEqual(len(org_entities), limit)
+
+    @RbacPermissions({"aws.account": {"read": ["*"]}, "aws.organizational_unit": {"read": ["*"]}})
+    def test_ou_group_by_filter_limit_window_changes(self):
+        """Test that changing the offset changes the visible org unit window."""
+        unpaged_data = self._costs_org_unit_response().json()
+        unpaged_ids_by_date = self._org_entity_ids_by_date(unpaged_data)
+        self.assertTrue(any(len(ids) > 1 for ids in unpaged_ids_by_date.values()))
+
+        first_page = self._costs_org_unit_response(extra_qs="&filter[limit]=1&filter[offset]=0").json()
+        second_page = self._costs_org_unit_response(extra_qs="&filter[limit]=1&filter[offset]=1").json()
+        first_ids_by_date = self._org_entity_ids_by_date(first_page)
+        second_ids_by_date = self._org_entity_ids_by_date(second_page)
+
+        for date, unpaged_ids in unpaged_ids_by_date.items():
+            if len(unpaged_ids) > 1:
+                self.assertEqual(first_ids_by_date.get(date), [unpaged_ids[0]])
+                self.assertEqual(second_ids_by_date.get(date), [unpaged_ids[1]])
+                self.assertNotEqual(first_ids_by_date.get(date), second_ids_by_date.get(date))
+
+    @RbacPermissions({"aws.account": {"read": ["*"]}, "aws.organizational_unit": {"read": ["*"]}})
+    def test_ou_group_by_filter_limit_high_offset_pagination(self):
+        """Test that high offset pagination does not return the original full list."""
+        limit = 2
+        offset = 10
+        unpaged_data = self._costs_org_unit_response().json()
+        unpaged_ids_by_date = self._org_entity_ids_by_date(unpaged_data)
+
+        response = self._costs_org_unit_response(extra_qs=f"&filter[limit]={limit}&filter[offset]={offset}")
+        response_data = response.json()
+
+        for entry in response_data.get("data", []):
+            date = entry.get("date")
+            org_entities = entry.get("org_entities", [])
+            expected_len = min(limit, max(len(unpaged_ids_by_date.get(date, [])) - offset, 0))
+            self.assertEqual(len(org_entities), expected_len)
+
+    @RbacPermissions({"aws.account": {"read": ["*"]}, "aws.organizational_unit": {"read": ["*"]}})
+    def test_group_by_org_unit_order_by_cost_asc(self):
+        """Test that ordering by cost=asc orders each day's org units by cost."""
+        response = self._costs_org_unit_response(extra_qs="&order_by[cost]=asc")
+        response_data = response.json()
+
+        for entry in response_data.get("data", []):
+            costs = self._org_entity_costs(entry)
+            self.assertEqual(costs, sorted(costs))
+
+    @RbacPermissions({"aws.account": {"read": ["*"]}, "aws.organizational_unit": {"read": ["*"]}})
+    def test_group_by_org_unit_order_by_cost_desc(self):
+        """Test that ordering by cost=desc orders each day's org units by cost."""
+        response = self._costs_org_unit_response(extra_qs="&order_by[cost]=desc")
+        response_data = response.json()
+
+        for entry in response_data.get("data", []):
+            costs = self._org_entity_costs(entry)
+            self.assertEqual(costs, sorted(costs, reverse=True))
+
+    @RbacPermissions({"aws.account": {"read": ["*"]}, "aws.organizational_unit": {"read": ["*"]}})
+    def test_ou_group_by_pagination_applies_to_non_root_org_unit_when_available(self):
+        """Test the same org unit behavior for a valid non-example org unit."""
+        root_data = self._costs_org_unit_response().json()
+        candidate_ids = sorted(
+            org_id for org_id in self._unique_org_entity_ids(root_data) if org_id and org_id != "R_001"
+        )
+        candidate_id = None
+
+        for org_id in candidate_ids:
+            candidate_response = self._costs_org_unit_response(
+                org_unit_id=org_id,
+                extra_qs="&filter[limit]=1&filter[offset]=0&order_by[cost]=desc",
+            )
+            candidate_data = candidate_response.json()
+            if any(entry.get("org_entities") for entry in candidate_data.get("data", [])):
+                candidate_id = org_id
+                break
+
+        if candidate_id is None:
+            self.skipTest("fixture does not expose a non-root org unit with nested cost entities")
+
+        limited_data = candidate_data
+        unpaged_data = self._costs_org_unit_response(org_unit_id=candidate_id, extra_qs="&order_by[cost]=desc").json()
+
+        for entry in limited_data.get("data", []):
+            org_entities = entry.get("org_entities", [])
+            self.assertLessEqual(len(org_entities), 1)
+            costs = self._org_entity_costs(entry)
+            self.assertEqual(costs, sorted(costs, reverse=True))
+
+        self.assertEqual(
+            limited_data.get("meta", {}).get("count"),
+            len(self._unique_org_entity_ids(unpaged_data)),
+        )
