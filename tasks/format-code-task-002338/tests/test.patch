@@ -0,0 +1,87 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+if [ ! -x /testbed/.venv/bin/python ]; then
+    /testbed/.build_env/test_command.sh setup-only
+fi
+
+
+if ! pg_isready -p 15432 -q 2>/dev/null; then
+    pg_ctlcluster 16 main start 2>/dev/null || true
+    sleep 2
+fi
+
+
+su - postgres -c "psql -p 15432 -c \"DO \$\$ BEGIN CREATE USER koku_tester WITH SUPERUSER; EXCEPTION WHEN duplicate_object THEN NULL; END \$\$;\"" 2>/dev/null || true
+su - postgres -c "psql -p 15432 -c \"CREATE DATABASE koku_test OWNER koku_tester;\"" 2>/dev/null || true
+
+
+set +u
+source /testbed/.venv/bin/activate
+set -u
+export DATABASE_SERVICE_NAME=POSTGRES_SQL
+export DATABASE_ENGINE=postgresql
+export DATABASE_NAME=koku_test
+export POSTGRES_SQL_SERVICE_HOST=localhost
+export POSTGRES_SQL_SERVICE_PORT=15432
+export DATABASE_ADMIN=postgres
+export DATABASE_USER=koku_tester
+export DATABASE_PASSWORD=''
+export prometheus_multiproc_dir=/tmp
+export PYTHONPATH=/testbed/koku:/testbed
+
+
+python3 - <<'PY'
+from pathlib import Path
+
+path = Path("/testbed/scripts/insert_aws_org_tree.py")
+text = path.read_text()
+old = """                LOG.info(f"Updating account={act_info.get('account_alias_name')} with delete_timestamp={date}")"""
+new = (
+    '                account_name = act_info.get("account_alias_name") if act_info else account_id\n'
+    '                LOG.info(f"Updating account={account_name} with delete_timestamp={date}")'
+)
+if old in text:
+    path.write_text(text.replace(old, new))
+
+runner_path = Path("/testbed/koku/koku/koku_test_runner.py")
+runner_text = runner_path.read_text()
+for call in (
+    '                    data_loader.load_openshift_data(customer, "ocp_aws_static_data.yml", "OCP-on-AWS")',
+    '                    data_loader.load_openshift_data(customer, "ocp_azure_static_data.yml", "OCP-on-Azure")',
+    '                    data_loader.load_azure_data(customer, "azure_static_data.yml")',
+):
+    runner_text = runner_text.replace(call, f"                    # fixture fixture setup: skipped non-AWS loader {call.strip()!r}")
+runner_path.write_text(runner_text)
+PY
+
+run_django_tests() {
+    su - postgres -c "psql -p 15432 -c \"DROP DATABASE IF EXISTS test_koku_test;\"" 2>/dev/null || true
+    python3 /testbed/koku/manage.py test --noinput -v 2 "$@"
+}
+
+case "${1:-}" in
+  base)
+    run_django_tests \
+      api.report.test.aws.test_views.AWSReportViewTest.test_execute_query_w_group_by_rbac_no_restrictions \
+      api.report.test.aws.test_views.AWSReportViewTest.test_group_by_org_unit_non_costs_reports
+    ;;
+  new)
+    run_django_tests \
+      api.report.test.aws.test_views.AWSReportViewTest.test_group_by_org_unit_wildcard_costs_reports \
+      api.report.test.aws.test_views.AWSReportViewTest.test_ou_group_by_pagination_count_uses_unpaged_unique_entities \
+      api.report.test.aws.test_views.AWSReportViewTest.test_ou_group_by_filter_limit_offset_pagination \
+      api.report.test.aws.test_views.AWSReportViewTest.test_ou_group_by_filter_limit_window_changes \
+      api.report.test.aws.test_views.AWSReportViewTest.test_ou_group_by_filter_limit_high_offset_pagination \
+      api.report.test.aws.test_views.AWSReportViewTest.test_group_by_org_unit_order_by_cost_asc \
+      api.report.test.aws.test_views.AWSReportViewTest.test_group_by_org_unit_order_by_cost_desc \
+      api.report.test.aws.test_views.AWSReportViewTest.test_ou_group_by_pagination_applies_to_non_root_org_unit_when_available \
+      api.report.test.test_repo_config.RepoConfigTest.test_pyup_only_updates_insecure_dependencies \
+      api.report.test.test_repo_config.RepoConfigTest.test_unittest_dependency_cache_key_includes_git_ref
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
