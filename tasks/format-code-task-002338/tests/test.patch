new file mode 100644
index 000000000..245ea936b
--- /dev/null
+++ b/koku/api/report/test/test_repo_config.py
@@ -0,0 +1,40 @@
+
+from pathlib import Path
+import unittest
+
+
+REPO_ROOT = Path(__file__).resolve().parents[4]
+
+
+class RepoConfigTest(unittest.TestCase):
+
+
+    def test_pyup_only_updates_insecure_dependencies(self):
+        pyup_config = REPO_ROOT / ".pyup.yml"
+        update_value = None
+
+        for raw_line in pyup_config.read_text().splitlines():
+            line = raw_line.split("#", 1)[0].rstrip()
+            if line.startswith("update:"):
+                update_value = line.split(":", 1)[1].strip()
+                break
+
+        self.assertEqual(update_value, "insecure")
+
+    def test_unittest_dependency_cache_key_includes_git_ref(self):
+        workflow = REPO_ROOT / ".github" / "workflows" / "unittests.yml"
+        lines = workflow.read_text().splitlines()
+        cache_step = []
+        in_cache_step = False
+
+        for line in lines:
+            if "id: cache-dependencies" in line:
+                in_cache_step = True
+            elif in_cache_step and line.startswith("      - name:"):
+                break
+            if in_cache_step:
+                cache_step.append(line.split("#", 1)[0].strip())
+
+        cache_step_text = " ".join(cache_step)
+        self.assertIn("key:", cache_step_text)
+        self.assertIn("github.ref", cache_step_text)
