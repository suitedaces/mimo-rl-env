+++ b/test-script.mjs
@@ -0,0 +1,15 @@
+import {execa} from './index.js';
+process.on('uncaughtException', err => {
+  console.log('UNCAUGHT:', err.message);
+  process.exit(99);
+});
+const subprocess = execa('node', ['./test/fixtures/forever.js'], {buffer: false, all: true, reject: false, timeout: 3e3});
+setTimeout(() => {
+  subprocess.all.destroy(new Error('test-all-destroy'));
+}, 100);
+try {
+  const result = await subprocess;
+  console.log('failed:', result.failed, 'timedOut:', result.timedOut, 'msg:', result.shortMessage);
+} catch (e) {
+  console.log('CAUGHT:', e.message);
+}
