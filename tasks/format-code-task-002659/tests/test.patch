+
+const testBufferFalseDestroyReject = async (t, streamName) => {
+	const subprocess = execa('forever.js', {buffer: false});
+	subprocess[streamName].destroy(new Error('destroyed-test'));
+	await t.throwsAsync(subprocess, {message: /destroyed-test/});
+};
+
+test('buffer: false > stdout.destroy(error) rejects subprocess promise', testBufferFalseDestroyReject, 'stdout');
+test('buffer: false > stderr.destroy(error) rejects subprocess promise', testBufferFalseDestroyReject, 'stderr');
+
+test('buffer: false, reject: false > stdout.destroy(error) resolves without uncaught exception', async t => {
+	const subprocess = execa('forever.js', {buffer: false, reject: false, timeout: 1e4});
+	subprocess.stdout.destroy(new Error('destroyed-test'));
+	const result = await subprocess;
+	t.true(result.failed);
+	t.false(result.timedOut);
+});
+
+test('buffer: false, reject: false > stderr.destroy(error) resolves without uncaught exception', async t => {
+	const subprocess = execa('forever.js', {buffer: false, reject: false, timeout: 1e4});
+	subprocess.stderr.destroy(new Error('destroyed-test'));
+	const result = await subprocess;
+	t.true(result.failed);
+	t.false(result.timedOut);
+});
+
+test('buffer: false, all: true > stdout.destroy(error) does not hang', async t => {
+	const subprocess = execa('forever.js', {buffer: false, all: true, reject: false, timeout: 1e4});
+	subprocess.stdout.destroy(new Error('destroyed-test'));
+	const result = await subprocess;
+	t.true(result.failed);
+	t.false(result.timedOut);
+});
