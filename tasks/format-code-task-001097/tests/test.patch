diff --git a/test/transaction_builder_witness_order.js b/test/transaction_builder_witness_order.js
new file mode 100644
index 00000000..4f56be1b
--- /dev/null
+++ b/test/transaction_builder_witness_order.js
@@ -0,0 +1,68 @@
+
+
+var assert = require('assert')
+var BigInteger = require('bigi')
+var ECPair = require('../src/ecpair')
+var ECSignature = require('../src/ecsignature')
+var Transaction = require('../src/transaction')
+var TransactionBuilder = require('../src/transaction_builder')
+var bcrypto = require('../src/crypto')
+var btemplates = require('../src/templates')
+var NETWORK = require('../src/networks').bitcoin
+
+var keys = [1, 2, 3].map(function (n) {
+  return new ECPair(BigInteger.valueOf(n))
+})
+var pubKeys = keys.map(function (key) { return key.getPublicKeyBuffer() })
+var witnessScript = btemplates.multisig.output.encode(3, pubKeys)
+var witnessProgram = btemplates.witnessScriptHash.output.encode(bcrypto.sha256(witnessScript))
+var redeemScript = witnessProgram
+var txHash = '11'.repeat(32)
+
+function makePartiallySigned (nested, value) {
+  var txb = new TransactionBuilder(NETWORK)
+  var prevOutScript = nested
+    ? btemplates.scriptHash.output.encode(bcrypto.hash160(redeemScript))
+    : witnessProgram
+  txb.addInput(txHash, 0, undefined, prevOutScript)
+  txb.addOutput('1111111111111111111114oLvT2', 90000)
+  txb.sign(0, keys[0], nested ? redeemScript : undefined, Transaction.SIGHASH_NONE, value, witnessScript)
+  txb.sign(0, keys[2], nested ? redeemScript : undefined, Transaction.SIGHASH_SINGLE, value, witnessScript)
+
+  var tx = txb.buildIncomplete()
+  var witness = tx.ins[0].witness
+  var firstSignature = witness[1]
+  witness[1] = witness[3]
+  witness[3] = firstSignature
+  return tx
+}
+
+function assertWitnessSignaturesMatchPubkeys (tx, value) {
+  var witness = tx.ins[0].witness
+  var signatures = witness.slice(1, -1)
+  assert.strictEqual(witness[0].length, 0)
+  assert.deepEqual(witness[witness.length - 1], witnessScript)
+  assert.strictEqual(signatures.length, 3)
+  signatures.forEach(function (signature, i) {
+    var parsed = ECSignature.parseScriptSignature(signature)
+    assert.strictEqual(parsed.hashType, [Transaction.SIGHASH_NONE, Transaction.SIGHASH_ALL, Transaction.SIGHASH_SINGLE][i])
+    var sighash = tx.hashForWitnessV0(0, witnessScript, value, parsed.hashType)
+    assert.strictEqual(keys[i].verify(sighash, parsed.signature), true, 'signature ' + i + ' must match witnessScript pubkey ' + i)
+  })
+}
+
+describe('TransactionBuilder imported P2WSH multisig ordering', function () {
+  it('restores native P2WSH signature positions before continuing to sign', function () {
+    var txb = TransactionBuilder.fromTransaction(makePartiallySigned(false, 100000), NETWORK)
+    txb.sign(0, keys[1], undefined, undefined, 100000, witnessScript)
+
+    assertWitnessSignaturesMatchPubkeys(txb.build(), 100000)
+  })
+
+  it('restores nested P2SH-P2WSH signature positions before continuing to sign', function () {
+    var txb = TransactionBuilder.fromTransaction(makePartiallySigned(true, 120000), NETWORK)
+    txb.sign(0, keys[1], redeemScript, undefined, 120000, witnessScript)
+
+    assertWitnessSignaturesMatchPubkeys(txb.build(), 120000)
+  })
+})
