diff --git a/usercase-test-coderl/fixtures/inspect_config.go b/usercase-test-coderl/fixtures/inspect_config.go
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/fixtures/inspect_config.go
@@ -0,0 +1,72 @@
+package main
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/buger/jsonparser"
+	"github.com/thrasher-corp/gocryptotrader/config"
+)
+
+func main() {
+	if len(os.Args) != 4 {
+		fmt.Fprintln(os.Stderr, "usage: inspect_config <key> <file> <field>")
+		os.Exit(64)
+	}
+
+	data, err := os.ReadFile(os.Args[2])
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	isEncrypted := config.IsEncrypted(data)
+
+	if os.Args[3] == "isEncrypted" {
+		fmt.Println(isEncrypted)
+		return
+	}
+	if isEncrypted {
+		data, err = config.DecryptConfigData(data, []byte(os.Args[1]))
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+	}
+
+	switch os.Args[3] {
+	case "encryptConfig":
+		v, err := jsonparser.GetInt(data, "encryptConfig")
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		fmt.Println(v)
+	case "version":
+		v, err := jsonparser.GetInt(data, "version")
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		fmt.Println(v)
+
+	case "name":
+		v, err := jsonparser.GetString(data, "name")
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		fmt.Println(v)
+	case "nested.keep":
+		v, err := jsonparser.GetBoolean(data, "nested", "keep")
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		fmt.Println(v)
+	case "raw":
+		fmt.Print(string(data))
+	default:
+		fmt.Fprintln(os.Stderr, "unknown field")
+		os.Exit(64)
+	}
+}
diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,152 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+( cd /workspace/repo && go build -o /tmp/gct-config-acceptance ./cmd/config ) \
+	|| { echo "FAIL: build config helper" >&2; exit 1; }
+( cd /workspace/repo && go build -o /tmp/gct-config-inspect ./usercase-test-coderl/fixtures/inspect_config.go ) \
+	|| { echo "FAIL: build encrypted config inspector" >&2; exit 1; }
+
+BIN=/tmp/gct-config-acceptance
+INSPECT=/tmp/gct-config-inspect
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || exit 1
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+assert_success_stdout_for_path() {
+	local file=$1
+
+	grep -Fxq "Success! File written to $file" out || fail "stdout missing success for $file: $(cat out)"
+}
+
+write_plain() {
+	local file=$1
+	cat > "$file" <<'JSON'
+{"name":"Fixture","version":11,"encryptConfig":-1,"nested":{"keep":true}}
+JSON
+}
+
+assert_encrypted_config() {
+	local file=$1
+
+	[ "$("$INSPECT" secret "$file" isEncrypted)" = "true" ] || fail "$file was not written as encrypted config data"
+}
+
+
+
+
+write_plain config.json
+"$BIN" encrypt --in config.json --out config.dat --key secret >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_success_stdout_for_path config.dat
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+[ -s config.dat ] || fail "F1 encrypted output not written"
+assert_encrypted_config config.dat
+[ "$("$INSPECT" secret config.dat encryptConfig)" = "1" ] || fail "F1 encrypted payload did not set encryptConfig to 1"
+
+
+
+
+"$BIN" decrypt --in config.dat --out decrypted.json --key secret >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_success_stdout_for_path decrypted.json
+[ ! -s err ] || fail "F2 unexpected stderr: $(cat err)"
+
+[ "$("$INSPECT" secret decrypted.json isEncrypted)" = "false" ] || fail "F2 plaintext output was still encrypted"
+[ "$("$INSPECT" secret decrypted.json encryptConfig)" = "-1" ] || fail "F2 plaintext output did not set encryptConfig to -1"
+[ "$("$INSPECT" secret decrypted.json name)" = "Fixture" ] || fail "F2 plaintext output did not preserve name"
+[ "$("$INSPECT" secret decrypted.json version)" = "11" ] || fail "F2 plaintext output did not preserve version"
+[ "$("$INSPECT" secret decrypted.json nested.keep)" = "true" ] || fail "F2 plaintext output did not preserve nested data"
+
+
+
+
+write_plain prompt_plain.json
+printf 'secret\nsecret\n' | "$BIN" encrypt --in prompt_plain.json --out prompted.dat >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+
+assert_success_stdout_for_path prompted.dat
+[ ! -s err ] || fail "F3 unexpected stderr: $(cat err)"
+assert_encrypted_config prompted.dat
+[ "$("$INSPECT" secret prompted.dat encryptConfig)" = "1" ] || fail "F3 prompted encrypted payload did not set encryptConfig to 1"
+
+
+
+
+printf 'secret\n' | "$BIN" decrypt --in prompted.dat --out prompted.json >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+
+assert_success_stdout_for_path prompted.json
+[ ! -s err ] || fail "F4 unexpected stderr: $(cat err)"
+[ "$("$INSPECT" secret prompted.json isEncrypted)" = "false" ] || fail "F4 prompted plaintext output was still encrypted"
+[ "$("$INSPECT" secret prompted.json encryptConfig)" = "-1" ] || fail "F4 prompted plaintext output did not set encryptConfig to -1"
+
+
+
+
+"$BIN" encrypt --in config.dat --out should_not_write.dat --key secret >out 2>err; ec=$?
+EXPECTED_ERR='Error: File is already encrypted'
+[ "$ec" -eq 2 ] || fail "F5 exit $ec; want 2"
+
+[ "$(cat err)" = "$EXPECTED_ERR" ] || fail "F5 stderr: $(cat err)"
+[ ! -e should_not_write.dat ] || fail "F5 wrote output on error"
+
+
+
+
+"$BIN" decrypt --in config.json --out should_not_write.json --key secret >out 2>err; ec=$?
+EXPECTED_ERR='Error: File is already decrypted'
+[ "$ec" -eq 2 ] || fail "F6 exit $ec; want 2"
+
+[ "$(cat err)" = "$EXPECTED_ERR" ] || fail "F6 stderr: $(cat err)"
+[ ! -e should_not_write.json ] || fail "F6 wrote output on error"
+
+
+
+
+cat > upgrade_plain.json <<'JSON'
+{"version":10,"encryptConfig":-1,"exchanges":[{"name":"Poloniex","api":{"urlEndpoints":{"RestSpotURL":"https://poloniex.com","WebsocketSpotURL":"wss://api2.poloniex.com"}}}],"remoteControl":{"enabled":true}}
+JSON
+"$BIN" encrypt --in upgrade_plain.json --out upgrade.dat --key secret >/dev/null 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F7 setup encrypt exit $ec: $(cat err)"
+"$BIN" upgrade --in upgrade.dat --out upgraded.dat --key secret >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F7 exit $ec; want 0; stderr: $(cat err)"
+assert_success_stdout_for_path upgraded.dat
+
+assert_encrypted_config upgraded.dat
+[ "$("$INSPECT" secret upgraded.dat version)" = "11" ] || fail "F7 encrypted upgraded payload version is not 11"
+[ "$("$INSPECT" secret upgraded.dat encryptConfig)" = "1" ] || fail "F7 encrypted upgraded payload did not keep encryptConfig 1"
+
+
+
+
+cat > downgrade_plain.json <<'JSON'
+{"version":11,"encryptConfig":-1,"exchanges":[{"name":"Coinbase","api":{"urlEndpoints":{}}}],"portfolioAddresses":{"addresses":[],"providers":[{"name":"Ethplorer","enabled":true}]}}
+JSON
+"$BIN" encrypt --in downgrade_plain.json --out downgrade.dat --key secret >/dev/null 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F8 setup encrypt exit $ec: $(cat err)"
+"$BIN" downgrade --version 10 --in downgrade.dat --out downgraded.dat --key secret >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F8 exit $ec; want 0; stderr: $(cat err)"
+assert_success_stdout_for_path downgraded.dat
+
+assert_encrypted_config downgraded.dat
+[ "$("$INSPECT" secret downgraded.dat version)" = "10" ] || fail "F8 encrypted downgraded payload version is not 10"
+[ "$("$INSPECT" secret downgraded.dat encryptConfig)" = "1" ] || fail "F8 encrypted downgraded payload did not keep encryptConfig 1"
+
+
+
+
+"$BIN" >out 2>err; ec=$?
+[ "$ec" -eq 2 ] || fail "F9 exit $ec; want 2"
+
+grep -Eq '(^|[^[:alnum:]_-])encrypt([^[:alnum:]_-]|$)' err || fail "F9 help missing encrypt command"
+grep -Eq '(^|[^[:alnum:]_-])decrypt([^[:alnum:]_-]|$)' err || fail "F9 help missing decrypt command"
+grep -Eq '(^|[^[:alnum:]_-])upgrade([^[:alnum:]_-]|$)' err || fail "F9 help missing upgrade command"
+grep -Eq '(^|[^[:alnum:]_-])downgrade([^[:alnum:]_-]|$)' err || fail "F9 help missing downgrade command"
+grep -Eq '(^|[^[:alnum:]_-])--?key([^[:alnum:]_-]|$)' err || fail "F9 help missing key flag"
+
+echo "PASS"
+exit 0
