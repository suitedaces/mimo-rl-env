+import numpy as np
+
+from numpy_ml.trees import RandomForest
+
+
+
+
+
+
+
+def test_classification_query_example_builds_three_trees_and_predicts_one_label_per_row():
+
+
+
+
+    X = np.array([[0.0], [1.0], [2.0]])
+    Y = np.array([1, 1, 1])
+    query = np.array([[10.0], [-5.0]])
+
+    np.random.seed(0)
+    forest = RandomForest(
+        n_trees=3,
+        max_depth=2,
+        n_feats=1,
+        classifier=True,
+        criterion="entropy",
+    )
+
+
+    assert callable(forest.fit)
+    assert callable(forest.predict)
+
+    forest.fit(X, Y)
+
+    predictions = forest.predict(query)
+
+    assert isinstance(predictions, np.ndarray)
+    np.testing.assert_array_equal(predictions, np.array([1, 1]))
+    assert predictions.shape == (2,)
+
+
+def test_classification_bootstrap_vote_tie_chooses_smallest_label():
+
+
+
+
+    X = np.array([[0.0], [1.0]])
+    Y = np.array([0, 1])
+    query = np.array([[0.5]])
+
+    np.random.seed(1)
+    forest = RandomForest(
+        n_trees=2,
+        max_depth=1,
+        n_feats=1,
+        classifier=True,
+        criterion="entropy",
+    )
+    forest.fit(X, Y)
+
+    predictions = forest.predict(query)
+
+    np.testing.assert_array_equal(predictions, np.array([0]))
+    assert predictions.shape == (1,)
+
+    np.random.seed(1)
+    bootstrap_forest = RandomForest(
+        n_trees=3,
+        max_depth=1,
+        n_feats=1,
+        classifier=True,
+        criterion="entropy",
+    )
+    bootstrap_forest.fit(np.array([[0.0], [1.0]]), np.array([1, 0]))
+
+    np.testing.assert_array_equal(bootstrap_forest.predict(np.array([[-1.0]])), np.array([0]))
+
+
+def test_regression_query_example_builds_four_trees_and_returns_float_average():
+
+
+
+
+    X = np.array([[0.0], [1.0], [2.0]])
+    Y = np.array([2.5, 2.5, 2.5])
+    query = np.array([[10.0], [-5.0]])
+
+    np.random.seed(0)
+    forest = RandomForest(
+        n_trees=4,
+        max_depth=2,
+        n_feats=1,
+        classifier=False,
+        criterion="mse",
+    )
+
+    assert callable(forest.fit)
+    assert callable(forest.predict)
+
+    forest.fit(X, Y)
+
+    predictions = forest.predict(query)
+
+    assert isinstance(predictions, np.ndarray)
+    np.testing.assert_allclose(predictions, np.array([2.5, 2.5]))
+    assert predictions.shape == (2,)
+
+
+def test_regression_averages_distinct_tree_predictions():
+
+
+
+
+    X = np.array([[0.0], [1.0], [2.0]])
+    Y = np.array([7.25, 7.25, 7.25])
+    query = np.array([[-10.0], [0.5], [20.0]])
+
+    np.random.seed(0)
+    forest = RandomForest(
+        n_trees=2,
+        max_depth=1,
+        n_feats=1,
+        classifier=False,
+        criterion="mse",
+    )
+    forest.fit(X, Y)
+
+    predictions = forest.predict(query)
+
+    np.testing.assert_allclose(predictions, np.array([7.25, 7.25, 7.25]))
+    assert predictions.shape == (3,)
+
+
+def test_two_instances_keep_independent_fitted_state():
+
+
+
+
+    np.random.seed(0)
+    classifier = RandomForest(
+        n_trees=2,
+        max_depth=2,
+        n_feats=1,
+        classifier=True,
+        criterion="entropy",
+    )
+    regressor = RandomForest(
+        n_trees=4,
+        max_depth=2,
+        n_feats=1,
+        classifier=False,
+        criterion="mse",
+    )
+
+    classifier.fit(np.array([[0.0], [1.0], [2.0]]), np.array([1, 1, 1]))
+
+
+    np.testing.assert_array_equal(classifier.predict(np.array([[10.0]])), np.array([1]))
+
+    regressor.fit(np.array([[0.0], [1.0], [2.0]]), np.array([2.5, 2.5, 2.5]))
+
+
+    np.testing.assert_array_equal(classifier.predict(np.array([[10.0]])), np.array([1]))
+    np.testing.assert_allclose(
+        regressor.predict(np.array([[10.0], [-5.0]])),
+        np.array([2.5, 2.5]),
+    )
+
+
+def test_repeated_fit_replaces_previous_forest_without_accumulating_trees():
+
+
+
+
+    X = np.array([[0.0], [1.0], [2.0]])
+    Y_first = np.array([0, 0, 0])
+    Y_second = np.array([1, 1, 1])
+    query = np.array([[0.0], [2.0]])
+
+    np.random.seed(0)
+    forest = RandomForest(
+        n_trees=3,
+        max_depth=2,
+        n_feats=1,
+        classifier=True,
+        criterion="entropy",
+    )
+    forest.fit(X, Y_first)
+
+
+    np.testing.assert_array_equal(forest.predict(query), np.array([0, 0]))
+
+    for _ in range(100):
+        np.random.seed(0)
+        forest.fit(X, Y_second)
+
+        np.testing.assert_array_equal(forest.predict(query), np.array([1, 1]))
+
+
+def test_construct_fit_drop_cycles_keep_returning_spec_predictions():
+
+
+
+
+    X = np.array([[0.0], [1.0], [2.0]])
+    Y = np.array([1, 1, 1])
+    query = np.array([[10.0], [-5.0]])
+
+    for _ in range(100):
+        np.random.seed(0)
+        forest = RandomForest(
+            n_trees=3,
+            max_depth=2,
+            n_feats=1,
+            classifier=True,
+            criterion="entropy",
+        )
+        forest.fit(X, Y)
+        predictions = forest.predict(query)
+
+        assert isinstance(predictions, np.ndarray)
+        np.testing.assert_array_equal(predictions, np.array([1, 1]))
+        del forest
