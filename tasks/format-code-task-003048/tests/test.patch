+assert "self=https://jira.example/rest/api/2/issue/4242" in records
+PY
+[ ! -s "$TMP/basic.err" ] || fail "F_basic_print_payload_env unexpected stderr: $(cat "$TMP/basic.err")"
+
+python3 - "$SERVER_LOG" <<'PY' || fail "F_basic_print_payload_env request log: $(cat "$SERVER_LOG")"
