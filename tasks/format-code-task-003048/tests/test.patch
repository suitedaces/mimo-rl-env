+[ "$ec" -eq 0 ] || fail "F_forced_dry_config exit $ec; want 0"
+
+python3 - "$TMP/forced.out" "$TMP/desc-forced.md" <<'PY' || fail "F_forced_dry_config stdout: $(cat "$TMP/forced.out")"
+import json
+import sys
+from pathlib import Path
+
+text = Path(sys.argv[1]).read_text(encoding="utf-8")
+desc = Path(sys.argv[2]).read_text(encoding="utf-8")
+payload, idx = json.JSONDecoder().raw_decode(text)
+fields = payload["fields"]
+assert fields["project"]["key"] == "CFG"
+assert fields["summary"] == "Config default issue"
+assert fields["description"] in {desc, desc.rstrip("\n")}
+assert fields["issuetype"]["name"] == "Story"
+assert fields["labels"] == ["DorisExplorer"]
+records = text[idx:].lstrip("\n").splitlines()
+assert "key=DRYRUN-CFG-1" in records
+assert "self=https://dry-run.invalid/rest/api/2/issue/DRYRUN-CFG-1" in records
+assert "epic_linked=CFG-77" in records
+payload_lines = [line for line in records if line.startswith("payload=")]
+assert len(payload_lines) == 1
+single_line_payload = json.loads(payload_lines[0].split("=", 1)[1])
+assert single_line_payload == payload
+PY
+[ ! -s "$TMP/forced.err" ] || fail "F_forced_dry_config unexpected stderr: $(cat "$TMP/forced.err")"
+
+
+
+
+clean_jira_env
+start_server create_ok
+printf 'Real request body\n' >"$TMP/desc-real.txt"
+HOME="$TMP/home-real" JIRA_URL="http://127.0.0.1:$SERVER_PORT/" JIRA_TOKEN="bearer-token" run_jira \
+  --project-key DORIS \
+  --issue-type Bug \
+  --summary "Real bearer" \
+  --description-file "$TMP/desc-real.txt" \
+  --label DorisExplorer \
+  --component Planner \
+  --priority High \
+  --epic DORIS-24979 >"$TMP/real.out" 2>"$TMP/real.err"; ec=$?
+stop_server
+[ "$ec" -eq 0 ] || fail "F_real_bearer_epic exit $ec; want 0"
+
+assert_stdout_has_line "$TMP/real.out" "key=DORIS-4242"
+assert_stdout_has_line "$TMP/real.out" "self=https://jira.example/rest/api/2/issue/4242"
+assert_stdout_has_line "$TMP/real.out" "epic_linked=DORIS-24979"
+[ ! -s "$TMP/real.err" ] || fail "F_real_bearer_epic unexpected stderr: $(cat "$TMP/real.err")"
+
+python3 - "$SERVER_LOG" <<'PY' || fail "F_real_bearer_epic request log: $(cat "$SERVER_LOG")"
+import json
+import sys
+from pathlib import Path
+
+records = [json.loads(line) for line in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()]
+assert len(records) == 2
+create, epic = records
+assert create["path"] == "/rest/api/2/issue"
+assert create["authorization"] == "Bearer bearer-token"
+assert create["content_type"].startswith("application/json")
+fields = create["payload"]["fields"]
+assert fields["project"]["key"] == "DORIS"
+assert fields["summary"] == "Real bearer"
+assert fields["description"] in {"Real request body", "Real request body\n"}
+assert fields["issuetype"]["name"] == "Bug"
+assert fields["labels"] == ["DorisExplorer"]
+assert fields["components"] == [{"name": "Planner"}]
+assert fields["priority"]["name"] == "High"
+assert epic["path"] == "/rest/agile/1.0/epic/DORIS-24979/issue"
+assert epic["authorization"] == "Bearer bearer-token"
+assert epic["payload"] == {"issues": ["DORIS-4242"]}
+PY
+
+
+
+
+clean_jira_env
+start_server create_ok
+printf 'Basic body\n' >"$TMP/desc-basic.txt"
