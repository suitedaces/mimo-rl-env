+assert record["authorization"] == "Basic Ym9iOmJhc2ljLXRva2Vu"
+assert record["basic_user"] == "bob"
+assert record["content_type"].startswith("application/json")
+fields = record["payload"]["fields"]
+assert fields["project"]["key"] == "ENVPROJ"
+assert fields["summary"] == "Env basic"
+assert fields["description"] in {"Basic body", "Basic body\n"}
+assert fields["issuetype"]["name"] == "Task"
+PY
+
+
+
+
