+start_server epic_error
+printf 'Epic failure body\n' >"$TMP/desc-epic-fail.txt"
+HOME="$TMP/home-epic-fail" JIRA_URL="http://127.0.0.1:$SERVER_PORT" JIRA_TOKEN="bearer-token" run_jira \
