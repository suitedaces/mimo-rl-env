+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+REPO=/workspace/repo
+SKILL_DIR="$REPO/skills/jira-issue"
+FIXTURES="$REPO/usercase-test-coderl/fixtures"
+
+TMP=$(mktemp -d)
+trap 'jobs -pr | xargs -r kill 2>/dev/null || true; rm -rf "$TMP"' EXIT
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+
+VENV=/opt/stage4a-coderl-venv
+[ -x "$VENV/bin/python" ] || fail "offline venv missing: $VENV"
+"$VENV/bin/python" - <<'PY' || fail "offline dependencies unavailable"
+import click
+import requests
+PY
+chmod +x "$FIXTURES/uv"
+export PATH="$FIXTURES:$VENV/bin:$PATH"
+
+run_jira() {
+  ( cd "$SKILL_DIR" && uv run --project . python3 scripts/jira_create_issue.py "$@" )
+}
+
+clean_jira_env() {
+  unset JIRA_URL JIRA_TOKEN JIRA_USER JIRA_PROJECT JIRA_ISSUE_TYPE
+  unset MULTI_AGENT_TODO_JIRA_DRY_RUN
+}
+
+assert_stdout_has_line() {
+  file="$1"
+  expected="$2"
+  grep -Fxq "$expected" "$file" || fail "missing stdout line '$expected': $(cat "$file")"
+}
+
+start_server() {
+  mode="$1"
+  port_file="$TMP/server-$mode.port"
+  log_file="$TMP/server-$mode.log"
+  rm -f "$port_file"
+  : >"$log_file"
+  python3 "$FIXTURES/mock_jira_server.py" "$port_file" "$log_file" "$mode" &
+  server_pid=$!
+  for _ in $(seq 1 100); do
+    [ -s "$port_file" ] && break
+    sleep 0.05
+  done
+  [ -s "$port_file" ] || fail "mock server did not start for $mode"
+  SERVER_PID="$server_pid"
+  SERVER_PORT=$(cat "$port_file")
+  SERVER_LOG="$log_file"
+}
+
+stop_server() {
+  kill "$SERVER_PID" 2>/dev/null || true
+  wait "$SERVER_PID" 2>/dev/null || true
+}
+
+
+
+
+clean_jira_env
+run_jira --help >"$TMP/help.out" 2>"$TMP/help.err"; ec=$?
+[ "$ec" -eq 0 ] || fail "F_help exit $ec; want 0"
+[ ! -s "$TMP/help.err" ] || fail "F_help unexpected stderr: $(cat "$TMP/help.err")"
+
+grep -Fiq "usage" "$TMP/help.out" || fail "F_help missing usage"
+for flag in --jira-url --jira-user --jira-token --auth --project-key --issue-type --summary --description-file --label --component --affects-version --fix-version --assignee --priority --epic --print-payload --dry-run --help; do
+  grep -Fq -- "$flag" "$TMP/help.out" || fail "F_help missing $flag"
+done
+
+
+
+
+clean_jira_env
+mkdir -p "$TMP/home-dry"
+printf 'Planner stalls when queue has two reviewers\nSecond line is trimmed.\n' >"$TMP/desc-full.txt"
+HOME="$TMP/home-dry" run_jira \
+  --project-key DORIS \
+  --issue-type Bug \
+  --summary "Planner bug" \
+  --description-file "$TMP/desc-full.txt" \
+  --label DorisExplorer \
+  --label PlannerTag \
+  --component Planner \
+  --component Reviewer \
+  --affects-version 3.1.4 \
+  --fix-version 3.1.5 \
+  --assignee alice \
+  --priority High \
+  --dry-run >"$TMP/dry.out" 2>"$TMP/dry.err"; ec=$?
+[ "$ec" -eq 0 ] || fail "F_dry_full_payload exit $ec; want 0"
+
+python3 - "$TMP/dry.out" "$TMP/desc-full.txt" <<'PY' || fail "F_dry_full_payload payload: $(cat "$TMP/dry.out")"
+import json
+import sys
+from pathlib import Path
+
+payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
+desc = Path(sys.argv[2]).read_text(encoding="utf-8")
+fields = payload["fields"]
+assert fields["project"]["key"] == "DORIS"
+assert fields["summary"] == "Planner bug"
+assert fields["description"] in {desc, desc.rstrip("\n")}
+assert fields["issuetype"]["name"] == "Bug"
+assert set(fields["labels"]) == {"DorisExplorer", "PlannerTag"}
+assert {item["name"] for item in fields["components"]} == {"Planner", "Reviewer"}
+assert {item["name"] for item in fields["versions"]} == {"3.1.4"}
+assert {item["name"] for item in fields["fixVersions"]} == {"3.1.5"}
+assert fields["assignee"]["name"] == "alice"
+assert fields["priority"]["name"] == "High"
+PY
+[ ! -s "$TMP/dry.err" ] || fail "F_dry_full_payload unexpected stderr: $(cat "$TMP/dry.err")"
+
+
+
+
+clean_jira_env
+mkdir -p "$TMP/home-forced"
+printf 'JIRA_PROJECT=CFG\nJIRA_ISSUE_TYPE=Story\n' >"$TMP/home-forced/.env"
+printf 'Regression body\n' >"$TMP/desc-forced.md"
+HOME="$TMP/home-forced" MULTI_AGENT_TODO_JIRA_DRY_RUN=1 run_jira \
