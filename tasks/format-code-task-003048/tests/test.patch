+  --description-file "$TMP/desc-basic-no-user.txt" >"$TMP/basic-no-user.out" 2>"$TMP/basic-no-user.err"; ec=$?
+
+[ "$ec" -ne 0 ] || fail "F_basic_missing_user exit $ec; want nonzero"
+[ ! -s "$TMP/basic-no-user.out" ] || fail "F_basic_missing_user unexpected stdout: $(cat "$TMP/basic-no-user.out")"
+grep -Fq "Basic auth requires --jira-user or JIRA_USER." "$TMP/basic-no-user.err" || fail "F_basic_missing_user stderr: $(cat "$TMP/basic-no-user.err")"
+
