+  --summary "Env basic" \
+  --description-file "$TMP/desc-basic.txt" \
+  --print-payload >"$TMP/basic.out" 2>"$TMP/basic.err"; ec=$?
+stop_server
+[ "$ec" -eq 0 ] || fail "F_basic_print_payload_env exit $ec; want 0"
+
+python3 - "$TMP/basic.out" <<'PY' || fail "F_basic_print_payload_env stdout: $(cat "$TMP/basic.out")"
+import json
