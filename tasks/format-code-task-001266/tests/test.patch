+func TestFlags_UnmarshalYAML_BoolLikeKey_Empty(t *testing.T) {
+	input := []byte("yes:\n")
+
+	var flags Flags
+	require.NotPanics(t, func() {
+		err := yaml.Unmarshal(input, &flags)
+		require.NoError(t, err, "yaml unmarshal should not error on bool-like key")
+	})
+
+	require.Len(t, flags, 1)
+	assert.Equal(t, "yes", flags[0].Name, "key 'yes' must be preserved as the string 'yes', not converted to 'true'")
+	assert.Empty(t, flags[0].Values, "empty value should produce a valueless flag")
+}
+
+
+func TestFlags_UnmarshalYAML_BoolLikeKey_EmptyString(t *testing.T) {
+	input := []byte("yes: \"\"\n")
+
+	var flags Flags
+	require.NotPanics(t, func() {
+		err := yaml.Unmarshal(input, &flags)
+		require.NoError(t, err)
+	})
+
+	require.Len(t, flags, 1)
+	assert.Equal(t, "yes", flags[0].Name, "key 'yes' must be preserved as the string 'yes'")
+}
+
+
+func TestFlags_UnmarshalYAML_BoolLikeKey_ToSlice(t *testing.T) {
+	input := []byte("yes:\n")
+
+	var flags Flags
+	err := yaml.Unmarshal(input, &flags)
+	require.NoError(t, err)
+
+	args := flags.ToSlice(testStep.GetDashes())
+	assert.Equal(t, []string{"--yes"}, args, "bool-like key 'yes' should produce --yes flag, not --true")
+}
+
+
+func TestFlags_UnmarshalYAML_OtherBoolLikeKeys(t *testing.T) {
+	cases := []struct {
+		yaml string
+		name string
+	}{
+		{"no:\n", "no"},
+		{"on:\n", "on"},
+		{"off:\n", "off"},
+		{"y:\n", "y"},
+		{"n:\n", "n"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var flags Flags
+			require.NotPanics(t, func() {
+				err := yaml.Unmarshal([]byte(tc.yaml), &flags)
+				require.NoError(t, err)
+			})
+			require.Len(t, flags, 1)
+			assert.Equal(t, tc.name, flags[0].Name,
+				"yaml bool-like key %q must be preserved verbatim, not converted to 'true'/'false'", tc.name)
+		})
+	}
+}
+
+
+func TestFlags_UnmarshalYAML_StringKey_StillWorks(t *testing.T) {
+	input := []byte("force: true\n")
+
+	var flags Flags
+	err := yaml.Unmarshal(input, &flags)
+	require.NoError(t, err)
+	require.Len(t, flags, 1)
+	assert.Equal(t, "force", flags[0].Name)
+	assert.Equal(t, []string{"true"}, flags[0].Values)
+}
