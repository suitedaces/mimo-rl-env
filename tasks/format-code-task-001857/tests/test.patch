@@ -0,0 +1,428 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+
+
+
+
+
+
+
+class FakeElement {
+    constructor(tagName = "div") {
+        this.tagName = tagName.toUpperCase();
+        this.children = [];
+        this.parentNode = null;
+        this.style = {};
+        this.attributes = new Map();
+        this._listeners = new Map();
+        this.width = 0;
+        this.height = 0;
+    }
+
+    setAttribute(name, value) {
+        this.attributes.set(name, String(value));
+        if(name === "id") {
+            this.id = String(value);
+            globalThis.document?._elements?.set(this.id, this);
+        }
+    }
+
+    appendChild(child) {
+        this.children.push(child);
+        child.parentNode = this;
+        return child;
+    }
+
+    removeChild(child) {
+        const index = this.children.indexOf(child);
+        if(index !== -1) {
+            this.children.splice(index, 1);
+        }
+        child.parentNode = null;
+        return child;
+    }
+
+    getBoundingClientRect() {
+        return {width: 320, height: 240, top: 7, left: 11};
+    }
+
+    addEventListener(type, handler, options) {
+        const listeners = this._listeners.get(type) || [];
+        listeners.push({handler, options});
+        this._listeners.set(type, listeners);
+    }
+
+    removeEventListener(type, handler) {
+        const listeners = this._listeners.get(type) || [];
+        this._listeners.set(type, listeners.filter((entry) => entry.handler !== handler));
+    }
+
+    dispatchEvent(event) {
+        const listeners = this._listeners.get(event.type) || [];
+        for(const {handler} of [...listeners]) {
+            handler.call(this, event);
+        }
+    }
+
+    getContext() {
+        if(this.tagName !== "CANVAS") {
+            return null;
+        }
+
+        return createFakeGL();
+    }
+}
+
+function createFakeGL() {
+    return {
+        MAX_TEXTURE_SIZE: 0x0D33,
+        DEPTH_TEST: 0x0B71,
+        BLEND: 0x0BE2,
+        LEQUAL: 0x0203,
+        ONE: 1,
+        ONE_MINUS_SRC_ALPHA: 0x0303,
+        SRC_ALPHA: 0x0302,
+        COLOR_BUFFER_BIT: 0x4000,
+        DEPTH_BUFFER_BIT: 0x0100,
+        CULL_FACE: 0x0B44,
+        FRONT: 0x0404,
+        BACK: 0x0405,
+        FRAMEBUFFER: 0x8D40,
+        drawingBufferWidth: 320,
+        drawingBufferHeight: 240,
+
+        getParameter(parameter) {
+            return parameter === this.MAX_TEXTURE_SIZE ? 4096 : 0;
+        },
+
+        getExtension(name) {
+            return name === "WEBGL_lose_context"
+                ? {loseContext() {}, restoreContext() {}}
+                : {};
+        },
+
+        viewport() {},
+        enable() {},
+        disable() {},
+        depthFunc() {},
+        blendFuncSeparate() {},
+        clear() {},
+        deleteProgram() {},
+        bindFramebuffer() {},
+        cullFace() {},
+        useProgram() {},
+    };
+}
+
+function installBrowserHarness() {
+    const windowListeners = new Map();
+    let rafId = 0;
+
+    globalThis.Element = FakeElement;
+    globalThis.navigator = {userAgent: "node-test"};
+    globalThis.document = {
+        _elements: new Map(),
+        body: new FakeElement("body"),
+        createElement(tagName) {
+            return new FakeElement(tagName);
+        },
+        getElementById(id) {
+            return this._elements.get(id) || null;
+        },
+    };
+
+    globalThis.window = {
+        devicePixelRatio: 1,
+        pageXOffset: 10,
+        pageYOffset: 20,
+        MSStream: false,
+
+        addEventListener(type, handler, options) {
+            const listeners = windowListeners.get(type) || [];
+            listeners.push({handler, options});
+            windowListeners.set(type, listeners);
+        },
+
+        removeEventListener(type, handler) {
+            const listeners = windowListeners.get(type) || [];
+            windowListeners.set(type, listeners.filter((entry) => entry.handler !== handler));
+        },
+
+        dispatchEvent(event) {
+            const listeners = windowListeners.get(event.type) || [];
+            for(const {handler} of [...listeners]) {
+                handler.call(globalThis.window, event);
+            }
+        },
+
+        requestAnimationFrame() {
+            rafId += 1;
+            return rafId;
+        },
+
+        cancelAnimationFrame() {},
+    };
+
+    return {
+        listenerCount(type) {
+            return (windowListeners.get(type) || []).length;
+        },
+        async flushDispose(curtains) {
+            await new Promise((resolve) => setTimeout(resolve, 0));
+            curtains.render();
+        },
+    };
+}
+
+const harness = installBrowserHarness();
+const {Curtains} = await import("../src/index.mjs");
+
+function createCurtains(options = {}) {
+    const container = new FakeElement("div");
+    return new Curtains({
+        container,
+        autoRender: false,
+        autoResize: false,
+        production: true,
+        ...options,
+    });
+}
+
+async function disposeCurtains(curtains) {
+    curtains.dispose();
+    await harness.flushDispose(curtains);
+}
+
+test("manual scroll updates track values, deltas, planes, forced render, and callback", async () => {
+
+
+
+
+    window.pageXOffset = 10;
+    window.pageYOffset = 20;
+
+    const curtains = createCurtains({watchScroll: true});
+    let callbackCalls = 0;
+    const returned = curtains.onScroll(() => {
+        callbackCalls += 1;
+    });
+    const watchedPlane = {
+        watchScroll: true,
+        calls: [],
+        updateScrollPosition(x, y) {
+            this.calls.push([x, y]);
+        },
+    };
+    const ignoredPlane = {
+        watchScroll: false,
+        calls: [],
+        updateScrollPosition(x, y) {
+            this.calls.push([x, y]);
+        },
+    };
+    curtains.planes.push(watchedPlane, ignoredPlane);
+    curtains.disableDrawing();
+
+    assert.deepEqual(curtains.getScrollValues(), {x: 10, y: 20});
+    assert.deepEqual(curtains.getScrollDeltas(), {x: 0, y: 0});
+    assert.equal(returned, curtains);
+    assert.equal(callbackCalls, 0);
+    assert.equal(curtains.renderer.state.forceRender, false);
+
+    curtains.updateScrollValues(15, 5);
+
+    assert.deepEqual(curtains.getScrollValues(), {x: 15, y: 5});
+    assert.deepEqual(curtains.getScrollDeltas(), {x: -5, y: 15});
+    assert.deepEqual(watchedPlane.calls, [[-5, 15]]);
+    assert.deepEqual(ignoredPlane.calls, []);
+    assert.equal(curtains.renderer.state.forceRender, true);
+    assert.equal(callbackCalls, 1);
+
+    await disposeCurtains(curtains);
+});
+
+test("watchScroll false skips native scroll listener but still accepts manual updates", async () => {
+
+
+
+
+    window.pageXOffset = 10;
+    window.pageYOffset = 20;
+    const listenerBaseline = harness.listenerCount("scroll");
+
+    const curtains = createCurtains({watchScroll: false});
+    let callbackCalls = 0;
+    curtains.onScroll(() => {
+        callbackCalls += 1;
+    });
+
+    assert.equal(harness.listenerCount("scroll"), listenerBaseline);
+    assert.deepEqual(curtains.getScrollValues(), {x: 10, y: 20});
+    assert.deepEqual(curtains.getScrollDeltas(), {x: 0, y: 0});
+
+    curtains.updateScrollValues(17, 25);
+
+    assert.deepEqual(curtains.getScrollValues(), {x: 17, y: 25});
+    assert.deepEqual(curtains.getScrollDeltas(), {x: -7, y: -5});
+    assert.equal(callbackCalls, 1);
+
+    window.pageXOffset = 30;
+    window.pageYOffset = 40;
+    window.dispatchEvent({type: "scroll"});
+
+    assert.deepEqual(curtains.getScrollValues(), {x: 17, y: 25});
+    assert.deepEqual(curtains.getScrollDeltas(), {x: -7, y: -5});
+    assert.equal(callbackCalls, 1);
+
+    await disposeCurtains(curtains);
+});
+
+test("omitted watchScroll behaves like true and native scroll events use window offsets", async () => {
+
+
+
+
+    window.pageXOffset = 10;
+    window.pageYOffset = 20;
+    const listenerBaseline = harness.listenerCount("scroll");
+
+    const curtains = createCurtains();
+    let callbackCalls = 0;
+    curtains.onScroll(() => {
+        callbackCalls += 1;
+    });
+
+    assert.equal(harness.listenerCount("scroll"), listenerBaseline + 1);
+    assert.deepEqual(curtains.getScrollValues(), {x: 10, y: 20});
+    assert.deepEqual(curtains.getScrollDeltas(), {x: 0, y: 0});
+
+    window.pageXOffset = 30;
+    window.pageYOffset = 40;
+    window.dispatchEvent({type: "scroll"});
+
+    assert.deepEqual(curtains.getScrollValues(), {x: 30, y: 40});
+    assert.deepEqual(curtains.getScrollDeltas(), {x: -20, y: -20});
+    assert.equal(callbackCalls, 1);
+
+    await disposeCurtains(curtains);
+});
+
+test("resize refreshes watched scroll offsets from the window without changing deltas", async () => {
+
+
+
+
+    window.pageXOffset = 10;
+    window.pageYOffset = 20;
+
+    const curtains = createCurtains({watchScroll: true});
+    assert.deepEqual(curtains.getScrollValues(), {x: 10, y: 20});
+    assert.deepEqual(curtains.getScrollDeltas(), {x: 0, y: 0});
+
+    window.pageXOffset = 100;
+    window.pageYOffset = 200;
+    curtains.resize(false);
+
+    assert.deepEqual(curtains.getScrollValues(), {x: 100, y: 200});
+    assert.deepEqual(curtains.getScrollDeltas(), {x: 0, y: 0});
+
+    await disposeCurtains(curtains);
+});
+
+test("scroll state is independent across Curtains instances", async () => {
+
+
+
+
+    window.pageXOffset = 10;
+    window.pageYOffset = 20;
+
+    const a = createCurtains({watchScroll: false});
+    const b = createCurtains({watchScroll: false});
+
+    assert.deepEqual(a.getScrollValues(), {x: 10, y: 20});
+    assert.deepEqual(b.getScrollValues(), {x: 10, y: 20});
+
+    a.updateScrollValues(2, 3);
+
+    assert.deepEqual(a.getScrollValues(), {x: 2, y: 3});
+    assert.deepEqual(a.getScrollDeltas(), {x: 8, y: 17});
+    assert.deepEqual(b.getScrollValues(), {x: 10, y: 20});
+    assert.deepEqual(b.getScrollDeltas(), {x: 0, y: 0});
+
+    await disposeCurtains(a);
+    await disposeCurtains(b);
+});
+
+test("native scroll listener is removed during dispose and dispose is idempotent", async () => {
+
+
+
+
+    window.pageXOffset = 10;
+    window.pageYOffset = 20;
+    const listenerBaseline = harness.listenerCount("scroll");
+
+    const curtains = createCurtains({watchScroll: true});
+    let callbackCalls = 0;
+    curtains.onScroll(() => {
+        callbackCalls += 1;
+    });
+
+    assert.equal(harness.listenerCount("scroll"), listenerBaseline + 1);
+
+    await disposeCurtains(curtains);
+    assert.equal(harness.listenerCount("scroll"), listenerBaseline);
+
+    window.pageXOffset = 90;
+    window.pageYOffset = 100;
+    window.dispatchEvent({type: "scroll"});
+
+    assert.equal(callbackCalls, 0);
+
+    curtains.dispose();
+    assert.equal(harness.listenerCount("scroll"), listenerBaseline);
+});
+
+test("watchScroll option survives delayed container initialization", async () => {
+
+
+
+
+    window.pageXOffset = 10;
+    window.pageYOffset = 20;
+    const listenerBaseline = harness.listenerCount("scroll");
+
+    const curtains = new Curtains({watchScroll: false, autoRender: false, autoResize: false, production: true});
+
+    curtains.setContainer(new FakeElement("div"));
+
+
+    assert.equal(harness.listenerCount("scroll"), listenerBaseline);
+    curtains.updateScrollValues(1, 2);
+    assert.deepEqual(curtains.getScrollValues(), {x: 1, y: 2});
+    assert.deepEqual(curtains.getScrollDeltas(), {x: 9, y: 18});
+
+    await disposeCurtains(curtains);
+});
+
+test("repeated construct-use-dispose cycles do not leak scroll listeners", async () => {
+
+
+
+
+    window.pageXOffset = 10;
+    window.pageYOffset = 20;
+    const listenerBaseline = harness.listenerCount("scroll");
+
+    for(let i = 0; i < 100; i++) {
+        const curtains = createCurtains({watchScroll: true});
+        curtains.updateScrollValues(15, 5);
+        assert.deepEqual(curtains.getScrollValues(), {x: 15, y: 5});
+        assert.deepEqual(curtains.getScrollDeltas(), {x: -5, y: 15});
+        await disposeCurtains(curtains);
+    }
+
+    assert.equal(harness.listenerCount("scroll"), listenerBaseline);
+});
