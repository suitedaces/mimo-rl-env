diff --git a/test/codespec-locale-preferences.js b/test/codespec-locale-preferences.js
new file mode 100644
index 0000000..c53c957
--- /dev/null
+++ b/test/codespec-locale-preferences.js
@@ -0,0 +1,198 @@
+var assert = require("assert");
+
+function freshCore() {
+  delete require.cache[require.resolve("../index")];
+  return require("../index");
+}
+
+function freshNodeEntry() {
+  delete require.cache[require.resolve("../entry-node")];
+  delete require.cache[require.resolve("../index")];
+  return require("../entry-node");
+}
+
+function assertCountryMap(actual, expected) {
+  assert.deepStrictEqual(Object.keys(actual).sort(), Object.keys(expected).sort());
+  Object.keys(expected).forEach(function(code) {
+    assert.strictEqual(actual[code], expected[code]);
+  });
+}
+
+describe("codespec locale preference resolution", function() {
+  "use strict";
+  it("normalizes registered tags and replaces equivalent registrations", function() {
+    var countries = freshCore();
+
+    countries.registerLocale({
+      locale: "  QX_Latn_CA  ",
+      countries: { US: "First registration" }
+    });
+    countries.registerLocale({
+      locale: "qx-latn-ca",
+      countries: { US: "Replacement registration" }
+    });
+
+    assert.deepStrictEqual(countries.langs(), ["qx-latn-ca"]);
+    assert.strictEqual(
+      countries.getName("US", "QX_latn_CA"),
+      "Replacement registration"
+    );
+  });
+
+  it("inherits sparse locale layers and lets nearer layers override parents", function() {
+    var countries = freshCore();
+
+    countries.registerLocale({
+      locale: "qx",
+      countries: {
+        US: "Base US",
+        CA: "Base Canada",
+        MX: "Base Mexico"
+      }
+    });
+    countries.registerLocale({
+      locale: "qx-Latn",
+      countries: {
+        US: "Script US",
+        DE: "Script Germany"
+      }
+    });
+    countries.registerLocale({
+      locale: "qx-Latn-CA",
+      countries: {
+        CA: "Regional Canada",
+        GB: "Regional Britain"
+      }
+    });
+
+    assert.strictEqual(countries.getName("US", "QX_latn_ca"), "Script US");
+    assert.strictEqual(countries.getName("CA", "qx-Latn-CA"), "Regional Canada");
+    assert.strictEqual(countries.getName("MX", "qx-Latn-CA"), "Base Mexico");
+    assert.strictEqual(countries.getName("DE", "qx-Latn-CA"), "Script Germany");
+    assert.strictEqual(countries.getName("GB", "qx-Latn-CA"), "Regional Britain");
+  });
+
+  it("returns the effective merged country map for a locale hierarchy", function() {
+    var countries = freshCore();
+
+    countries.registerLocale({
+      locale: "qx",
+      countries: { US: "Base US", CA: "Base Canada", MX: "Base Mexico" }
+    });
+    countries.registerLocale({
+      locale: "qx-Latn",
+      countries: { US: "Script US", DE: "Script Germany" }
+    });
+    countries.registerLocale({
+      locale: "qx-Latn-CA",
+      countries: { CA: "Regional Canada", GB: "Regional Britain" }
+    });
+
+    assertCountryMap(countries.getNames("QX_latn_CA"), {
+      US: "Script US",
+      CA: "Regional Canada",
+      MX: "Base Mexico",
+      DE: "Script Germany",
+      GB: "Regional Britain"
+    });
+  });
+
+  it("uses ordered preferences and continues per country when an earlier locale lacks it", function() {
+    var countries = freshCore();
+    var preferences = [null, 17, " ", "missing_ZZ", "QY_region", "qz"];
+
+    countries.registerLocale({
+      locale: "qy",
+      countries: { US: "First preference US", MX: "Shared preference name" }
+    });
+    countries.registerLocale({
+      locale: "qz",
+      countries: {
+        US: "Second preference US",
+        CA: "Second preference Canada",
+        DE: "Shared preference name"
+      }
+    });
+
+    assert.strictEqual(countries.getName("US", preferences), "First preference US");
+    assert.strictEqual(countries.getName("CA", preferences), "Second preference Canada");
+    assertCountryMap(countries.getNames(preferences), {
+      US: "First preference US",
+      MX: "Shared preference name",
+      CA: "Second preference Canada",
+      DE: "Shared preference name"
+    });
+    assert.strictEqual(
+      countries.getAlpha2Code("Shared preference name", preferences),
+      "MX"
+    );
+    assert.strictEqual(
+      countries.getAlpha3Code("Shared preference name", preferences),
+      "MEX"
+    );
+  });
+
+  it("resolves exact reverse lookups over the effective hierarchy", function() {
+    var countries = freshCore();
+
+    countries.registerLocale({
+      locale: "qn",
+      countries: {
+        US: "Retired US Name",
+        MX: "Parent Mexico",
+        BR: "Cafe"
+      }
+    });
+    countries.registerLocale({
+      locale: "qn-Latn",
+      countries: {
+        US: "Current US Name",
+        CA: "Caf\u00e9"
+      }
+    });
+
+    assert.strictEqual(countries.getAlpha2Code("current us name", "QN_latn_xx"), "US");
+    assert.strictEqual(countries.getAlpha3Code("Parent Mexico", "qn-Latn-XX"), "MEX");
+    assert.strictEqual(countries.getAlpha2Code("Retired US Name", "qn-Latn-XX"), undefined);
+    assert.strictEqual(countries.getAlpha2Code("Cafe", "qn-Latn-XX"), "BR");
+  });
+
+  it("applies simple matching after hierarchy precedence is established", function() {
+    var countries = freshCore();
+
+    countries.registerLocale({
+      locale: "qn",
+      countries: { BR: "Cafe", MX: "M\u00e9xico" }
+    });
+    countries.registerLocale({
+      locale: "qn-Latn",
+      countries: { CA: "Caf\u00e9" }
+    });
+
+    assert.strictEqual(countries.getSimpleAlpha2Code("CAFE", "qn-Latn-XX"), "CA");
+    assert.strictEqual(countries.getSimpleAlpha3Code("cafe", "QN_latn_xx"), "CAN");
+    assert.strictEqual(countries.getSimpleAlpha2Code("mexico", "qn-Latn-XX"), "MX");
+  });
+
+  it("preserves missing-locale results for unusable preference lists", function() {
+    var countries = freshCore();
+    var unresolved = [null, false, " ", "not_registered"];
+
+    assert.strictEqual(countries.getName("US", unresolved), undefined);
+    assert.deepStrictEqual(Object.keys(countries.getNames(unresolved)), []);
+    assert.strictEqual(countries.getAlpha2Code("Anything", unresolved), undefined);
+    assert.strictEqual(countries.getSimpleAlpha3Code("Anything", unresolved), undefined);
+  });
+
+  it("applies regional fallback to bundled locales through the node entry point", function() {
+    var countries = freshNodeEntry();
+
+    assert.strictEqual(countries.getName("DE", "  EN_us  "), "Germany");
+    assert.strictEqual(countries.getAlpha2Code("Brasil", ["xx-ZZ", "PT_br"]), "BR");
+    assert.strictEqual(countries.getSimpleAlpha3Code("belgie", "NL_be"), "BEL");
+    assert.strictEqual(
+      countries.getNames("en-US").US,
+      countries.getNames("en").US
+    );
+  });
+});
