+)
+
+type probeK8s struct {
+	namespaceAnnotationErr error
+	namespaceLabelErr      error
+	deleteNamespaceErr     error
+	isNotFoundErr          bool
+	namespaces             map[string]struct{}
+}
+
+func (p *probeK8s) NamespaceAnnotation(namespace, annotation string) (string, error) {
+	if p.namespaceAnnotationErr != nil {
+		return "", p.namespaceAnnotationErr
+	}
+	return fmt.Sprintf(`{"name":%q,"team":"luizalabs","processType":"web","protocol":"http"}`, namespace), nil
+}
+
+func (p *probeK8s) NamespaceLabel(namespace, label string) (string, error) {
+	return "luizalabs", p.namespaceLabelErr
+}
+
+func (p *probeK8s) DeleteNamespace(namespace string) error {
+	delete(p.namespaces, namespace)
+	return p.deleteNamespaceErr
+}
+
+func (p *probeK8s) IsNotFound(error) bool      { return p.isNotFoundErr }
+func (p *probeK8s) IsAlreadyExists(error) bool { return false }
+func (p *probeK8s) IsInvalid(error) bool       { return false }
