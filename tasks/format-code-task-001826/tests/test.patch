+func (p *probeK8s) NamespaceListByLabel(string, string) ([]string, error) { return nil, nil }
+func (p *probeK8s) DeploySetReplicas(string, string, int32) error         { return nil }
+func (p *probeK8s) DeletePod(string, string) error                        { return nil }
