+package main
+
+import (
+	"context"
+	"flag"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"strings"
+	"sync"
+
+	appb "github.com/luizalabs/teresa/pkg/protobuf/app"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+)
+
+type appServer struct {
+	appb.AppServer
+
+	logPath string
+	mu      sync.Mutex
+}
+
+func (s *appServer) logDelete(ctx context.Context, name string) error {
+	token := ""
+	if md, ok := metadata.FromIncomingContext(ctx); ok {
+		if values := md.Get("token"); len(values) > 0 {
+			token = values[0]
+		}
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	f, err := os.OpenFile(s.logPath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0600)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	_, err = fmt.Fprintf(f, "DELETE name=%s token=%s\n", name, token)
+	return err
+}
+
+func (s *appServer) Delete(ctx context.Context, req *appb.DeleteRequest) (*appb.Empty, error) {
+	if err := s.logDelete(ctx, req.Name); err != nil {
+		return nil, status.Error(codes.Unknown, err.Error())
+	}
+
+	switch req.Name {
+	case "missing":
+		return nil, status.Error(codes.NotFound, "App not found")
+	case "denied":
+		return nil, status.Error(codes.PermissionDenied, "Permission Denied")
+	default:
+		return &appb.Empty{}, nil
+	}
+}
+
+func (s *appServer) Create(context.Context, *appb.CreateRequest) (*appb.Empty, error) {
+	return nil, status.Error(codes.Unimplemented, "Create not implemented")
+}
+
+func (s *appServer) Logs(*appb.LogsRequest, appb.App_LogsServer) error {
+	return status.Error(codes.Unimplemented, "Logs not implemented")
+}
+
+func (s *appServer) Info(context.Context, *appb.InfoRequest) (*appb.InfoResponse, error) {
+	return nil, status.Error(codes.Unimplemented, "Info not implemented")
+}
+
+func (s *appServer) SetEnv(context.Context, *appb.SetEnvRequest) (*appb.Empty, error) {
+	return nil, status.Error(codes.Unimplemented, "SetEnv not implemented")
+}
+
+func (s *appServer) UnsetEnv(context.Context, *appb.UnsetEnvRequest) (*appb.Empty, error) {
+	return nil, status.Error(codes.Unimplemented, "UnsetEnv not implemented")
+}
+
+func (s *appServer) List(context.Context, *appb.Empty) (*appb.ListResponse, error) {
+	return nil, status.Error(codes.Unimplemented, "List not implemented")
+}
+
+func (s *appServer) SetAutoscale(context.Context, *appb.SetAutoscaleRequest) (*appb.Empty, error) {
+	return nil, status.Error(codes.Unimplemented, "SetAutoscale not implemented")
+}
+
+func (s *appServer) SetReplicas(context.Context, *appb.SetReplicasRequest) (*appb.Empty, error) {
+	return nil, status.Error(codes.Unimplemented, "SetReplicas not implemented")
+}
+
+func (s *appServer) DeletePods(context.Context, *appb.DeletePodsRequest) (*appb.Empty, error) {
+	return nil, status.Error(codes.Unimplemented, "DeletePods not implemented")
+}
+
+func (s *appServer) SetSecret(context.Context, *appb.SetSecretRequest) (*appb.Empty, error) {
+	return nil, status.Error(codes.Unimplemented, "SetSecret not implemented")
+}
+
+func (s *appServer) UnsetSecret(context.Context, *appb.UnsetEnvRequest) (*appb.Empty, error) {
+	return nil, status.Error(codes.Unimplemented, "UnsetSecret not implemented")
+}
+
+func (s *appServer) ChangeTeam(context.Context, *appb.ChangeTeamRequest) (*appb.Empty, error) {
+	return nil, status.Error(codes.Unimplemented, "ChangeTeam not implemented")
+}
+
+func (s *appServer) SetVHosts(context.Context, *appb.SetVHostsRequest) (*appb.Empty, error) {
+	return nil, status.Error(codes.Unimplemented, "SetVHosts not implemented")
+}
+
+func main() {
+	logPath := flag.String("log", "", "path where Delete RPC calls are recorded")
+	flag.Parse()
+	if strings.TrimSpace(*logPath) == "" {
+		fmt.Fprintln(os.Stderr, "missing --log")
+		os.Exit(2)
+	}
+
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+
+	grpcServer := grpc.NewServer()
+	appb.RegisterAppServer(grpcServer, &appServer{logPath: *logPath})
+	fmt.Println(listener.Addr().String())
+	if err := grpcServer.Serve(listener); err != nil && err != grpc.ErrServerStopped && err != io.EOF {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
