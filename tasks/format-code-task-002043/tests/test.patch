diff --git a/src/tests/extensions/Mention.spec.js b/src/tests/extensions/Mention.spec.js
new file mode 100644
index 000000000..6227975b9
--- /dev/null
+++ b/src/tests/extensions/Mention.spec.js
@@ -0,0 +1,59 @@
+
+
+
+
+
+import {
+	markdownThroughEditor,
+	markdownThroughEditorHtml,
+} from '../helpers.js'
+
+describe('Mention markdown serialization', () => {
+	test('single mention from markdown has no extra surrounding spaces', () => {
+		expect(markdownThroughEditor('@[username](mention://user/id)'))
+			.toBe('@[username](mention://user/id)')
+	})
+
+	test('single mention from html has no extra surrounding spaces', () => {
+		expect(markdownThroughEditorHtml(
+			'<span class="mention" data-label="username" data-type="user" data-id="id">username</span>'
+		)).toBe('@[username](mention://user/id)')
+	})
+
+	test('mention with whitespace user id is correctly encoded with no extra spaces', () => {
+		expect(markdownThroughEditorHtml(
+			'<span class="mention" data-label="whitespace user" data-type="user" data-id="whitespace user">whitespace user</span>'
+		)).toBe('@[whitespace user](mention://user/whitespace%20user)')
+	})
+
+	test('two adjacent mentions separated by a single space stay single-spaced', () => {
+
+		expect(markdownThroughEditor(
+			'@[alice](mention://user/alice) @[bob](mention://user/bob)'
+		)).toBe('@[alice](mention://user/alice) @[bob](mention://user/bob)')
+	})
+
+	test('three mentions separated by single spaces preserve single spaces', () => {
+		expect(markdownThroughEditor(
+			'@[a](mention://user/a) @[b](mention://user/b) @[c](mention://user/c)'
+		)).toBe('@[a](mention://user/a) @[b](mention://user/b) @[c](mention://user/c)')
+	})
+
+	test('text before mention preserves a single space', () => {
+		expect(markdownThroughEditor(
+			'hello @[alice](mention://user/alice)'
+		)).toBe('hello @[alice](mention://user/alice)')
+	})
+
+	test('text after mention preserves a single space', () => {
+		expect(markdownThroughEditor(
+			'@[alice](mention://user/alice) world'
+		)).toBe('@[alice](mention://user/alice) world')
+	})
+
+	test('mention surrounded by text preserves spacing', () => {
+		expect(markdownThroughEditor(
+			'hello @[alice](mention://user/alice) world'
+		)).toBe('hello @[alice](mention://user/alice) world')
+	})
+})
