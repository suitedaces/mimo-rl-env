+  @patch( 'vim.command', new_callable=ExtendedMock )
+  @patch( 'vim.current', new_callable=ExtendedMock )
+  def test_WriteToPreviewWindow_WithModifiers( self, vim_current, vim_command ):
+
+
+
+    vim_current.window.options.__getitem__ = MagicMock( return_value = True )
+
+    vimsupport.WriteToPreviewWindow( "test", "rightbelow vertical" )
+
+    pedit_calls = [ c for c in vim_command.call_args_list
+                    if 'pedit!' in c.args[ 0 ] ]
+    assert_that( pedit_calls, contains_exactly(
+      call( 'silent! rightbelow vertical pedit! _TEMP_FILE_' ) ) )
+
+
+  @patch( 'vim.command', new_callable=ExtendedMock )
+  @patch( 'vim.current', new_callable=ExtendedMock )
+  def test_WriteToPreviewWindow_WithTopleft( self, vim_current, vim_command ):
+
+    vim_current.window.options.__getitem__ = MagicMock( return_value = True )
+
+    vimsupport.WriteToPreviewWindow( "test", "topleft" )
+
+    pedit_calls = [ c for c in vim_command.call_args_list
+                    if 'pedit!' in c.args[ 0 ] ]
+    assert_that( pedit_calls, contains_exactly(
+      call( 'silent! topleft pedit! _TEMP_FILE_' ) ) )
+
+
+  @patch( 'vim.command', new_callable=ExtendedMock )
+  def test_OpenFileInPreviewWindow_WithModifiers( self, vim_command ):
+
+
+    vimsupport.OpenFileInPreviewWindow( 'somefile', 'rightbelow vertical' )
+
+    pedit_calls = [ c for c in vim_command.call_args_list
+                    if 'pedit!' in c.args[ 0 ] ]
+    assert_that( len( pedit_calls ) == 1 )
+    cmd = pedit_calls[ 0 ].args[ 0 ]
+    assert_that( 'rightbelow vertical' in cmd, f'got: { cmd }' )
+    assert_that( 'somefile' in cmd, f'got: { cmd }' )
+
+    assert_that( cmd.index( 'rightbelow vertical' ) < cmd.index( 'pedit!' ) )
+
