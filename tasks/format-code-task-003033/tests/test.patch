+  def test_Detailed_Info_pedit_Has_Modifier( self ):
+
+
+
+
+    info = 'detailed info body'
+    with patch( 'vim.command' ) as vim_command:
+      with patch( 'vim.current' ) as vim_current:
+        vim_current.window.options.__getitem__ = MagicMock(
+            return_value = True )
+        request = CommandRequest( [ 'GetDoc' ] )
+        request._response = { 'detailed_info': info }
+        request.RunPostCommandActionsIfNeeded( 'rightbelow vertical' )
+
+    pedit_calls = [ c for c in vim_command.call_args_list
+                    if 'pedit!' in c.args[ 0 ] ]
+    assert_that( len( pedit_calls ) == 1,
