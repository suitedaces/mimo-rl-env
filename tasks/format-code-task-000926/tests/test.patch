             True
         )
+
+    def test_tabbed_with_nested_list_and_outro_paragraph(self):
+        """Sub-list inside a tab should not absorb following items as nested children.
+
+        The same parsing bug as the details block, but for tabbed: a parent
+        list item with intro paragraph, sub-list, and outro paragraph rendered
+        the sub-list's later items as nested children of the first when wrapped
+        in a tabbed block.
+        """
+
+        self.check_markdown(
+            '''
+            === "With tabs"
+                - Parent 1
+                    Intro 1
+
+                    - Child 1
+                    - Child 2
+                    - Child 3
+                    - Child 4
+
+                    Outro 1
+            ''',
+            '''
+            <div class="tabbed-set" data-tabs="1:1"><input checked="checked" id="__tabbed_1_1" name="__tabbed_1" type="radio" /><label for="__tabbed_1_1">With tabs</label><div class="tabbed-content">
+            <ul>
+            <li>
+            <p>Parent 1
+                Intro 1</p>
+            <ul>
+            <li>Child 1</li>
+            <li>Child 2</li>
+            <li>Child 3</li>
+            <li>Child 4</li>
+            </ul>
+            <p>Outro 1</p>
+            </li>
+            </ul>
+            </div>
+            </div>
+            ''',  # noqa: E501
+            True
+        )
