diff --git a/tests/test_extensions/test_details.py b/tests/test_extensions/test_details.py
index 6b24b19e..c70324d0 100644
--- a/tests/test_extensions/test_details.py
+++ b/tests/test_extensions/test_details.py
@@ -324,3 +324,43 @@ class TestDetails(util.MdCase):
             ''',
             True
         )
+
+    def test_details_with_nested_list_and_outro_paragraph(self):
+        """Sub-list inside details should not absorb following items as nested children.
+
+        Reproduces the issue: a parent list item containing an intro paragraph,
+        a sub-list, and an outro paragraph rendered the sub-list's later items
+        as children of the first item when wrapped in a details block.
+        """
+
+        self.check_markdown(
+            '''
+            ???+ "With details block"
+                - Parent 1
+                    Intro 1
+
+                    - Child 1
+                    - Child 2
+                    - Child 3
+                    - Child 4
+
+                    Outro 1
+            ''',
+            '''
+            <details open="open"><summary>With details block</summary><ul>
+            <li>
+            <p>Parent 1
+                Intro 1</p>
+            <ul>
+            <li>Child 1</li>
+            <li>Child 2</li>
+            <li>Child 3</li>
+            <li>Child 4</li>
+            </ul>
+            <p>Outro 1</p>
+            </li>
+            </ul>
+            </details>
+            ''',
+            True
+        )
