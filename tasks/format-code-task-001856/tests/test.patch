diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,48 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+node .yarn/releases/yarn-3.1.1.cjs install
+
+JEST_CMD=(
+  env
+  NODE_ENV=test
+  BABEL_ENV=cjs
+  NODE_ICU_DATA=./node_modules/full-icu
+  node
+  node_modules/.bin/jest
+)
+
+TARGET_FILES=(
+  packages/ra-core/src/form/useChoices.spec.tsx
+  packages/ra-ui-materialui/src/field/SelectField.spec.tsx
+  packages/ra-ui-materialui/src/input/AutocompleteArrayInput.spec.tsx
+  packages/ra-ui-materialui/src/input/AutocompleteInput.spec.tsx
+  packages/ra-ui-materialui/src/input/CheckboxGroupInput.spec.tsx
+  packages/ra-ui-materialui/src/input/RadioButtonGroupInput.spec.tsx
+  packages/ra-ui-materialui/src/input/SelectArrayInput.spec.tsx
+  packages/ra-ui-materialui/src/input/SelectInput.spec.tsx
+)
+
+case "${1:-}" in
+  base)
+    "${JEST_CMD[@]}" "${TARGET_FILES[@]}"
+    ;;
+  new)
+    "${JEST_CMD[@]}" \
+      packages/ra-core/src/form/useChoices.spec.tsx \
+      packages/ra-ui-materialui/src/field/SelectField.spec.tsx \
+      packages/ra-ui-materialui/src/input/AutocompleteArrayInput.spec.tsx \
+      packages/ra-ui-materialui/src/input/AutocompleteInput.spec.tsx \
+      packages/ra-ui-materialui/src/input/CheckboxGroupInput.spec.tsx \
+      packages/ra-ui-materialui/src/input/RadioButtonGroupInput.spec.tsx \
+      packages/ra-ui-materialui/src/input/SelectArrayInput.spec.tsx \
+      packages/ra-ui-materialui/src/input/SelectInput.spec.tsx \
+      --testNamePattern='should use optionText with an element value as text identifier|should allow customized rendering of suggesting item|should not inject the current choice as a record prop into an optionText element|should not pass the current suggestion as a record prop to an optionText element'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
