diff --git a/core/test/unit/server_helpers/excerpt_footnote_spec.js b/core/test/unit/server_helpers/excerpt_footnote_spec.js
new file mode 100644
index 0000000000..84c01d640a
--- /dev/null
+++ b/core/test/unit/server_helpers/excerpt_footnote_spec.js
@@ -0,0 +1,83 @@
+
+
+var should   = require('should'),
+    excerpt  = require('../../../server/helpers/excerpt');
+
+describe('{{excerpt}} Helper - footnotes stripping', function () {
+    it('strips inline footnote reference link from excerpt (issue example)', function () {
+
+        var html = '<p>Lorem ipsum dolor <sup id="fnref:1"><a href="#fn:1" rel="footnote">1</a></sup></p>',
+            rendered = excerpt.call({html: html});
+
+        should.exist(rendered);
+
+        rendered.string.should.not.match(/dolor\s*1\b/);
+        rendered.string.should.not.match(/1$/);
+        rendered.string.should.match(/^Lorem ipsum dolor/);
+    });
+
+    it('strips the footnotes definition block at the bottom of the post', function () {
+        var html = '<p>Hello world.</p>' +
+                '<div class="footnotes"><ol>' +
+                    '<li class="footnote" id="fn:1"><p>UNIQUE_FOOTNOTE_BODY_TEXT ' +
+                        '<a href="#fnref:1" title="return to article">&#8617;</a>' +
+                    '</p></li>' +
+                '</ol></div>',
+            rendered = excerpt.call({html: html});
+
+        should.exist(rendered);
+
+        rendered.string.should.match(/Hello world\./);
+
+        rendered.string.should.not.match(/UNIQUE_FOOTNOTE_BODY_TEXT/);
+    });
+
+    it('strips both inline references and bottom footnotes block together', function () {
+        var html = '<p>Lorem ipsum dolor <sup id="fnref:1"><a href="#fn:1" rel="footnote">1</a></sup> sit amet.</p>' +
+                '<div class="footnotes"><ol>' +
+                    '<li class="footnote" id="fn:1"><p>UNIQUE_FOOTNOTE_BODY_TEXT ' +
+                        '<a href="#fnref:1" title="return to article">&#8617;</a>' +
+                    '</p></li>' +
+                '</ol></div>',
+            rendered = excerpt.call({html: html});
+
+        should.exist(rendered);
+        rendered.string.should.match(/Lorem ipsum dolor/);
+        rendered.string.should.match(/sit amet\./);
+
+        rendered.string.should.not.match(/dolor\s*1\s*sit/);
+
+        rendered.string.should.not.match(/UNIQUE_FOOTNOTE_BODY_TEXT/);
+    });
+
+    it('strips multiple inline footnote references', function () {
+        var html = '<p>Foo<sup id="fnref:1"><a href="#fn:1" rel="footnote">1</a></sup> ' +
+                'bar<sup id="fnref:2"><a href="#fn:2" rel="footnote">2</a></sup>.</p>',
+            rendered = excerpt.call({html: html});
+
+        should.exist(rendered);
+
+        rendered.string.should.not.match(/Foo\s*1\b/);
+        rendered.string.should.not.match(/bar\s*2\b/);
+        rendered.string.should.match(/Foo/);
+        rendered.string.should.match(/bar/);
+    });
+
+    it('still renders plain text content unchanged (preservation)', function () {
+        var html = 'Hello World',
+            rendered = excerpt.call({html: html});
+
+        should.exist(rendered);
+        rendered.string.should.equal('Hello World');
+    });
+
+    it('still strips ordinary HTML tags (preservation)', function () {
+        var html = '<p>There are <br />10<br> types of people.</p>',
+            rendered = excerpt.call({html: html});
+
+        should.exist(rendered);
+        rendered.string.should.match(/There are 10 types of people\./);
+        rendered.string.should.not.match(/<br/);
+        rendered.string.should.not.match(/<\/?p>/);
+    });
+});
