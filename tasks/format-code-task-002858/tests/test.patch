diff --git a/tests/dialects/test_duckdb.py b/tests/dialects/test_duckdb.py
index 96d065929..d7114f65f 100644
--- a/tests/dialects/test_duckdb.py
+++ b/tests/dialects/test_duckdb.py
@@ -768,3 +768,46 @@ class TestDuckDB(Validator):
                 "duckdb": "ALTER TABLE db.t1 RENAME TO t2",
             },
         )
+
+    def test_order_by_explicit_asc_duckdb(self):
+
+
+        self.assertEqual(
+            parse_one(
+                "select i from range(5) _ (i) order by i asc", read="duckdb"
+            ).sql("duckdb"),
+            "SELECT i FROM RANGE(5) AS _(i) ORDER BY i ASC",
+        )
+
+    def test_order_by_unspecified_duckdb(self):
+
+        self.assertEqual(
+            parse_one(
+                "select i from range(5) _ (i) order by i", read="duckdb"
+            ).sql("duckdb"),
+            "SELECT i FROM RANGE(5) AS _(i) ORDER BY i",
+        )
+
+    def test_order_by_desc_duckdb(self):
+
+        self.assertEqual(
+            parse_one(
+                "select i from range(5) _ (i) order by i desc", read="duckdb"
+            ).sql("duckdb"),
+            "SELECT i FROM RANGE(5) AS _(i) ORDER BY i DESC",
+        )
+
+    def test_order_by_unspecified_default_dialect(self):
+
+        self.assertEqual(
+            parse_one("SELECT x FROM t ORDER BY x").sql(),
+            "SELECT x FROM t ORDER BY x",
+        )
+
+    def test_order_by_asc_nulls_last_duckdb(self):
+
+
+        self.assertEqual(
+            parse_one("SELECT x FROM t ORDER BY x ASC NULLS LAST").sql("duckdb"),
+            "SELECT x FROM t ORDER BY x ASC",
+        )
