+func TestGetImagesBlobForJpegSequenceReturnsValidFirstImageBlob(t *testing.T) {
+
+
+	initialize(t)
+
+	firstBg := imagick.NewPixelWand()
+	secondBg := imagick.NewPixelWand()
+	defer firstBg.Destroy()
+	defer secondBg.Destroy()
+	if got := firstBg.SetColor("yellow"); got != true {
+		t.Fatalf("first JPEG background SetColor = %v, want true", got)
+	}
+	if got := secondBg.SetColor("black"); got != true {
+		t.Fatalf("second JPEG background SetColor = %v, want true", got)
+	}
+
+	seq := imagick.NewMagickWand()
+	defer seq.Destroy()
+	requireNoError(t, "first JPEG NewImage", seq.NewImage(8, 4, firstBg))
+	requireNoError(t, "first JPEG SetImageFormat", seq.SetImageFormat("JPEG"))
+	requireNoError(t, "second JPEG NewImage", seq.NewImage(9, 5, secondBg))
+	requireNoError(t, "second JPEG SetImageFormat", seq.SetImageFormat("JPEG"))
+	seq.SetFirstIterator()
+
+	if got := seq.GetNumberImages(); got != 2 {
+		t.Fatalf("JPEG source image count = %d, want 2", got)
+	}
+	if got := seq.GetImageWidth(); got != 8 {
+		t.Fatalf("JPEG source first width = %d, want 8", got)
+	}
+	if got := seq.GetImageHeight(); got != 4 {
+		t.Fatalf("JPEG source first height = %d, want 4", got)
+	}
+	if got := seq.GetImageFormat(); got != "JPEG" {
+		t.Fatalf("JPEG source first format = %q, want %q", got, "JPEG")
+	}
+
+	jpegBlob, err := seq.GetImagesBlob()
+	requireNoError(t, "GetImagesBlob JPEG", err)
+
+	requireBlobPrefix(t, "JPEG fallback", jpegBlob, []byte("\xff\xd8\xff"))
+
+	decoded := imagick.NewMagickWand()
+	defer decoded.Destroy()
+	requireNoError(t, "ReadImageBlob JPEG fallback", decoded.ReadImageBlob(jpegBlob))
+	if got := decoded.GetNumberImages(); got != 1 {
+		t.Fatalf("decoded JPEG fallback image count = %d, want 1", got)
+	}
+	if got := decoded.GetImageWidth(); got != 8 {
+		t.Fatalf("decoded JPEG fallback width = %d, want 8", got)
+	}
+	if got := decoded.GetImageHeight(); got != 4 {
+		t.Fatalf("decoded JPEG fallback height = %d, want 4", got)
+	}
+	if got := decoded.GetImageFormat(); got != "JPEG" {
+		t.Fatalf("decoded JPEG fallback format = %q, want %q", got, "JPEG")
+	}
+}
