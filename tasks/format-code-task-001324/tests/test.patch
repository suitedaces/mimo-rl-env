+func TestEmptyBlobInputsReturnExactPublicErrorMessage(t *testing.T) {
+
+
+	initialize(t)
+
+	readWand := imagick.NewMagickWand()
+	defer readWand.Destroy()
+	readErr := readWand.ReadImageBlob([]byte{})
+	if readErr == nil {
+		t.Fatalf("ReadImageBlob empty error = nil, want message %q", "zero-length blob not permitted")
+	}
+	if got := readErr.Error(); got != "zero-length blob not permitted" {
+		t.Fatalf("ReadImageBlob empty error message = %q, want %q", got, "zero-length blob not permitted")
+	}
+	if got := readWand.GetNumberImages(); got != 0 {
+		t.Fatalf("read wand image count after empty blob = %d, want 0", got)
+	}
+
+	pingWand := imagick.NewMagickWand()
+	defer pingWand.Destroy()
+	pingErr := pingWand.PingImageBlob([]byte{})
+	if pingErr == nil {
+		t.Fatalf("PingImageBlob empty error = nil, want message %q", "zero-length blob not permitted")
+	}
+	if got := pingErr.Error(); got != "zero-length blob not permitted" {
+		t.Fatalf("PingImageBlob empty error message = %q, want %q", got, "zero-length blob not permitted")
+	}
+	if got := pingWand.GetNumberImages(); got != 0 {
+		t.Fatalf("ping wand image count after empty blob = %d, want 0", got)
+	}
+}
