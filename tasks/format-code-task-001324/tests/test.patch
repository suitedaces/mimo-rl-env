+func initialize(t *testing.T) {
+	t.Helper()
+	imagick.Initialize()
+	t.Cleanup(imagick.Terminate)
+}
+
+func requireNoError(t *testing.T, label string, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatalf("%s returned error: %T %v", label, err, err)
+	}
+}
+
+func requireBlobPrefix(t *testing.T, label string, blob []byte, prefix []byte) {
+	t.Helper()
+	if len(blob) <= len(prefix) {
+		t.Fatalf("%s blob length = %d, want more than signature length %d", label, len(blob), len(prefix))
+	}
+	if !bytes.HasPrefix(blob, prefix) {
+		t.Fatalf("%s blob signature = % x, want prefix % x", label, blob[:len(prefix)], prefix)
+	}
+}
+
+func newSolidWand(t *testing.T, width, height uint, color, format string) (*imagick.MagickWand, *imagick.PixelWand) {
+	t.Helper()
+	bg := imagick.NewPixelWand()
+	if got := bg.SetColor(color); got != true {
+		t.Fatalf("PixelWand.SetColor(%q) = %v, want true", color, got)
+	}
+	mw := imagick.NewMagickWand()
+	requireNoError(t, "NewImage", mw.NewImage(width, height, bg))
+	requireNoError(t, "SetImageFormat", mw.SetImageFormat(format))
+	return mw, bg
+}
