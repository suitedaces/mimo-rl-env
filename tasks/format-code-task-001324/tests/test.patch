+func TestBlobWorkflowConstructUseDestroyCyclesStayResourceBounded(t *testing.T) {
+
+
+	initialize(t)
+
+	for i := 0; i < 20; i++ {
+		runBlobLifecycleCycle(t)
+	}
+	runtime.GC()
+	time.Sleep(100 * time.Millisecond)
+	startRSS := vmRSSKB(t)
+	startFDs := countFDs(t)
+	startGoroutines := runtime.NumGoroutine()
+
+	for i := 0; i < 120; i++ {
+		runBlobLifecycleCycle(t)
+		if i%20 == 0 {
+			runtime.GC()
+		}
+	}
+	runtime.GC()
+	time.Sleep(200 * time.Millisecond)
+	endRSS := vmRSSKB(t)
+	endFDs := countFDs(t)
+	endGoroutines := runtime.NumGoroutine()
+
+	if got := int64(endRSS) - int64(startRSS); got > 12288 {
+		t.Fatalf("VmRSS growth after 120 blob lifecycle cycles = %d KiB, want <= 12288 KiB", got)
+	}
+	if got := endFDs - startFDs; got > 2 {
+		t.Fatalf("FD count growth after 120 blob lifecycle cycles = %d, want <= 2", got)
+	}
+	if got := endGoroutines - startGoroutines; got > 2 {
+		t.Fatalf("goroutine count growth after 120 blob lifecycle cycles = %d, want <= 2", got)
+	}
+}
+
+func runBlobLifecycleCycle(t *testing.T) {
+	t.Helper()
+	bg := imagick.NewPixelWand()
+	defer bg.Destroy()
+	if got := bg.SetColor("white"); got != true {
+		t.Fatalf("cycle background SetColor = %v, want true", got)
+	}
+	mw := imagick.NewMagickWand()
+	defer mw.Destroy()
+	requireNoError(t, "cycle NewImage", mw.NewImage(128, 128, bg))
+	requireNoError(t, "cycle SetImageFormat", mw.SetImageFormat("PNG"))
+	blob, err := mw.GetImageBlob()
+	requireNoError(t, "cycle GetImageBlob", err)
+
+	requireBlobPrefix(t, "cycle PNG", blob, []byte("\x89PNG\r\n\x1a\n"))
+}
+
+func vmRSSKB(t *testing.T) uint64 {
+	t.Helper()
+	f, err := os.Open("/proc/self/status")
+	requireNoError(t, "open /proc/self/status", err)
+	defer f.Close()
+
+	scanner := bufio.NewScanner(f)
+	for scanner.Scan() {
+		line := scanner.Text()
+		if !strings.HasPrefix(line, "VmRSS:") {
+			continue
+		}
+		fields := strings.Fields(line)
+		if len(fields) != 3 {
+			t.Fatalf("VmRSS fields = %v, want [VmRSS: <number> kB]", fields)
+		}
+		if fields[2] != "kB" {
+			t.Fatalf("VmRSS unit = %q, want %q", fields[2], "kB")
+		}
+		value, err := strconv.ParseUint(fields[1], 10, 64)
+		requireNoError(t, "parse VmRSS", err)
+		return value
+	}
+	requireNoError(t, "scan /proc/self/status", scanner.Err())
+	t.Fatal("VmRSS entry missing from /proc/self/status")
+	return 0
+}
+
+func countFDs(t *testing.T) int {
+	t.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	requireNoError(t, "read /proc/self/fd", err)
+	return len(entries)
+}
