+func TestDestroyIsIdempotentForBlobWorkflowWand(t *testing.T) {
+
+
+	initialize(t)
+
+	mw, bg := newSolidWand(t, 3, 2, "#336699", "PNG")
+	defer bg.Destroy()
+	if got := mw.IsVerified(); got != true {
+		t.Fatalf("wand verified before Destroy = %v, want true", got)
+	}
+	blob, err := mw.GetImageBlob()
+	requireNoError(t, "GetImageBlob before Destroy", err)
+
+	requireBlobPrefix(t, "blob before Destroy", blob, []byte("\x89PNG\r\n\x1a\n"))
+
+	mw.Destroy()
+	if got := mw.IsVerified(); got != false {
+		t.Fatalf("wand verified after first Destroy = %v, want false", got)
+	}
+	mw.Destroy()
+	if got := mw.IsVerified(); got != false {
+		t.Fatalf("wand verified after second Destroy = %v, want false", got)
+	}
+}
