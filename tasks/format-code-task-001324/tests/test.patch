+func TestBlobRoundTripBetweenIndependentWands(t *testing.T) {
+
+
+	initialize(t)
+
+	src, srcBg := newSolidWand(t, 3, 2, "#336699", "PNG")
+	defer src.Destroy()
+	defer srcBg.Destroy()
+
+	if got := src.GetNumberImages(); got != 1 {
+		t.Fatalf("source image count = %d, want 1", got)
+	}
+	if got := src.GetImageWidth(); got != 3 {
+		t.Fatalf("source width = %d, want 3", got)
+	}
+	if got := src.GetImageHeight(); got != 2 {
+		t.Fatalf("source height = %d, want 2", got)
+	}
+	if got := src.GetImageFormat(); got != "PNG" {
+		t.Fatalf("source format = %q, want %q", got, "PNG")
+	}
+
+	blob, err := src.GetImageBlob()
+	requireNoError(t, "GetImageBlob", err)
+
+	requireBlobPrefix(t, "PNG", blob, []byte("\x89PNG\r\n\x1a\n"))
+
+	dst := imagick.NewMagickWand()
+	defer dst.Destroy()
+	if got := dst.GetNumberImages(); got != 0 {
+		t.Fatalf("fresh destination image count = %d, want 0", got)
+	}
+	if got := dst.GetImageWidth(); got != 0 {
+		t.Fatalf("fresh destination width = %d, want 0", got)
+	}
+	if got := dst.GetImageHeight(); got != 0 {
+		t.Fatalf("fresh destination height = %d, want 0", got)
+	}
+	if got := dst.GetImageFormat(); got != "" {
+		t.Fatalf("fresh destination format = %q, want empty string", got)
+	}
+
+	requireNoError(t, "ReadImageBlob", dst.ReadImageBlob(blob))
+	if got := dst.GetNumberImages(); got != 1 {
+		t.Fatalf("decoded destination image count = %d, want 1", got)
+	}
+	if got := dst.GetImageWidth(); got != 3 {
+		t.Fatalf("decoded destination width = %d, want 3", got)
+	}
+	if got := dst.GetImageHeight(); got != 2 {
+		t.Fatalf("decoded destination height = %d, want 2", got)
+	}
+	if got := dst.GetImageFormat(); got != "PNG" {
+		t.Fatalf("decoded destination format = %q, want %q", got, "PNG")
+	}
+}
