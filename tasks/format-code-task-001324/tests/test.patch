+func TestGetImagesBlobPreservesGifSequenceState(t *testing.T) {
+
+
+	initialize(t)
+
+	firstBg := imagick.NewPixelWand()
+	secondBg := imagick.NewPixelWand()
+	defer firstBg.Destroy()
+	defer secondBg.Destroy()
+	if got := firstBg.SetColor("red"); got != true {
+		t.Fatalf("first background SetColor = %v, want true", got)
+	}
+	if got := secondBg.SetColor("blue"); got != true {
+		t.Fatalf("second background SetColor = %v, want true", got)
+	}
+
+	seq := imagick.NewMagickWand()
+	defer seq.Destroy()
+	requireNoError(t, "first NewImage", seq.NewImage(4, 3, firstBg))
+	requireNoError(t, "first SetImageFormat", seq.SetImageFormat("GIF"))
+	requireNoError(t, "first SetImageDelay", seq.SetImageDelay(7))
+	requireNoError(t, "second NewImage", seq.NewImage(5, 6, secondBg))
+	requireNoError(t, "second SetImageFormat", seq.SetImageFormat("GIF"))
+	requireNoError(t, "second SetImageDelay", seq.SetImageDelay(11))
+
+	if got := seq.GetNumberImages(); got != 2 {
+		t.Fatalf("sequence image count before encode = %d, want 2", got)
+	}
+	if got := seq.GetImageWidth(); got != 5 {
+		t.Fatalf("current sequence width before encode = %d, want 5", got)
+	}
+	if got := seq.GetImageHeight(); got != 6 {
+		t.Fatalf("current sequence height before encode = %d, want 6", got)
+	}
+	if got := seq.GetImageFormat(); got != "GIF" {
+		t.Fatalf("current sequence format before encode = %q, want %q", got, "GIF")
+	}
+	if got := seq.GetImageDelay(); got != 11 {
+		t.Fatalf("current sequence delay before encode = %d, want 11", got)
+	}
+	if got := seq.GetIteratorIndex(); got != 1 {
+		t.Fatalf("current sequence iterator index before encode = %d, want 1", got)
+	}
+
+	seq.SetFirstIterator()
+	if got := seq.GetImageWidth(); got != 4 {
+		t.Fatalf("first sequence width before encode = %d, want 4", got)
+	}
+	if got := seq.GetImageHeight(); got != 3 {
+		t.Fatalf("first sequence height before encode = %d, want 3", got)
+	}
+	if got := seq.GetImageDelay(); got != 7 {
+		t.Fatalf("first sequence delay before encode = %d, want 7", got)
+	}
+	if got := seq.GetIteratorIndex(); got != 0 {
+		t.Fatalf("first sequence iterator index before encode = %d, want 0", got)
+	}
+
+	gifBlob, err := seq.GetImagesBlob()
+	requireNoError(t, "GetImagesBlob", err)
+
+	if len(gifBlob) <= 6 {
+		t.Fatalf("GIF sequence blob length = %d, want more than signature length 6", len(gifBlob))
+	}
+	if got := string(gifBlob[:3]); got != "GIF" {
+		t.Fatalf("GIF sequence signature = %q, want %q", got, "GIF")
+	}
+
+	decoded := imagick.NewMagickWand()
+	defer decoded.Destroy()
+	requireNoError(t, "ReadImageBlob GIF sequence", decoded.ReadImageBlob(gifBlob))
+	if got := decoded.GetNumberImages(); got != 2 {
+		t.Fatalf("decoded GIF image count at initial iterator = %d, want 2", got)
+	}
+	if got := decoded.GetImageFormat(); got != "GIF" {
+		t.Fatalf("decoded GIF current format at initial iterator = %q, want %q", got, "GIF")
+	}
+
+
+	decoded.SetFirstIterator()
+	if got := decoded.GetImageWidth(); got != 4 {
+		t.Fatalf("decoded GIF first width = %d, want 4", got)
+	}
+	if got := decoded.GetImageHeight(); got != 3 {
+		t.Fatalf("decoded GIF first height = %d, want 3", got)
+	}
+
+	if got := decoded.NextImage(); got != true {
+		t.Fatalf("decoded GIF NextImage = %v, want true", got)
+	}
+	if got := decoded.GetImageWidth(); got != 5 {
+		t.Fatalf("decoded GIF second width = %d, want 5", got)
+	}
+	if got := decoded.GetImageHeight(); got != 6 {
+		t.Fatalf("decoded GIF second height = %d, want 6", got)
+	}
+
+}
