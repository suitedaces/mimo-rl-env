diff --git a/tests/unit/test_download.py b/tests/unit/test_download.py
index d63d74201..974f47655 100644
--- a/tests/unit/test_download.py
+++ b/tests/unit/test_download.py
@@ -665,3 +665,137 @@ def test_keyring_get_credential(monkeypatch, url, expect):
     assert auth._get_new_credentials(url, allow_netrc=False,
                                      allow_keyring=True) \
         == expect
+
+
+def test_get_credentials_uses_token_only_url():
+    """
+    Regression test for issue #6795: URLs containing a single-element
+    auth component (e.g. an access token without ":password") should
+    be recognised as credentials.
+    """
+    auth = MultiDomainBasicAuth()
+    url, username, password = auth._get_url_and_credentials(
+        "http://sometoken@example.com/path"
+    )
+    assert url == "http://example.com/path"
+
+    assert username == "sometoken"
+
+
+
+    assert password in (None, "")
+
+
+def test_get_credentials_caches_token_only_url():
+    """
+    Token-only credentials parsed out of the URL must be stored in the
+    netloc password cache so future requests to the same netloc reuse
+    them.
+    """
+    auth = MultiDomainBasicAuth()
+    auth._get_url_and_credentials("http://sometoken@example.com/path")
+    assert "example.com" in auth.passwords
+    cached = auth.passwords["example.com"]
+    assert cached[0] == "sometoken"
+
+
+    assert cached[1] in (None, "")
+
+
+def test_get_credentials_empty_user_with_password():
+    """
+    URLs of the form ":password@host" (the documented workaround for
+    the bug) must continue to be parsed correctly.
+    """
+    auth = MultiDomainBasicAuth()
+    url, username, password = auth._get_url_and_credentials(
+        "http://:sometoken@example.com/path"
+    )
+    assert url == "http://example.com/path"
+    assert username == ""
+    assert password == "sometoken"
+
+
+def test_get_credentials_standard_user_pass_preserved():
+    """
+    The normal user:password@host form must remain unchanged.
+    """
+    auth = MultiDomainBasicAuth()
+    url, username, password = auth._get_url_and_credentials(
+        "http://foo:bar@example.com/path"
+    )
+    assert url == "http://example.com/path"
+    assert username == "foo"
+    assert password == "bar"
+    assert auth.passwords["example.com"] == ("foo", "bar")
+
+
+def test_get_credentials_no_auth_url_unchanged():
+    """
+    URLs without auth must not be cached and must return (None, None).
+    """
+    auth = MultiDomainBasicAuth()
+    url, username, password = auth._get_url_and_credentials(
+        "http://example.com/path"
+    )
+    assert url == "http://example.com/path"
+    assert username is None
+    assert password is None
+
+    assert "example.com" not in auth.passwords
+
+
+def test_get_credentials_token_url_repeated_call_uses_cache(monkeypatch):
+    """
+    After the first call populates the netloc cache with a token-only
+    credential, a second call for the same netloc must NOT invoke
+    _get_new_credentials again (which would mean the cache hit branch
+    is broken when the cached password is the empty string).
+    """
+    auth = MultiDomainBasicAuth()
+
+    auth._get_url_and_credentials("http://sometoken@example.com/path")
+
+    call_count = {"n": 0}
+    real_get_new = auth._get_new_credentials
+
+    def counting_get_new(*args, **kwargs):
+        call_count["n"] += 1
+        return real_get_new(*args, **kwargs)
+
+    monkeypatch.setattr(auth, "_get_new_credentials", counting_get_new)
+
+    url, username, password = auth._get_url_and_credentials(
+        "http://example.com/other-path"
+    )
+    assert call_count["n"] == 0
+    assert username == "sometoken"
+    assert password in (None, "")
+
+
+def test_call_sends_basic_auth_for_token_only_url():
+    """
+    End-to-end: when MultiDomainBasicAuth is invoked as an auth handler
+    on a request whose URL contains a single-element token, the resulting
+    Authorization header must be a Basic auth header that encodes
+    "token:" (i.e. an empty password) -- NOT "token:None" or a missing
+    header.
+    """
+    import base64
+
+    auth = MultiDomainBasicAuth()
+    req = MockRequest("http://sometoken@example.com/path")
+    auth(req)
+
+
+    assert req.url == "http://example.com/path"
+
+    assert "Authorization" in req.headers, (
+        "Authorization header missing -- token-only URL was not "
+        "recognised as credentials"
+    )
+    scheme, _, encoded = req.headers["Authorization"].partition(" ")
+    assert scheme == "Basic"
+    decoded = base64.b64decode(encoded).decode("latin1")
+
+    assert decoded == "sometoken:"
