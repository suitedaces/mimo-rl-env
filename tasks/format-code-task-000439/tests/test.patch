+#!/bin/bash
+set -euo pipefail
+
+
+CODESPEC_GOMODCACHE="$(mktemp -d)"
+trap 'rm -rf -- "${CODESPEC_GOMODCACHE}"' EXIT
+GOMODCACHE="${CODESPEC_GOMODCACHE}" GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off \
+  go test ./codespec -count=1
