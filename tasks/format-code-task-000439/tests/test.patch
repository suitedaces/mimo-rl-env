diff --git a/codespec/runtime_selectors_test.go b/codespec/runtime_selectors_test.go
new file mode 100644
index 0000000..e47bf24
--- /dev/null
+++ b/codespec/runtime_selectors_test.go
@@ -0,0 +1,222 @@
+package runtimecontract_test
+
+import (
+	"strings"
+	"testing"
+
+	aquaruntime "github.com/aquaproj/aqua/v2/pkg/runtime"
+)
+
+func envs(runtimes []*aquaruntime.Runtime) []string {
+	got := make([]string, len(runtimes))
+	for i, rt := range runtimes {
+		if rt == nil {
+			got[i] = "<nil>"
+			continue
+		}
+		got[i] = rt.Env()
+	}
+	return got
+}
+
+func assertEnvs(t *testing.T, got []*aquaruntime.Runtime, want ...string) {
+	t.Helper()
+	actual := envs(got)
+	if len(actual) != len(want) {
+		t.Fatalf("runtime count: got %v, want %v", actual, want)
+	}
+	for i := range want {
+		if actual[i] != want[i] {
+			t.Fatalf("runtime order: got %v, want %v", actual, want)
+		}
+	}
+}
+
+func TestCodespecGetRuntimesSelectorGrammar(t *testing.T) {
+	tests := []struct {
+		selector string
+		want     []string
+	}{
+		{selector: "all", want: []string{"darwin/amd64", "darwin/arm64", "linux/amd64", "linux/arm64", "windows/amd64", "windows/arm64"}},
+		{selector: "linux", want: []string{"linux/amd64", "linux/arm64"}},
+		{selector: "amd64", want: []string{"darwin/amd64", "windows/amd64", "linux/amd64"}},
+		{selector: "linux/arm64", want: []string{"linux/arm64"}},
+		{selector: " \tlinux/arm64\n", want: []string{"linux/arm64"}},
+	}
+	for _, tc := range tests {
+		got, err := aquaruntime.GetRuntimes(tc.selector)
+		if err != nil {
+			t.Errorf("GetRuntimes(%q) returned an error: %v", tc.selector, err)
+			continue
+		}
+		assertEnvs(t, got, tc.want...)
+	}
+}
+
+func TestCodespecGetRuntimesRejectsInvalidSelectors(t *testing.T) {
+	invalid := []string{
+		"",
+		"plan9",
+		"plan9/amd64",
+		"linux/mips",
+		"linux/amd64/extra",
+		"linux /amd64",
+		"!linux",
+	}
+	for _, selector := range invalid {
+		got, err := aquaruntime.GetRuntimes(selector)
+		if err == nil {
+			t.Errorf("GetRuntimes(%q) succeeded with %v; want an error", selector, envs(got))
+			continue
+		}
+		if got != nil {
+			t.Errorf("GetRuntimes(%q) returned partial runtimes %v", selector, envs(got))
+		}
+		trimmed := strings.TrimSpace(selector)
+		if trimmed != "" && !strings.Contains(err.Error(), trimmed) {
+			t.Errorf("GetRuntimes(%q) error %q does not identify the selector", selector, err)
+		}
+	}
+}
+
+func TestCodespecListDistinguishesNilAndEmpty(t *testing.T) {
+	got, err := aquaruntime.GetRuntimesFromEnvs(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertEnvs(t, got, "darwin/amd64", "darwin/arm64", "linux/amd64", "linux/arm64", "windows/amd64", "windows/arm64")
+
+	got, err = aquaruntime.GetRuntimesFromEnvs([]string{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertEnvs(t, got)
+}
+
+func TestCodespecPositiveSelectorsPreserveFirstSeenOrder(t *testing.T) {
+	got, err := aquaruntime.GetRuntimesFromEnvs([]string{
+		"linux/arm64",
+		"darwin",
+		"arm64",
+		"linux",
+		"darwin/amd64",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertEnvs(t, got,
+		"linux/arm64",
+		"darwin/amd64",
+		"darwin/arm64",
+		"windows/arm64",
+		"linux/amd64",
+	)
+}
+
+func TestCodespecExclusionsAreOrderIndependent(t *testing.T) {
+	tests := []struct {
+		selectors []string
+		want      []string
+	}{
+		{
+			selectors: []string{"!windows", "all", "!amd64"},
+			want:      []string{"darwin/arm64", "linux/arm64"},
+		},
+		{
+			selectors: []string{"all", "!linux", "linux/arm64"},
+			want:      []string{"darwin/amd64", "darwin/arm64", "windows/amd64", "windows/arm64"},
+		},
+	}
+	for _, tc := range tests {
+		got, err := aquaruntime.GetRuntimesFromEnvs(tc.selectors)
+		if err != nil {
+			t.Errorf("GetRuntimesFromEnvs(%v): %v", tc.selectors, err)
+			continue
+		}
+		assertEnvs(t, got, tc.want...)
+	}
+}
+
+func TestCodespecNegativeOnlyListsStartFromAll(t *testing.T) {
+	got, err := aquaruntime.GetRuntimesFromEnvs([]string{"!arm64"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertEnvs(t, got, "darwin/amd64", "linux/amd64", "windows/amd64")
+
+	got, err = aquaruntime.GetRuntimesFromEnvs([]string{"!all"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertEnvs(t, got)
+}
+
+func TestCodespecListSelectorsTrimWhitespace(t *testing.T) {
+	got, err := aquaruntime.GetRuntimesFromEnvs([]string{" linux ", " \t!linux/arm64\n"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertEnvs(t, got, "linux/amd64")
+}
+
+func TestCodespecInvalidListIsAtomic(t *testing.T) {
+	invalidLists := [][]string{
+		{"linux", "plan9", "windows"},
+		{"linux", "   ", "windows"},
+		{"linux", "!", "windows"},
+		{"linux", "!!arm64", "windows"},
+		{"linux", "! linux", "windows"},
+		{"linux", "!windows/mips", "darwin"},
+	}
+	for _, selectors := range invalidLists {
+		got, err := aquaruntime.GetRuntimesFromEnvs(selectors)
+		if err == nil {
+			t.Errorf("GetRuntimesFromEnvs(%v) succeeded with %v; want an error", selectors, envs(got))
+			continue
+		}
+		if got != nil {
+			t.Errorf("GetRuntimesFromEnvs(%v) leaked partial result %v", selectors, envs(got))
+		}
+		bad := strings.TrimSpace(selectors[1])
+		if bad != "" && !strings.Contains(err.Error(), bad) {
+			t.Errorf("GetRuntimesFromEnvs(%v) error %q does not identify %q", selectors, err, bad)
+		}
+	}
+}
+
+func TestCodespecResultsAreFresh(t *testing.T) {
+	first, err := aquaruntime.GetRuntimesFromEnvs(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	first[0].GOOS = "changed"
+	first[1] = nil
+
+	second, err := aquaruntime.GetRuntimesFromEnvs(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertEnvs(t, second, "darwin/amd64", "darwin/arm64", "linux/amd64", "linux/arm64", "windows/amd64", "windows/arm64")
+
+	direct, err := aquaruntime.GetRuntimes("linux")
+	if err != nil {
+		t.Fatal(err)
+	}
+	direct[0].GOARCH = "changed"
+	directAgain, err := aquaruntime.GetRuntimes("linux")
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertEnvs(t, directAgain, "linux/amd64", "linux/arm64")
+
+	selected, err := aquaruntime.GetRuntimesFromEnvs([]string{"darwin"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	selected[0].GOOS = "changed"
+	selectedAgain, err := aquaruntime.GetRuntimesFromEnvs([]string{"darwin"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertEnvs(t, selectedAgain, "darwin/amd64", "darwin/arm64")
+}
