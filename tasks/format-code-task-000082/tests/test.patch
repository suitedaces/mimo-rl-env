+package sei_test
+
+import (
+	"bytes"
+	"encoding/hex"
+	"strings"
+	"testing"
+
+	"github.com/edgeware/mp4ff/sei"
+)
+
+
+
+
+
+const seiHEVCHDR = "891800000300000300000300000300000300000300000300000300000300000300000300009004000003000080"
+
+
+
+const sei0Hex = "0007810f1c0050744080"
+
+func TestExtractSEIDataSingleMessage(t *testing.T) {
+	raw, err := hex.DecodeString(sei0Hex)
+	if err != nil {
+		t.Fatal(err)
+	}
+	datas, err := sei.ExtractSEIData(bytes.NewReader(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(datas) != 1 {
+		t.Fatalf("got %d messages, want 1", len(datas))
+	}
+	if datas[0].Type() != 0 {
+		t.Errorf("got type %d, want 0", datas[0].Type())
+	}
+	if datas[0].Size() != 7 {
+		t.Errorf("got size %d, want 7", datas[0].Size())
+	}
+	wantPayload, _ := hex.DecodeString("810f1c00507440")
+	if !bytes.Equal(datas[0].Payload(), wantPayload) {
+		t.Errorf("got payload %x, want %x", datas[0].Payload(), wantPayload)
+	}
+}
+
+func TestExtractSEIDataMultiMessageWithEmulation(t *testing.T) {
+	raw, err := hex.DecodeString(seiHEVCHDR)
+	if err != nil {
+		t.Fatal(err)
+	}
+	datas, err := sei.ExtractSEIData(bytes.NewReader(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(datas) != 2 {
+		t.Fatalf("got %d messages, want 2", len(datas))
+	}
+	wantTypes := []uint{137, 144}
+	wantSizes := []uint{24, 4}
+	for i := range datas {
+		if datas[i].Type() != wantTypes[i] {
+			t.Errorf("message %d: got type %d, want %d", i, datas[i].Type(), wantTypes[i])
+		}
+		if datas[i].Size() != wantSizes[i] {
+			t.Errorf("message %d: got size %d, want %d", i, datas[i].Size(), wantSizes[i])
+		}
+
+		if uint(len(datas[i].Payload())) != wantSizes[i] {
+			t.Errorf("message %d: payload len %d, want %d", i, len(datas[i].Payload()), wantSizes[i])
+		}
+	}
+
+
+	for i := range datas {
+		msg, err := sei.DecodeSEIMessage(&datas[i], sei.HEVC)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if msg.Type() != wantTypes[i] {
+			t.Errorf("decoded message %d: got type %d, want %d", i, msg.Type(), wantTypes[i])
+		}
+		if !bytes.Equal(msg.Payload(), datas[i].Payload()) {
+			t.Errorf("decoded message %d: payload not round-tripped", i)
+		}
+	}
+}
+
+func TestMasteringDisplayColourVolumeFields(t *testing.T) {
+	hex137 := "11223344556677889900aabbccddeeff0011223344556677"
+	pl, err := hex.DecodeString(hex137)
+	if err != nil {
+		t.Fatal(err)
+	}
+	msg, err := sei.DecodeSEIMessage(sei.NewSEIData(sei.SEIMasteringDisplayColourVolumeType, pl), sei.HEVC)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if msg.Type() != sei.SEIMasteringDisplayColourVolumeType {
+		t.Errorf("got type %d, want %d", msg.Type(), sei.SEIMasteringDisplayColourVolumeType)
+	}
+	if msg.Size() != 24 {
+		t.Errorf("got size %d, want 24", msg.Size())
+	}
+	m, ok := msg.(*sei.MasteringDisplayColourVolumeSEI)
+	if !ok {
+		t.Fatalf("decoded message is not *MasteringDisplayColourVolumeSEI, got %T", msg)
+	}
+	if m.DisplayPrimariesX != [3]uint16{0x1122, 0x5566, 0x9900} {
+		t.Errorf("DisplayPrimariesX = %v", m.DisplayPrimariesX)
+	}
+	if m.DisplayPrimariesY != [3]uint16{0x3344, 0x7788, 0xaabb} {
+		t.Errorf("DisplayPrimariesY = %v", m.DisplayPrimariesY)
+	}
+	if m.WhitePointX != 0xccdd || m.WhitePointY != 0xeeff {
+		t.Errorf("white point = (%#x, %#x)", m.WhitePointX, m.WhitePointY)
+	}
+	if m.MaxDisplayMasteringLuminance != 0x00112233 {
+		t.Errorf("MaxDisplayMasteringLuminance = %#x", m.MaxDisplayMasteringLuminance)
+	}
+	if m.MinDisplayMasteringLuminance != 0x44556677 {
+		t.Errorf("MinDisplayMasteringLuminance = %#x", m.MinDisplayMasteringLuminance)
+	}
+	if !bytes.Equal(msg.Payload(), pl) {
+		t.Errorf("payload round-trip mismatch: got %x, want %x", msg.Payload(), pl)
+	}
+}
+
+func TestMasteringDisplayColourVolumeEncode(t *testing.T) {
+	m := &sei.MasteringDisplayColourVolumeSEI{
+		DisplayPrimariesX:            [3]uint16{1, 2, 3},
+		DisplayPrimariesY:            [3]uint16{4, 5, 6},
+		WhitePointX:                  7,
+		WhitePointY:                  8,
+		MaxDisplayMasteringLuminance: 9,
+		MinDisplayMasteringLuminance: 10,
+	}
+	pl := m.Payload()
+	if len(pl) != 24 {
+		t.Fatalf("payload length %d, want 24", len(pl))
+	}
+	msg, err := sei.DecodeSEIMessage(sei.NewSEIData(sei.SEIMasteringDisplayColourVolumeType, pl), sei.HEVC)
+	if err != nil {
+		t.Fatal(err)
+	}
+	d, ok := msg.(*sei.MasteringDisplayColourVolumeSEI)
+	if !ok {
+		t.Fatalf("decoded message is not *MasteringDisplayColourVolumeSEI, got %T", msg)
+	}
+	if *d != *m {
+		t.Errorf("round-trip mismatch: got %+v, want %+v", *d, *m)
+	}
+}
+
+func TestMasteringDisplayColourVolumeSizeError(t *testing.T) {
+	for _, n := range []int{0, 23, 25} {
+		_, err := sei.DecodeSEIMessage(sei.NewSEIData(sei.SEIMasteringDisplayColourVolumeType, make([]byte, n)), sei.HEVC)
+		if err == nil {
+			t.Errorf("payload length %d: expected an error, got nil", n)
+		}
+	}
+}
+
+func TestContentLightLevelFields(t *testing.T) {
+	hex144 := "11223344"
+	pl, err := hex.DecodeString(hex144)
+	if err != nil {
+		t.Fatal(err)
+	}
+	msg, err := sei.DecodeSEIMessage(sei.NewSEIData(sei.SEIContentLightLevelInformationType, pl), sei.HEVC)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if msg.Type() != sei.SEIContentLightLevelInformationType {
+		t.Errorf("got type %d, want %d", msg.Type(), sei.SEIContentLightLevelInformationType)
+	}
+	if msg.Size() != 4 {
+		t.Errorf("got size %d, want 4", msg.Size())
+	}
+	c, ok := msg.(*sei.ContentLightLevelInformationSEI)
+	if !ok {
+		t.Fatalf("decoded message is not *ContentLightLevelInformationSEI, got %T", msg)
+	}
+	if c.MaxContentLightLevel != 0x1122 {
+		t.Errorf("MaxContentLightLevel = %#x", c.MaxContentLightLevel)
+	}
+	if c.MaxPicAverageLightLevel != 0x3344 {
+		t.Errorf("MaxPicAverageLightLevel = %#x", c.MaxPicAverageLightLevel)
+	}
+	if !bytes.Equal(msg.Payload(), pl) {
+		t.Errorf("payload round-trip mismatch: got %x, want %x", msg.Payload(), pl)
+	}
+}
+
+func TestContentLightLevelSizeError(t *testing.T) {
+	for _, n := range []int{0, 3, 5} {
+		_, err := sei.DecodeSEIMessage(sei.NewSEIData(sei.SEIContentLightLevelInformationType, make([]byte, n)), sei.HEVC)
+		if err == nil {
+			t.Errorf("payload length %d: expected an error, got nil", n)
+		}
+	}
+}
+
+func TestGenericFallback(t *testing.T) {
+	pl, _ := hex.DecodeString("deadbeef")
+	for _, codec := range []sei.Codec{sei.AVC, sei.HEVC} {
+		msg, err := sei.DecodeSEIMessage(sei.NewSEIData(99, pl), codec)
+		if err != nil {
+			t.Fatalf("unexpected error for unknown type: %v", err)
+		}
+		if msg.Type() != 99 {
+			t.Errorf("got type %d, want 99", msg.Type())
+		}
+		if msg.Size() != 4 {
+			t.Errorf("got size %d, want 4", msg.Size())
+		}
+		if !bytes.Equal(msg.Payload(), pl) {
+			t.Errorf("payload mismatch: got %x, want %x", msg.Payload(), pl)
+		}
+	}
+}
+
+func TestSEITypeString(t *testing.T) {
+	cases := []struct {
+		id   uint
+		want string
+	}{
+		{sei.SEIPicTimingType, "SEIPicTimingType (1)"},
+		{sei.SEIMasteringDisplayColourVolumeType, "SEIMasteringDisplayColourVolumeType (137)"},
+		{sei.SEIContentLightLevelInformationType, "SEIContentLightLevelInformationType (144)"},
+	}
+	for _, tc := range cases {
+		got := sei.SEIType(tc.id).String()
+		if got != tc.want {
+			t.Errorf("SEIType(%d).String() = %q, want %q", tc.id, got, tc.want)
+		}
+	}
+
+	got := sei.SEIType(200).String()
+	if !strings.HasSuffix(got, "(200)") {
+		t.Errorf("SEIType(200).String() = %q, want suffix %q", got, "(200)")
+	}
+}
