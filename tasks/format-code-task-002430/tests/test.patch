diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,39 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+PYTHON_BIN="${PYTHON_BIN:-python3.11}"
+if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
+  PYTHON_BIN=python3
+fi
+
+if [ ! -x .venv/bin/python ]; then
+  "$PYTHON_BIN" -m venv .venv
+fi
+
+if [ ! -f .venv/.stage3a_pytest6_deps_installed ]; then
+  .venv/bin/python -m pip install -q -U pip setuptools wheel
+  .venv/bin/python -m pip install -q \
+    "pytest>=6.2.0,<7.0.0" "pytest-xdist>=1.34.0,<2.0.0" "pytest-forked>=1.3.0,<2.0.0" \
+    typing_extensions mypy_extensions tomli attrs psutil py
+  touch .venv/.stage3a_pytest6_deps_installed
+fi
+
+
+set +u
+source .venv/bin/activate
+set -u
+
+
+case "${1:-}" in
+  base)
+    python -m pytest mypy/test/testcheck.py -n0 -v -k "testTypeVarAsValue"
+    ;;
+  new)
+    python -m pytest mypy/test/testcheck.py -n0 -v -k "testStringInterpolationIterableNoTooFew or testStringInterpolationSequenceNoTooFew or testStringInterpolationCustomIterableNoTooFew or testStringInterpolationIterableStringNoTooFew or testStringInterpolationIterableFiveNoTooFew or testStringInterpolationKnownArityStillTooFew"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
