diff --git a/test/test.js b/test/test.js
index af060c2..17a5e90 100644
--- a/test/test.js
+++ b/test/test.js
@@ -445,4 +445,126 @@ describe('generateRuntimeCaching', function() {
     }]);
     assert.equal(code, '\ntoolbox.router.get(/test/, toolbox.testHandler, {});');
   });
+
+
+
+  function evalRuntimeCaching(code) {
+    var calls = [];
+    var routerMethod = function(pattern, handler, options) {
+      calls.push({pattern: pattern, handler: handler, options: options});
+    };
+    var toolbox = {
+      router: {
+        get: routerMethod,
+        post: routerMethod,
+        put: routerMethod,
+        delete: routerMethod,
+        head: routerMethod,
+        any: routerMethod
+      },
+
+
+      networkFirst: 'networkFirstHandler',
+      fastest: 'fastestHandler',
+      testHandler: 'testHandlerValue'
+    };
+    /* eslint-disable no-new-func */
+    var fn = new Function('toolbox', code);
+    /* eslint-enable no-new-func */
+    fn(toolbox);
+    return calls;
+  }
+
+  it('should serialize a RegExp origin option as a regex literal, not an empty object', function() {
+    var code = generateRuntimeCaching([{
+      urlPattern: /\/articles\//,
+      handler: 'fastest',
+      options: {origin: /twitter\.com/}
+    }]);
+
+    assert.equal(code.indexOf('"origin":{}'), -1,
+      'origin must NOT be serialized as empty object');
+    assert.equal(code.indexOf('"origin": {}'), -1,
+      'origin must NOT be serialized as empty object (with space)');
+
+    assert(code.indexOf('/twitter\\.com/') !== -1,
+      'expected regex literal /twitter\\.com/ in output, got: ' + code);
+  });
+
+  it('should produce code that evaluates a RegExp origin to a RegExp instance', function() {
+    var code = generateRuntimeCaching([{
+      urlPattern: /\/articles\//,
+      handler: 'fastest',
+      options: {origin: /twitter\.com/}
+    }]);
+    var calls = evalRuntimeCaching(code);
+    assert.equal(calls.length, 1);
+    assert(calls[0].options.origin instanceof RegExp,
+      'options.origin should be a RegExp, got: ' +
+      Object.prototype.toString.call(calls[0].options.origin));
+    assert.strictEqual(calls[0].options.origin.source, 'twitter\\.com');
+    assert(calls[0].options.origin.test('https://twitter.com/foo'),
+      'regex should match twitter.com URLs');
+  });
+
+  it('should handle the exact runtimeCaching example from the issue', function() {
+    var code = generateRuntimeCaching([{
+      urlPattern: /^https:\/\/example\.com\/api/,
+      handler: 'networkFirst'
+    }, {
+      urlPattern: /\/articles\//,
+      handler: 'fastest',
+      options: {origin: /twitter\.com/}
+    }]);
+    var calls = evalRuntimeCaching(code);
+    assert.equal(calls.length, 2);
+
+
+    assert(calls[0].pattern instanceof RegExp);
+    assert.strictEqual(calls[0].pattern.source, '^https:\\/\\/example\\.com\\/api');
+    assert.deepEqual(calls[0].options, {});
+
+
+    assert(calls[1].pattern instanceof RegExp);
+    assert.strictEqual(calls[1].pattern.source, '\\/articles\\/');
+    assert(calls[1].options.origin instanceof RegExp,
+      'second route options.origin must be a RegExp');
+    assert.strictEqual(calls[1].options.origin.source, 'twitter\\.com');
+  });
+
+  it('should keep a string origin as a string', function() {
+    var code = generateRuntimeCaching([{
+      urlPattern: /test/,
+      handler: 'testHandler',
+      options: {origin: 'https://example.com'}
+    }]);
+    var calls = evalRuntimeCaching(code);
+    assert.equal(calls.length, 1);
+    assert.strictEqual(typeof calls[0].options.origin, 'string');
+    assert.strictEqual(calls[0].options.origin, 'https://example.com');
+  });
+
+  it('should preserve non-RegExp options alongside other fields', function() {
+    var code = generateRuntimeCaching([{
+      urlPattern: /test/,
+      handler: 'testHandler',
+      options: {networkTimeoutSeconds: 5}
+    }]);
+    var calls = evalRuntimeCaching(code);
+    assert.equal(calls.length, 1);
+    assert.strictEqual(calls[0].options.networkTimeoutSeconds, 5);
+  });
+
+  it('should produce syntactically valid JavaScript when origin is a RegExp', function() {
+    var code = generateRuntimeCaching([{
+      urlPattern: /\/articles\//,
+      handler: 'fastest',
+      options: {origin: /twitter\.com/}
+    }]);
+    assert.doesNotThrow(function() {
+      /* eslint-disable no-new, no-new-func */
+      new Function(code);
+      /* eslint-enable no-new, no-new-func */
+    }, 'generated code must be parseable as JavaScript');
+  });
 });
