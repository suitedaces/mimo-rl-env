+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+
+for bin in rimraf rollup cpy vitest tsc; do
+  if [ ! -x "/workspace/repo/node_modules/.bin/${bin}" ]; then
+    echo "Missing local npm binary: ${bin}" >&2
+    exit 1
+  fi
+done
+
+/workspace/repo/node_modules/.bin/rimraf dist
+/workspace/repo/node_modules/.bin/rollup -c --silent
+printf '{"type":"module"}\n' > /workspace/repo/dist/esm/package.json
+/workspace/repo/node_modules/.bin/cpy "./dist/umd/*.js" ./
+rm -f /workspace/repo/i18next.js /workspace/repo/i18next.min.js
+/workspace/repo/node_modules/.bin/vitest run /workspace/repo/usercase-test-coderl/context-lookup.test.ts --config /workspace/repo/usercase-test-coderl/vitest.usercase.config.mts
+/workspace/repo/node_modules/.bin/tsc --ignoreConfig --noEmit --strict --module ESNext --moduleResolution Bundler --target ES2022 --types vitest --skipLibCheck /workspace/repo/usercase-test-coderl/context-options.test.ts
