+++ b/usercase-test-coderl/context-lookup.test.ts
@@ -0,0 +1,227 @@
+import { describe, expect, expectTypeOf, it } from 'vitest';
+import { createInstance } from 'i18next';
+import type { InitOptions, TOptions, TypeOptions } from 'i18next';
+
+
+
+
+
+
+
+
+
+
+
+const baseResources = {
+  en: {
+    translation: {
+      friend: 'friend',
+      friend_male: 'boyfriend',
+      friend_female: 'girlfriend',
+      step: 'step',
+      step_1: 'first step',
+      item: 'item',
+      item_male_one: 'his item',
+      item_male_other: 'his items',
+      empty_marker: 'base empty marker',
+      empty_marker_: 'empty suffix marker',
+      null_marker: 'base null marker',
+      null_marker_null: 'null suffix marker',
+      missing_marker: 'base missing marker',
+      formal: 'base formal',
+      'formal|formal': 'colleague',
+    },
+  },
+} as const;
+
+async function initializedInstance(options: InitOptions = {}) {
+  const instance = createInstance();
+  await instance.init({
+    lng: 'en',
+    fallbackLng: false,
+    initAsync: false,
+    resources: baseResources,
+    ...options,
+  });
+  return instance;
+}
+
+describe('public i18next context lookup session', () => {
+  it('keeps context-specific string and numeric lookups in initialized instance state', async () => {
+
+
+    const instance = await initializedInstance();
+
+
+    expect(instance.t('friend')).toBe('friend');
+    expect(instance.t('friend', { context: 'male' })).toBe('boyfriend');
+    expect(instance.t('friend', { context: 'female' })).toBe('girlfriend');
+    expect(instance.t('step', { context: 1 })).toBe('first step');
+
+    instance.off();
+  });
+
+  it('uses the init-time contextSeparator for context key construction', async () => {
+
+
+    const instance = await initializedInstance({ contextSeparator: '|' });
+
+
+    expect(instance.t('formal')).toBe('base formal');
+    expect(instance.t('formal', { context: 'formal' })).toBe('colleague');
+    expect(instance.t('friend', { context: 'male' })).toBe('friend');
+
+    instance.off();
+  });
+
+  it('combines context lookup with plural lookup', async () => {
+
+
+    const instance = await initializedInstance();
+
+    expect(instance.t('item', { context: 'male', count: 1 })).toBe('his item');
+    expect(instance.t('item', { context: 'male', count: 2 })).toBe('his items');
+
+    instance.off();
+  });
+
+  it('reports the exact suffixed key when returnDetails is requested', async () => {
+
+
+    const instance = await initializedInstance();
+
+
+    expect(instance.t('friend', { context: 'male', returnDetails: true })).toMatchObject({
+      res: 'boyfriend',
+      exactUsedKey: 'friend_male',
+    });
+
+    instance.off();
+  });
+
+  it('does not use context suffix lookup for empty, null, or missing context options', async () => {
+
+
+    const instance = await initializedInstance();
+
+    expect(instance.t('empty_marker', { context: '' })).toBe('base empty marker');
+    expect(instance.t('null_marker', { context: null })).toBe('base null marker');
+    expect(instance.t('missing_marker', {})).toBe('base missing marker');
+
+    instance.off();
+  });
+
+  it('uses the resources supplied at initialization for context-specific lookup', async () => {
+
+
+    const instance = createInstance();
+
+    await instance.init({
+      lng: 'en',
+      fallbackLng: false,
+      initAsync: false,
+      resources: {
+        en: {
+          translation: {
+            friend: 'pal',
+            friend_male: 'guy pal',
+          },
+        },
+      },
+    });
+
+
+    expect(instance.t('friend')).toBe('pal');
+    expect(instance.t('friend', { context: 'male' })).toBe('guy pal');
+
+    instance.off();
+  });
+
+  it('keeps context lookup state independent across initialized instances', async () => {
+
+
+    const first = createInstance();
+    const second = createInstance();
+
+    await first.init({
+      lng: 'en',
+      fallbackLng: false,
+      initAsync: false,
+      resources: {
+        en: { translation: { friend: 'first friend', friend_male: 'first boyfriend' } },
+      },
+    });
+    await second.init({
+      lng: 'en',
+      fallbackLng: false,
+      initAsync: false,
+      resources: {
+        en: { translation: { friend: 'second friend', friend_male: 'second boyfriend' } },
+      },
+    });
+
+    expect(first.t('friend', { context: 'male' })).toBe('first boyfriend');
+    expect(second.t('friend', { context: 'male' })).toBe('second boyfriend');
+
+
+    expect(first.t('friend')).toBe('first friend');
+    expect(second.t('friend')).toBe('second friend');
+    expect(second.t('friend', { context: 'male' })).toBe('second boyfriend');
+
+    first.off();
+    second.off();
+  });
+
+  it('falls back to the base key when the requested context variant is absent', async () => {
+
+
+    const instance = await initializedInstance();
+
+
+    expect(instance.t('friend', { context: 'unknown' })).toBe('friend');
+    expect(instance.t('missing_marker', { context: 'male' })).toBe('base missing marker');
+
+    instance.off();
+  });
+
+  it('supports repeated construct/init/use cycles for context lookup', async () => {
+
+
+    const seen = new Set<string>();
+
+    for (let i = 0; i < 20; i += 1) {
+      const instance = await initializedInstance();
+      seen.add(instance.t('friend', { context: 'male' }));
+      seen.add(instance.t('friend', { context: 'female' }));
+      instance.off();
+    }
+
+
+    expect(seen).toEqual(new Set(['boyfriend', 'girlfriend']));
+  });
+
+  it('exposes context and contextSeparator through the public TypeScript option types', () => {
+
+
+    const initOptions = { contextSeparator: '|' } satisfies InitOptions;
+    const stringContext = { context: 'male' } satisfies TOptions<{}>;
+    const numericContext = { context: 1 } satisfies TOptions<{}>;
+
+
+    expectTypeOf<TypeOptions['contextSeparator']>().toMatchTypeOf<string>();
+    expect(initOptions.contextSeparator).toBe('|');
+    expect(stringContext.context).toBe('male');
+    expect(numericContext.context).toBe(1);
+  });
+
+  it('creates context-capable instances through the public createInstance export', async () => {
+
+
+    const instance = await initializedInstance();
+
+
+    expect(instance.t('friend', { context: 'male' })).toBe('boyfriend');
+
+    instance.off();
+  });
+});
