diff --git a/packages/ses/test/tame-global-reg-exp-object.test.js b/packages/ses/test/tame-global-reg-exp-object.test.js
index e0417f2a2..c7bf213e8 100644
--- a/packages/ses/test/tame-global-reg-exp-object.test.js
+++ b/packages/ses/test/tame-global-reg-exp-object.test.js
@@ -31,3 +31,92 @@ test('tameGlobalRegExpObject - constructor', t => {
 
   restore();
 });
+
+test('tameGlobalRegExpObject - RegExp without new with string pattern', t => {
+  t.plan(4);
+
+  const restore = captureGlobals('RegExp');
+  tameGlobalRegExpObject();
+
+
+  let r;
+  t.doesNotThrow(() => {
+    r = RegExp('foo');
+  });
+
+  t.equal(r.source, 'foo');
+  t.equal(r.test('foo'), true);
+  t.equal(r.test('bar'), false);
+
+  restore();
+});
+
+test('tameGlobalRegExpObject - RegExp without new applies flags', t => {
+  t.plan(3);
+
+  const restore = captureGlobals('RegExp');
+  tameGlobalRegExpObject();
+
+  const r = RegExp('a', 'g');
+  t.equal(r.source, 'a');
+  t.equal(r.flags, 'g');
+  t.equal(r.global, true);
+
+  restore();
+});
+
+test('tameGlobalRegExpObject - RegExp(existingRegExp) returns same instance', t => {
+  t.plan(2);
+
+  const restore = captureGlobals('RegExp');
+  tameGlobalRegExpObject();
+
+
+
+  const orig = /abc/i;
+  const result = RegExp(orig);
+  t.equal(result, orig);
+  t.equal(result.source, 'abc');
+
+  restore();
+});
+
+test('tameGlobalRegExpObject - new RegExp still works after taming', t => {
+  t.plan(4);
+
+  const restore = captureGlobals('RegExp');
+  tameGlobalRegExpObject();
+
+  const r = new RegExp('xyz', 'i');
+  t.ok(r instanceof RegExp);
+  t.equal(r.source, 'xyz');
+  t.equal(r.flags, 'i');
+  t.equal(r.test('XYZ'), true);
+
+  restore();
+});
+
+test('tameGlobalRegExpObject - yaml timestamp regex from issue', t => {
+  t.plan(2);
+
+  const restore = captureGlobals('RegExp');
+  tameGlobalRegExpObject();
+
+
+  let r;
+  t.doesNotThrow(() => {
+    r = RegExp(
+      '^(?:' +
+        '([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})' +
+        '(?:(?:t|T|[ \\t]+)' +
+        '([0-9]{1,2}):([0-9]{1,2}):([0-9]{1,2}(\\.[0-9]+)?)' +
+        '(?:[ \\t]*(Z|[-+][012]?[0-9](?::[0-9]{2})?))?' +
+        ')?' +
+        ')$',
+    );
+  });
+
+  t.equal(r.test('2020-01-15'), true);
+
+  restore();
+});
