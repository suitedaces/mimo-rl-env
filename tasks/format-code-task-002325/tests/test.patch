+"use strict";
+
+const prettier = require("prettier/local");
+
+
+
+
+
+
+
+const issueInput = `concat([
+  node.firstChild.type === "text" &&
+  node.firstChild.isWhiteSpaceSensitive &&
+  node.firstChild.isIndentationSensitive
+    ? literalline
+    : node.firstChild.hasLeadingSpaces &&
+      node.firstChild.isLeadingSpaceSensitive
+    ? line
+    : softline,
+  printChildren(path, options, print)
+]);
+`;
+
+test("issue 5269: LogicalExpression in nested ConditionalExpression.test is aligned (idempotent)", () => {
+  const output = prettier.format(issueInput, { parser: "babylon" });
+  expect(output).toBe(issueInput);
+});
+
+test("issue 5269: alternate LogicalExpression test second line is aligned with 6-space indent", () => {
+  const output = prettier.format(issueInput, { parser: "babylon" });
+
+
+
+  expect(output).toContain(
+    "    : node.firstChild.hasLeadingSpaces &&\n" +
+      "      node.firstChild.isLeadingSpaceSensitive\n"
+  );
+
+  expect(output).not.toContain(
+    "    : node.firstChild.hasLeadingSpaces &&\n" +
+      "    node.firstChild.isLeadingSpaceSensitive\n"
+  );
+});
+
+test("issue 5269: chained ternary with LogicalExpression test in deeper alternate is aligned", () => {
+  const input = `const message = condition
+  ? "yes"
+  : longCondition1 &&
+    longCondition2 &&
+    longCondition3 &&
+    longCondition4 &&
+    longCondition5 &&
+    longCondition6
+  ? "maybe"
+  : "no";
+`;
+  const output = prettier.format(input, { parser: "babylon" });
+  expect(output).toBe(input);
+});
+
+test("issue 5269: works with useTabs - alignment uses spaces after tabs", () => {
+  const output = prettier.format(issueInput, {
+    parser: "babylon",
+    useTabs: true
+  });
+
+
+
+  expect(output).toContain(
+    "\t\t: node.firstChild.hasLeadingSpaces &&\n" +
+      "\t\t  node.firstChild.isLeadingSpaceSensitive\n"
+  );
+
+  expect(output).not.toContain(
+    "\t\t: node.firstChild.hasLeadingSpaces &&\n" +
+      "\t\t\tnode.firstChild.isLeadingSpaceSensitive\n"
+  );
+});
+
+test("preservation: non-nested ConditionalExpression with LogicalExpression test is unaffected", () => {
+
+
+
+  const input = `const x =
+  aaaaaaaaaaaaaaaaaaaaaaaa &&
+  bbbbbbbbbbbbbbbbbbbbbbb &&
+  cccccccccccccccccccccccccc &&
+  dddddddddddddddddddddddddddd
+    ? 1
+    : 2;
+`;
+  const output = prettier.format(input, { parser: "babylon" });
+  expect(output).toBe(input);
+});
+
+test("preservation: simple non-nested ternary with short LogicalExpression test is unchanged", () => {
+  const input = `const x = aaaaaaaaaaaaaa && bbbbbbbbbbbbbb && ccccccccccccccc ? 1 : 2;
+`;
+  const output = prettier.format(input, { parser: "babylon" });
+  expect(output).toBe(input);
+});
+
+test("issue 5269: deep alternate chain - LogicalExpression continuation aligned (not extra-indented)", () => {
+  const input = `const x = a
+  ? b
+  : c
+  ? someLongCondition1aaaaaaaaaaaaa &&
+    someLongCondition2bbbbbbbbbbbbbbbbbb &&
+    someLongCondition3cccccccccccccccccc
+    ? d
+    : e
+  : f;
+`;
+  const output = prettier.format(input, { parser: "babylon" });
+  expect(output).toBe(input);
+});
