diff --git a/provider/aws/aws_test.go b/provider/aws/aws_test.go
index c87de29f..6dd2a5bc 100644
--- a/provider/aws/aws_test.go
+++ b/provider/aws/aws_test.go
@@ -1388,3 +1388,43 @@ func addZoneTags(tagMap map[string][]*route53.Tag, zoneID string, tags map[strin
 func validateRecords(t *testing.T, records []*route53.ResourceRecordSet, expected []*route53.ResourceRecordSet) {
 	assert.ElementsMatch(t, expected, records)
 }
+
+func TestAWSCanonicalHostedZoneApSoutheast3ALB(t *testing.T) {
+
+
+
+	zone := canonicalHostedZone("foo.ap-southeast-3.elb.amazonaws.com")
+	assert.Equal(t, "Z08888821HLRG5A9ZRTER", zone)
+}
+
+func TestAWSCanonicalHostedZoneApSoutheast3NLB(t *testing.T) {
+
+
+
+	zone := canonicalHostedZone("foo.elb.ap-southeast-3.amazonaws.com")
+	assert.Equal(t, "Z01971771FYVNCOVWJU1G", zone)
+}
+
+func TestAWSCanonicalHostedZoneApSoutheast3NonEmpty(t *testing.T) {
+
+
+
+
+	assert.NotEmpty(t, canonicalHostedZone("foo.ap-southeast-3.elb.amazonaws.com"))
+	assert.NotEmpty(t, canonicalHostedZone("foo.elb.ap-southeast-3.amazonaws.com"))
+}
+
+func TestAWSCanonicalHostedZonePreservesExisting(t *testing.T) {
+
+
+	assert.Equal(t, "Z1LMS91P8CMLE5", canonicalHostedZone("foo.ap-southeast-1.elb.amazonaws.com"))
+	assert.Equal(t, "Z1GM3OXH4ZPM65", canonicalHostedZone("foo.ap-southeast-2.elb.amazonaws.com"))
+	assert.Equal(t, "ZKVM4W9LS7TM", canonicalHostedZone("foo.elb.ap-southeast-1.amazonaws.com"))
+	assert.Equal(t, "ZCT6FZBF4DROD", canonicalHostedZone("foo.elb.ap-southeast-2.amazonaws.com"))
+}
+
+func TestAWSCanonicalHostedZoneUnknownHost(t *testing.T) {
+
+
+	assert.Equal(t, "", canonicalHostedZone("foo.example.org"))
+}
