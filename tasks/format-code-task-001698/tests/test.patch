diff --git a/src/dialogs/passage-edit/__tests__/passage-toolbar.test.tsx b/src/dialogs/passage-edit/__tests__/passage-toolbar.test.tsx
index 8c6d880d..d08d9441 100644
--- a/src/dialogs/passage-edit/__tests__/passage-toolbar.test.tsx
+++ b/src/dialogs/passage-edit/__tests__/passage-toolbar.test.tsx
@@ -138,4 +138,34 @@ describe('<PassageToolbar>', () => {
 
 		expect(await axe(container)).toHaveNoViolations();
 	});
+
+	describe('swap test from here', () => {
+		it('swap-test-from-here removes the Set as Start checkbox from the toolbar', async () => {
+			const story = fakeStory(2);
+			story.startPassage = story.passages[1].id;
+			await renderComponent({stories: [story]});
+			expect(
+				screen.queryByText('dialogs.passageEdit.setAsStart')
+			).not.toBeInTheDocument();
+		});
+
+		it('swap-test-from-here shows a Test From Here button in the toolbar', async () => {
+			const story = fakeStory(2);
+			await renderComponent({stories: [story]});
+			expect(screen.getByText(/testFromHere/i)).toBeInTheDocument();
+		});
+
+		it('swap-test-from-here opens the test URL with the passage id when the button is clicked', async () => {
+			const openSpy = jest.spyOn(window, 'open').mockReturnValue(null);
+			const story = fakeStory(2);
+			await renderComponent({stories: [story]});
+			expect(openSpy).not.toHaveBeenCalled();
+			fireEvent.click(screen.getByText(/testFromHere/i));
+			expect(openSpy).toHaveBeenCalledWith(
+				`#/stories/${story.id}/test/${story.passages[0].id}`,
+				'_blank'
+			);
+			openSpy.mockRestore();
+		});
+	});
 });
