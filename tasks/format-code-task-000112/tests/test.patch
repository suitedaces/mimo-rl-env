diff --git a/test/spec/convertToHTML.js b/test/spec/convertToHTML.js
index 9c63665..85bee85 100644
--- a/test/spec/convertToHTML.js
+++ b/test/spec/convertToHTML.js
@@ -483,4 +483,104 @@ describe('convertToHTML', () => {
 
     expect(html).toBe('<testelement>test</testelement>');
   });
+
+  it('does not throw when blockToHTML returns a void <img/> element', () => {
+    const contentState = buildContentState([
+      {
+        type: 'atomic',
+        text: ' ',
+        data: { src: 'http://example.com/foo.png' }
+      }
+    ]);
+
+    expect(() => {
+      convertToHTML({
+        blockToHTML: (block) => {
+          if (block.type === 'atomic') {
+            return <img src={block.data.src} />;
+          }
+        }
+      })(contentState);
+    }).not.toThrow();
+  });
+
+  it('renders <img/> as block HTML for atomic blocks', () => {
+    const contentState = buildContentState([
+      {
+        type: 'atomic',
+        text: ' ',
+        data: { src: 'http://example.com/foo.png' }
+      }
+    ]);
+
+    const html = convertToHTML({
+      blockToHTML: (block) => {
+        if (block.type === 'atomic') {
+          return <img src={block.data.src} />;
+        }
+      }
+    })(contentState);
+
+    expect(html).toBe('<img src="http://example.com/foo.png"/>');
+  });
+
+  it('renders <br/> as block HTML for void element (drops block text)', () => {
+    const contentState = buildContentState([
+      {
+        type: 'unstyled',
+        text: 'hello'
+      }
+    ]);
+
+    const html = convertToHTML({
+      blockToHTML: () => <br />
+    })(contentState);
+
+    expect(html).toBe('<br/>');
+  });
+
+  it('renders <hr/> as block HTML for void element', () => {
+    const contentState = buildContentState([
+      {
+        type: 'unstyled',
+        text: ''
+      }
+    ]);
+
+    const html = convertToHTML({
+      blockToHTML: () => <hr />
+    })(contentState);
+
+    expect(html).toBe('<hr/>');
+  });
+
+  it('renders <input/> as block HTML for void element (drops block text)', () => {
+    const contentState = buildContentState([
+      {
+        type: 'unstyled',
+        text: 'x'
+      }
+    ]);
+
+    const html = convertToHTML({
+      blockToHTML: () => <input type="text" />
+    })(contentState);
+
+    expect(html).toBe('<input type="text"/>');
+  });
+
+  it('still wraps inner text for non-void single element <p/> (preservation)', () => {
+    const contentState = buildContentState([
+      {
+        type: 'unstyled',
+        text: 'hello'
+      }
+    ]);
+
+    const html = convertToHTML({
+      blockToHTML: () => <p />
+    })(contentState);
+
+    expect(html).toBe('<p>hello</p>');
+  });
 });
