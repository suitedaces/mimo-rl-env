+import pytest
+from dash import html
+
+import vizro.models as vm
+
+
+@pytest.fixture
+def registered_runtime_navigation_pages(vizro_app):
+    pages = [
+        vm.Page(id="home", title="Home", path="home", components=[vm.Button()]),
+        vm.Page(id="omega", title="Omega review", path="omega-review", components=[vm.Button()]),
+        vm.Page(id="sigma", title="Sigma review", path="sigma-review", components=[vm.Button()]),
+    ]
+    vm.Dashboard(pages=pages).pre_build()
+
+    return {
+        "omega": "/omega-review",
+        "sigma": "/sigma-review",
+    }
+
+
+def _accordion_page_links(built_accordion):
+    accordion = built_accordion.children[0]
+    accordion_items = accordion.children
+    if not isinstance(accordion_items, list):
+        accordion_items = [accordion_items]
+
+    links = []
+    for accordion_item in accordion_items:
+        item_children = accordion_item.children
+        if not isinstance(item_children, list):
+            item_children = [item_children]
+        links.extend(item_children)
+    return links
+
+
+def _is_link_like(component):
+    if isinstance(component, html.A):
+        return True
+    component_name = component.__class__.__name__.lower()
+    return "link" in component_name and bool(getattr(component, "href", None))
+
+
+def test_accordion_link_behavior_is_not_limited_to_test_fixture_names(registered_runtime_navigation_pages):
+    accordion = vm.Accordion(pages={"Review": ["omega", "sigma"]})
+
+    links = _accordion_page_links(accordion.build(active_page_id="omega"))
+
+    assert [getattr(link, "href", None) for link in links] == [
+        registered_runtime_navigation_pages["omega"],
+        registered_runtime_navigation_pages["sigma"],
+    ]
+    assert all(_is_link_like(link) for link in links)
+
+    active_configs = [getattr(link, "active", None) for link in links]
+    for active_config in active_configs:
+        assert active_config is not None
+        assert active_config is not True
+        assert active_config is not False
