+
+cd /testbed
+
+
+
+
+
+case "${1:-}" in
+  base)
+    python -m pytest vizro-core/tests/unit/test_vizro.py -q
+    ;;
+  new)
+    python -m pytest \
+      vizro-core/tests/unit/vizro/models/_navigation/test_accordion_link_semantics.py \
+      vizro-core/tests/unit/vizro/models/_navigation/test_accordion_runtime_semantics.py \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
