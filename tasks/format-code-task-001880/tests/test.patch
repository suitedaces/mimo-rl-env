+++ b/vizro-core/tests/unit/vizro/models/_navigation/test_accordion_link_semantics.py
@@ -0,0 +1,132 @@
+import pytest
+from dash import html
+
+import vizro.models as vm
+
+
+@pytest.fixture
+def registered_navigation_pages(vizro_app):
+    pages = [
+        vm.Page(id="home", title="Home", path="home", components=[vm.Button()]),
+        vm.Page(id="alpha", title="Alpha page", path="alpha", components=[vm.Button()]),
+        vm.Page(id="beta", title="Beta report", path="beta-report", components=[vm.Button()]),
+        vm.Page(id="gamma", title="Gamma detail", path="gamma-special", components=[vm.Button()]),
+    ]
+    vm.Dashboard(pages=pages).pre_build()
+
+    return {
+        "alpha": "/alpha",
+        "beta": "/beta-report",
+        "gamma": "/gamma-special",
+    }
+
+
+@pytest.fixture
+def registered_additional_navigation_pages(vizro_app):
+    pages = [
+        vm.Page(id="home", title="Home", path="home", components=[vm.Button()]),
+        vm.Page(id="delta", title="Delta operations", path="delta-operations", components=[vm.Button()]),
+        vm.Page(id="epsilon", title="Epsilon metrics", path="epsilon-metrics", components=[vm.Button()]),
+    ]
+    vm.Dashboard(pages=pages).pre_build()
+
+    return {
+        "delta": "/delta-operations",
+        "epsilon": "/epsilon-metrics",
+    }
+
+
+def _accordion_page_links(built_accordion):
+    accordion = built_accordion.children[0]
+    accordion_items = accordion.children
+    if not isinstance(accordion_items, list):
+        accordion_items = [accordion_items]
+
+    links = []
+    for accordion_item in accordion_items:
+        item_children = accordion_item.children
+        if not isinstance(item_children, list):
+            item_children = [item_children]
+        links.extend(item_children)
+    return links
+
+
+def _is_link_like(component):
+    if isinstance(component, html.A):
+        return True
+    component_name = component.__class__.__name__.lower()
+    return "link" in component_name and bool(getattr(component, "href", None))
+
+
+def _class_tokens(component):
+    class_name = getattr(component, "className", None) or getattr(component, "class_name", None) or ""
+    if isinstance(class_name, str):
+        return set(class_name.split())
+    return set(class_name)
+
+
+def test_accordion_page_items_render_as_links_with_page_targets(registered_navigation_pages):
+    accordion = vm.Accordion(pages={"Reports": ["alpha", "beta"]})
+
+    links = _accordion_page_links(accordion.build(active_page_id="alpha"))
+
+    assert [getattr(link, "href", None) for link in links] == [
+        registered_navigation_pages["alpha"],
+        registered_navigation_pages["beta"],
+    ]
+    for link in links:
+        assert _is_link_like(link)
+        classes = _class_tokens(link)
+        assert "btn-primary" not in classes
+
+
+def test_accordion_page_items_render_as_links_for_multiple_groups(registered_navigation_pages):
+    accordion = vm.Accordion(
+        pages={
+            "Reports": ["alpha", "beta"],
+            "Details": ["gamma"],
+        }
+    )
+
+    links = _accordion_page_links(accordion.build(active_page_id="gamma"))
+
+    assert {getattr(link, "href", None) for link in links} == set(registered_navigation_pages.values())
+    assert len(links) == 3
+    assert all(_is_link_like(link) for link in links)
+
+
+def test_accordion_page_items_render_as_links_for_arbitrary_page_ids_and_groups(
+    registered_additional_navigation_pages,
+):
+    accordion = vm.Accordion(pages={"Operations": ["delta", "epsilon"]})
+
+    links = _accordion_page_links(accordion.build(active_page_id="delta"))
+
+    assert [getattr(link, "href", None) for link in links] == [
+        registered_additional_navigation_pages["delta"],
+        registered_additional_navigation_pages["epsilon"],
+    ]
+    assert all(_is_link_like(link) for link in links)
+
+    active_configs = [getattr(link, "active", None) for link in links]
+    assert len(active_configs) == len(registered_additional_navigation_pages)
+    for active_config in active_configs:
+        assert active_config is not None
+        assert active_config is not True
+        assert active_config is not False
+
+
+def test_accordion_page_item_highlight_is_not_fixed_by_build_active_page_id(registered_navigation_pages):
+    accordion = vm.Accordion(pages={"Reports": ["alpha", "beta", "gamma"]})
+
+    built_for_alpha = _accordion_page_links(accordion.build(active_page_id="alpha"))
+    built_for_gamma = _accordion_page_links(accordion.build(active_page_id="gamma"))
+
+    active_config_for_alpha_build = [getattr(link, "active", None) for link in built_for_alpha]
+    active_config_for_gamma_build = [getattr(link, "active", None) for link in built_for_gamma]
+
+    assert active_config_for_alpha_build == active_config_for_gamma_build
+    assert len(active_config_for_alpha_build) == len(registered_navigation_pages)
+    for active_config in active_config_for_alpha_build:
+        assert active_config is not None
+        assert active_config is not True
+        assert active_config is not False
