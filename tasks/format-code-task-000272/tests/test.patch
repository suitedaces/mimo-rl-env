index 92d32785..71516d27 100644
--- a/test/test_grid.py
+++ b/test/test_grid.py
@@ -300,6 +300,60 @@ class TestGrid(TestCase):
             assert grid.Mesh2_face_dimension.min() >= min_dimension
             assert grid.Mesh2_face_dimension.max() <= max_dimension
 
+    def test_nNodes_per_face_attribute(self):
+        """The renamed ``nNodes_per_face`` is exposed as a Grid attribute."""
+        grids = [self.tgrid1, self.tgrid2, self.tgrid3]
+
+        for grid in grids:
+            assert hasattr(grid, "nNodes_per_face"), (
+                "Grid should expose 'nNodes_per_face' attribute after rename")
+
+            arr = grid.nNodes_per_face
+            assert hasattr(arr, "min") and hasattr(arr, "max")
+
+    def test_nNodes_per_face_in_dataset(self):
+        """The renamed variable lives in the internal xr.Dataset under
+        ``nNodes_per_face``."""
+        grids = [self.tgrid1, self.tgrid2, self.tgrid3]
+
+        for grid in grids:
+            assert "nNodes_per_face" in grid.ds, (
+                "grid.ds should contain key 'nNodes_per_face' after rename")
+
+            assert grid.ds["nNodes_per_face"].dims == ("nMesh2_face",)
+
+    def test_nNodes_per_face_values_in_range(self):
+        """Values of nNodes_per_face are >= 3 (triangle minimum) and <=
+        nMaxMesh2_face_nodes."""
+        grids = [self.tgrid1, self.tgrid2, self.tgrid3]
+
+        for grid in grids:
+            max_dimension = grid.nMaxMesh2_face_nodes
+            min_dimension = 3
+
+            assert int(grid.nNodes_per_face.min()) >= min_dimension
+            assert int(grid.nNodes_per_face.max()) <= max_dimension
+
+    def test_build_nNodes_per_face_method_exists(self):
+        """The internal builder is now named ``_build_nNodes_per_face``."""
+        grid = self.tgrid1
+        assert hasattr(grid, "_build_nNodes_per_face"), (
+            "Grid should expose private method '_build_nNodes_per_face' "
+            "after rename")
+
+        assert callable(getattr(grid, "_build_nNodes_per_face"))
+
+    def test_compute_face_areas_uses_nNodes_per_face(self):
+        """compute_face_areas still works — it now reads via the renamed
+        attribute internally."""
+        grid = self.tgrid1
+        face_areas = grid.compute_face_areas()
+
+        assert face_areas.shape[0] == grid.nMesh2_face
+
+        assert np.all(np.isfinite(face_areas))
+        assert np.all(face_areas > 0)
+
 
