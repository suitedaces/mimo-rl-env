+#!/usr/bin/env python
+# -*- coding: UTF-8 -*-
+
+
+
+
+
+
+
+
+import sys
+from io import StringIO
+from unittest import TestCase
+from unittest.mock import patch, MagicMock
+
+from requests.exceptions import HTTPError
+
+from awscurl.awscurl import inner_main
+
+
+def _make_mock_response(status_code, text='body-text'):
+
+    resp = MagicMock()
+    resp.status_code = status_code
+    resp.text = text
+    resp.ok = (status_code < 400)
+    resp.headers = {}
+
+    def raise_for_status():
+        if status_code >= 400:
+            raise HTTPError("{0} Error".format(status_code))
+
+    resp.raise_for_status = raise_for_status
+    return resp
+
+
+def _base_argv():
+
+    return ['--access_key=AK', '--secret_key=SK', 'https://example.com/']
+
+
+class _CaptureStdout(object):
+
+
+    def __enter__(self):
+        self._buf = StringIO()
+        self._orig = sys.stdout
+        sys.stdout = self._buf
+        return self._buf
+
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        sys.stdout = self._orig
+        return False
+
+
+class TestExitCodeSuccess(TestCase):
+
+
+    @patch('awscurl.awscurl.make_request')
+    def test_returns_zero_on_200(self, mock_make_request):
+        mock_make_request.return_value = _make_mock_response(200)
+        with _CaptureStdout():
+            result = inner_main(_base_argv())
+        self.assertEqual(result, 0)
+
+    @patch('awscurl.awscurl.make_request')
+    def test_returns_zero_on_201(self, mock_make_request):
+        mock_make_request.return_value = _make_mock_response(201)
+        with _CaptureStdout():
+            result = inner_main(_base_argv())
+        self.assertEqual(result, 0)
+
+
+class TestExitCodeFailure(TestCase):
+
+
+    @patch('awscurl.awscurl.make_request')
+    def test_returns_nonzero_on_404(self, mock_make_request):
+        mock_make_request.return_value = _make_mock_response(404)
+        with _CaptureStdout():
+            result = inner_main(_base_argv())
+
+
+        self.assertIsNotNone(result)
+        self.assertNotEqual(result, 0)
+
+    @patch('awscurl.awscurl.make_request')
+    def test_returns_nonzero_on_400(self, mock_make_request):
+        mock_make_request.return_value = _make_mock_response(400)
+        with _CaptureStdout():
+            result = inner_main(_base_argv())
+        self.assertIsNotNone(result)
+        self.assertNotEqual(result, 0)
+
+    @patch('awscurl.awscurl.make_request')
+    def test_returns_nonzero_on_500(self, mock_make_request):
+        mock_make_request.return_value = _make_mock_response(500)
+        with _CaptureStdout():
+            result = inner_main(_base_argv())
+        self.assertIsNotNone(result)
+        self.assertNotEqual(result, 0)
+
+    @patch('awscurl.awscurl.make_request')
+    def test_returns_nonzero_on_503(self, mock_make_request):
+        mock_make_request.return_value = _make_mock_response(503)
+        with _CaptureStdout():
+            result = inner_main(_base_argv())
+        self.assertIsNotNone(result)
+        self.assertNotEqual(result, 0)
+
+
+class TestNoExceptionOnFailure(TestCase):
+
+
+
+
+
+
+    @patch('awscurl.awscurl.make_request')
+    def test_no_exception_on_404(self, mock_make_request):
+        mock_make_request.return_value = _make_mock_response(404)
+        try:
+            with _CaptureStdout():
+                inner_main(_base_argv())
+        except HTTPError as e:
+            self.fail("inner_main raised HTTPError on 404: {0!r}".format(e))
+        except SystemExit as e:
+            self.fail("inner_main raised SystemExit on 404: {0!r}".format(e))
+
+    @patch('awscurl.awscurl.make_request')
+    def test_no_exception_on_500(self, mock_make_request):
+        mock_make_request.return_value = _make_mock_response(500)
+        try:
+            with _CaptureStdout():
+                inner_main(_base_argv())
+        except HTTPError as e:
+            self.fail("inner_main raised HTTPError on 500: {0!r}".format(e))
+        except SystemExit as e:
+            self.fail("inner_main raised SystemExit on 500: {0!r}".format(e))
+
+
+class TestBodyPrintedOnFailure(TestCase):
+
+
+    @patch('awscurl.awscurl.make_request')
+    def test_body_printed_on_404(self, mock_make_request):
+        body = '{"error":"not found"}'
+        mock_make_request.return_value = _make_mock_response(404, text=body)
+        with _CaptureStdout() as buf:
+            inner_main(_base_argv())
+        self.assertIn(body, buf.getvalue())
+
+    @patch('awscurl.awscurl.make_request')
+    def test_body_printed_on_500(self, mock_make_request):
+        body = '{"error":"server"}'
+        mock_make_request.return_value = _make_mock_response(500, text=body)
+        with _CaptureStdout() as buf:
+            inner_main(_base_argv())
+        self.assertIn(body, buf.getvalue())
+
+    @patch('awscurl.awscurl.make_request')
+    def test_body_printed_on_200(self, mock_make_request):
+        body = '{"ok":true}'
+        mock_make_request.return_value = _make_mock_response(200, text=body)
+        with _CaptureStdout() as buf:
+            inner_main(_base_argv())
+        self.assertIn(body, buf.getvalue())
