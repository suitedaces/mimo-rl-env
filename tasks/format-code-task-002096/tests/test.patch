+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+python -m pytest -v -rA tests/exit_code_test.py::TestExitCodeSuccess::test_returns_zero_on_200 tests/exit_code_test.py::TestExitCodeSuccess::test_returns_zero_on_201 tests/exit_code_test.py::TestExitCodeFailure::test_returns_nonzero_on_404 tests/exit_code_test.py::TestExitCodeFailure::test_returns_nonzero_on_400 tests/exit_code_test.py::TestExitCodeFailure::test_returns_nonzero_on_500 tests/exit_code_test.py::TestExitCodeFailure::test_returns_nonzero_on_503 tests/exit_code_test.py::TestNoExceptionOnFailure::test_no_exception_on_404 tests/exit_code_test.py::TestNoExceptionOnFailure::test_no_exception_on_500 tests/exit_code_test.py::TestBodyPrintedOnFailure::test_body_printed_on_404 tests/exit_code_test.py::TestBodyPrintedOnFailure::test_body_printed_on_500 tests/exit_code_test.py::TestBodyPrintedOnFailure::test_body_printed_on_200
+rc=$(( rc | $? ))
+exit $rc
