@@ -0,0 +1,105 @@
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+import pytest
+
+import llama_stack.core.library_client as library_client_mod
+from llama_stack.core.library_client import (
+    AsyncLlamaStackAsLibraryClient,
+    LlamaStackAsLibraryClient,
+)
+
+
+@pytest.fixture
+def mock_async_init(monkeypatch):
+
+
+    async def fake_init(self):
+        self.impls = {}
+        self.route_impls = {"__sentinel__": True}
+        return True
+
+
+    monkeypatch.setattr(
+        library_client_mod.AsyncLlamaStackAsLibraryClient, "initialize", fake_init, raising=False
+    )
+
+
+    monkeypatch.setattr(
+        library_client_mod.AsyncLlamaStackAsLibraryClient,
+        "_do_initialize",
+        fake_init,
+        raising=False,
+    )
+    return fake_init
+
+
+class TestSyncClientAutoInit:
+
+
+    def test_route_impls_set_after_construction(self, mock_async_init):
+
+
+
+
+
+        client = LlamaStackAsLibraryClient("nvidia")
+        assert client.async_client.route_impls is not None
+
+        assert client.async_client.route_impls.get("__sentinel__") is True
+
+    def test_initialize_method_callable_after_construction(self, mock_async_init):
+
+        client = LlamaStackAsLibraryClient("nvidia")
+
+        client.initialize()
+
+    def test_initialize_method_idempotent(self, mock_async_init):
+
+        client = LlamaStackAsLibraryClient("nvidia")
+        client.initialize()
+        client.initialize()
+
+        assert client.async_client.route_impls is not None
+        assert client.async_client.route_impls.get("__sentinel__") is True
+
+    def test_construction_surfaces_init_failure_immediately(self):
+
+
+
+
+
+
+        with pytest.raises(Exception) as exc_info:
+            LlamaStackAsLibraryClient("nvidia")
+
+
+        assert "Client not initialized" not in str(exc_info.value)
+
+
+class TestAsyncClientUnchanged:
+
+
+    def test_async_client_construction_does_not_raise_for_bad_distro(self):
+
+
+
+
+
+
+
+
+        client = AsyncLlamaStackAsLibraryClient("nvidia")
+        assert client.route_impls is None
