+++ b/tests/test_empty_line_optimization.py
@@ -0,0 +1,90 @@
+
+
+
+
+
+
+
+
+from markdownify import markdownify as md
+
+
+def test_issue_example_li_no_indent_spaces_on_empty_line():
+
+    html = """
+<ul>
+  <li>
+    <p>1</p>
+    <p>2</p>
+  </li>
+</ul>
+"""
+    output = md(html)
+
+    assert '\n  \n' not in output
+
+    assert output == '\n\n* 1\n\n  2\n'
+
+
+def test_issue_example_blockquote_no_trailing_space_on_marker():
+
+    html = """
+<blockquote>
+  <p>1</p>
+  <p>2</p>
+</blockquote>
+"""
+    output = md(html)
+
+    assert '> \n' not in output
+
+    assert output == '\n> 1\n>\n> 2\n\n'
+
+
+def test_blockquote_two_paragraphs_exact():
+
+    out = md('<blockquote><p>Hello</p><p>Hello again</p></blockquote>')
+    assert out == '\n> Hello\n>\n> Hello again\n\n'
+
+
+def test_blockquote_three_paragraphs_multiple_empty_markers():
+    out = md('<blockquote><p>a</p><p>b</p><p>c</p></blockquote>')
+    assert out == '\n> a\n>\n> b\n>\n> c\n\n'
+
+    assert '> \n' not in out
+
+
+def test_li_two_paragraphs_exact():
+    out = md('<ul><li><p>first para</p><p>second para</p></li></ul>')
+    assert out == '\n\n* first para\n\n  second para\n'
+
+    assert '  \n' not in out.replace('  second para', 'X')
+
+
+def test_li_with_long_bullet_no_indent_on_empty_line():
+
+
+    out = md('<ol start="1234"><li><p>first para</p><p>second para</p></li></ol>')
+    assert out == '\n\n1234. first para\n\n      second para\n'
+    assert '\n      \n' not in out
+
+
+def test_li_with_br_preserves_trailing_two_spaces():
+
+
+    out = md('<ul><li>line1<br/>line2</li></ul>')
+    assert out == '\n\n* line1  \n  line2\n'
+
+
+def test_li_containing_blockquote_two_paragraphs():
+
+
+
+    out = md('<ul><li><p>first</p><blockquote><p>q1</p><p>q2</p></blockquote></li></ul>')
+    assert out == '\n\n* first\n\n  > q1\n  >\n  > q2\n'
+
+
+def test_blockquote_containing_li_two_paragraphs():
+
+    out = md('<blockquote><ul><li><p>a</p><p>b</p></li></ul></blockquote>')
+    assert out == '\n> * a\n>\n>   b\n\n'
