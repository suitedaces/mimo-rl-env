+
+
+
+
+
+
+import numpy as np
+import pytest
+
+import albumentations as A
+
+
+def test_issue_reproduction_compose_additional_target_2d_mask_no_crash():
+
+    image = np.zeros((256, 256, 3), dtype=np.uint8)
+    mask = np.ones((256, 256), dtype=np.uint8)
+
+    transform = A.Compose(
+        [A.Resize(height=512, width=512)],
+        additional_targets={"semantic_mask": "mask"},
+    )
+
+    augmented = transform(image=image, semantic_mask=mask)
+
+    assert "semantic_mask" in augmented
+    assert augmented["semantic_mask"].shape == (512, 512)
+
+
+def test_issue_reproduction_values_preserved():
+
+    image = np.zeros((256, 256, 3), dtype=np.uint8)
+    mask = np.ones((256, 256), dtype=np.uint8)
+
+    transform = A.Compose(
+        [A.Resize(height=512, width=512)],
+        additional_targets={"semantic_mask": "mask"},
+    )
+
+    augmented = transform(image=image, semantic_mask=mask)
+    out = augmented["semantic_mask"]
+    assert out.dtype == np.uint8
+    np.testing.assert_array_equal(out, np.ones((512, 512), dtype=np.uint8))
+
+
+def test_resize_compose_standard_mask_2d_still_works():
+
+    image = np.zeros((256, 256, 3), dtype=np.uint8)
+    mask = np.ones((256, 256), dtype=np.uint8)
+
+    transform = A.Compose([A.Resize(height=512, width=512)])
+    out = transform(image=image, mask=mask)
+    assert out["mask"].shape == (512, 512)
+    assert out["image"].shape == (512, 512, 3)
+
+
+def test_resize_compose_additional_target_3d_mask_preserved():
+
+    image = np.zeros((256, 256, 3), dtype=np.uint8)
+    mask = np.ones((256, 256, 1), dtype=np.uint8)
+
+    transform = A.Compose(
+        [A.Resize(height=128, width=128)],
+        additional_targets={"semantic_mask": "mask"},
+    )
+    out = transform(image=image, semantic_mask=mask)
+    assert out["semantic_mask"].shape == (128, 128, 1)
+
+
+def test_resize_direct_call_2d_mask_no_crash():
+
+    image = np.zeros((64, 64, 3), dtype=np.uint8)
+    mask = np.ones((64, 64), dtype=np.uint8)
+
+    transform = A.Resize(height=128, width=128, p=1.0)
+    out = transform(image=image, mask=mask)
+    assert out["mask"].shape == (128, 128)
+    assert out["image"].shape == (128, 128, 3)
+
+
+def test_resize_compose_additional_target_2d_float32():
+
+    image = np.zeros((100, 100, 3), dtype=np.float32)
+    mask = np.full((100, 100), 0.5, dtype=np.float32)
+
+    transform = A.Compose(
+        [A.Resize(height=200, width=200)],
+        additional_targets={"depth": "mask"},
+    )
+    out = transform(image=image, depth=mask)
+    assert out["depth"].shape == (200, 200)
+    assert out["depth"].dtype == np.float32
+
+    np.testing.assert_allclose(out["depth"], 0.5, atol=1e-5)
+
+
+def test_resize_compose_additional_target_2d_downscale():
+
+    image = np.zeros((400, 400, 3), dtype=np.uint8)
+    mask = np.ones((400, 400), dtype=np.uint8)
+
+    transform = A.Compose(
+        [A.Resize(height=100, width=100)],
+        additional_targets={"sem_mask": "mask"},
+    )
+    out = transform(image=image, sem_mask=mask)
+    assert out["sem_mask"].shape == (100, 100)
+    np.testing.assert_array_equal(
+        out["sem_mask"], np.ones((100, 100), dtype=np.uint8)
+    )
+
+
+def test_resize_compose_multiple_2d_additional_target_masks():
+
+    image = np.zeros((256, 256, 3), dtype=np.uint8)
+    mask_a = np.ones((256, 256), dtype=np.uint8)
+    mask_b = np.full((256, 256), 7, dtype=np.uint8)
+
+    transform = A.Compose(
+        [A.Resize(height=128, width=128)],
+        additional_targets={"semantic_mask": "mask", "instance_mask": "mask"},
+    )
+    out = transform(image=image, semantic_mask=mask_a, instance_mask=mask_b)
+    assert out["semantic_mask"].shape == (128, 128)
+    assert out["instance_mask"].shape == (128, 128)
+
+    assert out["semantic_mask"][0, 0] == 1
+    assert out["instance_mask"][0, 0] == 7
