@@ -0,0 +1,50 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+dev-switch python3 3.12
+
+
+VENV=/testbed/.build_env/.venv
+if [ ! -d "$VENV" ]; then
+    python3 -m venv "$VENV"
+fi
+set +u
+source "$VENV/bin/activate"
+set -u
+
+
+pip install --no-input scipy==1.13.1 pytest hypothesis
+
+
+SITE=$(cd /tmp && python3 -c "import scipy; import os; print(os.path.dirname(scipy.__file__))")
+ISOLVE="$SITE/sparse/linalg/_isolve"
+
+
+cp /testbed/scipy/sparse/linalg/_isolve/_gcrotmk.py "$ISOLVE/_gcrotmk.py"
+cp /testbed/scipy/sparse/linalg/_isolve/iterative.py "$ISOLVE/iterative.py"
+cp /testbed/scipy/sparse/linalg/_isolve/lgmres.py "$ISOLVE/lgmres.py"
+cp /testbed/scipy/sparse/linalg/_isolve/minres.py "$ISOLVE/minres.py"
+cp /testbed/scipy/sparse/linalg/_isolve/tfqmr.py "$ISOLVE/tfqmr.py"
+cp /testbed/scipy/sparse/linalg/_isolve/tests/test_iterative.py "$ISOLVE/tests/test_iterative.py"
+
+
+case "${1:-}" in
+  base)
+    cd /tmp
+    python3 -m pytest "$ISOLVE/tests/test_iterative.py" -q \
+      --ignore-glob='*_fixture_placeholder*' \
+      -k 'not positional_deprecation and not positional_options_after_x0_warn_for_newly_aligned_solvers and not x0_third_positional_does_not_add_deprecation_warning and not later_positional_options_still_warn_for_existing_deprecated_solvers and not solver_signatures_mark_options_after_x0_keyword_only'
+    ;;
+  new)
+    cd /tmp
+    python3 -m pytest "$ISOLVE/tests/test_iterative.py" -q \
+      -k 'positional_deprecation or positional_options_after_x0_warn_for_newly_aligned_solvers or x0_third_positional_does_not_add_deprecation_warning or later_positional_options_still_warn_for_existing_deprecated_solvers or solver_signatures_mark_options_after_x0_keyword_only'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
