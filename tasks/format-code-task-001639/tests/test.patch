+import subprocess
+import textwrap
+
+
+CPP_SOURCE = r'''
+#include <dirent.h>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "DenseFeatureExtraction.h"
+
+template <typename T>
+std::string join_vec(const std::vector<T>& values) {
+  std::ostringstream out;
+  out << "[";
+  for (size_t i = 0; i < values.size(); ++i) {
+    if (i) out << ",";
+    out << values[i];
+  }
+  out << "]";
+  return out.str();
+}
+
+template <>
+std::string join_vec<std::string>(const std::vector<std::string>& values) {
+  std::ostringstream out;
+  out << "[";
+  for (size_t i = 0; i < values.size(); ++i) {
+    if (i) out << ",";
+    out << '"' << values[i] << '"';
+  }
+  out << "]";
+  return out.str();
+}
+
+void dump_feature(const Feature& feat) {
+  std::cout << "format=" << (feat._bStringFeat ? "string" : "numeric") << "\n";
+  std::cout << "strKeyChars=" << join_vec(feat._strKeyChars) << "\n";
+  std::cout << "nKeyChars=" << join_vec(feat._nKeyChars) << "\n";
+  std::cout << "wordLengths=" << join_vec(feat._nWordLengths) << "\n";
+  std::cout << "strWordFeat=" << join_vec(feat._strWordFeat) << "\n";
+  std::cout << "nWordFeat=" << join_vec(feat._nWordFeat) << "\n";
+  std::cout << "nAllWordFeat=" << join_vec(feat._nAllWordFeat) << "\n";
+}
+
+int count_fds() {
+  DIR* dir = opendir("/proc/self/fd");
+  if (!dir) return -1000000;
+  int count = 0;
+  while (readdir(dir) != NULL) ++count;
+  closedir(dir);
+  return count;
+}
+
+DenseFeatureExtraction<cpu> make_numeric_extractor() {
+  DenseFeatureExtraction<cpu> extractor(true);
+  extractor._wordAlphabet.from_string("-unknown-");
+  extractor._wordAlphabet.from_string("-null-");
+  extractor._wordAlphabet.from_string("我");
+  extractor._wordAlphabet.from_string("a0");
+  extractor._allwordAlphabet.from_string("-unknown-");
+  extractor._allwordAlphabet.from_string("-null-");
+  extractor._allwordAlphabet.from_string("我");
+  extractor._allwordAlphabet.from_string("A9");
+  extractor._charAlphabet.from_string("-unknown-");
+  extractor._charAlphabet.from_string("-null-");
+  extractor._charAlphabet.from_string("我");
+  extractor._charAlphabet.from_string("爱");
+  extractor._charAlphabet.from_string("z");
+  extractor.setAlphaIncreasing(false);
+  extractor.setFeatureFormat(false);
+  return extractor;
+}
+
+int scenario_initial_sep() {
+  std::vector<std::string> chars = {"我", "爱", "你"};
+  DenseFeatureExtraction<cpu> extractor(true);
+  CStateItem<cpu> initial(&chars);
+  CAction sep(CAction::SEP);
+  Feature feat(false);
+  feat._strKeyChars.push_back("stale-key");
+  feat._strWordFeat.push_back("stale-word");
+  feat._nWordLengths.push_back(99);
+  extractor.nn_extractFeature(&initial, sep, feat, 2);
+  dump_feature(feat);
+  return 0;
+}
+
+int scenario_after_sep_app() {
+  std::vector<std::string> chars = {"我", "爱", "你"};
+  DenseFeatureExtraction<cpu> extractor(true);
+  CStateItem<cpu> initial(&chars);
+  CStateItem<cpu> after_sep;
+  CAction sep(CAction::SEP);
+  CAction app(CAction::APP);
+  initial.move(&after_sep, sep);
+  Feature feat;
+  extractor.nn_extractFeature(&after_sep, app, feat, 2);
+  dump_feature(feat);
+  return 0;
+}
+
+int scenario_terminal_fin() {
+  std::vector<std::string> chars = {"我", "爱", "你"};
+  DenseFeatureExtraction<cpu> extractor(true);
+  CStateItem<cpu> initial(&chars);
+  CStateItem<cpu> after_sep;
+  CStateItem<cpu> after_app;
+  CStateItem<cpu> terminal_base;
+  CAction sep(CAction::SEP);
+  CAction app(CAction::APP);
+  CAction fin(CAction::FIN);
+  initial.move(&after_sep, sep);
+  after_sep.move(&after_app, app);
+  after_app.move(&terminal_base, sep);
+  Feature feat;
+  extractor.nn_extractFeature(&terminal_base, fin, feat, 2);
+  dump_feature(feat);
+  return 0;
+}
+
+int scenario_length_cap() {
+  std::vector<std::string> chars = {"a", "b", "c", "d", "e", "f"};
+  DenseFeatureExtraction<cpu> extractor(true);
+  CAction sep(CAction::SEP);
+  CAction app(CAction::APP);
+  CAction fin(CAction::FIN);
+  CStateItem<cpu> s0(&chars), s1, s2, s3, s4, s5, s6;
+  s0.move(&s1, sep);
+  s1.move(&s2, app);
+  s2.move(&s3, app);
+  s3.move(&s4, app);
+  s4.move(&s5, app);
+  s5.move(&s6, app);
+  Feature feat;
+  extractor.nn_extractFeature(&s6, fin, feat, 0);
+  dump_feature(feat);
+  return 0;
+}
+
+int scenario_numeric_normalized_prev_word() {
+  std::vector<std::string> chars = {"A", "9", "z"};
+  DenseFeatureExtraction<cpu> extractor = make_numeric_extractor();
+  CAction sep(CAction::SEP);
+  CAction app(CAction::APP);
+  CAction fin(CAction::FIN);
+  CStateItem<cpu> s0(&chars), s1, s2, z_state;
+  s0.move(&s1, sep);
+  s1.move(&s2, app);
+  s2.move(&z_state, sep);
+  Feature feat;
+  extractor.nn_extractFeature(&z_state, fin, feat, 2);
+  dump_feature(feat);
+  return 0;
+}
+
+int scenario_numeric_unknown_fallbacks() {
+  std::vector<std::string> chars = {"我", "爱", "你"};
+  DenseFeatureExtraction<cpu> extractor = make_numeric_extractor();
+  CAction sep(CAction::SEP);
+  CAction app(CAction::APP);
+  CAction fin(CAction::FIN);
+  CStateItem<cpu> initial(&chars), after_sep, after_app, after_second_word;
+  initial.move(&after_sep, sep);
+  after_sep.move(&after_app, app);
+  after_app.move(&after_second_word, sep);
+  Feature feat;
+  feat._strKeyChars.push_back("stale-key");
+  feat._strWordFeat.push_back("stale-word");
+  feat._nKeyChars.push_back(99);
+  feat._nWordFeat.push_back(98);
+  feat._nAllWordFeat.push_back(97);
+  extractor.nn_extractFeature(&after_second_word, fin, feat, 2);
+  dump_feature(feat);
+  return 0;
+}
+
+int scenario_position_error() {
+  std::vector<std::string> chars = {"我", "爱", "你"};
+  DenseFeatureExtraction<cpu> extractor(true);
+  CAction sep(CAction::SEP);
+  CStateItem<cpu> malformed(&chars);
+  malformed._lastWordStart = 0;
+  malformed._lastWordEnd = 0;
+  malformed._strlastWord = "我";
+  malformed._nextPosition = 2;
+  Feature feat;
+  extractor.nn_extractFeature(&malformed, sep, feat, 1);
+  dump_feature(feat);
+  return 0;
+}
+
+int scenario_repeated_same_call() {
+  std::vector<std::string> chars = {"我", "爱", "你"};
+  DenseFeatureExtraction<cpu> extractor = make_numeric_extractor();
+  CAction sep(CAction::SEP);
+  CAction app(CAction::APP);
+  CAction fin(CAction::FIN);
+  CStateItem<cpu> initial(&chars), after_sep, after_app, after_second_word;
+  initial.move(&after_sep, sep);
+  after_sep.move(&after_app, app);
+  after_app.move(&after_second_word, sep);
+  Feature first;
+  Feature second;
+  extractor.nn_extractFeature(&after_second_word, fin, first, 2);
+  extractor.nn_extractFeature(&after_second_word, fin, second, 2);
+  dump_feature(first);
+  std::cout << "--\n";
+  dump_feature(second);
+  return 0;
+}
+
+int scenario_instance_independence() {
+  std::vector<std::string> chars = {"我", "爱", "你"};
+  CAction sep(CAction::SEP);
+  CAction app(CAction::APP);
+  CStateItem<cpu> initial(&chars), after_sep;
+  initial.move(&after_sep, sep);
+  DenseFeatureExtraction<cpu> a(true);
+  DenseFeatureExtraction<cpu> b(true);
+  Feature first;
+  Feature second;
+  a.nn_extractFeature(&after_sep, app, first, 1);
+  b.nn_extractFeature(&initial, sep, second, 1);
+  dump_feature(first);
+  std::cout << "--\n";
+  dump_feature(second);
+  return 0;
+}
+
+int scenario_double_clear_then_repopulate() {
+  std::vector<std::string> chars = {"我", "爱", "你"};
+  DenseFeatureExtraction<cpu> extractor(true);
+  CStateItem<cpu> initial(&chars);
+  CAction sep(CAction::SEP);
+  Feature feat;
+  feat._strKeyChars.push_back("stale-key");
+  feat._strWordFeat.push_back("stale-word");
+  feat._nWordLengths.push_back(99);
+  feat.clear();
+  feat.clear();
+  extractor.nn_extractFeature(&initial, sep, feat, 1);
+  dump_feature(feat);
+  return 0;
+}
+
+int scenario_fd_floor() {
+  CAction sep(CAction::SEP);
+  int before = count_fds();
+  for (int i = 0; i < 150; ++i) {
+    std::vector<std::string> chars = {"我", "爱", "你"};
+    DenseFeatureExtraction<cpu> extractor(true);
+    CStateItem<cpu> initial(&chars);
+    Feature feat;
+    extractor.nn_extractFeature(&initial, sep, feat, 2);
+  }
+  int after = count_fds();
+  std::cout << "fd_delta=" << (after - before) << "\n";
+  return 0;
+}
+
+int main(int argc, char** argv) {
+  if (argc != 2) return 64;
+  std::string scenario = argv[1];
+  if (scenario == "initial-sep") return scenario_initial_sep();
+  if (scenario == "after-sep-app") return scenario_after_sep_app();
+  if (scenario == "terminal-fin") return scenario_terminal_fin();
+  if (scenario == "length-cap") return scenario_length_cap();
+  if (scenario == "numeric-normalized-prev-word") return scenario_numeric_normalized_prev_word();
+  if (scenario == "numeric-unknown-fallbacks") return scenario_numeric_unknown_fallbacks();
+  if (scenario == "position-error") return scenario_position_error();
+  if (scenario == "repeated-same-call") return scenario_repeated_same_call();
+  if (scenario == "instance-independence") return scenario_instance_independence();
+  if (scenario == "double-clear-then-repopulate") return scenario_double_clear_then_repopulate();
+  if (scenario == "fd-floor") return scenario_fd_floor();
+  return 65;
+}
+'''
+
+
+def _compile_harness(tmp_path_factory):
+    build_dir = tmp_path_factory.mktemp("dense_feature_cpp")
+    source = build_dir / "dense_feature_acceptance.cpp"
+    binary = build_dir / "dense_feature_acceptance"
+    source.write_text(CPP_SOURCE)
+    cmd = [
+        "g++",
+        "-std=c++11",
+        "-w",
+        "-msse3",
+        "-DUSE_CUDA=0",
+        "-DMSHADOW_USE_CUDA=0",
+        "-DMSHADOW_USE_CBLAS=1",
+        "-DMSHADOW_USE_MKL=0",
+        "-I/workspace/repo/basic",
+        "-I/workspace/repo/feature",
+        "-I/workspace/repo/state",
+        "-I/workspace/LibN3L",
+        "-I/workspace/mshadow",
+        "-I/workspace/mshadow/mshadow",
+        str(source),
+        "-o",
+        str(binary),
+        "-lopenblas",
+    ]
+    subprocess.run(cmd, cwd="/workspace/repo", check=True, text=True, capture_output=True)
+    return binary
+
+
+def run_scenario(binary, scenario):
+    completed = subprocess.run(
+        [str(binary), scenario],
+        cwd="/workspace/repo",
+        check=True,
+        text=True,
+        capture_output=True,
+    )
+    return completed.stdout
+
+
+def test_string_mode_initial_sep_clears_and_populates_padding(tmp_path_factory):
+
+
+
+
+    binary = _compile_harness(tmp_path_factory)
+
+    assert run_scenario(binary, "initial-sep") == textwrap.dedent(
+        '''\
+        format=string
+        strKeyChars=["-null-","-null-","我"]
+        nKeyChars=[]
+        wordLengths=[1]
+        strWordFeat=["-null-","-null-"]
+        nWordFeat=[]
+        nAllWordFeat=[]
+        '''
+    )
+
+
+def test_string_mode_after_sep_app_uses_stateful_current_word(tmp_path_factory):
+
+
+
+
+    binary = _compile_harness(tmp_path_factory)
+
+    assert run_scenario(binary, "after-sep-app") == textwrap.dedent(
+        '''\
+        format=string
+        strKeyChars=["我","我","爱"]
+        nKeyChars=[]
+        wordLengths=[1]
+        strWordFeat=["-null-","-null-"]
+        nWordFeat=[]
+        nAllWordFeat=[]
+        '''
+    )
+
+
+def test_terminal_fin_uses_null_next_char_and_previous_stack_word(tmp_path_factory):
+
+
+
+
+    binary = _compile_harness(tmp_path_factory)
+
+    assert run_scenario(binary, "terminal-fin") == textwrap.dedent(
+        '''\
+        format=string
+        strKeyChars=["你","你","-null-"]
+        nKeyChars=[]
+        wordLengths=[1]
+        strWordFeat=["我爱","-null-"]
+        nWordFeat=[]
+        nAllWordFeat=[]
+        '''
+    )
+
+
+def test_current_word_length_is_capped_at_five(tmp_path_factory):
+
+
+
+
+    binary = _compile_harness(tmp_path_factory)
+
+    output = run_scenario(binary, "length-cap")
+
+    assert "format=string\n" in output
+    assert 'strKeyChars=["a","f","-null-"]\n' in output
+    assert "wordLengths=[5]\n" in output
+
+
+def test_numeric_mode_converts_normalized_word_and_all_word_ids(tmp_path_factory):
+
+
+
+
+    binary = _compile_harness(tmp_path_factory)
+
+    assert run_scenario(binary, "numeric-normalized-prev-word") == textwrap.dedent(
+        '''\
+        format=numeric
+        strKeyChars=[]
+        nKeyChars=[4,4,1]
+        wordLengths=[1]
+        strWordFeat=[]
+        nWordFeat=[3,1]
+        nAllWordFeat=[3,1]
+        '''
+    )
+
+
+def test_numeric_mode_uses_unknown_fallbacks_and_clears_string_lists(tmp_path_factory):
+
+
+
+
+    binary = _compile_harness(tmp_path_factory)
+
+    assert run_scenario(binary, "numeric-unknown-fallbacks") == textwrap.dedent(
+        '''\
+        format=numeric
+        strKeyChars=[]
+        nKeyChars=[0,0,1]
+        wordLengths=[1]
+        strWordFeat=[]
+        nWordFeat=[0,1]
+        nAllWordFeat=[0,1]
+        '''
+    )
+
+
+def test_inconsistent_position_prints_error_and_continues(tmp_path_factory):
+
+
+
+
+    binary = _compile_harness(tmp_path_factory)
+
+    assert run_scenario(binary, "position-error") == textwrap.dedent(
+        '''\
+        position error
+        format=string
+        strKeyChars=["我","我","你"]
+        nKeyChars=[]
+        wordLengths=[1]
+        strWordFeat=["-null-"]
+        nWordFeat=[]
+        nAllWordFeat=[]
+        '''
+    )
+
+
+def test_repeated_same_call_is_deterministic(tmp_path_factory):
+
+
+
+
+    binary = _compile_harness(tmp_path_factory)
+
+    assert run_scenario(binary, "repeated-same-call") == textwrap.dedent(
+        '''\
+        format=numeric
+        strKeyChars=[]
+        nKeyChars=[0,0,1]
+        wordLengths=[1]
+        strWordFeat=[]
+        nWordFeat=[0,1]
+        nAllWordFeat=[0,1]
+        --
+        format=numeric
+        strKeyChars=[]
+        nKeyChars=[0,0,1]
+        wordLengths=[1]
+        strWordFeat=[]
+        nWordFeat=[0,1]
+        nAllWordFeat=[0,1]
+        '''
+    )
+
+
+def test_two_extractors_keep_independent_feature_format_state(tmp_path_factory):
+
+
+
+
+    binary = _compile_harness(tmp_path_factory)
+
+    assert run_scenario(binary, "instance-independence") == textwrap.dedent(
+        '''\
+        format=string
+        strKeyChars=["我","我","爱"]
+        nKeyChars=[]
+        wordLengths=[1]
+        strWordFeat=["-null-"]
+        nWordFeat=[]
+        nAllWordFeat=[]
+        --
+        format=string
+        strKeyChars=["-null-","-null-","我"]
+        nKeyChars=[]
+        wordLengths=[1]
+        strWordFeat=["-null-"]
+        nWordFeat=[]
+        nAllWordFeat=[]
+        '''
+    )
+
+
+def test_feature_clear_cleanup_is_idempotent_before_repopulate(tmp_path_factory):
+
+
+
+
+    binary = _compile_harness(tmp_path_factory)
+
+    assert run_scenario(binary, "double-clear-then-repopulate") == textwrap.dedent(
+        '''\
+        format=string
+        strKeyChars=["-null-","-null-","我"]
+        nKeyChars=[]
+        wordLengths=[1]
+        strWordFeat=["-null-"]
+        nWordFeat=[]
+        nAllWordFeat=[]
+        '''
+    )
+
+
+def test_repeated_sessions_do_not_leak_file_descriptors(tmp_path_factory):
+
+
+
+
+    binary = _compile_harness(tmp_path_factory)
+
+    assert run_scenario(binary, "fd-floor") == "fd_delta=0\n"
