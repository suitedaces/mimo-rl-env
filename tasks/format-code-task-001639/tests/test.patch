+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+
+PYTHON=/opt/coderl_test_venv/bin/python
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+
+if [ ! -x "$PYTHON" ]; then
+  echo "Missing offline pytest environment at /opt/coderl_test_venv" >&2
+  exit 127
+fi
+
+exec "$PYTHON" -m pytest -p no:cacheprovider /workspace/repo/usercase-test-coderl/test_dense_feature_extraction.py -v
