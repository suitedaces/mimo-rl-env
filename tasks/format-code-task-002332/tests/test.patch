diff --git a/tests/export_extension_bug/jsfmt.spec.js b/tests/export_extension_bug/jsfmt.spec.js
new file mode 100644
index 000000000..1d70c19e9
--- /dev/null
+++ b/tests/export_extension_bug/jsfmt.spec.js
@@ -0,0 +1,58 @@
+"use strict";
+
+const prettier = require("../../");
+
+function format(code) {
+  return prettier.format(code, { parser: "babylon" });
+}
+
+describe("export extension specifier handling", () => {
+  test("default + named specifiers preserve separation (the bug)", () => {
+    const out = format("export foo, {bar} from './baz';\n");
+
+    expect(out).not.toMatch(/export\s*\{\s*foo\s*,\s*bar\s*\}/);
+    expect(out).toMatch(/export\s+foo\s*,\s*\{\s*bar\s*\}\s+from\s+"\.\/baz"/);
+  });
+
+  test("default-only specifier is preserved", () => {
+    const out = format("export foo from './baz';\n");
+    expect(out.trim()).toBe('export foo from "./baz";');
+  });
+
+  test("namespace specifier is preserved with '* as'", () => {
+    const out = format("export * as ns from './baz';\n");
+    expect(out.trim()).toBe('export * as ns from "./baz";');
+  });
+
+  test("named-only specifier is preserved with braces", () => {
+    const out = format("export {bar} from './baz';\n");
+    expect(out.trim()).toBe('export { bar } from "./baz";');
+  });
+
+  test("batch (export *) is preserved", () => {
+    const out = format("export * from './baz';\n");
+    expect(out.trim()).toBe('export * from "./baz";');
+  });
+
+  test("default + namespace specifiers do not wrap namespace in braces", () => {
+    const out = format("export foo, * as ns from './baz';\n");
+
+    expect(out).not.toMatch(/\{[^}]*\*\s*as[^}]*\}/);
+
+    expect(out).toMatch(/\* as ns/);
+    expect(out).toMatch(/\bfoo\b/);
+    expect(out).toMatch(/from\s+"\.\/baz"/);
+  });
+
+  test("default + named with multiple named identifiers", () => {
+    const out = format("export foo, {bar, baz} from './qux';\n");
+    expect(out).not.toMatch(/export\s*\{\s*foo\s*,\s*bar/);
+    expect(out).toMatch(/export\s+foo\s*,\s*\{[^}]*bar[^}]*baz[^}]*\}/);
+  });
+
+  test("output is idempotent for the issue's exact case", () => {
+    const first = format("export foo, {bar} from './baz';\n");
+    const second = format(first);
+    expect(second).toBe(first);
+  });
+});
