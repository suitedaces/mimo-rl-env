@@ -0,0 +1,132 @@
+const recordUrl = new URL('./records.mjs', import.meta.url).href;
+const pdfWorkerMainUrl = new URL('../js/pdfWorkerMain.js', import.meta.url).href;
+const writePdfOverlayUrl = new URL('../js/export/pdf/writePdfOverlay.js', import.meta.url).href;
+const subsetPdfUrl = new URL('../js/export/pdf/subsetPdf.js', import.meta.url).href;
+const writePdfUrl = new URL('../js/export/pdf/writePdf.js', import.meta.url).href;
+
+export async function resolve(specifier, context, nextResolve) {
+  const resolved = await nextResolve(specifier, context);
+  if ([pdfWorkerMainUrl, writePdfOverlayUrl, subsetPdfUrl, writePdfUrl].includes(resolved.url)) {
+    return { url: `${resolved.url}?usercase-mock` };
+  }
+  return resolved;
+}
+
+export async function load(url, context, nextLoad) {
+  if (url === `${pdfWorkerMainUrl}?usercase-mock`) {
+    return {
+      format: 'module',
+      shortCircuit: true,
+      source: `
+        export async function initPdfScheduler() {
+          return {
+            async loadPdfInAllWorkers(pdfBytes) {
+              return {
+                pageCount: 3,
+                pages: [
+                  { mediaBox: [0, 0, 612, 792], rotate: 0 },
+                  { mediaBox: [0, 0, 612, 792], rotate: 0 },
+                  { mediaBox: [0, 0, 612, 792], rotate: 0 },
+                ],
+              };
+            },
+            async renderPdfPage() {
+              return {
+                dataUrl: 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4DwQACfsD/ac9oxsAAAAASUVORK5CYII=',
+                colorMode: 'color',
+              };
+            },
+            async terminate() {},
+          };
+        }
+      `,
+    };
+  }
+
+  if (url === `${writePdfOverlayUrl}?usercase-mock`) {
+    return {
+      format: 'module',
+      shortCircuit: true,
+      source: `
+        import { records } from ${JSON.stringify(recordUrl)};
+
+        export async function overlayPdfText(params) {
+          const effectivePageArr = params.pageArr || params.pageMetricsArr.map((_, index) => index);
+          records.overlay.push({
+            basePdfByteLength: params.basePdfData.byteLength,
+            ocrPages: params.ocrArr.length,
+            pageMetrics: params.pageMetricsArr.map((page) => page.dims),
+            pageArr: params.pageArr || null,
+            textMode: params.textMode,
+            rotateText: params.rotateText,
+            rotateBackground: params.rotateBackground,
+            proofOpacity: params.proofOpacity,
+            annotationsPages: params.annotationsPages.map((page) => page.length),
+            convertTextToPaths: params.convertTextToPaths === true,
+            //
+            convertRegionsToPaths: params.convertRegionsToPaths
+              ? params.convertRegionsToPaths.map((region) => ({
+                  page: region.page,
+                  bbox: region.bbox,
+                }))
+              : null,
+            convertFullPages: params.convertFullPages || null,
+            convertBrokenType3ToPaths: params.convertBrokenType3ToPaths,
+          });
+          return new TextEncoder().encode(JSON.stringify({
+            kind: 'overlay',
+            textMode: params.textMode,
+            convertTextToPaths: params.convertTextToPaths === true,
+            pageArr: effectivePageArr,
+            ocrPages: params.ocrArr.length,
+            metrics: params.pageMetricsArr.length,
+            convertFullPages: params.convertFullPages || null,
+          })).buffer;
+        }
+      `,
+    };
+  }
+
+  if (url === `${subsetPdfUrl}?usercase-mock`) {
+    return {
+      format: 'module',
+      shortCircuit: true,
+      source: `
+        import { records } from ${JSON.stringify(recordUrl)};
+
+        export async function subsetPdf(basePdfData, pageIndices) {
+          records.subset.push({ byteLength: basePdfData.byteLength, pageIndices: [...pageIndices] });
+          return basePdfData.slice(0);
+        }
+      `,
+    };
+  }
+
+  if (url === `${writePdfUrl}?usercase-mock`) {
+    return {
+      format: 'module',
+      shortCircuit: true,
+      source: `
+        import { records } from ${JSON.stringify(recordUrl)};
+
+        export async function writePdf(params) {
+          records.writePdf.push({
+            textMode: params.textMode,
+            pageArr: params.pageArr || null,
+            includeImages: params.includeImages === true,
+            images: params.images ? params.images.length : 0,
+          });
+          return new TextEncoder().encode(JSON.stringify({
+            kind: 'writePdf',
+            textMode: params.textMode,
+            pageArr: params.pageArr || null,
+            includeImages: params.includeImages === true,
+            images: params.images ? params.images.length : 0,
+          })).buffer;
+        }
+      `,
+    };
+  }
+
+  return nextLoad(url, context, nextLoad);
+}
