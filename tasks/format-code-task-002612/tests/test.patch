diff --git a/usercase-test-coderl/convert_dup_source_text_to_paths.test.js b/usercase-test-coderl/convert_dup_source_text_to_paths.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/convert_dup_source_text_to_paths.test.js
@@ -0,0 +1,390 @@
+import assert from 'node:assert/strict';
+import { mkdir, readFile, rm } from 'node:fs/promises';
+import { join } from 'node:path';
+import { test, beforeEach, afterEach } from 'node:test';
+import { ScribeDoc } from '../js/containers/scribeDoc.js';
+import { opt } from '../js/containers/app.js';
+import { OcrLine, OcrPage, OcrWord } from '../js/objects/ocrObjects.js';
+import { resetRecords, records } from './records.mjs';
+
+
+
+
+
+
+
+const PDF_FIXTURE = new Uint8Array([0x25, 0x50, 0x44, 0x46, 0x2d, 0x55, 0x43]).buffer;
+const PNG_1X1 = Uint8Array.from([
+  137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82,
+  0, 0, 0, 1, 0, 0, 0, 1, 8, 6, 0, 0, 0, 31, 21, 196, 137,
+  0, 0, 0, 13, 73, 68, 65, 84, 120, 156, 99, 248, 15, 4, 0,
+  9, 251, 3, 253, 167, 61, 163, 27, 0, 0, 0, 0, 73, 69, 78, 68,
+  174, 66, 96, 130,
+]).buffer;
+
+const warnings = [];
+let originalWarningHandler;
+let originalConsoleWarn;
+
+beforeEach(() => {
+  resetRecords();
+  warnings.length = 0;
+  originalWarningHandler = opt.warningHandler;
+  originalConsoleWarn = console.warn;
+  opt.inProcess = true;
+  opt.warningHandler = (message) => warnings.push(String(message));
+  console.warn = (message) => warnings.push(String(message));
+});
+
+afterEach(() => {
+  opt.warningHandler = originalWarningHandler;
+  console.warn = originalConsoleWarn;
+});
+
+function decodeArrayBuffer(buffer) {
+  return new TextDecoder().decode(new Uint8Array(buffer));
+}
+
+function decodeMockPdf(buffer) {
+  assert.ok(buffer instanceof ArrayBuffer);
+  return JSON.parse(decodeArrayBuffer(buffer));
+}
+
+function assertConvertWarning() {
+
+  assert.equal(warnings.length, 1);
+  assert.match(warnings[0], /convertDupSourceTextToPaths/);
+  assert.match(warnings[0], /PDF/i);
+  assert.match(warnings[0], /overlay/i);
+}
+
+function assertWholePageConversionRequested(record, expectedPageArr) {
+
+  if (record.convertTextToPaths === true) return;
+  if (record.convertRegionsToPaths) {
+    assert.deepEqual(record.convertRegionsToPaths.map((region) => region.page), expectedPageArr);
+    for (const region of record.convertRegionsToPaths) {
+      assert.deepEqual(region.bbox, [0, 0, 612, 792]);
+    }
+    return;
+  }
+  assert.deepEqual(record.convertFullPages, expectedPageArr);
+}
+
+function assertOverlayExport(exported, { textMode, pageArr, pageCount }) {
+
+  const payload = decodeMockPdf(exported);
+  assert.equal(payload.kind, 'overlay');
+  assert.equal(payload.textMode, textMode);
+  assert.deepEqual(payload.pageArr, pageArr);
+  assert.equal(payload.ocrPages, pageCount);
+  assert.equal(payload.metrics, pageCount);
+  assert.equal(records.overlay.length, 1);
+  assert.equal(records.overlay[0].textMode, textMode);
+  assert.equal(records.overlay[0].ocrPages, pageCount);
+  assert.equal(records.overlay[0].pageMetrics.length, pageCount);
+  assertWholePageConversionRequested(records.overlay[0], pageArr);
+}
+
+function assertFallbackPdfExport(exported, { textMode, pageArr }) {
+
+  const payload = decodeMockPdf(exported);
+  assert.equal(payload.kind, 'writePdf');
+  assert.equal(payload.textMode, textMode);
+  assert.deepEqual(payload.pageArr, pageArr);
+  assert.deepEqual(records.overlay, []);
+  assert.equal(records.writePdf.length, 1);
+  assert.equal(records.writePdf[0].textMode, textMode);
+  assert.deepEqual(records.writePdf[0].pageArr, pageArr);
+}
+
+async function makePdfDoc() {
+  const doc = new ScribeDoc();
+  await doc.importFiles({ pdfFiles: [PDF_FIXTURE] }, {
+    usePDFText: {
+      native: { supp: false, main: false },
+      ocr: { supp: false, main: false },
+    },
+    keepPDFTextAlways: false,
+  });
+  for (let i = 0; i < 3; i += 1) {
+    doc.insertParsedPage(i, makeOcrPage(i, `overlay-${i}`), {
+      engineName: 'User Upload',
+      dataTables: null,
+      warn: {},
+      mainData: true,
+      setActive: true,
+    });
+  }
+  doc.inputData.pageStats = [
+    { imageArea: 0, textArea: 200, pathArea: 0, hasText: true },
+    { imageArea: 0, textArea: 200, pathArea: 0, hasText: true },
+    { imageArea: 0, textArea: 200, pathArea: 0, hasText: true },
+  ];
+  doc.inputData.ocrApplied = [true, true, true];
+  return doc;
+}
+
+async function makeImageDoc() {
+  const doc = new ScribeDoc();
+  await doc.importFiles({ imageFiles: [PNG_1X1] });
+  doc.insertParsedPage(0, makeOcrPage(0, 'image-overlay'), {
+    engineName: 'User Upload',
+    dataTables: null,
+    warn: {},
+    mainData: true,
+    setActive: true,
+  });
+  return doc;
+}
+
+function makeOcrPage(index, text) {
+  const page = new OcrPage(index, { width: 2550, height: 3300 });
+  const line = new OcrLine(page, { left: 100, top: 100, right: 700, bottom: 140 }, [0.1, 0.1], null);
+  const word = new OcrWord(line, `word-${index}`, text, {
+    left: 100, top: 100, right: 300, bottom: 140,
+  }, 'normal', 97);
+  line.words.push(word);
+  page.lines.push(line);
+  return page;
+}
+
+test('invisible PDF overlay converts source text to paths for every exported page', async () => {
+
+
+
+
+  const doc = await makePdfDoc();
+
+  const exported = await doc.exportData('pdf', {
+    displayMode: 'invis',
+    addOverlay: true,
+    convertDupSourceTextToPaths: true,
+  });
+
+  assertOverlayExport(exported, { textMode: 'invis', pageArr: [0, 1, 2], pageCount: 3 });
+  assert.equal(records.overlay[0].basePdfByteLength, 7);
+  assert.deepEqual(records.subset, []);
+  assert.deepEqual(records.writePdf, []);
+  await doc.terminate();
+});
+
+test('proof PDF overlay uses the same conversion option', async () => {
+
+
+
+
+  const doc = await makePdfDoc();
+
+  const exported = await doc.exportData('pdf', {
+    displayMode: 'proof',
+    addOverlay: true,
+    convertDupSourceTextToPaths: true,
+  });
+
+  assertOverlayExport(exported, { textMode: 'proof', pageArr: [0, 1, 2], pageCount: 3 });
+  await doc.terminate();
+});
+
+test('minPage and maxPage conversion applies to the actual exported subset', async () => {
+
+
+
+
+  const doc = await makePdfDoc();
+
+  const exported = await doc.exportData('pdf', {
+    displayMode: 'invis',
+    addOverlay: true,
+    convertDupSourceTextToPaths: true,
+    minPage: 1,
+    maxPage: 2,
+  });
+
+  assertOverlayExport(exported, { textMode: 'invis', pageArr: [0, 1], pageCount: 2 });
+  assert.deepEqual(records.subset, [{ byteLength: 7, pageIndices: [1, 2] }]);
+  await doc.terminate();
+});
+
+test('pageArr conversion applies to the actual exported page order', async () => {
+
+
+
+
+  const doc = await makePdfDoc();
+
+  const exported = await doc.exportData('pdf', {
+    displayMode: 'proof',
+    addOverlay: true,
+    convertDupSourceTextToPaths: true,
+    pageArr: [2, 0],
+  });
+
+  assertOverlayExport(exported, { textMode: 'proof', pageArr: [0, 1], pageCount: 2 });
+  assert.deepEqual(records.subset, [{ byteLength: 7, pageIndices: [2, 0] }]);
+  await doc.terminate();
+});
+
+test('unsupported image input warns and exports without source-text conversion', async () => {
+
+
+
+
+  const doc = await makeImageDoc();
+
+  const exported = await doc.exportData('pdf', {
+    displayMode: 'invis',
+    addOverlay: true,
+    convertDupSourceTextToPaths: true,
+  });
+
+  assertFallbackPdfExport(exported, { textMode: 'invis', pageArr: [0] });
+  assertConvertWarning();
+  await doc.terminate();
+});
+
+test('unsupported addOverlay false warns and exports a rebuilt PDF without conversion', async () => {
+
+
+
+
+  const doc = await makePdfDoc();
+
+  const exported = await doc.exportData('pdf', {
+    displayMode: 'invis',
+    addOverlay: false,
+    convertDupSourceTextToPaths: true,
+  });
+
+  assertFallbackPdfExport(exported, { textMode: 'invis', pageArr: [0, 1, 2] });
+  assertConvertWarning();
+  assert.equal(records.writePdf[0].includeImages, true);
+  await doc.terminate();
+});
+
+test('unsupported ebook mode warns and exports without overlay conversion', async () => {
+
+
+
+
+  const doc = await makePdfDoc();
+
+  const exported = await doc.exportData('pdf', {
+    displayMode: 'ebook',
+    addOverlay: true,
+    convertDupSourceTextToPaths: true,
+  });
+
+  assertFallbackPdfExport(exported, { textMode: 'ebook', pageArr: [0, 1, 2] });
+  assertConvertWarning();
+  await doc.terminate();
+});
+
+test('download routes convertDupSourceTextToPaths through exportData and writes PDF bytes', async () => {
+
+
+
+
+  const doc = await makePdfDoc();
+  const outDir = '/workspace/repo/usercase-test-coderl/fixtures/download-output';
+  const outPath = join(outDir, 'converted.pdf');
+  await mkdir(outDir, { recursive: true });
+  await rm(outPath, { force: true });
+
+  const result = await doc.download('pdf', outPath, {
+    displayMode: 'invis',
+    addOverlay: true,
+    convertDupSourceTextToPaths: true,
+  });
+  const saved = await readFile(outPath);
+
+  assert.equal(result, undefined);
+  assertOverlayExport(saved.buffer.slice(saved.byteOffset, saved.byteOffset + saved.byteLength), {
+    textMode: 'invis',
+    pageArr: [0, 1, 2],
+    pageCount: 3,
+  });
+  await doc.terminate();
+});
+
+test('export after otherwise loaded OCR text requests duplicate source text conversion', async () => {
+
+
+
+
+  const doc = await makePdfDoc();
+
+  const exported = await doc.exportData('pdf', {
+    displayMode: 'invis',
+    addOverlay: true,
+    convertDupSourceTextToPaths: true,
+  });
+
+  assertOverlayExport(exported, { textMode: 'invis', pageArr: [0, 1, 2], pageCount: 3 });
+  await doc.terminate();
+});
+
+test('source PDF text conversion is not requested when the option is omitted', async () => {
+
+
+
+
+  const doc = await makePdfDoc();
+
+  const exported = await doc.exportData('pdf', {
+    displayMode: 'invis',
+    addOverlay: true,
+  });
+
+
+  const payload = decodeMockPdf(exported);
+  assert.equal(payload.kind, 'overlay');
+  assert.equal(records.overlay.length, 1);
+  assert.notEqual(records.overlay[0].convertTextToPaths, true);
+  assert.equal(records.overlay[0].convertRegionsToPaths, null);
+  assert.notDeepEqual(records.overlay[0].convertFullPages, [0, 1, 2]);
+  await doc.terminate();
+});
+
+test('two ScribeDoc instances keep PDF export state independent', async () => {
+
+
+
+
+  const a = await makePdfDoc();
+  const b = await makePdfDoc();
+  await a.clear();
+
+  const exported = await b.exportData('pdf', {
+    displayMode: 'invis',
+    addOverlay: true,
+    convertDupSourceTextToPaths: true,
+  });
+
+
+  assertOverlayExport(exported, { textMode: 'invis', pageArr: [0, 1, 2], pageCount: 3 });
+  await a.terminate();
+  await b.terminate();
+});
+
+test('repeated import export cycles keep conversion behavior stable', async () => {
+
+
+
+
+  for (let i = 0; i < 5; i += 1) {
+    const doc = await makePdfDoc();
+    const exported = await doc.exportData('pdf', {
+      displayMode: 'invis',
+      addOverlay: true,
+      convertDupSourceTextToPaths: true,
+    });
+
+    assert.ok(exported instanceof ArrayBuffer);
+    assertWholePageConversionRequested(records.overlay.at(-1), [0, 1, 2]);
+    await doc.terminate();
+  }
+
+  assert.equal(records.overlay.length, 5);
+  assert.equal(records.writePdf.length, 0);
+});
diff --git a/usercase-test-coderl/convert_dup_source_text_to_paths_loader.mjs b/usercase-test-coderl/convert_dup_source_text_to_paths_loader.mjs
