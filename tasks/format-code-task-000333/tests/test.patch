+def test_cli_line_length_short_option_formats_with_wider_limit(monkeypatch, tmpdir):
+    formatted = _run_darker_after_edit(
+        monkeypatch,
+        tmpdir,
+        "value = None\n",
+        "value=call(" + ",".join(["x" * 12] * 8) + ")\n",
+        ["-l", "120"],
+    )
+
+    assert len(_first_assignment_rhs(formatted)) == 8
+    assert formatted.splitlines()[0].startswith("value = ")
+
+
+def test_cli_line_length_long_option_formats_with_narrower_limit(monkeypatch, tmpdir):
+    formatted = _run_darker_after_edit(
+        monkeypatch,
+        tmpdir,
+        "value = None\n",
+        "value=call(" + ",".join(["x" * 12] * 8) + ")\n",
+        ["--line-length", "60"],
+    )
+
+    assert len(_first_assignment_rhs(formatted)) == 8
+    assert len(formatted.splitlines()) > 1
+    assert all(len(line) <= 60 for line in formatted.splitlines())
+
+
+def test_cli_skip_string_normalization_short_option_preserves_quotes(
+    monkeypatch, tmpdir
+):
+    formatted = _run_darker_after_edit(
+        monkeypatch,
+        tmpdir,
+        'message = "old"\n',
+        "message=   'temporary value'\n",
+        ["-S"],
+    )
+
+    assert _first_string_literal_quote(formatted) == "'"
+
+
