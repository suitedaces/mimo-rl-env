+def test_cli_line_length_overrides_config(monkeypatch, tmpdir):
+    formatted = _run_darker_after_edit(
+        monkeypatch,
+        tmpdir,
+        "value = None\n",
+        "value=call(" + ",".join(["x" * 15] * 5) + ")\n",
