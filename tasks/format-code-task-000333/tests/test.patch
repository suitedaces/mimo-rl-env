+def test_help_lists_black_cli_options(capsys):
+    with pytest.raises(SystemExit) as exc_info:
+        parse_command_line(["--help"])
+
+    assert exc_info.value.code == 0
+    help_output = capsys.readouterr().out
+    assert "-l" in help_output
+    assert "--line-length" in help_output
+    assert "-S" in help_output
+    assert "--skip-string-normalization" in help_output
+
+
+def test_readme_mentions_supported_black_cli_options():
+    readme = Path("README.rst").read_text()
+
+    assert "-l" in readme
+    assert "--line-length" in readme
+    assert "-S" in readme
+    assert "--skip-string-normalization" in readme
