+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+dev-switch python3 3.12
+
+
+python3 -m venv /testbed/.venv
+set +u
+source /testbed/.venv/bin/activate
+set -u
+pip install -e ".[test]" py 'black==19.10b0' --no-input 2>&1 | tail -5
+
+
+git config --global user.email "test@test.com"
+git config --global user.name "Test User"
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest \
+      src/darker/tests/conftest.py \
+      src/darker/tests/test_black_diff.py \
+      src/darker/tests/test_command_line.py::test_help_description_without_isort_package \
+      src/darker/tests/test_command_line.py::test_help_isort_option_without_isort_package \
+      src/darker/tests/test_command_line.py::test_help_with_isort_package \
+      -v
+    ;;
+  new)
+    python3 -m pytest \
+      src/darker/tests/test_command_line.py::test_cli_line_length_short_option_formats_with_wider_limit \
+      src/darker/tests/test_command_line.py::test_cli_line_length_long_option_formats_with_narrower_limit \
+      src/darker/tests/test_command_line.py::test_cli_skip_string_normalization_short_option_preserves_quotes \
+      src/darker/tests/test_command_line.py::test_cli_skip_string_normalization_preserves_unlisted_single_quotes \
+      src/darker/tests/test_command_line.py::test_cli_skip_string_normalization_long_option_preserves_quotes \
+      src/darker/tests/test_command_line.py::test_cli_line_length_overrides_config \
+      src/darker/tests/test_command_line.py::test_cli_skip_string_normalization_overrides_config \
+      src/darker/tests/test_command_line.py::test_config_skip_string_normalization_preserves_quotes_without_cli_override \
+      src/darker/tests/test_command_line.py::test_help_lists_black_cli_options \
+      src/darker/tests/test_command_line.py::test_readme_mentions_supported_black_cli_options \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
