+from pathlib import Path
 import re
+from subprocess import check_call
 
 import pytest
 
+from darker.__main__ import main
 from darker.command_line import parse_command_line
 
 
+def _git(cwd, *args):
+    check_call(["git", *args], cwd=str(cwd))
+
+
+def _write(path, contents):
+    path.write_text(contents)
+
+
+def _commit_initial_file(tmpdir, initial_contents, filename="main.py"):
+    root = Path(str(tmpdir))
+    _git(root, "init")
+    _git(root, "config", "user.email", "darker-tests@example.com")
+    _git(root, "config", "user.name", "Darker Tests")
+    src = root / filename
+    _write(src, initial_contents)
+    _git(root, "add", filename)
+    _git(root, "commit", "-m", "initial")
+    return root, src
+
+
+def _run_darker_after_edit(
+    monkeypatch,
+    tmpdir,
+    initial_contents,
+    edited_contents,
+    darker_args,
+    *,
+    config_contents=None,
+    config_name="black.toml",
+):
+    root, src = _commit_initial_file(tmpdir, initial_contents)
+    if config_contents is not None:
+        config_path = root / config_name
+        _write(config_path, config_contents)
+        darker_args = ["-c", str(config_path), *darker_args]
+    _write(src, edited_contents)
+    monkeypatch.chdir(str(root))
+
+    main([*darker_args, str(src)])
+
+    return src.read_text()
+
+
+def _first_assignment_rhs(formatted):
+    lines = formatted.splitlines()
+    for index, line in enumerate(lines):
+        if line.startswith("value = "):
+            if line.rstrip().endswith("("):
+                rhs_parts = []
+                for continuation in lines[index + 1 :]:
+                    stripped = continuation.strip()
+                    if stripped == ")":
+                        break
+                    rhs_parts.append(stripped.rstrip(","))
+                return [
+                    part.strip()
+                    for part in ",".join(rhs_parts).split(",")
+                    if part.strip()
+                ]
+            rhs = line.split("=", 1)[1].strip()
+            args = rhs[rhs.index("(") + 1 : rhs.rindex(")")]
+            return [part.strip() for part in args.split(",")]
+    raise AssertionError(formatted)
+
+
+def _first_string_literal_quote(formatted):
+    rhs = formatted.split("=", 1)[1].lstrip()
+    return rhs[0]
+
+
