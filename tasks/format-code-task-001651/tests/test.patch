--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,46 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+if [ ! -x /testbed/.venv/bin/python ]; then
+  rm -rf /testbed/.venv
+  python3 -m venv /testbed/.venv
+fi
+/testbed/.venv/bin/python -m pip install -q --upgrade pip setuptools wheel
+/testbed/.venv/bin/python -m pip install -q -r /testbed/requirements.txt pytest
+export PATH="/testbed/.venv/bin:$PATH"
+export VIRTUAL_ENV="/testbed/.venv"
+export QT_QPA_PLATFORM=offscreen
+export PYTHONPATH="/testbed/src:${PYTHONPATH:-}"
+
+
+case "${1:-}" in
+  base)
+    python - <<'PYBASE'
+import sys
+import types
+from PyQt5.QtWidgets import QApplication
+sys.modules.setdefault("urh.cythonext.path_creator", types.SimpleNamespace())
+sys.modules.setdefault("urh.cythonext.util", types.SimpleNamespace())
+sys.modules.setdefault(
+    "urh.cythonext.signalFunctions",
+    types.SimpleNamespace(get_noise_for_mod_type=lambda _mod_type: 0),
+)
+from urh.SceneManager import SceneManager
+from urh.FFTSceneManager import FFTSceneManager
+from urh.SignalSceneManager import SignalSceneManager
+app = QApplication.instance() or QApplication([])
+assert SceneManager is not None
+assert FFTSceneManager is not None
+assert SignalSceneManager is not None
+PYBASE
+    ;;
+  new)
+    python -m pytest -x -v tests/test_scene_manager_lifecycle.py
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
