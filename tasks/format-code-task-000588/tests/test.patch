new file mode 100644
index 000000000..f079dc591
--- /dev/null
+++ b/test/unit/app/browser/api/ledgerNotificationsAllowPromotionsTest.js
@@ -0,0 +1,139 @@
+
+
+
+
+
+const Immutable = require('immutable')
+const assert = require('assert')
+const sinon = require('sinon')
+const mockery = require('mockery')
+const settings = require('../../../../../js/constants/settings')
+
+describe('ledgerNotifications PAYMENTS_ALLOW_PROMOTIONS unit test', function () {
+  let ledgerNotificationsApi
+  let appAction
+  let showNotificationSpy
+
+  let paymentsEnabled
+  let paymentsNotifications
+  let paymentsAllowPromotions
+
+  const defaultAppState = Immutable.fromJS({
+    ledger: {},
+    migrations: {}
+  })
+
+  const promotionState = defaultAppState
+    .setIn(['ledger', 'promotion', 'activeState'], 'disabledWallet')
+    .setIn(['ledger', 'promotion', 'stateWallet'], Immutable.fromJS({
+      disabledWallet: {
+        notification: {
+          message: 'Hello'
+        }
+      }
+    }))
+
+  before(function () {
+    mockery.enable({
+      warnOnReplace: false,
+      warnOnUnregistered: false,
+      useCleanCache: true
+    })
+
+    const fakeElectron = require('../../../lib/fakeElectron')
+    const fakeAdBlock = require('../../../lib/fakeAdBlock')
+    const fakeLevel = require('../../../lib/fakeLevel')
+    mockery.registerMock('electron', fakeElectron)
+    mockery.registerMock('ad-block', fakeAdBlock)
+    mockery.registerMock('level', fakeLevel)
+    mockery.registerMock('../../../js/settings', {
+      getSetting: (settingKey) => {
+        switch (settingKey) {
+          case settings.PAYMENTS_ENABLED:
+            return paymentsEnabled
+          case settings.PAYMENTS_NOTIFICATIONS:
+            return paymentsNotifications
+          case settings.PAYMENTS_ALLOW_PROMOTIONS:
+            return paymentsAllowPromotions
+        }
+        return false
+      }
+    })
+
+    ledgerNotificationsApi = require('../../../../../app/browser/api/ledgerNotifications')
+    appAction = require('../../../../../js/actions/appActions')
+    showNotificationSpy = sinon.spy(appAction, 'showNotification')
+  })
+
+  after(function () {
+    showNotificationSpy.restore()
+    mockery.deregisterAll()
+    mockery.disable()
+  })
+
+  beforeEach(function () {
+    showNotificationSpy.reset()
+
+    paymentsEnabled = true
+    paymentsNotifications = true
+    paymentsAllowPromotions = true
+  })
+
+  describe('showPromotionNotification', function () {
+    it('does NOT show when PAYMENTS_ALLOW_PROMOTIONS is false (the bug scenario)', function () {
+      paymentsEnabled = true
+      paymentsNotifications = true
+      paymentsAllowPromotions = false
+      ledgerNotificationsApi.showPromotionNotification(promotionState)
+      assert(showNotificationSpy.notCalled)
+    })
+
+    it('does NOT show when PAYMENTS_ALLOW_PROMOTIONS is false even if payments disabled', function () {
+      paymentsEnabled = false
+      paymentsNotifications = true
+      paymentsAllowPromotions = false
+      ledgerNotificationsApi.showPromotionNotification(promotionState)
+      assert(showNotificationSpy.notCalled)
+    })
+
+    it('shows notification when PAYMENTS_ALLOW_PROMOTIONS is true and other settings allow', function () {
+      paymentsEnabled = true
+      paymentsNotifications = true
+      paymentsAllowPromotions = true
+      ledgerNotificationsApi.showPromotionNotification(promotionState)
+      assert(showNotificationSpy.calledOnce)
+    })
+
+    it('shows notification when payments disabled but PAYMENTS_ALLOW_PROMOTIONS is true', function () {
+      paymentsEnabled = false
+      paymentsNotifications = false
+      paymentsAllowPromotions = true
+      ledgerNotificationsApi.showPromotionNotification(promotionState)
+      assert(showNotificationSpy.calledOnce)
+    })
+
+    it('does NOT show when PAYMENTS_NOTIFICATIONS is off (preserved behavior)', function () {
+      paymentsEnabled = true
+      paymentsNotifications = false
+      paymentsAllowPromotions = true
+      ledgerNotificationsApi.showPromotionNotification(promotionState)
+      assert(showNotificationSpy.notCalled)
+    })
+
+    it('does NOT show when promotion is empty (preserved behavior)', function () {
+      paymentsEnabled = true
+      paymentsNotifications = true
+      paymentsAllowPromotions = true
+      ledgerNotificationsApi.showPromotionNotification(defaultAppState)
+      assert(showNotificationSpy.notCalled)
+    })
+
+    it('does NOT show when both PAYMENTS_NOTIFICATIONS off and PAYMENTS_ALLOW_PROMOTIONS off', function () {
+      paymentsEnabled = true
+      paymentsNotifications = false
+      paymentsAllowPromotions = false
+      ledgerNotificationsApi.showPromotionNotification(promotionState)
+      assert(showNotificationSpy.notCalled)
+    })
+  })
+})
