@@ -0,0 +1,326 @@
+
+
+
+
+
+
+import json
+import os
+import socket
+import subprocess
+import sys
+import textwrap
+
+import numpy as np
+import pytest
+
+from libfmp.c3 import (
+    compute_accumulated_cost_matrix,
+    compute_accumulated_cost_matrix_21,
+    compute_cost_matrix,
+    compute_optimal_warping_path,
+    compute_optimal_warping_path_21,
+)
+
+
+def assert_array_exact(actual, expected):
+    np.testing.assert_array_equal(actual, np.array(expected))
+
+
+def assert_array_close(actual, expected):
+    np.testing.assert_allclose(actual, np.array(expected), rtol=1e-8, atol=1e-10)
+
+
+def test_cost_matrix_default_euclidean_one_feature_sequence():
+
+
+
+    X = np.array([[0.0, 1.0, 3.0]])
+    Y = np.array([[0.0, 2.0]])
+
+    actual = compute_cost_matrix(X, Y)
+
+    assert_array_exact(actual, [[0.0, 2.0], [1.0, 1.0], [3.0, 1.0]])
+
+
+def test_cost_matrix_default_euclidean_two_feature_sequence():
+
+
+
+    X = np.array([[0.0, 1.0, 3.0], [2.0, 2.0, -1.0]])
+    Y = np.array([[1.0, 4.0], [2.0, -2.0]])
+
+    actual = compute_cost_matrix(X, Y)
+
+    assert_array_close(
+        actual,
+        [
+            [1.0, 5.65685425],
+            [0.0, 5.0],
+            [3.60555128, 1.41421356],
+        ],
+    )
+
+
+def test_cost_matrix_invalid_metric_raises_value_error():
+
+
+
+    X = np.array([[0.0, 1.0, 3.0]])
+    Y = np.array([[0.0, 2.0]])
+
+
+    with pytest.raises(ValueError):
+        compute_cost_matrix(X, Y, metric="not_a_metric")
+
+
+def test_standard_accumulated_cost_matrix_from_three_by_two_costs():
+
+
+
+    C = np.array([[0.0, 2.0], [1.0, 1.0], [3.0, 1.0]])
+
+    actual = compute_accumulated_cost_matrix(C)
+
+    assert_array_exact(actual, [[0.0, 2.0], [1.0, 1.0], [4.0, 2.0]])
+
+
+def test_standard_optimal_path_from_three_by_two_accumulated_costs():
+
+
+
+    D = np.array([[0.0, 2.0], [1.0, 1.0], [4.0, 2.0]])
+
+    actual = compute_optimal_warping_path(D)
+
+    assert_array_exact(actual, [[0, 0], [1, 0], [2, 1]])
+
+
+def test_standard_accumulated_cost_matrix_from_four_by_three_costs():
+
+
+
+    C = np.array(
+        [[1.0, 3.0, 4.0], [2.0, 1.0, 3.0], [3.0, 2.0, 1.0], [4.0, 3.0, 2.0]]
+    )
+
+    actual = compute_accumulated_cost_matrix(C)
+
+    assert_array_exact(
+        actual,
+        [[1.0, 4.0, 8.0], [3.0, 2.0, 5.0], [6.0, 4.0, 3.0], [10.0, 7.0, 5.0]],
+    )
+
+
+def test_standard_optimal_path_from_four_by_three_accumulated_costs():
+
+
+
+    D = np.array(
+        [[1.0, 4.0, 8.0], [3.0, 2.0, 5.0], [6.0, 4.0, 3.0], [10.0, 7.0, 5.0]]
+    )
+
+    actual = compute_optimal_warping_path(D)
+
+    assert_array_exact(actual, [[0, 0], [1, 1], [2, 2], [3, 2]])
+
+
+def test_constrained_21_accumulated_cost_matrix_from_four_by_three_costs():
+
+
+
+    C = np.array(
+        [[1.0, 3.0, 4.0], [2.0, 1.0, 3.0], [3.0, 2.0, 1.0], [4.0, 3.0, 2.0]]
+    )
+
+    actual = compute_accumulated_cost_matrix_21(C)
+
+    assert_array_exact(
+        actual,
+        [
+            [1.0, np.inf, np.inf],
+            [np.inf, 2.0, 4.0],
+            [np.inf, 3.0, 3.0],
+            [np.inf, np.inf, 4.0],
+        ],
+    )
+
+
+def test_constrained_21_optimal_path_from_four_by_three_accumulated_costs():
+
+
+
+    D = np.array(
+        [
+            [1.0, np.inf, np.inf],
+            [np.inf, 2.0, 4.0],
+            [np.inf, 3.0, 3.0],
+            [np.inf, np.inf, 4.0],
+        ]
+    )
+
+    actual = compute_optimal_warping_path_21(D)
+
+    assert_array_exact(actual, [[0, 0], [1, 1], [3, 2]])
+
+
+def test_single_cell_accumulation_and_paths_are_identity_boundaries():
+
+
+
+    C = np.array([[2.5]])
+
+    D_standard = compute_accumulated_cost_matrix(C)
+    P_standard = compute_optimal_warping_path(D_standard)
+    D_21 = compute_accumulated_cost_matrix_21(C)
+    P_21 = compute_optimal_warping_path_21(D_21)
+
+    assert_array_exact(D_standard, [[2.5]])
+    assert_array_exact(P_standard, [[0, 0]])
+    assert_array_exact(D_21, [[2.5]])
+    assert_array_exact(P_21, [[0, 0]])
+
+
+def test_referential_transparency_for_repeated_same_input():
+    C = np.array(
+        [[1.0, 3.0, 4.0], [2.0, 1.0, 3.0], [3.0, 2.0, 1.0], [4.0, 3.0, 2.0]]
+    )
+
+    first_D = compute_accumulated_cost_matrix(C)
+    second_D = compute_accumulated_cost_matrix(C)
+    first_P = compute_optimal_warping_path(first_D)
+    second_P = compute_optimal_warping_path(first_D)
+
+    assert_array_exact(second_D, first_D)
+    assert_array_exact(second_P, first_P)
+
+
+def test_dtw_helpers_do_not_mutate_caller_arrays():
+    X = np.array([[0.0, 1.0, 3.0]])
+    Y = np.array([[0.0, 2.0]])
+    C = np.array(
+        [[1.0, 3.0, 4.0], [2.0, 1.0, 3.0], [3.0, 2.0, 1.0], [4.0, 3.0, 2.0]]
+    )
+    D_standard = np.array(
+        [[1.0, 4.0, 8.0], [3.0, 2.0, 5.0], [6.0, 4.0, 3.0], [10.0, 7.0, 5.0]]
+    )
+    D_21 = np.array(
+        [
+            [1.0, np.inf, np.inf],
+            [np.inf, 2.0, 4.0],
+            [np.inf, 3.0, 3.0],
+            [np.inf, np.inf, 4.0],
+        ]
+    )
+    originals = [array.copy() for array in (X, Y, C, D_standard, D_21)]
+
+    compute_cost_matrix(X, Y)
+    compute_accumulated_cost_matrix(C)
+    compute_accumulated_cost_matrix_21(C)
+    compute_optimal_warping_path(D_standard)
+    compute_optimal_warping_path_21(D_21)
+
+    for actual, expected in zip((X, Y, C, D_standard, D_21), originals):
+        np.testing.assert_array_equal(actual, expected)
+
+
+def test_no_global_state_matches_fresh_process_for_representative_calls():
+    X = np.array([[0.0, 1.0, 3.0]])
+    Y = np.array([[0.0, 2.0]])
+    C = np.array(
+        [[1.0, 3.0, 4.0], [2.0, 1.0, 3.0], [3.0, 2.0, 1.0], [4.0, 3.0, 2.0]]
+    )
+    D_standard = compute_accumulated_cost_matrix(C)
+    D_21 = compute_accumulated_cost_matrix_21(C)
+    in_process = {
+        "cost": compute_cost_matrix(X, Y),
+        "acc": D_standard,
+        "path": compute_optimal_warping_path(D_standard),
+        "acc21": D_21,
+        "path21": compute_optimal_warping_path_21(D_21),
+    }
+
+    compute_cost_matrix(np.array([[10.0, -1.0]]), np.array([[3.0]]))
+    compute_accumulated_cost_matrix(np.array([[9.0, 8.0], [7.0, 6.0]]))
+    compute_accumulated_cost_matrix_21(np.array([[9.0, 8.0], [7.0, 6.0]]))
+
+    after_noise = {
+        "cost": compute_cost_matrix(X, Y),
+        "acc": compute_accumulated_cost_matrix(C),
+        "path": compute_optimal_warping_path(D_standard),
+        "acc21": compute_accumulated_cost_matrix_21(C),
+        "path21": compute_optimal_warping_path_21(D_21),
+    }
+    for key in in_process:
+        np.testing.assert_array_equal(after_noise[key], in_process[key])
+
+    script = r"""
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+import numpy as np
+from libfmp.c3 import (
+    compute_accumulated_cost_matrix,
+    compute_accumulated_cost_matrix_21,
+    compute_cost_matrix,
+    compute_optimal_warping_path,
+    compute_optimal_warping_path_21,
+)
+X = np.array([[0.0, 1.0, 3.0]])
+Y = np.array([[0.0, 2.0]])
+C = np.array([[1.0, 3.0, 4.0], [2.0, 1.0, 3.0], [3.0, 2.0, 1.0], [4.0, 3.0, 2.0]])
+D_standard = compute_accumulated_cost_matrix(C)
+D_21 = compute_accumulated_cost_matrix_21(C)
+out = {
+    "cost": compute_cost_matrix(X, Y).tolist(),
+    "acc": D_standard.tolist(),
+    "path": compute_optimal_warping_path(D_standard).tolist(),
+    "acc21": D_21.tolist(),
+    "path21": compute_optimal_warping_path_21(D_21).tolist(),
+}
+sys.stdout.write(json.dumps(out))
+"""
+    completed = subprocess.run(
+        [sys.executable, "-c", textwrap.dedent(script)],
+        check=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+    fresh_process = json.loads(completed.stdout)
+
+    for key, expected in in_process.items():
+        np.testing.assert_array_equal(np.array(fresh_process[key]), expected)
+
+
+def test_no_undeclared_filesystem_or_network_side_effects(monkeypatch, tmp_path):
+    def blocked_socket(*args, **kwargs):
+        raise AssertionError("network access is undeclared for DTW helpers")
+
+    def snapshot_tree(root):
+        return {
+            path.relative_to(root).as_posix(): path.stat().st_size
+            for path in root.rglob("*")
+            if path.is_file()
+        }
+
+    monkeypatch.setattr(socket, "socket", blocked_socket)
+    monkeypatch.chdir(tmp_path)
+    before = snapshot_tree(tmp_path)
+
+    X = np.array([[0.0, 1.0, 3.0]])
+    Y = np.array([[0.0, 2.0]])
+    C = np.array([[0.0, 2.0], [1.0, 1.0], [3.0, 1.0]])
+    D = compute_accumulated_cost_matrix(C)
+    D_21 = compute_accumulated_cost_matrix_21(
+        np.array(
+            [[1.0, 3.0, 4.0], [2.0, 1.0, 3.0], [3.0, 2.0, 1.0], [4.0, 3.0, 2.0]]
+        )
+    )
+
+    compute_cost_matrix(X, Y)
+    compute_optimal_warping_path(D)
+    compute_optimal_warping_path_21(D_21)
+
+    after = snapshot_tree(tmp_path)
+    assert after == before
