@@ -2771,6 +2771,74 @@ class OnlyTests(TestCase):
         )
 
 
+class OnlyInformativeMessageTests(TestCase):
+    def test_only_empty_returns_none(self):
+        self.assertEqual(mi.only([]), None)
+
+    def test_only_empty_with_default(self):
+        self.assertEqual(mi.only([], default='missing'), 'missing')
+
+    def test_only_single_item(self):
+        self.assertEqual(mi.only([1]), 1)
+
+    def test_only_too_long_raises_value_error(self):
+        self.assertRaises(ValueError, lambda: mi.only([1, 2]))
+
+    def test_only_too_long_message_includes_first_and_second(self):
+
+        try:
+            mi.only([42, 99])
+            self.fail("Expected ValueError")
+        except ValueError as e:
+            msg = str(e)
+            self.assertIn('42', msg)
+            self.assertIn('99', msg)
+
+    def test_only_too_long_message_uses_repr_for_strings(self):
+
+        try:
+            mi.only(['foo', 'bar'])
+            self.fail("Expected ValueError")
+        except ValueError as e:
+            msg = str(e)
+            self.assertIn("'foo'", msg)
+            self.assertIn("'bar'", msg)
+
+    def test_only_advances_iterator_only_twice(self):
+
+        it = iter([1, 2, 3, 4, 5, 6])
+        try:
+            mi.only(it)
+        except ValueError:
+            pass
+        self.assertEqual(next(it), 3)
+
+    def test_only_custom_exception_class_still_raised(self):
+        self.assertRaises(
+            TypeError, lambda: mi.only([1, 2], too_long=TypeError)
+        )
+
+
+class OneInformativeMessageTests(TestCase):
+    def test_one_basic_preserved(self):
+        self.assertEqual(mi.one(['item']), 'item')
+
+    def test_one_too_short_preserved(self):
+        self.assertRaises(ValueError, lambda: mi.one([]))
+        self.assertRaises(
+            IndexError, lambda: mi.one([], too_short=IndexError)
+        )
+
+    def test_one_too_long_raises_value_error(self):
+        self.assertRaises(ValueError, lambda: mi.one([1, 2]))
+
+    def test_one_custom_too_long_still_raised(self):
+        self.assertRaises(
+            OverflowError,
+            lambda: mi.one([1, 2], too_long=OverflowError),
+        )
+
+
