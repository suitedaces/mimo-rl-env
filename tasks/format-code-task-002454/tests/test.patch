diff --git a/tests/test_objects.py b/tests/test_objects.py
index 5673efaa3..153c5edaf 100644
--- a/tests/test_objects.py
+++ b/tests/test_objects.py
@@ -233,3 +233,53 @@ def test_skybox():
 
     skybox = texture.to_skybox()
     assert isinstance(skybox, vtk.vtkOpenGLSkybox)
+
+
+def test_numpy_to_texture_uint8_preserved():
+    """numpy_to_texture with uint8 input must preserve dtype and values."""
+    import warnings as _warnings
+
+    img = (np.ones((4, 4, 3), dtype=np.uint8) * 255)
+    with _warnings.catch_warnings():
+
+        _warnings.simplefilter("error", UserWarning)
+        tex = pyvista.numpy_to_texture(img)
+    assert tex is not None
+    arr = tex.to_array()
+    assert arr.dtype == np.uint8
+    assert (arr == 255).all()
+
+
+def test_numpy_to_texture_float_returns_uint8_dtype():
+    """numpy_to_texture must convert float input so resulting data is uint8.
+
+    Per the issue, float-dtype arrays render as black with the pythreejs
+    backend because the texture data is not uint8. The fix at the
+    ``numpy_to_texture`` entry point is to convert the data to uint8 so the
+    texture's stored array is uint8 regardless of input dtype.
+    """
+    import warnings as _warnings
+
+    img = np.ones((4, 4, 3)) * 255.0
+    assert img.dtype != np.uint8
+    with _warnings.catch_warnings():
+
+        _warnings.simplefilter("ignore", UserWarning)
+        tex = pyvista.numpy_to_texture(img)
+    arr = tex.to_array()
+    assert arr.dtype == np.uint8
+
+    assert (arr == 255).all()
+
+
+def test_numpy_to_texture_int_dtype_returns_uint8_dtype():
+    """Non-uint8 integer dtype must also be converted to uint8."""
+    import warnings as _warnings
+
+    img = (np.ones((4, 4, 3), dtype=np.int32) * 200)
+    with _warnings.catch_warnings():
+        _warnings.simplefilter("ignore", UserWarning)
+        tex = pyvista.numpy_to_texture(img)
+    arr = tex.to_array()
+    assert arr.dtype == np.uint8
+    assert (arr == 200).all()
