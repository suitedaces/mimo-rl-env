@@ -1,6 +1,8 @@
 import numpy as np
+import pandas as pd
 
 from holoviews.element import Scatter3D
+from holoviews.util.transform import dim
 
 from .test_plot import TestPlotlyPlot
 
@@ -33,3 +35,75 @@ class TestScatter3DPlot(TestPlotlyPlot):
         element = Scatter3D(([0, 1], [2, 3], [4, 5])).opts(visible=False)
         state = self._get_plot_state(element)
         self.assertEqual(state['data'][0]['visible'], False)
+
+    def _df(self):
+        return pd.DataFrame({
+            'x': [0, 1],
+            'y': [2, 3],
+            'z': [4, 5],
+            'temperature': [10.5, 20.5],
+        })
+
+    def test_colorbar_title_uses_dimension_name_for_str_color(self):
+
+
+        scatter = Scatter3D(
+            self._df(), kdims=['x', 'y', 'z'], vdims=['temperature']
+        ).opts(color='temperature', colorbar=True)
+        state = self._get_plot_state(scatter)
+        colorbar = state['data'][0]['marker']['colorbar']
+        title = colorbar['title']
+
+        text = title['text'] if isinstance(title, dict) else title
+        self.assertEqual(text, 'temperature')
+
+    def test_colorbar_title_no_im_prefix(self):
+
+        scatter = Scatter3D(
+            self._df(), kdims=['x', 'y', 'z'], vdims=['temperature']
+        ).opts(color='temperature', colorbar=True)
+        state = self._get_plot_state(scatter)
+        colorbar = state['data'][0]['marker']['colorbar']
+        title = colorbar['title']
+        text = title['text'] if isinstance(title, dict) else title
+        self.assertFalse(text.startswith('im('))
+        self.assertNotIn("'", text)
+
+    def test_colorbar_opts_title_accepted(self):
+
+
+        scatter = Scatter3D(
+            self._df(), kdims=['x', 'y', 'z'], vdims=['temperature']
+        ).opts(
+            color='temperature',
+            colorbar=True,
+            colorbar_opts={'title': 'Temperature (degC)'},
+        )
+        state = self._get_plot_state(scatter)
+        colorbar = state['data'][0]['marker']['colorbar']
+        title = colorbar['title']
+        text = title['text'] if isinstance(title, dict) else title
+        self.assertEqual(text, 'Temperature (degC)')
+
+    def test_colorbar_title_with_dim_no_ops(self):
+
+        scatter = Scatter3D(
+            self._df(), kdims=['x', 'y', 'z'], vdims=['temperature']
+        ).opts(color=dim('temperature'), colorbar=True)
+        state = self._get_plot_state(scatter)
+        colorbar = state['data'][0]['marker']['colorbar']
+        title = colorbar['title']
+        text = title['text'] if isinstance(title, dict) else title
+        self.assertEqual(text, 'temperature')
+
+    def test_colorbar_title_with_dim_ops_preserved(self):
+
+
+        scatter = Scatter3D(
+            self._df(), kdims=['x', 'y', 'z'], vdims=['temperature']
+        ).opts(color=dim('temperature') * 2, colorbar=True)
+        state = self._get_plot_state(scatter)
+        colorbar = state['data'][0]['marker']['colorbar']
+        title = colorbar['title']
+        text = title['text'] if isinstance(title, dict) else title
+        self.assertEqual(text, "dim('temperature')*2")
