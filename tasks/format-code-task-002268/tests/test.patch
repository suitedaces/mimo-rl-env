+func (s *testSessionSuite) TestSign(c *C) {
+	defer testleak.AfterTest(c)()
+	store := newStore(c, s.dbName)
+	se := newSession(c, store, s.dbName)
+
+	for _, t := range []struct {
+		expr   string
+		ret    int64
+		isNull bool
+	}{
+		{"SIGN(123)", 1, false},
+		{"SIGN(2)", 1, false},
+		{"SIGN(0.5)", 1, false},
+		{"SIGN('7')", 1, false},
+		{"SIGN('9')", 1, false},
+		{"SIGN(0)", 0, false},
+		{"SIGN(0.0)", 0, false},
+		{"SIGN('0')", 0, false},
+		{"SIGN(-123)", -1, false},
+		{"SIGN(-2)", -1, false},
+		{"SIGN(-0.5)", -1, false},
+		{"SIGN('-7')", -1, false},
+		{"SIGN('-9')", -1, false},
+		{"SIGN(NULL)", 0, true},
+		{"SIGN(NULLIF(1, 1))", 0, true},
+	} {
+		r := mustExecSQL(c, se, "select "+t.expr)
+		row, err := r.Next()
+		c.Assert(err, IsNil, Commentf("expr %s", t.expr))
+		c.Assert(row.Data, HasLen, 1, Commentf("expr %s", t.expr))
+		if t.isNull {
+			c.Assert(row.Data[0].IsNull(), IsTrue, Commentf("expr %s", t.expr))
+			continue
+		}
+		c.Assert(row.Data[0].GetInt64(), Equals, t.ret, Commentf("expr %s", t.expr))
+	}
+
+	mustExecSQL(c, se, "drop table if exists sign_probe")
+	mustExecSQL(c, se, "create table sign_probe (v double)")
+	mustExecSQL(c, se, "insert into sign_probe values (0.5), (0), (-0.5)")
+	r := mustExecSQL(c, se, "select sign(v) from sign_probe order by v")
+	rows, err := GetRows(r)
+	c.Assert(err, IsNil)
+	c.Assert(rows, HasLen, 3)
+	c.Assert(rows[0][0].GetInt64(), Equals, int64(-1))
+	c.Assert(rows[1][0].GetInt64(), Equals, int64(0))
+	c.Assert(rows[2][0].GetInt64(), Equals, int64(1))
+
+	err = store.Close()
+	c.Assert(err, IsNil)
+}
+
