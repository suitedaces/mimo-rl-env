diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,56 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+dev-switch go 1.23
+
+mkdir -p /root/go/src/github.com/pingcap
+ln -sf /testbed /root/go/src/github.com/pingcap/tidb
+
+GO111MODULE=off GOPATH=/testbed/_vendor:/root/go GO15VENDOREXPERIMENT="1" go build -o bin/goyacc parser/goyacc/main.go
+bin/goyacc -o /dev/null -xegen temp_parser_file parser/parser.y
+bin/goyacc -o parser/parser.go -xe temp_parser_file parser/parser.y
+rm -f temp_parser_file y.output
+sed -i -e 's|//line.*||' -e 's/yyEofCode/yyEOFCode/' parser/parser.go
+python3 -c "
+import sys
+with open('parser/parser.go', 'rb') as f:
+    data = f.read()
+last_bad = -1
+for i in range(len(data)-1, -1, -1):
+    if data[i] > 127:
+        last_bad = i
+        break
+if last_bad >= 0:
+    while last_bad > 0 and data[last_bad-1] > 127:
+        last_bad -= 1
+    data = data[:last_bad]
+    if not data.endswith(b'\n'):
+        data += b'\n'
+    with open('parser/parser.go', 'wb') as f:
+        f.write(data)
+" 2>/dev/null
+
+
+export GO111MODULE=off
+export GOPATH=/testbed/_vendor:/root/go
+export GO15VENDOREXPERIMENT=1
+
+case "${1:-}" in
+  base)
+    go test -vet=off -run TestT ./expression/ -check.f 'TestAbs|TestConv'
+    go test -vet=off -run TestT ./parser/ -check.f 'TestSimple'
+    go test -vet=off -run TestT ./plan/ -check.f 'TestColumnInfoModified'
+    ;;
+  new)
+    go test -vet=off -run TestT . -check.f 'TestSign'
+    go test -vet=off -run TestT ./parser/ -check.f 'TestBuiltin'
+    go test -vet=off -run TestT ./plan/ -check.f 'TestInferType'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
