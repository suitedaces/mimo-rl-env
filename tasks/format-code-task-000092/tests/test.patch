diff --git a/tests/gpflow/experimental/check_shapes/test_multi_varrank.py b/tests/gpflow/experimental/check_shapes/test_multi_varrank.py
new file mode 100644
index 00000000..365311c6
--- /dev/null
+++ b/tests/gpflow/experimental/check_shapes/test_multi_varrank.py
@@ -0,0 +1,139 @@
+
+
+
+
+
+
+
+
+
+
+import pytest
+
+from gpflow.experimental.check_shapes import ShapeChecker, check_shapes
+from gpflow.experimental.check_shapes.exceptions import ShapeMismatchError
+from gpflow.experimental.check_shapes.parser import parse_tensor_spec
+from gpflow.experimental.check_shapes.specs import ParsedShapeSpec
+
+from .utils import t
+
+
+def test_parse_multi_varrank_spec_does_not_assert() -> None:
+
+    spec = parse_tensor_spec("[a..., b...]", None)
+
+    assert isinstance(spec.shape, ParsedShapeSpec)
+    n_varrank = sum(d.variable_rank for d in spec.shape.dims)
+    assert n_varrank == 2
+
+
+def test_parse_three_varrank_spec_does_not_assert() -> None:
+
+    spec = parse_tensor_spec("[a..., b..., c...]", None)
+    n_varrank = sum(d.variable_rank for d in spec.shape.dims)
+    assert n_varrank == 3
+
+
+def test_check_multi_varrank_resolves_when_ranks_known_in_order() -> None:
+
+
+    c = ShapeChecker()
+    c.check_shape(t(2), "[a...]")
+    c.check_shape(t(3), "[b...]")
+    c.check_shape(t(2, 3), "[a..., b...]")
+
+
+def test_check_multi_varrank_resolves_deferred() -> None:
+
+
+    c = ShapeChecker()
+    c.check_shape(t(2, 3), "[a..., b...]")
+    c.check_shape(t(2), "[a...]")
+    c.check_shape(t(3), "[b...]")
+
+
+
+def test_check_multi_varrank_mismatch_raises() -> None:
+
+
+    c = ShapeChecker()
+    c.check_shape(t(2), "[a...]")
+    c.check_shape(t(3), "[b...]")
+    with pytest.raises(ShapeMismatchError):
+        c.check_shape(t(2, 4), "[a..., b...]")
+
+
+def test_check_multi_varrank_total_too_short_raises() -> None:
+
+
+    c = ShapeChecker()
+    with pytest.raises(ShapeMismatchError):
+        c.check_shape(t(), "[a..., b..., 3]")
+
+
+def test_check_multi_varrank_unresolved_does_not_raise() -> None:
+
+
+    c = ShapeChecker()
+
+    c.check_shape(t(2, 3), "[a..., b...]")
+
+
+def test_check_multi_varrank_in_single_check_shapes_call() -> None:
+
+
+    checker = ShapeChecker()
+    checker.check_shapes(
+        [
+            (t(2, 3), "[a..., b...]"),
+            (t(2), "[a...]"),
+            (t(3), "[b...]"),
+        ]
+    )
+
+
+def test_check_multi_varrank_in_single_check_shapes_call_mismatch() -> None:
+
+    checker = ShapeChecker()
+    with pytest.raises(ShapeMismatchError):
+        checker.check_shapes(
+            [
+                (t(2, 4), "[a..., b...]"),
+                (t(2), "[a...]"),
+                (t(3), "[b...]"),
+            ]
+        )
+
+
+def test_decorator_with_multi_varrank_in_return_spec_issue_example() -> None:
+
+
+
+    @check_shapes(
+        "a: [a_shape...]",
+        "b: [b_shape...]",
+        "return: [a_shape..., b_shape...]",
+    )
+    def broadcasting_elementwise(a, b):
+        return t(*(a.test_shape + b.test_shape))
+
+
+    out = broadcasting_elementwise(t(2, 3), t(4, 5, 6))
+    assert out.test_shape == (2, 3, 4, 5, 6)
+
+
+def test_decorator_with_multi_varrank_in_return_spec_bad_return() -> None:
+
+
+
+    @check_shapes(
+        "a: [a_shape...]",
+        "b: [b_shape...]",
+        "return: [a_shape..., b_shape...]",
+    )
+    def bad(a, b):
+
+        return t(2, 3, 4, 6)
+
+    with pytest.raises(ShapeMismatchError):
+        bad(t(2, 3), t(4, 5))
