new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,35 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set +u
+source /opt/aioxmpp_venv/bin/activate
+set -u
+pip install -e /testbed --no-input -q
+
+
+case "${1:-}" in
+  base)
+    python -m pytest tests/muc/test_service.py tests/vcard/test_service.py \
+      --ignore=tests/test_muc_admin_examples.py \
+      --ignore-glob='tests/*muc_admin_examples.py' \
+      -k 'not test_get_affiliation and not test_get_affiliated_propagates_send_errors and not test_set_vcard_for_foreign_jid and not test_set_vcard_for_another_foreign_jid' \
+      -q
+    ;;
+  new)
+    python -m pytest \
+      tests/muc/test_service.py::TestService::test_get_affiliation \
+      tests/muc/test_service.py::TestService::test_get_affiliation_uses_requested_affiliation_and_returns_response_jids \
+      tests/muc/test_service.py::TestService::test_get_affiliated_propagates_send_errors \
+      tests/vcard/test_service.py::TestService::test_set_vcard \
+      tests/vcard/test_service.py::TestService::test_set_vcard_for_foreign_jid \
+      tests/vcard/test_service.py::TestService::test_set_vcard_for_another_foreign_jid \
+      tests/test_muc_admin_examples.py \
+      -q
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
