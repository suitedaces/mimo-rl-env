diff --git a/tests/test_muc_admin_examples.py b/tests/test_muc_admin_examples.py
new file mode 100644
index 00000000..89d31ac9
--- /dev/null
+++ b/tests/test_muc_admin_examples.py
@@ -0,0 +1,46 @@
+import pathlib
+import py_compile
+import unittest
+
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+
+
+class TestMUCAdminExamples(unittest.TestCase):
+
+    def test_expected_examples_exist_and_compile(self):
+        for relpath in [
+                "examples/get_muc_affiliations.py",
+                "examples/set_muc_avatar.py",
+        ]:
+            path = ROOT / relpath
+            self.assertTrue(
+                path.exists(),
+                "{} is missing".format(relpath),
+            )
+            py_compile.compile(str(path), doraise=True)
+
+    def test_examples_reference_public_capabilities(self):
+        affiliations_example = (
+            ROOT / "examples/get_muc_affiliations.py"
+        ).read_text(encoding="utf-8")
+        avatar_example = (
+            ROOT / "examples/set_muc_avatar.py"
+        ).read_text(encoding="utf-8")
+
+        self.assertIn("get_affiliated", affiliations_example)
+        self.assertIn("set_vcard", avatar_example)
+        self.assertIn("jid=", avatar_example)
+
+    def test_changelog_mentions_user_visible_capabilities(self):
+        changelog = (
+            ROOT / "docs/api/changelog.rst"
+        ).read_text(encoding="utf-8").lower()
+
+        self.assertIn("get_affiliated", changelog)
+        self.assertIn("set_vcard", changelog)
+        self.assertIn("jid", changelog)
+        self.assertTrue(
+            "muc" in changelog or "room" in changelog,
+        )
+
