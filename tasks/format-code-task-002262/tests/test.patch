+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+
+
+set -euo pipefail
+
+cd /workspace/repo
+export PIP_NO_INDEX=1
+export PYTHONPATH="/workspace/repo${PYTHONPATH:+:$PYTHONPATH}"
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+
+
+if [ ! -f /workspace/repo/vdirsyncer/version.py ]; then
+  printf '%s\n' 'version = "0+localb"' > /workspace/repo/vdirsyncer/version.py
+fi
+exec python -m pytest -o addopts= -p pytest_asyncio.plugin /workspace/repo/usercase-test-coderl/test_singlefile_storage_acceptance.py -v
