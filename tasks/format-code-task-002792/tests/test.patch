+test('does_not_mutate_comp_params_input', function () {
+    const params = makeParams();
+    const before = JSON.stringify({
+        parserWarnings: params.parserWarnings,
+        debugTrace: params.debugTrace,
+        printAST: params.printAST,
+    });
+    tachyon.parse_src_str('var x = 1;', params);
+    const after = JSON.stringify({
+        parserWarnings: params.parserWarnings,
+        debugTrace: params.debugTrace,
+        printAST: params.printAST,
+    });
+    assert.strictEqual(after, before);
+});
+
+test('no_global_state_across_fresh_process', function () {
+    const inProcess = JSON.stringify(summarizeAst(tachyon.parse_src_str('var x = 1;', makeParams())));
+    const freshProcess = childProcess.execFileSync(
+        process.execPath,
+        [__filename, '--fresh-process-snapshot'],
+        { encoding: 'utf8' }
+    );
+    assert.strictEqual(freshProcess, inProcess);
+});
+
+test('parse_src_str_has_no_undeclared_file_or_network_side_effects', function () {
+    const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'tachyon-parser-'));
+    const originalCwd = process.cwd();
+    const originalWriteFileSync = fs.writeFileSync;
+    const originalOpenSync = fs.openSync;
+    const originalSocket = net.Socket;
+    const writes = [];
+    let socketCreated = false;
+
+    function snapshot(dir) {
+        return fs.readdirSync(dir).sort();
+    }
+
+    process.chdir(tmpDir);
+    const before = snapshot(tmpDir);
+
+    fs.writeFileSync = function () {
+        writes.push(arguments[0]);
+        return originalWriteFileSync.apply(this, arguments);
+    };
+    fs.openSync = function (fileName, flags) {
+        if (typeof flags === 'string' && /[wax+]/.test(flags))
+            writes.push(fileName);
+        return originalOpenSync.apply(this, arguments);
+    };
+    net.Socket = function () {
+        socketCreated = true;
+        throw new Error('network access is not declared for parse_src_str');
+    };
+
+    try {
+        const capture = capturePrint(function () {
+            return tachyon.parse_src_str('var x = 1;', makeParams());
+        });
+        assert.deepStrictEqual(
+            summarizeAst(capture.result),
+            {"type":"Program","loc":"\"<string>\"@1.1-1.11","vars":{"x":{"id":"x","isParam":false,"scope":"Program","loc":"\"<string>\"@1.5-1.6"}},"freeVars":{},"funcs":[],"usesArguments":false,"usesEval":false,"block":{"type":"BlockStatement","loc":"\"<string>\"@1.1-1.11","statements":[{"type":"ExprStatement","loc":"\"<string>\"@1.5-1.10","expr":{"type":"OpExpr","loc":"\"<string>\"@1.5-1.10","op":"x = y","exprs":[{"type":"Ref","loc":"\"<string>\"@1.5-1.6","name":"x","scope":"Program"},{"type":"Literal","loc":"\"<string>\"@1.9-1.10","value":1,"valueType":"number"}]}}]}}
+        );
+        assert.strictEqual(capture.output, '');
+        assert.deepStrictEqual(snapshot(tmpDir), before);
+        assert.deepStrictEqual(writes, []);
+        assert.strictEqual(socketCreated, false);
+    } finally {
+        fs.writeFileSync = originalWriteFileSync;
+        fs.openSync = originalOpenSync;
+        net.Socket = originalSocket;
+        process.chdir(originalCwd);
+        fs.rmSync(tmpDir, { recursive: true, force: true });
+    }
+});
