+const assert = require('assert');
+const childProcess = require('child_process');
+const fs = require('fs');
+const net = require('net');
+const os = require('os');
+const path = require('path');
+const vm = require('vm');
+
+const REPO = '/workspace/repo';
+const FIXTURES = '/workspace/repo/usercase-test-coderl/fixtures';
+
+const deepStrictEqual = assert.deepStrictEqual.bind(assert);
+function jsonValue(value) {
+    return JSON.parse(JSON.stringify(value));
+}
+assert.deepStrictEqual = function (actual, expected, message) {
+    return deepStrictEqual(jsonValue(actual), jsonValue(expected), message);
+};
+
+function loadTachyonParser() {
+    const context = {
+        Error: Error,
+        config: { verbosity: 0 },
+    };
+
+    context.print = function (value) {
+        process.stdout.write(String(value) + '\n');
+    };
+    context.readFile = function (fileName) {
+        return fs.readFileSync(fileName, 'utf8');
+    };
+    context.global = context;
+
+    vm.createContext(context);
+
+    [
+        'source/utility/debug.js',
+        'source/utility/strings.js',
+        'source/utility/iterators.js',
+        'source/utility/arrays.js',
+        'source/utility/hashmap.js',
+        'source/utility/num.js',
+        'source/utility/log.js',
+        'source/parser/scanner.js',
+        'source/parser/parser.js',
+
+        'source/parser/ast-passes.js',
+        'source/parser/pp.js',
+        'source/compiler/params.js',
+        'source/parser/misc.js',
+    ].forEach((relPath) => {
+        vm.runInContext(
+            fs.readFileSync(path.join(REPO, relPath), 'utf8'),
+            context,
+            { filename: relPath }
+        );
+    });
+
+    return context;
+}
+
+const tachyon = loadTachyonParser();
+
+function makeParams(options) {
+    options = options || {};
+    const params = Object.create(tachyon.CompParams.prototype);
+    params.parserWarnings = options.parserWarnings === true;
+    params.debugTrace = options.debugTrace === true;
+    params.printAST = options.printAST === true;
+    return params;
+}
+
+function locOf(node) {
+    return node && node.loc ? node.loc.to_string() : null;
+}
+
+function idName(id) {
+    if (id === null || id === undefined)
+        return null;
+
+    if (id.id !== undefined)
+        return idName(id.id);
+
+    if (id.value !== undefined)
+        return id.value;
+
+    return String(id);
+}
+
+function varMapSummary(vars) {
+    if (!vars)
+        return {};
+
+    const out = {};
+    Object.keys(vars).sort().forEach((name) => {
+        const variable = vars[name];
+        out[name] = {
+            id: idName(variable),
+            isParam: variable.is_param,
+            scope: variable.scope && variable.scope.constructor
+                ? variable.scope.constructor.name
+                : null,
+            loc: variable.id && variable.id.loc ? variable.id.loc.to_string() : null,
+        };
+    });
+    return out;
+}
+
+function scopeKeys(vars) {
+    return vars ? Object.keys(vars).sort() : [];
+}
+
+function functionHead(node) {
+    if (node instanceof tachyon.FunctionDeclaration) {
+        return {
+            type: 'FunctionDeclaration',
+            loc: locOf(node),
+            id: idName(node.id),
+        };
+    }
+
+    if (node instanceof tachyon.FunctionExpr) {
+        return {
+            type: 'FunctionExpr',
+            loc: locOf(node),
+            id: idName(node.id),
+            params: node.params.map((param) => idName(param)),
+        };
+    }
+
+    return {
+        type: node && node.constructor && node.constructor.name
+            ? node.constructor.name
+            : typeof node,
+        loc: locOf(node),
+    };
+}
+
+function summarizeAst(node) {
+    if (node === null || node === undefined)
+        return null;
+
+    if (node instanceof tachyon.Program) {
+        return {
+            type: 'Program',
+            loc: locOf(node),
+            vars: varMapSummary(node.vars),
+            freeVars: varMapSummary(node.free_vars),
+            funcs: (node.funcs || []).map((fn) => functionHead(fn)),
+            usesArguments: node.usesArguments,
+            usesEval: node.usesEval,
+            block: summarizeAst(node.block),
+        };
+    }
+
+    if (node instanceof tachyon.BlockStatement) {
+        return {
+            type: 'BlockStatement',
+            loc: locOf(node),
+            statements: node.statements.map((statement) => summarizeAst(statement)),
+        };
+    }
+
+    if (node instanceof tachyon.FunctionDeclaration) {
+        return {
+            type: 'FunctionDeclaration',
+            loc: locOf(node),
+            id: idName(node.id),
+            funct: summarizeAst(node.funct),
+        };
+    }
+
+    if (node instanceof tachyon.FunctionExpr) {
+        return {
+            type: 'FunctionExpr',
+            loc: locOf(node),
+            id: idName(node.id),
+            params: node.params.map((param) => idName(param)),
+            vars: varMapSummary(node.vars),
+            freeVars: varMapSummary(node.free_vars),
+            closVars: varMapSummary(node.clos_vars),
+            escVars: varMapSummary(node.esc_vars),
+            funcs: (node.funcs || []).map((fn) => functionHead(fn)),
+            usesArguments: node.usesArguments,
+            usesEval: node.usesEval,
+            body: node.body.map((statement) => summarizeAst(statement)),
+        };
+    }
+
+    if (node instanceof tachyon.ExprStatement) {
+        return {
+            type: 'ExprStatement',
+            loc: locOf(node),
+            expr: summarizeAst(node.expr),
+        };
+    }
+
+    if (node instanceof tachyon.ReturnStatement) {
+        return {
+            type: 'ReturnStatement',
+            loc: locOf(node),
+            expr: summarizeAst(node.expr),
+        };
+    }
+
+    if (node instanceof tachyon.IfStatement) {
+        return {
+            type: 'IfStatement',
+            loc: locOf(node),
+            expr: summarizeAst(node.expr),
+            statements: node.statements.map((statement) => summarizeAst(statement)),
+        };
+    }
+
+    if (node instanceof tachyon.OpExpr) {
+        return {
+            type: 'OpExpr',
+            loc: locOf(node),
+            op: node.op,
+            exprs: node.exprs.map((expr) => summarizeAst(expr)),
+        };
+    }
+
+    if (node instanceof tachyon.CallExpr) {
+        return {
+            type: 'CallExpr',
+            loc: locOf(node),
+            fn: summarizeAst(node.fn),
+            args: node.args.map((arg) => summarizeAst(arg)),
+        };
+    }
+
+    if (node instanceof tachyon.Ref) {
+        return {
+            type: 'Ref',
+            loc: locOf(node),
+            name: idName(node.id),
+            scope: node.id && node.id.scope && node.id.scope.constructor
+                ? node.id.scope.constructor.name
+                : null,
+        };
+    }
+
+    if (node instanceof tachyon.Literal) {
+        return {
+            type: 'Literal',
+            loc: locOf(node),
+            value: node.value,
+            valueType: typeof node.value,
+        };
+    }
+
+    return {
+        type: node.constructor && node.constructor.name
+            ? node.constructor.name
+            : typeof node,
+        loc: locOf(node),
+    };
+}
+
+function summarizeDebugTraceProgram(program) {
+    const topLevelHeads = program.block.statements.map((statement) => {
+        if (statement instanceof tachyon.FunctionDeclaration)
+            return ['FunctionDeclaration', idName(statement.id)];
+
+        if (
+            statement instanceof tachyon.ExprStatement &&
+            statement.expr instanceof tachyon.CallExpr
+        ) {
+            return ['ExprStatement', idName(statement.expr.fn.id)];
+        }
+
+        return [
+            statement.constructor && statement.constructor.name
+                ? statement.constructor.name
+                : typeof statement,
+            null,
+        ];
+    });
+
+    const userFunction = program.block.statements.filter((statement) => {
+        return statement instanceof tachyon.FunctionDeclaration && idName(statement.id) === 'f';
+    })[0];
+
+    return {
+        type: 'Program',
+        loc: locOf(program),
+        varsSubset: [
+            'f',
+            'profile$end_of_program',
+            'profile$enter',
+            'profile$return0',
+            'profile$return1',
+        ].filter((name) => program.vars[name] !== undefined),
+        freeVarsSubset: ['arguments'].filter((name) => program.free_vars[name] !== undefined),
+        topLevelCount: topLevelHeads.length,
+        finalTopLevelHeads: topLevelHeads.slice(-2),
+        userFunctionBody: userFunction.funct.body.map((statement) => summarizeAst(statement)),
+    };
+}
+
+function summarizeNestedFileProgram(program) {
+    const outerDecl = program.block.statements[0];
+    const outer = outerDecl.funct;
+    const assignment = outer.body[0].expr;
+    const inner = outer.body[1].expr;
+    const innerReturn = inner.body[0].expr;
+
+    return {
+        type: 'Program',
+        loc: locOf(program),
+        programVars: scopeKeys(program.vars),
+        programFuncs: program.funcs.map((fn) => functionHead(fn)),
+        outer: {
+            id: idName(outerDecl.id),
+            params: outer.params.map((param) => idName(param)),
+            vars: scopeKeys(outer.vars),
+            freeVars: scopeKeys(outer.free_vars),
+            closVars: scopeKeys(outer.clos_vars),
+            escVars: scopeKeys(outer.esc_vars),
+            funcs: outer.funcs.map((fn) => functionHead(fn)),
+            firstAssignment: {
+                loc: locOf(assignment),
+                op: assignment.op,
+                left: summarizeAst(assignment.exprs[0]),
+                right: summarizeAst(assignment.exprs[1]),
+            },
+        },
+        inner: {
+            id: idName(inner.id),
+            params: inner.params.map((param) => idName(param)),
+            vars: scopeKeys(inner.vars),
+            freeVars: scopeKeys(inner.free_vars),
+            closVars: scopeKeys(inner.clos_vars),
+            escVars: scopeKeys(inner.esc_vars),
+            returnExpr: {
+                loc: locOf(innerReturn),
+                op: innerReturn.op,
+                exprs: innerReturn.exprs.map((expr) => summarizeAst(expr)),
+            },
+        },
+    };
+}
+
+function capturePrint(callback) {
+    const originalPrint = tachyon.print;
+    const lines = [];
+    tachyon.print = function (value) {
+        lines.push(String(value));
+    };
+
+    try {
+        const result = callback();
+        return { result: result, output: lines.join('\n') + (lines.length ? '\n' : '') };
+    } finally {
+        tachyon.print = originalPrint;
+    }
+}
+
+function renderPrettyAst(program) {
+    const originalPrint = tachyon.print;
+    const lines = [];
+    tachyon.print = function (value) {
+        lines.push(String(value));
+    };
+
+    try {
+        tachyon.pp(program);
+        return lines.join('\n') + (lines.length ? '\n' : '');
+    } finally {
+        tachyon.print = originalPrint;
+    }
+}
+
+function assertThrowsNormalAssertionError(callback) {
+
+    assert.throws(
+        callback,
+        (err) => err instanceof Error
+    );
+}
+
+function test(name, callback) {
+    callback();
+    process.stdout.write('ok - ' + name + '\n');
+}
+
+if (process.argv[2] === '--fresh-process-snapshot') {
+    process.stdout.write(JSON.stringify(
+        summarizeAst(tachyon.parse_src_str('var x = 1;', makeParams()))
+    ));
+    process.exit(0);
+}
