@@ -0,0 +1,28 @@
+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+
+npm install --ignore-scripts --no-audit --no-fund --legacy-peer-deps
+
+
+run_jest() {
+  local pattern="$1"
+  CI=1 ./node_modules/.bin/react-scripts test \
+    --env=jsdom \
+    --watchAll=false \
+    --testPathPattern="$pattern"
+}
+
+case "${1:-}" in
+  base)
+    run_jest "src/__tests__/(VariableSizeList|VariableSizeGrid)\\.js"
+    ;;
+  new)
+    run_jest "src/__tests__/(areEqual|shouldComponentUpdate)\\.js"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
