@@ -0,0 +1,129 @@
+import React, { memo } from 'react';
+import ReactTestRenderer from 'react-test-renderer';
+import { areEqual } from '..';
+
+describe('areEqual', () => {
+  it('is exported from the package entry', () => {
+    expect(typeof areEqual).toBe('function');
+  });
+
+  it('should not re-render when the style prop changes', () => {
+    const Component = jest.fn(() => null);
+    const MemoizedComponent = memo(Component, areEqual);
+    const renderer = ReactTestRenderer.create(
+      <MemoizedComponent style={{}} foo="abc" bar={123} />
+    );
+    expect(Component).toHaveBeenCalledTimes(1);
+
+    renderer.update(<MemoizedComponent style={{}} foo="abc" bar={123} />);
+    expect(Component).toHaveBeenCalledTimes(1);
+  });
+
+  it('should re-render when other props change', () => {
+    const Component = jest.fn(() => null);
+    const MemoizedComponent = memo(Component, areEqual);
+    const renderer = ReactTestRenderer.create(
+      <MemoizedComponent style={{}} foo="abc" bar={123} />
+    );
+    expect(Component).toHaveBeenCalledTimes(1);
+
+    renderer.update(<MemoizedComponent style={{}} foo="abc" bar={234} />);
+    expect(Component).toHaveBeenCalledTimes(2);
+  });
+
+  it('skips React.memo renders when item props are shallowly unchanged', () => {
+    const Component = jest.fn(() => null);
+    const MemoizedComponent = memo(Component, areEqual);
+    const itemData = { id: 1 };
+    const renderer = ReactTestRenderer.create(
+      <MemoizedComponent
+        data={itemData}
+        index={3}
+        label="row"
+        style={{ top: 10, height: 25, '--customOffset': 4 }}
+      />
+    );
+    expect(Component).toHaveBeenCalledTimes(1);
+
+    renderer.update(
+      <MemoizedComponent
+        data={itemData}
+        index={3}
+        label="row"
+        style={{ top: 10, height: 25, '--customOffset': 4 }}
+      />
+    );
+    expect(Component).toHaveBeenCalledTimes(1);
+  });
+
+  it('returns false when style contents change', () => {
+    const prevProps = { index: 0, style: { top: 10, height: 25 } };
+
+    expect(
+      areEqual(prevProps, { index: 0, style: { top: 11, height: 25 } })
+    ).toBe(false);
+    expect(
+      areEqual(prevProps, {
+        index: 0,
+        style: { top: 10, height: 25, width: 100 },
+      })
+    ).toBe(false);
+    expect(
+      areEqual(
+        { index: 0, style: { top: 10, height: 25, width: 100 } },
+        prevProps
+      )
+    ).toBe(false);
+    expect(
+      areEqual(
+        { index: 0, style: { top: 10, height: 25, '--customOffset': 4 } },
+        { index: 0, style: { top: 10, height: 25, '--customOffset': 5 } }
+      )
+    ).toBe(false);
+  });
+
+  it('returns false when non-style props change', () => {
+    expect(
+      areEqual(
+        { index: 1, style: { top: 0, height: 10 }, label: 'a' },
+        { index: 2, style: { top: 0, height: 10 }, label: 'a' }
+      )
+    ).toBe(false);
+    expect(
+      areEqual(
+        { index: 1, style: { top: 0, height: 10 }, label: 'a' },
+        { index: 1, style: { top: 0, height: 10 }, label: 'a', extra: true }
+      )
+    ).toBe(false);
+    expect(
+      areEqual(
+        { index: 1, style: { top: 0, height: 10 }, label: 'a', extra: true },
+        { index: 1, style: { top: 0, height: 10 }, label: 'a' }
+      )
+    ).toBe(false);
+  });
+
+  it('uses shallow comparison for nested values', () => {
+    const sharedStyleValue = { translateY: 10 };
+    const sharedData = { item: 'row' };
+
+    expect(
+      areEqual(
+        { data: sharedData, style: { transform: sharedStyleValue } },
+        { data: sharedData, style: { transform: sharedStyleValue } }
+      )
+    ).toBe(true);
+    expect(
+      areEqual(
+        { data: sharedData, style: { transform: { translateY: 10 } } },
+        { data: sharedData, style: { transform: { translateY: 10 } } }
+      )
+    ).toBe(false);
+    expect(
+      areEqual(
+        { data: { item: 'row' }, style: { top: 0 } },
+        { data: { item: 'row' }, style: { top: 0 } }
+      )
+    ).toBe(false);
+  });
+});
diff --git a/src/__tests__/shouldComponentUpdate.js b/src/__tests__/shouldComponentUpdate.js
new file mode 100644
index 0000000..4fcb692
