+++ b/src/__tests__/shouldComponentUpdate.js
@@ -0,0 +1,149 @@
+import React, { Component } from 'react';
+import ReactTestRenderer from 'react-test-renderer';
+import { shouldComponentUpdate } from '..';
+
+describe('shouldComponentUpdate', () => {
+  it('is exported from the package entry', () => {
+    expect(typeof shouldComponentUpdate).toBe('function');
+  });
+
+  it('should not re-render when the style prop changes', () => {
+    const render = jest.fn(() => null);
+
+    class ClassComponent extends Component {
+      shouldComponentUpdate = shouldComponentUpdate.bind(this);
+      render = render;
+    }
+
+    const renderer = ReactTestRenderer.create(
+      <ClassComponent style={{}} foo="abc" bar={123} />
+    );
+    expect(render).toHaveBeenCalledTimes(1);
+
+    renderer.update(<ClassComponent style={{}} foo="abc" bar={123} />);
+    expect(render).toHaveBeenCalledTimes(1);
+  });
+
+  it('should re-render when other props change', () => {
+    const render = jest.fn(() => null);
+
+    class ClassComponent extends Component {
+      shouldComponentUpdate = shouldComponentUpdate.bind(this);
+      render = render;
+    }
+
+    const renderer = ReactTestRenderer.create(
+      <ClassComponent style={{}} foo="abc" bar={123} />
+    );
+    expect(render).toHaveBeenCalledTimes(1);
+
+    renderer.update(<ClassComponent style={{}} foo="abc" bar={234} />);
+    expect(render).toHaveBeenCalledTimes(2);
+  });
+
+  it('skips class re-render when props compare equal and state is unchanged', () => {
+    const render = jest.fn(() => null);
+    const itemData = { id: 1 };
+
+    class ClassComponent extends Component {
+      state = { selected: false };
+      shouldComponentUpdate = shouldComponentUpdate.bind(this);
+      render = render;
+    }
+
+    const renderer = ReactTestRenderer.create(
+      <ClassComponent
+        data={itemData}
+        index={3}
+        label="row"
+        style={{ top: 10, height: 25, '--customOffset': 4 }}
+      />
+    );
+    expect(render).toHaveBeenCalledTimes(1);
+
+    renderer.update(
+      <ClassComponent
+        data={itemData}
+        index={3}
+        label="row"
+        style={{ top: 10, height: 25, '--customOffset': 4 }}
+      />
+    );
+    expect(render).toHaveBeenCalledTimes(1);
+  });
+
+  it('re-renders class component when props differ', () => {
+    const render = jest.fn(() => null);
+
+    class ClassComponent extends Component {
+      state = { selected: false };
+      shouldComponentUpdate = shouldComponentUpdate.bind(this);
+      render = render;
+    }
+
+    const renderer = ReactTestRenderer.create(
+      <ClassComponent
+        index={3}
+        label="row"
+        style={{ top: 10, height: 25 }}
+      />
+    );
+    expect(render).toHaveBeenCalledTimes(1);
+
+    renderer.update(
+      <ClassComponent
+        index={3}
+        label="updated row"
+        style={{ top: 10, height: 25 }}
+      />
+    );
+    expect(render).toHaveBeenCalledTimes(2);
+
+    renderer.update(
+      <ClassComponent
+        index={3}
+        label="updated row"
+        style={{ top: 12, height: 25 }}
+      />
+    );
+    expect(render).toHaveBeenCalledTimes(3);
+  });
+
+  it('returns true when state shallowly differs', () => {
+    const props = { index: 0, style: { top: 0, height: 10 }, label: 'row' };
+
+    expect(
+      shouldComponentUpdate.call(
+        { props, state: { count: 1 } },
+        { index: 0, style: { top: 0, height: 10 }, label: 'row' },
+        { count: 2 }
+      )
+    ).toBe(true);
+    expect(
+      shouldComponentUpdate.call(
+        { props, state: { count: 1 } },
+        { index: 0, style: { top: 0, height: 10 }, label: 'row' },
+        { count: 1, expanded: true }
+      )
+    ).toBe(true);
+    expect(
+      shouldComponentUpdate.call(
+        { props, state: { count: 1, expanded: true } },
+        { index: 0, style: { top: 0, height: 10 }, label: 'row' },
+        { count: 1 }
+      )
+    ).toBe(true);
+  });
+
+  it('returns false when state is shallowly equal', () => {
+    const props = { index: 0, style: { top: 0, height: 10 }, label: 'row' };
+
+    expect(
+      shouldComponentUpdate.call(
+        { props, state: { count: 1, expanded: false } },
+        { index: 0, style: { top: 0, height: 10 }, label: 'row' },
+        { count: 1, expanded: false }
+      )
+    ).toBe(false);
+  });
+});
