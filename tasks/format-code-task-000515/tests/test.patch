+async function searchFailuresResolveToEmptyArrays(): Promise<void> {
+    const controller = new LibraryController(
+        {searchTracks: () => { throw new TypeError('cache exploded'); }},
+        {},
+        {},
+        {},
+        {},
+        async () => ({}),
+        {}
+    );
+
+    assert.deepStrictEqual(await controller.search('anything'), []);
+
+    const calls = installWindowSearch(async (query) => {
+        throw new Error(`ipc failed for ${query}`);
+    });
+
+    assert.deepStrictEqual(await new LibraryDataService().searchLibrary('fail'), []);
+    assert.deepStrictEqual(await new LibraryService().searchLibrary('fail'), []);
+    assert.deepStrictEqual(await new LibraryAPI().searchLibrary('fail'), []);
+    assert.deepStrictEqual(await new LibraryAPI().searchLibrary('fail-again'), []);
+    assert.deepStrictEqual(calls, [
+        ['search', 'fail'],
+        ['search', 'fail'],
+        ['search', 'fail'],
+        ['search', 'fail-again']
+    ]);
+}
+
+test('cache-side and higher-level IPC search failures resolve to empty arrays', searchFailuresResolveToEmptyArrays);
