+async function cacheManagersKeepSearchStateIndependentAcrossInstances(): Promise<void> {
+    const a = await freshCacheManager();
+    const b = await freshCacheManager();
+
+    a.addTrack(
+        {title: 'Blue Monday', artist: 'New Order', album: 'Substance'},
+        '/music/blue-monday.flac',
+        mkStats(1000, 1700000000000)
+    );
+    a.addTrack(
+        {title: 'Around the World', artist: 'Daft Punk', album: 'Homework'},
+        '/music/around.mp3',
+        mkStats(2000, 1700000001000)
+    );
+    b.addTrack(
+        {title: 'Red Eyes', artist: 'The War on Drugs', album: 'Lost in the Dream'},
+        '/other/red-eyes.wav',
+        mkStats(4000, 1700000003000)
+    );
+
+    assert.deepStrictEqual(projectTracks(a.searchTracks('')), [
+        {title: 'Blue Monday', artist: 'New Order', album: 'Substance', fileName: 'blue-monday.flac'},
+        {title: 'Around the World', artist: 'Daft Punk', album: 'Homework', fileName: 'around.mp3'}
+    ]);
+    assert.deepStrictEqual(projectTracks(b.searchTracks('')), [
+        {title: 'Red Eyes', artist: 'The War on Drugs', album: 'Lost in the Dream', fileName: 'red-eyes.wav'}
+    ]);
+}
+
+test('cache managers keep search state independent across instances', cacheManagersKeepSearchStateIndependentAcrossInstances);
+
+
+
+async function repeatedSearchesDoNotStartWorkOrAccumulateResources(): Promise<void> {
+    const counters = {
+        scanDirectory: 0,
+        getTrackMetadata: 0,
+        updateTrackMetadata: 0,
+        addTrackToLibrary: 0,
+        loadCachedTracks: 0,
+        getTracks: 0
+    };
+    const calls: Array<[string, string]> = [];
+
+    (globalThis as any).window = {
+        electronAPI: {
+            library: {
+                search: async (query: string) => {
+                    calls.push(['search', query]);
+                    return searchApiTracks(query);
+                },
+                scanDirectory: async () => {
+                    counters.scanDirectory++;
+                    return false;
+                },
+                getTrackMetadata: async () => {
+                    counters.getTrackMetadata++;
+                    return null;
+                },
+                updateTrackMetadata: async () => {
+                    counters.updateTrackMetadata++;
+                    return null;
+                },
+                addTrackToLibrary: async () => {
+                    counters.addTrackToLibrary++;
+                    return {success: false};
+                },
+                loadCachedTracks: async () => {
+                    counters.loadCachedTracks++;
+                    return [];
+                },
+                getTracks: async () => {
+                    counters.getTracks++;
+                    return [];
+                }
+            }
+        }
+    };
+
+    for (let i = 0; i < 100; i++) {
+        assert.deepStrictEqual(projectIds(await new LibraryDataService().searchLibrary('order')), ['blue-id']);
+    }
+
+    assert.strictEqual(calls.length, 100);
+    assert.deepStrictEqual(counters, {
+        scanDirectory: 0,
+        getTrackMetadata: 0,
+        updateTrackMetadata: 0,
+        addTrackToLibrary: 0,
+        loadCachedTracks: 0,
+        getTracks: 0
+    });
+
+
+    const nonSearchWorkCount = Object.values(counters).reduce((sum, count) => sum + count, 0);
+    assert.strictEqual(nonSearchWorkCount, 0);
+}
+
+test('repeated searches do not scan parse write or accumulate Node resources', repeatedSearchesDoNotStartWorkOrAccumulateResources);
+
+async function run(): Promise<void> {
+    for (const {name, fn} of tests) {
+        await fn();
+        console.log(`ok - ${name}`);
+    }
+}
+
+run().catch((error: Error) => {
+    console.error(error);
+    process.exitCode = 1;
+});
