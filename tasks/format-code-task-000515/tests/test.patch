+async function preloadExposesLibrarySearchOnLibrarySearchIpcChannel(): Promise<void> {
+    const originalLoad = Module._load;
+    const calls: unknown[][] = [];
+    let exposedApi: any = null;
+
+    delete require.cache[require.resolve('../src/main/preload.ts')];
+    Module._load = function loadWithFakeElectron(request: string) {
+        if (request === 'electron') {
+            return {
+                contextBridge: {
+                    exposeInMainWorld: (name: string, api: unknown) => {
+                        calls.push(['exposeInMainWorld', name]);
+                        if (name === 'electronAPI') {
+                            exposedApi = api;
+                        }
+                    }
+                },
+                ipcRenderer: {
+                    invoke: async (...args: unknown[]) => {
+                        calls.push(['invoke', ...args]);
+                        return API_TRACKS;
+                    },
+                    on: () => {},
+                    removeListener: () => {}
+                }
+            };
+        }
+        return originalLoad.apply(this, arguments as any);
+    };
+
+    try {
+        require('../src/main/preload.ts');
+
+        assert.ok(calls.some((call) => call[0] === 'exposeInMainWorld' && call[1] === 'electronAPI'));
+        assert.strictEqual(typeof exposedApi?.library?.search, 'function');
+
+        calls.length = 0;
+        const result = await exposedApi.library.search('order');
+
+        assert.ok(Array.isArray(result));
+        assert.deepStrictEqual(projectIds(result), ['blue-id', 'around-id']);
+
+        assert.ok(calls.some((call) =>
+            call[0] === 'invoke' && call[1] === 'library:search' && call[2] === 'order'
+        ));
+    } finally {
+        Module._load = originalLoad;
+    }
+}
+
+test('preload exposes electronAPI.library.search on the library search IPC channel', preloadExposesLibrarySearchOnLibrarySearchIpcChannel);
