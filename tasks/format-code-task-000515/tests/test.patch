+async function publicSearchStackDelegatesConsistentlyToGatewaySearch(): Promise<void> {
+    const calls = installWindowSearch(searchApiTracks);
+
+    assert.deepStrictEqual(projectIds(await libraryGateway.search('')), ['blue-id', 'around-id']);
+    assert.deepStrictEqual(projectIds(await new LibraryDataService().searchLibrary('order')), ['blue-id']);
+    assert.deepStrictEqual(projectIds(await new LibraryService().searchLibrary('SUBSTANCE')), ['blue-id']);
+    assert.deepStrictEqual(projectIds(await new LibraryAPI().searchLibrary('around')), ['around-id']);
+    assert.deepStrictEqual(calls, [
+        ['search', ''],
+        ['search', 'order'],
+        ['search', 'SUBSTANCE'],
+        ['search', 'around']
+    ]);
+}
+
+test('public search stack delegates consistently to gateway search', publicSearchStackDelegatesConsistentlyToGatewaySearch);
