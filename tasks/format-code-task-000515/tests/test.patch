+
+function installAliasResolver(): void {
+    const originalResolve = Module._resolveFilename;
+    if ((Module as any).__coderlAliasResolverInstalled) {
+        return;
+    }
+
+    Module._resolveFilename = function resolveWithRendererAliases(
+        request: string,
+        parent: unknown,
+        isMain: boolean,
+        options: unknown
+    ) {
+        const aliases: Record<string, string> = {
+            '@/': path.join(process.cwd(), 'src/renderer/src/'),
+            '@api/': path.join(process.cwd(), 'src/renderer/src/api/'),
+            '@utils/': path.join(process.cwd(), 'src/renderer/src/utils/'),
+            '@ui/': path.join(process.cwd(), 'src/renderer/src/ui/'),
+            '@extensions/': path.join(process.cwd(), 'src/renderer/src/extensions/'),
+            '@styles/': path.join(process.cwd(), 'src/renderer/src/styles/'),
+            '@assets/': path.join(process.cwd(), 'src/renderer/src/assets/')
+        };
+
+        for (const [prefix, target] of Object.entries(aliases)) {
+            if (request.startsWith(prefix)) {
+                return originalResolve.call(
+                    this,
+                    path.join(target, request.slice(prefix.length)),
+                    parent,
+                    isMain,
+                    options
+                );
+            }
+        }
+
+        return originalResolve.call(this, request, parent, isMain, options);
+    };
+
+    (Module as any).__coderlAliasResolverInstalled = true;
+}
+
+installAliasResolver();
