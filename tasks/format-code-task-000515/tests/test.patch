+async function cacheSearchReturnsAllTracksForBlankQueriesInOrder(): Promise<void> {
+    const manager = await seededCacheManager();
+
+    assert.deepStrictEqual(projectTracks(manager.searchTracks('')), ALL_CACHE_TRACKS);
+    assert.deepStrictEqual(projectTracks(manager.searchTracks('   ')), ALL_CACHE_TRACKS);
+    assert.deepStrictEqual(projectTracks(manager.getAllTracks()), ALL_CACHE_TRACKS);
+}
+
+test('cache search returns all tracks for blank queries in cache order', cacheSearchReturnsAllTracksForBlankQueriesInOrder);
