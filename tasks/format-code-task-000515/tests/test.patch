+    fileId: 'blue-id',
+    title: 'Blue Monday',
+    artist: 'New Order',
+    album: 'Substance',
+    fileName: 'blue-monday.flac',
+    filePath: '/music/blue-monday.flac'
+};
+
+const AROUND_TRACK = {
+    fileId: 'around-id',
+    title: 'Around the World',
+    artist: 'Daft Punk',
+    album: 'Homework',
+    fileName: 'around.mp3',
+    filePath: '/music/around.mp3'
+};
+
+const SILENT_TRACK = {
+    fileId: 'silent-id',
+    title: 'Silent Shout',
+    artist: 'The Knife',
+    album: 'Deep Cuts',
+    fileName: 'knife.ogg',
+    filePath: '/music/knife.ogg'
+};
+
+const API_TRACKS = [BLUE_TRACK, AROUND_TRACK];
+
+const ALL_CACHE_TRACKS: TrackProjection[] = [
+    {title: 'Blue Monday', artist: 'New Order', album: 'Substance', fileName: 'blue-monday.flac'},
+    {title: 'Around the World', artist: 'Daft Punk', album: 'Homework', fileName: 'around.mp3'},
+    {title: 'Silent Shout', artist: 'The Knife', album: 'Deep Cuts', fileName: 'knife.ogg'}
+];
+
+const BLUE_ONLY: TrackProjection[] = [
+    {title: 'Blue Monday', artist: 'New Order', album: 'Substance', fileName: 'blue-monday.flac'}
+];
+
+const AROUND_ONLY: TrackProjection[] = [
+    {title: 'Around the World', artist: 'Daft Punk', album: 'Homework', fileName: 'around.mp3'}
+];
+
+function projectTracks(tracks: Array<Record<string, unknown>>): TrackProjection[] {
+    return tracks.map((track) => ({
+        title: track.title as string,
+        artist: track.artist as string,
+        album: track.album as string,
+        fileName: track.fileName as string
+    }));
+}
+
+function projectIds(tracks: Array<Record<string, unknown>>): string[] {
+    return tracks.map((track) => track.fileId as string);
+}
+
+function mkStats(size: number, ms: number): {size: number; mtime: Date} {
+    return {size, mtime: new Date(ms)};
+}
+
+async function freshCacheManager(): Promise<any> {
+    const manager = new LibraryCacheManager(null);
+    manager.saveCache = async () => {};
+    await manager.clearCache();
+    return manager;
+}
+
+async function seededCacheManager(): Promise<any> {
+    const manager = await freshCacheManager();
+    manager.addTracks([
+        {
+            trackData: {title: 'Blue Monday', artist: 'New Order', album: 'Substance'},
+            filePath: '/music/blue-monday.flac',
+            stats: mkStats(1000, 1700000000000)
+        },
+        {
+            trackData: {title: 'Around the World', artist: 'Daft Punk', album: 'Homework'},
+            filePath: '/music/around.mp3',
+            stats: mkStats(2000, 1700000001000)
+        },
+        {
+            trackData: {title: 'Silent Shout', artist: 'The Knife', album: 'Deep Cuts'},
+            filePath: '/music/knife.ogg',
+            stats: mkStats(3000, 1700000002000)
+        }
+    ]);
+    return manager;
+}
+
+function installWindowSearch(search: (query: string) => Promise<unknown[]>): Array<[string, string]> {
+    const calls: Array<[string, string]> = [];
+    (globalThis as any).window = {
+        electronAPI: {
+            library: {
+                search: async (query: string) => {
+                    calls.push(['search', query]);
+                    return search(query);
+                },
+                scanDirectory: async () => {
+                    throw new Error('scanDirectory must not be called by search');
+                },
+                getTrackMetadata: async () => {
+                    throw new Error('getTrackMetadata must not be called by search');
+                },
+                updateTrackMetadata: async () => {
+                    throw new Error('updateTrackMetadata must not be called by search');
+                },
+                addTrackToLibrary: async () => {
+                    throw new Error('addTrackToLibrary must not be called by search');
+                },
+                loadCachedTracks: async () => {
+                    throw new Error('loadCachedTracks must not be called by search');
+                },
+                getTracks: async () => {
+                    throw new Error('getTracks must not be called by search');
+                }
+            }
+        }
+    };
+    return calls;
+}
+
+function searchApiTracks(query: string): Promise<unknown[]> {
+    if (!query.trim()) {
+        return Promise.resolve(API_TRACKS);
+    }
+
+    const term = query.toLowerCase();
+    return Promise.resolve(API_TRACKS.filter((track) =>
+        track.title.toLowerCase().includes(term) ||
+        track.artist.toLowerCase().includes(term) ||
+        track.album.toLowerCase().includes(term) ||
+        track.fileName.toLowerCase().includes(term)
+    ));
+}
