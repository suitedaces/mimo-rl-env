diff --git a/usercase-test-coderl/test_market_data_requests.py b/usercase-test-coderl/test_market_data_requests.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_market_data_requests.py
@@ -0,0 +1,319 @@
+
+
+
+
+
+
+
+
+
+from __future__ import annotations
+
+import warnings
+
+import pytest
+import quickfix as fix
+
+warnings.filterwarnings("ignore", category=DeprecationWarning)
+
+FIXTURES = "/workspace/repo/usercase-test-coderl/fixtures"
+QUOTE_SESSION = "FIX.4.4:*******->FIXUAT3-QUOTE.FORTEX.COM:******"
+QUOTE_TARGET = "FIXUAT3-QUOTE.FORTEX.COM"
+
+
+def _patch_quickfix_constants() -> None:
+
+
+
+    if not hasattr(fix, "SubscriptionRequestType_SNAPSHOT_PLUS_UPDATES"):
+        fix.SubscriptionRequestType_SNAPSHOT_PLUS_UPDATES = "1"
+    if not hasattr(
+        fix, "SubscriptionRequestType_DISABLE_PREVIOUS_SNAPSHOT_PLUS_UPDATE_REQUEST"
+    ):
+        fix.SubscriptionRequestType_DISABLE_PREVIOUS_SNAPSHOT_PLUS_UPDATE_REQUEST = "2"
+
+
+_patch_quickfix_constants()
+
+from fixapp import DataStream, FixDecoder, OrderStore, Tier1FXAuto  # noqa: E402
+
+
+def _settings() -> fix.SessionSettings:
+    return fix.SessionSettings(f"{FIXTURES}/quickfix_two_sessions.cfg")
+
+
+def _configured_client() -> Tier1FXAuto:
+    settings = _settings()
+    client = Tier1FXAuto(DataStream(), FixDecoder(), OrderStore(), settings)
+    for session_id in settings.getSessions():
+        client.onCreate(session_id)
+    return client
+
+
+def _capture_send(
+    monkeypatch: pytest.MonkeyPatch,
+) -> list[tuple[fix.Message, object | None]]:
+    sent: list[tuple[fix.Message, object | None]] = []
+
+    def capture(message: fix.Message, session_id: object | None = None) -> bool:
+        sent.append((message, session_id))
+        return True
+
+    monkeypatch.setattr(fix.Session, "sendToTarget", capture)
+    return sent
+
+
+def _assert_sent_to_quote_session(
+    message: fix.Message, session_id: object | None
+) -> None:
+    if session_id is not None:
+        assert session_id.toString() == QUOTE_SESSION
+        return
+
+
+    assert message.getHeader().getField(56) == QUOTE_TARGET
+
+
+def _field_snapshot(message: fix.Message) -> dict[str, object]:
+    entry_group = fix.Group(267, 269)
+    entry_values: list[str] = []
+    for index in (1, 2):
+        message.getGroup(index, entry_group)
+        entry_values.append(entry_group.getField(269))
+
+    symbol_group = fix.Group(146, 55)
+    message.getGroup(1, symbol_group)
+
+    return {
+        "35": message.getHeader().getField(35),
+        "262": message.getField(262),
+        "263": message.getField(263),
+        "264": message.getField(264),
+        "265": message.getField(265),
+        "267": message.getField(267),
+        "269_groups": entry_values,
+        "146": message.getField(146),
+        "55_groups": [symbol_group.getField(55)],
+    }
+
+
+def _assert_market_data_request(
+    message: fix.Message,
+    *,
+    subscription_type: str,
+    market_depth: str = "1",
+    update_type: str = "0",
+    entry_count: str = "2",
+    symbol: str = "EUR/USD",
+) -> None:
+    snapshot = _field_snapshot(message)
+
+    assert snapshot["35"] == "V"
+
+    assert isinstance(snapshot["262"], str) and snapshot["262"].strip() != ""
+    assert snapshot["263"] == subscription_type
+    assert snapshot["264"] == market_depth
+    assert snapshot["265"] == update_type
+    assert snapshot["267"] == entry_count
+
+    assert set(snapshot["269_groups"]) == {"0", "1"}
+    assert snapshot["146"] == "1"
+    assert snapshot["55_groups"] == [symbol]
+
+
+def test_subscribe_to_data_sends_default_market_data_request(monkeypatch):
+
+
+
+
+    client = _configured_client()
+    sent = _capture_send(monkeypatch)
+
+    client.subscribe_to_data(**{"55": "EUR/USD"})
+
+    assert len(sent) == 1
+    message, session_id = sent[0]
+    _assert_sent_to_quote_session(message, session_id)
+
+    _assert_market_data_request(message, subscription_type="1", symbol="EUR/USD")
+
+
+def test_unsubscribe_to_data_sends_disable_request(monkeypatch):
+
+
+
+
+    client = _configured_client()
+    sent = _capture_send(monkeypatch)
+
+    client.unsubscribe_to_data(**{"55": "EUR/USD"})
+
+    assert len(sent) == 1
+    message, session_id = sent[0]
+    _assert_sent_to_quote_session(message, session_id)
+
+    _assert_market_data_request(message, subscription_type="2", symbol="EUR/USD")
+
+
+def test_subscribe_omitted_symbol_defaults_to_eur_usd(monkeypatch):
+
+
+
+
+    client = _configured_client()
+    sent = _capture_send(monkeypatch)
+
+    client.subscribe_to_data()
+
+    assert len(sent) == 1
+    message, session_id = sent[0]
+    _assert_sent_to_quote_session(message, session_id)
+
+    _assert_market_data_request(message, subscription_type="1", symbol="EUR/USD")
+
+
+def test_subscribe_reflects_market_data_option_overrides(monkeypatch):
+
+
+
+
+    client = _configured_client()
+    sent = _capture_send(monkeypatch)
+
+    client.subscribe_to_data(**{"55": "GBP/USD", "264": "0", "267": "2", "265": 1})
+
+    assert len(sent) == 1
+    message, session_id = sent[0]
+    _assert_sent_to_quote_session(message, session_id)
+
+    _assert_market_data_request(
+        message,
+        subscription_type="1",
+        market_depth="0",
+        update_type="1",
+        entry_count="2",
+        symbol="GBP/USD",
+    )
+
+
+def test_same_client_advances_generated_market_data_request_ids(monkeypatch):
+
+
+
+
+    client = _configured_client()
+    sent = _capture_send(monkeypatch)
+
+    client.subscribe_to_data(**{"55": "EUR/USD"})
+    client.unsubscribe_to_data(**{"55": "EUR/USD"})
+    client.subscribe_to_data(**{"55": "GBP/USD"})
+
+    assert len(sent) == 3
+
+    generated_ids = [message.getField(262) for message, _ in sent]
+    assert all(value.strip() for value in generated_ids)
+    assert len(set(generated_ids)) == len(generated_ids)
+    assert [message.getField(263) for message, _ in sent] == ["1", "2", "1"]
+    symbols = []
+    for message, _ in sent:
+        symbol_group = fix.Group(146, 55)
+        message.getGroup(1, symbol_group)
+        symbols.append(symbol_group.getField(55))
+    assert symbols == [
+        "EUR/USD",
+        "EUR/USD",
+        "GBP/USD",
+    ]
+
+
+@pytest.mark.parametrize("method_name", ["subscribe_to_data", "unsubscribe_to_data"])
+@pytest.mark.parametrize("bad_kwargs", [{"264": "not-an-int"}, {"267": "not-an-int"}])
+def test_non_integer_market_data_counts_raise_value_error_without_send(
+    monkeypatch, method_name, bad_kwargs
+):
+
+
+
+
+    client = _configured_client()
+    sent = _capture_send(monkeypatch)
+
+    with pytest.raises(ValueError):
+        getattr(client, method_name)(**bad_kwargs)
+
+    assert sent == []
+
+
+def test_configured_client_exposes_public_market_data_methods():
+
+
+
+
+    client = _configured_client()
+
+
+    assert callable(getattr(client, "subscribe_to_data", None))
+    assert callable(getattr(client, "unsubscribe_to_data", None))
+
+
+def test_two_configured_clients_emit_generated_market_data_request_ids(monkeypatch):
+
+
+
+
+    client_a = _configured_client()
+    client_b = _configured_client()
+    sent = _capture_send(monkeypatch)
+
+    client_a.subscribe_to_data(**{"55": "EUR/USD"})
+    client_a.subscribe_to_data(**{"55": "EUR/USD"})
+    client_b.subscribe_to_data(**{"55": "EUR/USD"})
+
+    assert len(sent) == 3
+
+    generated_ids = [message.getField(262) for message, _ in sent]
+    assert all(value.strip() for value in generated_ids)
+
+
+def test_unsubscribe_reflects_market_data_option_overrides(monkeypatch):
+
+
+
+
+    client = _configured_client()
+    sent = _capture_send(monkeypatch)
+
+    client.unsubscribe_to_data(**{"55": "GBP/USD", "264": "0", "267": "2", "265": 1})
+
+    assert len(sent) == 1
+    message, session_id = sent[0]
+    _assert_sent_to_quote_session(message, session_id)
+
+    _assert_market_data_request(
+        message,
+        subscription_type="2",
+        market_depth="0",
+        update_type="1",
+        entry_count="2",
+        symbol="GBP/USD",
+    )
+
+
+def test_repeated_construct_use_cycles_send_one_market_data_request_each(monkeypatch):
+
+
+
+
+    sent = _capture_send(monkeypatch)
+
+    for _ in range(10):
+        client = _configured_client()
+        before = len(sent)
+        client.subscribe_to_data(**{"55": "EUR/USD"})
+        assert len(sent) == before + 1
+        message, session_id = sent[-1]
+        _assert_sent_to_quote_session(message, session_id)
+
+        _assert_market_data_request(message, subscription_type="1", symbol="EUR/USD")
+
+    assert len(sent) == 10
