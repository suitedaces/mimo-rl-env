diff --git a/test-data/unit/check-classes.test b/test-data/unit/check-classes.test
index a6ae963d6..00234a651 100644
--- a/test-data/unit/check-classes.test
+++ b/test-data/unit/check-classes.test
@@ -8120,3 +8120,60 @@ class C:
     def f(self) -> None:
         __module__  # E: Name "__module__" is not defined
         __qualname__  # E: Name "__qualname__" is not defined
+
+[case testOverrideStaticMethodAgainstCallableUnionOK]
+from typing import Callable, Union
+
+class Parent:
+    foo: Union[Callable[[str], str], str]
+
+class Child1(Parent):
+    foo = "bar"
+
+class Child2(Parent):
+    @staticmethod
+    def foo(x: str) -> str:
+        return x
+[builtins fixtures/staticmethod.pyi]
+
+[case testOverrideStaticMethodAgainstCallableNoUnionOK]
+from typing import Callable
+
+class Parent:
+    foo: Callable[[str], str]
+
+class Child2(Parent):
+    @staticmethod
+    def foo(x: str) -> str:
+        return x
+[builtins fixtures/staticmethod.pyi]
+
+[case testOverrideStaticMethodAgainstCallableUnionIncompatibleSignature]
+from typing import Callable, Union
+
+class Parent:
+    foo: Union[Callable[[str], str], str]
+
+class Child(Parent):
+    @staticmethod
+    def foo(x: int) -> str:  # E: Signature of "foo" incompatible with supertype "Parent" \
+                             # N:      Superclass: \
+                             # N:          Union[Callable[[str], str], str] \
+                             # N:      Subclass: \
+                             # N:          @staticmethod \
+                             # N:          def foo(x: int) -> str
+        return ""
+[builtins fixtures/staticmethod.pyi]
+
+[case testOverrideStaticMethodAgainstCallableUnionMutableOverride]
+# flags: --enable-error-code=mutable-override
+from typing import Callable, Union
+
+class Parent:
+    foo: Union[Callable[[str], str], str]
+
+class Child(Parent):
+    @staticmethod
+    def foo(x: str) -> str:  # E: Covariant override of a mutable attribute (base class "Parent" defined the type as "Union[Callable[[str], str], str]", override has type "Callable[[str], str]")
+        return x
+[builtins fixtures/staticmethod.pyi]
