+import React, {useState} from 'react';
+import {mountWithApp} from 'tests/utilities';
+
+import {DatePicker, DatePickerProps} from '../DatePicker';
+
+interface ControlledPickerProps
+  extends Omit<DatePickerProps, 'month' | 'year' | 'onMonthChange'> {
+  initialMonth: number;
+  initialYear: number;
+  onMonthChange: jest.Mock;
+}
+
+function ControlledPicker({
+  initialMonth,
+  initialYear,
+  onMonthChange,
+  ...props
+}: ControlledPickerProps) {
+  const [display, setDisplay] = useState({
+    month: initialMonth,
+    year: initialYear,
+  });
+
+  return (
+    <DatePicker
+      {...props}
+      id="keyboard-date-picker"
+      month={display.month}
+      year={display.year}
+      onMonthChange={(month, year) => {
+        onMonthChange(month, year);
+        setDisplay({month, year});
+      }}
+    />
+  );
+}
+
+function dayButton(datePicker: any, day: number, monthIndex = 0) {
+  const month = datePicker.findAll('table')[monthIndex];
+  const button = month
+    ?.findAll('button')
+    .find((candidate: any) => candidate.text() === String(day));
+
+  if (!button) {
+    throw new Error(`Could not find day ${day} in rendered month ${monthIndex}`);
+  }
+
+  return button;
+}
+
+function focusDay(datePicker: any, day: number, monthIndex = 0) {
+  const button = dayButton(datePicker, day, monthIndex);
+  button.domNode!.focus();
+  button.trigger('onFocus');
+  return button;
+}
+
+function pressKey(
+  datePicker: any,
+  key: string,
+  options: {shiftKey?: boolean} = {},
+) {
+  const target = document.activeElement;
+  if (!(target instanceof HTMLElement)) {
+    throw new Error('Keyboard navigation requires a focused day');
+  }
+
+  datePicker.act(() => {
+    target.dispatchEvent(
+      new KeyboardEvent('keyup', {
+        key,
+        shiftKey: Boolean(options.shiftKey),
+        bubbles: true,
+        cancelable: true,
+      }),
+    );
+  });
+}
+
+describe('<DatePicker /> keyboard navigation verifier', () => {
+  afterEach(() => {
+    (document.activeElement as HTMLElement | null)?.blur();
+  });
+
+  it('moves by days and weeks while skipping consecutive disabled dates in the direction of travel', () => {
+    const onChange = jest.fn();
+    const datePicker = mountWithApp(
+      <DatePicker
+        id="keyboard-date-picker"
+        month={4}
+        year={2022}
+        onChange={onChange}
+        disableSpecificDates={[
+          new Date(2022, 4, 11),
+          new Date(2022, 4, 12),
+          new Date(2022, 4, 18),
+          new Date(2022, 4, 19),
+          new Date(2022, 4, 23),
+          new Date(2022, 4, 24),
+          new Date(2022, 4, 25),
+        ]}
+      />,
+    );
+
+    focusDay(datePicker, 10);
+    pressKey(datePicker, 'ArrowRight');
+    expect(document.activeElement).toBe(dayButton(datePicker, 13).domNode);
+
+    pressKey(datePicker, 'ArrowLeft');
+    expect(document.activeElement).toBe(dayButton(datePicker, 10).domNode);
+
+    focusDay(datePicker, 16);
+    pressKey(datePicker, 'ArrowDown');
+    expect(document.activeElement).toBe(dayButton(datePicker, 26).domNode);
+
+    pressKey(datePicker, 'ArrowUp');
+    expect(document.activeElement).toBe(dayButton(datePicker, 17).domNode);
+    expect(onChange).not.toHaveBeenCalled();
+  });
+
+  it('moves Home and End to the configured calendar week boundaries', () => {
+    const datePicker = mountWithApp(
+      <DatePicker
+        id="keyboard-date-picker"
+        month={4}
+        year={2022}
+        weekStartsOn={1}
+      />,
+    );
+
+    focusDay(datePicker, 18);
+    pressKey(datePicker, 'Home');
+    expect(document.activeElement).toBe(dayButton(datePicker, 16).domNode);
+
+    focusDay(datePicker, 18);
+    pressKey(datePicker, 'End');
+    expect(document.activeElement).toBe(dayButton(datePicker, 22).domNode);
+  });
+
+  it.each([
+    ['PageDown', 0, 2022, 31, 1, 2022, 28],
+    ['PageUp', 2, 2022, 31, 1, 2022, 28],
+  ])(
+    '%s moves one month, clamps the day, requests the new display, and focuses the destination',
+    (key, initialMonth, initialYear, startDay, targetMonth, targetYear, targetDay) => {
+      const onMonthChange = jest.fn();
+      const datePicker = mountWithApp(
+        <ControlledPicker
+          initialMonth={initialMonth as number}
+          initialYear={initialYear as number}
+          onMonthChange={onMonthChange}
+        />,
+      );
+
+      focusDay(datePicker, startDay as number);
+      pressKey(datePicker, key as string);
+
+      expect(onMonthChange).toHaveBeenCalledTimes(1);
+      expect(onMonthChange).toHaveBeenCalledWith(targetMonth, targetYear);
+      expect(document.activeElement).toBe(
+        dayButton(datePicker, targetDay as number).domNode,
+      );
+    },
+  );
+
+  it.each([
+    ['PageDown', 2020, 2021],
+    ['PageUp', 2020, 2019],
+  ])(
+    'Shift+%s moves one year and clamps leap day to the last valid day',
+    (key, initialYear, targetYear) => {
+      const onMonthChange = jest.fn();
+      const datePicker = mountWithApp(
+        <ControlledPicker
+          initialMonth={1}
+          initialYear={initialYear as number}
+          onMonthChange={onMonthChange}
+        />,
+      );
+
+      focusDay(datePicker, 29);
+      pressKey(datePicker, key as string, {shiftKey: true});
+
+      expect(onMonthChange).toHaveBeenCalledWith(1, targetYear);
+      expect(document.activeElement).toBe(dayButton(datePicker, 28).domNode);
+    },
+  );
+
+  it('does not request a month change when a destination is already visible in multi-month mode', () => {
+    const onMonthChange = jest.fn();
+    const datePicker = mountWithApp(
+      <DatePicker
+        id="keyboard-date-picker"
+        month={0}
+        year={2022}
+        multiMonth
+        onMonthChange={onMonthChange}
+      />,
+    );
+
+    focusDay(datePicker, 31);
+    pressKey(datePicker, 'PageDown');
+
+    expect(document.activeElement).toBe(dayButton(datePicker, 28, 1).domNode);
+    expect(onMonthChange).not.toHaveBeenCalled();
+  });
+
+  it('requests the destination month after arrow navigation crosses a year boundary', () => {
+    const onMonthChange = jest.fn();
+    const datePicker = mountWithApp(
+      <ControlledPicker
+        initialMonth={11}
+        initialYear={2022}
+        onMonthChange={onMonthChange}
+      />,
+    );
+
+    focusDay(datePicker, 31);
+    pressKey(datePicker, 'ArrowRight');
+
+    expect(onMonthChange).toHaveBeenCalledWith(0, 2023);
+    expect(document.activeElement).toBe(dayButton(datePicker, 1).domNode);
+  });
+
+  it.each([
+    ['ArrowLeft', 10, {disableDatesBefore: new Date(2022, 4, 10)}],
+    ['ArrowRight', 20, {disableDatesAfter: new Date(2022, 4, 20)}],
+  ])(
+    'keeps focus in place at the disabled range boundary for %s',
+    (key, boundaryDay, disabledProps) => {
+      const onChange = jest.fn();
+      const onMonthChange = jest.fn();
+      const datePicker = mountWithApp(
+        <DatePicker
+          {...disabledProps}
+          id="keyboard-date-picker"
+          month={4}
+          year={2022}
+          onChange={onChange}
+          onMonthChange={onMonthChange}
+        />,
+      );
+
+      const boundary = focusDay(datePicker, boundaryDay as number);
+      pressKey(datePicker, key as string);
+
+      expect(document.activeElement).toBe(boundary.domNode);
+      expect(onChange).not.toHaveBeenCalled();
+      expect(onMonthChange).not.toHaveBeenCalled();
+    },
+  );
+
+});
