diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,42 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+dev-switch node 20
+
+
+apt-get install -y -qq libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
+  libxcomposite1 libxdamage1 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 \
+  libasound2t64 libnspr4 libnss3 libxshmfence1 libxfixes3 libgtk-3-0 2>/dev/null || true
+
+
+npm install --legacy-peer-deps 2>&1 | tail -5
+
+
+sed -i 's/statements.push.apply(statements, tslib_1.__spread(c.statements));/if (c.statements) { statements.push.apply(statements, tslib_1.__spread(c.statements)); }/' \
+  node_modules/@angular/compiler-cli/ngcc/src/rendering/renderer.js
+
+
+npm install tslib@2.0.3 --legacy-peer-deps 2>&1 | tail -3
+
+
+rm -rf node_modules/.cache
+npx ngcc --properties es2015 browser module main --first-only --create-ivy-entry-points 2>&1 | tail -5
+
+export NODE_OPTIONS=--openssl-legacy-provider
+
+
+case "${1:-}" in
+  base)
+    node node_modules/.bin/ng test --no-watch --no-progress --browsers=ChromeHeadlessCI --include='**/modal.spec.ts'
+    ;;
+  new)
+    node node_modules/.bin/ng test --no-watch --no-progress --browsers=ChromeHeadlessCI --include='**/modal.spec.ts'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
