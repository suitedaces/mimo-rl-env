+func readRPCRequest(t *testing.T, r *http.Request) capturedRequest {
+	t.Helper()
+	bodyBytes, err := io.ReadAll(r.Body)
+	if err != nil {
+		t.Fatalf("io.ReadAll request body error = %v, want nil", err)
+	}
+	var body map[string]interface{}
+	if err := json.Unmarshal(bodyBytes, &body); err != nil {
+		t.Fatalf("json.Unmarshal request body error = %v, want nil; body=%q", err, string(bodyBytes))
+	}
+	return capturedRequest{
+		method:      r.Method,
+		path:        r.URL.Path,
+		contentType: r.Header.Get("Content-Type"),
+		body:        body,
+	}
+}
+
+func writeRPCResult(t *testing.T, w http.ResponseWriter, result string) {
+	t.Helper()
+	w.Header().Set("Content-Type", "application/json")
+	if _, err := fmt.Fprintf(w, `{"jsonrpc":"2.0","id":"fixed","result":%q}`, result); err != nil {
+		t.Fatalf("write response error = %v, want nil", err)
+	}
+}
+
+func assertRequest(t *testing.T, captured capturedRequest, wantPath string, wantParams map[string]string) {
+	t.Helper()
+	if captured.method != http.MethodPost {
+		t.Fatalf("HTTP method = %q, want %q", captured.method, http.MethodPost)
+	}
+	if captured.path != wantPath {
+		t.Fatalf("HTTP path = %q, want %q", captured.path, wantPath)
+	}
+
+	mediaType, _, err := mime.ParseMediaType(captured.contentType)
+	if err != nil || mediaType != "application/json" {
+		t.Fatalf("Content-Type = %q, want media type %q", captured.contentType, "application/json")
+	}
+	if got, want := captured.body["jsonrpc"], "2.0"; got != want {
+		t.Fatalf("jsonrpc = %#v, want %#v", got, want)
+	}
+	if got, want := captured.body["method"], "eth_signTransaction"; got != want {
+		t.Fatalf("method = %#v, want %#v", got, want)
+	}
+
+	assertSpecParams(t, extractParams(t, captured.body), wantParams)
+}
+
+func extractParams(t *testing.T, body map[string]interface{}) map[string]string {
+	t.Helper()
+	params, ok := body["params"].([]interface{})
+	if !ok {
+		t.Fatalf("params = %#v, want one-element array", body["params"])
+	}
+	if len(params) != 1 {
+		t.Fatalf("len(params) = %d, want 1", len(params))
+	}
+	paramObj, ok := params[0].(map[string]interface{})
+	if !ok {
+		t.Fatalf("params[0] = %#v, want object", params[0])
+	}
+	got := make(map[string]string, len(paramObj))
+	for k, v := range paramObj {
+		value, ok := v.(string)
+		if !ok {
+			if isRequiredParamKey(k) {
+				t.Fatalf("params[0][%q] = %#v, want string", k, v)
+			}
+			continue
+		}
+		got[k] = value
+	}
+	return got
+}
+
+func isRequiredParamKey(key string) bool {
+	switch key {
+	case "from", "to", "gas", "gasPrice", "nonce", "data":
+		return true
+	default:
+		return false
+	}
+}
+
+func assertSpecParams(t *testing.T, gotParams map[string]string, wantParams map[string]string) {
+	t.Helper()
+	for _, key := range []string{"from", "to", "gas", "gasPrice", "nonce", "data"} {
+		got, ok := gotParams[key]
+		if !ok {
+			t.Fatalf("params[0] missing required key %q in %#v", key, gotParams)
+		}
+		want := wantParams[key]
+		switch key {
+		case "from", "to":
+			assertAddressParam(t, key, got, want)
+		case "gas", "gasPrice", "nonce":
+			assertQuantityParam(t, key, got, want)
+		case "data":
+			assertDataParam(t, key, got, want)
+		}
+	}
+}
+
+func assertAddressParam(t *testing.T, key string, got string, want string) {
+	t.Helper()
+	if !common.IsHexAddress(got) {
+		t.Fatalf("params[0][%q] = %q, want 0x-prefixed address hex", key, got)
+	}
+	if common.HexToAddress(got) != common.HexToAddress(want) {
+		t.Fatalf("params[0][%q] = %q, want address %q", key, got, want)
+	}
+}
+
+func assertQuantityParam(t *testing.T, key string, got string, want string) {
+	t.Helper()
+	gotValue := parseHexQuantity(t, key, got)
+	wantValue := parseHexQuantity(t, key, want)
+	if gotValue.Cmp(wantValue) != 0 {
+		t.Fatalf("params[0][%q] = %q, want quantity %q", key, got, want)
+	}
+}
+
+func parseHexQuantity(t *testing.T, key string, value string) *big.Int {
+	t.Helper()
+	if !strings.HasPrefix(value, "0x") {
+		t.Fatalf("params[0][%q] = %q, want 0x-prefixed hex quantity", key, value)
+	}
+	digits := strings.TrimPrefix(value, "0x")
+	if digits == "" {
+		return new(big.Int)
+	}
+	n, ok := new(big.Int).SetString(digits, 16)
+	if !ok {
+		t.Fatalf("params[0][%q] = %q, want valid hex quantity", key, value)
+	}
+	return n
+}
+
+func assertDataParam(t *testing.T, key string, got string, want string) {
+	t.Helper()
+	gotBytes := parseHexBytes(t, key, got)
+	wantBytes := parseHexBytes(t, key, want)
+	if !bytes.Equal(gotBytes, wantBytes) {
+		t.Fatalf("params[0][%q] = %q, want data %q", key, got, want)
+	}
+}
+
+func parseHexBytes(t *testing.T, key string, value string) []byte {
+	t.Helper()
+	if !strings.HasPrefix(value, "0x") {
+		t.Fatalf("params[0][%q] = %q, want 0x-prefixed hex data", key, value)
+	}
+	bytes, err := hex.DecodeString(strings.TrimPrefix(value, "0x"))
+	if err != nil {
+		t.Fatalf("params[0][%q] = %q, want valid hex data", key, value)
+	}
+	return bytes
+}
+
+func assertSignedTx(t *testing.T, tx *types.Transaction, wantRaw string, wantHash string) {
+	t.Helper()
+	if got := mustMarshalHex(t, tx); got != wantRaw {
+		t.Fatalf("signed tx raw = %q, want %q", got, wantRaw)
+	}
+	if got := tx.Hash().Hex(); got != wantHash {
+		t.Fatalf("signed tx hash = %q, want %q", got, wantHash)
+	}
+	from, err := types.Sender(types.LatestSignerForChainID(big.NewInt(chainIDValue)), tx)
+	if err != nil {
+		t.Fatalf("types.Sender error = %v, want nil", err)
+	}
+	if got := from.Hex(); got != senderHex {
+		t.Fatalf("recovered sender = %q, want %q", got, senderHex)
+	}
+}
+
+func mustMarshalHex(t *testing.T, tx *types.Transaction) string {
+	t.Helper()
+	raw, err := tx.MarshalBinary()
+	if err != nil {
+		t.Fatalf("tx.MarshalBinary error = %v, want nil", err)
+	}
+	return "0x" + hex.EncodeToString(raw)
+}
+
+func mustDecodeTx(t *testing.T, rawHex string) *types.Transaction {
+	t.Helper()
+	raw := common.FromHex(rawHex)
+	var tx types.Transaction
+	if err := tx.UnmarshalBinary(raw); err != nil {
+		t.Fatalf("tx.UnmarshalBinary(%q) error = %v, want nil", rawHex, err)
+	}
+	return &tx
+}
