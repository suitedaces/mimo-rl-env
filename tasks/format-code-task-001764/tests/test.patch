+func TestWeb3SignerFnPostsExpectedJSONRPCAndDecodesPrefixedResult(t *testing.T) {
+
+
+	var calls atomic.Int32
+	var captured capturedRequest
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		captured = readRPCRequest(t, r)
+		writeRPCResult(t, w, primarySignedRaw)
+	}))
+	defer server.Close()
+
+	signer, err := signerv2.Web3SignerFn(server.URL)
+	if err != nil {
+		t.Fatalf("Web3SignerFn error = %v, want nil", err)
+	}
+	if got := calls.Load(); got != 0 {
+		t.Fatalf("setup HTTP calls = %d, want 0", got)
+	}
+
+	signedTx, err := signer(common.HexToAddress(senderHex), primaryTx())
+	if err != nil {
+		t.Fatalf("signer error = %v, want nil", err)
+	}
+
+	assertRequest(t, captured, "/", map[string]string{
+		"from":     senderHex,
+		"to":       "0x1111111111111111111111111111111111111111",
+		"gas":      "0x5248",
+		"gasPrice": "0x04a817c800",
+		"nonce":    "0x7",
+		"data":     "0xabcdef0123",
+	})
+	assertSignedTx(t, signedTx, primarySignedRaw, primaryHash)
+	if got := calls.Load(); got != 1 {
+		t.Fatalf("signing HTTP calls = %d, want 1", got)
+	}
+}
