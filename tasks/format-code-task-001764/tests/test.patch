+func TestWeb3SignerUnreachableURLReturnsURLPostError(t *testing.T) {
+
+
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("net.Listen error = %v, want nil", err)
+	}
+	deadURL := "http://" + listener.Addr().String()
+	if err := listener.Close(); err != nil {
+		t.Fatalf("listener.Close error = %v, want nil", err)
+	}
+
+	signer, err := signerv2.Web3SignerFn(deadURL)
+	if err != nil {
+		t.Fatalf("Web3SignerFn error = %v, want nil", err)
+	}
+	_, err = signer(common.HexToAddress(senderHex), primaryTx())
+	if err == nil {
+		t.Fatal("signer error = nil, want *url.Error")
+	}
+	var urlErr *url.Error
+	if !errors.As(err, &urlErr) {
+		t.Fatalf("error type = %T, want *url.Error", err)
+	}
+	if urlErr.Op != "Post" {
+		t.Fatalf("url error op = %q, want %q", urlErr.Op, "Post")
+	}
+	if urlErr.URL != deadURL {
+		t.Fatalf("url error URL = %q, want %q", urlErr.URL, deadURL)
+	}
+}
