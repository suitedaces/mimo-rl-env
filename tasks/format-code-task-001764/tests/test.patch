+	signer, err := factory(context.Background(), common.HexToAddress(senderHex))
+	if err != nil {
+		t.Fatalf("factory error = %v, want nil", err)
+	}
+	if got := calls.Load(); got != 0 {
+		t.Fatalf("factory setup HTTP calls = %d, want 0", got)
+	}
