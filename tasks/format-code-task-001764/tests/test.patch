+func TestWeb3SignerReferentialTransparencyForSameInput(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		writeRPCResult(t, w, primarySignedRaw)
+	}))
+	defer server.Close()
+
+	signer, err := signerv2.Web3SignerFn(server.URL)
+	if err != nil {
+		t.Fatalf("Web3SignerFn error = %v, want nil", err)
+	}
+	first, err := signer(common.HexToAddress(senderHex), primaryTx())
+	if err != nil {
+		t.Fatalf("first signer error = %v, want nil", err)
+	}
+	second, err := signer(common.HexToAddress(senderHex), primaryTx())
+	if err != nil {
+		t.Fatalf("second signer error = %v, want nil", err)
+	}
+	if got, want := mustMarshalHex(t, first), primarySignedRaw; got != want {
+		t.Fatalf("first signed tx raw = %q, want %q", got, want)
+	}
+	if got, want := mustMarshalHex(t, second), primarySignedRaw; got != want {
+		t.Fatalf("second signed tx raw = %q, want %q", got, want)
+	}
+	if first.Hash().Hex() != second.Hash().Hex() {
+		t.Fatalf("first hash = %q, second hash = %q, want equal", first.Hash().Hex(), second.Hash().Hex())
+	}
+}
