+func TestWeb3SignerDoesNotReturnCachedResultAcrossDifferentInputs(t *testing.T) {
+	responsesByTo := map[string]string{
+		"0x1111111111111111111111111111111111111111": primarySignedRaw,
+		"0x3333333333333333333333333333333333333333": noiseOneSignedRaw,
+		"0x4444444444444444444444444444444444444444": noiseTwoSignedRaw,
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body := readRPCRequest(t, r).body
+		params := extractParams(t, body)
+		writeRPCResult(t, w, responsesByTo[params["to"]])
+	}))
+	defer server.Close()
+
+	client := signerv2.NewWeb3SignerClient(server.URL)
+	for _, tc := range []struct {
+		name     string
+		tx       *types.Transaction
+		wantRaw  string
+		wantHash string
+	}{
+		{name: "primary first", tx: primaryTx(), wantRaw: primarySignedRaw, wantHash: primaryHash},
+		{name: "noise one", tx: noiseOneTx(), wantRaw: noiseOneSignedRaw, wantHash: noiseOneHash},
+		{name: "noise two", tx: noiseTwoTx(), wantRaw: noiseTwoSignedRaw, wantHash: noiseTwoHash},
+		{name: "primary after noise", tx: primaryTx(), wantRaw: primarySignedRaw, wantHash: primaryHash},
+	} {
+		signedTx, err := client.SignTransaction(common.HexToAddress(senderHex), tc.tx)
+		if err != nil {
+			t.Fatalf("%s SignTransaction error = %v, want nil", tc.name, err)
+		}
+		assertSignedTx(t, signedTx, tc.wantRaw, tc.wantHash)
+	}
+}
