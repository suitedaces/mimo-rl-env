+package fs
+
+import (
+	"bytes"
+	"io/ioutil"
+	"os"
+	"reflect"
+	"testing"
+	"time"
+)
+
+func newNestedReader(name string, data []byte, modtime time.Time) *Reader {
+	return &Reader{
+		Name:       name,
+		ReadCloser: ioutil.NopCloser(bytes.NewReader(data)),
+		Mode:       0644,
+		Size:       int64(len(data)),
+		ModTime:    modtime,
+	}
+}
+
+func readDirNames(t *testing.T, fs FS, dir string) []string {
+	t.Helper()
+	f, err := fs.Open(dir)
+	if err != nil {
+		t.Fatalf("Open(%q) returned error: %v", dir, err)
+	}
+	names, err := f.Readdirnames(-1)
+	if err != nil {
+		t.Fatalf("Readdirnames for %q returned error: %v", dir, err)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatalf("Close for %q returned error: %v", dir, err)
+	}
+	return names
+}
+
+func readDirFI(t *testing.T, fs FS, dir string) []os.FileInfo {
+	t.Helper()
+	f, err := fs.Open(dir)
+	if err != nil {
+		t.Fatalf("Open(%q) returned error: %v", dir, err)
+	}
+	entries, err := f.Readdir(-1)
+	if err != nil {
+		t.Fatalf("Readdir for %q returned error: %v", dir, err)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatalf("Close for %q returned error: %v", dir, err)
+	}
+	return entries
+}
+
+
+
+func TestFSReaderNestedFileContent(t *testing.T) {
+	data := []byte("the quick brown fox")
+	const name = "/path/to/foobar"
+
+	t.Run("Open", func(t *testing.T) {
+		fs := newNestedReader(name, data, time.Now())
+		f, err := fs.Open(name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		buf, err := ioutil.ReadAll(f)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := f.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(data, buf) {
+			t.Errorf("wrong content: want %q, got %q", data, buf)
+		}
+	})
+
+	t.Run("OpenFile", func(t *testing.T) {
+		fs := newNestedReader(name, data, time.Now())
+		f, err := fs.OpenFile(name, O_RDONLY, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		buf, err := ioutil.ReadAll(f)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := f.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(data, buf) {
+			t.Errorf("wrong content: want %q, got %q", data, buf)
+		}
+	})
+}
+
+
+
+func TestFSReaderNestedDirListing(t *testing.T) {
+	data := []byte("0123456789")
+	const name = "/path/to/foobar"
+	fs := newNestedReader(name, data, time.Now())
+
+	cases := []struct {
+		dir  string
+		want string
+	}{
+		{"/", "path"},
+		{"/path", "to"},
+		{"/path/to", "foobar"},
+	}
+
+	for _, c := range cases {
+		names := readDirNames(t, fs, c.dir)
+		if !reflect.DeepEqual(names, []string{c.want}) {
+			t.Errorf("listing of %q: want [%q], got %v", c.dir, c.want, names)
+		}
+	}
+}
+
+
+
+
+func TestFSReaderNestedDirListingFI(t *testing.T) {
+	data := []byte("hello world!")
+	const name = "/path/to/foobar"
+	fs := newNestedReader(name, data, time.Now())
+
+	cases := []struct {
+		dir      string
+		wantName string
+		isDir    bool
+	}{
+		{"/", "path", true},
+		{"/path", "to", true},
+		{"/path/to", "foobar", false},
+	}
+
+	for _, c := range cases {
+		entries := readDirFI(t, fs, c.dir)
+		if len(entries) != 1 {
+			t.Errorf("listing of %q: want 1 entry, got %d", c.dir, len(entries))
+			continue
+		}
+		fi := entries[0]
+		if fi.Name() != c.wantName {
+			t.Errorf("listing of %q: want name %q, got %q", c.dir, c.wantName, fi.Name())
+		}
+		if fi.IsDir() != c.isDir {
+			t.Errorf("listing of %q: want IsDir %v, got %v", c.dir, c.isDir, fi.IsDir())
+		}
+		if !c.isDir {
+			if fi.Size() != int64(len(data)) {
+				t.Errorf("file entry: want size %d, got %d", len(data), fi.Size())
+			}
+			if fi.Mode() != 0644 {
+				t.Errorf("file entry: want mode 0644, got %v", fi.Mode())
+			}
+		}
+	}
+}
+
+
+
+func TestFSReaderNestedLstat(t *testing.T) {
+	data := []byte("some content here")
+	const name = "/path/to/foobar"
+	modtime := time.Unix(1500000000, 0)
+	fs := newNestedReader(name, data, modtime)
+
+
+	fi, err := fs.Lstat(name)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if fi.IsDir() {
+		t.Errorf("Lstat(%q): expected a file, got a directory", name)
+	}
+	if fi.Name() != "foobar" {
+		t.Errorf("Lstat(%q): want name %q, got %q", name, "foobar", fi.Name())
+	}
+	if fi.Mode() != 0644 {
+		t.Errorf("Lstat(%q): want mode 0644, got %v", name, fi.Mode())
+	}
+	if fi.Size() != int64(len(data)) {
+		t.Errorf("Lstat(%q): want size %d, got %d", name, len(data), fi.Size())
+	}
+	if !fi.ModTime().Equal(modtime) {
+		t.Errorf("Lstat(%q): want modtime %v, got %v", name, modtime, fi.ModTime())
+	}
+
+
+	for _, dir := range []string{"/", "/path", "/path/to"} {
+		fi, err := fs.Lstat(dir)
+		if err != nil {
+			t.Fatalf("Lstat(%q) returned error: %v", dir, err)
+		}
+		if !fi.IsDir() {
+			t.Errorf("Lstat(%q): expected a directory", dir)
+		}
+		if fi.Mode() != os.ModeDir|0755 {
+			t.Errorf("Lstat(%q): want mode %v, got %v", dir, os.ModeDir|0755, fi.Mode())
+		}
+	}
+
+
+	for _, missing := range []string{"/nope", "/path/other", "/path/to/other"} {
+		if _, err := fs.Lstat(missing); err != os.ErrNotExist {
+			t.Errorf("Lstat(%q): want os.ErrNotExist, got %v", missing, err)
+		}
+	}
+}
+
+
+
+func TestFSReaderNestedOpenMissing(t *testing.T) {
+	const name = "/path/to/foobar"
+	fs := newNestedReader(name, []byte("data"), time.Now())
+
+	for _, missing := range []string{"/nope", "/path/other", "/path/to/other"} {
+		f, err := fs.Open(missing)
+		if err == nil {
+			_ = f.Close()
+			t.Errorf("Open(%q): expected an error, got nil", missing)
+		}
+	}
+}
+
+
+
+func TestFSReaderRelativeNested(t *testing.T) {
+	data := []byte("relative data")
+	const name = "path/to/foobar"
+	fs := newNestedReader(name, data, time.Now())
+
+	names := readDirNames(t, fs, ".")
+	if !reflect.DeepEqual(names, []string{"path"}) {
+		t.Errorf("listing of \".\": want [\"path\"], got %v", names)
+	}
+
+	fi, err := fs.Lstat(".")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !fi.IsDir() {
+		t.Error("Lstat(\".\"): expected a directory")
+	}
+
+	f, err := fs.Open(name)
+	if err != nil {
+		t.Fatal(err)
+	}
+	buf, err := ioutil.ReadAll(f)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(data, buf) {
+		t.Errorf("wrong content: want %q, got %q", data, buf)
+	}
+}
