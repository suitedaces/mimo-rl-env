+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+export GOPROXY=off
+export GOFLAGS=-mod=mod
+
+
+go test ./internal/fs/ -count=1 -run 'TestFSReader|TestFSReaderDir|TestFSReaderMinFileSize'
+
+
+go test ./internal/fs/ -count=1 -run 'TestFSReaderNested|TestFSReaderRelativeNested' -v
