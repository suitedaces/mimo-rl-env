+    python3 -m pytest \
+      tests/test_pygdbmi.py::TestPyGdbMi::test_controller \
+      tests/test_pygdbmi.py::TestPerformance::test_big_o \
+      tests/test_pygdbmi.py::TestStringStream::test_api \
+      -v
+    ;;
+  new)
+    python3 -m pytest tests/test_gdbmi_escapes_blackbox.py -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
