+def test_cli_arg_abbrev_disabled_with_ignore_unknown_args():
+
+
+
+    class MySettings(BaseSettings):
+        model_config = SettingsConfigDict(
+            cli_parse_args=['--f=/some/path'], cli_ignore_unknown_args=True
+        )
+
+        freeze: bool = False
+
+    settings = MySettings()
+    assert settings.freeze is False
+
+
+def test_cli_arg_abbrev_disabled_ambiguous_with_ignore_unknown_args():
+
+
+
+
+    class MySettings(BaseSettings):
+        model_config = SettingsConfigDict(
+            cli_parse_args=['--f=/some/path'], cli_ignore_unknown_args=True
+        )
+
+        freeze: bool = False
+        freeze_also: bool = False
+
+    settings = MySettings()
+    assert settings.freeze is False
+    assert settings.freeze_also is False
+
+
+def test_cli_arg_abbrev_disabled_via_init_kwargs():
+
+
+
+    class MySettings(BaseSettings):
+        freeze: bool = False
+
+    settings = MySettings(
+        _cli_parse_args=['--f=/some/path'], _cli_ignore_unknown_args=True
+    )
+    assert settings.freeze is False
+
+
+def test_cli_full_args_still_work_when_abbrev_disabled():
+
+
+    class MySettings(BaseSettings):
+        model_config = SettingsConfigDict(cli_parse_args=['--freeze=true'])
+
+        freeze: bool = False
+
+    settings = MySettings()
+    assert settings.freeze is True
+
+
+def test_cli_arg_abbrev_disabled_default_no_ignore_unknown_args():
+
+
+
+
+
+    class MySettings(BaseSettings):
+        model_config = SettingsConfigDict(cli_parse_args=['--f=/some/path'])
+
+        freeze: bool = False
+
+    with pytest.raises(SystemExit):
+        MySettings()
