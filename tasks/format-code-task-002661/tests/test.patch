+def test_default_scope_is_only_userinfo_profile():
+    google_bp = make_google_blueprint(
+        client_id="foo",
+        client_secret="bar",
+    )
+    scope = google_bp.session.scope
+    assert scope == ["https://www.googleapis.com/auth/userinfo.profile"]
+    assert len(scope) == 1
+    assert "profile" not in scope
+    assert "https://www.googleapis.com/auth/userinfo.email" not in scope
+    assert "email" not in scope
+    assert "openid" not in scope
+
+
+def test_default_scope_in_authorization_redirect():
+    app = Flask(__name__)
+    app.secret_key = "anything"
+    goog_bp = make_google_blueprint(client_id="foo", client_secret="bar")
+    app.register_blueprint(goog_bp)
+
+    with app.test_client() as client:
+        resp = client.get(
+            "/google",
+            base_url="https://a.b.c",
+            follow_redirects=False,
+        )
+    assert resp.status_code == 302
+    location = URLObject(resp.headers["Location"])
+    scope_param = location.query_dict["scope"]
+    assert scope_param == "https://www.googleapis.com/auth/userinfo.profile"
+
+
