--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,118 @@
+#!/usr/bin/env bash
+set -uo pipefail
+cd /testbed
+
+
+trap '' USR1
+
+
+if [ -z "${_IN_SETSID:-}" ]; then
+    export _IN_SETSID=1
+    exec setsid bash "$0" "$@"
+fi
+
+
+set +u
+export PATH="$HOME/.pyenv/bin:$PATH"
+eval "$(pyenv init -)"
+pyenv global 3.7.17
+python - <<'PY'
+import importlib.util
+import subprocess
+import sys
+
+packages = []
+if importlib.util.find_spec("pyarrow") is None:
+    packages.append("pyarrow==0.14.1")
+if packages:
+    subprocess.check_call([sys.executable, "-m", "pip", "install"] + packages)
+PY
+python - <<'PY'
+import os
+import shutil
+import site
+
+target = "/testbed/python/ray/_raylet.so"
+if not os.path.exists(target):
+    for root in site.getsitepackages():
+        candidate = os.path.join(root, "ray", "_raylet.so")
+        if os.path.exists(candidate):
+            shutil.copy2(candidate, target)
+            break
+generated_target = "/testbed/python/ray/core/generated"
+if not os.path.exists(os.path.join(generated_target, "ErrorTableData.py")):
+    for root in site.getsitepackages():
+        candidate = os.path.join(root, "ray", "core", "generated")
+        if os.path.exists(os.path.join(candidate, "ErrorTableData.py")):
+            for current_root, dirs, files in os.walk(candidate):
+                rel = os.path.relpath(current_root, candidate)
+                dest_root = (generated_target if rel == "." else
+                             os.path.join(generated_target, rel))
+                if not os.path.exists(dest_root):
+                    os.makedirs(dest_root)
+                for filename in files:
+                    dest = os.path.join(dest_root, filename)
+                    if not os.path.exists(dest):
+                        shutil.copy2(os.path.join(current_root, filename), dest)
+            break
+ray_core_src_target = "/testbed/python/ray/core/src"
+if (not os.path.exists(os.path.join(
+        ray_core_src_target, "ray", "thirdparty", "redis", "src",
+        "redis-server")) or not os.path.exists(os.path.join(
+            ray_core_src_target, "plasma", "plasma_store_server"))):
+    for root in site.getsitepackages():
+        candidate = os.path.join(root, "ray", "core", "src")
+        if os.path.exists(os.path.join(
+                candidate, "ray", "thirdparty", "redis", "src",
+                "redis-server")):
+            for current_root, dirs, files in os.walk(candidate):
+                rel = os.path.relpath(current_root, candidate)
+                dest_root = (ray_core_src_target if rel == "." else
+                             os.path.join(ray_core_src_target, rel))
+                if not os.path.exists(dest_root):
+                    os.makedirs(dest_root)
+                for filename in files:
+                    dest = os.path.join(dest_root, filename)
+                    if not os.path.exists(dest):
+                        shutil.copy2(os.path.join(current_root, filename), dest)
+            break
+PY
+export PYTHONPATH=/testbed/python:${PYTHONPATH:-}
+set -u
+
+
+cd /testbed/python
+
+run_pytest() {
+    local tests_expr="$1"
+    python - <<PY
+import os
+import shutil
+import signal as _sig
+import sys
+
+_sig.signal(_sig.SIGUSR1, _sig.SIG_IGN)
+
+for d in ['/tmp/ray', '/tmp/i_am_a_temp_dir', '/tmp/i_am_a_temp_dir2']:
+    shutil.rmtree(d, ignore_errors=True)
+
+import pytest
+
+args = ['-x', '-v', '--tb=short'] + ${tests_expr}
+ec = pytest.main(args)
+sys.exit(0 if str(ec) == 'ExitCode.OK' else 1)
+PY
+}
+
+case "${1:-}" in
+  base)
+    run_pytest "['ray/tests/test_tempfile.py::test_conn_cluster', 'ray/tests/test_tempfile.py::test_raylet_socket_name', 'ray/tests/test_tempfile.py::test_temp_plasma_store_socket']"
+    ;;
+  new)
+    run_pytest "['ray/tests/test_tempfile.py::test_explicit_temp_dir_uses_session_subdir_for_runtime_files', 'ray/tests/test_tempfile.py::test_session_directory_name_has_high_precision_timestamp', 'ray/tests/test_tempfile.py::test_multiple_starts_create_distinct_session_dirs_under_same_root', 'ray/tests/test_tempfile.py::test_cli_temp_dir_uses_session_subdir', 'ray/tests/test_tempfile.py::test_default_temp_dir_creates_session_under_tmp_ray', 'ray/tests/test_tempfile.py::test_worker_nodes_share_head_session_directory', 'ray/tests/test_tempfile.py::test_raylet_tempfiles']"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
