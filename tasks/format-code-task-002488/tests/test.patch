+def test_multiple_starts_create_distinct_session_dirs_under_same_root():
+    root = _make_temp_root()
+    session_dirs = set()
+    try:
+        for _ in range(3):
+            ray.init(temp_dir=root, num_cpus=0)
+            session_dir = _session_dir_from_node(ray.worker._global_node)
+            _assert_session_layout(root, session_dir)
+            session_dirs.add(session_dir)
+            ray.shutdown()
+        assert len(session_dirs) == 3
+    finally:
+        ray.shutdown()
+        shutil.rmtree(root, ignore_errors=True)
+
+
+def test_cli_temp_dir_uses_session_subdir():
+    root = _make_temp_root()
+    try:
+        subprocess.check_call(
+            ["ray", "start", "--head", "--temp-dir={}".format(root)])
+        session_dirs = [
+            os.path.join(root, entry)
+            for entry in os.listdir(root)
+            if entry.startswith("session_")
+            and os.path.isdir(os.path.join(root, entry))
+        ]
+        usable_session_dirs = [
+            session_dir for session_dir in session_dirs
+            if os.path.isdir(os.path.join(session_dir, "logs"))
+            and os.path.isdir(os.path.join(session_dir, "sockets"))
+        ]
+        assert usable_session_dirs
