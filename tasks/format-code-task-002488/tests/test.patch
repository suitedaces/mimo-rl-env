+_OLD_SECONDS_ONLY_SESSION_RE = re.compile(
+    r"^session_\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2}_\d+$")
+
+
+def _make_temp_root():
+    return tempfile.mkdtemp(prefix="ray-session-root-")
+
+
+def _session_dir_from_node(node):
+    logs_dir = os.path.abspath(node.get_logs_dir_path())
+    sockets_dir = os.path.abspath(node.get_sockets_dir_path())
+    assert os.path.basename(logs_dir) == "logs"
+    assert os.path.basename(sockets_dir) == "sockets"
+    session_from_logs = os.path.dirname(logs_dir)
+    session_from_sockets = os.path.dirname(sockets_dir)
+    assert session_from_logs == session_from_sockets
+    return session_from_logs
+
+
+def _assert_session_layout(root, session_dir):
+    root = os.path.abspath(root)
+    session_dir = os.path.abspath(session_dir)
+    assert os.path.dirname(session_dir) == root
+    assert os.path.basename(session_dir).startswith("session_")
+    assert os.path.isdir(session_dir)
+    assert os.path.isdir(os.path.join(session_dir, "logs"))
+    assert os.path.isdir(os.path.join(session_dir, "sockets"))
+
