+@mock_aws
+def test_ses_list_configuration_sets_returns_created_names_and_next_token_member():
+    conn = boto3.client("ses", region_name="us-east-1")
+    names = ["ses-list-alpha", "ses-list-beta", "ses-list-gamma"]
+    for name in names:
+        conn.create_configuration_set(ConfigurationSet={"Name": name})
+
+    response = conn.list_configuration_sets()
+
+    returned_names = {config_set["Name"] for config_set in response["ConfigurationSets"]}
+    assert set(names).issubset(returned_names)
+    assert "NextToken" in response
+
+
+@mock_aws
+def test_ses_delete_configuration_set_removes_from_describe_and_list():
+    conn = boto3.client("ses", region_name="us-east-1")
+    target_name = "ses-delete-target"
+    survivor_name = "ses-delete-survivor"
+    conn.create_configuration_set(ConfigurationSet={"Name": target_name})
+    conn.create_configuration_set(ConfigurationSet={"Name": survivor_name})
+
+    conn.delete_configuration_set(ConfigurationSetName=target_name)
+
+    remaining_names = {
+        config_set["Name"]
+        for config_set in conn.list_configuration_sets()["ConfigurationSets"]
+    }
+    assert target_name not in remaining_names
+    assert survivor_name in remaining_names
+
+    with pytest.raises(ClientError):
+        conn.describe_configuration_set(ConfigurationSetName=target_name)
+
+
+@mock_aws
+def test_ses_delete_configuration_set_removes_arbitrary_name():
+    conn = boto3.client("ses", region_name="us-east-1")
+    delete_name = "ses-delete-plain"
+    keep_name = "ses-delete-plain-survivor"
+    conn.create_configuration_set(ConfigurationSet={"Name": delete_name})
+    conn.create_configuration_set(ConfigurationSet={"Name": keep_name})
+
+    conn.delete_configuration_set(ConfigurationSetName=delete_name)
+
+    listed_names = {
+        config_set["Name"]
+        for config_set in conn.list_configuration_sets()["ConfigurationSets"]
+    }
+    assert delete_name not in listed_names
+    assert keep_name in listed_names
+
+    with pytest.raises(ClientError):
+        conn.describe_configuration_set(ConfigurationSetName=delete_name)
+
