@@ -0,0 +1,36 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export AWS_DEFAULT_REGION=us-east-1
+
+
+case "${1:-}" in
+  base)
+    python -m pytest \
+      tests/test_ses/test_ses_boto3.py::test_describe_configuration_set \
+      tests/test_sesv2/test_sesv2.py::test_delete_contact \
+      -v
+    ;;
+  new)
+    python -m pytest \
+      tests/test_ses/test_ses_boto3.py::test_ses_list_configuration_sets_returns_created_names_and_next_token_member \
+      tests/test_ses/test_ses_boto3.py::test_ses_delete_configuration_set_removes_from_describe_and_list \
+      tests/test_ses/test_ses_boto3.py::test_ses_delete_configuration_set_removes_arbitrary_name \
+      tests/test_sesv2/test_sesv2.py::test_sesv2_configuration_set_create_get_returns_created_fields \
+      tests/test_sesv2/test_sesv2.py::test_sesv2_configuration_set_list_contains_created_names \
+      tests/test_sesv2/test_sesv2.py::test_sesv2_configuration_set_delete_removes_from_get_and_list \
+      tests/test_sesv2/test_sesv2.py::test_sesv2_dedicated_ip_pool_create_get_returns_name_and_scaling_mode \
+      tests/test_sesv2/test_sesv2.py::test_sesv2_dedicated_ip_pool_list_and_delete_reflect_state \
+      tests/test_sesv2/test_sesv2.py::test_sesv2_configuration_set_create_get_roundtrips_enabled_sending_options \
+      tests/test_sesv2/test_sesv2.py::test_sesv2_configuration_set_delete_removes_arbitrary_name \
+      tests/test_sesv2/test_sesv2.py::test_sesv2_dedicated_ip_pool_get_returns_standard_scaling_mode \
+      tests/test_sesv2/test_sesv2.py::test_sesv2_dedicated_ip_pool_list_and_delete_arbitrary_names \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
