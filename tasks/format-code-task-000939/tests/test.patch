+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+dev-switch python3 3.11
+
+
+python3 -m pip install --no-input numpy torch tensorboardX tensorboard pytest
+
+
+python3 -m pip install --no-input --no-deps -e .
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest test/core/test_predictor.py -v
+    ;;
+  new)
+    python3 -m pytest test/core/test_predictor_task_dispatch.py -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
