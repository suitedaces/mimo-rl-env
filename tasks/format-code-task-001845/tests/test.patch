+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set +u
+export PATH="$HOME/.pyenv/bin:$PATH"
+eval "$(pyenv init -)"
+pyenv global 2.7.18
+set -u
+
+
+run_unittest_methods() {
+  python - "$@" <<'PY'
+import os
+import sys
+import unittest
+
+sys.path.append('./tests/cigar_example')
+os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'cigar_example.settings')
+
+import django
+if hasattr(django, 'setup'):
+    django.setup()
+
+test_class_path = sys.argv[1]
+method_names = sys.argv[2:]
+module_name, class_name = test_class_path.rsplit('.', 1)
+module = __import__(module_name, fromlist=[class_name])
+test_class = getattr(module, class_name)
+suite = unittest.TestSuite([test_class(name) for name in method_names])
+result = unittest.TextTestRunner(verbosity=2).run(suite)
+sys.exit(0 if result.wasSuccessful() else 1)
+PY
+}
+
+case "${1:-}" in
+  base)
+    run_unittest_methods \
+      rest_framework_swagger.tests.ViewSetMethodIntrospectorTests \
+      test_get_serializer_class_access_action \
+      test_no_builds_pagination_parameters_for_create \
+      test_get_summary_empty
+    ;;
+  new)
+    run_unittest_methods \
+      rest_framework_swagger.test_fixture_pagination.FixturePaginationIntrospectionTests \
+      test_drf31_pagination_class_adds_configured_page_parameter \
+      test_drf31_pagination_class_adds_configured_page_size_parameter \
+      test_drf31_pagination_class_uses_current_paginator_names_only \
+      test_drf31_pagination_class_requires_enabled_pagination \
+      test_drf31_pagination_parameters_are_list_only
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
