@@ -0,0 +1,165 @@
+# -*- coding: utf-8 -*-
+
+
+
+
+
+
+
+from flask_security import (
+    Security,
+    get_identity_lookup,
+    uia_email_mapper,
+    uia_phone_mapper,
+)
+
+
+def _init_security(app, datastore, **config):
+    for key, value in config.items():
+        app.config["SECURITY_" + key] = value
+    app.security = Security(app, datastore=datastore)
+    return app
+
+
+
+
+
+def _always(identity):
+    return identity
+
+
+def _never(identity):
+    return None
+
+
+def test_email_mapper_valid():
+    for good in ["matt@lp.com", "MATT@lp.com", "a@b.co", "joe.smith@example.org"]:
+        assert uia_email_mapper(good) == good
+
+
+def test_email_mapper_invalid():
+    for bad in ["not-an-email", "matt@", "12345", "user@example", "foo bar@x.com"]:
+        assert uia_email_mapper(bad) is None
+
+
+def test_phone_mapper_valid():
+    for good in ["+1-555-555-5555", "555-555-5555", "(555) 555-5555", "5555555555"]:
+        assert uia_phone_mapper(good) == good
+
+
+def test_phone_mapper_invalid():
+    for bad in ["matt@lp.com", "abc", "12"]:
+        assert uia_phone_mapper(bad) is None
+
+
+def test_default_lookup_email(app, sqlalchemy_datastore):
+
+    _init_security(app, sqlalchemy_datastore)
+    assert get_identity_lookup("matt@lp.com", app=app) == {"email": "matt@lp.com"}
+
+
+def test_default_lookup_no_match(app, sqlalchemy_datastore):
+
+    _init_security(app, sqlalchemy_datastore)
+    assert get_identity_lookup("555-555-5555", app=app) is None
+
+
+def test_lookup_returns_canonical_value(app, sqlalchemy_datastore):
+
+    _init_security(app, sqlalchemy_datastore)
+    assert get_identity_lookup("MATT@lp.com", app=app) == {"email": "MATT@lp.com"}
+
+
+def test_lookup_respects_identity_attributes(app, sqlalchemy_datastore):
+
+
+    _init_security(
+        app,
+        sqlalchemy_datastore,
+        USER_IDENTITY_ATTRIBUTES=["email"],
+        USER_IDENTITY_MAPPINGS=[
+            {"email": uia_email_mapper},
+            {"us_phone_number": uia_phone_mapper},
+        ],
+    )
+    assert get_identity_lookup("555-555-5555", app=app) is None
+    assert get_identity_lookup("matt@lp.com", app=app) == {"email": "matt@lp.com"}
+
+
+def test_lookup_enabled_attribute_matches(app, sqlalchemy_datastore):
+
+    _init_security(
+        app,
+        sqlalchemy_datastore,
+        USER_IDENTITY_ATTRIBUTES=["email", "us_phone_number"],
+        USER_IDENTITY_MAPPINGS=[
+            {"email": uia_email_mapper},
+            {"us_phone_number": uia_phone_mapper},
+        ],
+    )
+    assert get_identity_lookup("555-555-5555", app=app) == {
+        "us_phone_number": "555-555-5555"
+    }
+
+
+def test_lookup_order_first_match_wins(app, sqlalchemy_datastore):
+
+    _init_security(
+        app,
+        sqlalchemy_datastore,
+        USER_IDENTITY_ATTRIBUTES=["email", "username"],
+        USER_IDENTITY_MAPPINGS=[
+            {"username": _always},
+            {"email": _always},
+        ],
+    )
+    assert get_identity_lookup("whatever", app=app) == {"username": "whatever"}
+
+
+def test_lookup_order_reversed(app, sqlalchemy_datastore):
+    _init_security(
+        app,
+        sqlalchemy_datastore,
+        USER_IDENTITY_ATTRIBUTES=["email", "username"],
+        USER_IDENTITY_MAPPINGS=[
+            {"email": _always},
+            {"username": _always},
+        ],
+    )
+    assert get_identity_lookup("whatever", app=app) == {"email": "whatever"}
+
+
+def test_lookup_skips_non_matching_mapper(app, sqlalchemy_datastore):
+
+    _init_security(
+        app,
+        sqlalchemy_datastore,
+        USER_IDENTITY_ATTRIBUTES=["email", "username"],
+        USER_IDENTITY_MAPPINGS=[
+            {"email": _never},
+            {"username": _always},
+        ],
+    )
+    assert get_identity_lookup("whatever", app=app) == {"username": "whatever"}
+
+
+def test_lookup_no_mapping_matches(app, sqlalchemy_datastore):
+    _init_security(
+        app,
+        sqlalchemy_datastore,
+        USER_IDENTITY_ATTRIBUTES=["email"],
+        USER_IDENTITY_MAPPINGS=[{"email": uia_email_mapper}],
+    )
+    assert get_identity_lookup("not-an-email", app=app) is None
+
+
+def test_default_mappings_present(app, sqlalchemy_datastore):
+
+    _init_security(app, sqlalchemy_datastore)
+    mappings = app.config["SECURITY_USER_IDENTITY_MAPPINGS"]
+    assert isinstance(mappings, list)
+    assert all(isinstance(m, dict) and len(m) == 1 for m in mappings)
+
+    for m in mappings:
+        for mapper in m.values():
+            assert callable(mapper)
