--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set -euo pipefail
+if [ ! -x ./python ] || [ ! -f pybuilddir.txt ]; then
+    if [ ! -f Makefile ]; then
+        ./configure --without-ensurepip
+    fi
+    make -j2
+fi
+set +e
+
+
+case "${1:-}" in
+  base)
+    ./python -m test test_enum -v --match 'test_or'
+    ;;
+  new)
+    ./python -m test test_enum -v \
+      --match 'test_boundary' \
+      --match 'test_flag_default_boundary_rejects_unknown_bits' \
+      --match 'test_named_multi_bit_alias_is_used_for_exact_results' \
+      --match 'test_named_multi_bit_aliases_participate_in_combinations' \
+      --match 'test_flag_boundary_documentation_defaults'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
