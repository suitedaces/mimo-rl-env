+    def test_flag_default_boundary_rejects_unknown_bits(self):
+        class Color(Flag):
+            RED = 1
+            BLUE = 2
+        with self.assertRaises(ValueError):
+            Color(4)
+        with self.assertRaises(ValueError):
+            Color(5)
+
+        class Sparse(Flag):
+            A = 1
+            C = 4
+        with self.assertRaises(ValueError):
+            Sparse(2)
+        with self.assertRaises(ValueError):
+            Sparse(8)
+
+        class ConformingColor(Flag, boundary=CONFORM):
+            RED = 1
+            BLUE = 2
+        self.assertEqual(ConformingColor(4).value, 0)
+        self.assertIs(ConformingColor(5), ConformingColor.RED)
+
+    def test_named_multi_bit_alias_is_used_for_exact_results(self):
+        class Perm(Flag):
+            R = 1
+            W = 2
+            X = 4
+            RW = R | W
+            RWX = R | W | X
+        self.assertIs(Perm.R | Perm.W, Perm.RW)
+        self.assertIs(Perm.R | Perm.W | Perm.X, Perm.RWX)
+        self.assertIs(Perm(3), Perm.RW)
+        self.assertIs(Perm(7), Perm.RWX)
+
+    def test_named_multi_bit_aliases_participate_in_combinations(self):
+        class CompositeFlag(Flag):
+            A = 1
+            B = 2
+            C = 4 | B
+        combo = CompositeFlag.A | CompositeFlag.C
+        self.assertEqual(combo.value, 7)
+        self.assertTrue(CompositeFlag.A in combo)
+        self.assertTrue(CompositeFlag.C in combo)
+        with self.assertRaises(ValueError):
+            CompositeFlag(15)
+
+        class MethodHint(Flag):
+            HIDDEN = 0x10
+            DIGITS = 0x01
+            LETTERS = 0x02
+            MASK = 0x0f
+        hint = MethodHint.HIDDEN | MethodHint.MASK
+        self.assertEqual(hint.value, 0x1f)
+        self.assertTrue(MethodHint.HIDDEN in hint)
+        self.assertTrue(MethodHint.MASK in hint)
+
+    def test_flag_boundary_documentation_defaults(self):
+        enum_doc = os.path.join(
+                os.path.dirname(__file__),
+                '..', '..', 'Doc', 'library', 'enum.rst',
+                )
+        with open(enum_doc, encoding='utf-8') as f:
+            text = f.read()
+        strict_start = text.index('.. attribute:: STRICT')
+        conform_start = text.index('.. attribute:: CONFORM')
+        eject_start = text.index('.. attribute:: EJECT')
+        strict_section = text[strict_start:conform_start].lower()
+        conform_section = text[conform_start:eject_start].lower()
+        self.assertIn('flag', strict_section)
+        self.assertIn('default', strict_section)
+        self.assertIn('out-of-range', conform_section)
+        self.assertFalse('default' in conform_section and 'flag' in conform_section)
+        self.assertIs(enum.Flag._boundary_, STRICT)
 
