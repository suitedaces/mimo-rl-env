@@ -0,0 +1,175 @@
+
+import json
+from copy import deepcopy
+from os import sep
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from bandersnatch.package import Package
+from bandersnatch.simple import SimpleAPI, SimpleDigest, SimpleFormat
+from bandersnatch.storage import Storage
+from bandersnatch_storage_plugins.filesystem import FilesystemStorage
+from configparser import ConfigParser
+
+
+
+
+
+PEP700_METADATA = {
+    "info": {"name": "pep700pkg"},
+    "last_serial": 12345,
+    "releases": {
+        "6.9": [
+            {
+                "digests": {
+                    "md5": "ff4bf804ef3722a1fd8853a8a32513d4",
+                    "sha256": (
+                        "0c8deb7c8574787283c3fc08b714ee63fd6752a38d13515a9d8508798d428597"
+                    ),
+                },
+                "filename": "pep700pkg-6.9.tar.gz",
+                "md5_digest": "ff4bf804ef3722a1fd8853a8a32513d4",
+                "packagetype": "sdist",
+                "python_version": "source",
+                "requires_python": ">=3.6",
+                "size": 1077,
+                "upload_time": "2018-05-17T03:47:45",
+                "upload_time_iso_8601": "2018-05-17T03:47:45.953704Z",
+                "url": (
+                    "https://files.pythonhosted.org/packages/7b/6e/"
+                    "7c4ce77c6ca092e94e19b78282b459e7f8270362da655cbc6a75eeb9cdd7/"
+                    "pep700pkg-6.9.tar.gz"
+                ),
+                "yanked": False,
+                "yanked_reason": None,
+            }
+        ],
+        "0.69": [
+            {
+                "digests": {
+                    "md5": "4328d962656395fbd3e730c9d30bb48c",
+                    "sha256": (
+                        "5c11f48399f9b1bca802751513f1f97bff6ce97e6facb576b7729e1351453c10"
+                    ),
+                },
+                "filename": "pep700pkg-0.69.tar.gz",
+                "md5_digest": "4328d962656395fbd3e730c9d30bb48c",
+                "packagetype": "sdist",
+                "python_version": "source",
+                "requires_python": ">=3.6",
+                "size": 1078,
+                "upload_time": "2018-05-17T03:37:19",
+                "upload_time_iso_8601": "2018-05-17T03:37:19.330556Z",
+                "url": (
+                    "https://files.pythonhosted.org/packages/d3/cc/"
+                    "95dc5434362bd333a1fec275231775d748315b26edf1e7e568e6f8660238/"
+                    "pep700pkg-0.69.tar.gz"
+                ),
+                "yanked": False,
+                "yanked_reason": None,
+            }
+        ],
+    },
+    "urls": [],
+    "vulnerabilities": [],
+}
+
+
+def _build_simple_api() -> SimpleAPI:
+    return SimpleAPI(
+        Storage(), SimpleFormat.JSON, [], SimpleDigest.SHA256, False, None
+    )
+
+
+def _generate_package_json() -> dict:
+    s = _build_simple_api()
+    p = Package("pep700pkg")
+    p._metadata = deepcopy(PEP700_METADATA)
+    return json.loads(s.generate_json_simple_page(p))
+
+
+def test_pep700_api_version_is_1_1() -> None:
+
+    parsed = _generate_package_json()
+    assert parsed["meta"]["api-version"] == "1.1"
+
+
+def test_pep700_versions_key_present() -> None:
+
+    parsed = _generate_package_json()
+    assert "versions" in parsed
+
+
+def test_pep700_versions_is_list() -> None:
+
+    parsed = _generate_package_json()
+    assert isinstance(parsed["versions"], list)
+
+    for v in parsed["versions"]:
+        assert isinstance(v, str)
+
+
+def test_pep700_versions_contents_sorted() -> None:
+
+
+
+
+
+
+    parsed = _generate_package_json()
+    assert sorted(parsed["versions"]) == ["0.69", "6.9"]
+
+
+def test_pep700_files_include_size() -> None:
+
+    parsed = _generate_package_json()
+    assert len(parsed["files"]) == 2
+    for f in parsed["files"]:
+        assert "size" in f, f"missing 'size' in {f!r}"
+
+    assert parsed["files"][0]["size"] == 1078
+    assert parsed["files"][1]["size"] == 1077
+
+
+def test_pep700_files_include_upload_time() -> None:
+
+    parsed = _generate_package_json()
+    assert len(parsed["files"]) == 2
+    for f in parsed["files"]:
+        assert "upload-time" in f, f"missing 'upload-time' in {f!r}"
+    assert (
+        parsed["files"][0]["upload-time"] == "2018-05-17T03:37:19.330556Z"
+    )
+    assert (
+        parsed["files"][1]["upload-time"] == "2018-05-17T03:47:45.953704Z"
+    )
+
+
+def test_pep700_class_attribute_simple_api_version() -> None:
+
+    assert SimpleAPI.pypi_simple_api_version == "1.1"
+
+
+def test_pep700_index_page_api_version() -> None:
+
+    c = ConfigParser()
+    c.add_section("mirror")
+    c["mirror"]["workers"] = "1"
+    s = SimpleAPI(
+        FilesystemStorage(config=c), SimpleFormat.ALL, [], "sha256", False, None
+    )
+    with TemporaryDirectory() as td:
+        td_path = Path(td)
+        simple_dir = td_path / "simple"
+        pkg_dir = simple_dir / "pep700pkg"
+        pkg_dir.mkdir(parents=True)
+        (pkg_dir / "index.html").touch()
+
+        s.sync_index_page(True, td_path, 12345, pretty=False)
+        content = (simple_dir / "index.v1_json").read_text()
+        parsed = json.loads(content)
+        assert parsed["meta"]["api-version"] == "1.1"
+
+        assert parsed["meta"]["_last-serial"] == 12345
+
+        assert {"name": "pep700pkg"} in parsed["projects"]
