diff --git a/src/lib/history.test.js b/src/lib/history.test.js
index e2eefeb..7fd10e6 100644
--- a/src/lib/history.test.js
+++ b/src/lib/history.test.js
@@ -38,3 +38,58 @@ it("should have a proper search", () => {
   testHistory.navigate("/?asdf");
   expect(testHistory.location.search).toEqual("?asdf");
 });
+
+describe("getLocation pathname encoding (unicode URLs / MS Edge)", () => {
+  const makeMockSource = ({ pathname, search = "", hash = "" }) => ({
+    history: { state: null },
+    location: { pathname, search, hash }
+  });
+
+  it("encodes a raw unicode pathname (MS Edge style)", () => {
+
+
+    const history = createHistory(makeMockSource({ pathname: "/påge" }));
+    expect(history.location.pathname).toBe("/p%C3%A5ge");
+  });
+
+  it("leaves an already percent-encoded unicode pathname unchanged (Chrome style)", () => {
+
+
+    const history = createHistory(
+      makeMockSource({ pathname: "/p%C3%A5ge" })
+    );
+    expect(history.location.pathname).toBe("/p%C3%A5ge");
+  });
+
+  it("preserves a plain ASCII pathname", () => {
+    const history = createHistory(makeMockSource({ pathname: "/test" }));
+    expect(history.location.pathname).toBe("/test");
+  });
+
+  it("preserves search and hash alongside an encoded pathname", () => {
+    const history = createHistory(
+      makeMockSource({
+        pathname: "/påge",
+        search: "?foo=bar",
+        hash: "#section"
+      })
+    );
+    expect(history.location.pathname).toBe("/p%C3%A5ge");
+    expect(history.location.search).toBe("?foo=bar");
+    expect(history.location.hash).toBe("#section");
+  });
+
+  it("encodes a multi-segment unicode pathname", () => {
+    const history = createHistory(
+      makeMockSource({ pathname: "/café/menü" })
+    );
+    expect(history.location.pathname).toBe("/caf%C3%A9/men%C3%BC");
+  });
+
+  it("exposes encoded pathname through createMemorySource + createHistory", () => {
+
+
+    const history = createHistory(createMemorySource("/påge"));
+    expect(history.location.pathname).toBe("/p%C3%A5ge");
+  });
+});
