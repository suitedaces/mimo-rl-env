+import React from 'react';
+import ReactDOM from 'react-dom';
+import TestUtils from 'react-addons-test-utils';
+import {expect} from 'chai';
+
+import {DIALECTS} from '../../app/constants/constants';
+
+const electronDialog = {
+    showOpenDialog(options, callback) {
+        callback(['/tmp/falcon.sqlite']);
+    }
+};
+
+window.require = () => ({
+    remote: {
+        dialog: electronDialog
+    }
+});
+
+const UserConnectionsModule = require(
+    '../../app/components/Settings/UserConnections/UserConnections.react'
+);
+const UserConnections = UserConnectionsModule.default || UserConnectionsModule;
+
+function renderConnectionForm(connectionOverrides = {}, updateConnection = () => {}) {
+    const connectionObject = Object.assign({
+        dialect: DIALECTS.MSSQL,
+        username: 'sa',
+        password: 'secret',
+        host: 'localhost',
+        port: '1433',
+        database: 'falcon'
+    }, connectionOverrides);
+
+    const component = TestUtils.renderIntoDocument(
+        <UserConnections
+            connectionObject={connectionObject}
+            updateConnection={updateConnection}
+        />
+    );
+
+    return ReactDOM.findDOMNode(component);
+}
+
+function byId(root, id) {
+    return root.querySelector(`#${id}`);
+}
+
+function changeInput(input, value) {
+    TestUtils.Simulate.change(input, {target: {value}});
+}
+
+function cleanText(text) {
+    return (text || '').replace(/\s+/g, ' ').trim();
+}
+
+function fieldText(root, input) {
+    let node = input;
+    let best = '';
+    while (node && node !== root.parentNode) {
+        const text = cleanText(node.textContent);
+        if (text.length > best.length && text.length < 250) {
+            best = text;
+        }
+        if (node === root) {
+            break;
+        }
+        node = node.parentNode;
+    }
+    return best;
+}
+
+function expectReadableFieldText(root, input, rawKey) {
+    const text = fieldText(root, input);
+    expect(text.length).to.be.above(rawKey.length);
+    expect(text).to.not.equal(rawKey);
+    expect(text.toLowerCase()).to.not.equal(rawKey.toLowerCase());
+    expect(text.indexOf(' ')).to.be.above(-1);
+}
+
+describe('UserConnections MSSQL timeout fields - ', function () {
+    it('renders_mssql_timeout_fields', function () {
+        const updates = [];
+        const root = renderConnectionForm({}, update => updates.push(update));
+
+        const connectTimeout = byId(root, 'test-input-connectTimeout');
+        const requestTimeout = byId(root, 'test-input-requestTimeout');
+
+        expect(connectTimeout).to.exist;
+        expect(requestTimeout).to.exist;
+        expect(connectTimeout.tagName.toLowerCase()).to.equal('input');
+        expect(requestTimeout.tagName.toLowerCase()).to.equal('input');
+        expect(connectTimeout.getAttribute('type')).to.equal('number');
+        expect(requestTimeout.getAttribute('type')).to.equal('number');
+
+        changeInput(connectTimeout, '31000');
+        changeInput(requestTimeout, '45000');
+
+        expect(updates).to.deep.include({connectTimeout: '31000'});
+        expect(updates).to.deep.include({requestTimeout: '45000'});
+
+        const previousNodeEnv = process.env.NODE_ENV;
+        process.env.NODE_ENV = 'production';
+        try {
+            const productionRoot = renderConnectionForm({
+                database: 'customerdb',
+                host: 'remote-sql.example.com'
+            });
+            const productionConnectTimeout = byId(productionRoot, 'test-input-connectTimeout');
+            const productionRequestTimeout = byId(productionRoot, 'test-input-requestTimeout');
+
+            expect(productionConnectTimeout).to.exist;
+            expect(productionRequestTimeout).to.exist;
+            expect(productionConnectTimeout.getAttribute('type')).to.equal('number');
+            expect(productionRequestTimeout.getAttribute('type')).to.equal('number');
+        } finally {
+            process.env.NODE_ENV = previousNodeEnv;
+        }
+    });
+
+    it('renders_clearer_field_information', function () {
+        const root = renderConnectionForm();
+        const portInput = byId(root, 'test-input-port');
+        const connectTimeout = byId(root, 'test-input-connectTimeout');
+        const requestTimeout = byId(root, 'test-input-requestTimeout');
+
+        expectReadableFieldText(root, portInput, 'port');
+        expectReadableFieldText(root, connectTimeout, 'connectTimeout');
+        expectReadableFieldText(root, requestTimeout, 'requestTimeout');
+
+        const s3Root = renderConnectionForm({
+            dialect: DIALECTS.S3,
+            bucket: '',
+            accessKeyId: '',
+            secretAccessKey: ''
+        });
+
+        expectReadableFieldText(
+            s3Root,
+            byId(s3Root, 'test-input-accessKeyId'),
+            'accessKeyId'
+        );
+        expectReadableFieldText(
+            s3Root,
+            byId(s3Root, 'test-input-secretAccessKey'),
+            'secretAccessKey'
+        );
+    });
+
+    it('uses_appropriate_controls_without_regressing_path_fields', function () {
+        const mssqlRoot = renderConnectionForm();
+        const passwordInput = byId(mssqlRoot, 'test-input-password');
+        const portInput = byId(mssqlRoot, 'test-input-port');
+        const connectTimeout = byId(mssqlRoot, 'test-input-connectTimeout');
+
+        expect(passwordInput).to.exist;
+        expect(passwordInput.getAttribute('type')).to.equal('password');
+        expect(portInput).to.exist;
+        expect(portInput.getAttribute('type')).to.equal('number');
+        expect(connectTimeout).to.exist;
+        expect(connectTimeout.getAttribute('type')).to.equal('number');
+
+        const previousNodeEnv = process.env.NODE_ENV;
+        process.env.NODE_ENV = 'production';
+        try {
+            const productionRoot = renderConnectionForm();
+            const productionPassword = byId(productionRoot, 'test-input-password');
+            const productionPort = byId(productionRoot, 'test-input-port');
+
+            expect(productionPassword).to.exist;
+            expect(productionPassword.getAttribute('type')).to.equal('password');
+            expect(productionPort).to.exist;
+            expect(productionPort.getAttribute('type')).to.equal('number');
+        } finally {
+            process.env.NODE_ENV = previousNodeEnv;
+        }
+
+        const sqliteRoot = renderConnectionForm({
+            dialect: DIALECTS.SQLITE,
+            storage: ''
+        });
+
+        const storageInput = byId(sqliteRoot, 'test-input-storage');
+        expect(storageInput).to.exist;
+    });
+});
