@@ -0,0 +1,36 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+dev-switch node 20 2>/dev/null || true
+if [ ! -x /testbed/node_modules/.bin/mocha ]; then
+  npm install --legacy-peer-deps --ignore-scripts 2>&1 | tail -5
+fi
+
+
+case "${1:-}" in
+  base)
+    NODE_ENV=test BABEL_DISABLE_CACHE=1 \
+      /testbed/node_modules/.bin/mocha \
+      --compilers js:babel-register \
+      test/backend/parse.spec.js test/backend/settings.spec.js
+    ;;
+  new)
+    NODE_ENV=test BABEL_DISABLE_CACHE=1 \
+      /testbed/node_modules/.bin/mocha \
+      --compilers js:babel-register \
+      test/backend/Datastores.spec.js \
+      --grep "MSSQL timeout configuration" && \
+    NODE_ENV=test BABEL_DISABLE_CACHE=1 \
+      /testbed/node_modules/.bin/mocha \
+      --compilers js:babel-register \
+      --require ./test/setup.js \
+      test/components/UserConnections.spec.js \
+      --grep "UserConnections MSSQL timeout fields"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
