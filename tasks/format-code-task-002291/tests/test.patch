+}
+
+function captureNextQueryOptions(run) {
+    const originalQuery = Sequelize.prototype.query;
+    const capturedOptions = [];
+
+    Sequelize.prototype.query = function patchedQuery() {
+        capturedOptions.push(this.options);
+        return Promise.resolve([]);
+    };
+
+    return Promise.resolve()
+        .then(run)
+        .then(() => capturedOptions)
+        .then(captured => {
+            Sequelize.prototype.query = originalQuery;
+            return captured;
+        }, error => {
+            Sequelize.prototype.query = originalQuery;
+            throw error;
+        });
+}
