@@ -0,0 +1,9 @@
+#!/bin/bash
+set -euo pipefail
+
+
+pytest -q \
+  supervisor/tests/test_synth_eventlistener_delivery.py \
+  supervisor/tests/test_process.py::EventListenerPoolTests \
+  supervisor/tests/test_options.py::ServerOptionsTests \
+  supervisor/tests/test_options.py::EventListenerPoolConfigTests
