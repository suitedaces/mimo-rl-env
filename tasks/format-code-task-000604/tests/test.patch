@@ -0,0 +1,27 @@
+import * as fs from 'fs'
+import * as path from 'path'
+
+describe('README migration documentation', () => {
+  test('readme_documents_4_0_to_4_1_migration', () => {
+    const readme = fs.readFileSync(
+      path.resolve(__dirname, '../../README.md'),
+      'utf8'
+    )
+
+    const heading = readme.match(/^###\s+.*4\.0\.x.*4\.1\.x.*$/im)
+    expect(heading).not.toBeNull()
+
+    const sectionStart = heading ? heading.index || 0 : 0
+    const rest = readme.slice(sectionStart + 1)
+    const nextHeadingOffset = rest.search(/^###\s+/im)
+    const section =
+      nextHeadingOffset === -1 ? rest : rest.slice(0, nextHeadingOffset)
+
+    expect(section).toMatch(/\bModel\b/)
+    expect(section).toMatch(/registr(?:y|ies)/i)
+    expect(section).toMatch(/\buseStore\b/)
+    expect(section).toMatch(/\bcreateStore\b/)
+    expect(section).toMatch(/4\.0\.x/)
+    expect(section).toMatch(/4\.1\.x/)
+  })
+})
