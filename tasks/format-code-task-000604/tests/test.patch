@@ -0,0 +1,70 @@
+/// <reference path="../index.d.ts" />
+import { renderHook, act } from '@testing-library/react-hooks'
+import { createStore, useModel } from '../../src'
+
+describe('useModel setter compatibility', () => {
+  test('mutating_function_updater_preserves_state_and_applies_change', async () => {
+    const store = createStore(() => {
+      const [state, setState] = useModel({ count: 0, name: 'Ada' })
+      const actions = {
+        increment: (delta: number) => {
+          return setState((draft: any) => {
+            draft.count += delta
+          })
+        }
+      }
+      return [state, actions] as const
+    })
+
+    const { result } = renderHook(() => {
+      const [state, actions] = store.useStore()
+      return { state, actions }
+    })
+
+    await act(async () => {
+      await result.current.actions.increment(2)
+    })
+
+    expect(result.current.state).toEqual({ count: 2, name: 'Ada' })
+
+    await act(async () => {
+      await result.current.actions.increment(3)
+    })
+
+    expect(result.current.state).not.toBeUndefined()
+    expect(result.current.state).toEqual({ count: 5, name: 'Ada' })
+  })
+
+  test('object_setter_shallow_merges_existing_object_state', async () => {
+    const nested = { stable: true }
+    const store = createStore(() => {
+      const [state, setState] = useModel({
+        count: 1,
+        name: 'Ada',
+        nested
+      })
+      const actions = {
+        updateCount: (count: number) => setState({ count } as any),
+        rename: (name: string) => setState({ name } as any)
+      }
+      return [state, actions] as const
+    })
+
+    const { result } = renderHook(() => {
+      const [state, actions] = store.useStore()
+      return { state, actions }
+    })
+
+    await act(async () => {
+      await result.current.actions.updateCount(5)
+    })
+
+    expect(result.current.state).toEqual({ count: 5, name: 'Ada', nested })
+
+    await act(async () => {
+      await result.current.actions.rename('Grace')
+    })
+
+    expect(result.current.state).toEqual({ count: 5, name: 'Grace', nested })
+  })
+})
diff --git a/__test__/lane/use-model-middleware.spec.ts b/__test__/lane/use-model-middleware.spec.ts
