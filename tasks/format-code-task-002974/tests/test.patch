@@ -2,7 +2,7 @@ import pytest
 from pytest import raises
 
 from vyper import compiler
-from vyper.exceptions import StructureException
+from vyper.exceptions import StructureException, TypeMismatchException
 
 
 fail_list = [
@@ -19,3 +19,113 @@ def test_tuple_return_fail(bad_code):
 
     with raises(StructureException):
             compiler.compile_code(bad_code)
+
+
+
+
+
+
+
+
+
+ISSUE_VERBATIM_EXAMPLE = """
+@public
+def getTimeAndBalance() -> (bool, address):
+    return block.timestamp, self.balance
+"""
+
+
+def test_issue_verbatim_example_rejected():
+    with raises(TypeMismatchException):
+        compiler.compile_code(ISSUE_VERBATIM_EXAMPLE)
+
+
+
+
+def test_single_value_units_mismatch_rejected():
+    code = """
+@public
+def getTime() -> uint256:
+    return block.timestamp
+"""
+    with raises(TypeMismatchException):
+        compiler.compile_code(code)
+
+
+
+def test_tuple_first_element_type_mismatch_rejected():
+    code = """
+@public
+def f() -> (bool, int128):
+    return 1, 2
+"""
+    with raises(TypeMismatchException):
+        compiler.compile_code(code)
+
+
+
+def test_tuple_second_element_type_mismatch_rejected():
+    code = """
+@public
+def f() -> (int128, bool):
+    return 1, 2
+"""
+    with raises(TypeMismatchException):
+        compiler.compile_code(code)
+
+
+
+
+def test_tuple_unit_mismatch_rejected():
+    code = """
+@public
+def f() -> (uint256, uint256):
+    return block.timestamp, self.balance
+"""
+    with raises(TypeMismatchException):
+        compiler.compile_code(code)
+
+
+
+def test_tuple_int_vs_uint_mismatch_rejected():
+    code = """
+@public
+def f() -> (uint256, bool):
+    a: int128 = 1
+    return a, True
+"""
+    with raises(TypeMismatchException):
+        compiler.compile_code(code)
+
+
+
+def test_valid_tuple_return_compiles():
+    code = """
+@public
+def f() -> (int128, bool):
+    return 1, True
+"""
+    assert compiler.compile_code(code) is not None
+
+
+
+def test_valid_three_element_tuple_return_compiles():
+    code = """
+@public
+def f() -> (int128, bool, address):
+    return 1, True, msg.sender
+"""
+    assert compiler.compile_code(code) is not None
+
+
+
+
+
+
+def test_int_literal_to_uint256_in_tuple_compiles():
+    code = """
+@public
+def f() -> (uint256, bool):
+    return 1, True
+"""
+    assert compiler.compile_code(code) is not None
