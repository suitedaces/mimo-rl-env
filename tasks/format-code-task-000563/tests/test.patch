+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+
+npm install --silent
+
+case "${1:-}" in
+  base)
+    NODE_ENV=test npx mocha -b test/lib/transports/ws2-unit.js --grep '_handleOBMessage|_updateManagedOB' --invert
+    ;;
+  new)
+    NODE_ENV=test npx mocha -b test/lib/transports/ws2-lossless-ob.js
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
