diff --git a/src/__tests__/to-have-text-content.js b/src/__tests__/to-have-text-content.js
index 8874c68..0e9a843 100644
--- a/src/__tests__/to-have-text-content.js
+++ b/src/__tests__/to-have-text-content.js
@@ -91,4 +91,43 @@ describe('.toHaveTextContent', () => {
       expect(container.querySelector('span')).toHaveTextContent(''),
     ).toThrowError(/toBeEmptyDOMElement\(\)/)
   })
+
+
+  test('accepts a text node (issue reproduction)', () => {
+    const {container} = render('<span>Resource:</span>libxul.so')
+    const resourceLabel = container.querySelector('span')
+    const valueElement = resourceLabel.nextSibling
+
+
+    expect(valueElement.nodeType).toBe(3)
+    expect(valueElement).toHaveTextContent('libxul.so')
+  })
+
+  test('accepts a text node with regex and negative assertions', () => {
+    const {container} = render('hello world')
+    const textNode = container.firstChild
+
+    expect(textNode.nodeType).toBe(3)
+    expect(textNode).toHaveTextContent('hello world')
+    expect(textNode).toHaveTextContent(/hello/)
+    expect(textNode).not.toHaveTextContent('goodbye')
+  })
+
+  test('accepts a comment node', () => {
+    const {container} = render('<span>parent</span>')
+    const commentNode = container.ownerDocument.createComment('hello comment')
+    container.appendChild(commentNode)
+
+    expect(commentNode.nodeType).toBe(8)
+    expect(commentNode).toHaveTextContent('hello comment')
+    expect(commentNode).not.toHaveTextContent('different content')
+  })
+
+  test('throws when receiving a non-Node value with a textContent property', () => {
+
+
+    expect(() =>
+      expect({textContent: 'libxul.so'}).toHaveTextContent('libxul.so'),
+    ).toThrowError()
+  })
 })
