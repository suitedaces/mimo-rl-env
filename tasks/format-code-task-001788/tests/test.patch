+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+
+go test ./contractcourt/ -count=1
+
+
+go test ./contractcourt/ -run 'TestAnchorSweepDeadline' -count=1
