diff --git a/usercase-test-coderl/test_device_rule.cpp b/usercase-test-coderl/test_device_rule.cpp
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_device_rule.cpp
@@ -0,0 +1,404 @@
+
+
+
+
+
+
+
+#include "usbguard/Device.hpp"
+#include "usbguard/DeviceManager.hpp"
+#include "usbguard/DeviceManagerHooks.hpp"
+#include "usbguard/Rule.hpp"
+#include "usbguard/USB.hpp"
+
+#include <cstdint>
+#include <cstdlib>
+#include <iostream>
+#include <initializer_list>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace
+{
+  class TestHooks : public usbguard::DeviceManagerHooks
+  {
+  public:
+    uint32_t dmHookAssignID() override
+    {
+      return next_id++;
+    }
+
+    void dmHookDeviceException(const std::string& message) override
+    {
+      last_exception = message;
+    }
+
+    uint32_t next_id = 1;
+    std::string last_exception;
+  };
+
+  class TestDeviceManager : public usbguard::DeviceManager
+  {
+  public:
+    explicit TestDeviceManager(usbguard::DeviceManagerHooks& hooks)
+      : usbguard::DeviceManager(hooks)
+    {
+    }
+
+    void setEnumerationOnlyMode(bool) override
+    {
+    }
+
+    void start() override
+    {
+    }
+
+    void stop() override
+    {
+    }
+
+    void scan() override
+    {
+    }
+
+    void scan(const std::string&) override
+    {
+    }
+
+    std::shared_ptr<usbguard::Device> applyDevicePolicy(uint32_t id, usbguard::Rule::Target target) override
+    {
+      auto device = getDevice(id);
+      device->setTarget(target);
+      return device;
+    }
+  };
+
+  class TestDevice : public usbguard::Device
+  {
+  public:
+    explicit TestDevice(usbguard::DeviceManager& manager, std::string system_name = "test-device")
+      : usbguard::Device(manager),
+        _system_name(std::move(system_name))
+    {
+    }
+
+    bool isController() const override
+    {
+      return false;
+    }
+
+    std::string getSystemName() const override
+    {
+      return _system_name;
+    }
+
+  private:
+    std::string _system_name;
+  };
+
+  [[noreturn]] void fail(const std::string& message)
+  {
+    std::cerr << "FAIL: " << message << std::endl;
+    std::exit(1);
+  }
+
+  void expect_equal(const std::string& name, const std::string& actual, const std::string& expected)
+  {
+    if (actual != expected) {
+      fail(name + "\nexpected: " + expected + "\nactual:   " + actual);
+    }
+  }
+
+  void expect_equal(const std::string& name, uint32_t actual, uint32_t expected)
+  {
+    if (actual != expected) {
+      fail(name + "\nexpected: " + std::to_string(expected) + "\nactual:   " + std::to_string(actual));
+    }
+  }
+
+  void expect_true(const std::string& name, bool value)
+  {
+    if (!value) {
+      fail(name);
+    }
+  }
+
+  void expect_contains(const std::string& name, const std::string& actual, const std::string& needle)
+  {
+    if (actual.find(needle) == std::string::npos) {
+      fail(name + "\nexpected substring: " + needle + "\nactual: " + actual);
+    }
+  }
+
+  void expect_not_contains(const std::string& name, const std::string& actual, const std::string& needle)
+  {
+    if (actual.find(needle) != std::string::npos) {
+      fail(name + "\nunexpected substring: " + needle + "\nactual: " + actual);
+    }
+  }
+
+  void expect_interface_types(
+    const std::string& name,
+    const usbguard::Rule& rule,
+    std::initializer_list<const char*> expected_values)
+  {
+    const auto& interfaces = rule.attributeWithInterface();
+    expect_equal(name + " interface count", static_cast<uint32_t>(interfaces.count()), static_cast<uint32_t>(expected_values.size()));
+
+    size_t index = 0;
+
+    for (const char* expected : expected_values) {
+      expect_equal(name + " interface " + std::to_string(index), interfaces.get(index).toRuleString(), expected);
+      ++index;
+    }
+  }
+
+  void expect_device_rule_fields(
+    const std::string& name,
+    const usbguard::Rule& rule,
+    uint32_t expected_id,
+    usbguard::Rule::Target expected_target,
+    const std::string& expected_device_id,
+    const std::string& expected_serial,
+    const std::string& expected_name,
+    const std::string& expected_hash,
+    const std::string& expected_connect_type,
+    std::initializer_list<const char*> expected_interfaces)
+  {
+    expect_equal(name + " id", rule.getRuleID(), expected_id);
+    expect_equal(name + " target", usbguard::Rule::targetToString(rule.getTarget()), usbguard::Rule::targetToString(expected_target));
+    expect_equal(name + " USB ID", rule.getDeviceID().toRuleString(), expected_device_id);
+    expect_equal(name + " serial", rule.getSerial(), expected_serial);
+    expect_equal(name + " name", rule.getName(), expected_name);
+    expect_equal(name + " hash", rule.getHash(), expected_hash);
+    expect_equal(name + " connect type", rule.getWithConnectType(), expected_connect_type);
+    expect_interface_types(name, rule, expected_interfaces);
+  }
+
+  void expect_serialized_identity_fields(
+    const std::string& name,
+    const usbguard::Rule& rule,
+    std::initializer_list<const char*> expected_fragments)
+  {
+    const std::string serialized = rule.toString();
+
+    for (const char* fragment : expected_fragments) {
+      expect_contains(name + " serialized fragment", serialized, fragment);
+    }
+  }
+
+  std::string populate_primary_device(TestDevice& device)
+  {
+    device.setID(7);
+    device.setTarget(usbguard::Rule::Target::Allow);
+    device.setDeviceID(usbguard::USBDeviceID("1234", "abcd"));
+    device.setSerial("S123");
+    device.setName("Example Keyboard");
+    device.setConnectType("hotplug");
+    device.setPort("1-2");
+    device.refMutableInterfaceTypes().push_back(usbguard::USBInterfaceType("03:01:01"));
+    device.refMutableInterfaceTypes().push_back(usbguard::USBInterfaceType("03:00:00"));
+    device.initializeHash();
+    const char descriptor_bytes[] = "fixture-descriptor-bytes";
+    device.updateHash(descriptor_bytes, sizeof(descriptor_bytes) - 1);
+    const std::string hash = device.finalizeHash();
+
+    expect_true("primary finalized hash is non-empty", !hash.empty());
+    return hash;
+  }
+
+  std::string populate_second_device(TestDevice& device)
+  {
+    device.setID(8);
+    device.setTarget(usbguard::Rule::Target::Allow);
+    device.setDeviceID(usbguard::USBDeviceID("4321", "dcba"));
+    device.setSerial("S999");
+    device.setName("Backup Keyboard");
+    device.setConnectType("hotplug");
+    device.setPort("2-3");
+    device.refMutableInterfaceTypes().push_back(usbguard::USBInterfaceType("03:00:00"));
+    device.refMutableInterfaceTypes().push_back(usbguard::USBInterfaceType("03:01:01"));
+    device.initializeHash();
+    const char descriptor_bytes[] = "fixture-second-descriptor-bytes";
+    device.updateHash(descriptor_bytes, sizeof(descriptor_bytes) - 1);
+    const std::string hash = device.finalizeHash();
+
+    expect_true("second finalized hash is non-empty", !hash.empty());
+    return hash;
+  }
+
+  std::string populate_parent_device(TestDevice& device)
+  {
+    device.setDeviceID(usbguard::USBDeviceID("9999", "0001"));
+    device.setSerial("PARENT");
+    device.setName("Parent Hub");
+    device.initializeHash();
+    const char descriptor_bytes[] = "parent-descriptor";
+    device.updateHash(descriptor_bytes, sizeof(descriptor_bytes) - 1);
+    const std::string hash = device.finalizeHash();
+
+    expect_true("parent finalized hash is non-empty", !hash.empty());
+    return hash;
+  }
+
+  void test_explicit_parent_rule_and_match_rule()
+  {
+
+
+
+
+    TestHooks hooks;
+    TestDeviceManager manager(hooks);
+    TestDevice device(manager);
+    const std::string device_hash = populate_primary_device(device);
+    device.setParentHash("parentHash");
+
+    const auto full_rule = device.getDeviceRule(true, true, false);
+
+    expect_device_rule_fields("full rule", *full_rule, 7, usbguard::Rule::Target::Allow, "1234:abcd", "S123", "Example Keyboard", device_hash, "hotplug", { "03:01:01", "03:00:00" });
+    expect_equal("full rule parent hash", full_rule->getParentHash(), "parentHash");
+    expect_equal("full rule port", full_rule->getViaPort(), "1-2");
+    expect_serialized_identity_fields("full rule", *full_rule, {
+      "allow",
+      "id 1234:abcd",
+      "serial \"S123\"",
+      "name \"Example Keyboard\"",
+      "parent-hash \"parentHash\"",
+      "via-port \"1-2\"",
+      "with-interface { 03:01:01 03:00:00 }",
+      "with-connect-type \"hotplug\""
+    });
+    expect_contains("full rule serialized hash", full_rule->toString(), "hash \"" + device_hash + "\"");
+
+
+
+
+
+    const auto match_rule = device.getDeviceRule(false, false, true);
+
+    expect_device_rule_fields("match rule", *match_rule, 7, usbguard::Rule::Target::Match, "1234:abcd", "S123", "Example Keyboard", device_hash, "hotplug", { "03:01:01", "03:00:00" });
+    expect_true("match rule port attribute is empty", match_rule->attributeViaPort().empty());
+    expect_true("match rule parent hash attribute is empty", match_rule->attributeParentHash().empty());
+    expect_serialized_identity_fields("match rule", *match_rule, {
+      "match",
+      "id 1234:abcd",
+      "serial \"S123\"",
+      "name \"Example Keyboard\"",
+      "with-interface { 03:01:01 03:00:00 }",
+      "with-connect-type \"hotplug\""
+    });
+    expect_contains("match rule serialized hash", match_rule->toString(), "hash \"" + device_hash + "\"");
+    expect_not_contains("match rule omits port", match_rule->toString(), "via-port");
+    expect_not_contains("match rule omits parent hash", match_rule->toString(), "parent-hash");
+  }
+
+  void test_parent_hash_falls_back_to_manager_device()
+  {
+
+
+
+
+    TestHooks hooks;
+    TestDeviceManager manager(hooks);
+    auto parent = std::make_shared<TestDevice>(manager, "parent");
+    const std::string parent_hash = populate_parent_device(*parent);
+    manager.insertDevice(parent);
+
+    TestDevice child(manager, "child");
+    const std::string child_hash = populate_primary_device(child);
+    child.setParentID(parent->getID());
+
+    const auto inherited_rule = child.getDeviceRule(true, true, false);
+
+    expect_device_rule_fields("rule with inherited parent hash", *inherited_rule, 7, usbguard::Rule::Target::Allow, "1234:abcd", "S123", "Example Keyboard", child_hash, "hotplug", { "03:01:01", "03:00:00" });
+    expect_equal("rule with inherited parent hash", inherited_rule->getParentHash(), parent_hash);
+    expect_equal("rule with inherited parent port", inherited_rule->getViaPort(), "1-2");
+    expect_contains("rule with inherited parent hash serialized", inherited_rule->toString(), "parent-hash \"" + parent_hash + "\"");
+  }
+
+  void test_root_without_parent_hash_throws_runtime_error()
+  {
+
+
+
+
+    TestHooks hooks;
+    TestDeviceManager manager(hooks);
+    TestDevice device(manager);
+    populate_primary_device(device);
+
+    bool threw_runtime_error = false;
+
+    try {
+      (void)device.getDeviceRule(true, true, false);
+    }
+    catch (const std::runtime_error&) {
+      threw_runtime_error = true;
+    }
+    catch (...) {
+      fail("root parent without explicit parent hash threw a non-runtime_error exception");
+    }
+
+
+    expect_true("root parent without explicit parent hash throws std::runtime_error", threw_runtime_error);
+  }
+
+  void test_independent_devices_do_not_share_identity_state()
+  {
+
+
+
+
+    TestHooks hooks;
+    TestDeviceManager manager(hooks);
+    TestDevice a(manager, "a");
+    TestDevice b(manager, "b");
+    const std::string hash_a = populate_primary_device(a);
+    const std::string hash_b = populate_second_device(b);
+    a.setParentHash("parentHash");
+    b.setParentHash("parentB");
+
+    const auto rule_a = a.getDeviceRule(true, true, false);
+    const auto rule_b = b.getDeviceRule(true, true, false);
+
+    expect_device_rule_fields("first device rule remains primary", *rule_a, 7, usbguard::Rule::Target::Allow, "1234:abcd", "S123", "Example Keyboard", hash_a, "hotplug", { "03:01:01", "03:00:00" });
+    expect_equal("first device parent hash", rule_a->getParentHash(), "parentHash");
+    expect_equal("first device port", rule_a->getViaPort(), "1-2");
+    expect_device_rule_fields("second device rule uses only second-device state", *rule_b, 8, usbguard::Rule::Target::Allow, "4321:dcba", "S999", "Backup Keyboard", hash_b, "hotplug", { "03:00:00", "03:01:01" });
+    expect_equal("second device parent hash", rule_b->getParentHash(), "parentB");
+    expect_equal("second device port", rule_b->getViaPort(), "2-3");
+  }
+
+  void test_raii_leak_floor_for_repeated_rule_generation()
+  {
+
+
+
+
+    for (int i = 0; i < 150; ++i) {
+      TestHooks hooks;
+      TestDeviceManager manager(hooks);
+      TestDevice device(manager);
+      const std::string device_hash = populate_primary_device(device);
+      device.setParentHash("parentHash");
+      const auto rule = device.getDeviceRule(true, true, false);
+
+      expect_device_rule_fields("cycle rule", *rule, 7, usbguard::Rule::Target::Allow, "1234:abcd", "S123", "Example Keyboard", device_hash, "hotplug", { "03:01:01", "03:00:00" });
+      expect_true("cycle rule carries parent hash", rule->toString().find("parent-hash \"parentHash\"") != std::string::npos);
+    }
+  }
+}
+
+int main()
+{
+  test_explicit_parent_rule_and_match_rule();
+  test_parent_hash_falls_back_to_manager_device();
+  test_root_without_parent_hash_throws_runtime_error();
+  test_independent_devices_do_not_share_identity_state();
+  test_raii_leak_floor_for_repeated_rule_generation();
+  std::cout << "device rule acceptance tests passed" << std::endl;
+  return 0;
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+if [[ ! -x ./configure ]]; then
+  if [[ ! -f src/ThirdParty/Catch/single_include/catch2/catch.hpp ]] || \
+     [[ ! -f src/ThirdParty/PEGTL/include/tao/pegtl.hpp ]]; then
+    echo "required bundled C++ test dependencies are not present locally" >&2
+    exit 1
+  fi
+  mkdir -p ./m4
+  autoreconf -i -s --no-recursive ./ >/dev/null
+fi
+
+if [[ ! -f Makefile ]]; then
+  ./configure \
+    --disable-systemd \
+    --without-dbus \
+    --without-polkit \
+    --without-ldap \
+    --with-bundled-catch \
+    --with-bundled-pegtl \
+    --prefix=/workspace/repo/.fixture-install >/dev/null
+fi
+
+make src/build-config.h >/dev/null
+make -j"$(nproc)" libusbguard.la >/dev/null
+
+g++ -std=c++17 -DHAVE_BUILD_CONFIG_H \
+  -I/workspace/repo/src \
+  -I/workspace/repo/src/Library/public \
+  /workspace/repo/usercase-test-coderl/test_device_rule.cpp \
+  -L/workspace/repo/.libs \
+  -Wl,-rpath,/workspace/repo/.libs \
+  -lusbguard \
+  $(pkg-config --libs libqb libsodium protobuf umockdev-1.0 libseccomp libcap-ng) \
+  -o /workspace/repo/usercase-test-coderl/test_device_rule
+
+exec /workspace/repo/usercase-test-coderl/test_device_rule
