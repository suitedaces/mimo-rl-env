+from __future__ import unicode_literals
+
+import json
+
+from django.http import Http404, HttpResponse
+from django.test import RequestFactory, SimpleTestCase, override_settings
+
+from django_ajax.decorators import ajax
+from django_ajax.middleware import AJAXMiddleware
+from django_ajax.response import JSONResponse
+from django_ajax.shortcuts import render_to_json
+
+
+class _Marker(object):
+    pass
+
+
+class _MarkerEncoder(json.JSONEncoder):
+    def default(self, value):
+        if isinstance(value, _Marker):
+            return 'marker-value'
+        return super(_MarkerEncoder, self).default(value)
+
+
+class AJAXContractTestCase(SimpleTestCase):
+    def setUp(self):
+        self.factory = RequestFactory()
+        self.ajax_request = self.factory.get(
+            '/', HTTP_X_REQUESTED_WITH='XMLHttpRequest')
+        self.browser_request = self.factory.get('/')
+
+    def decode(self, response):
+        return json.loads(response.content.decode('utf-8'))
+
+    def test_render_to_json_accepts_request_context_for_http404(self):
+        response = render_to_json(
+            Http404('record missing'), request=self.ajax_request)
+        payload = self.decode(response)
+
+        self.assertEqual(404, payload['status'])
+        self.assertEqual('NOT FOUND', payload['statusText'])
+        self.assertEqual('record missing', payload['content'])
+
+    @override_settings(DEBUG=False)
+    def test_ajax_decorator_serializes_view_exceptions(self):
+        @ajax
+        def missing(request):
+            raise Http404('gone')
+
+        @ajax
+        def broken(request):
+            raise ValueError('secret failure')
+
+        missing_payload = self.decode(missing(self.ajax_request))
+        broken_payload = self.decode(broken(self.ajax_request))
+
+        self.assertEqual(404, missing_payload['status'])
+        self.assertEqual('gone', missing_payload['content'])
+        self.assertEqual(500, broken_payload['status'])
+        self.assertNotIn('secret failure', broken_payload['content'])
+        self.assertNotIn('Traceback', broken_payload['content'])
+
+    def test_ajax_decorator_preserves_response_status_in_envelope(self):
+        @ajax
+        def created(request):
+            return HttpResponse('created', status=201)
+
+        payload = self.decode(created(self.ajax_request))
+        self.assertEqual(201, payload['status'])
+        self.assertEqual('CREATED', payload['statusText'])
+        self.assertEqual('created', payload['content'])
+
+    def test_middleware_does_not_double_wrap_json_responses(self):
+        middleware = AJAXMiddleware(lambda request: None)
+        original = JSONResponse(
+            {'status': 200, 'statusText': 'OK', 'content': {'ok': True}})
+
+        response = middleware.process_response(self.ajax_request, original)
+
+        self.assertEqual(self.decode(original), self.decode(response))
+
+    def test_middleware_converts_ajax_http404_but_leaves_browser_response(self):
+        middleware = AJAXMiddleware(lambda request: None)
+        ajax_response_payload = self.decode(
+            middleware.process_response(
+                self.ajax_request, HttpResponse('accepted', status=202)))
+        ajax_payload = self.decode(
+            middleware.process_response(
+                self.ajax_request, Http404('missing through middleware')))
+        browser_response = HttpResponse('normal', status=418)
+
+        self.assertEqual(202, ajax_response_payload['status'])
+        self.assertEqual('accepted', ajax_response_payload['content'])
+        self.assertEqual(404, ajax_payload['status'])
+        self.assertEqual('missing through middleware', ajax_payload['content'])
+        untouched = middleware.process_response(self.browser_request,
+                                                browser_response)
+        self.assertEqual(418, untouched.status_code)
+        self.assertEqual(b'normal', untouched.content)
+
+    @override_settings(DEBUG=False)
+    def test_middleware_exception_path_returns_safe_ajax_error(self):
+        middleware = AJAXMiddleware(lambda request: None)
+        exception = ValueError('private details')
+
+        response = middleware.process_exception(self.ajax_request, exception)
+        payload = self.decode(
+            middleware.process_response(self.ajax_request, response))
+
+        self.assertEqual(500, payload['status'])
+        self.assertNotIn('private details', payload['content'])
+        self.assertIsNone(middleware.process_exception(self.browser_request,
+                                                        exception))
+
+    def test_optional_decorator_passthrough_and_default_mandatory_guard(self):
+        @ajax(mandatory=False)
+        def optional(request):
+            return {'plain': True}
+
+        @ajax
+        def required(request):
+            return {'plain': True}
+
+        self.assertEqual({'plain': True}, optional(self.browser_request))
+        self.assertEqual(400, required(self.browser_request).status_code)
+
+    def test_render_to_json_keeps_json_encoder_options(self):
+        response = render_to_json(
+            {'value': _Marker()}, cls=_MarkerEncoder, sort_keys=True)
+        payload = self.decode(response)
+
+        self.assertEqual('marker-value', payload['content']['value'])
