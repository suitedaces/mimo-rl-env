+
+
+
+
+
+
+import copy
+import json
+import os
+import socket
+import subprocess
+import sys
+
+import pytest
+from openbabel import openbabel as ob
+
+import ligan
+from ligan.atom_types import AtomTyper, DefaultLigTyper, DefaultRecTyper
+
+
+LIGAND_OADC_NAMES = [
+    "atomic_num=5",
+    "atomic_num=6",
+    "atomic_num=7",
+    "atomic_num=8",
+    "atomic_num=9",
+    "atomic_num=15",
+    "atomic_num=16",
+    "atomic_num=17",
+    "atomic_num=35",
+    "atomic_num=53",
+    "atomic_num=26",
+    "aromatic=0",
+    "aromatic=1",
+    "h_acceptor=1",
+    "h_donor=1",
+    "formal_charge=-1",
+    "formal_charge=0",
+    "formal_charge=1",
+]
+
+RECEPTOR_ELEMENTS_ONLY_NAMES = [
+    "atomic_num=6",
+    "atomic_num=7",
+    "atomic_num=8",
+    "atomic_num=11",
+    "atomic_num=12",
+    "atomic_num=15",
+    "atomic_num=16",
+    "atomic_num=17",
+    "atomic_num=19",
+    "atomic_num=20",
+    "atomic_num=30",
+]
+
+RECEPTOR_OADC_NAMES = [
+    "atomic_num=6",
+    "atomic_num=7",
+    "atomic_num=8",
+    "atomic_num=11",
+    "atomic_num=12",
+    "atomic_num=15",
+    "atomic_num=16",
+    "atomic_num=17",
+    "atomic_num=19",
+    "atomic_num=20",
+    "atomic_num=30",
+    "aromatic=0",
+    "aromatic=1",
+    "h_acceptor=1",
+    "h_donor=1",
+    "formal_charge=-1",
+    "formal_charge=0",
+    "formal_charge=1",
+]
+
+EXPLICIT_H_HCOUNT_NAMES = [
+    "atomic_num=1",
+    "atomic_num=5",
+    "atomic_num=6",
+    "atomic_num=7",
+    "atomic_num=8",
+    "atomic_num=9",
+    "atomic_num=15",
+    "atomic_num=16",
+    "atomic_num=17",
+    "atomic_num=35",
+    "atomic_num=53",
+    "atomic_num=26",
+    "h_count=0",
+    "h_count=1",
+    "h_count=2",
+    "h_count=3",
+    "h_count=4",
+]
+
+
+def make_atom(atomic_num):
+    atom = ob.OBAtom()
+    atom.SetAtomicNum(atomic_num)
+    return atom
+
+
+def typer_summary(typer):
+
+    return {
+        "names": list(typer.get_type_names()),
+        "n_types": typer.n_types,
+        "device": str(typer.device),
+        "radius_h": typer.get_radius(make_atom(1)),
+        "radius_c": typer.get_radius(make_atom(6)),
+        "radius_fe": typer.get_radius(make_atom(26)),
+    }
+
+
+def test_ligand_oadc_fixed_radius_channels():
+
+
+
+
+    typer = AtomTyper.get_typer("oadc", 1.0, rec=False, device="cpu")
+
+    names = list(typer.get_type_names())
+    assert names == LIGAND_OADC_NAMES
+    assert typer.n_types == 18
+
+    assert typer.n_elem_types + typer.n_prop_types == typer.n_types
+
+    assert "atomic_num=1" not in names
+    assert typer.get_radius(make_atom(1)) == 1.0
+    assert typer.get_radius(make_atom(6)) == 1.0
+    assert typer.get_radius(make_atom(26)) == 1.0
+
+
+def test_receptor_empty_props_uses_receptor_elements_only():
+
+
+
+
+    typer = AtomTyper.get_typer("", 1.0, rec=True, device="cpu")
+
+    names = list(typer.get_type_names())
+    assert names == RECEPTOR_ELEMENTS_ONLY_NAMES
+    assert typer.n_types == 11
+
+    assert typer.n_elem_types + typer.n_prop_types == typer.n_types
+
+    assert all(name.startswith("atomic_num=") for name in names)
+    assert typer.get_radius(make_atom(30)) == 1.0
+
+
+def test_explicit_h_and_h_count_channels():
+
+
+
+
+    typer = AtomTyper.get_typer("hn", 2.5, rec=False, device="cpu")
+
+    names = list(typer.get_type_names())
+
+    assert names[0] == "atomic_num=1"
+    assert set(names) == set(EXPLICIT_H_HCOUNT_NAMES)
+    assert len(names) == len(EXPLICIT_H_HCOUNT_NAMES)
+    assert typer.n_types == len(names)
+
+    assert typer.n_elem_types + typer.n_prop_types == typer.n_types
+    assert typer.explicit_h is True
+    assert typer.get_radius(make_atom(1)) == 2.5
+    assert typer.get_radius(make_atom(6)) == 2.5
+
+
+def test_van_der_waals_radius_code():
+
+
+
+
+    typer = AtomTyper.get_typer("", "v", rec=False, device="cpu")
+
+    assert list(typer.get_type_names()) == [
+        "atomic_num=5",
+        "atomic_num=6",
+        "atomic_num=7",
+        "atomic_num=8",
+        "atomic_num=9",
+        "atomic_num=15",
+        "atomic_num=16",
+        "atomic_num=17",
+        "atomic_num=35",
+        "atomic_num=53",
+        "atomic_num=26",
+    ]
+
+    for atomic_num in (1, 6, 26):
+        assert typer.get_radius(make_atom(atomic_num)) == pytest.approx(
+            ob.GetVdwRad(atomic_num), rel=0.2, abs=1e-6
+        )
+
+
+def test_covalent_radius_code():
+
+
+
+
+    typer = AtomTyper.get_typer("", "c", rec=False, device="cpu")
+
+    assert list(typer.get_type_names()) == [
+        "atomic_num=5",
+        "atomic_num=6",
+        "atomic_num=7",
+        "atomic_num=8",
+        "atomic_num=9",
+        "atomic_num=15",
+        "atomic_num=16",
+        "atomic_num=17",
+        "atomic_num=35",
+        "atomic_num=53",
+        "atomic_num=26",
+    ]
+
+    for atomic_num in (1, 6, 26):
+        assert typer.get_radius(make_atom(atomic_num)) == pytest.approx(
+            ob.GetCovalentRad(atomic_num), rel=0.2, abs=1e-6
+        )
+
+
+def test_default_rec_and_lig_shortcuts():
+
+
+
+
+    rec_typer = AtomTyper.get_default_rec_typer(device="cpu")
+    lig_typer = AtomTyper.get_default_lig_typer(device="cpu")
+
+    assert list(rec_typer.get_type_names()) == RECEPTOR_OADC_NAMES
+    assert rec_typer.n_types == 18
+    assert rec_typer.get_radius(make_atom(6)) == 1.0
+    assert list(lig_typer.get_type_names()) == LIGAND_OADC_NAMES
+    assert lig_typer.n_types == 18
+    assert lig_typer.get_radius(make_atom(6)) == 1.0
+
+
+def test_default_aliases_exported_from_both_public_modules():
+
+
+
+
+    assert callable(DefaultRecTyper)
+    assert callable(DefaultLigTyper)
+    assert callable(ligan.DefaultRecTyper)
+    assert callable(ligan.DefaultLigTyper)
+
+    assert list(DefaultRecTyper(device="cpu").get_type_names()) == RECEPTOR_OADC_NAMES
+    assert list(DefaultLigTyper(device="cpu").get_type_names()) == LIGAND_OADC_NAMES
+    assert list(ligan.DefaultRecTyper(device="cpu").get_type_names()) == RECEPTOR_OADC_NAMES
+    assert list(ligan.DefaultLigTyper(device="cpu").get_type_names()) == LIGAND_OADC_NAMES
+
+
+def test_invalid_prop_funcs_none_raises_type_error():
+
+
+
+
+
+    with pytest.raises(TypeError):
+        AtomTyper.get_typer(None, 1.0, rec=False, device="cpu")
+
+
+def test_referential_transparency_same_input_same_value():
+    first = typer_summary(AtomTyper.get_typer("hn", 2.5, rec=False, device="cpu"))
+    second = typer_summary(AtomTyper.get_typer("hn", 2.5, rec=False, device="cpu"))
+
+    assert first == second
+
+
+def test_factory_does_not_mutate_inputs_or_module_defaults():
+    kwargs = {"prop_funcs": "hn", "radius_func": 2.5, "rec": False, "device": "cpu"}
+    before_kwargs = copy.deepcopy(kwargs)
+
+    before_lig_range = list(AtomTyper.lig_elem_range)
+    before_rec_range = list(AtomTyper.rec_elem_range)
+
+    AtomTyper.get_typer(**kwargs)
+
+    assert kwargs == before_kwargs
+    assert list(AtomTyper.lig_elem_range) == before_lig_range
+    assert list(AtomTyper.rec_elem_range) == before_rec_range
+
+
+def test_factory_calls_are_independent_and_fresh_process_equivalent():
+    first = AtomTyper.get_typer("oadc", 1.0, rec=False, device="cpu")
+    noisy = AtomTyper.get_typer("hn", 2.5, rec=False, device="cpu")
+    other = AtomTyper.get_typer("", "v", rec=True, device="cpu")
+    second = AtomTyper.get_typer("oadc", 1.0, rec=False, device="cpu")
+
+    assert first is not second
+    assert noisy is not other
+
+    assert typer_summary(first) == {
+        "names": LIGAND_OADC_NAMES,
+        "n_types": 18,
+        "device": "cpu",
+        "radius_h": 1.0,
+        "radius_c": 1.0,
+        "radius_fe": 1.0,
+    }
+    assert typer_summary(second) == typer_summary(first)
+
+    script = """
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+from openbabel import openbabel as ob
+from ligan.atom_types import AtomTyper
+def make_atom(atomic_num):
+    atom = ob.OBAtom()
+    atom.SetAtomicNum(atomic_num)
+    return atom
+typer = AtomTyper.get_typer("oadc", 1.0, rec=False, device="cpu")
+#
+out = {
+    "names": list(typer.get_type_names()),
+    "n_types": typer.n_types,
+    "device": str(typer.device),
+    "radius_h": typer.get_radius(make_atom(1)),
+    "radius_c": typer.get_radius(make_atom(6)),
+    "radius_fe": typer.get_radius(make_atom(26)),
+}
+sys.stdout.write(json.dumps(out, sort_keys=True))
+"""
+    proc = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+
+    assert json.loads(proc.stdout) == typer_summary(first)
+
+
+def test_factory_has_no_undeclared_filesystem_or_network_side_effects(tmp_path, monkeypatch):
+    def blocked_socket(*args, **kwargs):
+        raise AssertionError("AtomTyper.get_typer attempted to create a network socket")
+
+    def snapshot():
+        return sorted(
+            str(path.relative_to(tmp_path))
+            for path in tmp_path.rglob("*")
+            if path.exists()
+        )
+
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr(socket, "socket", blocked_socket)
+    before = snapshot()
+
+    typer = AtomTyper.get_typer("oadc", 1.0, rec=False, device="cpu")
+
+    assert list(typer.get_type_names()) == LIGAND_OADC_NAMES
+    assert snapshot() == before
+    assert os.getcwd() == str(tmp_path)
