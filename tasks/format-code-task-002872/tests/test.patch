--- a/tests/config/loader/ini/test_factor.py
+++ b/tests/config/loader/ini/test_factor.py
@@ -213,3 +213,98 @@ def test_multiple_factor_match(tox_ini_conf: ToxIniCreator) -> None:
     env_config.add_config(keys="conf", of_type=str, default="", desc="conf")
     deps = env_config["conf"]
     assert deps == "x"
+
+
+def test_envlist_with_globbed_non_testenv_section(tox_ini_conf: ToxIniCreator) -> None:
+    """A non-testenv section whose header contains glob/invalid factor chars must not crash tox -l."""
+    config = tox_ini_conf(
+        dedent(
+            """
+            [tox]
+            env_list = py38, py39
+
+            [mypy-rest_framework.compat.*]
+            ignore_errors = True
+
+            [testenv]
+            deps = pytest
+            """,
+        ),
+    )
+    result = list(config)
+    assert result == ["py38", "py39"]
+
+
+def test_envlist_with_multiple_globbed_non_testenv_sections(tox_ini_conf: ToxIniCreator) -> None:
+    """Multiple non-testenv sections with glob/invalid factor characters must not crash."""
+    config = tox_ini_conf(
+        dedent(
+            """
+            [tox]
+            env_list = py38
+
+            [mypy-rest_framework.compat.*]
+            ignore_errors = True
+
+            [mypy-other.module.*]
+            ignore_errors = True
+
+            [flake8]
+            max-line-length = 100
+            """,
+        ),
+    )
+    result = list(config)
+    assert result == ["py38"]
+
+
+def test_envlist_globbed_section_does_not_pollute_factor_discovery(
+    tox_ini_conf: ToxIniCreator,
+) -> None:
+    """A non-testenv globbed section's header must NOT register factors that hide testenv factor filters.
+
+    The reference fix excludes non-testenv sections from factor discovery entirely; before the fix
+    the 'mypy' token from [mypy-foo.*] would crash (it could not be parsed). Even with naive
+    fall-through fixes, 'mypy' must not become a known factor — otherwise the 'mypy:' factor filter
+    inside [testenv] would be filtered out and the implicit 'mypy' env would not be discovered.
+    """
+    config = tox_ini_conf(
+        dedent(
+            """
+            [tox]
+            env_list = py38
+
+            [mypy-rest_framework.compat.*]
+            ignore_errors = True
+
+            [testenv]
+            commands =
+                mypy: echo mypy
+            """,
+        ),
+    )
+    result = list(config)
+    assert "mypy" in result
+    assert "py38" in result
+
+
+def test_envlist_globbed_section_preserves_testenv_generative_expansion(
+    tox_ini_conf: ToxIniCreator,
+) -> None:
+    """Generative testenv section expansion must still work alongside a globbed non-testenv section."""
+    config = tox_ini_conf(
+        dedent(
+            """
+            [tox]
+            env_list = py38
+
+            [mypy-rest_framework.compat.*]
+            ignore_errors = True
+
+            [testenv:{py310,py311}-{black,lint}]
+            deps = pytest
+            """,
+        ),
+    )
+    result = list(config)
+    assert result == ["py38", "py310-black", "py310-lint", "py311-black", "py311-lint"]
