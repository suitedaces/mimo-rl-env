diff --git a/src/helper/css/index.test.tsx b/src/helper/css/index.test.tsx
index 679f99e1..a76fe90a 100644
--- a/src/helper/css/index.test.tsx
+++ b/src/helper/css/index.test.tsx
@@ -251,4 +251,78 @@ d.replaceWith(c.content)
       )
     })
   })
+
+  describe('CSP nonce support', () => {
+    it('Should render CSS styles with CSP nonce', async () => {
+      const { css: cssCtx, Style: StyleCtx } = createCssContext({ id: 'nonce-ctx-1' })
+      const headerClass = cssCtx`
+        background-color: blue;
+      `
+      const template = (
+        <>
+          <StyleCtx nonce='1234' />
+          <h1 class={headerClass}>Hello!</h1>
+        </>
+      )
+      expect(await toString(template)).toBe(
+        '<style id="nonce-ctx-1" nonce="1234">.css-2458908649{background-color:blue}</style><h1 class="css-2458908649">Hello!</h1>'
+      )
+    })
+
+    it('Should render empty Style tag with nonce when no css used', async () => {
+      const { Style: StyleCtx } = createCssContext({ id: 'nonce-ctx-2' })
+      const template = (
+        <>
+          <StyleCtx nonce='abc' />
+        </>
+      )
+      expect(await toString(template)).toBe('<style id="nonce-ctx-2" nonce="abc"></style>')
+    })
+
+    it('Should not include nonce attribute when not provided', async () => {
+      const { css: cssCtx, Style: StyleCtx } = createCssContext({ id: 'nonce-ctx-3' })
+      const headerClass = cssCtx`
+        background-color: blue;
+      `
+      const template = (
+        <>
+          <StyleCtx />
+          <h1 class={headerClass}>Hello!</h1>
+        </>
+      )
+      expect(await toString(template)).toBe(
+        '<style id="nonce-ctx-3">.css-2458908649{background-color:blue}</style><h1 class="css-2458908649">Hello!</h1>'
+      )
+    })
+
+    it('Should propagate nonce to streaming <script> for appended CSS', async () => {
+      const { css: cssCtx, Style: StyleCtx } = createCssContext({ id: 'nonce-stream' })
+      const headerClass = cssCtx`
+        background-color: blue;
+      `
+      const app = new Hono()
+      app.get('/nonce-stream', (c) => {
+        const stream = renderToReadableStream(
+          <>
+            <StyleCtx nonce='xyz' />
+            <Suspense fallback={<p>Loading...</p>}>
+              <h1 class={headerClass}>Hello!</h1>
+            </Suspense>
+          </>
+        )
+        return c.body(stream, {
+          headers: {
+            'Content-Type': 'text/html; charset=UTF-8',
+            'Transfer-Encoding': 'chunked',
+          },
+        })
+      })
+      const res = await app.request('http://localhost/nonce-stream')
+      const text = await res.text()
+      expect(text).toContain('<style id="nonce-stream" nonce="xyz"></style>')
+      expect(text).toContain(
+        '<script nonce="xyz">document.querySelector(\'#nonce-stream\').textContent+=".css-2458908649{background-color:blue}"</script>'
+      )
+    })
+  })
 })
