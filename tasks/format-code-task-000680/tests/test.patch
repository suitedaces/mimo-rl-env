+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export PYTHONPATH="/workspace/repo${PYTHONPATH:+:${PYTHONPATH}}"
+export is_test_suite=True
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+
+python - <<'PY'
+import importlib.util
+import sys
+
+missing = [
+    module
+    for module in (
+        "pytest",
+        "numpy",
+        "pandas",
+        "sklearn",
+        "scipy",
+        "dill",
+        "h5py",
+        "lightgbm",
+        "pathos",
+        "dateutil",
+        "evolutionary_search",
+        "deap",
+        "tabulate",
+    )
+    if importlib.util.find_spec(module) is None
+]
+if missing:
+    raise SystemExit("Missing offline Python dependencies: " + ", ".join(missing))
+PY
+
+exec python -m pytest /workspace/repo/usercase-test-coderl/test_regression_uncertainty.py -v
