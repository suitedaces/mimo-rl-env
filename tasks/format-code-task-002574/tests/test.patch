diff --git a/usercase-test-coderl/export_interaction_test.go b/usercase-test-coderl/export_interaction_test.go
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/export_interaction_test.go
@@ -0,0 +1,374 @@
+package usercase_test_coderl
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/gdamore/tcell/v2"
+	"github.com/sambigeara/fuzzynote/pkg/service"
+	"github.com/sambigeara/fuzzynote/pkg/term"
+)
+
+
+
+
+
+type exportSession struct {
+	repo    *service.DBListRepo
+	client  *service.ClientBase
+	rootDir string
+	cwd     string
+	oldWd   string
+}
+
+func newExportSession(t *testing.T) *exportSession {
+	t.Helper()
+
+	rootDir := t.TempDir()
+	cwd := t.TempDir()
+	oldWd, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("get working directory: %v", err)
+	}
+	if err := os.Chdir(cwd); err != nil {
+		t.Fatalf("change working directory: %v", err)
+	}
+
+	repo := service.NewDBListRepo(service.NewLocalFileWalFile(rootDir), service.NewFileWebTokenStore(rootDir))
+	return &exportSession{
+		repo:    repo,
+		client:  service.NewClientBase(repo, 80, 24, true),
+		rootDir: rootDir,
+		cwd:     cwd,
+		oldWd:   oldWd,
+	}
+}
+
+func (s *exportSession) close(t *testing.T) {
+	t.Helper()
+	if err := os.Chdir(s.oldWd); err != nil {
+		t.Fatalf("restore working directory: %v", err)
+	}
+}
+
+func seedAlphaBetaAlphabet(t *testing.T, repo *service.DBListRepo) {
+	t.Helper()
+	if _, err := repo.Add("alpha", []byte("note-alpha"), nil); err != nil {
+		t.Fatalf("add alpha: %v", err)
+	}
+	if _, err := repo.Add("beta", []byte("note-beta"), nil); err != nil {
+		t.Fatalf("add beta: %v", err)
+	}
+	if _, err := repo.Add("alphabet", []byte("note-alphabet"), nil); err != nil {
+		t.Fatalf("add alphabet: %v", err)
+	}
+}
+
+func exportFiles(t *testing.T, dir string) []string {
+	t.Helper()
+	files, err := filepath.Glob(filepath.Join(dir, "export_*.txt"))
+	if err != nil {
+		t.Fatalf("glob export files: %v", err)
+	}
+	sort.Strings(files)
+	return files
+}
+
+func singleExportContent(t *testing.T, dir string) string {
+	t.Helper()
+	files := exportFiles(t, dir)
+	if len(files) != 1 {
+		t.Fatalf("expected 1 export file, got %d: %v", len(files), files)
+	}
+	content, err := os.ReadFile(files[0])
+	if err != nil {
+		t.Fatalf("read export file: %v", err)
+	}
+	if base := filepath.Base(files[0]); !strings.HasPrefix(base, "export_") || !strings.HasSuffix(base, ".txt") {
+		t.Fatalf("export file name = %q, want export_<timestamp>.txt", base)
+	}
+	return string(content)
+}
+
+func readExportContent(t *testing.T, file string) string {
+	t.Helper()
+	content, err := os.ReadFile(file)
+	if err != nil {
+		t.Fatalf("read export file: %v", err)
+	}
+	return string(content)
+}
+
+func exportOnce(t *testing.T, client *service.ClientBase, search [][]rune, showHidden bool) []service.ListItem {
+	t.Helper()
+	matches, refreshed, err := client.HandleInteraction(
+		service.InteractionEvent{T: service.KeyExport},
+		search,
+		showHidden,
+		false,
+		0,
+	)
+	if err != nil {
+		t.Fatalf("KeyExport returned error: %v", err)
+	}
+
+	_ = refreshed
+	return matches
+}
+
+func lineValues(items []service.ListItem) []string {
+	lines := make([]string, 0, len(items))
+	for _, item := range items {
+		lines = append(lines, item.Line())
+	}
+	return lines
+}
+
+func matchingLines(t *testing.T, repo *service.DBListRepo, search [][]rune, showHidden bool) []string {
+	t.Helper()
+	matches, _, err := repo.Match(search, showHidden, "", 0, 0)
+	if err != nil {
+		t.Fatalf("match expected lines: %v", err)
+	}
+	return lineValues(matches)
+}
+
+func requireLines(t *testing.T, label string, got []string, want []string) {
+	t.Helper()
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("%s = %q, want %q", label, strings.Join(got, "|"), strings.Join(want, "|"))
+	}
+}
+
+func contentFromLines(lines []string) string {
+	if len(lines) == 0 {
+		return ""
+	}
+	return strings.Join(lines, "\n") + "\n"
+}
+
+func requireExportContent(t *testing.T, label string, content string, wantLines []string) {
+	t.Helper()
+	want := contentFromLines(wantLines)
+	if content != want {
+		t.Fatalf("%s = %q, want %q", label, content, want)
+	}
+}
+
+func newExportFiles(t *testing.T, before []string, after []string) []string {
+	t.Helper()
+	seen := make(map[string]struct{}, len(before))
+	for _, file := range before {
+		seen[file] = struct{}{}
+	}
+	var created []string
+	for _, file := range after {
+		if _, ok := seen[file]; !ok {
+			created = append(created, file)
+		}
+	}
+	return created
+}
+
+func TestKeyExportWritesCurrentVisibleMatchSet(t *testing.T) {
+
+
+	s := newExportSession(t)
+	defer s.close(t)
+	seedAlphaBetaAlphabet(t, s.repo)
+	expected := matchingLines(t, s.repo, [][]rune{[]rune("alpha")}, false)
+
+	matches := exportOnce(t, s.client, [][]rune{[]rune("alpha")}, false)
+
+
+	requireLines(t, "returned match lines", lineValues(matches), expected)
+	if s.client.CurX != 0 {
+		t.Fatalf("CurX = %d, want 0", s.client.CurX)
+	}
+	if s.client.CurY != 0 {
+		t.Fatalf("CurY = %d, want 0", s.client.CurY)
+	}
+
+	requireExportContent(t, "export content", singleExportContent(t, s.cwd), expected)
+}
+
+func TestKeyExportUsesProvidedSearchArgumentNotPreviousClientSearch(t *testing.T) {
+
+
+	s := newExportSession(t)
+	defer s.close(t)
+	seedAlphaBetaAlphabet(t, s.repo)
+	s.client.Search = [][]rune{[]rune("alpha")}
+	expected := matchingLines(t, s.repo, [][]rune{[]rune("beta")}, false)
+
+	matches := exportOnce(t, s.client, [][]rune{[]rune("beta")}, false)
+
+
+	requireLines(t, "returned match lines", lineValues(matches), expected)
+
+	requireExportContent(t, "export content", singleExportContent(t, s.cwd), expected)
+}
+
+func TestKeyExportHonorsShowHiddenFalseAndTrue(t *testing.T) {
+
+
+	s := newExportSession(t)
+	defer s.close(t)
+	seedAlphaBetaAlphabet(t, s.repo)
+	alphabetMatches, _, err := s.repo.Match([][]rune{[]rune("alphabet")}, true, "", 0, 0)
+	if err != nil {
+		t.Fatalf("match alphabet: %v", err)
+	}
+	if len(alphabetMatches) != 1 {
+		t.Fatalf("alphabet match count = %d, want 1", len(alphabetMatches))
+	}
+	if _, err := s.repo.ToggleVisibility(&alphabetMatches[0]); err != nil {
+		t.Fatalf("hide alphabet: %v", err)
+	}
+	expectedHiddenFalse := matchingLines(t, s.repo, [][]rune{[]rune("alpha")}, false)
+	expectedHiddenTrue := matchingLines(t, s.repo, [][]rune{[]rune("alpha")}, true)
+
+	matchesHiddenFalse := exportOnce(t, s.client, [][]rune{[]rune("alpha")}, false)
+	filesAfterFalse := exportFiles(t, s.cwd)
+
+	requireLines(t, "showHidden=false match lines", lineValues(matchesHiddenFalse), expectedHiddenFalse)
+
+	requireExportContent(t, "showHidden=false export content", readExportContent(t, filesAfterFalse[0]), expectedHiddenFalse)
+
+	filesBeforeTrue := exportFiles(t, s.cwd)
+	matchesHiddenTrue := exportOnce(t, s.client, [][]rune{[]rune("alpha")}, true)
+	filesAfterTrue := exportFiles(t, s.cwd)
+	if len(filesAfterTrue) != 2 {
+		t.Fatalf("export file count after second export = %d, want 2", len(filesAfterTrue))
+	}
+
+	created := newExportFiles(t, filesBeforeTrue, filesAfterTrue)
+	if len(created) != 1 {
+		t.Fatalf("new export files after second export = %d, want 1: %v", len(created), created)
+	}
+
+	requireLines(t, "showHidden=true match lines", lineValues(matchesHiddenTrue), expectedHiddenTrue)
+	requireExportContent(t, "showHidden=true export content", readExportContent(t, created[0]), expectedHiddenTrue)
+}
+
+func TestKeyExportCreatesEmptyFileForNoMatches(t *testing.T) {
+
+
+	s := newExportSession(t)
+	defer s.close(t)
+	seedAlphaBetaAlphabet(t, s.repo)
+
+	matches := exportOnce(t, s.client, [][]rune{[]rune("gamma")}, false)
+
+	if len(matches) != 0 {
+		t.Fatalf("returned match count = %d, want 0", len(matches))
+	}
+	if content := singleExportContent(t, s.cwd); content != "" {
+		t.Fatalf("export content = %q, want empty string", content)
+	}
+}
+
+func TestKeyExportInstancesUseIndependentRepositoriesAndDirectories(t *testing.T) {
+
+
+	s1 := newExportSession(t)
+	defer s1.close(t)
+	if _, err := s1.repo.Add("alpha", nil, nil); err != nil {
+		t.Fatalf("session one add alpha: %v", err)
+	}
+	expectedOne := matchingLines(t, s1.repo, [][]rune{[]rune("alpha")}, false)
+	exportOnce(t, s1.client, [][]rune{[]rune("alpha")}, false)
+
+	requireExportContent(t, "session one content", singleExportContent(t, s1.cwd), expectedOne)
+
+	s2 := newExportSession(t)
+	defer s2.close(t)
+	if _, err := s2.repo.Add("alphabet", nil, nil); err != nil {
+		t.Fatalf("session two add alphabet: %v", err)
+	}
+	expectedTwo := matchingLines(t, s2.repo, [][]rune{[]rune("alpha")}, false)
+	exportOnce(t, s2.client, [][]rune{[]rune("alpha")}, false)
+
+	requireExportContent(t, "session two content", singleExportContent(t, s2.cwd), expectedTwo)
+	if len(exportFiles(t, s1.cwd)) != 1 {
+		t.Fatalf("session one export file count = %d, want 1", len(exportFiles(t, s1.cwd)))
+	}
+}
+
+func TestKeyExportBeforeItemsDoesNotRaiseAndCanRepeat(t *testing.T) {
+
+
+	s := newExportSession(t)
+	defer s.close(t)
+
+	firstMatches := exportOnce(t, s.client, [][]rune{[]rune("alpha")}, false)
+	secondMatches := exportOnce(t, s.client, [][]rune{[]rune("alpha")}, false)
+
+	if len(firstMatches) != 0 {
+		t.Fatalf("first export match count = %d, want 0", len(firstMatches))
+	}
+	if len(secondMatches) != 0 {
+		t.Fatalf("second export match count = %d, want 0", len(secondMatches))
+	}
+	files := exportFiles(t, s.cwd)
+	if len(files) != 2 {
+		t.Fatalf("export file count = %d, want 2", len(files))
+	}
+	for idx, file := range files {
+		content, err := os.ReadFile(file)
+		if err != nil {
+			t.Fatalf("read export file %d: %v", idx, err)
+		}
+		if string(content) != "" {
+			t.Fatalf("export file %d content = %q, want empty string", idx, string(content))
+		}
+	}
+}
+
+func TestTerminalCtrlCaratExportsCurrentSearchWithoutChangingRepository(t *testing.T) {
+
+
+	s := newExportSession(t)
+	defer s.close(t)
+	seedAlphaBetaAlphabet(t, s.repo)
+	expectedExport := matchingLines(t, s.repo, [][]rune{[]rune("alpha")}, false)
+	allLinesBefore := matchingLines(t, s.repo, [][]rune{}, true)
+
+	terminal := term.NewTerm(s.repo, "light", "")
+	defer terminal.S.Fini()
+	for _, r := range []rune("alpha") {
+		if err := terminal.HandleEvent(tcell.NewEventKey(tcell.KeyRune, r, tcell.ModNone)); err != nil {
+			t.Fatalf("terminal search rune %q: %v", string(r), err)
+		}
+	}
+	if err := terminal.HandleEvent(tcell.NewEventKey(tcell.KeyCtrlCarat, 0, tcell.ModNone)); err != nil {
+		t.Fatalf("terminal Ctrl-^: %v", err)
+	}
+
+
+	requireExportContent(t, "terminal export content", singleExportContent(t, s.cwd), expectedExport)
+	allLinesAfter := matchingLines(t, s.repo, [][]rune{}, true)
+
+	requireLines(t, "repository lines after terminal export", allLinesAfter, allLinesBefore)
+}
+
+func TestKeyExportRepeatedSessionsStayResourceBounded(t *testing.T) {
+
+
+
+	const cycles = 120
+	for i := 0; i < cycles; i++ {
+		s := newExportSession(t)
+		seedAlphaBetaAlphabet(t, s.repo)
+		exportOnce(t, s.client, [][]rune{[]rune("alpha")}, false)
+		if len(exportFiles(t, s.cwd)) != 1 {
+			t.Fatalf("cycle %d export file count = %d, want 1", i, len(exportFiles(t, s.cwd)))
+		}
+		s.close(t)
+	}
+
+}
