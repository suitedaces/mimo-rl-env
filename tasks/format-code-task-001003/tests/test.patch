@@ -0,0 +1,32 @@
+import fastify from 'fastify'
+import cookie, {
+  Signer,
+  SignerFactory,
+  SignerKeyring
+} from '..'
+import { expectAssignable, expectError, expectType } from 'tsd'
+
+const keyring: SignerKeyring = {
+  primary: 'current',
+  keys: {
+    current: 'current-secret',
+    previous: Buffer.from('previous-secret')
+  }
+}
+
+const signer = new Signer(keyring, 'sha512')
+expectType<string>(signer.sign('value'))
+expectType<{ valid: boolean; renew: boolean; value: string | null }>(
+  signer.unsign('signed-value')
+)
+
+expectAssignable<SignerFactory>(cookie.signerFactory)
+expectType<{ sign: (value: string) => string; unsign: (input: string) => { valid: boolean; renew: boolean; value: string | null } }>(
+  cookie.signerFactory(keyring)
+)
+
+const app = fastify()
+app.register(cookie, { secret: keyring })
+
+expectError<SignerKeyring>({ primary: 'current', keys: { current: 42 } })
+expectError(app.register(cookie, { secret: { primary: 'current', keys: { current: 42 } } }))
