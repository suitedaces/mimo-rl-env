diff --git a/tests/test_validate_async_listeners.py b/tests/test_validate_async_listeners.py
new file mode 100644
index 0000000..8f1a4c3
--- /dev/null
+++ b/tests/test_validate_async_listeners.py
@@ -0,0 +1,115 @@
+import asyncio
+import inspect
+from contextlib import contextmanager
+from pathlib import Path
+
+from confz import ConfZ, depends_on, validate_all_configs
+
+
+def _all_confz_subclasses(root=ConfZ):
+    subclasses = []
+    for subclass in root.__subclasses__():
+        subclasses.append(subclass)
+        subclasses.extend(_all_confz_subclasses(subclass))
+    return subclasses
+
+
+@contextmanager
+def _only_active_configs(*active_classes):
+    active_classes = set(active_classes)
+    saved_sources = {}
+    for config_class in _all_confz_subclasses():
+        if config_class not in active_classes:
+            saved_sources[config_class] = getattr(config_class, "CONFIG_SOURCES", None)
+            config_class.CONFIG_SOURCES = None
+    try:
+        yield
+    finally:
+        for config_class, source in saved_sources.items():
+            config_class.CONFIG_SOURCES = source
+
+
+def _run_awaitable(awaitable):
+    async def runner():
+        await awaitable
+
+    asyncio.run(runner())
+
+
+def test_validate_all_configs_sync_listeners_remain_sync():
+    events = []
+
+    class SyncOnlyConfig(ConfZ):
+        CONFIG_SOURCES = []
+
+    @depends_on(SyncOnlyConfig)
+    def init_sync_client():
+        events.append("sync")
+        return object()
+
+    with _only_active_configs(SyncOnlyConfig):
+        result = validate_all_configs(include_listeners=True)
+
+    assert not inspect.isawaitable(result)
+    assert events == ["sync"]
+
+
+def test_validate_all_configs_with_async_listener_defers_work_until_awaited():
+    events = []
+
+    class MixedConfig(ConfZ):
+        CONFIG_SOURCES = []
+
+    @depends_on(MixedConfig)
+    def init_sync_client():
+        events.append("sync")
+        return object()
+
+    @depends_on(MixedConfig)
+    async def init_async_client():
+        events.append("async")
+        return object()
+
+    with _only_active_configs(MixedConfig):
+        result = validate_all_configs(include_listeners=True)
+        assert inspect.isawaitable(result)
+        assert events == []
+        _run_awaitable(result)
+
+    assert sorted(events) == ["async", "sync"]
+
+
+def test_validate_all_configs_awaits_each_async_listener():
+    events = []
+
+    class MultiAsyncConfig(ConfZ):
+        CONFIG_SOURCES = []
+
+    @depends_on(MultiAsyncConfig)
+    async def init_first_client():
+        events.append("first")
+        return object()
+
+    @depends_on(MultiAsyncConfig)
+    async def init_second_client():
+        events.append("second")
+        return object()
+
+    with _only_active_configs(MultiAsyncConfig):
+        result = validate_all_configs(include_listeners=True)
+        assert inspect.isawaitable(result)
+        _run_awaitable(result)
+
+    assert events.count("first") == 1
+    assert events.count("second") == 1
+
+
+def test_async_listener_startup_validation_is_documented():
+    docs = Path("docs/source/usage/listeners.rst").read_text(encoding="utf-8")
+    lower_docs = docs.lower()
+    compact_docs = "".join(lower_docs.split())
+
+    assert "async" in lower_docs and "listener" in lower_docs
+    assert "validate_all_configs" in lower_docs
+    assert "include_listeners=true" in compact_docs
+    assert "awaitvalidate_all_configs(include_listeners=true)" in compact_docs
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,44 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set +u
+
+
+export PYENV_ROOT="$HOME/.pyenv"
+export PATH="$PYENV_ROOT/bin:$PATH"
+eval "$(pyenv init -)"
+pyenv global 3.9.7
+
+
+VENV_DIR=/testbed/.build_env/.venv
+mkdir -p "$(dirname "$VENV_DIR")"
+if [ ! -f "$VENV_DIR/bin/activate" ]; then
+    rm -rf "$VENV_DIR"
+    python3 -m venv "$VENV_DIR"
+fi
+source "$VENV_DIR/bin/activate"
+set -u
+
+
+pip install --upgrade pip setuptools wheel -q 2>/dev/null
+pip install -e /testbed --no-deps -q 2>/dev/null
+pip install "pydantic>=1.8.2,<2" "PyYAML>=5.4.1,<6" "python-dotenv>=0.19.2,<0.20.0" pytest "pytest-asyncio>=0.16.0" -q 2>/dev/null
+
+
+case "${1:-}" in
+  base)
+    python -m pytest tests/test_validate.py::test_validate -v
+    ;;
+  new)
+    python -m pytest \
+      tests/test_validate.py::test_listeners \
+      tests/test_validate_async_listeners.py \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
