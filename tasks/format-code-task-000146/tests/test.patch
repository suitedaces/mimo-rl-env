diff --git a/tests/callbacks/test_early_stopping.py b/tests/callbacks/test_early_stopping.py
index ad343cdf3..b569a9ef6 100644
--- a/tests/callbacks/test_early_stopping.py
+++ b/tests/callbacks/test_early_stopping.py
@@ -450,3 +450,141 @@ def test_check_on_train_epoch_end_with_val_check_interval(tmpdir):
 
     assert es_mock.call_count == len(side_effect)
     assert trainer.global_step == len(side_effect) * int(limit_train_batches * val_check_interval)
+
+
+def test_early_stopping_no_crash_with_check_val_every_n_epoch(tmpdir):
+    """When check_val_every_n_epoch > 1, EarlyStopping monitoring a validation metric must
+    not crash at the end of the first training epoch (the validation metric isn't logged yet)."""
+
+    class TestModel(BoringModel):
+        def validation_step(self, batch, batch_idx):
+            out = super().validation_step(batch, batch_idx)
+            self.log("val_loss", out["x"])
+            return out
+
+    model = TestModel()
+    early_stop = EarlyStopping(monitor="val_loss", patience=3)
+    trainer = Trainer(
+        default_root_dir=tmpdir,
+        callbacks=[early_stop],
+        check_val_every_n_epoch=10,
+        max_epochs=3,
+        limit_train_batches=2,
+        limit_val_batches=2,
+        num_sanity_val_steps=0,
+        progress_bar_refresh_rate=0,
+        checkpoint_callback=False,
+        logger=False,
+    )
+
+    trainer.fit(model)
+
+
+def test_early_stopping_check_on_train_epoch_end_with_check_val_every_n_epoch_gt_1(tmpdir):
+    """With check_val_every_n_epoch > 1, EarlyStopping must defer to validation end."""
+    model = BoringModel()
+    early_stop = EarlyStopping(monitor="val_loss")
+    trainer = Trainer(
+        default_root_dir=tmpdir,
+        callbacks=[early_stop],
+        check_val_every_n_epoch=2,
+        max_epochs=1,
+        limit_train_batches=1,
+        limit_val_batches=1,
+        num_sanity_val_steps=0,
+        progress_bar_refresh_rate=0,
+        checkpoint_callback=False,
+        logger=False,
+    )
+    trainer.fit(model)
+    assert early_stop._check_on_train_epoch_end is False
+
+
+def test_early_stopping_check_on_train_epoch_end_default_when_val_every_epoch(tmpdir):
+    """Preservation: with default check_val_every_n_epoch=1 and val_check_interval=1.0, run on train epoch end."""
+
+    class TrainLogModel(BoringModel):
+        def training_step(self, batch, batch_idx):
+            out = super().training_step(batch, batch_idx)
+            self.log("val_loss", out["loss"])
+            return out
+
+    model = TrainLogModel()
+    early_stop = EarlyStopping(monitor="val_loss")
+    trainer = Trainer(
+        default_root_dir=tmpdir,
+        callbacks=[early_stop],
+        max_epochs=1,
+        limit_train_batches=1,
+        limit_val_batches=1,
+        num_sanity_val_steps=0,
+        progress_bar_refresh_rate=0,
+        checkpoint_callback=False,
+        logger=False,
+    )
+    trainer.fit(model)
+    assert early_stop._check_on_train_epoch_end is True
+
+
+def test_early_stopping_check_on_train_epoch_end_with_val_check_interval_fraction(tmpdir):
+    """Preservation: with val_check_interval < 1.0, run on validation end."""
+
+    class TestModel(BoringModel):
+        def validation_step(self, batch, batch_idx):
+            out = super().validation_step(batch, batch_idx)
+            self.log("val_loss", out["x"])
+            return out
+
+    model = TestModel()
+    early_stop = EarlyStopping(monitor="val_loss")
+    trainer = Trainer(
+        default_root_dir=tmpdir,
+        callbacks=[early_stop],
+        val_check_interval=0.5,
+        max_epochs=1,
+        limit_train_batches=2,
+        limit_val_batches=1,
+        num_sanity_val_steps=0,
+        progress_bar_refresh_rate=0,
+        checkpoint_callback=False,
+        logger=False,
+    )
+    trainer.fit(model)
+    assert early_stop._check_on_train_epoch_end is False
+
+
+def test_model_checkpoint_save_on_train_epoch_end_with_check_val_every_n_epoch_gt_1(tmpdir):
+    """ModelCheckpoint must also defer to validation end with check_val_every_n_epoch > 1."""
+    model = BoringModel()
+    ckpt = ModelCheckpoint(monitor="val_loss")
+    trainer = Trainer(
+        default_root_dir=tmpdir,
+        callbacks=[ckpt],
+        check_val_every_n_epoch=2,
+        max_epochs=1,
+        limit_train_batches=1,
+        limit_val_batches=1,
+        num_sanity_val_steps=0,
+        progress_bar_refresh_rate=0,
+        logger=False,
+    )
+    trainer.fit(model)
+    assert ckpt._save_on_train_epoch_end is False
+
+
+def test_model_checkpoint_save_on_train_epoch_end_default_when_val_every_epoch(tmpdir):
+    """Preservation: with default check_val_every_n_epoch=1 and val_check_interval=1.0, save on train epoch end."""
+    model = BoringModel()
+    ckpt = ModelCheckpoint(monitor="val_loss")
+    trainer = Trainer(
+        default_root_dir=tmpdir,
+        callbacks=[ckpt],
+        max_epochs=1,
+        limit_train_batches=1,
+        limit_val_batches=1,
+        num_sanity_val_steps=0,
+        progress_bar_refresh_rate=0,
+        logger=False,
+    )
+    trainer.fit(model)
+    assert ckpt._save_on_train_epoch_end is True
