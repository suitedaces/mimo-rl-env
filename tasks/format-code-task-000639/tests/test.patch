--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,80 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+PKG=packages/opencensus-exporter-zpages
+
+
+
+
+
+
+
+BUILDER="$(mktemp /tmp/zpages-build.XXXXXX.js)"
+cat > "$BUILDER" <<'EOF'
+const fs = require('fs');
+const path = require('path');
+const pkgRoot = path.resolve(process.argv[2]);
+function loadTs() {
+  for (const base of [pkgRoot, '/testbed']) {
+    const p = path.join(base, 'node_modules', 'typescript');
+    if (fs.existsSync(p)) return require(p);
+  }
+  return require('typescript');
+}
+const ts = loadTs();
+function walk(dir, out) {
+  for (const e of fs.readdirSync(dir, {withFileTypes: true})) {
+    const p = path.join(dir, e.name);
+    if (e.isDirectory()) {
+      if (e.name === 'node_modules' || e.name === 'build') continue;
+      walk(p, out);
+    } else {
+      out.push(p);
+    }
+  }
+  return out;
+}
+const srcDirs = ['src', 'test'].map(d => path.join(pkgRoot, d))
+                    .filter(d => fs.existsSync(d));
+const files = [];
+for (const d of srcDirs) walk(d, files);
+const options = {
+  module: ts.ModuleKind.CommonJS,
+  target: ts.ScriptTarget.ES2017,
+  esModuleInterop: false,
+  inlineSourceMap: false,
+};
+for (const f of files) {
+  const outPath = path.join(pkgRoot, 'build', path.relative(pkgRoot, f));
+  if (f.endsWith('.d.ts')) continue;
+  fs.mkdirSync(path.dirname(outPath), {recursive: true});
+  if (f.endsWith('.ts')) {
+    const source = fs.readFileSync(f, 'utf8');
+    const result = ts.transpileModule(source, {compilerOptions: options, fileName: f});
+    fs.writeFileSync(outPath.replace(/\.ts$/, '.js'), result.outputText);
+  } else {
+    fs.copyFileSync(f, outPath);
+  }
+}
+EOF
+
+
+
+for p in packages/*/; do
+  node "$BUILDER" "$p" || true
+done
+
+MOCHA="$PKG/node_modules/.bin/mocha"
+
+
+"$MOCHA" "$PKG/build/test/test-zpages.js"
+
+
+"$MOCHA" "$PKG/build/test/test-zpages-json.js"
