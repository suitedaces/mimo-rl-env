--- /dev/null
+++ b/tests/test_push_queue_contract.py
@@ -0,0 +1,96 @@
+from io import StringIO
+from pathlib import Path
+
+from gftools.push import PushCategory, PushItem, PushItems, PushList, PushStatus
+
+
+def _item(path, category=PushCategory.NEW, url="url"):
+    return PushItem(Path(path), category, PushStatus.IN_DEV, url)
+
+
+def test_add_normalizes_without_mutating_source_and_filters_special_paths():
+    source = _item("ofl/demo/Demo[wght].ttf")
+    queue = PushItems()
+    queue.add(source)
+
+    assert source.path == Path("ofl/demo/Demo[wght].ttf")
+    assert [item.path for item in queue] == [Path("ofl/demo")]
+
+    queue.add(_item("lang/Lib/gflanguages/data/languages/en_Latn.textproto"))
+    queue.add(_item("axisregistry/Lib/axisregistry/data/grade.textproto"))
+    queue.add(_item("lang/authors.txt"))
+    queue.add(_item("ofl"))
+    assert [item.path for item in queue] == [
+        Path("ofl/demo"),
+        Path("lang/languages/en_Latn.textproto"),
+        Path("axisregistry/grade.textproto"),
+    ]
+
+
+def test_add_collapses_true_ancestors_but_keeps_same_named_siblings():
+    queue = PushItems()
+    queue.add(_item("ofl/family/subdir"))
+    queue.add(_item("ofl/family"))
+    assert [item.path for item in queue] == [Path("ofl/family")]
+
+    queue = PushItems()
+    queue.add(_item("ofl/family"))
+    queue.add(_item("ofl/family/subdir"))
+    assert [item.path for item in queue] == [Path("ofl/family")]
+
+    queue = PushItems()
+    queue.add(_item("ofl/alpha"))
+    queue.add(_item("apache/family"))
+    queue.add(_item("ofl/family/notes.bin"))
+    assert [item.path for item in queue] == [
+        Path("ofl/alpha"),
+        Path("apache/family"),
+        Path("ofl/family/notes.bin"),
+    ]
+
+
+def test_add_replaces_duplicate_with_latest_metadata():
+    queue = PushItems()
+    queue.add(_item("ofl/family", PushCategory.NEW, "first"))
+    queue.add(_item("ofl/family", PushCategory.UPGRADE, "latest"))
+    assert len(queue) == 1
+    assert queue[0].category is PushCategory.UPGRADE
+    assert queue[0].url == "latest"
+
+
+def test_server_file_parser_preserves_hashes_in_urls():
+    queue = PushItems.from_server_file(
+        StringIO(
+            "# Upgrade\nofl/family # https://example.test/pr/4#discussion\n"
+            "ofl/standalone\n"
+        ),
+        PushStatus.IN_DEV,
+        PushList.TO_PRODUCTION,
+    )
+    assert len(queue) == 2
+    assert queue[0].path == Path("ofl/family")
+    assert queue[0].category is PushCategory.UPGRADE
+    assert queue[0].status is PushStatus.IN_DEV
+    assert queue[0].push_list is PushList.TO_PRODUCTION
+    assert queue[0].url == "https://example.test/pr/4#discussion"
+    assert queue[1].path == Path("ofl/standalone")
+    assert queue[1].url == ""
+
+
+def test_queue_operators_do_not_mutate_operands():
+    left = PushItems([_item("ofl/left/file.ttf")])
+    right = PushItems([_item("ofl/right/file.ttf")])
+    combined = left + right
+
+    assert [item.path for item in left] == [Path("ofl/left/file.ttf")]
+    assert [item.path for item in right] == [Path("ofl/right/file.ttf")]
+    assert [item.path for item in combined] == [Path("ofl/left"), Path("ofl/right")]
+
+    remainder = combined - PushItems([_item("ofl/left")])
+    assert [item.path for item in combined] == [Path("ofl/left"), Path("ofl/right")]
+    assert [item.path for item in remainder] == [Path("ofl/right")]
+
+    raw = PushItems([_item("ofl/raw/file.ttf")])
+    normalized = raw - PushItems()
+    assert [item.path for item in raw] == [Path("ofl/raw/file.ttf")]
+    assert [item.path for item in normalized] == [Path("ofl/raw")]
