@@ -113,3 +114,28 @@ def test_websocket_blocking_receive():
     with client.websocket_connect("/") as websocket:
         data = websocket.receive_json()
         assert data == {"message": "test"}
+
+
+async def echo_root_path(request):
+    return JSONResponse({"root_path": request.scope["root_path"]})
+
+
+def test_testclient_sets_root_path_on_http_scope():
+    app = Starlette(routes=[Route("/", echo_root_path, methods=["GET"])])
+    client = TestClient(app, root_path="/proxy-prefix")
+
+    assert client.get("/").json() == {"root_path": "/proxy-prefix"}
+
+
+async def echo_websocket_root_path(websocket):
+    await websocket.accept()
+    await websocket.send_text(websocket.scope["root_path"])
+    await websocket.close()
+
+
+def test_testclient_sets_root_path_on_websocket_scope():
+    app = Starlette(routes=[WebSocketRoute("/ws", echo_websocket_root_path)])
+    client = TestClient(app, root_path="/ws-prefix")
+
+    with client.websocket_connect("/ws") as websocket:
+        assert websocket.receive_text() == "/ws-prefix"
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,28 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+pip install -e . --quiet --no-input
+pip install pytest requests --quiet --no-input
+
+
+case "${1:-}" in
+  base)
+    python -m pytest tests/test_routing.py -v -k "not test_request_url_for_preserves_root_path_for_root_and_mount and not test_request_url_for_uses_configured_root_path_value"
+    ;;
+  new)
+    python -m pytest \
+      tests/test_routing.py::test_request_url_for_preserves_root_path_for_root_and_mount \
+      tests/test_routing.py::test_request_url_for_uses_configured_root_path_value \
+      tests/test_requests.py::test_request_base_url_includes_root_path_without_request_path_or_query \
+      tests/test_testclient.py::test_testclient_sets_root_path_on_http_scope \
+      tests/test_testclient.py::test_testclient_sets_root_path_on_websocket_scope \
+      tests/test_datastructures.py::test_url_from_scope_without_query_string \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
