+async def url_for_with_root_path(request):
+    user_id = request.path_params.get("user_id", 42)
+    return JSONResponse(
+        {
+            "home": str(request.url_for("homepage")),
+            "detail": str(request.url_for("accounts:detail", user_id=user_id)),
+        }
+    )
+
+
+url_for_with_root_path_routes = [
+    Route("/", url_for_with_root_path, name="homepage", methods=["GET"]),
+    Mount(
+        "/accounts",
+        name="accounts",
+        routes=[
+            Route(
+                "/users/{user_id}/",
+                url_for_with_root_path,
+                name="detail",
+                methods=["GET"],
+            )
+        ],
+    ),
+]
+
+
+def test_request_url_for_preserves_root_path_for_root_and_mount():
+    app = Starlette(routes=url_for_with_root_path_routes)
+    client = TestClient(app, base_url="https://example.org", root_path="/api/v1")
+
+    assert client.get("/").json() == {
+        "home": "https://example.org/api/v1/",
+        "detail": "https://example.org/api/v1/accounts/users/42/",
+    }
+    assert client.get("/accounts/users/42/").json() == {
+        "home": "https://example.org/api/v1/",
+        "detail": "https://example.org/api/v1/accounts/users/42/",
+    }
+
+
+def test_request_url_for_uses_configured_root_path_value():
+    app = Starlette(routes=url_for_with_root_path_routes)
+    client = TestClient(
+        app, base_url="https://outside.example", root_path="/service-area"
+    )
+
+    assert client.get("/accounts/users/7/").json() == {
+        "home": "https://outside.example/service-area/",
+        "detail": "https://outside.example/service-area/accounts/users/7/",
+    }
