diff --git a/tests/test_nodata_inf.py b/tests/test_nodata_inf.py
new file mode 100644
index 00000000..b87e23cc
--- /dev/null
+++ b/tests/test_nodata_inf.py
@@ -0,0 +1,141 @@
+
+
+
+
+
+import os
+import shutil
+
+import pytest
+
+import rasterio
+from rasterio.io import MemoryFile
+from rasterio.rio.main import main_group
+
+
+
+
+
+
+def test_memoryfile_open_nodata_inf_float32():
+
+    with MemoryFile() as mem:
+        with mem.open(
+            driver="GTiff", width=1, height=1, count=1,
+            dtype="float32", nodata=float("inf"),
+        ) as src:
+            assert src.nodata == float("inf")
+
+
+def test_memoryfile_open_nodata_neg_inf_float32():
+    with MemoryFile() as mem:
+        with mem.open(
+            driver="GTiff", width=1, height=1, count=1,
+            dtype="float32", nodata=float("-inf"),
+        ) as src:
+            assert src.nodata == float("-inf")
+
+
+def test_memoryfile_open_nodata_inf_float64():
+    with MemoryFile() as mem:
+        with mem.open(
+            driver="GTiff", width=1, height=1, count=1,
+            dtype="float64", nodata=float("inf"),
+        ) as src:
+            assert src.nodata == float("inf")
+
+
+def test_memoryfile_open_nodata_nan_float32():
+
+    import math
+    with MemoryFile() as mem:
+        with mem.open(
+            driver="GTiff", width=1, height=1, count=1,
+            dtype="float32", nodata=float("nan"),
+        ) as src:
+            assert math.isnan(src.nodata)
+
+
+def test_memoryfile_open_nodata_inf_uint8_raises():
+
+    with MemoryFile() as mem:
+        with pytest.raises(ValueError):
+            mem.open(
+                driver="GTiff", width=1, height=1, count=1,
+                dtype="uint8", nodata=float("inf"),
+            )
+
+
+def test_memoryfile_open_nodata_out_of_range_int_raises():
+
+    with MemoryFile() as mem:
+        with pytest.raises(ValueError):
+            mem.open(
+                driver="GTiff", width=1, height=1, count=1,
+                dtype="uint8", nodata=-1,
+            )
+
+
+
+
+
+
+def test_inf_nodata_round_trip(tmpdir):
+
+    p = str(tmpdir.join("inf.tif"))
+    with rasterio.open(
+        p, "w", driver="GTiff", width=1, height=1, count=1,
+        dtype="float32", nodata=float("inf"),
+    ) as dst:
+        assert dst.nodata == float("inf")
+    with rasterio.open(p) as src:
+        assert src.nodata == float("inf")
+
+
+def test_neg_inf_nodata_round_trip(tmpdir):
+    p = str(tmpdir.join("neg_inf.tif"))
+    with rasterio.open(
+        p, "w", driver="GTiff", width=1, height=1, count=1,
+        dtype="float32", nodata=float("-inf"),
+    ) as dst:
+        assert dst.nodata == float("-inf")
+    with rasterio.open(p) as src:
+        assert src.nodata == float("-inf")
+
+
+def test_set_nodatavals_neg_inf_persists(tmpdir):
+
+    p = str(tmpdir.join("set_neg_inf.tif"))
+    with rasterio.open(
+        p, "w", driver="GTiff", width=1, height=1, count=1, dtype="float32",
+    ) as dst:
+        pass
+    with rasterio.open(p, "r+") as dst:
+        dst._set_nodatavals((float("-inf"),))
+        assert dst.nodata == float("-inf")
+    with rasterio.open(p) as src:
+        assert src.nodata == float("-inf")
+
+
+
+
+
+
+def test_rio_edit_info_nodata_inf(data, runner):
+    inputfile = str(data.join("float32.tif"))
+    result = runner.invoke(
+        main_group, ["edit-info", inputfile, "--nodata", "inf"]
+    )
+    assert result.exit_code == 0
+    with rasterio.open(inputfile) as src:
+        assert src.nodata == float("inf")
+
+
+def test_rio_edit_info_nodata_neg_inf(data, runner):
+    inputfile = str(data.join("float32.tif"))
+    result = runner.invoke(
+        main_group, ["edit-info", inputfile, "--nodata", "-inf"]
+    )
+    assert result.exit_code == 0
+    with rasterio.open(inputfile) as src:
+        assert src.nodata == float("-inf")
