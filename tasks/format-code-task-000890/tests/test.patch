diff --git a/__tests__/catch-or-return.js b/__tests__/catch-or-return.js
index 679ab5b..e31e35d 100644
--- a/__tests__/catch-or-return.js
+++ b/__tests__/catch-or-return.js
@@ -164,3 +164,60 @@ ruleTester.run('catch-or-return', rule, {
     }
   ]
 })
+
+ruleTester.run('catch-or-return allowFinally', rule, {
+  valid: [
+    // issue example: .then().catch().finally() valid with allowFinally:true
+    {
+      code: 'frank().then(go).catch(err => log(err)).finally(fn)',
+      options: [{ allowFinally: true }],
+      parserOptions: { ecmaVersion: 6 }
+    },
+    // basic .catch().finally()
+    {
+      code: 'frank().catch(jail).finally(fn)',
+      options: [{ allowFinally: true }]
+    },
+    // Promise.resolve(...).catch().finally() valid
+    {
+      code: 'Promise.resolve(frank).catch(jail).finally(fn)',
+      options: [{ allowFinally: true }]
+    },
+    // literal ['catch']().finally() valid
+    {
+      code: 'Promise.resolve(frank)["catch"](jail).finally(fn)',
+      options: [{ allowFinally: true }]
+    },
+    // allowThen + allowFinally combined
+    {
+      code: 'frank().then(go).then(a, b).finally(fn)',
+      options: [{ allowThen: true, allowFinally: true }]
+    }
+  ],
+
+  invalid: [
+    // issue example: .then().finally() WITHOUT catch invalid even with allowFinally:true
+    {
+      code: 'frank().then(go).finally(fn)',
+      options: [{ allowFinally: true }],
+      errors: [{ message: catchMessage }]
+    },
+    // Promise.resolve().finally() (no catch) invalid with allowFinally:true
+    {
+      code: 'Promise.resolve(frank).finally(fn)',
+      options: [{ allowFinally: true }],
+      errors: [{ message: catchMessage }]
+    },
+    // Preservation: without allowFinally, .catch().finally() is invalid
+    {
+      code: 'frank().then(go).catch(err).finally(fn)',
+      errors: [{ message: catchMessage }]
+    },
+    // Preservation: untouched bare .then(go) still invalid even with allowFinally:true
+    {
+      code: 'frank().then(go)',
+      options: [{ allowFinally: true }],
+      errors: [{ message: catchMessage }]
+    }
+  ]
+})
