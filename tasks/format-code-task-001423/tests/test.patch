+++ b/tests/hcaptcha.script.spec.js
@@ -0,0 +1,95 @@
+import React from "react";
+import ReactTestUtils from "react-dom/test-utils";
+
+const TEST_SITEKEY = "10000000-ffff-ffff-ffff-000000000001";
+
+const countApiScripts = () =>
+    document.querySelectorAll("head > script[src*='/1/api.js']").length;
+
+const clearScriptsAndHcaptcha = () => {
+    document.querySelectorAll("head > script").forEach(s => document.head.removeChild(s));
+    if (typeof window !== "undefined") {
+        try { delete window.hcaptcha; } catch (e) { window.hcaptcha = undefined; }
+    }
+};
+
+describe("HCaptcha api script loading", () => {
+    beforeEach(() => {
+        clearScriptsAndHcaptcha();
+    });
+
+    afterEach(() => {
+        clearScriptsAndHcaptcha();
+    });
+
+    it("adds exactly one api script tag when first captcha mounts and hcaptcha is undefined", () => {
+        jest.isolateModules(() => {
+            const HCaptcha = require("../src/index");
+            expect(countApiScripts()).toBe(0);
+            ReactTestUtils.renderIntoDocument(<HCaptcha sitekey={TEST_SITEKEY} />);
+            expect(countApiScripts()).toBe(1);
+        });
+    });
+
+    it("does NOT add a second api script tag when a second captcha mounts before api loads", () => {
+        jest.isolateModules(() => {
+            const HCaptcha = require("../src/index");
+
+            ReactTestUtils.renderIntoDocument(<HCaptcha sitekey={TEST_SITEKEY} />);
+            expect(countApiScripts()).toBe(1);
+
+
+
+            expect(typeof window.hcaptcha).toBe("undefined");
+            ReactTestUtils.renderIntoDocument(<HCaptcha sitekey={TEST_SITEKEY} />);
+
+
+            expect(countApiScripts()).toBe(1);
+        });
+    });
+
+    it("does NOT add a second api script tag when the first captcha used a custom apihost", () => {
+        jest.isolateModules(() => {
+            const HCaptcha = require("../src/index");
+
+
+            ReactTestUtils.renderIntoDocument(
+                <HCaptcha sitekey={TEST_SITEKEY} apihost="https://custom.example.com" />
+            );
+            expect(countApiScripts()).toBe(1);
+
+
+
+            ReactTestUtils.renderIntoDocument(<HCaptcha sitekey={TEST_SITEKEY} />);
+
+            expect(countApiScripts()).toBe(1);
+        });
+    });
+
+    it("does NOT add a third api script tag when three captchas mount before api loads", () => {
+        jest.isolateModules(() => {
+            const HCaptcha = require("../src/index");
+            ReactTestUtils.renderIntoDocument(<HCaptcha sitekey={TEST_SITEKEY} />);
+            ReactTestUtils.renderIntoDocument(<HCaptcha sitekey={TEST_SITEKEY} />);
+            ReactTestUtils.renderIntoDocument(<HCaptcha sitekey={TEST_SITEKEY} />);
+            expect(countApiScripts()).toBe(1);
+        });
+    });
+
+    it("does NOT inject api script when hcaptcha is already loaded globally (workaround)", () => {
+        jest.isolateModules(() => {
+
+            window.hcaptcha = {
+                render: jest.fn(() => "id"),
+                reset: jest.fn(),
+                remove: jest.fn(),
+                execute: jest.fn(),
+                getResponse: jest.fn(),
+                getRespKey: jest.fn(),
+            };
+            const HCaptcha = require("../src/index");
+            ReactTestUtils.renderIntoDocument(<HCaptcha sitekey={TEST_SITEKEY} />);
+            expect(countApiScripts()).toBe(0);
+        });
+    });
+});
