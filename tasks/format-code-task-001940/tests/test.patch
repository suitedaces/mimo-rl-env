diff --git a/tests/test_finder.py b/tests/test_finder.py
index d2d621b..08a476e 100644
--- a/tests/test_finder.py
+++ b/tests/test_finder.py
@@ -58,3 +58,109 @@ def test_find_pkg_style_namespace_packages(statement):
         assert package.name == "namespace"
         assert package.is_namespace
         assert package.path == [tmp_package1.path.parent, tmp_package2.path.parent]
+
+
+def test_pth_file_pywin32_like_does_not_raise(tmp_path):
+    """Regression test for the PyWin32 .pth file format breaking griffe.
+
+    The .pth file contains comments, multiple directory lines, and an `import`
+    statement. The finder should not raise, and bogus content (multi-line text,
+    comment markers, import statements) should never appear in `search_paths`.
+    """
+    pth_file = tmp_path / "pywin32.pth"
+    pth_content = (
+        "# .pth file for the PyWin32 extensions\n"
+        "win32\n"
+        "win32\\lib\n"
+        "Pythonwin\n"
+        "# And some hackery to deal with environments where the post_install script\n"
+        "# isn't run.\n"
+        "import pywin32_bootstrap"
+    )
+    pth_file.write_text(pth_content)
+
+
+    finder = ModuleFinder(search_paths=[tmp_path])
+
+
+
+    for sp in finder.search_paths:
+        sp_str = str(sp)
+        assert "\n" not in sp_str
+        assert "#" not in sp_str
+        assert "import pywin32_bootstrap" not in sp_str
+
+
+def test_pth_file_multiple_valid_directories_all_added(tmp_path):
+    """Multiple valid directories listed on separate lines must all be added."""
+    dir1 = tmp_path / "dir_one"
+    dir2 = tmp_path / "dir_two"
+    dir1.mkdir()
+    dir2.mkdir()
+
+    pth_file = tmp_path / "multi.pth"
+    pth_file.write_text(f"{dir1}\n{dir2}\n")
+
+    finder = ModuleFinder(search_paths=[tmp_path])
+
+    assert dir1 in finder.search_paths
+    assert dir2 in finder.search_paths
+
+
+def test_pth_file_comment_lines_skipped(tmp_path):
+    """Comment lines (`#`) must be skipped; valid directories on other lines added."""
+    valid_dir = tmp_path / "valid_after_comment"
+    valid_dir.mkdir()
+
+    pth_file = tmp_path / "with_comment.pth"
+    pth_file.write_text(f"# this is a comment line\n{valid_dir}\n")
+
+    finder = ModuleFinder(search_paths=[tmp_path])
+    assert valid_dir in finder.search_paths
+
+
+    for sp in finder.search_paths:
+        assert "this is a comment" not in str(sp)
+
+
+def test_pth_file_import_lines_skipped(tmp_path):
+    """`import xxx` lines must be skipped (per Python .pth-file spec)."""
+    valid_dir = tmp_path / "valid_after_import"
+    valid_dir.mkdir()
+
+    pth_file = tmp_path / "with_import.pth"
+    pth_file.write_text(f"import some_bootstrap_module\n{valid_dir}\n")
+
+
+    finder = ModuleFinder(search_paths=[tmp_path])
+
+
+    assert valid_dir in finder.search_paths
+
+
+    for sp in finder.search_paths:
+        assert "import some_bootstrap_module" not in str(sp)
+
+
+def test_pth_file_nonexistent_directory_not_added(tmp_path):
+    """Non-existent directories from a .pth file must not be added to search_paths."""
+    bogus = tmp_path / "this_directory_does_not_exist"
+
+    pth_file = tmp_path / "bogus.pth"
+    pth_file.write_text(f"{bogus}\n")
+
+
+    finder = ModuleFinder(search_paths=[tmp_path])
+    assert bogus not in finder.search_paths
+
+
+def test_pth_file_single_valid_directory_added(tmp_path):
+    """A .pth file with a single valid directory line still adds the directory."""
+    only_dir = tmp_path / "only_dir"
+    only_dir.mkdir()
+
+    pth_file = tmp_path / "single.pth"
+    pth_file.write_text(f"{only_dir}\n")
+
+    finder = ModuleFinder(search_paths=[tmp_path])
+    assert only_dir in finder.search_paths
