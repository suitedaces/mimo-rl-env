@@ -0,0 +1,181 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+
+export PYTHONPATH="/workspace/repo/usercase-test-coderl${PYTHONPATH:+:$PYTHONPATH}"
+export PYTHONNOUSERSITE=1
+export HF_DATASETS_OFFLINE=1
+export TRANSFORMERS_OFFLINE=1
+export HF_HUB_OFFLINE=1
+export VLLM_USE_MODELSCOPE=False
+
+( cd /workspace/repo && python -m py_compile scripts/gsm8k_to_math.py ) \
+    || { echo "FAIL: build" >&2; exit 1; }
+
+PYTHON=python
+SCRIPT=/workspace/repo/scripts/gsm8k_to_math.py
+FIXTURES=/workspace/repo/usercase-test-coderl/fixtures
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+assert_jsonl_equals() {
+    local actual=$1 expected=$2 label=$3
+    python - "$actual" "$expected" "$label" <<'PY'
+import json
+import sys
+from pathlib import Path
+
+actual_path = Path(sys.argv[1])
+expected_path = Path(sys.argv[2])
+label = sys.argv[3]
+required_keys = {"problem", "solution", "answer"}
+
+try:
+    actual_rows = [json.loads(line) for line in actual_path.read_text(encoding="utf-8").splitlines()]
+    expected_rows = [json.loads(line) for line in expected_path.read_text(encoding="utf-8").splitlines()]
+except Exception as exc:
+    print(f"FAIL: {label}: invalid JSONL: {exc}", file=sys.stderr)
+    sys.exit(1)
+
+for idx, row in enumerate(actual_rows, start=1):
+    if set(row) != required_keys:
+        print(f"FAIL: {label}: line {idx} keys {sorted(row)}; want {sorted(required_keys)}", file=sys.stderr)
+        sys.exit(1)
+
+if actual_rows != expected_rows:
+    print(f"FAIL: {label}: JSON rows differ", file=sys.stderr)
+    print("actual:", json.dumps(actual_rows, ensure_ascii=False), file=sys.stderr)
+    print("expected:", json.dumps(expected_rows, ensure_ascii=False), file=sys.stderr)
+    sys.exit(1)
+PY
+}
+
+assert_stdout_has_no_converted_records() {
+    local stdout_path=$1 label=$2
+    python - "$stdout_path" "$label" <<'PY'
+import json
+import sys
+from pathlib import Path
+
+stdout_path = Path(sys.argv[1])
+label = sys.argv[2]
+required_keys = {"problem", "solution", "answer"}
+
+for idx, line in enumerate(stdout_path.read_text(encoding="utf-8").splitlines(), start=1):
+    try:
+        row = json.loads(line)
+    except json.JSONDecodeError:
+        continue
+    if isinstance(row, dict) and set(row) == required_keys:
+        print(f"FAIL: {label}: stdout line {idx} contains a converted record", file=sys.stderr)
+        sys.exit(1)
+PY
+}
+
+assert_bad_record_not_written() {
+    local work=$1 needle=$2 label=$3
+    python - "$work" "$needle" "$label" <<'PY'
+import json
+import sys
+from pathlib import Path
+
+work = Path(sys.argv[1])
+needle = sys.argv[2]
+label = sys.argv[3]
+output_dir = work / "data" / "gsm8k_splits"
+
+if not output_dir.exists():
+    sys.exit(0)
+
+for path in output_dir.glob("*.jsonl"):
+    for idx, line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
+        try:
+            row = json.loads(line)
+        except json.JSONDecodeError:
+            continue
+        if row.get("problem") == needle:
+            print(f"FAIL: {label}: wrote invalid input record to {path.name}:{idx}", file=sys.stderr)
+            sys.exit(1)
+PY
+}
+
+
+
+
+
+
+
+work="$TMP/f1_work"
+mkdir -p "$work"
+( cd "$work" && "$PYTHON" "$SCRIPT" "$FIXTURES/success_examples" >out 2>err ); ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+[ -d "$work/data/gsm8k_splits" ] || fail "F1 did not create data/gsm8k_splits"
+[ -f "$work/data/gsm8k_splits/train.jsonl" ] || fail "F1 missing train output"
+[ -f "$work/data/gsm8k_splits/test.jsonl" ] || fail "F1 missing test output"
+
+assert_stdout_has_no_converted_records "$work/out" "F1 stdout"
+
+cat >"$TMP/f1_expected_train.jsonl" <<'EOF'
+{"problem": "What is 1,000 plus 20?", "solution": "Add them. The answer is $\\boxed{1020}$.", "answer": "1020"}
+EOF
+cat >"$TMP/f1_expected_test.jsonl" <<'EOF'
+{"problem": "What is 2+2?", "solution": "Compute 2+2. The answer is $\\boxed{4}$.", "answer": "4"}
+EOF
+assert_jsonl_equals "$work/data/gsm8k_splits/train.jsonl" "$TMP/f1_expected_train.jsonl" "F1 train"
+assert_jsonl_equals "$work/data/gsm8k_splits/test.jsonl" "$TMP/f1_expected_test.jsonl" "F1 test"
+
+
+
+
+
+
+work="$TMP/f2_work"
+mkdir -p "$work"
+( cd "$work" && "$PYTHON" "$SCRIPT" "$FIXTURES/success_numbers" >out 2>err ); ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+
+assert_stdout_has_no_converted_records "$work/out" "F2 stdout"
+
+cat >"$TMP/f2_expected_train.jsonl" <<'EOF'
+{"problem": "What is -5 plus 2?", "solution": "Combine integers. The answer is $\\boxed{-3}$.", "answer": "-3"}
+{"problem": "How many are left from 3 minus 3?", "solution": "Subtract all of them. The answer is $\\boxed{0}$.", "answer": "0"}
+EOF
+cat >"$TMP/f2_expected_test.jsonl" <<'EOF'
+{"problem": "What is 1.5 plus 2?", "solution": "Use decimals. The answer is $\\boxed{3.5}$.", "answer": "3.5"}
+{"problem": "What is 1234 plus 5678?", "solution": "Add the place values. The answer is $\\boxed{6912}$.", "answer": "6912"}
+EOF
+assert_jsonl_equals "$work/data/gsm8k_splits/train.jsonl" "$TMP/f2_expected_train.jsonl" "F2 train"
+assert_jsonl_equals "$work/data/gsm8k_splits/test.jsonl" "$TMP/f2_expected_test.jsonl" "F2 test"
+
+
+
+
+
+work="$TMP/f3_work"
+mkdir -p "$work"
+( cd "$work" && "$PYTHON" "$SCRIPT" "$FIXTURES/error_train" >out 2>err ); ec=$?
+[ "$ec" -ne 0 ] || fail "F3 exit $ec; want non-zero"
+
+assert_bad_record_not_written "$work" "Broken train record" "F3 output"
+grep -q 'ValueError: Cannot extract answer in No final marker here\.' "$work/err" \
+    || fail "F3 stderr missing ValueError message: $(cat "$work/err")"
+
+
+
+
+
+work="$TMP/f4_work"
+mkdir -p "$work"
+( cd "$work" && "$PYTHON" "$SCRIPT" "$FIXTURES/error_test" >out 2>err ); ec=$?
+[ "$ec" -ne 0 ] || fail "F4 exit $ec; want non-zero"
+
+assert_bad_record_not_written "$work" "Broken test record" "F4 output"
+grep -q 'ValueError: Cannot extract answer in No final marker here\.' "$work/err" \
+    || fail "F4 stderr missing ValueError message: $(cat "$work/err")"
+
+echo "PASS"
+exit 0
