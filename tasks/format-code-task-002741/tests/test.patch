+++ b/__tests__/raf-shim.test.js
@@ -0,0 +1,61 @@
+import React from 'react';
+import Helmet from '../src';
+import { render } from './api/utils';
+
+describe('rAF/cAF shim removal', () => {
+  beforeEach(() => {
+    document.title = '';
+  });
+
+  describe('defer behavior preservation', () => {
+    it('updates title synchronously when defer={false}', () => {
+      render(<Helmet defer={false} title="Sync Title" />);
+      expect(document.title).toBe('Sync Title');
+    });
+
+    it('does not update title synchronously when defer={true}', () => {
+      document.title = 'before';
+      render(<Helmet defer={true} title="Async Title" />);
+      expect(document.title).toBe('before');
+    });
+
+    it('updates title asynchronously when defer={true}', done => {
+      document.title = 'before';
+      render(<Helmet defer={true} title="Async Title" />);
+      setTimeout(() => {
+        expect(document.title).toBe('Async Title');
+        done();
+      }, 100);
+    });
+
+    it('calls onChangeClientState asynchronously when defer={true}', done => {
+      const onChange = jest.fn();
+      render(
+        <Helmet defer={true} title="Deferred" onChangeClientState={onChange} />
+      );
+      expect(onChange).not.toBeCalled();
+      setTimeout(() => {
+        expect(onChange).toBeCalled();
+        expect(onChange.mock.calls[0][0]).toEqual(
+          expect.objectContaining({ title: 'Deferred' })
+        );
+        done();
+      }, 100);
+    });
+
+    it('replaces an earlier deferred render when a new one happens before the rAF tick', done => {
+      const onChange = jest.fn();
+      document.title = 'initial';
+      render(
+        <Helmet defer={true} title="First" onChangeClientState={onChange} />
+      );
+      render(
+        <Helmet defer={true} title="Second" onChangeClientState={onChange} />
+      );
+      setTimeout(() => {
+        expect(document.title).toBe('Second');
+        done();
+      }, 100);
+    });
+  });
+});
