@@ -0,0 +1,89 @@
+import Immutable, { Map } from 'immutable';
+
+describe('passwordless connection terms', () => {
+  beforeEach(() => {
+    jest.resetModules();
+
+    jest.mock('field/phone_number', () => ({
+      initLocation: m => m
+    }));
+    jest.mock('core/web_api', () => ({
+      getUserCountry: jest.fn()
+    }));
+    jest.mock('sync', () => jest.fn(m => m));
+    jest.mock('core/index', () => ({
+      id: () => 'id'
+    }));
+  });
+
+  describe('initPasswordless()', () => {
+    it('stores mustAcceptTerms=true in the namespace map when option set', () => {
+      const { initPasswordless, mustAcceptTerms } = require('connection/passwordless/index');
+      const initial = new Map();
+      const model = initPasswordless(initial, {
+        passwordlessMethod: 'link',
+        mustAcceptTerms: true,
+        defaultLocation: 'us'
+      });
+      expect(mustAcceptTerms(model)).toBe(true);
+    });
+
+    it('stores mustAcceptTerms=false in the namespace map when option missing', () => {
+      const { initPasswordless, mustAcceptTerms } = require('connection/passwordless/index');
+      const initial = new Map();
+      const model = initPasswordless(initial, {
+        passwordlessMethod: 'link',
+        defaultLocation: 'us'
+      });
+      expect(mustAcceptTerms(model)).toBe(false);
+    });
+  });
+
+  describe('mustAcceptTerms()', () => {
+    it('returns false on an empty namespace', () => {
+      const { mustAcceptTerms } = require('connection/passwordless/index');
+      const m = Immutable.fromJS({ passwordless: {} });
+      expect(mustAcceptTerms(m)).toBe(false);
+    });
+  });
+
+  describe('termsAccepted()', () => {
+    it('returns true when mustAcceptTerms is false', () => {
+      const { termsAccepted } = require('connection/passwordless/index');
+      const m = Immutable.fromJS({ passwordless: { mustAcceptTerms: false } });
+      expect(termsAccepted(m)).toBe(true);
+    });
+
+    it('returns false when mustAcceptTerms is true and the user has not accepted yet', () => {
+      const { termsAccepted } = require('connection/passwordless/index');
+      const m = Immutable.fromJS({ passwordless: { mustAcceptTerms: true } });
+      expect(termsAccepted(m)).toBe(false);
+    });
+
+    it('returns true when mustAcceptTerms is true and the user has accepted', () => {
+      const { termsAccepted } = require('connection/passwordless/index');
+      const m = Immutable.fromJS({
+        passwordless: { mustAcceptTerms: true, transient: { termsAccepted: true } }
+      });
+      expect(termsAccepted(m)).toBe(true);
+    });
+  });
+
+  describe('toggleTermsAcceptance()', () => {
+    it('flips termsAccepted from false to true', () => {
+      const { toggleTermsAcceptance, termsAccepted } = require('connection/passwordless/index');
+      const m = Immutable.fromJS({ passwordless: { mustAcceptTerms: true } });
+      const m2 = toggleTermsAcceptance(m);
+      expect(termsAccepted(m2)).toBe(true);
+    });
+
+    it('flips termsAccepted from true to false', () => {
+      const { toggleTermsAcceptance, termsAccepted } = require('connection/passwordless/index');
+      const m = Immutable.fromJS({
+        passwordless: { mustAcceptTerms: true, transient: { termsAccepted: true } }
+      });
+      const m2 = toggleTermsAcceptance(m);
+      expect(termsAccepted(m2)).toBe(false);
+    });
+  });
+});
