+import React from 'react';
+import { mockComponent } from 'testUtils';
+
+jest.mock('field/email/email_pane', () => mockComponent('email_pane'));
+jest.mock('field/social/social_buttons_pane', () => mockComponent('social_buttons_pane'));
+jest.mock('core/pane_separator', () => mockComponent('pane_separator'));
+jest.mock('connection/database/sign_up_terms', () => mockComponent('sign_up_terms'));
+
+const getScreen = () => {
+  const SocialOrEmailLoginScreen = require('engine/passwordless/social_or_email_login_screen').default;
+  return new SocialOrEmailLoginScreen();
+};
+
+describe('SocialOrEmailLoginScreen', () => {
+  beforeEach(() => {
+    jest.resetModules();
+
+    jest.mock('connection/passwordless/index', () => ({
+      mustAcceptTerms: () => false,
+      termsAccepted: () => true,
+      showTerms: () => true
+    }));
+    jest.mock('connection/passwordless/actions', () => ({
+      requestPasswordlessEmail: jest.fn(),
+      toggleTermsAcceptance: jest.fn()
+    }));
+    jest.mock('connection/passwordless/email_sent_confirmation', () => ({
+      renderEmailSentConfirmation: jest.fn()
+    }));
+    jest.mock('core/signed_in_confirmation', () => ({
+      renderSignedInConfirmation: jest.fn()
+    }));
+    jest.mock('connection/social/index', () => ({
+      useBigButtons: () => false
+    }));
+    jest.mock('connection/database/index', () => ({
+      getInitialScreen: jest.fn(),
+      hasScreen: jest.fn()
+    }));
+    jest.mock('i18n', () => ({ str: (_, keys) => (keys || []).join(',') }));
+    jest.mock('core/index', () => ({
+      hasSomeConnections: () => false,
+      connections: () => ({ count: () => 0 }),
+      id: () => 'id'
+    }));
+  });
+
+  describe('isSubmitDisabled', () => {
+    it('is true when terms are not yet accepted', () => {
+      require('connection/passwordless/index').termsAccepted = () => false;
+      const screen = getScreen();
+      expect(screen.isSubmitDisabled('m')).toBe(true);
+    });
+
+    it('is false when terms are accepted', () => {
+      require('connection/passwordless/index').termsAccepted = () => true;
+      const screen = getScreen();
+      expect(screen.isSubmitDisabled('m')).toBe(false);
+    });
+  });
+
+  describe('renderTerms', () => {
+    it('returns null when terms text is falsy and mustAcceptTerms is false', () => {
+      require('connection/passwordless/index').mustAcceptTerms = () => false;
+      const screen = getScreen();
+      expect(screen.renderTerms('m', undefined)).toBe(null);
+    });
+
+    it('renders SignUpTerms when terms text is provided (no checkbox)', () => {
+      require('connection/passwordless/index').mustAcceptTerms = () => false;
+      require('connection/passwordless/index').termsAccepted = () => true;
+      const screen = getScreen();
+      const result = screen.renderTerms('m', 'some terms');
+      expect(result).not.toBe(null);
+      expect(result.props.showCheckbox).toBe(false);
+      expect(result.props.checkHandler).toBeUndefined();
+      expect(result.props.children).toBe('some terms');
+    });
+
+    it('renders SignUpTerms with a checkbox when mustAcceptTerms is true and terms text is provided', () => {
+      require('connection/passwordless/index').mustAcceptTerms = () => true;
+      require('connection/passwordless/index').termsAccepted = () => false;
+      const screen = getScreen();
+      const result = screen.renderTerms('m', 'some terms');
+      expect(result).not.toBe(null);
+      expect(result.props.showCheckbox).toBe(true);
+      expect(typeof result.props.checkHandler).toBe('function');
+      expect(result.props.checked).toBe(false);
+    });
+
+    it('passes checked=true to SignUpTerms when termsAccepted is true', () => {
+      require('connection/passwordless/index').mustAcceptTerms = () => true;
+      require('connection/passwordless/index').termsAccepted = () => true;
+      const screen = getScreen();
+      const result = screen.renderTerms('m', 'some terms');
+      expect(result.props.checked).toBe(true);
+      expect(result.props.showCheckbox).toBe(true);
+    });
+
+    it('checkHandler dispatches toggleTermsAcceptance with the lock id', () => {
+      require('connection/passwordless/index').mustAcceptTerms = () => true;
+      require('connection/passwordless/index').termsAccepted = () => false;
+      const screen = getScreen();
+      const result = screen.renderTerms('m', 'some terms');
+      result.props.checkHandler();
+      const { toggleTermsAcceptance } = require('connection/passwordless/actions');
+      expect(toggleTermsAcceptance.mock.calls.length).toBe(1);
+      expect(toggleTermsAcceptance.mock.calls[0][0]).toBe('id');
+    });
+  });
+});
