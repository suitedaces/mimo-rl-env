@@ -500,6 +500,70 @@ def test_enum_schema_cleandoc():
     }
 
 
+def test_enum_with_no_cases_json_schema():
+    class MyEnum(Enum):
+        pass
+
+    class MyModel(BaseModel):
+        e: MyEnum
+
+    schema = MyModel.model_json_schema()
+
+
+    e_schema = schema['properties']['e']
+    if '$ref' in e_schema:
+        ref = e_schema['$ref'].split('/')[-1]
+        e_schema = schema['$defs'][ref]
+    assert e_schema.get('enum') == []
+    assert e_schema.get('title') == 'MyEnum'
+    assert 'e' in schema['required']
+
+
+def test_enum_with_no_cases_includes_description_from_docstring():
+    class MyEnum(Enum):
+        """Some enum description."""
+
+    class MyModel(BaseModel):
+        e: MyEnum
+
+    schema = MyModel.model_json_schema()
+    e_schema = schema['properties']['e']
+    if '$ref' in e_schema:
+        ref = e_schema['$ref'].split('/')[-1]
+        e_schema = schema['$defs'][ref]
+    assert e_schema.get('description') == 'Some enum description.'
+    assert e_schema.get('enum') == []
+    assert e_schema.get('title') == 'MyEnum'
+
+
+def test_enum_with_no_cases_default_docstring_suppressed():
+
+
+    class MyEnum(Enum):
+        pass
+
+    class MyModel(BaseModel):
+        e: MyEnum
+
+    schema = MyModel.model_json_schema()
+    e_schema = schema['properties']['e']
+    if '$ref' in e_schema:
+        ref = e_schema['$ref'].split('/')[-1]
+        e_schema = schema['$defs'][ref]
+    assert 'description' not in e_schema
+
+
+def test_enum_with_no_cases_validation_still_rejects_values():
+    class MyEnum(Enum):
+        pass
+
+    class MyModel(BaseModel):
+        e: MyEnum
+
+    with pytest.raises(ValidationError):
+        MyModel(e='anything')
+
+
