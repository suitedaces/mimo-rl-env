+    first = summarize(capa.capabilities.common.find_capabilities(ruleset, extractor, disable_progress=True))
+
+
+    second = summarize(capa.capabilities.common.find_capabilities(ruleset, extractor, disable_progress=True))
+    assert first["matches"] == second["matches"]
+    assert_match_contains(second, "push 1000", 4223396)
