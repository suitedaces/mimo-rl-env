+          static: basic block
+          dynamic: process
+      features:
+        - characteristic: tight loop
+    """,
+    """
+    rule:
+      meta:
+        name: kill thread loop
+        scopes:
+          static: function
+          dynamic: process
+      features:
+        - and:
+          - characteristic: loop
+          - match: tight loop
+    """,
+    """
+    rule:
+      meta:
+        name: kill thread program
+        scopes:
