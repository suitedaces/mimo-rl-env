+def test_no_global_state_matches_fresh_interpreter_result():
+    in_process = summarize(
+        capa.capabilities.common.find_capabilities(make_ruleset(), ToyStaticExtractor(), disable_progress=True)
+    )
+    script = """
+import importlib.util
+import json
+import sys
+
+sys.path.insert(0, "/workspace/repo")
+spec = importlib.util.spec_from_file_location("fixture_static_caps", "/workspace/repo/usercase-test-coderl/test_static_capabilities.py")
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+caps = module.capa.capabilities.common.find_capabilities(module.make_ruleset(), module.ToyStaticExtractor(), disable_progress=True)
+sys.stdout.write(json.dumps(module.summarize(caps), sort_keys=True))
+"""
+
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=True,
+    )
+
+    fresh_process = json.loads(completed.stdout)
+
+    assert in_process["matches"] == fresh_process["matches"]
+    assert_match_contains(fresh_process, "push 1000", 4223396)
+
+
+def test_no_undeclared_cwd_writes_or_network_connections(tmp_path, monkeypatch):
+    def fail_socket(*args, **kwargs):
+        raise AssertionError("static capability matching must not open network sockets")
+
+    monkeypatch.setattr(socket, "socket", fail_socket)
+    monkeypatch.chdir(tmp_path)
+    before = sorted(os.listdir(tmp_path))
+
+    summary = summarize(capa.capabilities.common.find_capabilities(make_ruleset(), ToyStaticExtractor(), disable_progress=True))
+
+
+    assert sorted(os.listdir(tmp_path)) == before
+    assert_match_contains(summary, "push 1000", 4223396)
