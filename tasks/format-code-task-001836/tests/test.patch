+class ToyStaticExtractor(StaticFeatureExtractor):
+    def __init__(self, variant="full"):
+        super().__init__(SampleHashes(md5="0" * 32, sha1="1" * 40, sha256="2" * 64))
+        self.variant = variant
+        self.functions = [
+            FunctionHandle(AbsoluteVirtualAddress(0x401000), "main"),
+            FunctionHandle(AbsoluteVirtualAddress(0x402000), "helper"),
+            FunctionHandle(AbsoluteVirtualAddress(0x403000), "lib"),
+        ]
+        self.basic_blocks = {
+            0x401000: [
+                BBHandle(AbsoluteVirtualAddress(0x401020), "main-bb0"),
+                BBHandle(AbsoluteVirtualAddress(0x401050), "main-bb1"),
+            ],
+            0x402000: [BBHandle(AbsoluteVirtualAddress(0x402010), "helper-bb0")],
+            0x403000: [BBHandle(AbsoluteVirtualAddress(0x403010), "lib-bb0")],
+        }
+        self.instructions = {
+            0x401020: [
+                InsnHandle(AbsoluteVirtualAddress(0x4071A4), "push-1000"),
+                InsnHandle(AbsoluteVirtualAddress(0x4071AA), "nop"),
+            ],
+            0x401050: [InsnHandle(AbsoluteVirtualAddress(0x407200), "close")],
+            0x402010: [InsnHandle(AbsoluteVirtualAddress(0x402012), "mov")],
+            0x403010: [InsnHandle(AbsoluteVirtualAddress(0x403020), "push-777")],
+        }
+
+    def snapshot(self):
+        return {
+            "variant": self.variant,
+            "functions": [(int(f.address), f.inner) for f in self.functions],
+            "basic_blocks": {
+                str(k): [(int(bb.address), bb.inner) for bb in v] for k, v in sorted(self.basic_blocks.items())
+            },
+            "instructions": {
+                str(k): [(int(insn.address), insn.inner) for insn in v] for k, v in sorted(self.instructions.items())
+            },
+        }
+
+    def get_base_address(self):
+        return AbsoluteVirtualAddress(0x400000)
+
+    def extract_global_features(self):
+        if self.variant != "no-global":
+            yield ccommon.Arch("i386"), NO_ADDRESS
+            yield ccommon.Format("pe"), NO_ADDRESS
+
+    def extract_file_features(self):
+        if self.variant != "no-file-section":
+            yield ffile.Section(".text"), AbsoluteVirtualAddress(0x401000)
+        yield ffile.Import("kernel32.CreateFileA"), AbsoluteVirtualAddress(0x401234)
+
+    def get_functions(self):
+        yield from self.functions
+
+    def is_library_function(self, addr):
+        return int(addr) == 0x403000
+
+    def get_function_name(self, addr):
+        if int(addr) == 0x403000:
+            return "static_lib_helper"
+        raise KeyError(addr)
+
+    def extract_function_features(self, fh):
+        if int(fh.address) == 0x401000:
+            yield ccommon.Characteristic("loop"), fh.address
+        elif int(fh.address) == 0x403000:
+            yield ccommon.Characteristic("recursive call"), fh.address
+
+    def get_basic_blocks(self, fh):
+        yield from self.basic_blocks[int(fh.address)]
+
+    def extract_basic_block_features(self, fh, bbh):
+        if int(bbh.address) == 0x401020:
+            yield ccommon.Characteristic("tight loop"), bbh.address
+
+    def get_instructions(self, fh, bbh):
+        yield from self.instructions[int(bbh.address)]
+
+    def extract_insn_features(self, fh, bbh, ih):
+        if int(ih.address) == 0x4071A4:
+            yield finsn.Mnemonic("push"), ih.address
+            yield finsn.Number(1000), ih.address
+        elif int(ih.address) == 0x4071AA:
+            yield finsn.Mnemonic("nop"), ih.address
+        elif int(ih.address) == 0x403020:
+            yield finsn.Mnemonic("push"), ih.address
+            yield finsn.Number(777), ih.address
+
+
+def make_ruleset():
+    return capa.rules.RuleSet([capa.rules.Rule.from_yaml(textwrap.dedent(rule)) for rule in RULES_YAML])
+
+
+def address_to_plain(addr):
+    if addr == NO_ADDRESS:
+        return "NO_ADDRESS"
+    return int(addr)
+
+
+def summarize(capabilities):
+    return {
+        "matches": {
+            name: [address_to_plain(location) for location, _ in results]
+            for name, results in sorted(capabilities.matches.items())
+        },
+        "feature_counts": {
+            "file": capabilities.feature_counts.file,
+            "functions": [
+                {"address": count.address.model_dump(mode="json"), "count": count.count}
+                for count in capabilities.feature_counts.functions
+            ],
+        },
+        "library_functions": [
+            {"address": library.address.model_dump(mode="json"), "name": library.name}
+            for library in capabilities.library_functions
+        ],
+    }
+
+
+def ruleset_snapshot(ruleset):
+    return sorted((name, str(rule.scopes)) for name, rule in ruleset.rules.items())
+
+
+def assert_match_contains(summary, rule_name, expected_location=None):
+    assert rule_name in summary["matches"]
+    if expected_location is not None:
+        assert expected_location in summary["matches"][rule_name]
+
+
+def assert_no_match(summary, rule_name):
+    assert not summary["matches"].get(rule_name)
+
+
+def expected_analyzed_function_addresses(extractor):
+    return {
+        int(function.address)
+        for function in extractor.get_functions()
+        if not extractor.is_library_function(function.address)
+    }
+
+
+def assert_full_static_behavior(capabilities, extractor):
+    summary = summarize(capabilities)
+
+    assert isinstance(capabilities, capa.capabilities.common.Capabilities)
+    assert_match_contains(summary, "push 1000", 4223396)
+    assert_match_contains(summary, "tight loop")
+    assert_match_contains(summary, "kill thread loop")
+    assert_match_contains(summary, "kill thread program")
+    assert_match_contains(summary, "global arch program")
+    assert_match_contains(summary, "import file rule")
+    assert_match_contains(summary, "push observed program")
+    assert_no_match(summary, "library only push")
+    assert_no_match(summary, "library only recursive function")
+    assert_library_function_was_skipped(summary)
+    assert_feature_counts_are_populated(summary, extractor)
+
+
+def assert_library_function_was_skipped(summary):
+    assert summary["library_functions"] == [
+        {"address": {"type": "absolute", "value": 4206592}, "name": "static_lib_helper"},
+    ]
+
+
+def assert_feature_counts_are_populated(summary, extractor):
+    counts = summary["feature_counts"]
+    assert isinstance(counts["file"], int)
+    assert counts["file"] > 0
+
+    functions_by_address = {
+        item["address"]["value"]: item["count"]
+        for item in counts["functions"]
+    }
+    assert set(functions_by_address) == expected_analyzed_function_addresses(extractor)
+    for function in extractor.get_functions():
+        if extractor.is_library_function(function.address):
+            assert int(function.address) not in functions_by_address
+    assert all(isinstance(count, int) and count >= 0 for count in functions_by_address.values())
+    assert functions_by_address[4198400] > 0
+
