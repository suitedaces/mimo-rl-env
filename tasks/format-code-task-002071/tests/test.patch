diff --git a/usercase-test-coderl/nested_chain_verification.test.js b/usercase-test-coderl/nested_chain_verification.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/nested_chain_verification.test.js
@@ -0,0 +1,280 @@
+'use strict'
+
+var assert = require('assert')
+var sinon = require('sinon')
+var mongoose = require('mongoose')
+
+mongoose.Promise = global.Promise
+require('../lib')
+
+var bookSchema = new mongoose.Schema({
+  title: String,
+})
+
+var Book =
+  mongoose.models.UsercaseFixtureNestedChainBook ||
+  mongoose.model('UsercaseFixtureNestedChainBook', bookSchema)
+
+function expectationFailure(fn) {
+  try {
+    fn()
+  } catch (err) {
+    return err
+  }
+  throw new Error('expected Sinon verification to fail')
+}
+
+function assertChainedExpectationFailure(fn, method) {
+  var err = expectationFailure(fn)
+
+
+  assert.strictEqual(err.name, 'ExpectationError')
+  assert.ok(err.message.indexOf(method) !== -1)
+}
+
+describe('usercase nested chain verification', function() {
+  afterEach(function() {
+    sinon.restore()
+  })
+
+  it('verifies a fully exercised document chain through the top-level mock', function() {
+
+
+
+
+    var bookMock = sinon.mock(new Book({ title: 'Rayuela' }))
+
+    bookMock
+      .expects('update')
+      .withArgs('SOME_ARGUMENTS')
+      .chain('sort')
+      .withArgs({ field: 'asc' })
+      .chain('exec')
+      .resolves('RESULT')
+
+    return bookMock.object
+      .update('SOME_ARGUMENTS')
+      .sort({ field: 'asc' })
+      .exec()
+      .then(function(result) {
+        assert.strictEqual(result, 'RESULT')
+
+        assert.doesNotThrow(function() {
+          bookMock.verify()
+        })
+        assert.doesNotThrow(function() {
+          bookMock.restore()
+        })
+      })
+  })
+
+  it('top-level verify fails with the missing chained sort expectation', function() {
+
+
+
+
+    var bookMock = sinon.mock(new Book({ title: 'Rayuela' }))
+
+    bookMock
+      .expects('update')
+      .chain('sort')
+      .chain('exec')
+      .resolves('RESULT')
+
+    return bookMock.object
+      .update('SOME_ARGUMENTS')
+      .exec()
+      .then(function(result) {
+
+        assertChainedExpectationFailure(function() {
+          bookMock.verify()
+        }, 'sort')
+        assert.doesNotThrow(function() {
+          bookMock.restore()
+        })
+      })
+  })
+
+  it('recursive verify continues past a never() chained expectation', function() {
+
+
+
+
+    var bookMock = sinon.mock(new Book({ title: 'Rayuela' }))
+
+    bookMock
+      .expects('update')
+      .chain('sort')
+      .never()
+      .chain('limit')
+      .chain('exec')
+      .resolves('RESULT')
+
+    return bookMock.object
+      .update('SOME_ARGUMENTS')
+      .exec()
+      .then(function(result) {
+
+        assertChainedExpectationFailure(function() {
+          bookMock.verify()
+        }, 'limit')
+        assert.doesNotThrow(function() {
+          bookMock.restore()
+        })
+      })
+  })
+
+  it('recursive verify continues after an argument-matched inner chain call', function() {
+
+
+
+
+    var bookMock = sinon.mock(new Book({ title: 'Rayuela' }))
+
+    bookMock
+      .expects('update')
+      .chain('sort')
+      .withArgs({ field: 'asc' })
+      .chain('limit')
+      .chain('exec')
+      .resolves('RESULT')
+
+    return bookMock.object
+      .update('SOME_ARGUMENTS')
+      .sort({ field: 'asc' })
+      .exec()
+      .then(function(result) {
+
+        assertChainedExpectationFailure(function() {
+          bookMock.verify()
+        }, 'limit')
+        assert.doesNotThrow(function() {
+          bookMock.restore()
+        })
+      })
+  })
+
+  it('sinon.verify reports the same missing chained expectation for default sandbox mocks', function() {
+
+
+
+
+    var bookMock = sinon.mock(new Book({ title: 'Rayuela' }))
+
+    bookMock
+      .expects('update')
+      .chain('sort')
+      .chain('exec')
+      .resolves('RESULT')
+
+    return bookMock.object
+      .update('SOME_ARGUMENTS')
+      .exec()
+      .then(function(result) {
+
+        assertChainedExpectationFailure(function() {
+          sinon.verify()
+        }, 'sort')
+        assert.doesNotThrow(function() {
+          sinon.restore()
+        })
+      })
+  })
+
+  it('keeps chained verification state independent across two mock instances', function() {
+
+
+
+
+    var a = sinon.mock(new Book({ title: 'Rayuela' }))
+    var b = sinon.mock(new Book({ title: 'Bestiario' }))
+
+    a.expects('update')
+      .chain('sort')
+      .chain('exec')
+      .resolves('A_RESULT')
+
+    b.expects('update')
+      .chain('sort')
+      .chain('exec')
+      .resolves('B_RESULT')
+
+    return Promise.all([
+      a.object.update('A_ARGUMENTS').exec(),
+      b.object
+        .update('B_ARGUMENTS')
+        .sort()
+        .exec(),
+    ]).then(function(results) {
+
+      assert.strictEqual(results[1], 'B_RESULT')
+      assert.doesNotThrow(function() {
+        b.verify()
+      })
+      assertChainedExpectationFailure(function() {
+        a.verify()
+      }, 'sort')
+      assert.doesNotThrow(function() {
+        a.restore()
+      })
+      assert.doesNotThrow(function() {
+        b.restore()
+      })
+    })
+  })
+
+  it('allows cleanup to be called twice after verification', function() {
+
+
+
+
+    var bookMock = sinon.mock(new Book({ title: 'Rayuela' }))
+
+    bookMock
+      .expects('update')
+      .chain('sort')
+      .chain('exec')
+      .resolves('RESULT')
+
+    return bookMock.object
+      .update('SOME_ARGUMENTS')
+      .sort()
+      .exec()
+      .then(function(result) {
+        assert.strictEqual(result, 'RESULT')
+
+        assert.doesNotThrow(function() {
+          bookMock.verify()
+        })
+        assert.doesNotThrow(function() {
+          bookMock.restore()
+        })
+      })
+  })
+
+  it('verifies missing chained expectations on model mocks', function() {
+
+
+
+
+    var BookMock = sinon.mock(Book)
+
+    BookMock.expects('find')
+      .withArgs('SOME_ARGUMENTS')
+      .chain('sort')
+      .chain('exec')
+      .resolves('RESULT')
+
+    return Book.find('SOME_ARGUMENTS')
+      .exec()
+      .then(function() {
+
+        assertChainedExpectationFailure(function() {
+          BookMock.verify()
+        }, 'sort')
+        assert.doesNotThrow(function() {
+          BookMock.restore()
+        })
+      })
+  })
+})
