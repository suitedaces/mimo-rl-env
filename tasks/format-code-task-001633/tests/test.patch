diff --git a/packages/pretty-format/src/__tests__/window.test.js b/packages/pretty-format/src/__tests__/window.test.js
new file mode 100644
index 0000000000..efb2579e53
--- /dev/null
+++ b/packages/pretty-format/src/__tests__/window.test.js
@@ -0,0 +1,37 @@
+/**
+ * Copyright (c) 2014-present, Facebook, Inc. All rights reserved.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+ * @jest-environment jsdom
+ */
+/* eslint-env browser */
+
+'use strict';
+
+const prettyFormat = require('../');
+
+describe('prettyFormat() with global window', () => {
+  it('does not throw when passed the global window object', () => {
+    expect(() => prettyFormat(window)).not.toThrow();
+  });
+
+  it('formats window using its constructor name in brackets', () => {
+    expect(prettyFormat(window)).toEqual('[Window]');
+  });
+
+  it('formats window the same way in min mode', () => {
+    expect(prettyFormat(window, {min: true})).toEqual('[Window]');
+  });
+
+  it('formats window when nested inside an array', () => {
+    expect(prettyFormat([window])).toEqual('Array [\n  [Window],\n]');
+  });
+
+  it('formats window when nested as an object property', () => {
+    expect(prettyFormat({win: window})).toEqual(
+      'Object {\n  "win": [Window],\n}',
+    );
+  });
+});
