+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+export npm_config_offline=true
+export npm_config_audit=false
+export npm_config_fund=false
+export YARN_ENABLE_NETWORK=0
+
+if [ ! -d node_modules ]; then
+  echo "node_modules is required for offline test execution" >&2
+  exit 1
+fi
+
+node - <<'NODE'
+const required = [
+  "@babel/register",
+  "@babel/preset-typescript",
+  "@babel/preset-react",
+  "@babel/plugin-transform-modules-commonjs",
+  "@babel/runtime/helpers/interopRequireDefault",
+  "react",
+  "classnames",
+];
+for (const id of required) {
+  require.resolve(id);
+}
+NODE
+exec node /workspace/repo/usercase-test-coderl/listview-states.test.js
