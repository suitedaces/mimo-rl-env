+def test_two_sync_clients_keep_independent_request_state():
+
+
+
+
+  records_a = []
+  records_b = []
+  client_a = Client(host='http://a.test', transport=_create_json_transport(records_a, response_status='success-a'))
+  client_b = Client(host='http://b.test', transport=_create_json_transport(records_b, response_status='success-b'))
+
+  response_a = client_a.create('model-a', from_='llama2')
+
+  assert response_a.status == 'success-a'
+  assert records_a == [('POST', '/api/create', {'model': 'model-a', 'stream': False, 'from': 'llama2'})]
+  assert records_b == []
+
+  response_b = client_b.create('model-b', from_='mistral')
+
+  assert response_b.status == 'success-b'
+  assert records_a == [('POST', '/api/create', {'model': 'model-a', 'stream': False, 'from': 'llama2'})]
+  assert records_b == [('POST', '/api/create', {'model': 'model-b', 'stream': False, 'from': 'mistral'})]
+  client_a.close()
+  client_b.close()
+
+
+def test_module_level_create_uses_default_sync_client_public_api(monkeypatch):
+
+
+
+
+  with _RecordingServer(close_after_response=True) as server:
+    with monkeypatch.context() as scoped:
+      scoped.setenv('OLLAMA_HOST', server.url)
+      reloaded = importlib.reload(ollama)
+      response = reloaded.create('dummy', from_='llama2')
+
+    importlib.reload(ollama)
+
+  assert response.status == 'success'
+  assert server.records == [('POST', '/api/create', {'model': 'dummy', 'stream': False, 'from': 'llama2'})]
+
+
+def test_sync_create_repeated_clients_send_create_requests():
+
+
+
+
+  with _RecordingServer() as server:
+    for index in range(3):
+      client = Client(host=server.url)
+      response = client.create(f'leak-check-{index}', from_='llama2')
+      assert response.status == 'success'
+      client.close()
+
+
+  assert len(server.records) == 3
+  assert [record[2]['model'] for record in server.records] == ['leak-check-0', 'leak-check-1', 'leak-check-2']
+
+
