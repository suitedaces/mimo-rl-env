+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const Module = require('node:module');
+const test = require('node:test');
+
+
+
+
+
+
+
+
+
+
+
+const REPO = '/workspace/repo';
+const WORK_ROOT = '/workspace/repo/usercase-test-coderl/fixtures/tmp-work';
+
+function installElectronHarness() {
+  const originalLoad = Module._load;
+  Module._load = function patchedLoad(request, parent, isMain) {
+    if (request === 'electron') {
+      return {
+        shell: { openPath() {} },
+        ipcRenderer: {
+          send() {},
+          on() {},
+          removeListener() {},
+          removeAllListeners() {},
+        },
+      };
+    }
+    if (request === '@electron/remote') {
+      return {
+        dialog: {
+          showSaveDialog: async () => ({ canceled: true }),
+          showOpenDialog: async () => ({ canceled: true, filePaths: [] }),
+        },
+      };
+    }
+    return originalLoad.apply(this, arguments);
+  };
+
+  global.window = {
+    require,
+    isMainWindow: 1,
+    currentProject: null,
+  };
+}
+
+function installTranspileForAppSource() {
+  const ts = require('typescript');
+  const originalJs = require.extensions['.js'];
+  require.extensions['.js'] = function compileAppSource(mod, filename) {
+    if (filename.startsWith(path.join(REPO, 'src') + path.sep)) {
+      const source = fs.readFileSync(filename, 'utf8');
+
+      const result = ts.transpileModule(source, {
+        fileName: filename,
+        compilerOptions: {
+          esModuleInterop: true,
+          module: ts.ModuleKind.CommonJS,
+          target: ts.ScriptTarget.ES2020,
+        },
+      });
+      mod._compile(result.outputText, filename);
+      return;
+    }
+    originalJs(mod, filename);
+  };
+}
+
+installElectronHarness();
+installTranspileForAppSource();
+
+const templateManager = require('/workspace/repo/src/controller/gui/TemplateManager.js').default;
+
+function resetProject(projectName) {
+  const projectPath = path.join(WORK_ROOT, projectName);
+  fs.rmSync(projectPath, { recursive: true, force: true });
+  fs.mkdirSync(projectPath, { recursive: true });
+  window.currentProject = { path: projectPath };
+  return projectPath;
+}
+
+function writeJson(filePath, value) {
+  fs.mkdirSync(path.dirname(filePath), { recursive: true });
+  fs.writeFileSync(filePath, JSON.stringify(value), 'utf8');
+}
+
+function countJsonFiles(directory) {
+  if (!fs.existsSync(directory)) {
+    return 0;
+  }
+  return fs.readdirSync(directory).filter((file) => file.endsWith('.json')).length;
+}
+
+test('getTemplateDir requires an open project path with the documented Error', () => {
+
+
+
+
+  window.currentProject = null;
+
+  assert.throws(
+    () => templateManager.getTemplateDir(),
+    (error) => {
+      assert.equal(error.constructor, Error);
+      assert.equal(error.message, '没有打开的项目');
+      return true;
+    },
+  );
+});
+
+test('getTemplateDir creates the project templates directory and is repeatable', () => {
+
+
+
+
+  resetProject('dir-default-project');
+
+  assert.equal(fs.existsSync('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/dir-default-project/templates'), false);
+  assert.equal(
+    templateManager.getTemplateDir(),
+    '/workspace/repo/usercase-test-coderl/fixtures/tmp-work/dir-default-project/templates',
+  );
+  assert.equal(fs.existsSync('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/dir-default-project/templates'), true);
+  assert.equal(
+    templateManager.getTemplateDir(),
+    '/workspace/repo/usercase-test-coderl/fixtures/tmp-work/dir-default-project/templates',
+  );
+  assert.equal(fs.existsSync('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/dir-default-project/templates'), true);
+});
+
+test('getTemplateListByProject returns summaries for json templates and ignores non-json files', () => {
+
+
+
+
+  resetProject('list-project');
+  fs.mkdirSync('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/list-project/templates', { recursive: true });
+  fs.writeFileSync('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/list-project/templates/notes.txt', 'not a template', 'utf8');
+  writeJson('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/list-project/templates/drive.json', {
+    name: 'Drive',
+    description: '...',
+    version: '1.0.0',
+    created: '2026-01-01T00:00:00.000Z',
+    nodes: [{ id: 'a' }, { id: 'b' }],
+  });
+
+  assert.deepEqual(
+    templateManager.getTemplateListByProject('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/list-project'),
+    [{
+      name: 'Drive',
+      description: '...',
+      version: '1.0.0',
+      created: '2026-01-01T00:00:00.000Z',
+      fileName: 'drive.json',
+      nodeCount: 2,
+    }],
+  );
+});
+
+test('getTemplateListByProject returns an empty array when a template cannot be parsed', () => {
+
+
+
+
+  resetProject('bad-list-project');
+  fs.mkdirSync('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/bad-list-project/templates', { recursive: true });
+  fs.writeFileSync('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/bad-list-project/templates/bad.json', '{', 'utf8');
+
+  assert.deepEqual(
+    templateManager.getTemplateListByProject('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/bad-list-project'),
+    [],
+  );
+});
+
+test('saveTemplate writes pretty JSON, list observes the saved file, and deleteTemplate removes it', async () => {
+
+
+
+
+  resetProject('save-delete-project');
+
+  const savedTemplate = {
+    name: 'Saved Drive',
+    description: 'Saved template',
+    version: '2.0.0',
+    created: '2026-02-02T03:04:05.000Z',
+    nodes: [{
+      id: 'n1',
+      path: '/pkg/node.py',
+      position: { x: 12, y: 34 },
+    }],
+    edges: [{ id: 'e1' }],
+  };
+
+  assert.equal(await templateManager.saveTemplate('saved', savedTemplate), 'saved.json');
+
+  const savedContent = fs.readFileSync('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/save-delete-project/templates/saved.json', 'utf8');
+
+  assert.deepEqual(JSON.parse(savedContent), savedTemplate);
+  assert.match(savedContent, /\n\s+"name": "Saved Drive"/);
+  assert.match(savedContent, /\n\s+"nodes": \[/);
+  assert.deepEqual(templateManager.getTemplateList(), [{
+    name: 'Saved Drive',
+    description: 'Saved template',
+    version: '2.0.0',
+    created: '2026-02-02T03:04:05.000Z',
+    fileName: 'saved.json',
+    nodeCount: 1,
+  }]);
+
+  assert.equal(await templateManager.deleteTemplate('saved.json'), true);
+  assert.equal(fs.existsSync('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/save-delete-project/templates/saved.json'), false);
+  assert.deepEqual(templateManager.getTemplateList(), []);
+});
+
+test('saveTemplate rethrows the missing-project Error instead of reporting success', async () => {
+
+
+
+
+  window.currentProject = null;
+
+  await assert.rejects(
+    templateManager.saveTemplate('drive', {
+      name: 'Drive',
+      nodes: [],
+    }),
+    (error) => {
+      assert.equal(error.constructor, Error);
+      assert.equal(error.message, '没有打开的项目');
+      return true;
+    },
+  );
+});
+
+test('deleteTemplate rethrows a missing-file unlink Error instead of reporting success', async () => {
+
+
+
+
+  resetProject('delete-missing-project');
+
+  await assert.rejects(
+    templateManager.deleteTemplate('missing.json'),
+    (error) => {
+
+      assert.equal(error.constructor, Error);
+      assert.match(error.message, /missing\.json|ENOENT|no such file/i);
+      return true;
+    },
+  );
+});
+
+test('loadTemplate filters nodes without paths and defaults missing or non-numeric positions', async () => {
+
+
+
+
+  resetProject('load-normalize-project');
+  writeJson('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/load-normalize-project/templates/messy.json', {
+    name: 'Messy',
+    description: 'Needs cleanup',
+    version: '3.0.0',
+    created: '2026-03-03T00:00:00.000Z',
+    nodes: [
+      { id: 'keep-position', path: '/nodes/a.py', position: { x: 7, y: 9 } },
+      { id: 'missing-path', position: { x: 1, y: 1 } },
+      { id: 'missing-position', path: '/nodes/b.py' },
+      { id: 'bad-x', path: '/nodes/c.py', position: { x: 'bad', y: 2 } },
+      { id: 'bad-y', path: '/nodes/d.py', position: { x: 3 } },
+    ],
+    edges: [{ id: 'edge-a' }],
+  });
+
+  assert.deepEqual(
+    await templateManager.loadTemplate(
+      'messy.json',
+      '/workspace/repo/usercase-test-coderl/fixtures/tmp-work/load-normalize-project',
+    ),
+    {
+      name: 'Messy',
+      description: 'Needs cleanup',
+      version: '3.0.0',
+      created: '2026-03-03T00:00:00.000Z',
+      nodes: [
+        { id: 'keep-position', path: '/nodes/a.py', position: { x: 7, y: 9 } },
+        { id: 'missing-position', path: '/nodes/b.py', position: { x: 100, y: 100 } },
+        { id: 'bad-x', path: '/nodes/c.py', position: { x: 100, y: 100 } },
+        { id: 'bad-y', path: '/nodes/d.py', position: { x: 100, y: 100 } },
+      ],
+      edges: [{ id: 'edge-a' }],
+    },
+  );
+});
+
+test('separate project paths keep independent template lists', async () => {
+
+
+
+
+  resetProject('independent-a');
+  await templateManager.saveTemplate('only-a', {
+    name: 'Only A',
+    description: 'Project A template',
+    version: '1.0.0',
+    created: '2026-04-04T00:00:00.000Z',
+    nodes: [{ id: 'a1', path: '/nodes/a.py', position: { x: 1, y: 2 } }],
+  });
+  resetProject('independent-b');
+
+  assert.deepEqual(
+    templateManager.getTemplateListByProject('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/independent-a'),
+    [{
+      name: 'Only A',
+      description: 'Project A template',
+      version: '1.0.0',
+      created: '2026-04-04T00:00:00.000Z',
+      fileName: 'only-a.json',
+      nodeCount: 1,
+    }],
+  );
+  assert.deepEqual(
+    templateManager.getTemplateListByProject('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/independent-b'),
+    [],
+  );
+});
+
+test('repeated save-load-delete cycles leave the template directory file count bounded', async () => {
+
+
+
+
+  resetProject('leak-floor-project');
+  templateManager.getTemplateDir();
+
+  assert.equal(countJsonFiles('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/leak-floor-project/templates'), 0);
+  for (let i = 0; i < 120; i += 1) {
+    const name = `cycle-${i}`;
+    assert.equal(await templateManager.saveTemplate(name, {
+      name: `Cycle ${i}`,
+      description: 'Leak floor template',
+      version: '1.0.0',
+      created: '2026-05-05T00:00:00.000Z',
+      nodes: [{ id: `node-${i}`, path: '/nodes/cycle.py', position: { x: 5, y: 6 } }],
+    }), `${name}.json`);
+    assert.deepEqual(await templateManager.loadTemplate(`${name}.json`), {
+      name: `Cycle ${i}`,
+      description: 'Leak floor template',
+      version: '1.0.0',
+      created: '2026-05-05T00:00:00.000Z',
+      nodes: [{ id: `node-${i}`, path: '/nodes/cycle.py', position: { x: 5, y: 6 } }],
+    });
+    assert.equal(await templateManager.deleteTemplate(`${name}.json`), true);
+  }
+
+  assert.equal(countJsonFiles('/workspace/repo/usercase-test-coderl/fixtures/tmp-work/leak-floor-project/templates'), 0);
+});
