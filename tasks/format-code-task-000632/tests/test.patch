@@ -5,6 +5,7 @@ import {
   LegendPosition,
   MathExpression,
   Metric,
+  Row,
   Shading,
   VerticalShading,
 } from "aws-cdk-lib/aws-cloudwatch";
@@ -541,3 +542,194 @@ test("throws error if attempting to add both a regular alarm and an anomoly dete
     "Adding both a regular alarm and an anomaly detection alarm at the same time is not supported"
   );
 });
+
+function getGraphWidgetWidths(monitoring: CustomMonitoring): number[] {
+  const rows = monitoring.widgets() as Row[];
+
+  const graphRow = rows[rows.length - 1];
+  return graphRow.widgets.map((w) => {
+    const json = w.toJson() as Array<{ width: number }>;
+    return json[0].width;
+  });
+}
+
+test("graphWidgetWidth overrides auto-calculated width for that metric group", () => {
+  const stack = new Stack();
+  const scope = new TestMonitoringScope(stack, "Scope");
+
+  const monitoring = new CustomMonitoring(scope, {
+    alarmFriendlyName: "DummyAlarmName",
+    humanReadableName: "DummyName",
+    metricGroups: [
+      {
+        title: "OverriddenGroup",
+        graphWidgetWidth: 8,
+        metrics: [
+          new Metric({ metricName: "DummyMetric1", namespace, dimensionsMap }),
+        ],
+      },
+    ],
+  });
+
+  const widths = getGraphWidgetWidths(monitoring);
+  expect(widths).toEqual([8]);
+});
+
+test("metric group without graphWidgetWidth uses auto-calculated default", () => {
+  const stack = new Stack();
+  const scope = new TestMonitoringScope(stack, "Scope");
+
+
+  const monitoring = new CustomMonitoring(scope, {
+    alarmFriendlyName: "DummyAlarmName",
