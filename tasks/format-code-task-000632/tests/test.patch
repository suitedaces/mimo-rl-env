+test("graphWidgetWidth on metric group is reflected in dashboard body", () => {
+  const stack = new Stack();
+  const scope = new TestMonitoringScope(stack, "Scope");
+
+  const monitoring = new CustomMonitoring(scope, {
+    alarmFriendlyName: "DummyAlarmName",
+    humanReadableName: "DummyName",
+    metricGroups: [
+      {
+        title: "WidthExplicit",
+        graphWidgetWidth: 11,
+        metrics: [
+          new Metric({
+            metricName: "WidthExplicitMetric",
+            namespace,
+            dimensionsMap,
+          }),
+        ],
+      },
+    ],
+  });
+
+  addMonitoringDashboardsToStack(stack, monitoring);
+  const template = Template.fromStack(stack);
+  const dashboards = template.findResources("AWS::CloudWatch::Dashboard");
+  const bodies = Object.values(dashboards).map(
+    (r: any) => r.Properties.DashboardBody
+  );
+
+
+  const flatten = (body: any): string => {
+    if (typeof body === "string") return body;
+    if (body && body["Fn::Join"]) {
+      const parts = body["Fn::Join"][1] as any[];
+      return parts.map(flatten).join("");
+    }
+    return "";
+  };
+  const joined = bodies.map(flatten).join("\n");
+  expect(joined).toMatch(/"type":"metric","width":11,/);
+
+
+  expect(joined).not.toMatch(/"type":"metric","width":24,/);
+});
+
+test("graphWidgetWidth on a metric group with anomaly detection widget is applied", () => {
+  const stack = new Stack();
+  const scope = new TestMonitoringScope(stack, "Scope");
+
+  const monitoring = new CustomMonitoring(scope, {
+    alarmFriendlyName: "AnomalyAlarmName",
+    metricGroups: [
+      {
+        title: "AnomalyGroupWithWidth",
+        graphWidgetWidth: 9,
+        metrics: [
+          {
+            metric: new MetricFactory({
+              globalDefaults: { namespace: "AnomalyNamespace" },
+            }).createMetricAnomalyDetection(
+              new Metric({
+                metricName: "AnomalyMetric",
+                namespace,
+                dimensionsMap,
+              }),
+              2,
+              "AnomalyLabel",
+              "blue",
+              "expression"
+            ),
+            alarmFriendlyName: "AnomalyMetricAlarm",
+            anomalyDetectionStandardDeviationToRender: 2,
+          },
+        ],
+      },
+    ],
+  });
+
+  const widths = getGraphWidgetWidths(monitoring);
+  expect(widths).toEqual([9]);
+});
