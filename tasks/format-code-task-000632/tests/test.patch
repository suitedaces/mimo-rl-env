+    metricGroups: [
+      {
+        title: "G1",
+        metrics: [
+          new Metric({ metricName: "M1", namespace, dimensionsMap }),
+        ],
+      },
+      {
+        title: "G2",
+        metrics: [
+          new Metric({ metricName: "M2", namespace, dimensionsMap }),
+        ],
+      },
+      {
+        title: "G3",
+        metrics: [
+          new Metric({ metricName: "M3", namespace, dimensionsMap }),
+        ],
+      },
+      {
+        title: "G4",
+        metrics: [
+          new Metric({ metricName: "M4", namespace, dimensionsMap }),
+        ],
+      },
+    ],
+  });
+
+  const widths = getGraphWidgetWidths(monitoring);
+  expect(widths).toEqual([6, 6, 6, 6]);
+});
+
