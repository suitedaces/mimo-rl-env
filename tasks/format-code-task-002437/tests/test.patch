diff --git a/test-data/unit/check-literal.test b/test-data/unit/check-literal.test
index de4440ce7..905f1afd2 100644
--- a/test-data/unit/check-literal.test
+++ b/test-data/unit/check-literal.test
@@ -2946,3 +2946,58 @@ class C(B[Literal["word"]]):
 reveal_type(C().collection)  # N: Revealed type is "builtins.list[Literal['word']]"
 reveal_type(C().word)  # N: Revealed type is "Literal['word']"
 [builtins fixtures/tuple.pyi]
+
+[case testPositiveUnaryOpOnIntLiteralAssign]
+from typing_extensions import Literal, Final
+
+# Issue verbatim: +1 should be inferred as Literal[1]
+x: Literal[1] = +1
+y: Literal[5] = +5
+z: Literal[100] = +100
+
+# Mismatched value should still error
+bad: Literal[1] = +2  # E: Incompatible types in assignment (expression has type "Literal[2]", variable has type "Literal[1]")
+
+# +Final variable should also work
+ONE: Final = 1
+p: Literal[1] = +ONE
+
+# +Literal variable should work
+def fn() -> None:
+    v: Literal[5] = 5
+    q: Literal[5] = +v
+[builtins fixtures/ops.pyi]
+
+[case testPositiveUnaryOpRevealType]
+from typing_extensions import Literal, Final
+
+def fn() -> None:
+    v: Literal[5] = 5
+    reveal_type(+v)  # N: Revealed type is "Literal[5]"
+    reveal_type(-v)  # N: Revealed type is "Literal[-5]"
+
+ONE: Final = 1
+reveal_type(+ONE)  # N: Revealed type is "Literal[1]?"
+reveal_type(-ONE)  # N: Revealed type is "Literal[-1]?"
+[builtins fixtures/ops.pyi]
+
+[case testPositiveUnaryOpInFunctionCallContext]
+from typing_extensions import Literal
+
+def takes_literal_5(x: Literal[5]) -> None: ...
+
+takes_literal_5(+5)  # OK
+takes_literal_5(-5)  # E: Argument 1 to "takes_literal_5" has incompatible type "Literal[-5]"; expected "Literal[5]"
+takes_literal_5(+6)  # E: Argument 1 to "takes_literal_5" has incompatible type "Literal[6]"; expected "Literal[5]"
+[builtins fixtures/ops.pyi]
+
+[case testPositiveUnaryOpTupleIndex]
+from typing import Tuple
+
+t: Tuple[int, str, bool]
+reveal_type(t[+0])  # N: Revealed type is "builtins.int"
+reveal_type(t[+1])  # N: Revealed type is "builtins.str"
+reveal_type(t[+2])  # N: Revealed type is "builtins.bool"
+reveal_type(t[-1])  # N: Revealed type is "builtins.bool"
+[builtins fixtures/ops.pyi]
+
