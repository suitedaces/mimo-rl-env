diff --git a/test/rules/std_CP01_CP05_bigquery_struct_array_test.py b/test/rules/std_CP01_CP05_bigquery_struct_array_test.py
new file mode 100644
index 000000000..88e4c0913
--- /dev/null
+++ b/test/rules/std_CP01_CP05_bigquery_struct_array_test.py
@@ -0,0 +1,110 @@
+
+
+
+
+
+
+
+
+
+
+import sqlfluff
+
+
+ISSUE_SQL = (
+    "create table foo (\n"
+    "    coord STRUCT<x INT64, y INT64>,\n"
+    "    items ARRAY<STRING>\n"
+    ")\n"
+)
+
+
+def _codes(violations):
+    return [v["code"] for v in violations]
+
+
+def test_cp01_issue_repro_no_keyword_violations():
+
+
+
+
+
+
+    result = sqlfluff.lint(ISSUE_SQL, dialect="bigquery", rules=["CP01"])
+    assert _codes(result) == [], (
+        f"Expected no CP01 violations on the issue SQL, got: {result}"
+    )
+
+
+def test_cp01_array_uppercase_in_lowercase_context():
+
+    sql = "create table foo (items ARRAY<string>)\n"
+    result = sqlfluff.lint(sql, dialect="bigquery", rules=["CP01"])
+    assert _codes(result) == [], (
+        f"Expected no CP01 violations for uppercase ARRAY in lowercase context, got: {result}"
+    )
+
+
+def test_cp01_struct_uppercase_in_lowercase_context():
+
+    sql = "create table foo (coord STRUCT<x int64, y int64>)\n"
+    result = sqlfluff.lint(sql, dialect="bigquery", rules=["CP01"])
+    assert _codes(result) == [], (
+        f"Expected no CP01 violations for uppercase STRUCT in lowercase context, got: {result}"
+    )
+
+
+def test_cp01_struct_array_lowercase_in_uppercase_context():
+
+
+
+
+
+    sql = (
+        "CREATE TABLE FOO (\n"
+        "    coord struct<x INT64, y INT64>,\n"
+        "    items array<STRING>\n"
+        ")\n"
+    )
+    result = sqlfluff.lint(sql, dialect="bigquery", rules=["CP01"])
+    assert _codes(result) == [], (
+        f"Expected no CP01 violations for lowercase struct/array in uppercase context, got: {result}"
+    )
+
+
+def test_cp01_still_fires_for_inconsistent_keywords():
+
+    sql = "SELECT 1 from foo"
+    result = sqlfluff.lint(sql, dialect="bigquery", rules=["CP01"])
+
+    assert "CP01" in _codes(result), (
+        f"Expected CP01 to still fire on plainly inconsistent keywords, got: {result}"
+    )
+
+
+def test_full_lint_issue_repro_has_no_cp01():
+
+    result = sqlfluff.lint(ISSUE_SQL, dialect="bigquery")
+    cp01 = [v for v in result if v["code"] == "CP01"]
+    assert cp01 == [], f"Expected no CP01 violations from default lint, got: {cp01}"
+
+
+def test_cp05_treats_struct_array_as_datatype():
+
+
+
+
+
+
+    sql = (
+        "create table foo (\n"
+        "    coord STRUCT<x int64, y int64>,\n"
+        "    items ARRAY<string>\n"
+        ")\n"
+    )
+    result = sqlfluff.lint(sql, dialect="bigquery", rules=["CP05"])
+    cp05 = [v for v in result if v["code"] == "CP05"]
+    assert len(cp05) > 0, (
+        "Expected CP05 to flag inconsistent capitalisation of STRUCT/ARRAY "
+        f"(treated as datatypes), but got no violations: {result}"
+    )
