+func TestCodespecApplyYAMLLookupFailureKeepsEarlierResults(t *testing.T) {
+	controller, client := codespecApplyClient(t)
+	defer controller.Finish()
+	var creates []*unstructured.Unstructured
+	getCount := 0
+	get := func(_ context.Context, key store.Key) (*unstructured.Unstructured, error) {
+		getCount++
+		if getCount == 2 {
+			return nil, errors.New("lookup unavailable")
+		}
+		return nil, kerrors.NewNotFound(schema.GroupResource{}, key.Name)
+	}
+	create := func(_ context.Context, object *unstructured.Unstructured) error {
+		creates = append(creates, object.DeepCopy())
+		return nil
+	}
+
+	input := `
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: completed
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: fails-at-runtime
+`
+	results, err := CreateOrUpdateFromHandler(context.Background(), "default", input, get, create, client)
+
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "lookup unavailable")
+	assert.Equal(t, []string{"Created ConfigMap (v1) completed in default"}, results)
+	require.Len(t, creates, 1)
+	assert.Equal(t, "completed", creates[0].GetName())
+}
+
+func TestCodespecApplyYAMLDiscoveryFailureKeepsEarlierResults(t *testing.T) {
+	controller := gomock.NewController(t)
+	defer controller.Finish()
+	client := clusterFake.NewMockClientInterface(controller)
+	client.EXPECT().Resource(schema.GroupKind{Kind: "ConfigMap"}).Return(
+		schema.GroupVersionResource{Version: "v1", Resource: "configmaps"}, true, nil)
+	client.EXPECT().Resource(schema.GroupKind{Kind: "Secret"}).Return(
+		schema.GroupVersionResource{}, false, errors.New("discovery unavailable"))
+	recorder := &codespecApplyRecorder{}
+
+	input := `
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: completed
+---
+apiVersion: v1
+kind: Secret
+metadata:
+  name: fails-at-discovery
+`
+	results, err := CreateOrUpdateFromHandler(context.Background(), "default", input, recorder.get, recorder.create, client)
+
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "discovery unavailable")
+	assert.Equal(t, []string{"Created ConfigMap (v1) completed in default"}, results)
+	require.Len(t, recorder.creates, 1)
+	assert.Equal(t, "completed", recorder.creates[0].GetName())
+}
