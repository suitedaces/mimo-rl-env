+func TestCodespecApplyYAMLPatchFailureKeepsEarlierResults(t *testing.T) {
+	controller := gomock.NewController(t)
+	defer controller.Finish()
+	client := clusterFake.NewMockClientInterface(controller)
+	dynamicClient := clusterFake.NewMockDynamicInterface(controller)
+	resourceClient := clusterFake.NewMockNamespaceableResourceInterface(controller)
+	gvr := schema.GroupVersionResource{Version: "v1", Resource: "configmaps"}
+	client.EXPECT().Resource(schema.GroupKind{Kind: "ConfigMap"}).Return(gvr, true, nil).Times(2)
+	client.EXPECT().DynamicClient().Return(dynamicClient, nil)
+	dynamicClient.EXPECT().Resource(gvr).Return(resourceClient)
+	resourceClient.EXPECT().Namespace("default").Return(resourceClient)
+	resourceClient.EXPECT().Patch(
+		gomock.Any(), "fails-at-patch", types.ApplyPatchType, gomock.Any(),
+		metav1.PatchOptions{FieldManager: "octant", Force: func() *bool { v := true; return &v }()},
+		gomock.Any(),
+	).Return(nil, errors.New("patch unavailable"))
+
+	getCount := 0
+	get := func(_ context.Context, key store.Key) (*unstructured.Unstructured, error) {
+		getCount++
+		if getCount == 1 {
+			return nil, kerrors.NewNotFound(schema.GroupResource{}, key.Name)
+		}
+		return &unstructured.Unstructured{}, nil
+	}
+	var creates []*unstructured.Unstructured
+	create := func(_ context.Context, object *unstructured.Unstructured) error {
+		creates = append(creates, object.DeepCopy())
+		return nil
+	}
+
+	input := `
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: completed
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: fails-at-patch
+`
+	results, err := CreateOrUpdateFromHandler(context.Background(), "default", input, get, create, client)
+
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "patch unavailable")
+	assert.Equal(t, []string{"Created ConfigMap (v1) completed in default"}, results)
+	require.Len(t, creates, 1)
+	assert.Equal(t, "completed", creates[0].GetName())
+}
