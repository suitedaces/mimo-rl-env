+	clusterFake "github.com/vmware-tanzu/octant/internal/cluster/fake"
+	"github.com/vmware-tanzu/octant/pkg/store"
+)
+
+type codespecApplyRecorder struct {
+	gets    []store.Key
+	creates []*unstructured.Unstructured
+}
+
+func (r *codespecApplyRecorder) get(_ context.Context, key store.Key) (*unstructured.Unstructured, error) {
+	r.gets = append(r.gets, key)
+	return nil, kerrors.NewNotFound(schema.GroupResource{Group: key.GroupVersionKind().Group}, key.Name)
+}
+
+func (r *codespecApplyRecorder) create(_ context.Context, object *unstructured.Unstructured) error {
+	r.creates = append(r.creates, object.DeepCopy())
+	return nil
+}
+
+func codespecApplyClient(t *testing.T) (*gomock.Controller, *clusterFake.MockClientInterface) {
+	t.Helper()
+	controller := gomock.NewController(t)
+	client := clusterFake.NewMockClientInterface(controller)
+	client.EXPECT().Resource(gomock.Any()).DoAndReturn(
+		func(gk schema.GroupKind) (schema.GroupVersionResource, bool, error) {
+			switch gk.Kind {
+			case "ConfigMap":
+				return schema.GroupVersionResource{Group: gk.Group, Version: "v1", Resource: "configmaps"}, true, nil
+			case "Secret":
+				return schema.GroupVersionResource{Group: gk.Group, Version: "v1", Resource: "secrets"}, true, nil
+			case "Namespace":
+				return schema.GroupVersionResource{Group: gk.Group, Version: "v1", Resource: "namespaces"}, false, nil
+			default:
+				return schema.GroupVersionResource{Group: gk.Group, Version: "v1", Resource: "unknown"}, false, nil
+			}
+		}).AnyTimes()
+	return controller, client
+}
+
+func TestCodespecApplyYAMLPreflightMalformedTailIsSideEffectFree(t *testing.T) {
+	controller, client := codespecApplyClient(t)
+	defer controller.Finish()
+	recorder := &codespecApplyRecorder{}
+
+	input := `
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: first
+---
+apiVersion: v1
+kind: Secret
+metadata:
+  name: broken
+data: [
+`
+	results, err := CreateOrUpdateFromHandler(context.Background(), "default", input, recorder.get, recorder.create, client)
+
+	require.Error(t, err)
+	assert.Empty(t, results)
+	assert.Empty(t, recorder.gets, "preflight errors must occur before object lookup")
+	assert.Empty(t, recorder.creates, "preflight errors must occur before object creation")
+}
+
+func TestCodespecApplyYAMLPreflightRejectsInvalidResourcesAndDuplicates(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+	}{
+		{
+			name: "missing apiVersion",
+			input: `kind: ConfigMap
+metadata:
+  name: missing-version
+`,
+		},
+		{
+			name: "missing kind",
+			input: `apiVersion: v1
+metadata:
+  name: missing-kind
+`,
+		},
+		{
+			name: "missing name",
+			input: `apiVersion: v1
+kind: ConfigMap
+metadata: {}
+`,
+		},
+		{
+			name: "list item is not an object",
+			input: `apiVersion: v1
+kind: List
+items:
+  - not-an-object
+`,
+		},
+		{
+			name: "list has no items array",
+			input: `apiVersion: v1
+kind: List
+metadata:
+  name: invalid-list
+`,
+		},
+		{
+			name: "namespace escapes selected namespace",
+			input: `apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: cross-namespace
+  namespace: other
+`,
+		},
+		{
+			name: "duplicate after list expansion and namespace defaulting",
+			input: `apiVersion: v1
+kind: List
+items:
+  - apiVersion: v1
+    kind: ConfigMap
+    metadata:
+      name: repeated
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: repeated
+  namespace: default
+`,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			controller, client := codespecApplyClient(t)
+			defer controller.Finish()
+			recorder := &codespecApplyRecorder{}
+
+			results, err := CreateOrUpdateFromHandler(context.Background(), "default", tt.input, recorder.get, recorder.create, client)
+
+			require.Error(t, err)
+			assert.Empty(t, results)
+			assert.Empty(t, recorder.gets)
+			assert.Empty(t, recorder.creates)
+		})
+	}
+}
+
+func TestCodespecApplyYAMLExpandsListsInStreamOrder(t *testing.T) {
+	controller, client := codespecApplyClient(t)
+	defer controller.Finish()
+	recorder := &codespecApplyRecorder{}
+
+	input := `
+apiVersion: v1
+kind: List
+items:
+  - apiVersion: v1
+    kind: ConfigMap
+    metadata:
+      name: first
+  - apiVersion: v1
+    kind: List
+    items:
+      - apiVersion: v1
+        kind: Namespace
+        metadata:
+          name: team-a
+      - apiVersion: v1
+        kind: Secret
+        metadata:
+          name: credentials
+          namespace: default
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: last
+`
+	results, err := CreateOrUpdateFromHandler(context.Background(), "default", input, recorder.get, recorder.create, client)
+
+	require.NoError(t, err)
+	assert.Equal(t, []string{
+		"Created ConfigMap (v1) first in default",
+		"Created Namespace (v1) team-a",
+		"Created Secret (v1) credentials in default",
+		"Created ConfigMap (v1) last in default",
+	}, results)
+	require.Len(t, recorder.creates, 4)
+	assert.Equal(t, []string{"first", "team-a", "credentials", "last"}, []string{
+		recorder.creates[0].GetName(),
+		recorder.creates[1].GetName(),
+		recorder.creates[2].GetName(),
+		recorder.creates[3].GetName(),
+	})
+	assert.Equal(t, "default", recorder.creates[0].GetNamespace())
+	assert.Empty(t, recorder.creates[1].GetNamespace(), "cluster-scoped resources must not receive the selected namespace")
+	assert.Equal(t, "default", recorder.creates[2].GetNamespace())
+	assert.Equal(t, "default", recorder.creates[3].GetNamespace())
+}
