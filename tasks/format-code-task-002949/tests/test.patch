+func TestCodespecApplyYAMLCreateFailureKeepsEarlierResults(t *testing.T) {
+	controller, client := codespecApplyClient(t)
+	defer controller.Finish()
+	var creates []*unstructured.Unstructured
+	create := func(_ context.Context, object *unstructured.Unstructured) error {
+		if object.GetName() == "fails-at-create" {
+			return errors.New("create unavailable")
+		}
+		creates = append(creates, object.DeepCopy())
+		return nil
+	}
+	recorder := &codespecApplyRecorder{}
+
+	input := `
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: completed
+---
+apiVersion: v1
+kind: Secret
+metadata:
+  name: fails-at-create
+`
+	results, err := CreateOrUpdateFromHandler(context.Background(), "default", input, recorder.get, create, client)
+
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "create unavailable")
+	assert.Equal(t, []string{"Created ConfigMap (v1) completed in default"}, results)
+	require.Len(t, creates, 1)
+	assert.Equal(t, "completed", creates[0].GetName())
+}
