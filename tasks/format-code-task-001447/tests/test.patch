+func TestTracker_Checks_PendingPostStop_Healthy(t *testing.T) {
+	t.Parallel()
+
+	now := time.Now()
+	alloc := testTrackerLifecycleAlloc(t,
+		[]*structs.Task{
+			testTrackerTask("api", nil),
+			testTrackerTask("cleanup", &structs.TaskLifecycleConfig{
+				Hook: structs.TaskLifecycleHookPoststop,
+			}),
+		},
+		map[string]*structs.TaskState{
+			"api": {
+				State:     structs.TaskStateRunning,
+				StartedAt: now,
+			},
+			"cleanup": {
+				State: structs.TaskStatePending,
+			},
+		},
+	)
+
+	assertTrackerHealthEvent(t, alloc, true)
+}
+
+func TestTracker_Checks_PendingPostStop_Healthy_WithAdditionalTaskNames(t *testing.T) {
+	t.Parallel()
+
+	now := time.Now()
+	alloc := testTrackerLifecycleAlloc(t,
+		[]*structs.Task{
+			testTrackerTask("frontend", nil),
+			testTrackerTask("worker", nil),
+			testTrackerTask("after-main-exit", &structs.TaskLifecycleConfig{
+				Hook: structs.TaskLifecycleHookPoststop,
+			}),
+		},
+		map[string]*structs.TaskState{
+			"frontend": {
+				State:     structs.TaskStateRunning,
+				StartedAt: now,
+			},
+			"worker": {
+				State:     structs.TaskStateRunning,
+				StartedAt: now,
+			},
+			"after-main-exit": {
+				State: structs.TaskStatePending,
+			},
+		},
+	)
+
+	assertTrackerHealthEvent(t, alloc, true)
+}
+
+func TestTracker_Checks_NonPoststopFinished_Unhealthy(t *testing.T) {
+	t.Parallel()
+
+	now := time.Now()
+	alloc := testTrackerLifecycleAlloc(t,
+		[]*structs.Task{
+			testTrackerTask("service", nil),
+			testTrackerTask("setup-once", &structs.TaskLifecycleConfig{
+				Hook: structs.TaskLifecycleHookPrestart,
+			}),
+			testTrackerTask("post-exit-cleaner", &structs.TaskLifecycleConfig{
+				Hook: structs.TaskLifecycleHookPoststop,
+			}),
+		},
+		map[string]*structs.TaskState{
+			"service": {
+				State:     structs.TaskStateRunning,
+				StartedAt: now,
+			},
+			"setup-once": {
+				State:      structs.TaskStateDead,
+				StartedAt:  now.Add(-2 * time.Second),
+				FinishedAt: now.Add(-1 * time.Second),
+			},
+			"post-exit-cleaner": {
+				State: structs.TaskStatePending,
+			},
+		},
+	)
+
+	assertTrackerHealthEvent(t, alloc, false)
+}
