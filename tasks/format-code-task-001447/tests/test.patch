+func testTrackerTask(name string, lifecycle *structs.TaskLifecycleConfig) *structs.Task {
+	return &structs.Task{
+		Name:      name,
+		Lifecycle: lifecycle,
+		LogConfig: structs.DefaultLogConfig(),
+		Resources: &structs.Resources{
+			CPU:      100,
+			MemoryMB: 64,
+		},
+	}
+}
+
+func testTrackerLifecycleAlloc(t *testing.T, tasks []*structs.Task, states map[string]*structs.TaskState) *structs.Allocation {
+	t.Helper()
+
+	migrate := structs.DefaultMigrateStrategy()
+	migrate.MinHealthyTime = time.Millisecond
+	taskGroup := "allochealth"
+
+	job := &structs.Job{
+		ID:        uuid.Generate(),
+		Name:      uuid.Generate(),
+		Namespace: structs.DefaultNamespace,
+		Type:      structs.JobTypeService,
+		TaskGroups: []*structs.TaskGroup{
+			{
+				Name:    taskGroup,
+				Count:   1,
+				Migrate: migrate,
+				Tasks:   tasks,
+			},
+		},
+	}
+	job.Canonicalize()
+
+	return &structs.Allocation{
+		ID:            uuid.Generate(),
+		EvalID:        uuid.Generate(),
+		NodeID:        uuid.Generate(),
+		Namespace:     structs.DefaultNamespace,
+		JobID:         job.ID,
+		Job:           job,
+		TaskGroup:     taskGroup,
+		DesiredStatus: structs.AllocDesiredStatusRun,
+		ClientStatus:  structs.AllocClientStatusRunning,
+		TaskStates:    states,
+	}
+}
+
+func assertTrackerHealthEvent(t *testing.T, alloc *structs.Allocation, want bool) {
+	t.Helper()
+
+	tracker, cleanup, checkInterval := startTrackerForLifecycleTest(t, alloc)
+	defer cleanup()
+
+	select {
+	case <-time.After(4 * checkInterval):
+		require.Fail(t, "timed out while waiting for health")
+	case got := <-tracker.HealthyCh():
+		require.Equal(t, want, got)
+	}
+}
+
+func assertTrackerDoesNotReportHealthy(t *testing.T, alloc *structs.Allocation) {
+	t.Helper()
+
+	tracker, cleanup, checkInterval := startTrackerForLifecycleTest(t, alloc)
+	defer cleanup()
+
+	select {
+	case got := <-tracker.HealthyCh():
+		require.False(t, got, "allocation with a non-poststop pending task must not be reported healthy")
+	case <-time.After(4 * checkInterval):
+
+
+	}
+}
+
+func startTrackerForLifecycleTest(t *testing.T, alloc *structs.Allocation) (*Tracker, func(), time.Duration) {
+	t.Helper()
+
+	logger := testlog.HCLogger(t)
+	b := cstructs.NewAllocBroadcaster(logger)
+	consul := consul.NewMockConsulServiceClient(t, logger)
+	ctx, cancelFn := context.WithCancel(context.Background())
+
+	checkInterval := 10 * time.Millisecond
+	tracker := NewTracker(ctx, logger, alloc, b.Listen(), consul, time.Millisecond, true)
+	tracker.checkLookupInterval = checkInterval
+	tracker.Start()
+
+	cleanup := func() {
+		cancelFn()
+		b.Close()
+	}
+	return tracker, cleanup, checkInterval
+}
