+    go test -v -run 'TestTracker_Checks_(Healthy|Unhealthy)$' ./client/allochealth/
+    ;;
+  new)
+    go test -v -run 'TestTracker_Checks_(PendingPostStop_Healthy|PendingPostStop_Healthy_WithAdditionalTaskNames|NonPoststopFinished_Unhealthy|NonPoststopPending_DoesNotReportHealthy)$' ./client/allochealth/
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
