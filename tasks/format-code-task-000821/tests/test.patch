+class TestCsvWriterMultiLabelOrdering(unittest.TestCase):
+
+    def test_create_line_sorts_multilabels(self):
+
+
+        writer = CsvWriter('.')
+        record_a = Record(id=0, data='example 1', label=['label1', 'label2', 'label3'],
+                          user='annotator1', metadata={})
+        record_b = Record(id=0, data='example 1', label=['label2', 'label3', 'label1'],
+                          user='annotator2', metadata={})
+        line_a = writer.create_line(record_a)
+        line_b = writer.create_line(record_b)
+        self.assertEqual(line_a['label'], 'label1#label2#label3')
+        self.assertEqual(line_b['label'], 'label1#label2#label3')
+        self.assertEqual(line_a['label'], line_b['label'])
+
+    def test_create_line_sorts_unsorted_input(self):
+        writer = CsvWriter('.')
+        record = Record(id=0, data='ex', label=['c', 'a', 'b'], user='u', metadata={})
+        line = writer.create_line(record)
+        self.assertEqual(line['label'], 'a#b#c')
+
+    def test_create_line_single_label_unchanged(self):
+        writer = CsvWriter('.')
+        record = Record(id=0, data='ex', label=['only'], user='u', metadata={})
+        line = writer.create_line(record)
+        self.assertEqual(line['label'], 'only')
+
+    def test_create_line_empty_labels(self):
+        writer = CsvWriter('.')
+        record = Record(id=0, data='ex', label=[], user='u', metadata={})
+        line = writer.create_line(record)
+        self.assertEqual(line['label'], '')
+
+
+class TestFastTextWriterMultiLabelOrdering(unittest.TestCase):
+
+    def test_create_line_sorts_multilabels(self):
+        writer = FastTextWriter('.')
+        record_a = Record(id=0, data='example 1', label=['label1', 'label2', 'label3'],
+                          user='annotator1', metadata={})
+        record_b = Record(id=0, data='example 1', label=['label2', 'label3', 'label1'],
+                          user='annotator2', metadata={})
+        self.assertEqual(
+            writer.create_line(record_a),
+            '__label__label1 __label__label2 __label__label3 example 1'
+        )
+        self.assertEqual(
+            writer.create_line(record_b),
+            '__label__label1 __label__label2 __label__label3 example 1'
+        )
+
+    def test_create_line_unsorted_input_produces_sorted_output(self):
+        writer = FastTextWriter('.')
+        record = Record(id=0, data='mydata', label=['c', 'a', 'b'], user='u', metadata={})
+        self.assertEqual(
+            writer.create_line(record),
+            '__label__a __label__b __label__c mydata'
+        )
+
+    def test_create_line_data_appears_after_labels(self):
+        writer = FastTextWriter('.')
+        record = Record(id=0, data='zdata', label=['b', 'a'], user='u', metadata={})
+
+
+        line = writer.create_line(record)
+        self.assertTrue(line.endswith(' zdata'))
+        self.assertEqual(line, '__label__a __label__b zdata')
