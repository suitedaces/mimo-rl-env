@@ -0,0 +1,32 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+export PATH="/usr/local/openresty/bin:/usr/local/openresty/luajit/bin:/usr/local/bin:$PATH"
+
+run_new_tests() {
+  bin/busted spec/01-unit/01-db/01-schema/06-routes_spec.lua \
+    --filter="RFC 3986 reserved" &&
+  bin/busted spec/01-unit/01-db/01-schema/06-routes_spec.lua \
+    --filter="keeps" &&
+  bin/busted spec/01-unit/01-db/01-schema/06-routes_spec.lua \
+    --filter="genuinely" &&
+  bin/busted spec/01-unit/01-db/01-schema/06-routes_spec.lua \
+    --filter="malformed"
+}
+
+case "${1:-}" in
+  base)
+    bin/busted spec/01-unit/01-db/01-schema/06-routes_spec.lua \
+      --filter="validates a valid route"
+    ;;
+  new)
+    run_new_tests
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
