@@ -0,0 +1,25 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+export GOPATH=/root/go
+export GO111MODULE=off
+
+
+mkdir -p /root/go/src/github.com/hashicorp
+ln -sf /testbed /root/go/src/github.com/hashicorp/vault 2>/dev/null
+
+cd /root/go/src/github.com/hashicorp/vault
+
+case "${1:-}" in
+  base)
+    go test -vet=off -v -count=1 ./command/agent/cache/ -run 'Test(APIProxy|Cache_|LeaseCache_(EmptyToken|SendNonCacheableNonTokenLease|HandleCacheClear)|Cache_DeriveNamespaceAndRevocationPath)' -timeout 120s
+    ;;
+  new)
+    go test -vet=off -v -count=1 ./command/agent/cache/ -run 'TestAgentCacheListener(PassesThroughVaultErrorResponses|PreservesErrorsReturnedByAPIProxy|KeepsFallbackForProxyErrorsWithoutHTTPResponse|KeepsFallbackForProxyErrorsWithNonErrorResponse)|TestLeaseCacheDoesNotCacheNonSuccessOrNonJSONResponses' -timeout 120s
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
