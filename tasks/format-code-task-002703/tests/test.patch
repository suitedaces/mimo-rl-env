diff --git a/usercase-test-coderl/stringer_error_methods_test.go b/usercase-test-coderl/stringer_error_methods_test.go
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/stringer_error_methods_test.go
@@ -0,0 +1,279 @@
+package usercase_test_coderl
+
+import (
+	"bytes"
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	spew "github.com/spewerspew/spew"
+)
+
+
+
+
+type ID string
+
+func (v ID) String() string { return "id=" + string(v) }
+
+type Code int
+
+func (c Code) Error() string { return fmt.Sprintf("code %d", c) }
+
+type PointerOnly struct {
+	S string
+}
+
+func (p *PointerOnly) String() string { return "ptr=" + p.S }
+
+type Box struct {
+	N int
+}
+
+func (b Box) String() string { return fmt.Sprintf("box:%d", b.N) }
+
+type Bad int
+
+func (b Bad) String() string { panic("boom") }
+
+type Key struct {
+	Name string
+}
+
+func (k Key) String() string { return k.Name }
+
+type ByteName uint8
+
+func (b ByteName) String() string { return fmt.Sprintf("B%02d", b) }
+
+func TestTopLevelStringerAndErrorRendering(t *testing.T) {
+
+
+	if got := spew.Sprintf("%v", ID("a7")); got != "id=a7" {
+		t.Fatalf("Sprintf %%v ID = %q", got)
+	}
+	if got := spew.Sprintf("%#v", ID("a7")); got != "(usercase_test_coderl.ID)id=a7" {
+		t.Fatalf("Sprintf %%#v ID = %q", got)
+	}
+	if got := spew.Sdump(ID("a7")); got != "(usercase_test_coderl.ID) (len=2) id=a7\n" {
+		t.Fatalf("Sdump ID = %q", got)
+	}
+	if got := spew.Sprintf("%v", Code(5)); got != "code 5" {
+		t.Fatalf("Sprintf Code = %q", got)
+	}
+	if got := spew.Sdump(Code(5)); got != "(usercase_test_coderl.Code) code 5\n" {
+		t.Fatalf("Sdump Code = %q", got)
+	}
+}
+
+func TestDirectFormatterAndConvenienceWrappersRenderMethodText(t *testing.T) {
+
+
+	if got := fmt.Sprintf("%v", spew.NewFormatter(ID("a7"))); got != "id=a7" {
+		t.Fatalf("NewFormatter ID = %q", got)
+	}
+	if got := fmt.Sprintf("%#v", (&spew.ConfigState{}).NewFormatter(ID("a7"))); got != "(usercase_test_coderl.ID)id=a7" {
+		t.Fatalf("ConfigState.NewFormatter ID = %q", got)
+	}
+	if got := spew.Sprint(ID("a7")); got != "id=a7" {
+		t.Fatalf("Sprint ID = %q", got)
+	}
+	if got := spew.Sprintln(ID("a7")); got != "id=a7\n" {
+		t.Fatalf("Sprintln ID = %q", got)
+	}
+	if got := (&spew.ConfigState{}).Sprint(ID("a7")); got != "id=a7" {
+		t.Fatalf("ConfigState.Sprint ID = %q", got)
+	}
+	if got := (&spew.ConfigState{}).Sprintln(ID("a7")); got != "id=a7\n" {
+		t.Fatalf("ConfigState.Sprintln ID = %q", got)
+	}
+	if got := spew.Errorf("wrapped %v", ID("a7")).Error(); got != "wrapped id=a7" {
+		t.Fatalf("Errorf ID = %q", got)
+	}
+
+	var buf bytes.Buffer
+	n, err := spew.Fprint(&buf, ID("a7"))
+	if n != 5 || err != nil || buf.String() != "id=a7" {
+		t.Fatalf("Fprint ID = n:%d err:%v text:%q", n, err, buf.String())
+	}
+	buf.Reset()
+	n, err = spew.Fprintf(&buf, "got %v", Code(5))
+	if n != 10 || err != nil || buf.String() != "got code 5" {
+		t.Fatalf("Fprintf Code = n:%d err:%v text:%q", n, err, buf.String())
+	}
+	buf.Reset()
+	cfg := &spew.ConfigState{}
+	n, err = cfg.Fprint(&buf, ID("a7"))
+	if n != 5 || err != nil || buf.String() != "id=a7" {
+		t.Fatalf("ConfigState.Fprint ID = n:%d err:%v text:%q", n, err, buf.String())
+	}
+	buf.Reset()
+	n, err = cfg.Fprintf(&buf, "got %v", Code(5))
+	if n != 10 || err != nil || buf.String() != "got code 5" {
+		t.Fatalf("ConfigState.Fprintf Code = n:%d err:%v text:%q", n, err, buf.String())
+	}
+	buf.Reset()
+	spew.Fdump(&buf, ID("a7"))
+	if got := buf.String(); got != "(usercase_test_coderl.ID) (len=2) id=a7\n" {
+		t.Fatalf("Fdump ID = %q", got)
+	}
+	buf.Reset()
+	cfg.Fdump(&buf, Code(5))
+	if got := buf.String(); got != "(usercase_test_coderl.Code) code 5\n" {
+		t.Fatalf("ConfigState.Fdump Code = %q", got)
+	}
+}
+
+func TestConfigDisablesMethodInvocation(t *testing.T) {
+
+
+	cfg := &spew.ConfigState{DisableMethods: true}
+	if got := cfg.Sprintf("%v", ID("a7")); got != "a7" {
+		t.Fatalf("DisableMethods Sprintf ID = %q", got)
+	}
+}
+
+func TestPointerReceiverMethodsCanBeEnabledAndDisabled(t *testing.T) {
+
+
+	if spew.UnsafeDisabled {
+		t.Fatal("unsafe reflection is unavailable in this build")
+	}
+	value := PointerOnly{S: "z"}
+	if got := spew.Sprintf("%v", value); got != "ptr=z" {
+		t.Fatalf("default pointer receiver Sprintf = %q", got)
+	}
+	cfg := &spew.ConfigState{DisablePointerMethods: true}
+
+	if got := cfg.Sprintf("%v", value); strings.Contains(got, "ptr=") || !strings.Contains(got, "z") {
+		t.Fatalf("DisablePointerMethods Sprintf = %q", got)
+	}
+	if !reflect.DeepEqual(value, PointerOnly{S: "z"}) {
+		t.Fatalf("pointer receiver formatting mutated input: %#v", value)
+	}
+}
+
+func TestContinueOnMethodIncludesMethodTextAndStructInternals(t *testing.T) {
+
+
+	cfg := &spew.ConfigState{Indent: " ", ContinueOnMethod: true}
+	if got := cfg.Sdump(Box{N: 2}); got != "(usercase_test_coderl.Box) (box:2) {\n N: (int) 2\n}\n" {
+		t.Fatalf("ContinueOnMethod Sdump Box = %q", got)
+	}
+}
+
+func TestPanickingStringerIsRenderedInline(t *testing.T) {
+
+
+	if got := spew.Sprintf("%v", Bad(9)); got != "(PANIC=boom)9" {
+		t.Fatalf("panicking Stringer Sprintf = %q", got)
+	}
+}
+
+func TestSortKeysUsesMethodTextForMapKeys(t *testing.T) {
+
+
+	cfg := &spew.ConfigState{SortKeys: true}
+	input := map[Key]int{Key{"b"}: 2, Key{"a"}: 1}
+	if got := cfg.Sprintf("%v", input); got != "map[a:1 b:2]" {
+		t.Fatalf("SortKeys map Sprintf = %q", got)
+	}
+}
+
+func TestByteLikeCollectionsUseMethodsInsteadOfHexdumpWhenEnabled(t *testing.T) {
+
+
+
+	if got := spew.Sdump([]ByteName{1, 2, 15}); !dumpUsesByteNameMethods(got) {
+		t.Fatalf("Sdump []ByteName methods enabled = %q", got)
+	}
+
+	if got := spew.Sdump([3]ByteName{1, 2, 15}); !dumpUsesByteNameMethods(got) {
+		t.Fatalf("Sdump [3]ByteName methods enabled = %q", got)
+	}
+}
+
+func TestByteLikeSliceCanFallBackToHexdumpWhenMethodsDisabled(t *testing.T) {
+
+
+	cfg := &spew.ConfigState{Indent: " ", DisableMethods: true}
+
+	if got := cfg.Sdump([]ByteName{1, 2, 15}); dumpContainsByteNameText(got) || !dumpShowsDisabledByteValues(got) {
+		t.Fatalf("Sdump []ByteName DisableMethods = %q", got)
+	}
+}
+
+func TestReferentialTransparencyForSameInput(t *testing.T) {
+	first := spew.Sprintf("%#v", ID("a7"))
+	second := spew.Sprintf("%#v", ID("a7"))
+	if first != "(usercase_test_coderl.ID)id=a7" {
+		t.Fatalf("first call = %q", first)
+	}
+	if second != "(usercase_test_coderl.ID)id=a7" {
+		t.Fatalf("second call = %q", second)
+	}
+}
+
+func TestFormattingDoesNotMutateCallerInputs(t *testing.T) {
+	input := map[Key][]ID{
+		Key{"b"}: {ID("b1"), ID("b2")},
+		Key{"a"}: {ID("a1")},
+	}
+	original := map[Key][]ID{
+		Key{"b"}: append([]ID(nil), input[Key{"b"}]...),
+		Key{"a"}: append([]ID(nil), input[Key{"a"}]...),
+	}
+	cfg := &spew.ConfigState{SortKeys: true}
+
+	if got := cfg.Sprintf("%v", input); !strings.Contains(got, "id=a1") || !strings.Contains(got, "id=b1") || !strings.Contains(got, "id=b2") || strings.Index(got, "a:") < 0 || strings.Index(got, "b:") < 0 || strings.Index(got, "a:") > strings.Index(got, "b:") {
+		t.Fatalf("map formatting = %q", got)
+	}
+	if !reflect.DeepEqual(input, original) {
+		t.Fatalf("formatting mutated input: got %#v want %#v", input, original)
+	}
+}
+
+func TestNoGlobalStateAcrossDifferentInputs(t *testing.T) {
+	first := spew.Sprintf("%v", ID("a7"))
+	if first != "id=a7" {
+		t.Fatalf("first ID call = %q", first)
+	}
+	if got := spew.Sprintf("%v", Code(5)); got != "code 5" {
+		t.Fatalf("noise Code call = %q", got)
+	}
+	if got := (&spew.ConfigState{SortKeys: true}).Sprintf("%v", map[Key]int{Key{"b"}: 2, Key{"a"}: 1}); got != "map[a:1 b:2]" {
+		t.Fatalf("noise map call = %q", got)
+	}
+	second := spew.Sprintf("%v", ID("a7"))
+	if second != "id=a7" {
+		t.Fatalf("second ID call after noise = %q", second)
+	}
+}
+
+func TestCombinedFormattingUsesMethodText(t *testing.T) {
+
+	if got := spew.Sprintf("%v %#v %v", ID("a7"), Box{N: 2}, []ByteName{1, 2, 15}); !strings.Contains(got, "id=a7") || !strings.Contains(got, "box:2") || !strings.Contains(got, "B01") || !strings.Contains(got, "B02") || !strings.Contains(got, "B15") {
+		t.Fatalf("combined method formatting = %q", got)
+	}
+}
+
+func dumpUsesByteNameMethods(got string) bool {
+	return strings.Contains(got, "B01") &&
+		strings.Contains(got, "B02") &&
+		strings.Contains(got, "B15") &&
+		!strings.Contains(got, "00000000")
+}
+
+func dumpContainsByteNameText(got string) bool {
+	return strings.Contains(got, "B01") ||
+		strings.Contains(got, "B02") ||
+		strings.Contains(got, "B15")
+}
+
+func dumpShowsDisabledByteValues(got string) bool {
+	lower := strings.ToLower(got)
+	hexdumpValues := strings.Contains(lower, "01") && strings.Contains(lower, "02") && strings.Contains(lower, "0f")
+	decimalValues := strings.Contains(got, "1") && strings.Contains(got, "2") && strings.Contains(got, "15")
+	return hexdumpValues || decimalValues
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
