+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+if [ ! -x ./node_modules/.bin/mocha ]; then
+  echo "repo-local node_modules is required for offline test execution" >&2
+  exit 1
+fi
+
+exec ./node_modules/.bin/mocha \
+  -r ts-node/register \
+  -r tsconfig-paths/register \
+  /workspace/repo/usercase-test-coderl/nested_calls.test.ts
