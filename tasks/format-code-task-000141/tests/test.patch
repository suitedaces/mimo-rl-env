@@ -760,3 +760,40 @@ def test_tqdm_progress_bar_disabled_when_not_rank_zero(is_global_zero):
     pbar.enable()
     trainer.test(model)
     assert pbar.is_disabled
+
+
+@mock.patch.dict(os.environ, {}, clear=True)
+def test_tqdm_progress_bar_no_tqdm_miniters_env(tmp_path):
+    """Without TQDM_MINITERS, refresh_rate should match the user-supplied value."""
+    pbar = TQDMProgressBar(refresh_rate=1)
+    assert pbar.refresh_rate == 1
+
+    pbar = TQDMProgressBar(refresh_rate=7)
+    assert pbar.refresh_rate == 7
+
+
+@mock.patch.dict(os.environ, {"TQDM_MINITERS": "5"}, clear=True)
+def test_tqdm_progress_bar_tqdm_miniters_default_refresh_rate(tmp_path):
+    """TQDM_MINITERS should take effect when default refresh_rate=1 is used."""
+    pbar = TQDMProgressBar()
+    assert pbar.refresh_rate == 5
+
+    pbar = TQDMProgressBar(refresh_rate=1)
+    assert pbar.refresh_rate == 5
+
+    trainer = Trainer(default_root_dir=tmp_path)
+    assert trainer.progress_bar_callback.refresh_rate == 5
+
+
+@mock.patch.dict(os.environ, {"TQDM_MINITERS": "5"}, clear=True)
+def test_tqdm_progress_bar_tqdm_miniters_lower_than_refresh_rate(tmp_path):
+    """When refresh_rate exceeds TQDM_MINITERS, the higher value wins (max)."""
+    pbar = TQDMProgressBar(refresh_rate=10)
+    assert pbar.refresh_rate == 10
+
+
+@mock.patch.dict(os.environ, {"COLAB_GPU": "1"}, clear=True)
+def test_tqdm_progress_bar_colab_no_miniters(tmp_path):
+    """Preservation: COLAB behavior unchanged when TQDM_MINITERS not set."""
+    pbar = TQDMProgressBar(refresh_rate=1)
+    assert pbar.refresh_rate == 20
