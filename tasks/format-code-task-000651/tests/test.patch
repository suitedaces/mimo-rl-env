+class TestUninitializedVariableToString(unittest.TestCase):
+
+    def test_unnamed_uninitialized_repr(self):
+        a = chainer.Variable()
+        self.assertIsNone(a.data)
+        self.assertEqual(repr(a), 'variable(None)')
+
+    def test_unnamed_uninitialized_str(self):
+        a = chainer.Variable()
+        self.assertIsNone(a.data)
+        self.assertEqual(str(a), 'variable(None)')
+
+    def test_named_uninitialized_repr(self):
+        a = chainer.Variable()
+        a.name = 'x'
+        self.assertIsNone(a.data)
+        self.assertEqual(repr(a), 'variable x(None)')
+
+    def test_named_uninitialized_str(self):
+        a = chainer.Variable()
+        a.name = 'x'
+        self.assertIsNone(a.data)
+        self.assertEqual(str(a), 'variable x(None)')
+
+
 testing.run_module(__name__, __file__)
