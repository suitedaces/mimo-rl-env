 package cmd
 
 import (
+	"bytes"
 	"io/ioutil"
 	"path/filepath"
 	"testing"
 
 	"github.com/spf13/afero"
+	"github.com/stretchr/testify/assert"
 	"github.com/stretchr/testify/require"
 	"go.k6.io/k6/errext/exitcodes"
+	"go.k6.io/k6/lib"
 )
 
 func TestArchiveThresholds(t *testing.T) {
@@ -86,3 +89,68 @@ func TestArchiveThresholds(t *testing.T) {
 		})
 	}
 }
+
+
+const archiveExcludeEnvVarsTestScript = `export default function () {};`
+
+func TestArchiveExcludeEnvVarsFlag(t *testing.T) {
+	t.Parallel()
+
+	testState := newGlobalTestState(t)
+	scriptPath := filepath.Join(testState.cwd, "test.js")
+	require.NoError(t, afero.WriteFile(testState.fs, scriptPath, []byte(archiveExcludeEnvVarsTestScript), 0o644))
+
+	archivePath := filepath.Join(testState.cwd, "myarchive.tar")
+	testState.args = []string{
+		"k6", "archive",
+		"--env", "SECRET=topsecret",
+		"--env", "TOKEN=mytoken",
+		"--exclude-env-vars",
+		"-O", archivePath,
+		"test.js",
+	}
+
+	newRootCommand(testState.globalState).execute()
+
+	archiveData, err := afero.ReadFile(testState.fs, archivePath)
+	require.NoError(t, err)
+
+	arc, err := lib.ReadArchive(bytes.NewReader(archiveData))
+	require.NoError(t, err)
+
+
+	assert.Empty(t, arc.Env)
+
+
+	assert.NotContains(t, string(archiveData), "topsecret")
+	assert.NotContains(t, string(archiveData), "mytoken")
+}
+
+func TestArchiveEnvVarsIncludedByDefault(t *testing.T) {
+	t.Parallel()
+
+	testState := newGlobalTestState(t)
+	scriptPath := filepath.Join(testState.cwd, "test.js")
+	require.NoError(t, afero.WriteFile(testState.fs, scriptPath, []byte(archiveExcludeEnvVarsTestScript), 0o644))
+
+	archivePath := filepath.Join(testState.cwd, "myarchive.tar")
+	testState.args = []string{
+		"k6", "archive",
+		"--env", "FOO=bar",
+		"--env", "BAZ=qux",
+		"-O", archivePath,
+		"test.js",
+	}
+
+	newRootCommand(testState.globalState).execute()
+
+	archiveData, err := afero.ReadFile(testState.fs, archivePath)
+	require.NoError(t, err)
+
+	arc, err := lib.ReadArchive(bytes.NewReader(archiveData))
+	require.NoError(t, err)
+
+
+	assert.Equal(t, "bar", arc.Env["FOO"])
+	assert.Equal(t, "qux", arc.Env["BAZ"])
+}
