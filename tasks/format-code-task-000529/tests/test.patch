diff --git a/arch/univariate/tests/test_mean.py b/arch/univariate/tests/test_mean.py
index dd8555cb92..c0a15483c6 100644
--- a/arch/univariate/tests/test_mean.py
+++ b/arch/univariate/tests/test_mean.py
@@ -821,6 +821,66 @@ class TestMeanModel(TestCase):
         assert_almost_equal(res.params.values, res4.params.values, decimal=4)
         assert am.hold_back == 100
 
+    def test_fix_on_fresh_model_does_not_raise(self):
+
+
+
+        am = arch_model(self.y_series)
+        res = am.fit(disp=DISPLAY)
+
+        am_fresh = arch_model(self.y_series)
+        fixed_res = am_fresh.fix(res.params)
+
+        assert_series_equal(res.params, fixed_res.params)
+        assert_almost_equal(res.loglikelihood, fixed_res.loglikelihood)
+
+    def test_fix_on_fresh_model_matches_fit_then_fix(self):
+
+
+        am_fit = arch_model(self.y_series)
+        res = am_fit.fit(disp=DISPLAY)
+        fixed_after_fit = am_fit.fix(res.params)
+
+        am_fresh = arch_model(self.y_series)
+        fixed_fresh = am_fresh.fix(res.params)
+
+        assert_almost_equal(fixed_after_fit.loglikelihood,
+                            fixed_fresh.loglikelihood)
+        assert_series_equal(fixed_after_fit.params, fixed_fresh.params)
+        assert_almost_equal(
+            np.asarray(fixed_after_fit.conditional_volatility),
+            np.asarray(fixed_fresh.conditional_volatility))
+
+    def test_fix_accepts_first_last_obs_kwargs(self):
+
+
+        am = arch_model(self.y_series)
+        res = am.fit(disp=DISPLAY)
+
+        am_fresh = arch_model(self.y_series)
+
+        fixed_res = am_fresh.fix(res.params, first_obs=100, last_obs=900)
+        assert fixed_res is not None
+
+    def test_fix_first_last_obs_subset_matches_fit_subset(self):
+
+
+
+        am_fit = arch_model(self.y_series)
+        res_subset = am_fit.fit(disp=DISPLAY, first_obs=100, last_obs=900)
+
+        am_fix = arch_model(self.y_series)
+        fixed_subset = am_fix.fix(res_subset.params,
+                                  first_obs=100, last_obs=900)
+        assert_almost_equal(res_subset.loglikelihood,
+                            fixed_subset.loglikelihood)
+
+
+
+        am_full = arch_model(self.y_series)
+        fixed_full = am_full.fix(res_subset.params)
+        assert fixed_subset.loglikelihood != fixed_full.loglikelihood
+
     def test_constant_mean_fixed_variance(self):
