new file mode 100644
index 00000000..51fc5790
--- /dev/null
+++ b/opal/static/js/test/codespec_paginator_contract.test.js
@@ -0,0 +1,131 @@
+describe('Paginator contract', function() {
+  'use strict';
+
+  var Paginator;
+  var callback;
+
+  beforeEach(function() {
+    module('opal.services');
+    inject(function($injector) {
+      Paginator = $injector.get('Paginator');
+    });
+    callback = jasmine.createSpy('callback');
+  });
+
+  it('initializes a complete empty state without metadata', function() {
+    var paginator = new Paginator(callback);
+
+    expect(paginator.pageNumber).toBe(1);
+    expect(paginator.totalCount).toBe(0);
+    expect(paginator.totalPages).toEqual([1]);
+    expect(paginator.hasPrevious).toBe(false);
+    expect(paginator.hasNext).toBe(false);
+  });
+
+  it('coerces numeric metadata and preserves the current page in a seven-page window', function() {
+    var paginator = new Paginator(callback, {
+      page_number: '8',
+      total_count: '141',
+      total_pages: '15'
+    });
+
+    expect(paginator.pageNumber).toBe(8);
+    expect(paginator.totalCount).toBe(141);
+    expect(paginator.totalPages).toEqual([8, 9, 10, 11, 12, 13, 14]);
+    expect(paginator.totalPages.length).toBeLessThan(8);
+    expect(paginator.totalPages).toContain(paginator.pageNumber);
+  });
+
+  it('anchors the page window at the beginning and end of a result set', function() {
+    var first = new Paginator(callback, {page_number: 2, total_count: 101, total_pages: 11});
+    var last = new Paginator(callback, {page_number: 11, total_count: 101, total_pages: 11});
+
+    expect(first.totalPages).toEqual([1, 2, 3, 4, 5, 6, 7]);
+    expect(last.totalPages).toEqual([5, 6, 7, 8, 9, 10, 11]);
+  });
+
+  it('clamps a requested page outside the available range', function() {
+    var below = new Paginator(callback, {page_number: -4, total_count: 20, total_pages: 3});
+    var above = new Paginator(callback, {page_number: 99, total_count: 20, total_pages: 3});
+
+    expect(below.pageNumber).toBe(1);
+    expect(below.totalPages).toEqual([1, 2, 3]);
+    expect(above.pageNumber).toBe(3);
+    expect(above.totalPages).toEqual([1, 2, 3]);
+  });
+
+  it('reports whether an adjacent page exists', function() {
+    var first = new Paginator(callback, {page_number: 1, total_count: 100, total_pages: 4});
+    var middle = new Paginator(callback, {page_number: 2, total_count: 100, total_pages: 4});
+    var windowed = new Paginator(callback, {page_number: 2, total_count: 101, total_pages: 11});
+    var last = new Paginator(callback, {page_number: 4, total_count: 100, total_pages: 4});
+    var endWindow = new Paginator(callback, {page_number: 11, total_count: 101, total_pages: 15});
+
+    expect(first.hasPrevious).toBe(false);
+    expect(first.hasNext).toBe(true);
+    expect(middle.hasPrevious).toBe(true);
+    expect(middle.hasNext).toBe(true);
+    expect(windowed.hasNext).toBe(true);
+    expect(last.hasPrevious).toBe(true);
+    expect(last.hasNext).toBe(false);
+    expect(endWindow.hasPrevious).toBe(true);
+    expect(endWindow.hasNext).toBe(true);
+  });
+
+  it('does not invoke navigation callbacks beyond either boundary', function() {
+    var first = new Paginator(callback, {page_number: 1, total_count: 20, total_pages: 2});
+    first.goPrevious();
+    expect(callback).not.toHaveBeenCalled();
+
+    var last = new Paginator(callback, {page_number: 2, total_count: 20, total_pages: 2});
+    last.goNext();
+    expect(callback).not.toHaveBeenCalled();
+  });
+
+  it('invokes navigation callbacks with the adjacent valid page', function() {
+    var previous = new Paginator(callback, {page_number: 2, total_count: 40, total_pages: 4});
+    var next = new Paginator(callback, {page_number: 2, total_count: 40, total_pages: 4});
+
+    previous.goPrevious();
+    next.goNext();
+
+    expect(callback.calls.count()).toBe(2);
+    expect(callback.calls.argsFor(0)).toEqual([1]);
+    expect(callback.calls.argsFor(1)).toEqual([3]);
+  });
+
+  it('degrades invalid or zero-page metadata to an inert empty state', function() {
+    var invalid = new Paginator(callback, {
+      page_number: 'not-a-number',
+      total_count: '-5',
+      total_pages: '0'
+    });
+    var nonFinite = new Paginator(callback, {
+      page_number: 1,
+      total_count: Infinity,
+      total_pages: 2
+    });
+
+    expect(invalid.pageNumber).toBe(1);
+    expect(invalid.totalCount).toBe(0);
+    expect(invalid.totalPages).toEqual([]);
+    expect(invalid.hasPrevious).toBe(false);
+    expect(invalid.hasNext).toBe(false);
+    expect(nonFinite.totalCount).toBe(0);
+    invalid.goPrevious();
+    invalid.goNext();
+    expect(callback).not.toHaveBeenCalled();
+  });
+
+  it('normalizes fractional metadata down to usable page integers', function() {
+    var paginator = new Paginator(callback, {
+      page_number: 2.9,
+      total_count: 12.8,
+      total_pages: 3.2
+    });
+
+    expect(paginator.pageNumber).toBe(2);
+    expect(paginator.totalCount).toBe(12);
+    expect(paginator.totalPages).toEqual([1, 2, 3]);
+  });
+});
