+  var defaults = karmaDefaults([
+    'test/codespec_paginator_contract.test.js'
+  ], root, []);
+
+  defaults.basePath = root + '/opal/static/js';
+  defaults.files.splice(defaults.files.length - 1, 0,
+    '../../core/search/static/js/search/services/paginator.js');
+  defaults.plugins = ['karma-jasmine', 'karma-jsdom-launcher'];
+  defaults.browsers = ['jsdom'];
+  defaults.reporters = ['progress'];
+  defaults.preprocessors = {};
+  delete defaults.coverageReporter;
+  config.set(defaults);
+};
