diff --git a/sunpy/util/tests/test_sysinfo_dependency_contract.py b/sunpy/util/tests/test_sysinfo_dependency_contract.py
new file mode 100644
index 000000000..a22e519c6
--- /dev/null
+++ b/sunpy/util/tests/test_sysinfo_dependency_contract.py
@@ -0,0 +1,146 @@
+from importlib.metadata import PackageNotFoundError
+
+import sunpy.util.sysinfo as sysinfo
+from sunpy.util.sysinfo import find_dependencies, get_requirements, missing_dependencies_by_extra
+
+
+def test_get_requirements_evaluates_pep508_markers(monkeypatch):
+    metadata = [
+        "base-lib>=1",
+        "map-lib>=2; extra == 'map' and python_version >= '3.0'",
+        "shared-lib; extra == 'map' or extra == 'net'",
+        "old-lib; extra == 'map' and python_version < '3.0'",
+        "env-lib; python_version >= '3.0'",
+        "future-lib; python_version < '3.0'",
+    ]
+    monkeypatch.setattr(sysinfo, "requires", lambda package: metadata)
+
+    groups = get_requirements("demo")
+
+    assert set(groups["required"]) == {"base-lib", "env-lib"}
+    assert set(groups["map"]) == {"map-lib", "shared-lib"}
+    assert set(groups["net"]) == {"shared-lib"}
+    assert all("old-lib" not in group for group in groups.values())
+    assert all("future-lib" not in group for group in groups.values())
+
+
+def test_find_dependencies_distinguishes_default_empty_and_selected_extras(monkeypatch):
+    metadata = [
+        "demo; extra == 'bundle'",
+        "required-lib",
+        "optional-lib; extra == 'feature'",
+    ]
+    monkeypatch.setattr(sysinfo, "requires", lambda package: metadata)
+
+    installed = {"required-lib": "1.2", "optional-lib": "3.4"}
+
+    def fake_version(package):
+        if package not in installed:
+            raise PackageNotFoundError(package)
+        return installed[package]
+
+    monkeypatch.setattr(sysinfo, "version", fake_version)
+
+    missing_default, installed_default = find_dependencies("demo")
+    missing_empty, installed_empty = find_dependencies("demo", extras=[])
+    missing_selected, installed_selected = find_dependencies("demo", extras=["bundle", "feature"])
+    missing_unknown, installed_unknown = find_dependencies("demo", extras=["unknown"])
+
+    assert missing_default == {}
+    assert installed_default == {"required-lib": "1.2"}
+    assert missing_empty == {}
+    assert installed_empty == {}
+    assert missing_selected == {}
+    assert installed_selected == {"optional-lib": "3.4"}
+    assert missing_unknown == {}
+    assert installed_unknown == {}
+
+
+def test_find_dependencies_merges_constraints_for_duplicate_packages(monkeypatch):
+    metadata = [
+        "shared-lib>=1; extra == 'image'",
+        "shared-lib<3; extra == 'map'",
+    ]
+    monkeypatch.setattr(sysinfo, "requires", lambda package: metadata)
+
+    def missing_version(package):
+        raise PackageNotFoundError(package)
+
+    monkeypatch.setattr(sysinfo, "version", missing_version)
+
+    missing, installed = find_dependencies("demo", extras=["image", "map"])
+
+    assert installed == {}
+    assert set(missing) == {"shared-lib"}
+    assert ">=1" in missing["shared-lib"]
+    assert "<3" in missing["shared-lib"]
+
+
+def test_missing_dependencies_by_extra_reports_concrete_groups(monkeypatch):
+    metadata = [
+        "required-lib",
+        "demo; extra == 'core'",
+        "alpha-lib; extra == 'alpha'",
+        "demo; extra == 'all'",
+        "beta-lib; extra == 'beta'",
+    ]
+    monkeypatch.setattr(sysinfo, "requires", lambda package: metadata)
+    monkeypatch.setattr(sysinfo, "version", lambda package: (_ for _ in ()).throw(PackageNotFoundError(package)))
+
+    missing = missing_dependencies_by_extra("demo")
+    excluded = missing_dependencies_by_extra("demo", exclude_extras=["alpha"])
+
+    assert set(missing) == {"required", "core", "alpha", "all", "beta"}
+    assert set(missing["required"]) == {"required-lib"}
+    assert set(missing["alpha"]) == {"alpha-lib"}
+    assert set(missing["beta"]) == {"beta-lib"}
+    assert missing["core"] == {}
+    assert missing["all"] == {}
+    assert "alpha" not in excluded
+
+
+def test_system_info_lists_sorted_concrete_optional_dependencies(monkeypatch, capsys):
+    metadata = [
+        "core-lib",
+        "sunpy; extra == 'core'",
+        "sunpy; extra == 'all'",
+        "zeta-lib>=4; extra == 'beta'",
+        "alpha-lib; extra == 'alpha'",
+        "shared-lib; extra == 'alpha'",
+        "shared-lib; extra == 'beta'",
+    ]
+    installed = {
+        "sunpy": "9.9",
+        "core-lib": "1.0",
+        "alpha-lib": "2.0",
+        "shared-lib": "3.0",
+    }
+    monkeypatch.setattr(sysinfo, "requires", lambda package: metadata)
+
+    def fake_version(package):
+        if package not in installed:
+            raise PackageNotFoundError(package)
+        return installed[package]
+
+    monkeypatch.setattr(sysinfo, "version", fake_version)
+    monkeypatch.setattr(sysinfo, "distribution", lambda package: type("Dist", (), {"_path": "/fake/sunpy"})())
+    monkeypatch.setattr(sysinfo.platform, "system", lambda: "Other")
+    monkeypatch.setattr(sysinfo.platform, "architecture", lambda: ("64bit", ""))
+    monkeypatch.setattr(sysinfo.platform, "processor", lambda: "test-cpu")
+    monkeypatch.setattr(sysinfo.platform, "python_version", lambda: "3.12.0")
+
+    sysinfo.system_info()
+    output = capsys.readouterr().out
+    optional = output.split("Optional Dependencies\n#####################\n", 1)[1]
+    optional_lines = [line for line in optional.splitlines() if line]
+
+    assert "Required Dependencies\n#####################" in output
+    assert "core-lib: 1.0" in output
+    assert "sunpy: 9.9" in output.split("Optional Dependencies", 1)[0]
+    assert optional_lines == [
+        "alpha-lib: 2.0",
+        "shared-lib: 3.0",
+        "zeta-lib: Missing zeta-lib>=4; extra == \"beta\"",
+    ]
+    assert "sunpy:" not in optional
+    assert "core-lib:" not in optional
