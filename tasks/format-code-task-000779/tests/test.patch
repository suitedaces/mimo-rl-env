+func TestValidateInstanceClassesEtcdDiskDoesNotCreateFilesystemSideEffects(t *testing.T) {
+	root := t.TempDir()
+	cwd := filepath.Join(root, "cwd")
+	home := filepath.Join(root, "home")
+	tmp := filepath.Join(root, "tmp")
+	cache := filepath.Join(root, "cache")
+	for _, dir := range []string{cwd, home, tmp, cache} {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			t.Fatalf("MkdirAll(%q) error = %v", dir, err)
+		}
+	}
+
+	originalWD, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd() error = %v", err)
+	}
+	t.Cleanup(func() {
+		if err := os.Chdir(originalWD); err != nil {
+			t.Fatalf("restore cwd: %v", err)
+		}
+	})
+	if err := os.Chdir(cwd); err != nil {
+		t.Fatalf("Chdir(%q) error = %v", cwd, err)
+	}
+	t.Setenv("HOME", home)
+	t.Setenv("TMPDIR", tmp)
+	t.Setenv("XDG_CACHE_HOME", cache)
+
+	before := treeSnapshot(t, root)
+	_ = cpval.ValidateInstanceClassesEtcdDisk(&cpval.State{
+		InstanceClassKind: "DVPInstanceClass",
+		NodeGroups:        []cpapi.NodeGroup{nodeGroupRef("master", "DVPInstanceClass", "master-ok")},
+		InstanceClasses:   []cpapi.InstanceClass{instanceClass("DVPInstanceClass", "master-ok", map[string]any{"size": "20Gi"})},
+	})
+	after := treeSnapshot(t, root)
+
+	if !reflect.DeepEqual(after, before) {
+		t.Fatalf("ValidateInstanceClassesEtcdDisk changed filesystem state:\nafter:  %#v\nbefore: %#v", after, before)
+	}
+}
+
+func snapshot(result cpval.Result) resultSnapshot {
+	errors := make([]violationSnapshot, 0, len(result.Errors()))
+	for _, violation := range result.Errors() {
+		errors = append(errors, violationSnapshot{
+			Path:  violation.Path,
+			Code:  violation.Code,
+			Value: violation.Value,
+		})
+	}
+	sort.Slice(errors, func(i, j int) bool {
+		if errors[i].Path == errors[j].Path {
+			return errors[i].Code < errors[j].Code
+		}
+		return errors[i].Path < errors[j].Path
+	})
+	if errors == nil {
+		errors = []violationSnapshot{}
+	}
+
+	return resultSnapshot{
+		HasErrors: result.HasErrors(),
+		Errors:    errors,
+	}
+}
+
+func assertSnapshot(t *testing.T, actual, expected resultSnapshot) {
+	t.Helper()
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("result snapshot mismatch:\nactual: %#v\nwant:   %#v", actual, expected)
+	}
+}
+
+func assertBlockingCode(t *testing.T, result cpval.Result, code string) {
+	t.Helper()
+	if !result.HasErrors() {
+		t.Fatalf("expected blocking result with code %q, got no errors", code)
+	}
+	for _, violation := range result.Errors() {
+		if violation.Code == code {
+			return
+		}
+	}
+	t.Fatalf("expected blocking result with code %q, got %#v", code, result.Errors())
+}
+
+func assertSingleError(t *testing.T, result cpval.Result, path, code string, value any) {
+	t.Helper()
+	expected := resultSnapshot{
+		HasErrors: true,
+		Errors: []violationSnapshot{{
+			Path:  path,
+			Code:  code,
+			Value: value,
+		}},
+	}
+	assertSnapshot(t, snapshot(result), expected)
+}
+
+func assertNoErrors(t *testing.T, result cpval.Result) {
+	t.Helper()
+	if result.HasErrors() || len(result.Errors()) != 0 {
+		t.Fatalf("expected no validation errors, got %#v", result.Errors())
+	}
+}
+
+func nodeGroupRef(name, kind, className string) cpapi.NodeGroup {
+	return cpapi.NodeGroup{
+		ObjectMeta: cpapi.ObjectMeta{Name: name},
+		Spec: cpapi.NodeGroupSpec{
+			CloudInstances: &cpapi.CloudInstances{
+				ClassReference: &cpapi.ClassReference{
+					Kind: kind,
+					Name: className,
+				},
+			},
+		},
+	}
+}
+
+func instanceClass(kind, name string, etcdDisk map[string]any) cpapi.InstanceClass {
+	return cpapi.InstanceClass{
+		TypeMeta:   cpapi.TypeMeta{Kind: kind},
+		ObjectMeta: cpapi.ObjectMeta{Name: name},
+		Spec: cpapi.InstanceClassSpec{
+			EtcdDisk: copyMap(etcdDisk),
+		},
+	}
+}
+
+func cloneState(state *cpval.State) *cpval.State {
+	if state == nil {
+		return nil
+	}
+	clone := *state
+	clone.NodeGroups = append([]cpapi.NodeGroup(nil), state.NodeGroups...)
+	for i := range clone.NodeGroups {
+		if state.NodeGroups[i].Spec.CloudInstances != nil {
+			cloudInstances := *state.NodeGroups[i].Spec.CloudInstances
+			clone.NodeGroups[i].Spec.CloudInstances = &cloudInstances
+			if state.NodeGroups[i].Spec.CloudInstances.ClassReference != nil {
+				classRef := *state.NodeGroups[i].Spec.CloudInstances.ClassReference
+				clone.NodeGroups[i].Spec.CloudInstances.ClassReference = &classRef
+			}
+		}
+	}
+	clone.InstanceClasses = append([]cpapi.InstanceClass(nil), state.InstanceClasses...)
+	for i := range clone.InstanceClasses {
+		clone.InstanceClasses[i].Spec.EtcdDisk = copyMap(state.InstanceClasses[i].Spec.EtcdDisk)
+		clone.InstanceClasses[i].Status.NodeGroupConsumers = copySlice(state.InstanceClasses[i].Status.NodeGroupConsumers)
+	}
+	clone.CredentialSecrets = append([]cpapi.CredentialSecret(nil), state.CredentialSecrets...)
+	clone.LegacyProviderClusterConfig = copyMap(state.LegacyProviderClusterConfig)
+	return &clone
+}
+
+func copyMap(in map[string]any) map[string]any {
+	if in == nil {
+		return nil
+	}
+	out := make(map[string]any, len(in))
+	for key, value := range in {
+		switch typed := value.(type) {
+		case map[string]any:
+			out[key] = copyMap(typed)
+		case []any:
+			out[key] = copySlice(typed)
+		default:
+			out[key] = value
+		}
+	}
+	return out
+}
+
+func copySlice(in []any) []any {
+	if in == nil {
+		return nil
+	}
+	out := make([]any, len(in))
+	for i, value := range in {
+		switch typed := value.(type) {
+		case map[string]any:
+			out[i] = copyMap(typed)
+		case []any:
+			out[i] = copySlice(typed)
+		default:
+			out[i] = value
+		}
+	}
+	return out
+}
+
+func treeSnapshot(t *testing.T, root string) []string {
+	t.Helper()
+	var entries []string
+	if err := filepath.WalkDir(root, func(path string, entry os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return err
+		}
+		entries = append(entries, rel+"|"+info.Mode().String())
+		return nil
+	}); err != nil {
+		t.Fatalf("WalkDir(%q) error = %v", root, err)
+	}
+	sort.Strings(entries)
+	return entries
+}
