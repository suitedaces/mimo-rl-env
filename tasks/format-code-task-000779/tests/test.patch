+func TestValidateInstanceClassesEtcdDiskIsReferentiallyTransparentForEquivalentInput(t *testing.T) {
+	state := &cpval.State{
+		InstanceClassKind: "DVPInstanceClass",
+		NodeGroups: []cpapi.NodeGroup{
+			nodeGroupRef("worker", "DVPInstanceClass", "worker-dvp"),
+		},
+		InstanceClasses: []cpapi.InstanceClass{
+			instanceClass("DVPInstanceClass", "worker-dvp", map[string]any{"size": "50Gi", "type": "fast"}),
+		},
+	}
+
+	first := snapshot(cpval.ValidateInstanceClassesEtcdDisk(state))
+	second := snapshot(cpval.ValidateInstanceClassesEtcdDisk(cloneState(state)))
+	expected := resultSnapshot{
+		HasErrors: true,
+		Errors: []violationSnapshot{{
+			Path:  "DVPInstanceClass/worker-dvp.spec.etcdDisk",
+			Code:  "etcd_disk_forbidden_for_non_master",
+			Value: map[string]any{"size": "50Gi", "type": "fast"},
+		}},
+	}
+
+
+	assertSnapshot(t, first, expected)
+	assertSnapshot(t, second, expected)
+	assertSnapshot(t, first, second)
+}
