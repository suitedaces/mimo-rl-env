diff --git a/test/address-links.js b/test/address-links.js
new file mode 100644
index 00000000..1d472f6d
--- /dev/null
+++ b/test/address-links.js
@@ -0,0 +1,94 @@
+const { expect } = require("chai")
+const DB = require("../sdk/offchain")
+const Arweave = require("arweave")
+const EthWallet = require("ethereumjs-wallet").default
+
+const lower = arr => arr.map(s => s.toLowerCase())
+const sorted = arr => lower(arr).slice().sort()
+
+describe("Address Links (reverse lookup)", function () {
+  let wallet, wallet2, db, arweave, arweave_wallet, walletAddress
+
+  this.timeout(0)
+
+  before(async () => {
+    wallet = EthWallet.generate()
+    wallet2 = EthWallet.generate()
+    arweave = Arweave.init()
+    arweave_wallet = await arweave.wallets.generate()
+    walletAddress = await arweave.wallets.jwkToAddress(arweave_wallet)
+  })
+
+  beforeEach(async () => {
+    db = new DB({
+      state: { secure: false, owner: walletAddress },
+      type: 3,
+      caller: walletAddress,
+    })
+    db.setDefaultWallet(wallet)
+  })
+
+  it("should return an empty array for an account with no links", async () => {
+    const res = await db.getAddressLinks(wallet.getAddressString())
+    expect(res).to.eql([])
+  })
+
+  it("should list every disposable address linked to an account", async () => {
+    const account = wallet.getAddressString()
+    const { identity: a } = await db.createTempAddress(wallet)
+    const { identity: b } = await db.createTempAddress(wallet)
+    const links = await db.getAddressLinks(account)
+    expect(sorted(links)).to.eql(sorted([a.address, b.address]))
+  })
+
+  it("should not contain duplicate entries", async () => {
+    const account = wallet.getAddressString()
+    await db.createTempAddress(wallet)
+    await db.createTempAddress(wallet)
+    const links = await db.getAddressLinks(account)
+    expect(lower(links).length).to.eql([...new Set(lower(links))].length)
+  })
+
+  it("should drop a disposable address once its link is removed", async () => {
+    const account = wallet.getAddressString()
+    const { identity: a } = await db.createTempAddress(wallet)
+    const { identity: b } = await db.createTempAddress(wallet)
+    await db.removeAddressLink({ address: a.address }, { wallet })
+    const links = await db.getAddressLinks(account)
+    expect(sorted(links)).to.eql(sorted([b.address]))
+    expect(lower(links)).to.not.include(a.address.toLowerCase())
+  })
+
+  it("should become empty again after all links are removed", async () => {
+    const account = wallet.getAddressString()
+    const { identity: a } = await db.createTempAddress(wallet)
+    await db.removeAddressLink({ address: a.address }, { wallet })
+    const links = await db.getAddressLinks(account)
+    expect(links).to.eql([])
+  })
+
+  it("should keep links for different accounts separate", async () => {
+    const account1 = wallet.getAddressString()
+    const account2 = wallet2.getAddressString()
+    const { identity: a } = await db.createTempAddress(wallet)
+    const { identity: b } = await db.createTempAddress(wallet)
+    const { identity: c } = await db.createTempAddress(wallet2)
+    expect(sorted(await db.getAddressLinks(account1))).to.eql(
+      sorted([a.address, b.address])
+    )
+    expect(sorted(await db.getAddressLinks(account2))).to.eql(
+      sorted([c.address])
+    )
+  })
+
+  it("should stay consistent with the forward getAddressLink lookup", async () => {
+    const account = wallet.getAddressString()
+    const { identity: a } = await db.createTempAddress(wallet)
+    const links = await db.getAddressLinks(account)
+    for (const addr of links) {
+      const fwd = await db.getAddressLink(addr)
+      expect(fwd.address.toLowerCase()).to.eql(account.toLowerCase())
+    }
+    expect(lower(links)).to.include(a.address.toLowerCase())
+  })
+})
