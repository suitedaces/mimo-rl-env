diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,33 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+export PATH="/opt/node-20/bin:$PATH"
+yarn install --frozen-lockfile --ignore-engines --ignore-scripts 2>&1
+
+
+node ./scripts/flow/createFlowConfigs.js 2>&1
+
+
+JEST_FILES=(
+  packages/react-native-renderer/src/__tests__/ReactFabric-test.internal.js
+  packages/react-native-renderer/src/__tests__/ReactFabricAndNative-test.internal.js
+  packages/react-native-renderer/src/__tests__/ReactNativeMount-test.internal.js
+)
+
+case "${1:-}" in
+  base)
+    NODE_ENV=development npx jest --config ./scripts/jest/config.source.js "${JEST_FILES[@]}" \
+      --testNamePattern='^(?!.*(should be able to setNativeProps on native refs|should not call UIManager\.updateView from top-level setNativeProps for empty updates|should warn and no-op if calling setNativeProps on non native refs|sets native props with setNativeProps on Fabric nodes with the RN renderer))'
+    ;;
+  new)
+    NODE_ENV=development npx jest --config ./scripts/jest/config.source.js "${JEST_FILES[@]}" \
+      --testNamePattern='(should be able to setNativeProps on native refs|should not call UIManager\.updateView from top-level setNativeProps for empty updates|should warn and no-op if calling setNativeProps on non native refs|sets native props with setNativeProps on Fabric nodes with the RN renderer)'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
