+async function gh13345_lean_updateOne() {
+  interface IDBUser {
+    name: string;
+    email: string;
+  }
+  const UserModel = model<IDBUser>('GH13345UpdateOne', new Schema<IDBUser>({ name: String, email: String }));
+
+  const res = await UserModel.updateOne({}, { name: 'foo' }).lean();
+  expectType<UpdateWriteOpResult>(res);
+
+  const resMany = await UserModel.updateMany({}, { name: 'foo' }).lean();
+  expectType<UpdateWriteOpResult>(resMany);
+}
+
+async function gh13345_lean_deleteOne() {
+  interface IDBUser {
+    name: string;
+  }
+  const UserModel = model<IDBUser>('GH13345DeleteOne', new Schema<IDBUser>({ name: String }));
+
+  const res = await UserModel.deleteOne({}).lean();
+  expectType<DeleteResult>(res);
+
+  const resMany = await UserModel.deleteMany({}).lean();
+  expectType<DeleteResult>(resMany);
+}
+
+async function gh13345_lean_count() {
+  interface IDBUser {
+    name: string;
+  }
+  const UserModel = model<IDBUser>('GH13345Count', new Schema<IDBUser>({ name: String }));
+
+  const cnt = await UserModel.count({}).lean();
+  expectType<number>(cnt);
+
+  const cntDocs = await UserModel.countDocuments({}).lean();
+  expectType<number>(cntDocs);
+
+  const est = await UserModel.estimatedDocumentCount().lean();
+  expectType<number>(est);
+}
