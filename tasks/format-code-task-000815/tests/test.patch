diff --git a/usercase-test-coderl/snapshot_serialization.test.js b/usercase-test-coderl/snapshot_serialization.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/snapshot_serialization.test.js
@@ -0,0 +1,336 @@
+
+
+
+
+
+
+
+
+
+import chai from 'chai';
+import { System } from '../js/objects/System.js';
+import handInterface from '../js/objects/utils/handInterface.js';
+
+const assert = chai.assert;
+const expect = chai.expect;
+
+function ensureBrowserPolyfills(){
+    if(!window.URL.createObjectURL){
+        window.URL.createObjectURL = function createObjectURLMock(){
+            return 'blob:localb-polyfill';
+        };
+    }
+    if(!window.URL.revokeObjectURL){
+        window.URL.revokeObjectURL = function revokeObjectURLMock(){};
+    }
+}
+
+function sendSaveHTML(fileName){
+    const args = fileName === undefined ? [] : [fileName];
+    return System.world.sendMessage({
+        type: 'command',
+        commandName: 'saveHTML',
+        args: args
+    }, System);
+}
+
+function installDownloadRecorder(){
+    ensureBrowserPolyfills();
+    const clicks = [];
+    const revoked = [];
+    const objectUrls = [];
+    const originalClick = window.HTMLAnchorElement.prototype.click;
+    const originalCreateObjectURL = window.URL.createObjectURL;
+    const originalRevokeObjectURL = window.URL.revokeObjectURL;
+
+    window.HTMLAnchorElement.prototype.click = function clickRecorder(){
+        clicks.push({
+            download: this.download,
+            href: this.href,
+            hrefPrefix: this.href.slice(0, 30),
+            hrefLength: this.href.length,
+            display: this.style.display,
+            hidden: this.hidden,
+            visibility: this.style.visibility,
+            inBodyAtClick: document.body.contains(this)
+        });
+    };
+    window.URL.createObjectURL = function createObjectURLRecorder(blob){
+        const url = `blob:localb-${objectUrls.length}`;
+        objectUrls.push({url, blob});
+        return url;
+    };
+    window.URL.revokeObjectURL = function revokeRecorder(url){
+        revoked.push({
+            url,
+            prefix: url.slice(0, 30),
+            length: url.length
+        });
+    };
+
+    return {
+        clicks,
+        revoked,
+        objectUrls,
+        restore(){
+            window.HTMLAnchorElement.prototype.click = originalClick;
+            window.URL.createObjectURL = originalCreateObjectURL;
+            window.URL.revokeObjectURL = originalRevokeObjectURL;
+        }
+    };
+}
+
+function assertFullSnapshotHTML(html){
+
+    assert.strictEqual(typeof html, 'string');
+    assert.isAbove(html.length, 0);
+    const parsed = new window.DOMParser().parseFromString(html, 'text/html');
+    assert.strictEqual(parsed.documentElement.tagName.toLowerCase(), 'html');
+    assert.strictEqual(parsed.querySelectorAll('st-world').length, 0);
+    assert.strictEqual(parsed.querySelectorAll('st-navigator').length, 0);
+    assert.strictEqual(Boolean(parsed.getElementById('serialization')), true);
+}
+
+function assertHiddenAnchorClick(click){
+
+    assert.strictEqual(click.inBodyAtClick, true);
+    assert.isTrue(click.display === 'none' || click.hidden || click.visibility === 'hidden');
+}
+
+async function extractDownloadedHTML(click, downloadRecorder){
+    if(click.href.startsWith('data:')){
+        const commaIndex = click.href.indexOf(',');
+        assert.isAtLeast(commaIndex, 0);
+        return decodeURIComponent(click.href.slice(commaIndex + 1));
+    }
+
+    const objectUrl = downloadRecorder.objectUrls.find(entry => entry.url === click.href);
+    assert.isOk(objectUrl, `download href should be a recorded data or blob URL, got ${click.href}`);
+    assert.isFunction(objectUrl.blob.text, 'recorded Blob should expose text()');
+    return objectUrl.blob.text();
+}
+
+describe('Usercase snapshot serialization acceptance', () => {
+    let recorder;
+
+    beforeEach(() => {
+        recorder = installDownloadRecorder();
+        handInterface.handDetectionRunning = false;
+        Array.from(document.querySelectorAll('a[download]')).forEach(anchor => anchor.remove());
+    });
+
+    afterEach(() => {
+        recorder.restore();
+        handInterface.handDetectionRunning = false;
+        Array.from(document.querySelectorAll('a[download]')).forEach(anchor => anchor.remove());
+    });
+
+    it('returns a full cloned HTML snapshot without live world or navigator', () => {
+
+
+
+
+        const html = System.getFullHTMLString();
+
+        assertFullSnapshotHTML(html);
+        assert.strictEqual(html.includes('<st-editor'), true);
+        assert.strictEqual(document.querySelectorAll('st-world').length, 1);
+        assert.strictEqual(document.querySelectorAll('st-navigator').length, 1);
+        assert.strictEqual(document.querySelectorAll('st-editor').length, 1);
+        assert.strictEqual(Boolean(document.getElementById('serialization')), true);
+    });
+
+    it('saves through the System command with an explicit file name and a hidden anchor', async () => {
+
+
+
+
+        sendSaveHTML('Given Name');
+
+        assert.strictEqual(recorder.clicks.length, 1);
+        assert.strictEqual(recorder.clicks[0].download, 'Given Name.html');
+        assertHiddenAnchorClick(recorder.clicks[0]);
+
+        const payload = await extractDownloadedHTML(recorder.clicks[0], recorder);
+        assertFullSnapshotHTML(payload);
+
+        const serializationText = document.getElementById('serialization').textContent;
+        assert.isAbove(serializationText.length, 0);
+        const serialization = JSON.parse(serializationText);
+        assert.strictEqual(serialization.type, 'world');
+        assert.strictEqual(serialization.rootId, serialization.id);
+        assert.isObject(serialization.parts);
+        assert.isObject(serialization.parts[serialization.rootId]);
+    });
+
+    it('uses the current world name when saveHTML is invoked without a file name', () => {
+
+
+
+
+        const originalName = System.world.partProperties.getPropertyNamed(System.world, 'name');
+        System.world.partProperties.setPropertyNamed(System.world, 'name', 'Local Snapshot Name');
+        try {
+            sendSaveHTML('Given Name');
+            sendSaveHTML();
+        } finally {
+            System.world.partProperties.setPropertyNamed(System.world, 'name', originalName);
+        }
+
+
+        assert.deepEqual(recorder.clicks.map(click => click.download), [
+            'Given Name.html',
+            'Local Snapshot Name.html'
+        ]);
+
+        recorder.clicks.forEach(assertHiddenAnchorClick);
+    });
+
+    it('stops and restarts hand detection around the save when it was running', () => {
+
+
+
+
+        const calls = [];
+        const originalStop = handInterface.stop;
+        const originalStart = handInterface.start;
+        handInterface.stop = function stopRecorder(){
+            calls.push('stop');
+            this.handDetectionRunning = false;
+        };
+        handInterface.start = function startRecorder(){
+            calls.push('start');
+            this.handDetectionRunning = true;
+        };
+        handInterface.handDetectionRunning = true;
+
+        try {
+            sendSaveHTML('Hands');
+        } finally {
+            handInterface.stop = originalStop;
+            handInterface.start = originalStart;
+        }
+
+        assert.deepEqual(calls, ['stop', 'start']);
+        assert.strictEqual(handInterface.handDetectionRunning, true);
+        assert.deepEqual(recorder.clicks.map(click => click.download), ['Hands.html']);
+
+        recorder.clicks.forEach(assertHiddenAnchorClick);
+    });
+
+    it('renders a Save Snapshot context-menu item that dispatches the saveHTML command from the world', () => {
+
+
+
+
+        const menu = document.createElement('st-context-menu');
+        document.body.append(menu);
+        menu.render(System.getCurrentCardModel());
+        const sent = [];
+        const originalWorldSendMessage = System.world.sendMessage;
+        System.world.sendMessage = function sendRecorder(message, target){
+            sent.push({
+                message,
+                sameTarget: target === System.world
+            });
+        };
+
+        try {
+            Array.from(menu.children)
+                .find(child => child.textContent === 'Save Snapshot...')
+                .dispatchEvent(new window.Event('click'));
+        } finally {
+            System.world.sendMessage = originalWorldSendMessage;
+        }
+
+
+        assert.strictEqual(Array.from(menu.children).filter(child => child.textContent === 'Save Snapshot...').length, 1);
+
+        assert.strictEqual(sent.length, 1);
+        assert.deepEqual(sent[0].message, {
+            type: 'command',
+            commandName: 'saveHTML',
+            args: []
+        });
+    });
+
+    it('uses the explicit file name instead of the world name when both are available', () => {
+
+
+
+
+        const originalName = System.world.partProperties.getPropertyNamed(System.world, 'name');
+        System.world.partProperties.setPropertyNamed(System.world, 'name', 'World Name Should Not Win');
+        try {
+
+            sendSaveHTML('Explicit Only');
+        } finally {
+            System.world.partProperties.setPropertyNamed(System.world, 'name', originalName);
+        }
+
+        assert.deepEqual(recorder.clicks.map(click => click.download), ['Explicit Only.html']);
+    });
+
+    it('keeps cloned snapshot state independent from the live browser DOM', () => {
+
+
+
+
+        const snapshotA = System.getFullHTMLString();
+        const liveCountsAfterA = {
+            world: document.querySelectorAll('st-world').length,
+            navigator: document.querySelectorAll('st-navigator').length
+        };
+        const snapshotB = System.getFullHTMLString();
+        const liveCountsAfterB = {
+            world: document.querySelectorAll('st-world').length,
+            navigator: document.querySelectorAll('st-navigator').length
+        };
+
+
+        assertFullSnapshotHTML(snapshotA);
+        assertFullSnapshotHTML(snapshotB);
+        assert.deepEqual(liveCountsAfterA, {
+            world: 1,
+            navigator: 1
+        });
+        assert.deepEqual(liveCountsAfterB, {
+            world: 1,
+            navigator: 1
+        });
+    });
+
+    it('performs cleanup idempotently across two consecutive saveHTML calls', () => {
+
+
+
+
+        sendSaveHTML('Again');
+        sendSaveHTML('Again');
+
+        assert.deepEqual(recorder.clicks.map(click => click.download), [
+            'Again.html',
+            'Again.html'
+        ]);
+
+        recorder.clicks.forEach(assertHiddenAnchorClick);
+    });
+
+    it('keeps browser-session resources bounded across 100 save cycles', function(){
+
+
+
+
+        this.timeout(10000);
+
+        for(let i = 0; i < 100; i++){
+            sendSaveHTML('Cycle');
+        }
+
+
+        assert.strictEqual(recorder.clicks.length, 100);
+        assert.strictEqual(recorder.clicks[0].download, 'Cycle.html');
+        assert.strictEqual(recorder.clicks[99].download, 'Cycle.html');
+        recorder.clicks.forEach(assertHiddenAnchorClick);
+    });
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
