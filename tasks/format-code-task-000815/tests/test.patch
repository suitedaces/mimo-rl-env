+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+
+if [ ! -x ./node_modules/mocha/bin/mocha ] ||
+   [ ! -f ./node_modules/yargs-parser/build/index.cjs ] ||
+   [ ! -f ./node_modules/esm/esm.js ] ||
+   [ ! -f ./node_modules/jsdom/lib/api.js ] ||
+   [ ! -f ./node_modules/canvas/build/Release/canvas.node ]; then
+  echo "Required local Node dependencies are missing; refusing to run npm in offline test image." >&2
+  exit 127
+fi
+
+exec /usr/bin/timeout 120s ./node_modules/mocha/bin/mocha \
+  /workspace/repo/usercase-test-coderl/snapshot_serialization.test.js \
+  --require esm \
+  --require ./js/objects/tests/preload.js
