+async def test_publish_service_no_payload_succeeds(
+    hass: HomeAssistant, mqtt_mock_entry: MqttMockHAClientGenerator
+) -> None:
+    """Test the publish service call without a payload (issue #137574).
+
+    Calling mqtt.publish with only a topic and no payload must not raise
+    a validation error. The user expects an empty MQTT message to be sent.
+    """
+    mqtt_mock = await mqtt_mock_entry()
+    await hass.services.async_call(
+        mqtt.DOMAIN,
+        mqtt.SERVICE_PUBLISH,
+        {mqtt.ATTR_TOPIC: "awtrix1/sendscreen"},
+        blocking=True,
+    )
+    assert mqtt_mock.async_publish.called
+    assert mqtt_mock.async_publish.call_args[0][0] == "awtrix1/sendscreen"
+
+
+async def test_publish_service_explicit_none_payload_succeeds(
+    hass: HomeAssistant, mqtt_mock_entry: MqttMockHAClientGenerator
+) -> None:
+    """Test the publish service call with an explicit None payload.
+
+    The reference contract accepts ``payload: None`` (vol.Any(cv.string, None)).
+    """
+    mqtt_mock = await mqtt_mock_entry()
+    await hass.services.async_call(
+        mqtt.DOMAIN,
+        mqtt.SERVICE_PUBLISH,
+        {mqtt.ATTR_TOPIC: "awtrix1/sendscreen", mqtt.ATTR_PAYLOAD: None},
+        blocking=True,
+    )
+    assert mqtt_mock.async_publish.called
+    assert mqtt_mock.async_publish.call_args[0][0] == "awtrix1/sendscreen"
+
+
+async def test_publish_service_normal_payload_preserved(
+    hass: HomeAssistant, mqtt_mock_entry: MqttMockHAClientGenerator
+) -> None:
+    """Preservation: a typical string payload still flows through unchanged."""
+    mqtt_mock = await mqtt_mock_entry()
+    await hass.services.async_call(
+        mqtt.DOMAIN,
+        mqtt.SERVICE_PUBLISH,
+        {mqtt.ATTR_TOPIC: "test/topic", mqtt.ATTR_PAYLOAD: "hello"},
+        blocking=True,
+    )
+    assert mqtt_mock.async_publish.called
+    assert mqtt_mock.async_publish.call_args[0][0] == "test/topic"
+    assert mqtt_mock.async_publish.call_args[0][1] == "hello"
+
+
+async def test_publish_service_empty_string_payload_preserved(
+    hass: HomeAssistant, mqtt_mock_entry: MqttMockHAClientGenerator
+) -> None:
+    """Preservation: an explicit empty-string payload still works."""
+    mqtt_mock = await mqtt_mock_entry()
+    await hass.services.async_call(
+        mqtt.DOMAIN,
+        mqtt.SERVICE_PUBLISH,
+        {mqtt.ATTR_TOPIC: "test/topic", mqtt.ATTR_PAYLOAD: ""},
+        blocking=True,
+    )
+    assert mqtt_mock.async_publish.called
+    assert mqtt_mock.async_publish.call_args[0][0] == "test/topic"
+    assert mqtt_mock.async_publish.call_args[0][1] == ""
+
+
