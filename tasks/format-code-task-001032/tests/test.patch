diff --git a/test/ninja/pool_controls.py b/test/ninja/pool_controls.py
new file mode 100644
index 000000000..8344df168
--- /dev/null
+++ b/test/ninja/pool_controls.py
@@ -0,0 +1,80 @@
+#!/usr/bin/env python
+
+import os
+import re
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+try:
+    import ninja
+except ImportError:
+    test.skip_test("Could not find ninja module.\n")
+
+ninja_bin = test.where_is('ninja')
+if not ninja_bin:
+    test.skip_test("Could not find ninja executable.\n")
+
+test.write('SConstruct', r'''
+SetOption('experimental', 'ninja')
+DefaultEnvironment(tools=[])
+env = Environment(tools=['ninja'])
+mode = ARGUMENTS.get('MODE', 'depth')
+env['NINJA_MAX_JOBS'] = int(ARGUMENTS['NINJA_MAX_JOBS'])
+
+if mode == 'compound':
+    env.NinjaPool('limited', 5)
+    env.NinjaPool('tiny', 2)
+    env['NINJA_POOL'] = 'limited'
+    env.Command('ambient.txt', [], 'echo ambient > $TARGET')
+    env.Command('compound.txt', [], [
+        'echo compound > $TARGET',
+        'echo complete >> $TARGET',
+    ], NINJA_POOL='limited')
+else:
+    plain = env.Command('plain.txt', [], 'echo plain > $TARGET')
+    env.InstallAs('installed.txt', plain)
+''')
+
+
+test.run(arguments=['--disable-execute-ninja', 'NINJA_MAX_JOBS=3', 'MODE=depth'], stdout=None)
+test.must_contain_all_lines(test.stdout(), ['Generating: build.ninja'])
+build_ninja = test.read('build.ninja', mode='r')
+test.fail_test('pool local_pool\n  depth = 3\n' not in build_ninja,
+               message='local_pool must use the requested job count')
+test.fail_test('pool install_pool\n  depth = 1\n' not in build_ninja,
+               message='install_pool must have an integral minimum capacity')
+test.run(program=ninja_bin, arguments=['-n', '-f', 'build.ninja'], stdout=None)
+
+test.run(arguments=['-c', 'NINJA_MAX_JOBS=3', 'MODE=depth'], stdout=None)
+
+
+test.run(arguments=['--disable-execute-ninja', 'NINJA_MAX_JOBS=1', 'MODE=depth'], stdout=None)
+build_ninja = test.read('build.ninja', mode='r')
+test.fail_test('pool local_pool\n  depth = 1\n' not in build_ninja,
+               message='local_pool must retain a single requested job')
+test.fail_test('pool install_pool\n  depth = 1\n' not in build_ninja,
+               message='install_pool must be clamped to one job')
+test.run(program=ninja_bin, arguments=['-n', '-f', 'build.ninja'], stdout=None)
+
+test.run(arguments=['-c', 'NINJA_MAX_JOBS=1', 'MODE=depth'], stdout=None)
+
+
+
+test.run(arguments=['--disable-execute-ninja', 'NINJA_MAX_JOBS=3', 'MODE=compound'], stdout=None)
+test.must_contain_all_lines(test.stdout(), ['Generating: build.ninja'])
+build_ninja = test.read('build.ninja', mode='r')
+pool_match = re.search(r'^build compound\.txt:.*\n((?:  .*\n)*)', build_ninja, re.MULTILINE)
+test.fail_test(pool_match is None or '  pool = limited\n' not in pool_match.group(1),
+               message='compound action lost its NINJA_POOL override')
+ambient_match = re.search(r'^build ambient\.txt:.*\n((?:  .*\n)*)', build_ninja, re.MULTILINE)
+test.fail_test(ambient_match is None or '  pool = limited\n' in ambient_match.group(1),
+               message='environment-wide NINJA_POOL must not affect builders')
+test.fail_test('pool limited\n  depth = 3\n' not in build_ninja,
+               message='custom pools must be capped by NINJA_MAX_JOBS')
+test.fail_test('pool tiny\n  depth = 2\n' not in build_ninja,
+               message='custom pools below the cap must retain their depth')
+test.run(program=ninja_bin, arguments=['-n', '-f', 'build.ninja'], stdout=None)
+
+test.pass_test()
