--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,30 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+set +u
+source /root/.venv/bin/activate
+set -u
+
+pip install -e . --no-input -q 2>/dev/null
+
+NEW_TESTS=(
+  "pydicom/tests/test_dataset.py::TestDataset::test_save_as_warns_for_unencapsulated_pixel_data"
+  "pydicom/tests/test_dataset.py::TestDataset::test_save_as_warning_not_limited_to_one_compressed_uid"
+  "pydicom/tests/test_dataset.py::TestDataset::test_save_as_encapsulated_pixel_data_no_new_warning"
+  "pydicom/tests/test_dataset.py::TestDataset::test_save_as_missing_pixel_or_transfer_syntax_no_new_warning"
+  "pydicom/tests/test_dataset.py::TestDataset::test_save_as_private_transfer_syntax_no_new_warning"
+)
+
+case "${1:-}" in
+  base)
+    python -m pytest pydicom/tests/test_dataset.py -v -k "not test_save_as_warns_for_unencapsulated_pixel_data and not test_save_as_warning_not_limited_to_one_compressed_uid and not test_save_as_encapsulated_pixel_data_no_new_warning and not test_save_as_missing_pixel_or_transfer_syntax_no_new_warning and not test_save_as_private_transfer_syntax_no_new_warning"
+    ;;
+  new)
+    python -m pytest -v "${NEW_TESTS[@]}"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
