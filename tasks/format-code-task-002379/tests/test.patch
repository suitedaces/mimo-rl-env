@@ -1122,6 +1126,105 @@ class TestDataset(object):
         ds.file_meta.ImplementationClassUID = '1.4'
         ds.save_as(fp, write_like_original=False)
 
+    def _save_dataset_to_stream(self, ds):
+        fp = DicomBytesIO()
+        ds.save_as(fp)
+        assert fp.tell() > 0
+        return fp
+
+    def _save_dataset_without_output_assertion(self, ds):
+        fp = DicomBytesIO()
+        ds.save_as(fp)
+        return fp
+
+    def test_save_as_warns_for_unencapsulated_pixel_data(self):
+        """Saving compressed transfer syntax with raw Pixel Data warns."""
+        ds = Dataset()
+        ds.is_little_endian = True
+        ds.is_implicit_VR = False
+        ds.file_meta = Dataset()
+        ds.file_meta.TransferSyntaxUID = JPEGBaseline
+        ds.PixelData = b'\x00\x01\x02\x03\x04\x05\x06'
+        ds['PixelData'].VR = 'OB'
+
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always")
+            self._save_dataset_to_stream(ds)
+
+        assert caught
+
+    def test_save_as_warning_not_limited_to_one_compressed_uid(self):
+        """The warning applies to standard compressed UIDs generally."""
+        ds = Dataset()
+        ds.is_little_endian = True
+        ds.is_implicit_VR = False
+        ds.file_meta = Dataset()
+        ds.file_meta.TransferSyntaxUID = UID("1.2.840.10008.1.2.4.91")
+        ds.PixelData = b'\x10\x20\x30\x40\x50\x60'
+        ds['PixelData'].VR = 'OB'
+
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always")
+            self._save_dataset_to_stream(ds)
+
+        assert caught
+
+    def test_save_as_encapsulated_pixel_data_no_new_warning(self):
+        """Encapsulated Pixel Data should not trigger the new warning."""
+        ds = Dataset()
+        ds.is_little_endian = True
+        ds.is_implicit_VR = False
+        ds.file_meta = Dataset()
+        ds.file_meta.TransferSyntaxUID = JPEGBaseline
+        ds.PixelData = encapsulate([b'\x00\x01\x02\x03\x04\x05\x06'])
+        ds['PixelData'].VR = 'OB'
+
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always")
+            self._save_dataset_to_stream(ds)
+
+        assert not caught
+
+    def test_save_as_missing_pixel_or_transfer_syntax_no_new_warning(self):
+        """Missing Pixel Data or transfer syntax metadata should not warn."""
+        compressed_no_pixel = Dataset()
+        compressed_no_pixel.is_little_endian = True
+        compressed_no_pixel.is_implicit_VR = False
+        compressed_no_pixel.file_meta = Dataset()
+        compressed_no_pixel.file_meta.TransferSyntaxUID = JPEGBaseline
+
+        no_transfer_syntax = Dataset()
+        no_transfer_syntax.is_little_endian = True
+        no_transfer_syntax.is_implicit_VR = False
+        no_transfer_syntax.file_meta = Dataset()
+
+        no_file_meta = Dataset()
+        no_file_meta.is_little_endian = True
+        no_file_meta.is_implicit_VR = False
+
+        for ds in (compressed_no_pixel, no_transfer_syntax, no_file_meta):
+            with warnings.catch_warnings(record=True) as caught:
+                warnings.simplefilter("always")
+                self._save_dataset_without_output_assertion(ds)
+
+            assert not caught
+
+    def test_save_as_private_transfer_syntax_no_new_warning(self):
+        """Private transfer syntaxes should not be treated as compressed."""
+        ds = Dataset()
+        ds.is_little_endian = True
+        ds.is_implicit_VR = False
+        ds.file_meta = Dataset()
+        ds.file_meta.TransferSyntaxUID = UID("1.2.3.4.5.6")
+        ds.PixelData = b'\x00\x01\x02\x03\x04\x05\x06'
+        ds['PixelData'].VR = 'OB'
+
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always")
+            self._save_dataset_to_stream(ds)
+
+        assert not caught
+
     def test_with(self):
