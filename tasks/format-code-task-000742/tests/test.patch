+#!/usr/bin/python
+# -*- coding: utf-8 -*-
+import unittest
+
+import pyment.docstring as docs
+
+
+def gen(elem, style='reST', input_docs=''):
+
+
+
+
+
+
+
+    d = docs.DocString(elem, quotes='"""', output_style=style)
+    d.parse_docs(input_docs)
+    return d.get_raw_docs()
+
+
+def lines(text):
+
+    return set(l.strip() for l in text.splitlines() if l.strip())
+
+
+class TypeHintTests(unittest.TestCase):
+
+    def testParamTypeFieldReST(self):
+        out = gen("def func(param1, param2: str = 'default val') -> int:")
+        ls = lines(out)
+
+        self.assertIn(":type param2: str", ls)
+
+        self.assertFalse(any(l.startswith(":type param1") for l in ls))
+
+    def testReturnTypeFieldReST(self):
+        out = gen("def func(param1, param2: str = 'default val') -> int:")
+        self.assertIn(":rtype: int", lines(out))
+
+    def testDefaultValuePreservedWithAnnotation(self):
+        out = gen("def func(param1, param2: str = 'default val') -> int:")
+        self.assertTrue(any("(Default value = 'default val')" in l
+                            for l in out.splitlines()))
+
+    def testNoAnnotationsNoTypeFields(self):
+        out = gen("def func(param1, param2=None):")
+        ls = lines(out)
+        self.assertFalse(any(l.startswith(":type") for l in ls))
+        self.assertFalse(any(l.startswith(":rtype") for l in ls))
+
+        self.assertIn(":param param1:", ls)
+
+    def testAnnotationOnlyNoDefault(self):
+        out = gen("def func(value: int):")
+        ls = lines(out)
+        self.assertIn(":type value: int", ls)
+        self.assertFalse(any("Default value" in l for l in out.splitlines()))
+
+    def testBracketedAnnotationsNotSplit(self):
+        out = gen("def f(a: Dict[str, int], "
+                  "b: Optional[List[str]] = None) -> Tuple[int, ...]:")
+        ls = lines(out)
+        self.assertIn(":type a: Dict[str, int]", ls)
+        self.assertIn(":type b: Optional[List[str]]", ls)
+        self.assertIn(":rtype: Tuple[int, ...]", ls)
+
+        self.assertIn(":param a:", ls)
+        self.assertTrue(any(l.startswith(":param b:") for l in ls))
+        self.assertFalse(any(l.startswith(":param int") for l in ls))
+        self.assertFalse(any(l.startswith(":param str") for l in ls))
+
+    def testSelfAndClsSkipped(self):
+        out = gen("def method(self, cls, value: int) -> bool:")
+        ls = lines(out)
+        self.assertFalse(any(l.startswith(":param self") for l in ls))
+        self.assertFalse(any(l.startswith(":param cls") for l in ls))
+        self.assertIn(":type value: int", ls)
+        self.assertIn(":rtype: bool", ls)
+
+    def testAsyncDefSupported(self):
+        out = gen("async def func(value: int) -> str:")
+        ls = lines(out)
+        self.assertIn(":type value: int", ls)
+        self.assertIn(":rtype: str", ls)
+
+    def testExistingParamTypeWins(self):
+        input_docs = '''"""Desc.
+
+:param value: a value
+:type value: KeepMe
+:returns: a result
+"""'''
+        out = gen("def func(value: Override = 1) -> int:", input_docs=input_docs)
+        ls = lines(out)
+        self.assertIn(":type value: KeepMe", ls)
+        self.assertFalse(any("Override" in l for l in out.splitlines()))
+
+    def testExistingReturnTypeWins(self):
+        input_docs = '''"""Desc.
+
+:param value: v
+:returns: a result
+:rtype: KeepRet
+"""'''
+        out = gen("def func(value) -> OverrideRet:", input_docs=input_docs)
+        ls = lines(out)
+        self.assertIn(":rtype: KeepRet", ls)
+        self.assertFalse(any("OverrideRet" in l for l in out.splitlines()))
+
+    def testJavadocTypeAndRType(self):
+        out = gen("def func(value: int) -> bool:", style='javadoc')
+        ls = lines(out)
+        self.assertIn("@type value: int", ls)
+        self.assertIn("@rtype: bool", ls)
+
+    def testNumpydocParamType(self):
+        out = gen("def func(value: MyType):", style='numpydoc')
+        self.assertIn("value : MyType", lines(out))
+
+    def testGoogleParamType(self):
+        out = gen("def func(value: MyType):", style='google')
+        self.assertIn("value(MyType):", lines(out))
+
+
+if __name__ == '__main__':
+    unittest.main()
