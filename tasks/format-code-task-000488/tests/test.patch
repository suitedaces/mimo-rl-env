+    result = run_python(
+        """
+        from taipy.core.notification import EventEntityType, EventOperation, Notifier
+
+        configure_storage("event")
+        input_cfg = Config.configure_data_node("input_cfg", storage_type="in_memory")
+        output_cfg = Config.configure_data_node("output_cfg", storage_type="in_memory")
+        task_cfg = Config.configure_task("forecast_task", identity, input_cfg, output_cfg)
+        scenario_cfg = Config.configure_scenario("forecast_scenario", task_configs=[task_cfg])
+        register_id, queue = Notifier.register(entity_type=EventEntityType.SCENARIO, operation=EventOperation.CREATION)
+
+        scenario = tp.create_scenario(scenario_cfg, datetime(2026, 7, 22, 10, 30))
+        event = queue.get_nowait()
+        Notifier.unregister(register_id)
+        emit({
+            "entity_type": event.entity_type.name,
+            "operation": event.operation.name,
+            "entity_id_matches": event.entity_id == scenario.id,
+            "attribute_name": event.attribute_name,
+            "attribute_value": event.attribute_value,
+            "metadata_config_id": event.metadata.get("config_id"),
+            "metadata_keys": sorted(event.metadata.keys()),
+        })
+        """,
+        tmp_path,
+    )
+
+
+    assert result["entity_type"] == "SCENARIO"
+    assert result["operation"] == "CREATION"
+    assert result["entity_id_matches"] is True
