+import json
+import os
+import subprocess
+import sys
+import textwrap
+
+
+
+
+
+
+
+
+REPO = "/workspace/repo"
+RESULT_PREFIX = "__USERCASE_RESULT__"
+
+
+COMMON = r"""
+import json
+from datetime import datetime
+
+import taipy as tp
+from taipy import Config, Frequency
+
+
+def identity(x):
+    return x
+
+
+def emit(value):
+    print("__USERCASE_RESULT__" + json.dumps(value, sort_keys=True))
+
+
+def configure_storage(suffix):
+    Config.configure_core(storage_folder=f".declared_data_{suffix}", taipy_storage_folder=f".declared_taipy_{suffix}")
+
+
+def sequence_task_ids(sequence):
+    return list(sequence.tasks.keys())
+
+
+def scenario_summary(scenario):
+    return {
+        "config_id": scenario.config_id,
+        "task_config_ids": sorted(scenario.tasks.keys()),
+        "data_node_config_ids": sorted(scenario.data_nodes.keys()),
+        "additional_data_node_config_ids": sorted(scenario.additional_data_nodes.keys()),
+        "task_data_nodes": {k: sorted(v.data_nodes.keys()) for k, v in sorted(scenario.tasks.items())},
+        "name": scenario.name,
+        "creation_date": scenario.creation_date.isoformat(),
+        "cycle": None if scenario.cycle is None else {
+            "frequency": scenario.cycle.frequency.name,
+            "creation_date": scenario.cycle.creation_date.isoformat(),
+            "start_date": scenario.cycle.start_date.isoformat(),
+            "end_date": scenario.cycle.end_date.isoformat(),
+            "name": scenario.cycle.name,
+        },
+        "owner_id_matches_cycle": scenario.owner_id == (scenario.cycle.id if scenario.cycle else None),
+        "is_primary": scenario.is_primary,
+        "sequences": {name: sequence_task_ids(seq) for name, seq in sorted(scenario.sequences.items())},
+    }
+"""
+
+
+def run_python(code, cwd):
+    env = os.environ.copy()
+    env["PYTHONPATH"] = REPO + os.pathsep + env.get("PYTHONPATH", "")
+    proc = subprocess.run(
+        [sys.executable, "-c", COMMON + "\n" + textwrap.dedent(code)],
+        cwd=cwd,
+        env=env,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+    )
+    if proc.returncode != 0:
+        raise AssertionError(proc.stdout)
+    for line in reversed(proc.stdout.splitlines()):
+        if line.startswith(RESULT_PREFIX):
+            return json.loads(line[len(RESULT_PREFIX) :])
+    raise AssertionError(proc.stdout)
+
+
+def assert_scenario_summary(
+    summary,
+    *,
+    config_id,
+    task_config_ids,
+    data_node_config_ids,
+    task_data_nodes,
+    additional_data_node_config_ids=None,
+    name=None,
+    creation_date="2026-07-22T10:30:00",
+    cycle=None,
+    is_primary=False,
+    sequences=None,
+):
+    additional_data_node_config_ids = additional_data_node_config_ids or []
+    sequences = sequences or {}
+
+    assert summary["config_id"] == config_id
+    assert sorted(summary["task_config_ids"]) == sorted(task_config_ids)
+    assert sorted(summary["data_node_config_ids"]) == sorted(data_node_config_ids)
+    assert sorted(summary["additional_data_node_config_ids"]) == sorted(additional_data_node_config_ids)
+    assert summary["task_data_nodes"] == {k: sorted(v) for k, v in task_data_nodes.items()}
+    assert summary["name"] == name
+    assert summary["creation_date"] == creation_date
+    assert summary["is_primary"] is is_primary
+    assert summary["sequences"] == sequences
+    if cycle is None:
+        assert summary["cycle"] is None
+    else:
+        assert summary["cycle"]["frequency"] == cycle["frequency"]
+        assert summary["cycle"]["creation_date"] == cycle["creation_date"]
+        assert summary["cycle"]["start_date"] == cycle["start_date"]
+        assert summary["cycle"]["end_date"] == cycle["end_date"]
+
+
+
+def test_one_task_graph_is_materialized_and_persisted(tmp_path):
+
+
+
+
+    result = run_python(
+        """
+        configure_storage("basic")
+        input_cfg = Config.configure_data_node("input_cfg", storage_type="in_memory")
+        output_cfg = Config.configure_data_node("output_cfg", storage_type="in_memory")
+        task_cfg = Config.configure_task("forecast_task", identity, input_cfg, output_cfg)
+        scenario_cfg = Config.configure_scenario("forecast_scenario", task_configs=[task_cfg])
+        creation_date = datetime(2026, 7, 22, 10, 30)
+
+        scenario = tp.create_scenario(scenario_cfg, creation_date)
+        emit({
+            "returned": scenario_summary(scenario),
+            "retrieved": scenario_summary(tp.get(scenario.id)),
+            "scenario_count": len(tp.get_scenarios()),
+        })
+        """,
+        tmp_path,
+    )
+
+
+    assert_scenario_summary(
+        result["returned"],
+        config_id="forecast_scenario",
+        task_config_ids=["forecast_task"],
+        data_node_config_ids=["input_cfg", "output_cfg"],
+        task_data_nodes={"forecast_task": ["input_cfg", "output_cfg"]},
+    )
+    assert result["retrieved"] == result["returned"]
+    assert result["scenario_count"] == 1
+
+
