+def test_no_undeclared_network_or_cwd_file_side_effects(tmp_path):
+    result = run_python(
+        """
+        import os
+        import socket
+
+        def blocked_socket(*args, **kwargs):
+            raise AssertionError("network access is not declared")
+
+        socket.socket = blocked_socket
+        before = set(os.listdir("."))
+        configure_storage("sideeffects")
+        input_cfg = Config.configure_data_node("input_cfg", storage_type="in_memory")
+        output_cfg = Config.configure_data_node("output_cfg", storage_type="in_memory")
+        task_cfg = Config.configure_task("forecast_task", identity, input_cfg, output_cfg)
+        scenario_cfg = Config.configure_scenario("forecast_scenario", task_configs=[task_cfg])
+
+        tp.create_scenario(scenario_cfg, datetime(2026, 7, 22, 10, 30))
+        after = set(os.listdir("."))
+        emit({"created_entries": sorted(after - before)})
+        """,
+        tmp_path,
+    )
+
+
+    assert ".declared_taipy_sideeffects" in result["created_entries"]
