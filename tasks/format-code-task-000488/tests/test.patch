+def test_daily_frequency_attaches_cycle_and_marks_only_first_primary(tmp_path):
+
+
+
+
+    result = run_python(
+        """
+        configure_storage("daily")
+        input_cfg = Config.configure_data_node("input_cfg", storage_type="in_memory")
+        output_cfg = Config.configure_data_node("output_cfg", storage_type="in_memory")
+        task_cfg = Config.configure_task("forecast_task", identity, input_cfg, output_cfg)
+        scenario_cfg = Config.configure_scenario("daily_forecast", task_configs=[task_cfg], frequency=Frequency.DAILY)
+        creation_date = datetime(2026, 7, 22, 10, 30)
+
+        first = tp.create_scenario(scenario_cfg, creation_date)
+        second = tp.create_scenario(scenario_cfg, creation_date)
+        emit({
+            "first": scenario_summary(first),
+            "second": scenario_summary(second),
+            "same_cycle": first.cycle.id == second.cycle.id,
+            "cycle_count": len(tp.get_cycles()),
+        })
+        """,
+        tmp_path,
+    )
+
+    cycle = {
+        "frequency": "DAILY",
+        "creation_date": "2026-07-22T10:30:00",
+        "start_date": "2026-07-22T00:00:00",
+        "end_date": "2026-07-22T23:59:59.999999",
+    }
+
+    assert_scenario_summary(
+        result["first"],
+        config_id="daily_forecast",
+        task_config_ids=["forecast_task"],
+        data_node_config_ids=["input_cfg", "output_cfg"],
+        task_data_nodes={"forecast_task": ["input_cfg", "output_cfg"]},
+        cycle=cycle,
+        is_primary=True,
+    )
+    assert_scenario_summary(
+        result["second"],
+        config_id="daily_forecast",
+        task_config_ids=["forecast_task"],
+        data_node_config_ids=["input_cfg", "output_cfg"],
+        task_data_nodes={"forecast_task": ["input_cfg", "output_cfg"]},
+        cycle=cycle,
+        is_primary=False,
+    )
+    assert result["same_cycle"] is True
+    assert result["cycle_count"] == 1
