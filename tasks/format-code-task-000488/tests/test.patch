+def test_sequence_reference_to_foreign_task_raises_specific_exception(tmp_path):
+
+
+
+
+    result = run_python(
+        """
+        from taipy.core.config import ScenarioConfig
+        from taipy.core.exceptions.exceptions import SequenceTaskConfigDoesNotExistInSameScenarioConfig
+
+        configure_storage("badsequence")
+        a = Config.configure_data_node("a", storage_type="in_memory")
+        b = Config.configure_data_node("b", storage_type="in_memory")
+        t1 = Config.configure_task("t1", identity, a, b)
+        foreign_task = Config.configure_task("foreign_task", identity, b, None)
+        scenario_cfg = ScenarioConfig("bad_sequence", [t1], sequences={"pipeline": [t1, foreign_task]})
+
+        try:
+            tp.create_scenario(scenario_cfg)
+        except BaseException as exc:
+            emit({
+                "matches_specific_exception": isinstance(exc, SequenceTaskConfigDoesNotExistInSameScenarioConfig),
+            })
+        """,
+        tmp_path,
+    )
+
+
+    assert result == {"matches_specific_exception": True}
