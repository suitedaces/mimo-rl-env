+const isHiddenByTypestyle = (el: HTMLElement): boolean => {
+  const styles = getStyles()
+  const classes = el.className.split(' ').filter(Boolean)
+  for (const cls of classes) {
+    const escCls = cls.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+    const re = new RegExp('\\.' + escCls + '[^{]*\\{([^}]*)\\}')
+    const m = re.exec(styles)
+    if (m) {
+      const rule = m[1].replace(/\s+/g, '')
+      if (/opacity:0(?![\d.])/.test(rule) || rule.includes('visibility:hidden') || rule.includes('display:none')) {
+        return true
+      }
+    }
+  }
+  return false
+}
+const visibleSortIcons = (container: Element, name: 'SortUp' | 'SortDown') =>
+  Array.from(container.querySelectorAll(`i[data-icon-name="${name}"]`)).filter(el => !isHiddenByTypestyle(el as HTMLElement))
