--- /dev/null
+++ b/usercase-test-coderl/max_hardware_usage.test.js
@@ -0,0 +1,472 @@
+
+
+
+
+
+
+
+
+const mockImages = [];
+let mockLog;
+let mockListenerCounts;
+let mockFrameTime;
+
+function resetMockLog() {
+  mockLog = {
+    clearCalls: 0,
+    gBufferDraws: 0,
+    rayTraceDraws: 0,
+    rayTraceSetSizeCalls: [],
+    reprojectDraws: [],
+    toneMapDraws: [],
+    tileNextTileCalls: 0,
+    tileResetCalls: 0,
+    previewAdjustCalls: 0,
+    viewports: [],
+  };
+}
+
+function mockVectorScale(x, y) {
+  return {
+    x,
+    y,
+    clone() {
+      return mockVectorScale(this.x, this.y);
+    },
+  };
+}
+
+jest.mock('src/renderer/glUtil', () => ({
+  loadExtensions: jest.fn(() => ({})),
+}));
+
+jest.mock('src/renderer/decomposeScene', () => ({
+  decomposeScene: jest.fn(() => ({ meshes: [] })),
+}));
+
+jest.mock('src/renderer/mergeMeshesToGeometry', () => ({
+  mergeMeshesToGeometry: jest.fn(() => ({ materials: [] })),
+}));
+
+jest.mock('src/renderer/Framebuffer', () => ({
+  makeFramebuffer: jest.fn((gl, options) => {
+    const color = {};
+    Object.keys(options.color || {}).forEach((key) => {
+      color[key] = options.color[key];
+    });
+    return {
+      color,
+      bind: jest.fn(),
+      unbind: jest.fn(),
+    };
+  }),
+}));
+
+jest.mock('src/renderer/FullscreenQuad', () => ({
+  makeFullscreenQuad: jest.fn(() => ({})),
+}));
+
+jest.mock('src/renderer/GBufferPass', () => ({
+  makeGBufferPass: jest.fn(() => ({
+    outputLocs: {
+      position: 0,
+      normal: 1,
+      faceNormal: 2,
+      color: 3,
+      matProps: 4,
+    },
+    draw: jest.fn(() => {
+      mockLog.gBufferDraws++;
+    }),
+    setCamera: jest.fn(),
+    setJitter: jest.fn(),
+  })),
+}));
+
+jest.mock('src/renderer/MaterialBuffer', () => ({
+  makeMaterialBuffer: jest.fn(() => ({})),
+}));
+
+jest.mock('src/renderer/RayTracePass', () => ({
+  makeRayTracePass: jest.fn(() => ({
+    outputLocs: { light: 0 },
+    bindTextures: jest.fn(),
+    draw: jest.fn(() => {
+      mockLog.rayTraceDraws++;
+    }),
+    nextSeed: jest.fn(),
+    setCamera: jest.fn(),
+    setGBuffers: jest.fn(),
+    setJitter: jest.fn(),
+    setNoise: jest.fn(),
+    setSize: jest.fn((width, height) => {
+      mockLog.rayTraceSetSizeCalls.push([width, height]);
+    }),
+    setStrataCount: jest.fn(),
+  })),
+}));
+
+jest.mock('src/renderer/RenderSize', () => ({
+  makeRenderSize: jest.fn(() => ({
+    width: 4,
+    height: 3,
+    scale: mockVectorScale(0.5, 0.5),
+    adjustSize: jest.fn(() => {
+      mockLog.previewAdjustCalls++;
+    }),
+    setSize: jest.fn(),
+  })),
+}));
+
+jest.mock('src/renderer/ReprojectPass', () => ({
+  makeReprojectPass: jest.fn(() => ({
+    draw: jest.fn((params) => {
+      mockLog.reprojectDraws.push({
+        blendAmount: params.blendAmount,
+        lightScale: [params.lightScale.x, params.lightScale.y],
+      });
+    }),
+    setJitter: jest.fn(),
+    setPreviousCamera: jest.fn(),
+  })),
+}));
+
+jest.mock('src/renderer/ToneMapPass', () => ({
+  makeToneMapPass: jest.fn(() => ({
+    draw: jest.fn((params) => {
+      mockLog.toneMapDraws.push({
+        lightScale: [params.lightScale.x, params.lightScale.y],
+      });
+    }),
+  })),
+}));
+
+jest.mock('src/renderer/TileRender', () => ({
+  makeTileRender: jest.fn(() => ({
+    nextTile: jest.fn(() => {
+      mockLog.tileNextTileCalls++;
+      return { x: 0, y: 0, tileWidth: 1, tileHeight: 1, isFirstTile: true, isLastTile: true };
+    }),
+    reset: jest.fn(() => {
+      mockLog.tileResetCalls++;
+    }),
+    setSize: jest.fn(),
+  })),
+}));
+
+jest.mock('src/renderer/Texture', () => {
+  let textureId = 0;
+  return {
+    makeDepthTarget: jest.fn(() => ({ id: `depth-${++textureId}` })),
+    makeTexture: jest.fn(() => ({ id: `texture-${++textureId}` })),
+  };
+});
+
+jest.mock('src/renderer/texture/noise', () => ({
+  __esModule: true,
+  default: 'data:image/png;base64,AA==',
+}));
+
+const THREE = require('three');
+const { RayTracingRenderer } = require('src/main');
+
+class ManualImage {
+  constructor() {
+    this._src = '';
+    this._onload = null;
+    mockImages.push(this);
+  }
+
+  set src(value) {
+    this._src = value;
+  }
+
+  get src() {
+    return this._src;
+  }
+
+  set onload(callback) {
+    this._onload = callback;
+  }
+
+  get onload() {
+    return this._onload;
+  }
+
+  load() {
+    if (this._onload) {
+      this._onload();
+    }
+  }
+}
+
+function makeCanvas() {
+  const canvas = {
+    width: 0,
+    height: 0,
+    style: {},
+  };
+
+  const gl = {
+    BLEND: 0x0BE2,
+    COLOR_BUFFER_BIT: 0x4000,
+    DEPTH_BUFFER_BIT: 0x0100,
+    FUNC_ADD: 0x8006,
+    LINEAR: 0x2601,
+    ONE: 1,
+    SCISSOR_TEST: 0x0C11,
+    blendEquation: jest.fn(),
+    blendFunc: jest.fn(),
+    clear: jest.fn(() => {
+      mockLog.clearCalls++;
+    }),
+    disable: jest.fn(),
+    enable: jest.fn(),
+    scissor: jest.fn(),
+    viewport: jest.fn((x, y, width, height) => {
+      mockLog.viewports.push([x, y, width, height]);
+    }),
+    get drawingBufferWidth() {
+      return canvas.width;
+    },
+    get drawingBufferHeight() {
+      return canvas.height;
+    },
+  };
+
+  canvas.getContext = jest.fn((kind) => (kind === 'webgl2' ? gl : null));
+  return canvas;
+}
+
+function makeReadyRenderer({ width = 8, height = 6 } = {}) {
+  const renderer = RayTracingRenderer({ canvas: makeCanvas() });
+  renderer.maxHardwareUsage = true;
+  renderer.setSize(width, height);
+
+  const scene = new THREE.Scene();
+  const camera = new THREE.PerspectiveCamera(55, width / height, 0.1, 50);
+  camera.position.set(0, 0, 5);
+  camera.updateMatrixWorld();
+
+  renderFrame(renderer, scene, camera);
+  mockImages[mockImages.length - 1].load();
+
+  return { renderer, scene, camera };
+}
+
+function renderFrame(renderer, scene, camera) {
+  renderer.sync(mockFrameTime);
+  mockFrameTime += 16;
+  renderer.render(scene, camera);
+}
+
+function expectFullCanvasSamples(count, width, height) {
+  expect(mockLog.rayTraceDraws).toBe(count);
+  expect(mockLog.rayTraceSetSizeCalls).toHaveLength(count);
+  mockLog.rayTraceSetSizeCalls.forEach((size) => {
+    expect(size).toEqual([width, height]);
+  });
+
+  expect(mockLog.reprojectDraws).toHaveLength(count);
+  expect(mockLog.toneMapDraws).toHaveLength(count);
+}
+
+function listenerCount(type) {
+  return mockListenerCounts[type] || 0;
+}
+
+beforeEach(() => {
+  resetMockLog();
+  mockImages.length = 0;
+  mockListenerCounts = {};
+  mockFrameTime = 1000;
+
+  global.Image = ManualImage;
+  if (global.window) {
+    global.window.Image = ManualImage;
+  }
+
+  document.addEventListener = jest.fn((type) => {
+    mockListenerCounts[type] = listenerCount(type) + 1;
+  });
+  document.removeEventListener = jest.fn((type) => {
+    mockListenerCounts[type] = Math.max(0, listenerCount(type) - 1);
+  });
+});
+
+describe('RayTracingRenderer maxHardwareUsage stateful lifecycle', () => {
+  test('does nothing until the pipeline noise image marks the renderer ready', () => {
+
+
+
+
+    const renderer = RayTracingRenderer({ canvas: makeCanvas() });
+    renderer.maxHardwareUsage = true;
+    renderer.setSize(8, 6);
+    const scene = new THREE.Scene();
+    const camera = new THREE.PerspectiveCamera(55, 8 / 6, 0.1, 50);
+    camera.position.set(0, 0, 5);
+    camera.updateMatrixWorld();
+
+
+    expect(mockLog.rayTraceDraws).toBe(0);
+
+    renderFrame(renderer, scene, camera);
+
+    expect(renderer.getTotalSamplesRendered()).toBe(0);
+    expect(mockLog.rayTraceDraws).toBe(0);
+    expect(mockLog.reprojectDraws).toEqual([]);
+    expect(mockLog.toneMapDraws).toEqual([]);
+
+    renderer.dispose();
+  });
+
+  test('renders full-canvas samples and advances count only after an unchanged camera frame', () => {
+
+
+
+
+    const { renderer, scene, camera } = makeReadyRenderer({ width: 8, height: 6 });
+
+    renderFrame(renderer, scene, camera);
+
+    expect(renderer.getTotalSamplesRendered()).toBe(0);
+
+    expectFullCanvasSamples(1, 8, 6);
+    expect(mockLog.tileNextTileCalls).toBe(0);
+    expect(mockLog.viewports).toContainEqual([0, 0, 8, 6]);
+
+    renderFrame(renderer, scene, camera);
+
+    expect(renderer.getTotalSamplesRendered()).toBe(1);
+
+    expectFullCanvasSamples(2, 8, 6);
+    expect(mockLog.tileNextTileCalls).toBe(0);
+
+    renderer.dispose();
+  });
+
+  test('resets accumulation when the camera changes, then increments on the next stable render', () => {
+
+
+
+
+    const { renderer, scene, camera } = makeReadyRenderer({ width: 8, height: 6 });
+
+    renderFrame(renderer, scene, camera);
+    renderFrame(renderer, scene, camera);
+    expect(renderer.getTotalSamplesRendered()).toBe(1);
+
+    const clearCallsBeforeCameraChange = mockLog.clearCalls;
+    camera.position.set(1, 0, 5);
+    camera.updateMatrixWorld();
+    renderFrame(renderer, scene, camera);
+
+    expect(renderer.getTotalSamplesRendered()).toBe(0);
+
+    expect(mockLog.clearCalls).toBeGreaterThan(clearCallsBeforeCameraChange);
+    expectFullCanvasSamples(3, 8, 6);
+
+    renderFrame(renderer, scene, camera);
+
+    expect(renderer.getTotalSamplesRendered()).toBe(1);
+
+    expectFullCanvasSamples(4, 8, 6);
+    expect(mockLog.tileNextTileCalls).toBe(0);
+
+    renderer.dispose();
+  });
+
+  test('keeps maxHardwareUsage sample counts independent across renderer instances', () => {
+
+
+
+
+    const a = makeReadyRenderer({ width: 8, height: 6 });
+    renderFrame(a.renderer, a.scene, a.camera);
+    renderFrame(a.renderer, a.scene, a.camera);
+
+    const b = makeReadyRenderer({ width: 8, height: 6 });
+    renderFrame(b.renderer, b.scene, b.camera);
+
+    expect(a.renderer.getTotalSamplesRendered()).toBe(1);
+    expect(b.renderer.getTotalSamplesRendered()).toBe(0);
+
+    a.renderer.dispose();
+    b.renderer.dispose();
+  });
+
+  test('uses the public render(scene, camera) lifecycle after becoming ready', () => {
+
+
+
+
+
+    const renderer = RayTracingRenderer({ canvas: makeCanvas() });
+    renderer.maxHardwareUsage = true;
+    renderer.setSize(8, 6);
+    const scene = new THREE.Scene();
+    const camera = new THREE.PerspectiveCamera(55, 8 / 6, 0.1, 50);
+    camera.position.set(0, 0, 5);
+    camera.updateMatrixWorld();
+
+    renderFrame(renderer, scene, camera);
+    expect(mockLog.rayTraceDraws).toBe(0);
+
+    mockImages[mockImages.length - 1].load();
+    renderFrame(renderer, scene, camera);
+
+    expect(renderer.getTotalSamplesRendered()).toBe(0);
+    expectFullCanvasSamples(1, 8, 6);
+
+    renderer.dispose();
+  });
+
+  test('camera projection changes reset accumulation before the next stable frame increments', () => {
+
+
+
+
+
+    const { renderer, scene, camera } = makeReadyRenderer({ width: 8, height: 6 });
+
+    renderFrame(renderer, scene, camera);
+    renderFrame(renderer, scene, camera);
+    expect(renderer.getTotalSamplesRendered()).toBe(1);
+
+    camera.fov = 60;
+    camera.updateProjectionMatrix();
+    renderFrame(renderer, scene, camera);
+
+    expect(renderer.getTotalSamplesRendered()).toBe(0);
+    expectFullCanvasSamples(3, 8, 6);
+
+    renderFrame(renderer, scene, camera);
+
+    expect(renderer.getTotalSamplesRendered()).toBe(1);
+    expectFullCanvasSamples(4, 8, 6);
+
+    renderer.dispose();
+  });
+
+  test('full-canvas mode follows the configured canvas size across renderer instances', () => {
+
+
+
+
+
+    const a = makeReadyRenderer({ width: 8, height: 6 });
+    renderFrame(a.renderer, a.scene, a.camera);
+    expectFullCanvasSamples(1, 8, 6);
+
+    resetMockLog();
+
+    const b = makeReadyRenderer({ width: 5, height: 7 });
+    renderFrame(b.renderer, b.scene, b.camera);
+    expectFullCanvasSamples(1, 5, 7);
+    expect(mockLog.tileNextTileCalls).toBe(0);
+
+    a.renderer.dispose();
+    b.renderer.dispose();
+  });
+});
