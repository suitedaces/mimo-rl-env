+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export CI="${CI:-1}"
+export NO_UPDATE_NOTIFIER=1
+export BROWSERSLIST_IGNORE_OLD_DATA=1
+export npm_config_audit=false
+export npm_config_fund=false
+export npm_config_offline=true
+
+JEST_BIN="/workspace/repo/node_modules/jest/bin/jest.js"
+if [ ! -f "$JEST_BIN" ]; then
+  echo "Missing vendored Jest at $JEST_BIN; offline test image was not prepared." >&2
+  exit 1
+fi
+
+exec node "$JEST_BIN" /workspace/repo/usercase-test-coderl/max_hardware_usage.test.js --runInBand --watchman=false --verbose --coverage=false
