+	if adapter.sent[0].Destination() != "help-room" {
+		t.Fatalf("output destination = %#v, want %#v", adapter.sent[0].Destination(), "help-room")
+	}
+	got := collectHelps(t, adapter.sent[0].Content())
+	want := []helpRow{
+		{Identifier: "alpha", Instruction: "alpha usage"},
+		{Identifier: "gamma", Instruction: "gamma usage"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("helps = %#v, want %#v", got, want)
+	}
+}
