+func TestRespondAbortDeletesContextWithoutInvokingNextStepAndIsIdempotent(t *testing.T) {
+
+
+	adapter := &recordingAdapter{}
+	storage := newRecordingStorage()
+	var invoked int
+	storage.contexts["same"] = func(context.Context, sarah.Input) (*sarah.CommandResponse, error) {
+		invoked++
+		return &sarah.CommandResponse{Content: "unexpected"}, nil
+	}
+	bot := sarah.NewBot(adapter, sarah.BotWithStorage(storage))
+
+	firstErr := bot.Respond(context.Background(), sarah.NewAbortInput(testInput{sender: "same", msg: "abort", reply: "r1"}))
+	secondErr := bot.Respond(context.Background(), sarah.NewAbortInput(testInput{sender: "same", msg: "abort again", reply: "r2"}))
+	if firstErr != nil {
+		t.Fatalf("first abort error = %v, want nil", firstErr)
+	}
+	if secondErr != nil {
+		t.Fatalf("second abort error = %v, want nil", secondErr)
+	}
+	if invoked != 0 {
+		t.Fatalf("stored next invocations = %d, want 0", invoked)
+	}
+	if len(adapter.sent) != 0 {
+		t.Fatalf("sent outputs = %d, want 0", len(adapter.sent))
+	}
+
+	if storage.activeContexts() != 0 {
+		t.Fatalf("storage active contexts after repeated abort = %d, want 0", storage.activeContexts())
+	}
+}
