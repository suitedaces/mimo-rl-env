+func TestCommandsDispatchHelpersUseFirstMatchAndAggregateHelp(t *testing.T) {
+
+
+	ctx := context.Background()
+	commands := sarah.NewCommands()
+	alpha := &scriptedCommand{
+		id:          "alpha",
+		instruction: "alpha usage",
+		match: func(input sarah.Input) bool {
+			return input.Message() == "go"
+		},
+		execute: func(context.Context, sarah.Input) (*sarah.CommandResponse, error) {
+			return &sarah.CommandResponse{Content: "alpha result"}, nil
+		},
+	}
+	beta := &scriptedCommand{
+		id:          "beta",
+		instruction: "",
+		match: func(input sarah.Input) bool {
+			return input.Message() == "go"
+		},
+		execute: func(context.Context, sarah.Input) (*sarah.CommandResponse, error) {
+			return &sarah.CommandResponse{Content: "beta result"}, nil
+		},
+	}
+	gamma := &scriptedCommand{
+		id:          "gamma",
+		instruction: "gamma usage",
+		match: func(sarah.Input) bool {
+			return false
+		},
+		execute: func(context.Context, sarah.Input) (*sarah.CommandResponse, error) {
+			return &sarah.CommandResponse{Content: "gamma result"}, nil
+		},
+	}
+	commands.Append(alpha)
+	commands.Append(beta)
+	commands.Append(gamma)
+
+	matched := commands.FindFirstMatched(testInput{sender: "sender", msg: "go", reply: "room"})
+	if matched == nil {
+		t.Fatal("FindFirstMatched returned nil, want command alpha")
+	}
+	if matched.Identifier() != "alpha" {
+		t.Fatalf("matched identifier = %#v, want %#v", matched.Identifier(), "alpha")
+	}
+	if commands.FindFirstMatched(testInput{sender: "sender", msg: "stop", reply: "room"}) != nil {
+		t.Fatal("FindFirstMatched no-match result is non-nil, want nil")
+	}
+
+	response, err := commands.ExecuteFirstMatched(ctx, testInput{sender: "sender", msg: "go", reply: "room"})
+	if err != nil {
+		t.Fatalf("ExecuteFirstMatched error = %v, want nil", err)
+	}
+	if response == nil {
+		t.Fatal("ExecuteFirstMatched response = nil, want alpha response")
+	}
+	if response.Content != "alpha result" {
+		t.Fatalf("ExecuteFirstMatched content = %#v, want %#v", response.Content, "alpha result")
+	}
+	if alpha.execCalls != 1 {
+		t.Fatalf("alpha execute calls = %d, want 1", alpha.execCalls)
+	}
+	if beta.execCalls != 0 {
+		t.Fatalf("beta execute calls = %d, want 0", beta.execCalls)
+	}
+
+	response, err = commands.ExecuteFirstMatched(ctx, testInput{sender: "sender", msg: "stop", reply: "room"})
+	if err != nil {
+		t.Fatalf("ExecuteFirstMatched no-match error = %v, want nil", err)
+	}
+	if response != nil {
+		t.Fatalf("ExecuteFirstMatched no-match response = %#v, want nil", response)
+	}
+
+	got := collectHelps(t, commands.Helps(sarah.NewHelpInput(testInput{sender: "sender", msg: "help", reply: "room"})))
+	want := []helpRow{
+		{Identifier: "alpha", Instruction: "alpha usage"},
+		{Identifier: "gamma", Instruction: "gamma usage"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("helps = %#v, want %#v", got, want)
+	}
+}
+
+func TestCommandsInstancesAreIndependent(t *testing.T) {
+
+
+	a := sarah.NewCommands()
+	b := sarah.NewCommands()
+	a.Append(&scriptedCommand{
+		id: "alpha",
+		match: func(input sarah.Input) bool {
+			return input.Message() == "go"
+		},
+		execute: func(context.Context, sarah.Input) (*sarah.CommandResponse, error) {
+			return &sarah.CommandResponse{Content: "alpha result"}, nil
+		},
+	})
+
+	matchedA := a.FindFirstMatched(testInput{sender: "sender", msg: "go", reply: "room"})
+	matchedB := b.FindFirstMatched(testInput{sender: "sender", msg: "go", reply: "room"})
+	if matchedA == nil {
+		t.Fatal("commands A matched = nil, want alpha")
+	}
+	if matchedA.Identifier() != "alpha" {
+		t.Fatalf("commands A matched identifier = %#v, want %#v", matchedA.Identifier(), "alpha")
+	}
+	if matchedB != nil {
+		t.Fatalf("commands B matched = %#v, want nil", matchedB)
+	}
+}
+
+func TestRespondAbortCleanupLeakFloor(t *testing.T) {
+
+
+
+	for i := 0; i < 150; i++ {
+		adapter := &recordingAdapter{}
+		storage := newRecordingStorage()
+		bot := sarah.NewBot(adapter, sarah.BotWithStorage(storage))
+		bot.AppendCommand(&scriptedCommand{
+			id: "begin",
+			match: func(input sarah.Input) bool {
+				return input.Message() == "begin"
+			},
+			execute: func(context.Context, sarah.Input) (*sarah.CommandResponse, error) {
+				next := func(context.Context, sarah.Input) (*sarah.CommandResponse, error) {
+					return &sarah.CommandResponse{Content: "unused"}, nil
+				}
+				return &sarah.CommandResponse{Content: "start", UserContext: sarah.NewUserContext(next)}, nil
+			},
+		})
+
+		sender := "sender"
+		if err := bot.Respond(context.Background(), testInput{sender: sender, msg: "begin", reply: "room"}); err != nil {
+			t.Fatalf("cycle %d begin error = %v, want nil", i, err)
+		}
+		if err := bot.Respond(context.Background(), sarah.NewAbortInput(testInput{sender: sender, msg: "abort", reply: "room"})); err != nil {
+			t.Fatalf("cycle %d abort error = %v, want nil", i, err)
+		}
+		if storage.activeContexts() != 0 {
+			t.Fatalf("cycle %d active contexts = %d, want 0", i, storage.activeContexts())
+		}
+	}
+
+}
