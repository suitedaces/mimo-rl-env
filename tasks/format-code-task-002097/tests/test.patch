+func TestRespondConversationContextTakesPriorityAndRestoresNextStep(t *testing.T) {
+
+
+	adapter := &recordingAdapter{}
+	storage := newRecordingStorage()
+	bot := sarah.NewBot(adapter, sarah.BotWithStorage(storage))
+
+	var firstNextCalls int
+	var secondNextCalls int
+	command := &scriptedCommand{
+		id: "conversation",
+		match: func(sarah.Input) bool {
+			return true
+		},
+		execute: func(context.Context, sarah.Input) (*sarah.CommandResponse, error) {
+			firstNext := func(_ context.Context, input sarah.Input) (*sarah.CommandResponse, error) {
+				firstNextCalls++
+				secondNext := func(_ context.Context, input sarah.Input) (*sarah.CommandResponse, error) {
+					secondNextCalls++
+					return &sarah.CommandResponse{Content: "again:" + input.Message()}, nil
+				}
+				return &sarah.CommandResponse{
+					Content:     "next:" + input.Message(),
+					UserContext: sarah.NewUserContext(secondNext),
+				}, nil
+			}
+			return &sarah.CommandResponse{
+				Content:     "start",
+				UserContext: sarah.NewUserContext(firstNext),
+			}, nil
+		},
+	}
+	bot.AppendCommand(command)
+
+	err := bot.Respond(context.Background(), testInput{sender: "same", msg: "begin", reply: "r1"})
+	if err != nil {
+		t.Fatalf("first Respond error = %v, want nil", err)
+	}
+	if len(adapter.sent) != 1 {
+		t.Fatalf("sent outputs after first response = %d, want 1", len(adapter.sent))
+	}
+	if adapter.sent[0].Content() != "start" {
+		t.Fatalf("first output content = %#v, want %#v", adapter.sent[0].Content(), "start")
+	}
+	if adapter.sent[0].Destination() != "r1" {
+		t.Fatalf("first output destination = %#v, want %#v", adapter.sent[0].Destination(), "r1")
+	}
+
+	if storage.activeContexts() != 1 {
+		t.Fatalf("storage active contexts after first response = %d, want 1", storage.activeContexts())
+	}
+	matchCallsAfterFirst := command.matchCalls
+
+	err = bot.Respond(context.Background(), testInput{sender: "same", msg: "reply", reply: "r2"})
+	if err != nil {
+		t.Fatalf("second Respond error = %v, want nil", err)
+	}
+	if len(adapter.sent) != 2 {
+		t.Fatalf("sent outputs after second response = %d, want 2", len(adapter.sent))
+	}
+	if adapter.sent[1].Content() != "next:reply" {
+		t.Fatalf("second output content = %#v, want %#v", adapter.sent[1].Content(), "next:reply")
+	}
+	if adapter.sent[1].Destination() != "r2" {
+		t.Fatalf("second output destination = %#v, want %#v", adapter.sent[1].Destination(), "r2")
+	}
+
+	if command.matchCalls != matchCallsAfterFirst {
+		t.Fatalf("command match calls changed during context response from %d to %d", matchCallsAfterFirst, command.matchCalls)
+	}
+	if command.execCalls != 1 {
+		t.Fatalf("command execute calls after context response = %d, want 1", command.execCalls)
+	}
+	if firstNextCalls != 1 || secondNextCalls != 0 {
+		t.Fatalf("next calls after second response = first:%d second:%d, want first:1 second:0", firstNextCalls, secondNextCalls)
+	}
+
+	if storage.activeContexts() != 1 {
+		t.Fatalf("storage active contexts after second response = %d, want 1", storage.activeContexts())
+	}
+
+	err = bot.Respond(context.Background(), testInput{sender: "same", msg: "later", reply: "r3"})
+	if err != nil {
+		t.Fatalf("third Respond error = %v, want nil", err)
+	}
+	if len(adapter.sent) != 3 {
+		t.Fatalf("sent outputs after third response = %d, want 3", len(adapter.sent))
+	}
+	if adapter.sent[2].Content() != "again:later" {
+		t.Fatalf("third output content = %#v, want %#v", adapter.sent[2].Content(), "again:later")
+	}
+	if adapter.sent[2].Destination() != "r3" {
+		t.Fatalf("third output destination = %#v, want %#v", adapter.sent[2].Destination(), "r3")
+	}
+	if firstNextCalls != 1 || secondNextCalls != 1 {
+		t.Fatalf("next calls after third response = first:%d second:%d, want first:1 second:1", firstNextCalls, secondNextCalls)
+	}
+
+	if storage.activeContexts() != 0 {
+		t.Fatalf("storage active contexts after third response = %d, want 0", storage.activeContexts())
+	}
+}
