+func TestRespondDispatchesFirstMatchingCommandAndSendsOutput(t *testing.T) {
+
+
+	ctx := context.Background()
+	adapter := &recordingAdapter{}
+	bot := sarah.NewBot(adapter)
+
+	first := &scriptedCommand{
+		id:          "first",
+		instruction: "first help",
+		match: func(input sarah.Input) bool {
+			return input.Message() == "ping"
+		},
+		execute: func(context.Context, sarah.Input) (*sarah.CommandResponse, error) {
+			return &sarah.CommandResponse{Content: "pong"}, nil
+		},
+	}
+	second := &scriptedCommand{
+		id:          "second",
+		instruction: "second help",
+		match: func(input sarah.Input) bool {
+			return input.Message() == "ping"
+		},
+		execute: func(context.Context, sarah.Input) (*sarah.CommandResponse, error) {
+			return &sarah.CommandResponse{Content: "wrong"}, nil
+		},
+	}
+
+	bot.AppendCommand(first)
+	bot.AppendCommand(second)
+
+	err := bot.Respond(ctx, testInput{sender: "alice", msg: "ping", reply: "room-1"})
+	if err != nil {
+		t.Fatalf("Respond error = %v, want nil", err)
+	}
+	if len(adapter.sent) != 1 {
+		t.Fatalf("sent outputs = %d, want 1", len(adapter.sent))
+	}
+	if adapter.sent[0].Destination() != "room-1" {
+		t.Fatalf("output destination = %#v, want %#v", adapter.sent[0].Destination(), "room-1")
+	}
+	if adapter.sent[0].Content() != "pong" {
+		t.Fatalf("output content = %#v, want %#v", adapter.sent[0].Content(), "pong")
+	}
+
+	if first.matchCalls == 0 {
+		t.Fatalf("first match calls = %d, want at least 1", first.matchCalls)
+	}
+	if first.execCalls != 1 {
+		t.Fatalf("first execute calls = %d, want 1", first.execCalls)
+	}
+
+	if second.execCalls != 0 {
+		t.Fatalf("second execute calls = %d, want 0", second.execCalls)
+	}
+}
