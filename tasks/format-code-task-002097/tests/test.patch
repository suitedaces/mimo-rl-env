+
+
+
+
+
+var (
+	errCommandFailed = errors.New("command failed")
+	errStorageGet    = errors.New("storage get failed")
+	errStorageSet    = errors.New("storage set failed")
+)
+
+type testInput struct {
+	sender string
+	msg    string
+	reply  sarah.OutputDestination
+}
+
+func (i testInput) SenderKey() string {
+	return i.sender
+}
+
+func (i testInput) Message() string {
+	return i.msg
+}
+
+func (i testInput) SentAt() time.Time {
+	return time.Unix(1700000000, 0).UTC()
+}
+
+func (i testInput) ReplyTo() sarah.OutputDestination {
+	return i.reply
+}
+
+type recordingAdapter struct {
+	botType sarah.BotType
+	sent    []sarah.Output
+}
+
+func (a *recordingAdapter) BotType() sarah.BotType {
+	if a.botType == "" {
+		return sarah.BotType("usercase-bot")
+	}
+	return a.botType
+}
+
+func (a *recordingAdapter) Run(context.Context, func(sarah.Input) error, func(error)) {}
+
+func (a *recordingAdapter) SendMessage(_ context.Context, output sarah.Output) {
+	a.sent = append(a.sent, output)
+}
+
+type scriptedCommand struct {
+	id          string
+	instruction string
+	match       func(sarah.Input) bool
+	execute     func(context.Context, sarah.Input) (*sarah.CommandResponse, error)
+	matchCalls  int
+	execCalls   int
+}
+
+func (c *scriptedCommand) Identifier() string {
+	return c.id
+}
+
+func (c *scriptedCommand) Execute(ctx context.Context, input sarah.Input) (*sarah.CommandResponse, error) {
+	c.execCalls++
+	return c.execute(ctx, input)
+}
+
+func (c *scriptedCommand) Instruction(input *sarah.HelpInput) string {
+	return c.instruction
+}
+
+func (c *scriptedCommand) Match(input sarah.Input) bool {
+	c.matchCalls++
+	return c.match(input)
+}
+
+type recordingStorage struct {
+	contexts map[string]sarah.ContextualFunc
+	getErr   error
+	setErr   error
+	gets     int
+	sets     int
+	deletes  int
+}
+
+func newRecordingStorage() *recordingStorage {
+	return &recordingStorage{contexts: map[string]sarah.ContextualFunc{}}
+}
+
+func (s *recordingStorage) Get(key string) (sarah.ContextualFunc, error) {
+	s.gets++
+	if s.getErr != nil {
+		return nil, s.getErr
+	}
+	return s.contexts[key], nil
+}
+
+func (s *recordingStorage) Set(key string, userContext *sarah.UserContext) error {
+	s.sets++
+	if s.setErr != nil {
+		return s.setErr
+	}
+	s.contexts[key] = userContext.Next
+	return nil
+}
+
+func (s *recordingStorage) Delete(key string) error {
+	s.deletes++
+	delete(s.contexts, key)
+	return nil
+}
+
+func (s *recordingStorage) Flush() error {
+	s.contexts = map[string]sarah.ContextualFunc{}
+	return nil
+}
+
+func (s *recordingStorage) activeContexts() int {
+	return len(s.contexts)
+}
+
+type helpRow struct {
+	Identifier  string
+	Instruction string
+}
+
+func collectHelps(t *testing.T, content interface{}) []helpRow {
+	t.Helper()
+
+	helps, ok := content.(*sarah.CommandHelps)
+	if !ok {
+		t.Fatalf("help content type = %T, want *sarah.CommandHelps", content)
+	}
+
+	rows := make([]helpRow, 0, len(*helps))
+	for _, h := range *helps {
+		rows = append(rows, helpRow{
+			Identifier:  h.Identifier,
+			Instruction: h.Instruction,
+		})
+	}
+	return rows
+}
