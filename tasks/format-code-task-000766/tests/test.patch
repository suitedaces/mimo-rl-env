+func TestLoadOrStoreJSONSessionMissingFreshExpiredAndReloadError(t *testing.T) {
+
+
+	c := aw.NewCache(t.TempDir())
+	calls := 0
+	reload := func() (interface{}, error) {
+		calls++
+		if calls == 1 {
+			return repoRecord{Name: "repo-1", Stars: 11}, nil
+		}
+		return repoRecord{Name: "repo-2", Stars: 12}, nil
+	}
+
+	var out repoRecord
+	err := c.LoadOrStoreJSON("payload.json", 0, reload, &out)
+	if err != nil {
+		t.Fatalf("LoadOrStoreJSON missing error = %v, want nil", err)
+	}
+	if out != (repoRecord{Name: "repo-1", Stars: 11}) {
+		t.Fatalf("LoadOrStoreJSON missing decoded = %#v, want %#v", out, repoRecord{Name: "repo-1", Stars: 11})
+	}
+	if calls != 1 {
+		t.Fatalf("LoadOrStoreJSON missing calls = %d, want 1", calls)
+	}
+
+	out = repoRecord{}
+	err = c.LoadOrStoreJSON("payload.json", 0, reload, &out)
+	if err != nil {
+		t.Fatalf("LoadOrStoreJSON fresh error = %v, want nil", err)
+	}
+	if out != (repoRecord{Name: "repo-1", Stars: 11}) {
+		t.Fatalf("LoadOrStoreJSON fresh decoded = %#v, want %#v", out, repoRecord{Name: "repo-1", Stars: 11})
+	}
+	if calls != 1 {
+		t.Fatalf("LoadOrStoreJSON fresh calls = %d, want 1", calls)
+	}
+
+	makeOld(t, filepath.Join(c.Dir, "payload.json"))
+	out = repoRecord{}
+	err = c.LoadOrStoreJSON("payload.json", time.Hour, reload, &out)
+	if err != nil {
+		t.Fatalf("LoadOrStoreJSON expired error = %v, want nil", err)
+	}
+	if out != (repoRecord{Name: "repo-2", Stars: 12}) {
+		t.Fatalf("LoadOrStoreJSON expired decoded = %#v, want %#v", out, repoRecord{Name: "repo-2", Stars: 12})
+	}
+	if calls != 2 {
+		t.Fatalf("LoadOrStoreJSON expired calls = %d, want 2", calls)
+	}
+	raw, err := ioutil.ReadFile(filepath.Join(c.Dir, "payload.json"))
+	if err != nil {
+		t.Fatalf("read payload JSON after expired reload error = %v, want nil", err)
+	}
+
+	assertIndentedRepoJSON(t, raw, repoRecord{Name: "repo-2", Stars: 12})
+
+	makeOld(t, filepath.Join(c.Dir, "payload.json"))
+	reloadFailure := errors.New("boom")
+	reloadErr := func() (interface{}, error) {
+		calls++
+		return nil, reloadFailure
+	}
+	out = repoRecord{}
+	err = c.LoadOrStoreJSON("payload.json", time.Hour, reloadErr, &out)
+
+	if !errors.Is(err, reloadFailure) {
+		t.Fatalf("LoadOrStoreJSON reload-error = %T %[1]v, want error wrapping reload failure", err)
+	}
+	if out != (repoRecord{}) {
+		t.Fatalf("LoadOrStoreJSON reload-error decoded = %#v, want zero value", out)
+	}
+	if calls != 3 {
+		t.Fatalf("LoadOrStoreJSON reload-error calls = %d, want 3", calls)
+	}
+}
