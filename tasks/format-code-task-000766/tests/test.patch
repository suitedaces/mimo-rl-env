+func TestNilDeleteCleanupIsIdempotent(t *testing.T) {
+
+
+	c := aw.NewCache(t.TempDir())
+
+	if err := c.Store("answer.txt", []byte("42")); err != nil {
+		t.Fatalf("Store before cleanup error = %v, want nil", err)
+	}
+	if err := c.Store("answer.txt", nil); err != nil {
+		t.Fatalf("first Store nil cleanup error = %v, want nil", err)
+	}
+	if c.Exists("answer.txt") != false {
+		t.Fatalf("after first Store nil Exists = true, want false")
+	}
+
+	if err := c.Store("answer.txt", []byte("42")); err != nil {
+		t.Fatalf("Store before second cleanup error = %v, want nil", err)
+	}
+	if err := c.Store("answer.txt", nil); err != nil {
+		t.Fatalf("second Store nil cleanup error = %v, want nil", err)
+	}
+	if c.Exists("answer.txt") != false {
+		t.Fatalf("after second Store nil Exists = true, want false")
+	}
+
+	if err := c.StoreJSON("repo.json", repoRecord{Name: "awgo", Stars: 7}); err != nil {
+		t.Fatalf("StoreJSON before cleanup error = %v, want nil", err)
+	}
+	if err := c.StoreJSON("repo.json", nil); err != nil {
+		t.Fatalf("first StoreJSON nil cleanup error = %v, want nil", err)
+	}
+	if c.Exists("repo.json") != false {
+		t.Fatalf("after first StoreJSON nil Exists = true, want false")
+	}
+
+	if err := c.StoreJSON("repo.json", repoRecord{Name: "awgo", Stars: 7}); err != nil {
+		t.Fatalf("StoreJSON before second cleanup error = %v, want nil", err)
+	}
+	if err := c.StoreJSON("repo.json", nil); err != nil {
+		t.Fatalf("second StoreJSON nil cleanup error = %v, want nil", err)
+	}
+	if c.Exists("repo.json") != false {
+		t.Fatalf("after second StoreJSON nil Exists = true, want false")
+	}
+}
