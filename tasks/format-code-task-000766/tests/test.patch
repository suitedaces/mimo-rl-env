+func TestByteCacheSessionStoreLoadDelete(t *testing.T) {
+
+
+	dir := filepath.Join(t.TempDir(), "nested", "cache")
+	c := aw.NewCache(dir)
+
+	if c.Dir != dir {
+		t.Fatalf("Cache.Dir = %q, want %q", c.Dir, dir)
+	}
+	if !isDir(c.Dir) {
+		t.Fatalf("cache directory exists = false, want true")
+	}
+	if c.Exists("answer.txt") != false {
+		t.Fatalf("fresh Exists = true, want false")
+	}
+
+	if c.Expired("answer.txt", time.Hour) != true {
+		t.Fatalf("fresh Expired(1h) = false, want true")
+	}
+
+	data, err := c.Load("answer.txt")
+	if string(data) != "" {
+		t.Fatalf("fresh Load bytes = %q, want empty", string(data))
+	}
+	if !isPathNotExist(err) {
+		t.Fatalf("fresh Load error = %T %[1]v, want missing *os.PathError", err)
+	}
+
+	if err := c.Store("answer.txt", []byte("42")); err != nil {
+		t.Fatalf("Store bytes error = %v, want nil", err)
+	}
+	if c.Exists("answer.txt") != true {
+		t.Fatalf("stored Exists = false, want true")
+	}
+
+	if c.Expired("answer.txt", time.Hour) != false {
+		t.Fatalf("stored Expired(1h) = true, want false")
+	}
+	data, err = c.Load("answer.txt")
+	if err != nil {
+		t.Fatalf("Load stored error = %v, want nil", err)
+	}
+	if string(data) != "42" {
+		t.Fatalf("Load stored bytes = %q, want %q", string(data), "42")
+	}
+	raw, err := ioutil.ReadFile(filepath.Join(c.Dir, "answer.txt"))
+	if err != nil {
+		t.Fatalf("read relative cache file error = %v, want nil", err)
+	}
+	if string(raw) != "42" {
+		t.Fatalf("relative cache file bytes = %q, want %q", string(raw), "42")
+	}
+	age, err := c.Age("answer.txt")
+	if err != nil {
+		t.Fatalf("Age stored error = %v, want nil", err)
+	}
+	if age < 0 {
+		t.Fatalf("Age stored negative = true, want false")
+	}
+
+	if err := c.Store("answer.txt", nil); err != nil {
+		t.Fatalf("Store nil delete error = %v, want nil", err)
+	}
+	if c.Exists("answer.txt") != false {
+		t.Fatalf("deleted Exists = true, want false")
+	}
+
+	if c.Expired("answer.txt", time.Hour) != true {
+		t.Fatalf("deleted Expired(1h) = false, want true")
+	}
+	data, err = c.Load("answer.txt")
+	if string(data) != "" {
+		t.Fatalf("deleted Load bytes = %q, want empty", string(data))
+	}
+	if !isPathNotExist(err) {
+		t.Fatalf("deleted Load error = %T %[1]v, want missing *os.PathError", err)
+	}
+}
