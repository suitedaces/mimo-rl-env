+func TestLoadOrStoreByteSessionMissingFreshExpiredAndReloadError(t *testing.T) {
+
+
+	c := aw.NewCache(t.TempDir())
+	calls := 0
+	reload := func() ([]byte, error) {
+		calls++
+		if calls == 1 {
+			return []byte("payload-1"), nil
+		}
+		return []byte("payload-2"), nil
+	}
+
+	data, err := c.LoadOrStore("payload.bin", 0, reload)
+	if err != nil {
+		t.Fatalf("LoadOrStore missing error = %v, want nil", err)
+	}
+	if string(data) != "payload-1" {
+		t.Fatalf("LoadOrStore missing bytes = %q, want %q", string(data), "payload-1")
+	}
+	if calls != 1 {
+		t.Fatalf("LoadOrStore missing calls = %d, want 1", calls)
+	}
+	if c.Exists("payload.bin") != true {
+		t.Fatalf("LoadOrStore missing Exists = false, want true")
+	}
+
+	data, err = c.LoadOrStore("payload.bin", 0, reload)
+	if err != nil {
+		t.Fatalf("LoadOrStore fresh error = %v, want nil", err)
+	}
+	if string(data) != "payload-1" {
+		t.Fatalf("LoadOrStore fresh bytes = %q, want %q", string(data), "payload-1")
+	}
+	if calls != 1 {
+		t.Fatalf("LoadOrStore fresh calls = %d, want 1", calls)
+	}
+
+	makeOld(t, filepath.Join(c.Dir, "payload.bin"))
+	if c.Expired("payload.bin", time.Hour) != true {
+		t.Fatalf("old payload Expired(1h) = false, want true")
+	}
+	data, err = c.LoadOrStore("payload.bin", time.Hour, reload)
+	if err != nil {
+		t.Fatalf("LoadOrStore expired error = %v, want nil", err)
+	}
+	if string(data) != "payload-2" {
+		t.Fatalf("LoadOrStore expired bytes = %q, want %q", string(data), "payload-2")
+	}
+	if calls != 2 {
+		t.Fatalf("LoadOrStore expired calls = %d, want 2", calls)
+	}
+
+	makeOld(t, filepath.Join(c.Dir, "payload.bin"))
+	reloadFailure := errors.New("boom")
+	reloadErr := func() ([]byte, error) {
+		calls++
+		return nil, reloadFailure
+	}
+	data, err = c.LoadOrStore("payload.bin", time.Hour, reloadErr)
+	if data != nil {
+		t.Fatalf("LoadOrStore reload-error bytes = %q, want nil", string(data))
+	}
+
+	if !errors.Is(err, reloadFailure) {
+		t.Fatalf("LoadOrStore reload-error = %T %[1]v, want error wrapping reload failure", err)
+	}
+	if calls != 3 {
+		t.Fatalf("LoadOrStore reload-error calls = %d, want 3", calls)
+	}
+	data, err = c.Load("payload.bin")
+	if err != nil {
+		t.Fatalf("Load after reload-error error = %v, want nil", err)
+	}
+	if string(data) != "payload-2" {
+		t.Fatalf("Load after reload-error bytes = %q, want %q", string(data), "payload-2")
+	}
+}
