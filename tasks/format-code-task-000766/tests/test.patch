+func TestCacheInstancesHaveIndependentDirectoriesAndState(t *testing.T) {
+
+
+	base := t.TempDir()
+	a := aw.NewCache(filepath.Join(base, "a"))
+	b := aw.NewCache(filepath.Join(base, "b"))
+
+	if err := a.Store("shared.txt", []byte("from-a")); err != nil {
+		t.Fatalf("Store in cache a error = %v, want nil", err)
+	}
+	if a.Exists("shared.txt") != true {
+		t.Fatalf("cache a Exists after a store = false, want true")
+	}
+	if b.Exists("shared.txt") != false {
+		t.Fatalf("cache b Exists after a store = true, want false")
+	}
+
+	if err := b.Store("shared.txt", []byte("from-b")); err != nil {
+		t.Fatalf("Store in cache b error = %v, want nil", err)
+	}
+	adata, err := a.Load("shared.txt")
+	if err != nil {
+		t.Fatalf("Load from cache a error = %v, want nil", err)
+	}
+	if string(adata) != "from-a" {
+		t.Fatalf("Load from cache a = %q, want %q", string(adata), "from-a")
+	}
+	bdata, err := b.Load("shared.txt")
+	if err != nil {
+		t.Fatalf("Load from cache b error = %v, want nil", err)
+	}
+	if string(bdata) != "from-b" {
+		t.Fatalf("Load from cache b = %q, want %q", string(bdata), "from-b")
+	}
+
+	if err := a.Store("shared.txt", nil); err != nil {
+		t.Fatalf("cleanup cache a error = %v, want nil", err)
+	}
+	if a.Exists("shared.txt") != false {
+		t.Fatalf("cache a Exists after a cleanup = true, want false")
+	}
+	if b.Exists("shared.txt") != true {
+		t.Fatalf("cache b Exists after a cleanup = false, want true")
+	}
+}
