+func TestStoreNilCleanupLeakFloorKeepsCacheDirectoryBounded(t *testing.T) {
+
+
+	c := aw.NewCache(t.TempDir())
+
+	if fileCount(t, c.Dir) != 0 {
+		t.Fatalf("initial cache file count = %d, want 0", fileCount(t, c.Dir))
+	}
+	for i := 0; i < 100; i++ {
+		name := "cycle-" + string(rune('A'+(i%26))) + ".bin"
+		if err := c.Store(name, []byte("42")); err != nil {
+			t.Fatalf("cycle %d Store error = %v, want nil", i, err)
+		}
+		if err := c.Store(name, nil); err != nil {
+			t.Fatalf("cycle %d Store nil cleanup error = %v, want nil", i, err)
+		}
+	}
+	if fileCount(t, c.Dir) != 0 {
+		t.Fatalf("cache file count after 100 store/delete cycles = %d, want 0", fileCount(t, c.Dir))
+	}
+}
