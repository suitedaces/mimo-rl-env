+func TestJSONCacheSessionMarshalLoadDeleteAndErrors(t *testing.T) {
+
+
+	c := aw.NewCache(t.TempDir())
+
+	if err := c.StoreJSON("repo.json", repoRecord{Name: "awgo", Stars: 7}); err != nil {
+		t.Fatalf("StoreJSON valid error = %v, want nil", err)
+	}
+	raw, err := ioutil.ReadFile(filepath.Join(c.Dir, "repo.json"))
+	if err != nil {
+		t.Fatalf("read JSON cache file error = %v, want nil", err)
+	}
+
+	assertIndentedRepoJSON(t, raw, repoRecord{Name: "awgo", Stars: 7})
+
+	var out repoRecord
+	if err := c.LoadJSON("repo.json", &out); err != nil {
+		t.Fatalf("LoadJSON valid error = %v, want nil", err)
+	}
+	if out != (repoRecord{Name: "awgo", Stars: 7}) {
+		t.Fatalf("LoadJSON decoded = %#v, want %#v", out, repoRecord{Name: "awgo", Stars: 7})
+	}
+
+	if err := c.StoreJSON("repo.json", nil); err != nil {
+		t.Fatalf("StoreJSON nil delete error = %v, want nil", err)
+	}
+	if c.Exists("repo.json") != false {
+		t.Fatalf("deleted JSON Exists = true, want false")
+	}
+	err = c.LoadJSON("repo.json", &out)
+
+	if err == nil {
+		t.Fatalf("LoadJSON missing error = nil, want non-nil")
+	}
+
+	err = c.StoreJSON("bad.json", unmarshalableRecord{Bad: func() {}})
+
+	if err == nil {
+		t.Fatalf("StoreJSON unmarshalable error = nil, want non-nil")
+	}
+
+	if err := ioutil.WriteFile(filepath.Join(c.Dir, "malformed.json"), []byte("{not json"), 0600); err != nil {
+		t.Fatalf("write malformed JSON fixture error = %v, want nil", err)
+	}
+	err = c.LoadJSON("malformed.json", &out)
+
+	if err == nil {
+		t.Fatalf("LoadJSON malformed error = nil, want non-nil")
+	}
+}
