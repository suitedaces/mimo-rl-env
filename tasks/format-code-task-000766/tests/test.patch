+func assertIndentedRepoJSON(t *testing.T, raw []byte, want repoRecord) {
+	t.Helper()
+	var got repoRecord
+	if err := json.Unmarshal(raw, &got); err != nil {
+		t.Fatalf("stored JSON parse error = %v, want nil", err)
+	}
+	if got != want {
+		t.Fatalf("stored JSON decoded = %#v, want %#v", got, want)
+	}
+	lines := strings.Split(string(raw), "\n")
+	for _, line := range lines[1:] {
+		if strings.HasPrefix(line, " ") || strings.HasPrefix(line, "\t") {
+			return
+		}
+	}
+	t.Fatalf("stored JSON = %q, want indented JSON", string(raw))
+}
+
+func isDir(path string) bool {
+	fi, err := os.Stat(path)
+	return err == nil && fi.IsDir()
+}
+
+func isPathNotExist(err error) bool {
+	var pathErr *os.PathError
+	return errors.As(err, &pathErr) && os.IsNotExist(err)
+}
+
+func makeOld(t *testing.T, path string) {
+	t.Helper()
+	old := time.Now().Add(-2 * time.Hour)
+	if err := os.Chtimes(path, old, old); err != nil {
+		t.Fatalf("make old %s error = %v, want nil", path, err)
+	}
+}
+
+func fileCount(t *testing.T, dir string) int {
+	t.Helper()
+	entries, err := ioutil.ReadDir(dir)
+	if err != nil {
+		t.Fatalf("read cache dir %s error = %v, want nil", dir, err)
+	}
+	count := 0
+	for _, entry := range entries {
+		if !entry.IsDir() {
+			count++
+		}
+	}
+	return count
+}
