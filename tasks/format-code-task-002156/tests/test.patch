diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,46 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+
+dev-switch go 1.24 2>/dev/null || true
+
+
+OS_ROOT=/testbed
+OS_OUTPUT="${OS_ROOT}/_output/local"
+OS_GOPATH="${OS_OUTPUT}/go"
+OS_GO_PACKAGE="github.com/openshift/origin"
+
+mkdir -p "${OS_GOPATH}/src/github.com/openshift"
+ln -sf "${OS_ROOT}" "${OS_GOPATH}/src/${OS_GO_PACKAGE}"
+
+
+
+if [ ! -d /testbed/.build_env/godeps_override/src/github.com/ugorji/go/codec ]; then
+    mkdir -p /testbed/.build_env/godeps_override/src/github.com/ugorji/go/codec
+    cp -r /testbed/Godeps/_workspace/src/github.com/ugorji/go/codec/* \
+          /testbed/.build_env/godeps_override/src/github.com/ugorji/go/codec/
+    sed -i 's|"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789__"|"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"|' \
+          /testbed/.build_env/godeps_override/src/github.com/ugorji/go/codec/gen.go
+fi
+
+export GO111MODULE=off
+export GOPATH="/testbed/.build_env/godeps_override:${OS_GOPATH}:${OS_ROOT}/Godeps/_workspace"
+
+
+PKG="github.com/openshift/origin/pkg/cmd/experimental/syncgroups/groupdetector"
+
+case "${1:-}" in
+  base)
+    go test -count=1 -v -timeout 60s -run '^TestMemberBasedDetectorExists$' "$PKG"
+    ;;
+  new)
+    go test -count=1 -v -timeout 60s -run '^(TestGroupBasedDetectorExists|TestCompoundDetectorExists)$' "$PKG"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
