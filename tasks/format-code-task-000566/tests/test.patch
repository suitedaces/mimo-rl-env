diff --git a/tests/doc_task_test.py b/tests/doc_task_test.py
index b5b348e..f84ba86 100644
--- a/tests/doc_task_test.py
+++ b/tests/doc_task_test.py
@@ -564,3 +564,118 @@ def test_find_model_in_dbt(model_name, path_model, schema_exists):
     path_file, schema = doc_task.find_model_in_dbt(model_name)
     assert path_file == path_model
     assert schema == schema_exists
+
+
+
+
+
+
+
+
+
+
+
+
+def _setup_orchestrate_mocks(doc_task, mocker, content, schema_exists):
+    """Mock the moving parts of ``orchestrate_model_documentation``.
+
+    Only the questionary prompt call (which the user actually sees) and the
+    ``change_model_description`` / ``process_model`` logic remain real.
+    """
+    fake_path = Path("schema.yml")
+    mocker.patch.object(
+        doc_task, "find_model_in_dbt", return_value=(fake_path, schema_exists)
+    )
+    mocker.patch("dbt_sugar.core.task.doc.open_yaml", return_value=content)
+    mocker.patch("dbt_sugar.core.task.doc.save_yaml")
+    mocker.patch.object(doc_task, "document_columns")
+    mocker.patch.object(doc_task, "check_tests")
+    mocker.patch.object(doc_task, "update_model_description_test_tags")
+    mocker.patch.object(doc_task, "update_column_descriptions")
+
+
+def _capture_prompt_message(mocker):
+    """Patch ``questionary.prompt`` and return the mock so we can inspect calls."""
+    return mocker.patch(
+        "questionary.prompt",
+        return_value={
+            "wants_to_document_model": True,
+            "model_description": "Some description",
+        },
+    )
+
+
+def _first_prompt_message(prompt_mock):
+    """Return the ``message`` of the first questionary.prompt call payload."""
+    first_call = prompt_mock.call_args_list[0]
+
+    payload = first_call[0][0]
+    return payload["message"]
+
+
+def test_prompt_for_new_model_when_no_schema_exists(mocker):
+    """First-time documentation (no schema.yml at all) -> 'write a description'."""
+    doc_task = __init_descriptions()
+    _setup_orchestrate_mocks(doc_task, mocker, content=None, schema_exists=False)
+    prompt_mock = _capture_prompt_message(mocker)
+
+    doc_task.orchestrate_model_documentation("schema", "fct_orders", ["col_a"])
+
+    assert (
+        _first_prompt_message(prompt_mock)
+        == "Do you want to write a description for fct_orders"
+    )
+
+
+def test_prompt_for_new_model_when_schema_exists_without_model(mocker):
+    """First-time documentation (schema.yml present but model not in it)."""
+    existing_content = {
+        "version": 2,
+        "models": [
+            {
+                "name": "some_other_model",
+                "description": "Some real description for the other model.",
+                "columns": [],
+            }
+        ],
+    }
+    doc_task = __init_descriptions()
+    _setup_orchestrate_mocks(
+        doc_task, mocker, content=existing_content, schema_exists=True
+    )
+    prompt_mock = _capture_prompt_message(mocker)
+
+    doc_task.orchestrate_model_documentation("schema", "fct_orders", ["col_a"])
+
+    assert (
+        _first_prompt_message(prompt_mock)
+        == "Do you want to write a description for fct_orders"
+    )
+
+
+def test_prompt_for_existing_model_with_real_description(mocker):
+    """Model already in schema.yml with a real description -> 'change'."""
+    existing_content = {
+        "version": 2,
+        "models": [
+            {
+                "name": "fct_orders",
+                "description": "An existing real description.",
+                "columns": [{"name": "col_a", "description": "descriptionA"}],
+            }
+        ],
+    }
+    doc_task = __init_descriptions()
+    _setup_orchestrate_mocks(
+        doc_task, mocker, content=existing_content, schema_exists=True
+    )
+    prompt_mock = _capture_prompt_message(mocker)
+
+    doc_task.orchestrate_model_documentation("schema", "fct_orders", ["col_a"])
+
+    assert (
+        _first_prompt_message(prompt_mock)
+        == "Do you want to change the model description of fct_orders"
+    )
+
+
