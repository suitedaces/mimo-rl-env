diff --git a/geopandas/tests/test_apply_nan_regression.py b/geopandas/tests/test_apply_nan_regression.py
new file mode 100644
index 00000000..4c80b257
--- /dev/null
+++ b/geopandas/tests/test_apply_nan_regression.py
@@ -0,0 +1,95 @@
+
+
+
+
+
+
+import math
+
+import numpy as np
+import pandas as pd
+import pytest
+from shapely.geometry import Point
+
+from geopandas import GeoDataFrame, GeoSeries
+
+
+@pytest.fixture
+def gdf():
+    return GeoDataFrame(
+        {
+            "value1": [1, 2, 3],
+            "value2": [10, 20, 30],
+            "geometry": [Point(0, 0), Point(1, 1), Point(2, 2)],
+        },
+        crs="EPSG:4326",
+    )
+
+
+def test_apply_lambda_returns_float_nan_preserves_nan(gdf):
+
+    result = gdf.apply(lambda x: float("nan"), axis=1)
+
+    assert type(result) is pd.Series
+
+    assert result.dtype != "geometry"
+
+    assert result.iloc[0] is not None
+    assert math.isnan(result.iloc[0])
+    assert result.isna().all()
+
+
+def test_apply_lambda_returns_numpy_nan_preserves_nan(gdf):
+    result = gdf.apply(lambda x: np.nan, axis=1)
+    assert type(result) is pd.Series
+    assert result.dtype != "geometry"
+    assert result.iloc[0] is not None
+    assert math.isnan(result.iloc[0])
+
+
+def test_apply_lambda_returns_all_none_not_geoseries(gdf):
+
+    result = gdf.apply(lambda x: None, axis=1)
+    assert type(result) is pd.Series
+    assert not isinstance(result, GeoSeries)
+    assert result.dtype != "geometry"
+
+    assert result.iloc[0] is None
+    assert result.isna().all()
+
+
+def test_apply_lambda_returns_numeric_value_preserved(gdf):
+
+    result = gdf.apply(lambda x: 1.5, axis=1)
+    assert type(result) is pd.Series
+    assert result.dtype != "geometry"
+    assert result.iloc[0] == 1.5
+
+
+def test_apply_lambda_returns_geometry_still_geoseries(gdf):
+
+    result = gdf.apply(lambda row: row["geometry"], axis=1)
+    assert isinstance(result, GeoSeries)
+    assert result.dtype == "geometry"
+    assert result.iloc[0].equals(Point(0, 0))
+
+
+def test_apply_lambda_returns_string_not_geoseries(gdf):
+
+    result = gdf.apply(lambda x: "a", axis=1)
+    assert type(result) is pd.Series
+    assert result.dtype != "geometry"
+    assert result.iloc[0] == "a"
+
+
+def test_apply_lambda_mixed_geometry_and_none_becomes_geoseries(gdf):
+
+    def f(row):
+        if row["value1"] == 1:
+            return None
+        return row["geometry"]
+
+    result = gdf.apply(f, axis=1)
+    assert isinstance(result, GeoSeries)
+    assert result.iloc[0] is None
+    assert result.iloc[1].equals(Point(1, 1))
