diff --git a/api/krusty/component_test.go b/api/krusty/component_test.go
new file mode 100644
index 000000000..7b0c2ff06
--- /dev/null
+++ b/api/krusty/component_test.go
@@ -0,0 +1,247 @@
+
+
+
+package krusty_test
+
+import (
+	"strings"
+	"testing"
+
+	kusttest_test "sigs.k8s.io/kustomize/api/testutils/kusttest"
+)
+
+
+
+func writeComp(th kusttest_test.Harness, dir string, content string) {
+	th.WriteF(dir+"/kustomization.yaml", `
+apiVersion: kustomize.config.k8s.io/v1alpha1
+kind: Component
+`+content)
+}
+
+
+
+func writeComponentTestBase(th kusttest_test.Harness) {
+	th.WriteK("/app/base", `
+resources:
+- deploy.yaml
+configMapGenerator:
+- name: my-configmap
+  literals:
+  - testValue=1
+  - otherValue=10
+`)
+	th.WriteF("/app/base/deploy.yaml", `
+apiVersion: v1
+kind: Deployment
+metadata:
+  name: storefront
+spec:
+  replicas: 1
+`)
+}
+
+
+
+
+
+func TestComponentBasic(t *testing.T) {
+	th := kusttest_test.MakeHarness(t)
+	writeComponentTestBase(th)
+	writeComp(th, "/app/comp", `
+namePrefix: comp-
+replicas:
+- name: storefront
+  count: 3
+resources:
+- stub.yaml
+configMapGenerator:
+- name: my-configmap
+  behavior: merge
+  literals:
+  - testValue=2
+  - compValue=5
+`)
+	th.WriteF("/app/comp/stub.yaml", `
+apiVersion: v1
+kind: Deployment
+metadata:
+  name: stub
+spec:
+  replicas: 1
+`)
+	th.WriteK("/app/prod", `
+resources:
+- ../base
+- db.yaml
+components:
+- ../comp
+`)
+	th.WriteF("/app/prod/db.yaml", `
+apiVersion: v1
+kind: Deployment
+metadata:
+  name: db
+spec:
+  type: Logical
+`)
+	m := th.Run("/app/prod", th.MakeDefaultOptions())
+	th.AssertActualEqualsExpected(m, `
+apiVersion: v1
+kind: Deployment
+metadata:
+  name: comp-storefront
+spec:
+  replicas: 3
+---
+apiVersion: v1
+data:
+  compValue: "5"
+  otherValue: "10"
+  testValue: "2"
+kind: ConfigMap
+metadata:
+  annotations: {}
+  labels: {}
+  name: comp-my-configmap-ct5bgtbccd
+---
+apiVersion: v1
+kind: Deployment
+metadata:
+  name: comp-db
+spec:
+  type: Logical
+---
+apiVersion: v1
+kind: Deployment
+metadata:
+  name: comp-stub
+spec:
+  replicas: 1
+`)
+}
+
+
+
+
+func TestComponentPatchesPriorResource(t *testing.T) {
+	th := kusttest_test.MakeHarness(t)
+	writeComponentTestBase(th)
+	writeComp(th, "/app/comp", `
+patchesStrategicMerge:
+- patch.yaml
+`)
+	th.WriteF("/app/comp/patch.yaml", `
+apiVersion: v1
+kind: Deployment
+metadata:
+  name: storefront
+spec:
+  replicas: 42
+`)
+	th.WriteK("/app/prod", `
+resources:
+- ../base
+components:
+- ../comp
+`)
+	m := th.Run("/app/prod", th.MakeDefaultOptions())
+	th.AssertActualEqualsExpected(m, `
+apiVersion: v1
+kind: Deployment
+metadata:
+  name: storefront
+spec:
+  replicas: 42
+---
+apiVersion: v1
+data:
+  otherValue: "10"
+  testValue: "1"
+kind: ConfigMap
+metadata:
+  name: my-configmap-7k9t4h74f8
+`)
+}
+
+
+
+func TestComponentsAppliedInOrder(t *testing.T) {
+	th := kusttest_test.MakeHarness(t)
+	writeComponentTestBase(th)
+	writeComp(th, "/app/comp1", `
+configMapGenerator:
+- name: my-configmap
+  behavior: merge
+  literals:
+  - testValue=2
+`)
+	writeComp(th, "/app/comp2", `
+configMapGenerator:
+- name: my-configmap
+  behavior: merge
+  literals:
+  - testValue=3
+`)
+	th.WriteK("/app/prod", `
+resources:
+- ../base
+components:
+- ../comp1
+- ../comp2
+`)
+	m := th.Run("/app/prod", th.MakeDefaultOptions())
+	th.AssertActualEqualsExpected(m, `
+apiVersion: v1
+kind: Deployment
+metadata:
+  name: storefront
+spec:
+  replicas: 1
+---
+apiVersion: v1
+data:
+  otherValue: "10"
+  testValue: "3"
+kind: ConfigMap
+metadata:
+  annotations: {}
+  labels: {}
+  name: my-configmap-mc6kg25g4h
+`)
+}
+
+
+
+func TestComponentRejectedInResources(t *testing.T) {
+	th := kusttest_test.MakeHarness(t)
+	writeComp(th, "/app/comp", `
+namePrefix: comp-
+`)
+	th.WriteK("/app/prod", `
+resources:
+- ../comp
+`)
+	err := th.RunWithErr("/app/prod", th.MakeDefaultOptions())
+	if !strings.Contains(err.Error(), "Component") {
+		t.Fatalf("error should mention the Component kind, got: %v", err)
+	}
+}
+
+
+
+
+func TestNonComponentRejectedInComponents(t *testing.T) {
+	th := kusttest_test.MakeHarness(t)
+	th.WriteK("/app/notcomp", `
+namePrefix: x-
+`)
+	th.WriteK("/app/prod", `
+components:
+- ../notcomp
+`)
+	err := th.RunWithErr("/app/prod", th.MakeDefaultOptions())
+	if !strings.Contains(err.Error(), "Component") {
+		t.Fatalf("error should mention the Component kind, got: %v", err)
+	}
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+
+
+cd /testbed/api
+if grep -q 'sigs.k8s.io/kustomize/kyaml v0.1.11' go.mod; then
+    sed -i 's#sigs.k8s.io/kustomize/kyaml v0.1.11#sigs.k8s.io/kustomize/kyaml v0.1.10#' go.mod
+    grep -v 'kyaml v0.1.11' go.sum > go.sum.tmp && mv go.sum.tmp go.sum
+fi
+export GOFLAGS=-mod=mod
+export GOPROXY=off
+export GOSUMDB=off
+
+REG='TestIssue1251_CompositeDiamond_Failure|TestIssue1251_Patches|TestComplexComposition|TestTargetMustHave|TestBaseMustHave|TestResourceNotFound|TestBasicDiamond'
+NEW='TestComponentBasic|TestComponentPatchesPriorResource|TestComponentsAppliedInOrder|TestComponentRejectedInResources|TestNonComponentRejectedInComponents'
+
+
+go test ./krusty/ -count=1 -run "$REG"
+
+
+go test ./krusty/ -count=1 -run "$NEW"
