@@ -653,3 +653,130 @@ def test_histogram_empty_x():
 
     dp = sherpaplot.DataHistogramPlot()
     assert dp.x is None
+
+
+
+
+
+
+def _fit_for_region_tests():
+    """Run a fit and return (fit, par0, par1) for region projection/uncertainty tests."""
+    data = sherpa.Data1D('testdata', _datax, _datay)
+    g1 = sherpa.Gauss1D('g1')
+    f = sherpa.Fit(data, g1)
+    f.fit()
+    return f, g1.fwhm, g1.ampl
+
+
+def test_reg_proj_min_max_as_tuples_clipping():
+    """Issue #1093: min/max as tuples must not raise TypeError
+    even when values are outside parameter limits (clipping branch)."""
+    f, par0, par1 = _fit_for_region_tests()
+
+
+    par0.min = par0.val - 1.0
+    par0.max = par0.val + 1.0
+    par1.min = par1.val - 0.5
+    par1.max = par1.val + 0.5
+
+    rp = sherpa.RegionProjection()
+    rp.prepare(min=(par0.val - 10.0, par1.val - 10.0),
+               max=(par0.val + 10.0, par1.val + 10.0),
+               nloop=(3, 3))
+    rp.calc(f, par0, par1)
+
+    assert rp.x0 is not None
+    assert rp.x1 is not None
+    assert rp.y is not None
+    assert len(rp.x0) == 9
+    assert len(rp.x1) == 9
+
+
+def test_reg_proj_min_max_as_tuples_in_bounds():
+    """Issue #1093: min/max as tuples in-bounds must not raise TypeError."""
+    f, par0, par1 = _fit_for_region_tests()
+    rp = sherpa.RegionProjection()
+    rp.prepare(min=(par0.val - 2.0, par1.val - 2.0),
+               max=(par0.val + 2.0, par1.val + 2.0),
+               nloop=(3, 3))
+    rp.calc(f, par0, par1)
+    assert rp.x0 is not None
+    assert len(rp.x0) == 9
+
+
+def test_reg_proj_min_max_as_lists():
+    """Preservation: list min/max (the working syntax) must still work."""
+    f, par0, par1 = _fit_for_region_tests()
+    rp = sherpa.RegionProjection()
+    rp.prepare(min=[par0.val - 2.0, par1.val - 2.0],
+               max=[par0.val + 2.0, par1.val + 2.0],
+               nloop=(3, 3))
+    rp.calc(f, par0, par1)
+    assert rp.x0 is not None
+    assert len(rp.x0) == 9
+
+
+def test_reg_proj_tuple_and_list_produce_same_grid():
+    """Coincidental-correctness: tuple input must produce the same x0/x1 grid
+    as list input (catches fixes that secretly change the values)."""
+
+    f1, p0a, p1a = _fit_for_region_tests()
+    rp_tuple = sherpa.RegionProjection()
+    rp_tuple.prepare(min=(p0a.val - 1.5, p1a.val - 1.5),
+                     max=(p0a.val + 1.5, p1a.val + 1.5),
+                     nloop=(4, 4))
+    rp_tuple.calc(f1, p0a, p1a)
+
+
+    f2, p0b, p1b = _fit_for_region_tests()
+    rp_list = sherpa.RegionProjection()
+    rp_list.prepare(min=[p0b.val - 1.5, p1b.val - 1.5],
+                    max=[p0b.val + 1.5, p1b.val + 1.5],
+                    nloop=(4, 4))
+    rp_list.calc(f2, p0b, p1b)
+
+    assert rp_tuple.x0 == pytest.approx(rp_list.x0)
+    assert rp_tuple.x1 == pytest.approx(rp_list.x1)
+    assert rp_tuple.y == pytest.approx(rp_list.y)
+
+
+def test_reg_proj_min_tuple_max_none():
+    """Equivalence class: min tuple + max None must not raise TypeError.
+    Exercises the if-None branch which contains its own item assignment path."""
+    f, par0, par1 = _fit_for_region_tests()
+    rp = sherpa.RegionProjection()
+    rp.prepare(min=(par0.val - 1.0, par1.val - 1.0),
+               max=None,
+               nloop=(3, 3))
+    rp.calc(f, par0, par1)
+    assert rp.x0 is not None
+    assert len(rp.x0) == 9
+
+
+def test_reg_proj_min_none_max_tuple():
+    """Equivalence class: min None + max tuple must not raise TypeError."""
+    f, par0, par1 = _fit_for_region_tests()
+    rp = sherpa.RegionProjection()
+    rp.prepare(min=None,
+               max=(par0.val + 1.0, par1.val + 1.0),
+               nloop=(3, 3))
+    rp.calc(f, par0, par1)
+    assert rp.x0 is not None
+    assert len(rp.x0) == 9
+
+
+def test_reg_unc_min_max_as_tuples_clipping():
+    """Issue #1093: same fix applies to RegionUncertainty.calc."""
+    f, par0, par1 = _fit_for_region_tests()
+    par0.min = par0.val - 1.0
+    par0.max = par0.val + 1.0
+    par1.min = par1.val - 0.5
+    par1.max = par1.val + 0.5
+
+    ru = sherpa.RegionUncertainty()
+    ru.prepare(min=(par0.val - 10.0, par1.val - 10.0),
+               max=(par0.val + 10.0, par1.val + 10.0),
+               nloop=(3, 3))
+    ru.calc(f, par0, par1)
+    assert ru.x0 is not None
+    assert len(ru.x0) == 9
