+def assert_plan_matches_required_fields(plan, expected):
+
+    for key, expected_value in expected.items():
+        assert key in plan
+        if key != "items":
+            assert plan[key] == expected_value
+
+    assert isinstance(plan["items"], list)
+    assert [item["key"] for item in plan["items"]] == EXPECTED_ITEM_ORDER
+    assert len(plan["items"]) == len(expected["items"])
+    for actual_item, expected_item in zip(plan["items"], expected["items"]):
+        for key, expected_value in expected_item.items():
+            assert key in actual_item
+            assert actual_item[key] == expected_value
+
