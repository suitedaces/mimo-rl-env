+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+VENV=/opt/talon-stage4a-venv
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+"$VENV/bin/python" - <<'PY' >/dev/null 2>&1 || true
