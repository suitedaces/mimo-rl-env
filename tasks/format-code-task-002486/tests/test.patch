+def test_referential_transparency_for_same_arguments():
+    left = build_install_plan(
+        browser_name="Firefox",
+        browser_package="firefox",
+        include_browser_install=True,
+        preset_key="standard",
+    )
+    right = build_install_plan(
+        browser_name="Firefox",
+        browser_package="firefox",
+        include_browser_install=True,
+        preset_key="standard",
+    )
+
+    assert left == right
+
+    assert_plan_matches_required_fields(left, EXPECTED_STANDARD_FIREFOX_PLAN)
+
+
+def test_mutating_one_returned_plan_does_not_affect_later_calls():
+    first = build_install_plan()
+    before_mutation = copy.deepcopy(first)
+
+    first["items"][0]["enabled"] = True
+    first["winutil_config"]["WPFTweaks"].append("MutatedByCaller")
+    first["registry_changes"][0]["value"] = 99
+
+
+    assert_plan_matches_required_fields(before_mutation, EXPECTED_STANDARD_NO_BROWSER_PLAN)
+    assert_plan_matches_required_fields(build_install_plan(), EXPECTED_STANDARD_NO_BROWSER_PLAN)
+
+
+def test_no_global_state_across_fresh_python_process():
+    in_process = build_install_plan(
+        browser_name="Firefox",
+        browser_package="firefox",
+        include_browser_install=True,
+        preset_key="standard",
+    )
+    script = """
+import json, sys
+sys.path.insert(0, '/workspace/repo')
+from configuration_components.install_plan import build_install_plan
+plan = build_install_plan(
+    browser_name='Firefox',
+    browser_package='firefox',
+    include_browser_install=True,
+    preset_key='standard',
+)
+sys.stdout.write(json.dumps(plan, sort_keys=True))
+"""
+
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        capture_output=True,
+    )
+    fresh_process = json.loads(completed.stdout)
+
+    assert in_process == fresh_process
+
+    assert_plan_matches_required_fields(in_process, EXPECTED_STANDARD_FIREFOX_PLAN)
+
+
+def test_no_undeclared_cwd_file_writes_or_network(monkeypatch, tmp_path):
+    original_cwd = os.getcwd()
+
+    def fail_socket(*args, **kwargs):
+        raise AssertionError("build_install_plan must not open network sockets")
+
+    monkeypatch.setattr(socket, "socket", fail_socket)
+
+    try:
+        os.chdir(tmp_path)
+        before = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob("*"))
+        plan = build_install_plan()
+        after = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob("*"))
+    finally:
+        os.chdir(original_cwd)
+
+    assert_plan_matches_required_fields(plan, EXPECTED_STANDARD_NO_BROWSER_PLAN)
+    assert before == after == []
+
