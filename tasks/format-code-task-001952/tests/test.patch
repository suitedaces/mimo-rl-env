@@ -0,0 +1,248 @@
+import { generateDefaultValue } from "../schemaUtils";
+import type { JsonSchemaType } from "../jsonUtils";
+
+describe("generateDefaultValue - optional parameter omission", () => {
+  test("omits optional array property when parent does not require it", () => {
+    const parentSchema: JsonSchemaType = {
+      type: "object",
+      required: ["mesh_id"],
+      properties: {
+        mesh_id: { type: "string" },
+        fields_mesh: { type: "array", items: { type: "string" } },
+      },
+    };
+    expect(
+      generateDefaultValue(
+        { type: "array", items: { type: "string" } },
+        "fields_mesh",
+        parentSchema,
+      ),
+    ).toBeUndefined();
+  });
+
+  test("omits a second optional array property (include)", () => {
+    const parentSchema: JsonSchemaType = {
+      type: "object",
+      required: ["mesh_id"],
+      properties: {
+        mesh_id: { type: "string" },
+        include: { type: "array", items: { type: "string" } },
+      },
+    };
+    expect(
+      generateDefaultValue(
+        { type: "array", items: { type: "string" } },
+        "include",
+        parentSchema,
+      ),
+    ).toBeUndefined();
+  });
+
+  test("omits optional integer property (timeout_seconds)", () => {
+    const parentSchema: JsonSchemaType = {
+      type: "object",
+      required: ["mesh_id"],
+      properties: {
+        mesh_id: { type: "string" },
+        timeout_seconds: { type: "integer" },
+      },
+    };
+    expect(
+      generateDefaultValue(
+        { type: "integer" },
+        "timeout_seconds",
+        parentSchema,
+      ),
+    ).toBeUndefined();
+  });
+
+  test("returns empty array for required array property (preservation)", () => {
+    const parentSchema: JsonSchemaType = {
+      type: "object",
+      required: ["tags"],
+      properties: {
+        tags: { type: "array", items: { type: "string" } },
+      },
+    };
+    expect(
+      generateDefaultValue(
+        { type: "array", items: { type: "string" } },
+        "tags",
+        parentSchema,
+      ),
+    ).toEqual([]);
+  });
+
+  test("omits optional object property (no sub-properties)", () => {
+    const parentSchema: JsonSchemaType = {
+      type: "object",
+      required: ["name"],
+      properties: {
+        name: { type: "string" },
+        config: { type: "object" },
+      },
+    };
+    expect(
+      generateDefaultValue({ type: "object" }, "config", parentSchema),
+    ).toBeUndefined();
+  });
+
+  test("returns empty object for required object property with no sub-properties (preservation)", () => {
+    const parentSchema: JsonSchemaType = {
+      type: "object",
+      required: ["config"],
+      properties: {
+        config: { type: "object" },
+      },
+    };
+    expect(
+      generateDefaultValue({ type: "object" }, "config", parentSchema),
+    ).toEqual({});
+  });
+
+  test("omits optional object property whose only sub-properties are themselves optional", () => {
+
+
+    const configSchema: JsonSchemaType = {
+      type: "object",
+      properties: {
+        host: { type: "string" },
+        port: { type: "integer" },
+      },
+    };
+    const parentSchema: JsonSchemaType = {
+      type: "object",
+      required: ["name"],
+      properties: {
+        name: { type: "string" },
+        config: configSchema,
+      },
+    };
+    expect(
+      generateDefaultValue(configSchema, "config", parentSchema),
+    ).toBeUndefined();
+  });
+
+  test("reproduces issue: tool args object omits all optional params", () => {
+
+    const inputSchema: JsonSchemaType = {
+      type: "object",
+      required: ["mesh_id"],
+      properties: {
+        mesh_id: { type: "string" },
+        fields_mesh: { type: "array", items: { type: "string" } },
+        include: { type: "array", items: { type: "string" } },
+        timeout_seconds: { type: "integer" },
+      },
+    };
+
+
+    const entries = Object.entries(inputSchema.properties!).map(
+      ([key, value]) => [
+        key,
+        generateDefaultValue(value as JsonSchemaType, key, inputSchema),
+      ],
+    );
+    const params = Object.fromEntries(entries);
+
+
+
+    const args = Object.fromEntries(
+      Object.entries(params).filter(([, v]) => v !== undefined),
+    );
+
+    expect(args).not.toHaveProperty("fields_mesh");
+    expect(args).not.toHaveProperty("include");
+    expect(args).not.toHaveProperty("timeout_seconds");
+    expect(args).toHaveProperty("mesh_id");
+    expect(args.mesh_id).toBe("");
+  });
+
+  test("nested object: optional nested object inside generated default is dropped", () => {
+
+
+
+    const inputSchema: JsonSchemaType = {
+      type: "object",
+      required: ["user"],
+      properties: {
+        user: {
+          type: "object",
+          required: ["name"],
+          properties: {
+            name: { type: "string" },
+            preferences: { type: "object" },
+            tags: { type: "array", items: { type: "string" } },
+          },
+        },
+      },
+    };
+
+    const result = generateDefaultValue(inputSchema) as Record<string, unknown>;
+    expect(result).toHaveProperty("user");
+    const user = result.user as Record<string, unknown>;
+    expect(user).toHaveProperty("name");
+    expect(user.name).toBe("");
+    expect(user).not.toHaveProperty("preferences");
+    expect(user).not.toHaveProperty("tags");
+  });
+
+  test("required object containing only optional sub-properties is still present (as empty object)", () => {
+
+
+    const parentSchema: JsonSchemaType = {
+      type: "object",
+      required: ["config"],
+      properties: {
+        config: {
+          type: "object",
+          properties: {
+            host: { type: "string" },
+          },
+        },
+      },
+    };
+    expect(
+      generateDefaultValue(
+        parentSchema.properties!.config as JsonSchemaType,
+        "config",
+        parentSchema,
+      ),
+    ).toEqual({});
+  });
+
+  test("required primitive properties still produce empty-string / zero / false defaults (preservation)", () => {
+    const parentSchema: JsonSchemaType = {
+      type: "object",
+      required: ["s", "n", "b"],
+      properties: {
+        s: { type: "string" },
+        n: { type: "number" },
+        b: { type: "boolean" },
+      },
+    };
+    expect(generateDefaultValue({ type: "string" }, "s", parentSchema)).toBe("");
+    expect(generateDefaultValue({ type: "number" }, "n", parentSchema)).toBe(0);
+    expect(generateDefaultValue({ type: "boolean" }, "b", parentSchema)).toBe(
+      false,
+    );
+  });
+
+  test("schema default value still wins for optional array", () => {
+
+    const parentSchema: JsonSchemaType = {
+      type: "object",
+      required: [],
+      properties: {
+        items: { type: "array", default: ["a"] },
+      },
+    };
+    expect(
+      generateDefaultValue(
+        { type: "array", default: ["a"] },
+        "items",
+        parentSchema,
+      ),
+    ).toEqual(["a"]);
+  });
+});
