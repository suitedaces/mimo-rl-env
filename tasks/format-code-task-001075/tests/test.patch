new file mode 100644
index 0000000..31d1c57
--- /dev/null
+++ b/altair/utils/tests/test_plugin_registry_scopes.py
@@ -0,0 +1,91 @@
+import pytest
+
+from altair.utils import PluginRegistry
+
+
+def test_codespec_registry_permanent_activation_and_options():
+    registry = PluginRegistry(entry_point_group='codespec.missing.plugins')
+
+    def affine(value, scale=1, offset=0):
+        return value * scale + offset
+
+    def identity(value):
+        return value
+
+    registry.register('affine', affine)
+    registry.register('identity', identity)
+
+    assert registry.active is None
+    assert registry.options == {}
+
+    activation = registry.enable('affine', scale=2, offset=3)
+    assert hasattr(activation, '__enter__')
+    assert hasattr(activation, '__exit__')
+    assert registry.active == 'affine'
+    assert registry.options == {'scale': 2, 'offset': 3}
+    assert registry.get()(4) == 11
+    assert registry.get()(4, scale=5) == 23
+
+    exposed_options = registry.options
+    exposed_options['scale'] = 100
+    assert registry.options == {'scale': 2, 'offset': 3}
+    assert registry.get()(4) == 11
+
+    registry.enable('identity')
+    assert registry.active == 'identity'
+    assert registry.options == {}
+    assert registry.get() is identity
+
+
+def test_codespec_registry_nested_scopes_restore_exact_state():
+    registry = PluginRegistry(entry_point_group='codespec.missing.plugins')
+
+    def decorate(value, left='<', right='>'):
+        return left + value + right
+
+    registry.register('decorate', decorate)
+    registry.register('upper', lambda value: value.upper())
+    registry.enable('decorate', left='[', right=']')
+
+    with registry.enable('upper'):
+        assert registry.active == 'upper'
+        assert registry.options == {}
+        assert registry.get()('inside') == 'INSIDE'
+
+        with registry.enable(None, left='{', right='}'):
+            assert registry.active == 'upper'
+            assert registry.options == {'left': '{', 'right': '}'}
+
+        assert registry.active == 'upper'
+        assert registry.options == {}
+        assert registry.get()('again') == 'AGAIN'
+
+    assert registry.active == 'decorate'
+    assert registry.options == {'left': '[', 'right': ']'}
+    assert registry.get()('outside') == '[outside]'
+
+
+def test_codespec_registry_exception_and_failed_enable_are_atomic():
+    registry = PluginRegistry(entry_point_group='codespec.missing.plugins')
+    registry.register('base', lambda value, prefix='': prefix + value)
+    registry.register('temporary', lambda value: value.upper())
+    registry.enable('base', prefix='saved:')
+
+    with pytest.raises(RuntimeError, match='scope failed'):
+        with registry.enable('temporary'):
+            assert registry.active == 'temporary'
+            raise RuntimeError('scope failed')
+
+    assert registry.active == 'base'
+    assert registry.options == {'prefix': 'saved:'}
+    assert registry.get()('value') == 'saved:value'
+
+    with pytest.raises(ValueError, match='unknown'):
+        registry.enable('unknown', discarded=True)
+    assert registry.active == 'base'
+    assert registry.options == {'prefix': 'saved:'}
+    assert registry.get()('value') == 'saved:value'
+
+    empty = PluginRegistry(entry_point_group='codespec.missing.plugins')
+    with pytest.raises(ValueError):
+        empty.enable(None, option=True)
diff --git a/altair/vegalite/v2/tests/test_data_transformer_scopes.py b/altair/vegalite/v2/tests/test_data_transformer_scopes.py
