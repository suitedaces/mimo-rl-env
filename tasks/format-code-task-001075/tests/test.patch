index 0000000..7e6012e
--- /dev/null
+++ b/altair/vegalite/v2/tests/test_data_transformer_scopes.py
@@ -0,0 +1,75 @@
+import pandas as pd
+import pytest
+
+import altair.vegalite.v2 as alt
+from altair.vegalite.data import MaxRowsError
+
+
+def test_codespec_transformer_options_reach_chart_serialization():
+    plugin_name = 'codespec_option_transformer'
+    data = pd.DataFrame({'x': [1, 2]})
+
+    def annotate(data, label, multiplier=1):
+        records = data.to_dict(orient='records')
+        return {
+            'values': [dict(row, label=label, x=row['x'] * multiplier)
+                       for row in records]
+        }
+
+    alt.data_transformers.register(plugin_name, annotate)
+    try:
+        with alt.data_transformers.enable(plugin_name,
+                                          label='scoped', multiplier=10):
+            values = alt.Chart(data).mark_point().to_dict()['data']['values']
+            assert values == [
+                {'x': 10, 'label': 'scoped'},
+                {'x': 20, 'label': 'scoped'},
+            ]
+            assert alt.data_transformers.active == plugin_name
+            assert alt.data_transformers.options == {
+                'label': 'scoped', 'multiplier': 10
+            }
+
+        restored = alt.Chart(data).mark_point().to_dict()['data']['values']
+        assert restored == [{'x': 1}, {'x': 2}]
+        assert alt.data_transformers.active == 'default'
+        assert alt.data_transformers.options == {}
+    finally:
+        alt.data_transformers.enable('default')
+        alt.data_transformers.register(plugin_name, None)
+
+
+def test_codespec_default_transformer_honors_limit_and_zero():
+    data = pd.DataFrame({'x': [1, 2, 3]})
+
+    with alt.data_transformers.enable('default', max_rows=3):
+        values = alt.Chart(data).mark_point().to_dict()['data']['values']
+        assert values == [{'x': 1}, {'x': 2}, {'x': 3}]
+
+    with alt.data_transformers.enable('default', max_rows=2):
+        with pytest.raises(MaxRowsError, match='greater than the max of 2'):
+            alt.Chart(data).mark_point().to_dict()
+
+    with alt.data_transformers.enable('default', max_rows=0):
+        empty = pd.DataFrame({'x': []})
+        assert alt.Chart(empty).mark_point().to_dict()['data']['values'] == []
+        with pytest.raises(MaxRowsError, match='greater than the max of 0'):
+            alt.Chart(data.iloc[:1]).mark_point().to_dict()
+
+
+def test_codespec_default_transformer_none_disables_limit_temporarily():
+    oversized = pd.DataFrame({'x': range(5001)})
+
+    with pytest.raises(MaxRowsError):
+        alt.Chart(oversized).mark_point().to_dict()
+
+    with alt.data_transformers.enable('default', max_rows=None):
+        values = alt.Chart(oversized).mark_point().to_dict()['data']['values']
+        assert len(values) == 5001
+        assert values[0] == {'x': 0}
+        assert values[-1] == {'x': 5000}
+
+    assert alt.data_transformers.active == 'default'
+    assert alt.data_transformers.options == {}
+    with pytest.raises(MaxRowsError):
+        alt.Chart(oversized).mark_point().to_dict()
