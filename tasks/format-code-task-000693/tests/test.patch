diff --git a/test/convo/partialinclude.spec.js b/test/convo/partialinclude.spec.js
new file mode 100644
index 0000000..ad5c46d
--- /dev/null
+++ b/test/convo/partialinclude.spec.js
@@ -0,0 +1,122 @@
+const path = require('path')
+const assert = require('chai').assert
+const BotDriver = require('../../').BotDriver
+const Capabilities = require('../../').Capabilities
+
+const echoConnector = ({ queueBotSays }) => {
+  return {
+    UserSays (msg) {
+      const botMsg = { sender: 'bot', sourceData: msg.sourceData, messageText: msg.messageText }
+      queueBotSays(botMsg)
+    }
+  }
+}
+
+const CONVODIR = path.resolve(__dirname, 'convos', 'partialinclude')
+
+describe('convo.partialinclude', function () {
+  beforeEach(async function () {
+    const myCaps = {
+      [Capabilities.PROJECTNAME]: 'convo.partialinclude',
+      [Capabilities.CONTAINERMODE]: echoConnector
+    }
+    this.driver = new BotDriver(myCaps)
+    this.compiler = this.driver.BuildCompiler()
+    this.container = await this.driver.Build()
+    await this.container.Start()
+  })
+  afterEach(async function () {
+    this.container && await this.container.Stop()
+    this.container && await this.container.Clean()
+  })
+
+  it('should expand an included partial convo inline', async function () {
+    this.compiler.ReadScript(path.resolve(CONVODIR, 'single'), 'sub.pconvo.txt')
+    assert.equal(this.compiler.convos.length, 0)
+    this.compiler.ReadScript(path.resolve(CONVODIR, 'single'), 'main.convo.txt')
+    assert.equal(this.compiler.convos.length, 1)
+
+    const transcript = await this.compiler.convos[0].Run(this.container)
+    assert.equal(transcript.steps.length, 4)
+    const messages = transcript.steps.map(s => s.actual.messageText)
+    assert.include(messages, 'start')
+    assert.include(messages, 'fromsub')
+  })
+
+  it('should expand nested partial convos', async function () {
+    this.compiler.ReadScript(path.resolve(CONVODIR, 'nested'), 'deep.pconvo.txt')
+    this.compiler.ReadScript(path.resolve(CONVODIR, 'nested'), 'mid.pconvo.txt')
+    this.compiler.ReadScript(path.resolve(CONVODIR, 'nested'), 'main.convo.txt')
+    assert.equal(this.compiler.convos.length, 1)
+
+    const transcript = await this.compiler.convos[0].Run(this.container)
+    assert.equal(transcript.steps.length, 6)
+    const messages = transcript.steps.map(s => s.actual.messageText)
+    assert.include(messages, 'start')
+    assert.include(messages, 'frommid')
+    assert.include(messages, 'fromdeep')
+  })
+
+  it('should fail running a convo with a circular include', async function () {
+    this.compiler.ReadScript(path.resolve(CONVODIR, 'circular'), 'a.pconvo.txt')
+    this.compiler.ReadScript(path.resolve(CONVODIR, 'circular'), 'b.pconvo.txt')
+    this.compiler.ReadScript(path.resolve(CONVODIR, 'circular'), 'main.convo.txt')
+    assert.equal(this.compiler.convos.length, 1)
+
+    let failed = false
+    try {
+      await this.compiler.convos[0].Run(this.container)
+    } catch (err) {
+      failed = true
+    }
+    assert.isTrue(failed, 'expected the convo run to fail with a circular include')
+  })
+
+  it('should fail running a convo that includes a missing partial convo', async function () {
+    this.compiler.ReadScript(path.resolve(CONVODIR, 'notfound'), 'main.convo.txt')
+    assert.equal(this.compiler.convos.length, 1)
+
+    let failed = false
+    try {
+      await this.compiler.convos[0].Run(this.container)
+    } catch (err) {
+      failed = true
+    }
+    assert.isTrue(failed, 'expected the convo run to fail with a missing partial convo')
+  })
+
+  it('should fail running a convo with an include that has not exactly one argument', async function () {
+    this.compiler.ReadScript(path.resolve(CONVODIR, 'wrongarg'), 'main.convo.txt')
+    assert.equal(this.compiler.convos.length, 1)
+
+    let failed = false
+    try {
+      await this.compiler.convos[0].Run(this.container)
+    } catch (err) {
+      failed = true
+    }
+    assert.isTrue(failed, 'expected the convo run to fail with a wrong include argument')
+  })
+
+  it('should reject duplicate partial convo names', function () {
+    this.compiler.ReadScript(path.resolve(CONVODIR, 'duplicate'), 'first.pconvo.txt')
+
+    let failed = false
+    try {
+      this.compiler.ReadScript(path.resolve(CONVODIR, 'duplicate'), 'second.pconvo.txt')
+    } catch (err) {
+      failed = true
+    }
+    assert.isTrue(failed, 'expected loading a duplicate partial convo name to fail')
+  })
+
+  it('should reject a partial convo with an invalid name', function () {
+    let failed = false
+    try {
+      this.compiler.ReadScript(path.resolve(CONVODIR, 'illegalname'), 'bad.pconvo.txt')
+    } catch (err) {
+      failed = true
+    }
+    assert.isTrue(failed, 'expected loading a partial convo with an invalid name to fail')
+  })
+})
