+#!/bin/bash
+set -euo pipefail
+
+GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off go test -vet=off . ./octetcounting ./nontransparent -run '^(TestCodespecTransportMachineContract|TestParse|TestParserBestEffortOption)$' -count=1
