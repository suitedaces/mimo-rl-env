+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+go test ./pkg/utils/ -run '^(TestAppendIfUnique|TestBuildToken)$' -count=1 -v
+
+
+go test ./pkg/utils/ -run '^(TestPagination.*|TestFilter.*|TestMultipleFiltersAreAllApplied|TestSearch.*|TestGroup.*)$' -count=1 -v
