+    def test_humidity_sensor_device_class(self):
+        """Humidity sensor must expose DEVICE_CLASS_HUMIDITY for HomeKit."""
+        sensor = dyson.DysonHumiditySensor(_get_with_state())
+        sensor.hass = self.hass
+        sensor.entity_id = "sensor.dyson_1"
+        assert sensor.device_class == DEVICE_CLASS_HUMIDITY
+
+    def test_humidity_sensor_device_class_no_state(self):
+        """Humidity sensor device_class is set even without state."""
+        sensor = dyson.DysonHumiditySensor(_get_device_without_state())
+        sensor.hass = self.hass
+        sensor.entity_id = "sensor.dyson_1"
+        assert sensor.device_class == DEVICE_CLASS_HUMIDITY
+
+    def test_temperature_sensor_device_class(self):
+        """Temperature sensor must expose DEVICE_CLASS_TEMPERATURE for HomeKit."""
+        sensor = dyson.DysonTemperatureSensor(_get_with_state(), TEMP_CELSIUS)
+        sensor.hass = self.hass
+        sensor.entity_id = "sensor.dyson_1"
+        assert sensor.device_class == DEVICE_CLASS_TEMPERATURE
+
+    def test_dust_sensor_device_class_none(self):
+        """Dust sensor must not declare a device_class."""
+        sensor = dyson.DysonDustSensor(_get_with_state())
+        sensor.hass = self.hass
+        sensor.entity_id = "sensor.dyson_1"
+        assert sensor.device_class is None
+
+    def test_filter_life_sensor_device_class_none(self):
+        """Filter life sensor must not declare a device_class."""
+        sensor = dyson.DysonFilterLifeSensor(_get_with_state())
+        sensor.hass = self.hass
+        sensor.entity_id = "sensor.dyson_1"
+        assert sensor.device_class is None
+
 
