+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+dev-switch python3 3.12
+pip install -e . --no-build-isolation --break-system-packages -q
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest tests/test_simulation.py -x -v
+    ;;
+  new)
+    python3 -m pytest tests/test_params_py_eval.py tests/test_cli_py_eval.py -x -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
