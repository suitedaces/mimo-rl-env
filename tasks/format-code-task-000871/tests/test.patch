+import os
+from types import SimpleNamespace
+
+import pytest
+
+from elyra.pipeline.airflow.component_parser_airflow import AirflowComponentParser
+from elyra.pipeline.catalog_connector import FilesystemComponentCatalogConnector
+from elyra.pipeline.component_catalog import ComponentCatalog
+
+SYSTEM_PARAMETERS = {"label", "component_source", "component_description"}
+
+
+def _get_resource_path(filename):
+    root = os.path.realpath(os.path.join(os.getcwd(), os.path.dirname(__file__)))
+    resource_path = os.path.join(root, '..', '..', '..', 'tests/pipeline', 'resources', 'components', filename)
+    return os.path.normpath(resource_path)
+
+
+def _parse_airflow_operator(filename):
+
+    reader = FilesystemComponentCatalogConnector([".py"])
+    path = _get_resource_path(filename)
+    component_definition = reader.read_catalog_entry({"path": path}, {})
+
+    catalog_type = "local-file-catalog"
+    entry = {
+        "component_id": reader.get_unique_component_hash(catalog_type, {"path": path}, ["path"]),
+        "catalog_type": catalog_type,
+        "categories": ["Test"],
+        "component_definition": component_definition,
+        "component_identifier": {"path": path},
+    }
+    component_entry = SimpleNamespace(**entry)
+
+    parser = AirflowComponentParser()
+    component = parser.parse(component_entry)[0]
+    return ComponentCatalog.to_canvas_properties(component), catalog_type, component_entry
+
+
+@pytest.fixture(scope="module")
+def airflow_properties():
+    properties_json, catalog_type, component_entry = _parse_airflow_operator('airflow_test_operator.py')
+    return properties_json
+
+
+def _parameter_info(properties_json, ref):
+    return next(p for p in properties_json['uihints']['parameter_info']
+                if p.get('parameter_ref') == ref)
+
+
+def _operator_param_refs(properties_json):
+    refs = []
+    for p in properties_json['uihints']['parameter_info']:
+        ref = p.get('parameter_ref')
+        if ref and ref.replace('elyra_', '') not in SYSTEM_PARAMETERS and ref not in SYSTEM_PARAMETERS:
+            refs.append(ref)
+    return refs
+
+
+def test_every_operator_parameter_uses_oneof_control(airflow_properties):
+    refs = _operator_param_refs(airflow_properties)
+    assert len(refs) > 0
+    for ref in refs:
+        info = _parameter_info(airflow_properties, ref)
+        assert info['custom_control_id'] == "OneOfControl"
+
+
+def test_operator_parameter_offers_native_and_parent_output_controls(airflow_properties):
+    for ref in _operator_param_refs(airflow_properties):
+        info = _parameter_info(airflow_properties, ref)
+        controls = info['data']['controls']
+
+
+        assert len(controls) == 2
+
+
+        assert "NestedEnumControl" in controls
+        nested = controls["NestedEnumControl"]
+        assert nested['format'] == "inputpath"
+        assert nested['allownooptions'] is False
+
+
+        native_controls = [c for c in controls if c != "NestedEnumControl"]
+        assert len(native_controls) == 1
+
+
+        for control in controls.values():
+            assert isinstance(control['label'], str)
+            assert control['label'].strip() != ""
+
+
+@pytest.mark.parametrize("ref, native_control, data_type", [
+    ("elyra_test_string_no_default", "StringControl", "string"),
+    ("elyra_test_string_default_value", "StringControl", "string"),
+    ("elyra_test_bool_true", "BooleanControl", "boolean"),
+    ("elyra_test_bool_default", "BooleanControl", "boolean"),
+    ("elyra_test_int_non_zero", "NumberControl", "number"),
+    ("elyra_test_int_default", "NumberControl", "number"),
+    ("elyra_test_unusual_type_dict", "StringControl", "dictionary"),
+    ("elyra_test_unusual_type_list", "StringControl", "list"),
+])
+def test_native_control_matches_parameter_type(airflow_properties, ref, native_control, data_type):
+    info = _parameter_info(airflow_properties, ref)
+    controls = info['data']['controls']
+    assert native_control in controls
+    assert controls[native_control]['format'] == data_type
+
+
+@pytest.mark.parametrize("ref, expected_required", [
+
+    ("elyra_test_string_no_default", True),
+    ("elyra_test_bool_default", True),
+    ("elyra_test_int_default", True),
+
+    ("elyra_test_string_default_value", False),
+    ("elyra_test_bool_true", False),
+    ("elyra_test_int_non_zero", False),
+])
+def test_required_reflects_presence_of_default(airflow_properties, ref, expected_required):
+    info = _parameter_info(airflow_properties, ref)
+    assert info['data']['required'] is expected_required
+
+
+@pytest.mark.parametrize("ref, native_control, expected_value", [
+    ("elyra_test_string_no_default", "StringControl", ""),
+    ("elyra_test_string_default_value", "StringControl", "default"),
+    ("elyra_test_bool_default", "BooleanControl", False),
+    ("elyra_test_bool_false", "BooleanControl", False),
+    ("elyra_test_bool_true", "BooleanControl", True),
+    ("elyra_test_int_default", "NumberControl", 0),
+    ("elyra_test_int_zero", "NumberControl", 0),
+    ("elyra_test_int_non_zero", "NumberControl", 1),
+])
+def test_current_parameters_record_active_control_and_default_value(airflow_properties,
+                                                                    ref, native_control, expected_value):
+    entry = airflow_properties['current_parameters'][ref]
+    assert isinstance(entry, dict)
+    assert entry['activeControl'] == native_control
+    assert entry[native_control] == expected_value
+
+    if isinstance(expected_value, bool):
+        assert entry[native_control] is expected_value
+
+
+def test_system_parameters_are_not_wrapped(airflow_properties):
+
+
+    label_info = _parameter_info(airflow_properties, "label")
+    assert label_info['custom_control_id'] != "OneOfControl"
+
+    assert airflow_properties['current_parameters']['label'] == ""
+    assert not isinstance(airflow_properties['current_parameters']['label'], dict)
+    assert isinstance(airflow_properties['current_parameters']['component_source'], str)
+
+
+def test_operator_with_no_inputs_renders_only_system_parameters():
+    properties_json, _, _ = _parse_airflow_operator('airflow_test_operator_no_inputs.py')
+
+    assert len(properties_json['current_parameters'].keys()) == 2
+    assert properties_json['current_parameters']['label'] == ""
+    assert not isinstance(properties_json['current_parameters']['label'], dict)
