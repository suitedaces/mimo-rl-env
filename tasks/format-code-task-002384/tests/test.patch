diff --git a/tests/functions/test_complete.py b/tests/functions/test_complete.py
index 29429c0..eba4dfc 100644
--- a/tests/functions/test_complete.py
+++ b/tests/functions/test_complete.py
@@ -427,3 +427,275 @@ def test_complete_groupby():
     expected = expected.reindex(columns=df.columns)
 
     assert_frame_equal(result, expected)
+
+
+
+
+
+
+
+def _issue_df():
+    """Source DataFrame from the issue example."""
+    return pd.DataFrame(
+        dict(
+            group=(1, 2, 1, 2),
+            item_id=(1, 2, 2, 3),
+            item_name=("a", "a", "b", "b"),
+            value1=(1, np.nan, 3, 4),
+            value2=range(4, 8),
+        )
+    )
+
+
+def test_complete_fill_value_default_unchanged():
+    """
+    Without `fill_value`, behaviour is unchanged: nulls (both pre-existing
+    and newly-introduced) remain NaN.
+    """
+    df = _issue_df()
+    result = df.complete("group", ("item_id", "item_name"), sort=True)
+    expected = pd.DataFrame(
+        {
+            "group": [1, 1, 1, 1, 2, 2, 2, 2],
+            "item_id": [1, 2, 2, 3, 1, 2, 2, 3],
+            "item_name": ["a", "a", "b", "b", "a", "a", "b", "b"],
+            "value1": [1.0, np.nan, 3.0, np.nan, np.nan, np.nan, np.nan, 4.0],
+            "value2": [4.0, np.nan, 6.0, np.nan, np.nan, 5.0, np.nan, 7.0],
+        }
+    )
+    assert_frame_equal(result, expected, check_dtype=False)
+
+
+def test_complete_fill_value_scalar_explicit_true():
+    """
+    Issue example: scalar `fill_value`, `explicit=True` (default).
+    All NaN values are replaced with the fill value, including the
+    pre-existing NaN in `value1` (group=2, item_id=2, item_name=a).
+    """
+    df = _issue_df()
+    result = df.complete(
+        "group",
+        ("item_id", "item_name"),
+        fill_value=0,
+        sort=True,
+        explicit=True,
+    )
+    expected = pd.DataFrame(
+        {
+            "group": [1, 1, 1, 1, 2, 2, 2, 2],
+            "item_id": [1, 2, 2, 3, 1, 2, 2, 3],
+            "item_name": ["a", "a", "b", "b", "a", "a", "b", "b"],
+            "value1": [1, 0, 3, 0, 0, 0, 0, 4],
+            "value2": [4, 0, 6, 0, 0, 5, 0, 7],
+        }
+    )
+    assert_frame_equal(
+        result.reset_index(drop=True),
+        expected,
+        check_dtype=False,
+    )
+
+
+    cell = result.loc[
+        (result["group"] == 2)
+        & (result["item_id"] == 2)
+        & (result["item_name"] == "a"),
+        "value1",
+    ].iloc[0]
+    assert cell == 0
+    assert not pd.isna(cell)
+
+
+def test_complete_fill_value_scalar_explicit_false():
+    """
+    Issue example: scalar `fill_value`, `explicit=False`.
+    Only newly-generated NaN values are filled.
+    The pre-existing NaN in `value1` at (group=2, item_id=2, item_name='a')
+    must remain NaN; `value2` at that row must remain 5 (untouched).
+    """
+    df = _issue_df()
+    result = df.complete(
+        "group",
+        ("item_id", "item_name"),
+        fill_value=0,
+        sort=True,
+        explicit=False,
+    ).reset_index(drop=True)
+
+
+    pre_existing = result.loc[
+        (result["group"] == 2)
+        & (result["item_id"] == 2)
+        & (result["item_name"] == "a"),
+        "value1",
+    ].iloc[0]
+    assert pd.isna(pre_existing)
+
+
+    assert (
+        result.loc[
+            (result["group"] == 1)
+            & (result["item_id"] == 1)
+            & (result["item_name"] == "a"),
+            "value1",
+        ].iloc[0]
+        == 1
+    )
+    assert (
+        result.loc[
+            (result["group"] == 2)
+            & (result["item_id"] == 2)
+            & (result["item_name"] == "a"),
+            "value2",
+        ].iloc[0]
+        == 5
+    )
+
+
+    new_row = result.loc[
+        (result["group"] == 1)
+        & (result["item_id"] == 2)
+        & (result["item_name"] == "a")
+    ]
+    assert float(new_row["value1"].iloc[0]) == 0
+    assert float(new_row["value2"].iloc[0]) == 0
+
+
+def test_complete_fill_value_dict_explicit_true():
+    """
+    Dictionary `fill_value` with `explicit=True`: each column gets its
+    own fill value, and pre-existing NaN values are also filled.
+    Use *different* fill values per column so we know each is used.
+    """
+    df = _issue_df()
+    result = df.complete(
+        "group",
+        ("item_id", "item_name"),
+        fill_value={"value1": 0, "value2": 99},
+        sort=True,
+        explicit=True,
+    ).reset_index(drop=True)
+
+    expected_value1 = [1, 0, 3, 0, 0, 0, 0, 4]
+    expected_value2 = [4, 99, 6, 99, 99, 5, 99, 7]
+    assert list(result["value1"].astype(int)) == expected_value1
+    assert list(result["value2"].astype(int)) == expected_value2
+
+
+    pre_existing = result.loc[
+        (result["group"] == 2)
+        & (result["item_id"] == 2)
+        & (result["item_name"] == "a"),
+        "value1",
+    ].iloc[0]
+    assert pre_existing == 0
+
+
+def test_complete_fill_value_dict_explicit_false():
+    """
+    Dictionary `fill_value` with `explicit=False`: pre-existing NaN is
+    preserved; only newly-introduced NaN is filled with the per-column
+    value. Use *different* values per column so each is verified.
+    """
+    df = _issue_df()
+    result = df.complete(
+        "group",
+        ("item_id", "item_name"),
+        fill_value={"value1": 0, "value2": 99},
+        sort=True,
+        explicit=False,
+    ).reset_index(drop=True)
+
+
+    pre_existing = result.loc[
+        (result["group"] == 2)
+        & (result["item_id"] == 2)
+        & (result["item_name"] == "a"),
+        "value1",
+    ].iloc[0]
+    assert pd.isna(pre_existing)
+
+
+    assert (
+        result.loc[
+            (result["group"] == 2)
+            & (result["item_id"] == 2)
+            & (result["item_name"] == "a"),
+            "value2",
+        ].iloc[0]
+        == 5
+    )
+
+
+    new_row = result.loc[
+        (result["group"] == 1)
+        & (result["item_id"] == 2)
+        & (result["item_name"] == "a")
+    ]
+    assert float(new_row["value1"].iloc[0]) == 0
+    assert float(new_row["value2"].iloc[0]) == 99
+
+
+def test_complete_fill_value_dict_partial_columns():
+    """
+    Dictionary `fill_value` only covers some columns; other columns'
+    NaN stay NaN (independent of `explicit`).
+    """
+    df = _issue_df()
+    result = df.complete(
+        "group",
+        ("item_id", "item_name"),
+        fill_value={"value2": 99},
+        sort=True,
+        explicit=True,
+    ).reset_index(drop=True)
+
+
+    assert int(
+        result.loc[
+            (result["group"] == 1)
+            & (result["item_id"] == 2)
+            & (result["item_name"] == "a"),
+            "value2",
+        ].iloc[0]
+    ) == 99
+
+    assert pd.isna(
+        result.loc[
+            (result["group"] == 1)
+            & (result["item_id"] == 2)
+            & (result["item_name"] == "a"),
+            "value1",
+        ].iloc[0]
+    )
+
+
+def test_complete_fill_value_explicit_default_is_true():
+    """
+    If `explicit` is not passed and `fill_value` is, behaviour matches
+    `explicit=True`: all NaN (including pre-existing) are filled.
+    """
+    df = _issue_df()
+    with_default = df.complete(
+        "group", ("item_id", "item_name"), fill_value=0, sort=True
+    ).reset_index(drop=True)
+    with_explicit_true = df.complete(
+        "group",
+        ("item_id", "item_name"),
+        fill_value=0,
+        sort=True,
+        explicit=True,
+    ).reset_index(drop=True)
+    assert_frame_equal(with_default, with_explicit_true)
+
+
+def test_complete_explicit_bad_type_raises():
+    """`explicit` must be a bool; non-bool raises TypeError."""
+    df = _issue_df()
+    with pytest.raises(TypeError):
+        df.complete(
+            "group",
+            ("item_id", "item_name"),
+            fill_value=0,
+            explicit="yes",
+        )
