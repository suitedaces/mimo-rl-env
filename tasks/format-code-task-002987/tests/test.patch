diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,87 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+set +u
+dev-switch node 20
+set -u
+
+prepare_env() {
+    local key_file="/tmp/webdriverio_4064_fixturea_prepare_key"
+    local log_dir="/tmp/webdriverio_4064_fixturea_logs"
+    local tree_key
+
+    mkdir -p "$log_dir"
+    tree_key="$(git rev-parse HEAD):$(git diff -- packages/webdriverio/src packages/webdriver/src packages/wdio-config/src packages/wdio-logger/src packages/wdio-repl/src package.json packages/webdriverio/package.json | sha256sum | awk '{print $1}')"
+
+    if [ -f "$key_file" ] &&
+        [ "$(cat "$key_file")" = "$tree_key" ] &&
+        [ -d /testbed/node_modules ] &&
+        [ -d /testbed/packages/webdriverio/node_modules ] &&
+        [ -d /testbed/packages/webdriver/node_modules ]; then
+        return
+    fi
+
+    cd /testbed
+    run_quiet "$log_dir/root-npm-install.log" npm install
+
+    cd /testbed/packages/webdriverio
+    run_quiet "$log_dir/webdriverio-npm-install.log" npm install
+
+    cd /testbed/packages/webdriver
+    run_quiet "$log_dir/webdriver-npm-install.log" npm install
+
+    cd /testbed/packages/webdriver
+    run_quiet "$log_dir/webdriver-build.log" npm run build
+
+    rm -rf /testbed/packages/webdriverio/node_modules/webdriver
+    ln -s /testbed/packages/webdriver /testbed/packages/webdriverio/node_modules/webdriver
+
+    cd /testbed/packages/wdio-config
+    run_quiet "$log_dir/wdio-config-build.log" npm run build
+
+    cd /testbed/packages/wdio-logger
+    run_quiet "$log_dir/wdio-logger-build.log" npm run build
+
+    cd /testbed/packages/wdio-repl
+    run_quiet "$log_dir/wdio-repl-build.log" npm run build
+
+    printf '%s\n' "$tree_key" > "$key_file"
+}
+
+run_quiet() {
+    local log_file="$1"
+    shift
+
+    if ! "$@" > "$log_file" 2>&1; then
+        echo "setup command failed: $*"
+        tail -80 "$log_file"
+        return 1
+    fi
+}
+
+
+prepare_env
+
+cd /testbed
+
+case "${1:-}" in
+    base)
+        npx jest --no-coverage \
+            packages/webdriverio/tests/commands/element/addValue.test.js \
+            packages/webdriverio/tests/commands/element/setValue.test.js \
+            --testNamePattern='keeps string addValue behavior unchanged|should set the value clearing|should allow to add value to an input element'
+        ;;
+    new)
+        npx jest --no-coverage \
+            packages/webdriverio/tests/commands/element/addValue.test.js \
+            packages/webdriverio/tests/commands/element/setValue.test.js \
+            --testNamePattern='stringifies numeric values|stringifies an additional non-string value|stringifies another non-string value'
+        ;;
+    *)
+        echo "usage: $0 base|new"
+        exit 2
+        ;;
+esac
