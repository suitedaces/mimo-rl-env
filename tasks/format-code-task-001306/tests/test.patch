+type uploadRecord struct {
+	Method        string
+	Path          string
+	Authorization string
+	ContentType   string
+	Fields        map[string][]string
+	FileField     string
+	FileName      string
+	FileBytes     string
+	FileSize      int
+	FileSHA256    string
+}
+
+type uploadBackend struct {
+	t      *testing.T
+	server *httptest.Server
+
+	mu      sync.Mutex
+	records []uploadRecord
+	uploads map[string]int
+}
+
+func newUploadBackend(t *testing.T) *uploadBackend {
+	t.Helper()
+	b := &uploadBackend{
+		t:       t,
+		uploads: make(map[string]int),
+	}
+	b.server = httptest.NewServer(http.HandlerFunc(b.handle))
+	t.Cleanup(b.server.Close)
+	return b
+}
+
+func (b *uploadBackend) URL() string {
+	return b.server.URL
+}
+
+func (b *uploadBackend) Records() []uploadRecord {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	out := make([]uploadRecord, len(b.records))
+	copy(out, b.records)
+	return out
+}
+
+func (b *uploadBackend) handle(w http.ResponseWriter, r *http.Request) {
+	if r.URL.Path == "/open-apis/auth/v3/tenant_access_token/internal/" || r.URL.Path == "/open-apis/auth/v3/tenant_access_token/internal" {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"code":0,"msg":"ok","tenant_access_token":"`+rootTenantToken+`","expire":7200}`)
+		return
+	}
+
+	if r.URL.Path != "/open-apis/im/v1/images" && r.URL.Path != "/open-apis/im/v1/files" {
+		http.NotFound(w, r)
+		return
+	}
+
+	rec, err := readUploadRecord(r)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	b.mu.Lock()
+	b.records = append(b.records, rec)
+	b.uploads[r.URL.Path]++
+	n := b.uploads[r.URL.Path]
+	b.mu.Unlock()
+
+	w.Header().Set("Content-Type", "application/json")
+	switch r.URL.Path {
+	case "/open-apis/im/v1/images":
+		if n == 1 {
+			_, _ = io.WriteString(w, `{"code":0,"msg":"ok","data":{"image_key":"`+imagePathKey+`"}}`)
+			return
+		}
+		_, _ = io.WriteString(w, `{"code":0,"msg":"ok","data":{"image_key":"`+imageObjectKey+`"}}`)
+	case "/open-apis/im/v1/files":
+		switch n {
+		case 1:
+			_, _ = io.WriteString(w, `{"code":0,"msg":"ok","data":{"file_key":"`+filePathKey+`"}}`)
+		case 2:
+			_, _ = io.WriteString(w, `{"code":0,"msg":"ok","data":{"file_key":"`+fileReaderKey+`"}}`)
+		case 3:
+			_, _ = io.WriteString(w, `{"code":0,"msg":"ok","data":{"file_key":"`+fileMP4Key+`"}}`)
+		default:
+			_, _ = io.WriteString(w, `{"code":0,"msg":"ok","data":{"file_key":"`+fileNoDurationKey+`"}}`)
+		}
+	}
+}
+
+func readUploadRecord(r *http.Request) (uploadRecord, error) {
+	mr, err := r.MultipartReader()
+	if err != nil {
+		return uploadRecord{}, err
+	}
+	rec := uploadRecord{
+		Method:        r.Method,
+		Path:          r.URL.Path,
+		Authorization: r.Header.Get("Authorization"),
+		ContentType:   r.Header.Get("Content-Type"),
+		Fields:        make(map[string][]string),
+	}
+	for {
+		part, err := mr.NextPart()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			return uploadRecord{}, err
+		}
+		name := part.FormName()
+		payload, err := io.ReadAll(part)
+		if err != nil {
+			return uploadRecord{}, err
+		}
+		if filename := part.FileName(); filename != "" {
+			rec.FileField = name
+			rec.FileName = filename
+			rec.FileBytes = string(payload)
+			rec.FileSize = len(payload)
+			sum := sha256.Sum256(payload)
+			rec.FileSHA256 = hex.EncodeToString(sum[:])
+			continue
+		}
+		rec.Fields[name] = append(rec.Fields[name], string(payload))
+	}
+	for k := range rec.Fields {
+		sort.Strings(rec.Fields[k])
+	}
+	return rec, nil
+}
+
+func configuredRootBot(t *testing.T, backend *uploadBackend) *lark.Bot {
+	t.Helper()
+	bot := lark.NewChatBot("acceptance-app", "acceptance-secret")
+	bot.SetDomain(backend.URL())
+	resp, err := bot.GetTenantAccessTokenInternal(true)
+	if err != nil {
+		t.Fatalf("configure root bot tenant token: %v", err)
+	}
+	if resp.TenantAppAccessToken != rootTenantToken {
+		t.Fatalf("root auth token = %q, want %q", resp.TenantAppAccessToken, rootTenantToken)
+	}
+	return bot
+}
+
+func fixturePath(name string) string {
+	return fixtureDir + "/" + name
+}
+
+func assertFields(t *testing.T, got map[string][]string, want map[string][]string) {
+	t.Helper()
+	if !sameStringSlicesMap(got, want) {
+		t.Fatalf("fields = %#v, want %#v", got, want)
+	}
+}
+
+func sameStringSlicesMap(a, b map[string][]string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, av := range a {
+		bv, ok := b[k]
+		if !ok || len(av) != len(bv) {
+			return false
+		}
+		for i := range av {
+			if av[i] != bv[i] {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func assertMultipartContentType(t *testing.T, got string) {
+	t.Helper()
+	if !strings.HasPrefix(got, "multipart/form-data; boundary=") {
+		t.Fatalf("Content-Type = %q, want prefix %q", got, "multipart/form-data; boundary=")
+	}
+	if _, params, err := mime.ParseMediaType(got); err != nil || params["boundary"] == "" {
+		t.Fatalf("Content-Type = %q, parse err = %v, boundary = %q", got, err, params["boundary"])
+	}
+}
+
+func assertNonEmptyFormFilename(t *testing.T, label, got string) {
+	t.Helper()
+
+	if got == "" {
+		t.Fatalf("%s filename is empty, want multipart file part to carry a filename", label)
+	}
+}
+
+func assertJPEGUpload(t *testing.T, label string, payload string, wantBounds image.Rectangle) {
+	t.Helper()
+
+	decoded, err := jpeg.Decode(bytes.NewReader([]byte(payload)))
+	if err != nil {
+		t.Fatalf("%s payload is not decodable JPEG: %v", label, err)
+	}
+	if decoded.Bounds() != wantBounds {
+		t.Fatalf("%s JPEG bounds = %v, want %v", label, decoded.Bounds(), wantBounds)
+	}
+}
+
+func sampleImage() image.Image {
+	img := image.NewRGBA(image.Rect(0, 0, 2, 2))
+	img.Set(0, 0, color.RGBA{R: 255, A: 255})
+	img.Set(1, 0, color.RGBA{G: 255, A: 255})
+	img.Set(0, 1, color.RGBA{B: 255, A: 255})
+	img.Set(1, 1, color.RGBA{R: 255, G: 255, B: 255, A: 255})
+	return img
+}
+
+type tooLargeImage struct{}
+
+func (tooLargeImage) ColorModel() color.Model { return color.RGBAModel }
+func (tooLargeImage) Bounds() image.Rectangle { return image.Rect(0, 0, 1<<16, 1) }
+func (tooLargeImage) At(_, _ int) color.Color { return color.RGBA{} }
+
+type failingReader struct{}
+type readerFailure struct{}
+
+func (readerFailure) Error() string { return "fixture reader copy failure" }
+
+func (failingReader) Read([]byte) (int, error) {
+	return 0, readerFailure{}
+}
