+
+const (
+	fixtureDir        = "/workspace/repo/usercase-test-coderl/fixtures"
+	rootTenantToken   = "root-tenant-token"
+	imagePathKey      = "img-key-path-001"
+	imageObjectKey    = "img-key-object-002"
+	filePathKey       = "file-key-path-001"
+	fileReaderKey     = "file-key-reader-002"
+	fileMP4Key        = "file-key-mp4-003"
+	fileNoDurationKey = "file-key-no-duration-004"
+)
