+func TestUploadInternalCleanupDoesNotLeakFileDescriptorsOrGoroutines(t *testing.T) {
+
+
+	runtime.GC()
+	beforeFDs := countFDs(t)
+	beforeGoroutines := runtime.NumGoroutine()
+
+	backend := newUploadBackend(t)
+	bot := configuredRootBot(t, backend)
+	for i := 0; i < 120; i++ {
+		resp, err := bot.UploadFile(lark.UploadFileRequest{
+			FileType: "stream",
+			FileName: "cycle-" + strconv.Itoa(i) + ".csv",
+			Reader:   strings.NewReader("cycle,ok\n"),
+		})
+		if err != nil {
+			t.Fatalf("cycle %d UploadFile error = %v, want nil", i, err)
+		}
+		wantKey := fileNoDurationKey
+		switch i {
+		case 0:
+			wantKey = filePathKey
+		case 1:
+			wantKey = fileReaderKey
+		case 2:
+			wantKey = fileMP4Key
+		}
+		if resp.Data.FileKey != wantKey {
+			t.Fatalf("cycle %d file key = %q, want %q", i, resp.Data.FileKey, wantKey)
+		}
+	}
+
+	runtime.GC()
+	afterFDs := countFDs(t)
+	afterGoroutines := runtime.NumGoroutine()
+	if afterFDs > beforeFDs+12 {
+		t.Fatalf("fd count after cycles = %d, want <= %d", afterFDs, beforeFDs+12)
+	}
+	if afterGoroutines > beforeGoroutines+12 {
+		t.Fatalf("goroutine count after cycles = %d, want <= %d", afterGoroutines, beforeGoroutines+12)
+	}
+	if len(backend.Records()) != 120 {
+		t.Fatalf("leak floor backend records = %d, want 120", len(backend.Records()))
+	}
+}
+
+func countFDs(t *testing.T) int {
+	t.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		t.Fatalf("read /proc/self/fd: %v", err)
+	}
+	return len(entries)
+}
+
+func TestRootUploadAuthenticatedRequestFailureHasURLPath(t *testing.T) {
+
+
+	bot := lark.NewChatBot("acceptance-app", "acceptance-secret")
+	bot.SetDomain("http://127.0.0.1:1")
+
+	resp, err := bot.UploadFile(lark.UploadFileRequest{
+		FileType: "stream",
+		FileName: "request-fail.csv",
+		Reader:   strings.NewReader("request,fail\n"),
+	})
+	if resp != nil {
+		t.Fatalf("request failure response = %#v, want nil", resp)
+	}
+	var urlErr *url.Error
+	if !errors.As(err, &urlErr) {
+		t.Fatalf("request failure error type = %T, want *url.Error", err)
+	}
+
+	parsed, parseErr := url.Parse(urlErr.URL)
+	if parseErr != nil || parsed.Path != "/open-apis/im/v1/files" {
+		t.Fatalf("request failure URL = %q parseErr=%v, want path %q", urlErr.URL, parseErr, "/open-apis/im/v1/files")
+	}
+}
