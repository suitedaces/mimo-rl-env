+go mod edit -replace=github.com/go-lark/lark/v2=/workspace/repo/v2
+cat > v2_upload_stateful_test.go <<'EOF_GO'
+package fixture_v2_upload_test
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"image"
+	"image/color"
+	"image/jpeg"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+
+	larkv2 "github.com/go-lark/lark/v2"
+)
+
+const (
+	fixtureDir      = "/workspace/repo/usercase-test-coderl/fixtures"
+	v2TenantToken   = "v2-tenant-token"
+	imagePathKey    = "img-key-path-001"
+	imageObjectKey  = "img-key-object-002"
+	filePathKey     = "file-key-path-001"
+)
+
+type uploadRecord struct {
+	Method        string
+	Path          string
+	Authorization string
+	Fields        map[string][]string
+	FileField     string
+	FileName      string
+	FileBytes     string
+	FileSize      int
+	FileSHA256    string
+}
+
+type uploadBackend struct {
+	server *httptest.Server
+	mu      sync.Mutex
+	records []uploadRecord
+	uploads map[string]int
+}
+
+func newUploadBackend(t *testing.T) *uploadBackend {
+	b := &uploadBackend{uploads: make(map[string]int)}
+	b.server = httptest.NewServer(http.HandlerFunc(b.handle))
+	t.Cleanup(b.server.Close)
+	return b
+}
+
+func (b *uploadBackend) handle(w http.ResponseWriter, r *http.Request) {
+	if r.URL.Path != "/open-apis/im/v1/images" && r.URL.Path != "/open-apis/im/v1/files" {
+		http.NotFound(w, r)
+		return
+	}
+	rec, err := readUploadRecord(r)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	b.mu.Lock()
+	b.records = append(b.records, rec)
+	b.uploads[r.URL.Path]++
+	n := b.uploads[r.URL.Path]
+	b.mu.Unlock()
+
+	w.Header().Set("Content-Type", "application/json")
+	if r.URL.Path == "/open-apis/im/v1/images" {
+		if n == 1 {
+			_, _ = io.WriteString(w, `{"code":0,"msg":"ok","data":{"image_key":"`+imagePathKey+`"}}`)
+			return
+		}
+		_, _ = io.WriteString(w, `{"code":0,"msg":"ok","data":{"image_key":"`+imageObjectKey+`"}}`)
+		return
+	}
+	_, _ = io.WriteString(w, `{"code":0,"msg":"ok","data":{"file_key":"`+filePathKey+`"}}`)
+}
+
+func (b *uploadBackend) Records() []uploadRecord {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	out := make([]uploadRecord, len(b.records))
+	copy(out, b.records)
+	return out
+}
+
+func readUploadRecord(r *http.Request) (uploadRecord, error) {
+	mr, err := r.MultipartReader()
+	if err != nil {
+		return uploadRecord{}, err
+	}
+	rec := uploadRecord{
+		Method:        r.Method,
+		Path:          r.URL.Path,
+		Authorization: r.Header.Get("Authorization"),
+		Fields:        make(map[string][]string),
+	}
+	for {
+		part, err := mr.NextPart()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			return uploadRecord{}, err
+		}
+		payload, err := io.ReadAll(part)
+		if err != nil {
+			return uploadRecord{}, err
+		}
+		if filename := part.FileName(); filename != "" {
+			rec.FileField = part.FormName()
+			rec.FileName = filename
+			rec.FileBytes = string(payload)
+			rec.FileSize = len(payload)
+			sum := sha256.Sum256(payload)
+			rec.FileSHA256 = hex.EncodeToString(sum[:])
+			continue
+		}
+		rec.Fields[part.FormName()] = append(rec.Fields[part.FormName()], string(payload))
+	}
+	for k := range rec.Fields {
+		sort.Strings(rec.Fields[k])
+	}
+	return rec, nil
+}
+
+func configuredBot(backend *uploadBackend) *larkv2.Bot {
+	return larkv2.NewChatBot(
+		"acceptance-app",
+		"acceptance-secret",
+		larkv2.WithDomain(backend.server.URL),
+		larkv2.WithTenantAccessToken(larkv2.TenantAccessToken{TenantAccessToken: v2TenantToken}),
+	)
+}
+
+func fixturePath(name string) string {
+	return fixtureDir + "/" + name
+}
+
+func sampleImage() image.Image {
+	img := image.NewRGBA(image.Rect(0, 0, 2, 2))
+	img.Set(0, 0, color.RGBA{R: 255, A: 255})
+	img.Set(1, 0, color.RGBA{G: 255, A: 255})
+	img.Set(0, 1, color.RGBA{B: 255, A: 255})
+	img.Set(1, 1, color.RGBA{R: 255, G: 255, B: 255, A: 255})
+	return img
+}
+
+func sameFields(got map[string][]string, want map[string][]string) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for k, gv := range got {
+		wv, ok := want[k]
+		if !ok || len(gv) != len(wv) {
+			return false
+		}
+		for i := range gv {
+			if gv[i] != wv[i] {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func assertNonEmptyFormFilename(t *testing.T, label, got string) {
+	t.Helper()
+
+	if got == "" {
+		t.Fatalf("%s filename is empty, want multipart file part to carry a filename", label)
+	}
+}
+
+func assertJPEGUpload(t *testing.T, label string, payload string, wantBounds image.Rectangle) {
+	t.Helper()
+
+	decoded, err := jpeg.Decode(bytes.NewReader([]byte(payload)))
+	if err != nil {
+		t.Fatalf("%s payload is not decodable JPEG: %v", label, err)
+	}
+	if decoded.Bounds() != wantBounds {
+		t.Fatalf("%s JPEG bounds = %v, want %v", label, decoded.Bounds(), wantBounds)
+	}
+}
+
+func TestV2UploadMethodsUseContextAndMultipartRequestShape(t *testing.T) {
+
+
+	backend := newUploadBackend(t)
+	bot := configuredBot(backend)
+	ctx := context.Background()
+
+	imageResp, err := bot.UploadImage(ctx, fixturePath("test.jpg"))
+	if err != nil {
+		t.Fatalf("v2 UploadImage error = %v, want nil", err)
+	}
+	if imageResp.Data.ImageKey != imagePathKey {
+		t.Fatalf("v2 UploadImage image key = %q, want %q", imageResp.Data.ImageKey, imagePathKey)
+	}
+
+	objectResp, err := bot.UploadImageObject(ctx, sampleImage())
+	if err != nil {
+		t.Fatalf("v2 UploadImageObject error = %v, want nil", err)
+	}
+	if objectResp.Data.ImageKey != imageObjectKey {
+		t.Fatalf("v2 UploadImageObject image key = %q, want %q", objectResp.Data.ImageKey, imageObjectKey)
+	}
+
+	fileResp, err := bot.UploadFile(ctx, larkv2.UploadFileRequest{
+		FileType: "stream",
+		FileName: "test-data.csv",
+		Reader:   strings.NewReader("Name,Age\nFoo,25\n"),
+	})
+	if err != nil {
+		t.Fatalf("v2 UploadFile reader error = %v, want nil", err)
+	}
+	if fileResp.Data.FileKey != filePathKey {
+		t.Fatalf("v2 UploadFile file key = %q, want %q", fileResp.Data.FileKey, filePathKey)
+	}
+
+	records := backend.Records()
+	if len(records) != 3 {
+		t.Fatalf("v2 upload request count = %d, want 3", len(records))
+	}
+	if records[0].Method != "POST" || records[0].Path != "/open-apis/im/v1/images" {
+		t.Fatalf("v2 image method/path = %s %s, want POST /open-apis/im/v1/images", records[0].Method, records[0].Path)
+	}
+	if records[0].Authorization != "Bearer "+v2TenantToken {
+		t.Fatalf("v2 image Authorization = %q, want %q", records[0].Authorization, "Bearer "+v2TenantToken)
+	}
+	if !sameFields(records[0].Fields, map[string][]string{"image_type": {"message"}}) {
+		t.Fatalf("v2 image fields = %#v, want image_type=message", records[0].Fields)
+	}
+	assertNonEmptyFormFilename(t, "v2 image path upload", records[0].FileName)
+	if records[0].FileBytes != "fixture-upload-image-bytes\n" {
+		t.Fatalf("v2 image bytes = %q, want %q", records[0].FileBytes, "fixture-upload-image-bytes\n")
+	}
+
+	assertNonEmptyFormFilename(t, "v2 image object upload", records[1].FileName)
+	assertJPEGUpload(t, "v2 image object upload", records[1].FileBytes, sampleImage().Bounds())
+	if !sameFields(records[2].Fields, map[string][]string{"file_name": {"test-data.csv"}, "file_type": {"stream"}}) {
+		t.Fatalf("v2 reader fields = %#v, want file_name and file_type", records[2].Fields)
+	}
+	if records[2].FileName != "test-data.csv" || records[2].FileBytes != "Name,Age\nFoo,25\n" {
+		t.Fatalf("v2 reader file name/bytes = %q/%q, want %q/%q", records[2].FileName, records[2].FileBytes, "test-data.csv", "Name,Age\nFoo,25\n")
+	}
+}
+
+func TestV2CanceledContextReturnsNilResponseAndContextCanceled(t *testing.T) {
+
+
+	backend := newUploadBackend(t)
