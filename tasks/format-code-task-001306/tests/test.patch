+	}
+
+	noDurationResp, err := bot.UploadFile(lark.UploadFileRequest{
+		FileType: "mp4",
+		FileName: "zero-duration.mp4",
+		Duration: 0,
+		Reader:   strings.NewReader("zero-mp4-bytes"),
