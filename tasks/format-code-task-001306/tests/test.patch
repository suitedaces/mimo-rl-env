+		t.Fatalf("zero-duration upload file key = %q, want %q", noDurationResp.Data.FileKey, fileMP4Key)
+	}
+
+	records := backend.Records()
+	if len(records) != 3 {
+		t.Fatalf("upload request count = %d, want 3", len(records))
+	}
+	assertFields(t, records[0].Fields, map[string][]string{"file_name": {"test-data.csv"}, "file_type": {"stream"}})
+	if records[0].FileName != "test-data.csv" || records[0].FileBytes != "Name,Age\nFoo,25\n" {
+		t.Fatalf("reader file name/bytes = %q/%q, want %q/%q", records[0].FileName, records[0].FileBytes, "test-data.csv", "Name,Age\nFoo,25\n")
+	}
+	assertFields(t, records[1].Fields, map[string][]string{"duration": {"17"}, "file_name": {"clip.mp4"}, "file_type": {"mp4"}})
+	if records[1].FileName != "clip.mp4" || records[1].FileBytes != "mp4-bytes" {
+		t.Fatalf("mp4 file name/bytes = %q/%q, want %q/%q", records[1].FileName, records[1].FileBytes, "clip.mp4", "mp4-bytes")
+	}
+	assertFields(t, records[2].Fields, map[string][]string{"file_name": {"zero-duration.mp4"}, "file_type": {"mp4"}})
+	if records[2].FileName != "zero-duration.mp4" || records[2].FileBytes != "zero-mp4-bytes" {
+		t.Fatalf("zero-duration file name/bytes = %q/%q, want %q/%q", records[2].FileName, records[2].FileBytes, "zero-duration.mp4", "zero-mp4-bytes")
+	}
+}
