@@ -0,0 +1,157 @@
+import unittest
+
+from pyramid.request import Request
+from pyramid.response import Response
+
+from h import tweens
+from h.util.redirects import Redirect, lookup, parse
+
+
+class RedirectContractTests(unittest.TestCase):
+    def request(self, path, query_string=""):
+        suffix = "?" + query_string if query_string else ""
+        return Request.blank(path + suffix)
+
+    def test_prefix_matches_the_source_path_itself(self):
+        redirect = Redirect("/legacy", "https://new.example/items", True, False)
+        self.assertEqual(
+            lookup([redirect], self.request("/legacy")),
+            "https://new.example/items",
+        )
+
+    def test_prefix_matches_a_path_segment_descendant(self):
+        redirect = Redirect("/legacy", "https://new.example/items", True, False)
+        self.assertEqual(
+            lookup([redirect], self.request("/legacy/article")),
+            "https://new.example/items/article",
+        )
+
+    def test_prefix_does_not_match_a_longer_segment_with_same_text(self):
+        redirect = Redirect("/legacy", "https://new.example/items", True, False)
+        self.assertIsNone(lookup([redirect], self.request("/legacy-archive")))
+
+    def test_prefix_does_not_match_an_unrelated_path(self):
+        redirect = Redirect("/legacy", "https://new.example/items", True, False)
+        self.assertIsNone(lookup([redirect], self.request("/current/article")))
+
+    def test_exact_does_not_match_a_path_with_extra_segments(self):
+        redirect = Redirect("/legacy", "https://new.example/items", False, False)
+        self.assertIsNone(lookup([redirect], self.request("/legacy/article")))
+
+    def test_external_prefix_preserves_query_string(self):
+        redirect = Redirect("/legacy", "https://new.example/items", True, False)
+        self.assertEqual(
+            lookup([redirect], self.request("/legacy/article", "page=2&tag=old")),
+            "https://new.example/items/article?page=2&tag=old",
+        )
+
+    def test_internal_prefix_preserves_query_string(self):
+        redirect = Redirect("/legacy", "items", True, True)
+        request = self.request("/legacy/article", "page=2")
+        request.route_url = lambda route: "https://app.example/" + route
+        self.assertEqual(
+            lookup([redirect], request), "https://app.example/items/article?page=2"
+        )
+
+    def test_exact_redirect_preserves_query_string(self):
+        redirect = Redirect("/legacy", "https://new.example/items", False, False)
+        self.assertEqual(
+            lookup([redirect], self.request("/legacy", "next=%2Fhome")),
+            "https://new.example/items?next=%2Fhome",
+        )
+
+    def test_internal_exact_preserves_query_string(self):
+        redirect = Redirect("/legacy", "items", False, True)
+        request = self.request("/legacy", "next=%2Fhome")
+        request.route_url = lambda route: "https://app.example/" + route
+        self.assertEqual(
+            lookup([redirect], request), "https://app.example/items?next=%2Fhome"
+        )
+
+    def test_query_is_not_added_when_request_has_no_query(self):
+        redirect = Redirect("/legacy", "https://new.example/items?source=old", False, False)
+        self.assertEqual(
+            lookup([redirect], self.request("/legacy")),
+            "https://new.example/items?source=old",
+        )
+
+    def test_query_is_appended_to_destination_query(self):
+        redirect = Redirect("/legacy", "https://new.example/items?source=old", True, False)
+        self.assertEqual(
+            lookup([redirect], self.request("/legacy/article", "page=2")),
+            "https://new.example/items/article?source=old&page=2",
+        )
+
+    def test_query_is_inserted_before_destination_fragment(self):
+        redirect = Redirect("/legacy", "https://new.example/items#section", False, False)
+        self.assertEqual(
+            lookup([redirect], self.request("/legacy", "page=2")),
+            "https://new.example/items?page=2#section",
+        )
+
+    def test_repeated_query_parameters_are_preserved_verbatim(self):
+        redirect = Redirect("/legacy", "https://new.example/items", False, False)
+        self.assertEqual(
+            lookup([redirect], self.request("/legacy", "tag=a&tag=b")),
+            "https://new.example/items?tag=a&tag=b",
+        )
+
+    def test_first_matching_rule_still_has_priority(self):
+        redirects = [
+            Redirect("/legacy", "https://first.example", True, False),
+            Redirect("/legacy/article", "https://second.example", False, False),
+        ]
+        self.assertEqual(
+            lookup(redirects, self.request("/legacy/article", "x=1")),
+            "https://first.example/article?x=1",
+        )
+
+    def test_tween_returns_301_and_does_not_call_handler_for_redirect(self):
+        called = []
+
+        def handler(request):
+            called.append(request)
+            return Response()
+
+        tween = tweens.redirect_tween_factory(
+            handler,
+            registry=None,
+            redirects=[Redirect("/legacy", "https://new.example", True, False)],
+        )
+        response = tween(self.request("/legacy/article", "x=1"))
+        self.assertEqual(response.status_code, 301)
+        self.assertEqual(response.location, "https://new.example/article?x=1")
+        self.assertEqual(called, [])
+
+    def test_tween_passes_non_redirected_request_to_handler(self):
+        called = []
+
+        def handler(request):
+            called.append(request.path)
+            return Response()
+
+        request = self.request("/current", "x=1")
+        tween = tweens.redirect_tween_factory(
+            handler,
+            registry=None,
+            redirects=[Redirect("/legacy", "https://new.example", True, False)],
+        )
+        response = tween(request)
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(called, ["/current"])
+
+    def test_parser_retains_destination_with_query_parameters(self):
+        self.assertEqual(
+            parse(["/legacy exact https://new.example/items?source=old"])[0].dst,
+            "https://new.example/items?source=old",
+        )
+
+    def test_parser_ignores_comments_after_leading_whitespace(self):
+        self.assertEqual(
+            parse(["   # an explanatory comment", "\t", "/legacy exact https://new.example"]),
+            [Redirect("/legacy", "https://new.example", False, False)],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
