diff --git a/tests/kerastuner/engine/hyperparameters_test.py b/tests/kerastuner/engine/hyperparameters_test.py
index 6409576..9b150d5 100644
--- a/tests/kerastuner/engine/hyperparameters_test.py
+++ b/tests/kerastuner/engine/hyperparameters_test.py
@@ -552,3 +552,66 @@ def test_return_default_value_if_not_populated():
         'hp_name',
         ['hp_value', 'hp_value_default'],
         default='hp_value_default') == 'hp_value_default'
+
+
+def test_hp_get_missing_on_empty_raises_key_error():
+
+    hp = hp_module.HyperParameters()
+    with pytest.raises(KeyError, match='does not exist'):
+        hp.get('anything')
+
+
+def test_hp_getitem_missing_on_empty_raises_key_error():
+
+    hp = hp_module.HyperParameters()
+    with pytest.raises(KeyError, match='does not exist'):
+        hp['anything']
+
+
+def test_hp_get_missing_is_not_value_error_on_empty():
+
+    hp = hp_module.HyperParameters()
+    try:
+        hp.get('anything')
+    except KeyError:
+        pass
+    except ValueError:
+        pytest.fail("HyperParameters.get(missing) raised ValueError; "
+                    "expected KeyError")
+    else:
+        pytest.fail("HyperParameters.get(missing) did not raise")
+
+
+def test_hp_get_missing_on_nonempty_raises_key_error():
+
+    hp = hp_module.HyperParameters()
+    hp.Int('a', 0, 10, default=3)
+    hp.Choice('b', [1, 2], default=2)
+    with pytest.raises(KeyError, match='does not exist'):
+        hp.get('missing_name')
+    with pytest.raises(KeyError, match='does not exist'):
+        hp['missing_name']
+
+
+def test_hp_contains_missing_returns_false():
+
+
+    hp = hp_module.HyperParameters()
+    assert ('anything' in hp) is False
+
+    hp.Int('a', 0, 10, default=3)
+    assert ('a' in hp) is True
+    assert ('missing' in hp) is False
+
+
+def test_hp_get_inactive_still_raises_value_error():
+
+
+    hp = hp_module.HyperParameters()
+    hp.Choice('b', [1, 2], default=2)
+    with hp.conditional_scope('b', 1):
+        hp.Float('c', -10, 10, default=3)
+        with pytest.raises(ValueError, match='is currently inactive'):
+            hp.get('c')
+        with pytest.raises(ValueError, match='is currently inactive'):
+            hp['c']
