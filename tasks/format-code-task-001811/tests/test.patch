--- a/locust/test/test_runners.py
+++ b/locust/test/test_runners.py
@@ -1069,6 +1069,79 @@ class TestMasterRunner(LocustTestCase):
                 self.assertEqual(1, len(master.clients))
                 master.quit()
 
+    def test_master_stop_resets_shape_last_state(self):
+
+
+
+        class DummyShape(LoadTestShape):
+            def tick(self):
+                return None
+
+        self.environment.shape_class = DummyShape()
+
+        with mock.patch("locust.rpc.rpc.Server", mocked_rpc()) as server:
+            master = self.get_runner()
+            server.mocked_send(Message("client_ready", None, "fake_client1"))
+
+            master.shape_last_state = (5, 5)
+            master.state = STATE_RUNNING
+            master.stop()
+            self.assertIsNone(
+                master.shape_last_state,
+                "MasterRunner.stop() must reset shape_last_state to None when a shape_class is set",
+            )
+
+    def test_master_restart_shape_after_stop_sends_spawn(self):
+
+
+
+
+
+        class ConstantShape(LoadTestShape):
+            def tick(self):
+                return (1, 1)
+
+        self.environment.shape_class = ConstantShape()
+
+        with mock.patch("locust.rpc.rpc.Server", mocked_rpc()) as server:
+            master = self.get_runner()
+            for i in range(3):
+                server.mocked_send(Message("client_ready", None, "fake_client%i" % i))
+
+
+            master.start_shape()
+            sleep(0.5)
+            spawn_count_first = sum(1 for _, m in server.outbox if m.type == "spawn")
+            self.assertGreater(
+                spawn_count_first, 0,
+                "Expected spawn messages from initial start_shape()",
+            )
+
+            for i in range(3):
+                server.mocked_send(Message("spawning_complete", {"count": 1}, "fake_client%i" % i))
+            sleep(0.1)
+
+
+            master.stop()
+
+
+            sleep(1.5)
+
+
+            server.outbox.clear()
+
+
+
+            master.start_shape()
+            sleep(0.5)
+
+            spawn_count_second = sum(1 for _, m in server.outbox if m.type == "spawn")
+            self.assertGreater(
+                spawn_count_second, 0,
+                "Expected spawn messages after restart: shape_last_state was not reset "
+                "on stop, so shape_worker incorrectly treated the new tick value as unchanged",
+            )
+
 class TestWorkerRunner(LocustTestCase):
     def setUp(self):
         super(TestWorkerRunner, self).setUp()
