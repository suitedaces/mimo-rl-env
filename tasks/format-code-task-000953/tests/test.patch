diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+case "${1:-}" in
+  base)
+    cd /testbed/go
+    go test ./ai -run '^(TestDocumentFromText|TestDocumentJSON)$' -v -count=1
+    go test ./plugins/dotprompt/ ./plugins/localvec/ ./plugins/googleai/ ./plugins/pinecone/ ./plugins/vertexai/ -v -count=1
+    ;;
+  new)
+    cd /testbed/go
+    go test ./ai -run '^(TestGenerateValidatesJSONOutputSchema_(InvalidResponseErrors|ValidResponseSucceeds|DifferentInvalidShapeErrors)|TestNewJSONPartExposesJSONContentFields|TestNewTextPartExposesPlainTextFields|TestPartConstructorsPopulateExportedFields|TestDocumentJSONRoundTripWithExportedFields|TestPartExportedKindConstantsAreUsable)$' -v -count=1
+    ;;
+  *)
+    echo "usage: $0 base|new" >&2
+    exit 2
+    ;;
+esac
