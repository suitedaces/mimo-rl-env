+package ai_test
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+
+	"github.com/firebase/genkit/go/ai"
+)
+
+func TestNewJSONPartExposesJSONContentFields(t *testing.T) {
+	t.Parallel()
+
+	for _, input := range []string{`{"ok":true}`, `[1,2,3]`, `{"nested":{"value":42}}`} {
+		p := ai.NewJSONPart(input)
+		if p.Kind != ai.PartText {
+			t.Fatalf("NewJSONPart(%q).Kind = %v, want %v", input, p.Kind, ai.PartText)
+		}
+		if p.Text != input {
+			t.Fatalf("NewJSONPart(%q).Text = %q, want %q", input, p.Text, input)
+		}
+		if p.ContentType != "application/json" {
+			t.Fatalf("NewJSONPart(%q).ContentType = %q, want application/json", input, p.ContentType)
+		}
+		if !p.IsText() {
+			t.Fatalf("NewJSONPart(%q).IsText() = false, want true", input)
+		}
+	}
+}
+
+func TestNewTextPartExposesPlainTextFields(t *testing.T) {
+	t.Parallel()
+
+	for _, input := range []string{"hello", "another text value", "third text value"} {
+		p := ai.NewTextPart(input)
+		if p.Kind != ai.PartText {
+			t.Fatalf("NewTextPart(%q).Kind = %v, want %v", input, p.Kind, ai.PartText)
+		}
+		if p.Text != input {
+			t.Fatalf("NewTextPart(%q).Text = %q, want %q", input, p.Text, input)
+		}
+		if p.ContentType != "plain/text" {
+			t.Fatalf("NewTextPart(%q).ContentType = %q, want plain/text", input, p.ContentType)
+		}
+		if !p.IsText() {
+			t.Fatalf("NewTextPart(%q).IsText() = false, want true", input)
+		}
+	}
+}
+
+func TestPartConstructorsPopulateExportedFields(t *testing.T) {
+	t.Parallel()
+
+	media := ai.NewMediaPart("image/png", "data:image/png;base64,abc")
+	if media.Kind != ai.PartMedia || media.ContentType != "image/png" || media.Text != "data:image/png;base64,abc" || !media.IsMedia() {
+		t.Fatalf("NewMediaPart populated %+v, want exported media fields and IsMedia true", media)
+	}
+
+	pdf := ai.NewMediaPart("application/pdf", "data:application/pdf;base64,abc")
+	if pdf.Kind != ai.PartMedia || pdf.ContentType != "application/pdf" || pdf.Text != "data:application/pdf;base64,abc" || !pdf.IsMedia() {
+		t.Fatalf("NewMediaPart populated %+v, want exported media fields for another MIME type and IsMedia true", pdf)
+	}
+
+	data := ai.NewDataPart("raw-data")
+	if data.Kind != ai.PartData || data.Text != "raw-data" || !data.IsData() {
+		t.Fatalf("NewDataPart populated %+v, want exported data fields and IsData true", data)
+	}
+
+	toolReq := &ai.ToolRequest{
+		Name:  "lookup",
+		Input: map[string]any{"q": "Ada"},
+	}
+	toolReqPart := ai.NewToolRequestPart(toolReq)
+	if toolReqPart.Kind != ai.PartToolRequest || toolReqPart.ToolRequest != toolReq || !toolReqPart.IsToolRequest() {
+		t.Fatalf("NewToolRequestPart populated %+v, want exported tool request fields and IsToolRequest true", toolReqPart)
+	}
+
+	toolResp := &ai.ToolResponse{
+		Name:   "lookup",
+		Output: map[string]any{"answer": "Lovelace"},
+	}
+	toolRespPart := ai.NewToolResponsePart(toolResp)
+	if toolRespPart.Kind != ai.PartToolResponse || toolRespPart.ToolResponse != toolResp || !toolRespPart.IsToolResponse() {
+		t.Fatalf("NewToolResponsePart populated %+v, want exported tool response fields and IsToolResponse true", toolRespPart)
+	}
+}
+
+func TestDocumentJSONRoundTripWithExportedFields(t *testing.T) {
+	t.Parallel()
+
+	original := ai.Document{
+		Content: []*ai.Part{
+			{Kind: ai.PartMedia, ContentType: "text/plain", Text: "data:,hello"},
+			{Kind: ai.PartData, Text: "opaque-data"},
+			{Kind: ai.PartToolRequest, ToolRequest: &ai.ToolRequest{
+				Name:  "tool1",
+				Input: map[string]any{"arg": "value"},
+			}},
+			{Kind: ai.PartToolResponse, ToolResponse: &ai.ToolResponse{
+				Name:   "tool1",
+				Output: map[string]any{"result": "ok"},
+			}},
+		},
+	}
+
+	b, err := json.Marshal(original)
+	if err != nil {
+		t.Fatalf("json.Marshal(Document) returned error: %v", err)
+	}
+	var roundTripped ai.Document
+	if err := json.Unmarshal(b, &roundTripped); err != nil {
+		t.Fatalf("json.Unmarshal(Document) returned error: %v", err)
+	}
+	if len(roundTripped.Content) != len(original.Content) {
+		t.Fatalf("round-tripped document has %d parts, want %d", len(roundTripped.Content), len(original.Content))
+	}
+	if roundTripped.Content[0].Kind != ai.PartMedia || roundTripped.Content[0].ContentType != "text/plain" || roundTripped.Content[0].Text != "data:,hello" {
+		t.Fatalf("media part after round-trip = %+v", roundTripped.Content[0])
+	}
+	if roundTripped.Content[1].Kind != ai.PartData || roundTripped.Content[1].Text != "opaque-data" {
+		t.Fatalf("data part after round-trip = %+v", roundTripped.Content[1])
+	}
+	if roundTripped.Content[2].Kind != ai.PartToolRequest || !reflect.DeepEqual(roundTripped.Content[2].ToolRequest, original.Content[2].ToolRequest) {
+		t.Fatalf("tool request part after round-trip = %+v, want %+v", roundTripped.Content[2], original.Content[2])
+	}
+	if roundTripped.Content[3].Kind != ai.PartToolResponse || !reflect.DeepEqual(roundTripped.Content[3].ToolResponse, original.Content[3].ToolResponse) {
+		t.Fatalf("tool response part after round-trip = %+v, want %+v", roundTripped.Content[3], original.Content[3])
+	}
+}
+
+func TestPartExportedKindConstantsAreUsable(t *testing.T) {
+	t.Parallel()
+
+	var k ai.PartKind = ai.PartText
+	p := &ai.Part{Kind: k, Text: "constructed with exported fields"}
+	if !p.IsText() {
+		t.Fatalf("Part constructed with exported PartKind/PartText is not text: %+v", p)
+	}
+	if p.Text != "constructed with exported fields" {
+		t.Fatalf("Part.Text = %q, want exported field value", p.Text)
+	}
+}
