diff --git a/go/ai/generator_hidden_test.go b/go/ai/generator_hidden_test.go
new file mode 100644
index 000000000..aebf634af
--- /dev/null
+++ b/go/ai/generator_hidden_test.go
@@ -0,0 +1,139 @@
+package ai_test
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/firebase/genkit/go/ai"
+)
+
+type staticGenerator struct {
+	text string
+}
+
+func (g staticGenerator) Generate(ctx context.Context, req *ai.GenerateRequest, cb func(context.Context, *ai.Candidate) error) (*ai.GenerateResponse, error) {
+	return &ai.GenerateResponse{
+		Request: req,
+		Candidates: []*ai.Candidate{
+			{
+				Message: &ai.Message{
+					Content: []*ai.Part{
+						ai.NewTextPart(g.text),
+					},
+				},
+			},
+		},
+	}, nil
+}
+
+func personOutputRequest() *ai.GenerateRequest {
+	return &ai.GenerateRequest{
+		Output: &ai.GenerateRequestOutput{
+			Format: ai.OutputFormatJSON,
+			Schema: map[string]any{
+				"type":     "object",
+				"required": []string{"name", "age"},
+				"properties": map[string]any{
+					"name": map[string]any{"type": "string"},
+					"age":  map[string]any{"type": "integer"},
+				},
+				"additionalProperties": false,
+			},
+		},
+	}
+}
+
+func TestGenerateValidatesJSONOutputSchema_InvalidResponseErrors(t *testing.T) {
+	t.Parallel()
+
+	req := personOutputRequest()
+	g := staticGenerator{
+		text: `{"name":"Ada","age":"not-an-int"}`,
+	}
+
+	resp, err := ai.Generate(context.Background(), g, req, nil)
+	if err == nil {
+		t.Fatalf("Generate returned nil error for schema-invalid JSON response: %#v", resp)
+	}
+}
+
+func TestGenerateValidatesJSONOutputSchema_ValidResponseSucceeds(t *testing.T) {
+	t.Parallel()
+
+	req := personOutputRequest()
+	g := staticGenerator{
+		text: `{"name":"Ada","age":37}`,
+	}
+
+	resp, err := ai.Generate(context.Background(), g, req, nil)
+	if err != nil {
+		t.Fatalf("Generate returned error for schema-valid JSON response: %v", err)
+	}
+	if resp == nil {
+		t.Fatal("Generate returned nil response for schema-valid JSON response")
+	}
+
+	text, err := resp.Text()
+	if err != nil {
+		t.Fatalf("GenerateResponse.Text() returned error: %v", err)
+	}
+	var got struct {
+		Name string `json:"name"`
+		Age  int    `json:"age"`
+	}
+	if err := json.Unmarshal([]byte(text), &got); err != nil {
+		t.Fatalf("Generate response text is not readable JSON: %v; text=%q", err, text)
+	}
+	if got.Name != "Ada" || got.Age != 37 {
+		t.Fatalf("Generate response JSON = %+v, want name Ada and age 37", got)
+	}
+}
+
+func TestGenerateValidatesJSONOutputSchema_DifferentInvalidShapeErrors(t *testing.T) {
+	t.Parallel()
+
+	req := &ai.GenerateRequest{
+		Output: &ai.GenerateRequestOutput{
+			Format: ai.OutputFormatJSON,
+			Schema: map[string]any{
+				"type":     "object",
+				"required": []string{"status"},
+				"properties": map[string]any{
+					"status": map[string]any{"type": "string"},
+				},
+				"additionalProperties": false,
+			},
+		},
+	}
+	g := staticGenerator{
+		text: `{"status":"ok","debug":true}`,
+	}
+
+	resp, err := ai.Generate(context.Background(), g, req, nil)
+	if err == nil {
+		t.Fatalf("Generate returned nil error for JSON response with disallowed extra field: %#v", resp)
+	}
+
+	req = &ai.GenerateRequest{
+		Output: &ai.GenerateRequestOutput{
+			Format: ai.OutputFormatJSON,
+			Schema: map[string]any{
+				"type":     "object",
+				"required": []string{"count"},
+				"properties": map[string]any{
+					"count": map[string]any{"type": "integer"},
+				},
+				"additionalProperties": false,
+			},
+		},
+	}
+	g = staticGenerator{
+		text: `{"count":"five"}`,
+	}
+
+	resp, err = ai.Generate(context.Background(), g, req, nil)
+	if err == nil {
+		t.Fatalf("Generate returned nil error for another schema-invalid JSON response: %#v", resp)
+	}
+}
