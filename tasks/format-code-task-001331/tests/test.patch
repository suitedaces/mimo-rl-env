+package mat64
+
+import (
+	"math"
+	"testing"
+)
+
+func TestDenseSubInPlaceAliasesBothInputs(t *testing.T) {
+	cases := []struct {
+		r, c int
+		a, b []float64
+	}{
+		{2, 3, []float64{4, -2, 7, 0.5, -8, 3}, []float64{1, 5, -3, -2, 4, 0.25}},
+		{3, 2, []float64{-1.5, 6, 9, -4, 2.25, 8}, []float64{2, -7, 0.5, 3, -1.25, 10}},
+	}
+	for i, tc := range cases {
+		aData := append([]float64(nil), tc.a...)
+		bData := append([]float64(nil), tc.b...)
+		left := NewDense(tc.r, tc.c, append([]float64(nil), aData...))
+		right := NewDense(tc.r, tc.c, append([]float64(nil), bData...))
+		want := denseFromBinary(tc.r, tc.c, aData, bData, func(a, b float64) float64 { return a - b })
+		left.Sub(left, right)
+		assertDenseApprox(t, left, want, 0, "Sub receiver aliasing first input", i)
+
+		leftCopy := NewDense(tc.r, tc.c, append([]float64(nil), aData...))
+		rightAlias := NewDense(tc.r, tc.c, append([]float64(nil), bData...))
+		rightAlias.Sub(leftCopy, rightAlias)
+		assertDenseApprox(t, rightAlias, want, 0, "Sub receiver aliasing second input", i)
+	}
+}
+
+func TestDenseMulElemInPlaceAliasesBothInputs(t *testing.T) {
+	cases := []struct {
+		r, c int
+		a, b []float64
+	}{
+		{2, 3, []float64{2, -3, 0, 4.5, -1.25, 8}, []float64{-5, 6, 7, 0, -2, 0.5}},
+		{3, 2, []float64{-0.5, 10, 3, -6, 2.5, 9}, []float64{4, -0.25, -8, 1.5, 0, -2}},
+	}
+	for i, tc := range cases {
+		aData := append([]float64(nil), tc.a...)
+		bData := append([]float64(nil), tc.b...)
+		left := NewDense(tc.r, tc.c, append([]float64(nil), aData...))
+		right := NewDense(tc.r, tc.c, append([]float64(nil), bData...))
+		want := denseFromBinary(tc.r, tc.c, aData, bData, func(a, b float64) float64 { return a * b })
+		left.MulElem(left, right)
+		assertDenseApprox(t, left, want, 0, "MulElem receiver aliasing first input", i)
+
+		leftCopy := NewDense(tc.r, tc.c, append([]float64(nil), aData...))
+		rightAlias := NewDense(tc.r, tc.c, append([]float64(nil), bData...))
+		rightAlias.MulElem(leftCopy, rightAlias)
+		assertDenseApprox(t, rightAlias, want, 0, "MulElem receiver aliasing second input", i)
+	}
+}
+
+func TestDenseDivElemInPlaceAliasesBothInputs(t *testing.T) {
+	cases := []struct {
+		r, c int
+		a, b []float64
+	}{
+		{2, 3, []float64{12, -9, 0, 7.5, -2, 5}, []float64{3, -1.5, 2, -2.5, 0.5, 4}},
+		{3, 2, []float64{-8, 6.25, 9, -4.5, 2, 15}, []float64{2, -2.5, 0.75, 3, -0.5, 6}},
+	}
+	for i, tc := range cases {
+		aData := append([]float64(nil), tc.a...)
+		bData := append([]float64(nil), tc.b...)
+		left := NewDense(tc.r, tc.c, append([]float64(nil), aData...))
+		right := NewDense(tc.r, tc.c, append([]float64(nil), bData...))
+		want := denseFromBinary(tc.r, tc.c, aData, bData, func(a, b float64) float64 { return a / b })
+		left.DivElem(left, right)
+		assertDenseApprox(t, left, want, 1e-14, "DivElem receiver aliasing first input", i)
+
+		leftCopy := NewDense(tc.r, tc.c, append([]float64(nil), aData...))
+		rightAlias := NewDense(tc.r, tc.c, append([]float64(nil), bData...))
+		rightAlias.DivElem(leftCopy, rightAlias)
+		assertDenseApprox(t, rightAlias, want, 1e-14, "DivElem receiver aliasing second input", i)
+	}
+}
+
+func TestDenseScaleTransposedDenseSource(t *testing.T) {
+	cases := []struct {
+		r, c int
+		f    float64
+		data []float64
+	}{
+		{2, 3, -2, []float64{1, -3, 5, 7.5, 0, -4}},
+		{3, 2, 0.5, []float64{-8, 2, 6, -1.5, 3.25, 9}},
+	}
+	for i, tc := range cases {
+		src := NewDense(tc.r, tc.c, append([]float64(nil), tc.data...))
+		var got Dense
+		got.Scale(tc.f, src.T())
+		if gr, gc := got.Dims(); gr != tc.c || gc != tc.r {
+			t.Fatalf("Scale transposed source case %d dims mismatch: got %dx%d, want %dx%d", i, gr, gc, tc.c, tc.r)
+		}
+		for r := 0; r < tc.c; r++ {
+			for c := 0; c < tc.r; c++ {
+				want := tc.f * src.At(c, r)
+				if got.At(r, c) != want {
+					t.Fatalf("Scale transposed source case %d mismatch at (%d,%d): got %v, want %v", i, r, c, got.At(r, c), want)
+				}
+			}
+		}
+	}
+
+	alias := NewDense(2, 2, []float64{1, 2, 3, 4})
+	alias.Scale(2, alias.T())
+	wantAlias := NewDense(2, 2, []float64{2, 6, 4, 8})
+	assertDenseApprox(t, alias, wantAlias, 0, "Scale transposed source in-place", 0)
+}
+
+func TestDenseApplyTransposedDenseSourceValuesAndCallbackArgs(t *testing.T) {
+	cases := []struct {
+		r, c int
+		data []float64
+	}{
+		{2, 3, []float64{1, -2, 4.5, 8, 0, -3}},
+		{3, 2, []float64{-5, 7, 2.25, -1, 6, 0.5}},
+	}
+	for i, tc := range cases {
+		src := NewDense(tc.r, tc.c, append([]float64(nil), tc.data...))
+		visits := make([]int, tc.c*tc.r)
+		var got Dense
+		got.Apply(func(r, c int, v float64) float64 {
+			if r < 0 || r >= tc.c || c < 0 || c >= tc.r {
+				t.Fatalf("Apply transposed source case %d callback coordinate out of range: (%d,%d)", i, r, c)
+			}
+			wantV := src.At(c, r)
+			if v != wantV {
+				t.Fatalf("Apply transposed source case %d callback value mismatch at (%d,%d): got %v, want %v", i, r, c, v, wantV)
+			}
+			visits[r*tc.r+c]++
+			return v + float64(100*r+10*c)
+		}, src.T())
+		if gr, gc := got.Dims(); gr != tc.c || gc != tc.r {
+			t.Fatalf("Apply transposed source case %d dims mismatch: got %dx%d, want %dx%d", i, gr, gc, tc.c, tc.r)
+		}
+		for r := 0; r < tc.c; r++ {
+			for c := 0; c < tc.r; c++ {
+				if visits[r*tc.r+c] != 1 {
+					t.Fatalf("Apply transposed source case %d callback visits at (%d,%d): got %d, want 1", i, r, c, visits[r*tc.r+c])
+				}
+				want := src.At(c, r) + float64(100*r+10*c)
+				if got.At(r, c) != want {
+					t.Fatalf("Apply transposed source case %d output mismatch at (%d,%d): got %v, want %v", i, r, c, got.At(r, c), want)
+				}
+			}
+		}
+	}
+
+	alias := NewDense(2, 2, []float64{1, 2, 3, 4})
+	alias.Apply(func(r, c int, v float64) float64 {
+		return v + float64(10*r+c)
+	}, alias.T())
+	wantAlias := NewDense(2, 2, []float64{1, 4, 12, 15})
+	assertDenseApprox(t, alias, wantAlias, 0, "Apply transposed source in-place", 0)
+}
+
+func denseFromBinary(r, c int, a, b []float64, fn func(a, b float64) float64) *Dense {
+	data := make([]float64, len(a))
+	for i := range data {
+		data[i] = fn(a[i], b[i])
+	}
+	return NewDense(r, c, data)
+}
+
+func assertDenseApprox(t *testing.T, got, want *Dense, tol float64, context string, caseIndex int) {
+	gr, gc := got.Dims()
+	wr, wc := want.Dims()
+	if gr != wr || gc != wc {
+		t.Fatalf("%s case %d dims mismatch: got %dx%d, want %dx%d", context, caseIndex, gr, gc, wr, wc)
+	}
+	for r := 0; r < gr; r++ {
+		for c := 0; c < gc; c++ {
+			gv := got.At(r, c)
+			wv := want.At(r, c)
+			if !sameFloat(gv, wv, tol) {
+				t.Fatalf("%s case %d mismatch at (%d,%d): got %v, want %v", context, caseIndex, r, c, gv, wv)
+			}
+		}
+	}
+}
+
+func sameFloat(a, b, tol float64) bool {
+	if math.IsNaN(a) || math.IsNaN(b) {
+		return math.IsNaN(a) && math.IsNaN(b)
+	}
+	if tol == 0 {
+		return a == b
+	}
+	return math.Abs(a-b) <= tol
+}
