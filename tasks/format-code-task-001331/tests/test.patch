+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+export GOROOT=/root/go/pkg/mod/golang.org/toolchain@v0.0.1-go1.12.17.linux-amd64
+export PATH=$GOROOT/bin:$PATH
+export GO111MODULE=off
+
+
+GOTOOLCHAIN=go1.12.17 go version >/dev/null 2>&1
+
+
+export GOPATH=/tmp/gopath_matrix
+mkdir -p $GOPATH/src/github.com/gonum
+
+
+ln -sf /testbed $GOPATH/src/github.com/gonum/matrix
+
+
+clone_dep() {
+    local repo=$1
+    local commit=$2
+    local dest="$GOPATH/src/github.com/gonum/$repo"
+    if [ ! -d "$dest" ]; then
+        git clone https://github.com/gonum/$repo.git "$dest" 2>/dev/null
+        cd "$dest" && git checkout "$commit" 2>/dev/null
+    fi
+}
+
+clone_dep blas 18977dd
+clone_dep lapack 46cff0b
+clone_dep floats a147620
+clone_dep internal 266f56a
+
+
+cd $GOPATH/src/github.com/gonum/matrix
+
+case "${1:-}" in
+  base)
+    fixture_test=/testbed/mat64/dense_alias_transpose_test.go
+    fixture_hold=/tmp/dense_alias_transpose_test.go.fixturea.$$
+    if [ -f "$fixture_test" ]; then
+        mv "$fixture_test" "$fixture_hold"
+        trap 'mv "$fixture_hold" "$fixture_test"' EXIT
+    fi
+    go test -vet=off ./mat64/
+    ;;
+  new)
+    go test -vet=off -v ./mat64/ -run '^(TestDenseSubInPlaceAliasesBothInputs|TestDenseMulElemInPlaceAliasesBothInputs|TestDenseDivElemInPlaceAliasesBothInputs|TestDenseScaleTransposedDenseSource|TestDenseApplyTransposedDenseSourceValuesAndCallbackArgs)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
