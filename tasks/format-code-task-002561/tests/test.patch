+
+
+
+cfg="$TMP/f10-config.json"; calls="$TMP/f10-calls.jsonl"; : >"$calls"; printf '{}' >"$cfg"
+
+run_cli client_auth_no_renew "$cfg" "$calls" client:auth my_client_id my_client_secret; ec=$?
+[ "$ec" -eq 0 ] || fail "F10 setup auth exit $ec; want 0"
+: >"$calls"
+run_cli ocapi_invalid_no_renew "$cfg" "$calls" sandbox:list -j; ec=$?
+[ "$ec" -ne 0 ] || fail "F10 exit zero; want non-zero"
+[ ! -s out ] || fail "F10 unexpected stdout: $(cat out)"
+grep -q 'Authorization missing or invalid' err || fail "F10 missing normal invalid authorization message"
+grep -q 'sfcc-ci client:auth' err || fail "F10 missing client auth guidance"
+! grep -q 'Auto-renewal enabled' err || fail "F10 unexpectedly attempted auto-renewal"
+node -e "const fs=require('fs'); const calls=fs.readFileSync(process.argv[1],'utf8').trim().split(/\n+/).filter(Boolean).map(JSON.parse); if (calls.filter(c => c.kind === 'request').length !== 1) process.exit(1); if (calls.filter(c => c.kind === 'post').length !== 0) process.exit(2);" "$calls" \
+    || fail "F10 made renewal request or retried without renewal credentials"
