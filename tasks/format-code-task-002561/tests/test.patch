+[ "$(cat out)" = "Authentication renewal succeeded" ] || fail "F4 stdout: $(cat out)"
+[ ! -s err ] || fail "F4 unexpected stderr: $(cat err)"
+[ "$(last_call_get "$calls" post uri)" = "https://account.demandware.com/dwsso/oauth2/access_token" ] || fail "F4 token endpoint mismatch"
+[ "$(last_call_get "$calls" post auth.user)" = "renew_client" ] || fail "F4 basic auth user mismatch"
