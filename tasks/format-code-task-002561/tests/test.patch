+
+
+
+cfg="$TMP/f11-config.json"; calls="$TMP/f11-calls.jsonl"; : >"$calls"; printf '{}' >"$cfg"
+
+run_cli client_auth_renew "$cfg" "$calls" client:auth visible_client visible_secret --renew; ec=$?
+[ "$ec" -eq 0 ] || fail "F11 setup auth exit $ec; want 0"
+run_cli renew_no_refresh "$cfg" "$calls" instance:list -v -j; ec=$?
+[ "$ec" -eq 0 ] || fail "F11 exit $ec; want 0"
+
+json_path_truthy out auth.refresh_token || fail "F11 JSON missing set auth.refresh_token"
+json_path_truthy out auth.auto_renew_token || fail "F11 JSON missing configured auth.auto_renew_token"
+[ ! -s err ] || fail "F11 unexpected stderr: $(cat err)"
+
+
+
+
+cfg="$TMP/f12-config.json"; calls="$TMP/f12-calls.jsonl"; : >"$calls"; printf '{}' >"$cfg"
+
