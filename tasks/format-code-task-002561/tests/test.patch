+[ "$(cat out)" = "ACCESS_AUTH_NO_RENEW" ] || fail "F2 access token not replaced"
+run_cli renew_no_refresh "$cfg" "$calls" client:auth:renew; ec=$?
+[ "$ec" -ne 0 ] || fail "F2 renewal still possible after non-renew auth"
+run_cli renew_no_refresh "$cfg" "$calls" instance:list -v -j; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 instance visibility exit $ec; want 0"
+json_path_cleared out auth.refresh_token || fail "F2 refresh token still visible as set"
+json_path_cleared out auth.auto_renew_token || fail "F2 renewal credentials still visible as configured"
+
+
+
+
+cfg="$TMP/f3-config.json"; calls="$TMP/f3-calls.jsonl"; : >"$calls"; printf '{}' >"$cfg"
+
+run_cli client_auth_renew "$cfg" "$calls" client:auth renew_client renew_secret --renew; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 setup auth exit $ec; want 0"
+: >"$calls"
+run_cli renew_with_refresh "$cfg" "$calls" client:auth:renew; ec=$?
+EXPECTED='Authentication renewal succeeded'
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F3 stdout: $(cat out)"
+[ ! -s err ] || fail "F3 unexpected stderr: $(cat err)"
+[ "$(last_call_get "$calls" post uri)" = "https://account.demandware.com/dwsso/oauth2/access_token" ] || fail "F3 token endpoint mismatch"
+[ "$(last_call_get "$calls" post auth.user)" = "renew_client" ] || fail "F3 basic auth user mismatch"
+[ "$(last_call_get "$calls" post auth.pass)" = "renew_secret" ] || fail "F3 basic auth secret mismatch"
+[ "$(last_call_get "$calls" post form.grant_type)" = "refresh_token" ] || fail "F3 grant_type mismatch"
+[ "$(last_call_get "$calls" post form.refresh_token)" = "REFRESH_AUTH_RENEW" ] || fail "F3 refresh form mismatch"
+run_cli renew_no_refresh "$cfg" "$calls" client:auth:token; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 token command exit $ec; want 0"
+[ "$(cat out)" = "ACCESS_RENEWED_FROM_REFRESH" ] || fail "F3 access token not renewed"
+run_cli renew_no_refresh "$cfg" "$calls" instance:list -v -j; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 instance visibility exit $ec; want 0"
+json_path_truthy out auth.refresh_token || fail "F3 refresh token not updated"
+
+
+
+
+cfg="$TMP/f4-config.json"; calls="$TMP/f4-calls.jsonl"; : >"$calls"; printf '{}' >"$cfg"
+
+run_cli renew_no_refresh "$cfg" "$calls" client:auth renew_client renew_secret --renew; ec=$?
+[ "$ec" -eq 0 ] || fail "F4 setup auth exit $ec; want 0"
+: >"$calls"
+run_cli renew_no_refresh "$cfg" "$calls" client:auth:renew; ec=$?
