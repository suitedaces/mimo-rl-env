+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC FORCE_COLOR=0 NO_COLOR=1
+
+REPO=/workspace/repo
+PRELOAD="$REPO/usercase-test-coderl/fixtures/preload.js"
+BIN="$REPO/cli.js"
+
+if [ ! -d "$REPO/node_modules" ]; then
+
+    echo "FAIL: missing node_modules" >&2
+    exit 1
+fi
+
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || exit 1
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+run_cli() {
+    MOCK_SCENARIO="$1" MOCK_CONFIG_PATH="$2" MOCK_CALLS_PATH="$3" \
+        NODE_OPTIONS="--require $PRELOAD" node "$BIN" "${@:4}" >out 2>err
+}
+
+json_get() {
+    node -e "const fs=require('fs'); const data=JSON.parse(fs.readFileSync(process.argv[1],'utf8')); const path=process.argv[2].split('.'); let v=data; for (const p of path) v = v && v[p]; if (v === undefined) process.exit(3); if (typeof v === 'object') console.log(JSON.stringify(v)); else console.log(String(v));" "$1" "$2"
+}
+
+json_has_no_key() {
+    node -e "const fs=require('fs'); const data=JSON.parse(fs.readFileSync(process.argv[1],'utf8')); process.exit(Object.prototype.hasOwnProperty.call(data, process.argv[2]) ? 1 : 0);" "$1" "$2"
+}
+
+json_key_is_cleared() {
+    node -e "const fs=require('fs'); const data=JSON.parse(fs.readFileSync(process.argv[1],'utf8')); process.exit(data[process.argv[2]] ? 1 : 0);" "$1" "$2"
+}
+
+json_path_truthy() {
+    node -e "const fs=require('fs'); const data=JSON.parse(fs.readFileSync(process.argv[1],'utf8')); const path=process.argv[2].split('.'); let v=data; for (const p of path) v = v && v[p]; process.exit(v ? 0 : 1);" "$1" "$2"
+}
+
+json_path_cleared() {
+    node -e "const fs=require('fs'); const data=JSON.parse(fs.readFileSync(process.argv[1],'utf8')); const path=process.argv[2].split('.'); let v=data; for (const p of path) v = v && v[p]; process.exit(v ? 1 : 0);" "$1" "$2"
+}
+
+last_call_get() {
+    node -e "const fs=require('fs'); const lines=fs.readFileSync(process.argv[1],'utf8').trim().split(/\n+/).filter(Boolean).map(JSON.parse); const item=lines.filter(x => x.kind === process.argv[2]).pop(); const path=process.argv[3].split('.'); let v=item; for (const p of path) v = v && v[p]; if (typeof v === 'object') console.log(JSON.stringify(v)); else console.log(String(v));" "$1" "$2" "$3"
+}
+
+last_post_get() {
+    last_call_get "$1" post "$2"
+}
+
+stdout_has_sandbox_id() {
+    node -e "const fs=require('fs'); const lines=fs.readFileSync(process.argv[1],'utf8').trim().split(/\n+/).filter(Boolean); for (let i=lines.length-1;i>=0;i--) { try { const value=JSON.parse(lines[i]); if (Array.isArray(value) && value.some(x => x && x.id === process.argv[2])) process.exit(0); } catch (_) {} } process.exit(1);" "$1" "$2"
+}
+
+text_shows_state() {
+    node -e "const fs=require('fs'); const text=fs.readFileSync(process.argv[1],'utf8').toLowerCase(); const topic=process.argv[2]; const want=process.argv[3]; const lines=text.split(/\n/).filter(l => l.includes(topic)); if (!lines.length) process.exit(1); const joined=lines.join('\n'); const absent=/(not set|no|false|absent|missing|disabled|not configured)/.test(joined); const present=/(^|[^a-z])(set|yes|true|present|configured|enabled)([^a-z]|$)/.test(joined); if (want === 'present') process.exit(present && !absent ? 0 : 2); process.exit(absent ? 0 : 3);" "$1" "$2" "$3"
+}
+
+
+
+
+cfg="$TMP/f1-config.json"; calls="$TMP/f1-calls.jsonl"; : >"$calls"; printf '{}' >"$cfg"
+run_cli client_auth_renew "$cfg" "$calls" client:auth my_client_id my_client_secret --renew; ec=$?
+EXPECTED='Authentication succeeded Auto-renewal enabled.'
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F1 stdout: $(cat out)"
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+
+run_cli renew_no_refresh "$cfg" "$calls" client:auth:token; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 token command exit $ec; want 0"
+[ "$(cat out)" = "ACCESS_AUTH_RENEW" ] || fail "F1 access token not stored"
+: >"$calls"
+run_cli renew_with_refresh "$cfg" "$calls" client:auth:renew; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 renewal command exit $ec; want 0"
+[ "$(last_post_get "$calls" auth.user)" = "my_client_id" ] || fail "F1 renewal client credential not stored"
+[ "$(last_post_get "$calls" auth.pass)" = "my_client_secret" ] || fail "F1 renewal secret not stored"
+[ "$(last_post_get "$calls" form.grant_type)" = "refresh_token" ] || fail "F1 stored refresh token was not used"
+[ "$(last_post_get "$calls" form.refresh_token)" = "REFRESH_AUTH_RENEW" ] || fail "F1 refresh token not stored"
+
+
+
+
+cfg="$TMP/f2-config.json"; calls="$TMP/f2-calls.jsonl"; : >"$calls"; printf '{}' >"$cfg"
+
+run_cli client_auth_renew "$cfg" "$calls" client:auth my_client_id my_client_secret --renew; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 setup auth exit $ec; want 0"
+: >"$calls"
+run_cli client_auth_no_renew "$cfg" "$calls" client:auth my_client_id my_client_secret; ec=$?
+EXPECTED='Authentication succeeded'
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F2 stdout: $(cat out)"
+[ ! -s err ] || fail "F2 unexpected stderr: $(cat err)"
+run_cli renew_no_refresh "$cfg" "$calls" client:auth:token; ec=$?
