+: >"$calls"
+run_cli ocapi_fault_retry "$cfg" "$calls" sandbox:list -j; ec=$?
+[ "$ec" -eq 0 ] || fail "F9 exit $ec; want 0"
+stdout_has_sandbox_id out sbx-001 || fail "F9 stdout did not include retried sandbox result: $(cat out)"
+[ "$(cat err)" = "$EXPECTED_ERR" ] || fail "F9 stderr: $(cat err)"
+node -e "const fs=require('fs'); const calls=fs.readFileSync(process.argv[1],'utf8').trim().split(/\n+/).map(JSON.parse); const reqs=calls.filter(c => c.kind === 'request'); if (reqs.length !== 2) process.exit(1); if (reqs[0].auth.bearer !== 'ACCESS_AUTH_RENEW') process.exit(2); if (reqs[1].auth.bearer !== 'ACCESS_AFTER_AUTO_RENEW') process.exit(3);" "$calls" \
+    || fail "F9 did not retry original request with renewed bearer token"
