+const fs = require('fs');
+const Module = require('module');
+const stream = require('stream');
+
+const configPath = process.env.MOCK_CONFIG_PATH;
+const callsPath = process.env.MOCK_CALLS_PATH;
+const scenario = process.env.MOCK_SCENARIO || '';
+
+function readJson(file, fallback) {
+    if (!file || !fs.existsSync(file)) {
+        return fallback;
+    }
+    return JSON.parse(fs.readFileSync(file, 'utf8'));
+}
+
+function writeJson(file, value) {
+    fs.writeFileSync(file, JSON.stringify(value, null, 2));
+}
+
+function record(value) {
+    if (callsPath) {
+        fs.appendFileSync(callsPath, JSON.stringify(value) + '\n');
+    }
+}
+
+function configStore() {
+    return {
+        get: function(key) {
+            return readJson(configPath, {})[key];
+        },
+        set: function(key, value) {
+            const data = readJson(configPath, {});
+            data[key] = value;
+            writeJson(configPath, data);
+        },
+        delete: function(key) {
+            const data = readJson(configPath, {});
+            delete data[key];
+            writeJson(configPath, data);
+        }
+    };
+}
+
+function tokenResponse(accessToken, refreshToken) {
+    const body = { access_token: accessToken };
+    if (refreshToken !== undefined) {
+        body.refresh_token = refreshToken;
+    }
+    return { statusCode: 200, body };
+}
+
+let sandboxCalls = 0;
+
+function handleRequest(options, callback) {
+    record({ kind: 'request', uri: options.uri, method: options.method, auth: options.auth, form: options.form });
+
+    if (scenario === 'ocapi_invalid_retry' || scenario === 'ocapi_fault_retry' || scenario === 'ocapi_invalid_no_renew') {
+        sandboxCalls += 1;
+        if (sandboxCalls === 1) {
+            const body = scenario === 'ocapi_fault_retry'
+                ? { fault: { type: 'InvalidAccessTokenException' } }
+
+                : { error: 'invalid_token', error_description: configStore().get('SFCC_CLIENT_TOKEN') };
+            callback(null, { statusCode: 401, body });
+            return;
+        }
+        callback(null, {
+            statusCode: 200,
+            body: {
+                data: [{
+                    id: 'sbx-001',
+                    realm: 'zzzz',
+                    instance: 's01',
+                    versions: { app: '6.0.0' },
+                    state: 'started',
+                    createdAt: '2024-01-02T03:04:05.000Z',
+                    eol: '2024-01-03T03:04:05.000Z',
+                    createdBy: 'tester@example.com',
+                    autoScheduled: false,
+                    resourceProfile: 'medium'
+                }]
+            }
+        });
+        return;
+    }
+
+    callback(null, { statusCode: 200, body: { data: [] } });
+}
+
+handleRequest.post = function(options, callback) {
+    record({ kind: 'post', uri: options.uri, method: options.method, auth: options.auth, form: options.form });
+
+    if (scenario === 'client_auth_renew') {
+        callback(null, tokenResponse('ACCESS_AUTH_RENEW', 'REFRESH_AUTH_RENEW'));
+    } else if (scenario === 'client_auth_no_renew') {
+        callback(null, tokenResponse('ACCESS_AUTH_NO_RENEW', 'REFRESH_SHOULD_BE_CLEARED'));
+    } else if (scenario === 'renew_with_refresh') {
+        callback(null, tokenResponse('ACCESS_RENEWED_FROM_REFRESH', 'REFRESH_ROTATED'));
+    } else if (scenario === 'renew_no_refresh') {
+        callback(null, tokenResponse('ACCESS_RENEWED_FROM_CLIENT_CREDENTIALS'));
+    } else if (scenario === 'renew_failure') {
+        callback(new Error('network down'), { statusCode: 503, body: { error: 'temporarily_unavailable' } });
+    } else if (scenario === 'ocapi_invalid_retry' || scenario === 'ocapi_fault_retry') {
+        callback(null, tokenResponse('ACCESS_AFTER_AUTO_RENEW', 'REFRESH_AFTER_AUTO_RENEW'));
+    } else {
+        callback(null, tokenResponse('ACCESS_DEFAULT'));
+    }
+};
+
+handleRequest.get = handleRequest;
+
+handleRequest.defaults = function() {
+    return handleRequest;
+};
+
+handleRequest.prototype = stream.Writable.prototype;
+
+function openStub(url) {
+    record({ kind: 'open', url });
+    return Promise.resolve();
+}
+
+const originalLoad = Module._load;
+Module._load = function(request, parent, isMain) {
+    if (request === 'request') {
+        return handleRequest;
+    }
+    if (request === 'open') {
+        return openStub;
+    }
+    if (request.endsWith('/lib/config') || request === './config') {
+        return { obtain: configStore };
+    }
+    return originalLoad.apply(this, arguments);
+};
