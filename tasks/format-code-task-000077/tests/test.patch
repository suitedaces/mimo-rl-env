diff --git a/tests/ext/commands/test_params_verify_type.py b/tests/ext/commands/test_params_verify_type.py
new file mode 100644
index 00000000..db91fabe
--- /dev/null
+++ b/tests/ext/commands/test_params_verify_type.py
@@ -0,0 +1,156 @@
+
+
+import asyncio
+from typing import Union
+from unittest.mock import MagicMock
+
+import pytest
+
+import disnake
+from disnake.ext.commands import errors
+from disnake.ext.commands.params import ParamInfo
+
+
+def _make_user(user_id: int = 111) -> disnake.User:
+    state = MagicMock()
+    data = {
+        "id": user_id,
+        "username": "u",
+        "discriminator": "0001",
+        "avatar": None,
+        "public_flags": 0,
+    }
+    return disnake.User(state=state, data=data)
+
+
+def _make_member(user_id: int = 222) -> disnake.Member:
+    state = MagicMock()
+    guild = MagicMock()
+    user_data = {
+        "id": user_id,
+        "username": "m",
+        "discriminator": "0001",
+        "avatar": None,
+        "public_flags": 0,
+    }
+    data = {"roles": [], "joined_at": None, "deaf": False, "mute": False}
+    return disnake.Member(data=data, guild=guild, state=state, user_data=user_data)
+
+
+def _make_role(role_id: int = 333) -> disnake.Role:
+    state = MagicMock()
+    guild = MagicMock()
+    data = {
+        "id": role_id,
+        "name": "r",
+        "color": 0,
+        "hoist": False,
+        "position": 0,
+        "permissions": "0",
+        "managed": False,
+        "mentionable": False,
+    }
+    return disnake.Role(guild=guild, state=state, data=data)
+
+
+def _param(annotation) -> ParamInfo:
+    p = ParamInfo()
+    p.parse_annotation(annotation)
+    return p
+
+
+def _run(coro):
+    return asyncio.get_event_loop().run_until_complete(coro)
+
+
+@pytest.fixture
+def inter():
+    return MagicMock()
+
+
+
+
+
+def test_union_member_user_with_user_argument_returns_user(inter):
+
+    p = _param(Union[disnake.Member, disnake.User])
+    user = _make_user()
+    result = _run(p.verify_type(inter, user))
+    assert result is user
+
+
+def test_union_user_member_order_with_user_argument_returns_user(inter):
+
+    p = _param(Union[disnake.User, disnake.Member])
+    user = _make_user()
+    result = _run(p.verify_type(inter, user))
+    assert result is user
+
+
+def test_union_member_user_with_member_argument_returns_member(inter):
+
+    p = _param(Union[disnake.Member, disnake.User])
+    member = _make_member()
+    result = _run(p.verify_type(inter, member))
+    assert result is member
+
+
+
+
+
+def test_member_only_with_user_argument_raises(inter):
+
+    p = _param(disnake.Member)
+    user = _make_user(user_id=999)
+    with pytest.raises(errors.MemberNotFound):
+        _run(p.verify_type(inter, user))
+
+
+def test_member_only_with_member_argument_returns_member(inter):
+    p = _param(disnake.Member)
+    member = _make_member()
+    result = _run(p.verify_type(inter, member))
+    assert result is member
+
+
+
+
+
+def test_user_only_with_user_argument_returns_user(inter):
+    p = _param(disnake.User)
+    user = _make_user()
+    result = _run(p.verify_type(inter, user))
+    assert result is user
+
+
+
+
+
+def test_union_member_role_with_role_argument_returns_role(inter):
+
+    p = _param(Union[disnake.Member, disnake.Role])
+    role = _make_role()
+    result = _run(p.verify_type(inter, role))
+    assert result is role
+
+
+def test_union_member_role_with_member_argument_returns_member(inter):
+    p = _param(Union[disnake.Member, disnake.Role])
+    member = _make_member()
+    result = _run(p.verify_type(inter, member))
+    assert result is member
+
+
+
+
+
+def test_string_type_returns_argument_unchanged(inter):
+    p = _param(str)
+    result = _run(p.verify_type(inter, "hello"))
+    assert result == "hello"
+
+
+def test_integer_type_returns_argument_unchanged(inter):
+    p = _param(int)
+    result = _run(p.verify_type(inter, 42))
+    assert result == 42
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
