+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+python -m pytest -v -rA tests/ext/commands/test_params_verify_type.py::test_union_member_user_with_user_argument_returns_user tests/ext/commands/test_params_verify_type.py::test_union_user_member_order_with_user_argument_returns_user tests/ext/commands/test_params_verify_type.py::test_union_member_user_with_member_argument_returns_member tests/ext/commands/test_params_verify_type.py::test_member_only_with_user_argument_raises tests/ext/commands/test_params_verify_type.py::test_member_only_with_member_argument_returns_member tests/ext/commands/test_params_verify_type.py::test_user_only_with_user_argument_returns_user tests/ext/commands/test_params_verify_type.py::test_union_member_role_with_role_argument_returns_role tests/ext/commands/test_params_verify_type.py::test_union_member_role_with_member_argument_returns_member tests/ext/commands/test_params_verify_type.py::test_string_type_returns_argument_unchanged tests/ext/commands/test_params_verify_type.py::test_integer_type_returns_argument_unchanged
+rc=$(( rc | $? ))
+exit $rc
