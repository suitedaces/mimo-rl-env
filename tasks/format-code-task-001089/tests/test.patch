@@ -0,0 +1,120 @@
+# -*- coding: utf-8 -*-
+
+
+import os
+
+import pytest
+
+
+def _corpus_api():
+    try:
+        from underthesea.corpus import (DictionaryLoader, PlainTextCorpus,
+                                        viet_dict_11K, word_sent)
+    except Exception as exc:
+        pytest.fail("public corpus API could not be imported: %s" % exc)
+    return DictionaryLoader, PlainTextCorpus, viet_dict_11K, word_sent
+
+
+def test_public_corpus_symbols_are_importable():
+    DictionaryLoader, PlainTextCorpus, viet_dict_11K, word_sent = _corpus_api()
+    try:
+        from underthesea.corpus.word_sent import word_sent as nested_word_sent
+    except Exception as exc:
+        pytest.fail("nested word_sent API could not be imported: %s" % exc)
+    assert DictionaryLoader is not None
+    assert PlainTextCorpus is not None
+    assert viet_dict_11K is not None
+    assert callable(word_sent)
+    assert nested_word_sent(u"cộng hòa xã hội chủ nghĩa") == \
+        word_sent(u"cộng hòa xã hội chủ nghĩa")
+
+
+def test_load_uses_sorted_regular_files_and_preserves_utf8_lines(tmpdir):
+    _, PlainTextCorpus, _, _ = _corpus_api()
+    root = str(tmpdir)
+    with open(os.path.join(root, "10.txt"), "wb") as stream:
+        stream.write("Đầu tiên\n\nKết thúc\n".encode("utf-8"))
+    with open(os.path.join(root, "2.txt"), "wb") as stream:
+        stream.write("Một dòng".encode("utf-8"))
+    os.mkdir(os.path.join(root, "ignored-directory"))
+
+    corpus = PlainTextCorpus()
+    corpus.load(root)
+
+    assert [document.id for document in corpus.documents] == ["10.txt", "2.txt"]
+    assert corpus.documents[0].sentences == [u"Đầu tiên", u"", u"Kết thúc", u""]
+    assert corpus.documents[1].sentences == [u"Một dòng"]
+
+
+def test_load_replaces_previous_documents(tmpdir):
+    _, PlainTextCorpus, _, _ = _corpus_api()
+    first = str(tmpdir.mkdir("first"))
+    second = str(tmpdir.mkdir("second"))
+    with open(os.path.join(first, "old.txt"), "w") as stream:
+        stream.write("old")
+    with open(os.path.join(second, "new.txt"), "w") as stream:
+        stream.write("new")
+
+    corpus = PlainTextCorpus()
+    corpus.load(first)
+    corpus.load(second)
+
+    assert [document.id for document in corpus.documents] == ["new.txt"]
+    assert corpus.documents[0].sentences == [u"new"]
+
+
+def test_save_creates_utf8_files_without_removing_existing_files(tmpdir):
+    _, PlainTextCorpus, _, _ = _corpus_api()
+    source = str(tmpdir.mkdir("source"))
+    destination = str(tmpdir.mkdir("destination"))
+    with open(os.path.join(source, "doc.txt"), "wb") as stream:
+        stream.write("Xin chào\nDòng hai\n".encode("utf-8"))
+    with open(os.path.join(destination, "keep.txt"), "w") as stream:
+        stream.write("keep")
+
+    corpus = PlainTextCorpus()
+    corpus.load(source)
+    corpus.save(destination)
+
+    with open(os.path.join(destination, "doc.txt"), "rb") as stream:
+        assert stream.read() == "Xin chào\nDòng hai\n".encode("utf-8")
+    with open(os.path.join(destination, "keep.txt"), "r") as stream:
+        assert stream.read() == "keep"
+
+
+def test_save_creates_missing_destination_as_utf8(tmpdir):
+    _, PlainTextCorpus, _, _ = _corpus_api()
+    source = str(tmpdir.mkdir("source"))
+    destination = os.path.join(str(tmpdir), "new-destination")
+    with open(os.path.join(source, "doc.txt"), "wb") as stream:
+        stream.write("Đường dẫn\n".encode("utf-8"))
+
+    corpus = PlainTextCorpus()
+    corpus.load(source)
+    corpus.save(destination)
+
+    assert os.path.isdir(destination)
+    with open(os.path.join(destination, "doc.txt"), "rb") as stream:
+        assert stream.read() == "Đường dẫn\n".encode("utf-8")
+
+
+def test_dictionary_is_unicode_text_with_repository_order():
+    _, _, viet_dict_11K, _ = _corpus_api()
+    words = viet_dict_11K.words
+    assert len(words) == 11373
+    assert words[0] == u"a"
+    assert all(isinstance(word, str) for word in words)
+
+
+def test_word_sent_keeps_public_segmentation_and_punctuation_contract():
+    _, _, _, word_sent = _corpus_api()
+    assert word_sent(u"cộng hòa xã hội chủ nghĩa") == u"cộng hòa xã_hội_chủ_nghĩa"
+    assert word_sent(u"Hồ Chí Minh ?") == u"Hồ_Chí_Minh ?"
+
+
+def test_unicode_transformer_accepts_bytes_and_text():
+    from underthesea.transformer.unicode import UnicodeTransformer
+
+    transformer = UnicodeTransformer()
+    assert transformer.transform("cộng hòa".encode("utf-8")) == u"cộng hòa"
+    assert transformer.transform(u"cộng hòa") == u"cộng hòa"
