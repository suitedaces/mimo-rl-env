@@ -0,0 +1,428 @@
+
+
+
+
+
+
+
+
+
+from __future__ import annotations
+
+import copy
+import json
+import os
+import socket
+import subprocess
+import sys
+from dataclasses import dataclass
+from enum import Enum
+from pathlib import Path
+from typing import Annotated, Any
+
+import pytest
+
+from efro.dataclassio import (
+    EXTRA_ATTRS_ATTR,
+    IOAttrs,
+    dataclass_from_json,
+    dataclass_to_json,
+    ioprepped,
+)
+
+
+@ioprepped
+@dataclass
+class ScoreCard:
+    name: str
+    score: int
+
+
+@ioprepped
+@dataclass
+class OrderedCard:
+    zebra: int
+    alpha: int
+    mid: str
+
+
+@ioprepped
+@dataclass
+class FloatCard:
+    value: float
+    label: str = 'flt'
+
+
+@ioprepped
+@dataclass
+class NestedCard:
+    title: str
+    child: ScoreCard
+    tags: list[str]
+    meta: dict[str, int]
+    ratio: float
+
+
+@ioprepped
+@dataclass
+class StoredNameCard:
+    public_name: Annotated[str, IOAttrs('n')]
+    score: Annotated[int, IOAttrs('s')]
+
+
+@ioprepped
+@dataclass
+class AnyPayloadCard:
+    payload: Any
+
+
+@ioprepped
+@dataclass
+class FallbackCard:
+    class State(Enum):
+        KNOWN = 'known'
+        OTHER = 'other'
+
+    label: str
+    state: Annotated[State, IOAttrs('st', enum_fallback=State.OTHER)]
+
+
+def test_to_json_compact_default_separators() -> None:
+
+
+
+    obj = ScoreCard(name='bob', score=7)
+
+    actual = dataclass_to_json(obj)
+
+    assert actual == '{"name":"bob","score":7}'
+
+
+def test_to_json_pretty_sorts_keys_by_default() -> None:
+
+
+
+    obj = OrderedCard(zebra=2, alpha=1, mid='m')
+
+    actual = dataclass_to_json(obj, pretty=True)
+
+    assert actual == '{\n  "alpha": 1,\n  "mid": "m",\n  "zebra": 2\n}'
+
+
+def test_to_json_compact_sort_keys_true() -> None:
+
+
+
+    obj = OrderedCard(zebra=2, alpha=1, mid='m')
+
+    actual = dataclass_to_json(obj, sort_keys=True)
+
+    assert actual == '{"alpha":1,"mid":"m","zebra":2}'
+
+
+def test_to_json_pretty_sort_keys_false() -> None:
+
+
+
+    obj = OrderedCard(zebra=2, alpha=1, mid='m')
+
+    actual = dataclass_to_json(obj, pretty=True, sort_keys=False)
+
+    assert actual == '{\n  "zebra": 2,\n  "alpha": 1,\n  "mid": "m"\n}'
+
+
+def test_to_json_uses_json_codec_dict_conversion() -> None:
+
+
+
+    obj = NestedCard(
+        title='match',
+        child=ScoreCard(name='ana', score=11),
+        tags=['red', 'blue'],
+        meta={'wins': 3, 'losses': 1},
+        ratio=2,
+    )
+
+    actual = dataclass_to_json(obj)
+
+    assert (
+        actual
+        == '{"title":"match","child":{"name":"ana","score":11},'
+        '"tags":["red","blue"],"meta":{"wins":3,"losses":1},"ratio":2.0}'
+    )
+
+
+def test_to_json_uses_field_storage_names() -> None:
+
+
+
+    obj = StoredNameCard(public_name='bob', score=7)
+
+    actual = dataclass_to_json(obj)
+
+    assert actual == '{"n":"bob","s":7}'
+
+
+def test_to_json_forwards_coerce_to_float_true_default() -> None:
+
+
+
+    obj = FloatCard(value=2)
+
+    actual = dataclass_to_json(obj)
+
+    assert actual == '{"value":2.0,"label":"flt"}'
+
+
+def test_to_json_forwards_coerce_to_float_false_error() -> None:
+
+
+
+    obj = FloatCard(value=2)
+
+    with pytest.raises(TypeError) as excinfo:
+        dataclass_to_json(obj, coerce_to_float=False)
+
+
+    assert isinstance(excinfo.value, TypeError)
+
+
+def test_to_json_rejects_nonfinite_float_values() -> None:
+
+
+
+    obj = AnyPayloadCard(payload=float('nan'))
+
+    with pytest.raises(ValueError) as excinfo:
+        dataclass_to_json(obj)
+
+
+    assert isinstance(excinfo.value, ValueError)
+
+
+def test_from_json_returns_equal_dataclass_instance() -> None:
+
+
+
+    actual = dataclass_from_json(ScoreCard, '{"name":"bob","score":7}')
+
+    assert actual == ScoreCard(name='bob', score=7)
+
+
+def test_from_json_forwards_coerce_to_float_true_default() -> None:
+
+
+
+    actual = dataclass_from_json(FloatCard, '{"value":2}')
+
+    assert actual == FloatCard(value=2.0, label='flt')
+
+
+def test_from_json_forwards_coerce_to_float_false_error() -> None:
+
+
+
+    with pytest.raises(TypeError) as excinfo:
+        dataclass_from_json(FloatCard, '{"value":2}', coerce_to_float=False)
+
+
+    assert isinstance(excinfo.value, TypeError)
+
+
+def test_from_json_preserves_unknown_attrs_by_default() -> None:
+
+
+
+    actual = dataclass_from_json(
+        ScoreCard, '{"name":"bob","score":7,"nickname":"bobby"}'
+    )
+
+    assert actual == ScoreCard(name='bob', score=7)
+    assert getattr(actual, EXTRA_ATTRS_ATTR) == {'nickname': 'bobby'}
+
+
+def test_from_json_forwards_allow_unknown_attrs_false() -> None:
+
+
+
+    with pytest.raises(AttributeError) as excinfo:
+        dataclass_from_json(
+            ScoreCard,
+            '{"name":"bob","score":7,"nickname":"bobby"}',
+            allow_unknown_attrs=False,
+        )
+
+
+    assert isinstance(excinfo.value, AttributeError)
+
+
+def test_from_json_forwards_discard_unknown_attrs_true() -> None:
+
+
+
+    actual = dataclass_from_json(
+        ScoreCard,
+        '{"name":"bob","score":7,"nickname":"bobby"}',
+        discard_unknown_attrs=True,
+    )
+
+    assert actual == ScoreCard(name='bob', score=7)
+    assert not hasattr(actual, EXTRA_ATTRS_ATTR)
+
+
+def test_from_json_uses_existing_dict_input_path_storage_names() -> None:
+
+
+
+    actual = dataclass_from_json(StoredNameCard, '{"n":"bob","s":7}')
+
+    assert actual == StoredNameCard(public_name='bob', score=7)
+
+
+def test_from_json_forwards_lossy_false_default() -> None:
+
+
+
+    with pytest.raises(ValueError) as excinfo:
+        dataclass_from_json(FallbackCard, '{"label":"x","st":"new-state"}')
+
+
+    assert isinstance(excinfo.value, ValueError)
+
+
+def test_from_json_forwards_lossy_true() -> None:
+
+
+
+    actual = dataclass_from_json(
+        FallbackCard, '{"label":"x","st":"new-state"}', lossy=True
+    )
+
+    assert actual == FallbackCard(label='x', state=FallbackCard.State.OTHER)
+
+
+def test_from_json_invalid_json_raises_decode_error() -> None:
+
+
+
+    with pytest.raises(json.JSONDecodeError) as excinfo:
+        dataclass_from_json(ScoreCard, '{')
+
+
+    assert isinstance(excinfo.value, json.JSONDecodeError)
+
+
+def test_from_json_valid_json_nondict_raises_validation_typeerror() -> None:
+
+
+
+    with pytest.raises(TypeError) as excinfo:
+        dataclass_from_json(ScoreCard, '[1,2]')
+
+
+    assert isinstance(excinfo.value, TypeError)
+
+
+def test_from_json_valid_object_bad_value_raises_validation_typeerror() -> None:
+
+
+
+    with pytest.raises(TypeError) as excinfo:
+        dataclass_from_json(ScoreCard, '{"name":"bob","score":"seven"}')
+
+
+    assert isinstance(excinfo.value, TypeError)
+
+
+def test_referential_transparency_same_input_same_value() -> None:
+    obj = NestedCard(
+        title='match',
+        child=ScoreCard(name='ana', score=11),
+        tags=['red', 'blue'],
+        meta={'wins': 3, 'losses': 1},
+        ratio=2,
+    )
+
+    assert dataclass_to_json(obj, sort_keys=True) == dataclass_to_json(
+        obj, sort_keys=True
+    )
+    assert dataclass_from_json(ScoreCard, '{"name":"bob","score":7}') == (
+        dataclass_from_json(ScoreCard, '{"name":"bob","score":7}')
+    )
+
+
+def test_no_mutation_of_caller_inputs() -> None:
+    obj = NestedCard(
+        title='match',
+        child=ScoreCard(name='ana', score=11),
+        tags=['red', 'blue'],
+        meta={'wins': 3, 'losses': 1},
+        ratio=2,
+    )
+    obj_before = copy.deepcopy(obj)
+    json_str = '{"name":"bob","score":7,"nickname":"bobby"}'
+    json_str_before = copy.deepcopy(json_str)
+
+    assert dataclass_to_json(obj) == (
+        '{"title":"match","child":{"name":"ana","score":11},'
+        '"tags":["red","blue"],"meta":{"wins":3,"losses":1},"ratio":2.0}'
+    )
+    assert dataclass_from_json(ScoreCard, json_str) == ScoreCard(
+        name='bob', score=7
+    )
+
+    assert obj == obj_before
+    assert json_str == json_str_before
+
+
+def test_no_global_state_fresh_process_matches_in_process() -> None:
+    obj = OrderedCard(zebra=2, alpha=1, mid='m')
+    actual = dataclass_to_json(obj, pretty=True)
+    script = r'''
+from dataclasses import dataclass
+from efro.dataclassio import dataclass_to_json, ioprepped
+
+@ioprepped
+@dataclass
+class OrderedCard:
+    zebra: int
+    alpha: int
+    mid: str
+
+print(dataclass_to_json(OrderedCard(zebra=2, alpha=1, mid='m'), pretty=True), end='')
+'''
+
+    env = dict(os.environ)
+    env['PYTHONPATH'] = '/workspace/repo/tools'
+    result = subprocess.run(
+        [sys.executable, '-c', script],
+        check=True,
+        env=env,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+
+    assert actual == '{\n  "alpha": 1,\n  "mid": "m",\n  "zebra": 2\n}'
+    assert result.stdout == '{\n  "alpha": 1,\n  "mid": "m",\n  "zebra": 2\n}'
+
+
+def test_no_undeclared_filesystem_or_network_side_effects(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    def socket_blocked(*_args: Any, **_kwargs: Any) -> Any:
+        raise AssertionError('dataclass JSON helpers must not open sockets')
+
+    monkeypatch.setattr(socket, 'socket', socket_blocked)
+    monkeypatch.chdir(tmp_path)
+    before = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob('*'))
+
+    assert dataclass_to_json(ScoreCard(name='bob', score=7)) == (
+        '{"name":"bob","score":7}'
+    )
+    assert dataclass_from_json(ScoreCard, '{"name":"bob","score":7}') == ScoreCard(
+        name='bob', score=7
+    )
+
+    after = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob('*'))
+    assert after == before == []
