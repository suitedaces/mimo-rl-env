+    def test_lineage_cte_name_collides_with_schema_table_with_inter_cte(self) -> None:
+
+
+
+        sql = """
+        with
+        my_cte_name_also_a_table_name as (
+            select * from raw.schema.my_table
+        )
+        , inter as (
+            select * from my_cte_name_also_a_table_name
+        )
+        select * from inter
+        """
+        schema = {
+            "raw": {
+                "schema": {
+                    "my_cte_name_also_a_table_name": {"col_1": "int"},
+                    "my_table": {"col_a": "int"},
+                }
+            }
+        }
+
+        node = lineage("col_a", sql, schema=schema, dialect="snowflake")
+
+
+        self.assertEqual(node.name, "col_a")
+        self.assertEqual(
+            node.source.sql(),
+            "WITH my_cte_name_also_a_table_name AS (SELECT my_table.col_a AS col_a FROM raw.schema.my_table AS my_table), inter AS (SELECT my_cte_name_also_a_table_name.col_a AS col_a FROM my_cte_name_also_a_table_name) SELECT inter.col_a AS col_a FROM inter",
+        )
+        self.assertEqual(node.expression.sql(), "inter.col_a AS col_a")
+
+
+        inter_node = node.downstream[0]
+        self.assertEqual(inter_node.name, "inter.col_a")
+        self.assertEqual(
+            inter_node.source.sql(),
+            "SELECT my_cte_name_also_a_table_name.col_a AS col_a FROM my_cte_name_also_a_table_name",
+        )
+        self.assertEqual(
+            inter_node.expression.sql(),
+            "my_cte_name_also_a_table_name.col_a AS col_a",
+        )
+
+        cte_node = inter_node.downstream[0]
+        self.assertEqual(cte_node.name, "my_cte_name_also_a_table_name.col_a")
+        self.assertEqual(
+            cte_node.source.sql(),
+            "SELECT my_table.col_a AS col_a FROM raw.schema.my_table AS my_table",
+        )
+        self.assertEqual(cte_node.expression.sql(), "my_table.col_a AS col_a")
+
+        table_node = cte_node.downstream[0]
+        self.assertEqual(table_node.name, "my_table.col_a")
+        self.assertEqual(table_node.source.sql(), "raw.schema.my_table AS my_table")
+
