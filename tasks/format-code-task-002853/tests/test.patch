+                }
+            }
+        }
+
+        node = lineage("col_a", sql, schema=schema, dialect="snowflake")
+        self.assertEqual(node.name, "col_a")
+
+        cte_node = node.downstream[0]
+        self.assertEqual(cte_node.name, "my_cte_name_also_a_table_name.col_a")
+
+        self.assertEqual(
+            cte_node.source.sql(),
+            "SELECT my_table.col_a AS col_a FROM raw.schema.my_table AS my_table",
+        )
+        self.assertEqual(cte_node.expression.sql(), "my_table.col_a AS col_a")
+
+        table_node = cte_node.downstream[0]
+        self.assertEqual(table_node.name, "my_table.col_a")
+        self.assertEqual(table_node.source.sql(), "raw.schema.my_table AS my_table")
