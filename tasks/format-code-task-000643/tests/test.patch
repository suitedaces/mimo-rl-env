+/* eslint-env mocha */
+import FunctionTree, {sequence, parallel} from './'
+import assert from 'assert'
+
+describe('primitives', () => {
+  it('should expose sequence and parallel as functions', () => {
+    assert.equal(typeof sequence, 'function')
+    assert.equal(typeof parallel, 'function')
+  })
+
+  it('should run a sequence one item after the other and merge payload', (done) => {
+    const order = []
+    const execute = FunctionTree([])
+
+    execute.once('end', (execution, payload) => {
+      assert.deepEqual(order, ['a', 'b'])
+      assert.deepEqual(payload, {foo: 'bar', a: 1, b: 2})
+      done()
+    })
+
+    execute(sequence(
+      () => { order.push('a'); return {a: 1} },
+      () => { order.push('b'); return {b: 2} }
+    ), {foo: 'bar'})
+  })
+
+  it('should still treat a plain array as a sequence', (done) => {
+    const order = []
+    const execute = FunctionTree([])
+
+    execute.once('end', (execution, payload) => {
+      assert.deepEqual(order, ['a', 'b'])
+      assert.deepEqual(payload, {a: 1, b: 2})
+      done()
+    })
+
+    execute([
+      () => { order.push('a'); return {a: 1} },
+      () => { order.push('b'); return {b: 2} }
+    ])
+  })
+
+  it('should run parallel items concurrently and merge their payloads', (done) => {
+    const execute = FunctionTree([])
+    let resolveCount
+
+    execute.once('parallelStart', (execution, payload, functionsToResolve) => {
+      resolveCount = functionsToResolve
+    })
+    execute.once('end', (execution, payload) => {
+      assert.equal(resolveCount, 2)
+      assert.deepEqual(payload, {a: 1, b: 2})
+      done()
+    })
+
+    execute(parallel(
+      () => Promise.resolve({a: 1}),
+      () => Promise.resolve({b: 2})
+    ))
+  })
+
+  it('should run a grouped sequence inside parallel as a single branch', (done) => {
+    const order = []
+    const execute = FunctionTree([])
+    let resolveCount
+
+    execute.once('parallelStart', (execution, payload, functionsToResolve) => {
+      resolveCount = functionsToResolve
+    })
+    execute.once('end', () => {
+
+      assert.equal(resolveCount, 2)
+
+      assert.ok(order.indexOf('b') < order.indexOf('c'))
+      done()
+    })
+
+    execute(parallel(
+      () => { order.push('a'); return Promise.resolve() },
+      [
+        () => { order.push('b'); return Promise.resolve() },
+        () => { order.push('c') }
+      ]
+    ))
+  })
+
+  it('should not treat a nested plain array as parallel', (done) => {
+    const order = []
+    const execute = FunctionTree([])
+    let parallelStarted = false
+
+    execute.on('parallelStart', () => {
+      parallelStarted = true
+    })
+    execute.once('end', (execution, payload) => {
+      assert.equal(parallelStarted, false)
+      assert.deepEqual(order, ['a', 'b'])
+      assert.deepEqual(payload, {a: 1, b: 2})
+      done()
+    })
+
+    execute([
+      [
+        () => { order.push('a'); return Promise.resolve({a: 1}) },
+        () => { order.push('b'); return Promise.resolve({b: 2}) }
+      ]
+    ])
+  })
+
+  it('should accept an optional leading name on a sequence without running it', (done) => {
+    const order = []
+    let functionCount = 0
+    const execute = FunctionTree([])
+
+    execute.on('functionStart', () => {
+      functionCount++
+    })
+    execute.once('end', () => {
+      assert.equal(functionCount, 2)
+      assert.deepEqual(order, ['a', 'b'])
+      done()
+    })
+
+    execute(sequence('my sequence',
+      () => { order.push('a') },
+      () => { order.push('b') }
+    ))
+  })
+
+  it('should accept an optional leading name on a parallel without running it', (done) => {
+    const execute = FunctionTree([])
+    let resolveCount
+
+    execute.once('parallelStart', (execution, payload, functionsToResolve) => {
+      resolveCount = functionsToResolve
+    })
+    execute.once('end', (execution, payload) => {
+      assert.equal(resolveCount, 2)
+      assert.deepEqual(payload, {a: 1, b: 2})
+      done()
+    })
+
+    execute(parallel('the name',
+      () => Promise.resolve({a: 1}),
+      () => Promise.resolve({b: 2})
+    ))
+  })
+
+  it('should flag functions as parallel only when a direct branch of a parallel', (done) => {
+    const execute = FunctionTree([])
+    const flags = {}
+
+    execute.on('functionStart', (execution, funcDetails) => {
+      flags[funcDetails.name] = funcDetails.isParallel
+    })
+    execute.once('end', () => {
+      assert.equal(flags.pa, true)
+      assert.equal(flags.pb, true)
+      assert.equal(flags.sa, false)
+      done()
+    })
+
+    execute(parallel(
+      function pa () { return Promise.resolve() },
+      function pb () { return Promise.resolve() },
+      [
+        function sa () {}
+      ]
+    ))
+  })
+
+  it('should accept a primitive as the tree passed to execute', (done) => {
+    const execute = FunctionTree([])
+
+    execute.once('end', (execution, payload) => {
+      assert.deepEqual(payload, {done: true})
+      done()
+    })
+
+    execute(sequence(
+      () => ({done: true})
+    ))
+  })
+})
