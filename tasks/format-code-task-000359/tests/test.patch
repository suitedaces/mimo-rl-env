diff --git a/pkg/rulesConfig/defaultRules/rule10_jfrog_test.go b/pkg/rulesConfig/defaultRules/rule10_jfrog_test.go
new file mode 100644
index 0000000..c0ffee1
--- /dev/null
+++ b/pkg/rulesConfig/defaultRules/rule10_jfrog_test.go
@@ -0,0 +1,143 @@
+package defaultRules
+
+import (
+	"encoding/json"
+	"testing"
+
+	githubConnector "github.com/allero-io/allero/pkg/connectors/github"
+	gitlabConnector "github.com/allero-io/allero/pkg/connectors/gitlab"
+)
+
+const (
+	ownerName       = "owner-under-test"
+	repoWithScanner = "repo-with-sca"
+	repoNoScanner   = "repo-without-sca"
+)
+
+func githubWithJfrogPipeline(repoName string, commands []string) map[string]*githubConnector.GithubOwner {
+	return decodeGithubOwners(`{"` + ownerName + `":{"ownerName":"` + ownerName + `","repositories":{"` + repoName + `":{"name":"` + repoName + `","github-actions-workflows":{},"jfrog-pipelines":{"pipeline":{"content":` + jfrogPipelineContent(commands) + `}}}}}}`)
+}
+
+func gitlabWithJfrogPipeline(projectName string, commands []string) map[string]*gitlabConnector.GitlabGroup {
+	return decodeGitlabGroups(`{"` + ownerName + `":{"groupName":"` + ownerName + `","projects":{"` + projectName + `":{"name":"` + projectName + `","gitlab-ci":{},"jfrog-pipelines":{"pipeline":{"content":` + jfrogPipelineContent(commands) + `}}}}}}`)
+}
+
+func githubWithActionsRun(repoName string, command string) map[string]*githubConnector.GithubOwner {
+	body := `{"` + ownerName + `":{"ownerName":"` + ownerName + `","repositories":{"` + repoName + `":{"name":"` + repoName + `","github-actions-workflows":{"workflow":{"content":{"jobs":{"scan":{"steps":[{"run":` + jsonString(command) + `}]}}}}},"jfrog-pipelines":{}}}}}`
+	return decodeGithubOwners(body)
+}
+
+func githubWithoutPipelines(repoName string) map[string]*githubConnector.GithubOwner {
+	return decodeGithubOwners(`{"` + ownerName + `":{"ownerName":"` + ownerName + `","repositories":{"` + repoName + `":{"name":"` + repoName + `","github-actions-workflows":{},"jfrog-pipelines":{}}}}}`)
+}
+
+func gitlabWithoutPipelines(projectName string) map[string]*gitlabConnector.GitlabGroup {
+	return decodeGitlabGroups(`{"` + ownerName + `":{"groupName":"` + ownerName + `","projects":{"` + projectName + `":{"name":"` + projectName + `","gitlab-ci":{},"jfrog-pipelines":{}}}}}`)
+}
+
+func jfrogPipelineContent(commands []string) string {
+	encoded, err := json.Marshal(commands)
+	if err != nil {
+		panic(err)
+	}
+	return `{"pipelines":[{"steps":[{"execution":{"onExecute":` + string(encoded) + `}}]}]}`
+}
+
+func jsonString(value string) string {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		panic(err)
+	}
+	return string(encoded)
+}
+
+func decodeGithubOwners(body string) map[string]*githubConnector.GithubOwner {
+	var owners map[string]*githubConnector.GithubOwner
+	if err := json.Unmarshal([]byte(body), &owners); err != nil {
+		panic(err)
+	}
+	return owners
+}
+
+func decodeGitlabGroups(body string) map[string]*gitlabConnector.GitlabGroup {
+	var groups map[string]*gitlabConnector.GitlabGroup
+	if err := json.Unmarshal([]byte(body), &groups); err != nil {
+		panic(err)
+	}
+	return groups
+}
+
+func hasRepoError(errors []*SchemaError, scm, repo string) bool {
+	for _, schemaError := range errors {
+		if schemaError.ScmPlatform == scm && schemaError.RepositryName == repo {
+			return true
+		}
+	}
+	return false
+}
+
+func requireNoRepoError(t *testing.T, errors []*SchemaError, scm, repo string) {
+	t.Helper()
+	if hasRepoError(errors, scm, repo) {
+		t.Fatalf("expected %s/%s to satisfy Rule 10, got errors: %#v", scm, repo, errors)
+	}
+}
+
+func requireRepoError(t *testing.T, errors []*SchemaError, scm, repo string) {
+	t.Helper()
+	if !hasRepoError(errors, scm, repo) {
+		t.Fatalf("expected %s/%s to be reported by Rule 10, got errors: %#v", scm, repo, errors)
+	}
+}
+
+func TestRule10PassesWithOnlyJfrogPipelineScanner(t *testing.T) {
+	githubData := githubWithJfrogPipeline(repoWithScanner, []string{"jf xr scan --format=json"})
+	errors, err := EnsureScaScanner(githubData, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	requireNoRepoError(t, errors, "github", repoWithScanner)
+}
+
+func TestRule10PassesWithGitlabJfrogPipelineScanner(t *testing.T) {
+	gitlabData := gitlabWithJfrogPipeline(repoWithScanner, []string{"jf xr audit ."})
+	errors, err := EnsureScaScanner(nil, gitlabData)
+	if err != nil {
+		t.Fatal(err)
+	}
+	requireNoRepoError(t, errors, "gitlab", repoWithScanner)
+}
+
+func TestRule10RecognizesJfrogXrayCommandInGithubActions(t *testing.T) {
+	githubData := githubWithActionsRun(repoWithScanner, "jf xr scan .")
+	errors, err := EnsureScaScanner(githubData, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	requireNoRepoError(t, errors, "github", repoWithScanner)
+}
+
+func TestRule10DoesNotTreatUnrelatedJfrogCommandAsScanner(t *testing.T) {
+	githubData := githubWithJfrogPipeline(repoNoScanner, []string{"jfrog foo"})
+	errors, err := EnsureScaScanner(githubData, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	requireRepoError(t, errors, "github", repoNoScanner)
+}
+
+func TestRule10StillFailsWithoutAnyScanner(t *testing.T) {
+	githubData := githubWithoutPipelines(repoNoScanner)
+	gitlabData := gitlabWithoutPipelines(repoNoScanner)
+	errors, err := EnsureScaScanner(githubData, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	requireRepoError(t, errors, "github", repoNoScanner)
+
+	errors, err = EnsureScaScanner(nil, gitlabData)
+	if err != nil {
+		t.Fatal(err)
+	}
+	requireRepoError(t, errors, "gitlab", repoNoScanner)
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,16 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test ./pkg/rulesConfig/ -v -run TestDefaultRulesValidation
+    ;;
+  new)
+    go test ./pkg/rulesConfig/defaultRules/ -v -run 'TestRule10(PassesWithOnlyJfrogPipelineScanner|PassesWithGitlabJfrogPipelineScanner|RecognizesJfrogXrayCommandInGithubActions|DoesNotTreatUnrelatedJfrogCommandAsScanner|StillFailsWithoutAnyScanner)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
