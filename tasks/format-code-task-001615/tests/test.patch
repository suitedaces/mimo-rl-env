+
+@pytest.mark.django_db
+def test_rp_initiated_logout_anonymous_get_id_token_renders_form(oidc_tokens, client, rp_settings):
+    """Anonymous (no Django session) GET with valid id_token_hint should render the
+    confirmation form (status 200) without revoking any tokens yet."""
+    AccessToken = get_access_token_model()
+    assert AccessToken.objects.filter(user=oidc_tokens.user).count() == 1
+
+    rsp = client.get(
+        reverse("oauth2_provider:rp-initiated-logout"),
+        data={"id_token_hint": oidc_tokens.id_token},
+    )
+    assert rsp.status_code == 200
+
+    assert AccessToken.objects.filter(user=oidc_tokens.user).count() == 1
+
+
+@pytest.mark.django_db
+def test_rp_initiated_logout_anonymous_post_id_token_revokes_tokens(oidc_tokens, client, rp_settings):
+    """Anonymous (no Django session) POST allow=True with valid id_token_hint should
+    revoke the tokens of the id_token's user. This is the core bug fix."""
+    AccessToken = get_access_token_model()
+    RefreshToken = get_refresh_token_model()
+    IDToken = get_id_token_model()
+
+    assert AccessToken.objects.filter(user=oidc_tokens.user).count() == 1
+    assert RefreshToken.objects.filter(user=oidc_tokens.user).count() == 1
+    assert IDToken.objects.filter(user=oidc_tokens.user).count() == 1
+
+    form_data = {"id_token_hint": oidc_tokens.id_token, "allow": True}
+    rsp = client.post(reverse("oauth2_provider:rp-initiated-logout"), form_data)
+
+
+    assert rsp.status_code < 500
+
+    assert rsp.status_code == 302
+
+
+    assert AccessToken.objects.filter(user=oidc_tokens.user).count() == 0
+    assert RefreshToken.objects.filter(user=oidc_tokens.user, revoked__isnull=True).count() == 0
+    assert IDToken.objects.filter(user=oidc_tokens.user).count() == 0
+
+
+@pytest.mark.django_db
+def test_rp_initiated_logout_anonymous_post_with_redirect_uri(oidc_tokens, client, rp_settings):
+    """Anonymous POST allow=True with id_token_hint and post_logout_redirect_uri should
+    redirect to the URI and revoke the tokens."""
+    AccessToken = get_access_token_model()
+    assert AccessToken.objects.filter(user=oidc_tokens.user).count() == 1
+
+    form_data = {
+        "id_token_hint": oidc_tokens.id_token,
+        "post_logout_redirect_uri": "http://example.org",
+        "allow": True,
+    }
+    rsp = client.post(reverse("oauth2_provider:rp-initiated-logout"), form_data)
+    assert rsp.status_code == 302
+    assert rsp["Location"] == "http://example.org"
+    assert AccessToken.objects.filter(user=oidc_tokens.user).count() == 0
+
+
+@pytest.mark.django_db
+def test_rp_initiated_logout_anonymous_post_deny_keeps_tokens(oidc_tokens, client, rp_settings):
+    """Anonymous user posting WITHOUT allow=True should not revoke any tokens."""
+    AccessToken = get_access_token_model()
+    assert AccessToken.objects.filter(user=oidc_tokens.user).count() == 1
+
+    form_data = {"id_token_hint": oidc_tokens.id_token}
+    rsp = client.post(reverse("oauth2_provider:rp-initiated-logout"), form_data)
+
+    assert rsp.status_code < 500
+
+    assert AccessToken.objects.filter(user=oidc_tokens.user).count() == 1
+
+
+@pytest.mark.django_db
+def test_rp_initiated_logout_logged_in_user_still_revokes_tokens(
+    loggend_in_client, oidc_tokens, rp_settings
+):
+    """Preservation: logged-in user with matching id_token_hint should still revoke
+    tokens via GET (no prompt needed)."""
+    AccessToken = get_access_token_model()
+    assert AccessToken.objects.filter(user=oidc_tokens.user).count() == 1
+
+    rsp = loggend_in_client.get(
+        reverse("oauth2_provider:rp-initiated-logout"),
+        data={"id_token_hint": oidc_tokens.id_token},
+    )
+    assert rsp.status_code == 302
+    assert AccessToken.objects.filter(user=oidc_tokens.user).count() == 0
