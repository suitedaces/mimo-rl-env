+func TestSelect_BinaryExpr_NilValues_FloatArithmeticAllOps(t *testing.T) {
+	var ic IteratorCreator
+	ic.CreateIteratorFn = func(opt influxql.IteratorOptions) (influxql.Iterator, error) {
+		return &FloatIterator{Points: []influxql.FloatPoint{
+			{Name: "missing_float_ops", Time: 11 * Second, Value: 14.5, Aux: []interface{}{float64(14.5), nil}},
+			{Name: "missing_float_ops", Time: 17 * Second, Value: 9, Aux: []interface{}{float64(9), float64(3)}},
+			{Name: "missing_float_ops", Time: 23 * Second, Value: 2.5, Aux: []interface{}{nil, float64(2.5)}},
+		}}, nil
+	}
+
+	for _, test := range []struct {
+		Name      string
+		Statement string
+		Points    [][]influxql.Point
+	}{
+		{
+			Name:      "float add propagates missing operands",
+			Statement: `SELECT left_f + right_f FROM missing_float_ops`,
+			Points: [][]influxql.Point{
+				{&influxql.FloatPoint{Name: "missing_float_ops", Time: 11 * Second, Nil: true}},
+				{&influxql.FloatPoint{Name: "missing_float_ops", Time: 17 * Second, Value: 12}},
+				{&influxql.FloatPoint{Name: "missing_float_ops", Time: 23 * Second, Nil: true}},
+			},
+		},
+		{
+			Name:      "float subtract propagates missing operands",
+			Statement: `SELECT left_f - right_f FROM missing_float_ops`,
+			Points: [][]influxql.Point{
+				{&influxql.FloatPoint{Name: "missing_float_ops", Time: 11 * Second, Nil: true}},
+				{&influxql.FloatPoint{Name: "missing_float_ops", Time: 17 * Second, Value: 6}},
+				{&influxql.FloatPoint{Name: "missing_float_ops", Time: 23 * Second, Nil: true}},
+			},
+		},
+		{
+			Name:      "float multiply propagates missing operands",
+			Statement: `SELECT left_f * right_f FROM missing_float_ops`,
+			Points: [][]influxql.Point{
+				{&influxql.FloatPoint{Name: "missing_float_ops", Time: 11 * Second, Nil: true}},
+				{&influxql.FloatPoint{Name: "missing_float_ops", Time: 17 * Second, Value: 27}},
+				{&influxql.FloatPoint{Name: "missing_float_ops", Time: 23 * Second, Nil: true}},
+			},
+		},
+		{
+			Name:      "float division propagates missing operands",
+			Statement: `SELECT left_f / right_f FROM missing_float_ops`,
+			Points: [][]influxql.Point{
+				{&influxql.FloatPoint{Name: "missing_float_ops", Time: 11 * Second, Nil: true}},
+				{&influxql.FloatPoint{Name: "missing_float_ops", Time: 17 * Second, Value: 3}},
+				{&influxql.FloatPoint{Name: "missing_float_ops", Time: 23 * Second, Nil: true}},
+			},
+		},
+	} {
+		itrs, err := influxql.Select(MustParseSelectStatement(test.Statement), &ic, nil)
+		if err != nil {
+			t.Errorf("%s: parse error: %s", test.Name, err)
+		} else if a := Iterators(itrs).ReadAll(); !deep.Equal(a, test.Points) {
+			t.Errorf("%s: unexpected points: %s", test.Name, spew.Sdump(a))
+		}
+	}
+}
