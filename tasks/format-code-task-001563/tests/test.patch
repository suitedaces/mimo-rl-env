--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+export GOPATH=/root/go
+mkdir -p "$GOPATH/src/github.com/influxdata"
+ln -sfn /testbed "$GOPATH/src/github.com/influxdata/influxdb"
+
+if [ ! -d "$GOPATH/src/github.com/gogo/protobuf" ]; then
+  git clone --depth 1 https://github.com/gogo/protobuf.git "$GOPATH/src/github.com/gogo/protobuf" 2>/dev/null
+fi
+if [ ! -d "$GOPATH/src/github.com/davecgh/go-spew" ]; then
+  git clone --depth 1 https://github.com/davecgh/go-spew.git "$GOPATH/src/github.com/davecgh/go-spew" 2>/dev/null
+fi
+
+cd "$GOPATH/src/github.com/influxdata/influxdb"
+
+
+case "${1:-}" in
+  base)
+    GO111MODULE=off go test ./influxql/ -v -count=1 -timeout 120s -run '^(TestSelect_BinaryExpr_Float|TestSelect_BinaryExpr_Integer|TestSelect_BinaryExpr_Mixed)$'
+    ;;
+  new)
+    GO111MODULE=off go test ./influxql/ -v -count=1 -timeout 120s -run '^(TestSelect_BinaryExpr_NilValues|TestSelect_BinaryExpr_NilValues_FloatArithmeticAllOps|TestSelect_BinaryExpr_NilValues_IntegerArithmeticAllOps|TestSelect_BinaryExpr_NilValues_MixedFloatIntegerArithmeticAllOps)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
