+func TestSelect_BinaryExpr_NilValues_IntegerArithmeticAllOps(t *testing.T) {
+	var ic IteratorCreator
+	ic.CreateIteratorFn = func(opt influxql.IteratorOptions) (influxql.Iterator, error) {
+		return &IntegerIterator{Points: []influxql.IntegerPoint{
+			{Name: "missing_integer_ops", Time: 31 * Second, Value: 21, Aux: []interface{}{int64(21), nil}},
+			{Name: "missing_integer_ops", Time: 37 * Second, Value: 20, Aux: []interface{}{int64(20), int64(4)}},
+			{Name: "missing_integer_ops", Time: 43 * Second, Value: 6, Aux: []interface{}{nil, int64(6)}},
+		}}, nil
+	}
+
+	for _, test := range []struct {
+		Name      string
+		Statement string
+		Points    [][]influxql.Point
+	}{
+		{
+			Name:      "integer add propagates missing operands",
+			Statement: `SELECT left_i + right_i FROM missing_integer_ops`,
+			Points: [][]influxql.Point{
+				{&influxql.IntegerPoint{Name: "missing_integer_ops", Time: 31 * Second, Nil: true}},
+				{&influxql.IntegerPoint{Name: "missing_integer_ops", Time: 37 * Second, Value: 24}},
+				{&influxql.IntegerPoint{Name: "missing_integer_ops", Time: 43 * Second, Nil: true}},
+			},
+		},
+		{
+			Name:      "integer subtract propagates missing operands",
+			Statement: `SELECT left_i - right_i FROM missing_integer_ops`,
+			Points: [][]influxql.Point{
+				{&influxql.IntegerPoint{Name: "missing_integer_ops", Time: 31 * Second, Nil: true}},
+				{&influxql.IntegerPoint{Name: "missing_integer_ops", Time: 37 * Second, Value: 16}},
+				{&influxql.IntegerPoint{Name: "missing_integer_ops", Time: 43 * Second, Nil: true}},
+			},
+		},
+		{
+			Name:      "integer multiply propagates missing operands",
+			Statement: `SELECT left_i * right_i FROM missing_integer_ops`,
+			Points: [][]influxql.Point{
+				{&influxql.IntegerPoint{Name: "missing_integer_ops", Time: 31 * Second, Nil: true}},
+				{&influxql.IntegerPoint{Name: "missing_integer_ops", Time: 37 * Second, Value: 80}},
+				{&influxql.IntegerPoint{Name: "missing_integer_ops", Time: 43 * Second, Nil: true}},
+			},
+		},
+		{
+			Name:      "integer division propagates missing operands",
+			Statement: `SELECT left_i / right_i FROM missing_integer_ops`,
+			Points: [][]influxql.Point{
+				{&influxql.FloatPoint{Name: "missing_integer_ops", Time: 31 * Second, Nil: true}},
+				{&influxql.FloatPoint{Name: "missing_integer_ops", Time: 37 * Second, Value: 5}},
+				{&influxql.FloatPoint{Name: "missing_integer_ops", Time: 43 * Second, Nil: true}},
+			},
+		},
+	} {
+		itrs, err := influxql.Select(MustParseSelectStatement(test.Statement), &ic, nil)
+		if err != nil {
+			t.Errorf("%s: parse error: %s", test.Name, err)
+		} else if a := Iterators(itrs).ReadAll(); !deep.Equal(a, test.Points) {
+			t.Errorf("%s: unexpected points: %s", test.Name, spew.Sdump(a))
+		}
+	}
+}
