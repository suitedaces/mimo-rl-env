--- /dev/null
+++ b/usercase-test-coderl/conditional_move_tree.test.ts
@@ -0,0 +1,217 @@
+
+
+
+
+
+
+
+
+
+
+
+import { ConditionalMoveTree } from "engine";
+
+describe("ConditionalMoveTree acceptance", () => {
+    test("constructor, manual child insertion, and encode expose the session state", () => {
+
+
+
+
+        const root = new ConditionalMoveTree(null);
+
+        expect(root.move).toBeNull();
+        expect(root.parent).toBeUndefined();
+        expect(root.children).toEqual({});
+        expect(root.encode()).toEqual([null, {}]);
+
+        root.children["aa"] = new ConditionalMoveTree("bb", root);
+
+        expect(root.children["aa"].move).toBe("bb");
+        expect(root.children["aa"].parent).toBe(root);
+        expect(root.children["aa"].children).toEqual({});
+        expect(root.encode()).toEqual([null, { aa: ["bb", {}] }]);
+    });
+
+    test("decode rebuilds a nested response tree with parent links", () => {
+
+
+
+
+        const root = ConditionalMoveTree.decode([null, { aa: ["bb", { cc: ["dd", {}] }] }]);
+
+        expect(root.move).toBeNull();
+        expect(root.parent).toBeUndefined();
+        expect(root.encode()).toEqual([null, { aa: ["bb", { cc: ["dd", {}] }] }]);
+        expect(root.children["aa"].move).toBe("bb");
+        expect(root.children["aa"].parent).toBe(root);
+        expect(root.children["aa"].children["cc"].move).toBe("dd");
+        expect(root.children["aa"].children["cc"].parent).toBe(root.children["aa"]);
+    });
+
+    test("getChild returns existing children and creates detached missing children", () => {
+
+
+
+
+        const root = new ConditionalMoveTree(null);
+        root.children["aa"] = new ConditionalMoveTree("bb", root);
+
+        const existing = root.getChild("aa");
+        expect(existing).toBe(root.children["aa"]);
+        expect(existing.encode()).toEqual(["bb", {}]);
+
+        const missing = root.getChild("cc");
+        expect(missing.move).toBeNull();
+        expect(missing.parent).toBe(root);
+        expect(missing.children).toEqual({});
+        expect(missing.encode()).toEqual([null, {}]);
+        expect(root.encode()).toEqual([null, { aa: ["bb", {}] }]);
+    });
+
+    test("duplicate returns a deep copy whose nested mutations do not affect the original", () => {
+
+
+
+
+        const original = ConditionalMoveTree.decode([null, { aa: ["bb", { cc: ["dd", {}] }] }]);
+        const copy = original.duplicate();
+
+        expect(copy).not.toBe(original);
+        expect(copy.encode()).toEqual([null, { aa: ["bb", { cc: ["dd", {}] }] }]);
+        expect(copy.children["aa"]).not.toBe(original.children["aa"]);
+
+        expect(copy.children["aa"].parent).not.toBe(original);
+
+        copy.children["aa"].children["ee"] = new ConditionalMoveTree("ff", copy.children["aa"]);
+
+        expect(copy.encode()).toEqual([
+            null,
+            { aa: ["bb", { cc: ["dd", {}], ee: ["ff", {}] }] },
+        ]);
+        expect(original.encode()).toEqual([null, { aa: ["bb", { cc: ["dd", {}] }] }]);
+    });
+
+    test("merge keeps non-conflicting branches and recursively merges same-response branches", () => {
+
+
+
+
+        const left = ConditionalMoveTree.decode([
+            null,
+            { aa: ["bb", { cc: ["dd", {}] }], gg: ["hh", {}] },
+        ]);
+        const right = ConditionalMoveTree.decode([
+            null,
+            { aa: ["bb", { ee: ["ff", {}] }], ii: ["jj", {}] },
+        ]);
+
+        const merged = left.merge(right);
+
+        expect(merged.move).toBeNull();
+        expect(merged.parent).toBeUndefined();
+
+        expect(merged.children["aa"].parent).not.toBe(left);
+        expect(merged.children["aa"].parent).not.toBe(right);
+        expect(merged.encode()).toEqual([
+            null,
+            {
+                aa: ["bb", { cc: ["dd", {}], ee: ["ff", {}] }],
+                gg: ["hh", {}],
+                ii: ["jj", {}],
+            },
+        ]);
+        expect(left.encode()).toEqual([null, { aa: ["bb", { cc: ["dd", {}] }], gg: ["hh", {}] }]);
+        expect(right.encode()).toEqual([
+            null,
+            { aa: ["bb", { ee: ["ff", {}] }], ii: ["jj", {}] },
+        ]);
+    });
+
+    test("merge replaces a conflicting planned response with the branch from other", () => {
+
+
+
+
+        const left = ConditionalMoveTree.decode([
+            null,
+            { aa: ["bb", { cc: ["dd", {}] }], gg: ["hh", {}] },
+        ]);
+        const right = ConditionalMoveTree.decode([null, { aa: ["zz", { kk: ["ll", {}] }] }]);
+
+        const merged = left.merge(right);
+
+        expect(merged.encode()).toEqual([
+            null,
+            { aa: ["zz", { kk: ["ll", {}] }], gg: ["hh", {}] },
+        ]);
+
+        expect(merged.children["aa"].parent).not.toBe(left);
+        expect(merged.children["aa"].parent).not.toBe(right);
+        expect(merged.children["aa"].children["kk"].parent).not.toBe(right.children["aa"]);
+    });
+
+    test("fromMoveDiff builds one-response and nested response trees", () => {
+
+
+
+
+
+        expect(ConditionalMoveTree.fromMoveDiff("aabb").encode()).toEqual([
+            null,
+            { aa: ["bb", {}] },
+        ]);
+        expect(ConditionalMoveTree.fromMoveDiff("aabbccdd").encode()).toEqual([
+            null,
+            { aa: ["bb", { cc: ["dd", {}] }] },
+        ]);
+    });
+
+    test("fromMoveDiff rejects an odd-length move string with the exact Error contract", () => {
+
+
+
+
+        expect(() => ConditionalMoveTree.fromMoveDiff("abc")).toThrow(Error);
+        expect(() => ConditionalMoveTree.fromMoveDiff("abc")).toThrow("invalid move string");
+    });
+
+    test("two independent tree instances keep their own children maps", () => {
+
+
+
+
+        const a = new ConditionalMoveTree(null);
+        const b = new ConditionalMoveTree(null);
+
+        a.children["aa"] = new ConditionalMoveTree("bb", a);
+        b.children["cc"] = new ConditionalMoveTree("dd", b);
+
+        expect(a.encode()).toEqual([null, { aa: ["bb", {}] }]);
+        expect(b.encode()).toEqual([null, { cc: ["dd", {}] }]);
+        expect(a.children["aa"].parent).toBe(a);
+        expect(b.children["cc"].parent).toBe(b);
+    });
+
+    test("repeated construct-use-drop sessions remain bounded to each fresh tree", () => {
+
+
+
+
+        for (let i = 0; i < 150; i += 1) {
+            const base = ConditionalMoveTree.fromMoveDiff("aabbccdd");
+            const copy = base.duplicate();
+            copy.children["aa"].children["ee"] = new ConditionalMoveTree("ff", copy.children["aa"]);
+            const merged = base.merge(copy);
+
+            expect(base.encode()).toEqual([null, { aa: ["bb", { cc: ["dd", {}] }] }]);
+            expect(copy.encode()).toEqual([
+                null,
+                { aa: ["bb", { cc: ["dd", {}], ee: ["ff", {}] }] },
+            ]);
+            expect(merged.encode()).toEqual([
+                null,
+                { aa: ["bb", { cc: ["dd", {}], ee: ["ff", {}] }] },
+            ]);
+        }
+    });
+});
