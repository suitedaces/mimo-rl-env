+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+if [ ! -x node_modules/.bin/jest ]; then
+    echo "Missing local Jest binary at node_modules/.bin/jest; dependencies must be preinstalled for offline test runs." >&2
+    exit 1
+fi
+
+exec node_modules/.bin/jest \
+    --testMatch '**/usercase-test-coderl/**/*.test.ts' \
+    --coverage=false \
+    --testTimeout=10000 \
+    --watchman=false \
+    --verbose
