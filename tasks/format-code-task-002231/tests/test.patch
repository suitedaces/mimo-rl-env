+
+    def test_dropna_ignore_index_issue_example(self):
+
+        df = DataFrame({"A": [0, pd.NA, 1]})
+        result = df.dropna(ignore_index=True)
+        expected = df.dropna().reset_index(drop=True)
+        tm.assert_frame_equal(result, expected)
+
+        assert list(result.index) == [0, 1]
+
+    def test_dropna_ignore_index_true_resets_index(self):
+
+        df = DataFrame(
+            {"A": [1.0, np.nan, 3.0, 4.0], "B": [10, 20, 30, np.nan]},
+            index=[100, 200, 300, 400],
+        )
+        result = df.dropna(ignore_index=True)
+        expected = DataFrame({"A": [1.0, 4.0], "B": [10.0, np.nan]}, index=[0, 1])
+
+        expected = df.dropna().reset_index(drop=True)
+        tm.assert_frame_equal(result, expected)
+        assert list(result.index) == list(range(len(result)))
+
+    def test_dropna_ignore_index_false_preserves_index(self):
+
+        df = DataFrame({"A": [1.0, np.nan, 3.0]}, index=[10, 20, 30])
+        result = df.dropna(ignore_index=False)
+        assert list(result.index) == [10, 30]
+
+    def test_dropna_ignore_index_default_preserves_index(self):
+
+        df = DataFrame({"A": [1.0, np.nan, 3.0]}, index=[10, 20, 30])
+        result = df.dropna()
+        assert list(result.index) == [10, 30]
+
+    def test_dropna_ignore_index_inplace(self):
+
+        df = DataFrame({"A": [1.0, np.nan, 3.0]}, index=[10, 20, 30])
+        ret = df.dropna(ignore_index=True, inplace=True)
+        assert ret is None
+        assert list(df.index) == [0, 1]
+        tm.assert_frame_equal(
+            df, DataFrame({"A": [1.0, 3.0]}, index=[0, 1])
+        )
+
+    def test_dropna_ignore_index_no_nan(self):
+
+        df = DataFrame({"A": [1.0, 2.0, 3.0]}, index=[10, 20, 30])
+        result = df.dropna(ignore_index=True)
+        assert list(result.index) == [0, 1, 2]
+        tm.assert_frame_equal(
+            result, DataFrame({"A": [1.0, 2.0, 3.0]}, index=[0, 1, 2])
+        )
