 from twilio.base.page import Page
 from twilio.http.response import Response
 
@@ -64,3 +65,94 @@ class VersionTestCase(IntegrationTestCase):
         messages = list(self.version.stream(self.page, page_limit=1))
 
         self.assertEqual(len(messages), 2)
+
+
+class VersionFetchStatusCodeTestCase(IntegrationTestCase):
+    """
+    Tests for Version.fetch() handling of HTTP status codes.
+
+    Reproduces the 307 redirect issue from Bulk Exports' Days resource:
+    a GET on a Day instance returns 307 with a JSON body of
+    {"redirect_to": "<signed-url>"}. fetch() must NOT raise on 3xx
+    responses; it must return the parsed JSON body so callers can read
+    the redirect_to URL.
+    """
+
+    URI = '/Accounts/AC123/Messages.json'
+    ABS_URL = 'https://api.twilio.com/2010-04-01/Accounts/AC123/Messages.json'
+
+    def setUp(self):
+        super(VersionFetchStatusCodeTestCase, self).setUp()
+        self.version = self.client.api.v2010
+
+    def _mock(self, status, body):
+        self.holodeck.mock(Response(status, body), Request(url=self.ABS_URL))
+
+    def test_fetch_307_with_redirect_to_returns_parsed_body(self):
+
+        self._mock(307, '{"redirect_to": "https://s3.example.com/signed/foo.json.gz"}')
+
+        payload = self.version.fetch(method='GET', uri=self.URI)
+
+        self.assertEqual(payload, {'redirect_to': 'https://s3.example.com/signed/foo.json.gz'})
+
+    def test_fetch_300_returns_parsed_body(self):
+        self._mock(300, '{"key": "value-300"}')
+        payload = self.version.fetch(method='GET', uri=self.URI)
+        self.assertEqual(payload, {'key': 'value-300'})
+
+    def test_fetch_301_returns_parsed_body(self):
+        self._mock(301, '{"key": "value-301"}')
+        payload = self.version.fetch(method='GET', uri=self.URI)
+        self.assertEqual(payload, {'key': 'value-301'})
+
+    def test_fetch_302_returns_parsed_body(self):
+        self._mock(302, '{"key": "value-302"}')
+        payload = self.version.fetch(method='GET', uri=self.URI)
+        self.assertEqual(payload, {'key': 'value-302'})
+
+    def test_fetch_308_returns_parsed_body(self):
+        self._mock(308, '{"key": "value-308"}')
+        payload = self.version.fetch(method='GET', uri=self.URI)
+        self.assertEqual(payload, {'key': 'value-308'})
+
+    def test_fetch_200_still_returns_parsed_body(self):
+
+        self._mock(200, '{"ok": true}')
+        payload = self.version.fetch(method='GET', uri=self.URI)
+        self.assertEqual(payload, {'ok': True})
+
+    def test_fetch_400_still_raises(self):
+
+        self._mock(400, '{"message": "bad request"}')
+        with self.assertRaises(TwilioRestException):
+            self.version.fetch(method='GET', uri=self.URI)
+
+    def test_fetch_404_still_raises(self):
+        self._mock(404, '{"message": "not found"}')
+        with self.assertRaises(TwilioRestException):
+            self.version.fetch(method='GET', uri=self.URI)
+
+    def test_fetch_500_still_raises(self):
+
+        self._mock(500, '')
+        with self.assertRaises(TwilioRestException):
+            self.version.fetch(method='GET', uri=self.URI)
+
+    def test_fetch_bulkexports_day_307_does_not_raise(self):
+
+
+        self.holodeck.mock(Response(
+            307,
+            '{"redirect_to": "https://s3.example.com/signed/Messages-2020-06-01.json.gz"}'
+        ), Request(
+            url='https://bulkexports.twilio.com/v1/Exports/Messages/Days/2020-06-01'
+        ))
+
+        instance = self.client.bulkexports.v1.exports('Messages').days('2020-06-01').fetch()
+
+        self.assertIsNotNone(instance)
+        self.assertEqual(
+            instance.redirect_to,
+            'https://s3.example.com/signed/Messages-2020-06-01.json.gz',
+        )
