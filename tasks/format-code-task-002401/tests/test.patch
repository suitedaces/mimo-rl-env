diff --git a/test/crs/test_crs_cf.py b/test/crs/test_crs_cf.py
index 68f62eb4..a96ea52e 100644
--- a/test/crs/test_crs_cf.py
+++ b/test/crs/test_crs_cf.py
@@ -1,3 +1,5 @@
+import warnings
+
 import numpy
 import pytest
 from numpy.testing import assert_almost_equal
@@ -2045,3 +2047,137 @@ def test_milisecond_temporal_crs__coordinate_system():
             "axis": "T",
         }
     ]
+
+
+
+
+
+
+
+def _coord_op_params_to_dict(crs):
+    return {p.name: p.value for p in crs.coordinate_operation.params}
+
+
+def test_issue1506_from_cf_default_skew_angle_is_90_via_coord_op():
+
+
+
+    crs = CRS.from_cf(
+        dict(
+            grid_mapping_name="oblique_mercator",
+            azimuth_of_central_line=0.35,
+            latitude_of_projection_origin=10,
+            longitude_of_projection_origin=15,
+            reference_ellipsoid_name="WGS84",
+            false_easting=0.0,
+            false_northing=0.0,
+        )
+    )
+    params = _coord_op_params_to_dict(crs)
+    assert params["Angle from Rectified to Skew Grid"] == 90.0
+
+
+def test_issue1506_from_cf_default_skew_to_dict_gamma_is_90():
+
+
+    crs = CRS.from_cf(
+        dict(
+            grid_mapping_name="oblique_mercator",
+            azimuth_of_central_line=0.35,
+            latitude_of_projection_origin=10,
+            longitude_of_projection_origin=15,
+            reference_ellipsoid_name="WGS84",
+            false_easting=0.0,
+            false_northing=0.0,
+        )
+    )
+    with pytest.warns(UserWarning):
+        proj_dict = crs.to_dict()
+    assert proj_dict["gamma"] == 90
+
+
+def test_issue1506_from_cf_issue_exact_repro_skew_is_90():
+
+
+    crs = CRS.from_cf(
+        {
+            "grid_mapping_name": "oblique_mercator",
+            "azimuth_of_central_line": 90.0,
+            "latitude_of_projection_origin": 46.0,
+            "longitude_of_projection_origin": 263.0,
+            "scale_factor_at_projection_origin": 1.0,
+            "false_easting": 0.0,
+            "false_northing": 0.0,
+        }
+    )
+    params = _coord_op_params_to_dict(crs)
+    assert params["Angle from Rectified to Skew Grid"] == 90.0
+
+
+def test_issue1506_to_cf_warns_when_gamma_is_zero():
+
+
+    crs = CRS(
+        "+proj=omerc +lat_0=10 +lonc=15 +alpha=0.35 "
+        "+gamma=0 +k=1 +x_0=0 +y_0=0"
+    )
+    with pytest.warns(
+        UserWarning,
+        match="angle from rectified to skew grid parameter lost in conversion to CF",
+    ):
+        crs.to_cf()
+
+
+def test_issue1506_to_cf_no_skew_warning_when_gamma_is_90():
+
+
+    crs = CRS(
+        "+proj=omerc +lat_0=10 +lonc=15 +alpha=0.35 "
+        "+gamma=90 +k=1 +x_0=0 +y_0=0"
+    )
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always")
+        crs.to_cf()
+    skew_msgs = [
+        str(w.message)
+        for w in caught
+        if "skew grid" in str(w.message)
+    ]
+    assert skew_msgs == []
+
+
+def test_issue1506_to_cf_warns_when_gamma_is_arbitrary():
+
+    crs = CRS(
+        "+proj=omerc +lat_0=-36.10360962430914 +lonc=147.0632291727015 "
+        "+alpha=-54.78622979612904 +k=1 +x_0=0 +y_0=0 +gamma=-54.78622979612904"
+    )
+    with pytest.warns(
+        UserWarning,
+        match="angle from rectified to skew grid parameter lost in conversion to CF",
+    ):
+        crs.to_cf()
+
+
+def test_issue1506_roundtrip_cf_no_skew_warning():
+
+
+    cf_in = dict(
+        grid_mapping_name="oblique_mercator",
+        azimuth_of_central_line=0.35,
+        latitude_of_projection_origin=10,
+        longitude_of_projection_origin=15,
+        reference_ellipsoid_name="WGS84",
+        false_easting=0.0,
+        false_northing=0.0,
+    )
+    crs = CRS.from_cf(cf_in)
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always")
+        crs.to_cf()
+    skew_msgs = [
+        str(w.message)
+        for w in caught
+        if "skew grid" in str(w.message)
+    ]
+    assert skew_msgs == []
