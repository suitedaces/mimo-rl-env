+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+required_modules=(
+  async
+  aws-sdk
+  bunyan
+  chai
+  joi
+  lodash
+  mocha
+  node-uuid
+)
+
+for module in "${required_modules[@]}"; do
+  if [ ! -f "node_modules/${module}/package.json" ]; then
+    echo "Missing vendored npm dependency: ${module}" >&2
+    exit 127
+  fi
+done
+
+if [ ! -f ./node_modules/mocha/bin/_mocha ]; then
+  echo "Missing vendored Mocha runner" >&2
+  exit 127
+fi
+
+exec node ./node_modules/mocha/bin/_mocha --opts /dev/null /workspace/repo/usercase-test-coderl/timestamps.test.js --reporter spec
