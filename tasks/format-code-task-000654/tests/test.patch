@@ -0,0 +1,71 @@
+import os
+import subprocess
+import sys
+import textwrap
+import unittest
+
+from chainer import testing
+
+
+class TestResizeNoCv2Fallback(unittest.TestCase):
+
+    def _run_no_cv2_case(self, channels, height, width, out_h, out_w):
+        script = r'''
+import builtins
+import numpy as np
+
+real_import = builtins.__import__
+
+def blocked_import(name, globals=None, locals=None, fromlist=(), level=0):
+    if name == 'cv2' or name.startswith('cv2.'):
+        raise ImportError('cv2 blocked by resize fallback test')
+    return real_import(name, globals, locals, fromlist, level)
+
+builtins.__import__ = blocked_import
+
+from chainercv.transforms import resize
+
+channels = {channels}
+height = {height}
+width = {width}
+out_h = {out_h}
+out_w = {out_w}
+
+base = np.arange(height * width, dtype=np.float32).reshape((height, width))
+img = np.stack([base + 1000 * channel for channel in range(channels)])
+out = resize(img, output_shape=(out_h, out_w))
+
+assert out.shape == (channels, out_h, out_w), out.shape
+assert np.ptp(out[-1]) > 0
+if channels > 1:
+    assert not np.allclose(out[0], out[-1])
+'''.format(
+            channels=channels, height=height, width=width,
+            out_h=out_h, out_w=out_w)
+        env = os.environ.copy()
+        repo_root = os.getcwd()
+        env['PYTHONPATH'] = os.pathsep.join(
+            [repo_root, env.get('PYTHONPATH', '')]).rstrip(os.pathsep)
+        proc = subprocess.Popen(
+            [sys.executable, '-c', textwrap.dedent(script)],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
+        stdout, stderr = proc.communicate()
+        self.assertEqual(
+            proc.returncode, 0,
+            msg='stdout:\n{}\nstderr:\n{}'.format(
+                stdout.decode('utf-8'), stderr.decode('utf-8')))
+
+    def test_fallback_preserves_single_channel(self):
+        self._run_no_cv2_case(1, 13, 21, 8, 10)
+
+    def test_fallback_preserves_two_channels(self):
+        self._run_no_cv2_case(2, 10, 14, 6, 11)
+
+    def test_fallback_preserves_four_channels(self):
+        self._run_no_cv2_case(4, 9, 13, 5, 12)
+
+    def test_fallback_preserves_extra_channels(self):
+        self._run_no_cv2_case(5, 11, 15, 7, 9)
+
+
+testing.run_module(__name__, __file__)
