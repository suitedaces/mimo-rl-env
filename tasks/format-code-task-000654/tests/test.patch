+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+set +u
+source /testbed/.venv/bin/activate
+set -u
+
+case "${1:-}" in
+  base)
+    python -m pytest \
+      tests/transforms_tests/image_tests/test_resize.py::TestResize::test_resize_color \
+      -v
+    ;;
+  new)
+    python -m pytest \
+      tests/transforms_tests/image_tests/test_resize.py::TestResize::test_resize_grayscale_preserves_channel \
+      tests/transforms_tests/image_tests/test_resize.py::TestResize::test_resize_grayscale_with_cv2_like_backend \
+      tests/transforms_tests/image_tests/test_resize_no_cv2_fallback.py \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
