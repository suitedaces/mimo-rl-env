@@ -0,0 +1,24 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+set +u
+source /testbed/.build_env/venv/bin/activate
+set -u
+
+python -m pip install 'setuptools_scm>=7.1.0,<8.0.0'
+python setup.py egg_info >/dev/null
+
+case "${1:-}" in
+  base)
+    python -m pytest -n0 tests/functional/syntax/test_interfaces.py -k 'not default_function' -x -v
+    ;;
+  new)
+    python -m pytest -n0 tests/functional/syntax/test_interfaces.py -k 'default_function' tests/functional/syntax/test_default_function.py -x -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
