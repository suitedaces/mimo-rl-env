+
+def test_intrinsic_interfaces_default_function_rejected_outside_pytest_env():
+    code = """
+import os
+import textwrap
+from pathlib import Path
+from tempfile import TemporaryDirectory
+from vyper import compiler
+from vyper.compiler.input_bundle import FilesystemInputBundle
+from vyper.exceptions import CallViolation
+
+os.environ.pop("PYTEST_CURRENT_TEST", None)
+lib1 = textwrap.dedent('''
+@external
+@payable
+def __default__():
+    pass
+''')
+main = textwrap.dedent('''
+import lib1
+
+@external
+def baz():
+    extcall lib1.__at__(self).__default__()
+''')
+with TemporaryDirectory() as td:
+    Path(td, "lib1.vy").write_text(lib1)
+    input_bundle = FilesystemInputBundle([Path(td)])
+    try:
+        compiler.compile_code(main, contract_path="main.vy", input_bundle=input_bundle)
+    except CallViolation:
+        raise SystemExit(0)
+raise SystemExit(1)
+"""
+    env = os.environ.copy()
+    env.pop("PYTEST_CURRENT_TEST", None)
+    result = subprocess.run([sys.executable, "-c", code], env=env, check=False)
+    assert result.returncode == 0
+
+
+def test_intrinsic_interfaces_default_function_self_call():
+    source = """
+@external
+@view
+def __default__() -> int128:
+    return 43
+
+@external
+def bar():
+    foo: int128 = 0
+    foo = self.__default__()
+"""
+
+    with pytest.raises(CallViolation):
+        compiler.compile_code(source)
