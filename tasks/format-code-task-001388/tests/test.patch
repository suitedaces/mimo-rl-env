diff --git a/public/app/plugins/datasource/grafana-azure-monitor-datasource/components/MonitorConfig.test.tsx b/public/app/plugins/datasource/grafana-azure-monitor-datasource/components/MonitorConfig.test.tsx
new file mode 100644
index 00000000000..7e778955fa7
--- /dev/null
+++ b/public/app/plugins/datasource/grafana-azure-monitor-datasource/components/MonitorConfig.test.tsx
@@ -0,0 +1,74 @@
+import React from 'react';
+import { shallow } from 'enzyme';
+import { MonitorConfig, Props } from './MonitorConfig';
+import { AzureCredentialsForm } from './AzureCredentialsForm';
+
+const setup = (propsFunc?: (props: Props) => Props) => {
+  let props: Props = {
+    options: {
+      id: 21,
+      uid: 'x',
+      orgId: 1,
+      name: 'Azure Monitor-10-10',
+      type: 'grafana-azure-monitor-datasource',
+      typeName: 'Azure',
+      typeLogoUrl: '',
+      access: 'proxy',
+      url: '',
+      password: '',
+      user: '',
+      database: '',
+      basicAuth: false,
+      basicAuthUser: '',
+      basicAuthPassword: '',
+      withCredentials: false,
+      isDefault: false,
+      secureJsonFields: {},
+      jsonData: {
+        cloudName: 'azuremonitor',
+        subscriptionId: '',
+      },
+      version: 1,
+      readOnly: false,
+    },
+    updateOptions: jest.fn(),
+    getSubscriptions: jest.fn(),
+  };
+
+  if (propsFunc) {
+    props = propsFunc(props);
+  }
+
+  return shallow(<MonitorConfig {...props} />);
+};
+
+describe('MonitorConfig readOnly', () => {
+  it('should pass disabled=true to AzureCredentialsForm when options.readOnly is true', () => {
+    const wrapper = setup((props) => ({
+      ...props,
+
+
+      disabled: true,
+      options: {
+        ...props.options,
+        readOnly: true,
+      },
+    } as any));
+    const form = wrapper.find(AzureCredentialsForm);
+    expect(form.exists()).toBe(true);
+    expect(form.prop('disabled')).toBe(true);
+  });
+
+  it('should pass disabled=false (or falsy) to AzureCredentialsForm when options.readOnly is false', () => {
+    const wrapper = setup((props) => ({
+      ...props,
+      options: {
+        ...props.options,
+        readOnly: false,
+      },
+    }));
+    const form = wrapper.find(AzureCredentialsForm);
+    expect(form.exists()).toBe(true);
+    expect(form.prop('disabled')).toBeFalsy();
+  });
+});
