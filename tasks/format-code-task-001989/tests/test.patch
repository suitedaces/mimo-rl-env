diff --git a/test_content_semicolon.js b/test_content_semicolon.js
new file mode 100644
index 0000000..b8546c7
--- /dev/null
+++ b/test_content_semicolon.js
@@ -0,0 +1,126 @@
+
+
+
+
+
+var Slowparse = require("./slowparse.js"),
+    jsdom = require("jsdom").jsdom,
+    document = jsdom("<!doctype html><html><head></head><body></body></html>"),
+    validators = require("./test/node/qunit-shim.js")(Slowparse, jsdom);
+
+var test = validators.test;
+var equal = validators.equal;
+
+test("content with single-quoted semicolon then next property", function() {
+  var css = "h1::before{content:'&lt;';color:red}";
+  var html = '<style>' + css + '</style>';
+  var result = Slowparse.HTML(document, html);
+  equal(result.error, null);
+  var styleContents = result.document.childNodes[0].childNodes[0];
+  var rule = styleContents.parseInfo.rules[0];
+  equal(rule.declarations.properties.length, 2);
+  equal(rule.declarations.properties[0].name.value, "content");
+  equal(rule.declarations.properties[0].value.value, "'&lt;'");
+  equal(rule.declarations.properties[1].name.value, "color");
+  equal(rule.declarations.properties[1].value.value, "red");
+});
+
+test("content with double-quoted semicolon then next property", function() {
+  var css = 'h1::before{content:"a;b";color:red}';
+  var html = '<style>' + css + '</style>';
+  var result = Slowparse.HTML(document, html);
+  equal(result.error, null);
+  var styleContents = result.document.childNodes[0].childNodes[0];
+  var rule = styleContents.parseInfo.rules[0];
+  equal(rule.declarations.properties.length, 2);
+  equal(rule.declarations.properties[0].name.value, "content");
+  equal(rule.declarations.properties[0].value.value, '"a;b"');
+  equal(rule.declarations.properties[1].name.value, "color");
+  equal(rule.declarations.properties[1].value.value, "red");
+});
+
+test("content with multiple semicolons inside quotes", function() {
+  var css = "h1::before{content:'a;b;c;d';color:red}";
+  var html = '<style>' + css + '</style>';
+  var result = Slowparse.HTML(document, html);
+  equal(result.error, null);
+  var styleContents = result.document.childNodes[0].childNodes[0];
+  var rule = styleContents.parseInfo.rules[0];
+  equal(rule.declarations.properties.length, 2);
+  equal(rule.declarations.properties[0].value.value, "'a;b;c;d'");
+  equal(rule.declarations.properties[1].value.value, "red");
+});
+
+test("content with semicolon inside quotes and trailing semicolon only", function() {
+  var css = "h1::before{content:'a;b';}";
+  var html = '<style>' + css + '</style>';
+  var result = Slowparse.HTML(document, html);
+  equal(result.error, null);
+  var styleContents = result.document.childNodes[0].childNodes[0];
+  var rule = styleContents.parseInfo.rules[0];
+  equal(rule.declarations.properties.length, 1);
+  equal(rule.declarations.properties[0].name.value, "content");
+  equal(rule.declarations.properties[0].value.value, "'a;b'");
+});
+
+test("content following another property, with quoted semicolon", function() {
+  var css = "h1::before{color:red;content:'&lt;';font-weight:bold}";
+  var html = '<style>' + css + '</style>';
+  var result = Slowparse.HTML(document, html);
+  equal(result.error, null);
+  var styleContents = result.document.childNodes[0].childNodes[0];
+  var rule = styleContents.parseInfo.rules[0];
+  equal(rule.declarations.properties.length, 3);
+  equal(rule.declarations.properties[0].name.value, "color");
+  equal(rule.declarations.properties[0].value.value, "red");
+  equal(rule.declarations.properties[1].name.value, "content");
+  equal(rule.declarations.properties[1].value.value, "'&lt;'");
+  equal(rule.declarations.properties[2].name.value, "font-weight");
+  equal(rule.declarations.properties[2].value.value, "bold");
+});
+
+test("content with escaped quote followed by semicolon inside quotes", function() {
+
+  var css = "h1::before{content:'\\\';';color:red}";
+  var html = '<style>' + css + '</style>';
+  var result = Slowparse.HTML(document, html);
+  equal(result.error, null);
+  var styleContents = result.document.childNodes[0].childNodes[0];
+  var rule = styleContents.parseInfo.rules[0];
+  equal(rule.declarations.properties.length, 2);
+  equal(rule.declarations.properties[0].name.value, "content");
+  equal(rule.declarations.properties[1].name.value, "color");
+  equal(rule.declarations.properties[1].value.value, "red");
+});
+
+test("content without semicolon inside quotes still parses (preservation)", function() {
+  var css = "h1::before{content:'hello';color:red}";
+  var html = '<style>' + css + '</style>';
+  var result = Slowparse.HTML(document, html);
+  equal(result.error, null);
+  var styleContents = result.document.childNodes[0].childNodes[0];
+  var rule = styleContents.parseInfo.rules[0];
+  equal(rule.declarations.properties.length, 2);
+  equal(rule.declarations.properties[0].value.value, "'hello'");
+  equal(rule.declarations.properties[1].value.value, "red");
+});
+
+test("regular non-content CSS still parses normally (preservation)", function() {
+  var css = "body { color: pink; font-size: 12px; }";
+  var html = '<style>' + css + '</style>';
+  var result = Slowparse.HTML(document, html);
+  equal(result.error, null);
+  var styleContents = result.document.childNodes[0].childNodes[0];
+  var rule = styleContents.parseInfo.rules[0];
+  equal(rule.declarations.properties.length, 2);
+  equal(rule.declarations.properties[0].name.value, "color");
+  equal(rule.declarations.properties[0].value.value, "pink");
+  equal(rule.declarations.properties[1].name.value, "font-size");
+  equal(rule.declarations.properties[1].value.value, "12px");
+});
+
+var failCount = validators.getFailCount();
+if (failCount > 0) {
+  console.log(failCount + " tests failed.");
+}
+process.exit(failCount);
