+def test_public_webhook_http_methods_includes_patch():
+    assert "PATCH" in PUBLIC_WEBHOOK_HTTP_METHODS
+
+    assert set(PUBLIC_WEBHOOK_HTTP_METHODS) == {"GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"}
+
+
+@pytest.mark.django_db
+def test_make_request_patch_dispatches_to_requests_patch(make_organization, make_custom_webhook):
+    organization = make_organization()
+    webhook = make_custom_webhook(organization=organization, http_method="PATCH")
+    with patch("apps.webhooks.models.webhook.requests") as mock_requests:
+        webhook.make_request("url", {"foo": "bar"})
+
+        assert mock_requests.patch.called
+        assert mock_requests.patch.call_args == call("url", timeout=OUTGOING_WEBHOOK_TIMEOUT, foo="bar")
+        assert not mock_requests.get.called
+        assert not mock_requests.post.called
+        assert not mock_requests.put.called
+        assert not mock_requests.delete.called
+        assert not mock_requests.options.called
+
+
+@pytest.mark.django_db
+def test_build_request_kwargs_patch_forward_all(make_organization, make_custom_webhook):
+    organization = make_organization()
+    webhook = make_custom_webhook(organization=organization, http_method="PATCH", forward_all=True)
+    request_kwargs = webhook.build_request_kwargs({"foo": "bar"})
+
+    assert request_kwargs == {"headers": {}, "json": {"foo": "bar"}}
+
+
+@pytest.mark.django_db
+def test_build_request_kwargs_patch_custom_data(make_organization, make_custom_webhook):
+    organization = make_organization()
+    webhook = make_custom_webhook(
+        organization=organization, http_method="PATCH", data="{{foo}}", forward_all=False
+    )
+    request_kwargs = webhook.build_request_kwargs({"foo": "bar", "something": "else"})
+
+    assert request_kwargs == {"headers": {}, "data": "bar"}
+
+
+@pytest.mark.django_db
+def test_make_request_patch_with_forwarded_data(make_organization, make_custom_webhook):
+    """End-to-end: PATCH webhook forwards json body via requests.patch."""
+    organization = make_organization()
+    webhook = make_custom_webhook(organization=organization, http_method="PATCH", forward_all=True)
+    event_data = {"alert_group_id": "x", "alert_payload": {"msg": "hi"}}
+    request_kwargs = webhook.build_request_kwargs(event_data)
+    with patch("apps.webhooks.models.webhook.requests") as mock_requests:
+        webhook.make_request("http://example.com", request_kwargs)
+        assert mock_requests.patch.called
+        assert mock_requests.patch.call_args == call(
+            "http://example.com", timeout=OUTGOING_WEBHOOK_TIMEOUT, headers={}, json=event_data
+        )
+
+
