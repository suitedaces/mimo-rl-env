diff --git a/usercase-test-coderl/generate-winget-import.test.js b/usercase-test-coderl/generate-winget-import.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/generate-winget-import.test.js
@@ -0,0 +1,181 @@
+
+
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import generateWingetImport from "../utils/generateWingetImport.js";
+
+test("generates winget import JSON for the selected apps and versions", async () => {
+
+
+  const apps = [
+    { _id: "Microsoft.VisualStudioCode", selectedVersion: "1.90.0" },
+    { _id: "Git.Git", selectedVersion: "2.45.1" },
+  ];
+
+  const actual = await generateWingetImport(apps);
+
+  assert.deepStrictEqual(actual, {
+    $schema: "https://aka.ms/winget-packages.schema.1.0.json",
+    WinGetVersion: "0.3.11201",
+    Sources: [
+      {
+        Packages: [
+          { Id: "Microsoft.VisualStudioCode", Version: "1.90.0" },
+          { Id: "Git.Git", Version: "2.45.1" },
+        ],
+        SourceDetails: {
+          Argument: "https://winget.azureedge.net/cache",
+          Identifier: "Microsoft.Winget.Source_8wekyb3d8bbwe",
+          Name: "winget",
+          Type: "Microsoft.PreIndexed.Package",
+        },
+      },
+    ],
+  });
+});
+
+test("generates the schema and source wrapper for an empty app selection", async () => {
+
+
+  const apps = [];
+
+  const actual = await generateWingetImport(apps);
+
+  assert.deepStrictEqual(actual, {
+    $schema: "https://aka.ms/winget-packages.schema.1.0.json",
+    WinGetVersion: "0.3.11201",
+    Sources: [
+      {
+        Packages: [],
+        SourceDetails: {
+          Argument: "https://winget.azureedge.net/cache",
+          Identifier: "Microsoft.Winget.Source_8wekyb3d8bbwe",
+          Name: "winget",
+          Type: "Microsoft.PreIndexed.Package",
+        },
+      },
+    ],
+  });
+});
+
+test("uses only each app object's id and selected version when building packages", async () => {
+
+
+  const apps = [
+    { _id: "Mozilla.Firefox", selectedVersion: "127.0", name: "Firefox" },
+  ];
+
+  const actual = await generateWingetImport(apps);
+
+  assert.deepStrictEqual(actual, {
+    $schema: "https://aka.ms/winget-packages.schema.1.0.json",
+    WinGetVersion: "0.3.11201",
+    Sources: [
+      {
+        Packages: [
+          { Id: "Mozilla.Firefox", Version: "127.0" },
+        ],
+        SourceDetails: {
+          Argument: "https://winget.azureedge.net/cache",
+          Identifier: "Microsoft.Winget.Source_8wekyb3d8bbwe",
+          Name: "winget",
+          Type: "Microsoft.PreIndexed.Package",
+        },
+      },
+    ],
+  });
+});
+
+test("rejects null with TypeError", async () => {
+
+
+  await assert.rejects(() => generateWingetImport(null), TypeError);
+});
+
+test("rejects a non-array object with TypeError", async () => {
+
+
+  await assert.rejects(
+    () => generateWingetImport({ _id: "Git.Git", selectedVersion: "2.45.1" }),
+    TypeError,
+  );
+});
+
+test("is referentially transparent for repeated calls with the same input", async () => {
+  const apps = [
+    { _id: "VideoLAN.VLC", selectedVersion: "3.0.21" },
+  ];
+
+  assert.deepStrictEqual(
+    await generateWingetImport(apps),
+    await generateWingetImport(apps),
+  );
+});
+
+test("does not mutate the caller's app array or app objects", async () => {
+  const apps = [
+    { _id: "Microsoft.PowerToys", selectedVersion: "0.82.1", pinned: true },
+    { _id: "7zip.7zip", selectedVersion: "24.07", tags: ["archive"] },
+  ];
+  const before = JSON.parse(JSON.stringify(apps));
+
+  await generateWingetImport(apps);
+
+  assert.deepStrictEqual(apps, before);
+});
+
+test("generates the spec-mandated import JSON for another selected app", async () => {
+  const apps = [
+    { _id: "Microsoft.Edge", selectedVersion: "126.0.2592.87" },
+  ];
+  const actual = await generateWingetImport(apps);
+
+
+  assert.deepStrictEqual(actual, {
+    $schema: "https://aka.ms/winget-packages.schema.1.0.json",
+    WinGetVersion: "0.3.11201",
+    Sources: [
+      {
+        Packages: [
+          { Id: "Microsoft.Edge", Version: "126.0.2592.87" },
+        ],
+        SourceDetails: {
+          Argument: "https://winget.azureedge.net/cache",
+          Identifier: "Microsoft.Winget.Source_8wekyb3d8bbwe",
+          Name: "winget",
+          Type: "Microsoft.PreIndexed.Package",
+        },
+      },
+    ],
+  });
+});
+
+test("generates import JSON from selected app data without mutating input", async () => {
+  const apps = [
+    { _id: "Git.Git", selectedVersion: "2.45.1", ignored: "metadata" },
+  ];
+  const before = JSON.parse(JSON.stringify(apps));
+
+  const actual = await generateWingetImport(apps);
+
+
+  assert.deepStrictEqual(actual, {
+    $schema: "https://aka.ms/winget-packages.schema.1.0.json",
+    WinGetVersion: "0.3.11201",
+    Sources: [
+      {
+        Packages: [
+          { Id: "Git.Git", Version: "2.45.1" },
+        ],
+        SourceDetails: {
+          Argument: "https://winget.azureedge.net/cache",
+          Identifier: "Microsoft.Winget.Source_8wekyb3d8bbwe",
+          Name: "winget",
+          Type: "Microsoft.PreIndexed.Package",
+        },
+      },
+    ],
+  });
+
+  assert.deepStrictEqual(apps, before);
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+
+if [ ! -d /workspace/repo/node_modules ]; then
+  echo "Missing /workspace/repo/node_modules; offline test command will not run npm install." >&2
+  exit 1
+fi
+exec node --test /workspace/repo/usercase-test-coderl/generate-winget-import.test.js
