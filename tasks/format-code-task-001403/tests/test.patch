index a9a5e54..57d4880 100644
--- a/src/__tests__/gatsby-node.js
+++ b/src/__tests__/gatsby-node.js
@@ -292,3 +292,123 @@ describe('gatsby-plugin-remote-images', () => {
     });
   });
 });
+
+describe('gatsby-plugin-remote-images array path traversal (issue #pictures[].url)', () => {
+  beforeEach(() => {
+    createRemoteFileNode.mockClear();
+  });
+
+  const collectionNode = {
+    id: 'pic-collection-1',
+    parent: null,
+    pictures: [
+      { id: 'pic-a', url: 'https://example.com/a.png' },
+      { id: 'pic-b', url: 'https://example.com/b.png' },
+      { id: 'pic-c', url: 'https://example.com/c.png' },
+    ],
+    internal: {
+      contentDigest: 'd',
+      type: 'PictureCollection',
+      mediaType: 'application/json',
+    },
+  };
+  const arrayPathOptions = {
+    nodeType: 'PictureCollection',
+    imagePath: 'pictures[].url',
+  };
+
+  it('downloads an image for each url under array path', async () => {
+    const helpers = getGatsbyNodeHelperMocks();
+    await onCreateNode(
+      { node: collectionNode, ...helpers },
+      arrayPathOptions
+    );
+    expect(createRemoteFileNode).toHaveBeenCalledTimes(3);
+    const calledUrls = createRemoteFileNode.mock.calls
+      .map(call => call[0].url)
+      .sort();
+    expect(calledUrls).toEqual([
+      'https://example.com/a.png',
+      'https://example.com/b.png',
+      'https://example.com/c.png',
+    ]);
+  });
+
+  it('registers a [File] array resolver when imagePath uses "[]." traversal (no type=array)', () => {
+    const mockCreateResolvers = jest.fn();
+    const cache = { get: jest.fn() };
+    createResolvers(
+      { cache, createResolvers: mockCreateResolvers },
+      arrayPathOptions
+    );
+    expect(mockCreateResolvers).toHaveBeenCalledTimes(1);
+    const resolverDef =
+      mockCreateResolvers.mock.calls[0][0].PictureCollection.localImage;
+    expect(resolverDef.type).toBe('[File]');
+    expect(typeof resolverDef.resolve).toBe('function');
+  });
+
+  it('resolver returns an array of File nodes from cached array of ids', async () => {
+    const cache = {
+      get: jest
+        .fn()
+        .mockResolvedValue({ localImage: ['fid-1', 'fid-2', 'fid-3'] }),
+      set: jest.fn(),
+    };
+    const mockCreateResolvers = jest.fn();
+    createResolvers(
+      { cache, createResolvers: mockCreateResolvers },
+      arrayPathOptions
+    );
+    const resolverDef =
+      mockCreateResolvers.mock.calls[0][0].PictureCollection.localImage;
+
+    const getNodeById = jest.fn(({ id }) => ({ id, isFileNode: true }));
+    const result = await resolverDef.resolve(
+      { id: 'pic-collection-1' },
+      null,
+      { nodeModel: { getNodeById } }
+    );
+    expect(Array.isArray(result)).toBe(true);
+    expect(result).toHaveLength(3);
+    expect(getNodeById).toHaveBeenCalledTimes(3);
+    expect(getNodeById).toHaveBeenCalledWith({ id: 'fid-1' });
+    expect(getNodeById).toHaveBeenCalledWith({ id: 'fid-2' });
+    expect(getNodeById).toHaveBeenCalledWith({ id: 'fid-3' });
+  });
+
+  it('end-to-end: stores all 3 file ids so resolver returns 3 File nodes', async () => {
+    const cacheMap = new Map();
+    const cache = {
+      get: jest.fn(async key => cacheMap.get(key)),
+      set: jest.fn(async (key, val) => {
+        cacheMap.set(key, val);
+      }),
+    };
+    const helpers = getGatsbyNodeHelperMocks();
+    helpers.cache = cache;
+    let nextId = 1;
+    helpers.createNodeId = jest.fn(() => `remoteFile${nextId++}`);
+
+    await onCreateNode({ node: collectionNode, ...helpers }, arrayPathOptions);
+
+    const mockCreateResolvers = jest.fn();
+    createResolvers(
+      { cache, createResolvers: mockCreateResolvers },
+      arrayPathOptions
+    );
+    const resolverDef =
+      mockCreateResolvers.mock.calls[0][0].PictureCollection.localImage;
+
+    const getNodeById = jest.fn(({ id }) => ({ id }));
+    const result = await resolverDef.resolve(
+      collectionNode,
+      null,
+      { nodeModel: { getNodeById } }
+    );
+    expect(Array.isArray(result)).toBe(true);
+    expect(result).toHaveLength(3);
+    const returnedIds = result.map(r => r.id).sort();
+    expect(returnedIds).toEqual(['remoteFile1', 'remoteFile2', 'remoteFile3']);
+  });
+});
