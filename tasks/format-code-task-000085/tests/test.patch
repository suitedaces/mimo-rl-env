diff --git a/tests/envs/test_env_implementation.py b/tests/envs/test_env_implementation.py
index f9ae75328..445190694 100644
--- a/tests/envs/test_env_implementation.py
+++ b/tests/envs/test_env_implementation.py
@@ -365,3 +365,159 @@ def test_discrete_action_validation(env_id):
     discrete_action = discrete_env.action_space.sample()
     discrete_env.step(discrete_action)
     discrete_env.close()
+
+
+def test_taxi_constructor_signature_defaults():
+    """`is_rainy` and `fickle_passenger` exist on TaxiEnv.__init__ and default to False."""
+    import inspect
+
+    sig = inspect.signature(TaxiEnv.__init__)
+    assert "is_rainy" in sig.parameters
+    assert "fickle_passenger" in sig.parameters
+    assert sig.parameters["is_rainy"].default is False
+    assert sig.parameters["fickle_passenger"].default is False
+
+
+    env = TaxiEnv()
+    env.close()
+
+    env_rainy = TaxiEnv(is_rainy=True)
+    env_rainy.close()
+    env_fickle = TaxiEnv(fickle_passenger=True)
+    env_fickle.close()
+
+
+def test_taxi_default_transitions_are_deterministic():
+    """Without flags, every entry of env.P has exactly one transition with prob 1.0."""
+    env = TaxiEnv()
+    for state in env.P:
+        for action in env.P[state]:
+            transitions = env.P[state][action]
+            assert len(transitions) == 1, (
+                f"default Taxi P[{state}][{action}] should have 1 transition, "
+                f"got {len(transitions)}"
+            )
+            prob = transitions[0][0]
+            assert prob == 1.0
+
+
+def test_taxi_rainy_movement_transitions():
+    """is_rainy=True: movement actions (0..3) have 3 entries with probs 0.8, 0.1, 0.1."""
+    env = TaxiEnv(is_rainy=True)
+    for state in env.P:
+        for action in range(4):
+            transitions = env.P[state][action]
+            assert len(transitions) == 3, (
+                f"rainy Taxi P[{state}][{action}] should have 3 transitions, "
+                f"got {len(transitions)}"
+            )
+            probs = sorted(t[0] for t in transitions)
+
+            assert probs == [pytest.approx(0.1), pytest.approx(0.1), pytest.approx(0.8)]
+            assert sum(t[0] for t in transitions) == pytest.approx(1.0)
+
+
+def test_taxi_rainy_intended_direction_has_highest_prob():
+    """is_rainy=True: for movement actions the intended destination state carries 0.8 prob."""
+    env_dry = TaxiEnv()
+    env_rainy = TaxiEnv(is_rainy=True)
+
+    state = env_dry.encode(2, 2, 0, 1)
+    for action in range(4):
+
+        intended_next = env_dry.P[state][action][0][1]
+        rainy_transitions = env_rainy.P[state][action]
+
+        big_prob_states = [s for p, s, _, _ in rainy_transitions if p == pytest.approx(0.8)]
+        assert len(big_prob_states) == 1
+        assert big_prob_states[0] == intended_next, (
+            f"rainy intended next state for action {action} mismatches dry version"
+        )
+
+
+def test_taxi_rainy_pickup_and_dropoff_remain_deterministic():
+    """is_rainy=True: pickup (4) and dropoff (5) actions still have prob 1.0 single transitions."""
+    env = TaxiEnv(is_rainy=True)
+    for state in env.P:
+        for action in (4, 5):
+            transitions = env.P[state][action]
+            assert len(transitions) == 1, (
+                f"rainy Taxi P[{state}][{action}] for pickup/dropoff should have 1 transition, "
+                f"got {len(transitions)}"
+            )
+            assert transitions[0][0] == 1.0
+
+
+def test_taxi_fickle_passenger_can_change_destination_after_first_move():
+    """fickle_passenger=True: after pickup + a few movements, the destination may change.
+
+    The issue spec says the destination changes with probability 0.3 once the taxi has
+    picked up the passenger and moved. The exact step on which the change occurs (the
+    very first move vs. a subsequent move while one square away) is not pinned down by
+    the issue, so we run a few movements and check that across many seeds the destination
+    has changed in a non-trivial fraction of trials.
+    """
+    trials = 300
+    changed = 0
+    for seed in range(trials):
+        env = TaxiEnv(fickle_passenger=True)
+        env.reset(seed=seed)
+
+        env.unwrapped.s = env.unwrapped.encode(0, 0, 0, 1)
+
+        obs, _, _, _, _ = env.step(4)
+        _, _, pass_loc, _ = env.unwrapped.decode(obs)
+        assert pass_loc == 4, "passenger should be inside the taxi after pickup"
+
+
+
+        moves = [0, 1, 0, 1, 0]
+        dest = 1
+        for a in moves:
+            obs, _, _, _, _ = env.step(a)
+            _, _, _, dest = env.unwrapped.decode(obs)
+            if dest != 1:
+                break
+        if dest != 1:
+            changed += 1
+        env.close()
+
+    assert 20 < changed < trials, (
+        f"fickle_passenger destination changes happened {changed}/{trials} times; "
+        "expected destination to change in a non-trivial fraction of trials."
+    )
+
+
+def test_taxi_non_fickle_destination_never_changes():
+    """fickle_passenger=False (default): destination stays fixed across many pickups+moves."""
+    for seed in range(50):
+        env = TaxiEnv()
+        env.reset(seed=seed)
+        env.unwrapped.s = env.unwrapped.encode(0, 0, 0, 1)
+        obs, _, _, _, _ = env.step(4)
+
+        for a in (0, 1, 0, 1, 0):
+            obs, _, _, _, _ = env.step(a)
+            _, _, _, dest = env.unwrapped.decode(obs)
+            assert dest == 1, (
+                f"non-fickle Taxi destination should remain 1 (got {dest}) for seed={seed}"
+            )
+        env.close()
+
+
+def test_taxi_rainy_step_info_prob_is_consistent_with_P():
+    """is_rainy=True: step() returns info['prob'] equal to the sampled transition's prob in P."""
+    env = TaxiEnv(is_rainy=True)
+    env.reset(seed=123)
+    for _ in range(50):
+        a = env.action_space.sample()
+        before_state = env.unwrapped.s
+        obs, _, term, _, info = env.step(a)
+
+        allowed_probs = {t[0] for t in env.unwrapped.P[before_state][a]}
+        assert info["prob"] in allowed_probs, (
+            f"step prob {info['prob']} not in P[{before_state}][{a}] probs {allowed_probs}"
+        )
+        if term:
+            env.reset(seed=123)
+    env.close()
