diff --git a/mne_bids/tests/test_path.py b/mne_bids/tests/test_path.py
index bcf42f68..b82e96a3 100644
--- a/mne_bids/tests/test_path.py
+++ b/mne_bids/tests/test_path.py
@@ -1491,3 +1491,96 @@ def test_dont_create_dirs_on_fpath_access(tmp_path):
     bp = BIDSPath(subject="01", datatype="eeg", root=tmp_path)
     bp.fpath  # accessing .fpath is required for this regression test
     assert not (tmp_path / "sub-01").exists()
+
+
+def test_bidspath_basename_uses_recording_long_form():
+    """BIDSPath.basename uses BIDS-spec 'recording-' (not 'rec-')."""
+    bp = BIDSPath(subject="01", recording="seven", suffix="physio", check=False)
+    assert "_recording-seven" in bp.basename
+    assert "_rec-seven" not in bp.basename
+    assert bp.basename == "sub-01_recording-seven_physio"
+
+
+def test_bidspath_basename_full_entities_recording_long_form():
+    """Full-entities BIDSPath basename uses 'recording-' (not 'rec-')."""
+    bp = BIDSPath(
+        subject="one",
+        session="two",
+        task="three",
+        acquisition="four",
+        run=1,
+        processing="six",
+        recording="seven",
+        suffix="ieeg",
+        extension=".json",
+        datatype="ieeg",
+    )
+    expected = (
+        "sub-one_ses-two_task-three_acq-four_run-1_proc-six_"
+        "recording-seven_ieeg.json"
+    )
+    assert bp.basename == expected
+
+
+def test_allowed_path_entities_short_uses_recording_key():
+    """ALLOWED_PATH_ENTITIES_SHORT maps 'recording' -> 'recording', no 'rec'."""
+    assert "rec" not in ALLOWED_PATH_ENTITIES_SHORT
+    assert ALLOWED_PATH_ENTITIES_SHORT["recording"] == "recording"
+
+
+def test_get_entities_from_fname_parses_recording_entity():
+    """get_entities_from_fname parses '_recording-A_' filenames."""
+    fname = "sub-01_recording-A_physio.tsv"
+    entities = get_entities_from_fname(fname)
+    assert entities["recording"] == "A"
+    assert entities["subject"] == "01"
+
+
+def test_get_entities_from_fname_rejects_legacy_rec_entity():
+    """get_entities_from_fname raises KeyError on legacy '_rec-' filenames."""
+    fname = "sub-01_rec-A_physio.tsv"
+    with pytest.raises(KeyError, match="Unexpected entity"):
+        get_entities_from_fname(fname, on_error="raise")
+
+
+def test_find_matching_paths_filters_by_recording(tmp_path):
+    """find_matching_paths(recordings=...) filters files named with 'recording-'."""
+    eeg_dir = tmp_path / "sub-01" / "eeg"
+    eeg_dir.mkdir(parents=True)
+    file_a = eeg_dir / "sub-01_recording-A_physio.tsv"
+    file_b = eeg_dir / "sub-01_recording-B_physio.tsv"
+    file_a.touch()
+    file_b.touch()
+
+
+    all_paths = find_matching_paths(tmp_path)
+    names_all = sorted(p.fpath.name for p in all_paths)
+    assert names_all == [
+        "sub-01_recording-A_physio.tsv",
+        "sub-01_recording-B_physio.tsv",
+    ]
+
+
+    found = find_matching_paths(tmp_path, recordings="A")
+    found_names = [p.fpath.name for p in found]
+    assert found_names == ["sub-01_recording-A_physio.tsv"]
+
+
+    found_b = find_matching_paths(tmp_path, recordings="B")
+    found_b_names = [p.fpath.name for p in found_b]
+    assert found_b_names == ["sub-01_recording-B_physio.tsv"]
+
+
+def test_find_matching_paths_recording_list_filter(tmp_path):
+    """find_matching_paths(recordings=[...]) accepts list and filters correctly."""
+    eeg_dir = tmp_path / "sub-01" / "eeg"
+    eeg_dir.mkdir(parents=True)
+    for rec in ("A", "B", "C"):
+        (eeg_dir / f"sub-01_recording-{rec}_physio.tsv").touch()
+
+    found = find_matching_paths(tmp_path, recordings=["A", "C"])
+    names = sorted(p.fpath.name for p in found)
+    assert names == [
+        "sub-01_recording-A_physio.tsv",
+        "sub-01_recording-C_physio.tsv",
+    ]
