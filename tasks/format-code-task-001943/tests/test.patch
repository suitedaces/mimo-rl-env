+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+python -m pytest -v -rA mne_bids/tests/test_path.py::test_bidspath_basename_uses_recording_long_form mne_bids/tests/test_path.py::test_bidspath_basename_full_entities_recording_long_form mne_bids/tests/test_path.py::test_allowed_path_entities_short_uses_recording_key mne_bids/tests/test_path.py::test_get_entities_from_fname_parses_recording_entity mne_bids/tests/test_path.py::test_get_entities_from_fname_rejects_legacy_rec_entity mne_bids/tests/test_path.py::test_find_matching_paths_filters_by_recording mne_bids/tests/test_path.py::test_find_matching_paths_recording_list_filter
+rc=$(( rc | $? ))
+exit $rc
