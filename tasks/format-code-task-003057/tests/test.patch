+import Testing.ZopeTestCase
+
+
+class TestMessageDialog(Testing.ZopeTestCase.ZopeTestCase):
+
+    def _render_dialog_to_response(self, **kw):
+        from App.Dialogs import MessageDialog
+
+        body = MessageDialog(**kw)
+        self.app.REQUEST.RESPONSE.setBody(body)
+        return body, self.app.REQUEST.RESPONSE
+
+    def test_publish_set_content_type(self):
+        body, response = self._render_dialog_to_response(
+            title='dialog title',
+            message='dialog message',
+            action='action',
+        )
+        self.assertIn('dialog title', body)
+        self.assertIn('dialog message', body)
+        self.assertIn('action', body)
+        self.assertIn('text/html', response.getHeader('Content-Type'))
+
+    def test_message_dialog_varied_content_is_html(self):
+        body, response = self._render_dialog_to_response(
+            title='second dialog title',
+            message='different dialog body',
+            action='continue-here',
+        )
+        self.assertIn('second dialog title', body)
+        self.assertIn('different dialog body', body)
+        self.assertIn('continue-here', body)
+        self.assertIn('text/html', response.getHeader('Content-Type'))
+
+    def test_message_dialog_default_action_without_pytest_marker_is_html(self):
+        import os
+
+        marker = os.environ.pop('PYTEST_CURRENT_TEST', None)
+        try:
+            body, response = self._render_dialog_to_response(
+                title='default action dialog',
+                message='body from default action path',
+            )
+        finally:
+            if marker is not None:
+                os.environ['PYTEST_CURRENT_TEST'] = marker
+
+        self.assertIn('default action dialog', body)
+        self.assertIn('body from default action path', body)
+        self.assertIn('text/html', response.getHeader('Content-Type'))
