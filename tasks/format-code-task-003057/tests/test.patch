+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+export PYTHONPATH="/testbed/src${PYTHONPATH:+:$PYTHONPATH}"
+
+case "${1:-}" in
+  base)
+    python3 -m pytest \
+      src/ZPublisher/tests/test_WSGIPublisher.py::WSGIResponseTests::test_finalize_sets_content_length_if_missing \
+      src/ZPublisher/tests/test_WSGIPublisher.py::TestPublishModule::testCustomExceptionViewNotFound \
+      -q
+    ;;
+  new)
+    python3 -m pytest \
+      src/App/tests/test_Dialogs.py::TestMessageDialog::test_publish_set_content_type \
+      src/App/tests/test_Dialogs.py::TestMessageDialog::test_message_dialog_varied_content_is_html \
+      src/App/tests/test_Dialogs.py::TestMessageDialog::test_message_dialog_default_action_without_pytest_marker_is_html \
+      src/ZPublisher/tests/test_WSGIPublisher.py::TestPublishModule::testCustomExceptionViewNotFoundUsesHtmlContentType \
+      src/ZPublisher/tests/test_WSGIPublisher.py::TestPublishModule::testCustomExceptionViewKeepsExistingContentType \
+      src/ZPublisher/tests/test_WSGIPublisher.py::TestPublishModule::testCustomExceptionViewRoutedBadRequestUsesHtmlContentType \
+      src/ZPublisher/tests/test_WSGIPublisher.py::TestPublishModule::testCustomExceptionViewKeepsAlternateExistingContentType \
+      src/ZPublisher/tests/test_WSGIPublisher.py::TestPublishModule::testCustomExceptionViewKeepsExceptionHeaderContentType \
+      -q
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
