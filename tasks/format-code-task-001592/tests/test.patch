+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+
+
+case "${1:-}" in
+  base)
+    go test -v -run '^(TestAnalyzersInAll|TestAnalyzersHaveUniqueNames|TestAnalyzersHaveDescription)$' ./galley/pkg/config/analysis/analyzers/
+    ;;
+  new)
+    go test -v -run '^(TestAnalyzeServicePortNamingInvalidPorts|TestAnalyzeServicePortNamingInvalidPortsOutsideOriginalFixtures|TestPortNameDiagnosticCarriesPortDetails|TestAnalyzeServicePortNamingValidPortsSilent|TestAnalyzeServicePortNamingAdditionalValidPortsSilent|TestAllAnalyzersIncludeServicePortNamingBehavior)$' ./galley/pkg/config/analysis/analyzers/
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
