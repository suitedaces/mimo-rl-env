+
+
+
+
+
+
+package analyzers
+
+import (
+	"fmt"
+	"io"
+	"strings"
+	"testing"
+
+	"istio.io/istio/galley/pkg/config/analysis/diag"
+	"istio.io/istio/galley/pkg/config/analysis/local"
+	"istio.io/istio/galley/pkg/config/meta/metadata"
+)
+
+const invalidServicePortNamesYAML = `
+apiVersion: v1
+kind: Service
+metadata:
+  name: invalid-primary
+  namespace: hidden-ns
+spec:
+  selector:
+    app: invalid-primary
+  ports:
+  - protocol: TCP
+    port: 18182
+    targetPort: 18182
+  - protocol: TCP
+    port: 18183
+    targetPort: ops-backend
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: invalid-named
+  namespace: hidden-ns
+spec:
+  selector:
+    app: invalid-named
+  ports:
+  - name: webmagic
+    protocol: TCP
+    port: 19191
+    targetPort: 19192
+  - name: grpcish
+    protocol: TCP
+    port: 17171
+    targetPort: grpcish-backend
+`
+
+const validServicePortNamesYAML = `
+apiVersion: v1
+kind: Service
+metadata:
+  name: valid-service
+  namespace: hidden-ns
+spec:
+  selector:
+    app: valid-service
+  ports:
+  - name: tcp-main
+    protocol: TCP
+    port: 18282
+    targetPort: 18282
+  - name: http
+    protocol: TCP
+    port: 18283
+    targetPort: http-backend
+  - name: grpc-api
+    protocol: TCP
+    port: 17272
+    targetPort: grpc-backend
+`
+
+const additionalInvalidServicePortNamesYAML = `
+apiVersion: v1
+kind: Service
+metadata:
+  name: invalid-secondary
+  namespace: other-ns
+spec:
+  selector:
+    app: invalid-secondary
+  ports:
+  - name: notaprotocol
+    protocol: TCP
+    port: 25000
+    targetPort: admin-alt
+  - protocol: TCP
+    port: 25001
+    targetPort: 25002
+`
+
+const additionalValidServicePortNamesYAML = `
+apiVersion: v1
+kind: Service
+metadata:
+  name: additional-valid-service
+  namespace: other-ns
+spec:
+  selector:
+    app: additional-valid-service
+  ports:
+  - name: http-api
+    protocol: TCP
+    port: 28282
+    targetPort: http-api-backend
+  - name: tcp-metrics
+    protocol: TCP
+    port: 29292
+    targetPort: tcp-metrics-backend
+`
+
+func TestAnalyzeServicePortNamingInvalidPorts(t *testing.T) {
+	messages := analyzeYAMLWithAllAnalyzers(t, invalidServicePortNamesYAML)
+	diagnostics := filterMessagesByCode(messages, "IST0118")
+
+	if got, want := len(diagnostics), 4; got != want {
+		t.Fatalf("got %d IST0118 diagnostics, want %d: %v", got, want, diagnostics)
+	}
+	for _, m := range diagnostics {
+		if got, want := m.Type.Level(), diag.Info; got != want {
+			t.Fatalf("IST0118 level = %v, want %v", got, want)
+		}
+	}
+
+	expected := []expectedPortDiagnostic{
+		{port: 18182, targetPort: "18182"},
+		{port: 18183, targetPort: "ops-backend"},
+		{name: "webmagic", port: 19191, targetPort: "19192"},
+		{name: "grpcish", port: 17171, targetPort: "grpcish-backend"},
+	}
+	for _, want := range expected {
+		if !containsExpectedPortDiagnostic(diagnostics, want) {
+			t.Fatalf("missing IST0118 diagnostic for %+v in %#v", want, diagnostics)
+		}
+	}
+}
+
+func TestAnalyzeServicePortNamingInvalidPortsOutsideOriginalFixtures(t *testing.T) {
+	messages := analyzeYAMLWithAllAnalyzers(t, additionalInvalidServicePortNamesYAML)
+	diagnostics := filterMessagesByCode(messages, "IST0118")
+
+	if got, want := len(diagnostics), 2; got != want {
+		t.Fatalf("got %d IST0118 diagnostics, want %d: %v", got, want, diagnostics)
+	}
+
+	expected := []expectedPortDiagnostic{
+		{name: "notaprotocol", port: 25000, targetPort: "admin-alt"},
+		{port: 25001, targetPort: "25002"},
+	}
+	for _, want := range expected {
+		if !containsExpectedPortDiagnostic(diagnostics, want) {
+			t.Fatalf("missing IST0118 diagnostic for %+v in %#v", want, diagnostics)
+		}
+	}
+}
+
+func TestPortNameDiagnosticCarriesPortDetails(t *testing.T) {
+	const yaml = `
+apiVersion: v1
+kind: Service
+metadata:
+  name: detail-service
+  namespace: hidden-ns
+spec:
+  selector:
+    app: detail-service
+  ports:
+  - name: bad-alpha
+    protocol: TCP
+    port: 17173
+    targetPort: backend-alpha
+  - protocol: TCP
+    port: 16162
+    targetPort: 16163
+`
+	diagnostics := filterMessagesByCode(analyzeYAMLWithAllAnalyzers(t, yaml), "IST0118")
+	if got, want := len(diagnostics), 2; got != want {
+		t.Fatalf("got %d IST0118 diagnostics, want %d: %v", got, want, diagnostics)
+	}
+	if !containsExpectedPortDiagnostic(diagnostics, expectedPortDiagnostic{name: "bad-alpha", port: 17173, targetPort: "backend-alpha"}) {
+		t.Fatalf("IST0118 for named invalid port did not include port name, port, and targetPort: %#v", diagnostics)
+	}
+	if !containsExpectedPortDiagnostic(diagnostics, expectedPortDiagnostic{port: 16162, targetPort: "16163"}) {
+		t.Fatalf("IST0118 for unnamed port did not include numeric port and targetPort: %#v", diagnostics)
+	}
+}
+
+func TestAnalyzeServicePortNamingValidPortsSilent(t *testing.T) {
+	messages := analyzeYAMLWithAllAnalyzers(t, validServicePortNamesYAML)
+	if got := filterMessagesByCode(messages, "IST0118"); len(got) != 0 {
+		t.Fatalf("valid service port names produced IST0118 diagnostics: %#v", got)
+	}
+}
+
+func TestAnalyzeServicePortNamingAdditionalValidPortsSilent(t *testing.T) {
+	messages := analyzeYAMLWithAllAnalyzers(t, additionalValidServicePortNamesYAML)
+	if got := filterMessagesByCode(messages, "IST0118"); len(got) != 0 {
+		t.Fatalf("additional valid service port names produced IST0118 diagnostics: %#v", got)
+	}
+}
+
+func TestAllAnalyzersIncludeServicePortNamingBehavior(t *testing.T) {
+	messages := analyzeYAMLWithAllAnalyzers(t, invalidServicePortNamesYAML)
+	if got := filterMessagesByCode(messages, "IST0118"); len(got) == 0 {
+		t.Fatalf("normal all-analyzers path did not emit IST0118 for invalid Service ports: %#v", messages)
+	}
+}
+
+type expectedPortDiagnostic struct {
+	name       string
+	port       int
+	targetPort string
+}
+
+func containsExpectedPortDiagnostic(messages []diag.Message, want expectedPortDiagnostic) bool {
+	for _, m := range messages {
+		if messageHasParam(m, want.port) &&
+			messageHasParam(m, want.targetPort) &&
+			(want.name == "" || messageHasParam(m, want.name)) {
+			return true
+		}
+	}
+	return false
+}
+
+func messageHasParam(message diag.Message, want interface{}) bool {
+	wantText := fmt.Sprint(want)
+	for _, got := range message.Parameters {
+		if fmt.Sprint(got) == wantText {
+			return true
+		}
+	}
+	return false
+}
+
+func filterMessagesByCode(messages []diag.Message, code string) []diag.Message {
+	var out []diag.Message
+	for _, m := range messages {
+		if m.Type.Code() == code {
+			out = append(out, m)
+		}
+	}
+	return out
+}
+
+func analyzeYAMLWithAllAnalyzers(t *testing.T, yaml string) []diag.Message {
+	t.Helper()
+
+	sa := local.NewSourceAnalyzer(
+		metadata.MustGet(),
+		AllCombined(),
+		"",
+		"istio-system",
+		nil,
+		yaml != "")
+
+	readers := []io.Reader{strings.NewReader(yaml)}
+	if err := sa.AddReaderKubeSource(readers); err != nil {
+		t.Fatalf("Error setting up inline kube source: %v", err)
+	}
+
+	cancel := make(chan struct{})
+	result, err := sa.Analyze(cancel)
+	if err != nil {
+		t.Fatalf("Error running analysis: %v", err)
+	}
+	return result.Messages
+}
