+func mustWriteAndParse(t *testing.T, ds dicom.Dataset, writeOpts []dicom.WriteOption, parseOpts []dicom.ParseOption) ([]byte, dicom.Dataset) {
+	t.Helper()
+	var b bytes.Buffer
+	if err := dicom.Write(&b, ds, writeOpts...); err != nil {
+		t.Fatalf("Write returned error: %v", err)
+	}
+	parsed, err := dicom.ParseUntilEOF(bytes.NewReader(b.Bytes()), nil, parseOpts...)
+	if err != nil {
+		t.Fatalf("ParseUntilEOF returned error: %v", err)
+	}
+	return b.Bytes(), parsed
+}
