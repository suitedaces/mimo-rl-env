+func pixelDataSummary(t *testing.T, ds dicom.Dataset) pixelSummary {
+	t.Helper()
+	elem, err := ds.FindElementByTag(tag.PixelData)
+	if err != nil {
+		t.Fatalf("PixelData not found: %v", err)
+	}
+	got, ok := summarizeValue(elem.Value).(pixelSummary)
+	if !ok {
+		t.Fatalf("PixelData summary type = %T, want pixelSummary", summarizeValue(elem.Value))
+	}
+	return got
+}
