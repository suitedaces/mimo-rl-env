+func TestWriteUsesDatasetTransferSyntaxForNonMetadataElements(t *testing.T) {
+	cases := []struct {
+		name           string
+		transferUID    string
+		wantDatasetHex []string
+		wantSummary    string
+		queryCovers    string
+	}{
+		{
+			name:        "explicit little endian",
+			transferUID: uid.ExplicitVRLittleEndian,
+			wantDatasetHex: []string{
+				"10001000504e0c0053796e7461785e4361736520",
+				"28001000555302000900",
+				"400061a1464408000000000000802240",
+			},
+			wantSummary: explicitLittleEndianSummaryJSON,
+			queryCovers: "transferSyntax=dataset-explicit-little-endian, datasetEncoding=explicit-vr-little-endian",
+		},
+		{
+			name:        "explicit big endian",
+			transferUID: uid.ExplicitVRBigEndian,
+			wantDatasetHex: []string{
+				"00100010504e000c53796e7461785e4361736520",
+				"00280010555300020009",
+				"0040a161464400084022800000000000",
+			},
+			wantSummary: explicitBigEndianSummaryJSON,
+			queryCovers: "transferSyntax=dataset-explicit-big-endian, datasetEncoding=explicit-vr-big-endian",
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+
+
+			written, parsed := mustWriteAndParse(t, transferSyntaxOnlyDataset(tc.transferUID), nil, nil)
+
+			datasetStart := assertDICOMHeaderAndComputedGroupLength(t, written)
+			for _, want := range tc.wantDatasetHex {
+				assertDatasetHexContains(t, written, datasetStart, want)
+			}
+			assertSummaryJSON(t, parsed, tc.wantSummary)
+		})
+	}
+}
