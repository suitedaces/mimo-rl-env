+func TestWriteRejectsMissingAndInvalidTransferSyntaxes(t *testing.T) {
+	t.Run("missing transfer syntax", func(t *testing.T) {
+
+
+		var b bytes.Buffer
+		err := dicom.Write(&b, missingTransferSyntaxDataset())
+		if !errors.Is(err, dicom.ErrorElementNotFound) {
+			t.Fatalf("error = %v, want wrapping ErrorElementNotFound", err)
+		}
+		if b.Len() != 0 {
+			t.Fatalf("bytes written = %d, want 0", b.Len())
+		}
+	})
+
+	for _, tc := range []struct {
+		name string
+		uid  string
+	}{
+		{
+			name: "unknown uid",
+			uid:  "1.2.3.4.5.6.7.8.9",
+		},
+		{
+			name: "non-transfer-syntax uid",
+			uid:  uid.VerificationSOPClass,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+
+
+			var b bytes.Buffer
+			err := dicom.Write(&b, missingTransferSyntaxDataset(), dicom.OverrideMissingTransferSyntax(tc.uid))
+
+			if err == nil {
+				t.Fatalf("error = nil, want rejection for transfer syntax uid %q", tc.uid)
+			}
+			if b.Len() != 0 {
+				t.Fatalf("bytes written = %d, want 0", b.Len())
+			}
+		})
+	}
+}
