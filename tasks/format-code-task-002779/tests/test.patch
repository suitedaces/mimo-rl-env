+func assertSummaryJSON(t *testing.T, ds dicom.Dataset, want string) {
+	t.Helper()
+	got := summaryJSON(ds)
+
+	if !reflect.DeepEqual(summaryJSONCounts(t, got), summaryJSONCounts(t, want)) {
+		t.Fatalf("summary JSON:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func summaryJSONCounts(t *testing.T, s string) map[string]int {
+	t.Helper()
+	var raw []json.RawMessage
+	if err := json.Unmarshal([]byte(s), &raw); err != nil {
+		t.Fatalf("summary JSON did not unmarshal: %v", err)
+	}
+	counts := make(map[string]int, len(raw))
+	for _, item := range raw {
+		var normalized any
+		if err := json.Unmarshal(item, &normalized); err != nil {
+			t.Fatalf("summary element did not unmarshal: %v", err)
+		}
+		b, err := json.Marshal(normalized)
+		if err != nil {
+			t.Fatalf("summary element did not marshal: %v", err)
+		}
+		counts[string(b)]++
+	}
+	return counts
+}
