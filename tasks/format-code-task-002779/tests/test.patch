+func assertDatasetHexContains(t *testing.T, got []byte, datasetStart int, want string) {
+	t.Helper()
+	if gotHex := hex.EncodeToString(got[datasetStart:]); !strings.Contains(gotHex, want) {
+		t.Fatalf("dataset hex output does not contain %q; got %q", want, gotHex)
+	}
+}
