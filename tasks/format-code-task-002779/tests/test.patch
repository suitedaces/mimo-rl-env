+func mustSnapshotDir(t *testing.T, dir string) []string {
+	t.Helper()
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatalf("ReadDir(%s): %v", dir, err)
+	}
+	out := make([]string, 0, len(entries))
+	for _, e := range entries {
+		out = append(out, filepath.Join(dir, e.Name()))
+	}
+	return out
+}
+
+type elementSummary struct {
+	Tag       string `json:"tag"`
+	RawVR     string `json:"rawVR"`
+	ValueKind string `json:"valueKind"`
+	Value     any    `json:"value"`
+}
+
+type pixelSummary struct {
+	IsEncapsulated           bool           `json:"isEncapsulated"`
+	IntentionallySkipped     bool           `json:"intentionallySkipped"`
+	IntentionallyUnprocessed bool           `json:"intentionallyUnprocessed"`
+	UnprocessedValueData     []int          `json:"unprocessedValueData,omitempty"`
+	Frames                   []frameSummary `json:"frames,omitempty"`
+}
+
+type frameSummary struct {
+	Encapsulated bool  `json:"encapsulated"`
+	Data         []int `json:"data,omitempty"`
+	Rows         int   `json:"rows,omitempty"`
+	Cols         int   `json:"cols,omitempty"`
+	Bits         int   `json:"bits,omitempty"`
+	Samples      int   `json:"samples,omitempty"`
+}
+
+func summaryJSON(ds dicom.Dataset) string {
+	var out []elementSummary
+	iter := ds.FlatStatefulIterator()
+	for iter.HasNext() {
+		e := iter.Next()
+		if e.Tag == tag.FileMetaInformationGroupLength {
+			continue
+		}
+		out = append(out, elementSummary{
+			Tag:       e.Tag.String(),
+			RawVR:     e.RawValueRepresentation,
+			ValueKind: valueKind(e.Value),
+			Value:     summarizeValue(e.Value),
+		})
+	}
+	b, err := json.Marshal(out)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+func valueKind(v dicom.Value) string {
+	switch v.ValueType() {
+	case dicom.Strings:
+		return "Strings"
+	case dicom.Bytes:
+		return "Bytes"
+	case dicom.Ints:
+		return "Ints"
+	case dicom.PixelData:
+		return "PixelData"
+	case dicom.Sequences:
+		return "Sequences"
+	case dicom.Floats:
+		return "Floats"
+	default:
+		return fmt.Sprintf("ValueType(%d)", v.ValueType())
+	}
+}
+
+func summarizeValue(v dicom.Value) any {
+	switch v.ValueType() {
+	case dicom.Strings:
+		return dicom.MustGetStrings(v)
+	case dicom.Bytes:
+		return byteInts(dicom.MustGetBytes(v))
+	case dicom.Ints:
+		return dicom.MustGetInts(v)
+	case dicom.Floats:
+		return dicom.MustGetFloats(v)
+	case dicom.Sequences:
+		return "sequence"
+	case dicom.PixelData:
+		p := dicom.MustGetPixelDataInfo(v)
+		ps := pixelSummary{
+			IsEncapsulated:           p.IsEncapsulated,
+			IntentionallySkipped:     p.IntentionallySkipped,
+			IntentionallyUnprocessed: p.IntentionallyUnprocessed,
+			UnprocessedValueData:     byteInts(p.UnprocessedValueData),
+		}
+		for _, fr := range p.Frames {
+			fs := frameSummary{Encapsulated: fr.Encapsulated}
+			if fr.Encapsulated {
+				fs.Data = byteInts(fr.EncapsulatedData.Data)
+			} else if fr.NativeData != nil {
+				fs.Rows = fr.NativeData.Rows()
+				fs.Cols = fr.NativeData.Cols()
+				fs.Bits = fr.NativeData.BitsPerSample()
+				fs.Samples = fr.NativeData.SamplesPerPixel()
+				fs.Data = nativeDataInts(fr.NativeData.RawDataSlice())
+			}
+			ps.Frames = append(ps.Frames, fs)
+		}
+		return ps
+	default:
+		return fmt.Sprintf("%v", v.GetValue())
+	}
+}
+
+func byteInts(b []byte) []int {
+	if len(b) == 0 {
+		return nil
+	}
+	out := make([]int, len(b))
+	for i, v := range b {
+		out[i] = int(v)
+	}
+	return out
+}
+
+func nativeDataInts(v any) []int {
+	switch x := v.(type) {
+	case []uint8:
+		out := make([]int, len(x))
+		for i, v := range x {
+			out[i] = int(v)
+		}
+		return out
+	case []uint16:
+		out := make([]int, len(x))
+		for i, v := range x {
+			out[i] = int(v)
+		}
+		return out
+	case []uint32:
+		out := make([]int, len(x))
+		for i, v := range x {
+			out[i] = int(v)
+		}
+		return out
+	default:
+		panic(fmt.Sprintf("unexpected native data %T", v))
+	}
+}
+
+func mustElement(t tag.Tag, data any) *dicom.Element {
+	e, err := dicom.NewElement(t, data)
+	if err != nil {
+		panic(err)
+	}
+	return e
+}
+
+func mustValue(data any) dicom.Value {
+	v, err := dicom.NewValue(data)
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
