+func assertDICOMHeaderAndComputedGroupLength(t *testing.T, got []byte) int {
+	t.Helper()
+	if len(got) < 144 {
+		t.Fatalf("DICOM output length = %d, want at least 144 bytes for preamble, DICM, and group length", len(got))
+	}
+	if !bytes.Equal(got[:128], make([]byte, 128)) {
+		t.Fatalf("DICOM preamble is not 128 zero bytes")
+	}
+	if string(got[128:132]) != "DICM" {
+		t.Fatalf("DICOM magic = %q, want DICM", string(got[128:132]))
+	}
+	if binary.LittleEndian.Uint16(got[132:134]) != tag.FileMetaInformationGroupLength.Group ||
+		binary.LittleEndian.Uint16(got[134:136]) != tag.FileMetaInformationGroupLength.Element {
+		t.Fatalf("first metadata tag = (%04x,%04x), want %s",
+			binary.LittleEndian.Uint16(got[132:134]),
+			binary.LittleEndian.Uint16(got[134:136]),
+			tag.FileMetaInformationGroupLength)
+	}
+	if string(got[136:138]) != "UL" {
+		t.Fatalf("FileMetaInformationGroupLength VR = %q, want UL", string(got[136:138]))
+	}
+	if vl := binary.LittleEndian.Uint16(got[138:140]); vl != 4 {
+		t.Fatalf("FileMetaInformationGroupLength value length = %d, want 4", vl)
+	}
+	declaredMetaLen := int(binary.LittleEndian.Uint32(got[140:144]))
+	offset := 144
+	for {
+		if offset+8 > len(got) {
+			t.Fatalf("metadata element at offset %d is truncated", offset)
+		}
+		group := binary.LittleEndian.Uint16(got[offset : offset+2])
+		if group != tag.MetadataGroup {
+			break
+		}
+		vr := string(got[offset+4 : offset+6])
+		headerLen := 8
+		valueLen := int(binary.LittleEndian.Uint16(got[offset+6 : offset+8]))
+		if isLongExplicitVR(vr) {
+			if offset+12 > len(got) {
+				t.Fatalf("long-VR metadata element at offset %d is truncated", offset)
+			}
+			headerLen = 12
+			valueLen = int(binary.LittleEndian.Uint32(got[offset+8 : offset+12]))
+		}
+		offset += headerLen + valueLen
+		if offset > len(got) {
+			t.Fatalf("metadata element length extends beyond output")
+		}
+	}
+	if gotMetaLen := offset - 144; gotMetaLen != declaredMetaLen {
+		t.Fatalf("FileMetaInformationGroupLength = %d, want computed length %d", declaredMetaLen, gotMetaLen)
+	}
+	if offset == len(got) {
+		t.Fatalf("DICOM output has metadata but no dataset elements")
+	}
+	return offset
+}
+
+func isLongExplicitVR(vr string) bool {
+	switch vr {
+	case "OB", "OD", "OF", "OL", "OW", "SQ", "UC", "UR", "UT", "UN":
+		return true
+	default:
+		return false
+	}
+}
