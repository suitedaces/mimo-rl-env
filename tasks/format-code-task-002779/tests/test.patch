+func transferSyntaxValue(t *testing.T, ds dicom.Dataset) string {
+	t.Helper()
+	elem, err := ds.FindElementByTag(tag.TransferSyntaxUID)
+	if err != nil {
+		t.Fatalf("TransferSyntaxUID not found: %v", err)
+	}
+	vals := dicom.MustGetStrings(elem.Value)
+	if len(vals) != 1 {
+		t.Fatalf("TransferSyntaxUID values = %#v, want one value", vals)
+	}
+	return vals[0]
+}
