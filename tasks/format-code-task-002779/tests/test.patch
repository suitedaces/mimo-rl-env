+func TestWriteSerializesPixelDataRepresentations(t *testing.T) {
+	cases := []struct {
+		name      string
+		ds        dicom.Dataset
+		parseOpts []dicom.ParseOption
+		want      pixelSummary
+		covers    string
+	}{
+		{
+			name:   "native 8 bit",
+			ds:     nativePixelDataset(8),
+			covers: "pixelData=native, bitsAllocated=8",
+			want: pixelSummary{Frames: []frameSummary{{
+				Encapsulated: false, Data: []int{1, 2, 3, 4}, Rows: 2, Cols: 2, Bits: 8, Samples: 1,
+			}}},
+		},
+		{
+			name:   "native 16 bit",
+			ds:     nativePixelDataset(16),
+			covers: "pixelData=native, bitsAllocated=16",
+			want: pixelSummary{Frames: []frameSummary{{
+				Encapsulated: false, Data: []int{258, 772, 1286, 1800}, Rows: 2, Cols: 2, Bits: 16, Samples: 1,
+			}}},
+		},
+		{
+			name:   "native 32 bit",
+			ds:     nativePixelDataset(32),
+			covers: "pixelData=native, bitsAllocated=32",
+			want: pixelSummary{Frames: []frameSummary{{
+				Encapsulated: false, Data: []int{65539, 131077, 196615, 262153}, Rows: 2, Cols: 2, Bits: 32, Samples: 1,
+			}}},
+		},
+		{
+			name:   "encapsulated undefined length frames",
+			ds:     encapsulatedPixelDataset(),
+			covers: "pixelData=encapsulated, valueLength=undefined, frameItems=two",
+			want: pixelSummary{IsEncapsulated: true, Frames: []frameSummary{
+				{Encapsulated: true, Data: []int{1, 2, 3, 4}},
+				{Encapsulated: true, Data: []int{5, 6, 7, 8}},
+			}},
+		},
+		{
+			name:      "intentionally unprocessed bytes",
+			ds:        unprocessedPixelDataset(),
+			parseOpts: []dicom.ParseOption{dicom.SkipProcessingPixelDataValue()},
+			covers:    "pixelData=intentionally-unprocessed",
+			want:      pixelSummary{IntentionallyUnprocessed: true, UnprocessedValueData: []int{11, 12, 13, 14}},
+		},
+		{
+			name:      "intentionally skipped native",
+			ds:        skippedNativePixelDataset(),
+			parseOpts: []dicom.ParseOption{dicom.SkipPixelData()},
+			covers:    "pixelData=intentionally-skipped-native",
+			want:      pixelSummary{IntentionallySkipped: true},
+		},
+		{
+			name:      "intentionally skipped encapsulated",
+			ds:        skippedEncapsulatedPixelDataset(),
+			parseOpts: []dicom.ParseOption{dicom.SkipPixelData()},
+			covers:    "pixelData=intentionally-skipped-encapsulated",
+			want:      pixelSummary{IsEncapsulated: true, IntentionallySkipped: true},
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+
+
+			_, parsed := mustWriteAndParse(t, tc.ds, nil, tc.parseOpts)
+			if got := pixelDataSummary(t, parsed); !reflect.DeepEqual(got, tc.want) {
+				t.Fatalf("pixel summary = %#v, want %#v", got, tc.want)
+			}
+		})
+	}
+}
