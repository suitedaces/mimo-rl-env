+func TestWriteMissingTransferSyntaxOptions(t *testing.T) {
+	cases := []struct {
+		name           string
+		opt            dicom.WriteOption
+		wantTS         string
+		wantDatasetHex []string
+	}{
+		{
+			name:   "default missing transfer syntax",
+			opt:    dicom.DefaultMissingTransferSyntax(),
+			wantTS: "1.2.840.10008.1.2",
+			wantDatasetHex: []string{
+				"100010000e0000004d697373696e675e53796e746178",
+				"28001000020000004000",
+				"400061a1080000000000000000205040",
+			},
+		},
+		{
+			name:   "override implicit little endian",
+			opt:    dicom.OverrideMissingTransferSyntax(uid.ImplicitVRLittleEndian),
+			wantTS: "1.2.840.10008.1.2",
+			wantDatasetHex: []string{
+				"100010000e0000004d697373696e675e53796e746178",
+				"28001000020000004000",
+				"400061a1080000000000000000205040",
+			},
+		},
+		{
+			name:   "override explicit little endian",
+			opt:    dicom.OverrideMissingTransferSyntax(uid.ExplicitVRLittleEndian),
+			wantTS: "1.2.840.10008.1.2.1",
+			wantDatasetHex: []string{
+				"10001000504e0e004d697373696e675e53796e746178",
+				"28001000555302004000",
+				"400061a1464408000000000000205040",
+			},
+		},
+		{
+			name:   "override explicit big endian",
+			opt:    dicom.OverrideMissingTransferSyntax(uid.ExplicitVRBigEndian),
+			wantTS: "1.2.840.10008.1.2.2",
+			wantDatasetHex: []string{
+				"00100010504e000e4d697373696e675e53796e746178",
+				"00280010555300020040",
+				"0040a161464400084050200000000000",
+			},
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+
+
+			written, parsed := mustWriteAndParse(t, missingTransferSyntaxDataset(), []dicom.WriteOption{tc.opt}, nil)
+
+			datasetStart := assertDICOMHeaderAndComputedGroupLength(t, written)
+			for _, want := range tc.wantDatasetHex {
+				assertDatasetHexContains(t, written, datasetStart, want)
+			}
+			if got := transferSyntaxValue(t, parsed); got != tc.wantTS {
+				t.Fatalf("TransferSyntaxUID = %q, want %q", got, tc.wantTS)
+			}
+		})
+	}
+}
