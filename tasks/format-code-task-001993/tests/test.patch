+package usercase_test_coderl
+
+import (
+	"encoding/json"
+	"io"
+	"log/slog"
+	"testing"
+
+	graphdb "github.com/mstrYoda/goraphdb"
+)
+
+func TestListNodesCursorPagesDefaultLimitEmptyPageAndJSON(t *testing.T) {
+
+
+	db := openTestDB(t)
+	defer closeDB(t, db)
+
+	alice, err := db.AddNodeWithLabels([]string{"Person"}, graphdb.Props{"name": "Alice"})
+	requireNoError(t, err)
+	bob, err := db.AddNodeWithLabels([]string{"Person"}, graphdb.Props{"name": "Bob"})
+	requireNoError(t, err)
+	zed, err := db.AddNode(graphdb.Props{"name": "Zed"})
+	requireNoError(t, err)
+
+	page1, err := db.ListNodes(0, 1)
+	requireNoError(t, err)
+
+	assertNodePage(t, page1, 1, alice, true)
+	assertNode(t, page1.Nodes[0], alice, []string{"Person"}, "Alice")
+
+	page2, err := db.ListNodes(page1.NextCursor, 1)
+	requireNoError(t, err)
+
+	assertNodePage(t, page2, 1, bob, true)
+	assertNode(t, page2.Nodes[0], bob, []string{"Person"}, "Bob")
+
+	page3, err := db.ListNodes(page2.NextCursor, 1)
+	requireNoError(t, err)
+
+	assertNodePage(t, page3, 1, zed, false)
+	assertNode(t, page3.Nodes[0], zed, nil, "Zed")
+
+	empty, err := db.ListNodes(page3.NextCursor, 1)
+	requireNoError(t, err)
+	assertNodePage(t, empty, 0, 0, false)
+
+	defaultLimit, err := db.ListNodes(0, 0)
+	requireNoError(t, err)
+
+	assertNodePage(t, defaultLimit, 3, zed, false)
+}
+
+func TestListEdgesCursorPagesDecodedFieldsAndJSON(t *testing.T) {
+
+
+	db := openTestDB(t)
+	defer closeDB(t, db)
+
+	alice, err := db.AddNode(graphdb.Props{"name": "Alice"})
+	requireNoError(t, err)
+	bob, err := db.AddNode(graphdb.Props{"name": "Bob"})
+	requireNoError(t, err)
+	carol, err := db.AddNode(graphdb.Props{"name": "Carol"})
+	requireNoError(t, err)
+	knowsID, err := db.AddEdge(alice, bob, "KNOWS", graphdb.Props{"since": "2024"})
+	requireNoError(t, err)
+	likesID, err := db.AddEdge(bob, carol, "LIKES", graphdb.Props{"since": "2025"})
+	requireNoError(t, err)
+
+	page1, err := db.ListEdges(0, 1)
+	requireNoError(t, err)
+
+	assertEdgePage(t, page1, 1, knowsID, true)
+	assertEdge(t, page1.Edges[0], knowsID, alice, bob, "KNOWS", "2024")
+
+	empty, err := db.ListEdges(page1.NextCursor, 1)
+	requireNoError(t, err)
+
+	assertEdgePage(t, empty, 1, likesID, false)
+	assertEdge(t, empty.Edges[0], likesID, bob, carol, "LIKES", "2025")
+
+	afterLast, err := db.ListEdges(empty.NextCursor, 1)
+	requireNoError(t, err)
+	assertEdgePage(t, afterLast, 0, 0, false)
+}
+
+func TestListNodesByLabelFiltersAndSkipsCursor(t *testing.T) {
+
+
+	db := openTestDB(t)
+	defer closeDB(t, db)
+
+	alice, err := db.AddNodeWithLabels([]string{"Person"}, graphdb.Props{"name": "Alice"})
+	requireNoError(t, err)
+	unlabeled, err := db.AddNode(graphdb.Props{"name": "Zed"})
+	requireNoError(t, err)
+	bob, err := db.AddNodeWithLabels([]string{"Person"}, graphdb.Props{"name": "Bob"})
+	requireNoError(t, err)
+
+	allPeople, err := db.ListNodesByLabel("Person", 0, 10)
+	requireNoError(t, err)
+
+	assertNodePage(t, allPeople, 2, bob, false)
+	assertNode(t, allPeople.Nodes[0], alice, []string{"Person"}, "Alice")
+	assertNode(t, allPeople.Nodes[1], bob, []string{"Person"}, "Bob")
+	if allPeople.Nodes[0].ID == unlabeled || allPeople.Nodes[1].ID == unlabeled {
+		t.Fatalf("ListNodesByLabel returned unlabeled node ID %d", unlabeled)
+	}
+
+	firstPerson, err := db.ListNodesByLabel("Person", 0, 1)
+	requireNoError(t, err)
+
+	assertNodePage(t, firstPerson, 1, alice, true)
+	assertNode(t, firstPerson.Nodes[0], alice, []string{"Person"}, "Alice")
+
+	secondPerson, err := db.ListNodesByLabel("Person", firstPerson.NextCursor, 1)
+	requireNoError(t, err)
+
+	assertNodePage(t, secondPerson, 1, bob, false)
+	assertNode(t, secondPerson.Nodes[0], bob, []string{"Person"}, "Bob")
+
+	emptyAfterBob, err := db.ListNodesByLabel("Person", secondPerson.NextCursor, 10)
+	requireNoError(t, err)
+	assertNodePage(t, emptyAfterBob, 0, 0, false)
+
+	missing, err := db.ListNodesByLabel("Missing", 0, 10)
+	requireNoError(t, err)
+	assertNodePage(t, missing, 0, 0, false)
+}
+
+func TestPaginationMethodsReturnClosedError(t *testing.T) {
+
+
+	db := openTestDB(t)
+	requireNoError(t, db.Close())
+
+	_, err := db.ListNodes(0, 1)
+	assertClosedError(t, "ListNodes", err)
+
+	_, err = db.ListEdges(0, 1)
+	assertClosedError(t, "ListEdges", err)
+
+	_, err = db.ListNodesByLabel("Person", 0, 1)
+	assertClosedError(t, "ListNodesByLabel", err)
+}
+
+func TestPaginationMethodsWorkOnOpenedDBBeforeClose(t *testing.T) {
+
+
+
+	db := openTestDB(t)
+	defer closeDB(t, db)
+
+	alice, err := db.AddNodeWithLabels([]string{"Person"}, graphdb.Props{"name": "Alice"})
+	requireNoError(t, err)
+	bob, err := db.AddNode(graphdb.Props{"name": "Bob"})
+	requireNoError(t, err)
+	edgeID, err := db.AddEdge(alice, bob, "KNOWS", graphdb.Props{"since": "2024"})
+	requireNoError(t, err)
+
+	nodes, err := db.ListNodes(0, 1)
+	requireNoError(t, err)
+	assertNodePage(t, nodes, 1, alice, true)
+
+	edges, err := db.ListEdges(0, 1)
+	requireNoError(t, err)
+	assertEdgePage(t, edges, 1, edgeID, false)
+
+	labeled, err := db.ListNodesByLabel("Person", 0, 1)
+	requireNoError(t, err)
+	assertNodePage(t, labeled, 1, alice, false)
+}
+
+func TestPaginationStateDoesNotLeakAcrossDBInstances(t *testing.T) {
+
+
+	a := openTestDB(t)
+	defer closeDB(t, a)
+	b := openTestDB(t)
+	defer closeDB(t, b)
+
+	id, err := a.AddNode(graphdb.Props{"name": "Alice"})
+	requireNoError(t, err)
+	if got := id; got == 0 {
+
+		t.Fatalf("a node id = %d, want non-zero", got)
+	}
+
+	aPage, err := a.ListNodes(0, 10)
+	requireNoError(t, err)
+
+	assertNodePage(t, aPage, 1, id, false)
+
+	bPage, err := b.ListNodes(0, 10)
+	requireNoError(t, err)
+	assertNodePage(t, bPage, 0, 0, false)
+}
+
+func TestListNodesDefaultLimitUsesFifty(t *testing.T) {
+
+
+
+	db := openTestDB(t)
+	defer closeDB(t, db)
+
+	var fiftieth graphdb.NodeID
+	var last graphdb.NodeID
+	for i := 1; i <= 55; i++ {
+		id, err := db.AddNode(graphdb.Props{"name": "node"})
+		requireNoError(t, err)
+		if i == 50 {
+			fiftieth = id
+		}
+		last = id
+	}
+
+	first, err := db.ListNodes(0, -1)
+	requireNoError(t, err)
+	assertNodePage(t, first, 50, fiftieth, true)
+
+	second, err := db.ListNodes(first.NextCursor, 0)
+	requireNoError(t, err)
+	assertNodePage(t, second, 5, last, false)
+}
+
+func openTestDB(t *testing.T) *graphdb.DB {
+	t.Helper()
+	db, err := graphdb.Open(t.TempDir(), graphdb.Options{
+		ShardCount:     1,
+		WorkerPoolSize: 1,
+		NoSync:         true,
+		CacheBudget:    1024 * 1024,
+		Logger:         slog.New(slog.NewTextHandler(io.Discard, nil)),
+	})
+	requireNoError(t, err)
+	return db
+}
+
+func closeDB(t *testing.T, db *graphdb.DB) {
+	t.Helper()
+	requireNoError(t, db.Close())
+}
+
+func requireNoError(t *testing.T, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatalf("error = %v, want <nil>", err)
+	}
+}
+
+func assertNodePage(t *testing.T, page *graphdb.NodePage, wantLen int, wantNext graphdb.NodeID, wantHasMore bool) {
+	t.Helper()
+	if page == nil {
+		t.Fatalf("NodePage nil = true, want false")
+	}
+	if got := len(page.Nodes); got != wantLen {
+		t.Fatalf("len(NodePage.Nodes) = %d, want %d", got, wantLen)
+	}
+	if got := page.Nodes == nil; got != false {
+		t.Fatalf("NodePage.Nodes nil = %v, want false", got)
+	}
+	if got := page.NextCursor; got != wantNext {
+		t.Fatalf("NodePage.NextCursor = %d, want %d", got, wantNext)
+	}
+	if got := page.HasMore; got != wantHasMore {
+		t.Fatalf("NodePage.HasMore = %v, want %v", got, wantHasMore)
+	}
+
+	assertPageJSONFields(t, page, "nodes", wantLen, float64(wantNext), wantHasMore)
+}
+
+func assertEdgePage(t *testing.T, page *graphdb.EdgePage, wantLen int, wantNext graphdb.EdgeID, wantHasMore bool) {
+	t.Helper()
+	if page == nil {
+		t.Fatalf("EdgePage nil = true, want false")
+	}
+	if got := len(page.Edges); got != wantLen {
+		t.Fatalf("len(EdgePage.Edges) = %d, want %d", got, wantLen)
+	}
+	if got := page.Edges == nil; got != false {
+		t.Fatalf("EdgePage.Edges nil = %v, want false", got)
+	}
+	if got := page.NextCursor; got != wantNext {
+		t.Fatalf("EdgePage.NextCursor = %d, want %d", got, wantNext)
+	}
+	if got := page.HasMore; got != wantHasMore {
+		t.Fatalf("EdgePage.HasMore = %v, want %v", got, wantHasMore)
+	}
+
+	assertPageJSONFields(t, page, "edges", wantLen, float64(wantNext), wantHasMore)
+}
+
+func assertNode(t *testing.T, node *graphdb.Node, wantID graphdb.NodeID, wantLabels []string, wantName string) {
+	t.Helper()
+	if node == nil {
+		t.Fatalf("node nil = true, want false")
+	}
+	if got := node.ID; got != wantID {
+		t.Fatalf("node.ID = %d, want %d", got, wantID)
+	}
+	if len(node.Labels) != len(wantLabels) {
+		t.Fatalf("len(node.Labels) = %d, want %d", len(node.Labels), len(wantLabels))
+	}
+	for i := range wantLabels {
+		if got := node.Labels[i]; got != wantLabels[i] {
+			t.Fatalf("node.Labels[%d] = %q, want %q", i, got, wantLabels[i])
+		}
+	}
+	if got := node.Props["name"]; got != wantName {
+		t.Fatalf("node.Props[\"name\"] = %q, want %q", got, wantName)
+	}
+}
+
+func assertEdge(t *testing.T, edge *graphdb.Edge, wantID graphdb.EdgeID, wantFrom, wantTo graphdb.NodeID, wantLabel, wantSince string) {
+	t.Helper()
+	if edge == nil {
+		t.Fatalf("edge nil = true, want false")
+	}
+	if got := edge.ID; got != wantID {
+		t.Fatalf("edge.ID = %d, want %d", got, wantID)
+	}
+	if got := edge.From; got != wantFrom {
+		t.Fatalf("edge.From = %d, want %d", got, wantFrom)
+	}
+	if got := edge.To; got != wantTo {
+		t.Fatalf("edge.To = %d, want %d", got, wantTo)
+	}
+	if got := edge.Label; got != wantLabel {
+		t.Fatalf("edge.Label = %q, want %q", got, wantLabel)
+	}
+	if got := edge.Props["since"]; got != wantSince {
+		t.Fatalf("edge.Props[\"since\"] = %q, want %q", got, wantSince)
+	}
+}
+
+func assertClosedError(t *testing.T, method string, err error) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("%s error nil = true, want false", method)
+	}
+	if got := err.Error(); got != "graphdb: database is closed" {
+		t.Fatalf("%s error = %q, want %q", method, got, "graphdb: database is closed")
+	}
+}
+
+func marshalJSON(t *testing.T, v any) string {
+	t.Helper()
+	data, err := json.Marshal(v)
+	requireNoError(t, err)
+	return string(data)
+}
+
+func assertPageJSONFields(t *testing.T, page any, itemsKey string, wantLen int, wantNext float64, wantHasMore bool) {
+	t.Helper()
+	var fields map[string]any
+	err := json.Unmarshal([]byte(marshalJSON(t, page)), &fields)
+	requireNoError(t, err)
+
+	items, ok := fields[itemsKey].([]any)
+	if !ok {
+		t.Fatalf("page JSON missing array field %q: %#v", itemsKey, fields)
+	}
+	if got := len(items); got != wantLen {
+		t.Fatalf("len(page JSON %q) = %d, want %d", itemsKey, got, wantLen)
+	}
+	if got, ok := fields["next_cursor"].(float64); !ok || got != wantNext {
+		t.Fatalf("page JSON next_cursor = %#v, want %v", fields["next_cursor"], wantNext)
+	}
+	if got, ok := fields["has_more"].(bool); !ok || got != wantHasMore {
+		t.Fatalf("page JSON has_more = %#v, want %v", fields["has_more"], wantHasMore)
+	}
+}
