diff --git a/test/response.test.js b/test/response.test.js
index 1bbf236..ad73bd2 100644
--- a/test/response.test.js
+++ b/test/response.test.js
@@ -1,5 +1,6 @@
 'use strict';
 
+var http = require('http');
 var url = require('url');
 var restifyClients = require('restify-clients');
 var errs = require('restify-errors');
@@ -574,3 +575,162 @@ test('GH-1429: setting code with res.status not respected', function (t) {
         t.end();
     });
 });
+
+
+
+
+
+function rawGet(path, cb) {
+    var req = http.request({
+        host: '127.0.0.1',
+        port: PORT,
+        path: path,
+        method: 'GET'
+    }, function (res) {
+        cb(null, res);
+    });
+    req.on('error', cb);
+    req.end();
+}
+
+
+test('GH-1508: redirect with object pathname only should be relative',
+    function (t) {
+    SERVER.get('/gh1508a', function (req, res, next) {
+        return res.redirect({ pathname: '/' }, next);
+    });
+
+    rawGet('/gh1508a', function (err, res) {
+        t.ifError(err);
+        t.equal(res.statusCode, 302);
+
+        t.equal(res.headers.location, '/');
+        t.end();
+    });
+});
+
+
+test('GH-1508: redirect reload with no hostname should be relative',
+    function (t) {
+    SERVER.get('/gh1508b', function (req, res, next) {
+        res.redirect({ reload: true }, next);
+    });
+
+    rawGet('/gh1508b', function (err, res) {
+        t.ifError(err);
+        t.equal(res.statusCode, 302);
+        t.equal(res.headers.location, '/gh1508b');
+        t.end();
+    });
+});
+
+
+test('GH-1508: redirect with pathname change and no hostname should ' +
+    'be relative', function (t) {
+    SERVER.get('/gh1508c', function (req, res, next) {
+        res.redirect({ pathname: '/foo' }, next);
+    });
+
+    rawGet('/gh1508c', function (err, res) {
+        t.ifError(err);
+        t.equal(res.statusCode, 302);
+        t.equal(res.headers.location, '/foo');
+        t.end();
+    });
+});
+
+
+test('GH-1508: redirect with query and no hostname should be relative',
+    function (t) {
+    SERVER.get('/gh1508d', function (req, res, next) {
+        res.redirect({ query: { a: 1 } }, next);
+    });
+
+    rawGet('/gh1508d', function (err, res) {
+        t.ifError(err);
+        t.equal(res.statusCode, 302);
+        var parsed = url.parse(res.headers.location, true);
+
+        t.equal(parsed.protocol, null);
+        t.equal(parsed.host, null);
+        t.equal(parsed.pathname, '/gh1508d');
+        t.deepEqual(parsed.query, { a: '1' });
+        t.end();
+    });
+});
+
+
+test('GH-1508: redirect with secure but no hostname should not add ' +
+    'protocol', function (t) {
+    SERVER.get('/gh1508e', function (req, res, next) {
+        res.redirect({ pathname: '/x', secure: true }, next);
+    });
+
+    rawGet('/gh1508e', function (err, res) {
+        t.ifError(err);
+        t.equal(res.statusCode, 302);
+
+        t.equal(res.headers.location, '/x');
+        t.end();
+    });
+});
+
+
+test('GH-1508: redirect with hostname should still include http protocol',
+    function (t) {
+    SERVER.get('/gh1508f', function (req, res, next) {
+        res.redirect({
+            hostname: 'www.foo.com',
+            pathname: '/bar'
+        }, next);
+    });
+
+    rawGet('/gh1508f', function (err, res) {
+        t.ifError(err);
+        t.equal(res.statusCode, 302);
+        t.equal(res.headers.location, 'http://www.foo.com/bar');
+        t.end();
+    });
+});
+
+
+test('GH-1508: redirect with hostname and secure should include https',
+    function (t) {
+    SERVER.get('/gh1508g', function (req, res, next) {
+        res.redirect({
+            hostname: 'www.foo.com',
+            pathname: '/baz',
+            secure: true
+        }, next);
+    });
+
+    rawGet('/gh1508g', function (err, res) {
+        t.ifError(err);
+        t.equal(res.statusCode, 302);
+        t.equal(res.headers.location, 'https://www.foo.com/baz');
+        t.end();
+    });
+});
+
+
+test('GH-1508: redirect with hostname and query should include both',
+    function (t) {
+    SERVER.get('/gh1508h', function (req, res, next) {
+        res.redirect({
+            hostname: 'www.foo.com',
+            pathname: '/q',
+            query: { a: 1 }
+        }, next);
+    });
+
+    rawGet('/gh1508h', function (err, res) {
+        t.ifError(err);
+        t.equal(res.statusCode, 302);
+        var parsed = url.parse(res.headers.location, true);
+        t.equal(parsed.protocol, 'http:');
+        t.equal(parsed.hostname, 'www.foo.com');
+        t.equal(parsed.pathname, '/q');
+        t.deepEqual(parsed.query, { a: '1' });
+        t.end();
+    });
+});
