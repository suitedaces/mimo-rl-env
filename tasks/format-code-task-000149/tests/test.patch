+++ b/tests/retrieval/test_ndcg.py
@@ -30,6 +30,8 @@ from tests.retrieval.helpers import (
 from torchmetrics.functional.retrieval.ndcg import retrieval_normalized_dcg
 from torchmetrics.retrieval.retrieval_ndcg import RetrievalNormalizedDCG
 
+import torch
+
 seed_all(42)
 
 
@@ -143,3 +145,105 @@ class TestNDCG(RetrievalMetricTester):
             exception_type=ValueError,
             kwargs_update=metric_args,
         )
+
+
+
+
+
+def test_functional_ndcg_accepts_float_target_issue_example():
+    """Exact reproduction from the issue: functional retrieval_normalized_dcg must accept float target."""
+    preds = torch.tensor([.1, .2, .3, 4, 70])
+    target = torch.tensor([0.1, 0, 0, 0.5, 1.0])
+    result = retrieval_normalized_dcg(preds, target)
+    assert isinstance(result, Tensor)
+    assert torch.isfinite(result)
+    assert 0.0 <= result.item() <= 1.0
+
+
+def test_class_ndcg_accepts_float_target_issue_example():
+    """Exact reproduction from the issue: class RetrievalNormalizedDCG must accept float target."""
+    indexes = torch.tensor([0, 0, 0, 1, 1, 1, 1])
+    preds = torch.tensor([0.2, 0.3, 0.5, 0.1, 0.3, 0.5, 0.2])
+    target = torch.tensor([0.1, 0.1, 0.5, 0.5, 1.0, 1.0, 0.0])
+    ndcg = RetrievalNormalizedDCG()
+    result = ndcg(preds, target, indexes=indexes)
+    assert isinstance(result, Tensor)
+    assert torch.isfinite(result)
+    assert 0.0 <= result.item() <= 1.0
+
+
+def test_functional_ndcg_float_target_numerically_uses_values_not_just_truncates():
+    """Float targets must contribute their floating-point gain, not be cast to long (truncated)."""
+    preds = torch.tensor([0.1, 0.2, 0.3, 4.0, 70.0])
+
+
+
+    target_float = torch.tensor([0.1, 0.0, 0.0, 0.5, 1.0])
+    result = retrieval_normalized_dcg(preds, target_float)
+
+    assert result.item() > 0.5
+
+
+def test_functional_ndcg_float_target_matches_equivalent_int_target():
+    """When float target values are whole numbers, result should match the integer-typed target version."""
+    preds = torch.tensor([0.1, 0.2, 0.3, 4.0, 70.0])
+    target_int = torch.tensor([10, 0, 0, 1, 5])
+    target_float = torch.tensor([10.0, 0.0, 0.0, 1.0, 5.0])
+    r_int = retrieval_normalized_dcg(preds, target_int).item()
+    r_float = retrieval_normalized_dcg(preds, target_float).item()
+    assert abs(r_int - r_float) < 1e-5
+
+
+def test_functional_ndcg_int_target_still_works():
+    """Preservation: integer target path is unchanged after the fix."""
+    preds = torch.tensor([0.1, 0.2, 0.3, 4.0, 70.0])
+    target = torch.tensor([10, 0, 0, 1, 5])
+    result = retrieval_normalized_dcg(preds, target)
+    assert torch.isfinite(result)
+
+    assert abs(result.item() - 0.6957) < 1e-3
+
+
+def test_functional_ndcg_bool_target_still_works():
+    """Preservation: bool target dtype still accepted."""
+    preds = torch.tensor([0.1, 0.2, 0.3, 4.0, 70.0])
+    target = torch.tensor([True, False, False, True, True])
+    result = retrieval_normalized_dcg(preds, target)
+    assert torch.isfinite(result)
+
+
+def test_functional_ndcg_non_float_preds_still_raises():
+    """Preservation: preds must still be a float tensor."""
+    preds = torch.tensor([1, 2, 3, 4, 5])
+    target = torch.tensor([0.0, 1.0, 0.0, 1.0, 1.0])
+    with pytest.raises(ValueError, match="`preds` must be a tensor of floats"):
+        retrieval_normalized_dcg(preds, target)
+
+
+def test_functional_ndcg_invalid_target_dtype_still_raises():
+    """Preservation: a target dtype that is neither bool/int/float must raise ValueError."""
+    preds = torch.tensor([0.1, 0.2, 0.3])
+    target = torch.tensor([0, 1, 0], dtype=torch.complex64)
+    with pytest.raises(ValueError):
+        retrieval_normalized_dcg(preds, target)
+
+
+def test_class_ndcg_float_target_matches_equivalent_int_target():
+    """Class metric: float target with whole-number values matches integer target."""
+    indexes = torch.tensor([0, 0, 0, 1, 1, 1, 1])
+    preds = torch.tensor([0.2, 0.3, 0.5, 0.1, 0.3, 0.5, 0.2])
+    target_int = torch.tensor([1, 0, 2, 0, 1, 2, 0])
+    target_float = torch.tensor([1.0, 0.0, 2.0, 0.0, 1.0, 2.0, 0.0])
+
+    r_int = RetrievalNormalizedDCG()(preds, target_int, indexes=indexes).item()
+    r_float = RetrievalNormalizedDCG()(preds, target_float, indexes=indexes).item()
+    assert abs(r_int - r_float) < 1e-5
+
+
+def test_class_ndcg_int_target_preservation():
+    """Preservation: class metric with integer targets still works."""
+    indexes = torch.tensor([0, 0, 0, 1, 1, 1, 1])
+    preds = torch.tensor([0.2, 0.3, 0.5, 0.1, 0.3, 0.5, 0.2])
+    target = torch.tensor([0, 0, 1, 1, 1, 1, 0])
+    result = RetrievalNormalizedDCG()(preds, target, indexes=indexes)
+    assert torch.isfinite(result)
