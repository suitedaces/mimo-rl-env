diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,19 @@
+#!/bin/bash
+set -uo pipefail
+
+
+cd /testbed
+
+
+case "${1:-}" in
+  base)
+    node --experimental-transform-types --no-warnings --test --test-name-pattern 'only runs when targeting Android' test/android/gradle-wrapper.test.ts
+    ;;
+  new)
+    node --experimental-transform-types --no-warnings --test --test-name-pattern 'bumps Gradle|skips writing' test/android/gradle-wrapper.test.ts
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
