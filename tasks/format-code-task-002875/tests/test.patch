+import React from 'react'
+import { expect } from 'chai'
+import sinon from 'sinon'
+import { shallow } from 'enzyme'
+import { appContentFactory } from '../src/appContentFactory.js'
+import { CONTENT_TYPE, TIMELINE_TYPE } from '../src/helper.js'
+
+
+
+
+
+
+const DummyComponent = () => <div>I am empty</div>
+const WrappedDummyComponent = appContentFactory(DummyComponent)
+
+const loggedUser = { username: 'foo', lang: 'en' }
+
+
+
+const resolveSetState = (spy, prevState) => {
+  if (!spy.called) return { ...prevState }
+  const arg = spy.lastCall.args[0]
+  if (typeof arg === 'function') return { ...prevState, ...arg(prevState) }
+  return { ...prevState, ...arg }
+}
+
+const fileEntry = (name, marker) => ({ file: { name }, marker })
+
+describe('appContentFactory comment-as-file feature', () => {
+  let wrapper
+
+  beforeEach(() => {
+    wrapper = shallow(<WrappedDummyComponent />)
+  })
+
+  describe('exposed handlers', () => {
+    it('should inject appContentAddCommentAsFile and appContentRemoveCommentAsFile as functions', () => {
+      expect(wrapper.props().appContentAddCommentAsFile).to.be.a('function')
+      expect(wrapper.props().appContentRemoveCommentAsFile).to.be.a('function')
+    })
+  })
+
+  describe('appContentAddCommentAsFile', () => {
+    it('should append the given files to an empty staged list', () => {
+      const setState = sinon.spy()
+      wrapper.instance().appContentAddCommentAsFile(
+        [fileEntry('a.txt'), fileEntry('b.txt')],
+        setState
+      )
+      const result = resolveSetState(setState, { newCommentAsFileList: [] })
+      const names = result.newCommentAsFileList.map(e => e.file.name)
+      expect(names).to.have.members(['a.txt', 'b.txt'])
+      expect(names).to.have.lengthOf(2)
+    })
+
+    it('should not add a file whose name is already staged (de-duplicate by name)', () => {
+      const setState = sinon.spy()
+      const prev = { newCommentAsFileList: [fileEntry('a.txt', 'old')] }
+      wrapper.instance().appContentAddCommentAsFile(
+        [fileEntry('a.txt', 'new'), fileEntry('b.txt')],
+        setState
+      )
+      const result = resolveSetState(setState, prev)
+      const names = result.newCommentAsFileList.map(e => e.file.name)
+      expect(names).to.have.lengthOf(2)
+      expect(names).to.have.members(['a.txt', 'b.txt'])
+
+      expect(names.filter(n => n === 'a.txt')).to.have.lengthOf(1)
+    })
+
+    it('should accumulate across successive adds without losing earlier entries', () => {
+      const setState1 = sinon.spy()
+      wrapper.instance().appContentAddCommentAsFile([fileEntry('a.txt')], setState1)
+      const afterFirst = resolveSetState(setState1, { newCommentAsFileList: [] })
+
+      const setState2 = sinon.spy()
+      wrapper.instance().appContentAddCommentAsFile([fileEntry('b.txt')], setState2)
+      const afterSecond = resolveSetState(setState2, afterFirst)
+
+      const names = afterSecond.newCommentAsFileList.map(e => e.file.name)
+      expect(names).to.have.members(['a.txt', 'b.txt'])
+      expect(names).to.have.lengthOf(2)
+    })
+
+    it('should change nothing when adding an empty list', () => {
+      const setState = sinon.spy()
+      const prev = { newCommentAsFileList: [fileEntry('a.txt')] }
+      wrapper.instance().appContentAddCommentAsFile([], setState)
+      const result = resolveSetState(setState, prev)
+      expect(result.newCommentAsFileList.map(e => e.file.name)).to.eql(['a.txt'])
+    })
+  })
+
+  describe('appContentRemoveCommentAsFile', () => {
+    it('should remove the staged entry matching file.name', () => {
+      const setState = sinon.spy()
+      const prev = {
+        newCommentAsFileList: [fileEntry('a.txt'), fileEntry('b.txt'), fileEntry('c.txt')]
+      }
+      wrapper.instance().appContentRemoveCommentAsFile(fileEntry('b.txt'), setState)
+      const result = resolveSetState(setState, prev)
+      const names = result.newCommentAsFileList.map(e => e.file.name)
+      expect(names).to.eql(['a.txt', 'c.txt'])
+    })
+
+    it('should change nothing when fileToRemove is falsy', () => {
+      const setState = sinon.spy()
+      const prev = { newCommentAsFileList: [fileEntry('a.txt'), fileEntry('b.txt')] }
+      wrapper.instance().appContentRemoveCommentAsFile(undefined, setState)
+      const result = resolveSetState(setState, prev)
+      expect(result.newCommentAsFileList.map(e => e.file.name)).to.eql(['a.txt', 'b.txt'])
+    })
+  })
+
+  describe('buildTimelineFromCommentAndRevision', () => {
+    const commentList = [
+      { content_id: 102, content_type: CONTENT_TYPE.COMMENT, raw_content: '<p>c2</p>', created: '2020-01-04T10:00:00Z' },
+      { content_id: 101, content_type: CONTENT_TYPE.COMMENT, raw_content: '<p>c1</p>', created: '2020-01-01T10:00:00Z' }
+    ]
+    const commentAsFileList = [
+      { content_id: 202, content_type: CONTENT_TYPE.FILE, filename: 'f2.png', created: '2020-01-05T10:00:00Z' },
+      { content_id: 201, content_type: CONTENT_TYPE.FILE, filename: 'f1.png', created: '2020-01-02T10:00:00Z' }
+    ]
+    const revisionList = [
+      { content_id: 302, revision_id: 302, comment_ids: [], created: '2020-01-06T10:00:00Z' },
+      { content_id: 301, revision_id: 301, comment_ids: [], created: '2020-01-03T10:00:00Z' }
+    ]
+
+    let timeline
+    beforeEach(() => {
+      timeline = wrapper.instance().buildTimelineFromCommentAndRevision(
+        commentList, commentAsFileList, revisionList, loggedUser
+      )
+    })
+
+    it('should merge every comment, attached file and revision into a single flat list', () => {
+      expect(timeline).to.have.lengthOf(
+        commentList.length + commentAsFileList.length + revisionList.length
+      )
+    })
+
+    it('should order the items chronologically (oldest first)', () => {
+      const orderedIds = timeline.map(item => item.content_id)
+      expect(orderedIds).to.eql([101, 201, 301, 102, 202, 302])
+      const rawDates = timeline.map(item => new Date(item.created_raw).getTime())
+      for (let i = 1; i < rawDates.length; i++) {
+        expect(rawDates[i]).to.be.at.least(rawDates[i - 1])
+      }
+    })
+
+    it('should keep the raw timestamp and add a humanized creation label on every item', () => {
+      for (const item of timeline) {
+        expect(item.created_raw).to.be.a('string')
+        expect(item).to.have.property('created')
+        expect(item.created).to.be.a('string')
+        expect(item.created).to.not.equal('')
+      }
+      const c1 = timeline.find(item => item.content_id === 101)
+      expect(c1.created_raw).to.equal('2020-01-01T10:00:00Z')
+    })
+
+    it('should tag comments and revisions with their respective timeline types', () => {
+      expect(timeline.find(item => item.content_id === 101).timelineType).to.equal(TIMELINE_TYPE.COMMENT)
+      expect(timeline.find(item => item.content_id === 102).timelineType).to.equal(TIMELINE_TYPE.COMMENT)
+      expect(timeline.find(item => item.content_id === 301).timelineType).to.equal(TIMELINE_TYPE.REVISION)
+      expect(timeline.find(item => item.content_id === 302).timelineType).to.equal(TIMELINE_TYPE.REVISION)
+    })
+
+    it('should tag attached files with a single distinct timeline type', () => {
+      const fileItems = timeline.filter(item => item.content_id === 201 || item.content_id === 202)
+      const fileTypes = fileItems.map(item => item.timelineType)
+      expect(fileTypes[0]).to.not.equal(TIMELINE_TYPE.COMMENT)
+      expect(fileTypes[0]).to.not.equal(TIMELINE_TYPE.REVISION)
+
+      expect(new Set(fileTypes).size).to.equal(1)
+    })
+  })
+
+  describe('addCommentToTimeline', () => {
+    const baseTimeline = [
+      {
+        content_id: 901,
+        timelineType: TIMELINE_TYPE.COMMENT,
+        created_raw: '2020-02-02T10:00:00Z',
+        created: 'whatever'
+      }
+    ]
+
+    it('should append a comment content with the comment timeline type', () => {
+      const comment = {
+        content_id: 902,
+        content_type: CONTENT_TYPE.COMMENT,
+        raw_content: '<p>hello</p>',
+        created: '2020-02-03T10:00:00Z'
+      }
+      const result = wrapper.instance().addCommentToTimeline(
+        comment, baseTimeline, loggedUser, true, TIMELINE_TYPE.COMMENT
+      )
+      const added = result.find(item => item.content_id === 902)
+      expect(added.timelineType).to.equal(TIMELINE_TYPE.COMMENT)
+    })
+
+    it('should append a file content as an attached-file item with the distinct type', () => {
+      const fileContent = {
+        content_id: 903,
+        content_type: CONTENT_TYPE.FILE,
+        filename: 'pic.png',
+        created: '2020-02-04T10:00:00Z'
+      }
+      const result = wrapper.instance().addCommentToTimeline(
+        fileContent, baseTimeline, loggedUser, true, TIMELINE_TYPE.COMMENT
+      )
+      const added = result.find(item => item.content_id === 903)
+      expect(added.timelineType).to.not.equal(TIMELINE_TYPE.COMMENT)
+      expect(added.timelineType).to.not.equal(TIMELINE_TYPE.REVISION)
+    })
+
+    it('should keep the timeline ordered chronologically after insertion', () => {
+      const comment = {
+        content_id: 900,
+        content_type: CONTENT_TYPE.COMMENT,
+        raw_content: '<p>earlier</p>',
+        created: '2020-01-01T10:00:00Z'
+      }
+      const result = wrapper.instance().addCommentToTimeline(
+        comment, baseTimeline, loggedUser, true, TIMELINE_TYPE.COMMENT
+      )
+      const rawDates = result.map(item => new Date(item.created_raw).getTime())
+      for (let i = 1; i < rawDates.length; i++) {
+        expect(rawDates[i]).to.be.at.least(rawDates[i - 1])
+      }
+      expect(result[0].content_id).to.equal(900)
+    })
+  })
+})
