+++ b/mimo_test_command.sh
@@ -0,0 +1,58 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export npm_config_audit=false
+export npm_config_fund=false
+export npm_config_offline=true
+export npm_config_update_notifier=false
+
+if [ ! -x node_modules/.bin/gulp ] || [ ! -x node_modules/.bin/tsc ] || [ ! -x node_modules/.bin/jest ]; then
+  echo "Required local node_modules binaries are missing; refusing to install dependencies in offline test command." >&2
+  exit 1
+fi
+
+./node_modules/.bin/gulp typescript:main
+
+./node_modules/.bin/tsc -p /workspace/repo/usercase-test-coderl/tsconfig.security-types.json
+
+./node_modules/.bin/jest --runInBand --config '{
+  "testEnvironment": "node",
+  "testMatch": ["**/usercase-test-coderl/security_node.test.js"],
+  "collectCoverage": false,
+  "transform": {
+    "^.+\\.js$": ["babel-jest", { "presets": [["@babel/preset-env", { "targets": { "node": "current" } }]] }]
+  },
+  "transformIgnorePatterns": [
+    "node_modules/(?!(file-type|strtok3|token-types|uint8array-extras|@tokenizer/inflate|@borewit/text-codec)/)"
+  ]
+}'
+
+./node_modules/.bin/jest --runInBand --config '{
+  "testEnvironment": "jsdom",
+  "testMatch": ["**/usercase-test-coderl/security_browser.test.js"],
+  "collectCoverage": false,
+  "setupFilesAfterEnv": ["<rootDir>/build/main/jest_browser_setup.js"],
+  "setupFiles": ["jest-localstorage-mock"],
+  "moduleFileExtensions": ["js"],
+  "moduleNameMapper": {
+    "(.*)\\.node": "$1.browser"
+  },
+  "transform": {
+    "^.+\\.js$": ["babel-jest", { "presets": [["@babel/preset-env", { "targets": { "node": "current" } }]] }]
+  },
+  "transformIgnorePatterns": [
+    "node_modules/(?!(file-type|strtok3|token-types|uint8array-extras|@tokenizer/inflate|@borewit/text-codec)/)"
+  ]
+}'
