+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set +u
+source /testbed/.build_env/.venv/bin/activate
+set -u
+
+
+case "${1:-}" in
+  base)
+    python -m pytest tests/core/test_solve.py -xvs
+    ;;
+  new)
+    python -m pytest tests/core/test_duplicate_prefix_records_hidden.py -xvs
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
