diff --git a/tests/core/test_duplicate_prefix_records_hidden.py b/tests/core/test_duplicate_prefix_records_hidden.py
new file mode 100644
index 000000000..2ade2fff7
--- /dev/null
+++ b/tests/core/test_duplicate_prefix_records_hidden.py
@@ -0,0 +1,98 @@
+import copy
+
+import pytest
+try:
+    from unittest.mock import Mock
+except ImportError:
+    from mock import Mock
+
+from conda.core.prefix_data import PrefixData
+from conda.models.channel import Channel
+from conda.models.match_spec import MatchSpec
+from conda.models.records import PrefixRecord
+from tests.core.test_solve import UpdateModifier, get_solver_aggregate_1
+
+
+def _synthetic_prefix_record(name, hash_value):
+    return PrefixRecord(
+        _hash=hash_value,
+        name=name,
+        version="999.0",
+        build="0",
+        build_number=0,
+        channel=Channel("channel-99/osx-64"),
+        subdir="osx-64",
+        fn="%s-999.0-0.tar.bz2" % name,
+        md5="0123456789abcdef0123456789abcdef",
+        url="https://example.invalid/osx-64/%s-999.0-0.tar.bz2" % name,
+        arch="x86_64",
+        platform="darwin",
+        depends=(),
+        constrains=(),
+        track_features=(),
+        features=(),
+        license="BSD",
+        timestamp=0,
+        size=1,
+    )
+
+
+def test_solve_final_state_drops_orphan_records_that_duplicate_selected_names():
+    specs = (MatchSpec("numpy"),)
+    with get_solver_aggregate_1(specs) as solver:
+        installed_state = solver.solve_final_state()
+
+    specs_to_add = (MatchSpec("channel-4::numpy"),)
+    with get_solver_aggregate_1(
+        specs_to_add=specs_to_add, prefix_records=installed_state, history_specs=specs
+    ) as solver:
+        solver.solve_final_state()
+
+
+        solver_state_before_sat = copy.copy(solver.ssc)
+        state_returned_from_sat = solver.ssc
+        selected_records = list(state_returned_from_sat.solution_precs)
+        state_returned_from_sat.solution_precs = list(selected_records)
+        state_returned_from_sat.add_back_map = [MatchSpec("mkl")]
+        selected_records.append(_synthetic_prefix_record("mkl", 991))
+        selected_records.append(_synthetic_prefix_record("zlib", 992))
+        solver_state_before_sat.solution_precs = selected_records
+
+        solver._run_sat = Mock(return_value=state_returned_from_sat)
+        solver.ssc = solver_state_before_sat
+
+        final_state = solver.solve_final_state(update_modifier=UpdateModifier.UPDATE_ALL)
+        names = [record.name for record in final_state]
+        assert len(names) == len(set(names))
+        assert "mkl" in names and "zlib" in names
+
+
+def test_insert_duplicate_prefix_record_reports_conflicting_name(tmpdir):
+    prefix_path = tmpdir.mkdir("duplicate-prefix-record")
+    prefix_path.mkdir("conda-meta")
+    prefix_data = PrefixData(str(prefix_path))
+    duplicate_name = "duplicate-test-pkg"
+    prefix_data.insert(_synthetic_prefix_record(duplicate_name, 1001))
+
+    with pytest.raises(AssertionError) as exc_info:
+        prefix_data.insert(_synthetic_prefix_record(duplicate_name, 1002))
+
+    message = str(exc_info.value)
+    assert message
+    assert duplicate_name in message
+    assert "unrelated-conflict-pkg" not in message
+
+def test_insert_duplicate_prefix_record_reports_non_fixture_name(tmpdir):
+    prefix_path = tmpdir.mkdir("ordinary-prefix")
+    prefix_path.mkdir("conda-meta")
+    prefix_data = PrefixData(str(prefix_path))
+    duplicate_name = "arbitrary-conflict-pkg"
+    prefix_data.insert(_synthetic_prefix_record(duplicate_name, 2001))
+
+    with pytest.raises(AssertionError) as exc_info:
+        prefix_data.insert(_synthetic_prefix_record(duplicate_name, 2002))
+
+    message = str(exc_info.value)
+    assert message
+    assert duplicate_name in message
+    assert "duplicate-test-pkg" not in message
