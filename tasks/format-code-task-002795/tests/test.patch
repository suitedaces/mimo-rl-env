 import { expect, test } from 'vitest'
+import { buildDesignSystem } from './design-system'
+import { Theme } from './theme'
 import { compileCss, run } from './test-utils/run'
 
 const css = String.raw
@@ -13066,3 +13068,77 @@ test('@container', () => {
     ]),
   ).toEqual('')
 })
+
+test('negative col-start supports negative values (issue 13779)', () => {
+
+  let output = run(['-col-start-1', '-col-start-4'])
+  expect(output).toContain('.-col-start-1')
+  expect(output).toContain('.-col-start-4')
+  expect(output).toContain('grid-column-start:')
+
+  expect(output).toMatch(/grid-column-start:\s*(?:-1|calc\(1\s*\*\s*-1\))/)
+  expect(output).toMatch(/grid-column-start:\s*(?:-4|calc\(4\s*\*\s*-1\))/)
+})
+
+test('negative col-end supports negative values (issue 13779)', () => {
+
+  let output = run(['-col-end-1', '-col-end-4'])
+  expect(output).toContain('.-col-end-1')
+  expect(output).toContain('.-col-end-4')
+  expect(output).toContain('grid-column-end:')
+  expect(output).toMatch(/grid-column-end:\s*(?:-1|calc\(1\s*\*\s*-1\))/)
+  expect(output).toMatch(/grid-column-end:\s*(?:-4|calc\(4\s*\*\s*-1\))/)
+})
+
+test('negative row-start supports negative values (issue 13779)', () => {
+  let output = run(['-row-start-1', '-row-start-3'])
+  expect(output).toContain('.-row-start-1')
+  expect(output).toContain('.-row-start-3')
+  expect(output).toContain('grid-row-start:')
+  expect(output).toMatch(/grid-row-start:\s*(?:-1|calc\(1\s*\*\s*-1\))/)
+  expect(output).toMatch(/grid-row-start:\s*(?:-3|calc\(3\s*\*\s*-1\))/)
+})
+
+test('negative row-end supports negative values (issue 13779)', () => {
+  let output = run(['-row-end-1', '-row-end-3'])
+  expect(output).toContain('.-row-end-1')
+  expect(output).toContain('.-row-end-3')
+  expect(output).toContain('grid-row-end:')
+  expect(output).toMatch(/grid-row-end:\s*(?:-1|calc\(1\s*\*\s*-1\))/)
+  expect(output).toMatch(/grid-row-end:\s*(?:-3|calc\(3\s*\*\s*-1\))/)
+})
+
+test('arbitrary col-end with negative literal still works (issue 13779 preservation)', () => {
+
+  let output = run(['col-end-[-1]'])
+  expect(output).toContain('.col-end-\\[-1\\]')
+  expect(output).toContain('grid-column-end: -1')
+})
+
+test('positive col-start/col-end/row-start/row-end still produce CSS (issue 13779 preservation)', () => {
+  let output = run(['col-start-4', 'col-end-4', 'row-start-4', 'row-end-4'])
+  expect(output).toContain('grid-column-start: 4')
+  expect(output).toContain('grid-column-end: 4')
+  expect(output).toContain('grid-row-start: 4')
+  expect(output).toContain('grid-row-end: 4')
+})
+
+test('negative non-integer col/row values still rejected (issue 13779)', () => {
+
+  expect(run(['-col-start-1.5', '-col-end-1.5', '-row-start-1.5', '-row-end-1.5'])).toEqual('')
+  expect(run(['-col-start-unknown', '-col-end-unknown'])).toEqual('')
+})
+
+test('negative col/row classes appear in intellisense class list (issue 13779)', () => {
+  let theme = new Theme()
+  let design = buildDesignSystem(theme)
+  let classList = design.getClassList()
+  let classNames = classList.map(([name]) => name)
+
+  for (let n of [1, 2, 12, 13]) {
+    expect(classNames).toContain(`-col-start-${n}`)
+    expect(classNames).toContain(`-col-end-${n}`)
+    expect(classNames).toContain(`-row-start-${n}`)
+    expect(classNames).toContain(`-row-end-${n}`)
+  }
+})
