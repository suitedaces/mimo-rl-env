+    def test_wrap_socket_sni_accepts_ca_certs_kwarg(self):
+
+        sock = Mock()
+        with patch('ssl.SSLContext'):
+            self.t._wrap_socket_sni(sock, ca_certs='/path/to/ca.pem')
+
+    def test_wrap_socket_sni_loads_ca_certs(self):
+        import ssl as _ssl
+        sock = Mock()
+        with patch('ssl.SSLContext') as mock_ctx_cls:
+            mock_ctx = mock_ctx_cls.return_value
+            self.t._wrap_socket_sni(sock, ca_certs='/path/to/ca.pem')
+            assert mock_ctx.load_verify_locations.called
+            args, _ = mock_ctx.load_verify_locations.call_args
+            assert args[0] == '/path/to/ca.pem'
+
+            mock_ctx.set_ciphers.assert_not_called()
+        del _ssl
+
+    def test_wrap_socket_sni_no_ca_certs_no_load(self):
+        sock = Mock()
+        with patch('ssl.SSLContext') as mock_ctx_cls:
+            mock_ctx = mock_ctx_cls.return_value
+            self.t._wrap_socket_sni(sock)
+            mock_ctx.load_verify_locations.assert_not_called()
+
+    def test_wrap_socket_sni_accepts_ciphers_kwarg(self):
+        sock = Mock()
+        with patch('ssl.SSLContext'):
+            self.t._wrap_socket_sni(sock, ciphers='HIGH:!aNULL')
+
+    def test_wrap_socket_sni_sets_ciphers(self):
+        sock = Mock()
+        with patch('ssl.SSLContext') as mock_ctx_cls:
+            mock_ctx = mock_ctx_cls.return_value
+            self.t._wrap_socket_sni(sock, ciphers='HIGH:!aNULL')
+            mock_ctx.set_ciphers.assert_called_with('HIGH:!aNULL')
+            mock_ctx.load_verify_locations.assert_not_called()
+
+    def test_wrap_socket_sni_no_ciphers_no_call(self):
+        sock = Mock()
+        with patch('ssl.SSLContext') as mock_ctx_cls:
+            mock_ctx = mock_ctx_cls.return_value
+            self.t._wrap_socket_sni(sock)
+            mock_ctx.set_ciphers.assert_not_called()
+
+    def test_wrap_socket_full_sslopts_dict_reproduces_issue(self):
+
+
+        import ssl as _ssl
+        sock = Mock()
+        sslopts = {
+            'ca_certs': '/path/to/ca.pem',
+            'cert_reqs': _ssl.CERT_REQUIRED,
+            'certfile': '/path/to/cert.pem',
+            'keyfile': '/path/to/key.pem',
+        }
+        with patch('ssl.SSLContext') as mock_ctx_cls:
+            mock_ctx = mock_ctx_cls.return_value
+
+
+            self.t._wrap_socket(sock, **sslopts)
+            assert mock_ctx.load_verify_locations.called
+            args, _ = mock_ctx.load_verify_locations.call_args
+            assert args[0] == '/path/to/ca.pem'
+            mock_ctx.load_cert_chain.assert_called_with(
+                '/path/to/cert.pem', '/path/to/key.pem')
+
 
