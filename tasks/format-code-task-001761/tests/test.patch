+static void test_ipv4_request_and_success(void)
+{
+
+
+
+
+    const unsigned char reply[8] = { 0, 90, 0, 0, 0, 0, 0, 0 };
+    const unsigned char expected[14] = {
+        0x04, 0x01, 0x00, 0x16, 0xc0, 0x00, 0x02, 0x0a,
+        0x61, 0x6c, 0x69, 0x63, 0x65, 0x00
+    };
+    FakeSocksServer srv;
+    start_server(&srv, reply, 14, true);
+    RecordingPlug plug;
+    recording_plug_init(&plug);
+    Conf *conf = proxy_conf(srv.port, AUTO, "alice");
+    char addrbuf[64];
+    int addrtype = 0;
+
+    Socket *sock = connect_via_socks4(&srv, conf, "192.0.2.10", 22,
+                                      ADDRTYPE_IPV4, &plug,
+                                      addrbuf, sizeof(addrbuf), &addrtype);
+    expect_null("socket_error fresh IPv4", sk_socket_error(sock));
+
+    WaitCtx wait = { &plug, &srv, 1, 0 };
+    pump_events_until(wait_done, &wait, 3000);
+
+    expect_int("IPv4 lookup address type", addrtype, ADDRTYPE_IPV4);
+    expect_str("IPv4 lookup address", addrbuf, "192.0.2.10");
+    expect_size("IPv4 request length", srv.received_len, 14);
+    expect_bytes("IPv4 request", srv.received, expected, 14);
+
+    expect_int_at_least("success count after SOCKS4 success reply",
+                        plug.success_count, 1);
+    expect_int("close count before cleanup", plug.close_count, 0);
+
+    close_socket_if_constructed(sock);
+    stop_server(&srv);
+    conf_free(conf);
+}
