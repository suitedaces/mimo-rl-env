+    run_error_reply_fixture(
+        1, 90, "nonzero reply version error message",
+        "SOCKS", "version", "1");
+    run_error_reply_fixture(
+        0, 91, "status 91 error message",
+        "failure", "connect", NULL);
+    run_error_reply_fixture(
+        0, 92, "status 92 error message",
+        "IDENTD", NULL, NULL);
+    run_error_reply_fixture(
+        0, 93, "status 93 error message",
+        "username", "IDENTD", "agree");
+    run_error_reply_fixture(
+        0, 94, "status 94 error message",
+        "unrecognised", "SOCKS", "94");
+}
+
+static void test_ipv6_target_is_rejected(void)
+{
+
+
+
+
+    FakeSocksServer srv;
+    start_server(&srv, NULL, 0, true);
+    RecordingPlug plug;
+    recording_plug_init(&plug);
+    Conf *conf = proxy_conf(srv.port, AUTO, "alice");
+    char addrbuf[64];
+    int addrtype = 0;
+
+    Socket *sock = connect_via_socks4(&srv, conf, "::1", 22,
+                                      ADDRTYPE_IPV6, &plug,
+                                      addrbuf, sizeof(addrbuf), &addrtype);
+
+    WaitCtx wait = { &plug, &srv, 1, 1 };
+    pump_events_until(wait_done, &wait, 3000);
+
+    expect_int("IPv6 lookup address type", addrtype, ADDRTYPE_IPV6);
+    expect_str("IPv6 lookup address", addrbuf, "::1");
+    expect_size("IPv6 sent request bytes", srv.received_len, 0);
+    expect_int("IPv6 close count", plug.close_count, 1);
+    expect_int("IPv6 close type", plug.last_close_type, PLUGCLOSE_ERROR);
+
+    expect_str_contains_ci("IPv6 close message", plug.last_close_msg,
+                           "SOCKS version 4 does not support IPv6");
+
+    close_socket_if_constructed(sock);
+    stop_server(&srv);
+    conf_free(conf);
+}
+
+static void test_two_instances_keep_independent_negotiation_state(void)
+{
+
+
+
+
+    const unsigned char reply[8] = { 0, 90, 0, 0, 0, 0, 0, 0 };
+    const unsigned char expected_a[12] = {
+        0x04, 0x01, 0x00, 0x16, 0xc0, 0x00, 0x02, 0x0a,
+        0x61, 0x6e, 0x6e, 0x00
+    };
+    const unsigned char expected_b[12] = {
+        0x04, 0x01, 0x08, 0xae, 0xc6, 0x33, 0x64, 0x07,
+        0x62, 0x6f, 0x62, 0x00
+    };
+    FakeSocksServer srv_a, srv_b;
+    start_server(&srv_a, reply, 12, true);
+    start_server(&srv_b, reply, 12, true);
+    RecordingPlug plug_a, plug_b;
+    recording_plug_init(&plug_a);
+    recording_plug_init(&plug_b);
+    Conf *conf_a = proxy_conf(srv_a.port, AUTO, "ann");
+    Conf *conf_b = proxy_conf(srv_b.port, AUTO, "bob");
+
+    Socket *sock_a = connect_via_socks4(&srv_a, conf_a, "192.0.2.10", 22,
+                                        ADDRTYPE_IPV4, &plug_a,
+                                        NULL, 0, NULL);
+    Socket *sock_b = connect_via_socks4(&srv_b, conf_b, "198.51.100.7", 2222,
+                                        ADDRTYPE_IPV4, &plug_b,
+                                        NULL, 0, NULL);
+
+    WaitCtx wait_a = { &plug_a, &srv_a, 1, 0 };
+    WaitCtx wait_b = { &plug_b, &srv_b, 1, 0 };
+    pump_events_until(wait_done, &wait_a, 3000);
+    pump_events_until(wait_done, &wait_b, 3000);
+
+    expect_size("instance a request length", srv_a.received_len, 12);
+    expect_bytes("instance a request", srv_a.received, expected_a, 12);
+
+    expect_int_at_least("instance a success count", plug_a.success_count, 1);
+    expect_size("instance b request length", srv_b.received_len, 12);
+    expect_bytes("instance b request", srv_b.received, expected_b, 12);
+
+    expect_int_at_least("instance b success count", plug_b.success_count, 1);
+
+    close_socket_if_constructed(sock_a);
+    close_socket_if_constructed(sock_b);
+    stop_server(&srv_a);
+    stop_server(&srv_b);
+    conf_free(conf_a);
+    conf_free(conf_b);
+}
+
+static void test_repeated_cleanup_cycles_complete(void)
+{
+
+
+
+
+    const unsigned char reply[8] = { 0, 90, 0, 0, 0, 0, 0, 0 };
+    int completed = 0;
+
+    for (int i = 0; i < 100; i++) {
+        FakeSocksServer srv;
+        start_server(&srv, reply, 14, true);
+        RecordingPlug plug;
+        recording_plug_init(&plug);
+        Conf *conf = proxy_conf(srv.port, AUTO, "alice");
+
+        Socket *sock = connect_via_socks4(&srv, conf, "192.0.2.10", 22,
+                                          ADDRTYPE_IPV4, &plug,
+                                          NULL, 0, NULL);
+        WaitCtx wait = { &plug, &srv, 1, 0 };
+        pump_events_until(wait_done, &wait, 3000);
+
+        expect_int_at_least("leak cycle success count", plug.success_count, 1);
+        close_socket_if_constructed(sock);
+        stop_server(&srv);
+        conf_free(conf);
+        completed++;
+    }
+
+
+    expect_int("repeated cleanup cycles", completed, 100);
+}
+
+int main(void)
+{
+    sk_init();
+    uxsel_init();
+
+#define RUN_TEST(fn) do { fn(); if (missing_socks4_proxy_impl) goto finish; } while (0)
+    RUN_TEST(test_ipv4_request_and_success);
+    RUN_TEST(test_auto_dns_resolves_hostname_locally);
+    RUN_TEST(test_forced_dns_uses_socks4a_hostname_field);
+    RUN_TEST(test_bad_reply_errors_are_specific);
+    RUN_TEST(test_ipv6_target_is_rejected);
+    RUN_TEST(test_two_instances_keep_independent_negotiation_state);
+    RUN_TEST(test_repeated_cleanup_cycles_complete);
+#undef RUN_TEST
+
+finish:
+    sk_cleanup();
+
+    if (failures) {
+        fprintf(stderr, "%d assertion(s) failed\n", failures);
+        return 1;
+    }
+
+    printf("SOCKS4 proxy acceptance tests passed\n");
+    return 0;
+}
