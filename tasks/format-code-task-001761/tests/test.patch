+typedef struct RecordingPlug {
+    Plug plug;
+    int success_count;
+    int close_count;
+    PlugCloseType last_close_type;
+    char last_close_msg[256];
+    int receive_count;
+    int sent_count;
+} RecordingPlug;
+
+static RecordingPlug *plug_from_public(Plug *plug)
+{
+    return container_of(plug, RecordingPlug, plug);
+}
+
+static void recording_log(Plug *plug, Socket *s, PlugLogType type,
+                          SockAddr *addr, int port, const char *err_msg,
+                          int err_code)
+{
+    RecordingPlug *rp = plug_from_public(plug);
+    if (type == PLUGLOG_CONNECT_SUCCESS)
+        rp->success_count++;
+}
+
+static void recording_closing(Plug *plug, PlugCloseType type,
+                              const char *error_msg)
+{
+    RecordingPlug *rp = plug_from_public(plug);
+    rp->close_count++;
+    rp->last_close_type = type;
+    snprintf(rp->last_close_msg, sizeof(rp->last_close_msg), "%s",
+             error_msg ? error_msg : "");
+}
+
+static void recording_receive(Plug *plug, int urgent, const char *data,
+                              size_t len)
+{
+    RecordingPlug *rp = plug_from_public(plug);
+    rp->receive_count++;
+}
+
+static void recording_sent(Plug *plug, size_t bufsize)
+{
+    RecordingPlug *rp = plug_from_public(plug);
+    rp->sent_count++;
+}
+
+static const PlugVtable recording_plugvt = {
+    .log = recording_log,
+    .closing = recording_closing,
+    .receive = recording_receive,
+    .sent = recording_sent,
+};
+
+static void recording_plug_init(RecordingPlug *rp)
+{
+    memset(rp, 0, sizeof(*rp));
+    rp->plug.vt = &recording_plugvt;
+    rp->last_close_type = PLUGCLOSE_NORMAL;
+}
