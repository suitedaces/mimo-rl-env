+        failf("%s: got %s expected %s", label,
+              actual ? actual : "(null)", expected);
+}
+
+static void expect_null(const char *label, const char *actual)
+{
+    if (actual)
+        failf("%s: got %s expected (null)", label, actual);
+}
+
+static bool contains_ci(const char *haystack, const char *needle)
+{
+    size_t needle_len = strlen(needle);
+    if (needle_len == 0)
+        return true;
+
+    for (const char *p = haystack; *p; p++) {
+        size_t i;
+        for (i = 0; i < needle_len; i++) {
+            if (!p[i])
+                return false;
+            if (tolower((unsigned char)p[i]) !=
+                tolower((unsigned char)needle[i]))
+                break;
+        }
+        if (i == needle_len)
+            return true;
+    }
+
+    return false;
+}
+
+static void expect_str_contains_ci(const char *label, const char *actual,
+                                   const char *needle)
+{
+    if (!actual || !contains_ci(actual, needle))
+        failf("%s: got %s expected substring %s", label,
+              actual ? actual : "(null)", needle);
+}
+
+static void expect_int_at_least(const char *label, int actual, int minimum)
+{
+    if (actual < minimum)
+        failf("%s: got %d expected at least %d", label, actual, minimum);
+}
+
+static void expect_bytes(const char *label, const unsigned char *actual,
+                         const unsigned char *expected, size_t len)
+{
+    if (memcmp(actual, expected, len)) {
+        fprintf(stderr, "FAIL: %s bytes differed\n  got:     ", label);
+        for (size_t i = 0; i < len; i++)
+            fprintf(stderr, "%02x%s", actual[i], i + 1 == len ? "" : " ");
+        fprintf(stderr, "\n  expected:");
+        for (size_t i = 0; i < len; i++)
+            fprintf(stderr, " %02x", expected[i]);
+        fprintf(stderr, "\n");
+        failures++;
+    }
+}
