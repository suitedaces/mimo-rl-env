+static unsigned long now_ms(void)
+{
+    struct timeval tv;
+    gettimeofday(&tv, NULL);
+    return (unsigned long)tv.tv_sec * 1000 + (unsigned long)tv.tv_usec / 1000;
+}
+
+static void pump_events_until(bool (*done)(void *), void *ctx,
+                              unsigned long timeout_ms)
+{
+    unsigned long deadline = now_ms() + timeout_ms;
+
+    while (!done(ctx) && now_ms() < deadline) {
+        int fdstate, rwx, maxfd = -1;
+        int fds[256], states[256], nfds = 0;
+        fd_set rfds, wfds, xfds;
+        struct timeval tv;
+
+        while (run_toplevel_callbacks()) {
+        }
+
+        FD_ZERO(&rfds);
+        FD_ZERO(&wfds);
+        FD_ZERO(&xfds);
+        for (int fd = first_fd(&fdstate, &rwx); fd >= 0;
+             fd = next_fd(&fdstate, &rwx)) {
+            if (nfds < (int)ARRAY_LEN(fds)) {
+                fds[nfds] = fd;
+                states[nfds] = rwx;
+                nfds++;
+            }
+            if (rwx & SELECT_R)
+                FD_SET(fd, &rfds);
+            if (rwx & SELECT_W)
+                FD_SET(fd, &wfds);
+            if (rwx & SELECT_X)
+                FD_SET(fd, &xfds);
+            if (fd > maxfd)
+                maxfd = fd;
+        }
+
+        tv.tv_sec = 0;
+        tv.tv_usec = 10000;
+
+        int ret = maxfd >= 0 ?
+            select(maxfd + 1, &rfds, &wfds, &xfds, &tv) : 0;
+        if (ret < 0) {
+            if (errno == EINTR)
+                continue;
+            modalfatalbox("select: %s", strerror(errno));
+        }
+
+        for (int i = 0; i < nfds; i++) {
+            int fd = fds[i];
+            if ((states[i] & SELECT_X) && FD_ISSET(fd, &xfds))
+                select_result(fd, SELECT_X);
+            if ((states[i] & SELECT_R) && FD_ISSET(fd, &rfds))
+                select_result(fd, SELECT_R);
+            if ((states[i] & SELECT_W) && FD_ISSET(fd, &wfds))
+                select_result(fd, SELECT_W);
+        }
+    }
+
+    while (run_toplevel_callbacks()) {
+    }
+
+    if (!done(ctx))
+        failf("timed out waiting for socket session");
+}
+
+typedef struct WaitCtx {
+    RecordingPlug *plug;
+    FakeSocksServer *server;
+    int want_successes;
+    int want_closes;
+} WaitCtx;
+
+static bool wait_done(void *vctx)
+{
+    WaitCtx *ctx = (WaitCtx *)vctx;
+    if (missing_socks4_proxy_impl)
+        return true;
+    return ctx->plug->success_count >= ctx->want_successes &&
+        ctx->plug->close_count >= ctx->want_closes &&
+        (!ctx->server || ctx->server->received_len >= ctx->server->expected_len);
+}
+
+static Socket *connect_via_socks4(FakeSocksServer *srv, Conf *conf,
+                                  const char *host, int port,
+                                  int addressfamily, RecordingPlug *plug,
+                                  char *addrbuf, size_t addrbuflen,
+                                  int *addrtype_out)
+{
+    char *canonical = NULL;
+    SockAddr *addr = name_lookup(host, port, &canonical, conf, addressfamily,
+                                 NULL, "usercase");
+    if (addrbuf)
+        sk_getaddr(addr, addrbuf, addrbuflen);
+    if (addrtype_out)
+        *addrtype_out = sk_addrtype(addr);
+    sfree(canonical);
+    Socket *sock = new_connection(addr, host, port, false, false, false, false,
+                                  &plug->plug, conf, NULL);
+    const char *err = sk_socket_error(sock);
+    if (err && !strcmp(err, "Proxy error: Unknown proxy method"))
+        missing_socks4_proxy_impl = true;
+    return sock;
+}
