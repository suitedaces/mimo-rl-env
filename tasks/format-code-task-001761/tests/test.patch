+typedef struct FakeSocksServer {
+    int listen_fd;
+    int port;
+    pthread_t thread;
+    size_t expected_len;
+    unsigned char received[512];
+    size_t received_len;
+    unsigned char reply[8];
+    size_t reply_len;
+    bool hold_until_client_close;
+    bool done;
+    int error_code;
+} FakeSocksServer;
+
+static void *fake_server_thread(void *vctx)
+{
+    FakeSocksServer *srv = (FakeSocksServer *)vctx;
+    int client = accept(srv->listen_fd, NULL, NULL);
+    if (client < 0) {
+        srv->error_code = errno;
+        close(srv->listen_fd);
+        srv->done = true;
+        return NULL;
+    }
+
+    close(srv->listen_fd);
+    srv->listen_fd = -1;
+
+    while (srv->received_len < srv->expected_len) {
+        ssize_t ret = recv(client, srv->received + srv->received_len,
+                           srv->expected_len - srv->received_len, 0);
+        if (ret <= 0) {
+            srv->error_code = ret == 0 ? ECONNRESET : errno;
+            close(client);
+            srv->done = true;
+            return NULL;
+        }
+        srv->received_len += (size_t)ret;
+    }
+
+    if (srv->reply_len) {
+        ssize_t ret = send(client, srv->reply, srv->reply_len, MSG_NOSIGNAL);
+        if (ret != (ssize_t)srv->reply_len)
+            srv->error_code = ret < 0 ? errno : EIO;
+    }
+
+    if (srv->hold_until_client_close) {
+        char discard[256];
+        while (recv(client, discard, sizeof(discard), 0) > 0) {
+        }
+    }
+
+    close(client);
+    srv->done = true;
+    return NULL;
+}
+
+static void start_server(FakeSocksServer *srv, const unsigned char reply[8],
+                         size_t expected_len,
+                         bool hold_until_client_close)
+{
+    struct sockaddr_in sin;
+    socklen_t sinlen = sizeof(sin);
+
+    memset(srv, 0, sizeof(*srv));
+    srv->listen_fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (srv->listen_fd < 0)
+        modalfatalbox("socket: %s", strerror(errno));
+
+    int one = 1;
+    setsockopt(srv->listen_fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+
+    memset(&sin, 0, sizeof(sin));
+    sin.sin_family = AF_INET;
+    sin.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    sin.sin_port = htons(0);
+    if (bind(srv->listen_fd, (struct sockaddr *)&sin, sizeof(sin)) < 0)
+        modalfatalbox("bind: %s", strerror(errno));
+    if (listen(srv->listen_fd, 4) < 0)
+        modalfatalbox("listen: %s", strerror(errno));
+    if (getsockname(srv->listen_fd, (struct sockaddr *)&sin, &sinlen) < 0)
+        modalfatalbox("getsockname: %s", strerror(errno));
+
+    srv->port = ntohs(sin.sin_port);
+    srv->expected_len = expected_len;
+    if (reply) {
+        memcpy(srv->reply, reply, 8);
+        srv->reply_len = 8;
+    }
+    srv->hold_until_client_close = hold_until_client_close;
+
+    if (pthread_create(&srv->thread, NULL, fake_server_thread, srv) != 0)
+        modalfatalbox("pthread_create failed");
+}
+
+static void stop_server(FakeSocksServer *srv)
+{
+    if (!srv->done && srv->listen_fd >= 0) {
+
+
+
+
+
+        int wake_fd = socket(AF_INET, SOCK_STREAM, 0);
+        if (wake_fd >= 0) {
+            struct sockaddr_in sin;
+            memset(&sin, 0, sizeof(sin));
+            sin.sin_family = AF_INET;
+            sin.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+            sin.sin_port = htons(srv->port);
+            connect(wake_fd, (struct sockaddr *)&sin, sizeof(sin));
+            close(wake_fd);
+        }
+    }
+
+    pthread_join(srv->thread, NULL);
+    if (srv->listen_fd >= 0)
+        close(srv->listen_fd);
+    if (missing_socks4_proxy_impl && srv->error_code == ECONNRESET)
+        srv->error_code = 0;
+    expect_int("fake server error_code", srv->error_code, 0);
+    expect_int("fake server done", srv->done ? 1 : 0, 1);
+}
