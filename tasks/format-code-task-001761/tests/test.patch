+static void failf(const char *fmt, ...)
+{
+    va_list ap;
+    failures++;
+    fprintf(stderr, "FAIL: ");
+    va_start(ap, fmt);
+    vfprintf(stderr, fmt, ap);
+    va_end(ap);
+    fputc('\n', stderr);
