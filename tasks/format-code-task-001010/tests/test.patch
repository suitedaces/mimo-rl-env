+++ b/tests/test_bgp_facts_contract.py
@@ -0,0 +1,155 @@
+import importlib.util
+import re
+import sys
+import types
+import unittest
+
+
+FIXTURE = """\
+BGP neighbor is 192.0.2.1, remote AS 65001, local AS 65000, external link
+ Description: v4-edge
+ BGP version 4, remote router ID 198.51.100.1
+ BGP state = Established
+ Message statistics:
+                         Sent       Rcvd
+ Opens:                  4          5
+ Notifications:          1          2
+ Updates:                30         40
+ Keepalives:             50         60
+ Route Refresh:           7          8
+ Capability:              9         10
+ Total:                 101        125
+ Minimum time between advertisement runs is 30 seconds
+ 0 accepted prefixes
+ Connections established 3; dropped 1
+
+BGP neighbor is 2001:db8::1, remote AS 65101, local AS 65000, external link
+ Description: v6-compressed
+ BGP version 4, remote router ID 203.0.113.1
+ BGP state = Active
+ Message statistics:
+ Opens:                  6          7
+ Notifications:          0          1
+ Updates:                8          9
+ Keepalives:             10         11
+ Route Refresh:           2          3
+ Capability:              4          5
+ Total:                  30         36
+ Minimum time between advertisement runs is 45 seconds
+ 12 accepted prefixes
+ Connections established 4; dropped 2
+
+BGP neighbor is 2001:0db8:0:0:0:0:0:2, remote AS 65102, local AS 65000, external link
+ Description: v6-expanded
+ BGP version 4, remote router ID 203.0.113.2
+ BGP state = Idle
+ Message statistics:
+ Opens:                  1          0
+ Total:                   1          0
+ Minimum time between advertisement runs is 5 seconds
+ 0 accepted prefixes
+ Connections established 0; dropped 0
+"""
+
+
+class _FakeAnsibleModule(object):
+    def __init__(self, *args, **kwargs):
+        self.result = None
+
+    def run_command(self, command, **kwargs):
+        self.command = command
+        return 0, FIXTURE, ""
+
+    def exit_json(self, **kwargs):
+        self.result = kwargs
+
+    def fail_json(self, **kwargs):
+        raise AssertionError("module failed: %r" % (kwargs,))
+
+
+def load_bgp_module():
+
+
+    ansible_pkg = types.ModuleType("ansible")
+    module_utils_pkg = types.ModuleType("ansible.module_utils")
+    basic_mod = types.ModuleType("ansible.module_utils.basic")
+    basic_mod.AnsibleModule = _FakeAnsibleModule
+    basic_mod.re = re
+    sys.modules.update({
+        "ansible": ansible_pkg,
+        "ansible.module_utils": module_utils_pkg,
+        "ansible.module_utils.basic": basic_mod,
+    })
+    spec = importlib.util.spec_from_file_location(
+        "sonic_bgp_facts_contract", "ansible/library/bgp_facts.py"
+    )
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class BgpFactsContractTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.bgp = load_bgp_module()
+
+    def collect(self):
+        instance = self.bgp.BgpModule()
+        instance.run()
+        return instance.module.result["ansible_facts"]["bgp_neighbors"]
+
+    def test_all_reported_address_families_are_distinct_neighbors(self):
+        neighbors = self.collect()
+        self.assertEqual(
+            set(neighbors),
+            {"192.0.2.1", "2001:db8::1", "2001:0db8:0:0:0:0:0:2"},
+        )
+
+    def test_ipv6_neighbors_preserve_the_same_core_fields(self):
+        neighbors = self.collect()
+        expected = {
+            "2001:db8::1": (65101, "v6-compressed", "active", 45, 12, 4, 2, "203.0.113.1"),
+            "2001:0db8:0:0:0:0:0:2": (65102, "v6-expanded", "idle", 5, 0, 0, 0, "203.0.113.2"),
+        }
+        for address, values in expected.items():
+            self.assertIn(address, neighbors)
+            neighbor = neighbors[address]
+            self.assertEqual(neighbor["remote AS"], values[0])
+            self.assertEqual(neighbor["description"], values[1])
+            self.assertEqual(neighbor["state"], values[2])
+            self.assertEqual(neighbor["mrai"], values[3])
+            self.assertEqual(neighbor["accepted prefixes"], values[4])
+            self.assertEqual(neighbor["connections established"], values[5])
+            self.assertEqual(neighbor["connections dropped"], values[6])
+            self.assertEqual(neighbor["remote routerid"], values[7])
+            self.assertEqual(neighbor["local AS"], 65000)
+
+    def test_message_statistics_are_complete_integer_pairs_per_neighbor(self):
+        neighbors = self.collect()
+        self.assertIn("2001:db8::1", neighbors)
+        self.assertEqual(neighbors["2001:db8::1"].get("message statistics"), {
+            "Opens": {"sent": 6, "rcvd": 7},
+            "Notifications": {"sent": 0, "rcvd": 1},
+            "Updates": {"sent": 8, "rcvd": 9},
+            "Keepalives": {"sent": 10, "rcvd": 11},
+            "Route Refresh": {"sent": 2, "rcvd": 3},
+            "Capability": {"sent": 4, "rcvd": 5},
+            "Total": {"sent": 30, "rcvd": 36},
+        })
+        self.assertIn("2001:0db8:0:0:0:0:0:2", neighbors)
+        self.assertEqual(neighbors["2001:0db8:0:0:0:0:0:2"].get("message statistics", {}).get("Total"),
+                         {"sent": 1, "rcvd": 0})
+
+    def test_existing_ipv4_record_remains_compatible(self):
+        neighbors = self.collect()
+        self.assertIn("192.0.2.1", neighbors)
+        neighbor = neighbors["192.0.2.1"]
+        self.assertEqual(neighbor["remote AS"], 65001)
+        self.assertEqual(neighbor["local AS"], 65000)
+        self.assertEqual(neighbor["description"], "v4-edge")
+        self.assertEqual(neighbor["state"], "established")
+        self.assertEqual(neighbor["message statistics"]["Total"], {"sent": 101, "rcvd": 125})
+
+
+if __name__ == "__main__":
+    unittest.main()
