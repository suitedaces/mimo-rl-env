diff --git a/napari/layers/labels/_tests/test_labels.py b/napari/layers/labels/_tests/test_labels.py
index 5e2b5762..7938db97 100644
--- a/napari/layers/labels/_tests/test_labels.py
+++ b/napari/layers/labels/_tests/test_labels.py
@@ -1585,3 +1585,44 @@ class TestLabels:
             obj,
             {"seed", "num_colors", "show_selected_label", "color"},
         )
+
+
+def test_contour_negative_raises_value_error():
+    """Setting contour to a negative value must raise ValueError.
+
+    See https://github.com/napari/napari/issues/... -- values < 0
+    used to behave like 0 (whole label filled in).
+    """
+    layer = Labels(np.zeros((5, 5), dtype=np.int32))
+    with pytest.raises(ValueError):
+        layer.contour = -1
+
+
+def test_contour_negative_large_raises_value_error():
+    """A large negative contour value still raises ValueError."""
+    layer = Labels(np.zeros((5, 5), dtype=np.int32))
+    with pytest.raises(ValueError):
+        layer.contour = -100
+
+
+def test_contour_negative_preserves_previous_value():
+    """A failed negative assignment must not clobber the previous contour value."""
+    layer = Labels(np.zeros((5, 5), dtype=np.int32))
+    layer.contour = 3
+    with pytest.raises(ValueError):
+        layer.contour = -1
+    assert layer.contour == 3
+
+
+def test_contour_zero_allowed():
+    """Setting contour to 0 is the documented default and must not raise."""
+    layer = Labels(np.zeros((5, 5), dtype=np.int32))
+    layer.contour = 0
+    assert layer.contour == 0
+
+
+def test_contour_positive_allowed():
+    """Setting contour to a positive integer must not raise."""
+    layer = Labels(np.zeros((5, 5), dtype=np.int32))
+    layer.contour = 5
+    assert layer.contour == 5
