@@ -0,0 +1,41 @@
+import pytest
+from django import forms
+from django_dynamic_fixture import get
+
+from readthedocs.projects import forms as project_forms
+from readthedocs.projects.models import AddonsConfig, Project
+
+
+def get_addons_config_form_class():
+    for value in vars(project_forms).values():
+        if not isinstance(value, type):
+            continue
+        if not issubclass(value, forms.ModelForm):
+            continue
+        meta = getattr(value, "Meta", None)
+        if getattr(meta, "model", None) is AddonsConfig:
+            fields = getattr(meta, "fields", ())
+            if "enabled" in fields and "project" in fields:
+                return value
+    raise AssertionError("Could not find the AddonsConfig ModelForm")
+
+
+@pytest.mark.django_db
+def test_addons_config_form_exposes_shared_root_selector_only():
+    form_class = get_addons_config_form_class()
+    form = form_class(project=get(Project))
+
+    old_fields = {
+        "doc_diff_root_selector",
+        "linkpreviews_root_selector",
+        "linkpreviews_doctool_name",
+        "linkpreviews_doctool_version",
+    }
+
+    assert "options_root_selector" in form.fields
+    for field_name in old_fields:
+        assert field_name not in form.fields
+
+    root_selector_field = form.fields["options_root_selector"]
+    assert root_selector_field.label == "CSS main content selector"
+    assert root_selector_field.widget.attrs.get("placeholder") == "[role=main]"
