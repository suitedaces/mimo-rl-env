@@ -0,0 +1,32 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+set +u
+source /testbed/.build_env/.venv/bin/activate
+set -u
+export DJANGO_SETTINGS_MODULE=readthedocs.settings.proxito.test
+export PYTHONPATH=/testbed:/testbed/readthedocs
+export DJANGO_SETTINGS_SKIP_LOCAL=True
+
+case "${1:-}" in
+  base)
+    python -m pytest \
+      readthedocs/proxito/tests/test_hosting.py::TestReadTheDocsConfigJson::test_get_config_v1 \
+      readthedocs/proxito/tests/test_hosting.py::TestReadTheDocsConfigJson::test_linkpreviews \
+      -v --tb=short
+    ;;
+  new)
+    python -m pytest \
+      readthedocs/projects/tests/test_addons_config.py \
+      readthedocs/projects/tests/test_addons_config_forms.py \
+      readthedocs/proxito/tests/test_hosting.py::TestReadTheDocsConfigJson::test_get_config_v1 \
+      readthedocs/proxito/tests/test_hosting.py::TestReadTheDocsConfigJson::test_linkpreviews \
+      readthedocs/proxito/tests/test_hosting.py::TestReadTheDocsConfigJson::test_hosting_addons_options_root_selector_uses_configured_value_and_blank \
+      -v --tb=short
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
