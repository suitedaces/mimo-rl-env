@@ -0,0 +1,22 @@
+import pytest
+from django_dynamic_fixture import get
+
+from readthedocs.projects.models import AddonsConfig, Project
+
+
+@pytest.mark.django_db
+def test_addons_config_model_has_shared_root_selector():
+    field_names = {field.name for field in AddonsConfig._meta.get_fields()}
+    assert "options_root_selector" in field_names
+
+    addons_config = get(AddonsConfig, project=get(Project))
+
+    addons_config.options_root_selector = ".article-body"
+    addons_config.save()
+    addons_config.refresh_from_db()
+    assert addons_config.options_root_selector == ".article-body"
+
+    addons_config.options_root_selector = ""
+    addons_config.save()
+    addons_config.refresh_from_db()
+    assert addons_config.options_root_selector in ("", None)
