+package usercase_test_coderl
+
+
+
+
+
+
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"testing"
+
+	linq "github.com/ahmetb/go-linq/v4"
+)
+
+type record struct {
+	Group string
+	Name  string
+}
+
+func collect(q linq.Query) []any {
+	out := []any{}
+	q.Iterate(func(v any) bool {
+		out = append(out, v)
+		return true
+	})
+	return out
+}
+
+func requireEqual(t *testing.T, actual, expected any) {
+	t.Helper()
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("actual %#v, expected %#v", actual, expected)
+	}
+}
+
+func requirePanicString(t *testing.T, expected string, fn func()) {
+	t.Helper()
+	defer func() {
+		if r := recover(); r != nil {
+			actual := fmt.Sprint(r)
+			if actual != expected {
+				t.Fatalf("panic %q, expected %q", actual, expected)
+			}
+			return
+		}
+		t.Fatalf("expected panic %q", expected)
+	}()
+	fn()
+}
+
+func requireLengthTwoStringsBeforeB(t *testing.T, actual []any) {
+	t.Helper()
+	requireEqual(t, len(actual), 3)
+	if actual[2] != "b" {
+		t.Fatalf("expected b after length-2 strings, got %#v", actual)
+	}
+	seen := map[string]bool{}
+	for _, v := range actual[:2] {
+		s, ok := v.(string)
+		if !ok || len(s) != 2 {
+			t.Fatalf("expected length-2 strings before b, got %#v", actual)
+		}
+		seen[s] = true
+	}
+	if !seen["aa"] || !seen["cc"] {
+		t.Fatalf("expected aa and cc before b, got %#v", actual)
+	}
+}
+
+func snapshotDir(t *testing.T, dir string) []string {
+	t.Helper()
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatalf("ReadDir(%q): %v", dir, err)
+	}
+	names := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		names = append(names, entry.Name())
+	}
+	sort.Strings(names)
+	return names
+}
+
+func TestOrderByAscendingIntegers(t *testing.T) {
+
+
+	actual := collect(linq.From([]int{3, 1, 2}).OrderBy(func(v any) any {
+		return v.(int)
+	}).Query)
+	requireEqual(t, actual, []any{1, 2, 3})
+}
+
+func TestOrderByDescendingByStringLength(t *testing.T) {
+
+
+	actual := collect(linq.From([]string{"aa", "b", "cc"}).OrderByDescending(func(v any) any {
+		return len(v.(string))
+	}).Query)
+
+	requireLengthTwoStringsBeforeB(t, actual)
+}
+
+func TestOrderByThenByDescendingMultipleKeys(t *testing.T) {
+
+
+	input := []record{
+		{Group: "b", Name: "amy"},
+		{Group: "a", Name: "zoe"},
+		{Group: "a", Name: "max"},
+		{Group: "b", Name: "zoe"},
+		{Group: "a", Name: "amy"},
+	}
+	actual := collect(linq.From(input).
+		OrderBy(func(v any) any { return v.(record).Group }).
+		ThenByDescending(func(v any) any { return v.(record).Name }).Query)
+	requireEqual(t, actual, []any{
+		record{Group: "a", Name: "zoe"},
+		record{Group: "a", Name: "max"},
+		record{Group: "a", Name: "amy"},
+		record{Group: "b", Name: "zoe"},
+		record{Group: "b", Name: "amy"},
+	})
+}
+
+func TestSortWithUntypedLess(t *testing.T) {
+
+
+	actual := collect(linq.From([]int{3, 1, 2}).Sort(func(i, j any) bool {
+		return i.(int) < j.(int)
+	}))
+	requireEqual(t, actual, []any{1, 2, 3})
+}
+
+func TestOrderByTAcceptsStronglyTypedSelector(t *testing.T) {
+
+
+	actual := collect(linq.From([]int{4, -1, 2, 0}).OrderByT(func(v int) int {
+		return v
+	}).Query)
+	requireEqual(t, actual, []any{-1, 0, 2, 4})
+}
+
+func TestOrderByDescendingTAcceptsStronglyTypedSelector(t *testing.T) {
+
+
+	actual := collect(linq.From([]string{"aa", "b", "cc", "ddd"}).OrderByDescendingT(func(v string) int {
+		return len(v)
+	}).Query)
+
+	requireEqual(t, len(actual), 4)
+	requireEqual(t, actual[0], "ddd")
+	requireLengthTwoStringsBeforeB(t, actual[1:])
+}
+
+func TestThenByTAcceptsStronglyTypedSelector(t *testing.T) {
+
+
+	input := []record{
+		{Group: "x", Name: "ben"},
+		{Group: "x", Name: "ada"},
+		{Group: "a", Name: "cam"},
+		{Group: "a", Name: "bob"},
+	}
+	actual := collect(linq.From(input).
+		OrderByT(func(v record) string { return v.Group }).
+		ThenByT(func(v record) string { return v.Name }).Query)
+	requireEqual(t, actual, []any{
+		record{Group: "a", Name: "bob"},
+		record{Group: "a", Name: "cam"},
+		record{Group: "x", Name: "ada"},
+		record{Group: "x", Name: "ben"},
+	})
+}
+
+func TestThenByDescendingTAcceptsStronglyTypedSelector(t *testing.T) {
+
+
+	input := []record{
+		{Group: "x", Name: "ben"},
+		{Group: "x", Name: "ada"},
+		{Group: "a", Name: "cam"},
+		{Group: "a", Name: "bob"},
+	}
+	actual := collect(linq.From(input).
+		OrderByT(func(v record) string { return v.Group }).
+		ThenByDescendingT(func(v record) string { return v.Name }).Query)
+	requireEqual(t, actual, []any{
+		record{Group: "a", Name: "cam"},
+		record{Group: "a", Name: "bob"},
+		record{Group: "x", Name: "ben"},
+		record{Group: "x", Name: "ada"},
+	})
+}
+
+func TestSortTAcceptsStronglyTypedLess(t *testing.T) {
+
+
+	actual := collect(linq.From([]int{5, 1, 4, 1}).SortT(func(i, j int) bool {
+		return i < j
+	}))
+	requireEqual(t, actual, []any{1, 1, 4, 5})
+}
+
+func TestEmptyInputOrdersToEmpty(t *testing.T) {
+
+
+	actual := collect(linq.From([]int{}).OrderBy(func(v any) any {
+		return v.(int)
+	}).Query)
+	requireEqual(t, actual, []any{})
+}
+
+func TestEarlyYieldStopsReturnedIteration(t *testing.T) {
+
+
+	actual := []any{}
+	linq.From([]int{4, 1, 3, 2}).OrderBy(func(v any) any {
+		return v.(int)
+	}).Iterate(func(v any) bool {
+		actual = append(actual, v)
+		return len(actual) < 2
+	})
+	requireEqual(t, actual, []any{1, 2})
+}
+
+func TestCreatingOrderedQueryIsLazy(t *testing.T) {
+
+
+	sourceStarted := 0
+	selectorCalls := 0
+	source := linq.Query{
+		Iterate: func(yield func(any) bool) {
+			sourceStarted++
+			for _, v := range []int{3, 1, 2} {
+				if !yield(v) {
+					return
+				}
+			}
+		},
+	}
+
+	ordered := source.OrderBy(func(v any) any {
+		selectorCalls++
+		return v.(int)
+	})
+
+	requireEqual(t, sourceStarted, 0)
+	requireEqual(t, selectorCalls, 0)
+	requireEqual(t, collect(ordered.Query), []any{1, 2, 3})
+	requireEqual(t, sourceStarted, 1)
+
+	if selectorCalls == 0 {
+		t.Fatalf("selector was not called during iteration")
+	}
+}
+
+func TestOrderByTInvalidSignaturePanicsWithValidationMessage(t *testing.T) {
+
+
+	requirePanicString(t, "OrderByT: parameter [selectorFn] has a invalid function signature. Expected: 'func(T)T', actual: 'func(int,int)int'", func() {
+		linq.From([]int{1, 2}).OrderByT(func(i, j int) int { return i })
+	})
+}
+
+func TestSortTInvalidSignaturePanicsWithValidationMessage(t *testing.T) {
+
+
+	requirePanicString(t, "SortT: parameter [lessFn] has a invalid function signature. Expected: 'func(T,T)bool', actual: 'func(int,int)string'", func() {
+		linq.From([]int{1, 2}).SortT(func(i, j int) string { return "" })
+	})
+}
+
+func TestReferentialTransparencySameQuerySameValues(t *testing.T) {
+	source := []record{
+		{Group: "b", Name: "amy"},
+		{Group: "a", Name: "zoe"},
+		{Group: "a", Name: "max"},
+	}
+	query := linq.From(source).
+		OrderBy(func(v any) any { return v.(record).Group }).
+		ThenByDescending(func(v any) any { return v.(record).Name })
+
+	expected := []any{
+		record{Group: "a", Name: "zoe"},
+		record{Group: "a", Name: "max"},
+		record{Group: "b", Name: "amy"},
+	}
+	requireEqual(t, collect(query.Query), expected)
+	requireEqual(t, collect(query.Query), expected)
+}
+
+func TestOrderingDoesNotMutateCallerInput(t *testing.T) {
+	source := []int{3, 1, 2}
+	before := append([]int(nil), source...)
+
+	actual := collect(linq.From(source).OrderBy(func(v any) any {
+		return v.(int)
+	}).Query)
+
+	requireEqual(t, actual, []any{1, 2, 3})
+	requireEqual(t, source, before)
+}
+
+func TestNoGlobalStateWithInterleavedOrderingNoise(t *testing.T) {
+	input := []int{3, 1, 2}
+	first := collect(linq.From(input).OrderBy(func(v any) any {
+		return v.(int)
+	}).Query)
+
+	requireEqual(t, collect(linq.From([]string{"zz", "a"}).OrderBy(func(v any) any {
+		return len(v.(string))
+	}).Query), []any{"a", "zz"})
+	requireEqual(t, collect(linq.From([]int{9, 7, 8}).Sort(func(i, j any) bool {
+		return i.(int) < j.(int)
+	})), []any{7, 8, 9})
+
+	second := collect(linq.From(input).OrderBy(func(v any) any {
+		return v.(int)
+	}).Query)
+	requireEqual(t, first, []any{1, 2, 3})
+	requireEqual(t, second, []any{1, 2, 3})
+}
+
+func TestOrderingDoesNotWriteRelativeFiles(t *testing.T) {
+	oldWd, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd: %v", err)
+	}
+	tmp := t.TempDir()
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatalf("Chdir(%q): %v", tmp, err)
+	}
+	defer func() {
+		if err := os.Chdir(oldWd); err != nil {
+			t.Fatalf("restore cwd: %v", err)
+		}
+	}()
+
+	before := snapshotDir(t, tmp)
+	requireEqual(t, collect(linq.From([]int{3, 1, 2}).OrderBy(func(v any) any {
+		return v.(int)
+	}).Query), []any{1, 2, 3})
+	after := snapshotDir(t, tmp)
+
+	requireEqual(t, after, before)
+}
