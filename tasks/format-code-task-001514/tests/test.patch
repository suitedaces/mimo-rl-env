@@ -0,0 +1,21 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+dev-switch node 22
+npm install --legacy-peer-deps 2>&1 | tail -1
+
+
+case "${1:-}" in
+  base)
+    npx vitest run src/utils/body.test.ts --testNamePattern 'should parse `multipart/form-data`|should parse `x-www-form-urlencoded`|should not parse multiple values in default|should parse multiple values if `all` option is true|should parse multiple values if values are `File`|should parse multiple values if key ends with `\[\]`|should return blank object if body is JSON'
+    ;;
+  new)
+    npx vitest run src/utils/body.test.ts --testNamePattern 'should parse dotted multipart form fields as nested objects with dot true|should parse deep dotted form fields with dot true|should parse dotted urlencoded fields as nested objects with dot true|should pass dot option through request context parseBody|should preserve File values in nested paths|should keep dotted keys flat by default|should keep dotted keys flat when dot is false|should keep dotted keys flat with all only|should combine dot true with all true for repeated dotted fields|should combine dot true with array suffix fields|should return null prototype body objects|should return null prototype nested body objects with dot true|should expose types for dot options and nested body data'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
