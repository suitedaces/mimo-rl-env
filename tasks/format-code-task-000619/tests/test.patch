@@ -20,10 +20,12 @@
 package osutil_test
 
 import (
+	"io"
 	"io/ioutil"
 	"os"
 	"path"
 	"path/filepath"
+	"strings"
 
 	. "gopkg.in/check.v1"
 
@@ -241,3 +244,151 @@ func (s *EnsureDirStateSuite) TestRemovesAllManagedFilesOnError(c *C) {
 	_, err = os.Stat(clash)
 	c.Assert(os.IsNotExist(err), Equals, true)
 }
+
+func (s *EnsureDirStateSuite) TestSymlinkFileStateState(c *C) {
+	for _, target := range []string{"relative-target-for-state", "/absolute/target/for/state"} {
+		state := osutil.SymlinkFileState{Target: target}
+
+		reader, size, mode, err := state.State()
+		c.Assert(err, IsNil)
+		defer reader.Close()
+
+		content, err := ioutil.ReadAll(reader)
+		c.Assert(err, IsNil)
+		c.Check(mode.Type(), Equals, os.ModeSymlink)
+		c.Check(size, Equals, int64(len(target)))
+		c.Check(string(content), Equals, target)
+	}
+}
+
+type testFileState struct {
+	target string
+	mode   os.FileMode
+}
+
+func (s testFileState) State() (io.ReadCloser, int64, os.FileMode, error) {
+	return ioutil.NopCloser(strings.NewReader(s.target)), int64(len(s.target)), s.mode, nil
+}
+
+func (s *EnsureDirStateSuite) TestEnsureFileStateCreatesMissingSymlink(c *C) {
+	linkPath := filepath.Join(s.dir, "direct-created-link.snap")
+	target := "direct-created-target"
+
+	err := osutil.EnsureFileState(linkPath, osutil.SymlinkFileState{Target: target})
+	c.Assert(err, IsNil)
+
+	info, err := os.Lstat(linkPath)
+	c.Assert(err, IsNil)
+	c.Check(info.Mode().Type(), Equals, os.ModeSymlink)
+	link, err := os.Readlink(linkPath)
+	c.Assert(err, IsNil)
+	c.Check(link, Equals, target)
+}
+
+func (s *EnsureDirStateSuite) TestEnsureFileStateAcceptsGenericSymlinkFileState(c *C) {
+	linkPath := filepath.Join(s.dir, "generic-created-link.snap")
+	target := "generic-created-target"
+
+	err := osutil.EnsureFileState(linkPath, testFileState{target: target, mode: os.ModeSymlink})
+	c.Assert(err, IsNil)
+
+	link, err := os.Readlink(linkPath)
+	c.Assert(err, IsNil)
+	c.Check(link, Equals, target)
+}
+
+func (s *EnsureDirStateSuite) TestEnsureFileStateSameSymlinkReturnsErrSameState(c *C) {
+	linkPath := filepath.Join(s.dir, "same-link.snap")
+	target := "same-target"
+	c.Assert(os.Symlink(target, linkPath), IsNil)
+
+	err := osutil.EnsureFileState(linkPath, osutil.SymlinkFileState{Target: target})
+	c.Check(err, Equals, osutil.ErrSameState)
+	link, err := os.Readlink(linkPath)
+	c.Assert(err, IsNil)
+	c.Check(link, Equals, target)
+}
+
+func (s *EnsureDirStateSuite) TestEnsureFileStateReplacesDifferentSymlink(c *C) {
+	linkPath := filepath.Join(s.dir, "replaced-link.snap")
+	c.Assert(os.Symlink("old-target-for-replace", linkPath), IsNil)
+
+	err := osutil.EnsureFileState(linkPath, osutil.SymlinkFileState{Target: "new-target-for-replace"})
+	c.Assert(err, IsNil)
+	link, err := os.Readlink(linkPath)
+	c.Assert(err, IsNil)
+	c.Check(link, Equals, "new-target-for-replace")
+}
+
+func (s *EnsureDirStateSuite) TestEnsureFileStateReplacesRegularFileWithSymlink(c *C) {
+	linkPath := filepath.Join(s.dir, "regular-becomes-link.snap")
+	c.Assert(ioutil.WriteFile(linkPath, []byte("old regular content"), 0600), IsNil)
+
+	err := osutil.EnsureFileState(linkPath, osutil.SymlinkFileState{Target: "target-after-regular"})
+	c.Assert(err, IsNil)
+	link, err := os.Readlink(linkPath)
+	c.Assert(err, IsNil)
+	c.Check(link, Equals, "target-after-regular")
+}
+
+func (s *EnsureDirStateSuite) TestEnsureDirStateCreatesMissingSymlink(c *C) {
+	target := "dir-state-created-target"
+
+	changed, removed, err := osutil.EnsureDirState(s.dir, s.glob, map[string]osutil.FileState{
+		"dir-created-link.snap": osutil.SymlinkFileState{Target: target},
+	})
+	c.Assert(err, IsNil)
+	c.Check(changed, DeepEquals, []string{"dir-created-link.snap"})
+	c.Check(removed, HasLen, 0)
+
+	link, err := os.Readlink(filepath.Join(s.dir, "dir-created-link.snap"))
+	c.Assert(err, IsNil)
+	c.Check(link, Equals, target)
+}
+
+func (s *EnsureDirStateSuite) TestEnsureDirStateSameSymlinkNoChange(c *C) {
+	linkPath := filepath.Join(s.dir, "dir-same-link.snap")
+	target := "dir-same-target"
+	c.Assert(os.Symlink(target, linkPath), IsNil)
+
+	changed, removed, err := osutil.EnsureDirState(s.dir, s.glob, map[string]osutil.FileState{
+		"dir-same-link.snap": osutil.SymlinkFileState{Target: target},
+	})
+	c.Assert(err, IsNil)
+	c.Check(changed, HasLen, 0)
+	c.Check(removed, HasLen, 0)
+	link, err := os.Readlink(linkPath)
+	c.Assert(err, IsNil)
+	c.Check(link, Equals, target)
+}
+
+func (s *EnsureDirStateSuite) TestEnsureFileStateRejectsUnsupportedMode(c *C) {
+	linkPath := filepath.Join(s.dir, "unsupported-mode.snap")
+
+	for _, mode := range []os.FileMode{os.ModeDir, os.ModeNamedPipe} {
+		err := osutil.EnsureFileState(linkPath, testFileState{target: "ignored", mode: mode})
+		c.Assert(err, NotNil)
+	}
+}
+
+func (s *EnsureDirStateSuite) TestFileReferenceRejectsNonRegularPath(c *C) {
+	dirPath := filepath.Join(s.dir, "non-regular-directory")
+	c.Assert(os.Mkdir(dirPath, 0755), IsNil)
+
+	_, _, _, err := (osutil.FileReference{Path: dirPath}).State()
+	c.Assert(err, NotNil)
+}
+
+func (s *EnsureDirStateSuite) TestFileReferencePlusModeRejectsNonRegularMode(c *C) {
+	filePath := filepath.Join(s.dir, "regular-backing-file")
+	c.Assert(ioutil.WriteFile(filePath, []byte("content"), 0600), IsNil)
+
+	for _, mode := range []os.FileMode{os.ModeSymlink | 0644, os.ModeDir | 0755} {
+		state := osutil.FileReferencePlusMode{
+			FileReference: osutil.FileReference{Path: filePath},
+			Mode:          mode,
+		}
+		_, _, _, err := state.State()
+		c.Assert(err, NotNil)
+	}
+}
+
+func (s *EnsureDirStateSuite) TestMemoryFileStateRejectsNonRegularMode(c *C) {
+	for _, mode := range []os.FileMode{os.ModeSymlink | 0644, os.ModeDir | 0755} {
+		state := &osutil.MemoryFileState{
+			Content: []byte("content"),
+			Mode:    mode,
+		}
+		_, _, _, err := state.State()
+		c.Assert(err, NotNil)
+	}
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+
+
+new_filter='TestSymlinkFileStateState|TestEnsureFileStateCreatesMissingSymlink|TestEnsureFileStateAcceptsGenericSymlinkFileState|TestEnsureFileStateSameSymlinkReturnsErrSameState|TestEnsureFileStateReplacesDifferentSymlink|TestEnsureFileStateReplacesRegularFileWithSymlink|TestEnsureDirStateCreatesMissingSymlink|TestEnsureDirStateSameSymlinkNoChange|TestEnsureFileStateRejectsUnsupportedMode|TestFileReferenceRejectsNonRegularPath|TestFileReferencePlusModeRejectsNonRegularMode|TestMemoryFileStateRejectsNonRegularMode'
+
+case "${1:-}" in
+  base)
+    go test ./osutil/ -run TestDoesNotExist -count=0
+    ;;
+  new)
+    go test ./osutil/ -v -count=1 -check.f "$new_filter"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
