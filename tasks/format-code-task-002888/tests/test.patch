diff --git a/src/__tests__/theme.test.ts b/src/__tests__/theme.test.ts
index 4519341f..9f3b446b 100644
--- a/src/__tests__/theme.test.ts
+++ b/src/__tests__/theme.test.ts
@@ -1,6 +1,8 @@
 import { suite } from 'uvu'
 import * as assert from 'uvu/assert'
 
+import { virtualSheet } from '../sheets/index'
+import { create, strict } from '../index'
 import { makeThemeResolver } from '../twind/theme'
 
 const test = suite('theme')
@@ -60,4 +62,133 @@ test('negative is available and no-op', () => {
   assert.is(theme('spacing', 'px'), '1px')
 })
 
+test('three-level nested color via dot notation', () => {
+  const theme = makeThemeResolver({
+    extend: {
+      colors: {
+        v2: {
+          red: {
+            500: '#DC2626',
+          },
+        },
+      },
+    },
+  })
+
+  assert.is(theme('textColor', 'v2.red.500'), '#DC2626')
+  assert.is(theme('borderColor', 'v2.red.500'), '#DC2626')
+})
+
+test('three-level nested color via hyphen notation', () => {
+  const theme = makeThemeResolver({
+    extend: {
+      colors: {
+        v2: {
+          red: {
+            500: '#DC2626',
+          },
+        },
+      },
+    },
+  })
+
+  assert.is(theme('textColor', 'v2-red-500'), '#DC2626')
+  assert.is(theme('borderColor', 'v2-red-500'), '#DC2626')
+})
+
+test('three-level nested color via array notation', () => {
+  const theme = makeThemeResolver({
+    extend: {
+      colors: {
+        v2: {
+          red: {
+            500: '#DC2626',
+          },
+        },
+      },
+    },
+  })
+
+  assert.is(theme('textColor', ['v2', 'red', '500']), '#DC2626')
+  assert.is(theme('borderColor', ['v2', 'red', '500']), '#DC2626')
+})
+
+test('three-level nested color via tw generates CSS', () => {
+  const sheet = virtualSheet()
+  const { tw } = create({
+    sheet,
+    mode: strict,
+    preflight: false,
+    prefix: false,
+    theme: {
+      extend: {
+        colors: {
+          v2: {
+            red: {
+              500: '#DC2626',
+            },
+          },
+        },
+      },
+    },
+  })
+
+  assert.is(tw('text-v2-red-500'), 'text-v2-red-500')
+  assert.equal(sheet.target, [
+    '.text-v2-red-500{--tw-text-opacity:1;color:#DC2626;color:rgba(220,38,38,var(--tw-text-opacity))}',
+  ])
+})
+
+test('nested DEFAULT applies at deeper level', () => {
+  const theme = makeThemeResolver({
+    extend: {
+      colors: {
+        brand: {
+          primary: {
+            DEFAULT: '#ff0000',
+            light: '#ff9999',
+          },
+        },
+      },
+    },
+  })
+
+  assert.is(theme('textColor', 'brand.primary'), '#ff0000')
+  assert.is(theme('textColor', 'brand-primary'), '#ff0000')
+  assert.is(theme('textColor', ['brand', 'primary']), '#ff0000')
+})
+
+test('sibling color at deep DEFAULT level resolves', () => {
+  const theme = makeThemeResolver({
+    extend: {
+      colors: {
+        brand: {
+          primary: {
+            DEFAULT: '#ff0000',
+            light: '#ff9999',
+          },
+        },
+      },
+    },
+  })
+
+  assert.is(theme('textColor', 'brand.primary.light'), '#ff9999')
+  assert.is(theme('textColor', 'brand-primary-light'), '#ff9999')
+})
+
+test('two-level nested color still works (preservation)', () => {
+  const theme = makeThemeResolver({
+    extend: {
+      colors: {
+        accent: {
+          500: '#abcdef',
+        },
+      },
+    },
+  })
+
+  assert.is(theme('textColor', 'accent.500'), '#abcdef')
+  assert.is(theme('textColor', 'accent-500'), '#abcdef')
+})
+
 test.run()
