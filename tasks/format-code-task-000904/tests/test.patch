+func newStampsFilteringTestServer(t *testing.T) (*http.Client, []byte, []byte) {
+	t.Helper()
+
+	existingBatch := postagetesting.MustNewBatch(postagetesting.WithValue(20))
+	staleBatch := postagetesting.MustNewBatch(postagetesting.WithValue(30))
+
+	existingIssuer := postage.NewStampIssuer("", "", existingBatch.ID, big.NewInt(3), 11, 10, 1000, true)
+	staleIssuer := postage.NewStampIssuer("", "", staleBatch.ID, big.NewInt(4), 12, 10, 1001, true)
+	mp := mockpost.New(mockpost.WithIssuer(existingIssuer))
+	if err := mp.Add(staleIssuer); err != nil {
+		t.Fatal(err)
+	}
+
+	cs := &postage.ChainState{Block: 10, TotalAmount: big.NewInt(5), CurrentPrice: big.NewInt(2)}
+	bs := newSelectiveBatchStore(cs, existingBatch)
+	ts, _, _, _ := newTestServer(t, testServerOptions{DebugAPI: true, Post: mp, BatchStore: bs, BlockTime: big.NewInt(2)})
+
+	return ts, existingBatch.ID, staleBatch.ID
+}
+
+type selectiveBatchStore struct {
+	*mock.BatchStore
+	batch *postage.Batch
+}
+
+func newSelectiveBatchStore(cs *postage.ChainState, batch *postage.Batch) *selectiveBatchStore {
+	return &selectiveBatchStore{
+		BatchStore: mock.New(mock.WithChainState(cs)),
+		batch:      batch,
+	}
+}
+
+func (bs *selectiveBatchStore) Get(id []byte) (*postage.Batch, error) {
+	if bs.batch != nil && bytes.Equal(bs.batch.ID, id) {
+		return bs.batch, nil
+	}
+	return nil, storage.ErrNotFound
+}
+
+func (bs *selectiveBatchStore) Exists(id []byte) (bool, error) {
+	return bs.batch != nil && bytes.Equal(bs.batch.ID, id), nil
+}
+
+func (bs *selectiveBatchStore) Iterate(f func(*postage.Batch) (bool, error)) error {
+	if bs.batch == nil {
+		return nil
+	}
+	_, err := f(bs.batch)
+	return err
+}
+
+type observedPostageStampsResponse struct {
+	Stamps []observedPostageStamp `json:"stamps"`
+}
+
+type observedPostageStamp struct {
+	BatchID string `json:"batchID"`
+	Exists  bool   `json:"exists"`
+	Usable  bool   `json:"usable"`
+}
+
+func getStampsResponse(t *testing.T, client *http.Client, path string) observedPostageStampsResponse {
+	t.Helper()
+
+	req, err := http.NewRequest(http.MethodGet, path, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	res, err := client.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer res.Body.Close()
+
+	if res.StatusCode != http.StatusOK {
+		t.Fatalf("got status %d, want %d", res.StatusCode, http.StatusOK)
+	}
+
+	var out observedPostageStampsResponse
+	if err := json.NewDecoder(res.Body).Decode(&out); err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+
+func containsStamp(resp observedPostageStampsResponse, batchID []byte) bool {
+	_, ok := findStamp(resp, batchID)
+	return ok
+}
+
+func findStamp(resp observedPostageStampsResponse, batchID []byte) (observedPostageStamp, bool) {
+	want := hex.EncodeToString(batchID)
+	for _, stamp := range resp.Stamps {
+		if stamp.BatchID == want {
+			return stamp, true
+		}
+	}
+	return observedPostageStamp{}, false
+}
+
+func openAPIPathBlock(t *testing.T, body, marker string) string {
+	t.Helper()
+
+	start := strings.Index(body, marker)
+	if start < 0 {
+		t.Fatalf("openapi document does not contain marker %q", marker)
+	}
+	rest := body[start+len(marker):]
+	end := strings.Index(rest, "\n  \"/")
+	if end < 0 {
+		return rest
+	}
+	return rest[:end]
 }
 
