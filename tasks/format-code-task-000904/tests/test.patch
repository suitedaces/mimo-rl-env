+  new)
+    run_api_test '^TestPostageGetStamps$/^expired_batch$'
+    run_api_test '^(TestPostageGetStamps_FilterStaleByDefault|TestPostageGetStamps_AllTrueIncludesStale|TestPostageGetStamps_AllQueryParsing|TestOpenAPIStampsDocumentsAllParameter)$'
+    ;;
