+  GONOSUMCHECK='*' GONOSUMDB='*' GOFLAGS='-mod=mod' go get golang.org/x/net@v0.33.0 golang.org/x/sys@v0.28.0
+  GONOSUMCHECK='*' GONOSUMDB='*' GOFLAGS='-mod=mod' go mod tidy
+}
+
+run_api_test() {
+  local pattern="$1"
+  GONOSUMCHECK='*' GONOSUMDB='*' GOFLAGS='-mod=mod' go test -v -run "$pattern" -count=1 ./pkg/api/
+}
+
+prepare_go_env
+
