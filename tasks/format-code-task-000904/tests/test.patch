+func TestPostageGetStamps_FilterStaleByDefault(t *testing.T) {
+	ts, existingID, staleID := newStampsFilteringTestServer(t)
+
+	resp := getStampsResponse(t, ts, "/stamps")
+
+	if !containsStamp(resp, existingID) {
+		t.Fatalf("expected default /stamps response to include stamp backed by an existing batch %x; got %+v", existingID, resp.Stamps)
+	}
+	if containsStamp(resp, staleID) {
+		t.Fatalf("expected default /stamps response to omit stale stamp %x; got %+v", staleID, resp.Stamps)
+	}
+}
+
+func TestPostageGetStamps_AllTrueIncludesStale(t *testing.T) {
+	ts, existingID, staleID := newStampsFilteringTestServer(t)
+
+	resp := getStampsResponse(t, ts, "/stamps?all=true")
+
+	if !containsStamp(resp, existingID) {
+		t.Fatalf("expected all=true response to include stamp backed by an existing batch %x; got %+v", existingID, resp.Stamps)
+	}
+	staleStamp, ok := findStamp(resp, staleID)
+	if !ok {
+		t.Fatalf("expected all=true response to include stale stamp %x; got %+v", staleID, resp.Stamps)
+	}
+	if staleStamp.Exists {
+		t.Fatalf("expected stale stamp %x returned by all=true to have exists=false", staleID)
+	}
+	if staleStamp.Usable {
+		t.Fatalf("expected stale stamp %x returned by all=true to have usable=false", staleID)
+	}
+}
+
+func TestPostageGetStamps_AllQueryParsing(t *testing.T) {
