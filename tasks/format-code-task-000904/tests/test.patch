+
+	if !containsStamp(getStampsResponse(t, ts, "/stamps?all=TRUE"), staleID) {
+		t.Fatalf("expected all=TRUE to include stale stamp %x", staleID)
+	}
+
+	for _, path := range []string{"/stamps", "/stamps?all=false", "/stamps?all=yes"} {
+		resp := getStampsResponse(t, ts, path)
+		if containsStamp(resp, staleID) {
+			t.Fatalf("expected %s to filter stale stamp %x; got %+v", path, staleID, resp.Stamps)
+		}
+	}
+}
