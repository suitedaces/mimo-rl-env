+func TestOpenAPIStampsDocumentsAllParameter(t *testing.T) {
+	for _, name := range []string{"Swarm.yaml", "SwarmDebug.yaml"} {
+		t.Run(name, func(t *testing.T) {
+			body, err := os.ReadFile(filepath.Join("..", "..", "openapi", name))
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			block := openAPIPathBlock(t, string(body), `  "/stamps":`)
+			if !strings.Contains(block, "name: all") || !strings.Contains(block, "in: query") {
+				t.Fatalf("%s /stamps block should document an all query parameter; block:\n%s", name, block)
+			}
+			for _, oldPhrase := range []string{
+				"Get all available stamps for this node",
+				"Returns an array of all available postage batches.",
+			} {
+				if strings.Contains(block, oldPhrase) {
+					t.Fatalf("%s /stamps block still contains stale default-response wording %q; block:\n%s", name, oldPhrase, block)
+				}
+			}
+		})
+	}
+}
