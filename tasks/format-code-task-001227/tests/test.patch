+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export BUNDLE_FROZEN=true
+export BUNDLE_DISABLE_VERSION_CHECK=true
+export GEM_SPEC_CACHE=/usr/local/bundle/specifications
+export RUBYGEMS_GEMDEPS=""
+
+if ! ruby -I /workspace/repo/lib -e 'require "rspec"; require "mail"; require "sanitize_email"' >/dev/null 2>&1; then
+  echo "Required offline Ruby gems are not installed" >&2
+  exit 127
+fi
+
+RSPEC_EXE="${RSPEC_EXE:-/usr/local/bundle/gems/rspec-core-3.13.6/exe/rspec}"
+if [[ ! -f "${RSPEC_EXE}" ]]; then
+  echo "RSpec executable is missing at ${RSPEC_EXE}" >&2
+  exit 127
+fi
+
+exec ruby "${RSPEC_EXE}" \
+  -O /dev/null \
+  -I /workspace/repo/lib \
+  /workspace/repo/usercase-test-coderl/sanitize_activation_spec.rb \
+  --format documentation
