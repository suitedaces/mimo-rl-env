diff --git a/tests/dialects/test_duckdb.py b/tests/dialects/test_duckdb.py
index 980f68eaa..c3f286501 100644
--- a/tests/dialects/test_duckdb.py
+++ b/tests/dialects/test_duckdb.py
@@ -623,3 +623,43 @@ class TestDuckDB(Validator):
                 "duckdb": "ALTER TABLE db.t1 RENAME TO t2",
             },
         )
+
+    def test_extra_types(self):
+
+
+
+        hugeint_expr = parse_one("CAST(x AS HUGEINT)", read="duckdb").find(exp.DataType)
+        self.assertEqual(hugeint_expr.this, exp.DataType.Type.INT128)
+
+        int128_expr = parse_one("CAST(x AS INT128)", read="duckdb").find(exp.DataType)
+        self.assertEqual(int128_expr.this, exp.DataType.Type.INT128)
+
+
+        hugeint_out = parse_one("CAST(x AS HUGEINT)", read="duckdb").sql(dialect="duckdb")
+        self.assertIn(hugeint_out, ("CAST(x AS HUGEINT)", "CAST(x AS INT128)"))
+
+        int128_out = parse_one("CAST(x AS INT128)", read="duckdb").sql(dialect="duckdb")
+        self.assertIn(int128_out, ("CAST(x AS HUGEINT)", "CAST(x AS INT128)"))
+
+
+        self.assertEqual(
+            parse_one("CAST(x AS NUMERIC)", read="duckdb").sql(dialect="duckdb"),
+            "CAST(x AS DECIMAL(18, 3))",
+        )
+
+
+        self.assertEqual(
+            parse_one("CAST(x AS NUMERIC(5, 2))", read="duckdb").sql(dialect="duckdb"),
+            "CAST(x AS DECIMAL(5, 2))",
+        )
+
+
+        self.assertEqual(
+            parse_one("CAST(x AS DECIMAL(5, 2))", read="duckdb").sql(dialect="duckdb"),
+            "CAST(x AS DECIMAL(5, 2))",
+        )
+
+
+        numeric_expr = parse_one("CAST(x AS NUMERIC)", read="duckdb").find(exp.DataType)
+        self.assertEqual(numeric_expr.this, exp.DataType.Type.DECIMAL)
+        self.assertEqual(len(numeric_expr.expressions), 2)
