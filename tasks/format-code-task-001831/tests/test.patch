diff --git a/usercase-test-coderl/test_siu_call.py b/usercase-test-coderl/test_siu_call.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_siu_call.py
@@ -0,0 +1,160 @@
+
+
+
+
+import json
+import subprocess
+import sys
+
+import pytest
+
+from siuba.siu import _, call
+
+
+def test_call_range_implicitly_receives_piped_value():
+
+
+
+    actual = 1 >> call(range)
+
+    assert actual == range(0, 1)
+    assert list(actual) == [0]
+
+
+def test_explicit_placeholder_can_be_first_positional_argument():
+
+
+
+    actual = 1 >> call(range, _, 2)
+
+    assert actual == range(1, 2)
+    assert list(actual) == [1]
+
+
+def test_explicit_placeholder_can_be_later_positional_argument():
+
+
+
+    actual = 1 >> call(range, 2, 3, _)
+
+    assert actual == range(2, 3, 1)
+    assert list(actual) == [2]
+
+
+def test_preserves_bound_callable_positional_and_keyword_arguments():
+
+
+
+    actual = "," >> call("a,b,c".split, _, maxsplit=1)
+
+    assert actual == ["a", "b,c"]
+
+
+def test_preserves_format_positional_and_keyword_arguments():
+
+
+
+    actual = 1 >> call("{0}_{1}_{b}".format, _, 2, b=3)
+
+    assert actual == "1_2_3"
+
+
+def test_keyword_values_can_be_siu_expressions():
+
+
+
+    actual = {"sep": ",", "limit": 1} >> call(
+        "a,b,c".split,
+        _["sep"],
+        maxsplit=_["limit"],
+    )
+
+    assert actual == ["a", "b,c"]
+
+
+def test_complete_siu_expression_as_only_argument():
+
+
+
+    actual = "abc" >> call(_[0].upper())
+
+    assert actual == "A"
+
+
+def test_siu_expression_first_argument_with_extra_args_raises_specific_error():
+
+
+
+
+    with pytest.raises(NotImplementedError):
+        call(_[0], 1)
+
+
+def test_constructing_deferred_step_does_not_execute_target_callable():
+
+
+
+    seen = []
+
+    def record(value):
+        seen.append(value)
+        return value * 10
+
+    step = call(record)
+
+    assert seen == []
+    assert 4 >> step == 40
+    assert seen == [4]
+
+
+def test_referential_transparency_same_input_same_value():
+    step = call(range)
+
+    assert list(3 >> step) == [0, 1, 2]
+    assert list(3 >> step) == [0, 1, 2]
+
+
+def test_does_not_mutate_caller_input():
+    data = {"sep": ",", "limit": 1}
+
+    actual = data >> call("a,b,c".split, _["sep"], maxsplit=_["limit"])
+
+    assert actual == ["a", "b,c"]
+
+    assert {"sep": ",", "limit": 1} >> call("a,b,c".split, _["sep"], maxsplit=_["limit"]) == ["a", "b,c"]
+
+    assert "," >> call("a,b,c".split, _, maxsplit=1) == ["a", "b,c"]
+
+
+def test_no_global_state_across_fresh_python_process():
+    in_process = list(1 >> call(range, _, 4))
+    script = """
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+from siuba.siu import _, call
+sys.stdout.write(json.dumps(list(1 >> call(range, _, 4))))
+"""
+
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        capture_output=True,
+    )
+    fresh_process = json.loads(completed.stdout)
+
+    assert in_process == [1, 2, 3]
+    assert fresh_process == [1, 2, 3]
+
+
+def test_call_evaluates_from_clean_cwd(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+
+    before = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob("*"))
+    actual = list(3 >> call(range, _, 5))
+
+    assert before == []
+    assert actual == [3, 4]
+
+    assert list(3 >> call(range, _, 5)) == [3, 4]
