index 000000000..75f48d88d
--- /dev/null
+++ b/web/client/utils/ogc/Filter/__tests__/codespec-xml-safety-test.js
@@ -0,0 +1,79 @@
+
+
+
+
+const expect = require('expect');
+const FilterBuilder = require('../FilterBuilder');
+const {DOMParser} = require('xmldom');
+
+const parse = (xml) => {
+    const errors = [];
+    const document = new DOMParser({
+        errorHandler: {
+            warning: message => errors.push(message),
+            error: message => errors.push(message),
+            fatalError: message => errors.push(message)
+        }
+    }).parseFromString(xml, 'text/xml');
+    expect(errors).toEqual([]);
+    return document;
+};
+const first = (doc, tag) => doc.getElementsByTagName(tag)[0];
+
+describe('FilterBuilder XML-safe serialization', () => {
+    it('escapes caller values in literal and property text nodes', () => {
+        const builder = new FilterBuilder();
+        const literalXml = builder.literal('A&B <C> "D"');
+        expect(literalXml.indexOf('A&B')).toBe(-1);
+        const literal = parse(literalXml);
+        expect(literal.documentElement.textContent).toBe('A&B <C> "D"');
+        const comparisonXml = builder.property('name<&').equalTo('x&y<z');
+        expect(comparisonXml.indexOf('name<&')).toBe(-1);
+        expect(comparisonXml.indexOf('x&y<z')).toBe(-1);
+        const comparison = parse(comparisonXml);
+        expect(first(comparison, 'ogc:PropertyName').textContent).toBe('name<&');
+        expect(first(comparison, 'ogc:Literal').textContent).toBe('x&y<z');
+        const referenceXml = builder.valueReference('field<&');
+        expect(referenceXml.indexOf('field<&')).toBe(-1);
+        const reference = parse(referenceXml);
+        expect(reference.documentElement.textContent).toBe('field<&');
+    });
+
+    it('escapes feature ids used in XML attributes', () => {
+        const builder = new FilterBuilder({filterNS: 'fes'});
+        const xml = builder.fidFilter('roads"&<1');
+        expect(xml.indexOf('roads"&<1')).toBe(-1);
+        const doc = parse(xml);
+        expect(first(doc, 'fes:FeatureId')).toExist();
+        expect(first(doc, 'fes:FeatureId').getAttribute('fid')).toBe('roads"&<1');
+    });
+
+    it('escapes function names and distance units in attributes', () => {
+        const builder = new FilterBuilder();
+        const fnXml = builder.func('fn"&<', builder.literal('ok'));
+        expect(fnXml.indexOf('fn"&<')).toBe(-1);
+        const fn = parse(fnXml);
+        expect(first(fn, 'ogc:Function')).toExist();
+        expect(first(fn, 'ogc:Function').getAttribute('name')).toBe('fn"&<');
+        const distanceXml = builder.property('geom').dwithin({type: 'Point', coordinates: [1, 2]}, 5, 'm"&<');
+        expect(distanceXml.indexOf('m"&<')).toBe(-1);
+        const distance = parse(distanceXml);
+        expect(first(distance, 'ogc:Distance')).toExist();
+        expect(first(distance, 'ogc:Distance').getAttribute('units')).toBe('m"&<');
+    });
+
+    it('keeps custom namespaces, WFS 2 value references, and nested composition intact', () => {
+        const builder = new FilterBuilder({filterNS: 'fes', wfsVersion: '2.0'});
+        const condition = builder.and(
+            builder.property('name<&').equalTo('A&B'),
+            builder.not(builder.property('status').isNull())
+        );
+        const xml = builder.filter(condition);
+        expect(xml.indexOf('name<&')).toBe(-1);
+        expect(xml.indexOf('A&B')).toBe(-1);
+        const doc = parse(xml);
+        expect(first(doc, 'fes:ValueReference').textContent).toBe('name<&');
+        expect(first(doc, 'fes:Literal').textContent).toBe('A&B');
+        expect(doc.getElementsByTagName('fes:ValueReference')[1].textContent).toBe('status');
+    });
+});
