diff --git a/usercase-test-coderl/preview.test.js b/usercase-test-coderl/preview.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/preview.test.js
@@ -0,0 +1,290 @@
+
+
+const assert = require('assert')
+const childProcess = require('child_process')
+const { load } = require('cheerio')
+const fs = require('fs')
+const http = require('http')
+const https = require('https')
+const net = require('net')
+const os = require('os')
+const path = require('path')
+const tls = require('tls')
+
+const mjml2html = require('/workspace/repo/packages/mjml/lib')
+
+const WITH_PREVIEW =
+  '<mjml><mj-head><mj-preview>Hello inbox</mj-preview></mj-head><mj-body><mj-section><mj-column><mj-text>Body copy</mj-text></mj-column></mj-section></mj-body></mjml>'
+const WITHOUT_PREVIEW =
+  '<mjml><mj-head></mj-head><mj-body><mj-section><mj-column><mj-text>Body copy</mj-text></mj-column></mj-section></mj-body></mjml>'
+const EMPTY_PREVIEW =
+  '<mjml><mj-head><mj-preview></mj-preview></mj-head><mj-body><mj-section><mj-column><mj-text>Body copy</mj-text></mj-column></mj-section></mj-body></mjml>'
+const STRICT_ENDING_PREVIEW =
+  '<mjml><mj-head><mj-preview>Sale <strong>now</strong> &amp; updates</mj-preview></mj-head><mj-body><mj-section><mj-column><mj-text>Strict body</mj-text></mj-column></mj-section></mj-body></mjml>'
+
+function loadBody(html) {
+  assert.strictEqual(typeof html, 'string')
+  const $ = load(html, { decodeEntities: false })
+  const body = $('body').first()
+  assert.strictEqual(body.length, 1)
+  return { $, body }
+}
+
+function compactStyle(style) {
+  return String(style || '')
+    .toLowerCase()
+    .replace(/\s+/g, '')
+}
+
+function isHiddenPreviewElement($, el) {
+  if (!el || String(el.tagName).toLowerCase() !== 'div') return false
+
+  const attrs = el.attribs || {}
+  const style = compactStyle(attrs.style)
+  const hiddenByAttribute = Object.prototype.hasOwnProperty.call(attrs, 'hidden')
+  const hiddenByStyle =
+    style.includes('display:none') &&
+    (style.includes('overflow:hidden') ||
+      style.includes('max-height:0') ||
+      style.includes('max-height:0px') ||
+      style.includes('opacity:0'))
+
+  return hiddenByAttribute || hiddenByStyle
+}
+
+function bodyChildren(html) {
+  const { $, body } = loadBody(html)
+  return { $, children: body.children().toArray() }
+}
+
+function hiddenPreviewElements(html) {
+  const { $, body } = loadBody(html)
+  return body
+    .find('div')
+    .toArray()
+    .filter((el) => isHiddenPreviewElement($, el))
+}
+
+function previewDescriptor(html) {
+  const { $, children } = bodyChildren(html)
+  const first = children[0]
+
+  if (!isHiddenPreviewElement($, first)) {
+    return null
+  }
+
+  return {
+    firstBodyChild: true,
+    hidden: true,
+    text: $(first).text(),
+  }
+}
+
+function assertPreviewFirstWithText(html, expectedText, visibleBodyText) {
+  const { $, children } = bodyChildren(html)
+  const first = children[0]
+
+
+  assert.ok(isHiddenPreviewElement($, first))
+  assert.strictEqual($(first).text(), expectedText)
+
+
+  const remainingBody = $(children.slice(1))
+  assert.ok(remainingBody.text().includes(visibleBodyText))
+}
+
+function assertNoPreviewContainerOrStyles(html) {
+
+  assert.strictEqual(hiddenPreviewElements(html).length, 0)
+}
+
+function assertVisibleBodyText(html, text) {
+  const { $, body } = loadBody(html)
+  const visibleBody = body.clone()
+
+  visibleBody
+    .find('div')
+    .filter((_, el) => isHiddenPreviewElement($, el))
+    .remove()
+
+
+  assert.ok(visibleBody.text().includes(text))
+}
+
+async function expectStrictValidationError(input) {
+  try {
+    await mjml2html(input, { validationLevel: 'strict' })
+  } catch (err) {
+    return err
+  }
+
+  throw new assert.AssertionError({
+    message: 'Expected mjml2html to throw a strict validation error',
+  })
+}
+
+describe('mj-preview acceptance behavior', function () {
+  it('renders a hidden preview div before the main email wrapper and keeps visible body copy', async function () {
+
+
+    const { html, errors } = await mjml2html(WITH_PREVIEW, {})
+
+    assert.deepStrictEqual(errors, [])
+    assertPreviewFirstWithText(html, 'Hello inbox', 'Body copy')
+    assertVisibleBodyText(html, 'Body copy')
+  })
+
+  it('does not emit preview markup or hidden preview styles when mj-preview is absent', async function () {
+
+
+    const { html, errors } = await mjml2html(WITHOUT_PREVIEW, {})
+
+    assert.deepStrictEqual(errors, [])
+    assertNoPreviewContainerOrStyles(html)
+    assertVisibleBodyText(html, 'Body copy')
+  })
+
+  it('does not emit an empty preview container or hidden preview styles for empty mj-preview', async function () {
+
+
+    const { html, errors } = await mjml2html(EMPTY_PREVIEW, {})
+
+    assert.deepStrictEqual(errors, [])
+    assertNoPreviewContainerOrStyles(html)
+    assertVisibleBodyText(html, 'Body copy')
+  })
+
+  it('accepts mj-preview in strict validation and uses ending-tag content as preview text', async function () {
+
+
+    const { html, errors } = await mjml2html(STRICT_ENDING_PREVIEW, {
+      validationLevel: 'strict',
+    })
+
+    assert.deepStrictEqual(errors, [])
+    assertPreviewFirstWithText(html, 'Sale now & updates', 'Strict body')
+    assertVisibleBodyText(html, 'Strict body')
+  })
+
+  it('throws a strict validation error when mj-preview is outside mj-head', async function () {
+    const err = await expectStrictValidationError(
+      '<mjml><mj-body><mj-preview>Wrong place</mj-preview></mj-body></mjml>',
+    )
+
+
+    assert.ok(err instanceof Error)
+    assert.ok(String(err.message || err).includes('mj-preview'))
+  })
+
+  it('is referentially transparent for the same preview input and options', async function () {
+    const first = await mjml2html(WITH_PREVIEW, {})
+    const second = await mjml2html(WITH_PREVIEW, {})
+
+
+    assert.deepStrictEqual(previewDescriptor(second.html), previewDescriptor(first.html))
+    assert.strictEqual(previewDescriptor(first.html).text, 'Hello inbox')
+  })
+
+  it('produces equivalent preview output when reusing the same options object', async function () {
+    const options = { validationLevel: 'strict' }
+
+    const first = await mjml2html(WITH_PREVIEW, options)
+    const second = await mjml2html(WITH_PREVIEW, options)
+
+
+    assert.deepStrictEqual(previewDescriptor(second.html), previewDescriptor(first.html))
+    assert.strictEqual(previewDescriptor(first.html).text, 'Hello inbox')
+  })
+
+  it('produces the same preview output in a fresh Node process', async function () {
+    const { html } = await mjml2html(WITH_PREVIEW, {})
+    const inProcess = previewDescriptor(html)
+    const script = `
+      const { load } = require('cheerio');
+      const mjml2html = require('/workspace/repo/packages/mjml/lib');
+      const input = ${JSON.stringify(WITH_PREVIEW)};
+      function compactStyle(style) {
+        return String(style || '').toLowerCase().replace(/\\s+/g, '');
+      }
+      function isHiddenPreviewElement($, el) {
+        if (!el || String(el.tagName).toLowerCase() !== 'div') return false;
+        const attrs = el.attribs || {};
+        const style = compactStyle(attrs.style);
+        const hiddenByAttribute = Object.prototype.hasOwnProperty.call(attrs, 'hidden');
+        const hiddenByStyle =
+          style.includes('display:none') &&
+          (style.includes('overflow:hidden') ||
+            style.includes('max-height:0') ||
+            style.includes('max-height:0px') ||
+            style.includes('opacity:0'));
+        return hiddenByAttribute || hiddenByStyle;
+      }
+      function previewDescriptor(html) {
+        const $ = load(html, { decodeEntities: false });
+        const first = $('body').first().children().toArray()[0];
+        if (!isHiddenPreviewElement($, first)) return null;
+        return { firstBodyChild: true, hidden: true, text: $(first).text() };
+      }
+      (async () => {
+        const { html } = await mjml2html(input, {});
+        process.stdout.write(JSON.stringify(previewDescriptor(html)));
+      })().catch((err) => {
+        process.stderr.write(err.stack || String(err));
+        process.exit(1);
+      });
+    `
+    const freshProcess = JSON.parse(
+      childProcess.execFileSync(process.execPath, ['-e', script], {
+        cwd: '/workspace/repo',
+        encoding: 'utf8',
+      }),
+    )
+
+
+    assert.strictEqual(inProcess.text, 'Hello inbox')
+    assert.deepStrictEqual(freshProcess, inProcess)
+  })
+
+  it('renders preview text from an empty cwd with network APIs blocked', async function () {
+    const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'mjml-preview-'))
+    const originalCwd = process.cwd()
+    const originals = {
+      netCreateConnection: net.createConnection,
+      tlsConnect: tls.connect,
+      httpRequest: http.request,
+      httpGet: http.get,
+      httpsRequest: https.request,
+      httpsGet: https.get,
+      fetch: global.fetch,
+    }
+    const blocked = () => {
+      throw new Error('Network access is not declared by the mj-preview query')
+    }
+
+    try {
+      process.chdir(tmp)
+      net.createConnection = blocked
+      tls.connect = blocked
+      http.request = blocked
+      http.get = blocked
+      https.request = blocked
+      https.get = blocked
+      global.fetch = blocked
+
+      const { html } = await mjml2html(WITH_PREVIEW, {})
+
+
+      assertPreviewFirstWithText(html, 'Hello inbox', 'Body copy')
+    } finally {
+      net.createConnection = originals.netCreateConnection
+      tls.connect = originals.tlsConnect
+      http.request = originals.httpRequest
+      http.get = originals.httpGet
+      https.request = originals.httpsRequest
+      https.get = originals.httpsGet
+      global.fetch = originals.fetch
+      process.chdir(originalCwd)
+      fs.rmSync(tmp, { recursive: true, force: true })
+    }
+  })
+})
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+for required_path in \
+  node_modules \
+  node_modules/.bin/lerna \
+  node_modules/.bin/mocha \
+  node_modules/.bin/babel \
+  babel.config.js \
+  lerna.json \
+  package.json
+do
+  if [ ! -e "$required_path" ]; then
+    echo "Missing offline prerequisite: $required_path" >&2
+    exit 1
+  fi
+done
+
+./node_modules/.bin/lerna run build --parallel --ignore mjml-browser >/dev/null
+exec ./node_modules/.bin/mocha /workspace/repo/usercase-test-coderl/preview.test.js --reporter spec
