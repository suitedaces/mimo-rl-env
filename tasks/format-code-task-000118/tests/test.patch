+func TestAccIBMPolicyAssignmentBasic(t *testing.T) {
+	var conf iampolicymanagementv1.GetPolicyAssignmentResponse
+	var name string = fmt.Sprintf("TerraformTemplateTest%d", acctest.RandIntRange(10, 100))
+
+	resource.Test(t, resource.TestCase{
+		PreCheck:     func() { acc.TestAccPreCheck(t) },
+		Providers:    acc.TestAccProviders,
+		CheckDestroy: testAccCheckIBMPolicyAssignmentDestroy,
+		Steps: []resource.TestStep{
+			{
+				Config: testAccCheckIBMPolicyAssignmentConfigBasic(name, os.Getenv("IBM_POLICY_ASSIGNMENT_TARGET_ACCOUNT_ID")),
+				Check: resource.ComposeAggregateTestCheckFunc(
+					testAccCheckIBMPolicyAssignmentExists("ibm_iam_policy_assignment.policy_assignment", conf),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "account_id"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "href"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "created_at"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "created_by_id"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "last_modified_at"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "last_modified_by_id"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "resources.#"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "resources.0.target.%"),
+				),
+			},
+			{
+				Config: testAccCheckIBMPolicyAssignmentConfigUpdate(name, os.Getenv("IBM_POLICY_ASSIGNMENT_TARGET_ACCOUNT_ID")),
+				Check: resource.ComposeAggregateTestCheckFunc(
+					testAccCheckIBMPolicyAssignmentExists("ibm_iam_policy_assignment.policy_assignment", conf),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "account_id"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "href"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "created_at"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "created_by_id"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "last_modified_at"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "last_modified_by_id"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "resources.#"),
+					resource.TestCheckResourceAttrSet("ibm_iam_policy_assignment.policy_assignment", "resources.0.target.%"),
