+package acctest
+
+import (
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+)
+
+const policyAssignmentEnvHelper = "IBM_POLICY_ASSIGNMENT_ENV_HELPER"
+
+func runAcctestHelper(t *testing.T, name string, env ...string) (string, error) {
+	t.Helper()
+	cmd := exec.Command(os.Args[0], "-test.run=^"+name+"$", "-test.v")
+	cmd.Env = append(os.Environ(), policyAssignmentEnvHelper+"=1")
+	cmd.Env = append(cmd.Env, env...)
+	out, err := cmd.CombinedOutput()
+	return string(out), err
+}
+
+func TestAcctestPolicyAssignmentTargetAccountEnv(t *testing.T) {
+	out, err := runAcctestHelper(
+		t,
+		"TestHelperAcctestPolicyAssignmentTargetAccountEnv",
+		"IBM_POLICY_ASSIGNMENT_TARGET_ACCOUNT_ID=target-account-from-env",
+	)
+	if err != nil {
+		t.Fatalf("helper failed: %v\n%s", err, out)
+	}
+	if strings.Contains(out, "IBM_POLICY_ASSIGNMENT_TARGET_ACCOUNT_ID") {
+		t.Fatalf("set-env output should not ask for IBM_POLICY_ASSIGNMENT_TARGET_ACCOUNT_ID; output:\n%s", out)
+	}
+}
+
+func TestHelperAcctestPolicyAssignmentTargetAccountEnv(t *testing.T) {
+	if os.Getenv(policyAssignmentEnvHelper) != "1" {
+		t.Skip("helper test")
+	}
+}
+
+func TestAcctestPolicyAssignmentTargetAccountEnvMissingNotice(t *testing.T) {
+	out, err := runAcctestHelper(
+		t,
+		"TestHelperAcctestPolicyAssignmentTargetAccountEnvMissingNotice",
+		"IBM_POLICY_ASSIGNMENT_TARGET_ACCOUNT_ID=",
+	)
+	if err != nil {
+		t.Fatalf("helper failed: %v\n%s", err, out)
+	}
+	if !strings.Contains(out, "IBM_POLICY_ASSIGNMENT_TARGET_ACCOUNT_ID") {
+		t.Fatalf("missing-env output should mention IBM_POLICY_ASSIGNMENT_TARGET_ACCOUNT_ID; output:\n%s", out)
+	}
+	if !strings.Contains(out, "ibm_iam_policy_assignment") {
+		t.Fatalf("missing-env output should mention ibm_iam_policy_assignment; output:\n%s", out)
+	}
+}
+
+func TestHelperAcctestPolicyAssignmentTargetAccountEnvMissingNotice(t *testing.T) {
+	if os.Getenv(policyAssignmentEnvHelper) != "1" {
+		t.Skip("helper test")
+	}
+}
