@@ -0,0 +1,267 @@
+package iampolicy_test
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"path/filepath"
+	"testing"
+
+	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
+
+	"github.com/IBM-Cloud/terraform-provider-ibm/ibm/provider"
+)
+
+func iamPolicyAssignmentResource(t *testing.T) *schema.Resource {
+	t.Helper()
+	p := provider.Provider()
+	r, ok := p.ResourcesMap["ibm_iam_policy_assignment"]
+	if !ok {
+		t.Fatalf("provider does not register ibm_iam_policy_assignment")
+	}
+	return r
+}
+
+func TestIBMIAMPolicyAssignmentResourceRegistered(t *testing.T) {
+	p := provider.Provider()
+	if _, ok := p.ResourcesMap["ibm_iam_policy_assignment"]; !ok {
+		t.Fatalf("expected provider to register ibm_iam_policy_assignment")
+	}
+}
+
+func TestIBMIAMPolicyAssignmentLifecycleHandlersWired(t *testing.T) {
+	r := iamPolicyAssignmentResource(t)
+
+	if r.CreateContext == nil {
+		t.Fatalf("ibm_iam_policy_assignment should have a create handler")
+	}
+	if r.ReadContext == nil {
+		t.Fatalf("ibm_iam_policy_assignment should have a read handler")
+	}
+	if r.UpdateContext == nil {
+		t.Fatalf("ibm_iam_policy_assignment should have an update handler")
+	}
+	if r.DeleteContext == nil {
+		t.Fatalf("ibm_iam_policy_assignment should have a delete handler")
+	}
+}
+
+func TestIBMIAMPolicyAssignmentRequiredTopLevelSchema(t *testing.T) {
+	r := iamPolicyAssignmentResource(t)
+
+	cases := []struct {
+		name       string
+		field      string
+		schemaType schema.ValueType
+	}{
+		{name: "version", field: "version", schemaType: schema.TypeString},
+		{name: "target", field: "target", schemaType: schema.TypeMap},
+		{name: "templates", field: "templates", schemaType: schema.TypeList},
+		{name: "options", field: "options", schemaType: schema.TypeList},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s, ok := r.Schema[tc.field]
+			if !ok {
+				t.Fatalf("schema missing %q", tc.field)
+			}
+			if !s.Required {
+				t.Fatalf("%q should be required", tc.field)
+			}
+			if s.Type != tc.schemaType {
+				t.Fatalf("%q type = %v, want %v", tc.field, s.Type, tc.schemaType)
+			}
+		})
+	}
+}
+
+func TestIBMIAMPolicyAssignmentNestedRequiredSchema(t *testing.T) {
+	r := iamPolicyAssignmentResource(t)
+
+	templates, ok := r.Schema["templates"]
+	if !ok {
+		t.Fatalf("schema missing templates")
+	}
+	templateResource, ok := templates.Elem.(*schema.Resource)
+	if !ok {
+		t.Fatalf("templates element should be a nested resource")
+	}
+	for _, field := range []string{"id", "version"} {
+		s, ok := templateResource.Schema[field]
+		if !ok {
+			t.Fatalf("templates element missing %q", field)
+		}
+		if !s.Required || s.Type != schema.TypeString {
+			t.Fatalf("templates.%s should be a required string", field)
+		}
+	}
+
+	options, ok := r.Schema["options"]
+	if !ok {
+		t.Fatalf("schema missing options")
+	}
+	optionsResource, ok := options.Elem.(*schema.Resource)
+	if !ok {
+		t.Fatalf("options element should be a nested resource")
+	}
+	root, ok := optionsResource.Schema["root"]
+	if !ok {
+		t.Fatalf("options element missing root")
+	}
+	if !root.Required || root.Type != schema.TypeList {
+		t.Fatalf("options.root should be a required list block")
+	}
+	rootResource, ok := root.Elem.(*schema.Resource)
+	if !ok {
+		t.Fatalf("options.root element should be a nested resource")
+	}
+	requesterID, ok := rootResource.Schema["requester_id"]
+	if !ok {
+		t.Fatalf("options.root missing requester_id")
+	}
+	if !requesterID.Required || requesterID.Type != schema.TypeString {
+		t.Fatalf("options.root.requester_id should be a required string")
+	}
+}
+
+func TestIBMIAMPolicyAssignmentCardinalityAndDefault(t *testing.T) {
+	r := iamPolicyAssignmentResource(t)
+
+	for _, field := range []string{"templates", "options"} {
+		s, ok := r.Schema[field]
+		if !ok {
+			t.Fatalf("schema missing %q", field)
+		}
+		if s.MinItems != 1 || s.MaxItems != 1 {
+			t.Fatalf("%q should accept exactly one item, got MinItems=%d MaxItems=%d", field, s.MinItems, s.MaxItems)
+		}
+	}
+
+	acceptLanguage, ok := r.Schema["accept_language"]
+	if !ok {
+		t.Fatalf("schema missing accept_language")
+	}
+	if !acceptLanguage.Optional {
+		t.Fatalf("accept_language should be optional")
+	}
+	if got := acceptLanguage.Default; got != "default" {
+		t.Fatalf("accept_language default = %#v, want %q", got, "default")
+	}
+}
+
+func TestIBMIAMPolicyAssignmentComputedMetadataSchema(t *testing.T) {
+	r := iamPolicyAssignmentResource(t)
+
+	for _, field := range []string{
+		"account_id",
+		"href",
+		"created_at",
+		"created_by_id",
+		"last_modified_at",
+		"last_modified_by_id",
+	} {
+		s, ok := r.Schema[field]
+		if !ok {
+			t.Fatalf("schema missing computed metadata field %q", field)
+		}
+		if !s.Computed || s.Type != schema.TypeString {
+			t.Fatalf("%q should be a computed string", field)
+		}
+	}
+
+	resources, ok := r.Schema["resources"]
+	if !ok {
+		t.Fatalf("schema missing resources")
+	}
+	if !resources.Computed || resources.Type != schema.TypeList {
+		t.Fatalf("resources should be a computed list")
+	}
+	resourceElem, ok := resources.Elem.(*schema.Resource)
+	if !ok {
+		t.Fatalf("resources element should be a nested resource")
+	}
+	target, ok := resourceElem.Schema["target"]
+	if !ok {
+		t.Fatalf("resources element missing target")
+	}
+	if target.Type != schema.TypeMap {
+		t.Fatalf("resources.target should be a map")
+	}
+
+	if !schemaTreeHasComputedString(resourceElem, "id") {
+		t.Fatalf("resources should expose a computed policy id somewhere in the nested result schema")
+	}
+	if !schemaTreeHasComputedString(resourceElem, "status") {
+		t.Fatalf("resources should expose a computed status somewhere in the nested result schema")
+	}
+	if computedCollectionCount(resourceElem) < 2 {
+		t.Fatalf("resources should expose nested computed policy result details, got fewer than two computed nested collections")
+	}
+}
+
+func TestIBMIAMPolicyAssignmentAccountIDIsNotHardCoded(t *testing.T) {
+	fileSet := token.NewFileSet()
+	files, err := filepath.Glob("*.go")
+	if err != nil {
+		t.Fatalf("failed to enumerate policy assignment source files: %v", err)
+	}
+	for _, file := range files {
+		parsed, err := parser.ParseFile(fileSet, file, nil, 0)
+		if err != nil {
+			continue
+		}
+		ast.Inspect(parsed, func(n ast.Node) bool {
+			call, ok := n.(*ast.CallExpr)
+			if !ok || !isDataSetCall(call, "account_id") || len(call.Args) < 2 {
+				return true
+			}
+			if _, ok := call.Args[1].(*ast.BasicLit); ok {
+				t.Fatalf("account_id should be populated from assignment data, not from a literal")
+			}
+			return true
+		})
+	}
+}
+
+func schemaTreeHasComputedString(r *schema.Resource, field string) bool {
+	found := false
+	walkSchemaResource(r, func(name string, s *schema.Schema) {
+		if name == field && s.Computed && s.Type == schema.TypeString {
+			found = true
+		}
+	})
+	return found
+}
+
+func computedCollectionCount(r *schema.Resource) int {
+	count := 0
+	walkSchemaResource(r, func(_ string, s *schema.Schema) {
+		if s.Computed && (s.Type == schema.TypeList || s.Type == schema.TypeSet || s.Type == schema.TypeMap) {
+			count++
+		}
+	})
+	return count
+}
+
+func walkSchemaResource(r *schema.Resource, visit func(string, *schema.Schema)) {
+	for name, s := range r.Schema {
+		visit(name, s)
+		if nested, ok := s.Elem.(*schema.Resource); ok {
+			walkSchemaResource(nested, visit)
+		}
+	}
+}
+
+func isDataSetCall(call *ast.CallExpr, field string) bool {
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok || selector.Sel.Name != "Set" || len(call.Args) == 0 {
+		return false
+	}
+	receiver, ok := selector.X.(*ast.Ident)
+	if !ok || receiver.Name != "d" {
+		return false
+	}
+	lit, ok := call.Args[0].(*ast.BasicLit)
+	return ok && lit.Value == `"`+field+`"`
+}
