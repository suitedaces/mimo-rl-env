+import json
+
+import pytest
+
+from robocop import __version__
+from robocop.linter.exceptions import ConfigGeneralError, InvalidReportName
+from robocop.linter.reports import get_reports
+from robocop.linter.rules import Message, Rule, RuleSeverity
+
+
+def make_message(description="some issue", source="file.robot", line=1):
+    rule = Rule(rule_id="0801", name="dummy-rule", msg="dummy", severity=RuleSeverity.WARNING)
+    return Message(
+        rule,
+        description,
+        source=source,
+        node=None,
+        lineno=line,
+        col=1,
+        end_lineno=line,
+        end_col=2,
+    )
+
+
+
+
+
+def test_explicit_reports_are_returned_in_order():
+    reports = get_reports(["json_report", "version"])
+    assert list(reports.keys()) == ["json_report", "version"]
+
+
+def test_each_report_exposes_matching_name():
+    reports = get_reports(["json_report", "version"])
+    for name, report in reports.items():
+        assert report.name == name
+
+
+def test_duplicate_names_collapse_to_single_entry():
+    reports = get_reports(["version", "version"])
+    assert list(reports.keys()) == ["version"]
+
+
+def test_all_enables_default_reports_only():
+    names = set(get_reports(["all"]).keys())
+    assert "version" in names
+    assert "return_status" in names
+    assert "json_report" not in names
+    assert "compare_runs" not in names
+    assert "internal_json_report" not in names
+
+
+def test_all_can_be_combined_with_explicit_non_default_report():
+    names = get_reports(["all", "json_report"])
+    assert "json_report" in names
+    assert "version" in names
+
+
+def test_unknown_report_raises_invalid_report_name():
+    with pytest.raises(InvalidReportName) as err:
+        get_reports(["does_not_exist"])
+    assert "does_not_exist" in str(err.value)
+
+
+def test_none_keeps_only_return_status():
+    reports = get_reports(["None"])
+    assert list(reports.keys()) == ["return_status"]
+
+
+def test_none_disables_external_reports():
+    reports = get_reports(["json_report", "version", "None"])
+    assert list(reports.keys()) == ["return_status"]
+
+
+def test_none_preserves_explicit_internal_json_report():
+    names = set(get_reports(["None", "internal_json_report"]).keys())
+    assert names == {"return_status", "internal_json_report"}
+
+
+
+
+
+def test_version_report_outputs_version():
+    report = get_reports(["version"])["version"]
+    output = report.get_report()
+    assert isinstance(output, str)
+    assert __version__ in output
+
+
+
+
+
+def test_json_report_writes_default_file(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    report = get_reports(["json_report"])["json_report"]
+    first = make_message("issue one", "a.robot", line=1)
+    second = make_message("issue two", "b.robot", line=5)
+    report.add_message(first)
+    report.add_message(second)
+
+    returned = report.get_report()
+
+    output_file = tmp_path / "robocop.json"
+    assert output_file.is_file()
+    assert json.loads(output_file.read_text()) == [first.to_json(), second.to_json()]
+    assert isinstance(returned, str)
+    assert "robocop.json" in returned
+
+
+def test_json_report_empty_when_no_messages(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    report = get_reports(["json_report"])["json_report"]
+    report.get_report()
+    assert json.loads((tmp_path / "robocop.json").read_text()) == []
+
+
+def test_json_report_configurable_destination(tmp_path):
+    report = get_reports(["json_report"])["json_report"]
+    target_dir = tmp_path / "nested" / "reports"
+    report.configure("output_dir", str(target_dir))
+    report.configure("report_filename", "issues.json")
+    report.add_message(make_message())
+
+    returned = report.get_report()
+
+    output_file = target_dir / "issues.json"
+    assert output_file.is_file()
+    assert "issues.json" in returned
+
+
+def test_json_report_rejects_unknown_configuration():
+    report = get_reports(["json_report"])["json_report"]
+    with pytest.raises(ConfigGeneralError):
+        report.configure("not_a_real_param", "value")
