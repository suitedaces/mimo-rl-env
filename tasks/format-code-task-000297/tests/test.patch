+def test_only_default_file_storage_injects_staticfiles_default():
+    check_transformed(
+        """\
+        DEFAULT_FILE_STORAGE = "my_project.storage.MyDefaultStorage"
+        """,
+        """\
+        STORAGES = {
+            "default": {
+                "BACKEND": "my_project.storage.MyDefaultStorage",
+            },
+            "staticfiles": {
+                "BACKEND": "django.contrib.staticfiles.storage.StaticFilesStorage",
+            },
+        }
+        """,
+        settings,
+        filename="settings.py",
+    )
+
+
+def test_only_staticfiles_storage_injects_default_file_default():
+    check_transformed(
+        """\
+        STATICFILES_STORAGE = "my_project.storage.CustomManifestStaticFilesStorage"
+        """,
+        """\
+        STORAGES = {
+            "default": {
+                "BACKEND": "django.core.files.storage.FileSystemStorage",
+            },
+            "staticfiles": {
+                "BACKEND": "my_project.storage.CustomManifestStaticFilesStorage",
+            },
+        }
+        """,
+        settings,
+        filename="settings.py",
+    )
+
+
+def test_both_set_no_injection():
+
+    check_transformed(
+        """\
+        DEFAULT_FILE_STORAGE = "my_project.storage.MyDefault"
+        STATICFILES_STORAGE = "my_project.storage.MyStatic"
+        """,
+        """\
+        STORAGES = {
+            "default": {
+                "BACKEND": "my_project.storage.MyDefault",
+            },
+            "staticfiles": {
+                "BACKEND": "my_project.storage.MyStatic",
+            },
+        }
+        """,
+        settings,
+        filename="settings.py",
+    )
+
+
+def test_only_default_file_storage_with_non_settings_star_injects_staticfiles_default():
+    check_transformed(
+        """\
+        from example import *
+        DEFAULT_FILE_STORAGE = "my_project.storage.MyDefault"
+        """,
+        """\
+        from example import *
+        STORAGES = {
+            "default": {
+                "BACKEND": "my_project.storage.MyDefault",
+            },
+            "staticfiles": {
+                "BACKEND": "django.contrib.staticfiles.storage.StaticFilesStorage",
+            },
+        }
+        """,
+        settings,
+        filename="settings.py",
+    )
+
+
+def test_only_staticfiles_storage_with_non_settings_star_injects_default_default():
+    check_transformed(
+        """\
+        from example import *
+        STATICFILES_STORAGE = "my_project.storage.MyStatic"
+        """,
+        """\
+        from example import *
+        STORAGES = {
+            "default": {
+                "BACKEND": "django.core.files.storage.FileSystemStorage",
+            },
+            "staticfiles": {
+                "BACKEND": "my_project.storage.MyStatic",
+            },
+        }
+        """,
+        settings,
+        filename="settings.py",
+    )
+
+
+def test_only_default_file_storage_with_settings_star_skips_injection():
+
+
+    check_transformed(
+        """\
+        from base_settings import *
+        DEFAULT_FILE_STORAGE = "my_project.storage.MyDefault"
+        """,
+        """\
+        from base_settings import *
+        STORAGES = {
+            **STORAGES,
+            "default": {
+                "BACKEND": "my_project.storage.MyDefault",
+            },
+        }
+        """,
+        settings,
+        filename="settings.py",
+    )
+
+
+def test_only_staticfiles_storage_with_settings_star_skips_injection():
+    check_transformed(
+        """\
+        from base_settings import *
+        STATICFILES_STORAGE = "my_project.storage.MyStatic"
+        """,
+        """\
+        from base_settings import *
+        STORAGES = {
+            **STORAGES,
+            "staticfiles": {
+                "BACKEND": "my_project.storage.MyStatic",
+            },
+        }
+        """,
+        settings,
+        filename="settings.py",
+    )
+
+
+def test_only_staticfiles_storage_extended_settings_star_skips_injection():
+    check_transformed(
+        """\
+        from example.settings.base import *
+        STATICFILES_STORAGE = "my_project.storage.MyStatic"
+        """,
+        """\
+        from example.settings.base import *
+        STORAGES = {
+            **STORAGES,
+            "staticfiles": {
+                "BACKEND": "my_project.storage.MyStatic",
+            },
+        }
+        """,
+        settings,
+        filename="settings.py",
+    )
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+PYTHONPATH=src python -m pytest tests/fixers/test_settings_storages.py -v -k "only_default_file_storage_injects_staticfiles_default or only_staticfiles_storage_injects_default_file_default or both_set_no_injection or only_default_file_storage_with_non_settings_star_injects_staticfiles_default or only_staticfiles_storage_with_non_settings_star_injects_default_default or only_default_file_storage_with_settings_star_skips_injection or only_staticfiles_storage_with_settings_star_skips_injection or only_staticfiles_storage_extended_settings_star_skips_injection"
+rc=$(( rc | $? ))
+exit $rc
