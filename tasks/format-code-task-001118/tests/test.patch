+import 'rxjs/add/operator/takeUntil';
+
+import { SimpleChanges } from '@angular/core';
+import { async, ComponentFixture, TestBed } from '@angular/core/testing';
+import { By } from '@angular/platform-browser';
+
+import {
+  ComponentInjectorComponent,
+  InjectedBoundComponent,
+  TestComponent,
+  TestModule,
+} from '../test/index';
+import { COMPONENT_INJECTOR } from './component-injector';
+import { DynamicDirective } from './dynamic.directive';
+
+describe('DynamicDirective configuration replacement contract', () => {
+  describe('inputs', () => {
+    let fixture: ComponentFixture<TestComponent>;
+    let injectorComp: ComponentInjectorComponent;
+    let injectedComp: any;
+
+    beforeEach(async(() => {
+      TestBed.configureTestingModule({
+        declarations: [TestComponent, ComponentInjectorComponent, DynamicDirective],
+        providers: [{ provide: COMPONENT_INJECTOR, useValue: ComponentInjectorComponent }]
+      });
+
+      TestBed.overrideComponent(TestComponent, {
+        set: { template: '<component-injector [ndcDynamicInputs]="inputs"></component-injector>' }
+      });
+      fixture = TestBed.createComponent(TestComponent);
+      injectorComp = fixture.debugElement.query(By.directive(ComponentInjectorComponent)).componentInstance;
+      injectedComp = injectorComp.component;
+    }));
+
+    it('keeps falsy values and does not notify for an equivalent replacement object', () => {
+      fixture.componentInstance['inputs'] = { zero: 0, disabled: false, empty: '' };
+      fixture.detectChanges();
+
+      expect(injectedComp.zero).toBe(0);
+      expect(injectedComp.disabled).toBe(false);
+      expect(injectedComp.empty).toBe('');
+      expect(injectedComp.ngOnChanges).toHaveBeenCalledTimes(1);
+
+      fixture.componentInstance['inputs'] = { zero: 0, disabled: false, empty: '' };
+      expect(() => fixture.detectChanges()).not.toThrow();
+      expect(injectedComp.ngOnChanges).toHaveBeenCalledTimes(1);
+    });
+
+    it('clears removed keys from the component instance', () => {
+      fixture.componentInstance['inputs'] = { retained: 'one', removed: 'old' };
+      fixture.detectChanges();
+
+      fixture.componentInstance['inputs'] = { retained: 'two' };
+      fixture.detectChanges();
+
+      expect(injectedComp.retained).toBe('two');
+      expect(injectedComp.removed).toBeUndefined();
+    });
+
+    it('reports previous and current values when an input is removed', () => {
+      fixture.componentInstance['inputs'] = { retained: 'one', removed: 'old' };
+      fixture.detectChanges();
+      injectedComp.ngOnChanges.calls.reset();
+
+      fixture.componentInstance['inputs'] = { retained: 'two' };
+      fixture.detectChanges();
+
+      expect(injectedComp.ngOnChanges).toHaveBeenCalledTimes(1);
+      const changes: SimpleChanges = injectedComp.ngOnChanges.calls.mostRecent().args[0];
+      expect(changes.retained.previousValue).toBe('one');
+      expect(changes.retained.currentValue).toBe('two');
+      expect(changes.removed.previousValue).toBe('old');
+      expect(changes.removed.currentValue).toBeUndefined();
+      expect(changes.removed.isFirstChange()).toBe(false);
+    });
+  });
+
+  describe('outputs', () => {
+    let fixture: ComponentFixture<TestComponent>;
+    let injectedComp: InjectedBoundComponent;
+    let firstHandler: jasmine.Spy;
+    let secondHandler: jasmine.Spy;
+
+    beforeEach(async(() => {
+      TestBed.configureTestingModule({
+        imports: [TestModule],
+        declarations: [DynamicDirective, TestComponent],
+        providers: [{ provide: COMPONENT_INJECTOR, useValue: ComponentInjectorComponent }],
+      });
+      TestBed.overrideComponent(TestComponent, {
+        set: {
+          template: '<ng-container [ngComponentOutlet]="comp" [ndcDynamicOutputs]="outputs"></ng-container>'
+        }
+      });
+      fixture = TestBed.createComponent(TestComponent);
+      fixture.componentInstance['comp'] = InjectedBoundComponent;
+      fixture.componentInstance['outputs'] = null;
+      fixture.detectChanges();
+      injectedComp = fixture.debugElement.query(By.directive(InjectedBoundComponent)).componentInstance;
+      firstHandler = jasmine.createSpy('firstHandler');
+      secondHandler = jasmine.createSpy('secondHandler');
+    }));
+
+    it('disconnects the old handler when the output map is replaced', () => {
+      fixture.componentInstance['outputs'] = { outerEvt: firstHandler };
+      fixture.detectChanges();
+      injectedComp.innerEvt.emit('first');
+
+      fixture.componentInstance['outputs'] = { outerEvt: secondHandler };
+      fixture.detectChanges();
+      injectedComp.innerEvt.emit('second');
+
+      expect(firstHandler).toHaveBeenCalledTimes(1);
+      expect(firstHandler).toHaveBeenCalledWith('first');
+      expect(secondHandler).toHaveBeenCalledTimes(1);
+      expect(secondHandler).toHaveBeenCalledWith('second');
+    });
+
+    it('disconnects handlers when outputs are cleared', () => {
+      fixture.componentInstance['outputs'] = { outerEvt: firstHandler };
+      fixture.detectChanges();
+      injectedComp.innerEvt.emit('before-clear');
+
+      fixture.componentInstance['outputs'] = null;
+      fixture.detectChanges();
+      injectedComp.innerEvt.emit('after-clear');
+
+      expect(firstHandler).toHaveBeenCalledTimes(1);
+      expect(firstHandler).toHaveBeenCalledWith('before-clear');
+    });
+  });
+});
