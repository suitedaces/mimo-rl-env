+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+REPO=/workspace/repo
+FIXTURES="$REPO/usercase-test-coderl/fixtures"
+NODE=${NODE:-node}
+BIN="$REPO/src/cli/index.js"
+
+
+
+[ -d "$REPO/node_modules" ] || fail "missing preinstalled node_modules"
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || fail "cd tmp"
+
+copy_fixture() {
+  cp "$FIXTURES/resume.json" resume.json || fail "copy resume fixture"
+  cp -R "$FIXTURES/tiny-theme" theme || fail "copy theme fixture"
+}
+
+assert_file_list() {
+  local dir=$1
+  local expected=$2
+  local actual
+  if [ -d "$dir" ]; then
+    actual=$(find "$dir" -maxdepth 1 -type f -printf '%P\n' | sort)
+  else
+    actual=""
+  fi
+  [ "$actual" = "$expected" ] || fail "$dir files: [$actual]"
+}
+
+assert_file_nonempty() {
+  local file=$1
+  [ -f "$file" ] || fail "$file missing"
+  [ -s "$file" ] || fail "$file empty"
+}
+
+assert_file_contains() {
+  local file=$1
+  local expected=$2
+  assert_file_nonempty "$file"
+  grep -Fq "$expected" "$file" || fail "$file missing [$expected]"
+}
+
+assert_log_mentions_target() {
+  local log=$1
+  local target=$2
+  grep -Fq "$target" "$log" || fail "$log missing target $target"
+}
+
+assert_no_invalid_all() {
+  local label=$1
+  shift
+  local file
+  for file in "$@"; do
+    if [ -f "$file" ] && grep -Fq "doesn't support the ALL format" "$file"; then
+      fail "$label reported .all as invalid"
+    fi
+  done
+}
+
+assert_png_target_or_offline_stub() {
+  local target=$1
+  if [ -f "$target" ]; then
+    [ -s "$target" ] || fail "$target empty"
+  else
+
+
+
+    assert_file_nonempty "$target.html"
+  fi
+}
+
+assert_empty_stderr() {
+  [ ! -s err ] || fail "$1 stderr: $(cat err)"
+}
+
+
+
+
+mkdir f1 && cd f1 || fail "mkdir f1"
+copy_fixture
+"$NODE" "$BIN" build resume.json TO custom/all-call.all -t theme --pdf none >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+
+
+assert_no_invalid_all F1 out err
+assert_log_mentions_target out "custom/all-call.html"
+assert_log_mentions_target out "custom/all-call.txt"
+assert_log_mentions_target out "custom/all-call.json"
+assert_log_mentions_target out "custom/all-call.yml"
+assert_log_mentions_target out "custom/all-call.png"
+[ ! -e custom/all-call.all ] || fail "F1 left .all output file"
+
+
+assert_file_contains custom/all-call.html "Ada Lovelace"
+assert_file_contains custom/all-call.txt "ada@example.com"
+assert_file_contains custom/all-call.json "Ada Lovelace"
+assert_file_contains custom/all-call.yml "Ada Lovelace"
+assert_png_target_or_offline_stub custom/all-call.png
+cd "$TMP" || fail "cd tmp after f1"
+
+
+
+
+mkdir f2 && cd f2 || fail "mkdir f2"
+copy_fixture
+"$NODE" "$BIN" build resume.json -t theme --pdf none >stdout 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+
+
+assert_no_invalid_all F2 stdout err
+assert_log_mentions_target stdout "out/resume.html"
+assert_log_mentions_target stdout "out/resume.txt"
+assert_log_mentions_target stdout "out/resume.json"
+assert_log_mentions_target stdout "out/resume.yml"
+assert_log_mentions_target stdout "out/resume.png"
+[ ! -e out/resume.all ] || fail "F2 left default .all output file"
+assert_file_contains out/resume.html "Ada Lovelace"
+assert_file_contains out/resume.txt "ada@example.com"
+assert_file_contains out/resume.json "Ada Lovelace"
+assert_file_contains out/resume.yml "Ada Lovelace"
+assert_png_target_or_offline_stub out/resume.png
+cd "$TMP" || fail "cd tmp after f2"
+
+
+
+
+mkdir f3 && cd f3 || fail "mkdir f3"
+cp "$FIXTURES/resume.json" resume.json || fail "copy resume fixture f3"
+"$NODE" "$BIN" build resume.json TO out/resume.all --pdf none >outlog 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+
+
+assert_no_invalid_all F3 outlog err
+assert_log_mentions_target outlog "out/resume.txt"
+assert_log_mentions_target outlog "out/resume.md"
+assert_log_mentions_target outlog "out/resume.doc"
+assert_log_mentions_target outlog "out/resume.html"
+assert_log_mentions_target outlog "out/resume.pdf"
+assert_log_mentions_target outlog "out/resume.json"
+assert_log_mentions_target outlog "out/resume.yml"
+assert_log_mentions_target outlog "out/resume.png"
+assert_file_contains out/resume.txt "Ada"
+assert_file_contains out/resume.md "Ada"
+assert_file_nonempty out/resume.doc
+assert_file_contains out/resume.html "Ada"
+assert_file_contains out/resume.json "Ada"
+assert_file_contains out/resume.yml "Ada"
+assert_png_target_or_offline_stub out/resume.png
+[ ! -e out/resume.all ] || fail "F3 left .all output file"
+cd "$TMP" || fail "cd tmp after f3"
+
+
+
+
+mkdir f4 && cd f4 || fail "mkdir f4"
+copy_fixture
+"$NODE" "$BIN" build resume.json TO custom/cv.nope -t theme --pdf none >out 2>err; ec=$?
+
+
+[ "$ec" -ne 0 ] || fail "F4 accepted unsupported .nope format"
+grep -Eiq "nope|unsupported|support" out err \
+  || fail "F4 did not report unsupported .nope format"
+[ ! -d custom ] || fail "F4 should not create output directory"
+cd "$TMP" || fail "cd tmp after f4"
+
+
+
+
+mkdir f5 && cd f5 || fail "mkdir f5"
+"$NODE" "$BIN" help build >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+assert_empty_stderr F5
+
+
+grep -Eiq "\.all.*all supported formats|all supported formats.*\.all" out \
+  || fail "F5 missing .all all-formats help option"
+cd "$TMP" || fail "cd tmp after f5"
+
+
+
+
+mkdir f6 && cd f6 || fail "mkdir f6"
+"$NODE" "$BIN" help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+assert_empty_stderr F6
+
+grep -Fq "      hackmyresume build rez.json to out/rez.all" out \
+  || fail "F6 missing all-formats example"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+
+
+if [ ! -f node_modules/simple-html-tokenizer/dist/simple-html-tokenizer.js ]; then
+  mkdir -p node_modules/simple-html-tokenizer/dist
+  cat > node_modules/simple-html-tokenizer/dist/simple-html-tokenizer.js <<'EOF'
+'use strict';
+
+function attrs(raw) {
+  var out = [];
+  raw.replace(/([A-Za-z_:][-A-Za-z0-9_:.]*)\s*=\s*(['"])(.*?)\2/g, function(_, k, q, v) {
+    out.push([k, v]);
+  });
+  return out;
+}
+
+exports.tokenize = function tokenize(html) {
+  var tokens = [];
+  var re = /<\/?[^>]+>/g;
+  var last = 0;
+  var m;
+  while ((m = re.exec(html)) !== null) {
+    if (m.index > last) {
+      tokens.push({ type: 'Chars', chars: html.slice(last, m.index) });
+    }
+    var tag = m[0];
+    var end = /^<\//.test(tag);
+    var name = (tag.match(/^<\/?\s*([A-Za-z0-9:_-]+)/) || [null, ''])[1].toLowerCase();
+    if (name) {
+      tokens.push(end
+        ? { type: 'EndTag', tagName: name }
+        : { type: 'StartTag', tagName: name, attributes: attrs(tag) });
+    }
+    last = re.lastIndex;
+  }
+  if (last < html.length) {
+    tokens.push({ type: 'Chars', chars: html.slice(last) });
+  }
+  return tokens;
+};
+EOF
+fi
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
