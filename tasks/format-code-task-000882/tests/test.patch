--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo/envoy-curses
+
+if [ ! -d node_modules ]; then
+  echo "envoy-curses/node_modules is missing; dependencies must be preinstalled for offline test execution" >&2
+  exit 1
+fi
+
+if [ ! -x ./node_modules/.bin/jest ]; then
+  echo "envoy-curses local Jest binary is missing; dependencies must be preinstalled for offline test execution" >&2
+  exit 1
+fi
+
+export npm_config_audit=false
+export npm_config_fund=false
+export npm_config_offline=true
+export NO_UPDATE_NOTIFIER=1
+
+exec ./node_modules/.bin/jest --rootDir /workspace/repo /workspace/repo/usercase-test-coderl/stats_stateful.test.js --runInBand
