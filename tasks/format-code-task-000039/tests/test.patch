+package handlers_test
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAOPPFrontendApprovalSurface(t *testing.T) {
+	apiSource, err := os.ReadFile(filepath.Join("..", "..", "frontends", "web", "src", "api", "aopp.ts"))
+	require.NoError(t, err)
+	componentSource, err := os.ReadFile(filepath.Join("..", "..", "frontends", "web", "src", "components", "aopp", "aopp.tsx"))
+	require.NoError(t, err)
+
+	api := string(apiSource)
+	component := string(componentSource)
+	require.Contains(t, api, "'user-approval'")
+	require.Contains(t, api, "approve = (): Promise<null>")
+	require.Contains(t, api, "apiPost('aopp/approve')")
+
+	approvalIndex := strings.Index(component, "case 'user-approval':")
+	require.NotEqual(t, -1, approvalIndex)
+	approvalCase := component[approvalIndex:]
+	if nextCase := strings.Index(approvalCase[len("case 'user-approval':"):], "case '"); nextCase >= 0 {
+		approvalCase = approvalCase[:len("case 'user-approval':")+nextCase]
+	}
+	approvalSource := approvalCase
+	if !strings.Contains(approvalSource, "aoppAPI.approve") && !strings.Contains(approvalSource, "aoppAPI.cancel") {
+		if methodName := calledComponentMethod(approvalCase); methodName != "" {
+			approvalSource += componentMethodSource(component, methodName)
+		}
+	}
+	require.Contains(t, approvalSource, "callbackHost")
+	require.Contains(t, approvalSource, "aoppAPI.cancel")
+	require.Contains(t, approvalSource, "aoppAPI.approve")
+}
+
+func calledComponentMethod(source string) string {
+	const receiver = "this."
+	idx := strings.Index(source, receiver)
+	if idx < 0 {
+		return ""
+	}
+	rest := source[idx+len(receiver):]
+	end := 0
+	for end < len(rest) {
+		c := rest[end]
+		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' {
+			end++
+			continue
+		}
+		break
+	}
+	return rest[:end]
+}
+
+func componentMethodSource(component, methodName string) string {
+	idx := strings.Index(component, methodName)
+	if idx < 0 {
+		return ""
+	}
+	end := idx + 800
+	if end > len(component) {
+		end = len(component)
+	}
+	return component[idx:end]
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,17 @@
+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 -run 'TestAOPPFailures/(wrong_version|missing_callback|invalid_callback|missing_msg|unsupported_asset)$' ./backend/
+    ;;
+  new)
+    go test -v -count=1 -run 'TestAOPPSuccess/(user-approval-before-account-selection|approve-continues-flow|approve-noops-outside-approval|approval-keystore-disconnect|cancel-from-approval-stops-before-account-selection)$|TestAOPPFailures/no_accounts$' ./backend/
+    go test -v -count=1 -run 'TestAOPP(ApproveRouteCallsBackend|FrontendApprovalSurface)$' ./backend/handlers/
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
