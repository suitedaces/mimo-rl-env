+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+build_dir=/tmp/libfyaml-usercase-test-coderl-build
+test_bin=/tmp/libfyaml-usercase-test-coderl-generic-emit-helpers
+
+cmake -S /workspace/repo -B "$build_dir" \
+  -DCMAKE_BUILD_TYPE=Debug \
+  -DBUILD_SHARED_LIBS=ON \
+  -DBUILD_TESTING=OFF \
+  -DENABLE_NETWORK=OFF \
+  -DENABLE_REFLECTION=OFF \
+  -DENABLE_LIBCLANG=OFF \
+  -DENABLE_PYTHON_BINDINGS=OFF >/dev/null
+cmake --build "$build_dir" --target fyaml -j"$(nproc)" >/dev/null
+
+cc -std=gnu11 \
+  -Wall -Wextra -Werror \
+  -I/workspace/repo/include \
+  -I"$build_dir/include" \
+  /workspace/repo/usercase-test-coderl/generic_emit_helpers_test.c \
+  -L"$build_dir" -lfyaml \
+  -Wl,-rpath,"$build_dir" \
+  -o "$test_bin"
+
+exec "$test_bin"
