diff --git a/usercase-test-coderl/generic_emit_helpers_test.c b/usercase-test-coderl/generic_emit_helpers_test.c
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/generic_emit_helpers_test.c
@@ -0,0 +1,427 @@
+
+
+
+
+
+
+
+
+
+
+
+
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <libfyaml/libfyaml-generic.h>
+
+typedef fy_generic (*value_fn)(struct fy_generic_builder *gb);
+typedef int (*emit_fn)(fy_generic v);
+
+struct captured_emit {
+	int rc;
+	char out[2048];
+};
+
+static int failures;
+
+static void fail(const char *test_name, const char *detail)
+{
+	fprintf(stderr, "FAIL %s: %s\n", test_name, detail);
+	failures++;
+}
+
+static void assert_int_eq(const char *test_name, const char *label, int actual, int expected)
+{
+	char buf[160];
+
+	if (actual == expected)
+		return;
+
+	snprintf(buf, sizeof(buf), "%s expected %d, got %d", label, expected, actual);
+	fail(test_name, buf);
+}
+
+static void assert_str_eq(const char *test_name, const char *label,
+			  const char *actual, const char *expected)
+{
+	char buf[512];
+
+	if (!strcmp(actual, expected))
+		return;
+
+	snprintf(buf, sizeof(buf), "%s expected <%s>, got <%s>", label, expected, actual);
+	fail(test_name, buf);
+}
+
+static void expected_compact_output(const char *test_name, fy_generic v,
+				    char *expected, size_t expected_size)
+{
+	struct fy_generic_builder *gb;
+	fy_generic emitted;
+	const char *text;
+
+	expected[0] = '\0';
+
+	gb = fy_generic_builder_create(NULL);
+	if (!gb) {
+		fail(test_name, "could not create builder for expected output");
+		return;
+	}
+
+
+
+
+
+
+	emitted = fy_gb_emit(gb, v,
+			     FYOPEF_DISABLE_DIRECTORY | FYOPEF_STYLE_ONELINE |
+			     FYOPEF_WIDTH_INF | FYOPEF_OUTPUT_TYPE_STRING,
+			     NULL);
+	text = fy_generic_get_string_alloca(emitted);
+	if (!text || !*text) {
+		fail(test_name, "could not compute expected generic encoder output");
+		fy_generic_builder_destroy(gb);
+		return;
+	}
+
+	snprintf(expected, expected_size, "%s", text);
+	fy_generic_builder_destroy(gb);
+}
+
+static struct captured_emit capture_emit(emit_fn fn, fy_generic v)
+{
+	struct captured_emit result;
+	int pipefd[2];
+	int saved_stdout;
+	ssize_t n;
+
+	memset(&result, 0, sizeof(result));
+
+	if (fflush(stdout) != 0 || pipe(pipefd) != 0) {
+		result.rc = -999;
+		return result;
+	}
+
+	saved_stdout = dup(STDOUT_FILENO);
+	if (saved_stdout < 0) {
+		close(pipefd[0]);
+		close(pipefd[1]);
+		result.rc = -999;
+		return result;
+	}
+
+	if (dup2(pipefd[1], STDOUT_FILENO) < 0) {
+		close(saved_stdout);
+		close(pipefd[0]);
+		close(pipefd[1]);
+		result.rc = -999;
+		return result;
+	}
+
+	close(pipefd[1]);
+	result.rc = fn(v);
+	fflush(stdout);
+
+	dup2(saved_stdout, STDOUT_FILENO);
+	close(saved_stdout);
+
+	n = read(pipefd[0], result.out, sizeof(result.out) - 1);
+	if (n < 0)
+		n = 0;
+	result.out[n] = '\0';
+	close(pipefd[0]);
+
+	return result;
+}
+
+static int emit_default_adapter(fy_generic v)
+{
+	return fy_generic_emit_default(v);
+}
+
+static fy_generic value_scalar_hello(struct fy_generic_builder *gb)
+{
+	(void)gb;
+	return fy_string("hello");
+}
+
+static fy_generic value_sequence(struct fy_generic_builder *gb)
+{
+	return fy_gb_sequence(gb, "alpha", 2, fy_bool(false));
+}
+
+static fy_generic value_mapping(struct fy_generic_builder *gb)
+{
+	return fy_gb_mapping(gb, "a", 1, "b", fy_bool(true));
+}
+
+static fy_generic value_nested_mapping(struct fy_generic_builder *gb)
+{
+	return fy_gb_mapping(gb,
+			     "name", "svc",
+			     "ports", fy_gb_sequence(gb, 80, 443),
+			     "meta", fy_gb_mapping(gb,
+						    "enabled", fy_bool(true),
+						    "ratio", 1.5));
+}
+
+static fy_generic value_empty_sequence(struct fy_generic_builder *gb)
+{
+	(void)gb;
+	return fy_sequence();
+}
+
+static void assert_emit_case(const char *test_name, emit_fn fn, fy_generic v,
+			     const char *expected)
+{
+	struct captured_emit got = capture_emit(fn, v);
+
+	assert_int_eq(test_name, "return code", got.rc, 0);
+	assert_str_eq(test_name, "stdout", got.out, expected);
+}
+
+static void assert_emit_matches_encoder(const char *test_name, emit_fn fn, fy_generic v)
+{
+	char expected[2048];
+
+	expected_compact_output(test_name, v, expected, sizeof(expected));
+
+	assert_emit_case(test_name, fn, v, expected);
+}
+
+static void test_compact_scalar(void)
+{
+
+
+
+
+	assert_emit_matches_encoder("test_compact_scalar", fy_generic_emit_compact,
+				    value_scalar_hello(NULL));
+}
+
+static void test_compact_sequence(void)
+{
+
+
+
+
+	struct fy_generic_builder *gb = fy_generic_builder_create(NULL);
+
+	assert_emit_matches_encoder("test_compact_sequence", fy_generic_emit_compact,
+				    value_sequence(gb));
+	fy_generic_builder_destroy(gb);
+}
+
+static void test_compact_mapping(void)
+{
+
+
+
+
+	struct fy_generic_builder *gb = fy_generic_builder_create(NULL);
+
+	assert_emit_matches_encoder("test_compact_mapping", fy_generic_emit_compact,
+				    value_mapping(gb));
+	fy_generic_builder_destroy(gb);
+}
+
+static void test_compact_nested_mapping(void)
+{
+
+
+
+
+	struct fy_generic_builder *gb = fy_generic_builder_create(NULL);
+
+	assert_emit_matches_encoder("test_compact_nested_mapping", fy_generic_emit_compact,
+				    value_nested_mapping(gb));
+	fy_generic_builder_destroy(gb);
+}
+
+static void test_compact_empty_sequence(void)
+{
+
+
+
+
+	assert_emit_matches_encoder("test_compact_empty_sequence", fy_generic_emit_compact,
+				    value_empty_sequence(NULL));
+}
+
+static void test_default_matches_compact_for_same_value(void)
+{
+
+
+
+
+	struct fy_generic_builder *gb = fy_generic_builder_create(NULL);
+	fy_generic v = value_mapping(gb);
+
+	assert_emit_matches_encoder("test_default_matches_compact_for_same_value compact",
+				    fy_generic_emit_compact, v);
+	assert_emit_matches_encoder("test_default_matches_compact_for_same_value default",
+				    emit_default_adapter, v);
+	fy_generic_builder_destroy(gb);
+}
+
+static void test_invalid_value_returns_minus_one(void)
+{
+
+
+
+
+	struct captured_emit compact = capture_emit(fy_generic_emit_compact, fy_invalid);
+	struct captured_emit def = capture_emit(emit_default_adapter, fy_invalid);
+
+	assert_int_eq("test_invalid_value_returns_minus_one", "compact return code",
+		      compact.rc, -1);
+	assert_str_eq("test_invalid_value_returns_minus_one", "compact stdout",
+		      compact.out, "");
+	assert_int_eq("test_invalid_value_returns_minus_one", "default return code",
+		      def.rc, -1);
+	assert_str_eq("test_invalid_value_returns_minus_one", "default stdout",
+		      def.out, "");
+}
+
+static void test_referential_transparency_same_value_twice(void)
+{
+	struct fy_generic_builder *gb = fy_generic_builder_create(NULL);
+	fy_generic v = value_nested_mapping(gb);
+	struct captured_emit first = capture_emit(fy_generic_emit_compact, v);
+	struct captured_emit second = capture_emit(fy_generic_emit_compact, v);
+	char expected[2048];
+
+	expected_compact_output("test_referential_transparency_same_value_twice", v,
+				expected, sizeof(expected));
+
+	assert_int_eq("test_referential_transparency_same_value_twice", "first return",
+		      first.rc, 0);
+	assert_int_eq("test_referential_transparency_same_value_twice", "second return",
+		      second.rc, 0);
+	assert_str_eq("test_referential_transparency_same_value_twice", "first stdout",
+		      first.out, expected);
+	assert_str_eq("test_referential_transparency_same_value_twice", "second stdout",
+		      second.out, expected);
+	fy_generic_builder_destroy(gb);
+}
+
+static void test_no_mutation_of_input_value(void)
+{
+	struct fy_generic_builder *gb = fy_generic_builder_create(NULL);
+	fy_generic v = value_nested_mapping(gb);
+
+	assert_emit_matches_encoder("test_no_mutation_of_input_value before",
+				    fy_generic_emit_compact, v);
+	assert_emit_matches_encoder("test_no_mutation_of_input_value after",
+				    fy_generic_emit_compact, v);
+	fy_generic_builder_destroy(gb);
+}
+
+static void test_no_global_state_with_interleaved_noise(void)
+{
+	struct fy_generic_builder *gb = fy_generic_builder_create(NULL);
+	fy_generic target = value_mapping(gb);
+
+	assert_emit_matches_encoder("test_no_global_state_with_interleaved_noise target first",
+				    fy_generic_emit_compact, target);
+	assert_emit_matches_encoder("test_no_global_state_with_interleaved_noise scalar noise",
+				    fy_generic_emit_compact, value_scalar_hello(gb));
+	assert_emit_matches_encoder("test_no_global_state_with_interleaved_noise sequence noise",
+				    fy_generic_emit_compact, value_sequence(gb));
+	assert_emit_matches_encoder("test_no_global_state_with_interleaved_noise target second",
+				    fy_generic_emit_compact, target);
+	fy_generic_builder_destroy(gb);
+}
+
+static int count_directory_entries(const char *path)
+{
+	DIR *dir;
+	struct dirent *de;
+	int count = 0;
+
+	dir = opendir(path);
+	if (!dir)
+		return -1;
+
+	while ((de = readdir(dir)) != NULL) {
+		if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, ".."))
+			continue;
+		count++;
+	}
+
+	closedir(dir);
+	return count;
+}
+
+static void test_no_undeclared_cwd_file_side_effects(void)
+{
+	char template[] = "/tmp/libfyaml-usercase-XXXXXX";
+	char oldcwd[4096];
+	char *tmpdir;
+	int before;
+	int after;
+
+	tmpdir = mkdtemp(template);
+	if (!tmpdir) {
+		fail("test_no_undeclared_cwd_file_side_effects", "mkdtemp failed");
+		return;
+	}
+
+	if (!getcwd(oldcwd, sizeof(oldcwd))) {
+		fail("test_no_undeclared_cwd_file_side_effects", "getcwd failed");
+		rmdir(tmpdir);
+		return;
+	}
+
+	if (chdir(tmpdir) != 0) {
+		fail("test_no_undeclared_cwd_file_side_effects", "chdir tmpdir failed");
+		rmdir(tmpdir);
+		return;
+	}
+
+	before = count_directory_entries(".");
+	assert_emit_matches_encoder("test_no_undeclared_cwd_file_side_effects emit",
+				    fy_generic_emit_compact, value_scalar_hello(NULL));
+	after = count_directory_entries(".");
+
+	assert_int_eq("test_no_undeclared_cwd_file_side_effects", "cwd entries before",
+		      before, 0);
+	assert_int_eq("test_no_undeclared_cwd_file_side_effects", "cwd entries after",
+		      after, 0);
+
+	chdir(oldcwd);
+	rmdir(tmpdir);
+}
+
+int main(void)
+{
+	test_compact_scalar();
+	test_compact_sequence();
+	test_compact_mapping();
+	test_compact_nested_mapping();
+	test_compact_empty_sequence();
+	test_default_matches_compact_for_same_value();
+	test_invalid_value_returns_minus_one();
+	test_referential_transparency_same_value_twice();
+	test_no_mutation_of_input_value();
+	test_no_global_state_with_interleaved_noise();
+	test_no_undeclared_cwd_file_side_effects();
+
+	if (failures) {
+		fprintf(stderr, "%d test failure(s)\n", failures);
+		return 1;
+	}
+
+	printf("generic emit helper acceptance tests passed\n");
+	return 0;
+}
