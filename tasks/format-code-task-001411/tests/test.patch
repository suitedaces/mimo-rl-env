diff --git a/src/js/components/List/__tests__/List-test.tsx b/src/js/components/List/__tests__/List-test.tsx
index 2e66fabf1..46f395e23 100644
--- a/src/js/components/List/__tests__/List-test.tsx
+++ b/src/js/components/List/__tests__/List-test.tsx
@@ -1199,3 +1199,84 @@ describe('List pinned', () => {
     expect(iconStyle.fill).toBe('pink');
   });
 });
+
+describe('List onOrder a11y role', () => {
+  test('ul should have role="list" when onOrder is provided', () => {
+    const { container } = render(
+      <Grommet>
+        <List
+          aria-label="ordered-list"
+          data={[{ a: 'alpha' }, { a: 'beta' }]}
+          primaryKey="a"
+          onOrder={() => {}}
+        />
+      </Grommet>,
+    );
+    const ul = container.querySelector('ul');
+    expect(ul).toHaveAttribute('role', 'list');
+  });
+
+  test('ul should have role="listbox" when onClickItem is provided', () => {
+    const { container } = render(
+      <Grommet>
+        <List
+          aria-label="clickable-list"
+          data={[{ a: 'alpha' }, { a: 'beta' }]}
+          onClickItem={() => {}}
+        />
+      </Grommet>,
+    );
+    const ul = container.querySelector('ul');
+    expect(ul).toHaveAttribute('role', 'listbox');
+  });
+
+  test('ul should have role="list" when neither onOrder nor onClickItem is provided', () => {
+    const { container } = render(
+      <Grommet>
+        <List
+          aria-label="default-list"
+          data={[{ a: 'alpha' }, { a: 'beta' }]}
+        />
+      </Grommet>,
+    );
+    const ul = container.querySelector('ul');
+    expect(ul).toHaveAttribute('role', 'list');
+  });
+
+  test('List with onOrder should have no accessibility violations', async () => {
+    const { container } = render(
+      <Grommet>
+        <List
+          aria-label="ordered-list"
+          data={[{ a: 'alpha' }, { a: 'beta' }]}
+          primaryKey="a"
+          onOrder={() => {}}
+        />
+      </Grommet>,
+    );
+    const results = await axe(container);
+    expect(results).toHaveNoViolations();
+  });
+
+  test('aria-activedescendant is set on ul for onOrder when navigating with ArrowDown', () => {
+    const { container, getByText } = render(
+      <Grommet>
+        <List
+          aria-label="ordered-list"
+          data={[{ a: 'alpha' }, { a: 'beta' }]}
+          primaryKey="a"
+          onOrder={() => {}}
+        />
+      </Grommet>,
+    );
+    fireEvent.click(getByText('alpha'));
+    fireEvent.mouseOver(getByText('alpha'));
+    fireEvent.keyDown(getByText('alpha'), {
+      key: 'ArrowDown',
+      keyCode: 40,
+      which: 40,
+    });
+    const ul = container.querySelector('ul');
+    expect(ul).toHaveAttribute('aria-activedescendant', 'alphaMoveDown');
+  });
+});
