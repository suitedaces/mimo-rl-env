--- a/src/Result/tryCatch.spec.js
+++ b/src/Result/tryCatch.spec.js
@@ -1,9 +1,12 @@
 const test = require('tape')
+const fs = require('fs')
+const path = require('path')
 const helpers = require('../test/helpers')
 
 const bindFunc = helpers.bindFunc
 
 const Result = require('.')
+const curry = require('../core/curry')
 const isFunction = require('../core/isFunction')
 const isSameType = require('../core/isSameType')
 const unit = require('../core/_unit')
@@ -59,5 +62,131 @@ test('tryCatch functionality', t => {
   t.equals(good, 'Ok', 'returns an Ok when no error')
   t.equals(bad.message, msg, 'returns an Err with error on error')
 
+  function collectArgs(a, b, c, d) {
+    return [ a, b, c, d ]
+  }
+
+  function total(a, b, c) {
+    return a + b + c
+  }
+
+  const collected =
+    tryCatch(collectArgs)('north', 'south', 'east', 'west')
+      .either(identity, identity)
+
+  const summed =
+    tryCatch(total)(6, 11, 17)
+      .either(identity, identity)
+
+  t.deepEquals(
+    collected,
+    [ 'north', 'south', 'east', 'west' ],
+    'passes every supplied value to the wrapped function'
+  )
+
+  t.equals(
+    summed,
+    34,
+    'does not specialize multi-argument handling to one example shape'
+  )
+
+  function sumThree(a, b, c) {
+    sumThree.calls += 1
+    return a + b + c
+  }
+  sumThree.calls = 0
+
+  const curriedTotal = curry(tryCatch(sumThree))
+  const waitingForSecond = curriedTotal(3)
+
+  t.equals(sumThree.calls, 0, 'does not execute a curried wrapper before enough input')
+  t.equals(typeof waitingForSecond, 'function', 'returns a function while curried input is incomplete')
+
+  const waitingForThird = waitingForSecond(5)
+
+  t.equals(sumThree.calls, 0, 'continues waiting until the original arity is satisfied')
+  t.equals(typeof waitingForThird, 'function', 'keeps returning functions until enough input is supplied')
+
+  const curriedResult =
+    waitingForThird(8)
+      .either(identity, identity)
+
+  t.equals(sumThree.calls, 1, 'executes once enough curried input has been supplied')
+  t.equals(curriedResult, 16, 'returns the wrapped result after curried invocation')
+
+  function describe(prefix, suffix) {
+    return prefix + this.separator + this.value + suffix
+  }
+
+  const calledWithContext =
+    tryCatch(describe.bind({ separator: ':', value: 'ctx-a' }), '<', '>')
+      .either(identity, identity)
+
+  const receiver = {
+    separator: '/',
+    value: 'ctx-b',
+    describe: function(prefix, suffix) {
+      return tryCatch(describe.bind(this), prefix, suffix)
+    }
+  }
+
+  const calledAsMethod =
+    receiver.describe('[', ']')
+      .either(identity, identity)
+
+  t.equals(calledWithContext, '<:ctx-a>', 'passes call-time context through to the wrapped function')
+  t.equals(calledAsMethod, '[/ctx-b]', 'preserves context when the wrapped function is used as an object method')
+
+  t.end()
+})
+
+test('tryCatch docs describe variadic functions', t => {
+  const helpersPath = path.join(__dirname, '../../docs/src/pages/docs/functions/helpers.md')
+  const indexPath = path.join(__dirname, '../../docs/src/pages/docs/functions/index.md')
+
+  const helpersDoc = fs.readFileSync(helpersPath, 'utf8')
+  const indexDoc = fs.readFileSync(indexPath, 'utf8')
+
+  const helperSignatureMatch =
+    helpersDoc.match(/`crocks\/Result\/tryCatch`[\s\S]*?```haskell\s*([\s\S]*?)```/)
+
+  t.ok(helperSignatureMatch, 'documents the tryCatch helper signature')
+
+  const helperSignature = helperSignatureMatch && helperSignatureMatch[1]
+  const indexLine =
+    indexDoc.split('\n').filter(line => line.indexOf('[`tryCatch`]') !== -1)[0]
+
+  const oldSingleArgSignature =
+    /tryCatch\s*::\s*\(a\s*->\s*b\)\s*->\s*a\s*->\s*Result\s+e\s+b/
+
+
+  const variadicFunctionInput =
+    /\(\(\*\)\s*->\s*b\)/
+
+  const variadicArgumentInput =
+    /\(\*\)\s*->\s*Result\s+e\s+b/
+
+  t.ok(
+    variadicFunctionInput.test(helperSignature) && variadicArgumentInput.test(helperSignature),
+    'helper docs signature describes wrapping variadic functions'
+  )
+
+  t.notOk(
+    oldSingleArgSignature.test(helperSignature),
+    'helper docs no longer describe tryCatch as only wrapping unary functions'
+  )
+
+  t.ok(indexLine, 'lists tryCatch in the function index')
+
+  t.ok(
+    variadicFunctionInput.test(indexLine) && variadicArgumentInput.test(indexLine),
+    'function index signature describes wrapping variadic functions'
+  )
+
+  t.notOk(
+    oldSingleArgSignature.test(indexLine),
+    'function index no longer uses the old unary tryCatch signature'
+  )
+
   t.end()
 })
