+
+func TestLocalQueueCompleteAlwaysSucceeds(t *testing.T) {
+	plugin, err := queue_plugin.New()
+	if err != nil {
+		t.Fatalf("New returned unexpected error: %v", err)
+	}
+
+	cases := []struct {
+		queue   string
+		leaseID string
+	}{
+		{queue: "local-alpha", leaseID: "lease-local-1"},
+		{queue: "local beta/with spaces", leaseID: "lease-local-2"},
+		{queue: "", leaseID: ""},
+	}
+
+	for _, tc := range cases {
