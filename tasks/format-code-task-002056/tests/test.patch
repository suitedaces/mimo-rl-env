+package pubsub_queue_plugin_test
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/googleapis/gax-go/v2"
+	"github.com/nitric-dev/membrane/plugins/gcp/ifaces"
+	pubsub_queue_plugin "github.com/nitric-dev/membrane/plugins/gcp/queue/pubsub"
+	"google.golang.org/api/iterator"
+	"google.golang.org/api/option"
+	pubsubpb "google.golang.org/genproto/googleapis/pubsub/v1"
+)
+
+type recordedPubSubAck struct {
+	subscription string
+	ackIDs       []string
+}
+
+type recordingSubscriber struct {
+	ackError error
+	acks     []recordedPubSubAck
+}
+
+func (r *recordingSubscriber) Close() error {
+	return nil
+}
+
+func (r *recordingSubscriber) Pull(ctx context.Context, req *pubsubpb.PullRequest, opts ...gax.CallOption) (*pubsubpb.PullResponse, error) {
+	return &pubsubpb.PullResponse{}, nil
+}
+
+func (r *recordingSubscriber) Acknowledge(ctx context.Context, req *pubsubpb.AcknowledgeRequest, opts ...gax.CallOption) error {
+	ackIDs := append([]string(nil), req.AckIds...)
+	r.acks = append(r.acks, recordedPubSubAck{
+		subscription: req.Subscription,
+		ackIDs:       ackIDs,
+	})
+	return r.ackError
+}
+
+type fakePubSubClient struct {
+	topics map[string]bool
+}
+
+func (f *fakePubSubClient) Topic(id string) ifaces.Topic {
+	return &fakeTopic{id: id, exists: f.topics[id]}
+}
+
+func (f *fakePubSubClient) Topics(ctx context.Context) ifaces.TopicIterator {
+	return &fakeTopicIterator{}
+}
+
+type fakeTopicIterator struct{}
+
+func (f *fakeTopicIterator) Next() (ifaces.Topic, error) {
+	return nil, iterator.Done
+}
+
+type fakeTopic struct {
+	id     string
+	exists bool
+}
+
+func (f *fakeTopic) String() string {
+	return f.id
+}
+
+func (f *fakeTopic) Publish(ctx context.Context, msg ifaces.Message) ifaces.PublishResult {
+	return fakePublishResult{}
+}
+
+func (f *fakeTopic) Exists(ctx context.Context) (bool, error) {
+	return f.exists, nil
+}
+
+func (f *fakeTopic) Subscriptions(ctx context.Context) ifaces.SubscriptionIterator {
+	if !f.exists {
+		return &fakeSubscriptionIterator{}
+	}
+	return &fakeSubscriptionIterator{subs: []ifaces.Subscription{fakeSubscription{topicID: f.id}}}
+}
+
+func (f *fakeTopic) ID() string {
+	return f.id
+}
+
+type fakeSubscription struct {
+	topicID string
+}
+
+func (f fakeSubscription) ID() string {
+	return f.topicID + "-nitricqueue"
+}
+
+func (f fakeSubscription) String() string {
+	return "projects/fixture/subscriptions/" + f.ID()
+}
+
+type fakeSubscriptionIterator struct {
+	idx  int
+	subs []ifaces.Subscription
+}
+
+func (f *fakeSubscriptionIterator) Next() (ifaces.Subscription, error) {
+	if f.idx >= len(f.subs) {
+		return nil, iterator.Done
+	}
+	sub := f.subs[f.idx]
+	f.idx++
+	return sub, nil
+}
+
+type fakePublishResult struct{}
+
+func (fakePublishResult) Get(ctx context.Context) (string, error) {
+	return "", nil
+}
+
+var _ ifaces.SubscriberClient = (*recordingSubscriber)(nil)
+
+func newPubSubPluginWithRecordingSubscriber(topics []string, subscriber *recordingSubscriber) interface {
+	Complete(queue string, leaseId string) error
+} {
+	topicSet := map[string]bool{}
+	for _, topic := range topics {
+		topicSet[topic] = true
+	}
+	return pubsub_queue_plugin.NewWithClients(&fakePubSubClient{topics: topicSet}, func(ctx context.Context, opts ...option.ClientOption) (ifaces.SubscriberClient, error) {
+		return subscriber, nil
+	})
+}
+
+func TestPubSubCompleteAcknowledgesKnownQueueLease(t *testing.T) {
+	cases := []struct {
+		name    string
+		queue   string
+		leaseID string
+	}{
+		{name: "alpha", queue: "queue-alpha", leaseID: "ack-alpha-7"},
+		{name: "beta", queue: "queue-beta", leaseID: "ack-beta-9"},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			subscriber := &recordingSubscriber{}
+			plugin := newPubSubPluginWithRecordingSubscriber([]string{"queue-alpha", "queue-beta"}, subscriber)
+
+			if err := plugin.Complete(tc.queue, tc.leaseID); err != nil {
+				t.Fatalf("Complete returned unexpected error: %v", err)
+			}
+			if got := len(subscriber.acks); got != 1 {
+				t.Fatalf("expected one acknowledgement, got %d", got)
+			}
+			wantSubscription := fakeSubscription{topicID: tc.queue}.String()
+			if subscriber.acks[0].subscription != wantSubscription {
+				t.Fatalf("ack subscription %q, want %q", subscriber.acks[0].subscription, wantSubscription)
+			}
+			if got := subscriber.acks[0].ackIDs; len(got) != 1 || got[0] != tc.leaseID {
+				t.Fatalf("ack IDs = %#v, want exactly %#v", got, []string{tc.leaseID})
+			}
+		})
+	}
+}
+
+func TestPubSubCompleteReturnsContextOnAckFailure(t *testing.T) {
+	cases := []struct {
+		name         string
+		leaseID      string
+		sentinelText string
+	}{
+		{name: "first sentinel", leaseID: "ack-error-a", sentinelText: "boom-pubsub-a"},
+		{name: "second sentinel", leaseID: "ack-error-b", sentinelText: "boom-pubsub-b"},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			subscriber := &recordingSubscriber{ackError: errors.New(tc.sentinelText)}
+			plugin := newPubSubPluginWithRecordingSubscriber([]string{"queue-error"}, subscriber)
+
+			err := plugin.Complete("queue-error", tc.leaseID)
+			if err == nil {
+				t.Fatal("expected Complete to return an error")
+			}
+			if got := len(subscriber.acks); got != 1 {
+				t.Fatalf("expected one acknowledgement attempt, got %d", got)
+			}
+			wantSubscription := fakeSubscription{topicID: "queue-error"}.String()
+			if subscriber.acks[0].subscription != wantSubscription {
+				t.Fatalf("ack subscription %q, want %q", subscriber.acks[0].subscription, wantSubscription)
+			}
+			if got := subscriber.acks[0].ackIDs; len(got) != 1 || got[0] != tc.leaseID {
+				t.Fatalf("ack IDs = %#v, want exactly %#v", got, []string{tc.leaseID})
+			}
+		})
+	}
+}
