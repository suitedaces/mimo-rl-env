new file mode 100644
index 00000000..06ab9585
--- /dev/null
+++ b/plugins/aws/queue/sqs/sqs_complete_test.go
@@ -0,0 +1,135 @@
+package sqs_plugin_test
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/aws/aws-sdk-go/service/sqs"
+	"github.com/aws/aws-sdk-go/service/sqs/sqsiface"
+	sqs_plugin "github.com/nitric-dev/membrane/plugins/aws/queue/sqs"
+)
+
+type recordedSQSComplete struct {
+	queueURL string
+	leaseID  string
+}
+
+type recordingSQS struct {
+	sqsiface.SQSAPI
+	queueURLs   []string
+	deleteError error
+	completes   []recordedSQSComplete
+}
+
+func (r *recordingSQS) ListQueues(in *sqs.ListQueuesInput) (*sqs.ListQueuesOutput, error) {
+	urls := make([]*string, 0, len(r.queueURLs))
+	for _, q := range r.queueURLs {
+		q := q
+		urls = append(urls, &q)
+	}
+	return &sqs.ListQueuesOutput{QueueUrls: urls}, nil
+}
+
+func (r *recordingSQS) DeleteMessage(in *sqs.DeleteMessageInput) (*sqs.DeleteMessageOutput, error) {
+	queueURL := ""
+	if in.QueueUrl != nil {
+		queueURL = *in.QueueUrl
+	}
+	leaseID := ""
+	if in.ReceiptHandle != nil {
+		leaseID = *in.ReceiptHandle
+	}
+	r.completes = append(r.completes, recordedSQSComplete{
+		queueURL: queueURL,
+		leaseID:  leaseID,
+	})
+	if r.deleteError != nil {
+		return nil, r.deleteError
+	}
+	return &sqs.DeleteMessageOutput{}, nil
+}
+
+func TestSQSCompleteDeletesKnownQueueMessage(t *testing.T) {
+	cases := []struct {
+		name    string
+		queue   string
+		leaseID string
+	}{
+		{name: "alpha", queue: "alpha-work-items", leaseID: "lease-alpha-7"},
+		{name: "beta", queue: "beta-work-items", leaseID: "lease-beta-9"},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			client := &recordingSQS{
+				queueURLs: []string{"alpha-work-items", "beta-work-items"},
+			}
+			plugin := sqs_plugin.NewWithClient(client)
+
+			if err := plugin.Complete(tc.queue, tc.leaseID); err != nil {
+				t.Fatalf("Complete returned unexpected error: %v", err)
+			}
+			if got := len(client.completes); got != 1 {
+				t.Fatalf("expected one backend completion, got %d", got)
+			}
+			if client.completes[0].queueURL != tc.queue {
+				t.Fatalf("completion used queue target %q, want %q", client.completes[0].queueURL, tc.queue)
+			}
+			if client.completes[0].leaseID != tc.leaseID {
+				t.Fatalf("completion used lease %q, want %q", client.completes[0].leaseID, tc.leaseID)
+			}
+		})
+	}
+}
+
+func TestSQSCompleteReturnsContextOnDeleteFailure(t *testing.T) {
+	cases := []struct {
+		name         string
+		leaseID      string
+		sentinelText string
+	}{
+		{name: "first sentinel", leaseID: "lease-error-a", sentinelText: "boom-sqs-a"},
+		{name: "second sentinel", leaseID: "lease-error-b", sentinelText: "boom-sqs-b"},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			client := &recordingSQS{
+				queueURLs:   []string{"error-work-items"},
+				deleteError: errors.New(tc.sentinelText),
+			}
+			plugin := sqs_plugin.NewWithClient(client)
+
+			err := plugin.Complete("error-work-items", tc.leaseID)
+			if err == nil {
+				t.Fatal("expected Complete to return an error")
+			}
+			if got := len(client.completes); got != 1 {
+				t.Fatalf("expected one backend completion attempt, got %d", got)
+			}
+			if client.completes[0].queueURL != "error-work-items" {
+				t.Fatalf("completion used queue target %q, want %q", client.completes[0].queueURL, "error-work-items")
+			}
+			if client.completes[0].leaseID != tc.leaseID {
+				t.Fatalf("completion used lease %q, want %q", client.completes[0].leaseID, tc.leaseID)
+			}
+		})
+	}
+}
+
+func TestSQSCompleteUnknownQueueDoesNotComplete(t *testing.T) {
+	for _, missingQueue := range []string{"missing-work-items", "absent-dead-letter"} {
+		t.Run(missingQueue, func(t *testing.T) {
+			client := &recordingSQS{queueURLs: []string{"known-work-items"}}
+			plugin := sqs_plugin.NewWithClient(client)
+
+			err := plugin.Complete(missingQueue, "lease-for-"+missingQueue)
+			if err == nil {
+				t.Fatal("expected Complete to return an error for an unknown queue")
+			}
+			if got := len(client.completes); got != 0 {
+				t.Fatalf("expected no backend completion for unknown queue, got %d", got)
+			}
+		})
+	}
+}
