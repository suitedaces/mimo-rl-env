diff --git a/services/queue_grpc_complete_test.go b/services/queue_grpc_complete_test.go
new file mode 100644
index 00000000..bc2b3d1a
--- /dev/null
+++ b/services/queue_grpc_complete_test.go
@@ -0,0 +1,119 @@
+package services
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	pb "github.com/nitric-dev/membrane/interfaces/nitric/v1"
+	"github.com/nitric-dev/membrane/plugins/sdk"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+type recordedPluginComplete struct {
+	queue   string
+	leaseID string
+}
+
+type recordingQueuePlugin struct {
+	completeError error
+	completes     []recordedPluginComplete
+}
+
+func (r *recordingQueuePlugin) Push(queue string, events []sdk.NitricEvent) (*sdk.PushResponse, error) {
+	return &sdk.PushResponse{}, nil
+}
+
+func (r *recordingQueuePlugin) Pop(options sdk.PopOptions) ([]sdk.NitricQueueItem, error) {
+	return nil, nil
+}
+
+func (r *recordingQueuePlugin) Complete(queue string, leaseId string) error {
+	r.completes = append(r.completes, recordedPluginComplete{
+		queue:   queue,
+		leaseID: leaseId,
+	})
+	return r.completeError
+}
+
+var _ sdk.QueuePlugin = (*recordingQueuePlugin)(nil)
+
+func TestQueueServerCompleteDelegatesAndReturnsResponse(t *testing.T) {
+	cases := []struct {
+		name    string
+		queue   string
+		leaseID string
+	}{
+		{name: "alpha", queue: "grpc-alpha", leaseID: "grpc-lease-1"},
+		{name: "beta", queue: "grpc-beta", leaseID: "grpc-lease-2"},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			plugin := &recordingQueuePlugin{}
+			server := NewQueueServer(plugin)
+
+			resp, err := server.Complete(context.Background(), &pb.CompleteRequest{
+				Queue:   tc.queue,
+				LeaseId: tc.leaseID,
+			})
+			if err != nil {
+				t.Fatalf("Complete returned unexpected error: %v", err)
+			}
+			if resp == nil {
+				t.Fatal("Complete returned nil response on success")
+			}
+			if got := len(plugin.completes); got != 1 {
+				t.Fatalf("expected one plugin Complete call, got %d", got)
+			}
+			if plugin.completes[0].queue != tc.queue {
+				t.Fatalf("plugin saw queue %q, want %q", plugin.completes[0].queue, tc.queue)
+			}
+			if plugin.completes[0].leaseID != tc.leaseID {
+				t.Fatalf("plugin saw lease %q, want %q", plugin.completes[0].leaseID, tc.leaseID)
+			}
+		})
+	}
+}
+
+func TestQueueServerCompletePropagatesPluginError(t *testing.T) {
+	sentinelErr := errors.New("plugin complete failed")
+	plugin := &recordingQueuePlugin{completeError: sentinelErr}
+	server := NewQueueServer(plugin)
+
+	resp, err := server.Complete(context.Background(), &pb.CompleteRequest{
+		Queue:   "grpc-error-queue",
+		LeaseId: "grpc-error-lease",
+	})
+	if err == nil {
+		t.Fatal("expected Complete to return plugin error")
+	}
+	if resp != nil {
+		t.Fatalf("expected nil response on plugin error, got %#v", resp)
+	}
+	if got := len(plugin.completes); got != 1 {
+		t.Fatalf("expected one plugin Complete call, got %d", got)
+	}
+	if !errors.Is(err, sentinelErr) {
+		t.Fatalf("Complete returned error %#v, want plugin sentinel %#v", err, sentinelErr)
+	}
+}
+
+func TestQueueServerCompleteWithoutPluginReturnsRegistrationError(t *testing.T) {
+	server := NewQueueServer(nil)
+
+	resp, err := server.Complete(context.Background(), &pb.CompleteRequest{
+		Queue:   "grpc-unregistered",
+		LeaseId: "grpc-unregistered-lease",
+	})
+	if err == nil {
+		t.Fatal("expected Complete to return an error when no plugin is registered")
+	}
+	if got := status.Code(err); got != codes.Unimplemented {
+		t.Fatalf("Complete returned status %v, want %v", got, codes.Unimplemented)
+	}
+	if resp != nil {
+		t.Fatalf("expected nil response when no plugin is registered, got %#v", resp)
+	}
+}
