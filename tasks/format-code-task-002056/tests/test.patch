+func (r *UpdateDocumentRequest) GetCollection() string { if r == nil { return "" }; return r.Collection }
+func (r *UpdateDocumentRequest) GetKey() string        { if r == nil { return "" }; return r.Key }
+func (r *UpdateDocumentRequest) GetDocument() *structpb.Struct {
+	if r == nil || r.Document == nil {
