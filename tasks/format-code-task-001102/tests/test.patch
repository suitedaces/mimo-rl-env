+func TestControllerValidateContractIPFamilies(t *testing.T) {
+    controller, stopCh := contractValidationController(t)
+    defer close(stopCh)
+
+    malformedSource := contractLiveTraceflow()
+    malformedSource.Spec.Source.IP = "not-an-ip"
+    contractRequireDenied(t, controller, admv1.Create, nil, malformedSource, "source", "ip")
+
+    malformedDestination := contractRegularTraceflow()
+    malformedDestination.Spec.Destination = crdv1beta1.Destination{IP: "10.20.0.999"}
+    contractRequireDenied(t, controller, admv1.Create, nil, malformedDestination, "destination", "ip")
+
+    v4WithIPv6Header := contractLiveTraceflow()
+    v4WithIPv6Header.Spec.Source.IP = "10.20.0.9"
+    v4WithIPv6Header.Spec.Packet.IPv6Header = &crdv1beta1.IPv6Header{}
+    contractRequireDenied(t, controller, admv1.Create, nil, v4WithIPv6Header, "source", "ip")
+
+    v6WithIPv4Header := contractRegularTraceflow()
+    v6WithIPv4Header.Spec.Destination = crdv1beta1.Destination{IP: "2001:db8::8"}
+    contractRequireDenied(t, controller, admv1.Create, nil, v6WithIPv4Header, "destination", "ip")
+
+    matchingV6 := contractLiveTraceflow()
+    matchingV6.Spec.Source.IP = "2001:db8::9"
+    matchingV6.Spec.Packet.IPv6Header = &crdv1beta1.IPv6Header{}
+    contractRequireAllowed(t, controller, admv1.Create, nil, matchingV6)
+}
