+func TestControllerValidateContractUpdates(t *testing.T) {
+    controller, stopCh := contractValidationController(t)
+    defer close(stopCh)
+
+    oldObject := contractRegularTraceflow()
+    unchanged := oldObject.DeepCopy()
+    contractRequireAllowed(t, controller, admv1.Update, oldObject, unchanged)
+
+    changed := oldObject.DeepCopy()
+    changed.Spec.Timeout = 60
+    contractRequireDenied(t, controller, admv1.Update, oldObject, changed, "spec")
+
+    changedEndpoint := oldObject.DeepCopy()
+    changedEndpoint.Spec.Destination = crdv1beta1.Destination{IP: "10.20.0.8"}
+    contractRequireDenied(t, controller, admv1.Update, oldObject, changedEndpoint, "spec")
+
+    changedPacket := oldObject.DeepCopy()
+    changedPacket.Spec.Packet.TransportHeader.TCP = &crdv1beta1.TCPHeader{DstPort: 80}
+    contractRequireDenied(t, controller, admv1.Update, oldObject, changedPacket, "spec")
+
+    invalidUnchanged := contractLiveTraceflow()
+    invalidUnchanged.Spec.DroppedOnly = true
+    invalidUnchanged.Spec.LiveTraffic = false
+    contractRequireDenied(t, controller, admv1.Update, invalidUnchanged, invalidUnchanged.DeepCopy(), "droppedonly", "livetraffic")
+
+    contractRequireDenied(t, controller, admv1.Update, nil, oldObject.DeepCopy(), "old")
+}
+
+func contractValidationController(t *testing.T) (*Controller, chan struct{}) {
+    t.Helper()
+    pods := []runtime.Object{
+        &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Namespace: "work", Name: "src"}},
+        &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Namespace: "work", Name: "dst"}},
+        &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Namespace: "work", Name: "host-src"}, Spec: corev1.PodSpec{HostNetwork: true}},
+    }
+    wrapped := newController(pods...)
+    stopCh := make(chan struct{})
+    wrapped.informerFactory.Start(stopCh)
+    wrapped.crdInformerFactory.Start(stopCh)
+    wrapped.informerFactory.WaitForCacheSync(stopCh)
+    wrapped.crdInformerFactory.WaitForCacheSync(stopCh)
+    return wrapped.Controller, stopCh
+}
+
+func contractRegularTraceflow() *crdv1beta1.Traceflow {
+    return &crdv1beta1.Traceflow{
+        ObjectMeta: metav1.ObjectMeta{Name: "contract-regular"},
+        Spec: crdv1beta1.TraceflowSpec{
+            Source: crdv1beta1.Source{Namespace: "work", Pod: "src"},
+            Destination: crdv1beta1.Destination{Namespace: "work", Pod: "dst"},
+        },
+    }
+}
+
+func contractLiveTraceflow() *crdv1beta1.Traceflow {
+    return &crdv1beta1.Traceflow{
+        ObjectMeta: metav1.ObjectMeta{Name: "contract-live"},
+        Spec: crdv1beta1.TraceflowSpec{
+            LiveTraffic: true,
+            Destination: crdv1beta1.Destination{Namespace: "work", Pod: "dst"},
+        },
+    }
+}
