+func TestControllerValidateContractEndpointShapes(t *testing.T) {
+    controller, stopCh := contractValidationController(t)
+    defer close(stopCh)
+
+    valid := contractRegularTraceflow()
+    contractRequireAllowed(t, controller, admv1.Create, nil, valid)
+
+    bothDestinationKinds := valid.DeepCopy()
+    bothDestinationKinds.Spec.Destination.IP = "10.20.0.8"
+    contractRequireDenied(t, controller, admv1.Create, nil, bothDestinationKinds, "destination", "pod", "ip")
+
+    podAndService := valid.DeepCopy()
+    podAndService.Spec.Destination.Service = "api"
+    contractRequireDenied(t, controller, admv1.Create, nil, podAndService, "destination", "pod", "service")
+
+    serviceAndIP := valid.DeepCopy()
+    serviceAndIP.Spec.Destination = crdv1beta1.Destination{Namespace: "work", Service: "api", IP: "10.20.0.8"}
+    contractRequireDenied(t, controller, admv1.Create, nil, serviceAndIP, "destination", "service", "ip")
+
+    bothSourceKinds := contractLiveTraceflow()
+    bothSourceKinds.Spec.Source = crdv1beta1.Source{Namespace: "work", Pod: "src", IP: "10.20.0.9"}
+    contractRequireDenied(t, controller, admv1.Create, nil, bothSourceKinds, "source", "pod", "ip")
+
+    missingNamespace := valid.DeepCopy()
+    missingNamespace.Spec.Destination.Namespace = ""
+    contractRequireDenied(t, controller, admv1.Create, nil, missingNamespace, "destination", "namespace")
+
+    serviceWithoutNamespace := valid.DeepCopy()
+    serviceWithoutNamespace.Spec.Destination = crdv1beta1.Destination{Service: "api"}
+    contractRequireDenied(t, controller, admv1.Create, nil, serviceWithoutNamespace, "destination", "namespace")
+
+    namespaceWithIP := valid.DeepCopy()
+    namespaceWithIP.Spec.Destination = crdv1beta1.Destination{Namespace: "work", IP: "10.20.0.8"}
+    contractRequireDenied(t, controller, admv1.Create, nil, namespaceWithIP, "destination", "namespace")
+}
