+func contractRequireAllowed(t *testing.T, controller *Controller, operation admv1.Operation, oldObject, object *crdv1beta1.Traceflow) {
+    t.Helper()
+    response := controller.Validate(contractAdmissionReview(t, operation, oldObject, object))
+    require.Equal(t, types.UID("contract-uid"), response.UID)
+    require.True(t, response.Allowed, "unexpected denial: %#v", response.Result)
+}
+
+func contractRequireDenied(t *testing.T, controller *Controller, operation admv1.Operation, oldObject, object *crdv1beta1.Traceflow, messageParts ...string) {
+    t.Helper()
+    response := controller.Validate(contractAdmissionReview(t, operation, oldObject, object))
+    require.Equal(t, types.UID("contract-uid"), response.UID)
+    require.False(t, response.Allowed)
+    require.NotNil(t, response.Result)
+    message := strings.ToLower(response.Result.Message)
+    for _, part := range messageParts {
+        require.Contains(t, message, strings.ToLower(part))
+    }
+}
+
+func contractAdmissionReview(t *testing.T, operation admv1.Operation, oldObject, object *crdv1beta1.Traceflow) *admv1.AdmissionReview {
+    t.Helper()
+    request := &admv1.AdmissionRequest{UID: types.UID("contract-uid"), Operation: operation}
+    if oldObject != nil {
+        raw, err := json.Marshal(oldObject)
+        require.NoError(t, err)
+        request.OldObject = runtime.RawExtension{Raw: raw}
+    }
+    if object != nil {
+        raw, err := json.Marshal(object)
+        require.NoError(t, err)
+        request.Object = runtime.RawExtension{Raw: raw}
+    }
+    return &admv1.AdmissionReview{Request: request}
+}
