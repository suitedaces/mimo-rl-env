+func TestControllerValidateContractLiveMode(t *testing.T) {
+    controller, stopCh := contractValidationController(t)
+    defer close(stopCh)
+
+    destinationOnly := contractLiveTraceflow()
+    contractRequireAllowed(t, controller, admv1.Create, nil, destinationOnly)
+
+    sourceIP := destinationOnly.DeepCopy()
+    sourceIP.Spec.Source.IP = "10.20.0.9"
+    contractRequireAllowed(t, controller, admv1.Create, nil, sourceIP)
+
+    sourcePodToService := destinationOnly.DeepCopy()
+    sourcePodToService.Spec.Source = crdv1beta1.Source{Namespace: "work", Pod: "src"}
+    sourcePodToService.Spec.Destination = crdv1beta1.Destination{Namespace: "work", Service: "api"}
+    contractRequireAllowed(t, controller, admv1.Create, nil, sourcePodToService)
+
+    noPodEndpoint := sourcePodToService.DeepCopy()
+    noPodEndpoint.Spec.Source = crdv1beta1.Source{IP: "10.20.0.9"}
+    contractRequireDenied(t, controller, admv1.Create, nil, noPodEndpoint, "pod")
+
+    noEndpoints := destinationOnly.DeepCopy()
+    noEndpoints.Spec.Destination = crdv1beta1.Destination{}
+    contractRequireDenied(t, controller, admv1.Create, nil, noEndpoints, "pod")
+}
