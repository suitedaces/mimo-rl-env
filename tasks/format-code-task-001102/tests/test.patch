+func TestControllerValidateContractRegularMode(t *testing.T) {
+    controller, stopCh := contractValidationController(t)
+    defer close(stopCh)
+
+    missingDestination := contractRegularTraceflow()
+    missingDestination.Spec.Destination = crdv1beta1.Destination{}
+    contractRequireDenied(t, controller, admv1.Create, nil, missingDestination, "destination")
+
+    ipSource := contractRegularTraceflow()
+    ipSource.Spec.Source = crdv1beta1.Source{IP: "10.20.0.9"}
+    contractRequireDenied(t, controller, admv1.Create, nil, ipSource, "source", "pod")
+
+    missingSource := contractRegularTraceflow()
+    missingSource.Spec.Source = crdv1beta1.Source{}
+    contractRequireDenied(t, controller, admv1.Create, nil, missingSource, "source", "pod")
+
+    unknownSource := contractRegularTraceflow()
+    unknownSource.Spec.Source.Pod = "unknown"
+    contractRequireDenied(t, controller, admv1.Create, nil, unknownSource, "source", "not found")
+
+    hostSource := contractRegularTraceflow()
+    hostSource.Spec.Source.Pod = "host-src"
+    contractRequireDenied(t, controller, admv1.Create, nil, hostSource, "hostnetwork")
+}
