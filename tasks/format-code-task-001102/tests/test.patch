+func TestControllerValidateContractPacketHeaders(t *testing.T) {
+    controller, stopCh := contractValidationController(t)
+    defer close(stopCh)
+
+    bothFamilies := contractRegularTraceflow()
+    bothFamilies.Spec.Destination = crdv1beta1.Destination{IP: "2001:db8::8"}
+    bothFamilies.Spec.Packet.IPHeader = &crdv1beta1.IPHeader{}
+    bothFamilies.Spec.Packet.IPv6Header = &crdv1beta1.IPv6Header{}
+    contractRequireAllowed(t, controller, admv1.Create, nil, bothFamilies)
+
+    twoTransports := contractRegularTraceflow()
+    twoTransports.Spec.Packet.TransportHeader.TCP = &crdv1beta1.TCPHeader{DstPort: 80}
+    twoTransports.Spec.Packet.TransportHeader.UDP = &crdv1beta1.UDPHeader{DstPort: 53}
+    contractRequireDenied(t, controller, admv1.Create, nil, twoTransports, "transport", "tcp", "udp")
+
+    udpAndICMP := contractRegularTraceflow()
+    udpAndICMP.Spec.Packet.TransportHeader.UDP = &crdv1beta1.UDPHeader{DstPort: 53}
+    udpAndICMP.Spec.Packet.TransportHeader.ICMP = &crdv1beta1.ICMPEchoRequestHeader{}
+    contractRequireDenied(t, controller, admv1.Create, nil, udpAndICMP, "transport", "udp", "icmp")
+
+    mismatchedIPv4Protocol := contractRegularTraceflow()
+    mismatchedIPv4Protocol.Spec.Packet.IPHeader = &crdv1beta1.IPHeader{Protocol: 17}
+    mismatchedIPv4Protocol.Spec.Packet.TransportHeader.TCP = &crdv1beta1.TCPHeader{DstPort: 80}
+    contractRequireDenied(t, controller, admv1.Create, nil, mismatchedIPv4Protocol, "protocol", "tcp")
+
+    mismatchedICMPProtocol := contractRegularTraceflow()
+    mismatchedICMPProtocol.Spec.Packet.IPHeader = &crdv1beta1.IPHeader{Protocol: 6}
+    mismatchedICMPProtocol.Spec.Packet.TransportHeader.ICMP = &crdv1beta1.ICMPEchoRequestHeader{}
+    contractRequireDenied(t, controller, admv1.Create, nil, mismatchedICMPProtocol, "protocol", "icmp")
+
+    nextHeader := int32(6)
+    mismatchedIPv6Protocol := contractRegularTraceflow()
+    mismatchedIPv6Protocol.Spec.Destination = crdv1beta1.Destination{IP: "2001:db8::8"}
+    mismatchedIPv6Protocol.Spec.Packet.IPv6Header = &crdv1beta1.IPv6Header{NextHeader: &nextHeader}
+    mismatchedIPv6Protocol.Spec.Packet.TransportHeader.UDP = &crdv1beta1.UDPHeader{DstPort: 53}
+    contractRequireDenied(t, controller, admv1.Create, nil, mismatchedIPv6Protocol, "nextheader", "udp")
+
+    inferredTCP := contractRegularTraceflow()
+    inferredTCP.Spec.Packet.IPHeader = &crdv1beta1.IPHeader{}
+    inferredTCP.Spec.Packet.TransportHeader.TCP = &crdv1beta1.TCPHeader{DstPort: 80}
+    contractRequireAllowed(t, controller, admv1.Create, nil, inferredTCP)
+
+    customProtocol := contractRegularTraceflow()
+    customProtocol.Spec.Packet.IPHeader = &crdv1beta1.IPHeader{Protocol: 132}
+    contractRequireAllowed(t, controller, admv1.Create, nil, customProtocol)
+}
