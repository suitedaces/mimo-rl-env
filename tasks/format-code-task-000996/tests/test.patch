+++ b/mimo_test_command.sh
@@ -0,0 +1,11 @@
+#!/bin/bash
+set -euo pipefail
+
+
+REPO_ROOT="$(git rev-parse --show-toplevel)"
+VAULT_GOPATH_ROOT="$(go env GOPATH | cut -d: -f1)/src/github.com/hashicorp/vault"
+test "$(readlink -f "${VAULT_GOPATH_ROOT}")" = "${REPO_ROOT}"
+cd "${VAULT_GOPATH_ROOT}"
+GO111MODULE=off go test -vet=off ./shamir \
+  -run '^(TestCodespec.*|TestSplit_invalid|TestSplit|TestCombine_invalid|TestCombine)$' \
+  -count=1
