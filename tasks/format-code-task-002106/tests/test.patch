@@ -0,0 +1,324 @@
+
+
+from __future__ import annotations
+
+import asyncio
+import json
+import threading
+import uuid
+from collections import deque
+from dataclasses import dataclass
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.parse import parse_qs, urlparse
+
+import pytest
+
+from omnara.sdk import AsyncOmnaraClient, OmnaraClient
+
+
+AGENT_ONE = "11111111-1111-1111-1111-111111111111"
+AGENT_TWO = "22222222-2222-2222-2222-222222222222"
+
+
+def ok_response(agent_instance_id: str = AGENT_ONE) -> dict:
+    return {
+        "agent_instance_id": agent_instance_id,
+        "status": "ok",
+        "messages": [
+            {
+                "id": "m1",
+                "content": "ship it",
+                "sender_type": "user",
+                "created_at": "2026-01-02T03:04:05Z",
+                "requires_user_input": False,
+            }
+        ],
+    }
+
+
+def stale_response(agent_instance_id: str = AGENT_TWO) -> dict:
+    return {
+        "agent_instance_id": agent_instance_id,
+        "status": "stale",
+        "messages": [],
+    }
+
+
+@dataclass
+class RecordedRequest:
+    path: str
+    query: dict[str, list[str]]
+
+
+class PendingAPIServer:
+    def __init__(self, responses: list[dict]):
+        self._responses = deque(responses)
+        self.requests: list[RecordedRequest] = []
+        owner = self
+
+        class Handler(BaseHTTPRequestHandler):
+            def do_GET(self):  # noqa: N802 - required by BaseHTTPRequestHandler
+                parsed = urlparse(self.path)
+                owner.requests.append(
+                    RecordedRequest(parsed.path, parse_qs(parsed.query))
+                )
+
+                if parsed.path != "/api/v1/messages/pending":
+                    body = b'{"detail":"not found"}'
+                    self.send_response(404)
+                else:
+                    payload = owner._responses.popleft()
+                    body = json.dumps(payload).encode("utf-8")
+                    self.send_response(200)
+
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(body)))
+                self.send_header("Connection", "close")
+                self.end_headers()
+                self.wfile.write(body)
+
+            def log_message(self, *args):
+                return
+
+        self._server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        self._thread = threading.Thread(target=self._server.serve_forever, daemon=True)
+        self.base_url = f"http://127.0.0.1:{self._server.server_port}"
+
+    def __enter__(self) -> "PendingAPIServer":
+        self._thread.start()
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self._server.shutdown()
+        self._server.server_close()
+
+
+def test_sync_pending_messages_accepts_uuid_object_and_returns_message_dataclass():
+
+
+
+    with PendingAPIServer([ok_response()]) as server:
+        client = OmnaraClient("test-key", base_url=server.base_url, timeout=5, max_retries=1)
+        try:
+            response = client.get_pending_messages(uuid.UUID(AGENT_ONE))
+
+            assert type(response).__name__ == "PendingMessagesResponse"
+            assert response.agent_instance_id == "11111111-1111-1111-1111-111111111111"
+            assert response.status == "ok"
+            assert len(response.messages) == 1
+
+            message = response.messages[0]
+            assert type(message).__name__ == "Message"
+            assert message.id == "m1"
+            assert message.content == "ship it"
+            assert message.sender_type == "user"
+            assert message.created_at == "2026-01-02T03:04:05Z"
+            assert message.requires_user_input is False
+
+            assert len(server.requests) == 1
+            assert server.requests[0].path == "/api/v1/messages/pending"
+            assert server.requests[0].query == {
+                "agent_instance_id": ["11111111-1111-1111-1111-111111111111"]
+            }
+        finally:
+            client.close()
+
+
+def test_async_pending_messages_accepts_string_includes_last_read_and_preserves_stale():
+
+
+
+
+    async def run_session():
+        with PendingAPIServer([stale_response()]) as server:
+            client = AsyncOmnaraClient(
+                "test-key", base_url=server.base_url, timeout=5, max_retries=1
+            )
+            try:
+                response = await client.get_pending_messages(
+                    AGENT_TWO, last_read_message_id="m1"
+                )
+
+                assert type(response).__name__ == "PendingMessagesResponse"
+                assert response.agent_instance_id == "22222222-2222-2222-2222-222222222222"
+                assert response.status == "stale"
+                assert response.messages == []
+
+                assert len(server.requests) == 1
+                assert server.requests[0].path == "/api/v1/messages/pending"
+                assert server.requests[0].query == {
+                    "agent_instance_id": ["22222222-2222-2222-2222-222222222222"],
+                    "last_read_message_id": ["m1"],
+                }
+            finally:
+                await client.close()
+
+    asyncio.run(run_session())
+
+
+def test_invalid_agent_instance_id_raises_value_error_before_http_request():
+
+
+
+    with PendingAPIServer([ok_response(), ok_response()]) as server:
+        sync_client = OmnaraClient(
+            "test-key", base_url=server.base_url, timeout=5, max_retries=1
+        )
+        try:
+            with pytest.raises(ValueError) as sync_error:
+                sync_client.get_pending_messages("not-a-uuid")
+
+            assert isinstance(sync_error.value, ValueError)
+            assert len(server.requests) == 0
+        finally:
+            sync_client.close()
+
+        async def run_invalid_async():
+            async_client = AsyncOmnaraClient(
+                "test-key", base_url=server.base_url, timeout=5, max_retries=1
+            )
+            try:
+                with pytest.raises(ValueError) as async_error:
+                    await async_client.get_pending_messages("not-a-uuid")
+
+                assert isinstance(async_error.value, ValueError)
+
+                assert len(server.requests) == 0
+            finally:
+                await async_client.close()
+
+        asyncio.run(run_invalid_async())
+
+
+def test_two_clients_keep_pending_message_sessions_independent():
+
+
+
+    with PendingAPIServer([ok_response(AGENT_ONE)]) as server_a:
+        with PendingAPIServer([stale_response(AGENT_TWO)]) as server_b:
+            client_a = OmnaraClient(
+                "test-key-a", base_url=server_a.base_url, timeout=5, max_retries=1
+            )
+            client_b = OmnaraClient(
+                "test-key-b", base_url=server_b.base_url, timeout=5, max_retries=1
+            )
+            try:
+                response_a = client_a.get_pending_messages(AGENT_ONE)
+                assert response_a.agent_instance_id == "11111111-1111-1111-1111-111111111111"
+                assert response_a.status == "ok"
+                assert len(server_a.requests) == 1
+                assert len(server_b.requests) == 0
+
+                response_b = client_b.get_pending_messages(AGENT_TWO)
+                assert response_b.agent_instance_id == "22222222-2222-2222-2222-222222222222"
+                assert response_b.status == "stale"
+                assert response_b.messages == []
+                assert len(server_a.requests) == 1
+                assert len(server_b.requests) == 1
+                assert server_a.requests[0].query == {
+                    "agent_instance_id": ["11111111-1111-1111-1111-111111111111"]
+                }
+                assert server_b.requests[0].query == {
+                    "agent_instance_id": ["22222222-2222-2222-2222-222222222222"]
+                }
+            finally:
+                client_a.close()
+                client_b.close()
+
+
+def test_sync_and_async_clients_can_poll_after_prior_pending_message_requests():
+
+
+
+    with PendingAPIServer([stale_response(AGENT_ONE), stale_response(AGENT_TWO)]) as server:
+        sync_client = OmnaraClient(
+            "test-key", base_url=server.base_url, timeout=5, max_retries=1
+        )
+
+        sync_response = sync_client.get_pending_messages(AGENT_ONE)
+        assert sync_response.agent_instance_id == "11111111-1111-1111-1111-111111111111"
+        assert sync_response.status == "stale"
+        assert sync_response.messages == []
+        assert len(server.requests) == 1
+        assert server.requests[0].query == {
+            "agent_instance_id": ["11111111-1111-1111-1111-111111111111"]
+        }
+
+        async def run_async_close():
+            async_client = AsyncOmnaraClient(
+                "test-key", base_url=server.base_url, timeout=5, max_retries=1
+            )
+
+            async_response = await async_client.get_pending_messages(AGENT_TWO)
+            assert async_response.agent_instance_id == "22222222-2222-2222-2222-222222222222"
+            assert async_response.status == "stale"
+            assert async_response.messages == []
+            assert len(server.requests) == 2
+            assert server.requests[1].query == {
+                "agent_instance_id": ["22222222-2222-2222-2222-222222222222"]
+            }
+            await async_client.close()
+
+        asyncio.run(run_async_close())
+        sync_client.close()
+
+
+def test_repeated_pending_message_polls_preserve_request_parameters():
+
+
+
+    responses = [
+        ok_response(AGENT_ONE),
+        stale_response(AGENT_TWO),
+        ok_response(AGENT_ONE),
+        stale_response(AGENT_TWO),
+    ]
+
+    with PendingAPIServer(responses) as server:
+        sync_client = OmnaraClient(
+            "test-key", base_url=server.base_url, timeout=5, max_retries=1
+        )
+
+        first_sync = sync_client.get_pending_messages(AGENT_ONE)
+        second_sync = sync_client.get_pending_messages(
+            AGENT_TWO, last_read_message_id="m1"
+        )
+        assert first_sync.status == "ok"
+        assert len(first_sync.messages) == 1
+        assert second_sync.status == "stale"
+        assert second_sync.messages == []
+        assert len(server.requests) == 2
+        assert server.requests[0].query == {
+            "agent_instance_id": ["11111111-1111-1111-1111-111111111111"]
+        }
+        assert server.requests[1].query == {
+            "agent_instance_id": ["22222222-2222-2222-2222-222222222222"],
+            "last_read_message_id": ["m1"],
+        }
+        sync_client.close()
+
+        async def run_async_cycles():
+            async_client = AsyncOmnaraClient(
+                "test-key", base_url=server.base_url, timeout=5, max_retries=1
+            )
+
+            first_async = await async_client.get_pending_messages(AGENT_ONE)
+            second_async = await async_client.get_pending_messages(
+                AGENT_TWO, last_read_message_id="m1"
+            )
+            assert first_async.status == "ok"
+            assert len(first_async.messages) == 1
+            assert second_async.status == "stale"
+            assert second_async.messages == []
+            assert len(server.requests) == 4
+            assert server.requests[2].query == {
+                "agent_instance_id": ["11111111-1111-1111-1111-111111111111"]
+            }
+            assert server.requests[3].query == {
+                "agent_instance_id": ["22222222-2222-2222-2222-222222222222"],
+                "last_read_message_id": ["m1"],
+            }
+            await async_client.close()
+
+        asyncio.run(run_async_cycles())
+        assert len(server.requests) == 4
