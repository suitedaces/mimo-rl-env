diff --git a/tests/test_awslambda/test_lambda_layers.py b/tests/test_awslambda/test_lambda_layers.py
index 8e0be4001..4685f4907 100644
--- a/tests/test_awslambda/test_lambda_layers.py
+++ b/tests/test_awslambda/test_lambda_layers.py
@@ -230,3 +230,128 @@ def test_delete_layer_version():
 
     result = conn.list_layer_versions(LayerName=layer_name)["LayerVersions"]
     result.should.equal([])
+
+
+@mock_lambda
+@mock_s3
+def test_list_layers_after_only_version_deleted():
+    """Issue reproduction: publish a single layer version, delete it, then
+    list_layers must not raise and must not include the now-empty layer."""
+    conn = boto3.client("lambda", _lambda_region)
+    layer_name = str(uuid4())[0:6]
+
+    resp = conn.publish_layer_version(
+        LayerName=layer_name,
+        Content={"ZipFile": get_test_zip_file1()},
+        CompatibleRuntimes=["python3.6"],
+        LicenseInfo="MIT",
+    )
+    layer_version = resp["Version"]
+
+
+    pre = conn.list_layers()
+    pre_names = [l["LayerName"] for l in pre["Layers"]]
+    assert layer_name in pre_names
+
+    conn.delete_layer_version(LayerName=layer_name, VersionNumber=layer_version)
+
+
+    result = conn.list_layers()
+    names = [l["LayerName"] for l in result["Layers"]]
+    assert layer_name not in names
+
+
+@mock_lambda
+@mock_s3
+def test_list_layers_after_latest_version_deleted_with_remaining():
+    """publish v1 and v2, delete v2; list_layers must succeed and report v1
+    as the LatestMatchingVersion of the remaining layer."""
+    conn = boto3.client("lambda", _lambda_region)
+    layer_name = str(uuid4())[0:6]
+
+    resp1 = conn.publish_layer_version(
+        LayerName=layer_name,
+        Content={"ZipFile": get_test_zip_file1()},
+        CompatibleRuntimes=["python3.6"],
+        LicenseInfo="MIT",
+    )
+    v1 = resp1["Version"]
+    resp2 = conn.publish_layer_version(
+        LayerName=layer_name,
+        Content={"ZipFile": get_test_zip_file1()},
+        CompatibleRuntimes=["python3.7"],
+        LicenseInfo="MIT",
+    )
+    v2 = resp2["Version"]
+    assert v1 == 1
+    assert v2 == 2
+
+
+    conn.delete_layer_version(LayerName=layer_name, VersionNumber=v2)
+
+    result = conn.list_layers()
+    matching = [l for l in result["Layers"] if l["LayerName"] == layer_name]
+    assert len(matching) == 1
+    layer = matching[0]
+    assert layer["LatestMatchingVersion"]["Version"] == v1
+
+    assert layer["LatestMatchingVersion"]["LayerVersionArn"].endswith(":1")
+
+
+@mock_lambda
+@mock_s3
+def test_list_layers_excludes_only_deleted_layer_keeps_others():
+    """When several layers exist and only one is fully deleted, list_layers
+    must keep the others."""
+    conn = boto3.client("lambda", _lambda_region)
+    layer_a = "a-" + str(uuid4())[0:6]
+    layer_b = "b-" + str(uuid4())[0:6]
+
+    resp_a = conn.publish_layer_version(
+        LayerName=layer_a,
+        Content={"ZipFile": get_test_zip_file1()},
+        CompatibleRuntimes=["python3.6"],
+        LicenseInfo="MIT",
+    )
+    conn.publish_layer_version(
+        LayerName=layer_b,
+        Content={"ZipFile": get_test_zip_file1()},
+        CompatibleRuntimes=["python3.6"],
+        LicenseInfo="MIT",
+    )
+
+    conn.delete_layer_version(LayerName=layer_a, VersionNumber=resp_a["Version"])
+
+    result = conn.list_layers()
+    names = [l["LayerName"] for l in result["Layers"]]
+    assert layer_a not in names
+    assert layer_b in names
+
+
+@mock_lambda
+@mock_s3
+def test_publish_after_deleting_only_version_does_not_reuse_version_number():
+    """After deleting the only version of a layer, the next publish_layer_version
+    must continue the sequence (v2), not restart from v1 — AWS layer versions are
+    not reused after deletion."""
+    conn = boto3.client("lambda", _lambda_region)
+    layer_name = str(uuid4())[0:6]
+
+    resp1 = conn.publish_layer_version(
+        LayerName=layer_name,
+        Content={"ZipFile": get_test_zip_file1()},
+        CompatibleRuntimes=["python3.6"],
+        LicenseInfo="MIT",
+    )
+    assert resp1["Version"] == 1
+
+    conn.delete_layer_version(LayerName=layer_name, VersionNumber=resp1["Version"])
+
+    resp2 = conn.publish_layer_version(
+        LayerName=layer_name,
+        Content={"ZipFile": get_test_zip_file1()},
+        CompatibleRuntimes=["python3.7"],
+        LicenseInfo="MIT",
+    )
+    assert resp2["Version"] == 2
+    assert resp2["LayerVersionArn"].endswith(":2")
