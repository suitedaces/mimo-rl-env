diff --git a/packages/mdx/test/index.test.js b/packages/mdx/test/index.test.js
index a5a1241d..477f304a 100644
--- a/packages/mdx/test/index.test.js
+++ b/packages/mdx/test/index.test.js
@@ -419,3 +419,53 @@ test('Should handle layout props', () => {
     MDXContent.isMDXComponent = true;"
   `)
 })
+
+// The issue requests that the component name be "quoted clearly" in the
+// undefined-component warning, with `Component 'Image' was not imported...`
+// given as an example. We treat any visible quoting/delimiting around the
+// name (single quote, backtick, escaped double quote, or JSON.stringify)
+// as satisfying the user-facing expectation.
+const QUOTED_NAME_RE = new RegExp(
+  'Component (?:' +
+    // 'name'  ->  "Component '" + name + "'"
+    "'\" \\+ name \\+ \"'" +
+    '|' +
+    // `name`  ->  "Component `" + name + "`"
+    '`" \\+ name \\+ "`' +
+    '|' +
+    // "name" via escaped double-quote literal -> "Component \"" + name + "\""
+    '\\\\"" \\+ name \\+ "\\\\"' +
+    '|' +
+
+    '" \\+ JSON\\.stringify\\(name\\) \\+ "' +
+  ') was not imported, exported, or provided by MDXProvider as global scope'
+)
+
+test('Should quote component name in shortcode warning message', async () => {
+  const result = await mdx('# Hello World')
+
+
+
+  expect(result).toMatch(QUOTED_NAME_RE)
+})
+
+test('Should NOT emit unquoted component name in shortcode warning', async () => {
+  const result = await mdx('# Hello World')
+
+
+
+  expect(result).not.toMatch(
+    /"Component " \+ name \+ " was not imported/
+  )
+})
+
+test('Should quote name in warning when MDX uses an unknown component', async () => {
+
+
+
+  const result = await mdx('<Image />\n')
+
+  expect(result).toContain('makeShortcode("Image")')
+  expect(result).toMatch(QUOTED_NAME_RE)
+  expect(result).not.toMatch(/"Component " \+ name \+ " was not imported/)
+})
