diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /testbed
+
+
+
+if ! command -v pnpm &>/dev/null; then
+  ln -sf /opt/node-22/bin/pnpm /usr/local/bin/pnpm
+fi
+
+
+pnpm install --ignore-scripts
+
+
+case "${1:-}" in
+  base)
+    BABEL_ENV=test npm_config_rule=valid-types npx mocha test/rules/index.js
+    ;;
+  new)
+    BABEL_ENV=test npm_config_rule=valid-types npx mocha test/rules/index.js
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
