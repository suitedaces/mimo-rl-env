+func TestZZZKafkaProducerMiddlewareOrderStopAndExecution(t *testing.T) {
+
+
+
+
+	impl := closeableProducer(t)
+	mustNoError(t, impl.Close())
+
+	broker := newProducerBroker(t, "orders")
+	defer broker.Close()
+	defer impl.Close()
+
+	cfg := sarama.NewConfig()
+	cfg.Version = sarama.V2_1_0_0
+	kafka.GetProducer().Start([]string{broker.Addr()}, cfg)
+	mustNoError(t, kafka.GetProducer().Restart())
+
+	var events []string
+	kafka.InstallMiddleware(
+		func(msg *kafka.Msg) {
+			events = append(events, "first-before:"+msg.GetMessageKey())
+			if msg.IsStopped() != false {
+				t.Fatalf("first middleware IsStopped = %v, want false", msg.IsStopped())
+			}
+			msg.Next()
+			if msg.GetExecution() != nil {
+				t.Fatalf("first middleware GetExecution after Next = %v, want nil", msg.GetExecution())
+			}
+			events = append(events, "first-after")
+		},
+		func(msg *kafka.Msg) {
+			events = append(events, "second-before:"+fmt.Sprint(len(msg.GetHeader())))
+			msg.Next()
+			events = append(events, "second-after")
+		},
+	)
+
+	msg := kafka.GetProducer().NewMsg("orders", []byte("paid")).
+		SetMessageKey("order-1").
+		SetHeader(map[string]interface{}{"x-request-id": "r1"})
+	mustNoError(t, msg.Publish())
+	if !reflect.DeepEqual(events, []string{"first-before:order-1", "second-before:1", "second-after", "first-after"}) {
+		t.Fatalf("middleware events = %#v, want %#v", events, []string{"first-before:order-1", "second-before:1", "second-after", "first-after"})
+	}
+	if msg.IsStopped() != false {
+		t.Fatalf("published middleware msg IsStopped = %v, want false", msg.IsStopped())
+	}
+	if msg.GetExecution() != nil {
+		t.Fatalf("published middleware msg GetExecution = %v, want nil", msg.GetExecution())
+	}
+	if countProduceRequests(broker) != 1 {
+		t.Fatalf("produce requests after continued middleware = %d, want 1", countProduceRequests(broker))
+	}
+
+	var stopEvents []string
+	kafka.InstallMiddleware(func(msg *kafka.Msg) {
+		stopEvents = append(stopEvents, "stop-before")
+		msg.Stop()
+		stopEvents = append(stopEvents, fmt.Sprintf("stopped:%v", msg.IsStopped()))
+	})
+
+	stopped := kafka.GetProducer().NewMsg("orders", []byte("blocked")).SetMessageKey("order-stop")
+	if err := stopped.Publish(); err != nil {
+		t.Fatalf("stopped Publish error = %v, want nil", err)
+	}
+	if !reflect.DeepEqual(stopEvents, []string{"stop-before", "stopped:true"}) {
+		t.Fatalf("stop middleware events = %#v, want %#v", stopEvents, []string{"stop-before", "stopped:true"})
+	}
+	if stopped.IsStopped() != true {
+		t.Fatalf("stopped msg IsStopped = %v, want true", stopped.IsStopped())
+	}
+	if stopped.GetExecution() != nil {
+		t.Fatalf("stopped msg GetExecution = %v, want nil", stopped.GetExecution())
+	}
+	if countProduceRequests(broker) != 1 {
+		t.Fatalf("produce requests after stopped middleware = %d, want 1", countProduceRequests(broker))
+	}
+}
+
+type producedRecord struct {
+	topic     string
+	partition int32
+	key       string
+	value     string
+	headers   map[string]string
+}
+
+func closeableProducer(t *testing.T) *kafka.ProducerImpl {
+	t.Helper()
+	impl, ok := kafka.GetProducer().(*kafka.ProducerImpl)
+	if !ok {
+		t.Fatalf("GetProducer concrete type = %T, want *kafka.ProducerImpl", kafka.GetProducer())
+	}
+	return impl
+}
+
+func newProducerBroker(t *testing.T, topic string) *sarama.MockBroker {
+	t.Helper()
+	broker := sarama.NewMockBroker(t, 1)
+	broker.SetHandlerByMap(map[string]sarama.MockResponse{
+		"ApiVersionsRequest": sarama.NewMockApiVersionsResponse(t),
+		"MetadataRequest": sarama.NewMockMetadataResponse(t).
+			SetBroker(broker.Addr(), broker.BrokerID()).
+			SetLeader(topic, 0, broker.BrokerID()),
+		"ProduceRequest": sarama.NewMockProduceResponse(t).
+			SetVersion(7).
+			SetError(topic, 0, sarama.ErrNoError),
+	})
+	return broker
+}
+
+func onlyProducedRecord(t *testing.T, broker *sarama.MockBroker, topic string) producedRecord {
+	t.Helper()
+	records := producedRecords(t, broker)
+	var matches []producedRecord
+	for _, record := range records {
+		if record.topic == topic {
+			matches = append(matches, record)
+		}
+	}
+	if len(matches) != 1 {
+		t.Fatalf("produced records for %q = %d (%#v), want 1", topic, len(matches), matches)
+	}
+	return matches[0]
+}
+
+func countProduceRequests(broker *sarama.MockBroker) int {
+	count := 0
+	for _, exchange := range broker.History() {
+		if _, ok := exchange.Request.(*sarama.ProduceRequest); ok {
+			count++
+		}
+	}
+	return count
+}
+
+func producedRecords(t *testing.T, broker *sarama.MockBroker) []producedRecord {
+	t.Helper()
+	var out []producedRecord
+	for _, exchange := range broker.History() {
+		req, ok := exchange.Request.(*sarama.ProduceRequest)
+		if !ok {
+			continue
+		}
+		for topic, partitions := range produceRequestRecords(req) {
+			for partition, records := range partitions {
+				if records.RecordBatch != nil {
+					for _, record := range records.RecordBatch.Records {
+						out = append(out, producedRecord{
+							topic:     topic,
+							partition: partition,
+							key:       string(record.Key),
+							value:     string(record.Value),
+							headers:   recordHeaders(record.Headers),
+						})
+					}
+					continue
+				}
+				if records.MsgSet != nil {
+					for _, block := range records.MsgSet.Messages {
+						for _, msgBlock := range block.Messages() {
+							out = append(out, producedRecord{
+								topic:     topic,
+								partition: partition,
+								key:       string(msgBlock.Msg.Key),
+								value:     string(msgBlock.Msg.Value),
+								headers:   map[string]string{},
+							})
+						}
+					}
+				}
+			}
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].topic != out[j].topic {
+			return out[i].topic < out[j].topic
+		}
+		if out[i].partition != out[j].partition {
+			return out[i].partition < out[j].partition
+		}
+		return out[i].key < out[j].key
+	})
+	return out
+}
+
+func produceRequestRecords(req *sarama.ProduceRequest) map[string]map[int32]sarama.Records {
+	value := reflect.ValueOf(req).Elem().FieldByName("records")
+	return reflect.NewAt(value.Type(), unsafe.Pointer(value.UnsafeAddr())).
+		Elem().
+		Interface().(map[string]map[int32]sarama.Records)
+}
+
+func recordHeaders(headers []*sarama.RecordHeader) map[string]string {
+	out := make(map[string]string, len(headers))
+	for _, header := range headers {
+		out[string(header.Key)] = string(header.Value)
+	}
+	return out
+}
+
+func countFDs(t *testing.T) int {
+	t.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		t.Fatalf("read /proc/self/fd: %v", err)
+	}
+	return len(entries)
+}
+
+func mustNoError(t *testing.T, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
