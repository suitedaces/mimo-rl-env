+func TestKafkaProducerPublishBeforeInitializedReturnsSpecificError(t *testing.T) {
+
+
+
+
+	impl := closeableProducer(t)
+	mustNoError(t, impl.Close())
+
+	msg := kafka.GetProducer().NewMsg("orders", []byte("paid"))
+	err := msg.Publish()
+	if err == nil {
+		t.Fatal("Publish before initialized error = nil, want producer is not initialized")
+	}
+	if err.Error() != "producer is not initialized" {
+		t.Fatalf("Publish before initialized error = %q, want %q", err.Error(), "producer is not initialized")
+	}
+	if msg.GetExecution() == nil {
+		t.Fatal("GetExecution after failed Publish = nil, want producer is not initialized error")
+	}
+	if msg.GetExecution().Error() != "producer is not initialized" {
+		t.Fatalf("GetExecution after failed Publish = %q, want %q", msg.GetExecution().Error(), "producer is not initialized")
+	}
+}
