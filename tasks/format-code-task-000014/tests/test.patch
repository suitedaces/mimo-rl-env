+func TestKafkaProducerCloseReleasesResourcesAcrossCycles(t *testing.T) {
+
+
+
+
+	impl := closeableProducer(t)
+	mustNoError(t, impl.Close())
+
+	broker := newProducerBroker(t, "orders")
+	defer broker.Close()
+	defer impl.Close()
+
+	runtime.GC()
+	baseFDs := countFDs(t)
+	baseGoroutines := runtime.NumGoroutine()
+
+	for i := 0; i < 120; i++ {
+		cfg := sarama.NewConfig()
+		cfg.Version = sarama.V2_1_0_0
+		kafka.GetProducer().Start([]string{broker.Addr()}, cfg)
+		mustNoError(t, kafka.GetProducer().Restart())
+		msg := kafka.GetProducer().NewMsg("orders", []byte("paid")).SetMessageKey(fmt.Sprintf("order-%d", i))
+		mustNoError(t, msg.Publish())
+		mustNoError(t, impl.Close())
+	}
+
+	runtime.GC()
+	afterFDs := countFDs(t)
+	afterGoroutines := runtime.NumGoroutine()
+
+	if afterFDs > baseFDs+30 {
+		t.Fatalf("fd count after 120 producer cycles = %d, want <= %d", afterFDs, baseFDs+30)
+	}
+
+	if afterGoroutines > baseGoroutines+30 {
+		t.Fatalf("goroutines after 120 producer cycles = %d, want <= %d", afterGoroutines, baseGoroutines+30)
+	}
+}
