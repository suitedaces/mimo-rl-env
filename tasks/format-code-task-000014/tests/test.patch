+func TestKafkaProducerStartNewMsgAndPublishSession(t *testing.T) {
+
+
+
+
+	impl := closeableProducer(t)
+	mustNoError(t, impl.Close())
+
+	broker := newProducerBroker(t, "orders")
+	defer broker.Close()
+	defer impl.Close()
+
+	cfg := sarama.NewConfig()
+	cfg.Version = sarama.V2_1_0_0
+	cfg.Producer.RequiredAcks = sarama.WaitForLocal
+	cfg.Producer.Return.Errors = false
+	cfg.Producer.Return.Successes = false
+	if cfg.Producer.Return.Errors != false {
+		t.Fatalf("fresh cfg Return.Errors = %v, want false", cfg.Producer.Return.Errors)
+	}
+	if cfg.Producer.Return.Successes != false {
+		t.Fatalf("fresh cfg Return.Successes = %v, want false", cfg.Producer.Return.Successes)
+	}
+
+	producer := kafka.GetProducer()
+	producer.Start([]string{broker.Addr()}, cfg)
+	if cfg.Producer.Return.Errors != true {
+		t.Fatalf("after Start Return.Errors = %v, want true", cfg.Producer.Return.Errors)
+	}
+	if cfg.Producer.Return.Successes != true {
+		t.Fatalf("after Start Return.Successes = %v, want true", cfg.Producer.Return.Successes)
+	}
+	mustNoError(t, producer.Restart())
+
+	msg := producer.NewMsg("orders", []byte("paid"))
+
+	if msg == nil {
+		t.Fatal("NewMsg returned nil")
+	}
+	if msg.GetMessageKey() != "" {
+		t.Fatalf("fresh msg key = %q, want empty string", msg.GetMessageKey())
+	}
+
+	if len(msg.GetHeader()) != 0 {
+		t.Fatalf("fresh msg headers = %#v, want no headers", msg.GetHeader())
+	}
+
+	headerReturn := msg.SetMessageKey("order-1").
+		SetHeader(map[string]interface{}{"x-request-id": "r1"}).
+		SetHeader(map[string]interface{}{"attempt": 2})
+
+	if headerReturn == nil {
+		t.Fatal("SetHeader chain returned nil")
+	}
+	msg = headerReturn
+	if msg.GetMessageKey() != "order-1" {
+		t.Fatalf("after SetMessageKey key = %q, want %q", msg.GetMessageKey(), "order-1")
+	}
+	if got := fmt.Sprint(msg.GetHeader()["x-request-id"]); got != "r1" {
+		t.Fatalf("header x-request-id = %q, want %q", got, "r1")
+	}
+	if got := fmt.Sprint(msg.GetHeader()["attempt"]); got != "2" {
+		t.Fatalf("header attempt = %q, want %q", got, "2")
+	}
+
+	mustNoError(t, msg.Publish())
+	sent := onlyProducedRecord(t, broker, "orders")
+	if sent.topic != "orders" {
+		t.Fatalf("produced topic = %q, want %q", sent.topic, "orders")
+	}
+
+	if sent.partition < 0 {
+		t.Fatalf("produced partition = %d, want a valid non-negative partition", sent.partition)
+	}
+	if sent.key != "order-1" {
+		t.Fatalf("produced key = %q, want %q", sent.key, "order-1")
+	}
+	if sent.value != "paid" {
+		t.Fatalf("produced value = %q, want %q", sent.value, "paid")
+	}
+	if !reflect.DeepEqual(sent.headers, map[string]string{"attempt": "2", "x-request-id": "r1"}) {
+		t.Fatalf("produced headers = %#v, want %#v", sent.headers, map[string]string{"attempt": "2", "x-request-id": "r1"})
+	}
+	if msg.GetExecution() != nil {
+		t.Fatalf("after successful Publish execution = %v, want nil", msg.GetExecution())
+	}
+}
