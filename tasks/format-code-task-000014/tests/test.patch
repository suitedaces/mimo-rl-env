+func TestKafkaMessagesKeepIndependentState(t *testing.T) {
+
+
+
+
+	a := kafka.GetProducer().NewMsg("orders", []byte("paid"))
+	b := kafka.GetProducer().NewMsg("orders", []byte("refunded"))
+
+	a.SetMessageKey("order-1").SetHeader(map[string]interface{}{"x-request-id": "r1"})
+	if a.GetMessageKey() != "order-1" {
+		t.Fatalf("message a key = %q, want %q", a.GetMessageKey(), "order-1")
+	}
+	if got := fmt.Sprint(a.GetHeader()["x-request-id"]); got != "r1" {
+		t.Fatalf("message a header x-request-id = %q, want %q", got, "r1")
+	}
+	if b.GetMessageKey() != "" {
+		t.Fatalf("message b key = %q, want empty string", b.GetMessageKey())
+	}
+
+	if len(b.GetHeader()) != 0 {
+		t.Fatalf("message b headers = %#v, want no headers", b.GetHeader())
+	}
+
+	b.SetMessageKey("order-2").SetHeader(map[string]interface{}{"x-request-id": "r2", "attempt": 1})
+	if a.GetMessageKey() != "order-1" {
+		t.Fatalf("message a key after mutating b = %q, want %q", a.GetMessageKey(), "order-1")
+	}
+	if fmt.Sprint(a.GetHeader()["x-request-id"]) != "r1" {
+		t.Fatalf("message a x-request-id after mutating b = %q, want %q", fmt.Sprint(a.GetHeader()["x-request-id"]), "r1")
+	}
+	if b.GetMessageKey() != "order-2" {
+		t.Fatalf("message b key = %q, want %q", b.GetMessageKey(), "order-2")
+	}
+	if fmt.Sprint(b.GetHeader()["x-request-id"]) != "r2" {
+		t.Fatalf("message b x-request-id = %q, want %q", fmt.Sprint(b.GetHeader()["x-request-id"]), "r2")
+	}
+	if fmt.Sprint(b.GetHeader()["attempt"]) != "1" {
+		t.Fatalf("message b attempt = %q, want %q", fmt.Sprint(b.GetHeader()["attempt"]), "1")
+	}
+}
