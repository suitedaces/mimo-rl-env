+func TestKafkaProducerGeneratedMessageKeySession(t *testing.T) {
+
+
+
+
+	impl := closeableProducer(t)
+	mustNoError(t, impl.Close())
+
+	broker := newProducerBroker(t, "orders")
+	defer broker.Close()
+	defer impl.Close()
+
+	cfg := sarama.NewConfig()
+	cfg.Version = sarama.V2_1_0_0
+	kafka.GetProducer().Start([]string{broker.Addr()}, cfg)
+	mustNoError(t, kafka.GetProducer().Restart())
+
+	msg := kafka.GetProducer().NewMsg("orders", []byte("paid"))
+	if msg.GetMessageKey() != "" {
+		t.Fatalf("fresh generated-key msg key = %q, want empty string", msg.GetMessageKey())
+	}
+	mustNoError(t, msg.Publish())
+
+	sent := onlyProducedRecord(t, broker, "orders")
+
+	generated := sent.key
+	if len(generated) != 32 {
+		t.Fatalf("generated key length = %d, want 32", len(generated))
+	}
+	if strings.Contains(generated, "-") != false {
+		t.Fatalf("generated key contains dash = %v, want false", strings.Contains(generated, "-"))
+	}
+	if generated != strings.ToUpper(generated) {
+		t.Fatalf("generated key = %q, want uppercase", generated)
+	}
+	if sent.value != "paid" {
+		t.Fatalf("produced generated-key value = %q, want %q", sent.value, "paid")
+	}
+}
