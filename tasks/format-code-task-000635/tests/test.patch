+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+export PIP_NO_INDEX=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+python -m pip install --no-index --no-deps --no-build-isolation -e . >/dev/null 2>&1 || true
+
+exec python -m pytest /workspace/repo/usercase-test-coderl/test_canvas_chunks.py -v
