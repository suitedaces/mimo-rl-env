--- /dev/null
+++ b/usercase-test-coderl/test_quantile_forecast_quantile.py
@@ -0,0 +1,266 @@
+import json
+import os
+import socket
+import subprocess
+import sys
+from copy import deepcopy
+
+import numpy as np
+import pandas as pd
+
+from gluonts.model import QuantileForecast
+
+
+
+
+
+START = pd.Period("2026-01-01", freq="D")
+
+
+def base_forecast() -> QuantileForecast:
+    return QuantileForecast(
+        forecast_arrays=np.array(
+            [[1.0, 2.0], [10.0, 20.0], [100.0, 200.0]]
+        ),
+        forecast_keys=["0.1", "0.5", "0.9"],
+        start_date=START,
+    )
+
+
+def assert_array_equal_with_nan(actual: np.ndarray, expected: np.ndarray) -> None:
+    assert type(actual) is np.ndarray
+    np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
+
+
+def test_float_median_returns_stored_array_aligned_to_horizon():
+
+
+
+
+    actual = base_forecast().quantile(0.5)
+
+    assert_array_equal_with_nan(actual, np.array([10.0, 20.0]))
+
+
+def test_p_style_median_string_normalizes_to_stored_array():
+
+
+
+
+    actual = base_forecast().quantile("p50")
+
+    assert_array_equal_with_nan(actual, np.array([10.0, 20.0]))
+
+
+def test_numeric_string_decile_returns_stored_array():
+
+
+
+
+    actual = base_forecast().quantile("0.1")
+
+    assert_array_equal_with_nan(actual, np.array([1.0, 2.0]))
+
+
+def test_equivalent_numeric_string_for_stored_right_decile_returns_array():
+
+
+
+
+    actual = base_forecast().quantile("0.90")
+
+    assert_array_equal_with_nan(actual, np.array([100.0, 200.0]))
+
+
+def test_missing_quantile_inside_stored_range_interpolates_linearly():
+
+
+
+
+    actual = base_forecast().quantile(0.75)
+
+    assert_array_equal_with_nan(actual, np.array([66.25, 132.5]))
+
+
+def test_missing_quantile_in_effective_left_tail_extrapolates():
+
+
+
+
+    actual = base_forecast().quantile(0.05)
+
+
+    assert type(actual) is np.ndarray
+    assert actual.shape == (2,)
+    assert np.all(np.isfinite(actual))
+    assert np.all(actual < np.array([1.0, 2.0]))
+    linear_tail = np.array([1.0, 2.0]) + (0.05 - 0.1) / (0.5 - 0.1) * (
+        np.array([10.0, 20.0]) - np.array([1.0, 2.0])
+    )
+    assert not np.allclose(actual, linear_tail, rtol=1e-12, atol=1e-12)
+
+
+def test_missing_quantile_in_effective_right_tail_extrapolates():
+
+
+
+
+    actual = base_forecast().quantile(0.95)
+
+
+    assert type(actual) is np.ndarray
+    assert actual.shape == (2,)
+    assert np.all(np.isfinite(actual))
+    assert np.all(actual > np.array([100.0, 200.0]))
+    linear_tail = np.array([100.0, 200.0]) + (0.95 - 0.9) / (0.9 - 0.5) * (
+        np.array([100.0, 200.0]) - np.array([10.0, 20.0])
+    )
+    assert not np.allclose(actual, linear_tail, rtol=1e-12, atol=1e-12)
+
+
+def test_single_stored_quantile_missing_request_returns_nan_per_step():
+
+
+
+
+    forecast = QuantileForecast(
+        forecast_arrays=np.array([[5.0, 6.0, 7.0]]),
+        forecast_keys=["0.5"],
+        start_date=START,
+    )
+
+    actual = forecast.quantile("p90")
+
+    assert_array_equal_with_nan(actual, np.array([np.nan, np.nan, np.nan]))
+
+
+def test_single_stored_quantile_present_request_still_returns_value():
+
+
+
+
+    forecast = QuantileForecast(
+        forecast_arrays=np.array([[5.0, 6.0, 7.0]]),
+        forecast_keys=["0.5"],
+        start_date=START,
+    )
+
+    actual = forecast.quantile("p50")
+
+    assert_array_equal_with_nan(actual, np.array([5.0, 6.0, 7.0]))
+
+
+def test_only_mean_array_missing_quantile_returns_nan_per_step():
+
+
+
+
+    forecast = QuantileForecast(
+        forecast_arrays=np.array([[11.0, 12.0, 13.0]]),
+        forecast_keys=["mean"],
+        start_date=START,
+    )
+
+    actual = forecast.quantile(0.5)
+
+    assert_array_equal_with_nan(actual, np.array([np.nan, np.nan, np.nan]))
+
+
+def test_mean_key_is_ignored_when_interpolating_quantiles():
+
+
+
+
+    forecast = QuantileForecast(
+        forecast_arrays=np.array(
+            [[7.0, 8.0, 9.0], [1.0, 2.0, 3.0], [10.0, 20.0, 30.0]]
+        ),
+        forecast_keys=["mean", "0.25", "0.75"],
+        start_date=START,
+    )
+
+    actual = forecast.quantile(0.5)
+
+    assert_array_equal_with_nan(actual, np.array([5.5, 11.0, 16.5]))
+
+
+def test_valid_quantile_string_is_parsed_by_level():
+
+
+
+
+
+    actual = base_forecast().quantile("p50")
+
+    assert_array_equal_with_nan(actual, np.array([10.0, 20.0]))
+
+
+def test_referential_transparency_same_call_returns_equal_arrays():
+    forecast = base_forecast()
+
+    assert_array_equal_with_nan(forecast.quantile(0.75), forecast.quantile(0.75))
+
+
+def test_quantile_does_not_mutate_forecast_arrays():
+    source_arrays = np.array(
+        [[1.0, 2.0], [10.0, 20.0], [100.0, 200.0]]
+    )
+    expected_source_arrays = deepcopy(source_arrays)
+    forecast = QuantileForecast(
+        forecast_arrays=source_arrays,
+        forecast_keys=["0.1", "0.5", "0.9"],
+        start_date=START,
+    )
+    expected_forecast_arrays = deepcopy(forecast.forecast_array)
+
+    forecast.quantile(0.75)
+
+    assert_array_equal_with_nan(source_arrays, expected_source_arrays)
+    assert_array_equal_with_nan(forecast.forecast_array, expected_forecast_arrays)
+
+
+def test_quantile_result_matches_fresh_process_result():
+    in_process = base_forecast().quantile(0.95).tolist()
+    script = """
+import json
+import sys
+sys.path.insert(0, "/workspace/repo/src")
+import numpy as np
+import pandas as pd
+from gluonts.model import QuantileForecast
+forecast = QuantileForecast(
+    forecast_arrays=np.array([[1.0, 2.0], [10.0, 20.0], [100.0, 200.0]]),
+    forecast_keys=["0.1", "0.5", "0.9"],
+    start_date=pd.Period("2026-01-01", freq="D"),
+)
+sys.stdout.write(json.dumps(forecast.quantile(0.95).tolist()))
+"""
+
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+
+    np.testing.assert_allclose(
+        np.array(in_process),
+        np.array(json.loads(completed.stdout)),
+        rtol=1e-12,
+        atol=1e-12,
+    )
+
+
+def test_quantile_does_not_write_cwd_or_open_network(monkeypatch, tmp_path):
+    def deny_socket(*args, **kwargs):
+        raise AssertionError("QuantileForecast.quantile attempted network IO")
+
+    monkeypatch.setattr(socket, "socket", deny_socket)
+    monkeypatch.chdir(tmp_path)
+    before = sorted(os.listdir(tmp_path))
+
+    actual = base_forecast().quantile(0.75)
+
+    assert_array_equal_with_nan(actual, np.array([66.25, 132.5]))
+    assert sorted(os.listdir(tmp_path)) == before
