+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+export PATH=/opt/go-1.16/bin:$PATH
+unset GOROOT || true
+export GOFLAGS=-mod=vendor
+
+
+
+
+go test -count=1 ./pkg/apis/extensions/validation/
