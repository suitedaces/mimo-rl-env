@@ -0,0 +1,235 @@
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+package validation_test
+
+import (
+	extensionsv1alpha1 "github.com/gardener/gardener/pkg/apis/extensions/v1alpha1"
+	. "github.com/gardener/gardener/pkg/apis/extensions/validation"
+
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+	. "github.com/onsi/gomega/gstruct"
+	corev1 "k8s.io/api/core/v1"
+	networkingv1 "k8s.io/api/networking/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/util/validation/field"
+)
+
+var _ = Describe("Bastion validation tests", func() {
+	var bastion *extensionsv1alpha1.Bastion
+
+	BeforeEach(func() {
+		bastion = &extensionsv1alpha1.Bastion{
+			ObjectMeta: metav1.ObjectMeta{
+				Name:      "test-bastion",
+				Namespace: "test-namespace",
+			},
+			Spec: extensionsv1alpha1.BastionSpec{
+				DefaultSpec: extensionsv1alpha1.DefaultSpec{
+					Type: "aws",
+				},
+				UserData: []byte("foobar"),
+				Ingress: []extensionsv1alpha1.BastionIngressPolicy{
+					{
+						IPBlock: networkingv1.IPBlock{
+							CIDR: "1.2.3.4/8",
+						},
+					},
+				},
+			},
+			Status: extensionsv1alpha1.BastionStatus{
+				Ingress: corev1.LoadBalancerIngress{
+					IP: "5.6.7.8",
+				},
+			},
+		}
+	})
+
+	Describe("#ValidateBastion", func() {
+		It("should allow valid bastion resources", func() {
+			Expect(ValidateBastion(bastion)).To(BeEmpty())
+		})
+
+		It("should forbid empty Bastion resources", func() {
+			errorList := ValidateBastion(&extensionsv1alpha1.Bastion{})
+
+			Expect(errorList).To(ConsistOf(
+				PointTo(MatchFields(IgnoreExtras, Fields{
+					"Type":  Equal(field.ErrorTypeRequired),
+					"Field": Equal("metadata.name"),
+				})),
+				PointTo(MatchFields(IgnoreExtras, Fields{
+					"Type":  Equal(field.ErrorTypeRequired),
+					"Field": Equal("metadata.namespace"),
+				})),
+				PointTo(MatchFields(IgnoreExtras, Fields{
+					"Type":  Equal(field.ErrorTypeRequired),
+					"Field": Equal("spec.type"),
+				})),
+				PointTo(MatchFields(IgnoreExtras, Fields{
+					"Type":  Equal(field.ErrorTypeRequired),
+					"Field": Equal("spec.userData"),
+				})),
+				PointTo(MatchFields(IgnoreExtras, Fields{
+					"Type":  Equal(field.ErrorTypeRequired),
+					"Field": Equal("spec.ingress"),
+				})),
+			))
+		})
+
+		It("should require a non-empty user data", func() {
+			bastion.Spec.UserData = []byte{}
+
+			Expect(ValidateBastion(bastion)).To(ConsistOf(PointTo(MatchFields(IgnoreExtras, Fields{
+				"Type":  Equal(field.ErrorTypeRequired),
+				"Field": Equal("spec.userData"),
+			}))))
+		})
+
+		It("should require at least one ingress policy", func() {
+			bastion.Spec.Ingress = nil
+
+			Expect(ValidateBastion(bastion)).To(ConsistOf(PointTo(MatchFields(IgnoreExtras, Fields{
+				"Type":  Equal(field.ErrorTypeRequired),
+				"Field": Equal("spec.ingress"),
+			}))))
+		})
+
+		It("should require a CIDR for each ingress policy", func() {
+			bastion.Spec.Ingress[0].IPBlock.CIDR = ""
+
+			Expect(ValidateBastion(bastion)).To(ConsistOf(PointTo(MatchFields(IgnoreExtras, Fields{
+				"Type":  Equal(field.ErrorTypeRequired),
+				"Field": Equal("spec.ingress[0].ipBlock.cidr"),
+			}))))
+		})
+
+		It("should reject an invalid CIDR", func() {
+			bastion.Spec.Ingress[0].IPBlock.CIDR = "not-a-cidr"
+
+			Expect(ValidateBastion(bastion)).To(ConsistOf(PointTo(MatchFields(IgnoreExtras, Fields{
+				"Type":  Equal(field.ErrorTypeInvalid),
+				"Field": Equal("spec.ingress[0].ipBlock.cidr"),
+			}))))
+		})
+
+		It("should report the correct index of a faulty ingress policy", func() {
+			bastion.Spec.Ingress = append(bastion.Spec.Ingress, extensionsv1alpha1.BastionIngressPolicy{
+				IPBlock: networkingv1.IPBlock{
+					CIDR: "garbage",
+				},
+			})
+
+			Expect(ValidateBastion(bastion)).To(ConsistOf(PointTo(MatchFields(IgnoreExtras, Fields{
+				"Type":  Equal(field.ErrorTypeInvalid),
+				"Field": Equal("spec.ingress[1].ipBlock.cidr"),
+			}))))
+		})
+
+		It("should reject an unparseable except entry", func() {
+			bastion.Spec.Ingress[0].IPBlock.CIDR = "10.250.0.0/16"
+			bastion.Spec.Ingress[0].IPBlock.Except = []string{"nonsense"}
+
+			Expect(ValidateBastion(bastion)).To(ConsistOf(PointTo(MatchFields(IgnoreExtras, Fields{
+				"Type":  Equal(field.ErrorTypeInvalid),
+				"Field": Equal("spec.ingress[0].ipBlock.except[0]"),
+			}))))
+		})
+
+		It("should reject an except entry outside the CIDR range", func() {
+			bastion.Spec.Ingress[0].IPBlock.CIDR = "10.250.0.0/16"
+			bastion.Spec.Ingress[0].IPBlock.Except = []string{"10.241.0.0/24"}
+
+			Expect(ValidateBastion(bastion)).To(ConsistOf(PointTo(MatchFields(IgnoreExtras, Fields{
+				"Type":  Equal(field.ErrorTypeInvalid),
+				"Field": Equal("spec.ingress[0].ipBlock.except[0]"),
+			}))))
+		})
+
+		It("should allow an except entry within the CIDR range", func() {
+			bastion.Spec.Ingress[0].IPBlock.CIDR = "10.250.0.0/16"
+			bastion.Spec.Ingress[0].IPBlock.Except = []string{"10.250.1.0/24"}
+
+			Expect(ValidateBastion(bastion)).To(BeEmpty())
+		})
+	})
+
+	Describe("#ValidateBastionUpdate", func() {
+		It("should allow updating the ingress", func() {
+			newBastion := prepareBastionForUpdate(bastion)
+			newBastion.Spec.Ingress[0].IPBlock.CIDR = "9.10.11.12/8"
+
+			Expect(ValidateBastionUpdate(newBastion, bastion)).To(BeEmpty())
+		})
+
+		It("should forbid changing the type", func() {
+			newBastion := prepareBastionForUpdate(bastion)
+			newBastion.Spec.Type = "gcp"
+
+			Expect(ValidateBastionUpdate(newBastion, bastion)).To(ConsistOf(PointTo(MatchFields(IgnoreExtras, Fields{
+				"Type":  Equal(field.ErrorTypeInvalid),
+				"Field": Equal("spec.type"),
+			}))))
+		})
+
+		It("should forbid changing the user data", func() {
+			newBastion := prepareBastionForUpdate(bastion)
+			newBastion.Spec.UserData = []byte("changed")
+
+			Expect(ValidateBastionUpdate(newBastion, bastion)).To(ConsistOf(PointTo(MatchFields(IgnoreExtras, Fields{
+				"Type":  Equal(field.ErrorTypeInvalid),
+				"Field": Equal("spec.userData"),
+			}))))
+		})
+
+		It("should prevent updating anything if the deletion timestamp is set", func() {
+			now := metav1.Now()
+			bastion.DeletionTimestamp = &now
+
+			newBastion := prepareBastionForUpdate(bastion)
+			newBastion.DeletionTimestamp = &now
+			newBastion.Spec.Ingress[0].IPBlock.CIDR = "9.10.11.12/8"
+
+			Expect(ValidateBastionUpdate(newBastion, bastion)).To(ConsistOf(PointTo(MatchFields(IgnoreExtras, Fields{
+				"Type":  Equal(field.ErrorTypeInvalid),
+				"Field": Equal("spec"),
+			}))))
+		})
+	})
+
+	Describe("Bastion API type", func() {
+		It("should be registered in the v1alpha1 scheme", func() {
+			scheme := runtime.NewScheme()
+			Expect(extensionsv1alpha1.AddToScheme(scheme)).To(Succeed())
+
+			gvks, _, err := scheme.ObjectKinds(&extensionsv1alpha1.Bastion{})
+			Expect(err).NotTo(HaveOccurred())
+			Expect(gvks).To(ContainElement(extensionsv1alpha1.SchemeGroupVersion.WithKind("Bastion")))
+		})
+
+		It("should expose its spec and status as an extension object", func() {
+			var obj extensionsv1alpha1.Object = bastion
+			Expect(obj.GetExtensionSpec().GetExtensionType()).To(Equal("aws"))
+			Expect(obj.GetExtensionStatus()).NotTo(BeNil())
+		})
+	})
+})
+
+func prepareBastionForUpdate(obj *extensionsv1alpha1.Bastion) *extensionsv1alpha1.Bastion {
+	newObj := obj.DeepCopy()
+	newObj.ResourceVersion = "1"
+	return newObj
+}
