+"use strict";
+
+const prettier = require("prettier/local");
+
+function fmt(text, options) {
+  return prettier.format(
+    text,
+    Object.assign({ parser: "mdx" }, options || {})
+  );
+}
+
+describe("mdx parser: HTML/React components in table cells and headings", () => {
+  test("HTML element in a table cell stays inline on a single line", () => {
+    const input =
+      "| Column 1 | Column 2 |\n" +
+      "|---|---|\n" +
+      "| Text | <strong>Text</strong> |\n";
+    const output = fmt(input);
+
+    expect(output).toContain("<strong>Text</strong>");
+    expect(output).not.toMatch(/<strong>Text\s*\n\s*\n\s*<\/strong>/);
+  });
+
+  test("React component in a table cell stays inline on a single line", () => {
+    const input =
+      "| Column 1 | Column 2 |\n" +
+      "|---|---|\n" +
+      "| Text | <Bold>Text</Bold> |\n";
+    const output = fmt(input);
+    expect(output).toContain("<Bold>Text</Bold>");
+    expect(output).not.toMatch(/<Bold>Text\s*\n\s*\n\s*<\/Bold>/);
+  });
+
+  test("HTML element in a heading stays inline on a single line", () => {
+    const input = "## <strong>Hello</strong>\n";
+    const output = fmt(input);
+    expect(output).toContain("## <strong>Hello</strong>");
+    expect(output).not.toMatch(/<strong>Hello\s*\n\s*\n\s*<\/strong>/);
+  });
+
+  test("React component in a heading stays inline on a single line", () => {
+    const input = "## <Bold>Hello</Bold>\n";
+    const output = fmt(input);
+    expect(output).toContain("## <Bold>Hello</Bold>");
+    expect(output).not.toMatch(/<Bold>Hello\s*\n\s*\n\s*<\/Bold>/);
+  });
+
+  test("HTML element in a paragraph remains inline (preservation)", () => {
+    const input = "See <strong>here</strong> for info\n";
+    const output = fmt(input);
+    expect(output).toContain("See <strong>here</strong> for info");
+  });
+
+  test("Block-level HTML element is preserved as a block", () => {
+    const input = "<strong>block</strong>\n";
+    const output = fmt(input);
+
+    expect(output).toContain("<strong>block</strong>");
+    expect(output).not.toMatch(/<strong>block\s*\n\s*\n\s*<\/strong>/);
+  });
+
+  test("Full issue reproduction: mdx with tables containing HTML and components does not produce broken multi-line tags", () => {
+    const input =
+      "export const Bold = ({children}) =>\n" +
+      "\t<strong>{children}</strong>\n" +
+      "\n" +
+      "## MDX table with HTML\n" +
+      "\n" +
+      "| Column 1 | Column 2 |\n" +
+      "|---|---|\n" +
+      "| Text | <strong>Text</strong> |\n" +
+      "\n" +
+      "## MDX table with React component\n" +
+      "\n" +
+      "| Column 1 | Column 2 |\n" +
+      "|---|---|\n" +
+      "| Text | <Bold>Text</Bold> |\n";
+    const output = fmt(input, { semi: false, singleQuote: true });
+    expect(output).toContain("<strong>Text</strong>");
+    expect(output).toContain("<Bold>Text</Bold>");
+
+
+    expect(output).not.toMatch(/<strong>Text\s*\n\s*\n/);
+    expect(output).not.toMatch(/<Bold>Text\s*\n\s*\n/);
+  });
+
+  test("Output is idempotent: re-formatting the formatted output yields the same result", () => {
+    const input =
+      "## MDX table with HTML\n" +
+      "\n" +
+      "| Column 1 | Column 2 |\n" +
+      "|---|---|\n" +
+      "| Text | <strong>Text</strong> |\n";
+    const first = fmt(input);
+    const second = fmt(first);
+    expect(second).toBe(first);
+  });
+
+  test("Plain mdx table without HTML is unaffected", () => {
+    const input =
+      "| Column 1 | Column 2 |\n" + "|---|---|\n" + "| Text | Text |\n";
+    const output = fmt(input);
+    expect(output).toContain("| Text     | Text     |");
+  });
+});
