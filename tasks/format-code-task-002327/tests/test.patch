+const prettier = require("./tests_config/require_prettier");
+const cases = [
+  { name: "table-html", input: "| A | B |\n|---|---|\n| Text | <strong>Text</strong> |\n" },
+  { name: "table-jsx", input: "| A | B |\n|---|---|\n| Text | <Bold>Text</Bold> |\n" },
+  { name: "heading-html", input: "## <strong>Hello</strong>\n" },
+  { name: "heading-jsx", input: "## <Bold>Hello</Bold>\n" },
+  { name: "paragraph-html", input: "See <strong>Text</strong> in text\n" },
+  { name: "block-html", input: "<strong>block</strong>\n" },
+];
+for (const c of cases) {
+  try {
+    const out = prettier.format(c.input, { parser: "mdx" });
+    console.log(c.name, "=>", JSON.stringify(out));
+  } catch(e) { console.log(c.name, "ERROR:", e.message); }
+}
