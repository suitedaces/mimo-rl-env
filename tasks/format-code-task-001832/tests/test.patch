--- /dev/null
+++ b/usercase-test-coderl/test_rename_acceptance.py
@@ -0,0 +1,273 @@
+
+
+
+
+
+
+import builtins
+import json
+import pathlib
+import re
+import socket
+import subprocess
+import sys
+import textwrap
+
+import pandas as pd
+import pytest
+from sqlalchemy import create_engine
+
+from siuba import _, group_by, rename
+from siuba.sql import LazyTbl
+
+
+def _base_df():
+    return pd.DataFrame({"a": [1], "b": [2], "c": [3]})
+
+
+def _frame_literal(df):
+    return {"columns": list(df.columns), "records": df.to_dict("records")}
+
+
+def _group_names(grouped):
+    return [grouping.name for grouping in grouped.grouper.groupings]
+
+
+def _lazy_tbl():
+    return LazyTbl(create_engine("sqlite:///:memory:"), "df", ["a", "b", "c"])
+
+
+def _lazy_literal(tbl):
+    sel = tbl.last_select
+    return {
+        "columns": [getattr(col, "key", None) for col in sel.inner_columns],
+        "group_by": list(tbl.group_by),
+        "sql": str(sel),
+    }
+
+
+def _assert_sql_labeled(sql, source, label):
+
+    label_pattern = rf'(?:["`\[])?{re.escape(label)}(?:["`\]])?'
+    assert re.search(rf"\bdf\.{re.escape(source)}\s+AS\s+{label_pattern}\b", sql, re.IGNORECASE), sql
+
+
+def test_pandas_rename_single_expression_target():
+
+
+
+
+    actual = rename(_base_df(), A=_.a)
+
+    assert _frame_literal(actual) == {
+        "columns": ["A", "b", "c"],
+        "records": [{"A": 1, "b": 2, "c": 3}],
+    }
+
+
+def test_pandas_rename_single_string_target():
+
+
+
+
+    actual = rename(_base_df(), A="a")
+
+    assert _frame_literal(actual) == {
+        "columns": ["A", "b", "c"],
+        "records": [{"A": 1, "b": 2, "c": 3}],
+    }
+
+
+def test_pandas_rename_multiple_expression_targets():
+
+
+
+
+    actual = rename(_base_df(), A=_.a, C=_.c)
+
+    assert _frame_literal(actual) == {
+        "columns": ["A", "b", "C"],
+        "records": [{"A": 1, "b": 2, "C": 3}],
+    }
+
+
+def test_pandas_rename_multiple_string_targets():
+
+
+
+
+    actual = rename(_base_df(), A="a", C="c")
+
+    assert _frame_literal(actual) == {
+        "columns": ["A", "b", "C"],
+        "records": [{"A": 1, "b": 2, "C": 3}],
+    }
+
+
+def test_grouped_pandas_rename_updates_group_key():
+
+
+
+
+    actual = rename(group_by(_base_df(), _.a), z=_.a)
+
+    assert _frame_literal(actual.obj) == {
+        "columns": ["z", "b", "c"],
+        "records": [{"z": 1, "b": 2, "c": 3}],
+    }
+    assert _group_names(actual) == ["z"]
+
+
+def test_sql_lazy_rename_single_expression_target():
+
+
+
+
+    actual = rename(_lazy_tbl(), A=_.a)
+
+    literal = _lazy_literal(actual)
+
+    assert literal["columns"] == ["A", "b", "c"]
+    assert literal["group_by"] == []
+    assert "FROM df" in literal["sql"]
+    _assert_sql_labeled(literal["sql"], "a", "A")
+
+
+def test_sql_lazy_rename_multiple_string_targets():
+
+
+
+
+    actual = rename(_lazy_tbl(), A="a", C="c")
+
+    literal = _lazy_literal(actual)
+
+    assert literal["columns"] == ["A", "b", "C"]
+    assert literal["group_by"] == []
+    assert "FROM df" in literal["sql"]
+    _assert_sql_labeled(literal["sql"], "a", "A")
+    _assert_sql_labeled(literal["sql"], "c", "C")
+
+
+def test_grouped_sql_lazy_rename_updates_group_key():
+
+
+
+
+    actual = rename(group_by(_lazy_tbl(), _.a), z=_.a)
+
+    literal = _lazy_literal(actual)
+
+    assert literal["columns"] == ["z", "b", "c"]
+    assert literal["group_by"] == ["z"]
+    assert "FROM df" in literal["sql"]
+    _assert_sql_labeled(literal["sql"], "a", "z")
+
+
+def test_pandas_invalid_non_simple_target_raises_value_error():
+
+
+
+
+
+    with pytest.raises(ValueError):
+        rename(_base_df(), z=_.a + 1)
+
+
+def test_sql_invalid_non_simple_target_raises_key_error():
+
+
+
+
+
+    with pytest.raises(KeyError):
+        rename(_lazy_tbl(), z=_.a + 1)
+
+
+def test_rename_is_referentially_transparent_for_same_input():
+    df = _base_df()
+
+    assert _frame_literal(rename(df, A=_.a, C=_.c)) == _frame_literal(rename(df, A=_.a, C=_.c))
+
+
+def test_rename_does_not_mutate_input_dataframe():
+    df = _base_df()
+    before = df.copy(deep=True)
+
+    rename(df, A=_.a, C=_.c)
+
+    pd.testing.assert_frame_equal(df, before)
+    assert _frame_literal(df) == {
+        "columns": ["a", "b", "c"],
+        "records": [{"a": 1, "b": 2, "c": 3}],
+    }
+
+
+def test_rename_matches_fresh_process_result():
+    in_process = _frame_literal(rename(_base_df(), A=_.a, C=_.c))
+    script = textwrap.dedent(
+        """
+        import json
+        import sys
+        sys.path.insert(0, "/workspace/repo")
+        import pandas as pd
+        from siuba import _, rename
+
+        df = pd.DataFrame({"a": [1], "b": [2], "c": [3]})
+        out = rename(df, A=_.a, C=_.c)
+        sys.stdout.write(json.dumps({
+            "columns": list(out.columns),
+            "records": out.to_dict("records"),
+        }, sort_keys=True))
+        """
+    )
+
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+
+    assert in_process == json.loads(completed.stdout)
+    assert in_process == {
+        "columns": ["A", "b", "C"],
+        "records": [{"A": 1, "b": 2, "C": 3}],
+    }
+
+
+def test_rename_has_no_undeclared_filesystem_or_network_side_effects(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+
+    opened_paths = []
+    real_open = builtins.open
+    real_path_open = pathlib.Path.open
+
+    def recording_open(file, mode="r", *args, **kwargs):
+        opened_paths.append((str(file), mode))
+        if any(flag in mode for flag in ("w", "a", "x", "+")):
+            raise AssertionError(f"unexpected file write via open({file!r}, {mode!r})")
+        return real_open(file, mode, *args, **kwargs)
+
+    def recording_path_open(self, mode="r", *args, **kwargs):
+        return recording_open(self, mode, *args, **kwargs)
+
+    def blocked_socket(*args, **kwargs):
+        raise AssertionError("unexpected network socket creation")
+
+    monkeypatch.setattr(builtins, "open", recording_open)
+    monkeypatch.setattr(pathlib.Path, "open", recording_path_open)
+    monkeypatch.setattr(socket, "socket", blocked_socket)
+    monkeypatch.setattr(socket, "create_connection", blocked_socket)
+
+    before = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob("*"))
+    actual = rename(_base_df(), A=_.a)
+    after = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob("*"))
+
+    assert _frame_literal(actual) == {
+        "columns": ["A", "b", "c"],
+        "records": [{"A": 1, "b": 2, "c": 3}],
+    }
+    assert before == []
+    assert after == []
+    assert opened_paths == []
