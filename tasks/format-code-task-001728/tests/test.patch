diff --git a/apis/v1beta1/validation/gateway_test.go b/apis/v1beta1/validation/gateway_test.go
index eaaafbca..05314766 100644
--- a/apis/v1beta1/validation/gateway_test.go
+++ b/apis/v1beta1/validation/gateway_test.go
@@ -20,6 +20,7 @@ import (
 	"testing"
 
 	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/validation/field"
 
 	gatewayv1b1 "sigs.k8s.io/gateway-api/apis/v1beta1"
 )
@@ -163,3 +164,298 @@ func TestValidateGateway(t *testing.T) {
 		})
 	}
 }
+
+
+func hasFieldError(errs field.ErrorList, fieldPath string) bool {
+	for _, e := range errs {
+		if e.Field == fieldPath {
+			return true
+		}
+	}
+	return false
+}
+
+
+func countFieldErrors(errs field.ErrorList, fieldPath string) int {
+	n := 0
+	for _, e := range errs {
+		if e.Field == fieldPath {
+			n++
+		}
+	}
+	return n
+}
+
+func makeGatewayWithListeners(listeners []gatewayv1b1.Listener) *gatewayv1b1.Gateway {
+	return &gatewayv1b1.Gateway{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "foo",
+			Namespace: metav1.NamespaceDefault,
+		},
+		Spec: gatewayv1b1.GatewaySpec{
+			GatewayClassName: "foo",
+			Listeners:        listeners,
+		},
+	}
+}
+
+func hostnamePtr(s string) *gatewayv1b1.Hostname {
+	h := gatewayv1b1.Hostname(s)
+	return &h
+}
+
+
+
+
+func TestValidateGatewayListenerPortProtocolHostname(t *testing.T) {
+	t.Run("two listeners same hostname different ports is valid", func(t *testing.T) {
+		gw := makeGatewayWithListeners([]gatewayv1b1.Listener{
+			{
+				Name:     "listener-1",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+			{
+				Name:     "listener-2",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     8080,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+		})
+		errs := ValidateGateway(gw)
+		if hasFieldError(errs, "spec.listeners[1]") {
+			t.Errorf("expected no combination error for differing ports, got: %v", errs)
+		}
+		if hasFieldError(errs, "spec.listeners[0]") {
+			t.Errorf("expected no combination error for differing ports, got: %v", errs)
+		}
+	})
+
+	t.Run("two listeners different hostnames same port is valid", func(t *testing.T) {
+		gw := makeGatewayWithListeners([]gatewayv1b1.Listener{
+			{
+				Name:     "listener-1",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+			{
+				Name:     "listener-2",
+				Hostname: hostnamePtr("bar.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+		})
+		errs := ValidateGateway(gw)
+		if hasFieldError(errs, "spec.listeners[1]") {
+			t.Errorf("expected no combination error for differing hostnames, got: %v", errs)
+		}
+		if hasFieldError(errs, "spec.listeners[0]") {
+			t.Errorf("expected no combination error for differing hostnames, got: %v", errs)
+		}
+	})
+
+	t.Run("two listeners same hostname port protocol produces combination error on duplicate", func(t *testing.T) {
+		gw := makeGatewayWithListeners([]gatewayv1b1.Listener{
+			{
+				Name:     "listener-1",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+			{
+				Name:     "listener-2",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+		})
+		errs := ValidateGateway(gw)
+		if !hasFieldError(errs, "spec.listeners[1]") {
+			t.Errorf("expected combination error on spec.listeners[1], got: %v", errs)
+		}
+		if hasFieldError(errs, "spec.listeners[0]") {
+			t.Errorf("did not expect combination error on spec.listeners[0], got: %v", errs)
+		}
+	})
+
+	t.Run("two listeners with nil hostnames same port produces combination error", func(t *testing.T) {
+		gw := makeGatewayWithListeners([]gatewayv1b1.Listener{
+			{
+				Name:     "listener-1",
+				Hostname: nil,
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+			{
+				Name:     "listener-2",
+				Hostname: nil,
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+		})
+		errs := ValidateGateway(gw)
+		if !hasFieldError(errs, "spec.listeners[1]") {
+			t.Errorf("expected combination error on spec.listeners[1] for nil hostname dup, got: %v", errs)
+		}
+	})
+
+	t.Run("three listeners only the duplicate produces a combination error", func(t *testing.T) {
+		gw := makeGatewayWithListeners([]gatewayv1b1.Listener{
+			{
+				Name:     "listener-1",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+			{
+				Name:     "listener-2",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+			{
+				Name:     "listener-3",
+				Hostname: hostnamePtr("bar.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+		})
+		errs := ValidateGateway(gw)
+		if !hasFieldError(errs, "spec.listeners[1]") {
+			t.Errorf("expected combination error on spec.listeners[1], got: %v", errs)
+		}
+		if hasFieldError(errs, "spec.listeners[2]") {
+			t.Errorf("did not expect combination error on spec.listeners[2], got: %v", errs)
+		}
+		if hasFieldError(errs, "spec.listeners[0]") {
+			t.Errorf("did not expect combination error on spec.listeners[0], got: %v", errs)
+		}
+	})
+
+	t.Run("three listeners with duplicate at later index reports on the later one only", func(t *testing.T) {
+		gw := makeGatewayWithListeners([]gatewayv1b1.Listener{
+			{
+				Name:     "listener-1",
+				Hostname: hostnamePtr("baz.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+			{
+				Name:     "listener-2",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+			{
+				Name:     "listener-3",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+		})
+		errs := ValidateGateway(gw)
+		if !hasFieldError(errs, "spec.listeners[2]") {
+			t.Errorf("expected combination error on spec.listeners[2], got: %v", errs)
+		}
+		if hasFieldError(errs, "spec.listeners[1]") {
+			t.Errorf("did not expect combination error on spec.listeners[1], got: %v", errs)
+		}
+		if hasFieldError(errs, "spec.listeners[0]") {
+			t.Errorf("did not expect combination error on spec.listeners[0], got: %v", errs)
+		}
+	})
+
+	t.Run("single listener does not trigger combination error", func(t *testing.T) {
+		gw := makeGatewayWithListeners([]gatewayv1b1.Listener{
+			{
+				Name:     "listener-1",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+		})
+		errs := ValidateGateway(gw)
+		if hasFieldError(errs, "spec.listeners[0]") {
+			t.Errorf("did not expect combination error on single listener, got: %v", errs)
+		}
+	})
+
+	t.Run("three distinct listeners produce no combination errors", func(t *testing.T) {
+		gw := makeGatewayWithListeners([]gatewayv1b1.Listener{
+			{
+				Name:     "listener-1",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+			{
+				Name:     "listener-2",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     8080,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+			{
+				Name:     "listener-3",
+				Hostname: hostnamePtr("bar.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+		})
+		errs := ValidateGateway(gw)
+		for _, fp := range []string{"spec.listeners[0]", "spec.listeners[1]", "spec.listeners[2]"} {
+			if hasFieldError(errs, fp) {
+				t.Errorf("did not expect combination error on %s, got: %v", fp, errs)
+			}
+		}
+	})
+
+	t.Run("two listeners with identical name and identical combination both fail validation", func(t *testing.T) {
+
+
+		gw := makeGatewayWithListeners([]gatewayv1b1.Listener{
+			{
+				Name:     "same-name",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+			{
+				Name:     "same-name",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+		})
+		errs := ValidateGateway(gw)
+		if !hasFieldError(errs, "spec.listeners[1].name") {
+			t.Errorf("expected duplicate-name error on spec.listeners[1].name, got: %v", errs)
+		}
+		if !hasFieldError(errs, "spec.listeners[1]") {
+			t.Errorf("expected combination error on spec.listeners[1] (duplicate port/protocol/hostname), got: %v", errs)
+		}
+	})
+
+	t.Run("four listeners only one combination error per duplicate index", func(t *testing.T) {
+
+		gw := makeGatewayWithListeners([]gatewayv1b1.Listener{
+			{
+				Name:     "listener-1",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+			{
+				Name:     "listener-2",
+				Hostname: hostnamePtr("foo.com"),
+				Port:     80,
+				Protocol: gatewayv1b1.HTTPProtocolType,
+			},
+		})
+		errs := ValidateGateway(gw)
+		if c := countFieldErrors(errs, "spec.listeners[1]"); c != 1 {
+			t.Errorf("expected exactly 1 combination error on spec.listeners[1], got %d: %v", c, errs)
+		}
+	})
+}
