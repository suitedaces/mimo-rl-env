diff --git a/logging/logging_test.go b/logging/logging_test.go
index 495303ed94..d042a893bc 100644
--- a/logging/logging_test.go
+++ b/logging/logging_test.go
@@ -806,3 +806,63 @@ func TestSeverityUnmarshal(t *testing.T) {
 		t.Fatalf("Severity: got %v, want %v", entry.Severity, logging.Error)
 	}
 }
+
+
+
+func TestSeverityMarshalThenUnmarshalEntry(t *testing.T) {
+	entry := logging.Entry{Payload: "test log", Severity: logging.Info}
+	j, err := json.Marshal(entry)
+	if err != nil {
+		t.Fatalf("Marshal: %v", err)
+	}
+	var entryU logging.Entry
+	if err := json.Unmarshal(j, &entryU); err != nil {
+		t.Fatalf("Unmarshal: %v", err)
+	}
+	if entryU.Severity != logging.Info {
+		t.Fatalf("Severity round-trip: got %v, want %v", entryU.Severity, logging.Info)
+	}
+}
+
+
+
+
+
+func TestSeverityUnmarshalFromNumber(t *testing.T) {
+
+
+	j := []byte(`{"severity": 200, "payload": "test"}`)
+	var entry logging.Entry
+	if err := json.Unmarshal(j, &entry); err != nil {
+		t.Fatalf("Unmarshal from numeric severity: %v", err)
+	}
+	if entry.Severity != logging.Info {
+		t.Fatalf("Severity: got %v (%d), want %v (%d)",
+			entry.Severity, int(entry.Severity), logging.Info, int(logging.Info))
+	}
+}
+
+
+
+func TestSeverityUnmarshalRawNumber(t *testing.T) {
+	var s logging.Severity
+	if err := json.Unmarshal([]byte("500"), &s); err != nil {
+		t.Fatalf("Unmarshal raw number: %v", err)
+	}
+	if s != logging.Error {
+		t.Fatalf("Severity: got %v (%d), want %v (%d)",
+			s, int(s), logging.Error, int(logging.Error))
+	}
+}
+
+
+
+func TestSeverityUnmarshalFromStringPreserved(t *testing.T) {
+	var s logging.Severity
+	if err := json.Unmarshal([]byte(`"Info"`), &s); err != nil {
+		t.Fatalf("Unmarshal from string: %v", err)
+	}
+	if s != logging.Info {
+		t.Fatalf("Severity: got %v, want %v", s, logging.Info)
+	}
+}
