+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+cd logging && go test -run 'TestSeverityMarshalThenUnmarshalEntry|TestSeverityUnmarshalFromNumber|TestSeverityUnmarshalRawNumber|TestSeverityUnmarshalFromStringPreserved|TestSeverityUnmarshal$' -count=1 -v .
+rc=$(( rc | $? ))
+exit $rc
