+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export CI="${CI:-1}"
+export NO_UPDATE_NOTIFIER=1
+export npm_config_offline=true
+export npm_config_audit=false
+export npm_config_fund=false
+
+if [ ! -x /workspace/repo/node_modules/.bin/jest ]; then
+  echo "Required local Jest install is missing at /workspace/repo/node_modules/.bin/jest" >&2
+  exit 1
+fi
+
+JEST_CONFIG='{
+  "rootDir": "/workspace/repo",
+  "testEnvironment": "node",
+  "moduleFileExtensions": ["js", "jsx", "ts", "tsx", "json", "node"],
+  "moduleDirectories": ["node_modules", "src"],
+  "moduleNameMapper": {
+    "^@constants$": "<rootDir>/src/shared/constants/constants-on-electron.ts"
+  },
+  "transform": {
+    "^.+\\.(ts|tsx|js|jsx)$": ["ts-jest", { "tsconfig": { "isolatedModules": true } }]
+  },
+  "testMatch": ["<rootDir>/usercase-test-coderl/*.test.ts"]
+}'
+
+exec /workspace/repo/node_modules/.bin/jest --runInBand --config "$JEST_CONFIG" /workspace/repo/usercase-test-coderl/insert-variable-to-curl.test.ts
