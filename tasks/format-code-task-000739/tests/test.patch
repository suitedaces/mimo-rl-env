+import { execFileSync } from 'child_process';
+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+
+const dgramModule = require('dgram') as typeof import('dgram');
+const httpModule = require('http') as typeof import('http');
+const httpsModule = require('https') as typeof import('https');
+const netModule = require('net') as typeof import('net');
+type InsertVariableToCurl = typeof import('../src/shared/insert-variable-to-curl').insertVariableToCurl;
+
+const loadInsertVariableToCurl = (): InsertVariableToCurl => {
+  return require('../src/shared/insert-variable-to-curl').insertVariableToCurl;
+};
+
+
+
+
+describe('insertVariableToCurl acceptance behavior', () => {
+  test('inserts a variable into empty cURL text', () => {
+
+
+    const actual = loadInsertVariableToCurl()({
+      curl: '',
+      index: 0,
+      variableName: 'TOKEN',
+    });
+
+    expect(actual).toBe('$TOKEN');
+  });
+
+  test('appends a variable at the end of the final token', () => {
+
+
+    const actual = loadInsertVariableToCurl()({
+      curl: 'curl example.com',
+      index: 16,
+      variableName: 'TOKEN',
+    });
+
+    expect(actual).toBe('curl example.com$TOKEN');
+  });
+
+  test('uses braces inside an unquoted word before a word character', () => {
+
+
+    const actual = loadInsertVariableToCurl()({
+      curl: 'curl example.com',
+      index: 6,
+      variableName: 'HOST',
+    });
+
+    expect(actual).toBe('curl e${HOST}xample.com');
+  });
+
+  test('uses braces inside double quotes before a word character', () => {
+
+
+    const actual = loadInsertVariableToCurl()({
+      curl: 'curl "hello world"',
+      index: 12,
+      variableName: 'NAME',
+    });
+
+    expect(actual).toBe('curl "hello ${NAME}world"');
+  });
+
+  test('uses direct variable syntax inside double quotes before punctuation', () => {
+
+
+    const actual = loadInsertVariableToCurl()({
+      curl: 'curl "hello, world"',
+      index: 11,
+      variableName: 'NAME',
+    });
+
+    expect(actual).toBe('curl "hello$NAME, world"');
+  });
+
+  test('uses direct variable syntax inside double quotes before whitespace', () => {
+
+
+    const actual = loadInsertVariableToCurl()({
+      curl: 'curl "hello world"',
+      index: 11,
+      variableName: 'NAME',
+    });
+
+    expect(actual).toBe('curl "hello$NAME world"');
+  });
+
+  test('breaks out of single quotes so the variable can expand', () => {
+
+
+    const actual = loadInsertVariableToCurl()({
+      curl: "curl 'hello world'",
+      index: 11,
+      variableName: 'NAME',
+    });
+
+    expect(actual).toBe("curl 'hello'$NAME' world'");
+  });
+
+  test('inserts into whitespace while preserving surrounding spaces', () => {
+
+
+    const actual = loadInsertVariableToCurl()({
+      curl: 'curl  example.com',
+      index: 5,
+      variableName: 'SPACE',
+    });
+
+    expect(actual).toBe('curl $SPACE example.com');
+  });
+
+  test('inserts into a newline while preserving surrounding characters', () => {
+
+
+    const actual = loadInsertVariableToCurl()({
+      curl: 'curl \n  example.com',
+      index: 5,
+      variableName: 'LINE',
+    });
+
+    expect(actual).toBe('curl $LINE\n  example.com');
+  });
+
+  test('throws the documented error for option-token insertion', () => {
+
+
+    let thrown: unknown;
+
+    try {
+      loadInsertVariableToCurl()({
+        curl: 'curl -H "X: y"',
+        index: 6,
+        variableName: 'HEADER',
+      });
+    } catch (error) {
+      thrown = error;
+    }
+
+
+    expect(thrown).toBeInstanceOf(Error);
+    expect((thrown as Error).message).toBe('Cannot insert variable to option');
+  });
+});
+
+describe('insertVariableToCurl pure-function contract', () => {
+  test('returns the same value on repeated calls with the same arguments', () => {
+    const args = {
+      curl: 'curl "hello world"',
+      index: 12,
+      variableName: 'NAME',
+    };
+
+    const insertVariableToCurl = loadInsertVariableToCurl();
+
+    expect(insertVariableToCurl(args)).toBe('curl "hello ${NAME}world"');
+    expect(insertVariableToCurl(args)).toBe('curl "hello ${NAME}world"');
+  });
+
+  test('does not mutate the caller-provided argument object', () => {
+    const args = {
+      curl: "curl 'hello world'",
+      index: 11,
+      variableName: 'NAME',
+    };
+    const before = JSON.parse(JSON.stringify(args));
+
+    const actual = loadInsertVariableToCurl()(args);
+
+    expect(actual).toBe("curl 'hello'$NAME' world'");
+    expect(args).toEqual(before);
+  });
+
+  test('does not depend on hidden in-process global state', () => {
+    const args = {
+      curl: 'curl example.com',
+      index: 6,
+      variableName: 'HOST',
+    };
+    const inProcess = loadInsertVariableToCurl()(args);
+    const script = `
+      const { insertVariableToCurl } = require('./src/shared/insert-variable-to-curl');
+      const actual = insertVariableToCurl(${JSON.stringify(args)});
+      process.stdout.write(JSON.stringify(actual));
+    `;
+    const freshProcess = JSON.parse(
+      execFileSync(
+        process.execPath,
+        ['-r', 'ts-node/register', '-r', 'tsconfig-paths/register', '-e', script],
+        { cwd: '/workspace/repo', encoding: 'utf8' },
+      ),
+    );
+
+    expect(inProcess).toBe('curl e${HOST}xample.com');
+    expect(freshProcess).toBe('curl e${HOST}xample.com');
+    expect(freshProcess).toBe(inProcess);
+  });
+
+  test('does not write cwd files or use built-in Node network APIs', () => {
+    const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'insert-curl-'));
+    const originalCwd = process.cwd();
+    const before = fs.readdirSync(tmpDir).sort();
+    const failNetwork = () => {
+      throw new Error('unexpected network access');
+    };
+    const spies = [
+      jest.spyOn(netModule, 'connect').mockImplementation(failNetwork as never),
+      jest
+        .spyOn(netModule, 'createConnection')
+        .mockImplementation(failNetwork as never),
+      jest.spyOn(httpModule, 'request').mockImplementation(failNetwork as never),
+      jest.spyOn(httpsModule, 'request').mockImplementation(failNetwork as never),
+      jest
+        .spyOn(dgramModule, 'createSocket')
+        .mockImplementation(failNetwork as never),
+    ];
+
+    try {
+      process.chdir(tmpDir);
+      jest.resetModules();
+      const actual = loadInsertVariableToCurl()({
+        curl: 'curl  example.com',
+        index: 5,
+        variableName: 'SPACE',
+      });
+      const after = fs.readdirSync(tmpDir).sort();
+
+      expect(actual).toBe('curl $SPACE example.com');
+      expect(after).toEqual(before);
+    } finally {
+      process.chdir(originalCwd);
+      spies.forEach((spy) => spy.mockRestore());
+      fs.rmSync(tmpDir, { recursive: true, force: true });
+    }
+  });
+});
