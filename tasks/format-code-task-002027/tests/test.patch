+++ b/test/geocoder/agolgeocoder_addnum.js
@@ -0,0 +1,100 @@
+var chai = require('chai'),
+    should = chai.should(),
+    expect = chai.expect;
+
+var AGOLGeocoder = require('../../lib/geocoder/agolgeocoder.js');
+
+var mockedOptions = {
+    'client_id': "CLIENT_ID",
+    'client_secret': "CLIENT_SECRET"
+};
+
+function makeAdapter(responseBody, captured) {
+    return {
+        get: function(url, params, cb) {
+            if (captured) {
+                captured.url = url;
+                captured.params = params;
+            }
+            cb(false, responseBody);
+        }
+    };
+}
+
+describe('AGOLGeocoder AddNum field fix', function() {
+
+    it('Should populate streetNumber from AddNum attribute', function(done) {
+        var responseBody = JSON.stringify({
+            spatialReference: {wkid: 4326, latestWkid: 4326},
+            locations: [{
+                name: '187 Bedford Ave, Brooklyn, New York, 11211',
+                extent: {xmin: -73.96, ymin: 40.71, xmax: -73.95, ymax: 40.72},
+                feature: {
+                    geometry: {x: -73.95785917316152, y: 40.71766805993411},
+                    attributes: {
+                        AddNum: '187',
+                        StPreDir: '',
+                        StName: 'Bedford',
+                        StType: 'Ave',
+                        City: 'Brooklyn',
+                        Postal: '11211',
+                        Region: 'New York',
+                        Country: 'USA'
+                    }
+                }
+            }]
+        });
+
+        var adapter = makeAdapter(responseBody);
+        var geocoder = new AGOLGeocoder(adapter, mockedOptions);
+        geocoder._getToken = function(cb) { cb(false, 'TOKEN'); };
+
+        geocoder.geocode('187 Bedford Ave, Brooklyn, NY 11211', function(err, results) {
+            expect(err).to.equal(false);
+            expect(results).to.have.length(1);
+            results[0].streetNumber.should.equal('187');
+            done();
+        });
+    });
+
+    it('Should preserve other geocoded fields when reading AddNum', function(done) {
+        var responseBody = JSON.stringify({
+            spatialReference: {wkid: 4326, latestWkid: 4326},
+            locations: [{
+                name: '187 Bedford Ave, Brooklyn, New York, 11211',
+                extent: {xmin: 0, ymin: 0, xmax: 0, ymax: 0},
+                feature: {
+                    geometry: {x: -73.957, y: 40.717},
+                    attributes: {
+                        AddNum: '187',
+                        StPreDir: '',
+                        StName: 'Bedford',
+                        StType: 'Ave',
+                        City: 'Brooklyn',
+                        Postal: '11211',
+                        Region: 'New York',
+                        Country: 'USA'
+                    }
+                }
+            }]
+        });
+
+        var adapter = makeAdapter(responseBody);
+        var geocoder = new AGOLGeocoder(adapter, mockedOptions);
+        geocoder._getToken = function(cb) { cb(false, 'TOKEN'); };
+
+        geocoder.geocode('187 Bedford Ave, Brooklyn, NY 11211', function(err, results) {
+            expect(err).to.equal(false);
+            var r = results[0];
+            r.streetNumber.should.equal('187');
+            r.city.should.equal('Brooklyn');
+            r.state.should.equal('New York');
+            r.zipcode.should.equal('11211');
+            r.country.should.equal('USA');
+            r.countryCode.should.equal('USA');
+            r.latitude.should.equal(-73.957);
+            r.longitude.should.equal(40.717);
+            done();
+        });
+    });
+});
