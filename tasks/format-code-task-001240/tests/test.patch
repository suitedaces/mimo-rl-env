new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/projector_entities_test.cc
@@ -0,0 +1,353 @@
+
+
+#include <cmath>
+#include <cstdlib>
+#include <iostream>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include <gz/math/Angle.hh>
+#include <gz/math/Pose3.hh>
+#include <gz/sim/EntityComponentManager.hh>
+#include <gz/sim/EventManager.hh>
+#include <gz/sim/SdfEntityCreator.hh>
+#include <gz/sim/components/Link.hh>
+#include <gz/sim/components/Name.hh>
+#include <gz/sim/components/ParentEntity.hh>
+#include <gz/sim/components/Pose.hh>
+#include <gz/sim/components/Projector.hh>
+#include <sdf/Link.hh>
+#include <sdf/Projector.hh>
+
+using namespace gz;
+using namespace sim;
+
+namespace
+{
+void Fail(const std::string &_message)
+{
+  std::cerr << _message << std::endl;
+  std::exit(1);
+}
+
+template <typename T, typename U>
+void CheckEq(const T &_actual, const U &_expected, const std::string &_label)
+{
+  if (!(_actual == _expected))
+  {
+    std::ostringstream out;
+    out << _label << ": expected [" << _expected << "], got [" << _actual
+        << "]";
+    Fail(out.str());
+  }
+}
+
+void CheckNear(double _actual, double _expected, double _tolerance,
+    const std::string &_label)
+{
+  if (std::fabs(_actual - _expected) > _tolerance)
+  {
+    std::ostringstream out;
+    out << _label << ": expected [" << _expected << "], got [" << _actual
+        << "]";
+    Fail(out.str());
+  }
+}
+
+sdf::Projector MakeProjector(const std::string &_name,
+    const math::Pose3d &_pose, double _near, double _far, double _fov,
+    const std::string &_texture, uint32_t _visibility)
+{
+  sdf::Projector projector;
+  projector.SetName(_name);
+  projector.SetRawPose(_pose);
+  projector.SetNearClip(_near);
+  projector.SetFarClip(_far);
+  projector.SetHorizontalFov(math::Angle(_fov));
+  projector.SetTexture(_texture);
+  projector.SetVisibilityFlags(_visibility);
+  return projector;
+}
+
+std::vector<Entity> ProjectorEntities(EntityComponentManager &_ecm)
+{
+  std::vector<Entity> entities;
+  _ecm.Each<components::Projector>(
+      [&](const Entity &_entity, const components::Projector *) -> bool
+      {
+        entities.push_back(_entity);
+        return true;
+      });
+  return entities;
+}
+
+Entity ProjectorEntityByName(EntityComponentManager &_ecm,
+    const std::string &_name)
+{
+  Entity found = kNullEntity;
+  _ecm.Each<components::Projector>(
+      [&](const Entity &_entity, const components::Projector *) -> bool
+      {
+        const auto *nameComp = _ecm.Component<components::Name>(_entity);
+        if (nameComp && nameComp->Data() == _name)
+        {
+          if (found != kNullEntity)
+            Fail("duplicate projector entity named " + _name);
+          found = _entity;
+        }
+        return true;
+      });
+
+  if (found == kNullEntity)
+    Fail("missing projector entity named " + _name);
+  return found;
+}
+
+void CheckProjectorEntity(EntityComponentManager &_ecm, Entity _entity,
+    const std::string &_name, const math::Pose3d &_pose, double _near,
+    double _far, double _fov, const std::string &_texture,
+    uint32_t _visibility, Entity _parent)
+{
+  const auto *projectorComp = _ecm.Component<components::Projector>(_entity);
+  if (!projectorComp)
+    Fail("missing components::Projector on entity");
+
+  const auto *poseComp = _ecm.Component<components::Pose>(_entity);
+  if (!poseComp)
+    Fail("missing components::Pose on entity");
+
+  const auto *nameComp = _ecm.Component<components::Name>(_entity);
+  if (!nameComp)
+    Fail("missing components::Name on entity");
+
+  CheckEq(nameComp->Data(), _name, "components::Name");
+  CheckEq(poseComp->Data(), _pose, "components::Pose");
+
+  const auto &projector = projectorComp->Data();
+  CheckEq(projector.Name(), _name, "components::Projector.Name");
+  CheckEq(projector.RawPose(), _pose, "components::Projector.RawPose");
+  CheckNear(projector.NearClip(), _near, 1e-12,
+      "components::Projector.NearClip");
+  CheckNear(projector.FarClip(), _far, 1e-12,
+      "components::Projector.FarClip");
+  CheckNear(projector.HorizontalFov().Radian(), _fov, 1e-12,
+      "components::Projector.HorizontalFov");
+  CheckEq(projector.Texture(), _texture, "components::Projector.Texture");
+  CheckEq(projector.VisibilityFlags(), _visibility,
+      "components::Projector.VisibilityFlags");
+
+  if (_parent != kNullEntity)
+  {
+    const auto *parentComp = _ecm.Component<components::ParentEntity>(_entity);
+    if (!parentComp)
+      Fail("missing components::ParentEntity on child projector");
+    CheckEq(parentComp->Data(), _parent, "components::ParentEntity");
+    CheckEq(_ecm.ParentEntity(_entity), _parent, "ECM parent entity");
+  }
+}
+
+void CreateOneProjectorInScope()
+{
+  EntityComponentManager ecm;
+  EventManager evm;
+  SdfEntityCreator creator(ecm, evm);
+  auto projector = MakeProjector("projector",
+      math::Pose3d(1, 2, 3, 0, 0, 0), 2.0, 7.0, 0.5,
+      "path/to/dummy_image.png", 0x01);
+  Entity entity = creator.CreateEntities(&projector);
+
+  if (entity == kNullEntity)
+    Fail("scoped projector creation returned null entity");
+  CheckEq(ecm.EntityCount(), static_cast<std::size_t>(1),
+      "scoped entity count");
+}
+
+void DirectProjectorCreation()
+{
+
+
+  EntityComponentManager ecm;
+  EventManager evm;
+  SdfEntityCreator creator(ecm, evm);
+
+  CheckEq(ecm.EntityCount(), static_cast<std::size_t>(0),
+      "fresh entity count");
+
+  auto projector = MakeProjector("projector",
+      math::Pose3d(1, 2, 3, 0, 0, 0), 2.0, 7.0, 0.5,
+      "path/to/dummy_image.png", 0x01);
+
+  Entity entity = creator.CreateEntities(&projector);
+
+  if (entity == kNullEntity)
+    Fail("direct projector creation returned null entity");
+  CheckEq(ecm.EntityCount(), static_cast<std::size_t>(1),
+      "entity count after direct projector creation");
+  CheckProjectorEntity(ecm, entity, "projector",
+      math::Pose3d(1, 2, 3, 0, 0, 0), 2.0, 7.0, 0.5,
+      "path/to/dummy_image.png", 0x01, kNullEntity);
+}
+
+void LinkWithSingleProjector()
+{
+
+
+  EntityComponentManager ecm;
+  EventManager evm;
+  SdfEntityCreator creator(ecm, evm);
+
+  sdf::Link link;
+  link.SetName("link");
+  link.AddProjector(MakeProjector("projector",
+      math::Pose3d(1, 2, 3, 0, 0, 0), 2.0, 7.0, 0.5,
+      "path/to/dummy_image.png", 0x01));
+
+  Entity linkEntity = creator.CreateEntities(&link);
+
+  if (linkEntity == kNullEntity)
+    Fail("single-projector link creation returned null entity");
+  CheckEq(ecm.EntityCount(), static_cast<std::size_t>(2),
+      "entity count after link with one projector");
+
+  const auto projectors = ProjectorEntities(ecm);
+  CheckEq(projectors.size(), static_cast<std::size_t>(1),
+      "projector entity count under single-projector link");
+
+
+  const Entity projectorEntity = ProjectorEntityByName(ecm, "projector");
+  CheckProjectorEntity(ecm, projectorEntity, "projector",
+      math::Pose3d(1, 2, 3, 0, 0, 0), 2.0, 7.0, 0.5,
+      "path/to/dummy_image.png", 0x01, linkEntity);
+}
+
+void LinkWithMultipleProjectors()
+{
+
+
+  EntityComponentManager ecm;
+  EventManager evm;
+  SdfEntityCreator creator(ecm, evm);
+
+  sdf::Link link;
+  link.SetName("link");
+  link.AddProjector(MakeProjector("projector_a",
+      math::Pose3d(1, 2, 3, 0, 0, 0), 2.0, 7.0, 0.5,
+      "path/to/dummy_image.png", 0x01));
+  link.AddProjector(MakeProjector("projector_b",
+      math::Pose3d(4, 5, 6, 0.1, 0.2, 0.3), 3.0, 8.0, 0.75,
+      "path/to/second_image.png", 0x02));
+
+  Entity linkEntity = creator.CreateEntities(&link);
+
+  if (linkEntity == kNullEntity)
+    Fail("multi-projector link creation returned null entity");
+  CheckEq(ecm.EntityCount(), static_cast<std::size_t>(3),
+      "entity count after link with two projectors");
+
+  const auto projectors = ProjectorEntities(ecm);
+  CheckEq(projectors.size(), static_cast<std::size_t>(2),
+      "projector entity count under multi-projector link");
+
+
+  const Entity projectorA = ProjectorEntityByName(ecm, "projector_a");
+  const Entity projectorB = ProjectorEntityByName(ecm, "projector_b");
+  CheckProjectorEntity(ecm, projectorA, "projector_a",
+      math::Pose3d(1, 2, 3, 0, 0, 0), 2.0, 7.0, 0.5,
+      "path/to/dummy_image.png", 0x01, linkEntity);
+  CheckProjectorEntity(ecm, projectorB, "projector_b",
+      math::Pose3d(4, 5, 6, 0.1, 0.2, 0.3), 3.0, 8.0, 0.75,
+      "path/to/second_image.png", 0x02, linkEntity);
+}
+
+void IndependentCreatorInstances()
+{
+
+
+  EntityComponentManager ecmA;
+  EventManager evmA;
+  SdfEntityCreator creatorA(ecmA, evmA);
+  sdf::Link link;
+  link.SetName("link");
+  link.AddProjector(MakeProjector("projector_a",
+      math::Pose3d(1, 2, 3, 0, 0, 0), 2.0, 7.0, 0.5,
+      "path/to/dummy_image.png", 0x01));
+  link.AddProjector(MakeProjector("projector_b",
+      math::Pose3d(4, 5, 6, 0.1, 0.2, 0.3), 3.0, 8.0, 0.75,
+      "path/to/second_image.png", 0x02));
+  Entity linkEntity = creatorA.CreateEntities(&link);
+
+  if (linkEntity == kNullEntity)
+    Fail("first instance link creation returned null entity");
+
+  EntityComponentManager ecmB;
+  EventManager evmB;
+  SdfEntityCreator creatorB(ecmB, evmB);
+  auto projector = MakeProjector("projector",
+      math::Pose3d(1, 2, 3, 0, 0, 0), 2.0, 7.0, 0.5,
+      "path/to/dummy_image.png", 0x01);
+  Entity projectorEntity = creatorB.CreateEntities(&projector);
+
+  CheckEq(ecmA.EntityCount(), static_cast<std::size_t>(3),
+      "first instance entity count");
+  CheckEq(ecmB.EntityCount(), static_cast<std::size_t>(1),
+      "second instance entity count");
+
+  if (projectorEntity == kNullEntity)
+    Fail("second instance projector creation returned null entity");
+  CheckProjectorEntity(ecmA, ProjectorEntityByName(ecmA, "projector_a"),
+      "projector_a",
+      math::Pose3d(1, 2, 3, 0, 0, 0), 2.0, 7.0, 0.5,
+      "path/to/dummy_image.png", 0x01, linkEntity);
+  CheckProjectorEntity(ecmB, projectorEntity, "projector",
+      math::Pose3d(1, 2, 3, 0, 0, 0), 2.0, 7.0, 0.5,
+      "path/to/dummy_image.png", 0x01, kNullEntity);
+}
+
+void RepeatedDestructionIsBenign()
+{
+
+
+  EntityComponentManager ecm;
+  EventManager evm;
+  auto creator = std::make_unique<SdfEntityCreator>(ecm, evm);
+  auto projector = MakeProjector("projector",
+      math::Pose3d(1, 2, 3, 0, 0, 0), 2.0, 7.0, 0.5,
+      "path/to/dummy_image.png", 0x01);
+  Entity entity = creator->CreateEntities(&projector);
+
+
+  if (entity == kNullEntity)
+    Fail("projector creation before creator reset returned null entity");
+  CheckEq(ecm.EntityCount(), static_cast<std::size_t>(1),
+      "entity count after creation");
+  CheckProjectorEntity(ecm, entity, "projector",
+      math::Pose3d(1, 2, 3, 0, 0, 0), 2.0, 7.0, 0.5,
+      "path/to/dummy_image.png", 0x01, kNullEntity);
+  creator.reset();
+  creator.reset();
+}
+
+void LeakFloorForConstructUseDestructCycles()
+{
+
+
+
+
+
+  for (int i = 0; i < 3; ++i)
+    CreateOneProjectorInScope();
+}
+}
+
+int main()
+{
+  DirectProjectorCreation();
+  LinkWithSingleProjector();
+  LinkWithMultipleProjectors();
+  IndependentCreatorInstances();
+  RepeatedDestructionIsBenign();
+  LeakFloorForConstructUseDestructCycles();
+  return 0;
+}
