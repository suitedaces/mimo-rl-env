+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+cmake -S . -B build-fixture -DBUILD_TESTING=OFF -DENABLE_GUI=OFF
+cmake --build build-fixture --target gz-sim -j "${JOBS:-2}"
+
+c++ -std=c++17 \
+  -I/workspace/repo/include \
+  -I/workspace/repo/build-fixture/include \
+  -I/workspace/repo/build-fixture/core/include \
+  -I/workspace/repo/build-fixture/src \
+  -I/workspace/repo/build-fixture/gz_msgs_gen \
+  $(pkg-config --cflags sdformat gz-math gz-common gz-plugin gz-utils \
+      gz-transport gz-fuel_tools gz-physics gz-rendering) \
+  /workspace/repo/usercase-test-coderl/projector_entities_test.cc \
+  -L/workspace/repo/build-fixture/lib \
+  -Wl,-rpath,/workspace/repo/build-fixture/lib \
+  -lgz-sim \
+  $(pkg-config --libs sdformat gz-math gz-common gz-plugin gz-utils \
+      gz-transport gz-fuel_tools gz-physics gz-rendering) \
+  -lfmt -lspdlog -lpython3.12 \
+  -o /workspace/repo/build-fixture/projector_entities_test
+
+exec /workspace/repo/build-fixture/projector_entities_test
