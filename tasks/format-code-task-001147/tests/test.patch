diff --git a/tests/CodespecLocaleLifecycle.php b/tests/CodespecLocaleLifecycle.php
new file mode 100644
index 0000000..c433a5b
--- /dev/null
+++ b/tests/CodespecLocaleLifecycle.php
@@ -0,0 +1,133 @@
+<?php
+
+require __DIR__.'/../vendor/autoload.php';
+
+use Silex\Application;
+use Silex\Provider\TranslationServiceProvider;
+use Symfony\Component\HttpFoundation\Request;
+use Symfony\Component\HttpKernel\HttpKernelInterface;
+
+function codespecAssertSame($expected, $actual, $label)
+{
+    if ($expected !== $actual) {
+        throw new RuntimeException($label.' expected '.var_export($expected, true).' but got '.var_export($actual, true));
+    }
+}
+
+function codespecAssertThrows($callable, $label)
+{
+    try {
+        call_user_func($callable);
+    } catch (Exception $e) {
+        return $e;
+    }
+
+    throw new RuntimeException($label.' expected an exception');
+}
+
+function codespecApp()
+{
+    $app = new Application();
+    $app->register(new TranslationServiceProvider());
+    $app['translator.domains'] = array(
+        'messages' => array(
+            'en' => array('welcome' => 'Welcome', 'items' => 'One item|Many items'),
+            'fr' => array('welcome' => 'Bienvenue', 'items' => 'Un article|Plusieurs articles'),
+            'es' => array('welcome' => 'Bienvenido', 'items' => 'Un articulo|Varios articulos'),
+        ),
+    );
+
+    return $app;
+}
+
+function testRequestLocaleDrivesTranslator()
+{
+    $app = codespecApp();
+    $app->get('/greet/{_locale}', function (Request $request) use ($app) {
+        return $app['translator']->getLocale().':'.$app['translator']->trans('welcome').':'.$app['translator']->transChoice('items', 2);
+    });
+
+    $response = $app->handle(Request::create('/greet/fr'));
+    codespecAssertSame('fr:Bienvenue:Plusieurs articles', $response->getContent(), 'request locale translation');
+    codespecAssertSame('fr', $app['locale'], 'request locale application state');
+}
+
+function testNestedRequestRestoresParentLocale()
+{
+    $app = codespecApp();
+    $app->get('/child/{_locale}', function (Request $request) use ($app) {
+        return $app['locale'].'/'.$request->getLocale().'/'.$app['translator']->trans('welcome').'/'.$app['translator']->transChoice('items', 2);
+    });
+    $app->get('/parent/{_locale}', function (Request $request) use ($app) {
+        $before = $app['locale'].'/'.$request->getLocale().'/'.$app['translator']->trans('welcome');
+        $child = $app->handle(Request::create('/child/es'), HttpKernelInterface::SUB_REQUEST)->getContent();
+        $after = $app['locale'].'/'.$request->getLocale().'/'.$app['translator']->trans('welcome');
+
+        return $before.'|'.$child.'|'.$after;
+    });
+
+    $response = $app->handle(Request::create('/parent/fr'));
+    codespecAssertSame('fr/fr/Bienvenue|es/es/Bienvenido/Varios articulos|fr/fr/Bienvenue', $response->getContent(), 'nested locale restoration');
+    codespecAssertSame('fr', $app['locale'], 'parent locale after nested request');
+}
+
+function testFailedNestedRequestRestoresLocale()
+{
+    $app = codespecApp();
+    $app->get('/child/{_locale}', function () {
+        throw new RuntimeException('child failed');
+    });
+    $app->get('/parent/{_locale}', function () use ($app) {
+        codespecAssertThrows(function () use ($app) {
+            $app->handle(Request::create('/child/es'), HttpKernelInterface::SUB_REQUEST, false);
+        }, 'failed nested request');
+
+        return $app['locale'].'/'.$app['translator']->trans('welcome');
+    });
+
+    $response = $app->handle(Request::create('/parent/fr'));
+    codespecAssertSame('fr/Bienvenue', $response->getContent(), 'locale after failed nested request');
+}
+
+function testFailedNestedRequestRestoresRequestService()
+{
+    $app = codespecApp();
+    $app->get('/child/{_locale}', function () {
+        throw new RuntimeException('child failed');
+    });
+    $app->get('/parent/{_locale}', function (Request $request) use ($app) {
+        codespecAssertThrows(function () use ($app) {
+            $app->handle(Request::create('/child/es'), HttpKernelInterface::SUB_REQUEST, false);
+        }, 'failed nested request');
+
+        return $app['request'] === $request ? 'parent' : 'leaked-child';
+    });
+
+    $response = $app->handle(Request::create('/parent/fr'));
+    codespecAssertSame('parent', $response->getContent(), 'request service after failed nested request');
+    codespecAssertThrows(function () use ($app) {
+        $app['request'];
+    }, 'request service outside completed request');
+}
+
+$tests = array(
+    'request locale translation' => 'testRequestLocaleDrivesTranslator',
+    'nested locale restoration' => 'testNestedRequestRestoresParentLocale',
+    'failed nested locale restoration' => 'testFailedNestedRequestRestoresLocale',
+    'failed nested request service restoration' => 'testFailedNestedRequestRestoresRequestService',
+);
+
+$failures = array();
+foreach ($tests as $label => $test) {
+    try {
+        call_user_func($test);
+        echo "PASS: ".$label."\n";
+    } catch (Exception $e) {
+        $failures[] = $label.': '.$e->getMessage();
+        echo "FAIL: ".$label.': '.$e->getMessage()."\n";
+    }
+}
+
+if ($failures) {
+    exit(1);
+}
