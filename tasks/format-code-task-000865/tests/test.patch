+def test_secretschecksum_annotation_present_when_secrets_set():
+    content = "LS1CRUdJTiBgUFJJVkFURSB"
+    config = """
+secrets:
+  - name: "env"
+    value:
+      ELASTICSEARCH_PASSWORD: {elk_pass}
+""".format(
+        elk_pass=content
+    )
+    r = helm_template(config)
+    annotations = r["statefulset"][name]["spec"]["template"]["metadata"]["annotations"]
+    assert "secretschecksum" in annotations
+
+    assert isinstance(annotations["secretschecksum"], str)
+    assert len(annotations["secretschecksum"]) > 0
+
+
+def test_secretschecksum_annotation_absent_when_no_secrets():
+    config = ""
+    r = helm_template(config)
+    annotations = (
+        r["statefulset"][name]["spec"]["template"]["metadata"].get("annotations") or {}
+    )
+    assert "secretschecksum" not in annotations
+
+
+def test_secretschecksum_changes_when_secret_value_changes():
+    config_a = """
+secrets:
+  - name: "env"
+    value:
+      ELASTICSEARCH_PASSWORD: AAAAAAAAAAAAAAAAAAAA
+"""
+    config_b = """
+secrets:
+  - name: "env"
+    value:
+      ELASTICSEARCH_PASSWORD: BBBBBBBBBBBBBBBBBBBB
+"""
+    r_a = helm_template(config_a)
+    r_b = helm_template(config_b)
+    ann_a = r_a["statefulset"][name]["spec"]["template"]["metadata"]["annotations"]
+    ann_b = r_b["statefulset"][name]["spec"]["template"]["metadata"]["annotations"]
+    assert "secretschecksum" in ann_a
+    assert "secretschecksum" in ann_b
+    assert ann_a["secretschecksum"] != ann_b["secretschecksum"]
+
+
