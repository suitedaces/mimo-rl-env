diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,181 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+export PYTHONPATH=/workspace/repo/Code
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+( cd /workspace/repo && python3 -m py_compile Code/autopkg ) \
+    || { echo "FAIL: build" >&2; exit 1; }
+BIN=(python3 /workspace/repo/Code/autopkg)
+
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+export HOME="$TMP/home"
+CONFIG_DIR="$HOME/.config/Autopkg"
+RECIPE_DIR="$TMP/recipes"
+CACHE_DIR="$TMP/cache"
+mkdir -p "$CONFIG_DIR" "$RECIPE_DIR" "$CACHE_DIR"
+printf '{"CACHE_DIR":"%s"}\n' "$CACHE_DIR" > "$CONFIG_DIR/config.json"
+cd "$TMP"
+
+cat > "$RECIPE_DIR/CheckMiddle.recipe.yaml" <<'EOF'
+Identifier: com.example.checkmiddle
+Input: {}
+Process:
+  - Processor: FileCreator
+    Arguments:
+      file_path: "%RECIPE_DIR%/../before-middle.txt"
+      file_content: "before middle\n"
+  - Processor: EndOfCheckPhase
+  - Processor: FileCreator
+    Arguments:
+      file_path: "%RECIPE_DIR%/../after-middle.txt"
+      file_content: "after middle\n"
+EOF
+
+cat > "$RECIPE_DIR/MarkerLast.recipe.yaml" <<'EOF'
+Identifier: com.example.markerlast
+Input: {}
+Process:
+  - Processor: FileCreator
+    Arguments:
+      file_path: "%RECIPE_DIR%/../before-last.txt"
+      file_content: "before last\n"
+  - Processor: EndOfCheckPhase
+EOF
+
+cat > "$RECIPE_DIR/MultiMarker.recipe.yaml" <<'EOF'
+Identifier: com.example.multimarker
+Input: {}
+Process:
+  - Processor: FileCreator
+    Arguments:
+      file_path: "%RECIPE_DIR%/../multi-before.txt"
+      file_content: "multi before\n"
+  - Processor: EndOfCheckPhase
+  - Processor: FileCreator
+    Arguments:
+      file_path: "%RECIPE_DIR%/../multi-between.txt"
+      file_content: "multi between\n"
+  - Processor: EndOfCheckPhase
+  - Processor: FileCreator
+    Arguments:
+      file_path: "%RECIPE_DIR%/../multi-after.txt"
+      file_content: "multi after\n"
+EOF
+
+cat > "$RECIPE_DIR/NoMarker.recipe.yaml" <<'EOF'
+Identifier: com.example.nomarker
+Input: {}
+Process:
+  - Processor: FileCreator
+    Arguments:
+      file_path: "%RECIPE_DIR%/../no-marker-created.txt"
+      file_content: "should not exist\n"
+EOF
+
+cat > "$RECIPE_DIR/Sample.install.recipe" <<'EOF'
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0"><dict>
+<key>Identifier</key><string>com.example.sampleinstall</string>
+<key>Input</key><dict/>
+<key>Process</key><array>
+  <dict><key>Processor</key><string>FileCreator</string><key>Arguments</key><dict><key>file_path</key><string>%RECIPE_DIR%/../install-before.txt</string><key>file_content</key><string>install before
+</string></dict></dict>
+  <dict><key>Processor</key><string>EndOfCheckPhase</string></dict>
+  <dict><key>Processor</key><string>FileCreator</string><key>Arguments</key><dict><key>file_path</key><string>%RECIPE_DIR%/../install-after.txt</string><key>file_content</key><string>install after
+</string></dict></dict>
+</array>
+</dict></plist>
+EOF
+
+
+
+
+"${BIN[@]}" run --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_help_run exit $ec; want 0"
+
+grep -Fq -- "-c" out || fail "F_help_run missing short check flag"
+grep -Fq -- "--check" out || fail "F_help_run missing long check flag"
+grep -Eiq -- "check.*download|download.*check" out || fail "F_help_run missing check-download help meaning"
+[ ! -s err ] || fail "F_help_run unexpected stderr: $(cat err)"
+
+
+
+
+"${BIN[@]}" install --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_help_install exit $ec; want 0"
+
+grep -Fq -- "-c" out || fail "F_help_install missing short check flag"
+grep -Fq -- "--check" out || fail "F_help_install missing long check flag"
+grep -Eiq -- "check.*download|download.*check" out || fail "F_help_install missing check-download help meaning"
+[ ! -s err ] || fail "F_help_install unexpected stderr: $(cat err)"
+
+
+
+
+"${BIN[@]}" run --check -d "$RECIPE_DIR" CheckMiddle.recipe >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_run_long_middle exit $ec; want 0"
+
+grep -Fxq "Processing CheckMiddle.recipe..." out || fail "F_run_long_middle missing processing line: $(cat out)"
+[ "$(cat before-middle.txt)" = "before middle" ] || fail "F_run_long_middle did not run processor before marker"
+[ ! -e after-middle.txt ] || fail "F_run_long_middle ran processor after marker"
+
+
+
+
+"${BIN[@]}" run -d "$RECIPE_DIR" MarkerLast.recipe --check >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_run_long_final_marker exit $ec; want 0"
+
+grep -Fxq "Processing MarkerLast.recipe..." out || fail "F_run_long_final_marker missing processing line: $(cat out)"
+[ "$(cat before-last.txt)" = "before last" ] || fail "F_run_long_final_marker did not run final-marker recipe"
+
+
+
+
+"${BIN[@]}" run --check -d "$RECIPE_DIR" MultiMarker.recipe >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_run_final_marker exit $ec; want 0"
+
+grep -Fxq "Processing MultiMarker.recipe..." out || fail "F_run_final_marker missing processing line: $(cat out)"
+[ "$(cat multi-before.txt)" = "multi before" ] || fail "F_run_final_marker missing first processor output"
+[ "$(cat multi-between.txt)" = "multi between" ] || fail "F_run_final_marker stopped at first marker instead of final marker"
+[ ! -e multi-after.txt ] || fail "F_run_final_marker ran processor after final marker"
+
+
+
+
+"${BIN[@]}" install -d "$RECIPE_DIR" -c Sample >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_install_short exit $ec; want 0"
+
+grep -Fxq "Processing Sample.install..." out || fail "F_install_short missing processing line: $(cat out)"
+[ "$(cat install-before.txt)" = "install before" ] || fail "F_install_short did not run processor before marker"
+[ ! -e install-after.txt ] || fail "F_install_short ran processor after marker"
+
+
+
+
+"${BIN[@]}" run --check -d "$RECIPE_DIR" NoMarker.recipe >out 2>err; ec=$?
+EXPECTED_ERR="Recipe at NoMarker.recipe is missing EndOfCheckPhase Processor, not possible to perform check."
+[ "$ec" -eq 70 ] || fail "F_missing_marker exit $ec; want 70"
+
+grep -Fxq "$EXPECTED_ERR" err || fail "F_missing_marker stderr missing mandated message: $(cat err)"
+! grep -Fq "Processing NoMarker.recipe..." out || fail "F_missing_marker processed missing-marker recipe"
+[ ! -e no-marker-created.txt ] || fail "F_missing_marker processed a recipe with no marker"
+
+
+
+
+rm -f before-last.txt
+"${BIN[@]}" run --check -d "$RECIPE_DIR" NoMarker.recipe MarkerLast.recipe >out 2>err; ec=$?
+EXPECTED_ERR='Recipe at NoMarker.recipe is missing EndOfCheckPhase Processor, not possible to perform check.'
+[ "$ec" -eq 70 ] || fail "F_mixed_continue exit $ec; want 70"
+
+grep -Fxq "Processing MarkerLast.recipe..." out || fail "F_mixed_continue missing processing line for valid recipe: $(cat out)"
+grep -Fxq "$EXPECTED_ERR" err || fail "F_mixed_continue stderr missing mandated message: $(cat err)"
+! grep -Fq "Processing NoMarker.recipe..." out || fail "F_mixed_continue processed missing-marker recipe"
+[ "$(cat before-last.txt)" = "before last" ] || fail "F_mixed_continue did not continue to the valid recipe"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
