diff --git a/lib/cartopy/tests/test_polygon.py b/lib/cartopy/tests/test_polygon.py
index c9fb435a..7112623a 100644
--- a/lib/cartopy/tests/test_polygon.py
+++ b/lib/cartopy/tests/test_polygon.py
@@ -508,3 +508,67 @@ class TestHoles(PolygonTests):
         source = ccrs.Geodetic()
 
         assert len(list(target.project_geometry(poly, source).geoms)) == 1
+
+
+class TestDatelineRepeatedVertex:
+
+
+
+
+
+    PATCH_COORDS = [
+        (-180.00020734, -63.5383884),
+        (-179.93611911, -63.61745971),
+        (-179.77001049, -63.62512738),
+        (-179.67109735, -63.55616224),
+        (-179.74190981, -63.49385818),
+        (-179.91362571, -63.48807984),
+        (-180.00020734, -63.5383884),
+        (-180.00020734, -63.5383884),
+    ]
+
+    def _project(self):
+        proj = ccrs.PlateCarree()
+        polygon = sgeom.Polygon(self.PATCH_COORDS)
+        return proj, proj.project_geometry(polygon, proj)
+
+    def test_no_polygon_fills_entire_domain(self):
+        proj, multi_polygon = self._project()
+        domain_area = proj.domain.area
+
+
+
+        for geom in multi_polygon.geoms:
+            assert geom.area < domain_area * 0.5, (
+                f'Got geometry with area {geom.area} (domain={domain_area}); '
+                'projection should not yield a polygon covering the entire '
+                'boundary for this input.'
+            )
+
+    def test_total_area_matches_input_polygon(self):
+        _, multi_polygon = self._project()
+
+        assert multi_polygon.area < 1.0, (
+            f'Got total area {multi_polygon.area}; expected ~0.03 (close to '
+            'the source polygon area).'
+        )
+
+    def test_single_geometry_returned(self):
+        _, multi_polygon = self._project()
+
+
+
+        assert len(multi_polygon.geoms) == 1, (
+            f'Expected 1 projected polygon, got {len(multi_polygon.geoms)}: '
+            f'{[g.bounds for g in multi_polygon.geoms]}'
+        )
+
+    def test_result_bounds_stay_near_input(self):
+        _, multi_polygon = self._project()
+        minx, miny, maxx, maxy = multi_polygon.bounds
+
+
+        assert miny > -65.0 and maxy < -62.0, (
+            f'Result bounds {(minx, miny, maxx, maxy)} extend far beyond '
+            'the input polygon latitude range; bug used to span full domain.'
+        )
