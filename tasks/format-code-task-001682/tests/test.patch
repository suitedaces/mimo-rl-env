+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export npm_config_offline=true
+export npm_config_audit=false
+export npm_config_fund=false
+
+MOCHA=/workspace/repo/node_modules/.bin/mocha
+if [ ! -x "$MOCHA" ]; then
+  echo "Missing local mocha binary at $MOCHA; dependencies must be preinstalled." >&2
+  exit 1
+fi
+
+exec "$MOCHA" --timeout 10000 /workspace/repo/usercase-test-coderl/deposit-auto-lifecycle.test.js
