diff --git a/test/builder/clause/pg_update_from.test.js b/test/builder/clause/pg_update_from.test.js
new file mode 100644
index 0000000..890765e
--- /dev/null
+++ b/test/builder/clause/pg_update_from.test.js
@@ -0,0 +1,92 @@
+const { sq, query } = require('../tape')
+
+describe('postgres update from / delete using', () => {
+  describe('DELETE ... USING ...', () => {
+    query({
+      name: 'single from emits no using',
+      query: sq.delete.from`book`,
+      text: 'delete from book'
+    })
+    query({
+      name: 'from, using',
+      query: sq.delete.from`book`.from`author`,
+      text: 'delete from book using author'
+    })
+    query({
+      name: 'multiple using tables joined with comma',
+      query: sq.delete.from`a`.from`b`.from`c`,
+      text: 'delete from a using b, c'
+    })
+    query({
+      name: 'from, using, where',
+      query: sq.delete.from`book`.from`author`
+        .where`book.author_id = author.id and author.contract = 'terminated'`,
+      text: `delete from book using author where (book.author_id = author.id and author.contract = 'terminated')`
+    })
+    query({
+      name: 'from, using, where, returning',
+      query: sq.delete.from`book`.from`author`
+        .where`book.author_id = author.id`.return`book.id`,
+      text:
+        'delete from book using author where (book.author_id = author.id) returning book.id'
+    })
+    query({
+      name: 'object aliased tables in delete/using',
+      query: sq.delete.from({ b: 'book' }).from({ a: 'author' }),
+      text: 'delete from book as b using author as a'
+    })
+  })
+
+  describe('UPDATE ... FROM ...', () => {
+    query({
+      name: 'single from emits no from clause',
+      query: sq.from`book`.set({ available: false }),
+      text: 'update book set available = $1',
+      args: [false]
+    })
+    query({
+      name: 'update, set, from',
+      query: sq.from`book`.from`author`.set({ available: false }),
+      text: 'update book set available = $1 from author',
+      args: [false]
+    })
+    query({
+      name: 'multiple from tables joined with comma',
+      query: sq.from`book`.from`author`.from`store`.set({ available: false }),
+      text: 'update book set available = $1 from author, store',
+      args: [false]
+    })
+    query({
+      name: 'update, set, from, where',
+      query: sq.from`book`.from`author`.set({ available: false }).where({
+        join: sq.l`book.author_id = author.id`,
+        'author.contract': 'terminated'
+      }),
+      text: `update book set available = $1 from author where (book.author_id = author.id and author.contract = $2)`,
+      args: [false, 'terminated']
+    })
+    query({
+      name: 'update, set, from, where, returning',
+      query: sq.from`book`.from`author`.set({ available: false })
+        .where`book.author_id = author.id`.return`book.id`,
+      text:
+        'update book set available = $1 from author where (book.author_id = author.id) returning book.id',
+      args: [false]
+    })
+    query({
+      name: 'aliased table and (values ...) table source',
+      query: sq
+        .from({ t: 'trad.bcas' })
+        .from({
+          v: [{ quantity: 1, code: '2310' }, { quantity: 2, code: '2730' }]
+        })
+        .set`quantity = v.quantity::integer`.where({
+        't.storeId': 12,
+        join: sq.l`t.product_code = v.code`
+      }).return`*`,
+      text:
+        'update trad.bcas as t set quantity = v.quantity::integer from (values ($1, $2), ($3, $4)) as v(quantity, code) where (t.store_id = $5 and t.product_code = v.code) returning *',
+      args: [1, '2310', 2, '2730', 12]
+    })
+  })
+})
