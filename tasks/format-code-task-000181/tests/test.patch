+++ b/tests/import_osm/create_hierarchy/test_linestring_parent_via_center.py
@@ -0,0 +1,191 @@
+import os
+
+import pytest
+from geoalchemy2.elements import WKTElement
+
+from osmnames.database.connection import engine
+from osmnames.database.functions import exec_sql_from_file
+from osmnames.database.tables import Tables
+from osmnames.import_osm.create_hierarchy import (
+    set_parent_id_for_elements_covered_by_single_polygon,
+)
+
+
+@pytest.fixture(scope="function")
+def schema(engine):
+    current_directory = os.path.dirname(os.path.realpath(__file__))
+    exec_sql_from_file('../fixtures/test_prepare_imported_data.sql.dump', cwd=current_directory)
+
+
+@pytest.fixture(scope="function")
+def tables(engine, schema):
+    return Tables(engine)
+
+
+def _polygon(tables, **kwargs):
+    kwargs.setdefault('type', 'city')
+    return tables.osm_polygon(**kwargs)
+
+
+def test_linestring_parented_when_center_inside_polygon_not_fully_covered(session, schema, tables):
+
+    session.add(
+        tables.osm_linestring(
+            id=1,
+            name="street crossing the boundary",
+            type='street',
+            geometry=WKTElement("LINESTRING(0 1, 8 1)", srid=3857),
+        )
+    )
+    session.add(
+        _polygon(
+            tables,
+            id=2,
+            name="covering polygon",
+            place_rank=22,
+            geometry=WKTElement("POLYGON((0 0, 5 0, 5 5, 0 5, 0 0))", srid=3857),
+        )
+    )
+    session.commit()
+
+    set_parent_id_for_elements_covered_by_single_polygon()
+
+    assert session.query(tables.osm_linestring).get(1).parent_id == 2
+
+
+def test_linestring_parented_regardless_of_polygon_place_rank(session, schema, tables):
+    session.add(
+        tables.osm_linestring(
+            id=1,
+            name="street inside a coarse polygon",
+            type='street',
+            geometry=WKTElement("LINESTRING(1 1, 3 1)", srid=3857),
+        )
+    )
+    session.add(
+        _polygon(
+            tables,
+            id=2,
+            name="low place_rank polygon",
+            place_rank=12,
+            geometry=WKTElement("POLYGON((0 0, 6 0, 6 6, 0 6, 0 0))", srid=3857),
+        )
+    )
+    session.commit()
+
+    set_parent_id_for_elements_covered_by_single_polygon()
+
+    assert session.query(tables.osm_linestring).get(1).parent_id == 2
+
+
+def test_linestring_not_parented_when_center_outside_polygon(session, schema, tables):
+
+    session.add(
+        tables.osm_linestring(
+            id=1,
+            name="street leaving the polygon",
+            type='street',
+            geometry=WKTElement("LINESTRING(1 1, 9 1)", srid=3857),
+        )
+    )
+    session.add(
+        _polygon(
+            tables,
+            id=2,
+            name="polygon only touching one end",
+            place_rank=22,
+            geometry=WKTElement("POLYGON((0 0, 4 0, 4 4, 0 4, 0 0))", srid=3857),
+        )
+    )
+    session.commit()
+
+    set_parent_id_for_elements_covered_by_single_polygon()
+
+    assert session.query(tables.osm_linestring).get(1).parent_id is None
+
+
+def test_linestring_parented_to_most_specific_polygon_containing_center(session, schema, tables):
+    session.add(
+        tables.osm_linestring(
+            id=1,
+            name="street inside two nested polygons",
+            type='street',
+            geometry=WKTElement("LINESTRING(2 2, 4 2)", srid=3857),
+        )
+    )
+    session.add(
+        _polygon(
+            tables,
+            id=2,
+            name="coarse polygon",
+            place_rank=18,
+            geometry=WKTElement("POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))", srid=3857),
+        )
+    )
+    session.add(
+        _polygon(
+            tables,
+            id=3,
+            name="fine polygon",
+            place_rank=22,
+            geometry=WKTElement("POLYGON((1 1, 6 1, 6 6, 1 6, 1 1))", srid=3857),
+        )
+    )
+    session.commit()
+
+    set_parent_id_for_elements_covered_by_single_polygon()
+
+    assert session.query(tables.osm_linestring).get(1).parent_id == 3
+
+
+def test_polygon_still_parented_by_full_containment(session, schema, tables):
+    session.add(
+        _polygon(
+            tables,
+            id=1,
+            name="enclosing polygon",
+            type='country',
+            place_rank=8,
+            geometry=WKTElement("POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))", srid=3857),
+        )
+    )
+    session.add(
+        _polygon(
+            tables,
+            id=2,
+            name="inner polygon",
+            place_rank=20,
+            geometry=WKTElement("POLYGON((1 1, 3 1, 3 3, 1 3, 1 1))", srid=3857),
+        )
+    )
+    session.commit()
+
+    set_parent_id_for_elements_covered_by_single_polygon()
+
+    assert session.query(tables.osm_polygon).get(2).parent_id == 1
+
+
+def test_point_still_parented_by_full_containment(session, schema, tables):
+    session.add(
+        _polygon(
+            tables,
+            id=1,
+            name="polygon covering the point",
+            place_rank=20,
+            geometry=WKTElement("POLYGON((0 0, 4 0, 4 4, 0 4, 0 0))", srid=3857),
+        )
+    )
+    session.add(
+        tables.osm_point(
+            id=2,
+            name="point inside polygon",
+            type='place',
+            linked=False,
+            geometry=WKTElement("POINT(2 2)", srid=3857),
+        )
+    )
+    session.commit()
+
+    set_parent_id_for_elements_covered_by_single_polygon()
+
+    assert session.query(tables.osm_point).get(2).parent_id == 1
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+export SIMPLE_SETTINGS="osmnames.settings_default,osmnames.settings_testing"
+
+pg_ctlcluster 16 main start >/dev/null 2>&1 || true
+
+for _ in $(seq 1 30); do
+    if sudo -u postgres psql -c 'SELECT 1' >/dev/null 2>&1; then break; fi
+    sleep 1
+done
+
+
+
+if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname='template_postgis'" | grep -q 1; then
+    sudo -u postgres psql -v ON_ERROR_STOP=1 -c "CREATE DATABASE template_postgis;"
+    sudo -u postgres psql -v ON_ERROR_STOP=1 -c "UPDATE pg_database SET datistemplate = TRUE WHERE datname = 'template_postgis';"
+fi
+sudo -u postgres psql -d template_postgis -v ON_ERROR_STOP=1 \
+    -c "CREATE EXTENSION IF NOT EXISTS postgis; CREATE EXTENSION IF NOT EXISTS hstore;"
+
+
+grep -qE '(^|[[:space:]])postgres([[:space:]]|$)' /etc/hosts || echo "127.0.0.1 postgres" >> /etc/hosts
+
+
+
+python -m pytest -p no:cacheprovider \
+    "tests/export_osmnames/test_get_importance.py::test_calculates_importance_if_no_wikipedia_article_exists" \
+    "tests/export_osmnames/test_get_importance.py::test_calculates_importance_if_no_wikipedia_article_defined"
+
+
+python -m pytest -p no:cacheprovider \
+    tests/import_osm/create_hierarchy/test_linestring_parent_via_center.py
