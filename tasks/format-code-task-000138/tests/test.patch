+package workspace
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"kusionstack.io/kusion/pkg/apis/workspace"
+)
+
+func intPtr(i int) *int {
+	return &i
+}
+
+
+
+func newOssConfig(endpoint, bucket string) *workspace.OssConfig {
+	c := &workspace.OssConfig{}
+	c.Endpoint = endpoint
+	c.Bucket = bucket
+	return c
+}
+
+
+func newS3Config(endpoint, bucket string) *workspace.S3Config {
+	c := &workspace.S3Config{}
+	c.Endpoint = endpoint
+	c.Bucket = bucket
+	return c
+}
+
+func TestValidateBackendConfigs_Backends(t *testing.T) {
+	testcases := []struct {
+		name           string
+		success        bool
+		backendConfigs *workspace.BackendConfigs
+	}{
+		{
+			name:           "nil backend configs",
+			success:        true,
+			backendConfigs: nil,
+		},
+		{
+			name:           "empty backend configs",
+			success:        true,
+			backendConfigs: &workspace.BackendConfigs{},
+		},
+		{
+			name:    "valid local backend",
+			success: true,
+			backendConfigs: &workspace.BackendConfigs{
+				Local: &workspace.LocalFileConfig{Path: "/etc/.kusion"},
+			},
+		},
+		{
+			name:    "valid mysql backend full",
+			success: true,
+			backendConfigs: &workspace.BackendConfigs{
+				Mysql: &workspace.MysqlConfig{
+					DBName:   "kusion",
+					User:     "kusion",
+					Password: "do-not-store",
+					Host:     "127.0.0.1",
+					Port:     intPtr(3306),
+				},
+			},
+		},
+		{
+			name:    "valid mysql backend without port",
+			success: true,
+			backendConfigs: &workspace.BackendConfigs{
+				Mysql: &workspace.MysqlConfig{
+					DBName: "kusion",
+					User:   "kusion",
+					Host:   "127.0.0.1",
+				},
+			},
+		},
+		{
+			name:    "invalid mysql backend empty db name",
+			success: false,
+			backendConfigs: &workspace.BackendConfigs{
+				Mysql: &workspace.MysqlConfig{
+					User: "kusion",
+					Host: "127.0.0.1",
+				},
+			},
+		},
+		{
+			name:    "invalid mysql backend empty user",
+			success: false,
+			backendConfigs: &workspace.BackendConfigs{
+				Mysql: &workspace.MysqlConfig{
+					DBName: "kusion",
+					Host:   "127.0.0.1",
+				},
+			},
+		},
+		{
+			name:    "invalid mysql backend empty host",
+			success: false,
+			backendConfigs: &workspace.BackendConfigs{
+				Mysql: &workspace.MysqlConfig{
+					DBName: "kusion",
+					User:   "kusion",
+				},
+			},
+		},
+		{
+			name:    "invalid mysql backend port too small",
+			success: false,
+			backendConfigs: &workspace.BackendConfigs{
+				Mysql: &workspace.MysqlConfig{
+					DBName: "kusion",
+					User:   "kusion",
+					Host:   "127.0.0.1",
+					Port:   intPtr(0),
+				},
+			},
+		},
+		{
+			name:    "invalid mysql backend port too large",
+			success: false,
+			backendConfigs: &workspace.BackendConfigs{
+				Mysql: &workspace.MysqlConfig{
+					DBName: "kusion",
+					User:   "kusion",
+					Host:   "127.0.0.1",
+					Port:   intPtr(70000),
+				},
+			},
+		},
+		{
+			name:    "valid oss backend without access keys",
+			success: true,
+			backendConfigs: &workspace.BackendConfigs{
+				Oss: newOssConfig("https://oss-cn-hangzhou.aliyuncs.com", "kusion"),
+			},
+		},
+		{
+			name:    "invalid oss backend empty bucket",
+			success: false,
+			backendConfigs: &workspace.BackendConfigs{
+				Oss: newOssConfig("https://oss-cn-hangzhou.aliyuncs.com", ""),
+			},
+		},
+		{
+			name:    "invalid oss backend empty endpoint",
+			success: false,
+			backendConfigs: &workspace.BackendConfigs{
+				Oss: newOssConfig("", "kusion"),
+			},
+		},
+		{
+			name:    "valid s3 backend without region and keys",
+			success: true,
+			backendConfigs: &workspace.BackendConfigs{
+				S3: newS3Config("", "kusion"),
+			},
+		},
+		{
+			name:    "invalid s3 backend empty bucket",
+			success: false,
+			backendConfigs: &workspace.BackendConfigs{
+				S3: newS3Config("https://s3.us-east-1.amazonaws.com", ""),
+			},
+		},
+		{
+			name:    "invalid multiple backends local and mysql",
+			success: false,
+			backendConfigs: &workspace.BackendConfigs{
+				Local: &workspace.LocalFileConfig{Path: "/etc/.kusion"},
+				Mysql: &workspace.MysqlConfig{
+					DBName: "kusion",
+					User:   "kusion",
+					Host:   "127.0.0.1",
+				},
+			},
+		},
+		{
+			name:    "invalid multiple backends oss and s3",
+			success: false,
+			backendConfigs: &workspace.BackendConfigs{
+				Oss: newOssConfig("https://oss-cn-hangzhou.aliyuncs.com", "kusion"),
+				S3:  newS3Config("", "kusion"),
+			},
+		},
+	}
+
+	for _, tc := range testcases {
+		t.Run(tc.name, func(t *testing.T) {
+			err := ValidateBackendConfigs(tc.backendConfigs)
+			assert.Equal(t, tc.success, err == nil)
+		})
+	}
+}
+
+func TestGetBackendName_Backends(t *testing.T) {
+	testcases := []struct {
+		name           string
+		expected       string
+		backendConfigs *workspace.BackendConfigs
+	}{
+		{
+			name:           "nil configs default to local",
+			expected:       "local",
+			backendConfigs: nil,
+		},
+		{
+			name:           "empty configs default to local",
+			expected:       "local",
+			backendConfigs: &workspace.BackendConfigs{},
+		},
+		{
+			name:     "local backend",
+			expected: "local",
+			backendConfigs: &workspace.BackendConfigs{
+				Local: &workspace.LocalFileConfig{Path: "/etc/.kusion"},
+			},
+		},
+		{
+			name:     "mysql backend",
+			expected: "mysql",
+			backendConfigs: &workspace.BackendConfigs{
+				Mysql: &workspace.MysqlConfig{DBName: "kusion", User: "kusion", Host: "127.0.0.1"},
+			},
+		},
+		{
+			name:     "oss backend",
+			expected: "oss",
+			backendConfigs: &workspace.BackendConfigs{
+				Oss: newOssConfig("https://oss-cn-hangzhou.aliyuncs.com", "kusion"),
+			},
+		},
+		{
+			name:     "s3 backend",
+			expected: "s3",
+			backendConfigs: &workspace.BackendConfigs{
+				S3: newS3Config("", "kusion"),
+			},
+		},
+	}
+
+	for _, tc := range testcases {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.expected, GetBackendName(tc.backendConfigs))
+		})
+	}
+}
+
+func TestCompleteWorkspace_DefaultMysqlPort(t *testing.T) {
+	t.Run("unset port defaults to 3306", func(t *testing.T) {
+		ws := &workspace.Workspace{
+			Name: "dev",
+			Backends: &workspace.BackendConfigs{
+				Mysql: &workspace.MysqlConfig{DBName: "kusion", User: "kusion", Host: "127.0.0.1"},
+			},
+		}
+		CompleteWorkspace(ws)
+		if assert.NotNil(t, ws.Backends.Mysql.Port) {
+			assert.Equal(t, 3306, *ws.Backends.Mysql.Port)
+		}
+	})
+
+	t.Run("explicit port is left untouched", func(t *testing.T) {
+		ws := &workspace.Workspace{
+			Name: "dev",
+			Backends: &workspace.BackendConfigs{
+				Mysql: &workspace.MysqlConfig{DBName: "kusion", User: "kusion", Host: "127.0.0.1", Port: intPtr(13306)},
+			},
+		}
+		CompleteWorkspace(ws)
+		if assert.NotNil(t, ws.Backends.Mysql.Port) {
+			assert.Equal(t, 13306, *ws.Backends.Mysql.Port)
+		}
+	})
+}
+
+func TestCompleteWorkspace_EnvSecrets(t *testing.T) {
+	t.Run("mysql password from env", func(t *testing.T) {
+		t.Setenv("KUSION_BACKEND_MYSQL_PASSWORD", "secret-pwd")
+		ws := &workspace.Workspace{
+			Backends: &workspace.BackendConfigs{
+				Mysql: &workspace.MysqlConfig{DBName: "kusion", User: "kusion", Host: "127.0.0.1"},
+			},
+		}
+		CompleteWorkspace(ws)
+		assert.Equal(t, "secret-pwd", ws.Backends.Mysql.Password)
+	})
+
+	t.Run("empty env keeps existing mysql password", func(t *testing.T) {
+		t.Setenv("KUSION_BACKEND_MYSQL_PASSWORD", "")
+		ws := &workspace.Workspace{
+			Backends: &workspace.BackendConfigs{
+				Mysql: &workspace.MysqlConfig{DBName: "kusion", User: "kusion", Host: "127.0.0.1", Password: "from-config"},
+			},
+		}
+		CompleteWorkspace(ws)
+		assert.Equal(t, "from-config", ws.Backends.Mysql.Password)
+	})
+
+	t.Run("oss access keys from env", func(t *testing.T) {
+		t.Setenv("OSS_ACCESS_KEY_ID", "oss-id")
+		t.Setenv("OSS_ACCESS_KEY_SECRET", "oss-secret")
+		ws := &workspace.Workspace{
+			Backends: &workspace.BackendConfigs{
+				Oss: newOssConfig("https://oss-cn-hangzhou.aliyuncs.com", "kusion"),
+			},
+		}
+		CompleteWorkspace(ws)
+		assert.Equal(t, "oss-id", ws.Backends.Oss.AccessKeyID)
+		assert.Equal(t, "oss-secret", ws.Backends.Oss.AccessKeySecret)
+	})
+
+	t.Run("s3 access keys and region from env", func(t *testing.T) {
+		t.Setenv("AWS_ACCESS_KEY_ID", "s3-id")
+		t.Setenv("AWS_SECRET_ACCESS_KEY", "s3-secret")
+		t.Setenv("AWS_REGION", "us-east-1")
+		t.Setenv("AWS_DEFAULT_REGION", "eu-west-1")
+		ws := &workspace.Workspace{
+			Backends: &workspace.BackendConfigs{
+				S3: newS3Config("", "kusion"),
+			},
+		}
+		CompleteWorkspace(ws)
+		assert.Equal(t, "s3-id", ws.Backends.S3.AccessKeyID)
+		assert.Equal(t, "s3-secret", ws.Backends.S3.AccessKeySecret)
+		assert.Equal(t, "us-east-1", ws.Backends.S3.Region)
+	})
+
+	t.Run("s3 region falls back to default region", func(t *testing.T) {
+		t.Setenv("AWS_REGION", "")
+		t.Setenv("AWS_DEFAULT_REGION", "eu-west-1")
+		ws := &workspace.Workspace{
+			Backends: &workspace.BackendConfigs{
+				S3: newS3Config("", "kusion"),
+			},
+		}
+		CompleteWorkspace(ws)
+		assert.Equal(t, "eu-west-1", ws.Backends.S3.Region)
+	})
+
+	t.Run("safe on nil and local backends", func(t *testing.T) {
+		assert.NotPanics(t, func() {
+			CompleteWorkspace(&workspace.Workspace{})
+			CompleteWorkspace(&workspace.Workspace{
+				Backends: &workspace.BackendConfigs{
+					Local: &workspace.LocalFileConfig{Path: "/etc/.kusion"},
+				},
+			})
+		})
+	})
+}
