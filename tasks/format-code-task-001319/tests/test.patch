+func TestConversionsAreReferentiallyTransparentForSameInput(t *testing.T) {
+	yamlInput := []byte("foo:\n  bar:\n  - a\n  - b\n  - c\na: 1\n")
+	jsonInput := []byte("{\"foo\": {\"bar\": [\"a\", \"b\", \"c\"]}, \"a\": 1}")
+
+	firstJSON, err := yaml.YAMLToJSON(yamlInput)
+	if err != nil {
+		t.Fatalf("first YAMLToJSON returned error: %v", err)
+	}
+	secondJSON, err := yaml.YAMLToJSON(yamlInput)
+	if err != nil {
+		t.Fatalf("second YAMLToJSON returned error: %v", err)
+	}
+	if !bytes.Equal(firstJSON, secondJSON) {
+		t.Fatalf("YAMLToJSON repeated output mismatch\nfirst: %q\nsecond: %q", firstJSON, secondJSON)
+	}
+
+	firstYAML, err := yaml.JSONToYAML(jsonInput)
+	if err != nil {
+		t.Fatalf("first JSONToYAML returned error: %v", err)
+	}
+	secondYAML, err := yaml.JSONToYAML(jsonInput)
+	if err != nil {
+		t.Fatalf("second JSONToYAML returned error: %v", err)
+	}
+	if !bytes.Equal(firstYAML, secondYAML) {
+		t.Fatalf("JSONToYAML repeated output mismatch\nfirst: %q\nsecond: %q", firstYAML, secondYAML)
+	}
+}
+
+func TestConversionsDoNotMutateInputSlices(t *testing.T) {
+	yamlInput := []byte("z: true\nnullish: null\nnums:\n- 0\n- -2\n- 3.5\ntext: hello\n")
+	yamlOriginal := append([]byte(nil), yamlInput...)
+	if _, err := yaml.YAMLToJSON(yamlInput); err != nil {
+		t.Fatalf("YAMLToJSON returned error: %v", err)
+	}
+	if !bytes.Equal(yamlInput, yamlOriginal) {
+		t.Fatalf("YAMLToJSON mutated input\nwant: %q\n got: %q", yamlOriginal, yamlInput)
+	}
+
+	jsonInput := []byte("{\"z\":true,\"nullish\":null,\"nums\":[0,-2,3.5],\"text\":\"hello\"}")
+	jsonOriginal := append([]byte(nil), jsonInput...)
+	if _, err := yaml.JSONToYAML(jsonInput); err != nil {
+		t.Fatalf("JSONToYAML returned error: %v", err)
+	}
+	if !bytes.Equal(jsonInput, jsonOriginal) {
+		t.Fatalf("JSONToYAML mutated input\nwant: %q\n got: %q", jsonOriginal, jsonInput)
+	}
+}
+
+func TestConversionsDoNotDependOnInProcessGlobalState(t *testing.T) {
+	yamlInput := []byte("foo:\n  bar:\n  - a\n  - b\n  - c\na: 1\n")
+	wantJSON := []byte("{\"foo\": {\"bar\": [\"a\", \"b\", \"c\"]}, \"a\": 1}\n")
+	jsonInput := []byte("{\"foo\": {\"bar\": [\"a\", \"b\", \"c\"]}, \"a\": 1}")
+	wantYAML := []byte("foo:\n  bar:\n  - a\n  - b\n  - c\na: 1\n")
+
+	if got, err := yaml.YAMLToJSON(yamlInput); err != nil || !bytes.Equal(got, wantJSON) {
+		t.Fatalf("initial YAMLToJSON = %q, %v; want %q, nil", got, err, wantJSON)
+	}
+	if got, err := yaml.JSONToYAML([]byte("{\"z\":true,\"nums\":[0,-2,3.5]}")); err != nil || len(got) == 0 {
+		t.Fatalf("noise JSONToYAML = %q, %v; want non-empty output and nil error", got, err)
+	}
+	if got, err := yaml.YAMLToJSON([]byte("outer:\n  first: 1\n  second: 2\n")); err != nil || len(got) == 0 {
+		t.Fatalf("noise YAMLToJSON = %q, %v; want non-empty output and nil error", got, err)
+	}
+	if got, err := yaml.YAMLToJSON(yamlInput); err != nil || !bytes.Equal(got, wantJSON) {
+		t.Fatalf("post-noise YAMLToJSON = %q, %v; want %q, nil", got, err, wantJSON)
+	}
+
+	if got, err := yaml.JSONToYAML(jsonInput); err != nil || !bytes.Equal(got, wantYAML) {
+		t.Fatalf("initial JSONToYAML = %q, %v; want %q, nil", got, err, wantYAML)
+	}
+	if got, err := yaml.YAMLToJSON([]byte("z: true\ntext: hello\n")); err != nil || len(got) == 0 {
+		t.Fatalf("noise YAMLToJSON = %q, %v; want non-empty output and nil error", got, err)
+	}
+	if got, err := yaml.JSONToYAML([]byte("{\"outer\":{\"first\":1,\"second\":2}}")); err != nil || len(got) == 0 {
+		t.Fatalf("noise JSONToYAML = %q, %v; want non-empty output and nil error", got, err)
+	}
+	if got, err := yaml.JSONToYAML(jsonInput); err != nil || !bytes.Equal(got, wantYAML) {
+		t.Fatalf("post-noise JSONToYAML = %q, %v; want %q, nil", got, err, wantYAML)
+	}
+}
+
+func TestConversionsDoNotWriteFilesInWorkingDirectory(t *testing.T) {
+	tmp := t.TempDir()
+	oldwd, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd failed: %v", err)
+	}
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatalf("Chdir temp failed: %v", err)
+	}
+	defer func() {
+		if err := os.Chdir(oldwd); err != nil {
+			t.Fatalf("restore working directory failed: %v", err)
+		}
+	}()
+
+	before := snapshotRelativePaths(t, tmp)
+	if _, err := yaml.YAMLToJSON([]byte("foo:\n  bar:\n  - a\n  - b\n  - c\na: 1\n")); err != nil {
+		t.Fatalf("YAMLToJSON returned error: %v", err)
+	}
+	if _, err := yaml.JSONToYAML([]byte("{\"foo\": {\"bar\": [\"a\", \"b\", \"c\"]}, \"a\": 1}")); err != nil {
+		t.Fatalf("JSONToYAML returned error: %v", err)
+	}
+	after := snapshotRelativePaths(t, tmp)
+
+	if !equalStringSlices(before, after) {
+		t.Fatalf("working directory changed\nbefore: %#v\nafter:  %#v", before, after)
+	}
+}
+
+func snapshotRelativePaths(t *testing.T, root string) []string {
+	t.Helper()
+	var paths []string
+	err := filepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if path == root {
+			return nil
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		if d.IsDir() {
+			rel += string(os.PathSeparator)
+		}
+		paths = append(paths, rel)
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("snapshot failed: %v", err)
+	}
+	sort.Strings(paths)
+	return paths
+}
+
+func equalStringSlices(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
