+
+func TestYAMLToJSONQueryExamplePreservesOrderAndFormatsJSON(t *testing.T) {
+
+
+	input := []byte("foo:\n  bar:\n  - a\n  - b\n  - c\na: 1\n")
+	want := []byte("{\"foo\": {\"bar\": [\"a\", \"b\", \"c\"]}, \"a\": 1}\n")
+
+	got, err := yaml.YAMLToJSON(input)
+	if err != nil {
+		t.Fatalf("YAMLToJSON returned error: %v", err)
+	}
+	if !bytes.Equal(got, want) {
+		t.Fatalf("YAMLToJSON output mismatch\nwant: %q\n got: %q", want, got)
+	}
+}
+
+func TestYAMLToJSONScalarsAndSequenceFormatting(t *testing.T) {
+
+
+	input := []byte("z: true\nnullish: null\nnums:\n- 0\n- -2\n- 3.5\ntext: hello\n")
+	want := []byte("{\"z\": true, \"nullish\": null, \"nums\": [0, -2, 3.5], \"text\": \"hello\"}\n")
+
+	got, err := yaml.YAMLToJSON(input)
+	if err != nil {
+		t.Fatalf("YAMLToJSON returned error: %v", err)
+	}
+	if !bytes.Equal(got, want) {
+		t.Fatalf("YAMLToJSON output mismatch\nwant: %q\n got: %q", want, got)
+	}
+}
+
+func TestYAMLToJSONNestedOrderedMapsInArrays(t *testing.T) {
+
+
+	input := []byte("outer:\n  first: 1\n  second: 2\nlist:\n- name: beta\n  value: 2\n- name: alpha\n  value: 1\n")
+	want := []byte("{\"outer\": {\"first\": 1, \"second\": 2}, \"list\": [{\"name\": \"beta\", \"value\": 2}, {\"name\": \"alpha\", \"value\": 1}]}\n")
+
+	got, err := yaml.YAMLToJSON(input)
