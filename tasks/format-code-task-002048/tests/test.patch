diff --git a/tests/openaps.test.js b/tests/openaps.test.js
index 18fefd43..55854500 100644
--- a/tests/openaps.test.js
+++ b/tests/openaps.test.js
@@ -173,4 +173,105 @@ describe('openaps', function ( ) {
     done();
   });
 
+  function makeOpenapsStatus (baseTime, suggestion, statusCode) {
+    var oldEnacted = {
+      bg: 100
+      , temp: 'absolute'
+      , snoozeBG: 100
+      , recieved: true
+      , reason: 'old enacted temp'
+      , rate: 0
+      , eventualBG: 100
+      , timestamp: baseTime.clone().subtract(30, 'minutes').toISOString()
+      , duration: 30
+      , tick: '+0'
+    };
+
+    return {
+      mills: baseTime.valueOf()
+      , openaps: {
+        suggested: suggestion
+        , enacted: statusCode === 'notenacted'
+          ? _.extend({}, oldEnacted, {
+            recieved: false
+            , timestamp: baseTime.clone().subtract(1, 'minute').toISOString()
+          })
+          : oldEnacted
+      }
+    };
+  }
+
+  function renderOpenapsInfoRows (statusCode, suggestion) {
+    var baseTime = moment('2016-02-01T12:00:00.000Z');
+    var rendered;
+    var ctx = {
+      settings: {
+        units: 'mg/dl'
+      }
+      , pluginBase: {
+        updatePillText: function captureOpenapsPill (plugin, options) {
+          rendered = options;
+        }
+      }
+    };
+
+    var sbx = sandbox.clientInit(ctx, baseTime.valueOf(), {
+      devicestatus: [makeOpenapsStatus(baseTime, suggestion, statusCode)]
+    });
+
+    openaps.setProperties(sbx);
+    openaps.updateVisualisation(sbx);
+
+    should.exist(rendered);
+    return _.map(rendered.info || [], function normalizeRow (row) {
+      return {
+        label: String(row.label || '').replace(/\s+/g, ' ').trim()
+        , value: String(row.value || '').replace(/\s+/g, ' ').trim()
+      };
+    });
+  }
+
+  function suggestionAt (baseTime, carbsReq, eventualBG) {
+    return {
+      bg: eventualBG - 20
+      , temp: 'absolute'
+      , snoozeBG: eventualBG - 5
+      , timestamp: baseTime.toISOString()
+      , rate: 0
+      , reason: 'Eventual BG ' + eventualBG + ' with ' + carbsReq + 'g carbs suggested'
+      , eventualBG: eventualBG
+      , carbsReq: carbsReq
+      , duration: 30
+      , tick: '+1'
+    };
+  }
+
+  it('notenacted_shows_suggestion_details_without_duplicate_not_enacted_for_multiple_suggestions', function (done) {
+    var firstSuggestion = suggestionAt(moment('2016-02-01T11:59:00.000Z'), 12, 185);
+    var secondSuggestion = suggestionAt(moment('2016-02-01T11:58:00.000Z'), 5, 142);
+
+    var firstNotEnacted = renderOpenapsInfoRows('notenacted', firstSuggestion);
+    var firstLooping = renderOpenapsInfoRows('looping', firstSuggestion);
+    var secondNotEnacted = renderOpenapsInfoRows('notenacted', secondSuggestion);
+    var secondLooping = renderOpenapsInfoRows('looping', secondSuggestion);
+
+    firstNotEnacted[0].value.should.equal('Not Enacted');
+    secondNotEnacted[0].value.should.equal('Not Enacted');
+
+    var firstNotEnactedDetails = firstNotEnacted.slice(1);
+    var secondNotEnactedDetails = secondNotEnacted.slice(1);
+
+    firstNotEnactedDetails.forEach(function noDuplicateStatusValue (row) {
+      row.value.should.not.equal('Not Enacted');
+    });
+    secondNotEnactedDetails.forEach(function noDuplicateStatusValue (row) {
+      row.value.should.not.equal('Not Enacted');
+    });
+
+    firstNotEnactedDetails.should.eql(firstLooping.slice(1));
+    secondNotEnactedDetails.should.eql(secondLooping.slice(1));
+    firstNotEnactedDetails.should.not.eql(secondNotEnactedDetails);
+    done();
+  });
+
 });
diff --git a/tests/pump.test.js b/tests/pump.test.js
index ce8efbb6..be62fc20 100644
--- a/tests/pump.test.js
+++ b/tests/pump.test.js
@@ -143,4 +143,105 @@ describe('pump', function ( ) {
     done();
   });
 
+  function contextWithEnabledAlerts () {
+    var ctx = {
+      settings: {
+        units: 'mg/dl'
+      }
+    };
+    ctx.notifications = require('../lib/notifications')(env, ctx);
+    ctx.notifications.initRequests();
+    return ctx;
+  }
+
+  function pumpSandboxWithTreatments (ctx, sandboxTime, treatments) {
+    var sbx = sandbox.clientInit(ctx, sandboxTime.valueOf(), {
+      devicestatus: [status]
+      , treatments: treatments || []
+    });
+    sbx.extendedSettings = { enableAlerts: 'TRUE' };
+    pump.setProperties(sbx);
+    return sbx;
+  }
+
+  function pumpStatusData (sbx) {
+    return sbx.properties && sbx.properties.pump && sbx.properties.pump.data;
+  }
+
+  it('not_generate_alert_for_stale_pump_data_when_offline_marker_active', function (done) {
+    var ctx = contextWithEnabledAlerts();
+    var sandboxTime = now.clone().add(45, 'minutes');
+    var sbx = pumpSandboxWithTreatments(ctx, sandboxTime, [{
+      eventType: 'OpenAPS Offline'
+      , mills: now.valueOf()
+      , duration: 90
+    }]);
+
+    pump.checkNotifications(sbx);
+
+    should.not.exist(ctx.notifications.findHighestAlarm());
+    pumpStatusData(sbx).title.should.equal('Pump Status');
+    pumpStatusData(sbx).level.should.equal(levels.NONE);
+    done();
+  });
+
+  it('offline_marker_must_be_current_to_suppress_pump_alerts', function (done) {
+    [
+      {
+        name: 'expired marker'
+        , treatments: [{
+          eventType: 'OpenAPS Offline'
+          , mills: now.clone().subtract(3, 'hours').valueOf()
+          , duration: 30
+        }]
+      }
+      , {
+        name: 'future marker'
+        , treatments: [{
+          eventType: 'OpenAPS Offline'
+          , mills: now.clone().add(3, 'hours').valueOf()
+          , duration: 30
+        }]
+      }
+    ].forEach(function eachCase (testCase) {
+      var ctx = contextWithEnabledAlerts();
+      var sbx = pumpSandboxWithTreatments(ctx, now.clone().add(1, 'hour'), testCase.treatments);
+      var beforeNotificationStatus = pumpStatusData(sbx);
+
+      pump.checkNotifications(sbx);
+
+      var highest = ctx.notifications.findHighestAlarm();
+      (!!highest || beforeNotificationStatus.level > levels.NONE).should.equal(
+        true
+        , testCase.name + ' should not suppress normal pump alerts'
+      );
+    });
+    done();
+  });
+
+  it('logs_when_pump_alert_checks_are_skipped_for_active_offline_marker', function (done) {
+    var ctx = contextWithEnabledAlerts();
+    var sandboxTime = now.clone().add(20, 'minutes');
+    var infoCalls = 0;
+    var originalInfo = console.info;
+
+    console.info = function captureInfo () {
+      infoCalls += 1;
+    };
+
+    try {
+      var sbx = pumpSandboxWithTreatments(ctx, sandboxTime, [{
+        eventType: 'OpenAPS Offline'
+        , mills: now.valueOf()
+        , duration: 60
+      }]);
+      pump.checkNotifications(sbx);
+    } finally {
+      console.info = originalInfo;
+    }
+
+    infoCalls.should.not.equal(0);
+    done();
+  });
+
 });
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,29 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+
+ensure_node_deps() {
+  if ! node -e "require('lodash'); require('moment'); require('should'); require('git-rev')" >/dev/null 2>&1 || [ ! -x node_modules/mocha/bin/_mocha ]; then
+    npm install --no-save --ignore-scripts lodash@3.10.1 moment@2.10.6 should@4.0.4 mocha@1.20.1 git-rev
+  fi
+}
+
+ensure_node_deps
+
+NEW_TESTS='notenacted_shows_suggestion_details_without_duplicate_not_enacted_for_multiple_suggestions|not_generate_alert_for_stale_pump_data_when_offline_marker_active|offline_marker_must_be_current_to_suppress_pump_alerts|logs_when_pump_alert_checks_are_skipped_for_active_offline_marker'
+
+case "${1:-}" in
+  base)
+    node node_modules/mocha/bin/_mocha -R tap --grep "$NEW_TESTS" --invert tests/openaps.test.js tests/pump.test.js
+    ;;
+  new)
+    node node_modules/mocha/bin/_mocha -R tap --grep "$NEW_TESTS" tests/openaps.test.js tests/pump.test.js
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
