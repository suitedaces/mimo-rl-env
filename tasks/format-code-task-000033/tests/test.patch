diff --git a/cli/azd/pkg/cloud/cloud_test.go b/cli/azd/pkg/cloud/cloud_test.go
new file mode 100644
index 000000000..3495b133b
--- /dev/null
+++ b/cli/azd/pkg/cloud/cloud_test.go
@@ -0,0 +1,143 @@
+
+
+
+package cloud
+
+import (
+	"testing"
+
+	azcloud "github.com/Azure/azure-sdk-for-go/sdk/azcore/cloud"
+	"github.com/stretchr/testify/require"
+)
+
+func TestConfigPath(t *testing.T) {
+	require.Equal(t, "cloud", ConfigPath)
+}
+
+func TestCloudNames(t *testing.T) {
+	require.Equal(t, "AzureCloud", AzurePublicName)
+	require.Equal(t, "AzureChinaCloud", AzureChinaCloudName)
+	require.Equal(t, "AzureUSGovernment", AzureUSGovernmentName)
+}
+
+func TestAzurePublic(t *testing.T) {
+	c := AzurePublic()
+	require.NotNil(t, c)
+	require.Equal(t, "https://portal.azure.com", c.PortalUrlBase)
+	require.Equal(t, "core.windows.net", c.StorageEndpointSuffix)
+	require.Equal(t, "azurecr.io", c.ContainerRegistryEndpointSuffix)
+	require.Equal(t,
+		azcloud.AzurePublic.ActiveDirectoryAuthorityHost,
+		c.Configuration.ActiveDirectoryAuthorityHost)
+}
+
+func TestAzureChina(t *testing.T) {
+	c := AzureChina()
+	require.NotNil(t, c)
+	require.Equal(t, "https://portal.azure.cn", c.PortalUrlBase)
+	require.Equal(t, "core.chinacloudapi.cn", c.StorageEndpointSuffix)
+	require.Equal(t, "azurecr.cn", c.ContainerRegistryEndpointSuffix)
+	require.Equal(t,
+		azcloud.AzureChina.ActiveDirectoryAuthorityHost,
+		c.Configuration.ActiveDirectoryAuthorityHost)
+}
+
+func TestAzureGovernment(t *testing.T) {
+	c := AzureGovernment()
+	require.NotNil(t, c)
+	require.Equal(t, "https://portal.azure.us", c.PortalUrlBase)
+	require.Equal(t, "core.usgovcloudapi.net", c.StorageEndpointSuffix)
+	require.Equal(t, "azurecr.us", c.ContainerRegistryEndpointSuffix)
+	require.Equal(t,
+		azcloud.AzureGovernment.ActiveDirectoryAuthorityHost,
+		c.Configuration.ActiveDirectoryAuthorityHost)
+}
+
+
+func TestCloudsAreDistinct(t *testing.T) {
+	require.NotEqual(t, AzurePublic().PortalUrlBase, AzureChina().PortalUrlBase)
+	require.NotEqual(t, AzurePublic().PortalUrlBase, AzureGovernment().PortalUrlBase)
+	require.NotEqual(t, AzureChina().PortalUrlBase, AzureGovernment().PortalUrlBase)
+	require.NotEqual(t,
+		AzurePublic().Configuration.ActiveDirectoryAuthorityHost,
+		AzureChina().Configuration.ActiveDirectoryAuthorityHost)
+	require.NotEqual(t,
+		AzurePublic().Configuration.ActiveDirectoryAuthorityHost,
+		AzureGovernment().Configuration.ActiveDirectoryAuthorityHost)
+}
+
+func TestNewCloudByName(t *testing.T) {
+	cases := map[string]*Cloud{
+		AzurePublicName:       AzurePublic(),
+		AzureChinaCloudName:   AzureChina(),
+		AzureUSGovernmentName: AzureGovernment(),
+	}
+
+	for name, expected := range cases {
+		t.Run(name, func(t *testing.T) {
+			c, err := NewCloud(&Config{Name: name})
+			require.NoError(t, err)
+			require.NotNil(t, c)
+			require.Equal(t, expected.PortalUrlBase, c.PortalUrlBase)
+			require.Equal(t, expected.StorageEndpointSuffix, c.StorageEndpointSuffix)
+			require.Equal(t,
+				expected.ContainerRegistryEndpointSuffix,
+				c.ContainerRegistryEndpointSuffix)
+			require.Equal(t,
+				expected.Configuration.ActiveDirectoryAuthorityHost,
+				c.Configuration.ActiveDirectoryAuthorityHost)
+		})
+	}
+}
+
+func TestNewCloudEmptyNameDefaultsToPublic(t *testing.T) {
+	c, err := NewCloud(&Config{Name: ""})
+	require.NoError(t, err)
+	require.NotNil(t, c)
+	require.Equal(t, AzurePublic().PortalUrlBase, c.PortalUrlBase)
+	require.Equal(t,
+		AzurePublic().Configuration.ActiveDirectoryAuthorityHost,
+		c.Configuration.ActiveDirectoryAuthorityHost)
+}
+
+func TestNewCloudUnknownNameErrors(t *testing.T) {
+	_, err := NewCloud(&Config{Name: "NotARealCloud"})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "NotARealCloud")
+}
+
+func TestParseCloudConfigFromMap(t *testing.T) {
+	config, err := ParseCloudConfig(map[string]any{"name": AzureChinaCloudName})
+	require.NoError(t, err)
+	require.NotNil(t, config)
+	require.Equal(t, AzureChinaCloudName, config.Name)
+
+
+	c, err := NewCloud(config)
+	require.NoError(t, err)
+	require.Equal(t, AzureChina().PortalUrlBase, c.PortalUrlBase)
+}
+
+func TestParseCloudConfigEmptyMap(t *testing.T) {
+	config, err := ParseCloudConfig(map[string]any{})
+	require.NoError(t, err)
+	require.NotNil(t, config)
+	require.Equal(t, "", config.Name)
+}
+
+func TestParseCloudConfigRoundTrip(t *testing.T) {
+
+	config, err := ParseCloudConfig(&Config{Name: AzureUSGovernmentName})
+	require.NoError(t, err)
+	require.NotNil(t, config)
+	require.Equal(t, AzureUSGovernmentName, config.Name)
+}
+
+
+
+func TestParseCloudConfigKeyIsLowerCaseName(t *testing.T) {
+	config, err := ParseCloudConfig(map[string]any{"name": "AzureCloud"})
+	require.NoError(t, err)
+	require.NotNil(t, config)
+	require.Equal(t, "AzureCloud", config.Name)
+}
