diff --git a/usercase-test-coderl/test_delay_line.cpp b/usercase-test-coderl/test_delay_line.cpp
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_delay_line.cpp
@@ -0,0 +1,267 @@
+
+
+
+
+
+
+
+
+
+
+
+
+
+#include "DelayLine.h"
+
+#include <cmath>
+#include <complex>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <sstream>
+#include <string>
+
+namespace {
+
+void fail(const std::string& message) {
+    std::cerr << message << '\n';
+    std::exit(1);
+}
+
+void assertNear(const std::string& label, float actual, float expected) {
+    if (std::fabs(actual - expected) > 0.000001f) {
+        std::ostringstream out;
+        out << label << ": expected " << expected << ", got " << actual;
+        fail(out.str());
+    }
+}
+
+void assertComplexNear(const std::string& label,
+                       std::complex<float> actual,
+                       float expectedReal,
+                       float expectedImag) {
+    assertNear(label + " real", actual.real(), expectedReal);
+    assertNear(label + " imag", actual.imag(), expectedImag);
+}
+
+void assertFiniteComplex(const std::string& label, std::complex<float> actual) {
+    if (!std::isfinite(actual.real()) || !std::isfinite(actual.imag())) {
+        std::ostringstream out;
+        out << label << ": expected finite complex sample, got "
+            << actual.real() << " + " << actual.imag() << "i";
+        fail(out.str());
+    }
+}
+
+std::complex<float> firstDelayedAfterWrite(float gDC,
+                                           float gPI,
+                                           float fT,
+                                           std::complex<float> input) {
+    DelayLine delay;
+    delay.prepare(1, 48000.0f);
+    delay.setFilterCoefficients(gDC, gPI, fT);
+    delay.update();
+    delay.write(input);
+    delay.update();
+    delay.write({0.0f, 0.0f});
+    return delay.read();
+}
+
+float impulseResponseFingerprint(float fT) {
+    DelayLine delay;
+    delay.prepare(1, 48000.0f);
+    delay.setFilterCoefficients(0.5f, 0.25f, fT);
+
+    delay.update();
+    delay.write({1.0f, 0.0f});
+
+    float sum = 0.0f;
+    for (int i = 1; i <= 6; ++i) {
+        delay.update();
+        delay.write({0.0f, 0.0f});
+        sum += static_cast<float>(i) * delay.read().real();
+    }
+    return sum;
+}
+
+long vmRssKb() {
+    std::ifstream status("/proc/self/status");
+    std::string line;
+    while (std::getline(status, line)) {
+        if (line.rfind("VmRSS:", 0) == 0) {
+            std::istringstream value(line.substr(6));
+            long kb = -1;
+            std::string unit;
+            value >> kb >> unit;
+            return kb;
+        }
+    }
+    fail("could not read VmRSS from /proc/self/status");
+    return -1;
+}
+
+void oneConstructUseDestroyCycle() {
+    auto delay = std::make_unique<DelayLine>();
+    delay->prepare(2, 48000.0f);
+    delay->setFilterCoefficients(1.0f, 1.0f, 1000.0f);
+    delay->update();
+    delay->write({1.0f, 0.0f});
+    assertComplexNear("cycle first delayed output", delay->read(), 0.0f, 0.0f);
+}
+
+void testTransparentTwoSampleDelay() {
+
+
+    DelayLine delay;
+    delay.prepare(2, 48000.0f);
+    delay.setFilterCoefficients(1.0f, 1.0f, 1000.0f);
+
+    delay.update();
+    delay.write({1.0f, 0.0f});
+    assertComplexNear("length-2 sample 1", delay.read(), 0.0f, 0.0f);
+
+    delay.update();
+    delay.write({2.0f, 0.0f});
+    assertComplexNear("length-2 sample 2", delay.read(), 0.0f, 0.0f);
+
+    delay.update();
+    delay.write({3.0f, 0.0f});
+    assertComplexNear("length-2 sample 3", delay.read(), 1.0f, 0.0f);
+
+    delay.update();
+    delay.write({4.0f, 0.0f});
+    assertComplexNear("length-2 sample 4", delay.read(), 2.0f, 0.0f);
+}
+
+void testComplexSampleComponentsStayTogether() {
+
+
+    DelayLine delay;
+    delay.prepare(1, 48000.0f);
+    delay.setFilterCoefficients(1.0f, 1.0f, 1000.0f);
+
+    delay.update();
+    delay.write({0.5f, -0.25f});
+    assertComplexNear("length-1 same sample", delay.read(), 0.0f, 0.0f);
+
+    delay.update();
+    assertComplexNear("length-1 next sample", delay.read(), 0.5f, -0.25f);
+}
+
+void testShelfFilterUsesAbsoluteUpdatedGainsForLaterWrites() {
+
+
+    const auto negativeGainFirst = firstDelayedAfterWrite(-0.5f, -0.25f, 1000.0f, {1.0f, -2.0f});
+    const auto positiveGainFirst = firstDelayedAfterWrite(0.5f, 0.25f, 1000.0f, {1.0f, -2.0f});
+
+
+    assertComplexNear("absolute gains match positive gains",
+                      negativeGainFirst,
+                      positiveGainFirst.real(),
+                      positiveGainFirst.imag());
+    assertFiniteComplex("filtered first sample next tick", negativeGainFirst);
+
+
+    if (negativeGainFirst.real() <= 0.0f || negativeGainFirst.real() >= 1.0f) {
+        fail("filtered first sample should decay a positive real input without passing it through unchanged");
+    }
+    assertNear("filtered complex component ratio",
+               negativeGainFirst.imag(),
+               -2.0f * negativeGainFirst.real());
+
+    const float lowTransition = impulseResponseFingerprint(1000.0f);
+    const float highTransition = impulseResponseFingerprint(8000.0f);
+
+    if (std::fabs(lowTransition - highTransition) <= 0.0001f) {
+        fail("transition frequency should affect the one-pole shelf response");
+    }
+}
+
+void testPrepareAgainClearsBufferAndFilterHistory() {
+
+
+    DelayLine delay;
+    delay.prepare(1, 48000.0f);
+    delay.setFilterCoefficients(-0.5f, -0.25f, 1000.0f);
+    delay.update();
+    delay.write({1.0f, 1.0f});
+    assertComplexNear("before reprepare same tick", delay.read(), 0.0f, 0.0f);
+    delay.update();
+    const auto beforeReprepare = delay.read();
+    assertFiniteComplex("before reprepare next tick", beforeReprepare);
+
+    if (std::fabs(beforeReprepare.real()) <= 0.000001f ||
+        std::fabs(beforeReprepare.imag()) <= 0.000001f ||
+        std::fabs(beforeReprepare.real() - 1.0f) <= 0.000001f ||
+        std::fabs(beforeReprepare.imag() - 1.0f) <= 0.000001f) {
+        fail("non-unity shelf should produce a finite delayed value distinct from silence and passthrough before reprepare");
+    }
+
+    delay.prepare(1, 48000.0f);
+    delay.setFilterCoefficients(-0.5f, -0.25f, 1000.0f);
+    delay.update();
+    assertComplexNear("after reprepare empty tick", delay.read(), 0.0f, 0.0f);
+    delay.write({0.0f, 0.0f});
+    assertComplexNear("after reprepare same tick", delay.read(), 0.0f, 0.0f);
+    delay.update();
+
+    assertComplexNear("after reprepare next tick", delay.read(), 0.0f, 0.0f);
+}
+
+void testInstancesDoNotShareDelayState() {
+
+
+    DelayLine a;
+    DelayLine b;
+    a.prepare(1, 48000.0f);
+    b.prepare(1, 48000.0f);
+    a.setFilterCoefficients(1.0f, 1.0f, 1000.0f);
+    b.setFilterCoefficients(1.0f, 1.0f, 1000.0f);
+
+    a.update();
+    a.write({7.0f, -1.0f});
+    a.update();
+    b.update();
+
+    assertComplexNear("instance a delayed sample", a.read(), 7.0f, -1.0f);
+    assertComplexNear("instance b independent delayed sample", b.read(), 0.0f, 0.0f);
+}
+
+void testRepeatedRaiiCleanupKeepsRssBounded() {
+
+
+    for (int i = 0; i < 20; ++i) {
+        oneConstructUseDestroyCycle();
+    }
+
+    const long baselineKb = vmRssKb();
+    long peakKb = baselineKb;
+    for (int i = 0; i < 150; ++i) {
+        oneConstructUseDestroyCycle();
+        const long currentKb = vmRssKb();
+        if (currentKb > peakKb) {
+            peakKb = currentKb;
+        }
+    }
+
+    if (peakKb - baselineKb > 8192) {
+        std::ostringstream out;
+        out << "VmRSS grew by " << (peakKb - baselineKb)
+            << " KiB across 150 DelayLine cleanup cycles; expected <= 8192 KiB";
+        fail(out.str());
+    }
+}
+
+}
+
+int main() {
+    testTransparentTwoSampleDelay();
+    testComplexSampleComponentsStayTogether();
+    testShelfFilterUsesAbsoluteUpdatedGainsForLaterWrites();
+    testPrepareAgainClearsBufferAndFilterHistory();
+    testInstancesDoNotShareDelayState();
+    testRepeatedRaiiCleanupKeepsRssBounded();
+    std::cout << "DelayLine acceptance tests passed\n";
+    return 0;
+}
