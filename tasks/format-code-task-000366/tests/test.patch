diff --git a/tests/trading/trading_client/test_order_management_routes.py b/tests/trading/trading_client/test_order_management_routes.py
new file mode 100644
index 0000000..49b0387
--- /dev/null
+++ b/tests/trading/trading_client/test_order_management_routes.py
@@ -0,0 +1,215 @@
+from typing import List
+
+import pytest
+
+from alpaca.common.enums import BaseURL, OrderSide, OrderStatus
+from alpaca.common.models.trading import Order
+from alpaca.trading.client import TradingClient
+from alpaca.trading.models import (
+    CancelOrderResponse,
+    GetOrderByIdRequest,
+    GetOrdersRequest,
+    ReplaceOrderRequest,
+)
+
+
+@pytest.fixture
+def trading_client():
+    return TradingClient("key-id", "secret-key")
+
+
+ORDER_JSON = """
+{
+    "id": "61e69015-8549-4bfd-b9c3-01e75843f47d",
+    "client_order_id": "some-non-uuid-client-id",
+    "created_at": "2021-03-16T18:38:01.942282Z",
+    "updated_at": "2021-03-16T18:38:01.942282Z",
+    "submitted_at": "2021-03-16T18:38:01.937734Z",
+    "filled_at": null,
+    "expired_at": null,
+    "canceled_at": null,
+    "failed_at": null,
+    "replaced_at": null,
+    "replaced_by": null,
+    "replaces": null,
+    "asset_id": "904837e3-3b76-47ec-b432-046db621571b",
+    "symbol": "AAPL",
+    "asset_class": "us_equity",
+    "notional": null,
+    "qty": 1,
+    "filled_qty": "0",
+    "filled_avg_price": null,
+    "order_class": "simple",
+    "order_type": "market",
+    "type": "market",
+    "side": "buy",
+    "time_in_force": "day",
+    "limit_price": null,
+    "stop_price": null,
+    "status": "accepted",
+    "extended_hours": false,
+    "legs": null,
+    "trail_percent": null,
+    "trail_price": null,
+    "hwm": null,
+    "commission": 1.25
+}
+"""
+
+
+def _order_list_json():
+    return f"[{ORDER_JSON}]"
+
+
+def test_get_orders_returns_order_list(reqmock, trading_client: TradingClient):
+    reqmock.get(
+        f"{BaseURL.TRADING_PAPER}/v2/orders",
+        text=_order_list_json(),
+    )
+
+    response = trading_client.get_orders()
+
+    assert isinstance(response, list)
+    assert len(response) == 1
+    assert isinstance(response[0], Order)
+
+    assert response[0].client_order_id == "some-non-uuid-client-id"
+
+
+def test_get_orders_no_filter_sends_no_params(reqmock, trading_client: TradingClient):
+    reqmock.get(
+        f"{BaseURL.TRADING_PAPER}/v2/orders",
+        text=_order_list_json(),
+    )
+
+    trading_client.get_orders()
+
+    assert reqmock.last_request.qs == {}
+
+
+def test_get_orders_serializes_symbols_as_csv(reqmock, trading_client: TradingClient):
+    reqmock.get(
+        f"{BaseURL.TRADING_PAPER}/v2/orders",
+        text=_order_list_json(),
+    )
+
+    filter = GetOrdersRequest(
+        status=OrderStatus.NEW,
+        side=OrderSide.BUY,
+        symbols=["SPY", "AAPL"],
+    )
+
+    trading_client.get_orders(filter)
+
+    qs = reqmock.last_request.qs
+
+
+    assert qs["symbols"] == ["spy,aapl"]
+    assert qs["status"] == ["new"]
+    assert qs["side"] == ["buy"]
+
+
+def test_get_orders_omits_unset_fields(reqmock, trading_client: TradingClient):
+    reqmock.get(
+        f"{BaseURL.TRADING_PAPER}/v2/orders",
+        text=_order_list_json(),
+    )
+
+    trading_client.get_orders(GetOrdersRequest(status=OrderStatus.NEW))
+
+    qs = reqmock.last_request.qs
+    assert qs["status"] == ["new"]
+    assert "symbols" not in qs
+    assert "limit" not in qs
+
+
+def test_get_order_by_id(reqmock, trading_client: TradingClient):
+    order_id = "61e69015-8549-4bfd-b9c3-01e75843f47d"
+
+    reqmock.get(
+        f"{BaseURL.TRADING_PAPER}/v2/orders/{order_id}",
+        text=ORDER_JSON,
+    )
+
+    order = trading_client.get_order_by_id(
+        order_id, filter=GetOrderByIdRequest(nested=False)
+    )
+
+    assert isinstance(order, Order)
+    assert str(order.id) == order_id
+
+
+def test_get_order_by_id_accepts_uuid_instance(
+    reqmock, trading_client: TradingClient
+):
+    from uuid import UUID
+
+    order_id = "61e69015-8549-4bfd-b9c3-01e75843f47d"
+
+    reqmock.get(
+        f"{BaseURL.TRADING_PAPER}/v2/orders/{order_id}",
+        text=ORDER_JSON,
+    )
+
+    order = trading_client.get_order_by_id(UUID(order_id))
+
+    assert isinstance(order, Order)
+
+
+def test_get_order_by_id_rejects_non_uuid(reqmock, trading_client: TradingClient):
+    with pytest.raises(ValueError):
+        trading_client.get_order_by_id("not-a-real-uuid")
+
+
+def test_replace_order(reqmock, trading_client: TradingClient):
+    order_id = "61e69015-8549-4bfd-b9c3-01e75843f47d"
+
+    reqmock.patch(
+        f"{BaseURL.TRADING_PAPER}/v2/orders/{order_id}",
+        text=ORDER_JSON,
+    )
+
+    order = trading_client.replace_order(
+        order_id, ReplaceOrderRequest(qty=10, limit_price=100)
+    )
+
+    assert isinstance(order, Order)
+    assert reqmock.last_request.method == "PATCH"
+    body = reqmock.last_request.json()
+    assert body["qty"] == 10
+    assert body["limit_price"] == 100
+
+    assert "stop_price" not in body
+    assert "trail" not in body
+
+
+def test_replace_order_rejects_non_uuid(reqmock, trading_client: TradingClient):
+    with pytest.raises(ValueError):
+        trading_client.replace_order("not-a-real-uuid")
+
+
+def test_cancel_orders(reqmock, trading_client: TradingClient):
+    reqmock.delete(
+        f"{BaseURL.TRADING_PAPER}/v2/orders",
+        text="""
+        [
+            {
+                "id": "61e69015-8549-4bfd-b9c3-01e75843f47d",
+                "status": 200
+            },
+            {
+                "id": "904837e3-3b76-47ec-b432-046db621571b",
+                "status": 500
+            }
+        ]
+        """,
+    )
+
+    response = trading_client.cancel_orders()
+
+    assert isinstance(response, list)
+    assert len(response) == 2
+    assert all(isinstance(item, CancelOrderResponse) for item in response)
+    assert response[0].status == 200
+    assert str(response[0].id) == "61e69015-8549-4bfd-b9c3-01e75843f47d"
+    assert response[1].status == 500
