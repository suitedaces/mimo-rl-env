+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+PYTEST=.build_env/.venv/bin/pytest
+
+
+"$PYTEST" \
+    tests/trading/test_trading_models.py \
+    tests/trading/trading_client/test_order_routes.py \
+    -q
+
+
+"$PYTEST" \
+    tests/trading/trading_client/test_order_management_routes.py \
+    -q
