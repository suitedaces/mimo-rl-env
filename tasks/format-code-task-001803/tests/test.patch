+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+export PYTHONPATH=/workspace/repo:${PYTHONPATH:-}
+export PIP_NO_INDEX=1
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+export HF_HUB_OFFLINE=1
+export TRANSFORMERS_OFFLINE=1
+export WANDB_MODE=offline
+
+python - <<'PY'
+import importlib.util
+import sys
+
+missing = [name for name in ("pytest", "timm") if importlib.util.find_spec(name) is None]
+if missing:
+    raise SystemExit(f"Missing offline Python dependencies: {', '.join(missing)}")
+PY
+
+exec python -m pytest /workspace/repo/usercase-test-coderl/test_lightfc_session.py -v
