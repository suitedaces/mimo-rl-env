+def test_get_additional_claims_default_signature_accepts_request():
+    """The default OAuth2Validator.get_additional_claims must accept a
+    `request` argument (backwards-compatible API contract that downstream
+    subclasses rely on).
+    """
+    validator = OAuth2Validator()
+
+
+    dummy_request = object()
+
+    result = validator.get_additional_claims(dummy_request)
+
+
+    assert result == {} or result == [] or result == () or list(result) == []
+
+
+@pytest.mark.django_db
+def test_userinfo_endpoint_subclass_dict_with_request_uses_request_user(
+    oidc_tokens, client, oauth2_settings
+):
+    """A subclass overriding get_additional_claims(self, request) and
+    returning a dict must have its claims propagated to the userinfo
+    JSON response, and the `request` argument it receives must expose
+    the authenticated user (request.user).
+    """
+    captured = {}
+
+    class CustomValidator(OAuth2Validator):
+        def get_additional_claims(self, request):
+
+            captured["user_pk"] = request.user.pk
+            return {
+                "user_pk_claim": str(request.user.pk),
+            }
+
+    oidc_tokens.oauth2_settings.OAUTH2_VALIDATOR_CLASS = CustomValidator
+    auth_header = "Bearer %s" % oidc_tokens.access_token
+    rsp = client.get(
+        reverse("oauth2_provider:user-info"),
+        HTTP_AUTHORIZATION=auth_header,
+    )
+    assert rsp.status_code == 200
+    data = rsp.json()
+
+    assert captured.get("user_pk") == oidc_tokens.user.pk
+
+    assert data.get("user_pk_claim") == str(oidc_tokens.user.pk)
+
+    assert data.get("sub") == str(oidc_tokens.user.pk)
+
+
+@pytest.mark.django_db
+def test_userinfo_endpoint_subclass_dict_multiple_claims(
+    oidc_tokens, client, oauth2_settings
+):
+    """A subclass override returning a dict with multiple static claims
+    must surface every (key, value) pair in the userinfo JSON response.
+    """
+
+    class CustomValidator(OAuth2Validator):
+        def get_additional_claims(self, request):
+            return {
+                "given_name": "Alice",
+                "family_name": "Liddell",
+                "custom_flag": "wonderland",
+            }
+
+    oidc_tokens.oauth2_settings.OAUTH2_VALIDATOR_CLASS = CustomValidator
+    auth_header = "Bearer %s" % oidc_tokens.access_token
+    rsp = client.get(
+        reverse("oauth2_provider:user-info"),
+        HTTP_AUTHORIZATION=auth_header,
+    )
+    assert rsp.status_code == 200
+    data = rsp.json()
+    assert data.get("given_name") == "Alice"
+    assert data.get("family_name") == "Liddell"
+    assert data.get("custom_flag") == "wonderland"
+    assert data.get("sub") == str(oidc_tokens.user.pk)
+
+
+@pytest.mark.django_db
+def test_userinfo_endpoint_default_validator_returns_only_sub(
+    oidc_tokens, client, oauth2_settings
+):
+    """With the unmodified default OAuth2Validator (no subclassing),
+    the userinfo endpoint must still return the required `sub` claim
+    and the call path through get_additional_claims(request) must not
+    error out.
+    """
+    auth_header = "Bearer %s" % oidc_tokens.access_token
+    rsp = client.get(
+        reverse("oauth2_provider:user-info"),
+        HTTP_AUTHORIZATION=auth_header,
+    )
+    assert rsp.status_code == 200
+    data = rsp.json()
+    assert data.get("sub") == str(oidc_tokens.user.pk)
