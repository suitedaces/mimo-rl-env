+package image_test
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	operatorv1alpha1 "github.com/openshift/api/operator/v1alpha1"
+	"sigs.k8s.io/yaml"
+
+	"github.com/openshift/installer/pkg/asset/agent/image"
+	"github.com/openshift/installer/pkg/asset/agent/mirror"
+)
+
+func TestCodespecReleaseExtractionGroupsEveryMirrorBySource(t *testing.T) {
+	binDir := t.TempDir()
+	ocPath := filepath.Join(binDir, "oc")
+	if err := os.WriteFile(ocPath, []byte("#!/bin/sh\nexit 0\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", binDir+string(os.PathListSeparator)+os.Getenv("PATH"))
+	t.Setenv("XDG_CACHE_HOME", t.TempDir())
+
+	exec := &recordingExecuter{t: t}
+	release := image.NewRelease(exec, image.Config{MaxTries: 1},
+		"registry.example.test/release:latest", "{}", []mirror.RegistriesConfig{
+			{Location: "registry.example.test/release", Mirror: "mirror-a.test/release"},
+			{Location: "registry.example.test/release", Mirror: "mirror-b.test/release"},
+			{Location: "registry.example.test/content", Mirror: "mirror-a.test/content"},
+			{Location: "registry.example.test/release", Mirror: "mirror-c.test/release"},
+		})
+
+	if _, err := release.ExtractFile("agent-installer-node-agent", "/usr/bin/agent"); err != nil {
+		t.Fatalf("ExtractFile() returned an error: %v", err)
+	}
+	if len(exec.policies) != 2 {
+		t.Fatalf("expected release lookup and image extraction to each receive an ICSP, got %d policies", len(exec.policies))
+	}
+
+	want := []operatorv1alpha1.RepositoryDigestMirrors{
+		{Source: "registry.example.test/release", Mirrors: []string{"mirror-a.test/release", "mirror-b.test/release", "mirror-c.test/release"}},
+		{Source: "registry.example.test/content", Mirrors: []string{"mirror-a.test/content"}},
+	}
+	for i, policy := range exec.policies {
+		if !reflect.DeepEqual(policy.Spec.RepositoryDigestMirrors, want) {
+			t.Errorf("operation %d ICSP mismatch\nwant: %#v\n got: %#v", i, want, policy.Spec.RepositoryDigestMirrors)
+		}
+	}
+}
+
+type recordingExecuter struct {
+	t        *testing.T
+	policies []operatorv1alpha1.ImageContentSourcePolicy
+	calls    int
+}
+
+func (e *recordingExecuter) Execute(command string, args ...string) (string, string, int) {
+	e.t.Helper()
+	if command != "oc" {
+		e.t.Errorf("unexpected executable %q", command)
+	}
+	var policyPath string
+	for _, arg := range args {
+		if strings.HasPrefix(arg, "--icsp-file=") {
+			policyPath = strings.TrimPrefix(arg, "--icsp-file=")
+			break
+		}
+	}
+	if policyPath == "" {
+		e.t.Errorf("oc call did not include --icsp-file: %v", args)
+		return "", "missing ICSP", 1
+	}
+	data, err := os.ReadFile(policyPath)
+	if err != nil {
+		e.t.Errorf("reading ICSP: %v", err)
+		return "", err.Error(), 1
+	}
+	var policy operatorv1alpha1.ImageContentSourcePolicy
+	if err := yaml.Unmarshal(data, &policy); err != nil {
+		e.t.Errorf("decoding ICSP: %v", err)
+		return "", err.Error(), 1
+	}
+	e.policies = append(e.policies, policy)
+	e.calls++
+	if e.calls == 1 {
+		return "registry.example.test/payload:latest", "", 0
+	}
+	for i, arg := range args {
+		if arg != "--path" || i+1 >= len(args) {
+			continue
+		}
+		parts := strings.SplitN(args[i+1], ":", 2)
+		if len(parts) != 2 {
+			continue
+		}
+		extractedPath := filepath.Join(parts[1], filepath.Base(parts[0]))
+		if err := os.WriteFile(extractedPath, []byte("test payload"), 0o600); err != nil {
+			e.t.Errorf("creating simulated extracted file: %v", err)
+			return "", err.Error(), 1
+		}
+	}
+	return "", "", 0
+}
+
+func (e *recordingExecuter) ExecuteWithContext(context.Context, string, ...string) (string, string, int) {
+	e.t.Helper()
+	e.t.Fatal("unexpected ExecuteWithContext call")
+	return "", "", 1
+}
+
+func (e *recordingExecuter) TempFile(dir, pattern string) (*os.File, error) {
+	return os.CreateTemp(dir, pattern)
+}
