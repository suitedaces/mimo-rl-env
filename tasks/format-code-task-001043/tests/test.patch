+package mirror_test
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+
+	"github.com/openshift/installer/pkg/asset"
+	"github.com/openshift/installer/pkg/asset/agent"
+	"github.com/openshift/installer/pkg/asset/agent/mirror"
+	"github.com/openshift/installer/pkg/asset/installconfig"
+	"github.com/openshift/installer/pkg/asset/releaseimage"
+	"github.com/openshift/installer/pkg/types"
+)
+
+func TestCodespecRegistriesConfGeneratedProjectionKeepsAllMirrors(t *testing.T) {
+	parents := asset.Parents{}
+	parents.Add(
+		&agent.OptionalInstallConfig{
+			Supplied: true,
+			InstallConfig: installconfig.InstallConfig{Config: &types.InstallConfig{
+				ObjectMeta: metav1.ObjectMeta{Namespace: "projection-test"},
+				ImageContentSources: []types.ImageContentSource{
+					{Source: "registry.example.test/release", Mirrors: []string{"mirror-a.test/release", "mirror-b.test/release", "mirror-a.test/release"}},
+					{Source: "registry.example.test/content"},
+					{Source: "registry.example.test/release", Mirrors: []string{"mirror-b.test/release", "mirror-c.test/release"}},
+					{Source: "registry.example.test/content", Mirrors: []string{"mirror-a.test/content"}},
+				},
+			}},
+		},
+		&releaseimage.Image{PullSpec: "registry.example.test/release:latest"},
+	)
+
+	got := &mirror.RegistriesConf{}
+	if err := got.Generate(parents); err != nil {
+		t.Fatalf("Generate() returned an error: %v", err)
+	}
+
+	wantProjection := []mirror.RegistriesConfig{
+		{Location: "registry.example.test/release", Mirror: "mirror-a.test/release"},
+		{Location: "registry.example.test/release", Mirror: "mirror-b.test/release"},
+		{Location: "registry.example.test/release", Mirror: "mirror-c.test/release"},
+		{Location: "registry.example.test/content", Mirror: "mirror-a.test/content"},
+	}
+	if !reflect.DeepEqual(got.MirrorConfig, wantProjection) {
+		t.Errorf("generated MirrorConfig mismatch\nwant: %#v\n got: %#v", wantProjection, got.MirrorConfig)
+	}
+
+	if got.Config == nil || len(got.Config.Registries) != 2 {
+		t.Fatalf("generated registries.conf should contain two source entries, got %#v", got.Config)
+	}
+	wantMirrors := [][]string{
+		{"mirror-a.test/release", "mirror-b.test/release", "mirror-c.test/release"},
+		{"mirror-a.test/content"},
+	}
+	for i, registry := range got.Config.Registries {
+		var locations []string
+		for _, endpoint := range registry.Mirrors {
+			locations = append(locations, endpoint.Location)
+		}
+		if !reflect.DeepEqual(locations, wantMirrors[i]) {
+			t.Errorf("registry %d mirror order mismatch: want %v, got %v", i, wantMirrors[i], locations)
+		}
+	}
+}
+
+func TestCodespecRegistriesConfLoadedProjectionNormalizesRepeatedSources(t *testing.T) {
+	contents := []byte(`
+[[registry]]
+location = "registry.example.test/release"
+[[registry.mirror]]
+location = "mirror-a.test/release"
+[[registry.mirror]]
+location = "mirror-b.test/release"
+
+[[registry]]
+location = "registry.example.test/content"
+[[registry.mirror]]
+location = "mirror-a.test/content"
+
+[[registry]]
+location = "registry.example.test/release"
+[[registry.mirror]]
+location = "mirror-b.test/release"
+[[registry.mirror]]
+location = "mirror-c.test/release"
+`)
+	got := &mirror.RegistriesConf{}
+	found, err := got.Load(singleFileFetcher{file: &asset.File{Filename: mirror.RegistriesConfFilename, Data: contents}})
+	if err != nil || !found {
+		t.Fatalf("Load() = (%v, %v), want (true, nil)", found, err)
+	}
+
+	want := []mirror.RegistriesConfig{
+		{Location: "registry.example.test/release", Mirror: "mirror-a.test/release"},
+		{Location: "registry.example.test/release", Mirror: "mirror-b.test/release"},
+		{Location: "registry.example.test/release", Mirror: "mirror-c.test/release"},
+		{Location: "registry.example.test/content", Mirror: "mirror-a.test/content"},
+	}
+	if !reflect.DeepEqual(got.MirrorConfig, want) {
+		t.Errorf("loaded MirrorConfig mismatch\nwant: %#v\n got: %#v", want, got.MirrorConfig)
+	}
+}
+
+func TestCodespecRegistriesConfLoadAllowsSourcesWithoutMirrors(t *testing.T) {
+	contents := []byte(`
+unqualified-search-registries = ["registry.access.redhat.com"]
+
+[[registry]]
+location = "registry.example.test/passthrough"
+
+[[registry]]
+location = "registry.example.test/mirrored"
+[[registry.mirror]]
+location = "mirror.example.test/mirrored"
+`)
+	got := &mirror.RegistriesConf{}
+	var found bool
+	var err error
+	panicked := didPanic(func() {
+		found, err = got.Load(singleFileFetcher{file: &asset.File{Filename: mirror.RegistriesConfFilename, Data: contents}})
+	})
+	if panicked {
+		t.Fatal("Load() panicked for a valid registry entry with no mirrors")
+	}
+	if err != nil || !found {
+		t.Fatalf("Load() = (%v, %v), want (true, nil)", found, err)
+	}
+	want := []mirror.RegistriesConfig{{
+		Location: "registry.example.test/mirrored",
+		Mirror:   "mirror.example.test/mirrored",
+	}}
+	if !reflect.DeepEqual(got.MirrorConfig, want) {
+		t.Errorf("unmirrored sources must be omitted from MirrorConfig: want %#v, got %#v", want, got.MirrorConfig)
+	}
+	if got.Config == nil || len(got.Config.Registries) != 2 {
+		t.Errorf("Load() must retain both registry entries in Config, got %#v", got.Config)
+	}
+}
+
+func didPanic(fn func()) (panicked bool) {
+	defer func() {
+		panicked = recover() != nil
+	}()
+	fn()
+	return false
+}
+
+type singleFileFetcher struct {
+	file *asset.File
+	err  error
+}
+
+func (f singleFileFetcher) FetchByName(string) (*asset.File, error) {
+	if f.err != nil {
+		return nil, f.err
+	}
+	if f.file == nil {
+		return nil, errors.New("file not found")
+	}
+	return f.file, nil
+}
+
+func (singleFileFetcher) FetchByPattern(string) ([]*asset.File, error) {
+	return nil, errors.New("unexpected FetchByPattern call")
+}
