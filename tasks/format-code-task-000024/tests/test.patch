+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+npm install --ignore-scripts 2>/dev/null
+
+mkdir -p /testbed/.fixture_tmp
+cat > /testbed/.fixture_tmp/date-now-shim.js <<'SHIMEOF'
+var _origNow = Date.now.bind(Date);
+Date.now = function DateNowProxy() { return _origNow(); };
+SHIMEOF
+
+
+case "${1:-}" in
+  base)
+    NODE_ENV=test node_modules/.bin/mocha \
+      --compilers js:babel-register \
+      --require /testbed/.fixture_tmp/date-now-shim.js \
+      test/create-market/selectors/form-steps/step-3-test.js
+    ;;
+  new)
+    NODE_ENV=test node_modules/.bin/mocha \
+      --compilers js:babel-register \
+      --require /testbed/.fixture_tmp/date-now-shim.js \
+      test/create-market/selectors/form-steps/step-2-categorical-validation-test.js \
+      test/create-market/selectors/form-steps/step-3-test.js
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
