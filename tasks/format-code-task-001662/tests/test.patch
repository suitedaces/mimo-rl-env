+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+
+rm -f /.dockerenv
+
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 -timeout 120s ./hscontrol/util/...
+    ;;
+  new)
+    go test -v -count=1 -timeout 120s ./hscontrol/routes/... \
+      -run 'TestPrimaryRoutes(SingleAdvertiserBecomesPrimary|SingleAdvertiserUsesMoreThanOnePrefix|IgnoreExitOnlyAdvertisers|IgnoreExitRoutesWhenMixedWithSubnetRoutes)$'
+    routes_status=$?
+
+    go test -v -count=1 -timeout 120s ./hscontrol/mapper/... \
+      -run 'TestReadOnlyMapResponseAllowedIPsUsePrimaryAndExitRoutes$'
+    mapper_status=$?
+
+    if [[ "${routes_status}" -ne 0 || "${mapper_status}" -ne 0 ]]; then
+      exit 1
+    fi
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
