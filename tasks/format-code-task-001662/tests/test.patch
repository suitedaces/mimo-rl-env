+func allowedPrefixSet(prefixes []netip.Prefix) map[netip.Prefix]struct{} {
+	ret := make(map[netip.Prefix]struct{}, len(prefixes))
+	for _, prefix := range prefixes {
+		ret[prefix] = struct{}{}
+	}
+
+	return ret
+}
+
+func requireAllowedContains(t *testing.T, node *tailcfg.Node, prefix netip.Prefix) {
+	t.Helper()
+
+	if _, ok := allowedPrefixSet(node.AllowedIPs)[prefix]; !ok {
+		t.Fatalf("AllowedIPs for %q does not contain %s: %v", node.Name, prefix, node.AllowedIPs)
+	}
+}
+
+func requireAllowedDoesNotContain(t *testing.T, node *tailcfg.Node, prefix netip.Prefix) {
+	t.Helper()
+
+	if _, ok := allowedPrefixSet(node.AllowedIPs)[prefix]; ok {
+		t.Fatalf("AllowedIPs for %q unexpectedly contains %s: %v", node.Name, prefix, node.AllowedIPs)
+	}
+}
+
+func mapResponseNode(t *testing.T, node *types.Node, primary *routes.PrimaryRoutes) *tailcfg.Node {
+	t.Helper()
+
+	polMan, err := policy.NewPolicyManager(nil, []types.User{node.User}, types.Nodes{node})
+	require.NoError(t, err)
+
+	m := NewMapper(
+		nil,
+		&types.Config{},
+		nil,
+		nil,
+		polMan,
+		primary,
+	)
+	body, err := m.ReadOnlyMapResponse(tailcfg.MapRequest{}, node)
+	require.NoError(t, err)
+	require.GreaterOrEqual(t, len(body), 4)
+
+	var resp tailcfg.MapResponse
+	require.NoError(t, json.Unmarshal(body[4:], &resp))
+	require.NotNil(t, resp.Node)
+
+	return resp.Node
+}
+
+func routeTestNode(id types.NodeID, name, ip string, routes []netip.Prefix) *types.Node {
+	addr := netip.MustParseAddr(ip)
+
+	return &types.Node{
+		ID:        id,
+		IPv4:      &addr,
+		Hostname:  name,
+		GivenName: name,
+		UserID:    uint(id),
+		User: types.User{
+			Name: name,
+		},
+		ForcedTags: []string{},
+		Hostinfo: &tailcfg.Hostinfo{
+			RoutableIPs: routes,
+		},
+		ApprovedRoutes: routes,
+	}
+}
