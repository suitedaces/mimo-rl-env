+func TestReadOnlyMapResponseAllowedIPsUsePrimaryAndExitRoutes(t *testing.T) {
+	primarySubnet := netip.MustParsePrefix("192.168.77.0/24")
+	primary := routes.New()
+	primary.SetRoutes(types.NodeID(701), primarySubnet)
+	primary.SetRoutes(types.NodeID(702), primarySubnet)
+
+	primaryOwner := routeTestNode(types.NodeID(701), "primary-owner", "100.64.0.1", []netip.Prefix{primarySubnet})
+	nonPrimaryAdvertiser := routeTestNode(types.NodeID(702), "non-primary-advertiser", "100.64.0.2", []netip.Prefix{primarySubnet})
+	exitAdvertiser := routeTestNode(types.NodeID(703), "exit-advertiser", "100.64.0.3", []netip.Prefix{tsaddr.AllIPv4()})
+
+	primaryTailNode := mapResponseNode(t, primaryOwner, primary)
+	nonPrimaryTailNode := mapResponseNode(t, nonPrimaryAdvertiser, primary)
+	exitTailNode := mapResponseNode(t, exitAdvertiser, primary)
+
+	requireAllowedContains(t, primaryTailNode, netip.MustParsePrefix("100.64.0.1/32"))
+	requireAllowedContains(t, primaryTailNode, primarySubnet)
+	requireAllowedDoesNotContain(t, nonPrimaryTailNode, primarySubnet)
+	requireAllowedContains(t, exitTailNode, tsaddr.AllIPv4())
+	requireAllowedContains(t, exitTailNode, tsaddr.AllIPv6())
+	requireAllowedDoesNotContain(t, exitTailNode, primarySubnet)
+
+	secondPrimarySubnet := netip.MustParsePrefix("10.44.0.0/16")
+	secondPrimary := routes.New()
+	secondPrimary.SetRoutes(types.NodeID(801), secondPrimarySubnet)
+	secondPrimary.SetRoutes(types.NodeID(802), secondPrimarySubnet)
+
+	secondPrimaryOwner := routeTestNode(types.NodeID(801), "second-primary-owner", "100.64.0.11", []netip.Prefix{secondPrimarySubnet})
+	secondPrimaryTailNode := mapResponseNode(t, secondPrimaryOwner, secondPrimary)
+
+	requireAllowedContains(t, secondPrimaryTailNode, netip.MustParsePrefix("100.64.0.11/32"))
+	requireAllowedContains(t, secondPrimaryTailNode, secondPrimarySubnet)
+}
