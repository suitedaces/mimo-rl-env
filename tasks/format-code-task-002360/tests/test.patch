+package property_test
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/pulumi/pulumi/sdk/v3/go/common/resource/archive"
+	"github.com/pulumi/pulumi/sdk/v3/go/common/resource/asset"
+	"github.com/pulumi/pulumi/sdk/v3/go/common/resource/urn"
+	"github.com/pulumi/pulumi/sdk/v3/go/property"
+)
+
+func mustAsset(t *testing.T, text string) *asset.Asset {
+	t.Helper()
+	a, err := asset.FromText(text)
+	require.NoError(t, err)
+	return a
+}
+
+func mustArchive(t *testing.T, name, text string) *archive.Archive {
+	t.Helper()
+	a, err := archive.FromAssets(map[string]interface{}{name: mustAsset(t, text)})
+	require.NoError(t, err)
+	return a
+}
+
+func TestZeroValueIsNull(t *testing.T) {
+	t.Parallel()
+
+	var zero property.Value
+	assert.True(t, zero.IsNull())
+	assert.True(t, property.New(property.Null).IsNull())
+	assert.True(t, property.New(property.Null).Equals(zero))
+	assert.True(t, zero.Equals(property.New(property.Null)))
+}
+
+func TestNilNormalization(t *testing.T) {
+	t.Parallel()
+
+	var zero property.Value
+
+	t.Run("array", func(t *testing.T) {
+		t.Parallel()
+		v := property.New(property.Array(nil))
+		assert.True(t, v.IsNull())
+		assert.False(t, v.IsArray())
+		assert.True(t, v.Equals(zero))
+
+
+		assert.True(t, property.New(property.Array{}).IsArray())
+		assert.False(t, property.New(property.Array{}).IsNull())
+	})
+
+	t.Run("map", func(t *testing.T) {
+		t.Parallel()
+		v := property.New(property.Map(nil))
+		assert.True(t, v.IsNull())
+		assert.False(t, v.IsMap())
+
+		assert.True(t, property.New(property.Map{}).IsMap())
+		assert.False(t, property.New(property.Map{}).IsNull())
+	})
+
+	t.Run("asset", func(t *testing.T) {
+		t.Parallel()
+		v := property.New((*asset.Asset)(nil))
+		assert.True(t, v.IsNull())
+		assert.False(t, v.IsAsset())
+	})
+
+	t.Run("archive", func(t *testing.T) {
+		t.Parallel()
+		v := property.New((*archive.Archive)(nil))
+		assert.True(t, v.IsNull())
+		assert.False(t, v.IsArchive())
+	})
+}
+
+func TestPrimitiveContent(t *testing.T) {
+	t.Parallel()
+
+	b := property.New(true)
+	assert.True(t, b.IsBool())
+	assert.Equal(t, true, b.AsBool())
+	assert.False(t, b.IsNumber())
+	assert.False(t, b.IsString())
+	assert.False(t, b.IsNull())
+
+	n := property.New(3.5)
+	assert.True(t, n.IsNumber())
+	assert.Equal(t, 3.5, n.AsNumber())
+	assert.False(t, n.IsBool())
+
+	s := property.New("hello")
+	assert.True(t, s.IsString())
+	assert.Equal(t, "hello", s.AsString())
+	assert.False(t, s.IsNumber())
+}
+
+func TestArrayContent(t *testing.T) {
+	t.Parallel()
+
+	v := property.New(property.Array{property.New("a"), property.New(true)})
+	assert.True(t, v.IsArray())
+	arr := v.AsArray()
+	require.Len(t, arr, 2)
+	assert.Equal(t, "a", arr[0].AsString())
+	assert.Equal(t, true, arr[1].AsBool())
+}
+
+func TestMapContent(t *testing.T) {
+	t.Parallel()
+
+	v := property.New(property.Map{"k": property.New(1.0)})
+	assert.True(t, v.IsMap())
+	m := v.AsMap()
+	require.Contains(t, m, property.MapKey("k"))
+	assert.Equal(t, 1.0, m["k"].AsNumber())
+}
+
+func TestAssetContent(t *testing.T) {
+	t.Parallel()
+
+	a := mustAsset(t, "some text")
+	v := property.New(a)
+	assert.True(t, v.IsAsset())
+	assert.True(t, v.AsAsset().Equals(a))
+	assert.False(t, v.IsArchive())
+}
+
+func TestArchiveContent(t *testing.T) {
+	t.Parallel()
+
+	a := mustArchive(t, "f.txt", "some text")
+	v := property.New(a)
+	assert.True(t, v.IsArchive())
+	assert.True(t, v.AsArchive().Equals(a))
+	assert.False(t, v.IsAsset())
+}
+
+func TestComputedContent(t *testing.T) {
+	t.Parallel()
+
+	v := property.New(property.Computed)
+	assert.True(t, v.IsComputed())
+	assert.False(t, v.IsNull())
+	assert.False(t, v.IsString())
+	assert.True(t, v.HasComputed())
+}
+
+func TestResourceReferenceContent(t *testing.T) {
+	t.Parallel()
+
+	ref := property.ResourceReference{
+		URN:            urn.URN("urn:pulumi:stack::proj::type::name"),
+		ID:             property.New("id-1"),
+		PackageVersion: "1.2.3",
+	}
+	v := property.New(ref)
+	assert.True(t, v.IsResourceReference())
+	got := v.AsResourceReference()
+	assert.Equal(t, urn.URN("urn:pulumi:stack::proj::type::name"), got.URN)
+	assert.Equal(t, "1.2.3", got.PackageVersion)
+	assert.Equal(t, "id-1", got.ID.AsString())
+}
+
+func TestNotComparable(t *testing.T) {
+	t.Parallel()
+	assert.False(t, reflect.TypeOf(property.Value{}).Comparable())
+}
+
+func TestImmutability(t *testing.T) {
+	t.Parallel()
+
+	base := property.New("a")
+
+	secret := base.WithSecret(true)
+	assert.True(t, secret.Secret())
+	assert.False(t, base.Secret(), "WithSecret must not mutate the receiver")
+
+	deps := []urn.URN{"urn:a"}
+	withDeps := base.WithDependencies(deps)
+	assert.Equal(t, deps, withDeps.Dependencies())
+	assert.Empty(t, base.Dependencies(), "WithDependencies must not mutate the receiver")
+}
+
+func TestSecretReportingIsShallow(t *testing.T) {
+	t.Parallel()
+
+	assert.False(t, property.New("a").Secret())
+	assert.False(t, property.New("a").HasSecrets())
+
+	leafSecret := property.New("a").WithSecret(true)
+	assert.True(t, leafSecret.Secret())
+	assert.True(t, leafSecret.HasSecrets())
+
+	nestedInArray := property.New(property.Array{leafSecret})
+	assert.False(t, nestedInArray.Secret(), "Secret() must not look inside nested values")
+	assert.True(t, nestedInArray.HasSecrets())
+
+	nestedInMap := property.New(property.Map{"k": leafSecret})
+	assert.False(t, nestedInMap.Secret())
+	assert.True(t, nestedInMap.HasSecrets())
+}
+
+func TestComputedReporting(t *testing.T) {
+	t.Parallel()
+
+	assert.False(t, property.New("a").HasComputed())
+	assert.True(t, property.New(property.Array{property.New(property.Computed)}).HasComputed())
+	assert.True(t, property.New(property.Map{"k": property.New(property.Computed)}).HasComputed())
+}
+
+func TestEqualsContent(t *testing.T) {
+	t.Parallel()
+
+	assert.True(t, property.New("a").Equals(property.New("a")))
+	assert.False(t, property.New("a").Equals(property.New("b")))
+
+	assert.True(t, property.New(1.0).Equals(property.New(1.0)))
+	assert.False(t, property.New(1.0).Equals(property.New(2.0)))
+
+	assert.True(t, property.New(true).Equals(property.New(true)))
+	assert.False(t, property.New(true).Equals(property.New(false)))
+
+
+	assert.False(t, property.New("a").Equals(property.New(1.0)))
+	assert.False(t, property.New(true).Equals(property.New("true")))
+	assert.False(t, property.New(property.Null).Equals(property.New("a")))
+}
+
+func TestEqualsSecretSensitive(t *testing.T) {
+	t.Parallel()
+
+	a := property.New("a")
+	assert.False(t, a.WithSecret(true).Equals(a))
+	assert.False(t, a.Equals(a.WithSecret(true)))
+	assert.True(t, a.WithSecret(true).Equals(a.WithSecret(true)))
+}
+
+func TestEqualsDependencySensitive(t *testing.T) {
+	t.Parallel()
+
+	a := property.New("a")
+	assert.False(t, a.WithDependencies([]urn.URN{"u1"}).Equals(a))
+	assert.True(t,
+		a.WithDependencies([]urn.URN{"u1", "u2"}).Equals(a.WithDependencies([]urn.URN{"u1", "u2"})))
+
+	assert.False(t,
+		a.WithDependencies([]urn.URN{"u1", "u2"}).Equals(a.WithDependencies([]urn.URN{"u2", "u1"})))
+}
+
+func TestEqualsArrays(t *testing.T) {
+	t.Parallel()
+
+	mk := func(elems ...property.Value) property.Value { return property.New(property.Array(elems)) }
+
+	assert.True(t, mk(property.New("a"), property.New(1.0)).Equals(mk(property.New("a"), property.New(1.0))))
+	assert.False(t, mk(property.New("a")).Equals(mk(property.New("a"), property.New(1.0))))
+	assert.False(t, mk(property.New("a")).Equals(mk(property.New("b"))))
+
+
+	assert.False(t, mk(property.New("a").WithSecret(true)).Equals(mk(property.New("a"))))
+}
+
+func TestEqualsMaps(t *testing.T) {
+	t.Parallel()
+
+	m := func(kv property.Map) property.Value { return property.New(kv) }
+
+	assert.True(t, m(property.Map{"a": property.New(1.0)}).Equals(m(property.Map{"a": property.New(1.0)})))
+	assert.False(t, m(property.Map{"a": property.New(1.0)}).Equals(m(property.Map{"a": property.New(2.0)})))
+
+	assert.False(t, m(property.Map{"a": property.New(1.0)}).Equals(m(property.Map{"b": property.New(1.0)})))
+	assert.False(t,
+		m(property.Map{"a": property.New(1.0)}).Equals(m(property.Map{"a": property.New(1.0), "b": property.New(2.0)})))
+}
+
+func TestEqualsComputedDefault(t *testing.T) {
+	t.Parallel()
+
+	c := property.New(property.Computed)
+	assert.True(t, c.Equals(property.New(property.Computed)))
+	assert.False(t, c.Equals(property.New("a")))
+	assert.False(t, property.New("a").Equals(c))
+	assert.False(t, c.Equals(property.New(property.Null)))
+}
+
+func TestEqualsRelaxComputed(t *testing.T) {
+	t.Parallel()
+
+	c := property.New(property.Computed)
+	assert.True(t, c.Equals(property.New("a"), property.EqualRelaxComputed))
+	assert.True(t, property.New("a").Equals(c, property.EqualRelaxComputed))
+	assert.True(t, c.Equals(property.New(property.Computed), property.EqualRelaxComputed))
+
+
+	assert.False(t, c.WithSecret(true).Equals(property.New("a"), property.EqualRelaxComputed))
+
+
+	relaxed := property.New(property.Array{property.New(property.Computed)})
+	concrete := property.New(property.Array{property.New("a")})
+	assert.False(t, relaxed.Equals(concrete))
+	assert.True(t, relaxed.Equals(concrete, property.EqualRelaxComputed))
+}
+
+func TestEqualsAssetsAndArchives(t *testing.T) {
+	t.Parallel()
+
+	a1 := property.New(mustAsset(t, "a"))
+	a2 := property.New(mustAsset(t, "a"))
+	a3 := property.New(mustAsset(t, "b"))
+	assert.True(t, a1.Equals(a2))
+	assert.False(t, a1.Equals(a3))
+
+	r1 := property.New(mustArchive(t, "f", "a"))
+	r2 := property.New(mustArchive(t, "f", "a"))
+	r3 := property.New(mustArchive(t, "f", "b"))
+	assert.True(t, r1.Equals(r2))
+	assert.False(t, r1.Equals(r3))
+
+
+	assert.False(t, a1.Equals(r1))
+}
+
+func TestEqualsResourceReferences(t *testing.T) {
+	t.Parallel()
+
+	mkRef := func(u urn.URN, id property.Value, version string) property.Value {
+		return property.New(property.ResourceReference{URN: u, ID: id, PackageVersion: version})
+	}
+
+	base := mkRef("urn:a", property.New("id-1"), "1.0.0")
+
+	assert.True(t, base.Equals(mkRef("urn:a", property.New("id-1"), "1.0.0")))
+	assert.False(t, base.Equals(mkRef("urn:b", property.New("id-1"), "1.0.0")))
+	assert.False(t, base.Equals(mkRef("urn:a", property.New("id-2"), "1.0.0")))
+	assert.False(t, base.Equals(mkRef("urn:a", property.New("id-1"), "2.0.0")))
+
+
+	computedID := mkRef("urn:a", property.New(property.Computed), "1.0.0")
+	assert.True(t, computedID.Equals(base))
+	assert.True(t, base.Equals(computedID))
+
+	assert.False(t, computedID.Equals(mkRef("urn:b", property.New("id-1"), "1.0.0")))
+}
