+++ b/alicloud/resource_alicloud_cs_application_contract_test.go
@@ -0,0 +1,244 @@
+package alicloud
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/hashicorp/terraform/helper/schema"
+)
+
+
+
+
+func csApplicationResource(t *testing.T) *schema.Resource {
+	p, ok := Provider().(*schema.Provider)
+	if !ok {
+		t.Fatalf("Provider() did not return a *schema.Provider")
+	}
+	if err := p.InternalValidate(); err != nil {
+		t.Fatalf("provider failed InternalValidate: %v", err)
+	}
+	r, ok := p.ResourcesMap["alicloud_cs_application"]
+	if !ok {
+		t.Fatalf("resource type alicloud_cs_application is not registered with the provider")
+	}
+	if r == nil {
+		t.Fatalf("resource alicloud_cs_application is nil")
+	}
+	return r
+}
+
+func TestCSApplicationResourceShape(t *testing.T) {
+	r := csApplicationResource(t)
+
+
+	if r.Importer == nil {
+		t.Fatalf("alicloud_cs_application must be importable")
+	}
+
+
+	if r.Create == nil || r.Read == nil || r.Update == nil || r.Delete == nil {
+		t.Fatalf("alicloud_cs_application must implement create/read/update/delete")
+	}
+
+	field := func(name string) *schema.Schema {
+		s, ok := r.Schema[name]
+		if !ok {
+			t.Fatalf("alicloud_cs_application is missing attribute %q", name)
+		}
+		return s
+	}
+
+
+	cn := field("cluster_name")
+	if cn.Type != schema.TypeString {
+		t.Errorf("cluster_name should be a string")
+	}
+	if !cn.Required {
+		t.Errorf("cluster_name should be required")
+	}
+	if !cn.ForceNew {
+		t.Errorf("cluster_name should be force-new")
+	}
+
+
+	nm := field("name")
+	if nm.Type != schema.TypeString {
+		t.Errorf("name should be a string")
+	}
+	if !nm.Required {
+		t.Errorf("name should be required")
+	}
+	if !nm.ForceNew {
+		t.Errorf("name should be force-new")
+	}
+	if nm.ValidateFunc == nil {
+		t.Errorf("name should have a validation function")
+	}
+
+
+	tmpl := field("template")
+	if tmpl.Type != schema.TypeString {
+		t.Errorf("template should be a string")
+	}
+	if !tmpl.Required {
+		t.Errorf("template should be required")
+	}
+	if tmpl.ValidateFunc == nil {
+		t.Errorf("template should have a validation function")
+	}
+
+
+	desc := field("description")
+	if desc.Type != schema.TypeString {
+		t.Errorf("description should be a string")
+	}
+	if !desc.Optional {
+		t.Errorf("description should be optional")
+	}
+
+
+	ver := field("version")
+	if ver.Type != schema.TypeString {
+		t.Errorf("version should be a string")
+	}
+	if !ver.Optional {
+		t.Errorf("version should be optional")
+	}
+	if ver.Default != "1.0" {
+		t.Errorf("version should default to \"1.0\", got %#v", ver.Default)
+	}
+
+
+	env := field("environment")
+	if env.Type != schema.TypeMap {
+		t.Errorf("environment should be a map")
+	}
+	if !env.Optional {
+		t.Errorf("environment should be optional")
+	}
+
+
+	for _, name := range []string{"latest_image", "blue_green", "blue_green_confirm"} {
+		b := field(name)
+		if b.Type != schema.TypeBool {
+			t.Errorf("%s should be a bool", name)
+		}
+		if !b.Optional {
+			t.Errorf("%s should be optional", name)
+		}
+		if b.Default != false {
+			t.Errorf("%s should default to false, got %#v", name, b.Default)
+		}
+	}
+
+
+	svc := field("services")
+	if svc.Type != schema.TypeList {
+		t.Errorf("services should be a list")
+	}
+	if !svc.Computed {
+		t.Errorf("services should be computed")
+	}
+
+
+	dd := field("default_domain")
+	if dd.Type != schema.TypeString {
+		t.Errorf("default_domain should be a string")
+	}
+	if !dd.Computed {
+		t.Errorf("default_domain should be computed")
+	}
+}
+
+func TestCSApplicationNameValidation(t *testing.T) {
+	r := csApplicationResource(t)
+	vf := r.Schema["name"].ValidateFunc
+	if vf == nil {
+		t.Fatalf("name has no validation function")
+	}
+
+	valid := []string{
+		"app",
+		"App",
+		"a",
+		"my-app-123",
+		"App-1",
+		strings.Repeat("a", 64),
+	}
+	for _, v := range valid {
+		_, errs := vf(v, "name")
+		if len(errs) != 0 {
+			t.Errorf("%q should be a valid application name, got errors: %v", v, errs)
+		}
+	}
+
+	invalid := []string{
+		"",
+		"-app",
+		"app_1",
+		"app.name",
+		"app name",
+		"app/name",
+		"中文",
+		strings.Repeat("a", 65),
+	}
+	for _, v := range invalid {
+		_, errs := vf(v, "name")
+		if len(errs) == 0 {
+			t.Errorf("%q should be an invalid application name", v)
+		}
+	}
+}
+
+func TestCSApplicationTemplateValidation(t *testing.T) {
+	r := csApplicationResource(t)
+	vf := r.Schema["template"].ValidateFunc
+	if vf == nil {
+		t.Fatalf("template has no validation function")
+	}
+
+	valid := []string{
+		"web:\n  image: nginx\n  ports:\n    - 8080\n",
+		"key: value\n",
+	}
+	for _, v := range valid {
+		_, errs := vf(v, "template")
+		if len(errs) != 0 {
+			t.Errorf("template %q should be valid YAML, got errors: %v", v, errs)
+		}
+	}
+
+	invalid := []string{
+		"foo: [unclosed",
+		"a:\n  - b\n c: d",
+		"\tfoo: bar",
+	}
+	for _, v := range invalid {
+		_, errs := vf(v, "template")
+		if len(errs) == 0 {
+			t.Errorf("template %q should be rejected as invalid YAML", v)
+		}
+	}
+}
+
+func TestCSApplicationTemplateNormalization(t *testing.T) {
+	r := csApplicationResource(t)
+	sf := r.Schema["template"].StateFunc
+	if sf == nil {
+		t.Fatalf("template must normalize its stored value (no StateFunc)")
+	}
+
+
+	a := sf("web:\n    image: nginx\n    ports:\n      - 8080\n")
+	b := sf("web:\n  image: nginx\n  ports:\n  - 8080")
+	if a != b {
+		t.Errorf("equivalent templates should normalize to the same value:\n a=%q\n b=%q", a, b)
+	}
+
+
+	c := sf("web:\n  image: apache\n")
+	if a == c {
+		t.Errorf("different templates should not normalize to the same value")
+	}
+}
