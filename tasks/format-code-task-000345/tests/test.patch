+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+export GOROOT=/opt/go-1.9
+export GOPATH=/root/go-1.9
+export GO111MODULE=off
+GO=/opt/go-1.9/bin/go
+PKG=github.com/alibaba/terraform-provider/alicloud
+
+
+$GO test "$PKG" -run 'TestProvider$|TestProvider_impl|TestValidate|TestNormalize' -v
+
+
+$GO test "$PKG" -run 'TestCSApplication' -v
