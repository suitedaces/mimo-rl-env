diff --git a/test/test-audio-uri-builder-contract.js b/test/test-audio-uri-builder-contract.js
new file mode 100644
index 00000000..0c39b4dc
--- /dev/null
+++ b/test/test-audio-uri-builder-contract.js
@@ -0,0 +1,143 @@
+
+
+
+
+
+
+
+
+const assert = require('assert');
+const {VM} = require('./yomichan-vm');
+
+const vm = new VM({hasOwn: (object, property) => Object.prototype.hasOwnProperty.call(object, property)});
+vm.execute([
+    'mixed/lib/wanakana.min.js',
+    'mixed/js/japanese.js',
+    'bg/js/japanese.js',
+    'bg/js/audio-uri-builder.js',
+    'mixed/js/audio-system.js'
+]);
+const AudioUriBuilder = vm.get('AudioUriBuilder');
+const AudioSystem = vm.get('AudioSystem');
+
+
+async function testJpod101EncodingAndKanaFallback() {
+    const builder = new AudioUriBuilder();
+    assert.strictEqual(
+        await builder.getUri({expression: '食べる', reading: 'タベル'}, 'jpod101', {}),
+        'https://assets.languagepod101.com/dictionary/japanese/audiomp3.php?kanji=%E9%A3%9F%E3%81%B9%E3%82%8B&kana=%E3%82%BF%E3%83%99%E3%83%AB'
+    );
+    assert.strictEqual(
+        await builder.getUri({expression: 'たべる', reading: ''}, 'jpod101', {}),
+        'https://assets.languagepod101.com/dictionary/japanese/audiomp3.php?kana=%E3%81%9F%E3%81%B9%E3%82%8B'
+    );
+    assert.strictEqual(
+        await builder.getUri({expression: '', reading: ''}, 'jpod101', {}),
+        'https://assets.languagepod101.com/dictionary/japanese/audiomp3.php?'
+    );
+}
+
+async function testCustomTemplateAndUnknownSource() {
+    const builder = new AudioUriBuilder();
+    const definition = {expression: '猫', reading: 'ねこ', dictionary: 'JMDict'};
+    assert.strictEqual(
+        await builder.getUri(definition, 'custom', {customSourceUrl: 'https://audio.test/{expression}/{reading}/{missing}'}),
+        'https://audio.test/%E7%8C%AB/%E3%81%AD%E3%81%93/{missing}'
+    );
+    assert.strictEqual(await builder.getUri(definition, 'does-not-exist', {}), null);
+    assert.strictEqual(await builder.getUri(definition, 'custom', {}), null);
+}
+
+async function testAudioSystemRetriesAndCacheIdentity() {
+    class Audio {
+        constructor(uri) {
+            this.uri = uri;
+            this.duration = 1;
+        }
+
+        addEventListener(eventName, callback) {
+            if (eventName === 'loadeddata') {
+                if (!this.uri.includes('broken')) { Promise.resolve().then(callback); }
+            } else if (eventName === 'error' && this.uri.includes('broken')) {
+                Promise.resolve().then(callback);
+            }
+        }
+    }
+    const audioVm = new VM({Audio, hasOwn: (object, property) => Object.prototype.hasOwnProperty.call(object, property)});
+    audioVm.execute('mixed/js/audio-system.js');
+    const AudioSystemWithAudio = audioVm.get('AudioSystem');
+    const builder = {
+        async getUri(definition, source, details) {
+            return details[source];
+        }
+    };
+    const audioSystem = new AudioSystemWithAudio({audioUriBuilder: builder, useCache: true});
+
+    const definition = {expression: '猫', reading: 'ねこ'};
+    const first = await audioSystem.getDefinitionAudio(definition, ['first'], {first: 'https://audio/one.mp3'});
+    assert.strictEqual(first.uri, 'https://audio/one.mp3');
+    const cached = await audioSystem.getDefinitionAudio(definition, ['first'], {first: 'https://audio/one.mp3'});
+    assert.strictEqual(cached.audio, first.audio);
+    const changed = await audioSystem.getDefinitionAudio(definition, ['first'], {first: 'https://audio/two.mp3'});
+    assert.strictEqual(changed.uri, 'https://audio/two.mp3');
+    const skipped = await audioSystem.getDefinitionAudio({expression: '鳥', reading: 'とり'}, ['missing', 'fallback'], {
+        missing: null,
+        fallback: 'https://audio/skip-fallback.mp3'
+    });
+    assert.strictEqual(skipped.uri, 'https://audio/skip-fallback.mp3');
+    assert.strictEqual(skipped.index, 1);
+    const fallback = await audioSystem.getDefinitionAudio(definition, ['broken', 'fallback'], {
+        broken: 'https://audio/broken.mp3',
+        fallback: 'https://audio/fallback.mp3'
+    });
+    assert.strictEqual(fallback.uri, 'https://audio/fallback.mp3');
+    assert.strictEqual(fallback.index, 1);
+    const failedDefinition = {expression: '犬', reading: 'いぬ'};
+    await assert.rejects(
+        audioSystem.getDefinitionAudio(failedDefinition, ['broken'], {broken: 'https://audio/broken.mp3'}),
+        {message: 'Could not create audio'}
+    );
+    const recovered = await audioSystem.getDefinitionAudio(failedDefinition, ['fallback'], {
+        fallback: 'https://audio/fallback.mp3'
+    });
+    assert.strictEqual(recovered.uri, 'https://audio/fallback.mp3');
+}
+
+async function testTextToSpeechModesAndErrorFallback() {
+    const builder = new AudioUriBuilder();
+    const definition = {expression: '猫', reading: 'ねこ'};
+    assert.strictEqual(
+        await builder.getUri(definition, 'text-to-speech', {textToSpeechVoice: 'ja-JP'}),
+        'tts:?text=%E7%8C%AB&voice=ja-JP'
+    );
+    assert.strictEqual(
+        await builder.getUri(definition, 'text-to-speech-reading', {textToSpeechVoice: 'ja-JP'}),
+        'tts:?text=%E3%81%AD%E3%81%93&voice=ja-JP'
+    );
+    assert.strictEqual(
+        await builder.getUri({expression: 'ねこ', reading: ''}, 'text-to-speech-reading', {textToSpeechVoice: 'ja-JP'}),
+        'tts:?text=%E3%81%AD%E3%81%93&voice=ja-JP'
+    );
+    assert.strictEqual(await builder.getUri(definition, 'text-to-speech', {}), null);
+    assert.strictEqual(await builder.getUri(definition, 'text-to-speech-reading', {textToSpeechVoice: ''}), null);
+}
+
+function testNormalizeUrl() {
+    const builder = new AudioUriBuilder();
+    const base = 'https://example.test';
+    assert.strictEqual(builder.normalizeUrl('/audio.mp3', base, '/path/'), 'https://example.test/audio.mp3');
+    assert.strictEqual(builder.normalizeUrl('//cdn.test/audio.mp3', base, '/path/'), 'https://cdn.test/audio.mp3');
+    assert.strictEqual(builder.normalizeUrl('audio.mp3', base, '/path/'), 'https://example.test/path/audio.mp3');
+    assert.strictEqual(builder.normalizeUrl('data:audio/mp3;base64,AA==', base, '/path/'), 'data:audio/mp3;base64,AA==');
+    assert.strictEqual(builder.normalizeUrl('', base, '/path/'), '');
+}
+
+async function main() {
+    await testJpod101EncodingAndKanaFallback();
+    await testCustomTemplateAndUnknownSource();
+    await testTextToSpeechModesAndErrorFallback();
+    await testAudioSystemRetriesAndCacheIdentity();
+    testNormalizeUrl();
+}
+
+if (require.main === module) { main(); }
