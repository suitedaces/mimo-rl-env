+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+version_shim="$(mktemp -d)"
+printf 'version = "0.0.0-fixture"\n' > "${version_shim}/_black_version.py"
+export PYTHONPATH="${version_shim}:/workspace/repo/src${PYTHONPATH:+:${PYTHONPATH}}"
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+
+exec python -m pytest -c /dev/null /workspace/repo/usercase-test-coderl/test_numeric_literal_formatting.py -v
