diff --git a/usercase-test-coderl/test_numeric_literal_formatting.py b/usercase-test-coderl/test_numeric_literal_formatting.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_numeric_literal_formatting.py
@@ -0,0 +1,214 @@
+
+
+
+
+
+
+
+from __future__ import annotations
+
+import copy
+import json
+import os
+import socket
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+import black
+
+
+REPO_SRC = "/workspace/repo/src"
+
+
+def test_decimal_float_missing_leading_zero_is_normalized() -> None:
+
+
+
+    actual = black.format_str("x = .1\n", mode=black.Mode())
+
+    assert actual == "x = 0.1\n"
+
+
+def test_decimal_float_missing_fractional_digits_gets_trailing_zero() -> None:
+
+
+
+    actual = black.format_str("x = 1.\n", mode=black.Mode())
+
+    assert actual == "x = 1.0\n"
+
+
+def test_scientific_uppercase_e_and_plus_are_normalized() -> None:
+
+
+
+    actual = black.format_str("x = 1E+1\n", mode=black.Mode())
+
+    assert actual == "x = 1e1\n"
+
+
+def test_scientific_uppercase_e_and_minus_are_normalized() -> None:
+
+
+
+    actual = black.format_str("x = 1E-1\n", mode=black.Mode())
+
+    assert actual == "x = 1e-1\n"
+
+
+def test_complex_integer_suffix_is_lowercase() -> None:
+
+
+
+    actual = black.format_str("x = 123456789J\n", mode=black.Mode())
+
+    assert actual == "x = 123456789j\n"
+
+
+def test_complex_missing_leading_zero_preserves_float_rule() -> None:
+
+
+
+    actual = black.format_str("x = .1J\n", mode=black.Mode())
+
+    assert actual == "x = 0.1j\n"
+
+
+def test_complex_missing_fractional_digits_preserves_float_rule() -> None:
+
+
+
+    actual = black.format_str("x = 1.J\n", mode=black.Mode())
+
+    assert actual == "x = 1.0j\n"
+
+
+def test_complex_scientific_suffix_preserves_exponent_rule() -> None:
+
+
+
+    actual = black.format_str("x = 1E+1J\n", mode=black.Mode())
+
+    assert actual == "x = 1e1j\n"
+
+
+def test_hex_prefix_and_hex_digits_are_normalized() -> None:
+
+
+
+    actual = black.format_str("x = 0XB1acc\n", mode=black.Mode())
+
+    assert actual == "x = 0xB1ACC\n"
+
+
+def test_binary_prefix_is_lowercase() -> None:
+
+
+
+    actual = black.format_str("x = 0B1011\n", mode=black.Mode())
+
+    assert actual == "x = 0b1011\n"
+
+
+def test_octal_prefix_is_lowercase() -> None:
+
+
+
+    actual = black.format_str("x = 0O777\n", mode=black.Mode())
+
+    assert actual == "x = 0o777\n"
+
+
+def test_hex_underscore_digits_are_uppercased() -> None:
+
+
+
+    actual = black.format_str("x = 0xdead_beef\n", mode=black.Mode())
+
+
+
+    assert actual.startswith("x = 0x")
+    assert actual.endswith("\n")
+    literal = actual.removeprefix("x = ").strip()
+    digits = literal[2:]
+    assert digits
+    assert all(ch == "_" or ch.isdigit() or "A" <= ch <= "F" for ch in digits)
+    assert any("A" <= ch <= "F" for ch in digits)
+
+
+def test_normalized_numeric_output_remains_valid_ordinary_python_source() -> None:
+    actual = black.format_str("x = .1\n", mode=black.Mode())
+
+
+
+    assert actual == "x = 0.1\n"
+    compile(actual, "<formatted>", "exec")
+
+
+def test_referential_transparency_for_same_source_and_mode() -> None:
+    source = "x = 1E+1\n"
+    mode = black.Mode()
+
+    assert black.format_str(source, mode=mode) == black.format_str(source, mode=mode)
+
+
+def test_format_str_does_not_mutate_caller_owned_inputs() -> None:
+    source = "x = .1\n"
+    mode = black.Mode(line_length=100, target_versions={black.TargetVersion.PY310})
+    source_before = copy.deepcopy(source)
+    mode_before = copy.deepcopy(mode)
+
+    actual = black.format_str(source, mode=mode)
+
+    assert actual == "x = 0.1\n"
+    assert source == source_before
+    assert mode == mode_before
+
+
+def test_same_input_matches_in_fresh_python_process(tmp_path: Path) -> None:
+    source = "x = 0XB1acc\n"
+    mode = black.Mode()
+    in_process = black.format_str(source, mode=mode)
+    version_shim = tmp_path / "_black_version.py"
+    version_shim.write_text('version = "0.0.0-fixture"\n', encoding="utf-8")
+    script = """
+import json
+import black
+out = black.format_str("x = 0XB1acc\\n", mode=black.Mode())
+print(json.dumps(out))
+"""
+    env = os.environ.copy()
+    env["PYTHONPATH"] = os.pathsep.join([str(tmp_path), REPO_SRC])
+
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        env=env,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+    fresh_process = json.loads(completed.stdout)
+
+    assert in_process == "x = 0xB1ACC\n"
+    assert fresh_process == in_process
+
+
+def test_format_str_has_no_cwd_or_network_side_effects(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    def raise_on_socket(*args: object, **kwargs: object) -> None:
+        raise AssertionError("black.format_str attempted to create a socket")
+
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr(socket, "socket", raise_on_socket)
+    before = sorted(path.relative_to(tmp_path) for path in tmp_path.rglob("*"))
+
+    actual = black.format_str("x = 1E-1\n", mode=black.Mode())
+
+    after = sorted(path.relative_to(tmp_path) for path in tmp_path.rglob("*"))
+    assert actual == "x = 1e-1\n"
+    assert after == before
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
