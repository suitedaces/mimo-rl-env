diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,203 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+BIN=/workspace/repo/bin/ntsynt_merge_collinear.py
+[ -x "$BIN" ] || fail "ntsynt_merge_collinear.py is not an executable command"
+python3 -m py_compile "$BIN" || fail "python syntax check"
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || fail "cd tmp"
+
+assert_file_eq() {
+    local actual=$1
+    local expected=$2
+    local label=$3
+    if ! cmp -s "$actual" "$expected"; then
+        echo "FAIL: $label" >&2
+        echo "Expected:" >&2
+        sed -n '1,120p' "$expected" >&2
+        echo "Actual:" >&2
+        sed -n '1,120p' "$actual" >&2
+        exit 1
+    fi
+}
+
+assert_tsv_rows_eq() {
+    local actual=$1
+    local expected=$2
+    local label=$3
+    local actual_sorted expected_sorted
+    actual_sorted=$(mktemp)
+    expected_sorted=$(mktemp)
+    sort "$actual" >"$actual_sorted"
+    sort "$expected" >"$expected_sorted"
+    if ! cmp -s "$actual_sorted" "$expected_sorted"; then
+        echo "FAIL: $label" >&2
+        echo "Expected rows:" >&2
+        sed -n '1,120p' "$expected_sorted" >&2
+        echo "Actual rows:" >&2
+        sed -n '1,120p' "$actual_sorted" >&2
+        rm -f "$actual_sorted" "$expected_sorted"
+        exit 1
+    fi
+    rm -f "$actual_sorted" "$expected_sorted"
+}
+
+
+
+
+cat > f1.tsv <<'EOF'
+0	asmA	chr1	100	200	+	7	None
+0	asmB	chr7	500	600	+	7	None
+1	asmA	chr1	220	300	+	4	None
+1	asmB	chr7	625	705	+	4	None
+EOF
+"$BIN" --tsv f1.tsv --indel 10 --merge 100 >out 2>err; ec=$?
+cat >expected <<'EOF'
+0	asmA	chr1	100	300	+	0	None
+0	asmB	chr7	500	705	+	0	None
+EOF
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_file_eq out expected "F1 stdout"
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+
+
+
+
+cat > f2.tsv <<'EOF'
+0	asmA	chr1	100	200	+	99	old_reason
+0	asmB	chr7	500	600	+	88	old_reason
+1	asmA	chr1	200	280	+	77	old_reason
+1	asmB	chr7	50600	50700	+	66	old_reason
+EOF
+"$BIN" --tsv f2.tsv >out 2>err; ec=$?
+cat >expected <<'EOF'
+0	asmA	chr1	100	280	+	0	None
+0	asmB	chr7	500	50700	+	0	None
+EOF
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+
+assert_tsv_rows_eq out expected "F2 stdout"
+[ ! -s err ] || fail "F2 unexpected stderr: $(cat err)"
+
+
+
+
+cat > f3.tsv <<'EOF'
+0	asmA	chr1	500	600	-	5	None
+0	asmB	chr7	1000	1100	-	5	None
+1	asmA	chr1	700	480	-	3	None
+1	asmB	chr7	1200	980	-	3	None
+EOF
+"$BIN" --tsv f3.tsv --indel 10 --merge 100 >out 2>err; ec=$?
+cat >expected <<'EOF'
+0	asmA	chr1	700	600	-	0	None
+0	asmB	chr7	1200	1100	-	0	None
+EOF
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+
+assert_tsv_rows_eq out expected "F3 stdout"
+[ ! -s err ] || fail "F3 unexpected stderr: $(cat err)"
+
+
+
+
+cat > f4.tsv <<'EOF'
+9	asmB	chr2	100	180	+	1	stale
+9	asmA	chrZ	1000	1100	+	1	stale
+2	asmB	chr1	400	450	+	1	stale
+2	asmA	chrA	10	60	+	1	stale
+5	asmB	chr1	100	150	+	1	stale
+5	asmA	chrM	700	760	+	1	stale
+EOF
+"$BIN" --tsv f4.tsv --indel 0 --merge 1 >out 2>err; ec=$?
+cat >expected <<'EOF'
+0	asmB	chr1	100	150	+	0	None
+0	asmA	chrM	700	760	+	0	None
+1	asmB	chr1	400	450	+	0	id_change
+1	asmA	chrA	10	60	+	0	id_change
+2	asmB	chr2	100	180	+	0	id_change
+2	asmA	chrZ	1000	1100	+	0	id_change
+EOF
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+
+assert_tsv_rows_eq out expected "F4 stdout"
+[ ! -s err ] || fail "F4 unexpected stderr: $(cat err)"
+
+
+
+
+cat > f5.tsv <<'EOF'
+0	asmA	c1	100	150	+	1	old
+0	asmB	d1	100	150	+	1	old
+1	asmA	c2	140	190	-	1	old
+1	asmB	d1	170	220	-	1	old
+2	asmA	c2	200	250	+	1	old
+2	asmB	d1	240	290	+	1	old
+3	asmA	c2	240	300	+	1	old
+3	asmB	d1	300	350	+	1	old
+4	asmA	c2	320	370	+	1	old
+4	asmB	d1	500	550	+	1	old
+5	asmA	c2	430	480	+	1	old
+5	asmB	d1	610	660	+	1	old
+EOF
+"$BIN" --tsv f5.tsv --indel 10 --merge 60 >out 2>err; ec=$?
+cat >expected <<'EOF'
+0	asmA	c1	100	150	+	0	None
+0	asmB	d1	100	150	+	0	None
+1	asmA	c2	140	190	-	0	id_change
+1	asmB	d1	170	220	-	0	id_change
+2	asmA	c2	200	250	+	0	ori_change
+2	asmB	d1	240	290	+	0	ori_change
+3	asmA	c2	240	300	+	0	inconsistent_order
+3	asmB	d1	300	350	+	0	inconsistent_order
+4	asmA	c2	320	370	+	0	indel
+4	asmB	d1	500	550	+	0	indel
+5	asmA	c2	430	480	+	0	merge
+5	asmB	d1	610	660	+	0	merge
+EOF
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+
+assert_tsv_rows_eq out expected "F5 stdout"
+[ ! -s err ] || fail "F5 unexpected stderr: $(cat err)"
+
+
+
+
+printf '0\tasmA\tchr1\t100\t200\n' > f6.tsv
+"$BIN" --tsv f6.tsv >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F6 exit $ec; want non-zero"
+[ ! -s out ] || fail "F6 unexpected stdout: $(cat out)"
+
+grep -Eiq '(6|six)' err || fail "F6 stderr missing minimum count: $(cat err)"
+grep -Eiq 'col(umn)?s?' err || fail "F6 stderr missing column-count context: $(cat err)"
+
+
+
+
+"$BIN" >out 2>err; ec=$?
+[ "$ec" -eq 2 ] || fail "F7 exit $ec; want 2"
+[ ! -s out ] || fail "F7 unexpected stdout: $(cat out)"
+
+grep -q '^usage:' err || fail "F7 stderr missing usage: $(cat err)"
+grep -q -- '--tsv' err || fail "F7 stderr missing --tsv error: $(cat err)"
+
+
+
+
+"$BIN" --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F8 exit $ec; want 0"
+
+grep -q '^usage:' out || fail "F8 stdout missing usage"
+grep -q -- '--tsv' out || fail "F8 stdout missing --tsv"
+grep -q -- '--indel' out || fail "F8 stdout missing --indel"
+grep -q -- '--merge' out || fail "F8 stdout missing --merge"
+[ ! -s err ] || fail "F8 unexpected stderr: $(cat err)"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
