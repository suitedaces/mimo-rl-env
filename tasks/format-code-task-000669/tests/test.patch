diff --git a/pkg/ipmasq/ipmasq_ipv6_test.go b/pkg/ipmasq/ipmasq_ipv6_test.go
new file mode 100644
index 0000000000..ce720ec435
--- /dev/null
+++ b/pkg/ipmasq/ipmasq_ipv6_test.go
@@ -0,0 +1,170 @@
+
+
+
+package ipmasq
+
+import (
+	"net"
+	"os"
+	"path/filepath"
+	"sort"
+	"testing"
+)
+
+
+
+type ipMasqMapMockIPv6 struct {
+	cidrs map[string]net.IPNet
+}
+
+func newIPMasqMapMockIPv6() *ipMasqMapMockIPv6 {
+	return &ipMasqMapMockIPv6{cidrs: map[string]net.IPNet{}}
+}
+
+func (m *ipMasqMapMockIPv6) Update(cidr net.IPNet) error {
+	m.cidrs[cidr.String()] = cidr
+	return nil
+}
+
+func (m *ipMasqMapMockIPv6) Delete(cidr net.IPNet) error {
+	delete(m.cidrs, cidr.String())
+	return nil
+}
+
+func (m *ipMasqMapMockIPv6) Dump() ([]net.IPNet, error) {
+	cidrs := make([]net.IPNet, 0, len(m.cidrs))
+	for _, cidr := range m.cidrs {
+		cidrs = append(cidrs, cidr)
+	}
+	return cidrs, nil
+}
+
+func (m *ipMasqMapMockIPv6) keys() []string {
+	keys := make([]string, 0, len(m.cidrs))
+	for k := range m.cidrs {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func (m *ipMasqMapMockIPv6) has(cidr string) bool {
+	_, ok := m.cidrs[cidr]
+	return ok
+}
+
+
+
+func runWithConfig(t *testing.T, cfg string) *ipMasqMapMockIPv6 {
+	t.Helper()
+
+	dir := t.TempDir()
+	path := filepath.Join(dir, "ip-masq-agent")
+	if err := os.WriteFile(path, []byte(cfg), 0644); err != nil {
+		t.Fatalf("failed to write config: %v", err)
+	}
+
+	m := newIPMasqMapMockIPv6()
+	agent, err := newIPMasqAgent(path, m)
+	if err != nil {
+		t.Fatalf("failed to create agent: %v", err)
+	}
+	if err := agent.Update(); err != nil {
+		t.Fatalf("agent Update returned error: %v", err)
+	}
+	return m
+}
+
+const ipv6LinkLocal = "fe80::/10"
+const ipv4LinkLocal = "169.254.0.0/16"
+
+
+
+func TestIPv6CIDRsAccepted(t *testing.T) {
+	m := runWithConfig(t, "nonMasqueradeCIDRs:\n- fd00::/64\n- 2001:db8::1/32\nmasqLinkLocal: true\n")
+
+	if !m.has("fd00::/64") {
+		t.Errorf("expected fd00::/64 to be provisioned, got %v", m.keys())
+	}
+
+	if !m.has("2001:db8::/32") {
+		t.Errorf("expected 2001:db8::/32 (normalized) to be provisioned, got %v", m.keys())
+	}
+	if m.has("fe80::/10") {
+		t.Errorf("did not expect IPv6 link-local to be added, got %v", m.keys())
+	}
+}
+
+
+func TestMixedCIDRs(t *testing.T) {
+	m := runWithConfig(t, "nonMasqueradeCIDRs:\n- 10.0.0.0/8\n- fd00::/64\nmasqLinkLocal: true\n")
+
+	want := []string{"10.0.0.0/8", "fd00::/64"}
+	for _, w := range want {
+		if !m.has(w) {
+			t.Errorf("expected %s to be provisioned, got %v", w, m.keys())
+		}
+	}
+	if len(m.cidrs) != len(want) {
+		t.Errorf("expected exactly %v, got %v", want, m.keys())
+	}
+}
+
+
+func TestIPv6LinkLocalAddedWhenFalse(t *testing.T) {
+	m := runWithConfig(t, "nonMasqueradeCIDRs:\n- fd00::/64\nmasqLinkLocal: true\nmasqLinkLocalIPv6: false\n")
+
+	if !m.has(ipv6LinkLocal) {
+		t.Errorf("expected %s to be appended when masqLinkLocalIPv6 is false, got %v", ipv6LinkLocal, m.keys())
+	}
+	if !m.has("fd00::/64") {
+		t.Errorf("expected fd00::/64 to be provisioned, got %v", m.keys())
+	}
+	if m.has(ipv4LinkLocal) {
+		t.Errorf("did not expect IPv4 link-local since masqLinkLocal is true, got %v", m.keys())
+	}
+	if len(m.cidrs) != 2 {
+		t.Errorf("expected exactly [fd00::/64 fe80::/10], got %v", m.keys())
+	}
+}
+
+
+func TestIPv6LinkLocalNotAddedWhenTrue(t *testing.T) {
+	m := runWithConfig(t, "nonMasqueradeCIDRs:\n- fd00::/64\nmasqLinkLocal: true\nmasqLinkLocalIPv6: true\n")
+
+	if m.has(ipv6LinkLocal) {
+		t.Errorf("did not expect %s when masqLinkLocalIPv6 is true, got %v", ipv6LinkLocal, m.keys())
+	}
+	if len(m.cidrs) != 1 || !m.has("fd00::/64") {
+		t.Errorf("expected exactly [fd00::/64], got %v", m.keys())
+	}
+}
+
+
+
+func TestIPv6LinkLocalNotAddedWhenAbsent(t *testing.T) {
+	m := runWithConfig(t, "nonMasqueradeCIDRs:\n- fd00::/64\nmasqLinkLocal: true\n")
+
+	if m.has(ipv6LinkLocal) {
+		t.Errorf("did not expect %s when masqLinkLocalIPv6 is absent, got %v", ipv6LinkLocal, m.keys())
+	}
+	if len(m.cidrs) != 1 || !m.has("fd00::/64") {
+		t.Errorf("expected exactly [fd00::/64], got %v", m.keys())
+	}
+}
+
+
+
+
+func TestLinkLocalsIndependent(t *testing.T) {
+	m := runWithConfig(t, "nonMasqueradeCIDRs:\n- 10.0.0.0/8\n- fd00::/64\nmasqLinkLocalIPv6: false\n")
+
+	for _, w := range []string{"10.0.0.0/8", "fd00::/64", ipv4LinkLocal, ipv6LinkLocal} {
+		if !m.has(w) {
+			t.Errorf("expected %s to be provisioned, got %v", w, m.keys())
+		}
+	}
+	if len(m.cidrs) != 4 {
+		t.Errorf("expected exactly 4 CIDRs, got %v", m.keys())
+	}
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+
+GO=/opt/go-1.23/bin/go
+export GOTOOLCHAIN=local
+export GOCACHE=/tmp/gocache-ipmasq
+unset GOROOT
+
+
+env -u GOROOT GOTOOLCHAIN=local GOCACHE="$GOCACHE" "$GO" test ./pkg/ipmasq/ -run 'Test$'
+
+
+env -u GOROOT GOTOOLCHAIN=local GOCACHE="$GOCACHE" "$GO" test ./pkg/ipmasq/ -run 'TestIPv6CIDRsAccepted|TestMixedCIDRs|TestIPv6LinkLocal|TestLinkLocalsIndependent'
