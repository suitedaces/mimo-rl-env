diff --git a/packages/mdx/test/index.test.js b/packages/mdx/test/index.test.js
index 6c9f7f3d..4b896425 100644
--- a/packages/mdx/test/index.test.js
+++ b/packages/mdx/test/index.test.js
@@ -73,3 +73,53 @@ test('Should expose a sync compiler', async () => {
 
   expect(result).toMatchSnapshot()
 })
+
+it('Should escape < in paragraph text so JSX is parseable', async () => {
+  const result = await mdx('I <3 Markdown')
+
+  babel.parse(result, { plugins: ['@babel/plugin-syntax-jsx'] })
+
+  expect(result).not.toMatch(/I <3 Markdown/)
+})
+
+it('Should escape > in paragraph text', async () => {
+  const result = await mdx('A > B')
+
+  expect(result).toMatch(/A (?:&gt;|\{['"]>['"]\}) B/)
+})
+
+it('Should escape < in heading text so JSX is parseable', async () => {
+  const result = await mdx('# x < y')
+  babel.parse(result, { plugins: ['@babel/plugin-syntax-jsx'] })
+
+  expect(result).not.toMatch(/>x < y</)
+})
+
+it('Should escape < in blockquote text so JSX is parseable', async () => {
+  const result = await mdx('> x < y')
+  babel.parse(result, { plugins: ['@babel/plugin-syntax-jsx'] })
+  expect(result).not.toMatch(/>x < y</)
+})
+
+it('Should preserve < and > inside inlineCode', async () => {
+  const result = await mdx('use `<div>` here')
+  expect(result).toContain('{`<div>`}')
+  expect(result).not.toContain('&lt;div&gt;')
+  expect(result).not.toContain('&lt;div')
+})
+
+it('Should preserve < and > inside code blocks', async () => {
+  const result = await mdx('```\nx < y\n```')
+  expect(result).toContain('{`x < y')
+  expect(result).not.toContain('x &lt; y')
+})
+
+it('Should compile the exact issue example to parseable JSX', async () => {
+  const input = '# Hello, MDX\n\nI <3 Markdown and JSX'
+  const result = await mdx(input)
+
+  babel.parse(result, { plugins: ['@babel/plugin-syntax-jsx'] })
+  expect(result).toMatch(/Hello, MDX/)
+
+  expect(result).not.toMatch(/I <3 Markdown and JSX/)
+})
