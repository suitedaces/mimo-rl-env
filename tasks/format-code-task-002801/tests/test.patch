+    def test_inline_qualifier_between_words_attaches_to_second(self):
+
+
+
+        self.wxr.wtp.add_page(
+            "Template:desc",
+            10,
+            'Livonian: <span class="Latn" lang="liv">[[ve’ž#Livonian|ve’ž]]</span>, '
+            '<span class="ib-brac qualifier-brac">(</span>'
+            '<span class="ib-content qualifier-content">Salaca</span>'
+            '<span class="ib-brac qualifier-brac">)</span> '
+            '<span class="Latn" lang="liv">[[vez#Livonian|vez]]</span>',
+        )
+        data = parse_page(
+            self.wxr,
+            "Reconstruction:Proto-Finnic/veci",
+            """==Proto-Finnic==
+===Noun===
+# fish
+====Descendants====
+* {{desc|liv|ve’ž|vez<q:Salaca>}}""",
+        )
+        descs = data[0]["descendants"]
+        self.assertEqual(len(descs), 2)
+
+        first_tags = descs[0].get("tags", []) + descs[0].get("raw_tags", [])
+        self.assertNotIn("Salaca", first_tags)
+        self.assertEqual(descs[0]["word"], "ve’ž")
+        self.assertEqual(descs[0]["lang_code"], "liv")
+
+        second_tags = descs[1].get("tags", []) + descs[1].get("raw_tags", [])
+        self.assertIn("Salaca", second_tags)
+        self.assertEqual(descs[1]["word"], "vez")
+        self.assertEqual(descs[1]["lang_code"], "liv")
+
+    def test_qualifier_after_single_word_preserved(self):
+
+
+        self.wxr.wtp.add_page(
+            "Template:desc",
+            10,
+            'Livonian: <span class="Latn" lang="liv">[[ve’ž#Livonian|ve’ž]]</span> '
+            '<span class="ib-brac qualifier-brac">(</span>'
+            '<span class="ib-content qualifier-content">Salaca</span>'
+            '<span class="ib-brac qualifier-brac">)</span>',
+        )
+        data = parse_page(
+            self.wxr,
+            "Reconstruction:Proto-Finnic/veci",
+            """==Proto-Finnic==
+===Noun===
+# fish
+====Descendants====
+* {{desc|liv|ve’ž<q:Salaca>}}""",
+        )
+        descs = data[0]["descendants"]
+        self.assertEqual(len(descs), 1)
+        self.assertEqual(descs[0]["word"], "ve’ž")
+        tags = descs[0].get("tags", []) + descs[0].get("raw_tags", [])
+        self.assertIn("Salaca", tags)
+
+    def test_qualifier_after_two_words_attaches_to_last(self):
+
+
+        self.wxr.wtp.add_page(
+            "Template:desc",
+            10,
+            'Livonian: <span class="Latn" lang="liv">[[ve’ž#Livonian|ve’ž]]</span>, '
+            '<span class="Latn" lang="liv">[[vez#Livonian|vez]]</span> '
+            '<span class="ib-brac qualifier-brac">(</span>'
+            '<span class="ib-content qualifier-content">Salaca</span>'
+            '<span class="ib-brac qualifier-brac">)</span>',
+        )
+        data = parse_page(
+            self.wxr,
+            "Reconstruction:Proto-Finnic/veci",
+            """==Proto-Finnic==
+===Noun===
+# fish
+====Descendants====
+* {{desc|liv|ve’ž|vez|q3=Salaca}}""",
+        )
+        descs = data[0]["descendants"]
+        self.assertEqual(len(descs), 2)
+        self.assertEqual(descs[0]["word"], "ve’ž")
+        self.assertEqual(descs[1]["word"], "vez")
+        first_tags = descs[0].get("tags", []) + descs[0].get("raw_tags", [])
+        second_tags = descs[1].get("tags", []) + descs[1].get("raw_tags", [])
+        self.assertNotIn("Salaca", first_tags)
+        self.assertIn("Salaca", second_tags)
diff --git a/tests/test_zh_descendant.py b/tests/test_zh_descendant.py
