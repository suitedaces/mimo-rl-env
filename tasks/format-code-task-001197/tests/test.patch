+package usercase_test_coderl
+
+import (
+	"bytes"
+	"encoding/gob"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/fogleman/nes/nes"
+)
+
+func writeMapperROM(t *testing.T, path string, mapper byte, prg16KBanks byte, chr8KBanks byte) {
+	t.Helper()
+	header := []byte{
+		'N', 'E', 'S', 0x1a,
+		prg16KBanks,
+		chr8KBanks,
+		byte((mapper & 0x0f) << 4),
+		byte(mapper & 0xf0),
+		0, 0, 0, 0, 0, 0, 0, 0,
+	}
+	data := append([]byte{}, header...)
+	prg := make([]byte, int(prg16KBanks)*0x4000)
+	for bank := 0; bank < int(prg16KBanks)/2; bank++ {
+		base := bank * 0x8000
+		fill := byte(0x10 + bank*0x10)
+		for i := 0; i < 0x8000; i++ {
+			prg[base+i] = fill
+		}
+		prg[base] = byte(0x11 + bank*0x10)
+		prg[base+0x0123] = byte(0x12 + bank*0x10)
+		prg[base+0x7fff] = byte(0x13 + bank*0x10)
+	}
+	data = append(data, prg...)
+	data = append(data, make([]byte, int(chr8KBanks)*0x2000)...)
+	if err := os.WriteFile(path, data, 0644); err != nil {
+		t.Fatalf("write test rom: %v", err)
+	}
+}
+
+func newMapper7Console(t *testing.T, dir string) *nes.Console {
+	t.Helper()
+	rom := filepath.Join(dir, "aorom.nes")
+	writeMapperROM(t, rom, 7, 8, 0)
+	console, err := nes.NewConsole(rom)
+	if err != nil {
+		t.Fatalf("NewConsole mapper 7: %v", err)
+	}
+	return console
+}
+
+func assertSingleScreenMirroring(t *testing.T, console *nes.Console) {
+	t.Helper()
+
+
+	console.CPU.Write(0x8000, 0x00)
+	console.PPU.Write(0x2000, 0xa1)
+	if got := console.PPU.Read(0x2400); got != 0xa1 {
+		t.Fatalf("single-screen page 0 alias read = %d, want 161", got)
+	}
+	console.CPU.Write(0x8000, 0x10)
+	console.PPU.Write(0x2400, 0xb2)
+	if got := console.PPU.Read(0x2000); got != 0xb2 {
+		t.Fatalf("single-screen page 1 alias read = %d, want 178", got)
+	}
+	console.CPU.Write(0x8000, 0x00)
+	if got := console.PPU.Read(0x2000); got != 0xa1 {
+		t.Fatalf("single-screen page 0 restored read = %d, want 161", got)
+	}
+}
+
+func TestMapper7NewConsoleAndPRGBankSwitching(t *testing.T) {
+
+
+
+
+	console := newMapper7Console(t, t.TempDir())
+
+
+
+	if console.CPU == nil || console.PPU == nil || console.Mapper == nil {
+		t.Fatalf("NewConsole mapper 7 returned unusable console: %#v", console)
+	}
+	if got := console.CPU.Read(0x8000); got != 17 {
+		t.Fatalf("initial CPU read $8000 = %d, want 17", got)
+	}
+	if got := console.CPU.Read(0x8123); got != 18 {
+		t.Fatalf("initial CPU read $8123 = %d, want 18", got)
+	}
+	if got := console.CPU.Read(0xffff); got != 19 {
+		t.Fatalf("initial CPU read $FFFF = %d, want 19", got)
+	}
+	assertSingleScreenMirroring(t, console)
+
+	console.CPU.Write(0x8000, 0x02)
+	if got := console.CPU.Read(0x8000); got != 49 {
+		t.Fatalf("bank 2 CPU read $8000 = %d, want 49", got)
+	}
+	if got := console.CPU.Read(0x8123); got != 50 {
+		t.Fatalf("bank 2 CPU read $8123 = %d, want 50", got)
+	}
+	if got := console.CPU.Read(0xffff); got != 51 {
+		t.Fatalf("bank 2 CPU read $FFFF = %d, want 51", got)
+	}
+
+	console.CPU.Write(0xffff, 0x13)
+	if got := console.CPU.Read(0x8000); got != 65 {
+		t.Fatalf("bank 3 CPU read $8000 = %d, want 65", got)
+	}
+	if got := console.CPU.Read(0x8123); got != 66 {
+		t.Fatalf("bank 3 CPU read $8123 = %d, want 66", got)
+	}
+	if got := console.CPU.Read(0xffff); got != 67 {
+		t.Fatalf("bank 3 CPU read $FFFF = %d, want 67", got)
+	}
+
+	console.CPU.Write(0x8123, 0x00)
+	if got := console.CPU.Read(0x8000); got != 17 {
+		t.Fatalf("bank 0 CPU read $8000 after write 0x00 = %d, want 17", got)
+	}
+}
+
+func TestMapper7CHRRAMAndSRAMAreMapped(t *testing.T) {
+
+
+
+
+	console := newMapper7Console(t, t.TempDir())
+
+	if got := console.PPU.Read(0x0012); got != 0 {
+		t.Fatalf("initial PPU CHR read $0012 = %d, want 0", got)
+	}
+	console.PPU.Write(0x0012, 0xab)
+	if got := console.PPU.Read(0x0012); got != 171 {
+		t.Fatalf("PPU CHR read $0012 after write = %d, want 171", got)
+	}
+
+	if got := console.CPU.Read(0x6000); got != 0 {
+		t.Fatalf("initial SRAM read $6000 = %d, want 0", got)
+	}
+	if got := console.CPU.Read(0x7fff); got != 0 {
+		t.Fatalf("initial SRAM read $7FFF = %d, want 0", got)
+	}
+	console.CPU.Write(0x6000, 0x5a)
+	console.CPU.Write(0x7fff, 0xc3)
+	if got := console.CPU.Read(0x6000); got != 90 {
+		t.Fatalf("SRAM read $6000 after write = %d, want 90", got)
+	}
+	if got := console.CPU.Read(0x7fff); got != 195 {
+		t.Fatalf("SRAM read $7FFF after write = %d, want 195", got)
+	}
+}
+
+func TestMapper7SaveLoadPreservesSelectedPRGBank(t *testing.T) {
+
+
+
+
+	dir := t.TempDir()
+	console := newMapper7Console(t, dir)
+	console.CPU.Write(0x8000, 0x13)
+	if got := console.CPU.Read(0x8000); got != 65 {
+		t.Fatalf("source selected bank read = %d, want 65", got)
+	}
+
+	var state bytes.Buffer
+	if err := console.Save(gob.NewEncoder(&state)); err != nil {
+		t.Fatalf("save state: %v", err)
+	}
+
+	reloaded := newMapper7Console(t, dir)
+	if got := reloaded.CPU.Read(0x8000); got != 17 {
+		t.Fatalf("fresh reload target read = %d, want 17", got)
+	}
+	reloaded.CPU.Write(0x8000, 0x01)
+	if got := reloaded.CPU.Read(0x8000); got != 33 {
+		t.Fatalf("reload target changed bank read = %d, want 33", got)
+	}
+	if err := reloaded.Load(gob.NewDecoder(&state)); err != nil {
+		t.Fatalf("load state: %v", err)
+	}
+	if got := reloaded.CPU.Read(0x8000); got != 65 {
+		t.Fatalf("read after loading selected bank = %d, want 65", got)
+	}
+
+
+	if got := reloaded.CPU.Read(0x8123); got != 66 {
+		t.Fatalf("read after loading selected bank at $8123 = %d, want 66", got)
+	}
+}
+
+func TestMapper7NewConsoleDoesNotReturnUnsupportedMapperError(t *testing.T) {
+
+
+
+
+	dir := t.TempDir()
+	rom := filepath.Join(dir, "aorom.nes")
+	writeMapperROM(t, rom, 7, 2, 0)
+
+	console, err := nes.NewConsole(rom)
+
+
+	if err != nil {
+		t.Fatalf("NewConsole mapper 7 returned error: %v", err)
+	}
+	if console == nil || console.Mapper == nil {
+		t.Fatalf("NewConsole mapper 7 returned unusable console: %#v", console)
+	}
+}
+
+func TestMapper7StateIsIndependentAcrossConsoles(t *testing.T) {
+
+
+
+
+	a := newMapper7Console(t, t.TempDir())
+	b := newMapper7Console(t, t.TempDir())
+
+	a.CPU.Write(0x8000, 0x03)
+	if got := a.CPU.Read(0x8000); got != 65 {
+		t.Fatalf("console a selected bank read = %d, want 65", got)
+	}
+	if got := b.CPU.Read(0x8000); got != 17 {
+		t.Fatalf("console b initial bank read = %d, want 17", got)
+	}
+
+	b.CPU.Write(0xffff, 0x12)
+	if got := a.CPU.Read(0x8000); got != 65 {
+		t.Fatalf("console a read after mutating b = %d, want 65", got)
+	}
+	if got := b.CPU.Read(0x8000); got != 49 {
+		t.Fatalf("console b selected bank read = %d, want 49", got)
+	}
+}
+
+func TestMapper7RepeatedConstructUseCleanupStaysBounded(t *testing.T) {
+
+
+
+
+
+
+	for i := 0; i < 120; i++ {
+		dir := t.TempDir()
+		console := newMapper7Console(t, dir)
+		if got := console.CPU.Read(0x8000); got != 17 {
+			t.Fatalf("cycle %d initial read = %d, want 17", i, got)
+		}
+		console.CPU.Write(0x8000, 0x02)
+		if got := console.CPU.Read(0x8000); got != 49 {
+			t.Fatalf("cycle %d selected bank read = %d, want 49", i, got)
+		}
+	}
+}
