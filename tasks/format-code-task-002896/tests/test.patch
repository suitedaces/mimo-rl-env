diff --git a/src/conversion/convertConfig.test.ts b/src/conversion/convertConfig.test.ts
index ddb9735..dc3e66e 100644
--- a/src/conversion/convertConfig.test.ts
+++ b/src/conversion/convertConfig.test.ts
@@ -1,11 +1,15 @@
 import { ResultStatus, FailedResult, SucceededDataResult } from "../types";
 import { convertConfig, ConvertConfigDependencies } from "./convertConfig";
 import { OriginalConfigurations } from "../input/findOriginalConfigurations";
+import { bind } from "../binding";
+import { writeConversionResults } from "../creation/writeConversionResults";
+import { createEmptyConversionResults } from "./conversionResults.stubs";
 
 const createStubDependencies = (
-    overrides: Pick<ConvertConfigDependencies, "findOriginalConfigurations">,
+    overrides: Partial<ConvertConfigDependencies> &
+        Pick<ConvertConfigDependencies, "findOriginalConfigurations">,
 ): ConvertConfigDependencies => ({
-    convertRules: jest.fn(),
+    convertRules: jest.fn().mockReturnValue(createEmptyConversionResults()),
     reportConversionResults: jest.fn(),
     simplifyPackageRules: async (_configurations, data) => data,
     writeConversionResults: jest.fn().mockReturnValue(Promise.resolve()),
@@ -61,4 +65,85 @@ describe("convertConfig", () => {
             status: ResultStatus.Succeeded,
         });
     });
+
+    it("returns a failed result when writing the configuration file fails", async () => {
+
+        const findSuccess: SucceededDataResult<OriginalConfigurations> = {
+            data: createStubOriginalConfigurationsData(),
+            status: ResultStatus.Succeeded,
+        };
+        const writeError = new Error("EACCES: permission denied");
+        const fileSystem = {
+            writeFile: jest.fn().mockResolvedValue(writeError),
+        };
+        const dependencies = createStubDependencies({
+            findOriginalConfigurations: async () => findSuccess,
+            writeConversionResults: bind(writeConversionResults, { fileSystem }),
+        });
+        const settings = {
+            config: "./eslintrc.js",
+        };
+
+
+        const result = await convertConfig(dependencies, settings);
+
+
+        expect(result).toEqual({
+            errors: [writeError],
+            status: ResultStatus.Failed,
+        });
+    });
+
+    it("does not report conversion results when writing the configuration file fails", async () => {
+
+        const findSuccess: SucceededDataResult<OriginalConfigurations> = {
+            data: createStubOriginalConfigurationsData(),
+            status: ResultStatus.Succeeded,
+        };
+        const writeError = new Error("EACCES: permission denied");
+        const fileSystem = {
+            writeFile: jest.fn().mockResolvedValue(writeError),
+        };
+        const reportConversionResults = jest.fn();
+        const dependencies = createStubDependencies({
+            findOriginalConfigurations: async () => findSuccess,
+            writeConversionResults: bind(writeConversionResults, { fileSystem }),
+            reportConversionResults,
+        });
+        const settings = {
+            config: "./eslintrc.js",
+        };
+
+
+        await convertConfig(dependencies, settings);
+
+
+        expect(reportConversionResults).not.toHaveBeenCalled();
+    });
+
+    it("returns a successful result when writing the configuration file succeeds", async () => {
+
+        const findSuccess: SucceededDataResult<OriginalConfigurations> = {
+            data: createStubOriginalConfigurationsData(),
+            status: ResultStatus.Succeeded,
+        };
+        const fileSystem = {
+            writeFile: jest.fn().mockResolvedValue(undefined),
+        };
+        const dependencies = createStubDependencies({
+            findOriginalConfigurations: async () => findSuccess,
+            writeConversionResults: bind(writeConversionResults, { fileSystem }),
+        });
+        const settings = {
+            config: "./eslintrc.js",
+        };
+
+
+        const result = await convertConfig(dependencies, settings);
+
+
+        expect(result).toEqual({
+            status: ResultStatus.Succeeded,
+        });
+    });
 });
