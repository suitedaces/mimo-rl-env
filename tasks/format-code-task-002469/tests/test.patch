diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,139 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+export PIP_NO_INDEX=1
+export PIP_CONFIG_FILE=/dev/null
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+VENV="/opt/factorio-sat-stage4-blueprint-book-venv"
+TMP=""
+rm -rf "$VENV"
+python -m venv --system-site-packages "$VENV" || fail "create venv"
+trap 'rm -rf "$TMP" "$VENV"' EXIT
+
+"$VENV/bin/python" -m pip install -e /workspace/repo --no-deps --no-index --no-build-isolation >/tmp/blueprint_book_fixture_pip.out 2>/tmp/blueprint_book_fixture_pip.err \
+    || { cat /tmp/blueprint_book_fixture_pip.err >&2; fail "build/install"; }
+BIN="$VENV/bin/blueprint_book"
+[ -x "$BIN" ] || fail "blueprint_book console command is not installed"
+
+TMP=$(mktemp -d)
+cd "$TMP" || fail "cd tmp"
+
+BP_ONE='0eNqrVkrKKU0tKMrMK1GyUqhWyixJzQUykER1FJTKUouKM/PzgOJGFoYm5iaW5mbmhgZmpmZAuZzEpNQckI78vFSl2loADV8YQw=='
+BP_TWO='0eNqrVkrKKU0tKMrMK1GyUqhWyixJzQUykER1FJTKUouKM/PzgOJGFoYm5iaW5mbmhgZmpmZAuZzEpNQckI6S8nyl2loADdIYWw=='
+PACKED_PAIR='0eNqrVkrKKU0tKMrMK4lPys/PVrJSqFbKLEnNBTIQUrpgKR0FpcTkksyy1PjMvJTUCqAKA6BQWWpRcWZ+HpBnZGFoYm5iaW5mbmhgZmoGlMtJTErNAZkUkJhZBNIPN7EYKBpdjeBjt1eJWPPz81KVaoECcIcBOdQzvaQ8H8V0w9rY2loAVG5fsw=='
+
+decode_json() {
+    "$VENV/bin/python" - "$1" <<'PY'
+import base64
+import json
+import sys
+import zlib
+
+encoded = sys.argv[1].strip()
+data = json.loads(zlib.decompress(base64.b64decode(encoded[1:])))
+print(json.dumps(data, sort_keys=True, separators=(',', ':')))
+PY
+}
+
+check_unpacked_payloads() {
+    "$VENV/bin/python" - "$BP_ONE" "$BP_TWO" out <<'PY'
+import base64
+import json
+import sys
+import zlib
+
+
+def decode(encoded):
+    return json.loads(zlib.decompress(base64.b64decode(encoded.strip()[1:])))
+
+
+def blueprint_payload(data):
+
+    if set(data.keys()) == {'blueprint'}:
+        return data['blueprint']
+    if 'blueprint' in data and 'index' in data:
+        return data['blueprint']
+    raise AssertionError(f'not an encoded blueprint payload: {data!r}')
+
+
+expected = [blueprint_payload(decode(arg)) for arg in sys.argv[1:3]]
+with open(sys.argv[3], encoding='utf-8') as handle:
+    actual = [blueprint_payload(decode(line)) for line in handle.read().splitlines() if line.strip()]
+if actual != expected:
+    raise AssertionError(f'unpacked payloads differ: {actual!r}')
+PY
+}
+
+
+
+
+printf '%s\n%s\n' "$BP_ONE" "$BP_TWO" | "$BIN" pack --label Pair >out 2>err
+ec=$?
+EXPECTED="$PACKED_PAIR"
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F1 stdout: $(cat out)"
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+
+
+
+
+printf '%s\n' "$BP_ONE" | "$BIN" pack >out 2>err
+ec=$?
+EXPECTED_JSON='{"blueprint_book":{"active_index":0,"blueprints":[{"blueprint":{"item":"blueprint","label":"one","version":281474976710656},"index":0}],"item":"blueprint-book","version":281474976710656}}'
+ACTUAL_JSON=$(decode_json "$(cat out)") || fail "F2 could not decode stdout"
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+[ "$ACTUAL_JSON" = "$EXPECTED_JSON" ] || fail "F2 decoded JSON: $ACTUAL_JSON"
+[ ! -s err ] || fail "F2 unexpected stderr: $(cat err)"
+
+
+
+
+printf '' | "$BIN" pack >out 2>err
+ec=$?
+EXPECTED_JSON='{"blueprint_book":{"active_index":0,"blueprints":[],"item":"blueprint-book","version":281474976710656}}'
+ACTUAL_JSON=$(decode_json "$(cat out)") || fail "F3 could not decode stdout"
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+[ "$ACTUAL_JSON" = "$EXPECTED_JSON" ] || fail "F3 decoded JSON: $ACTUAL_JSON"
+[ ! -s err ] || fail "F3 unexpected stderr: $(cat err)"
+
+
+
+
+printf '%s\n' "$PACKED_PAIR" | "$BIN" unpack >out 2>err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+
+check_unpacked_payloads || fail "F4 decoded payloads did not match originals: $(cat out)"
+[ "$(wc -l <out | tr -d ' ')" = "2" ] || fail "F4 should print exactly two lines"
+[ ! -s err ] || fail "F4 unexpected stderr: $(cat err)"
+
+
+
+
+"$BIN" bogus >out 2>err
+ec=$?
+[ "$ec" -ne 0 ] || fail "F5 exit $ec; want non-zero"
+[ ! -s out ] || fail "F5 unexpected stdout: $(cat out)"
+
+grep -Eiq "usage|error" err || fail "F5 stderr missing usage/error: $(cat err)"
+grep -q "bogus" err || fail "F5 stderr missing invalid mode: $(cat err)"
+
+
+
+
+"$BIN" --help >out 2>err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+
+grep -iq "usage" out || fail "F6 help missing usage: $(cat out)"
+grep -q "pack" out || fail "F6 help missing pack mode: $(cat out)"
+grep -q "unpack" out || fail "F6 help missing unpack mode: $(cat out)"
+grep -q -- "--label" out || fail "F6 help missing --label: $(cat out)"
+[ ! -s err ] || fail "F6 unexpected stderr: $(cat err)"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
