diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,193 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+PYTHON=${PYTHON:-/usr/local/bin/python}
+export PIP_NO_INDEX=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+
+
+
+( cd /workspace/repo && "$PYTHON" -m pip install --no-index --no-deps --disable-pip-version-check --no-build-isolation -e . >/tmp/arxiv_latex_cleaner_fixture_pip.log 2>&1 ) \
+  || { echo "FAIL: build; see /tmp/arxiv_latex_cleaner_fixture_pip.log" >&2; exit 1; }
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+cd "$TMP"
+
+fail() {
+  echo "FAIL: $*" >&2
+  exit 1
+}
+
+run_cleaner() {
+  "$PYTHON" -m arxiv_latex_cleaner "$@"
+}
+
+make_minimal_project() {
+  local project=$1
+  mkdir -p "$project"
+  cat > "$project/main.tex" <<'EOF'
+\begin{document}
+\x{a}
+\end{document}
+EOF
+}
+
+
+
+
+project="$TMP/paper"
+mkdir -p "$project/figures" "$project/sections"
+printf 'PANEL-A-DATA\n' > "$project/figures/panel-a.pdf"
+printf 'PANEL-B-DATA\n' > "$project/figures/panel-b.pdf"
+printf 'PANEL-TIKZ-DATA\n' > "$project/figures/panel-tikz.pdf"
+printf 'UNUSED-DATA\n' > "$project/figures/unused.pdf"
+cat > "$project/main.tex" <<'EOF'
+\documentclass{article}
+\begin{document}
+Before.
+\figcomp{panel-a}{.45}{.8}
+\figcomp{panel-b}{ .50 }{ .70 }
+\input{sections/detail.tikz}
+\macrokeep{Alpha}{Beta}
+\nomatch{left alone}
+\end{document}
+EOF
+cat > "$project/sections/detail.tikz" <<'EOF'
+Tikz retained file start.
+\figcomp{panel-tikz}{.25}{.6}
+Tikz retained file end.
+EOF
+cat > "$TMP/valid_config.yaml" <<'EOF'
+patterns_and_insertions:
+  - pattern: '(?:\\figcomp{\s*)(?P<path>.*?)\s*}\s*{\s*(?P<box>.*?)\s*}\s*{\s*(?P<width>.*?)\s*}'
+    insertion: '\parbox[c]{{ {box} \linewidth}}{{\includegraphics[width={width}\linewidth]{{figures/{path}}}}}'
+    description: Replace figcomp
+  - pattern: '(?:\\macrokeep{(?P<first>.*?)}{(?P<second>.*?)})'
+    insertion: "Start {first}\n  Middle {second} End"
+    description: Preserve macro whitespace
+    strip_whitespace: false
+  - pattern: '(?:\\unusedmacro{(?P<value>.*?)})'
+    insertion: 'UNUSED {value}'
+    description: No matching macro
+EOF
+run_cleaner "$project" --config "$TMP/valid_config.yaml" >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+
+
+[ -d "${project}_arXiv" ] || fail "F1 missing output directory"
+
+
+
+
+"$PYTHON" - "${project}_arXiv/main.tex" "${project}_arXiv/sections/detail.tikz" <<'PY' \
+  || fail "F1 transformed TeX/TikZ content did not satisfy spec-level checks"
+import pathlib
+import sys
+
+main = pathlib.Path(sys.argv[1]).read_text()
+detail = pathlib.Path(sys.argv[2]).read_text()
+
+required_main = [
+    r"\parbox[c]{.45\linewidth}{\includegraphics[width=.8\linewidth]{figures/panel-a}}",
+    r"\parbox[c]{.50\linewidth}{\includegraphics[width=.70\linewidth]{figures/panel-b}}",
+    r"\input{sections/detail.tikz}",
+    "Start Alpha\n  Middle Beta End",
+    r"\nomatch{left alone}",
+]
+for needle in required_main:
+    assert needle in main, needle
+
+for needle in [
+    r"\figcomp{panel-a}{.45}{.8}",
+    r"\figcomp{panel-b}{ .50 }{ .70 }",
+    r"\macrokeep{Alpha}{Beta}",
+    "UNUSED",
+]:
+    assert needle not in main, needle
+
+required_detail = [
+    "Tikz retained file start.",
+    r"\parbox[c]{.25\linewidth}{\includegraphics[width=.6\linewidth]{figures/panel-tikz}}",
+    "Tikz retained file end.",
+]
+for needle in required_detail:
+    assert needle in detail, needle
+
+assert r"\figcomp{panel-tikz}{.25}{.6}" not in detail
+PY
+[ -f "${project}_arXiv/figures/panel-a.pdf" ] || fail "F1 missing generated reference panel-a.pdf"
+[ -f "${project}_arXiv/figures/panel-b.pdf" ] || fail "F1 missing generated reference panel-b.pdf"
+[ -f "${project}_arXiv/figures/panel-tikz.pdf" ] || fail "F1 missing generated reference panel-tikz.pdf"
+[ ! -e "${project}_arXiv/figures/unused.pdf" ] || fail "F1 copied unreferenced unused.pdf"
+[ "$(sha256sum "${project}_arXiv/figures/panel-a.pdf" | awk '{print $1}')" = "d2533f624aed3fa58264453c40894982affa68b7346c983ea71b7b332db4b843" ] \
+  || fail "F1 panel-a.pdf hash mismatch"
+[ "$(sha256sum "${project}_arXiv/figures/panel-b.pdf" | awk '{print $1}')" = "e70973c1f7d08c83820a5d7cc06230f9352c4a10b342f50f8ad627ff9693b337" ] \
+  || fail "F1 panel-b.pdf hash mismatch"
+[ "$(sha256sum "${project}_arXiv/figures/panel-tikz.pdf" | awk '{print $1}')" = "599fbbfd827e55db635686b7de1e2a5f2b73a7fc0c6cfe096c0714344f5f6ff6" ] \
+  || fail "F1 panel-tikz.pdf hash mismatch"
+
+
+
+
+bad_project="$TMP/missing_pattern_paper"
+make_minimal_project "$bad_project"
+cat > "$TMP/missing_pattern.yaml" <<'EOF'
+patterns_and_insertions:
+  - insertion: 'Y'
+    description: Missing pattern
+EOF
+run_cleaner "$bad_project" --config "$TMP/missing_pattern.yaml" >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F2 wanted non-zero exit"
+
+
+
+
+
+
+bad_project="$TMP/missing_insertion_paper"
+make_minimal_project "$bad_project"
+cat > "$TMP/missing_insertion.yaml" <<'EOF'
+patterns_and_insertions:
+  - pattern: '(?:\\x{(?P<value>.*?)})'
+    description: Missing insertion
+EOF
+run_cleaner "$bad_project" --config "$TMP/missing_insertion.yaml" >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F3 wanted non-zero exit"
+
+
+
+
+
+
+bad_project="$TMP/missing_description_paper"
+make_minimal_project "$bad_project"
+cat > "$TMP/missing_description.yaml" <<'EOF'
+patterns_and_insertions:
+  - pattern: '(?:\\x{(?P<value>.*?)})'
+    insertion: 'Y'
+EOF
+run_cleaner "$bad_project" --config "$TMP/missing_description.yaml" >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F4 wanted non-zero exit"
+
+
+
+
+
+
+bad_project="$TMP/bad_regex_paper"
+make_minimal_project "$bad_project"
+cat > "$TMP/bad_regex.yaml" <<'EOF'
+patterns_and_insertions:
+  - pattern: '([unclosed'
+    insertion: 'Y'
+    description: Bad regex
+EOF
+run_cleaner "$bad_project" --config "$TMP/bad_regex.yaml" >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F5 wanted non-zero exit"
+
+
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+export PYTHON="${PYTHON:-/usr/local/bin/python}"
+export PIP_NO_INDEX=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
