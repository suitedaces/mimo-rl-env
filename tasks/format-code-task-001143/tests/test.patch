diff --git a/test/test_iso_timezone.js b/test/test_iso_timezone.js
new file mode 100644
index 0000000..f46dbb9
--- /dev/null
+++ b/test/test_iso_timezone.js
@@ -0,0 +1,61 @@
+var assert = require('assert');
+var dateFormat = require('../lib/dateformat');
+
+var summer = new Date('2021-07-01T12:34:56.789Z');
+var winter = new Date('2021-01-01T12:34:56.007Z');
+
+var failures = [];
+function check(name, actual, expected) {
+  try {
+    assert.strictEqual(actual, expected);
+  } catch (err) {
+    failures.push(name + ': ' + err.message);
+  }
+}
+
+
+
+check('summer local preset',
+  dateFormat(summer, 'isoDateTime'),
+  '2021-07-01T08:34:56-04:00'
+);
+check('winter local preset',
+  dateFormat(winter, 'isoDateTime'),
+  '2021-01-01T07:34:56-05:00'
+);
+
+check('summer local milliseconds preset',
+  dateFormat(summer, 'isoDateTimeMillis'),
+  '2021-07-01T08:34:56.789-04:00'
+);
+check('winter local milliseconds preset',
+  dateFormat(winter, 'isoDateTimeMillis'),
+  '2021-01-01T07:34:56.007-05:00'
+);
+check('UTC milliseconds preset',
+  dateFormat(summer, 'isoUtcDateTimeMillis'),
+  '2021-07-01T12:34:56.789Z'
+);
+
+
+check('colonized offset token', dateFormat(summer, 'P'), '-04:00');
+check('legacy compact offset token', dateFormat(summer, 'o'), '-0400');
+check('quoted literal P', dateFormat(summer, "P 'P'"), '-04:00 P');
+
+
+check('UTC prefix with offset',
+  dateFormat(summer, 'UTC:yyyy-mm-dd HH:MM:ss.lP'),
+  '2021-07-01 12:34:56.789+00:00'
+);
+check('GMT prefix with offset',
+  dateFormat(summer, 'GMT:yyyy-mm-dd HH:MM:ssP Z'),
+  '2021-07-01 12:34:56+00:00 GMT'
+);
+check('explicit UTC with offset',
+  dateFormat(summer, 'yyyy-mm-dd HH:MM:ssP', true),
+  '2021-07-01 12:34:56+00:00'
+);
+
+if (failures.length) {
+  throw new Error(failures.length + ' ISO timezone checks failed:\n' + failures.join('\n'));
+}
diff --git a/test/test_iso_timezone_positive.js b/test/test_iso_timezone_positive.js
new file mode 100644
index 0000000..f3d2b3a
--- /dev/null
+++ b/test/test_iso_timezone_positive.js
@@ -0,0 +1,8 @@
+var assert = require('assert');
+var dateFormat = require('../lib/dateformat');
+var instant = new Date('2021-07-01T12:34:56.789Z');
+
+assert.strictEqual(dateFormat(instant, 'isoDateTime'), '2021-07-01T18:04:56+05:30');
+assert.strictEqual(dateFormat(instant, 'isoDateTimeMillis'), '2021-07-01T18:04:56.789+05:30');
+assert.strictEqual(dateFormat(instant, 'P'), '+05:30');
+assert.strictEqual(dateFormat(instant, 'o'), '+0530');
