     assert act.plain_name == "dummy-action"
 
 
+def test_action_in_null_parses():
+    """Null `in` value (seen in real Roidmi V66 spec) must parse without crashing.
+
+    Either reference's approach (coerce at parse time) or deferred-coercion in
+    fill_from_parent is acceptable; user-observable end-state is empty list
+    after MiotService finishes constructing.
+    """
+    data = """
+    {
+        "iid": 1,
+        "type": "urn:miot-spec-v2:action:dummy-action:0000001:dummy:1",
+        "description": "Description",
+        "in": null,
+        "out": []
+    }"""
+    act = MiotAction.parse_raw(data)
+    assert act.inputs in (None, [])
+    assert act.outputs == []
+
+
+def test_action_out_null_parses():
+    """Null `out` value must parse without crashing."""
+    data = """
+    {
+        "iid": 1,
+        "type": "urn:miot-spec-v2:action:dummy-action:0000001:dummy:1",
+        "description": "Description",
+        "in": [],
+        "out": null
+    }"""
+    act = MiotAction.parse_raw(data)
+    assert act.inputs == []
+    assert act.outputs in (None, [])
+
+
+def test_action_both_in_out_null_parses():
+    """Both `in` and `out` null must parse without crashing."""
+    data = """
+    {
+        "iid": 1,
+        "type": "urn:miot-spec-v2:action:dummy-action:0000001:dummy:1",
+        "description": "Description",
+        "in": null,
+        "out": null
+    }"""
+    act = MiotAction.parse_raw(data)
+    assert act.inputs in (None, [])
+    assert act.outputs in (None, [])
+
+
+def test_service_with_action_having_null_in_out_parses():
+    """Repro for the Roidmi V66 issue: service whose action has null `in`/`out`.
+
+    Previously this raised a pydantic ValidationError (NoneType is not iterable)
+    during MiotService.__init__ -> fill_from_parent.
+    """
+    data = """
+    {
+        "iid": 1,
+        "description": "test service",
+        "type": "urn:miot-spec-v2:service:device-information:00000001:dummy:1",
+        "properties": [],
+        "actions": [
+        {
+            "iid": 1,
+            "type": "urn:miot-spec-v2:action:start-sweep:00000004:dummy:1",
+            "description": "Start Sweep",
+            "in": null,
+            "out": null
+        }
+        ],
+        "events": []
+    }
+    """
+    serv = MiotService.parse_raw(data)
+    assert len(serv.actions) == 1
+
+    assert serv.actions[0].inputs == []
+    assert serv.actions[0].outputs == []
+
+
 @pytest.mark.parametrize(
     ("urn_string", "unexpected"),
     [
