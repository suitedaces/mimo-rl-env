--- /dev/null
+++ b/usercase-test-coderl/google.test.ts
@@ -0,0 +1,503 @@
+import { describe, expect, it, vi } from "vitest";
+import type { OAuth2Tokens } from "arctic";
+import {
+	GoogleStrategy,
+	GoogleStrategyDefaultName,
+	GoogleStrategyDefaultScopes,
+	SocialsProvider,
+	type GoogleExtraParams,
+	type GoogleProfile,
+	type GoogleScope,
+	type GoogleStrategyOptions,
+} from "remix-auth-socials";
+import type { OAuth2Strategy } from "remix-auth-oauth2";
+
+type User = { userId: string };
+
+const verify: OAuth2Strategy<User>["verify"] = async () => ({
+	userId: "verified-user",
+});
+
+function defaultOptions(overrides: Partial<GoogleStrategyOptions> = {}) {
+	return {
+		clientId: "client-default",
+		clientSecret: "secret-default",
+		redirectURI: "https://app.test/auth/google/callback",
+		...overrides,
+	} satisfies GoogleStrategyOptions;
+}
+
+async function authorizationRedirect(strategy: GoogleStrategy<User>) {
+	try {
+		await strategy.authenticate(new Request("https://app.test/auth/google"));
+		throw new Error("authenticate unexpectedly resolved");
+	} catch (error) {
+		if (error instanceof Response) {
+			return error;
+		}
+		throw error;
+	}
+}
+
+async function deterministicAuthorizationParams(strategy: GoogleStrategy<User>) {
+	const response = await authorizationRedirect(strategy);
+	const url = new URL(response.headers.get("Location") ?? "");
+	const params = Object.fromEntries(url.searchParams.entries());
+	delete params.state;
+	delete params.code_challenge;
+	return {
+		status: response.status,
+		endpoint: `${url.origin}${url.pathname}`,
+		params,
+	};
+}
+
+describe("GoogleStrategy public API", () => {
+	it("exports the Google strategy names, defaults, and option/profile type surface", () => {
+
+
+
+
+		const scopes: GoogleScope[] = [
+			"openid",
+			"https://www.googleapis.com/auth/userinfo.profile",
+			"https://www.googleapis.com/auth/userinfo.email",
+		];
+		const options: GoogleStrategyOptions = defaultOptions({ scopes });
+		const extraParams: GoogleExtraParams = {
+			expires_in: 3920,
+			token_type: "Bearer",
+			scope: "openid email",
+			id_token: "id-token-value",
+		};
+		const profile: GoogleProfile = {
+			id: "g-1",
+			displayName: "Alice Example",
+			name: { givenName: "Alice", familyName: "Example" },
+			emails: [{ value: "alice@example.com" }],
+			photos: [{ value: "https://cdn.test/alice.jpg" }],
+			_json: {
+				sub: "g-1",
+				name: "Alice Example",
+				given_name: "Alice",
+				family_name: "Example",
+				picture: "https://cdn.test/alice.jpg",
+				locale: "en",
+				email: "alice@example.com",
+				email_verified: true,
+				hd: "example.com",
+			},
+		};
+
+		const strategy = new GoogleStrategy<User>(options, verify);
+
+		expect(SocialsProvider.GOOGLE).toBe("google");
+		expect(GoogleStrategyDefaultName).toBe("google");
+
+		expect(new Set(GoogleStrategyDefaultScopes)).toEqual(
+			new Set([
+				"openid",
+				"https://www.googleapis.com/auth/userinfo.profile",
+				"https://www.googleapis.com/auth/userinfo.email",
+			]),
+		);
+		expect(GoogleStrategyDefaultScopes).toHaveLength(3);
+		expect(strategy.name).toBe("google");
+		expect(extraParams).toEqual({
+			expires_in: 3920,
+			token_type: "Bearer",
+			scope: "openid email",
+			id_token: "id-token-value",
+		});
+		expect(profile.id).toBe("g-1");
+	});
+
+	it("creates a default Google authorization redirect with endpoint, scopes, and default extra params", async () => {
+
+
+
+
+		const strategy = new GoogleStrategy<User>(defaultOptions(), verify);
+
+		const redirect = await deterministicAuthorizationParams(strategy);
+
+		expect(strategy.name).toBe("google");
+
+		expect(redirect.status).toBeGreaterThanOrEqual(300);
+		expect(redirect.status).toBeLessThan(400);
+		expect(redirect.endpoint).toBe(
+			"https://accounts.google.com/o/oauth2/v2/auth",
+		);
+		expect(redirect.params.response_type).toBe("code");
+		expect(redirect.params.client_id).toBe("client-default");
+		expect(redirect.params.redirect_uri).toBe(
+			"https://app.test/auth/google/callback",
+		);
+		expect(new Set((redirect.params.scope ?? "").split(" "))).toEqual(
+			new Set([
+				"openid",
+				"https://www.googleapis.com/auth/userinfo.profile",
+				"https://www.googleapis.com/auth/userinfo.email",
+			]),
+		);
+		expect(redirect.params.access_type).toBe("online");
+		expect(redirect.params.include_granted_scopes).toBe("false");
+	});
+
+	it("creates a configured Google authorization redirect with custom scopes and optional Google params", async () => {
+
+
+
+
+		const strategy = new GoogleStrategy<User>(
+			defaultOptions({
+				clientId: "client-custom",
+				clientSecret: "secret-custom",
+				redirectURI: "https://app.test/google/callback",
+				scopes: ["email", "profile"],
+				accessType: "offline",
+				includeGrantedScopes: true,
+				prompt: "consent",
+				hd: "example.com",
+				loginHint: "alice@example.com",
+			}),
+			verify,
+		);
+
+		const redirect = await deterministicAuthorizationParams(strategy);
+
+		expect(strategy.name).toBe("google");
+
+		expect(redirect.status).toBeGreaterThanOrEqual(300);
+		expect(redirect.status).toBeLessThan(400);
+		expect(redirect.endpoint).toBe(
+			"https://accounts.google.com/o/oauth2/v2/auth",
+		);
+		expect(redirect.params.response_type).toBe("code");
+		expect(redirect.params.client_id).toBe("client-custom");
+		expect(redirect.params.redirect_uri).toBe(
+			"https://app.test/google/callback",
+		);
+		expect(new Set((redirect.params.scope ?? "").split(" "))).toEqual(
+			new Set(["email", "profile"]),
+		);
+		expect(redirect.params.access_type).toBe("offline");
+		expect(redirect.params.include_granted_scopes).toBe("true");
+		expect(redirect.params.prompt).toBe("consent");
+		expect(redirect.params.hd).toBe("example.com");
+		expect(redirect.params.login_hint).toBe("alice@example.com");
+	});
+
+	it("exchanges the callback authorization code at Google's token endpoint before verify resolves the user", async () => {
+
+
+
+
+		const tokenCalls: Array<{
+			url: string;
+			method: string;
+			authorization: string | null;
+			contentType: string | null;
+			grantType: string | null;
+			code: string | null;
+			redirectURI: string | null;
+		}> = [];
+		vi.stubGlobal("fetch", async (request: Request) => {
+			const body = new URLSearchParams(await request.text());
+			tokenCalls.push({
+				url: request.url,
+				method: request.method,
+				authorization: request.headers.get("Authorization"),
+				contentType: request.headers.get("Content-Type"),
+				grantType: body.get("grant_type"),
+				code: body.get("code"),
+				redirectURI: body.get("redirect_uri"),
+			});
+			return new Response(
+				JSON.stringify({
+					access_token: "access-from-token-endpoint",
+					token_type: "Bearer",
+					expires_in: 3920,
+					scope: "openid email",
+					id_token: "id-token-value",
+				}),
+				{ status: 200, headers: { "Content-Type": "application/json" } },
+			);
+		});
+		const verifyCalls: Array<{
+			accessToken: string;
+			tokenType: string;
+			expiresIn: number;
+			scopes: string[];
+			idToken: string;
+		}> = [];
+		const strategy = new GoogleStrategy<User>(
+			defaultOptions(),
+			async ({ tokens }) => {
+				verifyCalls.push({
+					accessToken: tokens.accessToken(),
+					tokenType: tokens.tokenType(),
+					expiresIn: tokens.accessTokenExpiresInSeconds(),
+					scopes: tokens.scopes(),
+					idToken: tokens.idToken(),
+				});
+				return { userId: "from-verify" };
+			},
+		);
+
+		const redirect = await authorizationRedirect(strategy);
+		const redirectLocation = new URL(redirect.headers.get("Location") ?? "");
+		const state = redirectLocation.searchParams.get("state");
+		const cookie = (redirect.headers.get("Set-Cookie") ?? "").split(";")[0] ?? "";
+		const user = await strategy.authenticate(
+			new Request(
+				`https://app.test/auth/google/callback?state=${state}&code=auth-code-123`,
+				{ headers: { Cookie: cookie } },
+			),
+		);
+
+		expect(user).toEqual({ userId: "from-verify" });
+
+		expect(tokenCalls).toHaveLength(1);
+		expect(tokenCalls[0]).toMatchObject({
+			url: "https://oauth2.googleapis.com/token",
+			method: "POST",
+			grantType: "authorization_code",
+			code: "auth-code-123",
+			redirectURI: "https://app.test/auth/google/callback",
+		});
+		expect(verifyCalls).toHaveLength(1);
+		expect(verifyCalls[0]?.accessToken).toBe("access-from-token-endpoint");
+	});
+
+	it("normalizes Alice's Google userinfo response and sends the bearer access token", async () => {
+
+
+
+
+		const calls: Array<{ input: string; authorization: string | null }> = [];
+		const raw = {
+			sub: "g-1",
+			name: "Alice Example",
+			given_name: "Alice",
+			family_name: "Example",
+			picture: "https://cdn.test/alice.jpg",
+			locale: "en",
+			email: "alice@example.com",
+			email_verified: true,
+			hd: "example.com",
+		};
+		vi.stubGlobal("fetch", async (input: RequestInfo | URL, init?: RequestInit) => {
+			calls.push({
+				input: input.toString(),
+				authorization: new Headers(init?.headers).get("Authorization"),
+			});
+			return new Response(JSON.stringify(raw), {
+				status: 200,
+				headers: { "Content-Type": "application/json" },
+			});
+		});
+
+		const profile = await GoogleStrategy.userProfile({
+			accessToken: () => "alice-access-token",
+		} as OAuth2Tokens);
+
+		expect(calls).toEqual([
+			{
+				input: "https://www.googleapis.com/oauth2/v3/userinfo",
+				authorization: "Bearer alice-access-token",
+			},
+		]);
+		expect(profile).toEqual({
+			id: "g-1",
+			displayName: "Alice Example",
+			name: { familyName: "Example", givenName: "Alice" },
+			emails: [{ value: "alice@example.com" }],
+			photos: [{ value: "https://cdn.test/alice.jpg" }],
+			_json: raw,
+		});
+	});
+
+	it("normalizes Bob's Google userinfo response independently of Alice's values", async () => {
+
+
+
+
+		const calls: Array<{ input: string; authorization: string | null }> = [];
+		const raw = {
+			sub: "g-2",
+			name: "Bob Stone",
+			given_name: "Bob",
+			family_name: "Stone",
+			picture: "https://cdn.test/bob.png",
+			locale: "fr",
+			email: "bob@example.net",
+			email_verified: false,
+			hd: "",
+		};
+		vi.stubGlobal("fetch", async (input: RequestInfo | URL, init?: RequestInit) => {
+			calls.push({
+				input: input.toString(),
+				authorization: new Headers(init?.headers).get("Authorization"),
+			});
+			return new Response(JSON.stringify(raw), {
+				status: 200,
+				headers: { "Content-Type": "application/json" },
+			});
+		});
+
+		const profile = await GoogleStrategy.userProfile({
+			accessToken: () => "bob-access-token",
+		} as OAuth2Tokens);
+
+		expect(calls).toEqual([
+			{
+				input: "https://www.googleapis.com/oauth2/v3/userinfo",
+				authorization: "Bearer bob-access-token",
+			},
+		]);
+		expect(profile).toEqual({
+			id: "g-2",
+			displayName: "Bob Stone",
+			name: { familyName: "Stone", givenName: "Bob" },
+			emails: [{ value: "bob@example.net" }],
+			photos: [{ value: "https://cdn.test/bob.png" }],
+			_json: raw,
+		});
+	});
+
+	it("rejects userProfile with the specific non-OK response message", async () => {
+
+
+
+
+		vi.stubGlobal(
+			"fetch",
+			async () =>
+				new Response("nope", {
+					status: 503,
+					statusText: "Service Unavailable",
+				}),
+		);
+
+
+		try {
+			await GoogleStrategy.userProfile({
+				accessToken: () => "bad-access-token",
+			} as OAuth2Tokens);
+			throw new Error("userProfile unexpectedly resolved");
+		} catch (error) {
+			expect(error).toBeInstanceOf(Error);
+			const message = (error as Error).message;
+			expect(message.startsWith("Failed to fetch user profile:")).toBe(true);
+			expect(message).toContain("Service Unavailable");
+		}
+	});
+
+	it("rejects callback handling when the callback phase is called before an authorization cookie exists", async () => {
+
+
+
+
+		const strategy = new GoogleStrategy<User>(defaultOptions(), verify);
+
+
+		await expect(
+			strategy.authenticate(
+				new Request(
+					"https://app.test/auth/google/callback?state=missing-state&code=abc123",
+				),
+			),
+		).rejects.toThrow();
+	});
+
+	it("keeps configured authorization state independent across two strategy instances", async () => {
+
+
+
+
+		const a = new GoogleStrategy<User>(
+			defaultOptions({
+				clientId: "client-a",
+				clientSecret: "secret-a",
+				redirectURI: "https://app.test/a/callback",
+				scopes: ["email"],
+				accessType: "offline",
+				includeGrantedScopes: true,
+				prompt: "select_account",
+				hd: "a.example",
+				loginHint: "a@example.test",
+			}),
+			verify,
+		);
+		const b = new GoogleStrategy<User>(
+			defaultOptions({
+				clientId: "client-b",
+				clientSecret: "secret-b",
+				redirectURI: "https://app.test/b/callback",
+			}),
+			verify,
+		);
+
+		const redirectA = await deterministicAuthorizationParams(a);
+		const redirectB = await deterministicAuthorizationParams(b);
+
+
+		expect(redirectA.params).toMatchObject({
+			response_type: "code",
+			client_id: "client-a",
+			redirect_uri: "https://app.test/a/callback",
+			access_type: "offline",
+			include_granted_scopes: "true",
+			prompt: "select_account",
+			hd: "a.example",
+			login_hint: "a@example.test",
+		});
+		expect(new Set((redirectA.params.scope ?? "").split(" "))).toEqual(
+			new Set(["email"]),
+		);
+		expect(redirectB.params).toMatchObject({
+			response_type: "code",
+			client_id: "client-b",
+			redirect_uri: "https://app.test/b/callback",
+			access_type: "online",
+			include_granted_scopes: "false",
+		});
+		expect(new Set((redirectB.params.scope ?? "").split(" "))).toEqual(
+			new Set([
+				"openid",
+				"https://www.googleapis.com/auth/userinfo.profile",
+				"https://www.googleapis.com/auth/userinfo.email",
+			]),
+		);
+	});
+
+	it("constructs and redirects repeatedly using each instance's configured options", async () => {
+
+
+
+
+		for (let i = 0; i < 100; i += 1) {
+			const strategy = new GoogleStrategy<User>(
+				defaultOptions({
+					clientId: `client-${i}`,
+					clientSecret: `secret-${i}`,
+					redirectURI: `https://app.test/${i}/callback`,
+				}),
+				verify,
+			);
+			const redirect = await authorizationRedirect(strategy);
+
+			expect(redirect.status).toBeGreaterThanOrEqual(300);
+			expect(redirect.status).toBeLessThan(400);
+			const url = new URL(redirect.headers.get("Location") ?? "");
+			expect(`${url.origin}${url.pathname}`).toBe(
+				"https://accounts.google.com/o/oauth2/v2/auth",
+			);
+			expect(url.searchParams.get("client_id")).toBe(`client-${i}`);
+			expect(url.searchParams.get("redirect_uri")).toBe(
+				`https://app.test/${i}/callback`,
+			);
+		}
+	});
+});
