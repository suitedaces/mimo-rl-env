+++ b/airbyte-integrations/connectors/source-zenefits/unit_tests/test_zenefits.py
@@ -0,0 +1,110 @@
+
+
+
+
+import pytest
+import requests_mock
+from airbyte_cdk.models import SyncMode
+from source_zenefits.source import SourceZenefits
+
+CONFIG = {"token": "TESTTOKEN"}
+
+EXPECTED_STREAMS = {
+    "people": "core/people",
+    "employments": "core/employments",
+    "departments": "core/departments",
+    "locations": "core/locations",
+    "labor_groups": "core/labor_groups",
+    "labor_group_types": "core/labor_group_types",
+    "custom_fields": "core/custom_fields",
+    "custom_field_values": "core/custom_field_values",
+    "vacation_requests": "time_off/vacation_requests",
+    "vacation_types": "time_off/vacation_types",
+    "time_durations": "time_attendance/time_durations",
+}
+
+
+def _streams_by_name():
+    return {stream.name: stream for stream in SourceZenefits().streams(CONFIG)}
+
+
+def test_streams_count():
+    assert len(SourceZenefits().streams(CONFIG)) == len(EXPECTED_STREAMS)
+
+
+def test_stream_names():
+    assert set(_streams_by_name().keys()) == set(EXPECTED_STREAMS.keys())
+
+
+@pytest.mark.parametrize("name,path", list(EXPECTED_STREAMS.items()))
+def test_stream_path(name, path):
+    stream = _streams_by_name()[name]
+    assert stream.path() == path
+
+
+def test_base_url():
+    for stream in _streams_by_name().values():
+        assert stream.url_base == "https://api.zenefits.com/"
+
+
+def test_records_parsed_from_envelope():
+    stream = _streams_by_name()["people"]
+    body = {"data": {"data": [{"id": "1"}, {"id": "2"}], "next_url": None}}
+    with requests_mock.Mocker() as m:
+        m.get(requests_mock.ANY, json=body, status_code=200)
+        records = list(stream.read_records(sync_mode=SyncMode.full_refresh))
+    assert records == [{"id": "1"}, {"id": "2"}]
+
+
+def test_authorization_header_is_bearer_token():
+    stream = _streams_by_name()["people"]
+    body = {"data": {"data": [{"id": "1"}], "next_url": None}}
+    with requests_mock.Mocker() as m:
+        m.get(requests_mock.ANY, json=body, status_code=200)
+        list(stream.read_records(sync_mode=SyncMode.full_refresh))
+        assert m.call_count == 1
+        assert m.request_history[0].headers.get("Authorization") == "Bearer TESTTOKEN"
+
+
+def test_pagination_follows_next_url():
+    stream = _streams_by_name()["people"]
+    page1 = {
+        "data": {
+            "data": [{"id": "1"}, {"id": "2"}],
+            "next_url": "https://api.zenefits.com/core/people?starting_after=2",
+        }
+    }
+    page2 = {"data": {"data": [{"id": "3"}], "next_url": None}}
+    with requests_mock.Mocker() as m:
+        m.get(requests_mock.ANY, [{"json": page1, "status_code": 200}, {"json": page2, "status_code": 200}])
+        records = list(stream.read_records(sync_mode=SyncMode.full_refresh))
+    assert records == [{"id": "1"}, {"id": "2"}, {"id": "3"}]
+
+
+def test_pagination_stops_when_no_next_url():
+    stream = _streams_by_name()["people"]
+    body = {"data": {"data": [{"id": "1"}], "next_url": None}}
+    with requests_mock.Mocker() as m:
+        m.get(requests_mock.ANY, json=body, status_code=200)
+        list(stream.read_records(sync_mode=SyncMode.full_refresh))
+        assert m.call_count == 1
+
+
+def test_check_connection_success():
+    source = SourceZenefits()
+    with requests_mock.Mocker() as m:
+        m.get(requests_mock.ANY, json={"data": {"data": []}}, status_code=200)
+        result = source.check_connection(None, CONFIG)
+    ok, error = result
+    assert ok is True
+    assert not error
+
+
+def test_check_connection_failure():
+    source = SourceZenefits()
+    with requests_mock.Mocker() as m:
+        m.get(requests_mock.ANY, json={"error": "invalid token"}, status_code=401)
+        result = source.check_connection(None, CONFIG)
+    ok, error = result
+    assert ok is False
+    assert error
