+    def test_module_end_lineno_from_parse(self) -> None:
+        """Module.end_lineno should be accessible (None) instead of AttributeError."""
+        code = """
+    print("a module")
+    """
+        module = builder.parse(code)
+
+        self.assertIsNone(module.end_lineno)
+
+    def test_module_end_col_offset_from_parse(self) -> None:
+        """Module.end_col_offset should be accessible (None) instead of AttributeError."""
+        code = """
+    print("a module")
+    """
+        module = builder.parse(code)
+        self.assertIsNone(module.end_col_offset)
+
+    def test_module_col_offset_from_parse(self) -> None:
+        """Module.col_offset should be accessible (None) instead of AttributeError."""
+        code = """
+    print("a module")
+    """
+        module = builder.parse(code)
+        self.assertIsNone(module.col_offset)
+
+    def test_module_lineno_preserved(self) -> None:
+        """Module.lineno should remain 0 (preservation of pre-existing behavior)."""
+        code = """
+    print("a module")
+    """
+        module = builder.parse(code)
+        self.assertEqual(module.lineno, 0)
+
+    def test_module_parent_default_none(self) -> None:
+        """Module.parent should default to None when no parent is passed."""
+        code = """
+    print("a module")
+    """
+        module = builder.parse(code)
+        self.assertIsNone(module.parent)
+
+    def test_module_direct_construction_attributes(self) -> None:
+        """Directly constructed Module must expose all position attrs."""
+        m = nodes.Module("test", "doc")
+
+        self.assertIsNone(m.end_lineno)
+        self.assertIsNone(m.end_col_offset)
+        self.assertIsNone(m.col_offset)
+        self.assertEqual(m.lineno, 0)
+        self.assertIsNone(m.parent)
+
+    def test_module_attributes_are_instance_attributes(self) -> None:
+        """Each Module instance should have its own end_lineno (no shared state)."""
+        m1 = nodes.Module("m1", "doc")
+        m2 = nodes.Module("m2", "doc")
+
+        self.assertIsNone(m1.end_lineno)
+        self.assertIsNone(m2.end_lineno)
+        self.assertIsNone(m1.end_col_offset)
+        self.assertIsNone(m2.end_col_offset)
+
 
