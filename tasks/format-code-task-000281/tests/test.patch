@@ -0,0 +1,101 @@
+import json
+import unittest
+
+from common.storage.columns import (
+    ArrayColumn,
+    Column,
+    CREATED_ON,
+    JSONColumn,
+    StringColumn,
+    UpsertStrategy,
+    URLColumn,
+)
+
+
+class PassthroughColumn(Column):
+
+
+    def __init__(self):
+        super().__init__("value", required=False)
+
+    def prepare_string(self, value):
+        return value
+
+
+class ColumnSerializationContractTests(unittest.TestCase):
+    def test_json_preserves_scalar_types_at_every_nesting_level(self):
+        value = {
+            "count": 3,
+            "enabled": False,
+            "nested": [{"ratio": 1.5, "missing": None}],
+        }
+        encoded = JSONColumn("metadata", required=False).prepare_string(value)
+
+        self.assertEqual(json.loads(encoded), value)
+        self.assertIsInstance(json.loads(encoded)["count"], int)
+        self.assertIs(json.loads(encoded)["enabled"], False)
+
+    def test_json_sanitizes_string_leaves_without_touching_scalars(self):
+        value = {"outer": ["  hello\tworld  ", {"n": 7, "flag": True}]}
+        encoded = JSONColumn("metadata", required=False).prepare_string(value)
+
+        self.assertEqual(
+            json.loads(encoded),
+            {"outer": ["hello world", {"n": 7, "flag": True}]},
+        )
+
+    def test_json_uses_null_for_absent_or_empty_containers(self):
+        column = JSONColumn("metadata", required=False)
+        self.assertIsNone(column.prepare_string(None))
+        self.assertIsNone(column.prepare_string({}))
+        self.assertIsNone(column.prepare_string([]))
+        self.assertEqual(json.loads(column.prepare_string([None])), [None])
+
+    def test_array_uses_postgres_literal_escaping(self):
+        column = ArrayColumn("values", required=False, base_column=PassthroughColumn())
+        value = ["simple", "has,comma", 'has"quote', r"has\slash", "NULL"]
+
+        encoded = column.prepare_string(value)
+        self.assertTrue(encoded.startswith("{") and encoded.endswith("}"))
+        self.assertIn('"has,comma"', encoded)
+        self.assertIn('"has\\\"quote"', encoded)
+        self.assertIn('"has\\\\slash"', encoded)
+        self.assertIn('"NULL"', encoded)
+
+    def test_array_distinguishes_null_elements_and_invalid_values(self):
+        column = ArrayColumn(
+            "values",
+            required=False,
+            base_column=StringColumn("value", required=False, size=3, truncate=False),
+        )
+
+        encoded = column.prepare_string(["ok", None, "too-long"])
+        self.assertEqual(encoded.replace(" ", "").lower(), '{"ok",null,null}')
+        self.assertEqual(column.prepare_string("ok").replace(" ", ""), "{ok}")
+        self.assertIsNone(column.prepare_string(None))
+
+    def test_array_empty_value_is_explicit_empty_array_and_input_is_unchanged(self):
+        column = ArrayColumn("values", required=False, base_column=PassthroughColumn())
+        value = ["a", "b"]
+        original = list(value)
+
+        self.assertEqual(column.prepare_string([]), "{}")
+        self.assertEqual(column.prepare_string(value).replace(" ", ""), '{"a","b"}')
+        self.assertEqual(value, original)
+
+    def test_no_change_upsert_strategy_is_a_valid_self_assignment(self):
+        self.assertEqual(CREATED_ON.upsert_strategy, UpsertStrategy.no_change)
+        self.assertEqual(CREATED_ON.upsert_name, "NOW()")
+        self.assertEqual(CREATED_ON.upsert_value, "created_on = old.created_on")
+
+    def test_existing_string_and_url_column_contracts_remain_compatible(self):
+        string = StringColumn("title", required=False, size=5, truncate=True)
+        self.assertEqual(string.prepare_string('  a"bcd  '), "a'bcd")
+
+        url = URLColumn("url", required=False, size=30)
+        self.assertEqual(url.prepare_string("https://example.org/a"), "https://example.org/a")
+        self.assertIsNone(url.prepare_string(" https://example.org/a"))
+
+
+if __name__ == "__main__":
+    unittest.main()
