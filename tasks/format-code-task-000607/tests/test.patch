diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,242 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC NO_COLOR=1
+
+export GOPROXY=off GOSUMDB=off GOTOOLCHAIN=local
+
+( cd /workspace/repo/app && make build ) \
+    || { echo "FAIL: build" >&2; exit 1; }
+BIN=/workspace/repo/app/build/devcockpit
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || exit 1
+
+fail() {
+    echo "FAIL: $*" >&2
+    exit 1
+}
+
+repeat_char() {
+    local count=$1 char=$2 out=""
+    local i
+    for ((i = 0; i < count; i++)); do
+        out="${out}${char}"
+    done
+    printf '%s' "$out"
+}
+
+normalize_text() {
+
+
+    sed -E $'s/\x1B\\[[0-9;?]*[ -/]*[@-~]//g; s/[[:space:]]*$//' "$1"
+}
+
+assert_table_shape() {
+    local fixture=$1
+    normalize_text out >out.norm
+
+
+    grep -Fx "Dev Cockpit ${EM_DASH} Cache Sizes" out.norm >/dev/null \
+        || fail "$fixture missing mandated cache-size heading"
+    grep -E 'CACHE[[:space:]]+SIZE' out.norm >/dev/null \
+        || fail "$fixture missing CACHE/SIZE columns"
+    grep -E "[-${HLINE}]{5,}" out.norm >/dev/null \
+        || fail "$fixture missing separator line"
+}
+
+assert_table_row() {
+    local fixture=$1 label_regex=$2 size=$3
+    grep -E "${label_regex}.*[[:space:]]+${size//./\\.}([[:space:]]*)$" out.norm >/dev/null \
+        || fail "$fixture missing row matching /$label_regex/ with size $size"
+}
+
+assert_no_table_row() {
+    local fixture=$1 label_regex=$2
+    ! grep -E "$label_regex" out.norm >/dev/null \
+        || fail "$fixture unexpectedly printed row matching /$label_regex/"
+}
+
+assert_total_row() {
+    local fixture=$1 size=$2
+    local last
+    last=$(awk 'NF { line=$0 } END { print line }' out.norm)
+    [[ "$last" =~ Total ]] || fail "$fixture final non-empty row is not Total: $last"
+    [[ "$last" =~ $size ]] || fail "$fixture Total row does not contain $size: $last"
+}
+
+assert_empty_stderr() {
+    local fixture=$1
+    [ ! -s err ] || fail "$fixture unexpected stderr: $(cat err)"
+}
+
+EM_DASH=$(printf '\342\200\224')
+HLINE=$(printf '\342\224\200')
+ARROW=$(printf '\342\206\222')
+HEADER_RULE=$(repeat_char 25 "$HLINE")
+TABLE_RULE=$(repeat_char 40 "$HLINE")
+
+
+
+
+mkdir -p f1/home/.cache f1/home/.npm/_cacache f1/home/.cache/yarn f1/home/go/pkg/mod/cache \
+    f1/home/.cache/pip f1/home/.gradle/caches f1/home/.m2/repository f1/home/.docker f1/bin
+cat >f1/bin/du <<'DU'
+#!/usr/bin/env bash
+#
+# the last argument instead of coupling to gold's exact argv shape.
+path="${@: -1}"
+case "$path" in
+  */.cache) echo "0	$path" ;;
+  */.npm/_cacache) echo "1	$path" ;;
+  */.cache/yarn) echo "1536	$path" ;;
+  */go/pkg/mod/cache) echo "2048	$path" ;;
+  */.cache/pip) echo "1048576	$path" ;;
+  */.gradle/caches) echo "1572864	$path" ;;
+  */.m2/repository) echo "5242880	$path" ;;
+  */.docker) echo "6291456	$path" ;;
+  *) echo "0	$path" ;;
+esac
+DU
+chmod +x f1/bin/du
+HOME="$TMP/f1/home" PATH="$TMP/f1/bin:$PATH" "$BIN" cleanup list >out 2>err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+
+
+assert_table_shape F1
+assert_table_row F1 'User[[:space:]]+Cache' '0 B'
+assert_table_row F1 'npm[[:space:]]+Cache' '1.0 KB'
+assert_table_row F1 'Yarn[[:space:]]+Cache' '1.5 MB'
+assert_table_row F1 'Go[[:space:]]+Module[[:space:]]+Cache' '2.0 MB'
+assert_table_row F1 'pip[[:space:]]+Cache' '1.0 GB'
+assert_table_row F1 'Gradle[[:space:]]+Cache' '1.5 GB'
+assert_table_row F1 'Maven[[:space:]]+Cache' '5.0 GB'
+assert_table_row F1 'Docker' '6.0 GB'
+assert_total_row F1 '13.5 GB'
+assert_empty_stderr F1
+
+
+
+
+mkdir -p f2/home/.npm/_cacache f2/bin
+cat >f2/bin/du <<'DU'
+#!/usr/bin/env bash
+#
+# the last argument instead of coupling to gold's exact argv shape.
+path="${@: -1}"
+echo "du: cannot read $path" >&2
+exit 2
+DU
+chmod +x f2/bin/du
+HOME="$TMP/f2/home" PATH="$TMP/f2/bin:$PATH" "$BIN" cleanup list >out 2>err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+
+
+assert_table_shape F2
+assert_table_row F2 'npm[[:space:]]+Cache' '0 B'
+assert_no_table_row F2 'User[[:space:]]+Cache'
+assert_no_table_row F2 'Yarn[[:space:]]+Cache'
+assert_no_table_row F2 'Go[[:space:]]+Module[[:space:]]+Cache'
+assert_no_table_row F2 'pip[[:space:]]+Cache'
+assert_no_table_row F2 'Gradle[[:space:]]+Cache'
+assert_no_table_row F2 'Maven[[:space:]]+Cache'
+assert_no_table_row F2 'Docker'
+assert_total_row F2 '0 B'
+assert_empty_stderr F2
+
+
+
+
+HOME= "$BIN" cleanup list >out 2>err
+ec=$?
+[ "$ec" -eq 1 ] || fail "F3 exit $ec; want 1"
+EXPECTED_ERR='Error: Cannot determine home directory'
+[ "$(normalize_text err)" = "$EXPECTED_ERR" ] || fail "F3 stderr: $(cat err)"
+
+
+
+
+"$BIN" --help >out 2>err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+assert_empty_stderr F4
+grep -Fx '  devcockpit cleanup list          Show cache sizes' out >/dev/null \
+    || {
+
+
+        awk '/^CLI COMMANDS:/ { in_commands=1; next } /^EXAMPLES:/ { in_commands=0 } in_commands' out \
+            | grep -E 'devcockpit[[:space:]]+cleanup[[:space:]]+list.*(cache|size)' >/dev/null \
+            || fail "F4 missing cleanup list command in help"
+    }
+grep -Fx '  devcockpit cleanup list         # See cache sizes' out >/dev/null \
+    || {
+
+
+        awk '/^EXAMPLES:/ { in_examples=1; next } /^CONFIGURATION:/ { in_examples=0 } in_examples' out \
+            | grep -E 'devcockpit[[:space:]]+cleanup[[:space:]]+list' >/dev/null \
+            || fail "F4 missing cleanup list example in help"
+    }
+
+
+
+
+mkdir -p f5/home/.cache f5/home/.npm/_cacache f5/home/.cache/yarn f5/bin
+cat >f5/bin/du <<'DU'
+#!/usr/bin/env bash
+#
+# the last argument instead of coupling to gold's exact argv shape.
+path="${@: -1}"
+case "$path" in
+  */.cache|*/.npm/_cacache|*/.cache/yarn) echo "2097152	$path" ;;
+  *) echo "0	$path" ;;
+esac
+DU
+chmod +x f5/bin/du
+
+
+
+cat >f5/bin/dig <<'DIG'
+#!/usr/bin/env bash
+echo "127.0.0.1"
+DIG
+cat >f5/bin/ip <<'IP'
+#!/usr/bin/env bash
+echo "default via 127.0.0.1 dev lo"
+IP
+cat >f5/bin/ping <<'PING'
+#!/usr/bin/env bash
+echo "rtt min/avg/max/mdev = 0.026/0.026/0.026/0.000 ms"
+PING
+cat >f5/bin/ufw <<'UFW'
+#!/usr/bin/env bash
+echo "Status: active"
+UFW
+cat >f5/bin/brew <<'BREW'
+#!/usr/bin/env bash
+exit 127
+BREW
+chmod +x f5/bin/dig f5/bin/ip f5/bin/ping f5/bin/ufw f5/bin/brew
+HOME="$TMP/f5/home" PATH="$TMP/f5/bin:$PATH" "$BIN" diag >out 2>err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+assert_empty_stderr F5
+grep -F "Storage            WARN  3 caches, 6.0 GB total ${EM_DASH} 3 over 1 GB" out >/dev/null \
+    || {
+
+
+        grep -E 'Storage.*(WARN|Warning|warn|warning|cache)' out >/dev/null \
+            || fail "F5 missing storage diagnostics output for large caches"
+    }
+grep -F "${ARROW} Run 'devcockpit cleanup list' for details" out >/dev/null \
+    || {
+
+
+        grep -F "devcockpit cleanup list" out >/dev/null \
+            || fail "F5 missing cleanup list diagnostics suggestion"
+    }
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+
+export GOPROXY=off
+export GOSUMDB=off
+export GOTOOLCHAIN=local
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
