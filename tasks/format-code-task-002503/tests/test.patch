diff --git a/redisinsight/ui/src/pages/search/utils/tests/argumentAtOffset.spec.ts b/redisinsight/ui/src/pages/search/utils/tests/argumentAtOffset.spec.ts
new file mode 100644
index 000000000..eb40abea3
--- /dev/null
+++ b/redisinsight/ui/src/pages/search/utils/tests/argumentAtOffset.spec.ts
@@ -0,0 +1,53 @@
+import { getArgumentAtOffset } from 'uiSrc/pages/search/utils'
+
+const tests: Array<{ input: [string, number?]; result: any }> = [
+
+  { input: ['FT.SEARCH idx body', 0], result: { value: 'FT.SEARCH', start: 0, stop: 9 } },
+  { input: ['FT.SEARCH idx body', 5], result: { value: 'FT.SEARCH', start: 0, stop: 9 } },
+  { input: ['FT.SEARCH idx body', 9], result: { value: 'FT.SEARCH', start: 0, stop: 9 } },
+  { input: ['FT.SEARCH idx body', 10], result: { value: 'idx', start: 10, stop: 13 } },
+  { input: ['FT.SEARCH idx body', 13], result: { value: 'idx', start: 10, stop: 13 } },
+  { input: ['FT.SEARCH idx body', 14], result: { value: 'body', start: 14, stop: 18 } },
+  { input: ['FT.SEARCH idx body', 18], result: { value: 'body', start: 14, stop: 18 } },
+
+
+  { input: ['hello world', 2], result: { value: 'hello', start: 0, stop: 5 } },
+
+
+  { input: ['FT.SEARCH "idx:bicycle" body', 14], result: { value: '"idx:bicycle"', start: 10, stop: 23 } },
+  { input: ['FT.SEARCH "idx:bicycle" body', 10], result: { value: '"idx:bicycle"', start: 10, stop: 23 } },
+  { input: ['FT.SEARCH "idx:bicycle" body', 23], result: { value: '"idx:bicycle"', start: 10, stop: 23 } },
+  { input: ["FT.SEARCH 'a b' c", 12], result: { value: "'a b'", start: 10, stop: 15 } },
+  { input: ['"a b c"', 3], result: { value: '"a b c"', start: 0, stop: 7 } },
+
+
+  { input: ['a\\ b c', 2], result: { value: 'a\\ b', start: 0, stop: 4 } },
+  { input: ['a\\ b c', 5], result: { value: 'c', start: 5, stop: 6 } },
+
+
+  { input: ['LOAD * foo', 4], result: { value: 'LOAD *', start: 0, stop: 6 } },
+  { input: ['LOAD * foo', 6], result: { value: 'LOAD *', start: 0, stop: 6 } },
+  { input: ['LOAD * foo', 7], result: { value: 'foo', start: 7, stop: 10 } },
+
+
+  { input: ['ab  cd', 3], result: null },
+  { input: ['ab cd ', 6], result: null },
+  { input: ['   ab', 1], result: null },
+  { input: ['', 0], result: null },
+  { input: [' ', 0], result: null },
+
+
+  { input: ['ab cd', 2], result: { value: 'ab', start: 0, stop: 2 } },
+  { input: ['ab cd', 3], result: { value: 'cd', start: 3, stop: 5 } },
+]
+
+describe('getArgumentAtOffset', () => {
+  it.each(tests)('resolves argument for %j', ({ input, result }) => {
+    expect(getArgumentAtOffset(...input)).toEqual(result)
+  })
+
+  it('defaults the offset to the end of the query', () => {
+    expect(getArgumentAtOffset('FT.SEARCH idx body')).toEqual({ value: 'body', start: 14, stop: 18 })
+    expect(getArgumentAtOffset('FT.SEARCH idx body ')).toEqual(null)
+  })
+})
