+func TestVerifierFailedEventsOmitEmptyModuleContext(t *testing.T) {
+	boom := errors.New("verifier option failure")
+	tests := []struct {
+		name  string
+		event fxevent.Event
+		want  string
+	}{
+		{
+			name:  "Supplied",
+			event: &fxevent.Supplied{TypeName: "verifier.Type", Err: boom},
+			want:  "[Fx] ERROR\tFailed to supply verifier.Type: verifier option failure\n",
+		},
+		{
+			name: "Provided",
+			event: &fxevent.Provided{
+				ConstructorName: "verifier.New",
+				OutputTypeNames: []string{"verifier.A"},
+				Err:             boom,
+			},
+			want: "[Fx] ERROR\tFailed to provide [verifier.A] from verifier.New: verifier option failure\n",
+		},
+		{
+			name: "Replaced",
+			event: &fxevent.Replaced{
+				OutputTypeNames: []string{"verifier.A"},
+				Err:             boom,
+			},
+			want: "[Fx] ERROR\tFailed to replace [verifier.A]: verifier option failure\n",
+		},
+		{
+			name: "Decorated",
+			event: &fxevent.Decorated{
+				DecoratorName:   "verifier.Decorate",
+				OutputTypeNames: []string{"verifier.A"},
+				Err:             boom,
+			},
+			want: "[Fx] ERROR\tFailed to decorate [verifier.A] with verifier.Decorate: verifier option failure\n",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			entries := verifierObserveZap(tt.event)
+			require.Len(t, entries, 1)
+			assert.NotContains(t, entries[0].ContextMap(), "module")
+			assert.Equal(t, tt.want, verifierObserveConsole(tt.event))
+		})
+	}
+}
+
+func TestVerifierSuccessfulOptionEventsKeepExistingBehavior(t *testing.T) {
+	t.Run("Supplied", func(t *testing.T) {
+		event := &fxevent.Supplied{TypeName: "verifier.Type", ModuleName: "verifier"}
+		entries := verifierObserveZap(event)
+		require.Len(t, entries, 1)
+		assert.Equal(t, zapcore.InfoLevel, entries[0].Level)
+		assert.Equal(t, "supplied", entries[0].Message)
+		assert.Equal(t, map[string]interface{}{
+			"module": "verifier",
+			"type":   "verifier.Type",
+		}, entries[0].ContextMap())
+		assert.Equal(t,
+			"[Fx] SUPPLY\tverifier.Type from module \"verifier\"\n",
+			verifierObserveConsole(event),
+		)
+	})
+
+	tests := []struct {
+		name          string
+		event         fxevent.Event
+		message       string
+		identityKey   string
+		identityValue string
+		console       string
+	}{
+		{
+			name: "Provided",
+			event: &fxevent.Provided{
+				ConstructorName: "verifier.New",
+				ModuleName:      "verifier",
+				OutputTypeNames: []string{"verifier.A", "verifier.B"},
+			},
+			message:       "provided",
+			identityKey:   "constructor",
+			identityValue: "verifier.New",
+			console: "[Fx] PROVIDE\tverifier.A <= verifier.New from module \"verifier\"\n" +
+				"[Fx] PROVIDE\tverifier.B <= verifier.New from module \"verifier\"\n",
+		},
+		{
+			name: "Replaced",
+			event: &fxevent.Replaced{
+				ModuleName:      "verifier",
+				OutputTypeNames: []string{"verifier.A", "verifier.B"},
+			},
+			message: "replaced",
+			console: "[Fx] REPLACE\tverifier.A from module \"verifier\"\n" +
+				"[Fx] REPLACE\tverifier.B from module \"verifier\"\n",
+		},
+		{
+			name: "Decorated",
+			event: &fxevent.Decorated{
+				DecoratorName:   "verifier.Decorate",
+				ModuleName:      "verifier",
+				OutputTypeNames: []string{"verifier.A", "verifier.B"},
+			},
+			message:       "decorated",
+			identityKey:   "decorator",
+			identityValue: "verifier.Decorate",
+			console: "[Fx] DECORATE\tverifier.A <= verifier.Decorate from module \"verifier\"\n" +
+				"[Fx] DECORATE\tverifier.B <= verifier.Decorate from module \"verifier\"\n",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			entries := verifierObserveZap(tt.event)
+			require.Len(t, entries, 2)
+			for i, typ := range []string{"verifier.A", "verifier.B"} {
+				assert.Equal(t, zapcore.InfoLevel, entries[i].Level)
+				assert.Equal(t, tt.message, entries[i].Message)
+				wantFields := map[string]interface{}{
+					"module": "verifier",
+					"type":   typ,
+				}
+				if tt.identityKey != "" {
+					wantFields[tt.identityKey] = tt.identityValue
+				}
+				assert.Equal(t, wantFields, entries[i].ContextMap())
+			}
+			assert.Equal(t, tt.console, verifierObserveConsole(tt.event))
+		})
+	}
+}
