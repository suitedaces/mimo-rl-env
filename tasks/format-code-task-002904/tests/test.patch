+	"go.uber.org/zap/zaptest/observer"
+)
+
+func verifierObserveZap(event fxevent.Event) []observer.LoggedEntry {
+	core, logs := observer.New(zap.DebugLevel)
+	(&fxevent.ZapLogger{Logger: zap.New(core)}).LogEvent(event)
+	return logs.TakeAll()
+}
+
+func verifierObserveConsole(event fxevent.Event) string {
+	var out bytes.Buffer
+	(&fxevent.ConsoleLogger{W: &out}).LogEvent(event)
+	return out.String()
+}
+
+func TestVerifierZapHookFailuresAreErrorsWithRuntime(t *testing.T) {
+	boom := errors.New("verifier hook failure")
+	tests := []struct {
+		name    string
+		event   fxevent.Event
+		message string
+		callee  string
+		runtime string
+	}{
+		{
+			name: "OnStart",
+			event: &fxevent.OnStartExecuted{
+				FunctionName: "verifier.start",
+				CallerName:   "verifier.module",
+				Runtime:      17 * time.Millisecond,
+				Err:          boom,
+			},
+			message: "OnStart hook failed",
+			callee:  "verifier.start",
+			runtime: "17ms",
+		},
+		{
+			name: "OnStop",
+			event: &fxevent.OnStopExecuted{
+				FunctionName: "verifier.stop",
+				CallerName:   "verifier.module",
+				Runtime:      23 * time.Millisecond,
+				Err:          boom,
+			},
+			message: "OnStop hook failed",
+			callee:  "verifier.stop",
+			runtime: "23ms",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			entries := verifierObserveZap(tt.event)
+			require.Len(t, entries, 1)
+			assert.Equal(t, zapcore.ErrorLevel, entries[0].Level)
+			assert.Equal(t, tt.message, entries[0].Message)
+			fields := entries[0].ContextMap()
+			assert.Equal(t, "verifier.module", fields["caller"])
+			assert.Equal(t, "verifier hook failure", fields["error"])
+			assert.Equal(t, tt.callee, fields["callee"])
+			assert.Equal(t, tt.runtime, fields["runtime"])
+		})
+	}
+
+	assert.Equal(t,
+		"[Fx] HOOK OnStart\t\tverifier.start called by verifier.module failed in 17ms: verifier hook failure\n",
+		verifierObserveConsole(tests[0].event),
+	)
+	assert.Equal(t,
+		"[Fx] HOOK OnStop\t\tverifier.stop called by verifier.module failed in 23ms: verifier hook failure\n",
+		verifierObserveConsole(tests[1].event),
+	)
+}
