+func TestVerifierZapOptionFailuresAreAtomicAndComplete(t *testing.T) {
+	boom := errors.New("verifier option failure")
+	tests := []struct {
+		name    string
+		event   fxevent.Event
+		message string
+		fields  map[string]interface{}
+	}{
+		{
+			name:    "Supplied",
+			event:   &fxevent.Supplied{TypeName: "verifier.Type", ModuleName: "verifier", Err: boom},
+			message: "supply failed",
+			fields: map[string]interface{}{
+				"type":   "verifier.Type",
+				"module": "verifier",
+				"error":  "verifier option failure",
+			},
+		},
+		{
+			name: "ProvidedMultipleOutputs",
+			event: &fxevent.Provided{
+				ConstructorName: "verifier.New",
+				ModuleName:      "verifier",
+				OutputTypeNames: []string{"verifier.A", "verifier.B"},
+				Err:             boom,
+			},
+			message: "provide failed",
+			fields: map[string]interface{}{
+				"constructor": "verifier.New",
+				"module":      "verifier",
+				"types":       []interface{}{"verifier.A", "verifier.B"},
+				"error":       "verifier option failure",
+			},
+		},
+		{
+			name: "ProvidedNoOutputs",
+			event: &fxevent.Provided{
+				ConstructorName: "verifier.Empty",
+				ModuleName:      "verifier",
+				Err:             boom,
+			},
+			message: "provide failed",
+			fields: map[string]interface{}{
+				"constructor": "verifier.Empty",
+				"module":      "verifier",
+				"types":       []interface{}{},
+				"error":       "verifier option failure",
+			},
+		},
+		{
+			name: "Replaced",
+			event: &fxevent.Replaced{
+				ModuleName:      "verifier",
+				OutputTypeNames: []string{"verifier.A", "verifier.B"},
+				Err:             boom,
+			},
+			message: "replace failed",
+			fields: map[string]interface{}{
+				"module": "verifier",
+				"types":  []interface{}{"verifier.A", "verifier.B"},
+				"error":  "verifier option failure",
+			},
+		},
+		{
+			name: "Decorated",
+			event: &fxevent.Decorated{
+				DecoratorName:   "verifier.Decorate",
+				ModuleName:      "verifier",
+				OutputTypeNames: []string{"verifier.A", "verifier.B"},
+				Err:             boom,
+			},
+			message: "decorate failed",
+			fields: map[string]interface{}{
+				"decorator": "verifier.Decorate",
+				"module":    "verifier",
+				"types":     []interface{}{"verifier.A", "verifier.B"},
+				"error":     "verifier option failure",
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			entries := verifierObserveZap(tt.event)
+			require.Len(t, entries, 1, "a failed event must not emit success records")
+			assert.Equal(t, zapcore.ErrorLevel, entries[0].Level)
+			assert.Equal(t, tt.message, entries[0].Message)
+			assert.Equal(t, tt.fields, entries[0].ContextMap())
+		})
+	}
+}
