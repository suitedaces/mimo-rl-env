+func TestVerifierConsoleOptionFailuresAreAtomicAndComplete(t *testing.T) {
+	boom := errors.New("verifier option failure")
+	tests := []struct {
+		name  string
+		event fxevent.Event
+		want  string
+	}{
+		{
+			name:  "Supplied",
+			event: &fxevent.Supplied{TypeName: "verifier.Type", ModuleName: "verifier", Err: boom},
+			want:  "[Fx] ERROR\tFailed to supply verifier.Type from module \"verifier\": verifier option failure\n",
+		},
+		{
+			name: "ProvidedMultipleOutputs",
+			event: &fxevent.Provided{
+				ConstructorName: "verifier.New",
+				ModuleName:      "verifier",
+				OutputTypeNames: []string{"verifier.A", "verifier.B"},
+				Err:             boom,
+			},
+			want: "[Fx] ERROR\tFailed to provide [verifier.A, verifier.B] from verifier.New from module \"verifier\": verifier option failure\n",
+		},
+		{
+			name: "ProvidedNoOutputs",
+			event: &fxevent.Provided{
+				ConstructorName: "verifier.Empty",
+				Err:             boom,
+			},
+			want: "[Fx] ERROR\tFailed to provide [] from verifier.Empty: verifier option failure\n",
+		},
+		{
+			name: "Replaced",
+			event: &fxevent.Replaced{
+				ModuleName:      "verifier",
+				OutputTypeNames: []string{"verifier.A", "verifier.B"},
+				Err:             boom,
+			},
+			want: "[Fx] ERROR\tFailed to replace [verifier.A, verifier.B] from module \"verifier\": verifier option failure\n",
+		},
+		{
+			name: "Decorated",
+			event: &fxevent.Decorated{
+				DecoratorName:   "verifier.Decorate",
+				ModuleName:      "verifier",
+				OutputTypeNames: []string{"verifier.A", "verifier.B"},
+				Err:             boom,
+			},
+			want: "[Fx] ERROR\tFailed to decorate [verifier.A, verifier.B] with verifier.Decorate from module \"verifier\": verifier option failure\n",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, verifierObserveConsole(tt.event))
+		})
+	}
+}
