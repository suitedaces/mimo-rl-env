@@ -0,0 +1,38 @@
+
+
+
+
+import os
+import re
+import unittest
+
+
+class TestLossMetricDocs(unittest.TestCase):
+    def test_metrics_docs_include_loss_wrapper_api_entry(self):
+        repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), os.pardir))
+        docs_path = os.path.join(repo_root, "docs", "source", "metrics.rst")
+
+        with open(docs_path, encoding="utf-8") as docs_file:
+            docs_text = docs_file.read()
+
+        title_entry = re.search(r"(?m)^`?LossMetric`?\s*$", docs_text) is not None
+        direct_api_entry = re.search(r"(?m)^\s*\.\.\s*auto(?:class|function|summary)::\s*LossMetric\b", docs_text)
+        autosummary_item = re.search(r"(?m)^\s+LossMetric\s*$", docs_text)
+
+        self.assertTrue(
+            title_entry or direct_api_entry or autosummary_item,
+            "metrics documentation should contain a structured LossMetric API entry",
+        )
+
+        if title_entry:
+            entry_start = re.search(r"(?m)^`?LossMetric`?\s*$", docs_text).start()
+            following_text = docs_text[entry_start : entry_start + 300]
+            self.assertRegex(
+                following_text,
+                r"\.\.\s*auto(?:class|function|summary)::\s*LossMetric\b|^\s+LossMetric\s*$",
+                "LossMetric docs entry should expose the API, not only mention the name in prose",
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
