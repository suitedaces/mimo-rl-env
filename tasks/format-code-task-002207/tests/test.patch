+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+dev-switch python3 3.11
+
+
+python3 -m pip install -q "numpy>=1.23.0,<1.24" "Cython>=0.28.2,<3.0" python-dateutil pytz hypothesis pytest setuptools 2>/dev/null || true
+
+
+CFLAGS="-DNUMPY_IMPORT_ARRAY_RETVAL=0" python3 -m pip install -e /testbed --no-build-isolation --no-input -q 2>/dev/null
+
+
+NEW_TESTS=(
+  "pandas/tests/io/test_compression.py::test_import_pandas_without_lzma_succeeds_and_warns"
+  "pandas/tests/io/test_compression.py::test_import_pandas_without_lzma_extension_succeeds_and_warns"
+  "pandas/tests/io/test_compression.py::test_missing_lzma_xz_write_raises_runtimeerror"
+  "pandas/tests/io/test_compression.py::test_missing_lzma_xz_write_raises_for_arbitrary_user_path"
+  "pandas/tests/io/test_compression.py::test_missing_lzma_xz_read_raises_runtimeerror_before_non_xz_paths_are_affected"
+  "pandas/tests/io/test_compression.py::test_xz_csv_roundtrip_still_works_when_lzma_available"
+)
+
+case "${1:-}" in
+  base)
+    python3 -m pytest pandas/tests/io/test_compression.py pandas/tests/io/test_pickle.py \
+      -k 'not test_import_pandas_without_lzma_succeeds_and_warns and not test_import_pandas_without_lzma_extension_succeeds_and_warns and not test_missing_lzma_xz_write_raises_runtimeerror and not test_missing_lzma_xz_write_raises_for_arbitrary_user_path and not test_missing_lzma_xz_read_raises_runtimeerror_before_non_xz_paths_are_affected and not test_xz_csv_roundtrip_still_works_when_lzma_available' \
+      -v
+    ;;
+  new)
+    python3 -m pytest "${NEW_TESTS[@]}" -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
