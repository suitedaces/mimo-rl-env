diff --git a/pandas/tests/frame/test_ufunc.py b/pandas/tests/frame/test_ufunc.py
index 0bcb62251f..208fb2c784 100644
--- a/pandas/tests/frame/test_ufunc.py
+++ b/pandas/tests/frame/test_ufunc.py
@@ -256,3 +256,76 @@ def test_alignment_deprecation_many_inputs():
         result = my_ufunc(df1.values, df2, df3)
     expected = expected.set_axis(["b", "c"], axis=1)
     tm.assert_frame_equal(result, expected)
+
+
+def test_np_add_dataframe_scalar_with_out():
+
+    foo = np.array([1, 2, 3, 4]).reshape(2, 2)
+    df = pd.DataFrame(foo)
+    bar = np.zeros_like(foo)
+    result = np.add(df, 1, out=bar)
+    expected = np.array([[2, 3], [4, 5]])
+    tm.assert_numpy_array_equal(bar, expected)
+    tm.assert_numpy_array_equal(np.asarray(result), expected)
+
+
+def test_np_add_two_dataframes_with_out():
+
+    df1 = pd.DataFrame([[1, 2], [3, 4]])
+    df2 = pd.DataFrame([[10, 20], [30, 40]])
+    bar = np.zeros((2, 2), dtype=np.int64)
+    np.add(df1, df2, out=bar)
+    expected = np.array([[11, 22], [33, 44]], dtype=np.int64)
+    tm.assert_numpy_array_equal(bar, expected)
+
+
+def test_np_unary_ufunc_dataframe_with_out():
+
+    df = pd.DataFrame([[1.0, 2.0], [3.0, 4.0]])
+    bar = np.zeros((2, 2))
+    np.exp(df, out=bar)
+    expected = np.exp(np.array([[1.0, 2.0], [3.0, 4.0]]))
+    tm.assert_numpy_array_equal(bar, expected)
+
+
+def test_np_negative_dataframe_with_out():
+
+    df = pd.DataFrame([[1, 2], [3, 4]])
+    bar = np.zeros((2, 2), dtype=np.int64)
+    np.negative(df, out=bar)
+    expected = np.array([[-1, -2], [-3, -4]], dtype=np.int64)
+    tm.assert_numpy_array_equal(bar, expected)
+
+
+def test_np_unary_ufunc_dataframe_dtype_kwarg():
+
+    df = pd.DataFrame([[1.0, 2.0], [3.0, 4.0]])
+    result = np.positive(df, dtype=np.float32)
+    assert all(d == np.float32 for d in result.dtypes)
+
+
+def test_np_add_series_with_out_preservation():
+
+    series = pd.Series([1, 2, 3, 4])
+    bar = np.zeros(4, dtype=np.int64)
+    np.add(series, 1, out=bar)
+    expected = np.array([2, 3, 4, 5], dtype=np.int64)
+    tm.assert_numpy_array_equal(bar, expected)
+
+
+def test_np_add_dataframe_no_kwargs_preservation():
+
+    df = pd.DataFrame([[1, 2], [3, 4]])
+    result = np.add(df, 1)
+    expected = pd.DataFrame([[2, 3], [4, 5]])
+    tm.assert_frame_equal(result, expected)
+
+
+def test_np_add_dataframe_values_workaround_preservation():
+
+    foo = np.array([1, 2, 3, 4]).reshape(2, 2)
+    df = pd.DataFrame(foo)
+    bar = np.zeros_like(foo)
+    np.add(df.values, 1, out=bar)
+    expected = np.array([[2, 3], [4, 5]])
+    tm.assert_numpy_array_equal(bar, expected)
