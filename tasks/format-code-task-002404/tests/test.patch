+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from pyrogram import Client, raw
+from pyrogram.session import Session
+
+
+
+
+
+
+
+
+API_ID = 12345
+API_HASH = "0123456789abcdef0123456789abcdef"
+
+
+class RecordingSession:
+    active_sessions = 0
+    max_active_sessions = 0
+
+    def __init__(self, response=None, error=None):
+        self.calls = []
+        self.response = response or SimpleNamespace(label="raw-state", users=[], chats=[])
+        self.error = error
+        self.closed = False
+        RecordingSession.active_sessions += 1
+        RecordingSession.max_active_sessions = max(
+            RecordingSession.max_active_sessions,
+            RecordingSession.active_sessions,
+        )
+
+    async def invoke(self, query, retries, timeout, sleep_threshold):
+        self.calls.append((query, retries, timeout, sleep_threshold))
+        if self.error:
+            raise self.error
+        return self.response
+
+    async def stop(self):
+        if not self.closed:
+            self.closed = True
+            RecordingSession.active_sessions -= 1
+
+
+def run(coro):
+    return asyncio.run(coro)
+
+
+async def make_started_client(name="invoke-session", **kwargs):
+    app = Client(
+        name,
+        api_id=API_ID,
+        api_hash=API_HASH,
+        in_memory=True,
+        **kwargs,
+    )
+    await app.storage.open()
+    app.is_connected = True
+    app.is_initialized = False
+    app.session = RecordingSession()
+    return app
+
+
+async def close_started_client(app):
+    if app.is_connected:
+        await app.disconnect()
+
+
+def test_invoke_before_start_raises_specific_connection_error():
+
+
+
+
+
+    async def scenario():
+        app = Client("not-started", api_id=API_ID, api_hash=API_HASH, in_memory=True)
+
+        assert not app.is_connected
+
+        with pytest.raises(ConnectionError) as raised:
+            await app.invoke(raw.functions.updates.GetState())
+
+        assert str(raised.value) == "Client has not been started yet"
+
+    run(scenario())
+
+
+def test_started_invoke_returns_raw_response_and_forwards_default_threshold():
+
+
+
+
+
+    async def scenario():
+        app = await make_started_client(sleep_threshold=33)
+        try:
+            query = raw.functions.updates.GetState()
+
+            result = await app.invoke(query, retries=3, timeout=4.5)
+            sent_query, retries, timeout, sleep_threshold = app.session.calls[0]
+
+
+            assert result is app.session.response
+            assert len(app.session.calls) == 1
+
+            assert sent_query is query
+            assert retries == 3
+            assert timeout == 4.5
+            assert sleep_threshold == 33
+        finally:
+            await close_started_client(app)
+
+    run(scenario())
+
+
+def test_invoke_without_updates_wraps_query_and_uses_explicit_sleep_threshold():
+
+
+
+
+
+    async def scenario():
+        app = await make_started_client(no_updates=True)
+        try:
+            query = raw.functions.updates.GetState()
+
+            await app.invoke(query, retries=7, timeout=8.25, sleep_threshold=1.5)
+            sent_query, retries, timeout, sleep_threshold = app.session.calls[0]
+
+
+            assert isinstance(sent_query, raw.functions.InvokeWithoutUpdates)
+            assert sent_query.query is query
+            assert retries == 7
+            assert timeout == 8.25
+            assert sleep_threshold == 1.5
+        finally:
+            await close_started_client(app)
+
+    run(scenario())
+
+
+def test_takeout_session_wraps_existing_query_with_active_takeout_id():
+
+
+
+
+
+    async def scenario():
+        app = await make_started_client(no_updates=True)
+        app.takeout_id = 9876543210123
+        try:
+            await app.invoke(raw.functions.updates.GetState())
+            sent_query, retries, timeout, sleep_threshold = app.session.calls[0]
+
+
+            assert isinstance(sent_query, raw.functions.InvokeWithTakeout)
+            assert sent_query.takeout_id == 9876543210123
+            assert isinstance(sent_query.query, raw.functions.InvokeWithoutUpdates)
+            assert isinstance(sent_query.query.query, raw.functions.updates.GetState)
+            assert retries == Session.MAX_RETRIES
+            assert timeout == Session.WAIT_TIMEOUT
+            assert sleep_threshold == app.sleep_threshold
+        finally:
+            await close_started_client(app)
+
+    run(scenario())
+
+
+def test_response_users_and_chats_are_written_to_peer_cache_before_return():
+
+
+
+
+
+    async def scenario():
+        response = SimpleNamespace(
+            label="peer-response",
+            users=[
+                raw.types.User(
+                    id=111,
+                    access_hash=222,
+                    first_name="Ada",
+                    username="AdaUser",
+                    phone="15550001111",
+                )
+            ],
+            chats=[
+                raw.types.Chat(
+                    id=333,
+                    title="Group Chat",
+                    photo=raw.types.ChatPhotoEmpty(),
+                    participants_count=4,
+                    date=5,
+                    version=6,
+                )
+            ],
+        )
+        app = await make_started_client()
+        app.session.response = response
+        try:
+            result = await app.invoke(raw.functions.updates.GetState())
+            peer_by_id = await app.storage.get_peer_by_id(111)
+            peer_by_username = await app.storage.get_peer_by_username("adauser")
+            peer_by_phone = await app.storage.get_peer_by_phone_number("15550001111")
+            chat_by_id = await app.storage.get_peer_by_id(-333)
+
+
+            assert result is response
+
+            assert isinstance(peer_by_id, raw.types.InputPeerUser)
+            assert peer_by_id.user_id == 111
+            assert peer_by_id.access_hash == 222
+            assert isinstance(peer_by_username, raw.types.InputPeerUser)
+            assert peer_by_username.user_id == 111
+            assert peer_by_username.access_hash == 222
+            assert isinstance(peer_by_phone, raw.types.InputPeerUser)
+            assert peer_by_phone.user_id == 111
+            assert peer_by_phone.access_hash == 222
+            assert isinstance(chat_by_id, raw.types.InputPeerChat)
+            assert chat_by_id.chat_id == 333
+        finally:
+            await close_started_client(app)
+
+    run(scenario())
+
+
+def test_session_invoke_exception_propagates_to_caller():
+
+
+
+
+
+    async def scenario():
+        app = await make_started_client()
+        app.session.error = RuntimeError("telegram exploded")
+        try:
+            with pytest.raises(RuntimeError) as raised:
+                await app.invoke(raw.functions.updates.GetState())
+
+
+            assert raised.value is app.session.error
+            assert len(app.session.calls) == 1
+        finally:
+            await close_started_client(app)
+
+    run(scenario())
+
+
+def test_two_clients_keep_independent_session_state():
+
+
+
+
+
+    async def scenario():
+        a = await make_started_client("invoke-a", sleep_threshold=44)
+        b = await make_started_client("invoke-b", sleep_threshold=55)
+        try:
+            await a.invoke(raw.functions.updates.GetState(), retries=2, timeout=3.0)
+
+            assert len(a.session.calls) == 1
+            assert len(b.session.calls) == 0
+            assert a.session.calls[0][1] == 2
+            assert a.session.calls[0][2] == 3.0
+            assert a.session.calls[0][3] == 44
+            assert b.sleep_threshold == 55
+        finally:
+            await close_started_client(a)
+            await close_started_client(b)
+
+    run(scenario())
+
+
+def test_repeated_invoke_uses_active_session_without_extra_calls():
+
+
+
+
+
+    async def scenario():
+        app = await make_started_client()
+        try:
+            first = raw.functions.updates.GetState()
+            second = raw.functions.updates.GetState()
+
+            first_result = await app.invoke(first)
+            second_result = await app.invoke(second)
+
+
+            assert first_result is app.session.response
+            assert second_result is app.session.response
+            assert len(app.session.calls) == 2
+            assert app.session.calls[0][0] is first
+            assert app.session.calls[1][0] is second
+        finally:
+            await close_started_client(app)
+
+    run(scenario())
+
+
+def test_construct_invoke_cycles_keep_session_state_per_client():
+
+
+
+
+
+    async def scenario():
+        for i in range(10):
+            app = await make_started_client(f"cycle-{i}")
+            try:
+                query = raw.functions.updates.GetState()
+                result = await app.invoke(query)
+
+
+                assert result is app.session.response
+                assert len(app.session.calls) == 1
+                assert app.session.calls[0][0] is query
+            finally:
+                await close_started_client(app)
+
+    run(scenario())
