+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+
+
+
+
+GOPATH_DIR="$(go env GOPATH)"
+MOD="$GOPATH_DIR/pkg/mod"
+SRC="$GOPATH_DIR/src"
+REPO="$SRC/github.com/lucas-clemente/quic-go"
+
+link_mod() {
+  local importpath="$1" glob="$2" target
+  target="$(ls -d $MOD/$glob 2>/dev/null | sort -V | head -1 || true)"
+  if [ -z "$target" ]; then
+    echo "missing dependency in module cache: $glob" >&2
+    exit 1
+  fi
+  mkdir -p "$(dirname "$SRC/$importpath")"
+  ln -sfn "$target" "$SRC/$importpath"
+}
+
+
+if [ ! -e "$REPO" ]; then
+  mkdir -p "$(dirname "$REPO")"
+  ln -sfn /testbed "$REPO"
+fi
+
+link_mod github.com/onsi/ginkgo            'github.com/onsi/ginkgo@*'
+link_mod github.com/onsi/gomega            'github.com/onsi/gomega@v1.27.10'
+link_mod github.com/golang/mock            'github.com/golang/mock@*'
+link_mod github.com/golang/protobuf        'github.com/golang/protobuf@*'
+link_mod github.com/google/go-cmp          'github.com/google/go-cmp@v0.5.9'
+link_mod google.golang.org/protobuf        'google.golang.org/protobuf@v1.28.0'
+link_mod gopkg.in/yaml.v3                  'gopkg.in/yaml.v3@*'
+link_mod go.yaml.in/yaml/v3                'go.yaml.in/yaml/v3@*'
+link_mod github.com/go-task/slim-sprig     'github.com/go-task/slim-sprig@*'
+link_mod github.com/nxadm/tail             'github.com/nxadm/tail@*'
+link_mod github.com/go-logr/logr           'github.com/go-logr/logr@*'
+link_mod github.com/fsnotify/fsnotify      'github.com/fsnotify/fsnotify@*'
+link_mod github.com/kr/pretty              'github.com/kr/pretty@*'
+link_mod github.com/kr/text                'github.com/kr/text@*'
+link_mod github.com/rogpeppe/go-internal   'github.com/rogpeppe/go-internal@*'
+link_mod github.com/chzyer/readline        'github.com/chzyer/readline@*'
+link_mod github.com/ianlancetaylor/demangle 'github.com/ianlancetaylor/demangle@*'
