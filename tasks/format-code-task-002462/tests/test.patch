+link_mod gopkg.in/check.v1                  'gopkg.in/check.v1@v1.0.0-20180628173108-788fd7840127'
+link_mod golang.org/x/sys                   'golang.org/x/sys@v0.10.0'
+link_mod golang.org/x/text                  'golang.org/x/text@v0.11.0'
+link_mod golang.org/x/net                   'golang.org/x/net@v0.12.0'
+link_mod golang.org/x/tools                 'golang.org/x/tools@v0.9.3'
+link_mod golang.org/x/crypto                'golang.org/x/crypto@v0.11.0'
+
+cd "$REPO"
+
+
+
+PKG=github.com/lucas-clemente/quic-go/internal/handshake
+
+
+GO111MODULE=off go test "$PKG" -args -ginkgo.focus='Transport Parameters|Cookie Generator'
+
+
+GO111MODULE=off go test "$PKG" -args -ginkgo.focus='original_connection_id'
