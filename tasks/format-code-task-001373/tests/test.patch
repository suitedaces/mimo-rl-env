+    def test_request_size_none_when_no_content_length(self):
+
+
+
+
+
+        from django.test import RequestFactory
+        from google.cloud.logging_v2.handlers.middleware import request
+
+        django_request = RequestFactory().get("/")
+        middleware = request.RequestMiddleware(None)
+        middleware.process_request(django_request)
+        http_request, _ = self._call_fut()
+        self.assertIn(http_request["requestSize"], (None, 0))
+
+    def test_does_not_read_request_body(self):
+
+
+
+
+        from django.test import RequestFactory
+        from google.cloud.logging_v2.handlers.middleware import request
+
+        django_request = RequestFactory().put(
+            "http://testserver/123", data="hello world"
+        )
+
+
+        django_request.read()
+        middleware = request.RequestMiddleware(None)
+        middleware.process_request(django_request)
+
+        http_request, _ = self._call_fut()
+
+        self.assertEqual(http_request["requestSize"], len("hello world"))
+
+    def test_does_not_read_request_body_multiple_calls(self):
+
+
+
+
+
+        from django.test import RequestFactory
+        from google.cloud.logging_v2.handlers.middleware import request
+
+        django_request = RequestFactory().put(
+            "http://testserver/123", data="hello world"
+        )
+        middleware = request.RequestMiddleware(None)
+        middleware.process_request(django_request)
+
+        first_http, _ = self._call_fut()
+
+
+        django_request.read()
+
+        second_http, _ = self._call_fut()
+        self.assertEqual(first_http["requestSize"], len("hello world"))
+        self.assertEqual(second_http["requestSize"], len("hello world"))
+
 
