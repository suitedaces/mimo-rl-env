diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,179 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC NO_COLOR=1
+export PATH="/usr/local/go/bin:$PATH"
+
+fail() {
+  echo "FAIL: $*" >&2
+  exit 1
+}
+
+command -v go >/dev/null 2>&1 || fail "go toolchain not found"
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+( cd /workspace/repo && go build -o "$TMP/turbolift" . ) || fail "build"
+BIN="$TMP/turbolift"
+
+mkdir -p "$TMP/bin"
+cp /workspace/repo/usercase-test-coderl/fixtures/fake-gh "$TMP/bin/gh"
+chmod +x "$TMP/bin/gh"
+export PATH="$TMP/bin:$PATH"
+
+normalize_stdout() {
+  sed $'s/\x1b\\[?25[hl]//g' "$1" | tr -d '\r'
+}
+
+normalize_combined() {
+  cat "$1" "$2" | sed $'s/\x1b\\[?25[hl]//g' | tr -d '\r'
+}
+
+assert_line() {
+  local file="$1"
+  local regex="$2"
+  local label="$3"
+  grep -Eq "$regex" "$file" || fail "$label"
+}
+
+assert_contains() {
+  local file="$1"
+  local text="$2"
+  local label="$3"
+  grep -Fq -- "$text" "$file" || fail "$label"
+}
+
+assert_not_contains() {
+  local file="$1"
+  local text="$2"
+  local label="$3"
+  if grep -Fq -- "$text" "$file"; then
+    fail "$label"
+  fi
+}
+
+assert_no_line() {
+  local file="$1"
+  local regex="$2"
+  local label="$3"
+  if grep -Eq "$regex" "$file"; then
+    fail "$label"
+  fi
+}
+
+write_readme() {
+  cat > README.md <<'EOF'
+# Campaign title
+Campaign body
+EOF
+}
+
+
+
+
+"$BIN" pr-status --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+normalize_combined out err >help-clean
+
+assert_contains help-clean "pr-status" "F1 missing pr-status command"
+assert_contains help-clean "--list" "F1 missing --list flag"
+assert_contains help-clean "--repos" "F1 missing --repos flag"
+
+
+
+
+mkdir -p "$TMP/campaign-one/work/org/repo1" "$TMP/campaign-one/work/org/repo2" "$TMP/campaign-one/work/org/repo3"
+cat > "$TMP/campaign-one/repos.txt" <<'EOF'
+org/repo1
+org/repo2
+org/repo3
+EOF
+( cd "$TMP/campaign-one" && write_readme )
+( cd "$TMP/campaign-one" && "$BIN" pr-status >out 2>err ); ec=$?
+normalize_stdout "$TMP/campaign-one/out" > "$TMP/campaign-one/clean"
+normalize_combined "$TMP/campaign-one/out" "$TMP/campaign-one/err" > "$TMP/campaign-one/clean-all"
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+
+assert_contains "$TMP/campaign-one/clean-all" "Checking PR status for org/repo1" "F2 missing repo1 progress"
+assert_contains "$TMP/campaign-one/clean-all" "Checking PR status for org/repo2" "F2 missing repo2 progress"
+assert_contains "$TMP/campaign-one/clean-all" "Checking PR status for org/repo3" "F2 missing repo3 progress"
+assert_contains "$TMP/campaign-one/clean-all" "turbolift pr-status completed" "F2 missing completion line"
+assert_line "$TMP/campaign-one/clean" '^State[[:space:]]+Count[[:space:]]*$' "F2 missing summary header"
+assert_line "$TMP/campaign-one/clean" '^Merged[[:space:]]+1[[:space:]]*$' "F2 merged count"
+assert_line "$TMP/campaign-one/clean" '^Open[[:space:]]+1[[:space:]]*$' "F2 open count"
+assert_line "$TMP/campaign-one/clean" '^Closed[[:space:]]+1[[:space:]]*$' "F2 closed count"
+assert_line "$TMP/campaign-one/clean" '^Skipped[[:space:]]+0[[:space:]]*$' "F2 skipped count"
+assert_line "$TMP/campaign-one/clean" '^No PR Found[[:space:]]+0[[:space:]]*$' "F2 no-pr count"
+assert_contains "$TMP/campaign-one/clean" "Reactions: 👍 4   👎 3   🚀 1" "F2 reaction totals/order"
+assert_not_contains "$TMP/campaign-one/clean" "Repository  State" "F2 should not print detail header"
+assert_not_contains "$TMP/campaign-one/clean" "org/repo1   OPEN" "F2 should not print repo1 detail row"
+
+
+
+
+mkdir -p "$TMP/campaign-list/work/org/repo1" "$TMP/campaign-list/work/org/repo2" "$TMP/campaign-list/work/org/repo3" "$TMP/campaign-list/work/org/repo4" "$TMP/campaign-list/work/org/repoNoPr"
+cat > "$TMP/campaign-list/repos.txt" <<'EOF'
+org/repo1
+org/repo2
+org/repo3
+org/repo4
+org/repoNoPr
+org/repoMissing
+EOF
+( cd "$TMP/campaign-list" && write_readme )
+( cd "$TMP/campaign-list" && "$BIN" pr-status --list >out 2>err ); ec=$?
+normalize_stdout "$TMP/campaign-list/out" > "$TMP/campaign-list/clean"
+normalize_combined "$TMP/campaign-list/out" "$TMP/campaign-list/err" > "$TMP/campaign-list/clean-all"
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+
+assert_contains "$TMP/campaign-list/clean-all" "No PR found" "F3 missing no-PR log"
+assert_line "$TMP/campaign-list/clean-all" 'work/org/repoMissing.*does not exist' "F3 missing skipped warning"
+assert_line "$TMP/campaign-list/clean" '^Repository[[:space:]]+State[[:space:]]+Reviews[[:space:]]+Checks status[[:space:]]+URL[[:space:]]*$' "F3 missing detail header"
+assert_line "$TMP/campaign-list/clean" '^org/repo1[[:space:]]+OPEN[[:space:]]+REVIEW_REQUIRED[[:space:]]+FAILURE[[:space:]]+https://example\.test/org/repo1/pull/201[[:space:]]*$' "F3 open failure detail row"
+assert_line "$TMP/campaign-list/clean" '^org/repo2[[:space:]]+MERGED[[:space:]]+APPROVED[[:space:]]+SUCCESS[[:space:]]+https://example\.test/org/repo2/pull/202[[:space:]]*$' "F3 merged success detail row"
+assert_line "$TMP/campaign-list/clean" '^org/repo3[[:space:]]+CLOSED[[:space:]]+FAILURE[[:space:]]+https://example\.test/org/repo3/pull/203[[:space:]]*$' "F3 closed failure detail row"
+assert_line "$TMP/campaign-list/clean" '^org/repo4[[:space:]]+OPEN[[:space:]]+REVIEW_REQUIRED[[:space:]]+PENDING[[:space:]]+https://example\.test/org/repo4/pull/204[[:space:]]*$' "F3 pending detail row"
+assert_no_line "$TMP/campaign-list/clean" '^org/repoMissing[[:space:]]+' "F3 skipped repo should not have detail row"
+assert_no_line "$TMP/campaign-list/clean" '^org/repoNoPr[[:space:]]+' "F3 no-PR repo should not have detail row"
+assert_line "$TMP/campaign-list/clean" '^Merged[[:space:]]+1[[:space:]]*$' "F3 merged count"
+assert_line "$TMP/campaign-list/clean" '^Open[[:space:]]+2[[:space:]]*$' "F3 open count"
+assert_line "$TMP/campaign-list/clean" '^Closed[[:space:]]+1[[:space:]]*$' "F3 closed count"
+assert_line "$TMP/campaign-list/clean" '^Skipped[[:space:]]+1[[:space:]]*$' "F3 skipped count"
+assert_line "$TMP/campaign-list/clean" '^No PR Found[[:space:]]+1[[:space:]]*$' "F3 no-pr count"
+assert_contains "$TMP/campaign-list/clean" "Reactions: 👍 4   👎 3   😆 5   🎉 6   😕 7   ❤️ 8   🚀 1   👀 10" "F3 all reaction totals/order"
+
+
+
+
+mkdir -p "$TMP/campaign-custom/work/org/alt"
+cat > "$TMP/campaign-custom/repos.txt" <<'EOF'
+org/default-only
+EOF
+cat > "$TMP/campaign-custom/selected-repos.txt" <<'EOF'
+org/alt
+EOF
+( cd "$TMP/campaign-custom" && write_readme )
+( cd "$TMP/campaign-custom" && "$BIN" pr-status --repos selected-repos.txt >out 2>err ); ec=$?
+normalize_stdout "$TMP/campaign-custom/out" > "$TMP/campaign-custom/clean"
+normalize_combined "$TMP/campaign-custom/out" "$TMP/campaign-custom/err" > "$TMP/campaign-custom/clean-all"
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+
+assert_contains "$TMP/campaign-custom/clean-all" "turbolift pr-status completed" "F4 missing completion line"
+assert_contains "$TMP/campaign-custom/clean-all" "Checking PR status for org/alt" "F4 did not check selected repo"
+assert_not_contains "$TMP/campaign-custom/clean-all" "org/default-only" "F4 should ignore default repos.txt when --repos is supplied"
+assert_line "$TMP/campaign-custom/clean" '^Merged[[:space:]]+0[[:space:]]*$' "F4 merged count"
+assert_line "$TMP/campaign-custom/clean" '^Open[[:space:]]+1[[:space:]]*$' "F4 open count"
+assert_line "$TMP/campaign-custom/clean" '^Closed[[:space:]]+0[[:space:]]*$' "F4 closed count"
+assert_line "$TMP/campaign-custom/clean" '^Skipped[[:space:]]+0[[:space:]]*$' "F4 skipped count"
+assert_line "$TMP/campaign-custom/clean" '^No PR Found[[:space:]]+0[[:space:]]*$' "F4 no-pr count"
+
+
+
+
+"$BIN" pr-status --repos >out 2>err; ec=$?
+
+[ "$ec" -ne 0 ] || fail "F5 exit $ec; want nonzero when --repos has no file argument"
+
+echo "PASS"
+exit 0
