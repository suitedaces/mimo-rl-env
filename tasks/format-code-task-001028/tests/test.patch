+#!/bin/bash
+set -euo pipefail
+
+
+BUILD_DIR="$(mktemp -d)"
+trap 'rm -rf "${BUILD_DIR}"' EXIT
+find common/src/main/java/org/apache/rocketmq/common/message -name '*.java' -print > "${BUILD_DIR}/main-sources"
+javac -source 8 -target 8 -cp common/target/classes -d "${BUILD_DIR}/classes" @"${BUILD_DIR}/main-sources"
+JUNIT_JAR=/root/.m2/repository/junit/junit/4.13.2/junit-4.13.2.jar
+HAMCREST_JAR=/root/.m2/repository/org/hamcrest/hamcrest-core/1.3/hamcrest-core-1.3.jar
+TEST_CP="${BUILD_DIR}/classes:common/target/classes:${JUNIT_JAR}:${HAMCREST_JAR}"
+javac -source 8 -target 8 -cp "${TEST_CP}" -d "${BUILD_DIR}/test-classes" \
+  common/src/test/java/org/apache/rocketmq/common/message/MessageDecoderValidationContractTest.java
+java -cp "${BUILD_DIR}/test-classes:${TEST_CP}" org.junit.runner.JUnitCore \
+  org.apache.rocketmq.common.message.MessageDecoderValidationContractTest
