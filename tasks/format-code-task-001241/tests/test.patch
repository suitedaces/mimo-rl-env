+import datetime
+
+import pytest
+
+from pyalgotrade import bar
+from pyalgotrade import dataseries
+from pyalgotrade.dataseries import bards
+from pyalgotrade.dataseries import resampled
+
+
+def _dt(minute, second=1):
+    return datetime.datetime(2011, 1, 1, 1, minute, second)
+
+
+def _bar(date_time, open_, high, low, close, volume, adj_close):
+    return bar.BasicBar(
+        date_time, open_, high, low, close, volume, adj_close, bar.Frequency.SECOND
+    )
+
+
+def _sample_bar_values():
+    return [
+        (_dt(1, 1), 2.1, 3, 1, 2, 10, 1),
+        (_dt(1, 2), 2, 3, 1, 2.3, 10, 2),
+        (_dt(2, 1), 2, 3, 1, 2, 10, 2),
+    ]
+
+
+def _append_sample_bars(source):
+    for values in _sample_bar_values():
+        source.append(_bar(*values))
+
+
+def test_resampled_bar_series_groups_ohlcv_on_bucket_crossing_and_push_last():
+
+
+
+
+    source = bards.BarDataSeries()
+    grouped = resampled.ResampledBarDataSeries(source, bar.Frequency.MINUTE)
+
+    assert len(grouped) == 0
+    assert grouped.getDateTimes() == []
+
+    source.append(_bar(_dt(1, 1), 2.1, 3, 1, 2, 10, 1))
+    assert len(grouped) == 0
+    assert grouped.getDateTimes() == []
+
+    source.append(_bar(_dt(1, 2), 2, 3, 1, 2.3, 10, 2))
+    assert len(grouped) == 0
+    assert grouped.getDateTimes() == []
+
+    source.append(_bar(_dt(2, 1), 2, 3, 1, 2, 10, 2))
+    assert len(grouped) == 1
+    assert grouped.getDateTimes() == [datetime.datetime(2011, 1, 1, 1, 1)]
+
+    first = grouped[0]
+    assert first.getDateTime() == datetime.datetime(2011, 1, 1, 1, 1)
+    assert first.getOpen() == 2.1
+    assert first.getHigh() == 3
+    assert first.getLow() == 1
+    assert first.getClose() == 2.3
+    assert first.getVolume() == 20
+    assert first.getAdjClose() == 2
+    assert first.getFrequency() == 60
+
+    assert first.getAdjClose() == 2
+
+
+    grouped.pushLast()
+    assert len(grouped) == 2
+    assert grouped.getDateTimes() == [
+        datetime.datetime(2011, 1, 1, 1, 1),
+        datetime.datetime(2011, 1, 1, 1, 2),
+    ]
+
+    second = grouped[1]
+    assert second.getDateTime() == datetime.datetime(2011, 1, 1, 1, 2)
+    assert second.getOpen() == 2
+    assert second.getHigh() == 3
+    assert second.getLow() == 1
+    assert second.getClose() == 2
+    assert second.getVolume() == 10
+    assert second.getAdjClose() == 2
+    assert second.getFrequency() == 60
+
+    assert second.getAdjClose() == 2
+
+
+def test_resampled_data_series_uses_aggfun_return_value_per_bucket():
+
+
+
+
+    source = bards.BarDataSeries()
+    grouped = resampled.ResampledDataSeries(
+        source.getCloseDataSeries(), bar.Frequency.MINUTE, sum
+    )
+
+    assert len(grouped) == 0
+    assert grouped.getDateTimes() == []
+
+    _append_sample_bars(source)
+    assert len(grouped) == 1
+    assert grouped.getDateTimes() == [datetime.datetime(2011, 1, 1, 1, 1)]
+    assert grouped[0] == 4.3
+
+
+    grouped.pushLast()
+    assert len(grouped) == 2
+    assert grouped.getDateTimes() == [
+        datetime.datetime(2011, 1, 1, 1, 1),
+        datetime.datetime(2011, 1, 1, 1, 2),
+    ]
+    assert grouped[0] == 4.3
+    assert grouped[1] == 2
+
+
+def test_check_now_flushes_only_after_datetime_leaves_open_bucket():
+
+
+
+
+    source = bards.BarDataSeries()
+    grouped = resampled.ResampledBarDataSeries(source, bar.Frequency.MINUTE)
+
+    source.append(_bar(_dt(1, 1), 2.1, 3, 1, 2, 10, 1))
+    assert len(grouped) == 0
+    assert grouped.getDateTimes() == []
+
+
+    grouped.checkNow(datetime.datetime(2011, 1, 1, 1, 1, 59))
+    assert len(grouped) == 0
+    assert grouped.getDateTimes() == []
+
+
+    grouped.checkNow(datetime.datetime(2011, 1, 1, 1, 2, 0))
+    assert len(grouped) == 1
+    assert grouped.getDateTimes() == [datetime.datetime(2011, 1, 1, 1, 1)]
+    flushed = grouped[0]
+    assert flushed.getDateTime() == datetime.datetime(2011, 1, 1, 1, 1)
+    assert flushed.getOpen() == 2.1
+    assert flushed.getHigh() == 3
+    assert flushed.getLow() == 1
+    assert flushed.getClose() == 2
+    assert flushed.getVolume() == 10
+    assert flushed.getAdjClose() == 1
+    assert flushed.getFrequency() == 60
+
+
+    grouped.checkNow(datetime.datetime(2011, 1, 1, 1, 3, 0))
+    assert len(grouped) == 1
+    assert grouped.getDateTimes() == [datetime.datetime(2011, 1, 1, 1, 1)]
+
+
+def test_resampled_data_series_accepts_max_len_and_still_resamples():
+
+
+
+
+    source = bards.BarDataSeries()
+    grouped = resampled.ResampledDataSeries(
+        source.getCloseDataSeries(), bar.Frequency.MINUTE, sum, maxLen=1
+    )
+
+    source.append(_bar(_dt(1, 1), 2, 5, 1, 2, 10, 2))
+    assert len(grouped) == 0
+    assert grouped.getDateTimes() == []
+
+    source.append(_bar(_dt(2, 1), 2, 5, 1, 3, 10, 3))
+    assert len(grouped) == 1
+    assert grouped.getDateTimes() == [datetime.datetime(2011, 1, 1, 1, 1)]
+    assert grouped[0] == 2
+
+    source.append(_bar(_dt(3, 1), 2, 5, 1, 4, 10, 4))
+
+    assert grouped.getDateTimes()[-1] == datetime.datetime(2011, 1, 1, 1, 2)
+    assert grouped[-1] == 3
+
+
+    grouped.pushLast()
+    assert grouped.getDateTimes()[-1] == datetime.datetime(2011, 1, 1, 1, 3)
+    assert grouped[-1] == 4
+
+
+def test_resampled_bar_series_rejects_non_bar_data_series():
+
+
+
+
+    with pytest.raises(Exception) as exc_info:
+        resampled.ResampledBarDataSeries(
+            dataseries.SequenceDataSeries(), bar.Frequency.MINUTE
+        )
+
+    assert type(exc_info.value) is Exception
+    assert str(exc_info.value) == (
+        "dataSeries must be a dataseries.bards.BarDataSeries instance"
+    )
+
+
+@pytest.mark.parametrize(
+    "constructor,args",
+    [
+        (
+            resampled.ResampledBarDataSeries,
+            (bards.BarDataSeries(), bar.Frequency.WEEK),
+        ),
+        (
+            resampled.ResampledDataSeries,
+            (dataseries.SequenceDataSeries(), bar.Frequency.WEEK, sum),
+        ),
+    ],
+)
+def test_unsupported_resampling_frequencies_raise_exact_exception(constructor, args):
+
+
+
+
+    with pytest.raises(Exception) as exc_info:
+        constructor(*args)
+
+    assert type(exc_info.value) is Exception
+    assert str(exc_info.value) == "Unsupported frequency"
+
+
+def test_push_last_is_idempotent_after_current_bucket_is_flushed():
+
+
+
+
+    source = bards.BarDataSeries()
+    grouped = resampled.ResampledDataSeries(
+        source.getCloseDataSeries(), bar.Frequency.MINUTE, sum
+    )
+
+    source.append(_bar(_dt(1, 1), 2, 3, 1, 2, 10, 1))
+    assert len(grouped) == 0
+    assert grouped.getDateTimes() == []
+
+
+    grouped.pushLast()
+    assert len(grouped) == 1
+    assert grouped.getDateTimes() == [datetime.datetime(2011, 1, 1, 1, 1)]
+    assert grouped[0] == 2
+
+
+    grouped.pushLast()
+    assert len(grouped) == 1
+    assert grouped.getDateTimes() == [datetime.datetime(2011, 1, 1, 1, 1)]
+    assert grouped[0] == 2
+
+
+def test_two_resamplers_keep_independent_event_state():
+
+
+
+
+    source_a = bards.BarDataSeries()
+    source_b = bards.BarDataSeries()
+    grouped_a = resampled.ResampledDataSeries(
+        source_a.getCloseDataSeries(), bar.Frequency.MINUTE, sum
+    )
+    grouped_b = resampled.ResampledDataSeries(
+        source_b.getCloseDataSeries(), bar.Frequency.MINUTE, sum
+    )
+
+    assert len(grouped_a) == 0
+    assert grouped_a.getDateTimes() == []
+    assert len(grouped_b) == 0
+    assert grouped_b.getDateTimes() == []
+
+    source_a.append(_bar(_dt(1, 1), 2, 5, 1, 1, 10, 1))
+    source_a.append(_bar(_dt(2, 1), 2, 5, 1, 3, 10, 3))
+    assert len(grouped_a) == 1
+    assert grouped_a.getDateTimes() == [datetime.datetime(2011, 1, 1, 1, 1)]
+    assert grouped_a[0] == 1
+    assert len(grouped_b) == 0
+    assert grouped_b.getDateTimes() == []
+
+    source_b.append(_bar(_dt(3, 1), 2, 5, 1, 4, 10, 4))
+    source_b.append(_bar(_dt(4, 1), 2, 5, 1, 5, 10, 5))
+    assert len(grouped_a) == 1
+    assert grouped_a.getDateTimes() == [datetime.datetime(2011, 1, 1, 1, 1)]
+    assert grouped_a[0] == 1
+    assert len(grouped_b) == 1
+    assert grouped_b.getDateTimes() == [datetime.datetime(2011, 1, 1, 1, 3)]
+    assert grouped_b[0] == 4
+
+
+    grouped_a.pushLast()
+    grouped_b.pushLast()
+    assert len(grouped_a) == 2
+    assert grouped_a.getDateTimes() == [
+        datetime.datetime(2011, 1, 1, 1, 1),
+        datetime.datetime(2011, 1, 1, 1, 2),
+    ]
+    assert grouped_a[0] == 1
+    assert grouped_a[1] == 3
+    assert len(grouped_b) == 2
+    assert grouped_b.getDateTimes() == [
+        datetime.datetime(2011, 1, 1, 1, 3),
+        datetime.datetime(2011, 1, 1, 1, 4),
+    ]
+    assert grouped_b[0] == 4
+    assert grouped_b[1] == 5
+
+
+def test_repeated_resampler_cycles_keep_state_independent():
+
+
+
+
+
+    def run_cycle():
+        source = bards.BarDataSeries()
+        grouped = resampled.ResampledDataSeries(
+            source.getCloseDataSeries(), bar.Frequency.MINUTE, sum
+        )
+        _append_sample_bars(source)
+        assert len(grouped) == 1
+        assert grouped.getDateTimes() == [datetime.datetime(2011, 1, 1, 1, 1)]
+        assert grouped[0] == 4.3
+
+        grouped.pushLast()
+        grouped.pushLast()
+        assert len(grouped) == 2
+        assert grouped.getDateTimes() == [
+            datetime.datetime(2011, 1, 1, 1, 1),
+            datetime.datetime(2011, 1, 1, 1, 2),
+        ]
+        assert grouped[0] == 4.3
+        assert grouped[1] == 2
+
+    for _ in range(10):
+        run_cycle()
