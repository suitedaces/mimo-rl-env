+func TestDeployUndeployCyclesLeaveRunningListBounded(t *testing.T) {
+
+
+
+
+	container := &fakeContainerService{
+		resultByFunction: map[string]ivm.Result{"touch": {Data: map[string]string{"ok": "true"}}},
+		errByFunction:    map[string]error{},
+	}
+	git := &fakeGitService{pathICode: icodeAlpha}
+	events := &fakeEventService{}
+	facade := api.NewICodeApi(container, git, events)
+
+	for cycle := 0; cycle < 100; cycle++ {
+		deployed, err := facade.Deploy("/base", "github.com/acme/alpha", "", "")
+		requireNoError(t, "cycle Deploy error", err)
+		requireEqual(t, "cycle deployed ICode", deployed, icodeAlpha)
+		result, err := facade.ExecuteRequest(ivm.Request{ICodeID: "icode-alpha", Function: "touch", Type: "invoke"})
+		requireNoError(t, "cycle ExecuteRequest error", err)
+		requireEqual(t, "cycle ExecuteRequest result", result, ivm.Result{Data: map[string]string{"ok": "true"}})
+		err = facade.UnDeploy("icode-alpha")
+		requireNoError(t, "cycle UnDeploy error", err)
+		requireEqual(t, "cycle running count after cleanup", len(facade.GetRunningICodeList()), 0)
+	}
+
+	requireEqual(t, "leak floor start calls", container.startCalls, 100)
+	requireEqual(t, "leak floor stop calls", container.stopCalls, 100)
+	requireEqual(t, "leak floor execute calls", container.executeCalls, 100)
+	requireEqual(t, "leak floor running count", len(facade.GetRunningICodeList()), 0)
+	requireEqual(t, "leak floor event count", len(events.records), 200)
+}
