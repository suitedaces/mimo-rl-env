+package usercase_test_coderl
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+
+	"github.com/it-chain/engine/ivm"
+	"github.com/it-chain/engine/ivm/api"
+)
+
+
+
+
+
+
+
+
+var (
+	errClone      = errors.New("clone failed")
+	errRawClone   = errors.New("raw clone failed")
+	errStart      = errors.New("start failed")
+	errStop       = errors.New("stop failed")
+	errNotRunning = errors.New("not running")
+	errPublish    = errors.New("publish failed")
+	errRequestTwo = errors.New("request two failed")
+)
+
+var (
+	icodeAlpha = ivm.ICode{
+		ID:             "icode-alpha",
+		RepositoryName: "alpha",
+		GitUrl:         "github.com/acme/alpha",
+		Path:           "/tmp/alpha",
+		CommitHash:     "abc123",
+		Version:        "abc123",
+		Language:       "go",
+		FolderName:     "alpha",
+	}
+	icodeRaw = ivm.ICode{
+		ID:             "icode-raw",
+		RepositoryName: "rawrepo",
+		GitUrl:         "github.com/acme/rawrepo",
+		Path:           "/tmp/rawrepo",
+		CommitHash:     "def456",
+		Version:        "def456",
+		Language:       "go",
+		FolderName:     "rawrepo",
+	}
+	zeroICode = ivm.ICode{}
+)
+
+type publishRecord struct {
+	topic string
+	event interface{}
+}
+
+type fakeEventService struct {
+	records    []publishRecord
+	publishErr error
+	closeCalls int
+}
+
+func (f *fakeEventService) Publish(topic string, payload interface{}) error {
+	f.records = append(f.records, publishRecord{topic: topic, event: payload})
+	return f.publishErr
+}
+
+func (f *fakeEventService) Close() {
+	f.closeCalls++
+}
+
+type fakeGitService struct {
+	pathICode ivm.ICode
+	rawICode  ivm.ICode
+
+	cloneErr error
+	rawErr   error
+
+	cloneCalls int
+	rawCalls   int
+
+	lastBase     string
+	lastURL      string
+	lastSSHPath  string
+	lastPassword string
+	lastRaw      []byte
+}
+
+func (f *fakeGitService) Clone(baseSavePath string, repositoryUrl string, sshPath string, password string) (ivm.ICode, error) {
+	f.cloneCalls++
+	f.lastBase = baseSavePath
+	f.lastURL = repositoryUrl
+	f.lastSSHPath = sshPath
+	f.lastPassword = password
+	return f.pathICode, f.cloneErr
+}
+
+func (f *fakeGitService) CloneFromRawSsh(baseSavePath string, repositoryUrl string, rawSsh []byte, password string) (ivm.ICode, error) {
+	f.rawCalls++
+	f.lastBase = baseSavePath
+	f.lastURL = repositoryUrl
+	f.lastRaw = append([]byte(nil), rawSsh...)
+	f.lastPassword = password
+	return f.rawICode, f.rawErr
+}
+
+type fakeContainerService struct {
+	running []ivm.ICode
+
+	startErr error
+	stopErr  error
+
+	resultByFunction map[string]ivm.Result
+	errByFunction    map[string]error
+
+	startCalls   int
+	stopCalls    int
+	executeCalls int
+
+	started  []ivm.ICode
+	stopped  []ivm.ID
+	requests []ivm.Request
+}
+
+func (f *fakeContainerService) StartContainer(icode ivm.ICode) error {
+	f.startCalls++
+	f.started = append(f.started, icode)
+	if f.startErr != nil {
+		return f.startErr
+	}
+	f.running = append(f.running, icode)
+	return nil
+}
+
+func (f *fakeContainerService) StopContainer(id ivm.ID) error {
+	f.stopCalls++
+	f.stopped = append(f.stopped, id)
+	if f.stopErr != nil {
+		return f.stopErr
+	}
+	for index, icode := range f.running {
+		if icode.ID == id {
+			f.running = append(f.running[:index], f.running[index+1:]...)
+			return nil
+		}
+	}
+	return errNotRunning
+}
+
+func (f *fakeContainerService) ExecuteRequest(request ivm.Request) (ivm.Result, error) {
+	f.executeCalls++
+	f.requests = append(f.requests, request)
+	if err := f.errByFunction[request.Function]; err != nil {
+		return ivm.Result{}, err
+	}
+	if result, ok := f.resultByFunction[request.Function]; ok {
+		return result, nil
+	}
+	return ivm.Result{Data: map[string]string{"default": "ok"}}, nil
+}
+
+func (f *fakeContainerService) GetRunningICodeList() []ivm.ICode {
+	copied := make([]ivm.ICode, len(f.running))
+	copy(copied, f.running)
+	return copied
+}
+
+func newHarness() (*fakeContainerService, *fakeGitService, *fakeEventService, api.ICodeApi) {
+	container := &fakeContainerService{
+		resultByFunction: map[string]ivm.Result{
+			"init": {Data: map[string]string{"state": "initialized"}},
+			"get":  {Data: map[string]string{"value": "42"}},
+		},
+		errByFunction: map[string]error{},
+	}
+	git := &fakeGitService{pathICode: icodeAlpha, rawICode: icodeRaw}
+	events := &fakeEventService{}
+	return container, git, events, api.NewICodeApi(container, git, events)
+}
+
+func requireEqual(t *testing.T, name string, got interface{}, want interface{}) {
+	t.Helper()
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("%s = %#v, want %#v", name, got, want)
+	}
+}
+
+func requireNoError(t *testing.T, name string, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatalf("%s = %v, want nil", name, err)
+	}
+}
+
+func requireErrorIs(t *testing.T, name string, err error, target error) {
+	t.Helper()
+	if !errors.Is(err, target) {
+		t.Fatalf("%s = %v, want errors.Is(..., %v)", name, err, target)
+	}
+}
+
+func requireCreatedEventPayload(t *testing.T, name string, payload interface{}, want ivm.ICode) {
+	t.Helper()
+	fields := requireEventFields(t, name, payload)
+	requireAnyFieldValue(t, name, fields, []string{"ID", "ICodeID"}, string(want.ID))
+	requireAnyFieldValue(t, name, fields, []string{"RepositoryName"}, want.RepositoryName)
+	requireAnyFieldValue(t, name, fields, []string{"GitUrl", "GitURL"}, want.GitUrl)
+	requireAnyFieldValue(t, name, fields, []string{"Path"}, want.Path)
+	requireAnyFieldValue(t, name, fields, []string{"CommitHash"}, want.CommitHash)
+	requireAnyFieldValue(t, name, fields, []string{"Version"}, string(want.Version))
+}
+
+func requireDeletedEventPayload(t *testing.T, name string, payload interface{}, wantID ivm.ID) {
+	t.Helper()
+	fields := requireEventFields(t, name, payload)
+	requireAnyFieldValue(t, name, fields, []string{"ICodeID", "ID"}, string(wantID))
+}
+
+func requireEventFields(t *testing.T, name string, payload interface{}) map[string]string {
+	t.Helper()
+	value := reflect.ValueOf(payload)
+	if !value.IsValid() || value.Kind() != reflect.Struct {
+		t.Fatalf("%s = %#v, want struct event payload", name, payload)
+	}
+	fields := make(map[string]string)
+	payloadType := value.Type()
+	for index := 0; index < value.NumField(); index++ {
+		field := payloadType.Field(index)
+		if field.PkgPath != "" || value.Field(index).Kind() != reflect.String {
+			continue
+		}
+		fields[field.Name] = value.Field(index).String()
+	}
+	return fields
+}
+
+func requireAnyFieldValue(t *testing.T, name string, fields map[string]string, aliases []string, want string) {
+	t.Helper()
+	for _, alias := range aliases {
+		if got, ok := fields[alias]; ok {
+			if got != want {
+				t.Fatalf("%s.%s = %q, want %q", name, alias, got, want)
+			}
+			return
+		}
+	}
+	t.Fatalf("%s missing any field in %v", name, aliases)
+}
