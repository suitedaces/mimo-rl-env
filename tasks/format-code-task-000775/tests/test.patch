+
+
+	containerA, gitA, eventsA, facadeA := newHarness()
+	containerB, gitB, eventsB, facadeB := newHarness()
+	gitA.pathICode = ivm.ICode{ID: "icode-a", RepositoryName: "repo-a", GitUrl: "github.com/acme/repo-a", Path: "/tmp/repo-a", CommitHash: "aaa111", Version: "aaa111", FolderName: "repo-a"}
+	gitB.pathICode = ivm.ICode{ID: "icode-b", RepositoryName: "repo-b", GitUrl: "github.com/acme/repo-b", Path: "/tmp/repo-b", CommitHash: "bbb222", Version: "bbb222", FolderName: "repo-b"}
+
+	deployedA, err := facadeA.Deploy("/base-a", "github.com/acme/repo-a", "", "")
+	requireNoError(t, "Deploy A error", err)
