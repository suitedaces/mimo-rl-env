+func TestExecuteRequestListKeepsOrderAndConvertsIndividualErrors(t *testing.T) {
+
+
+
+
+	container, _, _, facade := newHarness()
+	container.resultByFunction = map[string]ivm.Result{
+		"one":   {Data: map[string]string{"fn": "one"}},
+		"three": {Data: map[string]string{"fn": "three"}},
+	}
+	container.errByFunction = map[string]error{"bad": errRequestTwo}
+
+	results := facade.ExecuteRequestList([]ivm.Request{
+		{ICodeID: "icode-alpha", Function: "one", Type: "invoke"},
+		{ICodeID: "icode-alpha", Function: "bad", Type: "invoke"},
+		{ICodeID: "icode-alpha", Function: "three", Type: "query", Args: []string{"k"}},
+	})
+
+	requireEqual(t, "ExecuteRequestList results", results, []ivm.Result{
+		{Data: map[string]string{"fn": "one"}},
+		{Err: "request two failed"},
+		{Data: map[string]string{"fn": "three"}},
+	})
+	requireEqual(t, "ExecuteRequestList call count", container.executeCalls, 3)
+	requireEqual(t, "ExecuteRequestList forwarded requests", container.requests, []ivm.Request{
+		{ICodeID: "icode-alpha", Function: "one", Type: "invoke"},
+		{ICodeID: "icode-alpha", Function: "bad", Type: "invoke"},
+		{ICodeID: "icode-alpha", Function: "three", Type: "query", Args: []string{"k"}},
+	})
+}
