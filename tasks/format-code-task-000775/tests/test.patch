+	requireEqual(t, "A running after A deploy", facadeA.GetRunningICodeList(), []ivm.ICode{{ID: "icode-a", RepositoryName: "repo-a", GitUrl: "github.com/acme/repo-a", Path: "/tmp/repo-a", CommitHash: "aaa111", Version: "aaa111", FolderName: "repo-a"}})
+	requireEqual(t, "B running before B deploy", facadeB.GetRunningICodeList(), []ivm.ICode{})
+	requireEqual(t, "A event count after A deploy", len(eventsA.records), 1)
+	requireEqual(t, "B event count before B deploy", len(eventsB.records), 0)
+	requireEqual(t, "A container starts", containerA.startCalls, 1)
+	requireEqual(t, "B container starts before B deploy", containerB.startCalls, 0)
+
+	deployedB, err := facadeB.Deploy("/base-b", "github.com/acme/repo-b", "", "")
+	requireNoError(t, "Deploy B error", err)
+	requireEqual(t, "B deployed ICode", deployedB, ivm.ICode{ID: "icode-b", RepositoryName: "repo-b", GitUrl: "github.com/acme/repo-b", Path: "/tmp/repo-b", CommitHash: "bbb222", Version: "bbb222", FolderName: "repo-b"})
+	requireEqual(t, "A running after B deploy", facadeA.GetRunningICodeList(), []ivm.ICode{{ID: "icode-a", RepositoryName: "repo-a", GitUrl: "github.com/acme/repo-a", Path: "/tmp/repo-a", CommitHash: "aaa111", Version: "aaa111", FolderName: "repo-a"}})
+	requireEqual(t, "B running after B deploy", facadeB.GetRunningICodeList(), []ivm.ICode{{ID: "icode-b", RepositoryName: "repo-b", GitUrl: "github.com/acme/repo-b", Path: "/tmp/repo-b", CommitHash: "bbb222", Version: "bbb222", FolderName: "repo-b"}})
+	requireEqual(t, "A event count after B deploy", len(eventsA.records), 1)
+	requireEqual(t, "B event count after B deploy", len(eventsB.records), 1)
+}
