+func TestICodeApiSessionDeployExecuteListAndUndeploy(t *testing.T) {
+
+
+
+
+	container, git, events, facade := newHarness()
+
+	requireEqual(t, "fresh running list", facade.GetRunningICodeList(), []ivm.ICode{})
+
+	deployed, err := facade.Deploy("/base", "github.com/acme/alpha", "/keys/id_rsa", "pw")
+	requireNoError(t, "Deploy error", err)
+	requireEqual(t, "deployed ICode", deployed, icodeAlpha)
+	requireEqual(t, "clone calls", git.cloneCalls, 1)
+	requireEqual(t, "clone base", git.lastBase, "/base")
+	requireEqual(t, "clone url", git.lastURL, "github.com/acme/alpha")
+	requireEqual(t, "clone ssh path", git.lastSSHPath, "/keys/id_rsa")
+	requireEqual(t, "clone password", git.lastPassword, "pw")
+	requireEqual(t, "start calls", container.startCalls, 1)
+	requireEqual(t, "running after deploy", facade.GetRunningICodeList(), []ivm.ICode{icodeAlpha})
+	requireEqual(t, "created event count", len(events.records), 1)
+	requireEqual(t, "created event topic", events.records[0].topic, "icode.created")
+
+	requireCreatedEventPayload(t, "created event payload", events.records[0].event, icodeAlpha)
+
+	result, err := facade.ExecuteRequest(ivm.Request{ICodeID: "icode-alpha", Function: "get", Type: "query", Args: []string{"A"}})
+	requireNoError(t, "ExecuteRequest error", err)
+	requireEqual(t, "ExecuteRequest result", result, ivm.Result{Data: map[string]string{"value": "42"}})
+	requireEqual(t, "execute call count", container.executeCalls, 1)
+	requireEqual(t, "forwarded request", container.requests[0], ivm.Request{ICodeID: "icode-alpha", Function: "get", Type: "query", Args: []string{"A"}})
+
+	err = facade.UnDeploy("icode-alpha")
+	requireNoError(t, "UnDeploy error", err)
+	requireEqual(t, "stop calls", container.stopCalls, 1)
+	requireEqual(t, "stopped id", container.stopped, []ivm.ID{"icode-alpha"})
+	requireEqual(t, "running after undeploy", facade.GetRunningICodeList(), []ivm.ICode{})
+	requireEqual(t, "event count after undeploy", len(events.records), 2)
+	requireEqual(t, "deleted event topic", events.records[1].topic, "icode.deleted")
+
+	requireDeletedEventPayload(t, "deleted event payload", events.records[1].event, "icode-alpha")
+}
