+# -*- coding:utf-8 -*-
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+import json
+import sys
+
+from gcovr.__main__ import main
+from gcovr.formats.json.versions import JSON_FORMAT_VERSION
+
+
+def _run(capsys, args):
+
+    try:
+        main(args)
+        sys.exit(0)
+    except SystemExit as exception:
+        e = exception
+    out, err = capsys.readouterr()
+    return out, err, e
+
+
+def _write_tracefile(path, files):
+    data = {
+        "gcovr/format_version": JSON_FORMAT_VERSION,
+        "files": files,
+    }
+    with open(path, "w", encoding="utf-8") as fh:
+        json.dump(data, fh)
+    return str(path)
+
+
+def _line(line_number, count, conditions=None):
+    line = {"line_number": line_number, "count": count, "branches": []}
+    if conditions is not None:
+        line["gcovr/conditions"] = conditions
+    return line
+
+
+def _find_file(report, suffix):
+    for entry in report["files"]:
+        name = entry.get("file", entry.get("filename"))
+        if name is not None and name.endswith(suffix):
+            return entry
+    raise AssertionError(f"file ending with {suffix!r} not found in {report!r}")
+
+
+def test_detailed_json_roundtrips_conditions(capsys, tmp_path):
+    condition = {
+        "count": 8,
+        "covered": 3,
+        "not_covered_true": [0, 1, 2, 3],
+        "not_covered_false": [0],
+    }
+    trace = _write_tracefile(
+        tmp_path / "trace.json",
+        [
+            {
+                "file": "src/main.cpp",
+                "lines": [
+                    _line(3, 3, conditions=[condition]),
+                    _line(4, 1),
+                ],
+                "functions": [],
+            }
+        ],
+    )
+
+    out, _, exc = _run(capsys, ["--add-tracefile", trace, "--json", "--output", "-"])
+    assert exc.code == 0
+    report = json.loads(out)
+
+    filecov = _find_file(report, "main.cpp")
+    lines = {line["line_number"]: line for line in filecov["lines"]}
+
+
+    assert lines[3]["gcovr/conditions"] == [condition]
+
+
+    assert "gcovr/conditions" not in lines[4]
+
+
+def test_detailed_json_condition_index_lists_sorted(capsys, tmp_path):
+    trace = _write_tracefile(
+        tmp_path / "trace.json",
+        [
+            {
+                "file": "src/main.cpp",
+                "lines": [
+                    _line(
+                        10,
+                        5,
+                        conditions=[
+                            {
+                                "count": 6,
+                                "covered": 3,
+                                "not_covered_true": [2, 0],
+                                "not_covered_false": [1],
+                            }
+                        ],
+                    ),
+                ],
+                "functions": [],
+            }
+        ],
+    )
+
+    out, _, exc = _run(capsys, ["--add-tracefile", trace, "--json", "--output", "-"])
+    assert exc.code == 0
+    report = json.loads(out)
+    cond = _find_file(report, "main.cpp")["lines"][0]["gcovr/conditions"][0]
+
+    assert cond["count"] == 6
+    assert cond["not_covered_true"] == [0, 2]
+    assert cond["not_covered_false"] == [1]
+
+
+def test_conditions_merged_across_tracefiles(capsys, tmp_path):
+
+    trace_a = _write_tracefile(
+        tmp_path / "a.json",
+        [
+            {
+                "file": "src/main.cpp",
+                "lines": [
+                    _line(
+                        7,
+                        1,
+                        conditions=[
+                            {
+                                "count": 4,
+                                "covered": 2,
+                                "not_covered_true": [0, 1],
+                                "not_covered_false": [],
+                            }
+                        ],
+                    )
+                ],
+                "functions": [],
+            }
+        ],
+    )
+    trace_b = _write_tracefile(
+        tmp_path / "b.json",
+        [
+            {
+                "file": "src/main.cpp",
+                "lines": [
+                    _line(
+                        7,
+                        2,
+                        conditions=[
+                            {
+                                "count": 4,
+                                "covered": 2,
+                                "not_covered_true": [1],
+                                "not_covered_false": [0],
+                            }
+                        ],
+                    )
+                ],
+                "functions": [],
+            }
+        ],
+    )
+
+    out, _, exc = _run(
+        capsys,
+        [
+            "--add-tracefile",
+            trace_a,
+            "--add-tracefile",
+            trace_b,
+            "--json",
+            "--output",
+            "-",
+        ],
+    )
+    assert exc.code == 0
+    report = json.loads(out)
+    cond = _find_file(report, "main.cpp")["lines"][0]["gcovr/conditions"][0]
+
+
+
+    assert cond["count"] == 4
+    assert cond["not_covered_true"] == [1]
+    assert cond["not_covered_false"] == []
+    assert cond["covered"] == 3
+
+
+def test_summary_json_reports_condition_stats(capsys, tmp_path):
+    trace = _write_tracefile(
+        tmp_path / "trace.json",
+        [
+            {
+                "file": "src/main.cpp",
+                "lines": [
+                    _line(
+                        3,
+                        3,
+                        conditions=[
+                            {
+                                "count": 8,
+                                "covered": 3,
+                                "not_covered_true": [0, 1, 2, 3],
+                                "not_covered_false": [0],
+                            }
+                        ],
+                    ),
+                    _line(
+                        4,
+                        1,
+                        conditions=[
+                            {
+                                "count": 2,
+                                "covered": 2,
+                                "not_covered_true": [],
+                                "not_covered_false": [],
+                            }
+                        ],
+                    ),
+                ],
+                "functions": [],
+            }
+        ],
+    )
+
+    out, _, exc = _run(
+        capsys, ["--add-tracefile", trace, "--json-summary", "--output", "-"]
+    )
+    assert exc.code == 0
+    report = json.loads(out)
+
+
+    assert report["condition_total"] == 10
+    assert report["condition_covered"] == 5
+    assert report["condition_percent"] == 50.0
+
+    filecov = _find_file(report, "main.cpp")
+    assert filecov["condition_total"] == 10
+    assert filecov["condition_covered"] == 5
+    assert filecov["condition_percent"] == 50.0
+
+
+def test_summary_json_condition_fields_present_without_conditions(capsys, tmp_path):
+    trace = _write_tracefile(
+        tmp_path / "trace.json",
+        [
+            {
+                "file": "src/main.cpp",
+                "lines": [_line(3, 3), _line(4, 0)],
+                "functions": [],
+            }
+        ],
+    )
+
+    out, _, exc = _run(
+        capsys, ["--add-tracefile", trace, "--json-summary", "--output", "-"]
+    )
+    assert exc.code == 0
+    report = json.loads(out)
+
+
+    assert report["condition_total"] == 0
+    assert report["condition_covered"] == 0
+    assert report["condition_percent"] == 0.0
+
+    filecov = _find_file(report, "main.cpp")
+    assert filecov["condition_total"] == 0
+    assert filecov["condition_covered"] == 0
+    assert filecov["condition_percent"] is None
