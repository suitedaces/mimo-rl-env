diff --git a/featuretools/tests/entityset_tests/test_pandas_es.py b/featuretools/tests/entityset_tests/test_pandas_es.py
index 50b73fd7..2a02ea76 100644
--- a/featuretools/tests/entityset_tests/test_pandas_es.py
+++ b/featuretools/tests/entityset_tests/test_pandas_es.py
@@ -632,3 +632,171 @@ class TestNormalizeEntity(object):
         assert entityset['values'].time_index == 'value_time'
         assert 'value_time' in entityset['values'].df.columns
         assert len(entityset['values'].df.columns) == 3
+
+
+def test_head_of_entity(entityset):
+
+    entity = entityset['log']
+    assert(isinstance(entityset.head('log', 3), pd.DataFrame))
+    assert(isinstance(entity.head(3), pd.DataFrame))
+    assert(isinstance(entity['product_id'].head(3), pd.DataFrame))
+
+    assert(entity.head(n=5).shape == (5, 9))
+
+    timestamp1 = pd.to_datetime("2011-04-09 10:30:10")
+    timestamp2 = pd.to_datetime("2011-04-09 10:30:18")
+    datetime1 = datetime(2011, 4, 9, 10, 30, 18)
+
+    assert(entity.head(5, cutoff_time=timestamp1).shape == (2, 9))
+    assert(entity.head(5, cutoff_time=timestamp2).shape == (3, 9))
+    assert(entity.head(5, cutoff_time=datetime1).shape == (3, 9))
+
+    time_list = [timestamp2]*3+[timestamp1]*2
+    cutoff_times = pd.DataFrame(zip(range(5), time_list))
+
+    assert(entityset.head('log', 5, cutoff_time=cutoff_times).shape == (3, 9))
+    assert(entity.head(5, cutoff_time=cutoff_times).shape == (3, 9))
+    assert(entity['product_id'].head(5, cutoff_time=cutoff_times).shape == (3, 1))
+
+
+def _time_index(entity):
+    return entity.time_index
+
+
+def _entity_index(entity):
+    return entity.index
+
+
+def _expected_for_timestamp(entity, n, cutoff_time):
+    time_index = _time_index(entity)
+    return entity.df[entity.df[time_index] < cutoff_time].head(n)
+
+
+def _cutoff_frame_for_rows(entity):
+    index = _entity_index(entity)
+    time_index = _time_index(entity)
+    rows = entity.df.iloc[[1, 3, 5]]
+    cutoff_times = rows[time_index].copy()
+    cutoff_times.iloc[0] = cutoff_times.iloc[0] + pd.Timedelta(seconds=1)
+    cutoff_times.iloc[1] = cutoff_times.iloc[1]
+    cutoff_times.iloc[2] = cutoff_times.iloc[2] + pd.Timedelta(seconds=1)
+    return pd.DataFrame({
+        'instance_id': rows[index].values,
+        'cutoff_time': cutoff_times.values,
+    }, index=rows.index, columns=['instance_id', 'cutoff_time'])
+
+
+def _assert_timestamp_cutoff(entity, result, n, cutoff_time):
+    time_index = _time_index(entity)
+    assert isinstance(result, pd.DataFrame)
+    assert len(result) <= n
+    assert not result.empty
+    assert (result[time_index] < cutoff_time).all()
+    assert (entity.df.head(n)[time_index] >= cutoff_time).any()
+
+
+def _assert_dataframe_cutoff(entity, result, n, cutoff_time):
+    index = _entity_index(entity)
+    time_index = _time_index(entity)
+    assert isinstance(result, pd.DataFrame)
+    assert len(result) <= n
+    assert set(result[index]).issubset(set(cutoff_time['instance_id']))
+    cutoffs = cutoff_time['cutoff_time']
+    for row_index, row in result.iterrows():
+        assert row[time_index] < cutoffs.loc[row_index]
+
+
+def test_entity_head_filters_timestamp_cutoff(entityset):
+    entity = entityset['log']
+    n = 5
+    cutoff_time = entity.df[_time_index(entity)].iloc[3]
+
+    result = entity.head(n=n, cutoff_time=cutoff_time)
+    _assert_timestamp_cutoff(entity, result, n, cutoff_time)
+
+    datetime_cutoff = cutoff_time.to_pydatetime()
+    datetime_result = entity.head(n=n, cutoff_time=datetime_cutoff)
+    _assert_timestamp_cutoff(entity, datetime_result, n, datetime_cutoff)
+
+    expected = _expected_for_timestamp(entity, n, cutoff_time)
+    pd.testing.assert_frame_equal(result, expected)
+
+
+def test_entityset_head_filters_timestamp_cutoff(entityset):
+    entity = entityset['log']
+    n = 5
+    cutoff_time = entity.df[_time_index(entity)].iloc[3]
+
+    result = entityset.head('log', n=n, cutoff_time=cutoff_time)
+
+    _assert_timestamp_cutoff(entity, result, n, cutoff_time)
+    expected = _expected_for_timestamp(entity, n, cutoff_time)
+    pd.testing.assert_frame_equal(result, expected)
+
+
+def test_entity_head_filters_dataframe_cutoff_by_instance_and_time(entityset):
+    entity = entityset['log']
+    n = 10
+    cutoff_time = _cutoff_frame_for_rows(entity)
+
+    result = entity.head(n=n, cutoff_time=cutoff_time)
+
+    _assert_dataframe_cutoff(entity, result, n, cutoff_time)
+    assert len(result) < len(cutoff_time)
+
+
+def test_entityset_head_filters_dataframe_cutoff_by_instance_and_time(entityset):
+    entity = entityset['log']
+    n = 10
+    cutoff_time = _cutoff_frame_for_rows(entity)
+
+    result = entityset.head('log', n=n, cutoff_time=cutoff_time)
+
+    _assert_dataframe_cutoff(entity, result, n, cutoff_time)
+    assert len(result) < len(cutoff_time)
+
+
+def test_variable_head_returns_single_column_dataframe_with_timestamp_cutoff(entityset):
+    entity = entityset['log']
+    variable = entity['product_id']
+    n = 5
+    cutoff_time = entity.df[_time_index(entity)].iloc[3]
+
+    result = variable.head(n=n, cutoff_time=cutoff_time)
+
+    expected = _expected_for_timestamp(entity, n, cutoff_time)[[variable.id]]
+    assert isinstance(result, pd.DataFrame)
+    assert list(result.columns) == [variable.id]
+    pd.testing.assert_frame_equal(result, expected)
+
+
+def test_variable_head_returns_single_column_dataframe_with_dataframe_cutoff(entityset):
+    entity = entityset['log']
+    variable = entity['product_id']
+    n = 10
+    cutoff_time = _cutoff_frame_for_rows(entity)
+
+    result = variable.head(n=n, cutoff_time=cutoff_time)
+
+    expected = entity.head(n=n, cutoff_time=cutoff_time)[[variable.id]]
+    assert isinstance(result, pd.DataFrame)
+    assert list(result.columns) == [variable.id]
+    pd.testing.assert_frame_equal(result, expected)
+
+
+def test_head_rejects_unsupported_cutoff_type(entityset):
+    entity = entityset['log']
+
+    with pytest.raises(ValueError) as exc:
+        entity.head(cutoff_time=object())
+
+    assert str(exc.value) == (
+        'cutoff_time must be None, a Datetime, a pd.Timestamp, or a pd.DataFrame')
+
+
+def test_entityset_head_rejects_unsupported_cutoff_type(entityset):
+    with pytest.raises(ValueError) as exc:
+        entityset.head('log', cutoff_time=object())
+
+    assert str(exc.value) == (
+        'cutoff_time must be None, a Datetime, a pd.Timestamp, or a pd.DataFrame')
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,37 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set +u
+export PYENV_ROOT="$HOME/.pyenv"
+export PATH="$PYENV_ROOT/bin:$PATH"
+eval "$(pyenv init -)"
+pyenv global 2.7.18
+
+pip install -e . --no-deps 2>/dev/null
+set -u
+
+
+case "${1:-}" in
+  base)
+    python -m pytest featuretools/tests/entityset_tests/test_pandas_es.py -xvs -k \
+      'not test_head_of_entity and not test_entity_head_filters_timestamp_cutoff and not test_entityset_head_filters_timestamp_cutoff and not test_entity_head_filters_dataframe_cutoff_by_instance_and_time and not test_entityset_head_filters_dataframe_cutoff_by_instance_and_time and not test_variable_head_returns_single_column_dataframe_with_timestamp_cutoff and not test_variable_head_returns_single_column_dataframe_with_dataframe_cutoff and not test_head_rejects_unsupported_cutoff_type and not test_entityset_head_rejects_unsupported_cutoff_type'
+    ;;
+  new)
+    python -m pytest -xvs \
+      featuretools/tests/entityset_tests/test_pandas_es.py::test_head_of_entity \
+      featuretools/tests/entityset_tests/test_pandas_es.py::test_entity_head_filters_timestamp_cutoff \
+      featuretools/tests/entityset_tests/test_pandas_es.py::test_entityset_head_filters_timestamp_cutoff \
+      featuretools/tests/entityset_tests/test_pandas_es.py::test_entity_head_filters_dataframe_cutoff_by_instance_and_time \
+      featuretools/tests/entityset_tests/test_pandas_es.py::test_entityset_head_filters_dataframe_cutoff_by_instance_and_time \
+      featuretools/tests/entityset_tests/test_pandas_es.py::test_variable_head_returns_single_column_dataframe_with_timestamp_cutoff \
+      featuretools/tests/entityset_tests/test_pandas_es.py::test_variable_head_returns_single_column_dataframe_with_dataframe_cutoff \
+      featuretools/tests/entityset_tests/test_pandas_es.py::test_head_rejects_unsupported_cutoff_type \
+      featuretools/tests/entityset_tests/test_pandas_es.py::test_entityset_head_rejects_unsupported_cutoff_type
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
