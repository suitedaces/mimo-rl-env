diff --git a/test/dashboards/docs/html-component-docs.js b/test/dashboards/docs/html-component-docs.js
new file mode 100644
index 0000000000..c75bf0763e
--- /dev/null
+++ b/test/dashboards/docs/html-component-docs.js
@@ -0,0 +1,47 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+
+const rootDir = path.join(__dirname, '../../..');
+
+function readRepoFile(relativePath) {
+    return fs.readFileSync(path.join(rootDir, relativePath), 'utf8');
+}
+
+function testHtmlComponentDocsMentionHtmlStringConfiguration() {
+    const htmlComponentDocs = readRepoFile(
+        'docs/dashboards/html-component.md'
+    );
+    const htmlConfigMatch = /(?:`html`|\bhtml\s*:)/.exec(htmlComponentDocs);
+
+    assert.ok(
+        htmlConfigMatch,
+        'Built-in HTML Component docs should mention the html config key.'
+    );
+
+    const context = htmlComponentDocs.slice(
+        Math.max(0, htmlConfigMatch.index - 250),
+        htmlConfigMatch.index + 250
+    );
+
+    assert.ok(
+        /string|markup|HTML code|HTML content|plain HTML/i.test(context),
+        'The html config key should be documented as string/markup content.'
+    );
+}
+
+function testCustomComponentDocsDoNotPresentManualHtmlParsingAsRequired() {
+    const customComponentDocs = readRepoFile(
+        'docs/dashboards/custom-component.md'
+    );
+
+    assert.ok(
+        !/else\s+if\s*\(\s*options\.html\s*\)[\s\S]{0,400}this\.options\.elements\s*=/m.test(customComponentDocs),
+        'Custom component docs should not keep the old options.html-to-elements parsing guidance.'
+    );
+}
+
+testHtmlComponentDocsMentionHtmlStringConfiguration();
+testCustomComponentDocsDoNotPresentManualHtmlParsingAsRequired();
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,90 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export PATH=/opt/node-20/bin:$PATH
+
+
+
+if [ ! -d /testbed/node_modules/gulp ] || [ ! -d /testbed/node_modules/karma ]; then
+    npm install --ignore-scripts 2>&1
+fi
+
+
+export CHROME_BIN=/root/.cache/puppeteer/chrome/linux-149.0.7827.22/chrome-linux64/chrome
+
+
+write_karma_wrapper() {
+    mkdir -p /testbed/test/typescript-karma
+    cat > /testbed/test/typescript-karma/fixturea-karma-html-wrapper.js <<'WRAPPER'
+const path = require('path');
+const baseConfig = require(path.join(
+    '/testbed',
+    'test',
+    'typescript-karma',
+    'karma-conf.js'
+));
+
+module.exports = function (config) {
+    baseConfig(config);
+    const baseFiles = config.files || [];
+    config.set({
+        files: baseFiles.filter(file => {
+            const pattern = typeof file === 'string' ? file : file.pattern;
+            return !pattern ||
+                !/^test\/typescript-karma\/.*\.js$/.test(pattern) ||
+                /test\/typescript-karma\/karma-(fetch|setup)\.js$/.test(pattern);
+        }).concat([{
+            pattern: 'test/typescript-karma/fixturea-filter.js',
+            type: 'module'
+        }, {
+            pattern: 'test/typescript-karma/Dashboards/Component/html.js',
+            type: 'module'
+        }]),
+        browsers: ['ChromeHeadlessNoSandbox'],
+        customLaunchers: {
+            ChromeHeadlessNoSandbox: {
+                base: 'ChromeHeadless',
+                flags: ['--no-sandbox', '--disable-setuid-sandbox']
+            }
+        }
+    });
+};
+WRAPPER
+}
+
+prepare_dashboard_tests() {
+
+    npx gulp dashboards/scripts 2>&1 || return $?
+
+
+    mkdir -p /testbed/vendor
+    cp /testbed/node_modules/requirejs/require.js /testbed/vendor/require.js || return $?
+
+    write_karma_wrapper
+}
+
+run_karma_filtered() {
+    local grep_pattern="$1"
+    local filter_json
+    filter_json=$(node -e 'process.stdout.write(JSON.stringify(process.argv[1]))' "$grep_pattern") || return $?
+    printf 'QUnit.config.filter = %s;\n' "$filter_json" > /testbed/test/typescript-karma/fixturea-filter.js
+    prepare_dashboard_tests || return $?
+    npx karma start /testbed/test/typescript-karma/fixturea-karma-html-wrapper.js \
+        --single-run 2>&1
+}
+
+case "${1:-}" in
+    base)
+        run_karma_filtered 'component resizing'
+        ;;
+    new)
+        run_karma_filtered 'HTML Component renders' || exit $?
+        node /testbed/test/dashboards/docs/html-component-docs.js
+        ;;
+    *)
+        echo "usage: $0 base|new"
+        exit 2
+        ;;
+esac
