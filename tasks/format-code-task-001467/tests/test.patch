+test('HTML Component renders content from html string configuration', async function (assert) {
+    const parentElement = document.getElementById('container');
+
+    assert.ok(parentElement, 'Test container should exist.');
+
+    if (!parentElement) {
+        return;
+    }
+
+    parentElement.innerHTML = '';
+
+    const board = await Dashboards.board(parentElement, {
+        gui: {
+            enabled: true,
+            layouts: [{
+                rows: [{
+                    cells: [{
+                        id: 'dashboard-html-elements-cell'
+                    }, {
+                        id: 'dashboard-html-string-cell'
+                    }]
+                }]
+            }]
+        },
+        components: [{
+            type: 'HTML',
+            renderTo: 'dashboard-html-elements-cell',
+            elements: [{
+                tagName: 'h3',
+                textContent: 'Existing elements content'
+            }]
+        }, {
+            type: 'HTML',
+            renderTo: 'dashboard-html-string-cell',
+            html: (
+                '<div id="html-string-root" class="primary">' +
+                    '<h2>HTML string title</h2>' +
+                    '<p><span class="label">Nested text</span></p>' +
+                '</div>'
+            )
+        }]
+    }, true);
+
+    const compFromElements = board.mountedComponents[0].component;
+    const compFromString = board.mountedComponents[1].component;
+    const renderedRoot = compFromString.element.querySelector(
+        'div#html-string-root'
+    );
+    const renderedHeading = compFromString.element.querySelector(
+        'div#html-string-root h2'
+    );
+    const renderedNestedText = compFromString.element.querySelector(
+        'div#html-string-root p span.label'
+    );
+
+    assert.strictEqual(
+        compFromElements.element.textContent.trim(),
+        'Existing elements content',
+        'Existing elements configuration should continue to render.'
+    );
+
+    assert.ok(
+        renderedRoot,
+        'The HTML string should create the configured element structure.'
+    );
+
+    assert.strictEqual(
+        renderedRoot && renderedRoot.getAttribute('class'),
+        'primary',
+        'Attributes from the HTML string should be preserved.'
+    );
+
+    assert.strictEqual(
+        renderedHeading && renderedHeading.textContent,
+        'HTML string title',
+        'Text inside elements from the HTML string should be rendered.'
+    );
+
+    assert.strictEqual(
+        renderedNestedText && renderedNestedText.textContent,
+        'Nested text',
+        'Nested markup from the HTML string should be rendered.'
+    );
+});
+
