+++ b/tests/test_serialization_contract.py
@@ -0,0 +1,201 @@
+import json
+
+import numpy as np
+
+from optiland.fileio import load_optiland_file, save_optiland_file
+from optiland.optic import Optic
+from optiland.rays import PolarizationState, create_polarization
+from optiland.samples.objectives import CookeTriplet, HeliarLens
+
+
+def _minimal_optic(name="demo"):
+    optic = Optic(name=name)
+    optic.set_field_type("angle")
+    optic.add_field(y=0.0, x=0.25, vx=0.1, vy=0.2)
+    optic.add_wavelength(550, is_primary=True, unit="nm")
+    optic.add_wavelength(650, is_primary=False, unit="nm")
+    return optic
+
+
+def test_name_round_trip_through_json(tmp_path):
+    optic = _minimal_optic("unnamed-aperture-system")
+    optic.set_aperture("EPD", 4.0)
+    path = tmp_path / "optic.json"
+
+    save_optiland_file(optic, path)
+    payload = json.loads(path.read_text())
+    restored = load_optiland_file(path)
+
+    assert payload["name"] == "unnamed-aperture-system"
+    assert restored.name == optic.name
+
+
+def test_null_aperture_round_trip_through_json(tmp_path):
+    optic = _minimal_optic(name=None)
+    path = tmp_path / "no-aperture.json"
+
+    save_optiland_file(optic, path)
+    payload = json.loads(path.read_text())
+    restored = load_optiland_file(path)
+
+    assert payload["aperture"] is None
+    assert restored.aperture is None
+
+
+def test_fields_and_wavelengths_keep_public_values(tmp_path):
+    optic = _minimal_optic()
+    optic.set_aperture("EPD", 4.0)
+    optic.obj_space_telecentric = True
+    path = tmp_path / "fields-and-waves.json"
+
+    save_optiland_file(optic, path)
+    payload = json.loads(path.read_text())
+    restored = load_optiland_file(path)
+
+    assert restored.field_type == "angle"
+    assert restored.obj_space_telecentric is True
+    assert restored.fields.get_field(0).x == 0.25
+    assert restored.fields.get_field(0).vx == 0.1
+    assert payload["wavelengths"]["wavelengths"][0]["unit"] == "nm"
+    assert restored.wavelengths.get_wavelengths() == [0.55, 0.65]
+    assert restored.wavelengths.primary_index == 0
+
+
+def test_polarized_state_is_json_data_and_restores_as_state(tmp_path):
+    optic = _minimal_optic()
+    optic.set_aperture("EPD", 4.0)
+    state = create_polarization("RCP")
+    optic.set_polarization(state)
+    path = tmp_path / "polarized.json"
+
+    save_optiland_file(optic, path)
+    payload = json.loads(path.read_text())
+    restored = load_optiland_file(path)
+
+    assert payload["polarization"] == {
+        "is_polarized": True,
+        "Ex": state.Ex,
+        "Ey": state.Ey,
+        "phase_x": state.phase_x,
+        "phase_y": state.phase_y,
+    }
+    assert "polarization" not in payload["wavelengths"]
+    restored_state = restored.polarization_state
+    assert isinstance(restored_state, PolarizationState)
+    assert restored_state.is_polarized is True
+    assert restored_state.Ex == state.Ex
+    assert restored_state.Ey == state.Ey
+    assert restored_state.phase_x == state.phase_x
+    assert restored_state.phase_y == state.phase_y
+
+
+def test_ignore_polarization_is_stored_as_literal(tmp_path):
+    optic = _minimal_optic()
+    optic.set_aperture("EPD", 4.0)
+    path = tmp_path / "ignore.json"
+
+    save_optiland_file(optic, path)
+    payload = json.loads(path.read_text())
+    restored = load_optiland_file(path)
+
+    assert payload["polarization"] == "ignore"
+    assert restored.polarization == "ignore"
+    assert restored.polarization_state is None
+
+
+def test_legacy_nested_polarization_loads_as_state():
+    optic = _minimal_optic()
+    optic.set_aperture("EPD", 4.0)
+    payload = optic.to_dict()
+    payload.pop("polarization", None)
+    state = create_polarization("L+45")
+    payload["wavelengths"]["polarization"] = {
+        "is_polarized": state.is_polarized,
+        "Ex": state.Ex,
+        "Ey": state.Ey,
+        "phase_x": state.phase_x,
+        "phase_y": state.phase_y,
+    }
+
+    restored = Optic.from_dict(payload)
+
+    assert isinstance(restored.polarization_state, PolarizationState)
+    assert restored.polarization_state.Ex == state.Ex
+    assert restored.polarization_state.Ey == state.Ey
+
+
+def test_top_level_polarization_precedes_legacy_nested_value():
+    optic = _minimal_optic()
+    optic.set_aperture("EPD", 4.0)
+    payload = optic.to_dict()
+    payload["polarization"] = "ignore"
+    payload["wavelengths"]["polarization"] = {
+        "is_polarized": False,
+        "Ex": None,
+        "Ey": None,
+        "phase_x": None,
+        "phase_y": None,
+    }
+
+    restored = Optic.from_dict(payload)
+
+    assert restored.polarization == "ignore"
+    assert restored.polarization_state is None
+
+
+def test_missing_optional_metadata_uses_legacy_defaults():
+    optic = _minimal_optic()
+    optic.set_aperture("EPD", 4.0)
+    payload = optic.to_dict()
+    payload.pop("version", None)
+    payload.pop("name", None)
+    payload["fields"].pop("object_space_telecentric", None)
+
+    restored = Optic.from_dict(payload)
+
+    assert restored.name is None
+    assert restored.obj_space_telecentric is False
+
+
+def test_pickup_declarations_survive_round_trip_and_update_once(tmp_path):
+    optic = HeliarLens()
+    optic.pickups.add(1, "radius", 2, scale=2.0, offset=1.0)
+    path = tmp_path / "pickup.json"
+    save_optiland_file(optic, path)
+    restored = load_optiland_file(path)
+
+    np.testing.assert_allclose(
+        restored.surface_group.radii, optic.surface_group.radii
+    )
+    assert len(restored.pickups) == 1
+
+    source_radius = 5.25
+    restored.set_radius(source_radius, 1)
+    restored.update()
+    assert restored.surface_group.radii[2] == 2.0 * source_radius + 1.0
+
+
+def test_solved_optic_is_serializable_and_restores_solve_declaration(tmp_path):
+    optic = CookeTriplet()
+    optic.solves.add("marginal_ray_height", 6, 0.5)
+    before_positions = np.array([
+        float(np.asarray(surface.geometry.cs.z).reshape(-1)[0])
+        for surface in optic.surface_group.surfaces
+    ])
+    path = tmp_path / "solved.json"
+
+    save_optiland_file(optic, path)
+    payload = json.loads(path.read_text())
+    restored = load_optiland_file(path)
+
+    assert len(restored.solves) == 1
+    solve = restored.solves.solves[0]
+    assert solve.surface_idx == 6
+    assert solve.height == 0.5
+    assert payload["surface_group"]["surfaces"][6]["geometry"]["cs"]["z"] == \
+        before_positions[6]
+    restored_positions = np.array([
+        float(np.asarray(surface.geometry.cs.z).reshape(-1)[0])
+        for surface in restored.surface_group.surfaces
+    ])
+    np.testing.assert_allclose(restored_positions, before_positions)
