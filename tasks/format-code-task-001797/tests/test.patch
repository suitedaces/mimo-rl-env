+    def _build_cli_for_suppress_test(self, env_var=None, config_extras=None):
+        """
+        Helper that builds a fresh CLI instance with optional env-var and
+        config setup performed *before* construction. This ensures
+        implementations that read env vars / config at CLI init time
+        (rather than lazily at warning time) still pick up the values.
+        """
+        import configparser
+
+        from linodecli.cli import CLI
+
+        mock_config_str = (
+            "[DEFAULT]\n"
+            "default-user = testuser\n\n"
+            "[testuser]\n"
+            "region = us-southeast\n"
+            "image = linode/ubuntu21.10\n"
+            "token = notafaketoken\n"
+            "type = g6-nanode-1\n"
+        )
+        if config_extras:
+            for k, v in config_extras.items():
+                mock_config_str += f"{k} = {v}\n"
+
+        preloaded_conf = configparser.ConfigParser()
+        preloaded_conf.read_string(mock_config_str)
+
+
+
+        with patch(
+            "linodecli.configuration.config._get_config",
+            return_value=preloaded_conf,
+        ):
+            cli = CLI("0.0.0", "http://localhost", skip_config=True)
+
+
+            cli.config.config = preloaded_conf
+            cli.config._configured = True
+
+        cli.suppress_warnings = False
+        cli.version = "1.0.0"
+        cli.spec_version = "1.0.0"
+        return cli
+
+    def test_outdated_cli_suppressed_by_env_var(self, monkeypatch):
+
+
+
+
+        monkeypatch.setenv("LINODE_CLI_SUPPRESS_VERSION_WARNING", "true")
+
+        cli = self._build_cli_for_suppress_test()
+
+        def mock_http_response(url, headers=None, data=None, timeout=1):
+            r = requests.Response()
+            r.status_code = 200
+            r.json = lambda: {"info": {"version": "1.1.0"}}
+            return r
+
+        stderr_buf = io.StringIO()
+        mock_response = SimpleNamespace(
+            status_code=200, reason="OK", headers={"X-Spec-Version": "1.1.0"}
+        )
+
+        with contextlib.redirect_stderr(stderr_buf), patch(
+            "linodecli.api_request.requests.get", mock_http_response
+        ):
+            api_request._attempt_warn_old_version(cli, mock_response)
+
+        output = stderr_buf.getvalue()
+        assert "newer than" not in output
+        assert "Please update the CLI" not in output
+
+    def test_outdated_cli_suppressed_by_config(self, monkeypatch):
+
+
+
+
+
+        monkeypatch.delenv("LINODE_CLI_SUPPRESS_VERSION_WARNING", raising=False)
+
+        cli = self._build_cli_for_suppress_test(
+            config_extras={"suppress-version-warning": "true"}
+        )
+
+        def mock_http_response(url, headers=None, data=None, timeout=1):
+            r = requests.Response()
+            r.status_code = 200
+            r.json = lambda: {"info": {"version": "1.1.0"}}
+            return r
+
+        stderr_buf = io.StringIO()
+        mock_response = SimpleNamespace(
+            status_code=200, reason="OK", headers={"X-Spec-Version": "1.1.0"}
+        )
+
+        with contextlib.redirect_stderr(stderr_buf), patch(
+            "linodecli.api_request.requests.get", mock_http_response
+        ):
+            api_request._attempt_warn_old_version(cli, mock_response)
+
+        output = stderr_buf.getvalue()
+        assert "newer than" not in output
+        assert "Please update the CLI" not in output
+
+    def test_outdated_cli_not_suppressed_when_config_false(
+        self, mock_cli, monkeypatch
+    ):
+
+
+        mock_cli.suppress_warnings = False
+        mock_cli.version = "1.0.0"
+        mock_cli.spec_version = "1.0.0"
+
+        monkeypatch.delenv("LINODE_CLI_SUPPRESS_VERSION_WARNING", raising=False)
+        mock_cli.config.config.set(
+            "testuser", "suppress-version-warning", "false"
+        )
+
+        def mock_http_response(url, headers=None, data=None, timeout=1):
+            r = requests.Response()
+            r.status_code = 200
+            r.json = lambda: {"info": {"version": "1.1.0"}}
+            return r
+
+        stderr_buf = io.StringIO()
+        mock_response = SimpleNamespace(
+            status_code=200, reason="OK", headers={"X-Spec-Version": "1.1.0"}
+        )
+
+        with contextlib.redirect_stderr(stderr_buf), patch(
+            "linodecli.api_request.requests.get", mock_http_response
+        ):
+            api_request._attempt_warn_old_version(mock_cli, mock_response)
+
+        output = stderr_buf.getvalue()
+        assert (
+            "The API responded with version 1.1.0, which is newer than "
+            "the CLI's version of 1.0.0." in output
+        )
+
