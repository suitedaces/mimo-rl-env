+import React from 'react'
+import { expect } from 'chai'
+import { shallow } from 'enzyme'
+import {
+  CONTENT_NAMESPACE,
+  getFileChildContent,
+  appContentFactory
+} from '../src/index.js'
+
+describe('content namespace support for publication/comment files', () => {
+  describe('the CONTENT_NAMESPACE enumeration', () => {
+    it('should be exposed by the library', () => {
+      expect(CONTENT_NAMESPACE).to.be.an('object')
+    })
+
+    it('should describe the content, upload and publication namespaces', () => {
+      expect(CONTENT_NAMESPACE.CONTENT).to.equal('content')
+      expect(CONTENT_NAMESPACE.UPLOAD).to.equal('upload')
+      expect(CONTENT_NAMESPACE.PUBLICATION).to.equal('publication')
+    })
+  })
+
+  describe('getFileChildContent', () => {
+    let capturedUrl = null
+    let capturedOptions = null
+    const originalFetch = global.fetch
+
+    before(() => {
+      global.fetch = (url, options) => {
+        capturedUrl = url
+        capturedOptions = options
+        return Promise.resolve({})
+      }
+      getFileChildContent('http://localhost/api', 12, 42)
+    })
+
+    after(() => {
+      global.fetch = originalFetch
+    })
+
+    it('should issue a GET request', () => {
+      expect(capturedOptions.method).to.equal('GET')
+    })
+
+    it('should still filter on the given parent and on file content type', () => {
+      const parsed = new URL(capturedUrl)
+      expect(parsed.searchParams.get('parent_ids')).to.equal('42')
+      expect(parsed.searchParams.get('content_type')).to.equal('file')
+    })
+
+    it('should restrict the results to the content and publication namespaces', () => {
+      const parsed = new URL(capturedUrl)
+      const filter = parsed.searchParams.get('namespaces_filter')
+      expect(filter, 'a namespaces_filter query parameter is expected').to.be.a('string')
+      const namespaceList = filter.split(',')
+      expect(namespaceList).to.include('content')
+      expect(namespaceList).to.include('publication')
+      expect(namespaceList).to.not.include('upload')
+    })
+  })
+
+  describe('queuing files to be sent as comments with a namespace', () => {
+    const WrappedComponent = appContentFactory(() => null)
+    const wrapper = shallow(<WrappedComponent />)
+
+    const callAddCommentAsFile = (fileList, namespace, previousState) => {
+      let updater = null
+      const setState = (arg) => { updater = arg }
+      wrapper.instance().appContentAddCommentAsFile(fileList, namespace, setState)
+      if (updater === null) return { setStateCalled: false }
+      const update = typeof updater === 'function' ? updater(previousState) : updater
+      return { setStateCalled: true, update }
+    }
+
+    it('should tag every newly queued file with the given namespace', () => {
+      const { setStateCalled, update } = callAddCommentAsFile(
+        [{ file: { name: 'foo.txt' } }, { file: { name: 'bar.txt' } }],
+        'publication',
+        { newCommentAsFileList: [] }
+      )
+      expect(setStateCalled).to.equal(true)
+      expect(update.newCommentAsFileList).to.have.lengthOf(2)
+      update.newCommentAsFileList.forEach(queued => {
+        expect(queued.namespace).to.equal('publication')
+      })
+      const names = update.newCommentAsFileList.map(queued => queued.file.name)
+      expect(names).to.include('foo.txt')
+      expect(names).to.include('bar.txt')
+    })
+
+    it('should append to the already queued files without dropping them', () => {
+      const { update } = callAddCommentAsFile(
+        [{ file: { name: 'bar.txt' } }],
+        'publication',
+        { newCommentAsFileList: [{ file: { name: 'foo.txt' }, namespace: 'content' }] }
+      )
+      const names = update.newCommentAsFileList.map(queued => queued.file.name)
+      expect(names).to.include('foo.txt')
+      expect(names).to.include('bar.txt')
+      expect(update.newCommentAsFileList.find(q => q.file.name === 'bar.txt').namespace).to.equal('publication')
+    })
+
+    it('should not queue a file whose name is already in the list', () => {
+      const { update } = callAddCommentAsFile(
+        [{ file: { name: 'foo.txt' } }, { file: { name: 'bar.txt' } }],
+        'publication',
+        { newCommentAsFileList: [{ file: { name: 'foo.txt' }, namespace: 'content' }] }
+      )
+      const fooEntries = update.newCommentAsFileList.filter(queued => queued.file.name === 'foo.txt')
+      expect(fooEntries).to.have.lengthOf(1)
+      const names = update.newCommentAsFileList.map(queued => queued.file.name)
+      expect(names).to.include('bar.txt')
+    })
+
+    it('should do nothing when the file list is empty', () => {
+      const { setStateCalled } = callAddCommentAsFile([], 'publication', { newCommentAsFileList: [] })
+      expect(setStateCalled).to.equal(false)
+    })
+  })
+})
