+
+
+
+
+
+
+
+
+from __future__ import annotations
+
+import copy
+import io
+import json
+import os
+import socket
+import subprocess
+import sys
+from pathlib import Path
+from unittest import mock
+
+from ftfy import TextFixerConfig, apply_plan, fix_and_explain, fix_file, fix_text, fix_text_segment
+from ftfy.fixes import uncurl_quotes
+
+
+def _relative_snapshot(root: Path) -> list[str]:
+    return sorted(str(path.relative_to(root)) for path in root.rglob("*"))
+
+
+def test_direct_api_replaces_query_example_curly_quotes() -> None:
+
+
+
+
+    actual = uncurl_quotes("“here’s a test”")
+    assert actual == "\"here's a test\""
+
+
+def test_direct_api_replaces_modifier_apostrophe_and_low_double_quotes() -> None:
+
+
+
+
+    actual = uncurl_quotes("lʼamour ‘quoted’ ‟word‟")
+    assert actual == "l'amour 'quoted' \"word\""
+
+
+def test_direct_api_replaces_all_curly_single_quote_range_members() -> None:
+
+
+
+
+    actual = uncurl_quotes("‘left’ ‛reversed‛ ‚low‚")
+    assert actual == "'left' 'reversed' 'low'"
+
+
+def test_direct_api_leaves_non_target_single_quote_boundary_unchanged() -> None:
+
+
+
+
+    actual = uncurl_quotes("x‗y“z")
+    assert actual == "x‗y\"z"
+
+
+def test_direct_api_replaces_all_curly_double_quote_range_members() -> None:
+
+
+
+
+    actual = uncurl_quotes("“left” „low‟ ‟rev‟")
+    assert actual == "\"left\" \"low\" \"rev\""
+
+
+def test_direct_api_preserves_meaningful_non_target_characters() -> None:
+
+
+
+
+    actual = uncurl_quotes("漢字 👩🏽\u200d💻 tag\U000e0061 שׁוּרָה")
+    assert actual == "漢字 👩🏽\u200d💻 tag\U000e0061 שׁוּרָה"
+
+
+def test_fix_text_runs_uncurl_quotes_by_default() -> None:
+
+
+
+
+    actual = fix_text("it’s fine")
+    assert actual == "it's fine"
+
+
+def test_fix_text_keyword_option_disables_uncurl_quotes() -> None:
+
+
+
+
+    actual = fix_text("it’s fine", uncurl_quotes=False)
+    assert actual == "it’s fine"
+
+
+def test_fix_text_config_option_disables_uncurl_quotes() -> None:
+
+
+
+
+    actual = fix_text("it’s fine", TextFixerConfig(uncurl_quotes=False))
+    assert actual == "it’s fine"
+
+
+def test_fix_text_segment_runs_and_respects_option() -> None:
+
+
+
+
+    assert fix_text_segment("“seg” and it’s ok") == "\"seg\" and it's ok"
+    assert fix_text_segment("“seg” and it’s ok", uncurl_quotes=False) == "“seg” and it’s ok"
+
+
+def test_fix_file_runs_and_respects_option() -> None:
+
+
+
+
+    default_actual = list(fix_file(io.StringIO("one “line”\ntwo’s line")))
+    disabled_actual = list(
+        fix_file(io.StringIO("one “line”\ntwo’s line"), uncurl_quotes=False)
+    )
+
+    assert "".join(default_actual) == 'one "line"\ntwo\'s line'
+    assert "".join(disabled_actual) == "one “line”\ntwo’s line"
+
+
+def test_fix_and_explain_records_uncurl_step_only_when_changed() -> None:
+
+
+
+
+    changed = fix_and_explain("it’s fine")
+    unchanged = fix_and_explain("it's fine")
+    assert changed.text == "it's fine"
+
+    assert ("apply", "uncurl_quotes") in changed.explanation
+    assert unchanged.text == "it's fine"
+
+    assert ("apply", "uncurl_quotes") not in unchanged.explanation
+
+
+def test_apply_plan_supports_uncurl_quotes_step() -> None:
+
+
+
+
+    actual = apply_plan("it’s fine", [("apply", "uncurl_quotes")])
+    assert actual == "it's fine"
+
+
+def test_direct_api_returns_str_for_str_input() -> None:
+
+
+
+
+
+    actual = uncurl_quotes("it’s text")
+    assert isinstance(actual, str)
+    assert actual == "it's text"
+
+
+def test_referential_transparency_same_input_same_output() -> None:
+    actual_first = uncurl_quotes("“repeat” and it’s stable")
+    actual_second = uncurl_quotes("“repeat” and it’s stable")
+    assert actual_first == "\"repeat\" and it's stable"
+    assert actual_second == "\"repeat\" and it's stable"
+    assert actual_first == actual_second
+
+
+def test_input_string_is_not_mutated() -> None:
+    text = "lʼamour ‘quoted’ ‟word‟"
+    before = copy.deepcopy(text)
+    actual = uncurl_quotes(text)
+    assert actual == "l'amour 'quoted' \"word\""
+    assert text == before
+
+
+def test_no_hidden_global_state_across_processes() -> None:
+    text = "“fresh” cache shouldn’t matter"
+    expected = "\"fresh\" cache shouldn't matter"
+    in_process = uncurl_quotes(text)
+    assert uncurl_quotes("‘noise’") == "'noise'"
+    after_noise = uncurl_quotes(text)
+
+    script = (
+        "import json, sys; "
+        "sys.path.insert(0, '/workspace/repo'); "
+        "from ftfy.fixes import uncurl_quotes; "
+        "sys.stdout.write(json.dumps(uncurl_quotes('“fresh” cache shouldn’t matter')))"
+    )
+    fresh = json.loads(
+        subprocess.run(
+            [sys.executable, "-c", script],
+            check=True,
+            text=True,
+            capture_output=True,
+        ).stdout
+    )
+
+    assert in_process == expected
+    assert after_noise == expected
+    assert fresh == expected
+
+
+def test_uncurl_quotes_has_no_undeclared_io_or_network_side_effects(tmp_path: Path) -> None:
+    cwd_before = Path.cwd()
+    os.chdir(tmp_path)
+    try:
+        before = _relative_snapshot(tmp_path)
+        with (
+            mock.patch("builtins.open", side_effect=AssertionError("unexpected file IO")),
+            mock.patch("io.open", side_effect=AssertionError("unexpected file IO")),
+            mock.patch.object(
+                socket, "socket", side_effect=AssertionError("unexpected network IO")
+            ),
+            mock.patch.object(
+                socket,
+                "create_connection",
+                side_effect=AssertionError("unexpected network IO"),
+            ),
+        ):
+            actual = uncurl_quotes("“no side effects”")
+        after = _relative_snapshot(tmp_path)
+    finally:
+        os.chdir(cwd_before)
+
+    assert actual == "\"no side effects\""
+    assert after == before
