+          parameters:
+            InternalA:
+              in: header
+              name: A
+              schema:
+                type: string
+              x-internal: true
+            PublicX:
+              in: query
+              name: X
+              schema:
+                type: string
+            InternalB:
+              in: header
+              name: B
+              schema:
+                type: string
+              x-internal: true
+      `);
+    const { bundle: res } = await bundleDocument({
+      document: testDoc,
