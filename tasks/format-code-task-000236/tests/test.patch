+          parameters:
+            ProductID:
+              in: query
+              name: product_id
+              schema:
+                type: string
+      `);
+    const { bundle: res } = await bundleDocument({
+      document: testDoc,
+      externalRefResolver: new BaseResolver(),
+      config: makeConfig({}, { 'remove-x-internal': 'on' })
+    });
+    expect(res.parsed).toMatchInlineSnapshot(`
+      openapi: 3.0.0
+      paths:
+        /products:
+          get:
+            parameters:
+              - $ref: '#/components/parameters/ProductID'
