+describe('oas3 remove-x-internal $ref handling', () => {
+  expect.addSnapshotSerializer(yamlSerializer);
+
+  it('should remove ref to internal parameter component while preserving non-internal ref', async () => {
+    const testDoc = parseYamlToDocument(
+      outdent`
+        openapi: 3.0.0
+        paths:
+          '/products/{product_id}':
+            get:
+              parameters:
+                - $ref: '#/components/parameters/ProductID'
+                - $ref: '#/components/parameters/Vendor'
+        components:
+          parameters:
+            ProductID:
+              in: path
+              name: product_id
+              description: The ID of the product.
+              required: true
+              schema:
+                type: string
+                format: uuid
+            Vendor:
+              in: header
+              name: X-Vendor
+              description: The vendor.
+              schema:
+                type: string
+              x-internal: true
+      `);
+    const { bundle: res } = await bundleDocument({
+      document: testDoc,
+      externalRefResolver: new BaseResolver(),
+      config: makeConfig({}, { 'remove-x-internal': 'on' })
+    });
+    expect(res.parsed).toMatchInlineSnapshot(`
+      openapi: 3.0.0
+      paths:
+        /products/{product_id}:
+          get:
+            parameters:
+              - $ref: '#/components/parameters/ProductID'
+      components:
+        parameters:
+          ProductID:
+            in: path
+            name: product_id
+            description: The ID of the product.
+            required: true
+            schema:
+              type: string
+              format: uuid
+
+    `);
+  });
+
+  it('should remove parameters key when only ref is to internal component', async () => {
+    const testDoc = parseYamlToDocument(
