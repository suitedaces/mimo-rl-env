+        parameters:
+          ProductID:
+            in: query
+            name: product_id
+            schema:
+              type: string
+
+    `);
+  });
+
+  it('should remove all internal refs in array with multiple internal refs', async () => {
+    const testDoc = parseYamlToDocument(
+      outdent`
