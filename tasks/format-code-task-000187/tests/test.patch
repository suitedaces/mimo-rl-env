@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+if [ ! -f go.mod ]; then
+    cat > go.mod <<'EOF'
+module github.com/prysmaticlabs/prysm
+
+go 1.16
+
+require (
+	github.com/ethereum/go-ethereum v1.8.27
+	github.com/gogo/protobuf v1.2.1
+	github.com/steakknife/hamming v0.0.0-20180906055917-c99c65617cd3
+	github.com/urfave/cli v1.20.0
+	golang.org/x/crypto v0.0.0-20190313024323-a1f597ede03a
+)
+EOF
+fi
+
+export GOTOOLCHAIN=local
+export GOFLAGS=-mod=mod
+export GOPROXY=file:///root/go/pkg/mod/cache/download
+export GOSUMDB=off
+
+
+go test ./beacon-chain/core/helpers/
+go test ./beacon-chain/core/validators/ -run \
+'TestCrosslinkCommitteesAtSlot_Ok|TestCrosslinkCommitteesAtPrevSlot_ShuffleFailed|TestCrosslinkCommitteesAtCurrSlot_ShuffleFailed|TestAttestationParticipants_ok|TestAttestationParticipants_IncorrectBitfield|TestShuffling_Ok|TestShuffling_OutOfBound'
+
+
+go test ./beacon-chain/core/validators/ -run \
+'TestCrosslinkCommitteesAtSlot_NextEpochAccepted|TestCrosslinkCommitteesAtSlot_RegistryChangeShiftsStartShard|TestCrosslinkCommitteesAtSlot_DefaultMatchesNoRegistryChange|TestCrosslinkCommitteesAtSlot_RegistryChangeIgnoredForCurrentEpoch|TestCrosslinkCommitteesAtSlot_OutOfBounds'
