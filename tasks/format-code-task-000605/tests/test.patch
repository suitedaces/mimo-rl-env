+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+
+
+STUBDIR="$(mktemp -d)"
+trap 'rm -rf "$STUBDIR"' EXIT
+cat > "$STUBDIR/sitecustomize.py" <<'PY'
+import sys
+import types
+
+
+def _ensure(name):
+    try:
+        __import__(name)
+    except Exception:  # pylint: disable=broad-except
+        sys.modules[name] = types.ModuleType(name)
+
+
+_ensure('tensorflow_io')
+_ensure('etcd3')
+try:
+    __import__('tensorflow')
+except Exception:  # pylint: disable=broad-except
+    sys.modules.setdefault('fedlearner.trainer',
+                           types.ModuleType('fedlearner.trainer'))
+PY
+export PYTHONPATH="$STUBDIR:/testbed:${PYTHONPATH:-}"
+
+
+python test/data_join/test_etcd_client.py
+python test/data_join/test_mysql_client.py
