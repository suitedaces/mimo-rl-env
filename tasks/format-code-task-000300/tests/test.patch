--- /dev/null
+++ b/usercase-test-coderl/taskfile_parser_test.go
@@ -0,0 +1,240 @@
+package usercase_test_coderl
+
+import (
+	"bytes"
+	"io/ioutil"
+	"log"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/adhocore/gronx/pkg/tasker"
+)
+
+
+
+
+
+
+const fixturesDir = "/workspace/repo/usercase-test-coderl/fixtures"
+
+func fixturePath(name string) string {
+	return filepath.Join(fixturesDir, name)
+}
+
+func captureParserLogs(t *testing.T) *bytes.Buffer {
+	t.Helper()
+
+	var buf bytes.Buffer
+	oldWriter := log.Writer()
+	oldFlags := log.Flags()
+	oldPrefix := log.Prefix()
+	log.SetOutput(&buf)
+	log.SetFlags(0)
+	log.SetPrefix("")
+	t.Cleanup(func() {
+		log.SetOutput(oldWriter)
+		log.SetFlags(oldFlags)
+		log.SetPrefix(oldPrefix)
+	})
+
+	return &buf
+}
+
+func TestParsesFiveFieldTasksFilteringAndOrder(t *testing.T) {
+
+
+	tasks := tasker.MustParseTaskfile(tasker.Option{File: fixturePath("taskfile_basic.txt")})
+
+	expected := []tasker.Task{
+		{Expr: "*/1 0/1 * * *", Cmd: "echo '[task 1]' > test/task1.out"},
+		{Expr: "0 12 * * mon-fri", Cmd: "echo weekday noon"},
+		{Expr: "5 4 * * *", Cmd: "printf 'last task'"},
+	}
+	if !reflect.DeepEqual(tasks, expected) {
+		t.Fatalf("parsed tasks mismatch:\nactual:   %#v\nexpected: %#v", tasks, expected)
+	}
+}
+
+func TestParsesEverySupportedAlias(t *testing.T) {
+
+
+	tasks := tasker.MustParseTaskfile(tasker.Option{File: fixturePath("taskfile_aliases.txt")})
+
+	expected := []tasker.Task{
+		{Expr: "@annually", Cmd: "echo annually"},
+		{Expr: "@yearly", Cmd: "echo yearly"},
+		{Expr: "@monthly", Cmd: "echo monthly"},
+		{Expr: "@weekly", Cmd: "echo weekly"},
+		{Expr: "@daily", Cmd: "echo daily"},
+		{Expr: "@hourly", Cmd: "echo hourly"},
+		{Expr: "@5minutes", Cmd: "echo five"},
+		{Expr: "@10minutes", Cmd: "echo ten"},
+		{Expr: "@15minutes", Cmd: "echo fifteen"},
+		{Expr: "@30minutes", Cmd: "echo thirty"},
+		{Expr: "@always", Cmd: "echo '[task 3] @always' > test/task3.out"},
+		{Expr: "@everysecond", Cmd: "echo every second"},
+	}
+	if !reflect.DeepEqual(tasks, expected) {
+		t.Fatalf("parsed alias tasks mismatch:\nactual:   %#v\nexpected: %#v", tasks, expected)
+	}
+}
+
+func TestParsesExtendedCronPrefixes(t *testing.T) {
+
+
+	tasks := tasker.MustParseTaskfile(tasker.Option{File: fixturePath("taskfile_extended.txt")})
+
+
+	expected := []struct {
+		exprFields []string
+		cmd        string
+	}{
+		{[]string{"*/3", "*", "?", "*", "?", "0", "2000-2024/4"}, "echo \"run\""},
+		{[]string{"*/12", "*", "?", "*", "?", "mon"}, "echo \"run\""},
+		{[]string{"0,30", "1-5/2", "*", "*", "mon#2"}, "echo hash list range step"},
+		{[]string{"0", "0", "12", "15W", "*", "?"}, "echo nearest weekday"},
+		{[]string{"0", "0", "9", "?", "*", "friL"}, "echo last friday"},
+		{[]string{"0", "0", "9", "?", "*", "mon-wed"}, "echo day range"},
+	}
+	if len(tasks) != len(expected) {
+		t.Fatalf("parsed extended task count mismatch:\nactual:   %#v\nexpected count: %d", tasks, len(expected))
+	}
+	for i, want := range expected {
+		if fields := strings.Fields(tasks[i].Expr); !reflect.DeepEqual(fields, want.exprFields) {
+			t.Fatalf("parsed extended expr fields mismatch at %d:\nactual:   %#v\nexpected: %#v\nfull task: %#v", i, fields, want.exprFields, tasks[i])
+		}
+		if tasks[i].Cmd != want.cmd {
+			t.Fatalf("parsed extended command mismatch at %d:\nactual:   %q\nexpected: %q\nfull task: %#v", i, tasks[i].Cmd, want.cmd, tasks[i])
+		}
+	}
+}
+
+func TestSkipsMalformedLinesAndLogsParseMessages(t *testing.T) {
+
+
+	logs := captureParserLogs(t)
+
+	tasks := tasker.MustParseTaskfile(tasker.Option{File: fixturePath("taskfile_malformed.txt")})
+
+	expectedTasks := []tasker.Task{
+		{Expr: "*/5 * * * *", Cmd: "echo ok"},
+	}
+	if !reflect.DeepEqual(tasks, expectedTasks) {
+		t.Fatalf("malformed fixture tasks mismatch:\nactual:   %#v\nexpected: %#v", tasks, expectedTasks)
+	}
+
+	expectedLogs := "[parser] can't parse cron expr: @invalid echo nope\n" +
+		"[parser] can't parse cron expr: * * * * *\n"
+	if logs.String() != expectedLogs {
+		t.Fatalf("parse logs mismatch:\nactual:   %q\nexpected: %q", logs.String(), expectedLogs)
+	}
+}
+
+func TestMissingTaskfileExitsWithStatusOne(t *testing.T) {
+	if os.Getenv("TST_MISSING_TASKFILE_CHILD") == "1" {
+		log.SetFlags(0)
+		log.SetPrefix("")
+		tasker.MustParseTaskfile(tasker.Option{File: fixturePath("definitely_missing_taskfile.txt")})
+		return
+	}
+
+	cmd := exec.Command(os.Args[0], "-test.run", "^TestMissingTaskfileExitsWithStatusOne$")
+	cmd.Env = append(os.Environ(), "TST_MISSING_TASKFILE_CHILD=1")
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+
+	err := cmd.Run()
+	exitErr, ok := err.(*exec.ExitError)
+	if !ok {
+		t.Fatalf("expected child process to exit with status 1, got err=%v", err)
+	}
+	if exitErr.ExitCode() != 1 {
+		t.Fatalf("expected child process exit status 1, got %d", exitErr.ExitCode())
+	}
+
+	expected := "[parser] can't open file: " + fixturePath("definitely_missing_taskfile.txt") + "\n"
+	if stderr.String() != expected {
+		t.Fatalf("open failure log mismatch:\nactual:   %q\nexpected: %q", stderr.String(), expected)
+	}
+}
+
+func TestReferentialTransparencyForUnchangedTaskfile(t *testing.T) {
+	first := tasker.MustParseTaskfile(tasker.Option{File: fixturePath("taskfile_extended.txt")})
+	second := tasker.MustParseTaskfile(tasker.Option{File: fixturePath("taskfile_extended.txt")})
+
+	if !reflect.DeepEqual(first, second) {
+		t.Fatalf("same taskfile parsed differently:\nfirst:  %#v\nsecond: %#v", first, second)
+	}
+}
+
+func TestDoesNotModifyTaskfile(t *testing.T) {
+	path := fixturePath("taskfile_basic.txt")
+	before, err := ioutil.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read fixture before parse: %v", err)
+	}
+
+	_ = tasker.MustParseTaskfile(tasker.Option{File: path})
+
+	after, err := ioutil.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read fixture after parse: %v", err)
+	}
+	if !bytes.Equal(after, before) {
+		t.Fatalf("taskfile content changed:\nafter:  %q\nbefore: %q", string(after), string(before))
+	}
+}
+
+func TestNoGlobalStateAcrossDifferentTaskfiles(t *testing.T) {
+	_ = captureParserLogs(t)
+
+	baseline := tasker.MustParseTaskfile(tasker.Option{File: fixturePath("taskfile_basic.txt")})
+	_ = tasker.MustParseTaskfile(tasker.Option{File: fixturePath("taskfile_aliases.txt")})
+	_ = tasker.MustParseTaskfile(tasker.Option{File: fixturePath("taskfile_malformed.txt")})
+	again := tasker.MustParseTaskfile(tasker.Option{File: fixturePath("taskfile_basic.txt")})
+
+	if !reflect.DeepEqual(again, baseline) {
+		t.Fatalf("basic taskfile changed after parsing other files:\nagain:    %#v\nbaseline: %#v", again, baseline)
+	}
+}
+
+func TestNoUndeclaredCwdSideEffects(t *testing.T) {
+	tmp, err := ioutil.TempDir("", "tasker-parser-cwd-*")
+	if err != nil {
+		t.Fatalf("create temp dir: %v", err)
+	}
+	defer os.RemoveAll(tmp)
+
+	oldCwd, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("get cwd: %v", err)
+	}
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatalf("chdir temp cwd: %v", err)
+	}
+	defer os.Chdir(oldCwd)
+
+	path := fixturePath("taskfile_aliases.txt")
+	before, err := ioutil.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read fixture before parse: %v", err)
+	}
+
+	tasks := tasker.MustParseTaskfile(tasker.Option{File: path})
+
+	after, err := ioutil.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read fixture after parse: %v", err)
+	}
+
+	if !bytes.Equal(after, before) {
+		t.Fatalf("taskfile content changed from different cwd:\nafter:  %q\nbefore: %q", string(after), string(before))
+	}
+	if len(tasks) != 12 || tasks[0].Expr != "@annually" || tasks[len(tasks)-1].Expr != "@everysecond" {
+		t.Fatalf("absolute taskfile parse from different cwd mismatch: %#v", tasks)
+	}
+}
