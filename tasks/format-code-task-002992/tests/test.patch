+
+
+def test_no_global_state_fresh_process_matches_in_process(tmp_path):
+    xml_dir = tmp_path / "xml"
+    xml_dir.mkdir()
+    _write_annotation(
+        xml_dir,
+        "fresh.xml",
+        "fresh.jpg",
+        61,
+        62,
+        [
+            _object_xml("Ryegrass", (1, 1, 2, 3)),
+            _object_xml("Turnip", (4, 5, 7, 9)),
+        ],
+    )
+    mapping = {"Ryegrass": 7, "Turnip": 9}
+    in_process = voc_to_coco(xml_dir, category_mapping=mapping)
+
+    script = f"""
+import json
+import pathlib
+import sys
+sys.path.insert(0, "/workspace/repo")
+from weedcoco.importers.voc import voc_to_coco
+out = voc_to_coco(
+    pathlib.Path({str(xml_dir)!r}),
+    category_mapping={{"Ryegrass": 7, "Turnip": 9}},
+)
+sys.stdout.write(json.dumps(out, sort_keys=True))
+"""
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        capture_output=True,
+    )
+
+    assert json.loads(completed.stdout) == in_process
+
+
+def test_no_undeclared_file_or_network_side_effects(tmp_path, monkeypatch):
+    workspace = tmp_path / "workspace"
+    xml_dir = workspace / "xml"
+    workspace.mkdir()
+    xml_dir.mkdir()
+    _write_annotation(
+        xml_dir,
+        "pure.xml",
+        "pure.jpg",
+        71,
+        72,
+        [_object_xml("Ryegrass", (2, 3, 4, 5))],
+    )
+    before = _snapshot_tree(workspace)
+
+    def blocked_socket(*args, **kwargs):
+        raise AssertionError("voc_to_coco must not open network sockets")
+
+    monkeypatch.setattr(socket, "socket", blocked_socket)
+    monkeypatch.chdir(workspace)
+
+    actual = voc_to_coco(pathlib.Path("xml"))
+
+    assert actual == {
+        "images": [{"id": 0, "file_name": "pure.jpg", "width": 71, "height": 72}],
+        "annotations": [
+            {"id": 0, "image_id": 0, "category_id": 0, "bbox": [2, 3, 3, 3]}
+        ],
+        "info": {},
+        "categories": [{"id": 0, "name": "Ryegrass"}],
+    }
+    assert _snapshot_tree(workspace) == before
