+def test_referential_transparency_same_input_same_value(tmp_path):
+    xml_dir = tmp_path / "xml"
+    xml_dir.mkdir()
+    _write_annotation(
+        xml_dir,
+        "repeat.xml",
+        "repeat.jpg",
+        41,
+        42,
+        [_object_xml("Ryegrass", (3, 4, 8, 10))],
+    )
+    mapping = {"Ryegrass": 7}
+
+    assert voc_to_coco(xml_dir, category_mapping=mapping) == voc_to_coco(
+        xml_dir, category_mapping=mapping
+    )
+
+
+def test_does_not_mutate_caller_mapping(tmp_path):
+    xml_dir = tmp_path / "xml"
+    xml_dir.mkdir()
+    _write_annotation(
+        xml_dir,
+        "mapping.xml",
+        "mapping.jpg",
+        51,
+        52,
+        [_object_xml("Ryegrass", (1, 2, 4, 6))],
+    )
+    mapping = {"Ryegrass": 7, "Turnip": 9}
+    before = copy.deepcopy(mapping)
+
+    voc_to_coco(xml_dir, category_mapping=mapping)
+
