diff --git a/tests/integration_tests/test_mlflow.py b/tests/integration_tests/test_mlflow.py
index 9a5d3c81..0287bd14 100644
--- a/tests/integration_tests/test_mlflow.py
+++ b/tests/integration_tests/test_mlflow.py
@@ -144,3 +144,123 @@ def test_export_mlflow_local(tmpdir):
     output_path = os.path.join(tmpdir, "data/results/mlflow")
     export_mlflow(model_path, output_path)
     assert set(os.listdir(output_path)) == {"MLmodel", "model", "conda.yaml"}
+
+
+def _ensure_no_active_run():
+    while mlflow.active_run() is not None:
+        mlflow.end_run()
+
+
+def test_external_run_preserved_after_train_end(tmpdir):
+    """User starts mlflow run before calling Ludwig; the run must survive on_train_end."""
+    mlflow_uri = f"file://{tmpdir}/mlruns"
+    mlflow.set_tracking_uri(mlflow_uri)
+    _ensure_no_active_run()
+
+    external_exp_id = mlflow.create_experiment("external_titanic")
+    external_run = mlflow.start_run(experiment_id=external_exp_id, run_name="external_run_name")
+    external_run_id = external_run.info.run_id
+
+    try:
+        callback = MlflowCallback(log_artifacts=False)
+        callback.on_train_init(
+            base_config={},
+            experiment_name="ignored_name",
+            output_directory=str(tmpdir),
+            resume_directory=None,
+        )
+        callback.on_train_end(str(tmpdir))
+
+        active = mlflow.active_run()
+        assert active is not None, "External MLflow run was ended by callback"
+        assert active.info.run_id == external_run_id, (
+            "External MLflow run id changed after train: expected "
+            f"{external_run_id}, got {active.info.run_id}"
+        )
+    finally:
+        _ensure_no_active_run()
+
+
+def test_external_run_adopted_by_callback(tmpdir):
+    """Callback should adopt the externally-started run rather than start a new one."""
+    mlflow_uri = f"file://{tmpdir}/mlruns"
+    mlflow.set_tracking_uri(mlflow_uri)
+    _ensure_no_active_run()
+
+    mlflow.set_experiment("titanic")
+    external_run = mlflow.start_run(run_name="my_test_run")
+    external_run_id = external_run.info.run_id
+
+    try:
+        callback = MlflowCallback(log_artifacts=False)
+        callback.on_train_init(
+            base_config={},
+            experiment_name="titanic",
+            output_directory=str(tmpdir),
+            resume_directory=None,
+        )
+
+        assert callback.run is not None
+        assert callback.run.info.run_id == external_run_id, (
+            "Callback should adopt external run rather than start a new one"
+        )
+    finally:
+        _ensure_no_active_run()
+
+
+def test_no_external_run_callback_creates_and_ends_run(tmpdir):
+    """When no external run exists, callback creates its own and ends it at on_train_end."""
+    mlflow_uri = f"file://{tmpdir}/mlruns"
+    mlflow.set_tracking_uri(mlflow_uri)
+    _ensure_no_active_run()
+
+    callback = MlflowCallback(log_artifacts=False)
+    callback.on_train_init(
+        base_config={},
+        experiment_name="my_fresh_exp",
+        output_directory=str(tmpdir),
+        resume_directory=None,
+    )
+
+    assert callback.run is not None, "Callback should have started its own run"
+    assert callback.experiment_id is not None
+    own_run_id = callback.run.info.run_id
+
+    callback.on_train_end(str(tmpdir))
+
+    assert mlflow.active_run() is None, (
+        "Callback should have ended its own run since no external run was present"
+    )
+
+
+    finished_run = mlflow.get_run(own_run_id)
+    assert finished_run.info.status == "FINISHED"
+
+
+def test_external_run_status_remains_active(tmpdir):
+    """After train end, the external run's status must NOT be FINISHED."""
+    mlflow_uri = f"file://{tmpdir}/mlruns"
+    mlflow.set_tracking_uri(mlflow_uri)
+    _ensure_no_active_run()
+
+    external_exp_id = mlflow.create_experiment("status_check_exp")
+    external_run = mlflow.start_run(experiment_id=external_exp_id, run_name="status_check_run")
+    external_run_id = external_run.info.run_id
+
+    try:
+        callback = MlflowCallback(log_artifacts=False)
+        callback.on_train_init(
+            base_config={},
+            experiment_name="something",
+            output_directory=str(tmpdir),
+            resume_directory=None,
+        )
+        callback.on_train_end(str(tmpdir))
+
+
+        run = mlflow.get_run(external_run_id)
+        assert run.info.status == "RUNNING", (
+            f"External run should still be RUNNING; got status={run.info.status}"
+        )
+    finally:
+        _ensure_no_active_run()
