+from django.test import SimpleTestCase
+
+from wagtail.admin.search import SearchArea
+from wagtail.admin.widgets.button import Button
+
+
+class TestSearchAreaComparison(SimpleTestCase):
+    def _make(self, label="Search", url="/search/", order=1000):
+        return SearchArea(label=label, url=url, order=order)
+
+
+    def test_eq_same_order_and_label(self):
+        a = self._make(label="A", url="/a/", order=100)
+        b = self._make(label="A", url="/b/", order=100)
+
+        self.assertTrue(a == b)
+
+    def test_eq_different_order(self):
+        a = self._make(label="A", order=100)
+        b = self._make(label="A", order=200)
+        self.assertFalse(a == b)
+
+    def test_eq_different_label(self):
+        a = self._make(label="A", order=100)
+        b = self._make(label="B", order=100)
+        self.assertFalse(a == b)
+
+
+    def test_ne_inverse_of_eq(self):
+        a = self._make(label="A", order=100)
+        b = self._make(label="A", order=100)
+        c = self._make(label="A", order=200)
+        self.assertFalse(a != b)
+        self.assertTrue(a != c)
+
+
+    def test_lt_by_order(self):
+        a = self._make(label="A", order=100)
+        b = self._make(label="A", order=200)
+        self.assertTrue(a < b)
+        self.assertFalse(b < a)
+
+    def test_lt_by_label_when_order_equal(self):
+        a = self._make(label="A", order=100)
+        b = self._make(label="B", order=100)
+        self.assertTrue(a < b)
+        self.assertFalse(b < a)
+
+    def test_lt_equal_returns_false(self):
+        a = self._make(label="A", order=100)
+        b = self._make(label="A", order=100)
+        self.assertFalse(a < b)
+
+
+    def test_le_when_less(self):
+        a = self._make(label="A", order=100)
+        b = self._make(label="A", order=200)
+        self.assertTrue(a <= b)
+
+    def test_le_when_equal(self):
+        a = self._make(label="A", order=100)
+        b = self._make(label="A", order=100)
+        self.assertTrue(a <= b)
+
+    def test_le_when_greater(self):
+        a = self._make(label="A", order=200)
+        b = self._make(label="A", order=100)
+        self.assertFalse(a <= b)
+
+
+    def test_gt_by_order(self):
+        a = self._make(label="A", order=200)
+        b = self._make(label="A", order=100)
+        self.assertTrue(a > b)
+        self.assertFalse(b > a)
+
+    def test_gt_equal_returns_false(self):
+        a = self._make(label="A", order=100)
+        b = self._make(label="A", order=100)
+        self.assertFalse(a > b)
+
+
+    def test_ge_when_greater(self):
+        a = self._make(label="A", order=200)
+        b = self._make(label="A", order=100)
+        self.assertTrue(a >= b)
+
+    def test_ge_when_equal(self):
+        a = self._make(label="A", order=100)
+        b = self._make(label="A", order=100)
+        self.assertTrue(a >= b)
+
+    def test_ge_when_less(self):
+        a = self._make(label="A", order=100)
+        b = self._make(label="A", order=200)
+        self.assertFalse(a >= b)
+
+
+    def test_sorted_areas(self):
+        c = self._make(label="C", order=100)
+        a = self._make(label="A", order=200)
+        b = self._make(label="B", order=100)
+        result = sorted([a, c, b])
+
+        self.assertEqual(
+            [(item.order, item.label) for item in result],
+            [(100, "B"), (100, "C"), (200, "A")],
+        )
+
+
+    def test_eq_with_non_searcharea_is_false(self):
+        a = self._make(label="A", order=100)
+
+
+        self.assertFalse(a == "not-a-searcharea")
+        self.assertFalse(a == 42)
+        self.assertFalse(a == None)  # noqa: E711
+        self.assertTrue(a != "not-a-searcharea")
+
+    def test_lt_with_non_searcharea_raises_typeerror(self):
+        a = self._make(label="A", order=100)
+
+        with self.assertRaises(TypeError):
+            a < "not-a-searcharea"
+        with self.assertRaises(TypeError):
+            a <= 42
+        with self.assertRaises(TypeError):
+            a > object()
+        with self.assertRaises(TypeError):
+            a >= 3.14
+
+
+class TestButtonComparison(SimpleTestCase):
+    def _make(
+        self,
+        label="Btn",
+        url="/x/",
+        classes=None,
+        icon_name=None,
+        attrs=None,
+        priority=1000,
+    ):
+        return Button(
+            label=label,
+            url=url,
+            classes=set() if classes is None else set(classes),
+            icon_name=icon_name,
+            attrs={} if attrs is None else dict(attrs),
+            priority=priority,
+        )
+
+
+    def test_eq_when_all_fields_match(self):
+        a = self._make(label="A", url="/x/", classes=["c1"], attrs={"k": "v"}, priority=100)
+        b = self._make(label="A", url="/x/", classes=["c1"], attrs={"k": "v"}, priority=100)
+        self.assertTrue(a == b)
+        self.assertFalse(a != b)
+
+    def test_eq_differs_on_url_even_with_same_priority_label(self):
+
+
+        a = self._make(label="Same", url="/path-a/", priority=500)
+        b = self._make(label="Same", url="/path-b/", priority=500)
+        self.assertFalse(a == b)
+        self.assertTrue(a != b)
+
+    def test_eq_differs_on_classes(self):
+        a = self._make(label="Same", url="/x/", classes=["one"], priority=500)
+        b = self._make(label="Same", url="/x/", classes=["two"], priority=500)
+        self.assertFalse(a == b)
+
+    def test_eq_differs_on_attrs(self):
+        a = self._make(label="Same", url="/x/", attrs={"k": "v1"}, priority=500)
+        b = self._make(label="Same", url="/x/", attrs={"k": "v2"}, priority=500)
+        self.assertFalse(a == b)
+
+    def test_eq_differs_on_priority(self):
+        a = self._make(label="Same", url="/x/", priority=100)
+        b = self._make(label="Same", url="/x/", priority=200)
+        self.assertFalse(a == b)
+
+    def test_eq_differs_on_label(self):
+        a = self._make(label="A", url="/x/", priority=100)
+        b = self._make(label="B", url="/x/", priority=100)
+        self.assertFalse(a == b)
+
+
+    def test_lt_by_priority(self):
+        a = self._make(label="A", priority=100)
+        b = self._make(label="A", priority=200)
+        self.assertTrue(a < b)
+        self.assertFalse(b < a)
+
+    def test_lt_by_label_when_priority_equal(self):
+        a = self._make(label="A", priority=100)
+        b = self._make(label="B", priority=100)
+        self.assertTrue(a < b)
+        self.assertFalse(b < a)
+
+    def test_le_when_less_and_equal(self):
+        a = self._make(label="A", priority=100)
+        b = self._make(label="A", priority=200)
+        c = self._make(label="A", priority=100)
+        self.assertTrue(a <= b)
+
+        self.assertTrue(a <= c)
+        self.assertFalse(b <= a)
+
+    def test_gt_by_priority(self):
+        a = self._make(label="A", priority=200)
+        b = self._make(label="A", priority=100)
+        self.assertTrue(a > b)
+        self.assertFalse(b > a)
+
+    def test_ge_when_greater_and_equal(self):
+        a = self._make(label="A", priority=200)
+        b = self._make(label="A", priority=100)
+        c = self._make(label="A", priority=200)
+        self.assertTrue(a >= b)
+        self.assertTrue(a >= c)
+        self.assertFalse(b >= a)
+
+    def test_sorted_buttons(self):
+        a = self._make(label="A", priority=200)
+        b = self._make(label="B", priority=100)
+        c = self._make(label="C", priority=100)
+        result = sorted([a, c, b])
+        self.assertEqual(
+            [(item.priority, item.label) for item in result],
+            [(100, "B"), (100, "C"), (200, "A")],
+        )
+
+
+    def test_eq_with_non_button_is_false(self):
+        a = self._make(label="A", priority=100)
+        self.assertFalse(a == "not-a-button")
+        self.assertFalse(a == 42)
+        self.assertFalse(a == None)  # noqa: E711
+        self.assertTrue(a != "not-a-button")
+
+    def test_lt_with_non_button_raises_typeerror(self):
+        a = self._make(label="A", priority=100)
+        with self.assertRaises(TypeError):
+            a < "not-a-button"
+        with self.assertRaises(TypeError):
+            a <= 42
+        with self.assertRaises(TypeError):
+            a > object()
+        with self.assertRaises(TypeError):
+            a >= 3.14
