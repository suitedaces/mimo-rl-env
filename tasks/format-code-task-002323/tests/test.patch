+"use strict";
+
+const prettier = require("prettier/local");
+const yaml = require("js-yaml");
+
+function format(src, opts) {
+  return prettier.format(src, Object.assign({ parser: "yaml" }, opts || {}));
+}
+
+
+
+
+
+
+
+
+test("yaml quoteDouble with mixed quotes (issue case) produces valid YAML for the original value", () => {
+
+  const input = '"\'a\\"b"\n';
+  const output = format(input);
+  expect(yaml.safeLoad(output)).toBe('\'a"b');
+});
+
+test("yaml quoteDouble with mixed quotes (multiple singles) produces valid YAML for the original value", () => {
+
+  const input = '"\'\\"\'"\n';
+  const output = format(input);
+  expect(yaml.safeLoad(output)).toBe('\'"\'');
+});
+
+test("yaml quoteDouble re-formatting the issue input is idempotent and stays valid YAML", () => {
+  const input = '"\'a\\"b"\n';
+  const once = format(input);
+
+  expect(format(once)).toBe(once);
+
+  expect(yaml.safeLoad(once)).toBe('\'a"b');
+});
+
+test("yaml quoteDouble with only double quotes is wrapped in single quotes (preservation)", () => {
+
+  const input = '"only\\"quotes"\n';
+  expect(format(input)).toBe("'only\"quotes'\n");
+});
+
+test("yaml quoteDouble with only a single quote stays double-quoted (preservation)", () => {
+
+  const input = "\"a'b\"\n";
+  expect(format(input)).toBe("\"a'b\"\n");
+});
+
+test("yaml quoteDouble plain ASCII content stays double-quoted (preservation)", () => {
+  const input = '"hello"\n';
+  expect(format(input)).toBe('"hello"\n');
+});
+
+test("yaml quoteSingle with only a single quote converts to double-quoted (preservation)", () => {
+
+  const input = "'a''b'\n";
+  expect(format(input)).toBe("\"a'b\"\n");
+});
+
+
+
+
+
+
+
+test("yaml quoteSingle with mixed quotes preserves the original string value", () => {
+
+  const input = "'a\"''b'\n";
+  const output = format(input);
+  expect(yaml.safeLoad(output)).toBe('a"\'b');
+});
