--- /dev/null
+++ b/usercase-test-coderl/scroll_area_acceptance_test.go
@@ -0,0 +1,203 @@
+package usercase_test_coderl
+
+import (
+	"fmt"
+	"image"
+	"strings"
+	"testing"
+
+	tui "github.com/marcusolsson/tui-go"
+)
+
+type probeWidget struct {
+	tui.WidgetBase
+	hint image.Point
+}
+
+func (p *probeWidget) MinSizeHint() image.Point { return image.Point{} }
+func (p *probeWidget) SizeHint() image.Point    { return p.hint }
+
+func renderWidget(w tui.Widget, size image.Point) string {
+	surface := tui.NewTestSurface(size.X, size.Y)
+	painter := tui.NewPainter(surface, tui.NewTheme())
+	w.Resize(size)
+	w.Draw(painter)
+	return surface.String()
+}
+
+func renderedRows(w tui.Widget, size image.Point) []string {
+	raw := strings.Trim(renderWidget(w, size), "\n")
+	if raw == "" {
+		return nil
+	}
+	lines := strings.Split(raw, "\n")
+	rows := make([]string, len(lines))
+	for i, line := range lines {
+		rows[i] = line
+	}
+	return rows
+}
+
+func requireRowPrefixes(t *testing.T, label string, w tui.Widget, size image.Point, want []string) {
+	t.Helper()
+	got := renderedRows(w, size)
+	if len(got) != len(want) {
+		t.Fatalf("%s rows = %#v", label, got)
+	}
+	for i := range want {
+		if !strings.HasPrefix(got[i], want[i]) {
+			t.Fatalf("%s row %d = %q, want prefix %q (all rows %#v)", label, i, got[i], want[i], got)
+		}
+		for _, r := range got[i][len(want[i]):] {
+			if r != '.' && r != ' ' {
+				t.Fatalf("%s row %d = %q, got non-filler content after %q (all rows %#v)", label, i, got[i], want[i], got)
+			}
+		}
+	}
+}
+
+func rowList() *tui.Box {
+	box := tui.NewVBox()
+	for i := 0; i < 10; i++ {
+		box.Append(tui.NewLabel(fmt.Sprintf("row %d", i)))
+	}
+	return box
+}
+
+func TestScrollAreaHintsAndResizeChildToNaturalSize(t *testing.T) {
+
+
+	child := &probeWidget{hint: image.Point{X: 23, Y: 4}}
+	scroll := tui.NewScrollArea(child)
+	var _ tui.Widget = scroll
+
+
+	if scroll == nil {
+		t.Fatal("NewScrollArea returned nil")
+	}
+	if got := scroll.MinSizeHint(); got != (image.Point{X: 0, Y: 0}) {
+		t.Fatalf("MinSizeHint() = %#v", got)
+	}
+	if got := scroll.SizeHint(); got != (image.Point{X: 15, Y: 8}) {
+		t.Fatalf("SizeHint() = %#v", got)
+	}
+
+	scroll.Resize(image.Point{X: 10, Y: 2})
+
+	if got := child.Size(); got != (image.Point{X: 23, Y: 4}) {
+		t.Fatalf("child Size() after Resize = %#v", got)
+	}
+	if got := scroll.Size(); got != (image.Point{X: 10, Y: 2}) {
+		t.Fatalf("scroll Size() after Resize = %#v", got)
+	}
+}
+
+func TestScrollAreaVerticalViewportProgression(t *testing.T) {
+
+
+	scroll := tui.NewScrollArea(tui.NewVBox(
+		tui.NewLabel("foo"),
+		tui.NewLabel("bar"),
+		tui.NewLabel("test"),
+	))
+
+
+	requireRowPrefixes(t, "initial viewport", scroll, image.Point{X: 10, Y: 2}, []string{"foo", "bar"})
+
+	scroll.Scroll(0, 1)
+
+
+	requireRowPrefixes(t, "viewport after Scroll(0, 1)", scroll, image.Point{X: 10, Y: 2}, []string{"bar", "test"})
+}
+
+func TestScrollAreaHorizontalAndTwoDimensionalScroll(t *testing.T) {
+
+
+	horizontal := tui.NewScrollArea(tui.NewVBox(
+		tui.NewLabel("Lorem ipsum dolor sit amet, consectetur adipiscing elit."),
+	))
+
+
+	requireRowPrefixes(t, "initial horizontal viewport", horizontal, image.Point{X: 10, Y: 1}, []string{"Lorem ipsu"})
+
+	horizontal.Scroll(46, 0)
+
+
+	requireRowPrefixes(t, "horizontal viewport after Scroll(46, 0)", horizontal, image.Point{X: 10, Y: 1}, []string{"cing elit."})
+
+	twoDimensional := tui.NewScrollArea(rowList())
+	twoDimensional.Scroll(1, 2)
+
+
+	requireRowPrefixes(t, "two-dimensional viewport after Scroll(1, 2)", twoDimensional, image.Point{X: 10, Y: 3}, []string{"ow 2", "ow 3", "ow 4"})
+}
+
+func TestScrollAreaTopBottomPreserveHorizontalScroll(t *testing.T) {
+
+
+	scroll := tui.NewScrollArea(rowList())
+	scroll.Resize(image.Point{X: 10, Y: 3})
+
+	scroll.ScrollToBottom()
+
+	requireRowPrefixes(t, "viewport after ScrollToBottom()", scroll, image.Point{X: 10, Y: 3}, []string{"row 7", "row 8", "row 9"})
+
+	scroll.ScrollToTop()
+
+	requireRowPrefixes(t, "viewport after ScrollToTop()", scroll, image.Point{X: 10, Y: 3}, []string{"row 0", "row 1", "row 2"})
+
+	scroll.Scroll(2, 5)
+	scroll.ScrollToBottom()
+
+	requireRowPrefixes(t, "viewport after horizontal Scroll and ScrollToBottom()", scroll, image.Point{X: 10, Y: 3}, []string{"w 7", "w 8", "w 9"})
+
+	scroll.ScrollToTop()
+
+	requireRowPrefixes(t, "viewport after horizontal Scroll and ScrollToTop()", scroll, image.Point{X: 10, Y: 3}, []string{"w 0", "w 1", "w 2"})
+}
+
+func TestScrollAreaAutoscrollToggleControlsLaterResize(t *testing.T) {
+
+
+	scroll := tui.NewScrollArea(rowList())
+
+	scroll.SetAutoscrollToBottom(true)
+	scroll.Resize(image.Point{X: 10, Y: 3})
+
+	requireRowPrefixes(t, "viewport after SetAutoscrollToBottom(true) and Resize", scroll, image.Point{X: 10, Y: 3}, []string{"row 7", "row 8", "row 9"})
+
+	scroll.SetAutoscrollToBottom(false)
+	scroll.ScrollToTop()
+	scroll.Resize(image.Point{X: 10, Y: 3})
+
+	requireRowPrefixes(t, "viewport after SetAutoscrollToBottom(false), ScrollToTop, and Resize", scroll, image.Point{X: 10, Y: 3}, []string{"row 0", "row 1", "row 2"})
+}
+
+func TestScrollAreaInstancesKeepIndependentScrollState(t *testing.T) {
+
+
+	a := tui.NewScrollArea(rowList())
+	b := tui.NewScrollArea(rowList())
+
+	a.Scroll(1, 2)
+
+
+	requireRowPrefixes(t, "instance a viewport", a, image.Point{X: 10, Y: 3}, []string{"ow 2", "ow 3", "ow 4"})
+
+	requireRowPrefixes(t, "instance b viewport", b, image.Point{X: 10, Y: 3}, []string{"row 0", "row 1", "row 2"})
+}
+
+func TestScrollAreaRepeatedConstructUseDropPreservesPerInstanceBehavior(t *testing.T) {
+
+
+	for i := 0; i < 200; i++ {
+		scroll := tui.NewScrollArea(rowList())
+		scroll.Scroll(1, 2)
+
+		requireRowPrefixes(t, fmt.Sprintf("cycle %d viewport", i), scroll, image.Point{X: 10, Y: 3}, []string{"ow 2", "ow 3", "ow 4"})
+	}
+
+	fresh := tui.NewScrollArea(rowList())
+
+	requireRowPrefixes(t, "fresh instance viewport after repeated cycles", fresh, image.Point{X: 10, Y: 3}, []string{"row 0", "row 1", "row 2"})
+}
