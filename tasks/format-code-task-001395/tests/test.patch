 }
+
+func assertMultipleEnvsError(t *testing.T, err error, name string, envs ...string) {
+	t.Helper()
+	require.Error(t, err)
+
+	var multiple ErrMultipleEnvs
+	require.Truef(t, errors.As(err, &multiple), "expected ErrMultipleEnvs, got %T: %v", err, err)
+
+	v := reflect.ValueOf(multiple)
+	var gotName string
+	var gotEnvs []string
+	for i := 0; i < v.NumField(); i++ {
+		field := v.Field(i)
+		switch field.Kind() {
+		case reflect.String:
+			s := field.String()
+			if s == name {
+				gotName = s
+			}
+		case reflect.Slice:
+			if field.Type().Elem().Kind() == reflect.String {
+				values := make([]string, field.Len())
+				for i := range values {
+					values[i] = field.Index(i).String()
+				}
+				gotEnvs = values
+			}
+		}
+	}
+
+	if name == "" {
+		assert.Empty(t, gotName)
+	} else {
+		assert.Equal(t, name, gotName)
+	}
+	assert.ElementsMatch(t, envs, gotEnvs)
+}
