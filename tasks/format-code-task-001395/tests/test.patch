+func TestLoadSelectEnvironmentIncludesRequestedNameOnAmbiguousMatch(t *testing.T) {
+	_, err := Load("./testdata/cases/multiple-inline-envs", Opts{Name: "env1"})
+	assertMultipleEnvsError(t, err, "env1", "project1-env1", "project2-env1")
+
+	_, err = Load("./testdata/cases/multiple-inline-envs", Opts{Name: "project1"})
+	assertMultipleEnvsError(t, err, "project1", "project1-env1", "project1-env2")
+}
+
+func TestLoadEnvironmentFallsBackToNameFromCurrentDirectory(t *testing.T) {
+	cwd, err := os.Getwd()
+	require.NoError(t, err)
+
+	require.NoError(t, os.Chdir("./testdata/cases/multiple-inline-envs"))
+	t.Cleanup(func() {
+		require.NoError(t, os.Chdir(cwd))
+	})
+
+	_, err = Load("env1", Opts{})
+	assertMultipleEnvsError(t, err, "env1", "project1-env1", "project2-env1")
+
+	result, err := Load("project2", Opts{})
+	require.NoError(t, err)
+	assert.Equal(t, "project2-env1", result.Env.Metadata.Name)
+
+	result, err = Load("project1-env1", Opts{})
+	require.NoError(t, err)
+	assert.Equal(t, "project1-env1", result.Env.Metadata.Name)
+}
+
+func TestLoadEnvironmentDoesNotFallbackOnNonNotExistStatError(t *testing.T) {
+	cwd, err := os.Getwd()
+	require.NoError(t, err)
+
+	require.NoError(t, os.Chdir("./testdata/cases/multiple-inline-envs"))
+	t.Cleanup(func() {
+		require.NoError(t, os.Chdir(cwd))
+	})
+
+	invalidPath := "not-a-valid\x00path"
+	_, err = Load(invalidPath, Opts{})
+	require.Error(t, err)
+
+	var pathErr *fs.PathError
+	require.Truef(t, errors.As(err, &pathErr), "expected a filesystem path error, got %T: %v", err, err)
+	assert.False(t, os.IsNotExist(err), "invalid path errors must not be treated as missing paths")
+	assert.Equal(t, invalidPath, pathErr.Path)
+}
