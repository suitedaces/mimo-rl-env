+# -*- coding: utf-8 -*-
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+import pytest
+
+from hikari import channels
+from hikari import components
+from hikari import emojis
+from hikari.impl import special_endpoints
+
+
+def _component(row):
+    built = row.build()
+    assert built["type"] == components.ComponentType.ACTION_ROW
+    assert len(built["components"]) == 1
+    return built["components"][0]
+
+
+class TestAddInteractiveButton:
+    def test_returns_the_row_for_chaining(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        assert row.add_interactive_button(components.ButtonStyle.PRIMARY, "cid") is row
+
+    def test_minimal_serialization(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_interactive_button(components.ButtonStyle.SECONDARY, "cid")
+
+        assert _component(row) == {
+            "type": components.ComponentType.BUTTON,
+            "style": components.ButtonStyle.SECONDARY,
+            "disabled": False,
+            "custom_id": "cid",
+        }
+
+    def test_full_serialization_with_unicode_emoji(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_interactive_button(
+            components.ButtonStyle.DANGER, "cid", emoji="\N{THINKING FACE}", label="hello", is_disabled=True
+        )
+
+        assert _component(row) == {
+            "type": components.ComponentType.BUTTON,
+            "style": components.ButtonStyle.DANGER,
+            "disabled": True,
+            "label": "hello",
+            "emoji": {"name": "\N{THINKING FACE}"},
+            "custom_id": "cid",
+        }
+
+    def test_serialization_with_custom_emoji(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_interactive_button(components.ButtonStyle.PRIMARY, "cid", emoji=54321)
+
+        assert _component(row)["emoji"] == {"id": "54321"}
+
+    def test_appends_to_components(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_interactive_button(components.ButtonStyle.PRIMARY, "cid")
+        assert len(row.components) == 1
+
+
+class TestAddLinkButton:
+    def test_returns_the_row_for_chaining(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        assert row.add_link_button("https://example.com") is row
+
+    def test_serialization(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_link_button("https://example.com", label="click", is_disabled=True)
+
+        assert _component(row) == {
+            "type": components.ComponentType.BUTTON,
+            "style": components.ButtonStyle.LINK,
+            "disabled": True,
+            "label": "click",
+            "url": "https://example.com",
+        }
+
+    def test_serialization_with_custom_emoji(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_link_button("https://example.com", emoji=12345)
+
+        component = _component(row)
+        assert component["url"] == "https://example.com"
+        assert component["emoji"] == {"id": "12345"}
+        assert "custom_id" not in component
+
+
+class TestAddSelectMenu:
+    @pytest.mark.parametrize(
+        "type_",
+        [
+            components.ComponentType.USER_SELECT_MENU,
+            components.ComponentType.ROLE_SELECT_MENU,
+            components.ComponentType.MENTIONABLE_SELECT_MENU,
+        ],
+    )
+    def test_returns_the_row_for_chaining(self, type_):
+        row = special_endpoints.MessageActionRowBuilder()
+        assert row.add_select_menu(type_, "cid") is row
+
+    def test_minimal_serialization(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_select_menu(components.ComponentType.ROLE_SELECT_MENU, "cid")
+
+        assert _component(row) == {
+            "type": components.ComponentType.ROLE_SELECT_MENU,
+            "custom_id": "cid",
+            "min_values": 0,
+            "max_values": 1,
+            "disabled": False,
+        }
+
+    def test_full_serialization(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_select_menu(
+            components.ComponentType.MENTIONABLE_SELECT_MENU,
+            "cid",
+            placeholder="pick one",
+            min_values=2,
+            max_values=5,
+            is_disabled=True,
+        )
+
+        assert _component(row) == {
+            "type": components.ComponentType.MENTIONABLE_SELECT_MENU,
+            "custom_id": "cid",
+            "placeholder": "pick one",
+            "min_values": 2,
+            "max_values": 5,
+            "disabled": True,
+        }
+
+    def test_raises_on_invalid_type(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        with pytest.raises(ValueError):
+            row.add_select_menu(999999, "cid")
+
+
+class TestAddChannelMenu:
+    def test_returns_the_row_for_chaining(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        assert row.add_channel_menu("cid") is row
+
+    def test_minimal_serialization(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_channel_menu("cid")
+
+        component = _component(row)
+        assert component["type"] == components.ComponentType.CHANNEL_SELECT_MENU
+        assert component["custom_id"] == "cid"
+        assert component["min_values"] == 0
+        assert component["max_values"] == 1
+        assert component["disabled"] is False
+
+    def test_serialization_with_channel_types(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_channel_menu(
+            "cid",
+            channel_types=[channels.ChannelType.GUILD_TEXT, channels.ChannelType.GUILD_VOICE],
+            placeholder="where",
+            min_values=1,
+            max_values=2,
+            is_disabled=True,
+        )
+
+        assert _component(row) == {
+            "type": components.ComponentType.CHANNEL_SELECT_MENU,
+            "custom_id": "cid",
+            "placeholder": "where",
+            "min_values": 1,
+            "max_values": 2,
+            "disabled": True,
+            "channel_types": [channels.ChannelType.GUILD_TEXT, channels.ChannelType.GUILD_VOICE],
+        }
+
+
+class TestAddTextMenu:
+    def test_returns_the_menu_builder(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        menu = row.add_text_menu("cid")
+        assert menu is not row
+
+    def test_parent_references_the_row(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        menu = row.add_text_menu("cid")
+        assert menu.parent is row
+
+    def test_menu_is_attached_before_options_added(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_text_menu("cid")
+        assert len(row.components) == 1
+
+    def test_minimal_serialization(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_text_menu("cid")
+
+        assert _component(row) == {
+            "type": components.ComponentType.TEXT_SELECT_MENU,
+            "custom_id": "cid",
+            "min_values": 0,
+            "max_values": 1,
+            "disabled": False,
+            "options": [],
+        }
+
+    def test_serialization_with_settings(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_text_menu("cid", placeholder="pick", min_values=1, max_values=4, is_disabled=True)
+
+        component = _component(row)
+        assert component["placeholder"] == "pick"
+        assert component["min_values"] == 1
+        assert component["max_values"] == 4
+        assert component["disabled"] is True
+
+    def test_add_option_returns_the_menu_for_chaining(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        menu = row.add_text_menu("cid")
+        assert menu.add_option("label", "value") is menu
+
+    def test_add_option_minimal_serialization(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        menu = row.add_text_menu("cid")
+        menu.add_option("label", "value")
+
+        assert _component(row)["options"] == [{"label": "label", "value": "value", "default": False}]
+
+    def test_add_option_full_serialization(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        menu = row.add_text_menu("cid")
+        menu.add_option("label", "value", description="desc", emoji="\N{GRINNING FACE}", is_default=True)
+
+        assert _component(row)["options"] == [
+            {
+                "label": "label",
+                "value": "value",
+                "default": True,
+                "description": "desc",
+                "emoji": {"name": "\N{GRINNING FACE}"},
+            }
+        ]
+
+    def test_add_option_with_custom_emoji(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        menu = row.add_text_menu("cid")
+        menu.add_option("label", "value", emoji=98765)
+
+        assert _component(row)["options"][0]["emoji"] == {"id": "98765"}
+
+    def test_multiple_options_preserve_order(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        menu = row.add_text_menu("cid")
+        menu.add_option("a", "1").add_option("b", "2")
+
+        options = _component(row)["options"]
+        assert [opt["label"] for opt in options] == ["a", "b"]
+        assert [opt["value"] for opt in options] == ["1", "2"]
+
+    def test_round_trip_back_to_row(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        result = row.add_text_menu("cid").add_option("a", "1").parent
+        assert result is row
+
+
+class TestSingleComponentTypeConstraint:
+    def test_mixing_button_then_menu_raises(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_interactive_button(components.ButtonStyle.PRIMARY, "cid")
+        with pytest.raises(ValueError):
+            row.add_select_menu(components.ComponentType.USER_SELECT_MENU, "other")
+
+    def test_mixing_menu_then_button_raises(self):
+        row = special_endpoints.MessageActionRowBuilder()
+        row.add_text_menu("cid")
+        with pytest.raises(ValueError):
+            row.add_link_button("https://example.com")
