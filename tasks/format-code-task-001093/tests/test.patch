+++ b/tests/test_cookiejar_persistence_codespec.py
@@ -0,0 +1,133 @@
+import asyncio
+import pickle
+from collections import defaultdict
+from http.cookies import SimpleCookie
+
+import pytest
+from yarl import URL
+
+from aiohttp import CookieJar, cookiejar
+
+
+ORIGIN = URL("https://example.test/account")
+SUBDOMAIN = URL("https://api.example.test/account")
+
+
+def make_cookie_jar():
+    async def create():
+        return CookieJar()
+
+    return asyncio.run(create())
+
+
+def test_save_uses_a_versioned_persistence_envelope(tmp_path):
+    source = make_cookie_jar()
+    source.update_cookies(SimpleCookie("saved=value; Path=/"), ORIGIN)
+    path = tmp_path / "cookies.pickle"
+
+    source.save(path)
+
+    with path.open("rb") as file:
+        persisted = pickle.load(file)
+    assert isinstance(persisted, dict)
+    assert persisted["version"] == 1
+
+
+def test_save_load_preserves_host_only_and_domain_cookie_scope(tmp_path):
+    source = make_cookie_jar()
+    source.update_cookies(SimpleCookie("host_only=one; Path=/"), ORIGIN)
+    source.update_cookies(
+        SimpleCookie("domain_wide=two; Domain=example.test; Path=/"), ORIGIN
+    )
+
+    path = tmp_path / "cookies.pickle"
+    source.save(path)
+
+    restored = make_cookie_jar()
+    restored.load(path)
+
+    assert set(restored.filter_cookies(ORIGIN)) == {"host_only", "domain_wide"}
+    assert set(restored.filter_cookies(SUBDOMAIN)) == {"domain_wide"}
+
+
+def test_save_load_keeps_the_original_expiration_deadline(tmp_path, monkeypatch):
+    now = [1_000.0]
+    monkeypatch.setattr(cookiejar.time, "time", lambda: now[0])
+
+    source = make_cookie_jar()
+    source.update_cookies(SimpleCookie("temporary=value; Max-Age=10; Path=/"), ORIGIN)
+    path = tmp_path / "cookies.pickle"
+    source.save(path)
+
+    now[0] = 1_005.0
+    restored = make_cookie_jar()
+    restored.load(path)
+    assert "temporary" in restored.filter_cookies(ORIGIN)
+
+    now[0] = 1_011.0
+    assert "temporary" not in restored.filter_cookies(ORIGIN)
+
+
+def test_load_replaces_cookie_collection_and_cached_values(tmp_path):
+    source = make_cookie_jar()
+    source.update_cookies(
+        SimpleCookie("shared=fresh; Domain=example.test; Path=/"), ORIGIN
+    )
+    path = tmp_path / "cookies.pickle"
+    source.save(path)
+
+    target = make_cookie_jar()
+    target.update_cookies(SimpleCookie("shared=stale; Path=/"), ORIGIN)
+    target.update_cookies(SimpleCookie("old_only=remove-me; Path=/"), ORIGIN)
+    assert target.filter_cookies(ORIGIN)["shared"].value == "stale"
+
+    target.load(path)
+
+    filtered = target.filter_cookies(ORIGIN)
+    assert set(filtered) == {"shared"}
+    assert filtered["shared"].value == "fresh"
+    assert target.filter_cookies(SUBDOMAIN)["shared"].value == "fresh"
+
+
+def test_load_replaces_prior_expiration_schedule(tmp_path, monkeypatch):
+    now = [1_000.0]
+    monkeypatch.setattr(cookiejar.time, "time", lambda: now[0])
+
+    source = make_cookie_jar()
+    source.update_cookies(SimpleCookie("token=fresh; Path=/"), ORIGIN)
+    path = tmp_path / "cookies.pickle"
+    source.save(path)
+
+    target = make_cookie_jar()
+    target.update_cookies(SimpleCookie("token=stale; Max-Age=5; Path=/"), ORIGIN)
+    target.load(path)
+
+    now[0] = 1_006.0
+    assert target.filter_cookies(ORIGIN)["token"].value == "fresh"
+
+
+def test_load_accepts_legacy_cookie_mapping(tmp_path):
+    legacy = defaultdict(SimpleCookie)
+    legacy_cookie = SimpleCookie("legacy=value; Domain=example.test; Path=/")
+    legacy[("example.test", "")].update(legacy_cookie)
+    path = tmp_path / "legacy-cookies.pickle"
+    with path.open("wb") as file:
+        pickle.dump(legacy, file, pickle.HIGHEST_PROTOCOL)
+
+    restored = make_cookie_jar()
+    restored.load(path)
+
+    assert restored.filter_cookies(SUBDOMAIN)["legacy"].value == "value"
+
+
+def test_load_rejects_unsupported_data_without_changing_the_jar(tmp_path):
+    target = make_cookie_jar()
+    target.update_cookies(SimpleCookie("existing=value; Path=/"), ORIGIN)
+    path = tmp_path / "unsupported-cookies.pickle"
+    with path.open("wb") as file:
+        pickle.dump({"version": 999, "cookies": ()}, file, pickle.HIGHEST_PROTOCOL)
+
+    with pytest.raises(ValueError):
+        target.load(path)
+
+    assert target.filter_cookies(ORIGIN)["existing"].value == "value"
