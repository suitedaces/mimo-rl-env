+from textwrap import dedent
+
+import pytest
+
+from streamlink import Streamlink
+from streamlink.exceptions import PluginError
 from streamlink.plugins.nos import NOS
 from tests.plugins import PluginCanHandleUrl
 
@@ -7,6 +13,8 @@ class TestPluginCanHandleUrlNOS(PluginCanHandleUrl):
 
     should_match = [
         "https://nos.nl/live",
+        "https://nos.nl/l/2490404",
+        "https://nos.nl/collectie/13950-natuurramp-libie",
         "https://nos.nl/collectie/13781/livestream/2385081-ek-voetbal-engeland-schotland",
         "https://nos.nl/collectie/13951/video/2491092-dit-was-prinsjesdag",
         "https://nos.nl/video/2490788-meteoor-gespot-boven-noord-nederland",
@@ -19,4 +27,82 @@ class TestPluginCanHandleUrlNOS(PluginCanHandleUrl):
         "https://nos.nl/programmas",
         "https://nos.nl/uitzendingen",
         "https://nos.nl/uitzendingen/livestream/2385462",
+        "https://nos.nl/lifestyle",
+        "https://nos.nl/lijst-iets",
     ]
+
+
+_HLS_URL = "https://example.com/master.m3u8"
+
+_HTML_TEMPLATE = """
+<!DOCTYPE html>
+<html><head>
+<script type="application/ld+json">{json}</script>
+</head><body></body></html>
+"""
+
+
+def _make_html(type_value):
+    import json as _json
+
+    payload = {
+        "@type": type_value,
+        "encodingFormat": "application/vnd.apple.mpegurl",
+        "contentUrl": _HLS_URL,
+        "identifier": "12345",
+        "name": "Some title",
+    }
+    return dedent(_HTML_TEMPLATE).format(json=_json.dumps(payload))
+
+
+_PLAYLIST = "#EXTM3U\n#EXT-X-VERSION:3\n#EXT-X-STREAM-INF:BANDWIDTH=800000\nvariant.m3u8\n"
+
+
+class TestNOSSchema:
+    """Exercise _get_streams to verify the @type validation accepts both
+    a plain string and a list containing 'VideoObject'."""
+
+    URL = "https://nos.nl/live"
+
+    @pytest.fixture()
+    def plugin(self, requests_mock, session: Streamlink):
+
+        requests_mock.get(_HLS_URL, text=_PLAYLIST)
+        return NOS(session, self.URL)
+
+    def test_type_string_video_object_validates(self, plugin, requests_mock):
+
+
+        requests_mock.get(self.URL, text=_make_html("VideoObject"))
+        streams = plugin._get_streams()
+
+
+        assert plugin.id == "12345"
+        assert plugin.title == "Some title"
+
+        assert streams is not None
+
+    def test_type_list_with_video_object_validates(self, plugin, requests_mock):
+
+
+
+        requests_mock.get(self.URL, text=_make_html(["VideoObject", "WebPage"]))
+        streams = plugin._get_streams()
+        assert plugin.id == "12345"
+        assert plugin.title == "Some title"
+        assert streams is not None
+
+    def test_type_string_non_video_no_streams(self, plugin, requests_mock):
+
+
+
+
+
+        requests_mock.get(self.URL, text=_make_html("WebPage"))
+        try:
+            result = plugin._get_streams()
+        except PluginError:
+            return
+        assert result is None or not result, (
+            "Non-VideoObject @type must not yield streams"
+        )
