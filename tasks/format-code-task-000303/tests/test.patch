diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,186 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+export PIP_NO_INDEX=1
+export PIP_CONFIG_FILE=/dev/null
+
+INSTALL_LOG=$(mktemp)
+python -m pip uninstall --disable-pip-version-check -y scoary >"$INSTALL_LOG" 2>&1 || true
+if ! ( cd /workspace/repo && python -m pip install --disable-pip-version-check --no-index --no-build-isolation -e . --no-deps >"$INSTALL_LOG" 2>&1 ); then
+    echo "FAIL: build/install" >&2
+    cat "$INSTALL_LOG" >&2
+    rm -f "$INSTALL_LOG"
+    exit 1
+fi
+rm -f "$INSTALL_LOG"
+hash -r
+
+BIN=$(command -v vcf2scoary || true)
+[ -n "$BIN" ] || { echo "FAIL: vcf2scoary command is not installed" >&2; exit 1; }
+
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+cd "$TMP"
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+
+
+assert_csv_matches() {
+    local actual_file=$1
+    local expected_text=$2
+    local label=$3
+    ACTUAL_FILE="$actual_file" EXPECTED_TEXT="$expected_text" LABEL="$label" python - <<'PY'
+import collections
+import csv
+import io
+import os
+import re
+import sys
+
+actual_file = os.environ["ACTUAL_FILE"]
+expected_text = os.environ["EXPECTED_TEXT"]
+label = os.environ["LABEL"]
+with open(actual_file, newline="") as fh:
+    actual_text = fh.read()
+
+quoted_line = re.compile(r'^"[^"]*"(,"[^"]*")*$')
+for lineno, line in enumerate(actual_text.splitlines(), 1):
+    if not quoted_line.fullmatch(line):
+        print(f"{label} csv line {lineno} is not fully quoted: {line}", file=sys.stderr)
+        sys.exit(1)
+
+actual_rows = list(csv.reader(io.StringIO(actual_text)))
+expected_rows = list(csv.reader(io.StringIO(expected_text)))
+if not actual_rows:
+    print(f"{label} csv is empty", file=sys.stderr)
+    sys.exit(1)
+if actual_rows[0] != expected_rows[0]:
+    print(f"{label} csv header: {actual_rows[0]}", file=sys.stderr)
+    sys.exit(1)
+if collections.Counter(map(tuple, actual_rows[1:])) != collections.Counter(map(tuple, expected_rows[1:])):
+    print(f"{label} csv rows: {actual_rows[1:]}", file=sys.stderr)
+    sys.exit(1)
+PY
+}
+
+cat > mixed.vcf <<'EOF'
+##fileformat=VCFv4.1
+##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">
+##INFO=<ID=TYPE,Number=A,Type=String,Description="The type of allele.">
+#CHROM	POS	ID	REF	ALT	QUAL	FILTER	INFO	FORMAT	Reference	Strain_A	Strain_B	Strain_C
+NC_000962	4013	0	T	C	9999	0	TYPE=snp	GT	0:99	1:88	1:77	1:66
+NC_000962	4705	0	T	C,A	9999	0	TYPE=snp	GT	0	.	1	2
+NC_000962	5000	0	G	GA	9999	0	TYPE=ins	GT	0	1	0	1
+NC_000962	5100	0	GA	G	9999	0	TYPE=del	GT	1	0	1	0
+NC_000962	5200	0	A	T	9999	0	TYPE=complex	GT	1	1	0	0
+EOF
+
+cat > bad_number.vcf <<'EOF'
+##fileformat=VCFv4.1
+##FORMAT=<ID=GT,Number=2,Type=String,Description="Genotype">
+##INFO=<ID=TYPE,Number=A,Type=String,Description="The type of allele.">
+#CHROM	POS	ID	REF	ALT	QUAL	FILTER	INFO	FORMAT	Reference	Strain_A
+NC_000962	4013	0	T	C	9999	0	TYPE=snp	GT	0	1
+EOF
+
+EXPECTED_STDOUT='VCF version 4.1 detected
+Reached the end of the file'
+
+EXPECTED_ALL_CSV='"#CHROM","POS","ID","REF","ALT","QUAL","FILTER","INFO","FORMAT","DUMMY","Reference","Strain_A","Strain_B","Strain_C"
+"NC_000962","4013","0","T","C","9999","0","TYPE=snp","GT","False","0","1","1","1"
+"NC_000962","4705","0","T","C","9999","0","TYPE=snp","GT","True","0","0","1","0"
+"NC_000962","4705","0","T","A","9999","0","TYPE=snp","GT","True","0","0","0","1"
+"NC_000962","5000","0","G","GA","9999","0","TYPE=ins","GT","False","0","1","0","1"
+"NC_000962","5100","0","GA","G","9999","0","TYPE=del","GT","False","1","0","1","0"
+"NC_000962","5200","0","A","T","9999","0","TYPE=complex","GT","False","1","1","0","0"'
+
+EXPECTED_FILTERED_CSV='"#CHROM","POS","ID","REF","ALT","QUAL","FILTER","INFO","FORMAT","DUMMY","Reference","Strain_A","Strain_B","Strain_C"
+"NC_000962","4013","0","T","C","9999","0","TYPE=snp","GT","False","0","1","1","1"
+"NC_000962","4705","0","T","C","9999","0","TYPE=snp","GT","True","0","0","1","0"
+"NC_000962","4705","0","T","A","9999","0","TYPE=snp","GT","True","0","0","0","1"
+"NC_000962","5000","0","G","GA","9999","0","TYPE=ins","GT","False","0","1","0","1"
+"NC_000962","5100","0","GA","G","9999","0","TYPE=del","GT","False","1","0","1","0"'
+
+
+
+
+rm -f out err mutations_presence_absence.csv
+"$BIN" mixed.vcf >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED_STDOUT" ] || fail "F1 stdout: $(cat out)"
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+[ -f mutations_presence_absence.csv ] || fail "F1 default output file missing"
+
+assert_csv_matches mutations_presence_absence.csv "$EXPECTED_ALL_CSV" F1 || fail "F1 csv: $(cat mutations_presence_absence.csv)"
+
+
+
+
+rm -f out err custom.csv mutations_presence_absence.csv
+"$BIN" --out custom.csv mixed.vcf >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED_STDOUT" ] || fail "F2 stdout: $(cat out)"
+[ ! -s err ] || fail "F2 unexpected stderr: $(cat err)"
+[ -f custom.csv ] || fail "F2 custom output file missing"
+[ ! -e mutations_presence_absence.csv ] || fail "F2 unexpectedly wrote default output"
+
+assert_csv_matches custom.csv "$EXPECTED_ALL_CSV" F2 || fail "F2 csv: $(cat custom.csv)"
+
+
+
+
+rm -f out err filtered.csv
+"$BIN" --types snp,ins,del --out filtered.csv mixed.vcf >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED_STDOUT" ] || fail "F3 stdout: $(cat out)"
+[ ! -s err ] || fail "F3 unexpected stderr: $(cat err)"
+
+assert_csv_matches filtered.csv "$EXPECTED_FILTERED_CSV" F3 || fail "F3 csv: $(cat filtered.csv)"
+
+
+
+
+printf 'existing\n' > occupied.csv
+rm -f out err
+"$BIN" --out occupied.csv mixed.vcf >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F4 exit $ec; want non-zero"
+[ ! -s out ] || fail "F4 unexpected stdout: $(cat out)"
+[ "$(cat err)" = "Outfile already exists. Change name of outfile or run with --force" ] || fail "F4 stderr: $(cat err)"
+[ "$(cat occupied.csv)" = "existing" ] || fail "F4 existing file was overwritten"
+
+
+
+
+rm -f out err
+"$BIN" --force --out occupied.csv mixed.vcf >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED_STDOUT" ] || fail "F5 stdout: $(cat out)"
+[ ! -s err ] || fail "F5 unexpected stderr: $(cat err)"
+
+assert_csv_matches occupied.csv "$EXPECTED_ALL_CSV" F5 || fail "F5 csv: $(cat occupied.csv)"
+
+
+
+
+rm -f out err missing.csv
+"$BIN" --out missing.csv no_such.vcf >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F6 exit $ec; want non-zero"
+[ ! -s out ] || fail "F6 unexpected stdout: $(cat out)"
+[ "$(cat err)" = "Unable to locate input file no_such.vcf" ] || fail "F6 stderr: $(cat err)"
+[ ! -e missing.csv ] || fail "F6 wrote output for missing input"
+
+
+
+
+rm -f out err bad.csv
+"$BIN" --out bad.csv bad_number.vcf >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F7 exit $ec; want non-zero"
+
+! grep -qx 'Reached the end of the file' out || fail "F7 stdout reported successful completion: $(cat out)"
+[ "$(cat err)" = "ERROR: Expected a single allele per genotype. Scoary only works for haploid organisms." ] || fail "F7 stderr: $(cat err)"
+
+[ ! -s bad.csv ] || fail "F7 output should be empty after metadata rejection"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+export PIP_NO_INDEX=1
+export PIP_CONFIG_FILE=/dev/null
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
