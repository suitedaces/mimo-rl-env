+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+VENV="/opt/raiden-stage4a-venv"
+if [ ! -x "$VENV/bin/python" ]; then
+  echo "Missing staged offline venv at $VENV" >&2
+  exit 1
+fi
+
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+
+PYTHONPATH=/workspace/repo exec "$VENV/bin/python" -m pytest \
+  /workspace/repo/usercase-test-coderl/test_wal_stateful_acceptance.py -v
