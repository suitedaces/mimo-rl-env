diff --git a/usercase-test-coderl/test_subdomain_application.py b/usercase-test-coderl/test_subdomain_application.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_subdomain_application.py
@@ -0,0 +1,230 @@
+
+
+import web
+
+
+web.config.debug = False
+
+
+class HostA:
+    def GET(self):
+        return "a"
+
+
+class HostB:
+    def GET(self):
+        return "b"
+
+
+class HostWildcard:
+    def GET(self):
+        return "*"
+
+
+class CaptureHost:
+    def GET(self, subdomain, suffix):
+        return f"{subdomain}|{suffix}"
+
+
+class Tenant_alpha:
+    def GET(self, tenant):
+        return "alpha:" + tenant
+
+
+class Tenant_beta:
+    def GET(self, tenant):
+        return "beta:" + tenant
+
+
+class OnlyA:
+    def GET(self):
+        return "only-a"
+
+
+class OnlyB:
+    def GET(self):
+        return "only-b"
+
+
+class AddedA:
+    def GET(self):
+        return "added-a"
+
+
+def _single_route_app(handler_class):
+    return web.application(("/", handler_class), globals())
+
+
+def test_first_full_host_match_and_port_stripping_for_mounted_apps():
+
+
+
+
+    app = web.subdomain_application(
+        (
+            r"a\.example\.com",
+            _single_route_app(HostA),
+            r"b\.example\.com",
+            _single_route_app(HostB),
+            r".*\.example\.com",
+            _single_route_app(HostWildcard),
+        )
+    )
+
+    response = app.request("/", host="a.example.com")
+    assert response.status == "200 OK"
+    assert response.data == b"a"
+
+    response = app.request("/", host="b.example.com")
+    assert response.status == "200 OK"
+    assert response.data == b"b"
+
+    response = app.request("/", host="c.example.com")
+    assert response.status == "200 OK"
+    assert response.data == b"*"
+
+    response = app.request("/", host="a.example.com:8443")
+    assert response.status == "200 OK"
+    assert response.data == b"a"
+
+    response = app.request("/", host="a.example.com.evil")
+
+    assert response.status == "404 Not Found"
+    assert response.data == b"not found"
+
+
+def test_host_capture_groups_are_passed_to_handler_method():
+
+
+
+
+    app = web.subdomain_application(
+        (r"([a-z]+)\.capture\.(com|org)", CaptureHost)
+    )
+
+    response = app.request("/", host="alpha.capture.com")
+    assert response.status == "200 OK"
+    assert response.data == b"alpha|com"
+
+    response = app.request("/", host="beta.capture.org")
+    assert response.status == "200 OK"
+    assert response.data == b"beta|org"
+
+    response = app.request("/", host="alpha.capture.net")
+
+    assert response.status == "404 Not Found"
+    assert response.data == b"not found"
+
+
+def test_string_handler_targets_support_host_regex_substitution():
+
+
+
+
+    app = web.subdomain_application(
+        (r"(alpha|beta)\.string\.example\.com", r"Tenant_\1"), globals()
+    )
+
+    response = app.request("/", host="alpha.string.example.com")
+    assert response.status == "200 OK"
+    assert response.data == b"alpha:alpha"
+
+    response = app.request("/", host="beta.string.example.com")
+    assert response.status == "200 OK"
+    assert response.data == b"beta:beta"
+
+    response = app.request("/", host="gamma.string.example.com")
+
+    assert response.status == "404 Not Found"
+    assert response.data == b"not found"
+
+
+def test_no_matching_host_returns_normal_webpy_404():
+
+
+
+
+    app = web.subdomain_application((r"a\.example\.com", HostA))
+
+    response = app.request("/", host="missing.example.com")
+
+    assert response.status == "404 Not Found"
+    assert response.data == b"not found"
+
+
+def test_handle_dispatches_during_loaded_request_context():
+
+
+
+
+    app = web.subdomain_application((r"a\.example\.com", HostA))
+
+
+    response = app.request("/", host="a.example.com")
+    assert response.status == "200 OK"
+    assert response.data == b"a"
+
+
+def test_repeated_requests_keep_dispatching_correctly():
+
+
+
+
+    app = web.subdomain_application((r"a\.example\.com", HostA))
+
+    response = app.request("/", host="a.example.com")
+
+    assert response.status == "200 OK"
+    assert response.data == b"a"
+
+    response = app.request("/", host="a.example.com")
+
+    assert response.status == "200 OK"
+    assert response.data == b"a"
+
+
+def test_separate_subdomain_applications_keep_mappings_independent():
+
+
+
+
+    app_a = web.subdomain_application((r"only-a\.example\.com", OnlyA))
+    app_b = web.subdomain_application((r"only-b\.example\.com", OnlyB))
+    app_a.add_mapping(r"added\.example\.com", AddedA)
+
+    response = app_a.request("/", host="only-a.example.com")
+    assert response.status == "200 OK"
+    assert response.data == b"only-a"
+
+    response = app_a.request("/", host="only-b.example.com")
+    assert response.status == "404 Not Found"
+    assert response.data == b"not found"
+
+    response = app_a.request("/", host="added.example.com")
+    assert response.status == "200 OK"
+    assert response.data == b"added-a"
+
+    response = app_b.request("/", host="only-a.example.com")
+    assert response.status == "404 Not Found"
+    assert response.data == b"not found"
+
+    response = app_b.request("/", host="only-b.example.com")
+    assert response.status == "200 OK"
+    assert response.data == b"only-b"
+
+    response = app_b.request("/", host="added.example.com")
+    assert response.status == "404 Not Found"
+    assert response.data == b"not found"
+
+
+def test_repeated_construct_request_cycles_keep_dispatching_correctly():
+
+
+
+
+    for _ in range(100):
+        app = web.subdomain_application((r"a\.example\.com", HostA))
+        response = app.request("/", host="a.example.com")
+
+        assert response.status == "200 OK"
+        assert response.data == b"a"
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
