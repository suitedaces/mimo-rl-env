+    def _load_root_signed_dict(self):
+        """Returns a fresh copy of the signed-dict from the test root.json."""
+        root_path = os.path.join(self.repo_dir, 'metadata', 'root.json')
+        with open(root_path, 'r') as f:
+            data = json.load(f)
+        return data['signed']
+
+    def test_root_consistent_snapshot_missing_loads(self):
+
+        signed_dict = self._load_root_signed_dict()
+        signed_dict.pop('consistent_snapshot', None)
+
+        root = Root.from_dict(copy.deepcopy(signed_dict))
+
+        self.assertIsNone(root.consistent_snapshot)
+
+    def test_root_consistent_snapshot_missing_not_serialized(self):
+
+
+        signed_dict = self._load_root_signed_dict()
+        signed_dict.pop('consistent_snapshot', None)
+        root = Root.from_dict(copy.deepcopy(signed_dict))
+        output = root.to_dict()
+        self.assertNotIn('consistent_snapshot', output)
+
+    def test_root_consistent_snapshot_true_round_trip(self):
+        signed_dict = self._load_root_signed_dict()
+        signed_dict['consistent_snapshot'] = True
+        root = Root.from_dict(copy.deepcopy(signed_dict))
+        self.assertEqual(root.consistent_snapshot, True)
+        output = root.to_dict()
+        self.assertIn('consistent_snapshot', output)
+        self.assertEqual(output['consistent_snapshot'], True)
+
+    def test_root_consistent_snapshot_false_round_trip(self):
+        signed_dict = self._load_root_signed_dict()
+        signed_dict['consistent_snapshot'] = False
+        root = Root.from_dict(copy.deepcopy(signed_dict))
+        self.assertEqual(root.consistent_snapshot, False)
+        output = root.to_dict()
+        self.assertIn('consistent_snapshot', output)
+        self.assertEqual(output['consistent_snapshot'], False)
+
+    def test_root_consistent_snapshot_missing_full_round_trip(self):
+
+
+        signed_dict = self._load_root_signed_dict()
+        signed_dict.pop('consistent_snapshot', None)
+        root1 = Root.from_dict(copy.deepcopy(signed_dict))
+        intermediate = root1.to_dict()
+        self.assertNotIn('consistent_snapshot', intermediate)
+
+        root2 = Root.from_dict(copy.deepcopy(intermediate))
+        self.assertIsNone(root2.consistent_snapshot)
+        self.assertNotIn('consistent_snapshot', root2.to_dict())
+
