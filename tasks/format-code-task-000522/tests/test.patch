diff --git a/usercase-test-coderl/test_eos_detector.cpp b/usercase-test-coderl/test_eos_detector.cpp
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_eos_detector.cpp
@@ -0,0 +1,284 @@
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <sstream>
+#include <string>
+
+#include "src/tokenizer.hpp"
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+static const int EOS_TOKENS[2] = {10000, 10001};
+static const char *EOS_PIECES[2] = {"<eos>", "<stop>"};
+
+static void fail(const std::string &message) {
+    std::cerr << message << std::endl;
+    std::exit(1);
+}
+
+static void checkInt(const char *label, int actual, int expected) {
+    if (actual != expected) {
+        std::ostringstream out;
+        out << label << ": expected " << expected << ", got " << actual;
+        fail(out.str());
+    }
+}
+
+static void checkBool(const char *label, bool actual, bool expected) {
+    if (actual != expected) {
+        std::ostringstream out;
+        out << label << ": expected " << (expected ? "true" : "false")
+            << ", got " << (actual ? "true" : "false");
+        fail(out.str());
+    }
+}
+
+static void checkNull(const char *label, const char *actual) {
+    if (actual != nullptr) {
+        std::ostringstream out;
+        out << label << ": expected null, got \"" << actual << "\"";
+        fail(out.str());
+    }
+}
+
+static void checkString(const char *label, const char *actual, const char *expected) {
+    if (actual == nullptr || std::strcmp(actual, expected) != 0) {
+        std::ostringstream out;
+        out << label << ": expected \"" << expected << "\", got ";
+        if (actual == nullptr) {
+            out << "null";
+        } else {
+            out << "\"" << actual << "\"";
+        }
+        fail(out.str());
+    }
+}
+
+static void checkNullOrOneOf(const char *label, const char *actual, const char *expected1, const char *expected2 = nullptr) {
+
+    if (actual == nullptr || std::strcmp(actual, expected1) == 0 ||
+        (expected2 != nullptr && std::strcmp(actual, expected2) == 0)) {
+        return;
+    }
+
+    std::ostringstream out;
+    out << label << ": expected null or \"" << expected1 << "\"";
+    if (expected2 != nullptr) {
+        out << " or \"" << expected2 << "\"";
+    }
+    out << ", got \"" << actual << "\"";
+    fail(out.str());
+}
+
+static void checkLessOrEqual(const char *label, long actual, long expected) {
+    if (actual > expected) {
+        std::ostringstream out;
+        out << label << ": expected <= " << expected << ", got " << actual;
+        fail(out.str());
+    }
+}
+
+static long currentRssKiB() {
+    std::ifstream status("/proc/self/status");
+    std::string line;
+
+    while (std::getline(status, line)) {
+        std::istringstream parts(line);
+        std::string key;
+        long value = -1;
+        std::string unit;
+        parts >> key >> value >> unit;
+        if (key == "VmRSS:" && value >= 0) {
+            return value;
+        }
+    }
+    fail("could not read VmRSS from /proc/self/status");
+    return -1;
+}
+
+static void testEnumValues() {
+
+
+
+    checkBool("MAYBE_EOS differs from EOS", MAYBE_EOS != EOS, true);
+    checkBool("MAYBE_EOS differs from NOT_EOS", MAYBE_EOS != NOT_EOS, true);
+    checkBool("EOS differs from NOT_EOS", EOS != NOT_EOS, true);
+}
+
+static void testStreamingStopMarkerIsBufferedAndSuppressed() {
+
+
+    EosDetector detector(2, EOS_TOKENS, EOS_PIECES, 1, 1);
+
+    checkInt("append '<'", detector.append(1, "<"), MAYBE_EOS);
+    checkNullOrOneOf("delta after '<'", detector.getDelta(), "<");
+    checkInt("append 'eo'", detector.append(2, "eo"), MAYBE_EOS);
+    checkNullOrOneOf("delta after 'eo'", detector.getDelta(), "<eo");
+    checkInt("append 's>'", detector.append(3, "s>"), EOS);
+    checkNull("delta after complete '<eos>'", detector.getDelta());
+}
+
+static void testResetThenPaddedStopReturnsOnlyPrefixDelta() {
+
+
+    EosDetector detector(2, EOS_TOKENS, EOS_PIECES, 1, 1);
+
+    checkInt("append warmup 'x'", detector.append(7, "x"), NOT_EOS);
+    checkString("delta before reset", detector.getDelta(), "x");
+    detector.reset();
+    checkNull("delta immediately after reset", detector.getDelta());
+
+    checkInt("append '!<'", detector.append(1, "!<"), MAYBE_EOS);
+    checkNullOrOneOf("delta after '!<'", detector.getDelta(), "!", "!<");
+    checkInt("append 'eos'", detector.append(2, "eos"), MAYBE_EOS);
+    checkNullOrOneOf("delta after 'eos'", detector.getDelta(), "!", "!<eos");
+    checkInt("append '> '", detector.append(3, "> "), EOS);
+    checkString("delta after padded stop", detector.getDelta(), "!");
+}
+
+static void testFalseStopPrefixFlushesBufferedText() {
+
+
+    EosDetector detector(2, EOS_TOKENS, EOS_PIECES, 1, 1);
+
+    checkInt("append '<eo'", detector.append(1, "<eo"), MAYBE_EOS);
+    checkNullOrOneOf("delta after '<eo'", detector.getDelta(), "<eo");
+    checkInt("append 's>XY'", detector.append(2, "s>XY"), NOT_EOS);
+    checkString("delta after false stop", detector.getDelta(), "<eos>XY");
+}
+
+static void testNullPieceEosTokenPreservesPriorDeltaOnly() {
+
+
+    EosDetector detector(2, EOS_TOKENS, EOS_PIECES, 1, 1);
+
+    checkInt("append 'pre'", detector.append(7, "pre"), NOT_EOS);
+    checkString("delta before null EOS token", detector.getDelta(), "pre");
+    checkInt("append null EOS token", detector.append(10000, nullptr), EOS);
+    checkString("delta after null EOS token", detector.getDelta(), "pre");
+}
+
+static void testBareNullPieceEosTokenHasNullDelta() {
+
+
+    EosDetector detector(2, EOS_TOKENS, EOS_PIECES, 1, 1);
+
+    checkInt("append bare null EOS token", detector.append(10001, nullptr), EOS);
+    checkNull("delta after bare null EOS token", detector.getDelta());
+}
+
+static void testResetClearsBufferedTextForNextWindow() {
+
+
+    EosDetector detector(2, EOS_TOKENS, EOS_PIECES, 1, 1);
+
+    checkInt("append first window text", detector.append(7, "x"), NOT_EOS);
+    checkString("first window delta", detector.getDelta(), "x");
+    detector.reset();
+    detector.reset();
+    checkNull("delta after repeated reset", detector.getDelta());
+    checkInt("append second window text", detector.append(8, "y"), NOT_EOS);
+    checkString("second window delta", detector.getDelta(), "y");
+}
+
+static void testIsEosReportsConfiguredTokenIdsOnly() {
+
+
+    EosDetector detector(2, EOS_TOKENS, EOS_PIECES, 1, 1);
+
+    checkBool("isEos first configured token", detector.isEos(10000), true);
+    checkBool("isEos second configured token", detector.isEos(10001), true);
+    checkBool("isEos unconfigured token", detector.isEos(9999), false);
+}
+
+static void testSecondConfiguredStopPieceIsDetectedIndependently() {
+
+
+    EosDetector detector(2, EOS_TOKENS, EOS_PIECES, 1, 1);
+
+    checkInt("append '<' for stop", detector.append(1, "<"), MAYBE_EOS);
+    checkNullOrOneOf("delta after '<' for stop", detector.getDelta(), "<");
+    checkInt("append 'stop'", detector.append(2, "stop"), MAYBE_EOS);
+    checkNullOrOneOf("delta after 'stop'", detector.getDelta(), "<stop");
+    checkInt("append '> ' for stop", detector.append(3, "> "), EOS);
+    checkNull("delta after complete '<stop>'", detector.getDelta());
+}
+
+static void testIndependentInstancesKeepSeparateBuffers() {
+
+
+    EosDetector a(2, EOS_TOKENS, EOS_PIECES, 1, 1);
+    EosDetector b(2, EOS_TOKENS, EOS_PIECES, 1, 1);
+
+    checkInt("a append '!<'", a.append(1, "!<"), MAYBE_EOS);
+    checkInt("a append 'eos'", a.append(2, "eos"), MAYBE_EOS);
+    checkNullOrOneOf("a delta after two appends", a.getDelta(), "!", "!<eos");
+
+    checkInt("b append 'z'", b.append(9, "z"), NOT_EOS);
+    checkString("b delta after one append", b.getDelta(), "z");
+
+    checkInt("a append '> '", a.append(3, "> "), EOS);
+    checkString("a delta after completing stop", a.getDelta(), "!");
+    checkString("b delta remains independent", b.getDelta(), "z");
+}
+
+static void exerciseLargeDetectorOnce(const std::string &payload) {
+    EosDetector detector(2, EOS_TOKENS, EOS_PIECES, 1, 1);
+    checkInt("large append return", detector.append(42, payload.c_str()), NOT_EOS);
+    const char *delta = detector.getDelta();
+    if (delta == nullptr) {
+        fail("large append delta: expected payload, got null");
+    }
+    checkInt("large append delta length", static_cast<int>(std::strlen(delta)), 1048576);
+    checkInt("large append first byte", delta[0], 'L');
+    checkInt("large append last byte", delta[1048575], 'L');
+}
+
+static void testDestructorReleasesInternalBuffersAcrossCycles() {
+
+
+    const std::string payload(1048576, 'L');
+
+    for (int i = 0; i < 5; i++) {
+        exerciseLargeDetectorOnce(payload);
+    }
+
+    const long before = currentRssKiB();
+    for (int i = 0; i < 120; i++) {
+        exerciseLargeDetectorOnce(payload);
+    }
+    const long after = currentRssKiB();
+
+    checkLessOrEqual("VmRSS growth after 120 detector destruction cycles", after - before, 32768);
+}
+
+int main() {
+    testEnumValues();
+    testStreamingStopMarkerIsBufferedAndSuppressed();
+    testResetThenPaddedStopReturnsOnlyPrefixDelta();
+    testFalseStopPrefixFlushesBufferedText();
+    testNullPieceEosTokenPreservesPriorDeltaOnly();
+    testBareNullPieceEosTokenHasNullDelta();
+    testResetClearsBufferedTextForNextWindow();
+    testIsEosReportsConfiguredTokenIdsOnly();
+    testSecondConfiguredStopPieceIsDetectedIndependently();
+    testIndependentInstancesKeepSeparateBuffers();
+    testDestructorReleasesInternalBuffersAcrossCycles();
+
+    std::cout << "usercase EosDetector acceptance tests passed" << std::endl;
+    return 0;
+}
