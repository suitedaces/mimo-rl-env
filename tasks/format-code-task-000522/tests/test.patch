+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+CXX=${CXX:-g++}
+OUT=/tmp/usercase-eos-detector-test
+
+SOURCES=(/workspace/repo/usercase-test-coderl/test_eos_detector.cpp)
+
+
+
+while IFS= read -r src; do
+  case "$(basename "$src")" in
+    app.cpp|dllama-api.cpp|dllama.cpp|llm.cpp|*-test.cpp)
+      continue
+      ;;
+  esac
+  SOURCES+=("$src")
+done < <(find /workspace/repo/src -maxdepth 1 -type f -name '*.cpp' | sort)
+
+SOURCES+=(
+  /workspace/repo/src/nn/nn-cpu-ops.cpp
+  /workspace/repo/src/nn/nn-core.cpp
+  /workspace/repo/src/nn/nn-quants.cpp
+  /workspace/repo/src/nn/llamafile/sgemm.cpp
+)
+
+"$CXX" -std=c++11 -O0 -g -march=native -mtune=native \
+  -I/workspace/repo \
+  "${SOURCES[@]}" \
+  -lpthread \
+  -o "$OUT"
+
+exec "$OUT"
