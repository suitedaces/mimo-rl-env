diff --git a/tests/test_oauth2proxy_auth.py b/tests/test_oauth2proxy_auth.py
new file mode 100644
index 00000000..0af4f6e4
--- /dev/null
+++ b/tests/test_oauth2proxy_auth.py
@@ -0,0 +1,241 @@
+
+import pytest
+
+from tests.fixtures.client import client, test_app  # noqa
+
+
+def _base_env(**overrides):
+    env = {"AUTH_TYPE": "oauth2proxy"}
+    env.update(overrides)
+    return env
+
+
+@pytest.mark.parametrize(
+    "test_app",
+    [_base_env()],
+    indirect=True,
+)
+def test_admin_group_can_write(db_session, client, test_app):
+
+    headers = {
+        "x-forwarded-email": "admin@example.com",
+        "x-forwarded-groups": "admin",
+    }
+
+    response = client.get("/auth/users", headers=headers)
+    assert response.status_code == 200
+
+    response = client.post(
+        "/auth/users",
+        headers=headers,
+        json={"email": "someone@example.com", "role": "admin"},
+    )
+    assert response.status_code == 200
+
+
+@pytest.mark.parametrize(
+    "test_app",
+    [_base_env()],
+    indirect=True,
+)
+def test_noc_group_is_read_only(db_session, client, test_app):
+
+    headers = {
+        "x-forwarded-email": "noc@example.com",
+        "x-forwarded-groups": "noc",
+    }
+    response = client.get("/auth/users", headers=headers)
+    assert response.status_code == 200
+
+    response = client.post(
+        "/auth/users",
+        headers=headers,
+        json={"email": "someone@example.com", "role": "noc"},
+    )
+    assert response.status_code == 403
+
+
+@pytest.mark.parametrize(
+    "test_app",
+    [_base_env()],
+    indirect=True,
+)
+def test_missing_user_header_unauthorized(db_session, client, test_app):
+
+    response = client.get(
+        "/auth/users",
+        headers={"x-forwarded-groups": "admin"},
+    )
+    assert response.status_code == 401
+
+
+@pytest.mark.parametrize(
+    "test_app",
+    [_base_env()],
+    indirect=True,
+)
+def test_missing_groups_header_unauthorized(db_session, client, test_app):
+
+    response = client.get(
+        "/auth/users",
+        headers={"x-forwarded-email": "admin@example.com"},
+    )
+    assert response.status_code == 401
+
+
+@pytest.mark.parametrize(
+    "test_app",
+    [_base_env()],
+    indirect=True,
+)
+def test_unknown_group_forbidden(db_session, client, test_app):
+
+    response = client.get(
+        "/auth/users",
+        headers={
+            "x-forwarded-email": "nobody@example.com",
+            "x-forwarded-groups": "some-random-group,another-group",
+        },
+    )
+    assert response.status_code == 403
+
+
+@pytest.mark.parametrize(
+    "test_app",
+    [_base_env()],
+    indirect=True,
+)
+def test_role_precedence_admin_over_noc(db_session, client, test_app):
+
+    headers = {
+        "x-forwarded-email": "multi@example.com",
+        "x-forwarded-groups": "noc,admin",
+    }
+
+    response = client.post(
+        "/auth/users",
+        headers=headers,
+        json={"email": "someone@example.com", "role": "admin"},
+    )
+    assert response.status_code == 200
+
+
+    headers["x-forwarded-groups"] = "admin,noc"
+    response = client.post(
+        "/auth/users",
+        headers=headers,
+        json={"email": "someone2@example.com", "role": "admin"},
+    )
+    assert response.status_code == 200
+
+
+@pytest.mark.parametrize(
+    "test_app",
+    [_base_env(KEEP_OAUTH2_PROXY_USER_HEADER="x-user", KEEP_OAUTH2_PROXY_ROLE_HEADER="x-groups")],
+    indirect=True,
+)
+def test_configurable_headers(db_session, client, test_app):
+
+
+    response = client.get(
+        "/auth/users",
+        headers={
+            "x-forwarded-email": "admin@example.com",
+            "x-forwarded-groups": "admin",
+        },
+    )
+    assert response.status_code == 401
+
+
+    response = client.get(
+        "/auth/users",
+        headers={
+            "x-user": "admin@example.com",
+            "x-groups": "admin",
+        },
+    )
+    assert response.status_code == 200
+
+
+@pytest.mark.parametrize(
+    "test_app",
+    [
+        _base_env(
+            KEEP_OAUTH2_PROXY_ADMIN_ROLE="team-platform@example.com",
+            KEEP_OAUTH2_PROXY_NOC_ROLE="dept-engineering@example.com",
+            KEEP_OAUTH2_PROXY_WEBHOOK_ROLE="svc-webhook@example.com",
+        )
+    ],
+    indirect=True,
+)
+def test_custom_group_to_role_mapping(db_session, client, test_app):
+
+
+    response = client.post(
+        "/auth/users",
+        headers={
+            "x-forwarded-email": "lead@example.com",
+            "x-forwarded-groups": "all@example.com,team-platform@example.com",
+        },
+        json={"email": "someone@example.com", "role": "admin"},
+    )
+    assert response.status_code == 200
+
+
+    headers = {
+        "x-forwarded-email": "eng@example.com",
+        "x-forwarded-groups": "dept-engineering@example.com",
+    }
+    response = client.get("/auth/users", headers=headers)
+    assert response.status_code == 200
+    response = client.post(
+        "/auth/users",
+        headers=headers,
+        json={"email": "someone@example.com", "role": "noc"},
+    )
+    assert response.status_code == 403
+
+
+    response = client.post(
+        "/auth/users",
+        headers={
+            "x-forwarded-email": "both@example.com",
+            "x-forwarded-groups": "dept-engineering@example.com,team-platform@example.com",
+        },
+        json={"email": "someone@example.com", "role": "admin"},
+    )
+    assert response.status_code == 200
+
+
+@pytest.mark.parametrize(
+    "test_app",
+    [_base_env()],
+    indirect=True,
+)
+def test_auto_create_user_enabled_by_default(db_session, client, test_app):
+
+    headers = {
+        "x-forwarded-email": "newuser@example.com",
+        "x-forwarded-groups": "admin",
+    }
+    response = client.get("/auth/users", headers=headers)
+    assert response.status_code == 200
+    emails = [u["email"] for u in response.json()]
+    assert "newuser@example.com" in emails
+
+
+@pytest.mark.parametrize(
+    "test_app",
+    [_base_env(KEEP_OAUTH2_PROXY_AUTO_CREATE_USER="false")],
+    indirect=True,
+)
+def test_auto_create_user_disabled(db_session, client, test_app):
+
+    headers = {
+        "x-forwarded-email": "ghost@example.com",
+        "x-forwarded-groups": "admin",
+    }
+    response = client.get("/auth/users", headers=headers)
+    assert response.status_code == 200
+    emails = [u["email"] for u in response.json()]
+    assert "ghost@example.com" not in emails
