+#!/usr/bin/env bash
+set -u
+
+export LANG=C LC_ALL=C TZ=UTC
+export HF_HUB_DISABLE_PROGRESS_BARS=1
+export HF_HUB_OFFLINE=1
+export TRANSFORMERS_OFFLINE=1
+export TRANSFORMERS_NO_ADVISORY_WARNINGS=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+export PIP_NO_INDEX=1
+export SETUPTOOLS_SCM_PRETEND_VERSION_FOR_CACHE_DIT=0.0.0
+export SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0
+
+
+
+python -m pip install --disable-pip-version-check --no-index --no-build-isolation \
+  -e /workspace/repo --no-deps >/dev/null 2>&1 \
+  || { echo "FAIL: build" >&2; exit 1; }
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+python /workspace/repo/usercase-test-coderl/fixtures/make_assets.py "$TMP" \
+  >"$TMP/assets.env" 2>/dev/null \
+  || { echo "FAIL: asset setup" >&2; exit 1; }
+. "$TMP/assets.env"
+cd "$TMP"
+
+export PYTHONPATH="$SHIM${PYTHONPATH:+:$PYTHONPATH}"
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+
+
+
+cache-dit-metrics --help >"$TMP/out" 2>"$TMP/err"; ec=$?
+[ "$ec" -eq 0 ] || fail "H1 exit $ec; want 0"
+grep -qF "clip_score" "$TMP/out" || fail "H1 missing clip_score in help"
+
+python - "$TMP/out" <<'PY' || fail "H1 prompt flag help is incomplete"
+import re
+import sys
+
+lines = open(sys.argv[1], encoding="utf-8").read().splitlines()
+
+def blocks_for(long_flag):
+  for index, line in enumerate(lines):
+    if long_flag in line:
+      start = max(0, index - 1)
+      end = min(len(lines), index + 5)
+      yield "\n".join(lines[start:end])
+
+def has_alias(long_flag, short_flag):
+  short_re = re.compile(rf"(?<!\S){re.escape(short_flag)}(?![\w-])")
+  return any(short_re.search(block) for block in blocks_for(long_flag))
+
+def mentions_clip(long_flag):
+  return any(re.search(r"\bclip\b", block, re.IGNORECASE) for block in blocks_for(long_flag))
+
+if not has_alias("--prompt-true", "-p"):
+  raise SystemExit(1)
+if not has_alias("--ref-prompt-true", "-rp"):
+  raise SystemExit(1)
+if not mentions_clip("--prompt-true") or not mentions_clip("--ref-prompt-true"):
+  raise SystemExit(1)
+PY
+
+if [ -s "$TMP/err" ]; then
+  ! grep -Eiq "traceback|exception|error" "$TMP/err" || fail "H1 stderr contains failure"
+fi
+
+
+
+
+unset CLIP_MODEL_DIR
+cache-dit-metrics clip_score --prompt-true "$PROMPTS" --img-test "$IMAGES" >"$TMP/out" 2>"$TMP/err"; ec=$?
+[ "$ec" -eq 0 ] || fail "N1 exit $ec; want 0"
+grep -qF "prompts.txt vs images, Num: 2, CLIP_SCORE: 0.47403" "$TMP/out" || fail "N1 wrong stdout"
+
+if [ -s "$TMP/err" ]; then
+  ! grep -Eiq "traceback|exception|error" "$TMP/err" || fail "N1 stderr contains failure"
+fi
+
+
+
+
+export CLIP_MODEL_DIR="$OVERRIDE_MODEL"
+cache-dit-metrics clip_score --prompt-true "$PROMPTS" --img-test "$IMAGES" >"$TMP/out" 2>"$TMP/err"; ec=$?
+[ "$ec" -eq 0 ] || fail "N2 exit $ec; want 0"
+grep -qF "prompts.txt vs images, Num: 2, CLIP_SCORE: 0.44383" "$TMP/out" || fail "N2 wrong stdout"
+
+if [ -s "$TMP/err" ]; then
+  ! grep -Eiq "traceback|exception|error" "$TMP/err" || fail "N2 stderr contains failure"
+fi
+
+
+
+
+cache-dit-metrics clip_score --prompt-true "$EMPTY_PROMPTS" --img-test "$EMPTY_IMAGES" >"$TMP/out" 2>"$TMP/err"; ec=$?
+[ "$ec" -eq 0 ] || fail "N3 exit $ec; want 0"
+
+! grep -qF "CLIP_SCORE" "$TMP/out" || fail "N3 emitted CLIP_SCORE for zero pairs"
+
+if [ -s "$TMP/err" ]; then
+  ! grep -Eiq "traceback|exception|error" "$TMP/err" || fail "N3 stderr contains failure"
+fi
+
+
+
+
+export CLIP_MODEL_DIR="$OVERRIDE_MODEL"
+cache-dit-metrics clip_score --summary --ref-prompt-true "$SUMMARY_PROMPTS" --img-source-dir "$SOURCE_ROOT" >"$TMP/out" 2>"$TMP/err"; ec=$?
+[ "$ec" -eq 0 ] || fail "S1 exit $ec; want 0"
+
+python - "$TMP/out" <<'PY' || fail "S1 summary rows wrong"
+import re
+import sys
+
+rows = {}
+with open(sys.argv[1], encoding="utf-8") as f:
+  for lineno, line in enumerate(f, 1):
+    if "summary-prompts.txt" not in line or "CLIP_SCORE:" not in line:
+      continue
+    match = re.search(
+      r"summary-prompts\.txt\s+vs\s+([^,\s]+)\s*,\s*Num:\s*(\d+)\s*,\s*CLIP_SCORE:\s*([-+]?\d+(?:\.\d+)?)",
+      line,
+    )
+    if match:
+      rows[match.group(1)] = (lineno, int(match.group(2)), float(match.group(3)))
+
+if set(rows) != {"alpha", "beta"}:
+  raise SystemExit(1)
+if rows["alpha"][1] != 1 or rows["beta"][1] != 1:
+  raise SystemExit(1)
+if abs(rows["alpha"][2] - 1.1675) > 0.0006 or abs(rows["beta"][2] - 1.6165) > 0.0006:
+  raise SystemExit(1)
+if rows["beta"][0] >= rows["alpha"][0]:
+  raise SystemExit(1)
+PY
+
+grep -qiF "summary" "$TMP/out" || fail "S1 missing summary marker"
+grep -qF "CLIP_SCORE" "$TMP/out" || fail "S1 missing CLIP_SCORE summary output"
+
+if [ -s "$TMP/err" ]; then
+  ! grep -Eiq "traceback|exception|error" "$TMP/err" || fail "S1 stderr contains failure"
+fi
+
+echo "PASS"
