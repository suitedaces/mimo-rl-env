+++ b/mimo_test_command.sh
@@ -0,0 +1,29 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+
+mkdir -p /go/src/github.com/dshearer
+if [ ! -e /go/src/github.com/dshearer/jobber ]; then
+    ln -s /testbed /go/src/github.com/dshearer/jobber
+fi
+cd /go/src/github.com/dshearer/jobber
+
+
+case "${1:-}" in
+  base)
+    GOPATH=/go GO111MODULE=off go test -vet=off -v \
+      ./common ./jobber ./jobbermaster ./jobberrunner \
+      -run "TestLoadPrefs|TestShouldIncludeUser|TestParseDefaultPrefs|TestParseDefaultPrefsAfterUncommenting|TestParseDefaultJobfile|TestParseDefaultJobfileAfterUncommenting|TestNextRunTime"
+    ;;
+  new)
+    GOPATH=/go GO111MODULE=off go test -vet=off -count=1 -v \
+      ./jobber -run "TestLogCommand"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
