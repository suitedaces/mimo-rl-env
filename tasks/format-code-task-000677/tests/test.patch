+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
+export YARN_ENABLE_NETWORK=0
+export npm_config_audit=false
+export npm_config_fund=false
+export npm_config_offline=true
+
+VITEST_BIN=/workspace/repo/website/node_modules/.bin/vitest
+
+if [ ! -x "$VITEST_BIN" ] || [ ! -f /workspace/repo/website/node_modules/vitest/dist/cli.js ]; then
+  echo "Offline test dependencies are missing; website/node_modules must be preinstalled before this script runs." >&2
+  exit 127
+fi
+
+exec "$VITEST_BIN" run /workspace/repo/usercase-test-coderl/locale-routes.test.js --root /workspace/repo --environment node
