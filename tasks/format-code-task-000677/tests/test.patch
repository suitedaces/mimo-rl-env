diff --git a/usercase-test-coderl/locale-routes.test.js b/usercase-test-coderl/locale-routes.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/locale-routes.test.js
@@ -0,0 +1,166 @@
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import http from "node:http";
+import https from "node:https";
+import net from "node:net";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, test, vi } from "vitest";
+import { getRoutesForLang } from "../website/src/_utils/localeLinks.js";
+
+
+
+
+const modulePath = "/workspace/repo/website/src/_utils/localeLinks.js";
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+function expectRoutesUnordered(actual, expected) {
+
+  expect(actual).toHaveLength(expected.length);
+  expect(actual).toEqual(expect.arrayContaining(expected));
+}
+
+function snapshotDirectory(root) {
+  const entries = [];
+  const walk = (dir) => {
+    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+      const absolute = path.join(dir, entry.name);
+      const relative = path.relative(root, absolute);
+      entries.push(`${relative}${entry.isDirectory() ? "/" : ""}`);
+      if (entry.isDirectory()) {
+        walk(absolute);
+      }
+    }
+  };
+  walk(root);
+  return entries.sort();
+}
+
+describe("getRoutesForLang acceptance", () => {
+  test("english why page links to Spanish and Chinese equivalents", () => {
+
+
+    expect(getRoutesForLang("en", "why", false)).toEqual([
+      { label: "en español", lang: "es", path: "/es/why.html" },
+      { label: "中文", lang: "zh", path: "/zh/why.html" },
+    ]);
+  });
+
+  test("spanish resources page links to English root and Chinese subdirectory", () => {
+
+
+    expect(getRoutesForLang("es", "resources", false)).toEqual([
+      { label: "in english", lang: "en", path: "/resources.html" },
+      { label: "中文", lang: "zh", path: "/zh/resources.html" },
+    ]);
+  });
+
+  test("chinese how page links to English root and Spanish subdirectory", () => {
+
+
+
+    expectRoutesUnordered(getRoutesForLang("zh", "how", false), [
+      { label: "in english", lang: "en", path: "/how.html" },
+      { label: "en español", lang: "es", path: "/es/how.html" },
+    ]);
+  });
+
+  test("default isHomepage false preserves the requested page slug", () => {
+
+
+
+    expectRoutesUnordered(getRoutesForLang("es", "why"), [
+      { label: "in english", lang: "en", path: "/why.html" },
+      { label: "中文", lang: "zh", path: "/zh/why.html" },
+    ]);
+  });
+
+  test("homepage coercion treats an empty page as index for Chinese current page", () => {
+
+
+
+    expectRoutesUnordered(getRoutesForLang("zh", "", true), [
+      { label: "in english", lang: "en", path: "/index.html" },
+      { label: "en español", lang: "es", path: "/es/index.html" },
+    ]);
+  });
+
+  test("homepage coercion ignores a non-index slug when isHomepage is true", () => {
+
+
+
+    expectRoutesUnordered(getRoutesForLang("en", "resources", true), [
+      { label: "en español", lang: "es", path: "/es/index.html" },
+      { label: "中文", lang: "zh", path: "/zh/index.html" },
+    ]);
+  });
+
+  test("referential transparency returns the same value for the same inputs", () => {
+    expect(getRoutesForLang("en", "why", false)).toEqual(
+      getRoutesForLang("en", "why", false),
+    );
+  });
+
+  test("does not mutate caller-provided argument values", () => {
+    const args = ["zh", "", true];
+    const before = structuredClone(args);
+    getRoutesForLang(...args);
+    expect(args).toEqual(before);
+  });
+
+  test("fresh Node process returns the same value for identical inputs", () => {
+    const inProcess = getRoutesForLang("es", "resources", false);
+    const script = `
+      import { getRoutesForLang } from ${JSON.stringify(modulePath)};
+      process.stdout.write(JSON.stringify(getRoutesForLang("es", "resources", false)));
+    `;
+    const freshProcess = JSON.parse(
+      execFileSync(process.execPath, ["--input-type=module", "-e", script], {
+        encoding: "utf8",
+      }),
+    );
+    expect(freshProcess).toEqual(inProcess);
+  });
+
+  test("does not write files in cwd or use common network APIs", () => {
+    const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "locale-routes-"));
+    const previousCwd = process.cwd();
+    const networkError = () => {
+      throw new Error("network side effect");
+    };
+    const writeError = () => {
+      throw new Error("filesystem write side effect");
+    };
+    const originalOpenSync = fs.openSync;
+
+    vi.spyOn(fs, "writeFileSync").mockImplementation(writeError);
+    vi.spyOn(fs, "appendFileSync").mockImplementation(writeError);
+    vi.spyOn(fs, "createWriteStream").mockImplementation(writeError);
+    vi.spyOn(fs, "openSync").mockImplementation((target, flags, mode) => {
+      if (String(flags).match(/[wa+]/)) {
+        writeError();
+      }
+      return originalOpenSync(target, flags, mode);
+    });
+    vi.spyOn(net.Socket.prototype, "connect").mockImplementation(networkError);
+    vi.spyOn(http, "request").mockImplementation(networkError);
+    vi.spyOn(https, "request").mockImplementation(networkError);
+    vi.spyOn(globalThis, "fetch").mockImplementation(networkError);
+
+    try {
+      process.chdir(tempDir);
+      const before = snapshotDirectory(tempDir);
+      expect(getRoutesForLang("en", "why", false)).toEqual([
+        { label: "en español", lang: "es", path: "/es/why.html" },
+        { label: "中文", lang: "zh", path: "/zh/why.html" },
+      ]);
+      expect(snapshotDirectory(tempDir)).toEqual(before);
+    } finally {
+      process.chdir(previousCwd);
+      fs.rmSync(tempDir, { recursive: true, force: true });
+    }
+  });
+});
