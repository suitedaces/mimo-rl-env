diff --git a/tests/test_stopping.py b/tests/test_stopping.py
new file mode 100644
index 00000000..793ddbe7
--- /dev/null
+++ b/tests/test_stopping.py
@@ -0,0 +1,101 @@
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+import pandas as pd
+
+import asreview as asr
+from asreview.models.query import RandomQuery
+from asreview.stopping import StoppingNConsecutiveIrrelevant
+
+
+def _results(labels):
+
+    return pd.DataFrame({"label": labels})
+
+
+def test_stops_on_trailing_run():
+    stopper = StoppingNConsecutiveIrrelevant(3)
+
+    assert stopper.stop(_results([1, 1, 0, 0, 0]), list(range(10))) is True
+
+
+def test_exact_run_length_triggers():
+    stopper = StoppingNConsecutiveIrrelevant(2)
+    assert stopper.stop(_results([1, 0, 0]), list(range(10))) is True
+
+
+def test_does_not_stop_when_run_too_short():
+    stopper = StoppingNConsecutiveIrrelevant(3)
+
+    assert stopper.stop(_results([1, 0, 1, 0, 0]), list(range(10))) is False
+
+
+def test_run_must_be_contiguous_and_trailing():
+    stopper = StoppingNConsecutiveIrrelevant(3)
+
+
+    assert stopper.stop(_results([0, 0, 1, 0, 0, 1]), list(range(10))) is False
+
+
+def test_scattered_irrelevant_does_not_count():
+    stopper = StoppingNConsecutiveIrrelevant(3)
+
+    assert stopper.stop(_results([0, 1, 0, 1, 0, 1, 0]), list(range(10))) is False
+
+
+def test_not_enough_labeled_does_not_stop():
+    stopper = StoppingNConsecutiveIrrelevant(5)
+
+    assert stopper.stop(_results([0, 0]), list(range(20))) is False
+
+
+def test_stops_when_pool_exhausted_even_with_relevant_tail():
+    stopper = StoppingNConsecutiveIrrelevant(3)
+
+    labels = [1, 0, 1, 0, 1]
+    assert stopper.stop(_results(labels), list(range(len(labels)))) is True
+
+
+def test_stops_when_pool_exhausted_below_threshold():
+    stopper = StoppingNConsecutiveIrrelevant(10)
+
+    labels = [1, 1, 0]
+    assert stopper.stop(_results(labels), list(range(len(labels)))) is True
+
+
+def test_empty_data_stops():
+    stopper = StoppingNConsecutiveIrrelevant(3)
+    assert stopper.stop(_results([]), []) is True
+
+
+def test_returns_plain_bool():
+    stopper = StoppingNConsecutiveIrrelevant(2)
+    result = stopper.stop(_results([0, 0]), list(range(10)))
+    assert isinstance(result, bool)
+
+
+def test_integration_with_active_learning_cycle_stops():
+    cycle = asr.ActiveLearningCycle(
+        query_strategy=RandomQuery(),
+        stopping=StoppingNConsecutiveIrrelevant(3),
+    )
+    assert cycle.stop(_results([1, 0, 0, 0]), list(range(10))) is True
+
+
+def test_integration_with_active_learning_cycle_continues():
+    cycle = asr.ActiveLearningCycle(
+        query_strategy=RandomQuery(),
+        stopping=StoppingNConsecutiveIrrelevant(3),
+    )
+    assert cycle.stop(_results([1, 0, 1, 0]), list(range(10))) is False
