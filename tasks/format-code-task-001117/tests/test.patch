+<?php
+namespace PHPJava\Tests;
+
+use PHPJava\Exceptions\FormatterException;
+use PHPJava\Utilities\Formatter;
+use PHPUnit\Framework\TestCase;
+
+class DescriptorContractTest extends TestCase
+{
+    public function testParsesMixedMethodDescriptor(): void
+    {
+        $parsed = Formatter::parseSignature('(I[[Ljava/lang/String;Z)Ljava/util/Map;');
+
+        $this->assertSame(3, $parsed['arguments_count']);
+        $this->assertSame('int', $parsed['arguments'][0]['type']);
+        $this->assertSame(0, $parsed['arguments'][0]['deep_array']);
+        $this->assertSame('class', $parsed['arguments'][1]['type']);
+        $this->assertSame('java/lang/String', $parsed['arguments'][1]['class_name']);
+        $this->assertSame(2, $parsed['arguments'][1]['deep_array']);
+        $this->assertSame('boolean', $parsed['arguments'][2]['type']);
+        $this->assertSame('class', $parsed[0]['type']);
+        $this->assertSame('java/util/Map', $parsed[0]['class_name']);
+    }
+
+    public function testParsesEveryPrimitiveFieldDescriptor(): void
+    {
+        foreach ([
+            'B' => 'byte', 'C' => 'char', 'D' => 'double', 'F' => 'float',
+            'I' => 'int', 'J' => 'long', 'S' => 'short', 'Z' => 'boolean',
+        ] as $descriptor => $type) {
+            $parsed = Formatter::parseSignature($descriptor);
+            $this->assertSame($type, $parsed[0]['type'], $descriptor);
+            $this->assertSame(0, $parsed[0]['deep_array'], $descriptor);
+        }
+    }
+
+    public function testParsesObjectAndPrimitiveArrays(): void
+    {
+        $this->assertSame('int', Formatter::parseSignature('[I')[0]['type']);
+        $this->assertSame(1, Formatter::parseSignature('[I')[0]['deep_array']);
+
+        $parsed = Formatter::parseSignature('[[D');
+        $this->assertSame('double', $parsed[0]['type']);
+        $this->assertSame(2, $parsed[0]['deep_array']);
+
+        $parsed = Formatter::parseSignature('Ljava/util/Map$Entry;');
+        $this->assertSame('class', $parsed[0]['type']);
+        $this->assertSame('java/util/Map$Entry', $parsed[0]['class_name']);
+    }
+
+    public function testParsesVoidReturnAndEmptyArguments(): void
+    {
+        $parsed = Formatter::parseSignature('()V');
+        $this->assertSame([], $parsed['arguments']);
+        $this->assertSame(0, $parsed['arguments_count']);
+        $this->assertSame('void', $parsed[0]['type']);
+    }
+
+    public function testBuildsCanonicalArgumentDescriptorAndRoundTrips(): void
+    {
+        $signatures = [
+            ['type' => 'int', 'deep_array' => 0],
+            ['type' => 'class', 'class_name' => 'java.lang.String', 'deep_array' => 1],
+            ['type' => 'long', 'deep_array' => 2],
+        ];
+
+        $descriptor = Formatter::buildArgumentsSignature($signatures);
+
+        $this->assertSame('I[Ljava/lang/String;[[J', $descriptor);
+        $parsed = Formatter::parseSignature($descriptor);
+        $this->assertSame('int', $parsed[0]['type']);
+        $this->assertSame('class', $parsed[1]['type']);
+        $this->assertSame('java/lang/String', $parsed[1]['class_name']);
+        $this->assertSame(1, $parsed[1]['deep_array']);
+        $this->assertSame('long', $parsed[2]['type']);
+        $this->assertSame(2, $parsed[2]['deep_array']);
+    }
+
+    public function testAmbiguousPHPConversionPreservesArraysAndClasses(): void
+    {
+        $converted = Formatter::signatureConvertToAmbiguousForPHP([
+            ['type' => 'long', 'deep_array' => 1],
+            ['type' => 'double', 'deep_array' => 0],
+            ['type' => 'class', 'class_name' => 'java/lang/String', 'deep_array' => 0],
+        ]);
+
+        $this->assertSame('int', $converted[0]['type']);
+        $this->assertSame(1, $converted[0]['deep_array']);
+        $this->assertSame('float', $converted[1]['type']);
+        $this->assertSame('java/lang/String', $converted[2]['class_name']);
+    }
+
+    /**
+     * @dataProvider malformedFieldDescriptorProvider
+     */
+    public function testRejectsMalformedFieldDescriptors(string $descriptor): void
+    {
+        $this->expectException(FormatterException::class);
+        Formatter::parseSignature($descriptor);
+    }
+
+    public function malformedFieldDescriptorProvider(): array
+    {
+        return [
+            'empty' => [''],
+            'unknown field code' => ['Q'],
+            'unterminated class' => ['Ljava/lang/String'],
+            'trailing data' => ['I$I'],
+        ];
+    }
+
+    /**
+     * @dataProvider malformedMethodDescriptorProvider
+     */
+    public function testRejectsMalformedMethodDescriptors(string $descriptor): void
+    {
+        $this->expectException(FormatterException::class);
+        Formatter::parseSignature($descriptor);
+    }
+
+    public function malformedMethodDescriptorProvider(): array
+    {
+        return [
+            'missing method return' => ['(I)'],
+            'void argument' => ['(V)I'],
+            'missing close paren' => ['(I'],
+        ];
+    }
+}
