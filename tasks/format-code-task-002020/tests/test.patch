diff --git a/usercase-test-coderl/fixtures/probe_notebook_io.py b/usercase-test-coderl/fixtures/probe_notebook_io.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/fixtures/probe_notebook_io.py
@@ -0,0 +1,272 @@
+#!/usr/bin/env python3
+import argparse
+import asyncio
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+from src.app import Erys
+from src.cell import Cell
+from src.notebook import Notebook
+
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+
+
+class ProbeErys(Erys):
+    CSS_PATH = str(REPO_ROOT / "src" / "styles.tcss")
+
+    def __init__(self, paths: list[Path]) -> None:
+        super().__init__(paths)
+        self.probe_notices: list[dict[str, Any]] = []
+
+    def notify(
+        self,
+        message: str,
+        *,
+        title: str = "",
+        severity: str = "information",
+        timeout: float | None = None,
+        markup: bool = True,
+    ) -> None:
+        self.probe_notices.append(
+            {
+                "markup": markup,
+                "message": str(message),
+                "severity": severity,
+                "timeout": timeout,
+                "title": str(title),
+            }
+        )
+        return super().notify(
+            message,
+            title=title,
+            severity=severity,
+            timeout=timeout,
+            markup=markup,
+        )
+
+
+class FixtureKernel:
+    initialized = False
+
+    def get_kernel_info(self) -> dict[str, str]:
+        return {"name": "fixture-kernel"}
+
+    def get_kernel_spec(self) -> dict[str, str]:
+        return {
+            "display_name": "Fixture Python",
+            "language": "python",
+            "name": "fixture-python",
+        }
+
+    def get_language_info(self) -> dict[str, Any]:
+        return {
+            "file_extension": ".py",
+            "mimetype": "text/x-python",
+            "name": "python",
+            "pygments_lexer": "ipython3",
+            "version": "3.12-fixture",
+        }
+
+
+def canonical(value: Any) -> str:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"))
+
+
+def cell_summary(cell: Cell) -> dict[str, Any]:
+    return {
+        "class": type(cell).__name__,
+        "editable": bool(getattr(cell, "input_text", None))
+        and not bool(getattr(cell.input_text, "read_only", False)),
+        "exec_count": getattr(cell, "exec_count", None),
+        "id": getattr(cell, "_cell_id", None),
+        "next": getattr(cell.next, "_cell_id", None),
+        "outputs": getattr(cell, "outputs", None),
+        "prev": getattr(cell.prev, "_cell_id", None),
+        "source": cell.input_text.text,
+        "type": cell.cell_type,
+    }
+
+
+async def settle(pilot) -> None:
+    await pilot.pause(0.5)
+    await pilot.pause(0.5)
+
+
+def disable_kernel_startup() -> None:
+    os.environ.pop("VIRTUAL_ENV", None)
+    os.environ.pop("CONDA_PREFIX", None)
+
+
+def assert_required_saved_notebook(saved_json: dict[str, Any]) -> None:
+
+    required_top_level = {"metadata", "nbformat", "nbformat_minor", "cells"}
+    missing = required_top_level - set(saved_json)
+    assert not missing, f"saved notebook missing top-level fields: {sorted(missing)}"
+    assert isinstance(saved_json["metadata"], dict), "saved metadata must be an object"
+    assert isinstance(saved_json["cells"], list), "saved cells must be an array"
+
+
+    for key in ["kernel_info", "kernel_spec", "language_info"]:
+        assert key in saved_json["metadata"], f"saved metadata missing {key}"
+        assert isinstance(saved_json["metadata"][key], dict), f"{key} must be an object"
+
+
+def assert_saved_cells_match_editor(
+    saved_json: dict[str, Any], cells: list[Cell]
+) -> None:
+
+    assert len(saved_json["cells"]) == len(cells), "saved cell count must match editor"
+    for idx, (saved_cell, editor_cell) in enumerate(zip(saved_json["cells"], cells)):
+        assert saved_cell.get("cell_type") == editor_cell.cell_type, (
+            f"saved cell {idx} type does not match editor"
+        )
+        assert saved_cell.get("source") == editor_cell.input_text.text, (
+            f"saved cell {idx} source does not match editor"
+        )
+
+
+def assert_loaded_cells(cells: list[Cell], expected: list[dict[str, str]]) -> None:
+
+    assert len(cells) == len(expected), "loaded notebook cell count mismatch"
+    for idx, (cell, want) in enumerate(zip(cells, expected)):
+        assert cell.cell_type == want["cell_type"], f"loaded cell {idx} type mismatch"
+        assert cell.input_text.text == want["source"], f"loaded cell {idx} source mismatch"
+        assert not getattr(cell.input_text, "read_only", False), (
+            f"loaded cell {idx} is not editable"
+        )
+
+
+async def valid_open_save(args: argparse.Namespace) -> None:
+    disable_kernel_startup()
+    app = ProbeErys([args.notebook])
+    async with app.run_test(headless=True, size=(100, 40), notifications=True) as pilot:
+        await settle(pilot)
+        notebook = app.switcher.query_one("#tab0", Notebook)
+        cells = [
+            child for child in notebook.cell_container.children if isinstance(child, Cell)
+        ]
+        notebook.notebook_kernel = FixtureKernel()
+        notebook.save_notebook(args.output)
+
+        saved_text = args.output.read_text(encoding="utf-8")
+        saved_json = json.loads(saved_text)
+
+        assert_loaded_cells(
+            cells,
+            [
+                {"cell_type": "markdown", "source": "# Analysis\nInitial notes"},
+                {"cell_type": "code", "source": "x = 1 + 2\nprint(x)"},
+                {"cell_type": "markdown", "source": "Done."},
+            ],
+        )
+
+        assert notebook.last_focused is cells[0], "first loaded cell must have focus"
+        assert_required_saved_notebook(saved_json)
+        assert_saved_cells_match_editor(saved_json, cells)
+        assert Path(args.output).is_file(), "save path was not written"
+        print(
+            canonical(
+                {
+                    "cells": [cell_summary(cell) for cell in cells],
+                    "result": "ok",
+                }
+            )
+        )
+
+
+async def empty_open_save(args: argparse.Namespace) -> None:
+    disable_kernel_startup()
+    app = ProbeErys([args.notebook])
+    async with app.run_test(headless=True, size=(100, 40), notifications=True) as pilot:
+        await settle(pilot)
+        notebook = app.switcher.query_one("#tab0", Notebook)
+        cells = [
+            child for child in notebook.cell_container.children if isinstance(child, Cell)
+        ]
+        notebook.notebook_kernel = FixtureKernel()
+        notebook.save_notebook(args.output)
+        saved_json = json.loads(args.output.read_text(encoding="utf-8"))
+
+
+        assert cells == [], "empty notebook file should open with no cells"
+        assert notebook.last_focused is None, "empty notebook should not focus a loaded cell"
+        assert_required_saved_notebook(saved_json)
+        assert saved_json["cells"] == [], "empty notebook should save zero cells"
+        print(
+            canonical(
+                {
+                    "cells": [cell_summary(cell) for cell in cells],
+                    "result": "ok",
+                }
+            )
+        )
+
+
+async def invalid_json(args: argparse.Namespace) -> None:
+    disable_kernel_startup()
+    app = ProbeErys([args.notebook])
+    async with app.run_test(headless=True, size=(100, 40), notifications=True) as pilot:
+        await settle(pilot)
+        try:
+            notebook = app.switcher.query_one("#tab0", Notebook)
+        except Exception:
+            notebook = None
+        invalid_notices = [
+            notice
+            for notice in app.probe_notices
+            if "not a valid notebook. Failed to decode JSON." in notice["message"]
+        ]
+
+        expected_message = (
+            f"{args.notebook} is not a valid notebook. Failed to decode JSON."
+        )
+        assert any(
+            notice["message"] == expected_message and notice["severity"] == "error"
+            for notice in invalid_notices
+        ), "invalid JSON should notify with the mandated error"
+        assert notebook is None, "broken notebook tab should be closed"
+        assert str(args.notebook) not in app.path_to_tab_id, (
+            "broken notebook path should not remain registered"
+        )
+        assert str(args.notebook) not in [str(tab.label) for tab in app.tabs.query("Tab")], (
+            "broken notebook tab label should not remain open"
+        )
+        print(
+            canonical(
+                {
+                    "invalid_notices": invalid_notices,
+                    "result": "ok",
+                }
+            )
+        )
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    valid = subparsers.add_parser("valid-open-save")
+    valid.add_argument("notebook", type=Path)
+    valid.add_argument("output", type=Path)
+
+    empty = subparsers.add_parser("empty-open-save")
+    empty.add_argument("notebook", type=Path)
+    empty.add_argument("output", type=Path)
+
+    invalid = subparsers.add_parser("invalid-json")
+    invalid.add_argument("notebook", type=Path)
+
+    args = parser.parse_args()
+    if args.command == "valid-open-save":
+        asyncio.run(valid_open_save(args))
+    elif args.command == "empty-open-save":
+        asyncio.run(empty_open_save(args))
+    elif args.command == "invalid-json":
+        asyncio.run(invalid_json(args))
+
+
+if __name__ == "__main__":
+    main()
