+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+export PIP_NO_INDEX=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_ROOT_USER_ACTION=ignore
+export PYTHONNOUSERSITE=1
+
+
+
+PY=/opt/coderl-erys-venv/bin/python
+BIN=/opt/coderl-erys-venv/bin/erys
+
+[ -x "$PY" ] || { echo "FAIL: offline python not installed" >&2; exit 1; }
+[ -x "$BIN" ] || { echo "FAIL: erys entry point not installed" >&2; exit 1; }
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || exit 1
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+PROBE=/workspace/repo/usercase-test-coderl/fixtures/probe_notebook_io.py
+
+
+
+
+"$BIN" --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F0 exit $ec; want 0"
+
+[ -s out ] || fail "F0 help produced no stdout"
+grep -qi "notebook" out || fail "F0 help missing notebook keyword"
+[ ! -s err ] || fail "F0 unexpected stderr: $(cat err)"
+
+
+
+
+cp /workspace/repo/usercase-test-coderl/fixtures/mixed_analysis.ipynb analysis.ipynb
+"$PY" "$PROBE" valid-open-save analysis.ipynb saved-analysis.ipynb >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; stderr: $(cat err)"
+
+grep -q '"result":"ok"' out || fail "F1 probe did not report ok: $(cat out)"
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+
+
+
+
+: > empty.ipynb
+"$PY" "$PROBE" empty-open-save empty.ipynb saved-empty.ipynb >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; stderr: $(cat err)"
+
+grep -q '"result":"ok"' out || fail "F2 probe did not report ok: $(cat out)"
+[ ! -s err ] || fail "F2 unexpected stderr: $(cat err)"
+
+
+
+
+cp /workspace/repo/usercase-test-coderl/fixtures/broken.ipynb broken.ipynb
+"$PY" "$PROBE" invalid-json broken.ipynb >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; stderr: $(cat err)"
+
+grep -q '"result":"ok"' out || fail "F3 probe did not report ok: $(cat out)"
+[ ! -s err ] || fail "F3 unexpected stderr: $(cat err)"
+
+echo "PASS"
+exit 0
