+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export PIP_NO_INDEX=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+
+export PYTHONPATH="/workspace/repo/src:${PYTHONPATH:-}"
+python - <<'PY'
+import importlib
+
+required = [
+    "pytest",
+    "distributed",
+    "numpy",
+    "manifold3d",
+    "mapbox_earcut",
+    "mapbox",
+    "frozendict",
+    "datatrees",
+    "anchorscad_lib.linear",
+    "stl",
+    "OpenGL",
+    "pyglm",
+    "glm",
+    "HersheyFonts",
+    "fontTools",
+    "PIL",
+    "uharfbuzz",
+]
+
+missing = []
+for module_name in required:
+    try:
+        importlib.import_module(module_name)
+    except ImportError as exc:
+        missing.append(f"{module_name}: {exc}")
+
+if missing:
+    raise SystemExit("Missing offline Python dependencies:\n" + "\n".join(missing))
+PY
+exec python -m pytest /workspace/repo/usercase-test-coderl/test_module_lazy_union.py -v
