+declare(strict_types=1);
+
+namespace Tests\Unit\Core\Context;
+
+use PHPUnit\Framework\TestCase;
+use PrestaShop\PrestaShop\Core\Context\Employee;
+use PrestaShop\PrestaShop\Core\Context\EmployeeContext;
+use PrestaShop\PrestaShop\Core\Domain\Shop\ValueObject\ShopConstraint;
+
+class EmployeeContextMultiShopAuthorizationTest extends TestCase
+{
+    /**
+     * @dataProvider provideAllShopsCases
+     */
+    public function testHasAuthorizationForAllShops(
+        bool $hasEmployee,
+        bool $isSuperAdmin,
+        array $associatedShopIds,
+        array $allShopIds,
+        bool $expectedAuthorization
+    ): void {
+        $employee = $hasEmployee ? $this->mockEmployee($isSuperAdmin, $associatedShopIds) : null;
+        $employeeContext = new EmployeeContext($employee, $allShopIds);
+
+        $this->assertSame($expectedAuthorization, $employeeContext->hasAuthorizationForAllShops());
+    }
+
+    public function provideAllShopsCases(): iterable
+    {
+        yield 'no employee is never authorized' => [
+            false,
+            false,
+            [],
+            [1, 2, 3],
+            false,
+        ];
+
+        yield 'super admin is authorized for all shops' => [
+            true,
+            true,
+            [],
+            [1, 2, 3],
+            true,
+        ];
+
+        yield 'employee associated with every existing shop is authorized' => [
+            true,
+            false,
+            [1, 2, 3],
+            [1, 2, 3],
+            true,
+        ];
+
+        yield 'employee missing one existing shop is not authorized' => [
+            true,
+            false,
+            [1, 2],
+            [1, 2, 3],
+            false,
+        ];
+
+        yield 'employee associated with a superset of existing shops is authorized' => [
+            true,
+            false,
+            [1, 2, 3, 4],
+            [1, 2, 3],
+            true,
+        ];
+
+        yield 'logged in employee is trivially authorized when no shop exists' => [
+            true,
+            false,
+            [],
+            [],
+            true,
+        ];
+    }
+
+    public function testHasAuthorizationForAllShopsWithEmployeeOnlyConstruction(): void
+    {
+
+
+        $employeeContext = new EmployeeContext($this->mockEmployee(false, []));
+
+        $this->assertTrue($employeeContext->hasAuthorizationForAllShops());
+    }
+
+    public function testHasAuthorizationForAllShopsWithoutEmployeeAndEmployeeOnlyConstruction(): void
+    {
+        $employeeContext = new EmployeeContext(null);
+
+        $this->assertFalse($employeeContext->hasAuthorizationForAllShops());
+    }
+
+    public function testShopConstraintTargetingAuthorizedShop(): void
+    {
+        $employeeContext = new EmployeeContext($this->mockEmployee(false, [5, 7]), [5, 7, 9]);
+
+        $this->assertTrue($employeeContext->hasAuthorizationOnShopConstraint(ShopConstraint::shop(5)));
+    }
+
+    public function testShopConstraintTargetingUnauthorizedShop(): void
+    {
+        $employeeContext = new EmployeeContext($this->mockEmployee(false, [5, 7]), [5, 7, 9]);
+
+        $this->assertFalse($employeeContext->hasAuthorizationOnShopConstraint(ShopConstraint::shop(9)));
+    }
+
+    public function testShopConstraintTargetingAuthorizedShopGroup(): void
+    {
+        $employeeContext = new EmployeeContext($this->mockEmployee(false, [], [2, 4]), [1, 2, 3]);
+
+        $this->assertTrue($employeeContext->hasAuthorizationOnShopConstraint(ShopConstraint::shopGroup(2)));
+    }
+
+    public function testShopConstraintTargetingUnauthorizedShopGroup(): void
+    {
+        $employeeContext = new EmployeeContext($this->mockEmployee(false, [], [2, 4]), [1, 2, 3]);
+
+        $this->assertFalse($employeeContext->hasAuthorizationOnShopConstraint(ShopConstraint::shopGroup(3)));
+    }
+
+    public function testShopConstraintTargetingAllShopsWhenAuthorized(): void
+    {
+        $employeeContext = new EmployeeContext($this->mockEmployee(false, [1, 2, 3]), [1, 2, 3]);
+
+        $this->assertTrue($employeeContext->hasAuthorizationOnShopConstraint(ShopConstraint::allShops()));
+    }
+
+    public function testShopConstraintTargetingAllShopsWhenNotAuthorized(): void
+    {
+        $employeeContext = new EmployeeContext($this->mockEmployee(false, [1, 2]), [1, 2, 3]);
+
+        $this->assertFalse($employeeContext->hasAuthorizationOnShopConstraint(ShopConstraint::allShops()));
+    }
+
+    public function testShopConstraintIsAuthorizedForSuperAdmin(): void
+    {
+        $employeeContext = new EmployeeContext($this->mockEmployee(true, []), [1, 2, 3]);
+
+        $this->assertTrue($employeeContext->hasAuthorizationOnShopConstraint(ShopConstraint::shop(9)));
+        $this->assertTrue($employeeContext->hasAuthorizationOnShopConstraint(ShopConstraint::shopGroup(9)));
+        $this->assertTrue($employeeContext->hasAuthorizationOnShopConstraint(ShopConstraint::allShops()));
+    }
+
+    public function testShopConstraintIsNeverAuthorizedWithoutEmployee(): void
+    {
+        $employeeContext = new EmployeeContext(null, [1, 2, 3]);
+
+        $this->assertFalse($employeeContext->hasAuthorizationOnShopConstraint(ShopConstraint::shop(1)));
+        $this->assertFalse($employeeContext->hasAuthorizationOnShopConstraint(ShopConstraint::shopGroup(1)));
+        $this->assertFalse($employeeContext->hasAuthorizationOnShopConstraint(ShopConstraint::allShops()));
+    }
+
+    private function mockEmployee(bool $isSuperAdmin, array $associatedShopIds, array $associatedShopGroupIds = []): Employee
+    {
+        $employee = $this->createMock(Employee::class);
+        $employee
+            ->method('getProfileId')
+            ->willReturn($isSuperAdmin ? EmployeeContext::SUPER_ADMIN_PROFILE_ID : 42)
+        ;
+        $employee
+            ->method('getAssociatedShopIds')
+            ->willReturn($associatedShopIds)
+        ;
+        $employee
+            ->method('getAssociatedShopGroupIds')
+            ->willReturn($associatedShopGroupIds)
+        ;
+
+        return $employee;
+    }
+}
