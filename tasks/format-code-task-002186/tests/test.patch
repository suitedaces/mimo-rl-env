+++ b/mimo_test_command.sh
@@ -0,0 +1,60 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+if ! command -v redis-server >/dev/null 2>&1 || ! command -v redis-cli >/dev/null 2>&1; then
+  echo "redis-server and redis-cli must be installed in the image before offline test execution" >&2
+  exit 127
+fi
+
+export GOPROXY=off
+export GOSUMDB=off
+export GOMODCACHE="/go/pkg/mod"
+export GOCACHE="/workspace/repo/.gocache"
+export GOFLAGS="-mod=readonly"
+
+started_redis=0
+redis_tmp=""
+if ! redis-cli -h 127.0.0.1 -p 6380 ping >/dev/null 2>&1; then
+  redis_tmp="$(mktemp -d)"
+  redis-server \
+    --bind 127.0.0.1 \
+    --port 6380 \
+    --save "" \
+    --appendonly no \
+    --daemonize yes \
+    --pidfile "$redis_tmp/redis.pid" \
+    --dir "$redis_tmp" >/dev/null
+  started_redis=1
+fi
+
+cleanup() {
+  if [ "$started_redis" = "1" ]; then
+    redis-cli -h 127.0.0.1 -p 6380 shutdown nosave >/dev/null 2>&1 || true
+  fi
+  if [ -n "$redis_tmp" ]; then
+    rm -rf "$redis_tmp"
+  fi
+}
+trap cleanup EXIT
+
+for _ in $(seq 1 100); do
+  if redis-cli -h 127.0.0.1 -p 6380 ping >/dev/null 2>&1; then
+    break
+  fi
+  sleep 0.1
+done
+redis-cli -h 127.0.0.1 -p 6380 ping >/dev/null
+
+go test -v -count=1 ./usercase-test-coderl/...
