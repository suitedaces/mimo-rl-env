+func TestMemoryLayerMissesAndExpiryUseConcreteErrors(t *testing.T) {
+
+
+
+
+	ctx := context.Background()
+	layer := &data_layer.MemoryLayer{}
+	if err := layer.Init(&config.CacheConfig{CacheSize: 8, CacheTTL: 0}, "memory-miss"); err != nil {
+		t.Fatalf("Init() error = %v, want nil", err)
+	}
+
+	exists, err := layer.KeyExists(ctx, "user:missing")
+	if exists != false || err != nil {
+		t.Fatalf("KeyExists(user:missing) = (%v, %v), want (false, nil)", exists, err)
+	}
+	value, err := layer.GetValue(ctx, "user:missing")
+
+	if err == nil || err.Error() != "cannot get item" {
+		t.Fatalf("GetValue(user:missing) = (%q, %T, %v), want error message %q", value, err, err, "cannot get item")
+	}
+	batchExists, err := layer.BatchKeyExist(ctx, []string{"user:2", "user:3"})
+	if batchExists != false || err != nil {
+		t.Fatalf("BatchKeyExist(absent keys) = (%v, %v), want (false, nil)", batchExists, err)
+	}
+	values, err := layer.BatchGetValues(ctx, []string{"user:2", "user:missing"})
+
+	if err == nil || err.Error() != "cannot get items" {
+		t.Fatalf("BatchGetValues(absent keys) = (%q, %T, %v), want error message %q", values, err, err, "cannot get items")
+	}
+
+	ttlLayer := &data_layer.MemoryLayer{}
+	if err := ttlLayer.Init(&config.CacheConfig{CacheSize: 8, CacheTTL: 1}, "memory-ttl"); err != nil {
+		t.Fatalf("Init(ttl) error = %v, want nil", err)
+	}
+	if err := ttlLayer.SetKey(ctx, util.Kv{Key: "ttl:1", Value: "short"}); err != nil {
+		t.Fatalf("SetKey(ttl:1) error = %v, want nil", err)
+	}
+
+	deadline := time.Now().Add(1500 * time.Millisecond)
+	for {
+		exists, err = ttlLayer.KeyExists(ctx, "ttl:1")
+		if err != nil {
+			t.Fatalf("KeyExists(ttl:1) while waiting for expiry error = %v, want nil", err)
+		}
+		if !exists || time.Now().After(deadline) {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	exists, err = ttlLayer.KeyExists(ctx, "ttl:1")
+	if exists != false || err != nil {
+		t.Fatalf("expired KeyExists(ttl:1) = (%v, %v), want (false, nil)", exists, err)
+	}
+	value, err = ttlLayer.GetValue(ctx, "ttl:1")
+
+	if err == nil || err.Error() != "cannot get item" {
+		t.Fatalf("expired GetValue(ttl:1) = (%q, %T, %v), want error message %q", value, err, err, "cannot get item")
+	}
+}
