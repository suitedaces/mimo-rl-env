+	t.Helper()
+	exists, err := layer.KeyExists(ctx, key)
+	if exists != want || err != nil {
+		t.Fatalf("KeyExists(%s) = (%v, %v), want (%v, nil)", key, exists, err, want)
+	}
+}
+
+func newRedisClient(t *testing.T) *redis.Client {
+	t.Helper()
+	ctx := context.Background()
+	client := redis.NewClient(&redis.Options{Addr: redisAddr, DB: 14})
+	if err := client.Ping(ctx).Err(); err != nil {
+		client.Close()
+		t.Fatalf("Redis PING at %s error = %v, want nil", redisAddr, err)
+	}
+	if err := client.FlushDB(ctx).Err(); err != nil {
+		client.Close()
+		t.Fatalf("Redis FlushDB error = %v, want nil", err)
+	}
+	return client
+}
+
+func newRedisLayerWithClient(t *testing.T, ctx context.Context, client *redis.Client, prefix string) *data_layer.RedisLayer {
+	t.Helper()
+	layer := &data_layer.RedisLayer{}
+	err := layer.Init(&config.CacheConfig{
+		CacheSize: 32,
+		CacheTTL:  0,
+		RedisConfig: &config.RedisConfig{
+			Mode:   config.RedisConfigModeRaw,
+			Client: client,
+		},
+		DebugLogger: &config.DefaultLoggerImpl{},
+	}, prefix)
+	if err != nil {
+		t.Fatalf("RedisLayer.Init(%s) error = %v, want nil", prefix, err)
+	}
+	return layer
+}
