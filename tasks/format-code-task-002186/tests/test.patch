+func TestMemoryLayerSetBatchDeletePrefixAndCleanSession(t *testing.T) {
+
+
+
+
+	ctx := context.Background()
+	layer := &data_layer.MemoryLayer{}
+
+	if err := layer.Init(&config.CacheConfig{CacheSize: 32, CacheTTL: 0}, "memory-session"); err != nil {
+		t.Fatalf("Init() error = %v, want nil", err)
+	}
+	exists, err := layer.KeyExists(ctx, "user:1")
+	if exists != false || err != nil {
+		t.Fatalf("fresh KeyExists(user:1) = (%v, %v), want (false, nil)", exists, err)
+	}
+
+	if err := layer.SetKey(ctx, util.Kv{Key: "user:1", Value: "alice"}); err != nil {
+		t.Fatalf("SetKey(user:1) error = %v, want nil", err)
+	}
+	exists, err = layer.KeyExists(ctx, "user:1")
+	if exists != true || err != nil {
+		t.Fatalf("after SetKey KeyExists(user:1) = (%v, %v), want (true, nil)", exists, err)
+	}
+	value, err := layer.GetValue(ctx, "user:1")
+	if value != "alice" || err != nil {
+		t.Fatalf("after SetKey GetValue(user:1) = (%q, %v), want (%q, nil)", value, err, "alice")
+	}
+
+	if err := layer.BatchSetKeys(ctx, []util.Kv{{Key: "user:2", Value: "bob"}, {Key: "user:3", Value: "cara"}}); err != nil {
+		t.Fatalf("BatchSetKeys(user:2,user:3) error = %v, want nil", err)
+	}
+	batchExists, err := layer.BatchKeyExist(ctx, []string{"user:2", "user:3"})
+	if batchExists != true || err != nil {
+		t.Fatalf("after BatchSetKeys BatchKeyExist(user:2,user:3) = (%v, %v), want (true, nil)", batchExists, err)
+	}
+	values, err := layer.BatchGetValues(ctx, []string{"user:2", "user:3"})
+	if fmt.Sprintf("%q", values) != "[\"bob\" \"cara\"]" || err != nil {
+		t.Fatalf("after BatchSetKeys BatchGetValues(user:2,user:3) = (%q, %v), want ([\"bob\" \"cara\"], nil)", values, err)
+	}
+
+	if err := layer.DeleteKey(ctx, "user:1"); err != nil {
+		t.Fatalf("DeleteKey(user:1) error = %v, want nil", err)
+	}
+	exists, err = layer.KeyExists(ctx, "user:1")
+	if exists != false || err != nil {
+		t.Fatalf("after DeleteKey KeyExists(user:1) = (%v, %v), want (false, nil)", exists, err)
+	}
+
+	if err := layer.BatchDeleteKeys(ctx, []string{"user:2", "user:3"}); err != nil {
+		t.Fatalf("BatchDeleteKeys(user:2,user:3) error = %v, want nil", err)
+	}
+	batchExists, err = layer.BatchKeyExist(ctx, []string{"user:2", "user:3"})
+	if batchExists != false || err != nil {
+		t.Fatalf("after BatchDeleteKeys BatchKeyExist(user:2,user:3) = (%v, %v), want (false, nil)", batchExists, err)
+	}
+
+	if err := layer.SetKey(ctx, util.Kv{Key: "prefix:a", Value: "A"}); err != nil {
+		t.Fatalf("SetKey(prefix:a) error = %v, want nil", err)
+	}
+	if err := layer.SetKey(ctx, util.Kv{Key: "prefix:b", Value: "B"}); err != nil {
+		t.Fatalf("SetKey(prefix:b) error = %v, want nil", err)
+	}
+	if err := layer.SetKey(ctx, util.Kv{Key: "other:c", Value: "C"}); err != nil {
+		t.Fatalf("SetKey(other:c) error = %v, want nil", err)
+	}
+	if err := layer.DeleteKeysWithPrefix(ctx, "prefix"); err != nil {
+		t.Fatalf("DeleteKeysWithPrefix(prefix) error = %v, want nil", err)
+	}
+	assertMemoryExists(t, layer, ctx, "prefix:a", false)
+	assertMemoryExists(t, layer, ctx, "prefix:b", false)
+	assertMemoryExists(t, layer, ctx, "other:c", true)
+
+	if err := layer.CleanCache(ctx); err != nil {
+		t.Fatalf("CleanCache() error = %v, want nil", err)
+	}
+	assertMemoryExists(t, layer, ctx, "other:c", false)
+}
