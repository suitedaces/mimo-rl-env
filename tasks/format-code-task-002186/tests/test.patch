+func TestRedisLayerSetBatchDeletePrefixAndCleanSession(t *testing.T) {
+
+
+
+
+	ctx := context.Background()
+	client := newRedisClient(t)
+	defer client.Close()
+	layer := newRedisLayerWithClient(t, ctx, client, "redis-session")
+
+	exists, err := layer.KeyExists(ctx, "session:1")
+	if exists != false || err != nil {
+		t.Fatalf("fresh KeyExists(session:1) = (%v, %v), want (false, nil)", exists, err)
+	}
+
+	batchExists, err := layer.BatchKeyExist(ctx, []string{"session:missing"})
+	if batchExists != false || err != nil {
+		t.Fatalf("fresh BatchKeyExist(session:missing) = (%v, %v), want (false, nil)", batchExists, err)
+	}
+
+	if err := layer.SetKey(ctx, util.Kv{Key: "session:1", Value: "token"}); err != nil {
+		t.Fatalf("SetKey(session:1) error = %v, want nil", err)
+	}
+	exists, err = layer.KeyExists(ctx, "session:1")
+	if exists != true || err != nil {
+		t.Fatalf("after SetKey KeyExists(session:1) = (%v, %v), want (true, nil)", exists, err)
+	}
+	value, err := layer.GetValue(ctx, "session:1")
+	if value != "token" || err != nil {
+		t.Fatalf("after SetKey GetValue(session:1) = (%q, %v), want (%q, nil)", value, err, "token")
+	}
+
+	if err := layer.BatchSetKeys(ctx, []util.Kv{{Key: "session:2", Value: "two"}, {Key: "session:3", Value: "three"}}); err != nil {
+		t.Fatalf("BatchSetKeys(session:2,session:3) error = %v, want nil", err)
+	}
+	batchExists, err = layer.BatchKeyExist(ctx, []string{"session:2", "session:3"})
+	if batchExists != true || err != nil {
+		t.Fatalf("after BatchSetKeys BatchKeyExist(session:2,session:3) = (%v, %v), want (true, nil)", batchExists, err)
+	}
+	values, err := layer.BatchGetValues(ctx, []string{"session:2", "session:3"})
+	if fmt.Sprintf("%q", values) != "[\"two\" \"three\"]" || err != nil {
+		t.Fatalf("after BatchSetKeys BatchGetValues(session:2,session:3) = (%q, %v), want ([\"two\" \"three\"], nil)", values, err)
+	}
+
+	if err := layer.DeleteKey(ctx, "session:1"); err != nil {
+		t.Fatalf("DeleteKey(session:1) error = %v, want nil", err)
+	}
+	assertRedisExists(t, layer, ctx, "session:1", false)
+	if err := layer.BatchDeleteKeys(ctx, []string{"session:2", "session:3"}); err != nil {
+		t.Fatalf("BatchDeleteKeys(session:2,session:3) error = %v, want nil", err)
+	}
+	batchExists, err = layer.BatchKeyExist(ctx, []string{"session:2", "session:3"})
+	if batchExists != false || err != nil {
+		t.Fatalf("after BatchDeleteKeys BatchKeyExist(session:2,session:3) = (%v, %v), want (false, nil)", batchExists, err)
+	}
+
+	if err := layer.SetKey(ctx, util.Kv{Key: "session:a", Value: "A"}); err != nil {
+		t.Fatalf("SetKey(session:a) error = %v, want nil", err)
+	}
+	if err := layer.SetKey(ctx, util.Kv{Key: "session:b", Value: "B"}); err != nil {
+		t.Fatalf("SetKey(session:b) error = %v, want nil", err)
+	}
+	if err := layer.SetKey(ctx, util.Kv{Key: "other:c", Value: "C"}); err != nil {
+		t.Fatalf("SetKey(other:c) error = %v, want nil", err)
+	}
+	if err := layer.DeleteKeysWithPrefix(ctx, "session"); err != nil {
+		t.Fatalf("DeleteKeysWithPrefix(session) error = %v, want nil", err)
+	}
+	assertRedisExists(t, layer, ctx, "session:a", false)
+	assertRedisExists(t, layer, ctx, "session:b", false)
+	assertRedisExists(t, layer, ctx, "other:c", true)
+
+	if err := layer.SetKey(ctx, util.Kv{Key: "redis-session:x", Value: "X"}); err != nil {
+		t.Fatalf("SetKey(redis-session:x) error = %v, want nil", err)
+	}
+	if err := layer.SetKey(ctx, util.Kv{Key: "redis-session:y", Value: "Y"}); err != nil {
+		t.Fatalf("SetKey(redis-session:y) error = %v, want nil", err)
+	}
+	if err := layer.SetKey(ctx, util.Kv{Key: "outside:z", Value: "Z"}); err != nil {
+		t.Fatalf("SetKey(outside:z) error = %v, want nil", err)
+	}
+	if err := layer.CleanCache(ctx); err != nil {
+		t.Fatalf("CleanCache() error = %v, want nil", err)
+	}
+	assertRedisExists(t, layer, ctx, "redis-session:x", false)
+	assertRedisExists(t, layer, ctx, "redis-session:y", false)
+	assertRedisExists(t, layer, ctx, "outside:z", true)
+}
