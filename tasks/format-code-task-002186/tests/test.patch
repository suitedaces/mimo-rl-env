+func TestRedisCleanCacheLeakFloorKeepsBackendKeysBounded(t *testing.T) {
+
+
+
+
+	ctx := context.Background()
+	client := newRedisClient(t)
+	defer client.Close()
+	prefix := "leak-floor"
+	initialKeys, err := client.Keys(ctx, prefix+":*").Result()
+	if err != nil {
+		t.Fatalf("initial Keys(%s:*) error = %v, want nil", prefix, err)
+	}
+	if len(initialKeys) != 0 {
+		if deleted, err := client.Del(ctx, initialKeys...).Result(); err != nil {
+			t.Fatalf("initial Del(%s:*) = (%d, %v), want (_, nil)", prefix, deleted, err)
+		}
+	}
+
+	for i := 0; i < 100; i++ {
+		layer := newRedisLayerWithClient(t, ctx, client, prefix)
+		key := fmt.Sprintf("leak-floor:%03d", i)
+		if err := layer.SetKey(ctx, util.Kv{Key: key, Value: "value"}); err != nil {
+			t.Fatalf("cycle %d SetKey(%s) error = %v, want nil", i, key, err)
+		}
+		if err := layer.CleanCache(ctx); err != nil {
+			t.Fatalf("cycle %d CleanCache() error = %v, want nil", i, err)
+		}
+	}
+
+	keys, err := client.Keys(ctx, prefix+":*").Result()
+	if err != nil {
+		t.Fatalf("Keys(%s:*) error = %v, want nil", prefix, err)
+	}
+	if len(keys) != 0 {
+		t.Fatalf("Redis key count after 100 clean cycles = %d, want 0; keys=%q", len(keys), keys)
+	}
+}
