+import importlib
+import sys
+import tempfile
+import types
+from pathlib import Path
+
+import pytest
+
+
+
+
+
+
+
+
+
+
+
+@pytest.fixture()
+def download_module(monkeypatch):
+    requests = types.ModuleType("requests")
+    requests.head = lambda *args, **kwargs: object()
+    monkeypatch.setitem(sys.modules, "requests", requests)
+    monkeypatch.setitem(sys.modules, "psutil", types.ModuleType("psutil"))
+    monkeypatch.setitem(sys.modules, "cpuinfo", types.ModuleType("cpuinfo"))
+    monkeypatch.setitem(sys.modules, "distro", types.ModuleType("distro"))
+
+    qtcore = types.ModuleType("PySide6.QtCore")
+
+    class QDir:
+        @staticmethod
+        def tempPath():
+            return tempfile.gettempdir()
+
+    qtcore.QDir = QDir
+    pyside = types.ModuleType("PySide6")
+    pyside.QtCore = qtcore
+    monkeypatch.setitem(sys.modules, "PySide6", pyside)
+    monkeypatch.setitem(sys.modules, "PySide6.QtCore", qtcore)
+
+    qtcustom = types.ModuleType("src.ui.QTcustom")
+
+    class DownloadProgressPopup:
+        calls = []
+
+        def __init__(self, *args, **kwargs):
+
+            call = {}
+            for name, value in zip(("link", "downloadLocation", "title"), args):
+                call[name] = value
+            call.update(kwargs)
+            self.kwargs = call
+            DownloadProgressPopup.calls.append(call)
+
+    qtcustom.DownloadProgressPopup = DownloadProgressPopup
+    monkeypatch.setitem(sys.modules, "src.ui.QTcustom", qtcustom)
+
+    sys.modules.pop("src.constants", None)
+    sys.modules.pop("src.Util", None)
+    sys.modules.pop("src.DownloadModels", None)
+    module = importlib.import_module("src.DownloadModels")
+    return module
+
+
+def assert_progress_dialog_call(call, *, link, title, download_location):
+    assert call["link"] == link
+    assert call["title"] == title
+    assert call["downloadLocation"] == download_location
+
+
+def test_constructor_remembers_targets_and_creates_model_directory(
+    download_module, monkeypatch, tmp_path
+):
+
+
+
+
+    model_dir = tmp_path / "models"
+
+    dm = download_module.DownloadModel("target.bin", "asset.pkl", str(model_dir))
+
+    assert model_dir.exists() is True
+    assert model_dir.is_dir() is True
+
+    monkeypatch.setattr(download_module, "networkCheck", lambda: True)
+    assert dm.downloadModel() is True
+    assert len(download_module.DownloadProgressPopup.calls) == 1
+    assert_progress_dialog_call(
+        download_module.DownloadProgressPopup.calls[0],
+        link="https://github.com/TNTwise/real-video-enhancer-models/releases/download/models/asset.pkl",
+        title="Downloading: asset.pkl",
+        download_location=str(model_dir / "asset.pkl"),
+    )
+
+    (model_dir / "target.bin").write_text("local model", encoding="utf-8")
+    calls_before_existing_check = list(download_module.DownloadProgressPopup.calls)
+
+    def fail_if_network_checked():
+        raise AssertionError("networkCheck should not run for the remembered target")
+
+    monkeypatch.setattr(download_module, "networkCheck", fail_if_network_checked)
+    assert dm.downloadModel() is True
+    assert download_module.DownloadProgressPopup.calls == calls_before_existing_check
+
+
+def test_existing_model_directory_returns_true_without_network_or_download(
+    download_module, monkeypatch, tmp_path
+):
+
+
+
+
+    model_dir = tmp_path / "models"
+    dm = download_module.DownloadModel("rife-v4.6", "rife-v4.6.tar.gz", str(model_dir))
+    (model_dir / "rife-v4.6").mkdir()
+
+    def fail_if_network_checked():
+        raise AssertionError("networkCheck should not run for an existing model directory")
+
+    monkeypatch.setattr(download_module, "networkCheck", fail_if_network_checked)
+
+    assert dm.downloadModel() is True
+    assert download_module.DownloadProgressPopup.calls == []
+
+
+def test_existing_model_file_returns_true_without_network_or_download(
+    download_module, monkeypatch, tmp_path
+):
+
+
+
+
+    model_dir = tmp_path / "models"
+    dm = download_module.DownloadModel("GMFSS.pkl", "GMFSS.pkl", str(model_dir))
+    (model_dir / "GMFSS.pkl").write_text("local model", encoding="utf-8")
+
+    def fail_if_network_checked():
+        raise AssertionError("networkCheck should not run for an existing model file")
+
+    monkeypatch.setattr(download_module, "networkCheck", fail_if_network_checked)
+
+    assert dm.downloadModel() is True
+    assert download_module.DownloadProgressPopup.calls == []
+
+
+def test_missing_model_without_network_returns_false_and_does_not_download(
+    download_module, monkeypatch, tmp_path
+):
+
+
+
+
+    model_dir = tmp_path / "models"
+    dm = download_module.DownloadModel("missing-model", "missing-model.tar.gz", str(model_dir))
+    monkeypatch.setattr(download_module, "networkCheck", lambda: False)
+
+    assert dm.downloadModel() is False
+    assert download_module.DownloadProgressPopup.calls == []
+    assert (model_dir / "missing-model.tar.gz").exists() is False
+
+
+def test_missing_tar_model_downloads_with_progress_then_extracts(
+    download_module, monkeypatch, tmp_path, capsys
+):
+
+
+
+
+    model_dir = tmp_path / "models"
+    dm = download_module.DownloadModel("rife-v4.6", "rife-v4.6.tar.gz", str(model_dir))
+    extract_calls = []
+    monkeypatch.setattr(download_module, "networkCheck", lambda: True)
+    monkeypatch.setattr(download_module, "extractTarGZ", lambda path: extract_calls.append(path))
+
+    assert dm.downloadModel() is True
+    assert len(download_module.DownloadProgressPopup.calls) == 1
+    assert_progress_dialog_call(
+        download_module.DownloadProgressPopup.calls[0],
+        link="https://github.com/TNTwise/real-video-enhancer-models/releases/download/models/rife-v4.6.tar.gz",
+        title="Downloading: rife-v4.6.tar.gz",
+        download_location=str(model_dir / "rife-v4.6.tar.gz"),
+    )
+
+    output_lines = capsys.readouterr().out.splitlines()
+    assert "Done" in output_lines
+    assert "Extracting File" in output_lines
+    assert extract_calls == [str(model_dir / "rife-v4.6.tar.gz")]
+
+
+def test_missing_plain_model_downloads_without_archive_extraction(
+    download_module, monkeypatch, tmp_path, capsys
+):
+
+
+
+
+    model_dir = tmp_path / "models"
+    dm = download_module.DownloadModel("GMFSS.pkl", "GMFSS.pkl", str(model_dir))
+    extract_calls = []
+    monkeypatch.setattr(download_module, "networkCheck", lambda: True)
+    monkeypatch.setattr(download_module, "extractTarGZ", lambda path: extract_calls.append(path))
+
+    assert dm.downloadModel() is True
+    assert len(download_module.DownloadProgressPopup.calls) == 1
+    assert_progress_dialog_call(
+        download_module.DownloadProgressPopup.calls[0],
+        link="https://github.com/TNTwise/real-video-enhancer-models/releases/download/models/GMFSS.pkl",
+        title="Downloading: GMFSS.pkl",
+        download_location=str(model_dir / "GMFSS.pkl"),
+    )
+
+    output_lines = capsys.readouterr().out.splitlines()
+    assert "Done" in output_lines
+    assert "Extracting File" not in output_lines
+    assert extract_calls == []
+
+
+def test_two_instances_keep_independent_target_state(download_module, monkeypatch, tmp_path):
+
+
+
+
+    a_dir = tmp_path / "a"
+    b_dir = tmp_path / "b"
+
+    a = download_module.DownloadModel("a.bin", "a.tar.gz", str(a_dir))
+    b = download_module.DownloadModel("b.bin", "b.pkl", str(b_dir))
+    (a_dir / "a.bin").write_text("local model", encoding="utf-8")
+
+
+    def fail_if_network_checked():
+        raise AssertionError("networkCheck should not run for a's existing target")
+
+    monkeypatch.setattr(download_module, "networkCheck", fail_if_network_checked)
+    assert a.downloadModel() is True
+    assert download_module.DownloadProgressPopup.calls == []
+
+    monkeypatch.setattr(download_module, "networkCheck", lambda: True)
+    assert b.downloadModel() is True
+    assert len(download_module.DownloadProgressPopup.calls) == 1
+    assert_progress_dialog_call(
+        download_module.DownloadProgressPopup.calls[0],
+        link="https://github.com/TNTwise/real-video-enhancer-models/releases/download/models/b.pkl",
+        title="Downloading: b.pkl",
+        download_location=str(b_dir / "b.pkl"),
+    )
+
+
+def test_repeated_existing_model_sessions_have_bounded_side_effects(
+    download_module, monkeypatch, tmp_path
+):
+
+
+
+
+    model_dir = tmp_path / "models"
+    model_dir.mkdir()
+    (model_dir / "GMFSS.pkl").write_text("local model", encoding="utf-8")
+
+    network_checks = []
+    extract_calls = []
+
+    monkeypatch.setattr(download_module, "networkCheck", lambda: network_checks.append("called"))
+    monkeypatch.setattr(download_module, "extractTarGZ", lambda path: extract_calls.append(path))
+
+    for _ in range(100):
+        dm = download_module.DownloadModel("GMFSS.pkl", "GMFSS.pkl", str(model_dir))
+        assert dm.downloadModel() is True
+
+    assert network_checks == []
+    assert download_module.DownloadProgressPopup.calls == []
+    assert extract_calls == []
+
+    assert (model_dir / "GMFSS.pkl").read_text(encoding="utf-8") == "local model"
