+++ b/mimo_test_command.sh
@@ -0,0 +1,26 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+
+
+
+
+
+
+case "${1:-}" in
+  base)
+    go test ./pkg/alertmanager/ -v -count=1 -timeout 120s \
+      -skip '^(TestAlertmanagerTenantConfigAcceptsInlineOAuth2|TestValidateUserConfigRejectsOAuth2ClientSecretFile)$'
+    ;;
+  new)
+    go test github.com/prometheus/common/config ./pkg/alertmanager/ -v -count=1 -timeout 120s \
+      -run '^(TestHTTPClientConfigOAuth2ClientCredentialsSendsBearerToken|TestHTTPClientConfigOAuth2RequiredFields|TestHTTPClientConfigOAuth2MutuallyExclusiveWithOtherAuth|TestAlertmanagerTenantConfigAcceptsInlineOAuth2|TestValidateUserConfigRejectsOAuth2ClientSecretFile)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
