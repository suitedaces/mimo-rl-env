+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+PYTHONPATH=src python -m pytest -v -rA tests/storage-proxy/vfolder/test_quota_scope_field_rename.py::test_quota_scope_key_path_has_renamed_fields tests/storage-proxy/vfolder/test_quota_scope_field_rename.py::test_vfolder_key_path_has_renamed_fields tests/storage-proxy/vfolder/test_quota_scope_field_rename.py::test_quota_scope_key_path_construct_with_new_names tests/storage-proxy/vfolder/test_quota_scope_field_rename.py::test_vfolder_key_path_construct_with_new_names tests/storage-proxy/vfolder/test_quota_scope_field_rename.py::test_quota_scope_key_path_rejects_old_names tests/storage-proxy/vfolder/test_quota_scope_field_rename.py::test_quota_scope_key_from_quota_scope_path_uses_new_fields tests/storage-proxy/vfolder/test_quota_scope_field_rename.py::test_vfolder_key_from_vfolder_path_uses_new_fields tests/storage-proxy/vfolder/test_quota_scope_field_rename.py::test_v2_volume_app_uses_quota_scope_url_segment tests/storage-proxy/vfolder/test_quota_scope_field_rename.py::test_v2_volume_app_no_legacy_scope_url_segments
+rc=$(( rc | $? ))
+exit $rc
