+
+
+func TestComponentOption_RetainOnDelete_Warns(t *testing.T) {
+	t.Parallel()
+	warnings := runComponentOptionsTest(t, false, deploytest.ResourceOptions{
+		RetainOnDelete: true,
+	})
+	assert.True(t, warningPresent(warnings, "retainOnDelete"),
+		"expected per-option retainOnDelete warning; got: %v", warnings)
+}
+
+
+
+func TestComponentOption_CustomTimeouts_Warns(t *testing.T) {
+	t.Parallel()
+	warnings := runComponentOptionsTest(t, false, deploytest.ResourceOptions{
+		CustomTimeouts: &resource.CustomTimeouts{
+			Create: 60,
+		},
+	})
+	assert.True(t, warningPresent(warnings, "customTimeouts"),
+		"expected per-option customTimeouts warning; got: %v", warnings)
+}
+
+
+
+
+
+
+
+
+
+func TestComponentOption_NoOpts_NoWarnings(t *testing.T) {
+	t.Parallel()
+	warnings := runComponentOptionsTest(t, false, deploytest.ResourceOptions{})
+	for _, opt := range []string{
+		"ignoreChanges",
+		"customTimeouts",
+		"additionalSecretOutputs",
+		"replaceOnChanges",
+		"retainOnDelete",
+	} {
+		assert.False(t, warningPresent(warnings, opt),
+			"unexpected %s warning when no opts were provided; got: %v", opt, warnings)
+	}
+}
+
+
+
+
+func TestComponentOption_CustomResource_NoWarnings(t *testing.T) {
+	t.Parallel()
+
+
+
+
+	runtime := deploytest.NewLanguageRuntime(func(_ plugin.RunInfo, monitor *deploytest.ResourceMonitor) error {
+		_, _, _, _ = monitor.RegisterResource("pkgA:m:typA", "resA", true, deploytest.ResourceOptions{
+			IgnoreChanges:           []string{"root"},
+			AdditionalSecretOutputs: []resource.PropertyKey{"foobar"},
+			ReplaceOnChanges:        []string{"*"},
+			RetainOnDelete:          true,
+			CustomTimeouts:          &resource.CustomTimeouts{Create: 60},
+		})
+		return nil
+	})
+	host := deploytest.NewPluginHost(nil, nil, runtime)
+
+	var warnings []string
+	p := &TestPlan{
+		Options: UpdateOptions{Host: host},
+		Steps: []TestStep{{
+			Op:            Update,
+			ExpectFailure: true,
+			SkipPreview:   true,
+			Validate: func(
+				_ workspace.Project,
+				_ deploy.Target,
+				_ JournalEntries,
+				evts []Event,
+				res result.Result,
+			) result.Result {
+				for _, evt := range evts {
+					if evt.Type == DiagEvent {
+						e := evt.Payload().(DiagEventPayload)
+						if e.Severity == diag.Warning {
+							warnings = append(warnings, colors.Never.Colorize(e.Message))
+						}
+					}
+				}
+				return res
+			},
+		}},
+	}
+	p.Run(t, nil)
+
+	for _, opt := range []string{
+		"ignoreChanges",
+		"customTimeouts",
+		"additionalSecretOutputs",
+		"replaceOnChanges",
+		"retainOnDelete",
+	} {
+		assert.False(t, warningPresent(warnings, opt),
+			"unexpected %s 'no effect on component resources' warning for custom resource; got: %v",
+			opt, warnings)
+	}
+}
+
+
+
+
+
+
+func TestComponentOption_AllOptions_EachWarnsSeparately(t *testing.T) {
+	t.Parallel()
+	warnings := runComponentOptionsTest(t, false, deploytest.ResourceOptions{
+		IgnoreChanges:           []string{"root.nested"},
+		AdditionalSecretOutputs: []resource.PropertyKey{"bucket"},
+		ReplaceOnChanges:        []string{"*"},
+		RetainOnDelete:          true,
+		CustomTimeouts: &resource.CustomTimeouts{
+			Create: 60,
+			Update: 60,
+			Delete: 60,
+		},
+	})
+	for _, opt := range []string{
+		"ignoreChanges",
+		"customTimeouts",
+		"additionalSecretOutputs",
+		"replaceOnChanges",
+		"retainOnDelete",
+	} {
+		assert.True(t, warningPresent(warnings, opt),
+			"expected per-option %s warning; got: %v", opt, warnings)
+	}
+}
