+func TestHelpersDoNotMutateInputSlices(t *testing.T) {
+	mapInput := []int{2, 4, 6}
+	filterInput := namedInts{1, 2, 3, 4}
+	foreachInput := []string{"left", "right"}
+	mapOriginal := append([]int(nil), mapInput...)
+	filterOriginal := append(namedInts(nil), filterInput...)
+	foreachOriginal := append([]string(nil), foreachInput...)
+
+	_ = bfslices.Map(mapInput, func(n int) int { return n * 10 })
+	_ = bfslices.ParallelMap(mapInput, func(n int) int { return n + 10 }, 2)
+	_ = bfslices.Filter(filterInput, func(n int) bool { return n > 1 })
+	_ = bfslices.ParallelFilter(filterInput, func(n int) bool { return n < 4 }, 2)
+	bfslices.ForEach(foreachInput, func(_ int, _ string) {})
+	bfslices.ParallelForEach(foreachInput, func(_ int, _ string) {}, 2)
+
+	if !stdslices.Equal(mapInput, mapOriginal) {
+		t.Fatalf("map input mutated to %#v, want %#v", mapInput, mapOriginal)
+	}
+	if !stdslices.Equal(filterInput, filterOriginal) {
+		t.Fatalf("filter input mutated to %#v, want %#v", filterInput, filterOriginal)
+	}
+	if !stdslices.Equal(foreachInput, foreachOriginal) {
+		t.Fatalf("foreach input mutated to %#v, want %#v", foreachInput, foreachOriginal)
+	}
+}
