+func TestParallelHelpersUseGOMAXPROCSForOmittedAndNonPositiveWorkers(t *testing.T) {
+
+
+
+
+	old := runtime.GOMAXPROCS(2)
+	defer runtime.GOMAXPROCS(old)
+
+	mapOmitted, mapOmittedMax := parallelMapWithObservedConcurrency(t, []int{1, 2, 3}, 2, nil)
+	mapZero, mapZeroMax := parallelMapWithObservedConcurrency(t, []int{1, 2, 3}, 2, []int{0})
+	filterNegative, filterNegativeMax := parallelFilterWithObservedConcurrency(t, []int{1, 2, 3, 4}, 2, []int{-5})
+	foreachOmitted, foreachOmittedMax := parallelForEachWithObservedConcurrency(t, []string{"x", "y", "z"}, 2, nil)
+
+	if !stdslices.Equal(mapOmitted, []int{1, 4, 9}) {
+		t.Fatalf("ParallelMap omitted workers = %#v, want %#v", mapOmitted, []int{1, 4, 9})
+	}
+	if mapOmittedMax != 2 {
+		t.Fatalf("ParallelMap omitted max active callbacks = %d, want 2", mapOmittedMax)
+	}
+	if !stdslices.Equal(mapZero, []int{1, 4, 9}) {
+		t.Fatalf("ParallelMap zero workers = %#v, want %#v", mapZero, []int{1, 4, 9})
+	}
+	if mapZeroMax != 2 {
+		t.Fatalf("ParallelMap zero max active callbacks = %d, want 2", mapZeroMax)
+	}
+	if !stdslices.Equal(filterNegative, []int{3, 4}) {
+		t.Fatalf("ParallelFilter negative workers = %#v, want %#v", filterNegative, []int{3, 4})
+	}
+	if filterNegativeMax != 2 {
+		t.Fatalf("ParallelFilter negative max active callbacks = %d, want 2", filterNegativeMax)
+	}
+	if !reflect.DeepEqual(foreachOmitted, map[int]string{0: "x", 1: "y", 2: "z"}) {
+		t.Fatalf("ParallelForEach omitted workers visits = %#v, want %#v", foreachOmitted, map[int]string{0: "x", 1: "y", 2: "z"})
+	}
+	if foreachOmittedMax != 2 {
+		t.Fatalf("ParallelForEach omitted max active callbacks = %d, want 2", foreachOmittedMax)
+	}
+}
