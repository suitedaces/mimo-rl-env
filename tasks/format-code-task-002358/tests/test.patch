+func TestHelpersHaveNoInProcessGlobalStateDependency(t *testing.T) {
+	firstMap := bfslices.ParallelMap([]int{2, 3, 4}, func(n int) int {
+		return n * n
+	}, 2)
+	noiseMap := bfslices.Map([]int{10, 11}, func(n int) int {
+		return -n
+	})
+	noiseFilter := bfslices.ParallelFilter([]int{7, 8, 9}, func(n int) bool {
+		return n != 8
+	}, 1)
+	var noiseVisits []intVisit
+	bfslices.ForEach([]int{40, 50}, func(i int, v int) {
+		noiseVisits = append(noiseVisits, intVisit{Index: i, Value: v})
+	})
+	var parallelNoiseMu sync.Mutex
+	parallelNoiseVisits := map[int]string{}
+	bfslices.ParallelForEach([]string{"q", "r"}, func(i int, v string) {
+		parallelNoiseMu.Lock()
+		parallelNoiseVisits[i] = v
+		parallelNoiseMu.Unlock()
+	}, 2)
+	secondMap := bfslices.ParallelMap([]int{2, 3, 4}, func(n int) int {
+		return n * n
+	}, 2)
+
+	if !stdslices.Equal(firstMap, []int{4, 9, 16}) {
+		t.Fatalf("first ParallelMap result = %#v, want %#v", firstMap, []int{4, 9, 16})
+	}
+	if !stdslices.Equal(noiseMap, []int{-10, -11}) {
+		t.Fatalf("noise Map result = %#v, want %#v", noiseMap, []int{-10, -11})
+	}
+	if !stdslices.Equal(noiseFilter, []int{7, 9}) {
+		t.Fatalf("noise ParallelFilter result = %#v, want %#v", noiseFilter, []int{7, 9})
+	}
+	if !reflect.DeepEqual(noiseVisits, []intVisit{{Index: 0, Value: 40}, {Index: 1, Value: 50}}) {
+		t.Fatalf("noise ForEach visits = %#v, want %#v", noiseVisits, []intVisit{{Index: 0, Value: 40}, {Index: 1, Value: 50}})
+	}
+	if !reflect.DeepEqual(parallelNoiseVisits, map[int]string{0: "q", 1: "r"}) {
+		t.Fatalf("noise ParallelForEach visits = %#v, want %#v", parallelNoiseVisits, map[int]string{0: "q", 1: "r"})
+	}
+	if !stdslices.Equal(secondMap, []int{4, 9, 16}) {
+		t.Fatalf("second ParallelMap result after noise = %#v, want %#v", secondMap, []int{4, 9, 16})
+	}
+}
