+func TestHelpersDoNotCreateRelativeFilesystemSideEffectsOrMutateGOMAXPROCS(t *testing.T) {
+	oldWd, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd failed: %v", err)
+	}
+	tmp := t.TempDir()
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatalf("Chdir temp failed: %v", err)
+	}
+	defer func() {
+		if err := os.Chdir(oldWd); err != nil {
+			t.Fatalf("restore cwd failed: %v", err)
+		}
+	}()
+
+	beforeFiles := snapshotFiles(t, tmp)
+	beforeProcs := runtime.GOMAXPROCS(0)
+
+	_ = bfslices.Map([]int{1, 2}, func(n int) int { return n + 1 })
+	_ = bfslices.ParallelMap([]int{1, 2}, func(n int) int { return n + 2 }, 2)
+	_ = bfslices.Filter([]int{1, 2, 3}, func(n int) bool { return n > 1 })
+	_ = bfslices.ParallelFilter([]int{1, 2, 3}, func(n int) bool { return n < 3 }, 2)
+	bfslices.ForEach([]int{1, 2}, func(_ int, _ int) {})
+	bfslices.ParallelForEach([]int{1, 2}, func(_ int, _ int) {}, 2)
+
+	afterFiles := snapshotFiles(t, tmp)
+	afterProcs := runtime.GOMAXPROCS(0)
+
+	if !reflect.DeepEqual(beforeFiles, []string{}) {
+		t.Fatalf("initial cwd snapshot = %#v, want %#v", beforeFiles, []string{})
+	}
+	if !reflect.DeepEqual(afterFiles, []string{}) {
+		t.Fatalf("final cwd snapshot = %#v, want %#v", afterFiles, []string{})
+	}
+	if afterProcs != beforeProcs {
+		t.Fatalf("GOMAXPROCS after helper calls = %d, want %d", afterProcs, beforeProcs)
+	}
+}
