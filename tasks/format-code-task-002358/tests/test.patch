+func TestParallelHelpersDoNotRecoverCallbackPanics(t *testing.T) {
+
+
+
+
+	if mode := os.Getenv("TST_PARALLEL_PANIC_HELPER"); mode != "" {
+		runParallelPanicMode(mode)
+		return
+	}
+
+	cases := []struct {
+		mode string
+		want string
+	}{
+		{mode: "map", want: "parallel-map-boom"},
+		{mode: "filter", want: "parallel-filter-boom"},
+		{mode: "foreach", want: "parallel-foreach-boom"},
+	}
+
+	for _, tc := range cases {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestParallelHelpersDoNotRecoverCallbackPanics$")
+		cmd.Env = append(os.Environ(), "TST_PARALLEL_PANIC_HELPER="+tc.mode)
+		output, err := cmd.CombinedOutput()
+		var exitErr *exec.ExitError
+		if !errors.As(err, &exitErr) {
+			t.Fatalf("parallel %s panic process error = %v, want non-zero exit; output:\n%s", tc.mode, err, output)
+		}
+		if !bytes.Contains(output, []byte(tc.want)) {
+			t.Fatalf("parallel %s panic output = %q, want substring %q", tc.mode, output, tc.want)
+		}
+	}
+}
