+func TestHelpersAreReferentiallyTransparentForDeterministicCallbacks(t *testing.T) {
+	firstMap := bfslices.Map([]int{3, 4, 5}, func(n int) string {
+		return fmt.Sprintf("n=%d", n*3)
+	})
+	secondMap := bfslices.Map([]int{3, 4, 5}, func(n int) string {
+		return fmt.Sprintf("n=%d", n*3)
+	})
+	if !stdslices.Equal(firstMap, []string{"n=9", "n=12", "n=15"}) {
+		t.Fatalf("first Map deterministic result = %#v, want %#v", firstMap, []string{"n=9", "n=12", "n=15"})
+	}
+	if !stdslices.Equal(secondMap, []string{"n=9", "n=12", "n=15"}) {
+		t.Fatalf("second Map deterministic result = %#v, want %#v", secondMap, []string{"n=9", "n=12", "n=15"})
+	}
+
+	firstFilter := bfslices.ParallelFilter([]int{1, 2, 3, 4, 5}, func(n int) bool {
+		return n%2 == 1
+	}, 2)
+	secondFilter := bfslices.ParallelFilter([]int{1, 2, 3, 4, 5}, func(n int) bool {
+		return n%2 == 1
+	}, 2)
+	if !stdslices.Equal(firstFilter, []int{1, 3, 5}) {
+		t.Fatalf("first ParallelFilter deterministic result = %#v, want %#v", firstFilter, []int{1, 3, 5})
+	}
+	if !stdslices.Equal(secondFilter, []int{1, 3, 5}) {
+		t.Fatalf("second ParallelFilter deterministic result = %#v, want %#v", secondFilter, []int{1, 3, 5})
+	}
+}
