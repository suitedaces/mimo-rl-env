+func expectPanicValue(t *testing.T, expected callbackPanic, fn func()) {
+	t.Helper()
+	defer func() {
+		actual := recover()
+		if actual != expected {
+			t.Fatalf("recovered panic = %#v, want %#v", actual, expected)
+		}
+	}()
+	fn()
+	t.Fatalf("callback did not panic; want %#v", expected)
+}
+
+func runParallelPanicMode(mode string) {
+	switch mode {
+	case "map":
+		_ = bfslices.ParallelMap([]int{1, 2}, func(int) int {
+			panic("parallel-map-boom")
+		}, 2)
+	case "filter":
+		_ = bfslices.ParallelFilter([]int{1, 2}, func(int) bool {
+			panic("parallel-filter-boom")
+		}, 2)
+	case "foreach":
+		bfslices.ParallelForEach([]int{1, 2}, func(int, int) {
+			panic("parallel-foreach-boom")
+		}, 2)
+	default:
+		panic("unknown parallel panic mode")
+	}
+}
