+func TestEmptyInputsCompleteImmediately(t *testing.T) {
+
+
+
+
+	mapped := bfslices.Map([]int{}, func(n int) int { return n + 1 })
+	parallelMapped := bfslices.ParallelMap([]int{}, func(n int) int { return n + 1 }, 2)
+	filtered := bfslices.Filter(namedInts{}, func(n int) bool { return true })
+	parallelFiltered := bfslices.ParallelFilter(namedInts{}, func(n int) bool { return true }, 2)
+	forEachCalls := 0
+	parallelForEachCalls := 0
+
+	bfslices.ForEach([]int{}, func(_ int, _ int) { forEachCalls++ })
+	bfslices.ParallelForEach([]int{}, func(_ int, _ int) { parallelForEachCalls++ }, 2)
+
+	var typedFiltered namedInts = filtered
+	var typedParallelFiltered namedInts = parallelFiltered
+	if !stdslices.Equal(mapped, []int{}) {
+		t.Fatalf("Map empty = %#v, want %#v", mapped, []int{})
+	}
+	if !stdslices.Equal(parallelMapped, []int{}) {
+		t.Fatalf("ParallelMap empty = %#v, want %#v", parallelMapped, []int{})
+	}
+	if !stdslices.Equal(typedFiltered, namedInts{}) {
+		t.Fatalf("Filter empty = %#v, want %#v", typedFiltered, namedInts{})
+	}
+	if !stdslices.Equal(typedParallelFiltered, namedInts{}) {
+		t.Fatalf("ParallelFilter empty = %#v, want %#v", typedParallelFiltered, namedInts{})
+	}
+	if forEachCalls != 0 {
+		t.Fatalf("ForEach empty callback count = %d, want 0", forEachCalls)
+	}
+	if parallelForEachCalls != 0 {
+		t.Fatalf("ParallelForEach empty callback count = %d, want 0", parallelForEachCalls)
+	}
+}
