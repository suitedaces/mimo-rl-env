+
+
+
+
+func Test_createRun_interactive_tagDescription(t *testing.T) {
+	tests := []struct {
+		name           string
+		opts           *CreateOptions
+		httpStubs      func(*httpmock.Registry)
+		runStubs       func(*run.CommandStubber)
+		askStubs       func(*prompt.AskStubber)
+		wantEditorBody string
+		wantOut        string
+	}{
+		{
+
+
+
+			name: "annotated tag with generated notes shows tag message option",
+			opts: &CreateOptions{TagName: "v1.2.3"},
+			httpStubs: func(reg *httpmock.Registry) {
+				reg.Register(httpmock.REST("POST", "repos/OWNER/REPO/releases/generate-notes"),
+					httpmock.StatusStringResponse(200, `{
+            "name": "generated name",
+            "body": "generated body"
+         }`))
+				reg.Register(httpmock.REST("POST", "repos/OWNER/REPO/releases"),
+					httpmock.StatusStringResponse(201, `{
+            "url": "https://api.github.com/releases/123",
+            "upload_url": "https://api.github.com/assets/upload",
+            "html_url": "https://github.com/OWNER/REPO/releases/tag/v1.2.3"
+         }`))
+			},
+			runStubs: func(rs *run.CommandStubber) {
+
+
+
+				rs.Register(`git tag --list v1\.2\.3`, 0, "tag-subject\n\ntag-body")
+			},
+			askStubs: func(as *prompt.AskStubber) {
+				as.StubPrompt("Title (optional)").AnswerDefault()
+				as.StubPrompt("Release notes").
+					AssertOptions([]string{
+						"Write my own",
+						"Write using generated notes as template",
+						"Write using git tag message as template",
+						"Leave blank",
+					}).
+					AnswerWith("Leave blank")
+				as.StubPrompt("Is this a prerelease?").AnswerWith(false)
+				as.StubPrompt("Submit?").AnswerWith("Publish release")
+			},
+			wantOut: "https://github.com/OWNER/REPO/releases/tag/v1.2.3\n",
+		},
+		{
+
+
+
+			name: "lightweight tag with generated notes hides tag message option",
+			opts: &CreateOptions{TagName: "v1.2.3"},
+			httpStubs: func(reg *httpmock.Registry) {
+				reg.Register(httpmock.REST("POST", "repos/OWNER/REPO/releases/generate-notes"),
+					httpmock.StatusStringResponse(200, `{
+            "name": "generated name",
+            "body": "generated body"
+         }`))
+				reg.Register(httpmock.REST("POST", "repos/OWNER/REPO/releases"),
+					httpmock.StatusStringResponse(201, `{
+            "url": "https://api.github.com/releases/123",
+            "upload_url": "https://api.github.com/assets/upload",
+            "html_url": "https://github.com/OWNER/REPO/releases/tag/v1.2.3"
+         }`))
+			},
+			runStubs: func(rs *run.CommandStubber) {
+
+
+
+
+				rs.Register(`git tag --list v1\.2\.3`, 0, "")
+			},
+			askStubs: func(as *prompt.AskStubber) {
+				as.StubPrompt("Title (optional)").AnswerDefault()
+				as.StubPrompt("Release notes").
+					AssertOptions([]string{
+						"Write my own",
+						"Write using generated notes as template",
+						"Leave blank",
+					}).
+					AnswerWith("Leave blank")
+				as.StubPrompt("Is this a prerelease?").AnswerWith(false)
+				as.StubPrompt("Submit?").AnswerWith("Publish release")
+			},
+			wantOut: "https://github.com/OWNER/REPO/releases/tag/v1.2.3\n",
+		},
+		{
+
+
+
+			name: "tag description not fetched when --repo override is set",
+			opts: &CreateOptions{TagName: "v1.2.3", RepoOverride: "OWNER/REPO"},
+			httpStubs: func(reg *httpmock.Registry) {
+				reg.Register(httpmock.REST("POST", "repos/OWNER/REPO/releases/generate-notes"),
+					httpmock.StatusStringResponse(200, `{
+            "name": "generated name",
+            "body": "generated body"
+         }`))
+				reg.Register(httpmock.REST("POST", "repos/OWNER/REPO/releases"),
+					httpmock.StatusStringResponse(201, `{
+            "url": "https://api.github.com/releases/123",
+            "upload_url": "https://api.github.com/assets/upload",
+            "html_url": "https://github.com/OWNER/REPO/releases/tag/v1.2.3"
+         }`))
+			},
+			runStubs: func(rs *run.CommandStubber) {
+
+			},
+			askStubs: func(as *prompt.AskStubber) {
+				as.StubPrompt("Title (optional)").AnswerDefault()
+				as.StubPrompt("Release notes").
+					AssertOptions([]string{
+						"Write my own",
+						"Write using generated notes as template",
+						"Leave blank",
+					}).
+					AnswerWith("Leave blank")
+				as.StubPrompt("Is this a prerelease?").AnswerWith(false)
+				as.StubPrompt("Submit?").AnswerWith("Publish release")
+			},
+			wantOut: "https://github.com/OWNER/REPO/releases/tag/v1.2.3\n",
+		},
+		{
+
+
+
+
+			name: "selecting tag message template passes tag body to editor",
+			opts: &CreateOptions{TagName: "v1.2.3"},
+			httpStubs: func(reg *httpmock.Registry) {
+				reg.Register(httpmock.REST("POST", "repos/OWNER/REPO/releases/generate-notes"),
+					httpmock.StatusStringResponse(200, `{
+            "name": "generated name",
+            "body": "GENERATED-BODY-NOT-THIS-ONE"
+         }`))
+				reg.Register(httpmock.REST("POST", "repos/OWNER/REPO/releases"),
+					httpmock.StatusStringResponse(201, `{
+            "url": "https://api.github.com/releases/123",
+            "upload_url": "https://api.github.com/assets/upload",
+            "html_url": "https://github.com/OWNER/REPO/releases/tag/v1.2.3"
+         }`))
+			},
+			runStubs: func(rs *run.CommandStubber) {
+				rs.Register(`git tag --list v1\.2\.3`, 0, "MY-TAG-SUBJECT\n\nMY-TAG-BODY")
+			},
+			askStubs: func(as *prompt.AskStubber) {
+				as.StubPrompt("Title (optional)").AnswerDefault()
+				as.StubPrompt("Release notes").
+					AnswerWith("Write using git tag message as template")
+				as.StubPrompt("Is this a prerelease?").AnswerWith(false)
+				as.StubPrompt("Submit?").AnswerWith("Publish release")
+			},
+			wantEditorBody: "MY-TAG-SUBJECT\n\nMY-TAG-BODY",
+			wantOut:        "https://github.com/OWNER/REPO/releases/tag/v1.2.3\n",
+		},
+		{
+
+
+
+
+
+			name: "no generated notes API: annotated tag plus prev tag offers both options",
+			opts: &CreateOptions{TagName: "v1.2.3"},
+			httpStubs: func(reg *httpmock.Registry) {
+				reg.Register(httpmock.REST("POST", "repos/OWNER/REPO/releases/generate-notes"),
+					httpmock.StatusStringResponse(404, `{}`))
+				reg.Register(httpmock.REST("POST", "repos/OWNER/REPO/releases"),
+					httpmock.StatusStringResponse(201, `{
+            "url": "https://api.github.com/releases/123",
+            "upload_url": "https://api.github.com/assets/upload",
+            "html_url": "https://github.com/OWNER/REPO/releases/tag/v1.2.3"
+         }`))
+			},
+			runStubs: func(rs *run.CommandStubber) {
+				rs.Register(`git tag --list v1\.2\.3`, 0, "tag-subject\n\ntag-body")
+				rs.Register(`git describe --tags --abbrev=0 v1\.2\.3\^`, 0, "v1.0.0\n")
+				rs.Register(`git -c log\.ShowSignature=false log`, 0, "feat: hello\x00")
+			},
+			askStubs: func(as *prompt.AskStubber) {
+				as.StubPrompt("Title (optional)").AnswerWith("")
+				as.StubPrompt("Release notes").
+					AssertOptions([]string{
+						"Write my own",
+						"Write using commit log as template",
+						"Write using git tag message as template",
+						"Leave blank",
+					}).
+					AnswerWith("Leave blank")
+				as.StubPrompt("Is this a prerelease?").AnswerWith(false)
+				as.StubPrompt("Submit?").AnswerWith("Publish release")
+			},
+			wantOut: "https://github.com/OWNER/REPO/releases/tag/v1.2.3\n",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ios, _, stdout, stderr := iostreams.Test()
+			ios.SetStdoutTTY(true)
+			ios.SetStdinTTY(true)
+			ios.SetStderrTTY(true)
+			tt.opts.IO = ios
+
+			reg := &httpmock.Registry{}
+			defer reg.Verify(t)
+			tt.httpStubs(reg)
+			tt.opts.HttpClient = func() (*http.Client, error) {
+				return &http.Client{Transport: reg}, nil
+			}
+
+			tt.opts.BaseRepo = func() (ghrepo.Interface, error) {
+				return ghrepo.FromFullName("OWNER/REPO")
+			}
+
+			tt.opts.Config = func() (config.Config, error) {
+				return config.NewBlankConfig(), nil
+			}
+
+			var capturedEditorBody string
+			tt.opts.Edit = func(_, _, val string, _ io.Reader, _, _ io.Writer) (string, error) {
+				capturedEditorBody = val
+				return val, nil
+			}
+
+			rs, restoreRun := run.Stub()
+			defer restoreRun(t)
+			if tt.runStubs != nil {
+				tt.runStubs(rs)
+			}
+
+			//nolint:staticcheck // SA1019: prompt.InitAskStubber is deprecated: use NewAskStubber
+			as, teardown := prompt.InitAskStubber()
+			defer teardown()
+			if tt.askStubs != nil {
+				tt.askStubs(as)
+			}
+
+			err := createRun(tt.opts)
+			require.NoError(t, err)
+
+			assert.Equal(t, tt.wantOut, stdout.String())
+			assert.Equal(t, "", stderr.String())
+
+			if tt.wantEditorBody != "" {
+				assert.Equal(t, tt.wantEditorBody, capturedEditorBody)
+			}
+		})
+	}
+}
