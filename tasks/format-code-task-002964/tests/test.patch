diff --git a/usercase-test-coderl/test_momentum_agent.py b/usercase-test-coderl/test_momentum_agent.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_momentum_agent.py
@@ -0,0 +1,151 @@
+
+
+import math
+from numbers import Real
+
+import pytest
+
+from algotrading.agents.momentum_agent import Momentum_Agent
+
+
+def _compact_agent():
+    return Momentum_Agent(5, 2, 5, 5, 20, 80, 2, 5, 3)
+
+
+def _feed(agent, prices):
+    return [agent.step(price) for price in prices]
+
+
+def _assert_finite_number(value):
+    assert isinstance(value, Real)
+    assert math.isfinite(value)
+
+
+def test_buy_signal_session_reaches_positive_momentum_state():
+
+
+
+
+    agent = _compact_agent()
+
+    assert agent.step(7) == 0
+    assert agent.step(1) == 0
+    assert agent.step(1) == 0
+    assert agent.step(5) == 0
+    assert agent.step(2) == 1
+    assert agent.get_sma(2) == pytest.approx(3.5, rel=0, abs=1e-12)
+    assert agent.get_sma(5) == pytest.approx(3.2, rel=0, abs=1e-12)
+    assert agent.get_stoch_osc(5) == pytest.approx(16.666666666666668, rel=0, abs=1e-12)
+    macd_hist = agent.get_macd_hist(2, 5, 3, 2)
+
+    _assert_finite_number(macd_hist)
+    assert macd_hist > 0
+
+
+def test_sell_signal_session_reaches_negative_momentum_state():
+
+
+
+
+    agent = _compact_agent()
+
+    assert agent.step(1) == 0
+    assert agent.step(6) == 0
+    assert agent.step(7) == 0
+    assert agent.step(3) == 0
+    assert agent.step(6) == -1
+    assert agent.get_sma(2) == pytest.approx(4.5, rel=0, abs=1e-12)
+    assert agent.get_sma(5) == pytest.approx(4.6, rel=0, abs=1e-12)
+    assert agent.get_stoch_osc(5) == pytest.approx(83.33333333333333, rel=0, abs=1e-12)
+    macd_hist = agent.get_macd_hist(2, 5, 3, 6)
+
+    _assert_finite_number(macd_hist)
+    assert macd_hist < 0
+
+
+def test_full_window_hold_when_only_some_signal_conditions_match():
+
+
+
+
+    agent = _compact_agent()
+
+    assert agent.step(2) == 0
+    assert agent.step(3) == 0
+    assert agent.step(4) == 0
+    assert agent.step(5) == 0
+    assert agent.step(6) == 0
+    assert agent.get_sma(2) == pytest.approx(5.5, rel=0, abs=1e-12)
+    assert agent.get_sma(5) == pytest.approx(4.0, rel=0, abs=1e-12)
+    assert agent.get_stoch_osc(5) == pytest.approx(100.0, rel=0, abs=1e-12)
+    macd_hist = agent.get_macd_hist(2, 5, 3, 6)
+
+    _assert_finite_number(macd_hist)
+    assert macd_hist > 0
+
+
+def test_step_keeps_latest_window_after_more_than_window_size_prices():
+
+
+
+
+    agent = _compact_agent()
+
+    assert _feed(agent, [7, 1, 1, 5, 2, 10]) == [0, 0, 0, 0, 1, 0]
+    assert agent.get_sma(2) == pytest.approx(6.0, rel=0, abs=1e-12)
+    assert agent.get_sma(5) == pytest.approx(3.8, rel=0, abs=1e-12)
+    assert agent.get_stoch_osc(5) == pytest.approx(100.0, rel=0, abs=1e-12)
+    macd_hist = agent.get_macd_hist(2, 5, 3, 10)
+
+    _assert_finite_number(macd_hist)
+    assert macd_hist > 0
+
+
+def test_indicator_getters_expose_values_after_prices_are_fed():
+
+
+
+
+    agent = _compact_agent()
+
+    _feed(agent, [7, 1, 1, 5, 2])
+
+    assert agent.get_sma(2) == pytest.approx(3.5, rel=0, abs=1e-12)
+    stoch_osc = agent.get_stoch_osc(5)
+    _assert_finite_number(stoch_osc)
+    assert 0 <= stoch_osc <= 100
+    macd_hist = agent.get_macd_hist(2, 5, 3, 2)
+    _assert_finite_number(macd_hist)
+
+
+def test_separate_instances_do_not_share_price_memory():
+
+
+
+
+    first = _compact_agent()
+    second = _compact_agent()
+
+    assert _feed(first, [7, 1, 1, 5, 2]) == [0, 0, 0, 0, 1]
+    assert _feed(second, [1, 6, 7, 3]) == [0, 0, 0, 0]
+    assert second.step(6) == -1
+    assert first.get_sma(5) == pytest.approx(3.2, rel=0, abs=1e-12)
+    assert second.get_sma(5) == pytest.approx(4.6, rel=0, abs=1e-12)
+    assert first.get_stoch_osc(5) == pytest.approx(16.666666666666668, rel=0, abs=1e-12)
+    assert second.get_stoch_osc(5) == pytest.approx(83.33333333333333, rel=0, abs=1e-12)
+
+
+def test_long_prior_history_does_not_affect_latest_window_signal():
+
+
+
+
+    agent = _compact_agent()
+
+    for price in range(50, 150):
+        agent.step(price)
+
+
+    assert _feed(agent, [7, 1, 1, 5, 2])[-1] == 1
+    assert agent.get_sma(5) == pytest.approx(3.2, rel=0, abs=1e-12)
+    assert agent.get_stoch_osc(5) == pytest.approx(16.666666666666668, rel=0, abs=1e-12)
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
