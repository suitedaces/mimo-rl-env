+                file: requirements.txt
+                eggs:
+                  - ./global.egg
+            version: 1.0
+        """)
+        by_name = conf.get_target_conf('dev')
+        by_id = conf.get_target_conf(654321)
+        self.assertEqual(by_name.requirements_file, 'requirements-dev.txt')
+        self.assertEqual(by_id.requirements_file, 'requirements-dev.txt')
+        self.assertEqual(by_name.eggs, ['./dev.egg'])
