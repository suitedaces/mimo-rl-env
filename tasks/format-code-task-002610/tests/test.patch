+    def test_mixed_projects_isolation(self):
+
+        conf = self._get_conf_with_yml("""
+            projects:
+                a:
+                    id: 111
+                    requirements:
+                        file: a-reqs.txt
+                        eggs:
+                          - ./a.egg
+                b:
+                    id: 222
+            apikeys:
+                default: key
+            requirements:
+                file: global-reqs.txt
+                eggs:
+                  - ./global.egg
+            version: 1.0
+        """)
+        ta = conf.get_target_conf('a')
+        tb = conf.get_target_conf('b')
+        self.assertEqual(ta.requirements_file, 'a-reqs.txt')
+        self.assertEqual(ta.eggs, ['./a.egg'])
+        self.assertEqual(tb.requirements_file, 'global-reqs.txt')
+        self.assertEqual(tb.eggs, ['./global.egg'])
