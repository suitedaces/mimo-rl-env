+    def test_project_specific_requirements_file_overrides_global(self):
+
+        conf = self._get_conf_with_yml("""
+            projects:
+                prod: 123456
+                dev:
+                    id: 654321
+                    requirements:
+                        file: requirements-dev.txt
+            apikeys:
+                default: key
+            requirements:
+                file: requirements.txt
+            version: 1.0
+        """)
+
+        self.assertEqual(
+            conf.get_target_conf('dev').requirements_file,
+            'requirements-dev.txt'
+        )
+
+        self.assertEqual(
+            conf.get_target_conf('prod').requirements_file,
+            'requirements.txt'
+        )
+
+    def test_project_specific_eggs_overrides_global(self):
+        conf = self._get_conf_with_yml("""
+            projects:
+                prod: 123456
+                dev:
+                    id: 654321
+                    requirements:
+                        eggs:
+                          - ./dev_egg1.egg
+                          - ./dev_egg2.egg
+            apikeys:
+                default: key
+            requirements:
+                eggs:
+                  - ./global_egg.egg
+                file: requirements.txt
+            version: 1.0
+        """)
+        self.assertEqual(
+            conf.get_target_conf('dev').eggs,
+            ['./dev_egg1.egg', './dev_egg2.egg']
+        )
+        self.assertEqual(
