@@ -0,0 +1,228 @@
+import gc
+
+import pytest
+
+from lark import GrammarError, Lark
+
+
+FIXTURES = "/workspace/repo/usercase-test-coderl/fixtures"
+SOURCE_PATH = f"{FIXTURES}/usercase_anchor.py"
+
+
+def test_imported_rule_extend_adds_alternative_inside_existing_rule():
+
+
+
+
+    parser = Lark(
+        """
+        %import .grammars.ab (startab, A, B, expr)
+        %extend expr: B A
+        """,
+        start="startab",
+        source_path=SOURCE_PATH,
+    )
+
+
+    assert parser.parse("abab") is not None
+
+
+def test_multiple_rule_extends_accumulate_all_rule_alternatives():
+
+
+
+
+    parser = Lark(
+        """
+        start: x+
+        x: "a"
+        %extend x: "b"
+        %extend x: "c"
+        """
+    )
+
+
+    assert parser.parse("a") is not None
+    assert parser.parse("b") is not None
+    assert parser.parse("c") is not None
+    assert parser.parse("abcba") is not None
+
+
+def test_terminal_extend_changes_matching_where_terminal_is_used():
+
+
+
+
+    parser = Lark(
+        """
+        %import .grammars.ab (startab, A, B, expr)
+        %extend A: "c"
+        """,
+        start="startab",
+        source_path=SOURCE_PATH,
+    )
+
+
+    assert parser.parse("acbb") is not None
+
+
+def test_extending_undefined_symbol_fails_during_construction():
+
+
+
+
+    with pytest.raises(GrammarError) as excinfo:
+        Lark(
+            """
+            %extend missing: "b"
+            start: "a"
+            """
+        )
+
+
+    assert isinstance(excinfo.value, GrammarError)
+
+
+def test_extending_rule_as_terminal_fails_during_construction():
+
+
+
+
+    with pytest.raises(GrammarError) as excinfo:
+        Lark(
+            """
+            %import .grammars.rule_only.item -> ITEM
+            start: ITEM
+            %extend ITEM: "b"
+            """,
+            source_path=SOURCE_PATH,
+        )
+
+
+    assert isinstance(excinfo.value, GrammarError)
+
+
+def test_extending_terminal_as_rule_fails_during_construction():
+
+
+
+
+    with pytest.raises(GrammarError) as excinfo:
+        Lark(
+            """
+            %import .grammars.term_only.ITEM -> item
+            start: item
+            %extend item: "b"
+            """,
+            source_path=SOURCE_PATH,
+        )
+
+
+    assert isinstance(excinfo.value, GrammarError)
+
+
+def test_extending_template_with_different_parameter_list_fails_during_construction():
+
+
+
+
+    with pytest.raises(GrammarError) as excinfo:
+        Lark(
+            """
+            start: wrap{"a"}
+            wrap{x}: x
+            %extend wrap{x, y}: x y
+            """
+        )
+
+
+    assert isinstance(excinfo.value, GrammarError)
+
+
+def test_extending_declared_abstract_symbol_fails_during_construction():
+
+
+
+
+    with pytest.raises(GrammarError) as excinfo:
+        Lark(
+            """
+            start: A
+            %declare A
+            %extend A: "a"
+            """
+        )
+
+
+    assert isinstance(excinfo.value, GrammarError)
+
+
+def test_two_lark_instances_keep_extended_grammar_state_independent():
+
+
+
+
+    parser_a = Lark(
+        """
+        start: x+
+        x: "a"
+        %extend x: "b"
+        """
+    )
+    parser_b = Lark(
+        """
+        start: y+
+        y: "c"
+        %extend y: "d"
+        """
+    )
+
+
+    assert parser_a.parse("abba") is not None
+    assert parser_b.parse("cddc") is not None
+
+
+def test_repeated_public_construction_parse_and_cleanup_accepts_extended_rule():
+
+
+
+
+    grammar = """
+        %import .grammars.ab (startab, A, B, expr)
+        %extend expr: B A
+    """
+
+    for _ in range(100):
+        parser = Lark(grammar, start="startab", source_path=SOURCE_PATH)
+
+        assert parser.parse("abab") is not None
+        del parser
+        gc.collect()
+
+
+def test_reference_cleanup_path_is_idempotent_for_constructed_parser():
+
+
+
+
+    parser = Lark(
+        """
+        start: x
+        x: "a"
+        %extend x: "b"
+        """
+    )
+
+    assert parser.parse("b") is not None
+    del parser
+    gc.collect()
+    parser = Lark(
+        """
+        start: x
+        x: "a"
+        %extend x: "b"
+        """
+    )
+
+    assert parser.parse("b") is not None
+    gc.collect()
