index 2b5ac7dd4e9..441dd2a7abf 100644
--- a/tests/js/spec/components/organizations/globalSelectionHeader.spec.jsx
+++ b/tests/js/spec/components/organizations/globalSelectionHeader.spec.jsx
@@ -246,4 +246,87 @@ describe('GlobalSelectionHeader', function() {
       expect(globalActions.updateProjects).toHaveBeenCalledWith([3]);
     });
   });
+
+  describe('forceProject selection mode', function() {
+    function mountForcedProjectHeader({
+      routeSearch = '?project=1&environment=alpha-only&statsPeriod=14d',
+    } = {}) {
+      const initialData = initializeOrg({
+        organization: {features: ['global-views']},
+        projects: [
+          {
+            id: 1,
+            slug: 'alpha-project',
+            environments: ['alpha-only'],
+          },
+          {
+            id: 2,
+            slug: 'beta-project',
+            environments: ['beta-only'],
+          },
+        ],
+        router: {
+          location: {
+            query: {
+              project: '1',
+              environment: 'alpha-only',
+              statsPeriod: '14d',
+            },
+            search: routeSearch,
+          },
+        },
+      });
+
+      const wrapper = mount(
+        <GlobalSelectionHeader
+          organization={initialData.organization}
+          forceProject={initialData.organization.projects[0]}
+        />,
+        initialData.routerContext
+      );
+
+      return {initialData, wrapper};
+    }
+
+    it('limits environment options to the forced project', async function() {
+      const {wrapper} = mountForcedProjectHeader();
+
+      await wrapper.find('MultipleEnvironmentSelector HeaderItem').simulate('click');
+      await wrapper.update();
+
+      const labels = wrapper
+        .find('MultipleEnvironmentSelector EnvironmentSelectorItem')
+        .map(item => item.text());
+
+      expect(labels).toContain('alpha-only');
+      expect(labels).not.toContain('beta-only');
+    });
+
+    it('uses routed location search for the back to issues link', function() {
+      const originalUrl = `${window.location.pathname}${window.location.search}`;
+      window.history.pushState(
+        {},
+        '',
+        '/stale-location/?project=2&environment=beta-only&statsPeriod=24h'
+      );
+
+      try {
+        const routedSearch = '?project=1&environment=alpha-only&statsPeriod=14d';
+        const {wrapper} = mountForcedProjectHeader({
+          routeSearch: routedSearch,
+        });
+
+        const backLinkSearches = wrapper
+          .find('Link')
+          .map(link => link.prop('to'))
+          .filter(to => typeof to === 'string')
+          .map(to => new URL(to, 'http://example.test').search);
+
+        expect(backLinkSearches).toContain(routedSearch);
+        expect(backLinkSearches).not.toContain(window.location.search);
+      } finally {
+        window.history.pushState({}, '', originalUrl);
+      }
+    });
+  });
 });
