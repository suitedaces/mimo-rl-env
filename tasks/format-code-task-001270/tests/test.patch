diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,30 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export PATH="/opt/node-22/bin:$PATH"
+if [ ! -x node_modules/.bin/jest ]; then
+  yarn install --frozen-lockfile --ignore-engines --non-interactive
+fi
+
+
+JEST="node_modules/.bin/jest"
+TEST_FILES=(
+  tests/js/spec/components/organizations/globalSelectionHeader.spec.jsx
+  tests/js/spec/components/organizations/multipleEnvironmentSelector.spec.jsx
+)
+NEW_TEST_PATTERN='limits environment options to the forced project|uses routed location search for the back to issues link|will call onUpdate when project selection change causes invalid values'
+
+case "${1:-}" in
+  base)
+    "$JEST" "${TEST_FILES[@]}" --no-coverage --testNamePattern="^(?!.*(${NEW_TEST_PATTERN})).*$"
+    ;;
+  new)
+    "$JEST" "${TEST_FILES[@]}" --no-coverage --testNamePattern="${NEW_TEST_PATTERN}"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
