@@ -395,6 +395,105 @@ class TestFindInMap(TestCase):
                 "Production",
             )
 
+    def test_find_in_map_default_value_when_second_key_missing(self):
+        """Issue: 4-element FindInMap with DefaultValue should fall back to the
+        default when the top-level key is present in the mapping but the
+        second-level key is absent (mapping.get(top, {}).get(second) is None).
+        """
+        template_obj = convert_dict(
+            {
+                "Mappings": {
+                    "Roles": {
+                        "A": {"Subjects": ["repo:org/repo:ref:*"]},
+                    },
+                },
+            }
+        )
+        cfn = Template(
+            filename="", template=template_obj, regions=["us-east-1"]
+        )
+
+        m = _ForEachValueFnFindInMap(
+            "a", ["Roles", "A", "Source", {"DefaultValue": "Github"}]
+        )
+
+        self.assertEqual(m.value(cfn, None, False, True), "Github")
+
+    def test_find_in_map_default_value_returns_actual_value_when_present(self):
+        """Preservation: when the second-level key IS present, the actual
+        value is returned (DefaultValue is not used)."""
+        template_obj = convert_dict(
+            {
+                "Mappings": {
+                    "Roles": {
+                        "A": {
+                            "Subjects": ["repo:org/repo:ref:*"],
+                            "Source": "Jenkins",
+                        },
+                    },
+                },
+            }
+        )
+        cfn = Template(
+            filename="", template=template_obj, regions=["us-east-1"]
+        )
+
+        m = _ForEachValueFnFindInMap(
+            "a", ["Roles", "A", "Source", {"DefaultValue": "Github"}]
+        )
+
+
+        self.assertEqual(m.value(cfn, None, False, True), "Jenkins")
+
+    def test_find_in_map_no_list_fallback_raises_resolve_error_4_element(self):
+        """4-element FindInMap, default_on_resolver_failure=False,
+        second-level key missing, and no list value to fall back on:
+        the resolver must raise _ResolveError (not silently return None)."""
+        template_obj = convert_dict(
+            {
+                "Mappings": {
+                    "Roles": {
+                        "A": {"OnlyString": "value"},
+                    },
+                },
+            }
+        )
+        cfn = Template(
+            filename="", template=template_obj, regions=["us-east-1"]
+        )
+
+        m = _ForEachValueFnFindInMap(
+            "a", ["Roles", "A", "Source", {"DefaultValue": "Github"}]
+        )
+
+        self.assertEqual(m.value(cfn, None, False, True), "Github")
+
+        with self.assertRaises(_ResolveError):
+            m.value(cfn, None, False, False)
+
+    def test_find_in_map_no_default_no_list_fallback_raises_resolve_error(self):
+        """3-element FindInMap (no DefaultValue), top-level key present,
+        second-level key missing, no list value to fall back on: the
+        resolver must raise _ResolveError (not silently return None)."""
+        template_obj = convert_dict(
+            {
+                "Mappings": {
+                    "Roles": {
+                        "A": {"OnlyString": "value"},
+                    },
+                },
+            }
+        )
+        cfn = Template(
+            filename="", template=template_obj, regions=["us-east-1"]
+        )
+
+        m = _ForEachValueFnFindInMap("a", ["Roles", "A", "Source"])
+        with self.assertRaises(_ResolveError):
+            m.value(cfn, None, False, True)
+        with self.assertRaises(_ResolveError):
+            m.value(cfn, None, False, False)
+
 
