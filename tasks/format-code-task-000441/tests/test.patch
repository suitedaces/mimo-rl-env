+	ctrlfake "sigs.k8s.io/controller-runtime/pkg/client/fake"
+)
+
+func TestConfigAuditScannerScanResolvesDeploymentOwnerBeforeBuildingScanJob(t *testing.T) {
+	deploy := scannerOwnerDeployment("config-owner", corev1.NamespaceDefault, "7")
+	activeRS := scannerOwnerReplicaSet("config-owner-rs", corev1.NamespaceDefault, "7")
+	kubeClient := ctrlfake.NewClientBuilder().
+		WithScheme(starboard.NewScheme()).
+		WithObjects(deploy, activeRS).
+		Build()
+	plugin := &recordingConfigAuditPlugin{err: errors.New("stop before running scan job")}
+	pluginContext := starboard.NewPluginContext().
+		WithName("owner-test").
+		WithNamespace(starboard.NamespaceName).
+		WithClient(kubeClient).
+		WithServiceAccountName(starboard.ServiceAccountName).
+		Get()
+	scanner := configauditreport.NewScanner(
+		k8sfake.NewSimpleClientset(),
+		kubeClient,
+		plugin,
+		pluginContext,
+		starboard.ConfigData{},
+		kube.ScannerOpts{},
+	)
+
+	_, err := scanner.Scan(context.Background(), kube.Object{
+		Kind:      kube.KindDeployment,
+		Name:      deploy.Name,
+		Namespace: deploy.Namespace,
+	})
+
+	require.Error(t, err)
+	require.NotNil(t, plugin.seenObject)
+	assert.Equal(t, string(kube.KindReplicaSet), plugin.seenObject.GetObjectKind().GroupVersionKind().Kind)
+	assert.Equal(t, activeRS.Name, plugin.seenObject.GetName())
+	assert.Equal(t, activeRS.Namespace, plugin.seenObject.GetNamespace())
+}
+
+type recordingConfigAuditPlugin struct {
+	seenObject client.Object
+	err        error
+}
+
+func (p *recordingConfigAuditPlugin) Init(_ starboard.PluginContext) error {
+	return nil
+}
+
+func (p *recordingConfigAuditPlugin) GetScanJobSpec(_ starboard.PluginContext, obj client.Object) (corev1.PodSpec, []*corev1.Secret, error) {
+	p.seenObject = obj
+	return corev1.PodSpec{}, nil, p.err
+}
+
+func (p *recordingConfigAuditPlugin) ParseConfigAuditReportData(_ starboard.PluginContext, _ io.ReadCloser) (v1alpha1.ConfigAuditReportData, error) {
+	return v1alpha1.ConfigAuditReportData{}, nil
+}
+
+func (p *recordingConfigAuditPlugin) GetContainerName() string {
+	return "scanner"
+}
+
+func (p *recordingConfigAuditPlugin) GetConfigHash(_ starboard.PluginContext) (string, error) {
+	return "plugin-config", nil
+}
+
+func (p *recordingConfigAuditPlugin) SupportsKind(kind kube.Kind) bool {
+	return kind == kube.KindDeployment
+}
+
+func (p *recordingConfigAuditPlugin) IsReady(_ starboard.PluginContext) (bool, error) {
+	return true, nil
+}
