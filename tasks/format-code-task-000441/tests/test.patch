+func TestVulnerabilityScannerScanUsesResolvedOwnerForScanJobLabels(t *testing.T) {
+	deploy := vulnerabilityOwnerDeployment("vuln-owner", corev1.NamespaceDefault, "4")
+	activeRS := vulnerabilityOwnerReplicaSet("vuln-owner-rs", corev1.NamespaceDefault, "4")
+	kubeClient := ctrlfake.NewClientBuilder().
+		WithScheme(starboard.NewScheme()).
+		WithObjects(deploy, activeRS, &corev1.ServiceAccount{
+			ObjectMeta: metav1.ObjectMeta{
+				Name:      "default",
+				Namespace: deploy.Namespace,
+			},
+		}).
+		Build()
+	clientset := k8sfake.NewSimpleClientset()
+	var createdJob *batchv1.Job
+	clientset.PrependReactor("create", "jobs", func(action k8stesting.Action) (bool, runtime.Object, error) {
+		createAction, ok := action.(k8stesting.CreateAction)
+		require.True(t, ok)
+		job, ok := createAction.GetObject().(*batchv1.Job)
+		require.True(t, ok)
+		createdJob = job.DeepCopy()
+		return true, nil, apierrors.NewInternalError(errors.New("stop after capturing scan job"))
+	})
+
+	pluginContext := starboard.NewPluginContext().
+		WithName("owner-test").
+		WithNamespace(starboard.NamespaceName).
+		WithClient(kubeClient).
+		WithServiceAccountName(starboard.ServiceAccountName).
+		Get()
+	scanner := vulnerabilityreport.NewScanner(
+		clientset,
+		kubeClient,
+		&minimalVulnerabilityPlugin{},
+		pluginContext,
+		starboard.ConfigData{},
+		kube.ScannerOpts{},
+	)
+
+	_, err := scanner.Scan(context.Background(), kube.Object{
+		Kind:      kube.KindDeployment,
+		Name:      deploy.Name,
+		Namespace: deploy.Namespace,
+	})
+
+	require.Error(t, err)
+	require.NotNil(t, createdJob)
+	assert.Equal(t, string(kube.KindReplicaSet), createdJob.Labels[starboard.LabelResourceKind])
+	assert.Equal(t, activeRS.Name, createdJob.Labels[starboard.LabelResourceName])
+	assert.Equal(t, activeRS.Namespace, createdJob.Labels[starboard.LabelResourceNamespace])
+}
+
+type minimalVulnerabilityPlugin struct{}
+
+func (p *minimalVulnerabilityPlugin) Init(_ starboard.PluginContext) error {
+	return nil
+}
+
+func (p *minimalVulnerabilityPlugin) GetScanJobSpec(_ starboard.PluginContext, _ corev1.PodSpec, _ map[string]docker.Auth) (corev1.PodSpec, []*corev1.Secret, error) {
+	return corev1.PodSpec{
+		RestartPolicy: corev1.RestartPolicyNever,
+		Containers: []corev1.Container{{
+			Name:  "scanner",
+			Image: "scanner:latest",
+		}},
+	}, nil, nil
+}
+
+func (p *minimalVulnerabilityPlugin) ParseVulnerabilityReportData(_ starboard.PluginContext, _ string, _ io.ReadCloser) (v1alpha1.VulnerabilityReportData, error) {
+	return v1alpha1.VulnerabilityReportData{}, nil
+}
+
+func vulnerabilityOwnerDeployment(name, namespace, revision string) *appsv1.Deployment {
+	labels := map[string]string{"app": name}
+	return &appsv1.Deployment{
+		TypeMeta: metav1.TypeMeta{APIVersion: "apps/v1", Kind: "Deployment"},
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      name,
+			Namespace: namespace,
+			UID:       types.UID(name + "-uid"),
+			Labels:    labels,
+			Annotations: map[string]string{
+				"deployment.kubernetes.io/revision": revision,
+			},
+		},
+		Spec: appsv1.DeploymentSpec{
+			Selector: &metav1.LabelSelector{MatchLabels: labels},
+			Template: corev1.PodTemplateSpec{
+				ObjectMeta: metav1.ObjectMeta{Labels: labels},
+				Spec: corev1.PodSpec{Containers: []corev1.Container{{
+					Name:  "app",
+					Image: "nginx:1.16",
+				}}},
+			},
+		},
+	}
+}
+
+func vulnerabilityOwnerReplicaSet(name, namespace, revision string) *appsv1.ReplicaSet {
+	labels := map[string]string{"app": "vuln-owner"}
+	return &appsv1.ReplicaSet{
+		TypeMeta: metav1.TypeMeta{APIVersion: "apps/v1", Kind: "ReplicaSet"},
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      name,
+			Namespace: namespace,
+			UID:       types.UID(name + "-uid"),
+			Labels:    labels,
+			Annotations: map[string]string{
+				"deployment.kubernetes.io/revision": revision,
+			},
+		},
+		Spec: appsv1.ReplicaSetSpec{
+			Replicas: pointer.Int32Ptr(1),
+			Selector: &metav1.LabelSelector{MatchLabels: labels},
+			Template: corev1.PodTemplateSpec{
+				ObjectMeta: metav1.ObjectMeta{Labels: labels},
+				Spec: corev1.PodSpec{Containers: []corev1.Container{{
+					Name:  "app",
+					Image: "nginx:1.16",
+				}}},
+			},
+		},
+	}
+}
