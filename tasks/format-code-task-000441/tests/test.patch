+)
+
+func TestVulnerabilityScannerScanUsesExpectedOwnersThroughControllerChains(t *testing.T) {
+	ctx := context.Background()
+	namespace := corev1.NamespaceDefault
+	deploy := vulnerabilityChainDeployment("frontend", namespace, "2")
+	staleRS := vulnerabilityChainReplicaSet("frontend-rs-old", namespace, "1", map[string]string{"app": deploy.Name})
+	activeRS := vulnerabilityChainReplicaSet("frontend-rs-current", namespace, "2", map[string]string{"app": deploy.Name})
+	unrelatedRS := vulnerabilityChainReplicaSet("aaa-unrelated-rs-current", namespace, "2", map[string]string{"app": "unrelated"})
+	replicaSetPod := vulnerabilityChainPod("frontend-pod", namespace)
+	replicaSetPod.OwnerReferences = []metav1.OwnerReference{vulnerabilityChainControllerRef("apps/v1", "ReplicaSet", activeRS.Name, activeRS.UID)}
+
+	cronJob := vulnerabilityChainCronJob("nightly", namespace)
+	cronOwnedJob := vulnerabilityChainJob("nightly-123", namespace)
+	cronOwnedJob.OwnerReferences = []metav1.OwnerReference{vulnerabilityChainControllerRef("batch/v1beta1", "CronJob", cronJob.Name, cronJob.UID)}
+	jobPod := vulnerabilityChainPod("nightly-pod", namespace)
+	jobPod.OwnerReferences = []metav1.OwnerReference{vulnerabilityChainControllerRef("batch/v1", "Job", cronOwnedJob.Name, cronOwnedJob.UID)}
+
+	unmanagedJob := vulnerabilityChainJob("manual-job", namespace)
+	unmanagedJobPod := vulnerabilityChainPod("manual-job-pod", namespace)
+	unmanagedJobPod.OwnerReferences = []metav1.OwnerReference{vulnerabilityChainControllerRef("batch/v1", "Job", unmanagedJob.Name, unmanagedJob.UID)}
+
+	unmanagedPod := vulnerabilityChainPod("bare-pod", namespace)
+	customControlledPod := vulnerabilityChainPod("custom-controller-pod", namespace)
+	customControlledPod.OwnerReferences = []metav1.OwnerReference{
+		vulnerabilityChainControllerRef("example.test/v1", "TrainingJob", "custom-owner", types.UID("custom-owner-uid")),
+	}
+
+	testCases := []struct {
+		name         string
+		workload     kube.Object
+		expectedKind string
+		expectedName string
+	}{
+		{
+			name:         "Deployment scan is reported against active ReplicaSet",
+			workload:     kube.Object{Kind: kube.KindDeployment, Name: deploy.Name, Namespace: namespace},
+			expectedKind: string(kube.KindReplicaSet),
+			expectedName: activeRS.Name,
+		},
+		{
+			name:         "ReplicaSet-controlled Pod scan is reported against ReplicaSet",
+			workload:     kube.Object{Kind: kube.KindPod, Name: replicaSetPod.Name, Namespace: namespace},
+			expectedKind: string(kube.KindReplicaSet),
+			expectedName: activeRS.Name,
+		},
+		{
+			name:         "Pod scan through CronJob-owned Job is reported against CronJob",
+			workload:     kube.Object{Kind: kube.KindPod, Name: jobPod.Name, Namespace: namespace},
+			expectedKind: string(kube.KindCronJob),
+			expectedName: cronJob.Name,
+		},
+		{
+			name:         "Job scan through CronJob owner is reported against CronJob",
+			workload:     kube.Object{Kind: kube.KindJob, Name: cronOwnedJob.Name, Namespace: namespace},
+			expectedKind: string(kube.KindCronJob),
+			expectedName: cronJob.Name,
+		},
+		{
+			name:         "Pod scan through unmanaged Job is reported against Job",
+			workload:     kube.Object{Kind: kube.KindPod, Name: unmanagedJobPod.Name, Namespace: namespace},
+			expectedKind: string(kube.KindJob),
+			expectedName: unmanagedJob.Name,
+		},
+		{
+			name:         "unmanaged Pod scan remains reported against Pod",
+			workload:     kube.Object{Kind: kube.KindPod, Name: unmanagedPod.Name, Namespace: namespace},
+			expectedKind: string(kube.KindPod),
+			expectedName: unmanagedPod.Name,
+		},
+		{
+			name:         "custom-controlled Pod scan remains reported against Pod",
+			workload:     kube.Object{Kind: kube.KindPod, Name: customControlledPod.Name, Namespace: namespace},
+			expectedKind: string(kube.KindPod),
+			expectedName: customControlledPod.Name,
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			scanner, capturedJob := newCapturingVulnerabilityScanner(t,
+				deploy,
+				staleRS,
+				activeRS,
+				unrelatedRS,
+				replicaSetPod,
+				cronJob,
+				cronOwnedJob,
+				jobPod,
+				unmanagedJob,
+				unmanagedJobPod,
+				unmanagedPod,
+				customControlledPod,
+				&corev1.ServiceAccount{ObjectMeta: metav1.ObjectMeta{Name: "default", Namespace: namespace}},
+			)
+
+			_, err := scanner.Scan(ctx, tc.workload)
+
+			require.Error(t, err)
+			require.NotNil(t, *capturedJob)
+			assert.Equal(t, tc.expectedKind, (*capturedJob).Labels[starboard.LabelResourceKind])
+			assert.Equal(t, tc.expectedName, (*capturedJob).Labels[starboard.LabelResourceName])
+			assert.Equal(t, namespace, (*capturedJob).Labels[starboard.LabelResourceNamespace])
+		})
+	}
+}
+
+func TestVulnerabilityScannerScanFailsWhenDeploymentActiveChildIsMissing(t *testing.T) {
+	namespace := corev1.NamespaceDefault
+	deploy := vulnerabilityChainDeployment("missing-child", namespace, "99")
+	staleChild := vulnerabilityChainReplicaSet("missing-child-old", namespace, "1", map[string]string{"app": deploy.Name})
+	scanner, capturedJob := newCapturingVulnerabilityScanner(t, deploy, staleChild,
+		&corev1.ServiceAccount{ObjectMeta: metav1.ObjectMeta{Name: "default", Namespace: namespace}},
+	)
+
+	reports, err := scanner.Scan(context.Background(), kube.Object{
+		Kind:      kube.KindDeployment,
+		Name:      deploy.Name,
+		Namespace: namespace,
+	})
+
+	require.Error(t, err)
+	assert.Empty(t, reports)
+	assert.Nil(t, *capturedJob)
+}
+
+func TestVulnerabilityScannerScanUnsupportedWorkloadKindFailsClearly(t *testing.T) {
+	namespace := corev1.NamespaceDefault
+	configMap := &corev1.ConfigMap{
+		TypeMeta: metav1.TypeMeta{APIVersion: "v1", Kind: "ConfigMap"},
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "not-a-workload",
+			Namespace: namespace,
+		},
+	}
+	scanner, capturedJob := newCapturingVulnerabilityScanner(t, configMap)
+
+	reports, err := scanner.Scan(context.Background(), kube.Object{
+		Kind:      kube.KindConfigMap,
+		Name:      configMap.Name,
+		Namespace: namespace,
+	})
+
+	require.Error(t, err)
+	assert.Empty(t, reports)
+	assert.Nil(t, *capturedJob)
+	assert.NotEmpty(t, err.Error())
+}
+
+func newCapturingVulnerabilityScanner(t *testing.T, objects ...runtime.Object) (*vulnerabilityreport.Scanner, **batchv1.Job) {
+	t.Helper()
+	kubeClient := ctrlfake.NewClientBuilder().
+		WithScheme(starboard.NewScheme()).
+		WithRuntimeObjects(objects...).
+		Build()
+	clientset := k8sfake.NewSimpleClientset()
+	var createdJob *batchv1.Job
+	clientset.PrependReactor("create", "jobs", func(action k8stesting.Action) (bool, runtime.Object, error) {
+		createAction, ok := action.(k8stesting.CreateAction)
+		require.True(t, ok)
+		job, ok := createAction.GetObject().(*batchv1.Job)
+		require.True(t, ok)
+		createdJob = job.DeepCopy()
+		return true, nil, apierrors.NewInternalError(errors.New("stop after capturing scan job"))
+	})
+
+	pluginContext := starboard.NewPluginContext().
+		WithName("owner-test").
+		WithNamespace(starboard.NamespaceName).
+		WithClient(kubeClient).
+		WithServiceAccountName(starboard.ServiceAccountName).
+		Get()
+	scanner := vulnerabilityreport.NewScanner(
+		clientset,
+		kubeClient,
+		&chainVulnerabilityPlugin{},
+		pluginContext,
+		starboard.ConfigData{},
+		kube.ScannerOpts{},
+	)
+	return scanner, &createdJob
+}
+
+type chainVulnerabilityPlugin struct{}
+
+func (p *chainVulnerabilityPlugin) Init(_ starboard.PluginContext) error {
+	return nil
+}
+
+func (p *chainVulnerabilityPlugin) GetScanJobSpec(_ starboard.PluginContext, _ corev1.PodSpec, _ map[string]docker.Auth) (corev1.PodSpec, []*corev1.Secret, error) {
+	return corev1.PodSpec{
+		RestartPolicy: corev1.RestartPolicyNever,
+		Containers: []corev1.Container{{
+			Name:  "scanner",
+			Image: "scanner:latest",
+		}},
+	}, nil, nil
+}
+
+func (p *chainVulnerabilityPlugin) ParseVulnerabilityReportData(_ starboard.PluginContext, _ string, _ io.ReadCloser) (v1alpha1.VulnerabilityReportData, error) {
+	return v1alpha1.VulnerabilityReportData{}, nil
+}
