+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+npm install --ignore-scripts 2>&1
+npm run build 2>&1
+
+
+case "${1:-}" in
+  base)
+    npx mocha --inline-diffs --check-leaks --ui tdd --reporter dot --slow 200 --timeout 5000 test/expressions/literals/literal-string-expression.js
+    ;;
+  new)
+    npx mocha --inline-diffs --check-leaks --ui tdd --reporter dot --slow 200 --timeout 5000 test/expressions/literals/literal-string-expression.js
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
