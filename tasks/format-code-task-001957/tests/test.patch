+import React from 'react'
+import { act, cleanup, render } from '@react-facet/dom-fiber-testing-library'
+import {
+  createFacet,
+  Map,
+  Mount,
+  NO_VALUE,
+  Times,
+  Unwrap,
+  useFacetEffect,
+  useFacetMap,
+  With,
+} from '@react-facet/core'
+import type { Facet } from '@react-facet/core'
+
+const renderMountText = (initialValue: boolean, condition?: boolean) => {
+  const display = createFacet({ initialValue })
+  const props = condition === undefined ? { when: display } : { when: display, condition }
+
+  const result = render(React.createElement(Mount, props, React.createElement('div', null, 'Hello')))
+  return result.container.textContent
+}
+
+const renderTimesText = (countValue: number | typeof NO_VALUE) => {
+  const count = createFacet<number>({ initialValue: countValue })
+  const result = render(
+    React.createElement(Times, { count }, (index: number) => React.createElement('span', null, String(index))),
+  )
+  return result.container.textContent
+}
+
+describe('facet-aware React component helpers', () => {
+    afterEach(() => {
+      cleanup()
+    })
+
+    test('public helper exports are available from @react-facet/core', () => {
+
+
+
+
+
+      expect(Mount).toBeDefined()
+      expect(Map).toBeDefined()
+      expect(With).toBeDefined()
+      expect(Unwrap).toBeDefined()
+      expect(Times).toBeDefined()
+    })
+
+    test('Mount renders the child when the boolean facet is true', () => {
+
+
+
+
+      expect(renderMountText(true)).toBe('Hello')
+    })
+
+    test('Mount renders nothing when the boolean facet is false by default', () => {
+
+
+
+
+      expect(renderMountText(false)).toBe('')
+    })
+
+    test('Mount with condition false renders for false and unmounts after true', () => {
+
+
+
+
+      const display = createFacet({ initialValue: false })
+      const result = render(
+        React.createElement(
+          Mount,
+          { when: display, condition: false },
+          React.createElement('div', null, 'Empty list message'),
+        ),
+      )
+
+      expect(result.container.textContent).toBe('Empty list message')
+
+      act(() => {
+        display.set(true)
+      })
+
+      expect(result.container.textContent).toBe('')
+    })
+
+    test('Unwrap calls the render prop with a concrete string value', () => {
+
+
+
+
+      const calls: string[] = []
+      const data = createFacet({ initialValue: 'Foo' })
+      const result = render(
+        React.createElement(Unwrap, { data }, (value: string) => {
+          calls.push(value)
+          return React.createElement('span', null, `value:${value}`)
+        }),
+      )
+
+      expect(calls).toEqual(['Foo'])
+      expect(result.container.textContent).toBe('value:Foo')
+    })
+
+    test('Unwrap treats undefined and null as concrete values', () => {
+
+
+
+
+      const undefinedCalls: Array<string | undefined> = []
+      const nullCalls: Array<string | null> = []
+      const undefinedFacet = createFacet<string | undefined>({ initialValue: undefined })
+      const nullFacet = createFacet<string | null>({ initialValue: null })
+
+      const undefinedResult = render(
+        React.createElement(Unwrap, { data: undefinedFacet }, (value: string | undefined) => {
+          undefinedCalls.push(value)
+          return React.createElement('span', null, `undefined:${String(value)}`)
+        }),
+      )
+      const nullResult = render(
+        React.createElement(Unwrap, { data: nullFacet }, (value: string | null) => {
+          nullCalls.push(value)
+          return React.createElement('span', null, `null:${String(value)}`)
+        }),
+      )
+
+      expect(undefinedCalls).toEqual([undefined])
+      expect(nullCalls).toEqual([null])
+      expect(undefinedResult.container.textContent).toBe('undefined:undefined')
+      expect(nullResult.container.textContent).toBe('null:null')
+    })
+
+    test('Unwrap renders nothing and does not call children for NO_VALUE', () => {
+
+
+
+
+      const child = jest.fn(() => React.createElement('span', null, 'hidden'))
+      const data = createFacet<string>({ initialValue: NO_VALUE })
+      const result = render(React.createElement(Unwrap, { data }, child))
+
+      expect(child).toHaveBeenCalledTimes(0)
+      expect(result.container.textContent).toBe('')
+    })
+
+    test('With renders a non-null object through a refined facet', () => {
+
+
+
+
+      const userFacet = createFacet({ initialValue: { user: 'Zelda' } })
+      const calls: string[] = []
+
+      const Content = ({ data }: { data: Facet<{ user: string }> }) => {
+        useFacetEffect(
+          (value) => {
+            calls.push(value.user)
+          },
+          [],
+          [data],
+        )
+        return React.createElement('span', null, React.createElement('fast-text', { text: useFacetMap(({ user }) => user, [], [data]) }))
+      }
+
+      const result = render(React.createElement(With, { data: userFacet }, (data) => React.createElement(Content, { data })))
+
+
+      expect(calls).toContain('Zelda')
+      expect(result.container.textContent).toBe('Zelda')
+    })
+
+    test('With renders nothing for null, undefined, and NO_VALUE', () => {
+
+
+
+
+      const nullChild = jest.fn(() => React.createElement('span', null, 'null child'))
+      const undefinedChild = jest.fn(() => React.createElement('span', null, 'undefined child'))
+      const noValueChild = jest.fn(() => React.createElement('span', null, 'no value child'))
+
+      const nullResult = render(React.createElement(With, { data: createFacet<string | null>({ initialValue: null }) }, nullChild))
+      const undefinedResult = render(
+        React.createElement(With, { data: createFacet<string | undefined>({ initialValue: undefined }) }, undefinedChild),
+      )
+      const noValueResult = render(
+        React.createElement(With, { data: createFacet<string>({ initialValue: NO_VALUE }) }, noValueChild),
+      )
+
+      expect(nullChild).toHaveBeenCalledTimes(0)
+      expect(undefinedChild).toHaveBeenCalledTimes(0)
+      expect(noValueChild).toHaveBeenCalledTimes(0)
+      expect(nullResult.container.textContent).toBe('')
+      expect(undefinedResult.container.textContent).toBe('')
+      expect(noValueResult.container.textContent).toBe('')
+    })
+
+    test('With unmounts the child subtree after the facet changes to null', () => {
+
+
+
+
+      const data = createFacet<string | null>({ initialValue: 'mounted data' })
+      const result = render(
+        React.createElement(With, { data }, (nonNullFacet: Facet<string>) =>
+          React.createElement('span', null, React.createElement('fast-text', { text: nonNullFacet })),
+        ),
+      )
+
+      expect(result.container.textContent).toBe('mounted data')
+
+      act(() => {
+        data.set(null)
+      })
+
+      expect(result.container.textContent).toBe('')
+    })
+
+    test('Map renders five items with per-index value, index, and total length', () => {
+
+
+
+
+      type Item = { label: string }
+      const items = createFacet<Item[]>({
+        initialValue: [{ label: 'A' }, { label: 'B' }, { label: 'C' }, { label: 'D' }, { label: 'E' }],
+      })
+
+      const ItemView = ({ item, index, length }: { item: Facet<Item>; index: number; length: number }) =>
+        React.createElement(
+          'span',
+          null,
+          React.createElement('fast-text', { text: useFacetMap(({ label }) => `${index}/${length}:${label};`, [], [item]) }),
+        )
+
+      const result = render(
+        React.createElement(Map, { array: items }, (item: Facet<Item>, index: number, length: number) =>
+          React.createElement(ItemView, { item, index, length }),
+        ),
+      )
+
+      expect(result.container.textContent).toBe('0/5:A;1/5:B;2/5:C;3/5:D;4/5:E;')
+    })
+
+    test('Map updates mounted item count after shrinking from five objects to two', () => {
+
+
+
+
+      type Item = { value: string }
+      const items = createFacet<Item[]>({
+        initialValue: [{ value: 'one' }, { value: 'two' }, { value: 'three' }, { value: 'four' }, { value: 'five' }],
+      })
+
+      const ItemView = ({ item, index }: { item: Facet<Item>; index: number }) =>
+        React.createElement(
+          'span',
+          null,
+          React.createElement('fast-text', { text: useFacetMap(({ value }) => `${index}:${value}|`, [], [item]) }),
+        )
+
+      const result = render(
+        React.createElement(Map, { array: items }, (item: Facet<Item>, index: number) =>
+          React.createElement(ItemView, { item, index }),
+        ),
+      )
+      expect(result.container.textContent).toBe('0:one|1:two|2:three|3:four|4:five|')
+
+      act(() => {
+        items.set([{ value: 'one' }, { value: 'two' }])
+      })
+
+      expect(result.container.textContent).toBe('0:one|1:two|')
+    })
+
+    test('Map updates mounted item count after growing from one object to three', () => {
+
+
+
+
+      type Item = { value: string }
+      const items = createFacet<Item[]>({ initialValue: [{ value: 'red' }] })
+      const result = render(
+        React.createElement(Map, { array: items }, (_item: Facet<Item>, index: number, length: number) =>
+          React.createElement('span', null, `${index + 1}-of-${length};`),
+        ),
+      )
+      expect(result.container.textContent).toBe('1-of-1;')
+
+      act(() => {
+        items.set([{ value: 'red' }, { value: 'green' }, { value: 'blue' }])
+      })
+
+      expect(result.container.textContent).toBe('1-of-3;2-of-3;3-of-3;')
+    })
+
+    test('Map equalityCheck suppresses unchanged item facet notifications and reports changed positions', () => {
+
+
+
+
+      type Item = { value: string }
+      const items = createFacet<Item[]>({
+        initialValue: [{ value: 'a' }, { value: 'b' }, { value: 'c' }, { value: 'd' }, { value: 'e' }],
+      })
+      const observed = jest.fn()
+      const equalityCheck = () => {
+        let previous: string | undefined
+        return (current: Item) => {
+          if (current.value === previous) return true
+          previous = current.value
+          return false
+        }
+      }
+      const ItemObserver = ({ item }: { item: Facet<Item> }) => {
+        useFacetEffect(observed, [], [item])
+        return null
+      }
+
+      render(
+        React.createElement(Map, { array: items, equalityCheck }, (item: Facet<Item>) =>
+          React.createElement(ItemObserver, { item }),
+        ),
+      )
+
+      expect(observed.mock.calls.map(([value]) => value.value)).toEqual(['a', 'b', 'c', 'd', 'e'])
+
+      observed.mockClear()
+      act(() => {
+        items.set([{ value: 'changed' }, { value: 'b' }, { value: 'c' }, { value: 'd' }, { value: 'e' }])
+      })
+
+      expect(observed.mock.calls).toEqual([[{ value: 'changed' }]])
+    })
+
+    test('Times renders indexes from zero to count minus one with the total count', () => {
+
+
+
+
+      const count = createFacet({ initialValue: 3 })
+      const calls: Array<[number, number]> = []
+      const result = render(
+        React.createElement(Times, { count }, (index: number, total: number) => {
+          calls.push([index, total])
+          return React.createElement('span', null, String(index))
+        }),
+      )
+
+      expect(calls).toEqual([
+        [0, 3],
+        [1, 3],
+        [2, 3],
+      ])
+      expect(result.container.textContent).toBe('012')
+    })
+
+    test('Times renders nothing before the count facet has a concrete number', () => {
+
+
+
+
+      expect(renderTimesText(NO_VALUE)).toBe('')
+    })
+
+    test('Mount true behavior remains the spec-mandated render behavior', () => {
+
+      expect(renderMountText(true)).toBe('Hello')
+    })
+
+    test('Map passes caller-owned array items through item facets', () => {
+      const input = [{ value: 'alpha' }, { value: 'beta' }]
+      const items = createFacet({ initialValue: input })
+
+      const result = render(
+        React.createElement(Map, { array: items }, (item: Facet<{ value: string }>) =>
+          React.createElement('span', null, React.createElement('fast-text', { text: useFacetMap(({ value }) => value, [], [item]) })),
+        ),
+      )
+
+
+      expect(result.container.textContent).toBe('alphabeta')
+    })
+
+    test('Mount renders according to the current boolean facet value', () => {
+
+      expect(renderMountText(true)).toBe('Hello')
+      expect(renderMountText(false)).toBe('')
+    })
+
+    test('Times renders indexes after the count facet has a concrete number', () => {
+
+      expect(renderTimesText(2)).toBe('01')
+    })
+  })
