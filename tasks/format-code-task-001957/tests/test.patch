+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+exec node ./node_modules/jest/bin/jest.js \
+  --config '{"rootDir":"/workspace/repo","testEnvironment":"jsdom","testEnvironmentOptions":{"url":"http://localhost"},"moduleFileExtensions":["tsx","js","ts"],"setupFilesAfterEnv":["/workspace/repo/jest.setupTestFrameworkScriptFile.js"],"transform":{"^.+\\.[jt]sx?$":["babel-jest",{"rootMode":"upward"}]},"testPathIgnorePatterns":["/node_modules/","/dist/"]}' \
+  --runTestsByPath /workspace/repo/usercase-test-coderl/facet_mounting_helpers.test.ts \
+  --runInBand
