index 00000000..39c71537
--- /dev/null
+++ b/tests/test_asyncbackend_interface.py
@@ -0,0 +1,35 @@
+import asyncio
+import socket
+
+import pytest
+
+import dns._asyncbackend
+import dns._asyncio_backend
+
+
+def _await(coro):
+    return asyncio.get_event_loop().run_until_complete(coro)
+
+
+def test_base_backend_sleep_is_awaitable_and_fails_when_used_directly():
+    backend = dns._asyncbackend.Backend()
+    delay = backend.sleep(0)
+    assert hasattr(delay, "__await__")
+
+    with pytest.raises(Exception):
+        _await(delay)
+
+
+def test_base_datagram_socket_preserves_given_family():
+    first = dns._asyncbackend.DatagramSocket(socket.AF_INET)
+    assert first.family == socket.AF_INET
+
+    family_marker = object()
+    second = dns._asyncbackend.DatagramSocket(family_marker)
+    assert second.family is family_marker
+
+
+def test_asyncio_datagram_socket_preserves_family():
+    family = socket.AF_INET6 if hasattr(socket, "AF_INET6") else socket.AF_INET
+    datagram = dns._asyncio_backend.DatagramSocket(family, object(), object())
+    assert datagram.family == family
diff --git a/tests/test_makefile_type_targets.py b/tests/test_makefile_type_targets.py
new file mode 100644
index 00000000..7c7bddf2
--- /dev/null
+++ b/tests/test_makefile_type_targets.py
@@ -0,0 +1,46 @@
+from pathlib import Path
+
+
+def _target_body(target_name):
+    lines = Path("Makefile").read_text().splitlines()
+    header = f"{target_name}:"
+    body = []
+    in_target = False
+    for line in lines:
+        if not in_target:
+            if line == header:
+                in_target = True
+            continue
+        if line and not line.startswith(("\t", " ")):
+            break
+        if line.strip():
+            body.append(line.strip())
+    if not in_target:
+        raise AssertionError(f"missing Makefile target {target_name!r}")
+    return " ".join(body)
+
+
+def _tokens(target_name):
+    return _target_body(target_name).split()
+
+
+def _has_mypy_invocation(tokens):
+    return any(token == "mypy" or token.endswith("/mypy") for token in tokens)
+
+
+def test_potype_scope_is_dns_only():
+    tokens = _tokens("potype")
+
+    assert _has_mypy_invocation(tokens)
+    assert "dns/*.py" in tokens
+    assert "examples" not in tokens
+    assert "tests" not in tokens
+
+
+def test_potypetests_target_exists_for_examples_and_tests():
+    tokens = _tokens("potypetests")
+
+    assert _has_mypy_invocation(tokens)
+    assert "examples" in tokens
+    assert "tests" in tokens
+    assert "dns/*.py" not in tokens
diff --git a/tests/test_public_exports.py b/tests/test_public_exports.py
new file mode 100644
index 00000000..b0ac721e
--- /dev/null
+++ b/tests/test_public_exports.py
@@ -0,0 +1,18 @@
+import dns
+
+
+def test_dns_star_import_includes_public_type_modules(monkeypatch):
+
+
+    monkeypatch.setattr(dns, "__all__", ["dnssectypes", "zonetypes"])
+    namespace = {}
+    exec("from dns import *", namespace)
+    assert "dnssectypes" in namespace
+    assert "zonetypes" in namespace
+    assert getattr(namespace["dnssectypes"], "__name__", None) == "dns.dnssectypes"
+    assert getattr(namespace["zonetypes"], "__name__", None) == "dns.zonetypes"
+
+
+def test_dns_all_contains_public_type_modules():
+    exported = set(dns.__all__)
+    assert {"dnssectypes", "zonetypes"} <= exported
