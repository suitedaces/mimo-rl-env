--- a/tests/test_main.py
+++ b/tests/test_main.py
@@ -19,6 +19,7 @@ from typing import (
 from uuid import UUID, uuid4
 
 import pytest
+from typing_extensions import Annotated
 
 from pydantic import (
     BaseConfig,
@@ -2174,6 +2175,91 @@ def test_new_union_origin():
     }
 
 
+def test_annotated_class():
+    class PydanticModel(BaseModel):
+        foo: str = '123'
+
+    PydanticAlias = Annotated[PydanticModel, 'bar baz']
+
+    pa = PydanticAlias()
+    assert isinstance(pa, PydanticModel)
+    pa.__orig_class__ = 'typing-metadata-marker'
+    text = repr(pa)
+    assert 'foo' in text
+    assert '123' in text
+    assert '__orig_class__' not in text
+    assert 'typing-metadata-marker' not in text
+    assert pa.__orig_class__ == 'typing-metadata-marker'
+
+
+def test_annotated_model_alias_instantiates():
+    class AnnotatedModel(BaseModel):
+        foo: str = '123'
+
+    Alias = Annotated[AnnotatedModel, 'runtime metadata']
+
+    instance = Alias()
+    assert isinstance(instance, AnnotatedModel)
+    assert instance.foo == '123'
+
+    class OtherAnnotatedModel(BaseModel):
+        bar: int = 321
+
+    OtherAlias = Annotated[OtherAnnotatedModel, 'runtime metadata']
+
+    other = OtherAlias()
+    assert isinstance(other, OtherAnnotatedModel)
+    assert other.bar == 321
+    other.__annotations__ = {'bar': 'typing-metadata'}
+    assert other.__annotations__ == {'bar': 'typing-metadata'}
+
+
+@pytest.mark.parametrize(
+    'attr,value',
+    [
+        ('__annotations__', {'metadata': 'annotation-marker'}),
+        ('__orig_class__', 'typing-metadata-marker'),
+    ],
+)
+def test_supported_dunder_metadata_assignment_round_trips(attr, value):
+    class MetadataModel(BaseModel):
+        foo: str = '123'
+
+    model = MetadataModel()
+
+    setattr(model, attr, value)
+
+    assert getattr(model, attr) == value
+
+
+def test_supported_dunder_metadata_assignment_is_hidden_from_repr():
+    class ReprModel(BaseModel):
+        foo: str
+
+    model = ReprModel(foo='visible-field-value')
+    model.__orig_class__ = 'hidden-orig-marker'
+    model.__annotations__ = {'foo': 'hidden-annotation-marker'}
+
+    text = repr(model)
+
+    assert 'foo' in text
+    assert 'visible-field-value' in text
+    assert '__orig_class__' not in text
+    assert 'hidden-orig-marker' not in text
+    assert '__annotations__' not in text
+    assert 'hidden-annotation-marker' not in text
+
+
+def test_regular_unknown_attribute_assignment_still_fails():
+    class AssignmentModel(BaseModel):
+        foo: str = '123'
+
+    model = AssignmentModel()
+
+    with pytest.raises(ValueError):
+        model.not_a_field = 1
+
+
 @pytest.mark.parametrize(
     'ann',
     [Final, Final[int]],
