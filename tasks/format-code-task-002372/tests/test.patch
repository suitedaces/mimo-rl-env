@@ -0,0 +1,23 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+
+
+
+NEW_TESTS='test_annotated_class or test_annotated_model_alias_instantiates or test_supported_dunder_metadata_assignment_round_trips or test_supported_dunder_metadata_assignment_is_hidden_from_repr or test_regular_unknown_attribute_assignment_still_fails'
+
+case "${1:-}" in
+  base)
+    python3 -m pytest tests/test_main.py -x -k "not (${NEW_TESTS})"
+    ;;
+  new)
+    python3 -m pytest tests/test_main.py -x -k "${NEW_TESTS}"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
