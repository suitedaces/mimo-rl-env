diff --git a/tests/test_dev_requirements_config.py b/tests/test_dev_requirements_config.py
new file mode 100644
index 0000000..f8ffc5a
--- /dev/null
+++ b/tests/test_dev_requirements_config.py
@@ -0,0 +1,32 @@
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _read(relative_path):
+    return (ROOT / relative_path).read_text()
+
+
+def _active_lines(text):
+    return "\n".join(
+        line for line in text.splitlines()
+        if line.strip() and not line.lstrip().startswith("#")
+    )
+
+
+def _target_lines(text, prefix):
+    return [line for line in _active_lines(text).splitlines()
+            if line.lstrip().startswith(prefix)]
+
+
+def test_ci_docker_make_use_dev_requirements():
+    travis = _active_lines(_read(".travis.yml"))
+    dockerfile = _active_lines(_read("Dockerfile"))
+    makefile = _read("Makefile")
+
+    assert "dev-requirements.txt" in travis
+    assert "dev-requirements.txt" in dockerfile
+
+    docker_image_lines = _target_lines(makefile, "docker_image")
+    assert any("dev-requirements.txt" in line for line in docker_image_lines)
diff --git a/tests/test_pythonflow.py b/tests/test_pythonflow.py
index 977f057..cf08de1 100644
--- a/tests/test_pythonflow.py
+++ b/tests/test_pythonflow.py
@@ -249,3 +249,52 @@ def test_str_format(format_string, args, kwargs):
         output = pf.str_format(format_string, *args, **kwargs)
 
     assert graph(output) == format_string.format(*args, **kwargs)
+
+def test_operation_value_is_callable_with_graph_args_and_kwargs():
+    def formatter(value, suffix="", repeat=1):
+        return (value + suffix) * repeat
+
+    with pf.Graph() as graph:
+        func = pf.constant(formatter)
+        value = pf.constant("py")
+        suffix = pf.constant("flow")
+        repeat = pf.constant(2)
+        result = func(value, suffix=suffix, repeat=repeat)
+
+    assert graph(result) == "pyflowpyflow"
+
+
+def test_public_call_helper_invokes_evaluated_callable():
+    def transform(value, offset=0):
+        return value * 3 + offset
+
+    with pf.Graph() as graph:
+        func = pf.constant(transform)
+        value = pf.constant(11)
+        offset = pf.constant(4)
+        result = pf.call(func, value, offset=offset)
+
+    assert graph(result) == 37
+
+
+@pytest.mark.parametrize("bad_fetch", [42, object()])
+def test_invalid_fetch_raises_value_error_early(bad_fetch):
+    with pf.Graph() as graph:
+        pf.constant("unused", name="value")
+
+    with pytest.raises(ValueError):
+        graph(bad_fetch)
+
+
+@pytest.mark.parametrize("bad_context", [[("value", 1)], (("value", 1),)])
+def test_non_mapping_context_raises_value_error_early(bad_context):
+    with pf.Graph() as graph:
+        value = pf.constant("ok", name="value")
+
+    with pytest.raises(ValueError):
+        graph(value, context=bad_context)
+
+
+def test_lazy_import():
+    math = pf.lazy_import('math')
+    assert math.sqrt(9) == 3.0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,38 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+run_pytest() {
+  python3 - "$@" <<'PY'
+import collections
+import collections.abc
+
+collections.Mapping = collections.abc.Mapping
+collections.Sequence = collections.abc.Sequence
+import sys
+import pytest
+sys.exit(pytest.main(sys.argv[1:]))
+PY
+}
+
+case "${1:-}" in
+  base)
+    run_pytest -xvs tests/test_pythonflow.py \
+      --ignore=tests/test_dev_requirements_config.py \
+      -k 'not test_operation_value_is_callable_with_graph_args_and_kwargs and not test_public_call_helper_invokes_evaluated_callable and not test_invalid_fetch_raises_value_error_early and not test_non_mapping_context_raises_value_error_early and not test_lazy_import'
+    ;;
+  new)
+    run_pytest -xvs \
+      tests/test_pythonflow.py::test_operation_value_is_callable_with_graph_args_and_kwargs \
+      tests/test_pythonflow.py::test_public_call_helper_invokes_evaluated_callable \
+      tests/test_pythonflow.py::test_invalid_fetch_raises_value_error_early \
+      tests/test_pythonflow.py::test_non_mapping_context_raises_value_error_early \
+      tests/test_pythonflow.py::test_lazy_import \
+      tests/test_dev_requirements_config.py::test_ci_docker_make_use_dev_requirements
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
