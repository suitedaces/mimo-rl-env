+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+if ! command -v scons >/dev/null 2>&1; then
+    echo "scons is required but is not available in PATH" >&2
+    exit 127
+fi
+
+case "${1:-}" in
+    base)
+        if [ ! -f src/rdb/raft/SConscript ]; then
+            git submodule update --init src/rdb/raft 2>/dev/null || true
+        fi
+        scons_log="$(mktemp)"
+        scons --debug=sconscript --help > "${scons_log}" 2>&1 || true
+        if grep -q "done reading SConscript files" "${scons_log}"; then
+            rm -f "${scons_log}"
+            exit 0
+        fi
+        tail -100 "${scons_log}"
+        rm -f "${scons_log}"
+        exit 1
+        ;;
+    new)
+        python3 utils/tests/test_scons_mpi_env_exports.py -v
+        ;;
+    *)
+        echo "usage: $0 base|new" >&2
+        exit 2
+        ;;
+esac
