diff --git a/src/test/java/usercase_test_coderl/ListBindAdapterTest.java b/src/test/java/usercase_test_coderl/ListBindAdapterTest.java
new file mode 100644
--- /dev/null
+++ b/src/test/java/usercase_test_coderl/ListBindAdapterTest.java
@@ -0,0 +1,266 @@
+package usercase_test_coderl;
+
+import android.support.v7.widget.RecyclerView;
+import android.view.View;
+import android.view.ViewGroup;
+
+import com.yqritc.recyclerviewmultipleviewtypesadapter.DataBindAdapter;
+import com.yqritc.recyclerviewmultipleviewtypesadapter.DataBinder;
+import com.yqritc.recyclerviewmultipleviewtypesadapter.EnumListBindAdapter;
+import com.yqritc.recyclerviewmultipleviewtypesadapter.ListBindAdapter;
+
+import java.util.Arrays;
+import java.util.List;
+
+public final class ListBindAdapterTest {
+
+
+
+
+    private interface ThrowingRunnable {
+        void run() throws Throwable;
+    }
+
+    private static final class DummyHolder extends RecyclerView.ViewHolder {
+        DummyHolder() {
+            super(new View());
+        }
+    }
+
+    private static final class DummyBinder extends DataBinder<DummyHolder> {
+        private final int itemCount;
+
+        DummyBinder(DataBindAdapter dataBindAdapter, int itemCount) {
+            super(dataBindAdapter);
+            this.itemCount = itemCount;
+        }
+
+        @Override
+        public DummyHolder newViewHolder(ViewGroup parent) {
+            return new DummyHolder();
+        }
+
+        @Override
+        public void bindViewHolder(DummyHolder holder, int position) {
+        }
+
+        @Override
+        public int getItemCount() {
+            return itemCount;
+        }
+    }
+
+    private static final class RecordingListBindAdapter extends ListBindAdapter {
+        String lastNotifyMethod;
+        int lastNotifyPosition;
+        int lastNotifyCount;
+
+        @Override
+        public void notifyItemRangeChanged(int positionStart, int itemCount) {
+            lastNotifyMethod = "notifyItemRangeChanged";
+            lastNotifyPosition = positionStart;
+            lastNotifyCount = itemCount;
+        }
+
+        @Override
+        public void notifyItemRangeInserted(int positionStart, int itemCount) {
+            lastNotifyMethod = "notifyItemRangeInserted";
+            lastNotifyPosition = positionStart;
+            lastNotifyCount = itemCount;
+        }
+
+        @Override
+        public void notifyItemRangeRemoved(int positionStart, int itemCount) {
+            lastNotifyMethod = "notifyItemRangeRemoved";
+            lastNotifyPosition = positionStart;
+            lastNotifyCount = itemCount;
+        }
+    }
+
+    private enum SampleViewType {
+        FIRST,
+        SECOND,
+        THIRD
+    }
+
+    private static final class SampleEnumListAdapter extends EnumListBindAdapter<SampleViewType> {
+    }
+
+    public static void main(String[] args) throws Throwable {
+        testAddBinderOrderingAndLookups();
+        testAddAllBinderListAndInstanceIndependence();
+        testAddAllBinderVarargsAndEnumLookup();
+        testRangeNotificationTranslation();
+        testInvalidCallsThrowSpecificTypes();
+    }
+
+
+
+
+
+
+
+    private static void testAddBinderOrderingAndLookups() {
+        ListBindAdapter adapter = new ListBindAdapter();
+        DummyBinder first = new DummyBinder(adapter, 1);
+        DummyBinder second = new DummyBinder(adapter, 2);
+        DummyBinder third = new DummyBinder(adapter, 3);
+
+        adapter.addBinder(first);
+        adapter.addBinder(second);
+        adapter.addBinder(third);
+
+        assertEquals(Arrays.asList(first, second, third), adapter.getBinderList());
+        assertEquals(Integer.valueOf(6), Integer.valueOf(adapter.getItemCount()));
+
+        int[] expectedViewTypes = {0, 1, 1, 2, 2, 2};
+        for (int i = 0; i < expectedViewTypes.length; i++) {
+            assertEquals(Integer.valueOf(expectedViewTypes[i]), Integer.valueOf(adapter.getItemViewType(i)));
+        }
+
+        assertSame(second, adapter.getDataBinder(1));
+
+        int[] expectedBinderPositions = {0, 0, 1, 1};
+        int[] positions = {0, 1, 2, 4};
+        for (int i = 0; i < positions.length; i++) {
+            assertEquals(Integer.valueOf(expectedBinderPositions[i]), Integer.valueOf(adapter.getBinderPosition(positions[i])));
+        }
+
+        assertEquals(Integer.valueOf(1), Integer.valueOf(adapter.getPosition(second, 0)));
+        assertEquals(Integer.valueOf(2), Integer.valueOf(adapter.getPosition(second, 1)));
+        assertEquals(Integer.valueOf(5), Integer.valueOf(adapter.getPosition(third, 2)));
+    }
+
+
+
+
+
+
+    private static void testAddAllBinderListAndInstanceIndependence() {
+        ListBindAdapter a = new ListBindAdapter();
+        DummyBinder a1 = new DummyBinder(a, 1);
+        DummyBinder a2 = new DummyBinder(a, 2);
+        DummyBinder a3 = new DummyBinder(a, 3);
+        a.addAllBinder(Arrays.asList(a1, a2, a3));
+
+        ListBindAdapter b = new ListBindAdapter();
+        DummyBinder b1 = new DummyBinder(b, 4);
+        DummyBinder b2 = new DummyBinder(b, 5);
+        b.addAllBinder(Arrays.asList(b1, b2));
+
+        assertEquals(Arrays.asList(a1, a2, a3), a.getBinderList());
+        assertEquals(Integer.valueOf(6), Integer.valueOf(a.getItemCount()));
+        assertEquals(Arrays.asList(b1, b2), b.getBinderList());
+        assertEquals(Integer.valueOf(9), Integer.valueOf(b.getItemCount()));
+        assertEquals(Integer.valueOf(0), Integer.valueOf(b.getBinderPosition(4)));
+        assertEquals(Integer.valueOf(1), Integer.valueOf(b.getItemViewType(4)));
+        assertEquals(Integer.valueOf(6), Integer.valueOf(b.getPosition(b2, 2)));
+    }
+
+
+
+
+
+
+    private static void testAddAllBinderVarargsAndEnumLookup() {
+        ListBindAdapter adapter = new ListBindAdapter();
+        DummyBinder first = new DummyBinder(adapter, 2);
+        DummyBinder second = new DummyBinder(adapter, 3);
+        DummyBinder third = new DummyBinder(adapter, 4);
+        adapter.addAllBinder(first, second, third);
+
+        assertEquals(Arrays.asList(first, second, third), adapter.getBinderList());
+        assertEquals(Integer.valueOf(9), Integer.valueOf(adapter.getItemCount()));
+
+        SampleEnumListAdapter enumAdapter = new SampleEnumListAdapter();
+        DummyBinder enumFirst = new DummyBinder(enumAdapter, 1);
+        DummyBinder enumSecond = new DummyBinder(enumAdapter, 2);
+        DummyBinder enumThird = new DummyBinder(enumAdapter, 3);
+        enumAdapter.addAllBinder(enumFirst, enumSecond, enumThird);
+
+        assertEquals(Integer.valueOf(6), Integer.valueOf(enumAdapter.getItemCount()));
+        assertSame(enumSecond, enumAdapter.getDataBinder(SampleViewType.SECOND));
+    }
+
+
+
+
+
+
+    private static void testRangeNotificationTranslation() {
+        RecordingListBindAdapter adapter = new RecordingListBindAdapter();
+        DummyBinder first = new DummyBinder(adapter, 1);
+        DummyBinder second = new DummyBinder(adapter, 2);
+        DummyBinder third = new DummyBinder(adapter, 3);
+        adapter.addAllBinder(first, second, third);
+
+        second.notifyBinderItemRangeChanged(1, 2);
+        assertEquals("notifyItemRangeChanged", adapter.lastNotifyMethod);
+        assertEquals(Integer.valueOf(2), Integer.valueOf(adapter.lastNotifyPosition));
+        assertEquals(Integer.valueOf(2), Integer.valueOf(adapter.lastNotifyCount));
+
+        third.notifyBinderItemRangeInserted(0, 3);
+        assertEquals("notifyItemRangeInserted", adapter.lastNotifyMethod);
+        assertEquals(Integer.valueOf(3), Integer.valueOf(adapter.lastNotifyPosition));
+        assertEquals(Integer.valueOf(3), Integer.valueOf(adapter.lastNotifyCount));
+
+        first.notifyBinderItemRangeRemoved(0, 1);
+        assertEquals("notifyItemRangeRemoved", adapter.lastNotifyMethod);
+        assertEquals(Integer.valueOf(0), Integer.valueOf(adapter.lastNotifyPosition));
+        assertEquals(Integer.valueOf(1), Integer.valueOf(adapter.lastNotifyCount));
+    }
+
+
+
+
+
+
+    private static void testInvalidCallsThrowSpecificTypes() throws Throwable {
+        final ListBindAdapter adapter = new ListBindAdapter();
+        DummyBinder first = new DummyBinder(adapter, 1);
+        DummyBinder second = new DummyBinder(adapter, 2);
+        DummyBinder third = new DummyBinder(adapter, 3);
+        adapter.addAllBinder(first, second, third);
+
+        assertThrows(IllegalArgumentException.class, new ThrowingRunnable() {
+            @Override
+            public void run() throws Throwable {
+                adapter.getItemViewType(6);
+            }
+        });
+
+        assertThrows(IllegalStateException.class, new ThrowingRunnable() {
+            @Override
+            public void run() throws Throwable {
+                adapter.getPosition(new DummyBinder(adapter, 1), 0);
+            }
+        });
+    }
+
+    private static void assertSame(Object expected, Object actual) {
+        if (expected != actual) {
+            throw new AssertionError("expected same instance but got different objects");
+        }
+    }
+
+    private static void assertEquals(Object expected, Object actual) {
+        if (expected == null ? actual != null : !expected.equals(actual)) {
+            throw new AssertionError("expected " + expected + " but was " + actual);
+        }
+    }
+
+    private static void assertThrows(Class<? extends Throwable> expectedType, ThrowingRunnable action)
+            throws Throwable {
+        try {
+            action.run();
+        } catch (Throwable t) {
+
+            if (!expectedType.isInstance(t)) {
+                throw new AssertionError("expected " + expectedType.getName() + " but was "
+                        + t.getClass().getName());
+            }
+            return;
+        }
+        throw new AssertionError("expected " + expectedType.getName() + " to be thrown");
+    }
+}
