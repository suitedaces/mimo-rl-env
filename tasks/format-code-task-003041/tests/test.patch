+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+tmp_dir="$(mktemp -d)"
+trap 'rm -rf "$tmp_dir"' EXIT
+
+mkdir -p "$tmp_dir/src/android/support/v7/widget" \
+         "$tmp_dir/src/android/view" \
+         "$tmp_dir/classes"
+
+cat > "$tmp_dir/src/android/view/View.java" <<'JAVA'
+package android.view;
+
+public class View {
+}
+JAVA
+
+cat > "$tmp_dir/src/android/view/ViewGroup.java" <<'JAVA'
+package android.view;
+
+public class ViewGroup extends View {
+}
+JAVA
+
+cat > "$tmp_dir/src/android/support/v7/widget/RecyclerView.java" <<'JAVA'
+package android.support.v7.widget;
+
+import android.view.View;
+import android.view.ViewGroup;
+
+public class RecyclerView {
+    public static abstract class ViewHolder {
+        private final View itemView;
+
+        public ViewHolder(View itemView) {
+            this.itemView = itemView;
+        }
+
+        public View getItemView() {
+            return itemView;
+        }
+
+        public int getItemViewType() {
+            return 0;
+        }
+    }
+
+    public abstract static class Adapter<VH extends ViewHolder> {
+        public abstract VH onCreateViewHolder(ViewGroup parent, int viewType);
+
+        public abstract void onBindViewHolder(VH holder, int position);
+
+        public abstract int getItemCount();
+
+        public int getItemViewType(int position) {
+            return 0;
+        }
+
+        public void notifyDataSetChanged() {
+        }
+
+        public void notifyItemChanged(int position) {
+        }
+
+        public void notifyItemRangeChanged(int positionStart, int itemCount) {
+        }
+
+        public void notifyItemInserted(int position) {
+        }
+
+        public void notifyItemMoved(int fromPosition, int toPosition) {
+        }
+
+        public void notifyItemRangeInserted(int positionStart, int itemCount) {
+        }
+
+        public void notifyItemRemoved(int position) {
+        }
+
+        public void notifyItemRangeRemoved(int positionStart, int itemCount) {
+        }
+    }
+}
+JAVA
+
+
+javac -d "$tmp_dir/classes" \
+    "$tmp_dir/src/android/view/View.java" \
+    "$tmp_dir/src/android/view/ViewGroup.java" \
+    "$tmp_dir/src/android/support/v7/widget/RecyclerView.java" \
+    library/src/main/java/com/yqritc/recyclerviewmultipleviewtypesadapter/*.java \
+    src/test/java/usercase_test_coderl/ListBindAdapterTest.java
+
+exec java -cp "$tmp_dir/classes" usercase_test_coderl.ListBindAdapterTest
