+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+node build-packages.mjs utils >/dev/null
+node build-packages.mjs core >/dev/null
+node build-packages.mjs validator-js >/dev/null
+node build-packages.mjs sqlite3 >/dev/null
+
+exec ./node_modules/.bin/mocha /workspace/repo/usercase-test-coderl/model-default-primary-key.test.js --reporter spec --timeout 30000 --exit
