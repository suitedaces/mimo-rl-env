diff --git a/usercase-test-coderl/model-default-primary-key.test.js b/usercase-test-coderl/model-default-primary-key.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/model-default-primary-key.test.js
@@ -0,0 +1,267 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const { Sequelize, Model, DataTypes } = require('@sequelize/core');
+const { SqliteDialect } = require('@sequelize/sqlite3');
+
+function createSequelize(storage = ':memory:', extraOptions = {}) {
+  return new Sequelize({
+    dialect: SqliteDialect,
+    storage,
+    logging: false,
+    ...extraOptions,
+  });
+}
+
+function attributeNames(ModelClass) {
+  return [...ModelClass.modelDefinition.attributes.keys()];
+}
+
+function registryNames(sequelize) {
+  return [...sequelize.models].map(model => model.name);
+}
+
+function primaryKeyNames(ModelClass) {
+  return attributeNames(ModelClass).filter(attributeName => {
+    return ModelClass.modelDefinition.attributes.get(attributeName)?.primaryKey === true;
+  });
+}
+
+function assertDefaultIdAttribute(ModelClass) {
+  const idAttribute = ModelClass.modelDefinition.attributes.get('id');
+  assert.ok(idAttribute);
+  assert.equal(idAttribute.attributeName, 'id');
+  assert.match(idAttribute.type.toSql(), /int/i);
+  assert.equal(idAttribute.allowNull, false);
+  assert.equal(idAttribute.primaryKey, true);
+  assert.equal(idAttribute.autoIncrement, true);
+  assert.equal(idAttribute._autoGenerated, true);
+}
+
+function assertUserAttributePresent(ModelClass, attributeName) {
+  const attribute = ModelClass.modelDefinition.attributes.get(attributeName);
+  assert.ok(attribute);
+  assert.equal(attribute.attributeName, attributeName);
+}
+
+describe('usercase default primary key model definition', () => {
+  it('adds an auto generated id before user attributes when using sequelize.define', () => {
+
+
+
+
+    const sequelize = createSequelize();
+    assert.deepEqual(registryNames(sequelize), []);
+
+    const User = sequelize.define('User', { name: DataTypes.STRING }, { timestamps: false });
+
+
+    assert.equal(registryNames(sequelize).includes('User'), true);
+    assert.equal(User.primaryKeyAttribute, 'id');
+
+    assert.deepEqual(primaryKeyNames(User), ['id']);
+    assert.deepEqual(attributeNames(User), ['id', 'name']);
+
+    assert.equal(Object.hasOwn(User.modelDefinition.rawAttributes, 'id'), true);
+    assertDefaultIdAttribute(User);
+
+    assertUserAttributePresent(User, 'name');
+  });
+
+  it('adds the same auto generated id when using Model.init', () => {
+
+
+
+
+    const sequelize = createSequelize();
+    class InitUser extends Model {}
+
+    assert.deepEqual(registryNames(sequelize), []);
+    InitUser.init({ name: DataTypes.STRING }, { sequelize, timestamps: false });
+
+
+    assert.equal(registryNames(sequelize).includes('InitUser'), true);
+    assert.equal(InitUser.primaryKeyAttribute, 'id');
+
+    assert.deepEqual(primaryKeyNames(InitUser), ['id']);
+    assert.deepEqual(attributeNames(InitUser), ['id', 'name']);
+
+    assert.equal(Object.hasOwn(InitUser.modelDefinition.rawAttributes, 'id'), true);
+    assertDefaultIdAttribute(InitUser);
+
+    assertUserAttributePresent(InitUser, 'name');
+  });
+
+  it('does not add id when noPrimaryKey is true', () => {
+
+
+
+
+    const sequelize = createSequelize();
+
+    const NoPk = sequelize.define(
+      'NoPk',
+      { name: DataTypes.STRING },
+      { timestamps: false, noPrimaryKey: true },
+    );
+
+
+    assert.equal(registryNames(sequelize).includes('NoPk'), true);
+    assert.equal(NoPk.primaryKeyAttribute, null);
+
+    assert.deepEqual(primaryKeyNames(NoPk), []);
+    assert.deepEqual(attributeNames(NoPk), ['name']);
+    assert.equal(NoPk.modelDefinition.attributes.get('id'), undefined);
+
+    assertUserAttributePresent(NoPk, 'name');
+  });
+
+  it('uses a declared non-id primary key without adding default id', () => {
+
+
+
+
+    const sequelize = createSequelize();
+
+    const Natural = sequelize.define(
+      'Natural',
+      {
+        slug: { type: DataTypes.STRING, primaryKey: true },
+        name: DataTypes.STRING,
+      },
+      { timestamps: false },
+    );
+
+
+    assert.equal(registryNames(sequelize).includes('Natural'), true);
+    assert.equal(Natural.primaryKeyAttribute, 'slug');
+
+    assert.deepEqual(primaryKeyNames(Natural), ['slug']);
+
+    assert.deepEqual(new Set(attributeNames(Natural)), new Set(['slug', 'name']));
+    assert.equal(Natural.modelDefinition.attributes.get('id'), undefined);
+
+    assert.equal(Natural.modelDefinition.attributes.get('slug').primaryKey, true);
+  });
+
+  it('keeps an explicit id attribute when primaryKey is explicitly false', () => {
+
+
+
+
+    const sequelize = createSequelize();
+
+    const ExplicitNonPkId = sequelize.define(
+      'ExplicitNonPkId',
+      {
+        id: { type: DataTypes.INTEGER, primaryKey: false },
+        name: DataTypes.STRING,
+      },
+      { timestamps: false },
+    );
+
+
+    assert.equal(registryNames(sequelize).includes('ExplicitNonPkId'), true);
+    assert.equal(ExplicitNonPkId.primaryKeyAttribute, null);
+
+    assert.deepEqual(primaryKeyNames(ExplicitNonPkId), []);
+    assert.deepEqual(attributeNames(ExplicitNonPkId), ['id', 'name']);
+
+    assert.equal(ExplicitNonPkId.modelDefinition.attributes.get('id').primaryKey, false);
+    assert.notEqual(ExplicitNonPkId.modelDefinition.attributes.get('id')._autoGenerated, true);
+  });
+
+  it('throws a definition error when id omits primaryKey', () => {
+
+
+
+
+    const sequelize = createSequelize();
+
+    assert.throws(
+      () => {
+        sequelize.define(
+          'BadId',
+          { id: DataTypes.INTEGER, name: DataTypes.STRING },
+          { timestamps: false },
+        );
+      },
+      error => {
+
+        assert.ok(error instanceof Error);
+        assert.match(error.message, /\bid\b/i);
+        assert.match(error.message, /primaryKey/);
+        assert.match(error.message, /not set/i);
+        assert.match(error.message, /true/i);
+        assert.match(error.message, /false/i);
+        return true;
+      },
+    );
+
+    assert.equal(registryNames(sequelize).includes('BadId'), false);
+  });
+
+  it('keeps model-definition state independent between Sequelize instances', () => {
+
+
+
+
+    const a = createSequelize();
+    const b = createSequelize();
+
+    const Alpha = a.define('Alpha', { name: DataTypes.STRING }, { timestamps: false });
+    const Beta = a.define('Beta', { name: DataTypes.STRING }, { timestamps: false });
+    const Solo = b.define('Solo', { name: DataTypes.STRING }, { timestamps: false });
+
+
+    assert.deepEqual(new Set(registryNames(a)), new Set(['Alpha', 'Beta']));
+    assert.deepEqual(new Set(registryNames(b)), new Set(['Solo']));
+    assert.equal(Alpha.primaryKeyAttribute, 'id');
+    assert.equal(Beta.primaryKeyAttribute, 'id');
+    assert.equal(Solo.primaryKeyAttribute, 'id');
+    assert.deepEqual(attributeNames(Alpha), ['id', 'name']);
+    assert.deepEqual(attributeNames(Beta), ['id', 'name']);
+    assert.deepEqual(attributeNames(Solo), ['id', 'name']);
+  });
+
+  it('respects noPrimaryKey when using Model.init', () => {
+
+
+
+
+    const sequelize = createSequelize();
+    class InitNoPk extends Model {}
+
+
+    InitNoPk.init({ name: DataTypes.STRING }, { sequelize, timestamps: false, noPrimaryKey: true });
+    assert.equal(InitNoPk.primaryKeyAttribute, null);
+    assert.deepEqual(primaryKeyNames(InitNoPk), []);
+    assert.equal(InitNoPk.modelDefinition.attributes.get('id'), undefined);
+    assert.deepEqual(attributeNames(InitNoPk), ['name']);
+  });
+
+  it('keeps an explicitly declared id primary key without adding another default id', () => {
+
+
+
+
+    const sequelize = createSequelize();
+
+    const ExplicitPkId = sequelize.define(
+      'ExplicitPkId',
+      {
+        id: { type: DataTypes.STRING, primaryKey: true },
+        name: DataTypes.STRING,
+      },
+      { timestamps: false },
+    );
+
+
+    assert.equal(ExplicitPkId.primaryKeyAttribute, 'id');
+    assert.deepEqual(primaryKeyNames(ExplicitPkId), ['id']);
+    assert.deepEqual(attributeNames(ExplicitPkId), ['id', 'name']);
+    assert.equal(ExplicitPkId.modelDefinition.attributes.get('id').primaryKey, true);
+
+    assert.match(ExplicitPkId.modelDefinition.attributes.get('id').type.toSql(), /text|char|string/i);
+  });
+});
