diff --git a/test/schema-feature.test.js b/test/schema-feature.test.js
index 6d0f2ae0..c54a55dd 100644
--- a/test/schema-feature.test.js
+++ b/test/schema-feature.test.js
@@ -1755,3 +1755,118 @@ test('Should coerce the array if the default validator is used', async t => {
     t.error(err)
   }
 })
+
+test('response schema without status code throws helpful error (issue repro)', t => {
+  t.plan(4)
+  const fastify = Fastify()
+
+
+
+  fastify.route({
+    url: '/',
+    method: 'GET',
+    schema: {
+      response: {
+        type: 'array'
+      }
+    },
+    handler: (req, reply) => {
+      reply.send([])
+    }
+  })
+
+  fastify.ready(err => {
+    t.ok(err, 'an error must be thrown on ready')
+
+
+    t.match(err.message, /nested/i, 'error mentions nesting')
+    t.match(err.message, /status code|response code/i, 'error mentions status/response code')
+    t.notMatch(err.message, /data.properties/i, 'no longer the cryptic JSON-schema error')
+  })
+})
+
+test('response schema with valid 3-digit status code 200 works', t => {
+  t.plan(3)
+  const fastify = Fastify()
+
+  fastify.get('/', {
+    schema: {
+      response: {
+        200: {
+          type: 'object',
+          properties: {
+            hello: { type: 'string' }
+          }
+        }
+      }
+    },
+    handler: (req, reply) => reply.send({ hello: 'world', extra: 'dropped' })
+  })
+
+  fastify.inject('/', (err, res) => {
+    t.error(err)
+    t.equal(res.statusCode, 200)
+    t.same(res.json(), { hello: 'world' })
+  })
+})
+
+test('response schema with 2xx shorthand works', t => {
+  t.plan(3)
+  const fastify = Fastify()
+
+  fastify.get('/', {
+    schema: {
+      response: {
+        '2xx': {
+          type: 'object',
+          properties: {
+            hello: { type: 'string' }
+          }
+        }
+      }
+    },
+    handler: (req, reply) => reply.send({ hello: 'world', extra: 'dropped' })
+  })
+
+  fastify.inject('/', (err, res) => {
+    t.error(err)
+    t.equal(res.statusCode, 200)
+    t.same(res.json(), { hello: 'world' })
+  })
+})
+
+test('empty response schema object does not throw', t => {
+  t.plan(1)
+  const fastify = Fastify()
+
+  fastify.get('/', {
+    schema: {
+      response: {}
+    },
+    handler: (req, reply) => reply.send({ ok: true })
+  })
+
+  fastify.ready(err => {
+    t.error(err)
+  })
+})
+
+test('invalid status code key alongside valid key still throws', t => {
+  t.plan(2)
+  const fastify = Fastify()
+
+  fastify.get('/', {
+    schema: {
+      response: {
+        200: { type: 'object', properties: { hello: { type: 'string' } } },
+        notACode: { type: 'string' }
+      }
+    },
+    handler: (req, reply) => reply.send({ hello: 'world' })
+  })
+
+  fastify.ready(err => {
+    t.ok(err, 'an error is thrown when any key is not a valid status code')
+    t.match(err.message, /nested/i, 'error mentions nesting')
+  })
+})
