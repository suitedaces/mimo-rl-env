index 000000000..7e4bba0d5
--- /dev/null
+++ b/spotbugs-tests/src/test/java/edu/umd/cs/findbugs/filter/NestedDisabledMatcherTest.java
@@ -0,0 +1,104 @@
+
+
+
+
+
+
+
+
+package edu.umd.cs.findbugs.filter;
+
+import java.io.ByteArrayOutputStream;
+import java.io.ByteArrayInputStream;
+import java.nio.charset.StandardCharsets;
+
+import edu.umd.cs.findbugs.BugInstance;
+
+
+public class NestedDisabledMatcherTest {
+
+    public static void main(String[] args) throws Exception {
+        NestedDisabledMatcherTest test = new NestedDisabledMatcherTest();
+        test.disabledLeafIsIgnoredInsideAnd();
+        test.disabledGroupIsIgnoredInsideMatch();
+        test.disabledBranchIsIgnoredInsideOrAndNot();
+        test.topLevelDisablementStillWorks();
+        test.nestedDisablementSurvivesXmlRoundTrip();
+    }
+
+    void disabledLeafIsIgnoredInsideAnd() throws Exception {
+        Filter filter = parse("<Match><And>"
+                + "<BugPattern name=\"OTHER_PATTERN\" disabled=\"true\"/>"
+                + "<Class name=\"example.Target\"/>"
+                + "</And></Match>");
+
+        BugInstance bug = new BugInstance("UUF_UNUSED_FIELD", 1).addClass("example.Target");
+        check(filter.match(bug), "disabled leaf must not make And fail");
+
+        BugInstance otherClass = new BugInstance("UUF_UNUSED_FIELD", 1).addClass("example.Other");
+        check(!filter.match(otherClass), "enabled class matcher must remain effective");
+    }
+
+    void disabledGroupIsIgnoredInsideMatch() throws Exception {
+        Filter filter = parse("<Match>"
+                + "<And disabled=\"true\"><BugPattern name=\"OTHER_PATTERN\"/></And>"
+                + "<Class name=\"example.Target\"/>"
+                + "</Match>");
+
+        BugInstance target = new BugInstance("UUF_UNUSED_FIELD", 1).addClass("example.Target");
+        check(filter.match(target), "disabled group must be ignored");
+
+        BugInstance otherClass = new BugInstance("UUF_UNUSED_FIELD", 1).addClass("example.Other");
+        check(!filter.match(otherClass), "enabled class matcher must remain effective");
+    }
+
+    void disabledBranchIsIgnoredInsideOrAndNot() throws Exception {
+        Filter orFilter = parse("<Match><Or>"
+                + "<BugPattern name=\"UUF_UNUSED_FIELD\" disabled=\"true\"/>"
+                + "<BugPattern name=\"OTHER_PATTERN\"/>"
+                + "</Or></Match>");
+        BugInstance bug = new BugInstance("UUF_UNUSED_FIELD", 1);
+        check(!orFilter.match(bug), "disabled Or branch must be ignored");
+
+        Filter notFilter = parse("<Match><Not disabled=\"true\">"
+                + "<BugPattern name=\"UUF_UNUSED_FIELD\"/>"
+                + "</Not></Match>");
+        check(notFilter.match(bug), "disabled Not matcher must be ignored");
+    }
+
+    void topLevelDisablementStillWorks() throws Exception {
+        Filter filter = parse("<Match disabled=\"true\"><BugPattern name=\"UUF_UNUSED_FIELD\"/></Match>");
+        BugInstance bug = new BugInstance("UUF_UNUSED_FIELD", 1);
+        check(!filter.match(bug), "top-level disabled matcher must remain disabled");
+    }
+
+    void nestedDisablementSurvivesXmlRoundTrip() throws Exception {
+        Filter original = parse("<Match><Or>"
+                + "<BugPattern name=\"OTHER_PATTERN\" disabled=\"true\"/>"
+                + "<Class name=\"example.Target\"/>"
+                + "</Or></Match>");
+
+        ByteArrayOutputStream output = new ByteArrayOutputStream();
+        original.writeAsXML(output);
+        String xml = output.toString(StandardCharsets.UTF_8.name());
+        check(xml.contains("disabled=\"true\""), "disabled attribute must be serialized");
+
+        Filter restored = new Filter(new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8)));
+        BugInstance target = new BugInstance("UUF_UNUSED_FIELD", 1).addClass("example.Target");
+        BugInstance other = new BugInstance("OTHER_PATTERN", 1).addClass("example.Other");
+        check(restored.match(target), "round-tripped enabled branch must match");
+        check(!restored.match(other), "round-tripped disabled branch must stay disabled");
+    }
+
+    private Filter parse(String body) throws Exception {
+        String xml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+                + "<FindBugsFilter>" + body + "</FindBugsFilter>";
+        return new Filter(new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8)));
+    }
+
+    private static void check(boolean condition, String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+}
