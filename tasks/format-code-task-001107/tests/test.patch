+trap 'rm -rf "${TMP_DIR}"' EXIT
+javac -proc:none -cp "${CLASSPATH}" -d "${TMP_DIR}" \
+  "${REPO_DIR}/spotbugs-tests/src/test/java/edu/umd/cs/findbugs/filter/NestedDisabledMatcherTest.java"
+java -cp "${TMP_DIR}:${CLASSPATH}" edu.umd.cs.findbugs.filter.NestedDisabledMatcherTest
