diff --git a/spotbugs-tests/src/test/java/edu/umd/cs/findbugs/filter/NestedDisabledMatcherTest.java b/spotbugs-tests/src/test/java/edu/umd/cs/findbugs/filter/NestedDisabledMatcherTest.java
