+#!/bin/bash
+set -euo pipefail
+
+
+REPO_DIR="$(git rev-parse --show-toplevel)"
+CLASSPATH="${REPO_DIR}/spotbugs/build/classes/java/main:${REPO_DIR}/spotbugs/build/classes/java/gui:${REPO_DIR}/spotbugs/build/resources/main:${REPO_DIR}/spotbugs/build/resources/gui:${REPO_DIR}/spotbugs-annotations/build/classes/java/main:${REPO_DIR}/spotbugs/.libs/*"
+"${REPO_DIR}/gradlew" :spotbugs:compileJava --offline --no-daemon --console=plain
