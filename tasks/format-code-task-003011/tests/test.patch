@@ -0,0 +1,389 @@
+
+
+
+
+
+
+
+
+
+
+
+import importlib
+import warnings
+
+import pytest
+
+import wx
+
+if not hasattr(wx, "wxPyDeprecationWarning"):
+    wx.wxPyDeprecationWarning = DeprecationWarning
+
+warnings.filterwarnings("ignore", category=DeprecationWarning)
+
+from wx.lib.pubsub import pub as pub_module
+from wx.lib.pubsub.core import Listener, Publisher
+from wx.lib.pubsub.utils.notification import IgnoreNotificationsMixin
+
+
+def fresh_pub():
+    return importlib.reload(pub_module)
+
+
+def make_listener(name, sink):
+    def listener(payload=None):
+        sink.append((name, payload))
+
+    listener.__name__ = name
+    return listener
+
+
+class UnsubscribeRecorder(IgnoreNotificationsMixin):
+    def __init__(self):
+        self.events = []
+
+    def notifyUnsubscribe(self, pubListener, topicObj):
+
+        self.events.append((pubListener.getCallable(), topicObj.getName()))
+
+
+def assert_removed_callables(removed, expected_callables):
+
+    assert isinstance(removed, list)
+    assert len(removed) == len(expected_callables)
+    assert all(isinstance(wrapper, Listener) for wrapper in removed)
+    assert {wrapper.getCallable() for wrapper in removed} == set(expected_callables)
+
+
+def test_default_pub_and_publisher_expose_unsubscribe_methods():
+
+
+
+
+    pub = fresh_pub()
+    publisher = Publisher()
+
+    assert callable(pub.unsubscribe) == True
+    assert callable(pub.unsubAll) == True
+    assert callable(publisher.unsubscribe) == True
+    assert callable(publisher.unsubAll) == True
+
+
+def test_unsubscribe_removes_only_requested_listener_and_notifies_once():
+
+
+
+
+    pub = fresh_pub()
+    calls = []
+    first_listener = make_listener("first_listener", calls)
+    second_listener = make_listener("second_listener", calls)
+    recorder = UnsubscribeRecorder()
+
+    pub.addNotificationHandler(recorder)
+    pub.setNotificationFlags(all=False, unsubscribe=True)
+    first_wrapper, first_is_new = pub.subscribe(first_listener, "orders.created")
+    second_wrapper, second_is_new = pub.subscribe(second_listener, "orders.created")
+    topic = pub.getDefaultTopicMgr().getTopic("orders.created")
+
+    assert first_is_new == True
+    assert second_is_new == True
+    assert topic.getNumListeners() == 2
+
+    assert first_wrapper.getCallable() is first_listener
+    assert second_wrapper.getCallable() is second_listener
+
+    pub.sendMessage("orders.created", payload="before")
+
+    assert sorted(calls) == [("first_listener", "before"), ("second_listener", "before")]
+
+    removed = pub.unsubscribe(first_listener, "orders.created")
+
+    assert isinstance(removed, Listener)
+    assert removed.getCallable() is first_listener
+    assert topic.getNumListeners() == 1
+    assert recorder.events == [(first_listener, "orders.created")]
+
+    calls.clear()
+    pub.sendMessage("orders.created", payload="after")
+    assert calls == [("second_listener", "after")]
+
+
+def test_unsubscribe_again_returns_none_and_does_not_notify():
+
+
+
+
+    pub = fresh_pub()
+    calls = []
+    first_listener = make_listener("first_listener", calls)
+    second_listener = make_listener("second_listener", calls)
+    recorder = UnsubscribeRecorder()
+
+    pub.addNotificationHandler(recorder)
+    pub.setNotificationFlags(all=False, unsubscribe=True)
+    pub.subscribe(first_listener, "orders.created")
+    pub.subscribe(second_listener, "orders.created")
+    topic = pub.getDefaultTopicMgr().getTopic("orders.created")
+    pub.unsubscribe(first_listener, "orders.created")
+    assert topic.getNumListeners() == 1
+    assert recorder.events == [(first_listener, "orders.created")]
+
+    second_removed = pub.unsubscribe(first_listener, "orders.created")
+    assert second_removed == None
+    assert topic.getNumListeners() == 1
+    assert recorder.events == [(first_listener, "orders.created")]
+
+    pub.sendMessage("orders.created", payload="still-subscribed")
+    assert calls == [("second_listener", "still-subscribed")]
+
+
+def test_unsubscribe_missing_topic_raises_topic_name_error():
+
+
+
+
+    pub = fresh_pub()
+    calls = []
+    listener = make_listener("missing_topic_listener", calls)
+
+    with pytest.raises(pub.TopicNameError) as excinfo:
+        pub.unsubscribe(listener, "missing.topic")
+
+
+    assert isinstance(excinfo.value, pub.TopicNameError)
+    assert calls == []
+
+
+def test_unsub_all_topic_removes_direct_listeners_and_notifies_each():
+
+
+
+
+    pub = fresh_pub()
+    calls = []
+    bulk_first = make_listener("bulk_first", calls)
+    bulk_second = make_listener("bulk_second", calls)
+    parent_listener = make_listener("parent_listener", calls)
+    recorder = UnsubscribeRecorder()
+
+    pub.addNotificationHandler(recorder)
+    pub.setNotificationFlags(all=False, unsubscribe=True)
+    pub.subscribe(bulk_first, "orders.created")
+    pub.subscribe(bulk_second, "orders.created")
+    pub.subscribe(parent_listener, "orders")
+    created_topic = pub.getDefaultTopicMgr().getTopic("orders.created")
+    parent_topic = pub.getDefaultTopicMgr().getTopic("orders")
+
+    assert created_topic.getNumListeners() == 2
+    assert parent_topic.getNumListeners() == 1
+
+    removed = pub.unsubAll("orders.created")
+    assert_removed_callables(removed, [bulk_first, bulk_second])
+    assert created_topic.getNumListeners() == 0
+    assert parent_topic.getNumListeners() == 1
+
+    assert len(recorder.events) == 2
+    assert set(recorder.events) == {
+        (bulk_first, "orders.created"),
+        (bulk_second, "orders.created"),
+    }
+
+    pub.sendMessage("orders.created", payload="post-bulk")
+    assert calls == [("parent_listener", "post-bulk")]
+
+
+def test_unsub_all_topic_listener_filter_removes_matching_wrappers_only():
+
+
+
+
+    pub = fresh_pub()
+    calls = []
+    seen_by_filter = []
+    alpha = make_listener("filter_alpha", calls)
+    beta = make_listener("filter_beta", calls)
+    gamma = make_listener("filter_gamma", calls)
+
+    pub.subscribe(alpha, "orders.created")
+    pub.subscribe(beta, "orders.created")
+    pub.subscribe(gamma, "orders.created")
+
+    def predicate(wrapper):
+
+        assert isinstance(wrapper, Listener)
+        seen_by_filter.append(wrapper.getCallable())
+        return wrapper.getCallable() is beta
+
+    removed = pub.unsubAll("orders.created", listenerFilter=predicate)
+    topic = pub.getDefaultTopicMgr().getTopic("orders.created")
+
+
+    assert len(seen_by_filter) == 3
+    assert set(seen_by_filter) == {alpha, beta, gamma}
+    assert_removed_callables(removed, [beta])
+    assert topic.getNumListeners() == 2
+
+    pub.sendMessage("orders.created", payload="post-filter")
+
+    assert set(calls) == {
+        ("filter_alpha", "post-filter"),
+        ("filter_gamma", "post-filter"),
+    }
+
+
+def test_unsub_all_listener_filter_applies_across_topics():
+
+
+
+
+    pub = fresh_pub()
+    calls = []
+    keep_created = make_listener("global_keep_created", calls)
+    remove_created = make_listener("global_remove_created", calls)
+    remove_cancelled = make_listener("global_remove_cancelled", calls)
+    keep_cancelled = make_listener("global_keep_cancelled", calls)
+
+    pub.subscribe(keep_created, "orders.created")
+    pub.subscribe(remove_created, "orders.created")
+    pub.subscribe(remove_cancelled, "orders.cancelled")
+    pub.subscribe(keep_cancelled, "orders.cancelled")
+
+    def remove_global(wrapper):
+
+        assert isinstance(wrapper, Listener)
+        return wrapper.getCallable() in {remove_created, remove_cancelled}
+
+    removed = pub.unsubAll(listenerFilter=remove_global)
+    created_topic = pub.getDefaultTopicMgr().getTopic("orders.created")
+    cancelled_topic = pub.getDefaultTopicMgr().getTopic("orders.cancelled")
+
+    assert_removed_callables(removed, [remove_created, remove_cancelled])
+    assert created_topic.getNumListeners() == 1
+    assert cancelled_topic.getNumListeners() == 1
+
+    pub.sendMessage("orders.created", payload="created")
+    pub.sendMessage("orders.cancelled", payload="cancelled")
+
+    assert set(calls) == {
+        ("global_keep_created", "created"),
+        ("global_keep_cancelled", "cancelled"),
+    }
+
+
+def test_unsub_all_topic_filter_limits_bulk_removal_to_matching_topics():
+
+
+
+
+    pub = fresh_pub()
+    calls = []
+    topic_created = make_listener("topic_created", calls)
+    topic_cancelled = make_listener("topic_cancelled", calls)
+    invoice_created = make_listener("invoice_created", calls)
+
+    pub.subscribe(topic_created, "orders.created")
+    pub.subscribe(topic_cancelled, "orders.cancelled")
+    pub.subscribe(invoice_created, "invoices.created")
+
+    removed = pub.unsubAll(topicFilter=lambda name: name.startswith("orders."))
+    orders_created = pub.getDefaultTopicMgr().getTopic("orders.created")
+    orders_cancelled = pub.getDefaultTopicMgr().getTopic("orders.cancelled")
+    invoices_created = pub.getDefaultTopicMgr().getTopic("invoices.created")
+
+    assert_removed_callables(removed, [topic_created, topic_cancelled])
+    assert orders_created.getNumListeners() == 0
+    assert orders_cancelled.getNumListeners() == 0
+    assert invoices_created.getNumListeners() == 1
+
+    pub.sendMessage("orders.created", payload="created")
+    pub.sendMessage("orders.cancelled", payload="cancelled")
+    pub.sendMessage("invoices.created", payload="invoice")
+    assert calls == [("invoice_created", "invoice")]
+
+
+def test_unsub_all_without_arguments_removes_all_and_is_idempotent_cleanup():
+
+
+
+
+    pub = fresh_pub()
+    calls = []
+    all_orders = make_listener("all_orders", calls)
+    all_invoices = make_listener("all_invoices", calls)
+
+    pub.subscribe(all_orders, "orders.created")
+    pub.subscribe(all_invoices, "invoices.created")
+    orders_topic = pub.getDefaultTopicMgr().getTopic("orders.created")
+    invoices_topic = pub.getDefaultTopicMgr().getTopic("invoices.created")
+
+    assert orders_topic.getNumListeners() == 1
+    assert invoices_topic.getNumListeners() == 1
+
+    removed = pub.unsubAll()
+    assert_removed_callables(removed, [all_orders, all_invoices])
+    assert orders_topic.getNumListeners() == 0
+    assert invoices_topic.getNumListeners() == 0
+
+    second_removed = pub.unsubAll()
+    assert second_removed == []
+    assert orders_topic.getNumListeners() == 0
+    assert invoices_topic.getNumListeners() == 0
+
+
+def test_publisher_instances_keep_independent_subscription_state():
+
+
+
+
+    calls = []
+    publisher_a = Publisher()
+    publisher_b = Publisher()
+    instance_a = make_listener("instance_a", calls)
+    instance_a_two = make_listener("instance_a_two", calls)
+    instance_b = make_listener("instance_b", calls)
+
+    publisher_a.subscribe(instance_a, "orders.created")
+    publisher_a.subscribe(instance_a_two, "orders.created")
+    publisher_b.subscribe(instance_b, "orders.created")
+
+    topic_a = publisher_a.getTopicMgr().getTopic("orders.created")
+    topic_b = publisher_b.getTopicMgr().getTopic("orders.created")
+    assert topic_a.getNumListeners() == 2
+    assert topic_b.getNumListeners() == 1
+
+    removed = publisher_a.unsubAll("orders.created")
+    assert_removed_callables(removed, [instance_a, instance_a_two])
+    assert topic_a.getNumListeners() == 0
+    assert topic_b.getNumListeners() == 1
+
+    publisher_b.sendMessage("orders.created", payload="alive")
+    assert calls == [("instance_b", "alive")]
+
+
+def test_unsub_all_leak_floor_listener_count_stays_bounded_over_cycles():
+
+
+
+
+    publisher = Publisher()
+    kept_alive = []
+
+    for index in range(120):
+        sink = []
+        listener = make_listener("cycle_listener_%03d" % index, sink)
+        kept_alive.append(listener)
+        wrapper, is_new = publisher.subscribe(listener, "orders.created")
+        topic = publisher.getTopicMgr().getTopic("orders.created")
+        assert is_new == True
+
+        assert wrapper.getCallable() is listener
+        assert topic.getNumListeners() == 1
+
+        removed = publisher.unsubAll()
+        assert_removed_callables(removed, [listener])
+        assert topic.getNumListeners() == 0
+
+    final_topic = publisher.getTopicMgr().getTopic("orders.created")
+    assert final_topic.getNumListeners() == 0
+    assert len(kept_alive) == 120
