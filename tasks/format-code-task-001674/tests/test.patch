+++ b/spec/doc/codedeploy_resource_types_spec.rb
@@ -0,0 +1,20 @@
+require 'spec_helper'
+
+describe 'CodeDeploy resource type documentation' do
+  let(:resource_types) { File.read(File.expand_path('../../doc/resource_types.md', __dir__)) }
+
+  it 'documents both CodeDeploy resource types' do
+    expect(resource_types).to include('codedeploy')
+    expect(resource_types).to include('codedeploy_deployment_group')
+  end
+
+  it 'documents deployment group application scoping and default behavior' do
+    expect(resource_types).to include('application_name')
+    expect(resource_types).to include('default')
+    expect(resource_types).to include("codedeploy_deployment_group('")
+  end
+
+  it 'documents the deployment group Auto Scaling group matcher' do
+    expect(resource_types).to include('have_autoscaling_group')
+  end
+end
diff --git a/spec/type/codedeploy_deployment_group_spec.rb b/spec/type/codedeploy_deployment_group_spec.rb
new file mode 100644
index 00000000..911cd426
--- /dev/null
+++ b/spec/type/codedeploy_deployment_group_spec.rb
@@ -0,0 +1,131 @@
+require 'spec_helper'
+
+DEPLOYMENT_GROUPS = {
+  ['billing-service', 'blue'] => {
+    application_name: 'billing-service',
+    deployment_group_id: 'deployment-group-fixture-a',
+    deployment_group_name: 'blue',
+    deployment_config_name: 'FixtureConfig.Linear',
+    service_role_arn: 'arn:aws:iam::111122223333:role/billing-fixture',
+    compute_platform: 'Server',
+    auto_scaling_groups: [
+      { name: 'billing-api-asg' },
+      { name: 'billing-worker-asg' }
+    ]
+  },
+  ['reporting-service', 'blue'] => {
+    application_name: 'reporting-service',
+    deployment_group_id: 'deployment-group-fixture-b',
+    deployment_group_name: 'blue',
+    deployment_config_name: 'FixtureConfig.Batch',
+    service_role_arn: 'arn:aws:iam::111122223333:role/reporting-fixture',
+    compute_platform: 'Server',
+    auto_scaling_groups: [
+      { name: 'reporting-batch-asg' }
+    ]
+  },
+  ['default', 'baseline'] => {
+    application_name: 'default',
+    deployment_group_id: 'deployment-group-fixture-c',
+    deployment_group_name: 'baseline',
+    deployment_config_name: 'FixtureConfig.Default',
+    service_role_arn: 'arn:aws:iam::111122223333:role/default-fixture',
+    compute_platform: 'Server',
+    auto_scaling_groups: [
+      { name: 'default-fixture-asg' }
+    ]
+  },
+  ['mobile-service', 'canary'] => {
+    application_name: 'mobile-service',
+    deployment_group_id: 'deployment-group-fixture-d',
+    deployment_group_name: 'canary',
+    deployment_config_name: 'FixtureConfig.Mobile',
+    service_role_arn: 'arn:aws:iam::111122223333:role/mobile-fixture',
+    compute_platform: 'Server',
+    auto_scaling_groups: [
+      { name: 'mobile-web-asg' }
+    ]
+  }
+}.freeze
+
+Aws.config[:codedeploy] = {
+  stub_responses: {
+    get_deployment_group: Proc.new do |context|
+      key = [context.params[:application_name], context.params[:deployment_group_name]]
+      { deployment_group_info: DEPLOYMENT_GROUPS[key] }
+    end
+  }
+}
+
+
+Aws.config[:autoscaling] = {
+  stub_responses: {
+    describe_auto_scaling_groups: {
+      auto_scaling_groups: [
+        {
+          auto_scaling_group_name: 'external-asg',
+          min_size: 1,
+          max_size: 2,
+          desired_capacity: 1,
+          default_cooldown: 300,
+          availability_zones: ['us-east-1a'],
+          health_check_type: 'EC2',
+          created_time: Time.at(1_700_000_003)
+        }
+      ]
+    }
+  }
+}
+
+describe codedeploy_deployment_group('blue'), application_name: 'billing-service' do
+  let(:deployment_group) { DEPLOYMENT_GROUPS[['billing-service', 'blue']] }
+
+  it { should exist }
+  its(:application_name) { should eq deployment_group[:application_name] }
+  its(:deployment_group_id) { should eq deployment_group[:deployment_group_id] }
+  its(:deployment_group_name) { should eq deployment_group[:deployment_group_name] }
+  its(:deployment_config_name) { should eq deployment_group[:deployment_config_name] }
+  its(:service_role_arn) { should eq deployment_group[:service_role_arn] }
+  its(:compute_platform) { should eq deployment_group[:compute_platform] }
+  it { should have_autoscaling_group(deployment_group[:auto_scaling_groups][0][:name]) }
+  it { should have_autoscaling_group(deployment_group[:auto_scaling_groups][1][:name]) }
+  it { should_not have_autoscaling_group('external-asg') }
+end
+
+describe codedeploy_deployment_group('blue'), application_name: 'reporting-service' do
+  let(:deployment_group) { DEPLOYMENT_GROUPS[['reporting-service', 'blue']] }
+
+  it { should exist }
+  its(:application_name) { should eq deployment_group[:application_name] }
+  its(:deployment_group_id) { should eq deployment_group[:deployment_group_id] }
+  its(:deployment_config_name) { should eq deployment_group[:deployment_config_name] }
+  its(:service_role_arn) { should eq deployment_group[:service_role_arn] }
+  it { should have_autoscaling_group(deployment_group[:auto_scaling_groups][0][:name]) }
+end
+
+describe codedeploy_deployment_group('baseline') do
+  let(:deployment_group) { DEPLOYMENT_GROUPS[['default', 'baseline']] }
+
+  it { should exist }
+  its(:application_name) { should eq 'default' }
+  its(:deployment_group_id) { should eq deployment_group[:deployment_group_id] }
+  its(:deployment_group_name) { should eq deployment_group[:deployment_group_name] }
+  it { should have_autoscaling_group(deployment_group[:auto_scaling_groups][0][:name]) }
+end
+
+describe codedeploy_deployment_group('canary'), application_name: 'mobile-service' do
+  let(:deployment_group) { DEPLOYMENT_GROUPS[['mobile-service', 'canary']] }
+
+  it { should exist }
+  its(:application_name) { should eq deployment_group[:application_name] }
+  its(:deployment_group_id) { should eq deployment_group[:deployment_group_id] }
+  its(:deployment_group_name) { should eq deployment_group[:deployment_group_name] }
+  its(:deployment_config_name) { should eq deployment_group[:deployment_config_name] }
+  its(:service_role_arn) { should eq deployment_group[:service_role_arn] }
+  its(:compute_platform) { should eq deployment_group[:compute_platform] }
+  it { should have_autoscaling_group(deployment_group[:auto_scaling_groups][0][:name]) }
+end
+
+describe codedeploy_deployment_group('missing-group'), application_name: 'billing-service' do
+  it { should_not exist }
+end
