diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,30 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+export PATH="$HOME/.rbenv/shims:$HOME/.rbenv/bin:$HOME/.rbenv/plugins/ruby-build/bin:$PATH"
+export RBENV_VERSION=3.1.6
+
+COMPAT_SHIM="${TMPDIR:-/tmp}/awspec_fixture_compat_shim.rb"
+cat > "$COMPAT_SHIM" <<'RUBY'
+class Object
+  def timeout; end
+end
+RUBY
+
+RSPEC_RUBY=(ruby -r "$COMPAT_SHIM" -r aws-sdk-elastictranscoder -I lib -I spec -S rspec)
+
+case "${1:-}" in
+  base)
+    "${RSPEC_RUBY[@]}" spec/type/codebuild_spec.rb
+    ;;
+  new)
+    "${RSPEC_RUBY[@]}" spec/type/codedeploy_spec.rb &&
+    "${RSPEC_RUBY[@]}" spec/type/codedeploy_deployment_group_spec.rb &&
+    "${RSPEC_RUBY[@]}" spec/doc/codedeploy_resource_types_spec.rb
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
