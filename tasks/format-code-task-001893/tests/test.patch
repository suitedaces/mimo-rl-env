new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,26 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+if [ ! -f /usr/local/kubebuilder/bin/etcd ]; then
+    echo "ERROR: kubebuilder test assets not found at /usr/local/kubebuilder/bin/"
+    echo "Run: setup-envtest use 1.23.5 --bin-dir /usr/local/kubebuilder/bin"
+    exit 1
+fi
+
+NEW_SPECS='Test Set BMH Pause Annotation|reports an update error when pause preparation cannot read the host reference'
+
+case "${1:-}" in
+    base)
+        go test ./baremetal/ -v -count=1 -timeout 300s -args -ginkgo.skip="$NEW_SPECS"
+        ;;
+    new)
+        go test ./baremetal/ -v -count=1 -timeout 300s -args -ginkgo.focus="$NEW_SPECS"
+        ;;
+    *)
+        echo "usage: $0 base|new"
+        exit 2
+        ;;
+esac
