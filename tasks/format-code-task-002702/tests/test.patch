@@ -122,3 +122,24 @@ test('funny-numeric-forms', t => {
   t.equal(a.format('numeric'), b.format('numeric'), 'dd/mm/yyyy')
   t.end();
 });
+
+test('invalid calendar dates are not normalized into valid dates', t => {
+  t.equal(spacetime('February 30 2018').isValid(), false, 'reported impossible date is invalid');
+  t.equal(spacetime('Feb 29 2015').isValid(), false, 'non-leap-year leap day is invalid');
+  t.equal(spacetime('April 31 2018').isValid(), false, '31st day in a 30-day month is invalid');
+  t.equal(spacetime('2018-02-30').isValid(), false, 'numeric impossible date is invalid');
+  t.equal(spacetime('February 28 2018').isValid(), true, 'ordinary valid date remains valid');
+  t.equal(spacetime('Feb 29 2016').isValid(), true, 'valid leap day remains valid');
+  t.equal(spacetime('2018-04-30').isValid(), true, 'numeric valid date remains valid');
+  t.end();
+});
+
+test('validity is exposed through isValid not valid boolean field', t => {
+  var valid = spacetime('February 28 2018');
+  var invalid = spacetime('February 30 2018');
+  t.equal(valid.isValid(), true, 'valid instance still reports through isValid');
+  t.equal(invalid.isValid(), false, 'invalid instance still reports through isValid');
+  t.notEqual(typeof valid.valid, 'boolean', 'valid instance does not expose boolean .valid');
+  t.notEqual(typeof invalid.valid, 'boolean', 'invalid instance does not expose boolean .valid');
+  t.end();
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,47 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+npm install 2>&1
+
+case "${1:-}" in
+  base)
+    PATTERN='^(inputs|hour-inputs|null input|arr-input|obj-input|date-input|self-input|inputs-in-comparisons|iso-string-input|funny-numeric-forms)$'
+    ;;
+  new)
+    PATTERN='^(invalid calendar dates are not normalized into valid dates|validity is exposed through isValid not valid boolean field)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
+
+TMP_FILE="test/.fixturea-inputs.${1}.test.js"
+trap 'rm -f "$TMP_FILE"' EXIT
+python3 - "$PATTERN" test/inputs.test.js "$TMP_FILE" <<'PY'
+import re
+import sys
+pattern = re.compile(sys.argv[1])
+source = open(sys.argv[2]).read().splitlines(True)
+out = []
+i = 0
+while i < len(source):
+    line = source[i]
+    m = re.match(r"(test\(['\"])(.*?)(['\"],\s*t\s*=>\s*\{)", line)
+    if not m:
+        out.append(line)
+        i += 1
+        continue
+    block = [line]
+    depth = line.count('{') - line.count('}')
+    i += 1
+    while i < len(source) and depth > 0:
+        block.append(source[i])
+        depth += source[i].count('{') - source[i].count('}')
+        i += 1
+    if pattern.match(m.group(2)):
+        out.extend(block)
+open(sys.argv[3], 'w').writelines(out)
+PY
+TESTENV=dev npx tape "$TMP_FILE"
