diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,74 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+dev-switch node 20 2>/dev/null || true
+
+
+if [ ! -d "node_modules/@angular" ]; then
+  npm install --ignore-scripts 2>/dev/null
+fi
+
+
+if [ ! -f "node_modules/node-sass/lib/index.js" ] || grep -q "require('sass')" node_modules/node-sass/lib/index.js 2>/dev/null; then
+  true
+else
+  rm -rf node_modules/node-sass
+  mkdir -p node_modules/node-sass/lib
+  cat > node_modules/node-sass/package.json << 'PKGEOF'
+{
+  "name": "node-sass",
+  "version": "4.12.0",
+  "main": "lib/index.js"
+}
+PKGEOF
+  cat > node_modules/node-sass/lib/index.js << 'IDXEOF'
+const sass = require('sass');
+module.exports = sass;
+IDXEOF
+fi
+
+
+if [ ! -d "node_modules/sass" ]; then
+  npm install sass@1.26.0 --no-save --ignore-scripts --legacy-peer-deps 2>/dev/null
+fi
+
+
+export CHROME_BIN=$(find /root/.cache/puppeteer -name "chrome" -type f -path "*/chrome-linux64/*" 2>/dev/null | head -1)
+if [ -z "$CHROME_BIN" ]; then
+  npm install -g puppeteer 2>/dev/null
+  export CHROME_BIN=$(find /root/.cache/puppeteer -name "chrome" -type f -path "*/chrome-linux64/*" 2>/dev/null | head -1)
+fi
+
+
+export NODE_OPTIONS=--openssl-legacy-provider
+
+
+run_ngx_ui_tests() {
+  npx ng test @swimlane/ngx-ui --watch=false --browsers=ChromeHeadlessCI --no-progress
+}
+
+case "${1:-}" in
+  base)
+    run_ngx_ui_tests
+    ;;
+  new)
+    cat > projects/swimlane/ngx-ui/src/test.ts <<'TSEOF'
+import 'core-js/es7/reflect';
+import 'zone.js/dist/zone';
+import 'zone.js/dist/zone-testing';
+import { getTestBed } from '@angular/core/testing';
+import { BrowserDynamicTestingModule, platformBrowserDynamicTesting } from '@angular/platform-browser-dynamic/testing';
+
+getTestBed().initTestEnvironment(BrowserDynamicTestingModule, platformBrowserDynamicTesting());
+require('./lib/components/toggle/toggle.component.spec.ts');
+TSEOF
+    run_ngx_ui_tests
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
