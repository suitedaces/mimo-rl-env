+import collections
+import collections.abc
+import copy
+import json
+import os
+import socket
+import subprocess
+import sys
+import tempfile
+import unittest
+from decimal import Decimal
+from unittest import mock
+
+
+
+if not hasattr(collections, "Mapping"):
+    collections.Mapping = collections.abc.Mapping
+
+sys.path.insert(0, "/workspace/repo")
+
+from boto.dynamodb.types import Binary, dynamize_value
+
+
+
+
+
+
+class TestDynamizeValueAcceptance(unittest.TestCase):
+    def test_string_scalar_is_encoded_as_s_attribute_value(self):
+
+
+
+
+        actual = dynamize_value("foo")
+        self.assertEqual(actual, {"S": "foo"})
+
+    def test_empty_string_boundary_still_uses_s_attribute_value(self):
+
+
+
+
+        actual = dynamize_value("")
+        self.assertEqual(actual, {"S": ""})
+
+    def test_integer_scalar_is_stringified_as_n_attribute_value(self):
+
+
+
+
+        actual = dynamize_value(54)
+        self.assertEqual(actual, {"N": "54"})
+
+    def test_decimal_scalar_preserves_decimal_string_in_n_attribute_value(self):
+
+
+
+
+        actual = dynamize_value(Decimal("1234567890.0123"))
+        self.assertEqual(actual, {"N": "1234567890.0123"})
+
+    def test_negative_float_scalar_is_stringified_as_n_attribute_value(self):
+
+
+
+
+        actual = dynamize_value(-3.5)
+        self.assertEqual(actual, {"N": "-3.5"})
+
+    def test_binary_wrapper_scalar_is_base64_encoded_as_b_attribute_value(self):
+
+
+
+
+        actual = dynamize_value(Binary(b"\x01"))
+        self.assertEqual(actual, {"B": "AQ=="})
+
+    def test_raw_bytes_scalar_is_base64_encoded_as_b_attribute_value(self):
+
+
+
+
+        actual = dynamize_value(b"\x00\xff")
+        self.assertEqual(actual, {"B": "AP8="})
+
+    def test_numeric_set_is_encoded_as_ns_attribute_value(self):
+
+
+
+
+        actual = dynamize_value({1, 2, 10})
+
+        self.assertEqual(set(actual.keys()), {"NS"})
+        self.assertCountEqual(actual["NS"], ["1", "2", "10"])
+
+    def test_empty_set_boundary_is_encoded_as_empty_ns_attribute_value(self):
+
+
+
+
+        actual = dynamize_value(set())
+        self.assertEqual(actual, {"NS": []})
+
+    def test_string_set_is_encoded_as_ss_attribute_value(self):
+
+
+
+
+        actual = dynamize_value({"red"})
+        self.assertEqual(actual, {"SS": ["red"]})
+
+    def test_binary_set_is_encoded_as_bs_attribute_value(self):
+
+
+
+
+        actual = dynamize_value({Binary(b"\x01")})
+        self.assertEqual(actual, {"BS": ["AQ=="]})
+
+    def test_mixed_set_rejects_with_type_error(self):
+
+
+
+
+        with self.assertRaises(TypeError):
+            dynamize_value({1, "a"})
+
+    def test_referential_transparency_for_same_supported_input(self):
+        first = dynamize_value(Decimal("7.25"))
+        second = dynamize_value(Decimal("7.25"))
+        self.assertEqual(first, {"N": "7.25"})
+        self.assertEqual(second, {"N": "7.25"})
+        self.assertEqual(first, second)
+
+    def test_does_not_mutate_caller_owned_set_input(self):
+        original = {1, 2, 10}
+        before = copy.deepcopy(original)
+        actual = dynamize_value(original)
+
+        self.assertEqual(set(actual.keys()), {"NS"})
+        self.assertCountEqual(actual["NS"], ["1", "2", "10"])
+        self.assertEqual(original, before)
+        self.assertEqual(original, {1, 2, 10})
+
+    def test_same_input_matches_fresh_process_result(self):
+        in_process = dynamize_value("cache-check")
+        script = """
+import collections, collections.abc, json, sys
+if not hasattr(collections, 'Mapping'):
+    collections.Mapping = collections.abc.Mapping
+sys.path.insert(0, '/workspace/repo')
+from boto.dynamodb.types import dynamize_value
+sys.stdout.write(json.dumps(dynamize_value('cache-check'), sort_keys=True))
+"""
+        completed = subprocess.run(
+            [sys.executable, "-c", script],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            check=True,
+            text=True,
+        )
+        fresh_process = json.loads(completed.stdout)
+        self.assertEqual(in_process, {"S": "cache-check"})
+        self.assertEqual(fresh_process, {"S": "cache-check"})
+        self.assertEqual(in_process, fresh_process)
+
+    def test_does_not_touch_filesystem_or_network_for_pure_conversion(self):
+        def blocked_socket(*args, **kwargs):
+            raise AssertionError("dynamize_value must not open network sockets")
+
+        def blocked_open(*args, **kwargs):
+            raise AssertionError("dynamize_value must not open files")
+
+        old_cwd = os.getcwd()
+        with tempfile.TemporaryDirectory() as tmpdir:
+            try:
+                os.chdir(tmpdir)
+                before = sorted(os.listdir("."))
+                with mock.patch.object(socket, "socket", blocked_socket), mock.patch(
+                    "builtins.open", blocked_open
+                ):
+                    actual = dynamize_value(Binary(b"\x01"))
+                after = sorted(os.listdir("."))
+            finally:
+                os.chdir(old_cwd)
+
+        self.assertEqual(actual, {"B": "AQ=="})
+        self.assertEqual(before, [])
+        self.assertEqual(after, [])
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
