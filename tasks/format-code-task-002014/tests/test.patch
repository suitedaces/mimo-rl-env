diff --git a/test/ios/test_get_optics_vss.py b/test/ios/test_get_optics_vss.py
new file mode 100644
index 00000000..48fa8298
--- /dev/null
+++ b/test/ios/test_get_optics_vss.py
@@ -0,0 +1,186 @@
+
+import unittest
+from unittest import mock
+
+from napalm.ios import ios
+
+
+NORMAL_OPTICS_OUTPUT = (
+    "If device is externally calibrated, only calibrated values are printed.\n"
+    "++ : high alarm, +  : high warning, -  : low warning, -- : low alarm.\n"
+    "NA or N/A: not applicable, Tx: transmit, Rx: receive.\n"
+    "mA: milliamperes, dBm: decibels (milliwatts).\n"
+    "\n"
+    "                                 Optical   Optical\n"
+    "           Temperature  Voltage  Tx Power  Rx Power\n"
+    "Port       (Celsius)    (Volts)  (dBm)     (dBm)\n"
+    "---------  -----------  -------  --------  --------\n"
+    "Te1/0/1      34.6       3.29      -2.0      -3.5"
+)
+
+SWITCH2_OPTICS_OUTPUT = (
+    "If device is externally calibrated, only calibrated values are printed.\n"
+    "++ : high alarm, +  : high warning, -  : low warning, -- : low alarm.\n"
+    "NA or N/A: not applicable, Tx: transmit, Rx: receive.\n"
+    "mA: milliamperes, dBm: decibels (milliwatts).\n"
+    "\n"
+    "                                 Optical   Optical\n"
+    "           Temperature  Voltage  Tx Power  Rx Power\n"
+    "Port       (Celsius)    (Volts)  (dBm)     (dBm)\n"
+    "---------  -----------  -------  --------  --------\n"
+    "Te2/0/1      34.3       3.28      -2.5      -4.5"
+)
+
+VSS_INCOMPLETE_OUTPUT = "% Incomplete command."
+
+INVALID_INPUT_OUTPUT = (
+    "                                  ^\n"
+    "% Invalid input detected at '^' marker.\n"
+)
+
+SHOW_SWITCH_VIRTUAL_OUTPUT = (
+    "Executing the command on VSS member switch role = VSS Active, id = 1\n"
+    "\n"
+    "Switch mode             : Virtual Switch\n"
+    "Virtual switch domain number : 100\n"
+    "Local switch number          : 1\n"
+    "Local switch operational role: Virtual Switch Active\n"
+    "Peer switch number           : 2\n"
+    "Peer switch operational role : Virtual Switch Standby\n"
+)
+
+
+def _make_driver():
+
+    return ios.IOSDriver("fake-host", "user", "pass", optional_args={})
+
+
+class TestGetOpticsVSS(unittest.TestCase):
+
+
+    def test_get_optics_normal_returns_optics(self):
+
+        driver = _make_driver()
+
+        def fake_send_command(command):
+            if command == "show interfaces transceiver":
+                return NORMAL_OPTICS_OUTPUT
+            raise AssertionError(
+                "Unexpected command in non-VSS happy path: {!r}".format(command)
+            )
+
+        with mock.patch.object(driver, "_send_command", side_effect=fake_send_command):
+            result = driver.get_optics()
+
+        self.assertIsInstance(result, dict)
+        self.assertIn("TenGigabitEthernet1/0/1", result)
+        channel = result["TenGigabitEthernet1/0/1"]["physical_channels"]["channel"][0]
+        self.assertEqual(channel["state"]["output_power"]["instant"], -2.0)
+        self.assertEqual(channel["state"]["input_power"]["instant"], -3.5)
+
+    def test_get_optics_invalid_input_returns_empty(self):
+
+        driver = _make_driver()
+
+        def fake_send_command(command):
+
+            return INVALID_INPUT_OUTPUT
+
+        with mock.patch.object(driver, "_send_command", side_effect=fake_send_command):
+            result = driver.get_optics()
+
+        self.assertEqual(result, {})
+
+    def test_get_optics_vss_combines_both_switches(self):
+
+        driver = _make_driver()
+
+        def fake_send_command(command):
+            if command == "show interfaces transceiver":
+                return VSS_INCOMPLETE_OUTPUT
+            if command == "show switch virtual":
+                return SHOW_SWITCH_VIRTUAL_OUTPUT
+            if command == "show interfaces transceiver switch 1":
+                return NORMAL_OPTICS_OUTPUT
+            if command == "show interfaces transceiver switch 2":
+                return SWITCH2_OPTICS_OUTPUT
+
+
+
+            if command.startswith("show interfaces transceiver switch "):
+                return INVALID_INPUT_OUTPUT
+            raise AssertionError(
+                "Unexpected command in VSS scenario: {!r}".format(command)
+            )
+
+        with mock.patch.object(driver, "_send_command", side_effect=fake_send_command):
+            result = driver.get_optics()
+
+        self.assertIsInstance(result, dict)
+
+        self.assertIn("TenGigabitEthernet1/0/1", result)
+        self.assertIn("TenGigabitEthernet2/0/1", result)
+
+        ch1 = result["TenGigabitEthernet1/0/1"]["physical_channels"]["channel"][0]
+        self.assertEqual(ch1["state"]["output_power"]["instant"], -2.0)
+        self.assertEqual(ch1["state"]["input_power"]["instant"], -3.5)
+
+        ch2 = result["TenGigabitEthernet2/0/1"]["physical_channels"]["channel"][0]
+        self.assertEqual(ch2["state"]["output_power"]["instant"], -2.5)
+        self.assertEqual(ch2["state"]["input_power"]["instant"], -4.5)
+
+    def test_get_optics_vss_distinct_values_per_switch(self):
+
+
+        driver = _make_driver()
+
+
+
+        sw1 = (
+            "                                 Optical   Optical\n"
+            "           Temperature  Voltage  Tx Power  Rx Power\n"
+            "Port       (Celsius)    (Volts)  (dBm)     (dBm)\n"
+            "---------  -----------  -------  --------  --------\n"
+            "Te1/1/1      30.0       3.30      -1.1      -2.2"
+        )
+        sw2 = (
+            "                                 Optical   Optical\n"
+            "           Temperature  Voltage  Tx Power  Rx Power\n"
+            "Port       (Celsius)    (Volts)  (dBm)     (dBm)\n"
+            "---------  -----------  -------  --------  --------\n"
+            "Te2/1/1      31.0       3.31      -7.7      -8.8"
+        )
+
+        def fake_send_command(command):
+            if command == "show interfaces transceiver":
+                return VSS_INCOMPLETE_OUTPUT
+            if command == "show switch virtual":
+                return SHOW_SWITCH_VIRTUAL_OUTPUT
+            if command == "show interfaces transceiver switch 1":
+                return sw1
+            if command == "show interfaces transceiver switch 2":
+                return sw2
+
+
+
+            if command.startswith("show interfaces transceiver switch "):
+                return INVALID_INPUT_OUTPUT
+            raise AssertionError(
+                "Unexpected command in VSS scenario: {!r}".format(command)
+            )
+
+        with mock.patch.object(driver, "_send_command", side_effect=fake_send_command):
+            result = driver.get_optics()
+
+        self.assertIn("TenGigabitEthernet1/1/1", result)
+        self.assertIn("TenGigabitEthernet2/1/1", result)
+        ch1 = result["TenGigabitEthernet1/1/1"]["physical_channels"]["channel"][0]
+        ch2 = result["TenGigabitEthernet2/1/1"]["physical_channels"]["channel"][0]
+        self.assertEqual(ch1["state"]["output_power"]["instant"], -1.1)
+        self.assertEqual(ch1["state"]["input_power"]["instant"], -2.2)
+        self.assertEqual(ch2["state"]["output_power"]["instant"], -7.7)
+        self.assertEqual(ch2["state"]["input_power"]["instant"], -8.8)
+
+
+if __name__ == "__main__":
+    unittest.main()
