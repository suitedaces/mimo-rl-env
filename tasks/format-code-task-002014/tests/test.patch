+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+python -m pytest -v -rA test/ios/test_get_optics_vss.py::TestGetOpticsVSS::test_get_optics_normal_returns_optics test/ios/test_get_optics_vss.py::TestGetOpticsVSS::test_get_optics_invalid_input_returns_empty test/ios/test_get_optics_vss.py::TestGetOpticsVSS::test_get_optics_vss_combines_both_switches test/ios/test_get_optics_vss.py::TestGetOpticsVSS::test_get_optics_vss_distinct_values_per_switch
+rc=$(( rc | $? ))
+exit $rc
