@@ -5,6 +5,8 @@ import pickle
 import unittest
 import warnings
 
+import numpy as np
+
 from obspy import Stream, Trace, UTCDateTime, read
 from obspy.core import Stats
 from obspy.core.util import AttribDict
@@ -345,6 +347,101 @@ class StatsTestCase(unittest.TestCase):
         self.assertEqual(stats.channel, 'HHZ')
 
 
+    def test_trace_copy_preserves_high_sampling_rate(self):
+        """
+        Regression test: Trace.copy() should preserve the original
+        sampling_rate exactly, even at large values where floating point
+        round-tripping through delta loses precision.
+        """
+        tr = Trace(data=np.ones(100000),
+                   header={'sampling_rate': 100000.})
+        self.assertEqual(tr.stats.sampling_rate, 100000.0)
+        tr2 = tr.copy()
+        self.assertEqual(tr2.stats.sampling_rate, 100000.0)
+
+    def test_stats_deepcopy_preserves_high_sampling_rate(self):
+        """
+        Regression test: copy.deepcopy(stats) preserves the original
+        sampling_rate exactly.
+        """
+        stats = Stats({'sampling_rate': 100000.0})
+        self.assertEqual(stats.sampling_rate, 100000.0)
+        stats2 = copy.deepcopy(stats)
+        self.assertEqual(stats2.sampling_rate, 100000.0)
+
+    def test_trace_deepcopy_preserves_high_sampling_rate(self):
+        """
+        Regression test: copy.deepcopy(trace) preserves the original
+        sampling_rate exactly.
+        """
+        tr = Trace(data=np.ones(100000),
+                   header={'sampling_rate': 100000.})
+        tr2 = copy.deepcopy(tr)
+        self.assertEqual(tr2.stats.sampling_rate, 100000.0)
+
+    def test_stats_pickle_preserves_high_sampling_rate(self):
+        """
+        Regression test: pickling/unpickling a Stats object preserves
+        the original sampling_rate exactly.
+        """
+        stats = Stats({'sampling_rate': 100000.0,
+                       'starttime': UTCDateTime(2020, 1, 1),
+                       'npts': 100000})
+        for protocol in (0, 1, 2):
+            stats2 = pickle.loads(pickle.dumps(stats, protocol=protocol))
+            self.assertEqual(stats2.sampling_rate, 100000.0)
+
+    def test_stats_copy_preserves_derived_endtime(self):
+        """
+        After copying a high-sampling-rate Stats, the derived endtime
+        must match the original endtime (since sampling_rate is preserved).
+        """
+        stats = Stats({'sampling_rate': 100000.0,
+                       'starttime': UTCDateTime(2020, 1, 1),
+                       'npts': 100000})
+        original_endtime = stats.endtime
+        stats2 = copy.deepcopy(stats)
+        self.assertEqual(stats2.endtime, original_endtime)
+        self.assertEqual(stats2.delta, stats.delta)
+
+    def test_trace_copy_equals_original_high_sr(self):
+        """
+        Regression test: a copy of a high-sampling-rate Trace must compare
+        equal to the original (both data and stats).
+        """
+        tr = Trace(data=np.ones(100000),
+                   header={'sampling_rate': 100000.})
+        tr2 = tr.copy()
+        self.assertEqual(tr, tr2)
+
+    def test_stats_normal_sampling_rate_copy_preservation(self):
+        """
+        Preservation: ordinary sampling_rate values must still round-trip
+        through copy/deepcopy correctly.
+        """
+        stats = Stats({'sampling_rate': 200.0,
+                       'starttime': UTCDateTime(2020, 1, 1),
+                       'npts': 1000,
+                       'network': 'BW',
+                       'station': 'ROTZ'})
+        stats2 = copy.deepcopy(stats)
+        self.assertEqual(stats2.sampling_rate, 200.0)
+        self.assertEqual(stats2.delta, 1.0 / 200.0)
+        self.assertEqual(stats2.network, 'BW')
+        self.assertEqual(stats2.station, 'ROTZ')
+        self.assertEqual(stats2.npts, 1000)
+
+    def test_stats_high_sampling_rate_copy_preserves_sampling_rate(self):
+        """
+        Another high-rate value whose reciprocal isn't exactly representable
+        must still survive copying.
+        """
+        stats = Stats({'sampling_rate': 250000.0})
+        self.assertEqual(stats.sampling_rate, 250000.0)
+        stats2 = copy.deepcopy(stats)
+        self.assertEqual(stats2.sampling_rate, 250000.0)
+
+
 def suite():
     return unittest.makeSuite(StatsTestCase, 'test')
 
