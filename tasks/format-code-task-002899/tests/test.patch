+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+export GOFLAGS=-mod=mod
+export GOSUMDB=off
+export GOPROXY="file://$(go env GOMODCACHE)/cache/download"
+if grep -q 'deepmap/oapi-codegen v1.4.1' go.mod; then
+    sed -i 's#deepmap/oapi-codegen v1.4.1#deepmap/oapi-codegen v1.4.2#' go.mod
+fi
+
+
+go test ./typesense/
+
+
+go test ./typesense/api/circuit/
