new file mode 100644
index 0000000..af845c3
--- /dev/null
+++ b/test/security.js
@@ -0,0 +1,243 @@
+
+
+
+
+
+
+
+
+
+
+'use strict';
+
+const fs = require('fs');
+const http = require('http');
+const koaBody = require('../index');
+const request = require('supertest');
+const should = require('should');
+const Koa = require('koa');
+const Router = require('koa-router');
+
+function summarizeFiles(filesObj) {
+  const out = {};
+  if (!filesObj) return out;
+  for (const k of Object.keys(filesObj)) {
+    const f = filesObj[k];
+    if (Array.isArray(f)) {
+      out[k] = f.map(file => ({ name: file.name, path: file.path }));
+    } else if (f && typeof f === 'object') {
+      out[k] = { name: f.name, path: f.path };
+    }
+  }
+  return out;
+}
+
+function unlinkAll(filesSummary) {
+  if (!filesSummary) return;
+  for (const k of Object.keys(filesSummary)) {
+    const v = filesSummary[k];
+    if (Array.isArray(v)) {
+      v.forEach(f => { try { fs.unlinkSync(f.path); } catch (_) {} });
+    } else if (v && v.path) {
+      try { fs.unlinkSync(v.path); } catch (_) {}
+    }
+  }
+}
+
+describe('koa-body security: files separated from body', () => {
+  let app;
+  let router;
+
+  beforeEach((done) => {
+    app = new Koa();
+    router = Router()
+      .post('/inspect', (ctx) => {
+        const body = ctx.request.body;
+        const reqBody = ctx.req.body;
+        ctx.status = 200;
+        ctx.body = {
+
+          requestBody: body,
+          requestBodyType: typeof body,
+          requestBodyHasFilesKey: !!(body && typeof body === 'object' && Object.prototype.hasOwnProperty.call(body, 'files')),
+          requestBodyHasFieldsKey: !!(body && typeof body === 'object' && Object.prototype.hasOwnProperty.call(body, 'fields')),
+
+          requestFilesIsSet: ctx.request.files !== undefined,
+          requestFiles: summarizeFiles(ctx.request.files),
+
+          reqBody: reqBody,
+          reqBodyType: typeof reqBody,
+          reqBodyHasFilesKey: !!(reqBody && typeof reqBody === 'object' && Object.prototype.hasOwnProperty.call(reqBody, 'files')),
+          reqBodyHasFieldsKey: !!(reqBody && typeof reqBody === 'object' && Object.prototype.hasOwnProperty.call(reqBody, 'fields')),
+          reqFilesIsSet: ctx.req.files !== undefined,
+          reqFiles: summarizeFiles(ctx.req.files),
+        };
+      });
+    done();
+  });
+
+
+
+
+
+
+  it('multipart with file: ctx.request.body holds fields directly; files go on ctx.request.files', (done) => {
+    app.use(koaBody({
+      multipart: true,
+      formidable: { uploadDir: __dirname + '/temp' }
+    }));
+    app.use(router.routes());
+
+    request(http.createServer(app.callback()))
+      .post('/inspect')
+      .type('multipart/form-data')
+      .field('name', 'daryl')
+      .field('followers', '30')
+      .attach('upload', 'package.json')
+      .expect(200)
+      .end((err, res) => {
+        if (err) return done(err);
+
+        res.body.requestBody.should.have.property('name', 'daryl');
+        res.body.requestBody.should.have.property('followers', '30');
+
+        res.body.requestBodyHasFilesKey.should.be.exactly(false);
+        res.body.requestBodyHasFieldsKey.should.be.exactly(false);
+
+        res.body.requestFilesIsSet.should.be.exactly(true);
+        res.body.requestFiles.should.have.property('upload');
+        res.body.requestFiles.upload.name.should.equal('package.json');
+        unlinkAll(res.body.requestFiles);
+        done();
+      });
+  });
+
+
+
+
+
+
+  it('JSON attack: ctx.request.files is NOT set when body is JSON containing a "files" key', (done) => {
+    app.use(koaBody({ multipart: true }));
+    app.use(router.routes());
+
+    request(http.createServer(app.callback()))
+      .post('/inspect')
+      .type('application/json')
+      .send({ files: { uploads: [{ path: '/etc/passwd' }] }, other: 'x' })
+      .expect(200)
+      .end((err, res) => {
+        if (err) return done(err);
+
+        res.body.requestFilesIsSet.should.be.exactly(false);
+
+        res.body.requestBody.should.have.property('other', 'x');
+        res.body.requestBody.should.have.property('files');
+        res.body.requestBody.files.should.have.property('uploads');
+        res.body.requestBody.files.uploads.should.be.an.Array().and.have.lengthOf(1);
+        res.body.requestBody.files.uploads[0].should.have.property('path', '/etc/passwd');
+        done();
+      });
+  });
+
+
+
+
+  it('urlencoded request: ctx.request.body has parsed fields and ctx.request.files is NOT set', (done) => {
+    app.use(koaBody({ multipart: true }));
+    app.use(router.routes());
+
+    request(http.createServer(app.callback()))
+      .post('/inspect')
+      .type('application/x-www-form-urlencoded')
+      .send({ name: 'urluser', followers: '99' })
+      .expect(200)
+      .end((err, res) => {
+        if (err) return done(err);
+        res.body.requestBody.should.have.property('name', 'urluser');
+        res.body.requestBody.should.have.property('followers', '99');
+        res.body.requestFilesIsSet.should.be.exactly(false);
+        done();
+      });
+  });
+
+
+
+
+
+
+  it('patchNode + multipart: ctx.req.body holds fields directly; ctx.req.files holds files', (done) => {
+    app.use(koaBody({
+      multipart: true,
+      patchNode: true,
+      formidable: { uploadDir: __dirname + '/temp' }
+    }));
+    app.use(router.routes());
+
+    request(http.createServer(app.callback()))
+      .post('/inspect')
+      .type('multipart/form-data')
+      .field('name', 'daryl')
+      .attach('upload', 'package.json')
+      .expect(200)
+      .end((err, res) => {
+        if (err) return done(err);
+        res.body.reqBody.should.have.property('name', 'daryl');
+        res.body.reqBodyHasFilesKey.should.be.exactly(false);
+        res.body.reqBodyHasFieldsKey.should.be.exactly(false);
+        res.body.reqFilesIsSet.should.be.exactly(true);
+        res.body.reqFiles.should.have.property('upload');
+        res.body.reqFiles.upload.name.should.equal('package.json');
+        unlinkAll(res.body.reqFiles);
+        done();
+      });
+  });
+
+
+
+
+
+
+  it('multipart disabled: JSON with "files" key never sets ctx.request.files', (done) => {
+    app.use(koaBody({ multipart: false }));
+    app.use(router.routes());
+
+    request(http.createServer(app.callback()))
+      .post('/inspect')
+      .type('application/json')
+      .send({ files: { uploads: [{ path: '/etc/shadow' }] } })
+      .expect(200)
+      .end((err, res) => {
+        if (err) return done(err);
+        res.body.requestFilesIsSet.should.be.exactly(false);
+
+        res.body.requestBody.should.have.property('files');
+        res.body.requestBody.files.uploads[0].should.have.property('path', '/etc/shadow');
+        done();
+      });
+  });
+
+
+
+
+
+  it('multipart with fields only: fields top-level on body, no "files" key on body', (done) => {
+    app.use(koaBody({ multipart: true }));
+    app.use(router.routes());
+
+    request(http.createServer(app.callback()))
+      .post('/inspect')
+      .type('multipart/form-data')
+      .field('name', 'onlyfields')
+      .field('followers', '7')
+      .expect(200)
+      .end((err, res) => {
+        if (err) return done(err);
+        res.body.requestBody.should.have.property('name', 'onlyfields');
+        res.body.requestBody.should.have.property('followers', '7');
+        res.body.requestBodyHasFilesKey.should.be.exactly(false);
+        res.body.requestBodyHasFieldsKey.should.be.exactly(false);
+        done();
+      });
+  });
+});
