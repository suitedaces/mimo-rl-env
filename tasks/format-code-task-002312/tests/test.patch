+<?php
+
+
+
+
+
+
+
+
+
+
+namespace Predis\Configuration\Option;
+
+use PredisTestCase;
+
+/**
+ * Behavioural tests for the self-contained aggregate connection initializers
+ * exposed by the `aggregate`, `cluster` and `replication` client options.
+ */
+class AggregateInitializerContractTest extends PredisTestCase
+{
+    /**
+     * Builds an options mock whose magic getter resolves the most common
+     * options accessed by the aggregate connection initializers.
+     */
+    protected function getOptionsMock(array $values = array())
+    {
+        $options = $this->getMockBuilder('Predis\Configuration\OptionsInterface')->getMock();
+        $options
+            ->method('__get')
+            ->willReturnCallback(function ($name) use ($values) {
+                return isset($values[$name]) ? $values[$name] : null;
+            });
+
+        return $options;
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testAggregateReturnsCallableInitializer(): void
+    {
+        $option = new Aggregate();
+        $options = $this->getOptionsMock();
+        $connection = $this->getMockBuilder('Predis\Connection\AggregateConnectionInterface')->getMock();
+
+        $initializer = $option->filter($options, function () use ($connection) {
+            return $connection;
+        });
+
+        $this->assertIsCallable($initializer);
+        $this->assertSame($connection, $initializer(array()));
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testInitializerInvokesUserCallableWithParametersOptionsAndOption(): void
+    {
+        $option = new Aggregate();
+        $options = $this->getOptionsMock();
+        $connection = $this->getMockBuilder('Predis\Connection\AggregateConnectionInterface')->getMock();
+
+        $received = null;
+        $callable = function ($parameters, $opts, $opt) use ($connection, &$received) {
+            $received = func_get_args();
+
+            return $connection;
+        };
+
+        $initializer = $option->filter($options, $callable);
+        $result = $initializer(array('tcp://127.0.0.1:6379'));
+
+        $this->assertSame($connection, $result);
+        $this->assertCount(3, $received);
+        $this->assertSame(array('tcp://127.0.0.1:6379'), $received[0]);
+        $this->assertInstanceOf('Predis\Configuration\OptionsInterface', $received[1]);
+        $this->assertInstanceOf('Predis\Configuration\OptionInterface', $received[2]);
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testInitializerPassesParametersByReference(): void
+    {
+        $option = new Aggregate();
+        $options = $this->getOptionsMock();
+        $connection = $this->getMockBuilder('Predis\Connection\AggregateConnectionInterface')->getMock();
+
+
+
+        $connection
+            ->expects($this->never())
+            ->method('add');
+
+        $callable = function (&$parameters, $opts, $opt) use ($connection) {
+            $parameters = array();
+
+            return $connection;
+        };
+
+        $initializer = $option->filter($options, $callable);
+        $initializer(array('tcp://127.0.0.1:6379'), true);
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testInitializerThrowsOnInvalidReturnedConnection(): void
+    {
+        $this->expectException('InvalidArgumentException');
+
+        $option = new Aggregate();
+        $options = $this->getOptionsMock();
+        $notAggregate = $this->getMockBuilder('Predis\Connection\NodeConnectionInterface')->getMock();
+
+        $initializer = $option->filter($options, function () use ($notAggregate) {
+            return $notAggregate;
+        });
+
+        $initializer(array());
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testAggregateRejectsNonCallableValue(): void
+    {
+        $this->expectException('InvalidArgumentException');
+
+        $option = new Aggregate();
+        $options = $this->getOptionsMock();
+
+        $option->filter($options, true);
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testAggregateHasNoDefaultInitializer(): void
+    {
+        $option = new Aggregate();
+        $options = $this->getOptionsMock();
+
+        $this->assertNull($option->getDefault($options));
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testAutoAggregationAddsNodesWhenEnabled(): void
+    {
+        $option = new Aggregate();
+
+        $factory = $this->getMockBuilder('Predis\Connection\FactoryInterface')->getMock();
+        $createdNode = $this->getMockBuilder('Predis\Connection\NodeConnectionInterface')->getMock();
+        $existingNode = $this->getMockBuilder('Predis\Connection\NodeConnectionInterface')->getMock();
+
+        $factory
+            ->expects($this->once())
+            ->method('create')
+            ->with('tcp://127.0.0.1:6379')
+            ->willReturn($createdNode);
+
+        $options = $this->getOptionsMock(array('connections' => $factory));
+
+        $connection = $this->getMockBuilder('Predis\Connection\AggregateConnectionInterface')->getMock();
+        $connection
+            ->expects($this->exactly(2))
+            ->method('add')
+            ->withConsecutive(
+                array($createdNode),
+                array($existingNode)
+            );
+
+        $initializer = $option->filter($options, function () use ($connection) {
+            return $connection;
+        });
+
+        $result = $initializer(array('tcp://127.0.0.1:6379', $existingNode), true);
+
+        $this->assertSame($connection, $result);
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testAutoAggregationIsSkippedWhenDisabled(): void
+    {
+        $option = new Aggregate();
+        $options = $this->getOptionsMock();
+
+        $connection = $this->getMockBuilder('Predis\Connection\AggregateConnectionInterface')->getMock();
+        $connection
+            ->expects($this->never())
+            ->method('add');
+
+        $initializer = $option->filter($options, function () use ($connection) {
+            return $connection;
+        });
+
+
+        $initializer(array('tcp://127.0.0.1:6379'));
+        $initializer(array('tcp://127.0.0.1:6379'), false);
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testAutoAggregationIsSkippedWhenParametersAreEmpty(): void
+    {
+        $option = new Aggregate();
+        $options = $this->getOptionsMock();
+
+        $connection = $this->getMockBuilder('Predis\Connection\AggregateConnectionInterface')->getMock();
+        $connection
+            ->expects($this->never())
+            ->method('add');
+
+        $initializer = $option->filter($options, function () use ($connection) {
+            return $connection;
+        });
+
+        $initializer(array(), true);
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testClusterDefaultInitializerBuildsPredisCluster(): void
+    {
+        $option = new Cluster();
+        $options = $this->getOptionsMock();
+
+        $initializer = $option->getDefault($options);
+
+        $this->assertIsCallable($initializer);
+        $this->assertInstanceOf('Predis\Connection\Cluster\PredisCluster', $initializer(array()));
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testClusterStringPredisBuildsPredisCluster(): void
+    {
+        $option = new Cluster();
+        $options = $this->getOptionsMock();
+
+        $initializer = $option->filter($options, 'predis');
+
+        $this->assertIsCallable($initializer);
+        $this->assertInstanceOf('Predis\Connection\Cluster\PredisCluster', $initializer(array()));
+    }
+
+    /**
+     * @group disconnected
+     * @dataProvider provideRedisClusterStrings
+     */
+    public function testClusterStringRedisBuildsRedisCluster(string $value): void
+    {
+        $option = new Cluster();
+
+        $factory = $this->getMockBuilder('Predis\Connection\FactoryInterface')->getMock();
+        $crc16 = $this->getMockBuilder('Predis\Cluster\Hash\HashGeneratorInterface')->getMock();
+        $options = $this->getOptionsMock(array('connections' => $factory, 'crc16' => $crc16));
+
+        $initializer = $option->filter($options, $value);
+
+        $this->assertIsCallable($initializer);
+        $this->assertInstanceOf('Predis\Connection\Cluster\RedisCluster', $initializer(array()));
+    }
+
+    public function provideRedisClusterStrings(): array
+    {
+        return array(
+            array('redis'),
+            array('redis-cluster'),
+        );
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testClusterRejectsUnknownString(): void
+    {
+        $this->expectException('InvalidArgumentException');
+
+        $option = new Cluster();
+        $options = $this->getOptionsMock();
+
+        $option->filter($options, 'unknown');
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testClusterRejectsNonStringNonCallableValue(): void
+    {
+        $this->expectException('InvalidArgumentException');
+
+        $option = new Cluster();
+        $options = $this->getOptionsMock();
+
+        $option->filter($options, true);
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testClusterCallableInitializerSupportsAutoAggregation(): void
+    {
+        $option = new Cluster();
+
+        $factory = $this->getMockBuilder('Predis\Connection\FactoryInterface')->getMock();
+        $createdNode = $this->getMockBuilder('Predis\Connection\NodeConnectionInterface')->getMock();
+        $factory
+            ->expects($this->once())
+            ->method('create')
+            ->with('tcp://127.0.0.1:6379')
+            ->willReturn($createdNode);
+
+        $options = $this->getOptionsMock(array('connections' => $factory));
+
+        $connection = $this->getMockBuilder('Predis\Connection\AggregateConnectionInterface')->getMock();
+        $connection
+            ->expects($this->once())
+            ->method('add')
+            ->with($createdNode);
+
+        $received = null;
+        $initializer = $option->filter($options, function ($parameters, $opts, $opt) use ($connection, &$received) {
+            $received = func_get_args();
+
+            return $connection;
+        });
+
+        $initializer(array('tcp://127.0.0.1:6379'), true);
+
+        $this->assertCount(3, $received);
+        $this->assertInstanceOf('Predis\Configuration\OptionsInterface', $received[1]);
+        $this->assertInstanceOf('Predis\Configuration\OptionInterface', $received[2]);
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testReplicationDefaultInitializerBuildsMasterSlave(): void
+    {
+        $option = new Replication();
+        $options = $this->getOptionsMock();
+
+        $initializer = $option->getDefault($options);
+
+        $this->assertIsCallable($initializer);
+        $this->assertInstanceOf(
+            'Predis\Connection\Replication\MasterSlaveReplication',
+            $initializer(array())
+        );
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testReplicationStringPredisBuildsMasterSlave(): void
+    {
+        $option = new Replication();
+        $options = $this->getOptionsMock();
+
+        $initializer = $option->filter($options, 'predis');
+
+        $this->assertIsCallable($initializer);
+        $this->assertInstanceOf(
+            'Predis\Connection\Replication\MasterSlaveReplication',
+            $initializer(array())
+        );
+    }
+
+    /**
+     * @group disconnected
+     * @dataProvider provideSentinelStrings
+     */
+    public function testReplicationStringSentinelBuildsSentinelReplication(string $value): void
+    {
+        $option = new Replication();
+
+        $factory = $this->getMockBuilder('Predis\Connection\FactoryInterface')->getMock();
+        $options = $this->getOptionsMock(array('connections' => $factory, 'service' => 'mymaster'));
+
+        $initializer = $option->filter($options, $value);
+
+        $this->assertIsCallable($initializer);
+        $this->assertInstanceOf(
+            'Predis\Connection\Replication\SentinelReplication',
+            $initializer(array())
+        );
+    }
+
+    public function provideSentinelStrings(): array
+    {
+        return array(
+            array('sentinel'),
+            array('redis-sentinel'),
+        );
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testReplicationRejectsUnknownString(): void
+    {
+        $this->expectException('InvalidArgumentException');
+
+        $option = new Replication();
+        $options = $this->getOptionsMock();
+
+        $option->filter($options, 'unknown');
+    }
+
+    /**
+     * @group disconnected
+     */
+    public function testReplicationRejectsNonStringNonCallableValue(): void
+    {
+        $this->expectException('InvalidArgumentException');
+
+        $option = new Replication();
+        $options = $this->getOptionsMock();
+
+        $option->filter($options, true);
+    }
+}
