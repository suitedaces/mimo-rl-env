+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+python -m pytest -v -rA tests/test_pml_size_2d.py::test_2d_two_element_list_assigns_both tests/test_pml_size_2d.py::test_2d_two_element_list_distinct_values_no_collapse tests/test_pml_size_2d.py::test_2d_two_element_numpy_array tests/test_pml_size_2d.py::test_2d_default_when_pml_size_none tests/test_pml_size_2d.py::test_2d_single_int_assigns_both_axes_same tests/test_pml_size_2d.py::test_2d_one_element_list_assigns_both_axes_same tests/test_pml_size_2d.py::test_2d_too_many_elements_raises tests/test_pml_size_2d.py::test_3d_three_element_array_assigns_each_axis tests/test_pml_size_2d.py::test_3d_default_when_pml_size_none tests/test_pml_size_2d.py::test_3d_single_int_assigns_all_axes_same tests/test_pml_size_2d.py::test_1d_default_when_pml_size_none tests/test_pml_size_2d.py::test_1d_too_many_elements_raises
+rc=$(( rc | $? ))
+exit $rc
