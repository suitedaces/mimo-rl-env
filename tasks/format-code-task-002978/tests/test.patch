index 0000000..645ebb3
--- /dev/null
+++ b/tests/test_pml_size_2d.py
@@ -0,0 +1,133 @@
+
+
+
+
+
+
+import numpy as np
+import pytest
+
+
+import setup_test  # noqa: F401
+from kwave.kgrid import kWaveGrid
+from kwave.options.simulation_options import SimulationOptions
+
+
+def _make_2d_grid():
+    return kWaveGrid([128, 64], [1e-3, 1e-3])
+
+
+def _make_3d_grid():
+    return kWaveGrid([64, 64, 64], [1e-3, 1e-3, 1e-3])
+
+
+def _make_1d_grid():
+    return kWaveGrid([128], [1e-3])
+
+
+
+
+def test_2d_two_element_list_assigns_both():
+
+    kgrid = _make_2d_grid()
+    opts = SimulationOptions(pml_size=[15, 25])
+    SimulationOptions.option_factory(kgrid, opts)
+    assert int(opts.pml_x_size) == 15
+    assert int(opts.pml_y_size) == 25
+
+
+def test_2d_two_element_list_distinct_values_no_collapse():
+
+    kgrid = _make_2d_grid()
+    opts = SimulationOptions(pml_size=[8, 32])
+    SimulationOptions.option_factory(kgrid, opts)
+    assert int(opts.pml_x_size) == 8
+    assert int(opts.pml_y_size) == 32
+    assert int(opts.pml_x_size) != int(opts.pml_y_size)
+
+
+def test_2d_two_element_numpy_array():
+
+    kgrid = _make_2d_grid()
+    opts = SimulationOptions(pml_size=np.array([12, 30]))
+    SimulationOptions.option_factory(kgrid, opts)
+    assert int(opts.pml_x_size) == 12
+    assert int(opts.pml_y_size) == 30
+
+
+
+
+def test_2d_default_when_pml_size_none():
+    kgrid = _make_2d_grid()
+    opts = SimulationOptions()
+    SimulationOptions.option_factory(kgrid, opts)
+    assert int(opts.pml_x_size) == 20
+    assert int(opts.pml_y_size) == 20
+
+
+def test_2d_single_int_assigns_both_axes_same():
+    kgrid = _make_2d_grid()
+    opts = SimulationOptions(pml_size=17)
+    SimulationOptions.option_factory(kgrid, opts)
+    assert int(opts.pml_x_size) == 17
+    assert int(opts.pml_y_size) == 17
+
+
+def test_2d_one_element_list_assigns_both_axes_same():
+    kgrid = _make_2d_grid()
+    opts = SimulationOptions(pml_size=[14])
+    SimulationOptions.option_factory(kgrid, opts)
+    assert int(opts.pml_x_size) == 14
+    assert int(opts.pml_y_size) == 14
+
+
+def test_2d_too_many_elements_raises():
+    kgrid = _make_2d_grid()
+    opts = SimulationOptions(pml_size=[1, 2, 3])
+    with pytest.raises(ValueError):
+        SimulationOptions.option_factory(kgrid, opts)
+
+
+
+
+def test_3d_three_element_array_assigns_each_axis():
+    kgrid = _make_3d_grid()
+    opts = SimulationOptions(pml_size=np.array([10, 20, 30]))
+    SimulationOptions.option_factory(kgrid, opts)
+    assert int(opts.pml_x_size) == 10
+    assert int(opts.pml_y_size) == 20
+    assert int(opts.pml_z_size) == 30
+
+
+def test_3d_default_when_pml_size_none():
+    kgrid = _make_3d_grid()
+    opts = SimulationOptions()
+    SimulationOptions.option_factory(kgrid, opts)
+    assert int(opts.pml_x_size) == 10
+    assert int(opts.pml_y_size) == 10
+    assert int(opts.pml_z_size) == 10
+
+
+def test_3d_single_int_assigns_all_axes_same():
+    kgrid = _make_3d_grid()
+    opts = SimulationOptions(pml_size=12)
+    SimulationOptions.option_factory(kgrid, opts)
+    assert int(opts.pml_x_size) == 12
+    assert int(opts.pml_y_size) == 12
+    assert int(opts.pml_z_size) == 12
+
+
+
+
+def test_1d_default_when_pml_size_none():
+    kgrid = _make_1d_grid()
+    opts = SimulationOptions()
+    SimulationOptions.option_factory(kgrid, opts)
+    assert int(np.asarray(opts.pml_x_size).ravel()[0]) == 20
+
+
+def test_1d_too_many_elements_raises():
+    kgrid = _make_1d_grid()
+    opts = SimulationOptions(pml_size=[1, 2])
+    with pytest.raises(ValueError):
+        SimulationOptions.option_factory(kgrid, opts)
