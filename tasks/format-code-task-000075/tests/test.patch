+package config
+
+import (
+	"reflect"
+	"testing"
+)
+
+func serverNumericFieldWithDefault(t *testing.T, want int64) reflect.Value {
+	t.Helper()
+	server := reflect.ValueOf(&DiceConfig.Server).Elem()
+	for i := 0; i < server.NumField(); i++ {
+		field := server.Field(i)
+		switch field.Kind() {
+		case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+			if field.Int() == want {
+				return field
+			}
+		case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
+			if field.Uint() == uint64(want) {
+				return field
+			}
+		case reflect.Float32, reflect.Float64:
+			if field.Float() == float64(want) {
+				return field
+			}
+		}
+	}
+	t.Fatalf("server config option with numeric default %d is not available", want)
+	return reflect.Value{}
+}
+
+func numericFieldValue(t *testing.T, field reflect.Value) float64 {
+	t.Helper()
+	switch field.Kind() {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return float64(field.Int())
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
+		return float64(field.Uint())
+	case reflect.Float32, reflect.Float64:
+		return field.Float()
+	default:
+		t.Fatalf("server config field kind = %s, want numeric", field.Kind())
+		return 0
+	}
+}
+
+func setNumericField(t *testing.T, field reflect.Value, value float64) {
+	t.Helper()
+	switch field.Kind() {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		field.SetInt(int64(value))
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
+		if value < 0 {
+			t.Fatalf("cannot set unsigned server config field to %g", value)
+		}
+		field.SetUint(uint64(value))
+	case reflect.Float32, reflect.Float64:
+		field.SetFloat(value)
+	default:
+		t.Fatalf("server config field kind = %s, want numeric", field.Kind())
+	}
+}
+
+func TestDefaultEvictionPolicyIsAllKeysLFU(t *testing.T) {
+	if DiceConfig.Server.EvictionPolicy != "allkeys-lfu" {
+		t.Fatalf("default eviction policy = %q, want allkeys-lfu", DiceConfig.Server.EvictionPolicy)
+	}
+}
+
+func TestLFULogFactorDefaultAndCanBeSet(t *testing.T) {
+	field := serverNumericFieldWithDefault(t, 10)
+	if got := numericFieldValue(t, field); got != 10 {
+		t.Fatalf("default LFU growth factor = %g, want 10", got)
+	}
+
+	original := numericFieldValue(t, field)
+	t.Cleanup(func() { setNumericField(t, field, original) })
+
+	setNumericField(t, field, 37)
+	if got := numericFieldValue(t, field); got != 37 {
+		t.Fatalf("LFU growth factor config did not retain runtime value, got %g", got)
+	}
+}
