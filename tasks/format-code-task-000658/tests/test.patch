diff --git a/cmd/docker_warning_cli_test.go b/cmd/docker_warning_cli_test.go
new file mode 100644
index 00000000..f2a25f92
--- /dev/null
+++ b/cmd/docker_warning_cli_test.go
@@ -0,0 +1,160 @@
+package cmd
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync"
+	"testing"
+
+	"github.com/chanzuckerberg/fogg/util"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+
+const dockerWarningText = "Docker support is deprecated and will be removed in a future version of fogg."
+
+func minimalConfigWithDocker(t *testing.T, docker bool) []byte {
+	t.Helper()
+
+	b, err := util.TestFile("v2_minimal_valid")
+	require.NoError(t, err)
+
+	var conf map[string]interface{}
+	require.NoError(t, json.Unmarshal(b, &conf))
+	conf["docker"] = docker
+
+	out, err := json.Marshal(conf)
+	require.NoError(t, err)
+	return out
+}
+
+func runFoggCommandWithConfig(t *testing.T, command string, config []byte) (string, error) {
+	t.Helper()
+
+	dir := t.TempDir()
+	require.NoError(t, exec.Command("git", "init", dir).Run())
+
+	configPath := filepath.Join(dir, "fogg.yml")
+	require.NoError(t, os.WriteFile(configPath, config, 0600))
+
+	oldWd, err := os.Getwd()
+	require.NoError(t, err)
+	require.NoError(t, os.Chdir(dir))
+	defer func() {
+		require.NoError(t, os.Chdir(oldWd))
+	}()
+
+	var logOutput bytes.Buffer
+
+	previousLogOutput := logrus.StandardLogger().Out
+	previousFormatter := logrus.StandardLogger().Formatter
+	defer func() {
+		logrus.SetOutput(previousLogOutput)
+		logrus.SetFormatter(previousFormatter)
+	}()
+	logrus.SetOutput(&logOutput)
+	logrus.SetFormatter(&logrus.TextFormatter{DisableTimestamp: true})
+
+	rootCmd.SetArgs([]string{command, "--config", "fogg.yml"})
+
+	output, err := captureStdoutStderr(t, rootCmd.Execute)
+	return logOutput.String() + output, err
+}
+
+func captureStdoutStderr(t *testing.T, run func() error) (string, error) {
+	t.Helper()
+
+	oldStdout := os.Stdout
+	oldStderr := os.Stderr
+	stdoutR, stdoutW, err := os.Pipe()
+	require.NoError(t, err)
+	stderrR, stderrW, err := os.Pipe()
+	require.NoError(t, err)
+
+	os.Stdout = stdoutW
+	os.Stderr = stderrW
+	defer func() {
+		os.Stdout = oldStdout
+		os.Stderr = oldStderr
+	}()
+
+	var stdout bytes.Buffer
+	var stderr bytes.Buffer
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		_, _ = io.Copy(&stdout, stdoutR)
+	}()
+	go func() {
+		defer wg.Done()
+		_, _ = io.Copy(&stderr, stderrR)
+	}()
+
+	runErr := run()
+	require.NoError(t, stdoutW.Close())
+	require.NoError(t, stderrW.Close())
+	wg.Wait()
+	require.NoError(t, stdoutR.Close())
+	require.NoError(t, stderrR.Close())
+
+	return stdout.String() + stderr.String(), runErr
+}
+
+func invalidDockerConfig() []byte {
+	return []byte(`{"version":2,"docker":true}`)
+}
+
+func requireDockerWarning(t *testing.T, output string) {
+	t.Helper()
+	require.Contains(t, output, dockerWarningText)
+}
+
+func requireNoDockerWarning(t *testing.T, output string) {
+	t.Helper()
+	require.NotContains(t, output, dockerWarningText)
+}
+
+func TestPlanWarnsForDockerEnabledConfig(t *testing.T) {
+	output, err := runFoggCommandWithConfig(t, "plan", minimalConfigWithDocker(t, true))
+
+	require.NoError(t, err)
+	requireDockerWarning(t, output)
+}
+
+func TestApplyWarnsForDockerEnabledConfig(t *testing.T) {
+	output, err := runFoggCommandWithConfig(t, "apply", minimalConfigWithDocker(t, true))
+
+	require.NoError(t, err)
+	requireDockerWarning(t, output)
+}
+
+func TestPlanAndApplyDoNotWarnWhenDockerDisabled(t *testing.T) {
+	for _, command := range []string{"plan", "apply"} {
+		t.Run(command, func(t *testing.T) {
+			output, err := runFoggCommandWithConfig(t, command, minimalConfigWithDocker(t, false))
+
+			require.NoError(t, err)
+			requireNoDockerWarning(t, output)
+		})
+	}
+}
+
+func TestPlanWarnsBeforeFailingInvalidDockerConfig(t *testing.T) {
+	output, err := runFoggCommandWithConfig(t, "plan", invalidDockerConfig())
+
+	require.Error(t, err)
+	requireDockerWarning(t, output)
+}
+
+func TestApplyWarnsBeforeFailingInvalidDockerConfig(t *testing.T) {
+	output, err := runFoggCommandWithConfig(t, "apply", invalidDockerConfig())
+
+	require.Error(t, err)
+	requireDockerWarning(t, output)
+}
