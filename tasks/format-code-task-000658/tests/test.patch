diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,31 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+mkdir -p /root/go/src/github.com/chanzuckerberg
+ln -sfn /testbed /root/go/src/github.com/chanzuckerberg/fogg
+dev-switch go 1.23
+cd /root/go/src/github.com/chanzuckerberg/fogg
+
+
+export GO111MODULE=off
+
+case "${1:-}" in
+  base)
+    go test -count=1 ./apply/
+    go test -count=1 ./config/v2/ -run '^(Test_nonEmptyString|TestValidateOwnersAccount|TestValidateOwnersComponent|TestResolveStringArray|TestConfig_ValidateAWSProviders|TestReadConfig|TestReadSnowflakeProvider)$'
+    go test -count=1 ./plan/
+    ;;
+  new)
+    go test -count=1 ./config/v2/ -run '^(TestValidateReturnsDockerDeprecationWarning|TestValidateReturnsWarningsAlongsideFatalErrors|TestValidateDoesNotReturnDockerWarningWhenDockerDisabled)$'
+    go test -count=1 ./cmd/ -run '^(TestPlanWarnsForDockerEnabledConfig|TestApplyWarnsForDockerEnabledConfig|TestPlanAndApplyDoNotWarnWhenDockerDisabled|TestPlanWarnsBeforeFailingInvalidDockerConfig|TestApplyWarnsBeforeFailingInvalidDockerConfig)$'
+    go test -count=1 ./apply/ -run '^(TestApplySmokeTest|TestIntegration)$'
+    go test -count=1 ./plan/ -run '^(TestValidConfigNoPanic|TestPlanBasicV2|Test_buildTravisCI_Profiles|Test_buildTravisCI_TestBuckets)$'
+    ;;
+  *)
+    echo "usage: $0 base|new" >&2
+    exit 2
+    ;;
+esac
