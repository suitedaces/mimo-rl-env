new file mode 100644
index 00000000..fd2148a8
--- /dev/null
+++ b/config/v2/validation_warning_test.go
@@ -0,0 +1,68 @@
+package v2
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/chanzuckerberg/fogg/util"
+	"github.com/stretchr/testify/require"
+)
+
+
+const dockerDeprecationWarning = "Docker support is deprecated and will be removed in a future version of fogg."
+
+func containsDockerDeprecationWarning(warnings []string) bool {
+	for _, warning := range warnings {
+		if strings.Contains(warning, dockerDeprecationWarning) {
+			return true
+		}
+	}
+	return false
+}
+
+func containsDockerDeprecationLikeWarning(warnings []string) bool {
+	for _, warning := range warnings {
+		lower := strings.ToLower(warning)
+		if strings.Contains(lower, "docker") && strings.Contains(lower, "deprecat") {
+			return true
+		}
+	}
+	return false
+}
+
+func readMinimalValidConfig(t *testing.T) *Config {
+	t.Helper()
+
+	b, err := util.TestFile("v2_minimal_valid")
+	require.NoError(t, err)
+
+	conf, err := ReadConfig(b)
+	require.NoError(t, err)
+	return conf
+}
+
+func TestValidateReturnsDockerDeprecationWarning(t *testing.T) {
+	conf := readMinimalValidConfig(t)
+	conf.Docker = true
+
+	warnings, err := conf.Validate()
+	require.NoError(t, err)
+	require.True(t, containsDockerDeprecationWarning(warnings), "expected Docker deprecation warning in %#v", warnings)
+}
+
+func TestValidateReturnsWarningsAlongsideFatalErrors(t *testing.T) {
+	conf := &Config{Docker: true}
+
+	warnings, err := conf.Validate()
+	require.Error(t, err)
+	require.True(t, containsDockerDeprecationWarning(warnings), "expected Docker deprecation warning in %#v", warnings)
+}
+
+func TestValidateDoesNotReturnDockerWarningWhenDockerDisabled(t *testing.T) {
+	conf := readMinimalValidConfig(t)
+	conf.Docker = false
+
+	warnings, err := conf.Validate()
+	require.NoError(t, err)
+	require.False(t, containsDockerDeprecationWarning(warnings), "did not expect Docker deprecation warning in %#v", warnings)
+}
