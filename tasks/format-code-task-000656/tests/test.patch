+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export BROWSERSLIST_IGNORE_OLD_DATA=1
+export NO_UPDATE_NOTIFIER=1
+export npm_config_audit=false
+export npm_config_fund=false
+export npm_config_offline=true
+
+for path in \
+  node_modules/.bin/rollup \
+  node_modules/.bin/jest \
+  node_modules/@babel/core \
+  node_modules/@babel/preset-env \
+  node_modules/@babel/preset-typescript \
+  node_modules/@rollup/plugin-babel \
+  node_modules/@rollup/plugin-node-resolve \
+  node_modules/@wessberg/rollup-plugin-ts \
+  node_modules/hanzi-writer-data/人.json \
+  node_modules/jest-canvas-mock \
+  node_modules/jest-environment-jsdom \
+  node_modules/jest-fetch-mock \
+  node_modules/rollup-plugin-filesize \
+  node_modules/rollup-plugin-license \
+  node_modules/rollup-plugin-terser \
+  node_modules/typescript
+do
+  test -e "$path"
+done
+
+rm -rf dist
+./node_modules/.bin/rollup -c >/dev/null
+
+exec ./node_modules/.bin/jest \
+  --config '{"rootDir":"/workspace/repo","testEnvironment":"<rootDir>/jest-jsdom-env.js","setupFiles":["jest-canvas-mock"],"setupFilesAfterEnv":["<rootDir>/jest-setup.js"],"testURL":"https://test.com/url#tag"}' \
+  /workspace/repo/usercase-test-coderl/update_dimensions.test.ts \
+  --runInBand
