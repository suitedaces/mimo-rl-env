new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/update_dimensions.test.ts
@@ -0,0 +1,317 @@
+const HanziWriter = require('../dist/index.cjs.js');
+const ren = require('hanzi-writer-data/人.json');
+
+
+
+
+
+
+
+
+
+
+const charDataLoader = () => ren;
+
+const resolvePromises = async (num = 10) => {
+  for (let i = 0; i < num; i++) await Promise.resolve();
+};
+
+const currentGroup = (targetId) => {
+  const groups = document.querySelectorAll(`#${targetId} svg > g`);
+  return groups[groups.length - 1];
+};
+
+const currentTransform = (targetId) => currentGroup(targetId)?.getAttribute('transform');
+
+const expectVisibleCharacter = (targetId) => {
+  expect(currentGroup(targetId)).toBeTruthy();
+  expect(document.querySelectorAll(`#${targetId} svg path`).length).toBeGreaterThan(0);
+};
+
+const expectMountedTransform = (targetId) => {
+  const transform = currentTransform(targetId);
+  expect(transform).toEqual(expect.stringContaining('translate('));
+  expect(transform).toEqual(expect.stringContaining('scale('));
+  return transform;
+};
+
+describe('HanziWriter updateDimensions acceptance', () => {
+  test('svg updateDimensions resizes the target and remounts the visible character with new geometry', async () => {
+
+
+    document.body.innerHTML = '<div id="target"></div>';
+    const writer = HanziWriter.create('target', '人', {
+      width: 200,
+      height: 200,
+      padding: 10,
+      charDataLoader,
+    });
+
+    await writer.setCharacter('人');
+    await resolvePromises();
+
+    expect(document.querySelectorAll('#target svg').length).toBe(1);
+    expect(document.querySelector('#target svg')?.getAttribute('width')).toBe('200');
+    expect(document.querySelector('#target svg')?.getAttribute('height')).toBe('200');
+
+    const beforeTransform = expectMountedTransform('target');
+    expectVisibleCharacter('target');
+
+    writer.updateDimensions({ width: 300, height: 350, padding: 20 });
+    await resolvePromises();
+
+    expect(document.querySelector('#target svg')?.getAttribute('width')).toBe('300');
+    expect(document.querySelector('#target svg')?.getAttribute('height')).toBe('350');
+
+    expect(expectMountedTransform('target')).not.toBe(beforeTransform);
+    expectVisibleCharacter('target');
+  });
+
+  test('canvas updateDimensions updates the canvas backing element dimensions', () => {
+
+
+    document.body.innerHTML = '<div id="target"></div>';
+    const writer = HanziWriter.create('target', '人', {
+      renderer: 'canvas',
+      width: 200,
+      height: 200,
+      padding: 10,
+      charDataLoader,
+    });
+
+    expect(document.querySelectorAll('#target canvas').length).toBe(1);
+    expect(document.querySelector('#target canvas')?.getAttribute('width')).toBe('200');
+    expect(document.querySelector('#target canvas')?.getAttribute('height')).toBe('200');
+
+    writer.updateDimensions({ width: 300, height: 350, padding: 20 });
+
+    expect(document.querySelector('#target canvas')?.getAttribute('width')).toBe('300');
+    expect(document.querySelector('#target canvas')?.getAttribute('height')).toBe('350');
+  });
+
+  test('partial dimension updates retain omitted width height and padding values', async () => {
+
+
+    document.body.innerHTML = '<div id="target"></div>';
+    const writer = HanziWriter.create('target', '人', {
+      width: 200,
+      height: 200,
+      padding: 10,
+      charDataLoader,
+    });
+    await writer.setCharacter('人');
+    await resolvePromises();
+
+    let beforeTransform = expectMountedTransform('target');
+    writer.updateDimensions({ width: 250 });
+    await resolvePromises();
+    expect(document.querySelector('#target svg')?.getAttribute('width')).toBe('250');
+    expect(document.querySelector('#target svg')?.getAttribute('height')).toBe('200');
+
+    let afterTransform = expectMountedTransform('target');
+    expect(afterTransform).not.toBe(beforeTransform);
+
+    beforeTransform = afterTransform;
+    writer.updateDimensions({ height: 260 });
+    await resolvePromises();
+    expect(document.querySelector('#target svg')?.getAttribute('width')).toBe('250');
+    expect(document.querySelector('#target svg')?.getAttribute('height')).toBe('260');
+
+    afterTransform = expectMountedTransform('target');
+    expect(afterTransform).not.toBe(beforeTransform);
+
+    beforeTransform = afterTransform;
+    writer.updateDimensions({ padding: 30 });
+    await resolvePromises();
+    expect(document.querySelector('#target svg')?.getAttribute('width')).toBe('250');
+    expect(document.querySelector('#target svg')?.getAttribute('height')).toBe('260');
+
+    afterTransform = expectMountedTransform('target');
+    expect(afterTransform).not.toBe(beforeTransform);
+  });
+
+  test('active quiz keeps using resized character coordinates for later pointer input', async () => {
+
+
+    document.body.innerHTML = '<div id="target"></div>';
+    const onMistake = jest.fn();
+    const writer = HanziWriter.create('target', '人', {
+      width: 200,
+      height: 200,
+      padding: 10,
+      charDataLoader,
+    });
+    await writer.setCharacter('人');
+    await resolvePromises();
+    await writer.quiz({ onMistake });
+    await resolvePromises();
+
+    writer.updateDimensions({ width: 300, height: 350, padding: 20 });
+    await resolvePromises();
+
+    const svg = document.querySelector('#target svg');
+    svg.getBoundingClientRect = () => ({ left: 50, top: 60 });
+    svg.dispatchEvent(
+      new MouseEvent('mousedown', {
+        bubbles: true,
+        cancelable: true,
+        clientX: 170,
+        clientY: 127,
+      }),
+    );
+    svg.dispatchEvent(
+      new MouseEvent('mousemove', {
+        bubbles: true,
+        cancelable: true,
+        clientX: 190,
+        clientY: 147,
+      }),
+    );
+    document.dispatchEvent(
+      new MouseEvent('mouseup', { bubbles: true, cancelable: true }),
+    );
+    await resolvePromises();
+
+    expect(onMistake).toHaveBeenCalledTimes(1);
+
+    const mistake = onMistake.mock.calls[0][0];
+    expect(mistake.drawnPath.points.length).toBe(2);
+    expect(mistake.drawnPath.points[0].x).toBeGreaterThan(350);
+    expect(mistake.drawnPath.points[0].x).toBeLessThan(450);
+    expect(mistake.drawnPath.points[0].y).toBeGreaterThan(750);
+    expect(mistake.drawnPath.points[0].y).toBeLessThan(870);
+  });
+
+  test('two writer instances keep their own dimensions and transforms', async () => {
+
+
+    document.body.innerHTML = '<div id="a"></div><div id="b"></div>';
+    const a = HanziWriter.create('a', '人', {
+      width: 200,
+      height: 200,
+      padding: 10,
+      charDataLoader,
+    });
+    const b = HanziWriter.create('b', '人', {
+      width: 180,
+      height: 220,
+      padding: 15,
+      charDataLoader,
+    });
+    await a.setCharacter('人');
+    await b.setCharacter('人');
+    await resolvePromises();
+    const beforeATransform = expectMountedTransform('a');
+    const beforeBTransform = expectMountedTransform('b');
+
+    a.updateDimensions({ width: 300, height: 350, padding: 20 });
+    await resolvePromises();
+
+    expect(document.querySelector('#a svg')?.getAttribute('width')).toBe('300');
+    expect(document.querySelector('#a svg')?.getAttribute('height')).toBe('350');
+
+    expect(expectMountedTransform('a')).not.toBe(beforeATransform);
+    expect(document.querySelector('#b svg')?.getAttribute('width')).toBe('180');
+    expect(document.querySelector('#b svg')?.getAttribute('height')).toBe('220');
+
+    expect(expectMountedTransform('b')).toBe(beforeBTransform);
+  });
+
+  test('repeated SVG dimension updates keep renderer DOM nodes bounded', async () => {
+
+
+    document.body.innerHTML = '<div id="target"></div>';
+    const writer = HanziWriter.create('target', '人', {
+      width: 200,
+      height: 200,
+      padding: 10,
+      charDataLoader,
+    });
+    await writer.setCharacter('人');
+    await resolvePromises();
+
+
+    expectVisibleCharacter('target');
+    const beforeTransform = expectMountedTransform('target');
+
+    for (let i = 0; i < 120; i++) {
+      writer.updateDimensions({
+        width: 220 + (i % 3),
+        height: 230 + (i % 5),
+        padding: 12 + (i % 4),
+      });
+    }
+    await resolvePromises();
+
+
+    expectVisibleCharacter('target');
+    expect(document.querySelector('#target svg')?.getAttribute('width')).toBe('222');
+    expect(document.querySelector('#target svg')?.getAttribute('height')).toBe('234');
+    expect(expectMountedTransform('target')).not.toBe(beforeTransform);
+  });
+
+  test('created writer exposes the public updateDimensions method', () => {
+
+
+    document.body.innerHTML = '<div id="target"></div>';
+
+    const writer = HanziWriter.create('target', '人', {
+      width: 200,
+      height: 200,
+      padding: 10,
+      charDataLoader,
+    });
+
+
+    expect(typeof writer.updateDimensions).toBe('function');
+  });
+
+  test('quiz cleanup is idempotent after a resized active quiz', async () => {
+
+
+    document.body.innerHTML = '<div id="target"></div>';
+    const onMistake = jest.fn();
+    const writer = HanziWriter.create('target', '人', {
+      width: 200,
+      height: 200,
+      padding: 10,
+      charDataLoader,
+    });
+    await writer.setCharacter('人');
+    await resolvePromises();
+    await writer.quiz({ onMistake });
+    await resolvePromises();
+    writer.updateDimensions({ width: 300, height: 350, padding: 20 });
+    await resolvePromises();
+
+    expect(() => {
+      writer.cancelQuiz();
+      writer.cancelQuiz();
+    }).not.toThrow();
+
+    const svg = document.querySelector('#target svg');
+    svg.getBoundingClientRect = () => ({ left: 50, top: 60 });
+    svg.dispatchEvent(
+      new MouseEvent('mousedown', {
+        bubbles: true,
+        cancelable: true,
+        clientX: 170,
+        clientY: 127,
+      }),
+    );
+    svg.dispatchEvent(
+      new MouseEvent('mousemove', {
+        bubbles: true,
+        cancelable: true,
+        clientX: 190,
+        clientY: 147,
+      }),
+    );
+    document.dispatchEvent(
+      new MouseEvent('mouseup', { bubbles: true, cancelable: true }),
+    );
+    await resolvePromises();
+
+    expect(onMistake).toHaveBeenCalledTimes(0);
+  });
+});
