+        'src/fixtures/nested/dir/data.json',
+        defaultOptions,
+        defaultConfig,
+      );
+    });
+  });
+
+  describe('json instrumentation - preservation and discrimination', () => {
+    it('returns true for .js files (preservation: non-json should still be instrumented)', () => {
+      const result = shouldInstrument(
+        'src/source_file.js',
+        defaultOptions,
+        defaultConfig,
+      );
+      expect(result).toBe(true);
+    });
+
+    it('returns false for .json file when collectCoverage is false (collectCoverage gate still wins)', () => {
+      const result = shouldInstrument(
+        'data.json',
+        {...defaultOptions, collectCoverage: false},
+        defaultConfig,
+      );
+      expect(result).toBe(false);
+    });
+
+    it('returns true for files that merely contain ".json" but do not end with it', () => {
+      const result = shouldInstrument(
+        'src/data.json.js',
+        defaultOptions,
+        defaultConfig,
+      );
