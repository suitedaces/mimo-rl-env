diff --git a/packages/rendermime/test/factories.spec.ts b/packages/rendermime/test/factories.spec.ts
index 340d05483c..2f2c2af99e 100644
--- a/packages/rendermime/test/factories.spec.ts
+++ b/packages/rendermime/test/factories.spec.ts
@@ -13,6 +13,7 @@ import {
   latexRendererFactory,
   markdownRendererFactory,
   MimeModel,
+  standardRendererFactories,
   svgRendererFactory,
   textRendererFactory
 } from '../src';
@@ -465,5 +466,44 @@ describe('rendermime/factories', () => {
         expect(el.innerHTML).toBe('');
       });
     });
+
+    describe('webp support (issue 12866)', () => {
+      it('should include image/webp in mimeTypes for webp renderer lookup', () => {
+        expect(imageRendererFactory.mimeTypes).toContain('image/webp');
+      });
+
+      it('should keep all previously-supported image mimeTypes alongside webp', () => {
+        expect(imageRendererFactory.mimeTypes).toEqual(
+          expect.arrayContaining([
+            'image/bmp',
+            'image/png',
+            'image/jpeg',
+            'image/gif',
+            'image/webp'
+          ])
+        );
+      });
+
+      it('should be registered among the standard renderer factories for webp', () => {
+        const webpFactories = standardRendererFactories.filter(f =>
+          f.mimeTypes.includes('image/webp')
+        );
+        expect(webpFactories).toContain(imageRendererFactory);
+      });
+
+      it('should render an <img> with the image/webp data URI when given webp source', async () => {
+        const source =
+          'UklGRiQAAABXRUJQVlA4IBgAAAAwAQCdASoBAAEAAwA0JaQAA3AA/vuUAAA=';
+        const f = imageRendererFactory;
+        const mimeType = 'image/webp';
+        const model = createModel(mimeType, source);
+        const w = f.createRenderer({ mimeType, ...defaultOptions });
+        await w.renderModel(model);
+        const el = w.node.firstChild as HTMLImageElement;
+        expect(el.localName).toBe('img');
+        expect(el.src).toBe('data:image/webp;base64,' + source);
+        expect(el.innerHTML).toBe('');
+      });
+    });
   });
 });
