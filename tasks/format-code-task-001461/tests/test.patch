+import asyncio
+import uuid
+
+import pytest
+
+from bleak import (
+    BleakClient,
+    BleakError,
+    BleakGATTCharacteristic,
+    BleakGATTDescriptor,
+    BleakGATTServiceCollection,
+)
+from bleak.backends.client import BaseBleakClient
+from bleak.backends.service import BleakGATTService
+
+BATTERY_SERVICE = "0000180f-0000-1000-8000-00805f9b34fb"
+HEART_RATE_SERVICE = "0000180d-0000-1000-8000-00805f9b34fb"
+DUPLICATE_SERVICE = "11111111-2222-3333-4444-555555555555"
+BATTERY_LEVEL = "00002a19-0000-1000-8000-00805f9b34fb"
+BODY_SENSOR_LOCATION = "00002a38-0000-1000-8000-00805f9b34fb"
+DUPLICATE_CHARACTERISTIC = "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
+USER_DESCRIPTION = "00002901-0000-1000-8000-00805f9b34fb"
+CLIENT_CONFIGURATION = "00002902-0000-1000-8000-00805f9b34fb"
+
+
+def _build_discovered_services():
+    services = BleakGATTServiceCollection()
+
+    battery_service = BleakGATTService("battery-service-obj", 1, BATTERY_SERVICE)
+    heart_service = BleakGATTService("heart-service-obj", 20, HEART_RATE_SERVICE)
+    duplicate_service_1 = BleakGATTService(
+        "duplicate-service-1-obj", 40, DUPLICATE_SERVICE
+    )
+    duplicate_service_2 = BleakGATTService(
+        "duplicate-service-2-obj", 50, DUPLICATE_SERVICE
+    )
+
+    for service in (
+        battery_service,
+        heart_service,
+        duplicate_service_1,
+        duplicate_service_2,
+    ):
+        services.add_service(service)
+
+    battery_level = BleakGATTCharacteristic(
+        "battery-level-obj",
+        3,
+        BATTERY_LEVEL,
+        ["read", "notify"],
+        lambda: 64,
+        battery_service,
+    )
+    body_sensor = BleakGATTCharacteristic(
+        "body-sensor-location-obj",
+        22,
+        BODY_SENSOR_LOCATION,
+        ["read"],
+        lambda: 20,
+        heart_service,
+    )
+    duplicate_characteristic_1 = BleakGATTCharacteristic(
+        "duplicate-characteristic-1-obj",
+        42,
+        DUPLICATE_CHARACTERISTIC,
+        ["read"],
+        lambda: 20,
+        duplicate_service_1,
+    )
+    duplicate_characteristic_2 = BleakGATTCharacteristic(
+        "duplicate-characteristic-2-obj",
+        52,
+        DUPLICATE_CHARACTERISTIC,
+        ["read"],
+        lambda: 20,
+        duplicate_service_2,
+    )
+
+    for characteristic in (
+        battery_level,
+        body_sensor,
+        duplicate_characteristic_1,
+        duplicate_characteristic_2,
+    ):
+        services.add_characteristic(characteristic)
+
+    user_description = BleakGATTDescriptor(
+        "battery-user-description-obj", 4, USER_DESCRIPTION, battery_level
+    )
+    client_configuration = BleakGATTDescriptor(
+        "battery-client-configuration-obj", 5, CLIENT_CONFIGURATION, battery_level
+    )
+    sensor_user_description = BleakGATTDescriptor(
+        "sensor-user-description-obj", 23, USER_DESCRIPTION, body_sensor
+    )
+
+    for descriptor in (
+        user_description,
+        client_configuration,
+        sensor_user_description,
+    ):
+        services.add_descriptor(descriptor)
+
+    return services, battery_service, heart_service, battery_level, body_sensor
+
+
+class FakeClientBackend(BaseBleakClient):
+    connect_calls = 0
+    disconnect_calls = 0
+
+    @property
+    def name(self):
+        return "fixture peripheral"
+
+    @property
+    def mtu_size(self):
+        return 23
+
+    async def connect(self, pair, **kwargs):
+        FakeClientBackend.connect_calls += 1
+        self.services = _build_discovered_services()[0]
+        self._connected = True
+
+    async def disconnect(self):
+        FakeClientBackend.disconnect_calls += 1
+        self._connected = False
+
+    async def pair(self, *args, **kwargs):
+        return None
+
+    async def unpair(self):
+        return None
+
+    @property
+    def is_connected(self):
+        return getattr(self, "_connected", False)
+
+    async def read_gatt_char(self, characteristic, *, use_cached=False, **kwargs):
+        return bytearray()
+
+    async def read_gatt_descriptor(self, descriptor, *, use_cached=False, **kwargs):
+        return bytearray()
+
+    async def write_gatt_char(self, characteristic, data, response):
+        return None
+
+    async def write_gatt_descriptor(self, descriptor, data):
+        return None
+
+    async def start_notify(self, characteristic, callback, **kwargs):
+        return None
+
+    async def stop_notify(self, characteristic):
+        return None
+
+
+def test_connected_client_services_collection_lookup_helpers():
+
+
+
+
+
+    async def run_session():
+        async with BleakClient("AA:BB:CC:DD:EE:FF", backend=FakeClientBackend) as client:
+            services = client.services
+
+
+
+            assert services.get_service(1) is not None
+
+            assert services.get_service(1).handle == 1
+
+
+            assert services.get_service(BATTERY_SERVICE).handle == 1
+            assert services.get_service(uuid.UUID(HEART_RATE_SERVICE)).handle == 20
+            assert services.get_service(999) is None
+            assert (
+                services.get_service("99999999-2222-3333-4444-555555555555")
+                is None
+            )
+
+            assert services.get_characteristic(3).handle == 3
+
+
+            assert services.get_characteristic(BATTERY_LEVEL).handle == 3
+            assert (
+                services.get_characteristic(uuid.UUID(BODY_SENSOR_LOCATION)).handle
+                == 22
+            )
+            assert services.get_characteristic(999) is None
+            assert (
+                services.get_characteristic("99999999-bbbb-cccc-dddd-eeeeeeeeeeee")
+                is None
+            )
+
+            assert services.get_descriptor(4).handle == 4
+            assert services.get_descriptor(999) is None
+
+    asyncio.run(run_session())
+
+
+def test_services_getitem_resolves_services_then_characteristics_then_descriptors():
+
+
+
+
+    services = BleakGATTServiceCollection()
+
+    collision_uuid = "22222222-3333-4444-5555-666666666666"
+    char_uuid = "33333333-4444-5555-6666-777777777777"
+    descriptor_uuid = "44444444-5555-6666-7777-888888888888"
+    service = BleakGATTService("collision-service-obj", 7, collision_uuid)
+    services.add_service(service)
+    same_uuid_characteristic = BleakGATTCharacteristic(
+        "same-uuid-characteristic-obj",
+        8,
+        collision_uuid,
+        ["read"],
+        lambda: 20,
+        service,
+    )
+    same_handle_characteristic = BleakGATTCharacteristic(
+        "same-handle-characteristic-obj",
+        71,
+        char_uuid,
+        ["read"],
+        lambda: 20,
+        service,
+    )
+    services.add_characteristic(same_uuid_characteristic)
+    services.add_characteristic(same_handle_characteristic)
+    services.add_descriptor(
+        BleakGATTDescriptor(
+            "descriptor-fallback-obj", 9, descriptor_uuid, same_handle_characteristic
+        )
+    )
+    services.add_descriptor(
+        BleakGATTDescriptor(
+            "same-handle-descriptor-obj",
+            71,
+            descriptor_uuid,
+            same_handle_characteristic,
+        )
+    )
+
+    assert services[collision_uuid].handle == 7
+    assert services[71].uuid == "33333333-4444-5555-6666-777777777777"
+    assert services[9].uuid == "44444444-5555-6666-7777-888888888888"
+    assert services[999] is None
+
+
+def test_service_and_characteristic_object_lookup_helpers():
+
+
+
+
+    services, battery_service, heart_service, battery_level, _ = (
+        _build_discovered_services()
+    )
+
+    assert battery_service.get_characteristic(BATTERY_LEVEL.upper()).handle == 3
+    assert (
+        heart_service.get_characteristic(uuid.UUID(BODY_SENSOR_LOCATION)).handle == 22
+    )
+    assert battery_service.get_characteristic(BODY_SENSOR_LOCATION) is None
+
+
+    assert battery_service.get_characteristic(BATTERY_LEVEL) is not None
+
+    first_match_service = BleakGATTService(
+        "first-match-service-obj", 100, HEART_RATE_SERVICE
+    )
+    first_characteristic = BleakGATTCharacteristic(
+        "first-duplicate-characteristic-obj",
+        101,
+        DUPLICATE_CHARACTERISTIC,
+        ["read"],
+        lambda: 20,
+        first_match_service,
+    )
+    second_characteristic = BleakGATTCharacteristic(
+        "second-duplicate-characteristic-obj",
+        102,
+        DUPLICATE_CHARACTERISTIC,
+        ["read"],
+        lambda: 20,
+        first_match_service,
+    )
+    first_match_service.add_characteristic(first_characteristic)
+    first_match_service.add_characteristic(second_characteristic)
+    assert first_match_service.get_characteristic(DUPLICATE_CHARACTERISTIC).handle == 101
+
+    assert battery_level.get_descriptor(4).handle == 4
+    assert battery_level.get_descriptor(USER_DESCRIPTION.upper()).handle == 4
+    assert battery_level.get_descriptor(uuid.UUID(CLIENT_CONFIGURATION)).handle == 5
+    assert battery_level.get_descriptor(999) is None
+    assert (
+        battery_level.get_descriptor("99999999-0000-1000-8000-00805f9b34fb")
+        is None
+    )
+
+
+    assert battery_level.get_descriptor(USER_DESCRIPTION) is not None
+
+    assert services.get_service(1).get_characteristic(BATTERY_LEVEL).handle == 3
+
+
+def test_ambiguous_service_and_characteristic_uuid_lookups_raise_bleakerror():
+
+
+
+
+    services = _build_discovered_services()[0]
+
+    with pytest.raises(BleakError):
+        services.get_service(DUPLICATE_SERVICE)
+
+    assert services.get_service(40).uuid == DUPLICATE_SERVICE
+
+    with pytest.raises(BleakError):
+        services.get_characteristic(DUPLICATE_CHARACTERISTIC)
+
+    assert services.get_characteristic(42).uuid == DUPLICATE_CHARACTERISTIC
+
+    with pytest.raises(BleakError):
+        services[DUPLICATE_SERVICE]
+
+    assert services[40].uuid == DUPLICATE_SERVICE
+
+    with pytest.raises(BleakError):
+        services[DUPLICATE_CHARACTERISTIC]
+
+    assert services[42].uuid == DUPLICATE_CHARACTERISTIC
+
+
+def test_client_services_before_discovery_raises_specific_bleakerror():
+
+
+
+
+    async def run_session():
+        client = BleakClient("AA:BB:CC:DD:EE:FF", backend=FakeClientBackend)
+        await client.connect()
+        try:
+
+
+            assert client.services.get_service(BATTERY_SERVICE).handle == 1
+        finally:
+            await client.disconnect()
+
+    asyncio.run(run_session())
+
+
+def test_client_disconnect_cleanup_is_idempotent():
+
+
+
+
+
+    async def run_session():
+        client = BleakClient("AA:BB:CC:DD:EE:FF", backend=FakeClientBackend)
+
+        await client.connect()
+        try:
+
+
+            assert client.services.get_characteristic(BATTERY_LEVEL).handle == 3
+        finally:
+            await client.disconnect()
+
+    asyncio.run(run_session())
+
+
+def test_two_service_collections_keep_independent_state():
+
+
+
+
+    a = _build_discovered_services()[0]
+    b = _build_discovered_services()[0]
+
+    a.add_service(
+        BleakGATTService(
+            "extra-service-obj", 99, "99999999-aaaa-bbbb-cccc-dddddddddddd"
+        )
+    )
+
+
+
+    assert a.get_service(99) is not None
+    assert b.get_service(99) is None
+    assert a.get_service(99).uuid == "99999999-aaaa-bbbb-cccc-dddddddddddd"
+    assert b.get_service(99) is None
+    assert b.get_service(1).uuid == "0000180f-0000-1000-8000-00805f9b34fb"
+
+
+def test_repeated_construct_use_and_drop_cycles_do_not_retain_service_trees():
+
+
+
+
+    completed = 0
+    for _ in range(250):
+        services = _build_discovered_services()[0]
+        assert services.get_service(1).handle == 1
+        assert services.get_characteristic(3).handle == 3
+        assert services.get_descriptor(4).handle == 4
+        completed += 1
+        del services
+
+
+
+    assert completed == 250
