+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+
+
+set -euo pipefail
+
+cd /workspace/repo
+
+VENV=/opt/bleak-stage4a-venv
+if [ ! -x "$VENV/bin/python" ]; then
+    echo "missing preinstalled offline test venv: $VENV" >&2
+    exit 1
+fi
+
+export PIP_NO_INDEX=1
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+
+exec "$VENV/bin/python" -m pytest \
+    -p pytest_asyncio.plugin \
+    -p pytest_cov \
+    /workspace/repo/usercase-test-coderl/test_gatt_service_tree_lookup.py -v
