+def test_groupby_quantile_nullable_int_scalar():
+
+    df = pd.DataFrame(
+        {"a": ["x", "x", "y", "y"], "b": pd.array([1, 2, 3, 4], dtype="Int64")}
+    )
+    result = df.groupby("a")["b"].quantile(0.5)
+    expected = pd.Series(
+        [1.5, 3.5],
+        index=pd.Index(["x", "y"], name="a"),
+        name="b",
+    )
+    tm.assert_series_equal(result, expected)
+
+
+def test_groupby_quantile_nullable_int_with_na():
+
+    df = pd.DataFrame(
+        {
+            "a": ["x", "x", "y", "y"],
+            "b": pd.array([1, pd.NA, 3, 4], dtype="Int64"),
+        }
+    )
+    result = df.groupby("a")["b"].quantile(0.5)
+    expected = pd.Series(
+        [1.0, 3.5],
+        index=pd.Index(["x", "y"], name="a"),
+        name="b",
+    )
+    tm.assert_series_equal(result, expected)
+
+
+def test_groupby_quantile_nullable_int_array_q():
+
+    df = pd.DataFrame(
+        {"a": ["x", "x", "y", "y"], "b": pd.array([1, 2, 3, 4], dtype="Int64")}
+    )
+    result = df.groupby("a")["b"].quantile([0.25, 0.75])
+    expected = pd.Series(
+        [1.25, 1.75, 3.25, 3.75],
+        index=pd.MultiIndex.from_tuples(
+            [("x", 0.25), ("x", 0.75), ("y", 0.25), ("y", 0.75)],
+            names=["a", None],
+        ),
+        name="b",
+    )
+    tm.assert_series_equal(result, expected)
+
+
+def test_groupby_quantile_nullable_bool():
+
+    df = pd.DataFrame(
+        {
+            "a": ["x", "x", "y", "y"],
+            "b": pd.array([True, False, True, True], dtype="boolean"),
+        }
+    )
+    result = df.groupby("a")["b"].quantile(0.5)
+    expected = pd.Series(
+        [0.5, 1.0],
+        index=pd.Index(["x", "y"], name="a"),
+        name="b",
+    )
+    tm.assert_series_equal(result, expected)
+
+
+def test_groupby_quantile_nullable_bool_with_na():
+
+    df = pd.DataFrame(
+        {
+            "a": ["x", "x", "y", "y"],
+            "b": pd.array([True, pd.NA, True, False], dtype="boolean"),
+        }
+    )
+    result = df.groupby("a")["b"].quantile(0.5)
+    expected = pd.Series(
+        [1.0, 0.5],
+        index=pd.Index(["x", "y"], name="a"),
+        name="b",
+    )
+    tm.assert_series_equal(result, expected)
+
+
+def test_groupby_quantile_numpy_int_preserved():
+
+    df = pd.DataFrame({"a": ["x", "x", "y", "y"], "b": [1, 2, 3, 4]})
+    result = df.groupby("a")["b"].quantile(0.5)
+    expected = pd.Series(
+        [1.5, 3.5],
+        index=pd.Index(["x", "y"], name="a"),
+        name="b",
+    )
+    tm.assert_series_equal(result, expected)
+
