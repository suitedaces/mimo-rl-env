diff --git a/tests/test_custom_mapping_sources.py b/tests/test_custom_mapping_sources.py
new file mode 100644
index 00000000..1111111
--- /dev/null
+++ b/tests/test_custom_mapping_sources.py
@@ -0,0 +1,123 @@
+
+
+from textwrap import dedent
+
+import pytest
+
+from .utils import run_fawltydeps_subprocess
+
+pytestmark = pytest.mark.integration
+
+
+def _write_pyproject(tmp_path, contents):
+    path = tmp_path / "pyproject.toml"
+    path.write_text(dedent(contents), encoding="utf-8")
+    return path
+
+
+def test_custom_mapping_file_flag_is_accepted(project_with_code_and_requirements_txt):
+    tmp_path = project_with_code_and_requirements_txt(
+        imports=["external_only_import"],
+        declares=["external-only-pkg"],
+    )
+    mapping_file = tmp_path / "custom_mapping.toml"
+    mapping_file.write_text(
+        'external-only-pkg = ["external_only_import"]\n',
+        encoding="utf-8",
+    )
+
+    _, _, exit_code = run_fawltydeps_subprocess(
+        "--custom-mapping-file",
+        str(mapping_file),
+        cwd=tmp_path,
+    )
+    assert exit_code == 0
+
+
+def test_help_advertises_custom_mapping_file_not_old_flag(
+    project_with_code_and_requirements_txt,
+):
+    tmp_path = project_with_code_and_requirements_txt(
+        imports=["help_flag_import"],
+        declares=["help-flag-pkg"],
+    )
+
+    stdout, _, exit_code = run_fawltydeps_subprocess("--help", cwd=tmp_path)
+    assert exit_code == 0
+    assert "--custom-mapping-file" in stdout
+    assert "--custom-mapping " not in stdout
+
+
+def test_run_uses_inline_custom_mapping_from_pyproject(
+    project_with_code_and_requirements_txt,
+):
+    tmp_path = project_with_code_and_requirements_txt(
+        imports=["inline_only_import"],
+        declares=["inline-only-pkg"],
+    )
+    config_file = _write_pyproject(
+        tmp_path,
+        """
+        [tool.fawltydeps.custom_mapping]
+        inline-only-pkg = ["inline_only_import"]
+        """,
+    )
+
+    _, _, exit_code = run_fawltydeps_subprocess(
+        config_file=config_file,
+        cwd=tmp_path,
+    )
+    assert exit_code == 0
+
+
+def test_run_combines_mapping_file_and_inline_mapping(
+    project_with_code_and_requirements_txt,
+):
+    tmp_path = project_with_code_and_requirements_txt(
+        imports=["from_file_import", "from_config_import"],
+        declares=["combined-pkg"],
+    )
+    mapping_file = tmp_path / "mapping.toml"
+    mapping_file.write_text(
+        'combined-pkg = ["from_file_import"]\n',
+        encoding="utf-8",
+    )
+    config_file = _write_pyproject(
+        tmp_path,
+        """
+        [tool.fawltydeps]
+        custom_mapping_file = "mapping.toml"
+
+        [tool.fawltydeps.custom_mapping]
+        combined_pkg = ["from_config_import"]
+        """,
+    )
+
+    _, _, exit_code = run_fawltydeps_subprocess(
+        config_file=config_file,
+        cwd=tmp_path,
+    )
+    assert exit_code == 0
+
+
+def test_invalid_custom_mapping_file_path_still_errors(
+    project_with_code_and_requirements_txt,
+):
+    tmp_path = project_with_code_and_requirements_txt(
+        imports=["bad_path_import"],
+        declares=["bad-path-pkg"],
+    )
+    (tmp_path / "not_a_file").mkdir()
+    config_file = _write_pyproject(
+        tmp_path,
+        """
+        [tool.fawltydeps]
+        custom_mapping_file = "not_a_file"
+        """,
+    )
+
+    _, _, exit_code = run_fawltydeps_subprocess(
+        config_file=config_file,
+        cwd=tmp_path,
+    )
+    assert exit_code != 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+dev-switch python3 3.12
+
+
+case "${1:-}" in
+  base)
+    pytest \
+      tests/test_types.py \
+      tests/test_extract_imports_simple.py \
+      tests/test_extract_declared_dependencies_success.py \
+      tests/test_compare_imports_to_dependencies.py \
+      -v
+    ;;
+  new)
+    pytest \
+      tests/test_custom_mapping_sources.py::test_custom_mapping_file_flag_is_accepted \
+      tests/test_custom_mapping_sources.py::test_help_advertises_custom_mapping_file_not_old_flag \
+      tests/test_custom_mapping_sources.py::test_run_uses_inline_custom_mapping_from_pyproject \
+      tests/test_custom_mapping_sources.py::test_run_combines_mapping_file_and_inline_mapping \
+      tests/test_custom_mapping_sources.py::test_invalid_custom_mapping_file_path_still_errors \
+      -m integration \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
