diff --git a/guid_test.go b/guid_test.go
new file mode 100644
index 0000000..1cc2bb9
--- /dev/null
+++ b/guid_test.go
@@ -0,0 +1,140 @@
+package ole
+
+import (
+	"fmt"
+	"testing"
+)
+
+func assertGUIDValue(t *testing.T, got *GUID, want GUID) {
+	t.Helper()
+	if got == nil {
+		t.Fatalf("NewGUID returned nil")
+	}
+	if got.Data1 != want.Data1 || got.Data2 != want.Data2 || got.Data3 != want.Data3 || got.Data4 != want.Data4 {
+		t.Fatalf("GUID value mismatch: got %#v, want %#v", got, &want)
+	}
+}
+
+func TestNewGUIDAcceptsCommonFormats(t *testing.T) {
+	want := GUID{0x13579BDF, 0x2468, 0xACE0, [8]byte{0x13, 0x57, 0x24, 0x68, 0xAC, 0xE0, 0x24, 0x68}}
+	inputs := []string{
+		"{13579BDF-2468-ACE0-1357-2468ACE02468}",
+		"13579BDF-2468-ACE0-1357-2468ACE02468",
+		"13579BDF2468ACE013572468ACE02468",
+		"{13579bdf-2468-ace0-1357-2468ace02468}",
+	}
+
+	for _, input := range inputs {
+		t.Run(input, func(t *testing.T) {
+			got := NewGUID(input)
+			assertGUIDValue(t, got, want)
+		})
+	}
+}
+
+func TestNewGUIDParsesRepresentativeValues(t *testing.T) {
+	tests := []struct {
+		input string
+		want  GUID
+	}{
+		{
+			input: "00112233-4455-6677-8899-aabbccddeeff",
+			want:  GUID{0x00112233, 0x4455, 0x6677, [8]byte{0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF}},
+		},
+		{
+			input: "{0000000F-000A-00B0-0C0D-000102030405}",
+			want:  GUID{0x0000000F, 0x000A, 0x00B0, [8]byte{0x0C, 0x0D, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05}},
+		},
+		{
+			input: "89ABCDEF-0123-4567-89AB-CDEF01234567",
+			want:  GUID{0x89ABCDEF, 0x0123, 0x4567, [8]byte{0x89, 0xAB, 0xCD, 0xEF, 0x01, 0x23, 0x45, 0x67}},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) {
+			got := NewGUID(tt.input)
+			assertGUIDValue(t, got, tt.want)
+		})
+	}
+}
+
+func TestNewGUIDRejectsInvalidInputs(t *testing.T) {
+	invalid := []string{
+		"",
+		"not-a-guid",
+		"{00112233-4455-6677-8899-AABBCCDDEEFF",
+		"00112233-4455-6677-8899-AABBCCDDEEFF}",
+		"{001122334455-6677-8899-AABBCCDDEEFF}",
+		"{00112233-4455-6677-8899-AABBCCDDEEFZ}",
+		"00112233-4455-6677-8899-AABBCCDDEEFG",
+		"00112233_4455-6677-8899-AABBCCDDEEFF",
+		"00112233-44556677-8899-AABBCCDDEEFF",
+		"00112233-4455-6677-8899-AABBCCDDEEFF ",
+		" 00112233-4455-6677-8899-AABBCCDDEEFF",
+		"00112233445566778899AABBCCDDEEF",
+		"00112233445566778899AABBCCDDEEFF00",
+		"00112233445566778899AABBCCDDEEFZ",
+	}
+
+	for _, input := range invalid {
+		if got := NewGUID(input); got != nil {
+			t.Fatalf("NewGUID(%q) = %#v, want nil", input, got)
+		}
+	}
+}
+
+func TestGUIDStringAndFmtUseCanonicalText(t *testing.T) {
+	tests := []struct {
+		name string
+		guid *GUID
+		want string
+	}{
+		{
+			name: "mixed bytes",
+			guid: &GUID{0x00112233, 0x4455, 0x6677, [8]byte{0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF}},
+			want: "{00112233-4455-6677-8899-AABBCCDDEEFF}",
+		},
+		{
+			name: "leading zero nibbles",
+			guid: &GUID{0x0000000F, 0x000A, 0x00B0, [8]byte{0x0C, 0x0D, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05}},
+			want: "{0000000F-000A-00B0-0C0D-000102030405}",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := tt.guid.String(); got != tt.want {
+				t.Fatalf("String() = %q, want %q", got, tt.want)
+			}
+			if got := fmt.Sprintf("%v", tt.guid); got != tt.want {
+				t.Fatalf("fmt.Sprintf(\"%%v\", guid) = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestNewGUIDRoundTripsToCanonicalUppercase(t *testing.T) {
+	tests := map[string]string{
+		"{abcdefab-abcd-abcd-abcd-abcdefabcdef}": "{ABCDEFAB-ABCD-ABCD-ABCD-ABCDEFABCDEF}",
+		"fEdCbAfE-fEdC-fEdC-fEdC-fEdCbAfEdCbA":   "{FEDCBAFE-FEDC-FEDC-FEDC-FEDCBAFEDCBA}",
+		"00112233445566778899aabbccddeeff":       "{00112233-4455-6677-8899-AABBCCDDEEFF}",
+	}
+
+	for input, want := range tests {
+		guid := NewGUID(input)
+		if guid == nil {
+			t.Fatalf("NewGUID(%q) returned nil", input)
+		}
+		if got := guid.String(); got != want {
+			t.Fatalf("NewGUID(%q).String() = %q, want %q", input, got, want)
+		}
+	}
+}
+
+func TestNilGUIDStringReturnsEmptyGUID(t *testing.T) {
+	var guid *GUID
+	if got, want := guid.String(), "{00000000-0000-0000-0000-000000000000}"; got != want {
+		t.Fatalf("nil GUID String() = %q, want %q", got, want)
+	}
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,25 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+mkdir -p /root/go/src/github.com/go-ole
+ln -sf /testbed /root/go/src/github.com/go-ole/go-ole
+
+
+PKG=github.com/go-ole/go-ole
+NEW_GUID_TESTS='^(TestNewGUIDAcceptsCommonFormats|TestNewGUIDParsesRepresentativeValues|TestNewGUIDRejectsInvalidInputs|TestGUIDStringAndFmtUseCanonicalText|TestNewGUIDRoundTripsToCanonicalUppercase|TestNilGUIDStringReturnsEmptyGUID)$'
+
+case "${1:-}" in
+  base)
+    GOPATH=/root/go GO111MODULE=off go test -v -run '^$' "$PKG"
+    ;;
+  new)
+    GOPATH=/root/go GO111MODULE=off go test -v -run "$NEW_GUID_TESTS" "$PKG"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
