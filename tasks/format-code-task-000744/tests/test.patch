diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,102 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+set +u
+dev-switch python3 3.11 2>/dev/null || true
+
+pip install --break-system-packages --no-deps --no-input \
+    -e python_modules/dagster \
+    -e python_modules/libraries/dagster-mysql \
+    -e python_modules/libraries/dagster-postgres \
+    2>/dev/null
+
+if ! ss -tlnp | grep -q ':3306 '; then
+    rm -f /var/run/mysqld/mysqld.sock /var/run/mysqld/mysqld.sock.lock
+    rm -f /var/run/mysqld/mysqlx.sock /var/run/mysqld/mysqlx.sock.lock
+    rm -rf /var/lib/mysql_clean
+    cp -a /var/lib/mysql_base /var/lib/mysql_clean 2>/dev/null || true
+
+    cat > /tmp/mysql-init.sql << 'SQLEOF'
+FLUSH PRIVILEGES;
+ALTER USER 'root'@'localhost' IDENTIFIED BY 'test';
+CREATE USER IF NOT EXISTS 'test'@'localhost' IDENTIFIED BY 'test';
+CREATE USER IF NOT EXISTS 'test'@'127.0.0.1' IDENTIFIED BY 'test';
+CREATE USER IF NOT EXISTS 'test'@'%' IDENTIFIED BY 'test';
+GRANT ALL PRIVILEGES ON *.* TO 'test'@'localhost';
+GRANT ALL PRIVILEGES ON *.* TO 'test'@'127.0.0.1';
+GRANT ALL PRIVILEGES ON *.* TO 'test'@'%';
+CREATE DATABASE IF NOT EXISTS test;
+FLUSH PRIVILEGES;
+SQLEOF
+
+    chown -R mysql:mysql /var/lib/mysql_clean /var/run/mysqld /var/log/mysql
+    mysqld --user=mysql --datadir=/var/lib/mysql_clean \
+        --socket=/var/run/mysqld/mysqld.sock \
+        --pid-file=/var/run/mysqld/mysqld.pid \
+        --log-error=/var/log/mysql/error.log \
+        --init-file=/tmp/mysql-init.sql \
+        --bind-address=127.0.0.1 --port=3306 &
+    sleep 5
+fi
+
+if ! ss -tlnp | grep -q ':3307 '; then
+    rm -f /var/run/mysqld2/mysqld.sock /var/run/mysqld2/mysqld.sock.lock
+    rm -rf /var/lib/mysql2_clean
+    cp -a /var/lib/mysql2_base /var/lib/mysql2_clean 2>/dev/null || true
+
+    cat > /tmp/mysql-init2.sql << 'SQLEOF'
+FLUSH PRIVILEGES;
+ALTER USER 'root'@'localhost' IDENTIFIED BY 'test';
+CREATE USER IF NOT EXISTS 'test'@'localhost' IDENTIFIED BY 'test';
+CREATE USER IF NOT EXISTS 'test'@'127.0.0.1' IDENTIFIED BY 'test';
+CREATE USER IF NOT EXISTS 'test'@'%' IDENTIFIED BY 'test';
+GRANT ALL PRIVILEGES ON *.* TO 'test'@'localhost';
+GRANT ALL PRIVILEGES ON *.* TO 'test'@'127.0.0.1';
+GRANT ALL PRIVILEGES ON *.* TO 'test'@'%';
+CREATE DATABASE IF NOT EXISTS test;
+FLUSH PRIVILEGES;
+SQLEOF
+
+    chown -R mysql:mysql /var/lib/mysql2_clean /var/run/mysqld2 /var/log/mysql2
+    mysqld --user=mysql --datadir=/var/lib/mysql2_clean \
+        --socket=/var/run/mysqld2/mysqld.sock \
+        --pid-file=/var/run/mysqld2/mysqld.pid \
+        --log-error=/var/log/mysql2/error.log \
+        --init-file=/tmp/mysql-init2.sql \
+        --bind-address=127.0.0.1 --port=3307 &
+    sleep 5
+fi
+
+if ! pg_isready -q 2>/dev/null; then
+    pg_ctlcluster 16 main start 2>/dev/null || true
+    sleep 2
+fi
+set -u
+
+
+export BUILDKITE=1
+export MYSQL_TEST_DB_HOST=127.0.0.1
+export MYSQL_TEST_BACKCOMPAT_DB_HOST=127.0.0.1
+export POSTGRES_TEST_DB_HOST=localhost
+
+case "${1:-}" in
+    base)
+        python3 -m pytest -vv \
+            python_modules/libraries/dagster-mysql/dagster_mysql_tests/compat_tests/test_back_compat.py \
+            python_modules/libraries/dagster-postgres/dagster_postgres_tests/compat_tests/test_back_compat.py \
+            -k 'not test_add_asset_event_tags_table'
+        ;;
+    new)
+        python3 -m pytest -vv \
+            python_modules/dagster/dagster_tests/core_tests/test_event_log_entry_accessors.py \
+            python_modules/libraries/dagster-mysql/dagster_mysql_tests/compat_tests/test_back_compat.py::test_add_asset_event_tags_table \
+            python_modules/libraries/dagster-postgres/dagster_postgres_tests/compat_tests/test_back_compat.py::test_add_asset_event_tags_table
+        ;;
+    *)
+        echo "usage: $0 base|new"
+        exit 2
+        ;;
+esac
