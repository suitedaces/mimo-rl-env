@@ -0,0 +1,100 @@
+from dagster import (
+    AssetKey,
+    AssetMaterialization,
+    AssetObservation,
+    DagsterEventType,
+    DagsterInstance,
+    EventRecordsFilter,
+    Output,
+    job,
+    op,
+)
+
+
+@op
+def emits_asset_events():
+    yield AssetMaterialization(
+        asset_key=AssetKey(["core", "mat"]),
+        tags={"dagster/core_mat": "yes", "dagster/shared": "materialization"},
+    )
+    yield AssetObservation(
+        asset_key=AssetKey(["core", "obs"]),
+        tags={"dagster/core_obs": "yes", "dagster/shared": "observation"},
+    )
+    yield Output(1)
+
+
+@job
+def asset_event_accessor_job():
+    emits_asset_events()
+
+
+def _single_event_log_entry(instance, event_type, asset_key):
+    records = instance.get_event_records(
+        EventRecordsFilter(event_type=event_type, asset_key=asset_key)
+    )
+    assert len(records) == 1
+    return records[0].event_log_entry
+
+
+def _step_success_entry(instance, run_id):
+    for entry in instance.all_logs(run_id):
+        if entry.dagster_event and entry.dagster_event.event_type == DagsterEventType.STEP_SUCCESS:
+            return entry
+
+    raise AssertionError("expected a step success event in the run logs")
+
+
+def test_event_log_entry_asset_observation_accessor():
+    instance = DagsterInstance.ephemeral()
+    result = asset_event_accessor_job.execute_in_process(instance=instance)
+    assert result.success
+
+    observation_entry = _single_event_log_entry(
+        instance,
+        DagsterEventType.ASSET_OBSERVATION,
+        AssetKey(["core", "obs"]),
+    )
+    observation = observation_entry.asset_observation
+    assert observation is not None
+    assert observation.asset_key == AssetKey(["core", "obs"])
+    assert observation.tags == {"dagster/core_obs": "yes", "dagster/shared": "observation"}
+
+    materialization_entry = _single_event_log_entry(
+        instance,
+        DagsterEventType.ASSET_MATERIALIZATION,
+        AssetKey(["core", "mat"]),
+    )
+    assert materialization_entry.asset_observation is None
+
+    step_entry = _step_success_entry(instance, result.run_id)
+    assert step_entry.asset_observation is None
+
+
+def test_event_log_entry_tags_accessor():
+    instance = DagsterInstance.ephemeral()
+    result = asset_event_accessor_job.execute_in_process(instance=instance)
+    assert result.success
+
+    materialization_entry = _single_event_log_entry(
+        instance,
+        DagsterEventType.ASSET_MATERIALIZATION,
+        AssetKey(["core", "mat"]),
+    )
+    assert materialization_entry.tags == {
+        "dagster/core_mat": "yes",
+        "dagster/shared": "materialization",
+    }
+
+    observation_entry = _single_event_log_entry(
+        instance,
+        DagsterEventType.ASSET_OBSERVATION,
+        AssetKey(["core", "obs"]),
+    )
+    assert observation_entry.tags == {
+        "dagster/core_obs": "yes",
+        "dagster/shared": "observation",
+    }
+
+    step_entry = _step_success_entry(instance, result.run_id)
+    assert step_entry.tags is None
