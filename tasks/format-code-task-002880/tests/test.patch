+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+go test ./pkg/config/ -count=1 -run '^(TestConfig_|TestStructKeys|TestStrings|TestValidateMissingRequired|TestMapLoggingFields)'
+
+
+go test ./pkg/config/ -count=1 -run '^TestGetLDAPConfiguration'
