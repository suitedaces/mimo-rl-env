@@ -0,0 +1,93 @@
+package config_test
+
+import (
+	"testing"
+
+	"github.com/spf13/viper"
+	"github.com/treeverse/lakefs/pkg/config"
+)
+
+
+
+func loadConfig(t *testing.T, fn string) *config.Config {
+	t.Helper()
+	viper.Reset()
+	viper.SetConfigFile(fn)
+	if err := viper.ReadInConfig(); err != nil {
+		t.Fatalf("read config %s: %s", fn, err)
+	}
+	c, err := config.NewConfig()
+	if err != nil {
+		t.Fatalf("new config from %s: %s", fn, err)
+	}
+	return c
+}
+
+func TestGetLDAPConfiguration_Disabled(t *testing.T) {
+	c := loadConfig(t, "testdata/valid_config.yaml")
+	if ldap := c.GetLDAPConfiguration(); ldap != nil {
+		t.Fatalf("expected nil LDAP configuration when no auth.ldap section is present, got %+v", ldap)
+	}
+}
+
+func TestGetLDAPConfiguration_Full(t *testing.T) {
+	c := loadConfig(t, "testdata/ldap_config.yaml")
+	ldap := c.GetLDAPConfiguration()
+	if ldap == nil {
+		t.Fatal("expected a non-nil LDAP configuration when auth.ldap is present")
+	}
+
+	checks := []struct {
+		name string
+		got  string
+		want string
+	}{
+		{"ServerEndpoint", ldap.ServerEndpoint, "ldaps://ldap.example.com:636"},
+		{"BindDN", ldap.BindDN, "uid=lakefs,ou=Users,dc=example,dc=com"},
+		{"BindPassword", ldap.BindPassword, "secret-bind-pw"},
+		{"UserBaseDN", ldap.UserBaseDN, "ou=Users,dc=example,dc=com"},
+		{"UsernameAttribute", ldap.UsernameAttribute, "uid"},
+		{"UserFilter", ldap.UserFilter, "(objectClass=person)"},
+		{"DefaultUserGroup", ldap.DefaultUserGroup, "Developers"},
+	}
+	for _, ch := range checks {
+		if ch.got != ch.want {
+			t.Errorf("LDAP.%s = %q, want %q", ch.name, ch.got, ch.want)
+		}
+	}
+}
+
+func TestGetLDAPConfiguration_DefaultsAndOptionalFields(t *testing.T) {
+	c := loadConfig(t, "testdata/ldap_config_minimal.yaml")
+	ldap := c.GetLDAPConfiguration()
+	if ldap == nil {
+		t.Fatal("expected a non-nil LDAP configuration when auth.ldap is present")
+	}
+
+
+	if ldap.ServerEndpoint != "ldap://ldap.internal:389" {
+		t.Errorf("LDAP.ServerEndpoint = %q, want %q", ldap.ServerEndpoint, "ldap://ldap.internal:389")
+	}
+	if ldap.BindDN != "cn=admin,dc=corp,dc=local" {
+		t.Errorf("LDAP.BindDN = %q, want %q", ldap.BindDN, "cn=admin,dc=corp,dc=local")
+	}
+	if ldap.UsernameAttribute != "cn" {
+		t.Errorf("LDAP.UsernameAttribute = %q, want %q", ldap.UsernameAttribute, "cn")
+	}
+	if ldap.UserBaseDN != "dc=corp,dc=local" {
+		t.Errorf("LDAP.UserBaseDN = %q, want %q", ldap.UserBaseDN, "dc=corp,dc=local")
+	}
+
+
+	if ldap.BindPassword != "" {
+		t.Errorf("LDAP.BindPassword = %q, want empty", ldap.BindPassword)
+	}
+	if ldap.UserFilter != "" {
+		t.Errorf("LDAP.UserFilter = %q, want empty", ldap.UserFilter)
+	}
+
+
+	if ldap.DefaultUserGroup != "Viewers" {
+		t.Errorf("LDAP.DefaultUserGroup = %q, want %q", ldap.DefaultUserGroup, "Viewers")
+	}
+}
