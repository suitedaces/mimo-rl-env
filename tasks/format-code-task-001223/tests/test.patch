+package usercase_test_coderl
+
+import (
+	"strings"
+	"testing"
+
+	solana "github.com/gagliardetto/solana-go"
+)
+
+const (
+	keyAPrivate = "3mvu4j9U5YzdbDt6jPFr7R6kiKGSWf6n4rkmAXdHtZVjg6ZNtxXm5mDS8He5Bd9kh7P6ucUUssaSMcTjyaVBsYHC"
+	keyBPrivate = "4BDcvADQfAeB852oTf2wabWMQkMTcE73ipCf2R789DkWZyZVWdq7e2gow88o9VtZwKBEiqj3xHr5dJqV4pnFCNyR"
+	keyCPrivate = "1sFYjxwUMUDE4WkcnMgc3B26W54foTG9KJYETbLURkwYJjKsV54GHcHadphvkNM8hkEJoE4mCT1dgrW9KgiT6j6"
+	keyDPrivate = "4kx6RRBYoPKMrT2MNcbuGEJv6omBMzaZcArPj7dPaoc55hWmgbdVqpWqPe3ZQQKJDFywXKwsAfVYYM3a8R5ZZmTX"
+
+	keyAPublic = "EN4jTLBcdEJZk6ekyrbrFUmhhWPYyRy8UYkWbgXnjyLi"
+	keyBPublic = "Ehnu2PrwSXcENoWq555ujDksE8JCZmcySk3FJusmUyAK"
+	keyCPublic = "J7TSBXQxhJu293hMeJ43rCW27CUKYMJeS1mA95g3uXbr"
+
+	zeroSignature = "1111111111111111111111111111111111111111111111111111111111111111"
+
+	partialBSignature = "4fb89QJrZ2FXzRV6vpz1kGdmbx5hGnVqfLE6aZkqoRxTjHUviMS4wpjm65HSXdnBJaYUuB3zHhgrFnuz7CY5uqu4"
+	partialASignature = "3Fzr6N8BGpYEZz2mreSYJHDGKu7obDmY9kPP4MTuRXYAnsbwj9TSpvvz3NAMARhBQFonpnqiCcAvZjRMGia7BqqM"
+	partialCSignature = "3CyRABFEpqiUUXF8jfpiGgnUXQtc5T5TVDXfQU3oye4SJoBJrV6GR86DpR9Lv7DHN3ZL6WScmPGkfZLY1MjtQ8ux"
+
+	fullASignature = "3urqnQYZpsDju64zqJYPsyWCEnANPppWEYBQiwxh7cQKJiTGgUAg8BoBxacFnabUr5WMkvMy87psJuna31SoPiFi"
+	fullBSignature = "3A26Qs5zhgMuUMFAsDoyXvGGsPvbZDjH7HnocyqCTj3MHj2BrM2BgYJBKAGeXrUpBFSxbGmaHuBguMptCkvHEtR7"
+)
+
+func fixedKeys(t *testing.T) []solana.PrivateKey {
+	t.Helper()
+
+	return []solana.PrivateKey{
+		solana.MustPrivateKeyFromBase58(keyAPrivate),
+		solana.MustPrivateKeyFromBase58(keyBPrivate),
+		solana.MustPrivateKeyFromBase58(keyCPrivate),
+		solana.MustPrivateKeyFromBase58(keyDPrivate),
+	}
+}
+
+func newSigningTransaction(t *testing.T, keys []solana.PrivateKey) *solana.Transaction {
+	t.Helper()
+
+	accounts := []*solana.AccountMeta{
+		{PublicKey: keys[0].PublicKey(), IsSigner: true, IsWritable: true},
+	}
+	for i := 1; i < len(keys); i++ {
+		accounts = append(accounts, &solana.AccountMeta{
+			PublicKey:  keys[i].PublicKey(),
+			IsSigner:   true,
+			IsWritable: false,
+		})
+	}
+
+	tx, err := solana.NewTransaction(
+		[]solana.Instruction{
+			solana.NewInstruction(solana.SystemProgramID, accounts, []byte{0xaa, 0xbb, 0x03}),
+		},
+		solana.MustHashFromBase58("A9QnpgfhCkmiBSjgBuWk76Wo3HxzxvDopUq9x6UUMmjn"),
+		solana.TransactionPayer(keys[0].PublicKey()),
+	)
+	if err != nil {
+		t.Fatalf("NewTransaction() error = %v", err)
+	}
+
+	return tx
+}
+
+func requireSignatureStrings(t *testing.T, got []solana.Signature, want []string) {
+	t.Helper()
+
+	if len(got) != len(want) {
+		t.Fatalf("len(signatures) = %d, want %d", len(got), len(want))
+	}
+	for i := range want {
+		if got[i].String() != want[i] {
+			t.Fatalf("signature[%d] = %q, want %q", i, got[i].String(), want[i])
+		}
+	}
+}
+
+func TestPartialSignFillsRequiredSignerSlotsAcrossRepeatedCalls(t *testing.T) {
+
+
+	keys := fixedKeys(t)
+	tx := newSigningTransaction(t, keys[:3])
+
+	if len(tx.Signatures) != 0 {
+		t.Fatalf("initial len(tx.Signatures) = %d, want 0", len(tx.Signatures))
+	}
+	signers := tx.Message.Signers()
+	if len(signers) != 3 {
+		t.Fatalf("len(signers) = %d, want 3", len(signers))
+	}
+	if signers[0].String() != keyAPublic || signers[1].String() != keyBPublic || signers[2].String() != keyCPublic {
+		t.Fatalf("signers = [%s %s %s], want [%s %s %s]", signers[0], signers[1], signers[2], keyAPublic, keyBPublic, keyCPublic)
+	}
+
+	sigs, err := tx.PartialSign(func(key solana.PublicKey) *solana.PrivateKey {
+		if key.Equals(keys[1].PublicKey()) {
+			return &keys[1]
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("PartialSign(B) error = %v, want nil", err)
+	}
+
+	if len(sigs) != len(tx.Signatures) {
+		t.Fatalf("len(PartialSign(B) result) = %d, len(tx.Signatures) = %d", len(sigs), len(tx.Signatures))
+	}
+	requireSignatureStrings(t, sigs, []string{zeroSignature, partialBSignature, zeroSignature})
+	requireSignatureStrings(t, tx.Signatures, []string{zeroSignature, partialBSignature, zeroSignature})
+
+	sigs, err = tx.PartialSign(func(key solana.PublicKey) *solana.PrivateKey {
+		if key.Equals(keys[0].PublicKey()) {
+			return &keys[0]
+		}
+		if key.Equals(keys[2].PublicKey()) {
+			return &keys[2]
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("PartialSign(A,C) error = %v, want nil", err)
+	}
+
+	if len(sigs) != len(tx.Signatures) {
+		t.Fatalf("len(PartialSign(A,C) result) = %d, len(tx.Signatures) = %d", len(sigs), len(tx.Signatures))
+	}
+	requireSignatureStrings(t, sigs, []string{partialASignature, partialBSignature, partialCSignature})
+	requireSignatureStrings(t, tx.Signatures, []string{partialASignature, partialBSignature, partialCSignature})
+
+	if err := tx.VerifySignatures(); err != nil {
+		t.Fatalf("VerifySignatures() after full partial signing error = %v, want nil", err)
+	}
+}
+
+func TestPartialSignRejectsExistingSignatureLengthMismatch(t *testing.T) {
+
+
+	keys := fixedKeys(t)
+	tx := newSigningTransaction(t, keys[:3])
+	tx.Signatures = []solana.Signature{{1}}
+	originalSignature := tx.Signatures[0]
+
+	sigs, err := tx.PartialSign(func(key solana.PublicKey) *solana.PrivateKey {
+		return &keys[0]
+	})
+	if sigs != nil {
+		t.Fatalf("PartialSign() returned %d signatures, want nil", len(sigs))
+	}
+	if err == nil {
+		t.Fatalf("PartialSign() error = nil, want exact mismatch error")
+	}
+
+	if !strings.Contains(err.Error(), "3") || !strings.Contains(err.Error(), "1") {
+		t.Fatalf("PartialSign() error = %q, want message mentioning expected 3 and actual 1", err.Error())
+	}
+	if len(tx.Signatures) != 1 {
+		t.Fatalf("len(tx.Signatures) after error = %d, want 1", len(tx.Signatures))
+	}
+
+	if tx.Signatures[0] != originalSignature {
+		t.Fatalf("tx.Signatures[0] after error changed from original value")
+	}
+}
+
+func TestSignRequiresEverySignerBeforeWritingSignatures(t *testing.T) {
+
+
+	keys := fixedKeys(t)
+	tx := newSigningTransaction(t, keys[:2])
+
+	sigs, err := tx.Sign(func(key solana.PublicKey) *solana.PrivateKey {
+		if key.Equals(keys[0].PublicKey()) {
+			return &keys[0]
+		}
+		return nil
+	})
+	if sigs != nil {
+		t.Fatalf("Sign(A only) returned %d signatures, want nil", len(sigs))
+	}
+	if err == nil {
+		t.Fatalf("Sign(A only) error = nil, want missing B error")
+	}
+
+	if !strings.Contains(err.Error(), keyBPublic) {
+		t.Fatalf("Sign(A only) error = %q, want message mentioning missing signer %s", err.Error(), keyBPublic)
+	}
+	if len(tx.Signatures) != 0 {
+		t.Fatalf("len(tx.Signatures) after failed Sign = %d, want 0", len(tx.Signatures))
+	}
+}
+
+func TestSignWithAllKeysReturnsAndStoresSignerOrderedSlice(t *testing.T) {
+
+
+	keys := fixedKeys(t)
+	tx := newSigningTransaction(t, keys[:2])
+
+	sigs, err := tx.Sign(func(key solana.PublicKey) *solana.PrivateKey {
+		if key.Equals(keys[0].PublicKey()) {
+			return &keys[0]
+		}
+		if key.Equals(keys[1].PublicKey()) {
+			return &keys[1]
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("Sign(A,B) error = %v, want nil", err)
+	}
+	if &sigs[0] != &tx.Signatures[0] {
+		t.Fatalf("Sign(A,B) did not return tx.Signatures backing slice")
+	}
+	requireSignatureStrings(t, sigs, []string{fullASignature, fullBSignature})
+	requireSignatureStrings(t, tx.Signatures, []string{fullASignature, fullBSignature})
+	if err := tx.VerifySignatures(); err != nil {
+		t.Fatalf("VerifySignatures() after Sign error = %v, want nil", err)
+	}
+}
+
+func TestVerifySignaturesRejectsSignatureCountMismatch(t *testing.T) {
+
+
+	keys := fixedKeys(t)
+	tx := newSigningTransaction(t, keys[:2])
+	tx.Signatures = []solana.Signature{{2}}
+
+	err := tx.VerifySignatures()
+	if err == nil {
+		t.Fatalf("VerifySignatures() error = nil, want signature count mismatch")
+	}
+
+	if !strings.Contains(err.Error(), "2") || !strings.Contains(err.Error(), "1") {
+		t.Fatalf("VerifySignatures() error = %q, want message mentioning 2 signers and 1 signature", err.Error())
+	}
+}
+
+func TestVerifySignaturesRejectsSignatureFromWrongSigner(t *testing.T) {
+
+
+	keys := fixedKeys(t)
+	tx := newSigningTransaction(t, keys[:2])
+	msg, err := tx.Message.MarshalBinary()
+	if err != nil {
+		t.Fatalf("Message.MarshalBinary() error = %v", err)
+	}
+	wrongForA, err := keys[1].Sign(msg)
+	if err != nil {
+		t.Fatalf("keys[1].Sign() for slot 0 error = %v", err)
+	}
+	correctForB, err := keys[1].Sign(msg)
+	if err != nil {
+		t.Fatalf("keys[1].Sign() for slot 1 error = %v", err)
+	}
+	tx.Signatures = []solana.Signature{wrongForA, correctForB}
+
+	err = tx.VerifySignatures()
+	if err == nil {
+		t.Fatalf("VerifySignatures() error = nil, want invalid signer error")
+	}
+
+	if !strings.Contains(err.Error(), keyAPublic) {
+		t.Fatalf("VerifySignatures() error = %q, want message identifying signer %s", err.Error(), keyAPublic)
+	}
+}
+
+func TestPartialSignStateIsIndependentAcrossTransactions(t *testing.T) {
+
+
+	keys := fixedKeys(t)
+	a := newSigningTransaction(t, keys[:2])
+	b := newSigningTransaction(t, []solana.PrivateKey{keys[2], keys[3]})
+
+	_, err := a.PartialSign(func(key solana.PublicKey) *solana.PrivateKey {
+		if key.Equals(keys[1].PublicKey()) {
+			return &keys[1]
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("a.PartialSign(B) error = %v, want nil", err)
+	}
+
+	requireSignatureStrings(t, a.Signatures, []string{zeroSignature, fullBSignature})
+	if len(b.Signatures) != 0 {
+		t.Fatalf("len(b.Signatures) = %d, want 0", len(b.Signatures))
+	}
+	if len(b.Message.Signers()) != 2 {
+		t.Fatalf("len(b.Message.Signers()) = %d, want 2", len(b.Message.Signers()))
+	}
+}
+
+func TestTransactionSigningCyclesDoNotLeakFDsOrGoroutines(t *testing.T) {
+
+
+	keys := fixedKeys(t)
+	completed := 0
+
+	for i := 0; i < 150; i++ {
+		tx := newSigningTransaction(t, keys[:2])
+		_, err := tx.Sign(func(key solana.PublicKey) *solana.PrivateKey {
+			if key.Equals(keys[0].PublicKey()) {
+				return &keys[0]
+			}
+			if key.Equals(keys[1].PublicKey()) {
+				return &keys[1]
+			}
+			return nil
+		})
+		if err != nil {
+			t.Fatalf("cycle %d Sign() error = %v, want nil", i, err)
+		}
+		if err := tx.VerifySignatures(); err != nil {
+			t.Fatalf("cycle %d VerifySignatures() error = %v, want nil", i, err)
+		}
+		completed++
+	}
+
+
+	if completed != 150 {
+		t.Fatalf("completed signing cycles = %d, want 150", completed)
+	}
+}
