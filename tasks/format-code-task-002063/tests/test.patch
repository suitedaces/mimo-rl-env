diff --git a/src/test/unit_tests/test_namespace_merge_versions_contract.js b/src/test/unit_tests/test_namespace_merge_versions_contract.js
new file mode 100644
index 000000000..5326353e1
--- /dev/null
+++ b/src/test/unit_tests/test_namespace_merge_versions_contract.js
@@ -0,0 +1,148 @@
+
+'use strict';
+
+const assert = require('assert');
+const mocha = require('mocha');
+const NamespaceMerge = require('../../sdk/namespace_merge');
+
+function makeNamespace(versionReply, objectReply) {
+    return {
+        list_object_versions: async () => versionReply,
+        list_objects: async () => objectReply || versionReply,
+        list_uploads: async () => objectReply || versionReply,
+    };
+}
+
+function makeVersion(key, version_id, create_time, extra) {
+    return Object.assign({
+        key,
+        version_id,
+        create_time,
+        is_latest: false,
+        delete_marker: false,
+    }, extra);
+}
+
+mocha.describe('namespace merge version listing', function() {
+
+    mocha.it('retains versions, deduplicates exact identities, and orders each key newest first', async function() {
+        const first = makeNamespace({
+            objects: [
+                makeVersion('a', 'v1', 10),
+                makeVersion('a', 'v2', 30),
+                makeVersion('b', 'v1', 20),
+            ],
+            common_prefixes: ['dir/'],
+            is_truncated: false,
+        });
+        const second = makeNamespace({
+            objects: [
+                makeVersion('a', 'v1', 40),
+                makeVersion('a', 'v3', 20, { delete_marker: true }),
+                makeVersion('b', 'v2', 25),
+            ],
+            common_prefixes: ['dir/', 'other/'],
+            is_truncated: false,
+        });
+
+        const merge = new NamespaceMerge({
+            namespaces: { read_resources: [first, second] },
+        });
+        const reply = await merge.list_object_versions({ limit: 100 }, {});
+
+        assert.deepStrictEqual(reply.objects.map(obj => `${obj.key}:${obj.version_id}:${obj.delete_marker}`), [
+            'a:v1:false',
+            'a:v2:false',
+            'a:v3:true',
+            'b:v2:false',
+            'b:v1:false',
+        ]);
+        assert.strictEqual(reply.objects.find(obj => obj.key === 'a' && obj.version_id === 'v1').create_time, 40);
+        assert.deepStrictEqual(reply.common_prefixes, ['dir/', 'other/']);
+        assert.strictEqual(reply.is_truncated, false);
+        assert.strictEqual(reply.next_marker, undefined);
+        assert.strictEqual(reply.next_version_id_marker, undefined);
+    });
+
+    mocha.it('applies the limit across objects and prefixes and emits version pagination markers', async function() {
+        const ns = makeNamespace({
+            objects: [
+                makeVersion('a', 'new', 30),
+                makeVersion('a', 'old', 10),
+                makeVersion('b', 'only', 20),
+            ],
+            common_prefixes: ['c/'],
+            is_truncated: false,
+        });
+        const merge = new NamespaceMerge({
+            namespaces: { read_resources: [ns] },
+        });
+        const reply = await merge.list_object_versions({ limit: 2 }, {});
+
+        assert.deepStrictEqual(reply.objects.map(obj => obj.version_id), ['new', 'old']);
+        assert.deepStrictEqual(reply.common_prefixes, []);
+        assert.strictEqual(reply.is_truncated, true);
+        assert.strictEqual(reply.next_marker, 'a');
+        assert.strictEqual(reply.next_version_id_marker, 'old');
+    });
+
+    mocha.it('preserves upstream truncation and emits markers even when the merged page is under the limit', async function() {
+        const ns = makeNamespace({
+            objects: [makeVersion('a', 'v1', 10)],
+            common_prefixes: [],
+            is_truncated: true,
+        });
+        const merge = new NamespaceMerge({
+            namespaces: { read_resources: [ns] },
+        });
+        const reply = await merge.list_object_versions({ limit: 100 }, {});
+
+        assert.strictEqual(reply.is_truncated, true);
+        assert.strictEqual(reply.next_marker, 'a');
+        assert.strictEqual(reply.next_version_id_marker, 'v1');
+    });
+
+    mocha.it('returns an empty, non-truncated page for a zero limit', async function() {
+        const ns = makeNamespace({
+            objects: [makeVersion('a', 'v1', 10)],
+            common_prefixes: ['dir/'],
+            is_truncated: true,
+        });
+        const merge = new NamespaceMerge({
+            namespaces: { read_resources: [ns] },
+        });
+        const reply = await merge.list_object_versions({ limit: 0 }, {});
+
+        assert.deepStrictEqual(reply.objects, []);
+        assert.deepStrictEqual(reply.common_prefixes, []);
+        assert.strictEqual(reply.is_truncated, false);
+        assert.strictEqual(reply.next_marker, undefined);
+        assert.strictEqual(reply.next_version_id_marker, undefined);
+    });
+
+    mocha.it('keeps ordinary list_objects newest-per-key behavior', async function() {
+        const first = makeNamespace({
+            objects: [makeVersion('a', 'v1', 10)],
+            common_prefixes: [],
+            is_truncated: false,
+        }, {
+            objects: [makeVersion('a', 'v2', 20)],
+            common_prefixes: [],
+            is_truncated: false,
+        });
+        const second = makeNamespace({
+            objects: [makeVersion('b', 'v1', 5)],
+            common_prefixes: [],
+            is_truncated: false,
+        });
+        const merge = new NamespaceMerge({
+            namespaces: { read_resources: [first, second] },
+        });
+        const reply = await merge.list_objects({ limit: 100 }, {});
+
+        assert.deepStrictEqual(reply.objects.map(obj => `${obj.key}:${obj.version_id}`), ['a:v2', 'b:v1']);
+
+        const uploads = await merge.list_uploads({ limit: 100 }, {});
+        assert.deepStrictEqual(uploads.objects.map(obj => `${obj.key}:${obj.version_id}`), ['a:v2', 'b:v1']);
+    });
+});
