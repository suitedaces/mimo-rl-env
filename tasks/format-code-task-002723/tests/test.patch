diff --git a/test/rules/std_LT02_jinja_test.py b/test/rules/std_LT02_jinja_test.py
new file mode 100644
index 000000000..70335dd63
--- /dev/null
+++ b/test/rules/std_LT02_jinja_test.py
@@ -0,0 +1,109 @@
+
+
+
+
+
+
+
+
+
+
+
+import sqlfluff
+
+
+
+JINJA_NESTED_LOOPS_SQL = (
+    "-- sqlfluff:templater:jinja:context:tables:"
+    "['tbl_a','tbl_b','tbl_c']\n"
+    "-- sqlfluff:templater:jinja:context:each_table_cols:"
+    "[['aa', 'ab', 'ac'],['ba','bb','bc'],['ca','cb','cc']]\n"
+    "-- sqlfluff:indentation:template_blocks_indent:false\n"
+    "\n"
+    "CREATE OR REPLACE TRANSIENT TABLE TEST AS\n"
+    "WITH abc AS (\n"
+    "    SELECT\n"
+    "        spine.some_id AS some_id\n"
+    "        {% for cols in each_table_cols -%}\n"
+    "        {%- set src_loop = loop -%}\n"
+    "        {%- for c in cols -%}\n"
+    "        , t{{ src_loop.index }}.\"{{ c }}\"\n"
+    "        {% endfor %}\n"
+    "        {%- endfor %}\n"
+    "    FROM tbl AS spine\n"
+    "    {% for t in tables %}\n"
+    "    LEFT JOIN {{ t }} AS t{{ loop.index }}\n"
+    "    ON spine.some_id = t{{ loop.index }}.some_id\n"
+    "    {% endfor %}\n"
+    ")\n"
+    "\n"
+    "SELECT * FROM abc;\n"
+)
+
+
+def _lt02_violations(sql):
+
+    return sqlfluff.lint(sql, dialect="ansi", rules=["LT02"])
+
+
+def test__rules__std_LT02_jinja_nested_loops_no_crash():
+
+
+
+
+
+
+    result = _lt02_violations(JINJA_NESTED_LOOPS_SQL)
+
+
+    for violation in result:
+        assert "Unexpected exception" not in violation["description"], (
+            "LT02 raised an unexpected exception: " + violation["description"]
+        )
+        assert "max() arg is an empty sequence" not in violation["description"], (
+            "LT02 still hits the empty-overlap bug: " + violation["description"]
+        )
+
+
+def test__rules__std_LT02_jinja_nested_loops_violations_exact():
+
+
+
+
+
+
+
+
+    result = _lt02_violations(JINJA_NESTED_LOOPS_SQL)
+
+
+    for violation in result:
+        assert violation["code"] == "LT02"
+
+
+    locations = sorted(
+        (v["start_line_no"], v["start_line_pos"]) for v in result
+    )
+
+
+    assert locations == [(18, 1)], (
+        "Expected exactly one LT02 violation at L:18 P:1, "
+        f"got {locations!r}"
+    )
+
+
+def test__rules__std_LT02_jinja_nested_loops_fix_is_stable():
+
+
+
+    fixed_once = sqlfluff.fix(
+        JINJA_NESTED_LOOPS_SQL, dialect="ansi", rules=["LT02"]
+    )
+    assert isinstance(fixed_once, str)
+
+
+    assert "CREATE OR REPLACE TRANSIENT TABLE TEST AS" in fixed_once
+
+
+    fixed_twice = sqlfluff.fix(fixed_once, dialect="ansi", rules=["LT02"])
+    assert fixed_once == fixed_twice
