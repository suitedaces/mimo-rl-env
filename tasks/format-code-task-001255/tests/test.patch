+func TestSetBodyBytesReplacesResponseBodyWithReadableBytes(t *testing.T) {
+
+
+	input := &openapi3filter.ResponseValidationInput{}
+
+	returned := input.SetBodyBytes([]byte("replacement"))
+
+	if returned != input {
+		t.Fatalf("SetBodyBytes returned %p, want %p", returned, input)
+	}
+	body := mustReadAll(t, input.Body)
+	if body != "replacement" {
+		t.Fatalf("body after SetBodyBytes = %q, want %q", body, "replacement")
+	}
+}
