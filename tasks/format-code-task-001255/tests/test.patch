+type responseCase struct {
+	method    string
+	status    int
+	content   string
+	body      string
+	trace     string
+	responses *openapi3.Responses
+	options   *openapi3filter.Options
+}
+
+func newResponseInput(t *testing.T, tc responseCase) *openapi3filter.ResponseValidationInput {
+	t.Helper()
+	doc := &openapi3.T{
+		OpenAPI: "3.0.3",
+		Info:    &openapi3.Info{Title: "acceptance", Version: "1.0.0"},
+		Paths:   openapi3.NewPaths(openapi3.WithPath("/items", &openapi3.PathItem{})),
+	}
+	pathItem := doc.Paths.Value("/items")
+	pathItem.SetOperation(tc.method, &openapi3.Operation{Responses: tc.responses})
+
+	router, err := legacy.NewRouter(doc)
+	if err != nil {
+		t.Fatalf("legacy.NewRouter error = %v", err)
+	}
+	req := httptest.NewRequest(tc.method, "http://example.test/items", nil)
+	route, pathParams, err := router.FindRoute(req)
+	if err != nil {
+		t.Fatalf("FindRoute error = %v", err)
+	}
+
+	header := http.Header{}
+	if tc.content != "" {
+		header.Set("Content-Type", tc.content)
+	}
+	if tc.trace != "" {
+		header.Set("X-Trace", tc.trace)
+	}
+	return &openapi3filter.ResponseValidationInput{
+		RequestValidationInput: &openapi3filter.RequestValidationInput{
+			Request:    req,
+			PathParams: pathParams,
+			Route:      route,
+		},
+		Status:  tc.status,
+		Header:  header,
+		Body:    io.NopCloser(strings.NewReader(tc.body)),
+		Options: tc.options,
+	}
+}
+
+func responsesWithRequiredID() *openapi3.Responses {
+	return openapi3.NewResponses(openapi3.WithStatus(http.StatusOK, &openapi3.ResponseRef{
+		Value: openapi3.NewResponse().WithDescription("ok").WithJSONSchema(requiredIDSchema()),
+	}))
+}
+
+func responsesWithTraceHeader() *openapi3.Responses {
+	response := openapi3.NewResponse().WithDescription("ok").WithJSONSchema(requiredIDSchema())
+	response.Headers = openapi3.Headers{
+		"X-Trace": {
+			Value: &openapi3.Header{
+				Parameter: openapi3.Parameter{
+					Required: true,
+					Schema:   openapi3.NewSchemaRef("", openapi3.NewStringSchema().WithMinLength(3)),
+				},
+			},
+		},
+	}
+	return openapi3.NewResponses(openapi3.WithStatus(http.StatusOK, &openapi3.ResponseRef{Value: response}))
+}
+
+func defaultOnlyResponses() *openapi3.Responses {
+	schema := openapi3.NewObjectSchema().
+		WithProperty("fallback", openapi3.NewStringSchema()).
+		WithRequired([]string{"fallback"})
+	return openapi3.NewResponses(openapi3.WithName("default", openapi3.NewResponse().WithDescription("fallback").WithJSONSchema(schema)))
+}
+
+func responsesWithWriteOnlySecret() *openapi3.Responses {
+	secret := openapi3.NewStringSchema()
+	secret.WriteOnly = true
+	schema := openapi3.NewObjectSchema().
+		WithProperty("id", openapi3.NewIntegerSchema()).
+		WithProperty("secret", secret).
+		WithRequired([]string{"id"})
+	return openapi3.NewResponses(openapi3.WithStatus(http.StatusOK, &openapi3.ResponseRef{
+		Value: openapi3.NewResponse().WithDescription("ok").WithJSONSchema(schema),
+	}))
+}
+
+func requiredIDSchema() *openapi3.Schema {
+	return openapi3.NewObjectSchema().
+		WithProperty("id", openapi3.NewIntegerSchema()).
+		WithRequired([]string{"id"})
+}
+
+func assertResponseError(t *testing.T, err error, want string, wantUnwrap bool) {
+	t.Helper()
+	var responseErr *openapi3filter.ResponseError
+	if !errors.As(err, &responseErr) {
+		t.Fatalf("error type = %T, want *openapi3filter.ResponseError", err)
+	}
+	if got := err.Error(); got != want {
+		t.Fatalf("error message = %q, want %q", got, want)
+	}
+	if got := errors.Unwrap(err) != nil; got != wantUnwrap {
+		t.Fatalf("errors.Unwrap(err) present = %v, want %v", got, wantUnwrap)
+	}
+}
+
+func assertResponseErrorPrefix(t *testing.T, err error, wantPrefix string, wantUnwrap bool) {
+	t.Helper()
+	var responseErr *openapi3filter.ResponseError
+	if !errors.As(err, &responseErr) {
+		t.Fatalf("error type = %T, want *openapi3filter.ResponseError", err)
+	}
+	if got := err.Error(); !strings.HasPrefix(got, wantPrefix) {
+		t.Fatalf("error message = %q, want prefix %q", got, wantPrefix)
+	}
+	if got := errors.Unwrap(err) != nil; got != wantUnwrap {
+		t.Fatalf("errors.Unwrap(err) present = %v, want %v", got, wantUnwrap)
+	}
+}
+
+func assertResponseErrorContains(t *testing.T, err error, wantUnwrap bool, fragments ...string) {
+	t.Helper()
+	var responseErr *openapi3filter.ResponseError
+	if !errors.As(err, &responseErr) {
+		t.Fatalf("error type = %T, want *openapi3filter.ResponseError", err)
+	}
+	got := strings.ToLower(err.Error())
+	for _, fragment := range fragments {
+		if !strings.Contains(got, strings.ToLower(fragment)) {
+			t.Fatalf("error message = %q, want fragment %q", err.Error(), fragment)
+		}
+	}
+	if gotUnwrap := errors.Unwrap(err) != nil; gotUnwrap != wantUnwrap {
+		t.Fatalf("errors.Unwrap(err) present = %v, want %v", gotUnwrap, wantUnwrap)
+	}
+}
+
+func mustReadAll(t *testing.T, rc io.ReadCloser) string {
+	t.Helper()
+	if rc == nil {
+		t.Fatal("body is nil")
+	}
+	data, err := io.ReadAll(rc)
+	if err != nil {
+		t.Fatalf("ReadAll error = %v", err)
+	}
+	return string(data)
+}
