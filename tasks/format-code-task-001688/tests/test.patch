+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+pip install --break-system-packages -e . --no-deps 2>&1 | tail -3
+
+
+case "${1:-}" in
+  base)
+    KERAS_BACKEND=numpy python3 -m pytest \
+      keras/src/layers/normalization/layer_normalization_test.py::LayerNormalizationTest::test_output_with_rms_scaling \
+      -q
+    ;;
+  new)
+    KERAS_BACKEND=numpy python3 -m pytest \
+      keras/rms_normalization_public_api_test.py \
+      -q
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
