diff --git a/pandas/tests/io/parser/test_common.py b/pandas/tests/io/parser/test_common.py
index e38fcf1380..978984de26 100644
--- a/pandas/tests/io/parser/test_common.py
+++ b/pandas/tests/io/parser/test_common.py
@@ -2135,3 +2135,63 @@ def test_no_header_two_extra_columns(all_parsers):
     parser = all_parsers
     df = parser.read_csv(stream, header=None, names=column_names, index_col=False)
     tm.assert_frame_equal(df, ref)
+
+
+def test_read_csv_names_set_raises(all_parsers):
+
+    parser = all_parsers
+    data = "1,TRUE\n2,FALSE\n3,TRUE\n"
+    with pytest.raises((ValueError, TypeError), match="Names should be an ordered collection"):
+        parser.read_csv(StringIO(data), names={"pVal1", "pClass"})
+
+
+def test_read_csv_names_set_with_dtype_raises(all_parsers):
+
+    parser = all_parsers
+    data = "1,TRUE\n2,FALSE\n3,TRUE\n"
+    with pytest.raises((ValueError, TypeError), match="Names should be an ordered collection"):
+        parser.read_csv(
+            StringIO(data),
+            names={"pVal1", "pClass"},
+            dtype={"pVal1": int, "pClass": bool},
+        )
+
+
+def test_read_csv_names_frozenset_raises(all_parsers):
+
+    parser = all_parsers
+    data = "1,TRUE\n2,FALSE\n3,TRUE\n"
+    with pytest.raises((ValueError, TypeError), match="Names should be an ordered collection"):
+        parser.read_csv(StringIO(data), names=frozenset({"pVal1", "pClass"}))
+
+
+def test_read_csv_names_list_with_dtype(all_parsers):
+
+    parser = all_parsers
+    data = "1,TRUE\n2,FALSE\n3,TRUE\n"
+    result = parser.read_csv(
+        StringIO(data),
+        names=["pVal1", "pClass"],
+        dtype={"pVal1": int, "pClass": bool},
+    )
+    expected = DataFrame(
+        {"pVal1": [1, 2, 3], "pClass": [True, False, True]},
+    )
+    tm.assert_frame_equal(result, expected)
+
+
+def test_read_csv_names_tuple(all_parsers):
+
+    parser = all_parsers
+    data = "1,2\n3,4\n"
+    result = parser.read_csv(StringIO(data), names=("a", "b"))
+    expected = DataFrame({"a": [1, 3], "b": [2, 4]})
+    tm.assert_frame_equal(result, expected)
+
+
+def test_read_csv_duplicate_names_still_raises(all_parsers):
+
+    parser = all_parsers
+    data = "1,2,3\n4,5,6\n"
+    with pytest.raises(ValueError, match="Duplicate names are not allowed"):
+        parser.read_csv(StringIO(data), names=["a", "b", "a"])
