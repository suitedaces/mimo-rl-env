diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,138 @@
+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+
+
+
+write_base_probe() {
+    cat > /tmp/realm_fixturea_base_probe.swift <<'SWIFT'
+import Foundation
+
+public class RLMObjectBase: NSObject {
+    public override init() { super.init() }
+}
+
+public class Object: RLMObjectBase {
+    public required override init() {
+        super.init()
+    }
+}
+
+final class ProbeObject: Object {
+    var value = 42
+}
+
+func createObject<T: Object>() -> T { return T() }
+let object: ProbeObject = createObject()
+precondition(type(of: object) == ProbeObject.self)
+precondition(object.value == ProbeObject().value)
+SWIFT
+}
+
+extract_object_init_decl() {
+
+
+    awk '
+        BEGIN { active = 1; depth = 0 }
+        /^[[:space:]]*#if[[:space:]]+/ {
+            depth++
+            parent[depth] = active
+            cond[depth] = ($0 ~ /^[[:space:]]*#if[[:space:]]+true[[:space:]]*$/)
+            active = parent[depth] && cond[depth]
+            next
+        }
+        /^[[:space:]]*#else/ {
+            active = parent[depth] && !cond[depth]
+            next
+        }
+        /^[[:space:]]*#endif/ {
+            active = parent[depth]
+            delete parent[depth]
+            delete cond[depth]
+            depth--
+            next
+        }
+        active && /override/ && /init[[:space:]]*\([[:space:]]*\)/ {
+            line = $0
+            sub(/^[[:space:]]+/, "", line)
+            sub(/[[:space:]]*\{.*/, "", line)
+            print line
+            exit
+        }
+    ' RealmSwift/Object.swift
+}
+
+write_new_probe() {
+    local init_decl="$1"
+    cat > /tmp/realm_fixturea_generic_init_probe.swift <<SWIFT
+import Foundation
+
+public class RLMObjectBase: NSObject {
+    public override init() { super.init() }
+}
+
+public class Object: RLMObjectBase {
+    ${init_decl} {
+        super.init()
+    }
+}
+
+final class GenericDefaultObject: Object {
+    var intValue = 7
+    var stringValue = "realm"
+}
+
+final class GenericTokenObject: Object {
+    var token = "seed"
+
+    required init() {
+        super.init()
+    }
+
+    init(token: String) {
+        self.token = token
+        super.init()
+    }
+}
+
+func createObject<T: Object>() -> T {
+    return T()
+}
+
+let genericDefault: GenericDefaultObject = createObject()
+let directDefault = GenericDefaultObject()
+precondition(type(of: genericDefault) == GenericDefaultObject.self)
+precondition(genericDefault.intValue == directDefault.intValue)
+precondition(genericDefault.stringValue == directDefault.stringValue)
+
+let genericToken: GenericTokenObject = createObject()
+let directToken = GenericTokenObject()
+precondition(type(of: genericToken) == GenericTokenObject.self)
+precondition(genericToken.token == directToken.token)
+SWIFT
+}
+
+case "${1:-}" in
+    base)
+        swift --version
+        write_base_probe
+        swift /tmp/realm_fixturea_base_probe.swift
+        ;;
+    new)
+        test -f RealmSwift/Object.swift
+        test -f RealmSwift/Tests/ObjectCreationTests.swift
+        grep -q 'func testGenericInit()' RealmSwift/Tests/ObjectCreationTests.swift
+        init_decl="$(extract_object_init_decl)"
+        if [ -z "$init_decl" ]; then
+            echo "Object no-argument initializer declaration not found" >&2
+            exit 1
+        fi
+        write_new_probe "$init_decl"
+        swift /tmp/realm_fixturea_generic_init_probe.swift
+        ;;
+    *)
+        echo "usage: $0 base|new" >&2
+        exit 2
+        ;;
+esac
