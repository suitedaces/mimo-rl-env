diff --git a/test/dialects/ansi_test.py b/test/dialects/ansi_test.py
index 628fb8035..f8b9ff2e1 100644
--- a/test/dialects/ansi_test.py
+++ b/test/dialects/ansi_test.py
@@ -213,3 +213,144 @@ def test__dialect__ansi_parse_indented_joins(sql_string, indented_joins, meta_lo
         idx for idx, raw_seg in enumerate(parsed.tree.iter_raw_seg()) if raw_seg.is_meta
     )
     assert res_meta_locs == meta_loc
+
+
+
+
+
+_USING_AT_JOIN_SQL = (
+    "SELECT\n"
+    "    a,\n"
+    "    b\n"
+    "FROM\n"
+    "    table1\n"
+    "JOIN\n"
+    "    table2\n"
+    "USING (a, b)\n"
+)
+
+_USING_INDENTED_SQL = (
+    "SELECT\n"
+    "    a,\n"
+    "    b\n"
+    "FROM\n"
+    "    table1\n"
+    "JOIN\n"
+    "    table2\n"
+    "    USING (a, b)\n"
+)
+
+_ON_AT_JOIN_SQL = (
+    "SELECT\n"
+    "    a,\n"
+    "    b\n"
+    "FROM\n"
+    "    table1\n"
+    "JOIN\n"
+    "    table2\n"
+    "ON table1.a = table2.a\n"
+)
+
+_ON_INDENTED_SQL = (
+    "SELECT\n"
+    "    a,\n"
+    "    b\n"
+    "FROM\n"
+    "    table1\n"
+    "JOIN\n"
+    "    table2\n"
+    "    ON table1.a = table2.a\n"
+)
+
+
+def _lint_l003(sql, indented_using_on):
+    """Run linter with given indented_using_on config, return L003 violations."""
+    config = FluffConfig(
+        configs={"indentation": {"indented_using_on": indented_using_on}},
+        overrides=dict(dialect="ansi"),
+    )
+    lnt = Linter(config=config)
+    result = lnt.lint_string(sql)
+    return [v for v in result.violations if v.rule_code() == "L003"]
+
+
+def test__dialect__ansi_indented_using_on_false_accepts_using_at_join_level():
+    """indented_using_on=False: USING at JOIN level passes L003."""
+    violations = _lint_l003(_USING_AT_JOIN_SQL, indented_using_on=False)
+    assert violations == []
+
+
+def test__dialect__ansi_indented_using_on_false_rejects_using_indented():
+    """indented_using_on=False: USING indented from JOIN triggers L003."""
+    violations = _lint_l003(_USING_INDENTED_SQL, indented_using_on=False)
+    assert len(violations) >= 1
+
+
+def test__dialect__ansi_indented_using_on_true_accepts_using_indented():
+    """indented_using_on=True: USING indented from JOIN passes L003."""
+    violations = _lint_l003(_USING_INDENTED_SQL, indented_using_on=True)
+    assert violations == []
+
+
+def test__dialect__ansi_indented_using_on_true_rejects_using_at_join_level():
+    """indented_using_on=True: USING at JOIN level triggers L003."""
+    violations = _lint_l003(_USING_AT_JOIN_SQL, indented_using_on=True)
+    assert len(violations) >= 1
+
+
+def test__dialect__ansi_indented_using_on_false_accepts_on_at_join_level():
+    """indented_using_on=False: ON at JOIN level passes L003."""
+    violations = _lint_l003(_ON_AT_JOIN_SQL, indented_using_on=False)
+    assert violations == []
+
+
+def test__dialect__ansi_indented_using_on_false_rejects_on_indented():
+    """indented_using_on=False: ON indented from JOIN triggers L003."""
+    violations = _lint_l003(_ON_INDENTED_SQL, indented_using_on=False)
+    assert len(violations) >= 1
+
+
+def test__dialect__ansi_indented_using_on_true_accepts_on_indented():
+    """indented_using_on=True: ON indented from JOIN passes L003."""
+    violations = _lint_l003(_ON_INDENTED_SQL, indented_using_on=True)
+    assert violations == []
+
+
+def test__dialect__ansi_indented_using_on_true_rejects_on_at_join_level():
+    """indented_using_on=True: ON at JOIN level triggers L003."""
+    violations = _lint_l003(_ON_AT_JOIN_SQL, indented_using_on=True)
+    assert len(violations) >= 1
+
+
+@pytest.mark.parametrize(
+    "sql_string, indented_using_on, meta_loc",
+    [
+        (
+            "select field_1 from my_table as alias_1 join foo using (field_1)",
+            True,
+            (1, 5, 8, 15, 17, 22, 25, 27, 29, 30),
+        ),
+        (
+            "select field_1 from my_table as alias_1 join foo using (field_1)",
+            False,
+            (1, 5, 8, 15, 17, 21, 23, 26, 28, 30, 31, 32),
+        ),
+    ],
+)
+def test__dialect__ansi_parse_indented_using_on(
+    sql_string, indented_using_on, meta_loc
+):
+    """Conditional meta segments fire on indented_using_on config."""
+    lnt = Linter(
+        config=FluffConfig(
+            configs={"indentation": {"indented_using_on": indented_using_on}}
+        )
+    )
+    parsed = lnt.parse_string(sql_string)
+    assert "unparsable" not in parsed.tree.type_set()
+    res_meta_locs = tuple(
+        idx
+        for idx, raw_seg in enumerate(parsed.tree.iter_raw_seg())
+        if raw_seg.is_meta
+    )
+    assert res_meta_locs == meta_loc
