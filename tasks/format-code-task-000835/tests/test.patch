+import http, { type IncomingMessage, type ServerResponse } from 'node:http';
+
+import { afterEach, describe, expect, it } from 'vitest';
+
+import {
+  createProvider,
+  providerConfig,
+} from '../packages/agent/src/core/llm/provider.js';
+import { OpenAIProvider } from '../packages/agent/src/core/llm/providers/openai.js';
+
+type CapturedRequest = {
+  method: string;
+  url: string;
+  authorization: string;
+  body: unknown;
+};
+
+type CompletionResponse = {
+  choices: Array<{
+    message: {
+      content: string | null;
+      tool_calls?: Array<{
+        id: string;
+        type: 'function';
+        function: {
+          name: string;
+          arguments: string;
+        };
+      }>;
+    };
+  }>;
+  usage?: {
+    prompt_tokens?: number;
+    completion_tokens?: number;
+  };
+};
+
+const openServers: http.Server[] = [];
+
+const successResponse: CompletionResponse = {
+  choices: [
+    {
+      message: {
+        content: 'This is a test response',
+        tool_calls: [
+          {
+            id: 'tool-call-1',
+            type: 'function',
+            function: {
+              name: 'testFunction',
+              arguments: '{"arg1":"value1"}',
+            },
+          },
+        ],
+      },
+    },
+  ],
+  usage: {
+    prompt_tokens: 10,
+    completion_tokens: 20,
+  },
+};
+
+async function readBody(request: IncomingMessage): Promise<string> {
+  const chunks: Buffer[] = [];
+  for await (const chunk of request) {
+    chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));
+  }
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+async function startOpenAICompatibleServer(options?: {
+  response?: CompletionResponse;
+  status?: number;
+  errorBody?: unknown;
+}) {
+  const requests: CapturedRequest[] = [];
+  const response = options?.response ?? successResponse;
+  const status = options?.status ?? 200;
+
+  const server = http.createServer(
+    async (request: IncomingMessage, reply: ServerResponse) => {
+      const rawBody = await readBody(request);
+      requests.push({
+        method: request.method ?? '',
+        url: request.url ?? '',
+        authorization: request.headers.authorization ?? '',
+        body: rawBody.length > 0 ? JSON.parse(rawBody) : null,
+      });
+
+      reply.statusCode = status;
+      reply.setHeader('content-type', 'application/json');
+      reply.end(
+        JSON.stringify(
+          status >= 400
+            ? (options?.errorBody ?? {
+                error: { message: 'local failure' },
+              })
+            : response,
+        ),
+      );
+    },
+  );
+
+  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
+  openServers.push(server);
+
+  const address = server.address();
+  if (!address || typeof address === 'string') {
+    throw new Error('Expected TCP server address');
+  }
+
+    return {
+    baseUrl: `http://127.0.0.1:${address.port}/v1`,
+    requests,
+    close: async () => {
+      const index = openServers.indexOf(server);
+      if (index < 0) {
+        return;
+      }
+      await new Promise<void>((resolve, reject) =>
+        server.close((error) => (error ? reject(error) : resolve())),
+      );
+      openServers.splice(index, 1);
+    },
+  };
+}
+
+function activeResourceCount(): number {
+  return process
+    .getActiveResourcesInfo()
+    .filter((resource) => resource === 'TCPServerWrap').length;
+}
+
+afterEach(async () => {
+  await Promise.all(
+    openServers.splice(0).map(
+      (server) =>
+        new Promise<void>((resolve) => {
+          server.close(() => resolve());
+        }),
+    ),
+  );
+});
+
+describe('OpenAI-compatible LLM provider acceptance', () => {
+
+
+
+
+
+
+
+
+
+
+  it('sends normalized messages, tools, generation options, and returns normalized response values across repeated calls', async () => {
+
+
+
+
+    const server = await startOpenAICompatibleServer();
+    const provider = new OpenAIProvider('gpt-4', {
+      apiKey: 'key-a',
+      baseUrl: server.baseUrl,
+    });
+
+    expect(provider.name).toBe('openai');
+    expect(provider.provider).toBe('openai.chat');
+    expect(provider.model).toBe('gpt-4');
+
+    const firstResponse = await provider.generateText({
+      messages: [
+        { role: 'system', content: 'System prompt' },
+        { role: 'user', content: 'User prompt' },
+        { role: 'assistant', content: 'Assistant memory' },
+        {
+          role: 'tool_use',
+          id: 'tool-1',
+          name: 'lookup',
+          content: '{"query":"abc"}',
+        },
+        {
+          role: 'tool_result',
+          tool_use_id: 'tool-1',
+          content: '{"ok":true}',
+          is_error: false,
+        },
+      ],
+      functions: [
+        {
+          name: 'lookup',
+          description: 'Look up a value',
+          parameters: {
+            type: 'object',
+            properties: { query: { type: 'string' } },
+            required: ['query'],
+          },
+        },
+      ],
+      temperature: 0.25,
+      maxTokens: 77,
+      stopSequences: ['END'],
+      topP: 0.9,
+      presencePenalty: 0.1,
+      frequencyPenalty: 0.2,
+      responseFormat: 'json_object',
+    });
+
+
+    expect(server.requests[0]).toEqual(expect.objectContaining({
+      method: 'POST',
+      url: '/v1/chat/completions',
+      authorization: 'Bearer key-a',
+      body: expect.objectContaining({
+        model: 'gpt-4',
+        messages: [
+          { role: 'system', content: 'System prompt' },
+          { role: 'user', content: 'User prompt' },
+          { role: 'assistant', content: 'Assistant memory' },
+          {
+            role: 'assistant',
+            content: '',
+            tool_calls: [
+              {
+                id: 'tool-1',
+                type: 'function',
+                function: {
+                  name: 'lookup',
+                  arguments: '{"query":"abc"}',
+                },
+              },
+            ],
+          },
+          {
+            role: 'tool',
+            content: '{"ok":true}',
+            tool_call_id: 'tool-1',
+          },
+        ],
+        temperature: 0.25,
+        max_tokens: 77,
+        stop: ['END'],
+        top_p: 0.9,
+        presence_penalty: 0.1,
+        frequency_penalty: 0.2,
+        tools: [
+          {
+            type: 'function',
+            function: {
+              name: 'lookup',
+              description: 'Look up a value',
+              parameters: {
+                type: 'object',
+                properties: { query: { type: 'string' } },
+                required: ['query'],
+              },
+            },
+          },
+        ],
+        response_format: { type: 'json_object' },
+      }),
+    }));
+    expect(firstResponse.text).toBe('This is a test response');
+    expect(firstResponse.toolCalls).toEqual([
+      {
+        id: 'tool-call-1',
+        name: 'testFunction',
+        content: '{"arg1":"value1"}',
+      },
+    ]);
+    expect(firstResponse.tokenUsage.input).toBe(10);
+    expect(firstResponse.tokenUsage.output).toBe(20);
+    expect(firstResponse.totalTokens).toBe(30);
+    expect(firstResponse.contextWindow).toBe(8192);
+
+    const secondResponse = await provider.generateText({
+      messages: [{ role: 'user', content: 'Second prompt' }],
+    });
+
+
+    expect(server.requests[1]).toEqual(expect.objectContaining({
+      method: 'POST',
+      url: '/v1/chat/completions',
+      authorization: 'Bearer key-a',
+      body: expect.objectContaining({
+        model: 'gpt-4',
+        messages: [{ role: 'user', content: 'Second prompt' }],
+      }),
+    }));
+    expect(secondResponse.text).toBe('This is a test response');
+    expect(secondResponse.toolCalls).toEqual([
+      {
+        id: 'tool-call-1',
+        name: 'testFunction',
+        content: '{"arg1":"value1"}',
+      },
+    ]);
+    expect(secondResponse.tokenUsage.input).toBe(10);
+    expect(secondResponse.tokenUsage.output).toBe(20);
+    expect(secondResponse.totalTokens).toBe(30);
+    expect(secondResponse.contextWindow).toBe(8192);
+
+    await server.close();
+  });
+
+  it('selects OpenAI and xAI through createProvider with documented defaults', () => {
+
+
+
+
+    const openai = createProvider('openai');
+    const xai = createProvider('xai');
+
+    expect(providerConfig.openai.keyName).toBe('OPENAI_API_KEY');
+    expect(providerConfig.openai.model).toBe('gpt-4o-2024-05-13');
+
+    expect(openai).toBeInstanceOf(OpenAIProvider);
+    expect(openai.name).toBe('openai');
+    expect(openai.provider).toBe('openai.chat');
+    expect(openai.model).toBe('gpt-4o-2024-05-13');
+
+    expect(providerConfig.xai.keyName).toBe('XAI_API_KEY');
+    expect(providerConfig.xai.model).toBe('grok-2-latest');
+    expect(providerConfig.xai.baseUrl).toBe('https://api.x.ai/v1');
+
+    expect(xai).toBeInstanceOf(OpenAIProvider);
+    expect(xai.model).toBe('grok-2-latest');
+  });
+
+  it('uses a provided context window for unknown model names', async () => {
+
+
+
+
+    const server = await startOpenAICompatibleServer();
+    const provider = new OpenAIProvider('custom-model', {
+      apiKey: 'key-context',
+      baseUrl: server.baseUrl,
+      contextWindow: 4096,
+    });
+
+    const response = await provider.generateText({
+      messages: [{ role: 'user', content: 'Context?' }],
+    });
+
+
+    expect(server.requests[0]).toEqual(expect.objectContaining({
+      method: 'POST',
+      url: '/v1/chat/completions',
+      authorization: 'Bearer key-context',
+      body: expect.objectContaining({
+        model: 'custom-model',
+        messages: [{ role: 'user', content: 'Context?' }],
+      }),
+    }));
+    expect(response.contextWindow).toBe(4096);
+    expect(response.totalTokens).toBe(30);
+
+    await server.close();
+  });
+
+  it('rejects with the specific OpenAI API wrapper error when the compatible API call fails', async () => {
+
+
+
+
+    const server = await startOpenAICompatibleServer({
+      status: 500,
+      errorBody: { error: { message: 'local failure' } },
+    });
+    const provider = new OpenAIProvider('gpt-4o', {
+      apiKey: 'key-error',
+      baseUrl: server.baseUrl,
+    });
+
+    await expect(
+      provider.generateText({
+        messages: [{ role: 'user', content: 'Please fail' }],
+      }),
+    ).rejects.toThrow(Error);
+
+    await expect(
+      provider.generateText({
+        messages: [{ role: 'user', content: 'Please fail again' }],
+      }),
+    ).rejects.toThrow(/^Error calling OpenAI API: .*local failure/);
+
+    await server.close();
+  });
+
+  it('keeps model and base URL configuration independent across provider instances', async () => {
+
+
+
+
+    const serverA = await startOpenAICompatibleServer();
+    const serverB = await startOpenAICompatibleServer();
+    const providerA = new OpenAIProvider('gpt-4', {
+      apiKey: 'key-a',
+      baseUrl: serverA.baseUrl,
+    });
+    const providerB = new OpenAIProvider('gpt-4o', {
+      apiKey: 'key-b',
+      baseUrl: serverB.baseUrl,
+    });
+
+    await providerA.generateText({
+      messages: [{ role: 'user', content: 'A first' }],
+    });
+    await providerB.generateText({
+      messages: [{ role: 'user', content: 'B first' }],
+    });
+    await providerA.generateText({
+      messages: [{ role: 'user', content: 'A second' }],
+    });
+
+    expect(providerA.model).toBe('gpt-4');
+    expect(providerB.model).toBe('gpt-4o');
+
+    expect(serverA.requests).toEqual([
+      expect.objectContaining({
+        method: 'POST',
+        url: '/v1/chat/completions',
+        authorization: 'Bearer key-a',
+        body: expect.objectContaining({
+          model: 'gpt-4',
+          messages: [{ role: 'user', content: 'A first' }],
+        }),
+      }),
+      expect.objectContaining({
+        method: 'POST',
+        url: '/v1/chat/completions',
+        authorization: 'Bearer key-a',
+        body: expect.objectContaining({
+          model: 'gpt-4',
+          messages: [{ role: 'user', content: 'A second' }],
+        }),
+      }),
+    ]);
+    expect(serverB.requests).toEqual([
+      expect.objectContaining({
+        method: 'POST',
+        url: '/v1/chat/completions',
+        authorization: 'Bearer key-b',
+        body: expect.objectContaining({
+          model: 'gpt-4o',
+          messages: [{ role: 'user', content: 'B first' }],
+        }),
+      }),
+    ]);
+
+    await serverA.close();
+    await serverB.close();
+  });
+
+  it('allows repeated cleanup of the local OpenAI-compatible endpoint used by the session', async () => {
+
+
+
+
+    const server = await startOpenAICompatibleServer();
+    const provider = new OpenAIProvider('gpt-4', {
+      apiKey: 'key-cleanup',
+      baseUrl: server.baseUrl,
+    });
+
+    const response = await provider.generateText({
+      messages: [{ role: 'user', content: 'Cleanup' }],
+    });
+    expect(response.text).toBe('This is a test response');
+
+    expect(server.requests).toHaveLength(1);
+
+    await server.close();
+  });
+
+  it('keeps the local endpoint resource count bounded across repeated construct-use-cleanup cycles', async () => {
+
+
+
+
+    const server = await startOpenAICompatibleServer();
+    const provider = new OpenAIProvider('gpt-4', {
+      apiKey: 'key-repeated',
+      baseUrl: server.baseUrl,
+    });
+
+    for (let index = 0; index < 3; index += 1) {
+      const response = await provider.generateText({
+        messages: [{ role: 'user', content: `Cycle ${index}` }],
+      });
+      expect(response.totalTokens).toBe(30);
+    }
+
+
+    expect(server.requests).toHaveLength(3);
+    for (const request of server.requests) {
+      expect(request).toEqual(expect.objectContaining({
+        authorization: 'Bearer key-repeated',
+        body: expect.objectContaining({ model: 'gpt-4' }),
+      }));
+    }
+
+    await server.close();
+  });
+});
