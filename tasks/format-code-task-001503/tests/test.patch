+def test_min_version_sqlite_constant_is_3_31_0():
+    """SQLite minimum supported version should be lowered to 3.31.0 (Ubuntu 20.04 LTS)."""
+    assert str(util.MIN_VERSION_SQLITE) == "3.31.0"
+
+
+@pytest.mark.parametrize(
+    "sqlite_version",
+    [
+        "3.31.0",
+        "3.31.1",
+    ],
+)
+def test_supported_sqlite_lts_versions(caplog, sqlite_version):
+    """SQLite 3.31.0/3.31.1 (Ubuntu 20.04 LTS) must NOT trigger an unsupported warning."""
+    instance_mock = MagicMock(_db_supports_row_number=True)
+    execute_args = []
+    close_mock = MagicMock()
+
+    def execute_mock(statement):
+        nonlocal execute_args
+        execute_args.append(statement)
+
+    def fetchall_mock():
+        nonlocal execute_args
+        if execute_args[-1] == "SELECT sqlite_version()":
+            return [[sqlite_version]]
+        return None
+
+    def _make_cursor_mock(*_):
+        return MagicMock(execute=execute_mock, close=close_mock, fetchall=fetchall_mock)
+
+    dbapi_connection = MagicMock(cursor=_make_cursor_mock)
+
+    util.setup_connection_for_dialect(instance_mock, "sqlite", dbapi_connection, True)
+
+    assert "is not supported" not in caplog.text
+    assert "minimum supported version" not in caplog.text
+
+
+@pytest.mark.parametrize(
+    "sqlite_version,message",
+    [
+        (
+            "3.30.0",
+            "Version 3.30.0 of SQLite is not supported; minimum supported version is 3.31.0.",
+        ),
+        (
+            "2.0.0",
+            "Version 2.0.0 of SQLite is not supported; minimum supported version is 3.31.0.",
+        ),
+        (
+            "dogs",
+            "Version dogs of SQLite is not supported; minimum supported version is 3.31.0.",
+        ),
+    ],
+)
+def test_warn_outdated_sqlite_below_3_31_0(caplog, sqlite_version, message):
+    """Versions below 3.31.0 should still trigger the warning, with new minimum text."""
+    instance_mock = MagicMock(_db_supports_row_number=True)
+    execute_args = []
+    close_mock = MagicMock()
+
+    def execute_mock(statement):
+        nonlocal execute_args
+        execute_args.append(statement)
+
+    def fetchall_mock():
+        nonlocal execute_args
+        if execute_args[-1] == "SELECT sqlite_version()":
+            return [[sqlite_version]]
+        return None
+
+    def _make_cursor_mock(*_):
+        return MagicMock(execute=execute_mock, close=close_mock, fetchall=fetchall_mock)
+
+    dbapi_connection = MagicMock(cursor=_make_cursor_mock)
+
+    util.setup_connection_for_dialect(instance_mock, "sqlite", dbapi_connection, True)
+
+    assert message in caplog.text
+
+
+def test_warn_unsupported_dialect_mentions_sqlite_3_31_0(caplog):
+    """The unsupported-dialect warning must reference the new SQLite ≥ 3.31.0 minimum."""
+    instance_mock = MagicMock()
+    dbapi_connection = MagicMock()
+
+    util.setup_connection_for_dialect(instance_mock, "mssql", dbapi_connection, True)
+
+    assert "SQLite ≥ 3.31.0" in caplog.text
+
+
