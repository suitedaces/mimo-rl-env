+++ b/src/js/components/Spinner/__tests__/Spinner-color-theme-test.js
@@ -0,0 +1,99 @@
+import React from 'react';
+import { render } from '@testing-library/react';
+import 'jest-styled-components';
+import 'regenerator-runtime/runtime';
+
+import { Grommet } from '../../Grommet';
+import { Spinner } from '..';
+
+
+
+const getSpinnerEl = (container) => container.firstChild.firstChild;
+
+describe('Spinner color/theme border interaction', () => {
+
+
+
+  test('color prop applies to top border when theme has no border config', () => {
+    const { container } = render(
+      <Grommet>
+        <Spinner color="accent-1" />
+      </Grommet>,
+    );
+    const el = getSpinnerEl(container);
+
+    expect(el).toHaveStyleRule('border-top', 'solid 1px #6FFFB0');
+
+    expect(el).toHaveStyleRule('border', 'solid 1px #33333310');
+  });
+
+
+
+
+  test('color prop overrides theme border color (the bug fix)', () => {
+    const theme = {
+      spinner: {
+        container: {
+          border: [
+            { side: 'all', color: 'background-contrast', size: 'small' },
+            { side: 'top', color: 'brand', size: 'small' },
+          ],
+        },
+      },
+    };
+    const { container } = render(
+      <Grommet theme={theme}>
+        <Spinner color="accent-1" />
+      </Grommet>,
+    );
+    const el = getSpinnerEl(container);
+
+
+    expect(el).toHaveStyleRule('border-top', 'solid 2px #6FFFB0');
+
+    expect(el).not.toHaveStyleRule('border-top', 'solid 2px #7D4CDB');
+  });
+
+
+
+  test('color prop does not override theme border all-side color', () => {
+    const theme = {
+      spinner: {
+        container: {
+          border: [
+            { side: 'all', color: 'background-contrast', size: 'small' },
+            { side: 'top', color: 'brand', size: 'small' },
+          ],
+        },
+      },
+    };
+    const { container } = render(
+      <Grommet theme={theme}>
+        <Spinner color="accent-1" />
+      </Grommet>,
+    );
+    const el = getSpinnerEl(container);
+
+    expect(el).toHaveStyleRule('border', 'solid 2px #33333310');
+    expect(el).not.toHaveStyleRule('border', 'solid 2px #6FFFB0');
+  });
+
+
+  test('theme border:false does not set border styles', () => {
+    const theme = {
+      spinner: {
+        container: {
+          border: false,
+        },
+      },
+    };
+    const { container } = render(
+      <Grommet theme={theme}>
+        <Spinner color="accent-1" />
+      </Grommet>,
+    );
+    const el = getSpinnerEl(container);
+
+    expect(el).not.toHaveStyleRule('border-top');
+  });
+});
