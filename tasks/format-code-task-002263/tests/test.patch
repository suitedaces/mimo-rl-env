+package usercase_test_coderl
+
+import (
+	"reflect"
+	"testing"
+
+	sqlsmith "github.com/chaos-mesh/go-sqlsmith"
+)
+
+
+
+
+
+
+func TestLoadSchemaBuildsShopSchemaFromRecordsAndIndexes(t *testing.T) {
+
+
+	ss := sqlsmith.New()
+	if len(ss.Databases) != 0 {
+		t.Fatalf("fresh SQLSmith database count = %d, want 0", len(ss.Databases))
+	}
+
+	ss.LoadSchema([][5]string{
+		{"shop", "users", "BASE TABLE", "id", "INT(11)"},
+		{"shop", "users", "BASE TABLE", "name", "VARCHAR(255)"},
+		{"shop", "orders", "VIEW", "created_at", "TIMESTAMP"},
+	}, map[string][]string{
+		"users": {"idx_users_name"},
+	})
+
+	if len(ss.Databases) != 1 {
+		t.Fatalf("database count after load = %d, want 1", len(ss.Databases))
+	}
+	shop := ss.Databases["shop"]
+	if shop == nil {
+		t.Fatalf("Databases[%q] = nil, want database", "shop")
+	}
+
+	if shop.Name != "" && shop.Name != "shop" {
+		t.Fatalf("shop.Name = %q, want empty or %q", shop.Name, "shop")
+	}
+
+	if shop.Tables == nil {
+		t.Fatalf("shop.Tables = nil, want table registry")
+	}
+	if len(shop.Tables) != 2 {
+		t.Fatalf("shop table count = %d, want 2", len(shop.Tables))
+	}
+
+	users := shop.Tables["users"]
+	if users == nil {
+		t.Fatalf("shop.Tables[%q] = nil, want table", "users")
+	}
+
+	if users.DB != "" && users.DB != "shop" {
+		t.Fatalf("users.DB = %q, want empty or %q", users.DB, "shop")
+	}
+
+	if users.Table != "" && users.Table != "users" {
+		t.Fatalf("users.Table = %q, want empty or %q", users.Table, "users")
+	}
+	if users.Type != "BASE TABLE" {
+		t.Fatalf("users.Type = %q, want %q", users.Type, "BASE TABLE")
+	}
+	if !reflect.DeepEqual(users.Indexes, []string{"idx_users_name"}) {
+		t.Fatalf("users.Indexes = %#v, want %#v", users.Indexes, []string{"idx_users_name"})
+	}
+	if len(users.Columns) != 2 {
+		t.Fatalf("users column count = %d, want 2", len(users.Columns))
+	}
+	if users.Columns["id"].DataType != "int" {
+		t.Fatalf("users.id DataType = %q, want %q", users.Columns["id"].DataType, "int")
+	}
+	if users.Columns["name"].DataType != "varchar" {
+		t.Fatalf("users.name DataType = %q, want %q", users.Columns["name"].DataType, "varchar")
+	}
+
+	orders := shop.Tables["orders"]
+	if orders == nil {
+		t.Fatalf("shop.Tables[%q] = nil, want table", "orders")
+	}
+
+	if orders.DB != "" && orders.DB != "shop" {
+		t.Fatalf("orders.DB = %q, want empty or %q", orders.DB, "shop")
+	}
+
+	if orders.Table != "" && orders.Table != "orders" {
+		t.Fatalf("orders.Table = %q, want empty or %q", orders.Table, "orders")
+	}
+	if orders.Type != "VIEW" {
+		t.Fatalf("orders.Type = %q, want %q", orders.Type, "VIEW")
+	}
+
+	if len(orders.Indexes) != 0 {
+		t.Fatalf("orders.Indexes = %#v, want empty index list", orders.Indexes)
+	}
+	if len(orders.Columns) != 1 {
+		t.Fatalf("orders column count = %d, want 1", len(orders.Columns))
+	}
+	if orders.Columns["created_at"].DataType != "timestamp" {
+		t.Fatalf("orders.created_at DataType = %q, want %q", orders.Columns["created_at"].DataType, "timestamp")
+	}
+}
+
+func TestLoadSchemaAddsOnlyMissingEntriesOnRepeatedLoad(t *testing.T) {
+
+
+	ss := sqlsmith.New()
+	ss.LoadSchema([][5]string{
+		{"shop", "users", "BASE TABLE", "id", "INT(11)"},
+		{"shop", "users", "BASE TABLE", "name", "VARCHAR(255)"},
+		{"shop", "orders", "VIEW", "created_at", "TIMESTAMP"},
+	}, map[string][]string{
+		"users": {"idx_users_name"},
+	})
+
+	ss.LoadSchema([][5]string{
+		{"shop", "users", "BASE TABLE", "id", "BIGINT(20)"},
+		{"shop", "users", "BASE TABLE", "email", "VARCHAR(128)"},
+	}, map[string][]string{
+		"users": {"idx_replacement"},
+	})
+
+	shop := ss.Databases["shop"]
+	if len(ss.Databases) != 1 {
+		t.Fatalf("database count after duplicate/add load = %d, want 1", len(ss.Databases))
+	}
+	if len(shop.Tables) != 2 {
+		t.Fatalf("shop table count after duplicate/add load = %d, want 2", len(shop.Tables))
+	}
+	users := shop.Tables["users"]
+	if len(users.Columns) != 3 {
+		t.Fatalf("users column count after duplicate/add load = %d, want 3", len(users.Columns))
+	}
+	if !reflect.DeepEqual(users.Indexes, []string{"idx_users_name"}) {
+		t.Fatalf("users.Indexes after duplicate/add load = %#v, want %#v", users.Indexes, []string{"idx_users_name"})
+	}
+	if users.Columns["id"].DataType != "int" {
+		t.Fatalf("users.id DataType after duplicate row = %q, want %q", users.Columns["id"].DataType, "int")
+	}
+	if users.Columns["email"].DataType != "varchar" {
+		t.Fatalf("users.email DataType = %q, want %q", users.Columns["email"].DataType, "varchar")
+	}
+}
+
+func TestLoadSchemaMutatesOnlyReceivingSQLSmithInstance(t *testing.T) {
+
+
+	a := sqlsmith.New()
+	b := sqlsmith.New()
+
+	a.LoadSchema([][5]string{
+		{"analytics", "events", "BASE TABLE", "event_id", "BIGINT(20)"},
+	}, map[string][]string{
+		"events": {"idx_events_id"},
+	})
+	b.LoadSchema([][5]string{
+		{"shop", "users", "BASE TABLE", "id", "INT(11)"},
+	}, map[string][]string{})
+
+	if len(a.Databases) != 1 {
+		t.Fatalf("a database count = %d, want 1", len(a.Databases))
+	}
+	analytics := a.Databases["analytics"]
+	if len(analytics.Tables) != 1 {
+		t.Fatalf("a analytics table count = %d, want 1", len(analytics.Tables))
+	}
+	events := analytics.Tables["events"]
+	if len(events.Columns) != 1 {
+		t.Fatalf("a events column count = %d, want 1", len(events.Columns))
+	}
+	if events.Columns["event_id"].DataType != "bigint" {
+		t.Fatalf("a events.event_id DataType = %q, want %q", events.Columns["event_id"].DataType, "bigint")
+	}
+	if !reflect.DeepEqual(events.Indexes, []string{"idx_events_id"}) {
+		t.Fatalf("a events indexes = %#v, want %#v", events.Indexes, []string{"idx_events_id"})
+	}
+
+	if len(b.Databases) != 1 {
+		t.Fatalf("b database count = %d, want 1", len(b.Databases))
+	}
+	shop := b.Databases["shop"]
+	if len(shop.Tables) != 1 {
+		t.Fatalf("b shop table count = %d, want 1", len(shop.Tables))
+	}
+	users := shop.Tables["users"]
+	if len(users.Columns) != 1 {
+		t.Fatalf("b users column count = %d, want 1", len(users.Columns))
+	}
+	if users.Columns["id"].DataType != "int" {
+		t.Fatalf("b users.id DataType = %q, want %q", users.Columns["id"].DataType, "int")
+	}
+
+	if len(users.Indexes) != 0 {
+		t.Fatalf("b users indexes = %#v, want empty index list", users.Indexes)
+	}
+	if b.Databases["analytics"] != nil {
+		t.Fatalf("b analytics database = %#v, want nil", b.Databases["analytics"])
+	}
+}
+
+func TestLoadSchemaMethodReturnsNoValue(t *testing.T) {
+
+
+	methodType := reflect.TypeOf((*sqlsmith.SQLSmith).LoadSchema)
+	if methodType.NumOut() != 0 {
+		t.Fatalf("LoadSchema return count = %d, want 0", methodType.NumOut())
+	}
+}
