+#!/bin/bash
+set -euo pipefail
+
+GOFLAGS=-mod=vendor go test ./azurerm/helpers/azure -run 'Test(ServiceBusAuthorizationRuleCustomizeDiffValidation|EventHubAuthorizationRuleCustomizeDiffValidation|AuthorizationRuleCustomizeDiffHandlesOmittedBooleans|ServiceBusAuthorizationRuleRightsRoundTrip|EventHubAuthorizationRuleRightsRoundTrip)'
