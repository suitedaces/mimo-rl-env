diff --git a/azurerm/helpers/azure/authorization_rules_test.go b/azurerm/helpers/azure/authorization_rules_test.go
new file mode 100644
index 0000000000..6f618e2c69
--- /dev/null
+++ b/azurerm/helpers/azure/authorization_rules_test.go
@@ -0,0 +1,136 @@
+package azure
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/Azure/azure-sdk-for-go/services/eventhub/mgmt/2017-04-01/eventhub"
+	"github.com/Azure/azure-sdk-for-go/services/servicebus/mgmt/2017-04-01/servicebus"
+	"github.com/hashicorp/terraform-plugin-sdk/helper/schema"
+	"github.com/hashicorp/terraform-plugin-sdk/terraform"
+)
+
+func diffValidationErrorWithSchema(custom schema.CustomizeDiffFunc, fields map[string]*schema.Schema, values map[string]interface{}, service string) (err error) {
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			err = fmt.Errorf("%s authorization diff panicked: %v", service, recovered)
+		}
+	}()
+	r := &schema.Resource{
+		Schema:        fields,
+		CustomizeDiff: custom,
+	}
+	_, err = r.Diff(nil, terraform.NewResourceConfigRaw(values), nil)
+	return err
+}
+
+func diffValidationError(custom schema.CustomizeDiffFunc, values map[string]interface{}, service string) error {
+	return diffValidationErrorWithSchema(custom, ServiceBusAuthorizationRuleSchemaFrom(map[string]*schema.Schema{}), values, service)
+}
+
+func bareRightsSchema() map[string]*schema.Schema {
+	return map[string]*schema.Schema{
+		"listen": {Type: schema.TypeBool, Optional: true},
+		"send":   {Type: schema.TypeBool, Optional: true},
+		"manage": {Type: schema.TypeBool, Optional: true},
+	}
+}
+
+func TestServiceBusAuthorizationRuleCustomizeDiffValidation(t *testing.T) {
+	cases := []struct {
+		name   string
+		values map[string]interface{}
+		err    bool
+	}{
+		{"omitted rights", map[string]interface{}{}, true},
+		{"explicitly disabled rights", map[string]interface{}{"listen": false, "send": false, "manage": false}, true},
+		{"listen only", map[string]interface{}{"listen": true}, false},
+		{"send only", map[string]interface{}{"send": true}, false},
+		{"manage without listen", map[string]interface{}{"manage": true}, true},
+		{"manage without send", map[string]interface{}{"manage": true, "listen": true}, true},
+		{"all rights", map[string]interface{}{"listen": true, "send": true, "manage": true}, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			err := diffValidationError(ServiceBusAuthorizationRuleCustomizeDiff, tc.values, "service bus")
+			if err != nil && strings.Contains(err.Error(), "panicked") {
+				t.Fatalf("customize diff must return validation errors instead of panic: %v", err)
+			}
+			if (err != nil) != tc.err {
+				t.Fatalf("expected error=%t, got %v", tc.err, err)
+			}
+		})
+	}
+}
+
+func TestEventHubAuthorizationRuleCustomizeDiffValidation(t *testing.T) {
+	cases := []struct {
+		name   string
+		values map[string]interface{}
+		err    bool
+	}{
+		{"omitted rights", map[string]interface{}{}, true},
+		{"explicitly disabled rights", map[string]interface{}{"listen": false, "send": false, "manage": false}, true},
+		{"listen only", map[string]interface{}{"listen": true}, false},
+		{"send only", map[string]interface{}{"send": true}, false},
+		{"manage without listen", map[string]interface{}{"manage": true}, true},
+		{"manage without send", map[string]interface{}{"manage": true, "listen": true}, true},
+		{"all rights", map[string]interface{}{"listen": true, "send": true, "manage": true}, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			err := diffValidationError(EventHubAuthorizationRuleCustomizeDiff, tc.values, "event hub")
+			if err != nil && strings.Contains(err.Error(), "panicked") {
+				t.Fatalf("customize diff must return validation errors instead of panic: %v", err)
+			}
+			if (err != nil) != tc.err {
+				t.Fatalf("expected error=%t, got %v", tc.err, err)
+			}
+		})
+	}
+}
+
+func TestAuthorizationRuleCustomizeDiffHandlesOmittedBooleans(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		fn   schema.CustomizeDiffFunc
+	}{
+		{"service bus", ServiceBusAuthorizationRuleCustomizeDiff},
+		{"event hub", EventHubAuthorizationRuleCustomizeDiff},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			err := diffValidationErrorWithSchema(tc.fn, bareRightsSchema(), map[string]interface{}{"manage": true}, tc.name)
+			if err != nil && strings.Contains(err.Error(), "panicked") {
+				t.Fatalf("customize diff must handle omitted booleans without panic: %v", err)
+			}
+			if err == nil {
+				t.Fatal("expected manage without both listen and send to be rejected")
+			}
+		})
+	}
+}
+
+func TestServiceBusAuthorizationRuleRightsRoundTrip(t *testing.T) {
+	d := schema.TestResourceDataRaw(t, ServiceBusAuthorizationRuleSchemaFrom(nil), map[string]interface{}{"listen": true, "send": false, "manage": true})
+	rights := ExpandServiceBusAuthorizationRuleRights(d)
+	if len(*rights) != 2 || (*rights)[0] != servicebus.Listen || (*rights)[1] != servicebus.Manage {
+		t.Fatalf("unexpected service bus rights: %#v", *rights)
+	}
+	listen, send, manage := FlattenServiceBusAuthorizationRuleRights(rights)
+	if !listen || send || !manage {
+		t.Fatalf("unexpected service bus flattening: listen=%t send=%t manage=%t", listen, send, manage)
+	}
+}
+
+func TestEventHubAuthorizationRuleRightsRoundTrip(t *testing.T) {
+	d := schema.TestResourceDataRaw(t, EventHubAuthorizationRuleSchemaFrom(nil), map[string]interface{}{"listen": false, "send": true, "manage": true})
+	rights := ExpandEventHubAuthorizationRuleRights(d)
+	if len(*rights) != 2 || (*rights)[0] != eventhub.Send || (*rights)[1] != eventhub.Manage {
+		t.Fatalf("unexpected event hub rights: %#v", *rights)
+	}
+	listen, send, manage := FlattenEventHubAuthorizationRuleRights(rights)
+	if listen || !send || !manage {
+		t.Fatalf("unexpected event hub flattening: listen=%t send=%t manage=%t", listen, send, manage)
+	}
+}
