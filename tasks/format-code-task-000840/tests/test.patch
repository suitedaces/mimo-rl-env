+
+  describe(nameof<Type>("isAssignableTo"), () => {
+    function getTwoTypes(text: string) {
+      const result = getInfoFromTextWithTypeChecking(text);
+      const decls = result.sourceFile.getVariableDeclarations();
+      return { a: decls[0].getType(), b: decls[1].getType() };
+    }
+
+    it("should return true when the string literal type is assignable to the string type", () => {
+      const { a, b } = getTwoTypes("let a: 'test'; let b: string;");
+      expect(a.isAssignableTo(b)).to.equal(true);
+    });
+
+    it("should return false when the string type is not assignable to the string literal type", () => {
+      const { a, b } = getTwoTypes("let a: 'test'; let b: string;");
+      expect(b.isAssignableTo(a)).to.equal(false);
+    });
+
+    it("should return false when number is not assignable to string", () => {
+      const { a, b } = getTwoTypes("let a: number; let b: string;");
+      expect(a.isAssignableTo(b)).to.equal(false);
+    });
+
+    it("should return true when a type is assignable to itself", () => {
+      const { a, b } = getTwoTypes("let a: string; let b: string;");
+      expect(a.isAssignableTo(b)).to.equal(true);
+      expect(b.isAssignableTo(a)).to.equal(true);
+    });
+
+    it("should return true when any is assignable to string", () => {
+      const { a, b } = getTwoTypes("let a: any; let b: string;");
+      expect(a.isAssignableTo(b)).to.equal(true);
+    });
+
+    it("should return true when a subclass type is assignable to the base interface type", () => {
+      const { a, b } = getTwoTypes("interface Base { x: number } interface Sub extends Base { y: number } let a: Sub; let b: Base;");
+      expect(a.isAssignableTo(b)).to.equal(true);
