+package usercase_test_coderl
+
+
+
+
+
+
+
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"testing"
+
+	"github.com/hexops/autogold/v2"
+)
+
+const repoRoot = "/workspace/repo"
+
+func TestRawJSONCompareAcceptsGoldenFileBytesExactly(t *testing.T) {
+
+
+	consumerDir := t.TempDir()
+	snapshotDir := filepath.Join(consumerDir, "snapshots")
+	mustMkdirAll(t, snapshotDir)
+	mustWriteFile(t, filepath.Join(snapshotDir, "raw_json.golden"), "{\"ok\":true}\n")
+	writeConsumerTest(t, consumerDir, fmt.Sprintf(`
+func TestRawJSONCompare(t *testing.T) {
+	autogold.ExpectFile(t, autogold.Raw("{\"ok\":true}\n"), autogold.Name("raw_json"), autogold.Dir(%q))
+}
+`, snapshotDir))
+
+	runConsumerGoTest(t, consumerDir)
+	got := mustReadFile(t, filepath.Join(snapshotDir, "raw_json.golden"))
+	if got != "{\"ok\":true}\n" {
+		t.Fatalf("golden file changed during compare\ngot:  %q\nwant: %q", got, "{\"ok\":true}\n")
+	}
+}
+
+func TestRawJSONUpdateWritesUnformattedContents(t *testing.T) {
+
+
+	consumerDir := t.TempDir()
+	snapshotDir := filepath.Join(consumerDir, "snapshots")
+	writeConsumerTest(t, consumerDir, fmt.Sprintf(`
+func TestRawJSONUpdate(t *testing.T) {
+	autogold.ExpectFile(t, autogold.Raw("{\"ok\":true}\n"), autogold.Name("raw_json"), autogold.Dir(%q))
+}
+`, snapshotDir))
+
+	runConsumerGoTest(t, consumerDir, "-update")
+	got := mustReadFile(t, filepath.Join(snapshotDir, "raw_json.golden"))
+	if got != "{\"ok\":true}\n" {
+		t.Fatalf("updated raw JSON golden mismatch\ngot:  %q\nwant: %q", got, "{\"ok\":true}\n")
+	}
+}
+
+func TestRawMultilineUpdatePreservesMissingFinalNewline(t *testing.T) {
+
+
+	consumerDir := t.TempDir()
+	snapshotDir := filepath.Join(consumerDir, "snapshots")
+	writeConsumerTest(t, consumerDir, fmt.Sprintf(`
+func TestRawMultilineUpdate(t *testing.T) {
+	autogold.ExpectFile(t, autogold.Raw("line 1\nline 2"), autogold.Name("two_lines"), autogold.Dir(%q))
+}
+`, snapshotDir))
+
+	runConsumerGoTest(t, consumerDir, "-update")
+	got := mustReadFile(t, filepath.Join(snapshotDir, "two_lines.golden"))
+	if got != "line 1\nline 2" {
+		t.Fatalf("updated multiline golden mismatch\ngot:  %q\nwant: %q", got, "line 1\nline 2")
+	}
+}
+
+func TestRawEmptySnapshotCleanupRemovesGoldenFile(t *testing.T) {
+
+
+	consumerDir := t.TempDir()
+	snapshotDir := filepath.Join(consumerDir, "snapshots")
+	mustMkdirAll(t, snapshotDir)
+	goldenPath := filepath.Join(snapshotDir, "empty_raw.golden")
+	mustWriteFile(t, goldenPath, "")
+	writeConsumerTest(t, consumerDir, fmt.Sprintf(`
+func TestRawEmptyCleanup(t *testing.T) {
+	autogold.ExpectFile(t, autogold.Raw(""), autogold.Name("empty_raw"), autogold.Dir(%q))
+}
+`, snapshotDir))
+
+	runConsumerGoTest(t, consumerDir, "-clean")
+	if _, err := os.Stat(goldenPath); !os.IsNotExist(err) {
+		t.Fatalf("empty raw golden file after cleanup\ngot exists: %v\nwant missing: true", err == nil)
+	}
+}
+
+func TestRawExpectFileRepeatedCallIsStable(t *testing.T) {
+	snapshotDir := t.TempDir()
+	goldenPath := filepath.Join(snapshotDir, "stable.golden")
+	mustWriteFile(t, goldenPath, "line 1\nline 2")
+
+	autogold.ExpectFile(t, autogold.Raw("line 1\nline 2"), autogold.Name("stable"), autogold.Dir(snapshotDir))
+	autogold.ExpectFile(t, autogold.Raw("line 1\nline 2"), autogold.Name("stable"), autogold.Dir(snapshotDir))
+
+	got := mustReadFile(t, goldenPath)
+	if got != "line 1\nline 2" {
+		t.Fatalf("repeated raw call changed golden file\ngot:  %q\nwant: %q", got, "line 1\nline 2")
+	}
+}
+
+func TestRawExpectFileDoesNotMutateCallerRawValue(t *testing.T) {
+	snapshotDir := t.TempDir()
+	mustWriteFile(t, filepath.Join(snapshotDir, "mutation.golden"), "line 1\nline 2")
+	got := autogold.Raw("line 1\nline 2")
+	before := got
+
+	autogold.ExpectFile(t, got, autogold.Name("mutation"), autogold.Dir(snapshotDir))
+
+	if got != before {
+		t.Fatalf("Raw value was mutated\ngot:  %q\nwant: %q", got, before)
+	}
+}
+
+func TestRawRenderingDoesNotReusePriorRawSnapshot(t *testing.T) {
+	consumerDir := t.TempDir()
+	snapshotDir := filepath.Join(consumerDir, "snapshots")
+	writeConsumerTest(t, consumerDir, fmt.Sprintf(`
+func TestRawNoiseThenTarget(t *testing.T) {
+	autogold.ExpectFile(t, autogold.Raw("first\n"), autogold.Name("noise_a"), autogold.Dir(%q))
+	autogold.ExpectFile(t, autogold.Raw("second"), autogold.Name("noise_b"), autogold.Dir(%q))
+	autogold.ExpectFile(t, autogold.Raw("{\"ok\":true}\n"), autogold.Name("target"), autogold.Dir(%q))
+}
+`, snapshotDir, snapshotDir, snapshotDir))
+
+	runConsumerGoTest(t, consumerDir, "-update")
+	assertFileEquals(t, filepath.Join(snapshotDir, "noise_a.golden"), "first\n")
+	assertFileEquals(t, filepath.Join(snapshotDir, "noise_b.golden"), "second")
+	assertFileEquals(t, filepath.Join(snapshotDir, "target.golden"), "{\"ok\":true}\n")
+}
+
+func TestRawUpdateDoesNotCreateUndeclaredFilesInConsumerWorkspace(t *testing.T) {
+	consumerDir := t.TempDir()
+	snapshotDir := filepath.Join(consumerDir, "snapshots")
+	writeConsumerTest(t, consumerDir, fmt.Sprintf(`
+func TestRawDeclaredOutputOnly(t *testing.T) {
+	autogold.ExpectFile(t, autogold.Raw("declared"), autogold.Name("only"), autogold.Dir(%q))
+}
+`, snapshotDir))
+
+	runConsumerGoTest(t, consumerDir, "-update")
+
+
+	got := relativeGoldenFiles(t, consumerDir)
+	want := []string{"snapshots/only.golden"}
+	if fmt.Sprint(got) != fmt.Sprint(want) {
+		t.Fatalf("consumer golden files mismatch\ngot:  %v\nwant: %v", got, want)
+	}
+	assertFileEquals(t, filepath.Join(snapshotDir, "only.golden"), "declared")
+}
+
+func writeConsumerTest(t *testing.T, dir, testBody string) {
+	t.Helper()
+	goMod := fmt.Sprintf(`module rawsnapshotconsumer
+
+go 1.24.0
+
+require github.com/hexops/autogold/v2 v2.0.0
+
+replace github.com/hexops/autogold/v2 => %s
+`, repoRoot)
+	source := `package rawsnapshotconsumer
+
+import (
+	"testing"
+
+	"github.com/hexops/autogold/v2"
+)
+` + testBody
+	mustWriteFile(t, filepath.Join(dir, "go.mod"), goMod)
+	goSum, err := os.ReadFile(filepath.Join(repoRoot, "go.sum"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	mustWriteFile(t, filepath.Join(dir, "go.sum"), string(goSum))
+	mustWriteFile(t, filepath.Join(dir, "child_test.go"), source)
+}
+
+func runConsumerGoTest(t *testing.T, dir string, args ...string) string {
+	t.Helper()
+	cmdArgs := append([]string{"test", "-count=1"}, args...)
+	cmd := exec.Command("go", cmdArgs...)
+	cmd.Dir = dir
+	cmd.Env = append(os.Environ(), "GOWORK=off", "GOFLAGS=-mod=mod")
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("go test %v failed: %v\n%s", cmdArgs, err, out)
+	}
+	return string(out)
+}
+
+func assertFileEquals(t *testing.T, path, want string) {
+	t.Helper()
+	got := mustReadFile(t, path)
+	if got != want {
+		t.Fatalf("%s mismatch\ngot:  %q\nwant: %q", path, got, want)
+	}
+}
+
+func mustMkdirAll(t *testing.T, path string) {
+	t.Helper()
+	if err := os.MkdirAll(path, 0o700); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func mustWriteFile(t *testing.T, path, contents string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(contents), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func mustReadFile(t *testing.T, path string) string {
+	t.Helper()
+	got, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(got)
+}
+
+func relativeGoldenFiles(t *testing.T, root string) []string {
+	t.Helper()
+	var files []string
+	err := filepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if d.IsDir() {
+			return nil
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		if filepath.Ext(path) == ".golden" {
+			files = append(files, filepath.ToSlash(rel))
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sort.Strings(files)
+	return files
+}
