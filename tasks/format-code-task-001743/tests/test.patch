+func TestRegisterOpenAPIVersionedServiceContentType(t *testing.T) {
+	var s spec.Swagger
+	if err := s.UnmarshalJSON(returnedSwagger); err != nil {
+		t.Fatalf("Unexpected error in unmarshalling SwaggerJSON: %v", err)
+	}
+	returnedJSON, err := json.Marshal(s)
+	if err != nil {
+		t.Fatalf("Unexpected error in preparing returnedJSON: %v", err)
+	}
+	returnedPb, err := ToProtoBinary(returnedJSON)
+	if err != nil {
+		t.Fatalf("Unexpected error in preparing returnedPb: %v", err)
+	}
+
+	mux := http.NewServeMux()
+	o, err := NewOpenAPIService(&s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = o.RegisterOpenAPIVersionedService("/openapi/v2", mux); err != nil {
+		t.Fatalf("Unexpected error: %v", err)
+	}
+	server := httptest.NewServer(mux)
+	defer server.Close()
+	client := server.Client()
+
+	const expectedJSONContentType = "application/json"
+	const deprecatedProtobufAccept = "application/com.github.proto-openapi.spec.v2@v1.0+protobuf"
+
+
+
+
+
+
+	isCanonicalProtobufCT := func(ct string) bool {
+		if strings.Contains(ct, "@") {
+			return false
+		}
+		mt, _, err := mime.ParseMediaType(ct)
+		if err != nil {
+			return false
+		}
+		return strings.HasPrefix(mt, "application/com.github.proto-openapi.spec.v2") &&
+			strings.HasSuffix(mt, "+protobuf")
+	}
+
+	doRequest := func(t *testing.T, accept string) (int, string, []byte) {
+		t.Helper()
+		req, err := http.NewRequest("GET", server.URL+"/openapi/v2", nil)
+		if err != nil {
+			t.Fatalf("Unexpected error: %v", err)
+		}
+		req.Header.Set("Accept", accept)
+		resp, err := client.Do(req)
+		if err != nil {
+			t.Fatalf("Unexpected error: %v", err)
+		}
+		defer resp.Body.Close()
+		body, err := io.ReadAll(resp.Body)
+		if err != nil {
+			t.Fatalf("Unexpected error: %v", err)
+		}
+		return resp.StatusCode, resp.Header.Get("Content-Type"), body
+	}
+
+	t.Run("json accept returns json content-type", func(t *testing.T) {
+		status, ct, body := doRequest(t, "application/json")
+		if status != 200 {
+			t.Errorf("status got=%d want=200", status)
+		}
+		if ct != expectedJSONContentType {
+			t.Errorf("Content-Type got=%q want=%q", ct, expectedJSONContentType)
+		}
+		if !reflect.DeepEqual(body, returnedJSON) {
+			t.Errorf("body mismatch")
+		}
+	})
+
+
+
+
+	var canonicalProtobufCT string
+	t.Run("deprecated @-subtype protobuf accept returns canonical (non-@) content-type", func(t *testing.T) {
+		status, ct, body := doRequest(t, deprecatedProtobufAccept)
+		if status != 200 {
+			t.Errorf("status got=%d want=200", status)
+		}
+		if !isCanonicalProtobufCT(ct) {
+			t.Errorf("returned Content-Type %q is not a valid canonical protobuf media type "+
+				"(must not contain '@', must be mime-parseable, and must match "+
+				"application/com.github.proto-openapi.spec.v2*+protobuf)", ct)
+		}
+		if !reflect.DeepEqual(body, returnedPb) {
+			t.Errorf("body mismatch")
+		}
+		canonicalProtobufCT = ct
+	})
+
+	t.Run("new canonical protobuf accept is served and returns same canonical content-type", func(t *testing.T) {
+		if canonicalProtobufCT == "" {
+			t.Skip("could not determine canonical protobuf Content-Type from previous subtest")
+		}
+		status, ct, body := doRequest(t, canonicalProtobufCT)
+		if status != 200 {
+			t.Errorf("Accept %q: status got=%d want=200", canonicalProtobufCT, status)
+		}
+		if ct != canonicalProtobufCT {
+			t.Errorf("Accept %q: Content-Type got=%q want=%q", canonicalProtobufCT, ct, canonicalProtobufCT)
+		}
+		if !reflect.DeepEqual(body, returnedPb) {
+			t.Errorf("Accept %q: body mismatch", canonicalProtobufCT)
+		}
+	})
+
+	t.Run("wildcard accept returns json content-type", func(t *testing.T) {
+		status, ct, body := doRequest(t, "*/*")
+		if status != 200 {
+			t.Errorf("status got=%d want=200", status)
+		}
+		if ct != expectedJSONContentType {
+			t.Errorf("Content-Type got=%q want=%q", ct, expectedJSONContentType)
+		}
+		if !reflect.DeepEqual(body, returnedJSON) {
+			t.Errorf("body mismatch")
+		}
+	})
+}
