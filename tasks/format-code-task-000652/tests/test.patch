+import unittest
+
+import numpy
+
+import chainer
+from chainer import functions
+
+
+class TestSoftmaxCrossEntropyEmptyInputCPU(unittest.TestCase):
+
+
+
+
+
+
+    def test_forward_3d_reduce_mean_returns_scalar_zero(self):
+        x = numpy.zeros((0, 2, 2), dtype=numpy.float32)
+        t = numpy.zeros((0, 2), dtype=numpy.int32)
+        loss = functions.softmax_cross_entropy(x, t)
+        self.assertEqual(loss.data.shape, ())
+        self.assertEqual(loss.data.dtype, numpy.float32)
+
+        self.assertTrue(numpy.isfinite(loss.data))
+        self.assertEqual(float(loss.data), 0.0)
+
+    def test_forward_3d_reduce_no_returns_empty_array(self):
+        x = numpy.zeros((0, 2, 2), dtype=numpy.float32)
+        t = numpy.zeros((0, 2), dtype=numpy.int32)
+        loss = functions.softmax_cross_entropy(x, t, reduce='no')
+        self.assertEqual(loss.data.shape, t.shape)
+        self.assertEqual(loss.data.dtype, numpy.float32)
+        self.assertEqual(loss.data.size, 0)
+
+    def test_forward_2d_reduce_mean_returns_scalar_zero(self):
+        x = numpy.zeros((0, 5), dtype=numpy.float32)
+        t = numpy.zeros((0,), dtype=numpy.int32)
+        loss = functions.softmax_cross_entropy(x, t)
+        self.assertEqual(loss.data.shape, ())
+        self.assertEqual(loss.data.dtype, numpy.float32)
+        self.assertTrue(numpy.isfinite(loss.data))
+        self.assertEqual(float(loss.data), 0.0)
+
+    def test_backward_3d_does_not_raise_and_grad_matches_x_shape(self):
+
+
+
+        x = chainer.Variable(numpy.zeros((0, 2, 2), dtype=numpy.float32))
+        t = numpy.zeros((0, 2), dtype=numpy.int32)
+        loss = functions.softmax_cross_entropy(x, t)
+        loss.backward()
+        self.assertIsNotNone(x.grad)
+        self.assertEqual(x.grad.shape, (0, 2, 2))
+        self.assertEqual(x.grad.dtype, numpy.float32)
+        self.assertEqual(x.grad.size, 0)
+
+    def test_backward_2d_does_not_raise_and_grad_matches_x_shape(self):
+        x = chainer.Variable(numpy.zeros((0, 5), dtype=numpy.float32))
+        t = numpy.zeros((0,), dtype=numpy.int32)
+        loss = functions.softmax_cross_entropy(x, t)
+        loss.backward()
+        self.assertIsNotNone(x.grad)
+        self.assertEqual(x.grad.shape, (0, 5))
+        self.assertEqual(x.grad.dtype, numpy.float32)
+
+    def test_backward_3d_reduce_no(self):
+        x = chainer.Variable(numpy.zeros((0, 2, 2), dtype=numpy.float32))
+        t = numpy.zeros((0, 2), dtype=numpy.int32)
+        loss = functions.softmax_cross_entropy(x, t, reduce='no')
+
+        loss.grad = numpy.zeros(loss.data.shape, dtype=loss.data.dtype)
+        loss.backward()
+        self.assertEqual(x.grad.shape, (0, 2, 2))
+        self.assertEqual(x.grad.dtype, numpy.float32)
+
+
+if __name__ == '__main__':
+    unittest.main()
