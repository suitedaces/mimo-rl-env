diff --git a/tests/linter/rules/variables/unused_variable/nested_loops.robot b/tests/linter/rules/variables/unused_variable/nested_loops.robot
new file mode 100644
index 0000000..2c12e43
--- /dev/null
+++ b/tests/linter/rules/variables/unused_variable/nested_loops.robot
@@ -0,0 +1,70 @@
+*** Keywords ***
+Reproduction From Issue
+    [Arguments]    ${initial_token}
+    ...    ${retries}=5
+    VAR    ${continuation_token}    ${initial_token}
+    FOR    ${i}    IN RANGE    ${{ int($retries)+1 }}
+        ${response} =    Get Events    ${continuation_token}
+        FOR    ${_}    IN    @{response}[events]
+            No Operation
+        END
+        IF    $i < int($retries)
+            VAR    ${continuation_token}    ${response}[continuationToken]
+        END
+    END
+
+Nested For With Outer Var Used After Inner
+    FOR    ${i}    IN RANGE    5
+        Log    ${i}
+        ${value}    Set Variable    1
+        FOR    ${j}    IN RANGE    3
+            Log    ${j}
+        END
+        Log    ${value}
+    END
+
+Nested For With Outer Var Used In Inner Only
+    FOR    ${i}    IN RANGE    5
+        Log    ${i}
+        ${value}    Set Variable    1
+        FOR    ${j}    IN RANGE    5
+            Log    ${value}    ${j}
+        END
+    END
+
+Nested For With Unused In Inner Loop
+    FOR    ${i}    IN RANGE    5
+        Log    ${i}
+        FOR    ${j}    IN RANGE    5
+            Log    ${j}
+            ${truly_unused}    Set Variable    1
+        END
+    END
+
+While In For With Outer Used
+    FOR    ${i}    IN RANGE    5
+        Log    ${i}
+        ${state}    Set Variable    init
+        WHILE    $i < 10    limit=5
+            Log    ${state}
+        END
+    END
+
+For In While With Outer Used
+    ${counter}    Set Variable    1
+    WHILE    ${counter} < 10
+        ${value}    Set Variable    inner
+        FOR    ${j}    IN RANGE    3
+            Log    ${value}    ${j}
+        END
+        ${counter}    Evaluate    ${counter} + 1
+    END
+
+Inner Uses Variable Assigned Later In Outer
+    FOR    ${i}    IN RANGE    5
+        Log    ${i}
+        FOR    ${j}    IN RANGE    3
+            Log    ${j}    ${late_var}
+        END
+        ${late_var}    Set Variable    new
+    END
