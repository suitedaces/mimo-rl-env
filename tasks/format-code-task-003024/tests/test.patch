diff --git a/usercase-test-coderl/runtime_registration.test.js b/usercase-test-coderl/runtime_registration.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/runtime_registration.test.js
@@ -0,0 +1,133 @@
+import expect from 'expect';
+import path from 'path';
+
+const srcRoot = path.resolve(__dirname, '..', 'src');
+
+function freshPublicApi() {
+  Object.keys(require.cache).forEach((filename) => {
+    if (filename.indexOf(srcRoot) === 0) {
+      delete require.cache[filename];
+    }
+  });
+
+  const mod = require('../src');
+  return mod.default || mod;
+}
+
+describe('usercase runtime validator registration', () => {
+  it('adds a named validator factory to the same exported object', () => {
+
+
+    const V = freshPublicApi();
+
+
+    expect(typeof V.alwaysValid).toBe('undefined');
+
+    const registrationResult = V.register('alwaysValid', () => true);
+
+    expect(registrationResult).toBe(undefined);
+
+    expect(typeof V.alwaysValid).toBe('function');
+    expect(V.alwaysValid()('anything')).toBe(true);
+  });
+
+  it('forwards the validated value before factory arguments', () => {
+
+
+    const V = freshPublicApi();
+
+    expect(V.register('minLength', (value, min, message) => value.length >= min || message || 'too short')).toBe(undefined);
+    expect(typeof V.minLength).toBe('function');
+    expect(V.minLength(3)('abcd')).toBe(true);
+    expect(V.minLength(3)('ab')).toBe('too short');
+    expect(V.minLength(3, 'need three')('ab')).toBe('need three');
+    expect(V.minLength(3, 'need three')('abcd')).toBe(true);
+  });
+
+  it('uses the same message wrapper convention as built-in validators', () => {
+
+
+    const V = freshPublicApi();
+
+    expect(V.register('isFoo', (value, message) => value === 'foo' || message || 'not foo')).toBe(undefined);
+    expect(V.isFoo()('foo')).toBe(true);
+    expect(V.isFoo()('bar')).toBe('not foo');
+    expect(V.message(V.isFoo(), 'custom failure')('bar')).toBe('custom failure');
+  });
+
+  it('rejects replacing an existing built-in validator by default', () => {
+
+
+    const V = freshPublicApi();
+    let caught;
+
+    try {
+      V.register('email', () => true);
+    } catch (err) {
+      caught = err;
+    }
+
+
+    expect(caught instanceof Error).toBe(true);
+    expect(caught.message.indexOf('Validator with this name already exists!')).toBe(0);
+
+    expect(V.email()('not-an-email')).toNotBe(true);
+  });
+
+  it('intentionally replaces a custom validator when force is true', () => {
+
+
+    const V = freshPublicApi();
+
+    expect(V.register('customRule', () => true)).toBe(undefined);
+    expect(V.customRule()('x')).toBe(true);
+    expect(V.register('customRule', () => false, true)).toBe(undefined);
+
+    expect(V.customRule()('x')).toBe(false);
+  });
+
+  it('adds registered validators to the same public API object', () => {
+
+
+    const V = freshPublicApi();
+    const sameObject = V;
+
+    expect(V.register('sameObjectRule', () => true)).toBe(undefined);
+
+
+    expect(typeof sameObject.sameObjectRule).toBe('function');
+    expect(sameObject.sameObjectRule()('x')).toBe(true);
+  });
+
+  it('allows repeated forced replacement of the same name', () => {
+
+
+    const V = freshPublicApi();
+
+    expect(V.register('replaceAgain', () => true)).toBe(undefined);
+    expect(V.replaceAgain()('x')).toBe(true);
+    expect(V.register('replaceAgain', () => false, true)).toBe(undefined);
+    expect(V.replaceAgain()('x')).toBe(false);
+    expect(V.register('replaceAgain', () => true, true)).toBe(undefined);
+
+    expect(V.replaceAgain()('x')).toBe(true);
+  });
+
+  it('keeps using the latest forced replacement across many cycles', () => {
+
+
+    const V = freshPublicApi();
+
+
+    expect(V.register('boundedRule', () => true)).toBe(undefined);
+    expect(V.boundedRule()('x')).toBe(true);
+
+    for (let i = 0; i < 150; i += 1) {
+      V.register('boundedRule', () => i === 149, true);
+      V.boundedRule()('x');
+    }
+
+
+    expect(V.boundedRule()('x')).toBe(true);
+  });
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+if [ ! -x ./node_modules/.bin/mocha ]; then
+  echo "Missing local mocha binary at ./node_modules/.bin/mocha; dependencies must be preinstalled in the image." >&2
+  exit 1
+fi
+
+node - <<'NODE'
+const required = [
+  'babel-register',
+  'expect',
+  'babel-plugin-transform-es2015-modules-commonjs',
+  'babel-plugin-transform-object-rest-spread'
+];
+
+for (const name of required) {
+  require.resolve(name);
+}
+NODE
+
+exec env BABEL_ENV=commonjs ./node_modules/.bin/mocha \
+  --compilers js:babel-register \
+  /workspace/repo/usercase-test-coderl/runtime_registration.test.js \
+  --reporter spec
