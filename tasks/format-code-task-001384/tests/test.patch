index 00000000000..bf06f14ffc2
--- /dev/null
+++ b/src/unittests/fma_abstract.spec.ts
@@ -0,0 +1,105 @@
+export const description = `
+Tests for AbstractFloat fma support.
+
+Verifies two user-observable changes that together implement the abstract-float
+fma execution test:
+  1. FP.abstract.fmaInterval(x, y, z) is implemented (no longer throws
+     "is not yet implemented for 'abstract'").
+  2. The fma.spec.ts case cache contains an 'abstract' builder that
+     produces a non-empty CaseList.
+`;
+
+import { makeTestGroup } from '../common/framework/test_group.js';
+import { objectEquals } from '../common/util/util.js';
+import { d as fmaCases } from '../webgpu/shader/execution/expression/call/builtin/fma.spec.js';
+import { FP } from '../webgpu/util/floating_point.js';
+
+import { UnitTest } from './unit_test.js';
+
+export const g = makeTestGroup(UnitTest);
+
+interface FmaCase {
+  input: [number, number, number];
+  expected: number | [number, number];
+}
+
+g.test('abstract_fmaInterval_normals')
+  .desc(`FP.abstract.fmaInterval returns exact intervals for finite normal triples`)
+  .params(u =>
+    u.expandWithParams<FmaCase>(() => [
+      { input: [0, 0, 0], expected: 0 },
+      { input: [1, 0, 0], expected: 0 },
+      { input: [0, 1, 0], expected: 0 },
+      { input: [0, 0, 1], expected: 1 },
+      { input: [1, 1, 1], expected: 2 },
+      { input: [1, 10, 100], expected: 110 },
+      { input: [10, 1, 100], expected: 110 },
+      { input: [-10, 1, 100], expected: 90 },
+      { input: [10, 1, -100], expected: -90 },
+      { input: [-10, 1, -100], expected: -110 },
+      { input: [-10, -10, -10], expected: 90 },
+    ])
+  )
+  .fn(t => {
+    const [x, y, z] = t.params.input;
+    const expected = FP.abstract.toInterval(t.params.expected);
+    const got = FP.abstract.fmaInterval(x, y, z);
+    t.expect(
+      objectEquals(expected, got),
+      `FP.abstract.fmaInterval(${x}, ${y}, ${z}) returned ${got}. Expected ${expected}`
+    );
+  });
+
+g.test('abstract_fmaInterval_infinity_unbounded')
+  .desc(`FP.abstract.fmaInterval returns the unbounded interval on infinite inputs`)
+  .fn(t => {
+    const c = FP.abstract.constants();
+    const unbounded = FP.abstract.toInterval([Number.NEGATIVE_INFINITY, Number.POSITIVE_INFINITY]);
+    const inputs: Array<[number, number, number]> = [
+      [0, 1, c.positive.infinity],
+      [0, c.positive.infinity, c.positive.infinity],
+      [c.negative.infinity, c.positive.infinity, c.positive.infinity],
+      [c.negative.infinity, c.positive.infinity, c.negative.infinity],
+    ];
+    for (const [x, y, z] of inputs) {
+      const got = FP.abstract.fmaInterval(x, y, z);
+      t.expect(
+        objectEquals(unbounded, got),
+        `FP.abstract.fmaInterval(${x}, ${y}, ${z}) returned ${got}. Expected unbounded`
+      );
+    }
+  });
+
+g.test('abstract_fmaInterval_does_not_throw')
+  .desc(`FP.abstract.fmaInterval no longer throws "unimplemented" for the abstract trait`)
+  .fn(t => {
+    let threw = false;
+    try {
+      FP.abstract.fmaInterval(2, 3, 4);
+    } catch (e) {
+      threw = true;
+    }
+    t.expect(!threw, `FP.abstract.fmaInterval(2, 3, 4) unexpectedly threw`);
+
+    const got = FP.abstract.fmaInterval(2, 3, 4);
+    const expected = FP.abstract.toInterval(10);
+    t.expect(
+      objectEquals(expected, got),
+      `FP.abstract.fmaInterval(2, 3, 4) returned ${got}. Expected ${expected} (= 2*3+4)`
+    );
+  });
+
+g.test('fma_spec_case_cache_has_abstract_builder')
+  .desc(`fma.spec.ts case cache exposes an 'abstract' builder that produces cases`)
+  .fn(async t => {
+    const built = await fmaCases.build();
+    t.expect(
+      'abstract' in built,
+      `fma case cache missing 'abstract' builder. Found keys: ${Object.keys(built).join(', ')}`
+    );
+    const abstractCases = built['abstract'];
+    t.expect(
+      Array.isArray(abstractCases) && abstractCases.length > 0,
+      `fma 'abstract' builder produced no cases (length=${abstractCases?.length})`
+    );
+  });
