@@ -0,0 +1,33 @@
+package main
+
+import (
+	"fmt"
+	"io"
+	"net/smtp"
+)
+
+func sendMailBody(body string) {
+	smtp.SendMail("smtp.example.com:25", nil, "from@example.com", []string{"to@example.com"}, []byte(body))
+}
+
+func sendMailLiteral() {
+	smtp.SendMail("smtp.example.com:25", nil, "from@example.com", []string{"to@example.com"}, []byte("static body"))
+}
+
+func streamWriteString(c *smtp.Client, body string) {
+	w, _ := c.Data()
+	io.WriteString(w, body)
+}
+
+func streamFprintf(c *smtp.Client, name string, code string) {
+	w, _ := c.Data()
+	fmt.Fprintf(w, "Hello %s, your code is %s", name, code)
+}
+
+func main() {
+	sendMailBody("a")
+	sendMailLiteral()
+	var c *smtp.Client
+	streamWriteString(c, "b")
+	streamFprintf(c, "n", "x")
+}
