+#!/usr/bin/python
+# -*- coding: utf-8 -*-
+
+
+
+
+
+
+
+
+
+
+
+import os
+import socket
+import tempfile
+from unittest import TestCase
+
+import mock
+
+import thumbor.server
+from thumbor.console import get_server_parameters
+from thumbor.server import run_server
+
+
+class FdUnixSocketTestCase(TestCase):
+    def setUp(self):
+        self._tmpdir = tempfile.mkdtemp()
+        self._sock_path = os.path.join(self._tmpdir, "thumbor.sock")
+
+    def tearDown(self):
+        try:
+            os.remove(self._sock_path)
+        except OSError:
+            pass
+        try:
+            os.rmdir(self._tmpdir)
+        except OSError:
+            pass
+
+    def _make_context(self, fd):
+        application = mock.Mock()
+        context = mock.Mock()
+        context.server = mock.Mock(fd=fd, port=1234, ip="0.0.0.0")
+        return application, context
+
+    def _pre_create_unix_socket(self, path):
+
+        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        sock.bind(path)
+        sock.close()
+
+    @mock.patch.object(thumbor.server, "HTTPServer")
+    def test_fd_unix_socket_existing_path_no_ioerror(self, server_mock):
+
+
+        self._pre_create_unix_socket(self._sock_path)
+
+        application, context = self._make_context(self._sock_path)
+        server_instance = mock.Mock()
+        server_mock.return_value = server_instance
+
+
+        run_server(application, context)
+
+
+        self.assertTrue(server_instance.add_socket.called)
+        sock = server_instance.add_socket.call_args[0][0]
+
+        self.assertIsInstance(sock, socket.socket)
+        self.assertEqual(sock.family, socket.AF_UNIX)
+        self.assertEqual(sock.getsockname(), self._sock_path)
+
+        self.assertEqual(
+            sock.getsockopt(socket.SOL_SOCKET, socket.SO_ACCEPTCONN), 1
+        )
+
+        server_instance.start.assert_called_with(1)
+
+    @mock.patch.object(thumbor.server, "HTTPServer")
+    def test_fd_unix_socket_nonexistent_path_creates_socket(self, server_mock):
+
+
+
+        self.assertFalse(os.path.exists(self._sock_path))
+
+        application, context = self._make_context(self._sock_path)
+        server_instance = mock.Mock()
+        server_mock.return_value = server_instance
+
+        run_server(application, context)
+
+        self.assertTrue(server_instance.add_socket.called)
+        sock = server_instance.add_socket.call_args[0][0]
+        self.assertIsInstance(sock, socket.socket)
+        self.assertEqual(sock.family, socket.AF_UNIX)
+        self.assertEqual(sock.getsockname(), self._sock_path)
+        self.assertEqual(
+            sock.getsockopt(socket.SOL_SOCKET, socket.SO_ACCEPTCONN), 1
+        )
+
+    @mock.patch.object(thumbor.server, "HTTPServer")
+    def test_fd_unix_socket_path_does_not_call_open(self, server_mock):
+
+
+        self._pre_create_unix_socket(self._sock_path)
+
+        application, context = self._make_context(self._sock_path)
+        server_instance = mock.Mock()
+        server_mock.return_value = server_instance
+
+
+        real_open = open
+        opened_paths = []
+
+        def tracking_open(file, *args, **kwargs):
+            opened_paths.append(file)
+            return real_open(file, *args, **kwargs)
+
+        with mock.patch("builtins.open", side_effect=tracking_open):
+            run_server(application, context)
+
+
+        self.assertNotIn(self._sock_path, opened_paths)
+
+    @mock.patch.object(thumbor.server, "HTTPServer")
+    @mock.patch.object(thumbor.server, "socket")
+    def test_fd_integer_uses_socket_fromfd(self, socket_mock, server_mock):
+
+
+        application, context = self._make_context(11)
+        server_instance = mock.Mock()
+        server_mock.return_value = server_instance
+        socket_mock.fromfd.return_value = "socket mock"
+
+        socket_mock.AF_INET = socket.AF_INET
+        socket_mock.AF_INET6 = socket.AF_INET6
+        socket_mock.SOCK_STREAM = socket.SOCK_STREAM
+
+        run_server(application, context)
+
+        socket_mock.fromfd.assert_called_with(
+            11,
+            socket.AF_INET | socket.AF_INET6,
+            socket.SOCK_STREAM,
+        )
+        server_instance.add_socket.assert_called_with("socket mock")
+        server_instance.start.assert_called_with(1)
+
+    @mock.patch.object(thumbor.server, "HTTPServer")
+    def test_fd_none_binds_port_ip(self, server_mock):
+
+        application, context = self._make_context(None)
+        server_instance = mock.Mock()
+        server_mock.return_value = server_instance
+
+        run_server(application, context)
+
+        server_instance.bind.assert_called_with(1234, "0.0.0.0")
+        server_instance.start.assert_called_with(1)
+
+        self.assertFalse(server_instance.add_socket.called)
+
+    @mock.patch.object(thumbor.server, "HTTPServer")
+    def test_fd_unix_socket_string_numeric_uses_fromfd(self, server_mock):
+
+
+
+        application, context = self._make_context("11")
+        server_instance = mock.Mock()
+        server_mock.return_value = server_instance
+
+
+        with mock.patch.object(thumbor.server.socket, "fromfd") as fromfd_mock:
+            fromfd_mock.return_value = "fromfd sock"
+            run_server(application, context)
+
+            self.assertTrue(fromfd_mock.called)
+            args = fromfd_mock.call_args[0]
+            self.assertEqual(args[0], 11)
+
+            server_instance.add_socket.assert_called_with("fromfd sock")
