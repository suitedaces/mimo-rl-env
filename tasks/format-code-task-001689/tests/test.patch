+    @pytest.mark.skipif(
+        backend.backend() != "torch",
+        reason="Test is only applicable to the torch backend.",
+    )
+    def test_convert_to_tensor_torch_meta_device(self):
+        import torch
+
+        with torch.device("meta"):
+            x = torch.randn(5)
+        self.assertTrue(x.is_meta)
+
+        y = ops.convert_to_tensor(x)
+        self.assertTrue(ops.is_tensor(y))
+        self.assertFalse(y.is_meta)
+        self.assertNotEqual(str(y.device), "meta")
+
+    @pytest.mark.skipif(
+        backend.backend() != "torch",
+        reason="Test is only applicable to the torch backend.",
+    )
+    def test_convert_to_tensor_torch_meta_device_preserves_shape(self):
+        import torch
+
+        with torch.device("meta"):
+            x = torch.randn(3, 4)
+        y = ops.convert_to_tensor(x)
+        self.assertFalse(y.is_meta)
+        self.assertEqual(tuple(y.shape), (3, 4))
+
+    @pytest.mark.skipif(
+        backend.backend() != "torch",
+        reason="Test is only applicable to the torch backend.",
+    )
+    def test_convert_to_tensor_torch_meta_device_with_dtype(self):
+        import torch
+
+        with torch.device("meta"):
+            x = torch.randn(2, 3)
+        y = ops.convert_to_tensor(x, dtype="float64")
+        self.assertFalse(y.is_meta)
+        self.assertEqual(y.dtype, torch.float64)
+        self.assertEqual(tuple(y.shape), (2, 3))
+
+    @pytest.mark.skipif(
+        backend.backend() != "torch",
+        reason="Test is only applicable to the torch backend.",
+    )
+    def test_convert_to_tensor_torch_regular_tensor_unchanged(self):
+        import torch
+
+        x = torch.tensor([1.0, 2.0, 3.0])
+        y = ops.convert_to_tensor(x)
+        self.assertFalse(y.is_meta)
+        self.assertAllClose(ops.convert_to_numpy(y), np.array([1.0, 2.0, 3.0]))
+
