+func TestSelectFileInitializesSamplerMetadataAndEqualSlices(t *testing.T) {
+
+
+	currentDir := t.TempDir()
+	saveDir := t.TempDir()
+	audioPath := filepath.Join(currentDir, "Break120.wav")
+	writeSilentWAV(t, audioPath, 6.0)
+
+	m := model.NewModel(0, saveDir, false)
+	m.Files = []string{"Break120.wav"}
+	m.CurrentDir = currentDir
+	m.CurrentRow = 0
+	m.CurrentPhrase = 1
+	m.FileSelectRow = 2
+	m.CurrentTrack = 0
+
+	trackeraudio.SelectFile(m)
+
+	metadata, ok := m.FileMetadata[audioPath]
+	if !ok {
+		t.Fatalf("metadata missing for selected file %q", audioPath)
+	}
+	expectedWaveform := filepath.Join(saveDir, "waveforms", "Break120_waveform.wav")
+	if metadata.BPM != 160 || metadata.Slices != 32 || metadata.SliceType != 0 || metadata.Playthrough != 0 || metadata.SyncToBPM != 1 || metadata.WaveformFile != expectedWaveform {
+		t.Fatalf("metadata = %#v, want BPM 160 Slices 32 SliceType 0 Playthrough 0 SyncToBPM 1 WaveformFile %q", metadata, expectedWaveform)
+	}
+
+	assertEqualSlices(t, metadata.Onsets, 6.0, 32)
+
+	phrasesData := m.GetCurrentPhrasesData()
+	if got := (*phrasesData)[1][2][int(types.ColFilename)]; got != 0 {
+		t.Fatalf("selected phrase file index = %d, want 0", got)
+	}
+	if !reflect.DeepEqual(m.SamplerPhrasesFiles, []string{audioPath}) {
+		t.Fatalf("sampler phrase files = %#v, want %#v", m.SamplerPhrasesFiles, []string{audioPath})
+	}
+}
+
+func TestGetBPMReturnsSpecificErrorWhenWAVCannotBeOpened(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "missing.wav")
+
+	_, _, err := getbpm.GetBPM(path)
+
+	if err == nil {
+		t.Fatalf("GetBPM missing file err = nil, want non-nil error")
+	}
+}
+
+func TestGetBPMReferentialTransparency(t *testing.T) {
+	path := makeWAV(t, "stable.wav", 9.0)
+
+	beats1, bpm1, err1 := getbpm.GetBPM(path)
+	beats2, bpm2, err2 := getbpm.GetBPM(path)
+	if err1 != nil || err2 != nil {
+		t.Fatalf("GetBPM repeated errors = %v, %v", err1, err2)
+	}
+	if beats1 != beats2 || bpm1 != bpm2 {
+		t.Fatalf("GetBPM repeated result changed: first %.10f/%.10f second %.10f/%.10f", beats1, bpm1, beats2, bpm2)
+	}
+}
+
+func TestGetBPMDoesNotMutateCallerInput(t *testing.T) {
+	pathBytes := []byte(makeWAV(t, "immutable.wav", 3.0))
+	before := append([]byte(nil), pathBytes...)
+
+	assertTiming(t, string(pathBytes), expectedTiming{beats: 8, bpm: 160})
+	if !reflect.DeepEqual(pathBytes, before) {
+		t.Fatalf("caller input mutated: got %q want %q", string(pathBytes), string(before))
+	}
+}
+
+func TestGetBPMNoGlobalStateWithNoiseInjection(t *testing.T) {
+	target := makeWAV(t, "target.wav", 9.0)
+	noiseA := makeWAV(t, "amen_beats8_bpm172.wav", 8*60.0/172.0)
+	noiseB := makeWAV(t, "Break078.wav", 3.0)
+
+	beats1, bpm1, err := getbpm.GetBPM(target)
+	if err != nil {
+		t.Fatalf("target first call err = %v", err)
+	}
+	assertTiming(t, noiseA, expectedTiming{beats: 8, bpm: 172})
+	assertTiming(t, noiseB, expectedTiming{beats: 8, bpm: 160})
+	beats2, bpm2, err := getbpm.GetBPM(target)
+	if err != nil {
+		t.Fatalf("target second call err = %v", err)
+	}
+	if beats1 != 18 || bpm1 != 120 || beats2 != 18 || bpm2 != 120 {
+		t.Fatalf("target timing around noise = first %.10f/%.10f second %.10f/%.10f, want both 18/120", beats1, bpm1, beats2, bpm2)
+	}
+}
+
+func TestGetBPMDoesNotCreateUndeclaredFilesInWorkingDirectory(t *testing.T) {
+	workDir := t.TempDir()
+	path := filepath.Join(workDir, "pure.wav")
+	writeSilentWAV(t, path, 3.0)
+
+	before := directoryEntries(t, workDir)
+	originalWD, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("getwd: %v", err)
+	}
+	if err := os.Chdir(workDir); err != nil {
+		t.Fatalf("chdir: %v", err)
+	}
+	defer os.Chdir(originalWD)
+
+	assertTiming(t, path, expectedTiming{beats: 8, bpm: 160})
+	after := directoryEntries(t, workDir)
+	if !reflect.DeepEqual(before, after) {
+		t.Fatalf("working directory entries changed: before %#v after %#v", before, after)
+	}
+}
+
+func directoryEntries(t *testing.T, dir string) []string {
+	t.Helper()
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatalf("readdir: %v", err)
+	}
+	names := make([]string, len(entries))
+	for i, entry := range entries {
+		names[i] = entry.Name()
+	}
+	return names
+}
