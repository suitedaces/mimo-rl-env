diff --git a/test/cliques.jl b/test/cliques.jl
new file mode 100644
index 000000000..a4e0e9bac
--- /dev/null
+++ b/test/cliques.jl
@@ -0,0 +1,46 @@
+
+
+
+
+
+
+
+function setofsets(array_of_arrays)
+    Set(map(Set, array_of_arrays))
+end
+
+function test_cliques(graph, expected)
+
+    setofsets(maximal_cliques(graph)) == setofsets(expected)
+end
+
+g = Graph(3)
+add_edge!(g, 1, 2)
+@test test_cliques(g, Array[[1,2], [3]])
+add_edge!(g, 2, 3)
+@test test_cliques(g, Array[[1,2], [2,3]])
+
+
+h = Graph(6)
+add_edge!(h, 1, 2)
+add_edge!(h, 1, 3)
+add_edge!(h, 1, 4)
+add_edge!(h, 2, 5)
+add_edge!(h, 2, 6)
+add_edge!(h, 3, 4)
+add_edge!(h, 3, 6)
+add_edge!(h, 5, 6)
+
+@test maximal_cliques(h) != []
+
+
+
+h = Graph(7)
+add_edge!(h,1,3)
+add_edge!(h,2,6)
+add_edge!(h,3,5)
+add_edge!(h,3,6)
+add_edge!(h,4,5)
+add_edge!(h,4,7)
+add_edge!(h,5,7)
+@test test_cliques(h, Array[[7,4,5], [2,6], [3,5], [3,6], [3,1]])
