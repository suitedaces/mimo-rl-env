+      tests/model_zoo/test_model_zoo.py::test_googlenet_default_forward_current_mxnet \
+      tests/model_zoo/test_model_zoo.py::test_googlenet_custom_classes_forward_shape \
+      tests/model_zoo/test_model_zoo.py::test_googlenet_public_surface_imports \
