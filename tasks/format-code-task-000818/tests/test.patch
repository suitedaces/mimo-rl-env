     _test_model_list(model_list, ctx, x)
 
 
+def test_get_model_googlenet_registered():
+    from gluoncv.model_zoo import GoogLeNet, get_model
+
+    net = get_model('googlenet', pretrained=False)
+    assert isinstance(net, GoogLeNet)
+
+
+def test_googlenet_default_forward_current_mxnet():
+    import mxnet as mx
+    from gluoncv.model_zoo.googlenet import googlenet
+
+    ctx = mx.cpu()
+    net = googlenet(pretrained=False)
+    net.initialize(ctx=ctx)
+
+    x_one = mx.np.zeros((1, 3, 224, 224), ctx=ctx)
+    y_one = net(x_one)
+    assert tuple(y_one.shape) == (1, 1000)
+
+    x_two = mx.np.zeros((2, 3, 224, 224), ctx=ctx)
+    y_two = net(x_two)
+    assert tuple(y_two.shape) == (2, 1000)
+
+
+def test_googlenet_custom_classes_forward_shape():
+    import mxnet as mx
+    from gluoncv.model_zoo.googlenet import googlenet
+
+    ctx = mx.cpu()
+    net = googlenet(classes=17, pretrained=False)
+    net.initialize(ctx=ctx)
+
+    x = mx.np.zeros((1, 3, 224, 224), ctx=ctx)
+    y = net(x)
+    assert tuple(y.shape) == (1, 17)
+
+
+def test_googlenet_public_surface_imports():
+    from gluoncv.model_zoo import GoogLeNet
+    from gluoncv.model_zoo.googlenet import googlenet
+
+    assert isinstance(GoogLeNet(), GoogLeNet)
+    assert isinstance(googlenet(pretrained=False), GoogLeNet)
+
+
