+++ b/tests/test_url_path_preservation.py
@@ -0,0 +1,179 @@
+
+
+
+
+
+
+
+
+import json
+
+import pytest
+from aioresponses import aioresponses
+
+from ansible_rulebook.exception import (
+    ControllerApiException,
+    JobTemplateNotFoundException,
+)
+from ansible_rulebook.job_template_runner import JobTemplateRunner
+
+NO_RESULTS_PAGE = json.dumps(
+    dict(count=0, next=None, previous=None, results=[])
+)
+
+
+def _make_runner(host: str) -> JobTemplateRunner:
+    runner = JobTemplateRunner()
+    runner.host = host
+    runner.token = "DUMMY"
+    runner.refresh_delay = 0.05
+    return runner
+
+
+@pytest.mark.asyncio
+async def test_get_config_relative_path_with_trailing_slash():
+
+    runner = _make_runner("http://awx-demo-service.awx/awx/")
+    try:
+        with aioresponses() as m:
+            m.get(
+                "http://awx-demo-service.awx/awx/api/v2/config/",
+                status=200,
+                body=json.dumps({"version": "23.6.0"}),
+            )
+            data = await runner.get_config()
+            assert data["version"] == "23.6.0"
+    finally:
+        await runner.close_session()
+
+
+@pytest.mark.asyncio
+async def test_get_config_relative_path_no_trailing_slash():
+
+    runner = _make_runner("http://awx-demo-service/awx")
+    try:
+        with aioresponses() as m:
+            m.get(
+                "http://awx-demo-service/awx/api/v2/config/",
+                status=200,
+                body=json.dumps({"version": "23.6.0"}),
+            )
+            data = await runner.get_config()
+            assert data["version"] == "23.6.0"
+    finally:
+        await runner.close_session()
+
+
+@pytest.mark.asyncio
+async def test_get_config_no_relative_path_with_trailing_slash():
+
+    runner = _make_runner("http://example.com/")
+    try:
+        with aioresponses() as m:
+            m.get(
+                "http://example.com/api/v2/config/",
+                status=200,
+                body=json.dumps({"version": "1.0"}),
+            )
+            data = await runner.get_config()
+            assert data["version"] == "1.0"
+    finally:
+        await runner.close_session()
+
+
+@pytest.mark.asyncio
+async def test_get_config_no_relative_path_no_trailing_slash():
+
+    runner = _make_runner("http://example.com")
+    try:
+        with aioresponses() as m:
+            m.get(
+                "http://example.com/api/v2/config/",
+                status=200,
+                body=json.dumps({"version": "1.0"}),
+            )
+            data = await runner.get_config()
+            assert data["version"] == "1.0"
+    finally:
+        await runner.close_session()
+
+
+@pytest.mark.asyncio
+async def test_get_config_does_not_use_buggy_no_prefix_url():
+
+
+
+
+
+
+
+    runner = _make_runner("http://awx-demo-service.awx/awx/")
+    try:
+        with aioresponses() as m:
+            m.get(
+                "http://awx-demo-service.awx/api/v2/config/",
+                status=200,
+                body=json.dumps({"version": "WRONG"}),
+            )
+            with pytest.raises(ControllerApiException):
+                await runner.get_config()
+    finally:
+        await runner.close_session()
+
+
+@pytest.mark.asyncio
+async def test_unified_template_slug_preserves_relative_path():
+
+    runner = _make_runner("http://awx-demo-service.awx/awx/")
+    try:
+        with aioresponses() as m:
+            m.get(
+                "http://awx-demo-service.awx/awx/api/v2/unified_job_templates/"
+                "?name=JT1",
+                status=200,
+                body=NO_RESULTS_PAGE,
+            )
+            with pytest.raises(JobTemplateNotFoundException):
+                await runner.run_job_template("JT1", "Default", {})
+    finally:
+        await runner.close_session()
+
+
+@pytest.mark.asyncio
+async def test_unified_template_slug_preserves_relative_path_no_trailing_slash():
+
+
+    runner = _make_runner("http://awx-demo-service/awx")
+    try:
+        with aioresponses() as m:
+            m.get(
+                "http://awx-demo-service/awx/api/v2/unified_job_templates/"
+                "?name=JT1",
+                status=200,
+                body=NO_RESULTS_PAGE,
+            )
+            with pytest.raises(JobTemplateNotFoundException):
+                await runner.run_job_template("JT1", "Default", {})
+    finally:
+        await runner.close_session()
+
+
+@pytest.mark.asyncio
+async def test_unified_template_slug_does_not_use_buggy_no_prefix_url():
+
+    runner = _make_runner("http://awx-demo-service.awx/awx/")
+    try:
+        with aioresponses() as m:
+
+            m.get(
+                "http://awx-demo-service.awx/api/v2/unified_job_templates/"
+                "?name=JT1",
+                status=200,
+                body=NO_RESULTS_PAGE,
+            )
+
+
+            with pytest.raises(ControllerApiException):
+                await runner.run_job_template("JT1", "Default", {})
+    finally:
+        await runner.close_session()
