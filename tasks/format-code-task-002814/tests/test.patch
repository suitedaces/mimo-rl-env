diff --git a/lite2/provider/http/http_test.go b/lite2/provider/http/http_test.go
index 73706434b..b1a0bc569 100644
--- a/lite2/provider/http/http_test.go
+++ b/lite2/provider/http/http_test.go
@@ -57,3 +57,60 @@ func TestProvider(t *testing.T) {
 	assert.Nil(t, err, "%+v", err)
 	assert.Equal(t, lower, sh.Height)
 }
+
+
+
+
+func TestNewProvider_NoSchemeDefaultsToHTTP(t *testing.T) {
+	p, err := litehttp.New("test-chain", "192.168.0.1:26657")
+	require.NoError(t, err)
+	require.NotNil(t, p)
+
+	ssc, ok := p.(litehttp.SignStatusClient)
+	require.True(t, ok, "provider must implement SignStatusClient")
+	assert.Equal(t, "http://192.168.0.1:26657", ssc.Remote())
+}
+
+
+func TestNewProvider_NoSchemeHostnameDefaultsToHTTP(t *testing.T) {
+	p, err := litehttp.New("test-chain", "example.com:26657")
+	require.NoError(t, err)
+	require.NotNil(t, p)
+
+	ssc, ok := p.(litehttp.SignStatusClient)
+	require.True(t, ok)
+	assert.Equal(t, "http://example.com:26657", ssc.Remote())
+}
+
+
+func TestNewProvider_ExplicitHTTPSchemePreserved(t *testing.T) {
+	p, err := litehttp.New("test-chain", "http://192.168.0.1:26657")
+	require.NoError(t, err)
+	require.NotNil(t, p)
+
+	ssc, ok := p.(litehttp.SignStatusClient)
+	require.True(t, ok)
+	assert.Equal(t, "http://192.168.0.1:26657", ssc.Remote())
+}
+
+
+func TestNewProvider_ExplicitHTTPSSchemePreserved(t *testing.T) {
+	p, err := litehttp.New("test-chain", "https://example.com:26657")
+	require.NoError(t, err)
+	require.NotNil(t, p)
+
+	ssc, ok := p.(litehttp.SignStatusClient)
+	require.True(t, ok)
+	assert.Equal(t, "https://example.com:26657", ssc.Remote())
+}
+
+
+func TestNewProvider_ExplicitTCPSchemePreserved(t *testing.T) {
+	p, err := litehttp.New("test-chain", "tcp://192.168.0.1:26657")
+	require.NoError(t, err)
+	require.NotNil(t, p)
+
+	ssc, ok := p.(litehttp.SignStatusClient)
+	require.True(t, ok)
+	assert.Equal(t, "tcp://192.168.0.1:26657", ssc.Remote())
+}
