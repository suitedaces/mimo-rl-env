diff --git a/usercase-test-coderl/fixtures/rgb_fifo_harness.c b/usercase-test-coderl/fixtures/rgb_fifo_harness.c
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/fixtures/rgb_fifo_harness.c
@@ -0,0 +1,134 @@
+#include "src/daemon/includes.h"
+#include "src/daemon/led.h"
+#include "src/daemon/usb.h"
+
+usbdevice keyboard[DEV_MAX];
+queued_mutex_t devmutex[DEV_MAX];
+queued_mutex_t inputmutex[DEV_MAX];
+queued_mutex_t macromutex[DEV_MAX];
+pthread_mutex_t macromutex2[DEV_MAX];
+pthread_cond_t macrovar[DEV_MAX];
+pthread_cond_t macroint[DEV_MAX];
+pthread_mutex_t interruptmutex[DEV_MAX];
+pthread_cond_t interruptcond[DEV_MAX];
+pthread_mutex_t childrenmutex[DEV_MAX];
+
+static int updatergb_calls;
+static int updatedpi_calls;
+
+void queued_mutex_lock(queued_mutex_t* mutex) { (void)mutex; }
+int queued_mutex_trylock(queued_mutex_t* mutex) { (void)mutex; return 0; }
+void queued_mutex_unlock(queued_mutex_t* mutex) { (void)mutex; }
+void queued_cond_nanosleep(pthread_cond_t *restrict cond, queued_mutex_t *restrict mutex, const uint32_t ns) {
+    (void)cond; (void)mutex; (void)ns;
+}
+int cond_nanosleep(pthread_cond_t *restrict cond, pthread_mutex_t *restrict mutex, uint32_t ns) {
+    (void)cond; (void)mutex; (void)ns; return 0;
+}
+int usb_tryreset(usbdevice* kb) { (void)kb; return 0; }
+int mknotifynode(usbdevice* kb, int notify) { (void)kb; (void)notify; return 0; }
+int rmnotifynode(usbdevice* kb, int notify) { (void)kb; (void)notify; return 0; }
+
+static int cmd_active_stub(usbdevice* kb, usbmode* mode, int n, int key, const char* parameter) {
+    (void)mode; (void)n; (void)key; (void)parameter;
+    kb->active = 1;
+    return 0;
+}
+
+static int cmd_idle_stub(usbdevice* kb, usbmode* mode, int n, int key, const char* parameter) {
+    (void)mode; (void)n; (void)key; (void)parameter;
+    kb->active = 0;
+    return 0;
+}
+
+static int updatergb_stub(usbdevice* kb, int force) {
+    (void)kb; (void)force;
+    updatergb_calls++;
+    return 0;
+}
+
+static int updatedpi_stub(usbdevice* kb, int force) {
+    (void)kb; (void)force;
+    updatedpi_calls++;
+    return 0;
+}
+
+static void setmodeindex_stub(usbdevice* kb, int index) {
+    (void)kb; (void)index;
+}
+
+static void init_device(usbdevice* kb, usbprofile* profile) {
+    memset(kb, 0, sizeof(*kb));
+    memset(profile, 0, sizeof(*profile));
+    updatergb_calls = 0;
+    updatedpi_calls = 0;
+
+    kb->profile = profile;
+    kb->features = FEAT_STD_RGB;
+    kb->vendor = V_CORSAIR;
+    kb->product = P_K70;
+    profile->currentmode = &profile->mode[0];
+
+    kb->vtable.rgb = cmd_rgb;
+    kb->vtable.active = cmd_active_stub;
+    kb->vtable.idle = cmd_idle_stub;
+    kb->vtable.setmodeindex = setmodeindex_stub;
+    kb->vtable.updatergb = updatergb_stub;
+    kb->vtable.updatedpi = updatedpi_stub;
+
+    for(int i = 0; i < N_KEYS_EXTENDED; i++) {
+        kb->keymap[i].name = NULL;
+        kb->keymap[i].led = i;
+        kb->keymap[i].scan = KEY_NONE;
+    }
+}
+
+static void print_mode(const char* label, const usbmode* mode) {
+    int red = 0, green = 0, blue = 0, nonzero = 0;
+    int rmin = 0xff, rmax = 0, gmin = 0xff, gmax = 0, bmin = 0xff, bmax = 0;
+    unsigned long sum = 0;
+    for(int i = 0; i < N_KEYS_EXTENDED; i++) {
+        red += mode->light.r[i] == 0xff;
+        green += mode->light.g[i] == 0xff;
+        blue += mode->light.b[i] == 0xff;
+        nonzero += mode->light.r[i] || mode->light.g[i] || mode->light.b[i];
+        sum += mode->light.r[i] + mode->light.g[i] + mode->light.b[i];
+        if(mode->light.r[i] < rmin) rmin = mode->light.r[i];
+        if(mode->light.r[i] > rmax) rmax = mode->light.r[i];
+        if(mode->light.g[i] < gmin) gmin = mode->light.g[i];
+        if(mode->light.g[i] > gmax) gmax = mode->light.g[i];
+        if(mode->light.b[i] < bmin) bmin = mode->light.b[i];
+        if(mode->light.b[i] > bmax) bmax = mode->light.b[i];
+    }
+
+
+    printf("%s first=%02x%02x%02x middle=%02x%02x%02x last=%02x%02x%02x total=%d rmin=%02x rmax=%02x gmin=%02x gmax=%02x bmin=%02x bmax=%02x red=%d green=%d blue=%d nonzero=%d sum=%lu\n",
+           label,
+           mode->light.r[0], mode->light.g[0], mode->light.b[0],
+           mode->light.r[N_KEYS_EXTENDED / 2], mode->light.g[N_KEYS_EXTENDED / 2], mode->light.b[N_KEYS_EXTENDED / 2],
+           mode->light.r[N_KEYS_EXTENDED - 1], mode->light.g[N_KEYS_EXTENDED - 1], mode->light.b[N_KEYS_EXTENDED - 1],
+           N_KEYS_EXTENDED, rmin, rmax, gmin, gmax, bmin, bmax,
+           red, green, blue, nonzero, sum);
+}
+
+int main(int argc, char** argv) {
+    if(argc != 2) {
+        fprintf(stderr, "usage: %s 'command line for readcmd'\n", argv[0]);
+        return 64;
+    }
+
+    usbprofile profile;
+    usbdevice* kb = &keyboard[0];
+    init_device(kb, &profile);
+
+    char line[4096];
+    snprintf(line, sizeof(line), "%s", argv[1]);
+    int ec = readcmd(kb, line);
+    int current = (int)(profile.currentmode - profile.mode) + 1;
+
+    printf("readcmd=%d active=%d currentmode=%d updatergb=%d updatedpi=%d\n",
+           ec, kb->active, current, updatergb_calls, updatedpi_calls);
+    print_mode("mode1", &profile.mode[0]);
+    print_mode("mode2", &profile.mode[1]);
+    return ec;
+}
diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,141 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+BIN="$TMP/rgb_fifo_harness"
+( cd /workspace/repo || exit 1
+    EXTRA_OBJS=()
+
+    while IFS= read -r src; do
+        case "$src" in
+            src/daemon/command.c|src/daemon/led.c) continue ;;
+        esac
+        obj="$TMP/$(basename "$src" .c).o"
+        cc -std=c11 -O2 -DNDEBUG -I/workspace/repo -I/workspace/repo/usercase-test-coderl/fixtures -pthread -c "$src" -o "$obj" || exit 1
+        EXTRA_OBJS+=("$obj")
+    done < <({ git diff --name-only --diff-filter=ACMR HEAD -- 'src/daemon/*.c'; git ls-files --others --exclude-standard 'src/daemon/*.c'; } | sort -u)
+    if ((${#EXTRA_OBJS[@]})); then
+        ar rcs "$TMP/libdaemon_extra.a" "${EXTRA_OBJS[@]}" || exit 1
+        EXTRA_LIB="$TMP/libdaemon_extra.a"
+    else
+        EXTRA_LIB=
+    fi
+    cc -std=c11 -O2 -DNDEBUG \
+        -I/workspace/repo \
+        -I/workspace/repo/usercase-test-coderl/fixtures \
+        -pthread \
+        /workspace/repo/usercase-test-coderl/fixtures/rgb_fifo_harness.c \
+        /workspace/repo/src/daemon/command.c \
+        /workspace/repo/src/daemon/led.c \
+        ${EXTRA_LIB:+"$EXTRA_LIB"} \
+        -o "$BIN" ) || { echo "FAIL: build" >&2; exit 1; }
+
+cd "$TMP" || exit 1
+
+field() {
+    local line="$1" key="$2"
+    printf '%s\n' "$line" | tr ' ' '\n' | awk -F= -v key="$key" '$1 == key { print $2; exit }'
+}
+
+mode_line() {
+    local label="$1"
+    grep "^$label " out || fail "missing $label line: $(cat out)"
+}
+
+assert_header() {
+    local label="$1" expected_mode="$2" line
+    line=$(sed -n '1p' out)
+
+    [ "$(field "$line" readcmd)" = "0" ] || fail "$label readcmd: $line"
+    [ "$(field "$line" active)" = "1" ] || fail "$label active state: $line"
+    [ "$(field "$line" currentmode)" = "$expected_mode" ] || fail "$label current mode: $line"
+}
+
+assert_uniform_mode() {
+    local label="$1" mode="$2" color="$3" line total expected_nonzero expected_sum r g b
+    line=$(mode_line "$mode")
+    total=$(field "$line" total)
+    r=$((16#${color:0:2}))
+    g=$((16#${color:2:2}))
+    b=$((16#${color:4:2}))
+    if [ "$color" = "000000" ]; then
+        expected_nonzero=0
+    else
+        expected_nonzero=$total
+    fi
+    expected_sum=$((total * (r + g + b)))
+
+
+    [ "$(field "$line" first)" = "$color" ] || fail "$label $mode first LED: $line"
+    [ "$(field "$line" middle)" = "$color" ] || fail "$label $mode middle LED: $line"
+    [ "$(field "$line" last)" = "$color" ] || fail "$label $mode last LED: $line"
+    [ "$(field "$line" rmin)" = "${color:0:2}" ] && [ "$(field "$line" rmax)" = "${color:0:2}" ] || fail "$label $mode red range: $line"
+    [ "$(field "$line" gmin)" = "${color:2:2}" ] && [ "$(field "$line" gmax)" = "${color:2:2}" ] || fail "$label $mode green range: $line"
+    [ "$(field "$line" bmin)" = "${color:4:2}" ] && [ "$(field "$line" bmax)" = "${color:4:2}" ] || fail "$label $mode blue range: $line"
+    [ "$(field "$line" nonzero)" = "$expected_nonzero" ] || fail "$label $mode nonzero count: $line"
+    [ "$(field "$line" sum)" = "$expected_sum" ] || fail "$label $mode channel sum: $line"
+}
+
+
+
+
+"$BIN" 'active rgb ff0000' >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_header F1 1
+assert_uniform_mode F1 mode1 ff0000
+assert_uniform_mode F1 mode2 000000
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+
+
+
+
+"$BIN" 'active rgb all:ff0000 rgb 000000' >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_header F2 1
+assert_uniform_mode F2 mode1 000000
+assert_uniform_mode F2 mode2 000000
+[ ! -s err ] || fail "F2 unexpected stderr: $(cat err)"
+
+
+
+
+"$BIN" 'active rgb 2468ac' >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 shorthand exit $ec; want 0"
+assert_header F3-shorthand 1
+assert_uniform_mode F3-shorthand mode1 2468ac
+assert_uniform_mode F3-shorthand mode2 000000
+[ ! -s err ] || fail "F3 shorthand unexpected stderr: $(cat err)"
+
+"$BIN" 'active rgb all:2468ac' >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 all-selector exit $ec; want 0"
+assert_header F3-all-selector 1
+assert_uniform_mode F3-all-selector mode1 2468ac
+assert_uniform_mode F3-all-selector mode2 000000
+[ ! -s err ] || fail "F3 all-selector unexpected stderr: $(cat err)"
+
+
+
+
+"$BIN" 'active rgb all:111111 mode 2 switch rgb 0000ff' >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+assert_header F4 2
+assert_uniform_mode F4 mode1 111111
+assert_uniform_mode F4 mode2 0000ff
+[ ! -s err ] || fail "F4 unexpected stderr: $(cat err)"
+
+
+
+
+"$BIN" >out 2>err; ec=$?
+
+[ "$ec" -eq 64 ] || fail "F_err exit $ec; want 64"
+[ ! -s out ] || fail "F_err unexpected stdout: $(cat out)"
+[ -s err ] || fail "F_err expected stderr"
+
+echo "PASS"
+exit 0
