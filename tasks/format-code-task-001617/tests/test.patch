+from __future__ import unicode_literals
+
+import unittest
+
+from django.conf import settings
+
+
+if not settings.configured:
+    settings.configure(
+        INSTALLED_APPS=[],
+        SECRET_KEY='codespec',
+        USE_I18N=False,
+    )
+
+import django
+django.setup()
+
+from django.db import models
+from taggit.managers import TaggableManager
+from taggit.models import TaggedItem, TaggedItemBase
+
+
+class CustomThroughModel(models.Model):
+    class Meta:
+        app_label = 'codespec'
+
+
+class DeconstructOwner(models.Model):
+    tags = TaggableManager(
+        through='codespec.DeconstructThrough',
+        related_name='owners',
+    )
+
+    class Meta:
+        app_label = 'codespec'
+
+
+class DeconstructThrough(TaggedItemBase):
+    content_object = models.ForeignKey(DeconstructOwner)
+
+    class Meta:
+        app_label = 'codespec'
+
+
+class TaggableManagerDeconstructContractTest(unittest.TestCase):
+    def test_deconstruct_keeps_custom_string_configuration(self):
+        field = TaggableManager(
+            through='catalog.TaggedProduct',
+            related_name='products_with_tags',
+            blank=True,
+            verbose_name='Labels',
+            help_text='Choose labels',
+        )
+
+        name, path, args, kwargs = field.deconstruct()
+
+        self.assertEqual(path, 'taggit.managers.TaggableManager')
+        self.assertEqual(args, [])
+        self.assertIn('through', kwargs)
+        self.assertIn('related_name', kwargs)
+        self.assertEqual(kwargs['through'], 'catalog.TaggedProduct')
+        self.assertEqual(kwargs['related_name'], 'products_with_tags')
+        self.assertTrue(kwargs['blank'])
+        self.assertEqual(kwargs['verbose_name'], 'Labels')
+        self.assertEqual(kwargs['help_text'], 'Choose labels')
+        self.assertNotIn('serialize', kwargs)
+        self.assertNotIn('null', kwargs)
+
+    def test_deconstruct_keeps_model_label_and_explicit_empty_related_name(self):
+        field = TaggableManager(through=CustomThroughModel, related_name='')
+        kwargs = field.deconstruct()[3]
+
+        self.assertIn('through', kwargs)
+        self.assertIn('related_name', kwargs)
+        self.assertEqual(kwargs['through'], 'codespec.CustomThroughModel')
+        self.assertEqual(kwargs['related_name'], '')
+
+    def test_clone_preserves_relationship_configuration(self):
+        field = TaggableManager(
+            through='catalog.TaggedProduct',
+            related_name='products_with_tags',
+            blank=True,
+            verbose_name='Labels',
+            help_text='Choose labels',
+        )
+
+        clone = field.clone()
+
+        self.assertIsNot(clone, field)
+        self.assertEqual(clone.through, 'catalog.TaggedProduct')
+        self.assertEqual(clone.rel.related_name, 'products_with_tags')
+        self.assertTrue(clone.blank)
+        self.assertEqual(clone.verbose_name, 'Labels')
+        self.assertEqual(clone.help_text, 'Choose labels')
+
+    def test_clone_preserves_class_through_reference(self):
+        field = TaggableManager(through=CustomThroughModel, related_name='items')
+        clone = field.clone()
+
+        self.assertEqual(clone.through, 'codespec.CustomThroughModel')
+        self.assertEqual(clone.rel.related_name, 'items')
+
+    def test_deconstruct_is_stable_after_lazy_through_resolution(self):
+        field = DeconstructOwner._meta.get_field('tags')
+        kwargs = field.deconstruct()[3]
+
+        self.assertIn('through', kwargs)
+        self.assertIn('related_name', kwargs)
+        self.assertEqual(kwargs['through'], 'codespec.DeconstructThrough')
+        self.assertEqual(kwargs['related_name'], 'owners')
+
+    def test_clone_is_independent_from_original_relationship_metadata(self):
+        field = TaggableManager(
+            through='catalog.TaggedProduct',
+            related_name='products_with_tags',
+        )
+        clone = field.clone()
+        clone.rel.related_name = 'other_products'
+
+        self.assertEqual(field.rel.related_name, 'products_with_tags')
+        self.assertEqual(clone.rel.related_name, 'other_products')
+
+    def test_default_manager_stays_minimal_and_uses_builtin_through_on_clone(self):
+        field = TaggableManager()
+        kwargs = field.deconstruct()[3]
+        clone = field.clone()
+
+        self.assertNotIn('through', kwargs)
+        self.assertNotIn('related_name', kwargs)
+        self.assertNotIn('blank', kwargs)
+        self.assertIs(clone.through, TaggedItem)
+        self.assertIsNone(clone.rel.related_name)
+        self.assertFalse(clone.blank)
+
+
+if __name__ == '__main__':
+    unittest.main()
