diff --git a/test/javascript/jest.test.ts b/test/javascript/jest.test.ts
index 744db538..18f2f175 100644
--- a/test/javascript/jest.test.ts
+++ b/test/javascript/jest.test.ts
@@ -216,3 +216,129 @@ test("addTestMatch() can be used to add patterns", () => {
     "bar/baz/**",
   ]);
 });
+
+function getJestTaskExec(snapshot: any, taskName: string): string {
+  const task = snapshot[".projen/tasks.json"].tasks[taskName];
+  expect(task).toBeTruthy();
+  expect(task.steps).toBeTruthy();
+  expect(task.steps.length).toBeGreaterThanOrEqual(1);
+  return task.steps[0].exec as string;
+}
+
+test("extraCliOptions appends issue example flags to jest test task", () => {
+
+  const project = new NodeProject({
+    name: "test-node-project",
+    defaultReleaseBranch: "master",
+    mergify: false,
+    projenDevDependency: false,
+    jest: true,
+    jestOptions: {
+      extraCliOptions: ["--json", "--outputFile=jest-report.json"],
+    },
+  });
+
+
+  const snapshot = synthSnapshot(project);
+  const testExec = getJestTaskExec(snapshot, "test");
+  expect(testExec).toContain("--json");
+  expect(testExec).toContain("--outputFile=jest-report.json");
+});
+
+test("extraCliOptions with a single flag is added to jest test task", () => {
+
+  const project = new NodeProject({
+    name: "test-node-project",
+    defaultReleaseBranch: "master",
+    mergify: false,
+    projenDevDependency: false,
+    jest: true,
+    jestOptions: {
+      extraCliOptions: ["--runInBand"],
+    },
+  });
+
+
+  const snapshot = synthSnapshot(project);
+  const testExec = getJestTaskExec(snapshot, "test");
+  expect(testExec).toContain("--runInBand");
+
+  expect(testExec).toContain("--passWithNoTests");
+  expect(testExec).toContain("--all");
+  expect(testExec).toContain("--updateSnapshot");
+});
+
+test("extraCliOptions default behavior leaves jest test task command unchanged", () => {
+
+  const project = new NodeProject({
+    name: "test-node-project",
+    defaultReleaseBranch: "master",
+    mergify: false,
+    projenDevDependency: false,
+    jest: true,
+  });
+
+
+  const snapshot = synthSnapshot(project);
+  const testExec = getJestTaskExec(snapshot, "test");
+  expect(testExec).toBe("jest --passWithNoTests --all --updateSnapshot");
+});
+
+test("empty extraCliOptions array leaves jest test task command unchanged", () => {
+
+  const project = new NodeProject({
+    name: "test-node-project",
+    defaultReleaseBranch: "master",
+    mergify: false,
+    projenDevDependency: false,
+    jest: true,
+    jestOptions: {
+      extraCliOptions: [],
+    },
+  });
+
+
+  const snapshot = synthSnapshot(project);
+  const testExec = getJestTaskExec(snapshot, "test");
+  expect(testExec).toBe("jest --passWithNoTests --all --updateSnapshot");
+});
+
+test("extraCliOptions does not leak into test:watch task", () => {
+
+  const project = new NodeProject({
+    name: "test-node-project",
+    defaultReleaseBranch: "master",
+    mergify: false,
+    projenDevDependency: false,
+    jest: true,
+    jestOptions: {
+      extraCliOptions: ["--json", "--outputFile=jest-report.json"],
+    },
+  });
+
+
+  const snapshot = synthSnapshot(project);
+  const watchExec = getJestTaskExec(snapshot, "test:watch");
+  expect(watchExec).not.toContain("--json");
+  expect(watchExec).not.toContain("--outputFile=jest-report.json");
+});
+
+test("extraCliOptions does not leak into test:update task", () => {
+
+  const project = new NodeProject({
+    name: "test-node-project",
+    defaultReleaseBranch: "master",
+    mergify: false,
+    projenDevDependency: false,
+    jest: true,
+    jestOptions: {
+      extraCliOptions: ["--json", "--outputFile=jest-report.json"],
+    },
+  });
+
+
+  const snapshot = synthSnapshot(project);
+  const updateExec = getJestTaskExec(snapshot, "test:update");
+  expect(updateExec).not.toContain("--json");
+  expect(updateExec).not.toContain("--outputFile=jest-report.json");
+});
