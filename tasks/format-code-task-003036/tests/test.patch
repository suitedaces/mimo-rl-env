diff --git a/usercase-test-coderl/teardown_cleanup.test.js b/usercase-test-coderl/teardown_cleanup.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/teardown_cleanup.test.js
@@ -0,0 +1,312 @@
+const fs = require('fs');
+const path = require('path');
+const { expect } = require('chai');
+const { JSDOM } = require('jsdom');
+
+
+
+
+
+
+
+
+
+
+
+
+const REPO_ROOT = path.resolve(__dirname, '..');
+
+function loadHarness() {
+  const dom = new JSDOM('<!doctype html><html><body></body></html>', {
+    url: 'http://localhost/',
+    runScripts: 'outside-only',
+    pretendToBeVisual: true
+  });
+  const window = dom.window;
+
+  window.scrollTo = function() {};
+  window.console = console;
+
+  [
+    'bower_components/angularjs/index.js',
+    'bower_components/angularjs-route/index.js',
+    'src/ngMidwayTester.js'
+  ].forEach(function(file) {
+    window.eval(fs.readFileSync(path.join(REPO_ROOT, file), 'utf8'));
+  });
+
+  return window;
+}
+
+function defineRoutedModule(window, moduleName) {
+  window.angular.module(moduleName, ['ngRoute'])
+    .run(function($rootScope) {
+      $rootScope.bootValue = 'booted';
+    })
+    .config(function($routeProvider) {
+      $routeProvider.when('/one', {
+        controller: function($scope) {
+          $scope.page = 'one';
+        },
+        template: '<p class="route-page">one</p>'
+      });
+      $routeProvider.when('/two', {
+        controller: function($scope) {
+          $scope.page = 'two';
+        },
+        template: '<p class="route-page">two</p>'
+      });
+    });
+}
+
+function bodyData(window, key) {
+  return window.angular.element(window.document.body).data(key);
+}
+
+function setBodyData(window, key, value) {
+  window.angular.element(window.document.body).data(key, value);
+}
+
+function activeTimeoutCount() {
+  if (typeof process.getActiveResourcesInfo !== 'function') {
+    return 0;
+  }
+  return process.getActiveResourcesInfo().filter(function(name) {
+    return name === 'Timeout';
+  }).length;
+}
+
+describe('ngMidwayTester destroy acceptance', function() {
+  this.timeout(4000);
+
+  it('removes the attached harness root and clears Angular body data', function() {
+
+
+    const window = loadHarness();
+    defineRoutedModule(window, 'DestroyCleanupDomMod');
+    const tester = window.ngMidwayTester('DestroyCleanupDomMod');
+
+    setBodyData(window, 'sessionMarker', 'alpha-body-data');
+
+    expect(window.document.body.children.length).to.equal(1);
+    expect(tester.rootElement()[0].parentNode === window.document.body).to.equal(true);
+
+    expect(tester.rootElement()[0].nodeType).to.equal(window.Node.ELEMENT_NODE);
+    expect(bodyData(window, 'sessionMarker')).to.equal('alpha-body-data');
+
+    tester.attach();
+    expect(window.document.body.children.length).to.equal(1);
+    expect(tester.rootElement()[0].parentNode === window.document.body).to.equal(true);
+
+    tester.destroy();
+    expect(window.document.body.children.length).to.equal(0);
+    expect(tester.rootElement()[0].parentNode).to.equal(null);
+    expect(bodyData(window, 'sessionMarker')).to.equal(undefined);
+
+    window.close();
+  });
+
+  it('drives a route session before destroy and leaves no root after cleanup', function(done) {
+
+
+    const window = loadHarness();
+    defineRoutedModule(window, 'DestroyCleanupVisitMod');
+    const tester = window.ngMidwayTester('DestroyCleanupVisitMod');
+
+
+    expect(tester.path()).to.be.a('string');
+    expect(window.document.body.children.length).to.equal(1);
+
+    tester.visit('/one', function() {
+      try {
+        expect(tester.path()).to.equal('/one');
+
+        expect(tester.rootElement().text()).to.contain('one');
+        expect(tester.viewScope().page).to.equal('one');
+
+        expect(tester.rootElement()[0].querySelector('.route-page').textContent).to.equal('one');
+        expect(window.document.body.children.length).to.equal(1);
+
+        tester.destroy();
+        expect(window.document.body.children.length).to.equal(0);
+        expect(tester.rootElement()[0].parentNode).to.equal(null);
+        window.close();
+        done();
+      } catch (error) {
+        window.close();
+        done(error);
+      }
+    });
+  });
+
+  it('cancels pending until polling when destroy runs before the condition completes', function(done) {
+
+
+    const window = loadHarness();
+    defineRoutedModule(window, 'DestroyCleanupUntilMod');
+    const tester = window.ngMidwayTester('DestroyCleanupUntilMod');
+    let callbackCount = 0;
+    let ready = false;
+
+    tester.until(function() {
+      return ready;
+    }, function() {
+      callbackCount += 1;
+    });
+    tester.destroy();
+    ready = true;
+
+    window.setTimeout(function() {
+      try {
+        expect(callbackCount).to.equal(0);
+        expect(window.document.body.children.length).to.equal(0);
+        window.close();
+        done();
+      } catch (error) {
+        window.close();
+        done(error);
+      }
+    }, 140);
+  });
+
+  it('cancels pending visit polling when destroy runs before the route callback fires', function(done) {
+
+
+    const window = loadHarness();
+    defineRoutedModule(window, 'DestroyCleanupVisitCancelMod');
+    const tester = window.ngMidwayTester('DestroyCleanupVisitCancelMod');
+    let callbackCount = 0;
+
+    tester.visit('/one', function() {
+      callbackCount += 1;
+    });
+    tester.destroy();
+
+    window.setTimeout(function() {
+      try {
+        expect(callbackCount).to.equal(0);
+        expect(window.document.body.children.length).to.equal(0);
+        window.close();
+        done();
+      } catch (error) {
+        window.close();
+        done(error);
+      }
+    }, 140);
+  });
+
+  it('keeps successive tester instances independent after one mutates location, DOM, body data, and scope state', function() {
+
+
+    const window = loadHarness();
+    defineRoutedModule(window, 'DestroyCleanupIsolationMod');
+    const a = window.ngMidwayTester('DestroyCleanupIsolationMod');
+
+    setBodyData(window, 'sessionMarker', 'alpha-body-data');
+    a.inject('$location').path('/one');
+    a.digest();
+    a.rootScope().sessionValue = 'alpha-scope-state';
+
+    expect(a.path()).to.equal('/one');
+    expect(a.rootScope().sessionValue).to.equal('alpha-scope-state');
+    expect(window.document.body.children.length).to.equal(1);
+    expect(bodyData(window, 'sessionMarker')).to.equal('alpha-body-data');
+
+    a.destroy();
+    expect(window.document.body.children.length).to.equal(0);
+    expect(bodyData(window, 'sessionMarker')).to.equal(undefined);
+
+    const b = window.ngMidwayTester('DestroyCleanupIsolationMod');
+
+    expect(b.path()).to.not.equal('/one');
+    expect(b.rootScope().sessionValue).to.equal(undefined);
+    expect(b.rootScope().bootValue).to.equal('booted');
+
+    b.inject('$location').path('/two');
+    b.digest();
+    expect(b.path()).to.equal('/two');
+    expect(b.rootScope().sessionValue).to.equal(undefined);
+    expect(window.document.body.children.length).to.equal(1);
+    expect(bodyData(window, 'sessionMarker')).to.equal(undefined);
+    expect(b.rootElement()[0].parentNode === window.document.body).to.equal(true);
+
+    b.destroy();
+    window.close();
+  });
+
+  it('cleans up after a direct destroy call', function() {
+
+
+    const window = loadHarness();
+    defineRoutedModule(window, 'DestroyCleanupIdempotentMod');
+    const tester = window.ngMidwayTester('DestroyCleanupIdempotentMod');
+
+    setBodyData(window, 'sessionMarker', 'alpha-body-data');
+
+    tester.destroy();
+
+    expect(window.document.body.children.length).to.equal(0);
+    expect(tester.rootElement()[0].parentNode).to.equal(null);
+    expect(bodyData(window, 'sessionMarker')).to.equal(undefined);
+
+    window.close();
+  });
+
+  it('exposes a public destroy method on created tester instances', function() {
+
+
+    const window = loadHarness();
+    defineRoutedModule(window, 'DestroyCleanupPublicMethodMod');
+
+    const tester = window.ngMidwayTester('DestroyCleanupPublicMethodMod');
+
+    expect(tester.destroy).to.be.a('function');
+    tester.destroy();
+
+    window.close();
+  });
+
+  it('keeps DOM roots and pending polling callbacks bounded over 100 construct-use-destroy cycles', function(done) {
+
+
+    const window = loadHarness();
+    defineRoutedModule(window, 'DestroyCleanupLeakFloorMod');
+    let callbackCount = 0;
+    let ready = false;
+    const timeoutBaseline = activeTimeoutCount();
+
+    expect(window.document.body.children.length).to.equal(0);
+
+    expect(activeTimeoutCount()).to.be.at.most(timeoutBaseline + 1);
+
+    for (let index = 0; index < 100; index += 1) {
+      const tester = window.ngMidwayTester('DestroyCleanupLeakFloorMod');
+      tester.until(function() {
+        return ready;
+      }, function() {
+        callbackCount += 1;
+      });
+      tester.destroy();
+    }
+
+    expect(window.document.body.children.length).to.equal(0);
+    expect(callbackCount).to.equal(0);
+
+    expect(activeTimeoutCount()).to.be.at.most(timeoutBaseline + 1);
+
+    ready = true;
+    window.setTimeout(function() {
+      try {
+        expect(window.document.body.children.length).to.equal(0);
+        expect(callbackCount).to.equal(0);
+
+        expect(activeTimeoutCount()).to.be.at.most(timeoutBaseline + 2);
+        window.close();
+        done();
+      } catch (error) {
+        window.close();
+        done(error);
+      }
+    }, 140);
+  });
+});
