+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+DEPS_DIR=/opt/coderl/npmdeps
+if [ ! -x "$DEPS_DIR/node_modules/.bin/mocha" ]; then
+  echo "coderl offline deps missing at $DEPS_DIR" >&2
+  exit 127
+fi
+
+export NODE_PATH="$DEPS_DIR/node_modules"
+exec "$DEPS_DIR/node_modules/.bin/mocha" --no-config --no-package /workspace/repo/usercase-test-coderl/teardown_cleanup.test.js --reporter spec --exit
