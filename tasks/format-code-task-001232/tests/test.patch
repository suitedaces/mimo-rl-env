diff --git a/gaphor/core/styling/tests/test_important.py b/gaphor/core/styling/tests/test_important.py
new file mode 100644
index 000000000..fa4aa5630
--- /dev/null
+++ b/gaphor/core/styling/tests/test_important.py
@@ -0,0 +1,133 @@
+
+
+from gaphor.core.styling import CompiledStyleSheet, parse_style_sheet
+from gaphor.core.styling.tests.test_selector import Node
+
+
+def test_important_beats_higher_specificity():
+
+    css = """
+    * { color: #ff0000 !important }
+    mytype { color: #00ff00 }
+    """
+    props = CompiledStyleSheet(css).match(Node("mytype"))
+
+    assert props.get("color") == (1, 0, 0, 1)
+
+
+def test_important_beats_later_rule():
+
+
+    css = """
+    mytype { color: #ff0000 !important }
+    mytype { color: #00ff00 }
+    """
+    props = CompiledStyleSheet(css).match(Node("mytype"))
+
+    assert props.get("color") == (1, 0, 0, 1)
+
+
+def test_non_important_loses_to_important_regardless_of_order_and_specificity():
+
+    css = """
+    mytype { color: #ff0000 !important }
+    mytype[subject] { color: #00ff00 }
+    """
+    props = CompiledStyleSheet(css).match(
+        Node("mytype", attributes={"subject": "x"})
+    )
+
+    assert props.get("color") == (1, 0, 0, 1)
+
+
+def test_important_vs_important_uses_specificity():
+
+    css = """
+    * { color: #ff0000 !important }
+    mytype { color: #00ff00 !important }
+    """
+    props = CompiledStyleSheet(css).match(Node("mytype"))
+
+    assert props.get("color") == (0, 1, 0, 1)
+
+
+def test_important_vs_important_uses_source_order_on_tie():
+
+    css = """
+    mytype { color: #ff0000 !important }
+    mytype { color: #00ff00 !important }
+    """
+    props = CompiledStyleSheet(css).match(Node("mytype"))
+
+    assert props.get("color") == (0, 1, 0, 1)
+
+
+def test_importance_is_per_declaration_not_per_rule():
+
+
+    css = """
+    * {
+        color: #ff0000 !important;
+        font-size: 10;
+    }
+    mytype {
+        color: #00ff00;
+        font-size: 20;
+    }
+    """
+    props = CompiledStyleSheet(css).match(Node("mytype"))
+
+    assert props.get("color") == (1, 0, 0, 1)
+    assert props.get("font-size") == 20
+
+
+def test_important_does_not_corrupt_value():
+
+    css = """
+    mytype {
+        color: #00ff00 !important;
+        font-size: 42 !important;
+        font-family: 'sans' !important;
+    }
+    """
+    props = CompiledStyleSheet(css).match(Node("mytype"))
+
+    assert props.get("color") == (0, 1, 0, 1)
+    assert props.get("font-size") == 42
+    assert props.get("font-family") == "sans"
+
+
+def test_important_is_case_insensitive():
+    css = """
+    * { color: #ff0000 !IMPORTANT }
+    mytype { color: #00ff00 }
+    """
+    props = CompiledStyleSheet(css).match(Node("mytype"))
+
+    assert props.get("color") == (1, 0, 0, 1)
+
+
+def test_cascade_without_important_is_unchanged():
+
+    css = """
+    * { color: #ff0000 }
+    mytype { color: #00ff00 }
+    """
+    props = CompiledStyleSheet(css).match(Node("mytype"))
+
+    assert props.get("color") == (0, 1, 0, 1)
+
+
+def test_parse_style_sheet_still_yields_value_mapping():
+
+
+    css = """
+    * {
+        font-size: 42 !important;
+        font-family: sans;
+    }
+    """
+    _, declarations = next(parse_style_sheet(css))
+
+    assert declarations["font-size"] == 42
+    assert declarations["font-family"] == "sans"
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,55 @@
+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+
+
+PY=/usr/bin/python3.12
+SITE_SRC=/testbed/.build_env/venv/lib/python3.12/site-packages
+RUNTIME_SP=/tmp/gaphor_runtime_sp
+
+if [ ! -f "$RUNTIME_SP/.ready" ]; then
+    rm -rf "$RUNTIME_SP"
+    cp -r "$SITE_SRC" "$RUNTIME_SP"
+    "$PY" - "$RUNTIME_SP" <<'PY'
+import os, sys
+root = sys.argv[1]
+tag = ".cpython-312.pyc"
+for dirpath, _dirs, files in os.walk(root):
+    if os.path.basename(dirpath) != "__pycache__":
+        continue
+    parent = os.path.dirname(dirpath)
+    for f in files:
+        if f.endswith(tag):
+            dst = os.path.join(parent, f[: -len(tag)] + ".pyc")
+            if not os.path.exists(dst):
+                with open(os.path.join(dirpath, f), "rb") as r, open(dst, "wb") as w:
+                    w.write(r.read())
+PY
+    touch "$RUNTIME_SP/.ready"
+fi
+export PYTHONPATH="$RUNTIME_SP"
+
+PYTEST_OPTS="-o addopts= -p no:cacheprovider -q"
+
+
+"$PY" -m pytest \
+    gaphor/core/styling/tests/test_css.py \
+    gaphor/core/styling/tests/test_selector.py \
+    $PYTEST_OPTS
+
+
+"$PY" -m pytest \
+    gaphor/core/styling/tests/test_important.py \
+    $PYTEST_OPTS
