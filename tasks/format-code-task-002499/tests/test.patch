diff --git a/tests/unit/container/test_generic.py b/tests/unit/container/test_generic.py
index 4b00e59..dd3bb41 100644
--- a/tests/unit/container/test_generic.py
+++ b/tests/unit/container/test_generic.py
@@ -222,3 +222,58 @@ def test_provide_type_non_generic():
     with container() as c:
         assert c.get(A[str]) == (str, bool)
         assert c.get(A[int]) == (bool, bool)
+
+
+GA = TypeVar("GA")
+GB = TypeVar("GB")
+
+
+class GenericAB(Generic[GA, GB]):
+    pass
+
+
+def test_generic_substitution_concrete_then_typevar():
+    """MRE: factory provides C[int, B], request C[int, bool] -> B must map to bool."""
+    def func(b: type[GB]) -> GenericAB[int, GB]:
+        return b
+
+    provider = Provider(scope=Scope.APP)
+    provider.provide(func)
+    container = make_container(provider)
+    assert container.get(GenericAB[int, bool]) is bool
+
+
+def test_generic_substitution_typevar_then_concrete():
+    """Factory provides C[B, int], request C[bool, int] -> B must map to bool."""
+    def func(b: type[GB]) -> GenericAB[GB, int]:
+        return b
+
+    provider = Provider(scope=Scope.APP)
+    provider.provide(func)
+    container = make_container(provider)
+    assert container.get(GenericAB[bool, int]) is bool
+
+
+LocalTV = TypeVar("LocalTV")
+
+
+def test_generic_substitution_local_typevar():
+    """Factory uses a TypeVar not in the class's TypeVars -> still substitutes."""
+    def func(x: type[LocalTV]) -> GenericAB[int, LocalTV]:
+        return x
+
+    provider = Provider(scope=Scope.APP)
+    provider.provide(func)
+    container = make_container(provider)
+    assert container.get(GenericAB[int, str]) is str
+
+
+def test_generic_substitution_nested_typevar():
+    """Factory provides C[int, list[B]], request C[int, list[bool]] -> B must map to bool."""
+    def func(b: type[GB]) -> GenericAB[int, list[GB]]:
+        return b
+
+    provider = Provider(scope=Scope.APP)
+    provider.provide(func)
+    container = make_container(provider)
+    assert container.get(GenericAB[int, list[bool]]) is bool
