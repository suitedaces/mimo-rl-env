diff --git a/usaspending_api/download/tests/integration/test_account_download_filter_dataframe.py b/usaspending_api/download/tests/integration/test_account_download_filter_dataframe.py
new file mode 100644
index 000000000..0e0dae497
--- /dev/null
+++ b/usaspending_api/download/tests/integration/test_account_download_filter_dataframe.py
@@ -0,0 +1,134 @@
+
+
+
+
+
+
+
+
+import pytest
+
+from usaspending_api.download.management.commands.delta_downloads.filters import AccountDownloadFilter
+
+
+SOURCE_SCHEMA = [
+    "label",
+    "reporting_fiscal_year",
+    "reporting_fiscal_period",
+    "reporting_fiscal_quarter",
+    "quarter_format_flag",
+    "budget_function_code",
+    "budget_subfunction_code",
+    "disaster_emergency_fund_code",
+]
+
+
+SOURCE_ROWS = [
+    ("monthly_p3", 2018, 3, 1, False, "050", "051", "L"),
+    ("monthly_p6", 2018, 6, 2, False, "050", "051", "M"),
+    ("monthly_p9", 2018, 9, 3, False, "050", "051", "L"),
+    ("quarterly_q2", 2018, 6, 2, True, "050", "051", "L"),
+    ("quarterly_q3", 2018, 9, 3, True, "050", "051", "L"),
+    ("wrong_year", 2017, 3, 1, False, "050", "051", "L"),
+    ("other_bf", 2018, 3, 1, False, "099", "051", "L"),
+    ("other_bsf", 2018, 3, 1, False, "050", "099", "L"),
+]
+
+
+@pytest.fixture(scope="module")
+def local_spark():
+    from pyspark.sql import SparkSession
+
+    spark = (
+        SparkSession.builder.master("local[1]")
+        .appName("test_account_download_filter_dataframe")
+        .config("spark.ui.enabled", "false")
+        .config("spark.sql.shuffle.partitions", "1")
+        .getOrCreate()
+    )
+    yield spark
+    spark.stop()
+
+
+@pytest.fixture(scope="module")
+def source_df(local_spark):
+    return local_spark.createDataFrame(SOURCE_ROWS, SOURCE_SCHEMA)
+
+
+def surviving_labels(result_df):
+    return {row["label"] for row in result_df.collect()}
+
+
+def test_filters_year_and_cumulative_period(source_df):
+
+
+    filters = AccountDownloadFilter(fy=2018, submission_types=["award_financial"], period=6)
+    result = filters.filter_dataframe(source_df, "award_financial")
+    assert surviving_labels(result) == {
+        "monthly_p3",
+        "monthly_p6",
+        "quarterly_q2",
+        "other_bf",
+        "other_bsf",
+    }
+
+
+def test_quarter_only_derives_period(source_df):
+
+
+    filters = AccountDownloadFilter(fy=2018, submission_types=["award_financial"], quarter=2)
+    result = filters.filter_dataframe(source_df, "award_financial")
+    assert surviving_labels(result) == {
+        "monthly_p3",
+        "monthly_p6",
+        "quarterly_q2",
+        "other_bf",
+        "other_bsf",
+    }
+
+
+def test_budget_function_filter(source_df):
+    filters = AccountDownloadFilter(
+        fy=2018, submission_types=["award_financial"], period=6, budget_function="050"
+    )
+    result = filters.filter_dataframe(source_df, "award_financial")
+    assert surviving_labels(result) == {"monthly_p3", "monthly_p6", "quarterly_q2", "other_bsf"}
+
+
+def test_budget_subfunction_filter(source_df):
+    filters = AccountDownloadFilter(
+        fy=2018, submission_types=["award_financial"], period=6, budget_subfunction="051"
+    )
+    result = filters.filter_dataframe(source_df, "award_financial")
+    assert surviving_labels(result) == {"monthly_p3", "monthly_p6", "quarterly_q2", "other_bf"}
+
+
+def test_def_codes_applied_for_award_financial(source_df):
+    filters = AccountDownloadFilter(
+        fy=2018, submission_types=["award_financial"], period=6, def_codes=["L"]
+    )
+    result = filters.filter_dataframe(source_df, "award_financial")
+    assert surviving_labels(result) == {"monthly_p3", "quarterly_q2", "other_bf", "other_bsf"}
+
+
+def test_def_codes_ignored_for_account_balances(source_df):
+
+    filters = AccountDownloadFilter(
+        fy=2018, submission_types=["account_balances"], period=6, def_codes=["L"]
+    )
+    result = filters.filter_dataframe(source_df, "account_balances")
+    assert surviving_labels(result) == {
+        "monthly_p3",
+        "monthly_p6",
+        "quarterly_q2",
+        "other_bf",
+        "other_bsf",
+    }
+
+
+def test_returns_full_row_shape(source_df):
+
+    filters = AccountDownloadFilter(fy=2018, submission_types=["award_financial"], period=6)
+    result = filters.filter_dataframe(source_df, "award_financial")
+    assert result.columns == source_df.columns
+    assert result.count() == 5
