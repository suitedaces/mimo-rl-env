+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+mkdir -p /root/go/src/github.com/roboll
+ln -sf /testbed /root/go/src/github.com/roboll/helmfile
+
+
+export GO111MODULE=off
+
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 github.com/roboll/helmfile -skip 'TestEnvironmentValuesAvailableInReleaseNameConditionalAndValuesPath|TestEnvironmentSelectionChangesRenderedReleasesAndValuesPath|TestRenderingDefersErrorsUntilEnvironmentValuesAreAvailable|TestProductionEnvironmentUsesArbitraryConfiguredValues|TestFirstPassCanRecoverEnvironmentAfterLaterUnresolvedTemplate|TestFinalTemplateErrorIncludesHelmfileNameAndUnderlyingError'
+    ;;
+  new)
+    go test -v -count=1 github.com/roboll/helmfile -run 'TestEnvironmentValuesAvailableInReleaseNameConditionalAndValuesPath|TestEnvironmentSelectionChangesRenderedReleasesAndValuesPath|TestRenderingDefersErrorsUntilEnvironmentValuesAreAvailable|TestProductionEnvironmentUsesArbitraryConfiguredValues|TestFirstPassCanRecoverEnvironmentAfterLaterUnresolvedTemplate|TestFinalTemplateErrorIncludesHelmfileNameAndUnderlyingError'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
