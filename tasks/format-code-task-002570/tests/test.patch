diff --git a/tests/unit/test_requirements_dependency_behavior.py b/tests/unit/test_requirements_dependency_behavior.py
new file mode 100644
index 0000000000..5fec2c606f
--- /dev/null
+++ b/tests/unit/test_requirements_dependency_behavior.py
@@ -0,0 +1,111 @@
+from pathlib import Path
+
+import pkg_resources
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+
+
+def _requirement_lines(relative_path):
+    path = REPO_ROOT / relative_path
+    for raw_line in path.read_text().splitlines():
+        line = raw_line.strip()
+        if not line or line.startswith("#"):
+            continue
+        if " #" in line:
+            line = line.split(" #", 1)[0].strip()
+        if line.startswith(("-r ", "--requirement ", "-c ", "--constraint ")):
+            continue
+        if line.startswith("-"):
+            continue
+        yield line
+
+
+def _requirements_named(relative_path, name):
+    normalized = name.lower().replace("_", "-")
+    matches = []
+    for line in _requirement_lines(relative_path):
+        requirement = pkg_resources.Requirement.parse(line)
+        if requirement.project_name.lower().replace("_", "-") == normalized:
+            matches.append(requirement)
+    return matches
+
+
+def _is_selected(
+    requirement,
+    python_version,
+    sys_platform="win32",
+    platform_system="Windows",
+    os_name="nt",
+):
+    if requirement.marker is None:
+        return True
+    return requirement.marker.evaluate(
+        {
+            "python_version": python_version,
+            "sys_platform": sys_platform,
+            "platform_system": platform_system,
+            "os_name": os_name,
+        }
+    )
+
+
+def _has_exact_pin(requirement, version):
+    return ("==", version) in requirement.specs
+
+
+def _packaged_and_static_requirement_files():
+    packaged = sorted((REPO_ROOT / "pkg").glob("*/req.txt"))
+    static = sorted((REPO_ROOT / "requirements/static").glob("py*/[dlw]*.txt"))
+    for path in packaged + static:
+        if path.name in {"darwin.txt", "linux.txt", "windows.txt", "req.txt"}:
+            yield path.relative_to(REPO_ROOT).as_posix()
+
+
+def _windows_requirement_files():
+    for relative_path in _packaged_and_static_requirement_files():
+        if "windows" not in relative_path:
+            continue
+        yield relative_path
+
+
+def test_base_requirements_include_distro():
+    distro_requirements = _requirements_named("requirements/base.txt", "distro")
+    assert distro_requirements
+    assert any(_is_selected(requirement, "3.8") for requirement in distro_requirements)
+    assert any(
+        _is_selected(
+            requirement,
+            "3.8",
+            sys_platform="linux",
+            platform_system="Linux",
+            os_name="posix",
+        )
+        for requirement in distro_requirements
+    )
+
+
+def test_packaged_and_static_requirement_sets_pin_distro_consistently():
+    for relative_path in _packaged_and_static_requirement_files():
+        distro_requirements = _requirements_named(relative_path, "distro")
+        assert len(distro_requirements) == 1, relative_path
+        requirement = distro_requirements[0]
+        assert _has_exact_pin(requirement, "1.5.0"), relative_path
+
+
+def test_windows_pymssql_pin_is_guarded_by_python_version_marker():
+    for relative_path in _windows_requirement_files():
+        pymssql_requirements = _requirements_named(relative_path, "pymssql")
+        assert len(pymssql_requirements) == 1, relative_path
+        requirement = pymssql_requirements[0]
+        assert _has_exact_pin(requirement, "2.1.4"), relative_path
+        assert _is_selected(requirement, "3.7"), relative_path
+        assert not _is_selected(requirement, "3.8"), relative_path
+        assert not _is_selected(requirement, "3.9"), relative_path
+
+
+def test_base_requirements_do_not_declare_obsolete_singledispatch_backport():
+    singledispatch_requirements = _requirements_named("requirements/base.txt", "singledispatch")
+    assert all(
+        not _has_exact_pin(requirement, "3.4.0.3")
+        for requirement in singledispatch_requirements
+    )
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,48 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+
+dev-switch python3 3.11 2>/dev/null || true
+python3 -m venv /testbed/.venv
+set +u
+source /testbed/.venv/bin/activate
+set -u
+python -m pip install --no-input 'setuptools<58' wheel >/dev/null
+
+run_requirement_tests() {
+    python - <<'PY'
+import importlib.util
+from pathlib import Path
+
+path = Path("tests/unit/test_requirements_dependency_behavior.py")
+spec = importlib.util.spec_from_file_location("fixture_requirement_tests", path)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+for name in sorted(n for n in dir(module) if n.startswith("test_")):
+    getattr(module, name)()
+    print("PASSED", name)
+PY
+}
+
+case "${1:-}" in
+  base)
+    python - <<'PY'
+from pathlib import Path
+
+for relative_path in ("requirements/base.txt", "pkg/windows/req.txt", "pkg/osx/req.txt"):
+    assert Path(relative_path).is_file(), relative_path
+print("base dependency file smoke passed")
+PY
+    ;;
+  new)
+    run_requirement_tests
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
