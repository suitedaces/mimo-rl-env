diff --git a/test-data/unit/check-namedtuple.test b/test-data/unit/check-namedtuple.test
index 6e3628060..090a67aa5 100644
--- a/test-data/unit/check-namedtuple.test
+++ b/test-data/unit/check-namedtuple.test
@@ -1346,3 +1346,56 @@ class Test:
         self.item: self.Item  # E: Name "self.Item" is not defined
 [builtins fixtures/tuple.pyi]
 [typing fixtures/typing-namedtuple.pyi]
+
+[case testNamedTupleSliceReturnTypeMismatchOriginalIssue]
+from typing import NamedTuple, List, Tuple, Sequence
+
+class NT(NamedTuple):
+    matched_text: str
+    matches: Sequence[str]
+    matches_origin: int
+
+def f() -> Tuple[str, List[str]]:
+    nt = NT("a", ["a", "b"], 1)
+    return nt[:2]  # E: Incompatible return value type (got "Tuple[str, Sequence[str]]", expected "Tuple[str, List[str]]")
+[builtins fixtures/tuple.pyi]
+[typing fixtures/typing-namedtuple.pyi]
+
+[case testNamedTupleSliceRevealType]
+from typing import NamedTuple, Sequence
+
+class NT(NamedTuple):
+    a: str
+    b: Sequence[str]
+    c: int
+
+nt = NT("a", ["x"], 1)
+reveal_type(nt[:2])  # N: Revealed type is "Tuple[builtins.str, typing.Sequence[builtins.str]]"
+reveal_type(nt[:])  # N: Revealed type is "Tuple[builtins.str, typing.Sequence[builtins.str], builtins.int]"
+reveal_type(nt[1:])  # N: Revealed type is "Tuple[typing.Sequence[builtins.str], builtins.int]"
+reveal_type(nt[::2])  # N: Revealed type is "Tuple[builtins.str, builtins.int]"
+reveal_type(nt[-1:])  # N: Revealed type is "Tuple[builtins.int]"
+[builtins fixtures/tuple.pyi]
+[typing fixtures/typing-namedtuple.pyi]
+
+[case testNamedTupleSliceLosesNamedTupleAttributes]
+from typing import NamedTuple
+
+class NT(NamedTuple):
+    a: str
+    b: int
+
+nt = NT("x", 1)
+sliced = nt[:1]
+reveal_type(sliced)  # N: Revealed type is "Tuple[builtins.str]"
+sliced._fields  # E: "Tuple[str]" has no attribute "_fields"
+[builtins fixtures/tuple.pyi]
+[typing fixtures/typing-namedtuple.pyi]
+
+[case testRegularTupleSlicePreserved]
+from typing import Tuple
+t: Tuple[int, str, float]
+reveal_type(t[:2])  # N: Revealed type is "Tuple[builtins.int, builtins.str]"
+reveal_type(t[:])  # N: Revealed type is "Tuple[builtins.int, builtins.str, builtins.float]"
+reveal_type(t[1:])  # N: Revealed type is "Tuple[builtins.str, builtins.float]"
+[builtins fixtures/tuple.pyi]
