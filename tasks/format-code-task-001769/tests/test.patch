@@ -0,0 +1,272 @@
+
+
+import numpy as np
+import pytest
+
+from lenstronomy.LensModel.lens_model import LensModel
+from lenstronomy.PointSource.point_source import PointSource
+
+
+KWARGS_LENS = [{"theta_E": 1, "center_x": 0, "center_y": 0}]
+
+
+def _sis_lens_model():
+    return LensModel(lens_model_list=["SIS"])
+
+
+def _source_position_point_source(*, fixed_magnification=False):
+    return PointSource(
+        point_source_type_list=["SOURCE_POSITION"],
+        lens_model=_sis_lens_model(),
+        fixed_magnification_list=[fixed_magnification],
+        magnification_limit=None,
+        kwargs_lens_eqn_solver=None,
+        redshift_list=None,
+    )
+
+
+def _first_component_xy(position_tuple):
+    return position_tuple[0][0], position_tuple[1][0]
+
+
+def _assert_two_sis_images_for_source(x_image, y_image, ra_source=0.1, dec_source=0.0):
+
+    assert len(x_image) == 2
+    assert len(y_image) == 2
+    order = np.argsort(np.asarray(x_image))
+    expected_x = [ra_source - 1.0, ra_source + 1.0]
+    np.testing.assert_allclose(np.asarray(x_image)[order], expected_x, atol=1e-5)
+    np.testing.assert_allclose(np.asarray(y_image)[order], [0.0, 0.0], atol=1e-5)
+
+    ray_x, ray_y = _sis_lens_model().ray_shooting(x_image, y_image, KWARGS_LENS)
+    np.testing.assert_allclose(ray_x, [ra_source, ra_source], atol=1e-5)
+    np.testing.assert_allclose(ray_y, [dec_source, dec_source], atol=1e-5)
+
+
+def test_source_position_session_solves_images_and_uses_explicit_point_amp():
+
+
+
+    kwargs_ps = [{"ra_source": 0.1, "dec_source": 0.0, "point_amp": [2, 1]}]
+    point_source = _source_position_point_source(fixed_magnification=False)
+
+    assert point_source.point_source_type_list == ["SOURCE_POSITION"]
+
+    x_source_list, y_source_list = point_source.source_position(kwargs_ps, KWARGS_LENS)
+    np.testing.assert_allclose([float(x_source_list[0])], [0.1], atol=0.0, rtol=0.0)
+    np.testing.assert_allclose([float(y_source_list[0])], [0.0], atol=0.0, rtol=0.0)
+
+    x_image, y_image = _first_component_xy(
+        point_source.image_position(kwargs_ps, KWARGS_LENS)
+    )
+    _assert_two_sis_images_for_source(x_image, y_image)
+
+    image_amp = point_source.image_amplitude(kwargs_ps, KWARGS_LENS)
+    np.testing.assert_array_equal(image_amp[0], np.array([2, 1]))
+
+    source_amp = point_source.source_amplitude(kwargs_ps, KWARGS_LENS)
+
+    assert len(source_amp) == 1
+    assert np.isfinite(float(source_amp[0]))
+
+    ra_array, dec_array, amp_array = point_source.point_source_list(
+        kwargs_ps, KWARGS_LENS
+    )
+    _assert_two_sis_images_for_source(ra_array, dec_array)
+    np.testing.assert_array_equal(amp_array, np.array([2, 1]))
+
+
+def test_scalar_point_amp_expands_to_each_solved_image():
+
+
+
+    kwargs_ps = [{"ra_source": 0.1, "dec_source": 0.0, "point_amp": 3.0}]
+    point_source = _source_position_point_source(fixed_magnification=False)
+
+    image_amp = point_source.image_amplitude(kwargs_ps, KWARGS_LENS)
+    np.testing.assert_allclose(image_amp[0], [3.0, 3.0], atol=0.0, rtol=0.0)
+
+    source_amp = point_source.source_amplitude(kwargs_ps, KWARGS_LENS)
+
+    assert len(source_amp) == 1
+    assert np.isfinite(float(source_amp[0]))
+
+    ra_array, dec_array, amp_array = point_source.point_source_list(
+        kwargs_ps, KWARGS_LENS
+    )
+    _assert_two_sis_images_for_source(ra_array, dec_array)
+    np.testing.assert_allclose(amp_array, [3.0, 3.0], atol=0.0, rtol=0.0)
+
+
+def test_fixed_magnification_uses_source_amp_and_absolute_sis_magnification():
+
+
+
+    kwargs_ps = [{"ra_source": 0.1, "dec_source": 0.0, "source_amp": 3.0}]
+    point_source = _source_position_point_source(fixed_magnification=True)
+
+    x_image, y_image = _first_component_xy(
+        point_source.image_position(kwargs_ps, KWARGS_LENS)
+    )
+    _assert_two_sis_images_for_source(x_image, y_image)
+
+    image_amp = point_source.image_amplitude(kwargs_ps, KWARGS_LENS)
+    expected_amp = 3.0 * np.abs(
+        _sis_lens_model().magnification(x_image, y_image, KWARGS_LENS)
+    )
+
+    np.testing.assert_allclose(image_amp[0], expected_amp, atol=1e-5, rtol=0.0)
+
+    source_amp = point_source.source_amplitude(kwargs_ps, KWARGS_LENS)
+    np.testing.assert_allclose([float(source_amp[0])], [3.0], atol=0.0, rtol=0.0)
+
+    ra_array, dec_array, amp_array = point_source.point_source_list(
+        kwargs_ps, KWARGS_LENS
+    )
+    _assert_two_sis_images_for_source(ra_array, dec_array)
+    expected_flat_amp = 3.0 * np.abs(
+        _sis_lens_model().magnification(ra_array, dec_array, KWARGS_LENS)
+    )
+
+    np.testing.assert_allclose(amp_array, expected_flat_amp, atol=1e-5, rtol=0.0)
+
+
+def test_mag_pert_multiplies_and_trims_to_solved_image_count():
+
+
+
+    kwargs_ps = [
+        {
+            "ra_source": 0.1,
+            "dec_source": 0.0,
+            "source_amp": 3.0,
+
+
+            "mag_pert": [1.0, 0.5],
+        }
+    ]
+    point_source = _source_position_point_source(fixed_magnification=True)
+    x_image, y_image = _first_component_xy(
+        point_source.image_position(kwargs_ps, KWARGS_LENS)
+    )
+
+    image_amp = point_source.image_amplitude(kwargs_ps, KWARGS_LENS)
+    expected_amp = (
+        3.0
+        * np.abs(_sis_lens_model().magnification(x_image, y_image, KWARGS_LENS))
+        * np.asarray(kwargs_ps[0]["mag_pert"])
+    )
+
+    np.testing.assert_allclose(image_amp[0], expected_amp, atol=1e-5, rtol=0.0)
+
+    ra_array, dec_array, amp_array = point_source.point_source_list(
+        kwargs_ps, KWARGS_LENS
+    )
+    _assert_two_sis_images_for_source(ra_array, dec_array)
+    expected_flat_amp = (
+        3.0
+        * np.abs(_sis_lens_model().magnification(ra_array, dec_array, KWARGS_LENS))
+        * np.asarray(kwargs_ps[0]["mag_pert"])
+    )
+
+    np.testing.assert_allclose(amp_array, expected_flat_amp, atol=1e-5, rtol=0.0)
+
+
+def test_missing_source_plane_coordinates_raise_key_error_from_needed_call():
+
+
+
+    missing_ra = [{"dec_source": 0.0, "point_amp": [2, 1]}]
+    missing_dec = [{"ra_source": 0.1, "point_amp": [2, 1]}]
+    point_source = _source_position_point_source(fixed_magnification=False)
+
+
+    with pytest.raises(KeyError):
+        point_source.image_position(missing_ra, KWARGS_LENS)
+
+
+    with pytest.raises(KeyError):
+        point_source.image_position(missing_dec, KWARGS_LENS)
+
+
+def test_same_instance_uses_current_point_amp_values():
+
+
+
+
+    first_kwargs_ps = [{"ra_source": 0.1, "dec_source": 0.0, "point_amp": [2, 1]}]
+    second_kwargs_ps = [{"ra_source": 0.1, "dec_source": 0.0, "point_amp": [4, 5]}]
+    point_source = _source_position_point_source(fixed_magnification=False)
+
+    x_source_list, y_source_list = point_source.source_position(
+        first_kwargs_ps, KWARGS_LENS
+    )
+    np.testing.assert_allclose([float(x_source_list[0])], [0.1], atol=0.0, rtol=0.0)
+    np.testing.assert_allclose([float(y_source_list[0])], [0.0], atol=0.0, rtol=0.0)
+
+    x_recomputed_list, y_recomputed_list = point_source.source_position(
+        second_kwargs_ps, KWARGS_LENS
+    )
+    np.testing.assert_allclose(
+        [float(x_recomputed_list[0])], [0.1], atol=0.0, rtol=0.0
+    )
+    np.testing.assert_allclose(
+        [float(y_recomputed_list[0])], [0.0], atol=0.0, rtol=0.0
+    )
+    x_image, y_image = _first_component_xy(
+        point_source.image_position(second_kwargs_ps, KWARGS_LENS)
+    )
+    _assert_two_sis_images_for_source(x_image, y_image)
+    image_amp = point_source.image_amplitude(second_kwargs_ps, KWARGS_LENS)
+    np.testing.assert_array_equal(image_amp[0], np.array([4, 5]))
+
+
+def test_two_instances_keep_independent_source_state():
+
+
+
+
+    first_kwargs_ps = [{"ra_source": 0.1, "dec_source": 0.0, "point_amp": [2, 1]}]
+    second_kwargs_ps = [{"ra_source": 0.1, "dec_source": 0.0, "point_amp": [4, 5]}]
+    point_source_a = _source_position_point_source(fixed_magnification=False)
+    point_source_b = _source_position_point_source(fixed_magnification=False)
+
+    a_x_source, a_y_source = point_source_a.source_position(
+        first_kwargs_ps, KWARGS_LENS
+    )
+    b_x_source, b_y_source = point_source_b.source_position(
+        second_kwargs_ps, KWARGS_LENS
+    )
+    np.testing.assert_allclose([float(a_x_source[0])], [0.1], atol=0.0, rtol=0.0)
+    np.testing.assert_allclose([float(a_y_source[0])], [0.0], atol=0.0, rtol=0.0)
+    np.testing.assert_allclose([float(b_x_source[0])], [0.1], atol=0.0, rtol=0.0)
+    np.testing.assert_allclose([float(b_y_source[0])], [0.0], atol=0.0, rtol=0.0)
+
+    a_x_image, a_y_image = _first_component_xy(
+        point_source_a.image_position(first_kwargs_ps, KWARGS_LENS)
+    )
+    b_x_image, b_y_image = _first_component_xy(
+        point_source_b.image_position(second_kwargs_ps, KWARGS_LENS)
+    )
+    _assert_two_sis_images_for_source(a_x_image, a_y_image, ra_source=0.1)
+    _assert_two_sis_images_for_source(b_x_image, b_y_image, ra_source=0.1)
+    a_image_amp = point_source_a.image_amplitude(first_kwargs_ps, KWARGS_LENS)
+    b_image_amp = point_source_b.image_amplitude(second_kwargs_ps, KWARGS_LENS)
+    np.testing.assert_array_equal(a_image_amp[0], np.array([2, 1]))
+    np.testing.assert_array_equal(b_image_amp[0], np.array([4, 5]))
+
+
+def test_repeated_source_position_sessions_support_varied_point_amp_values():
+
+
+
+
+    for index in range(5):
+        point_amp = np.array([index + 2, index + 3])
+        point_source = _source_position_point_source(fixed_magnification=False)
+        ra_array, dec_array, amp_array = point_source.point_source_list(
+            [{"ra_source": 0.1, "dec_source": 0.0, "point_amp": point_amp}],
+            KWARGS_LENS,
+        )
+        _assert_two_sis_images_for_source(ra_array, dec_array)
+        np.testing.assert_array_equal(amp_array, point_amp)
