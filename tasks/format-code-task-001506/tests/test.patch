diff --git a/tests/components/pi_hole/test_update.py b/tests/components/pi_hole/test_update.py
new file mode 100644
index 00000000000..c2c3aa0c327
--- /dev/null
+++ b/tests/components/pi_hole/test_update.py
@@ -0,0 +1,159 @@
+
+
+from homeassistant.components import pi_hole
+from homeassistant.const import STATE_OFF, STATE_ON, STATE_UNKNOWN
+from homeassistant.helpers import entity_registry as er
+from homeassistant.helpers.entity import EntityCategory
+from homeassistant.setup import async_setup_component
+
+from . import _create_mocked_hole, _patch_config_flow_hole, _patch_init_hole
+
+ALT_VERSIONS = {
+    "core_update": True,
+    "core_current": "v9.1.0",
+    "core_latest": "v9.1.1",
+    "web_update": True,
+    "web_current": "v10.2.0",
+    "web_latest": "v10.2.3",
+    "FTL_update": True,
+    "FTL_current": "v11.3.0",
+    "FTL_latest": "v11.3.4",
+}
+
+NO_UPDATE_VERSIONS = {
+    "core_update": False,
+    "core_current": "v9.1.1",
+    "core_latest": "v9.1.1",
+    "web_update": False,
+    "web_current": "v10.2.3",
+    "web_latest": "v10.2.3",
+    "FTL_update": False,
+    "FTL_current": "v11.3.4",
+    "FTL_latest": "v11.3.4",
+}
+
+
+async def _setup_pi_hole(hass, versions=ALT_VERSIONS):
+
+    mocked_hole = _create_mocked_hole()
+    mocked_hole.versions = versions
+
+    with _patch_config_flow_hole(mocked_hole), _patch_init_hole(mocked_hole):
+        assert await async_setup_component(
+            hass, pi_hole.DOMAIN, {pi_hole.DOMAIN: [{"host": "pi.hole"}]}
+        )
+
+    await hass.async_block_till_done()
+
+
+def _update_states_by_name(hass):
+
+    return {state.name: state for state in hass.states.async_all("update")}
+
+
+async def test_update_entities_are_created_with_version_metadata(hass):
+
+    await _setup_pi_hole(hass)
+
+    states = _update_states_by_name(hass)
+    expected = {
+        "Pi-Hole Core Update Available": (
+            "v9.1.0",
+            "v9.1.1",
+            "https://github.com/pi-hole/pi-hole/releases/tag/v9.1.1",
+        ),
+        "Pi-Hole Web Update Available": (
+            "v10.2.0",
+            "v10.2.3",
+            "https://github.com/pi-hole/AdminLTE/releases/tag/v10.2.3",
+        ),
+        "Pi-Hole FTL Update Available": (
+            "v11.3.0",
+            "v11.3.4",
+            "https://github.com/pi-hole/FTL/releases/tag/v11.3.4",
+        ),
+    }
+
+    for name, (current_version, latest_version, release_url) in expected.items():
+        state = states.get(name)
+        assert state is not None
+        assert state.state == STATE_ON
+        assert state.attributes["current_version"] == current_version
+        assert state.attributes["latest_version"] == latest_version
+        assert state.attributes["release_url"] == release_url
+
+
+async def test_update_entities_report_no_update_when_versions_match(hass):
+
+    await _setup_pi_hole(hass, versions=NO_UPDATE_VERSIONS)
+
+    states = _update_states_by_name(hass)
+    for name in (
+        "Pi-Hole Core Update Available",
+        "Pi-Hole Web Update Available",
+        "Pi-Hole FTL Update Available",
+    ):
+        state = states.get(name)
+        assert state is not None
+        assert state.state == STATE_OFF
+
+
+async def test_update_entities_handle_missing_versions(hass):
+
+    await _setup_pi_hole(hass, versions=None)
+
+    states = _update_states_by_name(hass)
+    for name in (
+        "Pi-Hole Core Update Available",
+        "Pi-Hole Web Update Available",
+        "Pi-Hole FTL Update Available",
+    ):
+        state = states.get(name)
+        assert state is not None
+        assert state.state == STATE_UNKNOWN
+        assert state.attributes.get("current_version") is None
+        assert state.attributes.get("latest_version") is None
+        assert state.attributes.get("release_url") is None
+
+
+async def test_update_entities_have_titles_and_diagnostic_category(hass):
+
+    await _setup_pi_hole(hass)
+
+    registry = er.async_get(hass)
+    states = _update_states_by_name(hass)
+    expected_titles = {
+        "Pi-Hole Core Update Available": "Pi-hole Core",
+        "Pi-Hole Web Update Available": "Pi-hole Web interface",
+        "Pi-Hole FTL Update Available": "Pi-hole FTL DNS",
+    }
+
+    for name, title in expected_titles.items():
+        state = states[name]
+        assert state.attributes["title"] == title
+        entry = registry.async_get(state.entity_id)
+        assert entry is not None
+        assert entry.entity_category == EntityCategory.DIAGNOSTIC
+
+
+async def test_legacy_update_binary_sensors_disabled_by_default(hass):
+
+    await _setup_pi_hole(hass)
+
+    registry = er.async_get(hass)
+    legacy_entity_ids = (
+        "binary_sensor.pi_hole_core_update_available",
+        "binary_sensor.pi_hole_web_update_available",
+        "binary_sensor.pi_hole_ftl_update_available",
+    )
+
+    for entity_id in legacy_entity_ids:
+        entry = registry.async_get(entity_id)
+        assert entry is not None
+        assert entry.disabled_by == er.RegistryEntryDisabler.INTEGRATION
+        assert hass.states.get(entity_id) is None
+
+    status_entry = registry.async_get("binary_sensor.pi_hole")
+    assert status_entry is not None
+    assert status_entry.disabled_by is None
+    assert hass.states.get("binary_sensor.pi_hole") is not None
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,24 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+set +u
+source /testbed/.build_env/.venv/bin/activate
+set -u
+export PYTHONPATH=/testbed
+
+case "${1:-}" in
+  base)
+    python -m pytest tests/components/pi_hole/test_init.py -x -v
+    ;;
+  new)
+    python -m pytest \
+      tests/components/pi_hole/test_update.py \
+      tests/components/pi_hole/test_init.py::test_setup_minimal_config \
+      -x -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
