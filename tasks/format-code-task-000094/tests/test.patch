+  const findChevronPath = (node) => {
+    if (!node) return null;
+    if (Array.isArray(node)) {
+      for (const c of node) {
+        const r = findChevronPath(c);
+        if (r) return r;
+      }
+      return null;
+    }
+    if (typeof node !== 'object') return null;
+    if (node.type === 'RNSVGPath') return node;
+    if (node.children) {
+      return findChevronPath(node.children);
+    }
+    return null;
+  };
+
+
+
+
+
+  const BLACK_FILL = 4278190080;
+  const RED_FILL = 4294901760;
+  const BLUE_FILL = 4278190335;
+
+  it('should render chevron with default black fill when no chevronColor is set', async () => {
+    const i18nInstance = new Streami18n();
+    const translators = await i18nInstance.getTranslators();
+    const { toJSON } = render(
+      <ThemeProvider>
+        <TranslationProvider value={translators}>
+          <ScrollToBottomButton onPress={() => null} showNotification={true} />
+        </TranslationProvider>
+      </ThemeProvider>,
+    );
+    const path = findChevronPath(toJSON());
+    expect(path).toBeTruthy();
+    expect(path.props.fill).toBe(BLACK_FILL);
+  });
+
+  it('should render chevron with theme.messageList.scrollToBottomButton.chevronColor=red', async () => {
+    const i18nInstance = new Streami18n();
+    const translators = await i18nInstance.getTranslators();
+    const { toJSON } = render(
+      <ThemeProvider
+        style={{ messageList: { scrollToBottomButton: { chevronColor: 'red' } } }}
+      >
+        <TranslationProvider value={translators}>
+          <ScrollToBottomButton onPress={() => null} showNotification={true} />
+        </TranslationProvider>
+      </ThemeProvider>,
+    );
+    const path = findChevronPath(toJSON());
+    expect(path).toBeTruthy();
+    expect(path.props.fill).toBe(RED_FILL);
+  });
+
+  it('should render chevron with theme.messageList.scrollToBottomButton.chevronColor=#0000FF', async () => {
+    const i18nInstance = new Streami18n();
+    const translators = await i18nInstance.getTranslators();
+    const { toJSON } = render(
+      <ThemeProvider
+        style={{ messageList: { scrollToBottomButton: { chevronColor: '#0000FF' } } }}
+      >
+        <TranslationProvider value={translators}>
+          <ScrollToBottomButton onPress={() => null} showNotification={true} />
+        </TranslationProvider>
+      </ThemeProvider>,
+    );
+    const path = findChevronPath(toJSON());
+    expect(path).toBeTruthy();
+    expect(path.props.fill).toBe(BLUE_FILL);
+  });
+
+  it('should fall back to black when chevronColor is an empty string', async () => {
+    const i18nInstance = new Streami18n();
+    const translators = await i18nInstance.getTranslators();
+    const { toJSON } = render(
+      <ThemeProvider style={{ messageList: { scrollToBottomButton: { chevronColor: '' } } }}>
+        <TranslationProvider value={translators}>
+          <ScrollToBottomButton onPress={() => null} showNotification={true} />
+        </TranslationProvider>
+      </ThemeProvider>,
+    );
+    const path = findChevronPath(toJSON());
+    expect(path).toBeTruthy();
+    expect(path.props.fill).toBe(BLACK_FILL);
+  });
