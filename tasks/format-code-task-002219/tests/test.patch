+def test_boolean_dtype_with_true_false_values(all_parsers):
+
+    parser = all_parsers
+    data = "A,B\nyes,no\nno,yes\n"
+    result = parser.read_csv(
+        StringIO(data),
+        dtype={"A": "boolean", "B": "boolean"},
+        true_values=["yes"],
+        false_values=["no"],
+    )
+    expected = DataFrame(
+        {
+            "A": pd.array([True, False], dtype="boolean"),
+            "B": pd.array([False, True], dtype="boolean"),
+        }
+    )
+    tm.assert_frame_equal(result, expected)
+
+
+def test_boolean_dtype_with_true_false_values_and_defaults(all_parsers):
+
+
+    parser = all_parsers
+    data = "a\nyes\nno\nTrue\nFalse\n1\n0\n"
+    result = parser.read_csv(
+        StringIO(data),
+        dtype="boolean",
+        true_values=["yes"],
+        false_values=["no"],
+    )
+    expected = DataFrame(
+        {"a": pd.array([True, False, True, False, True, False], dtype="boolean")}
+    )
+    tm.assert_frame_equal(result, expected)
+
+
+def test_boolean_dtype_without_true_false_values_unchanged(all_parsers):
+
+
+    parser = all_parsers
+    data = "a\nTrue\nFalse\n1\n0\n"
+    result = parser.read_csv(StringIO(data), dtype="boolean")
+    expected = DataFrame({"a": pd.array([True, False, True, False], dtype="boolean")})
+    tm.assert_frame_equal(result, expected)
+
+
+def test_boolean_dtype_only_true_values(all_parsers):
+
+
+    parser = all_parsers
+    data = "a\nyes\nFalse\n"
+    result = parser.read_csv(
+        StringIO(data), dtype="boolean", true_values=["yes"]
+    )
+    expected = DataFrame({"a": pd.array([True, False], dtype="boolean")})
+    tm.assert_frame_equal(result, expected)
+
+
+def test_boolean_dtype_invalid_value_still_raises(all_parsers):
+
+    parser = all_parsers
+    data = "a\nmaybe\n"
+    with pytest.raises(ValueError, match="cannot be cast to bool"):
+        parser.read_csv(
+            StringIO(data),
+            dtype="boolean",
+            true_values=["yes"],
+            false_values=["no"],
+        )
