+"use strict";
+
+const prettier = require("../../tests_config/require_prettier");
+
+function format(source) {
+  return prettier.format(source, { parser: "markdown" });
+}
+
+test("preserves no whitespace around CJK between ascii double quotes (issue baseline)", () => {
+  const input = `This ia an english paragraph with a CJK quote "中文".`;
+  expect(format(input)).toEqual(input + "\n");
+});
+
+test("does not insert whitespace around CJK enclosed in U+201C/U+201C (issue exact reproduction)", () => {
+  const input = `This ia an english paragraph with a CJK quote \u201C中文\u201C.`;
+  expect(format(input)).toEqual(input + "\n");
+});
+
+test("does not insert whitespace around CJK enclosed in paired curly quotes U+201C/U+201D", () => {
+  const input = `This ia an english paragraph with a CJK quote \u201C中文\u201D.`;
+  expect(format(input)).toEqual(input + "\n");
+});
+
+test("does not insert whitespace around em dash (U+2014, Pd) between english and CJK", () => {
+  const input = `English\u2014\u4e2d\u6587`;
+  expect(format(input)).toEqual(input + "\n");
+});
+
+test("does not insert whitespace around guillemets U+00AB/U+00BB (Pi/Pf) around CJK", () => {
+  const input = `\u00AB\u4e2d\u6587\u00BB`;
+  expect(format(input)).toEqual(input + "\n");
+});
+
+test("does not insert whitespace around ellipsis U+2026 (Po) between CJK and CJK-via-english", () => {
+  const input = `\u82f1\u6587\u2026\u4e2d\u6587`;
+  expect(format(input)).toEqual(input + "\n");
+});
+
+test("inserts whitespace between english word and CJK character (preservation of existing behavior)", () => {
+
+
+  const input = `English中文`;
+  expect(format(input)).toEqual(`English 中文\n`);
+});
+
+test("inserts whitespace between CJK character and english word (preservation of existing behavior)", () => {
+  const input = `中文English`;
+  expect(format(input)).toEqual(`中文 English\n`);
+});
+
+test("preserves issue's two-paragraph reproduction verbatim", () => {
+  const input =
+    `This ia an english paragraph with a CJK quote "中文".\n` +
+    `\n` +
+    `This ia an english paragraph with a CJK quote \u201C中文\u201C.\n`;
+  expect(format(input)).toEqual(input);
+});
