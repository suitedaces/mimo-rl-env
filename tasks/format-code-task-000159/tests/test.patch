diff --git a/tests/test_simplify.py b/tests/test_simplify.py
index 7246b63..9099897 100644
--- a/tests/test_simplify.py
+++ b/tests/test_simplify.py
@@ -571,3 +571,38 @@ def test_sim300_int():
     assert ret == {
         "1:0 SIM300 Use 'age == 42' instead of '42 == age' (Yoda-conditions)"
     }
+
+
+def test_sim118_basic():
+    ret = _results("key in d.keys()")
+    assert ret == {
+        "1:0 SIM118 Use 'key in d' instead of 'key in d.keys()'"
+    }
+
+
+def test_sim118_actual_key_name():
+
+
+    ret = _results("x in foo.keys()")
+    assert ret == {
+        "1:0 SIM118 Use 'x in foo' instead of 'x in foo.keys()'"
+    }
+
+
+def test_sim118_no_trigger_plain_in():
+    ret = _results("key in d")
+    sim118 = {r for r in ret if "SIM118" in r}
+    assert sim118 == set()
+
+
+def test_sim118_no_trigger_values():
+    ret = _results("key in d.values()")
+    sim118 = {r for r in ret if "SIM118" in r}
+    assert sim118 == set()
+
+
+def test_sim118_attribute_dict():
+    ret = _results("k in obj.attr.keys()")
+    assert ret == {
+        "1:0 SIM118 Use 'k in obj.attr' instead of 'k in obj.attr.keys()'"
+    }
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
