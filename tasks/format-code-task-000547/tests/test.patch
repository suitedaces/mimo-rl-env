+func TestUseAfterCloseFails(t *testing.T) {
+
+
+	host, port, done := startRootMetastore(t, []string{"default", "analytics", "warehouse"})
+	cfg := root.NewMetastoreConnectConfiguration()
+	conn, err := root.ConnectToMetastore(host, port, "NOSASL", cfg)
+	if err != nil {
+		t.Fatalf("ConnectToMetastore returned %T: %v", err, err)
+	}
+	databases, err := conn.Client.GetAllDatabases(context.Background())
+	if err != nil {
+		t.Fatalf("GetAllDatabases before close returned %T: %v", err, err)
+	}
+	if fmt.Sprintf("%#v", databases) != `[]string{"default", "analytics", "warehouse"}` {
+		t.Fatalf("databases before close = %#v", databases)
+	}
+	conn.Close()
+	databases, err = conn.Client.GetAllDatabases(context.Background())
+
+	if err == nil {
+		t.Fatalf("GetAllDatabases after close succeeded with %#v", databases)
+	}
+	assertOperationFailedAfterClose(t, err)
+	waitForServerDone(t, done)
+}
