+func TestNoneAuthFillsBlankCredentialsBeforeSaslFailure(t *testing.T) {
+
+
+	expectedUsername := currentOSUsernameNoSpaces(t)
+
+	rootHost, rootPort, rootMessages := startSaslProbe(t)
+	rootCfg := root.NewMetastoreConnectConfiguration()
+	_, err := root.ConnectToMetastore(rootHost, rootPort, "NONE", rootCfg)
+
+	if rootCfg.Username != expectedUsername {
+		t.Fatalf("root Username = %q", rootCfg.Username)
+	}
+	if rootCfg.Password != "x" {
+		t.Fatalf("root Password = %q", rootCfg.Password)
+	}
+
+	if err == nil {
+		t.Fatalf("root NONE expected SASL setup to return an error")
+	}
+	assertPlainSaslHandshake(t, "root", <-rootMessages, expectedUsername)
+
+	v2Host, v2Port, v2Messages := startSaslProbe(t)
+	v2Cfg := v2.NewMetastoreConnectConfiguration()
+	_, err = v2.ConnectToMetastore(v2Host, v2Port, "NONE", v2Cfg)
+
+	if v2Cfg.Username != expectedUsername {
+		t.Fatalf("v2 Username = %q", v2Cfg.Username)
+	}
+	if v2Cfg.Password != "x" {
+		t.Fatalf("v2 Password = %q", v2Cfg.Password)
+	}
+
+	if err == nil {
+		t.Fatalf("v2 NONE expected SASL setup to return an error")
+	}
+	assertPlainSaslHandshake(t, "v2", <-v2Messages, expectedUsername)
+}
