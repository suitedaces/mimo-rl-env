+func TestUnsupportedAuthAndTransportModePanicWithExactMessages(t *testing.T) {
+
+
+	rootHost, rootPort := startClosingListener(t)
+	rootAuthPanic := panicValue(func() {
+		root.ConnectToMetastore(rootHost, rootPort, "BOGUS", root.NewMetastoreConnectConfiguration())
+	})
+	if rootAuthPanic != "Unrecognized auth" {
+		t.Fatalf("root auth panic = %#v", rootAuthPanic)
+	}
+	rootHost, rootPort = startClosingListener(t)
+	rootCfg := root.NewMetastoreConnectConfiguration()
+	rootCfg.TransportMode = "http"
+	rootModePanic := panicValue(func() {
+		root.ConnectToMetastore(rootHost, rootPort, "NOSASL", rootCfg)
+	})
+	if rootModePanic != "Unrecognized transport mode http" {
+		t.Fatalf("root transport mode panic = %#v", rootModePanic)
+	}
+
+	v2Host, v2Port := startClosingListener(t)
+	v2AuthPanic := panicValue(func() {
+		v2.ConnectToMetastore(v2Host, v2Port, "BOGUS", v2.NewMetastoreConnectConfiguration())
+	})
+	if v2AuthPanic != "Unrecognized auth" {
+		t.Fatalf("v2 auth panic = %#v", v2AuthPanic)
+	}
+	v2Host, v2Port = startClosingListener(t)
+	v2Cfg := v2.NewMetastoreConnectConfiguration()
+	v2Cfg.TransportMode = "http"
+	v2ModePanic := panicValue(func() {
+		v2.ConnectToMetastore(v2Host, v2Port, "NOSASL", v2Cfg)
+	})
+	if v2ModePanic != "Unrecognized transport mode http" {
+		t.Fatalf("v2 transport mode panic = %#v", v2ModePanic)
+	}
+}
