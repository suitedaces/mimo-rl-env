+func (lib *Lib) AcquireCred(desiredName *Name, timeReq time.Duration,
+	desiredMechs *OIDSet, credUsage CredUsage) (outputCredHandle *CredId,
+	actualMechs *OIDSet, timeRec time.Duration, err error) {
