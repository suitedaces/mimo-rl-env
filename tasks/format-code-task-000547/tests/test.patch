+func TestMetastoreCloseDoesNotLeakSocketsOrGoroutines(t *testing.T) {
+
+
+	runtime.GC()
+	time.Sleep(50 * time.Millisecond)
+	baseFDs := countFDs(t)
+	baseGoroutines := runtime.NumGoroutine()
+
+	for i := 0; i < 50; i++ {
+		host, port, done := startRootMetastore(t, []string{"default", "analytics", "warehouse"})
+		conn, err := root.ConnectToMetastore(host, port, "NOSASL", root.NewMetastoreConnectConfiguration())
+		if err != nil {
+			t.Fatalf("root cycle %d ConnectToMetastore returned %T: %v", i, err, err)
+		}
+		databases, err := conn.Client.GetAllDatabases(context.Background())
+		if err != nil {
+			t.Fatalf("root cycle %d GetAllDatabases returned %T: %v", i, err, err)
+		}
+		if fmt.Sprintf("%#v", databases) != `[]string{"default", "analytics", "warehouse"}` {
+			t.Fatalf("root cycle %d databases = %#v", i, databases)
+		}
+		conn.Close()
+		waitForServerDone(t, done)
+	}
+
+	for i := 0; i < 50; i++ {
+		host, port, done := startV2Metastore(t, []string{"default", "analytics", "warehouse"})
+		conn, err := v2.ConnectToMetastore(host, port, "NOSASL", v2.NewMetastoreConnectConfiguration())
+		if err != nil {
+			t.Fatalf("v2 cycle %d ConnectToMetastore returned %T: %v", i, err, err)
+		}
+		databases, err := conn.Client.GetAllDatabases(context.Background())
+		if err != nil {
+			t.Fatalf("v2 cycle %d GetAllDatabases returned %T: %v", i, err, err)
+		}
+		if fmt.Sprintf("%#v", databases) != `[]string{"default", "analytics", "warehouse"}` {
+			t.Fatalf("v2 cycle %d databases = %#v", i, databases)
+		}
+		conn.Close()
+		waitForServerDone(t, done)
+	}
+
+	runtime.GC()
+	time.Sleep(100 * time.Millisecond)
+	finalFDs := countFDs(t)
+	finalGoroutines := runtime.NumGoroutine()
+	if finalFDs > baseFDs+10 {
+		t.Fatalf("file descriptors grew from %d to %d", baseFDs, finalFDs)
+	}
+	if finalGoroutines > baseGoroutines+10 {
+		t.Fatalf("goroutines grew from %d to %d", baseGoroutines, finalGoroutines)
+	}
+}
