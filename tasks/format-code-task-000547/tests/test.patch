+func TestNoSaslSessionsExposePublicClientAndListDatabases(t *testing.T) {
+
+
+	rootHost, rootPort, rootDone := startRootMetastore(t, []string{"default", "analytics", "warehouse"})
+	rootCfg := root.NewMetastoreConnectConfiguration()
+	rootConn, err := root.ConnectToMetastore(rootHost, rootPort, "NOSASL", rootCfg)
+	if err != nil {
+		t.Fatalf("root ConnectToMetastore returned %T: %v", err, err)
+	}
+	if fmt.Sprintf("%T", rootConn.Client) != "*hive_metastore.ThriftHiveMetastoreClient" {
+		t.Fatalf("root public Client type = %T", rootConn.Client)
+	}
+	rootDatabases, err := rootConn.Client.GetAllDatabases(context.Background())
+	if err != nil {
+		t.Fatalf("root GetAllDatabases returned %T: %v", err, err)
+	}
+	if fmt.Sprintf("%#v", rootDatabases) != `[]string{"default", "analytics", "warehouse"}` {
+		t.Fatalf("root databases = %#v", rootDatabases)
+	}
+	rootConn.Close()
+	waitForServerDone(t, rootDone)
+
+	v2Host, v2Port, v2Done := startV2Metastore(t, []string{"default", "analytics", "warehouse"})
+	v2Cfg := v2.NewMetastoreConnectConfiguration()
+	v2Conn, err := v2.ConnectToMetastore(v2Host, v2Port, "NOSASL", v2Cfg)
+	if err != nil {
+		t.Fatalf("v2 ConnectToMetastore returned %T: %v", err, err)
+	}
+	if fmt.Sprintf("%T", v2Conn.Client) != "*hive_metastore.ThriftHiveMetastoreClient" {
+		t.Fatalf("v2 public Client type = %T", v2Conn.Client)
+	}
+	v2Databases, err := v2Conn.Client.GetAllDatabases(context.Background())
+	if err != nil {
+		t.Fatalf("v2 GetAllDatabases returned %T: %v", err, err)
+	}
+	if fmt.Sprintf("%#v", v2Databases) != `[]string{"default", "analytics", "warehouse"}` {
+		t.Fatalf("v2 databases = %#v", v2Databases)
+	}
+	v2Conn.Close()
+	waitForServerDone(t, v2Done)
+}
