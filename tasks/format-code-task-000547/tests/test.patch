+func startRootMetastore(t *testing.T, databases []string) (string, int, <-chan struct{}) {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("listen root metastore: %v", err)
+	}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		defer ln.Close()
+		conn, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		socket := thrift.NewTSocketFromConnTimeout(conn, time.Second)
+		transport, err := thrift.NewTBufferedTransportFactory(4096).GetTransport(socket)
+		if err != nil {
+			return
+		}
+		defer transport.Close()
+		protocol := thrift.NewTBinaryProtocolFactoryDefault().GetProtocol(transport)
+		processor := rootmeta.NewThriftHiveMetastoreProcessor(rootMetastoreHandler{databases: databases})
+		for {
+			ok, err := processor.Process(context.Background(), protocol, protocol)
+			if err != nil || !ok {
+				return
+			}
+		}
+	}()
+	addr := ln.Addr().(*net.TCPAddr)
+	return "127.0.0.1", addr.Port, done
+}
