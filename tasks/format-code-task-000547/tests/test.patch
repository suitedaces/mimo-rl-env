+func currentOSUsernameNoSpaces(t *testing.T) string {
+	t.Helper()
+	u, err := user.Current()
+	if err != nil {
+		t.Fatalf("current OS user: %v", err)
+	}
+	return strings.ReplaceAll(u.Username, " ", "")
+}
+
+func assertPlainSaslHandshake(t *testing.T, label string, messages []saslProbeMessage, username string) {
+	t.Helper()
+	if len(messages) < 2 {
+		t.Fatalf("%s SASL probe captured %d messages", label, len(messages))
+	}
+
+	if messages[0].status != 1 || string(messages[0].body) != "PLAIN" {
+		t.Fatalf("%s first SASL message = status %d body %q", label, messages[0].status, messages[0].body)
+	}
+	if messages[1].status != 2 {
+		t.Fatalf("%s second SASL message status = %d", label, messages[1].status)
+	}
+	plainParts := strings.Split(string(messages[1].body), "\x00")
+	if len(plainParts) != 3 {
+		t.Fatalf("%s PLAIN auth response has %d parts", label, len(plainParts))
+	}
+	if plainParts[1] != username {
+		t.Fatalf("%s PLAIN username = %q", label, plainParts[1])
+	}
+	if plainParts[2] != "x" {
+		t.Fatalf("%s PLAIN password = %q", label, plainParts[2])
+	}
+}
