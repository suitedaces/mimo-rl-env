+		&outputCredHandle.C_gss_cred_id_t,
+		&actualMechs.C_gss_OID_set,
+		&timerec)
+
+	err = lib.stashLastStatus(maj, min)
+	if err != nil {
+		return nil, nil, 0, err
+	}
+
+	return outputCredHandle, actualMechs, time.Duration(timerec) * time.Second, nil
