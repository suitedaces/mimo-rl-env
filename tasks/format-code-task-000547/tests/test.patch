+}
+
+OM_uint32
+wrap_gss_inquire_context(void *fp,
+	OM_uint32 * minor_status,
+	const gss_ctx_id_t context_handle,
+	gss_name_t * src_name,
+	gss_name_t * targ_name,
+	OM_uint32 * lifetime_rec,
+	gss_OID * mech_type,
+	OM_uint32 * ctx_flags,
+	int * locally_initiated,
+	int * open)
+{
+	return ((OM_uint32(*) (
+		OM_uint32 *,
+		const gss_ctx_id_t,
+		gss_name_t *,
+		gss_name_t *,
+		OM_uint32 *,
+		gss_OID *,
+		OM_uint32 *,
