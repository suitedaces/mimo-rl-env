+func TestIndependentMetastoreConnectionsKeepSeparateState(t *testing.T) {
+
+
+	hostA, portA, doneA := startRootMetastore(t, []string{"alpha"})
+	hostB, portB, doneB := startRootMetastore(t, []string{"beta", "gamma"})
+
+	connA, err := root.ConnectToMetastore(hostA, portA, "NOSASL", root.NewMetastoreConnectConfiguration())
+	if err != nil {
+		t.Fatalf("ConnectToMetastore A returned %T: %v", err, err)
+	}
+	connB, err := root.ConnectToMetastore(hostB, portB, "NOSASL", root.NewMetastoreConnectConfiguration())
+	if err != nil {
+		t.Fatalf("ConnectToMetastore B returned %T: %v", err, err)
+	}
+
+	databasesA, err := connA.Client.GetAllDatabases(context.Background())
+	if err != nil {
+		t.Fatalf("GetAllDatabases A returned %T: %v", err, err)
+	}
+	if fmt.Sprintf("%#v", databasesA) != `[]string{"alpha"}` {
+		t.Fatalf("databases A = %#v", databasesA)
+	}
+	databasesB, err := connB.Client.GetAllDatabases(context.Background())
+	if err != nil {
+		t.Fatalf("GetAllDatabases B returned %T: %v", err, err)
+	}
+	if fmt.Sprintf("%#v", databasesB) != `[]string{"beta", "gamma"}` {
+		t.Fatalf("databases B = %#v", databasesB)
+	}
+
+	connA.Close()
+	connB.Close()
+	waitForServerDone(t, doneA)
+	waitForServerDone(t, doneB)
+}
