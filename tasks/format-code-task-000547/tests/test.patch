+func waitForServerDone(t *testing.T, done <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatalf("metastore server connection did not close within 1s")
+	}
+}
+
+func startClosingListener(t *testing.T) (string, int) {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("listen closing socket: %v", err)
+	}
+	go func() {
+		conn, err := ln.Accept()
+		if err == nil {
+			time.Sleep(30 * time.Millisecond)
+			conn.Close()
+		}
+		ln.Close()
+	}()
+	addr := ln.Addr().(*net.TCPAddr)
+	return "127.0.0.1", addr.Port
+}
+
+type saslProbeMessage struct {
+	status byte
+	body   []byte
+}
+
+func readSaslProbeMessage(r io.Reader) (saslProbeMessage, error) {
+	header := make([]byte, 5)
+	if _, err := io.ReadFull(r, header); err != nil {
+		return saslProbeMessage{}, err
+	}
+	length := binary.BigEndian.Uint32(header[1:])
+	body := make([]byte, length)
+	if length > 0 {
+		if _, err := io.ReadFull(r, body); err != nil {
+			return saslProbeMessage{}, err
+		}
+	}
+	return saslProbeMessage{status: header[0], body: body}, nil
+}
+
+func startSaslProbe(t *testing.T) (string, int, <-chan []saslProbeMessage) {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("listen sasl probe: %v", err)
+	}
+	messages := make(chan []saslProbeMessage, 1)
+	go func() {
+		defer ln.Close()
+		var got []saslProbeMessage
+		defer func() {
+			messages <- got
+			close(messages)
+		}()
+		conn, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(time.Second))
+		for i := 0; i < 2; i++ {
+			msg, err := readSaslProbeMessage(conn)
+			if err != nil {
+				return
+			}
+			got = append(got, msg)
+		}
+	}()
+	addr := ln.Addr().(*net.TCPAddr)
+	return "127.0.0.1", addr.Port, messages
+}
+
+func panicValue(fn func()) (value any) {
+	defer func() {
+		value = recover()
+	}()
+	fn()
+	return nil
+}
+
+func assertOperationFailedAfterClose(t *testing.T, err error) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("expected operation after Close to fail")
+	}
+}
