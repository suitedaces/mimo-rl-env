+}
+
+OM_uint32
+wrap_gss_delete_sec_context(void *fp,
+	OM_uint32 * minor_status,
+	gss_ctx_id_t * context_handle,
+	gss_buffer_t output_token)
+{
+	return ((OM_uint32(*) (
+		OM_uint32 *,
+		gss_ctx_id_t *,
+		gss_buffer_t)
+	) fp)(
+		minor_status,
