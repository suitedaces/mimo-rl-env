+var ListDataviewDataProvider = require('../../../../../src/geo/data-providers/geojson/list-dataview-data-provider');
+var FormulaDataviewDataProvider = require('../../../../../src/geo/data-providers/geojson/formula-dataview-data-provider');
+var CategoryDataviewDataProvider = require('../../../../../src/geo/data-providers/geojson/category-dataview-data-provider');
+var HistogramDataviewDataProvider = require('../../../../../src/geo/data-providers/geojson/histogram-dataview-data-provider');
+
+function dataview(attributes) {
+  return {
+    attributes: attributes,
+    get: function (name) { return this.attributes[name]; }
+  };
+}
+
+function layerView(filter) {
+  return {
+    getFilter: function () { return filter; },
+    applyFilter: function () {}
+  };
+}
+
+function feature(properties) {
+  return { type: 'Feature', properties: properties };
+}
+
+describe('vector GeoJSON dataview providers', function () {
+  describe('list provider', function () {
+    it('projects requested columns from the active feature set and preserves falsy values', function () {
+      var values = [
+        feature({ name: 'first', score: 0, enabled: false }),
+        feature({ name: 'second', score: null, enabled: true })
+      ];
+      var provider = new ListDataviewDataProvider({
+        dataview: dataview({ columns: ['name', 'score', 'enabled', 'missing'] }),
+        vectorLayerView: layerView({ getValues: function () { return values; } }),
+        layerIndex: 0
+      });
+
+      expect(provider.getData()).toEqual({
+        rows: [
+          { name: 'first', score: 0, enabled: false, missing: null },
+          { name: 'second', score: null, enabled: true, missing: null }
+        ]
+      });
+    });
+
+    it('returns a fresh response without mutating source feature properties', function () {
+      var source = feature({ name: 'stable' });
+      var provider = new ListDataviewDataProvider({
+        dataview: dataview({ columns: ['name'] }),
+        vectorLayerView: layerView({ getValues: function () { return [source]; } }),
+        layerIndex: 0
+      });
+
+      var first = provider.getData();
+      first.rows[0].name = 'changed';
+
+      expect(provider.getData().rows[0].name).toBe('stable');
+      expect(source.properties.name).toBe('stable');
+    });
+  });
+
+  describe('formula provider', function () {
+    var values;
+
+    beforeEach(function () {
+      values = [
+        feature({ amount: 10 }),
+        feature({ amount: null }),
+        feature({ amount: 0 }),
+        feature({ amount: 5 })
+      ];
+    });
+
+    function result(operation) {
+      var provider = new FormulaDataviewDataProvider({
+        dataview: dataview({ column: 'amount', operation: operation }),
+        vectorLayerView: layerView({ getValues: function () { return values; } }),
+        layerIndex: 0
+      });
+      return provider.getData();
+    }
+
+    it('counts all active features while reporting null values separately', function () {
+      expect(result('count')).toEqual({ operation: 'count', result: 4, nulls: 1, type: 'formula' });
+    });
+
+    it('ignores nulls for sum and average and keeps zero in the calculation', function () {
+      expect(result('sum').result).toBe(15);
+      expect(result('avg').result).toBe(5);
+      expect(result('sum').nulls).toBe(1);
+    });
+
+    it('uses numeric extrema rather than a truthy accumulator', function () {
+      expect(result('min').result).toBe(0);
+      expect(result('max').result).toBe(10);
+    });
+
+    it('returns null for numeric operations when every value is null', function () {
+      values = [feature({ amount: null }), feature({ amount: null })];
+      expect(result('sum').result).toBeNull();
+      expect(result('avg').result).toBeNull();
+      expect(result('min').result).toBeNull();
+      expect(result('max').result).toBeNull();
+      expect(result('sum').nulls).toBe(2);
+    });
+
+    it('rejects unsupported operations with an error', function () {
+      expect(function () { result('median'); }).toThrow();
+    });
+  });
+
+  describe('category provider', function () {
+    var allValues;
+    var filteredValues;
+
+    beforeEach(function () {
+      allValues = [
+        feature({ kind: 'A' }), feature({ kind: 'A' }), feature({ kind: 'A' }), feature({ kind: 'A' }), feature({ kind: 'A' }), feature({ kind: 'A' }),
+        feature({ kind: 'B' }), feature({ kind: 'B' }), feature({ kind: 'B' }), feature({ kind: 'B' }), feature({ kind: 'B' }),
+        feature({ kind: 'C' }), feature({ kind: 'C' }), feature({ kind: 'C' }), feature({ kind: 'C' }),
+        feature({ kind: 'D' }), feature({ kind: 'D' }), feature({ kind: 'D' }),
+        feature({ kind: 'E' }), feature({ kind: 'E' }), feature({ kind: 'F' }),
+        feature({ kind: null })
+      ];
+      filteredValues = allValues.slice(0, 11);
+    });
+
+    function result(filterEnabled) {
+      var filter = {
+        getValues: function (ownFilter) {
+          return ownFilter === false ? allValues : filteredValues;
+        }
+      };
+      var provider = new CategoryDataviewDataProvider({
+        dataview: dataview({ column: 'kind', filterEnabled: filterEnabled }),
+        vectorLayerView: layerView(filter),
+        layerIndex: 0
+      });
+      return provider.getData();
+    }
+
+    it('summarizes all features and aggregates categories after the fifth as Other', function () {
+      var data = result(false);
+      expect(data.count).toBe(22);
+      expect(data.categoriesCount).toBe(7);
+      expect(data.nulls).toBe(1);
+      expect(data.categories.slice(0, 5)).toEqual([
+        { category: 'A', value: 6, agg: false },
+        { category: 'B', value: 5, agg: false },
+        { category: 'C', value: 4, agg: false },
+        { category: 'D', value: 3, agg: false },
+        { category: 'E', value: 2, agg: false }
+      ]);
+      expect(data.categories[5]).toEqual({ category: 'Other', value: 2, agg: true });
+    });
+
+    it('uses only active features and omits Other when filtering is enabled', function () {
+      var data = result(true);
+      expect(data.count).toBe(11);
+      expect(data.categoriesCount).toBe(2);
+      expect(data.categories).toEqual([
+        { category: 'A', value: 6, agg: false },
+        { category: 'B', value: 5, agg: false }
+      ]);
+      expect(data.categories.some(function (item) { return item.category === 'Other'; })).toBe(false);
+    });
+  });
+
+  describe('histogram provider', function () {
+    it('honors explicit numeric bounds including zero and reports nulls', function () {
+      var values = [
+        feature({ amount: -2 }), feature({ amount: -1 }),
+        feature({ amount: 0 }), feature({ amount: 1 }), feature({ amount: null })
+      ];
+      var filter = {
+        getValues: function () { return values; },
+        getMin: function () { return -2; },
+        getMax: function () { return 1; }
+      };
+      var provider = new HistogramDataviewDataProvider({
+        dataview: dataview({ column: 'amount', bins: 2, start: -2, end: 0, data: [] }),
+        vectorLayerView: layerView(filter),
+        layerIndex: 0
+      });
+
+      var data = provider.getData();
+      expect(data.bins_start).toBe(-2);
+      expect(data.bin_width).toBe(1);
+      expect(data.bins_count).toBe(2);
+      expect(data.nulls).toBe(1);
+    });
+  });
+});
