--- /dev/null
+++ b/usercase-test-coderl/test_diffscreen_dirty.py
@@ -0,0 +1,252 @@
+# -*- coding: utf-8 -*-
+
+
+import pyte
+
+
+def _seed_screen():
+    screen = pyte.DiffScreen(5, 3)
+    screen.dirty.clear()
+    for line, text in enumerate([u"ABCDE", u"12345", u"vwxyz"], 1):
+        screen.cursor_position(line, 1)
+        for char in text:
+            screen.draw(char)
+    screen.dirty.clear()
+    return screen
+
+
+def test_initial_clear_and_draw_progression():
+
+
+
+    screen = pyte.DiffScreen(5, 3)
+
+    assert screen.dirty == set([0, 1, 2])
+    assert screen.display == [u"     ", u"     ", u"     "]
+
+    screen.dirty.clear()
+    assert screen.dirty == set([])
+
+    screen.draw(u"A")
+    assert screen.dirty == set([0])
+    assert screen.display == [u"A    ", u"     ", u"     "]
+
+    screen.draw(u"B")
+    assert screen.dirty == set([0])
+    assert screen.display == [u"AB   ", u"     ", u"     "]
+
+    screen.cursor_position(2, 3)
+    screen.dirty.clear()
+    screen.draw(u"Z")
+    assert screen.dirty == set([1])
+    assert screen.display == [u"AB   ", u"  Z  ", u"     "]
+
+
+def test_dirty_sets_are_independent_between_instances():
+
+
+
+    a = pyte.DiffScreen(5, 3)
+    b = pyte.DiffScreen(5, 3)
+
+    a.dirty.clear()
+    a.draw(u"A")
+
+    assert a.dirty == set([0])
+    assert a.display == [u"A    ", u"     ", u"     "]
+    assert b.dirty == set([0, 1, 2])
+    assert b.display == [u"     ", u"     ", u"     "]
+
+
+def test_caller_dirty_clear_is_idempotent_and_session_continues():
+
+
+
+    screen = pyte.DiffScreen(5, 3)
+
+    screen.dirty.clear()
+    screen.dirty.clear()
+    assert screen.dirty == set([])
+
+    screen.draw(u"A")
+    assert screen.dirty == set([0])
+    assert screen.display == [u"A    ", u"     ", u"     "]
+
+    screen.dirty.clear()
+    assert screen.dirty == set([])
+
+
+def test_reset_resize_and_alignment_display_dirty_all_rows():
+
+
+
+    screen = _seed_screen()
+    screen.reset()
+    assert screen.dirty == set([0, 1, 2])
+    assert screen.display == [u"     ", u"     ", u"     "]
+
+    screen = _seed_screen()
+    screen.resize(columns=6)
+    assert screen.dirty == set([0, 1, 2])
+    assert screen.size == (3, 6)
+    assert screen.display == [u"ABCDE ", u"12345 ", u"vwxyz "]
+
+    screen = _seed_screen()
+    screen.alignment_display()
+    assert screen.dirty == set([0, 1, 2])
+    assert screen.display == [u"EEEEE", u"EEEEE", u"EEEEE"]
+
+
+def test_character_mutations_dirty_current_cursor_row():
+
+
+
+    screen = _seed_screen()
+    screen.cursor_position(2, 3)
+    screen.insert_characters(2)
+    assert screen.dirty == set([1])
+    assert screen.display == [u"ABCDE", u"12  3", u"vwxyz"]
+
+    screen = _seed_screen()
+    screen.cursor_position(2, 3)
+    screen.delete_characters(2)
+    assert screen.dirty == set([1])
+    assert screen.display == [u"ABCDE", u"125  ", u"vwxyz"]
+
+    screen = _seed_screen()
+    screen.cursor_position(2, 3)
+    screen.erase_characters(2)
+    assert screen.dirty == set([1])
+    assert screen.display == [u"ABCDE", u"12  5", u"vwxyz"]
+
+    screen = _seed_screen()
+    screen.cursor_position(2, 3)
+    screen.erase_in_line(0)
+    assert screen.dirty == set([1])
+    assert screen.display == [u"ABCDE", u"12   ", u"vwxyz"]
+
+    screen = _seed_screen()
+    screen.cursor_position(2, 3)
+    screen.erase_in_line(1)
+    assert screen.dirty == set([1])
+    assert screen.display == [u"ABCDE", u"   45", u"vwxyz"]
+
+    screen = _seed_screen()
+    screen.cursor_position(2, 3)
+    screen.erase_in_line(2)
+    assert screen.dirty == set([1])
+    assert screen.display == [u"ABCDE", u"     ", u"vwxyz"]
+
+
+def test_line_insert_and_delete_dirty_cursor_through_bottom():
+
+
+
+    screen = _seed_screen()
+    screen.cursor_position(2, 1)
+    screen.insert_lines(1)
+    assert screen.dirty == set([1, 2])
+    assert screen.display == [u"ABCDE", u"     ", u"12345"]
+
+    screen = _seed_screen()
+    screen.cursor_position(2, 1)
+    screen.delete_lines(1)
+    assert screen.dirty == set([1, 2])
+    assert screen.display == [u"ABCDE", u"vwxyz", u"     "]
+
+
+def test_scrolling_index_methods_dirty_all_rows_at_margins():
+
+
+
+    screen = _seed_screen()
+    screen.cursor_position(3, 1)
+    screen.index()
+    assert screen.dirty == set([0, 1, 2])
+    assert screen.display == [u"12345", u"vwxyz", u"     "]
+
+    screen = _seed_screen()
+    screen.cursor_position(2, 1)
+    screen.index()
+    assert screen.dirty == set([])
+    assert screen.display == [u"ABCDE", u"12345", u"vwxyz"]
+
+    screen = _seed_screen()
+    screen.cursor_position(1, 1)
+    screen.reverse_index()
+    assert screen.dirty == set([0, 1, 2])
+    assert screen.display == [u"     ", u"ABCDE", u"12345"]
+
+    screen = _seed_screen()
+    screen.cursor_position(2, 1)
+    screen.reverse_index()
+    assert screen.dirty == set([])
+    assert screen.display == [u"ABCDE", u"12345", u"vwxyz"]
+
+
+def test_erase_in_display_dirty_ranges_are_mode_specific():
+
+
+
+    screen = _seed_screen()
+    screen.cursor_position(2, 3)
+    screen.erase_in_display(0)
+    assert screen.dirty == set([1, 2])
+    assert screen.display == [u"ABCDE", u"12   ", u"     "]
+
+    screen = _seed_screen()
+    screen.cursor_position(2, 3)
+    screen.erase_in_display(1)
+    assert screen.dirty == set([0, 1])
+    assert screen.display == [u"     ", u"   45", u"vwxyz"]
+
+    screen = _seed_screen()
+    screen.cursor_position(2, 3)
+    screen.erase_in_display(2)
+    assert screen.dirty == set([0, 1, 2])
+    assert screen.display == [u"     ", u"     ", u"     "]
+
+
+def test_private_reverse_screen_mode_toggles_dirty_all_rows():
+
+
+
+    screen = pyte.DiffScreen(5, 3)
+    screen.dirty.clear()
+    screen.set_mode(pyte.mo.DECSCNM >> 5, private=True)
+    assert screen.dirty == set([0, 1, 2])
+    assert screen.display == [u"     ", u"     ", u"     "]
+
+    screen = pyte.DiffScreen(5, 3)
+    screen.dirty.clear()
+    screen.reset_mode(pyte.mo.DECSCNM >> 5, private=True)
+    assert screen.dirty == set([0, 1, 2])
+    assert screen.display == [u"     ", u"     ", u"     "]
+
+
+def test_repeated_screen_sessions_keep_dirty_state_independent():
+
+
+
+    screens = []
+
+    for _ in range(150):
+        screen = pyte.DiffScreen(5, 3)
+        assert screen.dirty == set([0, 1, 2])
+
+        screen.dirty.clear()
+        screen.draw(u"A")
+        assert screen.dirty == set([0])
+        assert screen.display == [u"A    ", u"     ", u"     "]
+
+        screen.reset()
+        assert screen.dirty == set([0, 1, 2])
+        assert screen.display == [u"     ", u"     ", u"     "]
+        screens.append(screen)
+
+
+
+
+    screens[0].dirty.clear()
+    assert screens[0].dirty == set([])
+    assert all(screen.dirty == set([0, 1, 2]) for screen in screens[1:])
