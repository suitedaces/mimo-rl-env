+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+# ===== copied from /testbed/.build_env/test_command.sh =====
+set +u
+dev-switch java 8
+export JAVA_HOME=/usr/lib/jvm/temurin-8-jdk-amd64
+set -u
+# ===== END copied env activation =====
+
+INIT_SCRIPT="${TMPDIR:-/tmp}/auth0-fixture-init.gradle"
+cat > "$INIT_SCRIPT" <<'GRADLE'
+allprojects {
+    buildscript {
+        repositories {
+            mavenCentral()
+        }
+        configurations.classpath {
+            resolutionStrategy.eachDependency { details ->
+                if (details.requested.group == 'org.codehaus.groovy.modules.http-builder' && details.requested.name == 'http-builder') {
+                    details.useVersion '0.7.1'
+                }
+            }
+        }
+    }
+}
+GRADLE
+
+case "${1:-}" in
+  base)
+    ./gradlew -I "$INIT_SCRIPT" test --tests "com.auth0.client.mgmt.ManagementAPITest"
+    ;;
+  new)
+    ./gradlew -I "$INIT_SCRIPT" test \
+      --tests "com.auth0.client.mgmt.JobsEntityTest" \
+      --tests "com.auth0.json.mgmt.jobs.JobTest"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
