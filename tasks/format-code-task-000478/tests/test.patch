@@ -0,0 +1,51 @@
+package com.auth0.json.mgmt.jobs;
+
+import com.auth0.json.JsonTest;
+import org.junit.Test;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.hamcrest.Matchers.notNullValue;
+import static org.hamcrest.core.Is.is;
+import static org.junit.Assert.assertThat;
+
+public class JobTest extends JsonTest<Job> {
+
+    // LITERAL-BINDING-REASON: Job JSON field names and timestamp strings are public response-format contract for round-trip behavior.
+
+    @Test
+    public void shouldDeserializeJobResponse() throws Exception {
+        String json = "{\"id\":\"job_test_123\",\"status\":\"pending\",\"type\":\"verification_email\",\"created_at\":\"2016-02-23T19:57:29.532Z\"}";
+
+        Job job = fromJSON(json, Job.class);
+
+        assertThat(job, is(notNullValue()));
+        assertThat(job.getId(), is("job_test_123"));
+        assertThat(job.getStatus(), is("pending"));
+        assertThat(job.getType(), is("verification_email"));
+        assertThat(job.getCreatedAt(), is(parseJSONDate("2016-02-23T19:57:29.532Z")));
+    }
+
+    @Test
+    public void shouldIgnoreUnknownFields() throws Exception {
+        String json = "{\"id\":\"job_unknown_456\",\"status\":\"completed\",\"type\":\"verification_email\",\"created_at\":\"2017-03-24T20:58:30.123Z\",\"ignored_field\":\"ignored\"}";
+
+        Job job = fromJSON(json, Job.class);
+
+        assertThat(job.getId(), is("job_unknown_456"));
+        assertThat(job.getStatus(), is("completed"));
+        assertThat(job.getCreatedAt(), is(parseJSONDate("2017-03-24T20:58:30.123Z")));
+    }
+
+    @Test
+    public void shouldNotSerializeNullFields() throws Exception {
+        Job job = fromJSON("{\"id\":\"job_partial_789\"}", Job.class);
+
+        String json = toJSON(job);
+
+        assertThat(json, containsString("\"id\":\"job_partial_789\""));
+        assertThat(json, not(containsString("status")));
+        assertThat(json, not(containsString("type")));
+        assertThat(json, not(containsString("created_at")));
+    }
+}
