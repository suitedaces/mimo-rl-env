+package com.auth0.client.mgmt;
+
+import com.auth0.json.mgmt.jobs.Job;
+import com.auth0.net.Request;
+import okhttp3.mockwebserver.RecordedRequest;
+import org.junit.Test;
+
+import java.util.Map;
+
+import static com.auth0.client.MockServer.bodyFromRequest;
+import static com.auth0.client.RecordedRequestMatcher.hasHeader;
+import static com.auth0.client.RecordedRequestMatcher.hasMethodAndPath;
+import static org.hamcrest.Matchers.hasEntry;
+import static org.hamcrest.Matchers.hasKey;
+import static org.hamcrest.Matchers.not;
+import static org.hamcrest.core.Is.is;
+import static org.hamcrest.core.IsNull.notNullValue;
+import static org.junit.Assert.assertThat;
+
+public class JobsEntityTest extends BaseMgmtEntityTest {
+
+    // LITERAL-BINDING-REASON: Auth0 Management API method, path, headers, and JSON field names are public wire-format contract.
+
+    private static final String JOB_RESPONSE = "src/test/resources/mgmt/job_verification_email_response.json";
+
+    @Test
+    public void shouldExposeJobsEntityFromManagementAPI() throws Exception {
+        JobsEntity jobs = api.jobs();
+        assertThat(jobs, is(notNullValue()));
+        Request<Job> request = jobs.sendVerificationEmail("auth0|api-entry", null);
+        assertThat(request, is(notNullValue()));
+    }
+
+    @Test
+    public void shouldSendVerificationEmailWithClientId() throws Exception {
+        Request<Job> request = api.jobs().sendVerificationEmail("auth0|abc", "client_a");
+        assertThat(request, is(notNullValue()));
+
+        server.jsonResponse(JOB_RESPONSE, 200);
+        Job response = request.execute();
+        RecordedRequest recordedRequest = server.takeRequest();
+
+        assertThat(recordedRequest, hasMethodAndPath("POST", "/api/v2/jobs/verification-email"));
+        assertThat(recordedRequest, hasHeader("Content-Type", "application/json"));
+        assertThat(recordedRequest, hasHeader("Authorization", "Bearer apiToken"));
+
+        Map<String, Object> body = bodyFromRequest(recordedRequest);
+        assertThat(body.size(), is(2));
+        assertThat(body, hasEntry("user_id", (Object) "auth0|abc"));
+        assertThat(body, hasEntry("client_id", (Object) "client_a"));
+
+        assertThat(response, is(notNullValue()));
+        assertThat(response.getId(), is("job_test_123"));
+        assertThat(response.getStatus(), is("pending"));
+        assertThat(response.getType(), is("verification_email"));
+    }
+
+    @Test
+    public void shouldOmitClientIdWhenNull() throws Exception {
+        Request<Job> request = api.jobs().sendVerificationEmail("auth0|null-client", null);
+        assertThat(request, is(notNullValue()));
+
+        server.jsonResponse(JOB_RESPONSE, 200);
+        Job response = request.execute();
+        RecordedRequest recordedRequest = server.takeRequest();
+
+        assertThat(recordedRequest, hasMethodAndPath("POST", "/api/v2/jobs/verification-email"));
+
+        Map<String, Object> body = bodyFromRequest(recordedRequest);
+        assertThat(body.size(), is(1));
+        assertThat(body, hasEntry("user_id", (Object) "auth0|null-client"));
+        assertThat(body, not(hasKey("client_id")));
+
+        assertThat(response, is(notNullValue()));
+    }
+
+    @Test
+    public void shouldOmitClientIdWhenEmpty() throws Exception {
+        Request<Job> request = api.jobs().sendVerificationEmail("auth0|empty-client", "");
+        assertThat(request, is(notNullValue()));
+
+        server.jsonResponse(JOB_RESPONSE, 200);
+        request.execute();
+        RecordedRequest recordedRequest = server.takeRequest();
+
+        assertThat(recordedRequest, hasMethodAndPath("POST", "/api/v2/jobs/verification-email"));
+
+        Map<String, Object> body = bodyFromRequest(recordedRequest);
+        assertThat(body.size(), is(1));
+        assertThat(body, hasEntry("user_id", (Object) "auth0|empty-client"));
+        assertThat(body, not(hasKey("client_id")));
+    }
+
+    @Test
+    public void shouldRejectNullUserIdBeforeSendingRequest() throws Exception {
+        exception.expect(IllegalArgumentException.class);
+        api.jobs().sendVerificationEmail(null, "client_a");
+    }
+}
