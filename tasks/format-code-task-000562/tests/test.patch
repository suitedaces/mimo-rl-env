+package fixturetests
+
+import org.bitcoins.core.crypto.MnemonicCode
+import org.bitcoins.core.hd.BIP32Path
+import org.bitcoins.core.protocol.BitcoinAddress
+import org.bitcoins.rpc.jsonmodels.DeriveAddressesResult
+
+object WrapperSequenceBehaviorCheck {
+
+  private def assertIndexedSeqBehavior[A](
+      wrapper: IndexedSeq[A],
+      underlying: Vector[A]): Unit = {
+    assert(wrapper.length == underlying.length)
+    assert(wrapper.indices == underlying.indices)
+    assert(wrapper.headOption == underlying.headOption)
+    assert(wrapper.lastOption == underlying.lastOption)
+    assert(wrapper.iterator.toVector == underlying)
+    assert(wrapper.reverse.toVector == underlying.reverse)
+    assert(
+      wrapper.slice(1, wrapper.length).toVector ==
+        underlying.slice(1, underlying.length))
+    assert(wrapper.zipWithIndex.toVector == underlying.zipWithIndex)
+    wrapper.foreach(_ => ())
+  }
+
+  def main(args: Array[String]): Unit = {
+    val mnemonics = Vector(
+      MnemonicCode.fromWords(
+        Vector(
+          "abandon",
+          "abandon",
+          "abandon",
+          "abandon",
+          "abandon",
+          "abandon",
+          "abandon",
+          "abandon",
+          "abandon",
+          "abandon",
+          "abandon",
+          "about")),
+      MnemonicCode.fromWords(
+        Vector(
+          "legal",
+          "winner",
+          "thank",
+          "year",
+          "wave",
+          "sausage",
+          "worth",
+          "useful",
+          "legal",
+          "winner",
+          "thank",
+          "yellow"))
+    )
+
+    mnemonics.foreach { mnemonic =>
+      val indexed: IndexedSeq[String] = mnemonic
+      assertIndexedSeqBehavior(indexed, mnemonic.words)
+      assert(mnemonic.length == mnemonic.words.length)
+      assert(mnemonic(0) == mnemonic.words(0))
+      assert(mnemonic.mkString(" ") == mnemonic.words.mkString(" "))
+      assert(mnemonic.iterator.toVector == mnemonic.words)
+      assert(mnemonic.map(identity).toVector == mnemonic.words.map(identity))
+    }
+
+    val paths = Vector(
+      BIP32Path.fromString("m/0/1"),
+      BIP32Path.fromString("m/44'/0'/0'/1/7"))
+
+    paths.foreach { path =>
+      val indexed: IndexedSeq[org.bitcoins.core.hd.BIP32Node] = path
+      assertIndexedSeqBehavior(indexed, path.path)
+      assert(path.length == path.path.length)
+      assert(path.toList == path.path.toList)
+      assert(path.iterator.toVector == path.path)
+      assert(
+        path.foldLeft(Vector.empty[String])(_ :+ _.toString) ==
+          path.path.foldLeft(Vector.empty[String])(_ :+ _.toString))
+      assert(path(0) == path.path(0))
+    }
+
+    val shortPath = BIP32Path.fromString("m/1")
+    val longerPath = BIP32Path.fromString("m/84'/1'/2'/0/25")
+
+    assert(shortPath.length == shortPath.path.length)
+    assert(longerPath.length == longerPath.path.length)
+    assertIndexedSeqBehavior(shortPath, shortPath.path)
+    assertIndexedSeqBehavior(longerPath, longerPath.path)
+    assert(shortPath.iterator.toVector == shortPath.path)
+    assert(longerPath.iterator.toVector == longerPath.path)
+    assert(shortPath.map(_.toString).toVector == shortPath.path.map(_.toString))
+    assert(
+      longerPath.map(_.toString).toVector == longerPath.path.map(_.toString))
+
+    val first = DeriveAddressesResult(
+      Vector(
+        BitcoinAddress.fromStringExn("1BoatSLRHtKNngkdXEeobR76b53LETtpyT"),
+        BitcoinAddress.fromStringExn("1BitcoinEaterAddressDontSendf59kuE")))
+
+    val second = DeriveAddressesResult(
+      Vector(
+        BitcoinAddress.fromStringExn("3J98t1WpEZ73CNmQviecrnyiWrnqRhWNLy"),
+        BitcoinAddress.fromStringExn("bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq"),
+        BitcoinAddress.fromStringExn("17WN1kFw8D6w1eHzqvkh49xwjE3iPN925b")))
+
+    Vector(first, second).foreach { result =>
+      val indexed: IndexedSeq[BitcoinAddress] = result
+      assertIndexedSeqBehavior(indexed, result.addresses)
+      assert(result.length == result.addresses.length)
+      assert(result(0) == result.addresses(0))
+      assert(result.iterator.toVector == result.addresses)
+      assert(result.map(_.toString).toVector == result.addresses.map(_.toString))
+    }
+
+    assert(first.length != second.length)
+    assert(first.iterator.toVector != second.iterator.toVector)
+  }
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
