@@ -0,0 +1,22 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+export JAVA_HOME=/usr/lib/jvm/temurin-11-jdk-amd64
+export PATH=$JAVA_HOME/bin:$PATH
+
+
+case "${1:-}" in
+  base)
+    sbt ';core / Compile / compile; bitcoindRpc / Compile / compile'
+    ;;
+  new)
+    sbt ';set bitcoindRpc / Compile / unmanagedSources += file("/testbed/fixture-tests/WrapperSequenceBehaviorCheck.scala"); bitcoindRpc / Compile / runMain fixturetests.WrapperSequenceBehaviorCheck'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
