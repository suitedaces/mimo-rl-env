diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,240 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+TMP=""
+cleanup() {
+    if [ -n "$TMP" ]; then
+        rm -rf "$TMP"
+    fi
+}
+trap cleanup EXIT
+
+
+
+BIN="/opt/stage4a-urlwatch-venv/bin/urlwatch"
+PY="/opt/stage4a-urlwatch-venv/bin/python"
+[ -x "$BIN" ] || fail "missing urlwatch executable"
+[ -x "$PY" ] || fail "missing python executable"
+
+TMP=$(mktemp -d)
+cd "$TMP" || fail "cd temp"
+
+write_config() {
+    cat >"$1" <<'EOF'
+report:
+  stdout:
+    enabled: false
+EOF
+}
+
+write_mixed_urls() {
+    cat >"$1" <<'EOF'
+url: https://example.com/old-url
+---
+kind: browser
+navigate: https://example.com/old-browser
+---
+kind: shell
+command: printf old-shell
+---
+url: https://example.com/existing
+EOF
+}
+
+assert_empty_err() {
+    [ ! -s "$1" ] || fail "$2 stderr: $(cat "$1")"
+}
+
+assert_file_exact() {
+    actual=$(cat "$1")
+    expected=$2
+    [ "$actual" = "$expected" ] || fail "$3 file mismatch:
+$actual"
+}
+
+assert_line_exact() {
+    grep -qxF -- "$2" "$1" || fail "$3 missing line: $2
+$(cat "$1")"
+}
+
+assert_yaml_fields() {
+    "$PY" - "$@" <<'PY'
+import sys
+import yaml
+
+path = sys.argv[1]
+expected = sys.argv[2:]
+with open(path, encoding="utf-8") as fp:
+    docs = list(yaml.safe_load_all(fp))
+
+if len(docs) != len(expected):
+    raise SystemExit(f"expected {len(expected)} jobs, got {len(docs)}: {docs!r}")
+
+for idx, (doc, spec) in enumerate(zip(docs, expected), 1):
+    field, value = spec.split("=", 1)
+    if not isinstance(doc, dict):
+        raise SystemExit(f"job {idx} is not a mapping: {doc!r}")
+    if doc.get(field) != value:
+        raise SystemExit(f"job {idx} expected {field}={value!r}, got {doc!r}")
+PY
+}
+
+
+
+
+"$BIN" --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_help exit $ec; want 0"
+grep -qF -- "--change-location JOB NEW_LOCATION" out || fail "F_help missing metavar"
+
+grep -qiF -- "change" out || fail "F_help missing change keyword"
+grep -qiF -- "location" out || fail "F_help missing location keyword"
+grep -qiF -- "index" out || fail "F_help missing index keyword"
+assert_empty_err err "F_help"
+
+
+
+
+case_dir="$TMP/f_url_index"; mkdir -p "$case_dir"
+write_config "$case_dir/config.yaml"
+write_mixed_urls "$case_dir/urls.yaml"
+"$BIN" --config "$case_dir/config.yaml" --urls "$case_dir/urls.yaml" --cache "$case_dir/cache.db" \
+    --change-location 1 https://example.com/new-url >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_url_index exit $ec; want 0"
+assert_line_exact out 'Moving location of <url url='\''https://example.com/old-url'\''> to "https://example.com/new-url"' "F_url_index stdout"
+assert_empty_err err "F_url_index"
+
+assert_yaml_fields "$case_dir/urls.yaml" \
+    "url=https://example.com/new-url" \
+    "navigate=https://example.com/old-browser" \
+    "command=printf old-shell" \
+    "url=https://example.com/existing"
+! grep -qF 'Moved ' out || fail "F_url_index should not print moved snapshots without history"
+
+
+
+
+case_dir="$TMP/f_browser_location"; mkdir -p "$case_dir"
+write_config "$case_dir/config.yaml"
+write_mixed_urls "$case_dir/urls.yaml"
+"$BIN" --config "$case_dir/config.yaml" --urls "$case_dir/urls.yaml" --cache "$case_dir/cache.db" \
+    --change-location https://example.com/old-browser https://example.com/new-browser >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_browser_location exit $ec; want 0"
+assert_line_exact out 'Moving location of <browser navigate='\''https://example.com/old-browser'\''> to "https://example.com/new-browser"' "F_browser_location stdout"
+assert_empty_err err "F_browser_location"
+
+assert_yaml_fields "$case_dir/urls.yaml" \
+    "url=https://example.com/old-url" \
+    "navigate=https://example.com/new-browser" \
+    "command=printf old-shell" \
+    "url=https://example.com/existing"
+
+
+
+
+case_dir="$TMP/f_shell_index_many"; mkdir -p "$case_dir"
+write_config "$case_dir/config.yaml"
+write_mixed_urls "$case_dir/urls.yaml"
+"$BIN" --config "$case_dir/config.yaml" --urls "$case_dir/urls.yaml" --cache "$case_dir/cache.db" \
+    --change-location 3 "printf new-shell" >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_shell_index_many exit $ec; want 0"
+assert_line_exact out 'Moving location of <shell command='\''printf old-shell'\''> to "printf new-shell"' "F_shell_index_many stdout"
+assert_empty_err err "F_shell_index_many"
+
+assert_yaml_fields "$case_dir/urls.yaml" \
+    "url=https://example.com/old-url" \
+    "navigate=https://example.com/old-browser" \
+    "command=printf new-shell" \
+    "url=https://example.com/existing"
+
+
+
+
+case_dir="$TMP/f_duplicate"; mkdir -p "$case_dir"
+write_config "$case_dir/config.yaml"
+write_mixed_urls "$case_dir/urls.yaml"
+before_yaml=$(cat "$case_dir/urls.yaml")
+"$BIN" --config "$case_dir/config.yaml" --urls "$case_dir/urls.yaml" --cache "$case_dir/cache.db" \
+    --change-location 1 https://example.com/existing >out 2>err; ec=$?
+expected_out='The new location "https://example.com/existing" already exists for a job. Delete the existing job or choose a different value.'
+[ "$ec" -eq 0 ] || fail "F_duplicate exit $ec; want 0"
+assert_line_exact out "$expected_out" "F_duplicate stdout"
+assert_empty_err err "F_duplicate"
+assert_file_exact "$case_dir/urls.yaml" "$before_yaml" "F_duplicate"
+
+
+
+
+case_dir="$TMP/f_not_found_location"; mkdir -p "$case_dir"
+write_config "$case_dir/config.yaml"
+write_mixed_urls "$case_dir/urls.yaml"
+before_yaml=$(cat "$case_dir/urls.yaml")
+"$BIN" --config "$case_dir/config.yaml" --urls "$case_dir/urls.yaml" --cache "$case_dir/cache.db" \
+    --change-location https://example.com/missing https://example.com/new-missing >out 2>err; ec=$?
+expected_out='Not found: https://example.com/missing'
+[ "$ec" -eq 0 ] || fail "F_not_found_location exit $ec; want 0"
+assert_line_exact out "$expected_out" "F_not_found_location stdout"
+assert_empty_err err "F_not_found_location"
+assert_file_exact "$case_dir/urls.yaml" "$before_yaml" "F_not_found_location"
+
+
+
+
+case_dir="$TMP/f_not_found_zero_index"; mkdir -p "$case_dir"
+write_config "$case_dir/config.yaml"
+write_mixed_urls "$case_dir/urls.yaml"
+before_yaml=$(cat "$case_dir/urls.yaml")
+"$BIN" --config "$case_dir/config.yaml" --urls "$case_dir/urls.yaml" --cache "$case_dir/cache.db" \
+    --change-location 0 https://example.com/new-zero >out 2>err; ec=$?
+expected_out='Not found: 0'
+[ "$ec" -eq 0 ] || fail "F_not_found_zero_index exit $ec; want 0"
+assert_line_exact out "$expected_out" "F_not_found_zero_index stdout"
+assert_empty_err err "F_not_found_zero_index"
+assert_file_exact "$case_dir/urls.yaml" "$before_yaml" "F_not_found_zero_index"
+
+
+
+
+case_dir="$TMP/f_missing_new_location"; mkdir -p "$case_dir"
+write_config "$case_dir/config.yaml"
+write_mixed_urls "$case_dir/urls.yaml"
+"$BIN" --config "$case_dir/config.yaml" --urls "$case_dir/urls.yaml" --cache "$case_dir/cache.db" \
+    --change-location 1 >out 2>err; ec=$?
+
+[ "$ec" -ne 0 ] || fail "F_missing_new_location exit $ec; want nonzero"
+[ ! -s out ] || fail "F_missing_new_location stdout: $(cat out)"
+grep -qF -- "--change-location" err || fail "F_missing_new_location stderr: $(cat err)"
+
+
+
+
+case_dir="$TMP/f_cache_moved"; mkdir -p "$case_dir"
+write_config "$case_dir/config.yaml"
+cat >"$case_dir/urls.yaml" <<'EOF'
+kind: shell
+command: printf cached-old
+EOF
+"$BIN" --config "$case_dir/config.yaml" --urls "$case_dir/urls.yaml" --cache "$case_dir/cache.db" >run.out 2>run.err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_cache_moved initial run exit $ec; want 0"
+
+"$BIN" --config "$case_dir/config.yaml" --urls "$case_dir/urls.yaml" --cache "$case_dir/cache.db" \
+    --change-location "printf cached-old" "printf cached-new" >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_cache_moved change exit $ec; want 0"
+assert_line_exact out 'Moving location of <shell command='\''printf cached-old'\''> to "printf cached-new"' "F_cache_moved change stdout"
+assert_line_exact out 'Moved 1 snapshots of "printf cached-old" to "printf cached-new"' "F_cache_moved change stdout"
+assert_empty_err err "F_cache_moved change"
+
+assert_yaml_fields "$case_dir/urls.yaml" "command=printf cached-new"
+"$BIN" --config "$case_dir/config.yaml" --urls "$case_dir/urls.yaml" --cache "$case_dir/cache.db" \
+    --dump-history "printf cached-new" >dump.out 2>dump.err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_cache_moved dump new exit $ec; want 0"
+grep -qF -- "cached-old" dump.out || fail "F_cache_moved new history missing old snapshot"
+
+[ -s dump.out ] || fail "F_cache_moved dump new should show moved history"
+assert_empty_err dump.err "F_cache_moved dump new"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
