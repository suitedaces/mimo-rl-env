diff --git a/test/usage.js b/test/usage.js
index cc84d5b..d1d5205 100644
--- a/test/usage.js
+++ b/test/usage.js
@@ -3673,4 +3673,122 @@ describe('usage tests', () => {
       '  --small    Packet size'
     ])
   })
+
+  describe('single-character aliases ordering (#1403)', () => {
+    it('lists single-char alias before long form for options declared with option()', () => {
+      const r = checkUsage(() => yargs('--help')
+        .option('verbose', { alias: 'v', describe: 'Explain', type: 'boolean' })
+        .wrap(null)
+        .parse()
+      )
+      const lines = r.logs[0].split('\n')
+      const verboseLine = lines.find(l => l.indexOf('--verbose') >= 0)
+      verboseLine.should.equal('  -v, --verbose  Explain  [boolean]')
+
+      verboseLine.indexOf('--verbose, -v').should.equal(-1)
+    })
+
+    it('lists single-char alias before long form when alias is added via .alias()', () => {
+      const r = checkUsage(() => yargs('--help')
+        .alias('help', 'h')
+        .wrap(null)
+        .parse()
+      )
+      const lines = r.logs[0].split('\n')
+      const helpLine = lines.find(l => l.indexOf('--help') >= 0)
+
+      helpLine.indexOf('-h').should.be.lessThan(helpLine.indexOf('--help'))
+      helpLine.indexOf('--help, -h').should.equal(-1)
+    })
+
+    it('indents long-only options to align with options that have a short alias', () => {
+      const r = checkUsage(() => yargs('--help')
+        .option('verbose', { alias: 'v', describe: 'Explain', type: 'boolean' })
+        .option('xx', { describe: 'just xx' })
+        .wrap(null)
+        .parse()
+      )
+      const lines = r.logs[0].split('\n')
+
+      const verboseLine = lines.find(l => l.indexOf('--verbose') >= 0)
+      verboseLine.should.equal('  -v, --verbose  Explain  [boolean]')
+
+
+      const xxLine = lines.find(l => l.indexOf('--xx') >= 0)
+      xxLine.should.equal('      --xx       just xx')
+
+      xxLine.should.match(/^      --xx/)
+    })
+
+    it('does NOT add extra indent when no option in the group has a short alias', () => {
+      const r = checkUsage(() => yargs('--help')
+        .option('foo', { describe: 'Foo', type: 'boolean' })
+        .option('bar', { describe: 'Bar', type: 'string' })
+        .wrap(null)
+        .parse()
+      )
+      const lines = r.logs[0].split('\n')
+      const fooLine = lines.find(l => l.indexOf('--foo') >= 0)
+      const barLine = lines.find(l => l.indexOf('--bar') >= 0)
+
+      fooLine.should.match(/^  --foo /)
+      barLine.should.match(/^  --bar /)
+      fooLine.should.equal('  --foo      Foo  [boolean]')
+      barLine.should.equal('  --bar      Bar  [string]')
+    })
+
+    it('does not add the `--` prefix or extra indent to positional arguments', () => {
+      const r = checkUsage(() => yargs('cmd --help')
+        .command('cmd <foo>', 'do cmd', (yargs) => {
+          yargs.positional('foo', { describe: 'Foo positional', type: 'string' })
+            .option('verbose', { alias: 'v', describe: 'Explain' })
+        })
+        .wrap(null)
+        .parse()
+      )
+      const lines = r.logs[0].split('\n')
+      const positionalsIdx = lines.findIndex(l => l.indexOf('Positionals:') === 0)
+      positionalsIdx.should.be.greaterThan(-1)
+      const fooLine = lines[positionalsIdx + 1]
+
+      fooLine.should.match(/^  foo /)
+      fooLine.indexOf('--foo').should.equal(-1)
+      fooLine.indexOf('-foo').should.equal(-1)
+    })
+
+    it('indents long-only options across groups when any group has a short alias', () => {
+      const r = checkUsage(() => yargs('--help')
+        .option('verbose', { alias: 'v', describe: 'Explain', type: 'boolean' })
+        .option('output', { alias: 'O', describe: 'Out', type: 'string' })
+        .group(['help'], 'Other:')
+        .group(['verbose', 'output'], 'Main:')
+        .wrap(null)
+        .parse()
+      )
+      const lines = r.logs[0].split('\n')
+
+
+      const helpLine = lines.find(l => l.indexOf('--help') >= 0)
+      helpLine.should.match(/^      --help/)
+
+      const versionLine = lines.find(l => l.indexOf('--version') >= 0)
+      versionLine.should.match(/^      --version/)
+
+      const verboseLine = lines.find(l => l.indexOf('--verbose') >= 0)
+      verboseLine.should.match(/^  -v, --verbose/)
+    })
+
+    it('places multiple short aliases before the long form in the switches column', () => {
+      const r = checkUsage(() => yargs('--help')
+        .option('verbose', { alias: ['v', 'V'], describe: 'Explain', type: 'boolean' })
+        .wrap(null)
+        .parse()
+      )
+      const lines = r.logs[0].split('\n')
+      const verboseLine = lines.find(l => l.indexOf('--verbose') >= 0)
+
+      verboseLine.indexOf('-v').should.be.lessThan(verboseLine.indexOf('--verbose'))
+      verboseLine.indexOf('-V').should.be.lessThan(verboseLine.indexOf('--verbose'))
+    })
+  })
 })
