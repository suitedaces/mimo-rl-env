@@ -1512,3 +1512,113 @@ def test_nested_model_case_insensitive(env):
     assert s.nested.SUB_sub.Val2 == 'v2'
     assert s.nested.SUB_sub.SUB_sub_SuB.VaL3 == 'v3'
     assert s.nested.SUB_sub.SUB_sub_SuB.val4 == 'v4'
+
+
+@pytest.mark.skipif(not dotenv, reason='python-dotenv not installed')
+def test_env_file_with_extra_forbid_issue_repro(tmp_path):
+    """Reproduces the issue: Extra.forbid not applied with env_file (explicit forbid)."""
+    p = tmp_path / '.env.test'
+    p.write_text('title="cool stuff"\nother=42\n')
+
+    class Plop(BaseSettings):
+        title: str
+
+        model_config = ConfigDict(extra='forbid', env_file=p)
+
+    with pytest.raises(ValidationError) as exc_info:
+        Plop()
+
+    errors = exc_info.value.errors()
+    error_locs = {err['loc'][0] for err in errors}
+    assert 'other' in error_locs
+    assert all(err['type'] == 'extra_forbidden' for err in errors if err['loc'][0] == 'other')
+
+
+@pytest.mark.skipif(not dotenv, reason='python-dotenv not installed')
+def test_env_file_with_default_extra_forbid(tmp_path):
+    """BaseSettings defaults to extra='forbid' — must still apply when env_file is used."""
+    p = tmp_path / '.env'
+    p.write_text('title=cool\nother=42\n')
+
+    class Plop(BaseSettings):
+        title: str
+
+
+        model_config = ConfigDict(env_file=p)
+
+    with pytest.raises(ValidationError) as exc_info:
+        Plop()
+    error_locs = {err['loc'][0] for err in exc_info.value.errors()}
+    assert 'other' in error_locs
+
+
+@pytest.mark.skipif(not dotenv, reason='python-dotenv not installed')
+def test_env_file_with_extra_allow_exposes_extra_fields(tmp_path):
+    """extra='allow' with env_file: extra fields should be exposed on the instance."""
+    p = tmp_path / '.env'
+    p.write_text('title=cool\nother=hello\n')
+
+    class Plop(BaseSettings):
+        title: str
+
+        model_config = ConfigDict(extra='allow', env_file=p)
+
+    s = Plop()
+    assert s.title == 'cool'
+    assert s.model_dump() == {'title': 'cool', 'other': 'hello'}
+    assert getattr(s, 'other', None) == 'hello'
+
+
+@pytest.mark.skipif(not dotenv, reason='python-dotenv not installed')
+def test_env_file_with_extra_ignore_drops_extras(tmp_path):
+    """extra='ignore' with env_file: extra fields are silently dropped — no error."""
+    p = tmp_path / '.env'
+    p.write_text('title=cool\nother=hello\n')
+
+    class Plop(BaseSettings):
+        title: str
+
+        model_config = ConfigDict(extra='ignore', env_file=p)
+
+    s = Plop()
+    assert s.title == 'cool'
+    assert s.model_dump() == {'title': 'cool'}
+    assert not hasattr(s, 'other') or getattr(s, 'other', None) is None
+
+
+@pytest.mark.skipif(not dotenv, reason='python-dotenv not installed')
+def test_env_file_no_extras_with_extra_forbid(tmp_path):
+    """Preservation: env_file with only valid fields under extra='forbid' must succeed."""
+    p = tmp_path / '.env'
+    p.write_text('title=cool\nname=alice\n')
+
+    class Plop(BaseSettings):
+        title: str
+        name: str
+
+        model_config = ConfigDict(extra='forbid', env_file=p)
+
+    s = Plop()
+    assert s.title == 'cool'
+    assert s.name == 'alice'
+
+
+@pytest.mark.skipif(not dotenv, reason='python-dotenv not installed')
+def test_env_file_nested_delimiter_no_extra_error(tmp_path):
+    """Preservation: nested env vars from env_file with env_nested_delimiter
+    should populate the nested model — first segment is the model field name, not an extra."""
+    p = tmp_path / '.env'
+    p.write_text('top__apple=red\ntop__banana=yellow\n')
+
+    class Top(BaseModel):
+        apple: str
+        banana: str
+
+    class Settings(BaseSettings):
+        top: Top
+
+        model_config = ConfigDict(env_file=p, env_nested_delimiter='__')
+
+    s = Settings()
+    assert s.top.apple == 'red'
+    assert s.top.banana == 'yellow'
