+func TestInterfaceExtensions(t *testing.T) {
+	type (
+		Performer interface {
+			perform()
+		}
+		StageActor struct {
+			Performer
+			Name string `spec:",name"`
+			Role string `spec:"role"`
+		}
+		StageProp struct {
+			Name string `spec:",name"`
+			Kind string `spec:"kind"`
+		}
+		StageCast struct {
+			Performer Performer `spec:""`
+		}
+		Theater struct {
+			Cast *StageCast `spec:"theater"`
+		}
+
+		Creature interface {
+			creature()
+		}
+		SongBird struct {
+			Creature
+			Name string `spec:",name"`
+			Song string `spec:"song"`
+		}
+		ReefFish struct {
+			Creature
+			Name  string `spec:",name"`
+			Color string `spec:"color"`
+		}
+		Aquarium struct {
+			Creatures []Creature `spec:""`
+		}
+		AquariumDoc struct {
+			Aquarium *Aquarium `spec:"aquarium"`
+		}
+	)
+
+	schemaspec.Register("atlas245_stage_actor", &StageActor{})
+	schemaspec.Register("atlas245_stage_prop", &StageProp{})
+	schemaspec.Register("atlas245_song_bird", &SongBird{})
+	schemaspec.Register("atlas245_reef_fish", &ReefFish{})
+
+	t.Run("single_via_hcl", func(t *testing.T) {
+		f := `
+theater "main" {
+	atlas245_stage_prop "curtain" {
+		kind = "fabric"
+	}
+	atlas245_stage_actor "ada" {
+		role = "lead"
+	}
+}
+`
+		var doc Theater
+		err := Unmarshal([]byte(f), &doc)
+		require.NoError(t, err)
+		require.NotNil(t, doc.Cast)
+		actor, ok := doc.Cast.Performer.(*StageActor)
+		require.Truef(t, ok, "unexpected performer type %T", doc.Cast.Performer)
+		require.Equal(t, "ada", actor.Name)
+		require.Equal(t, "lead", actor.Role)
+	})
+
+	t.Run("slice_via_hcl", func(t *testing.T) {
+		f := `
+aquarium "reef" {
+	atlas245_song_bird "lark" {
+		song = "bright"
+	}
+	atlas245_reef_fish "goby" {
+		color = "blue"
+	}
+}
+`
+		var doc AquariumDoc
+		err := Unmarshal([]byte(f), &doc)
+		require.NoError(t, err)
+		require.NotNil(t, doc.Aquarium)
+		require.Len(t, doc.Aquarium.Creatures, 2)
+
+		var got []string
+		for _, c := range doc.Aquarium.Creatures {
+			switch c := c.(type) {
+			case *SongBird:
+				got = append(got, "bird:"+c.Name+":"+c.Song)
+			case *ReefFish:
+				got = append(got, "fish:"+c.Name+":"+c.Color)
+			default:
+				t.Fatalf("unexpected creature type %T", c)
+			}
+		}
+		require.ElementsMatch(t, []string{
+			"bird:lark:bright",
+			"fish:goby:blue",
+		}, got)
+	})
+
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test ./schema/schemaspec/ -run '^(TestInvalidExt|TestExtension|TestNested|TestRef|TestListRef)$' -v -count=1
+    go test ./schema/schemaspec/schemahcl/ -run '^(TestAttributes|TestResource|ExampleUnmarshal|ExampleMarshal)$' -v -count=1
+    ;;
+  new)
+    go test ./schema/schemaspec/ -run '^(TestResourceAsInterfaceRemainder|TestResourceAsSingleInterfaceAmbiguity)$' -v -count=1
+    go test ./schema/schemaspec/schemahcl/ -run '^TestInterfaceExtensions$' -v -count=1
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
