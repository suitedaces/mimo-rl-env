+func TestResourceAsInterfaceRemainder(t *testing.T) {
+	type (
+		RemainderThing interface {
+			remainderThing()
+		}
+		RemainderGem struct {
+			RemainderThing
+			Name string `spec:",name"`
+		}
+		RemainderOre struct {
+			RemainderThing
+			Name string `spec:",name"`
+		}
+		RemainderBin struct {
+			schemaspec.DefaultExtension
+			Things []RemainderThing `spec:""`
+		}
+	)
+
+	const (
+		gemType     = "atlas245_remainder_gem"
+		oreType     = "atlas245_remainder_ore"
+		leftoverTyp = "atlas245_remainder_leftover"
+	)
+	schemaspec.Register(gemType, &RemainderGem{})
+	schemaspec.Register(oreType, &RemainderOre{})
+
+	t.Run("interface_slice_consumes_matching_children", func(t *testing.T) {
+		res := &schemaspec.Resource{
+			Type: "atlas245_remainder_bin",
+			Children: []*schemaspec.Resource{
+				{Type: gemType, Name: "ruby"},
+				{Type: leftoverTyp, Name: "tail"},
+				{Type: oreType, Name: "iron"},
+			},
+		}
+
+		var bin RemainderBin
+		require.NoError(t, res.As(&bin))
+		require.Len(t, bin.Things, 2)
+
+		var got []string
+		for _, thing := range bin.Things {
+			switch thing := thing.(type) {
+			case *RemainderGem:
+				got = append(got, fmt.Sprintf("%s:%s", gemType, thing.Name))
+			case *RemainderOre:
+				got = append(got, fmt.Sprintf("%s:%s", oreType, thing.Name))
+			default:
+				t.Fatalf("unexpected thing type %T", thing)
+			}
+		}
+		require.ElementsMatch(t, []string{gemType + ":ruby", oreType + ":iron"}, got)
+
+		var remainTypes []string
+		require.NotNil(t, bin.Remain())
+		for _, child := range bin.Remain().Children {
+			remainTypes = append(remainTypes, child.Type)
+		}
+		require.ElementsMatch(t, []string{leftoverTyp}, remainTypes)
+	})
+}
+
+func TestResourceAsSingleInterfaceAmbiguity(t *testing.T) {
+	type (
+		Control interface {
+			control()
+		}
+		ToggleSwitch struct {
+			Control
+			Name string `spec:",name"`
+			Mode string `spec:"mode"`
+		}
+		RotaryKnob struct {
+			Control
+			Name string `spec:",name"`
+			Step string `spec:"step"`
+		}
+		ControlLabel struct {
+			Name string `spec:",name"`
+			Text string `spec:"text"`
+		}
+		Panel struct {
+			Control Control `spec:""`
+		}
+	)
+
+	const (
+		switchType = "atlas245_toggle_switch"
+		knobType   = "atlas245_rotary_knob"
+		labelType  = "atlas245_control_label"
+	)
+	schemaspec.Register(switchType, &ToggleSwitch{})
+	schemaspec.Register(knobType, &RotaryKnob{})
+	schemaspec.Register(labelType, &ControlLabel{})
+
+	res := &schemaspec.Resource{
+		Type: "atlas245_panel",
+		Children: []*schemaspec.Resource{
+			{Type: labelType, Name: "title"},
+			{Type: switchType, Name: "power"},
+			{Type: knobType, Name: "volume"},
+		},
+	}
+
+	var panel Panel
+	err := res.As(&panel)
+
+	require.EqualError(t, err, fmt.Sprintf(
+		"more than one blocks implement %q",
+		reflect.TypeOf((*Control)(nil)).Elem(),
+	))
+}
