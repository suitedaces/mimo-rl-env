+
+func TestConstantGlobNamedInclude(t *testing.T) {
+	checkFindings(t, "constant-glob", `
+glob(include = ["foo.py"])`,
+		[]string{`:1: Glob pattern "foo.py" has no wildcard`},
+		scopeBuild|scopeBzl|scopeWorkspace)
+}
+
+
+func TestConstantGlobNamedIncludeWildcard(t *testing.T) {
+	checkFindings(t, "constant-glob", `
+glob(include = ["*.py"])`,
+		[]string{},
+		scopeBuild|scopeBzl|scopeWorkspace)
+}
+
+
+func TestConstantGlobNamedIncludeMixed(t *testing.T) {
+	checkFindings(t, "constant-glob", `
+cc_library(srcs = glob(include = [
+    "*.cc",
+    "test.cpp",
+]))`,
+		[]string{`:3: Glob pattern "test.cpp" has no wildcard`},
+		scopeBuild|scopeBzl|scopeWorkspace)
+}
+
+
+
+func TestConstantGlobOnlyExcludeNoWarning(t *testing.T) {
+	checkFindings(t, "constant-glob", `
+glob(exclude = ["foo.py"])`,
+		[]string{},
+		scopeBuild|scopeBzl|scopeWorkspace)
+}
+
+
+
+func TestConstantGlobExcludeThenInclude(t *testing.T) {
+	checkFindings(t, "constant-glob", `
+glob(exclude = ["other.py"], include = ["foo.py"])`,
+		[]string{`:1: Glob pattern "foo.py" has no wildcard`},
+		scopeBuild|scopeBzl|scopeWorkspace)
+}
+
+
+
+func TestConstantGlobUnknownNamedArgNoWarning(t *testing.T) {
+	checkFindings(t, "constant-glob", `
+glob(other = ["foo.py"])`,
+		[]string{},
+		scopeBuild|scopeBzl|scopeWorkspace)
+}
+
+
+func TestConstantGlobPositionalWithExclude(t *testing.T) {
+	checkFindings(t, "constant-glob", `
+glob(["foo.py"], exclude = ["other.py"])`,
+		[]string{`:1: Glob pattern "foo.py" has no wildcard`},
+		scopeBuild|scopeBzl|scopeWorkspace)
+}
+
+
+func TestConstantGlobNoArgs(t *testing.T) {
+	checkFindings(t, "constant-glob", `
+glob()`,
+		[]string{},
+		scopeBuild|scopeBzl|scopeWorkspace)
+}
