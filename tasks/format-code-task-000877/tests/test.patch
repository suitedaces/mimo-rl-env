+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+cmake -S . -B .fixture-build \
+  -DRC_ENABLE_TESTS=OFF \
+  -DRC_ENABLE_EXAMPLES=OFF \
+  -DRC_INSTALL_ALL_EXTRAS=OFF \
+  -DRC_ENABLE_CATCH=OFF \
+  -DRC_ENABLE_DOCTEST=OFF \
+  -DRC_ENABLE_GMOCK=OFF \
+  -DRC_ENABLE_GTEST=OFF \
+  -DRC_ENABLE_BOOST=OFF \
+  -DRC_ENABLE_BOOST_TEST=OFF >/dev/null
+cmake --build .fixture-build --target rapidcheck -j"$(nproc)" >/dev/null
+
+c++ -std=c++11 -Wall -Wextra \
+  -I/workspace/repo/include \
+  /workspace/repo/usercase-test-coderl/unique_acceptance.cpp \
+  /workspace/repo/.fixture-build/librapidcheck.a \
+  -Wl,--wrap=socket \
+  -Wl,--wrap=connect \
+  -Wl,--wrap=getaddrinfo \
+  -o /workspace/repo/.fixture-build/unique_acceptance
+
+tmpdir="$(mktemp -d)"
+trap 'rm -rf "$tmpdir"' EXIT
+cd "$tmpdir"
+exec /workspace/repo/.fixture-build/unique_acceptance
