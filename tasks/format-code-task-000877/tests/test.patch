diff --git a/usercase-test-coderl/unique_acceptance.cpp b/usercase-test-coderl/unique_acceptance.cpp
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/unique_acceptance.cpp
@@ -0,0 +1,405 @@
+
+
+
+
+
+
+
+#include <rapidcheck.h>
+#include <rapidcheck/GenerationFailure.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <dirent.h>
+#include <exception>
+#include <netdb.h>
+#include <iostream>
+#include <list>
+#include <set>
+#include <sys/socket.h>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+using Pair = std::pair<int, int>;
+
+int g_networkCalls = 0;
+
+extern "C" int __wrap_socket(int, int, int) {
+  ++g_networkCalls;
+  return -1;
+}
+
+extern "C" int __wrap_connect(int, const struct sockaddr *, socklen_t) {
+  ++g_networkCalls;
+  return -1;
+}
+
+extern "C" int __wrap_getaddrinfo(const char *,
+                                  const char *,
+                                  const struct addrinfo *,
+                                  struct addrinfo **) {
+  ++g_networkCalls;
+  return EAI_FAIL;
+}
+
+template <typename T>
+rc::Shrinkable<T> shrinkableWithShrinks(const T &value, std::vector<T> shrinks) {
+  std::vector<rc::Shrinkable<T>> shrinkables;
+  for (const auto &shrink : shrinks) {
+    shrinkables.push_back(rc::shrinkable::just(shrink));
+  }
+  return rc::shrinkable::just(
+      value, rc::seq::fromContainer(std::move(shrinkables)));
+}
+
+rc::Gen<int> wideIntGen() {
+  return [](const rc::Random &random, int) {
+    auto r = random;
+    const auto bucket = static_cast<int>(r.next() % 16);
+    const auto value = 10 + (bucket * 10);
+    return shrinkableWithShrinks<int>(value, {value - 10, value - 7});
+  };
+}
+
+rc::Gen<Pair> widePairGen() {
+  return [](const rc::Random &random, int) {
+    auto r = random;
+    const auto bucket = static_cast<int>(r.next() % 8);
+    const auto key = bucket + 1;
+    return shrinkableWithShrinks<Pair>(
+        {key, 100}, {{key - 1, 100}, {key, 50}, {key + 1, 100}});
+  };
+}
+
+rc::Gen<Pair> singleKeyPairGen() {
+  return [](const rc::Random &random, int) {
+    auto r = random;
+    const auto value = static_cast<int>(r.next() % 32);
+    return shrinkableWithShrinks<Pair>({0, value}, {{0, value / 2}});
+  };
+}
+
+template <typename Container>
+std::vector<typename Container::value_type> toVector(const Container &container) {
+  return std::vector<typename Container::value_type>(container.begin(),
+                                                    container.end());
+}
+
+std::string showInts(const std::vector<int> &values) {
+  std::ostringstream os;
+  os << "{";
+  for (std::size_t i = 0; i < values.size(); ++i) {
+    if (i != 0) {
+      os << ", ";
+    }
+    os << values[i];
+  }
+  os << "}";
+  return os.str();
+}
+
+std::string showPairs(const std::vector<Pair> &values) {
+  std::ostringstream os;
+  os << "{";
+  for (std::size_t i = 0; i < values.size(); ++i) {
+    if (i != 0) {
+      os << ", ";
+    }
+    os << "{" << values[i].first << ", " << values[i].second << "}";
+  }
+  os << "}";
+  return os.str();
+}
+
+template <typename Container>
+std::vector<Container> firstShrinks(rc::Shrinkable<Container> shrinkable,
+                                    int limit) {
+  std::vector<Container> out;
+  auto shrinks = shrinkable.shrinks();
+  for (int i = 0; i < limit; ++i) {
+    auto next = shrinks.next();
+    if (!next) {
+      break;
+    }
+    out.push_back(next->value());
+  }
+  return out;
+}
+
+void require(bool condition, const std::string &message) {
+  if (!condition) {
+    throw std::runtime_error(message);
+  }
+}
+
+void requireEqual(const std::vector<int> &actual,
+                  const std::vector<int> &expected,
+                  const std::string &label) {
+  if (actual != expected) {
+    throw std::runtime_error(label + ": expected " + showInts(expected) +
+                             ", got " + showInts(actual));
+  }
+}
+
+void requireEqual(const std::vector<Pair> &actual,
+                  const std::vector<Pair> &expected,
+                  const std::string &label) {
+  if (actual != expected) {
+    throw std::runtime_error(label + ": expected " + showPairs(expected) +
+                             ", got " + showPairs(actual));
+  }
+}
+
+void requireIntShrinks(const std::vector<std::vector<int>> &actual,
+                       const std::vector<std::vector<int>> &expected,
+                       const std::string &label) {
+  require(actual.size() == expected.size(),
+          label + ": expected " + std::to_string(expected.size()) +
+              " shrinks, got " + std::to_string(actual.size()));
+  for (std::size_t i = 0; i < expected.size(); ++i) {
+    requireEqual(actual[i], expected[i],
+                 label + " shrink " + std::to_string(i));
+  }
+}
+
+void requirePairShrinks(const std::vector<std::vector<Pair>> &actual,
+                        const std::vector<std::vector<Pair>> &expected,
+                        const std::string &label) {
+  require(actual.size() == expected.size(),
+          label + ": expected " + std::to_string(expected.size()) +
+              " shrinks, got " + std::to_string(actual.size()));
+  for (std::size_t i = 0; i < expected.size(); ++i) {
+    requireEqual(actual[i], expected[i],
+                 label + " shrink " + std::to_string(i));
+  }
+}
+
+template <typename T>
+bool allDistinct(const std::vector<T> &values) {
+  return std::set<T>(values.begin(), values.end()).size() == values.size();
+}
+
+bool allDistinctKeys(const std::vector<Pair> &values) {
+  std::set<int> keys;
+  for (const auto &value : values) {
+    keys.insert(value.first);
+  }
+  return keys.size() == values.size();
+}
+
+std::set<std::string> directoryEntries(const std::string &path) {
+  std::set<std::string> entries;
+  DIR *dir = opendir(path.c_str());
+  if (dir == nullptr) {
+    throw std::runtime_error("could not open directory " + path);
+  }
+
+  while (auto *entry = readdir(dir)) {
+    const std::string name(entry->d_name);
+    if ((name != ".") && (name != "..")) {
+      entries.insert(name);
+    }
+  }
+  closedir(dir);
+  return entries;
+}
+
+void testVariableVectorUniqueValuesAndShrinks() {
+
+
+  const auto generated =
+      rc::gen::unique<std::vector<int>>(wideIntGen())(rc::Random(0), 4);
+
+  require(allDistinct(generated.value()),
+          "variable vector generated value has duplicates");
+
+  const auto shrinks = firstShrinks(generated, 11);
+
+  for (const auto &shrink : shrinks) {
+    require(allDistinct(shrink), "variable vector shrink has duplicates");
+  }
+}
+
+void testFixedListHasRequestedLengthAndUniqueShrinks() {
+
+
+  const auto generated =
+      rc::gen::unique<std::list<int>>(3, wideIntGen())(rc::Random(2), 4);
+
+  require(generated.value().size() == 3, "fixed list generated length");
+  require(allDistinct(toVector(generated.value())),
+          "fixed list generated value has duplicates");
+
+  const auto rawShrinks = firstShrinks(generated, 6);
+  std::vector<std::vector<int>> shrinks;
+  for (const auto &shrink : rawShrinks) {
+    shrinks.push_back(toVector(shrink));
+  }
+
+  for (const auto &shrink : shrinks) {
+    require(shrink.size() == 3, "fixed list shrink changed requested length");
+    require(allDistinct(shrink), "fixed list shrink has duplicates");
+  }
+}
+
+void testVariableUniqueByUsesProjectedKeyOnly() {
+
+
+  const auto keyFn = [](const Pair &p) { return p.first; };
+  const auto generated =
+      rc::gen::uniqueBy<std::vector<Pair>>(widePairGen(), keyFn)(rc::Random(0),
+                                                                 4);
+
+  require(allDistinctKeys(generated.value()),
+          "variable uniqueBy generated value has duplicate keys");
+
+  const auto shrinks = firstShrinks(generated, 12);
+
+  for (const auto &shrink : shrinks) {
+    require(allDistinctKeys(shrink), "variable uniqueBy shrink has duplicate keys");
+  }
+}
+
+void testFixedUniqueByHasRequestedLengthAndKeys() {
+
+
+  const auto keyFn = [](const Pair &p) { return p.first; };
+  const auto generated = rc::gen::uniqueBy<std::vector<Pair>>(
+      2, widePairGen(), keyFn)(rc::Random(99), 4);
+
+  require(generated.value().size() == 2, "fixed uniqueBy generated length");
+  require(allDistinctKeys(generated.value()),
+          "fixed uniqueBy generated value has duplicate keys");
+
+  const auto shrinks = firstShrinks(generated, 6);
+
+  for (const auto &shrink : shrinks) {
+    require(shrink.size() == 2, "fixed uniqueBy shrink changed requested length");
+    require(allDistinctKeys(shrink), "fixed uniqueBy shrink has duplicate keys");
+  }
+}
+
+void testImpossibleUniqueThrowsGenerationFailure() {
+
+
+  const auto impossible = rc::gen::unique<std::vector<int>>(2, rc::gen::just(0));
+  try {
+    (void)impossible(rc::Random(9), 3).value();
+  } catch (const rc::GenerationFailure &e) {
+
+    (void)e;
+    return;
+  }
+  throw std::runtime_error("expected rc::GenerationFailure");
+}
+
+void testImpossibleUniqueByThrowsGenerationFailure() {
+  const auto keyFn = [](const Pair &p) { return p.first; };
+
+  const auto impossible =
+      rc::gen::uniqueBy<std::vector<Pair>>(2, singleKeyPairGen(), keyFn);
+  try {
+    (void)impossible(rc::Random(11), 4).value();
+  } catch (const rc::GenerationFailure &e) {
+
+    (void)e;
+    return;
+  }
+  throw std::runtime_error("expected rc::GenerationFailure for duplicate keys");
+}
+
+void testReferentialTransparencyForSameGeneratorEvaluation() {
+  const auto generator = rc::gen::unique<std::vector<int>>(wideIntGen());
+  const auto first = generator(rc::Random(3), 4).value();
+  const auto second = generator(rc::Random(3), 4).value();
+
+  require(first == second, "same generator/random/size produced different values");
+}
+
+void testCreatingUniqueDoesNotMutateSuppliedGeneratorObject() {
+  const auto source = wideIntGen();
+  const auto before = source(rc::Random(12), 4).value();
+  const auto unique = rc::gen::unique<std::vector<int>>(source);
+  (void)unique;
+  const auto after = source(rc::Random(12), 4).value();
+
+  require(before == after, "creating unique mutated supplied generator object");
+}
+
+void testNoHiddenGlobalStateWithInProcessNoise() {
+  const auto original = rc::gen::unique<std::vector<int>>(wideIntGen());
+  const auto baseline = original(rc::Random(5), 4).value();
+
+  (void)rc::gen::unique<std::list<int>>(3, wideIntGen())(rc::Random(42), 4)
+      .value();
+  const auto keyFn = [](const Pair &p) { return p.first; };
+  (void)rc::gen::uniqueBy<std::vector<Pair>>(2, widePairGen(), keyFn)(
+      rc::Random(17), 4).value();
+
+  const auto afterNoise = original(rc::Random(5), 4).value();
+
+  require(baseline == afterNoise, "in-process generator noise affected result");
+}
+
+void testNoRelativeFilesystemSideEffects() {
+  const std::string cwd = ".";
+  const auto before = directoryEntries(cwd);
+  const auto networkBefore = g_networkCalls;
+
+  const auto keyFn = [](const Pair &p) { return p.first; };
+  (void)rc::gen::unique<std::vector<int>>(wideIntGen())(rc::Random(1), 4)
+      .value();
+  (void)rc::gen::unique<std::list<int>>(3, wideIntGen())(rc::Random(1), 4)
+      .value();
+  (void)rc::gen::uniqueBy<std::vector<Pair>>(widePairGen(), keyFn)(
+      rc::Random(1), 4).value();
+  (void)rc::gen::uniqueBy<std::vector<Pair>>(2, widePairGen(), keyFn)(
+      rc::Random(1), 4).value();
+
+  const auto after = directoryEntries(cwd);
+  require(before == after, "generator evaluation changed cwd entries");
+  require(g_networkCalls == networkBefore, "generator evaluation touched network APIs");
+}
+
+int main() {
+  const std::vector<std::pair<std::string, void (*)()>> tests = {
+      {"variable vector unique values and shrinks",
+       &testVariableVectorUniqueValuesAndShrinks},
+      {"fixed list requested length and unique shrinks",
+       &testFixedListHasRequestedLengthAndUniqueShrinks},
+      {"variable uniqueBy projected key", &testVariableUniqueByUsesProjectedKeyOnly},
+      {"fixed uniqueBy requested length and keys",
+       &testFixedUniqueByHasRequestedLengthAndKeys},
+      {"impossible unique throws GenerationFailure",
+       &testImpossibleUniqueThrowsGenerationFailure},
+      {"impossible uniqueBy throws GenerationFailure",
+       &testImpossibleUniqueByThrowsGenerationFailure},
+      {"referential transparency",
+       &testReferentialTransparencyForSameGeneratorEvaluation},
+      {"no mutation of supplied generator object",
+       &testCreatingUniqueDoesNotMutateSuppliedGeneratorObject},
+      {"no hidden global state", &testNoHiddenGlobalStateWithInProcessNoise},
+      {"no relative filesystem side effects", &testNoRelativeFilesystemSideEffects},
+  };
+
+  int failures = 0;
+  for (const auto &test : tests) {
+    try {
+      test.second();
+      std::cout << "PASS " << test.first << "\n";
+    } catch (const std::exception &e) {
+      ++failures;
+      std::cerr << "FAIL " << test.first << ": " << e.what() << "\n";
+    }
+  }
+
+  if (failures != 0) {
+    std::cerr << failures << " acceptance test(s) failed\n";
+    return EXIT_FAILURE;
+  }
+  return EXIT_SUCCESS;
+}
