+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+REPO=/workspace/repo
+FIXTURES="$REPO/usercase-test-coderl/fixtures"
+VENV=/opt/urlwatch-stage4a-coderl-venv
+
+
+
+BIN="$VENV/bin/urlwatch"
+[ -x "$BIN" ] || fail "missing urlwatch binary at $BIN"
+
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || fail "cd tmp"
+
+write_config() {
+    printf '%s\n' '---' > "$1/config.yaml"
+}
+
+run_urlwatch() {
+    case_name=$1
+    shift
+    mkdir -p "$TMP/$case_name"
+    write_config "$TMP/$case_name"
+    PYTHONPATH="$FIXTURES" "$BIN" \
+        --urls "$TMP/$case_name/jobs.yaml" \
+        --cache "$TMP/$case_name/cache.db" \
+        --config "$TMP/$case_name/config.yaml" \
+        "$@" >"$TMP/$case_name/out" 2>"$TMP/$case_name/err"
+    ec=$?
+}
+
+
+
+
+cat > "$TMP/f1_jobs" <<'YAML'
+---
+kind: browser
+navigate: "http://127.0.0.1:8000/page.html"
+YAML
+cp "$TMP/f1_jobs" "$TMP/f1/jobs.yaml" 2>/dev/null || { mkdir -p "$TMP/f1"; cp "$TMP/f1_jobs" "$TMP/f1/jobs.yaml"; }
+run_urlwatch f1 --test-filter 1
+EXPECTED='<html><head></head><body><main id="rendered">script-added for http://127.0.0.1:8000/page.html</main><span id="browser">chromium</span><span id="ua">None</span><span id="wait_until">None</span><span id="wait_for">None</span></body></html>'
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+
+grep -q '<main id="rendered">script-added for http://127.0.0.1:8000/page.html</main>' "$TMP/f1/out" || fail "F1 stdout missing rendered page: $(cat "$TMP/f1/out")"
+grep -q '<span id="browser">chromium</span>' "$TMP/f1/out" || fail "F1 stdout missing Chromium default: $(cat "$TMP/f1/out")"
+[ ! -s "$TMP/f1/err" ] || fail "F1 unexpected stderr: $(cat "$TMP/f1/err")"
+
+
+
+
+mkdir -p "$TMP/f2"
+cat > "$TMP/f2/jobs.yaml" <<'YAML'
+---
+navigate: "http://127.0.0.1:8000/app.html"
+browser: firefox
+useragent: "FixtureBot/1.0"
+wait_until: domcontentloaded
+wait_for: "#ready"
+YAML
+run_urlwatch f2 --test-filter 1
+EXPECTED='<html><head></head><body><main id="rendered">script-added for http://127.0.0.1:8000/app.html</main><span id="browser">firefox</span><span id="ua">FixtureBot/1.0</span><span id="wait_until">domcontentloaded</span><span id="wait_for">#ready</span></body></html>'
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+[ "$(cat "$TMP/f2/out")" = "$EXPECTED" ] || fail "F2 stdout: $(cat "$TMP/f2/out")"
+[ ! -s "$TMP/f2/err" ] || fail "F2 unexpected stderr: $(cat "$TMP/f2/err")"
+
+
+
+
+mkdir -p "$TMP/f3"
+cat > "$TMP/f3/jobs.yaml" <<'YAML'
+---
+kind: browser
+navigate: "http://127.0.0.1:8000/xpath.html"
+wait_until: commit
+wait_for: "xpath=//section[@id='ready']"
+YAML
+run_urlwatch f3 --test-filter 1
+EXPECTED='<html><head></head><body><main id="rendered">script-added for http://127.0.0.1:8000/xpath.html</main><span id="browser">chromium</span><span id="ua">None</span><span id="wait_until">commit</span><span id="wait_for">xpath=//section[@id='"'"'ready'"'"']</span></body></html>'
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+[ "$(cat "$TMP/f3/out")" = "$EXPECTED" ] || fail "F3 stdout: $(cat "$TMP/f3/out")"
+[ ! -s "$TMP/f3/err" ] || fail "F3 unexpected stderr: $(cat "$TMP/f3/err")"
+
+
+
+
+mkdir -p "$TMP/f4"
+cat > "$TMP/f4/jobs.yaml" <<'YAML'
+---
+kind: browser
+navigate: "http://127.0.0.1:8000/legacy0.html"
+wait_until: networkidle0
+YAML
+run_urlwatch f4 -v --test-filter 1
+EXPECTED='<html><head></head><body><main id="rendered">script-added for http://127.0.0.1:8000/legacy0.html</main><span id="browser">chromium</span><span id="ua">None</span><span id="wait_until">networkidle</span><span id="wait_for">None</span></body></html>'
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+[ "$(cat "$TMP/f4/out")" = "$EXPECTED" ] || fail "F4 stdout: $(cat "$TMP/f4/out")"
+
+grep -qi 'networkidle0' "$TMP/f4/err" || fail "F4 warning should mention networkidle0: $(cat "$TMP/f4/err")"
+
+
+
+
+mkdir -p "$TMP/f5"
+cat > "$TMP/f5/jobs.yaml" <<'YAML'
+---
+kind: browser
+navigate: "http://127.0.0.1:8000/legacy2.html"
+wait_until: networkidle2
+YAML
+run_urlwatch f5 -v --test-filter 1
+EXPECTED='<html><head></head><body><main id="rendered">script-added for http://127.0.0.1:8000/legacy2.html</main><span id="browser">chromium</span><span id="ua">None</span><span id="wait_until">networkidle</span><span id="wait_for">None</span></body></html>'
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+[ "$(cat "$TMP/f5/out")" = "$EXPECTED" ] || fail "F5 stdout: $(cat "$TMP/f5/out")"
+
+grep -qi 'networkidle2' "$TMP/f5/err" || fail "F5 warning should mention networkidle2: $(cat "$TMP/f5/err")"
+
+
+
+
+mkdir -p "$TMP/f6"
+cat > "$TMP/f6/jobs.yaml" <<'YAML'
+---
+kind: browser
+navigate: "http://127.0.0.1:8000/list.html"
+YAML
+run_urlwatch f6 --list
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+
+grep -q 'http://127.0.0.1:8000/list.html' "$TMP/f6/out" || fail "F6 stdout missing navigate URL: $(cat "$TMP/f6/out")"
+[ ! -s "$TMP/f6/err" ] || fail "F6 unexpected stderr: $(cat "$TMP/f6/err")"
+
+
+
+
+mkdir -p "$TMP/f7"
+cat > "$TMP/f7/jobs.yaml" <<'YAML'
+---
+kind: browser
+navigate: "http://127.0.0.1:8000/list-hidden.html"
+user_visible_url: "https://visible.example/rendered"
+YAML
+run_urlwatch f7 --list
+[ "$ec" -eq 0 ] || fail "F7 exit $ec; want 0"
+
+grep -q 'https://visible.example/rendered' "$TMP/f7/out" || fail "F7 stdout missing visible URL: $(cat "$TMP/f7/out")"
+! grep -q 'http://127.0.0.1:8000/list-hidden.html' "$TMP/f7/out" || fail "F7 stdout should not show hidden navigate URL: $(cat "$TMP/f7/out")"
+[ ! -s "$TMP/f7/err" ] || fail "F7 unexpected stderr: $(cat "$TMP/f7/err")"
+
+
+
+
+mkdir -p "$TMP/f8"
+cat > "$TMP/f8/jobs.yaml" <<'YAML'
+---
+kind: browser
+navigate: "http://127.0.0.1:8000/change-before.html"
+YAML
+run_urlwatch f8 --change-location 1 http://127.0.0.1:8000/other.html
+[ "$ec" -eq 0 ] || fail "F8 exit $ec; want 0"
+
+mkdir -p "$TMP/f8_verify"
+cp "$TMP/f8/jobs.yaml" "$TMP/f8_verify/jobs.yaml"
+run_urlwatch f8_verify --list
+[ "$ec" -eq 0 ] || fail "F8 list exit $ec; want 0"
+grep -q 'http://127.0.0.1:8000/other.html' "$TMP/f8_verify/out" || fail "F8 list stdout missing updated URL: $(cat "$TMP/f8_verify/out")"
+! grep -q 'http://127.0.0.1:8000/change-before.html' "$TMP/f8_verify/out" || fail "F8 list stdout should not show old URL: $(cat "$TMP/f8_verify/out")"
+[ ! -s "$TMP/f8/err" ] || fail "F8 unexpected stderr: $(cat "$TMP/f8/err")"
+
+
+
+
+mkdir -p "$TMP/f9"
+cat > "$TMP/f9/jobs.yaml" <<'YAML'
+---
+kind: browser
+navigate: "http://127.0.0.1:8000/missing.html"
+YAML
+run_urlwatch f9 --test-filter 1
+[ "$ec" -ne 0 ] || fail "F9 exit $ec; want non-zero"
+[ ! -s "$TMP/f9/out" ] || fail "F9 stdout should be empty: $(cat "$TMP/f9/out")"
+
+[ -s "$TMP/f9/err" ] || fail "F9 stderr should be non-empty"
+
+
+
+
+mkdir -p "$TMP/f10"
+cat > "$TMP/f10/jobs.yaml" <<'YAML'
+---
+kind: browser
+navigate: "http://127.0.0.1:8000/page.html"
+wait_for: "#never"
+YAML
+run_urlwatch f10 --test-filter 1
+[ "$ec" -ne 0 ] || fail "F10 exit $ec; want non-zero"
+[ ! -s "$TMP/f10/out" ] || fail "F10 stdout should be empty: $(cat "$TMP/f10/out")"
+
+[ -s "$TMP/f10/err" ] || fail "F10 stderr should be non-empty"
+
+echo "PASS"
+exit 0
