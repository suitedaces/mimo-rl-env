+class Error(Exception):
+    pass
+
+
+class TimeoutError(Error):
+    pass
+
+
+class FakeLocator:
+    def __init__(self, page, selector):
+        self.page = page
+        self.selector = selector
+
+    def wait_for(self, *args, **kwargs):
+        self.page.waited = self.selector
+        if self.selector in ("#never", "xpath=//never"):
+
+            raise TimeoutError(f"Timeout 30000ms exceeded while waiting for locator {self.selector!r}")
+
+
+class FakePage:
+    def __init__(self, browser_name, user_agent=None):
+        self.browser_name = browser_name
+        self.user_agent = user_agent
+        self.navigated = None
+        self.wait_until = None
+        self.waited = None
+
+    def goto(self, url, wait_until=None, **kwargs):
+        self.navigated = url
+        self.wait_until = wait_until
+        if url.endswith("/missing.html"):
+
+            raise Error("Navigation failed for missing.html")
+        return None
+
+    def locator(self, selector):
+        return FakeLocator(self, selector)
+
+    def wait_for_selector(self, selector, *args, **kwargs):
+        return self.locator(selector).wait_for(*args, **kwargs)
+
+    def content(self):
+        return (
+            "<html><head></head><body>"
+            f"<main id=\"rendered\">script-added for {self.navigated}</main>"
+            f"<span id=\"browser\">{self.browser_name}</span>"
+            f"<span id=\"ua\">{self.user_agent}</span>"
+            f"<span id=\"wait_until\">{self.wait_until}</span>"
+            f"<span id=\"wait_for\">{self.waited}</span>"
+            "</body></html>"
+        )
+
+    def close(self):
+        pass
+
+
+class FakeBrowser:
+    def __init__(self, name):
+        self.name = name
+
+    def launch(self, *args, **kwargs):
+        return self
+
+    def new_page(self, user_agent=None, **kwargs):
+        return FakePage(self.name, user_agent)
+
+    def new_context(self, user_agent=None, **kwargs):
+
+        return FakeBrowserContext(self.name, user_agent)
+
+    def close(self):
+        pass
+
+
+class FakeBrowserContext:
+    def __init__(self, browser_name, user_agent=None):
+        self.browser_name = browser_name
+        self.user_agent = user_agent
+
+    def new_page(self, **kwargs):
+        return FakePage(self.browser_name, kwargs.get("user_agent", self.user_agent))
+
+    def close(self):
+        pass
+
+
+class FakePlaywright:
+    def __getitem__(self, name):
+        return FakeBrowser(name)
+
+    def __getattr__(self, name):
+        if name.startswith("_"):
+            raise AttributeError(name)
+        return FakeBrowser(name)
+
+    def stop(self):
+        pass
+
+
+class FakeContext:
+    def start(self):
+
+        return FakePlaywright()
+
+    def __enter__(self):
+        return FakePlaywright()
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
+
+def sync_playwright():
+    return FakeContext()
