diff --git a/lib/classes/ConfigSchemaHandler/index.test.js b/lib/classes/ConfigSchemaHandler/index.test.js
index c96aaaf32..0aba144a6 100644
--- a/lib/classes/ConfigSchemaHandler/index.test.js
+++ b/lib/classes/ConfigSchemaHandler/index.test.js
@@ -170,4 +170,63 @@ describe('ConfigSchemaHandler', () => {
       });
     });
   });
+
+  describe('#defineFunctionProperties', () => {
+    it('should extend the schema with the function property when provider matches', () => {
+      return runServerless({
+        fixture: 'configSchemaExtensions',
+        cliArgs: ['info'],
+      }).then(serverless => {
+        expect(
+          serverless.serverless.configSchemaHandler.schema.properties.functions.patternProperties[
+            '^[a-zA-Z0-9-_]+$'
+          ].properties.someFunctionStringProp
+        ).to.deep.equal({ type: 'string' });
+      });
+    });
+
+    it('should extend the function schema required list when provider matches', () => {
+      return runServerless({
+        fixture: 'configSchemaExtensions',
+        cliArgs: ['info'],
+      }).then(serverless => {
+        const functionSchema =
+          serverless.serverless.configSchemaHandler.schema.properties.functions.patternProperties[
+            '^[a-zA-Z0-9-_]+$'
+          ];
+        expect(functionSchema.required).to.include('someRequiredFunctionNumberProp');
+      });
+    });
+
+    it('should NOT extend the function schema when providerName does not match', () => {
+      return runServerless({
+        fixture: 'configSchemaExtensions',
+        cliArgs: ['info'],
+      }).then(serverless => {
+        expect(
+          serverless.serverless.configSchemaHandler.schema.properties.functions.patternProperties[
+            '^[a-zA-Z0-9-_]+$'
+          ].properties.someOtherProviderFunctionProp
+        ).to.equal(undefined);
+      });
+    });
+
+    it('should allow function-level custom plugin properties in serverless.yml to validate', () => {
+
+
+
+
+      return runServerless({
+        fixture: 'configSchemaExtensions',
+        cliArgs: ['info'],
+      }).then(serverless => {
+        expect(
+          serverless.serverless.service.functions.someFunction.someFunctionStringProp
+        ).to.equal('a-string-value');
+        expect(
+          serverless.serverless.service.functions.someFunction.someRequiredFunctionNumberProp
+        ).to.equal(123);
+      });
+    });
+  });
 });
