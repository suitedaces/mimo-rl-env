diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,151 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+python3 -m venv --system-site-packages "$TMP/venv" \
+    || fail "could not create virtualenv"
+
+
+PIP_NO_INDEX=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
+"$TMP/venv/bin/python" -m pip install --no-index --no-build-isolation --no-deps -e /workspace/repo \
+    >"$TMP/pip.out" 2>"$TMP/pip.err" \
+    || { cat "$TMP/pip.err" >&2; fail "build/install"; }
+
+BIN="$TMP/venv/bin/trash-rm"
+[ -x "$BIN" ] || fail "trash-rm command was not installed"
+
+RUN="$TMP/run"
+mkdir -p "$RUN"
+cd "$RUN" || fail "cd run dir"
+
+UID_NOW=$(id -u)
+
+assert_empty() {
+    local file="$1" label="$2"
+    [ ! -s "$file" ] || fail "$label: $(cat "$file")"
+}
+
+assert_exists() {
+    local path="$1" label="$2"
+    [ -e "$path" ] || fail "$label missing: $path"
+}
+
+assert_absent() {
+    local path="$1" label="$2"
+    [ ! -e "$path" ] || fail "$label still exists: $path"
+}
+
+make_entry() {
+    local trashdir="$1" name="$2" original_path="$3" payload="$4"
+    mkdir -p "$trashdir/files" "$trashdir/info"
+    printf '%s' "$payload" >"$trashdir/files/$name"
+    printf '[Trash Info]\nPath=%s\nDeletionDate=2026-07-23T00:00:00\n' \
+        "$original_path" >"$trashdir/info/$name.trashinfo"
+}
+
+
+
+
+DATA="$RUN/f1-data"
+VOL="$RUN/f1-volume"
+HOME_TRASH="$DATA/Trash"
+VOL_TRASH="$VOL/.Trash/$UID_NOW"
+mkdir -p "$VOL_TRASH/files" "$VOL_TRASH/info"
+chmod 1777 "$VOL/.Trash"
+make_entry "$HOME_TRASH" home_foo_o tmp/foo.o "home foo object"
+make_entry "$HOME_TRASH" home_bar_o home/me/bar.o "home bar object"
+make_entry "$HOME_TRASH" home_foo_c tmp/foo.c "home c source"
+make_entry "$VOL_TRASH" vol_obj project/vol.o "volume object"
+
+XDG_DATA_HOME="$DATA" TRASH_VOLUMES="$VOL" "$BIN" '*.o' >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_empty out "F1 unexpected stdout"
+assert_empty err "F1 unexpected stderr"
+assert_absent "$HOME_TRASH/files/home_foo_o" "F1 /tmp/foo.o backup"
+assert_absent "$HOME_TRASH/info/home_foo_o.trashinfo" "F1 /tmp/foo.o trashinfo"
+assert_absent "$HOME_TRASH/files/home_bar_o" "F1 /home/me/bar.o backup"
+assert_absent "$HOME_TRASH/info/home_bar_o.trashinfo" "F1 /home/me/bar.o trashinfo"
+assert_absent "$VOL_TRASH/files/vol_obj" "F1 volume .o backup"
+assert_absent "$VOL_TRASH/info/vol_obj.trashinfo" "F1 volume .o trashinfo"
+assert_exists "$HOME_TRASH/files/home_foo_c" "F1 /tmp/foo.c backup"
+assert_exists "$HOME_TRASH/info/home_foo_c.trashinfo" "F1 /tmp/foo.c trashinfo"
+
+
+
+
+DATA="$RUN/f2-data"
+HOME_TRASH="$DATA/Trash"
+make_entry "$HOME_TRASH" project_app_log home/me/project/app.log "project log"
+make_entry "$HOME_TRASH" other_app_log home/me/other/app.log "other log"
+make_entry "$HOME_TRASH" project_notes home/me/project/notes.txt "project notes"
+
+XDG_DATA_HOME="$DATA" TRASH_VOLUMES="" "$BIN" '/home/me/project/*.log' >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_empty out "F2 unexpected stdout"
+assert_empty err "F2 unexpected stderr"
+assert_absent "$HOME_TRASH/files/project_app_log" "F2 project app.log backup"
+assert_absent "$HOME_TRASH/info/project_app_log.trashinfo" "F2 project app.log trashinfo"
+assert_exists "$HOME_TRASH/files/other_app_log" "F2 other app.log backup"
+assert_exists "$HOME_TRASH/info/other_app_log.trashinfo" "F2 other app.log trashinfo"
+assert_exists "$HOME_TRASH/files/project_notes" "F2 project notes backup"
+assert_exists "$HOME_TRASH/info/project_notes.trashinfo" "F2 project notes trashinfo"
+
+
+
+
+DATA="$RUN/f3-data"
+HOME_TRASH="$DATA/Trash"
+make_entry "$HOME_TRASH" keep_one tmp/keep.txt "keep"
+
+XDG_DATA_HOME="$DATA" TRASH_VOLUMES="" "$BIN" '*.nomatch' >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+assert_empty out "F3 unexpected stdout"
+assert_empty err "F3 unexpected stderr"
+assert_exists "$HOME_TRASH/files/keep_one" "F3 no-match backup"
+assert_exists "$HOME_TRASH/info/keep_one.trashinfo" "F3 no-match trashinfo"
+
+
+
+
+XDG_DATA_HOME="$RUN/f4-data" TRASH_VOLUMES="" "$BIN" >out 2>err; ec=$?
+cat >expected_usage <<'EOF'
+Usage:
+    trash-rm PATTERN
+
+Please specify PATTERN.
+trash-rm uses fnmatch.fnmatchcase to match patterns, see https://docs.python.org/3/library/fnmatch.html for more details.
+EOF
+[ "$ec" -eq 8 ] || fail "F4 exit $ec; want 8"
+assert_empty out "F4 unexpected stdout"
+cmp -s expected_usage err || fail "F4 stderr: $(cat err)"
+
+
+
+
+DATA="$RUN/f5-data"
+HOME_TRASH="$DATA/Trash"
+make_entry "$HOME_TRASH" good tmp/delete.me "delete me"
+mkdir -p "$HOME_TRASH/files" "$HOME_TRASH/info"
+printf 'bad payload' >"$HOME_TRASH/files/bad"
+printf '[Trash Info]\nDeletionDate=2026-07-23T00:00:00\n' \
+    >"$HOME_TRASH/info/bad.trashinfo"
+
+XDG_DATA_HOME="$DATA" TRASH_VOLUMES="" "$BIN" '*.me' >out 2>err; ec=$?
+EXPECTED_PARSE_ERR="trash-rm: $HOME_TRASH/info/bad.trashinfo: unable to parse 'Path'"
+printf '%s\n' "$EXPECTED_PARSE_ERR" >expected_parse_err
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+assert_empty out "F5 unexpected stdout"
+cmp -s expected_parse_err err || fail "F5 stderr: $(cat err)"
+assert_absent "$HOME_TRASH/files/good" "F5 valid matching backup"
+assert_absent "$HOME_TRASH/info/good.trashinfo" "F5 valid matching trashinfo"
+assert_exists "$HOME_TRASH/files/bad" "F5 malformed backup"
+assert_exists "$HOME_TRASH/info/bad.trashinfo" "F5 malformed trashinfo"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
