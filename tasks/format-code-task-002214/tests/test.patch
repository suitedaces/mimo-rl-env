+    def test_constructor_dict_keys_gh36044(self):
+
+
+        d = {"a": 1, "b": 2}
+        result = Series(d.keys())
+        expected = Series(["a", "b"])
+        tm.assert_series_equal(result, expected)
+        assert result.dtype == object
+
+        assert list(result) == ["a", "b"]
+
+    def test_constructor_dict_values_gh36044(self):
+
+
+        d = {"a": 1, "b": 2}
+        result = Series(d.values())
+        expected = Series([1, 2])
+        tm.assert_series_equal(result, expected)
+
+        assert result.dtype == np.int64
+        assert list(result) == [1, 2]
+
+    def test_constructor_dict_items_gh36044(self):
+
+
+        d = {"a": 1, "b": 2}
+        result = Series(d.items())
+
+        assert list(result) == [("a", 1), ("b", 2)]
+        assert result.dtype == object
+        assert len(result) == 2
+
+    def test_constructor_dict_keys_preserves_set_raise_gh36044(self):
+
+
+        result = Series({"x": 10, "y": 20}.keys())
+        assert list(result) == ["x", "y"]
+        with pytest.raises(TypeError, match="'set' type is unordered"):
+            Series({1, 2, 3})
+        with pytest.raises(TypeError, match="'frozenset' type is unordered"):
+            Series(frozenset({1, 2, 3}))
+
