diff --git a/pkg/apis/core/v1beta1/helper/errors_stage2_test.go b/pkg/apis/core/v1beta1/helper/errors_stage2_test.go
new file mode 100644
index 0000000000..4c3385a759
--- /dev/null
+++ b/pkg/apis/core/v1beta1/helper/errors_stage2_test.go
@@ -0,0 +1,132 @@
+package helper_test
+
+import (
+	"errors"
+	"os"
+	"strings"
+	"testing"
+
+	gardencore "github.com/gardener/gardener/pkg/apis/core"
+	gardencorev1alpha1 "github.com/gardener/gardener/pkg/apis/core/v1alpha1"
+	gardencorev1beta1 "github.com/gardener/gardener/pkg/apis/core/v1beta1"
+	. "github.com/gardener/gardener/pkg/apis/core/v1beta1/helper"
+)
+
+func TestDetermineErrorCodesDistinguishesUnauthenticatedCredentialFailures(t *testing.T) {
+	tests := []string{
+		"Authentication failed while validating cloud credentials",
+		"Authentication failed: invalid access key was rejected",
+	}
+
+	for _, message := range tests {
+		t.Run(message, func(t *testing.T) {
+			codes := DetermineErrorCodes(errors.New(message))
+
+			assertContainsCode(t, codes, gardencorev1beta1.ErrorInfraUnauthenticated)
+			assertNotContainsCode(t, codes, gardencorev1beta1.ErrorInfraUnauthorized)
+		})
+	}
+}
+
+func TestDetermineErrorCodesClassifiesAuthorizationFailuresAsUnauthorized(t *testing.T) {
+	tests := []string{
+		"AccessDenied: missing permission to create load balancer",
+		"request was not authorized by provider policy",
+		"Error 403: forbidden by infrastructure provider",
+	}
+
+	for _, message := range tests {
+		t.Run(message, func(t *testing.T) {
+			codes := DetermineErrorCodes(errors.New(message))
+
+			assertContainsCode(t, codes, gardencorev1beta1.ErrorInfraUnauthorized)
+			assertNotContainsCode(t, codes, gardencorev1beta1.ErrorInfraUnauthenticated)
+		})
+	}
+}
+
+func TestShootStatusKnownCredentialAndAuthorizationErrorCodesAreDocumented(t *testing.T) {
+	contents := readFileForTest(t, "../../../../../docs/usage/shoot_status.md")
+
+
+	unauthenticatedEntry := lineContaining(t, contents, "`ERR_INFRA_UNAUTHENTICATED`")
+	assertLowerContains(t, unauthenticatedEntry, "authenticat")
+	assertLowerContains(t, unauthenticatedEntry, "credential")
+
+	unauthorizedEntry := lineContaining(t, contents, "`ERR_INFRA_UNAUTHORIZED`")
+	if !strings.Contains(strings.ToLower(unauthorizedEntry), "authoriz") &&
+		!strings.Contains(strings.ToLower(unauthorizedEntry), "forbid") &&
+		!strings.Contains(strings.ToLower(unauthorizedEntry), "refus") {
+		t.Fatalf("ERR_INFRA_UNAUTHORIZED documentation should describe authorization refusal, got: %q", unauthorizedEntry)
+	}
+
+	insufficientPrivilegesEntry := lineContaining(t, contents, "`ERR_INFRA_INSUFFICIENT_PRIVILEGES`")
+	assertLowerContains(t, insufficientPrivilegesEntry, "deprecated")
+	assertLowerContains(t, insufficientPrivilegesEntry, "err_infra_unauthorized")
+}
+
+func TestErrorInfraUnauthenticatedConstantIsExposedInCoreAPIs(t *testing.T) {
+
+	if got, want := string(gardencore.ErrorInfraUnauthenticated), "ERR_INFRA_UNAUTHENTICATED"; got != want {
+		t.Fatalf("core ErrorInfraUnauthenticated = %q, want %q", got, want)
+	}
+	if got, want := string(gardencorev1alpha1.ErrorInfraUnauthenticated), "ERR_INFRA_UNAUTHENTICATED"; got != want {
+		t.Fatalf("v1alpha1 ErrorInfraUnauthenticated = %q, want %q", got, want)
+	}
+	if got, want := string(gardencorev1beta1.ErrorInfraUnauthenticated), "ERR_INFRA_UNAUTHENTICATED"; got != want {
+		t.Fatalf("v1beta1 ErrorInfraUnauthenticated = %q, want %q", got, want)
+	}
+}
+
+func TestUnauthenticatedInfrastructureErrorIsNonRetryable(t *testing.T) {
+	lastError := gardencorev1beta1.LastError{Codes: []gardencorev1beta1.ErrorCode{gardencorev1beta1.ErrorInfraUnauthenticated}}
+	if !HasNonRetryableErrorCode(lastError) {
+		t.Fatalf("expected %s to be treated as a non-retryable infrastructure error code", gardencorev1beta1.ErrorInfraUnauthenticated)
+	}
+}
+
+func assertContainsCode(t *testing.T, codes []gardencorev1beta1.ErrorCode, want gardencorev1beta1.ErrorCode) {
+	t.Helper()
+	for _, code := range codes {
+		if code == want {
+			return
+		}
+	}
+	t.Fatalf("codes %v do not contain %s", codes, want)
+}
+
+func assertNotContainsCode(t *testing.T, codes []gardencorev1beta1.ErrorCode, unwanted gardencorev1beta1.ErrorCode) {
+	t.Helper()
+	for _, code := range codes {
+		if code == unwanted {
+			t.Fatalf("codes %v unexpectedly contain %s", codes, unwanted)
+		}
+	}
+}
+
+func readFileForTest(t *testing.T, path string) string {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("failed to read %s: %v", path, err)
+	}
+	return string(data)
+}
+
+func lineContaining(t *testing.T, contents, needle string) string {
+	t.Helper()
+	for _, line := range strings.Split(contents, "\n") {
+		if strings.Contains(line, needle) {
+			return line
+		}
+	}
+	t.Fatalf("did not find line containing %q", needle)
+	return ""
+}
+
+func assertLowerContains(t *testing.T, text, needle string) {
+	t.Helper()
+	if !strings.Contains(strings.ToLower(text), strings.ToLower(needle)) {
+		t.Fatalf("expected %q to contain %q", text, needle)
+	}
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 -mod=vendor -run '^$' ./pkg/apis/core/v1beta1/helper/
+    ;;
+  new)
+    go test -v -count=1 -mod=vendor ./pkg/apis/core/v1beta1/helper/ -run 'TestDetermineErrorCodesDistinguishesUnauthenticatedCredentialFailures|TestDetermineErrorCodesClassifiesAuthorizationFailuresAsUnauthorized|TestShootStatusKnownCredentialAndAuthorizationErrorCodesAreDocumented|TestInfraInsufficientPrivilegesIsDocumentedAsDeprecated|TestErrorInfraUnauthenticatedConstantIsExposedInCoreAPIs|TestUnauthenticatedInfrastructureErrorIsNonRetryable'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
