@@ -0,0 +1,106 @@
+
+
+
+
+
+
+
+import numpy as np
+import pandas as pd
+import pytest
+
+from libreco.data import DatasetPure, TransformedSet, split_by_ratio_chrono
+from libreco.evaluation import evaluate
+
+
+@pytest.fixture(scope="module")
+def data_info():
+    rng = np.random.default_rng(42)
+    size = 200
+    pd_data = pd.DataFrame(
+        {
+            "user": rng.integers(0, 20, size),
+            "item": rng.integers(0, 30, size),
+            "label": rng.integers(1, 6, size),
+            "time": rng.integers(10000, 20000, size),
+        }
+    )
+    train_data, _ = split_by_ratio_chrono(pd_data, test_size=0.2)
+    _, info = DatasetPure.build_trainset(train_data)
+    return info
+
+
+class FakeModel:
+
+
+    def __init__(self, task, data_info):
+        self.task = task
+        self.data_info = data_info
+        self.n_users = data_info.n_users
+        self.n_items = data_info.n_items
+
+    def predict(self, users, items, inner_id=True):
+        users = np.atleast_1d(users)
+        return np.full(len(users), 0.5, dtype=np.float32)
+
+
+def make_transformed(user_indices, item_indices, labels):
+    return TransformedSet(
+        np.asarray(user_indices, dtype=np.int64),
+        np.asarray(item_indices, dtype=np.int64),
+        np.asarray(labels, dtype=np.float32),
+        train=False,
+    )
+
+
+def test_neg_sampling_is_required(data_info):
+    model = FakeModel("ranking", data_info)
+    data = make_transformed([0, 1, 2], [0, 1, 2], [1, 0, 1])
+    with pytest.raises(TypeError):
+        evaluate(model, data)
+
+
+def test_ranking_non_binary_without_neg_sampling_raises(data_info):
+    model = FakeModel("ranking", data_info)
+
+    data = make_transformed([0, 1, 2, 3], [0, 1, 2, 3], [5, 3, 1, 4])
+    with pytest.raises(ValueError):
+        evaluate(model, data, neg_sampling=False, metrics=["roc_auc"])
+
+
+def test_ranking_only_positive_without_neg_sampling_raises(data_info):
+    model = FakeModel("ranking", data_info)
+
+    data = make_transformed([0, 1, 2, 3], [0, 1, 2, 3], [1, 1, 1, 1])
+    with pytest.raises(ValueError):
+        evaluate(model, data, neg_sampling=False, metrics=["roc_auc"])
+
+
+def test_ranking_binary_without_neg_sampling_ok(data_info):
+    model = FakeModel("ranking", data_info)
+    data = make_transformed([0, 0, 1, 1, 2, 2], [0, 1, 2, 3, 4, 5],
+                            [1, 0, 1, 0, 1, 0])
+    result = evaluate(model, data, neg_sampling=False, metrics=["roc_auc"])
+    assert isinstance(result, dict)
+    assert "roc_auc" in result
+
+
+def test_rating_without_neg_sampling_allows_non_binary(data_info):
+    model = FakeModel("rating", data_info)
+    data = make_transformed([0, 1, 2, 3], [0, 1, 2, 3], [5, 3, 1, 4])
+    result = evaluate(model, data, neg_sampling=False, metrics=["rmse"])
+    assert isinstance(result, dict)
+    assert "rmse" in result
+
+
+def test_neg_sampling_true_generates_negatives_for_positive_only_ranking(data_info):
+    model = FakeModel("ranking", data_info)
+
+
+    users = list(range(10))
+    items = list(range(10))
+    labels = [1] * 10
+    data = make_transformed(users, items, labels)
+    result = evaluate(model, data, neg_sampling=True, metrics=["roc_auc"])
+    assert isinstance(result, dict)
+    assert "roc_auc" in result
