+func TestReadLDAPMessageIsReferentiallyTransparentForEquivalentInput(t *testing.T) {
+	first := summarizeMessage(t, bindRequestBytes)
+	second := summarizeMessage(t, bindRequestBytes)
+
+	expected := messageSummary{id: 1, opName: "BindRequest", controls: nil}
+	if !reflect.DeepEqual(first, expected) {
+		t.Fatalf("first summary = %#v, want %#v", first, expected)
+	}
+	if !reflect.DeepEqual(second, expected) {
+		t.Fatalf("second summary = %#v, want %#v", second, expected)
+	}
+	if !reflect.DeepEqual(first, second) {
+		t.Fatalf("first summary = %#v, second summary = %#v", first, second)
+	}
+}
