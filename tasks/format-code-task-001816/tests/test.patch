+func TestReadLDAPMessageHasNoLastCallGlobalState(t *testing.T) {
+
+	expected := messageSummary{id: 1, opName: "BindRequest", controls: nil}
+	first := summarizeMessage(t, bindRequestBytes)
+	_ = summarizeMessage(t, searchDoneWithControlBytes)
