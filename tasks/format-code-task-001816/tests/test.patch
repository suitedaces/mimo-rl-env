+	err := assertReturnedError(t, input)
+
+	var ldapErr msg.LdapError
+	if errors.As(err, &ldapErr) != true {
+		t.Fatalf("errors.As(err, *message.LdapError) = false for %T %v, want true", err, err)
+	}
+}
+
+func assertReturnedError(t *testing.T, input []byte) error {
+	t.Helper()
+	var err error
+	var recovered interface{}
+	func() {
+		defer func() {
+			recovered = recover()
+		}()
+		_, err = msg.ReadLDAPMessage(msg.NewBytes(0, append([]byte(nil), input...)))
+	}()
+	if recovered != nil {
+		t.Fatalf("panic = %#v, want nil", recovered)
+	}
+	if err == nil {
+		t.Fatalf("error = nil, want non-nil error")
+	}
+
+	return err
+}
