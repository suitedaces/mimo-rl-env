+func assertMessage(t *testing.T, input []byte, wantID int, wantOp string, wantControls []expectedControl) {
+	t.Helper()
+	actual := summarizeMessage(t, input)
+
+	expected := messageSummary{id: wantID, opName: wantOp, controls: wantControls}
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("message summary = %#v, want %#v", actual, expected)
+	}
+}
+
+func summarizeMessage(t *testing.T, input []byte) messageSummary {
+	t.Helper()
+	message, err := msg.ReadLDAPMessage(msg.NewBytes(0, append([]byte(nil), input...)))
+	if err != nil {
+		t.Fatalf("ReadLDAPMessage returned %T: %v, want nil error", err, err)
+	}
+	return summarizeDecodedMessage(t, message)
+}
+
+func summarizeDecodedMessage(t *testing.T, message msg.LDAPMessage) messageSummary {
+	t.Helper()
+	opName := message.ProtocolOpName()
+	assertConcreteProtocolOp(t, message.ProtocolOp(), opName)
+	summary := messageSummary{
+		id:       message.MessageID().Int(),
+		opName:   opName,
+		controls: nil,
+	}
+	if message.Controls() != nil {
+		for _, control := range *message.Controls() {
+			valueHex := ""
+			if control.ControlValue() != nil {
+				valueHex = hex.EncodeToString(control.ControlValue().Bytes())
+			}
+			summary.controls = append(summary.controls, expectedControl{
+				controlType: control.ControlType().String(),
+				critical:    control.Criticality().Bool(),
+				valueHex:    valueHex,
+			})
+		}
+	}
+	return summary
+}
+
+func assertConcreteProtocolOp(t *testing.T, op msg.ProtocolOp, wantName string) {
+	t.Helper()
+	ok := false
+	switch wantName {
+	case "BindRequest":
+		_, ok = op.(msg.BindRequest)
+	case "BindResponse":
+		_, ok = op.(msg.BindResponse)
+	case "UnbindRequest":
+		_, ok = op.(msg.UnbindRequest)
+	case "SearchRequest":
+		_, ok = op.(msg.SearchRequest)
+	case "SearchResultEntry":
+		_, ok = op.(msg.SearchResultEntry)
+	case "SearchResultDone":
+		_, ok = op.(msg.SearchResultDone)
+	case "SearchResultReference":
+		_, ok = op.(msg.SearchResultReference)
+	case "ModifyRequest":
+		_, ok = op.(msg.ModifyRequest)
+	case "ModifyResponse":
+		_, ok = op.(msg.ModifyResponse)
+	case "AddRequest":
+		_, ok = op.(msg.AddRequest)
+	case "AddResponse":
+		_, ok = op.(msg.AddResponse)
+	case "DelRequest":
+		_, ok = op.(msg.DelRequest)
+	case "DelResponse":
+		_, ok = op.(msg.DelResponse)
+	case "ModifyDNRequest":
+		_, ok = op.(msg.ModifyDNRequest)
+	case "ModifyDNResponse":
+		_, ok = op.(msg.ModifyDNResponse)
+	case "CompareRequest":
+		_, ok = op.(msg.CompareRequest)
+	case "CompareResponse":
+		_, ok = op.(msg.CompareResponse)
+	case "AbandonRequest":
+		_, ok = op.(msg.AbandonRequest)
+	case "ExtendedRequest":
+		_, ok = op.(msg.ExtendedRequest)
+	case "ExtendedResponse":
+		_, ok = op.(msg.ExtendedResponse)
+	case "IntermediateResponse":
+		_, ok = op.(msg.IntermediateResponse)
+	default:
+		t.Fatalf("protocol op expectation name = %q, want a known public ProtocolOp name", wantName)
+	}
+	if ok != true {
+		t.Fatalf("protocol op dynamic type match for %q = %v, want true", wantName, ok)
+	}
+}
