+	second := summarizeMessage(t, bindRequestBytes)
+	if !reflect.DeepEqual(first, expected) {
+		t.Fatalf("first summary = %#v, want %#v", first, expected)
+	}
+	if !reflect.DeepEqual(second, expected) {
+		t.Fatalf("second summary = %#v, want %#v", second, expected)
+	}
+}
