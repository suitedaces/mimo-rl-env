@@ -0,0 +1,16 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed/fxhttpclient
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 -run '^(TestModule|TestModuleDecoration)$'
+    ;;
+  new)
+    go test -v -count=1 -run '^(TestFxHttpClientMetricsDisabledByDefault|TestFxHttpClientMetricsEnabledWithCustomConfig|TestFxHttpClientMetricsRequestsCounter|TestFxHttpClientMetricsRequestDurationHistogram|TestFxHttpClientMetricsStatusNormalizationToggle|TestFxHttpClientReadmeMentionsMetricsIntegration|TestFxHttpClientDocsContainMetricsSection)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
