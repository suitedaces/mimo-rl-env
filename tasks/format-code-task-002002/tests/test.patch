@@ -0,0 +1,184 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+REPO=/workspace/repo
+ENTRY="$REPO/Movie_Data_Capture.py"
+PYTHON=${PYTHON:-python}
+FIXTURES="$REPO/usercase-test-coderl/fixtures"
+export PYTHONPATH="$FIXTURES:$REPO${PYTHONPATH:+:$PYTHONPATH}"
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+( cd "$REPO" && PYTHONWARNINGS="ignore::SyntaxWarning" "$PYTHON" - <<'PY'
+from pathlib import Path
+
+for name in ("Movie_Data_Capture.py", "core.py", "config.py", "ADC_function.py", "scraper.py"):
+    compile(Path(name).read_text(encoding="utf-8"), name, "exec")
+PY
+) \
+    || fail "build"
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+prepare_case() {
+    local name=$1
+    mkdir -p "$TMP/$name/media"
+    cp "$REPO/config.ini" "$TMP/$name/config.ini"
+}
+
+run_mdc() {
+    local case_dir=$1
+    local movie=$2
+    local mode=$3
+    local link_mode=$4
+    local sub_types=$5
+
+    (
+        cd "$case_dir" && \
+        PYTHONDONTWRITEBYTECODE=1 \
+        PYTHONWARNINGS="ignore::SyntaxWarning" \
+        "$PYTHON" "$ENTRY" "$case_dir/media/$movie" \
+            -m "$mode" -n ABP-123 -L "$link_mode" -a -o "" \
+            -C "common:success_output_folder=$case_dir/output;failed_output_folder=$case_dir/failed;del_empty_folder=0;download_only_missing_images=0;sleep=0;nfo_skip_days=0" \
+            -C "Name_Rule:location_rule=number;naming_rule=number;image_naming_with_number=1" \
+            -C "media:sub_type=$sub_types" \
+            -C "watermark:switch=0" \
+            -C "extrafanart:switch=0" \
+            -C "storyline:switch=0" \
+            -C "trailer:switch=0" \
+            -C "actor_photo:download_for_kodi=0" \
+            >out 2>err
+    )
+    return $?
+}
+
+assert_clean_success() {
+    local label=$1
+    local ec=$2
+    [ "$ec" -eq 0 ] || fail "$label exit $ec; want 0"
+    [ ! -s err ] || fail "$label unexpected stderr: $(cat err)"
+}
+
+assert_file_text() {
+    local label=$1
+    local path=$2
+    local expected=$3
+    [ -f "$path" ] || fail "$label missing file $path"
+    [ "$(cat "$path")" = "$expected" ] || fail "$label content mismatch for $path"
+}
+
+
+
+
+prepare_case f1
+printf video > "$TMP/f1/media/ABP-123.mp4"
+printf f1-sub > "$TMP/f1/media/ABP-123.srt"
+cd "$TMP/f1"
+run_mdc "$TMP/f1" ABP-123.mp4 1 0 ".srt"; ec=$?
+assert_clean_success F1 "$ec"
+grep -Fxq "[+]Sub Moved!        ABP-123.srt" out || fail "F1 missing exact moved line"
+assert_file_text F1 "$TMP/f1/output/ABP-123/ABP-123.mp4" video
+assert_file_text F1 "$TMP/f1/output/ABP-123/ABP-123.srt" f1-sub
+[ ! -e "$TMP/f1/media/ABP-123.srt" ] || fail "F1 subtitle should be moved from source"
+
+
+
+
+prepare_case f2
+printf video > "$TMP/f2/media/ABP-123.mp4"
+printf f2-sub > "$TMP/f2/media/ABP-123.srt"
+cd "$TMP/f2"
+run_mdc "$TMP/f2" ABP-123.mp4 1 1 ".srt"; ec=$?
+assert_clean_success F2 "$ec"
+grep -Fxq "[+]Sub Copied!       ABP-123.srt" out || fail "F2 missing exact copied line"
+assert_file_text F2 "$TMP/f2/output/ABP-123/ABP-123.srt" f2-sub
+assert_file_text F2 "$TMP/f2/media/ABP-123.srt" f2-sub
+
+
+
+
+prepare_case f3
+printf video > "$TMP/f3/media/ABP-123.mp4"
+printf f3-zh-sub > "$TMP/f3/media/ABP-123.zh.srt"
+cd "$TMP/f3"
+run_mdc "$TMP/f3" ABP-123.mp4 1 0 ".srt"; ec=$?
+assert_clean_success F3 "$ec"
+
+grep -Fq "[+]Sub Moved!" out || fail "F3 missing moved subtitle signal"
+grep -Fq "ABP-123.zh.srt" out || fail "F3 missing preserved multi-suffix subtitle name"
+assert_file_text F3 "$TMP/f3/output/ABP-123/ABP-123.zh.srt" f3-zh-sub
+[ ! -e "$TMP/f3/media/ABP-123.zh.srt" ] || fail "F3 multi-suffix subtitle should be moved from source"
+
+
+
+
+prepare_case f4
+printf video > "$TMP/f4/media/ABP-123-CD2.mp4"
+printf cd1-sub > "$TMP/f4/media/ABP-123-CD1.srt"
+printf cd2-sub > "$TMP/f4/media/ABP-123-CD2.srt"
+cd "$TMP/f4"
+run_mdc "$TMP/f4" ABP-123-CD2.mp4 1 0 ".srt"; ec=$?
+assert_clean_success F4 "$ec"
+
+grep -Fq "[+]Sub Moved!" out || fail "F4 missing moved subtitle signal"
+grep -Fq "ABP-123-CD2.srt" out || fail "F4 missing matching CD2 subtitle name"
+assert_file_text F4 "$TMP/f4/output/ABP-123/ABP-123-CD2.mp4" video
+assert_file_text F4 "$TMP/f4/output/ABP-123/ABP-123-CD2.srt" cd2-sub
+assert_file_text F4 "$TMP/f4/media/ABP-123-CD1.srt" cd1-sub
+[ ! -e "$TMP/f4/output/ABP-123/ABP-123-CD1.srt" ] || fail "F4 should not carry mismatched CD1 subtitle"
+[ ! -e "$TMP/f4/media/ABP-123-CD2.srt" ] || fail "F4 matching CD2 subtitle should be moved from source"
+
+
+
+
+prepare_case f5
+printf video > "$TMP/f5/media/ABP-123.mp4"
+printf f5-sub > "$TMP/f5/media/ABP-123.srt"
+cd "$TMP/f5"
+run_mdc "$TMP/f5" ABP-123.mp4 2 0 ".srt"; ec=$?
+assert_clean_success F5 "$ec"
+
+grep -Fq "[+]Sub Moved!" out || fail "F5 missing organizing moved subtitle signal"
+grep -Fq "ABP-123.srt" out || fail "F5 missing organizing subtitle name"
+assert_file_text F5 "$TMP/f5/output/ABP-123/ABP-123.mp4" video
+assert_file_text F5 "$TMP/f5/output/ABP-123/ABP-123.srt" f5-sub
+[ ! -e "$TMP/f5/media/ABP-123.srt" ] || fail "F5 subtitle should be moved from source"
+
+
+
+
+prepare_case f6
+printf video > "$TMP/f6/media/ABP-123.mp4"
+printf text-sub > "$TMP/f6/media/ABP-123.txt"
+printf wrong-base > "$TMP/f6/media/ABP-1234.srt"
+cd "$TMP/f6"
+run_mdc "$TMP/f6" ABP-123.mp4 1 0 ".srt"; ec=$?
+assert_clean_success F6 "$ec"
+
+! grep -Fq "[+]Sub Moved!" out || fail "F6 should not print a subtitle moved line"
+! grep -Fq "[+]Sub Copied!" out || fail "F6 should not print a subtitle copied line"
+assert_file_text F6 "$TMP/f6/output/ABP-123/ABP-123.mp4" video
+[ ! -e "$TMP/f6/output/ABP-123/ABP-123.srt" ] || fail "F6 should not create ABP-123.srt"
+assert_file_text F6 "$TMP/f6/media/ABP-123.txt" text-sub
+assert_file_text F6 "$TMP/f6/media/ABP-1234.srt" wrong-base
+
+
+
+
+prepare_case f7
+printf video > "$TMP/f7/media/ABP-123.mp4"
+printf f7-ass-sub > "$TMP/f7/media/ABP-123.ass"
+cd "$TMP/f7"
+run_mdc "$TMP/f7" ABP-123.mp4 1 0 ".ass"; ec=$?
+assert_clean_success F7 "$ec"
+
+grep -Fq "[+]Sub Moved!" out || fail "F7 missing moved subtitle signal for allowed non-srt suffix"
+grep -Fq "ABP-123.ass" out || fail "F7 missing allowed non-srt subtitle name"
+assert_file_text F7 "$TMP/f7/output/ABP-123/ABP-123.ass" f7-ass-sub
+[ ! -e "$TMP/f7/media/ABP-123.ass" ] || fail "F7 allowed non-srt subtitle should be moved from source"
+
+echo "PASS"
+exit 0
