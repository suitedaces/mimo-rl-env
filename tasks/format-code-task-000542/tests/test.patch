+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+export PYENV_VERSION=3.5.10
+PYTHON="$HOME/.pyenv/bin/pyenv exec python"
+ant java >/dev/null
+
+
+$PYTHON -m pytest tests/datatypes/test_tuple.py::TupleTests -q
+
+
+$PYTHON -m pytest tests/datatypes/test_tuple_operations.py -q
