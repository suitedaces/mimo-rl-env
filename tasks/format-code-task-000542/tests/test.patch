diff --git a/tests/datatypes/test_tuple_operations.py b/tests/datatypes/test_tuple_operations.py
new file mode 100644
index 00000000..5235d132
--- /dev/null
+++ b/tests/datatypes/test_tuple_operations.py
@@ -0,0 +1,183 @@
+from .. utils import TranspileTestCase
+
+
+class TupleOperatorTests(TranspileTestCase):
+
+
+
+
+
+
+
+
+
+
+    def test_equality(self):
+        self.assertCodeExecution("""
+            a = (1, 2, 3)
+            b = (1, 2, 3)
+            c = (1, 2, 4)
+            d = (1, 2)
+            e = ()
+            f = ('a', 'b')
+            print(a == b)
+            print(a == c)
+            print(d == a)
+            print(e == ())
+            print(f == ('a', 'b'))
+            print(a != b)
+            print(a != c)
+            """)
+
+    def test_equality_with_non_tuple(self):
+        self.assertCodeExecution("""
+            a = (1, 2, 3)
+            e = ()
+            print(a == 5)
+            print(a == "hello")
+            print(a == [1, 2, 3])
+            print(a != 5)
+            print(a != [1, 2, 3])
+            print(e == 0)
+            """)
+
+    def test_ordering_lt(self):
+        self.assertCodeExecution("""
+            a = (1, 2, 3)
+            print(a < (1, 2, 4))
+            print((1, 2, 4) < a)
+            print((1, 2) < a)
+            print(a < (1, 2))
+            print((2, 0) < (1, 5))
+            print((1, 5) < (2, 0))
+            print(a < (1, 2, 3))
+            """)
+
+    def test_ordering_le_gt_ge(self):
+        self.assertCodeExecution("""
+            a = (1, 2, 3)
+            print(a <= (1, 2, 3))
+            print(a <= (1, 2, 4))
+            print((1, 2, 4) <= a)
+            print((1, 2) <= a)
+            print(a > (1, 2, 4))
+            print((1, 2, 4) > a)
+            print(a > (1, 2))
+            print(a >= (1, 2, 3))
+            print((1, 2, 4) >= a)
+            print(a >= (1, 2, 4))
+            """)
+
+    def test_ordering_with_non_tuple_raises(self):
+        self.assertCodeExecution("""
+            a = (1, 2, 3)
+            print(a < 5)
+            """)
+        self.assertCodeExecution("""
+            a = (1, 2, 3)
+            print(a <= 5)
+            """)
+        self.assertCodeExecution("""
+            a = (1, 2, 3)
+            print(a > 5)
+            """)
+        self.assertCodeExecution("""
+            a = (1, 2, 3)
+            print(a >= 5)
+            """)
+
+    def test_concatenation(self):
+        self.assertCodeExecution("""
+            x = (1, 2)
+            y = (3, 4)
+            e = ()
+            print(x + y)
+            print(e + x)
+            print(x + e)
+            print(('a',) + ('b', 'c'))
+            print(x + y)
+            print(x)
+            print(y)
+            """)
+
+    def test_concatenation_with_non_tuple_raises(self):
+        self.assertCodeExecution("""
+            x = (1, 2)
+            print(x + 3)
+            """)
+        self.assertCodeExecution("""
+            x = (1, 2)
+            print(x + [3, 4])
+            """)
+        self.assertCodeExecution("""
+            x = (1, 2)
+            print(x + "ab")
+            """)
+
+    def test_repetition(self):
+        self.assertCodeExecution("""
+            x = (1, 2)
+            n3 = 3
+            n1 = 1
+            n0 = 0
+            nm2 = -2
+            print(x * n3)
+            print(x * n1)
+            print(x * n0)
+            print(x * nm2)
+            print(('a',) * 4)
+            print(x * True)
+            print(x * False)
+            """)
+
+    def test_repetition_with_non_int_raises(self):
+        self.assertCodeExecution("""
+            x = (1, 2)
+            print(x * "a")
+            """)
+        self.assertCodeExecution("""
+            x = (1, 2)
+            print(x * 1.5)
+            """)
+        self.assertCodeExecution("""
+            x = (1, 2)
+            print(x * (3, 4))
+            """)
+
+    def test_truthiness(self):
+        self.assertCodeExecution("""
+            e = ()
+            x = (1, 2)
+            z = (0,)
+            if e:
+                print("empty truthy")
+            else:
+                print("empty falsy")
+
+            if x:
+                print("nonempty truthy")
+            else:
+                print("nonempty falsy")
+
+            if z:
+                print("zero-element truthy")
+            else:
+                print("zero-element falsy")
+
+            print(not e)
+            print(not x)
+            """)
+
+    def test_unary_operators_raise(self):
+        self.assertCodeExecution("""
+            x = (1, 2, 3)
+            print(+x)
+            """)
+        self.assertCodeExecution("""
+            x = (1, 2, 3)
+            print(-x)
+            """)
+        self.assertCodeExecution("""
+            x = (1, 2, 3)
+            print(~x)
+            """)
