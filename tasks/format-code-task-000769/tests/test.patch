+++ b/mimo_test_command.sh
@@ -0,0 +1,37 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+pg_isready -q 2>/dev/null || pg_ctlcluster 16 main start 2>/dev/null || true
+
+
+su - postgres -c "psql -c \"SELECT 1 FROM pg_roles WHERE rolname='root'\" | grep -q 1" 2>/dev/null || \
+  su - postgres -c "psql -c \"CREATE USER root WITH PASSWORD 'password' SUPERUSER;\"" 2>/dev/null || true
+su - postgres -c "psql -c \"SELECT 1 FROM pg_database WHERE datname='dbt'\" | grep -q 1" 2>/dev/null || \
+  su - postgres -c "psql -c \"CREATE DATABASE dbt OWNER root;\"" 2>/dev/null || true
+
+
+pip install -e /testbed/core --no-input --no-deps --quiet 2>/dev/null || true
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest \
+      tests/functional/logging/test_meta_logging.py::test_meta \
+      tests/unit/events/test_types.py::test_extra_dict_on_event \
+      -v
+    ;;
+  new)
+    python3 -m pytest \
+      tests/functional/logging/test_meta_logging.py::test_checksum \
+      tests/unit/events/test_types.py::test_node_info_events \
+      tests/unit/contracts/graph/test_node_info_checksum.py \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
