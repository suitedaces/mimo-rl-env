diff --git a/tests/unit/contracts/graph/test_node_info_checksum.py b/tests/unit/contracts/graph/test_node_info_checksum.py
new file mode 100644
index 000000000..e929a7045
--- /dev/null
+++ b/tests/unit/contracts/graph/test_node_info_checksum.py
@@ -0,0 +1,89 @@
+from dbt.artifacts.resources import FileHash
+from dbt.contracts.graph.nodes import ModelNode, SeedNode, SourceDefinition
+from dbt.node_types import NodeType
+
+
+def missing_checksum_model(name):
+    return ModelNode(
+        alias=name,
+        name=name,
+        database="test_db",
+        schema="test_schema",
+        resource_type=NodeType.Model,
+        package_name="test",
+        path=f"models/{name}.sql",
+        original_file_path=f"models/{name}.sql",
+        unique_id=f"model.test.{name}",
+        fqn=["test", name],
+        checksum=None,
+        raw_code="select 1 as id",
+        language="sql",
+        refs=[],
+        sources=[],
+        metrics=[],
+        depends_on={"macros": [], "nodes": []},
+        config={},
+        tags=[],
+        description="",
+        columns={},
+        meta={},
+        group=None,
+        docs={"show": True, "node_color": None},
+        patch_path=None,
+        build_path=None,
+        unrendered_config={},
+        created_at=0.0,
+        relation_name=None,
+    )
+
+
+def test_node_info_includes_null_checksum_when_missing():
+    for node in [
+        missing_checksum_model("missing_checksum_model"),
+        missing_checksum_model("another_missing_checksum_model"),
+    ]:
+        node_info = node.node_info
+        assert "node_checksum" in node_info
+        assert node_info["node_checksum"] is None
+
+
+def test_node_info_exposes_checksum_for_non_model_nodes():
+    node = SeedNode(
+        alias="seed_checksum",
+        name="seed_checksum",
+        database="test_db",
+        schema="test_schema",
+        resource_type=NodeType.Seed,
+        package_name="test",
+        path="seeds/seed_checksum.csv",
+        original_file_path="seeds/seed_checksum.csv",
+        unique_id="seed.test.seed_checksum",
+        fqn=["test", "seed_checksum"],
+        checksum=FileHash(name="sha256", checksum="seed-checksum"),
+    )
+
+    node_info = node.node_info
+    assert "node_checksum" in node_info
+    assert node_info["node_checksum"] == "seed-checksum"
+
+
+def test_node_info_includes_null_checksum_without_checksum_attribute():
+    node = SourceDefinition(
+        database="test_db",
+        schema="test_schema",
+        name="source_table",
+        resource_type=NodeType.Source,
+        package_name="test",
+        path="models/schema.yml",
+        original_file_path="models/schema.yml",
+        unique_id="source.test.raw.source_table",
+        fqn=["test", "raw", "source_table"],
+        source_name="raw",
+        source_description="",
+        loader="seed",
+        identifier="source_table",
+    )
+
+    node_info = node.node_info
+    assert "node_checksum" in node_info
+    assert node_info["node_checksum"] is None
