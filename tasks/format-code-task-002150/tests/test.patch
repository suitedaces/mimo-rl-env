+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+cmake -S /workspace/repo/usercase-test-coderl \
+      -B /workspace/repo/build-usercase-coderl-acceptance \
+      -G Ninja \
+      -DCMAKE_BUILD_TYPE=RelWithDebInfo >/dev/null
+
+cmake --build /workspace/repo/build-usercase-coderl-acceptance \
+      --target object_repository_add_from_file_test \
+      -j "${OPENRCT2_USERCASE_JOBS:-2}"
+
+exec /workspace/repo/build-usercase-coderl-acceptance/object_repository_add_from_file_test
