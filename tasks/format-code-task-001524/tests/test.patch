diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,224 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+( cd /workspace/repo && python3 - <<'PY'
+import pycparser
+PY
+) || { echo "FAIL: build/dependency check" >&2; exit 1; }
+
+PYTHON=${PYTHON:-python3}
+BIN=/workspace/repo/generate-wrapper.py
+
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+run_tool() {
+  "$PYTHON" "$BIN" "$@" >out 2>err
+  ec=$?
+}
+
+assert_stdout_exact() {
+
+  :
+}
+
+assert_empty_stderr() {
+  [ ! -s err ] || fail "$1 stderr: $(cat err)"
+}
+
+assert_line() {
+  file=$1
+  expected=$2
+  label=$3
+  grep -Fqx -- "$expected" "$file" || fail "$label missing line: $expected"
+}
+
+assert_file_regex() {
+  file=$1
+  pattern=$2
+  label=$3
+  "$PYTHON" - "$file" "$pattern" "$label" <<'PY'
+import re
+import sys
+
+path, pattern, label = sys.argv[1:]
+with open(path, encoding="utf-8") as fh:
+    text = fh.read()
+if not re.search(pattern, text, re.MULTILINE | re.DOTALL):
+    print(f"FAIL: {label} missing pattern: {pattern}", file=sys.stderr)
+    sys.exit(1)
+PY
+}
+
+assert_no_text() {
+  needle=$1
+  shift
+  for file in "$@"; do
+    if grep -Fq -- "$needle" "$file"; then
+      fail "$file unexpectedly contains $needle"
+    fi
+  done
+}
+
+assert_generated_function() {
+  fn=$1
+  label=$2
+
+  assert_file_regex demo-wrap.h "#\\s*define\\s+${fn}\\b" "$label header macro"
+  assert_file_regex demo-wrap.h "extern\\s+int\\s*\\(\\s*\\*[^;]*${fn}[^;]*\\)\\s*\\(\\s*void\\s*\\)\\s*;" "$label header extern"
+  assert_file_regex demo-wrap.c "=[^;]*dlsym\\s*\\([^;]*\"${fn}\"[^;]*\\)" "$label implementation dlsym"
+}
+
+BASE_STDOUT="cpp_args: ['-E', '-include', '/workspace/repo/attributes.h', '-I', '/workspace/repo/fake_libc_include']"
+ONE_DIR_STDOUT="cpp_args: ['-E', '-include', '/workspace/repo/attributes.h', '-I', '/workspace/repo/fake_libc_include', '-I', 'extra']"
+TWO_DIR_STDOUT="cpp_args: ['-E', '-include', '/workspace/repo/attributes.h', '-I', '/workspace/repo/fake_libc_include', '-I', 'extra', '-I', 'more']"
+
+
+
+
+cd "$TMP"; mkdir F1; cd F1 || exit 1
+mkdir extra
+cat > public.h <<'EOF'
+#include "dep.h"
+int public_api(void);
+EOF
+cat > extra/dep.h <<'EOF'
+int dep_api(void);
+EOF
+run_tool --include public.h --include-dir extra --sys-include public.h --soname libdemo.so --init-name demo --output-header demo-wrap.h --output-implementation demo-wrap.c
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_stdout_exact "$ONE_DIR_STDOUT" "F1"
+assert_empty_stderr "F1"
+assert_generated_function dep_api "F1 dep_api"
+assert_generated_function public_api "F1 public_api"
+
+
+
+
+cd "$TMP"; mkdir F2; cd F2 || exit 1
+cat > public.h <<'EOF'
+int public_api(void);
+int _private_api(void);
+int skip_me(void);
+int still_api(void);
+EOF
+run_tool --include public.h --sys-include public.h --soname libdemo.so --init-name demo --output-header demo-wrap.h --output-implementation demo-wrap.c --omit-prefix _ --omit-prefix skip
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_stdout_exact "$BASE_STDOUT" "F2"
+assert_empty_stderr "F2"
+assert_generated_function public_api "F2 public_api"
+assert_generated_function still_api "F2 still_api"
+assert_no_text _private_api demo-wrap.h demo-wrap.c
+assert_no_text skip_me demo-wrap.h demo-wrap.c
+
+
+
+
+cd "$TMP"; mkdir F3; cd F3 || exit 1
+mkdir extra more
+cat > public.h <<'EOF'
+#include "dep.h"
+#include "vendor.h"
+int public_api(void);
+EOF
+cat > extra/dep.h <<'EOF'
+int dep_api(void);
+EOF
+cat > more/vendor.h <<'EOF'
+int vendor_api(void);
+EOF
+run_tool --include public.h --include-dir extra --include-dir more --sys-include public.h --soname libdemo.so --init-name demo --output-header demo-wrap.h --output-implementation demo-wrap.c --ignore-headers dep.h --ignore-headers vendor.h
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+assert_stdout_exact "$TWO_DIR_STDOUT" "F3"
+assert_empty_stderr "F3"
+assert_generated_function public_api "F3 public_api"
+assert_no_text dep_api demo-wrap.h demo-wrap.c
+assert_no_text vendor_api demo-wrap.h demo-wrap.c
+
+
+
+
+cd "$TMP"; mkdir F4; cd F4 || exit 1
+mkdir extra
+cat > public.h <<'EOF'
+#include "dep.h"
+int public_api(void);
+EOF
+cat > extra/dep.h <<'EOF'
+int dep_api(void);
+EOF
+run_tool --include public.h --include-dir extra --sys-include public.h --soname libdemo.so --init-name demo --output-header demo-wrap.h --output-implementation demo-wrap.c --ignore-other
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+assert_stdout_exact "$ONE_DIR_STDOUT" "F4"
+assert_empty_stderr "F4"
+assert_generated_function public_api "F4 public_api"
+assert_no_text dep_api demo-wrap.h demo-wrap.c
+
+
+
+
+cd "$TMP"; mkdir F5; cd F5 || exit 1
+mkdir extra
+cat > public.h <<'EOF'
+#include "dep.h"
+int public_api(void);
+EOF
+cat > extra/dep.h <<'EOF'
+int dep_api(void);
+EOF
+run_tool --include public.h --include-dir extra --sys-include public.h --soname libdemo.so --init-name demo --output-header demo-wrap.h --output-implementation demo-wrap.c --no-ignore-other
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+assert_stdout_exact "$ONE_DIR_STDOUT" "F5"
+assert_empty_stderr "F5"
+assert_generated_function dep_api "F5 dep_api"
+assert_generated_function public_api "F5 public_api"
+
+
+
+
+cd "$TMP"; mkdir F6; cd F6 || exit 1
+cat > public.h <<'EOF'
+int public_api(void);
+EOF
+run_tool --include public.h --sys-include public.h --soname libdemo.so --init-name demo --output-header demo-wrap.h --output-implementation demo-wrap.c --include-dir
+[ "$ec" -ne 0 ] || fail "F6 exit $ec; want nonzero"
+[ ! -s out ] || fail "F6 stdout should be empty: $(cat out)"
+
+grep -Eiq -- 'usage|error' err || fail "F6 stderr missing include-dir usage error: $(cat err)"
+[ ! -e demo-wrap.h ] || fail "F6 unexpectedly created demo-wrap.h"
+[ ! -e demo-wrap.c ] || fail "F6 unexpectedly created demo-wrap.c"
+
+
+
+
+cd "$TMP"; mkdir F7; cd F7 || exit 1
+cat > public.h <<'EOF'
+int public_api(void);
+EOF
+run_tool --include public.h --sys-include public.h --soname libdemo.so --init-name demo --output-header demo-wrap.h --output-implementation demo-wrap.c --omit-prefix
+[ "$ec" -ne 0 ] || fail "F7 exit $ec; want nonzero"
+[ ! -s out ] || fail "F7 stdout should be empty: $(cat out)"
+
+grep -Eiq -- 'usage|error' err || fail "F7 stderr missing omit-prefix usage error: $(cat err)"
+[ ! -e demo-wrap.h ] || fail "F7 unexpectedly created demo-wrap.h"
+[ ! -e demo-wrap.c ] || fail "F7 unexpectedly created demo-wrap.c"
+
+
+
+
+cd "$TMP"; mkdir F8; cd F8 || exit 1
+cat > public.h <<'EOF'
+int public_api(void);
+EOF
+run_tool --include public.h --sys-include public.h --soname libdemo.so --init-name demo --output-header demo-wrap.h --output-implementation demo-wrap.c --ignore-headers
+[ "$ec" -ne 0 ] || fail "F8 exit $ec; want nonzero"
+[ ! -s out ] || fail "F8 stdout should be empty: $(cat out)"
+
+grep -Eiq -- 'usage|error' err || fail "F8 stderr missing ignore-headers usage error: $(cat err)"
+[ ! -e demo-wrap.h ] || fail "F8 unexpectedly created demo-wrap.h"
+[ ! -e demo-wrap.c ] || fail "F8 unexpectedly created demo-wrap.c"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
