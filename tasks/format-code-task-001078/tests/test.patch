+import os
+import subprocess
+import sys
+
+import numpy as np
+import pytest
+import tensorflow as tf
+
+from doctr.datasets import DataLoader
+
+
+class _ScalarDataset:
+    def __init__(self):
+        self.values = [0, 1, 2, 3, 4]
+
+    def __len__(self):
+        return len(self.values)
+
+    def __getitem__(self, index):
+        return tf.constant(self.values[index], dtype=tf.int32), self.values[index]
+
+
+def test_tensorflow_loader_epoch_policy_and_collation(monkeypatch):
+    dataset = _ScalarDataset()
+    loader = DataLoader(dataset, shuffle=False, batch_size=2, drop_last=False)
+
+    assert len(loader) == 3
+    def values(batches):
+        return [
+            (images.numpy().tolist(), [int(value) for value in targets])
+            for images, targets in batches
+        ]
+
+    first_epoch = values(loader)
+    second_epoch = values(loader)
+    assert first_epoch == second_epoch == [([0, 1], [0, 1]), ([2, 3], [2, 3]), ([4], [4])]
+
+    dropped = DataLoader(dataset, shuffle=False, batch_size=2, drop_last=True)
+    assert len(dropped) == 2
+    assert [images.numpy().tolist() for images, _ in dropped] == [[0, 1], [2, 3]]
+
+    def reverse_shuffle(indices):
+        indices[:] = indices[::-1]
+
+    monkeypatch.setattr(np.random, "shuffle", reverse_shuffle)
+    shuffled = DataLoader(dataset, shuffle=True, batch_size=2)
+    assert [images.numpy().tolist() for images, _ in shuffled] == [[4, 3], [2, 1], [0]]
+
+    custom = DataLoader(
+        dataset,
+        shuffle=False,
+        batch_size=3,
+        collate_fn=lambda samples: tuple(sum(sample[idx] for sample in samples) for idx in (0, 1)),
+    )
+    images, targets = next(iter(custom))
+    assert int(images) == 3 and targets == 3
+
+    with pytest.raises(ValueError):
+        DataLoader(dataset, batch_size=0)
+    with pytest.raises(ValueError):
+        DataLoader(dataset, batch_size=-1)
+
+
+def test_loader_is_exported_for_torch_only_runtime():
+    code = r'''
+import torch
+from doctr.datasets import DataLoader
+
+class Dataset:
+    def __len__(self):
+        return 5
+    def __getitem__(self, index):
+        return torch.tensor(index), index
+
+loader = DataLoader(Dataset(), shuffle=False, batch_size=2, drop_last=False)
+assert len(loader) == 3
+batches = list(loader)
+assert [batch[0].tolist() for batch in batches] == [[0, 1], [2, 3], [4]]
+assert [[int(value) for value in batch[1]] for batch in batches] == [[0, 1], [2, 3], [4]]
+dropped = DataLoader(Dataset(), shuffle=False, batch_size=2, drop_last=True)
+assert [batch[0].tolist() for batch in dropped] == [[0, 1], [2, 3]]
+try:
+    DataLoader(Dataset(), batch_size=0)
+except ValueError:
+    pass
+else:
+    raise AssertionError("batch_size=0 must be rejected")
+'''
+    env = os.environ.copy()
+    env.update({"USE_TF": "0", "USE_TORCH": "1"})
+    result = subprocess.run([sys.executable, "-c", code], env=env, capture_output=True, text=True)
+    assert result.returncode == 0, result.stderr
