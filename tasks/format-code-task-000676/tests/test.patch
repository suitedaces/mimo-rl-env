diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,201 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC LRZIP=NOCONFIG
+
+fail() {
+	echo "FAIL: $*" >&2
+	exit 1
+}
+
+(
+	cd /workspace/repo || exit 1
+	./autogen.sh >/dev/null || exit 1
+
+	make -C lzma/C liblzma.la >/dev/null || exit 1
+	make lrzip >/dev/null || exit 1
+) || fail "build"
+BIN=/workspace/repo/lrzip
+[ -x "$BIN" ] || fail "missing lrzip binary at $BIN"
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || fail "cd tmp"
+
+make_lines_fixture() {
+	local out=$1
+	local i
+	: > "$out"
+	for i in $(seq 1 10000); do
+		printf 'line-%05d abcdefghijklmnopqrstuvwxyz\n' "$i" >> "$out"
+	done
+}
+
+make_randomish_fixture() {
+	local out=$1
+	perl -e 'my $x=1; for (1..200000) { $x = (1103515245 * $x + 12345) & 0x7fffffff; print chr(($x >> 8) & 255); }' > "$out"
+}
+
+assert_same_file() {
+	local expected=$1
+	local actual=$2
+	cmp -s "$expected" "$actual" || fail "$actual differs from $expected"
+}
+
+gzip_block_info() {
+	local info_file=$1
+	awk '$2 == "gzip" { print $7, $9, $4, $7 + 10 }' "$info_file" | head -n 1
+}
+
+patch_byte() {
+	local file=$1
+	local offset=$2
+	local octal=$3
+	printf "$octal" | dd of="$file" bs=1 seek="$offset" count=1 conv=notrunc status=none
+}
+
+
+
+
+"$BIN" --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+
+cat out err >help.all
+grep -Fq $'\t-g, --gzip\t\tgzip compression using zlib' help.all || fail "F1 help missing gzip option text"
+
+
+
+
+
+make_lines_fixture lines.txt
+"$BIN" -g -L 6 -v -o lines.lrz lines.txt >compress.out 2>compress.err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 compress exit $ec; want 0"
+grep -Fq "Compression mode is: GZIP" compress.out || fail "F2 verbose summary missing GZIP"
+
+[ -s lines.lrz ] || fail "F2 missing compressed archive"
+
+"$BIN" -ivv lines.lrz >info.out 2>info.err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 info exit $ec; want 0"
+
+awk '$2 == "gzip" && $4 + 0 < $6 + 0 { found=1 } END { exit found ? 0 : 1 }' info.out || fail "F2 info missing smaller gzip block"
+grep -Fq "  Compression Method: rzip + gzip" info.out || fail "F2 info summary missing rzip + gzip"
+
+
+
+
+
+rm -f lines.restored
+"$BIN" -d -o lines.restored lines.lrz >decompress.out 2>decompress.err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 decompress exit $ec; want 0"
+
+assert_same_file lines.txt lines.restored
+
+
+
+
+make_lines_fixture longopt.txt
+"$BIN" --gzip -L 1 -v -o longopt.lrz longopt.txt >long.out 2>long.err; ec=$?
+[ "$ec" -eq 0 ] || fail "F4 compress exit $ec; want 0"
+grep -Fq "Compression level 1" long.out || fail "F4 missing level 1 summary"
+grep -Fq "Compression mode is: GZIP" long.out || fail "F4 verbose summary missing GZIP"
+"$BIN" -ivv longopt.lrz >longinfo.out 2>longinfo.err; ec=$?
+[ "$ec" -eq 0 ] || fail "F4 info exit $ec; want 0"
+
+awk '$2 == "gzip" && $4 + 0 < $6 + 0 { found=1 } END { exit found ? 0 : 1 }' longinfo.out || fail "F4 info missing smaller gzip block"
+grep -Fq "  Compression Method: rzip + gzip" longinfo.out || fail "F4 info summary missing rzip + gzip"
+
+
+
+
+mkdir confcase
+(
+	cd confcase || exit 1
+	unset LRZIP
+	printf 'CompressionMethod = gzip\nCompressionLevel = 6\n' > lrzip.conf
+	make_lines_fixture conf-lines.txt
+	"$BIN" -v -o conf-lines.lrz conf-lines.txt >conf.out 2>conf.err
+	ec=$?
+	[ "$ec" -eq 0 ] || fail "F5 compress exit $ec; want 0"
+	grep -Fq "Compression mode is: GZIP" conf.out || fail "F5 verbose summary missing GZIP"
+	grep -Fq "Compression level 6" conf.out || fail "F5 config level missing"
+	"$BIN" -ivv conf-lines.lrz >confinfo.out 2>confinfo.err
+	ec=$?
+	[ "$ec" -eq 0 ] || fail "F5 info exit $ec; want 0"
+
+	awk '$2 == "gzip" && $4 + 0 < $6 + 0 { found=1 } END { exit found ? 0 : 1 }' confinfo.out || fail "F5 info missing smaller gzip block"
+	grep -Fq "  Compression Method: rzip + gzip" confinfo.out || fail "F5 info summary missing rzip + gzip"
+)
+
+
+
+
+mkdir badconf
+(
+	cd badconf || exit 1
+	unset LRZIP
+	printf 'CompressionMethod = gzip\nCompressionMethod = bzip2\n' > lrzip.conf
+	printf 'x%.0s' $(seq 1 2000) > x.txt
+	"$BIN" -o x.lrz x.txt >out 2>err
+	ec=$?
+	[ "$ec" -ne 0 ] || fail "F6 want non-zero exit"
+
+	cat out err >combined
+	grep -Eiq "compression method|one compression|only one" combined || fail "F6 missing config conflict diagnostic"
+)
+
+
+
+
+printf 'x%.0s' $(seq 1 2000) > conflict.txt
+"$BIN" -g -b -o conflict.lrz conflict.txt >conflict.out 2>conflict.err; ec=$?
+[ "$ec" -ne 0 ] || fail "F7 want non-zero exit"
+
+cat conflict.out conflict.err >conflict.all
+grep -Eiq "compression method|one of|only one" conflict.all || fail "F7 missing method conflict diagnostic"
+
+
+
+
+make_randomish_fixture randomish.bin
+"$BIN" -g -L 6 -o randomish.lrz randomish.bin >rand.out 2>rand.err; ec=$?
+[ "$ec" -eq 0 ] || fail "F8 compress exit $ec; want 0"
+"$BIN" -ivv randomish.lrz >randinfo.out 2>randinfo.err; ec=$?
+[ "$ec" -eq 0 ] || fail "F8 info exit $ec; want 0"
+
+awk '$2 == "none" && $4 + 0 >= $6 + 0 { found=1 } END { exit found ? 0 : 1 }' randinfo.out || fail "F8 info missing uncompressed data block"
+
+awk '$2 == "gzip" { bad=1 } END { exit bad ? 1 : 0 }' randinfo.out || fail "F8 incompressible data should not be gzip-marked"
+rm -f randomish.restored
+"$BIN" -d -o randomish.restored randomish.lrz >randdec.out 2>randdec.err; ec=$?
+[ "$ec" -eq 0 ] || fail "F8 decompress exit $ec; want 0"
+
+assert_same_file randomish.bin randomish.restored
+
+
+
+
+cp lines.lrz corrupt-data.lrz
+
+read -r first_gzip_offset first_gzip_head first_gzip_clen first_gzip_payload < <(gzip_block_info info.out)
+[ -n "${first_gzip_payload:-}" ] || fail "F9 could not locate gzip block"
+patch_byte corrupt-data.lrz "$first_gzip_payload" '\377'
+"$BIN" -d -o corrupt.out corrupt-data.lrz >corrupt.outlog 2>corrupt.err; ec=$?
+[ "$ec" -ne 0 ] || fail "F9 want non-zero exit"
+
+cat corrupt.outlog corrupt.err >corrupt.all
+grep -Eiq "decompress|corrupt|fatal|error" corrupt.all || fail "F9 missing corruption diagnostic"
+
+
+
+
+cp lines.lrz lenmismatch.lrz
+
+[ -n "${first_gzip_offset:-}" ] || fail "F10 could not locate gzip block"
+patch_byte lenmismatch.lrz "$((first_gzip_offset + 4))" '\102'
+"$BIN" -d -o lenmismatch.out lenmismatch.lrz >lenmismatch.outlog 2>lenmismatch.err; ec=$?
+[ "$ec" -ne 0 ] || fail "F10 want non-zero exit"
+
+cat lenmismatch.outlog lenmismatch.err >lenmismatch.all
+grep -Eiq "length|decompress|fatal|error" lenmismatch.all || fail "F10 missing length mismatch diagnostic"
+
+echo "PASS"
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
