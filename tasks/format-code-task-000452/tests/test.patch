diff --git a/workflow/validate/validate_test.go b/workflow/validate/validate_test.go
index e66aa948b..52165f23f 100644
--- a/workflow/validate/validate_test.go
+++ b/workflow/validate/validate_test.go
@@ -2490,3 +2490,92 @@ func TestValidateFieldsWithWFTRef(t *testing.T) {
 	_, err = validate(invalidWFWithWFTRef)
 	assert.Error(t, err)
 }
+
+
+
+
+
+
+var emptyContainerImageWf = `
+apiVersion: argoproj.io/v1alpha1
+kind: Workflow
+metadata:
+  generateName: hello-world-
+spec:
+  entrypoint: whalesay
+  templates:
+  - name: whalesay
+    container:
+      command: [cowsay]
+      args: ["hello world"]
+`
+
+func TestEmptyContainerImageRejected(t *testing.T) {
+	_, err := validate(emptyContainerImageWf)
+	if assert.Error(t, err) {
+		assert.Contains(t, err.Error(), "templates.whalesay.container.image")
+	}
+}
+
+var emptyScriptImageWf = `
+apiVersion: argoproj.io/v1alpha1
+kind: Workflow
+metadata:
+  generateName: script-no-image-
+spec:
+  entrypoint: hello
+  templates:
+  - name: hello
+    script:
+      command: [bash]
+      source: |
+        echo hello
+`
+
+func TestEmptyScriptImageRejected(t *testing.T) {
+	_, err := validate(emptyScriptImageWf)
+	if assert.Error(t, err) {
+		assert.Contains(t, err.Error(), "templates.hello.script.image")
+	}
+}
+
+var validContainerImageWf = `
+apiVersion: argoproj.io/v1alpha1
+kind: Workflow
+metadata:
+  generateName: hello-world-
+spec:
+  entrypoint: whalesay
+  templates:
+  - name: whalesay
+    container:
+      image: docker/whalesay:latest
+      command: [cowsay]
+      args: ["hello world"]
+`
+
+func TestValidContainerImagePasses(t *testing.T) {
+	_, err := validate(validContainerImageWf)
+	assert.NoError(t, err)
+}
+
+var validScriptImageWf = `
+apiVersion: argoproj.io/v1alpha1
+kind: Workflow
+metadata:
+  generateName: script-with-image-
+spec:
+  entrypoint: hello
+  templates:
+  - name: hello
+    script:
+      image: python:alpine3.6
+      command: [python]
+      source: |
+        print("hi")
+`
+
+func TestValidScriptImagePasses(t *testing.T) {
+	_, err := validate(validScriptImageWf)
+	assert.NoError(t, err)
+}
