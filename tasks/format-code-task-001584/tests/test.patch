+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    cd tests
+    PYTHONPATH="../" python3 -m pytest -vvv test_transformation.py::test_error_cases
+    ;;
+  new)
+    PYTHONPATH="." python3 -m pytest -q tests/integration/test_mgmt_addressing_validation.py
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
