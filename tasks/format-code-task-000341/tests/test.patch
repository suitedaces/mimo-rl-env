@@ -0,0 +1,235 @@
+import argparse
+import os
+import sys
+
+import pytest
+import yaml
+
+from vyper import Vyper
+
+
+class argv_context:
+    def __init__(self, argv):
+        self.argv = argv
+        self.previous = None
+
+    def __enter__(self):
+        self.previous = sys.argv[:]
+        sys.argv = self.argv[:]
+
+    def __exit__(self, exc_type, exc, tb):
+        sys.argv = self.previous
+
+
+def port_parser():
+    parser = argparse.ArgumentParser(prog="fixture-probe")
+    parser.add_argument("--port", type=int, default=5000)
+    parser.add_argument("--host", default="127.0.0.1")
+    parser.add_argument("--debug", action="store_true", default=False)
+    return parser
+
+
+def test_bind_args_parser_defaults_are_visible_without_flags():
+
+
+
+
+    with argv_context(["fixture-probe"]):
+        v = Vyper()
+        result = v.bind_args(port_parser())
+
+    assert result is None
+    assert v.get("port") == 5000
+    assert v.get("host") == "127.0.0.1"
+    assert v.get("debug") is False
+    assert v.is_set("debug") is True
+    assert sorted(v.all_keys()) == ["debug", "host", "port"]
+    assert dict(sorted(v.all_settings().items())) == {
+        "debug": False,
+        "host": "127.0.0.1",
+        "port": 5000,
+    }
+
+
+def test_parser_defaults_do_not_mask_environment_values():
+
+
+
+
+    os.environ["VYPER_FIXTURE_PORT"] = "6200"
+    try:
+        with argv_context(["fixture-probe"]):
+            v = Vyper()
+            v.bind_env("port", "VYPER_FIXTURE_PORT")
+            result = v.bind_args(port_parser())
+            observed_port = v.get("port")
+            observed_settings = dict(sorted(v.all_settings().items()))
+    finally:
+        os.environ.pop("VYPER_FIXTURE_PORT", None)
+
+    assert result is None
+    assert observed_port == "6200"
+    assert observed_settings == {
+        "debug": False,
+        "host": "127.0.0.1",
+        "port": "6200",
+    }
+
+
+def test_explicit_parser_value_overrides_lower_priority_sources_and_set_still_wins():
+
+
+
+
+    os.environ["VYPER_FIXTURE_PORT"] = "6200"
+    try:
+        with argv_context(["fixture-probe", "--port", "7000"]):
+            v = Vyper()
+            v.set_default("port", 4000)
+            v.set_config_type("yaml")
+            v.read_config(yaml.safe_dump({"port": 6100, "name": "from-config"}))
+            v.bind_env("port", "VYPER_FIXTURE_PORT")
+            result = v.bind_args(port_parser())
+
+            observed_after_args = v.get("port")
+            observed_name = v.get("name")
+            observed_settings_after_args = dict(sorted(v.all_settings().items()))
+
+            v.set("port", 8000)
+            observed_after_override = v.get("port")
+            observed_settings_after_override = dict(sorted(v.all_settings().items()))
+    finally:
+        os.environ.pop("VYPER_FIXTURE_PORT", None)
+
+    assert result is None
+    assert observed_after_args == 7000
+    assert observed_name == "from-config"
+    assert observed_settings_after_args == {"debug": False, "host": "127.0.0.1", "name": "from-config", "port": 7000}
+    assert observed_after_override == 8000
+    assert observed_settings_after_override == {"debug": False, "host": "127.0.0.1", "name": "from-config", "port": 8000}
+
+
+def test_bind_args_mapping_and_bind_arg_values_ignore_null_values():
+
+
+
+
+    v = Vyper()
+
+    first_result = v.bind_args({"port": 7000, "debug": None})
+    second_result = v.bind_arg_values({"mode": "prod", "workers": 3, "ignored": None})
+
+    assert first_result is None
+    assert second_result is None
+    assert v.get("port") == 7000
+    assert v.get("debug") is None
+    assert v.get("mode") == "prod"
+    assert v.get("workers") == 3
+    assert v.get("ignored") is None
+    assert v.is_set("debug") is False
+    assert v.is_set("ignored") is False
+    assert sorted(v.all_keys()) == ["mode", "port", "workers"]
+    assert dict(sorted(v.all_settings().items())) == {
+        "mode": "prod",
+        "port": 7000,
+        "workers": 3,
+    }
+
+
+def test_direct_single_key_binding_is_case_insensitive_and_stateful():
+
+
+
+
+    v = Vyper()
+
+    first_result = v.bind_arg("FeatureFlag", True)
+    second_result = v.bind_arg_value("MiXeD", "yes")
+
+    assert first_result is None
+    assert second_result is None
+    assert v.get("featureflag") is True
+    assert v.get("FEATUREFLAG") is True
+    assert v.get("mixed") == "yes"
+    assert v.get("MIXED") == "yes"
+    assert v.is_set("mIxEd") is True
+    assert sorted(v.all_keys()) == ["featureflag", "mixed"]
+    assert dict(sorted(v.all_settings().items())) == {
+        "featureflag": True,
+        "mixed": "yes",
+    }
+
+
+def test_bind_arg_value_rejects_null_with_specific_exception():
+
+
+
+
+    v = Vyper()
+
+
+    with pytest.raises(ValueError):
+        v.bind_arg_value("missing", None)
+
+    assert v.get("missing") is None
+    assert v.is_set("missing") is False
+    assert sorted(v.all_keys()) == []
+    assert dict(v.all_settings()) == {}
+
+
+def test_argparse_invalid_choice_surfaces_system_exit():
+
+
+
+
+    parser = argparse.ArgumentParser(prog="fixture-probe")
+    parser.add_argument("--env", choices=["dev", "prod"])
+
+    with argv_context(["fixture-probe", "--env", "qa"]):
+        v = Vyper()
+        with pytest.raises(SystemExit) as exc_info:
+            v.bind_args(parser)
+
+
+    assert exc_info.type is SystemExit
+
+
+def test_separate_instances_keep_independent_argument_state():
+
+
+
+
+    a = Vyper()
+    b = Vyper()
+
+    a.bind_arg_value("port", 7000)
+    b.bind_arg_values({"port": 5000, "feature": True})
+
+    assert a.get("port") == 7000
+    assert a.get("feature") is None
+    assert sorted(a.all_keys()) == ["port"]
+    assert dict(sorted(a.all_settings().items())) == {"port": 7000}
+    assert b.get("port") == 5000
+    assert b.get("feature") is True
+    assert sorted(b.all_keys()) == ["feature", "port"]
+    assert dict(sorted(b.all_settings().items())) == {"feature": True, "port": 5000}
+
+
+def test_argument_binding_updates_observable_state_across_construct_use_drop_cycles():
+
+
+
+
+    for i in range(200):
+        v = Vyper()
+        v.bind_arg_values({"port": i, "mode": "prod"})
+        assert v.get("mode") == "prod"
+        assert v.is_set("port") is True
+        assert sorted(v.all_keys()) == ["mode", "port"]
+        assert set(v.all_settings()) == {"mode", "port"}
+        del v
+
+    fresh = Vyper()
+
+    assert fresh.get("port") is None
+    assert sorted(fresh.all_keys()) == []
