+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+
+export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}"
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD="${PYTEST_DISABLE_PLUGIN_AUTOLOAD:-1}"
+export PIP_NO_INDEX="${PIP_NO_INDEX:-1}"
+export PYTHONNOUSERSITE="${PYTHONNOUSERSITE:-1}"
+
+VENV="${STAGE4A_VENV:-/opt/nodegraphqt-stage4a-venv}"
+PYTHON="${VENV}/bin/python"
+if [ ! -x "${PYTHON}" ]; then
+  echo "local: missing preinstalled offline venv: ${VENV}" >&2
+  exit 127
+fi
+
+exec "${PYTHON}" -m pytest /workspace/repo/usercase-test-coderl/test_graph_session_persistence.py -v
