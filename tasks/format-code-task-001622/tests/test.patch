+import contextlib
+import io
+import json
+import os
+
+os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
+
+import pytest
+from Qt import QtWidgets
+
+from NodeGraphQt import BaseNode, NodeGraph
+
+
+class FixtureNode(BaseNode):
+    __identifier__ = "usercase.acceptance"
+    NODE_NAME = "Fixture Node"
+
+    def __init__(self):
+        super(FixtureNode, self).__init__()
+        self.add_input("in")
+        self.add_output("out")
+        self.create_property("tag", "initial")
+
+
+@pytest.fixture(scope="session", autouse=True)
+def qt_application():
+    app = QtWidgets.QApplication.instance() or QtWidgets.QApplication([])
+    return app
+
+
+def make_graph():
+    graph = NodeGraph()
+    graph.register_node(FixtureNode)
+    return graph
+
+
+def node_names(graph):
+    return sorted(node.name() for node in graph.all_nodes())
+
+
+def nested_lists(value):
+    if isinstance(value, list):
+        yield value
+        for item in value:
+            yield from nested_lists(item)
+    elif isinstance(value, dict):
+        for item in value.values():
+            yield from nested_lists(item)
+
+
+def add_constraint(node):
+    in_port = node.input(0)
+    out_port = node.output(0)
+    node.add_accept_port_type(
+        in_port,
+        {
+            "port_name": out_port.name(),
+            "port_type": out_port.type_(),
+            "node_type": FixtureNode.type_,
+        },
+    )
+
+
+def saved_layout(tmp_path):
+    graph = make_graph()
+    node = graph.create_node(FixtureNode.type_, name="Alpha Node", pos=(12, 34))
+    add_constraint(node)
+    path = tmp_path / "layout.json"
+    graph.save_session(" {} ".format(path))
+    return path
+
+
+def test_save_session_strips_path_writes_readable_json_and_updates_current_session(tmp_path):
+
+
+
+
+    graph = make_graph()
+    before_session = graph.current_session()
+    assert node_names(graph) == []
+
+    node = graph.create_node(FixtureNode.type_, name="Alpha Node", pos=(12, 34))
+    add_constraint(node)
+    assert node_names(graph) == ["Alpha Node"]
+    assert graph.current_session() == before_session
+
+    path = tmp_path / "layout.json"
+
+    graph.save_session(" {} ".format(path))
+
+    assert graph.current_session() == str(path)
+    assert path.exists() is True
+    text = path.read_text()
+
+    assert "\n" in text and text.startswith("{")
+    assert any(line.startswith("  ") for line in text.splitlines()[1:])
+
+    data = json.loads(text)
+
+    assert "graph" in data and "nodes" in data
+    assert len(data["nodes"]) == 1
+    assert sorted(node_data["name"] for node_data in data["nodes"].values()) == [
+        "Alpha Node"
+    ]
+
+
+    accept_types = json.loads(data["graph"]["accept_connection_types"])
+    assert ["out"] in list(nested_lists(accept_types))
+
+
+def test_load_session_strips_path_clears_existing_graph_and_clears_undo(tmp_path):
+
+
+
+
+    path = saved_layout(tmp_path)
+    graph = make_graph()
+    graph.create_node(FixtureNode.type_, name="Temporary Node")
+
+    assert node_names(graph) == ["Temporary Node"]
+    assert graph.undo_stack().count() > 0
+
+
+    graph.load_session(" {} ".format(path))
+
+    assert graph.current_session() == str(path)
+    assert node_names(graph) == ["Alpha Node"]
+    assert graph.undo_stack().count() == 0
+    assert graph.undo_stack().isClean() is True
+
+
+def test_load_session_missing_file_raises_specific_ioerror(tmp_path):
+
+
+
+
+    graph = make_graph()
+    missing = tmp_path / "missing.json"
+    before_session = graph.current_session()
+
+    with pytest.raises(OSError) as excinfo:
+        graph.load_session(" {} ".format(missing))
+
+    assert str(excinfo.value) == "file does not exist: {}".format(missing)
+
+    assert graph.current_session() == before_session
+    assert node_names(graph) == []
+
+
+def test_import_session_merges_updates_session_emits_signal_and_preserves_undo(tmp_path):
+
+
+
+
+    path = saved_layout(tmp_path)
+    graph = make_graph()
+    graph.create_node(FixtureNode.type_, name="Existing Node")
+    emitted = []
+    graph.session_changed.connect(lambda session_path: emitted.append(session_path))
+
+    assert node_names(graph) == ["Existing Node"]
+    assert graph.undo_stack().count() > 0
+
+
+    graph.import_session(" {} ".format(path), clear_undo_stack=False)
+
+    assert graph.current_session() == str(path)
+    assert node_names(graph) == ["Alpha Node", "Existing Node"]
+
+    assert str(path) in emitted
+
+
+    assert graph.undo_stack().count() > 0
+    assert graph.undo_stack().isClean() is False
+
+
+def test_import_session_with_default_clear_undo_stack_clears_undo(tmp_path):
+
+
+
+
+    path = saved_layout(tmp_path)
+    graph = make_graph()
+    graph.create_node(FixtureNode.type_, name="Existing Node")
+
+    assert graph.undo_stack().count() > 0
+
+
+    graph.import_session(" {} ".format(path))
+
+    assert graph.current_session() == str(path)
+    assert node_names(graph) == ["Alpha Node", "Existing Node"]
+    assert graph.undo_stack().count() == 0
+    assert graph.undo_stack().isClean() is True
+
+
+def test_import_session_missing_file_raises_specific_ioerror(tmp_path):
+
+
+
+
+    graph = make_graph()
+    graph.create_node(FixtureNode.type_, name="Existing Node")
+    missing = tmp_path / "missing.json"
+    before_session = graph.current_session()
+
+    with pytest.raises(OSError) as excinfo:
+        graph.import_session(" {} ".format(missing))
+
+    assert str(excinfo.value) == "file does not exist: {}".format(missing)
+
+    assert graph.current_session() == before_session
+    assert node_names(graph) == ["Existing Node"]
+
+
+def test_import_session_bad_json_prints_message_and_leaves_graph_unchanged(tmp_path):
+
+
+
+
+    path = tmp_path / "bad.json"
+    path.write_text("{bad json")
+    graph = make_graph()
+    graph.create_node(FixtureNode.type_, name="Keep Node")
+    before_session = graph.current_session()
+
+    output = io.StringIO()
+    with contextlib.redirect_stdout(output):
+
+        graph.import_session(" {} ".format(path))
+
+
+    assert "Cannot read data from file." in output.getvalue()
+    assert graph.current_session() == before_session
+    assert node_names(graph) == ["Keep Node"]
+    assert len(graph.serialize_session()["nodes"]) == 1
+
+
+def test_repeated_load_is_idempotent_cleanup_for_file_backed_session(tmp_path):
+
+
+
+
+    path = saved_layout(tmp_path)
+    graph = make_graph()
+
+
+    graph.load_session(str(path))
+    assert graph.current_session() == str(path)
+    assert node_names(graph) == ["Alpha Node"]
+    assert graph.undo_stack().count() == 0
+
+
+    graph.load_session(str(path))
+    assert graph.current_session() == str(path)
+    assert node_names(graph) == ["Alpha Node"]
+    assert graph.undo_stack().count() == 0
+
+
+def test_two_graph_instances_keep_independent_session_state(tmp_path):
+
+
+
+
+    path = tmp_path / "layout.json"
+    graph_a = make_graph()
+    graph_b = make_graph()
+    before_b_session = graph_b.current_session()
+
+    graph_a.create_node(FixtureNode.type_, name="Only A")
+
+    graph_a.save_session(str(path))
+
+    assert graph_a.current_session() == str(path)
+
+    assert graph_b.current_session() == before_b_session
+    assert node_names(graph_a) == ["Only A"]
+    assert node_names(graph_b) == []
+
+
+def test_construct_use_clear_cycles_do_not_retain_graph_nodes(tmp_path):
+
+
+
+
+    path = saved_layout(tmp_path)
+    for _ in range(20):
+        graph = make_graph()
+        graph.load_session(str(path))
+        assert node_names(graph) == ["Alpha Node"]
+        graph.clear_session()
+
+
+        assert node_names(graph) == []
