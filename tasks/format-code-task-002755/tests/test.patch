diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,66 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+dev-switch python3 3.12
+
+if [ ! -d /testbed/.venv ]; then
+    python3 -m venv /testbed/.venv
+fi
+
+set +u
+source /testbed/.venv/bin/activate
+set -u
+
+pip install --no-input ".[aiohttp,asgi,django,flask,fastapi,chalice,debug]" 2>&1 | tail -5
+pip install --no-input "sanic>=22.12,<23" "sanic-testing>=22.9,<23" 2>&1 | tail -5
+pip install --no-input \
+  "pytest>=7.2,<8" "pytest-asyncio>=0.20,<0.21" pytest-mock pytest-django pytest-flask \
+  freezegun pytest-aiohttp pytest-emoji \
+  pytest-benchmark pytest-snapshot pytest-mypy-plugins mypy 2>&1 | tail -5
+
+export PYTHONPATH=/testbed
+
+
+PYTEST_BASE_ARGS=(
+  -q
+  -s
+  --emoji
+  --mypy-ini-file=mypy.ini
+  --benchmark-disable
+)
+
+case "${1:-}" in
+  base)
+    pytest "${PYTEST_BASE_ARGS[@]}" \
+      tests/aiohttp/test_query_params.py::test_get_with_query_params \
+      tests/aiohttp/test_query_params.py::test_can_pass_variables_with_query_params \
+      tests/asgi/test_query_params.py::test_get_with_query_params \
+      tests/asgi/test_query_params.py::test_can_pass_variables_with_query_params \
+      tests/asgi/test_upload.py::test_single_file_upload \
+      tests/django/test_upload.py::test_upload \
+      tests/fastapi/test_query_params.py::test_get_with_query_params \
+      tests/fastapi/test_query_params.py::test_can_pass_variables_with_query_params \
+      tests/fastapi/test_upload.py::test_single_file_upload
+    ;;
+  new)
+    pytest "${PYTEST_BASE_ARGS[@]}" \
+      tests/aiohttp/test_query_params.py::test_get_with_malformed_variables_json_returns_400 \
+      tests/asgi/test_query_params.py::test_get_with_malformed_variables_json_returns_400 \
+      tests/asgi/test_upload.py::test_multipart_malformed_operations_json_returns_400 \
+      tests/asgi/test_upload.py::test_multipart_malformed_map_json_returns_400 \
+      tests/asgi/test_upload.py::test_multipart_missing_referenced_file_returns_400 \
+      tests/asgi/test_http.py::test_post_json_with_malformed_body_returns_400 \
+      tests/django/test_upload.py::test_multipart_missing_referenced_file_returns_400 \
+      tests/fastapi/test_query_params.py::test_get_with_malformed_variables_json_returns_400 \
+      tests/fastapi/test_query_params.py::test_get_without_query_and_graphiql_disabled_returns_404 \
+      tests/fastapi/test_upload.py::test_multipart_malformed_operations_json_returns_400 \
+      tests/fastapi/test_upload.py::test_multipart_malformed_map_json_returns_400 \
+      tests/fastapi/test_upload.py::test_multipart_missing_referenced_file_returns_400
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
