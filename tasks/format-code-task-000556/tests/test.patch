diff --git a/usercase-test-coderl/wacbeacon_test.go b/usercase-test-coderl/wacbeacon_test.go
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/wacbeacon_test.go
@@ -0,0 +1,215 @@
+package usercase_test_coderl
+
+import (
+	"encoding/hex"
+	"os"
+	"reflect"
+	"runtime"
+	"testing"
+
+	waclib "github.com/BertoldVdb/WACResearch/waclib"
+)
+
+
+
+
+
+
+func mustHex(t *testing.T, raw string) []byte {
+	t.Helper()
+	data, err := hex.DecodeString(raw)
+	if err != nil {
+		t.Fatalf("test fixture hex must decode: %v", err)
+	}
+	return data
+}
+
+func assertHex(t *testing.T, got []byte, want string) {
+	t.Helper()
+	if hex.EncodeToString(got) != want {
+		t.Fatalf("hex output = %s, want %s", hex.EncodeToString(got), want)
+	}
+}
+
+func assertBeaconFields(t *testing.T, got waclib.WACBeacon, mac [6]byte, flags []byte, name string, supplier string, typ string) {
+	t.Helper()
+	if got.MACAddress != mac {
+		t.Fatalf("MACAddress = %x, want %x", got.MACAddress, mac)
+	}
+	if !reflect.DeepEqual(got.Flags, flags) {
+		t.Fatalf("Flags = %x, want %x", got.Flags, flags)
+	}
+	if got.Name != name {
+		t.Fatalf("Name = %q, want %q", got.Name, name)
+	}
+	if got.Supplier != supplier {
+		t.Fatalf("Supplier = %q, want %q", got.Supplier, supplier)
+	}
+	if got.Type != typ {
+		t.Fatalf("Type = %q, want %q", got.Type, typ)
+	}
+}
+
+func assertErrorMessage(t *testing.T, err error, message string) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("error = <nil>, want message %q", message)
+	}
+
+	if err.Error() != message {
+		t.Fatalf("error message = %q, want %q", err.Error(), message)
+	}
+}
+
+func openFDCount(t *testing.T) int {
+	t.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		t.Fatalf("reading /proc/self/fd failed: %v", err)
+	}
+	return len(entries)
+}
+
+func TestMarshalFullBeaconRepeatedlyStableAndDoesNotMutate(t *testing.T) {
+
+
+
+
+	beacon := waclib.WACBeacon{
+		MACAddress: [6]byte{0x00, 0x11, 0x22, 0x33, 0x44, 0x55},
+		Flags:      []byte{0x70, 0x03},
+		Name:       "Name",
+		Supplier:   "waclib",
+		Type:       "Type",
+	}
+
+	assertBeaconFields(t, beacon, [6]byte{0x00, 0x11, 0x22, 0x33, 0x44, 0x55}, []byte{0x70, 0x03}, "Name", "waclib", "Type")
+	assertHex(t, beacon.Marshal(), "dd2400a0400007060011223344550002700301044e616d6502067761636c6962030454797065")
+	assertBeaconFields(t, beacon, [6]byte{0x00, 0x11, 0x22, 0x33, 0x44, 0x55}, []byte{0x70, 0x03}, "Name", "waclib", "Type")
+	assertHex(t, beacon.Marshal(), "dd2400a0400007060011223344550002700301044e616d6502067761636c6962030454797065")
+	assertBeaconFields(t, beacon, [6]byte{0x00, 0x11, 0x22, 0x33, 0x44, 0x55}, []byte{0x70, 0x03}, "Name", "waclib", "Type")
+}
+
+func TestMarshalMinimalBeaconOmitsEmptyTextFields(t *testing.T) {
+
+
+
+
+	beacon := waclib.WACBeacon{
+		MACAddress: [6]byte{0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff},
+		Flags:      []byte{0xf0, 0x03},
+	}
+
+	assertBeaconFields(t, beacon, [6]byte{0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff}, []byte{0xf0, 0x03}, "", "", "")
+	assertHex(t, beacon.Marshal(), "dd1000a040000706aabbccddeeff0002f003")
+	assertBeaconFields(t, beacon, [6]byte{0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff}, []byte{0xf0, 0x03}, "", "", "")
+}
+
+func TestUnmarshalFullBeaconSetsAllFields(t *testing.T) {
+
+
+
+
+	var beacon waclib.WACBeacon
+
+	err := beacon.Unmarshal(mustHex(t, "dd2400a0400007060011223344550002700301044e616d6502067761636c6962030454797065"))
+	if err != nil {
+		t.Fatalf("Unmarshal error = %v, want <nil>", err)
+	}
+	assertBeaconFields(t, beacon, [6]byte{0x00, 0x11, 0x22, 0x33, 0x44, 0x55}, []byte{0x70, 0x03}, "Name", "waclib", "Type")
+}
+
+func TestUnmarshalMinimalBeaconLeavesTextFieldsEmpty(t *testing.T) {
+
+
+
+
+	var beacon waclib.WACBeacon
+
+	err := beacon.Unmarshal(mustHex(t, "dd1000a040000706aabbccddeeff0002f003"))
+	if err != nil {
+		t.Fatalf("Unmarshal error = %v, want <nil>", err)
+	}
+	assertBeaconFields(t, beacon, [6]byte{0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff}, []byte{0xf0, 0x03}, "", "", "")
+}
+
+func TestUnmarshalMissingAppleWACRecordReturnsSpecificError(t *testing.T) {
+
+
+
+
+	var beacon waclib.WACBeacon
+
+	err := beacon.Unmarshal([]byte{0x01, 0x02, 0xab, 0xcd})
+	assertErrorMessage(t, err, "record not found")
+
+}
+
+func TestUnmarshalWrongMACLengthReturnsSpecificError(t *testing.T) {
+
+
+
+
+	var beacon waclib.WACBeacon
+
+	err := beacon.Unmarshal(mustHex(t, "dd0b00a04000070500112233440002f003"))
+	assertErrorMessage(t, err, "MAC address has wrong length")
+
+}
+
+func TestTwoBeaconInstancesKeepIndependentReceiverState(t *testing.T) {
+
+
+
+
+	var a waclib.WACBeacon
+	var b waclib.WACBeacon
+
+	err := a.Unmarshal(mustHex(t, "dd2400a0400007060011223344550002700301044e616d6502067761636c6962030454797065"))
+	if err != nil {
+		t.Fatalf("Unmarshal error = %v, want <nil>", err)
+	}
+	assertBeaconFields(t, a, [6]byte{0x00, 0x11, 0x22, 0x33, 0x44, 0x55}, []byte{0x70, 0x03}, "Name", "waclib", "Type")
+	assertBeaconFields(t, b, [6]byte{0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, nil, "", "", "")
+
+	err = b.Unmarshal(mustHex(t, "dd1000a040000706aabbccddeeff0002f003"))
+	if err != nil {
+		t.Fatalf("Unmarshal error = %v, want <nil>", err)
+	}
+	assertBeaconFields(t, a, [6]byte{0x00, 0x11, 0x22, 0x33, 0x44, 0x55}, []byte{0x70, 0x03}, "Name", "waclib", "Type")
+	assertBeaconFields(t, b, [6]byte{0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff}, []byte{0xf0, 0x03}, "", "", "")
+}
+
+func TestRepeatedMarshalUnmarshalCyclesDoNotCreateResourceSideEffects(t *testing.T) {
+
+
+
+
+	runtime.GC()
+	startFDs := openFDCount(t)
+
+	for i := 0; i < 100; i++ {
+		beacon := waclib.WACBeacon{
+			MACAddress: [6]byte{0x00, 0x11, 0x22, 0x33, 0x44, 0x55},
+			Flags:      []byte{0x70, 0x03},
+			Name:       "Name",
+			Supplier:   "waclib",
+			Type:       "Type",
+		}
+		assertHex(t, beacon.Marshal(), "dd2400a0400007060011223344550002700301044e616d6502067761636c6962030454797065")
+
+		var parsed waclib.WACBeacon
+		err := parsed.Unmarshal(mustHex(t, "dd1000a040000706aabbccddeeff0002f003"))
+		if err != nil {
+			t.Fatalf("cycle %d Unmarshal error = %v, want <nil>", i, err)
+		}
+		assertBeaconFields(t, parsed, [6]byte{0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff}, []byte{0xf0, 0x03}, "", "", "")
+	}
+
+	runtime.GC()
+	endFDs := openFDCount(t)
+	if endFDs > startFDs+2 {
+		t.Fatalf("open fd count = %d after cycles, want at most %d", endFDs, startFDs+2)
+	}
+
+}
