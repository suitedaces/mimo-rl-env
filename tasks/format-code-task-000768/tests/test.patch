+    assert actual == SnowflakeDynamicTableConfigChangeset(
+        cluster_by=SnowflakeDynamicTableClusterByConfigChange(
+            action=ALTER,
+            context="USER_ID, EVENT_DATE",
+        )
+    )
+    assert actual.has_changes is True
+    assert actual.requires_full_refresh is False
+
+
+def test_requested_auto_refresh_mode_difference_is_ignored():
+
+
+
+
+    actual = SnowflakeRelation.dynamic_table_config_changeset(
+        relation_results(refresh_mode="FULL"),
+        relation_config(refresh_mode="AUTO"),
+    )
+
+    assert actual is None
+
+
+def test_requested_full_refresh_mode_difference_is_create_change_requiring_full_refresh():
+
+
+
+
+    actual = SnowflakeRelation.dynamic_table_config_changeset(
+        relation_results(refresh_mode="AUTO"),
