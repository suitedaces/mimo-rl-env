+import builtins
+import copy
+import json
+import os
+import socket
+import subprocess
+import sys
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Optional
+
+from dbt.adapters.relation_configs import RelationConfigChangeAction
+from dbt.adapters.snowflake import SnowflakeRelation
+from dbt.adapters.snowflake.relation_configs import (
+    SnowflakeDynamicTableClusterByConfigChange,
+    SnowflakeDynamicTableConfigChangeset,
+    SnowflakeDynamicTableImmutableWhereConfigChange,
+    SnowflakeDynamicTableInitializationWarehouseConfigChange,
+    SnowflakeDynamicTableRefreshModeConfigChange,
+    SnowflakeDynamicTableSchedulerConfigChange,
+    SnowflakeDynamicTableTargetLagConfigChange,
+    SnowflakeDynamicTableTransientConfigChange,
+    SnowflakeDynamicTableWarehouseConfigChange,
+)
+
+
+
+
+
+
+
+class ConfigFixture:
+    def __init__(self, extra):
+        self.extra = dict(extra)
+        self.materialized = "dynamic_table"
+
+    def get(self, key, default=None):
+        return self.extra.get(key, default)
+
+    def __bool__(self):
+        return True
+
+    def __eq__(self, other):
+        return (
+            isinstance(other, ConfigFixture)
+            and self.extra == other.extra
+            and self.materialized == other.materialized
+        )
+
+
+@dataclass
+class RelationConfigFixture:
+    database: str = "DB"
+    schema: str = "SCHEMA"
+    identifier: str = "DT"
+    compiled_code: Optional[str] = "select 1 as id"
+    config: ConfigFixture = field(default_factory=lambda: ConfigFixture({}))
+
+
+@dataclass
+class RowFixture:
+    values: dict
+
+    def get(self, key, default=None):
+        return self.values.get(key, default)
+
+
+@dataclass
+class TableFixture:
+    rows: list
+
+
+BASE_EXISTING_DYNAMIC_TABLE = {
+    "name": "DT",
+    "schema_name": "SCHEMA",
+    "database_name": "DB",
+    "text": "select 1 as id",
+    "target_lag": "1 minute",
+    "warehouse": "WH_X",
+    "initialization_warehouse": None,
+    "refresh_mode": "AUTO",
+    "scheduler": "ENABLE",
+    "row_access_policy": None,
+    "table_tag": None,
+    "cluster_by": None,
+    "immutable_where": None,
+    "transient": None,
+}
+
+BASE_REQUESTED_CONFIG = {
+    "target_lag": "1 minute",
+    "snowflake_warehouse": "WH_X",
+    "snowflake_initialization_warehouse": None,
+    "refresh_mode": "AUTO",
+    "scheduler": "ENABLE",
+    "immutable_where": None,
+    "cluster_by": None,
+}
+
+ALTER = RelationConfigChangeAction.alter
+CREATE = RelationConfigChangeAction.create
+
+
+def relation_results(**overrides):
+    values = dict(BASE_EXISTING_DYNAMIC_TABLE)
+    values.update(overrides)
+    return {"dynamic_table": TableFixture([RowFixture(values)])}
+
+
+def relation_config(**overrides):
+    extra = dict(BASE_REQUESTED_CONFIG)
+    extra.update(overrides)
+    return RelationConfigFixture(config=ConfigFixture(extra))
+
+
+def serialize_changeset(changeset):
+    if changeset is None:
+        return None
+    fields = (
+        "target_lag",
+        "snowflake_warehouse",
+        "snowflake_initialization_warehouse",
+        "refresh_mode",
+        "scheduler",
+        "immutable_where",
+        "cluster_by",
+        "transient",
+    )
+    result = {}
+    for field_name in fields:
+        change = getattr(changeset, field_name)
+        result[field_name] = (
+            None
+            if change is None
+            else {
+                "action": str(change.action),
+                "context": change.context,
+                "requires_full_refresh": change.requires_full_refresh,
+            }
+        )
+    result["has_changes"] = changeset.has_changes
+    result["requires_full_refresh"] = changeset.requires_full_refresh
+    return result
+
+
+def test_returns_none_when_dynamic_table_settings_match():
+
+
+
+
+    actual = SnowflakeRelation.dynamic_table_config_changeset(
+        relation_results(),
+        relation_config(),
+    )
+
+    assert actual is None
+
+
+def test_target_lag_and_refresh_warehouse_differences_are_alter_changes():
+
+
+
+
+    actual = SnowflakeRelation.dynamic_table_config_changeset(
+        relation_results(),
+        relation_config(target_lag="5 minutes", refresh_warehouse="WH_REFRESH"),
+    )
+
+    assert actual == SnowflakeDynamicTableConfigChangeset(
+        target_lag=SnowflakeDynamicTableTargetLagConfigChange(
+            action=ALTER,
+            context="5 minutes",
+        ),
+        snowflake_warehouse=SnowflakeDynamicTableWarehouseConfigChange(
+            action=ALTER,
+            context="WH_REFRESH",
+        ),
+    )
+    assert actual.has_changes is True
+    assert actual.requires_full_refresh is False
+
+
+def test_requested_none_target_lag_is_ignored():
+
+
+
+
+    actual = SnowflakeRelation.dynamic_table_config_changeset(
+        relation_results(scheduler="DISABLE"),
+        relation_config(target_lag=None, scheduler="DISABLE"),
+    )
+
+    assert actual is None
+
+
+def test_initialization_warehouse_difference_is_alter_change():
+
+
+
+
+    actual = SnowflakeRelation.dynamic_table_config_changeset(
