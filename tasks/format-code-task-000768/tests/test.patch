+
+    assert actual == SnowflakeDynamicTableConfigChangeset(
+        snowflake_initialization_warehouse=SnowflakeDynamicTableInitializationWarehouseConfigChange(
+            action=ALTER,
+            context="WH_INIT",
+        )
+    )
+    assert actual.has_changes is True
+    assert actual.requires_full_refresh is False
+
+
+def test_scheduler_difference_is_alter_change():
+
+
+
+
+    actual = SnowflakeRelation.dynamic_table_config_changeset(
+        relation_results(target_lag=None, scheduler="ENABLE"),
+        relation_config(target_lag=None, scheduler="DISABLE"),
+    )
+
+    assert actual == SnowflakeDynamicTableConfigChangeset(
+        scheduler=SnowflakeDynamicTableSchedulerConfigChange(
+            action=ALTER,
+            context="DISABLE",
+        )
+    )
+    assert actual.has_changes is True
+    assert actual.requires_full_refresh is False
+
+
+def test_immutable_where_difference_uses_normalized_requested_context():
+
+
+
+
+    actual = SnowflakeRelation.dynamic_table_config_changeset(
+        relation_results(immutable_where="IMMUTABLE WHERE (tenant_id > 10)"),
+        relation_config(immutable_where="tenant_id > 99"),
+    )
+
+    assert actual == SnowflakeDynamicTableConfigChangeset(
+        immutable_where=SnowflakeDynamicTableImmutableWhereConfigChange(
+            action=ALTER,
+            context="tenant_id > 99",
+        )
+    )
+    assert actual.has_changes is True
+    assert actual.requires_full_refresh is False
+
+
+def test_cluster_by_difference_uses_joined_requested_list_context():
+
+
+
+
+    actual = SnowflakeRelation.dynamic_table_config_changeset(
+        relation_results(cluster_by="USER_ID"),
+        relation_config(cluster_by=["USER_ID", "EVENT_DATE"]),
+    )
