@@ -0,0 +1,122 @@
+
+import os
+os.environ.setdefault("CIRCLECI", "1")
+import subprocess
+import sys
+import textwrap
+
+import pytest
+
+
+def _run_python(script, cwd=None):
+    env = os.environ.copy()
+    env.setdefault("CIRCLECI", "1")
+    repo_root = os.getcwd()
+    env["PYTHONPATH"] = repo_root + os.pathsep + env.get("PYTHONPATH", "")
+    return subprocess.check_output(
+        [sys.executable, "-c", textwrap.dedent(script)],
+        cwd=cwd,
+        env=env,
+        stderr=subprocess.STDOUT)
+
+
+def test_config_flag_defaults_to_enabled():
+    import garage.config as config
+    assert hasattr(config, "LOG_TENSORBOARD")
+    assert config.LOG_TENSORBOARD is True
+
+
+def test_disabled_tensorboard_import_and_logger_use(tmp_path):
+    script = r"""
+import importlib.abc
+import os
+from types import SimpleNamespace
+
+class BlockTensorFlow(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname == "tensorflow" or fullname.startswith("tensorflow."):
+            raise ImportError("tensorflow import blocked for test")
+        return None
+
+import sys
+sys.meta_path.insert(0, BlockTensorFlow())
+import garage.config as config
+config.LOG_TENSORBOARD = False
+from garage.misc import logger
+
+assert callable(getattr(logger, "reset", None))
+logger.reset()
+logger.add_text_output("plain.log")
+logger.log("hello-disabled", with_prefix=False, with_timestamp=False)
+logger.remove_text_output("plain.log")
+with open("plain.log") as fh:
+    assert "hello-disabled" in fh.read()
+
+logger.record_tabular("metric", 7)
+logger.dump_tabular(with_prefix=False, with_timestamp=False)
+
+logger.set_snapshot_dir("snapshots")
+assert logger.get_snapshot_dir() == "snapshots"
+logger.log_parameters_lite("params.json", SimpleNamespace(args_data=None, alpha=3))
+logger.log_variant("variant.json", {"beta": 4})
+assert os.path.exists("params.json")
+assert os.path.exists("variant.json")
+assert "tensorflow" not in sys.modules
+"""
+    _run_python(script, cwd=str(tmp_path))
+
+
+def test_reset_callable_when_tensorboard_enabled():
+    pytest.importorskip("tensorflow")
+    script = """
+import garage.config as config
+config.LOG_TENSORBOARD = True
+import garage.misc.logger as logger
+assert callable(getattr(logger, "reset", None))
+logger.reset()
+"""
+    _run_python(script)
+
+
+def test_reset_reinitializes_enabled_tensorboard_output(tmp_path):
+    pytest.importorskip("tensorflow")
+    script = r"""
+import glob
+import os
+import time
+
+import garage.config as config
+config.LOG_TENSORBOARD = True
+import garage.misc.logger as logger
+
+logger.reset()
+logger.set_tensorboard_dir("tb")
+logger.record_tabular("metric", 1)
+logger.dump_tabular(with_prefix=False, with_timestamp=False)
+time.sleep(0.1)
+
+event_files = glob.glob(os.path.join("tb", "events.*"))
+assert event_files
+sizes_before = {path: os.path.getsize(path) for path in event_files}
+
+logger.reset()
+logger.record_tabular("metric", 2)
+logger.dump_tabular(with_prefix=False, with_timestamp=False)
+time.sleep(0.1)
+
+sizes_after = {path: os.path.getsize(path) for path in event_files}
+assert sizes_after == sizes_before
+"""
+    _run_python(script, cwd=str(tmp_path))
+
+
+def test_import_from_misc_exposes_usable_logger():
+    script = """
+import garage.config as config
+config.LOG_TENSORBOARD = False
+from garage.misc import logger
+required = ["reset", "log", "record_tabular", "dump_tabular"]
+for name in required:
+    assert callable(getattr(logger, name, None)), name
+"""
+    _run_python(script)
