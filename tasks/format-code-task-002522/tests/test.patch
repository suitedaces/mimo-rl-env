+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set +u
+
+export PYENV_ROOT="$HOME/.pyenv"
+export PATH="$PYENV_ROOT/bin:$PATH"
+eval "$(pyenv init -)"
+
+
+export MUJOCO_PY_MUJOCO_PATH=/root/.mujoco/mjpro150
+export MUJOCO_PY_MJKEY_PATH=/root/.mujoco/mjkey.txt
+export LD_LIBRARY_PATH=/root/.mujoco/mjpro150/bin:$LD_LIBRARY_PATH
+export CIRCLECI=1
+set -u
+
+
+case "${1:-}" in
+  base)
+    python -m pytest tests/garage/spaces/test_box.py -v 2>&1
+    ;;
+  new)
+    python -m pytest tests/garage/test_logger_tensorboard_optional.py -v 2>&1
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
