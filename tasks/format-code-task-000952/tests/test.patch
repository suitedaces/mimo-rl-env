+  describe("retry policy handling (issue #5618)", () => {
+    const EVENT_ENDPOINT_BASE: backend.Endpoint = {
+      ...ENDPOINT,
+      platform: "gcfv2",
+      eventTrigger: {
+        eventType: "google.cloud.audit.log.v1.written",
+        eventFilters: {
+          resource: "projects/p/regions/r/instances/i",
+          serviceName: "compute.googleapis.com",
+        },
+        retry: false,
+      },
+    };
+
+    it("functionFromEndpoint with retry=true sets retryPolicy to RETRY_POLICY_RETRY", () => {
+      const ep: backend.Endpoint = {
+        ...EVENT_ENDPOINT_BASE,
+        eventTrigger: {
+          ...EVENT_ENDPOINT_BASE.eventTrigger!,
+          retry: true,
+        },
+      };
+      const result = cloudfunctionsv2.functionFromEndpoint(ep);
+      expect(result.eventTrigger).to.exist;
+      expect(result.eventTrigger!.retryPolicy).to.equal("RETRY_POLICY_RETRY");
+    });
+
+    it("functionFromEndpoint with retry=false does not enable retry policy", () => {
+      const ep: backend.Endpoint = {
+        ...EVENT_ENDPOINT_BASE,
+        eventTrigger: {
+          ...EVENT_ENDPOINT_BASE.eventTrigger!,
+          retry: false,
+        },
+      };
+      const result = cloudfunctionsv2.functionFromEndpoint(ep);
+      expect(result.eventTrigger).to.exist;
+
+
+
+      expect(result.eventTrigger!.retryPolicy).to.not.equal("RETRY_POLICY_RETRY");
+    });
+
+    it("functionFromEndpoint with retry=true on pubsub trigger sets retryPolicy to RETRY_POLICY_RETRY", () => {
+      const ep: backend.Endpoint = {
+        ...ENDPOINT,
+        platform: "gcfv2",
+        eventTrigger: {
+          eventType: events.v2.PUBSUB_PUBLISH_EVENT,
+          eventFilters: {
+            topic: "projects/p/topics/t",
+          },
+          retry: true,
+        },
+      };
+      const result = cloudfunctionsv2.functionFromEndpoint(ep);
+      expect(result.eventTrigger).to.exist;
+      expect(result.eventTrigger!.retryPolicy).to.equal("RETRY_POLICY_RETRY");
+    });
+
+    it("endpointFromFunction with retryPolicy=RETRY_POLICY_RETRY produces retry=true", () => {
+      const fn: cloudfunctionsv2.OutputCloudFunction = {
+        ...HAVE_CLOUD_FUNCTION_V2,
+        eventTrigger: {
+          eventType: events.v2.PUBSUB_PUBLISH_EVENT,
+          pubsubTopic: "projects/p/topics/t",
+          retryPolicy: "RETRY_POLICY_RETRY",
+        },
+      };
+      const result = cloudfunctionsv2.endpointFromFunction(fn) as backend.Endpoint &
+        backend.EventTriggered;
+      expect(result.eventTrigger).to.exist;
+      expect(result.eventTrigger.retry).to.equal(true);
+    });
+
+    it("endpointFromFunction with retryPolicy=RETRY_POLICY_DO_NOT_RETRY produces retry=false", () => {
+      const fn: cloudfunctionsv2.OutputCloudFunction = {
+        ...HAVE_CLOUD_FUNCTION_V2,
+        eventTrigger: {
+          eventType: events.v2.PUBSUB_PUBLISH_EVENT,
+          pubsubTopic: "projects/p/topics/t",
+          retryPolicy: "RETRY_POLICY_DO_NOT_RETRY",
+        },
+      };
+      const result = cloudfunctionsv2.endpointFromFunction(fn) as backend.Endpoint &
+        backend.EventTriggered;
+      expect(result.eventTrigger).to.exist;
+      expect(result.eventTrigger.retry).to.equal(false);
+    });
+
+    it("endpointFromFunction without retryPolicy defaults retry to false", () => {
+      const fn: cloudfunctionsv2.OutputCloudFunction = {
+        ...HAVE_CLOUD_FUNCTION_V2,
+        eventTrigger: {
+          eventType: events.v2.PUBSUB_PUBLISH_EVENT,
+          pubsubTopic: "projects/p/topics/t",
+        },
+      };
+      const result = cloudfunctionsv2.endpointFromFunction(fn) as backend.Endpoint &
+        backend.EventTriggered;
+      expect(result.eventTrigger).to.exist;
+      expect(result.eventTrigger.retry).to.equal(false);
+    });
+  });
+
