+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+PYTHON_BIN="${PYTHON:-python3}"
+if [ -x /workspace/repo/venv/bin/python ]; then
+  PYTHON_BIN="/workspace/repo/venv/bin/python"
+fi
+
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+"$PYTHON_BIN" - <<'PY'
+from compiler.api import compiler as api_compiler
+from compiler.errors import compiler as errors_compiler
+
+api_compiler.start()
+errors_compiler.start()
+PY
+
+exec "$PYTHON_BIN" -m pytest -p pytest_asyncio.plugin /workspace/repo/usercase-test-coderl/test_stream_media.py -v
