+++ b/usercase-test-coderl/test_stream_media.py
@@ -0,0 +1,320 @@
+import asyncio
+
+import pytest
+
+from pyrogram import Client, types
+
+
+
+
+
+
+
+
+FILE_ID = "BQADBAADFc1bBwAEsWjeOgAEHgADBAADHgQ"
+FILE_UNIQUE_ID = "AgADFc1bBwAE"
+CHUNKS = [b"chunk-0", b"chunk-1", b"chunk-2", b"chunk-3", b"chunk-4"]
+
+
+class MediaWithFileId:
+    def __init__(self, file_size=5 * 1024 * 1024):
+        self.file_id = FILE_ID
+        self.file_size = file_size
+
+
+class CaptureClient(Client):
+    transfer_active = 0
+    transfer_closed = 0
+
+    def __init__(self, name):
+        super().__init__(
+            name,
+            api_id=12345,
+            api_hash="0123456789abcdef0123456789abcdef",
+            in_memory=True,
+        )
+        self.get_file_calls = []
+        self.active_streams = 0
+        self.closed_streams = 0
+
+    @classmethod
+    def reset_transfer_counters(cls):
+        cls.transfer_active = 0
+        cls.transfer_closed = 0
+
+    async def get_file(self, file_id, file_size, limit, offset, *args):
+        type(self).transfer_active += 1
+        self.active_streams += 1
+        self.get_file_calls.append(
+            {
+                "file_type": file_id.file_type.name,
+                "dc_id": file_id.dc_id,
+                "media_id": file_id.media_id,
+                "access_hash": file_id.access_hash,
+                "file_size": file_size,
+                "limit": limit,
+                "offset": offset,
+            }
+        )
+
+        try:
+            source = CHUNKS[offset:]
+
+            if limit:
+                source = source[:limit]
+
+            for chunk in source:
+                await asyncio.sleep(0)
+                yield chunk
+        finally:
+            self.active_streams -= 1
+            self.closed_streams += 1
+            type(self).transfer_active -= 1
+            type(self).transfer_closed += 1
+
+
+def document(file_size=5 * 1024 * 1024):
+    return types.Document(
+        file_id=FILE_ID,
+        file_unique_id=FILE_UNIQUE_ID,
+        file_name="fixture.bin",
+        mime_type="application/octet-stream",
+        file_size=file_size,
+    )
+
+
+def message_with(media_name="document", file_size=5 * 1024 * 1024):
+    return types.Message(id=101, **{media_name: MediaWithFileId(file_size)})
+
+
+async def collect(generator):
+    return [chunk async for chunk in generator]
+
+
+async def close_and_settle(generator):
+    await generator.aclose()
+    await asyncio.sleep(0)
+    await asyncio.sleep(0)
+
+
+def assert_single_transfer(app, *, file_size, limit, offset):
+
+    assert len(app.get_file_calls) == 1
+    call = app.get_file_calls[0]
+    assert call["file_size"] == file_size
+    assert call["limit"] == limit
+    assert call["offset"] == offset
+
+
+@pytest.mark.asyncio
+async def test_message_streams_all_chunks_from_beginning():
+
+
+
+
+    app = CaptureClient("stream-all")
+    message = types.Message(id=1, document=document())
+
+    chunks = await collect(app.stream_media(message))
+
+    assert chunks == [b"chunk-0", b"chunk-1", b"chunk-2", b"chunk-3", b"chunk-4"]
+    assert [len(chunk) for chunk in chunks] == [7, 7, 7, 7, 7]
+    assert_single_transfer(app, file_size=5242880, limit=0, offset=0)
+    assert app.active_streams == 0
+    assert app.closed_streams == 1
+
+
+@pytest.mark.asyncio
+async def test_limit_three_yields_first_three_chunks_only():
+
+
+
+
+    app = CaptureClient("stream-limit")
+    message = types.Message(id=2, document=document())
+
+    chunks = await collect(app.stream_media(message, limit=3))
+
+    assert chunks == [b"chunk-0", b"chunk-1", b"chunk-2"]
+    assert_single_transfer(app, file_size=5242880, limit=3, offset=0)
+
+
+@pytest.mark.asyncio
+async def test_positive_offset_skips_first_three_chunks():
+
+
+
+
+    app = CaptureClient("stream-offset")
+    message = types.Message(id=3, document=document())
+
+    chunks = await collect(app.stream_media(message, offset=3))
+
+    assert chunks == [b"chunk-3", b"chunk-4"]
+    assert_single_transfer(app, file_size=5242880, limit=0, offset=3)
+
+
+@pytest.mark.asyncio
+async def test_negative_message_offset_counts_backward_from_end():
+
+
+
+
+    app = CaptureClient("stream-negative-offset")
+    message = types.Message(id=4, document=document())
+
+    chunks = await collect(app.stream_media(message, offset=-3))
+
+    assert chunks == [b"chunk-2", b"chunk-3", b"chunk-4"]
+    assert_single_transfer(app, file_size=5242880, limit=0, offset=2)
+
+
+@pytest.mark.asyncio
+async def test_media_object_with_file_id_streams_directly():
+
+
+
+
+    app = CaptureClient("stream-media-object")
+
+    chunks = await collect(app.stream_media(document(file_size=2 * 1024 * 1024), limit=2))
+
+    assert chunks == [b"chunk-0", b"chunk-1"]
+    assert_single_transfer(app, file_size=2097152, limit=2, offset=0)
+
+
+@pytest.mark.asyncio
+async def test_file_id_string_streams_without_file_size():
+
+
+
+
+    app = CaptureClient("stream-file-id")
+
+    chunks = await collect(app.stream_media(FILE_ID, limit=2, offset=1))
+
+    assert chunks == [b"chunk-1", b"chunk-2"]
+    assert_single_transfer(app, file_size=0, limit=2, offset=1)
+
+
+@pytest.mark.parametrize(
+    "media_name",
+    [
+        "audio",
+        "document",
+        "photo",
+        "sticker",
+        "animation",
+        "video",
+        "voice",
+        "video_note",
+        "new_chat_photo",
+    ],
+)
+@pytest.mark.asyncio
+async def test_each_downloadable_message_media_field_is_accepted(media_name):
+
+
+
+
+    app = CaptureClient(f"stream-{media_name}")
+
+    chunks = await collect(app.stream_media(message_with(media_name, file_size=1024 * 1024), limit=1))
+
+    assert chunks == [b"chunk-0"]
+    assert_single_transfer(app, file_size=1048576, limit=1, offset=0)
+
+
+@pytest.mark.asyncio
+async def test_message_without_downloadable_media_raises_value_error():
+
+
+
+
+    app = CaptureClient("stream-no-media")
+    message = types.Message(id=5, text="plain text only")
+
+    with pytest.raises(ValueError, match="This message doesn't contain any downloadable media"):
+        await collect(app.stream_media(message))
+
+    assert app.get_file_calls == []
+
+
+@pytest.mark.asyncio
+async def test_negative_offset_for_file_id_string_raises_value_error():
+
+
+
+
+    app = CaptureClient("stream-negative-file-id")
+
+    with pytest.raises(ValueError, match="Negative offsets are not supported for file ids, pass a Message object instead"):
+        await collect(app.stream_media(FILE_ID, offset=-1))
+
+    assert app.get_file_calls == []
+
+
+@pytest.mark.asyncio
+async def test_two_clients_keep_independent_stream_state():
+
+
+
+
+    app_a = CaptureClient("stream-independent-a")
+    app_b = CaptureClient("stream-independent-b")
+    message = types.Message(id=6, document=document())
+
+    chunks_a = await collect(app_a.stream_media(message, limit=1))
+    chunks_b = await collect(app_b.stream_media(message, offset=4))
+
+    assert chunks_a == [b"chunk-0"]
+    assert chunks_b == [b"chunk-4"]
+    assert_single_transfer(app_a, file_size=5242880, limit=1, offset=0)
+    assert_single_transfer(app_b, file_size=5242880, limit=0, offset=4)
+
+
+@pytest.mark.asyncio
+async def test_stream_generator_aclose_is_idempotent_and_releases_transfer():
+
+
+
+
+    app = CaptureClient("stream-aclose")
+    message = types.Message(id=7, document=document(file_size=2 * 1024 * 1024))
+    generator = app.stream_media(message)
+
+    first = await generator.__anext__()
+    assert first == b"chunk-0"
+    assert app.active_streams == 1
+    assert app.closed_streams == 0
+
+    await close_and_settle(generator)
+    assert app.active_streams == 0
+    assert app.closed_streams == 1
+
+    await close_and_settle(generator)
+    assert app.active_streams == 0
+    assert app.closed_streams == 1
+
+
+@pytest.mark.asyncio
+async def test_repeated_construct_use_cleanup_cycles_leave_no_active_transfers():
+
+
+
+
+    CaptureClient.reset_transfer_counters()
+
+    for index in range(125):
+        app = CaptureClient(f"stream-leak-floor-{index}")
+        message = types.Message(id=1000 + index, document=document(file_size=2 * 1024 * 1024))
+        generator = app.stream_media(message)
+
+        first = await generator.__anext__()
+        assert first == b"chunk-0"
+        await close_and_settle(generator)
+        assert app.active_streams == 0
+        assert app.closed_streams == 1
+
+    assert CaptureClient.transfer_active == 0
+    assert CaptureClient.transfer_closed == 125
