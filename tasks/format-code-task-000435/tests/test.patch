+    test('persistState() does not throw after sitemap is fully loaded', async () => {
+        const list = await SitemapRequestList.open({
+            sitemapUrls: [`${url}/sitemap.xml`],
+            persistStateKey: 'persist-after-full-load',
+        });
+
+
+        const start = Date.now();
+        while (!list.isSitemapFullyLoaded()) {
+            if (Date.now() - start > 10_000) throw new Error('sitemap loading timed out');
+            await sleep(20);
+        }
+
+
+        await expect(list.persistState()).resolves.toBeUndefined();
+    });
+
+    test('list remains usable after persistState() following full sitemap load', async () => {
+        const list = await SitemapRequestList.open({
+            sitemapUrls: [`${url}/sitemap.xml`],
+            persistStateKey: 'usable-after-persist',
+        });
+
+        const start = Date.now();
+        while (!list.isSitemapFullyLoaded()) {
+            if (Date.now() - start > 10_000) throw new Error('sitemap loading timed out');
+            await sleep(20);
+        }
+
+        const first = await list.fetchNextRequest();
+        expect(first).not.toBeNull();
+        await list.markRequestHandled(first);
+
+
+        await list.persistState();
+
+        const remaining: string[] = [];
+        for await (const request of list) {
+            remaining.push(request.url);
+            await list.markRequestHandled(request);
+        }
+
+        expect(remaining).toHaveLength(4);
+        expect(list.handledCount()).toBe(5);
+        expect(new Set([first.url, ...remaining])).toEqual(
+            new Set([
+                'http://not-exists.com/',
+                'http://not-exists.com/catalog?item=12&desc=vacation_hawaii',
+                'http://not-exists.com/catalog?item=73&desc=vacation_new_zealand',
+                'http://not-exists.com/catalog?item=74&desc=vacation_newfoundland',
+                'http://not-exists.com/catalog?item=83&desc=vacation_usa',
+            ]),
+        );
+    });
+
+    test('resurrection works after persistState() following full sitemap load', async () => {
+        const options = {
+            sitemapUrls: [`${url}/sitemap.xml`],
+            persistStateKey: 'resurrection-after-full-load',
+        };
+
+        {
+            const list = await SitemapRequestList.open(options);
+            const start = Date.now();
+            while (!list.isSitemapFullyLoaded()) {
+                if (Date.now() - start > 10_000) throw new Error('sitemap loading timed out');
+                await sleep(20);
+            }
+
+            const first = await list.fetchNextRequest();
+            await list.markRequestHandled(first);
+
+            await list.persistState();
+        }
+
+        const newList = await SitemapRequestList.open(options);
+        const restoredUrls: string[] = [];
+        for await (const request of newList) {
+            restoredUrls.push(request.url);
+            await newList.markRequestHandled(request);
+        }
+
+        expect(restoredUrls).toHaveLength(4);
+        expect(newList.handledCount()).toBe(4);
+        expect(new Set(restoredUrls).size).toBe(4);
+    });
+
