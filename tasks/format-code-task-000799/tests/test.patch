+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+mkdir -p /workspace/gopath/src/github.com/dgrijalva
+ln -sfn /workspace/repo /workspace/gopath/src/github.com/dgrijalva/jwt-go
+cd /workspace/gopath/src/github.com/dgrijalva/jwt-go
+
+export GO111MODULE=off
+export GOPATH=/workspace/gopath
+export GOPROXY=off
+export GOSUMDB=off
+export GOFLAGS="${GOFLAGS:-} -buildvcs=false"
+exec go test -v ./usercase-test-coderl/...
