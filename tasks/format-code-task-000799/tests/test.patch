+package usercase_test_coderl
+
+import (
+	"errors"
+	"io/ioutil"
+	"os"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	jwt "github.com/dgrijalva/jwt-go"
+)
+
+
+
+
+
+
+
+const (
+	hs256Key = "AllYourBase"
+
+	validMapToken     = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhZG1pbiI6dHJ1ZSwiY291bnQiOjMsInN1YiI6ImFsaWNlIn0.RMtIWrJqyq6LbcGEA1XxqkHCG6rXnDNUP3zzz-vO7yw"
+	customClaimsToken = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzY29wZSI6InJlYWQ6YWxsIiwidGllciI6NywiZXhwIjoxNzAwMDAzNjAwLCJpYXQiOjE2OTk5OTk5NTAsImlzcyI6Imlzc3Vlci1hIiwibmJmIjoxNjk5OTk5OTAwfQ.a9pqorCVjRwBJc59tAJwdJtvHWPVL2sm60-O96dvCwo"
+	expiredToken      = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjE2OTk5OTk5OTksInN1YiI6ImV4cGlyZWQifQ.kgx0hwV_I1GWR3AaByYNTL-HguWezVMmfmkEOACqacM"
+	notBeforeToken    = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJuYmYiOjE3MDAwMDAwMDEsInN1YiI6ImZ1dHVyZSJ9._nFtnRL0mCgEGt1Aze3BQ5vyMFJZZNzuDMhW7Q-vLv8"
+	issuedAtToken     = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3MDAwMDAwMDEsInN1YiI6Imlzc3VlZC1mdXR1cmUifQ.5dbeIPbbelwcBi8sI7q0HqOlU935d_oBIcE3JqMaAuw"
+	skipClaimsToken   = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjE2OTk5OTk5OTksImlhdCI6MTcwMDAwMDAwMSwibmJmIjoxNzAwMDAwMDAxLCJzdWIiOiJza2lwIn0.47-qOy8bbjdJlzT5CMZ9tBKQmMKy0uARsUiFI4VSbe8"
+	noiseToken        = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY3RpdmUiOmZhbHNlLCJyb2xlIjoib3BzIiwic3ViIjoibm9pc2UifQ.NQMx3EcU78klNI_hHyqefRegqf8n_4P6oR-JEckInDw"
+	badSignatureToken = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhZG1pbiI6dHJ1ZSwiY291bnQiOjMsInN1YiI6ImFsaWNlIn0.RMtIWrJqyq6LbcGEA1XxqkHCG6rXnDNUP3zzz-vO7yA"
+)
+
+type myClaims struct {
+	Scope string `json:"scope"`
+	Tier  int    `json:"tier"`
+	jwt.StandardClaims
+}
+
+func TestParseValidHS256MapClaims(t *testing.T) {
+
+
+	token, err := jwt.Parse(validMapToken, keyfuncFromString(hs256Key))
+	if err != nil {
+		t.Fatalf("Parse returned error: %T %v", err, err)
+	}
+
+	assertTokenCore(t, token, validMapToken, "RMtIWrJqyq6LbcGEA1XxqkHCG6rXnDNUP3zzz-vO7yw")
+	assertHeader(t, token.Header)
+	if !reflect.DeepEqual(token.Claims, jwt.MapClaims{"admin": true, "count": float64(3), "sub": "alice"}) {
+		t.Fatalf("claims = %#v", token.Claims)
+	}
+}
+
+func TestParseWithCustomClaimsReturnsSuppliedClaimsType(t *testing.T) {
+
+
+	withFixedTime(t)
+	claims := &myClaims{}
+
+	token, err := jwt.ParseWithClaims(customClaimsToken, claims, keyfuncFromString(hs256Key))
+	if err != nil {
+		t.Fatalf("ParseWithClaims returned error: %T %v", err, err)
+	}
+
+	assertTokenCore(t, token, customClaimsToken, "a9pqorCVjRwBJc59tAJwdJtvHWPVL2sm60-O96dvCwo")
+	if token.Claims != claims {
+		t.Fatalf("token.Claims is not the supplied claims pointer: %#v", token.Claims)
+	}
+	expected := &myClaims{
+		Scope: "read:all",
+		Tier:  7,
+		StandardClaims: jwt.StandardClaims{
+			ExpiresAt: 1700003600,
+			IssuedAt:  1699999950,
+			Issuer:    "issuer-a",
+			NotBefore: 1699999900,
+		},
+	}
+	if !reflect.DeepEqual(claims, expected) {
+		t.Fatalf("claims = %#v", claims)
+	}
+}
+
+func TestParserParseValidMethodAllowsHS256(t *testing.T) {
+
+
+	parser := &jwt.Parser{ValidMethods: []string{"HS384", "HS256"}}
+
+	token, err := parser.Parse(validMapToken, keyfuncFromString(hs256Key))
+	if err != nil {
+		t.Fatalf("Parser.Parse returned error: %T %v", err, err)
+	}
+
+	assertTokenCore(t, token, validMapToken, "RMtIWrJqyq6LbcGEA1XxqkHCG6rXnDNUP3zzz-vO7yw")
+	if !reflect.DeepEqual(token.Claims, jwt.MapClaims{"admin": true, "count": float64(3), "sub": "alice"}) {
+		t.Fatalf("claims = %#v", token.Claims)
+	}
+}
+
+func TestParserParseWithClaimsValidMethodAllowsCustomClaims(t *testing.T) {
+
+
+	withFixedTime(t)
+	claims := &myClaims{}
+	parser := &jwt.Parser{ValidMethods: []string{"HS256"}}
+
+	token, err := parser.ParseWithClaims(customClaimsToken, claims, keyfuncFromString(hs256Key))
+	if err != nil {
+		t.Fatalf("Parser.ParseWithClaims returned error: %T %v", err, err)
+	}
+
+	assertTokenCore(t, token, customClaimsToken, "a9pqorCVjRwBJc59tAJwdJtvHWPVL2sm60-O96dvCwo")
+	if !reflect.DeepEqual(claims, &myClaims{
+		Scope: "read:all",
+		Tier:  7,
+		StandardClaims: jwt.StandardClaims{
+			ExpiresAt: 1700003600,
+			IssuedAt:  1699999950,
+			Issuer:    "issuer-a",
+			NotBefore: 1699999900,
+		},
+	}) {
+		t.Fatalf("claims = %#v", claims)
+	}
+}
+
+func TestMissingKeyfuncReturnsUnverifiableValidationError(t *testing.T) {
+
+
+	token, err := jwt.Parse(validMapToken, nil)
+
+	assertValidationError(t, err, jwt.ValidationErrorUnverifiable, "no Keyfunc was provided.")
+	if token == nil || token.Valid {
+		t.Fatalf("token = %#v", token)
+	}
+}
+
+func TestKeyfuncErrorIsWrappedAsUnverifiable(t *testing.T) {
+
+
+	keyErr := errors.New("lookup failed for kid fixture")
+
+	token, err := jwt.Parse(validMapToken, func(*jwt.Token) (interface{}, error) {
+		return nil, keyErr
+	})
+
+	ve := assertValidationError(t, err, jwt.ValidationErrorUnverifiable, "lookup failed for kid fixture")
+	if ve.Inner != keyErr {
+		t.Fatalf("inner error = %#v", ve.Inner)
+	}
+	if token == nil || token.Valid {
+		t.Fatalf("token = %#v", token)
+	}
+}
+
+func TestExpiredClaimReturnsExpiredValidationBit(t *testing.T) {
+
+
+	withFixedTime(t)
+
+	token, err := jwt.Parse(expiredToken, keyfuncFromString(hs256Key))
+
+	assertValidationError(t, err, jwt.ValidationErrorExpired, "Token is expired")
+	if token == nil || token.Valid {
+		t.Fatalf("token = %#v", token)
+	}
+}
+
+func TestNotBeforeClaimReturnsNotValidYetBit(t *testing.T) {
+
+
+	withFixedTime(t)
+
+	token, err := jwt.Parse(notBeforeToken, keyfuncFromString(hs256Key))
+
+	assertValidationError(t, err, jwt.ValidationErrorNotValidYet, "Token is not valid yet")
+	if token == nil || token.Valid {
+		t.Fatalf("token = %#v", token)
+	}
+}
+
+func TestIssuedAtClaimReturnsIssuedAtBit(t *testing.T) {
+
+
+	withFixedTime(t)
+
+	token, err := jwt.Parse(issuedAtToken, keyfuncFromString(hs256Key))
+
+	assertValidationError(t, err, jwt.ValidationErrorIssuedAt, "Token used before issued")
+	if token == nil || token.Valid {
+		t.Fatalf("token = %#v", token)
+	}
+}
+
+func TestBadSignatureReturnsSignatureInvalidBit(t *testing.T) {
+
+
+	token, err := jwt.Parse(badSignatureToken, keyfuncFromString(hs256Key))
+
+	assertValidationError(t, err, jwt.ValidationErrorSignatureInvalid, "signature is invalid")
+	if token == nil || token.Valid {
+		t.Fatalf("token = %#v", token)
+	}
+}
+
+func TestParserValidMethodsRejectsDisallowedAlgorithm(t *testing.T) {
+
+
+	parser := &jwt.Parser{ValidMethods: []string{"HS384"}}
+
+	token, err := parser.Parse(validMapToken, keyfuncFromString(hs256Key))
+
+	assertValidationError(t, err, jwt.ValidationErrorSignatureInvalid, "signing method HS256 is invalid")
+	if token == nil || token.Valid {
+		t.Fatalf("token = %#v", token)
+	}
+}
+
+func TestSkipClaimsValidationStillVerifiesSignatureAndIgnoresTimeClaims(t *testing.T) {
+
+
+	withFixedTime(t)
+	parser := &jwt.Parser{SkipClaimsValidation: true}
+
+	token, err := parser.Parse(skipClaimsToken, keyfuncFromString(hs256Key))
+	if err != nil {
+		t.Fatalf("Parser.Parse returned error: %T %v", err, err)
+	}
+
+	assertTokenCore(t, token, skipClaimsToken, "47-qOy8bbjdJlzT5CMZ9tBKQmMKy0uARsUiFI4VSbe8")
+	if !reflect.DeepEqual(token.Claims, jwt.MapClaims{
+		"exp": float64(1699999999),
+		"iat": float64(1700000001),
+		"nbf": float64(1700000001),
+		"sub": "skip",
+	}) {
+		t.Fatalf("claims = %#v", token.Claims)
+	}
+}
+
+func TestSkipClaimsValidationStillRejectsBadSignature(t *testing.T) {
+
+
+	parser := &jwt.Parser{SkipClaimsValidation: true}
+
+	token, err := parser.Parse(badSignatureToken, keyfuncFromString(hs256Key))
+
+	assertValidationError(t, err, jwt.ValidationErrorSignatureInvalid, "signature is invalid")
+	if token == nil || token.Valid {
+		t.Fatalf("token = %#v", token)
+	}
+}
+
+func TestParseIsReferentiallyTransparentForSameToken(t *testing.T) {
+	first, firstErr := jwt.Parse(validMapToken, keyfuncFromString(hs256Key))
+	second, secondErr := jwt.Parse(validMapToken, keyfuncFromString(hs256Key))
+
+	if firstErr != nil || secondErr != nil {
+		t.Fatalf("errors = %T %v, %T %v", firstErr, firstErr, secondErr, secondErr)
+	}
+	assertComparableToken(t, first, second)
+}
+
+func TestParseDoesNotMutateCallerOwnedKeyBytes(t *testing.T) {
+	key := []byte(hs256Key)
+
+	token, err := jwt.Parse(validMapToken, func(*jwt.Token) (interface{}, error) {
+		return key, nil
+	})
+	if err != nil {
+		t.Fatalf("Parse returned error: %T %v", err, err)
+	}
+	if !token.Valid {
+		t.Fatalf("token valid = %v", token.Valid)
+	}
+
+}
+
+func TestParseResultSurvivesInProcessNoise(t *testing.T) {
+	baseline, err := jwt.Parse(validMapToken, keyfuncFromString(hs256Key))
+	if err != nil {
+		t.Fatalf("baseline parse returned error: %T %v", err, err)
+	}
+
+	noise, err := jwt.Parse(noiseToken, keyfuncFromString(hs256Key))
+	if err != nil {
+		t.Fatalf("noise parse returned error: %T %v", err, err)
+	}
+	if !reflect.DeepEqual(noise.Claims, jwt.MapClaims{"active": false, "role": "ops", "sub": "noise"}) {
+		t.Fatalf("noise claims = %#v", noise.Claims)
+	}
+	_, _ = (&jwt.Parser{SkipClaimsValidation: true}).Parse(skipClaimsToken, keyfuncFromString(hs256Key))
+
+	again, err := jwt.Parse(validMapToken, keyfuncFromString(hs256Key))
+	if err != nil {
+		t.Fatalf("second parse returned error: %T %v", err, err)
+	}
+	assertComparableToken(t, baseline, again)
+}
+
+func TestParseDoesNotWriteRelativeFilesInWorkingDirectory(t *testing.T) {
+	wd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmp, err := ioutil.TempDir("", "jwt-parse-side-effects-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(tmp)
+	defer os.Chdir(wd)
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatal(err)
+	}
+
+	token, err := jwt.Parse(validMapToken, keyfuncFromString(hs256Key))
+
+	if err != nil {
+		t.Fatalf("Parse returned error: %T %v", err, err)
+	}
+	if !token.Valid {
+		t.Fatalf("token valid = %v", token.Valid)
+	}
+
+}
+
+func keyfuncFromString(key string) jwt.Keyfunc {
+	return func(*jwt.Token) (interface{}, error) {
+		return []byte(key), nil
+	}
+}
+
+func withFixedTime(t *testing.T) {
+	t.Helper()
+	old := jwt.TimeFunc
+	jwt.TimeFunc = func() time.Time { return time.Unix(1700000000, 0) }
+	t.Cleanup(func() { jwt.TimeFunc = old })
+}
+
+func assertTokenCore(t *testing.T, token *jwt.Token, raw string, signature string) {
+	t.Helper()
+	if token == nil {
+		t.Fatal("token is nil")
+	}
+
+	_ = raw
+
+	if token.Signature != signature {
+		t.Fatalf("signature = %q", token.Signature)
+	}
+	if token.Valid != true {
+		t.Fatalf("valid = %v", token.Valid)
+	}
+	assertHeader(t, token.Header)
+}
+
+func assertHeader(t *testing.T, header map[string]interface{}) {
+	t.Helper()
+	if !reflect.DeepEqual(header, map[string]interface{}{"alg": "HS256", "typ": "JWT"}) {
+		t.Fatalf("header = %#v", header)
+	}
+}
+
+func assertValidationError(t *testing.T, err error, expectedBits uint32, expectedText string) *jwt.ValidationError {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("error is nil")
+	}
+	ve, ok := err.(*jwt.ValidationError)
+	if !ok {
+		t.Fatalf("error type = %T, want *jwt.ValidationError", err)
+	}
+
+	if ve.Errors&expectedBits != expectedBits {
+		t.Fatalf("validation bits = %d, want bit(s) %d set", ve.Errors, expectedBits)
+	}
+	_ = expectedText
+	return ve
+}
+
+func assertComparableToken(t *testing.T, want *jwt.Token, got *jwt.Token) {
+	t.Helper()
+	if want == nil || got == nil {
+		t.Fatalf("tokens = %#v %#v", want, got)
+	}
+
+	if got.Signature != want.Signature {
+		t.Fatalf("signature = %q, want %q", got.Signature, want.Signature)
+	}
+	if got.Valid != want.Valid {
+		t.Fatalf("valid = %v, want %v", got.Valid, want.Valid)
+	}
+
+	if !reflect.DeepEqual(got.Header, want.Header) {
+		t.Fatalf("header = %#v, want %#v", got.Header, want.Header)
+	}
+	if !reflect.DeepEqual(got.Claims, want.Claims) {
+		t.Fatalf("claims = %#v, want %#v", got.Claims, want.Claims)
+	}
+}
+
+func TestPublicAPISurfaceHasDocumentedFunctionTypes(t *testing.T) {
+	var keyfunc jwt.Keyfunc = func(*jwt.Token) (interface{}, error) {
+		return []byte(hs256Key), nil
+	}
+	var parser = &jwt.Parser{}
+
+	checks := []string{
+		reflect.TypeOf(keyfunc).String(),
+		reflect.TypeOf(jwt.Parse).String(),
+		reflect.TypeOf(jwt.ParseWithClaims).String(),
+		reflect.TypeOf(parser.Parse).String(),
+		reflect.TypeOf(parser.ParseWithClaims).String(),
+	}
+	expected := []string{
+		"jwt.Keyfunc",
+		"func(string, jwt.Keyfunc) (*jwt.Token, error)",
+		"func(string, jwt.Claims, jwt.Keyfunc) (*jwt.Token, error)",
+		"func(string, jwt.Keyfunc) (*jwt.Token, error)",
+		"func(string, jwt.Claims, jwt.Keyfunc) (*jwt.Token, error)",
+	}
+	if !reflect.DeepEqual(checks, expected) {
+		t.Fatalf("public API types = %q, want %q", strings.Join(checks, "; "), strings.Join(expected, "; "))
+	}
+}
