+from __future__ import annotations
+
+import pandas
+import pytest
+
+import bigframes.core.pyformat as pyformat
+
+
+def test_pyformat_dry_run_embeds_dataframe_as_empty_table_expression():
+    df = pandas.DataFrame(
+        {
+            "int_col": [1, 2, 3],
+            "str_col": ["a", "b", "c"],
+            "float_col": [1.5, 2.5, 3.5],
+            "bool_col": [True, False, True],
+        }
+    )
+
+    got = pyformat.pyformat(
+        "SELECT * FROM {df}",
+        pyformat_args={"df": df},
+        dry_run=True,
+    )
+
+    assert got == (
+        "SELECT * FROM UNNEST(ARRAY<STRUCT<"
+        "`int_col` INTEGER, "
+        "`str_col` STRING, "
+        "`float_col` FLOAT, "
+        "`bool_col` BOOLEAN"
+        ">>[])"
+    )
+
+
+def test_pyformat_dry_run_preserves_column_order():
+    df = pandas.DataFrame(
+        {
+            "z": [1],
+            "a": ["x"],
+            "m": [2.0],
+        }
+    )
+
+    got = pyformat.pyformat(
+        "{df}",
+        pyformat_args={"df": df},
+        dry_run=True,
+    )
+
+    assert got == "UNNEST(ARRAY<STRUCT<`z` INTEGER, `a` STRING, `m` FLOAT>>[])"
+
+
+def test_pyformat_dry_run_handles_array_columns():
+    df = pandas.DataFrame(
+        {
+            "id": [1, 2],
+            "values": [[1, 2], [3]],
+        }
+    )
+
+    got = pyformat.pyformat(
+        "SELECT * FROM {df}",
+        pyformat_args={"df": df},
+        dry_run=True,
+    )
+
+    assert got == (
+        "SELECT * FROM UNNEST(ARRAY<STRUCT<"
+        "`id` INTEGER, "
+        "`values` ARRAY<INTEGER>"
+        ">>[])"
+    )
+
+
+def test_pyformat_dry_run_widens_narrow_numeric_types():
+    df = pandas.DataFrame(
+        {
+            "small_int": pandas.array([1, 2, 3], dtype="int32"),
+            "small_float": pandas.array([1.0, 2.0, 3.0], dtype="float32"),
+        }
+    )
+
+    got = pyformat.pyformat(
+        "SELECT * FROM {df}",
+        pyformat_args={"df": df},
+        dry_run=True,
+    )
+
+    assert got == (
+        "SELECT * FROM UNNEST(ARRAY<STRUCT<"
+        "`small_int` INTEGER, "
+        "`small_float` FLOAT"
+        ">>[])"
+    )
+
+
+def test_pyformat_dry_run_ignores_dataframe_index():
+    df = pandas.DataFrame(
+        {"col": [1, 2, 3]},
+        index=pandas.Index(["r1", "r2", "r3"], name="my_index"),
+    )
+
+    got = pyformat.pyformat(
+        "SELECT * FROM {df}",
+        pyformat_args={"df": df},
+        dry_run=True,
+    )
+
+
+    assert got == "SELECT * FROM UNNEST(ARRAY<STRUCT<`col` INTEGER>>[])"
+
+
+def test_pyformat_without_session_and_not_dry_run_raises_valueerror():
+    df = pandas.DataFrame({"a": [1, 2, 3]})
+
+    with pytest.raises(ValueError):
+        pyformat.pyformat(
+            "SELECT * FROM {df}",
+            pyformat_args={"df": df},
+        )
+
+
+def test_pyformat_unreferenced_dataframe_is_ignored():
+    df = pandas.DataFrame({"a": [1, 2, 3]})
+
+
+
+    got = pyformat.pyformat(
+        "SELECT 1",
+        pyformat_args={"df": df},
+    )
+    assert got == "SELECT 1"
