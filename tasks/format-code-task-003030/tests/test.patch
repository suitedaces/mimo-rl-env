diff --git a/test/yargs-parser.js b/test/yargs-parser.js
index ee76e41..4836a66 100644
--- a/test/yargs-parser.js
+++ b/test/yargs-parser.js
@@ -1788,6 +1788,68 @@ describe('yargs-parser', function () {
 
       result.foo.should.eql('a')
     })
+
+
+    describe('nargs interaction with duplicate-arguments-array=false', function () {
+      it('should collect narg values into an array when duplicate-arguments-array is false (issue reproduction)', function () {
+        var result = parser('foo -p x y', {
+          narg: { p: 2 },
+          configuration: { 'duplicate-arguments-array': false }
+        })
+        result.should.have.property('p').and.deep.equal(['x', 'y'])
+        result.should.have.property('_').and.deep.equal(['foo'])
+      })
+
+      it('should collect narg values into an array when duplicate-arguments-array is left at its default (issue reference behavior)', function () {
+        var result = parser('foo -p x y', {
+          narg: { p: 2 }
+        })
+        result.should.have.property('p').and.deep.equal(['x', 'y'])
+        result.should.have.property('_').and.deep.equal(['foo'])
+      })
+
+      it('should keep only the last group of narg values when the option is specified multiple times and duplicate-arguments-array is false', function () {
+        var result = parser('-p a b -p c d', {
+          narg: { p: 2 },
+          configuration: { 'duplicate-arguments-array': false }
+        })
+        result.should.have.property('p').and.deep.equal(['c', 'd'])
+      })
+
+      it('should keep only the last group of narg values when using = form and duplicate-arguments-array is false', function () {
+        var result = parser('-f=a b -f=c d', {
+          narg: { f: 2 },
+          configuration: { 'duplicate-arguments-array': false }
+        })
+        result.should.have.property('f').and.deep.equal(['c', 'd'])
+      })
+
+      it('should still preserve a narg=1 last-value-wins behavior when duplicate-arguments-array is false', function () {
+        var result = parser('-p a -p b', {
+          narg: { p: 1 },
+          configuration: { 'duplicate-arguments-array': false }
+        })
+        result.should.have.property('p').and.equal('b')
+      })
+
+      it('should collect narg values into an array via an alias when duplicate-arguments-array is false', function () {
+        var result = parser('--bar x y', {
+          narg: { foo: 2 },
+          alias: { foo: 'bar' },
+          configuration: { 'duplicate-arguments-array': false }
+        })
+        result.should.have.property('foo').and.deep.equal(['x', 'y'])
+        result.should.have.property('bar').and.deep.equal(['x', 'y'])
+      })
+
+      it('should collect all narg values when nargs is greater than 2 and duplicate-arguments-array is false', function () {
+        var result = parser('-p a b c', {
+          narg: { p: 3 },
+          configuration: { 'duplicate-arguments-array': false }
+        })
+        result.should.have.property('p').and.deep.equal(['a', 'b', 'c'])
+      })
+    })
