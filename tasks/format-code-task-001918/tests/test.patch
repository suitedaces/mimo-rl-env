@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+python -m pytest -v -rA tests/requests/test_batch_request_item.py::test_init_replaces_me_token_in_url tests/requests/test_batch_request_item.py::test_init_replaces_me_token_with_subpath_and_query tests/requests/test_batch_request_item.py::test_init_me_token_not_in_url_unchanged tests/requests/test_batch_request_item.py::test_init_beta_endpoint_me_token_replaced tests/requests/test_batch_request_item.py::test_set_url_replaces_me_token tests/requests/test_batch_request_item.py::test_set_url_replaces_me_token_with_query
+rc=$(( rc | $? ))
+exit $rc
