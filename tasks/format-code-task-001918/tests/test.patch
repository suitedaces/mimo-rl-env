diff --git a/tests/requests/test_batch_request_item.py b/tests/requests/test_batch_request_item.py
index f70c40f..31d3eb6 100644
--- a/tests/requests/test_batch_request_item.py
+++ b/tests/requests/test_batch_request_item.py
@@ -75,3 +75,109 @@ def test_method_property(batch_request_item):
 def test_depends_on_property(batch_request_item):
     batch_request_item.set_depends_on(["request1", "request2"])
     assert batch_request_item.depends_on == ["request1", "request2"]
+
+
+def _make_request_info(url, content=b'{}'):
+    ri = RequestInformation()
+    ri.http_method = "GET"
+    ri.url = url
+    ri.headers = RequestHeaders()
+    ri.content = content
+    return ri
+
+
+def _serialized_url(item):
+    """Serialize the item with a mock writer and capture the URL field.
+
+    This is the actual user-observable wire payload URL — what gets sent
+    to MS Graph batch endpoint per the issue's reproducer.
+    """
+    writer = Mock()
+    captured = {}
+
+    def capture_str(name, value):
+        captured[name] = value
+
+    writer.write_str_value.side_effect = capture_str
+    item.serialize(writer)
+    return captured.get('url')
+
+
+def test_init_replaces_me_token_in_url():
+    ri = _make_request_info(
+        "https://graph.microsoft.com/v1.0/users/me-token-to-replace"
+    )
+    item = BatchRequestItem(request_information=ri)
+    url = _serialized_url(item)
+    assert "me-token-to-replace" not in url, (
+        f"wire URL still contains placeholder token: {url}"
+    )
+    assert url.endswith("/me"), f"expected URL to end with /me, got: {url}"
+
+
+def test_init_replaces_me_token_with_subpath_and_query():
+    ri = _make_request_info(
+        "https://graph.microsoft.com/v1.0/users/me-token-to-replace/calendarView"
+        "?startDateTime=2024-09-25T14:12:59&endDateTime=2024-09-26T14:12:59"
+    )
+    item = BatchRequestItem(request_information=ri)
+    url = _serialized_url(item)
+    assert "me-token-to-replace" not in url, (
+        f"wire URL still contains placeholder token: {url}"
+    )
+    assert "/me/calendarView" in url, (
+        f"expected /me/calendarView in URL, got: {url}"
+    )
+    assert "startDateTime=2024-09-25T14:12:59" in url
+    assert "endDateTime=2024-09-26T14:12:59" in url
+
+
+def test_init_me_token_not_in_url_unchanged():
+    ri = _make_request_info("https://graph.microsoft.com/v1.0/users/abc-123")
+    item = BatchRequestItem(request_information=ri)
+    url = _serialized_url(item)
+    assert "me-token-to-replace" not in url
+    assert url.endswith("/users/abc-123"), (
+        f"non-token URL should be preserved, got: {url}"
+    )
+
+
+def test_init_beta_endpoint_me_token_replaced():
+    ri = _make_request_info(
+        "https://graph.microsoft.com/beta/users/me-token-to-replace/messages"
+    )
+    item = BatchRequestItem(request_information=ri)
+    url = _serialized_url(item)
+    assert "me-token-to-replace" not in url, (
+        f"wire URL still contains placeholder token: {url}"
+    )
+    assert "/me/messages" in url, f"expected /me/messages in URL, got: {url}"
+    assert "/beta" in url, f"expected /beta version preserved, got: {url}"
+
+
+def test_set_url_replaces_me_token():
+    ri = _make_request_info("https://graph.microsoft.com/v1.0/me")
+    item = BatchRequestItem(request_information=ri)
+    item.set_url("https://graph.microsoft.com/v1.0/users/me-token-to-replace")
+    url = _serialized_url(item)
+    assert "me-token-to-replace" not in url, (
+        f"wire URL still contains placeholder token: {url}"
+    )
+    assert url.endswith("/me"), f"expected URL to end with /me, got: {url}"
+
+
+def test_set_url_replaces_me_token_with_query():
+    ri = _make_request_info("https://graph.microsoft.com/v1.0/me")
+    item = BatchRequestItem(request_information=ri)
+    item.set_url(
+        "https://graph.microsoft.com/v1.0/users/me-token-to-replace/calendarView"
+        "?startDateTime=2024-09-25T14:12:59"
+    )
+    url = _serialized_url(item)
+    assert "me-token-to-replace" not in url, (
+        f"wire URL still contains placeholder token: {url}"
+    )
+    assert "/me/calendarView" in url, (
+        f"expected /me/calendarView in URL, got: {url}"
+    )
+    assert "startDateTime=2024-09-25T14:12:59" in url
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
