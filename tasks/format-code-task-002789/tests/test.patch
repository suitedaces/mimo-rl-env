@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+
+go mod edit \
+  -require=github.com/go-git/go-git/v5@v5.14.0 \
+  -require=github.com/Microsoft/go-winio@v0.6.2 \
+  -require=github.com/ProtonMail/go-crypto@v1.1.5 \
+  -require=github.com/cloudflare/circl@v1.6.0 \
+  -require=github.com/cyphar/filepath-securejoin@v0.4.1 \
+  -require=github.com/go-git/go-billy/v5@v5.6.2 \
+  -require=github.com/golang/groupcache@v0.0.0-20241129210726-2c02b8208cf8 \
+  -require=github.com/google/go-cmp@v0.7.0 \
+  -require=github.com/pjbgf/sha1cd@v0.3.2 \
+  -require=github.com/skeema/knownhosts@v1.3.1 \
+  -require=golang.org/x/crypto@v0.35.0 \
+  -require=golang.org/x/net@v0.36.0 \
+  -require=golang.org/x/sync@v0.11.0 \
+  -require=golang.org/x/sys@v0.30.0 \
+  -require=golang.org/x/term@v0.29.0 \
+  -require=golang.org/x/text@v0.22.0
+
+
+export GOFLAGS=-mod=mod
+export GOPROXY=off
+export GOSUMDB=off
+
+
+go test ./internal/controller/ -count=1 -run TestControllers -args \
+  --ginkgo.skip="StateStore readiness controllers"
+
+
+go test ./internal/controller/ -count=1 -run TestControllers -args \
+  --ginkgo.focus="StateStore readiness controllers"
