+	"github.com/syntasso/kratix/internal/controller"
+	"github.com/syntasso/kratix/lib/writers"
+	"github.com/syntasso/kratix/lib/writers/writersfakes"
+)
+
+var _ = Describe("StateStore readiness controllers", func() {
+	var (
+		ctx           context.Context
+		fakeWriter    *writersfakes.FakeStateStoreWriter
+		eventRecorder *record.FakeRecorder
+		secret        *corev1.Secret
+		storeName     types.NamespacedName
+	)
+
+	const secretName = "store-secret"
+
+	BeforeEach(func() {
+		ctx = context.Background()
+		storeName = types.NamespacedName{Name: "default-store"}
+
+		eventRecorder = record.NewFakeRecorder(1024)
+
+		fakeWriter = &writersfakes.FakeStateStoreWriter{}
+		fakeWriter.UpdateFilesReturns("", nil)
+		controller.SetNewS3Writer(
+			func(logr.Logger, v1alpha1.BucketStateStoreSpec, v1alpha1.Destination, map[string][]byte) (writers.StateStoreWriter, error) {
+				return fakeWriter, nil
+			},
+		)
+		controller.SetNewGitWriter(
+			func(logr.Logger, v1alpha1.GitStateStoreSpec, v1alpha1.Destination, map[string][]byte) (writers.StateStoreWriter, error) {
+				return fakeWriter, nil
+			},
+		)
+
+		secret = &corev1.Secret{
+			TypeMeta:   metav1.TypeMeta{Kind: "Secret", APIVersion: "v1"},
+			ObjectMeta: metav1.ObjectMeta{Name: secretName, Namespace: "default"},
+			Data: map[string][]byte{
+				"accessKeyID":     []byte("my-access-key"),
+				"secretAccessKey": []byte("my-secret-access-key"),
+				"username":        []byte("user"),
+				"password":        []byte("pass"),
+			},
+		}
+	})
+
+	readyCondition := func(reason, message string, status metav1.ConditionStatus) OmegaMatcher {
+		return ContainElement(SatisfyAll(
+			HaveField("Type", "Ready"),
+			HaveField("Reason", reason),
+			HaveField("Message", message),
+			HaveField("Status", status),
+		))
+	}
+
+
+
+
+	Describe("BucketStateStore", func() {
+		var (
+			store      *v1alpha1.BucketStateStore
+			reconciler *controller.BucketStateStoreReconciler
+		)
+
+		BeforeEach(func() {
+			reconciler = &controller.BucketStateStoreReconciler{
+				Client:        fakeK8sClient,
+				Scheme:        scheme.Scheme,
+				Log:           ctrl.Log.WithName("controllers").WithName("BucketStateStore"),
+				EventRecorder: eventRecorder,
+			}
+
+			store = &v1alpha1.BucketStateStore{
+				TypeMeta:   metav1.TypeMeta{Kind: "BucketStateStore", APIVersion: "platform.kratix.io/v1alpha1"},
+				ObjectMeta: metav1.ObjectMeta{Name: storeName.Name},
+				Spec: v1alpha1.BucketStateStoreSpec{
+					BucketName: "default-store",
+					Endpoint:   "localhost:3000",
+					StateStoreCoreFields: v1alpha1.StateStoreCoreFields{
+						SecretRef: &corev1.SecretReference{Name: secretName, Namespace: "default"},
+					},
+				},
+			}
+		})
+
+		fetch := func() *v1alpha1.BucketStateStore {
+			out := &v1alpha1.BucketStateStore{}
+			Expect(fakeK8sClient.Get(ctx, storeName, out)).To(Succeed())
+			return out
+		}
+
+		When("the store does not exist", func() {
+			It("is a no-op", func() {
+				result, err := t.reconcileUntilCompletion(reconciler, store)
+				Expect(err).NotTo(HaveOccurred())
+				Expect(result).To(Equal(ctrl.Result{}))
+			})
+		})
+
+		When("the store exists", func() {
+			BeforeEach(func() {
+				Expect(fakeK8sClient.Create(ctx, store)).To(Succeed())
+				Expect(fakeK8sClient.Create(ctx, secret)).To(Succeed())
+			})
+
+			It("writes a probe file to the root and reports ready", func() {
+				result, err := t.reconcileUntilCompletion(reconciler, store)
+				Expect(err).NotTo(HaveOccurred())
+				Expect(result).To(Equal(ctrl.Result{}))
+
+				Expect(fakeWriter.UpdateFilesCallCount()).To(BeNumerically(">=", 1))
+				subDir, _, workloads, toDelete := fakeWriter.UpdateFilesArgsForCall(0)
+				Expect(subDir).To(Equal(""))
+				Expect(workloads).To(HaveLen(1))
+				Expect(workloads[0].Filepath).To(Equal("kratix-write-probe.txt"))
+				Expect(workloads[0].Content).NotTo(BeEmpty())
+				Expect(toDelete).To(BeEmpty())
+
+				updated := fetch()
+				Expect(updated.Status.Status).To(Equal("Ready"))
+				Expect(updated.Status.Conditions).To(readyCondition("StateStoreReady", "State store is ready", metav1.ConditionTrue))
+
+				Eventually(eventRecorder.Events).Should(Receive(ContainSubstring(
+					`Normal Ready BucketStateStore "default-store" is ready`)))
+			})
+
+			When("the referenced secret does not exist", func() {
+				BeforeEach(func() {
+					Expect(fakeK8sClient.Delete(ctx, secret)).To(Succeed())
+				})
+
+				It("reports not ready with a SecretNotFound condition and surfaces the error", func() {
+					_, err := t.reconcileUntilCompletion(reconciler, store)
+					Expect(err).To(MatchError(ContainSubstring(`secrets "store-secret" not found`)))
+
+					updated := fetch()
+					Expect(updated.Status.Status).To(Equal("NotReady"))
+					Expect(updated.Status.Conditions).To(readyCondition(
+						"SecretNotFound",
+						`Secret not found: secrets "store-secret" not found`,
+						metav1.ConditionFalse))
+
+					Eventually(eventRecorder.Events).Should(Receive(ContainSubstring(
+						`Warning NotReady BucketStateStore "default-store" is not ready: Secret not found: secrets "store-secret" not found`)))
+				})
+			})
+
+			When("the writer cannot be initialised", func() {
+				BeforeEach(func() {
+					controller.SetNewS3Writer(
+						func(logr.Logger, v1alpha1.BucketStateStoreSpec, v1alpha1.Destination, map[string][]byte) (writers.StateStoreWriter, error) {
+							return nil, errors.New("secret missing key: secretAccessKey")
+						},
+					)
+				})
+
+				It("reports not ready with an ErrorInitialisingWriter condition", func() {
+					_, err := t.reconcileUntilCompletion(reconciler, store)
+					Expect(err).To(MatchError(ContainSubstring("secret missing key: secretAccessKey")))
+
+					updated := fetch()
+					Expect(updated.Status.Status).To(Equal("NotReady"))
+					Expect(updated.Status.Conditions).To(readyCondition(
+						"ErrorInitialisingWriter",
+						"Error initialising writer: secret missing key: secretAccessKey",
+						metav1.ConditionFalse))
+
+					Eventually(eventRecorder.Events).Should(Receive(ContainSubstring(
+						`Warning NotReady BucketStateStore "default-store" is not ready: Error initialising writer: secret missing key: secretAccessKey`)))
+				})
+			})
+
+			When("the probe file cannot be written", func() {
+				BeforeEach(func() {
+					fakeWriter.UpdateFilesReturns("", errors.New("boom"))
+				})
+
+				It("reports not ready with an ErrorWritingTestFile condition", func() {
+					_, err := t.reconcileUntilCompletion(reconciler, store)
+					Expect(err).To(MatchError(ContainSubstring("boom")))
+
+					updated := fetch()
+					Expect(updated.Status.Status).To(Equal("NotReady"))
+					Expect(updated.Status.Conditions).To(readyCondition(
+						"ErrorWritingTestFile",
+						"Error writing test file: boom",
+						metav1.ConditionFalse))
+
+					Eventually(eventRecorder.Events).Should(Receive(ContainSubstring(
+						`Warning NotReady BucketStateStore "default-store" is not ready: Error writing test file: boom`)))
+				})
+			})
+		})
+	})
+
+	Describe("GitStateStore", func() {
+		var (
+			store      *v1alpha1.GitStateStore
+			reconciler *controller.GitStateStoreReconciler
+		)
+
+		BeforeEach(func() {
+			reconciler = &controller.GitStateStoreReconciler{
+				Client:        fakeK8sClient,
+				Scheme:        scheme.Scheme,
+				Log:           ctrl.Log.WithName("controllers").WithName("GitStateStore"),
+				EventRecorder: eventRecorder,
+			}
+
+			store = &v1alpha1.GitStateStore{
+				TypeMeta:   metav1.TypeMeta{Kind: "GitStateStore", APIVersion: "platform.kratix.io/v1alpha1"},
+				ObjectMeta: metav1.ObjectMeta{Name: storeName.Name},
+				Spec: v1alpha1.GitStateStoreSpec{
+					URL: "https://example.com/repo.git",
+					StateStoreCoreFields: v1alpha1.StateStoreCoreFields{
+						SecretRef: &corev1.SecretReference{Name: secretName, Namespace: "default"},
+					},
+				},
+			}
+		})
+
+		fetch := func() *v1alpha1.GitStateStore {
+			out := &v1alpha1.GitStateStore{}
+			Expect(fakeK8sClient.Get(ctx, storeName, out)).To(Succeed())
+			return out
+		}
+
+		When("the store does not exist", func() {
+			It("is a no-op", func() {
+				result, err := t.reconcileUntilCompletion(reconciler, store)
+				Expect(err).NotTo(HaveOccurred())
+				Expect(result).To(Equal(ctrl.Result{}))
+			})
+		})
+
+		When("the store exists", func() {
+			BeforeEach(func() {
+				Expect(fakeK8sClient.Create(ctx, store)).To(Succeed())
+				Expect(fakeK8sClient.Create(ctx, secret)).To(Succeed())
+			})
+
+			It("writes a probe file to the root and reports ready", func() {
+				result, err := t.reconcileUntilCompletion(reconciler, store)
+				Expect(err).NotTo(HaveOccurred())
+				Expect(result).To(Equal(ctrl.Result{}))
+
+				Expect(fakeWriter.UpdateFilesCallCount()).To(BeNumerically(">=", 1))
+				subDir, _, workloads, toDelete := fakeWriter.UpdateFilesArgsForCall(0)
+				Expect(subDir).To(Equal(""))
+				Expect(workloads).To(HaveLen(1))
+				Expect(workloads[0].Filepath).To(Equal("kratix-write-probe.txt"))
+				Expect(workloads[0].Content).NotTo(BeEmpty())
+				Expect(toDelete).To(BeEmpty())
+
+				updated := fetch()
+				Expect(updated.Status.Status).To(Equal("Ready"))
+				Expect(updated.Status.Conditions).To(readyCondition("StateStoreReady", "State store is ready", metav1.ConditionTrue))
+
+				Eventually(eventRecorder.Events).Should(Receive(ContainSubstring(
+					`Normal Ready GitStateStore "default-store" is ready`)))
+			})
+
+			When("the referenced secret does not exist", func() {
+				BeforeEach(func() {
+					Expect(fakeK8sClient.Delete(ctx, secret)).To(Succeed())
+				})
+
+				It("reports not ready with a SecretNotFound condition and surfaces the error", func() {
+					_, err := t.reconcileUntilCompletion(reconciler, store)
+					Expect(err).To(MatchError(ContainSubstring(`secrets "store-secret" not found`)))
+
+					updated := fetch()
+					Expect(updated.Status.Status).To(Equal("NotReady"))
+					Expect(updated.Status.Conditions).To(readyCondition(
+						"SecretNotFound",
+						`Secret not found: secrets "store-secret" not found`,
+						metav1.ConditionFalse))
+
+					Eventually(eventRecorder.Events).Should(Receive(ContainSubstring(
+						`Warning NotReady GitStateStore "default-store" is not ready: Secret not found: secrets "store-secret" not found`)))
+				})
+			})
+
+			When("the probe file cannot be written", func() {
+				BeforeEach(func() {
+					fakeWriter.UpdateFilesReturns("", errors.New("boom"))
+				})
+
+				It("reports not ready with an ErrorWritingTestFile condition", func() {
+					_, err := t.reconcileUntilCompletion(reconciler, store)
+					Expect(err).To(MatchError(ContainSubstring("boom")))
+
+					updated := fetch()
+					Expect(updated.Status.Status).To(Equal("NotReady"))
+					Expect(updated.Status.Conditions).To(readyCondition(
+						"ErrorWritingTestFile",
+						"Error writing test file: boom",
+						metav1.ConditionFalse))
+
+					Eventually(eventRecorder.Events).Should(Receive(ContainSubstring(
+						`Warning NotReady GitStateStore "default-store" is not ready: Error writing test file: boom`)))
+				})
+			})
+		})
+	})
+})
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
