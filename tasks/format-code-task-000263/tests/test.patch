diff --git a/tests/unit/test_expression_literals_ternary.py b/tests/unit/test_expression_literals_ternary.py
new file mode 100644
index 000000000..006f1f93d
--- /dev/null
+++ b/tests/unit/test_expression_literals_ternary.py
@@ -0,0 +1,160 @@
+
+
+
+
+
+
+
+import pytest
+
+from tracecat.templates.expressions import TemplateExpression
+from tracecat.types.exceptions import TracecatExpressionError
+
+
+def _result(expr, operand=None):
+    return TemplateExpression(expr, operand=operand).result()
+
+
+
+
+
+
+
+def test_integer_literal():
+    out = _result("${{ 42 }}")
+    assert out == 42
+    assert type(out) is int
+
+
+def test_negative_integer_literal():
+    out = _result("${{ -5 }}")
+    assert out == -5
+    assert type(out) is int
+
+
+def test_float_literal():
+    out = _result("${{ 3.14 }}")
+    assert out == 3.14
+    assert type(out) is float
+
+
+def test_double_quoted_string_literal():
+    out = _result('${{ "hello world" }}')
+    assert out == "hello world"
+    assert type(out) is str
+
+
+def test_single_quoted_string_literal():
+    out = _result("${{ 'hi' }}")
+    assert out == "hi"
+    assert type(out) is str
+
+
+def test_true_literal():
+    out = _result("${{ True }}")
+    assert out is True
+
+
+def test_false_literal():
+    out = _result("${{ False }}")
+    assert out is False
+
+
+def test_literal_typecast_still_applies():
+    out = _result("${{ 42 -> str }}")
+    assert out == "42"
+    assert type(out) is str
+
+
+
+
+
+
+
+def test_integer_literal_function_args():
+    out = _result("${{ FNS.add(1, 2) }}")
+    assert out == 3
+
+
+def test_float_literal_function_args():
+    out = _result("${{ FNS.add(1, 2.5) }}")
+    assert out == 3.5
+
+
+def test_comparison_literal_function_args():
+    assert _result("${{ FNS.greater_than(5, 2) }}") is True
+    assert _result("${{ FNS.greater_than(2, 5) }}") is False
+
+
+
+
+
+
+
+def test_ternary_literal_condition_true():
+    assert _result("${{ 'a' if 1 else 'b' }}") == "a"
+
+
+def test_ternary_literal_condition_false():
+    assert _result("${{ 'a' if 0 else 'b' }}") == "b"
+
+
+def test_ternary_boolean_condition():
+    assert _result("${{ 'yes' if True else 'no' }}") == "yes"
+    assert _result("${{ 'yes' if False else 'no' }}") == "no"
+
+
+def test_ternary_context_condition():
+    operand = {"INPUTS": {"flag": True, "x": 20}}
+    assert _result("${{ 'yes' if INPUTS.flag else 'no' }}", operand) == "yes"
+    operand = {"INPUTS": {"flag": False, "x": 20}}
+    assert _result("${{ 'yes' if INPUTS.flag else 'no' }}", operand) == "no"
+
+
+def test_ternary_function_condition():
+    operand = {"INPUTS": {"x": 20}}
+    assert _result(
+        "${{ 'big' if FNS.greater_than(INPUTS.x, 10) else 'small' }}", operand
+    ) == "big"
+    operand = {"INPUTS": {"x": 5}}
+    assert _result(
+        "${{ 'big' if FNS.greater_than(INPUTS.x, 10) else 'small' }}", operand
+    ) == "small"
+
+
+def test_ternary_context_branches():
+    operand = {"INPUTS": {"flag": True, "a": 100, "b": 200}}
+    assert _result("${{ INPUTS.a if INPUTS.flag else INPUTS.b }}", operand) == 100
+    operand = {"INPUTS": {"flag": False, "a": 100, "b": 200}}
+    assert _result("${{ INPUTS.a if INPUTS.flag else INPUTS.b }}", operand) == 200
+
+
+
+
+
+
+
+def test_ternary_short_circuits_untaken_else_branch():
+
+
+    operand = {"INPUTS": {"flag": True, "x": 42}, "ACTIONS": {}}
+    assert (
+        _result("${{ INPUTS.x if INPUTS.flag else ACTIONS.missing.result }}", operand)
+        == 42
+    )
+
+
+def test_ternary_short_circuits_untaken_true_branch():
+    operand = {"INPUTS": {"flag": False, "x": 42}, "ACTIONS": {}}
+    assert (
+        _result("${{ ACTIONS.missing.result if INPUTS.flag else INPUTS.x }}", operand)
+        == 42
+    )
+
+
+def test_missing_path_still_raises_when_selected():
+
+
+    operand = {"INPUTS": {"flag": True}, "ACTIONS": {}}
+    with pytest.raises(TracecatExpressionError):
+        _result("${{ ACTIONS.missing.result if INPUTS.flag else 0 }}", operand)
