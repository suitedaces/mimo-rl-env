+func TestGetScpCmdPortValuePropagated(t *testing.T) {
+	hostInfoLoader := MockHostInfoLoader{MockHostInfo{
+		ip:          "10.0.0.1",
+		sshUsername: "ubuntu",
+		sshKeyPath:  "/fake/keypath/id_rsa",
+		sshPort:     9999,
+	}}
+
+	cmd, err := getScpCmd("/tmp/foo", "remote:/home/foo", false, &hostInfoLoader)
+
+	assert.NoError(t, err)
+	assert.True(t, argsContainsFlagValue(cmd.Args, "-P", "9999"),
+		"expected -P 9999 in scp args, got: %v", cmd.Args)
+
+	assert.False(t, argsContainsFlagValue(cmd.Args, "-P", "22"))
+	assert.False(t, argsContainsFlagValue(cmd.Args, "-P", "2222"))
+}
+
+
+
+func TestGetScpCmdWithZeroPort(t *testing.T) {
+	hostInfoLoader := MockHostInfoLoader{MockHostInfo{
+		ip:          "1.2.3.4",
+		sshUsername: "root",
+		sshKeyPath:  "/fake/keypath/id_rsa",
+		sshPort:     0,
+	}}
+
+	cmd, err := getScpCmd("/tmp/foo", "remote:/home/foo", false, &hostInfoLoader)
+
+	assert.NoError(t, err)
+	assert.NotContains(t, cmd.Args, "-P",
+		"unexpected -P flag for zero port: %v", cmd.Args)
+}
+
+
+
+func TestGetScpCmd_LocalSourceLocalDest(t *testing.T) {
+	hostInfoLoader := MockHostInfoLoader{MockHostInfo{}}
+	cmd, err := getScpCmd("/tmp/a", "/tmp/b", false, &hostInfoLoader)
+	assert.NoError(t, err)
+	assert.NotNil(t, cmd)
+	assert.NotContains(t, cmd.Args, "-P")
+
+	joined := strings.Join(cmd.Args, " ")
+	assert.Contains(t, joined, "/tmp/a")
+	assert.Contains(t, joined, "/tmp/b")
+}
+
+
+var _ = errors.New
+var _ = exec.Command
