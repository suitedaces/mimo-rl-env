+func TestGetScpCmdWithCustomPort(t *testing.T) {
+	hostInfoLoader := MockHostInfoLoader{MockHostInfo{
+		ip:          "104.131.33.10",
+		sshUsername: "root",
+		sshKeyPath:  "/fake/keypath/id_rsa",
+		sshPort:     2222,
+	}}
+
+	cmd, err := getScpCmd("myfile.txt", "myfunhost:myfile.txt", false, &hostInfoLoader)
 
-	assert.Equal(t, expectedCmd, cmd)
 	assert.NoError(t, err)
+	assert.NotNil(t, cmd)
+
+	assert.True(t, argsContainsFlagValue(cmd.Args, "-P", "2222"),
+		"expected -P 2222 in scp args, got: %v", cmd.Args)
+
+	joined := strings.Join(cmd.Args, " ")
+	assert.Contains(t, joined, "root@104.131.33.10")
 }
