diff --git a/socorro/unittest/app/test_crontabber_launcher.py b/socorro/unittest/app/test_crontabber_launcher.py
new file mode 100644
index 000000000..a46dbdcd4
--- /dev/null
+++ b/socorro/unittest/app/test_crontabber_launcher.py
@@ -0,0 +1,21 @@
+import os
+import subprocess
+
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..', '..'))
+
+
+def test_socorro_launcher_supports_crontabber_help():
+    process = subprocess.Popen(
+        ['./scripts/socorro', 'crontabber', '--help'],
+        cwd=ROOT,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    stdout, stderr = process.communicate()
+    output = (stdout + stderr).decode('utf-8', 'replace')
+    lowered = output.lower()
+
+    assert process.returncode == 0, output
+    assert 'unknown' not in lowered and 'unsupported' not in lowered
+    assert 'crontabber' in lowered
diff --git a/socorro/unittest/cron/test_crontabber_jobs_values.py b/socorro/unittest/cron/test_crontabber_jobs_values.py
new file mode 100644
index 000000000..72d7f786a
--- /dev/null
+++ b/socorro/unittest/cron/test_crontabber_jobs_values.py
@@ -0,0 +1,74 @@
+import configman
+from crontabber.base import BaseCronApp
+
+from socorro.cron.crontabber_app import CronTabberApp
+from socorro.cron.crontabber_app import DEFAULT_JOBS
+from socorro.cron.crontabber_app import STAGE_JOBS
+from socorro.cron.jobs.bugzilla import BugzillaCronApp
+from socorro.cron.jobs.fetch_adi_from_hive import FAKEFetchADIFromHiveCronApp
+
+
+class TestOwnedInlineCronApp(BaseCronApp):
+    def run(self):
+        pass
+
+
+class TestOwnedAlternateCronApp(BaseCronApp):
+    def run(self):
+        pass
+
+
+INLINE_TEST_JOBS = '%s.TestOwnedInlineCronApp|1h' % __name__
+ALTERNATE_TEST_JOBS = '%s.TestOwnedAlternateCronApp|1h' % __name__
+
+
+def configured_jobs_for(jobs_value):
+    config_manager = configman.ConfigurationManager(
+        [CronTabberApp.get_required_config()],
+        values_source_list=[{'crontabber.jobs': jobs_value}],
+        app_name='test-crontabber-jobs-values',
+    )
+    with config_manager.context() as config:
+        return config.crontabber.jobs
+
+
+def configured_job_classes(jobs_value):
+    return set(
+        job_class
+        for job_name, job_class in configured_jobs_for(jobs_value).class_list
+    )
+
+
+def test_crontabber_jobs_accepts_inline_spec():
+    job_classes = configured_job_classes(INLINE_TEST_JOBS)
+
+    assert TestOwnedInlineCronApp in job_classes
+
+
+def test_crontabber_jobs_accepts_default_jobs_value_path():
+    job_classes = configured_job_classes('socorro.cron.crontabber_app.DEFAULT_JOBS')
+
+    assert BugzillaCronApp in job_classes
+
+
+def test_crontabber_jobs_accepts_a_second_python_jobs_value_path():
+    job_classes = configured_job_classes(
+        'socorro.unittest.cron.test_crontabber_jobs_values.ALTERNATE_TEST_JOBS'
+    )
+
+    assert TestOwnedAlternateCronApp in job_classes
+    assert BugzillaCronApp not in job_classes
+
+
+def test_stage_jobs_value_contains_default_jobs_and_fake_hive_job():
+    default_classes = configured_job_classes(DEFAULT_JOBS)
+    stage_classes = configured_job_classes(STAGE_JOBS)
+
+    assert default_classes.issubset(stage_classes)
+    assert FAKEFetchADIFromHiveCronApp in stage_classes
+
+
+def test_crontabber_jobs_accepts_stage_jobs_value_path():
+    job_classes = configured_job_classes('socorro.cron.crontabber_app.STAGE_JOBS')
+
+    assert FAKEFetchADIFromHiveCronApp in job_classes
diff --git a/socorro/unittest/docker/test_crontabber_helpers.py b/socorro/unittest/docker/test_crontabber_helpers.py
new file mode 100644
index 000000000..9fc09fee3
--- /dev/null
+++ b/socorro/unittest/docker/test_crontabber_helpers.py
@@ -0,0 +1,27 @@
+import os
+
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..', '..'))
+
+
+def executable_text(path):
+    with open(os.path.join(ROOT, path)) as script:
+        lines = [
+            line.strip()
+            for line in script
+            if line.strip() and not line.lstrip().startswith('#')
+        ]
+    return ' '.join(lines)
+
+
+def test_docker_crontabber_helpers_use_socorro_entrypoint():
+    run_crontabber = executable_text('docker/run_crontabber.sh')
+    run_update_data = executable_text('docker/run_update_data.sh')
+
+    assert './scripts/socorro crontabber' in run_crontabber
+    assert './scripts/socorro crontabber' in run_update_data
+
+    combined = run_crontabber + ' ' + run_update_data
+    assert 'python socorro/cron/crontabber_app.py' not in combined
+    assert '--job=ftpscraper' in run_update_data
+    assert '--job=featured-versions-automatic' in run_update_data
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,30 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+find /testbed -name '*.pyc' -delete
+
+
+set +u
+export PATH="$HOME/.pyenv/bin:$PATH"
+eval "$(pyenv init -)"
+eval "$(pyenv virtualenv-init -)"
+pyenv activate socorro-env
+export PYTHONPATH=/testbed
+set -u
+
+case "${1:-}" in
+    base)
+        python -m pytest -q socorro/unittest/app/test_for_application_defaults.py
+        ;;
+    new)
+        python -m pytest -q \
+            socorro/unittest/app/test_crontabber_launcher.py \
+            socorro/unittest/docker/test_crontabber_helpers.py \
+            socorro/unittest/cron/test_crontabber_jobs_values.py
+        ;;
+    *)
+        echo "usage: $0 base|new"
+        exit 2
+        ;;
+esac
