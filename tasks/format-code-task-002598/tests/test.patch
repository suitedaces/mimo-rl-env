diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,140 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+( cd /workspace/repo && go build -o /tmp/collidertracker-usecase ./ ) \
+    || { echo "FAIL: build" >&2; exit 1; }
+BIN=/tmp/collidertracker-usecase
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || exit 1
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+assert_file_has() {
+    local file=$1
+    local expected=$2
+    grep -Fq -- "$expected" "$file" || fail "$file missing: $expected"
+}
+
+assert_file_lacks() {
+    local file=$1
+    local unexpected=$2
+    if grep -Fq -- "$unexpected" "$file"; then
+        fail "$file unexpectedly contains: $unexpected"
+    fi
+}
+
+assert_file_matches() {
+    local file=$1
+    local expected_regex=$2
+    grep -Eq -- "$expected_regex" "$file" || fail "$file missing regex: $expected_regex"
+}
+
+make_sc_extension_markers() {
+    local home_dir=$1
+    local ext_dir="$home_dir/.local/share/SuperCollider/Extensions"
+    mkdir -p "$ext_dir"
+    : > "$ext_dir/Fverb.sc"
+    : > "$ext_dir/AnalogTape.sc"
+    : > "$ext_dir/MiBraids.sc"
+    : > "$ext_dir/Open303.sc"
+    : > "$ext_dir/Juno60.sc"
+    : > "$ext_dir/MoogLadder.schelp"
+}
+
+make_probe_path() {
+    local probe_dir=$1
+    mkdir -p "$probe_dir"
+    cat > "$probe_dir/pgrep" <<'PROBE'
+#!/usr/bin/env bash
+if [ "${1:-}" = "-x" ] && [ "${2:-}" = "sclang" ]; then
+    echo "sclang process detection was invoked" >> "${PROBE_LOG:?}"
+    exit 7
+fi
+exec /usr/bin/pgrep "$@"
+PROBE
+    cat > "$probe_dir/sclang" <<'PROBE'
+#!/usr/bin/env bash
+echo "sclang executable was started" >> "${PROBE_LOG:?}"
+exit 23
+PROBE
+    chmod +x "$probe_dir/pgrep" "$probe_dir/sclang"
+}
+
+run_tracker_in_pty() {
+    local flag=$1
+    local run_dir=$2
+    mkdir -p "$run_dir/home" "$run_dir/project" "$run_dir/probe-bin"
+    make_sc_extension_markers "$run_dir/home"
+    make_probe_path "$run_dir/probe-bin"
+
+
+
+    (
+        sleep 0.2
+        printf '\033]11;rgb:0000/0000/0000\033\\'
+        printf '\033[24;80R'
+        sleep 1
+        printf 'q'
+        sleep 0.3
+        printf '\021'
+    ) | env \
+        HOME="$run_dir/home" \
+        PATH="$run_dir/probe-bin:$PATH" \
+        PROBE_LOG="$run_dir/probe.log" \
+        TERM=xterm-256color \
+        timeout 8s script -q -e -c "$BIN $flag --project '$run_dir/project' --log '$run_dir/debug.log'" "$run_dir/typescript" \
+        >"$run_dir/out" 2>"$run_dir/err"
+    return $?
+}
+
+
+
+
+"$BIN" --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+
+assert_file_matches out '(^|[[:space:]])-s,[[:space:]]+--skip-sc[[:space:]]+Skip SuperCollider detection and management entirely'
+
+assert_file_matches out '(^|[[:space:]])-p,[[:space:]]+--project([[:space:]]|$)'
+assert_file_matches out '(^|[[:space:]])--port([[:space:]]|$)'
+assert_file_matches out '(^|[[:space:]])-r,[[:space:]]+--record([[:space:]]|$)'
+assert_file_matches out '(^|[[:space:]])-l,[[:space:]]+--log([[:space:]]|$)'
+
+
+
+
+RUN_LONG="$TMP/run-long"
+run_tracker_in_pty "--skip-sc" "$RUN_LONG"; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0; err=$(cat "$RUN_LONG/err")"
+
+[ ! -s "$RUN_LONG/probe.log" ] || fail "F2 SuperCollider lifecycle probe was touched: $(cat "$RUN_LONG/probe.log")"
+
+assert_file_matches "$RUN_LONG/out" 'T1[[:space:]]+T2[[:space:]]+T3[[:space:]]+T4[[:space:]]+T5[[:space:]]+T6[[:space:]]+T7[[:space:]]+T8[[:space:]]+Song'
+
+
+
+
+RUN_SHORT="$TMP/run-short"
+run_tracker_in_pty "-s" "$RUN_SHORT"; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0; err=$(cat "$RUN_SHORT/err")"
+
+[ ! -s "$RUN_SHORT/probe.log" ] || fail "F3 SuperCollider lifecycle probe was touched: $(cat "$RUN_SHORT/probe.log")"
+
+assert_file_matches "$RUN_SHORT/out" 'T1[[:space:]]+T2[[:space:]]+T3[[:space:]]+T4[[:space:]]+T5[[:space:]]+T6[[:space:]]+T7[[:space:]]+T8[[:space:]]+Song'
+
+
+
+
+
+README=/workspace/repo/README.md
+assert_file_has "$README" "-s, --skip-sc"
+assert_file_has "$README" "SuperCollider"
+assert_file_matches "$README" '[Mm]anual'
+assert_file_has "$README" "Skip SuperCollider detection and management entirely"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+export GOPATH="${GOPATH:-/root/go}"
+export GOMODCACHE="${GOMODCACHE:-/root/go/pkg/mod}"
+export GOCACHE="${GOCACHE:-/workspace/repo/.gocache}"
+export GOPROXY=off
+export GOSUMDB=off
+export GOTOOLCHAIN=local
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
