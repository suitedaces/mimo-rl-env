diff --git a/usercase-test-coderl/comm_declarative_message_filter.test.js b/usercase-test-coderl/comm_declarative_message_filter.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/comm_declarative_message_filter.test.js
@@ -0,0 +1,250 @@
+import { describe, it, before, beforeEach, afterEach } from 'mocha';
+import { expect } from 'chai';
+
+
+
+
+
+
+
+
+
+
+
+const directRule = { conditions: [{ field: 'player.name', value: '43Bad' }] };
+const regexRule = { conditions: [{ field: 'markup[0][1].plain', pattern: /UK\)$/i }] };
+const matchingDirectMessage = { player: { name: '43Bad', team: 2 } };
+const nonMatchingDirectMessage = { player: { name: 'Spedd', team: 2 } };
+const matchingRegexMessage = {
+  player: { name: 'Q77n', team: 1 },
+  markup: [['PORTAL', { plain: 'Bridge (UK)' }]],
+};
+const nonMatchingRegexMessage = {
+  player: { name: 'Q77n', team: 1 },
+  markup: [['PORTAL', { plain: 'Bridge (US)' }]],
+};
+
+function filter() {
+  return IITC.comm.declarativeMessageFilter;
+}
+
+function resetRules() {
+  for (const id of Object.keys(filter().getAllRules())) {
+    filter().removeRule(id);
+  }
+}
+
+describe('usercase COMM declarative message filter acceptance', () => {
+  let originalWarn;
+  let originalError;
+
+  before(async () => {
+    globalThis.window.TEAM_TO_CSS = { 1: 'res', 2: 'enl' };
+    globalThis.window.PLAYER = { nickname: 'local' };
+    globalThis.window.scrollBottom = () => 0;
+    globalThis.chat = { keepScrollPosition: () => {} };
+
+    await import('../core/code/comm.js');
+    await import('../core/code/comm_declarative_message_filter.js');
+  });
+
+  beforeEach(() => {
+    originalWarn = console.warn;
+    originalError = console.error;
+    resetRules();
+  });
+
+  afterEach(() => {
+    console.warn = originalWarn;
+    console.error = originalError;
+    resetRules();
+  });
+
+  it('retains added direct and regex rules across singleton calls and removes by ID', () => {
+
+
+    expect(filter().getRuleById('directComparison')).to.equal(null);
+    expect(filter().getAllRules()).to.deep.equal({});
+
+    filter().addRule('directComparison', directRule);
+    expect(filter().getRuleById('directComparison')).to.deep.equal({ conditions: [{ field: 'player.name', value: '43Bad' }] });
+    expect(Object.keys(filter().getAllRules())).to.deep.equal(['directComparison']);
+    expect(filter().filterMessage(matchingDirectMessage)).to.equal(true);
+    expect(filter().filterMessage(nonMatchingDirectMessage)).to.equal(false);
+
+    filter().addRule('regexPattern', regexRule);
+
+    expect(Object.keys(filter().getAllRules()).sort()).to.deep.equal(['directComparison', 'regexPattern']);
+    expect(filter().filterMessage(matchingRegexMessage)).to.equal(true);
+    expect(filter().filterMessage(nonMatchingRegexMessage)).to.equal(false);
+    expect(filter().filterMessage(matchingDirectMessage)).to.equal(true);
+
+    filter().removeRule('directComparison');
+    expect(filter().getRuleById('directComparison')).to.equal(null);
+    expect(Object.keys(filter().getAllRules())).to.deep.equal(['regexPattern']);
+    expect(filter().filterMessage(matchingDirectMessage)).to.equal(false);
+    expect(filter().filterMessage(matchingRegexMessage)).to.equal(true);
+  });
+
+  it('requires every condition in a rule to match', () => {
+
+
+    filter().addRule('bothConditions', {
+      conditions: [
+        { field: 'player.name', value: '43Bad' },
+        { field: 'player.team', value: 2 },
+      ],
+    });
+
+    expect(filter().filterMessage({ player: { name: '43Bad', team: 2 } })).to.equal(true);
+    expect(filter().filterMessage({ player: { name: '43Bad', team: 1 } })).to.equal(false);
+    expect(filter().filterMessage({ player: { name: 'Spedd', team: 2 } })).to.equal(false);
+  });
+
+  it('supports inverted conditions and invalid condition non-matches', () => {
+
+
+    filter().addRule('invertCondition', { conditions: [{ field: 'player.team', value: 1, invert: true }] });
+    expect(filter().filterMessage({ player: { team: 2 } })).to.equal(true);
+    expect(filter().filterMessage({ player: { team: 1 } })).to.equal(false);
+
+    resetRules();
+    filter().addRule('missingField', { conditions: [{ field: 'player.badge', value: 'x' }] });
+    expect(filter().filterMessage({ player: { name: '43Bad' } })).to.equal(false);
+
+    resetRules();
+    filter().addRule('missingComparator', { conditions: [{ field: 'player.name' }] });
+    expect(filter().filterMessage({ player: { name: '43Bad' } })).to.equal(false);
+  });
+
+  it('overwrites an existing ID and logs the observed warning', () => {
+
+
+    const warnings = [];
+    console.warn = (message) => warnings.push(message);
+
+    filter().addRule('sameId', { conditions: [{ field: 'player.name', value: 'first' }] });
+    filter().addRule('sameId', { conditions: [{ field: 'player.name', value: 'second' }] });
+
+    expect(filter().getRuleById('sameId')).to.deep.equal({ conditions: [{ field: 'player.name', value: 'second' }] });
+
+    expect(warnings).to.have.lengthOf(1);
+    expect(String(warnings[0]).trim()).to.not.equal('');
+    expect(filter().filterMessage({ player: { name: 'first' } })).to.equal(false);
+    expect(filter().filterMessage({ player: { name: 'second' } })).to.equal(true);
+  });
+
+  it('logs an exact error and leaves state unchanged when removing an unknown ID', () => {
+
+
+    const errors = [];
+    console.error = (message) => errors.push(message);
+
+    filter().removeRule('unknown');
+
+
+    expect(errors).to.have.lengthOf(1);
+    expect(String(errors[0]).trim()).to.not.equal('');
+    expect(filter().getAllRules()).to.deep.equal({});
+  });
+
+  it('can remove the same rule twice without throwing while reporting the second removal error', () => {
+
+
+    const errors = [];
+    console.error = (message) => errors.push(message);
+
+    filter().addRule('temporary', directRule);
+    expect(filter().getAllRules()).to.deep.equal({ temporary: { conditions: [{ field: 'player.name', value: '43Bad' }] } });
+
+    expect(() => filter().removeRule('temporary')).to.not.throw();
+    expect(filter().getAllRules()).to.deep.equal({});
+    expect(() => filter().removeRule('temporary')).to.not.throw();
+
+
+    expect(errors).to.have.lengthOf(1);
+    expect(String(errors[0]).trim()).to.not.equal('');
+    expect(filter().getAllRules()).to.deep.equal({});
+  });
+
+  it('keeps independently named rules from sharing or corrupting each other', () => {
+
+
+    filter().addRule('a', { conditions: [{ field: 'player.name', value: '43Bad' }] });
+    filter().addRule('b', { conditions: [{ field: 'player.name', value: 'Spedd' }] });
+    filter().removeRule('a');
+
+    expect(filter().getRuleById('a')).to.equal(null);
+    expect(filter().getRuleById('b')).to.deep.equal({ conditions: [{ field: 'player.name', value: 'Spedd' }] });
+
+    expect(Object.keys(filter().getAllRules()).sort()).to.deep.equal(['b']);
+    expect(filter().filterMessage({ player: { name: '43Bad' } })).to.equal(false);
+    expect(filter().filterMessage({ player: { name: 'Spedd' } })).to.equal(true);
+  });
+
+  it('keeps the public rule counter bounded across repeated add/remove cleanup cycles', () => {
+
+
+    expect(Object.keys(filter().getAllRules()).length).to.equal(0);
+
+    for (let i = 0; i < 150; i += 1) {
+      const id = `cycle-${i}`;
+      filter().addRule(id, { conditions: [{ field: 'player.name', value: `agent-${i}` }] });
+      expect(filter().filterMessage({ player: { name: `agent-${i}` } })).to.equal(true);
+      filter().removeRule(id);
+      expect(Object.keys(filter().getAllRules()).length).to.equal(0);
+    }
+
+    expect(filter().getAllRules()).to.deep.equal({});
+  });
+
+  it('omits matching parsed COMM rows from rendered chat while keeping non-matches', () => {
+
+
+    filter().addRule('hide43Bad', directRule);
+
+    let htmlValue = null;
+    const dataStore = {};
+    const fakeElement = {
+      is(selector) {
+        if (selector === ':hidden') return false;
+        if (selector === ':empty') return htmlValue === null;
+        return false;
+      },
+      html(value) {
+        if (value !== undefined) htmlValue = value;
+        return htmlValue;
+      },
+      data(key, value) {
+        if (value !== undefined) dataStore[key] = value;
+        return dataStore[key];
+      },
+      scrollTop(value) {
+        dataStore.scrollTop = value;
+      },
+    };
+    globalThis.$ = (selector) => {
+
+      expect(String(selector)).to.include('chatall');
+      return fakeElement;
+    };
+
+    const commData = {
+      g1: [1700000000000, false, '<tr data-guid="g1"><td>Spedd row</td></tr>', 'Spedd', { player: { name: 'Spedd' } }],
+      g2: [1700000001000, false, '<tr data-guid="g2"><td>43Bad row</td></tr>', '43Bad', { player: { name: '43Bad' } }],
+      g3: [1700000002000, false, '<tr data-guid="g3"><td>Q77n row</td></tr>', 'Q77n', { player: { name: 'Q77n' } }],
+    };
+
+    IITC.comm.renderData(commData, 'chatall', false, ['g1', 'g2', 'g3']);
+
+
+    expect(htmlValue).to.include('data-guid="g1"');
+    expect(htmlValue).to.include('Spedd row');
+    expect(htmlValue).to.include('data-guid="g3"');
+    expect(htmlValue).to.include('Q77n row');
+    expect(htmlValue).to.not.include('data-guid="g2"');
+    expect(htmlValue).to.not.include('43Bad row');
+
+    expect(htmlValue).to.be.a('string').and.not.equal('');
+  });
+});
