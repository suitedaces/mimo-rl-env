+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+
+if [ ! -x node_modules/.bin/mocha ]; then
+  echo "Missing local mocha install; node_modules must be preinstalled for offline test execution." >&2
+  exit 127
+fi
+
+exec ./node_modules/.bin/mocha -r test/_mocks.js --exit /workspace/repo/usercase-test-coderl/comm_declarative_message_filter.test.js
