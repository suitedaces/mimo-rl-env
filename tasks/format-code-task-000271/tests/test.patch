diff --git a/packages/ts-interface-generator/src/test/generateMethods.test.ts b/packages/ts-interface-generator/src/test/generateMethods.test.ts
index 86f1900..a908c9b 100644
--- a/packages/ts-interface-generator/src/test/generateMethods.test.ts
+++ b/packages/ts-interface-generator/src/test/generateMethods.test.ts
@@ -40,7 +40,7 @@ test("Generate methods for aggregation", () => {
 getContent(): Control[];
 addContent(content: Control): this;
 insertContent(content: Control, index: number): this;
-removeContent(content: number | string | Control): this;
+removeContent(content: number | string | Control): Control | null;
 removeAllContent(): Control[];
 indexOfContent(content: Control): number;
 destroyContent(): this;
@@ -89,3 +89,65 @@ unbindContent(): this;`;
 
   expect(interfaceText.trim()).toEqual(expected);
 });
+
+test("Aggregation 0..n remove returns aggregation type | null (uses the actual aggregation type, not 'this' or hardcoded)", () => {
+  const requiredImports: RequiredImports = {};
+  const knownGlobals: {
+    [key: string]: { moduleName: string; exportName?: string };
+  } = {};
+  const classInfo: ClassInfo = {
+    name: "MyTestClass",
+    aggregations: {
+      columns: {
+        name: "columns",
+        type: "MyItem",
+        cardinality: "0..n",
+        altTypes: null,
+        bindable: false,
+        singularName: "column",
+        methods: {
+          get: "getColumns",
+          add: "addColumn",
+          insert: "insertColumn",
+          remove: "removeColumn",
+          removeAll: "removeAllColumns",
+          indexOf: "indexOfColumn",
+          destroy: "destroyColumns",
+        },
+      },
+    },
+  };
+
+  const methods = generateMethods(
+    classInfo,
+    requiredImports,
+    knownGlobals,
+    {},
+    {},
+  );
+
+  const interfaceText = astToString(methods).trim();
+
+
+  expect(interfaceText).toContain(
+    "removeColumn(columns: number | string | MyItem): MyItem | null;",
+  );
+
+  expect(interfaceText).not.toMatch(
+    /removeColumn\(columns: number \| string \| MyItem\): this;/,
+  );
+
+  expect(interfaceText).not.toMatch(
+    /removeColumn\(columns: number \| string \| MyItem\): MyItem;/,
+  );
+
+  expect(interfaceText).toContain(
+    "insertColumn(columns: MyItem, index: number): this;",
+  );
+
+  expect(interfaceText).toContain("getColumns(): MyItem[];");
+  expect(interfaceText).toContain("addColumn(columns: MyItem): this;");
+  expect(interfaceText).toContain("removeAllColumns(): MyItem[];");
+  expect(interfaceText).toContain("indexOfColumn(columns: MyItem): number;");
+  expect(interfaceText).toContain("destroyColumns(): this;");
+});
