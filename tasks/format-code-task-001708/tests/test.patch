index 7b1f84ef..26ba5680 100644
--- a/tests/test_main.py
+++ b/tests/test_main.py
@@ -5054,3 +5054,123 @@ def test_main_multiple_required_any_of():
 
     with pytest.raises(SystemExit):
         main()
+
+
+
+
+
+
+
+
+
+
+def _generate_to_string(schema_yaml: str, *extra_args: str) -> str:
+    with TemporaryDirectory() as output_dir:
+        input_file: Path = Path(output_dir) / 'schema.yaml'
+        input_file.write_text(schema_yaml)
+        output_file: Path = Path(output_dir) / 'output.py'
+        return_code: Exit = main(
+            [
+                '--input',
+                str(input_file),
+                '--output',
+                str(output_file),
+                '--target-python-version',
+                '3.8',
+                '--input-file-type',
+                'jsonschema',
+                *extra_args,
+            ]
+        )
+        assert return_code == Exit.OK
+        return output_file.read_text()
+
+
+@freeze_time('2019-07-26')
+def test_main_with_int64_maximum_preserves_precision():
+    """Exact reproduction of the bug report."""
+    schema = (
+        'definitions:\n'
+        '  testInt64:\n'
+        '    type: integer\n'
+        '    minimum: 2097152\n'
+        '    maximum: 9223372036854775807\n'
+    )
+    output = _generate_to_string(schema)
+
+
+    assert 'conint(ge=2097152, le=9223372036854775807)' in output
+    assert '9223372036854775808' not in output
+
+
+@freeze_time('2019-07-26')
+def test_main_with_int64_negative_minimum_preserves_precision():
+    """Negative int64 min, with a >2^53 positive max."""
+    schema = (
+        'type: object\n'
+        'properties:\n'
+        '  bnd:\n'
+        '    type: integer\n'
+        '    minimum: -9223372036854775808\n'
+        '    maximum: 9007199254740993\n'
+    )
+    output = _generate_to_string(schema)
+
+
+    assert 'ge=-9223372036854775808' in output
+    assert 'le=9007199254740993' in output
+    assert '9007199254740992' not in output
+
+
+@freeze_time('2019-07-26')
+def test_main_with_large_int_field_constraints_preserves_precision():
+    """--field-constraints renders constraints through the Constraints class.
+
+    The Constraints class previously used Optional[Union[float, int]] which
+    pydantic v1 coerces to float, losing precision. The fix must also keep
+    int precision on that code path.
+    """
+    schema = (
+        'type: object\n'
+        'properties:\n'
+        '  big:\n'
+        '    type: integer\n'
+        '    minimum: 2097152\n'
+        '    maximum: 9223372036854775807\n'
+    )
+    output = _generate_to_string(schema, '--field-constraints')
+    assert 'ge=2097152' in output
+    assert 'le=9223372036854775807' in output
+    assert '9223372036854775808' not in output
+
+
+@freeze_time('2019-07-26')
+def test_main_with_number_type_preserves_float_bounds():
+    """Preservation: number (float) types must still render float bounds."""
+    schema = (
+        'type: object\n'
+        'properties:\n'
+        '  h:\n'
+        '    type: number\n'
+        '    minimum: 0\n'
+        '    maximum: 100\n'
+    )
+    output = _generate_to_string(schema)
+
+    assert 'confloat(ge=0.0, le=100.0)' in output
+    assert 'conint' not in output
+
+
+@freeze_time('2019-07-26')
+def test_main_with_small_int_constraints_unchanged():
+    """Preservation: small integer constraints render unchanged after the fix."""
+    schema = (
+        'type: object\n'
+        'properties:\n'
+        '  status:\n'
+        '    type: integer\n'
+        '    minimum: 100\n'
+        '    maximum: 600\n'
+    )
+    output = _generate_to_string(schema)
+    assert 'conint(ge=100, le=600)' in output
