+import numpy as np
+import pytest
+
+import pandas as pd
+from pandas import DataFrame, Index, MultiIndex, Series
+import pandas._testing as tm
+
+
+def _make_single_level_mi_df():
+    names = ["FirstColumn", "SecondColumn"]
+    data = np.array([[5, 6], [7, 8]])
+    return DataFrame(data, columns=[names])
+
+
+class TestSingleLevelMultiIndexColumns:
+    def test_columns_is_multiindex_single_level(self):
+
+        df = _make_single_level_mi_df()
+        assert isinstance(df.columns, MultiIndex)
+        assert df.columns.nlevels == 1
+
+    def test_getitem_returns_dataframe(self):
+
+
+        df = _make_single_level_mi_df()
+        result = df["FirstColumn"]
+        assert isinstance(result, DataFrame)
+        assert result.shape == (2, 1)
+
+        assert result.values.ravel().tolist() == [5, 7]
+
+        assert isinstance(result.columns, MultiIndex)
+
+    def test_getattr_returns_dataframe(self):
+
+        df = _make_single_level_mi_df()
+        result = df.FirstColumn
+        assert isinstance(result, DataFrame)
+        assert result.shape == (2, 1)
+        assert result.values.ravel().tolist() == [5, 7]
+
+    def test_loc_returns_dataframe(self):
+
+        df = _make_single_level_mi_df()
+        result = df.loc[:, "FirstColumn"]
+        assert isinstance(result, DataFrame)
+        assert result.shape == (2, 1)
+        assert result.values.ravel().tolist() == [5, 7]
+
+    def test_getitem_second_column(self):
+
+        df = _make_single_level_mi_df()
+        result = df["SecondColumn"]
+        assert isinstance(result, DataFrame)
+        assert result.shape == (2, 1)
+        assert result.values.ravel().tolist() == [6, 8]
+
+    def test_getitem_missing_key_raises_keyerror(self):
+
+        df = _make_single_level_mi_df()
+        with pytest.raises(KeyError):
+            df["NonExistent"]
+
+    def test_regular_index_returns_series_unchanged(self):
+
+
+        df = DataFrame([[1, 2], [3, 4]], columns=["a", "b"])
+        result = df["a"]
+        assert isinstance(result, Series)
+        assert result.tolist() == [1, 3]
+
+    def test_multi_level_multiindex_unchanged(self):
+
+
+        df = DataFrame(
+            [[1, 2, 3, 4]],
+            columns=MultiIndex.from_tuples(
+                [("A", "x"), ("A", "y"), ("B", "x"), ("B", "y")]
+            ),
+        )
+        result = df["A"]
+        assert isinstance(result, DataFrame)
+        assert result.shape == (1, 2)
+        assert list(result.columns) == ["x", "y"]
+
+    def test_getitem_does_not_raise_typeerror(self):
+
+
+
+        df = _make_single_level_mi_df()
+        try:
+            df["FirstColumn"]
+        except TypeError as exc:  # pragma: no cover - guard
+            pytest.fail(f"unexpected TypeError: {exc}")
