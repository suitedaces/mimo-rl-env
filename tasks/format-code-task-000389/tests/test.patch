--- a/tests/unit/plugins/modules/test_postgresql_pg_hba.py
+++ b/tests/unit/plugins/modules/test_postgresql_pg_hba.py
@@ -537,3 +537,196 @@ def test_parse_auth_options():
         parse_auth_options(["notkeyvalue"])
     with pytest.raises(PgHbaRuleValueError, match="The rule contains two options with the same key"):
         parse_auth_options(["key=value", "key=value2"])
+
+
+def _run_pg_hba_main(module_args):
+    """
+    Invoke the postgresql_pg_hba module's main() with the given Ansible module
+    args dict. This is the actual user-vantage entry point used by Ansible.
+    Returns (exit_code, parsed_output_dict).
+    """
+    import json
+    import io
+    import os
+    import sys
+    import tempfile
+
+
+    if 'dest' not in module_args:
+        tmp = tempfile.NamedTemporaryFile(mode='w', suffix='.conf', delete=False)
+        tmp.close()
+        module_args['dest'] = tmp.name
+        module_args.setdefault('create', True)
+
+
+
+    if not os.path.exists(module_args['dest']):
+        with open(module_args['dest'], 'w'):
+            pass
+
+    payload = json.dumps({'ANSIBLE_MODULE_ARGS': module_args})
+
+    class FakeStdin(object):
+        def __init__(self, data):
+            self.buffer = io.BytesIO(data.encode())
+
+    old_stdin = sys.stdin
+    old_argv = sys.argv
+    sys.stdin = FakeStdin(payload)
+    sys.argv = ['module']
+
+
+
+
+    from ansible.module_utils import basic as _basic
+    _basic._ANSIBLE_ARGS = None
+
+    if sys.version_info[0] == 3:
+        from plugins.modules import postgresql_pg_hba as _mod
+    else:
+        from ansible_collections.community.postgresql.plugins.modules \
+            import postgresql_pg_hba as _mod
+
+
+    captured = io.StringIO()
+    old_stdout = sys.stdout
+    sys.stdout = captured
+    exit_code = None
+    try:
+        try:
+            _mod.main()
+        except SystemExit as e:
+            exit_code = e.code if isinstance(e.code, int) else 0
+    finally:
+        sys.stdout = old_stdout
+        sys.stdin = old_stdin
+        sys.argv = old_argv
+
+    out = captured.getvalue().strip()
+    parsed = {}
+    if out:
+        try:
+            parsed = json.loads(out)
+        except ValueError:
+            parsed = {'_raw': out}
+    return exit_code, parsed
+
+
+def test_localfix_default_address_samehost_does_not_raise():
+
+
+
+    try:
+        import ipaddress
+    except ImportError:
+        return
+    ipaddress.ip_address("0.0.0.0")
+
+    exit_code, out = _run_pg_hba_main({
+        'contype': 'local',
+        'databases': 'datadata',
+        'users': 'datata',
+
+
+    })
+    assert out.get('failed') is not True, \
+        "Module should not fail; got msg: {0}".format(out.get('msg'))
+    assert exit_code == 0
+
+
+def test_localfix_explicit_address_with_contype_local_does_not_fail():
+
+
+
+    try:
+        import ipaddress
+    except ImportError:
+        return
+    ipaddress.ip_address("0.0.0.0")
+
+    exit_code, out = _run_pg_hba_main({
+        'contype': 'local',
+        'databases': 'all',
+        'users': 'all',
+        'method': 'md5',
+        'address': '127.0.0.1/32',
+    })
+    assert out.get('failed') is not True, \
+        "Module should not fail; got msg: {0}".format(out.get('msg'))
+    assert exit_code == 0
+
+
+def test_localfix_explicit_netmask_with_contype_local_does_not_fail():
+
+
+    try:
+        import ipaddress
+    except ImportError:
+        return
+    ipaddress.ip_address("0.0.0.0")
+
+    exit_code, out = _run_pg_hba_main({
+        'contype': 'local',
+        'databases': 'all',
+        'users': 'all',
+        'method': 'md5',
+        'netmask': '255.255.255.255',
+    })
+    assert out.get('failed') is not True, \
+        "Module should not fail; got msg: {0}".format(out.get('msg'))
+    assert exit_code == 0
+
+
+def test_localfix_preservation_host_still_requires_address():
+
+    try:
+        import ipaddress
+    except ImportError:
+        return
+    ipaddress.ip_address("0.0.0.0")
+    with pytest.raises(PgHbaRuleError,
+                       match="If the contype isn't 'local', the rule needs to contain an address"):
+        PgHbaRule(rule_dict={'contype': 'host', 'databases': 'all',
+                             'users': 'all', 'method': 'md5'})
+
+
+def test_localfix_preservation_host_full_cidr_with_netmask_raises():
+
+    try:
+        import ipaddress
+    except ImportError:
+        return
+    ipaddress.ip_address("0.0.0.0")
+    with pytest.raises(PgHbaRuleError,
+                       match="Rule can't contain a netmask if address is a full CIDR or hostname"):
+        PgHbaRule(rule_dict={'contype': 'host', 'databases': 'all',
+                             'users': 'all', 'method': 'md5',
+                             'address': '127.0.0.1/32',
+                             'netmask': '255.255.255.255'})
+
+
+def test_localfix_rules_param_with_local_and_explicit_address():
+
+
+
+
+
+    try:
+        import ipaddress
+    except ImportError:
+        return
+    ipaddress.ip_address("0.0.0.0")
+
+    exit_code, out = _run_pg_hba_main({
+        'rules': [{
+            'contype': 'local',
+            'databases': 'all',
+            'users': 'all',
+            'method': 'md5',
+            'address': '127.0.0.1',
+        }],
+        'rules_behavior': 'combine',
+    })
+    assert out.get('failed') is not True, \
+        "Module should not fail; got msg: {0}".format(out.get('msg'))
+    assert exit_code == 0
