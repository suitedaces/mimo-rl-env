@@ -0,0 +1,35 @@
+package context
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/aws/amazon-genomics-cli/internal/pkg/version"
+	"github.com/stretchr/testify/assert"
+)
+
+const testAgcVersionForContextEnv = "8.7.6-test-context"
+
+
+
+
+
+
+func TestContextEnvironment_ToEnvironmentList_IncludesAgcVersionEntry(t *testing.T) {
+	origVersion := version.Version
+	defer func() { version.Version = origVersion }()
+	version.Version = testAgcVersionForContextEnv
+
+	env := contextEnvironment{}
+	list := env.ToEnvironmentList()
+
+	hasKey := false
+	for _, item := range list {
+		if strings.HasPrefix(item, "AGC_VERSION=") {
+			hasKey = true
+			break
+		}
+	}
+	assert.True(t, hasKey,
+		"expected an AGC_VERSION=... entry in ToEnvironmentList output; got %v", list)
+}
