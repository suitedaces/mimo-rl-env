+++ b/packages/cli/internal/pkg/cli/account_activate_agc_version_test.go
@@ -0,0 +1,112 @@
+package cli
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/aws/amazon-genomics-cli/internal/pkg/aws/cdk"
+	"github.com/aws/amazon-genomics-cli/internal/pkg/logging"
+	"github.com/aws/amazon-genomics-cli/internal/pkg/version"
+	"github.com/golang/mock/gomock"
+	"github.com/stretchr/testify/assert"
+)
+
+const testAgcVersionForActivate = "9.9.9-test-activate"
+
+func TestAccountActivate_PassesAgcVersion(t *testing.T) {
+	origVerbose := logging.Verbose
+	defer func() { logging.Verbose = origVerbose }()
+	logging.Verbose = true
+
+	origVersion := version.Version
+	defer func() { version.Version = origVersion }()
+	version.Version = testAgcVersionForActivate
+
+	mocks := createMocks(t)
+	defer mocks.ctrl.Finish()
+	close(mocks.progressStream)
+
+	mocks.s3Mock.EXPECT().BucketExists(testAccountBucketName).Return(true, nil)
+
+	var capturedEnv []string
+	mocks.cdkMock.EXPECT().
+		DeployApp(gomock.Any(), gomock.Any(), gomock.Any()).
+		DoAndReturn(func(_ string, env []string, _ string) (cdk.ProgressStream, error) {
+			capturedEnv = env
+			return mocks.progressStream, nil
+		})
+
+	opts := &accountActivateOpts{
+		accountActivateVars: accountActivateVars{
+			bucketName: testAccountBucketName,
+			vpcId:      "",
+		},
+		stsClient: mocks.stsMock,
+		s3Client:  mocks.s3Mock,
+		cdkClient: mocks.cdkMock,
+		ecrClient: mocks.ecrMock,
+		imageRefs: testImageRefs,
+		region:    testAccountRegion,
+	}
+
+	err := opts.Execute()
+	assert.NoError(t, err)
+
+	expected := "AGC_VERSION=" + testAgcVersionForActivate
+	assert.Contains(t, capturedEnv, expected,
+		"expected %q in env vars passed to DeployApp; got: %v", expected, capturedEnv)
+}
+
+func TestAccountActivate_PassesAgcVersion_WithVpc(t *testing.T) {
+	origVerbose := logging.Verbose
+	defer func() { logging.Verbose = origVerbose }()
+	logging.Verbose = true
+
+	origVersion := version.Version
+	defer func() { version.Version = origVersion }()
+	version.Version = testAgcVersionForActivate
+
+	mocks := createMocks(t)
+	defer mocks.ctrl.Finish()
+	close(mocks.progressStream)
+
+	mocks.s3Mock.EXPECT().BucketExists(testAccountBucketName).Return(false, nil)
+
+	var capturedEnv []string
+	mocks.cdkMock.EXPECT().
+		DeployApp(gomock.Any(), gomock.Any(), gomock.Any()).
+		DoAndReturn(func(_ string, env []string, _ string) (cdk.ProgressStream, error) {
+			capturedEnv = env
+			return mocks.progressStream, nil
+		})
+
+	opts := &accountActivateOpts{
+		accountActivateVars: accountActivateVars{
+			bucketName: testAccountBucketName,
+			vpcId:      testAccountVpcId,
+		},
+		stsClient: mocks.stsMock,
+		s3Client:  mocks.s3Mock,
+		cdkClient: mocks.cdkMock,
+		ecrClient: mocks.ecrMock,
+		imageRefs: testImageRefs,
+		region:    testAccountRegion,
+	}
+
+	err := opts.Execute()
+	assert.NoError(t, err)
+
+	expected := "AGC_VERSION=" + testAgcVersionForActivate
+	assert.Contains(t, capturedEnv, expected,
+		"expected %q in env vars passed to DeployApp; got: %v", expected, capturedEnv)
+
+
+	hasVpc := false
+	for _, v := range capturedEnv {
+		if strings.HasPrefix(v, "VPC_ID=") {
+			hasVpc = true
+			break
+		}
+	}
+	assert.True(t, hasVpc, "expected VPC_ID in env vars; got: %v", capturedEnv)
+}
