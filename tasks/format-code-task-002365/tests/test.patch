diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,258 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+( cd /workspace/repo && cmake -S tools/xar -B "$TMP/build" >/dev/null && cmake --build "$TMP/build" --target host_xar -j2 >/dev/null ) \
+    || { echo "FAIL: build" >&2; exit 1; }
+BIN="$TMP/build/xar"
+
+cd "$TMP"
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+make_header() {
+    python3 - "$@" <<'PY'
+import struct
+import sys
+
+path = sys.argv[1]
+magic = int(sys.argv[2], 0)
+size = int(sys.argv[3], 0)
+version = int(sys.argv[4], 0)
+compressed = int(sys.argv[5], 0)
+uncompressed = int(sys.argv[6], 0)
+algorithm = int(sys.argv[7], 0)
+name_hex = sys.argv[8] if len(sys.argv) > 8 else ""
+
+data = struct.pack(">IHHQQI", magic, size, version, compressed, uncompressed, algorithm)
+if name_hex:
+    data += bytes.fromhex(name_hex)
+    data += b"\0" * max(0, 64 - len(data))
+with open(path, "wb") as f:
+    f.write(data)
+PY
+}
+
+assert_empty_stderr() {
+    fixture="$1"
+    [ ! -s err ] || fail "$fixture unexpected stderr: $(cat err)"
+}
+
+
+
+
+"$BIN" --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_help exit $ec; want 0"
+
+HELP_LINE=$(grep -F -- "--dump-header" out | head -n1 || true)
+[ -n "$HELP_LINE" ] || fail "F_help missing --dump-header help line"
+HELP_LOWER=$(printf '%s\n' "$HELP_LINE" | tr '[:upper:]' '[:lower:]')
+case "$HELP_LOWER" in *binary*) ;; *) fail "F_help --dump-header line does not mention binary: $HELP_LINE" ;; esac
+case "$HELP_LOWER" in *header*) ;; *) fail "F_help --dump-header line does not mention header: $HELP_LINE" ;; esac
+case "$HELP_LOWER" in *information*) ;; *) fail "F_help --dump-header line does not mention information: $HELP_LINE" ;; esac
+assert_empty_stderr F_help
+
+
+
+
+make_header sha1_base.xar 0x78617221 28 1 17 31 1
+"$BIN" --dump-header -f sha1_base.xar >out 2>err; ec=$?
+EXPECTED=$(cat <<'EOF'
+magic:                   0x78617221 (OK)
+size:                    28
+version:                 1
+Compressed TOC length:   17
+Uncompressed TOC length: 31
+TOC Checksum algorithm:  1 (sha1)
+EOF
+)
+[ "$ec" -eq 0 ] || fail "F_sha1 exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F_sha1 stdout: $(cat out)"
+assert_empty_stderr F_sha1
+
+
+
+
+make_header none_base.xar 0x78617221 28 1 0 9 0
+"$BIN" --dump-header -f none_base.xar >out 2>err; ec=$?
+EXPECTED=$(cat <<'EOF'
+magic:                   0x78617221 (OK)
+size:                    28
+version:                 1
+Compressed TOC length:   0
+Uncompressed TOC length: 9
+TOC Checksum algorithm:  0 (none)
+EOF
+)
+[ "$ec" -eq 0 ] || fail "F_none exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F_none stdout: $(cat out)"
+assert_empty_stderr F_none
+
+
+
+
+make_header md5_base.xar 0x78617221 28 2 123456789 987654321 2
+"$BIN" --dump-header -f md5_base.xar >out 2>err; ec=$?
+EXPECTED=$(cat <<'EOF'
+magic:                   0x78617221 (OK)
+size:                    28
+version:                 2
+Compressed TOC length:   123456789
+Uncompressed TOC length: 987654321
+TOC Checksum algorithm:  2 (md5)
+EOF
+)
+[ "$ec" -eq 0 ] || fail "F_md5_large_fields exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F_md5_large_fields stdout: $(cat out)"
+assert_empty_stderr F_md5_large_fields
+
+
+
+
+make_header unknown_base.xar 0x78617221 28 1 5 6 99
+"$BIN" --dump-header -f unknown_base.xar >out 2>err; ec=$?
+EXPECTED=$(cat <<'EOF'
+magic:                   0x78617221 (OK)
+size:                    28
+version:                 1
+Compressed TOC length:   5
+Uncompressed TOC length: 6
+TOC Checksum algorithm:  99 (unknown)
+EOF
+)
+[ "$ec" -eq 0 ] || fail "F_unknown exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F_unknown stdout: $(cat out)"
+assert_empty_stderr F_unknown
+
+
+
+
+make_header bad_magic.xar 0x12345678 28 1 11 22 2
+"$BIN" --dump-header -f bad_magic.xar >out 2>err; ec=$?
+EXPECTED=$(cat <<'EOF'
+magic:                   0x12345678 (BAD)
+size:                    28
+version:                 1
+Compressed TOC length:   11
+Uncompressed TOC length: 22
+TOC Checksum algorithm:  2 (md5)
+EOF
+)
+[ "$ec" -eq 0 ] || fail "F_bad_magic exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F_bad_magic stdout: $(cat out)"
+assert_empty_stderr F_bad_magic
+
+
+
+
+make_header other_valid.xar 0x78617221 64 1 44 88 3 73686132353600
+"$BIN" --dump-header -f other_valid.xar >out 2>err; ec=$?
+EXPECTED=$(cat <<'EOF'
+magic:                   0x78617221 (OK)
+size:                    64
+version:                 1
+Compressed TOC length:   44
+Uncompressed TOC length: 88
+TOC Checksum algorithm:  3 (OTHER + sha256)
+EOF
+)
+[ "$ec" -eq 0 ] || fail "F_other_valid exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F_other_valid stdout: $(cat out)"
+assert_empty_stderr F_other_valid
+
+
+
+
+make_header other_invalid_len_small.xar 0x78617221 30 1 44 88 3 616200
+"$BIN" --dump-header -f other_invalid_len_small.xar >out 2>err; ec=$?
+EXPECTED=$(cat <<'EOF'
+magic:                   0x78617221 (OK)
+size:                    30
+version:                 1
+Compressed TOC length:   44
+Uncompressed TOC length: 88
+TOC Checksum algorithm:  3 (OTHER + invalid header length)
+EOF
+)
+[ "$ec" -eq 0 ] || fail "F_other_invalid_short_length exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F_other_invalid_short_length stdout: $(cat out)"
+assert_empty_stderr F_other_invalid_short_length
+
+
+
+
+make_header other_invalid_len_unaligned.xar 0x78617221 34 1 44 88 3 6162636400
+"$BIN" --dump-header -f other_invalid_len_unaligned.xar >out 2>err; ec=$?
+EXPECTED=$(cat <<'EOF'
+magic:                   0x78617221 (OK)
+size:                    34
+version:                 1
+Compressed TOC length:   44
+Uncompressed TOC length: 88
+TOC Checksum algorithm:  3 (OTHER + invalid header length)
+EOF
+)
+[ "$ec" -eq 0 ] || fail "F_other_invalid_unaligned_length exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F_other_invalid_unaligned_length stdout: $(cat out)"
+assert_empty_stderr F_other_invalid_unaligned_length
+
+
+
+
+make_header other_non_nul.xar 0x78617221 32 1 44 88 3 61626364
+"$BIN" --dump-header -f other_non_nul.xar >out 2>err; ec=$?
+EXPECTED=$(cat <<'EOF'
+magic:                   0x78617221 (OK)
+size:                    32
+version:                 1
+Compressed TOC length:   44
+Uncompressed TOC length: 88
+TOC Checksum algorithm:  3 (OTHER + invalid non-nul terminated name)
+EOF
+)
+[ "$ec" -eq 0 ] || fail "F_other_non_nul exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F_other_non_nul stdout: $(cat out)"
+assert_empty_stderr F_other_non_nul
+
+
+
+
+make_header other_empty.xar 0x78617221 32 1 44 88 3 00616263
+"$BIN" --dump-header -f other_empty.xar >out 2>err; ec=$?
+EXPECTED=$(cat <<'EOF'
+magic:                   0x78617221 (OK)
+size:                    32
+version:                 1
+Compressed TOC length:   44
+Uncompressed TOC length: 88
+TOC Checksum algorithm:  3 (OTHER + invalid empty name)
+EOF
+)
+[ "$ec" -eq 0 ] || fail "F_other_empty exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED" ] || fail "F_other_empty stdout: $(cat out)"
+assert_empty_stderr F_other_empty
+
+
+
+
+"$BIN" --dump-header -f no-such.xar >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F_open_error exit 0; want non-zero"
+[ ! -s out ] || fail "F_open_error unexpected stdout: $(cat out)"
+
+[ -s err ] || fail "F_open_error missing stderr"
+grep -Fq "No such file or directory" err || fail "F_open_error stderr: $(cat err)"
+
+
+
+
+printf '\x78\x61\x72' > short.xar
+"$BIN" --dump-header -f short.xar >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F_short_read exit 0; want non-zero"
+[ ! -s out ] || fail "F_short_read unexpected stdout: $(cat out)"
+[ "$(cat err)" = "error reading header" ] || fail "F_short_read stderr: $(cat err)"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
