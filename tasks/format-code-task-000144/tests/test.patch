+def test_tensorboard_default_logdir_uses_version_prefix(tmpdir):
+    """The experiment directory must be named 'version_<n>' so it matches
+    ModelCheckpoint's default of 'lightning_logs/version_0'."""
+    logger = TensorBoardLogger(save_dir=str(tmpdir), name="default_prefix_test")
+    _ = logger.experiment
+
+    name_dir = os.path.join(str(tmpdir), "default_prefix_test")
+    expected = os.path.join(name_dir, "version_0")
+    bare = os.path.join(name_dir, "0")
+
+    assert os.path.isdir(expected), \
+        "Expected experiment dir to be 'version_0', got contents: %r" % os.listdir(name_dir)
+    assert not os.path.isdir(bare), \
+        "Expected bare numeric dir '0' NOT to exist alongside 'version_0'"
+
+
+def test_tensorboard_manual_version_creates_version_prefixed_dir(tmpdir):
+    """When the user passes an explicit version, the on-disk directory
+    must be 'version_<n>'."""
+    logger = TensorBoardLogger(save_dir=str(tmpdir),
+                               name="manual_prefix_test",
+                               version=5)
+    _ = logger.experiment
+
+    name_dir = os.path.join(str(tmpdir), "manual_prefix_test")
+    assert os.path.isdir(os.path.join(name_dir, "version_5"))
+    assert not os.path.isdir(os.path.join(name_dir, "5"))
+
+
+def test_tensorboard_auto_version_reads_version_prefixed_dirs(tmpdir):
+    """Auto-versioning must scan dirs named 'version_<n>' and pick max+1."""
+    root_dir = tmpdir.mkdir("auto_version_prefix")
+    root_dir.mkdir("version_0")
+    root_dir.mkdir("version_1")
+
+    logger = TensorBoardLogger(save_dir=str(tmpdir), name="auto_version_prefix")
+    assert logger.version == 2
+
+
+def test_tensorboard_auto_version_ignores_bare_digit_dirs(tmpdir):
+    """Bare numeric dirs (legacy / unrelated) must NOT be counted by
+    auto-versioning. Only 'version_<n>' dirs participate."""
+    root_dir = tmpdir.mkdir("auto_version_ignore_bare")
+
+    root_dir.mkdir("0")
+    root_dir.mkdir("1")
+    root_dir.mkdir("7")
+
+    logger = TensorBoardLogger(save_dir=str(tmpdir), name="auto_version_ignore_bare")
+
+    assert logger.version == 0
+
+
+def test_tensorboard_save_writes_meta_tags_in_version_dir(tmpdir):
+    """save() must write meta_tags.csv inside the same 'version_<n>' dir
+    that experiment created (not fall back to save_dir)."""
+    logger = TensorBoardLogger(save_dir=str(tmpdir),
+                               name="save_meta_test",
+                               version=3)
+    logger.log_hyperparams({"a": 1})
+    logger.save()
+
+    expected_csv = os.path.join(str(tmpdir),
+                                "save_meta_test",
+                                "version_3",
+                                logger.NAME_CSV_TAGS)
+    fallback_csv = os.path.join(str(tmpdir), logger.NAME_CSV_TAGS)
+    assert os.path.isfile(expected_csv), \
+        "meta_tags.csv must be written inside the version_<n> dir"
+    assert not os.path.isfile(fallback_csv), \
+        "meta_tags.csv must NOT fall back to save_dir when version dir exists"
+
+
