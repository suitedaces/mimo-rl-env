 #!/usr/bin/env python
 import os
+import pytest
 from pyshortcuts import make_shortcut, platform, Shortcut, get_folders
 
 root = os.path.abspath(os.path.join(__file__, '..', '..'))
@@ -23,5 +24,46 @@ def test_shortcut():
 
     #raise err # force crash so we see manual print() debug statements
 
+
+def test_make_shortcut_none_script_raises_valueerror():
+    """make_shortcut(None) must raise ValueError, not AttributeError.
+
+    Reproduces the issue: `cmd = shutil.which("missing")` returns None,
+    then `make_shortcut(cmd, ...)` previously crashed with
+    `AttributeError: 'NoneType' object has no attribute 'split'`.
+    """
+    with pytest.raises(ValueError):
+        make_shortcut(None, name='Foo')
+
+
+def test_make_shortcut_empty_string_raises_valueerror():
+    """make_shortcut('') must raise ValueError."""
+    with pytest.raises(ValueError):
+        make_shortcut('', name='Foo')
+
+
+def test_make_shortcut_non_string_raises_valueerror():
+    """make_shortcut(non_string) must raise ValueError (not AttributeError)."""
+    with pytest.raises(ValueError):
+        make_shortcut(123, name='Foo')
+
+
+def test_make_shortcut_none_does_not_raise_attributeerror():
+    """Negative assertion: must NOT raise AttributeError (the original bug)."""
+    try:
+        make_shortcut(None, name='Foo')
+    except ValueError:
+        pass
+    except AttributeError as exc:
+        pytest.fail("make_shortcut(None) raised AttributeError: %s" % exc)
+
+
+def test_make_shortcut_valid_script_still_works():
+    """Preservation: a valid script string still returns a Shortcut."""
+    script = os.path.join(root, 'examples', 'console_scripts', 'timer.py') + ' -u 0.25 -t 10'
+    scut = make_shortcut(script, name='Timer', folder=folders.desktop)
+    assert isinstance(scut, Shortcut)
+
+
 if __name__ == '__main__':
     test_shortcut()
