diff --git a/usercase-test-coderl/test_duplicate_safe_add_file.py b/usercase-test-coderl/test_duplicate_safe_add_file.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_duplicate_safe_add_file.py
@@ -0,0 +1,152 @@
+import json
+import plistlib
+
+from pbxproj import XcodeProject
+
+
+FIXTURES = "/workspace/repo/usercase-test-coderl/fixtures"
+
+
+def _load_project(tmp_path):
+    fixture_path = f"{FIXTURES}/duplicate_file_project.json"
+    project_data = json.loads(open(fixture_path, encoding="utf-8").read())
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    project_path = tmp_path / "project.pbxproj"
+    with open(project_path, "wb") as project_file:
+        plistlib.dump(project_data, project_file, fmt=plistlib.FMT_BINARY)
+    return XcodeProject.load(str(project_path))
+
+
+def _section_count(project, section_name):
+    return len(project.objects.get_objects_in_section(section_name))
+
+
+def _target_source_paths(project, target_name):
+    target = project.get_target_by_name(target_name)
+    paths = []
+    for phase_id in target.buildPhases:
+        phase = project.get_object(phase_id)
+        if phase.isa != "PBXSourcesBuildPhase":
+            continue
+        for build_file_id in phase.files:
+            build_file = project.get_object(build_file_id)
+            file_ref = project.get_object(build_file.fileRef)
+            paths.append(file_ref.path)
+    return paths
+
+
+def _file_reference_paths(project):
+    return sorted(file_ref.path for file_ref in project.objects.get_objects_in_section("PBXFileReference"))
+
+
+def test_duplicate_in_selected_target_returns_empty_and_keeps_existing_membership(tmp_path):
+
+
+
+
+    project = _load_project(tmp_path)
+    assert _section_count(project, "PBXFileReference") == 1
+    assert _section_count(project, "PBXBuildFile") == 1
+    assert _target_source_paths(project, "app") == ["Sources/file.m"]
+    assert _target_source_paths(project, "report") == []
+
+    created = project.add_file("file.m", target_name="app", force=False)
+
+    assert created == []
+    assert _section_count(project, "PBXFileReference") == 1
+    assert _section_count(project, "PBXBuildFile") == 1
+    assert _target_source_paths(project, "app") == ["Sources/file.m"]
+    assert _target_source_paths(project, "report") == []
+
+    assert _file_reference_paths(project) == ["Sources/file.m"]
+
+
+def test_partial_duplicate_target_list_adds_only_missing_target(tmp_path):
+
+
+
+
+    project = _load_project(tmp_path)
+
+    created = project.add_file("file.m", target_name=["app", "report"], force=False)
+
+    assert [build_file.isa for build_file in created] == ["PBXBuildFile"]
+
+    assert [project.get_object(build_file.fileRef).path for build_file in created] == ["file.m"]
+    assert _section_count(project, "PBXFileReference") == 2
+    assert _section_count(project, "PBXBuildFile") == 2
+    assert _target_source_paths(project, "app") == ["Sources/file.m"]
+    assert _target_source_paths(project, "report") == ["file.m"]
+
+    assert _file_reference_paths(project) == ["Sources/file.m", "file.m"]
+
+
+def test_default_target_selection_uses_leaf_name_to_skip_only_duplicate_targets(tmp_path):
+
+
+
+
+    project = _load_project(tmp_path)
+
+    created = project.add_file("file.m", force=False)
+
+    assert [build_file.isa for build_file in created] == ["PBXBuildFile"]
+    assert [project.get_object(build_file.fileRef).path for build_file in created] == ["file.m"]
+    assert _section_count(project, "PBXFileReference") == 2
+    assert _section_count(project, "PBXBuildFile") == 2
+    assert _target_source_paths(project, "app") == ["Sources/file.m"]
+    assert _target_source_paths(project, "report") == ["file.m"]
+
+
+def test_loaded_project_session_supports_duplicate_safe_add_file(tmp_path):
+
+
+
+
+    project = _load_project(tmp_path)
+
+
+    created = project.add_file("file.m", target_name="app", force=False)
+
+    assert created == []
+    assert _section_count(project, "PBXFileReference") == 1
+    assert _section_count(project, "PBXBuildFile") == 1
+    assert _target_source_paths(project, "app") == ["Sources/file.m"]
+
+
+def test_duplicate_tracking_is_independent_per_loaded_project_instance(tmp_path):
+
+
+
+
+    first = _load_project(tmp_path / "first")
+    second = _load_project(tmp_path / "second")
+
+    first_created = first.add_file("file.m", target_name=["app", "report"], force=False)
+
+    assert [build_file.isa for build_file in first_created] == ["PBXBuildFile"]
+    assert _section_count(first, "PBXFileReference") == 2
+    assert _section_count(first, "PBXBuildFile") == 2
+    assert _target_source_paths(first, "app") == ["Sources/file.m"]
+    assert _target_source_paths(first, "report") == ["file.m"]
+    assert _section_count(second, "PBXFileReference") == 1
+    assert _section_count(second, "PBXBuildFile") == 1
+    assert _target_source_paths(second, "app") == ["Sources/file.m"]
+    assert _target_source_paths(second, "report") == []
+
+
+def test_repeated_loaded_project_sessions_keep_duplicate_filtering_local(tmp_path):
+
+
+
+
+    for index in range(20):
+        project = _load_project(tmp_path / f"cycle-{index}")
+
+
+        created = project.add_file("file.m", target_name=["app", "report"], force=False)
+
+        assert [build_file.isa for build_file in created] == ["PBXBuildFile"]
+        assert _section_count(project, "PBXBuildFile") == 2
+        assert _target_source_paths(project, "app") == ["Sources/file.m"]
+        assert _target_source_paths(project, "report") == ["file.m"]
