diff --git a/test/test.disallow-mixed-spaces-and-tabs.js b/test/test.disallow-mixed-spaces-and-tabs.js
new file mode 100644
index 000000000..111111111
--- /dev/null
+++ b/test/test.disallow-mixed-spaces-and-tabs.js
@@ -0,0 +1,111 @@
+var Checker = require('../lib/checker');
+var assert = require('assert');
+
+
+
+var MIXED_MESSAGE = 'Mixed spaces and tabs found';
+var CONFIG_MESSAGE = 'disallowMixedSpacesAndTabs option requires true or "smart" value';
+
+function createChecker(optionValue) {
+    var checker = new Checker();
+    checker.registerDefaultRules();
+    checker.configure({ disallowMixedSpacesAndTabs: optionValue });
+    return checker;
+}
+
+function getMessages(result) {
+    return result.getErrorList().map(function(error) {
+        return error.message;
+    });
+}
+
+function assertMixedErrors(result, expectedCount) {
+    assert.strictEqual(result.getErrorCount(), expectedCount);
+    getMessages(result).forEach(function(message) {
+        assert.strictEqual(message, MIXED_MESSAGE);
+    });
+}
+
+function assertNoErrors(result) {
+    assert(result.isEmpty());
+}
+
+function assertInvalidOption(optionValue) {
+    var checker = new Checker();
+    checker.registerDefaultRules();
+
+    try {
+        checker.configure({ disallowMixedSpacesAndTabs: optionValue });
+    } catch (error) {
+        assert.strictEqual(error.message, CONFIG_MESSAGE);
+        return;
+    }
+
+    assert(false, 'Expected invalid disallowMixedSpacesAndTabs option to throw');
+}
+
+describe('disallowMixedSpacesAndTabs', function() {
+    describe('configuration', function() {
+        it('accepts configured rule and reports through default checker', function() {
+            var checker = createChecker(true);
+            var result = checker.checkString('var ok;\n  \tvar mixed;');
+
+            assertMixedErrors(result, 1);
+        });
+
+        it('rejects unsupported option values', function() {
+            [false, 'strict', 1, null].forEach(assertInvalidOption);
+        });
+    });
+
+    describe('option value true', function() {
+        var checker;
+
+        beforeEach(function() {
+            checker = createChecker(true);
+        });
+
+        it('rejects both adjacent orders and non-leading mixed whitespace', function() {
+            assertMixedErrors(checker.checkString('  \tvar x;'), 1);
+            assertMixedErrors(checker.checkString('\t  var y;'), 1);
+            assertMixedErrors(checker.checkString('if (x) {\nvar z; \t\n}'), 1);
+            assertMixedErrors(checker.checkString('\t  \tvar nested;'), 1);
+        });
+
+        it('allows pure tab and pure space indentation', function() {
+            assertNoErrors(checker.checkString('\t\tvar x;'));
+            assertNoErrors(checker.checkString('    var y;'));
+        });
+    });
+
+    describe('option value "smart"', function() {
+        var checker;
+
+        beforeEach(function() {
+            checker = createChecker('smart');
+        });
+
+        it('rejects spaces before tabs in leading and non-leading positions', function() {
+            assertMixedErrors(checker.checkString('  \tvar x;'), 1);
+            assertMixedErrors(checker.checkString('if (x) {\nvar y; \t\n}'), 1);
+            assertMixedErrors(checker.checkString('\t  \tvar z;'), 1);
+        });
+
+        it('allows tabs before spaces for alignment', function() {
+            assertNoErrors(checker.checkString('\t  var aligned;'));
+            assertNoErrors(checker.checkString('if (x) {\n\t    call();\n}'));
+        });
+    });
+
+    describe('docblock alignment', function() {
+        var docblock = 'var x;\n\t/**\n\t * aligned text\n\t */\nvar y;';
+
+        it('allows star alignment when strict mode is enabled', function() {
+            assertNoErrors(createChecker(true).checkString(docblock));
+        });
+
+        it('allows star alignment when smart mode is enabled', function() {
+            assertNoErrors(createChecker('smart').checkString(docblock));
+        });
+    });
+});
