+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+npm install --no-audit --no-fund 2>&1
+
+
+case "${1:-}" in
+  base)
+    node ./node_modules/.bin/_mocha -u bdd -R spec test/test.disallow-trailing-whitespace.js
+    ;;
+  new)
+    node ./node_modules/.bin/_mocha -u bdd -R spec test/test.disallow-mixed-spaces-and-tabs.js
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
