diff --git a/test/test_pin_increments.py b/test/test_pin_increments.py
new file mode 100644
index 0000000..b9e4d0e
--- /dev/null
+++ b/test/test_pin_increments.py
@@ -0,0 +1,220 @@
+# -*- coding: utf-8 -*-
+
+
+
+
+
+
+
+
+
+
+
+from __future__ import absolute_import
+from __future__ import unicode_literals
+
+import os
+import datetime as dt
+
+import pytest
+from click.testing import CliRunner
+
+from bumpver import cli
+from bumpver import v2version
+
+
+ENV = {
+    'GIT_AUTHOR_NAME'    : "bumpver_tester",
+    'GIT_COMMITTER_NAME' : "bumpver_tester",
+    'GIT_AUTHOR_EMAIL'   : "bumpver_tester@nowhere.com",
+    'GIT_COMMITTER_EMAIL': "bumpver_tester@nowhere.com",
+    'HGUSER'             : "bumpver_tester",
+    'PATH'               : os.environ['PATH'],
+}
+
+
+
+
+
+
+PINNED_DATE = dt.date(2022, 11, 5)
+
+
+def test_v2_incr_pin_increments_with_patch():
+
+
+
+
+
+    new_version = v2version.incr(
+        "2022.11.2",
+        "YYYY.MM.INC1[-PATCH]",
+        patch=True,
+        pin_date=True,
+        pin_increments=True,
+        maybe_date=PINNED_DATE,
+    )
+    assert new_version == "2022.11.2-1"
+
+
+def test_v2_incr_pin_increments_existing_patch():
+
+    new_version = v2version.incr(
+        "2022.11.2-1",
+        "YYYY.MM.INC1[-PATCH]",
+        patch=True,
+        pin_date=True,
+        pin_increments=True,
+        maybe_date=PINNED_DATE,
+    )
+    assert new_version == "2022.11.2-2"
+
+
+def test_v2_incr_default_without_pin_increments_unchanged():
+
+
+
+
+
+    new_version = v2version.incr(
+        "2022.11.2",
+        "YYYY.MM.INC1[-PATCH]",
+        patch=True,
+        pin_date=True,
+        maybe_date=PINNED_DATE,
+    )
+    assert new_version == "2022.11.3"
+
+
+def test_v2_incr_pin_increments_with_inc0():
+
+    new_version = v2version.incr(
+        "2022.11.0",
+        "YYYY.MM.INC0[-PATCH]",
+        patch=True,
+        pin_date=True,
+        pin_increments=True,
+        maybe_date=PINNED_DATE,
+    )
+    assert new_version == "2022.11.0-1"
+
+
+def test_v2_incr_inc0_default_increments():
+
+    new_version = v2version.incr(
+        "2022.11.0",
+        "YYYY.MM.INC0[-PATCH]",
+        patch=True,
+        pin_date=True,
+        maybe_date=PINNED_DATE,
+    )
+    assert new_version == "2022.11.1"
+
+
+def test_v2_incr_pin_increments_no_bump_returns_none():
+
+    new_version = v2version.incr(
+        "2022.11.2",
+        "YYYY.MM.INC1[-PATCH]",
+        pin_date=True,
+        pin_increments=True,
+        maybe_date=PINNED_DATE,
+    )
+    assert new_version is None
+
+
+def test_v2_incr_pin_increments_semver_unchanged():
+
+
+
+    pinned = v2version.incr(
+        "0.1.4b1",
+        "MAJOR.MINOR.PATCH[PYTAGNUM]",
+        patch=True,
+        pin_increments=True,
+    )
+    default = v2version.incr(
+        "0.1.4b1",
+        "MAJOR.MINOR.PATCH[PYTAGNUM]",
+        patch=True,
+    )
+    assert pinned == "0.1.5b0"
+    assert default == "0.1.5b0"
+
+
+
+
+
+
+
+@pytest.fixture
+def runner(tmpdir):
+    r = CliRunner(env=ENV)
+    orig_cwd = os.getcwd()
+    os.chdir(str(tmpdir))
+    yield r
+    os.chdir(orig_cwd)
+
+
+def test_cli_pin_increments_flag_exists(runner):
+
+    result = runner.invoke(cli.cli, ['test', '--help'])
+    assert result.exit_code == 0
+    assert "--pin-increments" in result.output
+
+
+def test_cli_test_patch_pin_increments(runner):
+
+    result = runner.invoke(
+        cli.cli,
+        [
+            'test',
+            '--pin-date',
+            '--pin-increments',
+            '--patch',
+            '-vv',
+            '2022.11.2',
+            'YYYY.MM.INC1[-PATCH]',
+        ],
+    )
+    assert result.exit_code == 0
+    assert "New Version: 2022.11.2-1" in result.output
+
+
+def test_cli_test_patch_without_pin_increments_default(runner):
+
+
+
+
+    result = runner.invoke(
+        cli.cli,
+        [
+            'test',
+            '--pin-date',
+            '--patch',
+            '-vv',
+            '2022.11.2',
+            'YYYY.MM.INC1[-PATCH]',
+        ],
+    )
+    assert result.exit_code == 0
+    assert "New Version: 2022.11.3" in result.output
+    assert "2022.11.2-1" not in result.output
+
+
+def test_cli_test_patch_pin_increments_existing_patch(runner):
+
+    result = runner.invoke(
+        cli.cli,
+        [
+            'test',
+            '--pin-date',
+            '--pin-increments',
+            '--patch',
+            '-vv',
+            '2022.11.2-1',
+            'YYYY.MM.INC1[-PATCH]',
+        ],
+    )
+    assert result.exit_code == 0
+    assert "New Version: 2022.11.2-2" in result.output
