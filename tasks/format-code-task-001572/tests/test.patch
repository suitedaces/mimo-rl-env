@@ -0,0 +1,144 @@
+const DeploymentList = require('../../lib/messages/deployment-list');
+
+const baseDeployment = () => ({
+  creator: {
+    login: 'gimenete',
+    url: 'https://github.com/gimenete',
+    avatarUrl: 'https://avatars.githubusercontent.com/u/123?v=4',
+  },
+  ref: { name: 'foobar' },
+  commit: {
+    message: 'Initial commit',
+    abbreviatedOid: 'c877632',
+    commitUrl: 'https://github.com/Test-slack-github/test2/commit/c877632',
+  },
+  description: null,
+  task: 'deploy',
+  environment: 'production',
+  state: 'ACTIVE',
+  createdAt: '2018-09-20T14:35:25Z',
+  latestStatus: null,
+});
+
+describe('DeploymentList', () => {
+  test('renders one attachment per deployment, in order', () => {
+    const deployments = [
+      { ...baseDeployment(), ref: { name: 'a' } },
+      { ...baseDeployment(), ref: { name: 'b' } },
+      { ...baseDeployment(), ref: { name: 'c' } },
+    ];
+    const { attachments } = new DeploymentList(deployments).toJSON();
+    expect(attachments).toHaveLength(3);
+    expect(attachments.map(a => a.title_link)).toBeDefined();
+    expect(attachments.map(a => a.fallback)).toEqual([
+      'gimenete triggered a deploy on production from a',
+      'gimenete triggered a deploy on production from b',
+      'gimenete triggered a deploy on production from c',
+    ]);
+  });
+
+  test('renders an empty attachments array for no deployments', () => {
+    expect(new DeploymentList([]).toJSON()).toEqual({ attachments: [] });
+  });
+
+  test('builds the attachment from the deployment fields', () => {
+    const deployment = {
+      ...baseDeployment(),
+      description: 'Shipping the thing',
+      task: 'deploy:web',
+      environment: 'staging',
+      ref: { name: 'release-1.8' },
+      commit: {
+        message: 'Fix the bug',
+        abbreviatedOid: '07ba0b8',
+        commitUrl: 'https://github.com/owner/repo/commit/07ba0b8',
+      },
+      creator: {
+        login: 'octocat',
+        url: 'https://github.com/octocat',
+        avatarUrl: 'https://avatars.example/octocat.png',
+      },
+    };
+    const [attachment] = new DeploymentList([deployment]).toJSON().attachments;
+
+    expect(attachment.fallback).toEqual('octocat triggered a deploy:web on staging from release-1.8');
+    expect(attachment.pretext).toEqual('Shipping the thing');
+    expect(attachment.author_name).toEqual('octocat');
+    expect(attachment.author_link).toEqual('https://github.com/octocat');
+    expect(attachment.author_icon).toEqual('https://avatars.example/octocat.png');
+    expect(attachment.title).toEqual('release-1.8 Fix the bug');
+    expect(attachment.title_link).toEqual('https://github.com/owner/repo/commit/07ba0b8');
+    expect(attachment.footer).toEqual('Created');
+    expect(attachment.footer_icon).toEqual('https://assets-cdn.github.com/favicon.ico');
+  });
+
+  test('converts createdAt into unix seconds', () => {
+    const deployment = { ...baseDeployment(), createdAt: '2018-09-20T14:35:25Z' };
+    const [attachment] = new DeploymentList([deployment]).toJSON().attachments;
+    expect(attachment.ts).toEqual(new Date('2018-09-20T14:35:25Z').getTime() / 1000);
+  });
+
+  test('omits pretext when the description is empty', () => {
+    const deployment = { ...baseDeployment(), description: null };
+    const [attachment] = new DeploymentList([deployment]).toJSON().attachments;
+    expect(attachment.pretext == null || attachment.pretext === '').toBe(true);
+  });
+
+  test('includes Task, Environment and State short fields in order', () => {
+    const deployment = {
+      ...baseDeployment(),
+      task: 'deploy',
+      environment: 'production',
+      state: 'ACTIVE',
+      latestStatus: null,
+    };
+    const [attachment] = new DeploymentList([deployment]).toJSON().attachments;
+    expect(attachment.fields).toEqual([
+      { title: 'Task', value: 'deploy', short: true },
+      { title: 'Environment', value: 'production', short: true },
+      { title: 'State', value: 'ACTIVE', short: true },
+    ]);
+  });
+
+  test('appends a Latest Status field when latestStatus is present', () => {
+    const deployment = {
+      ...baseDeployment(),
+      latestStatus: { state: 'SUCCESS', description: 'Deployed!' },
+    };
+    const [attachment] = new DeploymentList([deployment]).toJSON().attachments;
+    expect(attachment.fields).toContainEqual({
+      title: 'Latest Status',
+      value: 'SUCCESS Deployed!',
+      short: true,
+    });
+
+    expect(attachment.fields[attachment.fields.length - 1]).toEqual({
+      title: 'Latest Status',
+      value: 'SUCCESS Deployed!',
+      short: true,
+    });
+  });
+
+  test('does not add a Latest Status field when latestStatus is null', () => {
+    const deployment = { ...baseDeployment(), latestStatus: null };
+    const [attachment] = new DeploymentList([deployment]).toJSON().attachments;
+    expect(attachment.fields.some(field => field.title === 'Latest Status')).toBe(false);
+  });
+
+  test('maps each deployment state to its color', () => {
+    const colorsByState = {
+      ABANDONED: '#24292f',
+      ACTIVE: '#36a64f',
+      DESTROYED: '#cb2431',
+      ERROR: '#cb2431',
+      FAILURE: '#cb2431',
+      INACTIVE: '#24292f',
+      PENDING: '#dbab09',
+    };
+    Object.keys(colorsByState).forEach((state) => {
+      const [attachment] = new DeploymentList([{ ...baseDeployment(), state }])
+        .toJSON().attachments;
+      expect(attachment.color).toEqual(colorsByState[state]);
+    });
+  });
+});
