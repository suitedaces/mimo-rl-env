@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+export GO111MODULE=off
+PKG_DIR="/root/go/src/github.com/centrifugal/centrifugo/libcentrifugo"
+
+
+if ! redis-cli ping >/dev/null 2>&1; then
+    redis-server --daemonize yes --save "" --appendonly no >/tmp/redis-grading.log 2>&1
+    for _ in $(seq 1 30); do
+        redis-cli ping >/dev/null 2>&1 && break
+        sleep 0.2
+    done
+fi
+redis-cli -n 9 flushdb >/dev/null 2>&1 || true
+
+cd "$PKG_DIR"
+
+
+go test -run 'TestRedisEngine$' -count=1 -v
+
+redis-cli -n 9 flushdb >/dev/null 2>&1 || true
+
+
+go test -run 'TestRedisEngineConcurrent' -count=1 -v
