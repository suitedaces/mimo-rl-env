diff --git a/src/functions.feature.test.js b/src/functions.feature.test.js
new file mode 100644
index 0000000..8b07f89
--- /dev/null
+++ b/src/functions.feature.test.js
@@ -0,0 +1,126 @@
+import { call } from 'redux-saga/effects'
+import 'whatwg-fetch'
+
+import ReduxSagaFirebase from './index'
+
+describe('functions HTTP invocation extensions', () => {
+  const rsf = new ReduxSagaFirebase({
+    options: { authDomain: 'demo-project.firebaseapp.com' }
+  })
+  rsf.region = 'europe-west1'
+
+  afterEach(() => {
+    expect.hasAssertions()
+  })
+
+  it('encodes function query keys and values without changing insertion order', () => {
+    const iterator = rsf.functions.call('lookup', {
+      'user name': 'Ada/Lovelace',
+      filter: 'a&b'
+    })
+
+    expect(iterator.next().value).toEqual(call(
+      fetch,
+      'https://europe-west1-demo-project.cloudfunctions.net/lookup?user%20name=Ada%2FLovelace&filter=a%26b'
+    ))
+  })
+
+  it('keeps the legacy GET effect shape and parses JSON media types with parameters', () => {
+    const iterator = rsf.functions.call('lookup', { q: 'safe' })
+    const request = iterator.next().value
+
+    expect(request).toEqual(call(
+      fetch,
+      'https://europe-west1-demo-project.cloudfunctions.net/lookup?q=safe'
+    ))
+
+    const response = {
+      ok: true,
+      headers: { get: jest.fn(() => 'Application/JSON; charset=utf-8') },
+      json: jest.fn()
+    }
+    expect(iterator.next(response).value).toEqual(call([response, response.json]))
+    expect(iterator.next({ found: true })).toEqual({
+      done: true,
+      value: { found: true }
+    })
+  })
+
+  it('supports POST JSON requests and supplies a default content type', () => {
+    const iterator = rsf.functions.call(
+      'create',
+      { name: 'Ada', active: true },
+      { method: 'POST', headers: { Authorization: 'Bearer token' } }
+    )
+    const request = iterator.next().value
+
+    expect(request).toEqual(call(
+      fetch,
+      'https://europe-west1-demo-project.cloudfunctions.net/create',
+      {
+        method: 'POST',
+        headers: {
+          Authorization: 'Bearer token',
+          'Content-Type': 'application/json'
+        },
+        body: '{"name":"Ada","active":true}'
+      }
+    ))
+  })
+
+  it('preserves an explicitly supplied content type for POST requests', () => {
+    const iterator = rsf.functions.call(
+      'create',
+      { name: 'Ada' },
+      { method: 'POST', headers: { 'content-type': 'application/vnd.api+json' } }
+    )
+
+    expect(iterator.next().value).toEqual(call(
+      fetch,
+      'https://europe-west1-demo-project.cloudfunctions.net/create',
+      {
+        method: 'POST',
+        headers: { 'content-type': 'application/vnd.api+json' },
+        body: '{"name":"Ada"}'
+      }
+    ))
+  })
+
+  it('parses +json responses through json()', () => {
+    const iterator = rsf.functions.call('lookup')
+    iterator.next()
+    const response = {
+      ok: true,
+      headers: { get: jest.fn(() => 'application/problem+json') },
+      json: jest.fn()
+    }
+    expect(iterator.next(response).value).toEqual(call([response, response.json]))
+  })
+
+  it('falls back to text when a successful response has no content type', () => {
+    const iterator = rsf.functions.call('lookup')
+    iterator.next()
+    const response = {
+      ok: true,
+      headers: { get: jest.fn(() => null) },
+      text: jest.fn()
+    }
+    expect(iterator.next(response).value).toEqual(call([response, response.text]))
+  })
+
+  it('throws the non-ok response before attempting to decode it', () => {
+    const iterator = rsf.functions.call('lookup')
+    iterator.next()
+    const response = { ok: false, headers: { get: jest.fn() }, json: jest.fn() }
+
+    let thrown
+    try {
+      iterator.next(response)
+    } catch (error) {
+      thrown = error
+    }
+    expect(thrown).toBe(response)
+    expect(response.headers.get).not.toHaveBeenCalled()
+    expect(response.json).not.toHaveBeenCalled()
+  })
+})
