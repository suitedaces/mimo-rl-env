diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,46 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+setup_env() {
+
+  set +u
+  dev-switch python3 3.12
+  dev-switch node 20
+  set -u
+
+  cp secret.config.json.example secret.config.json
+
+  if [ ! -d node_modules ]; then
+    CYPRESS_INSTALL_BINARY=0 npm install --legacy-peer-deps --ignore-scripts
+  fi
+
+}
+
+run_jest() {
+  NODE_OPTIONS=--max-old-space-size=6144 npx jest --runInBand --no-coverage "$@"
+}
+
+NEW_TEST_NAMES="returns_only_projects_for_authenticated_account_when_visible_username_is_shared|deletes_visible_project_for_authenticated_account_with_shared_username|closes_share_popover_when_clicking_outside|renders_contact_information_page_heading|renders_edit_profile_as_external_link_button|contact_info_form_does_not_add_inner_padding"
+ORIGINAL_TEST_PATHS="serverless/src/getProjects/__tests__/handler.test.js|serverless/src/deleteProject/__tests__/handler.test.js|static/src/js/components/SavedProjects/__tests__/SavedProjects.test.js|static/src/js/components/ContactInfo/__tests__/ContactInfo.test.js"
+NEW_TEST_PATHS="${ORIGINAL_TEST_PATHS}|static/src/js/components/ContactInfo/__tests__/ContactInfo.styles.test.js"
+
+case "${1:-}" in
+  base)
+    setup_env
+    run_jest \
+      --testPathPattern="${ORIGINAL_TEST_PATHS}" \
+      --testNamePattern="^(?!.*(${NEW_TEST_NAMES})).*$"
+    ;;
+  new)
+    setup_env
+    run_jest \
+      --testPathPattern="${NEW_TEST_PATHS}" \
+      --testNamePattern="(${NEW_TEST_NAMES})"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
