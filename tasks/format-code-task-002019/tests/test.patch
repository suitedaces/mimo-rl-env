--- /dev/null
+++ b/static/src/js/components/ContactInfo/__tests__/ContactInfo.styles.test.js
@@ -0,0 +1,21 @@
+import fs from 'fs'
+import path from 'path'
+
+describe('ContactInfo styles', () => {
+  test('contact_info_form_does_not_add_inner_padding', () => {
+    const scss = fs.readFileSync(
+      path.join(__dirname, '../ContactInfo.scss'),
+      'utf8'
+    )
+
+
+    const contactInfoFormRule = scss.match(/\.contact-info-form\s*\{[^}]*\}/s)
+    const paddingDeclarations = Array.from(
+      contactInfoFormRule ? contactInfoFormRule[0].matchAll(/padding\s*:\s*([^;]+);/g) : []
+    ).map((match) => match[1].trim())
+
+    expect(contactInfoFormRule).not.toBeNull()
+    expect(paddingDeclarations).not.toContain('30px')
+    expect(paddingDeclarations.every((value) => /^(0|0px|0rem)$/.test(value))).toEqual(true)
+  })
+})
