diff --git a/test/rules/std_AL01_test.py b/test/rules/std_AL01_test.py
new file mode 100644
index 000000000..5f99588ab
--- /dev/null
+++ b/test/rules/std_AL01_test.py
@@ -0,0 +1,100 @@
+
+
+
+
+
+
+
+
+from sqlfluff.core import FluffConfig, Linter
+
+
+def _lint(sql, dialect="oracle", rules="AL01,AL02", configs=None):
+    if configs is None:
+        configs = {}
+    cfg = FluffConfig(
+        configs=configs, overrides={"dialect": dialect, "rules": rules}
+    )
+    res = Linter(config=cfg).lint_string(sql)
+    return [v.rule_code() for v in res.violations]
+
+
+def test_oracle_table_alias_implicit_no_violation():
+
+    sql = (
+        "SELECT\n"
+        "    base.id,\n"
+        "    base.customer_id\n"
+        "FROM customers base"
+    )
+    codes = _lint(sql, dialect="oracle", rules="AL01")
+    assert "AL01" not in codes, f"Unexpected AL01 violation for Oracle: {codes}"
+
+
+def test_oracle_table_alias_implicit_simple_no_violation():
+
+    codes = _lint("SELECT a.b FROM tbl a", dialect="oracle", rules="AL01")
+    assert "AL01" not in codes
+
+
+def test_oracle_table_alias_with_as_no_violation_default_config():
+
+
+
+
+
+
+    codes = _lint(
+        "SELECT a.b FROM tbl AS a", dialect="oracle", rules="AL01"
+    )
+    assert "AL01" not in codes
+    assert "PRS" not in codes
+
+
+def test_oracle_table_alias_with_as_no_violation_implicit_config():
+
+
+
+
+
+
+    configs = {"rules": {"aliasing.table": {"aliasing": "implicit"}}}
+    codes = _lint(
+        "SELECT a.b FROM tbl AS a",
+        dialect="oracle",
+        rules="AL01",
+        configs=configs,
+    )
+    assert "AL01" not in codes
+    assert "PRS" not in codes
+
+
+def test_oracle_column_alias_without_as_still_flagged():
+
+
+
+
+
+
+    codes = _lint("SELECT a col1 FROM tbl", dialect="oracle", rules="AL02")
+    assert "AL02" in codes, f"Expected AL02 violation, got: {codes}"
+
+
+def test_oracle_column_alias_with_as_no_violation():
+
+    codes = _lint(
+        "SELECT a AS col1 FROM tbl", dialect="oracle", rules="AL02"
+    )
+    assert "AL02" not in codes
+
+
+def test_ansi_table_alias_without_as_still_flagged():
+
+    codes = _lint("SELECT a.b FROM tbl a", dialect="ansi", rules="AL01")
+    assert "AL01" in codes, f"Expected AL01 violation for ANSI, got: {codes}"
+
+
+def test_bigquery_table_alias_without_as_still_flagged():
+
+    codes = _lint("SELECT a.b FROM tbl a", dialect="bigquery", rules="AL01")
+    assert "AL01" in codes, f"Expected AL01 violation for BigQuery, got: {codes}"
