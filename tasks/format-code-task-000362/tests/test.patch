@@ -0,0 +1,196 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+
+( cd /workspace/repo && go build -mod=readonly -o /tmp/notesium-coderl . ) \
+    || { echo "FAIL: build" >&2; exit 1; }
+BIN=/tmp/notesium-coderl
+
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || exit 1
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+export NOTESIUM_DIR=/workspace/repo/usercase-test-coderl/fixtures
+
+assert_stdout() {
+    local label=$1
+    local expected=$2
+    if [ "$(cat out)" != "$expected" ]; then
+        printf 'FAIL: %s stdout mismatch\n--- expected ---\n%s\n--- actual ---\n%s\n' \
+            "$label" "$expected" "$(cat out)" >&2
+        exit 1
+    fi
+}
+
+assert_stdout_unordered() {
+    local label=$1
+    local expected=$2
+
+    if [ "$(printf '%s\n' "$expected" | sort)" != "$(sort out)" ]; then
+        printf 'FAIL: %s stdout line-set mismatch\n--- expected sorted ---\n%s\n--- actual sorted ---\n%s\n' \
+            "$label" "$(printf '%s\n' "$expected" | sort)" "$(sort out)" >&2
+        exit 1
+    fi
+}
+
+assert_no_stderr() {
+    local label=$1
+    [ ! -s err ] || fail "$label unexpected stderr: $(cat err)"
+}
+
+
+
+
+"$BIN" --help >out 2>err; ec=$?
+
+[ "$ec" -eq 0 ] || [ "$ec" -eq 1 ] || fail "F_usage exit $ec; want 0 or 1"
+grep -Eq '^[[:space:]]*lines([[:space:]]|$)' out \
+    || fail "F_usage missing lines command"
+grep -Fq -- "--color" out \
+    || fail "F_usage missing --color"
+grep -Fq -- "--prefix=title" out \
+    || fail "F_usage missing --prefix=title"
+grep -Fq -- "--filter=QUERY" out \
+    || fail "F_usage missing --filter=QUERY"
+assert_no_stderr "F_usage"
+
+
+
+
+"$BIN" lines >out 2>err; ec=$?
+EXPECTED_DEFAULT='6421460b.md:1: # book
+6421460b.md:3: second nonblank
+64214930.md:1: # quantum mechanics
+64214930.md:3: a fundamental theory in physics that provides a description of the
+64214930.md:5: particles.
+64214930.md:6: The theory behind quantum mechanics is difficult.
+64214a1d.md:1: # richard feynman
+64214a1d.md:3: richard phillips feynman was an american theoretical [physicist](642146c7.md),
+64214a1d.md:5: [quantum mechanics](64214930.md), the theory of quantum electrodynamics,
+64218088.md:1: # albert einstein
+64218088.md:3: albert einstein was a german-born theoretical [physicist](642146c7.md),
+64218088.md:5: physicists of all time. einstein is best known for developing the
+64218088.md:6: to the development of the theory of [quantum mechanics](64214930.md).'
+[ "$ec" -eq 0 ] || fail "F_default exit $ec; want 0"
+assert_stdout_unordered "F_default" "$EXPECTED_DEFAULT"
+assert_no_stderr "F_default"
+
+
+
+
+"$BIN" lines --prefix=title >out 2>err; ec=$?
+EXPECTED_PREFIX='6421460b.md:1: book # book
+6421460b.md:3: book second nonblank
+64214930.md:1: quantum mechanics # quantum mechanics
+64214930.md:3: quantum mechanics a fundamental theory in physics that provides a description of the
+64214930.md:5: quantum mechanics particles.
+64214930.md:6: quantum mechanics The theory behind quantum mechanics is difficult.
+64214a1d.md:1: richard feynman # richard feynman
+64214a1d.md:3: richard feynman richard phillips feynman was an american theoretical [physicist](642146c7.md),
+64214a1d.md:5: richard feynman [quantum mechanics](64214930.md), the theory of quantum electrodynamics,
+64218088.md:1: albert einstein # albert einstein
+64218088.md:3: albert einstein albert einstein was a german-born theoretical [physicist](642146c7.md),
+64218088.md:5: albert einstein physicists of all time. einstein is best known for developing the
+64218088.md:6: albert einstein to the development of the theory of [quantum mechanics](64214930.md).'
+[ "$ec" -eq 0 ] || fail "F_prefix exit $ec; want 0"
+assert_stdout_unordered "F_prefix" "$EXPECTED_PREFIX"
+assert_no_stderr "F_prefix"
+
+
+
+
+"$BIN" lines --color --prefix=title --filter=book >out 2>err; ec=$?
+EXPECTED_COLOR=$'6421460b.md:1: \033[0;36mbook\033[0m # book'
+[ "$ec" -eq 0 ] || fail "F_color_prefix exit $ec; want 0"
+assert_stdout "F_color_prefix" "$EXPECTED_COLOR"
+assert_no_stderr "F_color_prefix"
+
+
+
+
+"$BIN" lines --filter=Einstein >out 2>err; ec=$?
+EXPECTED_CASE='64218088.md:1: # albert einstein
+64218088.md:3: albert einstein was a german-born theoretical [physicist](642146c7.md),
+64218088.md:5: physicists of all time. einstein is best known for developing the'
+[ "$ec" -eq 0 ] || fail "F_filter_case exit $ec; want 0"
+assert_stdout_unordered "F_filter_case" "$EXPECTED_CASE"
+assert_no_stderr "F_filter_case"
+
+
+
+
+"$BIN" lines "--filter=einstein albert" >out 2>err; ec=$?
+EXPECTED_AND='64218088.md:1: # albert einstein
+64218088.md:3: albert einstein was a german-born theoretical [physicist](642146c7.md),'
+[ "$ec" -eq 0 ] || fail "F_filter_and exit $ec; want 0"
+assert_stdout_unordered "F_filter_and" "$EXPECTED_AND"
+assert_no_stderr "F_filter_and"
+
+
+
+
+"$BIN" lines "--filter=american|german" >out 2>err; ec=$?
+EXPECTED_OR='64214a1d.md:3: richard phillips feynman was an american theoretical [physicist](642146c7.md),
+64218088.md:3: albert einstein was a german-born theoretical [physicist](642146c7.md),'
+[ "$ec" -eq 0 ] || fail "F_filter_or exit $ec; want 0"
+assert_stdout_unordered "F_filter_or" "$EXPECTED_OR"
+assert_no_stderr "F_filter_or"
+
+
+
+
+"$BIN" lines "--filter=einstein !physicist" >out 2>err; ec=$?
+EXPECTED_NOT='64218088.md:1: # albert einstein'
+[ "$ec" -eq 0 ] || fail "F_filter_not exit $ec; want 0"
+assert_stdout "F_filter_not" "$EXPECTED_NOT"
+assert_no_stderr "F_filter_not"
+
+
+
+
+"$BIN" lines "--filter=\"theory of quantum\"" >out 2>err; ec=$?
+EXPECTED_DQUOTE='64214a1d.md:5: [quantum mechanics](64214930.md), the theory of quantum electrodynamics,'
+[ "$ec" -eq 0 ] || fail "F_filter_double_quote exit $ec; want 0"
+assert_stdout "F_filter_double_quote" "$EXPECTED_DQUOTE"
+assert_no_stderr "F_filter_double_quote"
+
+
+
+
+"$BIN" lines "--filter='german-born theoretical'" >out 2>err; ec=$?
+EXPECTED_SQUOTE='64218088.md:3: albert einstein was a german-born theoretical [physicist](642146c7.md),'
+[ "$ec" -eq 0 ] || fail "F_filter_single_quote exit $ec; want 0"
+assert_stdout "F_filter_single_quote" "$EXPECTED_SQUOTE"
+assert_no_stderr "F_filter_single_quote"
+
+
+
+
+"$BIN" lines "--filter=theory|model quantum !development" --prefix=title >out 2>err; ec=$?
+EXPECTED_FILTER_PREFIX='64214930.md:6: quantum mechanics The theory behind quantum mechanics is difficult.
+64214a1d.md:5: richard feynman [quantum mechanics](64214930.md), the theory of quantum electrodynamics,'
+[ "$ec" -eq 0 ] || fail "F_filter_prefix exit $ec; want 0"
+assert_stdout_unordered "F_filter_prefix" "$EXPECTED_FILTER_PREFIX"
+assert_no_stderr "F_filter_prefix"
+
+
+
+
+"$BIN" lines --filter=zzzznomatch >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_no_match exit $ec; want 0"
+[ ! -s out ] || fail "F_no_match stdout should be empty: $(cat out)"
+assert_no_stderr "F_no_match"
+
+
+
+
+"$BIN" lines --bogus >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F_unknown_option exit $ec; want non-zero"
+
+grep -q "unrecognized option: --bogus" err \
+    || fail "F_unknown_option stderr missing message: $(cat err)"
+
+echo "PASS"
+exit 0
