@@ -0,0 +1,27 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="/testbed"
+
+
+
+case "${1:-}" in
+  base)
+    python3 - <<'PY'
+import sys
+sys.path.insert(0, "/testbed")
+import ssg.jinja
+print("base smoke: ssg.jinja import ok")
+PY
+    ;;
+  new)
+    python3 /testbed/tests/test_file_owner_uid_or_name_behavior.py
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
