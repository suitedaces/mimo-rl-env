+import os
+
+import numpy as np
+import pytest
+from mmengine.registry import init_default_scope
+
+from mmselfsup.datasets import DATASETS, ImageList, build_dataset
+
+
+FIXTURES = "/workspace/repo/usercase-test-coderl/fixtures"
+IMAGE_PREFIX = "/workspace/repo/usercase-test-coderl/fixtures/images"
+UNLABELED_ANN = "/workspace/repo/usercase-test-coderl/fixtures/imagelist_unlabeled.txt"
+LABELED_ANN = "/workspace/repo/usercase-test-coderl/fixtures/imagelist_labeled.txt"
+EXPECTED_EXTENSIONS = {".jpg", ".jpeg", ".png", ".ppm", ".bmp", ".pgm", ".tif"}
+REQUIRED_RECORD_FIELDS = {"img_prefix", "img_path", "img_info", "gt_label"}
+
+
+def _assert_gt_label(label, expected_value):
+    assert type(label).__name__ == "ndarray"
+    assert label.shape == ()
+    assert str(label.dtype) == "int64"
+    assert int(label) == expected_value
+    assert np.array_equal(label, np.array(expected_value, dtype=np.int64))
+
+
+def _assert_unlabeled_record(record, expected_index=None):
+
+
+    assert REQUIRED_RECORD_FIELDS.issubset(record)
+    assert record["img_prefix"] == IMAGE_PREFIX
+    assert record["img_path"] == os.path.join(IMAGE_PREFIX, f"folder_{expected_index + 1}/{'xxx.png' if expected_index == 0 else '123.png'}")
+    assert record["img_info"] == {"filename": "folder_1/xxx.png" if expected_index == 0 else "folder_2/123.png"}
+    _assert_gt_label(record["gt_label"], -1)
+
+
+def test_public_import_registry_config_and_extensions():
+
+
+
+
+    init_default_scope("mmselfsup")
+
+    assert ImageList.__name__ == "ImageList"
+    assert DATASETS.get("ImageList").__name__ == "ImageList"
+
+    dataset = build_dataset(
+        dict(
+            type="ImageList",
+            ann_file=LABELED_ANN,
+            data_prefix=IMAGE_PREFIX,
+            pipeline=[],
+        )
+    )
+
+    assert type(dataset).__name__ == "ImageList"
+    assert len(dataset) == 1
+
+
+    assert set(dataset.extensions) == EXPECTED_EXTENSIONS
+    record = dataset.get_data_info(0)
+    assert record["img_prefix"] == IMAGE_PREFIX
+    assert record["img_path"] == os.path.join(IMAGE_PREFIX, "folder_1/xxy.png")
+    assert record["img_info"] == {"filename": "folder_1/xxy.png"}
+    _assert_gt_label(record["gt_label"], 3)
+
+
+def test_unlabeled_two_line_file_len_and_load_data_list_records():
+
+
+
+
+    dataset = ImageList(
+        ann_file="imagelist_unlabeled.txt",
+        data_root=FIXTURES,
+        data_prefix="images",
+        pipeline=[],
+    )
+
+    assert len(dataset) == 2
+    records = dataset.load_data_list()
+    assert len(records) == 2
+    _assert_unlabeled_record(records[0], expected_index=0)
+    _assert_unlabeled_record(records[1], expected_index=1)
+
+
+def test_labeled_line_uses_second_column_as_int64_scalar_label():
+
+
+
+
+    dataset = ImageList(
+        ann_file=LABELED_ANN,
+        data_prefix=IMAGE_PREFIX,
+        pipeline=[],
+    )
+
+    assert len(dataset) == 1
+    record = dataset.get_data_info(0)
+    assert record["img_prefix"] == IMAGE_PREFIX
+    assert record["img_path"] == os.path.join(IMAGE_PREFIX, "folder_1/xxy.png")
+    assert record["img_info"] == {"filename": "folder_1/xxy.png"}
+
+
+    assert REQUIRED_RECORD_FIELDS.issubset(record)
+    _assert_gt_label(record["gt_label"], 3)
+
+
+def test_empty_ann_file_constructor_raises_assertion_error():
+
+
+
+
+    with pytest.raises(AssertionError):
+        ImageList(ann_file="", data_prefix=IMAGE_PREFIX, pipeline=[])
+
+
+def test_lazy_initialization_full_init_is_idempotent():
+
+
+
+
+    dataset = ImageList(
+        ann_file=UNLABELED_ANN,
+        data_prefix=IMAGE_PREFIX,
+        pipeline=[],
+        lazy_init=True,
+    )
+
+    dataset.full_init()
+    assert len(dataset) == 2
+    first = dataset.get_data_info(0)
+    assert first["img_path"] == os.path.join(IMAGE_PREFIX, "folder_1/xxx.png")
+    _assert_gt_label(first["gt_label"], -1)
+
+    dataset.full_init()
+    assert len(dataset) == 2
+    first_again = dataset.get_data_info(0)
+    assert first_again["img_path"] == os.path.join(IMAGE_PREFIX, "folder_1/xxx.png")
+    _assert_gt_label(first_again["gt_label"], -1)
+
+
+def test_two_instances_keep_independent_parsed_state():
+
+
+
+
+    unlabeled = ImageList(ann_file=UNLABELED_ANN, data_prefix=IMAGE_PREFIX, pipeline=[])
+    labeled = ImageList(ann_file=LABELED_ANN, data_prefix=IMAGE_PREFIX, pipeline=[])
+
+    refreshed_unlabeled = unlabeled.load_data_list()
+    assert len(refreshed_unlabeled) == 2
+    assert len(unlabeled) == 2
+    assert len(labeled) == 1
+    _assert_gt_label(unlabeled.get_data_info(0)["gt_label"], -1)
+    _assert_gt_label(labeled.get_data_info(0)["gt_label"], 3)
+    assert unlabeled.get_data_info(0)["img_info"] == {"filename": "folder_1/xxx.png"}
+    assert labeled.get_data_info(0)["img_info"] == {"filename": "folder_1/xxy.png"}
+
+
+def test_repeated_construct_use_delete_cycles_preserve_records():
+
+
+
+
+    for _ in range(25):
+        dataset = ImageList(ann_file=UNLABELED_ANN, data_prefix=IMAGE_PREFIX, pipeline=[])
+        records = dataset.load_data_list()
+        assert len(dataset) == 2
+        assert len(records) == 2
+
+
+        assert REQUIRED_RECORD_FIELDS.issubset(records[0])
+        assert records[0]["img_path"] == os.path.join(IMAGE_PREFIX, "folder_1/xxx.png")
+        assert records[0]["img_info"] == {"filename": "folder_1/xxx.png"}
+        _assert_gt_label(records[0]["gt_label"], -1)
+        del records
+        del dataset
