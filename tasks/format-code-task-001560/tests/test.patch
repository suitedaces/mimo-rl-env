+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+
+export npm_config_offline=true
+export npm_config_audit=false
+export npm_config_fund=false
+export NO_UPDATE_NOTIFIER=1
+
+test -d /workspace/repo/node_modules
+test -d /workspace/repo/packages/imba/node_modules
+test -f /workspace/repo/packages/imba/src/compiler/index.mjs
+
+exec node /workspace/repo/usercase-test-coderl/offline-vitest.mjs /workspace/repo/usercase-test-coderl/keyframes.test.js
