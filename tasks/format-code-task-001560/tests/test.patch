diff --git a/usercase-test-coderl/keyframes.test.js b/usercase-test-coderl/keyframes.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/keyframes.test.js
@@ -0,0 +1,240 @@
+import { execFileSync } from "node:child_process";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import http from "node:http";
+import https from "node:https";
+import net from "node:net";
+import os from "node:os";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+
+import { afterEach, describe, expect, test, vi } from "./offline-vitest.mjs";
+
+import { compile } from "../packages/imba/src/compiler/index.mjs";
+
+
+
+
+
+
+const BASE_OPTIONS = () => ({
+  sourcePath: "/tmp/example.imba",
+  sourceId: "example",
+});
+
+const cssText = (result) => {
+  if (typeof result.css === "string") return result.css;
+  return result.css.code;
+};
+
+const compileCss = (code, options = BASE_OPTIONS()) => cssText(compile(code, options));
+
+const GLOBAL_PERCENT_CODE = "global css @keyframes blink\n\t0% o:1\n\t100% o:0";
+const SCOPED_FROM_TO_CODE =
+  "css .test\n" +
+  "\t@keyframes blink\n" +
+  "\t\tfrom o:0\n" +
+  "\t\tto o:1\n" +
+  "\t.item\n" +
+  "\t\tanimation-name: blink";
+const GLOBAL_MULTI_STEP_CODE =
+  "global css @keyframes fade\n" +
+  "\tfrom o:0\n" +
+  "\t50% o:0.5\n" +
+  "\tto o:1";
+const SCOPED_PERCENT_CODE =
+  "css .card\n" +
+  "\t@keyframes pulse\n" +
+  "\t\t0% o:0.25\n" +
+  "\t\t100% o:0.75\n" +
+  "\t.badge\n" +
+  "\t\tanimation-name: pulse";
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+describe("Imba compile keyframes CSS output", () => {
+  test("global keyframes keep their name and render percent frames with opacity shorthand", () => {
+
+
+
+    assertKeyframes(compileCss(GLOBAL_PERCENT_CODE), "blink", [
+      ["0%", "1"],
+      ["100%", "0"],
+    ]);
+  });
+
+  test("scoped keyframes are renamed and nested animation-name resolves through owner variable", () => {
+
+
+
+    const css = compileCss(SCOPED_FROM_TO_CODE);
+    assertKeyframes(css, "blink-test", [
+      ["from", "0"],
+      ["to", "1"],
+    ]);
+    assertScopedAnimation(css, { owner: ".test", localName: "blink", scopedName: "blink-test" });
+  });
+
+  test("global keyframes render from, intermediate percent, and to frames with distinct opacity values", () => {
+
+
+
+    assertKeyframes(compileCss(GLOBAL_MULTI_STEP_CODE), "fade", [
+      ["from", "0"],
+      ["50%", "0.5"],
+      ["to", "1"],
+    ]);
+  });
+
+  test("a different scoped owner suffixes the keyframe and variable with that owner context", () => {
+
+
+
+    const css = compileCss(SCOPED_PERCENT_CODE);
+    assertKeyframes(css, "pulse-card", [
+      ["0%", "0.25"],
+      ["100%", "0.75"],
+    ]);
+    assertScopedAnimation(css, { owner: ".card", localName: "pulse", scopedName: "pulse-card" });
+  });
+
+  test("public compile result exposes css text for a valid string source", () => {
+
+    const result = compile(GLOBAL_PERCENT_CODE, BASE_OPTIONS());
+    assert.equal(typeof result, "object");
+    assert.equal(typeof cssText(result), "string");
+    assertKeyframes(cssText(result), "blink", [
+      ["0%", "1"],
+      ["100%", "0"],
+    ]);
+  });
+
+  test("same code and options produce the same css text repeatedly", () => {
+
+    const first = compileCss(SCOPED_FROM_TO_CODE, BASE_OPTIONS());
+    const second = compileCss(SCOPED_FROM_TO_CODE, BASE_OPTIONS());
+    expect(second).toBe(first);
+    assertScopedAnimation(first, { owner: ".test", localName: "blink", scopedName: "blink-test" });
+  });
+
+  test("compiling does not mutate the input string", () => {
+    const code = SCOPED_FROM_TO_CODE;
+    const before = `${code}`;
+
+
+    assertScopedAnimation(compileCss(code, BASE_OPTIONS()), {
+      owner: ".test",
+      localName: "blink",
+      scopedName: "blink-test",
+    });
+    expect(code).toBe(before);
+  });
+
+  test("fresh Node processes produce the same css for the same input", () => {
+    const inProcess = compileCss(GLOBAL_PERCENT_CODE, BASE_OPTIONS());
+    const script = `
+      import { compile } from ${JSON.stringify(pathToFileURL(path.join(process.cwd(), "packages/imba/src/compiler/index.mjs")).href)};
+      const result = compile(${JSON.stringify(GLOBAL_PERCENT_CODE)}, ${JSON.stringify(BASE_OPTIONS())});
+      const css = typeof result.css === "string" ? result.css : result.css.code;
+      process.stdout.write(JSON.stringify(css));
+    `;
+
+    const fromFreshProcess = JSON.parse(
+      execFileSync(process.execPath, ["--input-type=module", "-e", script], {
+        cwd: "/workspace/repo",
+        encoding: "utf8",
+      }),
+    );
+
+
+    expect(fromFreshProcess).toBe(inProcess);
+    assertKeyframes(fromFreshProcess, "blink", [
+      ["0%", "1"],
+      ["100%", "0"],
+    ]);
+  });
+
+  test("keyframe compilation does not write cwd files or perform network calls", () => {
+    const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), "imba-keyframes-"));
+    const previousCwd = process.cwd();
+    const before = snapshotFiles(tmpDir);
+
+    vi.spyOn(net.Socket.prototype, "connect").mockImplementation(() => {
+      throw new Error("unexpected network call");
+    });
+    vi.spyOn(http, "request").mockImplementation(() => {
+      throw new Error("unexpected http request");
+    });
+    vi.spyOn(https, "request").mockImplementation(() => {
+      throw new Error("unexpected https request");
+    });
+    vi.stubGlobal("fetch", () => {
+      throw new Error("unexpected fetch call");
+    });
+
+    try {
+      process.chdir(tmpDir);
+
+      assertScopedAnimation(compileCss(SCOPED_PERCENT_CODE, BASE_OPTIONS()), {
+        owner: ".card",
+        localName: "pulse",
+        scopedName: "pulse-card",
+      });
+      expect(snapshotFiles(tmpDir)).toEqual(before);
+    } finally {
+      process.chdir(previousCwd);
+      fs.rmSync(tmpDir, { recursive: true, force: true });
+    }
+  });
+});
+
+function snapshotFiles(root) {
+  const files = [];
+
+  const visit = (dir) => {
+    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+      const fullPath = path.join(dir, entry.name);
+      const relativePath = path.relative(root, fullPath);
+      if (entry.isDirectory()) {
+        files.push(`${relativePath}/`);
+        visit(fullPath);
+      } else {
+        files.push(relativePath);
+      }
+    }
+  };
+
+  visit(root);
+  return files.sort();
+}
+
+function assertKeyframes(css, name, frames) {
+  assert.equal(typeof css, "string");
+  assert.match(css, new RegExp(`@keyframes\\s+${escapeRegex(name)}\\s*\\{`));
+
+  for (const [label, opacity] of frames) {
+    assert.match(
+      css,
+      new RegExp(`${escapeRegex(label)}\\s*\\{[\\s\\S]*?opacity\\s*:\\s*${escapeRegex(opacity)}\\s*;`),
+    );
+  }
+}
+
+function assertScopedAnimation(css, { owner, localName, scopedName }) {
+  assertKeyframes(css, scopedName, []);
+  assert.match(
+    css,
+    new RegExp(`${escapeRegex(owner)}[^{}]*\\{[^{}]*--animation-${escapeRegex(localName)}\\s*:\\s*${escapeRegex(scopedName)}\\s*;`),
+  );
+  assert.match(
+    css,
+    new RegExp(`animation-name\\s*:\\s*var\\(\\s*--animation-${escapeRegex(localName)}\\s*,\\s*${escapeRegex(localName)}\\s*\\)`),
+  );
+}
+
+function escapeRegex(value) {
+  return String(value).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+}
diff --git a/usercase-test-coderl/offline-vitest.mjs b/usercase-test-coderl/offline-vitest.mjs
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/offline-vitest.mjs
@@ -0,0 +1,142 @@
+import assert from "node:assert/strict";
+import { pathToFileURL } from "node:url";
+
+const tests = [];
+const afterEachCallbacks = [];
+const spyRestores = [];
+const globalRestores = new Map();
+
+let currentSuite = [];
+
+export function describe(name, fn) {
+  currentSuite.push(name);
+  try {
+    fn();
+  } finally {
+    currentSuite.pop();
+  }
+}
+
+export function test(name, fn) {
+  tests.push({ name: [...currentSuite, name].join(" > "), fn });
+}
+
+export function afterEach(fn) {
+  afterEachCallbacks.push(fn);
+}
+
+export function expect(received) {
+  return {
+    toBe(expected) {
+      assert.strictEqual(received, expected);
+    },
+    toEqual(expected) {
+      assert.deepStrictEqual(received, expected);
+    },
+    toThrow(expected) {
+      assert.equal(typeof received, "function", "toThrow expects a function");
+      let thrown;
+      try {
+        received();
+      } catch (error) {
+        thrown = error;
+      }
+      assert.ok(thrown, "Expected function to throw");
+      if (expected) {
+        assert.ok(
+          thrown instanceof expected,
+          `Expected ${expected.name}, received ${thrown?.constructor?.name || typeof thrown}`,
+        );
+      }
+    },
+  };
+}
+
+export const vi = {
+  spyOn(target, property) {
+    const descriptor = Object.getOwnPropertyDescriptor(target, property);
+    const original = target[property];
+    const restore = () => {
+      if (descriptor) {
+        Object.defineProperty(target, property, descriptor);
+      } else {
+        target[property] = original;
+      }
+    };
+
+    const spy = {
+      mockImplementation(implementation) {
+        target[property] = function mockedMethod(...args) {
+          return implementation.apply(this, args);
+        };
+        return spy;
+      },
+    };
+
+    spyRestores.push(restore);
+    return spy;
+  },
+
+  restoreAllMocks() {
+    while (spyRestores.length) {
+      spyRestores.pop()();
+    }
+  },
+
+  stubGlobal(name, value) {
+    if (!globalRestores.has(name)) {
+      globalRestores.set(name, {
+        exists: Object.prototype.hasOwnProperty.call(globalThis, name),
+        value: globalThis[name],
+      });
+    }
+    globalThis[name] = value;
+  },
+
+  unstubAllGlobals() {
+    for (const [name, previous] of globalRestores) {
+      if (previous.exists) {
+        globalThis[name] = previous.value;
+      } else {
+        delete globalThis[name];
+      }
+    }
+    globalRestores.clear();
+  },
+};
+
+async function runCli() {
+  const file = process.argv[2];
+  if (!file) {
+    throw new Error("Usage: node offline-vitest.mjs <test-file>");
+  }
+
+  await import(pathToFileURL(file).href);
+
+  let failures = 0;
+  for (const entry of tests) {
+    try {
+      await entry.fn();
+      console.log(`ok ${entry.name}`);
+    } catch (error) {
+      failures++;
+      console.error(`not ok ${entry.name}`);
+      console.error(error?.stack || error);
+    } finally {
+      for (const callback of afterEachCallbacks) {
+        await callback();
+      }
+    }
+  }
+
+  if (failures) {
+    process.exitCode = 1;
+  }
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  runCli().catch((error) => {
+    console.error(error?.stack || error);
+    process.exitCode = 1;
+  });
+}
