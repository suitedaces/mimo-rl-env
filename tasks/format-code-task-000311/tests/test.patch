diff --git a/test/basic_test.py b/test/basic_test.py
index ce87b5f..f218941 100644
--- a/test/basic_test.py
+++ b/test/basic_test.py
@@ -56,3 +56,85 @@ def test_invert():
     x = load_sample()
     s = bct.invert(bct.threshold_proportional(x, .13))
     assert np.allclose(np.sum(s), 790.43107587)
+
+
+def test_autofix_issue_reproduction():
+    x = load_sample()
+    s = bct.autofix(bct.binarize(bct.threshold_proportional(x, .41)))
+    assert np.allclose(np.sum(s), 7752)
+
+
+def test_autofix_no_indexerror_on_large_matrix():
+    rng = np.random.RandomState(0)
+    w = rng.rand(50, 50)
+    w = (w + w.T) / 2
+    s = bct.autofix(w)
+    assert s.shape == (50, 50)
+    assert np.all(np.diag(s) == 0)
+
+
+def test_autofix_replaces_inf():
+    w = np.array([
+        [0.0, 0.5, 0.2],
+        [0.5, 0.0, np.inf],
+        [0.2, np.inf, 0.0],
+    ])
+    s = bct.autofix(w)
+    assert not np.any(np.isinf(s))
+    assert s[1, 2] == 0
+    assert s[2, 1] == 0
+    assert s[0, 1] == 0.5
+
+
+def test_autofix_replaces_nan():
+    w = np.array([
+        [0.0, 0.5, 0.2],
+        [0.5, 0.0, np.nan],
+        [0.2, np.nan, 0.0],
+    ])
+    s = bct.autofix(w)
+    assert not np.any(np.isnan(s))
+    assert s[1, 2] == 0
+    assert s[2, 1] == 0
+    assert s[0, 1] == 0.5
+
+
+def test_autofix_replaces_inf_and_nan_mixed():
+    w = np.array([
+        [0.0, np.inf, 0.2, 0.3],
+        [np.inf, 0.0, np.nan, 0.4],
+        [0.2, np.nan, 0.0, -np.inf],
+        [0.3, 0.4, -np.inf, 0.0],
+    ])
+    s = bct.autofix(w)
+    assert not np.any(np.isinf(s))
+    assert not np.any(np.isnan(s))
+    assert s[0, 1] == 0
+    assert s[1, 2] == 0
+    assert s[2, 3] == 0
+    assert s[0, 2] == 0.2
+    assert s[0, 3] == 0.3
+    assert s[1, 3] == 0.4
+
+
+def test_autofix_binary_input_rounded():
+    w = np.array([
+        [1.0, 1.0, 0.0],
+        [1.0, 1.0, 1.0],
+        [0.0, 1.0, 1.0],
+    ])
+    s = bct.autofix(w)
+    assert s.shape == (3, 3)
+    assert np.all(np.diag(s) == 0)
+    assert np.sum(s) == 4
+
+
+def test_autofix_zeros_diagonal():
+    w = np.array([
+        [5.0, 0.5, 0.2],
+        [0.5, 7.0, 0.3],
+        [0.2, 0.3, 9.0],
+    ])
+    s = bct.autofix(w)
+    assert np.all(np.diag(s) == 0)
+    assert s[0, 1] == 0.5
