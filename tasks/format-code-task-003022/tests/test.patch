+class FakeDevice(Device):
+    def __new__(cls, label: str, role: str, ordinal: int) -> "FakeDevice":
+        return object.__new__(cls)
+
+    def __init__(self, label: str, role: str, ordinal: int) -> None:
+        self.label = label
+        self.role = role
+        self.ordinal = ordinal
+        self._mig_devices: list[FakeDevice] = []
+        self._processes: list[FakeGpuProcess] = []
+        self._ident = (label, role)
+        self._hash = None
+        self.processes_calls = 0
+
+    def __getnewargs__(self) -> tuple[str, str, int]:
+        return (self.label, self.role, self.ordinal)
+
+    def __repr__(self) -> str:
+        return f"FakeDevice({self.label!r})"
+
+    def mig_devices(self) -> list["FakeDevice"]:
+        return list(self._mig_devices)
+
+    def processes(self) -> dict[int, "FakeGpuProcess"]:
+        self.processes_calls += 1
+        return {process.pid: process for process in self._processes}
+
+    def as_snapshot(self) -> Snapshot:
+        return Snapshot(
+            self,
+            kind="device",
+            label=self.label,
+            role=self.role,
+            ordinal=self.ordinal,
+        )
+
+
+class FakeGpuProcess(GpuProcess):
+    def __new__(
+        cls,
+        pid: int,
+        device: FakeDevice,
+        tag: str,
+        sequence: int,
+        *,
+        disappearing: bool = False,
+    ) -> "FakeGpuProcess":
+        return object.__new__(cls)
+
+    def __init__(
+        self,
+        pid: int,
+        device: FakeDevice,
+        tag: str,
+        sequence: int,
+        *,
+        disappearing: bool = False,
+    ) -> None:
+        self._pid = pid
+        self._host = None
+        self._device = device
+        self.tag = tag
+        self.sequence = sequence
+        self.disappearing = disappearing
+        self._ident = (pid, device.label, tag)
+        self._hash = None
+
+    def __getnewargs_ex__(self) -> tuple[tuple[Any, ...], dict[str, Any]]:
+        return ((self.pid, self.device, self.tag, self.sequence), {"disappearing": self.disappearing})
+
+    def __repr__(self) -> str:
+        return f"FakeGpuProcess({self.pid!r}, {self.device.label!r})"
+
+    def as_snapshot(self, *, failsafe: bool = False) -> Snapshot:
+        if self.disappearing and not failsafe:
+            raise RuntimeError("process disappeared")
+        return Snapshot(
+            self,
+            kind="gpu_process",
+            pid=self.pid,
+            device=self.device.label,
+            tag=self.tag,
+            sequence=self.sequence,
+            failsafe=failsafe,
+            state="fallback" if self.disappearing else "live",
+        )
+
+
+def fake_process_take_snapshots(
+    cls: type[GpuProcess],
+    gpu_processes: list[FakeGpuProcess],
+    *,
+    failsafe: bool = False,
+) -> list[Snapshot]:
+    del cls
+    return [process.as_snapshot(failsafe=failsafe) for process in gpu_processes]
+
+
+def make_world(monkeypatch: pytest.MonkeyPatch) -> dict[str, Any]:
+    phys0 = FakeDevice("physical-0", "physical", 0)
+    mig0a = FakeDevice("mig-0a", "mig", 1)
+    mig0b = FakeDevice("mig-0b", "mig", 2)
+    phys1 = FakeDevice("physical-1", "physical", 3)
+    cuda0 = FakeDevice("cuda-0", "cuda", 10)
+    cuda1 = FakeDevice("cuda-1", "cuda", 11)
+
+    phys0._mig_devices = [mig0a, mig0b]
+    phys0._processes = [FakeGpuProcess(9000, phys0, "parent-only-not-leaf", 0)]
+    mig0a._processes = [FakeGpuProcess(1000, mig0a, "mig-a-train", 1)]
+    mig0b._processes = [FakeGpuProcess(1001, mig0b, "mig-b-eval", 2)]
+    phys1._processes = [FakeGpuProcess(1002, phys1, "phys1-render", 3)]
+    cuda0._processes = [
+        FakeGpuProcess(2000, cuda0, "cuda0-worker-a", 4),
+        FakeGpuProcess(2001, cuda0, "cuda0-worker-b", 5),
+    ]
+    cuda1._processes = [FakeGpuProcess(2002, cuda1, "cuda1-worker", 6)]
+
+    p0 = FakeGpuProcess(3000, cuda0, "explicit-0", 7)
+    p1 = FakeGpuProcess(3001, cuda0, "explicit-1", 8)
+    p2 = FakeGpuProcess(3002, cuda1, "explicit-2", 9)
+    gone = FakeGpuProcess(3003, cuda1, "explicit-gone", 12, disappearing=True)
+
+    monkeypatch.setattr(Device, "all", classmethod(lambda cls: [phys0, phys1]))
+    monkeypatch.setattr(GpuProcess, "take_snapshots", classmethod(fake_process_take_snapshots))
+
+    return {
+        "phys0": phys0,
+        "mig0a": mig0a,
+        "mig0b": mig0b,
+        "phys1": phys1,
+        "cuda0": cuda0,
+        "cuda1": cuda1,
+        "p0": p0,
+        "p1": p1,
+        "p2": p2,
+        "gone": gone,
+    }
+
+
+def simplify(result: tuple[list[Snapshot], list[Snapshot]]) -> dict[str, Any]:
+    return {
+        "result_type": type(result).__name__,
+        "fields": list(result._fields),
+        "devices": [dict(snapshot) for snapshot in result.devices],
+        "gpu_processes": [dict(snapshot) for snapshot in result.gpu_processes],
+
+        "device_item_types": [
+            "LIVE_DEVICE" if isinstance(snapshot, Device) else "Snapshot"
+            for snapshot in result.devices
+        ],
+        "process_item_types": [
+            "LIVE_PROCESS" if isinstance(snapshot, GpuProcess) else "Snapshot"
+            for snapshot in result.gpu_processes
+        ],
+    }
+
