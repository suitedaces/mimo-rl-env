@@ -0,0 +1,45 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export PATH="/opt/node-24/bin:$PATH"
+
+yarn install --frozen-lockfile 2>/dev/null
+
+cat > src/environments/environment.ts << 'ENVEOF'
+import { WebUiEnvironment } from 'environments/environment.interface';
+import { MockEnclosureScenario } from 'app/core/testing/mock-enclosure/enums/mock-enclosure.enum';
+import { EnclosureModel } from 'app/enums/enclosure-model.enum';
+
+export const environment: WebUiEnvironment = {
+  environmentVersion: '0.0.3',
+  remote: 'localhost',
+  buildYear: 2024,
+  port: 4200,
+  production: false,
+  sentryPublicDsn: 'https://7ac3e76fe2a94f77a58e1c38ea6b42d9@sentry.ixsystems.com/4',
+  mockConfig: {
+    enabled: false,
+    controllerModel: EnclosureModel.M40,
+    expansionModels: [],
+    scenario: MockEnclosureScenario.FillSomeSlots,
+  },
+};
+ENVEOF
+
+SPEC="src/app/pages/data-protection/cloud-backup/cloud-backup-form/cloud-backup-form.component.spec.ts"
+OLD_TESTS="adds a new cloud backup task and creates a new bucket|adds a new cloud backup task when new form is saved|shows values for an existing cloud backup task when it is open for edit|saves updated cloud backup task when form opened for edit is saved"
+
+case "${1:-}" in
+  base)
+    npx jest --config jest.config.cjs --runTestsByPath "$SPEC" --testNamePattern "$OLD_TESTS"
+    ;;
+  new)
+    npx jest --config jest.config.cjs --runTestsByPath "$SPEC"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
