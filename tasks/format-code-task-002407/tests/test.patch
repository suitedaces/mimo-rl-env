     np.testing.assert_equal(df['x[1]'], resp.states[1])
 
 
+@pytest.fixture
+def labeled_mimo_sys():
+    A = np.array([[-1.0, 0.0], [1.0, -2.0]])
+    B = np.eye(2)
+    C = np.eye(2)
+    D = np.zeros((2, 2))
+    return ct.ss(
+        A, B, C, D, name="motor",
+        states=("Ia", "Wm"),
+        inputs=("Va", "Tl"),
+        outputs=("Ia", "Wm"),
+    )
+
+
+def test_forced_response_labels_preserved(labeled_mimo_sys):
+
+
+    sys = labeled_mimo_sys
+    T = np.linspace(0, 1, 50)
+    Va = np.ones_like(T) * 36
+    Tl = np.linspace(0, 15, len(T))
+    res = ct.forced_response(sys, T, U=[Va, Tl], X0=[0, 0])
+    assert list(res.output_labels) == ["Ia", "Wm"]
+    assert list(res.input_labels) == ["Va", "Tl"]
+    assert list(res.state_labels) == ["Ia", "Wm"]
+
+
+def test_input_output_response_labels_preserved(labeled_mimo_sys):
+    sys = labeled_mimo_sys
+    T = np.linspace(0, 1, 50)
+    Va = np.ones_like(T) * 36
+    Tl = np.linspace(0, 15, len(T))
+    res = ct.input_output_response(sys, T, U=[Va, Tl], X0=[0, 0])
+    assert list(res.output_labels) == ["Ia", "Wm"]
+    assert list(res.input_labels) == ["Va", "Tl"]
+    assert list(res.state_labels) == ["Ia", "Wm"]
+
+
+def test_step_response_labels_preserved(labeled_mimo_sys):
+    sys = labeled_mimo_sys
+    res = ct.step_response(sys)
+    assert list(res.output_labels) == ["Ia", "Wm"]
+    assert list(res.input_labels) == ["Va", "Tl"]
+    assert res.state_labels is not None
+    assert len(res.state_labels) == 2
+
+
+def test_step_response_input_selection_labels(labeled_mimo_sys):
+    sys = labeled_mimo_sys
+    res = ct.step_response(sys, input=0)
+
+    assert list(res.input_labels) == ["Va"]
+
+    assert list(res.output_labels) == ["Ia", "Wm"]
+
+
+def test_step_response_output_selection_labels(labeled_mimo_sys):
+    sys = labeled_mimo_sys
+    res = ct.step_response(sys, input=0, output=1)
+
+    assert list(res.input_labels) == ["Va"]
+    assert list(res.output_labels) == ["Wm"]
+
+
+def test_impulse_response_labels_preserved(labeled_mimo_sys):
+    sys = labeled_mimo_sys
+    res = ct.impulse_response(sys)
+    assert list(res.output_labels) == ["Ia", "Wm"]
+    assert list(res.input_labels) == ["Va", "Tl"]
+    assert res.state_labels is not None
+    assert len(res.state_labels) == 2
+
+
+def test_impulse_response_selection_labels(labeled_mimo_sys):
+    sys = labeled_mimo_sys
+    res = ct.impulse_response(sys, input=1, output=0)
+
+    assert list(res.input_labels) == ["Tl"]
+    assert list(res.output_labels) == ["Ia"]
+
+
+def test_initial_response_labels_preserved(labeled_mimo_sys):
+    sys = labeled_mimo_sys
+    res = ct.initial_response(sys, X0=[1, 0])
+
+    assert list(res.output_labels) == ["Ia", "Wm"]
+    assert res.state_labels is not None
+    assert len(res.state_labels) == 2
+
+
+def test_initial_response_output_selection_labels(labeled_mimo_sys):
+    sys = labeled_mimo_sys
+    res = ct.initial_response(sys, X0=[1, 0], output=1)
+
+    assert list(res.output_labels) == ["Wm"]
+
+
