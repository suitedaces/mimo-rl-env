+# -*- coding: utf-8 -*-
+
+
+import copy
+import io
+import json
+import os
+from collections import UserDict
+
+import pytest
+
+import samila
+from samila import GenerativeImage, Projection
+from samila.params import (
+    DEFAULT_ALPHA,
+    DEFAULT_BACKGROUND_COLOR,
+    DEFAULT_COLOR,
+    DEFAULT_DEPTH,
+    DEFAULT_IMAGE_SIZE,
+    DEFAULT_LINEWIDTH,
+    DEFAULT_PROJECTION,
+    DEFAULT_SPOT_SIZE,
+    DEFAULT_START,
+    DEFAULT_STEP,
+    DEFAULT_STOP,
+)
+
+
+def snapshot_data_payload():
+    return {
+        "data1": [1.25, -2.5],
+        "data2": [3.75, 4.5],
+        "plot": {
+            "color": "teal",
+            "bgcolor": "ivory",
+            "spot_size": 0.25,
+            "size": [7, 5],
+            "projection": "polar",
+            "alpha": 0.4,
+            "linewidth": 0.75,
+            "depth": 3,
+        },
+    }
+
+
+def snapshot_config_payload():
+    return {
+        "f1": "x + y",
+        "f2": "x - y",
+        "generate": {"seed": 0, "start": 0, "step": 0.5, "stop": 1},
+        "plot": {
+            "color": "teal",
+            "bgcolor": "ivory",
+            "spot_size": 0.25,
+            "size": [7, 5],
+            "projection": "polar",
+            "alpha": 0.4,
+            "linewidth": 0.75,
+            "depth": 3,
+        },
+    }
+
+
+def assert_plot_snapshot(g, size=(7, 5)):
+    assert g.color == "teal"
+    assert g.bgcolor == "ivory"
+    assert g.spot_size == 0.25
+    assert g.size == size
+    assert g.projection == "polar"
+    assert g.alpha == 0.4
+    assert g.linewidth == 0.75
+    assert g.depth == 3
+
+
+@pytest.mark.parametrize(
+    "source_kind", ["mapping", "string_path", "pathlike", "text", "binary"]
+)
+def test_codespec_data_accepts_mapping_path_and_owned_streams(
+        tmp_path, source_kind):
+    payload = snapshot_data_payload()
+    path = tmp_path / "points.json"
+    path.write_text(json.dumps(payload), encoding="utf-8")
+    sources = {
+        "mapping": UserDict(payload),
+        "string_path": str(path),
+        "pathlike": path,
+        "text": io.StringIO(json.dumps(payload)),
+        "binary": io.BytesIO(json.dumps(payload).encode("utf-8")),
+    }
+    source = sources[source_kind]
+
+    g = GenerativeImage(data=source)
+
+    assert g.data1 == [1.25, -2.5]
+    assert g.data2 == [3.75, 4.5]
+    assert_plot_snapshot(g)
+    if source_kind in ("text", "binary"):
+        assert not source.closed
+
+
+@pytest.mark.parametrize(
+    "source_kind", ["mapping", "string_path", "pathlike", "text", "binary"]
+)
+def test_codespec_config_accepts_mapping_path_and_owned_streams(
+        tmp_path, source_kind):
+    payload = snapshot_config_payload()
+    path = tmp_path / "config.json"
+    path.write_text(json.dumps(payload), encoding="utf-8")
+    sources = {
+        "mapping": UserDict(payload),
+        "string_path": str(path),
+        "pathlike": path,
+        "text": io.StringIO(json.dumps(payload)),
+        "binary": io.BytesIO(json.dumps(payload).encode("utf-8")),
+    }
+    source = sources[source_kind]
+
+    g = GenerativeImage(config=source)
+
+    assert g.function1(2, 1) == 3
+    assert g.function2(2, 1) == 1
+    assert (g.seed, g.start, g.step, g.stop) == (0, 0, 0.5, 1)
+    assert_plot_snapshot(g)
+    if source_kind in ("text", "binary"):
+        assert not source.closed
+
+
+def test_codespec_mapping_loads_are_isolated_from_caller_mutation():
+    payload = snapshot_data_payload()
+    original = copy.deepcopy(payload)
+    g = GenerativeImage(data=payload)
+
+    payload["data1"].append(99)
+    payload["plot"]["size"].append(99)
+    assert g.data1 == original["data1"]
+    assert g.size == (7, 5)
+
+    g.data2.append(88)
+    assert payload["data2"] == original["data2"]
+
+
+def make_generated_image():
+    source = io.StringIO(json.dumps(snapshot_config_payload()))
+    g = GenerativeImage(config=source)
+    g.generate()
+    g.plot(
+        color="teal",
+        bgcolor="ivory",
+        spot_size=0.25,
+        size=(7, 5),
+        projection=Projection.POLAR,
+        alpha=0.4,
+        linewidth=0.75,
+    )
+    return g
+
+
+@pytest.mark.parametrize(
+    "method_name, stream_factory",
+    [
+        ("save_data", io.StringIO),
+        ("save_data", io.BytesIO),
+        ("save_config", io.StringIO),
+        ("save_config", io.BytesIO),
+    ],
+)
+def test_codespec_save_supports_text_and_binary_owned_streams(
+        method_name, stream_factory):
+    g = make_generated_image()
+    stream = stream_factory()
+
+    result = getattr(g, method_name)(stream)
+
+    assert result == {"status": True, "message": "Everything seems good."}
+    assert not stream.closed
+    stream.seek(0)
+    serialized = json.load(stream)
+    assert serialized["plot"]["size"] == [7, 5]
+    assert serialized["plot"]["depth"] == 3
+    if method_name == "save_data":
+        assert serialized["data1"] == g.data1
+        assert serialized["data2"] == g.data2
+    else:
+        assert serialized["generate"] == {
+            "seed": 0, "start": 0, "step": 0.5, "stop": 1
+        }
+
+
+@pytest.mark.parametrize("path_kind", ["string", "pathlike"])
+def test_codespec_path_save_round_trips_complete_state(tmp_path, path_kind):
+    g = make_generated_image()
+    data_path = tmp_path / "saved-data.json"
+    config_path = tmp_path / "saved-config.json"
+    data_target = str(data_path) if path_kind == "string" else data_path
+    config_target = str(config_path) if path_kind == "string" else config_path
+
+    data_result = g.save_data(data_target)
+    config_result = g.save_config(config_target)
+
+    assert data_result == {"status": True, "message": os.path.abspath(data_path)}
+    assert config_result == {
+        "status": True, "message": os.path.abspath(config_path)
+    }
+    from_data = GenerativeImage(data=data_path)
+    from_config = GenerativeImage(config=config_path)
+    assert from_data.data1 == g.data1
+    assert from_data.data2 == g.data2
+    assert_plot_snapshot(from_data)
+    assert (from_config.seed, from_config.start,
+            from_config.step, from_config.stop) == (0, 0, 0.5, 1)
+    assert_plot_snapshot(from_config)
+    from_config.generate()
+    assert from_config.data1 == g.data1
+    assert from_config.data2 == g.data2
+
+
+def test_codespec_config_error_is_part_of_the_package_api():
+    assert hasattr(samila, "samilaConfigError")
+
+
+def test_codespec_load_failures_use_typed_errors_and_keep_streams_open(
+        tmp_path):
+    from samila.errors import samilaConfigError
+
+    malformed_data = io.StringIO("{")
+    malformed_config = io.BytesIO(b"{")
+
+    with pytest.raises(samila.samilaDataError) as data_error:
+        GenerativeImage(data=malformed_data)
+    with pytest.raises(samilaConfigError) as config_error:
+        GenerativeImage(config=malformed_config)
+
+    assert data_error.value.__cause__ is not None
+    assert config_error.value.__cause__ is not None
+    assert not malformed_data.closed
+    assert not malformed_config.closed
+
+    missing_path = tmp_path / "missing.json"
+    with pytest.raises(samila.samilaDataError) as missing_error:
+        GenerativeImage(data=missing_path)
+    assert isinstance(missing_error.value.__cause__, OSError)
+
+    with pytest.raises(samila.samilaDataError):
+        GenerativeImage(data=io.StringIO("[]"))
+    with pytest.raises(samilaConfigError):
+        GenerativeImage(config=io.StringIO("[]"))
+
+
+def test_codespec_legacy_data_snapshot_still_uses_plot_defaults():
+    data_image = GenerativeImage(data={"data1": [1], "data2": [2]})
+    assert data_image.color == DEFAULT_COLOR
+    assert data_image.bgcolor == DEFAULT_BACKGROUND_COLOR
+    assert data_image.spot_size == DEFAULT_SPOT_SIZE
+    assert data_image.size == DEFAULT_IMAGE_SIZE
+    assert data_image.projection == DEFAULT_PROJECTION
+    assert data_image.alpha == DEFAULT_ALPHA
+    assert data_image.linewidth == DEFAULT_LINEWIDTH
+    assert data_image.depth == DEFAULT_DEPTH
+
+
+@pytest.mark.parametrize(
+    "config_payload, preserved_key, generated_key",
+    [
+        ({"f1": "x"}, "function1_str", "function2_str"),
+        ({"f2": "y"}, "function2_str", "function1_str"),
+    ],
+)
+def test_codespec_legacy_partial_config_still_uses_defaults(
+        config_payload, preserved_key, generated_key):
+    config_image = GenerativeImage(config=config_payload)
+    assert getattr(config_image, preserved_key) == next(iter(config_payload.values()))
+    assert getattr(config_image, generated_key) is not None
+    assert config_image.seed is None
+    assert (config_image.start, config_image.step, config_image.stop) == (
+        DEFAULT_START, DEFAULT_STEP, DEFAULT_STOP
+    )
+    assert config_image.size == DEFAULT_IMAGE_SIZE
+
+
+class BrokenSnapshotStream(io.StringIO):
+    def write(self, value):
+        raise OSError("deliberate snapshot write failure")
+
+
+@pytest.mark.parametrize("method_name", ["save_data", "save_config"])
+def test_codespec_save_failures_remain_results_and_do_not_close_stream(
+        method_name):
+    g = make_generated_image()
+    stream = BrokenSnapshotStream()
+
+    result = getattr(g, method_name)(stream)
+
+    assert result["status"] is False
+    assert "deliberate snapshot write failure" in result["message"]
+    assert not stream.closed
