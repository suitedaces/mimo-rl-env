diff --git a/apis/v1alpha2/validation/http_route_contract_test.go b/apis/v1alpha2/validation/http_route_contract_test.go
new file mode 100644
index 00000000..6e2da0cd
--- /dev/null
+++ b/apis/v1alpha2/validation/http_route_contract_test.go
@@ -0,0 +1,198 @@
+package validation
+
+import (
+	"testing"
+
+	"k8s.io/apimachinery/pkg/util/validation/field"
+
+	v1alpha2 "sigs.k8s.io/gateway-api/apis/v1alpha2"
+)
+
+func contractFilter(t v1alpha2.HTTPRouteFilterType) v1alpha2.HTTPRouteFilter {
+	switch t {
+	case v1alpha2.HTTPRouteFilterRequestRedirect:
+		return v1alpha2.HTTPRouteFilter{Type: t, RequestRedirect: &v1alpha2.HTTPRequestRedirectFilter{}}
+	case v1alpha2.HTTPRouteFilterURLRewrite:
+		return v1alpha2.HTTPRouteFilter{Type: t, URLRewrite: &v1alpha2.HTTPURLRewriteFilter{}}
+	default:
+		return v1alpha2.HTTPRouteFilter{Type: t}
+	}
+}
+
+func contractServiceBackend(withPort bool) v1alpha2.HTTPBackendRef {
+	ref := v1alpha2.HTTPBackendRef{BackendRef: v1alpha2.BackendRef{
+		BackendObjectReference: v1alpha2.BackendObjectReference{Name: "svc"},
+	}}
+	kind := v1alpha2.Kind("Service")
+	ref.Kind = &kind
+	if withPort {
+		port := v1alpha2.PortNumber(8080)
+		ref.Port = &port
+	}
+	return ref
+}
+
+func hasField(errs field.ErrorList, want string) bool {
+	for _, err := range errs {
+		if err.Field == want {
+			return true
+		}
+	}
+	return false
+}
+
+func TestHTTPRouteContractRejectsRedirectRewriteOnRule(t *testing.T) {
+	route := &v1alpha2.HTTPRoute{Spec: v1alpha2.HTTPRouteSpec{Rules: []v1alpha2.HTTPRouteRule{{
+		Filters: []v1alpha2.HTTPRouteFilter{
+			contractFilter(v1alpha2.HTTPRouteFilterRequestRedirect),
+			contractFilter(v1alpha2.HTTPRouteFilterURLRewrite),
+		},
+	}}}}
+	if errs := ValidateHTTPRoute(route); !hasField(errs, "spec.rules[0].filters") {
+		t.Fatal("expected redirect and rewrite filters on one rule to be rejected")
+	}
+}
+
+func TestHTTPRouteContractRejectsRedirectRewriteOnBackend(t *testing.T) {
+	backend := contractServiceBackend(true)
+	backend.Filters = []v1alpha2.HTTPRouteFilter{
+		contractFilter(v1alpha2.HTTPRouteFilterRequestRedirect),
+		contractFilter(v1alpha2.HTTPRouteFilterURLRewrite),
+	}
+	route := &v1alpha2.HTTPRoute{Spec: v1alpha2.HTTPRouteSpec{Rules: []v1alpha2.HTTPRouteRule{{
+		BackendRefs: []v1alpha2.HTTPBackendRef{backend},
+	}}}}
+	if errs := ValidateHTTPRoute(route); !hasField(errs, "spec.rules[0].backendRefs[0].filters") {
+		t.Fatal("expected redirect and rewrite filters on one backend reference to be rejected")
+	}
+}
+
+func TestHTTPRouteContractUsesNestedMatchPath(t *testing.T) {
+	typ := v1alpha2.PathMatchPathPrefix
+	value := "relative"
+	route := &v1alpha2.HTTPRoute{Spec: v1alpha2.HTTPRouteSpec{Rules: []v1alpha2.HTTPRouteRule{{
+		Matches: []v1alpha2.HTTPRouteMatch{{Path: &v1alpha2.HTTPPathMatch{Type: &typ, Value: &value}}},
+	}}}}
+	errs := ValidateHTTPRoute(route)
+	if !hasField(errs, "spec.rules[0].matches[0].path.value") {
+		t.Fatalf("expected nested path error, got %v", errs)
+	}
+}
+
+func TestHTTPRouteContractUsesBackendRefsPath(t *testing.T) {
+	route := &v1alpha2.HTTPRoute{Spec: v1alpha2.HTTPRouteSpec{Rules: []v1alpha2.HTTPRouteRule{
+		{BackendRefs: []v1alpha2.HTTPBackendRef{contractServiceBackend(true)}},
+		{BackendRefs: []v1alpha2.HTTPBackendRef{contractServiceBackend(false)}},
+	}}}
+	errs := ValidateHTTPRoute(route)
+	if !hasField(errs, "spec.rules[1].backendRefs[0].port") {
+		t.Fatalf("expected backendRefs port error, got %v", errs)
+	}
+}
+
+func TestHTTPRouteContractUsesBackendFilterPath(t *testing.T) {
+	backend := contractServiceBackend(true)
+	backend.Filters = []v1alpha2.HTTPRouteFilter{{Type: v1alpha2.HTTPRouteFilterRequestMirror}}
+	route := &v1alpha2.HTTPRoute{Spec: v1alpha2.HTTPRouteSpec{Rules: []v1alpha2.HTTPRouteRule{{
+		BackendRefs: []v1alpha2.HTTPBackendRef{backend},
+	}}}}
+	errs := ValidateHTTPRoute(route)
+	if !hasField(errs, "spec.rules[0].backendRefs[0].filters[0]") {
+		t.Fatalf("expected backend filter error at backendRefs path, got %v", errs)
+	}
+}
+
+func TestHTTPRouteContractPreservesValidFilterAndBackendCases(t *testing.T) {
+	tests := []struct {
+		name  string
+		route *v1alpha2.HTTPRoute
+	}{
+		{
+			name: "redirect alone",
+			route: &v1alpha2.HTTPRoute{Spec: v1alpha2.HTTPRouteSpec{Rules: []v1alpha2.HTTPRouteRule{{
+				Filters: []v1alpha2.HTTPRouteFilter{contractFilter(v1alpha2.HTTPRouteFilterRequestRedirect)},
+			}}}},
+		},
+		{
+			name: "rewrite alone",
+			route: &v1alpha2.HTTPRoute{Spec: v1alpha2.HTTPRouteSpec{Rules: []v1alpha2.HTTPRouteRule{{
+				Filters: []v1alpha2.HTTPRouteFilter{contractFilter(v1alpha2.HTTPRouteFilterURLRewrite)},
+			}}}},
+		},
+		{
+			name: "extension filters may repeat",
+			route: &v1alpha2.HTTPRoute{Spec: v1alpha2.HTTPRouteSpec{Rules: []v1alpha2.HTTPRouteRule{{
+				Filters: []v1alpha2.HTTPRouteFilter{
+					{Type: v1alpha2.HTTPRouteFilterExtensionRef, ExtensionRef: &v1alpha2.LocalObjectReference{Name: "one"}},
+					{Type: v1alpha2.HTTPRouteFilterExtensionRef, ExtensionRef: &v1alpha2.LocalObjectReference{Name: "two"}},
+				},
+			}}}},
+		},
+		{
+			name: "non-service backend may omit port",
+			route: &v1alpha2.HTTPRoute{Spec: v1alpha2.HTTPRouteSpec{Rules: []v1alpha2.HTTPRouteRule{{
+				BackendRefs: []v1alpha2.HTTPBackendRef{{BackendRef: v1alpha2.BackendRef{BackendObjectReference: v1alpha2.BackendObjectReference{
+					Group: func() *v1alpha2.Group { v := v1alpha2.Group("example.com"); return &v }(),
+					Kind:  func() *v1alpha2.Kind { v := v1alpha2.Kind("Workload"); return &v }(),
+					Name:  "backend",
+				}}}},
+			}}}},
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if errs := ValidateHTTPRoute(tc.route); len(errs) != 0 {
+				t.Fatalf("expected valid route, got %v", errs)
+			}
+		})
+	}
+}
+
+func TestGatewayContractRequiresTLSForEncryptedProtocols(t *testing.T) {
+	for _, protocol := range []v1alpha2.ProtocolType{v1alpha2.HTTPSProtocolType, v1alpha2.TLSProtocolType} {
+		gw := &v1alpha2.Gateway{Spec: v1alpha2.GatewaySpec{Listeners: []v1alpha2.Listener{{
+			Name: "listener", Port: 443, Protocol: protocol,
+		}}}}
+		if errs := ValidateGateway(gw); !hasField(errs, "spec.listeners[0].tls") {
+			t.Fatalf("protocol %s without TLS should be rejected, got %v", protocol, errs)
+		}
+	}
+}
+
+func TestGatewayContractRejectsDuplicateListenerNames(t *testing.T) {
+	gw := &v1alpha2.Gateway{Spec: v1alpha2.GatewaySpec{Listeners: []v1alpha2.Listener{
+		{Name: "public", Port: 80, Protocol: v1alpha2.HTTPProtocolType},
+		{Name: "public", Port: 8080, Protocol: v1alpha2.HTTPProtocolType},
+	}}}
+	if errs := ValidateGateway(gw); !hasField(errs, "spec.listeners[1].name") {
+		t.Fatalf("duplicate listener names should be rejected, got %v", errs)
+	}
+}
+
+func TestGatewayContractPreservesProtocolSpecificRules(t *testing.T) {
+	tls := &v1alpha2.GatewayTLSConfig{}
+	hostname := v1alpha2.Hostname("foo.example.com")
+	valid := &v1alpha2.Gateway{Spec: v1alpha2.GatewaySpec{Listeners: []v1alpha2.Listener{
+		{Name: "http", Port: 80, Protocol: v1alpha2.HTTPProtocolType},
+		{Name: "https", Port: 443, Protocol: v1alpha2.HTTPSProtocolType, TLS: tls},
+	}}}
+	if errs := ValidateGateway(valid); len(errs) != 0 {
+		t.Fatalf("valid HTTP and HTTPS listeners should pass, got %v", errs)
+	}
+	for _, protocol := range []v1alpha2.ProtocolType{v1alpha2.HTTPProtocolType, v1alpha2.TCPProtocolType, v1alpha2.UDPProtocolType} {
+		gw := &v1alpha2.Gateway{Spec: v1alpha2.GatewaySpec{Listeners: []v1alpha2.Listener{{
+			Name: "listener", Port: 80, Protocol: protocol, TLS: tls,
+		}}}}
+		if errs := ValidateGateway(gw); !hasField(errs, "spec.listeners[0].tls") {
+			t.Fatalf("TLS on protocol %s should be rejected, got %v", protocol, errs)
+		}
+	}
+	for _, protocol := range []v1alpha2.ProtocolType{v1alpha2.TCPProtocolType, v1alpha2.UDPProtocolType} {
+		gw := &v1alpha2.Gateway{Spec: v1alpha2.GatewaySpec{Listeners: []v1alpha2.Listener{{
+			Name: "listener", Port: 80, Protocol: protocol, Hostname: &hostname,
+		}}}}
+		if errs := ValidateGateway(gw); !hasField(errs, "spec.listeners[0].hostname") {
+			t.Fatalf("hostname on protocol %s should be rejected, got %v", protocol, errs)
+		}
+	}
+}
