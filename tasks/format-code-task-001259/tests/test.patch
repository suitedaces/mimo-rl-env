+@mock_s3
+def test_copy_object_no_bucket_encryption_no_change():
+
+
+    bucket_name = "no-enc-bucket-issue"
+    client = boto3.client("s3", region_name=DEFAULT_REGION_NAME)
+    client.create_bucket(Bucket=bucket_name)
+
+    client.put_object(Bucket=bucket_name, Key="src.txt", Body=b"dummy")
+
+    client.copy_object(
+        Bucket=bucket_name,
+        CopySource={"Bucket": bucket_name, "Key": "src.txt"},
+        Key="dst.txt",
+    )
+
+    head = client.head_object(Bucket=bucket_name, Key="dst.txt")
+    assert head.get("ServerSideEncryption") is None
+
+
+@mock_s3
+def test_copy_object_with_replace_metadata_directive_applies_default_encryption():
+
+
+    bucket_name = "issue-replace-md-bucket"
+    client = boto3.client("s3", region_name=DEFAULT_REGION_NAME)
+    client.create_bucket(Bucket=bucket_name)
+
+    client.put_object(Bucket=bucket_name, Key="part.txt", Body=b"dummy")
+
+    client.put_bucket_encryption(
+        Bucket=bucket_name,
+        ServerSideEncryptionConfiguration={
+            "Rules": [
+                {"ApplyServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}
+            ]
+        },
+    )
+
+    client.copy_object(
+        Bucket=bucket_name,
+        CopySource={"Bucket": bucket_name, "Key": "part.txt"},
+        Key="part.txt",
+        MetadataDirective="REPLACE",
+        Metadata={"foo": "bar"},
+    )
+
+    head = client.head_object(Bucket=bucket_name, Key="part.txt")
+    assert head["ServerSideEncryption"] == "AES256"
+    assert head["Metadata"]["foo"] == "bar"
+
+
+@mock_s3
+def test_put_object_after_enabling_aes256_default_encryption():
+
+
+
+    bucket_name = "issue-put-after-enc-bucket"
