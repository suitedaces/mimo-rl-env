+@mock_s3
+def test_copy_object_in_place_applies_bucket_default_encryption_aes256():
+
+
+
+
+    bucket_name = "issue-sse-aes-bucket"
+    client = boto3.client("s3", region_name=DEFAULT_REGION_NAME)
+    client.create_bucket(Bucket=bucket_name)
+
+    client.put_object(Bucket=bucket_name, Key="data/part-1.txt", Body=b"dummy")
+
+    head = client.head_object(Bucket=bucket_name, Key="data/part-1.txt")
+    assert head.get("ServerSideEncryption") is None
+
+    client.put_bucket_encryption(
+        Bucket=bucket_name,
+        ServerSideEncryptionConfiguration={
+            "Rules": [
+                {"ApplyServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}
+            ]
+        },
+    )
+
+    client.copy_object(
+        Bucket=bucket_name,
+        CopySource={"Bucket": bucket_name, "Key": "data/part-1.txt"},
+        Key="data/part-1.txt",
+    )
+
+    head = client.head_object(Bucket=bucket_name, Key="data/part-1.txt")
+    assert head["ServerSideEncryption"] == "AES256"
+
+
+@mock_s3
+def test_copy_object_in_place_applies_bucket_default_encryption_kms():
+    bucket_name = "issue-sse-kms-bucket"
+    client = boto3.client("s3", region_name=DEFAULT_REGION_NAME)
+    client.create_bucket(Bucket=bucket_name)
+
+    client.put_object(Bucket=bucket_name, Key="part-2.txt", Body=b"dummy2")
+
+    client.put_bucket_encryption(
+        Bucket=bucket_name,
+        ServerSideEncryptionConfiguration={
+            "Rules": [
+                {
+                    "ApplyServerSideEncryptionByDefault": {
+                        "SSEAlgorithm": "aws:kms",
+                        "KMSMasterKeyID": "alias/test-kms-key-id",
+                    }
+                }
+            ]
+        },
+    )
+
+    client.copy_object(
+        Bucket=bucket_name,
+        CopySource={"Bucket": bucket_name, "Key": "part-2.txt"},
+        Key="part-2.txt",
+    )
+
+    head = client.head_object(Bucket=bucket_name, Key="part-2.txt")
+    assert head["ServerSideEncryption"] == "aws:kms"
+    assert head["SSEKMSKeyId"] == "alias/test-kms-key-id"
+
+
+@mock_s3
+def test_copy_object_to_different_key_applies_bucket_default_encryption():
+
+
+    bucket_name = "issue-sse-newkey-bucket"
+    client = boto3.client("s3", region_name=DEFAULT_REGION_NAME)
+    client.create_bucket(Bucket=bucket_name)
+
+    client.put_object(Bucket=bucket_name, Key="src.txt", Body=b"dummy")
+    client.put_bucket_encryption(
+        Bucket=bucket_name,
+        ServerSideEncryptionConfiguration={
+            "Rules": [
+                {"ApplyServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}
+            ]
+        },
+    )
+
+    client.copy_object(
+        Bucket=bucket_name,
+        CopySource={"Bucket": bucket_name, "Key": "src.txt"},
+        Key="dst.txt",
+    )
+
+    head = client.head_object(Bucket=bucket_name, Key="dst.txt")
+    assert head["ServerSideEncryption"] == "AES256"
+
