+            ]
+        },
+    )
+
+    client.put_object(Bucket=bucket_name, Key="new.txt", Body=b"hi")
+
+    head = client.head_object(Bucket=bucket_name, Key="new.txt")
+    assert head["ServerSideEncryption"] == "AES256"
