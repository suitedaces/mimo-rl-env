+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+if [ ! -x /workspace/repo/node_modules/.bin/jest ]; then
+  echo "Missing local Jest installation at /workspace/repo/node_modules/.bin/jest" >&2
+  exit 127
+fi
+
+exec /workspace/repo/node_modules/.bin/jest /workspace/repo/usercase-test-coderl/unleash-client-provider.test.ts --runInBand --config '{
+  "rootDir": "/workspace/repo",
+  "moduleFileExtensions": ["js", "json", "ts"],
+  "moduleNameMapper": {
+    "^@alpha018/nestjs-unleash-client$": "<rootDir>/src/index.ts"
+  },
+  "transform": {
+    "^.+\\.(t|j)s$": ["ts-jest", {
+      "tsconfig": {
+        "baseUrl": "/workspace/repo",
+        "paths": {
+          "@alpha018/nestjs-unleash-client": ["src/index.ts"]
+        }
+      }
+    }]
+  },
+  "testEnvironment": "node",
+  "testRegex": ".*\\.test\\.ts$"
+}'
