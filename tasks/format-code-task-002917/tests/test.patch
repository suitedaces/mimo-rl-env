--- /dev/null
+++ b/test/serialize-format.test.ts
@@ -0,0 +1,181 @@
+import { describe, expect, it } from "vitest";
+import { serialize } from "../src";
+
+describe("serialize (stable string format)", () => {
+  describe("primitives", () => {
+    it("wraps strings in single quotes", () => {
+      expect(serialize("hello world 😎")).toBe("'hello world 😎'");
+      expect(serialize({ msg: "hello world 😎" })).toBe(
+        "{msg:'hello world 😎'}",
+      );
+    });
+
+    it("serializes numbers as their literal text", () => {
+      expect(serialize(0)).toBe("0");
+      expect(serialize(100)).toBe("100");
+      expect(serialize(-100)).toBe("-100");
+      expect(serialize(Number.NaN)).toBe("NaN");
+      expect(serialize(Number.EPSILON)).toBe("2.220446049250313e-16");
+      expect(serialize(Number.POSITIVE_INFINITY)).toBe("Infinity");
+      expect(serialize(Number.NEGATIVE_INFINITY)).toBe("-Infinity");
+    });
+
+    it("serializes booleans", () => {
+      expect(serialize(true)).toBe("true");
+      expect(serialize(false)).toBe("false");
+    });
+
+    it("serializes null and undefined", () => {
+      expect(serialize(null)).toBe("null");
+      expect(serialize(undefined)).toBe("undefined");
+    });
+
+    it("serializes bigint with an n suffix", () => {
+      expect(serialize(9_007_199_254_740_991n)).toBe("9007199254740991n");
+    });
+
+    it("serializes symbols via their description", () => {
+      expect(serialize(Symbol("test"))).toBe("Symbol(test)");
+      expect(serialize(Symbol.for("test"))).toBe("Symbol(test)");
+    });
+  });
+
+  describe("built-in objects", () => {
+    it("serializes Date as its ISO string", () => {
+      expect(serialize(new Date(0))).toBe("Date(1970-01-01T00:00:00.000Z)");
+    });
+
+    it("serializes Error", () => {
+      expect(serialize(new Error("test"))).toBe("Error(Error: test)");
+    });
+
+    it("serializes RegExp", () => {
+      expect(serialize(/.*/)).toBe("RegExp(/.*/)");
+    });
+
+    it("serializes URL", () => {
+      expect(serialize(new URL("https://example.com"))).toBe(
+        "URL(https://example.com/)",
+      );
+    });
+  });
+
+  describe("arrays", () => {
+    it("keeps array order and writes a trailing comma per element", () => {
+      expect(serialize([1, 2, "x", 3])).toBe("[1,2,'x',3,]");
+      expect(serialize([2, 3, "x", 1])).toBe("[2,3,'x',1,]");
+    });
+
+    it("serializes ArrayBuffer, typed arrays and Buffer as byte lists", () => {
+      expect(serialize(new Uint8Array([1, 2, 3]).buffer)).toBe(
+        "ArrayBuffer[1,2,3]",
+      );
+      expect(serialize(new Uint8Array([1, 2, 3]))).toBe("Uint8Array[1,2,3]");
+      expect(serialize(Buffer.from("hello"))).toBe(
+        "Uint8Array[104,101,108,108,111]",
+      );
+    });
+  });
+
+  describe("objects", () => {
+    it("sorts plain object keys independent of insertion order", () => {
+      expect(serialize({ a: 1, b: 2 })).toBe("{a:1,b:2}");
+      expect(serialize({ b: 2, a: 1 })).toBe("{a:1,b:2}");
+    });
+
+    it("ignores symbol keys", () => {
+      expect(serialize({ [Symbol("s")]: 123 })).toBe("{}");
+    });
+
+    it("prefixes non-plain objects with their constructor name", () => {
+      class Test {
+        x = 1;
+      }
+      expect(serialize(new Test())).toBe("Test{x:1}");
+    });
+
+    it("uses toJSON() output when available", () => {
+      class Test {
+        toJSON() {
+          return [1, 2, 3];
+        }
+      }
+      expect(serialize(new Test())).toBe("Test[1,2,3,]");
+      expect(serialize({ x: new Test() })).toBe("{x:Test[1,2,3,]}");
+    });
+
+    it("serializes unknown objects exposing entries()", () => {
+      const form = new FormData();
+      form.set("foo", "bar");
+      form.set("bar", "baz");
+      expect(serialize(form)).toBe("FormData{bar:'baz',foo:'bar'}");
+    });
+
+    it("represents circular references by first-seen index", () => {
+      const obj: any = {};
+      obj.foo = obj;
+      expect(serialize(obj)).toBe("{foo:#0}");
+    });
+  });
+
+  describe("Set and Map are order-less", () => {
+    it("sorts Set members", () => {
+      expect(serialize(new Set([1, 2, 3]))).toBe("Set[1,2,3,]");
+      expect(serialize(new Set([2, 3, 1]))).toBe("Set[1,2,3,]");
+      expect(serialize(new Set([{ b: 1 }, { a: 1 }]))).toBe(
+        "Set[{a:1},{b:1},]",
+      );
+    });
+
+    it("sorts Map entries by key", () => {
+      const map = new Map();
+      map.set("z", 2);
+      map.set("a", "1");
+      expect(serialize(map)).toBe("Map{a:'1',z:2}");
+    });
+  });
+
+  describe("functions", () => {
+    it("serializes native functions", () => {
+      expect(serialize(Array)).toBe("Array()[native]");
+    });
+
+    it("serializes a regular function with name, arity and source", () => {
+      function sum(a: number, b: number) {
+        return a + b;
+      }
+      expect(serialize(sum)).toBe("sum(2)function sum(a, b) {return a + b;}");
+    });
+
+    it("serializes an arrow function", () => {
+      const sum = (a: number, b: number) => a + b;
+      expect(serialize(sum)).toBe("sum(2)(a, b) => a + b");
+    });
+  });
+
+  describe("equality of differently-ordered inputs", () => {
+    it("produces identical output for re-ordered objects, maps and sets", () => {
+      expect(serialize({ a: 1, b: { c: 2, d: 3 } })).toBe(
+        serialize({ b: { d: 3, c: 2 }, a: 1 }),
+      );
+      expect(serialize(new Set([3, 1, 2]))).toBe(serialize(new Set([1, 2, 3])));
+      const m1 = new Map([
+        ["x", 1],
+        ["y", 2],
+      ]);
+      const m2 = new Map([
+        ["y", 2],
+        ["x", 1],
+      ]);
+      expect(serialize(m1)).toBe(serialize(m2));
+    });
+  });
+
+  describe("unsupported values", () => {
+    it("throws for values it cannot serialize", () => {
+      expect(() => serialize(new Blob(["x"]))).toThrowError(
+        "Cannot serialize Blob",
+      );
+    });
+  });
+});
