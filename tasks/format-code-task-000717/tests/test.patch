+# -*- coding: utf-8 -*-
+
+
+
+
+
+
+
+import numpy as np
+from numpy.testing import assert_allclose
+
+from phy.plot import PanZoom
+
+
+
+
+
+
+def test_defaults():
+    pz = PanZoom()
+    assert_allclose(np.asarray(pz.pan).ravel(), [0.0, 0.0])
+    assert np.asarray(pz.pan).shape == (2,)
+    assert_allclose(np.asarray(pz.zoom).ravel(), [1.0, 1.0])
+    assert np.asarray(pz.zoom).shape == (2,)
+
+
+def test_pan_setter():
+    pz = PanZoom()
+    pz.pan = (2.0, -3.5)
+    assert_allclose(np.asarray(pz.pan).ravel(), [2.0, -3.5])
+
+
+def test_zoom_setter_scalar_and_pair():
+    pz = PanZoom(zmin=1e-3, zmax=1e3)
+    pz.zoom = (2.0, 5.0)
+    assert_allclose(np.asarray(pz.zoom).ravel(), [2.0, 5.0])
+
+    pz.zoom = 4.0
+    assert_allclose(np.asarray(pz.zoom).ravel(), [4.0, 4.0])
+
+
+
+
+
+
+def test_zoom_clamping():
+    pz = PanZoom(zmin=0.1, zmax=10.0)
+    pz.zoom = (100.0, 100.0)
+    assert_allclose(np.asarray(pz.zoom).ravel(), [10.0, 10.0])
+    pz.zoom = (1e-6, 1e-6)
+    assert_allclose(np.asarray(pz.zoom).ravel(), [0.1, 0.1])
+
+    pz.zoom = (1e-6, 100.0)
+    assert_allclose(np.asarray(pz.zoom).ravel(), [0.1, 10.0])
+
+    pz.zoom = (2.0, 3.0)
+    assert_allclose(np.asarray(pz.zoom).ravel(), [2.0, 3.0])
+
+
+def test_bounds_cannot_cross():
+    pz = PanZoom(zmin=0.5, zmax=100.0)
+
+    pz.zmin = 200.0
+    assert_allclose(pz.zmin, 100.0)
+    pz = PanZoom(zmin=0.5, zmax=100.0)
+
+    pz.zmax = 0.1
+    assert_allclose(pz.zmax, 0.5)
+
+
+def test_bounds_reclamp_zoom():
+    pz = PanZoom(zoom=(50.0, 50.0), zmin=0.1, zmax=100.0)
+    pz.zmax = 10.0
+    assert_allclose(np.asarray(pz.zoom).ravel(), [10.0, 10.0])
+
+    pz = PanZoom(zoom=(0.5, 0.5), zmin=0.1, zmax=100.0)
+    pz.zmin = 5.0
+    assert_allclose(np.asarray(pz.zoom).ravel(), [5.0, 5.0])
+
+
+
+
+
+
+def test_map_formula():
+    pz = PanZoom(pan=(2.0, -3.0), zoom=(4.0, 5.0), zmin=1e-3, zmax=1e3)
+    out = np.asarray(pz.map([1.0, 1.0]))
+    assert_allclose(out.ravel(), [4.0 * (1.0 + 2.0), 5.0 * (1.0 - 3.0)])
+
+
+def test_map_imap_inverse():
+    pz = PanZoom(pan=(0.7, -1.2), zoom=(3.0, 0.5), zmin=1e-3, zmax=1e3)
+    pts = np.array([[0.0, 0.0], [1.0, 2.0], [-1.5, 3.3], [10.0, -4.0]])
+    assert_allclose(np.asarray(pz.imap(pz.map(pts))), pts, atol=1e-9)
+
+    single = pz.map([0.4, -0.6])
+    assert np.asarray(single).shape == (2,)
+    assert_allclose(np.asarray(pz.imap(single)).ravel(), [0.4, -0.6], atol=1e-9)
+
+
+def test_map_array_shape():
+    pz = PanZoom(pan=(1.0, 1.0), zoom=(2.0, 2.0), zmin=1e-3, zmax=1e3)
+    pts = np.array([[0.0, 0.0], [1.0, 2.0], [3.0, 4.0]])
+    out = np.asarray(pz.map(pts))
+    assert out.shape == (3, 2)
+    assert_allclose(out, 2.0 * (pts + 1.0))
+
+
+
+
+
+
+def test_pan_delta():
+    pz = PanZoom(pan=(1.0, 1.0))
+    pz.pan_delta((2.0, -0.5))
+    assert_allclose(np.asarray(pz.pan).ravel(), [3.0, 0.5])
+
+
+def test_zoom_delta_direction():
+    pz = PanZoom(zoom=(2.0, 2.0), zmin=1e-3, zmax=1e3)
+    z0 = np.asarray(pz.zoom).ravel().copy()
+    pz.zoom_delta(0.7)
+    z1 = np.asarray(pz.zoom).ravel()
+    assert np.all(z1 > z0)
+    pz.zoom_delta(-0.7)
+    z2 = np.asarray(pz.zoom).ravel()
+    assert np.all(z2 < z1)
+
+
+def test_zoom_delta_centered_invariance():
+    pz = PanZoom(pan=(0.3, -0.2), zoom=(2.0, 2.0), zmin=1e-3, zmax=1e3)
+    center = (0.5, 0.4)
+    before = np.asarray(pz.imap(center)).ravel().copy()
+    pz.zoom_delta(0.6, center=center)
+    after = np.asarray(pz.imap(center)).ravel()
+    assert_allclose(after, before, atol=1e-9)
+
+
+def test_zoom_delta_default_center_keeps_pan():
+    pz = PanZoom(pan=(1.0, 2.0), zoom=(1.0, 1.0), zmin=1e-3, zmax=1e3)
+    pan0 = np.asarray(pz.pan).ravel().copy()
+    z0 = np.asarray(pz.zoom).ravel().copy()
+    pz.zoom_delta(0.5)
+    assert_allclose(np.asarray(pz.pan).ravel(), pan0)
+    assert np.all(np.asarray(pz.zoom).ravel() > z0)
+
+
+def test_zoom_delta_clamps_and_stays_centered():
+    pz = PanZoom(zoom=(1.0, 1.0), zmin=0.5, zmax=4.0)
+    center = (0.3, 0.4)
+    before = np.asarray(pz.imap(center)).ravel().copy()
+    pz.zoom_delta(100.0, center=center)
+    assert_allclose(np.asarray(pz.zoom).ravel(), [4.0, 4.0])
+    assert_allclose(np.asarray(pz.imap(center)).ravel(), before, atol=1e-9)
+
+    pz = PanZoom(zoom=(1.0, 1.0), zmin=0.5, zmax=4.0)
+    pz.zoom_delta(-100.0, center=center)
+    assert_allclose(np.asarray(pz.zoom).ravel(), [0.5, 0.5])
+
+
+def test_reset():
+    pz = PanZoom(pan=(5.0, 5.0), zoom=(3.0, 3.0))
+    pz.pan_delta((1.0, 1.0))
+    pz.zoom_delta(0.5)
+    pz.reset()
+    assert_allclose(np.asarray(pz.pan).ravel(), [0.0, 0.0])
+    assert_allclose(np.asarray(pz.zoom).ravel(), [1.0, 1.0])
+
+
+
+
+
+
+def test_add_single_program():
+    pz = PanZoom(pan=(1.0, 2.0), zoom=(3.0, 4.0), zmin=1e-3, zmax=1e3)
+    prog = {}
+    pz.add(prog)
+    assert_allclose(np.asarray(prog['u_pan']).ravel(), [1.0, 2.0])
+    assert_allclose(np.asarray(prog['u_zoom']).ravel(), [3.0, 4.0])
+
+
+def test_program_updates_on_change():
+    pz = PanZoom(zmin=1e-3, zmax=1e3)
+    prog = {}
+    pz.add(prog)
+
+    pz.pan = (5.0, 6.0)
+    assert_allclose(np.asarray(prog['u_pan']).ravel(), [5.0, 6.0])
+
+    pz.zoom = (7.0, 8.0)
+    assert_allclose(np.asarray(prog['u_zoom']).ravel(), [7.0, 8.0])
+
+    pz.pan_delta((1.0, 1.0))
+    assert_allclose(np.asarray(prog['u_pan']).ravel(), [6.0, 7.0])
+
+    pz.zoom_delta(0.3)
+    assert_allclose(np.asarray(prog['u_zoom']).ravel(),
+                    np.asarray(pz.zoom).ravel())
+
+    pz.reset()
+    assert_allclose(np.asarray(prog['u_pan']).ravel(), [0.0, 0.0])
+    assert_allclose(np.asarray(prog['u_zoom']).ravel(), [1.0, 1.0])
+
+
+def test_add_multiple_programs():
+    pz = PanZoom(pan=(2.0, 2.0), zoom=(2.0, 2.0), zmin=1e-3, zmax=1e3)
+    p1, p2 = {}, {}
+    pz.add([p1, p2])
+    for p in (p1, p2):
+        assert_allclose(np.asarray(p['u_pan']).ravel(), [2.0, 2.0])
+        assert_allclose(np.asarray(p['u_zoom']).ravel(), [2.0, 2.0])
+    pz.pan = (9.0, -9.0)
+    for p in (p1, p2):
+        assert_allclose(np.asarray(p['u_pan']).ravel(), [9.0, -9.0])
