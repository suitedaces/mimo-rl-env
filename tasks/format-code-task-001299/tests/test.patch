+func searchIssuesWithQuery(t *testing.T, session *TestSession, query url.Values, expectedStatus int) []*api.Issue {
+	t.Helper()
+	query.Set("state", "all")
+	query.Set("limit", "50")
+	req := NewRequest(t, "GET", "/api/v1/repos/issues/search?"+query.Encode())
+	resp := session.MakeRequest(t, req, expectedStatus)
+	var apiIssues []*api.Issue
+	if expectedStatus == http.StatusOK {
+		DecodeJSON(t, resp, &apiIssues)
+	}
+	return apiIssues
+}
+
+func decodeAPIErrorMessage(t *testing.T, body []byte) string {
+	t.Helper()
+	var apiError struct {
+		Message string `json:"message"`
+	}
+	assert.NoError(t, json.Unmarshal(body, &apiError))
+	assert.NotEmpty(t, apiError.Message)
+	return apiError.Message
+}
+
+func assertIssuesOwnedBy(t *testing.T, issues []*api.Issue, owner string) {
+	t.Helper()
+	assert.NotEmpty(t, issues)
+	for _, issue := range issues {
+		if assert.NotNil(t, issue.Repo) {
+			assert.Equal(t, owner, issue.Repo.Owner)
+		}
+	}
+}
+
+func hasIssueOutsideOwner(issues []*api.Issue, owner string) bool {
+	for _, issue := range issues {
+		if issue.Repo != nil && issue.Repo.Owner != owner {
+			return true
+		}
+	}
+	return false
+}
+
+func hasIssueInRepo(issues []*api.Issue, owner, repo string) bool {
+	for _, issue := range issues {
+		if issue.Repo != nil && issue.Repo.Owner == owner && issue.Repo.Name == repo {
+			return true
+		}
+	}
+	return false
+}
+
+func TestAPISearchIssuesOwnerFilter_UserOwner(t *testing.T) {
+	defer prepareTestEnv(t)()
+	session := loginUser(t, "user2")
+
+	unfiltered := searchIssuesWithQuery(t, session, url.Values{}, http.StatusOK)
+	assert.True(t, hasIssueOutsideOwner(unfiltered, "user2"), "fixture must contain a visible issue from another owner")
+
+	issues := searchIssuesWithQuery(t, session, url.Values{"owner": {"user2"}}, http.StatusOK)
+	assertIssuesOwnedBy(t, issues, "user2")
+	assert.False(t, hasIssueOutsideOwner(issues, "user2"))
+
+	additionalOwnerIssues := searchIssuesWithQuery(t, session, url.Values{"owner": {"user12"}}, http.StatusOK)
+	assertIssuesOwnedBy(t, additionalOwnerIssues, "user12")
+	assert.False(t, hasIssueOutsideOwner(additionalOwnerIssues, "user12"))
+}
+
+func TestAPISearchIssuesOwnerFilter_OrgOwner(t *testing.T) {
+	defer prepareTestEnv(t)()
+	session := loginUser(t, "user2")
+
+	unfiltered := searchIssuesWithQuery(t, session, url.Values{}, http.StatusOK)
+	assert.True(t, hasIssueOutsideOwner(unfiltered, "user3"), "fixture must contain a visible issue outside the org owner")
+
+	issues := searchIssuesWithQuery(t, session, url.Values{"owner": {"user3"}}, http.StatusOK)
+	assertIssuesOwnedBy(t, issues, "user3")
+	assert.False(t, hasIssueOutsideOwner(issues, "user3"))
+}
+
+func TestAPISearchIssuesTeamFilterWithinOwner(t *testing.T) {
+	defer prepareTestEnv(t)()
+	session := loginUser(t, "user2")
+
+	ownerIssues := searchIssuesWithQuery(t, session, url.Values{"owner": {"user3"}}, http.StatusOK)
+	if !hasIssueInRepo(ownerIssues, "user3", "repo5") {
+		token := getTokenForLoggedInUser(t, session)
+		req := NewRequestWithJSON(t, "POST", "/api/v1/repos/user3/repo5/issues?token="+token, &api.CreateIssueOption{
+			Title: "issue in org repo outside team1",
+			Body:  "content",
+		})
+		session.MakeRequest(t, req, http.StatusCreated)
+		ownerIssues = searchIssuesWithQuery(t, session, url.Values{"owner": {"user3"}}, http.StatusOK)
+	}
+	assertIssuesOwnedBy(t, ownerIssues, "user3")
+	assert.True(t, hasIssueInRepo(ownerIssues, "user3", "repo5"), "owner-only search should include the controlled non-team repo issue")
+
+	teamIssues := searchIssuesWithQuery(t, session, url.Values{
+		"owner": {"user3"},
+		"team":  {"team1"},
+	}, http.StatusOK)
+	assertIssuesOwnedBy(t, teamIssues, "user3")
+	assert.False(t, hasIssueInRepo(teamIssues, "user3", "repo5"), "team search must exclude same-org repositories outside the team")
+
+	testTeamToken := getTokenForLoggedInUser(t, session)
+	req := NewRequestWithJSON(t, "POST", "/api/v1/repos/user3/repo21/issues?token="+testTeamToken, &api.CreateIssueOption{
+		Title: "issue in org repo for test_team",
+		Body:  "content",
+	})
+	session.MakeRequest(t, req, http.StatusCreated)
+
+	testTeamOwnerIssues := searchIssuesWithQuery(t, session, url.Values{"owner": {"user3"}}, http.StatusOK)
+	assertIssuesOwnedBy(t, testTeamOwnerIssues, "user3")
+	assert.True(t, hasIssueInRepo(testTeamOwnerIssues, "user3", "repo5"), "owner-only search should include the non-test_team repository")
+	assert.True(t, hasIssueInRepo(testTeamOwnerIssues, "user3", "repo21"), "owner-only search should include the test_team repository")
+
+	testTeamIssues := searchIssuesWithQuery(t, session, url.Values{
+		"owner": {"user3"},
+		"team":  {"test_team"},
+	}, http.StatusOK)
+	assertIssuesOwnedBy(t, testTeamIssues, "user3")
+	assert.False(t, hasIssueInRepo(testTeamIssues, "user3", "repo5"), "team search must exclude repositories outside test_team")
+	assert.True(t, hasIssueInRepo(testTeamIssues, "user3", "repo21"), "team search should include repositories associated with test_team")
+}
