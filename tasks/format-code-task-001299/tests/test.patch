+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+
+
+export GOROOT=/opt/go-1.22
+export PATH=$GOROOT/bin:$PATH
+
+
+
+
+REFLECT2_CACHE=$(go mod download -json github.com/modern-go/reflect2@v1.0.2 2>/dev/null | awk -F'"' '/"Dir"/ {print $4; exit}') || true
+if [ -z "$REFLECT2_CACHE" ]; then
+    GOFLAGS=-mod=mod go mod download github.com/modern-go/reflect2@v1.0.2
+    REFLECT2_CACHE=$(go mod download -json github.com/modern-go/reflect2@v1.0.2 | awk -F'"' '/"Dir"/ {print $4; exit}')
+fi
+rm -rf vendor/github.com/modern-go/reflect2
+cp -r "$REFLECT2_CACHE" vendor/github.com/modern-go/reflect2
+
+
+REPO_TEST_DIR=$(pwd)/
+sed -e "s|{{REPO_TEST_DIR}}|${REPO_TEST_DIR}|g" integrations/sqlite.ini.tmpl > integrations/sqlite.ini
+
+
+go build -mod=vendor -tags 'sqlite sqlite_unlock_notify' -o gitea
+
+
+go test -mod=vendor -c code.gitea.io/gitea/integrations -o integrations.sqlite.test -tags 'sqlite sqlite_unlock_notify'
+
+
+case "${1:-}" in
+  base)
+    GITEA_ROOT="$(pwd)" GITEA_CONF=integrations/sqlite.ini ./integrations.sqlite.test -test.run '^TestAPIListIssues$' -test.v
+    ;;
+  new)
+    GITEA_ROOT="$(pwd)" GITEA_CONF=integrations/sqlite.ini ./integrations.sqlite.test -test.run '^(TestAPISearchIssuesOwnerFilter_UserOwner|TestAPISearchIssuesOwnerFilter_OrgOwner|TestAPISearchIssuesTeamFilterWithinOwner|TestAPISearchIssuesOwnerNotFound|TestAPISearchIssuesTeamRequiresOwner|TestAPISearchIssuesTeamNotFound|TestSwaggerSearchIssuesOwnerTeamParameters)$' -test.v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
