+func TestSwaggerSearchIssuesOwnerTeamParameters(t *testing.T) {
+	defer prepareTestEnv(t)()
+
+	req := NewRequest(t, "GET", "/swagger.v1.json")
+	resp := MakeRequest(t, req, http.StatusOK)
+
+	var swagger struct {
+		Paths map[string]map[string]struct {
+			Parameters []swaggerParameter `json:"parameters"`
+		} `json:"paths"`
+	}
+	assert.NoError(t, json.Unmarshal(resp.Body.Bytes(), &swagger))
+
+	searchIssues, ok := swagger.Paths["/repos/issues/search"]["get"]
+	if assert.True(t, ok, "swagger must describe GET /repos/issues/search") {
+		ownerParam := findSwaggerParameter(searchIssues.Parameters, "owner")
+		if assert.NotNil(t, ownerParam, "swagger must expose owner query parameter") {
+			assert.Equal(t, "query", ownerParam.In)
+		}
+
+		teamParam := findSwaggerParameter(searchIssues.Parameters, "team")
+		if assert.NotNil(t, teamParam, "swagger must expose team query parameter") {
+			assert.Equal(t, "query", teamParam.In)
+			assert.Contains(t, teamParam.Description, "team")
+			assert.Contains(t, teamParam.Description, "owner")
+		}
+	}
+}
+
+type swaggerParameter struct {
+	Name        string `json:"name"`
+	In          string `json:"in"`
+	Description string `json:"description"`
+}
+
+func findSwaggerParameter(parameters []swaggerParameter, name string) *swaggerParameter {
+	for i := range parameters {
+		if parameters[i].Name == name {
+			return &parameters[i]
+		}
+	}
+	return nil
+}
