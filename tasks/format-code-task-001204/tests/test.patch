+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+export PATH="/opt/node-24/bin:$PATH"
+
+if [ ! -d /testbed/node_modules ] || [ ! -x /testbed/node_modules/.bin/vitest ]; then
+  pnpm install --frozen-lockfile
+fi
+
+cd /testbed/packages/logger && npx vite build 2>&1
+
+cd /testbed/apps/web
+
+case "${1:-}" in
+  base)
+    npx vitest run --reporter=verbose \
+      modules/auth/signup-without-verification-success/page.test.tsx \
+      modules/auth/verification-requested/page.test.tsx
+    ;;
+  new)
+    npx vitest run --reporter=verbose lib/airtable/service.test.ts
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
