diff --git a/lib/rules/max-line-length/__tests__/index.js b/lib/rules/max-line-length/__tests__/index.js
index 88de79635..c5ee7a502 100644
--- a/lib/rules/max-line-length/__tests__/index.js
+++ b/lib/rules/max-line-length/__tests__/index.js
@@ -499,3 +499,47 @@ testRule(rule, {
     }
   ]
 });
+
+testRule(rule, {
+  ruleName,
+  config: [20],
+
+  accept: [
+    {
+      code:
+        "a {\n  background: url(\n    'something something  something'\n  );\n}",
+      description:
+        "multi-line url() with quoted content containing spaces (issue case)"
+    },
+    {
+      code:
+        "a {\n  background-image: url(\n    \"data:image/svg+xml;utf8,<svg fill='black' height='24' viewBox='0 0 24 24' width='24' xmlns='http://www.w3.org/2000/svg'><path d='M7 9l5 5 5-5z'/></svg>\"\n  );\n}",
+      description: "multi-line url() with svg data URI (issue case)"
+    },
+    {
+      code:
+        "a {\n  background: URL(\n    'something something  something'\n  );\n}",
+      description: "multi-line URL() uppercase should be recognised"
+    }
+  ],
+
+  reject: [
+    {
+      code:
+        "a {\n  background: url(\n    'short'\n  );\n  color: aaaaaaaaa bbbbbbbbb cccccccc;\n}",
+      message: messages.expected(20),
+      description:
+        "long non-url line after a multi-line url() should still be flagged",
+      line: 5,
+      column: 38
+    },
+    {
+      code: "/* url( */\na { color: aaa bbbb cccc ddddd; }",
+      message: messages.expected(20),
+      description:
+        "literal text 'url(' inside a comment must not silence long-line warnings on later lines",
+      line: 2,
+      column: 33
+    }
+  ]
+});
