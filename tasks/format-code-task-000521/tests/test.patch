+from __future__ import division
+
+import errno
+import os
+import shutil
+import sys
+import tempfile
+import unittest
+
+
+REPO = "/workspace/repo"
+FIXTURES = "/workspace/repo/usercase-test-coderl/fixtures"
+
+if REPO not in sys.path:
+    sys.path.insert(0, REPO)
+if FIXTURES not in sys.path:
+    sys.path.insert(0, FIXTURES)
+
+from pyabm import rc_params_management
+
+
+START_MARKER = "###***START OF RC DEFINITION***###"
+
+
+def text_from_lines(lines):
+    return "\n".join(lines) + "\n"
+
+
+def definition_path(module_name):
+    if module_name == "pyabm":
+        return os.path.join(REPO, "pyabm", "rcparams.default")
+    return os.path.join(FIXTURES, module_name, "rcparams.default")
+
+
+def read_definition_descriptors(module_names):
+    descriptors = []
+    for module_name in module_names:
+        handle = open(definition_path(module_name), "r")
+        try:
+            started = False
+            for raw_line in handle:
+                line = raw_line.rstrip("\n")
+                if not started:
+                    if line == START_MARKER:
+                        started = True
+                    continue
+                stripped = line.strip()
+                if stripped == "" or stripped.startswith("#"):
+                    descriptors.append(("literal", line))
+                    continue
+                before_comment, marker, comment_rest = line.partition("#")
+                key = before_comment.partition(":")[0].strip("'\" ")
+                if key:
+                    descriptors.append(("param", key, marker + comment_rest))
+                else:
+                    descriptors.append(("literal", line))
+        finally:
+            handle.close()
+    return descriptors
+
+
+def make_initialized_manager(seed_fixture="seed_12345.pyabmrc"):
+    manager = rc_params_management()
+    manager.initialize("pyabm", custom_rc_file=os.path.join(FIXTURES, seed_fixture))
+    return manager
+
+
+class RcWriteFileAcceptanceTest(unittest.TestCase):
+
+    def setUp(self):
+        self.tmpdir = tempfile.mkdtemp(prefix="pyabm-rc-write-")
+
+    def tearDown(self):
+        shutil.rmtree(self.tmpdir)
+
+    def read_file(self, path):
+        handle = open(path, "r")
+        try:
+            return handle.read()
+        finally:
+            handle.close()
+
+    def assert_output_matches_loaded_definitions(self, manager, output_path,
+                                                 module_names=("pyabm",),
+                                                 expected_header_lines=None):
+        contents = self.read_file(output_path)
+        descriptors = read_definition_descriptors(module_names)
+        first_body_line = descriptors[0][1]
+        lines = contents.splitlines()
+        body_start = None
+        for index, line in enumerate(lines):
+            if line == first_body_line and index > 0 and lines[index - 1] == "":
+                body_start = index
+                break
+        self.assertNotEqual(body_start, None)
+        header_lines = lines[:body_start - 1]
+        body_lines = lines[body_start:]
+
+        if expected_header_lines is None:
+
+            self.assertNotEqual(header_lines, [])
+            self.assertNotEqual(header_lines[-1], "")
+        else:
+            self.assertEqual(header_lines, expected_header_lines)
+        self.assertEqual(lines[body_start - 1], "")
+
+
+
+        self.assertEqual(len(body_lines), len(descriptors))
+        for body_line, descriptor in zip(body_lines, descriptors):
+            if descriptor[0] == "literal":
+                self.assertEqual(body_line, descriptor[1])
+                continue
+            key, inline_comment = descriptor[1], descriptor[2]
+            self.assertTrue(body_line.startswith("%s : " % key))
+            suffix = ""
+            if inline_comment:
+                suffix = " " + inline_comment
+                self.assertTrue(body_line.endswith(suffix))
+            value_text = body_line[len("%s : " % key):]
+            if suffix:
+                value_text = value_text[:-len(suffix)]
+            self.assertEqual(value_text, str(manager.get_params()[key]))
+
+    def test_default_header_ordered_body_active_values_and_no_mutation(self):
+
+
+
+        manager = make_initialized_manager()
+        params = manager.get_params()
+        params.update({"user.extra.setting": "SHOULD_NOT_APPEAR"})
+        output_path = os.path.join(self.tmpdir, "model.pyabmrc")
+
+        self.assertEqual(manager.is_initialized(), True)
+        self.assertEqual(manager.is_validated(), True)
+        self.assertEqual(len(params), 15)
+        self.assertEqual(params["random_seed"], 12345)
+        self.assertEqual(params["batchrun.num_runs"], 20)
+        self.assertEqual(params["email_log"], False)
+
+        result = manager.write_RC_file(output_path)
+
+        self.assertEqual(result, None)
+        self.assertEqual(params["random_seed"], 12345)
+        self.assertEqual(params["batchrun.num_runs"], 20)
+        self.assertEqual(params["email_log"], False)
+        self.assertEqual(params["user.extra.setting"], "SHOULD_NOT_APPEAR")
+
+        self.assert_output_matches_loaded_definitions(manager, output_path)
+        self.assertEqual("user.extra.setting" in self.read_file(output_path), False)
+        self.assertEqual("SHOULD_NOT_APPEAR" in self.read_file(output_path), False)
+
+    def test_custom_docstring_replaces_header_with_one_blank_line(self):
+
+
+
+        manager = make_initialized_manager()
+        output_path = os.path.join(self.tmpdir, "custom.pyabmrc")
+
+        result = manager.write_RC_file(output_path, docstring="# My model configuration")
+
+        self.assertEqual(result, None)
+
+
+        self.assert_output_matches_loaded_definitions(
+            manager, output_path, expected_header_lines=["# My model configuration"])
+
+    def test_loaded_definition_inline_comments_are_preserved(self):
+
+
+
+        manager = make_initialized_manager()
+        manager.load_default_params("rc_fixture_defaults")
+        output_path = os.path.join(self.tmpdir, "inline.pyabmrc")
+
+        result = manager.write_RC_file(output_path, docstring="# My model configuration")
+
+        self.assertEqual(result, None)
+        expected_tail = text_from_lines([
+            "random_seed : 12345",
+            "# Fixture Parameters",
+            "fixture.enabled : True # inline switch",
+            "",
+            "fixture.count : 7",
+        ])
+        self.assertEqual(self.read_file(output_path).endswith(expected_tail), True)
+
+    def test_repeated_write_overwrites_existing_file(self):
+
+
+
+        manager = make_initialized_manager()
+        output_path = os.path.join(self.tmpdir, "overwrite.pyabmrc")
+
+        first_result = manager.write_RC_file(output_path, docstring="# First")
+        second_result = manager.write_RC_file(output_path, docstring="# My model configuration")
+
+        self.assertEqual(first_result, None)
+        self.assertEqual(second_result, None)
+
+        self.assert_output_matches_loaded_definitions(
+            manager, output_path, expected_header_lines=["# My model configuration"])
+        self.assertEqual("stale content" in self.read_file(output_path), False)
+        self.assertEqual("# First" in self.read_file(output_path), False)
+
+    def test_open_failure_propagates_specific_ioerror(self):
+
+
+
+        manager = make_initialized_manager()
+        missing_parent_path = os.path.join(self.tmpdir, "missing", "out.pyabmrc")
+
+        with self.assertRaises(IOError) as caught:
+            manager.write_RC_file(missing_parent_path)
+
+
+        self.assertEqual(caught.exception.errno, errno.ENOENT)
+        self.assertEqual(os.path.basename(caught.exception.filename), "out.pyabmrc")
+
+    def test_two_managers_write_their_own_current_seed_values(self):
+
+
+
+        first = make_initialized_manager("seed_11111.pyabmrc")
+        second = make_initialized_manager("seed_22222.pyabmrc")
+        first.get_params().update({"user.extra.setting": "FIRST_ONLY"})
+        first_path = os.path.join(self.tmpdir, "first.pyabmrc")
+        second_path = os.path.join(self.tmpdir, "second.pyabmrc")
+
+        first_result = first.write_RC_file(first_path, docstring="# First")
+        second_result = second.write_RC_file(second_path, docstring="# Second")
+
+        self.assertEqual(first_result, None)
+        self.assertEqual(second_result, None)
+        self.assertEqual(first.get_params()["random_seed"], 11111)
+        self.assertEqual(second.get_params()["random_seed"], 22222)
+        self.assertEqual("random_seed : 11111" in self.read_file(first_path), True)
+        self.assertEqual("random_seed : 22222" in self.read_file(first_path), False)
+        self.assertEqual("random_seed : 22222" in self.read_file(second_path), True)
+        self.assertEqual("random_seed : 11111" in self.read_file(second_path), False)
+        self.assertEqual("FIRST_ONLY" in self.read_file(second_path), False)
+
+    def test_repeated_write_cycles_produce_complete_files(self):
+
+
+
+        manager = make_initialized_manager()
+        paths = []
+
+        for index in range(30):
+            output_path = os.path.join(self.tmpdir, "cycle-%03d.pyabmrc" % index)
+            paths.append(output_path)
+            self.assertEqual(manager.write_RC_file(output_path, docstring="# Cycle"), None)
+
+
+
+        self.assert_output_matches_loaded_definitions(
+            manager, paths[0], expected_header_lines=["# Cycle"])
+        self.assert_output_matches_loaded_definitions(
+            manager, paths[-1], expected_header_lines=["# Cycle"])
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
