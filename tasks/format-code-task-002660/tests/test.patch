+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+if [ ! -x node_modules/.bin/ava ] || [ ! -d node_modules/tsx ]; then
+	echo "local: offline dependencies are missing; refusing to run npm install" >&2
+	exit 1
+fi
+exec env NODE_OPTIONS='--import=tsx/esm' ./node_modules/.bin/ava /workspace/repo/usercase-test-coderl/calculate-retry-delay.test.ts
