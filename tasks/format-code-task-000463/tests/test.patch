diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,114 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+
+export GOTOOLCHAIN=local
+export GOPROXY=off
+export GOSUMDB=off
+export GOFLAGS="${GOFLAGS:-} -mod=readonly -buildvcs=false"
+
+if ! ( cd /workspace/repo && make build ); then
+  echo "FAIL: build" >&2
+  exit 1
+fi
+BIN=/workspace/repo/asdf
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || exit 1
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+assert_provider_lines_match() {
+  local actual=$1
+  local expected=$2
+
+  awk 'NF == 2 { print $1 " " $2 }' "$actual" | sort >actual_providers
+  sort "$expected" >expected_providers
+  cmp -s actual_providers expected_providers || fail "$3 provider lines: $(cat "$actual")"
+}
+
+assert_no_provider_lines() {
+  local actual=$1
+
+  ! awk 'NF == 2 { found = 1 } END { exit found ? 0 : 1 }' "$actual" || fail "$2 provider stdout should not contain provider lines, got: $(cat "$actual")"
+}
+
+make_dummy_install() {
+  local data_dir=$1
+  local version=$2
+  mkdir -p "$data_dir/plugins/dummy" "$data_dir/installs/dummy/$version/bin"
+  printf '#!/usr/bin/env bash\necho dummy-%s\n' "$version" > "$data_dir/installs/dummy/$version/bin/dummy"
+  chmod +x "$data_dir/installs/dummy/$version/bin/dummy"
+}
+
+
+
+
+
+
+
+
+
+
+DATA_F1="$TMP/data-f1"
+make_dummy_install "$DATA_F1" "3.0"
+make_dummy_install "$DATA_F1" "1.0"
+HOME="$TMP/home-f1" ASDF_DATA_DIR="$DATA_F1" "$BIN" reshim dummy >reshim_out 2>reshim_err
+reshim_ec=$?
+[ "$reshim_ec" -eq 0 ] || fail "F1 reshim exit $reshim_ec; want 0; stderr: $(cat reshim_err)"
+
+HOME="$TMP/home-f1" ASDF_DATA_DIR="$DATA_F1" "$BIN" shimversions dummy >out 2>err
+ec=$?
+printf 'dummy 3.0\ndummy 1.0\n' >expected
+[ "$ec" -eq 0 ] || fail "F1 shimversions exit $ec; want 0; stderr: $(cat err)"
+assert_provider_lines_match out expected "F1"
+
+
+
+
+DATA_F2="$TMP/data-f2"
+mkdir -p "$DATA_F2/shims"
+printf '#!/usr/bin/env bash\n# asdf-plugin: solo 9.9\nexec asdf exec "solo" "$@"' >"$DATA_F2/shims/solo"
+HOME="$TMP/home-f2" ASDF_DATA_DIR="$DATA_F2" "$BIN" shimversions solo >out 2>err
+ec=$?
+printf 'solo 9.9\n' >expected
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0; stderr: $(cat err)"
+assert_provider_lines_match out expected "F2"
+
+
+
+
+HOME="$TMP/home-f3" ASDF_DATA_DIR="$TMP/data-f3" "$BIN" shimversions >out 2>err
+ec=$?
+printf 'usage: asdf shimversions <command>\n' >expected_err
+[ "$ec" -ne 0 ] || fail "F3 exit $ec; want nonzero"
+assert_no_provider_lines out "F3"
+cmp -s err expected_err || fail "F3 stderr: $(cat err)"
+
+
+
+
+env -u HOME ASDF_DATA_DIR="$TMP/data-f4" "$BIN" shimversions dummy >out 2>err
+ec=$?
+[ "$ec" -ne 0 ] || fail "F4 exit $ec; want nonzero"
+assert_no_provider_lines out "F4"
+
+case "$(cat err)" in
+  "error loading config: "?*) ;;
+  *) fail "F4 stderr: $(cat err)" ;;
+esac
+
+
+
+
+DATA_F5="$TMP/data-f5"
+mkdir -p "$DATA_F5/shims"
+HOME="$TMP/home-f5" ASDF_DATA_DIR="$DATA_F5" "$BIN" shimversions absent >out 2>err
+ec=$?
+[ "$ec" -ne 0 ] || fail "F5 exit $ec; want nonzero"
+assert_no_provider_lines out "F5"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
