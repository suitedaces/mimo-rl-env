@@ -0,0 +1,27 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+pip install -e . --no-input 2>/dev/null
+pip install pytest --no-input 2>/dev/null
+pip install delegator.py --no-input 2>/dev/null
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest \
+      tests/test_base.py \
+      tests/test_currency.py \
+      tests/test_errors.py \
+      tests/test_utils.py \
+      -q
+    ;;
+  new)
+    python3 -m pytest tests/test_kz.py -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
