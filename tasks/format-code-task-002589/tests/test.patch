@@ -0,0 +1,82 @@
+# -*- coding: utf-8 -*-
+from __future__ import unicode_literals
+
+import io
+import os
+import re
+from unittest import TestCase
+
+from num2words import num2words
+
+
+class Num2WordsKZTest(TestCase):
+    def test_to_cardinal_representative_values(self):
+        cases = (
+            (0, "нөл"),
+            (7, "жеті"),
+            (23, "жиырма үш"),
+            (58, "елу сегіз"),
+            (145, "жүз қырық бес"),
+            (301, "үш жүз бір"),
+            (2869, "екі мың сегіз жүз алпыс тоғыз"),
+            (84932, "сексен төрт мың тоғыз жүз отыз екі"),
+        )
+        for value, expected in cases:
+            self.assertEqual(num2words(value, lang="kz"), expected)
+
+    def test_to_cardinal_large_grouping(self):
+        self.assertEqual(
+            num2words(1000000001, lang="kz"),
+            "бір миллиард бір",
+        )
+        self.assertEqual(
+            num2words(2003004, lang="kz"),
+            "екі миллион үш мың төрт",
+        )
+
+    def test_negative_numbers(self):
+        self.assertEqual(num2words(-7, lang="kz"), "минус жеті")
+        self.assertEqual(num2words(-23, lang="kz"), "минус жиырма үш")
+        self.assertEqual(
+            num2words(-789000125, lang="kz"),
+            "минус жеті жүз сексен тоғыз миллион жүз жиырма бес",
+        )
+
+    def test_decimal_numbers(self):
+        self.assertEqual(num2words(100.67, lang="kz"), "жүз бүтін алпыс жеті")
+        self.assertEqual(num2words(0.7, lang="kz"), "нөл бүтін жеті")
+        self.assertEqual(num2words(1.73, lang="kz"), "бір бүтін жетпіс үш")
+
+    def test_currency_kzt(self):
+        self.assertEqual(
+            num2words(25.24, lang="kz", to="currency", currency="KZT"),
+            "жиырма бес теңге, жиырма төрт тиын",
+        )
+        self.assertEqual(
+            num2words(1996.4, lang="kz", to="currency", currency="KZT"),
+            "бір мың тоғыз жүз тоқсан алты теңге, қырық тиын",
+        )
+        self.assertEqual(
+            num2words(632924.51, lang="kz", to="currency", currency="KZT"),
+            "алты жүз отыз екі мың тоғыз жүз жиырма төрт теңге, елу бір тиын",
+        )
+
+    def test_currency_usd(self):
+        self.assertEqual(
+            num2words(25.24, lang="kz", to="currency", currency="USD"),
+            "жиырма бес доллар, жиырма төрт цент",
+        )
+        self.assertEqual(
+            num2words(112.34, lang="kz", to="currency", currency="USD"),
+            "жүз он екі доллар, отыз төрт цент",
+        )
+
+    def test_readme_lists_kazakh_language_code(self):
+        root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+        with io.open(os.path.join(root, "README.rst"), encoding="utf-8") as fh:
+            readme = fh.read()
+
+        self.assertIsNotNone(
+            re.search(r"(?m)^\s*[*-]\s*.*(?:``kz``|`kz`|\bkz\b).*Kazakh", readme),
+            "README.rst should list Kazakh with the kz language code",
+        )
