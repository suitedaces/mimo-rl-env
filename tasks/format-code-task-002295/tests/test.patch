@@ -0,0 +1,346 @@
+
+
+
+
+
+
+
+import gc
+from pathlib import Path
+
+import h5py
+import numpy as np
+import pandas as pd
+import pytest
+
+from policyengine_core.data import Dataset
+from policyengine_us import Microsimulation
+from policyengine_us.data import USMultiYearDataset, USSingleYearDataset
+
+
+YEAR = 2024
+
+
+def _single_year_dataset(
+    employment_income=(50_000.0, 0.0),
+    age=(40.0, 10.0),
+    state_fips=(6, 36),
+) -> USSingleYearDataset:
+    ids = np.array([1, 2], dtype="int64")
+    return USSingleYearDataset(
+        person=pd.DataFrame(
+            {
+                "person_id": ids,
+                "person_household_id": ids,
+                "person_tax_unit_id": ids,
+                "person_spm_unit_id": ids,
+                "person_family_id": ids,
+                "person_marital_unit_id": ids,
+                "age": np.array(age),
+                "employment_income": np.array(employment_income),
+                "person_weight": np.array([1.0, 1.0]),
+            }
+        ),
+        household=pd.DataFrame(
+            {
+                "household_id": ids,
+                "state_fips": np.array(state_fips, dtype="int64"),
+                "household_weight": np.array([1.0, 1.0]),
+            }
+        ),
+        tax_unit=pd.DataFrame(
+            {
+                "tax_unit_id": ids,
+                "tax_unit_weight": np.array([1.0, 1.0]),
+            }
+        ),
+        spm_unit=pd.DataFrame(
+            {
+                "spm_unit_id": ids,
+                "spm_unit_weight": np.array([1.0, 1.0]),
+            }
+        ),
+        family=pd.DataFrame({"family_id": ids}),
+        marital_unit=pd.DataFrame({"marital_unit_id": ids}),
+        time_period=YEAR,
+    )
+
+
+def _entity_hdfstore_path(tmp_path: Path, name: str = "entity_level.h5") -> str:
+    path = str(tmp_path / name)
+    _single_year_dataset().save(path)
+    return path
+
+
+def _variable_centric_hdf5_path(tmp_path: Path) -> str:
+    path = str(tmp_path / "variable_centric.h5")
+    ids = np.array([1, 2], dtype="int64")
+    data = {
+        "person_id": ids,
+        "household_id": ids,
+        "spm_unit_id": ids,
+        "family_id": ids,
+        "tax_unit_id": ids,
+        "marital_unit_id": ids,
+        "person_household_id": ids,
+        "person_spm_unit_id": ids,
+        "person_family_id": ids,
+        "person_tax_unit_id": ids,
+        "person_marital_unit_id": ids,
+        "age": np.array([40.0, 10.0]),
+        "employment_income": np.array([50_000.0, 0.0]),
+        "state_fips": np.array([6, 36], dtype="int64"),
+    }
+    with h5py.File(path, "w") as file:
+        for variable, values in data.items():
+            file.create_dataset(f"{variable}/2024", data=values)
+    return path
+
+
+def test_explicit_entity_hdfstore_path_is_extended_and_calculates(tmp_path):
+
+
+
+    sim = Microsimulation(dataset=_entity_hdfstore_path(tmp_path))
+
+
+
+    assert isinstance(sim.dataset, USMultiYearDataset)
+
+
+    assert sim.dataset.years
+
+    assert sim.dataset.name
+
+    assert len(sim.dataset.years) > 1
+    assert sim.calculate("age", 2024).tolist() == [40.0, 10.0]
+
+
+    assert len(sim.calculate("age", sim.dataset.years[1])) == 2
+    assert sim.calculate("employment_income", 2024).tolist() == [50_000.0, 0.0]
+
+    assert len(sim.calculate("employment_income", sim.dataset.years[1])) == 2
+    assert len(sim.calculate("employment_income", sim.dataset.years[-1])) == 2
+    assert sim.calculate("state_code_str", 2024).tolist() == ["CA", "NY"]
+
+
+    assert len(sim.calculate("household_net_income", 2024)) == 2
+    assert len(sim.calculate("household_net_income", sim.dataset.years[1])) == 2
+
+
+def test_hf_dataset_url_resolves_to_entity_hdfstore_and_calculates(
+    tmp_path, monkeypatch
+):
+
+
+
+    local_path = _entity_hdfstore_path(tmp_path)
+
+    def fake_hf_hub_download(
+        repo_id, filename, repo_type="dataset", revision=None, **kwargs
+    ):
+
+
+        assert repo_id == "policyengine/example"
+        assert filename == "fixture/entity_level.h5"
+        assert repo_type == "dataset"
+        assert revision == "rev-1"
+        return local_path
+
+
+
+    def fake_core_hf_download(repo, repo_filename, version, local_dir=None, **kwargs):
+
+
+        assert repo == "datasets/policyengine"
+        assert repo_filename == "example/fixture/entity_level.h5"
+        assert version == "rev-1"
+        return local_path
+
+    monkeypatch.setattr("huggingface_hub.hf_hub_download", fake_hf_hub_download)
+    monkeypatch.setattr(
+        "policyengine_core.simulations.simulation.download_huggingface_dataset",
+        fake_core_hf_download,
+    )
+
+    sim = Microsimulation(
+        dataset=(
+            "hf://datasets/policyengine/example/"
+            "fixture/entity_level.h5@rev-1"
+        )
+    )
+
+
+    assert isinstance(sim.dataset, USMultiYearDataset)
+
+
+    assert sim.dataset.name
+    assert len(sim.dataset.years) > 1
+
+    assert len(sim.calculate("employment_income", sim.dataset.years[1])) == 2
+
+
+    state_codes = sim.calculate("state_code_str", 2024).tolist()
+    assert len(state_codes) == 2
+    assert all(isinstance(code, str) and code for code in state_codes)
+
+
+def test_default_dataset_uses_entity_loading_path(tmp_path, monkeypatch):
+
+
+
+    monkeypatch.setattr(
+        Microsimulation,
+        "default_dataset",
+        _entity_hdfstore_path(tmp_path),
+    )
+
+    sim = Microsimulation()
+
+
+    assert isinstance(sim.dataset, USMultiYearDataset)
+
+
+    assert sim.dataset.years
+    assert sim.dataset.name
+    assert len(sim.dataset.years) > 1
+    assert sim.calculate("employment_income", 2024).tolist() == [50_000.0, 0.0]
+
+    assert len(sim.calculate("employment_income", sim.dataset.years[1])) == 2
+
+
+def test_single_year_dataset_argument_is_extended_before_initialization():
+
+
+
+    source = _single_year_dataset()
+    sim = Microsimulation(dataset=source)
+
+
+    assert isinstance(sim.dataset, USMultiYearDataset)
+
+
+    assert sim.dataset.years[0] == int(source.time_period)
+    assert sim.dataset.name
+
+    assert len(sim.dataset.years) > 1
+    assert sim.calculate("age", 2024).tolist() == [40.0, 10.0]
+
+
+    assert len(sim.calculate("employment_income", sim.dataset.years[1])) == 2
+    assert len(sim.calculate("household_net_income", sim.dataset.years[1])) == 2
+
+
+def test_variable_centric_hdf5_path_uses_core_dataset_loader(tmp_path):
+
+
+
+    sim = Microsimulation(dataset=_variable_centric_hdf5_path(tmp_path))
+
+
+
+    assert isinstance(sim.dataset, Dataset)
+
+
+    assert sim.dataset.data_format
+    assert sim.dataset.time_period
+    assert sim.dataset.name
+    assert sim.calculate("age", 2024).tolist() == [40.0, 10.0]
+    assert sim.calculate("employment_income", 2024).tolist() == [50_000.0, 0.0]
+
+    assert len(sim.calculate("employment_income", 2025)) == 2
+
+
+    state_codes = sim.calculate("state_code_str", 2024).tolist()
+    assert len(state_codes) == 2
+    assert all(isinstance(code, str) and code for code in state_codes)
+
+
+def test_unresolved_string_path_raises_file_not_found():
+
+
+
+    with pytest.raises(FileNotFoundError) as excinfo:
+        Microsimulation(
+            dataset="/workspace/repo/usercase-test-coderl/fixtures/does_not_exist.h5"
+        )
+
+
+    assert isinstance(excinfo.value, FileNotFoundError)
+
+
+def test_two_microsimulations_keep_dataset_state_independent():
+
+
+
+    sim_a = Microsimulation(
+        dataset=_single_year_dataset(
+            employment_income=(50_000.0, 0.0),
+            state_fips=(6, 36),
+        )
+    )
+    sim_b = Microsimulation(
+        dataset=_single_year_dataset(
+            employment_income=(30_000.0, 10_000.0),
+            state_fips=(48, 12),
+        )
+    )
+
+
+
+    income_a = sim_a.calculate("employment_income", 2025).tolist()
+    income_b = sim_b.calculate("employment_income", 2025).tolist()
+    assert len(income_a) == 2
+    assert len(income_b) == 2
+    assert income_a != income_b
+
+
+    state_a = sim_a.calculate("state_code_str", 2024).tolist()
+    state_b = sim_b.calculate("state_code_str", 2024).tolist()
+    assert len(state_a) == 2
+    assert len(state_b) == 2
+    assert state_a != state_b
+    net_a = sim_a.calculate("household_net_income", 2024).tolist()
+    net_b = sim_b.calculate("household_net_income", 2024).tolist()
+    assert len(net_a) == 2
+    assert len(net_b) == 2
+    assert net_a != net_b
+
+
+def test_repeated_public_hdfstore_load_cleanup_is_idempotent(tmp_path):
+
+
+
+    path = _entity_hdfstore_path(tmp_path)
+    dataset = USSingleYearDataset(file_path=path)
+
+
+    assert dataset.name
+    assert dataset.load()["employment_income"].tolist() == [50_000.0, 0.0]
+    del dataset
+    gc.collect()
+    gc.collect()
+
+    reopened = USSingleYearDataset(file_path=path)
+
+    assert reopened.name
+    assert reopened.load()["employment_income"].tolist() == [50_000.0, 0.0]
+    del reopened
+    gc.collect()
+
+
+def test_repeated_public_hdfstore_loads_remain_usable(tmp_path):
+
+
+
+    path = _entity_hdfstore_path(tmp_path)
+
+    for _ in range(100):
+        dataset = USSingleYearDataset(file_path=path)
+
+
+        assert dataset.time_period
+        assert dataset.load()["age"].tolist() == [40.0, 10.0]
+        del dataset
+
+    gc.collect()
