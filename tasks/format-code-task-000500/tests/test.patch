+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+mkdir -p /root/go/src/github.com/aws
+ln -sfn /testbed /root/go/src/github.com/aws/amazon-ecs-agent
+export GO111MODULE=off
+export GO15VENDOREXPERIMENT=1
+export GOPATH=/root/go
+export PATH="$(pwd)/scripts/generate:${PATH}"
+
+
+TEST_PATCH=/testbed/mimo_test.patch
+
+case "${1:-}" in
+  base)
+    git apply -R --whitespace=nowarn "$TEST_PATCH"
+    go test -vet=off -race -timeout=25s -v \
+      github.com/aws/amazon-ecs-agent/agent/config \
+      github.com/aws/amazon-ecs-agent/agent/engine
+    rc=$?
+    git apply --whitespace=nowarn "$TEST_PATCH"
+    exit "$rc"
+    ;;
+  new)
+    go test -vet=off -race -timeout=25s -v github.com/aws/amazon-ecs-agent/agent/api \
+      -run '^(TestTaskJSONIncludesCPULimitWhenSet|TestTaskJSONIncludesMemoryLimitWhenSet|TestTaskJSONOmitsUnsetTaskLimits)$' -count=1
+    api_rc=$?
+    if [ "$api_rc" -ne 0 ]; then
+      exit "$api_rc"
+    fi
+
+    go test -vet=off -race -timeout=25s -v github.com/aws/amazon-ecs-agent/agent/config \
+      -run '^(TestTaskCPUMemLimitDefaultsEnabled|TestTaskCPUMemLimitCanBeDisabledByEnvironment|TestEnvironmentConfig)$' -count=1
+    config_rc=$?
+    if [ "$config_rc" -ne 0 ]; then
+      exit "$config_rc"
+    fi
+
+    go test -vet=off -race -timeout=25s -v github.com/aws/amazon-ecs-agent/agent/engine \
+      -run '^(TestCapabilitiesIncludesTaskCPUMemLimitWhenEnabledAndDockerSupportsIt|TestCapabilitiesDoesNotIncludeTaskCPUMemLimitWhenDisabledEvenIfDockerSupportsIt|TestCapabilitiesDisablesTaskCPUMemLimitWhenDockerTooOld)$' -count=1
+    exit "$?"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
