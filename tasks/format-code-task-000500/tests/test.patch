--- /dev/null
+++ b/agent/config/config_tasklimits_test.go
@@ -0,0 +1,37 @@
+package config
+
+import (
+	"os"
+	"testing"
+)
+
+const taskCPUMemLimitEnvVar = "ECS_ENABLE_TASK_CPU_MEM_LIMIT"
+
+func restoreEnvForTaskLimitTest(key string) func() {
+	oldValue, wasSet := os.LookupEnv(key)
+	return func() {
+		if wasSet {
+			os.Setenv(key, oldValue)
+		} else {
+			os.Unsetenv(key)
+		}
+	}
+}
+
+func TestTaskCPUMemLimitDefaultsEnabled(t *testing.T) {
+	defer restoreEnvForTaskLimitTest(taskCPUMemLimitEnvVar)()
+	os.Unsetenv(taskCPUMemLimitEnvVar)
+
+	if _, ok := os.LookupEnv(taskCPUMemLimitEnvVar); ok {
+		t.Fatalf("expected %s to be unset", taskCPUMemLimitEnvVar)
+	}
+}
+
+func TestTaskCPUMemLimitCanBeDisabledByEnvironment(t *testing.T) {
+	defer restoreEnvForTaskLimitTest(taskCPUMemLimitEnvVar)()
+	os.Setenv(taskCPUMemLimitEnvVar, "false")
+
+	if got := os.Getenv(taskCPUMemLimitEnvVar); got != "false" {
+		t.Fatalf("expected %s=false, got %q", taskCPUMemLimitEnvVar, got)
+	}
+}
diff --git a/agent/engine/docker_task_engine_tasklimits_windows_test.go b/agent/engine/docker_task_engine_tasklimits_windows_test.go
new file mode 100644
index 000000000..5b473d7bb
--- /dev/null
+++ b/agent/engine/docker_task_engine_tasklimits_windows_test.go
@@ -0,0 +1,51 @@
+//go:build windows
+// +build windows
+
+package engine
+
+import (
+	"os"
+	"testing"
+
+	"github.com/aws/amazon-ecs-agent/agent/ec2"
+	"github.com/aws/amazon-ecs-agent/agent/config"
+	"github.com/aws/amazon-ecs-agent/agent/engine/dockerclient"
+)
+
+func newWindowsTaskLimitConfig(t *testing.T) *config.Config {
+	cfg, err := config.NewConfig(ec2.NewBlackholeEC2MetadataClient())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return cfg
+}
+
+func TestTaskCPUMemLimitEnvCannotEnableOnWindows(t *testing.T) {
+	defer restoreEnvForTaskLimitEngineTest("ECS_ENABLE_TASK_CPU_MEM_LIMIT")()
+	defer restoreEnvForTaskLimitEngineTest("AWS_DEFAULT_REGION")()
+	os.Setenv("ECS_ENABLE_TASK_CPU_MEM_LIMIT", "true")
+	os.Setenv("AWS_DEFAULT_REGION", "us-west-2")
+
+	taskEngine, finish := taskLimitEngineWithConfigAndDockerVersions(t, newWindowsTaskLimitConfig(t), dockerclient.Version_1_22)
+	defer finish()
+
+	capabilities := taskEngine.Capabilities()
+	if containsTaskLimitCapability(capabilities, taskCPUMemLimitCapability) {
+		t.Fatalf("expected Windows not to advertise %s even when env requests enabling, got %#v", taskCPUMemLimitCapability, capabilities)
+	}
+}
+
+func TestTaskCPUMemLimitDisabledOnWindowsDefault(t *testing.T) {
+	defer restoreEnvForTaskLimitEngineTest("ECS_ENABLE_TASK_CPU_MEM_LIMIT")()
+	defer restoreEnvForTaskLimitEngineTest("AWS_DEFAULT_REGION")()
+	os.Unsetenv("ECS_ENABLE_TASK_CPU_MEM_LIMIT")
+	os.Setenv("AWS_DEFAULT_REGION", "us-west-2")
+
+	taskEngine, finish := taskLimitEngineWithConfigAndDockerVersions(t, newWindowsTaskLimitConfig(t), dockerclient.Version_1_22)
+	defer finish()
+
+	capabilities := taskEngine.Capabilities()
+	if containsTaskLimitCapability(capabilities, taskCPUMemLimitCapability) {
+		t.Fatalf("expected Windows default not to advertise %s, got %#v", taskCPUMemLimitCapability, capabilities)
+	}
+}
