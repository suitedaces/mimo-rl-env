--- /dev/null
+++ b/agent/api/task_tasklimits_test.go
@@ -0,0 +1,69 @@
+package api
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestTaskJSONIncludesCPULimitWhenSet(t *testing.T) {
+
+	var task Task
+	if err := json.Unmarshal([]byte(`{"CPULimit":2.5}`), &task); err != nil {
+		t.Fatal(err)
+	}
+
+	encoded, err := json.Marshal(&task)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var got map[string]interface{}
+	if err := json.Unmarshal(encoded, &got); err != nil {
+		t.Fatal(err)
+	}
+
+	if got["CPULimit"] != 2.5 {
+		t.Fatalf("expected CPULimit to round-trip as 2.5, got %#v in %s", got["CPULimit"], string(encoded))
+	}
+}
+
+func TestTaskJSONIncludesMemoryLimitWhenSet(t *testing.T) {
+
+	var task Task
+	if err := json.Unmarshal([]byte(`{"Memory":536870912}`), &task); err != nil {
+		t.Fatal(err)
+	}
+
+	encoded, err := json.Marshal(&task)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var got map[string]interface{}
+	if err := json.Unmarshal(encoded, &got); err != nil {
+		t.Fatal(err)
+	}
+
+	if got["Memory"] != float64(536870912) {
+		t.Fatalf("expected Memory to round-trip as 536870912, got %#v in %s", got["Memory"], string(encoded))
+	}
+}
+
+func TestTaskJSONOmitsUnsetTaskLimits(t *testing.T) {
+	encoded, err := json.Marshal(&Task{})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var got map[string]interface{}
+	if err := json.Unmarshal(encoded, &got); err != nil {
+		t.Fatal(err)
+	}
+
+	if _, ok := got["CPULimit"]; ok {
+		t.Fatalf("expected unset CPULimit to be omitted, got %s", string(encoded))
+	}
+	if _, ok := got["Memory"]; ok {
+		t.Fatalf("expected unset Memory to be omitted, got %s", string(encoded))
+	}
+}
diff --git a/agent/config/config_tasklimits_test.go b/agent/config/config_tasklimits_test.go
new file mode 100644
