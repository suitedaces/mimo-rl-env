diff --git a/agent/engine/docker_task_engine_tasklimits_test.go b/agent/engine/docker_task_engine_tasklimits_test.go
new file mode 100644
index 000000000..4a4668064
--- /dev/null
+++ b/agent/engine/docker_task_engine_tasklimits_test.go
@@ -0,0 +1,142 @@
+package engine
+
+import (
+	"os"
+	"testing"
+
+	"github.com/aws/amazon-ecs-agent/agent/ec2"
+	"github.com/aws/amazon-ecs-agent/agent/config"
+	"github.com/aws/amazon-ecs-agent/agent/engine/dockerclient"
+)
+
+const taskCPUMemLimitCapability = "ecs.capability.task-cpu-mem-limit"
+
+func containsTaskLimitCapability(capabilities []string, want string) bool {
+	for _, capability := range capabilities {
+		if capability == want {
+			return true
+		}
+	}
+	return false
+}
+
+func restoreEnvForTaskLimitEngineTest(key string) func() {
+	oldValue, wasSet := os.LookupEnv(key)
+	return func() {
+		if wasSet {
+			os.Setenv(key, oldValue)
+		} else {
+			os.Unsetenv(key)
+		}
+	}
+}
+
+func newConfigForTaskLimitEngineTest(t *testing.T) *config.Config {
+	cfg, err := config.NewConfig(ec2.NewBlackholeEC2MetadataClient())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return cfg
+}
+
+func taskLimitEngineWithConfigAndDockerVersions(t *testing.T, cfg *config.Config, versions ...dockerclient.DockerVersion) (TaskEngine, func()) {
+	ctrl, client, _, taskEngine, _, _ := mocks(t, cfg)
+	client.EXPECT().SupportedVersions().Return(versions).AnyTimes()
+	client.EXPECT().KnownVersions().Return(nil).AnyTimes()
+	client.EXPECT().Version().Return("Docker version test", nil).AnyTimes()
+	return taskEngine, ctrl.Finish
+}
+
+func TestTaskCPUMemLimitDefaultsEnabled(t *testing.T) {
+	defer restoreEnvForTaskLimitEngineTest("ECS_ENABLE_TASK_CPU_MEM_LIMIT")()
+	defer restoreEnvForTaskLimitEngineTest("AWS_DEFAULT_REGION")()
+	os.Unsetenv("ECS_ENABLE_TASK_CPU_MEM_LIMIT")
+	os.Setenv("AWS_DEFAULT_REGION", "us-west-2")
+
+	cfg := newConfigForTaskLimitEngineTest(t)
+	taskEngine, finish := taskLimitEngineWithConfigAndDockerVersions(t, cfg, dockerclient.Version_1_22)
+	defer finish()
+
+	capabilities := taskEngine.Capabilities()
+	if !containsTaskLimitCapability(capabilities, taskCPUMemLimitCapability) {
+		t.Fatalf("expected unset ECS_ENABLE_TASK_CPU_MEM_LIMIT to allow %s, got %#v", taskCPUMemLimitCapability, capabilities)
+	}
+}
+
+func TestTaskCPUMemLimitCanBeDisabledByEnvironment(t *testing.T) {
+	defer restoreEnvForTaskLimitEngineTest("ECS_ENABLE_TASK_CPU_MEM_LIMIT")()
+	defer restoreEnvForTaskLimitEngineTest("AWS_DEFAULT_REGION")()
+	os.Setenv("ECS_ENABLE_TASK_CPU_MEM_LIMIT", "false")
+	os.Setenv("AWS_DEFAULT_REGION", "us-west-2")
+
+	cfg := newConfigForTaskLimitEngineTest(t)
+	taskEngine, finish := taskLimitEngineWithConfigAndDockerVersions(t, cfg, dockerclient.Version_1_22)
+	defer finish()
+
+	capabilities := taskEngine.Capabilities()
+	if containsTaskLimitCapability(capabilities, taskCPUMemLimitCapability) {
+		t.Fatalf("expected ECS_ENABLE_TASK_CPU_MEM_LIMIT=false not to advertise %s, got %#v", taskCPUMemLimitCapability, capabilities)
+	}
+}
+
+func TestCapabilitiesIncludesTaskCPUMemLimitWhenEnabledAndDockerSupportsIt(t *testing.T) {
+	defer restoreEnvForTaskLimitEngineTest("ECS_ENABLE_TASK_CPU_MEM_LIMIT")()
+	defer restoreEnvForTaskLimitEngineTest("AWS_DEFAULT_REGION")()
+	os.Unsetenv("ECS_ENABLE_TASK_CPU_MEM_LIMIT")
+	os.Setenv("AWS_DEFAULT_REGION", "us-west-2")
+
+	cfg := newConfigForTaskLimitEngineTest(t)
+	taskEngine, finish := taskLimitEngineWithConfigAndDockerVersions(t, cfg,
+		dockerclient.Version_1_17,
+		dockerclient.Version_1_22,
+	)
+	defer finish()
+
+	capabilities := taskEngine.Capabilities()
+
+	if !containsTaskLimitCapability(capabilities, taskCPUMemLimitCapability) {
+		t.Fatalf("expected unset ECS_ENABLE_TASK_CPU_MEM_LIMIT to allow %s, got %#v", taskCPUMemLimitCapability, capabilities)
+	}
+}
+
+func TestCapabilitiesDoesNotIncludeTaskCPUMemLimitWhenDisabledEvenIfDockerSupportsIt(t *testing.T) {
+	defer restoreEnvForTaskLimitEngineTest("ECS_ENABLE_TASK_CPU_MEM_LIMIT")()
+	defer restoreEnvForTaskLimitEngineTest("AWS_DEFAULT_REGION")()
+	os.Setenv("ECS_ENABLE_TASK_CPU_MEM_LIMIT", "false")
+	os.Setenv("AWS_DEFAULT_REGION", "us-west-2")
+
+	cfg := newConfigForTaskLimitEngineTest(t)
+	taskEngine, finish := taskLimitEngineWithConfigAndDockerVersions(t, cfg, dockerclient.Version_1_22)
+	defer finish()
+
+	capabilities := taskEngine.Capabilities()
+
+	if containsTaskLimitCapability(capabilities, taskCPUMemLimitCapability) {
+		t.Fatalf("expected disabled feature not to advertise %s, got %#v", taskCPUMemLimitCapability, capabilities)
+	}
+}
+
+func TestCapabilitiesDisablesTaskCPUMemLimitWhenDockerTooOld(t *testing.T) {
+	defer restoreEnvForTaskLimitEngineTest("ECS_ENABLE_TASK_CPU_MEM_LIMIT")()
+	defer restoreEnvForTaskLimitEngineTest("AWS_DEFAULT_REGION")()
+	os.Setenv("ECS_ENABLE_TASK_CPU_MEM_LIMIT", "true")
+	os.Setenv("AWS_DEFAULT_REGION", "us-west-2")
+
+	cfg := newConfigForTaskLimitEngineTest(t)
+	taskEngineOldDocker, finishOldDocker := taskLimitEngineWithConfigAndDockerVersions(t, cfg, dockerclient.Version_1_17)
+
+	capabilities := taskEngineOldDocker.Capabilities()
+	finishOldDocker()
+
+	if containsTaskLimitCapability(capabilities, taskCPUMemLimitCapability) {
+		t.Fatalf("expected old Docker environment not to advertise %s, got %#v", taskCPUMemLimitCapability, capabilities)
+	}
+
+	taskEngineNewDocker, finishNewDocker := taskLimitEngineWithConfigAndDockerVersions(t, cfg, dockerclient.Version_1_22)
+	defer finishNewDocker()
+
+	capabilities = taskEngineNewDocker.Capabilities()
+	if containsTaskLimitCapability(capabilities, taskCPUMemLimitCapability) {
+		t.Fatalf("expected old Docker check to disable task CPU/memory limit for this engine, got %#v", capabilities)
+	}
+}
