diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,21 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+export PATH="/opt/node-22/bin:$PATH"
+pnpm install --frozen-lockfile
+
+case "${1:-}" in
+  base)
+    npx vitest run test/modules/number.spec.ts --testNamePattern "provides numbers with a given multipleOf of 0.5 steps|throws an error for multipleOf 0|should return a float between 0 and 1"
+    ;;
+  new)
+    npx vitest run test/modules/number.spec.ts --testNamePattern "provides numbers with at most the requested fraction digits|supports zero fraction digits|throws an error if fractionDigits and multipleOf are provided at the same time|throws an error for non-integer fractionDigits|throws an error for negative fractionDigits"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
