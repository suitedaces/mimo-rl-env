+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+dev-switch python3 3.11
+pip3 install --no-input -e . 'Django>=2.2,<3.0' pytest pytest-django lxml 'django-haystack>=2.4.1,<2.5.0'
+
+
+case "${1:-}" in
+  base)
+    python3 -m pytest tests/test_core.py tests/test_models.py -v
+    ;;
+  new)
+    python3 -m pytest tests/test_queryset_custom_ordering.py -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
