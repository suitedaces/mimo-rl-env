+def test_signature_preserves_var_keyword():
+
+    @deprecate_nonkeyword_arguments(version="1.1", allowed_args=["a"])
+    def func_with_kwargs(a, b=0, c=0, **kwargs):
+        return a + b + c
+
+    sig = inspect.signature(func_with_kwargs)
+    params = list(sig.parameters.values())
+
+    kwargs_param = params[-1]
+    assert kwargs_param.name == "kwargs"
+    assert kwargs_param.kind == inspect.Parameter.VAR_KEYWORD
+
+    by_name = {p.name: p for p in params}
+    assert by_name["a"].kind == inspect.Parameter.POSITIONAL_OR_KEYWORD
