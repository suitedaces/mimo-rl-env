+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+
+
+
+
+
+
+
+
+class ClassList {
+    constructor() {
+        this.values = new Set;
+    }
+
+    add(...names) {
+        for (let name of names) {
+            this.values.add(name);
+        }
+    }
+
+    remove(...names) {
+        for (let name of names) {
+            this.values.delete(name);
+        }
+    }
+
+    contains(name) {
+        return this.values.has(name);
+    }
+
+    toggle(name, force = undefined) {
+        let enabled = force ?? ! this.values.has(name);
+        if (enabled) {
+            this.values.add(name);
+        }
+        else {
+            this.values.delete(name);
+        }
+        return enabled;
+    }
+}
+
+class TestElement {
+    constructor(tagName) {
+        this.tagName = tagName.toUpperCase();
+        this.children = [];
+        this.parentNode = null;
+        this.attributes = new Map;
+        this.eventListeners = new Map;
+        this.style = { setProperty() {} };
+        this._classList = new ClassList;
+        this.textContent = '';
+        this.disabled = false;
+        this.id = '';
+        this.width = 0;
+        this.height = 0;
+        this.scrollLeft = 0;
+        this.scrollTop = 0;
+        this.offsetWidth = 100;
+        this.offsetHeight = 100;
+    }
+
+    get classList() {
+        return this._classList;
+    }
+
+    set classList(value) {
+        this._classList = new ClassList;
+        if (value instanceof ClassList) {
+            this._classList = value;
+        }
+        else {
+            for (let part of String(value).split(/\s+/).filter(Boolean)) {
+                this._classList.add(part);
+            }
+        }
+    }
+
+    setAttribute(key, value) {
+        this.attributes.set(key, String(value));
+        if (key === 'id') {
+            this.id = String(value);
+        }
+        else if (key === 'class') {
+            this.classList = new ClassList;
+            for (let part of String(value).split(/\s+/).filter(Boolean)) {
+                this.classList.add(part);
+            }
+        }
+    }
+
+    getAttribute(key) {
+        return this.attributes.get(key) ?? null;
+    }
+
+    append(...children) {
+        for (let child of children.flat()) {
+            if (child === undefined || child === null) {
+                continue;
+            }
+            let node = child instanceof TestElement ? child : new TestTextElement(String(child));
+            node.parentNode = this;
+            this.children.push(node);
+        }
+    }
+
+    querySelector(selector) {
+        let parts = selector.trim().split(/\s+/);
+        let current = this;
+        for (let part of parts) {
+            current = current?._descendants().find(el => matchesSelector(el, part)) ?? null;
+        }
+        return current;
+    }
+
+    _descendants() {
+        let out = [];
+        for (let child of this.children) {
+            if (child instanceof TestElement) {
+                out.push(child, ...child._descendants());
+            }
+        }
+        return out;
+    }
+
+    addEventListener(type, listener) {
+        if (! this.eventListeners.has(type)) {
+            this.eventListeners.set(type, []);
+        }
+        this.eventListeners.get(type).push(listener);
+    }
+
+    dispatchEvent(ev) {
+        ev.target ??= this;
+        ev.currentTarget = this;
+        ev.defaultPrevented = false;
+        ev.stopPropagation ??= () => {};
+        ev.preventDefault ??= () => { ev.defaultPrevented = true; };
+        for (let listener of this.eventListeners.get(ev.type) ?? []) {
+            listener(ev);
+        }
+        return ! ev.defaultPrevented;
+    }
+
+    closest(selector) {
+        for (let el = this; el; el = el.parentNode) {
+            if (matchesSelector(el, selector)) {
+                return el;
+            }
+        }
+        return null;
+    }
+
+    contains(other) {
+        for (let el = other; el; el = el.parentNode) {
+            if (el === this) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    remove() {
+        if (this.parentNode) {
+            this.parentNode.children = this.parentNode.children.filter(child => child !== this);
+            this.parentNode = null;
+        }
+    }
+
+    removeAttribute(key) {
+        this.attributes.delete(key);
+    }
+
+    getBoundingClientRect() {
+        return {x: 0, y: 0, left: 0, top: 0, right: 100, bottom: 100, width: 100, height: 100};
+    }
+
+    getContext() {
+        return {
+            clearRect() {},
+            drawImage() {},
+            fillRect() {},
+            strokeRect() {},
+            beginPath() {},
+            moveTo() {},
+            lineTo() {},
+            stroke() {},
+            save() {},
+            restore() {},
+            translate() {},
+            scale() {},
+            rotate() {},
+            fillText() {},
+            measureText() {
+                return {width: 0};
+            },
+        };
+    }
+}
+
+class TestTextElement extends TestElement {
+    constructor(text) {
+        super('#text');
+        this.textContent = text;
+    }
+}
+
+function matchesSelector(el, selector) {
+    if (! (el instanceof TestElement)) {
+        return false;
+    }
+    if (selector.startsWith('#')) {
+        return el.id === selector.slice(1);
+    }
+    if (selector.startsWith('.')) {
+        return el.classList.contains(selector.slice(1));
+    }
+    let idIndex = selector.indexOf('#');
+    if (idIndex >= 0) {
+        return (
+            el.tagName.toLowerCase() === selector.slice(0, idIndex) &&
+            el.id === selector.slice(idIndex + 1)
+        );
+    }
+    return el.tagName.toLowerCase() === selector.toLowerCase();
+}
+
+function buildEditorDocument() {
+    let body = new TestElement('body');
+    let main = new TestElement('main');
+    main.setAttribute('id', 'editor');
+    let menubar = new TestElement('div');
+    menubar.classList.add('-menubar');
+    let viewport = new TestElement('div');
+    viewport.classList.add('editor-canvas');
+    let container = new TestElement('div');
+    container.classList.add('-container');
+    viewport.append(container);
+    let statusbar = new TestElement('div');
+    statusbar.setAttribute('id', 'editor-statusbar');
+    let palette = new TestElement('div');
+    palette.classList.add('-palette');
+    let tools = new TestElement('div');
+    tools.classList.add('-tools');
+    main.append(menubar, viewport, statusbar, palette, tools);
+    body.append(main);
+    return {
+        body,
+        documentElement: new TestElement('html'),
+        createElement: tag => new TestElement(tag),
+        createElementNS: (_ns, tag) => new TestElement(tag),
+        activeElement: null,
+    };
+}
+
+function installBrowserGlobals() {
+    globalThis.Node = TestElement;
+    globalThis.CanvasRenderingContext2D = class {};
+    globalThis.DOMRect = class {
+        constructor(x, y, width, height) {
+            Object.assign(this, {x, y, width, height, left: x, top: y, right: x + width, bottom: y + height});
+        }
+    };
+    globalThis.document = buildEditorDocument();
+    globalThis.window = {
+        navigator: {platform: 'Linux x86_64'},
+        eventListeners: new Map,
+        localStorage: {
+            getItem() {
+                return null;
+            },
+            setItem() {},
+        },
+        addEventListener(type, listener) {
+            if (! this.eventListeners.has(type)) {
+                this.eventListeners.set(type, []);
+            }
+            this.eventListeners.get(type).push(listener);
+        },
+        removeEventListener() {},
+        dispatchEvent(ev) {
+            ev.target ??= this;
+            ev.defaultPrevented = false;
+            ev.stopPropagation ??= () => {};
+            ev.preventDefault ??= () => { ev.defaultPrevented = true; };
+            for (let listener of this.eventListeners.get(ev.type) ?? []) {
+                listener(ev);
+            }
+            return ! ev.defaultPrevented;
+        },
+        setTimeout,
+        clearTimeout,
+    };
+    globalThis.localStorage = globalThis.window.localStorage;
+    globalThis.location = 'http://localhost/';
+}
+
+installBrowserGlobals();
+const {Editor} = await import('../js/editor/main.js');
+
+function makeConductor() {
+    return {
+        tilesets: {
+            ll: {
+                size_x: 1,
+                size_y: 1,
+                draw() {},
+                draw_type() {},
+                blit_to_canvas() {},
+            },
+        },
+        stored_game: {
+            editor_metadata: {key: 'pack'},
+            level_metadata: [],
+        },
+        player: {
+            state: 'stopped',
+            set_state() {},
+        },
+    };
+}
+
+function attachUndoUi(editor) {
+    editor.undo_button = document.createElement('button');
+    editor.redo_button = document.createElement('button');
+    editor.save_button = document.createElement('button');
+    editor.stored_level = {editor_metadata: {key: 'level'}};
+    editor.modified = false;
+}
+
+function makeUndoReadyEditor() {
+    let editor = new Editor(makeConductor());
+    attachUndoUi(editor);
+    editor.reset_undo();
+    return editor;
+}
+
+function snapshot(editor, value, rehoverCount = 0) {
+    return {
+        value,
+        modified: editor.modified,
+        undoDisabled: editor.undo_button.disabled,
+        redoDisabled: editor.redo_button.disabled,
+        saveDisabled: editor.save_button.disabled,
+        rehoverCount,
+    };
+}
+
+function assertSaveButtonConsistent(editor) {
+
+    assert.equal(editor.save_button.disabled, ! (
+        editor.stored_level && editor.modified && editor.conductor.stored_game.editor_metadata));
+}
+
+test('redo replays an undone edit and restores undo/save/button state', () => {
+
+
+    let editor = makeUndoReadyEditor();
+    let value = 'initial';
+    let rehoverCount = 0;
+    editor.mouse_op = {rehover() { rehoverCount += 1; }};
+
+
+    assert.deepEqual(snapshot(editor, value, rehoverCount), {
+        value: 'initial',
+        modified: false,
+        undoDisabled: true,
+        redoDisabled: true,
+        saveDisabled: true,
+        rehoverCount: 0,
+    });
+
+    editor._do(() => { value = 'first edit'; }, () => { value = 'initial'; });
+
+    assert.deepEqual(snapshot(editor, value, rehoverCount), {
+        value: 'first edit',
+        modified: false,
+        undoDisabled: true,
+        redoDisabled: true,
+        saveDisabled: true,
+        rehoverCount: 0,
+    });
+
+    editor.commit_undo();
+
+    assert.deepEqual(snapshot(editor, value, rehoverCount), {
+        value: 'first edit',
+        modified: true,
+        undoDisabled: false,
+        redoDisabled: true,
+        saveDisabled: false,
+        rehoverCount: 0,
+    });
+
+    editor.undo();
+    let rehoverBeforeRedo = rehoverCount;
+
+    assert.deepEqual(snapshot(editor, value, rehoverCount), {
+        value: 'initial',
+        modified: true,
+        undoDisabled: true,
+        redoDisabled: false,
+        saveDisabled: false,
+        rehoverCount: rehoverBeforeRedo,
+    });
+
+    editor.redo();
+
+    assert.equal(value, 'first edit');
+    assert.equal(editor.undo_button.disabled, false);
+    assert.equal(editor.redo_button.disabled, true);
+    assert.equal(rehoverCount, rehoverBeforeRedo + 1);
+    assertSaveButtonConsistent(editor);
+
+    editor.undo();
+    assert.equal(value, 'initial');
+});
+
+test('redo with no redo history is a no-op and double redo is idempotent', () => {
+
+
+    let editor = makeUndoReadyEditor();
+    let value = 'initial';
+
+    editor.redo();
+
+    assert.deepEqual(snapshot(editor, value), {
+        value: 'initial',
+        modified: false,
+        undoDisabled: true,
+        redoDisabled: true,
+        saveDisabled: true,
+        rehoverCount: 0,
+    });
+
+    editor._do(() => { value = 'first edit'; }, () => { value = 'initial'; });
+    editor.commit_undo();
+    editor.undo();
+    editor.redo();
+    editor.redo();
+
+    assert.equal(value, 'first edit');
+    assert.equal(editor.undo_button.disabled, false);
+    assert.equal(editor.redo_button.disabled, true);
+    assertSaveButtonConsistent(editor);
+});
+
+test('new edit after undo discards stale redo branch', () => {
+
+
+    let editor = makeUndoReadyEditor();
+    let value = 'initial';
+
+    editor._do(() => { value = 'first edit'; }, () => { value = 'initial'; });
+    editor.commit_undo();
+    editor.undo();
+
+    assert.deepEqual(snapshot(editor, value), {
+        value: 'initial',
+        modified: true,
+        undoDisabled: true,
+        redoDisabled: false,
+        saveDisabled: false,
+        rehoverCount: 0,
+    });
+
+    editor._do(() => { value = 'second edit'; }, () => { value = 'initial'; });
+    editor.commit_undo();
+
+    assert.deepEqual(snapshot(editor, value), {
+        value: 'second edit',
+        modified: true,
+        undoDisabled: false,
+        redoDisabled: true,
+        saveDisabled: false,
+        rehoverCount: 0,
+    });
+
+    editor.redo();
+
+    assert.deepEqual(snapshot(editor, value), {
+        value: 'second edit',
+        modified: true,
+        undoDisabled: false,
+        redoDisabled: true,
+        saveDisabled: false,
+        rehoverCount: 0,
+    });
+});
+
+test('two editor instances keep independent undo and redo histories', () => {
+
+
+    let a = makeUndoReadyEditor();
+    let b = makeUndoReadyEditor();
+    let avalue = 'A0';
+    let bvalue = 'B0';
+
+    a._do(() => { avalue = 'A1'; }, () => { avalue = 'A0'; });
+    a.commit_undo();
+    a.undo();
+    b._do(() => { bvalue = 'B1'; }, () => { bvalue = 'B0'; });
+    b.commit_undo();
+
+
+    a.redo();
+    assert.equal(avalue, 'A1');
+    assert.equal(bvalue, 'B1');
+    b.redo();
+    assert.equal(avalue, 'A1');
+    assert.equal(bvalue, 'B1');
+    a.undo();
+    assert.equal(avalue, 'A0');
+    assert.equal(bvalue, 'B1');
+});
+
+test('menubar exposes Redo and Ctrl+Y/Ctrl+Shift+Z call redo while active', () => {
+
+
+    class SetupProbeEditor extends Editor {
+        set_canvas_zoom() {}
+        svg_icon(id) {
+            let el = document.createElement('svg');
+            el.setAttribute('data-icon', id);
+            return el;
+        }
+        select_tool(tool) {
+            this.current_tool = tool;
+        }
+        select_foreground_tile(_name, _source) {}
+        select_background_tile(_name, _source) {}
+        reset_undo() {
+            attachUndoUi(this);
+            super.reset_undo();
+        }
+    }
+
+    let editor = new SetupProbeEditor(makeConductor());
+    let redoCalls = 0;
+    editor.redo = () => { redoCalls += 1; };
+    editor.setup();
+
+    let buttons = document.body.querySelector('main#editor')._descendants()
+        .filter(el => el.tagName === 'BUTTON');
+    let labelledButtons = buttons.map(el => ({
+        el,
+        label: el.children.map(child => child.textContent).join('') || el.textContent,
+    }));
+    let redoButton = labelledButtons.find(({label}) => label === 'Redo')?.el;
+
+    assert.ok(redoButton);
+    redoButton.dispatchEvent({type: 'click'});
+    assert.equal(redoCalls, 1);
+
+    editor.active = false;
+    window.dispatchEvent({type: 'keydown', key: 'y', ctrlKey: true, shiftKey: false});
+    assert.equal(redoCalls, 1);
+
+    editor.active = true;
+    window.dispatchEvent({type: 'keydown', key: 'y', ctrlKey: true, shiftKey: false});
+    assert.equal(redoCalls, 2);
+    window.dispatchEvent({type: 'keydown', key: 'Z', ctrlKey: true, shiftKey: true});
+    assert.equal(redoCalls, 3);
+});
+
+test('repeated construct edit undo redo cycles remain bounded', () => {
+
+
+    for (let i = 0; i < 100; i++) {
+        let editor = makeUndoReadyEditor();
+        let value = 'initial';
+        editor._do(() => { value = 'cycle edit'; }, () => { value = 'initial'; });
+        editor.commit_undo();
+        editor.undo();
+        editor.redo();
+
+        assert.equal(value, 'cycle edit');
+        assert.equal(editor.undo_button.disabled, false);
+        assert.equal(editor.redo_button.disabled, true);
+        assertSaveButtonConsistent(editor);
+    }
+});
