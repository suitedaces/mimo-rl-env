diff --git a/test/azure/storage/list-pagination-contract-test.js b/test/azure/storage/list-pagination-contract-test.js
new file mode 100644
index 00000000..af6cd7be
--- /dev/null
+++ b/test/azure/storage/list-pagination-contract-test.js
@@ -0,0 +1,178 @@
+'use strict';
+
+var assert = require('assert');
+var nock = require('nock');
+var pkgcloud = require('../../../lib/pkgcloud');
+
+var endpoint = 'http://test-storage-account.blob.core.windows.net';
+var options = {
+  provider: 'azure',
+  storageAccount: 'test-storage-account',
+  storageAccessKey: 'test-storage-access-key'
+};
+
+function client() {
+  return pkgcloud.storage.createClient(options);
+}
+
+function getContainers(c) {
+  return new Promise(function (resolve, reject) {
+    c.getContainers(function (err, value) {
+      if (err) return reject(err);
+      resolve(value);
+    });
+  });
+}
+
+function getFiles(c, container) {
+  return new Promise(function (resolve, reject) {
+    c.getFiles(container, false, function (err, value) {
+      if (err) return reject(err);
+      resolve(value);
+    });
+  });
+}
+
+function getContainersError(c) {
+  return new Promise(function (resolve) {
+    var calls = 0;
+    c.getContainers(function (err, value) {
+      calls++;
+      setImmediate(function () { resolve({ err: err, value: value, calls: calls }); });
+    });
+  });
+}
+
+function getFilesError(c, container) {
+  return new Promise(function (resolve) {
+    var calls = 0;
+    c.getFiles(container, false, function (err, value) {
+      calls++;
+      setImmediate(function () { resolve({ err: err, value: value, calls: calls }); });
+    });
+  });
+}
+
+function getFilesWithoutDownload(c, container) {
+  return new Promise(function (resolve, reject) {
+    c.getFiles(container, function (err, value) {
+      if (err) return reject(err);
+      resolve(value);
+    });
+  });
+}
+
+async function run() {
+  var containersPage1 = '<?xml version="1.0"?><EnumerationResults><Containers>' +
+    '<Container><Name>alpha</Name></Container>' +
+    '<Container><Name>beta</Name></Container>' +
+    '</Containers><NextMarker>page 2/+</NextMarker></EnumerationResults>';
+  var containersPage2 = '<EnumerationResults><Containers>' +
+    '<Container><Name>gamma</Name></Container>' +
+    '</Containers><NextMarker /></EnumerationResults>';
+
+  var seenContainerMarker;
+  var containerScope = nock(endpoint)
+    .filteringPath(function (path) {
+      if (path.indexOf('marker=') !== -1) {
+        seenContainerMarker = path;
+        return '/?comp=list&marker=TOKEN';
+      }
+      return '/?comp=list';
+    })
+    .get('/?comp=list').reply(200, containersPage1)
+    .get('/?comp=list&marker=TOKEN').reply(200, containersPage2);
+  var containers = await getContainers(client());
+  assert.deepStrictEqual(containers.map(function (item) { return item.name; }),
+    ['alpha', 'beta', 'gamma']);
+  assert.ok(seenContainerMarker.indexOf('marker=page%202%2F%2B') !== -1);
+  assert.ok(seenContainerMarker.indexOf('comp=list') !== -1);
+  containers.forEach(function (item) {
+    assert.strictEqual(item.constructor.name, 'Container');
+  });
+  assert.strictEqual(containerScope.isDone(), true);
+
+  var emptyContainerScope = nock(endpoint)
+    .get('/?comp=list').reply(200,
+      '<EnumerationResults><Containers></Containers><NextMarker /></EnumerationResults>');
+  assert.deepStrictEqual(await getContainers(client()), []);
+  assert.strictEqual(emptyContainerScope.isDone(), true);
+
+  var filesPage1 = '<EnumerationResults><Blobs>' +
+    '<Blob><Name>one.txt</Name><Properties><Content-Length>3</Content-Length></Properties></Blob>' +
+    '<Blob><Name>two.txt</Name><Properties><Content-Length>4</Content-Length></Properties></Blob>' +
+    '</Blobs><NextMarker>resume-token</NextMarker></EnumerationResults>';
+  var filesPage2 = '<EnumerationResults><Blobs>' +
+    '<Blob><Name>three.txt</Name><Properties><Content-Length>5</Content-Length></Properties></Blob>' +
+    '</Blobs><NextMarker></NextMarker></EnumerationResults>';
+  var seenFileMarker;
+  var filesScope = nock(endpoint)
+    .filteringPath(function (path) {
+      if (path.indexOf('marker=') !== -1) {
+        seenFileMarker = path;
+        return '/docs?restype=container&comp=list&marker=TOKEN';
+      }
+      return '/docs?restype=container&comp=list';
+    })
+    .get('/docs?restype=container&comp=list').reply(200, filesPage1)
+    .get('/docs?restype=container&comp=list&marker=TOKEN').reply(200, filesPage2);
+  var files = await getFiles(client(), 'docs');
+  assert.deepStrictEqual(files.map(function (item) { return item.name; }),
+    ['one.txt', 'two.txt', 'three.txt']);
+  assert.ok(seenFileMarker.indexOf('marker=resume-token') !== -1);
+  assert.ok(seenFileMarker.indexOf('comp=list') !== -1);
+  assert.ok(seenFileMarker.indexOf('restype=container') !== -1);
+  files.forEach(function (item) {
+    assert.strictEqual(item.constructor.name, 'File');
+    assert.strictEqual(item.container, 'docs');
+  });
+  assert.strictEqual(filesScope.isDone(), true);
+
+  var emptyFilesScope = nock(endpoint)
+    .filteringPath(function (path) {
+      return path.indexOf('/docs?') === 0 ? '/docs?LIST' : path;
+    })
+    .get('/docs?LIST').reply(200,
+      '<EnumerationResults><Blobs></Blobs><NextMarker /></EnumerationResults>');
+  assert.deepStrictEqual(await getFilesWithoutDownload(client(), 'docs'), []);
+  assert.strictEqual(emptyFilesScope.isDone(), true);
+
+  var containerErrorScope = nock(endpoint)
+    .filteringPath(function (path) {
+      return path.indexOf('marker=') === -1 ? '/?comp=list' : '/?comp=list&marker=TOKEN';
+    })
+    .get('/?comp=list').reply(200, '<EnumerationResults><Containers>' +
+      '<Container><Name>not-returned</Name></Container></Containers>' +
+      '<NextMarker>next</NextMarker></EnumerationResults>')
+    .get('/?comp=list&marker=TOKEN').reply(503, 'temporarily unavailable');
+  var containerFailure = await getContainersError(client());
+  assert.ok(containerFailure.err);
+  assert.strictEqual(containerFailure.err.provider, 'azure');
+  assert.strictEqual(containerFailure.err.failCode, 'Service Unavailable');
+  assert.strictEqual(containerFailure.value, undefined);
+  assert.strictEqual(containerFailure.calls, 1);
+  assert.strictEqual(containerErrorScope.isDone(), true);
+
+  var fileErrorScope = nock(endpoint)
+    .filteringPath(function (path) {
+      return path.indexOf('marker=') === -1 ? '/docs?LIST' : '/docs?LIST&marker=TOKEN';
+    })
+    .get('/docs?LIST').reply(200, '<EnumerationResults><Blobs>' +
+      '<Blob><Name>not-returned.txt</Name><Properties /></Blob></Blobs>' +
+      '<NextMarker>next</NextMarker></EnumerationResults>')
+    .get('/docs?LIST&marker=TOKEN').reply(500, 'backend failure');
+  var fileFailure = await getFilesError(client(), 'docs');
+  assert.ok(fileFailure.err);
+  assert.strictEqual(fileFailure.err.provider, 'azure');
+  assert.strictEqual(fileFailure.err.failCode, 'Fault');
+  assert.strictEqual(fileFailure.value, undefined);
+  assert.strictEqual(fileFailure.calls, 1);
+  assert.strictEqual(fileErrorScope.isDone(), true);
+}
+
+run().then(function () {
+  process.stdout.write('azure listing contract passed\n');
+}).catch(function (err) {
+  process.stderr.write((err && err.stack) || String(err));
+  process.exitCode = 1;
+});
