+    def test_custom_db_scheme_no_engine_arg(self):
+
+
+        url = 'path.to.my.custom.backend://user:password@host:5431/database'
+        config = Env.db_url_config(url)
+
+        self.assertEqual(config['ENGINE'], 'path.to.my.custom.backend')
+        self.assertEqual(config['NAME'], 'database')
+        self.assertEqual(config['HOST'], 'host')
+        self.assertEqual(config['USER'], 'user')
+        self.assertEqual(config['PASSWORD'], 'password')
+        self.assertEqual(config['PORT'], 5431)
+
+    def test_custom_db_scheme_returns_non_empty(self):
+
+        url = 'my.custom.backend://user:password@host:5432/database'
+        config = Env.db_url_config(url)
+        self.assertNotEqual(config, {})
+        self.assertIn('ENGINE', config)
+
+    def test_custom_db_scheme_simple_word(self):
+
+        url = 'foobar://user:password@host:1234/dbname'
+        config = Env.db_url_config(url)
+        self.assertEqual(config['ENGINE'], 'foobar')
+
+    def test_engine_kwarg_with_custom_scheme(self):
+
+
+        url = 'custom.scheme://u:p@h:1/n'
+        config = Env.db_url_config(url, engine='my.custom.engine')
+        self.assertEqual(config['ENGINE'], 'my.custom.engine')
+
+    def test_builtin_scheme_translation_preserved(self):
+
+
+        config = Env.db_url_config('postgres://u:p@h:1/n')
+        self.assertEqual(config['ENGINE'], 'django.db.backends.postgresql_psycopg2')
+
+        config = Env.db_url_config('mysql://u:p@h:1/n')
+        self.assertEqual(config['ENGINE'], 'django.db.backends.mysql')
+
 
