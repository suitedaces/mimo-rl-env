+func TestEvalUnsupportedTypeCombinationReportsFailure(t *testing.T) {
+
+
+	got, ok := eval(t, baseContext(), `"hello" == split("hell-no", ",")`)
+	if ok != false {
+		t.Fatalf("ok = %v, want false", ok)
+	}
+
+	_ = got
+	again, againOK := eval(t, baseContext(), "int5 + 5")
+	assertIntValue(t, again, againOK, 10)
+}
+
+func TestEvalMissingFieldComparisonDoesNotPanic(t *testing.T) {
+	defer func() {
+
+		if recovered := recover(); recovered != nil {
+			t.Fatalf("panic = %#v, want no panic", recovered)
+		}
+	}()
+
+	got, ok := vm.Eval(baseContext(), expr.MustParse("missing > 21"))
+	assertBoolValue(t, got, ok, false)
+}
+
+func TestEvalIsReferentiallyTransparentForSameInput(t *testing.T) {
+	ctx := baseContext()
+	node := expr.MustParse("int5 + 5")
+
+	first, firstOK := vm.Eval(ctx, node)
+	second, secondOK := vm.Eval(ctx, node)
+
+	assertIntValue(t, first, firstOK, 10)
+	assertIntValue(t, second, secondOK, 10)
+}
+
+func TestEvalDoesNotMutateCallerContextOrParsedNode(t *testing.T) {
+	ctx := baseContext()
+	node := expr.MustParse("[1,2,3,5] contains int5")
+	beforeContext := snapshotContext(t, ctx)
+	wantContext := map[string]string{
+		"email": "string:bob@bob.com",
+		"hits":  "map[string]int:google.com=5",
+		"int5":  "int:5",
+		"int7":  "int:7",
+		"str5":  "string:5",
+		"urls":  "[]string:abc,123",
+	}
+
+	got, ok := vm.Eval(ctx, node)
+
+	assertBoolValue(t, got, ok, true)
+	if !reflect.DeepEqual(beforeContext, wantContext) {
+		t.Fatalf("initial context snapshot = %#v, want %#v", beforeContext, wantContext)
+	}
+	if after := snapshotContext(t, ctx); !reflect.DeepEqual(after, beforeContext) {
+		t.Fatalf("context after Eval = %#v, want unchanged %#v", after, beforeContext)
+	}
+
+	again, againOK := vm.Eval(ctx, node)
+	assertBoolValue(t, again, againOK, true)
+}
+
+func TestEvalNoGlobalStateWithInProcessNoise(t *testing.T) {
+	ctx := baseContext()
+
+	first, firstOK := eval(t, ctx, "int5 + 5")
+	noiseInt, noiseIntOK := eval(t, ctx, "toint(str5) + 6")
+	noiseBool, noiseBoolOK := eval(t, ctx, "missing > 21")
+	again, againOK := eval(t, ctx, "int5 + 5")
+
+	assertIntValue(t, first, firstOK, 10)
+	assertIntValue(t, noiseInt, noiseIntOK, 11)
+	assertBoolValue(t, noiseBool, noiseBoolOK, false)
+	assertIntValue(t, again, againOK, 10)
+}
+
+func TestEvalDoesNotCreateRelativeFilesystemSideEffects(t *testing.T) {
+	oldwd, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd failed: %v", err)
+	}
+	tmp := t.TempDir()
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatalf("Chdir(%q) failed: %v", tmp, err)
+	}
+	defer func() {
+		if err := os.Chdir(oldwd); err != nil {
+			t.Fatalf("restore cwd failed: %v", err)
+		}
+	}()
+
+	if before := dirEntries(t, tmp); !reflect.DeepEqual(before, []string{}) {
+		t.Fatalf("tmp dir entries before Eval = %#v, want []", before)
+	}
+	got, ok := eval(t, baseContext(), `email LIKE "bob*"`)
+	assertBoolValue(t, got, ok, true)
+	if after := dirEntries(t, tmp); !reflect.DeepEqual(after, []string{}) {
+		t.Fatalf("tmp dir entries after Eval = %#v, want []", after)
+	}
+}
+
+func eval(t *testing.T, ctx expr.EvalContext, expression string) (value.Value, bool) {
+	t.Helper()
+	return vm.Eval(ctx, expr.MustParse(expression))
+}
+
+func baseContext() *datasource.ContextSimple {
+	return datasource.NewContextSimpleNative(map[string]interface{}{
+		"int5":  int64(5),
+		"int7":  int64(7),
+		"str5":  "5",
+		"email": "bob@bob.com",
+		"urls":  []string{"abc", "123"},
+		"hits":  map[string]int64{"google.com": 5},
+	})
+}
+
+func assertIntValue(t *testing.T, got value.Value, ok bool, want int64) {
+	t.Helper()
+	if ok != true {
+		t.Fatalf("ok = %v, want true", ok)
+	}
+	iv, isInt := got.(value.IntValue)
+	if !isInt {
+		t.Fatalf("value type = %T, want value.IntValue", got)
+	}
+	if iv.Val() != want {
+		t.Fatalf("IntValue.Val() = %d, want %d", iv.Val(), want)
+	}
+}
+
+func assertNumericValue(t *testing.T, got value.Value, ok bool, want float64) {
+	t.Helper()
+	if ok != true {
+		t.Fatalf("ok = %v, want true", ok)
+	}
+	switch tv := got.(type) {
+	case value.IntValue:
+		if float64(tv.Val()) != want {
+			t.Fatalf("IntValue.Val() = %d, want numeric %v", tv.Val(), want)
+		}
+	case value.NumberValue:
+		if tv.Val() != want {
+			t.Fatalf("NumberValue.Val() = %v, want %v", tv.Val(), want)
+		}
+	default:
+		t.Fatalf("value type = %T, want numeric value", got)
+	}
+}
+
+func assertBoolValue(t *testing.T, got value.Value, ok bool, want bool) {
+	t.Helper()
+	if ok != true {
+		t.Fatalf("ok = %v, want true", ok)
+	}
+	bv, isBool := got.(value.BoolValue)
+	if !isBool {
+		t.Fatalf("value type = %T, want value.BoolValue", got)
+	}
+	if bv.Val() != want {
+		t.Fatalf("BoolValue.Val() = %v, want %v", bv.Val(), want)
+	}
+}
+
+func snapshotContext(t *testing.T, ctx expr.ContextReader) map[string]string {
+	t.Helper()
+	row := ctx.Row()
+	out := make(map[string]string, len(row))
+	for key, val := range row {
+		out[key] = snapshotValue(t, val)
+	}
+	return out
+}
+
+func snapshotValue(t *testing.T, val value.Value) string {
+	t.Helper()
+	switch tv := val.(type) {
+	case value.IntValue:
+		return fmt.Sprintf("%s:%d", tv.Type().String(), tv.Val())
+	case value.StringValue:
+		return fmt.Sprintf("%s:%s", tv.Type().String(), tv.Val())
+	case value.StringsValue:
+		return fmt.Sprintf("%s:%s", tv.Type().String(), strings.Join(tv.Val(), ","))
+	case value.MapIntValue:
+		keys := make([]string, 0, len(tv.Val()))
+		for key := range tv.Val() {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		parts := make([]string, 0, len(keys))
+		for _, key := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", key, tv.Val()[key]))
+		}
+		return fmt.Sprintf("%s:%s", tv.Type().String(), strings.Join(parts, ","))
+	default:
+		t.Fatalf("unhandled snapshot value type %T", val)
+		return ""
+	}
+}
+
+func dirEntries(t *testing.T, path string) []string {
+	t.Helper()
+	entries, err := os.ReadDir(path)
+	if err != nil {
+		t.Fatalf("ReadDir(%q) failed: %v", path, err)
+	}
+	names := make([]string, len(entries))
+	for i, entry := range entries {
+		names[i] = entry.Name()
+	}
+	sort.Strings(names)
+	return names
+}
