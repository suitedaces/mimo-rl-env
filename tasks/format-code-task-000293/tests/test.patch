new file mode 100644
index 0000000..7752691
--- /dev/null
+++ b/tests/helpers.js
@@ -0,0 +1,174 @@
+
+'use strict';
+
+var expect = require('chai').expect;
+var Atomizer = require('../src/atomizer');
+
+describe('Atomizer() helper classes', function () {
+    describe('getCss()', function () {
+        it('generates a rule from a helper declaration template with parameter substitution', function () {
+            var atomizer = new Atomizer(null, [
+                {
+                    type: 'helper',
+                    name: 'Foo',
+                    prefix: 'Foo',
+                    declaration: {
+                        'param0': '$0',
+                        'param1': '$1'
+                    }
+                }
+            ]);
+            var result = atomizer.getCss(['Foo(1,10px)']);
+            var expected = [
+                '.Foo\\(1\\,10px\\) {',
+                '  param0: 1;',
+                '  param1: 10px;',
+                '}'
+            ].join('\n');
+            expect(result).to.contain(expected);
+        });
+
+        it('substitutes a placeholder embedded inside a value', function () {
+            var atomizer = new Atomizer(null, [
+                {
+                    type: 'helper',
+                    name: 'Clamp',
+                    prefix: 'Clamp',
+                    declaration: {
+                        'lines': '$0',
+                        'height': '$1px'
+                    }
+                }
+            ]);
+            var result = atomizer.getCss(['Clamp(3,68)']);
+            var expected = [
+                '.Clamp\\(3\\,68\\) {',
+                '  lines: 3;',
+                '  height: 68px;',
+                '}'
+            ].join('\n');
+            expect(result).to.contain(expected);
+        });
+
+        it('supports a helper class with an empty argument list', function () {
+            var atomizer = new Atomizer(null, [
+                {
+                    type: 'helper',
+                    name: 'Bar',
+                    prefix: 'Bar',
+                    declaration: {
+                        'bar': 'foo'
+                    }
+                }
+            ]);
+            var result = atomizer.getCss(['Bar()']);
+            var expected = [
+                '.Bar\\(\\) {',
+                '  bar: foo;',
+                '}'
+            ].join('\n');
+            expect(result).to.contain(expected);
+        });
+
+        it('emits the helper\'s associated base rules verbatim', function () {
+            var atomizer = new Atomizer(null, [
+                {
+                    type: 'helper',
+                    name: 'Foo',
+                    prefix: 'Foo',
+                    declaration: {
+                        'param0': '$0'
+                    },
+                    rules: {
+                        'rule': {
+                            'foo': 'bar'
+                        }
+                    }
+                }
+            ]);
+            var result = atomizer.getCss(['Foo(9)']);
+            var base = [
+                'rule {',
+                '  foo: bar;',
+                '}'
+            ].join('\n');
+            var declaration = [
+                '.Foo\\(9\\) {',
+                '  param0: 9;',
+                '}'
+            ].join('\n');
+            expect(result).to.contain(base);
+            expect(result).to.contain(declaration);
+        });
+
+        it('lets helper rules and pattern rules coexist', function () {
+            var atomizer = new Atomizer(null, [
+                {
+                    type: 'pattern',
+                    name: 'Padding',
+                    prefix: 'P-',
+                    properties: ['padding']
+                },
+                {
+                    type: 'helper',
+                    name: 'Foo',
+                    prefix: 'Foo',
+                    declaration: {
+                        'a': '$0'
+                    }
+                }
+            ]);
+            var result = atomizer.getCss(['P-10px', 'Foo(5)']);
+            var pattern = [
+                '.P-10px {',
+                '  padding: 10px;',
+                '}'
+            ].join('\n');
+            var helper = [
+                '.Foo\\(5\\) {',
+                '  a: 5;',
+                '}'
+            ].join('\n');
+            expect(result).to.contain(pattern);
+            expect(result).to.contain(helper);
+        });
+
+        it('throws when a helper has no declaration', function () {
+            var atomizer = new Atomizer(null, [
+                {
+                    type: 'helper',
+                    name: 'Bad',
+                    prefix: 'Bad'
+                }
+            ]);
+            expect(function () {
+                atomizer.getCss(['Bad()']);
+            }).to.throw();
+        });
+    });
+
+    describe('findClassNames()', function () {
+        it('recognizes helper class names alongside pattern class names', function () {
+            var atomizer = new Atomizer(null, [
+                {
+                    type: 'pattern',
+                    name: 'Padding',
+                    prefix: 'P-',
+                    properties: ['padding']
+                },
+                {
+                    type: 'helper',
+                    name: 'LineClamp',
+                    prefix: 'LineClamp',
+                    declaration: {
+                        'a': '$0',
+                        'b': '$1'
+                    }
+                }
+            ]);
+            var result = atomizer.findClassNames('<div class="P-10px LineClamp(2,40px)"></div>');
+            expect(result).to.contain('LineClamp(2,40px)');
+            expect(result).to.contain('P-10px');
+        });
+    });
+});
