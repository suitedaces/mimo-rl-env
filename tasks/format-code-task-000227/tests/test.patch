+    def test_head_http11_too_few_bytes_does_not_close(self):
+
+
+
+
+
+        def app(environ, start_response):
+            start_response("200 OK", [("Content-Length", "3")])
+            return [b""]
+
+        inst = self._makeOne()
+        inst.version = "1.1"
+        inst.request.command = "HEAD"
+        inst.channel.server.application = app
+        inst.logger = DummyLogger()
+        inst.execute()
+        self.assertEqual(inst.close_on_finish, False)
+        self.assertEqual(len(inst.logger.logged), 0)
+
+    def test_get_http11_too_few_bytes_closes_and_warns(self):
+
+
+
+        def app(environ, start_response):
+            start_response("200 OK", [("Content-Length", "3")])
+            return [b"a"]
+
+        inst = self._makeOne()
+        inst.version = "1.1"
+        inst.request.command = "GET"
+        inst.channel.server.application = app
+        inst.logger = DummyLogger()
+        inst.execute()
+        self.assertEqual(inst.close_on_finish, True)
+        self.assertEqual(len(inst.logger.logged), 1)
+        self.assertIn("too few bytes", inst.logger.logged[0])
+
+    def test_get_http11_matching_bytes_no_close_no_warn(self):
+
+
+        def app(environ, start_response):
+            start_response("200 OK", [("Content-Length", "3")])
+            return [b"abc"]
+
+        inst = self._makeOne()
+        inst.version = "1.1"
+        inst.request.command = "GET"
+        inst.channel.server.application = app
+        inst.logger = DummyLogger()
+        inst.execute()
+        self.assertEqual(inst.close_on_finish, False)
+        self.assertEqual(len(inst.logger.logged), 0)
+
