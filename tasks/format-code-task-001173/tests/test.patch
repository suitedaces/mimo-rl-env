diff --git a/asyncconcat/test/abort-and-limits.task.js b/asyncconcat/test/abort-and-limits.task.js
new file mode 100644
index 0000000..bf34c21
--- /dev/null
+++ b/asyncconcat/test/abort-and-limits.task.js
@@ -0,0 +1,180 @@
+const assert = require('assert');
+const {Readable} = require('stream');
+const asyncConcat = require('..');
+
+async function expectRejected(promise, expected) {
+  try {
+    await promise;
+  } catch (error) {
+    if (expected instanceof Error) {
+      assert.strictEqual(error, expected);
+    } else {
+      assert(error instanceof expected, `expected ${expected.name}, got ${error}`);
+    }
+    return;
+  }
+
+  assert.fail('expected the concatenation promise to reject');
+}
+
+async function legacyCallsKeepTheirReturnShapes() {
+  const bytes = Buffer.from('legacy');
+  const bufferResult = await asyncConcat(Readable.from([bytes]));
+  assert(Buffer.isBuffer(bufferResult));
+  assert(bufferResult.equals(bytes));
+
+  assert.strictEqual(
+    await asyncConcat(Readable.from([bytes]), 'utf8'),
+    'legacy'
+  );
+}
+
+async function oversizedInputRejectsByByteLength() {
+  const source = new Readable({read() {}});
+  const result = asyncConcat(source, 'utf8', {maxBytes: 2});
+  let settled = false;
+  let rejection;
+  result.then(
+    () => { settled = true; },
+    error => { settled = true; rejection = error; }
+  );
+
+  source.push(Buffer.from('abc'));
+  await new Promise(resolve => setImmediate(resolve));
+
+  assert.strictEqual(settled, true, 'maxBytes must reject before the stream ends');
+  assert(rejection instanceof RangeError, `expected RangeError, got ${rejection}`);
+  source.destroy();
+}
+
+async function limitBoundaryAndChunkNormalization() {
+  const mixedChunks = [Buffer.from('ab'), 'cde', new Uint8Array([102])];
+  assert.strictEqual(
+    await asyncConcat(
+      Readable.from(mixedChunks, {objectMode: true}),
+      {encoding: 'utf8', maxBytes: 6}
+    ),
+    'abcdef'
+  );
+
+  assert.strictEqual(
+    await asyncConcat(
+      Readable.from([Buffer.from([0xe2, 0x82, 0xac])]),
+      'utf8',
+      {maxBytes: 3}
+    ),
+    '\u20ac'
+  );
+
+  await expectRejected(
+    asyncConcat(
+      Readable.from(['\u20ac'], {objectMode: true}),
+      {encoding: 'utf8', maxBytes: 2}
+    ),
+    RangeError
+  );
+
+  assert.strictEqual(
+    await asyncConcat(
+      Readable.from(['\u20ac'], {objectMode: true}),
+      {encoding: 'utf8', maxBytes: 3}
+    ),
+    '\u20ac'
+  );
+
+  assert.strictEqual(
+    await asyncConcat(
+      Readable.from([Buffer.from([0, 255])]),
+      'hex',
+      {maxBytes: 2}
+    ),
+    '00ff'
+  );
+
+  assert.strictEqual(
+    await asyncConcat(Readable.from([]), {encoding: 'utf8', maxBytes: 0}),
+    ''
+  );
+}
+
+async function positionalEncodingWinsOverTheOption() {
+  assert.strictEqual(
+    await asyncConcat(
+      Readable.from([Buffer.from('A')]),
+      'utf8',
+      {encoding: 'hex', maxBytes: 1}
+    ),
+    'A'
+  );
+}
+
+async function invalidMaxBytesRejects() {
+  for (const maxBytes of [-1, 1.5, NaN, Infinity, null, '2', true]) {
+    await expectRejected(
+      asyncConcat(Readable.from([Buffer.from('x')]), {maxBytes}),
+      RangeError
+    );
+  }
+}
+
+async function alreadyAbortedSignalRejectsWithItsReason() {
+  const controller = new AbortController();
+  const reason = new Error('already cancelled');
+  controller.abort(reason);
+
+  await expectRejected(
+    asyncConcat(Readable.from([Buffer.from('content')]), 'utf8', {signal: controller.signal}),
+    reason
+  );
+}
+
+async function abortDuringConsumptionRejectsWithItsReason() {
+  const controller = new AbortController();
+  const reason = new Error('cancel while reading');
+  const source = new Readable({
+    read() {}
+  });
+  const result = asyncConcat(source, 'utf8', {signal: controller.signal});
+
+  source.push(Buffer.from('first'));
+  controller.abort(reason);
+  source.push(null);
+
+  await expectRejected(result, reason);
+}
+
+async function sourceErrorsRemainObservable() {
+  const failure = new Error('source failure');
+  const source = new Readable({
+    read() {
+      this.destroy(failure);
+    }
+  });
+
+  await expectRejected(asyncConcat(source), failure);
+}
+
+async function unsupportedChunksRejectWithTypeError() {
+  for (const chunk of [42, {bytes: [1, 2]}]) {
+    await expectRejected(
+      asyncConcat(Readable.from([chunk], {objectMode: true})),
+      TypeError
+    );
+  }
+}
+
+(async () => {
+  await legacyCallsKeepTheirReturnShapes();
+  await oversizedInputRejectsByByteLength();
+  await limitBoundaryAndChunkNormalization();
+  await positionalEncodingWinsOverTheOption();
+  await invalidMaxBytesRejects();
+  await alreadyAbortedSignalRejectsWithItsReason();
+  await abortDuringConsumptionRejectsWithItsReason();
+  await sourceErrorsRemainObservable();
+  await unsupportedChunksRejectWithTypeError();
+  console.log('asyncconcat abort and limits task tests passed');
+})().catch(error => {
+  console.error(error.stack || error);
+  process.exitCode = 1;
+});
