+
+    def test_fixed_tz_aware_index_roundtrip_issue(self):
+
+
+        time = Timestamp('2000-01-01 01:00:00', tz='US/Eastern')
+        df = DataFrame(data=[0], index=[time])
+        with ensure_clean_path(self.path) as path:
+            df.to_hdf(path, 'df')
+            df2 = pd.read_hdf(path)
+
+
+            assert df2.index[0].value == df.index[0].value
+            assert df2.index[0] == df.index[0]
+            assert df2.index[0].tzinfo is not None
+
+    def test_fixed_tz_aware_index_roundtrip_multi(self):
+
+
+
+        rng = date_range('2000-01-01 01:00:00', periods=5, freq='H',
+                         tz='US/Eastern')
+        df = DataFrame({'a': list(range(5))}, index=rng)
+        with ensure_clean_path(self.path) as path:
+            df.to_hdf(path, 'df')
+            df2 = pd.read_hdf(path)
+            for i in range(len(df.index)):
+                assert df.index[i].value == df2.index[i].value
+                assert df.index[i] == df2.index[i]
+
+    def test_fixed_tz_aware_index_roundtrip_non_us_tz(self):
+
+
+        time = Timestamp('2000-06-01 12:00:00', tz='Europe/Berlin')
+        df = DataFrame(data=[0], index=[time])
+        with ensure_clean_path(self.path) as path:
+            df.to_hdf(path, 'df')
+            df2 = pd.read_hdf(path)
+            assert df2.index[0].value == df.index[0].value
+            assert df2.index[0] == df.index[0]
+
+            assert df2.index.tz is not None
+
+    def test_fixed_tz_aware_index_roundtrip_utc(self):
+
+
+
+        time = Timestamp('2000-01-01 06:00:00', tz='UTC')
+        df = DataFrame(data=[0], index=[time])
+        with ensure_clean_path(self.path) as path:
+            df.to_hdf(path, 'df')
+            df2 = pd.read_hdf(path)
+            assert df2.index[0].value == df.index[0].value
+            assert df2.index[0] == df.index[0]
+
+    def test_fixed_naive_index_roundtrip_preserved(self):
+
+
+        rng = date_range('2000-01-01', periods=3, freq='H')
+        df = DataFrame({'a': [1, 2, 3]}, index=rng)
+        with ensure_clean_path(self.path) as path:
+            df.to_hdf(path, 'df')
+            df2 = pd.read_hdf(path)
+            assert (df2.index.asi8 == df.index.asi8).all()
+            assert df2.index.tz is None
+
+    def test_fixed_tz_aware_series_roundtrip(self):
+
+        rng = date_range('2000-01-01 01:00:00', periods=3, freq='H',
+                         tz='Asia/Tokyo')
+        s = Series([1, 2, 3], index=rng)
+        with ensure_clean_path(self.path) as path:
+            s.to_hdf(path, 's')
+            s2 = pd.read_hdf(path)
+            assert (s2.index.asi8 == s.index.asi8).all()
+            assert s.index[0].value == s2.index[0].value
+            assert s.index[0] == s2.index[0]
+
+    def test_fixed_tz_aware_index_roundtrip_preserves_freq(self):
+
+
+        rng = date_range('2000-01-01', periods=5, freq='H', tz='US/Eastern')
+        df = DataFrame({'a': list(range(5))}, index=rng)
+        with ensure_clean_path(self.path) as path:
+            df.to_hdf(path, 'df')
+            df2 = pd.read_hdf(path)
+            assert df2.index.freq == df.index.freq
