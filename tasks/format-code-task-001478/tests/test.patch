diff --git a/usercase-test-coderl/test_coordinate_window_cx.py b/usercase-test-coderl/test_coordinate_window_cx.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_coordinate_window_cx.py
@@ -0,0 +1,422 @@
+
+
+import copy
+import json
+import subprocess
+import sys
+
+import dask.dataframe as dd
+import numpy as np
+import pytest
+
+from spatialpandas import GeoDataFrame, GeoSeries
+from spatialpandas.geometry import LineArray, MultiPointArray, PointArray, PolygonArray
+
+
+def _point_xy(obj):
+    array = getattr(obj, "array", obj)
+    return [(float(x), float(y)) for x, y in zip(array.x, array.y, strict=True)]
+
+
+def _bounds_list(obj):
+    array = getattr(obj, "array", obj)
+    return [[float(value) for value in bounds] for bounds in array.bounds]
+
+
+def _point_series():
+    return GeoSeries(
+        PointArray([[0, 0], [5, 5], [10, 10], [-2, 4], [4, -3]], dtype="float64"),
+        index=["origin", "mid", "far", "left", "low"],
+        name="geom",
+    )
+
+
+def _dask_point_series():
+    series = GeoSeries(
+        PointArray(
+            [[0, 0], [1, 1], [9, 9], [10, 10], [20, 20], [21, 21]],
+            dtype="float64",
+        ),
+        index=["a", "b", "c", "d", "e", "f"],
+        name="geom",
+    )
+    return dd.from_pandas(series, npartitions=3)
+
+
+def _dask_point_frame():
+    series = GeoSeries(
+        PointArray(
+            [[0, 0], [1, 1], [9, 9], [10, 10], [20, 20], [21, 21]],
+            dtype="float64",
+        ),
+        index=["a", "b", "c", "d", "e", "f"],
+        name="geom",
+    )
+    frame = GeoDataFrame(
+        {"value": [0, 1, 2, 3, 4, 5], "geom": series.array},
+        index=["a", "b", "c", "d", "e", "f"],
+        geometry="geom",
+    )
+    return dd.from_pandas(frame, npartitions=3)
+
+
+def test_geoseries_returns_intersecting_rows_with_original_index():
+
+
+
+
+    result = _point_series().cx[1:6, 1:6]
+
+    assert type(result).__name__ == "GeoSeries"
+    assert _point_xy(result) == [(5.0, 5.0)]
+    assert list(result.index) == ["mid"]
+    assert result.name == "geom"
+
+
+def test_missing_endpoints_expand_to_total_bounds():
+
+
+
+
+    result = _point_series().cx[:5, :]
+
+    assert _point_xy(result) == [(0.0, 0.0), (5.0, 5.0), (-2.0, 4.0), (4.0, -3.0)]
+    assert list(result.index) == ["origin", "mid", "left", "low"]
+
+
+def test_scalar_coordinates_are_zero_width_slices():
+
+
+
+
+    result = _point_series().cx[5, 5]
+
+    assert _point_xy(result) == [(5.0, 5.0)]
+    assert list(result.index) == ["mid"]
+
+
+def test_inverted_bounds_are_normalized():
+
+
+
+
+    result = _point_series().cx[6:1, 6:1]
+
+    assert _point_xy(result) == [(5.0, 5.0)]
+    assert list(result.index) == ["mid"]
+
+
+def test_geometry_array_preserves_array_type_and_uses_coordinate_window():
+
+
+
+
+    points = PointArray([[0, 0], [5, 5], [10, 10], [-2, 4], [4, -3]], dtype="float64")
+    result = points.cx[-3:1, 3:5]
+
+    assert type(result).__name__ == "PointArray"
+    assert _point_xy(result) == [(-2.0, 4.0)]
+
+
+def test_geometry_array_full_window_returns_all_points_in_order():
+
+
+
+
+    points = PointArray([[0, 0], [5, 5], [10, 10], [-2, 4], [4, -3]], dtype="float64")
+    result = points.cx[:, :]
+
+    assert type(result).__name__ == "PointArray"
+    assert _point_xy(result) == [
+        (0.0, 0.0),
+        (5.0, 5.0),
+        (10.0, 10.0),
+        (-2.0, 4.0),
+        (4.0, -3.0),
+    ]
+
+
+def test_multipart_extent_intersection_is_used():
+
+
+
+
+    multipoints = MultiPointArray(
+        [
+            np.array([0, 0, 2, 2], dtype="float64"),
+            np.array([8, 8, 9, 9], dtype="float64"),
+            np.array([3, 7, 4, 8], dtype="float64"),
+            np.array([-5, -5, -4, -4], dtype="float64"),
+        ]
+    )
+    result = multipoints.cx[1:3, 1:3]
+
+    assert type(result).__name__ == "MultiPointArray"
+
+    assert len(result) == 1
+    assert _bounds_list(result) == [[0.0, 0.0, 2.0, 2.0]]
+
+
+def test_line_extent_intersection_is_used():
+
+
+
+
+    lines = LineArray(
+        [
+            np.array([0, 0, 10, 10], dtype="float64"),
+            np.array([0, 10, 2, 10], dtype="float64"),
+            np.array([20, 20, 25, 25], dtype="float64"),
+        ]
+    )
+    result = lines.cx[4:6, 4:6]
+
+    assert type(result).__name__ == "LineArray"
+
+    assert len(result) == 1
+    assert _bounds_list(result) == [[0.0, 0.0, 10.0, 10.0]]
+
+
+def test_polygon_touching_window_boundary_intersects():
+
+
+
+
+    polygons = PolygonArray(
+        [
+            [np.array([0, 0, 4, 0, 4, 4, 0, 4, 0, 0], dtype="float64")],
+            [np.array([10, 10, 12, 10, 12, 12, 10, 12, 10, 10], dtype="float64")],
+        ]
+    )
+    result = polygons.cx[4:5, 2:3]
+
+    assert type(result).__name__ == "PolygonArray"
+
+    assert len(result) == 1
+    assert _bounds_list(result) == [[0.0, 0.0, 4.0, 4.0]]
+
+
+def test_geodataframe_filters_rows_using_active_geometry_column():
+
+
+
+
+    frame = GeoDataFrame(
+        {
+            "label": ["a", "b", "c", "d", "e"],
+            "geom": PointArray([[0, 0], [5, 5], [10, 10], [-2, 4], [4, -3]], dtype="float64"),
+            "other": PointArray([[100, 100], [100, 100], [0, 0], [2, 2], [3, 3]], dtype="float64"),
+        },
+        index=[10, 11, 12, 13, 14],
+        geometry="geom",
+    )
+    result = frame.cx[1:6, 1:6]
+
+    assert type(result).__name__ == "GeoDataFrame"
+    assert list(result.index) == [11]
+    assert list(result["label"]) == ["b"]
+    assert _point_xy(result["geom"]) == [(5.0, 5.0)]
+    assert _point_xy(result["other"]) == [(100.0, 100.0)]
+    assert result.geometry.name == "geom"
+
+
+def test_geodataframe_honors_changed_active_geometry_column():
+
+
+
+
+    frame = GeoDataFrame(
+        {
+            "label": ["a", "b", "c", "d", "e"],
+            "geom": PointArray([[0, 0], [5, 5], [10, 10], [-2, 4], [4, -3]], dtype="float64"),
+            "other": PointArray([[100, 100], [100, 100], [0, 0], [2, 2], [3, 3]], dtype="float64"),
+        },
+        index=[10, 11, 12, 13, 14],
+        geometry="geom",
+    ).set_geometry("other")
+    result = frame.cx[99:101, 99:101]
+
+    assert list(result.index) == [10, 11]
+    assert list(result["label"]) == ["a", "b"]
+    assert _point_xy(result["geom"]) == [(0.0, 0.0), (5.0, 5.0)]
+    assert _point_xy(result["other"]) == [(100.0, 100.0), (100.0, 100.0)]
+    assert result.geometry.name == "other"
+
+
+def test_slice_steps_raise_value_error_with_coordinate_interval_message():
+
+
+
+
+    series = _point_series()
+
+    with pytest.raises(ValueError) as x_error:
+        series.cx[0:10:2, 0:10]
+    with pytest.raises(ValueError) as y_error:
+        series.cx[0:10, 0:10:2]
+
+
+    for error in (x_error.value, y_error.value):
+        message = str(error).lower()
+        assert "step" in message
+        assert "coordinate" in message
+        assert "interval" in message
+
+
+def test_dask_geoseries_cx_uses_partition_bounds_and_filters_rows():
+
+
+
+
+    result = _dask_point_series().cx[0:10, 0:10]
+    computed = result.compute()
+
+    assert type(result).__name__ == "DaskGeoSeries"
+    assert result.npartitions == 2
+    assert _point_xy(computed) == [(0.0, 0.0), (1.0, 1.0), (9.0, 9.0), (10.0, 10.0)]
+    assert list(computed.index) == ["a", "b", "c", "d"]
+    assert computed.name == "geom"
+
+
+def test_dask_geoseries_empty_window_keeps_metadata():
+
+
+
+
+    result = _dask_point_series().cx[30:40, 30:40]
+    computed = result.compute()
+
+    assert type(result).__name__ == "DaskGeoSeries"
+
+    assert result.npartitions >= 1
+    assert _point_xy(computed) == []
+    assert list(computed.index) == []
+    assert computed.name == "geom"
+    assert str(computed.dtype) == "point[float64]"
+
+
+def test_dask_geoseries_cx_partitions_does_not_filter_rows():
+
+
+
+
+    result = _dask_point_series().cx_partitions[9:9, 9:9]
+    computed = result.compute()
+
+    assert type(result).__name__ == "DaskGeoSeries"
+    assert result.npartitions == 1
+    assert _point_xy(computed) == [(9.0, 9.0), (10.0, 10.0)]
+    assert list(computed.index) == ["c", "d"]
+
+
+def test_dask_geodataframe_cx_and_cx_partitions_differ_on_partial_partition():
+
+
+
+
+    ddf = _dask_point_frame()
+    filtered = ddf.cx[9:9, 9:9].compute()
+    partition_only = ddf.cx_partitions[9:9, 9:9].compute()
+
+    assert list(filtered.index) == ["c"]
+    assert list(filtered["value"]) == [2]
+    assert _point_xy(filtered["geom"]) == [(9.0, 9.0)]
+    assert filtered.geometry.name == "geom"
+    assert list(partition_only.index) == ["c", "d"]
+    assert list(partition_only["value"]) == [2, 3]
+    assert _point_xy(partition_only["geom"]) == [(9.0, 9.0), (10.0, 10.0)]
+    assert partition_only.geometry.name == "geom"
+
+
+def test_dask_geodataframe_empty_window_keeps_metadata():
+
+
+
+
+    result = _dask_point_frame().cx[30:40, 30:40]
+    computed = result.compute()
+
+    assert type(result).__name__ == "DaskGeoDataFrame"
+
+    assert result.npartitions >= 1
+    assert list(computed.index) == []
+    assert list(computed["value"]) == []
+    assert _point_xy(computed["geom"]) == []
+    assert computed.geometry.name == "geom"
+    assert list(computed.columns) == ["value", "geom"]
+    assert {key: str(value) for key, value in computed.dtypes.items()} == {
+        "value": "int64",
+        "geom": "point[float64]",
+    }
+
+
+def test_referential_transparency_for_repeated_selection():
+    first = _point_series().cx[1:6, 1:6]
+    second = _point_series().cx[1:6, 1:6]
+
+    assert _point_xy(first) == _point_xy(second) == [(5.0, 5.0)]
+    assert list(first.index) == list(second.index) == ["mid"]
+
+
+def test_selection_does_not_mutate_input_series():
+    series = _point_series()
+    before = copy.deepcopy(series)
+
+    result = series.cx[1:6, 1:6]
+
+    assert _point_xy(result) == [(5.0, 5.0)]
+    assert _point_xy(series) == _point_xy(before) == [
+        (0.0, 0.0),
+        (5.0, 5.0),
+        (10.0, 10.0),
+        (-2.0, 4.0),
+        (4.0, -3.0),
+    ]
+    assert list(series.index) == list(before.index) == ["origin", "mid", "far", "left", "low"]
+
+
+def test_same_selection_matches_fresh_process_result():
+    script = r"""
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+from spatialpandas import GeoSeries
+from spatialpandas.geometry import PointArray
+series = GeoSeries(
+    PointArray([[0, 0], [5, 5], [10, 10], [-2, 4], [4, -3]], dtype="float64"),
+    index=["origin", "mid", "far", "left", "low"],
+    name="geom",
+)
+result = series.cx[1:6, 1:6]
+payload = {
+    "xy": [(float(x), float(y)) for x, y in zip(result.array.x, result.array.y, strict=True)],
+    "index": list(result.index),
+}
+sys.stdout.write(json.dumps(payload, sort_keys=True))
+"""
+    in_process = {
+        "xy": [list(xy) for xy in _point_xy(_point_series().cx[1:6, 1:6])],
+        "index": list(_point_series().cx[1:6, 1:6].index),
+    }
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+
+
+    assert in_process == json.loads(completed.stdout) == {
+        "xy": [[5.0, 5.0]],
+        "index": ["mid"],
+    }
+
+
+def test_coordinate_selection_is_independent_of_current_working_directory(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+
+    result = _point_series().cx[1:6, 1:6]
+
+
+    assert _point_xy(result) == [(5.0, 5.0)]
+    assert list(result.index) == ["mid"]
