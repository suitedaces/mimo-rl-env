     assert n.unwrap_or_else(str.upper) == 'NAY'
 
 
+def test_unwrap_or_raise_on_ok_returns_value() -> None:
+    """
+    ``Ok.unwrap_or_raise(E)`` should return the inner value, not raise.
+    """
+    o: Result[str, str] = Ok('yay')
+    assert o.unwrap_or_raise(ValueError) == 'yay'
+
+
+def test_unwrap_or_raise_on_err_raises_exception_type() -> None:
+    """
+    ``Err.unwrap_or_raise(E)`` should raise an instance of the given exception type.
+    """
+    n: Result[str, str] = Err('nay')
+    with pytest.raises(ValueError):
+        n.unwrap_or_raise(ValueError)
+
+
+def test_unwrap_or_raise_on_err_includes_value_in_exception() -> None:
+    """
+    ``Err.unwrap_or_raise(E)`` should pass the err value to the exception
+    constructor so it is recoverable from the raised exception.
+    """
+    n: Result[str, str] = Err('nay')
+    with pytest.raises(ValueError) as exc_info:
+        n.unwrap_or_raise(ValueError)
+    assert exc_info.value.args == ('nay',)
+    assert str(exc_info.value) == 'nay'
+
+
+def test_unwrap_or_raise_only_specified_exception_raised() -> None:
+    """
+    ``Err.unwrap_or_raise`` raises exactly the requested exception class,
+    not the contained value as-is.
+    """
+    class MyException(Exception):
+        pass
+
+    n: Result[str, str] = Err('boom')
+    with pytest.raises(MyException) as exc_info:
+        n.unwrap_or_raise(MyException)
+    assert exc_info.value.args == ('boom',)
+
+
