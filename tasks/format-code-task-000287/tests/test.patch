+package usercase_test_coderl
+
+import (
+	"math"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/aaasen/kapok/stats"
+)
+
+
+
+
+
+
+
+func assertStringSliceEqual(t *testing.T, got, want []string) {
+	t.Helper()
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %#v, want %#v", got, want)
+	}
+}
+
+func assertFloatNear(t *testing.T, got, want float64) {
+	t.Helper()
+	if math.Abs(got-want) > 1e-12 {
+		t.Fatalf("got %.15f, want %.15f", got, want)
+	}
+}
+
+
+
+func TestWordsExtractsQueryExampleTokens(t *testing.T) {
+	got := stats.Words("the fox jumped over the road. That's pretty cool...\tyup?")
+	want := []string{"the", "fox", "jumped", "over", "the", "road", "That's", "pretty", "cool", "yup"}
+	assertStringSliceEqual(t, got, want)
+}
+
+
+
+func TestWordsKeepsDigitsUnderscoresAndApostrophes(t *testing.T) {
+	got := stats.Words("A_1 isn't 42!")
+	want := []string{"A_1", "isn't", "42"}
+	assertStringSliceEqual(t, got, want)
+}
+
+
+
+func TestWordsReturnsNilWhenThereAreNoTokens(t *testing.T) {
+	got := stats.Words("...\t?!")
+
+	if len(got) != 0 {
+		t.Fatalf("got %#v, want no tokens", got)
+	}
+}
+
+
+
+func TestWordsTreatsMixedWordLikeRunsAsSingleTokens(t *testing.T) {
+	got := stats.Words("alpha__beta O'Neill 123_go")
+	want := []string{"alpha__beta", "O'Neill", "123_go"}
+	assertStringSliceEqual(t, got, want)
+}
+
+
+
+func TestSentencesSplitsQueryExample(t *testing.T) {
+	got := stats.Sentences("One. Two...\nThree!Four?")
+	want := []string{"One", "Two", "Three", "Four"}
+	assertStringSliceEqual(t, got, want)
+}
+
+
+
+func TestSentencesKeepsTextWithoutFinalPunctuation(t *testing.T) {
+	got := stats.Sentences("No final punctuation")
+	want := []string{"No final punctuation"}
+	assertStringSliceEqual(t, got, want)
+}
+
+
+
+func TestSentencesConsumesAsciiWhitespaceAroundDelimiter(t *testing.T) {
+	got := stats.Sentences("Alpha \t ? \nBeta")
+	want := []string{"Alpha", "Beta"}
+	assertStringSliceEqual(t, got, want)
+}
+
+
+
+func TestSentencesTreatsDelimiterRunsAsSingleSplit(t *testing.T) {
+	got := stats.Sentences("Wait!!!  What??Yes.")
+	want := []string{"Wait", "What", "Yes"}
+	assertStringSliceEqual(t, got, want)
+}
+
+
+
+func TestSentencesEmptyInputReturnsEmptySlice(t *testing.T) {
+	got := stats.Sentences("")
+
+	if len(got) != 0 {
+		t.Fatalf("got %#v, want no sentence segments", got)
+	}
+}
+
+
+
+func TestSyllableCountLogorrhoea(t *testing.T) {
+	got := stats.SyllableCount("logorrhoea")
+	if got != 4 {
+		t.Fatalf("got %d, want 4", got)
+	}
+}
+
+
+
+func TestSyllableCountShortWordsAreOne(t *testing.T) {
+	for _, word := range []string{"cat", "sky"} {
+		got := stats.SyllableCount(word)
+		if got != 1 {
+			t.Fatalf("SyllableCount(%q) got %d, want 1", word, got)
+		}
+	}
+}
+
+
+
+func TestSyllableCountSilentEdEnding(t *testing.T) {
+	got := stats.SyllableCount("used")
+	if got != 1 {
+		t.Fatalf("got %d, want 1", got)
+	}
+}
+
+
+
+func TestSyllableCountSelectedSilentEsEnding(t *testing.T) {
+
+	for _, word := range []string{"makes"} {
+		got := stats.SyllableCount(word)
+		if got != 1 {
+			t.Fatalf("SyllableCount(%q) got %d, want 1", word, got)
+		}
+	}
+}
+
+
+
+func TestSyllableCountSelectedSilentEEnding(t *testing.T) {
+	got := stats.SyllableCount("themselves")
+	if got != 2 {
+		t.Fatalf("got %d, want 2", got)
+	}
+}
+
+
+
+func TestSyllableCountIgnoresLeadingY(t *testing.T) {
+	got := stats.SyllableCount("yellow")
+	if got != 2 {
+		t.Fatalf("got %d, want 2", got)
+	}
+}
+
+
+
+func TestSyllableCountCountsOneOrTwoVowelGroups(t *testing.T) {
+	got := stats.SyllableCount("queueing")
+	if got != 3 {
+		t.Fatalf("got %d, want 3", got)
+	}
+}
+
+
+
+func TestFleschKincaidEaseSimpleTwoSentenceText(t *testing.T) {
+	got := stats.FleschKincaidEase("The cat sat. Dogs run!")
+	assertFloatNear(t, got, 119.697500000000019)
+}
+
+
+
+func TestFleschKincaidEaseUsesSyllableHeavyWords(t *testing.T) {
+	got := stats.FleschKincaidEase("Logorrhoea makes texts exhausting.")
+	assertFloatNear(t, got, 12.425000000000011)
+}
+
+
+
+func TestFleschKincaidEaseUsesSentenceSplittingHelpers(t *testing.T) {
+	got := stats.FleschKincaidEase("One. Two... Three!")
+	assertFloatNear(t, got, 121.220000000000027)
+}
+
+func TestReadabilityHelpersAreReferentiallyTransparent(t *testing.T) {
+	text := "A_1 isn't 42! One. Two..."
+	assertStringSliceEqual(t, stats.Words(text), stats.Words(text))
+	assertStringSliceEqual(t, stats.Sentences(text), stats.Sentences(text))
+
+	word := "logorrhoea"
+	if stats.SyllableCount(word) != stats.SyllableCount(word) {
+		t.Fatalf("SyllableCount(%q) changed across identical calls", word)
+	}
+
+	easeText := "The cat sat. Dogs run!"
+	if stats.FleschKincaidEase(easeText) != stats.FleschKincaidEase(easeText) {
+		t.Fatalf("FleschKincaidEase(%q) changed across identical calls", easeText)
+	}
+}
+
+func TestReadabilityHelpersDoNotMutateInputStrings(t *testing.T) {
+	text := "the fox jumped over the road. That's pretty cool...\tyup?"
+	before := text
+
+	_ = stats.Words(text)
+	_ = stats.Sentences(text)
+	_ = stats.FleschKincaidEase(text)
+	_ = stats.SyllableCount(text)
+
+	if text != before {
+		t.Fatalf("input string mutated: got %q, want %q", text, before)
+	}
+}
+
+func TestReadabilityHelpersDoNotDependOnInProcessGlobalState(t *testing.T) {
+	_ = stats.Words("noise one")
+	_ = stats.Sentences("Noise. Two!")
+	_ = stats.SyllableCount("queueing")
+	_ = stats.FleschKincaidEase("Logorrhoea makes texts exhausting.")
+
+	assertStringSliceEqual(t, stats.Words("A_1 isn't 42!"), []string{"A_1", "isn't", "42"})
+	assertStringSliceEqual(t, stats.Sentences("Wait!!!  What??Yes."), []string{"Wait", "What", "Yes"})
+
+	if got := stats.SyllableCount("themselves"); got != 2 {
+		t.Fatalf("SyllableCount after noise got %d, want 2", got)
+	}
+
+	assertFloatNear(t, stats.FleschKincaidEase("The cat sat. Dogs run!"), 119.697500000000019)
+}
+
+func TestReadabilityHelpersDoNotWriteRelativeFiles(t *testing.T) {
+	tmp := t.TempDir()
+	originalCwd, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd failed: %v", err)
+	}
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatalf("Chdir(%q) failed: %v", tmp, err)
+	}
+	defer func() {
+		if err := os.Chdir(originalCwd); err != nil {
+			t.Fatalf("restore cwd failed: %v", err)
+		}
+	}()
+
+	before := snapshotDir(t, tmp)
+	_ = stats.Words("A_1 isn't 42!")
+	_ = stats.Sentences("One. Two...\nThree!Four?")
+	_ = stats.SyllableCount("logorrhoea")
+	_ = stats.FleschKincaidEase("The cat sat. Dogs run!")
+	after := snapshotDir(t, tmp)
+
+	if !reflect.DeepEqual(after, before) {
+		t.Fatalf("cwd changed after pure helper calls: before %#v, after %#v", before, after)
+	}
+}
+
+func snapshotDir(t *testing.T, root string) map[string]string {
+	t.Helper()
+	entries := map[string]string{}
+	err := filepath.WalkDir(root, func(path string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		if rel == "." {
+			return nil
+		}
+		kind := "file"
+		if entry.IsDir() {
+			kind = "dir"
+		}
+		entries[rel] = kind
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("snapshot %q failed: %v", root, err)
+	}
+	return entries
+}
