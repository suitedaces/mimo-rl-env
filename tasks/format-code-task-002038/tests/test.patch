+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+set +u
+export PATH="$HOME/.pyenv/bin:$PATH"
+eval "$(pyenv init -)"
+
+
+source /testbed/.build_env/venv/bin/activate
+set -u
+
+
+if [ ! -f /testbed/netbox/netbox/configuration.py ]; then
+    ln -s /testbed/netbox/netbox/configuration.testing.py /testbed/netbox/netbox/configuration.py
+fi
+
+
+pg_ctlcluster 16 main start 2>/dev/null || true
+
+cd /testbed/netbox
+
+case "${1:-}" in
+  base)
+    python manage.py test extras.tests.test_scripts --verbosity=2 --keepdb
+    ;;
+  new)
+    python manage.py test extras.tests.test_runscript_command --verbosity=2 --keepdb
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
