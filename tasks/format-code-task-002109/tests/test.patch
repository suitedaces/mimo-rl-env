+func TestCheckAddressFromString(t *testing.T) {
+	t.Parallel()
+
+	t.Run("valid string argument", func(t *testing.T) {
+		t.Parallel()
+
+		checker, err := ParseAndCheck(t, `let address = Address.fromString("0x1")`)
+
+		require.NoError(t, err)
+
+		resType := RequireGlobalValue(t, checker.Elaboration, "address")
+
+
+		assert.Equal(t,
+			&sema.OptionalType{Type: sema.TheAddressType},
+			resType,
+		)
+	})
+
+	t.Run("non-string argument", func(t *testing.T) {
+		t.Parallel()
+
+		_, err := ParseAndCheck(t, `let address = Address.fromString(1)`)
+		errs := RequireCheckerErrors(t, err, 1)
+		assert.IsType(t, &sema.TypeMismatchError{}, errs[0])
+	})
+
+	t.Run("missing argument", func(t *testing.T) {
+		t.Parallel()
+
+		_, err := ParseAndCheck(t, `let address = Address.fromString()`)
+		errs := RequireCheckerErrors(t, err, 1)
+		assert.IsType(t, &sema.ArgumentCountError{}, errs[0])
+	})
+}
