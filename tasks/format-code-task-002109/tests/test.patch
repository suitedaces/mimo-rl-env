diff --git a/runtime/tests/interpreter/builtinfunctions_test.go b/runtime/tests/interpreter/builtinfunctions_test.go
index 96a009449..acabdebed 100644
--- a/runtime/tests/interpreter/builtinfunctions_test.go
+++ b/runtime/tests/interpreter/builtinfunctions_test.go
@@ -235,6 +235,79 @@ func TestInterpretAddressFromBytes(t *testing.T) {
 	runInvalidCase(t, "[12, 34, 56, 11, 22, 33, 44, 55, 66, 77, 88, 99, 111]")
 }
 
+func TestInterpretAddressFromString(t *testing.T) {
+
+	t.Parallel()
+
+	runValidCase := func(t *testing.T, expected []byte, input string) {
+		t.Run(input, func(t *testing.T) {
+			t.Parallel()
+
+			code := fmt.Sprintf(`
+                  fun test(): Address? {
+                      return Address.fromString("%s")
+                  }
+            	`,
+				input,
+			)
+
+			inter := parseCheckAndInterpret(t, code)
+			res, err := inter.Invoke("test")
+
+			require.NoError(t, err)
+
+			someVal, ok := res.(*interpreter.SomeValue)
+			require.True(t, ok, "expected Some, got %T", res)
+
+			addressVal, ok := someVal.InnerValue(inter, interpreter.EmptyLocationRange).(interpreter.AddressValue)
+			require.True(t, ok)
+
+			require.Equal(t, expected, addressVal.ToAddress().Bytes())
+		})
+	}
+
+	runInvalidCase := func(t *testing.T, input string) {
+		t.Run("invalid:"+input, func(t *testing.T) {
+			t.Parallel()
+
+			code := fmt.Sprintf(`
+                  fun test(): Address? {
+                      return Address.fromString("%s")
+                  }
+            	`,
+				input,
+			)
+
+			inter := parseCheckAndInterpret(t, code)
+			res, err := inter.Invoke("test")
+
+			require.NoError(t, err)
+
+			require.Equal(t, interpreter.Nil, res)
+		})
+	}
+
+
+	runValidCase(t, []byte{0xf8, 0xd6, 0xe0, 0x58, 0x6b, 0x0a, 0x20, 0xc7}, "0xf8d6e0586b0a20c7")
+	runValidCase(t, []byte{0x43, 0x61, 0x64, 0x65, 0x6E, 0x63, 0x65, 0x21}, "0x436164656E636521")
+	runValidCase(t, []byte{0x1}, "0x01")
+	runValidCase(t, []byte{}, "0x0")
+
+
+	runInvalidCase(t, "42")
+	runInvalidCase(t, "436164656E636521")
+
+
+	runInvalidCase(t, "0xZZZ")
+	runInvalidCase(t, "0xGG")
+
+
+	runInvalidCase(t, "0x436164656E63652146757265766572")
+
+
+	runInvalidCase(t, "")
+}
