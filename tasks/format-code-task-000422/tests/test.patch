diff --git a/tests/spec/unit/Plugman/pluginHandler.spec.js b/tests/spec/unit/Plugman/pluginHandler.spec.js
index 368f5f5a..d70b5571 100644
--- a/tests/spec/unit/Plugman/pluginHandler.spec.js
+++ b/tests/spec/unit/Plugman/pluginHandler.spec.js
@@ -610,5 +610,133 @@ describe('ios plugin handler', () => {
                 expect(fs.rmSync).not.toHaveBeenCalledWith(platformWwwDest);
             });
         });
+
+
+
+        describe('of <asset> elements (plugins folder regression)', () => {
+            const install = pluginHandlers.getInstaller('asset');
+            const uninstall = pluginHandlers.getUninstaller('asset');
+            const pid = dummyPluginInfo.id;
+
+            it('should not destroy a sibling asset under plugins/<plugin-id> when uninstalling another asset', () => {
+                const assetA = { src: 'www/dummyplugin.js', target: `plugins/${pid}/foo/dummy1.js` };
+                const assetB = { src: 'www/dummyplugin.js', target: `plugins/${pid}/bar/dummy2.js` };
+
+                install(assetA, dummyPluginInfo, dummyProject);
+                install(assetB, dummyPluginInfo, dummyProject);
+
+                const aWww = path.resolve(dummyProject.www, assetA.target);
+                const bWww = path.resolve(dummyProject.www, assetB.target);
+                expect(fs.existsSync(aWww)).toBe(true);
+                expect(fs.existsSync(bWww)).toBe(true);
+
+                uninstall(assetA, dummyPluginInfo, dummyProject);
+
+                expect(fs.existsSync(aWww)).toBe(false);
+
+                expect(fs.existsSync(bWww)).toBe(true);
+            });
+
+            it('should allow uninstalling each of multiple assets sequentially without throwing', () => {
+                const assetA = { src: 'www/dummyplugin.js', target: `plugins/${pid}/foo/dummy1.js` };
+                const assetB = { src: 'www/dummyplugin.js', target: `plugins/${pid}/bar/dummy2.js` };
+
+                install(assetA, dummyPluginInfo, dummyProject);
+                install(assetB, dummyPluginInfo, dummyProject);
+
+                expect(() => uninstall(assetA, dummyPluginInfo, dummyProject)).not.toThrow();
+                expect(() => uninstall(assetB, dummyPluginInfo, dummyProject)).not.toThrow();
+
+                expect(fs.existsSync(path.resolve(dummyProject.www, assetA.target))).toBe(false);
+                expect(fs.existsSync(path.resolve(dummyProject.www, assetB.target))).toBe(false);
+            });
+
+            it('should not throw when called twice for the same asset (idempotent uninstall)', () => {
+                const asset = { src: 'www/dummyplugin.js', target: `plugins/${pid}/foo/dummy.js` };
+
+                install(asset, dummyPluginInfo, dummyProject);
+                uninstall(asset, dummyPluginInfo, dummyProject);
+                expect(fs.existsSync(path.resolve(dummyProject.www, asset.target))).toBe(false);
+
+
+                expect(() => uninstall(asset, dummyPluginInfo, dummyProject)).not.toThrow();
+            });
+
+            it('should remove empty intermediate parent directories below the plugin folder', () => {
+                const asset = { src: 'www/dummyplugin.js', target: `plugins/${pid}/foo/dummy.js` };
+
+                install(asset, dummyPluginInfo, dummyProject);
+
+                const fooDir = path.resolve(dummyProject.www, 'plugins', pid, 'foo');
+                expect(fs.existsSync(fooDir)).toBe(true);
+
+                uninstall(asset, dummyPluginInfo, dummyProject);
+
+
+                expect(fs.existsSync(fooDir)).toBe(false);
+            });
+
+            it('should remove the now-empty plugins/<plugin-id> folder after the only asset is uninstalled', () => {
+                const asset = { src: 'www/dummyplugin.js', target: `plugins/${pid}/foo/dummy.js` };
+
+                install(asset, dummyPluginInfo, dummyProject);
+
+                const pluginDir = path.resolve(dummyProject.www, 'plugins', pid);
+                expect(fs.existsSync(pluginDir)).toBe(true);
+
+                uninstall(asset, dummyPluginInfo, dummyProject);
+
+                expect(fs.existsSync(pluginDir)).toBe(false);
+            });
+
+            it('should remove the now-empty plugins folder after the last asset under it is uninstalled', () => {
+                const asset = { src: 'www/dummyplugin.js', target: `plugins/${pid}/foo/dummy.js` };
+
+                install(asset, dummyPluginInfo, dummyProject);
+
+                const pluginsDir = path.resolve(dummyProject.www, 'plugins');
+                expect(fs.existsSync(pluginsDir)).toBe(true);
+
+                uninstall(asset, dummyPluginInfo, dummyProject);
+
+                expect(fs.existsSync(pluginsDir)).toBe(false);
+            });
+
+            it('should remove the asset from both www and platform_www when usePlatformWww is set', () => {
+                const asset = { src: 'www/dummyplugin.js', target: `plugins/${pid}/foo/dummy.js` };
+
+                install(asset, dummyPluginInfo, dummyProject, { usePlatformWww: true });
+
+                const wwwPath = path.resolve(dummyProject.www, asset.target);
+                const platformWwwPath = path.resolve(dummyProject.platformWww, asset.target);
+                expect(fs.existsSync(wwwPath)).toBe(true);
+                expect(fs.existsSync(platformWwwPath)).toBe(true);
+
+                uninstall(asset, dummyPluginInfo, dummyProject, { usePlatformWww: true });
+
+                expect(fs.existsSync(wwwPath)).toBe(false);
+                expect(fs.existsSync(platformWwwPath)).toBe(false);
+            });
+
+            it('should leave platform_www untouched when usePlatformWww is not set', () => {
+                const asset = { src: 'www/dummyplugin.js', target: `plugins/${pid}/foo/dummy.js` };
+
+                install(asset, dummyPluginInfo, dummyProject, { usePlatformWww: true });
+
+                const wwwPath = path.resolve(dummyProject.www, asset.target);
+                const platformWwwPath = path.resolve(dummyProject.platformWww, asset.target);
+
+                uninstall(asset, dummyPluginInfo, dummyProject);
+
+                expect(fs.existsSync(wwwPath)).toBe(false);
+                expect(fs.existsSync(platformWwwPath)).toBe(true);
+            });
+
+            it('should throw a CordovaError when the asset target attribute is missing', () => {
+                const asset = { src: 'www/dummyplugin.js' };
+                expect(() => uninstall(asset, dummyPluginInfo, dummyProject))
+                    .toThrowError(/target/);
+            });
+        });
     });
 });
