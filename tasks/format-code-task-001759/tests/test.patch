 func TestJogo_Começar(t *testing.T) {
diff --git a/repo_path_audit_test.go b/repo_path_audit_test.go
new file mode 100644
index 0000000..9596062
--- /dev/null
+++ b/repo_path_audit_test.go
@@ -0,0 +1,196 @@
+package repo_path_test
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const (
+	currentRepoPath = "github.com/larien/aprenda-go-com-testes"
+	oldRepoPath     = "github.com/larien/learn-go-with-tests"
+	currentGitHub   = "https://github.com/larien/aprenda-go-com-testes"
+	oldGitHub       = "https://github.com/larien/learn-go-with-tests"
+)
+
+func readFile(t *testing.T, path string) string {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read %s: %v", path, err)
+	}
+	return string(data)
+}
+
+func collectFiles(t *testing.T, suffixes ...string) []string {
+	t.Helper()
+	var files []string
+	err := filepath.WalkDir(".", func(path string, entry os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if entry.IsDir() {
+			switch entry.Name() {
+			case ".build_env", ".git", ".hg", ".svn", "vendor":
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if path == "repo_path_audit_test.go" {
+			return nil
+		}
+		for _, suffix := range suffixes {
+			if strings.HasSuffix(path, suffix) {
+				files = append(files, path)
+				break
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("walk repository: %v", err)
+	}
+	return files
+}
+
+func assertFilesDoNotContainOldProjectPath(t *testing.T, files []string) {
+	t.Helper()
+	for _, path := range files {
+		contents := readFile(t, path)
+		if strings.Contains(contents, oldRepoPath) || strings.Contains(contents, oldGitHub) {
+			t.Fatalf("%s still references the old repository path", path)
+		}
+	}
+}
+
+func TestGoSourcesDoNotImportOldRepoPath(t *testing.T) {
+	goFiles := collectFiles(t, ".go")
+	assertFilesDoNotContainOldProjectPath(t, goFiles)
+
+	representativeImports := map[string]string{
+		"criando-uma-aplicacao/linha-de-comando/v3/cmd/cli/main.go": currentRepoPath + "/criando-uma-aplicacao/linha-de-comando/v3",
+		"criando-uma-aplicacao/time/v1/cmd/cli/main.go":             currentRepoPath + "/criando-uma-aplicacao/time/v1",
+		"criando-uma-aplicacao/websockets/v2/CLI_test.go":           currentRepoPath + "/criando-uma-aplicacao/websockets/v2",
+	}
+	for path, importPath := range representativeImports {
+		if !strings.Contains(readFile(t, path), importPath) {
+			t.Fatalf("%s does not reference current repository import path %q", path, importPath)
+		}
+	}
+}
+
+func TestGoModuleDeclaresCurrentRepoPath(t *testing.T) {
+	contents := readFile(t, "go.mod")
+	moduleLine := "module " + currentRepoPath
+	if !strings.Contains(contents, moduleLine+"\n") {
+		t.Fatalf("go.mod does not declare current module path %q", moduleLine)
+	}
+	if strings.Contains(contents, "module "+oldRepoPath) {
+		t.Fatalf("go.mod still declares the old module path")
+	}
+	if strings.Contains(contents, "module "+currentRepoPath+"/") {
+		t.Fatalf("go.mod declares a suffixed module path instead of %q", currentRepoPath)
+	}
+}
+
+func TestRepresentativeExamplePackagesCompile(t *testing.T) {
+	dirs := []string{
+		"criando-uma-aplicacao/linha-de-comando/v3",
+		"criando-uma-aplicacao/time/v1",
+		"criando-uma-aplicacao/time/v2",
+		"criando-uma-aplicacao/websockets/v1",
+		"criando-uma-aplicacao/websockets/v2",
+	}
+	for _, dir := range dirs {
+		t.Run(dir, func(t *testing.T) {
+			cmd := exec.Command("go", "test", "-run", "^$", "./...")
+			cmd.Dir = dir
+			output, err := cmd.CombinedOutput()
+			if err != nil {
+				t.Fatalf("go test compile check failed in %s: %v\n%s", dir, err, output)
+			}
+			if strings.Contains(string(output), oldRepoPath) {
+				t.Fatalf("go test output in %s still mentions old repository path:\n%s", dir, output)
+			}
+		})
+	}
+}
+
+func TestTravisBeforeInstallUsesCurrentRepoPath(t *testing.T) {
+	contents := readFile(t, ".travis.yml")
+	want := "go get " + currentRepoPath + "/criando-uma-aplicacao/linha-de-comando/v1"
+	if !strings.Contains(contents, want) {
+		t.Fatalf(".travis.yml does not fetch the current command-line package path %q", want)
+	}
+	if strings.Contains(contents, oldRepoPath) {
+		t.Fatalf(".travis.yml still references the old repository path")
+	}
+}
+
+func TestReadmeProjectLinksUseCurrentRepo(t *testing.T) {
+	contents := readFile(t, "README.md")
+	wantURLs := []string{
+		"https://travis-ci.org/larien/aprenda-go-com-testes.svg?branch=master",
+		"https://goreportcard.com/badge/github.com/larien/aprenda-go-com-testes",
+		"https://goreportcard.com/report/github.com/larien/aprenda-go-com-testes",
+		currentGitHub + "/releases",
+		currentGitHub + "/tree/09aafaeebaef4443e80a6216cc46fa3d7bfdabbb/LICENSE.md",
+	}
+	for _, want := range wantURLs {
+		if !strings.Contains(contents, want) {
+			t.Fatalf("README.md does not contain current project URL %q", want)
+		}
+	}
+	for _, old := range []string{
+		oldGitHub,
+		"https://travis-ci.org/larien/learn-go-with-tests",
+		"https://goreportcard.com/report/github.com/quii/learn-go-with-tests",
+	} {
+		if strings.Contains(contents, old) {
+			t.Fatalf("README.md still contains old project URL %q", old)
+		}
+	}
+}
+
+func TestMarkdownProjectLinksDoNotUseOldGitHubRepo(t *testing.T) {
+	mdFiles := collectFiles(t, ".md")
+	assertFilesDoNotContainOldProjectPath(t, mdFiles)
+}
+
+func TestDocumentationGoPathSnippetsUseCurrentRepo(t *testing.T) {
+	representativeSnippets := map[string][]string{
+		"criando-uma-aplicacao/json/json.md": {
+			currentRepoPath + "/json-and-io/v2",
+			currentRepoPath + "/json-and-io/v4",
+		},
+		"criando-uma-aplicacao/io/io.md": {
+			currentRepoPath + "/json-and-io/v7",
+		},
+		"criando-uma-aplicacao/linha-de-comando/linha-de-comando.md": {
+			currentRepoPath + "/criando-uma-aplicacao/linha-de-comando/v3",
+		},
+	}
+	for path, snippets := range representativeSnippets {
+		contents := readFile(t, path)
+		for _, snippet := range snippets {
+			if !strings.Contains(contents, snippet) {
+				t.Fatalf("%s does not contain current repository snippet %q", path, snippet)
+			}
+		}
+	}
+}
+
+func TestChapterSourceLinksUseCurrentRepo(t *testing.T) {
+	representativeLinks := map[string]string{
+		"criando-uma-aplicacao/linha-de-comando/linha-de-comando.md": currentGitHub + "/tree/master/criando-uma-aplicacao/linha-de-comando",
+		"criando-uma-aplicacao/json/json.md":                         currentGitHub + "/tree/master/criando-uma-aplicacao/json",
+		"criando-uma-aplicacao/io/io.md":                             currentGitHub + "/tree/master/criando-uma-aplicacao/io",
+	}
+	for path, want := range representativeLinks {
+		if !strings.Contains(readFile(t, path), want) {
+			t.Fatalf("%s does not link to current project source URL %q", path, want)
+		}
+	}
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test -v \
+      ./criando-uma-aplicacao/linha-de-comando/v3/... \
+      ./criando-uma-aplicacao/time/v1/... \
+      ./criando-uma-aplicacao/time/v2/... \
+      ./criando-uma-aplicacao/time/v3/... \
+      ./criando-uma-aplicacao/websockets/v1/... \
+      ./criando-uma-aplicacao/websockets/v2/...
+    ;;
+  new)
+    go test -v . -run 'Test(GoSourcesDoNotImportOldRepoPath|GoModuleDeclaresCurrentRepoPath|RepresentativeExamplePackagesCompile|TravisBeforeInstallUsesCurrentRepoPath|ReadmeProjectLinksUseCurrentRepo|MarkdownProjectLinksDoNotUseOldGitHubRepo|DocumentationGoPathSnippetsUseCurrentRepo|ChapterSourceLinksUseCurrentRepo)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
