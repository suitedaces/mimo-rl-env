+def test_no_shadow_warning_for_mixin_with_default_field() -> None:
+    """https://github.com/pydantic/pydantic/issues/9095
+
+    A non-BaseModel mixin that declares a field with a default value should
+    not trigger the "shadows an attribute" UserWarning when combined with
+    BaseModel via multiple inheritance, since the child class does not
+    redeclare the field.
+    """
+
+    class MyMixin:
+        my_field: bool = False
+
+    with warnings.catch_warnings():
+        warnings.simplefilter('error')
+
+        class MyModel(BaseModel, MyMixin):
+            pass
+
+
+    assert 'my_field' in MyModel.model_fields
+    assert MyModel.model_fields['my_field'].default is False
+    assert MyModel().my_field is False
+
+
+def test_no_shadow_warning_for_mixin_multiple_fields() -> None:
+    """Multiple fields inherited from a non-BaseModel mixin, none redeclared
+    in the child, should not trigger shadow warnings.
+    """
+
+    class MyMixin:
+        field_a: int = 1
+        field_b: str = 'default_b'
+
+    with warnings.catch_warnings():
+        warnings.simplefilter('error')
+
+        class MyModel(BaseModel, MyMixin):
+            pass
+
+    assert 'field_a' in MyModel.model_fields
+    assert 'field_b' in MyModel.model_fields
+    assert MyModel.model_fields['field_a'].default == 1
+    assert MyModel.model_fields['field_b'].default == 'default_b'
+    m = MyModel()
+    assert m.field_a == 1
+    assert m.field_b == 'default_b'
+
+
+def test_shadow_warning_still_fires_when_field_redeclared_no_default() -> None:
+    """Preservation: explicit field redeclaration in a child class should
+    still trigger the shadow warning.
+    """
+
+    class Model(BaseModel):
+        foo: str
+
+        @classmethod
+        def __pydantic_init_subclass__(cls, **kwargs: Any):
+            super().__pydantic_init_subclass__(**kwargs)
+            for key in cls.model_fields.keys():
+                setattr(cls, key, getattr(cls, key, '') + ' edited!')
+
+    class One(Model):
+        foo: str = 'abc'
+
+    with pytest.warns(UserWarning, match=r'"foo" in ".*Two" shadows an attribute in parent ".*One"'):
+
+        class Two(One):
+            foo: str
+
+
+def test_shadow_warning_still_fires_when_field_redeclared_with_default() -> None:
+    """Preservation: explicit field redeclaration with a default in a child
+    class should still trigger the shadow warning.
+    """
+
+    class Model(BaseModel):
+        foo: str
+
+        @classmethod
+        def __pydantic_init_subclass__(cls, **kwargs: Any):
+            super().__pydantic_init_subclass__(**kwargs)
+            for key in cls.model_fields.keys():
+                setattr(cls, key, getattr(cls, key, '') + ' edited!')
+
+    class One(Model):
+        foo: str = 'abc'
+
+    with pytest.warns(UserWarning, match=r'"foo" in ".*Three" shadows an attribute in parent ".*One"'):
+
+        class Three(One):
+            foo: str = 'xyz'
+
+
+def test_no_shadow_warning_for_inherited_field_no_redeclaration() -> None:
+    """When a BaseModel subclass inherits a field from its parent chain (where
+    `hasattr` is True due to a parent setting the attribute) but does NOT
+    redeclare it in its own __annotations__, no shadow warning should fire.
+    """
+
+    class Model(BaseModel):
+        foo: str
+
+        @classmethod
+        def __pydantic_init_subclass__(cls, **kwargs: Any):
+            super().__pydantic_init_subclass__(**kwargs)
+            for key in cls.model_fields.keys():
+                setattr(cls, key, getattr(cls, key, '') + ' edited!')
+
+    class One(Model):
+        foo: str = 'abc'
+
+    with warnings.catch_warnings():
+        warnings.simplefilter('error')
+
+
+
+
+
+        class NoRedeclare(One):
+            pass
+
+    assert 'foo' in NoRedeclare.model_fields
+
+
+def test_no_shadow_warning_for_basemodel_inheriting_mixin_chain() -> None:
+    """A BaseModel that inherits from a non-BaseModel mixin should not
+    propagate a shadow warning to its own subclasses, even if the parent
+    is a BaseModel that itself picks up the field via mixin inheritance.
+    """
+
+    class GrandParent:
+        foo: str = 'abc'
+
+    with warnings.catch_warnings():
+        warnings.simplefilter('error')
+
+        class Parent(BaseModel, GrandParent):
+            pass
+
+        class Child(Parent):
+            pass
+
+    assert 'foo' in Parent.model_fields
+    assert 'foo' in Child.model_fields
+    assert Parent.model_fields['foo'].default == 'abc'
+    assert Child().foo == 'abc'
+
+
