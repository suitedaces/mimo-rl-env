+import React from 'react';
+import sinon from 'sinon';
+import { shallow } from 'enzyme';
+
+import Body from '../src/body';
+import BootstrapTable from '../src/bootstrap-table';
+import Const from '../src/const';
+
+const flush = () => new Promise(resolve => setImmediate(resolve));
+
+describe('cellEdit.onUpdate contract', () => {
+  const columns = [{
+    dataField: 'id',
+    text: 'ID'
+  }, {
+    dataField: 'name',
+    text: 'Name'
+  }, {
+    dataField: 'price',
+    text: 'Price'
+  }];
+
+  const createData = () => [
+    { id: 1, name: 'A', price: 100 },
+    { id: 2, name: 'B', price: 200 }
+  ];
+
+  let data;
+
+  const renderTable = (cellEdit) => {
+    data = createData();
+    return shallow(
+      <BootstrapTable
+        keyField="id"
+        columns={ columns }
+        data={ data }
+        cellEdit={ cellEdit }
+      />
+    );
+  };
+
+  const completeOf = wrapper => wrapper.find(Body).props().cellEdit.onComplete;
+  const dataOf = wrapper => wrapper.update().find(Body).props().data;
+  const valueOf = (wrapper, rowId, field) =>
+    dataOf(wrapper).find(r => r.id === rowId)[field];
+
+  describe('when no onUpdate callback is supplied', () => {
+    it('should update its own data with the entered value', () => {
+      const wrapper = renderTable({ mode: Const.CLICK_TO_CELL_EDIT });
+      completeOf(wrapper)(data[0], columns[1], 'Z');
+      expect(valueOf(wrapper, 1, 'name')).toBe('Z');
+    });
+
+    it('should end editing after applying the update', () => {
+      const wrapper = renderTable({ mode: Const.CLICK_TO_CELL_EDIT });
+      wrapper.setState({ currEditCell: { ridx: 0, cidx: 1 } });
+      completeOf(wrapper)(data[0], columns[1], 'Z');
+      const cellEditInfo = wrapper.update().find(Body).props().cellEdit;
+      expect(cellEditInfo.ridx).toBeNull();
+      expect(cellEditInfo.cidx).toBeNull();
+    });
+  });
+
+  describe('when onUpdate is supplied', () => {
+    it('should be called with (rowId, dataField, newValue)', () => {
+      const onUpdate = sinon.stub();
+      const wrapper = renderTable({ mode: Const.CLICK_TO_CELL_EDIT, onUpdate });
+      completeOf(wrapper)(data[0], columns[1], 'Z');
+      expect(onUpdate.calledOnce).toBe(true);
+      expect(onUpdate.calledWith(1, 'name', 'Z')).toBe(true);
+    });
+
+    it('should update its own data when it returns undefined', () => {
+      const onUpdate = sinon.stub().returns(undefined);
+      const wrapper = renderTable({ mode: Const.CLICK_TO_CELL_EDIT, onUpdate });
+      completeOf(wrapper)(data[0], columns[1], 'Z');
+      expect(valueOf(wrapper, 1, 'name')).toBe('Z');
+    });
+
+    it('should not touch its own data when it returns false', () => {
+      const onUpdate = sinon.stub().returns(false);
+      const wrapper = renderTable({ mode: Const.CLICK_TO_CELL_EDIT, onUpdate });
+      completeOf(wrapper)(data[0], columns[1], 'Z');
+      expect(valueOf(wrapper, 1, 'name')).toBe('A');
+    });
+
+    it('should use the object value when it returns an object with a value property', () => {
+      const onUpdate = sinon.stub().returns({ value: 'CORRECTED' });
+      const wrapper = renderTable({ mode: Const.CLICK_TO_CELL_EDIT, onUpdate });
+      completeOf(wrapper)(data[0], columns[1], 'Z');
+      expect(valueOf(wrapper, 1, 'name')).toBe('CORRECTED');
+    });
+  });
+
+  describe('when onUpdate returns a Promise', () => {
+    it('should update with the entered value once it resolves', async () => {
+      const onUpdate = sinon.stub().returns(Promise.resolve());
+      const wrapper = renderTable({ mode: Const.CLICK_TO_CELL_EDIT, onUpdate });
+      completeOf(wrapper)(data[0], columns[1], 'Z');
+      expect(valueOf(wrapper, 1, 'name')).toBe('A');
+      await flush();
+      expect(valueOf(wrapper, 1, 'name')).toBe('Z');
+    });
+
+    it('should use the resolved object value when present', async () => {
+      const onUpdate = sinon.stub().returns(Promise.resolve({ value: 'FROM_SERVER' }));
+      const wrapper = renderTable({ mode: Const.CLICK_TO_CELL_EDIT, onUpdate });
+      completeOf(wrapper)(data[0], columns[1], 'Z');
+      await flush();
+      expect(valueOf(wrapper, 1, 'name')).toBe('FROM_SERVER');
+    });
+
+    it('should leave its data unchanged when it rejects', async () => {
+      const onUpdate = sinon.stub().callsFake(() => Promise.reject(new Error('boom')));
+      const wrapper = renderTable({ mode: Const.CLICK_TO_CELL_EDIT, onUpdate });
+      completeOf(wrapper)(data[0], columns[1], 'Z');
+      await flush();
+      expect(valueOf(wrapper, 1, 'name')).toBe('A');
+    });
+  });
+
+  describe('beforeSaveCell / afterSaveCell hooks', () => {
+    it('should fire beforeSaveCell before applying the update', () => {
+      const beforeSaveCell = sinon.stub();
+      const wrapper = renderTable({ mode: Const.CLICK_TO_CELL_EDIT, beforeSaveCell });
+      completeOf(wrapper)(data[0], columns[1], 'Z');
+      expect(beforeSaveCell.calledOnce).toBe(true);
+      expect(beforeSaveCell.calledWith('A', 'Z', data[0], columns[1])).toBe(true);
+    });
+
+    it('should fire afterSaveCell after a successful update', () => {
+      const afterSaveCell = sinon.stub();
+      const wrapper = renderTable({ mode: Const.CLICK_TO_CELL_EDIT, afterSaveCell });
+      completeOf(wrapper)(data[0], columns[1], 'Z');
+      expect(afterSaveCell.calledOnce).toBe(true);
+    });
+
+    it('should not fire afterSaveCell when onUpdate returns false', () => {
+      const afterSaveCell = sinon.stub();
+      const onUpdate = sinon.stub().returns(false);
+      const wrapper = renderTable({ mode: Const.CLICK_TO_CELL_EDIT, afterSaveCell, onUpdate });
+      completeOf(wrapper)(data[0], columns[1], 'Z');
+      expect(afterSaveCell.called).toBe(false);
+    });
+
+    it('should not fire afterSaveCell when a returned Promise rejects', async () => {
+      const afterSaveCell = sinon.stub();
+      const onUpdate = sinon.stub().callsFake(() => Promise.reject(new Error('boom')));
+      const wrapper = renderTable({ mode: Const.CLICK_TO_CELL_EDIT, afterSaveCell, onUpdate });
+      completeOf(wrapper)(data[0], columns[1], 'Z');
+      await flush();
+      expect(afterSaveCell.called).toBe(false);
+    });
+  });
+});
