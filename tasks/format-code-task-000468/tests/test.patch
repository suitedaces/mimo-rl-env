diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,216 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+( cd /workspace/repo && PYTHONPATH=/workspace/repo python3 - <<'PY'
+import git_deps.cli
+import pygit2
+PY
+) || fail "build/import git-deps"
+
+BIN_PYTHON=python3
+BIN_MODULE=git_deps.cli
+export PYTHONPATH=/workspace/repo
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+run_git_deps() {
+    "$BIN_PYTHON" -m "$BIN_MODULE" "$@"
+}
+
+make_fixture_repo() {
+    FIXTURE_REPO="$TMP/dependency-fixture"
+    mkdir "$FIXTURE_REPO"
+    cd "$FIXTURE_REPO" || exit 1
+    git init -q || exit 1
+    git config user.name 'Acceptance Tester'
+    git config user.email 'acceptance@example.com'
+    git config commit.gpgsign false
+    git config format.pretty medium
+    git config log.date default
+    git config log.showSignature false
+
+    export GIT_AUTHOR_NAME='Acceptance Tester'
+    export GIT_AUTHOR_EMAIL='acceptance@example.com'
+    export GIT_COMMITTER_NAME='Acceptance Tester'
+    export GIT_COMMITTER_EMAIL='acceptance@example.com'
+
+    commit_at() {
+        export GIT_AUTHOR_DATE="$1"
+        export GIT_COMMITTER_DATE="$1"
+        git add story.txt
+        git commit -q -m "$2"
+    }
+
+    printf 'alpha\nbeta\ngamma\ndelta\nepsilon\nzeta\n' > story.txt
+    commit_at '2020-01-01T00:00:00 +0000' 'root: create story'
+    sed -i 's/^gamma$/gamma A/' story.txt
+    commit_at '2020-01-02T00:00:00 +0000' 'A: revise gamma'
+    sed -i 's/^epsilon$/epsilon B/' story.txt
+    commit_at '2020-01-03T00:00:00 +0000' 'B: revise epsilon'
+    sed -i 's/^delta$/delta C/' story.txt
+    commit_at '2020-01-04T00:00:00 +0000' 'C: revise delta'
+
+    R=37c4258181b0bba3f60b452ffaea00665b05d8f3
+    A=df3eeb5556c38e4e0cdf777c721195f1b8db596b
+    B=7e995dc30d24c10a26c9e09d8189c26e9a14b74e
+    C=a97d85f321a130b71122c573a34b5397e9cbc7df
+
+    [ "$(git rev-parse HEAD~3)" = "$R" ] || fail "fixture root SHA changed"
+    [ "$(git rev-parse HEAD~2)" = "$A" ] || fail "fixture A SHA changed"
+    [ "$(git rev-parse HEAD~1)" = "$B" ] || fail "fixture B SHA changed"
+    [ "$(git rev-parse HEAD)" = "$C" ] || fail "fixture C SHA changed"
+}
+
+assert_empty_err() {
+    fixture=$1
+    [ ! -s err ] || fail "$fixture unexpected stderr: $(cat err)"
+}
+
+assert_stdout_set() {
+    fixture=$1
+    expected=$2
+    actual_sorted=$(LC_ALL=C sort out)
+    expected_sorted=$(printf '%s\n' "$expected" | LC_ALL=C sort)
+    [ "$actual_sorted" = "$expected_sorted" ] || fail "$fixture stdout set: $(cat out)"
+}
+
+assert_sha_only_lines() {
+    fixture=$1
+    awk 'NF != 1 || length($1) != 40 || $1 !~ /^[0-9a-f]+$/ { exit 1 } END { if (NR == 0) exit 1 }' out \
+        || fail "$fixture stdout should contain one SHA per line: $(cat out)"
+}
+
+assert_edge_lines() {
+    fixture=$1
+    awk 'NF != 2 || length($1) != 40 || length($2) != 40 || $1 !~ /^[0-9a-f]+$/ || $2 !~ /^[0-9a-f]+$/ { exit 1 } END { if (NR == 0) exit 1 }' out \
+        || fail "$fixture stdout should contain dependent/dependency edges: $(cat out)"
+}
+
+assert_colorized_commit_header() {
+    fixture=$1
+    sha=$2
+    count=$(grep -c "$(printf '\033')\\[33mcommit $sha$(printf '\033')\\[m" out || true)
+    [ "$count" -eq 1 ] || fail "$fixture expected one colorized git log header for $sha, got $count"
+}
+
+make_fixture_repo
+
+
+
+
+run_git_deps "$A^!" >out 2>err; ec=$?
+EXPECTED_F1='37c4258181b0bba3f60b452ffaea00665b05d8f3'
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+[ "$(cat out)" = "$EXPECTED_F1" ] || fail "F1 stdout: $(cat out)"
+[ "$(wc -l < out)" -eq 1 ] || fail "F1 repeated dependency lines"
+assert_empty_err F1
+
+
+
+
+run_git_deps "$C^!" >out 2>err; ec=$?
+EXPECTED_F2='df3eeb5556c38e4e0cdf777c721195f1b8db596b
+37c4258181b0bba3f60b452ffaea00665b05d8f3
+7e995dc30d24c10a26c9e09d8189c26e9a14b74e'
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+
+assert_stdout_set F2 "$EXPECTED_F2"
+assert_sha_only_lines F2
+! grep -q ' ' out || fail "F2 stdout used edge format for single target"
+assert_empty_err F2
+
+
+
+
+run_git_deps "$R^!" >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+[ ! -s out ] || fail "F3 stdout should be empty: $(cat out)"
+assert_empty_err F3
+
+
+
+
+run_git_deps "$A^!" "$B^!" >out 2>err; ec=$?
+EXPECTED_F4='df3eeb5556c38e4e0cdf777c721195f1b8db596b 37c4258181b0bba3f60b452ffaea00665b05d8f3
+7e995dc30d24c10a26c9e09d8189c26e9a14b74e 37c4258181b0bba3f60b452ffaea00665b05d8f3'
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+
+assert_stdout_set F4 "$EXPECTED_F4"
+assert_edge_lines F4
+assert_empty_err F4
+
+
+
+
+run_git_deps "$A..$C" >out 2>err; ec=$?
+EXPECTED_F5='a97d85f321a130b71122c573a34b5397e9cbc7df df3eeb5556c38e4e0cdf777c721195f1b8db596b
+a97d85f321a130b71122c573a34b5397e9cbc7df 37c4258181b0bba3f60b452ffaea00665b05d8f3
+a97d85f321a130b71122c573a34b5397e9cbc7df 7e995dc30d24c10a26c9e09d8189c26e9a14b74e
+7e995dc30d24c10a26c9e09d8189c26e9a14b74e 37c4258181b0bba3f60b452ffaea00665b05d8f3'
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+
+assert_stdout_set F5 "$EXPECTED_F5"
+assert_edge_lines F5
+assert_empty_err F5
+
+
+
+
+run_git_deps -r "$C^!" >out 2>err; ec=$?
+EXPECTED_F6='a97d85f321a130b71122c573a34b5397e9cbc7df df3eeb5556c38e4e0cdf777c721195f1b8db596b
+a97d85f321a130b71122c573a34b5397e9cbc7df 37c4258181b0bba3f60b452ffaea00665b05d8f3
+a97d85f321a130b71122c573a34b5397e9cbc7df 7e995dc30d24c10a26c9e09d8189c26e9a14b74e
+df3eeb5556c38e4e0cdf777c721195f1b8db596b 37c4258181b0bba3f60b452ffaea00665b05d8f3
+7e995dc30d24c10a26c9e09d8189c26e9a14b74e 37c4258181b0bba3f60b452ffaea00665b05d8f3'
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+
+assert_stdout_set F6 "$EXPECTED_F6"
+assert_edge_lines F6
+assert_empty_err F6
+
+
+
+
+run_git_deps --log "$C^!" >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F7 exit $ec; want 0"
+
+assert_colorized_commit_header F7 "$A"
+assert_colorized_commit_header F7 "$R"
+assert_colorized_commit_header F7 "$B"
+grep -q '    A: revise gamma' out || fail "F7 missing full A log block"
+grep -q '    root: create story' out || fail "F7 missing full root log block"
+grep -q '    B: revise epsilon' out || fail "F7 missing full B log block"
+! grep -q 'depends on:' out || fail "F7 single-target log should not use multi prefix"
+assert_empty_err F7
+
+
+
+
+run_git_deps --log -r "$C^!" >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F8 exit $ec; want 0"
+
+[ "$(grep -c "^$C depends on:$" out || true)" -eq 3 ] || fail "F8 missing dependent prefixes for C"
+[ "$(grep -c "^$A depends on:$" out || true)" -eq 1 ] || fail "F8 missing dependent prefix for A"
+[ "$(grep -c "^$B depends on:$" out || true)" -eq 1 ] || fail "F8 missing dependent prefix for B"
+assert_colorized_commit_header F8 "$A"
+assert_colorized_commit_header F8 "$R"
+assert_colorized_commit_header F8 "$B"
+[ "$(grep -c "^commit $R (already shown above)$" out || true)" -eq 2 ] || fail "F8 missing already-shown placeholders"
+assert_empty_err F8
+
+
+
+
+run_git_deps not-a-rev >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F_err exit $ec; want non-zero"
+[ ! -s out ] || fail "F_err stdout should be empty: $(cat out)"
+
+[ -s err ] || fail "F_err stderr should be non-empty"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
