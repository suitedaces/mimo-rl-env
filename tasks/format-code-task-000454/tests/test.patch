+func TestArtifactServer_GetOutputArtifact_InlineTemplate(t *testing.T) {
+	s := newServerForInlineTest()
+
+	r := &http.Request{}
+	r.URL = mustParse("/artifacts/my-ns/inline-wf/inline-node/my-inline-artifact")
+	recorder := httptest.NewRecorder()
+
+	s.GetOutputArtifact(recorder, r)
+
+	assert.Equal(t, http.StatusOK, recorder.Result().StatusCode,
+		"inline-template node should not produce Internal Server Error")
+	body, err := io.ReadAll(recorder.Result().Body)
+	assert.NoError(t, err)
+	assert.Equal(t, "inline-data", string(body))
+}
+
+
+
+func TestArtifactServer_GetArtifactFile_InlineTemplate(t *testing.T) {
+	s := newServerForInlineTest()
+
+	r := &http.Request{}
+	r.URL = mustParse("/artifact-files/my-ns/workflows/inline-wf/inline-node/outputs/my-inline-artifact")
+	recorder := httptest.NewRecorder()
+
+	s.GetArtifactFile(recorder, r)
+
+	assert.Equal(t, http.StatusOK, recorder.Result().StatusCode,
+		"inline-template node should serve artifact files, not return 500")
+	body, err := io.ReadAll(recorder.Result().Body)
+	assert.NoError(t, err)
+	assert.Equal(t, "inline-data", string(body))
+}
+
+
+
+
+
+
+func TestArtifactServer_getArtifactAndDriver_InlineTemplate(t *testing.T) {
+	s := newServerForInlineTest()
+
+
+	ctx, err := s.gateKeeping(&http.Request{URL: mustParse("/artifacts/my-ns/inline-wf/inline-node/my-inline-artifact")}, nil)
+	assert.NoError(t, err)
+
+	wf, err := s.getWorkflowAndValidate(ctx, "my-ns", "inline-wf")
+	assert.NoError(t, err)
+
+	art, driver, err := s.getArtifactAndDriver(ctx, "inline-node", "my-inline-artifact", false, wf, nil)
+	assert.NoError(t, err, "inline-template node must not produce a template-not-found error")
+	assert.NotNil(t, art)
+	assert.NotNil(t, driver)
+	if art != nil && art.S3 != nil {
+
+
+
+		assert.Equal(t, "my-bucket", art.S3.Bucket,
+			"bucket must come from the resolved artifact repository when template is inline")
+	}
+}
+
