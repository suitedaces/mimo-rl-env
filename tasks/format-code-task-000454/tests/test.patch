+func TestArtifactServer_getArtifactAndDriver_MissingNamedTemplate(t *testing.T) {
+	gatekeeper := &authmocks.Gatekeeper{}
+	kube := kubefake.NewSimpleClientset()
+	instanceId := "my-instanceid"
+	wf := &wfv1.Workflow{
+		ObjectMeta: metav1.ObjectMeta{Namespace: "my-ns", Name: "missing-tmpl-wf", Labels: map[string]string{
+			common.LabelKeyControllerInstanceID: instanceId,
+		}},
+		Spec: wfv1.WorkflowSpec{
+			Templates: []wfv1.Template{},
+		},
+		Status: wfv1.WorkflowStatus{
+			Nodes: wfv1.Nodes{
+				"some-node": wfv1.NodeStatus{
+					ID:           "some-node",
+					Name:         "some-node",
+					TemplateName: "no-such-template",
+					Outputs: &wfv1.Outputs{
+						Artifacts: wfv1.Artifacts{
+							{
+								Name: "art",
+								ArtifactLocation: wfv1.ArtifactLocation{
+									S3: &wfv1.S3Artifact{
+										Key: "k",
+									},
+								},
+							},
+						},
+					},
+				},
+			},
+		},
+	}
+	argo := fakewfv1.NewSimpleClientset(wf)
+	ctx := context.WithValue(context.WithValue(context.Background(), auth.KubeKey, kube), auth.WfKey, argo)
+	gatekeeper.On("ContextWithRequest", mock.Anything, mock.Anything).Return(ctx, nil)
+	a := &sqldbmocks.WorkflowArchive{}
+	fakeDriverFactory := func(_ context.Context, _ *wfv1.Artifact, _ resource.Interface) (artifactscommon.ArtifactDriver, error) {
+		return &inlineFakeDriver{data: []byte("x")}, nil
+	}
+	artifactRepositories := armocks.DummyArtifactRepositories(&wfv1.ArtifactRepository{
+		S3: &wfv1.S3ArtifactRepository{
+			S3Bucket: wfv1.S3Bucket{Endpoint: "my-endpoint", Bucket: "my-bucket"},
+		},
+	})
+	s := newArtifactServer(gatekeeper, hydratorfake.Noop, a, instanceid.NewService(instanceId), fakeDriverFactory, artifactRepositories)
+
+	wf2, err := s.getWorkflowAndValidate(ctx, "my-ns", "missing-tmpl-wf")
+	assert.NoError(t, err)
+	_, _, err = s.getArtifactAndDriver(ctx, "some-node", "art", false, wf2, nil)
+	assert.Error(t, err, "an explicit non-empty TemplateName that does not resolve must still produce an error")
+}
