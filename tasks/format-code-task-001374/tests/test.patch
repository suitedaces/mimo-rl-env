+
+
+
+
+
+
+import ast
+import os
+import unittest
+import warnings
+
+
+
+
+
+
+REPO_ROOT = os.path.abspath(
+    os.path.join(os.path.dirname(__file__), os.pardir, os.pardir)
+)
+SETUP_PY = os.path.join(REPO_ROOT, "setup.py")
+GOOGLE_INIT = os.path.join(REPO_ROOT, "google", "__init__.py")
+GOOGLE_CLOUD_INIT = os.path.join(REPO_ROOT, "google", "cloud", "__init__.py")
+
+
+def _exec_init_with_strict_deprecation(init_path, package_name):
+
+
+
+
+
+
+
+
+
+
+
+
+    import pkg_resources
+
+    original_declare = pkg_resources.declare_namespace
+
+    def patched_declare_namespace(name):
+        warnings.warn(
+            "Deprecated call to `pkg_resources.declare_namespace(%r)`. "
+            "Implementing implicit namespace packages (as specified in "
+            "PEP 420) is preferred to `pkg_resources.declare_namespace`."
+            % (name,),
+            DeprecationWarning,
+            stacklevel=2,
+        )
+        return original_declare(name)
+
+    package_dir = os.path.dirname(init_path)
+    with open(init_path, "r") as f:
+        source = f.read()
+    code = compile(source, init_path, "exec")
+
+    namespace = {
+        "__name__": package_name,
+        "__file__": init_path,
+        "__path__": [package_dir],
+        "__package__": package_name,
+        "__builtins__": __builtins__,
+    }
+
+    pkg_resources.declare_namespace = patched_declare_namespace
+    try:
+        with warnings.catch_warnings():
+
+
+            warnings.filterwarnings(
+                "error",
+                category=DeprecationWarning,
+                message=r".*declare_namespace.*",
+            )
+            exec(code, namespace)
+    finally:
+        pkg_resources.declare_namespace = original_declare
+
+
+class TestNoDeclareNamespaceDeprecationWarning(unittest.TestCase):
+
+
+
+
+
+
+
+    def test_google_init_does_not_leak_declare_namespace_deprecation(self):
+
+
+        if not os.path.exists(GOOGLE_INIT):
+
+
+            return
+
+
+        _exec_init_with_strict_deprecation(GOOGLE_INIT, "google")
+
+    def test_google_cloud_init_does_not_leak_declare_namespace_deprecation(self):
+
+
+        if not os.path.exists(GOOGLE_CLOUD_INIT):
+            return
+        _exec_init_with_strict_deprecation(GOOGLE_CLOUD_INIT, "google.cloud")
+
+    def test_package_still_imports(self):
+
+        import google.cloud.logging
+
+        self.assertTrue(hasattr(google.cloud.logging, "Client"))
+
+
+class TestSetupPyDoesNotUseDeprecatedNamespacePackages(unittest.TestCase):
+
+
+
+
+
+
+    def setUp(self):
+        with open(SETUP_PY, "r") as f:
+            self.source = f.read()
+        self.tree = ast.parse(self.source)
+
+    def _find_setup_call(self):
+        for node in ast.walk(self.tree):
+            if isinstance(node, ast.Call):
+                func = node.func
+                if isinstance(func, ast.Attribute) and func.attr == "setup":
+                    return node
+                if isinstance(func, ast.Name) and func.id == "setup":
+                    return node
+        return None
+
+    def test_setup_call_does_not_pass_namespace_packages_keyword(self):
+        call = self._find_setup_call()
+        self.assertIsNotNone(call, "could not locate setuptools.setup(...) call")
+        kwarg_names = {kw.arg for kw in call.keywords if kw.arg is not None}
+        self.assertNotIn(
+            "namespace_packages",
+            kwarg_names,
+            msg=(
+                "setup.py still passes the deprecated `namespace_packages=` "
+                "keyword to setuptools.setup; setuptools>=67.3.0 emits a "
+                "DeprecationWarning for this, which is part of the bug."
+            ),
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
