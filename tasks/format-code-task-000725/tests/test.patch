index 0000000..c95f8df
--- /dev/null
+++ b/setup_config_test.py
@@ -0,0 +1,61 @@
+import ast
+import pathlib
+import re
+import unittest
+
+
+class SetupConfigTest(unittest.TestCase):
+
+    def _repo_root(self):
+        return pathlib.Path(__file__).resolve().parent
+
+    def _setup_call_keywords(self):
+        setup_path = self._repo_root() / 'setup.py'
+        module = ast.parse(setup_path.read_text())
+        for node in ast.walk(module):
+            if isinstance(node, ast.Call) and getattr(node.func, 'id', None) == 'setup':
+                return {
+                    keyword.arg: keyword.value
+                    for keyword in node.keywords
+                    if keyword.arg is not None
+                }
+        self.fail('setup.py does not contain a setup() call')
+
+    def _docs_release(self):
+        conf_path = self._repo_root() / 'docs' / 'source' / 'conf.py'
+        module = ast.parse(conf_path.read_text())
+        for node in module.body:
+            if isinstance(node, ast.Assign):
+                for target in node.targets:
+                    if isinstance(target, ast.Name) and target.id == 'release':
+                        return ast.literal_eval(node.value)
+        self.fail('docs/source/conf.py does not assign release')
+
+    def _install_requires(self):
+        keywords = self._setup_call_keywords()
+        self.assertIn('install_requires', keywords)
+        return ast.literal_eval(keywords['install_requires'])
+
+    def test_package_and_docs_versions_are_072(self):
+        keywords = self._setup_call_keywords()
+        self.assertIn('version', keywords)
+
+
+        self.assertEqual(ast.literal_eval(keywords['version']), '0.7.2')
+        self.assertEqual(self._docs_release(), '0.7.2')
+
+    def test_torch_dependency_targets_19(self):
+        install_requires = self._install_requires()
+
+        self.assertIn('torch~=1.9.0', install_requires)
+
+        workflow = (self._repo_root() / '.github' / 'workflows' / 'python-package.yml').read_text()
+
+        self.assertRegex(
+            workflow,
+            r'pip\s+install\s+torch==1\.9\.0\+cpu(?:\s|$)'
+        )
+
+
+if __name__ == '__main__':
+    unittest.main()
