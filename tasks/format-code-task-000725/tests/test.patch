+import unittest
+
+import torch
+
+from all.approximation import Approximation
+
+
+class ApproximationClipGradTest(unittest.TestCase):
+
+    def _make_approximation(self):
+        torch.manual_seed(0)
+        model = torch.nn.Linear(2, 1, bias=False)
+        optimizer = torch.optim.SGD(model.parameters(), lr=0.25)
+        approximation = Approximation(
+            model,
+            optimizer,
+            name='clip_grad_test',
+            clip_grad=1.0
+        )
+        return approximation, model
+
+    def _parameter_clone(self, model):
+        return [parameter.detach().clone() for parameter in model.parameters()]
+
+    def _set_gradient(self, model, value):
+        for parameter in model.parameters():
+            parameter.grad = torch.full_like(parameter, value)
+
+    def test_clip_grad_raises_on_infinite_norm(self):
+        approximation, model = self._make_approximation()
+        before = self._parameter_clone(model)
+        self._set_gradient(model, float('inf'))
+
+        with self.assertRaises(RuntimeError):
+            approximation.step()
+
+        for expected, actual in zip(before, model.parameters()):
+            self.assertTrue(torch.allclose(expected, actual.detach()))
+
+    def test_clip_grad_raises_on_nan_norm(self):
+        approximation, model = self._make_approximation()
+        before = self._parameter_clone(model)
+        self._set_gradient(model, float('nan'))
+
+        with self.assertRaises(RuntimeError):
+            approximation.step()
+
+        for expected, actual in zip(before, model.parameters()):
+            self.assertTrue(torch.allclose(expected, actual.detach()))
+
+    def test_clip_grad_allows_finite_gradients(self):
+        approximation, model = self._make_approximation()
+        before = self._parameter_clone(model)
+        self._set_gradient(model, 0.5)
+
+        result = approximation.step()
+
+        self.assertIs(result, approximation)
+        self.assertFalse(all(torch.allclose(expected, actual.detach())
+                             for expected, actual in zip(before, model.parameters())))
+        self.assertTrue(all(parameter.grad is None or torch.all(parameter.grad == 0)
+                            for parameter in model.parameters()))
+
+
+if __name__ == '__main__':
+    unittest.main()
