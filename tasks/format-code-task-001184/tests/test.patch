+import datetime
+from queue import Queue
+
+import pytest
+
+import telegram
+import telegram.ext as telegram_ext
+from telegram import Chat, ChatMember, Message, Update, User
+
+
+MEMBERSHIP_TIMESTAMP = 1600000000
+EXPIRY_TIMESTAMP = 1600003600
+
+
+def _membership_api():
+    names = ('ChatInviteLink', 'ChatMemberUpdated')
+    missing = [name for name in names if not hasattr(telegram, name)]
+    assert not missing, 'missing public telegram membership API: {}'.format(', '.join(missing))
+    assert hasattr(telegram_ext, 'ChatMemberHandler'), \
+        'missing public telegram.ext.ChatMemberHandler API'
+    return (telegram.ChatInviteLink, telegram.ChatMemberUpdated,
+            telegram_ext.ChatMemberHandler)
+
+
+def _member_payload(status, **overrides):
+    payload = {
+        'user': {'id': 200, 'first_name': 'Target', 'is_bot': False},
+        'status': status,
+        'can_send_messages': True,
+        'can_send_polls': True,
+        'can_invite_users': False,
+    }
+    payload.update(overrides)
+    return payload
+
+
+def _membership_payload(include_invite_link=True):
+    payload = {
+        'chat': {'id': -10042, 'type': Chat.SUPERGROUP, 'title': 'Operators'},
+        'from': {'id': 100, 'first_name': 'Moderator', 'is_bot': False},
+        'date': MEMBERSHIP_TIMESTAMP,
+        'old_chat_member': _member_payload(ChatMember.MEMBER),
+        'new_chat_member': _member_payload(
+            ChatMember.RESTRICTED, can_send_messages=False, can_invite_users=True),
+    }
+    if include_invite_link:
+        payload['invite_link'] = {
+            'invite_link': 'https://t.me/joinchat/codespec',
+            'creator': {'id': 101, 'first_name': 'Inviter', 'is_bot': False},
+            'is_primary': False,
+            'is_revoked': False,
+            'expire_date': EXPIRY_TIMESTAMP,
+            'member_limit': 0,
+        }
+    return payload
+
+
+def test_membership_public_exports_codespec():
+    ChatInviteLink, ChatMemberUpdated, ChatMemberHandler = _membership_api()
+
+    assert ChatInviteLink.__name__ == 'ChatInviteLink'
+    assert ChatMemberUpdated.__name__ == 'ChatMemberUpdated'
+    assert ChatMemberHandler.__name__ == 'ChatMemberHandler'
+
+    creator = User(101, 'Inviter', False)
+    actor = User(100, 'Moderator', False)
+    chat = Chat(-10042, Chat.SUPERGROUP)
+    old_member = ChatMember(User(200, 'Target', False), ChatMember.MEMBER)
+    new_member = ChatMember(User(200, 'Target', False), ChatMember.LEFT)
+    link = ChatInviteLink('https://t.me/joinchat/direct', creator, False, False,
+                          member_limit=0)
+    change = ChatMemberUpdated(
+        chat, actor, datetime.datetime.fromtimestamp(
+            MEMBERSHIP_TIMESTAMP, tz=datetime.timezone.utc),
+        old_member, new_member, invite_link=link)
+
+    assert change.chat is chat
+    assert change.from_user is actor
+    assert change.old_chat_member is old_member
+    assert change.new_chat_member is new_member
+    assert change.invite_link is link
+
+
+def test_chat_invite_link_wire_roundtrip_codespec(bot):
+    ChatInviteLink, _, _ = _membership_api()
+    payload = _membership_payload()['invite_link']
+
+    link = ChatInviteLink.de_json(payload, bot)
+
+    assert isinstance(link.creator, User)
+    assert link.creator.id == 101
+    assert link.invite_link == payload['invite_link']
+    assert link.is_primary is False
+    assert link.is_revoked is False
+    assert link.expire_date == datetime.datetime.fromtimestamp(
+        EXPIRY_TIMESTAMP, tz=datetime.timezone.utc)
+    assert link.member_limit == 0
+    assert link.to_dict() == payload
+
+
+def test_chat_invite_link_optional_fields_codespec(bot):
+    ChatInviteLink, _, _ = _membership_api()
+    payload = {
+        'invite_link': 'https://t.me/joinchat/no-expiry',
+        'creator': {'id': 102, 'first_name': 'Owner', 'is_bot': True},
+        'is_primary': True,
+        'is_revoked': False,
+    }
+
+    link = ChatInviteLink.de_json(payload, bot)
+
+    assert link.expire_date is None
+    assert link.member_limit is None
+    assert 'expire_date' not in link.to_dict()
+    assert 'member_limit' not in link.to_dict()
+    assert link.to_dict()['is_revoked'] is False
+    assert ChatInviteLink.de_json(None, bot) is None
+
+
+def test_chat_member_updated_nested_wire_contract_codespec(bot):
+    ChatInviteLink, ChatMemberUpdated, _ = _membership_api()
+    payload = _membership_payload()
+
+    change = ChatMemberUpdated.de_json(payload, bot)
+
+    assert isinstance(change.chat, Chat)
+    assert isinstance(change.from_user, User)
+    assert change.from_user.id == 100
+    assert isinstance(change.old_chat_member, ChatMember)
+    assert isinstance(change.new_chat_member, ChatMember)
+    assert isinstance(change.invite_link, ChatInviteLink)
+    assert change.date == datetime.datetime.fromtimestamp(
+        MEMBERSHIP_TIMESTAMP, tz=datetime.timezone.utc)
+
+    serialized = change.to_dict()
+    assert set(serialized) == {
+        'chat', 'from', 'date', 'old_chat_member', 'new_chat_member', 'invite_link'
+    }
+    assert serialized['from'] == payload['from']
+    assert serialized['date'] == MEMBERSHIP_TIMESTAMP
+    assert serialized['chat']['id'] == -10042
+    assert serialized['old_chat_member']['status'] == ChatMember.MEMBER
+    assert serialized['new_chat_member']['status'] == ChatMember.RESTRICTED
+    assert serialized['invite_link'] == payload['invite_link']
+
+
+def test_chat_member_updated_optional_invite_codespec(bot):
+    _, ChatMemberUpdated, _ = _membership_api()
+
+    change = ChatMemberUpdated.de_json(_membership_payload(include_invite_link=False), bot)
+
+    assert change.invite_link is None
+    assert 'invite_link' not in change.to_dict()
+    assert ChatMemberUpdated.de_json(None, bot) is None
+
+
+def test_chat_member_updated_difference_codespec(bot):
+    _, ChatMemberUpdated, _ = _membership_api()
+    changed_payload = _membership_payload()
+    del changed_payload['old_chat_member']['can_send_messages']
+    changed_payload['new_chat_member']['can_send_polls'] = False
+    change = ChatMemberUpdated.de_json(changed_payload, bot)
+
+    assert change.difference() == {
+        'status': (ChatMember.MEMBER, ChatMember.RESTRICTED),
+        'can_send_messages': (None, False),
+        'can_send_polls': (True, False),
+        'can_invite_users': (False, True),
+    }
+
+    unchanged_payload = _membership_payload(include_invite_link=False)
+    unchanged_payload['new_chat_member'] = unchanged_payload['old_chat_member'].copy()
+    unchanged = ChatMemberUpdated.de_json(unchanged_payload, bot)
+    assert unchanged.difference() == {}
+
+
+@pytest.mark.parametrize('field', ('my_chat_member', 'chat_member'))
+def test_update_membership_de_json_and_to_dict_codespec(bot, field):
+    _, ChatMemberUpdated, _ = _membership_api()
+    raw_change = _membership_payload()
+    payload = {'update_id': 700, field: raw_change}
+
+    update = Update.de_json(payload, bot)
+
+    assert isinstance(getattr(update, field), ChatMemberUpdated)
+    other_field = 'chat_member' if field == 'my_chat_member' else 'my_chat_member'
+    assert getattr(update, other_field) is None
+    serialized = update.to_dict()
+    assert serialized['update_id'] == 700
+    assert serialized[field]['from'] == raw_change['from']
+    assert serialized[field]['date'] == MEMBERSHIP_TIMESTAMP
+    assert other_field not in serialized
+
+
+@pytest.mark.parametrize('field', ('my_chat_member', 'chat_member'))
+def test_update_membership_effective_properties_codespec(bot, field):
+    _membership_api()
+    update = Update.de_json({'update_id': 701, field: _membership_payload()}, bot)
+    change = getattr(update, field)
+
+    assert update.effective_user.id == 100
+    assert update.effective_user.first_name == 'Moderator'
+    assert update.effective_user.id != change.new_chat_member.user.id
+    assert update.effective_chat.id == -10042
+    assert update.effective_message is None
+
+
+def test_chat_member_handler_mode_selection_codespec(bot):
+    _, _, ChatMemberHandler = _membership_api()
+    callback = lambda update, context: None
+    mine = Update.de_json(
+        {'update_id': 800, 'my_chat_member': _membership_payload()}, bot)
+    another = Update.de_json(
+        {'update_id': 801, 'chat_member': _membership_payload()}, bot)
+    unrelated = Update(802, message=Message(
+        1, User(100, 'Moderator', False), None, Chat(-10042, Chat.SUPERGROUP)))
+
+    default_handler = ChatMemberHandler(callback)
+    assert default_handler.chat_member_types == ChatMemberHandler.MY_CHAT_MEMBER
+    assert default_handler.check_update(mine)
+    assert not default_handler.check_update(another)
+
+    member_handler = ChatMemberHandler(
+        callback, chat_member_types=ChatMemberHandler.CHAT_MEMBER)
+    assert member_handler.check_update(another)
+    assert not member_handler.check_update(mine)
+
+    any_handler = ChatMemberHandler(
+        callback, chat_member_types=ChatMemberHandler.ANY_CHAT_MEMBER)
+    assert any_handler.check_update(mine)
+    assert any_handler.check_update(another)
+    assert not any_handler.check_update(unrelated)
+    assert not any_handler.check_update(object())
+
+
+@pytest.mark.parametrize('invalid_mode', (2, None, 'chat_member'))
+def test_chat_member_handler_constants_and_validation_codespec(invalid_mode):
+    _, _, ChatMemberHandler = _membership_api()
+
+    assert ChatMemberHandler.MY_CHAT_MEMBER == -1
+    assert ChatMemberHandler.CHAT_MEMBER == 0
+    assert ChatMemberHandler.ANY_CHAT_MEMBER == 1
+    with pytest.raises(ValueError):
+        ChatMemberHandler(lambda update, context: None, chat_member_types=invalid_mode)
+
+
+def test_chat_member_handler_context_dispatch_codespec(bot):
+    _, _, ChatMemberHandler = _membership_api()
+    seen = []
+    dispatcher = telegram_ext.Dispatcher(bot, Queue(), use_context=True)
+
+    def callback(update, context):
+        seen.append((update, context.user_data, context.chat_data))
+
+    update = Update.de_json(
+        {'update_id': 900, 'chat_member': _membership_payload()}, bot)
+    dispatcher.add_handler(ChatMemberHandler(
+        callback, chat_member_types=ChatMemberHandler.CHAT_MEMBER))
+    dispatcher.process_update(update)
+
+    assert len(seen) == 1
+    assert seen[0][0] is update
+    assert seen[0][1] is dispatcher.user_data[100]
+    assert seen[0][2] is dispatcher.chat_data[-10042]
+
+
+def test_chat_member_handler_legacy_dispatch_codespec(bot):
+    _, _, ChatMemberHandler = _membership_api()
+    seen = []
+    dispatcher = telegram_ext.Dispatcher(bot, Queue(), use_context=False)
+
+    def callback(callback_bot, update, user_data=None, chat_data=None,
+                 update_queue=None, job_queue=None):
+        seen.append((callback_bot, update, user_data, chat_data,
+                     update_queue, job_queue))
+
+    update = Update.de_json(
+        {'update_id': 901, 'my_chat_member': _membership_payload()}, bot)
+    dispatcher.add_handler(ChatMemberHandler(
+        callback, pass_user_data=True, pass_chat_data=True,
+        pass_update_queue=True, pass_job_queue=True))
+    dispatcher.process_update(update)
+
+    assert len(seen) == 1
+    assert seen[0][0] is dispatcher.bot
+    assert seen[0][1] is update
+    assert seen[0][2] is dispatcher.user_data[100]
+    assert seen[0][3] is dispatcher.chat_data[-10042]
+    assert seen[0][4] is dispatcher.update_queue
+    assert seen[0][5] is dispatcher.job_queue
