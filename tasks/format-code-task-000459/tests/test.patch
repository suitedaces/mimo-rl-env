+static void
+test_first_available_completed_page_order(void)
+{
+
+
+
+
+    ErrorLog log = {0};
+    Jbig2Ctx *ctx = jbig2_ctx_new(NULL, 0, NULL, record_error, &log);
+    Jbig2Image *first;
+    Jbig2Image *second;
+
+    ASSERT_INT("data_in two-page stream", jbig2_data_in(ctx, two_page_stream, sizeof(two_page_stream)), 0);
+    ASSERT_INT("complete current page", jbig2_complete_page(ctx), 0);
+
+    first = jbig2_page_out(ctx);
+    ASSERT_UINT("first page width", first == NULL ? 0 : first->width, 9);
+    ASSERT_UINT("first page height", first == NULL ? 0 : first->height, 3);
+    ASSERT_UINT("first page stride", first == NULL ? 0 : first->stride, 2);
+
+    ASSERT_INT_GE("first page refcount", first == NULL ? 0 : first->refcount, 2);
+
+    second = jbig2_page_out(ctx);
+    ASSERT_UINT("second page width", second == NULL ? 0 : second->width, 17);
+    ASSERT_UINT("second page height", second == NULL ? 0 : second->height, 1);
+    ASSERT_UINT("second page stride", second == NULL ? 0 : second->stride, 3);
+
+    ASSERT_INT_GE("second page refcount", second == NULL ? 0 : second->refcount, 2);
+
+    ASSERT_PTR_NOT_EQ("first and second pages are distinct", second, first);
+    ASSERT_NULL("no third completed page", jbig2_page_out(ctx));
+
+    jbig2_release_page(ctx, first);
+    jbig2_release_page(ctx, second);
+    jbig2_ctx_free(ctx);
+}
