+static void
+test_incremental_complete_page_and_single_page_handoff(void)
+{
+
+
+
+
+    ErrorLog log = {0};
+    Jbig2Ctx *ctx = jbig2_ctx_new(NULL, 0, NULL, record_error, &log);
+    Jbig2Image *image;
+    char data_hex[32] = {0};
+    int before_release;
+
+    ASSERT_NULL("fresh page_out", jbig2_page_out(ctx));
+    ASSERT_INT("data_in partial header", jbig2_data_in(ctx, one_page_stream, 20), 0);
+    ASSERT_NULL("partial page_out", jbig2_page_out(ctx));
+    ASSERT_INT("data_in page body", jbig2_data_in(ctx, one_page_stream + 20, sizeof(one_page_stream) - 20), 0);
+    ASSERT_NULL("before complete page_out", jbig2_page_out(ctx));
+    ASSERT_INT("complete_page", jbig2_complete_page(ctx), 0);
+
+    image = jbig2_page_out(ctx);
+    ASSERT_UINT("image width", image == NULL ? 0 : image->width, 9);
+    ASSERT_UINT("image height", image == NULL ? 0 : image->height, 3);
+    ASSERT_UINT("image stride", image == NULL ? 0 : image->stride, 2);
+
+    ASSERT_INT_GE("image refcount after page_out", image == NULL ? 0 : image->refcount, 2);
+    image_data_hex(image, data_hex, sizeof(data_hex));
+    ASSERT_STR("image data", data_hex, "000000000000");
+    ASSERT_NULL("second page_out", jbig2_page_out(ctx));
+
+    before_release = log.count;
+    jbig2_release_page(ctx, image);
+
+    ASSERT_NO_SEVERITY_AT_OR_ABOVE_FROM("release warning/fatal callbacks", &log, before_release, JBIG2_SEVERITY_WARNING);
+
+    jbig2_ctx_free(ctx);
+}
+
+static void
+test_complete_page_without_image_reports_fatal(void)
+{
+
+
+
+
+    ErrorLog log = {0};
+    Jbig2Ctx *ctx = jbig2_ctx_new(NULL, 0, NULL, record_error, &log);
+    int before_complete;
+
+    ASSERT_NULL("fresh page_out", jbig2_page_out(ctx));
+    before_complete = log.count;
+    ASSERT_INT("complete_page without image", jbig2_complete_page(ctx), -1);
+
+    ASSERT_LOG_HAS_SEVERITY_FROM("fatal callback", &log, before_complete, JBIG2_SEVERITY_FATAL);
+    ASSERT_NULL("page_out after fatal complete", jbig2_page_out(ctx));
+
+    jbig2_ctx_free(ctx);
+}
