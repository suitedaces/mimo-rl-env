+static void
+test_release_foreign_image_warns_without_crashing(void)
+{
+
+
+
+
+    ErrorLog log = {0};
+    Jbig2Ctx *ctx = jbig2_ctx_new(NULL, 0, NULL, record_error, &log);
+    Jbig2Image foreign = {0};
+    int before_release = log.count;
+
+    jbig2_release_page(ctx, &foreign);
+
+    ASSERT_LOG_HAS_SEVERITY_FROM("foreign image warning callback", &log, before_release, JBIG2_SEVERITY_WARNING);
+    ASSERT_LOG_SEVERITY_COUNT_GE_FROM("foreign image warning callback count", &log, before_release, JBIG2_SEVERITY_WARNING, 1);
+    ASSERT_NO_SEVERITY_AT_OR_ABOVE_FROM("foreign image fatal callback count", &log, before_release, JBIG2_SEVERITY_FATAL);
+
+    jbig2_ctx_free(ctx);
+}
