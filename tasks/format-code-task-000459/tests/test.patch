+static void
+test_unknown_length_pending_segment_warns_fails_and_advances(void)
+{
+
+
+
+
+    ErrorLog log = {0};
+    Jbig2Ctx *ctx = jbig2_ctx_new(NULL, 0, NULL, record_error, &log);
+    Jbig2Image *image;
+    int before_complete;
+
+    ASSERT_INT("data_in unknown length stream", jbig2_data_in(ctx, unknown_length_pending_stream, sizeof(unknown_length_pending_stream)), 0);
+    before_complete = log.count;
+    ASSERT_INT("first complete_page", jbig2_complete_page(ctx), -1);
+    ASSERT_NULL("page_out after failed parse", jbig2_page_out(ctx));
+
+    ASSERT_LOG_SEVERITY_COUNT_GE_FROM("unknown length and failed parse warnings", &log, before_complete, JBIG2_SEVERITY_WARNING, 2);
+
+    ASSERT_INT("second complete_page after segment advance", jbig2_complete_page(ctx), 0);
+    image = jbig2_page_out(ctx);
+    ASSERT_UINT("advanced page width", image == NULL ? 0 : image->width, 9);
+    ASSERT_UINT("advanced page height", image == NULL ? 0 : image->height, 3);
+    ASSERT_UINT("advanced page stride", image == NULL ? 0 : image->stride, 2);
+
+    jbig2_release_page(ctx, image);
+    jbig2_ctx_free(ctx);
+}
