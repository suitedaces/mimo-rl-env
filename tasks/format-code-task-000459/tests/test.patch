+static void
+image_data_hex(const Jbig2Image *image, char *out, size_t out_size)
+{
+    size_t bytes;
+    size_t i;
+
+    if (image == NULL || out_size == 0) {
+        if (out_size != 0)
+            out[0] = '\0';
+        return;
+    }
+
+    bytes = (size_t)image->stride * image->height;
+    if (out_size < bytes * 2 + 1)
+        bytes = (out_size - 1) / 2;
+
+    for (i = 0; i < bytes; i++)
+        snprintf(out + i * 2, out_size - i * 2, "%02x", image->data[i]);
+}
