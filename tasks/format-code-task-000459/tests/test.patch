+static void
+test_release_and_context_free_leave_allocator_empty_over_many_cycles(void)
+{
+
+
+
+
+    TrackingAllocator tracker = new_tracking_allocator();
+    int i;
+
+    for (i = 0; i < 125; i++) {
+        ErrorLog log = {0};
+        Jbig2Ctx *ctx = jbig2_ctx_new(&tracker.super, 0, NULL, record_error, &log);
+        Jbig2Image *image;
+
+        if (ctx == NULL) {
+            FAIL_NOW("jbig2_ctx_new returned NULL");
+            return;
+        }
+
+        ASSERT_INT("cycle data_in", jbig2_data_in(ctx, one_page_stream, sizeof(one_page_stream)), 0);
+        ASSERT_INT("cycle complete_page", jbig2_complete_page(ctx), 0);
+        image = jbig2_page_out(ctx);
+        ASSERT_UINT("cycle page width", image == NULL ? 0 : image->width, 9);
+        ASSERT_UINT("cycle page height", image == NULL ? 0 : image->height, 3);
+        ASSERT_UINT("cycle page stride", image == NULL ? 0 : image->stride, 2);
+        jbig2_release_page(ctx, image);
+        jbig2_ctx_free(ctx);
+    }
+
+    ASSERT_SIZE("active allocations after cycles", tracker.active_allocs, 0);
+    ASSERT_SIZE("active bytes after cycles", tracker.active_bytes, 0);
+
+    ASSERT_SIZE_GE("peak allocations observed", tracker.peak_allocs, 1);
+    ASSERT_SIZE_GE("peak bytes observed", tracker.peak_bytes, 1);
+}
+
+int
+main(void)
+{
+    test_incremental_complete_page_and_single_page_handoff();
+    test_complete_page_without_image_reports_fatal();
+    test_unknown_length_pending_segment_warns_fails_and_advances();
+    test_first_available_completed_page_order();
+    test_release_null_twice_is_noop();
+    test_release_foreign_image_warns_without_crashing();
+    test_two_contexts_keep_page_lifecycle_independent();
+    test_release_and_context_free_leave_allocator_empty_over_many_cycles();
+
+    if (failures != 0) {
+        fprintf(stderr, "%d acceptance assertion(s) failed\n", failures);
+        return 1;
+    }
+
+    printf("page lifecycle acceptance tests passed\n");
