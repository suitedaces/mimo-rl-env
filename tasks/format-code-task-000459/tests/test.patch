+static void *
+tracking_alloc(Jbig2Allocator *allocator, size_t size)
+{
+    TrackingAllocator *tracker = (TrackingAllocator *)allocator;
+    size_t *base = (size_t *)malloc(sizeof(size_t) + size);
+
+    if (base == NULL)
+        return NULL;
+
+    *base = size;
+    tracker->active_allocs++;
+    tracker->active_bytes += size;
+    if (tracker->active_allocs > tracker->peak_allocs)
+        tracker->peak_allocs = tracker->active_allocs;
+    if (tracker->active_bytes > tracker->peak_bytes)
+        tracker->peak_bytes = tracker->active_bytes;
+
+    return base + 1;
+}
+
+static void
+tracking_free(Jbig2Allocator *allocator, void *p)
+{
+    TrackingAllocator *tracker = (TrackingAllocator *)allocator;
+    size_t *base;
+
+    if (p == NULL)
+        return;
+
+    base = ((size_t *)p) - 1;
+    tracker->active_allocs--;
+    tracker->active_bytes -= *base;
+    free(base);
+}
+
+static void *
+tracking_realloc(Jbig2Allocator *allocator, void *p, size_t size)
+{
+    TrackingAllocator *tracker = (TrackingAllocator *)allocator;
+    size_t old_size = 0;
+    size_t *base;
+    size_t *new_base;
+
+    if (p == NULL)
+        return tracking_alloc(allocator, size);
+
+    base = ((size_t *)p) - 1;
+    old_size = *base;
+    new_base = (size_t *)realloc(base, sizeof(size_t) + size);
+    if (new_base == NULL)
+        return NULL;
+
+    *new_base = size;
+    tracker->active_bytes = tracker->active_bytes - old_size + size;
+    if (tracker->active_bytes > tracker->peak_bytes)
+        tracker->peak_bytes = tracker->active_bytes;
+
+    return new_base + 1;
+}
+
+static TrackingAllocator
+new_tracking_allocator(void)
+{
+    TrackingAllocator tracker;
+
+    memset(&tracker, 0, sizeof(tracker));
+    tracker.super.alloc = tracking_alloc;
+    tracker.super.free = tracking_free;
+    tracker.super.realloc = tracking_realloc;
+    return tracker;
+}
