+#include "jbig2.h"
+
+typedef struct {
+    int count;
+    Jbig2Severity severity[64];
+    uint32_t segment[64];
+    char message[64][256];
+} ErrorLog;
+
+typedef struct {
+    Jbig2Allocator super;
+    size_t active_allocs;
+    size_t active_bytes;
+    size_t peak_allocs;
+    size_t peak_bytes;
+} TrackingAllocator;
+
+static int failures = 0;
+
+static void
+record_error(void *data, const char *msg, Jbig2Severity severity, uint32_t seg_idx)
+{
+    ErrorLog *log = (ErrorLog *)data;
+
+    if (log->count < 64) {
+        log->severity[log->count] = severity;
+        log->segment[log->count] = seg_idx;
+        snprintf(log->message[log->count], sizeof(log->message[log->count]), "%s", msg);
+    }
+    log->count++;
+}
+
+static void
+fail_at(const char *test, int line, const char *what)
+{
+    fprintf(stderr, "FAIL %s:%d: %s\n", test, line, what);
+    failures++;
+}
+
+static void
+assert_int_eq(const char *test, int line, const char *label, int actual, int expected)
+{
+    if (actual != expected) {
+        fprintf(stderr, "FAIL %s:%d: %s actual=%d expected=%d\n", test, line, label, actual, expected);
+        failures++;
+    }
+}
+
+static void
+assert_uint_eq(const char *test, int line, const char *label, uint32_t actual, uint32_t expected)
+{
+    if (actual != expected) {
+        fprintf(stderr, "FAIL %s:%d: %s actual=%u expected=%u\n", test, line, label, actual, expected);
+        failures++;
+    }
+}
+
+static void
+assert_size_eq(const char *test, int line, const char *label, size_t actual, size_t expected)
+{
+    if (actual != expected) {
+        fprintf(stderr, "FAIL %s:%d: %s actual=%lu expected=%lu\n",
+                test, line, label, (unsigned long)actual, (unsigned long)expected);
+        failures++;
+    }
+}
+
+static void
+assert_int_ge(const char *test, int line, const char *label, int actual, int minimum)
+{
+    if (actual < minimum) {
+        fprintf(stderr, "FAIL %s:%d: %s actual=%d minimum=%d\n", test, line, label, actual, minimum);
+        failures++;
+    }
+}
+
+static void
+assert_size_ge(const char *test, int line, const char *label, size_t actual, size_t minimum)
+{
+    if (actual < minimum) {
+        fprintf(stderr, "FAIL %s:%d: %s actual=%lu minimum=%lu\n",
+                test, line, label, (unsigned long)actual, (unsigned long)minimum);
+        failures++;
+    }
+}
+
+static void
+assert_ptr_null(const char *test, int line, const char *label, const void *actual)
+{
+    if (actual != NULL) {
+        fprintf(stderr, "FAIL %s:%d: %s actual=%p expected=(nil)\n", test, line, label, actual);
+        failures++;
+    }
+}
+
+static void
+assert_ptr_not_eq(const char *test, int line, const char *label, const void *actual, const void *unexpected)
+{
+    if (actual == unexpected) {
+        fprintf(stderr, "FAIL %s:%d: %s actual=%p unexpected=%p\n", test, line, label, actual, unexpected);
+        failures++;
+    }
+}
+
+static void
+assert_str_eq(const char *test, int line, const char *label, const char *actual, const char *expected)
+{
+    if (strcmp(actual, expected) != 0) {
+        fprintf(stderr, "FAIL %s:%d: %s actual=\"%s\" expected=\"%s\"\n",
+                test, line, label, actual, expected);
+        failures++;
+    }
+}
+
+static int
+log_limit(const ErrorLog *log)
+{
+    return log->count < 64 ? log->count : 64;
+}
+
+static int
+log_count_severity_from(const ErrorLog *log, int start, Jbig2Severity severity)
+{
+    int count = 0;
+    int i;
+    int limit = log_limit(log);
+
+    if (start < 0)
+        start = 0;
+
+    for (i = start; i < limit; i++) {
+        if (log->severity[i] == severity)
+            count++;
+    }
+    return count;
+}
+
+static void
+assert_log_has_severity_from(const char *test, int line, const char *label,
+                             const ErrorLog *log, int start, Jbig2Severity severity)
+{
+    if (log_count_severity_from(log, start, severity) == 0) {
+        fprintf(stderr, "FAIL %s:%d: %s missing severity=%d from index=%d count=%d\n",
+                test, line, label, severity, start, log->count);
+        failures++;
+    }
+}
+
+static void
+assert_log_severity_count_ge_from(const char *test, int line, const char *label,
+                                  const ErrorLog *log, int start, Jbig2Severity severity, int minimum)
+{
+    int actual = log_count_severity_from(log, start, severity);
+
+    if (actual < minimum) {
+        fprintf(stderr, "FAIL %s:%d: %s severity=%d actual=%d minimum=%d from index=%d count=%d\n",
+                test, line, label, severity, actual, minimum, start, log->count);
+        failures++;
+    }
+}
+
+static void
+assert_no_severity_at_or_above_from(const char *test, int line, const char *label,
+                                    const ErrorLog *log, int start, Jbig2Severity minimum)
+{
+    int i;
+    int limit = log_limit(log);
+
+    if (start < 0)
+        start = 0;
+
+    for (i = start; i < limit; i++) {
+        if (log->severity[i] >= minimum) {
+            fprintf(stderr, "FAIL %s:%d: %s severity=%d at index=%d minimum=%d\n",
+                    test, line, label, log->severity[i], i, minimum);
+            failures++;
+            return;
+        }
+    }
+}
+
+#define ASSERT_INT(label, actual, expected) assert_int_eq(__func__, __LINE__, label, actual, expected)
+#define ASSERT_INT_GE(label, actual, minimum) assert_int_ge(__func__, __LINE__, label, actual, minimum)
+#define ASSERT_UINT(label, actual, expected) assert_uint_eq(__func__, __LINE__, label, actual, expected)
+#define ASSERT_SIZE(label, actual, expected) assert_size_eq(__func__, __LINE__, label, actual, expected)
+#define ASSERT_SIZE_GE(label, actual, minimum) assert_size_ge(__func__, __LINE__, label, actual, minimum)
+#define ASSERT_NULL(label, actual) assert_ptr_null(__func__, __LINE__, label, actual)
+#define ASSERT_PTR_NOT_EQ(label, actual, unexpected) assert_ptr_not_eq(__func__, __LINE__, label, actual, unexpected)
+#define ASSERT_STR(label, actual, expected) assert_str_eq(__func__, __LINE__, label, actual, expected)
+#define ASSERT_LOG_HAS_SEVERITY_FROM(label, log, start, severity) assert_log_has_severity_from(__func__, __LINE__, label, log, start, severity)
+#define ASSERT_LOG_SEVERITY_COUNT_GE_FROM(label, log, start, severity, minimum) assert_log_severity_count_ge_from(__func__, __LINE__, label, log, start, severity, minimum)
+#define ASSERT_NO_SEVERITY_AT_OR_ABOVE_FROM(label, log, start, minimum) assert_no_severity_at_or_above_from(__func__, __LINE__, label, log, start, minimum)
+#define FAIL_NOW(what) fail_at(__func__, __LINE__, what)
