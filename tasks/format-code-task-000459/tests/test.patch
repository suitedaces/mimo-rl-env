+static void
+test_two_contexts_keep_page_lifecycle_independent(void)
+{
+
+
+
+
+    ErrorLog log_a = {0};
+    ErrorLog log_b = {0};
+    Jbig2Ctx *a = jbig2_ctx_new(NULL, 0, NULL, record_error, &log_a);
+    Jbig2Ctx *b = jbig2_ctx_new(NULL, 0, NULL, record_error, &log_b);
+    Jbig2Image *image_a;
+    Jbig2Image *image_b;
+
+    ASSERT_INT("ctx a data_in", jbig2_data_in(a, one_page_stream, sizeof(one_page_stream)), 0);
+    ASSERT_INT("ctx a complete", jbig2_complete_page(a), 0);
+    image_a = jbig2_page_out(a);
+    ASSERT_UINT("ctx a page width", image_a == NULL ? 0 : image_a->width, 9);
+    ASSERT_UINT("ctx a page height", image_a == NULL ? 0 : image_a->height, 3);
+    ASSERT_NULL("ctx b page_out before own feed", jbig2_page_out(b));
+
+    ASSERT_NO_SEVERITY_AT_OR_ABOVE_FROM("ctx b warnings before own feed", &log_b, 0, JBIG2_SEVERITY_WARNING);
+
+    ASSERT_INT("ctx b data_in", jbig2_data_in(b, two_page_stream, sizeof(two_page_stream)), 0);
+    ASSERT_INT("ctx b complete", jbig2_complete_page(b), 0);
+    image_b = jbig2_page_out(b);
+    ASSERT_UINT("ctx b first page width", image_b == NULL ? 0 : image_b->width, 9);
+    ASSERT_UINT("ctx b first page height", image_b == NULL ? 0 : image_b->height, 3);
+    ASSERT_UINT("ctx b first page stride", image_b == NULL ? 0 : image_b->stride, 2);
+
+    jbig2_release_page(a, image_a);
+    jbig2_release_page(b, image_b);
+    image_b = jbig2_page_out(b);
+    ASSERT_UINT("ctx b second page width", image_b == NULL ? 0 : image_b->width, 17);
+    ASSERT_UINT("ctx b second page height", image_b == NULL ? 0 : image_b->height, 1);
+    ASSERT_UINT("ctx b second page stride", image_b == NULL ? 0 : image_b->stride, 3);
+    jbig2_release_page(b, image_b);
+
+    jbig2_ctx_free(a);
+    jbig2_ctx_free(b);
+}
