diff --git a/usercase-test-coderl/test_pagination_state.py b/usercase-test-coderl/test_pagination_state.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_pagination_state.py
@@ -0,0 +1,387 @@
+
+
+
+
+
+
+from __future__ import annotations
+
+import copy
+from urllib.parse import parse_qs, urlparse
+
+import httpx
+import pytest
+
+from pyzotero import Zotero
+
+
+PAGE_ONE = [{"key": "P0", "data": {"title": "first page"}}]
+PAGE_TWO = [{"key": "P1", "data": {"title": "second page"}}]
+PAGE_THREE = [{"key": "P2", "data": {"title": "third page"}}]
+BIBTEX_PAGES = {
+    "0": "@article{alpha,\n  title = {Entry Zero},\n  author = {Author, A}\n}\n",
+    "1": "@article{beta,\n  title = {Entry One},\n  author = {Author, B}\n}\n",
+    "2": "@article{gamma,\n  title = {Entry Two},\n  author = {Author, C}\n}\n",
+}
+
+
+class TopPages:
+    def __init__(
+        self,
+        *,
+        library_id: str = "42",
+        local: bool = False,
+        limit_two: bool = False,
+        single_page: bool = False,
+    ) -> None:
+        self.library_id = library_id
+        self.local = local
+        self.limit_two = limit_two
+        self.single_page = single_page
+        self.calls: list[str] = []
+
+    @property
+    def endpoint(self) -> str:
+        if self.local:
+            return "http://localhost:23119/api"
+        return "https://api.zotero.org"
+
+    @property
+    def base(self) -> str:
+        return f"{self.endpoint}/users/{self.library_id}/items/top"
+
+    def client(self) -> httpx.Client:
+        return httpx.Client(
+            transport=httpx.MockTransport(self._handle),
+            follow_redirects=True,
+        )
+
+    def _handle(self, request: httpx.Request) -> httpx.Response:
+        self.calls.append(str(request.url))
+        parsed = urlparse(str(request.url))
+        params = parse_qs(parsed.query)
+        start = params.get("start", ["0"])[0]
+        limit = params.get("limit", ["1"])[0]
+        headers = {"Content-Type": "application/json"}
+
+        if self.single_page:
+            body = [{"key": "B0"}, {"key": "B1"}]
+        elif self.limit_two:
+            if start == "0":
+                body = [{"key": "A0"}, {"key": "A1"}]
+                headers["Link"] = (
+                    f'<{self.base}?limit=2&locale=en-US>; rel="self", '
+                    f'<{self.base}?limit=2&start=2&locale=en-US>; rel="next", '
+                    f'<{self.base}?limit=2&start=2&locale=en-US>; rel="last"'
+                )
+            else:
+                body = [{"key": "A2"}]
+                headers["Link"] = (
+                    f'<{self.base}?limit=2&start=2&locale=en-US>; rel="self", '
+                    f'<{self.base}?limit=2&start=2&locale=en-US>; rel="last"'
+                )
+        else:
+            pages = {"0": PAGE_ONE, "1": PAGE_TWO, "2": PAGE_THREE}
+            body = pages[start]
+            if start == "0":
+                headers["Link"] = (
+                    f'<{self.base}?limit={limit}&locale=en-US>; rel="self", '
+                    f'<{self.base}?limit={limit}&start=1&locale=en-US>; rel="next", '
+                    f'<{self.base}?limit={limit}&start=2&locale=en-US>; rel="last"'
+                )
+            elif start == "1":
+                headers["Link"] = (
+                    f'<{self.base}?limit={limit}&start=1&locale=en-US>; rel="self", '
+                    f'<{self.base}?limit={limit}&start=2&locale=en-US>; rel="next", '
+                    f'<{self.base}?limit={limit}&start=2&locale=en-US>; rel="last"'
+                )
+            else:
+                headers["Link"] = (
+                    f'<{self.base}?limit={limit}&start=2&locale=en-US>; rel="self", '
+                    f'<{self.base}?limit={limit}&start=2&locale=en-US>; rel="last"'
+                )
+
+        return httpx.Response(
+            200,
+            headers=headers,
+            json=copy.deepcopy(body),
+            request=request,
+        )
+
+
+class BibtexTopPages:
+    def __init__(self) -> None:
+        self.calls: list[str] = []
+
+    def client(self) -> httpx.Client:
+        return httpx.Client(
+            transport=httpx.MockTransport(self._handle),
+            follow_redirects=True,
+        )
+
+    def _handle(self, request: httpx.Request) -> httpx.Response:
+        self.calls.append(str(request.url))
+        parsed = urlparse(str(request.url))
+        start = parse_qs(parsed.query).get("start", ["0"])[0]
+        base = "https://api.zotero.org/users/42/items/top"
+        headers = {"Content-Type": "application/x-bibtex"}
+        if start == "0":
+            headers["Link"] = (
+                f'<{base}?format=bibtex&limit=1&locale=en-US>; rel="self", '
+                f'<{base}?format=bibtex&limit=1&start=1&locale=en-US>; rel="next", '
+                f'<{base}?format=bibtex&limit=1&start=2&locale=en-US>; rel="last"'
+            )
+        elif start == "1":
+            headers["Link"] = (
+                f'<{base}?format=bibtex&limit=1&start=1&locale=en-US>; rel="self", '
+                f'<{base}?format=bibtex&limit=1&start=2&locale=en-US>; rel="next", '
+                f'<{base}?format=bibtex&limit=1&start=2&locale=en-US>; rel="last"'
+            )
+        else:
+            headers["Link"] = (
+                f'<{base}?format=bibtex&limit=1&start=2&locale=en-US>; rel="self", '
+                f'<{base}?format=bibtex&limit=1&start=2&locale=en-US>; rel="last"'
+            )
+        return httpx.Response(
+            200,
+            headers=headers,
+            text=BIBTEX_PAGES[start],
+            request=request,
+        )
+
+
+def _assert_requested_page(
+    url: str,
+    *,
+    path: str = "/users/42/items/top",
+    limit: str = "1",
+    start: str | None = None,
+    locale: str = "en-US",
+) -> None:
+    parsed = urlparse(url)
+    params = parse_qs(parsed.query)
+
+    assert parsed.path == path
+    assert params.get("limit") == [limit]
+    assert params.get("locale") == [locale]
+    if start is None:
+        assert "start" not in params or params["start"] == ["0"]
+    else:
+        assert params.get("start") == [start]
+
+
+def test_follow_advances_link_state_and_returns_next_pages() -> None:
+
+
+
+    backend = TopPages()
+    client = backend.client()
+    zot = Zotero("42", "user", "key", client=client)
+
+
+    assert callable(zot.follow)
+    assert zot.top(limit=1) == [{"key": "P0", "data": {"title": "first page"}}]
+
+
+    _assert_requested_page(backend.calls[0])
+
+    assert zot.follow() == [{"key": "P1", "data": {"title": "second page"}}]
+
+    _assert_requested_page(backend.calls[-1], start="1")
+
+    assert zot.follow() == [{"key": "P2", "data": {"title": "third page"}}]
+
+    _assert_requested_page(backend.calls[-1], start="2")
+    assert list(zot.iterfollow()) == []
+    client.close()
+
+
+def test_local_follow_uses_next_link_without_duplicate_api_path() -> None:
+
+
+
+    backend = TopPages(local=True)
+    client = backend.client()
+    zot = Zotero("42", "user", "key", local=True, client=client)
+
+    assert zot.top(limit=1) == [{"key": "P0", "data": {"title": "first page"}}]
+    assert zot.follow() == [{"key": "P1", "data": {"title": "second page"}}]
+
+
+    _assert_requested_page(
+        backend.calls[-1],
+        path="/api/users/42/items/top",
+        start="1",
+    )
+    assert "/api/api/" not in urlparse(backend.calls[-1]).path
+    client.close()
+
+
+def test_iterfollow_yields_successive_follow_results_then_stops() -> None:
+
+
+
+    backend = TopPages()
+    client = backend.client()
+    zot = Zotero("42", "user", "key", client=client)
+
+    assert zot.top(limit=1) == [{"key": "P0", "data": {"title": "first page"}}]
+    assert list(zot.iterfollow()) == [
+        [{"key": "P1", "data": {"title": "second page"}}],
+        [{"key": "P2", "data": {"title": "third page"}}],
+    ]
+
+    assert list(zot.iterfollow()) == []
+    client.close()
+
+
+def test_makeiter_requires_previous_paginated_self_link() -> None:
+
+
+
+    backend = TopPages()
+    client = backend.client()
+    zot = Zotero("42", "user", "key", client=client)
+
+    with pytest.raises(RuntimeError) as excinfo:
+        zot.makeiter([])
+
+    message = str(excinfo.value).lower()
+    assert "link" in message or "pagination" in message
+    client.close()
+
+
+def test_makeiter_resets_to_self_link_and_refetches_first_page() -> None:
+
+
+
+    backend = TopPages()
+    client = backend.client()
+    zot = Zotero("42", "user", "key", client=client)
+
+    first_page = zot.top(limit=1)
+    assert first_page == [{"key": "P0", "data": {"title": "first page"}}]
+    generator = zot.makeiter(first_page)
+    assert list(generator) == [
+        [{"key": "P0", "data": {"title": "first page"}}],
+        [{"key": "P1", "data": {"title": "second page"}}],
+        [{"key": "P2", "data": {"title": "third page"}}],
+    ]
+
+
+    _assert_requested_page(backend.calls[1], limit="1", start=None, locale="en-US")
+    client.close()
+
+
+def test_everything_extends_list_pages() -> None:
+
+
+
+    backend = TopPages()
+    client = backend.client()
+    zot = Zotero("42", "user", "key", client=client)
+
+    assert zot.everything(zot.top(limit=1)) == [
+        {"key": "P0", "data": {"title": "first page"}},
+        {"key": "P1", "data": {"title": "second page"}},
+        {"key": "P2", "data": {"title": "third page"}},
+    ]
+
+    assert list(zot.iterfollow()) == []
+    client.close()
+
+
+def test_everything_copies_and_extends_entries_collection() -> None:
+
+
+
+    backend = BibtexTopPages()
+    client = backend.client()
+    zot = Zotero("42", "user", "key", client=client)
+
+    first_page = zot.top(format="bibtex", limit=1)
+    result = zot.everything(first_page)
+
+
+
+    assert [entry.get("title") for entry in result.entries] == [
+        "Entry Zero",
+        "Entry One",
+        "Entry Two",
+    ]
+    assert [entry.get("title") for entry in first_page.entries] == ["Entry Zero"]
+
+
+    _assert_requested_page(backend.calls[-1], start="2")
+    client.close()
+
+
+def test_all_top_fetches_top_then_everything_with_limit_two() -> None:
+
+
+
+    backend = TopPages(limit_two=True)
+    client = backend.client()
+    zot = Zotero("42", "user", "key", client=client)
+
+    assert zot.all_top(limit=2) == [{"key": "A0"}, {"key": "A1"}, {"key": "A2"}]
+
+    _assert_requested_page(backend.calls[-1], limit="2", start="2")
+    client.close()
+
+
+def test_two_zotero_instances_keep_independent_link_state() -> None:
+
+
+
+    backend_a = TopPages(library_id="42")
+    backend_b = TopPages(library_id="99", single_page=True)
+    client_a = backend_a.client()
+    client_b = backend_b.client()
+    a = Zotero("42", "user", "key", client=client_a)
+    b = Zotero("99", "user", "key", client=client_b)
+
+
+    assert callable(a.follow)
+    assert callable(b.follow)
+    assert a.top(limit=1) == [{"key": "P0", "data": {"title": "first page"}}]
+    assert a.follow() == [{"key": "P1", "data": {"title": "second page"}}]
+    assert b.top(limit=2) == [{"key": "B0"}, {"key": "B1"}]
+
+
+    assert list(b.iterfollow()) == []
+    assert a.follow() == [{"key": "P2", "data": {"title": "third page"}}]
+    client_a.close()
+    client_b.close()
+
+
+def test_iterfollow_stops_immediately_when_no_next_link_exists() -> None:
+
+
+
+    backend = TopPages(single_page=True)
+    client = backend.client()
+    zot = Zotero("42", "user", "key", client=client)
+
+    assert zot.top(limit=2) == [{"key": "B0"}, {"key": "B1"}]
+
+    assert list(zot.iterfollow()) == []
+    client.close()
+
+
+def test_everything_works_from_fresh_instances_across_repeated_cycles() -> None:
+
+
+
+    for _ in range(3):
+        backend = TopPages()
+        client = backend.client()
+        zot = Zotero("42", "user", "key", client=client)
+
+
+        assert zot.everything(zot.top(limit=1)) == [
+            {"key": "P0", "data": {"title": "first page"}},
+            {"key": "P1", "data": {"title": "second page"}},
+            {"key": "P2", "data": {"title": "third page"}},
+        ]
+        client.close()
