diff --git a/usercase-test-coderl/test_readable_percentiles.py b/usercase-test-coderl/test_readable_percentiles.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_readable_percentiles.py
@@ -0,0 +1,158 @@
+
+
+
+
+
+
+from __future__ import annotations
+
+import copy
+import json
+import os
+import socket
+import subprocess
+import sys
+
+import pytest
+
+os.environ.setdefault("LOCUST_SKIP_MONKEY_PATCH", "1")
+
+from locust.stats import get_readable_percentiles
+
+
+def test_empty_percentile_list_returns_empty_list():
+
+
+
+
+    percentiles: list[float] = []
+
+    actual = get_readable_percentiles(percentiles)
+
+    assert actual == []
+
+
+def test_common_report_percentiles_use_whole_number_labels():
+
+
+
+
+    percentiles = [0.5, 0.66, 0.75, 0.8, 0.95, 1.0]
+
+    actual = get_readable_percentiles(percentiles)
+
+    assert actual == ["50%", "66%", "75%", "80%", "95%", "100%"]
+
+
+def test_high_precision_percentiles_keep_non_integer_precision():
+
+
+
+
+    percentiles = [0.999, 0.9999, 0.666666]
+
+    actual = get_readable_percentiles(percentiles)
+
+    assert actual == ["99.9%", "99.99%", "66.6666%"]
+
+
+def test_fractional_percentage_is_rounded_to_six_decimal_places():
+
+
+
+
+    percentiles = [0.123456789]
+
+    actual = get_readable_percentiles(percentiles)
+
+    assert actual == ["12.345679%"]
+
+
+def test_lower_bound_fraction_uses_integer_label():
+
+
+
+
+    percentiles = [0.0]
+
+    actual = get_readable_percentiles(percentiles)
+
+    assert actual == ["0%"]
+
+
+def test_non_numeric_item_raises_type_error():
+
+
+
+
+    with pytest.raises(TypeError):
+        get_readable_percentiles([None])
+
+
+def test_referential_transparency_for_repeated_calls():
+    percentiles = [0.5, 0.123456789, 1.0]
+
+    first = get_readable_percentiles(percentiles)
+    second = get_readable_percentiles(percentiles)
+
+    assert first == ["50%", "12.345679%", "100%"]
+    assert second == ["50%", "12.345679%", "100%"]
+    assert first == second
+
+
+def test_returns_new_list_and_does_not_mutate_input():
+    percentiles = [0.5, 0.9999, 0.123456789]
+    original = copy.deepcopy(percentiles)
+
+    actual = get_readable_percentiles(percentiles)
+
+    assert actual == ["50%", "99.99%", "12.345679%"]
+    assert percentiles == original
+    assert actual is not percentiles
+
+
+def test_same_input_matches_fresh_process_result():
+    percentiles = [0.999, 0.9999, 0.666666]
+
+    in_process = get_readable_percentiles(percentiles)
+    script = """
+import json
+import os
+import sys
+os.environ.setdefault("LOCUST_SKIP_MONKEY_PATCH", "1")
+sys.path.insert(0, "/workspace/repo")
+from locust.stats import get_readable_percentiles
+sys.stdout.write(json.dumps(get_readable_percentiles([0.999, 0.9999, 0.666666])))
+"""
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        capture_output=True,
+        text=True,
+        env={**os.environ, "LOCUST_SKIP_MONKEY_PATCH": "1"},
+    )
+    fresh_process = json.loads(completed.stdout)
+
+    assert in_process == ["99.9%", "99.99%", "66.6666%"]
+    assert fresh_process == ["99.9%", "99.99%", "66.6666%"]
+    assert in_process == fresh_process
+
+
+def test_no_filesystem_or_network_side_effects(tmp_path, monkeypatch):
+    def blocked_open(*args, **kwargs):
+        raise AssertionError("filesystem access is not declared for this helper")
+
+    def blocked_socket(*args, **kwargs):
+        raise AssertionError("network access is not declared for this helper")
+
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr("builtins.open", blocked_open)
+    monkeypatch.setattr(socket, "socket", blocked_socket)
+    before = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob("*"))
+
+    actual = get_readable_percentiles([0.66, 0.123456789])
+
+    after = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob("*"))
+    assert actual == ["66%", "12.345679%"]
+    assert before == []
+    assert after == []
