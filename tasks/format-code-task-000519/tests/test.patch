+from os.path import join
+import os
+
+from rastervision.pipeline.config import register_config
+from rastervision.pipeline.pipeline import Pipeline
+from rastervision.pipeline.pipeline_config import PipelineConfig
+
+
+@register_config(
+    'acceptance_local_runner.pipeline',
+    plugin='rastervision.acceptance_local_runner')
+class AcceptancePipelineConfig(PipelineConfig):
+    event_log_uri: str | None = None
+    fail_command: str = ''
+
+    def update(self):
+        if self.event_log_uri is None:
+            self.event_log_uri = join(self.root_uri, 'events.log')
+
+    def build(self, tmp_dir):
+        return AcceptancePipeline(self, tmp_dir)
+
+
+class AcceptancePipeline(Pipeline):
+    commands = ['chip', 'train', 'predict', 'package']
+    split_commands = ['chip', 'predict']
+    gpu_commands = []
+
+    def _record(self, command, split_ind=0, num_splits=1):
+        if self.config.fail_command == command:
+            raise RuntimeError(f'intentional failure in {command}')
+
+        os.makedirs(os.path.dirname(self.config.event_log_uri), exist_ok=True)
+        with open(self.config.event_log_uri, 'a') as f:
+            f.write(f'{command}|{split_ind}|{num_splits}\n')
+        print(f'event {command} {split_ind}/{num_splits}')
+
+    def chip(self, split_ind=0, num_splits=1):
+        self._record('chip', split_ind, num_splits)
+
+    def train(self):
+        self._record('train')
+
+    def predict(self, split_ind=0, num_splits=1):
+        self._record('predict', split_ind, num_splits)
+
+    def package(self):
+        self._record('package')
