diff --git a/pkg/copier/mapfields_test.go b/pkg/copier/mapfields_test.go
new file mode 100644
index 0000000..059279e
--- /dev/null
+++ b/pkg/copier/mapfields_test.go
@@ -0,0 +1,172 @@
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+package copier
+
+import (
+	"reflect"
+	"testing"
+)
+
+
+
+
+func replacer(name string) string {
+	values := map[string]string{
+		"key": "realkey",
+		"val": "realval",
+		"x":   "X",
+		"y":   "Y",
+	}
+	if v, ok := values[name]; ok {
+		return v
+	}
+	return "$" + name
+}
+
+type mapHolder struct {
+	Data  map[string]string
+	Other map[string]string
+}
+
+func TestSubstituteMapValuesOnly(t *testing.T) {
+	src := &mapHolder{Data: map[string]string{"$key": "$val"}}
+	got := CopyWithReplacements(src, replacer, "Data.Values").(*mapHolder)
+
+	want := map[string]string{"$key": "realval"}
+	if !reflect.DeepEqual(got.Data, want) {
+		t.Fatalf("Data.Values: expected %v, got %v", want, got.Data)
+	}
+}
+
+func TestSubstituteMapKeysOnly(t *testing.T) {
+	src := &mapHolder{Data: map[string]string{"$key": "$val"}}
+	got := CopyWithReplacements(src, replacer, "Data.Keys").(*mapHolder)
+
+	want := map[string]string{"realkey": "$val"}
+	if !reflect.DeepEqual(got.Data, want) {
+		t.Fatalf("Data.Keys: expected %v, got %v", want, got.Data)
+	}
+}
+
+func TestSubstituteMapFieldSelectsBoth(t *testing.T) {
+	src := &mapHolder{Data: map[string]string{"$key": "$val"}}
+	got := CopyWithReplacements(src, replacer, "Data").(*mapHolder)
+
+	want := map[string]string{"realkey": "realval"}
+	if !reflect.DeepEqual(got.Data, want) {
+		t.Fatalf("Data: expected %v, got %v", want, got.Data)
+	}
+}
+
+func TestSubstituteMapNothingSelected(t *testing.T) {
+	src := &mapHolder{Data: map[string]string{"$key": "$val"}}
+	got := CopyWithReplacements(src, replacer).(*mapHolder)
+
+	want := map[string]string{"$key": "$val"}
+	if !reflect.DeepEqual(got.Data, want) {
+		t.Fatalf("no selection: expected %v, got %v", want, got.Data)
+	}
+}
+
+func TestSubstituteMapOnlySelectedMapAffected(t *testing.T) {
+	src := &mapHolder{
+		Data:  map[string]string{"$key": "$val"},
+		Other: map[string]string{"$key": "$val"},
+	}
+	got := CopyWithReplacements(src, replacer, "Data.Keys", "Data.Values").(*mapHolder)
+
+	if !reflect.DeepEqual(got.Data, map[string]string{"realkey": "realval"}) {
+		t.Fatalf("Data: expected fully substituted map, got %v", got.Data)
+	}
+	if !reflect.DeepEqual(got.Other, map[string]string{"$key": "$val"}) {
+		t.Fatalf("Other: expected untouched map, got %v", got.Other)
+	}
+}
+
+type inner struct {
+	Title string
+	Note  string
+}
+
+type nestedHolder struct {
+	Cfg map[string]inner
+}
+
+func TestSubstituteIntoMapValueStructField(t *testing.T) {
+	src := &nestedHolder{Cfg: map[string]inner{
+		"$key": {Title: "$x", Note: "$y"},
+	}}
+	got := CopyWithReplacements(src, replacer, "Cfg.Values.Title").(*nestedHolder)
+
+	want := map[string]inner{
+		"$key": {Title: "X", Note: "$y"},
+	}
+	if !reflect.DeepEqual(got.Cfg, want) {
+		t.Fatalf("Cfg.Values.Title: expected %v, got %v", want, got.Cfg)
+	}
+}
+
+func TestSubstituteWildcardCoversMapKeysAndValues(t *testing.T) {
+	src := &mapHolder{Data: map[string]string{"$key": "$val"}}
+	got := CopyWithReplacements(src, replacer, "*").(*mapHolder)
+
+	want := map[string]string{"realkey": "realval"}
+	if !reflect.DeepEqual(got.Data, want) {
+		t.Fatalf("wildcard: expected %v, got %v", want, got.Data)
+	}
+}
+
+type strHolder struct {
+	Name  string
+	Plain string
+}
+
+func TestSubstituteStringFieldByPath(t *testing.T) {
+	src := &strHolder{Name: "$x", Plain: "$y"}
+	got := CopyWithReplacements(src, replacer, "Name").(*strHolder)
+
+	if got.Name != "X" {
+		t.Fatalf("Name: expected substituted value X, got %q", got.Name)
+	}
+	if got.Plain != "$y" {
+		t.Fatalf("Plain: expected untouched $y, got %q", got.Plain)
+	}
+}
+
+func TestCopyProducesIndependentDeepCopy(t *testing.T) {
+	src := &mapHolder{Data: map[string]string{"$key": "$val"}}
+	got := Copy(src).(*mapHolder)
+
+
+	if !reflect.DeepEqual(got.Data, map[string]string{"$key": "$val"}) {
+		t.Fatalf("Copy should not substitute, got %v", got.Data)
+	}
+
+
+	got.Data["$key"] = "changed"
+	if src.Data["$key"] != "$val" {
+		t.Fatalf("Copy is not a deep copy: source mutated to %q", src.Data["$key"])
+	}
+}
+
+func TestCopyWithReplacementsIndependentFromSource(t *testing.T) {
+	src := &mapHolder{Data: map[string]string{"$key": "$val"}}
+	got := CopyWithReplacements(src, replacer, "Data.Values").(*mapHolder)
+
+	got.Data["$key"] = "changed"
+	if src.Data["$key"] != "$val" {
+		t.Fatalf("result shares storage with source: source mutated to %q", src.Data["$key"])
+	}
+}
