@@ -22,8 +22,10 @@ import unittest
 
 from qiskit import QuantumRegister, ClassicalRegister, QuantumCircuit
 from qiskit.circuit import Qubit, Clbit
+from qiskit.extensions import ZGate, HGate
 from qiskit.visualization import utils
 from qiskit.visualization import circuit_drawer
+from qiskit.visualization.circuit_visualization import _generate_latex_source
 from qiskit.test import QiskitTestCase
 
 logger = logging.getLogger(__name__)
@@ -427,5 +429,45 @@ c1_0: 0 ════════════════════════
             utils.generate_latex_label(r'$a$bc$_∭X∀Y'))
 
 
+class TestLatexCCZRendering(QiskitTestCase):
+    """Verify multi-controlled Z gates render as ctrl/control nodes
+    instead of a multigate or boxed Z (issue: ccz drawing inconsistency)."""
+
+    def test_latex_ccz_uses_control_qw(self):
+        """CCZ: qubits 0/1 use \\ctrl{1}; qubit 2 uses \\control\\qw."""
+        qr = QuantumRegister(3, 'q')
+        circuit = QuantumCircuit(qr)
+        circuit.append(ZGate().control(2), [qr[0], qr[1], qr[2]])
+        latex = _generate_latex_source(circuit)
+
+        self.assertNotIn('multigate{2}{ccz}', latex)
+        self.assertNotIn('ghost{ccz}', latex)
+        self.assertNotIn('\\gate{Z}', latex)
+
+        self.assertIn('\\ctrl{1}', latex)
+        self.assertIn('\\control\\qw', latex)
+
+    def test_latex_c3z_uses_control_qw(self):
+        """C3Z: qubits 0/1/2 use \\ctrl{1}; qubit 3 uses \\control\\qw."""
+        qr = QuantumRegister(4, 'q')
+        circuit = QuantumCircuit(qr)
+        circuit.append(ZGate().control(3),
+                       [qr[0], qr[1], qr[2], qr[3]])
+        latex = _generate_latex_source(circuit)
+        self.assertNotIn('\\gate{Z}', latex)
+        self.assertNotIn('multigate', latex)
+        self.assertIn('\\ctrl{1}', latex)
+        self.assertIn('\\control\\qw', latex)
+
+    def test_latex_cch_preserved(self):
+        """Preservation: CCH (HGate().control(2)) still uses gate{H}."""
+        qr = QuantumRegister(3, 'q')
+        circuit = QuantumCircuit(qr)
+        circuit.append(HGate().control(2), [qr[0], qr[1], qr[2]])
+        latex = _generate_latex_source(circuit)
+        self.assertIn('\\gate{H}', latex)
+        self.assertIn('\\ctrl{1}', latex)
+
+
 if __name__ == '__main__':
     unittest.main(verbosity=2)
