index 659a30b9f..858df8e18 100644
--- a/test/python/visualization/test_circuit_text_drawer.py
+++ b/test/python/visualization/test_circuit_text_drawer.py
@@ -2292,5 +2292,74 @@ class TestTextWithLayout(QiskitTestCase):
         self.assertEqual(qc_result.draw(output='text', fold=86).single_string(), expected)
 
 
+class TestTextDrawerCCZRendering(QiskitTestCase):
+    """Verify multi-controlled Z gates render with bullets on every wire
+    (issue: ccz drawing inconsistency)."""
+
+    def test_text_ccz_all_bullets(self):
+        """CCZ via ZGate().control(2): every qubit drawn as bullet."""
+        expected = '\n'.join(["           ",
+                              "q_0: |0>─■─",
+                              "         │ ",
+                              "q_1: |0>─■─",
+                              "         │ ",
+                              "q_2: |0>─■─",
+                              "           "])
+        qr = QuantumRegister(3, 'q')
+        circuit = QuantumCircuit(qr)
+        circuit.append(ZGate().control(2), [qr[0], qr[1], qr[2]])
+        self.assertEqual(str(_text_circuit_drawer(circuit)), expected)
+
+    def test_text_c3z_all_bullets(self):
+        """C3Z via ZGate().control(3): every qubit drawn as bullet."""
+        expected = '\n'.join(["           ",
+                              "q_0: |0>─■─",
+                              "         │ ",
+                              "q_1: |0>─■─",
+                              "         │ ",
+                              "q_2: |0>─■─",
+                              "         │ ",
+                              "q_3: |0>─■─",
+                              "           "])
+        qr = QuantumRegister(4, 'q')
+        circuit = QuantumCircuit(qr)
+        circuit.append(ZGate().control(3),
+                       [qr[0], qr[1], qr[2], qr[3]])
+        self.assertEqual(str(_text_circuit_drawer(circuit)), expected)
+
+    def test_text_ccz_target_middle(self):
+        """CCZ with target qubit in the middle still renders as all bullets.
+
+        ZGate is symmetric across control/target, so reordered qargs must
+        still produce three connected bullets, not a box on q_2."""
+        expected = '\n'.join(["           ",
+                              "q_0: |0>─■─",
+                              "         │ ",
+                              "q_1: |0>─■─",
+                              "         │ ",
+                              "q_2: |0>─■─",
+                              "           "])
+        qr = QuantumRegister(3, 'q')
+        circuit = QuantumCircuit(qr)
+
+        circuit.append(ZGate().control(2), [qr[0], qr[2], qr[1]])
+        self.assertEqual(str(_text_circuit_drawer(circuit)), expected)
+
+    def test_text_cch_preserved(self):
+        """Preservation: CCH (HGate().control(2)) still renders with a
+        box on the H target — the fix is specific to base_gate Z."""
+        expected = '\n'.join(["             ",
+                              "q_0: |0>──■──",
+                              "          │  ",
+                              "q_1: |0>──■──",
+                              "        ┌─┴─┐",
+                              "q_2: |0>┤ H ├",
+                              "        └───┘"])
+        qr = QuantumRegister(3, 'q')
+        circuit = QuantumCircuit(qr)
+        circuit.append(HGate().control(2), [qr[0], qr[1], qr[2]])
+        self.assertEqual(str(_text_circuit_drawer(circuit)), expected)
+
+
 if __name__ == '__main__':
     unittest.main()
diff --git a/test/python/visualization/test_visualization.py b/test/python/visualization/test_visualization.py
