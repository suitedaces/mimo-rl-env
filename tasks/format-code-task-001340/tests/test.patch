new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/parameter_literals_test.go
@@ -0,0 +1,307 @@
+package usercase_test_coderl
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/google/cql"
+	"github.com/google/cql/model"
+	"github.com/google/cql/parser"
+	"github.com/google/cql/result"
+)
+
+
+
+
+
+var (
+	testLibKey      = result.LibKey{Name: "TESTLIB", Version: "1.0.0"}
+	otherLibKey     = result.LibKey{Name: "OTHERLIB", Version: "1.0.0"}
+	thresholdDefKey = result.DefKey{Name: "Threshold", Library: testLibKey}
+	tagsDefKey      = result.DefKey{Name: "Tags", Library: testLibKey}
+	periodDefKey    = result.DefKey{Name: "Period", Library: testLibKey}
+)
+
+const thresholdLib = "library TESTLIB version '1.0.0'\nparameter Threshold Integer default 5\ndefine TESTRESULT: Threshold"
+const otherThresholdLib = "library OTHERLIB version '1.0.0'\nparameter Threshold Integer default 42\ndefine TESTRESULT: Threshold"
+const tagsLib = "library TESTLIB version '1.0.0'\nparameter Tags List<String>\ndefine TESTRESULT: Tags"
+const periodLib = "library TESTLIB version '1.0.0'\nparameter Period Interval<Date>\ndefine TESTRESULT: Period"
+
+func TestDefaultParameterEvaluatesToLibraryDefault(t *testing.T) {
+
+
+	got := evalInt(t, []string{thresholdLib}, nil, testLibKey)
+
+	if got != 5 {
+		t.Fatalf("TESTRESULT = %d, want 5", got)
+	}
+}
+
+func TestIntegerParameterOverrideEvaluatesToSuppliedLiteral(t *testing.T) {
+
+
+	got := evalInt(t, []string{thresholdLib}, map[result.DefKey]string{thresholdDefKey: "9"}, testLibKey)
+
+	if got != 9 {
+		t.Fatalf("TESTRESULT = %d, want 9", got)
+	}
+}
+
+func TestParameterOverrideUsesMatchingLibraryKey(t *testing.T) {
+
+
+	params := map[result.DefKey]string{thresholdDefKey: "9"}
+
+	testGot := evalInt(t, []string{thresholdLib, otherThresholdLib}, params, testLibKey)
+	otherGot := evalInt(t, []string{thresholdLib, otherThresholdLib}, params, otherLibKey)
+
+	if testGot != 9 {
+		t.Fatalf("TESTLIB TESTRESULT = %d, want 9", testGot)
+	}
+	if otherGot != 42 {
+		t.Fatalf("OTHERLIB TESTRESULT = %d, want 42", otherGot)
+	}
+}
+
+func TestListStringParameterLiteralEvaluatesToTwoItemList(t *testing.T) {
+
+
+	got := evalValue(t, []string{tagsLib}, map[result.DefKey]string{tagsDefKey: "{'alpha', 'beta'}"}, testLibKey)
+
+
+	gotSlice, err := result.ToSlice(got)
+	if err != nil {
+		t.Fatalf("result.ToSlice returned error: %v", err)
+	}
+	if len(gotSlice) != 2 {
+		t.Fatalf("list length = %d, want 2", len(gotSlice))
+	}
+	gotStrings := []string{mustString(t, gotSlice[0]), mustString(t, gotSlice[1])}
+	wantStrings := []string{"alpha", "beta"}
+	if !reflect.DeepEqual(gotStrings, wantStrings) {
+		t.Fatalf("list values = %#v, want %#v", gotStrings, wantStrings)
+	}
+}
+
+func TestIntervalParameterLiteralEvaluatesToClosedDateInterval(t *testing.T) {
+
+
+	got := evalValue(t, []string{periodLib}, map[result.DefKey]string{periodDefKey: "Interval[@2017, @2019]"}, testLibKey)
+
+	gotInterval, err := result.ToInterval(got)
+	if err != nil {
+		t.Fatalf("result.ToInterval returned error: %v", err)
+	}
+	if !gotInterval.LowInclusive || !gotInterval.HighInclusive {
+		t.Fatalf("interval inclusivity = (%t, %t), want closed interval", gotInterval.LowInclusive, gotInterval.HighInclusive)
+	}
+	assertYearDate(t, gotInterval.Low, 2017)
+	assertYearDate(t, gotInterval.High, 2019)
+}
+
+func TestInvalidParameterDeclarationReturnsParameterErrors(t *testing.T) {
+
+
+	assertParameterError(t, "define X: 4", "single literal")
+}
+
+func TestInvalidParameterMultipleTermsReturnsParameterErrors(t *testing.T) {
+
+
+	assertParameterError(t, "4 15", "single literal")
+}
+
+func TestInvalidParameterEmptyStringReturnsParameterErrors(t *testing.T) {
+
+
+	assertParameterError(t, "", "")
+}
+
+func TestInvalidParameterUnresolvedInvocationReturnsParameterErrors(t *testing.T) {
+
+
+	assertParameterError(t, "invo", "literal")
+}
+
+func TestReferentialTransparencyForSameLibrariesAndParameters(t *testing.T) {
+	params := map[result.DefKey]string{thresholdDefKey: "9"}
+
+	first := evalInt(t, []string{thresholdLib}, params, testLibKey)
+	second := evalInt(t, []string{thresholdLib}, params, testLibKey)
+
+	if first != 9 || second != 9 {
+		t.Fatalf("repeated results = (%d, %d), want (9, 9)", first, second)
+	}
+	if first != second {
+		t.Fatalf("repeated results differ: first=%d second=%d", first, second)
+	}
+}
+
+func TestParseDoesNotMutateParameterMap(t *testing.T) {
+	params := map[result.DefKey]string{thresholdDefKey: "9", tagsDefKey: "{'alpha', 'beta'}"}
+	before := map[result.DefKey]string{thresholdDefKey: "9", tagsDefKey: "{'alpha', 'beta'}"}
+
+	_ = evalInt(t, []string{thresholdLib}, params, testLibKey)
+
+	if !reflect.DeepEqual(params, before) {
+		t.Fatalf("parameter map mutated: got %#v, want %#v", params, before)
+	}
+}
+
+func TestNoGlobalStateAcrossDifferentParameterShapes(t *testing.T) {
+	params := map[result.DefKey]string{thresholdDefKey: "9"}
+	first := evalInt(t, []string{thresholdLib}, params, testLibKey)
+
+	_ = evalValue(t, []string{tagsLib}, map[result.DefKey]string{tagsDefKey: "{'alpha', 'beta'}"}, testLibKey)
+	_ = evalValue(t, []string{periodLib}, map[result.DefKey]string{periodDefKey: "Interval[@2017, @2019]"}, testLibKey)
+	_ = evalInt(t, []string{thresholdLib}, nil, testLibKey)
+	second := evalInt(t, []string{thresholdLib}, params, testLibKey)
+
+	if first != 9 || second != 9 {
+		t.Fatalf("results around noise calls = (%d, %d), want (9, 9)", first, second)
+	}
+}
+
+func TestParameterParsingDoesNotWriteWorkingDirectoryFiles(t *testing.T) {
+	tmp := t.TempDir()
+	originalWD, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("os.Getwd returned error: %v", err)
+	}
+	defer func() {
+		if err := os.Chdir(originalWD); err != nil {
+			t.Fatalf("restoring working directory: %v", err)
+		}
+	}()
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatalf("os.Chdir(%q) returned error: %v", tmp, err)
+	}
+	before := snapshotDir(t, tmp)
+
+	got := evalInt(t, []string{thresholdLib}, map[result.DefKey]string{thresholdDefKey: "9"}, testLibKey)
+	after := snapshotDir(t, tmp)
+
+	if got != 9 {
+		t.Fatalf("TESTRESULT = %d, want 9", got)
+	}
+	if !reflect.DeepEqual(after, before) {
+		t.Fatalf("working directory changed: before=%#v after=%#v", before, after)
+	}
+}
+
+func evalValue(t *testing.T, libs []string, params map[result.DefKey]string, libKey result.LibKey) result.Value {
+	t.Helper()
+	elm, err := cql.Parse(context.Background(), libs, cql.ParseConfig{Parameters: params})
+	if err != nil {
+		t.Fatalf("Parse returned error: %v", err)
+	}
+	resultLibs, err := elm.Eval(context.Background(), nil, cql.EvalConfig{})
+	if err != nil {
+		t.Fatalf("Eval returned error: %v", err)
+	}
+	libResults, ok := resultLibs[libKey]
+	if !ok {
+		t.Fatalf("result library %v missing from %#v", libKey, resultLibs)
+	}
+	got, ok := libResults["TESTRESULT"]
+	if !ok {
+		t.Fatalf("TESTRESULT missing from library %v results %#v", libKey, libResults)
+	}
+	return got
+}
+
+func evalInt(t *testing.T, libs []string, params map[result.DefKey]string, libKey result.LibKey) int32 {
+	t.Helper()
+	got, err := result.ToInt32(evalValue(t, libs, params, libKey))
+	if err != nil {
+		t.Fatalf("result.ToInt32 returned error: %v", err)
+	}
+	return got
+}
+
+func assertParameterError(t *testing.T, input, wantMessageSubstring string) {
+	t.Helper()
+	_, err := cql.Parse(context.Background(), []string{thresholdLib}, cql.ParseConfig{
+		Parameters: map[result.DefKey]string{thresholdDefKey: input},
+	})
+	if err == nil {
+		t.Fatalf("Parse(%q) succeeded, want *parser.ParameterErrors", input)
+	}
+	var parameterErr *parser.ParameterErrors
+	if !errors.As(err, &parameterErr) {
+		t.Fatalf("Parse(%q) error type %T, want *parser.ParameterErrors: %v", input, err, err)
+	}
+	if parameterErr.DefKey != thresholdDefKey {
+		t.Fatalf("ParameterErrors.DefKey = %#v, want %#v", parameterErr.DefKey, thresholdDefKey)
+	}
+	if len(parameterErr.Errors) != 1 {
+		t.Fatalf("ParameterErrors count = %d, want 1: %#v", len(parameterErr.Errors), parameterErr.Errors)
+	}
+	got := parameterErr.Errors[0]
+	if strings.TrimSpace(got.Message) == "" {
+		t.Fatalf("ParsingError.Message is empty for input %q", input)
+	}
+
+	if wantMessageSubstring != "" && !strings.Contains(strings.ToLower(got.Message), wantMessageSubstring) {
+		t.Fatalf("ParsingError.Message = %q, want substring %q", got.Message, wantMessageSubstring)
+	}
+}
+
+func assertYearDate(t *testing.T, v result.Value, wantYear int) {
+	t.Helper()
+	gotDate, err := result.ToDate(v)
+	if err != nil {
+		t.Fatalf("result.ToDate returned error: %v", err)
+	}
+	got := result.DateTime(gotDate)
+	if got.Date.Year() != wantYear || got.Precision != model.YEAR {
+		t.Fatalf("date = year %d precision %q, want year %d precision %q", got.Date.Year(), got.Precision, wantYear, model.YEAR)
+	}
+}
+
+func mustString(t *testing.T, v result.Value) string {
+	t.Helper()
+	s, err := result.ToString(v)
+	if err != nil {
+		t.Fatalf("result.ToString returned error: %v", err)
+	}
+	return s
+}
+
+func snapshotDir(t *testing.T, root string) []string {
+	t.Helper()
+	var entries []string
+	if err := filepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if path == root {
+			return nil
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		if d.IsDir() {
+			entries = append(entries, rel+"/")
+			return nil
+		}
+		info, err := d.Info()
+		if err != nil {
+			return err
+		}
+		entries = append(entries, rel+":"+info.Mode().String()+":"+strconv.FormatInt(info.Size(), 10))
+		return nil
+	}); err != nil {
+		t.Fatalf("snapshotDir(%q) returned error: %v", root, err)
+	}
+	sort.Strings(entries)
+	return entries
+}
