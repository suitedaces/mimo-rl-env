diff --git a/test/issue-543-request-not-null.test.js b/test/issue-543-request-not-null.test.js
new file mode 100644
index 00000000..1e595e7a
--- /dev/null
+++ b/test/issue-543-request-not-null.test.js
@@ -0,0 +1,172 @@
+'use strict'
+
+
+
+
+
+const t = require('tap')
+const test = t.test
+const Fastify = require('..')
+
+
+
+test('onSend hook receives non-null request when onRequest hook errors', t => {
+  t.plan(5)
+  const fastify = Fastify()
+
+  fastify.addHook('onRequest', function (req, res, next) {
+    next(new Error('onrequest error'))
+  })
+
+  fastify.addHook('onSend', function (request, reply, payload, next) {
+    t.notEqual(request, null, 'request must not be null in onSend')
+    t.type(request, 'object', 'request must be an object')
+    t.ok(request.headers, 'request.headers must be defined')
+    t.ok(request.req, 'request.req must be defined')
+    next()
+  })
+
+  fastify.get('/', function (req, reply) {
+    reply.send({ hello: 'world' })
+  })
+
+  fastify.inject({ method: 'GET', url: '/' }, res => {
+    t.strictEqual(res.statusCode, 500)
+  })
+})
+
+test('errorHandler receives reply with non-null request when onRequest hook errors', t => {
+  t.plan(4)
+  const fastify = Fastify()
+
+  fastify.addHook('onRequest', function (req, res, next) {
+    next(new Error('onrequest error'))
+  })
+
+  fastify.setErrorHandler(function (err, reply) {
+    t.ok(err, 'err is forwarded')
+    t.notEqual(reply.request, null, 'reply.request must not be null')
+    t.ok(reply.request && reply.request.headers, 'reply.request.headers must be accessible')
+    reply.code(500).send(err)
+  })
+
+  fastify.get('/', function (req, reply) {
+    reply.send({ hello: 'world' })
+  })
+
+  fastify.inject({ method: 'GET', url: '/' }, res => {
+    t.strictEqual(res.statusCode, 500)
+  })
+})
+
+
+
+test('onSend hook receives non-null request when use() middleware errors', t => {
+  t.plan(5)
+  const fastify = Fastify()
+
+  fastify.use(function (req, res, next) {
+    next(new Error('middleware error'))
+  })
+
+  fastify.addHook('onSend', function (request, reply, payload, next) {
+    t.notEqual(request, null, 'request must not be null in onSend')
+    t.type(request, 'object', 'request must be an object')
+    t.ok(request.headers, 'request.headers must be defined')
+    t.ok(request.req, 'request.req must be defined')
+    next()
+  })
+
+  fastify.get('/', function (req, reply) {
+    reply.send({ hello: 'world' })
+  })
+
+  fastify.inject({ method: 'GET', url: '/' }, res => {
+    t.strictEqual(res.statusCode, 500)
+  })
+})
+
+test('errorHandler receives reply with non-null request when use() middleware errors', t => {
+  t.plan(4)
+  const fastify = Fastify()
+
+  fastify.use(function (req, res, next) {
+    next(new Error('middleware error'))
+  })
+
+  fastify.setErrorHandler(function (err, reply) {
+    t.ok(err, 'err is forwarded')
+    t.notEqual(reply.request, null, 'reply.request must not be null')
+    t.ok(reply.request && reply.request.headers, 'reply.request.headers must be accessible')
+    reply.code(500).send(err)
+  })
+
+  fastify.get('/', function (req, reply) {
+    reply.send({ hello: 'world' })
+  })
+
+  fastify.inject({ method: 'GET', url: '/' }, res => {
+    t.strictEqual(res.statusCode, 500)
+  })
+})
+
+
+
+test('onSend hook receives non-null request when custom content-type parser errors', t => {
+  t.plan(5)
+  const fastify = Fastify()
+
+  fastify.addContentTypeParser('application/jsoff', function (req, done) {
+    done(new Error('parser error'))
+  })
+
+  fastify.addHook('onSend', function (request, reply, payload, next) {
+    t.notEqual(request, null, 'request must not be null in onSend')
+    t.type(request, 'object', 'request must be an object')
+    t.ok(request.headers, 'request.headers must be defined')
+    t.ok(request.req, 'request.req must be defined')
+    next()
+  })
+
+  fastify.post('/', function (req, reply) {
+    reply.send({ hello: 'world' })
+  })
+
+  fastify.inject({
+    method: 'POST',
+    url: '/',
+    payload: 'anything',
+    headers: { 'content-type': 'application/jsoff' }
+  }, res => {
+    t.ok(res.statusCode >= 400, 'response is an error')
+  })
+})
+
+test('errorHandler receives reply with non-null request when custom content-type parser errors', t => {
+  t.plan(4)
+  const fastify = Fastify()
+
+  fastify.addContentTypeParser('application/jsoff', function (req, done) {
+    done(new Error('parser error'))
+  })
+
+  fastify.setErrorHandler(function (err, reply) {
+    t.ok(err, 'err is forwarded')
+    t.notEqual(reply.request, null, 'reply.request must not be null')
+    t.ok(reply.request && reply.request.headers, 'reply.request.headers must be accessible')
+    reply.code(500).send(err)
+  })
+
+  fastify.post('/', function (req, reply) {
+    reply.send({ hello: 'world' })
+  })
+
+  fastify.inject({
+    method: 'POST',
+    url: '/',
+    payload: 'anything',
+    headers: { 'content-type': 'application/jsoff' }
+  }, res => {
+    t.strictEqual(res.statusCode, 500)
+  })
+})
