diff --git a/usercase-test-coderl/inline_script.test.js b/usercase-test-coderl/inline_script.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/inline_script.test.js
@@ -0,0 +1,298 @@
+
+
+
+const assert = require('assert');
+const path = require('path');
+const vm = require('vm');
+
+const compiler = require('/workspace/repo/src/compiler');
+
+const FIXTURES = '/workspace/repo/usercase-test-coderl/fixtures';
+const OPTIONS = { minify: false, 'normalize.css': false };
+
+const SOURCES = {
+  topLevel:
+    'foo = 1\n' +
+    '<script fooVariable=foo>fooVariable.mutate("set", [fun.expressions.Number(2)])</script>\n' +
+    '<div id="out">foo</div>',
+  xmlHook:
+    '<div id="out"><script>fun.emit(hookName, fun.expressions.Text("ready"))</script></div>',
+  functionBody:
+    'make = function() { <script>yieldValue(fun.expressions.Text("ok"))</script> }\n' +
+    '<div id="out">make()</div>',
+};
+
+const INLINE_SNIPPETS = {
+  topLevel: 'fooVariable.mutate("set", [fun.expressions.Number(2)])',
+  xmlHook: 'fun.emit(hookName, fun.expressions.Text("ready"))',
+  functionBody: 'yieldValue(fun.expressions.Text("ok"))',
+  compileFile: 'barVariable.mutate("set", [fun.expressions.Number(11)])',
+};
+
+async function testCompileCodeTopLevelScriptMutatesBoundVariable() {
+
+
+  const html = await compileCode(SOURCES.topLevel, cloneOptions());
+  assertFullHtmlDocument(html);
+  assertInlineScriptGenerated(html, INLINE_SNIPPETS.topLevel, ['fooVariable']);
+  assert.strictEqual(renderedText(html, 'out'), '2');
+}
+
+async function testCompileCodeNestedXmlScriptGetsCurrentHookName() {
+
+
+  const html = await compileCode(SOURCES.xmlHook, cloneOptions());
+  assertFullHtmlDocument(html);
+  assertInlineScriptGenerated(html, INLINE_SNIPPETS.xmlHook, ['hookName']);
+  assert.strictEqual(renderedText(html, 'out'), 'ready');
+}
+
+async function testCompileCodeFunctionBodyScriptCanYieldValue() {
+
+
+  const html = await compileCode(SOURCES.functionBody, cloneOptions());
+  assertFullHtmlDocument(html);
+  assertInlineScriptGenerated(html, INLINE_SNIPPETS.functionBody, []);
+  assert.strictEqual(renderedText(html, 'out'), 'ok');
+}
+
+async function testCompileFileSupportsInlineScriptBlocks() {
+
+
+  const sourceFile = path.join(FIXTURES, 'compile-file-inline-script.fun');
+  const html = await compileFile(sourceFile, cloneOptions());
+  assertFullHtmlDocument(html);
+  assertInlineScriptGenerated(html, INLINE_SNIPPETS.compileFile, ['barVariable']);
+  assert.strictEqual(renderedText(html, 'out'), '11');
+}
+
+async function testCompileCodeSuccessCallbackReceivesNullAndHtmlString() {
+
+  const result = await compileCodeResult(SOURCES.topLevel, cloneOptions());
+  assert.strictEqual(result.err, null);
+  assert.strictEqual(typeof result.html, 'string');
+  assertFullHtmlDocument(result.html);
+}
+
+function cloneOptions() {
+  return JSON.parse(JSON.stringify(OPTIONS));
+}
+
+function compileCode(source, opts) {
+  return compileCodeResult(source, opts).then((result) => {
+    if (result.err) {
+      throw result.err;
+    }
+    assert.strictEqual(result.err, null);
+    return result.html;
+  });
+}
+
+function compileCodeResult(source, opts) {
+  return new Promise((resolve) => {
+    compiler.compileCode(source, opts, (err, html) => {
+      resolve({ err: err || null, html: html == null ? null : html });
+    });
+  });
+}
+
+function compileFile(sourceFilePath, opts) {
+  return new Promise((resolve, reject) => {
+    compiler.compileFile(sourceFilePath, opts, (err, html) => {
+      if (err) {
+        reject(err);
+      } else {
+        assert.strictEqual(err, null);
+        resolve(html);
+      }
+    });
+  });
+}
+
+function assertFullHtmlDocument(html) {
+
+  assert.strictEqual(typeof html, 'string');
+  assert.match(html, /<!doctype html>/i);
+  assert.match(html, /<html\b[\s\S]*<\/html>/i);
+  assert.match(html, /<head\b[\s\S]*<\/head>/i);
+  assert.match(html, /<body\b[\s\S]*<\/body>/i);
+}
+
+function assertInlineScriptGenerated(html, inlineJavaScript, localNames) {
+  const script = extractApplicationScript(html);
+
+  assertJavaScriptContains(script, inlineJavaScript);
+  assertInlineJavaScriptInIife(script, inlineJavaScript);
+  for (const localName of localNames) {
+    assertLocalNameAvailable(script, localName);
+  }
+}
+
+function assertJavaScriptContains(script, fragment) {
+  assert.ok(
+    compactJavaScript(script).indexOf(compactJavaScript(fragment)) !== -1,
+    'generated application script should preserve inline JavaScript: ' + fragment
+  );
+}
+
+function assertInlineJavaScriptInIife(script, fragment) {
+  const compactScript = compactJavaScript(script);
+  const fragmentIndex = compactScript.indexOf(compactJavaScript(fragment));
+  assert.notStrictEqual(fragmentIndex, -1);
+
+  const before = compactScript.slice(0, fragmentIndex);
+  const after = compactScript.slice(fragmentIndex);
+  assert.ok(
+    before.lastIndexOf('(function') !== -1 || before.lastIndexOf('!function') !== -1,
+    'inline JavaScript should be inside an immediately executed function'
+  );
+  assert.ok(
+    /\}\)\(/.test(after),
+    'inline JavaScript function wrapper should be immediately invoked'
+  );
+}
+
+function assertLocalNameAvailable(script, localName) {
+  const name = escapeRegExp(localName);
+  const declaration = new RegExp(
+    '\\b(?:var|let|const)\\b[\\s\\S]*\\b' + name + '\\b\\s*=' +
+      '|\\bfunction\\b[^\\(]*\\([^\\)]*\\b' + name + '\\b'
+  );
+  assert.ok(declaration.test(script), 'generated application script should expose local ' + localName);
+}
+
+function compactJavaScript(value) {
+  return String(value).replace(/\s+/g, '');
+}
+
+function escapeRegExp(value) {
+  return String(value).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+}
+
+function renderedText(html, id) {
+  const document = new FakeDocument();
+  vm.runInNewContext(extractApplicationScript(html), {
+    document: document,
+    console: console,
+    setTimeout: setTimeout,
+    clearTimeout: clearTimeout,
+  }, { timeout: 1000 });
+  const el = document.getElementById(id);
+  assert.notStrictEqual(el, null);
+  return el.textContent;
+}
+
+function extractApplicationScript(html) {
+
+  const bodyMatch = html.match(/<body\b[^>]*>([\s\S]*?)<\/body>/i);
+  assert.notStrictEqual(bodyMatch, null);
+  const scripts = [];
+  const re = /<script\b[^>]*>([\s\S]*?)<\/script>/gi;
+  let match;
+  while ((match = re.exec(bodyMatch[1]))) {
+    scripts.push(match[1]);
+  }
+  assert.ok(scripts.length > 0, 'full HTML document should include a generated application script');
+  return scripts[scripts.length - 1];
+}
+
+class FakeTextNode {
+  constructor(value) {
+    this.nodeType = 3;
+    this.nodeValue = String(value);
+    this.parentNode = null;
+  }
+
+  get textContent() {
+    return this.nodeValue;
+  }
+}
+
+class FakeElement {
+  constructor(tagName, ownerDocument) {
+    this.tagName = tagName;
+    this.ownerDocument = ownerDocument;
+    this.childNodes = [];
+    this.attributes = {};
+    this.style = {};
+    this.className = '';
+    this.parentNode = null;
+  }
+
+  appendChild(node) {
+    node.parentNode = this;
+    this.childNodes.push(node);
+    return node;
+  }
+
+  insertBefore(node, referenceNode) {
+    node.parentNode = this;
+    const index = this.childNodes.indexOf(referenceNode);
+    if (index === -1) {
+      this.childNodes.push(node);
+    } else {
+      this.childNodes.splice(index, 0, node);
+    }
+    return node;
+  }
+
+  setAttribute(key, value) {
+    const stringValue = String(value);
+    this.attributes[key] = stringValue;
+    if (key === 'id') {
+      this.ownerDocument.byId[stringValue] = this;
+    }
+    if (key === 'class' || key === 'className') {
+      this.className = stringValue;
+    }
+  }
+
+  get innerHTML() {
+    return this.textContent;
+  }
+
+  set innerHTML(value) {
+    this.childNodes = value ? [new FakeTextNode(value)] : [];
+  }
+
+  get textContent() {
+    return this.childNodes.map((node) => node.textContent).join('');
+  }
+}
+
+class FakeDocument {
+  constructor() {
+    this.byId = {};
+    this.body = new FakeElement('body', this);
+  }
+
+  createElement(tagName) {
+    return new FakeElement(tagName, this);
+  }
+
+  createTextNode(value) {
+    return new FakeTextNode(value);
+  }
+
+  getElementById(id) {
+    return this.byId[id] || null;
+  }
+}
+
+const tests = [
+  testCompileCodeTopLevelScriptMutatesBoundVariable,
+  testCompileCodeNestedXmlScriptGetsCurrentHookName,
+  testCompileCodeFunctionBodyScriptCanYieldValue,
+  testCompileFileSupportsInlineScriptBlocks,
+  testCompileCodeSuccessCallbackReceivesNullAndHtmlString,
+];
+
+(async function run() {
+  for (const testFn of tests) {
+    await testFn();
+    process.stdout.write('ok ' + testFn.name + '\n');
+  }
+})().catch((err) => {
+  console.error(err && err.stack ? err.stack : err);
+  process.exit(1);
+});
diff --git a/usercase-test-coderl/offline_network_guard.js b/usercase-test-coderl/offline_network_guard.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/offline_network_guard.js
@@ -0,0 +1,146 @@
+
+
+(function installOfflineNetworkGuard() {
+  const localHosts = new Set([
+    '',
+    '0.0.0.0',
+    '127.0.0.1',
+    '::',
+    '::1',
+    'localhost',
+  ]);
+
+  function normalizeHost(host) {
+    if (host == null) {
+      return '';
+    }
+    return String(host).replace(/^\[/, '').replace(/\]$/, '').toLowerCase();
+  }
+
+  function isLocalHost(host) {
+    const normalized = normalizeHost(host);
+    if (localHosts.has(normalized)) {
+      return true;
+    }
+    return /^127\./.test(normalized);
+  }
+
+  function block(api, host) {
+    throw new Error('isolated offline guard blocked ' + api + ' to ' + host);
+  }
+
+  function assertLocal(api, host) {
+    const normalized = normalizeHost(host);
+    if (!isLocalHost(normalized)) {
+      block(api, normalized);
+    }
+  }
+
+  function hostFromOptions(options) {
+    if (!options || typeof options !== 'object') {
+      return '';
+    }
+    return options.hostname || options.host || '';
+  }
+
+  function hostFromUrl(value) {
+    if (typeof value !== 'string') {
+      return hostFromOptions(value);
+    }
+    if (!/^[a-z][a-z0-9+.-]*:\/\//i.test(value)) {
+      return '';
+    }
+    return new URL(value).hostname;
+  }
+
+  function hostFromNetArgs(args) {
+    const first = args[0];
+    if (typeof first === 'object') {
+      return hostFromOptions(first);
+    }
+    if (typeof first === 'string') {
+      return '';
+    }
+    if (typeof args[1] === 'string') {
+      return args[1];
+    }
+    return '';
+  }
+
+  function hostFromHttpArgs(args) {
+    const first = args[0];
+    const second = args[1];
+    if (first instanceof URL) {
+      return first.hostname;
+    }
+    if (typeof first === 'string') {
+      return hostFromUrl(first);
+    }
+    if (typeof second === 'object') {
+      return hostFromOptions(second);
+    }
+    return hostFromOptions(first);
+  }
+
+  const net = require('net');
+  const originalConnect = net.connect;
+  const originalCreateConnection = net.createConnection;
+  const originalSocketConnect = net.Socket.prototype.connect;
+
+  net.connect = function guardedNetConnect() {
+    assertLocal('net.connect', hostFromNetArgs(arguments));
+    return originalConnect.apply(this, arguments);
+  };
+
+  net.createConnection = function guardedNetCreateConnection() {
+    assertLocal('net.createConnection', hostFromNetArgs(arguments));
+    return originalCreateConnection.apply(this, arguments);
+  };
+
+  net.Socket.prototype.connect = function guardedSocketConnect() {
+    assertLocal('net.Socket.connect', hostFromNetArgs(arguments));
+    return originalSocketConnect.apply(this, arguments);
+  };
+
+  function guardHttpModule(moduleName) {
+    const mod = require(moduleName);
+    const originalRequest = mod.request;
+    const originalGet = mod.get;
+
+    mod.request = function guardedRequest() {
+      assertLocal(moduleName + '.request', hostFromHttpArgs(arguments));
+      return originalRequest.apply(this, arguments);
+    };
+
+    mod.get = function guardedGet() {
+      assertLocal(moduleName + '.get', hostFromHttpArgs(arguments));
+      return originalGet.apply(this, arguments);
+    };
+  }
+
+  guardHttpModule('http');
+  guardHttpModule('https');
+
+  const dns = require('dns');
+  for (const name of ['lookup', 'resolve', 'resolve4', 'resolve6', 'resolveAny', 'resolveCname', 'resolveMx', 'resolveNs', 'resolveSrv', 'resolveTxt']) {
+    if (typeof dns[name] !== 'function') {
+      continue;
+    }
+    const original = dns[name];
+    dns[name] = function guardedDns(hostname) {
+      assertLocal('dns.' + name, hostname);
+      return original.apply(this, arguments);
+    };
+  }
+
+  if (typeof globalThis.fetch === 'function') {
+    const originalFetch = globalThis.fetch;
+    globalThis.fetch = function guardedFetch(resource) {
+      const host = resource && typeof resource === 'object' && resource.url
+        ? hostFromUrl(resource.url)
+        : hostFromUrl(resource);
+      assertLocal('fetch', host);
+      return originalFetch.apply(this, arguments);
+    };
+  }
+})();
