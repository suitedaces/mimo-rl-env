+{
+  "test_commands": ["python -m pytest tests/link/test_numba.py -k \"test_numba_scalar_input_returns_ndarray or test_numba_scalar_dtype_preserved_float32 or test_numba_scalar_dtype_preserved_int32 or test_numba_multi_output_scalars_return_ndarrays or test_numba_vector_output_unchanged\" -v"]
+}
diff --git a/tests/link/test_numba.py b/tests/link/test_numba.py
index e01bb200a..c84b28a1d 100644
--- a/tests/link/test_numba.py
+++ b/tests/link/test_numba.py
@@ -3575,3 +3575,56 @@ def test_config_options_cached():
         aesara_numba_fn = function([x], x * 2, mode=numba_mode)
         numba_mul_fn = aesara_numba_fn.vm.jit_fn.py_func.__globals__["mul"]
         assert isinstance(numba_mul_fn._dispatcher.cache, numba.core.caching.NullCache)
+
+
+def test_numba_scalar_input_returns_ndarray():
+    """Issue reproduction: NUMBA mode should return np.ndarray for scalar outputs (matching c mode behavior)."""
+    x = at.scalar(name="x")
+    f = function([x], 2 * x, mode=numba_mode)
+    result = f(10)
+    assert isinstance(result, np.ndarray)
+    assert result.shape == ()
+    np.testing.assert_allclose(result, 20.0)
+
+    assert not isinstance(result, (float, int))
+
+
+def test_numba_scalar_dtype_preserved_float32():
+    """The output dtype should match the TensorType dtype, not a default float64."""
+    x = at.scalar(name="x", dtype="float32")
+    f = function([x], 2 * x, mode=numba_mode)
+    result = f(np.float32(10))
+    assert isinstance(result, np.ndarray)
+    assert result.dtype == np.dtype("float32")
+    np.testing.assert_allclose(result, np.float32(20.0))
+
+
+def test_numba_scalar_dtype_preserved_int32():
+    """The output dtype should match the TensorType dtype for integer types."""
+    x = at.scalar(name="x", dtype="int32")
+    f = function([x], 2 * x, mode=numba_mode)
+    result = f(np.int32(10))
+    assert isinstance(result, np.ndarray)
+    assert result.dtype == np.dtype("int32")
+
+
+def test_numba_multi_output_scalars_return_ndarrays():
+    """Each output of a multi-output function should be an ndarray."""
+    x = at.scalar(name="x")
+    y = at.scalar(name="y")
+    f = function([x, y], [2 * x, 3 * y], mode=numba_mode)
+    r1, r2 = f(10, 5)
+    assert isinstance(r1, np.ndarray)
+    assert isinstance(r2, np.ndarray)
+    np.testing.assert_allclose(r1, 20.0)
+    np.testing.assert_allclose(r2, 15.0)
+
+
+def test_numba_vector_output_unchanged():
+    """Preservation: vector outputs were already np.ndarray and should remain so."""
+    x = at.vector(name="x")
+    f = function([x], 2 * x, mode=numba_mode)
+    result = f(np.array([1.0, 2.0, 3.0]))
+    assert isinstance(result, np.ndarray)
+    assert result.shape == (3,)
+    np.testing.assert_allclose(result, np.array([2.0, 4.0, 6.0]))
