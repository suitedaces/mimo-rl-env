diff --git a/modules/__tests__/chainable-test.js b/modules/__tests__/chainable-test.js
new file mode 100644
index 0000000..7a03fe3
--- /dev/null
+++ b/modules/__tests__/chainable-test.js
@@ -0,0 +1,18 @@
+var expect = require('../expect');
+
+describe('Expectation#Chainable', function () {
+  it('should allow chaining for array-like applications', function () {
+    expect([1, 2, "foo", 3])
+      .toExist()
+      .toBeAn(Array)
+      .toInclude("foo")
+      .toExclude("bar");
+  });
+
+  it('should allow chaining for number checking', function () {
+    expect(3.14)
+      .toExist()
+      .toBeLessThan(4.2)
+      .toBeGreaterThan(3.0);
+  });
+});
diff --git a/modules/__tests__/existence-test.js b/modules/__tests__/existence-test.js
new file mode 100644
index 0000000..997af87
--- /dev/null
+++ b/modules/__tests__/existence-test.js
@@ -0,0 +1,50 @@
+var expect = require('../expect');
+
+describe('Expectation#toExist', function () {
+  it('does not throw on truthy actual values', function () {
+    expect(function () {
+      expect(1).toExist();
+      expect({"hello": "world"}).toExist();
+      expect([1,2,3]).toExist();
+    }).toNotThrow();
+  });
+
+  it('throws on falsy actual values', function () {
+    expect(function () {
+      expect(0).toExist();
+    }).toThrow();
+    
+    expect(function () {
+      expect(null).toExist();
+    }).toThrow();
+
+    expect(function () {
+      expect(undefined).toExist();
+    }).toThrow();
+  });
+
+});
+
+describe('Expectation#toNotExist', function () {
+  it('throws on truthy values', function () {
+    expect(function () {
+      expect(42).toNotExist();
+    }).toThrow();
+    
+    expect(function () {
+      expect({foo: "bar"}).toNotExist();
+    }).toThrow();
+
+    expect(function () {
+      expect([]).toNotExist();
+    }).toThrow();
+  });
+
+  it('does not throw with falsy actual values', function () {
+    expect(function () {
+      expect(0).toNotExist();
+      expect(null).toNotExist();
+      expect(undefined).toNotExist();
+    }).toNotThrow();
+  });
+});
