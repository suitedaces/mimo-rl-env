+func captureHlog(fn func()) *bytes.Buffer {
+	buf := bytes.NewBuffer(nil)
+	hlog.SetOutput(buf)
+	defer hlog.SetOutput(os.Stderr)
+	fn()
+	return buf
+}
+
+
+
+func TestAddRouteDebugPrint_DefaultEnabled(t *testing.T) {
+	opt := config.NewOptions([]config.Option{})
+	e := NewEngine(opt)
+	buf := captureHlog(func() {
+		e.GET("/print-default", func(c context.Context, ctx *app.RequestContext) {
+			ctx.String(200, "ok")
+		})
+	})
+	out := buf.String()
+	assert.True(t, strings.Contains(out, "HERTZ:"))
+	assert.True(t, strings.Contains(out, "/print-default"))
+}
+
+
+
+func TestAddRouteDebugPrint_DisabledSilent(t *testing.T) {
+	opt := config.NewOptions([]config.Option{
+		{F: func(o *config.Options) {
+			o.DisablePrintRoute = true
+		}},
+	})
+	e := NewEngine(opt)
+	buf := captureHlog(func() {
+		e.GET("/print-disabled", func(c context.Context, ctx *app.RequestContext) {
+			ctx.String(200, "ok")
+		})
+	})
+	out := buf.String()
+	assert.False(t, strings.Contains(out, "HERTZ:"))
+	assert.False(t, strings.Contains(out, "/print-disabled"))
+}
+
+
+
+
+func TestAddRouteDebugPrint_ExplicitlyFalsePrints(t *testing.T) {
+	opt := config.NewOptions([]config.Option{
+		{F: func(o *config.Options) {
+			o.DisablePrintRoute = false
+		}},
+	})
+	e := NewEngine(opt)
+	buf := captureHlog(func() {
+		e.GET("/print-explicit-false", func(c context.Context, ctx *app.RequestContext) {
+			ctx.String(200, "ok")
+		})
+	})
+	out := buf.String()
+	assert.True(t, strings.Contains(out, "HERTZ:"))
+	assert.True(t, strings.Contains(out, "/print-explicit-false"))
+}
+
+
+
+func TestAddRouteDebugPrint_DisabledStillRoutes(t *testing.T) {
+	opt := config.NewOptions([]config.Option{
+		{F: func(o *config.Options) {
+			o.DisablePrintRoute = true
+		}},
+	})
+	e := NewEngine(opt)
+	e.GET("/still-works", func(c context.Context, ctx *app.RequestContext) {
+		ctx.String(200, "pong")
+	})
+	w := performRequest(e, http.MethodGet, "/still-works")
+	assert.DeepEqual(t, 200, w.Code)
+	assert.DeepEqual(t, "pong", w.Body.String())
+}
