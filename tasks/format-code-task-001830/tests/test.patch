+func TestSetSnapshotWithoutDownstream(t *testing.T) {
+	testCache := gcpCacheV2.NewSnapshotCache(false, gcpCacheV2.IDHash{}, nil)
+	testRtdsLayerName := "testRtdsLayerName"
+	testUpstreamCluster := "serviceC"
+
+	experiments := []*experimentation.Experiment{
+		createAbortExperiment(testUpstreamCluster, "", 20, 504),
+	}
+
+	err := setSnapshot(testCache, testRtdsLayerName, testUpstreamCluster, experiments, zap.NewNop().Sugar())
+	assert.NoError(t, err)
+
+	snapshot, err := testCache.GetSnapshot(testUpstreamCluster)
+	assert.NoError(t, err)
+
+	resources := snapshot.GetResources(gcpResourceV2.RuntimeType)
+	assert.NotNil(t, resources)
+	resource := resources[testRtdsLayerName]
+	assert.NotNil(t, resource)
+	runtime, ok := resource.(*gcpDiscovery.Runtime)
+	assert.True(t, ok)
+	fields := runtime.GetLayer().GetFields()
+	assert.Equal(t, 2, len(fields))
+	assert.EqualValues(t, 20, fields["fault.http.abort.abort_percent"].GetNumberValue())
+	assert.EqualValues(t, 504, fields["fault.http.abort.http_status"].GetNumberValue())
+}
+
+func TestSetSnapshotEmptyExperiments(t *testing.T) {
+	testCache := gcpCacheV2.NewSnapshotCache(false, gcpCacheV2.IDHash{}, nil)
+	testRtdsLayerName := "testRtdsLayerName"
+	testUpstreamCluster := "serviceA"
+
+	err := setSnapshot(testCache, testRtdsLayerName, testUpstreamCluster, []*experimentation.Experiment{}, zap.NewNop().Sugar())
+	assert.NoError(t, err)
+
+	snapshot, err := testCache.GetSnapshot(testUpstreamCluster)
+	assert.NoError(t, err)
+
+	resources := snapshot.GetResources(gcpResourceV2.RuntimeType)
+	assert.NotNil(t, resources)
+	resource := resources[testRtdsLayerName]
+	assert.NotNil(t, resource)
+	runtime, ok := resource.(*gcpDiscovery.Runtime)
+	assert.True(t, ok)
+	fields := runtime.GetLayer().GetFields()
+	assert.Equal(t, 0, len(fields), "with no experiments the runtime layer should have no fields")
+}
+
+func TestSetSnapshotVersionStable(t *testing.T) {
+	testCache := gcpCacheV2.NewSnapshotCache(false, gcpCacheV2.IDHash{}, nil)
+	testRtdsLayerName := "testRtdsLayerName"
+	testUpstreamCluster := "serviceA"
+
+	experiments := []*experimentation.Experiment{
+		createAbortExperiment(testUpstreamCluster, "serviceB", 10, 404),
+	}
+
+	err := setSnapshot(testCache, testRtdsLayerName, testUpstreamCluster, experiments, zap.NewNop().Sugar())
+	assert.NoError(t, err)
+
+	snapshot1, err := testCache.GetSnapshot(testUpstreamCluster)
+	assert.NoError(t, err)
+	version1 := snapshot1.GetVersion(gcpResourceV2.RuntimeType)
+	assert.NotEmpty(t, version1)
+
+
+	err = setSnapshot(testCache, testRtdsLayerName, testUpstreamCluster, experiments, zap.NewNop().Sugar())
+	assert.NoError(t, err)
+
+	snapshot2, err := testCache.GetSnapshot(testUpstreamCluster)
+	assert.NoError(t, err)
+	version2 := snapshot2.GetVersion(gcpResourceV2.RuntimeType)
+	assert.Equal(t, version1, version2)
+}
