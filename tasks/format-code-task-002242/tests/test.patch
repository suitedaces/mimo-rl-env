diff --git a/src/__tests__/ParseUser-test.js b/src/__tests__/ParseUser-test.js
index e081ecb..92269d0 100644
--- a/src/__tests__/ParseUser-test.js
+++ b/src/__tests__/ParseUser-test.js
@@ -1793,4 +1793,150 @@ describe('ParseUser', () => {
     const user = new CustomUser();
     expect(user.test).toBe(true);
   });
+
+  it('static logIn defaults to POST method', done => {
+    ParseUser.enableUnsafeCurrentUser();
+    ParseUser._clearCache();
+    let observedMethod = null;
+    CoreManager.setRESTController({
+      request(method, path, body) {
+        observedMethod = method;
+        expect(path).toBe('login');
+        expect(body.username).toBe('postdefault_user');
+        expect(body.password).toBe('postdefault_pw');
+        return Promise.resolve(
+          {
+            objectId: 'uid_postdef',
+            username: 'postdefault_user',
+            sessionToken: 'st_postdef',
+          },
+          200
+        );
+      },
+      ajax() {},
+    });
+    ParseUser.logIn('postdefault_user', 'postdefault_pw').then(u => {
+      expect(observedMethod).toBe('POST');
+      expect(u.id).toBe('uid_postdef');
+      expect(u.getSessionToken()).toBe('st_postdef');
+      done();
+    });
+  });
+
+  it('instance logIn defaults to POST method', done => {
+    ParseUser.enableUnsafeCurrentUser();
+    ParseUser._clearCache();
+    let observedMethod = null;
+    CoreManager.setRESTController({
+      request(method, path, body) {
+        observedMethod = method;
+        expect(path).toBe('login');
+        expect(body.username).toBe('inst_user');
+        expect(body.password).toBe('inst_pw');
+        return Promise.resolve(
+          {
+            objectId: 'uid_inst',
+            username: 'inst_user',
+            sessionToken: 'st_inst',
+          },
+          200
+        );
+      },
+      ajax() {},
+    });
+    const u = new ParseUser({
+      username: 'inst_user',
+      password: 'inst_pw',
+    });
+    u.logIn().then(() => {
+      expect(observedMethod).toBe('POST');
+      expect(u.id).toBe('uid_inst');
+      done();
+    });
+  });
+
+  it('logIn with useMasterKey and installationId defaults to POST', async () => {
+    ParseUser.enableUnsafeCurrentUser();
+    ParseUser._clearCache();
+    let observedMethod = null;
+    let observedOptions = null;
+    CoreManager.setRESTController({
+      request(method, path, body, options) {
+        observedMethod = method;
+        observedOptions = options;
+        expect(path).toBe('login');
+        expect(body.username).toBe('opts_user');
+        expect(body.password).toBe('opts_pw');
+        return Promise.resolve(
+          {
+            objectId: 'uid_opts',
+            username: 'opts_user',
+            sessionToken: 'st_opts',
+          },
+          200
+        );
+      },
+      ajax() {},
+    });
+    const user = await ParseUser.logIn('opts_user', 'opts_pw', {
+      useMasterKey: true,
+      installationId: 'installation-9999',
+    });
+    expect(observedMethod).toBe('POST');
+    expect(observedOptions.useMasterKey).toBe(true);
+    expect(observedOptions.installationId).toBe('installation-9999');
+    expect(user.id).toBe('uid_opts');
+  });
+
+  it('explicit usePost false falls back to GET', done => {
+    ParseUser.enableUnsafeCurrentUser();
+    ParseUser._clearCache();
+    let observedMethod = null;
+    CoreManager.setRESTController({
+      request(method, path, body) {
+        observedMethod = method;
+        expect(path).toBe('login');
+        return Promise.resolve(
+          {
+            objectId: 'uid_falsepost',
+            username: 'falsepost_user',
+            sessionToken: 'st_falsepost',
+          },
+          200
+        );
+      },
+      ajax() {},
+    });
+    ParseUser.logIn('falsepost_user', 'falsepost_pw', { usePost: false }).then(u => {
+      expect(observedMethod).toBe('GET');
+      expect(u.id).toBe('uid_falsepost');
+      done();
+    });
+  });
+
+  it('explicit usePost true continues to use POST', done => {
+    ParseUser.enableUnsafeCurrentUser();
+    ParseUser._clearCache();
+    let observedMethod = null;
+    CoreManager.setRESTController({
+      request(method, path, body) {
+        observedMethod = method;
+        expect(path).toBe('login');
+        return Promise.resolve(
+          {
+            objectId: 'uid_truepost',
+            username: 'truepost_user',
+            sessionToken: 'st_truepost',
+          },
+          200
+        );
+      },
+      ajax() {},
+    });
+    ParseUser.logIn('truepost_user', 'truepost_pw', { usePost: true }).then(u => {
+      expect(observedMethod).toBe('POST');
+      expect(u.id).toBe('uid_truepost');
+      done();
+    });
+  });
 });
