diff --git a/geopandas/tests/test_geodataframe.py b/geopandas/tests/test_geodataframe.py
index 9e3112f6..197b9ac5 100644
--- a/geopandas/tests/test_geodataframe.py
+++ b/geopandas/tests/test_geodataframe.py
@@ -1255,3 +1255,72 @@ def test_geodataframe_crs():
     gdf = GeoDataFrame(columns=["geometry"])
     gdf.crs = "IGNF:ETRS89UTM28"
     assert gdf.crs.to_authority() == ("IGNF", "ETRS89UTM28")
+
+
+
+
+
+
+
+def test_constructor_does_not_modify_source_df_geometry_array():
+
+    df = pd.DataFrame(
+        {
+            "Name": ["Adam", "Barbara", "Cat", "Doug", "Ezra", "Fiona", "Greg"],
+            "lat": [35.5, 35.2, 34.89, 36.1, 35.78, 35.76, 34.99],
+            "lon": [-112.02, -111.09, -115.3, -114.01, -113.02, -112.9, -112.02],
+        }
+    )
+    original_cols = df.columns.tolist()
+    original_df = df.copy()
+    gdf = GeoDataFrame(
+        df, geometry=[Point(x, y) for x, y in zip(df.lon, df.lat)]
+    )
+
+    assert df.columns.tolist() == original_cols
+    assert "geometry" not in df.columns
+
+    assert "geometry" in gdf.columns
+
+    assert_frame_equal(df, original_df)
+
+
+def test_constructor_does_not_modify_source_df_with_geometry_column_name():
+
+
+
+
+    df = pd.DataFrame(
+        {"a": [1, 2], "mygeom": [Point(0, 0), Point(1, 1)]}
+    )
+    gdf = GeoDataFrame(df, geometry="mygeom")
+
+    assert str(df.dtypes["mygeom"]) == "object"
+
+    assert str(gdf.dtypes["mygeom"]) == "geometry"
+
+
+def test_constructor_does_not_modify_source_df_with_existing_geometry_col():
+
+
+
+    df = pd.DataFrame(
+        {"a": [1, 2], "geometry": [Point(0, 0), Point(1, 1)]}
+    )
+    gdf = GeoDataFrame(df)
+
+    assert str(df.dtypes["geometry"]) == "object"
+
+    assert str(gdf.dtypes["geometry"]) == "geometry"
+
+
+def test_constructor_modifying_gdf_does_not_modify_source_df():
+
+    df = pd.DataFrame({"a": [1, 2, 3], "b": [4, 5, 6]})
+    original_df = df.copy()
+    gdf = GeoDataFrame(df, geometry=[Point(0, 0), Point(1, 1), Point(2, 2)])
+
+    gdf.loc[0, "a"] = 999
+
+    assert df.loc[0, "a"] == 1
+    assert_frame_equal(df, original_df)
