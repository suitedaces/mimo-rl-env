diff --git a/ibm/resource_ibm_dns_domain_registration_nameservers_contract_test.go b/ibm/resource_ibm_dns_domain_registration_nameservers_contract_test.go
new file mode 100644
index 000000000..34c8321f0
--- /dev/null
+++ b/ibm/resource_ibm_dns_domain_registration_nameservers_contract_test.go
@@ -0,0 +1,165 @@
+package ibm
+
+import (
+	"strings"
+	"testing"
+
+	tfconfig "github.com/hashicorp/terraform/config"
+	"github.com/hashicorp/terraform/helper/schema"
+	"github.com/hashicorp/terraform/terraform"
+)
+
+
+
+func collectionElemType(t *testing.T, s *schema.Schema, field string) schema.ValueType {
+	t.Helper()
+	if s.Type != schema.TypeList && s.Type != schema.TypeSet {
+		t.Fatalf("expected %q to be a list or set, got %v", field, s.Type)
+	}
+	elem, ok := s.Elem.(*schema.Schema)
+	if !ok {
+		t.Fatalf("expected %q to have a scalar element schema", field)
+	}
+	return elem.Type
+}
+
+func validateResourceConfig(t *testing.T, resourceType string, raw map[string]interface{}) []error {
+	t.Helper()
+	p := Provider().(*schema.Provider)
+	if _, ok := p.ResourcesMap[resourceType]; !ok {
+		t.Fatalf("resource %s is not registered", resourceType)
+	}
+	c, err := tfconfig.NewRawConfig(raw)
+	if err != nil {
+		t.Fatalf("err building raw config: %s", err)
+	}
+	_, errs := p.ValidateResource(resourceType, terraform.NewResourceConfig(c))
+	return errs
+}
+
+func TestDNSDomainRegistrationDataSourceRegistered(t *testing.T) {
+	p := Provider().(*schema.Provider)
+	ds, ok := p.DataSourcesMap["ibm_dns_domain_registration"]
+	if !ok {
+		t.Fatal("expected data source ibm_dns_domain_registration to be registered")
+	}
+
+	name, ok := ds.Schema["name"]
+	if !ok {
+		t.Fatal("data source missing 'name' argument")
+	}
+	if !name.Required {
+		t.Error("data source 'name' must be required")
+	}
+	if name.Type != schema.TypeString {
+		t.Errorf("data source 'name' must be a string, got %v", name.Type)
+	}
+
+	ns, ok := ds.Schema["name_servers"]
+	if !ok {
+		t.Fatal("data source missing 'name_servers' attribute")
+	}
+	if !ns.Computed {
+		t.Error("data source 'name_servers' must be computed")
+	}
+	if et := collectionElemType(t, ns, "name_servers"); et != schema.TypeString {
+		t.Errorf("data source 'name_servers' elements must be strings, got %v", et)
+	}
+}
+
+func TestDNSDomainRegistrationNameserversResourceRegistered(t *testing.T) {
+	p := Provider().(*schema.Provider)
+	r, ok := p.ResourcesMap["ibm_dns_domain_registration_nameservers"]
+	if !ok {
+		t.Fatal("expected resource ibm_dns_domain_registration_nameservers to be registered")
+	}
+
+	id, ok := r.Schema["dns_registration_id"]
+	if !ok {
+		t.Fatal("resource missing 'dns_registration_id' argument")
+	}
+	if !id.Required {
+		t.Error("resource 'dns_registration_id' must be required")
+	}
+	if id.Type != schema.TypeString {
+		t.Errorf("resource 'dns_registration_id' must be a string, got %v", id.Type)
+	}
+
+	ns, ok := r.Schema["name_servers"]
+	if !ok {
+		t.Fatal("resource missing 'name_servers' argument")
+	}
+	if !ns.Required {
+		t.Error("resource 'name_servers' must be required")
+	}
+	if et := collectionElemType(t, ns, "name_servers"); et != schema.TypeString {
+		t.Errorf("resource 'name_servers' elements must be strings, got %v", et)
+	}
+
+	orig, ok := r.Schema["original_name_servers"]
+	if !ok {
+		t.Fatal("resource missing 'original_name_servers' attribute")
+	}
+	if !orig.Computed {
+		t.Error("resource 'original_name_servers' must be computed")
+	}
+	if et := collectionElemType(t, orig, "original_name_servers"); et != schema.TypeString {
+		t.Errorf("resource 'original_name_servers' elements must be strings, got %v", et)
+	}
+}
+
+func TestProviderInternalValidateWithDNSRegistration(t *testing.T) {
+	if err := Provider().(*schema.Provider).InternalValidate(); err != nil {
+		t.Fatalf("provider internal validation failed: %s", err)
+	}
+}
+
+func TestDNSDomainRegistrationNameserversValidation(t *testing.T) {
+	valid := []string{
+		"ns1.example.com",
+		"a.bb.ccc",
+		"ns-01.example.co.uk",
+		"NS1.Example.COM",
+	}
+	for _, v := range valid {
+		raw := map[string]interface{}{
+			"dns_registration_id": "123456",
+			"name_servers":        []interface{}{v},
+		}
+		errs := validateResourceConfig(t, "ibm_dns_domain_registration_nameservers", raw)
+		if len(errs) != 0 {
+			t.Errorf("expected %q to be a valid nameserver, got errors: %v", v, errs)
+		}
+	}
+
+	invalid := []string{
+		"",
+		"localhost",
+		"-bad.example.com",
+		"bad-.example.com",
+		"ns1 .example.com",
+		"ns_1.example.com",
+		strings.Repeat("a", 64) + ".com",
+	}
+	for _, v := range invalid {
+		raw := map[string]interface{}{
+			"dns_registration_id": "123456",
+			"name_servers":        []interface{}{v},
+		}
+		errs := validateResourceConfig(t, "ibm_dns_domain_registration_nameservers", raw)
+		if len(errs) == 0 {
+			t.Errorf("expected %q to be rejected as an invalid nameserver", v)
+		}
+	}
+}
+
+func TestDNSDomainRegistrationNameserversValidationMixed(t *testing.T) {
+	raw := map[string]interface{}{
+		"dns_registration_id": "123456",
+		"name_servers":        []interface{}{"ns1.example.com", "bad_host"},
+	}
+	errs := validateResourceConfig(t, "ibm_dns_domain_registration_nameservers", raw)
+	if len(errs) == 0 {
+		t.Error("expected validation errors when one of several nameservers is invalid")
+	}
+}
