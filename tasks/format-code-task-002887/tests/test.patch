+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+python -m pip install -q --disable-pip-version-check setuptools wheel pytest pytest-asyncio reactivex ptyprocess
+
+case "${1:-}" in
+  base)
+    python -m pytest tests/test_ruuvitag_sensor_async.py -v
+    ;;
+  new)
+    python -m pytest tests/test_ruuvitag_async_tag.py -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
