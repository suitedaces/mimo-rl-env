@@ -0,0 +1,109 @@
+from pathlib import Path
+
+import pytest
+
+import ruuvitag_sensor.ruuvi as ruuvi_module
+from ruuvitag_sensor.ruuvitag import RuuviTagAsync
+
+
+RAW_AJWYAMFC = "1E0201060303AAFE1616AAFE10EE037275752E76692F23416A7759414D4663CD"
+RAW_AJGBAMFC = "1E0201060303AAFE1616AAFE10EE037275752E76692F23416A6762414D4663CD"
+RAW_AJUX1MAW0 = "1F0201060303AAFE1716AAFE10F9037275752E76692F23416A5558314D417730C3"
+
+
+class _AsyncBleSequence:
+    def __init__(self, mac, responses):
+        self._mac = mac
+        self._responses = iter(responses)
+        self.seen_calls = []
+
+    async def get_first_data(self, mac, bt_device=""):
+        self.seen_calls.append((mac, bt_device))
+        return next(self._responses)
+
+    async def get_data(self, blacklist=None, bt_device=""):
+        raw = next(self._responses)
+        if raw is not None:
+            yield (self._mac, raw)
+
+
+def _patch_async_ble_reader(monkeypatch, mac, responses):
+    fake_ble = _AsyncBleSequence(mac, responses)
+    monkeypatch.setattr(ruuvi_module, "ble", fake_ble)
+    return fake_ble
+
+
+def test_ruuvitag_async_initial_state_and_mac():
+    tag = RuuviTagAsync("AA:BB:CC:DD:EE:01")
+
+    assert tag.mac == "AA:BB:CC:DD:EE:01"
+    assert tag.state == {}
+
+
+@pytest.mark.asyncio
+async def test_ruuvitag_async_update_decodes_and_caches_state(monkeypatch):
+    mac = "AA:BB:CC:DD:EE:02"
+    _patch_async_ble_reader(monkeypatch, mac, [RAW_AJWYAMFC, RAW_AJGBAMFC])
+    tag = RuuviTagAsync(mac)
+
+    first = await tag.update()
+    assert first["temperature"] == 24
+    assert first["humidity"] == 30
+    assert first["pressure"] == 995
+    assert tag.state == first
+
+    second = await tag.update()
+    assert second["temperature"] == 27
+    assert second["humidity"] == 28
+    assert second["pressure"] == 995
+    assert tag.state == second
+    assert second != first
+
+
+@pytest.mark.asyncio
+async def test_ruuvitag_async_update_returns_empty_state_when_no_data(monkeypatch):
+    mac = "AA:BB:CC:DD:EE:03"
+    _patch_async_ble_reader(monkeypatch, mac, [RAW_AJUX1MAW0, None])
+    tag = RuuviTagAsync(mac)
+
+    non_empty = await tag.update()
+    assert non_empty["temperature"] == 25.12
+    assert non_empty["humidity"] == 26.5
+    assert non_empty["pressure"] == 992.0
+    assert tag.state == non_empty
+
+    result = await tag.update()
+    assert result == {}
+    assert tag.state == {}
+
+
+@pytest.mark.asyncio
+async def test_ruuvitag_async_update_reuses_cached_state_for_repeated_data(monkeypatch):
+    mac = "AA:BB:CC:DD:EE:04"
+    _patch_async_ble_reader(monkeypatch, mac, [RAW_AJWYAMFC, RAW_AJWYAMFC])
+    tag = RuuviTagAsync(mac)
+
+    first = await tag.update()
+    assert first["temperature"] == 24
+    assert first["humidity"] == 30
+    assert first["pressure"] == 995
+    tag.state["sentinel"] = "kept"
+    cached_before = dict(tag.state)
+
+    second = await tag.update()
+    assert second == cached_before
+    assert tag.state == cached_before
+    assert second["sentinel"] == "kept"
+
+
+def test_readme_single_sensor_note_mentions_async_single_tag_class():
+    readme = Path("README.md").read_text(encoding="utf-8")
+    marker = "#### Get data from a sensor"
+    start = readme.find(marker)
+    assert start != -1
+    next_heading = readme.find("\n#### ", start + len(marker))
+    section = readme[start:] if next_heading == -1 else readme[start:next_heading]
+
+    assert "RuuviTagAsync" in section
+    assert "RuuviTag" in section
+    assert ("RuuviTagSensor.get_data" in section or "RuuviTagSensor.get_data_for_sensors" in section)
