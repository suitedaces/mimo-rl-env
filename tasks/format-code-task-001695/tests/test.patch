+class TestPickleMappingIsoparametricQuad(unittest.TestCase):
+    """Regression: MappingIsoparametric for Quad mesh must be pickleable
+    (broken by use of functools.lru_cache / closures)."""
+
+    def runTest(self):
+        m = MeshQuad().refined(2)
+        mp = MappingIsoparametric(m, ElementQuad1(), ElementQuad1())
+        data = pickle.dumps(mp)
+        mp2 = pickle.loads(data)
+        self.assertIsInstance(mp2, MappingIsoparametric)
+
+
+class TestPickleMappingIsoparametricHex(unittest.TestCase):
+    """Regression: MappingIsoparametric for Hex mesh must be pickleable."""
+
+    def runTest(self):
+        m = MeshHex().refined(1)
+        mp = MappingIsoparametric(m, ElementHex1())
+        data = pickle.dumps(mp)
+        mp2 = pickle.loads(data)
+        self.assertIsInstance(mp2, MappingIsoparametric)
+
+
+class TestPickleMappingPreservesDetDF(unittest.TestCase):
+    """After pickle/unpickle, detDF should return identical values."""
+
+    def runTest(self):
+        m = MeshQuad().refined(2)
+        mp = MappingIsoparametric(m, ElementQuad1(), ElementQuad1())
+        X = np.array([[0.3, 0.7], [0.2, 0.8]])
+        d_before = mp.detDF(X)
+        mp2 = pickle.loads(pickle.dumps(mp))
+        d_after = mp2.detDF(X)
+        self.assertTrue(np.allclose(d_before, d_after))
+
+        self.assertEqual(d_after.shape, (m.t.shape[1], X.shape[1]))
+
+
+class TestPickleMappingPreservesInvDF(unittest.TestCase):
+    """After pickle/unpickle, invDF should return identical values."""
+
+    def runTest(self):
+        m = MeshQuad().refined(2)
+        mp = MappingIsoparametric(m, ElementQuad1(), ElementQuad1())
+        X = np.array([[0.3, 0.7], [0.2, 0.8]])
+        inv_before = mp.invDF(X)
+        mp2 = pickle.loads(pickle.dumps(mp))
+        inv_after = mp2.invDF(X)
+        self.assertTrue(np.allclose(inv_before, inv_after))
+
+
+class TestPickleCellBasisQuad(unittest.TestCase):
+    """Regression: CellBasis (which holds a MappingIsoparametric) must
+    be pickleable."""
+
+    def runTest(self):
+        m = MeshQuad().refined(2)
+        b = CellBasis(m, ElementQuad1())
+        data = pickle.dumps(b)
+        b2 = pickle.loads(data)
+
+        self.assertEqual(b2.dofs.element_dofs.shape,
+                         b.dofs.element_dofs.shape)
+
+
+class TestPickleFacetBasisQuad(unittest.TestCase):
+    """Regression: FacetBasis on a quad mesh must be pickleable."""
+
+    def runTest(self):
+        m = MeshQuad().refined(2)
+        fb = FacetBasis(m, ElementQuad1())
+        data = pickle.dumps(fb)
+        fb2 = pickle.loads(data)
+        self.assertEqual(fb2.dofs.element_dofs.shape,
+                         fb.dofs.element_dofs.shape)
+
+
 if __name__ == '__main__':
     unittest.main()
