+func TestTwoMultiPoolInstancesKeepIndependentState(t *testing.T) {
+
+
+	block := make(chan struct{})
+	a, err := ants.NewMultiPool(2, 2, ants.RoundRobin)
+	if err != nil {
+		t.Fatalf("NewMultiPool a: %v", err)
+	}
+	b, err := ants.NewMultiPool(2, 2, ants.RoundRobin)
+	if err != nil {
+		t.Fatalf("NewMultiPool b: %v", err)
+	}
+
+	for i := 0; i < 3; i++ {
+		if err := a.Submit(func() { <-block }); err != nil {
+			t.Fatalf("a.Submit(%d): %v", i, err)
+		}
+	}
+	waitUntil(t, "instance a workers", func() bool { return a.Running() == 3 })
+
+	requireEqual(t, "a Running", a.Running(), 3)
+	requireEqual(t, "a Free", a.Free(), 1)
+	requireEqual(t, "a Waiting", a.Waiting(), 0)
+	requireEqual(t, "a Cap", a.Cap(), 4)
+	requireEqual(t, "b Running", b.Running(), 0)
+	requireEqual(t, "b Free", b.Free(), 4)
+	requireEqual(t, "b Waiting", b.Waiting(), 0)
+	requireEqual(t, "b Cap", b.Cap(), 4)
+
+	close(block)
+	requireEqual(t, "a ReleaseTimeout", a.ReleaseTimeout(2*time.Second), nil)
+	requireEqual(t, "b ReleaseTimeout", b.ReleaseTimeout(2*time.Second), nil)
+}
