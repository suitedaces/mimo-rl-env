+func TestReleaseContextCanceledReportsPoolIndex(t *testing.T) {
+
+
+	block := make(chan struct{})
+	mp, err := ants.NewMultiPool(1, 1, ants.RoundRobin)
+	if err != nil {
+		t.Fatalf("NewMultiPool: %v", err)
+	}
+	defer close(block)
+
+	err = mp.Submit(func() { <-block })
+	requireEqual(t, "submit error", err, nil)
+	waitUntil(t, "one worker", func() bool { return mp.Running() == 1 })
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	err = mp.ReleaseContext(ctx)
+	if err == nil {
+		t.Fatalf("ReleaseContext canceled: got nil, want error including pool index")
+	}
+
+	if !strings.Contains(err.Error(), "0") {
+		t.Fatalf("ReleaseContext canceled message: got %q, want it to include pool index 0", err.Error())
+	}
+	requireEqual(t, "canceled release IsClosed", mp.IsClosed(), true)
+}
