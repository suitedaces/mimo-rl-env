+func TestMultiPoolConstructorValidationUsesPublicErrors(t *testing.T) {
+
+
+	_, err := ants.NewMultiPool(0, 2, ants.RoundRobin)
+	requireErrorIs(t, "raw size 0", err, ants.ErrInvalidMultiPoolSize)
+	_, err = ants.NewMultiPool(2, 2, ants.LoadBalancingStrategy(99))
+	requireErrorIs(t, "raw invalid strategy", err, ants.ErrInvalidLoadBalancingStrategy)
+	_, err = ants.NewMultiPool(2, 2, ants.RoundRobin, ants.WithExpiryDuration(-1))
+	requireErrorIs(t, "raw invalid expiry", err, ants.ErrInvalidPoolExpiry)
+
+	_, err = ants.NewMultiPoolWithFunc(0, 2, func(any) {}, ants.RoundRobin)
+	requireErrorIs(t, "with func size 0", err, ants.ErrInvalidMultiPoolSize)
+	_, err = ants.NewMultiPoolWithFunc(2, 2, func(any) {}, ants.LoadBalancingStrategy(99))
+	requireErrorIs(t, "with func invalid strategy", err, ants.ErrInvalidLoadBalancingStrategy)
+	_, err = ants.NewMultiPoolWithFunc(2, 2, func(any) {}, ants.RoundRobin, ants.WithExpiryDuration(-1))
+	requireErrorIs(t, "with func invalid expiry", err, ants.ErrInvalidPoolExpiry)
+
+	_, err = ants.NewMultiPoolWithFuncGeneric[int](0, 2, func(int) {}, ants.RoundRobin)
+	requireErrorIs(t, "generic size 0", err, ants.ErrInvalidMultiPoolSize)
+	_, err = ants.NewMultiPoolWithFuncGeneric[int](2, 2, func(int) {}, ants.LoadBalancingStrategy(99))
+	requireErrorIs(t, "generic invalid strategy", err, ants.ErrInvalidLoadBalancingStrategy)
+	_, err = ants.NewMultiPoolWithFuncGeneric[int](2, 2, func(int) {}, ants.RoundRobin, ants.WithExpiryDuration(-1))
+	requireErrorIs(t, "generic invalid expiry", err, ants.ErrInvalidPoolExpiry)
+}
