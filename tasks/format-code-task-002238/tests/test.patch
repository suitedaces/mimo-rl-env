+func TestRebootReopensReleasedMultiPoolAndTuneResizesEachPool(t *testing.T) {
+
+
+	mp, err := ants.NewMultiPool(2, 2, ants.RoundRobin)
+	if err != nil {
+		t.Fatalf("NewMultiPool: %v", err)
+	}
+	requireEqual(t, "fresh Cap", mp.Cap(), 4)
+	requireEqual(t, "fresh Free", mp.Free(), 4)
+	requireEqual(t, "fresh IsClosed", mp.IsClosed(), false)
+
+	mp.Tune(3)
+	requireEqual(t, "tuned Cap", mp.Cap(), 6)
+	requireEqual(t, "tuned Free", mp.Free(), 6)
+
+	requireEqual(t, "ReleaseTimeout", mp.ReleaseTimeout(2*time.Second), nil)
+	requireEqual(t, "after release IsClosed", mp.IsClosed(), true)
+	mp.Reboot()
+	requireEqual(t, "after reboot IsClosed", mp.IsClosed(), false)
+	requireEqual(t, "after reboot Cap", mp.Cap(), 6)
+	requireEqual(t, "after reboot Free", mp.Free(), 6)
+
+	done := make(chan struct{})
+	err = mp.Submit(func() { close(done) })
+	requireEqual(t, "submit after reboot", err, nil)
+	<-done
+	requireEqual(t, "final ReleaseTimeout", mp.ReleaseTimeout(2*time.Second), nil)
+}
