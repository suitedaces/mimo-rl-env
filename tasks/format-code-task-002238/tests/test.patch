+func TestRoundRobinFallsBackToLeastBusyPoolWhenSelectedPoolIsOverloaded(t *testing.T) {
+
+
+
+	rotateFirstBlock := make(chan struct{})
+	rotateSecondBlock := make(chan struct{})
+	rotateThirdBlock := make(chan struct{})
+	rotateMP, err := ants.NewMultiPool(2, 2, ants.RoundRobin)
+	if err != nil {
+		t.Fatalf("NewMultiPool rotation check: %v", err)
+	}
+	err = rotateMP.Submit(func() { <-rotateFirstBlock })
+	requireEqual(t, "rotation first submit error", err, nil)
+	waitUntil(t, "rotation one pool running", func() bool { return rotateMP.Running() == 1 })
+	rotationFirstCounts := []int{runningByIndex(t, rotateMP, 0), runningByIndex(t, rotateMP, 1)}
+	rotationFirstIdx, rotationSecondIdx := -1, -1
+	for idx, running := range rotationFirstCounts {
+		if running == 1 {
+			rotationFirstIdx = idx
+		} else if running == 0 {
+			rotationSecondIdx = idx
+		}
+	}
+	if rotationFirstIdx < 0 || rotationSecondIdx < 0 {
+		t.Fatalf("rotation first submit: got per-pool running %v, want one busy and one free", rotationFirstCounts)
+	}
+	err = rotateMP.Submit(func() { <-rotateSecondBlock })
+	requireEqual(t, "rotation second submit error", err, nil)
+	waitUntil(t, "rotation second pool running", func() bool { return runningByIndex(t, rotateMP, rotationSecondIdx) == 1 })
+	close(rotateSecondBlock)
+	waitUntil(t, "rotation second pool drained", func() bool { return runningByIndex(t, rotateMP, rotationSecondIdx) == 0 })
+	err = rotateMP.Submit(func() { <-rotateThirdBlock })
+	requireEqual(t, "rotation third submit error", err, nil)
+	waitUntil(t, "rotation first pool reused", func() bool { return runningByIndex(t, rotateMP, rotationFirstIdx) == 2 })
+	requireEqual(t, "rotation first pool running", runningByIndex(t, rotateMP, rotationFirstIdx), 2)
+	requireEqual(t, "rotation second pool running", runningByIndex(t, rotateMP, rotationSecondIdx), 0)
+	close(rotateFirstBlock)
+	close(rotateThirdBlock)
+	requireEqual(t, "rotation ReleaseTimeout", rotateMP.ReleaseTimeout(2*time.Second), nil)
+
+	firstBlock := make(chan struct{})
+	fallbackBlock := make(chan struct{})
+	mp, err := ants.NewMultiPool(2, 1, ants.RoundRobin, ants.WithNonblocking(true), ants.WithExpiryDuration(20*time.Millisecond))
+	if err != nil {
+		t.Fatalf("NewMultiPool: %v", err)
+	}
+
+	err = mp.Submit(func() { <-firstBlock })
+	requireEqual(t, "first submit error", err, nil)
+	waitUntil(t, "one pool running", func() bool { return mp.Running() == 1 })
+	firstPoolRunning := []int{runningByIndex(t, mp, 0), runningByIndex(t, mp, 1)}
+
+	busyIdx, freeIdx := -1, -1
+	for idx, running := range firstPoolRunning {
+		if running == 1 {
+			busyIdx = idx
+		} else if running == 0 {
+			freeIdx = idx
+		}
+	}
+	if busyIdx < 0 || freeIdx < 0 {
+		t.Fatalf("after first submit: got per-pool running %v, want one busy and one free", firstPoolRunning)
+	}
+
+	quickDone := make(chan struct{})
+	err = mp.Submit(func() { close(quickDone) })
+	requireEqual(t, "second submit error", err, nil)
+	<-quickDone
+	waitUntil(t, "non-busy pool purged", func() bool { return runningByIndex(t, mp, freeIdx) == 0 })
+	requireEqual(t, "before fallback busy pool running", runningByIndex(t, mp, busyIdx), 1)
+	requireEqual(t, "before fallback free pool running", runningByIndex(t, mp, freeIdx), 0)
+
+	err = mp.Submit(func() { <-fallbackBlock })
+	requireEqual(t, "fallback submit error", err, nil)
+	waitUntil(t, "fallback pool running", func() bool { return mp.Running() == 2 })
+	requireEqual(t, "after fallback total Running", mp.Running(), 2)
+	requireEqual(t, "after fallback busy pool running", runningByIndex(t, mp, busyIdx), 1)
+	requireEqual(t, "after fallback free pool running", runningByIndex(t, mp, freeIdx), 1)
+
+	close(firstBlock)
+	close(fallbackBlock)
+	requireEqual(t, "ReleaseTimeout", mp.ReleaseTimeout(2*time.Second), nil)
+}
