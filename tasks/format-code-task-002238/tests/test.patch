+func TestLeastTasksBalancesTowardFewestRunningWorkers(t *testing.T) {
+
+
+	block := make(chan struct{})
+	mp, err := ants.NewMultiPool(3, 2, ants.LeastTasks)
+	if err != nil {
+		t.Fatalf("NewMultiPool: %v", err)
+	}
+
+	for i := 0; i < 5; i++ {
+		if err := mp.Submit(func() { <-block }); err != nil {
+			t.Fatalf("Submit(%d): %v", i, err)
+		}
+		waitUntil(t, "least-tasks running count", func() bool { return mp.Running() == i+1 })
+	}
+
+	requireEqual(t, "least total Running", mp.Running(), 5)
+	requireEqual(t, "least total Free", mp.Free(), 1)
+	requireEqual(t, "least total Waiting", mp.Waiting(), 0)
+	requireEqual(t, "least total Cap", mp.Cap(), 6)
+
+	perPoolRunning := []int{runningByIndex(t, mp, 0), runningByIndex(t, mp, 1), runningByIndex(t, mp, 2)}
+	sort.Ints(perPoolRunning)
+	requireEqual(t, "least per-pool running distribution", perPoolRunning, []int{1, 2, 2})
+
+	close(block)
+	requireEqual(t, "ReleaseTimeout", mp.ReleaseTimeout(2*time.Second), nil)
+}
