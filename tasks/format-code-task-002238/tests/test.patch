+func waitUntil(t *testing.T, label string, condition func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		if condition() {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("timed out waiting for %s", label)
+}
+
+func requireEqual(t *testing.T, label string, got, want any) {
+	t.Helper()
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("%s: got %v, want %v", label, got, want)
+	}
+}
+
+func requireErrorIs(t *testing.T, label string, got error, want error) {
+	t.Helper()
+	if !errors.Is(got, want) {
+		t.Fatalf("%s: got %v, want %v", label, got, want)
+	}
+}
+
+func runningByIndex(t *testing.T, mp interface {
+	RunningByIndex(int) (int, error)
+}, idx int) int {
+	t.Helper()
+	n, err := mp.RunningByIndex(idx)
+	if err != nil {
+		t.Fatalf("RunningByIndex(%d): %v", idx, err)
+	}
+	return n
+}
+
+func freeByIndex(t *testing.T, mp interface {
+	FreeByIndex(int) (int, error)
+}, idx int) int {
