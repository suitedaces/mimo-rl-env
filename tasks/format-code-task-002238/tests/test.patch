+func TestMultiPoolReleaseDoesNotLeakGoroutinesAcrossCycles(t *testing.T) {
+
+
+	runtime.GC()
+	time.Sleep(100 * time.Millisecond)
+	startGoroutines := runtime.NumGoroutine()
+	startFDs := countOpenFDs(t)
+
+	for i := 0; i < 100; i++ {
+		done := make(chan struct{})
+		mp, err := ants.NewMultiPool(3, 1, ants.RoundRobin)
+		if err != nil {
+			t.Fatalf("NewMultiPool(%d): %v", i, err)
+		}
+		if err := mp.Submit(func() { close(done) }); err != nil {
+			t.Fatalf("Submit(%d): %v", i, err)
+		}
+		<-done
+		if err := mp.ReleaseTimeout(2 * time.Second); err != nil {
+			t.Fatalf("ReleaseTimeout(%d): %v", i, err)
+		}
+	}
+
+	runtime.GC()
+	time.Sleep(300 * time.Millisecond)
+	endGoroutines := runtime.NumGoroutine()
+	endFDs := countOpenFDs(t)
+	if endGoroutines > startGoroutines+30 {
+		t.Fatalf("goroutine leak floor: got %d, want at most %d", endGoroutines, startGoroutines+30)
+	}
+	if endFDs > startFDs+5 {
+		t.Fatalf("fd leak floor: got %d, want at most %d", endFDs, startFDs+5)
+	}
+}
