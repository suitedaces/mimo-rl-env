+func TestRawMultiPoolRoundRobinMetricsPerPoolAndCloseLifecycle(t *testing.T) {
+
+
+	block := make(chan struct{})
+	mp, err := ants.NewMultiPool(10, 5, ants.RoundRobin)
+	if err != nil {
+		t.Fatalf("NewMultiPool: %v", err)
+	}
+
+	requireEqual(t, "fresh Running", mp.Running(), 0)
+	requireEqual(t, "fresh Free", mp.Free(), 50)
+	requireEqual(t, "fresh Waiting", mp.Waiting(), 0)
+	requireEqual(t, "fresh Cap", mp.Cap(), 50)
+	requireEqual(t, "fresh IsClosed", mp.IsClosed(), false)
+
+	for i := 0; i < 50; i++ {
+		if err := mp.Submit(func() { <-block }); err != nil {
+			t.Fatalf("Submit(%d): %v", i, err)
+		}
+	}
+	waitUntil(t, "50 raw workers", func() bool { return mp.Running() == 50 })
+
+	requireEqual(t, "full Running", mp.Running(), 50)
+	requireEqual(t, "full Free", mp.Free(), 0)
+	requireEqual(t, "full Waiting", mp.Waiting(), 0)
+	requireEqual(t, "full Cap", mp.Cap(), 50)
+	requireEqual(t, "full IsClosed", mp.IsClosed(), false)
+	for idx := 0; idx < 10; idx++ {
+		requireEqual(t, "per-pool Running", runningByIndex(t, mp, idx), 5)
+		requireEqual(t, "per-pool Free", freeByIndex(t, mp, idx), 0)
+		requireEqual(t, "per-pool Waiting", waitingByIndex(t, mp, idx), 0)
+	}
+
+	_, err = mp.RunningByIndex(-1)
+	requireErrorIs(t, "RunningByIndex -1", err, ants.ErrInvalidPoolIndex)
+	_, err = mp.FreeByIndex(10)
+	requireErrorIs(t, "FreeByIndex 10", err, ants.ErrInvalidPoolIndex)
+	_, err = mp.WaitingByIndex(10)
+	requireErrorIs(t, "WaitingByIndex 10", err, ants.ErrInvalidPoolIndex)
+
+	close(block)
+	err = mp.ReleaseTimeout(2 * time.Second)
+	requireEqual(t, "first ReleaseTimeout error", err, nil)
+	requireEqual(t, "released Running", mp.Running(), 0)
+	requireEqual(t, "released Waiting", mp.Waiting(), 0)
+
+	releasedFree, releasedCap := mp.Free(), mp.Cap()
+	if releasedFree < 0 || releasedCap < 0 || releasedFree > releasedCap {
+		t.Fatalf("released metrics out of range: Free=%d Cap=%d", releasedFree, releasedCap)
+	}
+	requireEqual(t, "released IsClosed", mp.IsClosed(), true)
+
+	err = mp.ReleaseTimeout(2 * time.Second)
+	requireErrorIs(t, "second ReleaseTimeout", err, ants.ErrPoolClosed)
+	err = mp.Submit(func() {})
+	requireErrorIs(t, "Submit after close", err, ants.ErrPoolClosed)
+}
