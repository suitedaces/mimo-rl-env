diff --git a/common/validation_test.go b/common/validation_test.go
new file mode 100644
index 0000000..cd06837
--- /dev/null
+++ b/common/validation_test.go
@@ -0,0 +1,186 @@
+package common
+
+import (
+	"strings"
+	"testing"
+)
+
+
+
+
+func validBaseConfig() *Config {
+	return &Config{
+		LogLevel: "INFO",
+		RateLimiters: &RateLimiterConfig{
+			Budgets: []*RateLimitBudgetConfig{
+				{
+					Id: "default-budget",
+					Rules: []*RateLimitRuleConfig{
+						{Method: "*", MaxCount: 100, Period: "1s", WaitTime: "1s"},
+					},
+				},
+			},
+		},
+		Projects: []*ProjectConfig{
+			{
+				Id: "main",
+				Upstreams: []*UpstreamConfig{
+					{
+						Id:       "rpc1",
+						Type:     UpstreamTypeEvm,
+						Endpoint: "http://rpc1.localhost",
+						Evm:      &EvmUpstreamConfig{ChainId: 1},
+					},
+				},
+				Networks: []*NetworkConfig{
+					{
+						Architecture: ArchitectureEvm,
+						Evm:          &EvmNetworkConfig{ChainId: 1},
+					},
+				},
+			},
+		},
+	}
+}
+
+func assertValid(t *testing.T, c *Config) {
+	t.Helper()
+	if err := c.Validate(); err != nil {
+		t.Fatalf("expected config to be valid, got error: %v", err)
+	}
+}
+
+func assertInvalid(t *testing.T, c *Config, mustContain string) {
+	t.Helper()
+	err := c.Validate()
+	if err == nil {
+		t.Fatalf("expected validation error, got nil")
+	}
+	if mustContain != "" && !strings.Contains(strings.ToLower(err.Error()), strings.ToLower(mustContain)) {
+		t.Fatalf("expected error to mention %q, got: %v", mustContain, err)
+	}
+}
+
+func TestValidate_BaselineIsValid(t *testing.T) {
+	assertValid(t, validBaseConfig())
+}
+
+func TestValidate_ProjectIdRequired(t *testing.T) {
+	c := validBaseConfig()
+	c.Projects[0].Id = ""
+	assertInvalid(t, c, "")
+}
+
+func TestValidate_ProjectNeedsUpstream(t *testing.T) {
+	c := validBaseConfig()
+	c.Projects[0].Upstreams = nil
+	assertInvalid(t, c, "")
+}
+
+func TestValidate_ConnectorDriverRequired(t *testing.T) {
+	c := validBaseConfig()
+	c.Database = &DatabaseConfig{
+		EvmJsonRpcCache: &ConnectorConfig{
+			Driver: "",
+			Memory: &MemoryConnectorConfig{MaxItems: 100},
+		},
+	}
+	assertInvalid(t, c, "driver")
+}
+
+func TestValidate_ConnectorDriverMustBeKnown(t *testing.T) {
+	c := validBaseConfig()
+	c.Database = &DatabaseConfig{
+		EvmJsonRpcCache: &ConnectorConfig{
+			Driver: "cassandra",
+			Memory: &MemoryConnectorConfig{MaxItems: 100},
+		},
+	}
+	assertInvalid(t, c, "driver")
+}
+
+func TestValidate_ConnectorDriverBlockMustMatch(t *testing.T) {
+	c := validBaseConfig()
+
+	c.Database = &DatabaseConfig{
+		EvmJsonRpcCache: &ConnectorConfig{
+			Driver: "redis",
+		},
+	}
+	assertInvalid(t, c, "redis")
+}
+
+func TestValidate_ConnectorValid(t *testing.T) {
+	c := validBaseConfig()
+	c.Database = &DatabaseConfig{
+		EvmJsonRpcCache: &ConnectorConfig{
+			Driver: "memory",
+			Memory: &MemoryConnectorConfig{MaxItems: 100},
+		},
+	}
+	assertValid(t, c)
+}
+
+func TestValidate_BudgetNeedsRule(t *testing.T) {
+	c := validBaseConfig()
+	c.RateLimiters.Budgets[0].Rules = nil
+	assertInvalid(t, c, "")
+}
+
+func TestValidate_RuleMethodRequired(t *testing.T) {
+	c := validBaseConfig()
+	c.RateLimiters.Budgets[0].Rules[0].Method = ""
+	assertInvalid(t, c, "method")
+}
+
+func TestValidate_ProjectBudgetReferenceMustExist(t *testing.T) {
+	c := validBaseConfig()
+	c.Projects[0].RateLimitBudget = "does-not-exist"
+	assertInvalid(t, c, "budget")
+}
+
+func TestValidate_ProjectBudgetReferenceValid(t *testing.T) {
+	c := validBaseConfig()
+	c.Projects[0].RateLimitBudget = "default-budget"
+	assertValid(t, c)
+}
+
+func TestValidate_UpstreamBudgetReferenceMustExist(t *testing.T) {
+	c := validBaseConfig()
+	c.Projects[0].Upstreams[0].RateLimitBudget = "nope"
+	assertInvalid(t, c, "budget")
+}
+
+func TestValidate_NetworkBudgetReferenceMustExist(t *testing.T) {
+	c := validBaseConfig()
+	c.Projects[0].Networks[0].RateLimitBudget = "missing"
+	assertInvalid(t, c, "budget")
+}
+
+func TestValidate_NetworkArchitectureRequired(t *testing.T) {
+	c := validBaseConfig()
+	c.Projects[0].Networks[0].Architecture = ""
+	assertInvalid(t, c, "architecture")
+}
+
+func TestValidate_EvmNetworkNeedsEvmBlock(t *testing.T) {
+	c := validBaseConfig()
+	c.Projects[0].Networks[0].Evm = nil
+	assertInvalid(t, c, "")
+}
+
+func TestValidate_FailsafeTimeoutDurationMustParse(t *testing.T) {
+	c := validBaseConfig()
+	c.Projects[0].Upstreams[0].Failsafe = &FailsafeConfig{
+		Timeout: &TimeoutPolicyConfig{Duration: "not-a-duration"},
+	}
+	assertInvalid(t, c, "duration")
+}
+
+func TestValidate_FailsafeTimeoutDurationValid(t *testing.T) {
+	c := validBaseConfig()
+	c.Projects[0].Upstreams[0].Failsafe = &FailsafeConfig{
+		Timeout: &TimeoutPolicyConfig{Duration: "5s"},
+	}
+	assertValid(t, c)
+}
