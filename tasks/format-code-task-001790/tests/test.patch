+import gc
+import inspect
+import sys
+import tracemalloc
+import types
+import weakref
+
+import pytest
+import torch
+from mmcv import ConfigDict
+
+
+def _install_python_nms_ext_fallback():
+
+    if "mmdet.ops.nms.nms_ext" in sys.modules:
+        return
+
+    fallback = types.ModuleType("mmdet.ops.nms.nms_ext")
+
+    def _iou(box, boxes):
+        x1 = torch.maximum(box[0], boxes[:, 0])
+        y1 = torch.maximum(box[1], boxes[:, 1])
+        x2 = torch.minimum(box[2], boxes[:, 2])
+        y2 = torch.minimum(box[3], boxes[:, 3])
+        inter = (x2 - x1).clamp(min=0) * (y2 - y1).clamp(min=0)
+        box_area = (box[2] - box[0]).clamp(min=0) * (box[3] - box[1]).clamp(min=0)
+        boxes_area = (
+            (boxes[:, 2] - boxes[:, 0]).clamp(min=0)
+            * (boxes[:, 3] - boxes[:, 1]).clamp(min=0)
+        )
+        return inter / (box_area + boxes_area - inter).clamp(min=1e-12)
+
+    def nms(dets, iou_thr):
+        scores = dets[:, 4]
+        order = scores.argsort(descending=True)
+        keep = []
+        while order.numel() > 0:
+            current = order[0]
+            keep.append(current)
+            if order.numel() == 1:
+                break
+            rest = order[1:]
+            order = rest[_iou(dets[current, :4], dets[rest, :4]) <= iou_thr]
+        if not keep:
+            return dets.new_zeros((0,), dtype=torch.long)
+        return torch.stack(keep).to(device=dets.device, dtype=torch.long)
+
+    def soft_nms(dets, iou_thr, method, sigma, min_score):
+        kept = nms(dets, iou_thr)
+        return torch.cat([dets[kept], kept.to(dets.dtype)[:, None]], dim=1)
+
+    def nms_match(dets, thresh):
+        return [idx.view(1) for idx in nms(dets, thresh)]
+
+    fallback.nms = nms
+    fallback.soft_nms = soft_nms
+    fallback.nms_match = nms_match
+    sys.modules["mmdet.ops.nms.nms_ext"] = fallback
+
+
+def _install_python_roi_align_ext_fallback():
+
+    if "mmdet.ops.roi_align.roi_align_ext" in sys.modules:
+        return
+
+    fallback = types.ModuleType("mmdet.ops.roi_align.roi_align_ext")
+
+    def _unused(*args, **kwargs):
+        raise NotImplementedError("RoIAlign native extension is not used by these tests")
+
+    fallback.forward_v1 = _unused
+    fallback.forward_v2 = _unused
+    fallback.backward_v1 = _unused
+    fallback.backward_v2 = _unused
+    sys.modules["mmdet.ops.roi_align.roi_align_ext"] = fallback
+
+
+def _install_python_compiling_info_fallback():
+
+    if "mmdet.ops.utils.compiling_info" in sys.modules:
+        return
+
+    fallback = types.ModuleType("mmdet.ops.utils.compiling_info")
+    fallback.get_compiler_version = lambda: "unavailable"
+    fallback.get_compiling_cuda_version = lambda: "unavailable"
+    sys.modules["mmdet.ops.utils.compiling_info"] = fallback
+
+
+
+_install_python_nms_ext_fallback()
+
+_install_python_roi_align_ext_fallback()
+
+_install_python_compiling_info_fallback()
+
+from mmdet.models import HEADS, build_head
+from mmdet.models.dense_heads import AnchorAugHead
+
+
+ANCHOR_16 = dict(
+    type="AnchorGenerator",
+    strides=[16],
+    scales=[1],
+    ratios=[1.0],
+)
+
+
+def _proposal_cfg(**overrides):
+    cfg = dict(iou_thr=0.5, nms_thr=0.5, nms_pre=1)
+    cfg.update(overrides)
+    return ConfigDict(cfg)
+
+
+def _assert_single_proposal(tensor, expected_box):
+    assert tuple(tensor.shape) == (1, 5)
+    assert tensor[:, :4].tolist() == [expected_box]
+
+    assert torch.isfinite(tensor[:, 4]).all()
+
+
+def test_direct_construction_registry_selection_and_init_weights_noop():
+
+
+
+
+    assert HEADS.get("AnchorAugHead").__name__ == "AnchorAugHead"
+
+    direct = AnchorAugHead(ANCHOR_16, train_cfg=None, test_cfg=None)
+    assert direct.__class__.__name__ == "AnchorAugHead"
+    assert direct.init_weights(pretrained=None) is None
+
+    built = build_head(dict(type="AnchorAugHead", anchor_generator=ANCHOR_16))
+    assert built.__class__.__name__ == "AnchorAugHead"
+    assert built.init_weights(pretrained="ignored-checkpoint.pth") is None
+
+
+def test_exact_overlap_keeps_anchor_and_returns_score_column():
+
+
+
+
+    head = AnchorAugHead(ANCHOR_16)
+
+    torch.manual_seed(123)
+    proposals = head.forward_train(
+        (torch.zeros(1, 1, 1, 1),),
+        [{}],
+        [torch.tensor([[-8.0, -8.0, 8.0, 8.0]])],
+        proposal_cfg=_proposal_cfg(iou_thr=0.5),
+    )
+
+    assert len(proposals) == 1
+    _assert_single_proposal(
+        proposals[0],
+        [-8.0, -8.0, 8.0, 8.0],
+    )
+
+    assert proposals[0].shape[1] == 5
+
+
+def test_high_threshold_falls_back_to_top_iou_anchor():
+
+
+
+
+    head = AnchorAugHead(ANCHOR_16)
+
+    torch.manual_seed(123)
+    proposals = head.forward_train(
+        (torch.zeros(1, 1, 1, 2),),
+        [{}],
+        [torch.tensor([[-2.0, -2.0, 2.0, 2.0]])],
+        proposal_cfg=_proposal_cfg(iou_thr=0.95, nms_pre=1),
+    )
+
+    assert len(proposals) == 1
+    _assert_single_proposal(
+        proposals[0],
+        [-8.0, -8.0, 8.0, 8.0],
+    )
+
+
+def test_generate_from_single_level_selects_the_requested_fpn_tensor():
+
+
+
+
+    head = AnchorAugHead(ANCHOR_16)
+
+    torch.manual_seed(123)
+    proposals = head.forward_train(
+        (
+            torch.zeros(1, 1, 2, 2),
+            torch.zeros(1, 1, 3, 3),
+            torch.zeros(1, 1, 1, 2),
+        ),
+        [{}],
+        [torch.tensor([[8.0, -8.0, 24.0, 8.0]])],
+        proposal_cfg=_proposal_cfg(generate_from_single_level=2),
+    )
+
+    assert len(proposals) == 1
+    _assert_single_proposal(
+        proposals[0],
+        [8.0, -8.0, 24.0, 8.0],
+    )
+
+
+def test_repeated_forward_train_reuses_session_state_but_recomputes_proposals():
+
+
+
+
+    head = AnchorAugHead(ANCHOR_16)
+
+    assert isinstance(head, torch.nn.Module)
+
+    torch.manual_seed(123)
+    first = head.forward_train(
+        (torch.zeros(1, 1, 1, 1),),
+        [{}],
+        [torch.tensor([[-8.0, -8.0, 8.0, 8.0]])],
+        proposal_cfg=_proposal_cfg(),
+    )
+    _assert_single_proposal(
+        first[0],
+        [-8.0, -8.0, 8.0, 8.0],
+    )
+
+    torch.manual_seed(124)
+    second = head.forward_train(
+        (torch.zeros(1, 1, 1, 2),),
+        [{}],
+        [torch.tensor([[8.0, -8.0, 24.0, 8.0]])],
+        proposal_cfg=_proposal_cfg(),
+    )
+    _assert_single_proposal(
+        second[0],
+        [8.0, -8.0, 24.0, 8.0],
+    )
+
+
+def test_forward_train_signature_exposes_optional_proposal_cfg_default():
+
+
+
+
+
+    params = inspect.signature(AnchorAugHead.forward_train).parameters
+    assert "proposal_cfg" in params
+    assert params["proposal_cfg"].default is None
+
+
+def test_init_weights_is_idempotent_noop():
+
+
+
+
+    head = AnchorAugHead(ANCHOR_16)
+
+    assert head.init_weights(pretrained=None) is None
+    assert head.init_weights(pretrained=None) is None
+    assert head.__class__.__name__ == "AnchorAugHead"
+
+
+def test_two_heads_and_two_images_keep_proposal_state_independent():
+
+
+
+
+    first_head = AnchorAugHead(ANCHOR_16)
+    second_head = AnchorAugHead(ANCHOR_16)
+
+    torch.manual_seed(123)
+    first_batch = first_head.forward_train(
+        (torch.zeros(2, 1, 1, 1),),
+        [{}, {}],
+        [
+            torch.tensor([[-8.0, -8.0, 8.0, 8.0]]),
+            torch.tensor([[-8.0, -8.0, 8.0, 8.0]]),
+        ],
+        proposal_cfg=_proposal_cfg(nms_thr=0.5),
+    )
+
+    torch.manual_seed(123)
+    second_batch = second_head.forward_train(
+        (torch.zeros(1, 1, 1, 2),),
+        [{}],
+        [torch.tensor([[8.0, -8.0, 24.0, 8.0]])],
+        proposal_cfg=_proposal_cfg(nms_thr=0.5),
+    )
+
+    assert len(first_batch) == 2
+    _assert_single_proposal(
+        first_batch[0],
+        [-8.0, -8.0, 8.0, 8.0],
+    )
+    _assert_single_proposal(
+        first_batch[1],
+        [-8.0, -8.0, 8.0, 8.0],
+    )
+    assert len(second_batch) == 1
+    _assert_single_proposal(
+        second_batch[0],
+        [8.0, -8.0, 24.0, 8.0],
+    )
+
+    assert first_batch[0].shape[1] == 5
+    assert second_batch[0].shape[1] == 5
+
+
+def test_construct_use_and_drop_cycles_stay_bounded():
+
+
+
+
+    tracemalloc.start()
+    gc.collect()
+    start_current, _ = tracemalloc.get_traced_memory()
+    refs = []
+
+    for _ in range(100):
+        head = AnchorAugHead(ANCHOR_16)
+        refs.append(weakref.ref(head))
+        torch.manual_seed(123)
+        proposals = head.forward_train(
+            (torch.zeros(1, 1, 1, 1),),
+            [{}],
+            [torch.tensor([[-8.0, -8.0, 8.0, 8.0]])],
+            proposal_cfg=_proposal_cfg(),
+        )
+        _assert_single_proposal(
+            proposals[0],
+            [-8.0, -8.0, 8.0, 8.0],
+        )
+        del proposals
+        del head
+        gc.collect()
+
+    gc.collect()
+    end_current, _ = tracemalloc.get_traced_memory()
+    tracemalloc.stop()
+
+
+    assert len(refs) == 100
+    assert isinstance(end_current - start_current, int)
