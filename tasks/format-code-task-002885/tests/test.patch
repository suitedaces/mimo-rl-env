new file mode 100644
index 00000000000..0c6adf2a111
--- /dev/null
+++ b/packages/orm/objection/src/components/objectionDocs.spec.ts
@@ -0,0 +1,16 @@
+import {readFileSync} from "fs";
+import {join} from "path";
+
+describe("docs/tutorials/objection.md", () => {
+  it("documents the HasOneThroughRelation decorator in the Relationships section", () => {
+    const content = readFileSync(join(__dirname, "../../../../../docs/tutorials/objection.md"), "utf8");
+    const match = content.match(/## Relationships\s+([\s\S]*?)(?=\n## |\s*$)/);
+
+    expect(match).not.toBeNull();
+
+    const relationshipsSection = match![1];
+
+    expect(relationshipsSection).toContain("@@HasOneThroughRelation@@");
+    expect(relationshipsSection).not.toContain("@@HasOneThroughRelationship@@");
+  });
+});
