diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,25 @@
+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+
+export PATH="/opt/node-24/bin:$PATH"
+yarn install --ignore-engines --ignore-scripts 2>&1
+export NODE_ENV=test
+
+
+cd packages/orm/objection
+
+case "${1:-}" in
+  base)
+    npx jest --testPathPattern="createIdColumn.spec" --testNamePattern='should create table from a given class \((bigIncrements|increments)\)' --no-coverage --runInBand
+    ;;
+  new)
+    npx jest --testPathPattern="createIdColumn.spec|objectionDocs.spec" --testNamePattern='uuid primary key id column|documents the HasOneThroughRelation' --no-coverage --runInBand
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
