diff --git a/test/unicodeMappingSpec.js b/test/unicodeMappingSpec.js
new file mode 100644
index 0000000..8d613d3
--- /dev/null
+++ b/test/unicodeMappingSpec.js
@@ -0,0 +1,100 @@
+import assert from 'assert';
+import { Font, Glyph, Path, loadSync, parse } from '../src/opentype';
+
+function makeAliasFont() {
+    const notdef = new Glyph({
+        name: '.notdef',
+        unicode: 0,
+        advanceWidth: 500,
+        path: new Path()
+    });
+    const alpha = new Glyph({
+        index: 1,
+        name: 'alpha',
+        unicode: 65,
+        unicodes: [65, 0x391, 0x1F642],
+        advanceWidth: 600,
+        path: new Path()
+    });
+    return new Font({
+        familyName: 'Alias Test',
+        styleName: 'Regular',
+        unitsPerEm: 1000,
+        ascender: 800,
+        descender: -200,
+        glyphs: [notdef, alpha]
+    });
+}
+
+const missingCharacter = String.fromCodePoint(0x10FFFF);
+const smileCharacter = String.fromCodePoint(0x1F642);
+
+describe('unicode mapping and fallback', function() {
+    it('keeps a glyph primary unicode and all supplied aliases', function() {
+        const font = makeAliasFont();
+        const glyph = font.glyphs.get(1);
+
+        assert.equal(glyph.unicode, 65);
+        assert.deepEqual(glyph.unicodes, [65, 0x391, 0x1F642]);
+        assert.equal(font.hasChar('A'), true);
+        assert.equal(font.hasChar('\u0391'), true);
+        assert.equal(font.hasChar(smileCharacter), true);
+        assert.equal(font.charToGlyphIndex('\u0391'), 1);
+        assert.equal(font.charToGlyphIndex(smileCharacter), 1);
+        assert.strictEqual(font.charToGlyph('\u0391'), glyph);
+    });
+
+    it('reports absent characters without losing .notdef fallback', function() {
+        const font = makeAliasFont();
+        const missing = missingCharacter;
+
+        assert.equal(font.hasChar(missing), false);
+        assert.equal(font.charToGlyphIndex(missing), null);
+        let fallback;
+        assert.doesNotThrow(function() {
+            fallback = font.charToGlyph(missing);
+        });
+        assert.equal(fallback.index, 0);
+        let glyphs;
+        assert.doesNotThrow(function() {
+            glyphs = font.stringToGlyphs('A' + missing + '\u0391');
+        });
+        assert.deepEqual(glyphs.map(g => g.index), [1, 0, 1]);
+    });
+
+    it('round-trips aliases through the generated font cmap', function() {
+        const original = makeAliasFont();
+        const loaded = parse(original.toArrayBuffer());
+
+        assert.equal(loaded.hasChar('A'), true);
+        assert.equal(loaded.hasChar('\u0391'), true);
+        assert.equal(loaded.hasChar(smileCharacter), true);
+        assert.equal(loaded.charToGlyphIndex('\u0391'), 1);
+        assert.equal(loaded.charToGlyphIndex(smileCharacter), 1);
+        assert.equal(loaded.charToGlyph('\u0391').index, 1);
+        assert.equal(loaded.hasChar(missingCharacter), false);
+        assert.equal(loaded.charToGlyphIndex(missingCharacter), null);
+        assert.equal(loaded.charToGlyph(missingCharacter).index, 0);
+    });
+
+    it('uses the same missing-character contract for TrueType and CFF fonts', function() {
+        const missing = missingCharacter;
+        ['fonts/Roboto-Black.ttf', 'fonts/FiraSansOT-Medium.otf'].forEach(function(file) {
+            const font = loadSync(file);
+            assert.equal(font.hasChar('A'), true);
+            assert.equal(font.hasChar(missing), false);
+            assert.equal(font.charToGlyphIndex(missing), null);
+            assert.equal(font.charToGlyph(missing).index, 0);
+            assert.equal(font.stringToGlyphs('A' + missing)[1].index, 0);
+        });
+    });
+
+    it('keeps fallback behavior in low-memory glyph sets', function() {
+        ['fonts/Roboto-Black.ttf', 'fonts/FiraSansOT-Medium.otf'].forEach(function(file) {
+            const font = loadSync(file, {lowMemory: true});
+            assert.equal(font.hasChar(missingCharacter), false);
+            assert.equal(font.charToGlyphIndex(missingCharacter), null);
+            assert.equal(font.stringToGlyphs(missingCharacter)[0].index, 0);
+        });
+    });
+});

