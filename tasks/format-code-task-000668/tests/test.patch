+func (s *K8sIdentityBackendSuite) TestSanitizeK8sLabelsSkipsNamespaceDerivedLabels(c *C) {
+	client := fake.NewSimpleClientset()
+	backend := &crdBackend{
+		CRDBackendConfiguration: CRDBackendConfiguration{
+			Client: client,
+		},
+	}
+	namespaceLabelKey := ciliumio.PodNamespaceMetaLabels + ".team"
+	longNamespaceLabelKey := ciliumio.PodNamespaceMetaLabels + ".some.really.really.long.namespace.label.name"
+	securityLabels := labels.Labels{
+		"app":                 labels.NewLabel("app", "frontend", labels.LabelSourceK8s),
+		"runtime":             labels.NewLabel("runtime", "docker", labels.LabelSourceContainer),
+		namespaceLabelKey:     labels.NewLabel(namespaceLabelKey, "platform", labels.LabelSourceK8s),
+		longNamespaceLabelKey: labels.NewLabel(longNamespaceLabelKey, "someval", labels.LabelSourceK8s),
+	}
+	key := testAllocatorKey(securityLabels.StringMap())
+
+	err := backend.AllocateID(context.Background(), idpool.ID(1234), key)
+	c.Assert(err, IsNil)
+
+	created, err := client.CiliumV2().CiliumIdentities().Get(context.Background(), "1234", metav1.GetOptions{})
+	c.Assert(err, IsNil)
+
+	c.Assert(
+		validation.ValidateLabels(created.ObjectMeta.Labels, field.NewPath("test", "labels")),
+		HasLen,
+		0,
+	)
+	c.Assert(created.ObjectMeta.Labels, checker.DeepEquals, map[string]string{
+		"app": "frontend",
+	})
+	c.Assert(created.SecurityLabels, checker.DeepEquals, map[string]string{
+		"k8s:app":                      "frontend",
+		"container:runtime":            "docker",
+		"k8s:" + namespaceLabelKey:     "platform",
+		"k8s:" + longNamespaceLabelKey: "someval",
+	})
+}
