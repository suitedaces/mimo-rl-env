+  new)
+    go test -count=1 -v ./pkg/k8s/identitybackend/ -check.f 'TestSanitizeK8sLabelsSkipsNamespaceDerivedLabels$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
