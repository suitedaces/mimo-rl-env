diff --git a/pkg/prometheus/promcfg_jobname_test.go b/pkg/prometheus/promcfg_jobname_test.go
new file mode 100644
index 000000000..696420741
--- /dev/null
+++ b/pkg/prometheus/promcfg_jobname_test.go
@@ -0,0 +1,253 @@
+
+
+
+
+
+
+
+
+package prometheus
+
+import (
+	"testing"
+
+	monitoringv1 "github.com/prometheus-operator/prometheus-operator/pkg/apis/monitoring/v1"
+	"github.com/prometheus-operator/prometheus-operator/pkg/assets"
+	yaml "gopkg.in/yaml.v2"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+
+
+type parsedConfig struct {
+	ScrapeConfigs []map[string]interface{} `yaml:"scrape_configs"`
+}
+
+func extractJobNames(t *testing.T, cfg []byte) []string {
+	t.Helper()
+	var pc parsedConfig
+	if err := yaml.Unmarshal(cfg, &pc); err != nil {
+		t.Fatalf("could not unmarshal generated config: %v\nconfig:\n%s", err, string(cfg))
+	}
+	names := make([]string, 0, len(pc.ScrapeConfigs))
+	for _, sc := range pc.ScrapeConfigs {
+		v, ok := sc["job_name"]
+		if !ok {
+			continue
+		}
+		s, ok := v.(string)
+		if !ok {
+			t.Fatalf("job_name is not a string: %v", v)
+		}
+		names = append(names, s)
+	}
+	return names
+}
+
+func assertJobNamesUnique(t *testing.T, names []string) {
+	t.Helper()
+	seen := map[string]int{}
+	for _, n := range names {
+		seen[n]++
+	}
+	for n, c := range seen {
+		if c > 1 {
+			t.Fatalf("job_name %q appeared %d times — would crash Prometheus with duplicate-job-name error: %v", n, c, names)
+		}
+	}
+}
+
+func generateJobNameTestConfig(
+	t *testing.T,
+	sMons map[string]*monitoringv1.ServiceMonitor,
+	pMons map[string]*monitoringv1.PodMonitor,
+	probes map[string]*monitoringv1.Probe,
+) []byte {
+	t.Helper()
+	cg := &configGenerator{}
+	cfg, err := cg.generateConfig(
+		&monitoringv1.Prometheus{
+			ObjectMeta: metav1.ObjectMeta{
+				Name:      "test",
+				Namespace: "default",
+			},
+			Spec: monitoringv1.PrometheusSpec{},
+		},
+		sMons,
+		pMons,
+		probes,
+		map[string]assets.BasicAuthCredentials{},
+		map[string]assets.BearerToken{},
+		nil, nil, nil, nil,
+	)
+	if err != nil {
+		t.Fatalf("generateConfig failed: %v", err)
+	}
+	return cfg
+}
+
+func newServiceMonitor(namespace, name string) *monitoringv1.ServiceMonitor {
+	return &monitoringv1.ServiceMonitor{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      name,
+			Namespace: namespace,
+		},
+		Spec: monitoringv1.ServiceMonitorSpec{
+			Endpoints: []monitoringv1.Endpoint{
+				{
+					Port:     "web",
+					Interval: "30s",
+				},
+			},
+		},
+	}
+}
+
+func newPodMonitor(namespace, name string) *monitoringv1.PodMonitor {
+	return &monitoringv1.PodMonitor{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      name,
+			Namespace: namespace,
+		},
+		Spec: monitoringv1.PodMonitorSpec{
+			PodMetricsEndpoints: []monitoringv1.PodMetricsEndpoint{
+				{
+					Port:     "web",
+					Interval: "30s",
+				},
+			},
+		},
+	}
+}
+
+func newProbe(namespace, name string) *monitoringv1.Probe {
+	return &monitoringv1.Probe{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      name,
+			Namespace: namespace,
+		},
+		Spec: monitoringv1.ProbeSpec{
+			ProberSpec: monitoringv1.ProberSpec{
+				Scheme: "http",
+				URL:    "blackbox.exporter.io",
+				Path:   "/probe",
+			},
+			Module: "http_2xx",
+			Targets: monitoringv1.ProbeTargets{
+				StaticConfig: &monitoringv1.ProbeTargetStaticConfig{
+					Targets: []string{"prometheus.io"},
+				},
+			},
+		},
+	}
+}
+
+
+func TestServiceMonitorJobNameHasServiceMonitorPrefix(t *testing.T) {
+	cfg := generateJobNameTestConfig(t,
+		map[string]*monitoringv1.ServiceMonitor{
+			"sm": newServiceMonitor("default", "duplicate"),
+		}, nil, nil)
+
+	names := extractJobNames(t, cfg)
+	if len(names) != 1 {
+		t.Fatalf("expected 1 job_name, got %d: %v\ncfg:\n%s", len(names), names, string(cfg))
+	}
+	if names[0] == "" {
+		t.Fatalf("job_name must be non-empty")
+	}
+}
+
+
+func TestPodMonitorJobNameHasPodMonitorPrefix(t *testing.T) {
+	cfg := generateJobNameTestConfig(t, nil,
+		map[string]*monitoringv1.PodMonitor{
+			"pm": newPodMonitor("default", "duplicate"),
+		}, nil)
+
+	names := extractJobNames(t, cfg)
+	if len(names) != 1 {
+		t.Fatalf("expected 1 job_name, got %d: %v\ncfg:\n%s", len(names), names, string(cfg))
+	}
+	if names[0] == "" {
+		t.Fatalf("job_name must be non-empty")
+	}
+}
+
+
+func TestProbeJobNameHasProbePrefix(t *testing.T) {
+	cfg := generateJobNameTestConfig(t, nil, nil,
+		map[string]*monitoringv1.Probe{
+			"probe": newProbe("default", "duplicate"),
+		})
+
+	names := extractJobNames(t, cfg)
+	if len(names) != 1 {
+		t.Fatalf("expected 1 job_name, got %d: %v\ncfg:\n%s", len(names), names, string(cfg))
+	}
+	if names[0] == "" {
+		t.Fatalf("job_name must be non-empty")
+	}
+}
+
+
+
+
+
+func TestPodMonitorAndServiceMonitorSameNameProduceDistinctJobNames(t *testing.T) {
+	cfg := generateJobNameTestConfig(t,
+		map[string]*monitoringv1.ServiceMonitor{
+			"x": newServiceMonitor("default", "testmonitor"),
+		},
+		map[string]*monitoringv1.PodMonitor{
+			"x": newPodMonitor("default", "testmonitor"),
+		}, nil)
+
+	names := extractJobNames(t, cfg)
+	if len(names) != 2 {
+		t.Fatalf("expected 2 job_names, got %d: %v\ncfg:\n%s", len(names), names, string(cfg))
+	}
+	assertJobNamesUnique(t, names)
+}
+
+
+
+
+
+func TestAllThreeMonitorTypesWithSameNameProduceDistinctPrefixedJobNames(t *testing.T) {
+	cfg := generateJobNameTestConfig(t,
+		map[string]*monitoringv1.ServiceMonitor{
+			"x": newServiceMonitor("ns1", "shared"),
+		},
+		map[string]*monitoringv1.PodMonitor{
+			"x": newPodMonitor("ns1", "shared"),
+		},
+		map[string]*monitoringv1.Probe{
+			"x": newProbe("ns1", "shared"),
+		})
+
+	names := extractJobNames(t, cfg)
+	if len(names) != 3 {
+		t.Fatalf("expected 3 job_names, got %d: %v\ncfg:\n%s", len(names), names, string(cfg))
+	}
+	assertJobNamesUnique(t, names)
+}
+
+
+
+func TestServiceMonitorMultipleEndpointsKeepIndexedSuffix(t *testing.T) {
+	sm := newServiceMonitor("default", "testservicemonitor1")
+	sm.Spec.Endpoints = []monitoringv1.Endpoint{
+		{Port: "web", Interval: "30s"},
+		{Port: "metrics", Interval: "30s"},
+	}
+	cfg := generateJobNameTestConfig(t,
+		map[string]*monitoringv1.ServiceMonitor{"sm": sm},
+		nil, nil)
+
+	names := extractJobNames(t, cfg)
+	if len(names) != 2 {
+		t.Fatalf("expected 2 job_names, got %d: %v", len(names), names)
+	}
+	assertJobNamesUnique(t, names)
+}
