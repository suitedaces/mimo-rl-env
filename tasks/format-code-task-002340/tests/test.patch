diff --git a/test/function_reference.mjs b/test/function_reference.mjs
new file mode 100644
index 0000000..aae1751
--- /dev/null
+++ b/test/function_reference.mjs
@@ -0,0 +1,155 @@
+import assert from "assert";
+import * as FTL from "../syntax/ast.mjs";
+import {Resource} from "../syntax/grammar.mjs";
+import {PASS, FAIL} from "./util.mjs";
+
+const tests = [];
+function test(name, fn) {
+    tests.push({name, fn});
+}
+
+function parse(source) {
+    let ast;
+    Resource.run(source).fold(
+        value => { ast = JSON.parse(JSON.stringify(value)); },
+        err => assert.fail("parse failed: " + err)
+    );
+    return ast;
+}
+
+function find_call_expression(ast) {
+
+    function walk(node) {
+        if (node === null || typeof node !== "object") return undefined;
+        if (node.type === "CallExpression") return node;
+        for (const k of Object.keys(node)) {
+            const result = walk(node[k]);
+            if (result !== undefined) return result;
+        }
+        return undefined;
+    }
+    return walk(ast);
+}
+
+
+
+test("FTL.FunctionReference class is exported with id field", () => {
+    assert.strictEqual(typeof FTL.FunctionReference, "function",
+        "FTL.FunctionReference must be exported as a class");
+    const ident = new FTL.Identifier("FUN");
+    const ref = new FTL.FunctionReference(ident);
+    assert.strictEqual(ref.type, "FunctionReference");
+    assert.strictEqual(ref.id, ident);
+});
+
+test("FTL.Function class is no longer exported", () => {
+    assert.strictEqual(FTL.Function, undefined,
+        "FTL.Function should be removed; it was replaced by FTL.FunctionReference");
+});
+
+
+
+test("simple call expression callee.type is FunctionReference", () => {
+    const ast = parse("msg = {FUN()}\n");
+    const call = find_call_expression(ast);
+    assert.ok(call, "should find a CallExpression in the AST");
+    assert.strictEqual(call.callee.type, "FunctionReference",
+        `expected callee.type "FunctionReference", got "${call.callee.type}"`);
+});
+
+test("simple call expression callee.id is an Identifier node", () => {
+    const ast = parse("msg = {FUN()}\n");
+    const call = find_call_expression(ast);
+    assert.ok(call.callee.id, "callee should have an id field");
+    assert.strictEqual(call.callee.id.type, "Identifier",
+        `expected callee.id.type "Identifier", got "${call.callee.id.type}"`);
+    assert.strictEqual(call.callee.id.name, "FUN",
+        `expected callee.id.name "FUN", got "${call.callee.id.name}"`);
+});
+
+test("simple call expression callee has no direct name field", () => {
+    const ast = parse("msg = {FUN()}\n");
+    const call = find_call_expression(ast);
+
+
+    assert.ok(!("name" in call.callee),
+        `callee should not have a direct .name field; the name should live in callee.id.name. Got: ${JSON.stringify(call.callee)}`);
+});
+
+test("call expression with positional args preserves callee shape", () => {
+    const ast = parse('msg = {FUN(1, "a")}\n');
+    const call = find_call_expression(ast);
+    assert.strictEqual(call.callee.type, "FunctionReference");
+    assert.strictEqual(call.callee.id.type, "Identifier");
+    assert.strictEqual(call.callee.id.name, "FUN");
+    assert.strictEqual(call.positional.length, 2);
+    assert.strictEqual(call.positional[0].type, "NumberLiteral");
+    assert.strictEqual(call.positional[1].type, "StringLiteral");
+});
+
+test("call expression with named args preserves callee shape", () => {
+    const ast = parse("msg = {FUN(x: 1)}\n");
+    const call = find_call_expression(ast);
+    assert.strictEqual(call.callee.type, "FunctionReference");
+    assert.strictEqual(call.callee.id.type, "Identifier");
+    assert.strictEqual(call.callee.id.name, "FUN");
+    assert.strictEqual(call.named.length, 1);
+    assert.strictEqual(call.named[0].type, "NamedArgument");
+    assert.strictEqual(call.named[0].name.name, "x");
+});
+
+test("uppercase function name with allowed special chars parses", () => {
+
+
+    const ast = parse("msg = {FUN_NAME()}\n");
+    const call = find_call_expression(ast);
+    assert.ok(call, "FUN_NAME() should parse to a CallExpression");
+    assert.strictEqual(call.callee.type, "FunctionReference");
+    assert.strictEqual(call.callee.id.type, "Identifier");
+    assert.strictEqual(call.callee.id.name, "FUN_NAME");
+});
+
+test("lowercase function name is still rejected (becomes Junk)", () => {
+    const ast = parse("msg = {fun()}\n");
+
+
+    assert.strictEqual(ast.body.length, 1);
+    assert.strictEqual(ast.body[0].type, "Junk");
+});
+
+test("call expression used as selector keeps FunctionReference shape", () => {
+    const source =
+        "select-msg =\n" +
+        "    { BUILTIN() ->\n" +
+        "        [0] Zero\n" +
+        "       *[other] Other\n" +
+        "    }\n";
+    const ast = parse(source);
+    const call = find_call_expression(ast);
+    assert.ok(call, "should find a CallExpression as the selector");
+    assert.strictEqual(call.callee.type, "FunctionReference");
+    assert.strictEqual(call.callee.id.type, "Identifier");
+    assert.strictEqual(call.callee.id.name, "BUILTIN");
+});
+
+
+
+let failures = 0;
+for (const {name, fn} of tests) {
+    try {
+        fn();
+        console.log(`${PASS} ${name}`);
+    } catch (err) {
+        failures += 1;
+        console.log(`${FAIL} ${name}`);
+        console.log("  " + (err.message || err));
+    }
+}
+
+if (failures > 0) {
+    console.log(`\n${failures} test(s) failed.`);
+    process.exit(1);
+} else {
+    console.log(`\nAll ${tests.length} tests passed.`);
+    process.exit(0);
+}
