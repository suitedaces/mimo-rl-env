+
+#include "gtest/gtest.h"
+#include "singa/model/optimizer.h"
+#include "singa/singa_config.h"
+#include <cmath>
+#include <memory>
+
+
+TEST(OptimizerFactory, ReturnsBaseHandle) {
+  std::shared_ptr<singa::Optimizer> sgd = singa::CreateOptimizer("SGD");
+  std::shared_ptr<singa::Optimizer> nesterov =
+      singa::CreateOptimizer("Nesterov");
+  std::shared_ptr<singa::Optimizer> adagrad =
+      singa::CreateOptimizer("Adagrad");
+  std::shared_ptr<singa::Optimizer> rmsprop =
+      singa::CreateOptimizer("RMSProp");
+  EXPECT_NE(sgd, nullptr);
+  EXPECT_NE(nesterov, nullptr);
+  EXPECT_NE(adagrad, nullptr);
+  EXPECT_NE(rmsprop, nullptr);
+}
+
+TEST(OptimizerFactory, SGDApply) {
+  auto opt = singa::CreateOptimizer("SGD");
+  const float v[4] = {0.1, 0.2, 0.3, 0.4};
+  const float g[4] = {0.1, 0.1, 0.1, 0.1};
+
+  singa::Tensor value(singa::Shape{4}), grad(singa::Shape{4});
+  value.CopyDataFromHostPtr(v, 4);
+  grad.CopyDataFromHostPtr(g, 4);
+
+  float lr = 0.1f;
+  opt->Apply(0, lr, "xx", grad, &value);
+
+  singa::Tensor v1 = value.Clone();
+  const float* newv1 = v1.data<float>();
+  for (int i = 0; i < 4; i++) EXPECT_FLOAT_EQ(newv1[i], v[i] - g[i] * lr);
+}
+
+TEST(OptimizerFactory, AdagradApply) {
+  auto opt = singa::CreateOptimizer("Adagrad");
+  float lr = 0.1f;
+  const float v[4] = {0.1, 0.2, 0.3, 0.4};
+  const float g[4] = {0.01, 0.02, 0.03, 0.04};
+
+  singa::Tensor value(singa::Shape{4}), grad(singa::Shape{4});
+  value.CopyDataFromHostPtr(v, 4);
+  grad.CopyDataFromHostPtr(g, 4);
+
+  singa::OptimizerConf conf;
+  opt->Setup(conf);
+  opt->Apply(0, lr, "xx", grad, &value);
+
+  singa::Tensor v1 = value.Clone();
+  const float* newv1 = v1.data<float>();
+  float history[4];
+  for (int i = 0; i < 4; ++i) history[i] = g[i] * g[i];
+  for (int i = 0; i < 4; ++i)
+    EXPECT_NEAR(newv1[i], v[i] - lr * g[i] / sqrt(history[i] + conf.delta()),
+                1e-5);
+}
+
+TEST(OptimizerFactory, NesterovApply) {
+  auto opt = singa::CreateOptimizer("Nesterov");
+  float lr = 0.1f;
+  const float v[4] = {0.1, 0.2, 0.3, 0.4};
+  const float g[4] = {0.01, 0.02, 0.03, 0.04};
+
+  singa::Tensor value(singa::Shape{4}), grad(singa::Shape{4});
+  value.CopyDataFromHostPtr(v, 4);
+  grad.CopyDataFromHostPtr(g, 4);
+
+  singa::OptimizerConf conf;
+  opt->Setup(conf);
+  float mom = conf.momentum();
+  opt->Apply(0, lr, "xx", grad, &value);
+
+  singa::Tensor v1 = value.Clone();
+  const float* newv1 = v1.data<float>();
+  for (int i = 0; i < 4; ++i)
+    EXPECT_NEAR(newv1[i], v[i] - (1 + mom) * g[i] * lr, 1e-5);
+}
+
+TEST(OptimizerFactory, RMSPropApply) {
+  auto opt = singa::CreateOptimizer("RMSProp");
+  float lr = 0.1f;
+  const float v[4] = {0.1, 0.2, 0.3, 0.4};
+  const float g[4] = {0.01, 0.02, 0.03, 0.04};
+
+  singa::Tensor value(singa::Shape{4}), grad(singa::Shape{4});
+  value.CopyDataFromHostPtr(v, 4);
+  grad.CopyDataFromHostPtr(g, 4);
+
+  singa::OptimizerConf conf;
+  opt->Setup(conf);
+  float rho = conf.rho();
+  float delta = conf.delta();
+  opt->Apply(0, lr, "xx", grad, &value);
+
+  singa::Tensor v1 = value.Clone();
+  const float* newv1 = v1.data<float>();
+  for (int i = 0; i < 4; ++i) {
+    float history = (1 - rho) * g[i] * g[i];
+    EXPECT_NEAR(newv1[i], v[i] - lr * g[i] / sqrt(history + delta), 1e-5);
+  }
+}
+
+TEST(OptimizerFactoryDeathTest, UnknownType) {
+  ::testing::FLAGS_gtest_death_test_style = "threadsafe";
+  ASSERT_DEATH({ auto opt = singa::CreateOptimizer("NoSuchOptimizer"); }, "");
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+export LD_LIBRARY_PATH="/testbed/build/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+
+CXX=${CXX:-g++}
+COMMON_FLAGS="-std=c++11 -fpermissive -include cstdint"
+INCLUDES="-I include -I build/include -I src -I test"
+SRCS="src/model/optimizer/optimizer.cc test/gtest/gtest_main.cc"
+LIBS="build/lib/libgtest.a -L build/lib -lsinga_model -lsinga_core -lsinga_io -lsinga_utils -lprotobuf -lopenblas -lglog -llmdb -lpthread"
+
+build_and_run() {
+    local out="$1"; shift
+    $CXX $COMMON_FLAGS $INCLUDES "$@" $SRCS $LIBS -o "$out"
+    "$out"
+}
+
+
+build_and_run /tmp/regression_tests \
+    test/singa/test_sgd.cc \
+    test/singa/test_adagrad.cc \
+    test/singa/test_nesterov.cc \
+    test/singa/test_rmsprop.cc
+
+
+build_and_run /tmp/factory_tests \
+    test/singa/test_optimizer_factory.cc
