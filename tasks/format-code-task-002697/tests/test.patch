+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+export PYTHONPATH=/testbed:${PYTHONPATH:-}
+
+
+
+
+
+case "${1:-}" in
+  base)
+    python3 -c "
+import skimage.feature
+import skimage.registration
+import numpy as np
+if not hasattr(np, 'float'):
+    np.float = float
+if not hasattr(skimage.feature, 'register_translation'):
+    skimage.feature.register_translation = skimage.registration.phase_cross_correlation
+import pytest
+import sys
+sys.exit(pytest.main([
+    '-q',
+    'starfish/test/image/test_apply.py::test_apply',
+    'starfish/test/image/test_apply.py::test_apply_labeled_dataset',
+    'starfish/test/image/test_apply.py::test_apply_in_place',
+]))
+"
+    ;;
+  new)
+    python3 -c "
+import skimage.feature
+import skimage.registration
+import numpy as np
+if not hasattr(np, 'float'):
+    np.float = float
+if not hasattr(skimage.feature, 'register_translation'):
+    skimage.feature.register_translation = skimage.registration.phase_cross_correlation
+import pytest
+import sys
+sys.exit(pytest.main([
+    '-q',
+    'starfish/test/image/test_apply.py::test_apply_accepts_axis_subset_for_2d_planes',
+    'starfish/test/image/test_apply.py::test_apply_3d',
+    'starfish/test/image/test_apply.py::test_apply_accepts_non_tile_axis_subset',
+    'starfish/test/image/test_apply_split_by_filter_compat.py',
+]))
+"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
