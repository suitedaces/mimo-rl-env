+function functionDependencyNames(fn) {
+  const src = Function.prototype.toString
+    .call(fn)
+    .replace(/\/\*[\s\S]*?\*\//g, '')
+    .replace(/\/\/.*$/gm, '');
+  const match =
+    src.match(/^[\s\(]*function[^(]*\(([^)]*)\)/) ||
+    src.match(/^[\s\(]*\(?([^)=]*)\)?\s*=>/);
+  if (!match) {
+    return [];
+  }
+  return match[1]
+    .split(',')
+    .map((name) => name.trim())
+    .filter(Boolean);
+}
+
+function writeJson(file, value) {
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  fs.writeFileSync(file, JSON.stringify(value, null, 2));
+}
+
+function writeBoard(root, name, info, pinout, rules) {
+  const dir = path.join(root, name);
+  writeJson(path.join(dir, 'info.json'), info);
+  writeJson(path.join(dir, 'pinout.json'), pinout);
+  writeJson(path.join(dir, 'rules.json'), rules || { input: [], output: [] });
+}
