+function loadBoardsServiceFactory() {
+  let serviceFactory = null;
+  let serviceDeps = null;
+  global.angular = {
+    module(moduleName) {
+
+      assert.strictEqual(typeof moduleName, 'string');
+      assert.notStrictEqual(moduleName.trim(), '');
+      return {
+        service(serviceName, factory) {
+          assert.strictEqual(serviceName, 'boards');
+          if (Array.isArray(factory)) {
+            serviceDeps = factory.slice(0, -1);
+            serviceFactory = factory[factory.length - 1];
+          } else {
+            serviceFactory = factory;
+            serviceDeps = functionDependencyNames(factory);
+          }
+          return this;
+        },
+      };
+    },
+  };
+
+  delete require.cache[require.resolve(SERVICE_PATH)];
+  require(SERVICE_PATH);
+  assert.strictEqual(typeof serviceFactory, 'function');
+  return { factory: serviceFactory, deps: serviceDeps || [] };
+}
+
+const BoardsService = loadBoardsServiceFactory();
+
+function makeService(externalBoards) {
+  const common = {
+    APP: APP_ROOT,
+    DEFAULT_EXTERNAL_BOARDS_DIR: DEFAULT_USER_BOARDS,
+    boards: [],
+    selectedBoard: null,
+    pinoutInputHTML: '',
+    pinoutOutputHTML: '',
+  };
+  const profile = {
+    externalBoards,
+    data: { externalBoards },
+    get(key) {
+      assert.strictEqual(key, 'externalBoards');
+      return externalBoards;
+    },
+  };
+  const utils = {
+    applyCount: 0,
+    rootScopeSafeApply() {
+      this.applyCount += 1;
+    },
+  };
+  const injectable = {
+    common,
+    fs,
+    nodeFs: fs,
+    nodePath: path,
+    path,
+    profile,
+    utils,
+  };
+  const args = BoardsService.deps.map((name) => injectable[name]);
+  return {
+
+    boards: new BoardsService.factory(...args),
+    common,
+    utils,
+  };
+}
+
+function withSuppressedConsoleError(fn) {
+  const original = console.error;
+  console.error = function () {};
+  try {
+    return fn();
+  } finally {
+    console.error = original;
+  }
+}
+
+function boardByName(common, name) {
+  return common.boards.find((board) => board.name === name);
+}
+
+function assertBoardRecord(board, expected) {
+  const actualRecord = {
+    name: board.name,
+    label: board.info.label,
+    type: board.type,
+    mode: board.mode,
+    apioBoard: board.apioBoard,
+    origin: board.origin,
+    readOnly: board.readOnly,
+    pinout: board.pinout,
+    rules: board.rules,
+  };
+  const expectedRecord = Object.assign({}, expected);
+  delete expectedRecord.path;
+  assert.deepStrictEqual(
+    actualRecord,
+    expectedRecord
+  );
+
+  assert.strictEqual(path.resolve(board.path), path.resolve(expected.path));
+}
+
+function parsePinoutOptions(html) {
+  const options = [];
+  const re = /<option(?:\s+value=(?:"([^"]*)"|'([^']*)'))?\s*>([^<]*)<\/option>/g;
+  let pos = 0;
+  let match;
+  while ((match = re.exec(html)) !== null) {
+    assert.strictEqual(html.slice(pos, match.index), '');
+    options.push({ value: match[1] || match[2] || '', label: match[3] });
+    pos = re.lastIndex;
+  }
+  assert.strictEqual(html.slice(pos), '');
+  return options;
+}
+
+function assertPinoutOptions(html, expected) {
+  const options = parsePinoutOptions(html);
+  assert.deepStrictEqual(options[0], { value: '', label: '' });
+  const normalize = (items) =>
+    items
+      .map((item) => item.value + '\u0000' + item.label)
+      .sort();
+  assert.deepStrictEqual(normalize(options.slice(1)), normalize(expected));
+}
