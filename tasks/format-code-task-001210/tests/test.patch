+  assert.strictEqual(names.length, 8);
+  assert.strictEqual(new Set(names).size, 8);
+  ['fallback-user', 'type-only', 'user-alpha', 'project-only'].forEach((name) => {
+    assert.notStrictEqual(names.indexOf(name), -1);
+  });
+  ['fallback-user', 'type-only', 'user-alpha'].forEach((name) => {
+    assert.strictEqual(names.indexOf(name) > names.indexOf('alhambra-ii'), true);
+    assert.strictEqual(names.indexOf(name) < names.indexOf('project-only'), true);
+  });
+}
