diff --git a/usercase-test-coderl/offline-network-guard.js b/usercase-test-coderl/offline-network-guard.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/offline-network-guard.js
@@ -0,0 +1,182 @@
+
+'use strict';
+
+const childProcess = require('child_process');
+const dns = require('dns');
+const dgram = require('dgram');
+const http = require('http');
+const http2 = require('http2');
+const https = require('https');
+const net = require('net');
+const tls = require('tls');
+
+const LOCAL_HOSTS = new Set([
+  '',
+  '0.0.0.0',
+  '::',
+  '::1',
+  '127.0.0.1',
+  'localhost',
+]);
+
+function fail(kind, target) {
+  throw new Error('local offline network guard blocked ' + kind + ': ' + target);
+}
+
+function normalizeHost(host) {
+  return String(host || '')
+    .replace(/^\[/, '')
+    .replace(/\]$/, '')
+    .toLowerCase();
+}
+
+function isLocalHost(host) {
+  const normalized = normalizeHost(host);
+  return LOCAL_HOSTS.has(normalized) || normalized.startsWith('127.');
+}
+
+function hostFromConnectArgs(args) {
+  const first = args[0];
+  if (typeof first === 'object' && first !== null) {
+    if (first.path) {
+      return '';
+    }
+    return first.host || first.hostname || '';
+  }
+  if (typeof first === 'string' && Number.isNaN(Number(first))) {
+    return first;
+  }
+  return typeof args[1] === 'string' ? args[1] : 'localhost';
+}
+
+function hostFromRequestArgs(args) {
+  const first = args[0];
+  const second = args[1];
+  if (typeof first === 'string' || first instanceof URL) {
+    try {
+      return new URL(String(first)).hostname;
+    } catch (error) {
+      return '';
+    }
+  }
+  if (typeof first === 'object' && first !== null) {
+    return first.hostname || first.host || '';
+  }
+  if (typeof second === 'object' && second !== null) {
+    return second.hostname || second.host || '';
+  }
+  return '';
+}
+
+function blockRemoteConnect(moduleName, object, methodName) {
+  const original = object[methodName];
+  object[methodName] = function guardedConnect(...args) {
+    const host = hostFromConnectArgs(args);
+    if (!isLocalHost(host)) {
+      fail(moduleName + '.' + methodName, host);
+    }
+    return original.apply(this, args);
+  };
+}
+
+function blockRemoteRequest(moduleName, object, methodName) {
+  const original = object[methodName];
+  object[methodName] = function guardedRequest(...args) {
+    const host = hostFromRequestArgs(args);
+    if (!isLocalHost(host)) {
+      fail(moduleName + '.' + methodName, host);
+    }
+    return original.apply(this, args);
+  };
+}
+
+blockRemoteConnect('net', net, 'connect');
+blockRemoteConnect('net', net, 'createConnection');
+blockRemoteConnect('tls', tls, 'connect');
+blockRemoteConnect('net.Socket', net.Socket.prototype, 'connect');
+blockRemoteRequest('http', http, 'request');
+blockRemoteRequest('http', http, 'get');
+blockRemoteRequest('https', https, 'request');
+blockRemoteRequest('https', https, 'get');
+blockRemoteRequest('http2', http2, 'connect');
+
+for (const name of ['lookup', 'resolve', 'resolve4', 'resolve6', 'resolveAny', 'resolveCaa', 'resolveCname', 'resolveMx', 'resolveNaptr', 'resolveNs', 'resolvePtr', 'resolveSoa', 'resolveSrv', 'resolveTxt', 'reverse']) {
+  if (typeof dns[name] === 'function') {
+    const original = dns[name];
+    dns[name] = function guardedDns(...args) {
+      const host = args[0];
+      if (!isLocalHost(host)) {
+        fail('dns.' + name, host);
+      }
+      return original.apply(this, args);
+    };
+  }
+  if (dns.promises && typeof dns.promises[name] === 'function') {
+    const original = dns.promises[name];
+    dns.promises[name] = function guardedDnsPromise(...args) {
+      const host = args[0];
+      if (!isLocalHost(host)) {
+        fail('dns.promises.' + name, host);
+      }
+      return original.apply(this, args);
+    };
+  }
