@@ -0,0 +1,274 @@
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+package extension
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+func mustValue(s string) int64 {
+	q := resource.MustParse(s)
+	return q.Value()
+}
+
+func newAmplifyTestNode(annotations map[string]string, allocatable corev1.ResourceList) *corev1.Node {
+	return &corev1.Node{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:        "test-node",
+			Annotations: annotations,
+		},
+		Status: corev1.NodeStatus{
+			Allocatable: allocatable,
+		},
+	}
+}
+
+func TestAmplifyNodeAllocatable_AmplifiesCPUAndMemory(t *testing.T) {
+	node := newAmplifyTestNode(
+		map[string]string{
+			AnnotationNodeResourceAmplificationRatio: `{"cpu":1.5,"memory":2}`,
+		},
+		corev1.ResourceList{
+			corev1.ResourceCPU:    resource.MustParse("4"),
+			corev1.ResourceMemory: resource.MustParse("2Gi"),
+		},
+	)
+
+	err := AmplifyNodeAllocatable(node)
+	assert.NoError(t, err)
+
+	gotCPU := node.Status.Allocatable[corev1.ResourceCPU]
+	gotMem := node.Status.Allocatable[corev1.ResourceMemory]
+	assert.Equal(t, int64(6000), gotCPU.MilliValue(), "cpu should be amplified by 1.5")
+	assert.Equal(t, mustValue("4Gi"), gotMem.Value(), "memory should be amplified by 2")
+
+
+	raw, err := GetNodeRawAllocatable(node.Annotations)
+	assert.NoError(t, err)
+	assert.NotNil(t, raw)
+	rawCPU := raw[corev1.ResourceCPU]
+	rawMem := raw[corev1.ResourceMemory]
+	assert.Equal(t, int64(4000), rawCPU.MilliValue())
+	assert.Equal(t, mustValue("2Gi"), rawMem.Value())
+}
+
+func TestAmplifyNodeAllocatable_Idempotent(t *testing.T) {
+	node := newAmplifyTestNode(
+		map[string]string{
+			AnnotationNodeResourceAmplificationRatio: `{"cpu":1.5,"memory":2}`,
+		},
+		corev1.ResourceList{
+			corev1.ResourceCPU:    resource.MustParse("4"),
+			corev1.ResourceMemory: resource.MustParse("2Gi"),
+		},
+	)
+
+	assert.NoError(t, AmplifyNodeAllocatable(node))
+	assert.NoError(t, AmplifyNodeAllocatable(node))
+	assert.NoError(t, AmplifyNodeAllocatable(node))
+
+	gotCPU := node.Status.Allocatable[corev1.ResourceCPU]
+	gotMem := node.Status.Allocatable[corev1.ResourceMemory]
+
+	assert.Equal(t, int64(6000), gotCPU.MilliValue())
+	assert.Equal(t, mustValue("4Gi"), gotMem.Value())
+}
+
+func TestAmplifyNodeAllocatable_StoredRawIsTheBaseline(t *testing.T) {
+
+
+	node := newAmplifyTestNode(
+		map[string]string{
+			AnnotationNodeResourceAmplificationRatio: `{"cpu":1.5}`,
+			AnnotationNodeRawAllocatable:             `{"cpu":"4"}`,
+		},
+		corev1.ResourceList{
+			corev1.ResourceCPU: resource.MustParse("9"),
+		},
+	)
+
+	err := AmplifyNodeAllocatable(node)
+	assert.NoError(t, err)
+
+	gotCPU := node.Status.Allocatable[corev1.ResourceCPU]
+	assert.Equal(t, int64(6000), gotCPU.MilliValue(), "should amplify the stored raw baseline 4 by 1.5")
+
+
+	raw, err := GetNodeRawAllocatable(node.Annotations)
+	assert.NoError(t, err)
+	rawCPU := raw[corev1.ResourceCPU]
+	assert.Equal(t, int64(4000), rawCPU.MilliValue())
+}
+
+func TestAmplifyNodeAllocatable_RatioLessOrEqualOneUnchanged(t *testing.T) {
+	node := newAmplifyTestNode(
+		map[string]string{
+			AnnotationNodeResourceAmplificationRatio: `{"cpu":1,"memory":0.5}`,
+		},
+		corev1.ResourceList{
+			corev1.ResourceCPU:    resource.MustParse("4"),
+			corev1.ResourceMemory: resource.MustParse("2Gi"),
+		},
+	)
+
+	err := AmplifyNodeAllocatable(node)
+	assert.NoError(t, err)
+
+	gotCPU := node.Status.Allocatable[corev1.ResourceCPU]
+	gotMem := node.Status.Allocatable[corev1.ResourceMemory]
+	assert.Equal(t, int64(4000), gotCPU.MilliValue(), "ratio == 1 leaves cpu unchanged")
+	assert.Equal(t, mustValue("2Gi"), gotMem.Value(), "ratio < 1 leaves memory unchanged")
+}
+
+func TestAmplifyNodeAllocatable_OnlyCPUAndMemoryAmplified(t *testing.T) {
+	node := newAmplifyTestNode(
+		map[string]string{
+			AnnotationNodeResourceAmplificationRatio: `{"cpu":2,"nvidia.com/gpu":2}`,
+		},
+		corev1.ResourceList{
+			corev1.ResourceCPU:               resource.MustParse("4"),
+			corev1.ResourceName("nvidia.com/gpu"): resource.MustParse("4"),
+		},
+	)
+
+	err := AmplifyNodeAllocatable(node)
+	assert.NoError(t, err)
+
+	gotCPU := node.Status.Allocatable[corev1.ResourceCPU]
+	gotGPU := node.Status.Allocatable[corev1.ResourceName("nvidia.com/gpu")]
+	assert.Equal(t, int64(8000), gotCPU.MilliValue(), "cpu amplified by 2")
+	assert.Equal(t, int64(4), gotGPU.Value(), "gpu must not be amplified")
+}
+
+func TestAmplifyNodeAllocatable_MissingBaselineResourceUnchanged(t *testing.T) {
+
+	node := newAmplifyTestNode(
+		map[string]string{
+			AnnotationNodeResourceAmplificationRatio: `{"cpu":2,"memory":2}`,
+		},
+		corev1.ResourceList{
+			corev1.ResourceMemory: resource.MustParse("2Gi"),
+		},
+	)
+
+	err := AmplifyNodeAllocatable(node)
+	assert.NoError(t, err)
+
+	gotMem := node.Status.Allocatable[corev1.ResourceMemory]
+	assert.Equal(t, mustValue("4Gi"), gotMem.Value(), "memory amplified by 2")
+	_, hasCPU := node.Status.Allocatable[corev1.ResourceCPU]
+	assert.False(t, hasCPU, "cpu must not be introduced when it has no baseline")
+}
+
+func TestAmplifyNodeAllocatable_DisabledRemovesRawAndKeepsAllocatable(t *testing.T) {
+	node := newAmplifyTestNode(
+		map[string]string{
+			AnnotationNodeRawAllocatable: `{"cpu":"4"}`,
+			"other":                      "keep-me",
+		},
+		corev1.ResourceList{
+			corev1.ResourceCPU: resource.MustParse("6"),
+		},
+	)
+
+	err := AmplifyNodeAllocatable(node)
+	assert.NoError(t, err)
+
+
+	gotCPU := node.Status.Allocatable[corev1.ResourceCPU]
+	assert.Equal(t, int64(6000), gotCPU.MilliValue())
+
+
+	raw, err := GetNodeRawAllocatable(node.Annotations)
+	assert.NoError(t, err)
+	assert.Nil(t, raw)
+
+
+	assert.Equal(t, "keep-me", node.Annotations["other"])
+}
+
+func TestAmplifyNodeAllocatable_DisabledEmptyValue(t *testing.T) {
+	node := newAmplifyTestNode(
+		map[string]string{
+			AnnotationNodeResourceAmplificationRatio: "",
+			AnnotationNodeRawAllocatable:             `{"cpu":"4"}`,
+		},
+		corev1.ResourceList{
+			corev1.ResourceCPU: resource.MustParse("6"),
+		},
+	)
+
+	err := AmplifyNodeAllocatable(node)
+	assert.NoError(t, err)
+
+	gotCPU := node.Status.Allocatable[corev1.ResourceCPU]
+	assert.Equal(t, int64(6000), gotCPU.MilliValue())
+	raw, err := GetNodeRawAllocatable(node.Annotations)
+	assert.NoError(t, err)
+	assert.Nil(t, raw)
+}
+
+func TestAmplifyNodeAllocatable_NilAllocatable(t *testing.T) {
+	node := newAmplifyTestNode(
+		map[string]string{
+			AnnotationNodeResourceAmplificationRatio: `{"cpu":1.5}`,
+		},
+		nil,
+	)
+
+	err := AmplifyNodeAllocatable(node)
+	assert.NoError(t, err)
+	assert.Nil(t, node.Status.Allocatable)
+
+	raw, err := GetNodeRawAllocatable(node.Annotations)
+	assert.NoError(t, err)
+	assert.Nil(t, raw)
+}
+
+func TestAmplifyNodeAllocatable_MalformedRatioErrors(t *testing.T) {
+	node := newAmplifyTestNode(
+		map[string]string{
+			AnnotationNodeResourceAmplificationRatio: "not-json",
+		},
+		corev1.ResourceList{
+			corev1.ResourceCPU: resource.MustParse("4"),
+		},
+	)
+
+	err := AmplifyNodeAllocatable(node)
+	assert.Error(t, err)
+}
+
+func TestAmplifyNodeAllocatable_MalformedRawBaselineErrors(t *testing.T) {
+	node := newAmplifyTestNode(
+		map[string]string{
+			AnnotationNodeResourceAmplificationRatio: `{"cpu":1.5}`,
+			AnnotationNodeRawAllocatable:             "not-json",
+		},
+		corev1.ResourceList{
+			corev1.ResourceCPU: resource.MustParse("4"),
+		},
+	)
+
+	err := AmplifyNodeAllocatable(node)
+	assert.Error(t, err)
+}
