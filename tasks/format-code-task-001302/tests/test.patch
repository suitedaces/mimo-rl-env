+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+if ! mysql -u root -e "SELECT 1;" > /dev/null 2>&1; then
+    mysqld --user=root --daemonize 2>/dev/null
+    sleep 2
+fi
+
+mysql -u root -e "CREATE DATABASE IF NOT EXISTS goyave; CREATE USER IF NOT EXISTS 'goyave'@'127.0.0.1' IDENTIFIED BY 'secret'; GRANT ALL PRIVILEGES ON goyave.* TO 'goyave'@'127.0.0.1'; FLUSH PRIVILEGES;" 2>/dev/null
+mysql -u root -e "DROP DATABASE IF EXISTS goyave; CREATE DATABASE goyave; GRANT ALL PRIVILEGES ON goyave.* TO 'goyave'@'127.0.0.1'; FLUSH PRIVILEGES;" 2>/dev/null
+
+
+case "${1:-}" in
+  base)
+    go test ./database/ -run 'TestPaginatorTestSuite$' -v -count=1
+    ;;
+  new)
+    go test ./database/ -run 'TestPaginatorTestSuite/TestPaginatorWithPreload(UpdatesPageInfo|FindKeepsAssociations|PageInfoOnLaterPage)$' -v -count=1
