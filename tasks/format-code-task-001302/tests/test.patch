diff --git a/database/paginator_test.go b/database/paginator_test.go
index 31d8241..8a485ed 100644
--- a/database/paginator_test.go
+++ b/database/paginator_test.go
@@ -163,6 +163,119 @@ func (suite *PaginatorTestSuite) TestPaginatorRawQuery() {
 	}
 }
 
+type paginatorPreloadParent struct {
+	ID       uint `gorm:"primaryKey"`
+	Name     string
+	Segment  string
+	Children []paginatorPreloadChild `gorm:"foreignKey:ParentID"`
+}
+
+type paginatorPreloadChild struct {
+	ID       uint `gorm:"primaryKey"`
+	ParentID uint
+	Label    string
+}
+
+func (suite *PaginatorTestSuite) preparePaginatorPreloadFixtures() *gorm.DB {
+	db := GetConnection()
+	_ = db.Migrator().DropTable(&paginatorPreloadChild{}, &paginatorPreloadParent{})
+	suite.NoError(db.AutoMigrate(&paginatorPreloadParent{}, &paginatorPreloadChild{}))
+	suite.T().Cleanup(func() {
+		_ = db.Migrator().DropTable(&paginatorPreloadChild{}, &paginatorPreloadParent{})
+	})
+	return db
+}
+
+func (suite *PaginatorTestSuite) seedPaginatorPreloadFixtures(db *gorm.DB) {
+	parents := []paginatorPreloadParent{
+		{Name: "included-1", Segment: "included", Children: []paginatorPreloadChild{{Label: "child-1-a"}, {Label: "child-1-b"}}},
+		{Name: "included-2", Segment: "included", Children: []paginatorPreloadChild{{Label: "child-2-a"}, {Label: "child-2-b"}}},
+		{Name: "included-3", Segment: "included", Children: []paginatorPreloadChild{{Label: "child-3-a"}, {Label: "child-3-b"}}},
+		{Name: "included-4", Segment: "included", Children: []paginatorPreloadChild{{Label: "child-4-a"}, {Label: "child-4-b"}}},
+		{Name: "included-5", Segment: "included", Children: []paginatorPreloadChild{{Label: "child-5-a"}, {Label: "child-5-b"}}},
+		{Name: "excluded-1", Segment: "excluded", Children: []paginatorPreloadChild{{Label: "excluded-1"}}},
+		{Name: "excluded-2", Segment: "excluded", Children: []paginatorPreloadChild{{Label: "excluded-2"}}},
+		{Name: "excluded-3", Segment: "excluded", Children: []paginatorPreloadChild{{Label: "excluded-3"}}},
+	}
+	suite.NoError(db.Create(&parents).Error)
+}
+
+func (suite *PaginatorTestSuite) TestPaginatorWithPreloadUpdatesPageInfo() {
+	db := suite.preparePaginatorPreloadFixtures()
+	suite.seedPaginatorPreloadFixtures(db)
+
+	results := []paginatorPreloadParent{}
+	query := db.Model(&paginatorPreloadParent{}).
+		Where("segment = ?", "included").
+		Preload("Children").
+		Order("id ASC")
+
+	paginator := NewPaginator(query, 2, 2, &results)
+
+	suite.NotPanics(func() {
+		paginator.UpdatePageInfo()
+	})
+	suite.Equal(int64(5), paginator.Total)
+	suite.Equal(int64(3), paginator.MaxPage)
+}
+
+func (suite *PaginatorTestSuite) TestPaginatorWithPreloadFindKeepsAssociations() {
+	db := suite.preparePaginatorPreloadFixtures()
+	suite.seedPaginatorPreloadFixtures(db)
+
+	results := []paginatorPreloadParent{}
+	query := db.Model(&paginatorPreloadParent{}).
+		Where("segment = ?", "included").
+		Preload("Children").
+		Order("id ASC")
+
+	paginator := NewPaginator(query, 2, 2, &results)
+
+	suite.NotPanics(func() {
+		paginator.Find()
+	})
+	suite.Len(results, 2)
+	suite.Equal("included-3", results[0].Name)
+	suite.Equal("included", results[0].Segment)
+	suite.Len(results[0].Children, 2)
+	suite.Equal("child-3-a", results[0].Children[0].Label)
+	suite.Equal("included-4", results[1].Name)
+	suite.Equal("included", results[1].Segment)
+	suite.Len(results[1].Children, 2)
+	suite.Equal("child-4-a", results[1].Children[0].Label)
+	suite.Equal(int64(5), paginator.Total)
+	suite.Equal(int64(3), paginator.MaxPage)
+}
+
+
+func (suite *PaginatorTestSuite) TestPaginatorWithPreloadPageInfoOnLaterPage() {
+	const userCount = 10
+	users := make([]User, 0, userCount)
+	for i := 0; i < userCount; i++ {
+		users = append(users, User{strconv.Itoa(i), "johndoe@example.org", 0})
+	}
+
+	db := GetConnection()
+	if err := db.Create(users).Error; err != nil {
+		panic(err)
+	}
+	defer func() {
+		if err := db.Unscoped().Session(&gorm.Session{AllowGlobalUpdate: true}).Delete(&User{}).Error; err != nil {
+			panic(err)
+		}
+	}()
+
+	results := []User{}
+	query := db.Preload("relation")
+	paginator := NewPaginator(query, 2, 5, &results)
+
+	suite.NotPanics(func() {
+		paginator.UpdatePageInfo()
+	})
+	suite.Equal(int64(10), paginator.Total)
+	suite.Equal(int64(2), paginator.MaxPage)
+}
+
