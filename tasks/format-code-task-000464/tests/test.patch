diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,246 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+export GOTOOLCHAIN=local
+export GOPROXY=off
+export GOSUMDB=off
+
+( cd /workspace/repo && make build ) >/dev/null \
+  || { echo "FAIL: build" >&2; exit 1; }
+BIN=/workspace/repo/asdf
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+export HOME="$TMP/home"
+export ASDF_DATA_DIR="$TMP/asdf-data"
+export ASDF_CONFIG_FILE="$TMP/asdfrc"
+unset ASDF_TOOL_VERSIONS_FILENAME ASDF_DEFAULT_TOOL_VERSIONS_FILENAME
+mkdir -p "$HOME" "$ASDF_DATA_DIR"
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+run_asdf() {
+  "$BIN" "$@" >out 2>err
+  ec=$?
+}
+
+assert_empty_stdout() {
+  [ ! -s out ] || fail "$1 stdout: $(cat out)"
+}
+
+assert_empty_stderr() {
+  [ ! -s err ] || fail "$1 stderr: $(cat err)"
+}
+
+assert_success_stderr_unspecified() {
+
+  :
+}
+
+assert_failure_stdout_unspecified() {
+
+  :
+}
+
+assert_stdout_literal() {
+  printf '%s' "$2" > "$TMP/expected"
+  cmp -s out "$TMP/expected" || fail "$1 stdout: $(cat out)"
+}
+
+assert_stderr_literal() {
+  printf '%s' "$2" > "$TMP/expected"
+  cmp -s err "$TMP/expected" || fail "$1 stderr: $(cat err)"
+}
+
+assert_file_literal() {
+  printf '%s' "$3" > "$TMP/expected"
+  cmp -s "$2" "$TMP/expected" || fail "$1 file $2: $(cat "$2")"
+}
+
+
+
+
+mkdir -p "$TMP/f1"
+cd "$TMP/f1" || exit 1
+run_asdf set lua 5.2.3
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_empty_stdout F1
+assert_success_stderr_unspecified F1
+assert_file_literal F1 .tool-versions $'lua 5.2.3\n'
+[ "$(wc -c < .tool-versions)" -eq 10 ] || fail "F1 file should include trailing newline"
+
+
+
+
+mkdir -p "$TMP/f2"
+cd "$TMP/f2" || exit 1
+printf 'lua 1.1.1\n' > .tool-versions
+run_asdf set lua 5.2.3
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_empty_stdout F2
+assert_success_stderr_unspecified F2
+assert_file_literal F2 .tool-versions $'lua 5.2.3\n'
+
+
+
+
+mkdir -p "$TMP/f3"
+cd "$TMP/f3" || exit 1
+printf 'nodejs 20.11.1\n# keep this note\n' > .tool-versions
+run_asdf set lua 5.2.3
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+assert_empty_stdout F3
+assert_success_stderr_unspecified F3
+assert_file_literal F3 .tool-versions $'nodejs 20.11.1\n# keep this note\nlua 5.2.3\n'
+
+
+
+
+mkdir -p "$TMP/f4"
+cd "$TMP/f4" || exit 1
+printf 'lua 1.1.1 # production lua\n# unrelated note\nruby 3.3.0 # ruby stays\n' > .tool-versions
+run_asdf set lua 5.2.3
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+assert_empty_stdout F4
+assert_success_stderr_unspecified F4
+assert_file_literal F4 .tool-versions $'lua 5.2.3 # production lua\n# unrelated note\nruby 3.3.0 # ruby stays\n'
+
+
+
+
+mkdir -p "$TMP/f5"
+cd "$TMP/f5" || exit 1
+run_asdf set python 3.12.1 3.11.8
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+assert_empty_stdout F5
+assert_success_stderr_unspecified F5
+assert_file_literal F5 .tool-versions $'python 3.12.1 3.11.8\n'
+
+
+
+
+mkdir -p "$TMP/f6"
+cd "$TMP/f6" || exit 1
+run_asdf set custom system ref:v1 path:/opt/custom
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+assert_empty_stdout F6
+assert_success_stderr_unspecified F6
+assert_file_literal F6 .tool-versions $'custom system ref:v1 path:/opt/custom\n'
+
+
+
+
+mkdir -p "$TMP/f7/work"
+cd "$TMP/f7/work" || exit 1
+run_asdf set --home lua 5.2.3
+[ "$ec" -eq 0 ] || fail "F7a exit $ec; want 0"
+assert_empty_stdout F7a
+assert_success_stderr_unspecified F7a
+assert_file_literal F7a "$HOME/.tool-versions" $'lua 5.2.3\n'
+[ ! -e .tool-versions ] || fail "F7a should not write current directory file"
+run_asdf set -u lua 5.2.4
+[ "$ec" -eq 0 ] || fail "F7b exit $ec; want 0"
+assert_empty_stdout F7b
+assert_success_stderr_unspecified F7b
+assert_file_literal F7b "$HOME/.tool-versions" $'lua 5.2.4\n'
+
+
+
+
+mkdir -p "$TMP/f8/root/sub/deep"
+printf 'nodejs 18.0.0\nlua 1.1.1 # parent comment\n' > "$TMP/f8/root/.tool-versions"
+printf 'lua 9.9.9\n' > "$TMP/f8/root/sub/.tool-versions"
+cd "$TMP/f8/root/sub/deep" || exit 1
+run_asdf set --parent lua 5.2.3
+[ "$ec" -eq 0 ] || fail "F8a exit $ec; want 0"
+assert_empty_stdout F8a
+assert_success_stderr_unspecified F8a
+assert_file_literal F8a "$TMP/f8/root/sub/.tool-versions" $'lua 5.2.3\n'
+assert_file_literal F8a-higher "$TMP/f8/root/.tool-versions" $'nodejs 18.0.0\nlua 1.1.1 # parent comment\n'
+rm "$TMP/f8/root/sub/.tool-versions"
+run_asdf set -p ruby 3.3.1
+[ "$ec" -eq 0 ] || fail "F8b exit $ec; want 0"
+assert_empty_stdout F8b
+assert_success_stderr_unspecified F8b
+assert_file_literal F8b "$TMP/f8/root/.tool-versions" $'nodejs 18.0.0\nlua 1.1.1 # parent comment\nruby 3.3.1\n'
+
+
+
+
+mkdir -p "$TMP/f9"
+cd "$TMP/f9" || exit 1
+run_asdf set
+[ "$ec" -ne 0 ] || fail "F9a exit $ec; want non-zero"
+assert_failure_stdout_unspecified F9a
+assert_stderr_literal F9a $'tool and version must be provided as arguments\n'
+run_asdf set lua
+[ "$ec" -ne 0 ] || fail "F9b exit $ec; want non-zero"
+assert_failure_stdout_unspecified F9b
+assert_stderr_literal F9b $'version must be provided as an argument\n'
+run_asdf set --home --parent lua 5.2.3
+[ "$ec" -ne 0 ] || fail "F9c exit $ec; want non-zero"
+assert_failure_stdout_unspecified F9c
+assert_stderr_literal F9c $'home and parent flags cannot both be specified; must be one location or the other\n'
+run_asdf set -u -p lua 5.2.3
+[ "$ec" -ne 0 ] || fail "F9d exit $ec; want non-zero"
+assert_failure_stdout_unspecified F9d
+assert_stderr_literal F9d $'home and parent flags cannot both be specified; must be one location or the other\n'
+
+
+
+
+mkdir -p "$TMP/f10/a/b"
+cd "$TMP/f10/a/b" || exit 1
+run_asdf set --parent lua 5.2.3
+[ "$ec" -ne 0 ] || fail "F10 exit $ec; want non-zero"
+assert_failure_stdout_unspecified F10
+assert_stderr_literal F10 $'No .tool-versions version file found in parent directory\n'
+[ ! -e .tool-versions ] || fail "F10 should not create current directory file"
+
+
+
+
+mkdir -p "$ASDF_DATA_DIR/plugins/elixir/bin" "$TMP/f11"
+cat > "$ASDF_DATA_DIR/plugins/elixir/bin/latest-stable" <<'PLUGIN'
+#!/usr/bin/env bash
+case "${1-}" in
+  1.15) printf '1.15.9\n' ;;
+  '') printf '1.16.3\n' ;;
+  *) exit 1 ;;
+esac
+PLUGIN
+chmod +x "$ASDF_DATA_DIR/plugins/elixir/bin/latest-stable"
+cd "$TMP/f11" || exit 1
+run_asdf set elixir latest
+[ "$ec" -eq 0 ] || fail "F11a exit $ec; want 0"
+assert_empty_stdout F11a
+assert_success_stderr_unspecified F11a
+assert_file_literal F11a .tool-versions $'elixir 1.16.3\n'
+run_asdf set elixir latest:1.15
+[ "$ec" -eq 0 ] || fail "F11b exit $ec; want 0"
+assert_empty_stdout F11b
+assert_success_stderr_unspecified F11b
+assert_file_literal F11b .tool-versions $'elixir 1.15.9\n'
+
+
+
+
+mkdir -p "$ASDF_DATA_DIR/plugins/empty/bin" "$TMP/f12"
+cat > "$ASDF_DATA_DIR/plugins/empty/bin/latest-stable" <<'PLUGIN'
+#!/usr/bin/env bash
+exit 0
+PLUGIN
+chmod +x "$ASDF_DATA_DIR/plugins/empty/bin/latest-stable"
+cd "$TMP/f12" || exit 1
+printf 'empty 0.0.1\n' > .tool-versions
+run_asdf set empty latest
+[ "$ec" -ne 0 ] || fail "F12 exit $ec; want non-zero"
+assert_failure_stdout_unspecified F12
+assert_file_literal F12 .tool-versions $'empty 0.0.1\n'
+! grep -q 'latest' .tool-versions || fail "F12 wrote unresolved latest token"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+
+export GOTOOLCHAIN=local
+export GOPROXY=off
+export GOSUMDB=off
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
