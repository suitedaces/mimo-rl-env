+func TestCodespecMetadataClientVersionSelection(t *testing.T) {
+	cases := []struct {
+		name  string
+		kafka KafkaVersion
+		want  int16
+	}{
+		{"pre-0.10", V0_9_0_1, 0},
+		{"0.10", V0_10_0_0, 1},
+		{"0.11", V0_11_0_2, 1},
+		{"1.0", V1_0_0_0, 5},
+		{"1.1", V1_1_1_0, 5},
+		{"2.0", V2_0_0_0, 6},
+		{"2.1", V2_1_0_0, 7},
+		{"2.2", V2_2_0_0, 7},
+		{"2.3", V2_3_0_0, 8},
+		{"2.4", V2_4_0_0, 8},
+	}
+	for i, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			mock := NewMockBroker(t, int32(100+i))
+			defer mock.Close()
+			mock.SetHandlerByMap(map[string]MockResponse{
+				"MetadataRequest": NewMockMetadataResponse(t),
+			})
+			config := NewConfig()
+			config.Version = tc.kafka
+			config.Metadata.Retry.Max = 0
+			client, err := NewClient([]string{mock.Addr()}, config)
+			if err != nil {
+				t.Fatalf("NewClient: %v", err)
+			}
+			defer safeClose(t, client)
+
+			requests := codespecMetadataRequests(mock.History())
+			if len(requests) == 0 {
+				t.Fatal("client sent no metadata request")
+			}
+			got := requests[0]
+			if got.Version != tc.want {
+				t.Errorf("Kafka %s client metadata version = %d; want %d", tc.name, got.Version, tc.want)
+			}
+			if tc.want == 8 {
+				if value := codespecExportedField(t, got, "IncludeClusterAuthorizedOperations"); value != false {
+					t.Errorf("client requested cluster authorized operations: %v", value)
+				}
+				if value := codespecExportedField(t, got, "IncludeTopicAuthorizedOperations"); value != false {
+					t.Errorf("client requested topic authorized operations: %v", value)
+				}
+			}
+		})
+	}
+}
+
+func codespecMetadataRequests(history []RequestResponse) []*MetadataRequest {
+	var requests []*MetadataRequest
+	for _, exchange := range history {
+		if request, ok := exchange.Request.(*MetadataRequest); ok {
+			requests = append(requests, request)
+		}
+	}
+	return requests
+}
