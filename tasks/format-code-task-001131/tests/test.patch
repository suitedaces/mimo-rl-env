+func TestCodespecMetadataResponseV7LeaderEpoch(t *testing.T) {
+	wire := []byte{
+		0x00, 0x00, 0x00, 0x05,
+		0x00, 0x00, 0x00, 0x00,
+		0xff, 0xff,
+		0x00, 0x00, 0x00, 0x02,
+		0x00, 0x00, 0x00, 0x01,
+		0x00, 0x00,
+		0x00, 0x03, 'f', 'o', 'o',
+		0x00,
+		0x00, 0x00, 0x00, 0x01,
+		0x00, 0x04,
+		0x00, 0x00, 0x00, 0x01,
+		0x00, 0x00, 0x00, 0x07,
+		0x00, 0x00, 0x00, 0x09,
+		0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x02,
+		0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01,
+		0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x02,
+	}
+	response := &MetadataResponse{}
+	if err := versionedDecode(wire, response, 7); err != nil {
+		t.Fatalf("decode v7 response: %v", err)
+	}
+	if len(response.Topics) != 1 || len(response.Topics[0].Partitions) != 1 {
+		t.Fatalf("decoded v7 topics = %#v", response.Topics)
+	}
+	partition := response.Topics[0].Partitions[0]
+	if got := codespecExportedField(t, partition, "LeaderEpoch"); got != int32(9) {
+		t.Errorf("decoded LeaderEpoch = %v; want 9", got)
+	}
+	if got := codespecEncodeBody(t, response); !bytes.Equal(got, wire) {
+		t.Errorf("re-encoded v7 response = %v; want %v", got, wire)
+	}
+}
