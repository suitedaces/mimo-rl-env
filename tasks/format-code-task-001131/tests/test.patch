+func TestCodespecMetadataRequestVersionsAndFlags(t *testing.T) {
+	legacyBody := []byte{0xff, 0xff, 0xff, 0xff, 0x01}
+	for _, version := range []int16{6, 7} {
+		req := &MetadataRequest{Version: version, AllowAutoTopicCreation: true}
+		got := codespecEncodeBody(t, req)
+		if !bytes.Equal(got, legacyBody) {
+			t.Errorf("metadata request v%d body = %v; want v5-compatible %v", version, got, legacyBody)
+		}
+		decoded := &MetadataRequest{}
+		if err := versionedDecode(got, decoded, version); err != nil {
+			t.Fatalf("decode metadata request v%d: %v", version, err)
+		}
+		if !reflect.DeepEqual(decoded, req) {
+			t.Errorf("metadata request v%d round trip = %#v; want %#v", version, decoded, req)
+		}
+	}
+
+	flagCases := []struct {
+		name         string
+		clusterFlag  bool
+		topicFlag    bool
+		trailingWire []byte
+	}{
+		{"cluster-only", true, false, []byte{0x01, 0x00}},
+		{"topic-only", false, true, []byte{0x00, 0x01}},
+	}
+	for _, tc := range flagCases {
+		t.Run(tc.name, func(t *testing.T) {
+			req := &MetadataRequest{Version: 8, Topics: []string{"orders"}}
+			codespecSetExportedField(t, req, "IncludeClusterAuthorizedOperations", tc.clusterFlag)
+			codespecSetExportedField(t, req, "IncludeTopicAuthorizedOperations", tc.topicFlag)
+			wantV8 := append([]byte{
+				0x00, 0x00, 0x00, 0x01,
+				0x00, 0x06, 'o', 'r', 'd', 'e', 'r', 's',
+				0x00,
+			}, tc.trailingWire...)
+			encoded := codespecEncodeBody(t, req)
+			if !bytes.Equal(encoded, wantV8) {
+				t.Fatalf("metadata request v8 body = %v; want %v", encoded, wantV8)
+			}
+
+			decoded := &MetadataRequest{}
+			if err := versionedDecode(encoded, decoded, 8); err != nil {
+				t.Fatalf("decode v8 request: %v", err)
+			}
+			if !reflect.DeepEqual(decoded.Topics, []string{"orders"}) || decoded.AllowAutoTopicCreation {
+				t.Fatalf("decoded v8 base fields = %#v", decoded)
+			}
+			if got := codespecExportedField(t, decoded, "IncludeClusterAuthorizedOperations"); got != tc.clusterFlag {
+				t.Errorf("decoded IncludeClusterAuthorizedOperations = %v; want %v", got, tc.clusterFlag)
+			}
+			if got := codespecExportedField(t, decoded, "IncludeTopicAuthorizedOperations"); got != tc.topicFlag {
+				t.Errorf("decoded IncludeTopicAuthorizedOperations = %v; want %v", got, tc.topicFlag)
+			}
+		})
+	}
+
+	if _, err := encode(&MetadataRequest{Version: 9}, nil); err == nil {
+		t.Error("metadata request v9 encoded successfully; versions above 8 must remain unsupported")
+	}
+}
