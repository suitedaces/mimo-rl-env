+func TestCodespecMetadataResponseV6Compatibility(t *testing.T) {
+	wire := []byte{
+		0x00, 0x00, 0x00, 0x05,
+		0x00, 0x00, 0x00, 0x00,
+		0x00, 0x09, 'c', 'l', 'u', 's', 't', 'e', 'r', 'I', 'd',
+		0x00, 0x00, 0x00, 0x02,
+		0x00, 0x00, 0x00, 0x00,
+	}
+	response := &MetadataResponse{}
+	if err := versionedDecode(wire, response, 6); err != nil {
+		t.Fatalf("decode v6 response: %v", err)
+	}
+	if response.Version != 6 || response.ThrottleTimeMs != 5 || response.ControllerID != 2 || response.ClusterID == nil || *response.ClusterID != "clusterId" {
+		t.Fatalf("decoded v6 response = %#v", response)
+	}
+	if got := codespecEncodeBody(t, response); !bytes.Equal(got, wire) {
+		t.Errorf("re-encoded v6 response = %v; want %v", got, wire)
+	}
+}
