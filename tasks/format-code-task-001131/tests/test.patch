+func TestCodespecMetadataResponseV8AuthorizedOperations(t *testing.T) {
+	wire := []byte{
+		0x00, 0x00, 0x00, 0x03,
+		0x00, 0x00, 0x00, 0x00,
+		0xff, 0xff,
+		0x00, 0x00, 0x00, 0x02,
+		0x01, 0x02, 0x03, 0x04,
+		0x00, 0x00, 0x00, 0x01,
+		0x00, 0x00,
+		0x00, 0x03, 'f', 'o', 'o',
+		0x01,
+		0x00, 0x00, 0x00, 0x01,
+		0x00, 0x00,
+		0x00, 0x00, 0x00, 0x03,
+		0x00, 0x00, 0x00, 0x05,
+		0x00, 0x00, 0x00, 0x0b,
+		0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x05,
+		0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x05,
+		0x00, 0x00, 0x00, 0x00,
+		0x80, 0x00, 0x00, 0x00,
+	}
+	response := &MetadataResponse{}
+	if err := versionedDecode(wire, response, 8); err != nil {
+		t.Fatalf("decode v8 response: %v", err)
+	}
+	if got := codespecExportedField(t, response, "ClusterAuthorizedOperations"); got != int32(0x01020304) {
+		t.Errorf("decoded ClusterAuthorizedOperations = %v; want 0x01020304", got)
+	}
+	if len(response.Topics) != 1 || !response.Topics[0].IsInternal {
+		t.Fatalf("decoded v8 topics = %#v", response.Topics)
+	}
+	if len(response.Topics[0].Partitions) != 1 {
+		t.Fatalf("decoded v8 partitions = %#v", response.Topics[0].Partitions)
+	}
+	if got := codespecExportedField(t, response.Topics[0].Partitions[0], "LeaderEpoch"); got != int32(11) {
+		t.Errorf("decoded v8 LeaderEpoch = %v; want 11", got)
+	}
+	if got := codespecExportedField(t, response.Topics[0], "TopicAuthorizedOperations"); got != int32(-2147483648) {
+		t.Errorf("decoded TopicAuthorizedOperations = %v; want -2147483648", got)
+	}
+	if got := codespecEncodeBody(t, response); !bytes.Equal(got, wire) {
+		t.Errorf("re-encoded v8 response = %v; want %v", got, wire)
+	}
+}
