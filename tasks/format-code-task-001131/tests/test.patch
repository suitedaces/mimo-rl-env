+func codespecSetExportedField(t *testing.T, target interface{}, name string, value interface{}) {
+	t.Helper()
+	v := reflect.ValueOf(target)
+	if v.Kind() != reflect.Ptr || v.IsNil() {
+		t.Fatalf("%s target must be a non-nil pointer", name)
+	}
+	f := v.Elem().FieldByName(name)
+	if !f.IsValid() || !f.CanSet() {
+		t.Fatalf("%T must expose a settable public field named %s", target, name)
+	}
+	want := reflect.ValueOf(value)
+	if !want.Type().AssignableTo(f.Type()) {
+		t.Fatalf("%T.%s has type %s; want %s", target, name, f.Type(), want.Type())
+	}
+	f.Set(want)
+}
+
+func codespecExportedField(t *testing.T, target interface{}, name string) interface{} {
+	t.Helper()
+	v := reflect.ValueOf(target)
+	if v.Kind() == reflect.Ptr {
+		if v.IsNil() {
+			t.Fatalf("cannot inspect %s on nil %T", name, target)
+		}
+		v = v.Elem()
+	}
+	f := v.FieldByName(name)
+	if !f.IsValid() || !f.CanInterface() {
+		t.Fatalf("%T must expose a public field named %s", target, name)
+	}
+	return f.Interface()
+}
+
+func codespecEncodeBody(t *testing.T, body encoder) []byte {
+	t.Helper()
+	encoded, err := encode(body, nil)
+	if err != nil {
+		t.Fatalf("encode failed: %v", err)
+	}
+	return encoded
+}
