+func TestCodespecMetadataAdminVersionSelection(t *testing.T) {
+	cases := []struct {
+		name  string
+		kafka KafkaVersion
+		want  int16
+	}{
+		{"1.0", V1_0_0_0, 5},
+		{"1.1", V1_1_1_0, 5},
+		{"2.0", V2_0_0_0, 6},
+		{"2.1", V2_1_0_0, 7},
+		{"2.2", V2_2_0_0, 7},
+		{"2.3", V2_3_0_0, 8},
+		{"2.4", V2_4_0_0, 8},
+	}
+	for caseIndex, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			mock := NewMockBroker(t, int32(200+caseIndex))
+			defer mock.Close()
+			mock.SetHandlerByMap(map[string]MockResponse{
+				"MetadataRequest": NewMockMetadataResponse(t).
+					SetController(mock.BrokerID()).
+					SetBroker(mock.Addr(), mock.BrokerID()),
+			})
+			config := NewConfig()
+			config.Version = tc.kafka
+			config.Metadata.Retry.Max = 0
+			admin, err := NewClusterAdmin([]string{mock.Addr()}, config)
+			if err != nil {
+				t.Fatalf("NewClusterAdmin: %v", err)
+			}
+			defer safeClose(t, admin)
+			if _, err := admin.DescribeTopics([]string{"orders"}); err != nil {
+				t.Fatalf("DescribeTopics: %v", err)
+			}
+			if _, _, err := admin.DescribeCluster(); err != nil {
+				t.Fatalf("DescribeCluster: %v", err)
+			}
+
+			requests := codespecMetadataRequests(mock.History())
+			if len(requests) != 3 {
+				t.Fatalf("metadata request count = %d; want initial refresh plus two admin calls", len(requests))
+			}
+			for i, request := range requests {
+				if request.Version != tc.want {
+					t.Errorf("metadata request %d version = %d; want %d", i, request.Version, tc.want)
+				}
+				if tc.want == 8 {
+					if value := codespecExportedField(t, request, "IncludeClusterAuthorizedOperations"); value != false {
+						t.Errorf("metadata request %d cluster flag = %v; want false", i, value)
+					}
+					if value := codespecExportedField(t, request, "IncludeTopicAuthorizedOperations"); value != false {
+						t.Errorf("metadata request %d topic flag = %v; want false", i, value)
+					}
+				}
+			}
+		})
+	}
+}
