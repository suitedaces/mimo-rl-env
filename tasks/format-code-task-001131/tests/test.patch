+func TestCodespecMetadataRequestMinimumBrokerVersions(t *testing.T) {
+	cases := []struct {
+		name          string
+		request       int16
+		brokerVersion KafkaVersion
+	}{
+		{"v6-before-2.0", 6, V1_1_1_0},
+		{"v7-before-2.1", 7, V2_0_1_0},
+		{"v8-before-2.3", 8, V2_2_0_0},
+	}
+	for i, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			mock := NewMockBroker(t, int32(50+i))
+			defer mock.Close()
+			mock.SetHandlerByMap(map[string]MockResponse{
+				"MetadataRequest": NewMockMetadataResponse(t),
+			})
+			broker := NewBroker(mock.Addr())
+			config := NewConfig()
+			config.Version = tc.brokerVersion
+			if err := broker.Open(config); err != nil {
+				t.Fatalf("open broker: %v", err)
+			}
+			defer safeClose(t, broker)
+			if _, err := broker.GetMetadata(&MetadataRequest{Version: tc.request}); err != ErrUnsupportedVersion {
+				t.Errorf("metadata v%d against Kafka %s returned %v; want ErrUnsupportedVersion", tc.request, tc.name, err)
+			}
+		})
+	}
+}
