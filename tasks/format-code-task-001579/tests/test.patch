+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test -count=1 -v \
+      github.com/iotaledger/goshimmer/dapps/valuetransfers/packages/branchmanager \
+      github.com/iotaledger/goshimmer/dapps/valuetransfers/packages/test \
+      github.com/iotaledger/goshimmer/packages/binary/messagelayer/messagefactory \
+      github.com/iotaledger/goshimmer/packages/binary/messagelayer/tangle \
+      github.com/iotaledger/goshimmer/packages/binary/messagelayer/test
+    ;;
+  new)
+    go test -count=1 -v -run '^(TestSomething|TestTangle_ValueTransfer|TestNewAcceptsGenericInMemoryStore|TestValueTangleUsesProvidedStoreForSnapshot|TestBranchManagerUsesProvidedStoreForBranches|TestMessageFactory_BuildMessage|TestMessageFactorySequencePersistsInProvidedStore|TestTangle_AttachMessage|TestMessage_MarshalUnmarshal|TestNewMemDBDoesNotCreateDefaultDatabaseDirectory)$' \
+      github.com/iotaledger/goshimmer/dapps/valuetransfers/packages/branchmanager \
+      github.com/iotaledger/goshimmer/dapps/valuetransfers/packages/test \
+      github.com/iotaledger/goshimmer/dapps/valuetransfers/packages/tangle \
+      github.com/iotaledger/goshimmer/packages/database \
+      github.com/iotaledger/goshimmer/packages/binary/messagelayer/messagefactory \
+      github.com/iotaledger/goshimmer/packages/binary/messagelayer/tangle \
+      github.com/iotaledger/goshimmer/packages/binary/messagelayer/test
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
