+package test
+
+import (
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/iotaledger/goshimmer/dapps/valuetransfers/packages/address"
+	"github.com/iotaledger/goshimmer/dapps/valuetransfers/packages/balance"
+	"github.com/iotaledger/goshimmer/dapps/valuetransfers/packages/branchmanager"
+	valueTangle "github.com/iotaledger/goshimmer/dapps/valuetransfers/packages/tangle"
+	"github.com/iotaledger/goshimmer/dapps/valuetransfers/packages/transaction"
+	"github.com/iotaledger/hive.go/kvstore"
+	"github.com/stretchr/testify/require"
+)
+
+func TestValueTangleUsesProvidedStoreForSnapshot(t *testing.T) {
+	store := newSharedKVStore()
+	addr := address.Random()
+	txID := transaction.RandomID()
+
+	first := valueTangle.New(store)
+	require.NoError(t, first.Prune())
+	first.LoadSnapshot(map[transaction.ID]map[address.Address][]*balance.Balance{
+		txID: {
+			addr: []*balance.Balance{balance.New(balance.ColorIOTA, 1337)},
+		},
+	})
+	first.Shutdown()
+
+	second := valueTangle.New(store)
+	defer second.Shutdown()
+	require.EqualValues(t, 1337, valueTangle.NewLedgerState(second).Balances(addr)[balance.ColorIOTA])
+
+	isolated := valueTangle.New(newSharedKVStore())
+	defer isolated.Shutdown()
+	require.Zero(t, valueTangle.NewLedgerState(isolated).Balances(addr)[balance.ColorIOTA])
+}
+
+func TestBranchManagerUsesProvidedStoreForBranches(t *testing.T) {
+	store := newSharedKVStore()
+	first := branchmanager.New(store)
+	require.GreaterOrEqual(t, store.realmCount(), 4)
+
+	branchID := branchmanager.BranchID{42}
+	conflictID := branchmanager.ConflictID(transaction.OutputID{9})
+
+	cachedBranch, created := first.Fork(branchID, []branchmanager.BranchID{branchmanager.MasterBranchID}, []branchmanager.ConflictID{conflictID})
+	require.True(t, created)
+	cachedBranch.Release()
+
+	loaded := first.Branch(branchID).Consume(func(branch *branchmanager.Branch) {
+		require.Equal(t, branchID, branch.ID())
+	})
+	require.True(t, loaded)
+
+	foundMember := false
+	first.ConflictMembers(conflictID).Consume(func(member *branchmanager.ConflictMember) {
+		if member.BranchID() == branchID {
+			foundMember = true
+		}
+	})
+	require.True(t, foundMember)
+
+	isolated := branchmanager.New(newSharedKVStore())
+	require.False(t, isolated.Branch(branchID).Consume(func(branch *branchmanager.Branch) {}))
+}
+
+type sharedKVStore struct {
+	mu    *sync.RWMutex
+	data  map[string][]byte
+	realm []byte
+	seen  *[][]byte
+}
+
+func newSharedKVStore() *sharedKVStore {
+	return &sharedKVStore{
+		mu:   &sync.RWMutex{},
+		data: make(map[string][]byte),
+		seen: &[][]byte{},
+	}
+}
+
+func (store *sharedKVStore) WithRealm(realm kvstore.Realm) kvstore.KVStore {
+	store.mu.Lock()
+	*store.seen = append(*store.seen, append([]byte{}, realm...))
+	store.mu.Unlock()
+
+	return &sharedKVStore{
+		mu:    store.mu,
+		data:  store.data,
+		realm: append([]byte{}, realm...),
+		seen:  store.seen,
+	}
+}
+
+func (store *sharedKVStore) realmCount() int {
+	store.mu.RLock()
+	defer store.mu.RUnlock()
+
+	return len(*store.seen)
+}
+
+func (store *sharedKVStore) Realm() kvstore.Realm {
+	return append([]byte{}, store.realm...)
+}
+
+func (store *sharedKVStore) Iterate(prefix kvstore.KeyPrefix, consumer kvstore.IteratorKeyValueConsumerFunc) error {
+	store.mu.RLock()
+	defer store.mu.RUnlock()
+
+	fullPrefix := store.scopedKey(prefix)
+	for key, value := range store.data {
+		if strings.HasPrefix(key, fullPrefix) {
+			if !consumer([]byte(key[len(store.realmPrefix()):]), append([]byte{}, value...)) {
+				break
+			}
+		}
+	}
+	return nil
+}
+
+func (store *sharedKVStore) IterateKeys(prefix kvstore.KeyPrefix, consumer kvstore.IteratorKeyConsumerFunc) error {
+	return store.Iterate(prefix, func(key kvstore.Key, value kvstore.Value) bool {
+		return consumer(key)
+	})
+}
+
+func (store *sharedKVStore) Clear() error {
+	store.mu.Lock()
+	defer store.mu.Unlock()
+
+	realmPrefix := store.realmPrefix()
+	for key := range store.data {
+		if strings.HasPrefix(key, realmPrefix) {
+			delete(store.data, key)
+		}
+	}
+	return nil
+}
+
+func (store *sharedKVStore) Get(key kvstore.Key) (kvstore.Value, error) {
+	store.mu.RLock()
+	defer store.mu.RUnlock()
+
+	value, exists := store.data[store.scopedKey(key)]
+	if !exists {
+		return nil, kvstore.ErrKeyNotFound
+	}
+	return append([]byte{}, value...), nil
+}
+
+func (store *sharedKVStore) Set(key kvstore.Key, value kvstore.Value) error {
+	store.mu.Lock()
+	defer store.mu.Unlock()
+
+	store.data[store.scopedKey(key)] = append([]byte{}, value...)
+	return nil
+}
+
+func (store *sharedKVStore) Has(key kvstore.Key) (bool, error) {
+	store.mu.RLock()
+	defer store.mu.RUnlock()
+
+	_, exists := store.data[store.scopedKey(key)]
+	return exists, nil
+}
+
+func (store *sharedKVStore) Delete(key kvstore.Key) error {
+	store.mu.Lock()
+	defer store.mu.Unlock()
+
+	delete(store.data, store.scopedKey(key))
+	return nil
+}
+
+func (store *sharedKVStore) DeletePrefix(prefix kvstore.KeyPrefix) error {
+	store.mu.Lock()
+	defer store.mu.Unlock()
+
+	fullPrefix := store.scopedKey(prefix)
+	for key := range store.data {
+		if strings.HasPrefix(key, fullPrefix) {
+			delete(store.data, key)
+		}
+	}
+	return nil
+}
+
+func (store *sharedKVStore) Batched() kvstore.BatchedMutations {
+	return &sharedBatch{store: store}
+}
+
+func (store *sharedKVStore) scopedKey(key []byte) string {
+	return store.realmPrefix() + string(key)
+}
+
+func (store *sharedKVStore) realmPrefix() string {
+	return string(store.realm) + "\x00"
+}
+
+type sharedBatch struct {
+	store   *sharedKVStore
+	sets    []struct{ key, value []byte }
+	deletes [][]byte
+}
+
+func (batch *sharedBatch) Set(key kvstore.Key, value kvstore.Value) error {
+	batch.sets = append(batch.sets, struct{ key, value []byte }{append([]byte{}, key...), append([]byte{}, value...)})
+	return nil
+}
+
+func (batch *sharedBatch) Delete(key kvstore.Key) error {
+	batch.deletes = append(batch.deletes, append([]byte{}, key...))
+	return nil
+}
+
+func (batch *sharedBatch) Cancel() {
+	batch.sets = nil
+	batch.deletes = nil
+}
+
+func (batch *sharedBatch) Commit() error {
+	for _, set := range batch.sets {
+		if err := batch.store.Set(set.key, set.value); err != nil {
+			return err
+		}
+	}
+	for _, key := range batch.deletes {
+		if err := batch.store.Delete(key); err != nil {
+			return err
+		}
+	}
+	return nil
+}
