diff --git a/tests/test_simplify.py b/tests/test_simplify.py
index b61bc7c..3308fca 100644
--- a/tests/test_simplify.py
+++ b/tests/test_simplify.py
@@ -878,3 +878,74 @@ else:
             has_sim401 = True
             assert msg == expected_proposal
     assert has_sim401
+
+
+import re as _re_sim901
+
+_SIM901_BOOL_RE = _re_sim901.compile(
+    r"^(\d+):(\d+) SIM\d+ Use '(?P<inner>.+)' instead of 'bool\((?P=inner)\)'$"
+)
+
+
+def _sim901_bool_warnings(ret):
+    """Return [(line, col, inner)] for any 'Use X instead of bool(X)' warning,
+    independent of the specific SIMxxx rule code chosen by the implementation.
+    The issue does not pin down a code, so any unique SIM code is acceptable.
+    """
+    out = []
+    for msg in ret:
+        m = _SIM901_BOOL_RE.match(msg)
+        if m:
+            out.append((int(m.group(1)), int(m.group(2)), m.group("inner")))
+    return out
+
+
+def test_sim901_bool_eq():
+    """Issue example: bool(a == b) should report a 'use comparison directly' warning."""
+    ret = _results("bool(a == b)")
+    assert _sim901_bool_warnings(ret) == [(1, 0, "a == b")]
+
+
+def test_sim901_bool_lt():
+    ret = _results("bool(a < b)")
+    assert _sim901_bool_warnings(ret) == [(1, 0, "a < b")]
+
+
+def test_sim901_bool_ne():
+    ret = _results("bool(a != b)")
+    assert _sim901_bool_warnings(ret) == [(1, 0, "a != b")]
+
+
+def test_sim901_bool_in():
+    ret = _results("bool(a in b)")
+    assert _sim901_bool_warnings(ret) == [(1, 0, "a in b")]
+
+
+def test_sim901_no_trigger_on_plain_compare():
+    """A bare comparison (no bool wrap) must not trigger any bool() warning."""
+    ret = _results("a == b")
+    assert _sim901_bool_warnings(ret) == []
+
+
+def test_sim901_no_trigger_on_bool_of_name():
+    """bool(x) where x isn't a comparison must not trigger."""
+    ret = _results("bool(x)")
+    assert _sim901_bool_warnings(ret) == []
+
+
+def test_sim901_no_trigger_on_bool_of_call():
+    """bool(some_call()) must not trigger."""
+    ret = _results("bool(foo())")
+    assert _sim901_bool_warnings(ret) == []
+
+
+def test_sim901_no_trigger_on_bool_of_not():
+    """bool(not x) must not trigger - issue scope is 'bool(comparison)' only."""
+    ret = _results("bool(not x)")
+    assert _sim901_bool_warnings(ret) == []
+
+
+def test_sim901_no_trigger_on_nested_bool():
+    """bool(bool(x)) must not trigger - issue scope is 'bool(comparison)' only."""
+    ret = _results("bool(bool(x))")
+    assert _sim901_bool_warnings(ret) == []
