+package validate_test
+
+import (
+	"math"
+	"strconv"
+	"testing"
+
+	"github.com/opencontainers/runc/libcontainer/configs"
+	"github.com/opencontainers/runc/libcontainer/configs/validate"
+)
+
+func codespecMappedConfig() *configs.Config {
+	return &configs.Config{
+		Rootfs: "/var",
+		Namespaces: configs.Namespaces{
+			{Type: configs.NEWUSER},
+		},
+		UidMappings: []configs.IDMap{
+			{ContainerID: 0, HostID: 100000, Size: 10},
+		},
+		GidMappings: []configs.IDMap{
+			{ContainerID: 0, HostID: 200000, Size: 10},
+		},
+	}
+}
+
+func codespecValidate(t *testing.T, config *configs.Config) error {
+	t.Helper()
+	return validate.New().Validate(config)
+}
+
+func TestCodespecUserNamespaceRequiresCompleteRootMappings(t *testing.T) {
+	tests := []struct {
+		name   string
+		mutate func(*configs.Config)
+	}{
+		{"missing uid mappings", func(c *configs.Config) { c.UidMappings = nil }},
+		{"missing gid mappings", func(c *configs.Config) { c.GidMappings = nil }},
+		{"uid root unmapped", func(c *configs.Config) { c.UidMappings[0].ContainerID = 1 }},
+		{"gid root unmapped", func(c *configs.Config) { c.GidMappings[0].ContainerID = 1 }},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			config := codespecMappedConfig()
+			test.mutate(config)
+			if err := codespecValidate(t, config); err == nil {
+				t.Fatalf("validator accepted user namespace with %s", test.name)
+			}
+		})
+	}
+}
+
+func TestCodespecIDMappingRejectsInvalidRanges(t *testing.T) {
+	tests := []struct {
+		name   string
+		mutate func(*configs.Config)
+	}{
+		{"zero uid size", func(c *configs.Config) { c.UidMappings[0].Size = 0 }},
+		{"zero gid size", func(c *configs.Config) { c.GidMappings[0].Size = 0 }},
+		{"negative uid size", func(c *configs.Config) { c.UidMappings[0].Size = -1 }},
+		{"negative gid size", func(c *configs.Config) { c.GidMappings[0].Size = -1 }},
+		{"negative uid container start", func(c *configs.Config) { c.UidMappings[0].ContainerID = -1 }},
+		{"negative uid host start", func(c *configs.Config) { c.UidMappings[0].HostID = -1 }},
+		{"negative gid container start", func(c *configs.Config) { c.GidMappings[0].ContainerID = -1 }},
+		{"negative gid host start", func(c *configs.Config) { c.GidMappings[0].HostID = -1 }},
+		{"uid container arithmetic overflow", func(c *configs.Config) {
+			c.UidMappings[0] = configs.IDMap{ContainerID: math.MaxInt - 1, HostID: 100000, Size: 3}
+		}},
+		{"uid host arithmetic overflow", func(c *configs.Config) {
+			c.UidMappings[0] = configs.IDMap{ContainerID: 0, HostID: math.MaxInt - 1, Size: 3}
+		}},
+		{"gid container arithmetic overflow", func(c *configs.Config) {
+			c.GidMappings[0] = configs.IDMap{ContainerID: math.MaxInt - 1, HostID: 200000, Size: 3}
+		}},
+		{"gid host arithmetic overflow", func(c *configs.Config) {
+			c.GidMappings[0] = configs.IDMap{ContainerID: 0, HostID: math.MaxInt - 1, Size: 3}
+		}},
+	}
+
+	if strconv.IntSize == 64 {
+		const unmappableID = uint64(math.MaxUint32)
+		tests = append(tests,
+			struct {
+				name   string
+				mutate func(*configs.Config)
+			}{"reserved uid value", func(c *configs.Config) {
+				c.UidMappings[0] = configs.IDMap{ContainerID: 0, HostID: int(unmappableID), Size: 1}
+			}},
+			struct {
+				name   string
+				mutate func(*configs.Config)
+			}{"reserved gid value", func(c *configs.Config) {
+				c.GidMappings[0] = configs.IDMap{ContainerID: int(unmappableID), HostID: 200000, Size: 1}
+			}},
+			struct {
+				name   string
+				mutate func(*configs.Config)
+			}{"uid range reaches reserved value", func(c *configs.Config) {
+				c.UidMappings = []configs.IDMap{
+					{ContainerID: 0, HostID: 100000, Size: 1},
+					{ContainerID: int(unmappableID) - 1, HostID: 200000, Size: 2},
+				}
+			}},
+			struct {
+				name   string
+				mutate func(*configs.Config)
+			}{"gid range reaches reserved value", func(c *configs.Config) {
+				c.GidMappings = []configs.IDMap{
+					{ContainerID: 0, HostID: 200000, Size: 1},
+					{ContainerID: 300000, HostID: int(unmappableID) - 1, Size: 2},
+				}
+			}},
+		)
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			config := codespecMappedConfig()
+			test.mutate(config)
+			if err := codespecValidate(t, config); err == nil {
+				t.Fatalf("validator accepted invalid ID mapping: %s", test.name)
+			}
+		})
+	}
+}
+
+func TestCodespecMappingsWithoutUserNamespaceAreRejected(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		mutate func(*configs.Config)
+	}{
+		{"uid only", func(c *configs.Config) {
+			c.UidMappings = []configs.IDMap{{ContainerID: 0, HostID: 100000, Size: 1}}
+		}},
+		{"gid only", func(c *configs.Config) {
+			c.GidMappings = []configs.IDMap{{ContainerID: 0, HostID: 200000, Size: 1}}
+		}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			config := &configs.Config{Rootfs: "/var"}
+			test.mutate(config)
+			if err := codespecValidate(t, config); err == nil {
+				t.Fatalf("validator accepted %s mappings without NEWUSER", test.name)
+			}
+		})
+	}
+}
+
+func TestCodespecIDMappingRejectsOverlapsInEitherCoordinateSpace(t *testing.T) {
+	tests := []struct {
+		name   string
+		mutate func(*configs.Config)
+	}{
+		{"uid container overlap", func(c *configs.Config) {
+			c.UidMappings = append(c.UidMappings, configs.IDMap{ContainerID: 9, HostID: 300000, Size: 2})
+		}},
+		{"uid host overlap", func(c *configs.Config) {
+			c.UidMappings = append(c.UidMappings, configs.IDMap{ContainerID: 20, HostID: 100009, Size: 2})
+		}},
+		{"gid container overlap", func(c *configs.Config) {
+			c.GidMappings = append(c.GidMappings, configs.IDMap{ContainerID: 9, HostID: 300000, Size: 2})
+		}},
+		{"gid host overlap", func(c *configs.Config) {
+			c.GidMappings = append(c.GidMappings, configs.IDMap{ContainerID: 20, HostID: 200009, Size: 2})
+		}},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			config := codespecMappedConfig()
+			test.mutate(config)
+			if err := codespecValidate(t, config); err == nil {
+				t.Fatalf("validator accepted overlapping ranges: %s", test.name)
+			}
+		})
+	}
+}
+
+func TestCodespecIDMappingAllowsAdjacentUnsortedAndIndependentRanges(t *testing.T) {
+	config := codespecMappedConfig()
+	config.UidMappings = []configs.IDMap{
+		{ContainerID: 20, HostID: 400020, Size: 5},
+		{ContainerID: 0, HostID: 400000, Size: 10},
+		{ContainerID: 10, HostID: 400010, Size: 10},
+	}
+
+	config.GidMappings = append([]configs.IDMap(nil), config.UidMappings...)
+	if strconv.IntSize == 64 {
+		const largestUsableID = int64(math.MaxUint32 - 1)
+		last := configs.IDMap{ContainerID: int(largestUsableID), HostID: int(largestUsableID), Size: 1}
+		config.UidMappings = append(config.UidMappings, last)
+		config.GidMappings = append(config.GidMappings, last)
+	}
+
+	if err := codespecValidate(t, config); err != nil {
+		t.Fatalf("validator rejected adjacent, unsorted, independent mappings: %v", err)
+	}
+}
+
+func TestCodespecHostIDTranslationUsesHalfOpenRanges(t *testing.T) {
+	config := codespecMappedConfig()
+	config.UidMappings = []configs.IDMap{
+		{ContainerID: 20, HostID: 3020, Size: 3},
+		{ContainerID: 0, HostID: 1000, Size: 2},
+		{ContainerID: 10, HostID: 2010, Size: 2},
+	}
+	config.GidMappings = []configs.IDMap{
+		{ContainerID: 30, HostID: 4030, Size: 2},
+		{ContainerID: 0, HostID: 5000, Size: 1},
+	}
+
+	uidTests := map[int]int{0: 1000, 1: 1001, 10: 2010, 11: 2011, 20: 3020, 22: 3022}
+	for containerID, expected := range uidTests {
+		actual, err := config.HostUID(containerID)
+		if err != nil || actual != expected {
+			t.Fatalf("HostUID(%d) = (%d, %v), want (%d, nil)", containerID, actual, err, expected)
+		}
+	}
+	for _, unmapped := range []int{-1, 2, 12, 23} {
+		if hostID, err := config.HostUID(unmapped); err == nil {
+			t.Fatalf("HostUID(%d) returned unmapped host ID %d", unmapped, hostID)
+		}
+	}
+
+	gidTests := map[int]int{0: 5000, 30: 4030, 31: 4031}
+	for containerID, expected := range gidTests {
+		actual, err := config.HostGID(containerID)
+		if err != nil || actual != expected {
+			t.Fatalf("HostGID(%d) = (%d, %v), want (%d, nil)", containerID, actual, err, expected)
+		}
+	}
+	for _, unmapped := range []int{-1, 1, 32} {
+		if hostID, err := config.HostGID(unmapped); err == nil {
+			t.Fatalf("HostGID(%d) returned unmapped host ID %d", unmapped, hostID)
+		}
+	}
+}
+
+func TestCodespecTranslationRejectsMalformedOrOverflowingMaps(t *testing.T) {
+	badMaps := []struct {
+		name string
+		maps []configs.IDMap
+	}{
+		{"zero size", []configs.IDMap{{ContainerID: 0, HostID: 10, Size: 0}}},
+		{"overlap", []configs.IDMap{
+			{ContainerID: 0, HostID: 10, Size: 2},
+			{ContainerID: 1, HostID: 20, Size: 2},
+		}},
+		{"translated host overflow", []configs.IDMap{{ContainerID: 0, HostID: math.MaxInt, Size: 2}}},
+	}
+
+	for _, test := range badMaps {
+		t.Run(test.name, func(t *testing.T) {
+			config := &configs.Config{
+				Namespaces:  configs.Namespaces{{Type: configs.NEWUSER}},
+				UidMappings: test.maps,
+				GidMappings: test.maps,
+			}
+			if hostID, err := config.HostUID(1); err == nil {
+				t.Fatalf("HostUID used malformed %s map and returned %d", test.name, hostID)
+			}
+			if hostID, err := config.HostGID(1); err == nil {
+				t.Fatalf("HostGID used malformed %s map and returned %d", test.name, hostID)
+			}
+		})
+	}
+}
+
+func TestCodespecNoUserNamespaceKeepsIdentityTranslation(t *testing.T) {
+	config := &configs.Config{}
+	for _, id := range []int{-1, 0, 42, math.MaxInt} {
+		uid, uidErr := config.HostUID(id)
+		gid, gidErr := config.HostGID(id)
+		if uidErr != nil || uid != id || gidErr != nil || gid != id {
+			t.Fatalf("identity translation for %d returned uid=(%d,%v), gid=(%d,%v)", id, uid, uidErr, gid, gidErr)
+		}
+	}
+}
+
+func TestCodespecRootlessMountIDsUseCompleteValidatedRanges(t *testing.T) {
+	config := codespecMappedConfig()
+	config.RootlessEUID = true
+	config.UidMappings = []configs.IDMap{
+		{ContainerID: 20, HostID: 100020, Size: 3},
+		{ContainerID: 0, HostID: 100000, Size: 2},
+	}
+	config.GidMappings = []configs.IDMap{
+		{ContainerID: 0, HostID: 200000, Size: 2},
+		{ContainerID: 30, HostID: 200030, Size: 3},
+	}
+	config.Mounts = []*configs.Mount{{Destination: "/dev/pts", Data: "uid=22,gid=32"}}
+	if err := codespecValidate(t, config); err != nil {
+		t.Fatalf("validator rejected mapped endpoint IDs in rootless mount: %v", err)
+	}
+
+	for _, data := range []string{"uid=23,gid=32", "uid=22,gid=33"} {
+		config.Mounts[0].Data = data
+		if err := codespecValidate(t, config); err == nil {
+			t.Fatalf("validator accepted unmapped rootless mount option %q", data)
+		}
+	}
+}

