@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+PY=/testbed/.venv/bin/python
+
+
+"$PY" -m pytest tests/test_models.py \
+    -k "convnext_atto and (test_model_forward or test_model_default_cfgs or test_model_forward_features)" \
+    -p no:cacheprovider -q
+
+
+"$PY" -m pytest tests/test_inception_next.py -p no:cacheprovider -q
