new file mode 100644
index 00000000..f8ffaa1f
--- /dev/null
+++ b/tests/test_inception_next.py
@@ -0,0 +1,162 @@
+
+
+
+
+
+
+
+import pytest
+import torch
+
+import timm
+from timm import create_model, list_models
+
+
+VARIANTS = ['inception_next_tiny', 'inception_next_small', 'inception_next_base']
+
+
+
+EXPECTED_DIMS = {
+    'inception_next_tiny': (96, 192, 384, 768),
+    'inception_next_small': (96, 192, 384, 768),
+    'inception_next_base': (128, 256, 512, 1024),
+}
+EXPECTED_REDUCTION = (4, 8, 16, 32)
+
+
+def test_variants_registered():
+    listed = set(list_models('inception_next*'))
+    for name in VARIANTS:
+        assert name in listed, f'{name} not registered with timm'
+
+
+@pytest.mark.parametrize('name', VARIANTS)
+def test_default_forward_shape(name):
+    model = create_model(name, pretrained=False).eval()
+    x = torch.randn(2, 3, 64, 64)
+    with torch.no_grad():
+        out = model(x)
+    assert out.shape == (2, 1000)
+    assert not torch.isnan(out).any()
+
+
+@pytest.mark.parametrize('name', VARIANTS)
+def test_custom_num_classes(name):
+    model = create_model(name, pretrained=False, num_classes=17).eval()
+    x = torch.randn(2, 3, 64, 64)
+    with torch.no_grad():
+        out = model(x)
+    assert out.shape == (2, 17)
+    clf = model.get_classifier()
+    assert clf.out_features == 17
+
+
+@pytest.mark.parametrize('name', VARIANTS)
+def test_forward_features_unpooled(name):
+    model = create_model(name, pretrained=False).eval()
+    x = torch.randn(2, 3, 64, 64)
+    with torch.no_grad():
+        feat = model.forward_features(x)
+    assert feat.ndim == 4
+
+    assert feat.shape[2] == 2 and feat.shape[3] == 2
+    assert feat.shape[1] == model.num_features
+
+
+@pytest.mark.parametrize('name', VARIANTS)
+def test_num_features_matches_published(name):
+    model = create_model(name, pretrained=False).eval()
+    assert model.num_features == EXPECTED_DIMS[name][-1]
+
+
+@pytest.mark.parametrize('name', VARIANTS)
+def test_reset_classifier_pooled(name):
+    model = create_model(name, pretrained=False).eval()
+    x = torch.randn(2, 3, 64, 64)
+    model.reset_classifier(0)
+    with torch.no_grad():
+        out = model(x)
+    assert out.ndim == 2
+    assert out.shape == (2, model.num_features)
+
+
+@pytest.mark.parametrize('name', VARIANTS)
+def test_reset_classifier_unpooled(name):
+    model = create_model(name, pretrained=False).eval()
+    x = torch.randn(2, 3, 64, 64)
+    model.reset_classifier(0, '')
+    with torch.no_grad():
+        out = model(x)
+    assert out.ndim == 4
+    assert out.shape == (2, model.num_features, 2, 2)
+
+
+@pytest.mark.parametrize('name', VARIANTS)
+def test_create_unpooled_no_head(name):
+    model = create_model(name, pretrained=False, num_classes=0, global_pool='').eval()
+    x = torch.randn(2, 3, 64, 64)
+    with torch.no_grad():
+        out = model(x)
+    assert out.ndim == 4
+    assert out.shape == (2, model.num_features, 2, 2)
+
+
+@pytest.mark.parametrize('name', VARIANTS)
+def test_features_only(name):
+    model = create_model(name, pretrained=False, features_only=True).eval()
+    assert model.feature_info.channels() == list(EXPECTED_DIMS[name])
+    assert tuple(model.feature_info.reduction()) == EXPECTED_REDUCTION
+
+    x = torch.randn(1, 3, 64, 64)
+    with torch.no_grad():
+        outs = model(x)
+    assert len(outs) == 4
+    for o, ch, r in zip(outs, EXPECTED_DIMS[name], EXPECTED_REDUCTION):
+        assert o.shape[0] == 1
+        assert o.shape[1] == ch
+        assert o.shape[2] == 64 // r and o.shape[3] == 64 // r
+        assert not torch.isnan(o).any()
+
+
+@pytest.mark.parametrize('name', VARIANTS)
+def test_in_chans(name):
+    model = create_model(name, pretrained=False, in_chans=1).eval()
+    x = torch.randn(2, 1, 64, 64)
+    with torch.no_grad():
+        out = model(x)
+    assert out.shape == (2, 1000)
+
+
+@pytest.mark.parametrize('name', VARIANTS)
+def test_default_cfg(name):
+    model = create_model(name, pretrained=False).eval()
+    cfg = model.default_cfg
+    assert cfg['num_classes'] == 1000
+    assert cfg['input_size'] == (3, 224, 224)
+    sd = model.state_dict()
+    first_conv = cfg['first_conv']
+    classifier = cfg['classifier']
+    assert first_conv + '.weight' in sd
+    assert classifier + '.weight' in sd
+
+
+def test_variant_architecture_distinct():
+    def nparams(name):
+        return sum(p.numel() for p in create_model(name, pretrained=False).parameters())
+
+    tiny = nparams('inception_next_tiny')
+    small = nparams('inception_next_small')
+    base = nparams('inception_next_base')
+
+    assert small > tiny
+    assert base > small
+
+
+@pytest.mark.parametrize('name', VARIANTS)
+def test_backward(name):
+    model = create_model(name, pretrained=False, num_classes=8).train()
+    x = torch.randn(2, 3, 64, 64)
+    out = model(x)
+    out.mean().backward()
+    grads = [p.grad is not None for p in model.parameters()]
+    assert all(grads)
