+
+def test_referential_transparency_same_inputs_same_values() -> None:
+    first = _example_single_a()
+    second = _example_single_a()
+
+    assert first == second
+    assert first == PDMResults(1.0, 0.5, 1.0, 0.0, 0.8, 1.0, 0.42)
+
+
+def test_model_trajectory_poses_are_not_mutated() -> None:
+    metric_cache = _metric_cache([(0.0, 1.0, 0.0), (0.0, 2.0, -0.2)])
+    trajectory = _trajectory([[0.0, 0.75, 0.0], [-0.25, 1.5, -0.15]])
+    before = trajectory.poses.copy()
+    simulator = RecordingSimulator()
+    scorer = LiteralScorer(
+        scores=[0.6, 0.9],
+        multi_metrics=[[0.4, 1.0], [0.3, 1.0]],
+        weighted_metrics=[[0.1, 0.7], [0.2, 1.0], [0.3, 1.0], [0.4, 1.0]],
+    )
+
+    pdm_score(metric_cache, trajectory, SAMPLING, simulator, scorer)
+
+    np.testing.assert_array_equal(trajectory.poses, before)
+    np.testing.assert_array_equal(trajectory.poses, np.array([[0.0, 0.75, 0.0], [-0.25, 1.5, -0.15]], dtype=np.float32))
+
+
+def test_no_global_state_matches_fresh_python_process() -> None:
+    in_process = asdict(_example_single_a())
+    script = (
+        "import json, sys; "
+        "sys.path.insert(0, '/workspace/repo/usercase-test-coderl'); "
+        "sys.path.insert(0, '/workspace/repo'); "
+        "from dataclasses import asdict; "
+        "from test_pdm_score_api import _example_single_a; "
+        "print(json.dumps(asdict(_example_single_a()), sort_keys=True))"
+    )
+    completed = subprocess.run([sys.executable, "-c", script], check=True, text=True, capture_output=True)
+    fresh_process = json.loads(completed.stdout)
+
+    assert in_process == {
+        "no_at_fault_collisions": 1.0,
+        "drivable_area_compliance": 0.5,
+        "time_to_collision_within_bound": 1.0,
+        "comfort": 0.0,
+        "ego_progress": 0.8,
+        "driving_direction_compliance": 1.0,
+        "score": 0.42,
+    }
+    assert fresh_process == in_process
+
+
+def test_no_undeclared_file_writes_or_network_connections(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    original_open = builtins.open
+
+    def guarded_open(file, mode="r", *args, **kwargs):
+        if any(flag in mode for flag in ("w", "a", "x", "+")):
+            raise AssertionError(f"unexpected file write through open({file!r}, {mode!r})")
+        return original_open(file, mode, *args, **kwargs)
+
+    def blocked_socket(*args, **kwargs):
+        raise AssertionError("unexpected network socket creation")
+
+    monkeypatch.setattr(builtins, "open", guarded_open)
+    monkeypatch.setattr(socket, "socket", blocked_socket)
+    monkeypatch.chdir(tmp_path)
+    before = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob("*"))
+
+    actual = _example_single_a()
+
+    after = sorted(path.relative_to(tmp_path).as_posix() for path in tmp_path.rglob("*"))
+    assert actual == PDMResults(1.0, 0.5, 1.0, 0.0, 0.8, 1.0, 0.42)
+    assert before == []
+    assert after == []
