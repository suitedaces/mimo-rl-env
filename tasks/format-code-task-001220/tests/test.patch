--- /dev/null
+++ b/usercase-test-coderl/test_pdm_score_api.py
@@ -0,0 +1,385 @@
+
+
+
+
+
+
+from __future__ import annotations
+
+import builtins
+import json
+import os
+import socket
+import subprocess
+import sys
+from dataclasses import asdict
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from navsim.common.dataclasses import PDMResults, Trajectory
+from navsim.evaluate.pdm_score import pdm_score, pdm_score_multi
+from navsim.planning.metric_caching.metric_cache import MetricCache
+from navsim.planning.simulation.planner.pdm_planner.utils.pdm_enums import MultiMetricIndex, WeightedMetricIndex
+from nuplan.common.actor_state.ego_state import EgoState
+from nuplan.common.actor_state.state_representation import StateSE2, StateVector2D, TimePoint
+from nuplan.common.actor_state.vehicle_parameters import get_pacifica_parameters
+from nuplan.planning.simulation.trajectory.interpolated_trajectory import InterpolatedTrajectory
+from nuplan.planning.simulation.trajectory.trajectory_sampling import TrajectorySampling
+
+
+VEHICLE_PARAMETERS = get_pacifica_parameters()
+SAMPLING = TrajectorySampling(time_horizon=1.0, interval_length=0.5)
+
+
+def _ego_state(x: float, y: float, heading: float, time_us: int) -> EgoState:
+    return EgoState.build_from_rear_axle(
+        rear_axle_pose=StateSE2(x, y, heading),
+        rear_axle_velocity_2d=StateVector2D(0.0, 0.0),
+        rear_axle_acceleration_2d=StateVector2D(0.0, 0.0),
+        tire_steering_angle=0.0,
+        time_point=TimePoint(time_us),
+        vehicle_parameters=VEHICLE_PARAMETERS,
+    )
+
+
+def _metric_cache(reference_offsets: list[tuple[float, float, float]]) -> MetricCache:
+    initial_ego_state = _ego_state(10.0, -2.0, 0.25, 1_000_000)
+    reference_states = [initial_ego_state]
+    for index, (dx, dy, dheading) in enumerate(reference_offsets, start=1):
+        reference_states.append(
+            _ego_state(10.0 + dx, -2.0 + dy, 0.25 + dheading, 1_000_000 + index * 500_000)
+        )
+
+    return MetricCache(
+        file_path=Path("/unused/metric-cache.pkl.xz"),
+        trajectory=InterpolatedTrajectory(reference_states),
+        ego_state=initial_ego_state,
+        observation={"obs": "sentinel"},
+        centerline=("centerline", 3),
+        route_lane_ids=["r1", "r2"],
+        drivable_area_map={"map": True},
+    )
+
+
+class RecordingSimulator:
+    def __init__(self, offset: float = 100.0) -> None:
+        self.offset = offset
+        self.calls: list[np.ndarray] = []
+
+    def simulate_proposals(self, trajectory_states: np.ndarray, initial_ego_state: EgoState) -> np.ndarray:
+        assert initial_ego_state.rear_axle.serialize() == [10.0, -2.0, 0.25]
+        self.calls.append(np.array(trajectory_states, copy=True))
+        return trajectory_states + self.offset
+
+
+class LiteralScorer:
+    def __init__(
+        self,
+        *,
+        scores: list[float],
+        multi_metrics: list[list[float]],
+        weighted_metrics: list[list[float]],
+        expected_simulated_pose_columns: list | None = None,
+    ) -> None:
+        self._scores = np.array(scores, dtype=float)
+        self._multi_metrics = np.array(multi_metrics, dtype=float)
+        self._weighted_metrics = np.array(weighted_metrics, dtype=float)
+        self._expected_simulated_pose_columns = (
+            None if expected_simulated_pose_columns is None else np.array(expected_simulated_pose_columns, dtype=float)
+        )
+        self.calls: list[np.ndarray] = []
+
+    def score_proposals(
+        self,
+        simulated_states: np.ndarray,
+        observation: object,
+        centerline: object,
+        route_lane_ids: object,
+        drivable_area_map: object,
+    ) -> np.ndarray:
+        assert observation == {"obs": "sentinel"}
+        assert centerline == ("centerline", 3)
+        assert route_lane_ids == ["r1", "r2"]
+        assert drivable_area_map == {"map": True}
+        if self._expected_simulated_pose_columns is not None:
+
+            np.testing.assert_allclose(
+                simulated_states[:, :, :3],
+                self._expected_simulated_pose_columns,
+                rtol=0.0,
+                atol=1e-8,
+            )
+        self.calls.append(np.array(simulated_states, copy=True))
+        return self._scores
+
+
+def _trajectory(poses: list[list[float]]) -> Trajectory:
+    return Trajectory(np.array(poses, dtype=np.float32), SAMPLING)
+
+
+def _example_single_a() -> PDMResults:
+    metric_cache = _metric_cache([(1.0, 0.0, 0.0), (2.0, 0.2, 0.1)])
+    simulator = RecordingSimulator()
+    scorer = LiteralScorer(
+        scores=[0.75, 0.42],
+        multi_metrics=[[0.9, 1.0], [0.25, 0.5]],
+        weighted_metrics=[[0.2, 0.8], [0.3, 1.0], [0.4, 0.0], [0.5, 1.0]],
+    )
+    return pdm_score(metric_cache, _trajectory([[0.5, 0.0, 0.0], [1.25, 0.3, 0.1]]), SAMPLING, simulator, scorer)
+
+
+def test_single_trajectory_returns_prediction_row_from_scorer_index_one() -> None:
+
+
+
+
+    expected = PDMResults(
+        no_at_fault_collisions=1.0,
+        drivable_area_compliance=0.5,
+        time_to_collision_within_bound=1.0,
+        comfort=0.0,
+        ego_progress=0.8,
+        driving_direction_compliance=1.0,
+        score=0.42,
+    )
+
+    assert _example_single_a() == expected
+
+
+def test_single_trajectory_transforms_reference_and_ego_relative_prediction_before_scoring() -> None:
+
+
+
+
+    metric_cache = _metric_cache([(1.0, 0.0, 0.0), (2.0, 0.2, 0.1)])
+
+    expected_simulated_pose_columns = [
+        [
+            [110.0, 98.0, 100.25],
+            [111.0, 98.0, 100.25],
+            [112.0, 98.2, 100.35],
+        ],
+        [
+            [110.0, 98.0, 100.25],
+            [110.48445621, 98.12370198, 100.25],
+            [111.13691934, 98.59992869, 100.35],
+        ],
+    ]
+    simulator = RecordingSimulator()
+    scorer = LiteralScorer(
+        scores=[0.75, 0.42],
+        multi_metrics=[[0.9, 1.0], [0.25, 0.5]],
+        weighted_metrics=[[0.2, 0.8], [0.3, 1.0], [0.4, 0.0], [0.5, 1.0]],
+        expected_simulated_pose_columns=expected_simulated_pose_columns,
+    )
+
+    actual = pdm_score(
+        metric_cache,
+        _trajectory([[0.5, 0.0, 0.0], [1.25, 0.3, 0.1]]),
+        SAMPLING,
+        simulator,
+        scorer,
+    )
+
+    assert actual == PDMResults(1.0, 0.5, 1.0, 0.0, 0.8, 1.0, 0.42)
+
+    assert len(simulator.calls) >= 1
+    assert len(scorer.calls) >= 1
+
+
+def test_single_trajectory_uses_another_literal_score_and_progress_row() -> None:
+
+
+
+
+    metric_cache = _metric_cache([(0.0, 1.0, 0.0), (0.0, 2.0, -0.2)])
+    simulator = RecordingSimulator()
+    scorer = LiteralScorer(
+        scores=[0.6, 0.9],
+        multi_metrics=[[0.4, 1.0], [0.3, 1.0]],
+        weighted_metrics=[[0.1, 0.7], [0.2, 1.0], [0.3, 1.0], [0.4, 1.0]],
+    )
+
+    actual = pdm_score(
+        metric_cache,
+        _trajectory([[0.0, 0.75, 0.0], [-0.25, 1.5, -0.15]]),
+        SAMPLING,
+        simulator,
+        scorer,
+    )
+
+    assert actual == PDMResults(1.0, 1.0, 1.0, 1.0, 0.7, 1.0, 0.9)
+
+
+def test_multi_trajectory_returns_only_prediction_scores_after_reference() -> None:
+
+
+
+
+    metric_cache = _metric_cache([(1.0, 1.0, 0.05), (2.0, 1.5, 0.1)])
+
+    expected_simulated_pose_columns = [
+        [
+            [110.0, 98.0, 100.25],
+            [111.0, 99.0, 100.3],
+            [112.0, 99.5, 100.35],
+        ],
+        [
+            [110.0, 98.0, 100.25],
+            [110.96891242, 98.24740396, 100.25],
+            [111.93782484, 98.49480792, 100.25],
+        ],
+        [
+            [110.0, 98.0, 100.25],
+            [109.75259604, 98.96891242, 100.3],
+            [109.50519208, 99.93782484, 100.35],
+        ],
+    ]
+    simulator = RecordingSimulator()
