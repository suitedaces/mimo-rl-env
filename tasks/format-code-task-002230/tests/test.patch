+def test_thousands_str_dtype_issue_reproducer():
+
+    import pandas as pd
+
+    data = (
+        "a;b;c\n"
+        "0000.7995;16.000;0\n"
+        "3.03.001.00514;0;4.000\n"
+        "4923.600.041;23.000;131"
+    )
+    df = pd.read_csv(
+        StringIO(data),
+        sep=";",
+        dtype={"a": str},
+        thousands=".",
+        engine="python",
+    )
+    assert df["a"].tolist() == [
+        "0000.7995",
+        "3.03.001.00514",
+        "4923.600.041",
+    ]
+    assert df["b"].tolist() == [16000, 0, 23000]
+    assert df["c"].tolist() == [0, 4000, 131]
+
+
+def test_thousands_str_dtype_simple_thousands_value_preserved():
+
+
+    import pandas as pd
+
+    data = "a;b\n1.000;2.000\n"
+    df = pd.read_csv(
+        StringIO(data),
+        sep=";",
+        dtype={"a": str},
+        thousands=".",
+        engine="python",
+    )
+    assert df["a"].tolist() == ["1.000"]
+    assert df["b"].tolist() == [2000]
+
+
+def test_thousands_scalar_str_dtype_preserves_all_columns():
+
+    import pandas as pd
+
+    data = "a;b\n1.000;2.000\n"
+    df = pd.read_csv(
+        StringIO(data),
+        sep=";",
+        dtype=str,
+        thousands=".",
+        engine="python",
+    )
+    assert df["a"].tolist() == ["1.000"]
+    assert df["b"].tolist() == ["2.000"]
+
+
+def test_thousands_string_dtype_preserves_dots():
+
+
+    import pandas as pd
+
+    data = "a;b\n1.000;2.000\n"
+    df = pd.read_csv(
+        StringIO(data),
+        sep=";",
+        dtype={"a": "string"},
+        thousands=".",
+        engine="python",
+    )
+    assert df["a"].tolist() == ["1.000"]
+    assert df["b"].tolist() == [2000]
+
+
+def test_thousands_preserved_only_for_str_column():
+
+
+    import pandas as pd
+
+    data = "a;b;c\n1.000;2.000;3.000\n"
+    df = pd.read_csv(
+        StringIO(data),
+        sep=";",
+        dtype={"a": str},
+        thousands=".",
+        engine="python",
+    )
+    assert df["a"].tolist() == ["1.000"]
+    assert df["b"].tolist() == [2000]
+    assert df["c"].tolist() == [3000]
+
+
+def test_thousands_no_dtype_still_strips_thousands():
+
+
+
+    import pandas as pd
+
+    data = "a;b\n1.000;2.000\n"
+    df = pd.read_csv(
+        StringIO(data),
+        sep=";",
+        thousands=".",
+        engine="python",
+    )
+    assert df["a"].tolist() == [1000]
+    assert df["b"].tolist() == [2000]
