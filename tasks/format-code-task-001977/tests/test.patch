index 0000000..42e31e3
--- /dev/null
+++ b/test/test_new_api.js
@@ -0,0 +1,229 @@
+'use strict';
+
+
+
+var rbush = require('../rbush.js'),
+    t = require('tape');
+
+function sortedEqual(t, a, b, compare) {
+    compare = compare || function (x, y) {
+        return x.minX - y.minX || x.minY - y.minY || x.maxX - y.maxX || x.maxY - y.maxY;
+    };
+    t.same(a.slice().sort(compare), b.slice().sort(compare));
+}
+
+function makeData() {
+    var arr = [
+        [0,0,0,0],[10,10,10,10],[20,20,20,20],[25,0,25,0],[35,10,35,10],[45,20,45,20],[0,25,0,25],[10,35,10,35],
+        [20,45,20,45],[25,25,25,25],[35,35,35,35],[45,45,45,45],[50,0,50,0],[60,10,60,10],[70,20,70,20],[75,0,75,0],
+        [85,10,85,10],[95,20,95,20],[50,25,50,25],[60,35,60,35],[70,45,70,45],[75,25,75,25],[85,35,85,35],[95,45,95,45],
+        [0,50,0,50],[10,60,10,60],[20,70,20,70],[25,50,25,50],[35,60,35,60],[45,70,45,70],[0,75,0,75],[10,85,10,85],
+        [20,95,20,95],[25,75,25,75],[35,85,35,85],[45,95,45,95],[50,50,50,50],[60,60,60,60],[70,70,70,70],[75,50,75,50],
+        [85,60,85,60],[95,70,95,70],[50,75,50,75],[60,85,60,85],[70,95,70,95],[75,75,75,75],[85,85,85,85],[95,95,95,95]
+    ];
+    return arr.map(function (a) {
+        return {minX: a[0], minY: a[1], maxX: a[2], maxY: a[3]};
+    });
+}
+
+t('toBBox with custom format constructor returns object with minX/minY/maxX/maxY', function (t) {
+    var tree = rbush(4, ['.minLng', '.minLat', '.maxLng', '.maxLat']);
+    t.same(tree.toBBox({minLng: 1, minLat: 2, maxLng: 3, maxLat: 4}),
+        {minX: 1, minY: 2, maxX: 3, maxY: 4});
+    t.end();
+});
+
+t('default toJSON of empty tree has minX/minY/maxX/maxY and no bbox array', function (t) {
+    var tree = rbush();
+    var d = tree.toJSON();
+    t.equal(d.minX, Infinity, 'minX is Infinity');
+    t.equal(d.minY, Infinity, 'minY is Infinity');
+    t.equal(d.maxX, -Infinity, 'maxX is -Infinity');
+    t.equal(d.maxY, -Infinity, 'maxY is -Infinity');
+    t.equal(d.bbox, undefined, 'no bbox array property');
+    t.equal(d.leaf, true);
+    t.same(d.children, []);
+    t.end();
+});
+
+t('toJSON after inserting one object item: node carries minX/minY/maxX/maxY, no bbox', function (t) {
+    var tree = rbush(4);
+    tree.insert({minX: 1, minY: 2, maxX: 3, maxY: 4});
+    var d = tree.toJSON();
+    t.equal(d.bbox, undefined, 'no bbox array property on top-level node');
+    t.equal(d.minX, 1, 'minX matches');
+    t.equal(d.minY, 2, 'minY matches');
+    t.equal(d.maxX, 3, 'maxX matches');
+    t.equal(d.maxY, 4, 'maxY matches');
+    t.equal(d.leaf, true);
+    t.equal(d.children.length, 1);
+    t.end();
+});
+
+t('toJSON after load: internal nodes use minX/minY/maxX/maxY (no bbox array property)', function (t) {
+    var data = makeData();
+    var tree = rbush(4).load(data);
+    var d = tree.toJSON();
+    t.equal(d.bbox, undefined, 'no bbox property on root');
+    t.equal(typeof d.minX, 'number', 'root has numeric minX');
+    t.equal(typeof d.minY, 'number', 'root has numeric minY');
+    t.equal(typeof d.maxX, 'number', 'root has numeric maxX');
+    t.equal(typeof d.maxY, 'number', 'root has numeric maxY');
+
+    function checkNoBBox(node) {
+        t.equal(node.bbox, undefined, 'inner node has no bbox property');
+        if (!node.leaf) {
+            node.children.forEach(checkNoBBox);
+        }
+    }
+    checkNoBBox(d);
+    t.end();
+});
+
+t('search with object-form bbox returns inserted items intersecting the query', function (t) {
+    var data = makeData();
+    var tree = rbush(4).load(data);
+    var result = tree.search({minX: 40, minY: 20, maxX: 80, maxY: 70});
+    sortedEqual(t, result, [
+        {minX:70,minY:20,maxX:70,maxY:20},{minX:75,minY:25,maxX:75,maxY:25},
+        {minX:45,minY:45,maxX:45,maxY:45},{minX:50,minY:50,maxX:50,maxY:50},
+        {minX:60,minY:60,maxX:60,maxY:60},{minX:70,minY:70,maxX:70,maxY:70},
+        {minX:45,minY:20,maxX:45,maxY:20},{minX:45,minY:70,maxX:45,maxY:70},
+        {minX:75,minY:50,maxX:75,maxY:50},{minX:50,minY:25,maxX:50,maxY:25},
+        {minX:60,minY:35,maxX:60,maxY:35},{minX:70,minY:45,maxX:70,maxY:45}
+    ]);
+    t.end();
+});
+
+t('search returns empty array when no items intersect', function (t) {
+    var data = makeData();
+    var result = rbush(4).load(data).search({minX: 200, minY: 200, maxX: 210, maxY: 210});
+    t.same(result, []);
+    t.end();
+});
+
+t('collides returns true when search would find items', function (t) {
+    var data = makeData();
+    var tree = rbush(4).load(data);
+    t.same(tree.collides({minX: 40, minY: 20, maxX: 80, maxY: 70}), true);
+    t.end();
+});
+
+t('collides returns false when nothing intersects', function (t) {
+    var data = makeData();
+    var tree = rbush(4).load(data);
+    t.same(tree.collides({minX: 200, minY: 200, maxX: 210, maxY: 210}), false);
+    t.end();
+});
+
+t('all() returns every loaded object item', function (t) {
+    var data = makeData();
+    var tree = rbush(4).load(data);
+    sortedEqual(t, tree.all(), data);
+    t.end();
+});
+
+t('remove deletes the requested object from the tree', function (t) {
+    var data = makeData();
+    var tree = rbush(4).load(data);
+
+    tree.remove(data[0]);
+    tree.remove(data[1]);
+    tree.remove(data[data.length - 1]);
+
+    var expected = data.slice(2, data.length - 1);
+    sortedEqual(t, tree.all(), expected);
+    t.end();
+});
+
+t('clear empties the tree and yields object-format empty node', function (t) {
+    var data = makeData();
+    var tree = rbush(4).load(data).clear();
+    var d = tree.toJSON();
+    t.equal(d.bbox, undefined, 'cleared root has no bbox array property');
+    t.equal(d.minX, Infinity);
+    t.equal(d.maxX, -Infinity);
+    t.same(d.children, []);
+    t.equal(d.leaf, true);
+    t.same(tree.all(), []);
+    t.end();
+});
+
+t('insert items one by one yields a tree whose all() matches load()', function (t) {
+    var data = makeData();
+    var tree = rbush(4);
+    for (var i = 0; i < data.length; i++) {
+        tree.insert(data[i]);
+    }
+    sortedEqual(t, tree.all(), data);
+
+    t.equal(tree.search({minX: -1, minY: -1, maxX: 1000, maxY: 1000}).length, data.length);
+    t.end();
+});
+
+t('custom toBBox override returning object works with search', function (t) {
+    var tree = rbush(4);
+    tree.toBBox = function (item) {
+        return {minX: item.minLng, minY: item.minLat, maxX: item.maxLng, maxY: item.maxLat};
+    };
+    tree.compareMinX = function (a, b) { return a.minLng - b.minLng; };
+    tree.compareMinY = function (a, b) { return a.minLat - b.minLat; };
+
+    var data = [
+        {minLng: -115, minLat:  45, maxLng: -105, maxLat:  55},
+        {minLng:  105, minLat:  45, maxLng:  115, maxLat:  55},
+        {minLng:  105, minLat: -55, maxLng:  115, maxLat: -45},
+        {minLng: -115, minLat: -55, maxLng: -105, maxLat: -45}
+    ];
+    tree.load(data);
+
+    function byLngLat(a, b) {
+        return a.minLng - b.minLng || a.minLat - b.minLat;
+    }
+
+    sortedEqual(t, tree.search({minX: -180, minY: -90, maxX: 180, maxY: 90}), data, byLngLat);
+    sortedEqual(t, tree.search({minX: -180, minY: -90, maxX: 0, maxY: 90}), [
+        {minLng: -115, minLat:  45, maxLng: -105, maxLat:  55},
+        {minLng: -115, minLat: -55, maxLng: -105, maxLat: -45}
+    ], byLngLat);
+    t.end();
+});
+
+t('fromJSON + toJSON round trip preserves contents', function (t) {
+    var data = makeData();
+    var tree = rbush(4).load(data);
+    var jsonStr = JSON.stringify(tree.toJSON());
+    var tree2 = rbush(4).fromJSON(JSON.parse(jsonStr));
+    sortedEqual(t, tree2.all(), data);
+    sortedEqual(t, tree2.search({minX: 0, minY: 0, maxX: 100, maxY: 100}), data);
+    t.end();
+});
+
+t('format constructor + load + search of object-form items works end to end', function (t) {
+    var data = [
+        {x1: 0, y1: 0, x2: 5, y2: 5},
+        {x1: 10, y1: 10, x2: 15, y2: 15},
+        {x1: 20, y1: 20, x2: 25, y2: 25},
+        {x1: 30, y1: 30, x2: 35, y2: 35},
+        {x1: 40, y1: 40, x2: 45, y2: 45}
+    ];
+    var tree = rbush(4, ['.x1', '.y1', '.x2', '.y2']);
+
+    t.same(tree.toBBox({x1: 1, y1: 2, x2: 3, y2: 4}), {minX: 1, minY: 2, maxX: 3, maxY: 4},
+        'toBBox returns minX/minY/maxX/maxY object');
+    tree.load(data);
+    var found = tree.search({minX: 12, minY: 12, maxX: 22, maxY: 22});
+    function bySource(a, b) { return a.x1 - b.x1; }
+    sortedEqual(t, found, [
+        {x1: 10, y1: 10, x2: 15, y2: 15},
+        {x1: 20, y1: 20, x2: 25, y2: 25}
+    ], bySource);
+    t.end();
+});
+
+t('search and collides return empty / false on an empty tree', function (t) {
+    var tree = rbush(4);
+    t.same(tree.search({minX: 0, minY: 0, maxX: 100, maxY: 100}), []);
+    t.same(tree.collides({minX: 0, minY: 0, maxX: 100, maxY: 100}), false);
+    t.end();
+});
