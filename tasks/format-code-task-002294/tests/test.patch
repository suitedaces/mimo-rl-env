@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+source /opt/venv/bin/activate
+
+pg_ctlcluster 16 main start >/dev/null 2>&1 || true
+
+for _ in $(seq 1 30); do
+    if pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
+        break
+    fi
+    sleep 1
+done
+
+
+
+sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='polar'" 2>/dev/null | grep -q 1 \
+    || sudo -u postgres psql -c "CREATE ROLE polar WITH LOGIN PASSWORD 'polar' SUPERUSER;" >/dev/null 2>&1
+sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname='polar_test'" 2>/dev/null | grep -q 1 \
+    || sudo -u postgres psql -c "CREATE DATABASE polar_test OWNER polar;" >/dev/null 2>&1
+PGPASSWORD=polar psql -h 127.0.0.1 -U polar -d polar_test \
+    -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;" >/dev/null 2>&1 || true
+
+cd /testbed/server
+
+
+pytest tests/subscription/test_endpoints.py \
+       tests/subscription/service/test_subscription_tier.py -q
+
+
+pytest tests/subscription/test_recurring_interval.py -q
