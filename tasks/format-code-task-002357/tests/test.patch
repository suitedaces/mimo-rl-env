+func TestPlainSetAlgebraAndComparisonsDoNotMutateOperands(t *testing.T) {
+
+
+	a := bfset.FromSlice([]int{1, 2, 3, 4})
+	b := bfset.FromSlice([]int{3, 4, 5, 6})
+
+	union := a.Union(b)
+	assertSetMembers(t, union, []int{1, 2, 3, 4, 5, 6})
+	if union.Size() != 6 {
+		t.Fatalf("a.Union(b).Size() = %d, want 6", union.Size())
+	}
+
+	intersection := a.Intersection(b)
+	assertSetMembers(t, intersection, []int{3, 4})
+	if intersection.Size() != 2 {
+		t.Fatalf("a.Intersection(b).Size() = %d, want 2", intersection.Size())
+	}
+
+	aMinusB := a.Difference(b)
+	assertSetMembers(t, aMinusB, []int{1, 2})
+	if aMinusB.Size() != 2 {
+		t.Fatalf("a.Difference(b).Size() = %d, want 2", aMinusB.Size())
+	}
+
+	bMinusA := b.Difference(a)
+	assertSetMembers(t, bMinusA, []int{5, 6})
+	if bMinusA.Size() != 2 {
+		t.Fatalf("b.Difference(a).Size() = %d, want 2", bMinusA.Size())
+	}
+
+	symmetric := a.SymmetricDifference(b)
+	assertSetMembers(t, symmetric, []int{1, 2, 5, 6})
+	if symmetric.Size() != 4 {
+		t.Fatalf("a.SymmetricDifference(b).Size() = %d, want 4", symmetric.Size())
+	}
+
+	assertSetMembers(t, a, []int{1, 2, 3, 4})
+	assertSetMembers(t, b, []int{3, 4, 5, 6})
+	if a.Size() != 4 {
+		t.Fatalf("a.Size() after algebra = %d, want 4", a.Size())
+	}
+	if b.Size() != 4 {
+		t.Fatalf("b.Size() after algebra = %d, want 4", b.Size())
+	}
+
+	if bfset.New[int]().IsSubsetOf(a) != true {
+		t.Fatalf("empty.IsSubsetOf(a) = false, want true")
+	}
+	if bfset.FromSlice([]int{1, 2}).IsSubsetOf(bfset.FromSlice([]int{1, 2, 3})) != true {
+		t.Fatalf("{1,2}.IsSubsetOf({1,2,3}) = false, want true")
+	}
+	if bfset.FromSlice([]int{1, 2, 3}).IsSubsetOf(bfset.FromSlice([]int{1, 2})) != false {
+		t.Fatalf("{1,2,3}.IsSubsetOf({1,2}) = true, want false")
+	}
+	if bfset.FromSlice([]int{3, 2, 1}).Equals(bfset.FromSlice([]int{1, 2, 3})) != true {
+		t.Fatalf("{3,2,1}.Equals({1,2,3}) = false, want true")
+	}
+	if bfset.FromSlice([]int{1, 2}).Equals(bfset.FromSlice([]int{1, 2, 3})) != false {
+		t.Fatalf("{1,2}.Equals({1,2,3}) = true, want false")
+	}
+}
