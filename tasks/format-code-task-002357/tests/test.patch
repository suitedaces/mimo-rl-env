+func TestSyncSetSessionSnapshotAndCopyConstructorsAreIndependent(t *testing.T) {
+
+
+	s := bfset.SyncFromSlice([]int{1, 2, 2, 3})
+	assertSyncSetMembers(t, s, []int{1, 2, 3})
+	if s.Size() != 3 {
+		t.Fatalf("initial SyncSet Size() = %d, want 3", s.Size())
+	}
+	if s.Contains(1) != true {
+		t.Fatalf("initial SyncSet Contains(1) = false, want true")
+	}
+	if s.Contains(4) != false {
+		t.Fatalf("initial SyncSet Contains(4) = true, want false")
+	}
+	if s.IsEmpty() != false {
+		t.Fatalf("initial SyncSet IsEmpty() = true, want false")
+	}
+
+	s.Push(4, 4)
+	assertSyncSetMembers(t, s, []int{1, 2, 3, 4})
+	if s.Size() != 4 {
+		t.Fatalf("after SyncSet Push(4, 4) Size() = %d, want 4", s.Size())
+	}
+	if s.Remove(2) != true {
+		t.Fatalf("first SyncSet Remove(2) = false, want true")
+	}
+	if s.Size() != 3 {
+		t.Fatalf("after first SyncSet Remove(2) Size() = %d, want 3", s.Size())
+	}
+	if s.Contains(2) != false {
+		t.Fatalf("after first SyncSet Remove(2) Contains(2) = true, want false")
+	}
+	if s.Remove(2) != false {
+		t.Fatalf("second SyncSet Remove(2) = true, want false")
+	}
+	if s.Size() != 3 {
+		t.Fatalf("after second SyncSet Remove(2) Size() = %d, want 3", s.Size())
+	}
+
+	peeked, peekOK := s.Peek()
+	if peekOK != true {
+		t.Fatalf("SyncSet Peek() on non-empty set ok = false, want true")
+	}
+	if !isOneOf(peeked, []int{1, 3, 4}) {
+		t.Fatalf("SyncSet Peek() = %d, want one of [1 3 4]", peeked)
+	}
+	if s.Size() != 3 {
+		t.Fatalf("after SyncSet Peek() Size() = %d, want 3", s.Size())
+	}
+
+	snapshot := s.Iter()
+	s.Push(5)
+	snapshotItems := make([]int, 0, 3)
+	snapshot(func(item int) bool {
+		snapshotItems = append(snapshotItems, item)
+		return true
+	})
+	assertIntSliceMembers(t, snapshotItems, []int{1, 3, 4})
+	assertSyncSetMembers(t, s, []int{1, 3, 4, 5})
+	if s.Size() != 4 {
+		t.Fatalf("after snapshot then Push(5) Size() = %d, want 4", s.Size())
+	}
+
+	fromSetSource := bfset.FromSlice([]int{7, 8, 8})
+	fromSetCopy := bfset.FromSet(fromSetSource)
+	fromSetSource.Push(9)
+	fromSetCopy.Remove(7)
+	assertSetMembers(t, fromSetSource, []int{7, 8, 9})
+	assertSyncSetMembers(t, fromSetCopy, []int{8})
+
+	clone := s.Clone()
+	clone.Push(10)
+	if s.Contains(10) != false {
+		t.Fatalf("original SyncSet Contains(10) after clone Push(10) = true, want false")
+	}
+	assertSyncSetMembers(t, clone, []int{1, 3, 4, 5, 10})
+	assertIntSliceMembers(t, s.ToSlice(), []int{1, 3, 4, 5})
+
+	empty := bfset.NewSync[int](8)
+	if empty.Size() != 0 {
+		t.Fatalf("NewSync[int](8).Size() = %d, want 0", empty.Size())
+	}
+	if empty.IsEmpty() != true {
+		t.Fatalf("NewSync[int](8).IsEmpty() = false, want true")
+	}
+	empty.Clear()
+	empty.Clear()
+	emptyPop, emptyPopOK := empty.Pop()
+	if emptyPop != 0 {
+		t.Fatalf("Pop() on empty SyncSet value = %d, want 0", emptyPop)
+	}
+	if emptyPopOK != false {
+		t.Fatalf("Pop() on empty SyncSet ok = true, want false")
+	}
+}
