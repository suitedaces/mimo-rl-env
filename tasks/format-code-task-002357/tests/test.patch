+func TestPlainSetSessionMutationAndEmptyOperations(t *testing.T) {
+
+
+	s := bfset.FromSlice([]int{1, 2, 2, 3})
+	assertSetMembers(t, s, []int{1, 2, 3})
+	if s.Size() != 3 {
+		t.Fatalf("initial Size() = %d, want 3", s.Size())
+	}
+	if s.Contains(1) != true {
+		t.Fatalf("initial Contains(1) = false, want true")
+	}
+	if s.Contains(2) != true {
+		t.Fatalf("initial Contains(2) = false, want true")
+	}
+	if s.Contains(3) != true {
+		t.Fatalf("initial Contains(3) = false, want true")
+	}
+	if s.Contains(4) != false {
+		t.Fatalf("initial Contains(4) = true, want false")
+	}
+	if s.IsEmpty() != false {
+		t.Fatalf("initial IsEmpty() = true, want false")
+	}
+
+	s.Push(4, 4)
+	assertSetMembers(t, s, []int{1, 2, 3, 4})
+	if s.Size() != 4 {
+		t.Fatalf("after Push(4, 4) Size() = %d, want 4", s.Size())
+	}
+
+	if removed := s.Remove(2); removed != true {
+		t.Fatalf("first Remove(2) = false, want true")
+	}
+	assertSetMembers(t, s, []int{1, 3, 4})
+	if s.Size() != 3 {
+		t.Fatalf("after first Remove(2) Size() = %d, want 3", s.Size())
+	}
+	if s.Contains(2) != false {
+		t.Fatalf("after first Remove(2) Contains(2) = true, want false")
+	}
+
+	if removed := s.Remove(2); removed != false {
+		t.Fatalf("second Remove(2) = true, want false")
+	}
+	if s.Size() != 3 {
+		t.Fatalf("after second Remove(2) Size() = %d, want 3", s.Size())
+	}
+
+	peeked, peekOK := s.Peek()
+	if peekOK != true {
+		t.Fatalf("Peek() on non-empty set ok = false, want true")
+	}
+	if !isOneOf(peeked, []int{1, 3, 4}) {
+		t.Fatalf("Peek() = %d, want one of [1 3 4]", peeked)
+	}
+	if s.Size() != 3 {
+		t.Fatalf("after Peek() Size() = %d, want 3", s.Size())
+	}
+	if s.Contains(peeked) != true {
+		t.Fatalf("after Peek() Contains(peeked) = false, want true")
+	}
+
+	popped, popOK := s.Pop()
+	if popOK != true {
+		t.Fatalf("Pop() on non-empty set ok = false, want true")
+	}
+	if !isOneOf(popped, []int{1, 3, 4}) {
+		t.Fatalf("Pop() = %d, want one of [1 3 4]", popped)
+	}
+	if s.Size() != 2 {
+		t.Fatalf("after Pop() Size() = %d, want 2", s.Size())
+	}
+	if s.Contains(popped) != false {
+		t.Fatalf("after Pop() Contains(popped) = true, want false")
+	}
+
+	s.Clear()
+	s.Clear()
+	assertSetMembers(t, s, []int{})
+	if s.Size() != 0 {
+		t.Fatalf("after two Clear() calls Size() = %d, want 0", s.Size())
+	}
+	if s.IsEmpty() != true {
+		t.Fatalf("after Clear() IsEmpty() = false, want true")
+	}
+	if s.Contains(1) != false {
+		t.Fatalf("after Clear() Contains(1) = true, want false")
+	}
+
+	emptyPeek, emptyPeekOK := s.Peek()
+	if emptyPeek != 0 {
+		t.Fatalf("Peek() on empty set value = %d, want 0", emptyPeek)
+	}
+	if emptyPeekOK != false {
+		t.Fatalf("Peek() on empty set ok = true, want false")
+	}
+	emptyPop, emptyPopOK := s.Pop()
+	if emptyPop != 0 {
+		t.Fatalf("Pop() on empty set value = %d, want 0", emptyPop)
+	}
+	if emptyPopOK != false {
+		t.Fatalf("Pop() on empty set ok = true, want false")
+	}
+}
