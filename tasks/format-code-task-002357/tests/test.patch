+func TestPlainSetIterationToSliceAndCopyConstructorsAreIndependent(t *testing.T) {
+
+
+	fromSliceInput := []int{1, 1, 2, 3}
+	fromSliceCopy := bfset.FromSlice(fromSliceInput)
+	fromSliceInput[0] = 99
+	assertSetMembers(t, fromSliceCopy, []int{1, 2, 3})
+
+	preSized := bfset.New[int](8)
+	if preSized.Size() != 0 {
+		t.Fatalf("New[int](8).Size() = %d, want 0", preSized.Size())
+	}
+	if preSized.IsEmpty() != true {
+		t.Fatalf("New[int](8).IsEmpty() = false, want true")
+	}
+	preSized.Push(7, 8)
+	assertSetMembers(t, preSized, []int{7, 8})
+
+	source := bfset.FromSlice([]int{1, 2, 3})
+	clone := source.Clone()
+	clone.Push(4)
+	if source.Size() != 3 {
+		t.Fatalf("source Size() after clone Push(4) = %d, want 3", source.Size())
+	}
+	if source.Contains(4) != false {
+		t.Fatalf("source Contains(4) after clone Push(4) = true, want false")
+	}
+	assertSetMembers(t, clone, []int{1, 2, 3, 4})
+
+	assertIntSliceMembers(t, source.ToSlice(), []int{1, 2, 3})
+	iterated := make([]int, 0, 3)
+	for item := range source.Iter() {
+		iterated = append(iterated, item)
+	}
+	assertIntSliceMembers(t, iterated, []int{1, 2, 3})
+
+	syncSource := bfset.SyncFromSlice([]int{5, 6, 6})
+	plainCopy := bfset.FromSyncSet(syncSource)
+	syncSource.Push(7)
+	plainCopy.Remove(5)
+	assertSyncSetMembers(t, syncSource, []int{5, 6, 7})
+	assertSetMembers(t, plainCopy, []int{6})
+}
