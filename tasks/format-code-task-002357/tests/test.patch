+func TestSyncSetConcurrentPushRemoveHasConcreteFinalState(t *testing.T) {
+
+
+	s := bfset.NewSync[int]()
+	var pushWG sync.WaitGroup
+	for i := 0; i < 200; i++ {
+		pushWG.Add(1)
+		go func(item int) {
+			defer pushWG.Done()
+			s.Push(item)
+		}(i)
+	}
+	pushWG.Wait()
+
+	if s.Size() != 200 {
+		t.Fatalf("after concurrent Push(0..199) Size() = %d, want 200", s.Size())
+	}
+	if s.Contains(0) != true {
+		t.Fatalf("after concurrent Push Contains(0) = false, want true")
+	}
+	if s.Contains(199) != true {
+		t.Fatalf("after concurrent Push Contains(199) = false, want true")
+	}
+	if s.Contains(200) != false {
+		t.Fatalf("after concurrent Push Contains(200) = true, want false")
+	}
+
+	var removeWG sync.WaitGroup
+	var removed atomic.Int32
+	for i := 0; i < 200; i += 2 {
+		removeWG.Add(1)
+		go func(item int) {
+			defer removeWG.Done()
+			if s.Remove(item) {
+				removed.Add(1)
+			}
+		}(i)
+	}
+	removeWG.Wait()
+
+	if removed.Load() != 100 {
+		t.Fatalf("successful even removals = %d, want 100", removed.Load())
+	}
+	if s.Size() != 100 {
+		t.Fatalf("after removing evens Size() = %d, want 100", s.Size())
+	}
+	if s.Contains(0) != false {
+		t.Fatalf("after removing evens Contains(0) = true, want false")
+	}
+	if s.Contains(1) != true {
+		t.Fatalf("after removing evens Contains(1) = false, want true")
+	}
+	if s.Contains(198) != false {
+		t.Fatalf("after removing evens Contains(198) = true, want false")
+	}
+	if s.Contains(199) != true {
+		t.Fatalf("after removing evens Contains(199) = false, want true")
+	}
+}
