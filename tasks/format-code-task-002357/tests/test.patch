+func TestSyncSetAlgebraConcurrentOppositeDirections(t *testing.T) {
+
+
+	a := bfset.SyncFromSlice([]int{1, 2, 3, 4})
+	b := bfset.SyncFromSlice([]int{3, 4, 5, 6})
+	done := make(chan struct{})
+	errs := make(chan string, 64)
+
+	go func() {
+		var wg sync.WaitGroup
+		for i := 0; i < 80; i++ {
+			wg.Add(2)
+			go func() {
+				defer wg.Done()
+				assertSyncSetMembersConcurrent(errs, a.Union(b), []int{1, 2, 3, 4, 5, 6}, "a.Union(b)")
+				assertSyncSetMembersConcurrent(errs, a.Intersection(b), []int{3, 4}, "a.Intersection(b)")
+				assertSyncSetMembersConcurrent(errs, a.Difference(b), []int{1, 2}, "a.Difference(b)")
+				assertSyncSetMembersConcurrent(errs, a.SymmetricDifference(b), []int{1, 2, 5, 6}, "a.SymmetricDifference(b)")
+				if a.IsSubsetOf(bfset.SyncFromSlice([]int{1, 2, 3, 4, 5})) != true {
+					errs <- "a.IsSubsetOf({1,2,3,4,5}) = false, want true"
+				}
+				if a.Equals(bfset.SyncFromSlice([]int{4, 3, 2, 1})) != true {
+					errs <- "a.Equals({4,3,2,1}) = false, want true"
+				}
+			}()
+			go func() {
+				defer wg.Done()
+				assertSyncSetMembersConcurrent(errs, b.Union(a), []int{1, 2, 3, 4, 5, 6}, "b.Union(a)")
+				assertSyncSetMembersConcurrent(errs, b.Intersection(a), []int{3, 4}, "b.Intersection(a)")
+				assertSyncSetMembersConcurrent(errs, b.Difference(a), []int{5, 6}, "b.Difference(a)")
+				assertSyncSetMembersConcurrent(errs, b.SymmetricDifference(a), []int{1, 2, 5, 6}, "b.SymmetricDifference(a)")
+				if b.IsSubsetOf(a) != false {
+					errs <- "b.IsSubsetOf(a) = true, want false"
+				}
+				if b.Equals(a) != false {
+					errs <- "b.Equals(a) = true, want false"
+				}
+			}()
+		}
+		wg.Wait()
+		close(done)
+	}()
+
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("concurrent opposite-direction SyncSet algebra did not finish within 3s")
+	}
+
+	close(errs)
+	for msg := range errs {
+		t.Error(msg)
+	}
+	assertSyncSetMembers(t, a, []int{1, 2, 3, 4})
+	assertSyncSetMembers(t, b, []int{3, 4, 5, 6})
+}
