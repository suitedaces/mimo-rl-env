+func TestRepeatedClearCyclesLeaveNoLiveMembers(t *testing.T) {
+
+
+
+	plainSets := make([]*bfset.Set[int], 0, 120)
+	syncSets := make([]*bfset.SyncSet[int], 0, 120)
+	for cycle := 0; cycle < 120; cycle++ {
+		plain := bfset.New[int]()
+		syncSet := bfset.NewSync[int]()
+		for item := 0; item < 50; item++ {
+			plain.Push(item)
+			syncSet.Push(item)
+		}
+		plain.Clear()
+		plain.Clear()
+		syncSet.Clear()
+		syncSet.Clear()
+		plainSets = append(plainSets, plain)
+		syncSets = append(syncSets, syncSet)
+	}
+
+	plainTotal := 0
+	for _, s := range plainSets {
+		plainTotal += s.Size()
+	}
+	if plainTotal != 0 {
+		t.Fatalf("aggregate Size() across 120 cleared Set instances = %d, want 0", plainTotal)
+	}
+
+	syncTotal := 0
+	for _, s := range syncSets {
+		syncTotal += s.Size()
+	}
+	if syncTotal != 0 {
+		t.Fatalf("aggregate Size() across 120 cleared SyncSet instances = %d, want 0", syncTotal)
+	}
+
+
+	for idx, s := range plainSets {
+		if !s.IsEmpty() {
+			t.Fatalf("cleared Set instance %d IsEmpty() = false, want true", idx)
+		}
+	}
+	for idx, s := range syncSets {
+		if !s.IsEmpty() {
+			t.Fatalf("cleared SyncSet instance %d IsEmpty() = false, want true", idx)
+		}
+	}
+}
+
+func assertSetMembers(t *testing.T, got *bfset.Set[int], want []int) {
+	t.Helper()
+	if got.Size() != len(want) {
+		t.Fatalf("Size() = %d, want %d for members %v", got.Size(), len(want), want)
+	}
+	for _, item := range want {
+		if got.Contains(item) != true {
+			t.Fatalf("Contains(%d) = false, want true for members %v", item, want)
+		}
+	}
+	for _, item := range got.ToSlice() {
+		if !isOneOf(item, want) {
+			t.Fatalf("ToSlice() included %d, want only members %v", item, want)
+		}
+	}
+}
+
+func assertSyncSetMembers(t *testing.T, got *bfset.SyncSet[int], want []int) {
+	t.Helper()
+	if got.Size() != len(want) {
+		t.Fatalf("Size() = %d, want %d for members %v", got.Size(), len(want), want)
+	}
+	for _, item := range want {
+		if got.Contains(item) != true {
+			t.Fatalf("Contains(%d) = false, want true for members %v", item, want)
+		}
+	}
+	for _, item := range got.ToSlice() {
+		if !isOneOf(item, want) {
+			t.Fatalf("ToSlice() included %d, want only members %v", item, want)
+		}
+	}
+}
+
+func assertSyncSetMembersConcurrent(errs chan<- string, got *bfset.SyncSet[int], want []int, label string) {
+	if got.Size() != len(want) {
+		errs <- label + " Size() mismatch"
+		return
+	}
+	for _, item := range want {
+		if got.Contains(item) != true {
+			errs <- label + " missing expected member"
+			return
+		}
+	}
+	for _, item := range got.ToSlice() {
+		if !isOneOf(item, want) {
+			errs <- label + " included unexpected member"
+			return
+		}
+	}
+}
+
+func assertIntSliceMembers(t *testing.T, got []int, want []int) {
+	t.Helper()
+	gotCopy := append([]int(nil), got...)
+	wantCopy := append([]int(nil), want...)
+	sort.Ints(gotCopy)
+	sort.Ints(wantCopy)
+	if !reflect.DeepEqual(gotCopy, wantCopy) {
+		t.Fatalf("slice members = %v, want %v", gotCopy, wantCopy)
+	}
+}
+
+func isOneOf(value int, allowed []int) bool {
+	for _, item := range allowed {
+		if value == item {
+			return true
+		}
+	}
+	return false
+}
