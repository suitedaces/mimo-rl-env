+            auth_type="Basic",
+            token=bob_token,
+        )
+        assert status in (200, 201)
+
+        _, status = await requester(
+            "POST",
+            "/db/guillotina/users/bob/source-for-duplicate/@duplicate",
+            data=json.dumps(
+                {
+                    "new_id": "copy-denied-by-permission",
+                    "destination": "/users/bob/duplicate-target",
