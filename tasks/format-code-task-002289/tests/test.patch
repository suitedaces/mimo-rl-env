+            data=json.dumps({"@type": "Item", "id": "source-for-duplicate"}),
+            auth_type="Basic",
+            token=bob_token,
+        )
+        assert status in (200, 201)
+
+        _, status = await requester(
+            "POST",
+            "/db/guillotina/users/bob/source-for-duplicate/@sharing",
+            data=json.dumps(
+                {"prinrole": [{"principal": "alice", "role": "guillotina.Owner", "setting": "Allow"}]}
+            ),
+            auth_type="Basic",
+            token=bob_token,
+        )
+        assert status == 200
+
+        _, status = await requester(
+            "POST",
+            "/db/guillotina/users/bob/",
