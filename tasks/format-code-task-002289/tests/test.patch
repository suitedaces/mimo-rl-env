+async def test_duplicate_api_check_permission_controls_add_security(container_requester):
+    async with container_requester as requester:
+        _, status = await requester(
+            "POST",
+            "/db/guillotina/",
+            data=json.dumps({"@type": "Item", "id": "api-duplicate-source"}),
+        )
+        assert status in (200, 201)
+        _, status = await requester(
+            "POST",
+            "/db/guillotina/",
+            data=json.dumps({"@type": "Folder", "id": "api-duplicate-target"}),
+        )
+        assert status in (200, 201)
+
+        async with transaction(db=requester.db) as txn:
+            root = await txn.manager.get_root()
+            container = await root.async_get("guillotina")
+            source = await container.async_get("api-duplicate-source")
+            target = await container.async_get("api-duplicate-target")
+
+            utils.login(user=GuillotinaUser("api-limited-user"))
+            with pytest.raises(Exception):
+                await content.duplicate(
+                    source,
+                    destination=target,
+                    new_id="api-copy-denied",
+                    check_permission=True,
+                )
+            assert not await target.async_contains("api-copy-denied")
+
+            copied = await content.duplicate(
+                source,
+                destination=target,
+                new_id="api-copy-allowed-by-explicit-flag",
+                check_permission=False,
+            )
+            assert copied.__name__ == "api-copy-allowed-by-explicit-flag"
+
+        _, status = await requester(
+            "GET",
+            "/db/guillotina/api-duplicate-target/api-copy-denied",
+        )
+        assert status in (401, 403, 404)
+        _, status = await requester(
+            "GET",
+            "/db/guillotina/api-duplicate-target/api-copy-allowed-by-explicit-flag",
+        )
+        assert status == 200
+
