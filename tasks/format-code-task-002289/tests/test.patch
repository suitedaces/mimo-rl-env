+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set +u
+source /opt/venv/bin/activate
+set -u
+
+python setup.py develop 2>/dev/null
+
+case "${1:-}" in
+  base)
+    DATABASE=DUMMY python -m pytest guillotina/tests/test_api.py -v -k "test_duplicate_content or test_not_allowed_move_to_same_parent or test_not_allowed_move_to_self"
+    ;;
+  new)
+    DATABASE=DUMMY python -m pytest \
+      guillotina/tests/test_api.py::test_duplicate_rejects_check_permission_false_without_destination_add_permission \
+      guillotina/tests/test_api.py::test_move_rejects_check_permission_false_without_destination_add_permission \
+      guillotina/tests/test_api.py::test_user_info_requires_access_content \
+      guillotina/tests/test_content.py::test_duplicate_api_check_permission_controls_add_security \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
