+def _basic_token(username, password):
+    return base64.b64encode("{}:{}".format(username, password).encode("utf-8")).decode("ascii")
+
+
+async def _create_db_user(requester, user_id, password):
+    _, status = await requester(
+        "POST",
+        "/db/guillotina/users",
+        data=json.dumps(
+            {
+                "@type": "User",
+                "name": user_id.title(),
+                "id": user_id,
+                "username": user_id,
+                "email": "{}@example.com".format(user_id),
+                "password": password,
+            }
+        ),
+    )
+    assert status in (200, 201)
+
+
+async def _assert_missing(requester, path, token):
+    _, status = await requester(
+        "GET",
+        path,
+        auth_type="Basic",
+        token=token,
+    )
+    assert status in (401, 403, 404)
+
+
+async def _assert_exists(requester, path, token):
+    _, status = await requester(
+        "GET",
+        path,
+        auth_type="Basic",
+        token=token,
+    )
+    assert status == 200
+
+
