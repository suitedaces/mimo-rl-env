@@ -0,0 +1,27 @@
+import re
+
+
+def test_readme_python_support_statement_updated():
+    readme = open("README.md", encoding="utf-8").read()
+    installation = _section_text(readme, "Installation")
+    normalized = installation.lower()
+
+    assert "3.5.1" in installation
+    assert "3.6" in installation
+    assert re.search(
+        r"(no longer supports?|unsupported|does not support).{0,80}"
+        r"(python|versions?).{0,40}"
+        r"(older than|before|below|less than|<)\s*3\.6",
+        normalized,
+        re.DOTALL,
+    )
+
+
+def _section_text(markdown, heading):
+    match = re.search(
+        r"^##\s+{}\b.*?(?=^##\s+|\Z)".format(re.escape(heading)),
+        markdown,
+        re.MULTILINE | re.DOTALL,
+    )
+    assert match, "{} section not found".format(heading)
+    return match.group(0)
diff --git a/tests/test_packaging_metadata.py b/tests/test_packaging_metadata.py
new file mode 100644
index 0000000..3d05c93
--- /dev/null
+++ b/tests/test_packaging_metadata.py
@@ -0,0 +1,67 @@
+import ast
+import re
+
+
+def test_setup_requires_zeroconf_032_or_newer():
+    setup_tree = ast.parse(open("setup.py", encoding="utf-8").read())
+    requirements = _install_requires(setup_tree)
+    zeroconf_requirements = [
+        requirement
+        for requirement in requirements
+        if requirement.split(">", 1)[0].split("=", 1)[0].strip().lower() == "zeroconf"
+    ]
+
+    assert zeroconf_requirements
+    for requirement in zeroconf_requirements:
+        assert ";" not in requirement
+        assert _has_minimum_version(requirement, "0.32.0")
+
+
+def _install_requires(tree):
+    assigned_lists = {}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Assign) and isinstance(node.value, (ast.List, ast.Tuple)):
+            values = _string_list(node.value)
+            if values is not None:
+                for target in node.targets:
+                    if isinstance(target, ast.Name):
+                        assigned_lists[target.id] = values
+
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call) and _call_name(node.func) == "setup":
+            for keyword in node.keywords:
+                if keyword.arg == "install_requires":
+                    if isinstance(keyword.value, ast.Name):
+                        return assigned_lists.get(keyword.value.id, [])
+                    values = _string_list(keyword.value)
+                    if values is not None:
+                        return values
+    return []
+
+
+def _string_list(node):
+    if not isinstance(node, (ast.List, ast.Tuple)):
+        return None
+    values = []
+    for element in node.elts:
+        if not isinstance(element, ast.Str):
+            return None
+        values.append(element.s)
+    return values
+
+
+def _call_name(node):
+    if isinstance(node, ast.Name):
+        return node.id
+    if isinstance(node, ast.Attribute):
+        return node.attr
+    return None
+
+
+def _has_minimum_version(requirement, minimum):
+    match = re.search(r">=\s*([0-9]+(?:\.[0-9]+)*)", requirement)
+    return bool(match and _version_tuple(match.group(1)) >= _version_tuple(minimum))
+
+
+def _version_tuple(version):
+    return tuple(int(part) for part in version.split("."))
