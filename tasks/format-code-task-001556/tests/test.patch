+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+python3 -m venv /testbed/.venv
+
+
+set +u
+source /testbed/.venv/bin/activate
+set -u
+
+
+python -m pip install -q --upgrade pip
+python -m pip install -q -e . 'zeroconf>=0.32.0,<0.40' pytest pytest-asyncio
+
+case "${1:-}" in
+  base)
+    python -m pytest \
+      tests/test_accessory_driver.py \
+      tests/test_encoder.py \
+      tests/test_hap_handler.py \
+      -k 'not test_mdns_service_info and not test_mdns_service_info_includes_server_hostname and not test_mdns_service_instance_name_sanitizes_edge_display_names and not test_mdns_server_hostname_sanitizes_edge_display_names and not test_mdns_sanitization_uses_runtime_values_not_known_fixtures' \
+      -v
+    ;;
+  new)
+    python -m pytest \
+      tests/test_accessory_driver.py::test_mdns_service_info \
+      tests/test_accessory_driver.py::test_mdns_service_info_includes_server_hostname \
+      tests/test_accessory_driver.py::test_mdns_service_instance_name_sanitizes_edge_display_names \
+      tests/test_accessory_driver.py::test_mdns_server_hostname_sanitizes_edge_display_names \
+      tests/test_accessory_driver.py::test_mdns_sanitization_uses_runtime_values_not_known_fixtures \
+      tests/test_packaging_metadata.py::test_setup_requires_zeroconf_032_or_newer \
+      tests/test_docs.py::test_readme_python_support_statement_updated \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
