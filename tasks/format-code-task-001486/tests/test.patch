diff --git a/tests/components/notify/test_legacy.py b/tests/components/notify/test_legacy.py
index 79a1b75dcae..0b81595920a 100644
--- a/tests/components/notify/test_legacy.py
+++ b/tests/components/notify/test_legacy.py
@@ -664,3 +664,81 @@ async def test_messages_to_targets_route(hass: HomeAssistant, tmp_path: Path) ->
         "my message",
         {"target": ["test target id"], "title": "my title", "data": {"hello": "world"}},
     )
+
+
+PARTIAL_TEMPLATE = "{% set value ="
+
+
+async def test_legacy_notify_partial_template_message_direct(
+    hass: HomeAssistant, tmp_path: Path
+) -> None:
+    """Direct legacy notify call: partial-template string in message is accepted."""
+    send_message_mock = await help_setup_notify(hass, tmp_path)
+    await hass.services.async_call(
+        notify.DOMAIN,
+        notify.SERVICE_NOTIFY,
+        {"message": PARTIAL_TEMPLATE, "title": "Plain title"},
+        blocking=True,
+    )
+    await hass.async_block_till_done()
+    send_message_mock.assert_called_once_with(
+        PARTIAL_TEMPLATE, {"title": "Plain title", "data": None}
+    )
+
+
+async def test_legacy_notify_partial_template_via_script(
+    hass: HomeAssistant, tmp_path: Path
+) -> None:
+    """Issue reproduction for legacy notify via script."""
+    send_message_mock = await help_setup_notify(hass, tmp_path)
+
+    await async_setup_component(
+        hass,
+        "script",
+        {
+            "script": {
+                "test_partial_legacy": {
+                    "sequence": [
+                        {
+                            "variables": {
+                                "partial_template": "{{ '{%' ~ ' set value = ' }}"
+                            }
+                        },
+                        {
+                            "service": "notify.notify",
+                            "data": {
+                                "title": "Template error example",
+                                "message": "{{ partial_template }}",
+                            },
+                        },
+                    ]
+                }
+            }
+        },
+    )
+    await hass.async_block_till_done()
+
+    await hass.services.async_call("script", "test_partial_legacy", blocking=True)
+    await hass.async_block_till_done()
+
+    send_message_mock.assert_called_once_with(
+        "{% set value =",
+        {"title": "Template error example", "data": None},
+    )
+
+
+async def test_legacy_notify_plain_string_preserved(
+    hass: HomeAssistant, tmp_path: Path
+) -> None:
+    """Preservation: plain strings still work for legacy notify."""
+    send_message_mock = await help_setup_notify(hass, tmp_path)
+    await hass.services.async_call(
+        notify.DOMAIN,
+        notify.SERVICE_NOTIFY,
+        {"message": "Just a message", "title": "Just a title"},
+        blocking=True,
+    )
+    await hass.async_block_till_done()
+    send_message_mock.assert_called_once_with(
+        "Just a message", {"title": "Just a title", "data": None}
+    )
diff --git a/tests/components/notify/test_persistent_notification.py b/tests/components/notify/test_persistent_notification.py
index d46b97e5bc2..5a861b208c8 100644
--- a/tests/components/notify/test_persistent_notification.py
+++ b/tests/components/notify/test_persistent_notification.py
@@ -7,6 +7,8 @@ from homeassistant.setup import async_setup_component
 
 from tests.common import async_get_persistent_notifications
 
+PARTIAL_TEMPLATE = "{% set value ="
+
 
 async def test_async_send_message(hass: HomeAssistant) -> None:
     """Test sending a message to notify.persistent_notification service."""
@@ -65,3 +67,106 @@ async def test_async_supports_notification_id(hass: HomeAssistant) -> None:
     notification = notifications[list(notifications)[0]]
     assert notification["message"] == "Goodbye"
     assert notification["title"] == "Notification was updated"
+
+
+async def test_pn_partial_template_message_direct(hass: HomeAssistant) -> None:
+    """Direct call: partial-template string in message must be accepted."""
+    await async_setup_component(hass, PN_DOMAIN, {"core": {}})
+    await async_setup_component(hass, notify.DOMAIN, {})
+    await hass.async_block_till_done()
+
+    await hass.services.async_call(
+        notify.DOMAIN,
+        notify.SERVICE_PERSISTENT_NOTIFICATION,
+        {"message": PARTIAL_TEMPLATE, "title": "Plain title"},
+        blocking=True,
+    )
+    await hass.async_block_till_done()
+
+    notifications = async_get_persistent_notifications(hass)
+    assert len(notifications) == 1
+    notification = notifications[list(notifications)[0]]
+    assert notification["message"] == PARTIAL_TEMPLATE
+    assert notification["title"] == "Plain title"
+
+
+async def test_pn_partial_template_title_direct(hass: HomeAssistant) -> None:
+    """Direct call: partial-template string in title must be accepted."""
+    await async_setup_component(hass, PN_DOMAIN, {"core": {}})
+    await async_setup_component(hass, notify.DOMAIN, {})
+    await hass.async_block_till_done()
+
+    await hass.services.async_call(
+        notify.DOMAIN,
+        notify.SERVICE_PERSISTENT_NOTIFICATION,
+        {"message": "Plain message", "title": PARTIAL_TEMPLATE},
+        blocking=True,
+    )
+    await hass.async_block_till_done()
+
+    notifications = async_get_persistent_notifications(hass)
+    assert len(notifications) == 1
+    notification = notifications[list(notifications)[0]]
+    assert notification["message"] == "Plain message"
+    assert notification["title"] == PARTIAL_TEMPLATE
+
+
+async def test_pn_partial_template_via_script(hass: HomeAssistant) -> None:
+    """Issue reproduction: script variable produces partial-template string."""
+    await async_setup_component(hass, PN_DOMAIN, {"core": {}})
+    await async_setup_component(hass, notify.DOMAIN, {})
+    await async_setup_component(
+        hass,
+        "script",
+        {
+            "script": {
+                "test_partial": {
+                    "sequence": [
+                        {
+                            "variables": {
+                                "partial_template": "{{ '{%' ~ ' set value = ' }}"
+                            }
+                        },
+                        {
+                            "service": "notify.persistent_notification",
+                            "data": {
+                                "title": "Template error example",
+                                "message": "{{ partial_template }}",
+                            },
+                        },
+                    ]
+                }
+            }
+        },
+    )
+    await hass.async_block_till_done()
+
+    await hass.services.async_call("script", "test_partial", blocking=True)
+    await hass.async_block_till_done()
+
+    notifications = async_get_persistent_notifications(hass)
+    assert len(notifications) == 1
+    notification = notifications[list(notifications)[0]]
+    assert notification["message"] == "{% set value ="
+    assert notification["title"] == "Template error example"
+
+
+async def test_pn_plain_string_preserved(hass: HomeAssistant) -> None:
+    """Preservation: plain strings still work for persistent_notification."""
+    await async_setup_component(hass, PN_DOMAIN, {"core": {}})
+    await async_setup_component(hass, notify.DOMAIN, {})
+    await hass.async_block_till_done()
+
+    await hass.services.async_call(
+        notify.DOMAIN,
+        notify.SERVICE_PERSISTENT_NOTIFICATION,
+        {"message": "Just a message", "title": "Just a title"},
+        blocking=True,
+    )
+    await hass.async_block_till_done()
+
+    notifications = async_get_persistent_notifications(hass)
+    assert len(notifications) == 1
+    notification = notifications[list(notifications)[0]]
+    assert notification["message"] == "Just a message"
+    assert notification["title"] == "Just a title"
