+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+export PYTHONPATH="/testbed/.venv/lib/python3.11/site-packages${PYTHONPATH:+:$PYTHONPATH}"
+
+
+
+
+
+
+
+python - <<'PY'
+import os
+root = "/testbed/.venv/lib/python3.11/site-packages"
+tag = ".cpython-311.pyc"
+for dirpath, _dirs, files in os.walk(root):
+    if os.path.basename(dirpath) != "__pycache__":
+        continue
+    parent = os.path.dirname(dirpath)
+    for f in files:
+        if not f.endswith(tag):
+            continue
+        base = f[:-len(tag)]
+        dst = os.path.join(parent, base + ".pyc")
+        if os.path.exists(os.path.join(parent, base + ".py")) or os.path.exists(dst):
+            continue
+        with open(os.path.join(dirpath, f), "rb") as r, open(dst, "wb") as w:
+            w.write(r.read())
+PY
+
+PYTEST="python -m pytest -p no:cacheprovider -q"
+
+
+$PYTEST mapproxy/test/unit/test_conf_validator.py
+
+
+$PYTEST mapproxy/test/unit/test_conf_validator_directory_layout.py
