+
+from __future__ import print_function
+
+import yaml
+
+from mapproxy.config.validator import validate_references
+
+
+SUPPORTED_LAYOUTS = ['tc', 'mp', 'tms', 'reverse_tms', 'quadkey', 'arcgis']
+
+
+class TestDirectoryLayoutValidation(object):
+    def _conf(self, caches_part):
+        base = yaml.safe_load('''
+            services:
+                wms:
+                    md:
+                        title: MapProxy
+            layers:
+                - name: one
+                  title: One
+                  sources: [one_cache]
+            sources:
+                one_source:
+                    type: wms
+                    req:
+                        url: http://localhost/service?
+                        layers: one
+        ''')
+        base.update(yaml.safe_load(caches_part))
+        return base
+
+    def _cache_with_layout(self, layout=None):
+        cache = {'type': 'file'}
+        if layout is not None:
+            cache['directory_layout'] = layout
+        return self._conf(yaml.safe_dump({
+            'caches': {
+                'one_cache': {
+                    'grids': ['GLOBAL_MERCATOR'],
+                    'cache': cache,
+                    'sources': ['one_source'],
+                }
+            }
+        }))
+
+    def test_no_directory_layout_is_valid(self):
+        conf = self._cache_with_layout(None)
+        assert validate_references(conf) == []
+
+    def test_supported_layouts_are_valid(self):
+        for layout in SUPPORTED_LAYOUTS:
+            conf = self._cache_with_layout(layout)
+            errors = validate_references(conf)
+            assert errors == [], "layout %r should be valid, got %r" % (layout, errors)
+
+    def test_unsupported_layout_is_reported(self):
+        conf = self._cache_with_layout('foobar')
+        errors = validate_references(conf)
+        assert len(errors) == 1
+        assert 'one_cache' in errors[0]
+        assert 'foobar' in errors[0]
+
+    def test_layout_match_is_case_sensitive(self):
+        for bad in ['TMS', 'Quadkey', 'Reverse_TMS']:
+            conf = self._cache_with_layout(bad)
+            errors = validate_references(conf)
+            assert len(errors) == 1, "layout %r should be invalid" % bad
+            assert 'one_cache' in errors[0]
+            assert bad in errors[0]
+
+    def test_each_offending_cache_reported_independently(self):
+        conf = self._conf(yaml.safe_dump({
+            'caches': {
+                'one_cache': {
+                    'grids': ['GLOBAL_MERCATOR'],
+                    'cache': {'type': 'file', 'directory_layout': 'bogus_a'},
+                    'sources': ['one_source'],
+                },
+                'two_cache': {
+                    'grids': ['GLOBAL_MERCATOR'],
+                    'cache': {'type': 'file', 'directory_layout': 'bogus_b'},
+                    'sources': ['one_source'],
+                },
+            }
+        }))
+
+        conf['layers'] = [
+            {'name': 'one', 'title': 'One', 'sources': ['one_cache']},
+            {'name': 'two', 'title': 'Two', 'sources': ['two_cache']},
+        ]
+        errors = validate_references(conf)
+        assert len(errors) == 2
+        joined = '\n'.join(errors)
+        assert 'one_cache' in joined and 'bogus_a' in joined
+        assert 'two_cache' in joined and 'bogus_b' in joined
+
+    def test_valid_layout_does_not_mask_other_errors(self):
+
+
+        conf = self._conf(yaml.safe_dump({
+            'caches': {
+                'one_cache': {
+                    'grids': ['GLOBAL_MERCATOR'],
+                    'cache': {'type': 'file', 'directory_layout': 'tms'},
+                    'sources': ['missing_source'],
+                }
+            }
+        }))
+        errors = validate_references(conf)
+        assert errors == [
+            "Source 'missing_source' for cache 'one_cache' not found in config"
+        ]
