diff --git a/libbeat/common/dtfmt/codespec_fraction_zone_test.go b/libbeat/common/dtfmt/codespec_fraction_zone_test.go
new file mode 100644
index 0000000000..784d779950
--- /dev/null
+++ b/libbeat/common/dtfmt/codespec_fraction_zone_test.go
@@ -0,0 +1,117 @@
+package dtfmt_test
+
+import (
+	"bytes"
+	"testing"
+	"time"
+
+	"github.com/elastic/beats/libbeat/common/dtfmt"
+)
+
+func codespecFormat(t *testing.T, value time.Time, pattern string) string {
+	t.Helper()
+	got, err := dtfmt.Format(value, pattern)
+	if err != nil {
+		t.Fatalf("Format(%q) returned error: %v", pattern, err)
+	}
+	return got
+}
+
+func TestCodeSpecFractionalSecondWidths(t *testing.T) {
+	value := time.Date(2024, time.February, 3, 4, 5, 6, 987654321, time.UTC)
+	tests := []struct {
+		pattern string
+		want    string
+	}{
+		{"S", "9"},
+		{"SS", "98"},
+		{"SSS", "987"},
+		{"SSSSSS", "987654"},
+		{"SSSSSSSSS", "987654321"},
+		{"HH:mm:ss.SSSSSSSSS", "04:05:06.987654321"},
+	}
+	for _, test := range tests {
+		if got := codespecFormat(t, value, test.pattern); got != test.want {
+			t.Errorf("pattern %q: got %q, want %q", test.pattern, got, test.want)
+		}
+	}
+
+	lowPrecision := time.Date(2024, time.February, 3, 4, 5, 6, 5_000_000, time.UTC)
+	if got := codespecFormat(t, lowPrecision, "S|SSS|SSSSSSSSS"); got != "0|005|005000000" {
+		t.Errorf("fractional seconds must be zero-padded without rounding: got %q", got)
+	}
+}
+
+func TestCodeSpecFractionalSecondWidthValidation(t *testing.T) {
+	if _, err := dtfmt.NewFormatter("SSSSSSSSSS"); err == nil {
+		t.Fatal("NewFormatter accepted a fractional-second token wider than 9 digits")
+	}
+}
+
+func TestCodeSpecNumericZoneOffsets(t *testing.T) {
+	tests := []struct {
+		name   string
+		offset int
+		want   string
+	}{
+		{"east", 5*60*60 + 45*60, "+0545|+05:45"},
+		{"west", -(3*60*60 + 30*60), "-0330|-03:30"},
+		{"utc", 0, "+0000|+00:00"},
+	}
+	for _, test := range tests {
+		value := time.Date(2024, time.June, 7, 8, 9, 10, 0, time.FixedZone(test.name, test.offset))
+		if got := codespecFormat(t, value, "Z|ZZ"); got != test.want {
+			t.Errorf("%s offset: got %q, want %q", test.name, got, test.want)
+		}
+	}
+}
+
+func TestCodeSpecZoneIdentityAndAbbreviation(t *testing.T) {
+	loc, err := time.LoadLocation("America/St_Johns")
+	if err != nil {
+		t.Fatalf("load deterministic test location: %v", err)
+	}
+	value := time.Date(2024, time.June, 7, 8, 9, 10, 0, loc)
+	if got := codespecFormat(t, value, "z|zz|zzz|zzzz|zzzzz|ZZZ|ZZZZZ"); got != "NDT|NDT|NDT|NDT|NDT|America/St_Johns|America/St_Johns" {
+		t.Errorf("zone name/id formatting mismatch: got %q", got)
+	}
+
+	loc = time.FixedZone("Custom/Research_Base", -(9*60*60 + 30*60))
+	value = time.Date(2024, time.December, 31, 23, 58, 0, 0, loc)
+	if got := codespecFormat(t, value, "yyyy-MM-dd HH:mm z Z ZZ ZZZ"); got != "2024-12-31 23:58 Custom/Research_Base -0930 -09:30 Custom/Research_Base" {
+		t.Errorf("formatter did not use the supplied time's zone data: got %q", got)
+	}
+}
+
+func TestCodeSpecZoneAndFractionLiterals(t *testing.T) {
+	value := time.Date(2024, time.January, 2, 3, 4, 5, 120_000_000, time.FixedZone("XST", 90*60))
+	if got := codespecFormat(t, value, "'SSSSSSSSSS ZZZZ zzzz' S 'at' Z 'named' z"); got != "SSSSSSSSSS ZZZZ zzzz 1 at +0130 named XST" {
+		t.Errorf("tokens and quoted literals did not compose correctly: got %q", got)
+	}
+}
+
+func TestCodeSpecFormatterOutputAPIsAgree(t *testing.T) {
+	value := time.Date(2030, time.November, 12, 13, 14, 15, 42_001_009, time.FixedZone("LAB", -(2*60*60+30*60)))
+	formatter, err := dtfmt.NewFormatter("yyyy-MM-dd'T'HH:mm:ss.SSSSSSSSS ZZ z")
+	if err != nil {
+		t.Fatalf("NewFormatter returned error: %v", err)
+	}
+	want := "2030-11-12T13:14:15.042001009 -02:30 LAB"
+
+	formatted, err := formatter.Format(value)
+	if err != nil || formatted != want {
+		t.Fatalf("Formatter.Format: got %q, %v; want %q, nil", formatted, err, want)
+	}
+
+	prefix := []byte("prefix:")
+	appended, err := formatter.AppendTo(prefix, value)
+	if err != nil || string(appended) != "prefix:"+want {
+		t.Errorf("AppendTo: got %q, %v; want %q, nil", appended, err, "prefix:"+want)
+	}
+
+	var dst bytes.Buffer
+	n, err := formatter.Write(&dst, value)
+	if err != nil || dst.String() != want || n != len(want) {
+		t.Errorf("Write: got (%d, %q, %v); want (%d, %q, nil)", n, dst.String(), err, len(want), want)
+	}
+}
