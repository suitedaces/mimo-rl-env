+#!/bin/bash
+set -euo pipefail
+
+
+REPO_GOPATH="$(mktemp -d)"
+VENDOR_GOPATH="$(mktemp -d)"
+mkdir -p "${REPO_GOPATH}/src/github.com/elastic"
+ln -s "$(pwd)" "${REPO_GOPATH}/src/github.com/elastic/beats"
+ln -s "$(pwd)/vendor" "${VENDOR_GOPATH}/src"
+GOROOT=/opt/go-1.20 \
+  GOPATH="${REPO_GOPATH}:${VENDOR_GOPATH}" \
+  GO111MODULE=off \
+  /opt/go-1.20/bin/go test github.com/elastic/beats/libbeat/common/dtfmt
