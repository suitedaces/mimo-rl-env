diff --git a/usercase-test-coderl/test_six_month_cycle_agent.py b/usercase-test-coderl/test_six_month_cycle_agent.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_six_month_cycle_agent.py
@@ -0,0 +1,219 @@
+
+
+import sys
+
+import pytest
+
+sys.path.insert(0, "/workspace/repo")
+
+from algotrading.agents.six_month_cycle_agent import SixMonthCycle_Agent
+
+
+def _run_steps(agent, ticks):
+    return [agent.step(price, date) for price, date in ticks]
+
+
+def test_concrete_rising_session_buys_in_november_and_reports_buy_macd():
+
+
+
+
+    agent = SixMonthCycle_Agent(3, 1, 3, 2, 0, 0)
+
+    actions = _run_steps(
+        agent,
+        [(10, "2020-09-01"), (11, "2020-10-01"), (12, "2020-11-01")],
+    )
+
+    assert actions == [0, 0, 1]
+    assert agent.get_macd_signal() == "buy"
+
+
+def test_concrete_falling_session_sells_in_may_and_reports_sell_macd():
+
+
+
+
+    agent = SixMonthCycle_Agent(3, 1, 3, 2, 0, 0)
+
+    actions = _run_steps(
+        agent,
+        [(12, "2020-03-01"), (11, "2020-04-01"), (10, "2020-05-01")],
+    )
+
+    assert actions == [0, 0, -1]
+    assert agent.get_macd_signal() == "sell"
+
+
+def test_sell_season_holds_when_macd_confirms_strength():
+
+
+
+
+    agent = SixMonthCycle_Agent(3, 1, 3, 2, 0, 0)
+
+    actions = _run_steps(
+        agent,
+        [(10, "2020-03-01"), (11, "2020-04-01"), (12, "2020-05-01")],
+    )
+
+    assert actions == [0, 0, 0]
+    assert agent.get_macd_signal() == "buy"
+
+
+def test_december_buys_even_when_macd_signal_is_sell():
+
+
+
+
+    agent = SixMonthCycle_Agent(3, 1, 3, 2, 0, 0)
+
+    actions = _run_steps(
+        agent,
+        [(12, "2020-10-01"), (11, "2020-11-01"), (10, "2020-12-01")],
+    )
+
+    assert actions == [0, 0, 1]
+    assert agent.get_macd_signal() == "sell"
+
+
+def test_january_through_april_buys_only_with_buy_macd_confirmation():
+
+
+
+
+    agent = SixMonthCycle_Agent(3, 1, 3, 2, 0, 0)
+
+    actions = _run_steps(
+        agent,
+        [(10, "2019-11-01"), (11, "2019-12-01"), (12, "2020-01-01")],
+    )
+
+    assert actions == [0, 0, 1]
+    assert agent.get_macd_signal() == "buy"
+
+
+def test_january_through_april_holds_without_buy_macd_confirmation():
+
+
+
+
+    agent = SixMonthCycle_Agent(3, 1, 3, 2, 0, 0)
+
+    actions = _run_steps(
+        agent,
+        [(12, "2020-02-01"), (11, "2020-03-01"), (10, "2020-04-01")],
+    )
+
+    assert actions == [0, 0, 0]
+    assert agent.get_macd_signal() == "sell"
+
+
+def test_may_through_october_sells_on_october_boundary_with_sell_macd():
+
+
+
+
+    agent = SixMonthCycle_Agent(3, 1, 3, 2, 0, 0)
+
+    actions = _run_steps(
+        agent,
+        [(12, "2020-08-01"), (11, "2020-09-01"), (10, "2020-10-01")],
+    )
+
+    assert actions == [0, 0, -1]
+    assert agent.get_macd_signal() == "sell"
+
+
+def test_nonzero_thresholds_can_turn_rising_macd_into_hold():
+
+
+
+
+    agent = SixMonthCycle_Agent(3, 1, 3, 2, 0.5, 0)
+
+    actions = _run_steps(
+        agent,
+        [(10, "2020-01-01"), (11, "2020-02-01"), (12, "2020-03-01")],
+    )
+
+    assert actions == [0, 0, 0]
+    assert agent.get_macd_signal() == "hold"
+
+
+def test_rolling_window_uses_recent_prices_after_more_than_window_size_steps():
+
+
+
+
+    agent = SixMonthCycle_Agent(3, 1, 3, 2, 0, 0)
+
+    actions = _run_steps(
+        agent,
+        [
+            (10, "2020-01-01"),
+            (11, "2020-02-01"),
+            (12, "2020-03-01"),
+            (10, "2020-04-01"),
+        ],
+    )
+
+    assert actions == [0, 0, 1, 0]
+    assert agent.get_macd_signal() == "sell"
+
+
+def test_unparseable_dates_are_ignored_until_full_then_raise_value_error():
+
+
+
+
+    agent = SixMonthCycle_Agent(3, 1, 3, 2, 0, 0)
+
+    assert agent.step(10, "not-a-date") == 0
+    assert agent.step(11, "2020-x-01") == 0
+    with pytest.raises(ValueError):
+        agent.step(12, "2020-x-01")
+
+
+def test_separate_instances_keep_independent_history_and_parameters():
+
+
+
+
+    rising = SixMonthCycle_Agent(3, 1, 3, 2, 0, 0)
+    falling = SixMonthCycle_Agent(3, 1, 3, 2, 0, 0)
+    thresholded = SixMonthCycle_Agent(3, 1, 3, 2, 0.5, 0)
+
+    assert rising.step(10, "2020-01-01") == 0
+    assert falling.step(12, "2020-05-01") == 0
+    assert thresholded.step(10, "2020-01-01") == 0
+    assert rising.step(11, "2020-02-01") == 0
+    assert falling.step(11, "2020-06-01") == 0
+    assert thresholded.step(11, "2020-02-01") == 0
+
+    assert falling.step(10, "2020-07-01") == -1
+    assert falling.get_macd_signal() == "sell"
+    assert rising.step(12, "2020-03-01") == 1
+    assert rising.get_macd_signal() == "buy"
+    assert thresholded.step(12, "2020-03-01") == 0
+    assert thresholded.get_macd_signal() == "hold"
+
+
+def test_repeated_short_sessions_use_independent_public_state():
+
+
+
+
+    completed_sessions = 0
+    for _ in range(150):
+        agent = SixMonthCycle_Agent(3, 1, 3, 2, 0, 0)
+        assert agent.step(10, "2020-01-01") == 0
+        assert agent.step(11, "2020-02-01") == 0
+        assert agent.step(12, "2020-03-01") == 1
+        assert agent.get_macd_signal() == "buy"
+        del agent
+        completed_sessions += 1
+
+
+
+    assert completed_sessions == 150
