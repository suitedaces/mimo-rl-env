@@ -160,6 +160,70 @@ exclude =
     os.unlink(os.path.join(workspace.root_path, "setup.cfg"))
 
 
+def _make_doc(workspace):
+
+    source = "line1\nline2\nline3\nline4\n"
+    return Document('', workspace, source)
+
+
+def _stdout_line(line_no, col, code, msg):
+    return "file.py:{ln}:{c}: {code} {msg}".format(ln=line_no, c=col, code=code, msg=msg)
+
+
+def test_parse_stdout_f401_unused_import_is_error(workspace):
+    doc = _make_doc(workspace)
+    stdout = _stdout_line(1, 1, "F401", "'os' imported but unused") + "\n"
+    diags = flake8_lint.parse_stdout(doc, stdout)
+    assert len(diags) == 1
+    assert diags[0]['code'] == 'F401'
+    assert diags[0]['severity'] == lsp.DiagnosticSeverity.Error
+
+
+def test_parse_stdout_f841_unused_variable_is_error(workspace):
+    doc = _make_doc(workspace)
+    stdout = _stdout_line(2, 5, "F841", "local variable 'a' is assigned to but never used") + "\n"
+    diags = flake8_lint.parse_stdout(doc, stdout)
+    assert len(diags) == 1
+    assert diags[0]['code'] == 'F841'
+    assert diags[0]['severity'] == lsp.DiagnosticSeverity.Error
+
+
+def test_parse_stdout_f821_undefined_name_is_error(workspace):
+    doc = _make_doc(workspace)
+    stdout = _stdout_line(1, 1, "F821", "undefined name 'foo'") + "\n"
+    diags = flake8_lint.parse_stdout(doc, stdout)
+    assert len(diags) == 1
+    assert diags[0]['code'] == 'F821'
+    assert diags[0]['severity'] == lsp.DiagnosticSeverity.Error
+
+
+def test_parse_stdout_e999_syntax_error_is_error(workspace):
+    doc = _make_doc(workspace)
+    stdout = _stdout_line(1, 1, "E999", "SyntaxError: invalid syntax") + "\n"
+    diags = flake8_lint.parse_stdout(doc, stdout)
+    assert len(diags) == 1
+    assert diags[0]['code'] == 'E999'
+    assert diags[0]['severity'] == lsp.DiagnosticSeverity.Error
+
+
+def test_parse_stdout_w291_trailing_whitespace_is_warning(workspace):
+    doc = _make_doc(workspace)
+    stdout = _stdout_line(1, 6, "W291", "trailing whitespace") + "\n"
+    diags = flake8_lint.parse_stdout(doc, stdout)
+    assert len(diags) == 1
+    assert diags[0]['code'] == 'W291'
+    assert diags[0]['severity'] == lsp.DiagnosticSeverity.Warning
+
+
+def test_parse_stdout_c901_mccabe_complexity_is_warning(workspace):
+    doc = _make_doc(workspace)
+    stdout = _stdout_line(1, 1, "C901", "'func' is too complex (11)") + "\n"
+    diags = flake8_lint.parse_stdout(doc, stdout)
+    assert len(diags) == 1
+    assert diags[0]['code'] == 'C901'
+    assert diags[0]['severity'] == lsp.DiagnosticSeverity.Warning
+
+
