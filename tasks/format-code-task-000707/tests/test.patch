diff --git a/test/has-length.js b/test/has-length.js
new file mode 100644
index 0000000..dd05e38
--- /dev/null
+++ b/test/has-length.js
@@ -0,0 +1,125 @@
+import test from 'ava'
+
+import {describe, format, serialize} from '..'
+
+
+
+
+
+
+test('describe({length: 12345678}) does not treat plain object as a list', t => {
+  const descriptor = describe({length: 12345678})
+  t.false(descriptor.isList)
+  t.false(descriptor.isArray)
+})
+
+test('serialize(describe({length: 12345678})) does not OOM and completes quickly', t => {
+  const start = Date.now()
+  const descriptor = describe({length: 12345678})
+  const buffer = serialize(descriptor)
+  const elapsed = Date.now() - start
+  t.true(Buffer.isBuffer(buffer))
+
+
+  t.true(elapsed < 2000, `serialize took ${elapsed}ms`)
+
+  t.true(buffer.length < 1024, `buffer length ${buffer.length}`)
+})
+
+test('format({length: 5}) renders as plain object, not as a list with undefined entries', t => {
+  const out = format({length: 5})
+
+
+  t.false(out.includes('undefined'), `unexpected undefined entries in output: ${out}`)
+  t.true(out.startsWith('{'), `expected plain object form, got: ${out}`)
+  t.true(out.includes('length: 5'))
+})
+
+test('format on issue example: array of recording objects with length field', t => {
+  const value = [
+    {title: 'Airbag', length: 284400},
+    {title: 'Paranoid Android', length: 383493}
+  ]
+  const start = Date.now()
+  const out = format(value)
+  const elapsed = Date.now() - start
+  t.true(elapsed < 2000, `format took ${elapsed}ms`)
+  t.true(out.includes('Airbag'))
+  t.true(out.includes('Paranoid Android'))
+  t.true(out.includes('284400'))
+  t.true(out.includes('383493'))
+
+  t.false(out.includes('undefined'), `unexpected undefined entries in: ${out}`)
+})
+
+test('format({length: -1}) treats negative length as plain object (not a list)', t => {
+  const out = format({length: -1})
+  t.true(out.startsWith('{'), `expected plain object form, got: ${out}`)
+  t.true(out.includes('length: -1'))
+})
+
+test('format({length: 1.5}) treats non-integer length as plain object (not a list)', t => {
+  const out = format({length: 1.5})
+  t.true(out.startsWith('{'), `expected plain object form, got: ${out}`)
+  t.true(out.includes('length: 1.5'))
+})
+
+test('format({length: NaN}) treats NaN length as plain object (not a list)', t => {
+  const out = format({length: NaN})
+  t.true(out.startsWith('{'), `expected plain object form, got: ${out}`)
+  t.true(out.includes('length: NaN'))
+})
+
+
+
+test('format([]) still works (real empty array)', t => {
+  const out = format([])
+  t.is(out, '[]')
+})
+
+test('format([1, 2, 3]) still works (real array preserved)', t => {
+  const out = format([1, 2, 3])
+  t.true(out.startsWith('['))
+  t.true(out.includes('1,'))
+  t.true(out.includes('2,'))
+  t.true(out.includes('3,'))
+})
+
+test('describe of arguments object is still treated as a list', t => {
+  ;(function (a, b, c) {
+    const descriptor = describe(arguments)
+    t.true(descriptor.isList)
+  })('foo', 'bar', 'baz')
+})
+
+test('format of funky object with non-enumerable length and indexed entries still works as list', t => {
+  const funky = {0: 'first', 1: 'second', foo: 'bar'}
+  Object.defineProperty(funky, 'length', {value: 2})
+  const descriptor = describe(funky)
+  t.true(descriptor.isList)
+  const out = format(funky)
+  t.true(out.startsWith('['), `expected list form, got: ${out}`)
+  t.true(out.includes("'first'"))
+  t.true(out.includes("'second'"))
+  t.true(out.includes("foo:"))
+})
+
+test('describe({length: 3, 0: a, 1: b, 2: c}) is treated as a list (own indexed entries)', t => {
+  const arrLike = {length: 3, 0: 'a', 1: 'b', 2: 'c'}
+  const descriptor = describe(arrLike)
+  t.true(descriptor.isList)
+  const out = format(arrLike)
+  t.true(out.startsWith('['), `expected list form, got: ${out}`)
+  t.true(out.includes("'a'"))
+  t.true(out.includes("'b'"))
+  t.true(out.includes("'c'"))
+  t.true(out.includes('length: 3'))
+})
+
+test('describe({length: 0}) is treated as an empty list', t => {
+  const descriptor = describe({length: 0})
+  t.true(descriptor.isList)
+  const out = format({length: 0})
+  t.true(out.startsWith('['), `expected list form, got: ${out}`)
+  t.true(out.includes('length: 0'))
+})
