+#!/bin/bash
+set -euo pipefail
+
+
+if [[ -x ".venv/bin/pytest" ]]; then
+  .venv/bin/pytest -q tests/store/model_registry/test_timestamp_contract.py
+else
+  pytest -q tests/store/model_registry/test_timestamp_contract.py
+fi
