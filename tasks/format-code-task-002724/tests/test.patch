diff --git a/test/dialects/duckdb_map_test.py b/test/dialects/duckdb_map_test.py
new file mode 100644
index 000000000..e74e65c0e
--- /dev/null
+++ b/test/dialects/duckdb_map_test.py
@@ -0,0 +1,90 @@
+
+
+
+
+
+
+import pytest
+
+from sqlfluff.core import FluffConfig, Linter
+
+
+@pytest.fixture(scope="module")
+def linter():
+    config = FluffConfig(overrides={"dialect": "duckdb"})
+    return Linter(config=config)
+
+
+def _parse_clean(linter, sql):
+    parsed = linter.parse_string(sql)
+    assert not parsed.violations, (
+        f"Unexpected parse violations for {sql!r}: {parsed.violations}"
+    )
+
+    unparsable = list(parsed.tree.recursive_crawl("unparsable"))
+    assert not unparsable, (
+        f"Found unparsable segments for {sql!r}: "
+        f"{[u.raw for u in unparsable]}"
+    )
+    return parsed.tree
+
+
+def test_create_table_map_varchar_varchar(linter):
+
+    tree = _parse_clean(
+        linter, "CREATE TABLE map (tags MAP(VARCHAR, VARCHAR));"
+    )
+
+    assert list(tree.recursive_crawl("map_type")), (
+        "Expected a map_type segment in the parse tree"
+    )
+
+
+def test_create_table_map_integer_varchar(linter):
+
+    _parse_clean(
+        linter, "CREATE TABLE m (col MAP(INTEGER, VARCHAR));"
+    )
+
+
+def test_create_table_map_with_struct_value(linter):
+
+    _parse_clean(
+        linter,
+        "CREATE TABLE m (col MAP(VARCHAR, STRUCT(a INTEGER, b VARCHAR)));",
+    )
+
+
+def test_create_table_nested_map(linter):
+
+    _parse_clean(
+        linter,
+        "CREATE TABLE m (col MAP(VARCHAR, MAP(VARCHAR, INTEGER)));",
+    )
+
+
+def test_cast_to_map_using_cast_keyword(linter):
+
+    _parse_clean(
+        linter, "SELECT CAST(x AS MAP(VARCHAR, INTEGER)) FROM t;"
+    )
+
+
+def test_cast_to_map_using_double_colon(linter):
+
+    _parse_clean(
+        linter, "SELECT x::MAP(VARCHAR, INTEGER) FROM t;"
+    )
+
+
+def test_map_function_call_still_parses(linter):
+
+
+
+
+
+
+
+    _parse_clean(
+        linter, "SELECT MAP(['a', 'b'], [1, 2]);"
+    )
