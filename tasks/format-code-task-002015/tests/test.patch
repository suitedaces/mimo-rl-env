diff --git a/napari/layers/points/_tests/test_points.py b/napari/layers/points/_tests/test_points.py
index 3573adb2..eb3f4d7a 100644
--- a/napari/layers/points/_tests/test_points.py
+++ b/napari/layers/points/_tests/test_points.py
@@ -1691,3 +1691,93 @@ def test_set_face_color_mode_after_set_properties():
         current_value=first_property_values[-1],
     )
     assert points._face.color_properties == expected_properties
+
+
+def test_remove_selected_preserves_value_when_hovering_unselected():
+    """Hovering an unselected point and deleting selected points should
+    preserve the hover (_value not clobbered to None)."""
+    data = np.array([[0.0, 0.0], [10.0, 10.0], [20.0, 20.0]])
+    layer = Points(data)
+
+
+    layer._position = (20.0, 20.0)
+    layer._value = 2
+    layer.selected_data = {0}
+    layer.remove_selected()
+
+
+
+
+    assert layer._value is not None
+
+
+def test_remove_selected_clears_value_when_hovering_selected():
+    """If the hovered point is among the selected (deleted) points,
+    _value must be cleared to None."""
+    data = np.array([[0.0, 0.0], [10.0, 10.0], [20.0, 20.0]])
+    layer = Points(data)
+
+    layer._position = (10.0, 10.0)
+    layer._value = 1
+    layer.selected_data = {1}
+    layer.remove_selected()
+
+    assert layer._value is None
+
+
+def test_remove_selected_value_none_stays_none():
+    """If nothing was hovered, _value should remain None after deletion."""
+    data = np.array([[0.0, 0.0], [10.0, 10.0], [20.0, 20.0]])
+    layer = Points(data)
+
+    assert layer._value is None
+    layer.selected_data = {0}
+    layer.remove_selected()
+
+    assert layer._value is None
+
+
+def test_remove_selected_preserves_value_with_multiple_selected_unselected_hover():
+    """Hovering an unselected point while several other points are selected
+    must preserve hover (only the deleted ones should null _value)."""
+    data = np.array(
+        [[0.0, 0.0], [10.0, 10.0], [20.0, 20.0], [30.0, 30.0], [40.0, 40.0]]
+    )
+    layer = Points(data)
+
+
+    layer._position = (40.0, 40.0)
+    layer._value = 4
+    layer.selected_data = {0, 1, 2}
+    layer.remove_selected()
+
+
+    assert layer._value is not None
+
+
+def test_remove_selected_get_value_does_not_raise_after_hover_unselected():
+    """Reproduce the issue: after removing selected points while hovering an
+    unselected one, get_value at a valid position must not raise IndexError."""
+    data = np.array([[0.0, 0.0], [10.0, 10.0], [20.0, 20.0]])
+    layer = Points(data)
+
+    layer._value = 2
+    layer.selected_data = {0}
+    layer.remove_selected()
+
+
+    val = layer.get_value((10.0, 10.0))
+    assert val == 0
+
+
+def test_remove_selected_nothing_selected_preserves_value():
+    """remove_selected with empty selection is a no-op and must not touch _value."""
+    data = np.array([[0.0, 0.0], [10.0, 10.0], [20.0, 20.0]])
+    layer = Points(data)
+
+    layer._value = 1
+    layer.selected_data = set()
+    layer.remove_selected()
+
+    assert layer._value == 1
+    assert len(layer.data) == 3
