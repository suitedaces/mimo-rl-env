@@ -908,3 +908,139 @@ def test_batch_processor_error_when_entire_batch_fails(sqs_event_factory, record
 
     # THEN raise BatchProcessingError
     assert "All records failed processing. " in str(e.value)
+
+
+@pytest.fixture(scope="module")
+def lambda_context():
+    from aws_lambda_powertools.utilities.typing import LambdaContext
+
+    ctx = LambdaContext()
+    ctx._function_name = "test-fn"
+    ctx._function_version = "$LATEST"
+    ctx._invoked_function_arn = "arn:aws:lambda:us-east-1:123456789012:function:test-fn"
+    ctx._memory_limit_in_mb = 128
+    ctx._aws_request_id = "abc-123-fixture"
+    ctx._log_group_name = "/aws/lambda/test-fn"
+    ctx._log_stream_name = "stream-1"
+    return ctx
+
+
+def test_batch_processor_decorator_injects_lambda_context_when_handler_accepts_it(
+    sqs_event_factory, lambda_context
+):
+
+    seen = {}
+
+    def record_handler(record, lambda_context):
+        seen["aws_request_id"] = lambda_context.aws_request_id
+        return record["body"]
+
+    first_record = sqs_event_factory("success")
+    second_record = sqs_event_factory("success")
+    event = {"Records": [first_record, second_record]}
+    processor = BatchProcessor(event_type=EventType.SQS)
+
+    @batch_processor(record_handler=record_handler, processor=processor)
+    def lambda_handler(event, context):
+        return processor.response()
+
+
+    result = lambda_handler(event, lambda_context)
+
+
+    assert seen["aws_request_id"] == "abc-123-fixture"
+    assert result["batchItemFailures"] == []
+
+
+def test_batch_processor_decorator_with_handler_without_lambda_context_param_is_backward_compatible(
+    sqs_event_factory, lambda_context
+):
+
+    def record_handler(record):
+        return record["body"]
+
+    first_record = sqs_event_factory("success")
+    second_record = sqs_event_factory("success")
+    event = {"Records": [first_record, second_record]}
+    processor = BatchProcessor(event_type=EventType.SQS)
+
+    @batch_processor(record_handler=record_handler, processor=processor)
+    def lambda_handler(event, context):
+        return processor.response()
+
+
+    result = lambda_handler(event, lambda_context)
+
+
+    assert result["batchItemFailures"] == []
+
+
+def test_batch_processor_context_manager_injects_lambda_context_when_handler_accepts_it(
+    sqs_event_factory, lambda_context
+):
+
+    seen = {}
+
+    def record_handler(record, lambda_context):
+        seen["request_id"] = lambda_context.aws_request_id
+        return record["body"]
+
+    first_record = sqs_event_factory("success")
+    records = [first_record]
+    processor = BatchProcessor(event_type=EventType.SQS)
+
+
+    with processor(records, record_handler, lambda_context=lambda_context) as batch:
+        processed = batch.process()
+
+
+    assert seen["request_id"] == "abc-123-fixture"
+    assert processor.response() == {"batchItemFailures": []}
+    assert processed[0][0] == "success"
+
+
+def test_batch_processor_context_manager_without_lambda_context_remains_backward_compatible(
+    sqs_event_factory, record_handler
+):
+
+    first_record = SQSRecord(sqs_event_factory("success"))
+    records = [first_record.raw_event]
+    processor = BatchProcessor(event_type=EventType.SQS)
+
+
+    with processor(records, record_handler) as batch:
+        processed = batch.process()
+
+
+    assert processed[0][0] == "success"
+    assert processor.response() == {"batchItemFailures": []}
+
+
+def test_batch_processor_handler_uses_lambda_context_for_partial_failure(
+    sqs_event_factory, lambda_context
+):
+
+    call_count = {"n": 0}
+
+    def record_handler(record, lambda_context):
+
+        assert lambda_context.aws_request_id == "abc-123-fixture"
+        call_count["n"] += 1
+        if call_count["n"] == 1:
+            raise Exception("simulated fail using context info")
+        return record["body"]
+
+    first_record = sqs_event_factory("a")
+    second_record = sqs_event_factory("b")
+    event = {"Records": [first_record, second_record]}
+    processor = BatchProcessor(event_type=EventType.SQS)
+
+    @batch_processor(record_handler=record_handler, processor=processor)
+    def lambda_handler(event, context):
+        return processor.response()
+
+
+    result = lambda_handler(event, lambda_context)
+
+
+    assert result["batchItemFailures"] == [{"itemIdentifier": first_record["messageId"]}]
