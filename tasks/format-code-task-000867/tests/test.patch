+
+it("issue202: renders view when resultSearchTerm is empty but results exist (filter case)", () => {
+  let viewProps;
+  shallow(
+    <PagingInfoContainer
+      {...{
+        ...params,
+        resultSearchTerm: "",
+        results: [{}, {}]
+      }}
+      view={props => {
+        viewProps = props;
+        return null;
+      }}
+    />
+  );
+  expect(viewProps).toBeDefined();
+  expect(viewProps.totalResults).toEqual(100);
+});
