@@ -0,0 +1,93 @@
+'use strict';
+
+var expect  = require('chai').expect;
+var through = require('through');
+var EOL     = require('os').EOL;
+var chalk   = require('chalk');
+var UI      = require('../../../lib/ui');
+var BuildError = require('../../helpers/build-error');
+
+function makeUI(writeLevel) {
+  var captured = { output: '', error: '' };
+  var ui = new UI({
+    inputStream: through(),
+    outputStream: through(function(data) { captured.output += data; }),
+    errorStream:  through(function(data) { captured.error += data; }),
+    writeLevel: writeLevel
+  });
+  return { ui: ui, captured: captured };
+}
+
+describe('UI streams (errorStream)', function() {
+  describe('write()', function() {
+    it('writeLevel ERROR routes to errorStream not outputStream', function() {
+      var setup = makeUI();
+      setup.ui.write('boom', 'ERROR');
+      expect(setup.captured.error).to.equal('boom');
+      expect(setup.captured.output).to.equal('');
+    });
+
+    it('writeLevel INFO routes to outputStream not errorStream', function() {
+      var setup = makeUI();
+      setup.ui.write('hello', 'INFO');
+      expect(setup.captured.output).to.equal('hello');
+      expect(setup.captured.error).to.equal('');
+    });
+
+    it('writeLevel WARNING routes to outputStream not errorStream', function() {
+      var setup = makeUI();
+      setup.ui.write('careful', 'WARNING');
+      expect(setup.captured.output).to.equal('careful');
+      expect(setup.captured.error).to.equal('');
+    });
+
+    it('default writeLevel (no arg) routes to outputStream not errorStream', function() {
+      var setup = makeUI();
+      setup.ui.write('plain');
+      expect(setup.captured.output).to.equal('plain');
+      expect(setup.captured.error).to.equal('');
+    });
+  });
+
+  describe('writeLine()', function() {
+    it('writeLevel ERROR routes to errorStream with EOL appended', function() {
+      var setup = makeUI();
+      setup.ui.writeLine('bad thing', 'ERROR');
+      expect(setup.captured.error).to.equal('bad thing' + EOL);
+      expect(setup.captured.output).to.equal('');
+    });
+
+    it('writeLevel INFO routes to outputStream not errorStream', function() {
+      var setup = makeUI();
+      setup.ui.writeLine('good', 'INFO');
+      expect(setup.captured.output).to.equal('good' + EOL);
+      expect(setup.captured.error).to.equal('');
+    });
+
+    it('default writeLevel routes to outputStream', function() {
+      var setup = makeUI();
+      setup.ui.writeLine('default');
+      expect(setup.captured.output).to.equal('default' + EOL);
+      expect(setup.captured.error).to.equal('');
+    });
+  });
+
+  describe('writeError()', function() {
+    it('writes formatted error message to errorStream not outputStream', function() {
+      var setup = makeUI();
+      setup.ui.writeError(new BuildError({ message: 'build error' }));
+      expect(setup.captured.error).to.equal(chalk.red('build error') + EOL);
+      expect(setup.captured.output).to.equal('');
+    });
+
+    it('writes file + message to errorStream not outputStream', function() {
+      var setup = makeUI();
+      setup.ui.writeError(new BuildError({ file: 'foo.js', message: 'oops' }));
+      expect(setup.captured.error).to.equal(
+        chalk.red('File: foo.js') + EOL + chalk.red('oops') + EOL
+      );
+      expect(setup.captured.output).to.equal('');
+    });
+  });
+
+});
