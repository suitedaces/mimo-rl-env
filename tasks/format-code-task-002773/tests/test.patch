+def test_check_timerange_month_timerange_within_file_month():
+
+
+    s = Scraper('data_%Y%m.txt')
+    url = 'data_201305.txt'
+    assert s._check_timerange(url, TimeRange('2013-05-15', '2013-05-25')) is True
+
+
+def test_check_timerange_month_timerange_in_prior_month():
+
+    s = Scraper('data_%Y%m.txt')
+    url = 'data_201305.txt'
+    assert s._check_timerange(url, TimeRange('2013-04-01', '2013-04-30')) is False
+
+
+def test_check_timerange_day_timerange_within_file_day():
+
+
+    s = Scraper('data_%Y%m%d.txt')
+    url = 'data_20130505.txt'
+    assert s._check_timerange(url, TimeRange('2013-05-05T12:00', '2013-05-05T18:00')) is True
+
+
+def test_check_timerange_day_timerange_in_prior_day():
+
