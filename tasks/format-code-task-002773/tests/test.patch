+
+def test_check_timerange_year_timerange_fully_in_prior_year():
+
+    s = Scraper('goes-xrs-report_%Y.txt')
+    url = 'goes-xrs-report_2013.txt'
+    assert s._check_timerange(url, TimeRange('2012-05-01', '2012-12-31')) is False
+
+
+def test_check_timerange_year_timerange_fully_in_following_year():
+
+    s = Scraper('goes-xrs-report_%Y.txt')
