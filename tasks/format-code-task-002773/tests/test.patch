+def test_check_timerange_year_full_year():
+
+
+    s = Scraper('goes-xrs-report_%Y.txt')
+    url = 'goes-xrs-report_2013.txt'
+    assert s._check_timerange(url, TimeRange('2013-01-01', '2013-12-31')) is True
