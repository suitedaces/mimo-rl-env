+def test_filelist_local_year_pattern_partial_year(tmp_path):
+
+
+
+    for name in ['data_2012.txt', 'data_2013.txt', 'data_2014.txt']:
+        (tmp_path / name).write_text('')
+    pattern = 'file://' + str(tmp_path) + '/data_%Y.txt'
+    s = Scraper(pattern)
+    result = s.filelist(TimeRange('2013-05-01', '2013-12-31'))
+    assert len(result) == 1
+    assert result[0].endswith('data_2013.txt')
+
+
+def test_filelist_local_year_pattern_excludes_other_years(tmp_path):
+
+
+    for name in ['data_2012.txt', 'data_2013.txt', 'data_2014.txt']:
+        (tmp_path / name).write_text('')
+    pattern = 'file://' + str(tmp_path) + '/data_%Y.txt'
+    s = Scraper(pattern)
+    result = s.filelist(TimeRange('2013-05-01', '2013-12-31'))
+    assert not any(r.endswith('data_2012.txt') for r in result)
+    assert not any(r.endswith('data_2014.txt') for r in result)
