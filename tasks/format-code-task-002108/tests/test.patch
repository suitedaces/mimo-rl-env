diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,225 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+
+export PIP_NO_INDEX=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+SRC="$TMP/src"
+VENV="$TMP/venv"
+cp -a /workspace/repo/python "$SRC" || fail "copy python package"
+
+
+
+
+mkdir -p "$SRC/oneflow/include/mock"
+: > "$SRC/oneflow/include/mock/dummy.h"
+cat > "$SRC/oneflow/version.py" <<'PY'
+__version__ = '0.0.0'
+__git_commit__ = 'fixture'
+PY
+suffix=$(python3 - <<'PY'
+import importlib.machinery
+print(importlib.machinery.EXTENSION_SUFFIXES[0])
+PY
+) || fail "detect extension suffix"
+: > "$SRC/oneflow/_oneflow_internal${suffix}"
+cat > "$SRC/oneflow/__init__.py" <<'PY'
+
+PY
+
+python3 -m venv --system-site-packages "$VENV" || fail "create virtualenv"
+( cd "$SRC" && "$VENV/bin/python" -m pip install --no-index --no-deps --no-build-isolation . >/dev/null ) \
+    || fail "build/install test package"
+
+PYTHON="$VENV/bin/python"
+BIN="$VENV/bin/oneflow-mock-torch"
+[ -n "$BIN" ] || fail "installed oneflow-mock-torch command not found"
+PYLIB=$("$PYTHON" - <<'PY'
+import site
+print(site.getsitepackages()[0])
+PY
+) || fail "detect venv site-packages"
+[ -n "$PYLIB" ] || fail "installed python package path not found"
+MOCK_DIR="$PYLIB/oneflow/mock_torch"
+[ -d "$MOCK_DIR" ] || fail "mock_torch package directory not installed"
+
+mkdir -p "$PYLIB/packaging"
+: > "$PYLIB/packaging/__init__.py"
+cat > "$PYLIB/packaging/requirements.py" <<'PY'
+class Requirement:
+    def __init__(self, requirement):
+        self.name = str(requirement).split(';', 1)[0].strip().split()[0]
+PY
+cat > "$PYLIB/importlib_metadata.py" <<'PY'
+def requires(_package):
+    return []
+PY
+
+run_module() {
+    env -u PYTHONPATH "$PYTHON" -m oneflow.mock_torch "$@" >out 2>err
+    ec=$?
+}
+
+run_bin() {
+    env -u PYTHONPATH "$BIN" "$@" >out 2>err
+    ec=$?
+}
+
+assert_stdout_eq() {
+    expected=$1
+    actual=$(cat out)
+    [ "$actual" = "$expected" ] || fail "$2 stdout: [$actual]"
+}
+
+assert_empty_stderr() {
+    [ ! -s err ] || fail "$1 stderr: $(cat err)"
+}
+
+cd "$TMP"
+
+
+
+
+
+run_module
+EXPECTED="export ONEFLOW_MOCK_TORCH_LAZY=False; export ONEFLOW_MOCK_TORCH_VERBOSE=False; export PYTHONPATH=${MOCK_DIR}:\$PYTHONPATH"
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_stdout_eq "$EXPECTED" "F1"
+assert_empty_stderr "F1"
+
+
+
+
+
+run_bin enable
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_stdout_eq "$EXPECTED" "F2"
+assert_empty_stderr "F2"
+
+
+
+
+run_module enable --lazy
+EXPECTED="export ONEFLOW_MOCK_TORCH_LAZY=True; export ONEFLOW_MOCK_TORCH_VERBOSE=False; export PYTHONPATH=${MOCK_DIR}:\$PYTHONPATH"
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+assert_stdout_eq "$EXPECTED" "F3"
+assert_empty_stderr "F3"
+
+
+
+
+run_module --verbose enable
+EXPECTED="export ONEFLOW_MOCK_TORCH_LAZY=False; export ONEFLOW_MOCK_TORCH_VERBOSE=True; export PYTHONPATH=${MOCK_DIR}:\$PYTHONPATH"
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+assert_stdout_eq "$EXPECTED" "F4"
+assert_empty_stderr "F4"
+
+
+
+
+run_module --lazy --verbose enable
+EXPECTED="export ONEFLOW_MOCK_TORCH_LAZY=True; export ONEFLOW_MOCK_TORCH_VERBOSE=True; export PYTHONPATH=${MOCK_DIR}:\$PYTHONPATH"
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+assert_stdout_eq "$EXPECTED" "F5"
+assert_empty_stderr "F5"
+
+
+
+
+
+PYTHONPATH="/alpha:/tmp/x/oneflow/mock_torch:/beta:/opt/oneflow/mock_torch" \
+    "$PYTHON" -m oneflow.mock_torch disable >out 2>err
+ec=$?
+EXPECTED="export PYTHONPATH=/alpha:/beta; unset ONEFLOW_MOCK_TORCH_LAZY; unset ONEFLOW_MOCK_TORCH_VERBOSE"
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+assert_stdout_eq "$EXPECTED" "F6"
+assert_empty_stderr "F6"
+
+
+
+
+PYTHONPATH="/tmp/x/oneflow/mock_torch:/opt/oneflow/mock_torch:" \
+    "$BIN" disable >out 2>err
+ec=$?
+EXPECTED="unset PYTHONPATH; unset ONEFLOW_MOCK_TORCH_LAZY; unset ONEFLOW_MOCK_TORCH_VERBOSE"
+[ "$ec" -eq 0 ] || fail "F7 exit $ec; want 0"
+assert_stdout_eq "$EXPECTED" "F7"
+assert_empty_stderr "F7"
+
+
+
+
+env -u PYTHONPATH "$BIN" disable >out 2>err
+ec=$?
+[ "$ec" -eq 0 ] || fail "F8 exit $ec; want 0"
+[ ! -s out ] || fail "F8 stdout should be empty: $(cat out)"
+assert_empty_stderr "F8"
+
+
+
+
+run_module --help
+[ "$ec" -eq 0 ] || fail "F9 exit $ec; want 0"
+
+[ -s out ] || fail "F9 stdout should contain help text"
+grep -q '^usage:' out || fail "F9 help should include argparse usage: $(cat out)"
+grep -q 'enable' out || fail "F9 help should show enable action: $(cat out)"
+grep -q 'disable' out || fail "F9 help should show disable action: $(cat out)"
+grep -q -- '--lazy' out || fail "F9 help should show --lazy flag: $(cat out)"
+grep -q -- '--verbose' out || fail "F9 help should show --verbose flag: $(cat out)"
+assert_empty_stderr "F9"
+
+
+
+
+run_bin --help
+[ "$ec" -eq 0 ] || fail "F10 exit $ec; want 0"
+
+[ -s out ] || fail "F10 stdout should contain help text"
+grep -q '^usage:' out || fail "F10 help should include argparse usage: $(cat out)"
+grep -q 'enable' out || fail "F10 help should show enable action: $(cat out)"
+grep -q 'disable' out || fail "F10 help should show disable action: $(cat out)"
+grep -q -- '--lazy' out || fail "F10 help should show --lazy flag: $(cat out)"
+grep -q -- '--verbose' out || fail "F10 help should show --verbose flag: $(cat out)"
+assert_empty_stderr "F10"
+
+
+
+
+set +e
+env -u PYTHONPATH "$PYTHON" -m oneflow.mock_torch maybe >out 2>err
+ec=$?
+set -e
+[ "$ec" -ne 0 ] || fail "F11 exit $ec; want non-zero"
+[ ! -s out ] || fail "F11 stdout should be empty: $(cat out)"
+
+[ -s err ] || fail "F11 stderr should contain argparse usage error"
+grep -q '^usage:' err || fail "F11 stderr should include usage: $(cat err)"
+grep -q 'error:' err || fail "F11 stderr should include argparse error: $(cat err)"
+grep -q 'maybe' err || fail "F11 stderr should mention invalid action: $(cat err)"
+
+
+
+
+set +e
+env -u PYTHONPATH "$BIN" maybe >out 2>err
+ec=$?
+set -e
+[ "$ec" -ne 0 ] || fail "F12 exit $ec; want non-zero"
+[ ! -s out ] || fail "F12 stdout should be empty: $(cat out)"
+
+[ -s err ] || fail "F12 stderr should contain argparse usage error"
+grep -q '^usage:' err || fail "F12 stderr should include usage: $(cat err)"
+grep -q 'error:' err || fail "F12 stderr should include argparse error: $(cat err)"
+grep -q 'maybe' err || fail "F12 stderr should mention invalid action: $(cat err)"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+
+export PIP_NO_INDEX=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
