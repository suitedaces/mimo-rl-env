@@ -0,0 +1,292 @@
+
+
+
+
+
+
+import copy
+import json
+import os
+import socket
+import subprocess
+import sys
+
+import pytest
+
+from funcy import del_in, get_in, get_lax, has_path, set_in, update_in
+
+
+def test_get_in_walks_nested_dictionary_path():
+
+
+
+    actual = get_in({"a": {"b": 42}}, ["a", "b"])
+
+    assert actual == 42
+
+
+def test_get_in_walks_list_index_path():
+
+
+
+    actual = get_in({"x": [1, 2]}, ["x", 1])
+
+    assert actual == 2
+
+
+def test_get_in_missing_steps_return_default_for_keys_and_indexes():
+
+
+
+    missing_key = get_in({"a": 1}, ["b"], "fallback")
+    missing_index = get_in({"x": [1, 2]}, ["x", 5], "fallback")
+
+    assert missing_key == "fallback"
+    assert missing_index == "fallback"
+
+
+def test_get_in_incompatible_step_raises_type_error():
+    with pytest.raises(TypeError):
+        get_in([1, 2], ["a"])
+
+
+def test_get_lax_successful_lookup_matches_get_in_for_dicts_and_lists():
+
+
+
+    dict_value = get_lax({"a": {"b": 42}}, ["a", "b"], "fallback")
+    list_value = get_lax({"x": [1, 2]}, ["x", 1], "fallback")
+
+    assert dict_value == 42
+    assert list_value == 2
+
+
+def test_get_lax_incompatible_steps_and_none_return_default_or_none():
+
+
+
+    incompatible = get_lax([1, 2], ["a"], "fallback")
+    none_branch = get_lax({"a": None}, ["a", "b"])
+
+    assert incompatible == "fallback"
+    assert none_branch is None
+
+
+def test_set_in_replaces_nested_dict_value_without_mutating_original():
+
+
+
+    original = {"a": {"b": 1}}
+    actual = set_in(original, ["a", "b"], 7)
+
+    assert actual == {"a": {"b": 7}}
+    assert original == {"a": {"b": 1}}
+
+
+def test_set_in_creates_missing_dict_branches_and_updates_list_index():
+
+
+
+    created = set_in({}, ["a", "b"], 42)
+    list_updated = set_in([{}, 1], [1], 7)
+
+    assert created == {"a": {"b": 42}}
+    assert list_updated == [{}, 7]
+
+
+def test_set_in_top_level_path_replaces_root_key():
+
+
+
+    actual = set_in({"a": 1}, ["a"], 9)
+
+
+    assert actual == {"a": 9}
+
+
+def test_update_in_replaces_existing_value_with_update_result():
+
+
+
+    actual = update_in({"c": []}, ["c"], len)
+
+    assert actual == {"c": 0}
+
+
+def test_update_in_uses_default_for_missing_nested_path():
+
+
+
+    actual = update_in({}, ["a", "b"], lambda x: x + 1, default=0)
+
+    assert actual == {"a": {"b": 1}}
+
+
+def test_update_in_supports_list_index_and_top_level_path_boundaries():
+
+
+
+    list_updated = update_in({"x": [2, 4]}, ["x", 0], lambda x: x * 10)
+    top_level_updated = update_in({"x": 3}, ["x"], lambda x: x + 4)
+
+    assert list_updated == {"x": [20, 4]}
+
+    assert top_level_updated == {"x": 7}
+
+
+def test_del_in_removes_nested_list_index():
+
+
+
+    actual = del_in({"c": [1, 2, 3]}, ["c", 1])
+
+    assert actual == {"c": [1, 3]}
+
+
+def test_del_in_empty_or_missing_path_leaves_value_unchanged():
+
+
+
+    empty_path = del_in({"a": 1}, [])
+    missing_key = del_in({"a": 1}, ["b"])
+    missing_index = del_in({"c": [1, 2]}, ["c", 5])
+
+    assert empty_path == {"a": 1}
+    assert missing_key == {"a": 1}
+    assert missing_index == {"c": [1, 2]}
+
+
+def test_del_in_removes_nested_dictionary_key():
+
+
+
+    actual = del_in({"a": {"b": 1, "c": 2}}, ["a", "b"])
+
+    assert actual == {"a": {"c": 2}}
+
+
+def test_del_in_incompatible_step_raises_type_error():
+    with pytest.raises(TypeError):
+        del_in({"c": [1, 2, 3]}, ["c", "b"])
+
+
+def test_has_path_reports_existing_dict_and_list_paths():
+
+
+
+    dict_path = has_path({"a": {"b": 42}}, ["a", "b"])
+    list_path = has_path({"x": [1, 2]}, ["x", 1])
+
+    assert dict_path is True
+    assert list_path is True
+
+
+def test_has_path_reports_missing_keys_and_indexes_false():
+
+
+
+    missing_key = has_path({"a": {"b": 42}}, ["c"])
+    missing_index = has_path([1, 2], [3])
+
+    assert missing_key is False
+    assert missing_index is False
+
+
+def test_has_path_empty_path_is_true():
+
+
+
+    actual = has_path({"a": 1}, [])
+
+    assert actual is True
+
+
+def test_has_path_nested_missing_steps_report_not_present():
+
+    assert has_path({"a": {"b": 42}}, ["a", "c"]) is False
+    assert has_path({"x": [1, 2]}, ["x", 3]) is False
+
+
+def test_referential_transparency_same_input_same_output():
+    first = set_in({"a": {"b": 1}}, ["a", "b"], 7)
+    second = set_in({"a": {"b": 1}}, ["a", "b"], 7)
+
+    assert first == second == {"a": {"b": 7}}
+
+
+def test_helpers_do_not_mutate_caller_inputs():
+    original = {"a": {"b": [1, {"c": 3}]}, "x": [4, 5]}
+    before = copy.deepcopy(original)
+
+    assert get_in(original, ["a", "b", 1, "c"]) == 3
+    assert get_lax(original, ["x", 0]) == 4
+    assert has_path(original, ["a", "b", 0]) is True
+    assert set_in(original, ["a", "b", 1, "c"], 9) == {"a": {"b": [1, {"c": 9}]}, "x": [4, 5]}
+    assert update_in(original, ["x", 1], lambda x: x + 10) == {"a": {"b": [1, {"c": 3}]}, "x": [4, 15]}
+    assert del_in(original, ["a", "b", 0]) == {"a": {"b": [{"c": 3}]}, "x": [4, 5]}
+    assert original == before
+
+
+def test_no_global_state_matches_fresh_python_process():
+    in_process = {
+        "get_in": get_in({"a": {"b": 42}}, ["a", "b"]),
+        "get_lax": get_lax([1, 2], ["a"], "fallback"),
+        "set_in": set_in({}, ["a", "b"], 42),
+        "update_in": update_in({}, ["a", "b"], lambda x: x + 1, default=0),
+        "del_in": del_in({"c": [1, 2, 3]}, ["c", 1]),
+        "has_path": has_path({"x": [1, 2]}, ["x", 1]),
+    }
+    script = r"""
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+from funcy import del_in, get_in, get_lax, has_path, set_in, update_in
+result = {
+    "get_in": get_in({"a": {"b": 42}}, ["a", "b"]),
+    "get_lax": get_lax([1, 2], ["a"], "fallback"),
+    "set_in": set_in({}, ["a", "b"], 42),
+    "update_in": update_in({}, ["a", "b"], lambda x: x + 1, default=0),
+    "del_in": del_in({"c": [1, 2, 3]}, ["c", 1]),
+    "has_path": has_path({"x": [1, 2]}, ["x", 1]),
+}
+sys.stdout.write(json.dumps(result, sort_keys=True))
+"""
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    fresh_process = json.loads(completed.stdout)
+
+    assert in_process == fresh_process == {
+        "get_in": 42,
+        "get_lax": "fallback",
+        "set_in": {"a": {"b": 42}},
+        "update_in": {"a": {"b": 1}},
+        "del_in": {"c": [1, 3]},
+        "has_path": True,
+    }
+
+
+def test_no_undeclared_filesystem_or_network_side_effects(tmp_path, monkeypatch):
+    def fail_socket(*args, **kwargs):
+        raise AssertionError("nested path helpers must not open network sockets")
+
+    monkeypatch.setattr(socket, "socket", fail_socket)
+    before_cwd = os.getcwd()
+    monkeypatch.chdir(tmp_path)
+    before = sorted(p.relative_to(tmp_path).as_posix() for p in tmp_path.rglob("*"))
+
+    assert get_in({"a": {"b": 42}}, ["a", "b"]) == 42
+    assert get_lax([1, 2], ["a"], "fallback") == "fallback"
+    assert set_in({}, ["a", "b"], 42) == {"a": {"b": 42}}
+    assert update_in({"c": []}, ["c"], len) == {"c": 0}
+    assert del_in({"c": [1, 2, 3]}, ["c", 1]) == {"c": [1, 3]}
+    assert has_path({"x": [1, 2]}, ["x", 1]) is True
+
+    after = sorted(p.relative_to(tmp_path).as_posix() for p in tmp_path.rglob("*"))
+    assert after == before == []
+    assert os.getcwd() == str(tmp_path)
+    os.chdir(before_cwd)
