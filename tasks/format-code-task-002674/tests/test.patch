diff --git a/pydm/tests/widgets/test_spinbox.py b/pydm/tests/widgets/test_spinbox.py
index ba38d2c8..b7f0eadc 100644
--- a/pydm/tests/widgets/test_spinbox.py
+++ b/pydm/tests/widgets/test_spinbox.py
@@ -326,6 +326,102 @@ def test_ctrl_limit_changed(qtbot, signals, which_limit, new_limit):
         assert pydm_spinbox.get_ctrl_limits()[0] == new_limit
 
 
+
+
+
+
+def test_user_defined_limits_default_is_false(qtbot):
+    """The userDefinedLimits property should default to False so the
+    pre-existing behavior of taking limits from the channel is preserved."""
+    pydm_spinbox = PyDMSpinbox()
+    qtbot.addWidget(pydm_spinbox)
+    assert pydm_spinbox.userDefinedLimits is False
+
+
+def test_channel_limits_applied_when_user_defined_limits_false(qtbot, signals):
+    """When userDefinedLimits is False (default), control limits from the
+    channel must be applied to the spinbox's minimum() and maximum()."""
+    pydm_spinbox = PyDMSpinbox()
+    qtbot.addWidget(pydm_spinbox)
+    assert pydm_spinbox.userDefinedLimits is False
+
+    signals.lower_ctrl_limit_signal[float].connect(pydm_spinbox.lowerCtrlLimitChanged)
+    signals.upper_ctrl_limit_signal[float].connect(pydm_spinbox.upperCtrlLimitChanged)
+    signals.lower_ctrl_limit_signal[float].emit(-123.0)
+    signals.upper_ctrl_limit_signal[float].emit(456.0)
+
+    assert pydm_spinbox.minimum() == -123.0
+    assert pydm_spinbox.maximum() == 456.0
+
+
+def test_channel_limits_ignored_when_user_defined_limits_true(qtbot, signals):
+    """When userDefinedLimits is True, control limits coming from the channel
+    must NOT modify the spinbox's minimum/maximum (the user-chosen range wins)."""
+    pydm_spinbox = PyDMSpinbox()
+    qtbot.addWidget(pydm_spinbox)
+
+
+    pydm_spinbox.userMinimum = -5.0
+    pydm_spinbox.userMaximum = 25.0
+    pydm_spinbox.userDefinedLimits = True
+
+    assert pydm_spinbox.minimum() == -5.0
+    assert pydm_spinbox.maximum() == 25.0
+
+
+    signals.lower_ctrl_limit_signal[float].connect(pydm_spinbox.lowerCtrlLimitChanged)
+    signals.upper_ctrl_limit_signal[float].connect(pydm_spinbox.upperCtrlLimitChanged)
+    signals.lower_ctrl_limit_signal[float].emit(-999.0)
+    signals.upper_ctrl_limit_signal[float].emit(999.0)
+
+    assert pydm_spinbox.minimum() == -5.0
+    assert pydm_spinbox.maximum() == 25.0
+
+
+def test_user_min_max_applied_when_user_defined_limits_true(qtbot):
+    """Setting userMinimum / userMaximum while userDefinedLimits is True must
+    immediately update the spinbox's minimum() and maximum()."""
+    pydm_spinbox = PyDMSpinbox()
+    qtbot.addWidget(pydm_spinbox)
+
+    pydm_spinbox.userDefinedLimits = True
+    pydm_spinbox.userMinimum = -50.0
+    pydm_spinbox.userMaximum = 75.0
+
+    assert pydm_spinbox.userMinimum == -50.0
+    assert pydm_spinbox.userMaximum == 75.0
+    assert pydm_spinbox.minimum() == -50.0
+    assert pydm_spinbox.maximum() == 75.0
+
+
+def test_toggle_user_defined_limits_restores_channel_limits(qtbot, signals):
+    """Toggling userDefinedLimits from True back to False, after channel
+    limits have been received, must restore the spinbox's range to the
+    channel-supplied limits."""
+    pydm_spinbox = PyDMSpinbox()
+    qtbot.addWidget(pydm_spinbox)
+
+
+    signals.lower_ctrl_limit_signal[float].connect(pydm_spinbox.lowerCtrlLimitChanged)
+    signals.upper_ctrl_limit_signal[float].connect(pydm_spinbox.upperCtrlLimitChanged)
+    signals.lower_ctrl_limit_signal[float].emit(-100.0)
+    signals.upper_ctrl_limit_signal[float].emit(200.0)
+    assert pydm_spinbox.minimum() == -100.0
+    assert pydm_spinbox.maximum() == 200.0
+
+
+    pydm_spinbox.userMinimum = -1.0
+    pydm_spinbox.userMaximum = 1.0
+    pydm_spinbox.userDefinedLimits = True
+    assert pydm_spinbox.minimum() == -1.0
+    assert pydm_spinbox.maximum() == 1.0
+
+
+    pydm_spinbox.userDefinedLimits = False
+    assert pydm_spinbox.minimum() == -100.0
+    assert pydm_spinbox.maximum() == 200.0
+
+
