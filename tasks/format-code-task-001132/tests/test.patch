+#!/bin/bash
+set -euo pipefail
+
+
+.build_env/venv/bin/python -m pytest -q \
+  api/tests/opentrons/protocols/test_bundle_hardening.py \
+  api/tests/opentrons/protocols/test_bundle.py \
+  api/tests/opentrons/protocols/test_parse.py::test_parse_bundle_details
