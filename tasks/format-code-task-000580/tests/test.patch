+def test_repeated_resource_cycles_apply_high_level_interface_each_time():
+
+
+
+
+
+    def cycle(index):
+        table = make_table(f"LeakUsers{index}")
+        recorder = LateRequestRecorder(table.meta.client)
+        with Stubber(table.meta.client) as stubber:
+            stubber.add_response(
+                "put_item",
+                {},
+                expected_params={
+                    "TableName": f"LeakUsers{index}",
+                    "Item": {"pk": f"u#{index}"},
+                },
+            )
+            response = table.put_item(Item={"pk": f"u#{index}"})
+        assert response == {}
+        assert recorder.bodies == [
+            {
+                "TableName": f"LeakUsers{index}",
+                "Item": {"pk": {"S": f"u#{index}"}},
+            }
+        ]
+
+    for warmup_index in range(5):
+        cycle(warmup_index)
+
+
+
+    for index in range(10):
+        cycle(index)
+        if index % 10 == 0:
+            gc.collect()
