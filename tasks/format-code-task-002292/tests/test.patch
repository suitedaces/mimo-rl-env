+from __future__ import absolute_import
+from unittest import TestCase
+
+import plotly.graph_objs as go
+from plotly.subplots import make_subplots
+
+
+def _make_trace_fig():
+    fig = make_subplots(rows=2, cols=2)
+
+    fig.add_scatter(y=[1, 2, 3], name="A", row=1, col=1)
+
+    fig.add_bar(y=[4, 5, 6], name="B", row=1, col=1)
+
+    fig.add_scatter(y=[7, 8, 9], name="C", row=2, col=1)
+
+    fig.add_bar(y=[10, 11, 12], name="D", row=2, col=2)
+    return fig
+
+
+class TestIntSelectorTraces(TestCase):
+
+    def test_select_traces_int_positive_index(self):
+        fig = _make_trace_fig()
+        result = list(fig.select_traces(selector=1))
+        self.assertEqual([t.name for t in result], ["B"])
+
+    def test_select_traces_int_positive_index_higher(self):
+        fig = _make_trace_fig()
+        result = list(fig.select_traces(selector=2))
+        self.assertEqual([t.name for t in result], ["C"])
+
+    def test_select_traces_int_negative_index(self):
+        fig = _make_trace_fig()
+        result = list(fig.select_traces(selector=-1))
+        self.assertEqual([t.name for t in result], ["D"])
+
+
+    def test_select_traces_int_with_row_col_positive(self):
+
+
+        fig = _make_trace_fig()
+        result = list(fig.select_traces(selector=1, row=1, col=1))
+        self.assertEqual([t.name for t in result], ["B"])
+
+    def test_select_traces_int_with_row_col_negative(self):
+
+
+        fig = _make_trace_fig()
+        result = list(fig.select_traces(selector=-1, row=1, col=1))
+        self.assertEqual([t.name for t in result], ["B"])
+
+
+    def test_for_each_trace_int(self):
+        fig = _make_trace_fig()
+        seen = []
+        ret = fig.for_each_trace(lambda t: seen.append(t.name), selector=1)
+        self.assertIs(ret, fig)
+        self.assertEqual(seen, ["B"])
+
+    def test_for_each_trace_int_with_row_col(self):
+        fig = _make_trace_fig()
+        seen = []
+        fig.for_each_trace(
+            lambda t: seen.append(t.name), selector=1, row=1, col=1
+        )
+        self.assertEqual(seen, ["B"])
+
+
+    def test_update_traces_int_no_rowcol(self):
+        fig = _make_trace_fig()
+        fig.update_traces(selector=1, name="Updated_B")
+        names = [t.name for t in fig.data]
+
+        self.assertEqual(names, ["A", "Updated_B", "C", "D"])
+
+    def test_update_traces_int_negative(self):
+        fig = _make_trace_fig()
+        fig.update_traces(selector=-1, name="Updated_last")
+        names = [t.name for t in fig.data]
+        self.assertEqual(names, ["A", "B", "C", "Updated_last"])
+
+    def test_update_traces_int_with_row_col(self):
+
+        fig = _make_trace_fig()
+        fig.update_traces(selector=1, row=1, col=1, name="Updated")
+        names = [t.name for t in fig.data]
+        self.assertEqual(names, ["A", "Updated", "C", "D"])
+
+
+class TestStringSelectorTraces(TestCase):
+
+    def test_select_traces_string_scatter(self):
+        fig = _make_trace_fig()
+        result = list(fig.select_traces(selector="scatter"))
+        self.assertEqual([t.name for t in result], ["A", "C"])
+
+    def test_select_traces_string_bar(self):
+        fig = _make_trace_fig()
+        result = list(fig.select_traces(selector="bar"))
+        self.assertEqual([t.name for t in result], ["B", "D"])
+
+    def test_select_traces_string_no_match(self):
+        fig = _make_trace_fig()
+        result = list(fig.select_traces(selector="pie"))
+        self.assertEqual(result, [])
+
+    def test_select_traces_string_with_row(self):
+
+        fig = _make_trace_fig()
+        result = list(fig.select_traces(selector="scatter", row=2))
+        self.assertEqual([t.name for t in result], ["C"])
+
+    def test_for_each_trace_string(self):
+        fig = _make_trace_fig()
+        seen = []
+        fig.for_each_trace(lambda t: seen.append(t.name), selector="bar")
+        self.assertEqual(seen, ["B", "D"])
+
+    def test_update_traces_string(self):
+
+        fig = _make_trace_fig()
+        fig.update_traces(selector="bar", visible=False)
+        visibles = [t.visible for t in fig.data]
+
+
+        self.assertEqual(visibles, [None, False, None, False])
+
+
+def _make_layout_fig():
+    fig = make_subplots(rows=2, cols=2)
+
+    fig.add_shape(type="rect", x0=0, y0=0, x1=1, y1=1, name="r1", row=1, col=1)
+    fig.add_shape(type="line", x0=0, y0=0, x1=1, y1=1, name="l1", row=1, col=1)
+    fig.add_shape(type="rect", x0=0, y0=0, x1=1, y1=1, name="r2", row=2, col=2)
+
+    fig.add_annotation(text="ann1", x=0, y=0, row=1, col=1)
+    fig.add_annotation(text="ann2", x=1, y=1, row=1, col=1)
+    fig.add_annotation(text="ann3", x=0, y=0, row=2, col=2)
+    return fig
+
+
+class TestIntStrSelectorShapes(TestCase):
+    def test_select_shapes_int_positive(self):
+        fig = _make_layout_fig()
+        result = list(fig.select_shapes(selector=1))
+        self.assertEqual([s.name for s in result], ["l1"])
+
+    def test_select_shapes_int_negative(self):
+        fig = _make_layout_fig()
+        result = list(fig.select_shapes(selector=-1))
+        self.assertEqual([s.name for s in result], ["r2"])
+
+    def test_select_shapes_int_with_row_col(self):
+
+
+        fig = _make_layout_fig()
+        result = list(fig.select_shapes(selector=1, row=1, col=1))
+        self.assertEqual([s.name for s in result], ["l1"])
+
+    def test_select_shapes_string_rect(self):
+        fig = _make_layout_fig()
+        result = list(fig.select_shapes(selector="rect"))
+        self.assertEqual([s.name for s in result], ["r1", "r2"])
+
+    def test_select_shapes_string_line(self):
+        fig = _make_layout_fig()
+        result = list(fig.select_shapes(selector="line"))
+        self.assertEqual([s.name for s in result], ["l1"])
+
+    def test_for_each_shape_int(self):
+        fig = _make_layout_fig()
+        seen = []
+        fig.for_each_shape(lambda s: seen.append(s.name), selector=1)
+        self.assertEqual(seen, ["l1"])
+
+    def test_update_shapes_int_negative(self):
+        fig = _make_layout_fig()
+        fig.update_shapes(selector=-1, name="updated_last")
+        names = [s.name for s in fig.layout.shapes]
+        self.assertEqual(names, ["r1", "l1", "updated_last"])
+
+    def test_update_shapes_string(self):
+        fig = _make_layout_fig()
+        fig.update_shapes(selector="rect", opacity=0.5)
+        opacities = [s.opacity for s in fig.layout.shapes]
+
+        self.assertEqual(opacities, [0.5, None, 0.5])
+
+
+class TestIntStrSelectorAnnotations(TestCase):
+    def test_select_annotations_int_positive(self):
+        fig = _make_layout_fig()
+        result = list(fig.select_annotations(selector=1))
+        self.assertEqual([a.text for a in result], ["ann2"])
+
+    def test_select_annotations_int_negative(self):
+        fig = _make_layout_fig()
+        result = list(fig.select_annotations(selector=-1))
+        self.assertEqual([a.text for a in result], ["ann3"])
+
+    def test_select_annotations_int_with_row_col(self):
+
+        fig = _make_layout_fig()
+        result = list(fig.select_annotations(selector=1, row=1, col=1))
+        self.assertEqual([a.text for a in result], ["ann2"])
+
+    def test_for_each_annotation_int(self):
+        fig = _make_layout_fig()
+        seen = []
+        fig.for_each_annotation(lambda a: seen.append(a.text), selector=-1)
+        self.assertEqual(seen, ["ann3"])
+
+    def test_update_annotations_int(self):
+        fig = _make_layout_fig()
+        fig.update_annotations(selector=1, text="UPDATED")
+        texts = [a.text for a in fig.layout.annotations]
+        self.assertEqual(texts, ["ann1", "UPDATED", "ann3"])
+
+
+class TestIntStrSelectorImages(TestCase):
+    def _make_image_fig(self):
+        fig = make_subplots(rows=1, cols=1)
+        fig.add_layout_image(source="a.png", x=0, y=0, name="img1")
+        fig.add_layout_image(source="b.png", x=1, y=1, name="img2")
+        fig.add_layout_image(source="c.png", x=2, y=2, name="img3")
+        return fig
+
+    def test_select_images_int_positive(self):
+        fig = self._make_image_fig()
+        result = list(fig.select_layout_images(selector=1))
+        self.assertEqual([i.name for i in result], ["img2"])
+
+    def test_select_images_int_negative(self):
+        fig = self._make_image_fig()
+        result = list(fig.select_layout_images(selector=-1))
+        self.assertEqual([i.name for i in result], ["img3"])
+
+    def test_update_images_int(self):
+        fig = self._make_image_fig()
+        fig.update_layout_images(selector=-1, name="last_updated")
+        names = [i.name for i in fig.layout.images]
+        self.assertEqual(names, ["img1", "img2", "last_updated"])
+
+
+class TestIntStrSelectorXAxes(TestCase):
+    def test_select_xaxes_int_positive(self):
+        fig = make_subplots(rows=2, cols=2)
+
+        fig.update_xaxes(title_text="X1", row=1, col=1)
+        fig.update_xaxes(title_text="X2", row=1, col=2)
+        fig.update_xaxes(title_text="X3", row=2, col=1)
+        fig.update_xaxes(title_text="X4", row=2, col=2)
+        result = list(fig.select_xaxes(selector=1))
+        self.assertEqual([x.title.text for x in result], ["X2"])
+
+    def test_select_xaxes_int_negative(self):
+        fig = make_subplots(rows=2, cols=2)
+        fig.update_xaxes(title_text="X1", row=1, col=1)
+        fig.update_xaxes(title_text="X2", row=1, col=2)
+        fig.update_xaxes(title_text="X3", row=2, col=1)
+        fig.update_xaxes(title_text="X4", row=2, col=2)
+        result = list(fig.select_xaxes(selector=-1))
+        self.assertEqual([x.title.text for x in result], ["X4"])
+
+    def test_update_xaxes_int(self):
+        fig = make_subplots(rows=2, cols=2)
+        fig.update_xaxes(title_text="X1", row=1, col=1)
+        fig.update_xaxes(title_text="X2", row=1, col=2)
+        fig.update_xaxes(title_text="X3", row=2, col=1)
+        fig.update_xaxes(title_text="X4", row=2, col=2)
+        fig.update_xaxes(selector=1, title_text="UPDATED")
+        titles = [x.title.text for x in fig.select_xaxes()]
+        self.assertEqual(titles, ["X1", "UPDATED", "X3", "X4"])
