new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_attack_roll.py
@@ -0,0 +1,213 @@
+import gc
+import random
+
+import pytest
+
+from DnD_battler import AbilityDie, AttackRoll as RootAttackRoll, Dice, Proficiency
+from DnD_battler.dice import AttackRoll as DiceAttackRoll
+
+
+def set_rolls(monkeypatch, rolls):
+    queue = list(rolls)
+
+    def fake_randint(_low, _high):
+        if not queue:
+            raise AssertionError("test did not provide enough deterministic dice rolls")
+        value = queue.pop(0)
+        if not _low <= value <= _high:
+            raise AssertionError(f"deterministic dice roll {value} is invalid for d{_high}")
+        return value
+
+    monkeypatch.setattr(random, "randint", fake_randint)
+
+
+def test_exports_and_constructor_preserve_bound_attack_state(monkeypatch):
+
+
+
+
+    ability_die = AbilityDie(bonus=2)
+    damage_dice = Dice(num_faces=[1])
+
+    roll = RootAttackRoll("training sword", ability_die, damage_dice, modifier=3)
+
+    assert RootAttackRoll is DiceAttackRoll
+    assert roll.name == "training sword"
+    assert roll.ability_die is ability_die
+    assert roll.damage_dice is damage_dice
+
+    modifier_probe = RootAttackRoll("modifier probe", AbilityDie(bonus=0), Dice(num_faces=[1]), modifier=3)
+    set_rolls(monkeypatch, [10, 1])
+    assert modifier_probe.attack(enemy_ac=13) == 1
+    set_rolls(monkeypatch, [10])
+    assert modifier_probe.attack(enemy_ac=14) == 0
+
+
+def test_attack_damage_depends_on_linked_ability_state_and_options(monkeypatch):
+
+
+
+
+    ability_die = AbilityDie(bonus=2)
+    damage_dice = Dice(num_faces=[1])
+    roll = RootAttackRoll("training sword", ability_die, damage_dice, modifier=3)
+
+    set_rolls(monkeypatch, [10])
+    assert roll.attack(enemy_ac=100) == 0
+
+    set_rolls(monkeypatch, [10, 1])
+    assert roll.attack(enemy_ac=-100) == 3
+
+    ability_die.temp_modifier = 1
+    set_rolls(monkeypatch, [10, 1])
+    assert roll.attack(enemy_ac=-100) == 4
+
+    set_rolls(monkeypatch, [10, 1])
+    assert roll.attack(enemy_ac=-100, add_ability_to_damage=False) == 1
+
+    ability_die.proficiency = Proficiency(level=5, modifier=0)
+    set_rolls(monkeypatch, [10, 1])
+
+    assert roll.attack(enemy_ac=-100, munchkin=True) == 7
+
+
+def test_critical_hit_and_fumble_state_drive_attack_resolution(monkeypatch):
+
+
+
+
+    ability_die = AbilityDie(bonus=0)
+    roll = RootAttackRoll("crit stick", ability_die, Dice(num_faces=[1]), modifier=0)
+
+    set_rolls(monkeypatch, [20, 1, 1])
+    assert roll.attack(enemy_ac=100) == 2
+
+    set_rolls(monkeypatch, [10, 1])
+    assert roll.attack(enemy_ac=-100) == 1
+
+    set_rolls(monkeypatch, [1])
+    assert roll.attack(enemy_ac=-100) == 0
+
+    set_rolls(monkeypatch, [10, 1])
+    assert roll.attack(enemy_ac=-100) == 1
+
+
+def test_advantage_argument_changes_hit_roll_without_mutating_default(monkeypatch):
+
+
+
+
+    ability_die = AbilityDie(bonus=0)
+    roll = RootAttackRoll("advantage probe", ability_die, Dice(num_faces=[1]), modifier=0)
+
+    set_rolls(monkeypatch, [3, 19, 1])
+    assert roll.attack(enemy_ac=19, advantage=1) == 1
+
+    set_rolls(monkeypatch, [3, 19, 1])
+    assert roll.attack(enemy_ac=19) == 0
+
+    set_rolls(monkeypatch, [19, 3])
+    assert roll.attack(enemy_ac=19, advantage=-1) == 0
+
+    set_rolls(monkeypatch, [19, 1])
+    assert roll.attack(enemy_ac=19) == 1
+
+
+def test_parse_attack_accepts_supported_damage_dice_and_rejects_unsupported(monkeypatch):
+
+
+
+
+    existing_damage_dice = Dice(num_faces=[1])
+    parsed_dice = RootAttackRoll.parse_attack("parsed", AbilityDie(bonus=0), existing_damage_dice, attack_modifier=4)
+    assert parsed_dice.name == "parsed"
+
+    assert isinstance(parsed_dice.damage_dice, Dice)
+    set_rolls(monkeypatch, [10, 1])
+    assert parsed_dice.attack(enemy_ac=14) == 1
+    set_rolls(monkeypatch, [10])
+    assert parsed_dice.attack(enemy_ac=15) == 0
+
+    parsed_notation = RootAttackRoll.parse_attack(
+        "parsed", AbilityDie(bonus=1), "2d6+1", attack_modifier=4
+    )
+    assert parsed_notation.name == "parsed"
+
+    assert parsed_notation.damage_dice.num_faces == [6, 6]
+    assert parsed_notation.damage_dice.bonus == 1
+
+    parsed_int = RootAttackRoll.parse_attack("parsed", AbilityDie(bonus=0), 8, attack_modifier=4)
+    assert parsed_int.name == "parsed"
+
+    assert parsed_int.damage_dice.num_faces == [8]
+    assert parsed_int.damage_dice.bonus == 0
+    set_rolls(monkeypatch, [10, 1])
+    assert parsed_int.attack(enemy_ac=14) == 1
+    set_rolls(monkeypatch, [10])
+    assert parsed_int.attack(enemy_ac=15) == 0
+
+
+    with pytest.raises(KeyError):
+        RootAttackRoll.parse_attack("bad", AbilityDie(), object(), attack_modifier=0)
+
+
+def test_parse_list_attack_supports_legacy_list_form(monkeypatch):
+
+
+
+
+    ability_die = AbilityDie(bonus=0)
+
+    roll = RootAttackRoll.parse_list_attack(["club", 2, 0, 4], ability_die)
+
+    assert roll.name == "club"
+    assert roll.ability_die is ability_die
+
+    set_rolls(monkeypatch, [10, 4])
+    assert roll.attack(enemy_ac=12) == 4
+    set_rolls(monkeypatch, [10])
+    assert roll.attack(enemy_ac=13) == 0
+    assert roll.damage_dice.num_faces == [4]
+    assert roll.damage_dice.bonus == 0
+
+
+def test_instances_keep_independent_linked_ability_state(monkeypatch):
+
+
+
+
+    first = RootAttackRoll("first", AbilityDie(bonus=2), Dice(num_faces=[1]), modifier=3)
+    second = RootAttackRoll("second", AbilityDie(bonus=5), Dice(num_faces=[1]), modifier=0)
+
+    first.ability_die.temp_modifier = 1
+
+    set_rolls(monkeypatch, [10, 1])
+    assert first.attack(enemy_ac=-100) == 4
+
+    set_rolls(monkeypatch, [10, 1])
+    assert first.attack(enemy_ac=-100) == 4
+
+    set_rolls(monkeypatch, [10, 1])
+    assert second.attack(enemy_ac=-100) == 6
+
+    set_rolls(monkeypatch, [10, 1])
+    assert second.attack(enemy_ac=-100) == 6
+
+
+def test_repeated_construct_use_drop_cycles_keep_python_heap_bounded(monkeypatch):
+
+
+
+
+    gc.collect()
+    damages = []
+
+    for _ in range(100):
+        set_rolls(monkeypatch, [10, 1])
+        roll = RootAttackRoll("training sword", AbilityDie(bonus=2), Dice(num_faces=[1]), modifier=3)
+        damages.append(roll.attack(enemy_ac=-100))
+        del roll
+
+    gc.collect()
+
+    assert damages == [3] * 100
