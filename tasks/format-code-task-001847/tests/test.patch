+package usercase_test_coderl
+
+import (
+	"image"
+	"strings"
+	"testing"
+
+	tui "github.com/marcusolsson/tui-go"
+)
+
+func repaintList(l *tui.List, width, height int, theme *tui.Theme) *tui.TestSurface {
+	surface := tui.NewTestSurface(width, height)
+	tui.NewPainter(surface, theme).Repaint(l)
+	return surface
+}
+
+func decorationLines(t *testing.T, surface *tui.TestSurface) []string {
+	t.Helper()
+	return strings.Split(strings.Trim(surface.Decorations(), "\n"), "\n")
+}
+
+func textLines(t *testing.T, surface *tui.TestSurface) []string {
+	t.Helper()
+	return strings.Split(strings.Trim(surface.String(), "\n"), "\n")
+}
+
+func assertTextRow(t *testing.T, surface *tui.TestSurface, row int, want string) {
+	t.Helper()
+	lines := textLines(t, surface)
+	if row < 0 || row >= len(lines) {
+		t.Fatalf("text row %d out of range in %q", row, surface.String())
+	}
+	if lines[row] != want {
+		t.Fatalf("text row %d = %q, want %q; full text = %q", row, lines[row], want, surface.String())
+	}
+}
+
+func assertReverseBitForRow(t *testing.T, surface *tui.TestSurface, row int, want bool) {
+	t.Helper()
+	assertDecorationBitForRow(t, surface, row, 1, want)
+}
+
+func assertDecorationBitForRow(t *testing.T, surface *tui.TestSurface, row int, bit int32, want bool) {
+	t.Helper()
+	lines := decorationLines(t, surface)
+	if row < 0 || row >= len(lines) {
+		t.Fatalf("decoration row %d out of range in %q", row, surface.Decorations())
+	}
+	for col, ch := range lines[row] {
+		hasBit := int32(ch-'0')&bit == bit
+		if hasBit != want {
+			t.Fatalf("decoration bit %d at row %d col %d = %v, want %v; decorations = %q", bit, row, col, hasBit, want, surface.Decorations())
+		}
+	}
+}
+
+func TestNewListAddItemsSizeHintAndDraw(t *testing.T) {
+
+
+	l := tui.NewList()
+
+	if got := l.Length(); got != 0 {
+		t.Fatalf("fresh Length() = %d, want 0", got)
+	}
+	if got := l.Selected(); got != -1 {
+		t.Fatalf("fresh Selected() = %d, want -1", got)
+	}
+	if got := l.SizeHint(); got != (image.Point{0, 0}) {
+		t.Fatalf("fresh SizeHint() = %v, want (0,0)", got)
+	}
+
+	l.AddItems("one", "two", "three")
+
+	if got := l.Length(); got != 3 {
+		t.Fatalf("after AddItems Length() = %d, want 3", got)
+	}
+	if got := l.Selected(); got != -1 {
+		t.Fatalf("after AddItems Selected() = %d, want -1", got)
+	}
+	if got := l.SizeHint(); got != (image.Point{5, 3}) {
+		t.Fatalf("after AddItems SizeHint() = %v, want (5,3)", got)
+	}
+
+	theme := tui.NewTheme()
+	theme.SetStyle("list.item", tui.Style{Bold: tui.DecorationOn})
+	surface := repaintList(l, 8, 4, theme)
+
+	assertTextRow(t, surface, 0, "one     ")
+	assertTextRow(t, surface, 1, "two     ")
+	assertTextRow(t, surface, 2, "three   ")
+
+	assertDecorationBitForRow(t, surface, 0, 2, true)
+	assertDecorationBitForRow(t, surface, 1, 2, true)
+	assertDecorationBitForRow(t, surface, 2, 2, true)
+}
+
+func TestSetSelectedSelectedItemAndSelectCallback(t *testing.T) {
+
+
+	l := tui.NewList()
+	l.AddItems("one", "two", "three")
+	changed := []int{}
+	l.OnSelectionChanged(func(list *tui.List) {
+		changed = append(changed, list.Selected())
+	})
+
+	l.SetSelected(1)
+
+	if got := l.Selected(); got != 1 {
+		t.Fatalf("after SetSelected(1) Selected() = %d, want 1", got)
+	}
+	if got := l.SelectedItem(); got != "two" {
+		t.Fatalf("after SetSelected(1) SelectedItem() = %q, want %q", got, "two")
+	}
+	if got := len(changed); got != 0 {
+		t.Fatalf("after SetSelected callback count = %d, want 0", got)
+	}
+
+	l.Select(2)
+
+	if got := l.Selected(); got != 2 {
+		t.Fatalf("after Select(2) Selected() = %d, want 2", got)
+	}
+	if got := l.SelectedItem(); got != "three" {
+		t.Fatalf("after Select(2) SelectedItem() = %q, want %q", got, "three")
+	}
+	if got := changed; len(got) != 1 || got[0] != 2 {
+		t.Fatalf("selection callback log = %#v, want []int{2}", got)
+	}
+}
+
+func TestFocusedKeyboardNavigationAndActivation(t *testing.T) {
+
+
+	l := tui.NewList()
+	l.AddItems("one", "two", "three")
+	changed := []int{}
+	activated := []int{}
+	l.OnSelectionChanged(func(list *tui.List) {
+		changed = append(changed, list.Selected())
+	})
+	l.OnItemActivated(func(list *tui.List) {
+		activated = append(activated, list.Selected())
+	})
+
+	l.OnKeyEvent(tui.KeyEvent{Key: tui.KeyDown})
+	if got := l.Selected(); got != -1 {
+		t.Fatalf("unfocused KeyDown Selected() = %d, want -1", got)
+	}
+	if got := len(changed); got != 0 {
+		t.Fatalf("unfocused KeyDown callback count = %d, want 0", got)
+	}
+
+	l.SetFocused(true)
+	l.OnKeyEvent(tui.KeyEvent{Key: tui.KeyDown})
+	l.OnKeyEvent(tui.KeyEvent{Rune: 'j'})
+	l.OnKeyEvent(tui.KeyEvent{Key: tui.KeyDown})
+	l.OnKeyEvent(tui.KeyEvent{Key: tui.KeyUp})
+	l.OnKeyEvent(tui.KeyEvent{Rune: 'k'})
+	l.OnKeyEvent(tui.KeyEvent{Key: tui.KeyUp})
+
+	if got := l.Selected(); got != 0 {
+		t.Fatalf("after focused movement Selected() = %d, want 0", got)
+	}
+	wantChanged := []int{0, 1, 2, 1, 0, 0}
+	if got := changed; len(got) != len(wantChanged) {
+		t.Fatalf("movement callback log = %#v, want %#v", got, wantChanged)
+	} else {
+		for i := range wantChanged {
+			if got[i] != wantChanged[i] {
+				t.Fatalf("movement callback log = %#v, want %#v", got, wantChanged)
+			}
+		}
+	}
+
+	l.SetSelected(1)
+	l.OnKeyEvent(tui.KeyEvent{Key: tui.KeyEnter})
+	if got := activated; len(got) != 1 || got[0] != 1 {
+		t.Fatalf("activation callback log = %#v, want []int{1}", got)
+	}
+	if got := l.Selected(); got != 1 {
+		t.Fatalf("after KeyEnter Selected() = %d, want 1", got)
+	}
+}
+
+func TestRemoveItemsClearsSelectionAndIsRepeatable(t *testing.T) {
+
+
+	l := tui.NewList()
+	l.AddItems("one", "two", "three")
+	l.SetSelected(1)
+	changed := []int{}
+	l.OnSelectionChanged(func(list *tui.List) {
+		changed = append(changed, list.Selected())
+	})
+
+	l.RemoveItems()
+	l.RemoveItems()
+
+	if got := l.Length(); got != 0 {
+		t.Fatalf("after RemoveItems twice Length() = %d, want 0", got)
+	}
+	if got := l.Selected(); got != -1 {
+		t.Fatalf("after RemoveItems twice Selected() = %d, want -1", got)
+	}
+	if got := l.SizeHint(); got != (image.Point{0, 0}) {
+		t.Fatalf("after RemoveItems twice SizeHint() = %v, want (0,0)", got)
+	}
+	wantChanged := []int{-1, -1}
+	if got := changed; len(got) != len(wantChanged) {
+		t.Fatalf("RemoveItems callback log = %#v, want %#v", got, wantChanged)
+	} else {
+		for i := range wantChanged {
+			if got[i] != wantChanged[i] {
+				t.Fatalf("RemoveItems callback log = %#v, want %#v", got, wantChanged)
+			}
+		}
+	}
+}
+
+func TestRemoveItemSelectedPriorAndLaterItems(t *testing.T) {
+
+
+	prior := tui.NewList()
+	prior.AddItems("one", "two", "three", "four")
+	prior.SetSelected(2)
+	priorChanged := []int{}
+	prior.OnSelectionChanged(func(list *tui.List) {
+		priorChanged = append(priorChanged, list.Selected())
+	})
+
+	prior.RemoveItem(1)
+
+	if got := prior.Length(); got != 3 {
+		t.Fatalf("after removing prior item Length() = %d, want 3", got)
+	}
+	if got := prior.Selected(); got != 1 {
+		t.Fatalf("after removing prior item Selected() = %d, want 1", got)
+	}
+	if got := prior.SelectedItem(); got != "three" {
+		t.Fatalf("after removing prior item SelectedItem() = %q, want %q", got, "three")
+	}
+	if got := priorChanged; len(got) != 1 || got[0] != 1 {
+		t.Fatalf("prior-remove callback log = %#v, want []int{1}", got)
+	}
+	priorSurface := repaintList(prior, 6, 3, tui.NewTheme())
+
+	assertTextRow(t, priorSurface, 0, "one   ")
+	assertTextRow(t, priorSurface, 1, "three ")
+	assertTextRow(t, priorSurface, 2, "four  ")
+
+	selected := tui.NewList()
+	selected.AddItems("one", "two", "three")
+	selected.SetSelected(1)
+	selectedChanged := []int{}
+	selected.OnSelectionChanged(func(list *tui.List) {
+		selectedChanged = append(selectedChanged, list.Selected())
+	})
+
+	selected.RemoveItem(1)
+
+	if got := selected.Length(); got != 2 {
+		t.Fatalf("after removing selected item Length() = %d, want 2", got)
+	}
+	if got := selected.Selected(); got != -1 {
+		t.Fatalf("after removing selected item Selected() = %d, want -1", got)
+	}
+	if got := selected.SizeHint(); got != (image.Point{5, 2}) {
+		t.Fatalf("after removing selected item SizeHint() = %v, want (5,2)", got)
+	}
+	if got := selectedChanged; len(got) != 1 || got[0] != -1 {
+		t.Fatalf("selected-remove callback log = %#v, want []int{-1}", got)
+	}
+	selectedSurface := repaintList(selected, 6, 3, tui.NewTheme())
+
+	assertTextRow(t, selectedSurface, 0, "one   ")
+	assertTextRow(t, selectedSurface, 1, "three ")
+}
+
+func TestSelectedRowUsesSelectedStyleAcrossWholeWidth(t *testing.T) {
+
+
+
+	if got := tui.DefaultTheme.Style("list.item.selected"); got.Reverse != tui.DecorationOn {
+		t.Fatalf("DefaultTheme list.item.selected Reverse = %v, want DecorationOn", got.Reverse)
+	}
+
+	l := tui.NewList()
+	l.AddItems("one", "two", "three")
+	l.SetSelected(1)
+
+	surface := repaintList(l, 8, 4, tui.DefaultTheme)
+
+	assertTextRow(t, surface, 0, "one     ")
+	assertTextRow(t, surface, 1, "two     ")
+	assertTextRow(t, surface, 2, "three   ")
+
+	assertReverseBitForRow(t, surface, 0, false)
+	assertReverseBitForRow(t, surface, 1, true)
+	assertReverseBitForRow(t, surface, 2, false)
+}
+
+func TestSelectedItemTracksKeyboardSelection(t *testing.T) {
+
+
+
+	l := tui.NewList()
+	l.AddItems("one", "two", "three")
+	l.SetFocused(true)
+	l.OnKeyEvent(tui.KeyEvent{Key: tui.KeyDown})
+	l.OnKeyEvent(tui.KeyEvent{Key: tui.KeyDown})
+
+	if got := l.Selected(); got != 1 {
+		t.Fatalf("after two focused KeyDown events Selected() = %d, want 1", got)
+	}
+	if got := l.SelectedItem(); got != "two" {
+		t.Fatalf("after two focused KeyDown events SelectedItem() = %q, want %q", got, "two")
+	}
+}
+
+func TestListInstancesKeepIndependentState(t *testing.T) {
+
+
+	a := tui.NewList()
+	b := tui.NewList()
+	a.AddItems("red", "green")
+	b.AddItems("blue")
+	a.SetSelected(1)
+	b.SetSelected(0)
+
+	a.RemoveItem(0)
+
+	if got := a.Length(); got != 1 {
+		t.Fatalf("list a Length() = %d, want 1", got)
+	}
+	if got := a.Selected(); got != 0 {
+		t.Fatalf("list a Selected() = %d, want 0", got)
+	}
+	if got := a.SelectedItem(); got != "green" {
+		t.Fatalf("list a SelectedItem() = %q, want %q", got, "green")
+	}
+	if got := a.SizeHint(); got != (image.Point{5, 1}) {
+		t.Fatalf("list a SizeHint() = %v, want (5,1)", got)
+	}
+	if got := b.Length(); got != 1 {
+		t.Fatalf("list b Length() = %d, want 1", got)
+	}
+	if got := b.Selected(); got != 0 {
+		t.Fatalf("list b Selected() = %d, want 0", got)
+	}
+	if got := b.SelectedItem(); got != "blue" {
+		t.Fatalf("list b SelectedItem() = %q, want %q", got, "blue")
+	}
+	if got := b.SizeHint(); got != (image.Point{4, 1}) {
+		t.Fatalf("list b SizeHint() = %v, want (4,1)", got)
+	}
+}
+
+func TestListCanBeUsedAsNormalWidget(t *testing.T) {
+
+
+
+	var w tui.Widget = tui.NewList()
+	l := w.(*tui.List)
+	l.AddItems("one", "two", "three")
+	l.SetSelected(1)
+	w.SetFocused(true)
+	w.OnKeyEvent(tui.KeyEvent{Key: tui.KeyDown})
+
+	surface := tui.NewTestSurface(8, 4)
+	tui.NewPainter(surface, tui.DefaultTheme).Repaint(w)
+
+	if got := l.Selected(); got != 2 {
+		t.Fatalf("Widget OnKeyEvent selected index = %d, want 2", got)
+	}
+	if got := surface.String(); !strings.Contains(got, "three") {
+		t.Fatalf("Widget Draw output = %q, want it to contain selected list item %q", got, "three")
+	}
+}
