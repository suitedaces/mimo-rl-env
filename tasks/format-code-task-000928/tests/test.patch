+import { describe, expect, it } from 'vitest';
+import { faker, FakerError } from '../src';
+
+describe('string rename to exclude', () => {
+  describe('alpha', () => {
+    it('excludes characters via exclude array', () => {
+      const actual = faker.string.alpha({
+        length: 100,
+        casing: 'lower',
+        exclude: ['a', 'p'],
+      });
+      expect(actual).toHaveLength(100);
+      expect(actual).toMatch(/^[b-oq-z]{100}$/);
+    });
+
+    it('excludes characters via exclude string', () => {
+      const actual = faker.string.alpha({
+        length: 100,
+        casing: 'lower',
+        exclude: 'ap',
+      });
+      expect(actual).toHaveLength(100);
+      expect(actual).toMatch(/^[b-oq-z]{100}$/);
+    });
+
+    it('throws FakerError when all alpha characters are excluded', () => {
+      const exclude = 'abcdefghijklmnopqrstuvwxyz'.split('');
+      expect(() =>
+        faker.string.alpha({
+          length: 5,
+          casing: 'lower',
+          exclude,
+        })
+      ).toThrowError(FakerError);
+    });
+
+    it('does not mutate the input exclude array', () => {
+      const input: {
+        length: number;
+        casing: 'mixed';
+        exclude: string[];
+      } = Object.freeze({
+        length: 5,
+        casing: 'mixed',
+        exclude: ['a', '%'],
+      });
+
+      expect(() => faker.string.alpha(input)).not.toThrow();
+      expect(input.exclude).toEqual(['a', '%']);
+    });
+  });
+
+  describe('alphanumeric', () => {
+    it('excludes alpha characters via exclude array', () => {
+      const exclude = 'abcdefghijklmnopqrstuvwxyz'.split('');
+      const actual = faker.string.alphanumeric({
+        length: 100,
+        casing: 'lower',
+        exclude,
+      });
+      expect(actual).toHaveLength(100);
+      for (const ch of exclude) {
+        expect(actual).not.toContain(ch);
+      }
+    });
+
+    it('excludes characters via exclude string', () => {
+      const actual = faker.string.alphanumeric({
+        length: 100,
+        casing: 'lower',
+        exclude: 'abcdefghijklmnopqrstuvwxyz',
+      });
+      expect(actual).toHaveLength(100);
+      expect(actual).toMatch(/^[0-9]{100}$/);
+    });
+
+    it('excludes numeric characters via exclude array', () => {
+      const exclude = '0123456789'.split('');
+      const actual = faker.string.alphanumeric({
+        length: 100,
+        exclude,
+      });
+      expect(actual).toHaveLength(100);
+      for (const ch of exclude) {
+        expect(actual).not.toContain(ch);
+      }
+    });
+
+    it('throws FakerError when all alphanumeric characters are excluded', () => {
+      const exclude = 'abcdefghijklmnopqrstuvwxyz0123456789'.split('');
+      expect(() =>
+        faker.string.alphanumeric({
+          length: 5,
+          casing: 'lower',
+          exclude,
+        })
+      ).toThrowError(FakerError);
+    });
+  });
+
+  describe('numeric', () => {
+    it('excludes digits via exclude array', () => {
+      const actual = faker.string.numeric({
+        length: 1000,
+        exclude: '12345'.split(''),
+      });
+      expect(actual).toHaveLength(1000);
+      expect(actual).toMatch(/^[6-90]*[6-9][6-90]*$/);
+      for (const ch of '12345') {
+        expect(actual).not.toContain(ch);
+      }
+    });
+
+    it('excludes digits via exclude string', () => {
+      const actual = faker.string.numeric({
+        length: 1000,
+        exclude: '12345',
+      });
+      expect(actual).toHaveLength(1000);
+      for (const ch of '12345') {
+        expect(actual).not.toContain(ch);
+      }
+    });
+
+    it('produces all zeros when allowLeadingZeros true and other digits excluded via array', () => {
+      const actual = faker.string.numeric({
+        length: 4,
+        allowLeadingZeros: true,
+        exclude: '123456789'.split(''),
+      });
+      expect(actual).toBe('0000');
+    });
+
+    it('produces all zeros when allowLeadingZeros true and other digits excluded via string', () => {
+      const actual = faker.string.numeric({
+        length: 4,
+        allowLeadingZeros: true,
+        exclude: '123456789',
+      });
+      expect(actual).toBe('0000');
+    });
+
+    it('throws FakerError when allowLeadingZeros false and all non-zero digits excluded', () => {
+      expect(() =>
+        faker.string.numeric({
+          length: 4,
+          allowLeadingZeros: false,
+          exclude: '123456789'.split(''),
+        })
+      ).toThrowError(FakerError);
+    });
+
+    it('does not include 0 as leading char when 0 is excluded and allowLeadingZeros false', () => {
+      const actual = faker.string.numeric({
+        length: 100,
+        allowLeadingZeros: false,
+        exclude: ['0'],
+      });
+      expect(actual).toHaveLength(100);
+      expect(actual).not.toContain('0');
+    });
+  });
+
+  describe('random module proxies still work with bannedChars/bannedDigits', () => {
+    it('faker.random.alpha forwards bannedChars to string.alpha exclude', () => {
+      const actual = faker.random.alpha({
+        count: 100,
+        casing: 'lower',
+        bannedChars: ['a', 'b', 'c', 'd', 'e'],
+      });
+      expect(actual).toHaveLength(100);
+      for (const ch of ['a', 'b', 'c', 'd', 'e']) {
+        expect(actual).not.toContain(ch);
+      }
+    });
+
+    it('faker.random.alphaNumeric forwards bannedChars to string.alphanumeric exclude', () => {
+      const actual = faker.random.alphaNumeric(100, {
+        casing: 'lower',
+        bannedChars: ['a', 'b', 'c', 'd', 'e'],
+      });
+      expect(actual).toHaveLength(100);
+      for (const ch of ['a', 'b', 'c', 'd', 'e']) {
+        expect(actual).not.toContain(ch);
+      }
+    });
+
+    it('faker.random.numeric forwards bannedDigits to string.numeric exclude', () => {
+      const actual = faker.random.numeric(100, {
+        bannedDigits: ['1', '2', '3', '4', '5'],
+      });
+      expect(actual).toHaveLength(100);
+      for (const ch of ['1', '2', '3', '4', '5']) {
+        expect(actual).not.toContain(ch);
+      }
+    });
+  });
+
+  describe('downstream callers preserve excluded characters', () => {
+    it('vehicle.vin excludes I, O, Q', () => {
+      for (let i = 0; i < 50; i++) {
+        const vin = faker.vehicle.vin();
+        expect(vin).toHaveLength(17);
+        expect(vin).not.toContain('I');
+        expect(vin).not.toContain('O');
+        expect(vin).not.toContain('Q');
+      }
+    });
+
+    it('finance.bitcoinAddress excludes 0, O, I, l', () => {
+      for (let i = 0; i < 50; i++) {
+        const address = faker.finance.bitcoinAddress();
+
+        const body = address.slice(1);
+        expect(body).not.toContain('0');
+        expect(body).not.toContain('O');
+        expect(body).not.toContain('I');
+        expect(body).not.toContain('l');
+      }
+    });
+  });
+});
