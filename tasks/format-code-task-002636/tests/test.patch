@@ -4,6 +4,7 @@ const expect = require('chai').expect;
 const sinon = require('sinon');
 const path = require('path');
 const fs = require('fs');
+const BbPromise = require('bluebird');
 const proxyquire = require('proxyquire');
 const AwsProvider = require('../provider/awsProvider');
 const Serverless = require('../../../Serverless');
@@ -260,3 +261,196 @@ describe('AwsDeployFunction', () => {
     });
   });
 });
+
+describe('AwsDeployFunction updateFunctionConfiguration feature', () => {
+  let AwsDeployFunction;
+  let serverless;
+  let awsDeployFunction;
+  let requestStub;
+  let fnObj;
+
+  beforeEach(() => {
+    serverless = new Serverless();
+    serverless.servicePath = true;
+    serverless.service.environment = {
+      vars: {},
+      stages: {
+        dev: {
+          vars: {},
+          regions: {
+            'us-east-1': {
+              vars: {},
+            },
+          },
+        },
+      },
+    };
+    fnObj = { name: 'first', handler: 'handler.first' };
+    serverless.service.functions = { first: fnObj };
+    const options = {
+      stage: 'dev',
+      region: 'us-east-1',
+      function: 'first',
+      functionObj: fnObj,
+      'update-config': true,
+    };
+    return serverless.init().then(() => {
+      serverless.setProvider('aws', new AwsProvider(serverless));
+      AwsDeployFunction = proxyquire('./index.js', {});
+      awsDeployFunction = new AwsDeployFunction(serverless, options);
+      requestStub = sinon
+        .stub(awsDeployFunction.provider, 'request')
+        .returns(BbPromise.resolve());
+      sinon.spy(awsDeployFunction.serverless.cli, 'log');
+      serverless.service.provider.remoteFunctionData = {
+        Configuration: {
+          CodeSha256: 'remote-hash-zip-file',
+          Handler: 'remote.handler',
+          MemorySize: 1,
+          Timeout: 1,
+          Runtime: 'remote-runtime',
+          Description: 'remote-description',
+          Role: 'arn:aws:iam::remote-role',
+          Environment: { Variables: { REMOTE_VAR: 'remote' } },
+        },
+      };
+    });
+  });
+
+  afterEach(() => {
+    awsDeployFunction.provider.request.restore();
+  });
+
+  describe('#updateFunctionConfiguration() method', () => {
+    it('should exist as a method on the class', () => {
+      expect(typeof awsDeployFunction.updateFunctionConfiguration).to.equal('function');
+    });
+
+    it('should call provider.request with Lambda updateFunctionConfiguration', () =>
+      awsDeployFunction.updateFunctionConfiguration().then(() => {
+        expect(requestStub.calledOnce).to.equal(true);
+        const args = requestStub.getCall(0).args;
+        expect(args[0]).to.equal('Lambda');
+        expect(args[1]).to.equal('updateFunctionConfiguration');
+        expect(args[2].FunctionName).to.equal('first');
+        expect(args[3]).to.equal('dev');
+        expect(args[4]).to.equal('us-east-1');
+      })
+    );
+
+    it('should set Description from functionObj.description', () => {
+      awsDeployFunction.options.functionObj.description = 'specific-fn-description';
+      return awsDeployFunction.updateFunctionConfiguration().then(() => {
+        const params = requestStub.getCall(0).args[2];
+        expect(params.Description).to.equal('specific-fn-description');
+      });
+    });
+
+    it('should pass functionObj.memorySize through as MemorySize', () => {
+      awsDeployFunction.options.functionObj.memorySize = 512;
+      return awsDeployFunction.updateFunctionConfiguration().then(() => {
+        const params = requestStub.getCall(0).args[2];
+        expect(params.MemorySize).to.equal(512);
+      });
+    });
+
+    it('should fall back to provider.memorySize when not set on functionObj', () => {
+      serverless.service.provider.memorySize = 768;
+      return awsDeployFunction.updateFunctionConfiguration().then(() => {
+        const params = requestStub.getCall(0).args[2];
+        expect(params.MemorySize).to.equal(768);
+      });
+    });
+
+    it('should pass functionObj.timeout through as Timeout', () => {
+      awsDeployFunction.options.functionObj.timeout = 17;
+      return awsDeployFunction.updateFunctionConfiguration().then(() => {
+        const params = requestStub.getCall(0).args[2];
+        expect(params.Timeout).to.equal(17);
+      });
+    });
+
+    it('should set Role from functionObj.role', () => {
+      awsDeployFunction.options.functionObj.role = 'arn:aws:iam::123:role/myRole';
+      return awsDeployFunction.updateFunctionConfiguration().then(() => {
+        const params = requestStub.getCall(0).args[2];
+        expect(params.Role).to.equal('arn:aws:iam::123:role/myRole');
+      });
+    });
+
+    it('should set DeadLetterConfig.TargetArn from functionObj.onError', () => {
+      awsDeployFunction.options.functionObj.onError = 'arn:aws:sns:us-east-1:123:topic';
+      return awsDeployFunction.updateFunctionConfiguration().then(() => {
+        const params = requestStub.getCall(0).args[2];
+        expect(params.DeadLetterConfig).to.deep.equal({
+          TargetArn: 'arn:aws:sns:us-east-1:123:topic',
+        });
+      });
+    });
+
+    it('should merge environment variables from provider and function', () => {
+      serverless.service.provider.environment = { PROVIDER_VAR: 'p_val', SHARED: 'p_val' };
+      awsDeployFunction.options.functionObj.environment = { FUNC_VAR: 'f_val', SHARED: 'f_val' };
+      return awsDeployFunction.updateFunctionConfiguration().then(() => {
+        const params = requestStub.getCall(0).args[2];
+        expect(params.Environment).to.be.an('object');
+        expect(params.Environment.Variables).to.deep.equal({
+          PROVIDER_VAR: 'p_val',
+          FUNC_VAR: 'f_val',
+          SHARED: 'f_val',
+        });
+      });
+    });
+
+    it('should set VpcConfig from functionObj.vpc', () => {
+      awsDeployFunction.options.functionObj.vpc = {
+        securityGroupIds: ['sg-fn'],
+        subnetIds: ['sn-fn'],
+      };
+      return awsDeployFunction.updateFunctionConfiguration().then(() => {
+        const params = requestStub.getCall(0).args[2];
+        expect(params.VpcConfig).to.deep.equal({
+          SecurityGroupIds: ['sg-fn'],
+          SubnetIds: ['sn-fn'],
+        });
+      });
+    });
+
+    it('should log a "Successfully" message referencing the function on success', () =>
+      awsDeployFunction.updateFunctionConfiguration().then(() => {
+        const matchingCall = awsDeployFunction.serverless.cli.log.getCalls()
+          .find((call) => /Successfully/.test(call.args[0]) && /first/.test(call.args[0]));
+        expect(matchingCall).to.not.equal(undefined);
+      })
+    );
+  });
+
+  describe('"deploy:function:deploy" hook', () => {
+    let deployFunctionStub;
+    let updateFunctionConfigurationStub;
+    let spawnStub;
+
+    beforeEach(() => {
+      deployFunctionStub = sinon
+        .stub(awsDeployFunction, 'deployFunction')
+        .returns(BbPromise.resolve());
+      updateFunctionConfigurationStub = sinon
+        .stub(awsDeployFunction, 'updateFunctionConfiguration')
+        .returns(BbPromise.resolve());
+      spawnStub = sinon
+        .stub(awsDeployFunction.serverless.pluginManager, 'spawn')
+        .returns(BbPromise.resolve());
+    });
+
+    afterEach(() => {
+      awsDeployFunction.serverless.pluginManager.spawn.restore();
+    });
+
+    it('should call deployFunction when --update-config option is NOT set', () => {
+      awsDeployFunction.options['update-config'] = undefined;
+      return awsDeployFunction.hooks['deploy:function:deploy']().then(() => {
+        expect(deployFunctionStub.called).to.equal(true);
+      });
+    });
+  });
+});
