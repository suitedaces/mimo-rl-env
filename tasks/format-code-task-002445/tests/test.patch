@@ -0,0 +1,40 @@
+import importlib
+from collections import defaultdict
+
+from arcade.gui import UIAnchorLayout, UIGridLayout
+
+
+def load_color_picker_module():
+    return importlib.import_module("arcade.examples.gui.5_uicolor_picker")
+
+
+def test_color_picker_palette_buttons_are_added_once_to_palette_area(monkeypatch, window):
+    module = load_color_picker_module()
+    added_to = defaultdict(list)
+    grid_children = set()
+
+    anchor_add = UIAnchorLayout.add
+    grid_add = UIGridLayout.add
+
+    def record_anchor_add(self, child, *args, **kwargs):
+        added_to[child].append(type(self).__name__)
+        return anchor_add(self, child, *args, **kwargs)
+
+    def record_grid_add(self, child, *args, **kwargs):
+        grid_children.add(child)
+        added_to[child].append(type(self).__name__)
+        return grid_add(self, child, *args, **kwargs)
+
+    monkeypatch.setattr(UIAnchorLayout, "add", record_anchor_add)
+    monkeypatch.setattr(UIGridLayout, "add", record_grid_add)
+
+    view = module.ColorView()
+    window.show_view(view)
+
+    palette_button_attachments = {
+        button: added_to[button]
+        for button in grid_children
+        if added_to[button]
+    }
+
+    assert all(len(containers) == 1 for containers in palette_button_attachments.values())
+    assert len(palette_button_attachments) > 1
diff --git a/tests/unit/gui/test_layouting_box_zero_size_public.py b/tests/unit/gui/test_layouting_box_zero_size_public.py
new file mode 100644
index 00000000..9af6809e
--- /dev/null
+++ b/tests/unit/gui/test_layouting_box_zero_size_public.py
@@ -0,0 +1,84 @@
+import warnings
+
+from arcade.gui import UIBoxLayout, UIWidget
+
+
+WARNING_MESSAGE = "Container size is 0, cannot calculate sizes for children."
+
+
+def layout_children(vertical, container_width, container_height, child_sizes):
+    layout = UIBoxLayout(vertical=vertical, width=container_width, height=container_height)
+    children = []
+
+    for width, height in child_sizes:
+        child = UIWidget(
+            width=width,
+            height=height,
+            size_hint=(1, 1),
+            size_hint_min=(width, height),
+        )
+        layout.add(child)
+        children.append(child)
+
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore")
+        layout.do_layout()
+
+    return children
+
+
+def axis_sizes(children, axis):
+    if axis == "width":
+        return [child.width for child in children]
+    return [child.height for child in children]
+
+
+def warning_messages_for_layout(vertical, container_width, container_height, child_sizes):
+    layout = UIBoxLayout(vertical=vertical, width=container_width, height=container_height)
+    for width, height in child_sizes:
+        layout.add(
+            UIWidget(
+                width=width,
+                height=height,
+                size_hint=(1, 1),
+                size_hint_min=(width, height),
+            )
+        )
+
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always")
+        layout.do_layout()
+
+    return [str(entry.message) for entry in caught]
+
+
+def test_horizontal_box_zero_available_width_uses_child_minimums():
+    children = layout_children(False, 0, 90, [(10, 12), (25, 12), (40, 12)])
+
+    assert axis_sizes(children, "width") == [10, 25, 40]
+
+
+def test_horizontal_box_negative_available_width_uses_child_minimums():
+    children = layout_children(False, -7, 90, [(10, 12), (25, 12), (40, 12)])
+
+    assert axis_sizes(children, "width") == [10, 25, 40]
+
+
+def test_vertical_box_zero_available_height_uses_child_minimums():
+    children = layout_children(True, 90, 0, [(12, 11), (12, 27), (12, 43)])
+
+    assert axis_sizes(children, "height") == [11, 27, 43]
+
+
+def test_zero_available_size_warns_with_promised_message():
+    messages = warning_messages_for_layout(False, 0, 90, [(10, 12), (25, 12), (40, 12)])
+
+
+    assert WARNING_MESSAGE in messages
+
+
+def test_negative_available_size_warns_with_promised_message():
+    messages = warning_messages_for_layout(False, -7, 90, [(10, 12), (25, 12), (40, 12)])
+
+
+    assert WARNING_MESSAGE in messages
diff --git a/tests/unit/gui/test_widget_background_color_inputs.py b/tests/unit/gui/test_widget_background_color_inputs.py
new file mode 100644
index 00000000..3dfe55a2
--- /dev/null
+++ b/tests/unit/gui/test_widget_background_color_inputs.py
@@ -0,0 +1,39 @@
+import pytest
+
+from arcade.gui import UIWidget
+
+
+class BackgroundProbeSurface:
+    def __init__(self):
+        self.colors = []
+
+    def limit(self, rect):
+        return None
+
+    def clear(self, color):
+        color.a
+        self.colors.append(color)
+
+    def draw_texture(self, *args, **kwargs):
+        raise AssertionError("background color rendering should not require a texture")
+
+
+def render_background(widget):
+    surface = BackgroundProbeSurface()
+    widget.do_render_base(surface)
+    return surface.colors
+
+
+@pytest.mark.parametrize("rgba", [(40, 90, 160, 255), (1, 2, 3, 255)])
+def test_with_background_accepts_multiple_rgba_tuples_as_renderable_colors(rgba):
+    widget = UIWidget(width=20, height=10).with_background(color=rgba)
+
+    used_colors = render_background(widget)
+
+    assert used_colors
+
+
+def test_with_background_none_keeps_no_background():
+    widget = UIWidget(width=20, height=10).with_background(color=None)
+
+    assert render_background(widget) == []
