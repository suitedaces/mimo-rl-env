@@ -1567,3 +1567,102 @@ def test_merge_asof_array_as_on():
         }
     )
     tm.assert_frame_equal(result, expected)
+
+
+
+
+
+
+def test_merge_asof_on_nonunique_both_raises():
+
+    left = pd.DataFrame(
+        [[1, 2, "a"], [5, 6, "b"], [10, 11, "c"]],
+        columns=["a", "a", "left_val"],
+    )
+    right = pd.DataFrame(
+        [[x] * 3 for x in [1, 2, 3, 6, 7]],
+        columns=["a", "a", "right_val"],
+    )
+    with pytest.raises(ValueError, match="(?i)unique"):
+        merge_asof(left, right, on="a")
+
+
+def test_merge_asof_on_nonunique_not_attribute_error():
+
+    left = pd.DataFrame(
+        [[1, 2, "a"], [5, 6, "b"], [10, 11, "c"]],
+        columns=["a", "a", "left_val"],
+    )
+    right = pd.DataFrame(
+        [[x] * 3 for x in [1, 2, 3, 6, 7]],
+        columns=["a", "a", "right_val"],
+    )
+    try:
+        merge_asof(left, right, on="a")
+    except AttributeError as e:
+        raise AssertionError(
+            f"merge_asof raised AttributeError instead of a helpful error: {e}"
+        )
+    except Exception:
+
+        pass
+
+
+def test_merge_asof_left_on_nonunique_left_raises():
+
+    left = pd.DataFrame(
+        [[1, 2, "a"], [5, 6, "b"], [10, 11, "c"]],
+        columns=["a", "a", "left_val"],
+    )
+    right = pd.DataFrame(
+        [[x] * 3 for x in [1, 2, 3, 6, 7]],
+        columns=["a", "a", "right_val"],
+    )
+    with pytest.raises(ValueError, match="(?i)unique"):
+        merge_asof(left, right, left_on="a", right_on="right_val")
+
+
+def test_merge_asof_right_on_nonunique_right_raises():
+
+    left = pd.DataFrame(
+        [[1, 2, "a"], [5, 6, "b"], [10, 11, "c"]],
+        columns=["a", "a", "left_val"],
+    )
+    right = pd.DataFrame(
+        [[x] * 3 for x in [1, 2, 3, 6, 7]],
+        columns=["a", "a", "right_val"],
+    )
+    with pytest.raises(ValueError, match="(?i)unique"):
+        merge_asof(left, right, left_on="left_val", right_on="a")
+
+
+def test_merge_asof_on_nonunique_left_only_raises():
+
+    left = pd.DataFrame(
+        [[1, 2, "a"], [5, 6, "b"]],
+        columns=["a", "a", "left_val"],
+    )
+    right = pd.DataFrame({"a": [1, 2, 3], "right_val": [10, 20, 30]})
+    with pytest.raises(ValueError, match="(?i)unique"):
+        merge_asof(left, right, on="a")
+
+
+def test_merge_asof_on_nonunique_right_only_raises():
+
+    left = pd.DataFrame({"a": [1, 5, 10], "left_val": ["a", "b", "c"]})
+    right = pd.DataFrame(
+        [[x] * 3 for x in [1, 2, 3]],
+        columns=["a", "a", "right_val"],
+    )
+    with pytest.raises(ValueError, match="(?i)unique"):
+        merge_asof(left, right, on="a")
+
+
+def test_merge_asof_unique_on_with_duplicate_other_cols_succeeds():
+
+
+    left = pd.DataFrame([[1, 2, 3], [2, 4, 5]], columns=["a", "b", "b"])
+    right = pd.DataFrame([[1, 10, 11], [2, 20, 21]], columns=["a", "c", "c"])
+    result = merge_asof(left, right, on="a")
+    assert result.shape == (2, 5)
+    assert list(result["a"]) == [1, 2]
