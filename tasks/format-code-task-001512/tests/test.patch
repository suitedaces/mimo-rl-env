+async def test_setup_entry_raises_not_ready_when_config_returns_none(
+    hass: HomeAssistant, config_entry
+) -> None:
+    """When the server returns no config, async_setup_entry must not crash
+    with AttributeError. It must raise PlatformNotReady (or any IntegrationError
+    subclass) so Home Assistant retries the platform setup later.
+    """
+    from homeassistant.components.forked_daapd.media_player import async_setup_entry
+
+    config_entry.add_to_hass(hass)
+
+    async def get_request_side_effect(update_type):
+        return None
+
+    with patch(
+        "homeassistant.components.forked_daapd.media_player.ForkedDaapdAPI",
+        autospec=True,
+    ) as mock_api:
+        mock_api.return_value.get_request.side_effect = get_request_side_effect
+        mock_api.return_value.full_url.return_value = ""
+        mock_api.return_value.get_pipes.return_value = SAMPLE_PIPES
+        mock_api.return_value.get_playlists.return_value = SAMPLE_PLAYLISTS
+
+        mock_add_entities = MagicMock()
+
+
+
+        with pytest.raises(IntegrationError):
+            await async_setup_entry(hass, config_entry, mock_add_entities)
+
+
+
+        mock_api.return_value.start_websocket_handler.assert_not_called()
+
+
+async def test_unload_entry_after_failed_setup_does_not_crash(
+    hass: HomeAssistant, config_entry
+) -> None:
+    """When platform setup failed (server config returned None), unloading
+    the config entry must still succeed without raising.
+
+    Pre-fix, async_unload_entry would either KeyError (HASS_DATA_UPDATER_KEY
+    never set) or AttributeError (websocket_handler is None) when the user
+    later removes / reloads the integration.
+    """
+    from homeassistant.components.forked_daapd import async_unload_entry
+    from homeassistant.components.forked_daapd.media_player import async_setup_entry
+
+    config_entry.add_to_hass(hass)
+
+    async def get_request_side_effect(update_type):
+        return None
+
+    with patch(
+        "homeassistant.components.forked_daapd.media_player.ForkedDaapdAPI",
+        autospec=True,
+    ) as mock_api:
+        mock_api.return_value.get_request.side_effect = get_request_side_effect
+        mock_api.return_value.full_url.return_value = ""
+        mock_api.return_value.get_pipes.return_value = SAMPLE_PIPES
+        mock_api.return_value.get_playlists.return_value = SAMPLE_PLAYLISTS
+
+        mock_add_entities = MagicMock()
+        with pytest.raises(IntegrationError):
+            await async_setup_entry(hass, config_entry, mock_add_entities)
+
+
+
+
+
+    with patch.object(
+        hass.config_entries,
+        "async_unload_platforms",
+        return_value=True,
+    ):
+
+        result = await async_unload_entry(hass, config_entry)
+        assert result is True
+
+
+async def test_setup_entry_success_unchanged_when_config_valid(
+    hass: HomeAssistant, config_entry
+) -> None:
+    """Preservation test: when the server returns a valid config, the
+    platform must still set up successfully and start the websocket handler.
+    """
+    from homeassistant.components.forked_daapd.media_player import async_setup_entry
+
+    config_entry.add_to_hass(hass)
+
+    async def get_request_side_effect(update_type):
+        if update_type == "outputs":
+            return {"outputs": SAMPLE_OUTPUTS_ON}
+        return {
+            "config": SAMPLE_CONFIG,
+            "player": SAMPLE_PLAYER_PAUSED,
+            "queue": SAMPLE_QUEUE,
+        }[update_type]
+
+    with patch(
+        "homeassistant.components.forked_daapd.media_player.ForkedDaapdAPI",
+        autospec=True,
+    ) as mock_api:
+        mock_api.return_value.get_request.side_effect = get_request_side_effect
+        mock_api.return_value.full_url.return_value = ""
+        mock_api.return_value.get_pipes.return_value = SAMPLE_PIPES
+        mock_api.return_value.get_playlists.return_value = SAMPLE_PLAYLISTS
+
+        mock_add_entities = MagicMock()
+
+        await async_setup_entry(hass, config_entry, mock_add_entities)
+        await hass.async_block_till_done()
+
+        mock_api.return_value.start_websocket_handler.assert_called_once()
