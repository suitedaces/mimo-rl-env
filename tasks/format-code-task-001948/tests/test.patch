diff --git a/mne/tests/test_filter.py b/mne/tests/test_filter.py
index 0609436d7..045f89fc3 100644
--- a/mne/tests/test_filter.py
+++ b/mne/tests/test_filter.py
@@ -530,4 +530,74 @@ def test_interp2():
     assert_allclose(out, expected, atol=1e-7)
 
 
+def test_firwin_filter_length_odd_5s():
+    """Test issue repro: fir_design='firwin' with '5s' filter_length, phase='zero-double'."""
+
+
+
+    sfreq = 600.0
+    data = np.zeros(int(sfreq * 10))
+    h = create_filter(
+        data, sfreq, l_freq=None, h_freq=55.,
+        filter_length='5s',
+        l_trans_bandwidth=0.5, h_trans_bandwidth=0.5,
+        method='fir', phase='zero-double',
+        fir_window='hann', fir_design='firwin')
+
+
+    assert h.size in (4096, 4097)
+
+
+def test_firwin_filter_length_odd_auto():
+    """Test that fir_design='firwin' with 'auto' length doesn't crash."""
+
+
+
+    sfreq = 600.0
+    data = np.zeros(int(sfreq * 10))
+    h = create_filter(
+        data, sfreq, l_freq=None, h_freq=55.,
+        filter_length='auto',
+        l_trans_bandwidth=0.5, h_trans_bandwidth=0.5,
+        method='fir', phase='zero-double',
+        fir_window='hann', fir_design='firwin')
+
+
+    assert h.size in (3720, 3721)
+
+
+def test_firwin2_filter_length_unchanged():
+    """Preservation: fir_design='firwin2' length is NOT forced odd."""
+    sfreq = 600.0
+    data = np.zeros(int(sfreq * 10))
+    h = create_filter(
+        data, sfreq, l_freq=None, h_freq=55.,
+        filter_length='5s',
+        l_trans_bandwidth=0.5, h_trans_bandwidth=0.5,
+        method='fir', phase='zero-double',
+        fir_window='hann', fir_design='firwin2')
+
+    assert h.size == 4096
+
+
+def test_firwin_logged_length_matches_actual():
+    """The 'Filter length of X samples' log message must match actual filter size."""
+    import re
+    sfreq = 600.0
+    data = np.zeros(int(sfreq * 10))
+    with catch_logging() as log:
+        h = create_filter(
+            data, sfreq, l_freq=None, h_freq=55.,
+            filter_length='auto',
+            l_trans_bandwidth=0.5, h_trans_bandwidth=0.5,
+            method='fir', phase='zero-double',
+            fir_window='hann', fir_design='firwin', verbose=True)
+    log_text = log.getvalue()
+    match = re.search(r'Filter length of (\d+) samples', log_text)
+    assert match is not None, 'expected length log, got: %r' % log_text
+    logged_length = int(match.group(1))
+    assert logged_length == h.size, (
+        'log reports %d but actual filter size is %d' % (logged_length, h.size))
+
+
 run_tests_if_main()
