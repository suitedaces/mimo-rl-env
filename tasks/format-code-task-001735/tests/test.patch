@@ -0,0 +1,28 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+
+mkdir -p /root/go/src/k8s.io/autoscaler
+ln -sf /testbed/vertical-pod-autoscaler /root/go/src/k8s.io/autoscaler/vertical-pod-autoscaler
+
+
+export GO111MODULE=off
+
+cd /root/go/src/k8s.io/autoscaler/vertical-pod-autoscaler
+
+
+case "${1:-}" in
+  base)
+    go test -v ./pkg/recommender/model/
+    ;;
+  new)
+    go test -v ./pkg/recommender/routines/ -run 'TestUpdateVPAs(WritesNoPodsMatchedStatusForSelectorMiss|DoesNotMarkNoPodsMatchedWhenLivePodMatches|KeepsRecommendationProvidedTrueWhenRecommendationExists)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
