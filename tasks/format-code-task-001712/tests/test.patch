+package usercase_test_coderl
+
+import (
+	"testing"
+
+	"github.com/krotik/eliasdb/graph"
+	"github.com/krotik/eliasdb/graph/data"
+	"github.com/krotik/eliasdb/graph/graphstorage"
+	graphutil "github.com/krotik/eliasdb/graph/util"
+	"github.com/krotik/eliasdb/storage"
+)
+
+type nodeSpec struct {
+	key  string
+	kind string
+}
+
+func newManagerWithNodes(t *testing.T, storageName string, nodes []nodeSpec) (*graph.Manager, graphstorage.Storage) {
+	t.Helper()
+
+	gs := graphstorage.NewMemoryGraphStorage(storageName)
+	gm := graph.NewGraphManager(gs)
+
+	for _, spec := range nodes {
+		node := data.NewGraphNode()
+		node.SetAttr("key", spec.key)
+		node.SetAttr("kind", spec.kind)
+		if err := gm.StoreNode("main", node); err != nil {
+			t.Fatalf("StoreNode(%q, %q) error = %v, want nil", spec.key, spec.kind, err)
+		}
+	}
+
+	return gm, gs
+}
+
+func assertNilIteratorAndNilError(t *testing.T, it *graph.NodeKeyIterator, err error) {
+	t.Helper()
+
+	if it != nil {
+		t.Fatalf("iterator nil = false, want true")
+	}
+	if err != nil {
+		t.Fatalf("error = %v, want nil", err)
+	}
+}
+
+func assertReadingGraphError(t *testing.T, got error) {
+	t.Helper()
+
+	ge, ok := got.(*graphutil.GraphError)
+	if !ok {
+		t.Fatalf("error type = %T, want *util.GraphError", got)
+	}
+	if ge.Type != graphutil.ErrReading {
+		t.Fatalf("GraphError.Type = %v, want %v", ge.Type, graphutil.ErrReading)
+	}
+
+}
+
+func TestNodeKeyIteratorSessionScansOnlyRequestedKind(t *testing.T) {
+
+
+	gm, gs := newManagerWithNodes(t, "accept-session", []nodeSpec{
+		{key: "123", kind: "mykind"},
+		{key: "789", kind: "mykind"},
+		{key: "456", kind: "mykind2"},
+	})
+	defer gs.Close()
+
+	it, err := gm.NodeKeyIterator("main", "mykind")
+	if err != nil {
+		t.Fatalf("NodeKeyIterator error = %v, want nil", err)
+	}
+	if it == nil {
+		t.Fatalf("iterator nil = true, want false")
+	}
+	if it.HasNext() != true {
+		t.Fatalf("fresh HasNext() = false, want true")
+	}
+	if it.LastError != nil {
+		t.Fatalf("fresh LastError = %v, want nil", it.LastError)
+	}
+	if it.Error() != nil {
+		t.Fatalf("fresh Error() = %v, want nil", it.Error())
+	}
+
+	if got := it.Next(); got != "123" {
+		t.Fatalf("first Next() = %q, want %q", got, "123")
+	}
+	if it.HasNext() != true {
+		t.Fatalf("HasNext() after first Next = false, want true")
+	}
+	if it.LastError != nil {
+		t.Fatalf("LastError after first Next = %v, want nil", it.LastError)
+	}
+	if it.Error() != nil {
+		t.Fatalf("Error() after first Next = %v, want nil", it.Error())
+	}
+
+	if got := it.Next(); got != "789" {
+		t.Fatalf("second Next() = %q, want %q", got, "789")
+	}
+	if it.HasNext() != false {
+		t.Fatalf("HasNext() after second Next = true, want false")
+	}
+	if it.LastError != nil {
+		t.Fatalf("LastError after second Next = %v, want nil", it.LastError)
+	}
+	if it.Error() != nil {
+		t.Fatalf("Error() after second Next = %v, want nil", it.Error())
+	}
+
+	if got := it.Next(); got != "" {
+		t.Fatalf("third Next() = %q, want empty string", got)
+	}
+	if it.HasNext() != false {
+		t.Fatalf("HasNext() after exhaustion = true, want false")
+	}
+	if it.LastError != nil {
+		t.Fatalf("LastError after exhaustion = %v, want nil", it.LastError)
+	}
+	if it.Error() != nil {
+		t.Fatalf("Error() after exhaustion = %v, want nil", it.Error())
+	}
+
+	if got := it.Next(); got != "" {
+		t.Fatalf("fourth Next() = %q, want empty string", got)
+	}
+	if it.HasNext() != false {
+		t.Fatalf("HasNext() after repeated exhaustion = true, want false")
+	}
+	if it.LastError != nil {
+		t.Fatalf("LastError after repeated exhaustion = %v, want nil", it.LastError)
+	}
+	if it.Error() != nil {
+		t.Fatalf("Error() after repeated exhaustion = %v, want nil", it.Error())
+	}
+}
+
+func TestNodeKeyIteratorMissingStorageReturnsNilNil(t *testing.T) {
+
+
+	gm, gs := newManagerWithNodes(t, "accept-missing", []nodeSpec{
+		{key: "123", kind: "mykind"},
+		{key: "789", kind: "mykind"},
+		{key: "456", kind: "mykind2"},
+	})
+	defer gs.Close()
+
+	it, err := gm.NodeKeyIterator("main", "missingkind")
+	assertNilIteratorAndNilError(t, it, err)
+
+	it, err = gm.NodeKeyIterator("missingpart", "mykind")
+	assertNilIteratorAndNilError(t, it, err)
+}
+
+func TestNodeKeyIteratorCreationFailureReturnsReadingGraphError(t *testing.T) {
+
+
+	gm, gs := newManagerWithNodes(t, "accept-create-fail", []nodeSpec{
+		{key: "123", kind: "mykind"},
+		{key: "789", kind: "mykind"},
+		{key: "456", kind: "mykind2"},
+	})
+	defer gs.Close()
+
+	msm := nodeStorageManager(t, gs, "main", "mykind")
+	msm.AccessMap[3] = storage.AccessCacheAndFetchSeriousError
+	defer delete(msm.AccessMap, 3)
+
+	it, err := gm.NodeKeyIterator("main", "mykind")
+	if it != nil {
+		t.Fatalf("iterator nil = false, want true")
+	}
+	assertReadingGraphError(t, err)
+}
+
+func TestNodeKeyIteratorNextFailureSetsLastErrorAndError(t *testing.T) {
+
+
+	gm, gs := newManagerWithNodes(t, "accept-next-fail", []nodeSpec{
+		{key: "123", kind: "mykind"},
+		{key: "789", kind: "mykind"},
+		{key: "456", kind: "mykind2"},
+	})
+	defer gs.Close()
+
+	it, err := gm.NodeKeyIterator("main", "mykind")
+	if err != nil {
+		t.Fatalf("NodeKeyIterator error = %v, want nil", err)
+	}
+	if it == nil {
+		t.Fatalf("iterator nil = true, want false")
+	}
+	if it.HasNext() != true {
+		t.Fatalf("fresh HasNext() = false, want true")
+	}
+	if it.LastError != nil {
+		t.Fatalf("fresh LastError = %v, want nil", it.LastError)
+	}
+	if it.Error() != nil {
+		t.Fatalf("fresh Error() = %v, want nil", it.Error())
+	}
+
+	msm := nodeStorageManager(t, gs, "main", "mykind")
+	msm.AccessMap[3] = storage.AccessCacheAndFetchSeriousError
+	defer delete(msm.AccessMap, 3)
+
+	if got := it.Next(); got != "" {
+		t.Fatalf("Next() after read failure = %q, want empty string", got)
+	}
+	if it.HasNext() != false {
+		t.Fatalf("HasNext() after read failure = true, want false")
+	}
+	assertReadingGraphError(t, it.LastError)
+	assertReadingGraphError(t, it.Error())
+}
+
+func TestNodeKeyIteratorInstancesKeepIndependentState(t *testing.T) {
+
+
+	gm, gs := newManagerWithNodes(t, "accept-independent", []nodeSpec{
+		{key: "123", kind: "mykind"},
+		{key: "789", kind: "mykind"},
+		{key: "456", kind: "mykind2"},
+	})
+	defer gs.Close()
+
+	a, err := gm.NodeKeyIterator("main", "mykind")
+	if err != nil {
+		t.Fatalf("iterator a error = %v, want nil", err)
+	}
+	b, err := gm.NodeKeyIterator("main", "mykind")
+	if err != nil {
+		t.Fatalf("iterator b error = %v, want nil", err)
+	}
+	if a == nil {
+		t.Fatalf("iterator a nil = true, want false")
+	}
+	if b == nil {
+		t.Fatalf("iterator b nil = true, want false")
+	}
+
+	if got := a.Next(); got != "123" {
+		t.Fatalf("iterator a first Next() = %q, want %q", got, "123")
+	}
+	if a.HasNext() != true {
+		t.Fatalf("iterator a HasNext() after first Next = false, want true")
+	}
+	if b.HasNext() != true {
+		t.Fatalf("iterator b fresh HasNext() = false, want true")
+	}
+	if got := b.Next(); got != "123" {
+		t.Fatalf("iterator b first Next() = %q, want %q", got, "123")
+	}
+	if got := a.Next(); got != "789" {
+		t.Fatalf("iterator a second Next() = %q, want %q", got, "789")
+	}
+	if got := b.Next(); got != "789" {
+		t.Fatalf("iterator b second Next() = %q, want %q", got, "789")
+	}
+	if a.HasNext() != false {
+		t.Fatalf("iterator a exhausted HasNext() = true, want false")
+	}
+	if b.HasNext() != false {
+		t.Fatalf("iterator b exhausted HasNext() = true, want false")
+	}
+}
+
+func TestNodeKeyIteratorSessionBeforeStorageCleanup(t *testing.T) {
+
+
+	gm, gs := newManagerWithNodes(t, "accept-cleanup", []nodeSpec{
+		{key: "123", kind: "mykind"},
+		{key: "789", kind: "mykind"},
+		{key: "456", kind: "mykind2"},
+	})
+	defer gs.Close()
+
+	it, err := gm.NodeKeyIterator("main", "mykind")
+	if err != nil {
+		t.Fatalf("NodeKeyIterator error = %v, want nil", err)
+	}
+	if it == nil {
+		t.Fatalf("iterator nil = true, want false")
+	}
+	if got := it.Next(); got != "123" {
+		t.Fatalf("first Next() before cleanup = %q, want %q", got, "123")
+	}
+	if got := it.Next(); got != "789" {
+		t.Fatalf("second Next() before cleanup = %q, want %q", got, "789")
+	}
+	if got := it.Next(); got != "" {
+		t.Fatalf("third Next() before cleanup = %q, want empty string", got)
+	}
+
+}
+
+func TestNodeKeyIteratorRepeatedCyclesReturnSpecResults(t *testing.T) {
+
+
+
+
+	for i := 0; i < 150; i++ {
+		gm, gs := newManagerWithNodes(t, "accept-leak", []nodeSpec{
+			{key: "123", kind: "mykind"},
+			{key: "789", kind: "mykind"},
+			{key: "456", kind: "mykind2"},
+		})
+		it, err := gm.NodeKeyIterator("main", "mykind")
+		if err != nil {
+			t.Fatalf("cycle %d NodeKeyIterator error = %v, want nil", i, err)
+		}
+		if it == nil {
+			t.Fatalf("cycle %d iterator nil = true, want false", i)
+		}
+		if got := it.Next(); got != "123" {
+			t.Fatalf("cycle %d first Next() = %q, want %q", i, got, "123")
+		}
+		if got := it.Next(); got != "789" {
+			t.Fatalf("cycle %d second Next() = %q, want %q", i, got, "789")
+		}
+		if got := it.Next(); got != "" {
+			t.Fatalf("cycle %d third Next() = %q, want empty string", i, got)
+		}
+
+		_ = gs.Close()
+	}
+}
+
+func nodeStorageManager(t *testing.T, gs graphstorage.Storage, part string, kind string) *storage.MemoryStorageManager {
+	t.Helper()
+
+	sm := gs.StorageManager(part+kind+graph.StorageSuffixNodes, false)
+	msm, ok := sm.(*storage.MemoryStorageManager)
+	if !ok {
+		t.Fatalf("storage manager type = %T, want *storage.MemoryStorageManager", sm)
+	}
+	return msm
+}
