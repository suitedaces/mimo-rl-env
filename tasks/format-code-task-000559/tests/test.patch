diff --git a/packages/cli/test/generate.test.ts b/packages/cli/test/generate.test.ts
index edeba4de0..8dc0c82b0 100644
--- a/packages/cli/test/generate.test.ts
+++ b/packages/cli/test/generate.test.ts
@@ -173,4 +173,119 @@ describe("generate", async () => {
 		});
 		expect(schema.code).toMatchFileSnapshot("./__snapshots__/migrations.sql");
 	});
+
+	it("drizzle pg with useNumberId should not mark FK userId as primary key", async () => {
+		const schema = await generateDrizzleSchema({
+			file: "test.drizzle",
+			adapter: drizzleAdapter(
+				{},
+				{ provider: "pg", schema: {} },
+			)({} as BetterAuthOptions),
+			options: {
+				database: drizzleAdapter({}, { provider: "pg", schema: {} }),
+				plugins: [twoFactor(), username()],
+				advanced: { database: { useNumberId: true } },
+			},
+		});
+		const code = schema.code;
+
+
+
+		expect(code).toContain('integer("user_id")');
+		expect(code).not.toMatch(/serial\(["']user_id["']\)/);
+		expect(code).not.toMatch(/userId:\s*serial/);
+
+		const userIdBlocks = code.match(/userId:[\s\S]*?(?=,\s*\w+:|\n\s*\}\)|$)/g) || [];
+		expect(userIdBlocks.length).toBeGreaterThan(0);
+		for (const block of userIdBlocks) {
+			expect(block).not.toContain(".primaryKey()");
+			expect(block).not.toContain(".autoIncrement()");
+		}
+
+
+		const tableBlocks = code.match(/pgTable\([\s\S]*?\}\);/g) || [];
+		expect(tableBlocks.length).toBeGreaterThan(0);
+		for (const block of tableBlocks) {
+			const pkMatches = block.match(/\.primaryKey\(/g) || [];
+			expect(pkMatches.length).toBe(1);
+		}
+	});
+
+	it("drizzle mysql with useNumberId should not mark FK userId as primary key", async () => {
+		const schema = await generateDrizzleSchema({
+			file: "test.drizzle",
+			adapter: drizzleAdapter(
+				{},
+				{ provider: "mysql", schema: {} },
+			)({} as BetterAuthOptions),
+			options: {
+				database: drizzleAdapter({}, { provider: "mysql", schema: {} }),
+				plugins: [twoFactor(), username()],
+				advanced: { database: { useNumberId: true } },
+			},
+		});
+		const code = schema.code;
+
+
+
+		expect(code).toContain('int("user_id")');
+		const userIdBlocks = code.match(/userId:[\s\S]*?(?=,\s*\w+:|\n\s*\}\)|$)/g) || [];
+		expect(userIdBlocks.length).toBeGreaterThan(0);
+		for (const block of userIdBlocks) {
+			expect(block).not.toContain(".primaryKey()");
+			expect(block).not.toContain(".autoIncrement()");
+		}
+	});
+
+	it("drizzle sqlite with useNumberId should emit named integer for FK userId without primary key", async () => {
+		const schema = await generateDrizzleSchema({
+			file: "test.drizzle",
+			adapter: drizzleAdapter(
+				{},
+				{ provider: "sqlite", schema: {} },
+			)({} as BetterAuthOptions),
+			options: {
+				database: drizzleAdapter({}, { provider: "sqlite", schema: {} }),
+				plugins: [twoFactor(), username()],
+				advanced: { database: { useNumberId: true } },
+			},
+		});
+		const code = schema.code;
+
+
+
+		expect(code).toContain('integer("user_id")');
+		const userIdBlocks = code.match(/userId:[\s\S]*?(?=,\s*\w+:|\n\s*\}\)|$)/g) || [];
+		expect(userIdBlocks.length).toBeGreaterThan(0);
+		for (const block of userIdBlocks) {
+			expect(block).not.toContain(".primaryKey(");
+			expect(block).not.toContain("autoIncrement");
+			expect(block).not.toContain("mode: 'number'");
+			expect(block).not.toContain('mode: "number"');
+		}
+	});
+
+	it("drizzle pg without useNumberId should still use text for FK userId", async () => {
+		const schema = await generateDrizzleSchema({
+			file: "test.drizzle",
+			adapter: drizzleAdapter(
+				{},
+				{ provider: "pg", schema: {} },
+			)({} as BetterAuthOptions),
+			options: {
+				database: drizzleAdapter({}, { provider: "pg", schema: {} }),
+				plugins: [twoFactor(), username()],
+			},
+		});
+		const code = schema.code;
+
+
+
+		expect(code).toContain('text("user_id")');
+		const userIdBlocks = code.match(/userId:[\s\S]*?(?=,\s*\w+:|\n\s*\}\)|$)/g) || [];
+		expect(userIdBlocks.length).toBeGreaterThan(0);
+		for (const block of userIdBlocks) {
+			expect(block).not.toContain(".primaryKey()");
+		}
+	});
 });
