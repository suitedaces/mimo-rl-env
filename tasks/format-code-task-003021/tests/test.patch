diff --git a/tvm/cell/hash_test.go b/tvm/cell/hash_test.go
new file mode 100644
index 0000000..4359701
--- /dev/null
+++ b/tvm/cell/hash_test.go
@@ -0,0 +1,118 @@
+package cell
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"testing"
+)
+
+func mustHex(t *testing.T, s string) []byte {
+	t.Helper()
+	b, err := hex.DecodeString(s)
+	if err != nil {
+		t.Fatalf("bad hex %q: %v", s, err)
+	}
+	return b
+}
+
+func TestCellHash_Length(t *testing.T) {
+	c := BeginCell().MustStoreUInt(0xABCD, 16).EndCell()
+	h := c.Hash()
+	if len(h) != 32 {
+		t.Fatalf("expected 32 byte hash, got %d", len(h))
+	}
+}
+
+func TestCellHash_KnownVectors(t *testing.T) {
+	cases := []struct {
+		name string
+		cell *Cell
+		want string
+	}{
+		{
+			name: "leaf 16 bit",
+			cell: BeginCell().MustStoreUInt(0xABCD, 16).EndCell(),
+			want: "c580b831e55fcba6f9635f9818ae4d6227b21d370913e36c6f31789d89ac3bde",
+		},
+		{
+			name: "non byte aligned 3 bit",
+			cell: BeginCell().MustStoreUInt(0b101, 3).EndCell(),
+			want: "c8235418b5cd55bc46073ea5cf9f3aac5a594ed782bee88dcd0acfd8ede4c756",
+		},
+		{
+			name: "nested chain with refs",
+			cell: func() *Cell {
+				cc1 := BeginCell().MustStoreUInt(111, 63).EndCell()
+				cc2 := BeginCell().MustStoreUInt(772227, 63).MustStoreRef(cc1).EndCell()
+				cc3 := BeginCell().MustStoreUInt(333, 63).MustStoreRef(cc2).EndCell()
+				return BeginCell().MustStoreUInt(777, 63).MustStoreRef(cc3).EndCell()
+			}(),
+			want: "bb2509fe3cff8f1faae19213774d218c018f9616cd397850c8ad9038db84eaa9",
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := tc.cell.Hash()
+			if !bytes.Equal(got, mustHex(t, tc.want)) {
+				t.Fatalf("hash mismatch\n got: %s\nwant: %s", hex.EncodeToString(got), tc.want)
+			}
+		})
+	}
+}
+
+func TestCellHash_EmptyCell(t *testing.T) {
+
+	want := sha256.Sum256([]byte{0x00, 0x00})
+
+	got := BeginCell().EndCell().Hash()
+	if !bytes.Equal(got, want[:]) {
+		t.Fatalf("empty cell hash mismatch\n got: %s\nwant: %s",
+			hex.EncodeToString(got), hex.EncodeToString(want[:]))
+	}
+}
+
+func TestCellHash_Deterministic(t *testing.T) {
+	build := func() *Cell {
+		ref := BeginCell().MustStoreUInt(42, 32).EndCell()
+		return BeginCell().MustStoreUInt(7, 8).MustStoreRef(ref).EndCell()
+	}
+
+	c := build()
+	h1 := c.Hash()
+	h2 := c.Hash()
+	if !bytes.Equal(h1, h2) {
+		t.Fatal("hashing the same cell twice produced different results")
+	}
+
+
+	if !bytes.Equal(build().Hash(), h1) {
+		t.Fatal("two identical cells produced different hashes")
+	}
+}
+
+func TestCellHash_DataSensitive(t *testing.T) {
+	a := BeginCell().MustStoreUInt(1, 16).EndCell()
+	b := BeginCell().MustStoreUInt(2, 16).EndCell()
+	if bytes.Equal(a.Hash(), b.Hash()) {
+		t.Fatal("cells with different data hashed to the same value")
+	}
+}
+
+func TestCellHash_RefSensitive(t *testing.T) {
+	refA := BeginCell().MustStoreUInt(1, 8).EndCell()
+	refB := BeginCell().MustStoreUInt(2, 8).EndCell()
+
+	noRef := BeginCell().MustStoreUInt(0xFF, 8).EndCell()
+	withRef := BeginCell().MustStoreUInt(0xFF, 8).MustStoreRef(refA).EndCell()
+	if bytes.Equal(noRef.Hash(), withRef.Hash()) {
+		t.Fatal("cell with a reference hashed same as one without")
+	}
+
+	ab := BeginCell().MustStoreUInt(0xFF, 8).MustStoreRef(refA).MustStoreRef(refB).EndCell()
+	ba := BeginCell().MustStoreUInt(0xFF, 8).MustStoreRef(refB).MustStoreRef(refA).EndCell()
+	if bytes.Equal(ab.Hash(), ba.Hash()) {
+		t.Fatal("reference order did not affect the hash")
+	}
+}
