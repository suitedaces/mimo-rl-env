--- /dev/null
+++ b/usercase-test-coderl/test_select_best_combination.py
@@ -0,0 +1,234 @@
+
+
+
+
+
+
+
+import json
+import os
+import socket
+import subprocess
+import sys
+
+import pytest
+
+from GGanalysis.ScoredItem import ScoredItem, select_best_combination
+
+
+def _pack(item):
+    return {
+        "dist": item.score_dist.dist.tolist(),
+        "sub": {key: value.tolist() for key, value in item.sub_stats_exp.items()},
+    }
+
+
+def _as_plain_list(value):
+    if hasattr(value, "tolist"):
+        return value.tolist()
+    return list(value)
+
+
+def _assert_scored_item(actual, expected_dist, expected_sub_stats):
+    packed = _pack(actual)
+    assert packed["dist"] == pytest.approx(expected_dist)
+    assert set(packed["sub"]) == set(expected_sub_stats)
+    for key, expected_values in expected_sub_stats.items():
+        assert packed["sub"][key] == pytest.approx(expected_values)
+
+
+def _query_ab_items():
+    a = ScoredItem([0.2, 0.8], {"atk": [0, 10]}, stats_score={"atk": 1})
+    b = ScoredItem([0.5, 0.5], {"atk": [0, 20]}, stats_score={"atk": 1})
+    return [a, b]
+
+
+def _query_three_items():
+    return [
+        ScoredItem([0.5, 0.5], {"x": [0, 1]}, stats_score={"x": 1}),
+        ScoredItem([0.25, 0.75], {"x": [0, 2]}, stats_score={"x": 1}),
+        ScoredItem([1.0], {"x": [0]}, stats_score={"x": 1}),
+    ]
+
+
+def _snapshot_items(items):
+    return [
+        {
+            "dist": item.score_dist.dist.tolist(),
+            "sub": {key: _as_plain_list(value) for key, value in item.sub_stats_exp.items()},
+            "stats_score": dict(item.stats_score),
+            "drop_p": item.drop_p,
+            "null_mark": item.null_mark,
+        }
+        for item in items
+    ]
+
+
+def test_two_items_default_choose_one_keeps_best_with_tie_to_earlier_item():
+
+
+
+    actual = select_best_combination(_query_ab_items())
+
+    _assert_scored_item(
+        actual,
+        [0.1, 0.9],
+        {"atk": [0.0, 11.11111111111111]},
+    )
+
+
+def test_two_items_choose_two_sums_both_independent_draws():
+
+
+
+    actual = select_best_combination(_query_ab_items(), 2)
+
+    _assert_scored_item(
+        actual,
+        [0.1, 0.5, 0.4],
+        {"atk": [0.0, 12.0, 30.0]},
+    )
+
+
+def test_three_items_choose_two_handles_more_inputs_and_zero_score_item():
+
+
+
+    actual = select_best_combination(_query_three_items(), 2)
+
+    _assert_scored_item(
+        actual,
+        [0.125, 0.5, 0.375],
+        {"x": [0.0, 1.75, 3.0]},
+    )
+
+
+def test_three_uneven_items_choose_one_preserves_multiple_substat_expectations():
+
+
+
+    items = [
+        ScoredItem(
+            [0.1, 0.2, 0.7],
+            {"crit": [0, 4, 8], "hp": [0, 1, 2]},
+            stats_score={"crit": 1, "hp": 0.5},
+        ),
+        ScoredItem(
+            [0.6, 0.4],
+            {"crit": [0, 10], "hp": [0, 3]},
+            stats_score={"crit": 1, "hp": 0.5},
+        ),
+        ScoredItem(
+            [0.3, 0.3, 0.4],
+            {"crit": [0, 5, 9], "hp": [0, 2, 4]},
+            stats_score={"crit": 1, "hp": 0.5},
+        ),
+    ]
+
+    actual = select_best_combination(items, 1)
+
+    _assert_scored_item(
+        actual,
+        [0.018, 0.16199999999999998, 0.82],
+        {
+            "crit": [0.0, 5.0, 8.146341463414634],
+            "hp": [0.0, 1.4074074074074077, 2.292682926829268],
+        },
+    )
+
+
+def test_single_item_choose_one_returns_that_item_distribution():
+
+
+
+    items = [
+        ScoredItem([0.25, 0.0, 0.75], {"atk": [0, 5, 25]}, stats_score={"atk": 1})
+    ]
+
+    actual = select_best_combination(items, 1)
+
+    _assert_scored_item(
+        actual,
+        [0.25, 0.0, 0.75],
+        {"atk": [0.0, 0.0, 25.0]},
+    )
+
+
+def test_chose_num_greater_than_two_raises_specific_value_error():
+    with pytest.raises(ValueError, match="^chose_num should not greater than 2!$"):
+        select_best_combination(_query_ab_items(), 3)
+
+
+def test_referential_transparency_for_same_input():
+    items = _query_three_items()
+
+    first = _pack(select_best_combination(items, 2))
+    second = _pack(select_best_combination(items, 2))
+
+    assert first["dist"] == pytest.approx([0.125, 0.5, 0.375])
+    assert first["sub"]["x"] == pytest.approx([0.0, 1.75, 3.0])
+    assert second["dist"] == pytest.approx([0.125, 0.5, 0.375])
+    assert second["sub"]["x"] == pytest.approx([0.0, 1.75, 3.0])
+    assert first["dist"] == pytest.approx(second["dist"])
+    assert first["sub"]["x"] == pytest.approx(second["sub"]["x"])
+
+
+def test_does_not_mutate_input_list_or_scored_items():
+    items = _query_ab_items()
+    original_list_ids = [id(item) for item in items]
+    original_snapshot = _snapshot_items(items)
+
+    actual = select_best_combination(items, 1)
+
+    _assert_scored_item(actual, [0.1, 0.9], {"atk": [0.0, 11.11111111111111]})
+    assert [id(item) for item in items] == original_list_ids
+    assert _snapshot_items(items) == original_snapshot
+
+
+def test_fresh_process_result_matches_in_process_result():
+    items = _query_ab_items()
+    in_process = _pack(select_best_combination(items, 2))
+    script = """
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+from GGanalysis.ScoredItem import ScoredItem, select_best_combination
+a = ScoredItem([0.2, 0.8], {"atk": [0, 10]}, stats_score={"atk": 1})
+b = ScoredItem([0.5, 0.5], {"atk": [0, 20]}, stats_score={"atk": 1})
+out = select_best_combination([a, b], 2)
+sys.stdout.write(json.dumps({
+    "dist": out.score_dist.dist.tolist(),
+    "sub": {key: value.tolist() for key, value in out.sub_stats_exp.items()},
+}, sort_keys=True))
+"""
+
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    fresh_process = json.loads(completed.stdout)
+
+    assert in_process["dist"] == pytest.approx([0.1, 0.5, 0.4])
+    assert in_process["sub"]["atk"] == pytest.approx([0.0, 12.0, 30.0])
+    assert fresh_process["dist"] == pytest.approx([0.1, 0.5, 0.4])
+    assert fresh_process["sub"]["atk"] == pytest.approx([0.0, 12.0, 30.0])
+    assert fresh_process["dist"] == pytest.approx(in_process["dist"])
+    assert fresh_process["sub"]["atk"] == pytest.approx(in_process["sub"]["atk"])
+
+
+def test_no_undeclared_relative_file_or_socket_side_effects(tmp_path, monkeypatch):
+    def blocked_socket(*args, **kwargs):
+        raise AssertionError("select_best_combination must not open network sockets")
+
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr(socket, "socket", blocked_socket)
+    before = sorted(os.listdir(tmp_path))
+
+    actual = select_best_combination(_query_ab_items(), 1)
+
+    _assert_scored_item(actual, [0.1, 0.9], {"atk": [0.0, 11.11111111111111]})
+    after = sorted(os.listdir(tmp_path))
+    assert after == before == []
