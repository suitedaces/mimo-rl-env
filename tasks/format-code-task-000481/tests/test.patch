--- /dev/null
+++ b/usercase-test-coderl/authentication-configuration.test.js
@@ -0,0 +1,328 @@
+import test from 'ava';
+import { expect } from 'chai';
+import base64url from 'base64url';
+
+
+
+
+const SPEC = {
+  openapi: '3.0.3',
+  info: { title: 'Authentication Configuration Acceptance', version: '1.0.0' },
+  servers: [{ url: 'https://api.example.test' }],
+  paths: {
+    '/pets': {
+      get: {
+        tags: ['Pets'],
+        summary: 'List pets',
+        security: [{ bearerAuth: [] }],
+        responses: { 200: { description: 'OK' } }
+      }
+    },
+    '/reports': {
+      get: {
+        tags: ['Reports'],
+        summary: 'List reports',
+        security: [{ basicAuth: [] }],
+        responses: { 200: { description: 'OK' } }
+      }
+    },
+    '/oauth': {
+      get: {
+        tags: ['OAuth'],
+        summary: 'OAuth data',
+        security: [{ oauthAuth: [] }],
+        responses: { 200: { description: 'OK' } }
+      }
+    }
+  },
+  components: {
+    securitySchemes: {
+      bearerAuth: { type: 'http', scheme: 'bearer' },
+      basicAuth: { type: 'http', scheme: 'basic' },
+      oauthAuth: {
+        type: 'oauth2',
+        flows: {
+          implicit: {
+            authorizationUrl: '/oauth/authorize',
+            scopes: { read: 'Read data' }
+          }
+        }
+      }
+    }
+  }
+};
+
+let OpenApiExplorer;
+let JSDOM;
+
+function installDom(url = 'https://docs.example.test/root/page.html') {
+  const dom = new JSDOM('<!doctype html><html><body></body></html>', {
+    url,
+    pretendToBeVisual: true
+  });
+  const btoaPolyfill = value => Buffer.from(String(value), 'binary').toString('base64');
+  const atobPolyfill = value => Buffer.from(String(value), 'base64').toString('binary');
+
+  Object.assign(globalThis, {
+    window: dom.window,
+    document: dom.window.document,
+    customElements: dom.window.customElements,
+    HTMLElement: dom.window.HTMLElement,
+    Element: dom.window.Element,
+    Node: dom.window.Node,
+    Document: dom.window.Document,
+    ShadowRoot: dom.window.ShadowRoot,
+    CSSStyleSheet: dom.window.CSSStyleSheet,
+    Event: dom.window.Event,
+    CustomEvent: dom.window.CustomEvent,
+    EventTarget: dom.window.EventTarget,
+    URL: dom.window.URL,
+    URLSearchParams: dom.window.URLSearchParams,
+    Headers: dom.window.Headers,
+    localStorage: dom.window.localStorage,
+    history: dom.window.history,
+    location: dom.window.location,
+    navigator: dom.window.navigator,
+    btoa: btoaPolyfill,
+    atob: atobPolyfill,
+    getComputedStyle: dom.window.getComputedStyle.bind(dom.window),
+    IntersectionObserver: class {
+      observe() {}
+      disconnect() {}
+    },
+    matchMedia: () => ({
+      matches: false,
+      addListener() {},
+      removeListener() {},
+      addEventListener() {},
+      removeEventListener() {},
+      dispatchEvent() { return false; }
+    }),
+    fetch: async () => {
+      throw new Error('Unexpected network request from authentication configuration test');
+    }
+  });
+  window.btoa = btoaPolyfill;
+  window.atob = atobPolyfill;
+  window.matchMedia = globalThis.matchMedia;
+  window.scrollTo = () => {};
+  Element.prototype.scrollIntoView = function scrollIntoView() {};
+  return dom;
+}
+
+test.before(async () => {
+
+  ({ JSDOM } = await import('/opt/stage4-jsdom/node_modules/jsdom/lib/api.js'));
+  installDom();
+  OpenApiExplorer = (await import('../src/openapi-explorer.js')).default;
+});
+
+test.beforeEach(() => {
+  installDom();
+});
+
+function createExplorer() {
+  const explorer = new OpenApiExplorer();
+  document.body.appendChild(explorer);
+  explorer.renderStyle = 'view';
+  explorer.hideInfo = true;
+  explorer.hideServerSelection = true;
+  explorer.hideAuthentication = true;
+  return explorer;
+}
+
+async function loadedExplorer(spec = SPEC) {
+  const explorer = createExplorer();
+  await explorer.loadSpec(structuredClone(spec));
+  await explorer.updateComplete;
+  return explorer;
+}
+
+function scheme(explorer, securitySchemeId) {
+  const found = explorer.resolvedSpec.securitySchemes.find(s => s.apiKeyId === securitySchemeId);
+  expect(found, `expected loaded security scheme ${securitySchemeId}`).to.exist;
+  return found;
+}
+
+function operation(explorer, path) {
+  return explorer.resolvedSpec.tags.flatMap(tag => tag.paths).find(p => p.path === path);
+}
+
+test.serial('applies bearer credentials and does not duplicate an existing bearer prefix', async t => {
+
+
+
+
+  const explorer = await loadedExplorer();
+
+
+  expect(scheme(explorer, 'bearerAuth').finalKeyValue).to.not.equal('Bearer abc123');
+  expect(operation(explorer, '/pets').security).to.eql([{ bearerAuth: [] }]);
+
+  await explorer.setAuthenticationConfiguration('bearerAuth', { token: 'abc123' });
+  await explorer.updateComplete;
+
+
+  expect(scheme(explorer, 'bearerAuth').finalKeyValue).to.equal('Bearer abc123');
+
+  const petOperation = operation(explorer, '/pets');
+  const bearerKeysForRequest = explorer.resolvedSpec.securitySchemes
+    .filter(v => v.finalKeyValue && petOperation.security?.some(ps => ps[v.apiKeyId]))
+    .map(v => ({ apiKeyId: v.apiKeyId, name: v.name, finalKeyValue: v.finalKeyValue }));
+  expect(bearerKeysForRequest).to.eql([
+    { apiKeyId: 'bearerAuth', name: 'Authorization', finalKeyValue: 'Bearer abc123' }
+  ]);
+
+  await explorer.setAuthenticationConfiguration('bearerAuth', { token: 'Bearer xyz789' });
+  await explorer.updateComplete;
+
+
+  expect(scheme(explorer, 'bearerAuth').finalKeyValue).to.equal('Bearer xyz789');
+  t.pass();
+});
+
+test.serial('applies basic credentials as a Basic Authorization value', async t => {
+
+
+
+
+  const explorer = await loadedExplorer();
+
+  await explorer.setAuthenticationConfiguration('basicAuth', { token: 'user:password' });
+  await explorer.updateComplete;
+
+
+  expect(scheme(explorer, 'basicAuth').finalKeyValue).to.equal('Basic dXNlcjpwYXNzd29yZA==');
+
+  const reportsOperation = operation(explorer, '/reports');
+  const basicKeysForRequest = explorer.resolvedSpec.securitySchemes
+    .filter(v => v.finalKeyValue && reportsOperation.security?.some(ps => ps[v.apiKeyId]))
+    .map(v => ({ apiKeyId: v.apiKeyId, name: v.name, finalKeyValue: v.finalKeyValue }));
+  expect(basicKeysForRequest).to.eql([
+    { apiKeyId: 'basicAuth', name: 'Authorization', finalKeyValue: 'Basic dXNlcjpwYXNzd29yZA==' }
+  ]);
+  t.pass();
+});
+
+test.serial('trims OAuth client configuration, resolves redirect URI, checks URL response, and requests render update', async t => {
+
+
+
+
+  const state = base64url.encode(JSON.stringify({
+    apiKeyId: 'oauthAuth',
+    flowId: 'implicit',
+    url: 'https://docs.example.test/root/page.html'
+  }));
+  installDom(`https://docs.example.test/root/page.html?state=${state}&access_token=urlToken&token_type=Bearer&expires_in=3600`);
+  const explorer = createExplorer();
+  let updateCount = 0;
+  const originalRequestUpdate = explorer.requestUpdate.bind(explorer);
+  explorer.requestUpdate = (...args) => {
+    updateCount += 1;
+    return originalRequestUpdate(...args);
+  };
+
+  await explorer.loadSpec(structuredClone(SPEC));
+  await explorer.updateComplete;
+
+
+  expect(scheme(explorer, 'oauthAuth').finalKeyValue).to.equal('Bearer urlToken');
+  expect(window.location.href).to.equal('https://docs.example.test/root/page.html');
+  updateCount = 0;
+
+  await explorer.setAuthenticationConfiguration('oauthAuth', {
+    token: 'oauth-token',
+    clientId: '  client-one  ',
+    clientSecret: ' secret-one ',
+    redirectUri: ' callbacks/oauth '
+  });
+  await explorer.updateComplete;
+
+
+  expect(scheme(explorer, 'oauthAuth')).to.include({
+    finalKeyValue: 'oauth-token',
+    clientId: 'client-one',
+    clientSecret: 'secret-one',
+    redirectUri: 'https://docs.example.test/root/callbacks/oauth'
+  });
+  expect(updateCount).to.equal(1);
+  t.pass();
+});
+
+test.serial('rejects unknown security scheme ids with the exact Error message', async t => {
+
+
+
+
+  const explorer = await loadedExplorer();
+
+  const err = await t.throwsAsync(
+    () => explorer.setAuthenticationConfiguration('missingAuth', { token: 'nope' }),
+    { instanceOf: Error }
+  );
+  expect(err.message).to.equal('SecuritySchemeNotFound');
+});
+
+test.serial('calling authentication configuration before a spec is loaded rejects like a missing scheme', async t => {
+
+
+
+
+  const explorer = createExplorer();
+
+  const err = await t.throwsAsync(
+    () => explorer.setAuthenticationConfiguration('bearerAuth', { token: 'abc123' }),
+    { instanceOf: Error }
+  );
+  expect(err.message).to.equal('SecuritySchemeNotFound');
+});
+
+test.serial('repeated configuration calls are idempotent for the same token value', async t => {
+
+
+
+
+  const explorer = await loadedExplorer();
+
+  await explorer.setAuthenticationConfiguration('basicAuth', { token: 'new:secret' });
+  await explorer.setAuthenticationConfiguration('basicAuth', { token: 'new:secret' });
+  await explorer.updateComplete;
+
+
+  expect(scheme(explorer, 'basicAuth').finalKeyValue).to.equal('Basic bmV3OnNlY3JldA==');
+  t.pass();
+});
+
+test.serial('two explorer instances keep independent applied credentials', async t => {
+
+
+
+
+  const a = await loadedExplorer();
+  const b = await loadedExplorer();
+
+  await a.setAuthenticationConfiguration('bearerAuth', { token: 'aaa' });
+  await a.updateComplete;
+  await b.updateComplete;
+
+
+  expect(scheme(a, 'bearerAuth').finalKeyValue).to.equal('Bearer aaa');
+  expect(scheme(b, 'bearerAuth').finalKeyValue).to.not.equal('Bearer aaa');
+  t.pass();
+});
+
+test.serial('attach configure detach cycles keep authentication configuration usable', async t => {
+
+
+
+
+
+  for (let i = 0; i < 25; i += 1) {
+    const explorer = await loadedExplorer();
+    await explorer.setAuthenticationConfiguration('bearerAuth', { token: 'abc123' });
+    expect(scheme(explorer, 'bearerAuth').finalKeyValue).to.equal('Bearer abc123');
+    explorer.remove();
+  }
+  t.pass();
+});
