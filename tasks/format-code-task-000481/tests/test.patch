+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+if [ ! -x ./node_modules/.bin/ava ]; then
+  echo "Missing local ava binary; dependencies must be preinstalled before offline test execution." >&2
+  exit 1
+fi
+
+if [ ! -f /opt/stage4-jsdom/node_modules/jsdom/lib/api.js ]; then
+  echo "Missing local jsdom package; dependencies must be preinstalled before offline test execution." >&2
+  exit 1
+fi
+
+exec ./node_modules/.bin/ava /workspace/repo/usercase-test-coderl/authentication-configuration.test.js --verbose
