+
+
+
+# pylint: disable=C0116
+from typing import TextIO
+
+from click.testing import CliRunner
+
+from tests.conftest import write_to_file
+from src.djlint import main as djlint
+
+
+def _reformat(tmp_file: TextIO, runner: CliRunner, content: bytes, extra_args=None):
+    write_to_file(tmp_file.name, content)
+    args = [tmp_file.name, "--reformat"]
+    if extra_args:
+        args.extend(extra_args)
+    result = runner.invoke(djlint, args)
+    text = open(tmp_file.name, encoding="utf8").read()
+    return result, text
+
+
+def test_issue_example_preserve_blank_lines(
+    runner: CliRunner, tmp_file: TextIO
+) -> None:
+
+    _, text = _reformat(
+        tmp_file,
+        runner,
+        b"{% block someblock %}{% endblock %}\n<br/> <br/>\n",
+        ["--preserve-blank-lines"],
+    )
+
+    assert not text.startswith("\n")
+
+    assert "<br/>\n<br/>\n" in text
+
+    assert text == "{% block someblock %}{% endblock %}\n<br/>\n<br/>\n"
+
+
+def test_template_block_tag_at_file_start_no_leading_blank(
+    runner: CliRunner, tmp_file: TextIO
+) -> None:
+    _, text = _reformat(
+        tmp_file,
+        runner,
+        b"{% block someblock %}{% endblock %}\n",
+        ["--preserve-blank-lines"],
+    )
+    assert not text.startswith("\n")
+    assert text == "{% block someblock %}{% endblock %}\n"
+
+
+def test_template_if_tag_at_file_start_no_leading_blank(
+    runner: CliRunner, tmp_file: TextIO
+) -> None:
+    _, text = _reformat(
+        tmp_file,
+        runner,
+        b"{% if x %}foo{% endif %}\n",
+        ["--preserve-blank-lines"],
+    )
+    assert not text.startswith("\n")
+    assert text == "{% if x %}foo{% endif %}\n"
+
+
+def test_html_tag_at_file_start_no_leading_blank(
+    runner: CliRunner, tmp_file: TextIO
+) -> None:
+    _, text = _reformat(
+        tmp_file,
+        runner,
+        b"<div>hello</div>\n",
+        ["--preserve-blank-lines"],
+    )
+    assert not text.startswith("\n")
+    assert text == "<div>hello</div>\n"
+
+
+def test_extends_tag_at_file_start_unchanged(
+    runner: CliRunner, tmp_file: TextIO
+) -> None:
+
+    _, text = _reformat(
+        tmp_file,
+        runner,
+        b'{% extends "a.html" %}\n',
+        ["--preserve-blank-lines"],
+    )
+    assert not text.startswith("\n")
+    assert text == '{% extends "a.html" %}\n'
+
+
+def test_template_tag_not_at_start_still_breaks(
+    runner: CliRunner, tmp_file: TextIO
+) -> None:
+
+
+    _, text = _reformat(
+        tmp_file,
+        runner,
+        b"text\n{% block x %}foo{% endblock %}\n",
+        ["--preserve-blank-lines"],
+    )
+
+    assert not text.startswith("\n")
+    assert text == "text\n{% block x %}foo{% endblock %}\n"
+
+
+def test_multiple_br_with_spaces_no_stray_blank_with_preserve(
+    runner: CliRunner, tmp_file: TextIO
+) -> None:
+
+
+
+
+    _, text = _reformat(
+        tmp_file,
+        runner,
+        b"<p>x</p>\n<br/> <br/>\n",
+        ["--preserve-blank-lines"],
+    )
+
+    assert "<br/>\n\n<br/>" not in text
+
+    assert "<br/>\n \n<br/>" not in text
+    assert text == "<p>x</p>\n<br/>\n<br/>\n"
+
+
+def test_multiple_br_with_spaces_no_preserve(
+    runner: CliRunner, tmp_file: TextIO
+) -> None:
+
+
+    _, text = _reformat(
+        tmp_file,
+        runner,
+        b"<br/> <br/> <br/>\n",
+    )
+    assert text == "<br/>\n<br/>\n<br/>\n"
+
+
+def test_existing_preserve_blank_lines_html_unchanged(
+    runner: CliRunner,
+) -> None:
+
+
+
+    result = runner.invoke(
+        djlint,
+        [
+            "tests/test_config/test_preserve_blank_lines/html.html",
+            "--check",
+            "--preserve-leading-space",
+            "--preserve-blank-lines",
+        ],
+    )
+    assert result.exit_code == 0
