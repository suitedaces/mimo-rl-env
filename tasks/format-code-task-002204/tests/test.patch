@@ -2586,6 +2586,54 @@ class TestStringMethods(object):
         assert res.nlevels == 1
         tm.assert_index_equal(res, exp)
 
+    def test_partition_sep_kwarg(self):
+
+        values = Series(['a_b_c', 'c_d_e', NA, 'f_g_h'])
+
+        with tm.assert_produces_warning(None):
+            result = values.str.partition(sep='_', expand=False)
+        exp = Series([('a', '_', 'b_c'), ('c', '_', 'd_e'), NA,
+                      ('f', '_', 'g_h')])
+        tm.assert_series_equal(result, exp)
+
+        with tm.assert_produces_warning(None):
+            result = values.str.rpartition(sep='_', expand=False)
+        exp = Series([('a_b', '_', 'c'), ('c_d', '_', 'e'), NA,
+                      ('f_g', '_', 'h')])
+        tm.assert_series_equal(result, exp)
+
+    def test_partition_pat_deprecation(self):
+
+        values = Series(['a_b_c', 'c_d_e', NA, 'f_g_h'])
+
+        with tm.assert_produces_warning(FutureWarning):
+            result = values.str.partition(pat='_', expand=False)
+        exp = Series([('a', '_', 'b_c'), ('c', '_', 'd_e'), NA,
+                      ('f', '_', 'g_h')])
+        tm.assert_series_equal(result, exp)
+
+        with tm.assert_produces_warning(FutureWarning):
+            result = values.str.rpartition(pat='_', expand=False)
+        exp = Series([('a_b', '_', 'c'), ('c_d', '_', 'e'), NA,
+                      ('f_g', '_', 'h')])
+        tm.assert_series_equal(result, exp)
+
+    def test_partition_positional_still_works(self):
+
+        values = Series(['a_b_c', 'c_d_e', NA, 'f_g_h'])
+
+        with tm.assert_produces_warning(None):
+            result = values.str.partition('_', expand=False)
+        exp = Series([('a', '_', 'b_c'), ('c', '_', 'd_e'), NA,
+                      ('f', '_', 'g_h')])
+        tm.assert_series_equal(result, exp)
+
+        with tm.assert_produces_warning(None):
+            result = values.str.rpartition('_', expand=False)
+        exp = Series([('a_b', '_', 'c'), ('c_d', '_', 'e'), NA,
+                      ('f_g', '_', 'h')])
+        tm.assert_series_equal(result, exp)
+
