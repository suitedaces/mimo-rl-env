diff --git a/tests/viewsets/test_model_attribute_contract.py b/tests/viewsets/test_model_attribute_contract.py
new file mode 100644
index 0000000..36cea98
--- /dev/null
+++ b/tests/viewsets/test_model_attribute_contract.py
@@ -0,0 +1,90 @@
+import re
+from pathlib import Path
+
+from django.test import TestCase
+from ninja import Router
+
+from examples.models import Department
+from examples.schemas import DepartmentIn, DepartmentOut
+from ninja_crud import views, viewsets
+
+
+class ModelAttributeContractTest(TestCase):
+    def test_model_viewset_accepts_model_attribute_when_registering_routes(self):
+        class DepartmentViewSet(viewsets.ModelViewSet):
+            model = Department
+            default_input_schema = DepartmentIn
+            default_output_schema = DepartmentOut
+
+            list_view = views.ListModelView()
+            create_view = views.CreateModelView()
+            retrieve_view = views.RetrieveModelView()
+            update_view = views.UpdateModelView()
+            delete_view = views.DeleteModelView()
+
+        router = Router()
+
+        try:
+            DepartmentViewSet.register_routes(router)
+        except Exception as exc:
+            self.fail(
+                "ModelViewSet subclasses that declare a Django model with "
+                f"`model` should register CRUD routes successfully: {exc!r}"
+            )
+
+    def test_base_model_viewset_accepts_model_attribute_when_registering_routes(self):
+        class DepartmentBaseViewSet(viewsets.BaseModelViewSet):
+            model = Department
+            default_input_schema = DepartmentIn
+            default_output_schema = DepartmentOut
+
+        router = Router()
+
+        try:
+            DepartmentBaseViewSet.register_routes(router)
+        except Exception as exc:
+            self.fail(
+                "BaseModelViewSet subclasses should use the public `model` "
+                f"configuration when registering CRUD routes: {exc!r}"
+            )
+
+    def test_invalid_model_attribute_is_rejected(self):
+        with self.assertRaises(Exception):
+
+            class InvalidModelViewSet(viewsets.ModelViewSet):
+                model = object
+
+                list_view = views.ListModelView(output_schema=DepartmentOut)
+
+    def test_public_documentation_and_examples_use_model_spelling(self):
+        repo_root = Path(__file__).resolve().parents[2]
+        public_files = [
+            repo_root / "README.md",
+            repo_root / "docs" / "guides" / "04-Examples.md",
+            repo_root / "examples" / "views" / "department_views.py",
+            repo_root / "examples" / "views" / "employee_views.py",
+            repo_root / "ninja_crud" / "viewsets" / "model_viewset.py",
+            repo_root / "ninja_crud" / "viewsets" / "base_model_viewset.py",
+            repo_root / "ninja_crud" / "views" / "create_model_view.py",
+            repo_root / "ninja_crud" / "views" / "list_model_view.py",
+            repo_root / "ninja_crud" / "views" / "retrieve_model_view.py",
+            repo_root / "ninja_crud" / "views" / "update_model_view.py",
+            repo_root / "ninja_crud" / "views" / "delete_model_view.py",
+        ]
+
+        combined_text = "\n".join(path.read_text() for path in public_files)
+
+        self.assertRegex(
+            combined_text,
+            re.compile(r"^\s*model\s*=\s*Department\b", re.MULTILINE),
+            "Public Department viewset examples should demonstrate `model = ...`.",
+        )
+
+        for path in public_files:
+            text = path.read_text()
+            self.assertNotRegex(
+                text,
+                re.compile(r"^\s*model_class\s*=", re.MULTILINE),
+                f"{path.relative_to(repo_root)} should not teach the old "
+                "`model_class = ...` spelling in public viewset examples.",
+            )
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,35 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+pip install --break-system-packages --no-input "Django>=4.2,<5.0" "django-ninja>=0.21" 2>/dev/null
+pip install --break-system-packages --no-input -e . 2>/dev/null
+
+
+case "${1:-}" in
+  base)
+    DJANGO_SETTINGS_MODULE=tests.test_settings python3 -m django test \
+      tests.views.test_create_model_view \
+      tests.views.test_delete_model_view \
+      tests.views.test_list_model_view \
+      tests.views.test_update_model_view \
+      tests.viewsets.test_model_viewset \
+      --verbosity=2
+    ;;
+  new)
+    DJANGO_SETTINGS_MODULE=tests.test_settings python3 -m django test \
+      tests.testing.viewsets.test_model_viewset_test_case \
+      tests.views.test_retrieve_model_view \
+      tests.test_app.tests.test_collection_views \
+      tests.test_app.tests.test_item_views \
+      tests.test_app.tests.test_user_views \
+      tests.viewsets.test_model_attribute_contract \
+      --verbosity=2
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
