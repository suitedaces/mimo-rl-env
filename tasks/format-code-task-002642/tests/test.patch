+package usercase_test_coderl
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/shaj13/libcache"
+	"github.com/shaj13/libcache/lfu"
+)
+
+func requireLoad(t *testing.T, c libcache.Cache, key interface{}, wantValue interface{}, wantOK bool) {
+	t.Helper()
+
+	gotValue, gotOK := c.Load(key)
+	if !reflect.DeepEqual(gotValue, wantValue) || gotOK != wantOK {
+		t.Fatalf("Load(%#v) = (%#v, %v), want (%#v, %v)", key, gotValue, gotOK, wantValue, wantOK)
+	}
+}
+
+func requirePeek(t *testing.T, c libcache.Cache, key interface{}, wantValue interface{}, wantOK bool) {
+	t.Helper()
+
+	gotValue, gotOK := c.Peek(key)
+	if !reflect.DeepEqual(gotValue, wantValue) || gotOK != wantOK {
+		t.Fatalf("Peek(%#v) = (%#v, %v), want (%#v, %v)", key, gotValue, gotOK, wantValue, wantOK)
+	}
+}
+
+func requireRemoveEvent(t *testing.T, ch <-chan libcache.Event, wantKey interface{}, wantValue interface{}) {
+	t.Helper()
+
+	select {
+	case got := <-ch:
+		if got.Op != libcache.Remove {
+			t.Fatalf("event Op = %s, want REMOVE", got.Op.String())
+		}
+		if !reflect.DeepEqual(got.Key, wantKey) {
+			t.Fatalf("event Key = %#v, want %#v", got.Key, wantKey)
+		}
+		if !reflect.DeepEqual(got.Value, wantValue) {
+			t.Fatalf("event Value = %#v, want %#v", got.Value, wantValue)
+		}
+
+
+	case <-time.After(time.Second):
+		t.Fatalf("timed out waiting for remove event %#v:%#v", wantKey, wantValue)
+	}
+}
+
+
+
+func TestLFUPublicConstructorsAndRegisteredPolicy(t *testing.T) {
+	if libcache.LFU.Available() != true {
+		t.Fatalf("libcache.LFU.Available() = false, want true")
+	}
+
+	direct := lfu.New(1)
+	if direct.Cap() != 1 {
+		t.Fatalf("direct Cap() = %d, want 1", direct.Cap())
+	}
+	if direct.Len() != 0 {
+		t.Fatalf("direct Len() = %d, want 0", direct.Len())
+	}
+
+	safe := libcache.LFU.New(2)
+	if safe.Cap() != 2 {
+		t.Fatalf("safe Cap() = %d, want 2", safe.Cap())
+	}
+	if safe.Len() != 0 {
+		t.Fatalf("safe Len() = %d, want 0", safe.Len())
+	}
+	safe.Store("x", 1)
+	safe.Store("y", 2)
+	requireLoad(t, safe, "x", 1, true)
+	safe.Store("z", 3)
+	requireLoad(t, safe, "x", 1, true)
+	requireLoad(t, safe, "y", nil, false)
+	requireLoad(t, safe, "z", 3, true)
+
+	unsafe := libcache.LFU.NewUnsafe(2)
+	if unsafe.Cap() != 2 {
+		t.Fatalf("unsafe Cap() = %d, want 2", unsafe.Cap())
+	}
+	if unsafe.Len() != 0 {
+		t.Fatalf("unsafe Len() = %d, want 0", unsafe.Len())
+	}
+	unsafe.Store("m", 10)
+	unsafe.Store("n", 20)
+	requireLoad(t, unsafe, "m", 10, true)
+	unsafe.Store("o", 30)
+	requireLoad(t, unsafe, "m", 10, true)
+	requireLoad(t, unsafe, "n", nil, false)
+	requireLoad(t, unsafe, "o", 30, true)
+}
+
+
+
+func TestLFUOverflowEvictsLowestSuccessfulLoadCount(t *testing.T) {
+	c := lfu.New(3)
+	if c.Cap() != 3 {
+		t.Fatalf("Cap() = %d, want 3", c.Cap())
+	}
+	if c.Len() != 0 {
+		t.Fatalf("fresh Len() = %d, want 0", c.Len())
+	}
+
+	c.Store("a", 1)
+	if c.Len() != 1 {
+		t.Fatalf("Len() after Store(a) = %d, want 1", c.Len())
+	}
+	c.Store("b", 2)
+	if c.Len() != 2 {
+		t.Fatalf("Len() after Store(b) = %d, want 2", c.Len())
+	}
+	c.Store("c", 3)
+	if c.Len() != 3 {
+		t.Fatalf("Len() after Store(c) = %d, want 3", c.Len())
+	}
+
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "b", 2, true)
+	c.Store("d", 4)
+	if c.Len() != 3 {
+		t.Fatalf("Len() after Store(d) = %d, want 3", c.Len())
+	}
+
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "b", 2, true)
+	requireLoad(t, c, "c", nil, false)
+	requireLoad(t, c, "d", 4, true)
+}
+
+
+
+func TestLFUPeekContainsAndUpdateDoNotIncreaseFrequency(t *testing.T) {
+	c := lfu.New(3)
+	c.Store("hot", 10)
+	c.Store("warm", 20)
+	c.Store("cold", 30)
+
+	requireLoad(t, c, "hot", 10, true)
+	requireLoad(t, c, "hot", 10, true)
+	requireLoad(t, c, "warm", 20, true)
+	requirePeek(t, c, "cold", 30, true)
+	if c.Contains("cold") != true {
+		t.Fatalf("Contains(cold) = false, want true")
+	}
+	c.Update("cold", 300)
+	requirePeek(t, c, "cold", 300, true)
+
+	c.Store("new", 40)
+	if c.Len() != 3 {
+		t.Fatalf("Len() after Store(new) = %d, want 3", c.Len())
+	}
+	requireLoad(t, c, "hot", 10, true)
+	requireLoad(t, c, "warm", 20, true)
+	requireLoad(t, c, "cold", nil, false)
+	requireLoad(t, c, "new", 40, true)
+}
+
+
+
+func TestLFUResizeDiscardsLeastLoadedEntriesFirst(t *testing.T) {
+
+
+	c := lfu.New(4)
+	c.Store("a", 1)
+	c.Store("b", 2)
+	c.Store("c", 3)
+	c.Store("d", 4)
+	if c.Cap() != 4 {
+		t.Fatalf("initial Cap() = %d, want 4", c.Cap())
+	}
+	if c.Len() != 4 {
+		t.Fatalf("initial Len() = %d, want 4", c.Len())
+	}
+
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "b", 2, true)
+	requireLoad(t, c, "b", 2, true)
+	requireLoad(t, c, "c", 3, true)
+
+	evicted := c.Resize(2)
+	if evicted != 2 {
+		t.Fatalf("Resize(2) = %d, want 2", evicted)
+	}
+	if c.Cap() != 2 {
+		t.Fatalf("Cap() after Resize(2) = %d, want 2", c.Cap())
+	}
+	if c.Len() != 2 {
+		t.Fatalf("Len() after Resize(2) = %d, want 2", c.Len())
+	}
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "b", 2, true)
+	requireLoad(t, c, "c", nil, false)
+	requireLoad(t, c, "d", nil, false)
+}
+
+
+
+func TestLFUOverflowNotificationReportsVictimKeyAndValue(t *testing.T) {
+	c := lfu.New(3)
+	c.Store("a", 1)
+	c.Store("b", 2)
+	c.Store("c", 3)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "b", 2, true)
+
+	events := make(chan libcache.Event, 2)
+	c.Notify(events, libcache.Remove)
+	c.Store("d", 4)
+
+	requireRemoveEvent(t, events, "c", 3)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "b", 2, true)
+	requireLoad(t, c, "c", nil, false)
+	requireLoad(t, c, "d", 4, true)
+}
+
+
+
+func TestLFUResizeNotificationReportsVictimsInLFUOrder(t *testing.T) {
+
+
+	c := lfu.New(4)
+	c.Store("a", 1)
+	c.Store("b", 2)
+	c.Store("c", 3)
+	c.Store("d", 4)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "b", 2, true)
+	requireLoad(t, c, "b", 2, true)
+	requireLoad(t, c, "c", 3, true)
+
+	events := make(chan libcache.Event, 4)
+	c.Notify(events, libcache.Remove)
+	evicted := c.Resize(2)
+	if evicted != 2 {
+		t.Fatalf("Resize(2) = %d, want 2", evicted)
+	}
+
+	requireRemoveEvent(t, events, "d", 4)
+	requireRemoveEvent(t, events, "c", 3)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "b", 2, true)
+	requireLoad(t, c, "c", nil, false)
+	requireLoad(t, c, "d", nil, false)
+}
+
+
+
+func TestLFUSeparateInstancesMaintainIndependentState(t *testing.T) {
+	a := lfu.New(2)
+	b := lfu.New(2)
+
+	a.Store("hot", "a-hot")
+	a.Store("cold", "a-cold")
+	b.Store("hot", "b-hot")
+	b.Store("cold", "b-cold")
+
+	requireLoad(t, a, "hot", "a-hot", true)
+	a.Store("new", "a-new")
+
+	if a.Len() != 2 {
+		t.Fatalf("a.Len() = %d, want 2", a.Len())
+	}
+	requireLoad(t, a, "hot", "a-hot", true)
+	requireLoad(t, a, "cold", nil, false)
+	requireLoad(t, a, "new", "a-new", true)
+
+	if b.Len() != 2 {
+		t.Fatalf("b.Len() = %d, want 2", b.Len())
+	}
+	requireLoad(t, b, "hot", "b-hot", true)
+	requireLoad(t, b, "cold", "b-cold", true)
+	requireLoad(t, b, "new", nil, false)
+
+	requireLoad(t, b, "cold", "b-cold", true)
+	b.Store("new", "b-new")
+	if b.Len() != 2 {
+		t.Fatalf("b.Len() after Store(new) = %d, want 2", b.Len())
+	}
+	requireLoad(t, b, "hot", nil, false)
+	requireLoad(t, b, "cold", "b-cold", true)
+	requireLoad(t, b, "new", "b-new", true)
+}
+
+
+
+func TestLFUResizeIsIdempotentAtCurrentCapacity(t *testing.T) {
+	c := lfu.New(3)
+	c.Store("a", 1)
+	c.Store("b", 2)
+	c.Store("c", 3)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "b", 2, true)
+
+
+
+	first := c.Resize(1)
+	if first != 2 {
+		t.Fatalf("first Resize(1) = %d, want 2", first)
+	}
+	if c.Cap() != 1 {
+		t.Fatalf("Cap() after first Resize(1) = %d, want 1", c.Cap())
+	}
+	if c.Len() != 1 {
+		t.Fatalf("Len() after first Resize(1) = %d, want 1", c.Len())
+	}
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "b", nil, false)
+	requireLoad(t, c, "c", nil, false)
+
+	second := c.Resize(1)
+	if second != 0 {
+		t.Fatalf("second Resize(1) = %d, want 0", second)
+	}
+	if c.Cap() != 1 {
+		t.Fatalf("Cap() after second Resize(1) = %d, want 1", c.Cap())
+	}
+	if c.Len() != 1 {
+		t.Fatalf("Len() after second Resize(1) = %d, want 1", c.Len())
+	}
+}
+
+
+
+func TestLFUNotifyReportsRemoveVictim(t *testing.T) {
+	c := lfu.New(1)
+	events := make(chan libcache.Event, 1)
+
+
+	c.Notify(events, libcache.Remove)
+	c.Store("first", 1)
+	c.Store("second", 2)
+	requireRemoveEvent(t, events, "first", 1)
+}
+
+
+
+func TestLFURepeatedResizeKeepsLFUOrder(t *testing.T) {
+	c := lfu.New(4)
+	c.Store("a", 1)
+	c.Store("b", 2)
+	c.Store("c", 3)
+	c.Store("d", 4)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "b", 2, true)
+	requireLoad(t, c, "b", 2, true)
+	requireLoad(t, c, "c", 3, true)
+
+
+
+	if evicted := c.Resize(3); evicted != 1 {
+		t.Fatalf("Resize(3) = %d, want 1", evicted)
+	}
+	requireLoad(t, c, "d", nil, false)
+	if evicted := c.Resize(2); evicted != 1 {
+		t.Fatalf("Resize(2) = %d, want 1", evicted)
+	}
+	requireLoad(t, c, "c", nil, false)
+	requireLoad(t, c, "a", 1, true)
+	requireLoad(t, c, "b", 2, true)
+	if evicted := c.Resize(2); evicted != 0 {
+		t.Fatalf("repeated Resize(2) = %d, want 0", evicted)
+	}
+}
