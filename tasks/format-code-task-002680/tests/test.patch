+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export PYTHONPATH="/workspace/repo${PYTHONPATH:+:$PYTHONPATH}"
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+
+exec /opt/coderl-venv/bin/python -m pytest /workspace/repo/usercase-test-coderl/test_ppar_event_stream.py -v
