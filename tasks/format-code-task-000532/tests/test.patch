@@ -0,0 +1,158 @@
+<?php
+
+namespace Bavix\Wallet\Test;
+
+use Bavix\Wallet\Models\Transaction;
+use Bavix\Wallet\Test\Models\User;
+
+class ConfirmTest extends TestCase
+{
+
+    /**
+     * Confirming a pending deposit applies it to the balance.
+     */
+    public function testConfirmDeposit(): void
+    {
+        /** @var User $user */
+        $user = factory(User::class)->create();
+        $this->assertEquals(0, $user->balance);
+
+        $transaction = $user->deposit(100, null, false);
+        $this->assertFalse($transaction->confirmed);
+        $this->assertEquals(0, $user->balance);
+
+        $wallet = $user->wallet;
+        $this->assertTrue($wallet->confirm($transaction));
+
+        $transaction->refresh();
+        $this->assertTrue($transaction->confirmed);
+        $this->assertEquals(100, $user->balance);
+        $this->assertEquals(100, $wallet->balance);
+    }
+
+    /**
+     * Confirming a pending withdrawal applies it to the balance.
+     */
+    public function testConfirmWithdraw(): void
+    {
+        /** @var User $user */
+        $user = factory(User::class)->create();
+        $user->deposit(100);
+        $this->assertEquals(100, $user->balance);
+
+        $transaction = $user->forceWithdraw(100, null, false);
+        $this->assertFalse($transaction->confirmed);
+        $this->assertEquals(100, $user->balance);
+
+        $this->assertTrue($user->wallet->confirm($transaction));
+
+        $transaction->refresh();
+        $this->assertTrue($transaction->confirmed);
+        $this->assertEquals(0, $user->balance);
+    }
+
+    /**
+     * An already-confirmed transaction cannot be confirmed again.
+     */
+    public function testConfirmAlreadyConfirmedIsRejected(): void
+    {
+        /** @var User $user */
+        $user = factory(User::class)->create();
+        $transaction = $user->deposit(100);
+        $this->assertTrue($transaction->confirmed);
+        $this->assertEquals(100, $user->balance);
+
+        $this->assertFalse($user->wallet->safeConfirm($transaction));
+
+        $transaction->refresh();
+        $this->assertTrue($transaction->confirmed);
+        $this->assertEquals(100, $user->balance);
+    }
+
+    /**
+     * @see testConfirmAlreadyConfirmedIsRejected
+     */
+    public function testConfirmAlreadyConfirmedThrows(): void
+    {
+        /** @var User $user */
+        $user = factory(User::class)->create();
+        $transaction = $user->deposit(100);
+
+        $this->expectException(\Exception::class);
+        $user->wallet->confirm($transaction);
+    }
+
+    /**
+     * A transaction can only be confirmed through its own wallet.
+     */
+    public function testConfirmWrongOwnerIsRejected(): void
+    {
+        /** @var User $first */
+        $first = factory(User::class)->create();
+        /** @var User $second */
+        $second = factory(User::class)->create();
+
+        $transaction = $first->deposit(100, null, false);
+        $this->assertEquals(0, $first->balance);
+        $this->assertEquals(0, $second->balance);
+
+        $this->assertFalse($second->wallet->safeConfirm($transaction));
+
+        $transaction->refresh();
+        $this->assertFalse($transaction->confirmed);
+        $this->assertEquals(0, $first->balance);
+        $this->assertEquals(0, $second->balance);
+    }
+
+    /**
+     * @see testConfirmWrongOwnerIsRejected
+     */
+    public function testConfirmWrongOwnerThrows(): void
+    {
+        /** @var User $first */
+        $first = factory(User::class)->create();
+        /** @var User $second */
+        $second = factory(User::class)->create();
+
+        $transaction = $first->deposit(100, null, false);
+
+        $this->expectException(\Exception::class);
+        $second->wallet->confirm($transaction);
+    }
+
+    /**
+     * Confirming a withdrawal must respect available funds.
+     */
+    public function testConfirmWithdrawInsufficientFundsIsRejected(): void
+    {
+        /** @var User $user */
+        $user = factory(User::class)->create();
+        $user->deposit(50);
+        $this->assertEquals(50, $user->balance);
+
+        $transaction = $user->forceWithdraw(100, null, false);
+        $this->assertFalse($transaction->confirmed);
+        $this->assertEquals(50, $user->balance);
+
+        $this->assertFalse($user->wallet->safeConfirm($transaction));
+
+        $transaction->refresh();
+        $this->assertFalse($transaction->confirmed);
+        $this->assertEquals(50, $user->balance);
+    }
+
+    /**
+     * The pending transaction itself does not change the balance until confirmed.
+     */
+    public function testPendingDoesNotAffectBalance(): void
+    {
+        /** @var User $user */
+        $user = factory(User::class)->create();
+
+        $deposit = $user->deposit(100, null, false);
+        $this->assertInstanceOf(Transaction::class, $deposit);
+        $this->assertFalse($deposit->confirmed);
+        $this->assertEquals(0, $user->balance);
+    }
+
+}
