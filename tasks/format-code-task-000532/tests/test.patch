+cd /testbed
+
+
+
+
+for t in \
+    tests/WalletTest.php \
+    tests/WalletFloatTest.php \
+    tests/MultiWalletTest.php \
+    tests/BalanceTest.php \
+    tests/TaxTest.php \
+    tests/GiftTest.php \
+    tests/CartTest.php; do
+    vendor/bin/phpunit "$t"
+done
+
+
+vendor/bin/phpunit tests/ConfirmTest.php
