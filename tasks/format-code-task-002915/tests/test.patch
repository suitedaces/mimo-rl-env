diff --git a/mitiq/tests/test_utils.py b/mitiq/tests/test_utils.py
index e3e600f8..114f82e6 100644
--- a/mitiq/tests/test_utils.py
+++ b/mitiq/tests/test_utils.py
@@ -87,3 +87,111 @@ def test_circuit_equality_gridqubit_namedqubit_unequal_indices():
     circB = cirq.Circuit(cirq.ops.H.on_each(*qregB))
     assert _equal(circA, circB, require_qubit_equality=False)
     assert not _equal(circA, circB, require_qubit_equality=True)
+
+
+def test_circuit_equality_default_ignores_measurement_keys_issue_repro():
+    """Default behavior (no require_measurement_equality kwarg) should
+    treat circuits with different measurement keys as equal.
+    This is the exact example from the issue.
+    """
+    qbit = cirq.LineQubit(0)
+    circA = cirq.Circuit(cirq.ops.measure(qbit, key="a"))
+    circB = cirq.Circuit(cirq.ops.measure(qbit, key="b"))
+    assert _equal(circA, circB)
+
+
+def test_circuit_equality_different_measurement_keys_explicit_false():
+    qbit = cirq.LineQubit(0)
+    circA = cirq.Circuit(cirq.ops.measure(qbit, key="a"))
+    circB = cirq.Circuit(cirq.ops.measure(qbit, key="b"))
+    assert _equal(circA, circB, require_measurement_equality=False)
+
+
+def test_circuit_equality_different_measurement_keys_required():
+    qbit = cirq.LineQubit(0)
+    circA = cirq.Circuit(cirq.ops.measure(qbit, key="a"))
+    circB = cirq.Circuit(cirq.ops.measure(qbit, key="b"))
+    assert not _equal(circA, circB, require_measurement_equality=True)
+
+
+def test_circuit_equality_same_measurement_keys_required_true():
+    qbit = cirq.LineQubit(0)
+    circA = cirq.Circuit(cirq.ops.measure(qbit, key="a"))
+    circB = cirq.Circuit(cirq.ops.measure(qbit, key="a"))
+    assert _equal(circA, circB, require_measurement_equality=True)
+
+
+def test_circuit_equality_same_measurement_keys_default():
+    qbit = cirq.LineQubit(0)
+    circA = cirq.Circuit(cirq.ops.measure(qbit, key="a"))
+    circB = cirq.Circuit(cirq.ops.measure(qbit, key="a"))
+    assert _equal(circA, circB)
+
+
+def test_circuit_equality_multi_qubit_measurement_different_keys_default():
+    q0, q1 = cirq.LineQubit.range(2)
+    circA = cirq.Circuit(cirq.ops.measure(q0, q1, key="a"))
+    circB = cirq.Circuit(cirq.ops.measure(q0, q1, key="b"))
+    assert _equal(circA, circB)
+
+
+def test_circuit_equality_multi_qubit_measurement_different_keys_required():
+    q0, q1 = cirq.LineQubit.range(2)
+    circA = cirq.Circuit(cirq.ops.measure(q0, q1, key="a"))
+    circB = cirq.Circuit(cirq.ops.measure(q0, q1, key="b"))
+    assert not _equal(circA, circB, require_measurement_equality=True)
+
+
+def test_circuit_equality_mixed_gates_different_measurement_keys_default():
+    qbit = cirq.LineQubit(0)
+    circA = cirq.Circuit([cirq.ops.H.on(qbit), cirq.ops.measure(qbit, key="a")])
+    circB = cirq.Circuit([cirq.ops.H.on(qbit), cirq.ops.measure(qbit, key="b")])
+    assert _equal(circA, circB)
+
+
+def test_circuit_equality_mixed_gates_different_measurement_keys_required():
+    qbit = cirq.LineQubit(0)
+    circA = cirq.Circuit([cirq.ops.H.on(qbit), cirq.ops.measure(qbit, key="a")])
+    circB = cirq.Circuit([cirq.ops.H.on(qbit), cirq.ops.measure(qbit, key="b")])
+    assert not _equal(circA, circB, require_measurement_equality=True)
+
+
+def test_circuit_equality_different_gates_same_keys_default():
+    """Preservation: circuits with different non-measurement gates should
+    NOT be equal, even with identical measurement keys and default flag.
+    """
+    qbit = cirq.LineQubit(0)
+    circA = cirq.Circuit([cirq.ops.H.on(qbit), cirq.ops.measure(qbit, key="a")])
+    circB = cirq.Circuit([cirq.ops.X.on(qbit), cirq.ops.measure(qbit, key="a")])
+    assert not _equal(circA, circB)
+
+
+def test_circuit_equality_no_measurements_default_preserved():
+    """Preservation: circuits with no measurements should still compare
+    equal when they have the same gates, with default flag.
+    """
+    qreg = cirq.LineQubit.range(3)
+    circA = cirq.Circuit(cirq.ops.H.on_each(*qreg))
+    circB = cirq.Circuit(cirq.ops.H.on_each(*qreg))
+    assert _equal(circA, circB)
+
+
+def test_circuit_equality_measurement_keys_with_require_qubit_equality():
+    """Interaction: different measurement keys with require_qubit_equality
+    should still be considered equal (since measurement keys are ignored).
+    """
+    qbit = cirq.LineQubit(0)
+    circA = cirq.Circuit(cirq.ops.measure(qbit, key="a"))
+    circB = cirq.Circuit(cirq.ops.measure(qbit, key="b"))
+    assert _equal(
+        circA,
+        circB,
+        require_qubit_equality=True,
+        require_measurement_equality=False,
+    )
+    assert not _equal(
+        circA,
+        circB,
+        require_qubit_equality=True,
+        require_measurement_equality=True,
+    )
