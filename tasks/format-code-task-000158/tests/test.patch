diff --git a/test_commands.json b/test_commands.json
new file mode 100644
index 0000000..48178e4
--- /dev/null
+++ b/test_commands.json
@@ -0,0 +1,3 @@
+{
+  "test_commands": ["python -m pytest tests/test_simplify.py -k sim117 -v"]
+}
diff --git a/tests/test_simplify.py b/tests/test_simplify.py
index 006c4b0..981016c 100644
--- a/tests/test_simplify.py
+++ b/tests/test_simplify.py
@@ -490,3 +490,87 @@ def test_sim300_int():
     assert ret == {
         "1:0 SIM300 Use 'age == 42' instead of '42 == age' (Yoda-conditions)"
     }
+
+
+def test_sim117_basic():
+    ret = _results(
+        """with A() as a:
+    with B() as b:
+        print('hello')"""
+    )
+    assert ret == {
+        "1:0 SIM117 Use 'with A() as a, B() as b:' "
+        "instead of multiple with statements"
+    }
+
+
+def test_sim117_not_triggered_single_with():
+    ret = _results(
+        """with A() as a:
+    print('hello')"""
+    )
+    assert ret == set()
+
+
+def test_sim117_not_triggered_extra_code_after():
+    ret = _results(
+        """with A() as a:
+    with B() as b:
+        print('hello')
+    print('after')"""
+    )
+    assert ret == set()
+
+
+def test_sim117_not_triggered_extra_code_before():
+    ret = _results(
+        """with A() as a:
+    print('first')
+    with B() as b:
+        print('hello')"""
+    )
+    assert ret == set()
+
+
+def test_sim117_triple_nesting():
+    ret = _results(
+        """with A() as a:
+    with B() as b:
+        with C() as c:
+            print('hi')"""
+    )
+    assert ret == {
+        (
+            "1:0 SIM117 Use 'with A() as a, B() as b:' "
+            "instead of multiple with statements"
+        ),
+        (
+            "2:4 SIM117 Use 'with B() as b, C() as c:' "
+            "instead of multiple with statements"
+        ),
+    }
+
+
+def test_sim117_multi_items_inner():
+    ret = _results(
+        """with A() as a:
+    with B() as b, C() as c:
+        print('hi')"""
+    )
+    assert ret == {
+        "1:0 SIM117 Use 'with A() as a, B() as b, C() as c:' "
+        "instead of multiple with statements"
+    }
+
+
+def test_sim117_long_line_still_reports():
+    ret = _results(
+        """with SomeVeryLongContextManagerName() as long_alias_name_one:
+    with AnotherLongContextManagerName() as long_alias_name_two:
+        print('hi')"""
+    )
+    assert ret == {
+        "1:0 SIM117 Use 'with SomeVeryLongContextManagerName() "
+        "as long_alias_name_one, AnotherLongContextManagerName() "
+        "as long_alias_name_two:' instead of multiple with statements"
+    }
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+python -m pytest -v -rA tests/test_simplify.py::test_sim117_basic tests/test_simplify.py::test_sim117_not_triggered_single_with tests/test_simplify.py::test_sim117_not_triggered_extra_code_after tests/test_simplify.py::test_sim117_not_triggered_extra_code_before tests/test_simplify.py::test_sim117_triple_nesting tests/test_simplify.py::test_sim117_multi_items_inner tests/test_simplify.py::test_sim117_long_line_still_reports
+rc=$(( rc | $? ))
+exit $rc
