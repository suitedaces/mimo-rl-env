+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export JAX_ENABLE_X64=True
+export NVIDIA_TF32_OVERRIDE=0
+export PYTHONPATH=/workspace/repo/src:${PYTHONPATH:-}
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+
+exec python -m pytest /workspace/repo/usercase-test-coderl/test_molecular_local_energy.py -v
