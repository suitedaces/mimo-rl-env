diff --git a/src/__tests__/ariaAttributes.js b/src/__tests__/ariaAttributes.js
index 2f0b76d..34c8aad 100644
--- a/src/__tests__/ariaAttributes.js
+++ b/src/__tests__/ariaAttributes.js
@@ -233,3 +233,90 @@ test('`expanded: true|false` matches `expanded` elements with proper role', () =
   expect(getByRole('button', {expanded: true})).toBeInTheDocument()
   expect(getByRole('button', {expanded: false})).toBeInTheDocument()
 })
+
+test('`current: true` matches `aria-current="true"`', () => {
+  const {getByRole, queryByRole} = renderIntoDocument(
+    `<div>
+      <button aria-current="true">current-true</button>
+      <button>no-current</button>
+      <button aria-current="false">current-false</button>
+    </div>`,
+  )
+  expect(getByRole('button', {current: true})).toHaveTextContent(
+    'current-true',
+  )
+
+
+  const matches = queryByRole('button', {current: true})
+  expect(matches).not.toBeNull()
+  expect(matches.textContent).toBe('current-true')
+})
+
+test('`current: false` matches elements without aria-current and aria-current="false"', () => {
+  const {getAllByRole} = renderIntoDocument(
+    `<div>
+      <a href="/a" id="no-current">no-current</a>
+      <a href="/b" aria-current="false" id="current-false">current-false</a>
+      <a href="/c" aria-current="page" id="current-page">current-page</a>
+      <a href="/d" aria-current="true" id="current-true">current-true</a>
+    </div>`,
+  )
+  const ids = getAllByRole('link', {current: false}).map(({id}) => id)
+  expect(ids).toEqual(expect.arrayContaining(['no-current', 'current-false']))
+  expect(ids).not.toEqual(expect.arrayContaining(['current-page']))
+  expect(ids).not.toEqual(expect.arrayContaining(['current-true']))
+  expect(ids).toHaveLength(2)
+})
+
+test('`current: "page"` matches `aria-current="page"` only', () => {
+  const {getAllByRole, queryByRole} = renderIntoDocument(
+    `<div>
+      <a href="/a" aria-current="page" id="current-page">page</a>
+      <a href="/b" aria-current="step" id="current-step">step</a>
+      <a href="/c" aria-current="true" id="current-true">true</a>
+      <a href="/d" id="no-current">none</a>
+    </div>`,
+  )
+  expect(getAllByRole('link', {current: 'page'}).map(({id}) => id)).toEqual([
+    'current-page',
+  ])
+  expect(queryByRole('link', {current: 'page', name: 'step'})).toBeNull()
+  expect(queryByRole('link', {current: 'page', name: 'true'})).toBeNull()
+  expect(queryByRole('link', {current: 'page', name: 'none'})).toBeNull()
+})
+
+test('`current: "step"` matches `aria-current="step"` only', () => {
+  const {getAllByRole} = renderIntoDocument(
+    `<div>
+      <a href="/a" aria-current="step" id="current-step">step</a>
+      <a href="/b" aria-current="page" id="current-page">page</a>
+      <a href="/c" aria-current="location" id="current-location">location</a>
+    </div>`,
+  )
+  expect(getAllByRole('link', {current: 'step'}).map(({id}) => id)).toEqual([
+    'current-step',
+  ])
+})
+
+test('`current: "location"` matches `aria-current="location"` only', () => {
+  const {getAllByRole} = renderIntoDocument(
+    `<div>
+      <a href="/a" aria-current="location" id="current-location">location</a>
+      <a href="/b" aria-current="page" id="current-page">page</a>
+    </div>`,
+  )
+  expect(getAllByRole('link', {current: 'location'}).map(({id}) => id)).toEqual(
+    ['current-location'],
+  )
+})
+
+test('`current: true|"page"` matches elements with proper role via role attribute', () => {
+  const {getByRole} = renderIntoDocument(
+    `<div>
+      <span role="button" aria-current="true">true-btn</span>
+      <span role="link" aria-current="page">page-link</span>
+    </div>`,
+  )
+  expect(getByRole('button', {current: true})).toHaveTextContent('true-btn')
+  expect(getByRole('link', {current: 'page'})).toHaveTextContent('page-link')
+})
