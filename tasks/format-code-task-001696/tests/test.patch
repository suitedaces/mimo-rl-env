diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,106 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+BUILD="$TMP/build"
+if ! cmake -S /workspace/repo -B "$BUILD" -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF >/dev/null; then
+  fail "build configure"
+fi
+if ! cmake --build "$BUILD" --target KWStyle -j "${KWSTYLE_TEST_JOBS:-2}" >/dev/null; then
+  fail "build"
+fi
+BIN="$BUILD/bin/KWStyle"
+[ -x "$BIN" ] || fail "missing KWStyle binary at $BIN"
+
+TAB_CONFIG="/workspace/repo/usercase-test-coderl/fixtures/kwsTabsTest-KWStyleConfiguration.kws.xml"
+TAB_INPUT="/workspace/repo/usercase-test-coderl/fixtures/kwsTabsTest-test.cxx"
+CLEAN_INPUT="/workspace/repo/usercase-test-coderl/fixtures/clean-tabs-ok.cxx"
+
+EXPECTED_TABS_XML_NORMALIZED='<Error>
+<SourceLineNumber1>3</SourceLineNumber1>
+<SourceLineNumber2>3</SourceLineNumber2>
+<ErrorNumber>10</ErrorNumber>
+</Error>
+<Error>
+<SourceLineNumber1>4</SourceLineNumber1>
+<SourceLineNumber2>4</SourceLineNumber2>
+<ErrorNumber>10</ErrorNumber>
+</Error>
+<Error>
+<SourceLineNumber1>5</SourceLineNumber1>
+<SourceLineNumber2>5</SourceLineNumber2>
+<ErrorNumber>10</ErrorNumber>
+</Error>
+<Error>
+<SourceLineNumber1>6</SourceLineNumber1>
+<SourceLineNumber2>6</SourceLineNumber2>
+<ErrorNumber>10</ErrorNumber>
+</Error>'
+
+normalize_report() {
+  awk '{
+    line = $0
+    sub(/^[[:space:]]+/, "", line)
+    sub(/[[:space:]]+$/, "", line)
+    if (line != "") {
+      print line
+    }
+  }' "$1"
+}
+
+assert_tabs_report() {
+  report="$1"
+  actual="$(normalize_report "$report")"
+
+  [ "$actual" = "$EXPECTED_TABS_XML_NORMALIZED" ] || fail "tabs report content: $(cat "$report")"
+  [ "$(grep -c '^[[:space:]]*<Error>[[:space:]]*$' "$report")" -eq 4 ] || fail "wrong number of Error blocks"
+  ! grep -qE '(<Description>|</Description>|<File|Filename|Warning|<html|<HTML)' "$report" || fail "report includes out-of-scope markup or metadata"
+}
+
+
+
+
+REPORT1="$TMP/tabs-report.xml"
+"$BIN" -xml "$TAB_CONFIG" -exportxml "$REPORT1" "$TAB_INPUT" >"$TMP/f1.out" 2>"$TMP/f1.err"; ec=$?
+
+[ -f "$REPORT1" ] || fail "F1 report was not created"
+assert_tabs_report "$REPORT1"
+
+
+
+
+REPORT2="$TMP/overwrite-report.xml"
+printf 'OLD CONTENT\n' >"$REPORT2"
+"$BIN" -xml "$TAB_CONFIG" -exportxml "$REPORT2" "$TAB_INPUT" >"$TMP/f2.out" 2>"$TMP/f2.err"; ec=$?
+
+assert_tabs_report "$REPORT2"
+! grep -q 'OLD CONTENT' "$REPORT2" || fail "F2 old report content survived overwrite"
+
+
+
+
+REPORT3="$TMP/clean-report.xml"
+"$BIN" -xml "$TAB_CONFIG" -exportxml "$REPORT3" "$CLEAN_INPUT" >"$TMP/f3.out" 2>"$TMP/f3.err"; ec=$?
+
+[ -f "$REPORT3" ] || fail "F3 report was not created"
+
+[ "$(tr -d '[:space:]' < "$REPORT3")" = "" ] || fail "F3 clean report should contain no XML content, got: $(cat "$REPORT3")"
+[ "$(grep -c '^<Error>$' "$REPORT3" || true)" -eq 0 ] || fail "F3 clean report contains Error blocks"
+
+
+
+
+BAD_REPORT="$TMP/missing-parent/report.xml"
+"$BIN" -xml "$TAB_CONFIG" -exportxml "$BAD_REPORT" "$TAB_INPUT" >"$TMP/f4.out" 2>"$TMP/f4.err"; ec=$?
+
+grep -q 'Cannot open file for writing:' "$TMP/f4.out" "$TMP/f4.err" || fail "F4 missing write-failure message; stdout: $(cat "$TMP/f4.out") stderr: $(cat "$TMP/f4.err")"
+[ ! -e "$BAD_REPORT" ] || fail "F4 report should not exist"
+
+echo "PASS"
+exit 0
