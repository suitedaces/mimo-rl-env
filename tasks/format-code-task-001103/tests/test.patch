diff --git a/dask/tests/test_nested_compute_codespec.py b/dask/tests/test_nested_compute_codespec.py
new file mode 100644
index 000000000..e69de29
--- /dev/null
+++ b/dask/tests/test_nested_compute_codespec.py
@@ -0,0 +1,170 @@
+from __future__ import absolute_import, division, print_function
+
+import numpy as np
+import pytest
+
+import dask
+import dask.array as da
+from dask.base import Base
+
+
+def _finalize_scalar(collection, result):
+    return result[0]
+
+
+def _add_result_alias(dsk, keys, **kwargs):
+    result = dsk.copy()
+    result['result'] = 'source'
+    return result
+
+
+def _marker_get(dsk, keys, marker=None, **kwargs):
+    if marker != 'nested-compute':
+        raise AssertionError('scheduler keyword was not forwarded')
+    return dask.get(dsk, keys, **kwargs)
+
+
+def _scheduler_a(dsk, keys, **kwargs):
+    return dask.get(dsk, keys, **kwargs)
+
+
+def _scheduler_b(dsk, keys, **kwargs):
+    return dask.get(dsk, keys, **kwargs)
+
+
+class _OptimizedScalar(Base):
+    _optimize = staticmethod(_add_result_alias)
+    _default_get = staticmethod(dask.get)
+    _finalize = staticmethod(_finalize_scalar)
+
+    @property
+    def dask(self):
+        return {'source': 17}
+
+    def _keys(self):
+        return ['result']
+
+
+class _ScalarA(Base):
+    _optimize = staticmethod(lambda dsk, keys, **kwargs: dsk)
+    _default_get = staticmethod(_scheduler_a)
+    _finalize = staticmethod(_finalize_scalar)
+
+    def __init__(self, key, value):
+        self._key = key
+        self._value = value
+
+    @property
+    def dask(self):
+        return {self._key: self._value}
+
+    def _keys(self):
+        return [self._key]
+
+
+class _ScalarB(_ScalarA):
+    _default_get = staticmethod(_scheduler_b)
+
+
+def test_codespec_nested_compute_reconstructs_builtin_containers():
+    x = da.from_array(np.arange(6), chunks=3)
+    payload = {
+        'arrays': [x + 1, (x.sum(), 'kept')],
+        'empty': {'list': [], 'tuple': ()},
+        'literal': False,
+    }
+
+    result, literal = dask.compute(payload, 23, get=dask.get)
+
+    assert isinstance(result, dict)
+    assert isinstance(result['arrays'], list)
+    assert isinstance(result['arrays'][1], tuple)
+    assert isinstance(result['arrays'][0], np.ndarray)
+    assert not isinstance(result['arrays'][1][0], Base)
+    np.testing.assert_array_equal(result['arrays'][0], np.arange(6) + 1)
+    assert result['arrays'][1][0] == 15
+    assert result['arrays'][1][1] == 'kept'
+    assert result['empty'] == {'list': [], 'tuple': ()}
+    assert result['literal'] is False
+    assert literal == 23
+
+
+def test_codespec_nested_compute_traverses_dict_keys_and_sets():
+    computed_key = dask.value('computed-key')
+    computed_members = set([dask.value(2), dask.value(3)])
+    payload = {computed_key: computed_members, 'plain': set()}
+
+    result = dask.compute(payload, get=dask.get)[0]
+
+    assert all(not isinstance(key, Base) for key in result)
+    assert all(not isinstance(value, Base)
+               for value in result['computed-key'])
+    assert result == {'computed-key': set([2, 3]), 'plain': set()}
+    assert isinstance(result['computed-key'], set)
+
+
+def test_codespec_nested_compute_runs_shared_graph_once():
+    calls = []
+
+    def record(value):
+        calls.append(value)
+        return value * 10
+
+    shared = dask.do(record, pure=True)(2)
+    payload = {'left': shared + 1, 'right': [shared + 2, shared]}
+
+    result = dask.compute(payload, get=dask.get)[0]
+
+    assert calls == [2]
+    assert result == {'left': 21, 'right': [22, 20]}
+
+
+def test_codespec_nested_compute_uses_collection_optimizer():
+    result = dask.compute({'answer': _OptimizedScalar()},
+                          get=dask.get)[0]
+
+    assert result == {'answer': 17}
+
+
+def test_codespec_nested_compute_forwards_scheduler_kwargs():
+    result = dask.compute({'answer': _ScalarA('answer', 17)},
+                          get=_marker_get, marker='nested-compute')[0]
+
+    assert result == {'answer': 17}
+
+
+def test_codespec_nested_compute_checks_default_schedulers():
+    payload = {'a': _ScalarA('a', 1), 'b': [_ScalarB('b', 2)]}
+
+    with pytest.raises(ValueError):
+        dask.compute(payload)
+
+
+def test_codespec_nested_compute_explicit_scheduler_overrides_defaults():
+    payload = {'a': _ScalarA('a', 1), 'b': [_ScalarB('b', 2)]}
+
+    result = dask.compute(payload, get=dask.get)[0]
+
+    assert result == {'a': 1, 'b': [2]}
+
+
+def test_codespec_nested_compute_can_disable_traversal():
+    top_level = dask.value(4)
+    nested = dask.value(3)
+    payload = {'nested': [nested]}
+
+    computed, untouched = dask.compute(top_level, payload,
+                                       traverse=False, get=dask.get)
+
+    assert computed == 4
+    assert untouched is payload
+    assert untouched['nested'][0] is nested
+
+
+def test_codespec_compute_top_level_compatibility():
+    x = da.from_array(np.arange(4), chunks=2)
+
+    result, literal = dask.compute(x + 5, 'literal', get=dask.get)
+
+    np.testing.assert_array_equal(result, np.arange(4) + 5)
+    assert literal == 'literal'
