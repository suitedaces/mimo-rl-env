+++ b/usercase-test-coderl/translator_acceptance_test.go
@@ -0,0 +1,239 @@
+
+
+
+
+
+
+package usercase_test_coderl
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/GaruGaru/ciak/pkg/media/translator"
+)
+
+func TestTranslateTorrentStyleFilenameStopsAtYear(t *testing.T) {
+
+
+	input := "Godzilla.2014.720p.BluRay.x264-LEONARDO_[scarabey.org].mkv"
+
+	actual := translator.Translate(input)
+
+	if actual != "Godzilla" {
+		t.Fatalf("Translate(%q) = %q, want %q", input, actual, "Godzilla")
+	}
+}
+
+func TestTranslateSpaceSeparatedNameStopsAtYear(t *testing.T) {
+
+
+	input := "Godzilla 2014"
+
+	actual := translator.Translate(input)
+
+	if actual != "Godzilla" {
+		t.Fatalf("Translate(%q) = %q, want %q", input, actual, "Godzilla")
+	}
+}
+
+func TestTranslatePlainTitleWithoutYearRemovesGroupAndTokens(t *testing.T) {
+
+
+	input := "[Group]Plain.Title.1080p.mkv"
+
+	actual := translator.Translate(input)
+
+	if actual != "Plain Title" {
+		t.Fatalf("Translate(%q) = %q, want %q", input, actual, "Plain Title")
+	}
+}
+
+func TestTranslateEpisodeMarkerStopsTitle(t *testing.T) {
+
+
+	input := "Example.Show.S02E03.1080p.mkv"
+
+	actual := translator.Translate(input)
+
+	if actual != "Example Show" {
+		t.Fatalf("Translate(%q) = %q, want %q", input, actual, "Example Show")
+	}
+}
+
+func TestTranslateEmptyString(t *testing.T) {
+
+
+	input := ""
+
+	actual := translator.Translate(input)
+
+	if actual != "" {
+		t.Fatalf("Translate(%q) = %q, want %q", input, actual, "")
+	}
+}
+
+func TestTranslateNoMarkerKeepsCleanedTitle(t *testing.T) {
+
+
+	input := "Plain.Title.Without.Marker.avi"
+
+	actual := translator.Translate(input)
+
+	if actual != "Plain Title Without Marker" {
+		t.Fatalf("Translate(%q) = %q, want %q", input, actual, "Plain Title Without Marker")
+	}
+}
+
+func TestTranslateBracketParenthesesAndMp4Removal(t *testing.T) {
+
+
+	input := "[ABC]Movie(Name).mp4"
+
+	actual := translator.Translate(input)
+
+	if actual != "MovieName" {
+		t.Fatalf("Translate(%q) = %q, want %q", input, actual, "MovieName")
+	}
+}
+
+func TestTranslateRemovesAllDeclaredTokens(t *testing.T) {
+
+
+
+	input := "Only.720p.1080p.x264.BluRay.mkv.avi.mp4.().Tokens"
+
+	actual := translator.Translate(input)
+
+
+	if !reflect.DeepEqual(strings.Fields(actual), []string{"Only", "Tokens"}) {
+		t.Fatalf("Translate(%q) fields = %q, want title words %q", input, strings.Fields(actual), []string{"Only", "Tokens"})
+	}
+	if actual != strings.TrimSpace(actual) {
+		t.Fatalf("Translate(%q) = %q, want surrounding whitespace trimmed", input, actual)
+	}
+	for _, token := range []string{"720p", "1080p", "x264", "BluRay", "mkv", "avi", "mp4", "(", ")"} {
+		if strings.Contains(actual, token) {
+			t.Fatalf("Translate(%q) = %q, still contains removed token %q", input, actual, token)
+		}
+	}
+}
+
+func TestTranslateTrimsWhitespaceAfterCleanup(t *testing.T) {
+
+
+	input := "  Leading.And.Trailing.1080p  "
+
+	actual := translator.Translate(input)
+
+	if actual != "Leading And Trailing" {
+		t.Fatalf("Translate(%q) = %q, want %q", input, actual, "Leading And Trailing")
+	}
+}
+
+func TestTranslateIsReferentiallyTransparentForSameInput(t *testing.T) {
+	input := "Example.Show.S02E03.1080p.mkv"
+
+	first := translator.Translate(input)
+	second := translator.Translate(input)
+
+	if first != "Example Show" {
+		t.Fatalf("first Translate(%q) = %q, want %q", input, first, "Example Show")
+	}
+	if second != first {
+		t.Fatalf("second Translate(%q) = %q, want same value %q", input, second, first)
+	}
+}
+
+func TestTranslateDoesNotMutateCallerInput(t *testing.T) {
+	input := "Plain.Title.Without.Marker.avi"
+	before := string([]byte(input))
+
+	actual := translator.Translate(input)
+
+	if actual != "Plain Title Without Marker" {
+		t.Fatalf("Translate(%q) = %q, want %q", input, actual, "Plain Title Without Marker")
+	}
+	if input != before {
+		t.Fatalf("Translate mutated caller input: got %q, want %q", input, before)
+	}
+}
+
+func TestTranslateHasNoCallOrderState(t *testing.T) {
+	input := "[Group]Plain.Title.1080p.mkv"
+
+	first := translator.Translate(input)
+	_ = translator.Translate("Godzilla.2014.720p.BluRay.x264-LEONARDO_[scarabey.org].mkv")
+	_ = translator.Translate("")
+	_ = translator.Translate("Example.Show.S02E03.1080p.mkv")
+	second := translator.Translate(input)
+
+	if first != "Plain Title" {
+		t.Fatalf("first Translate(%q) = %q, want %q", input, first, "Plain Title")
+	}
+	if second != "Plain Title" {
+		t.Fatalf("Translate(%q) after other calls = %q, want %q", input, second, "Plain Title")
+	}
+}
+
+func TestTranslateDoesNotWriteToCurrentDirectory(t *testing.T) {
+	originalCwd, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd failed: %v", err)
+	}
+	tmp := t.TempDir()
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatalf("Chdir(%q) failed: %v", tmp, err)
+	}
+	defer func() {
+		if err := os.Chdir(originalCwd); err != nil {
+			t.Fatalf("restoring cwd failed: %v", err)
+		}
+	}()
+
+	before, err := snapshotRelativePaths(tmp)
+	if err != nil {
+		t.Fatalf("snapshot before Translate failed: %v", err)
+	}
+
+	actual := translator.Translate("[Group]Plain.Title.1080p.mkv")
+
+	after, err := snapshotRelativePaths(tmp)
+	if err != nil {
+		t.Fatalf("snapshot after Translate failed: %v", err)
+	}
+	if actual != "Plain Title" {
+		t.Fatalf("Translate side-effect fixture = %q, want %q", actual, "Plain Title")
+	}
+	if !reflect.DeepEqual(after, before) {
+		t.Fatalf("Translate changed cwd contents: before=%v after=%v", before, after)
+	}
+}
+
+func snapshotRelativePaths(root string) ([]string, error) {
+	var paths []string
+	err := filepath.Walk(root, func(path string, info os.FileInfo, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if path == root {
+			return nil
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		if info.IsDir() {
+			paths = append(paths, rel+"/")
+			return nil
+		}
+		paths = append(paths, rel)
+		return nil
+	})
+	sort.Strings(paths)
+	return paths, err
+}
