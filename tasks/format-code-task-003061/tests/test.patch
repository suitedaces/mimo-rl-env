diff --git a/test/unit/BinaryCharsetEciTest.cpp b/test/unit/BinaryCharsetEciTest.cpp
new file mode 100644
index 00000000..ecb0edb2
--- /dev/null
+++ b/test/unit/BinaryCharsetEciTest.cpp
@@ -0,0 +1,120 @@
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+#include "CharacterSet.h"
+#include "CharacterSetECI.h"
+#include "TextDecoder.h"
+#include "TextEncoder.h"
+
+#include "gtest/gtest.h"
+#include "gmock/gmock.h"
+
+#include <stdexcept>
+
+using namespace ZXing;
+using namespace ZXing::CharacterSetECI;
+using namespace testing;
+
+
+
+TEST(BinaryCharsetEciTest, ResolvesFromEciNumber)
+{
+	EXPECT_EQ(CharsetFromValue(899), CharacterSet::BINARY);
+}
+
+TEST(BinaryCharsetEciTest, ResolvesFromName)
+{
+	EXPECT_EQ(CharsetFromName("BINARY"), CharacterSet::BINARY);
+
+	EXPECT_EQ(CharsetFromName("binary"), CharacterSet::BINARY);
+	EXPECT_EQ(CharsetFromName("Binary"), CharacterSet::BINARY);
+}
+
+TEST(BinaryCharsetEciTest, BinaryReportsEci899)
+{
+	EXPECT_EQ(ValueForCharset(CharacterSet::BINARY), 899);
+}
+
+
+
+TEST(BinaryCharsetEciTest, Iso8859_1ReportsModernEci3)
+{
+	EXPECT_EQ(ValueForCharset(CharacterSet::ISO8859_1), 3);
+}
+
+TEST(BinaryCharsetEciTest, NoEciAssignmentReportsMinusOne)
+{
+	EXPECT_EQ(ValueForCharset(CharacterSet::Unknown), -1);
+}
+
+TEST(BinaryCharsetEciTest, UnambiguousDesignatorsUnchanged)
+{
+	EXPECT_EQ(ValueForCharset(CharacterSet::ISO8859_2), 4);
+	EXPECT_EQ(ValueForCharset(CharacterSet::UTF8), 26);
+	EXPECT_EQ(ValueForCharset(CharacterSet::EUC_KR), 30);
+}
+
+
+
+TEST(BinaryCharsetEciTest, ForwardLookupsConsistent)
+{
+	EXPECT_EQ(CharsetFromValue(3), CharacterSet::ISO8859_1);
+	EXPECT_EQ(CharsetFromValue(4), CharacterSet::ISO8859_2);
+	EXPECT_EQ(CharsetFromValue(26), CharacterSet::UTF8);
+	EXPECT_EQ(CharsetFromName("UTF-8"), CharacterSet::UTF8);
+	EXPECT_EQ(CharsetFromName("ISO-8859-1"), CharacterSet::ISO8859_1);
+}
+
+
+
+TEST(BinaryCharsetEciTest, DecodeIsByteTransparent)
+{
+	uint8_t data[256];
+	for (int i = 0; i < 256; i++)
+		data[i] = static_cast<uint8_t>(i);
+
+	std::wstring str;
+	TextDecoder::Append(str, data, sizeof(data), CharacterSet::BINARY);
+
+	ASSERT_EQ(str.size(), static_cast<size_t>(256));
+	for (int i = 0; i < 256; i++)
+		EXPECT_EQ(static_cast<int>(str[i]), i) << "byte " << i;
+}
+
+
+
+TEST(BinaryCharsetEciTest, EncodeRoundTrips)
+{
+	uint8_t data[256];
+	for (int i = 0; i < 256; i++)
+		data[i] = static_cast<uint8_t>(i);
+
+	std::wstring str;
+	TextDecoder::Append(str, data, sizeof(data), CharacterSet::BINARY);
+
+	std::string bytes = TextEncoder::FromUnicode(str, CharacterSet::BINARY);
+
+	ASSERT_EQ(bytes.size(), static_cast<size_t>(256));
+	for (int i = 0; i < 256; i++)
+		EXPECT_EQ(static_cast<uint8_t>(bytes[i]), static_cast<uint8_t>(i)) << "byte " << i;
+}
+
+TEST(BinaryCharsetEciTest, EncodeRejectsCodePointsAbove0xFF)
+{
+	EXPECT_THROW(
+		{ TextEncoder::FromUnicode(std::wstring(L"\u0100"), CharacterSet::BINARY); },
+		std::invalid_argument);
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,85 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+CXX="${CXX:-g++}"
+SRC=/testbed/core/src
+TESTDIR=/testbed/test/unit
+BUILD=/tmp/zx_grade_build
+CXXFLAGS="-std=c++17 -O1 -include cstdint -DZXING_BUILD_FOR_TEST"
+
+
+GTEST_DIR=""
+for cand in \
+    /testbed/build/_deps/fmtlib-src/test \
+    "$(dirname "$(find / -path '*/test/gmock-gtest-all.cc' 2>/dev/null | head -n1)" 2>/dev/null)"; do
+    if [ -n "$cand" ] && [ -f "$cand/gmock-gtest-all.cc" ] && [ -f "$cand/gtest/gtest.h" ]; then
+        GTEST_DIR="$cand"
+        break
+    fi
+done
+if [ -z "$GTEST_DIR" ]; then
+    echo "FATAL: could not locate a bundled googletest in the image" >&2
+    exit 1
+fi
+GTEST_ALL="$GTEST_DIR/gmock-gtest-all.cc"
+
+
+rm -rf "$BUILD"
+mkdir -p "$BUILD"
+cmake -S /testbed/core -B "$BUILD" \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DBUILD_SHARED_LIBS=OFF \
+    -DBUILD_WRITERS=ON \
+    -DBUILD_READERS=ON \
+    -DCMAKE_CXX_FLAGS="-include cstdint -DZXING_BUILD_FOR_TEST" >/dev/null
+cmake --build "$BUILD" -j "$(nproc)" >/dev/null
+LIB="$BUILD/libZXing.a"
+
+
+MAIN=/tmp/zx_grade_main.cpp
+cat > "$MAIN" <<'EOF'
+#include "gtest/gtest.h"
+#include "gmock/gmock.h"
+int main(int argc, char** argv) {
+    ::testing::InitGoogleMock(&argc, argv);
+    return RUN_ALL_TESTS();
+}
+EOF
+
+INCLUDES="-I $SRC -I $TESTDIR -I $GTEST_DIR -I $GTEST_DIR/gtest"
+
+build_and_run() {
+    local out="$1"; shift
+    # shellcheck disable=SC2086
+    $CXX $CXXFLAGS $INCLUDES "$MAIN" "$@" "$GTEST_ALL" "$LIB" -lpthread -o "$out"
+    "$out"
+}
+
+
+build_and_run /tmp/zx_grade_regression \
+    "$TESTDIR/BitArrayUtility.cpp" \
+    "$TESTDIR/TextUtfEncodingTest.cpp" \
+    "$TESTDIR/qrcode/QREncoderTest.cpp" \
+    "$TESTDIR/pdf417/PDF417HighLevelEncoderTest.cpp"
+
+
+build_and_run /tmp/zx_grade_new \
+    "$TESTDIR/BinaryCharsetEciTest.cpp"
