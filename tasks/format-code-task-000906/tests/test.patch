@@ -94,6 +94,46 @@ class TestListToString(TestCase):
         )
         self.assertEqual("1 and 2", utils.list_to_string([1, 2]))
 
+    def test_same_sep_endsep_two_items(self):
+
+
+        self.assertEqual("A, B", utils.iter_to_str(["A", "B"], sep=",", endsep=","))
+        self.assertEqual("A- B", utils.iter_to_str(["A", "B"], sep="-", endsep="-"))
+        self.assertEqual("A; B", utils.iter_to_str(["A", "B"], sep=";", endsep=";"))
+
+    def test_same_sep_endsep_three_items(self):
+
+        self.assertEqual("A, B, C", utils.iter_to_str(["A", "B", "C"], sep=",", endsep=","))
+        self.assertEqual("A- B- C", utils.iter_to_str(["A", "B", "C"], sep="-", endsep="-"))
+        self.assertEqual("A; B; C", utils.iter_to_str(["A", "B", "C"], sep=";", endsep=";"))
+
+    def test_oxford_trim_still_applied_two_items(self):
+
+
+        self.assertEqual("A and B", utils.iter_to_str(["A", "B"]))
+        self.assertEqual("A and B", utils.iter_to_str(["A", "B"], sep=",", endsep=", and"))
+
+    def test_oxford_kept_for_three_items_default(self):
+
+        self.assertEqual("A, B, and C", utils.iter_to_str(["A", "B", "C"]))
+
+    def test_endsep_punct_word_two_items(self):
+
+
+
+        self.assertEqual("A; and B", utils.iter_to_str(["A", "B"], endsep="; and"))
+
+        self.assertEqual("A, B; and C", utils.iter_to_str(["A", "B", "C"], endsep="; and"))
+
+    def test_single_and_empty(self):
+        self.assertEqual("A", utils.iter_to_str(["A"]))
+        self.assertEqual("", utils.iter_to_str([]))
+
+    def test_addquote_preserved(self):
+
+        self.assertEqual('"1", "2", and "3"', utils.iter_to_str([1, 2, 3], addquote=True))
+        self.assertEqual('"1" and "2"', utils.iter_to_str([1, 2], endsep="and", addquote=True))
+
 
