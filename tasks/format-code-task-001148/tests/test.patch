diff --git a/build/test/unit/wifi_helper_contract.test.js b/build/test/unit/wifi_helper_contract.test.js
new file mode 100644
index 0000000000..e4e7605fe6
--- /dev/null
+++ b/build/test/unit/wifi_helper_contract.test.js
@@ -0,0 +1,202 @@
+'use strict';
+
+var assert = require('chai').assert;
+var fs = require('fs');
+var vm = require('vm');
+
+function loadHelper(manager) {
+  var context = {
+    navigator: { mozWifiManager: manager || {} },
+    console: console
+  };
+  vm.runInNewContext(
+    fs.readFileSync('shared/js/wifi_helper.js', 'utf8'), context,
+    { filename: 'shared/js/wifi_helper.js' });
+  return context.WifiHelper;
+}
+
+function request() {
+  return { onsuccess: null, onerror: null, result: null, error: null };
+}
+
+suite('WifiHelper profile and scan contracts', function() {
+  test('missing security is treated as an open network', function() {
+    var helper = loadHelper({ connection: { network: null } });
+    assert.deepEqual(helper.getSecurity({}), []);
+    assert.equal(helper.getKeyManagement({}), '');
+    assert.isTrue(helper.isOpen({}));
+    assert.isFalse(helper.isEap({}));
+  });
+
+  test('switching to enterprise credentials removes stale profile fields',
+    function() {
+      var helper = loadHelper();
+      var network = {
+        security: ['WPA-EAP'],
+        psk: 'old-psk',
+        wep: 'old-wep',
+        password: 'old-password',
+        identity: 'old-identity',
+        phase2: 'old-phase2',
+        serverCertificate: 'old-cert'
+      };
+
+      helper.setPassword(network, 'new-password', 'new-identity', 'TLS',
+        'No', 'none');
+
+      assert.equal(network.password, 'new-password');
+      assert.equal(network.identity, 'new-identity');
+      assert.equal(network.eap, 'TLS');
+      assert.equal(network.keyManagement, 'WPA-EAP');
+      assert.isUndefined(network.psk);
+      assert.isUndefined(network.wep);
+      assert.isUndefined(network.phase2);
+      assert.isUndefined(network.serverCertificate);
+    });
+
+  test('empty enterprise fields do not retain prior credentials', function() {
+    var helper = loadHelper();
+    var network = {
+      security: ['WPA-EAP'],
+      eap: 'PEAP',
+      password: 'secret',
+      identity: 'person',
+      phase2: 'MSCHAPV2',
+      serverCertificate: 'cert'
+    };
+
+    helper.setPassword(network, '', '', 'PEAP', 'No', 'none');
+    assert.equal(network.eap, 'PEAP');
+    assert.isUndefined(network.password);
+    assert.isUndefined(network.identity);
+    assert.isUndefined(network.phase2);
+    assert.isUndefined(network.serverCertificate);
+  });
+
+  test('switching away from enterprise credentials clears them', function() {
+    var helper = loadHelper();
+    var network = {
+      security: ['WPA-EAP'],
+      eap: 'PEAP',
+      password: 'secret',
+      identity: 'person',
+      phase2: 'MSCHAPV2',
+      serverCertificate: 'cert'
+    };
+
+    network.security = ['WPA-PSK'];
+    helper.setPassword(network, '12345678');
+    assert.equal(network.psk, '12345678');
+    assert.equal(network.keyManagement, 'WPA-PSK');
+    assert.isUndefined(network.eap);
+    assert.isUndefined(network.password);
+    assert.isUndefined(network.identity);
+    assert.isUndefined(network.phase2);
+    assert.isUndefined(network.serverCertificate);
+  });
+
+  test('credential validation distinguishes supported enterprise modes',
+    function() {
+      var helper = loadHelper();
+      assert.isTrue(helper.isValidInput('WPA-EAP', '', '', 'SIM'));
+      assert.isFalse(helper.isValidInput('WPA-EAP', '', '', 'PEAP'));
+      assert.isTrue(helper.isValidInput('WPA-EAP', 'pw', 'user', 'PEAP'));
+      assert.isTrue(helper.isValidInput('WPA-EAP', 'pw', 'user', 'TLS'));
+      assert.isTrue(helper.isValidInput('WPA-EAP', 'pw', 'user', 'TTLS'));
+      assert.isFalse(helper.isValidInput('WPA-EAP', 'pw', 'user', 'AKA'));
+      assert.isFalse(helper.isValidInput('unknown', '', '', ''));
+    });
+
+  test('scan merge de-duplicates normalized security and preserves precedence',
+    function() {
+      var available = [
+        { ssid: 'Office', security: ['WPA-EAP', 'WPA-PSK'], relSignalStrength: 40 },
+        { ssid: 'Guest', security: [], relSignalStrength: 20 }
+      ];
+      var known = [
+        { ssid: 'Office', security: ['WPA-PSK', 'WPA-EAP'], relSignalStrength: 99 },
+        { ssid: 'Hidden', security: ['WEP'], relSignalStrength: 80 }
+      ];
+      var availableReq = request();
+      var knownReq = request();
+      var manager = {
+        getNetworks: function() { return availableReq; },
+        getKnownNetworks: function() { return knownReq; }
+      };
+      var helper = loadHelper(manager);
+      var resultReq = helper.getAvailableAndKnownNetworks();
+      var result;
+      resultReq.onsuccess = function() { result = resultReq.result; };
+      availableReq.result = available;
+      availableReq.onsuccess();
+      knownReq.result = known;
+      knownReq.onsuccess();
+
+      assert.deepEqual(result.map(function(network) { return network.ssid; }),
+        ['Office', 'Guest', 'Hidden']);
+      assert.equal(result[0].relSignalStrength, 40);
+      assert.equal(result[2].relSignalStrength, 80);
+      assert.deepEqual(available, [
+        { ssid: 'Office', security: ['WPA-EAP', 'WPA-PSK'], relSignalStrength: 40 },
+        { ssid: 'Guest', security: [], relSignalStrength: 20 }
+      ]);
+      assert.deepEqual(known, [
+        { ssid: 'Office', security: ['WPA-PSK', 'WPA-EAP'], relSignalStrength: 99 },
+        { ssid: 'Hidden', security: ['WEP'], relSignalStrength: 80 }
+      ]);
+    });
+
+  test('available scan failure is propagated without requesting known networks',
+    function() {
+      var availableReq = request();
+      var knownRequested = false;
+      var manager = {
+        getNetworks: function() { return availableReq; },
+        getKnownNetworks: function() {
+          knownRequested = true;
+          return request();
+        }
+      };
+      var helper = loadHelper(manager);
+      var resultReq = helper.getAvailableAndKnownNetworks();
+      var seenError;
+      resultReq.onerror = function() { seenError = resultReq.error; };
+      availableReq.error = { name: 'scan-failed' };
+      availableReq.onerror();
+      assert.equal(seenError.name, 'scan-failed');
+      assert.isFalse(knownRequested);
+    });
+
+  test('known scan failure still returns available networks', function() {
+    var availableReq = request();
+    var knownReq = request();
+    var manager = {
+      getNetworks: function() { return availableReq; },
+      getKnownNetworks: function() { return knownReq; }
+    };
+    var helper = loadHelper(manager);
+    var resultReq = helper.getAvailableAndKnownNetworks();
+    var result;
+    resultReq.onsuccess = function() { result = resultReq.result; };
+    availableReq.result = [{ ssid: 'Only', security: [] }];
+    availableReq.onsuccess();
+    knownReq.error = { name: 'known-failed' };
+    knownReq.onerror();
+    assert.deepEqual(result.map(function(network) { return network.ssid; }),
+      ['Only']);
+  });
+
+  test('connection comparison tolerates missing state and security ordering',
+    function() {
+      var helper = loadHelper({ connection: { network: {
+        ssid: 'Office', security: ['WPA-PSK', 'WPA-EAP']
+      } } });
+      assert.isTrue(helper.isConnected({
+        ssid: 'Office', security: ['WPA-EAP', 'WPA-PSK']
+      }));
+      helper.wifiManager.connection.network = null;
+      assert.isFalse(helper.isConnected({ ssid: 'Office', security: [] }));
+      helper.wifiManager.connection = null;
+      assert.isFalse(helper.isConnected({ ssid: 'Office', security: [] }));
+    });
+});

