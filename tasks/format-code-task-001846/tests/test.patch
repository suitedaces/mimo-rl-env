new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/grid_stretch_test.go
@@ -0,0 +1,252 @@
+package usercase_test_coderl
+
+import (
+	"image"
+	"testing"
+
+	tui "github.com/marcusolsson/tui-go"
+)
+
+func renderGrid(width, height int, grid *tui.Grid) string {
+	surface := tui.NewTestSurface(width, height)
+	painter := tui.NewPainter(surface, tui.NewTheme())
+	painter.Repaint(grid)
+	return surface.String()
+}
+
+func assertSurface(t *testing.T, got, want string) {
+	t.Helper()
+	if got != want {
+		t.Fatalf("surface mismatch\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func assertSize(t *testing.T, got image.Point, want image.Point) {
+	t.Helper()
+	if got != want {
+		t.Fatalf("size mismatch: got %v, want %v", got, want)
+	}
+}
+
+func newLabeledGrid(cols, rows int, names ...string) (*tui.Grid, []*tui.Label) {
+	grid := tui.NewGrid(cols, rows)
+	grid.SetBorder(true)
+	labels := make([]*tui.Label, 0, len(names))
+	for i, name := range names {
+		label := tui.NewLabel(name)
+		labels = append(labels, label)
+		grid.SetCell(image.Point{X: i % cols, Y: i / cols}, label)
+	}
+	return grid, labels
+}
+
+func TestColumnStretchOneTwoOneDividesRemainingSpace(t *testing.T) {
+
+
+	grid, labels := newLabeledGrid(3, 1, "A", "B", "C")
+	grid.SetColumnStretch(0, 1)
+	grid.SetColumnStretch(1, 2)
+	grid.SetColumnStretch(2, 1)
+
+	assertSurface(t, renderGrid(24, 3, grid), `
+┌─────┬──────────┬─────┐
+│A....│B.........│C....│
+└─────┴──────────┴─────┘
+`)
+	assertSize(t, labels[0].Size(), image.Point{X: 5, Y: 1})
+	assertSize(t, labels[1].Size(), image.Point{X: 10, Y: 1})
+	assertSize(t, labels[2].Size(), image.Point{X: 5, Y: 1})
+}
+
+func TestColumnStretchThreeTwoOneUsesRepeatedFactorIncrements(t *testing.T) {
+
+
+	grid, labels := newLabeledGrid(3, 1, "A", "B", "C")
+	grid.SetColumnStretch(0, 3)
+	grid.SetColumnStretch(1, 2)
+	grid.SetColumnStretch(2, 1)
+
+	assertSurface(t, renderGrid(34, 3, grid), `
+┌───────────────┬──────────┬─────┐
+│A..............│B.........│C....│
+└───────────────┴──────────┴─────┘
+`)
+	assertSize(t, labels[0].Size(), image.Point{X: 15, Y: 1})
+	assertSize(t, labels[1].Size(), image.Point{X: 10, Y: 1})
+	assertSize(t, labels[2].Size(), image.Point{X: 5, Y: 1})
+}
+
+func TestUnsetColumnStretchDoesNotReceiveWeightedExtraSpace(t *testing.T) {
+
+
+	grid := tui.NewGrid(3, 1)
+	grid.SetBorder(true)
+	grid.SetColumnStretch(1, 2)
+	grid.SetColumnStretch(2, 1)
+
+	assertSurface(t, renderGrid(19, 3, grid), `
+┌┬──────────┬─────┐
+││..........│.....│
+└┴──────────┴─────┘
+`)
+}
+
+func TestExplicitZeroColumnStretchBehavesLikeUnset(t *testing.T) {
+
+
+	grid, labels := newLabeledGrid(4, 1, "A", "B", "C", "D")
+	grid.SetColumnStretch(0, 0)
+	grid.SetColumnStretch(1, 1)
+	grid.SetColumnStretch(2, 2)
+	grid.SetColumnStretch(3, 0)
+
+	assertSurface(t, renderGrid(34, 3, grid), `
+┌─┬─────────┬──────────────────┬─┐
+│A│B........│C.................│D│
+└─┴─────────┴──────────────────┴─┘
+`)
+	assertSize(t, labels[0].Size(), image.Point{X: 1, Y: 1})
+	assertSize(t, labels[1].Size(), image.Point{X: 9, Y: 1})
+	assertSize(t, labels[2].Size(), image.Point{X: 18, Y: 1})
+	assertSize(t, labels[3].Size(), image.Point{X: 1, Y: 1})
+}
+
+func TestRowStretchAppliesSameRulesVertically(t *testing.T) {
+
+
+	grid := tui.NewGrid(1, 3)
+	grid.SetBorder(true)
+	labels := []*tui.Label{tui.NewLabel("A"), tui.NewLabel("B"), tui.NewLabel("C")}
+	for row, label := range labels {
+		grid.SetCell(image.Point{X: 0, Y: row}, label)
+	}
+	grid.SetRowStretch(0, 1)
+	grid.SetRowStretch(1, 2)
+	grid.SetRowStretch(2, 1)
+
+	assertSurface(t, renderGrid(7, 24, grid), `
+┌─────┐
+│A....│
+│.....│
+│.....│
+│.....│
+│.....│
+├─────┤
+│B....│
+│.....│
+│.....│
+│.....│
+│.....│
+│.....│
+│.....│
+│.....│
+│.....│
+│.....│
+├─────┤
+│C....│
+│.....│
+│.....│
+│.....│
+│.....│
+└─────┘
+`)
+	assertSize(t, labels[0].Size(), image.Point{X: 5, Y: 5})
+	assertSize(t, labels[1].Size(), image.Point{X: 5, Y: 10})
+	assertSize(t, labels[2].Size(), image.Point{X: 5, Y: 5})
+}
+
+func TestSetColumnStretchUpdatesLaterLayoutsOnSameGrid(t *testing.T) {
+
+
+	grid, labels := newLabeledGrid(3, 1, "A", "B", "C")
+
+
+
+	if before := renderGrid(24, 3, grid); before == "" {
+		t.Fatalf("expected pre-stretch repaint to produce output")
+	}
+
+	grid.SetColumnStretch(0, 1)
+	grid.SetColumnStretch(1, 2)
+	grid.SetColumnStretch(2, 1)
+
+	assertSurface(t, renderGrid(24, 3, grid), `
+┌─────┬──────────┬─────┐
+│A....│B.........│C....│
+└─────┴──────────┴─────┘
+`)
+	assertSize(t, labels[0].Size(), image.Point{X: 5, Y: 1})
+	assertSize(t, labels[1].Size(), image.Point{X: 10, Y: 1})
+	assertSize(t, labels[2].Size(), image.Point{X: 5, Y: 1})
+}
+
+func TestStretchSettingsArePerGridInstance(t *testing.T) {
+
+
+	a, aLabels := newLabeledGrid(3, 1, "A", "B", "C")
+	a.SetColumnStretch(0, 1)
+	a.SetColumnStretch(1, 2)
+	a.SetColumnStretch(2, 1)
+
+	b, bLabels := newLabeledGrid(3, 1, "D", "E", "F")
+
+	assertSurface(t, renderGrid(24, 3, a), `
+┌─────┬──────────┬─────┐
+│A....│B.........│C....│
+└─────┴──────────┴─────┘
+`)
+	assertSize(t, aLabels[0].Size(), image.Point{X: 5, Y: 1})
+	assertSize(t, aLabels[1].Size(), image.Point{X: 10, Y: 1})
+	assertSize(t, aLabels[2].Size(), image.Point{X: 5, Y: 1})
+
+
+
+	renderGrid(24, 3, b)
+	if bLabels[0].Size().X == 5 && bLabels[1].Size().X == 10 && bLabels[2].Size().X == 5 {
+		t.Fatalf("unstretched grid instance unexpectedly used another grid's 1:2:1 stretch settings")
+	}
+}
+
+func TestRepeatedRepaintOfConfiguredGridIsStable(t *testing.T) {
+
+
+	grid, labels := newLabeledGrid(3, 1, "A", "B", "C")
+	grid.SetColumnStretch(0, 1)
+	grid.SetColumnStretch(1, 2)
+	grid.SetColumnStretch(2, 1)
+
+	assertSurface(t, renderGrid(24, 3, grid), `
+┌─────┬──────────┬─────┐
+│A....│B.........│C....│
+└─────┴──────────┴─────┘
+`)
+	assertSurface(t, renderGrid(24, 3, grid), `
+┌─────┬──────────┬─────┐
+│A....│B.........│C....│
+└─────┴──────────┴─────┘
+`)
+	assertSize(t, labels[0].Size(), image.Point{X: 5, Y: 1})
+	assertSize(t, labels[1].Size(), image.Point{X: 10, Y: 1})
+	assertSize(t, labels[2].Size(), image.Point{X: 5, Y: 1})
+}
+
+func TestRepeatedConstructUseRepaintCyclesKeepStretchProportions(t *testing.T) {
+
+
+
+
+	for i := 0; i < 150; i++ {
+		grid, labels := newLabeledGrid(3, 1, "A", "B", "C")
+		grid.SetColumnStretch(0, 1)
+		grid.SetColumnStretch(1, 2)
+		grid.SetColumnStretch(2, 1)
+		assertSurface(t, renderGrid(24, 3, grid), `
+┌─────┬──────────┬─────┐
+│A....│B.........│C....│
+└─────┴──────────┴─────┘
+`)
+		assertSize(t, labels[0].Size(), image.Point{X: 5, Y: 1})
+		assertSize(t, labels[1].Size(), image.Point{X: 10, Y: 1})
+		assertSize(t, labels[2].Size(), image.Point{X: 5, Y: 1})
+	}
+}
