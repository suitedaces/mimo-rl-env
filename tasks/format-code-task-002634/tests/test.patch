diff --git a/lib/plugins/aws/invoke/index.test.js b/lib/plugins/aws/invoke/index.test.js
index b25653c21..147b12198 100644
--- a/lib/plugins/aws/invoke/index.test.js
+++ b/lib/plugins/aws/invoke/index.test.js
@@ -149,6 +149,37 @@ describe('AwsInvoke', () => {
 
       awsInvoke.extendedValidate().then(() => done());
     });
+
+    it('it should parse a JSON string passed via --data', () => {
+      awsInvoke.options.path = false;
+      awsInvoke.options.data = '{ "key1": "pwd" }';
+
+      return awsInvoke.extendedValidate().then(() => {
+        expect(awsInvoke.options.data).to.deep.equal({ key1: 'pwd' });
+        awsInvoke.options.data = null;
+      });
+    });
+
+    it('it should leave non-JSON --data string unchanged', () => {
+      awsInvoke.options.path = false;
+      awsInvoke.options.data = 'just a plain string';
+
+      return awsInvoke.extendedValidate().then(() => {
+        expect(awsInvoke.options.data).to.equal('just a plain string');
+        awsInvoke.options.data = null;
+      });
+    });
+
+    it('it should not alter --data if it is already an object', () => {
+      awsInvoke.options.path = false;
+      const obj = { event: { testProp: 'testValue' } };
+      awsInvoke.options.data = obj;
+
+      return awsInvoke.extendedValidate().then(() => {
+        expect(awsInvoke.options.data).to.deep.equal({ event: { testProp: 'testValue' } });
+        awsInvoke.options.data = null;
+      });
+    });
   });
 
   describe('#invoke()', () => {
