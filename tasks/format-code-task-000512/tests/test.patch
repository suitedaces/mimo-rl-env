diff --git a/usercase-test-coderl/test_expected_num_instance_sampler.py b/usercase-test-coderl/test_expected_num_instance_sampler.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_expected_num_instance_sampler.py
@@ -0,0 +1,228 @@
+
+
+from unittest.mock import patch
+
+import numpy as np
+import pytest
+
+from gluonts.pydantic import ValidationError
+from gluonts.transform import ExpectedNumInstanceSampler
+
+
+def assert_int_array(actual: np.ndarray, expected: list[int]) -> None:
+    assert isinstance(actual, np.ndarray)
+
+    assert np.issubdtype(actual.dtype, np.integer)
+    assert actual.tolist() == expected
+
+
+def test_random_sampling_uses_running_average_probability():
+
+
+
+
+    sampler = ExpectedNumInstanceSampler(
+        num_instances=2, min_past=1, min_future=1
+    )
+    assert sampler.num_instances == 2
+    assert sampler.min_instances == 0
+    assert sampler.axis == -1
+    assert sampler.min_past == 1
+    assert sampler.min_future == 1
+    assert sampler.n == 0
+    assert sampler.total_length == 0
+
+    with patch(
+        "numpy.random.random_sample",
+        return_value=np.array([0.9, 0.2, 0.8, 0.1]),
+    ) as random_sample:
+        indices = sampler(np.zeros(5))
+
+    random_sample.assert_called_once_with(4)
+    assert_int_array(indices, [2, 4])
+    assert sampler.n == 1
+    assert sampler.total_length == 4
+
+
+def test_min_instances_prefix_is_sampled_when_probability_selects_too_few():
+
+
+
+
+    sampler = ExpectedNumInstanceSampler(num_instances=1, min_instances=2)
+    assert sampler.num_instances == 1
+    assert sampler.min_instances == 2
+    assert sampler.axis == -1
+    assert sampler.min_past == 0
+    assert sampler.min_future == 0
+    assert sampler.n == 0
+    assert sampler.total_length == 0
+
+    with patch(
+        "numpy.random.random_sample",
+        return_value=np.array([0.9, 0.9, 0.9, 0.9]),
+    ) as random_sample, patch(
+        "numpy.random.randint", return_value=np.array([3, 1])
+    ) as randint:
+        indices = sampler(np.zeros(3))
+
+    random_sample.assert_called_once_with(4)
+    randint.assert_called_once_with(0, 4, size=2)
+    assert_int_array(indices, [3, 1])
+    assert sampler.n == 1
+    assert sampler.total_length == 4
+
+
+def test_empty_interval_returns_empty_array_and_preserves_counters():
+
+
+
+
+    sampler = ExpectedNumInstanceSampler(
+        num_instances=4, min_past=3, min_future=2
+    )
+    assert sampler.n == 0
+    assert sampler.total_length == 0
+
+    with patch(
+        "numpy.random.random_sample", return_value=np.array([0.2, 0.8])
+    ) as random_sample:
+        first = sampler(np.zeros(6))
+
+    random_sample.assert_called_once_with(2)
+    assert_int_array(first, [3, 4])
+    assert sampler.n == 1
+    assert sampler.total_length == 2
+
+    empty = sampler(np.zeros(4))
+
+    assert_int_array(empty, [])
+    assert sampler.n == 1
+    assert sampler.total_length == 2
+
+
+def test_axis_keyword_selects_length_from_requested_dimension():
+
+
+
+
+    sampler = ExpectedNumInstanceSampler(
+        num_instances=2, axis=0, min_past=1, min_future=1
+    )
+    assert sampler.axis == 0
+    assert sampler.n == 0
+    assert sampler.total_length == 0
+
+    with patch(
+        "numpy.random.random_sample",
+        return_value=np.array([0.9, 0.2, 0.8, 0.1]),
+    ) as random_sample:
+        indices = sampler(np.zeros((5, 2)))
+
+    random_sample.assert_called_once_with(4)
+    assert_int_array(indices, [2, 4])
+    assert sampler.n == 1
+    assert sampler.total_length == 4
+
+
+def test_second_valid_call_uses_state_accumulated_from_first_call():
+
+
+
+
+    sampler = ExpectedNumInstanceSampler(
+        num_instances=2, min_past=1, min_future=1
+    )
+    assert sampler.n == 0
+    assert sampler.total_length == 0
+
+    with patch(
+        "numpy.random.random_sample",
+        side_effect=[
+            np.array([0.1, 0.9, 0.1, 0.9]),
+            np.array([0.7, 0.8]),
+        ],
+    ) as random_sample:
+        first = sampler(np.zeros(5))
+        second = sampler(np.zeros(3))
+
+    assert random_sample.call_args_list[0].args == (4,)
+    assert random_sample.call_args_list[1].args == (2,)
+    assert_int_array(first, [1, 3])
+    assert sampler.n == 2
+    assert sampler.total_length == 6
+    assert_int_array(second, [])
+
+
+def test_missing_required_num_instances_raises_error():
+
+
+
+
+
+
+    with pytest.raises((TypeError, ValueError, ValidationError)):
+        ExpectedNumInstanceSampler()
+
+
+def test_two_sampler_instances_keep_independent_running_counters():
+
+
+
+
+    a = ExpectedNumInstanceSampler(
+        num_instances=2, min_past=1, min_future=1
+    )
+    b = ExpectedNumInstanceSampler(
+        num_instances=2, min_past=1, min_future=1
+    )
+    assert a.n == 0
+    assert a.total_length == 0
+    assert b.n == 0
+    assert b.total_length == 0
+
+    with patch(
+        "numpy.random.random_sample",
+        side_effect=[
+            np.array([0.1, 0.1, 0.1, 0.1]),
+            np.array([0.1, 0.1, 0.1, 0.1]),
+        ],
+    ):
+        a_indices = a(np.zeros(5))
+        assert_int_array(a_indices, [1, 2, 3, 4])
+        assert a.n == 1
+        assert a.total_length == 4
+        assert b.n == 0
+        assert b.total_length == 0
+
+        b_indices = b(np.zeros(5))
+        assert_int_array(b_indices, [1, 2, 3, 4])
+        assert a.n == 1
+        assert a.total_length == 4
+        assert b.n == 1
+        assert b.total_length == 4
+
+
+def test_construct_call_drop_cycles_remain_callable_per_instance():
+
+
+
+
+    ts = np.zeros(5)
+    random_values = np.array([0.1, 0.9, 0.1, 0.9])
+
+    with patch("numpy.random.random_sample", return_value=random_values):
+
+
+        for _ in range(100):
+            sampler = ExpectedNumInstanceSampler(
+                num_instances=2, min_past=1, min_future=1
+            )
+            assert sampler.n == 0
+            assert sampler.total_length == 0
+            indices = sampler(ts)
+            assert_int_array(indices, [1, 3])
+            assert sampler.n == 1
+            assert sampler.total_length == 4
+            del sampler
+            del indices
