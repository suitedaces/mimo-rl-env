+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+export GO111MODULE=off
+REPO_PKG="github.com/uber/cherami-server"
+
+
+go test -run 'TestUtilSuite|TestLoadReporterSuite|TestCounterBankSuite' "$REPO_PKG/common"
+
+
+go test -race -run 'TestRateReporterSuite' "$REPO_PKG/common"
