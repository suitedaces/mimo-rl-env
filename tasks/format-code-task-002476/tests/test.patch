+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+
+/root/.venv/bin/python -m pytest -q \
+    raiden/tests/unit/test_matrix_transport.py \
+    raiden/tests/unit/test_utils.py
+
+
