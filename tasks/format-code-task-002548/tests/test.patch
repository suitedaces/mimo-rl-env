diff --git a/rustfmt-core/tests/source/lazy_static_comments.rs b/rustfmt-core/tests/source/lazy_static_comments.rs
new file mode 100644
index 00000000..5942e02b
--- /dev/null
+++ b/rustfmt-core/tests/source/lazy_static_comments.rs
@@ -0,0 +1,10 @@
+// Comments inside lazy_static should not be dropped or moved.
+
+lazy_static! {
+// keep this explanation with the declaration below
+static    ref   COMMENTED : Vec < usize > = vec ! [
+1,
+/* keep this marker before the second value */ 2,
+3
+] ;
+}
diff --git a/rustfmt-core/tests/source/lazy_static_format.rs b/rustfmt-core/tests/source/lazy_static_format.rs
new file mode 100644
index 00000000..9757be78
--- /dev/null
+++ b/rustfmt-core/tests/source/lazy_static_format.rs
@@ -0,0 +1,15 @@
+// Ordinary lazy_static declarations should be formatted.
+
+lazy_static! {
+static    ref   ANSWER_LIST : Vec < i32 > = vec ! [ 1 ,2,3,4 ] ;
+pub static ref GREETING:String={
+let words = [ "hello" , "from" , "lazy_static" ];
+words
+.join(" ")
+};
+}
+
+fn keep_the_rest_of_the_file_formatted() {
+let value = 1+2;
+println!("{}", value);
+}
diff --git a/rustfmt-core/tests/source/lazy_static_unsupported.rs b/rustfmt-core/tests/source/lazy_static_unsupported.rs
new file mode 100644
index 00000000..0d7448cb
--- /dev/null
+++ b/rustfmt-core/tests/source/lazy_static_unsupported.rs
@@ -0,0 +1,16 @@
+// Unsupported lazy_static bodies should remain safe.
+
+lazy_static! {
+alpha , beta => gamma ;
+}
+
+lazy_static! {
+fn helper ( input : usize ) -> usize {
+input + 1
+}
+static VALUE: usize = helper(4);
+}
+
+fn after_unsupported_macro() {
+println!("still formatted");
+}
