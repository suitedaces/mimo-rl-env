diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+export CARGO_HOME=/usr/local/cargo
+export RUSTUP_HOME=/usr/local/rustup
+export PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
+
+case "${1:-}" in
+  base)
+    cargo +nightly-2018-04-01 test -p rustfmt-core --test lib stdin_formatting_smoke_test -- --nocapture
+    ;;
+  new)
+    cargo +nightly-2018-04-01 test -p rustfmt-core --test lib lazy_static_fixture_tests -- --nocapture
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
