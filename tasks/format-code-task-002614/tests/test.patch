diff --git a/scanpy/tests/test_highly_variable_genes.py b/scanpy/tests/test_highly_variable_genes.py
index 2f732292..38acf7de 100644
--- a/scanpy/tests/test_highly_variable_genes.py
+++ b/scanpy/tests/test_highly_variable_genes.py
@@ -506,3 +506,131 @@ def test_seurat_v3_mean_var_output_with_batchkey():
     )
     np.testing.assert_allclose(true_mean, result_df['means'], rtol=2e-05, atol=2e-05)
     np.testing.assert_allclose(true_var, result_df['variances'], rtol=2e-05, atol=2e-05)
+
+
+def _small_log1p_adata(n_obs=100, n_vars=30, seed=0):
+    import anndata
+
+    rng = np.random.RandomState(seed)
+    adata = anndata.AnnData(rng.poisson(2, (n_obs, n_vars)).astype(np.float32))
+    sc.pp.normalize_total(adata)
+    sc.pp.log1p(adata)
+    return adata
+
+
+def test_cell_ranger_n_top_genes_exceeds_dispersions_no_indexerror():
+
+    adata = _small_log1p_adata()
+    with warnings.catch_warnings():
+        warnings.simplefilter('ignore')
+        sc.pp.highly_variable_genes(adata, n_top_genes=1000, flavor='cell_ranger')
+    assert 'highly_variable' in adata.var.columns
+
+
+def test_cell_ranger_n_top_genes_exceeds_dispersions_emits_userwarning():
+
+
+
+
+
+
+
+
+    import logging as _logging
+
+    class _ListHandler(_logging.Handler):
+        def __init__(self):
+            super().__init__()
+            self.records = []
+
+        def emit(self, record):
+            self.records.append(record)
+
+    handler = _ListHandler()
+    handler.setLevel(_logging.WARNING)
+    original_verbosity = sc.settings.verbosity
+    try:
+
+
+
+
+        sc.settings.verbosity = 'warning'
+        sc.settings._root_logger.addHandler(handler)
+        adata = _small_log1p_adata()
+        with warnings.catch_warnings(record=True) as recorded:
+            warnings.simplefilter('always')
+            sc.pp.highly_variable_genes(
+                adata, n_top_genes=1000, flavor='cell_ranger'
+            )
+    finally:
+        sc.settings._root_logger.removeHandler(handler)
+        sc.settings.verbosity = original_verbosity
+
+    has_python_userwarning = any(
+        issubclass(w.category, UserWarning) and 'n_top_genes' in str(w.message)
+        for w in recorded
+    )
+    has_logger_warning = any(
+        r.levelno >= _logging.WARNING and 'n_top_genes' in r.getMessage()
+        for r in handler.records
+    )
+
+    assert has_python_userwarning or has_logger_warning, (
+        "Expected a user-visible warning (Python UserWarning or scanpy "
+        "logger WARNING) about n_top_genes exceeding the number of "
+        "normalized dispersions. "
+        f"warnings={[str(w.message) for w in recorded]!r}, "
+        f"log_records={[(r.levelname, r.getMessage()) for r in handler.records]!r}"
+    )
+
+
+def test_cell_ranger_n_top_genes_exceeds_dispersions_returns_all_genes():
+
+
+
+    adata = _small_log1p_adata()
+    with warnings.catch_warnings():
+        warnings.simplefilter('ignore')
+        sc.pp.highly_variable_genes(adata, n_top_genes=1000, flavor='cell_ranger')
+
+
+    assert adata.var['highly_variable'].sum() == adata.n_vars
+
+
+def test_cell_ranger_n_top_genes_exceeds_dispersions_inplace_false():
+
+
+    adata = _small_log1p_adata()
+    with warnings.catch_warnings():
+        warnings.simplefilter('ignore')
+        df = sc.pp.highly_variable_genes(
+            adata, n_top_genes=1000, flavor='cell_ranger', inplace=False
+        )
+    assert df is not None
+    assert 'highly_variable' in df.columns
+    assert df['highly_variable'].sum() == adata.n_vars
+
+
+def test_cell_ranger_normal_case_no_userwarning():
+
+
+
+    import anndata
+
+    rng = np.random.RandomState(0)
+    adata = anndata.AnnData(rng.poisson(2, (200, 1000)).astype(np.float32))
+    sc.pp.normalize_total(adata)
+    sc.pp.log1p(adata)
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter('always')
+        sc.pp.highly_variable_genes(adata, n_top_genes=200, flavor='cell_ranger')
+    user_warnings = [
+        wi
+        for wi in w
+        if issubclass(wi.category, UserWarning)
+        and 'n_top_genes' in str(wi.message)
+        and 'normalized dispersions' in str(wi.message)
+    ]
+    assert user_warnings == []
+
+    assert adata.var['highly_variable'].sum() == 200
