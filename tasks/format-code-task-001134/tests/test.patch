+#!/bin/bash
+set -euo pipefail
+
+
+export DJANGO_SETTINGS_MODULE=tests.settings
+export PYTHONPATH="${PWD}/.build_env/.venv/lib/python3.11/site-packages${PYTHONPATH:+:${PYTHONPATH}}"
+/usr/bin/python3 -m pytest -q tests/test_connection_header_contract.py
