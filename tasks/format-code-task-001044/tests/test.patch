+import io
+import inspect
+from pathlib import Path
+
+import pandas as pd
+import pytest
+from shapely.geometry import box
+
+import geopandas
+from geopandas.testing import assert_geodataframe_equal
+
+
+@pytest.fixture(scope="module")
+def codespec_world_path():
+    return geopandas.datasets.get_path("naturalearth_lowres")
+
+
+@pytest.fixture(scope="module")
+def codespec_world(codespec_world_path):
+    return geopandas.read_file(codespec_world_path)
+
+
+def test_codespec_read_file_exposes_selection_parameters():
+    parameters = list(inspect.signature(geopandas.read_file).parameters.values())
+
+    assert [parameter.name for parameter in parameters[:6]] == [
+        "filename",
+        "bbox",
+        "mask",
+        "rows",
+        "columns",
+        "where",
+    ]
+    assert len(parameters) == 7
+    assert parameters[-1].kind is inspect.Parameter.VAR_KEYWORD
+
+
+def test_codespec_columns_preserve_request_order_and_geometry(
+    codespec_world_path, codespec_world
+):
+    result = geopandas.read_file(
+        codespec_world_path, columns=("iso_a3", "name")
+    )
+
+    assert list(result.columns) == ["iso_a3", "name", "geometry"]
+    assert_geodataframe_equal(
+        result,
+        codespec_world[["iso_a3", "name", "geometry"]],
+        check_crs=True,
+    )
+
+
+def test_codespec_empty_columns_selects_only_geometry(
+    codespec_world_path, codespec_world
+):
+    result = geopandas.read_file(codespec_world_path, columns=[])
+
+    assert list(result.columns) == ["geometry"]
+    assert_geodataframe_equal(
+        result,
+        codespec_world[["geometry"]],
+        check_crs=True,
+    )
+
+
+def test_codespec_columns_with_ignore_geometry_returns_plain_dataframe(
+    codespec_world_path, codespec_world
+):
+    result = geopandas.read_file(
+        codespec_world_path,
+        columns=("name", "iso_a3"),
+        ignore_geometry=True,
+    )
+    empty_result = geopandas.read_file(
+        codespec_world_path, columns=[], ignore_geometry=True
+    )
+
+    assert isinstance(result, pd.DataFrame)
+    assert not isinstance(result, geopandas.GeoDataFrame)
+    pd.testing.assert_frame_equal(result, codespec_world[["name", "iso_a3"]])
+    assert isinstance(empty_result, pd.DataFrame)
+    assert not isinstance(empty_result, geopandas.GeoDataFrame)
+    assert empty_result.shape == (len(codespec_world), 0)
+    assert empty_result.index.equals(codespec_world.index)
+
+
+def test_codespec_columns_validation(codespec_world_path):
+    with pytest.raises(ValueError, match="does_not_exist"):
+        geopandas.read_file(codespec_world_path, columns=["name", "does_not_exist"])
+    with pytest.raises(ValueError):
+        geopandas.read_file(codespec_world_path, columns=["name", "name"])
+    with pytest.raises(ValueError):
+        geopandas.read_file(codespec_world_path, columns=["geometry", "name"])
+    with pytest.raises(TypeError):
+        geopandas.read_file(codespec_world_path, columns="name")
+
+
+def test_codespec_where_filters_at_datasource(codespec_world_path, codespec_world):
+    result = geopandas.read_file(
+        codespec_world_path,
+        where="continent = 'Oceania' AND pop_est >= 1000000",
+    )
+    expected = codespec_world[
+        (codespec_world["continent"] == "Oceania")
+        & (codespec_world["pop_est"] >= 1000000)
+    ].reset_index(drop=True)
+
+    assert len(expected) > 1
+    assert_geodataframe_equal(result, expected, check_crs=True)
+
+
+def test_codespec_where_can_use_an_unselected_field(
+    codespec_world_path, codespec_world
+):
+    result = geopandas.read_file(
+        codespec_world_path,
+        columns=["name"],
+        where="continent = 'Oceania'",
+    )
+    expected = codespec_world.loc[
+        codespec_world["continent"] == "Oceania", ["name", "geometry"]
+    ].reset_index(drop=True)
+
+    assert list(result.columns) == ["name", "geometry"]
+    assert_geodataframe_equal(result, expected, check_crs=True)
+
+
+def test_codespec_rows_are_applied_after_where(codespec_world_path, codespec_world):
+    result = geopandas.read_file(
+        codespec_world_path,
+        columns=["name"],
+        where="continent = 'Oceania'",
+        rows=slice(1, 3),
+    )
+    expected = (
+        codespec_world.loc[
+            codespec_world["continent"] == "Oceania", ["name", "geometry"]
+        ]
+        .iloc[1:3]
+        .reset_index(drop=True)
+    )
+
+    assert len(result) == 2
+    assert_geodataframe_equal(result, expected, check_crs=True)
+
+
+@pytest.mark.parametrize("spatial_argument", ["bbox", "mask"])
+def test_codespec_where_is_combined_with_spatial_filter(spatial_argument):
+    path = geopandas.datasets.get_path("nybb")
+    spatial_filter = box(
+        1031051.7879884212,
+        224272.49231459625,
+        1047224.3104931959,
+        244317.30894023244,
+    )
+    kwargs = {spatial_argument: spatial_filter}
+
+    result = geopandas.read_file(
+        path,
+        columns=["BoroName"],
+        where="BoroName = 'Bronx'",
+        **kwargs,
+    )
+
+    assert list(result.columns) == ["BoroName", "geometry"]
+    assert result["BoroName"].tolist() == ["Bronx"]
+
+
+def test_codespec_selection_works_for_file_like_inputs():
+    data_path = Path(__file__).parents[2] / "tests" / "data" / "null_geom.geojson"
+    result = geopandas.read_file(
+        io.BytesIO(data_path.read_bytes()),
+        columns=["Name"],
+        where="Name = 'SF to NY'",
+    )
+
+    assert list(result.columns) == ["Name", "geometry"]
+    assert result["Name"].tolist() == ["SF to NY"]
+    assert result.geometry.iloc[0].geom_type == "LineString"
+
+
+def test_codespec_selection_argument_validation(codespec_world_path):
+    with pytest.raises(TypeError):
+        geopandas.read_file(codespec_world_path, where=123)
+    with pytest.raises(ValueError):
+        geopandas.read_file(
+            codespec_world_path,
+            columns=["name"],
+            include_fields=["iso_a3"],
+        )
+    with pytest.raises(ValueError):
+        geopandas.read_file(
+            codespec_world_path,
+            columns=["name"],
+            ignore_fields=["iso_a3"],
+        )
+
+
+def test_codespec_legacy_field_options_remain_available(codespec_world_path):
+    included = geopandas.read_file(codespec_world_path, include_fields=["name"])
+    ignored = geopandas.read_file(
+        codespec_world_path,
+        ignore_fields=["pop_est", "continent", "iso_a3", "gdp_md_est"],
+    )
+
+    assert list(included.columns) == ["name", "geometry"]
+    assert list(ignored.columns) == ["name", "geometry"]
