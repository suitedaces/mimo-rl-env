+func TestGetScpCmdUsesIdentitiesOnlyForAllExplicitTransferDirections(t *testing.T) {
+	testCases := []struct {
+		name  string
+		src   string
+		dest  string
+		hosts MockHostInfoMapLoader
+	}{
+		{
+			name: "remote to local",
+			src:  "prod-source:/srv/app.tar",
+			dest: "/var/releases/app.tar",
+			hosts: MockHostInfoMapLoader{
+				"prod-source": {
+					ip:          "9.8.7.6",
+					sshUsername: "deploy",
+					sshKeyPath:  "/home/deploy/.ssh/id_ed25519",
+				},
+			},
+		},
+		{
+			name: "remote to remote",
+			src:  "prod-source:/srv/app.tar",
+			dest: "prod-dest:/srv/app.tar",
+			hosts: MockHostInfoMapLoader{
+				"prod-source": {
+					ip:          "9.8.7.6",
+					sshUsername: "deploy",
+					sshKeyPath:  "/home/deploy/.ssh/id_ed25519",
+				},
+				"prod-dest": {
+					ip:          "6.7.8.9",
+					sshUsername: "deploy",
+					sshKeyPath:  "/home/deploy/.ssh/id_ecdsa",
+				},
+			},
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			cmd, err := getScpCmd(tc.src, tc.dest, false, tc.hosts)
+
+			assert.NoError(t, err)
+			assertIdentitiesOnlyPresent(t, cmd.Args)
+		})
+	}
+}
+
+func assertIdentitiesOnlyPresent(t *testing.T, args []string) {
+	t.Helper()
+
+	if !hasIdentitiesOnlyOption(args) {
+		t.Fatalf("expected scp args to restrict authentication to explicit identities, got %#v", args)
+	}
+}
+
+func assertIdentitiesOnlyAbsent(t *testing.T, args []string) {
+	t.Helper()
+
+	if hasIdentitiesOnlyOption(args) {
+		t.Fatalf("expected scp args to allow agent identities when an endpoint has no explicit key, got %#v", args)
+	}
+}
+
+func assertContainsArgPair(t *testing.T, args []string, flag string, value string) {
+	t.Helper()
+
+	for i := 0; i < len(args)-1; i++ {
+		if args[i] == flag && args[i+1] == value {
+			return
+		}
+	}
+
+	t.Fatalf("expected scp args to contain %s %s, got %#v", flag, value, args)
+}
+
+func hasIdentitiesOnlyOption(args []string) bool {
+	for i := 0; i < len(args)-1; i++ {
+
+		if args[i] == "-o" && args[i+1] == "IdentitiesOnly=yes" {
+			return true
+		}
+	}
+
+	return false
+}
