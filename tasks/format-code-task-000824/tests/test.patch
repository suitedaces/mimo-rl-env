--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,36 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export GOPATH=/root/go
+export GO111MODULE=off
+mkdir -p /root/go/src/github.com/docker
+ln -sf /testbed /root/go/src/github.com/docker/machine
+
+if ! command -v scp &>/dev/null; then
+    export DEBIAN_FRONTEND=noninteractive
+    cat > /etc/apt/sources.list.d/ubuntu.sources <<'SRCLIST'
+Types: deb
+URIs: http://archive.ubuntu.com/ubuntu/
+Suites: noble-updates
+Components: main universe restricted multiverse
+Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
+SRCLIST
+    apt-get update -qq
+    apt-get install -y -qq openssh-client
+fi
+
+
+case "${1:-}" in
+  base)
+    go test -v github.com/docker/machine/commands -run '^(TestGetInfoForLocalScpArg|TestGetInfoForRemoteScpArg|TestHostLocation|TestRemoteLocation|TestGetScpCmdWithoutSshKey)$'
+    ;;
+  new)
+    go test -v github.com/docker/machine/commands -run '^TestGetScpCmd'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
