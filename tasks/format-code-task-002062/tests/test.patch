+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
+export NO_UPDATE_NOTIFIER=1
+export PNPM_CONFIG_OFFLINE=true
+export PNPM_CONFIG_UPDATE_NOTIFIER=false
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+
+pnpm install --frozen-lockfile --offline --ignore-scripts >/dev/null
+
+
+mkdir -p /workspace/repo/node_modules/@tsconfig /workspace/repo/node_modules/.bin
+ln -sfn .pnpm/vitest@3.0.9_@types+node@22.20.1_yaml@2.9.0/node_modules/vitest /workspace/repo/node_modules/vitest
+ln -sfn ../.pnpm/@tsconfig+node22@22.0.5/node_modules/@tsconfig/node22 /workspace/repo/node_modules/@tsconfig/node22
+
+exec node /workspace/repo/node_modules/vitest/vitest.mjs run \
+    --config /workspace/repo/usercase-test-coderl/vitest.config.ts \
+    /workspace/repo/usercase-test-coderl/solid_model_to_jsonld.test.ts \
+    --reporter verbose
