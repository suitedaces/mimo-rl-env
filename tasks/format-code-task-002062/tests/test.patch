+import { fileURLToPath, URL } from 'node:url';
+
+import { defineConfig } from 'vitest/config';
+
+export default defineConfig({
+    resolve: {
+        alias: {
+            soukai: fileURLToPath(new URL('../packages/soukai/src/', import.meta.url)),
+            'soukai-solid': fileURLToPath(new URL('../packages/soukai-solid/src/', import.meta.url)),
+        },
+    },
+    test: {
+        include: ['usercase-test-coderl/**/*.test.ts'],
+    },
+});
