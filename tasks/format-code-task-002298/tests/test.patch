diff --git a/src/__tests__/index.js b/src/__tests__/index.js
index b656c61..dbb9f51 100644
--- a/src/__tests__/index.js
+++ b/src/__tests__/index.js
@@ -1100,3 +1100,73 @@ test(
   'calc(1px + 2unknown)',
   'calc(1px + 2unknown)'
 );
+
+test(
+  'should not drop 0 - when subtracting a division of a css variable (issue example)',
+  testValue,
+  'calc(0px - (var(--foo, 4px) / 2))',
+  'calc(0px - var(--foo, 4px)/2)',
+);
+
+test(
+  'should not drop 0 - when subtracting a division of a css variable (no fallback)',
+  testValue,
+  'calc(0px - (var(--foo) / 2))',
+  'calc(0px - var(--foo)/2)',
+);
+
+test(
+  'should not drop 0 - when subtracting a multiplication of a css variable',
+  testValue,
+  'calc(0px - (var(--foo) * 2))',
+  'calc(0px - var(--foo)*2)',
+);
+
+test(
+  'should preserve 0 - when subtracting an addition of two css variables',
+  testValue,
+  'calc(0px - (var(--foo) + var(--bar)))',
+  'calc(0px - var(--foo) - var(--bar))',
+);
+
+test(
+  'should preserve 0 - when subtracting a subtraction of two css variables',
+  testValue,
+  'calc(0px - (var(--foo) - var(--bar)))',
+  'calc(0px - var(--foo) + var(--bar))',
+);
+
+test(
+  'should preserve var sign when subtracting a value + var',
+  testValue,
+  'calc(0px - (10px + var(--foo)))',
+  'calc(-10px - var(--foo))',
+);
+
+test(
+  'should preserve 0 - when subtracting a nested calc with a css variable',
+  testValue,
+  'calc(0px - calc(var(--foo) / 2))',
+  'calc(0px - var(--foo)/2)',
+);
+
+test(
+  'should still negate a direct css variable subtraction from zero',
+  testValue,
+  'calc(0px - var(--foo))',
+  'calc(0px - var(--foo))',
+);
+
+test(
+  'should still reduce 0 - numeric value',
+  testValue,
+  'calc(0px - 10px)',
+  '-10px',
+);
+
+test(
+  'should still reduce 0 - sum of numeric values',
+  testValue,
+  'calc(0px - (10px + 20px))',
+  '-30px',
+);
