diff --git a/usercase-test-coderl/autoplay_related_queue.test.ts b/usercase-test-coderl/autoplay_related_queue.test.ts
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/autoplay_related_queue.test.ts
@@ -0,0 +1,447 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { DisTube, DisTubeError, Events, ExtractorPlugin, Queue, QueueManager, type Song } from "@";
+import type { Awaitable, ResolveOptions } from "@";
+import type { Playlist } from "@/struct/Playlist";
+
+vi.mock("@/core/DisTubeStream", () => ({
+  DisTubeStream: vi.fn(() => ({ on: vi.fn() })),
+}));
+
+
+
+
+
+
+
+
+
+const GUILD_ID = "123456789012345678";
+const OTHER_GUILD_ID = "323456789012345678";
+const USER_ID = "223456789012345678";
+
+class RelatedPlugin extends ExtractorPlugin {
+  readonly relatedCalls: string[] = [];
+  relatedById = new Map<string, Song[]>();
+
+  validate(): Awaitable<boolean> {
+    return true;
+  }
+
+  resolve<T>(): Awaitable<Song<T> | Playlist<T>> {
+    throw new Error("resolve is not used by this acceptance test");
+  }
+
+  searchSong<T>(): Awaitable<Song<T> | null> {
+    return null;
+  }
+
+  getStreamURL<T>(song: Song<T>): Awaitable<string> {
+    return `https://stream/${song.id}`;
+  }
+
+  getRelatedSongs(song: Song): Awaitable<Song[]> {
+    this.relatedCalls.push(song.id);
+    return this.relatedById.get(song.id) ?? [];
+  }
+}
+
+type MockDisTube = {
+  options: {
+    savePreviousSongs: boolean;
+    emitNewSongOnly: boolean;
+    ffmpeg: { path: string; args: { global: object; input: object; output: object } };
+  };
+  emit: ReturnType<typeof vi.fn>;
+  debug: ReturnType<typeof vi.fn>;
+  emitError: ReturnType<typeof vi.fn>;
+  plugins: RelatedPlugin[];
+  handler: {
+    _getPluginFromSong: ReturnType<typeof vi.fn>;
+    attachStreamInfo: ReturnType<typeof vi.fn>;
+  };
+  queues: {
+    playSong: ReturnType<typeof vi.fn>;
+    remove: ReturnType<typeof vi.fn>;
+  };
+  voices: object;
+  client: { user: { id: string } };
+};
+
+function createVoice(id = GUILD_ID) {
+  const clientMember = {
+    id: USER_ID,
+    user: { id: USER_ID },
+    guild: { id },
+  };
+  return {
+    id,
+    stop: vi.fn(),
+    play: vi.fn().mockResolvedValue(undefined),
+    pause: vi.fn(),
+    unpause: vi.fn(),
+    on: vi.fn(),
+    off: vi.fn(),
+    volume: 50,
+    playbackTime: 0,
+    channel: { guild: { id, members: { me: clientMember } } },
+  } as any;
+}
+
+function makeSong(id: string, overrides: Partial<Song> = {}): Song {
+  return {
+    id,
+    duration: 10,
+    metadata: undefined,
+    member: undefined,
+    stream: { playFromSource: true, url: `https://stream/${id}` },
+    toString: () => id,
+    ...overrides,
+  } as Song;
+}
+
+function makeMockDisTube(plugin = new RelatedPlugin()): MockDisTube {
+  return {
+    options: {
+      savePreviousSongs: true,
+      emitNewSongOnly: false,
+      ffmpeg: { path: "ffmpeg", args: { global: {}, input: {}, output: {} } },
+    },
+    emit: vi.fn(),
+    debug: vi.fn(),
+    emitError: vi.fn(),
+    plugins: [plugin],
+    handler: {
+      _getPluginFromSong: vi.fn().mockResolvedValue(plugin),
+      attachStreamInfo: vi.fn().mockResolvedValue(undefined),
+    },
+    queues: {
+      playSong: vi.fn().mockResolvedValue(undefined),
+      remove: vi.fn(),
+    },
+    voices: {},
+    client: { user: { id: "bot-user" } },
+  };
+}
+
+function makeQueue(plugin = new RelatedPlugin(), id = GUILD_ID) {
+  const distube = makeMockDisTube(plugin);
+  return { distube, queue: new Queue(distube as any, createVoice(id)), plugin };
+}
+
+function makePublicDisTube(plugin = new RelatedPlugin()) {
+  const client = {
+    options: { intents: 128 },
+    user: { id: "bot-user" },
+    login: vi.fn(),
+  } as any;
+  return new DisTube(client, { plugins: [plugin] });
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+});
+
+async function expectDisTubeErrorCode(promise: Promise<unknown>, code: string) {
+  let error: unknown;
+  try {
+    await promise;
+  } catch (e) {
+    error = e;
+  }
+  expect(error).toBeInstanceOf(DisTubeError);
+  expect((error as DisTubeError).code).toBe(code);
+}
+
+describe("DisTube autoplay related queue acceptance", () => {
+  it("toggles queue autoplay and returns the new state each time", () => {
+
+
+    const { queue } = makeQueue();
+
+    expect(queue.autoplay).toBe(false);
+    expect(queue.toggleAutoplay()).toBe(true);
+    expect(queue.autoplay).toBe(true);
+    expect(queue.toggleAutoplay()).toBe(false);
+    expect(queue.autoplay).toBe(false);
+    expect(() => queue.remove()).not.toThrow();
+  });
+
+  it("delegates deprecated distube autoplay helpers to the guild queue", async () => {
+
+
+    const plugin = new RelatedPlugin();
+    const distube = makePublicDisTube(plugin);
+    const queue = new Queue(distube, createVoice());
+    const current = makeSong("facade-current", { plugin });
+    const related = makeSong("facade-related", { plugin });
+    queue.songs = [current];
+    plugin.relatedById.set("facade-current", [related]);
+    distube.queues.add(GUILD_ID, queue);
+
+    expect(queue.autoplay).toBe(false);
+    expect(distube.toggleAutoplay(GUILD_ID)).toBe(true);
+    expect(queue.autoplay).toBe(true);
+    expect(distube.toggleAutoplay(GUILD_ID)).toBe(false);
+    expect(queue.autoplay).toBe(false);
+
+    const added = await distube.addRelatedSong(GUILD_ID);
+    expect(added.id).toBe("facade-related");
+    expect(queue.songs.map(s => s.id)).toEqual(["facade-current", "facade-related"]);
+    expect(plugin.relatedCalls).toEqual(["facade-current"]);
+
+    expect(() => queue.remove()).not.toThrow();
+    expect(distube.queues.size).toBe(0);
+  });
+
+  it("exposes getRelatedSongs on plugins through the public Plugin inheritance chain", async () => {
+
+
+    const plugin = new RelatedPlugin();
+    plugin.relatedById.set("seed", [makeSong("from-class", { plugin })]);
+
+    expect(typeof plugin.getRelatedSongs).toBe("function");
+    expect((await plugin.getRelatedSongs(makeSong("seed", { plugin }))).map(s => s.id)).toEqual(["from-class"]);
+  });
+
+  it("adds a related song using the explicit Song argument even when the queue is empty", async () => {
+
+
+    const plugin = new RelatedPlugin();
+    const { queue } = makeQueue(plugin);
+    const provided = makeSong("provided", { plugin, metadata: { requestId: "meta-1" } });
+    const related = makeSong("related", { plugin });
+    queue.songs = [];
+    queue.previousSongs = [];
+    plugin.relatedById.set("provided", [related]);
+
+    const result = await queue.addRelatedSong(provided);
+
+    expect(result.id).toBe("related");
+    expect(queue.songs.map(s => s.id)).toEqual(["related"]);
+    expect(result.metadata).toEqual({ requestId: "meta-1" });
+    expect(result.member?.id).toBe(USER_ID);
+    expect(plugin.relatedCalls).toEqual(["provided"]);
+  });
+
+  it("adds a related song from queue.songs[0] when no Song argument is passed", async () => {
+
+
+    const plugin = new RelatedPlugin();
+    const { queue } = makeQueue(plugin);
+    const current = makeSong("current-source", { plugin, metadata: { source: "queue-head" } });
+    const related = makeSong("current-related", { plugin });
+    queue.songs = [current];
+    queue.previousSongs = [];
+    plugin.relatedById.set("current-source", [related]);
+
+    const result = await queue.addRelatedSong();
+
+    expect(result.id).toBe("current-related");
+    expect(queue.songs.map(s => s.id)).toEqual(["current-source", "current-related"]);
+    expect(result.metadata).toEqual({ source: "queue-head" });
+    expect(result.member?.id).toBe(USER_ID);
+    expect(plugin.relatedCalls).toEqual(["current-source"]);
+  });
+
+  it("rejects addRelatedSong on an empty queue with a NO_PLAYING_SONG DisTubeError", async () => {
+
+
+    const { queue } = makeQueue();
+    queue.songs = [];
+
+
+    await expectDisTubeErrorCode(queue.addRelatedSong(), "NO_PLAYING_SONG");
+  });
+
+  it("skips previous song ids and falls back from streamed/search result to its source song", async () => {
+
+
+    const plugin = new RelatedPlugin();
+    const { queue } = makeQueue(plugin);
+    const source = makeSong("underlying-source", { plugin });
+    const current = makeSong("current-streamed", {
+      plugin,
+      metadata: { source: "streamed" },
+      stream: { playFromSource: false, song: source },
+    });
+    const duplicate = makeSong("already-used", { plugin });
+    const fallback = makeSong("alt-related", { plugin });
+    queue.songs = [current];
+    queue.previousSongs = [{ id: "already-used" } as Song];
+    plugin.relatedById.set("current-streamed", [duplicate]);
+    plugin.relatedById.set("underlying-source", [fallback]);
+
+    const result = await queue.addRelatedSong();
+
+    expect(result.id).toBe("alt-related");
+    expect(queue.songs.map(s => s.id)).toEqual(["current-streamed", "alt-related"]);
+    expect(queue.previousSongs.map(s => s.id)).toEqual(["already-used"]);
+    expect(result.metadata).toEqual({ source: "streamed" });
+    expect(plugin.relatedCalls).toEqual(["current-streamed", "underlying-source"]);
+  });
+
+  it("rejects with NO_RELATED when all recommendations are unusable", async () => {
+
+
+    const plugin = new RelatedPlugin();
+    const { queue } = makeQueue(plugin);
+    queue.songs = [makeSong("current", { plugin })];
+    queue.previousSongs = [{ id: "dupe" } as Song];
+    plugin.relatedById.set("current", [makeSong("dupe", { plugin })]);
+
+
+    await expectDisTubeErrorCode(queue.addRelatedSong(), "NO_RELATED");
+    expect(queue.songs.map(s => s.id)).toEqual(["current"]);
+  });
+
+  it("autoplays a related song after natural finish of the last queued song", async () => {
+
+
+    const plugin = new RelatedPlugin();
+    const distube = makeMockDisTube(plugin);
+    const manager = new QueueManager(distube as any);
+    const queue = new Queue(distube as any, createVoice());
+    const last = makeSong("last", { plugin, metadata: { auto: true } });
+    const related = makeSong("auto-related", { plugin });
+    queue.songs = [last];
+    queue.previousSongs = [];
+    queue.autoplay = true;
+    vi.spyOn(manager, "playSong").mockResolvedValue(undefined);
+    plugin.relatedById.set("last", [related]);
+
+    await manager.handleSongFinish(queue);
+
+    expect(queue.songs.map(s => s.id)).toEqual(["auto-related"]);
+    expect(queue.stopped).toBe(false);
+    expect(plugin.relatedCalls).toEqual(["last"]);
+    expect(related.metadata).toEqual({ auto: true });
+    expect(manager.playSong).toHaveBeenCalledTimes(1);
+
+    expect(manager.playSong.mock.calls[0][0]).toBe(queue);
+    expect(distube.emit.mock.calls.map(call => call[0])).not.toContain(Events.FINISH);
+  });
+
+  it("emits noRelated, removes the queue, and suppresses finish when autoplay lookup fails", async () => {
+
+
+    const plugin = new RelatedPlugin();
+    const distube = makeMockDisTube(plugin);
+    const manager = new QueueManager(distube as any);
+    const queue = new Queue(distube as any, createVoice());
+    queue.songs = [makeSong("lonely", { plugin })];
+    queue.previousSongs = [];
+    queue.autoplay = true;
+    vi.spyOn(manager, "playSong").mockResolvedValue(undefined);
+
+    await manager.handleSongFinish(queue);
+
+
+    expect(distube.queues.remove).toHaveBeenCalledWith(queue.id);
+    expect(queue.stopped).toBe(true);
+
+    const noRelatedCalls = distube.emit.mock.calls.filter(call => call[0] === Events.NO_RELATED);
+    expect(noRelatedCalls).toHaveLength(1);
+    expect(noRelatedCalls[0][1]).toBe(queue);
+    expect(noRelatedCalls[0][2]).toBeInstanceOf(DisTubeError);
+    expect(noRelatedCalls[0][2].code).toBe("NO_RELATED");
+    expect(distube.emit).not.toHaveBeenCalledWith(Events.FINISH, queue);
+    expect(manager.playSong).toHaveBeenCalledTimes(0);
+  });
+
+  it("adds and advances to a related song when skip passes the last queued song", async () => {
+
+
+    const plugin = new RelatedPlugin();
+    const { queue } = makeQueue(plugin);
+    queue.songs = [makeSong("only", { plugin })];
+    queue.previousSongs = [];
+    queue.autoplay = true;
+    plugin.relatedById.set("only", [makeSong("skip-related", { plugin })]);
+
+    const result = await queue.skip();
+
+    expect(result.id).toBe("skip-related");
+    expect(queue.songs.map(s => s.id)).toEqual(["skip-related"]);
+
+    expect(queue.songs[0]).toBe(result);
+  });
+
+  it("adds and advances to a related song when jump passes the last queued song", async () => {
+
+
+    const plugin = new RelatedPlugin();
+    const { queue } = makeQueue(plugin);
+    queue.songs = [makeSong("j1", { plugin }), makeSong("j2", { plugin })];
+    queue.previousSongs = [];
+    queue.autoplay = true;
+    plugin.relatedById.set("j1", [makeSong("jump-related", { plugin })]);
+
+    const result = await queue.jump(2);
+
+    expect(result.id).toBe("jump-related");
+    expect(queue.songs.map(s => s.id)).toEqual(["jump-related"]);
+
+    expect(queue.songs[0]).toBe(result);
+  });
+
+  it("keeps autoplay and song state independent across queue instances", async () => {
+
+
+    const pluginA = new RelatedPlugin();
+    const pluginB = new RelatedPlugin();
+    const { queue: a } = makeQueue(pluginA, GUILD_ID);
+    const { queue: b } = makeQueue(pluginB, OTHER_GUILD_ID);
+    a.songs = [makeSong("a-current", { plugin: pluginA })];
+    b.songs = [makeSong("b-current", { plugin: pluginB })];
+    pluginA.relatedById.set("a-current", [makeSong("a-rel", { plugin: pluginA })]);
+
+    expect(a.toggleAutoplay()).toBe(true);
+    await a.addRelatedSong();
+
+    expect(a.autoplay).toBe(true);
+    expect(a.songs.map(s => s.id)).toEqual(["a-current", "a-rel"]);
+    expect(b.autoplay).toBe(false);
+    expect(b.songs.map(s => s.id)).toEqual(["b-current"]);
+    expect(pluginA.relatedCalls).toEqual(["a-current"]);
+    expect(pluginB.relatedCalls).toEqual([]);
+  });
+
+  it("removes the public queue when autoplay cannot find a related song", async () => {
+
+
+    const distube = makePublicDisTube();
+    vi.spyOn(distube, "emit");
+    const queue = new Queue(distube, createVoice());
+    queue.songs = [makeSong("cleanup", { plugin: distube.plugins[0] as RelatedPlugin })];
+    queue.autoplay = true;
+    distube.queues.add(GUILD_ID, queue);
+
+    await distube.queues.handleSongFinish(queue);
+
+
+    expect(distube.queues.size).toBe(0);
+    expect(queue.stopped).toBe(true);
+    expect(distube.emit).toHaveBeenCalledWith(Events.NO_RELATED, queue, expect.any(DisTubeError));
+    expect(distube.emit).not.toHaveBeenCalledWith(Events.FINISH, queue);
+  });
+
+  it("keeps autoplay failure cleanup independent across queue instances", async () => {
+
+
+    const distube = makePublicDisTube();
+    const failing = new Queue(distube, createVoice(GUILD_ID));
+    const other = new Queue(distube, createVoice(OTHER_GUILD_ID));
+    failing.songs = [makeSong("failing", { plugin: distube.plugins[0] as RelatedPlugin })];
+    failing.autoplay = true;
+    other.songs = [makeSong("other", { plugin: distube.plugins[0] as RelatedPlugin })];
+    distube.queues.add(GUILD_ID, failing);
+    distube.queues.add(OTHER_GUILD_ID, other);
+
+    await distube.queues.handleSongFinish(failing);
+
+
+    expect(distube.queues.has(GUILD_ID)).toBe(false);
+    expect(distube.queues.has(OTHER_GUILD_ID)).toBe(true);
+    expect(other.songs.map(s => s.id)).toEqual(["other"]);
+  });
+});
