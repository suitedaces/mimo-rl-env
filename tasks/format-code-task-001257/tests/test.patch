+#!/bin/bash
+set -uo pipefail
+cd /testbed
+unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
+
+set +u
+source /testbed/.build_env/.venv/bin/activate
+set -u
+
+case "${1:-}" in
+  base)
+    python3 -m pytest tests/test_ec2/test_ec2_cloudformation.py -x -v \
+      --deselect=tests/test_ec2/test_ec2_cloudformation.py::test_cloudformation_vpc_gateway_attachment_supports_vpn_gateway_ref \
+      --deselect=tests/test_ec2/test_ec2_cloudformation.py::test_cloudformation_vpc_gateway_attachment_still_supports_internet_gateway_ref \
+      --deselect=tests/test_ec2/test_ec2_cloudformation.py::test_cloudformation_creates_vpn_gateway_with_optional_asn
+    ;;
+  new)
+    python3 -m pytest -x -v \
+      tests/test_ec2/test_ec2_cloudformation.py::test_cloudformation_vpc_gateway_attachment_supports_vpn_gateway_ref \
+      tests/test_ec2/test_ec2_cloudformation.py::test_cloudformation_vpc_gateway_attachment_still_supports_internet_gateway_ref \
+      tests/test_ec2/test_ec2_cloudformation.py::test_cloudformation_creates_vpn_gateway_with_optional_asn
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
