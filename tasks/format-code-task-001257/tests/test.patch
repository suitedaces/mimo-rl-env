diff --git a/tests/test_ec2/test_ec2_cloudformation.py b/tests/test_ec2/test_ec2_cloudformation.py
index ddf26b528..53bb2ed05 100644
--- a/tests/test_ec2/test_ec2_cloudformation.py
+++ b/tests/test_ec2/test_ec2_cloudformation.py
@@ -215,6 +215,145 @@ def test_volume_size_through_cloudformation():
     volumes["Volumes"][0]["Size"].should.equal(50)
 
 
+def _physical_id_for_type(stack_resources, resource_type):
+    matches = [
+        resource
+        for resource in stack_resources
+        if resource["ResourceType"] == resource_type
+    ]
+    len(matches).should.equal(1)
+    physical_id = matches[0]["PhysicalResourceId"]
+    assert physical_id
+    return physical_id
+
+
+@mock_ec2
+@mock_cloudformation
+def test_cloudformation_vpc_gateway_attachment_supports_vpn_gateway_ref():
+    ec2 = boto3.client("ec2", region_name="us-east-1")
+    cf = boto3.client("cloudformation", region_name="us-east-1")
+
+    template = {
+        "AWSTemplateFormatVersion": "2010-09-09",
+        "Resources": {
+            "VpcForVpnAttachment": {
+                "Type": "AWS::EC2::VPC",
+                "Properties": {"CidrBlock": "10.22.0.0/16"},
+            },
+            "VpnGatewayFromCfn": {
+                "Type": "AWS::EC2::VPNGateway",
+                "Properties": {"Type": "ipsec.1"},
+            },
+            "AttachVpnGateway": {
+                "Type": "AWS::EC2::VPCGatewayAttachment",
+                "Properties": {
+                    "VpcId": {"Ref": "VpcForVpnAttachment"},
+                    "VpnGatewayId": {"Ref": "VpnGatewayFromCfn"},
+                },
+            },
+        },
+    }
+
+    stack_name = "vpn-gateway-attachment-{0}".format(str(uuid4())[0:8])
+    cf.create_stack(StackName=stack_name, TemplateBody=json.dumps(template))
+
+    stack_resources = cf.list_stack_resources(StackName=stack_name)[
+        "StackResourceSummaries"
+    ]
+    vpc_id = _physical_id_for_type(stack_resources, "AWS::EC2::VPC")
+    vpn_gateway_id = _physical_id_for_type(
+        stack_resources, "AWS::EC2::VPNGateway"
+    )
+
+    gateway = ec2.describe_vpn_gateways(VpnGatewayIds=[vpn_gateway_id])[
+        "VpnGateways"
+    ][0]
+    assert any(
+        attachment.get("VpcId") == vpc_id
+        for attachment in gateway.get("VpcAttachments", [])
+    )
+
+
+@mock_ec2
+@mock_cloudformation
+def test_cloudformation_vpc_gateway_attachment_still_supports_internet_gateway_ref():
+    ec2 = boto3.client("ec2", region_name="us-east-1")
+    cf = boto3.client("cloudformation", region_name="us-east-1")
+
+    template = {
+        "AWSTemplateFormatVersion": "2010-09-09",
+        "Resources": {
+            "VpcForInternetGatewayAttachment": {
+                "Type": "AWS::EC2::VPC",
+                "Properties": {"CidrBlock": "10.23.0.0/16"},
+            },
+            "InternetGatewayFromCfn": {"Type": "AWS::EC2::InternetGateway"},
+            "AttachInternetGateway": {
+                "Type": "AWS::EC2::VPCGatewayAttachment",
+                "Properties": {
+                    "VpcId": {"Ref": "VpcForInternetGatewayAttachment"},
+                    "InternetGatewayId": {"Ref": "InternetGatewayFromCfn"},
+                },
+            },
+        },
+    }
+
+    stack_name = "internet-gateway-attachment-{0}".format(str(uuid4())[0:8])
+    cf.create_stack(StackName=stack_name, TemplateBody=json.dumps(template))
+
+    stack_resources = cf.list_stack_resources(StackName=stack_name)[
+        "StackResourceSummaries"
+    ]
+    vpc_id = _physical_id_for_type(stack_resources, "AWS::EC2::VPC")
+    internet_gateway_id = _physical_id_for_type(
+        stack_resources, "AWS::EC2::InternetGateway"
+    )
+
+    gateway = ec2.describe_internet_gateways(
+        InternetGatewayIds=[internet_gateway_id]
+    )["InternetGateways"][0]
+    assert any(
+        attachment.get("VpcId") == vpc_id
+        for attachment in gateway.get("Attachments", [])
+    )
+
+
+@mock_ec2
+@mock_cloudformation
+def test_cloudformation_creates_vpn_gateway_with_optional_asn():
+    ec2 = boto3.client("ec2", region_name="us-east-1")
+    cf = boto3.client("cloudformation", region_name="us-east-1")
+
+    template = {
+        "AWSTemplateFormatVersion": "2010-09-09",
+        "Resources": {
+            "StandaloneVpnGateway": {
+                "Type": "AWS::EC2::VPNGateway",
+                "Properties": {
+                    "Type": "ipsec.1",
+                    "AmazonSideAsn": 64513,
+                },
+            },
+        },
+    }
+
+    stack_name = "standalone-vpn-gateway-{0}".format(str(uuid4())[0:8])
+    cf.create_stack(StackName=stack_name, TemplateBody=json.dumps(template))
+
+    stack_resources = cf.list_stack_resources(StackName=stack_name)[
+        "StackResourceSummaries"
+    ]
+    vpn_gateway_id = _physical_id_for_type(
+        stack_resources, "AWS::EC2::VPNGateway"
+    )
+
+    gateway = ec2.describe_vpn_gateways(VpnGatewayIds=[vpn_gateway_id])[
+        "VpnGateways"
+    ][0]
+    gateway["VpnGatewayId"].should.equal(vpn_gateway_id)
+    gateway["AmazonSideAsn"].should.equal(64513)
+
+
 # Has boto3 equivalent
 @mock_ec2_deprecated
 @mock_cloudformation_deprecated
