diff --git a/packages/jest-matcher-utils/src/__tests__/deepCyclicCopyReplaceable.test.ts b/packages/jest-matcher-utils/src/__tests__/deepCyclicCopyReplaceable.test.ts
index 6a017b6941..18b2d52095 100644
--- a/packages/jest-matcher-utils/src/__tests__/deepCyclicCopyReplaceable.test.ts
+++ b/packages/jest-matcher-utils/src/__tests__/deepCyclicCopyReplaceable.test.ts
@@ -139,3 +139,91 @@ test('should set writable, configurable to true', () => {
     key: {configurable: true, enumerable: true, value: 1, writable: true},
   });
 });
+
+test('does not throw when copying a class instance with a private field exposed via a prototype getter', () => {
+  class X {
+    #foo = 42;
+    get foo() {
+      return this.#foo;
+    }
+  }
+
+  const x = new X();
+  let copy: any;
+  expect(() => {
+    copy = deepCyclicCopyReplaceable(x);
+  }).not.toThrow();
+  expect(() => copy.foo).not.toThrow();
+  expect(copy.foo).toBe(42);
+});
+
+test('resolves prototype getter (private field backed) into an own data property on the copy', () => {
+  class X {
+    #foo = 42;
+    get foo() {
+      return this.#foo;
+    }
+  }
+
+  const x = new X();
+  const copy = deepCyclicCopyReplaceable(x) as any;
+
+  const fooDescriptor = Object.getOwnPropertyDescriptor(copy, 'foo');
+  expect(fooDescriptor).toBeDefined();
+  expect(fooDescriptor!.value).toBe(42);
+  expect(fooDescriptor!.writable).toBe(true);
+  expect(fooDescriptor!.configurable).toBe(true);
+
+  expect(fooDescriptor!.get).toBeUndefined();
+});
+
+test('handles subclass instances whose private field getter lives on a parent prototype', () => {
+  class Parent {
+    #foo = 7;
+    get foo() {
+      return this.#foo;
+    }
+  }
+  class Child extends Parent {
+    #bar = 99;
+    get bar() {
+      return this.#bar;
+    }
+  }
+
+  const c = new Child();
+  let copy: any;
+  expect(() => {
+    copy = deepCyclicCopyReplaceable(c);
+  }).not.toThrow();
+  expect(copy.foo).toBe(7);
+  expect(copy.bar).toBe(99);
+});
+
+test('class instance copy: foo is readable on the copy without invoking the original getter', () => {
+
+
+
+
+  let getCalls = 0;
+  class X {
+    #foo = 13;
+    get foo() {
+      getCalls++;
+      if (getCalls > 1) {
+        throw new Error('getter invoked more than once');
+      }
+      return this.#foo;
+    }
+  }
+
+  const x = new X();
+  const copy = deepCyclicCopyReplaceable(x) as any;
+
+
+  expect(copy.foo).toBe(13);
+  expect(copy.foo).toBe(13);
+  expect(copy.foo).toBe(13);
+
+  expect(getCalls).toBe(1);
+});
