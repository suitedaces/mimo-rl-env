diff --git a/test-data/unit/check-isinstance.test b/test-data/unit/check-isinstance.test
index 640fc1091..6add5e9f0 100644
--- a/test-data/unit/check-isinstance.test
+++ b/test-data/unit/check-isinstance.test
@@ -3006,3 +3006,70 @@ if isinstance(a, B):
     c = a
 
 [builtins fixtures/isinstance.pyi]
+
+[case testIsinstanceGenericClassWithSelfTypeOverloadFirst]
+# Regression: when the FIRST __init__ overload pins self to a concrete
+# parameterization (e.g. B[int]), `isinstance(other, B)` must not leak that
+# concrete parameterization into the narrowed type. The class is generic, so
+# narrowing must produce B[T] (preserving the union type variable) or B[Any].
+from typing import Generic, TypeVar, overload, Union
+
+T = TypeVar("T")
+
+class B(Generic[T]):
+    @overload
+    def __init__(self: "B[int]") -> None: ...
+    @overload
+    def __init__(self, x: T) -> None: ...
+    def __init__(self, x=None) -> None:
+        pass
+
+    def f(self, other: Union["B[T]", str]) -> None:
+        if isinstance(other, B):
+            reveal_type(other)  # N: Revealed type is "__main__.B[T`1]"
+        else:
+            reveal_type(other)  # N: Revealed type is "builtins.str"
+[builtins fixtures/isinstance.pyi]
+
+[case testIsinstanceGenericClassWithSelfTypeOverloadSecond]
+# Control: with self-type as the SECOND overload, behavior already works.
+# Keep this test to lock the symmetric case in.
+from typing import Generic, TypeVar, overload, Union
+
+T = TypeVar("T")
+
+class A(Generic[T]):
+    @overload
+    def __init__(self, x: T) -> None: ...
+    @overload
+    def __init__(self: "A[int]") -> None: ...
+    def __init__(self, x=None) -> None:
+        pass
+
+    def f(self, other: Union["A[T]", str]) -> None:
+        if isinstance(other, A):
+            reveal_type(other)  # N: Revealed type is "__main__.A[T`1]"
+        else:
+            reveal_type(other)  # N: Revealed type is "builtins.str"
+[builtins fixtures/isinstance.pyi]
+
+[case testIsinstanceGenericClassSelfTypeOverloadNarrowsToAny]
+# When narrowing from a non-generic context (object), isinstance(x, B)
+# should narrow to B[Any], not to the self-type's concrete parameterization
+# B[int].
+from typing import Generic, TypeVar, overload
+
+T = TypeVar("T")
+
+class B(Generic[T]):
+    @overload
+    def __init__(self: "B[int]") -> None: ...
+    @overload
+    def __init__(self, x: T) -> None: ...
+    def __init__(self, x=None) -> None:
+        pass
+
+def check(other: object) -> None:
+    if isinstance(other, B):
+        reveal_type(other)  # N: Revealed type is "__main__.B[Any]"
+[builtins fixtures/isinstance.pyi]
