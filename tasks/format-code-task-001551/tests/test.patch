diff --git a/usercase-test-coderl/set_selection_apply.test.js b/usercase-test-coderl/set_selection_apply.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/set_selection_apply.test.js
@@ -0,0 +1,246 @@
+const assert = require('assert')
+const { createEditor } = require('../packages/slate/src')
+
+
+
+
+
+
+
+
+
+const makeHelloEditor = () => {
+  const editor = createEditor()
+  editor.children = [{ type: 'paragraph', children: [{ text: 'hello' }] }]
+  return editor
+}
+
+describe('createEditor apply set_selection acceptance', () => {
+  it('sets a complete range from a null selection and clears pending marks', () => {
+
+
+    const editor = makeHelloEditor()
+    editor.marks = { bold: true, color: 'red' }
+
+    assert.strictEqual(editor.selection, null)
+    assert.deepStrictEqual(editor.children, [
+      { type: 'paragraph', children: [{ text: 'hello' }] },
+    ])
+
+    editor.apply({
+      type: 'set_selection',
+      properties: null,
+      newProperties: {
+        anchor: { path: [0, 0], offset: 0 },
+        focus: { path: [0, 0], offset: 5 },
+      },
+    })
+
+    assert.deepStrictEqual(editor.selection, {
+      anchor: { path: [0, 0], offset: 0 },
+      focus: { path: [0, 0], offset: 5 },
+    })
+    assert.strictEqual(editor.marks, null)
+  })
+
+  it('updates only focus on an existing selection while preserving custom properties', () => {
+
+
+    const editor = makeHelloEditor()
+    editor.selection = {
+      anchor: { path: [0, 0], offset: 0 },
+      focus: { path: [0, 0], offset: 5 },
+      note: 'draft',
+    }
+    editor.marks = { italic: true }
+
+    editor.apply({
+      type: 'set_selection',
+      properties: { focus: { path: [0, 0], offset: 5 } },
+      newProperties: { focus: { path: [0, 0], offset: 2 } },
+    })
+
+    assert.deepStrictEqual(editor.selection, {
+      anchor: { path: [0, 0], offset: 0 },
+      focus: { path: [0, 0], offset: 2 },
+      note: 'draft',
+    })
+    assert.strictEqual(editor.marks, null)
+  })
+
+  it('clears an existing complete selection to null and clears pending marks', () => {
+
+
+    const editor = makeHelloEditor()
+    editor.selection = {
+      anchor: { path: [0, 0], offset: 0 },
+      focus: { path: [0, 0], offset: 2 },
+    }
+    editor.marks = { underline: true }
+
+    editor.apply({
+      type: 'set_selection',
+      properties: {
+        anchor: { path: [0, 0], offset: 0 },
+        focus: { path: [0, 0], offset: 2 },
+      },
+      newProperties: null,
+    })
+
+    assert.strictEqual(editor.selection, null)
+    assert.strictEqual(editor.marks, null)
+  })
+
+  it('throws an Error for a partial selection when there is no current selection', () => {
+
+
+    const editor = makeHelloEditor()
+
+
+    assert.throws(
+      () =>
+        editor.apply({
+          type: 'set_selection',
+          properties: null,
+          newProperties: { focus: { path: [0, 0], offset: 2 } },
+        }),
+      err => err instanceof Error
+    )
+    assert.strictEqual(editor.selection, null)
+  })
+
+  it('throws Errors when a change removes anchor or focus from an existing selection', () => {
+
+
+    const anchorEditor = makeHelloEditor()
+    anchorEditor.selection = {
+      anchor: { path: [0, 0], offset: 0 },
+      focus: { path: [0, 0], offset: 5 },
+    }
+
+
+    assert.throws(
+      () =>
+        anchorEditor.apply({
+          type: 'set_selection',
+          properties: { anchor: { path: [0, 0], offset: 0 } },
+          newProperties: { anchor: null },
+        }),
+      err => err instanceof Error
+    )
+    assert.deepStrictEqual(anchorEditor.selection, {
+      anchor: { path: [0, 0], offset: 0 },
+      focus: { path: [0, 0], offset: 5 },
+    })
+
+    const focusEditor = makeHelloEditor()
+    focusEditor.selection = {
+      anchor: { path: [0, 0], offset: 0 },
+      focus: { path: [0, 0], offset: 5 },
+    }
+
+
+    assert.throws(
+      () =>
+        focusEditor.apply({
+          type: 'set_selection',
+          properties: { focus: { path: [0, 0], offset: 5 } },
+          newProperties: { focus: null },
+        }),
+      err => err instanceof Error
+    )
+    assert.deepStrictEqual(focusEditor.selection, {
+      anchor: { path: [0, 0], offset: 0 },
+      focus: { path: [0, 0], offset: 5 },
+    })
+  })
+
+  it('clears repeated complete selections back to null', () => {
+
+
+    const editor = makeHelloEditor()
+    editor.selection = {
+      anchor: { path: [0, 0], offset: 0 },
+      focus: { path: [0, 0], offset: 5 },
+    }
+
+    const clearSelection = {
+      type: 'set_selection',
+      properties: {
+        anchor: { path: [0, 0], offset: 0 },
+        focus: { path: [0, 0], offset: 5 },
+      },
+      newProperties: null,
+    }
+
+    editor.apply(clearSelection)
+    assert.strictEqual(editor.selection, null)
+
+
+    editor.selection = {
+      anchor: { path: [0, 0], offset: 0 },
+      focus: { path: [0, 0], offset: 5 },
+    }
+    editor.apply(clearSelection)
+    assert.strictEqual(editor.selection, null)
+  })
+
+  it('keeps two editor instances independent when one retained selection changes', () => {
+
+
+    const a = makeHelloEditor()
+    const b = makeHelloEditor()
+
+    a.apply({
+      type: 'set_selection',
+      properties: null,
+      newProperties: {
+        anchor: { path: [0, 0], offset: 0 },
+        focus: { path: [0, 0], offset: 5 },
+      },
+    })
+
+    assert.deepStrictEqual(a.selection, {
+      anchor: { path: [0, 0], offset: 0 },
+      focus: { path: [0, 0], offset: 5 },
+    })
+    assert.strictEqual(b.selection, null)
+    assert.deepStrictEqual(b.children, [
+      { type: 'paragraph', children: [{ text: 'hello' }] },
+    ])
+  })
+
+  it('keeps repeated construct apply clear cycles bounded to final literal state', () => {
+
+
+    for (let i = 0; i < 125; i++) {
+      const editor = makeHelloEditor()
+      editor.marks = { bold: true }
+
+      editor.apply({
+        type: 'set_selection',
+        properties: null,
+        newProperties: {
+          anchor: { path: [0, 0], offset: 0 },
+          focus: { path: [0, 0], offset: 5 },
+        },
+      })
+      assert.deepStrictEqual(editor.selection, {
+        anchor: { path: [0, 0], offset: 0 },
+        focus: { path: [0, 0], offset: 5 },
+      })
+      assert.strictEqual(editor.marks, null)
+
+      editor.apply({
+        type: 'set_selection',
+        properties: {
+          anchor: { path: [0, 0], offset: 0 },
+          focus: { path: [0, 0], offset: 5 },
+        },
+        newProperties: null,
+      })
+      assert.strictEqual(editor.selection, null)
+      assert.strictEqual(editor.marks, null)
+    }
+  })
+})
