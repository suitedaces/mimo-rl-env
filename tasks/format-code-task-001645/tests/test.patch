+from unit.script.conftest import single_variable_output
+
+
+class TestStringEscapeNewline:
+    def test_split_by_newline_two_lines(self):
+
+        output = single_variable_output("{%split('line1\\nline2', '\\n')}")
+        assert output == ["line1", "line2"]
+
+    def test_split_by_newline_three_lines(self):
+        output = single_variable_output("{%split('a\\nb\\nc', '\\n')}")
+        assert output == ["a", "b", "c"]
+
+    def test_array_at_first_line_after_split(self):
+
+        output = single_variable_output(
+            "{%array_at(%split('first line\\nsecond line\\nthird line', '\\n'), 0)}"
+        )
+        assert output == "first line"
+
+    def test_array_at_last_line_after_split(self):
+        output = single_variable_output(
+            "{%array_at(%split('first line\\nsecond line\\nthird line', '\\n'), 2)}"
+        )
+        assert output == "third line"
+
+    def test_standalone_newline_literal_produces_newline(self):
+
+        output = single_variable_output("{%string('\\n')}")
+        assert output == "\n"
+        assert len(output) == 1
+
+    def test_newline_embedded_in_string(self):
+
+        output = single_variable_output("{%string('hello\\nworld')}")
+        assert output == "hello\nworld"
+        assert len(output) == 11
+
+    def test_concat_with_newline_separator(self):
+
+        output = single_variable_output("{%concat('a', '\\n', 'b')}")
+        assert output == "a\nb"
+        assert "\n" in output
+
+
+class TestStringEscapeTab:
+    def test_standalone_tab_literal_produces_tab(self):
+        output = single_variable_output("{%string('\\t')}")
+        assert output == "\t"
+        assert len(output) == 1
+
+    def test_split_by_tab(self):
+        output = single_variable_output("{%split('col1\\tcol2\\tcol3', '\\t')}")
+        assert output == ["col1", "col2", "col3"]
+
+
+class TestStringPreservation:
+    def test_plain_string_unchanged(self):
+
+        output = single_variable_output("{%string('hello world')}")
+        assert output == "hello world"
+
+    def test_string_with_no_escape_chars(self):
+        output = single_variable_output("{%split('a|b|c', '|')}")
+        assert output == ["a", "b", "c"]
+
+
+class TestSplitRealNewlines:
+
+
+
+    def test_split_real_newlines_with_escape_sep(self):
+
+        real_nl = chr(10)
+        script = "{%split('first" + real_nl + "second" + real_nl + "third', '\\n')}"
+        output = single_variable_output(script)
+        assert output == ["first", "second", "third"]
+
+    def test_first_line_of_real_newline_text(self):
+        real_nl = chr(10)
+        script = (
+            "{%array_at(%split('header line" + real_nl + "rest of body" + real_nl
+            + "more text', '\\n'), 0)}"
+        )
+        output = single_variable_output(script)
+        assert output == "header line"
