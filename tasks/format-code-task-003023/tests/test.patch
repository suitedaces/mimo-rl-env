+def test_combines_source_and_explicit_datasets_dedupes_and_forwards_options(monkeypatch):
+
+
+
+
+    _patch_source_lookup(monkeypatch, {"src-a": ["kb2", "kb3"]})
+    calls = _patch_retrieve(
+        monkeypatch,
+        {
+            "format records": {
+                "records": [
+                    {"content": "年假为 10 天", "chunk_type": "qa"},
+                    {"content": "订单表包含金额字段", "chunk_type": "chunk"},
+                ]
+            }
+        },
+    )
+
+    actual = agent_tools.search_knowledge_base(
+        "format records",
+        source_id="src-a",
+        dataset_ids=["kb1", "kb2", "kb1"],
+        tenant_id=7,
+        top_k=9,
+        retrieval_type="keyword",
+        rerank=True,
+    )
+
+    assert actual == "[1] (QA) 年假为 10 天\n\n[2] (片段) 订单表包含金额字段"
+    assert calls == [
+        {
+            "tenant_id": 7,
+            "query": "format records",
+            "dataset_ids": ["kb1", "kb2", "kb3"],
+            "k": 9,
+            "retrieval_type": "keyword",
+            "rerank": True,
+        }
+    ]
