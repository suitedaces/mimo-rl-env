+import copy
+import json
+import os
+import subprocess
+import sys
+import textwrap
+import types
+
+import pytest
+
+
+def _install_import_stubs() -> None:
+    sys.path.insert(0, "/workspace/repo/api")
+
+    sqlalchemy = types.ModuleType("sqlalchemy")
+
+    class FakeSelect:
+        def __init__(self, *columns):
+            self.columns = columns
+            self.conditions = []
+
+        def where(self, *args, **kwargs):
+            self.conditions.extend(args)
+            return self
+
+    sqlalchemy.select = lambda *args, **kwargs: FakeSelect(*args)
+    sys.modules["sqlalchemy"] = sqlalchemy
+
+    common = types.ModuleType("common")
+    context = types.ModuleType("common.context")
+
+    class FakeRequestContext:
+        @staticmethod
+        def get_effective_tenant_id():
+            return "tenant-from-context"
+
+    context.RequestContext = FakeRequestContext
+    sys.modules["common"] = common
+    sys.modules["common.context"] = context
+
+    rag_do = types.ModuleType("module_rag.entity.do.rag_do")
+
+    class FakeColumn:
+        def __init__(self, name):
+            self.name = name
+
+        def __eq__(self, other):
+            return ("eq", self.name, other)
+
+    class FakeRagDataset:
+        id = FakeColumn("id")
+        source_id = FakeColumn("source_id")
+
+    rag_do.RagDataset = FakeRagDataset
+    sys.modules.setdefault("module_rag.entity", types.ModuleType("module_rag.entity"))
+    sys.modules.setdefault("module_rag.entity.do", types.ModuleType("module_rag.entity.do"))
+    sys.modules["module_rag.entity.do.rag_do"] = rag_do
+
+    retrieval = types.ModuleType("module_rag.retrieval")
+    retrieval.retrieve = lambda *args, **kwargs: (_ for _ in ()).throw(AssertionError("retrieve not patched"))
+    sys.modules["module_rag.retrieval"] = retrieval
+
+    sync_db = types.ModuleType("module_task_schedule.sync_db")
+    sync_db.get_sync_session_local = lambda: (_ for _ in ()).throw(AssertionError("db not patched"))
+    sys.modules.setdefault("module_task_schedule", types.ModuleType("module_task_schedule"))
+    sys.modules["module_task_schedule.sync_db"] = sync_db
+
+
+_install_import_stubs()
+from module_rag import agent_tools
+
+
+def _patch_source_lookup(monkeypatch, source_map=None):
+    source_map = source_map or {}
+
+    class FakeScalarResult:
+        def __init__(self, rows):
+            self._rows = rows
+
+        def all(self):
+            return list(self._rows)
+
+    class FakeExecuteResult:
+        def __init__(self, rows):
+            self._rows = rows
+
+        def scalars(self):
+            return FakeScalarResult(self._rows)
+
+    class FakeSession:
+        def execute(self, statement):
+            source_id = None
+            for condition in getattr(statement, "conditions", []):
+                if isinstance(condition, tuple) and condition[:2] == ("eq", "source_id"):
+                    source_id = condition[2]
+            return FakeExecuteResult(source_map.get(source_id, []))
+
+        def close(self):
+            pass
+
+    def fake_get_sync_session_local():
+        return lambda: FakeSession()
+
+
+    monkeypatch.setattr(agent_tools, "get_sync_session_local", fake_get_sync_session_local, raising=False)
+    monkeypatch.setattr(sys.modules["module_task_schedule.sync_db"], "get_sync_session_local", fake_get_sync_session_local)
+
+
+def _patch_retrieve(monkeypatch, responses):
+    calls = []
+
+    def fake_retrieve(tenant_id, query, dataset_ids, *, k=5, retrieval_type="hybrid", rerank=False, **kwargs):
+        calls.append(
+            {
+                "tenant_id": tenant_id,
+                "query": query,
+                "dataset_ids": list(dataset_ids),
+                "k": k,
+                "retrieval_type": retrieval_type,
+                "rerank": rerank,
+            }
+        )
+        return copy.deepcopy(responses[query])
+
+
+    monkeypatch.setattr(sys.modules["module_rag.retrieval"], "retrieve", fake_retrieve)
+    monkeypatch.setattr(agent_tools, "retrieve", fake_retrieve, raising=False)
+    return calls
+
+
+def test_returns_exact_message_when_no_datasets_are_available(monkeypatch):
+
+
+
+
+    _patch_source_lookup(monkeypatch)
+
+    actual = agent_tools.search_knowledge_base("anything")
+
+    assert actual == "未找到可用知识库。"
+
+
+def test_source_id_with_no_attached_datasets_returns_no_available_message(monkeypatch):
