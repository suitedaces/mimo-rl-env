+def test_same_input_matches_fresh_python_process(monkeypatch):
+    _patch_source_lookup(monkeypatch)
+    _patch_retrieve(
+        monkeypatch,
+        {"state query": {"records": [{"content": "状态稳定", "chunk_type": "qa"}]}},
+    )
+    in_process = agent_tools.search_knowledge_base("state query", dataset_ids=["kb-state"], tenant_id=9)
+
+    script = r'''
+import copy, json, sys, types
+sys.path.insert(0, "/workspace/repo/api")
+sqlalchemy = types.ModuleType("sqlalchemy")
+class FakeSelect:
+    def where(self, *args, **kwargs):
+        return self
+sqlalchemy.select = lambda *args, **kwargs: FakeSelect()
+sys.modules["sqlalchemy"] = sqlalchemy
+common = types.ModuleType("common")
+context = types.ModuleType("common.context")
+class FakeRequestContext:
+    @staticmethod
+    def get_effective_tenant_id():
+        return "tenant-from-context"
+context.RequestContext = FakeRequestContext
+sys.modules["common"] = common
+sys.modules["common.context"] = context
+rag_do = types.ModuleType("module_rag.entity.do.rag_do")
+class FakeColumn:
+    def __eq__(self, other):
+        return ("eq", other)
+class FakeRagDataset:
+    id = FakeColumn()
+    source_id = FakeColumn()
+rag_do.RagDataset = FakeRagDataset
+sys.modules.setdefault("module_rag.entity", types.ModuleType("module_rag.entity"))
+sys.modules.setdefault("module_rag.entity.do", types.ModuleType("module_rag.entity.do"))
+sys.modules["module_rag.entity.do.rag_do"] = rag_do
+retrieval = types.ModuleType("module_rag.retrieval")
+retrieval.retrieve = lambda *args, **kwargs: (_ for _ in ()).throw(AssertionError("retrieve not patched"))
+sys.modules["module_rag.retrieval"] = retrieval
+sync_db = types.ModuleType("module_task_schedule.sync_db")
+sync_db.get_sync_session_local = lambda: (_ for _ in ()).throw(AssertionError("db not patched"))
+sys.modules.setdefault("module_task_schedule", types.ModuleType("module_task_schedule"))
+sys.modules["module_task_schedule.sync_db"] = sync_db
+from module_rag import agent_tools
+def fake_retrieve(tenant_id, query, dataset_ids, *, k=5, retrieval_type="hybrid", rerank=False, **kwargs):
+    return {"records": [{"content": "状态稳定", "chunk_type": "qa"}]}
+#
+sys.modules["module_rag.retrieval"].retrieve = fake_retrieve
+agent_tools.retrieve = fake_retrieve
+print(json.dumps(agent_tools.search_knowledge_base("state query", dataset_ids=["kb-state"], tenant_id=9), ensure_ascii=False))
+'''
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    fresh_process = json.loads(completed.stdout)
+
+    assert in_process == "[1] (QA) 状态稳定"
+    assert fresh_process == "[1] (QA) 状态稳定"
+    assert in_process == fresh_process
+
+
