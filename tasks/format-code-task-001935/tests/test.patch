diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,129 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+( cd /workspace/repo && make build ) \
+    || { echo "FAIL: build" >&2; exit 1; }
+BIN=/workspace/repo/build/bin/csvq
+
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+REPO="$TMP/data"
+mkdir -p "$REPO"
+cd "$TMP" || exit 1
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+assert_file_eq() {
+    label=$1
+    file=$2
+    expected=$3
+    actual=$(cat "$file")
+    [ "$actual" = "$expected" ] || fail "$label: $actual"
+}
+
+assert_empty_file() {
+    label=$1
+    file=$2
+    [ ! -s "$file" ] || fail "$label: $(cat "$file")"
+}
+
+assert_file_contains() {
+    label=$1
+    file=$2
+    needle=$3
+    actual=$(cat "$file")
+    case "$actual" in
+        *"$needle"*) ;;
+        *) fail "$label: expected to contain [$needle], got [$actual]" ;;
+    esac
+}
+
+printf 'name:Alice\tage:30\nname:Bob\tage:41\n' > "$REPO/people.ltsv"
+printf 'f1:value1\tf2:value2\tf3:value3\nf1:value4\tf2:value5\tf4:value6\n' > "$REPO/table6.ltsv"
+printf 'name:' > "$REPO/sjis.ltsv"
+printf '\x93\x8c\x8b\x9e' >> "$REPO/sjis.ltsv"
+printf '\tage:40\n' >> "$REPO/sjis.ltsv"
+
+
+
+
+"$BIN" --format CSV --repository "$REPO" \
+    "select name, age from ltsv(people)" >out 2>err; ec=$?
+EXPECTED='name,age
+Alice,30
+Bob,41'
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_file_eq "F1 stdout" out "$EXPECTED"
+assert_empty_file "F1 stderr" err
+
+
+
+
+"$BIN" --format CSV --repository "$REPO" \
+    "select f1, f2, f3 is null as f3_null, f3 = '' as f3_empty, f4 is null as f4_null, f4 = '' as f4_empty from ltsv(table6)" >out 2>err; ec=$?
+EXPECTED='f1,f2,f3_null,f3_empty,f4_null,f4_empty
+value1,value2,false,false,true,
+value4,value5,true,,false,false'
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_file_eq "F2 stdout" out "$EXPECTED"
+assert_empty_file "F2 stderr" err
+
+
+
+
+"$BIN" --format CSV --repository "$REPO" \
+    "select f1, f2, f3 is null as f3_null, f3 = '' as f3_empty, f4 is null as f4_null, f4 = '' as f4_empty from ltsv(table6, 'utf8', true)" >out 2>err; ec=$?
+EXPECTED='f1,f2,f3_null,f3_empty,f4_null,f4_empty
+value1,value2,false,false,false,true
+value4,value5,false,true,false,false'
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+assert_file_eq "F3 stdout" out "$EXPECTED"
+assert_empty_file "F3 stderr" err
+
+
+
+
+"$BIN" --format CSV --repository "$REPO" \
+    "select name, age from ltsv(sjis, 'sjis')" >out 2>err; ec=$?
+EXPECTED_HEX='6e616d652c6167650ae69db1e4baac2c34300a'
+ACTUAL_HEX=$(od -An -tx1 -v out | tr -d ' \n')
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+[ "$ACTUAL_HEX" = "$EXPECTED_HEX" ] || fail "F4 stdout hex: $ACTUAL_HEX"
+assert_empty_file "F4 stderr" err
+
+
+
+
+"$BIN" --format CSV --import-format LTSV --repository "$REPO" \
+    "select name from people" >out 2>err; ec=$?
+EXPECTED='name
+Alice
+Bob'
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+assert_file_eq "F5 stdout" out "$EXPECTED"
+assert_empty_file "F5 stderr" err
+
+
+
+
+"$BIN" --format CSV --repository "$REPO" \
+    "select name from ltsv(people, 'utf8', true, false)" >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F6 exit $ec; want non-zero"
+assert_file_eq "F6 stdout" out ''
+
+assert_file_contains "F6 stderr mentions ltsv" err 'ltsv'
+assert_file_contains "F6 stderr mentions arguments" err 'arguments'
+
+
+
+
+"$BIN" --format CSV --import-format LTSV --repository "$REPO" \
+    "select name from ghost" >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F7 exit $ec; want non-zero"
+assert_file_eq "F7 stdout" out ''
+
+assert_file_contains "F7 stderr mentions ghost" err 'ghost'
+assert_file_contains "F7 stderr mentions file" err 'file'
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+export GOPROXY=off
+export GOSUMDB=off
+export GOTOOLCHAIN=local
+export GOFLAGS="${GOFLAGS:-} -mod=readonly"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
