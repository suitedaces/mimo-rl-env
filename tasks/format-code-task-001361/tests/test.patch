+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+
+
+set -euo pipefail
+
+cd /workspace/repo
+
+export GOPROXY=off
+export GOSUMDB=off
+export GOTOOLCHAIN=local
+export PATH="/root/go/pkg/mod/golang.org/toolchain@v0.0.1-go1.24.0.linux-amd64/bin:/root/go/bin:${PATH}"
+command -v protoc >/dev/null
+command -v protoc-gen-go >/dev/null
+test "$(go env GOVERSION)" = "go1.24.0"
+make proto >/dev/null
+
+exec go test -v -count=1 ./usercase-test-coderl/...
