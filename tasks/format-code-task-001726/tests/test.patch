+package virtualmachines
+
+import (
+	"testing"
+
+	"github.com/Azure/azure-sdk-for-go/services/compute/mgmt/2021-11-01/compute"
+	"github.com/Azure/go-autorest/autorest/to"
+	. "github.com/onsi/gomega"
+	infrav1 "sigs.k8s.io/cluster-api-provider-azure/api/v1beta1"
+)
+
+func TestParametersSpotEphemeralOSDisk(t *testing.T) {
+	g := NewWithT(t)
+
+	spec := &VMSpec{
+		Name:       "my-vm",
+		Role:       infrav1.Node,
+		NICIDs:     []string{"my-nic"},
+		SSHKeyData: "fakesshpublickey",
+		Size:       "Standard_D2v3",
+		Zone:       "1",
+		Image:      &infrav1.Image{ID: to.StringPtr("fake-image-id")},
+		OSDisk: infrav1.OSDisk{
+			OSType:     "Linux",
+			DiskSizeGB: to.Int32Ptr(128),
+			ManagedDisk: &infrav1.ManagedDiskParameters{
+				StorageAccountType: "Premium_LRS",
+			},
+			DiffDiskSettings: &infrav1.DiffDiskSettings{
+				Option: string(compute.DiffDiskOptionsLocal),
+			},
+		},
+		SpotVMOptions: &infrav1.SpotVMOptions{},
+		SKU:           validSKUWithEphemeralOS,
+	}
+
+	result, err := spec.Parameters(nil)
+	g.Expect(err).NotTo(HaveOccurred())
+	g.Expect(result).To(BeAssignableToTypeOf(compute.VirtualMachine{}))
+	vm := result.(compute.VirtualMachine)
+	g.Expect(vm.Priority).To(Equal(compute.VirtualMachinePriorityTypesSpot))
+	g.Expect(vm.EvictionPolicy).To(Equal(compute.VirtualMachineEvictionPolicyTypesDelete))
+	g.Expect(vm.StorageProfile.OsDisk.DiffDiskSettings.Option).To(Equal(compute.DiffDiskOptionsLocal))
+}
+
+func TestParametersSpotNoEphemeralOSDisk(t *testing.T) {
+	g := NewWithT(t)
+
+	spec := &VMSpec{
+		Name:          "my-vm",
+		Role:          infrav1.Node,
+		NICIDs:        []string{"my-nic"},
+		SSHKeyData:    "fakesshpublickey",
+		Size:          "Standard_D2v3",
+		Zone:          "1",
+		Image:         &infrav1.Image{ID: to.StringPtr("fake-image-id")},
+		SpotVMOptions: &infrav1.SpotVMOptions{},
+		SKU:           validSKU,
+	}
+
+	result, err := spec.Parameters(nil)
+	g.Expect(err).NotTo(HaveOccurred())
+	g.Expect(result).To(BeAssignableToTypeOf(compute.VirtualMachine{}))
+	vm := result.(compute.VirtualMachine)
+	g.Expect(vm.Priority).To(Equal(compute.VirtualMachinePriorityTypesSpot))
+	g.Expect(vm.EvictionPolicy).To(Equal(compute.VirtualMachineEvictionPolicyTypesDeallocate))
+}
+
+func TestParametersEphemeralOSDiskNoSpot(t *testing.T) {
+	g := NewWithT(t)
+
+	spec := &VMSpec{
+		Name:       "my-vm",
+		Role:       infrav1.Node,
+		NICIDs:     []string{"my-nic"},
+		SSHKeyData: "fakesshpublickey",
+		Size:       "Standard_D2v3",
+		Zone:       "1",
+		Image:      &infrav1.Image{ID: to.StringPtr("fake-image-id")},
+		OSDisk: infrav1.OSDisk{
+			OSType:     "Linux",
+			DiskSizeGB: to.Int32Ptr(128),
+			ManagedDisk: &infrav1.ManagedDiskParameters{
+				StorageAccountType: "Premium_LRS",
+			},
+			DiffDiskSettings: &infrav1.DiffDiskSettings{
+				Option: string(compute.DiffDiskOptionsLocal),
+			},
+		},
+		SKU: validSKUWithEphemeralOS,
+	}
+
+	result, err := spec.Parameters(nil)
+	g.Expect(err).NotTo(HaveOccurred())
+	g.Expect(result).To(BeAssignableToTypeOf(compute.VirtualMachine{}))
+	vm := result.(compute.VirtualMachine)
+	g.Expect(vm.Priority).To(BeEmpty())
+	g.Expect(vm.EvictionPolicy).To(BeEmpty())
+	g.Expect(vm.StorageProfile.OsDisk.DiffDiskSettings.Option).To(Equal(compute.DiffDiskOptionsLocal))
+}
