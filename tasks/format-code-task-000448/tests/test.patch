+func TestReconcileArgoCD_reconcileTLSCerts_preservesGuiAddedCert(t *testing.T) {
+	logf.SetLogger(ZapLogger(true))
+
+
+	a := makeTestArgoCD(initialCerts(t, "root-ca.example.com"))
+	r := makeTestReconciler(t, a)
+
+
+
+	existingCM := &corev1.ConfigMap{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      common.ArgoCDTLSCertsConfigMapName,
+			Namespace: a.Namespace,
+		},
+		Data: map[string]string{
+			"gui-added.example.com": "GUI_ADDED_CERT_PEM",
+		},
+	}
+	assert.NoError(t, r.Client.Create(context.TODO(), existingCM))
+
+	assert.NoError(t, r.reconcileTLSCerts(a))
+
+	configMap := &corev1.ConfigMap{}
+	assert.NoError(t, r.Client.Get(
+		context.TODO(),
+		types.NamespacedName{
+			Name:      common.ArgoCDTLSCertsConfigMapName,
+			Namespace: a.Namespace,
+		},
+		configMap))
+
+
+
+
+	wantKeys := []string{"gui-added.example.com"}
+	if k := stringMapKeys(configMap.Data); !reflect.DeepEqual(wantKeys, k) {
+		t.Fatalf("got keys %#v, want %#v\n", k, wantKeys)
+	}
+	if got := configMap.Data["gui-added.example.com"]; got != "GUI_ADDED_CERT_PEM" {
+		t.Fatalf("user-added cert value got %q, want %q", got, "GUI_ADDED_CERT_PEM")
+	}
+	if _, present := configMap.Data["root-ca.example.com"]; present {
+		t.Fatalf("ConfigMap was overwritten: spec.tls.initialCerts entry %q must not have been added", "root-ca.example.com")
+	}
+}
