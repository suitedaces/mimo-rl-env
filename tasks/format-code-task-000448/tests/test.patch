+func TestReconcileArgoCD_reconcileTLSCerts_createsWhenMissing(t *testing.T) {
+	logf.SetLogger(ZapLogger(true))
+	a := makeTestArgoCD(initialCerts(t, "first-create.example.com"))
+	r := makeTestReconciler(t, a)
+
+	assert.NoError(t, r.reconcileTLSCerts(a))
+
+	configMap := &corev1.ConfigMap{}
+	assert.NoError(t, r.Client.Get(
+		context.TODO(),
+		types.NamespacedName{
+			Name:      common.ArgoCDTLSCertsConfigMapName,
+			Namespace: a.Namespace,
+		},
+		configMap))
+
+	want := []string{"first-create.example.com"}
+	if k := stringMapKeys(configMap.Data); !reflect.DeepEqual(want, k) {
+		t.Fatalf("got %#v, want %#v\n", k, want)
+	}
+}
