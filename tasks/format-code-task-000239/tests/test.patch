@@ -0,0 +1,106 @@
+
+
+
+
+
+
+
+
+
+
+
+
+import os
+import sys
+
+import numpy as np
+import pytest
+from numpy.testing import assert_allclose
+
+
+
+_LOCAL_SRC = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "src"))
+if os.path.isdir(_LOCAL_SRC) and _LOCAL_SRC not in sys.path:
+    sys.path.insert(0, _LOCAL_SRC)
+
+from SALib.analyze import fast
+from SALib.sample import fast_sampler
+from SALib.test_functions import Ishigami
+from SALib.util import read_param_file
+
+
+PARAM_FILE = "src/SALib/test_functions/params/Ishigami.txt"
+
+
+def _run_analyze(N, seed=100):
+    problem = read_param_file(PARAM_FILE)
+    param_values = fast_sampler.sample(problem, N=N, seed=seed)
+    Y = Ishigami.evaluate(param_values)
+    return fast.analyze(problem, Y, seed=seed)
+
+
+def test_analyze_does_not_crash_for_odd_N_4935():
+
+    Si = _run_analyze(N=4935)
+
+
+    for key in ("S1", "ST", "S1_conf", "ST_conf"):
+        assert key in Si, f"missing key {key!r} in result"
+        assert len(Si[key]) == 3, f"expected 3 values for {key}, got {len(Si[key])}"
+
+
+def test_analyze_confidence_intervals_are_finite_and_positive_for_N_4935():
+
+    Si = _run_analyze(N=4935)
+
+    for key in ("S1_conf", "ST_conf"):
+        vals = np.asarray(Si[key], dtype=float)
+        assert np.all(np.isfinite(vals)), f"{key} contains non-finite values: {vals}"
+        assert np.all(vals > 0.0), f"{key} contains non-positive values: {vals}"
+
+
+def test_analyze_first_and_total_order_indices_for_N_4935():
+
+    Si = _run_analyze(N=4935)
+
+    assert_allclose(Si["S1"], [0.31, 0.44, 0.00], atol=5e-2, rtol=1e-1)
+    assert_allclose(Si["ST"], [0.55, 0.44, 0.24], atol=5e-2, rtol=1e-1)
+
+
+def test_analyze_confidence_intervals_reasonable_magnitude_for_N_4935():
+
+
+
+
+
+
+
+    Si = _run_analyze(N=4935)
+
+    s1_conf = np.asarray(Si["S1_conf"], dtype=float)
+    st_conf = np.asarray(Si["ST_conf"], dtype=float)
+
+
+
+
+    assert np.all(s1_conf >= 0.0023), (
+        f"S1_conf magnitudes are too small (likely bootstrap normalisation bug): "
+        f"{s1_conf}"
+    )
+    assert np.all(st_conf >= 0.014), (
+        f"ST_conf magnitudes are too small (likely bootstrap normalisation bug): "
+        f"{st_conf}"
+    )
+
+
+def test_analyze_even_N_still_works():
+
+    Si = _run_analyze(N=10000)
+
+    assert_allclose(Si["S1"], [0.31, 0.44, 0.00], atol=5e-2, rtol=1e-1)
+    assert_allclose(Si["ST"], [0.55, 0.44, 0.24], atol=5e-2, rtol=1e-1)
+
+    for key in ("S1_conf", "ST_conf"):
+        vals = np.asarray(Si[key], dtype=float)
+        assert np.all(np.isfinite(vals))
+        assert np.all(vals > 0.0)
