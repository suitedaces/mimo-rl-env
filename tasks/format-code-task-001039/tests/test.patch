diff --git a/pkg/apis/kops/channel_resolution_contract_test.go b/pkg/apis/kops/channel_resolution_contract_test.go
new file mode 100644
index 0000000000..b33e6d47c4
--- /dev/null
+++ b/pkg/apis/kops/channel_resolution_contract_test.go
@@ -0,0 +1,123 @@
+package kops
+
+import (
+	"testing"
+
+	"github.com/blang/semver"
+)
+
+func TestFindImageUsesSpecificRuleAndDeclarationTieBreak(t *testing.T) {
+	version := semver.MustParse("1.21.0")
+	channel := &Channel{Spec: ChannelSpec{Images: []*ChannelImageSpec{
+		{ProviderID: string(CloudProviderAWS), Name: "fallback-first"},
+		{ProviderID: string(CloudProviderAWS), Name: "specific-old", KubernetesVersion: ">=1.20.0"},
+		{ProviderID: string(CloudProviderAWS), Name: "specific-new", KubernetesVersion: ">=1.18.0"},
+		{ProviderID: string(CloudProviderAWS), Name: "fallback-last"},
+	}}}
+
+	image := channel.FindImage(CloudProviderAWS, version)
+	if image == nil || image.Name != "specific-new" {
+		t.Fatalf("FindImage selected %v, want the later matching ranged rule", image)
+	}
+}
+
+func TestFindImageUsesLaterFallbackWhenNoRangeMatches(t *testing.T) {
+	channel := &Channel{Spec: ChannelSpec{Images: []*ChannelImageSpec{
+		{ProviderID: string(CloudProviderAWS), Name: "fallback-old"},
+		{ProviderID: string(CloudProviderAWS), Name: "future", KubernetesVersion: ">=2.0.0"},
+		{ProviderID: string(CloudProviderAWS), Name: "fallback-new"},
+	}}}
+	image := channel.FindImage(CloudProviderAWS, semver.MustParse("1.21.0"))
+	if image == nil || image.Name != "fallback-new" {
+		t.Fatalf("FindImage selected %v, want later fallback rule", image)
+	}
+}
+
+func TestFindImageRetainsProviderFiltering(t *testing.T) {
+	channel := &Channel{Spec: ChannelSpec{Images: []*ChannelImageSpec{
+		{ProviderID: string(CloudProviderAWS), Name: "aws"},
+		{ProviderID: string(CloudProviderGCE), Name: "gce", KubernetesVersion: ">=1.0.0"},
+	}}}
+	image := channel.FindImage(CloudProviderGCE, semver.MustParse("1.21.0"))
+	if image == nil || image.Name != "gce" {
+		t.Fatalf("FindImage selected %v, want the matching provider rule", image)
+	}
+}
+
+func TestFindImageSkipsMalformedRules(t *testing.T) {
+	channel := &Channel{Spec: ChannelSpec{Images: []*ChannelImageSpec{
+		{ProviderID: string(CloudProviderAWS), Name: "bad", KubernetesVersion: "not a range"},
+	}}}
+	if image := channel.FindImage(CloudProviderAWS, semver.MustParse("1.21.0")); image != nil {
+		t.Fatalf("FindImage returned malformed rule %v", image)
+	}
+}
+
+func TestFindImageSkipsNilRules(t *testing.T) {
+	channel := &Channel{Spec: ChannelSpec{Images: []*ChannelImageSpec{nil}}}
+	if image := channel.FindImage(CloudProviderAWS, semver.MustParse("1.21.0")); image != nil {
+		t.Fatalf("FindImage returned nil rule as %v", image)
+	}
+}
+
+func TestFindKopsVersionSpecPrecedence(t *testing.T) {
+	version := semver.MustParse("1.5.2")
+	versions := []KopsVersionSpec{
+		{RecommendedVersion: "fallback-first"},
+		{Range: ">=1.0.0", RecommendedVersion: "ranged-old"},
+		{Range: ">=1.5.0", RecommendedVersion: "ranged-new"},
+		{RecommendedVersion: "fallback-last"},
+		{Range: "[invalid", RecommendedVersion: "invalid"},
+	}
+
+	got := FindKopsVersionSpec(versions, version)
+	if got == nil || got.RecommendedVersion != "ranged-new" {
+		t.Fatalf("FindKopsVersionSpec selected %#v, want later matching ranged rule", got)
+	}
+}
+
+func TestFindKopsVersionSpecFallbackAndNoMatch(t *testing.T) {
+	version := semver.MustParse("1.5.2")
+	fallbacks := []KopsVersionSpec{
+		{RecommendedVersion: "fallback-old"},
+		{Range: ">=2.0.0", RecommendedVersion: "future"},
+		{RecommendedVersion: "fallback-new"},
+	}
+	if got := FindKopsVersionSpec(fallbacks, version); got == nil || got.RecommendedVersion != "fallback-new" {
+		t.Fatalf("FindKopsVersionSpec selected %#v, want later fallback rule", got)
+	}
+	if got := FindKopsVersionSpec([]KopsVersionSpec{{Range: "[invalid"}}, version); got != nil {
+		t.Fatalf("FindKopsVersionSpec returned invalid-only match %#v", got)
+	}
+}
+
+func TestFindKubernetesVersionSpecPrecedenceAndFallback(t *testing.T) {
+	versions := []KubernetesVersionSpec{
+		{Range: "[invalid", RecommendedVersion: "invalid"},
+		{RecommendedVersion: "fallback"},
+		{Range: ">=1.20.0", RecommendedVersion: "specific"},
+	}
+
+	got := FindKubernetesVersionSpec(versions, semver.MustParse("1.21.0"))
+	if got == nil || got.RecommendedVersion != "specific" {
+		t.Fatalf("FindKubernetesVersionSpec selected %#v, want ranged rule", got)
+	}
+
+	if got := FindKubernetesVersionSpec(versions, semver.MustParse("1.19.0")); got == nil || got.RecommendedVersion != "fallback" {
+		t.Fatalf("FindKubernetesVersionSpec selected %#v, want fallback rule", got)
+	}
+}
+
+func TestFindKubernetesVersionSpecReturnsNilForInvalidOnlyRules(t *testing.T) {
+	fallbacks := []KubernetesVersionSpec{
+		{RecommendedVersion: "fallback-old"},
+		{Range: ">=2.0.0", RecommendedVersion: "future"},
+		{RecommendedVersion: "fallback-new"},
+	}
+	if got := FindKubernetesVersionSpec(fallbacks, semver.MustParse("1.21.0")); got == nil || got.RecommendedVersion != "fallback-new" {
+		t.Fatalf("FindKubernetesVersionSpec selected %#v, want later fallback rule", got)
+	}
+	if got := FindKubernetesVersionSpec([]KubernetesVersionSpec{{Range: "[invalid"}}, semver.MustParse("1.21.0")); got != nil {
+		t.Fatalf("FindKubernetesVersionSpec returned invalid-only match %#v", got)
+	}
+}
