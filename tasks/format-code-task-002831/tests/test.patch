diff --git a/tests/issues/protocol-retained.test.js b/tests/issues/protocol-retained.test.js
new file mode 100644
index 0000000..7077396
--- /dev/null
+++ b/tests/issues/protocol-retained.test.js
@@ -0,0 +1,66 @@
+import test from 'ava';
+import io from '../../src/socket-io';
+import Server from '../../src/server';
+
+test('io.connect retains a string protocol on the socket instance', t => {
+  const socketUrl = 'ws://localhost:8080';
+  const mockServer = new Server(socketUrl);
+  const socket = io.connect(socketUrl, 'custom protocol');
+
+  t.is(socket.protocol, 'custom protocol');
+  mockServer.close();
+});
+
+test('io(url, protocol) retains a string protocol on the socket instance', t => {
+  const socketUrl = 'ws://localhost:8081';
+  const mockServer = new Server(socketUrl);
+  const socket = io(socketUrl, 'custom protocol');
+
+  t.is(socket.protocol, 'custom protocol');
+  mockServer.close();
+});
+
+test.cb('server connection handler sees the protocol on the connected client instance', t => {
+  const socketUrl = 'ws://localhost:8082';
+  const mockServer = new Server(socketUrl);
+
+  mockServer.on('connection', (server, clientInstance) => {
+    t.is(clientInstance.protocol, 'custom protocol');
+    mockServer.close();
+    t.end();
+  });
+
+  io.connect(socketUrl, 'custom protocol');
+});
+
+test.cb('server connection handler sees protocol when using io() directly', t => {
+  const socketUrl = 'ws://localhost:8083';
+  const mockServer = new Server(socketUrl);
+
+  mockServer.on('connection', (server, clientInstance) => {
+    t.is(clientInstance.protocol, 'another protocol');
+    mockServer.close();
+    t.end();
+  });
+
+  io(socketUrl, 'another protocol');
+});
+
+test('io.connect retains an object protocol on the socket instance', t => {
+  const socketUrl = 'ws://localhost:8084';
+  const mockServer = new Server(socketUrl);
+  const protocolObj = { a: 'apple' };
+  const socket = io.connect(socketUrl, protocolObj);
+
+  t.deepEqual(socket.protocol, { a: 'apple' });
+  mockServer.close();
+});
+
+test('io.connect without protocol defaults to empty string', t => {
+  const socketUrl = 'ws://localhost:8085';
+  const mockServer = new Server(socketUrl);
+  const socket = io.connect(socketUrl);
+
+  t.is(socket.protocol, '');
+  mockServer.close();
+});
