+package org.apache.druid.metadata;
+
+import com.fasterxml.jackson.annotation.JsonCreator;
+import com.fasterxml.jackson.annotation.JsonProperty;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.databind.jsontype.NamedType;
+import org.apache.druid.utils.DynamicConfigProviderUtils;
+import org.junit.Assert;
+import org.junit.Test;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+public class CompositeDynamicConfigProviderCodespecTest
+{
+  private static final String DEFAULT_COMPOSITE_JSON =
+      "{\"type\":\"composite\",\"providers\":["
+      + "{\"type\":\"mapString\",\"config\":{\"first\":\"one\",\"shared\":\"early\",\"same\":\"stable\"}},"
+      + "{\"type\":\"mapString\",\"config\":{\"second\":\"two\",\"shared\":\"late\",\"same\":\"stable\"}}]}";
+
+  private final ObjectMapper mapper = makeMapper();
+
+  @Test
+  public void testDefaultLastWins()
+  {
+    DynamicConfigProvider<String> provider = readComposite(DEFAULT_COMPOSITE_JSON);
+
+    Map<String, String> expected = new HashMap<>();
+    expected.put("first", "one");
+    expected.put("second", "two");
+    expected.put("shared", "late");
+    expected.put("same", "stable");
+    Assert.assertEquals(expected, provider.getConfig());
+
+  }
+
+  @Test
+  public void testJsonRoundTrip()
+  {
+    DynamicConfigProvider<String> provider = readComposite(
+        "{\"type\":\"composite\",\"providers\":["
+        + "{\"type\":\"mapString\",\"config\":{\"roundTrip\":\"yes\"}}]}"
+    );
+    try {
+      String serialized = mapper.writeValueAsString(provider);
+      Assert.assertTrue("serialized provider must retain its type", serialized.contains("\"type\":\"composite\""));
+      Assert.assertEquals("yes", readComposite(serialized).getConfig().get("roundTrip"));
+    }
+    catch (Exception e) {
+      throw new AssertionError("composite provider should round-trip through DynamicConfigProvider JSON", e);
+    }
+  }
+
+  @Test
+  public void testExplicitFirstWinsPolicy()
+  {
+    DynamicConfigProvider<String> provider = readComposite(
+        "{\"type\":\"composite\",\"mergePolicy\":\"firstWins\",\"providers\":["
+        + "{\"type\":\"mapString\",\"config\":{\"shared\":\"early\",\"left\":\"L\"}},"
+        + "{\"type\":\"mapString\",\"config\":{\"shared\":\"late\",\"right\":\"R\"}}]}"
+    );
+
+    Assert.assertEquals("early", provider.getConfig().get("shared"));
+    Assert.assertEquals("L", provider.getConfig().get("left"));
+    Assert.assertEquals("R", provider.getConfig().get("right"));
+  }
+
+  @Test
+  public void testFailOnConflictAllowsIdenticalValues()
+  {
+    DynamicConfigProvider<String> identical = readComposite(
+        "{\"type\":\"composite\",\"mergePolicy\":\"failOnConflict\",\"providers\":["
+        + "{\"type\":\"mapString\",\"config\":{\"shared\":\"same\"}},"
+        + "{\"type\":\"mapString\",\"config\":{\"shared\":\"same\",\"other\":\"ok\"}}]}"
+    );
+    Assert.assertEquals("same", identical.getConfig().get("shared"));
+    Assert.assertEquals("ok", identical.getConfig().get("other"));
+  }
+
+  @Test
+  public void testFailOnConflictReportsDifferentValues()
+  {
+    DynamicConfigProvider<String> conflicting = readComposite(
+        "{\"type\":\"composite\",\"mergePolicy\":\"failOnConflict\",\"providers\":["
+        + "{\"type\":\"mapString\",\"config\":{\"shared\":\"early\"}},"
+        + "{\"type\":\"mapString\",\"config\":{\"shared\":\"late\"}}]}"
+    );
+    IllegalArgumentException exception = Assert.assertThrows(
+        IllegalArgumentException.class,
+        conflicting::getConfig
+    );
+    Assert.assertTrue(exception.getMessage().contains("shared"));
+  }
+
+  @Test
+  public void testNullValuesAreOmissionsForAllPolicies()
+  {
+    DynamicConfigProvider<String> provider = readComposite(
+        "{\"type\":\"composite\",\"mergePolicy\":\"failOnConflict\",\"providers\":["
+        + "{\"type\":\"codespecScripted\",\"snapshots\":[{\"kept\":\"first\",\"filled\":null,\"nullOnly\":null}]},"
+        + "{\"type\":\"codespecScripted\",\"snapshots\":[{\"kept\":null,\"filled\":\"second\"}]}]}"
+    );
+
+    Map<String, String> resolved = provider.getConfig();
+    Assert.assertEquals("first", resolved.get("kept"));
+    Assert.assertEquals("second", resolved.get("filled"));
+    Assert.assertFalse(resolved.containsKey("nullOnly"));
+  }
+
+  @Test
+  public void testRequiredKeysMayBeSuppliedByDifferentProviders()
+  {
+    DynamicConfigProvider<String> complete = readComposite(
+        "{\"type\":\"composite\",\"requiredKeys\":[\"user\",\"password\"],\"providers\":["
+        + "{\"type\":\"mapString\",\"config\":{\"user\":\"druid\"}},"
+        + "{\"type\":\"mapString\",\"config\":{\"password\":\"secret\"}}]}"
+    );
+    Assert.assertEquals(2, complete.getConfig().size());
+  }
+
+  @Test
+  public void testRequiredKeysRejectMissingOrNullValues()
+  {
+    DynamicConfigProvider<String> incomplete = readComposite(
+        "{\"type\":\"composite\",\"requiredKeys\":[\"user\",\"password\"],\"providers\":["
+        + "{\"type\":\"codespecScripted\",\"snapshots\":[{\"user\":\"druid\",\"password\":null}]}]}"
+    );
+    IllegalArgumentException exception = Assert.assertThrows(
+        IllegalArgumentException.class,
+        incomplete::getConfig
+    );
+    Assert.assertTrue(exception.getMessage().contains("password"));
+  }
+
+  @Test
+  public void testProvidersAreReevaluatedForEveryResolution()
+  {
+    DynamicConfigProvider<String> provider = readComposite(
+        "{\"type\":\"composite\",\"providers\":[{\"type\":\"codespecScripted\",\"snapshots\":["
+        + "{\"rotating\":\"v1\"},{\"rotating\":\"v2\"}]}]}"
+    );
+
+    Assert.assertEquals("v1", provider.getConfig().get("rotating"));
+    Assert.assertEquals("v2", provider.getConfig().get("rotating"));
+  }
+
+  @Test
+  public void testChildFailurePropagatesUnchanged()
+  {
+    DynamicConfigProvider<String> provider = readComposite(
+        "{\"type\":\"composite\",\"providers\":["
+        + "{\"type\":\"codespecScripted\",\"snapshots\":[{\"first\":\"v1\"},{\"first\":\"v2\"}]},"
+        + "{\"type\":\"codespecScripted\",\"failures\":1,\"snapshots\":[{\"second\":\"ready\"}]}]}"
+    );
+
+    IllegalStateException exception = Assert.assertThrows(IllegalStateException.class, provider::getConfig);
+    Assert.assertEquals("scripted failure", exception.getMessage());
+  }
+
+  @Test
+  public void testChildFailureDoesNotCachePartialResult()
+  {
+    DynamicConfigProvider<String> provider = readComposite(
+        "{\"type\":\"composite\",\"providers\":["
+        + "{\"type\":\"codespecScripted\",\"snapshots\":[{\"first\":\"v1\"},{\"first\":\"v2\"}]},"
+        + "{\"type\":\"codespecScripted\",\"failures\":1,\"snapshots\":[{\"second\":\"ready\"}]}]}"
+    );
+    try {
+      provider.getConfig();
+    }
+    catch (RuntimeException ignored) {
+
+    }
+
+    Map<String, String> recovered = provider.getConfig();
+    Assert.assertEquals("v2", recovered.get("first"));
+    Assert.assertEquals("ready", recovered.get("second"));
+  }
+
+  @Test
+  public void testStringMergeUtilityResolvesCompositeProvider()
+  {
+    final String providerKey = "druid.dynamic.config.provider";
+    Map<String, Object> config = makeUtilityConfig(providerKey);
+    try {
+      Map<String, String> strings = DynamicConfigProviderUtils.extraConfigAndSetStringMap(config, providerKey, mapper);
+      Assert.assertEquals("7", strings.get("plain"));
+      Assert.assertEquals("late", strings.get("shared"));
+      Assert.assertFalse(strings.containsKey(providerKey));
+    }
+    catch (RuntimeException e) {
+      throw new AssertionError("string dynamic config merge utility should resolve a composite provider", e);
+    }
+  }
+
+  @Test
+  public void testObjectMergeUtilityResolvesCompositeProvider()
+  {
+    final String providerKey = "druid.dynamic.config.provider";
+    Map<String, Object> config = makeUtilityConfig(providerKey);
+    try {
+      Map<String, Object> objects = DynamicConfigProviderUtils.extraConfigAndSetObjectMap(config, providerKey, mapper);
+      Assert.assertEquals(Integer.valueOf(7), objects.get("plain"));
+      Assert.assertEquals("late", objects.get("shared"));
+      Assert.assertFalse(objects.containsKey(providerKey));
+    }
+    catch (RuntimeException e) {
+      throw new AssertionError("object dynamic config merge utility should resolve a composite provider", e);
+    }
+  }
+
+  private Map<String, Object> makeUtilityConfig(String providerKey)
+  {
+    Map<String, Object> config = new LinkedHashMap<>();
+    config.put("plain", 7);
+    config.put("shared", "static");
+    try {
+      config.put(providerKey, mapper.readValue(DEFAULT_COMPOSITE_JSON, Map.class));
+      return config;
+    }
+    catch (Exception e) {
+      throw new AssertionError("test JSON should parse", e);
+    }
+  }
+
+  @SuppressWarnings("unchecked")
+  private DynamicConfigProvider<String> readComposite(String json)
+  {
+    try {
+      return (DynamicConfigProvider<String>) mapper.readValue(json, DynamicConfigProvider.class);
+    }
+    catch (Exception e) {
+      throw new AssertionError("composite DynamicConfigProvider JSON should deserialize", e);
+    }
+  }
+
+  private static ObjectMapper makeMapper()
+  {
+    ObjectMapper mapper = new ObjectMapper();
+    mapper.registerSubtypes(new NamedType(ScriptedDynamicConfigProvider.class, "codespecScripted"));
+    return mapper;
+  }
+
+  public static class ScriptedDynamicConfigProvider implements DynamicConfigProvider<String>
+  {
+    private final List<Map<String, String>> snapshots;
+    private final int failures;
+    private int calls;
+
+    @JsonCreator
+    public ScriptedDynamicConfigProvider(
+        @JsonProperty("snapshots") List<Map<String, String>> snapshots,
+        @JsonProperty("failures") Integer failures
+    )
+    {
+      this.snapshots = snapshots;
+      this.failures = failures == null ? 0 : failures;
+    }
+
+    @JsonProperty
+    public List<Map<String, String>> getSnapshots()
+    {
+      return snapshots;
+    }
+
+    @JsonProperty
+    public int getFailures()
+    {
+      return failures;
+    }
+
+    @Override
+    public Map<String, String> getConfig()
+    {
+      int currentCall = calls++;
+      if (currentCall < failures) {
+        throw new IllegalStateException("scripted failure");
+      }
+      if (snapshots.isEmpty()) {
+        return Collections.emptyMap();
+      }
+      return snapshots.get(Math.min(currentCall - failures, snapshots.size() - 1));
+    }
+  }
+}
