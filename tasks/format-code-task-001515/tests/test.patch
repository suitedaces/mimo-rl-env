diff --git a/src/client/utils.test.ts b/src/client/utils.test.ts
index baaa82d2..00a5df98 100644
--- a/src/client/utils.test.ts
+++ b/src/client/utils.test.ts
@@ -46,6 +46,76 @@ describe('replaceUrlParams', () => {
     const replacedUrl = replaceUrlParam(url, params)
     expect(replacedUrl).toBe('http://localhost/year/2024/month/2')
   })
+
+  it('Should replace optional path parameter when value is provided', () => {
+    const url = 'http://localhost/something/:firstId/:secondId/:version?'
+    const params = {
+      firstId: 'first',
+      secondId: 'second',
+      version: 'v1',
+    }
+    const replacedUrl = replaceUrlParam(url, params)
+    expect(replacedUrl).toBe('http://localhost/something/first/second/v1')
+  })
+
+  it('Should remove optional path parameter when value is undefined', () => {
+    const url = 'http://localhost/something/:firstId/:secondId/:version?'
+    const params = {
+      firstId: 'first',
+      secondId: 'second',
+      version: undefined,
+    }
+    const replacedUrl = replaceUrlParam(url, params as Record<string, string>)
+    expect(replacedUrl).toBe('http://localhost/something/first/second')
+  })
+
+  it('Should remove optional path parameter when value is null', () => {
+    const url = 'http://localhost/something/:firstId/:secondId/:version?'
+    const params = {
+      firstId: 'first',
+      secondId: 'second',
+      version: null,
+    }
+    const replacedUrl = replaceUrlParam(url, params as unknown as Record<string, string>)
+    expect(replacedUrl).toBe('http://localhost/something/first/second')
+  })
+
+  it('Should replace optional path parameter with regex pattern when value is provided', () => {
+    const url = 'http://localhost/posts/:id{[0-9]+}?'
+    const params = {
+      id: '42',
+    }
+    const replacedUrl = replaceUrlParam(url, params)
+    expect(replacedUrl).toBe('http://localhost/posts/42')
+  })
+
+  it('Should remove optional path parameter with regex pattern when value is undefined', () => {
+    const url = 'http://localhost/posts/:id{[0-9]+}?'
+    const params = {
+      id: undefined,
+    }
+    const replacedUrl = replaceUrlParam(url, params as Record<string, string>)
+    expect(replacedUrl).toBe('http://localhost/posts')
+  })
+
+  it('Should not insert literal "undefined" or "null" when optional value is missing', () => {
+    const url = 'http://localhost/something/:firstId/:secondId/:version?'
+    const undefinedResult = replaceUrlParam(url, {
+      firstId: 'first',
+      secondId: 'second',
+      version: undefined,
+    } as Record<string, string>)
+    expect(undefinedResult).not.toContain('undefined')
+    expect(undefinedResult).not.toContain(':version')
+
+    const nullResult = replaceUrlParam(url, {
+      firstId: 'first',
+      secondId: 'second',
+      version: null,
+    } as unknown as Record<string, string>)
+    expect(nullResult).not.toContain('null')
+    expect(nullResult).not.toContain(':version')
+  })
 })
 
