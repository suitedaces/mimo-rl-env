diff --git a/test/src/build_parts.spec.js b/test/src/build_parts.spec.js
index dafd428..5b3cf45 100644
--- a/test/src/build_parts.spec.js
+++ b/test/src/build_parts.spec.js
@@ -72,4 +72,30 @@ describe('The function buildParts', () => {
     it('should return an object with a property `script`', () => {
         expect(parts).to.have.property('script');
     });
+
+    it('should produce syntactically valid JavaScript when previewVariables is undefined', () => {
+        const script = buildParts({ id: 'GTM-asd123' }).script;
+        expect(() => new Function(script)).to.not.throw();
+    });
+
+    it('should produce syntactically valid JavaScript when previewVariables is defined', () => {
+        const script = buildParts({
+            id: 'GTM-asd123',
+            previewVariables: '&gtm_auth=EXAMPLE&gtm_preview=env-14&gtm_cookies_win=x'
+        }).script;
+        expect(() => new Function(script)).to.not.throw();
+    });
+
+    it('should not produce a broken `+;` concatenation when previewVariables is undefined', () => {
+        const script = buildParts({ id: 'GTM-asd123' }).script;
+        expect(script).to.not.match(/\+\s*;/);
+    });
+
+    it('should still include the previewVariables value within the generated script', () => {
+        const script = buildParts({
+            id: 'GTM-asd123',
+            previewVariables: '&gtm_auth=EXAMPLE&gtm_preview=env-14&gtm_cookies_win=x'
+        }).script;
+        expect(script).to.have.entriesCount('&gtm_auth=EXAMPLE&gtm_preview=env-14&gtm_cookies_win=x', 1);
+    });
 });
