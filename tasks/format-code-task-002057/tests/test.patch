+import { mockServer, MockServer } from '@nocobase/test';
+import { IncomingMessage } from 'http';
+import * as url from 'url';
+import supertest from 'supertest';
+
+describe('app manager', () => {
+  let app: MockServer;
+
+  beforeEach(() => {
+    app = mockServer();
+  });
+
+  afterEach(async () => {
+    await app.destroy();
+  });
+
+  const defineTestResource = (target: any, body: string) => {
+    target.resourcer.define({
+      name: 'test',
+      actions: {
+        async test(ctx) {
+          ctx.body = body;
+        },
+      },
+    });
+  };
+
+  it('should expose an app manager on the application', () => {
+    expect(app.appManager).toBeDefined();
+    expect(app.appManager.applications).toBeInstanceOf(Map);
+  });
+
+  it('should register a created application and return it', () => {
+    const subApp = app.appManager.createApplication('sub1', {
+      database: app.db,
+    });
+
+    expect(subApp).toBeDefined();
+    expect(app.appManager.applications.get('sub1')).toBe(subApp);
+  });
+
+  it('getApplication resolves a registered application and undefined otherwise', async () => {
+    const subApp = app.appManager.createApplication('sub1', {
+      database: app.db,
+    });
+
+    expect(await app.appManager.getApplication('sub1')).toBe(subApp);
+    expect(await app.appManager.getApplication('does-not-exist')).toBeUndefined();
+  });
+
+  it('removeApplication removes a registered application; unknown name is a no-op', async () => {
+    app.appManager.createApplication('sub1', {
+      database: app.db,
+    });
+
+    expect(app.appManager.applications.has('sub1')).toBeTruthy();
+
+    await app.appManager.removeApplication('sub1');
+    expect(app.appManager.applications.has('sub1')).toBeFalsy();
+
+    await expect(app.appManager.removeApplication('never-registered')).resolves.not.toThrow();
+  });
+
+  it('routes requests to the main app by default', async () => {
+    defineTestResource(app, 'main');
+
+    const response = await supertest(app.appManager.callback()).get('/test:test');
+
+    expect(response.statusCode).toEqual(200);
+    expect(response.body.data).toEqual('main');
+  });
+
+  it('routes requests to the application chosen by the selector', async () => {
+    const subApp1 = app.appManager.createApplication('sub1', { database: app.db });
+    defineTestResource(subApp1, 'sub1');
+
+    const subApp2 = app.appManager.createApplication('sub2', { database: app.db });
+    defineTestResource(subApp2, 'sub2');
+
+
+    let response = await supertest(app.appManager.callback()).get('/test:test');
+    expect(response.statusCode).toEqual(404);
+
+    app.appManager.setAppSelector((req: IncomingMessage) => {
+      const queryObject = url.parse(req.url, true).query;
+      return queryObject['app'] as string;
+    });
+
+    response = await supertest(app.appManager.callback()).get('/test:test?app=sub1');
+    expect(response.statusCode).toEqual(200);
+    expect(response.body.data).toEqual('sub1');
+
+    response = await supertest(app.appManager.callback()).get('/test:test?app=sub2');
+    expect(response.statusCode).toEqual(200);
+    expect(response.body.data).toEqual('sub2');
+  });
+
+  it('falls back to the main app when the selected name has no registered application', async () => {
+    defineTestResource(app, 'main');
+    app.appManager.setAppSelector(() => 'missing');
+
+    const response = await supertest(app.appManager.callback()).get('/test:test');
+
+    expect(response.statusCode).toEqual(200);
+    expect(response.body.data).toEqual('main');
+  });
+
+  it('emits beforeGetApplication on every routed lookup', async () => {
+    const beforeGetApplicationFn = jest.fn();
+    app.appManager.on('beforeGetApplication', beforeGetApplicationFn);
+
+    app.appManager.createApplication('sub1', { database: app.db });
+    app.appManager.setAppSelector(() => 'sub1');
+
+    await supertest(app.appManager.callback()).get('/test:test');
+    await supertest(app.appManager.callback()).get('/test:test');
+
+    expect(beforeGetApplicationFn).toHaveBeenCalledTimes(2);
+  });
+
+  it('allows a beforeGetApplication listener to lazily register the application', async () => {
+    app.appManager.setAppSelector(() => 'lazy');
+
+    app.appManager.on('beforeGetApplication', async ({ appManager, name }) => {
+      if (!appManager.applications.has(name)) {
+        const lazyApp = appManager.createApplication(name, { database: app.db });
+        defineTestResource(lazyApp, 'lazy');
+      }
+    });
+
+    expect(app.appManager.applications.has('lazy')).toBeFalsy();
+
+    const response = await supertest(app.appManager.callback()).get('/test:test');
+
+    expect(response.statusCode).toEqual(200);
+    expect(response.body.data).toEqual('lazy');
+    expect(app.appManager.applications.has('lazy')).toBeTruthy();
+  });
+
+  it('stops every registered application when the main app stops', async () => {
+    const subApp = app.appManager.createApplication('sub1', { database: app.db });
+    const stopFn = jest.fn();
+    subApp.on('afterStop', stopFn);
+
+    await app.stop();
+
+    expect(stopFn).toHaveBeenCalledTimes(1);
+  });
+
+  it('destroys every registered application when the main app is destroyed', async () => {
+    const subApp = app.appManager.createApplication('sub1', { database: app.db });
+    const destroyFn = jest.fn();
+    subApp.on('afterDestroy', destroyFn);
+
+    await app.destroy();
+
+    expect(destroyFn).toHaveBeenCalledTimes(1);
+  });
+});
