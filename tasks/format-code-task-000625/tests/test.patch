+# -*- coding: utf-8 -*-
+
+
+
+import json
+import requests
+from unittest import mock
+
+from apprise import Apprise
+from apprise.plugins.NotifyPagerTree import NotifyPagerTree
+from helpers import AppriseURLTester
+
+
+import logging
+logging.disable(logging.CRITICAL)
+
+
+def _posted_body(call):
+
+
+
+
+    kwargs = call[1]
+    if 'json' in kwargs and kwargs['json'] is not None:
+        return kwargs['json']
+    return json.loads(kwargs['data'])
+
+
+
+apprise_url_tests = (
+    ('pagertree://', {
+
+        'instance': TypeError,
+    }),
+    ('pagertree://%20', {
+
+        'instance': TypeError,
+    }),
+    ('pagertree://int_123', {
+
+        'instance': TypeError,
+    }),
+    ('pagertree://int_012345678901234567890', {
+
+        'instance': TypeError,
+    }),
+    ('pagertree://int_1234567', {
+
+        'instance': NotifyPagerTree,
+    }),
+    ('pagertree://int_123456789?thirdparty=', {
+
+        'instance': NotifyPagerTree,
+    }),
+    ('pagertree://int_123456789?action=invalid', {
+
+        'instance': NotifyPagerTree,
+    }),
+    ('pagertree://int_123456789?action=resolve&thirdparty=abc123', {
+
+        'instance': NotifyPagerTree,
+    }),
+    ('pagertree://int_123456789?urgency=critical&tags=a,b,c', {
+
+        'instance': NotifyPagerTree,
+    }),
+    ('pagertree://int_123456789?urgency=bogus', {
+
+        'instance': NotifyPagerTree,
+    }),
+    ('pagertree://int_123456789?+x-token=abc&:server=blue&-incident=true', {
+
+        'instance': NotifyPagerTree,
+    }),
+    ('pagertree://int_123456789', {
+        'instance': NotifyPagerTree,
+
+        'response': False,
+        'requests_response_code': requests.codes.internal_server_error,
+    }),
+    ('pagertree://int_123456789', {
+        'instance': NotifyPagerTree,
+
+        'response': False,
+        'requests_response_code': 999,
+    }),
+    ('pagertree://int_123456789', {
+        'instance': NotifyPagerTree,
+
+        'test_requests_exceptions': True,
+    }),
+)
+
+
+def test_plugin_pagertree_urls():
+
+
+
+    AppriseURLTester(tests=apprise_url_tests).run_all()
+
+
+@mock.patch('requests.post')
+def test_plugin_pagertree_default_payload(mock_post):
+
+
+
+    response = mock.Mock()
+    response.status_code = requests.codes.ok
+    response.content = b''
+    mock_post.return_value = response
+
+    obj = Apprise.instantiate('pagertree://int_1234567')
+    assert isinstance(obj, NotifyPagerTree)
+
+    assert obj.notify(body='my body', title='my title') is True
+    assert mock_post.call_count == 1
+
+    call = mock_post.call_args_list[0]
+
+    assert call[0][0] == 'https://api.pagertree.com/integration/int_1234567'
+
+
+    assert call[1]['headers']['Content-Type'] == 'application/json'
+
+    payload = _posted_body(call)
+    assert payload['event_type'] == 'create'
+    assert payload['title'] == 'my title'
+    assert payload['description'] == 'my body'
+
+    assert isinstance(payload['id'], str)
+    assert len(payload['id']) > 0
+
+    assert payload['meta'] == {}
+    assert payload['tags'] == []
+
+    assert 'urgency' not in payload
+
+
+@mock.patch('requests.post')
+def test_plugin_pagertree_generated_ids_unique(mock_post):
+
+
+
+    response = mock.Mock()
+    response.status_code = requests.codes.ok
+    response.content = b''
+    mock_post.return_value = response
+
+    obj = Apprise.instantiate('pagertree://int_1234567')
+    assert obj.notify(body='a') is True
+    assert obj.notify(body='b') is True
+
+    first = _posted_body(mock_post.call_args_list[0])['id']
+    second = _posted_body(mock_post.call_args_list[1])['id']
+    assert first != second
+
+
+@mock.patch('requests.post')
+def test_plugin_pagertree_tags_and_urgency(mock_post):
+
+
+
+    response = mock.Mock()
+    response.status_code = requests.codes.ok
+    response.content = b''
+    mock_post.return_value = response
+
+    obj = Apprise.instantiate(
+        'pagertree://int_1234567?tags=prod,server,outage&urgency=high')
+    assert obj.notify(body='b', title='t') is True
+
+    payload = _posted_body(mock_post.call_args_list[0])
+    assert sorted(payload['tags']) == ['outage', 'prod', 'server']
+    assert payload['urgency'] == 'high'
+
+
+@mock.patch('requests.post')
+def test_plugin_pagertree_invalid_urgency_omitted(mock_post):
+
+
+
+    response = mock.Mock()
+    response.status_code = requests.codes.ok
+    response.content = b''
+    mock_post.return_value = response
+
+    obj = Apprise.instantiate('pagertree://int_1234567?urgency=nope')
+    assert obj.notify(body='b', title='t') is True
+
+    payload = _posted_body(mock_post.call_args_list[0])
+    assert 'urgency' not in payload
+
+
+@mock.patch('requests.post')
+def test_plugin_pagertree_thirdparty_id(mock_post):
+
+
+
+    response = mock.Mock()
+    response.status_code = requests.codes.ok
+    response.content = b''
+    mock_post.return_value = response
+
+    obj = Apprise.instantiate('pagertree://int_1234567?thirdparty=abc123')
+    assert obj.notify(body='b', title='t') is True
+
+    payload = _posted_body(mock_post.call_args_list[0])
+    assert payload['id'] == 'abc123'
+
+
+@mock.patch('requests.post')
+def test_plugin_pagertree_resolve_action(mock_post):
+
+
+
+    response = mock.Mock()
+    response.status_code = requests.codes.ok
+    response.content = b''
+    mock_post.return_value = response
+
+    for action in ('resolve', 'acknowledge'):
+        mock_post.reset_mock()
+        obj = Apprise.instantiate(
+            'pagertree://int_1234567?action={}&thirdparty=abc123'
+            '&tags=x,y&urgency=high'.format(action))
+        assert obj.notify(body='b', title='t') is True
+
+        payload = _posted_body(mock_post.call_args_list[0])
+        assert payload['event_type'] == action
+        assert payload['id'] == 'abc123'
+
+        assert 'title' not in payload
+        assert 'description' not in payload
+        assert 'meta' not in payload
+        assert 'tags' not in payload
+        assert 'urgency' not in payload
+
+
+@mock.patch('requests.post')
+def test_plugin_pagertree_invalid_action_defaults_create(mock_post):
+
+
+
+    response = mock.Mock()
+    response.status_code = requests.codes.ok
+    response.content = b''
+    mock_post.return_value = response
+
+    obj = Apprise.instantiate('pagertree://int_1234567?action=bogus')
+    assert obj.notify(body='b', title='t') is True
+
+    payload = _posted_body(mock_post.call_args_list[0])
+    assert payload['event_type'] == 'create'
+    assert payload['title'] == 't'
+    assert payload['description'] == 'b'
+
+
+@mock.patch('requests.post')
+def test_plugin_pagertree_prefixed_arguments(mock_post):
+
+
+
+    response = mock.Mock()
+    response.status_code = requests.codes.ok
+    response.content = b''
+    mock_post.return_value = response
+
+    obj = Apprise.instantiate(
+        'pagertree://int_1234567'
+        '?+my-token=secret&:server=blue-ranger&-incident=true')
+    assert obj.notify(body='b', title='t') is True
+
+    call = mock_post.call_args_list[0]
+
+
+    assert call[1]['headers']['my-token'] == 'secret'
+
+    payload = _posted_body(call)
+
+    assert payload['server'] == 'blue-ranger'
+
+    assert payload['meta']['incident'] == 'true'
+
+
+@mock.patch('requests.post')
+def test_plugin_pagertree_payload_override(mock_post):
+
+
+
+    response = mock.Mock()
+    response.status_code = requests.codes.ok
+    response.content = b''
+    mock_post.return_value = response
+
+    obj = Apprise.instantiate('pagertree://int_1234567?:title=overridden')
+    assert obj.notify(body='b', title='original') is True
+
+    payload = _posted_body(mock_post.call_args_list[0])
+    assert payload['title'] == 'overridden'
+
+
+@mock.patch('requests.post')
+def test_plugin_pagertree_failure_codes(mock_post):
+
+
+
+    response = mock.Mock()
+    response.content = b''
+    mock_post.return_value = response
+
+    obj = Apprise.instantiate('pagertree://int_1234567')
+
+    for code in (200, 201, 202):
+        response.status_code = code
+        assert obj.notify(body='b', title='t') is True
+
+    for code in (402, 403, 404, 405, 429, 500):
+        response.status_code = code
+        assert obj.notify(body='b', title='t') is False
