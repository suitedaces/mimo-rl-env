diff --git a/packages/svelte/tests/types/events.ts b/packages/svelte/tests/types/events.ts
new file mode 100644
index 000000000000..3d4c0e1a2b7c
--- /dev/null
+++ b/packages/svelte/tests/types/events.ts
@@ -0,0 +1,34 @@
+import { on } from 'svelte/events';
+
+
+
+const node: HTMLElement = document.body;
+
+on(node, 'pointerdown', (e: PointerEvent) => {
+	e.pointerId;
+});
+
+declare const expect_keyboard_event: (event: KeyboardEvent) => void;
+
+on(document.body, 'click', (e) => {
+	const mouse_event: MouseEvent = e;
+	// @ts-expect-error click handlers should not be typed as any or as an unrelated event
+	expect_keyboard_event(e);
+	return e.button + mouse_event.button;
+});
+
+const media_listener: EventListener = (event) => {
+	event.type;
+};
+
+on(window.matchMedia('(min-width: 1px)'), 'change', media_listener);
+
+const standalone_target = new EventTarget();
+on(standalone_target, 'custom-event', media_listener);
+
+on(
+	// @ts-expect-error strings are not EventTargets
+	'asd',
+	'asd',
+	(e: Event) => e
+);
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,26 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export PATH="/opt/node-24/bin:$PATH"
+
+
+if [ ! -x /testbed/node_modules/.bin/tsc ]; then
+	pnpm install --frozen-lockfile
+fi
+
+case "${1:-}" in
+	base)
+		cd /testbed/packages/svelte
+		pnpm exec tsc --project tests/types/tsconfig.json --noEmit
+		;;
+	new)
+		cd /testbed/packages/svelte
+		pnpm exec tsc --project tests/types/tsconfig.json --noEmit
+		;;
+	*)
+		echo "usage: $0 base|new"
+		exit 2
+		;;
+esac
