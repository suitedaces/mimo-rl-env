diff --git a/usercase-test-coderl/test_calculate_formula.py b/usercase-test-coderl/test_calculate_formula.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_calculate_formula.py
@@ -0,0 +1,319 @@
+import copy
+import json
+import subprocess
+import sys
+import textwrap
+import types
+
+
+
+
+
+STUB_SOURCE = r"""
+import builtins
+import sys
+import types
+
+builtins.cmp = lambda a, b: (a > b) - (a < b)
+builtins.long = int
+builtins.xrange = range
+
+
+class InterfaceMeta(type):
+    def __getitem__(cls, key):
+        return object()
+
+
+class InterfaceBase(metaclass=InterfaceMeta):
+    pass
+
+
+class Dummy:
+    def __init__(self, *args, **kwargs):
+        pass
+
+    def __call__(self, *args, **kwargs):
+        return self
+
+    def __getattr__(self, name):
+        return self
+
+    def __iter__(self):
+        return iter(())
+
+    def __getitem__(self, key):
+        return self
+
+    def __mro_entries__(self, bases):
+        return (object,)
+
+
+def stub_module(name):
+    module = types.ModuleType(name)
+    module.__path__ = []
+    module.__getattr__ = lambda attr: Dummy()
+    sys.modules[name] = module
+    return module
+
+
+MODULES = [
+    "zope",
+    "zope.i18nmessageid",
+    "zope.component",
+    "zope.schema",
+    "zope.interface",
+    "plone",
+    "plone.autoform",
+    "plone.autoform.directives",
+    "plone.supermodel",
+    "plone.supermodel.model",
+    "Products",
+    "Products.CMFCore",
+    "Products.CMFCore.permissions",
+    "AccessControl",
+    "bika",
+    "bika.lims",
+    "bika.lims.browser",
+    "bika.lims.browser.fields",
+    "bika.lims.browser.fields.uidreferencefield",
+    "bika.lims.interfaces",
+    "senaite.core.catalog",
+    "senaite.core.content.base",
+    "senaite.core.interfaces",
+    "senaite.core.schema",
+    "senaite.core.schema.fields",
+    "senaite.core.schema.interimfields",
+    "senaite.core.schema.uidreferencefield",
+    "senaite.core.validators",
+    "senaite.core.validators.formula",
+    "senaite.core.validators.imports",
+    "senaite.core.validators.interimfields",
+    "senaite.core.z3cform",
+    "senaite.core.z3cform.widgets",
+    "senaite.core.z3cform.widgets.datagrid",
+    "z3c",
+    "z3c.form",
+    "z3c.form.error",
+    "z3c.form.util",
+    "z3c.form.validator",
+]
+
+for module_name in MODULES:
+    stub_module(module_name)
+
+for module_name, module in list(sys.modules.items()):
+    if "." in module_name:
+        parent, attr = module_name.rsplit(".", 1)
+        if parent in sys.modules:
+            setattr(sys.modules[parent], attr, module)
+
+sys.modules["zope.i18nmessageid"].MessageFactory = (
+    lambda domain: (lambda *args, **kwargs: kwargs.get(
+        "default", args[0] if args else ""))
+)
+sys.modules["bika.lims"].senaiteMessageFactory = (
+    lambda *args, **kwargs: kwargs.get("default", args[0] if args else "")
+)
+
+api = stub_module("bika.lims.api")
+api.safe_unicode = lambda value: str(value)
+sys.modules["bika.lims"].api = api
+
+sys.modules["zope.interface"].Interface = InterfaceBase
+sys.modules["zope.interface"].implementer = lambda *ifaces: (
+    lambda cls: cls)
+sys.modules["plone.supermodel.model"].Schema = InterfaceBase
+sys.modules["AccessControl"].ClassSecurityInfo = Dummy
+sys.modules["senaite.core.content.base"].Container = object
+sys.modules["senaite.core.interfaces"].ICalculation = object
+sys.modules["z3c.form.validator"].WidgetsValidatorDiscriminators = (
+    lambda *args, **kwargs: None)
+sys.modules["z3c.form.validator"].WidgetValidatorDiscriminators = (
+    lambda *args, **kwargs: None)
+sys.modules["z3c.form.error"].ErrorViewDiscriminators = (
+    lambda *args, **kwargs: None)
+sys.modules["z3c.form.error"].MultipleErrors = type(
+    "MultipleErrors", (Exception,), {})
+sys.modules["zope.component"].provideAdapter = (
+    lambda *args, **kwargs: None)
+sys.modules["z3c.form.util"].getSpecification = (
+    lambda *args, **kwargs: object())
+"""
+
+
+exec(STUB_SOURCE, globals())
+sys.path.insert(0, "/workspace/repo/src")
+
+from senaite.core.content.calculation import calculate_formula
+
+
+def test_adds_square_bracket_placeholders():
+
+
+
+
+    actual = calculate_formula("[Ca] + [Mg]", {"Ca": 5, "Mg": 3})
+
+    assert actual == 8
+
+
+def test_strips_formatting_whitespace_before_evaluation():
+
+
+
+
+    actual = calculate_formula("[Ca]\n+\t[Mg]\r", {"Ca": 5, "Mg": 3})
+
+    assert actual == 8
+
+
+def test_supports_string_values_supplied_by_caller():
+
+
+
+
+    actual = calculate_formula(
+        "[Comment] if [Comment] == 'uncertain' else ([Ca] + [Mg])",
+        {"Comment": "'uncertain'", "Ca": 5, "Mg": 5},
+    )
+
+    assert actual == "uncertain"
+
+
+def test_supports_dotted_placeholder_names():
+
+
+
+
+    actual = calculate_formula(
+        "[Result.value] * 2 + [Ca]",
+        {"Result.value": 4, "Ca": 1},
+    )
+
+    assert actual == 9
+
+
+def test_makes_requested_import_member_available():
+
+
+
+
+    actual = calculate_formula(
+        "floor([Ca] + [Mg])",
+        {"Ca": 5.6, "Mg": 3.3},
+        [{"module": "math", "function": "floor"}],
+    )
+
+    assert actual == 8
+
+
+def test_missing_placeholder_becomes_key_error_result_string():
+
+
+
+
+    actual = calculate_formula("[Ca] + [Mg]", {"Ca": 5})
+
+    assert actual == "Key Error: Mg"
+
+
+def test_division_by_zero_becomes_result_string():
+
+
+
+
+    actual = calculate_formula("[Ca] / [Mg]", {"Ca": 5, "Mg": 0})
+
+
+    assert isinstance(actual, str)
+    assert actual.startswith("Division by 0: ")
+
+
+def test_missing_import_member_becomes_import_error_result_string():
+
+
+
+
+    actual = calculate_formula(
+        "missing([Ca])",
+        {"Ca": 5},
+        [{"module": "math", "function": "missing"}],
+    )
+
+    assert actual == "Import Error: Could not find member missing of module math"
+
+
+def test_syntax_problem_becomes_result_string():
+
+
+
+
+    actual = calculate_formula("[Ca] +", {"Ca": 5})
+
+
+    assert isinstance(actual, str)
+    assert actual.startswith("Syntax Error: ")
+
+
+def test_referential_transparency_for_same_arguments():
+    assert calculate_formula("[Ca] * -2", {"Ca": 4}) == -8
+    assert calculate_formula("[Ca] * -2", {"Ca": 4}) == -8
+
+
+def test_does_not_mutate_parameters_or_imports():
+    parameters = {"Ca": 5.6, "Mg": 3.3, "Nested": {"unchanged": [1, 2]}}
+    imports = [{"module": "math", "function": "floor"}]
+    original_parameters = copy.deepcopy(parameters)
+    original_imports = copy.deepcopy(imports)
+
+    actual = calculate_formula("floor([Ca] + [Mg])", parameters, imports)
+
+    assert actual == 8
+    assert parameters == original_parameters
+    assert imports == original_imports
+
+
+def test_no_global_state_with_fresh_python_process():
+    calculate_formula("[Noise] + 1", {"Noise": 100})
+    in_process = calculate_formula(
+        "[Comment] if [Comment] == 'uncertain' else ([Ca] + [Mg])",
+        {"Comment": "'uncertain'", "Ca": 5, "Mg": 5},
+    )
+
+    script = STUB_SOURCE + textwrap.dedent(
+        """
+        import json
+        import sys
+        sys.path.insert(0, "/workspace/repo/src")
+        from senaite.core.content.calculation import calculate_formula
+        result = calculate_formula(
+            "[Comment] if [Comment] == 'uncertain' else ([Ca] + [Mg])",
+            {"Comment": "'uncertain'", "Ca": 5, "Mg": 5},
+        )
+        sys.stdout.write(json.dumps(result))
+        """
+    )
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+
+    assert in_process == "uncertain"
+    assert json.loads(completed.stdout) == "uncertain"
+
+
+def test_calculation_from_isolated_cwd_keeps_inputs_unchanged(
+        tmp_path, monkeypatch):
+
+
+    monkeypatch.chdir(tmp_path)
+    parameters = {"Ca": 2, "Mg": 4}
+    original_parameters = copy.deepcopy(parameters)
+
+    actual = calculate_formula("[Ca] + [Mg]", parameters)
+
+    assert actual == 6
+    assert parameters == original_parameters
