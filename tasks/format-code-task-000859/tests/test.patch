diff --git a/pkg/nodebootstrap/managed_al2_prebootstrap_test.go b/pkg/nodebootstrap/managed_al2_prebootstrap_test.go
new file mode 100644
index 000000000..a6dd698e3
--- /dev/null
+++ b/pkg/nodebootstrap/managed_al2_prebootstrap_test.go
@@ -0,0 +1,159 @@
+package nodebootstrap_test
+
+import (
+	"encoding/base64"
+	"strings"
+	"testing"
+
+	"github.com/aws/aws-sdk-go/aws"
+	api "github.com/weaveworks/eksctl/pkg/apis/eksctl.io/v1alpha5"
+
+	"github.com/weaveworks/eksctl/pkg/nodebootstrap"
+)
+
+func runManagedUserData(t *testing.T, ng *api.ManagedNodeGroup) string {
+	t.Helper()
+	api.SetManagedNodeGroupDefaults(ng, &api.ClusterMeta{Name: "cluster"})
+	bs := nodebootstrap.NewManagedAL2Bootstrapper(ng)
+	bs.UserDataMimeBoundary = "//"
+	ud, err := bs.UserData()
+	if err != nil {
+		t.Fatalf("UserData returned err: %v", err)
+	}
+	if ud == "" {
+		return ""
+	}
+	dec, err := base64.StdEncoding.DecodeString(ud)
+	if err != nil {
+		t.Fatalf("base64 decode err: %v", err)
+	}
+	return strings.ReplaceAll(string(dec), "\r\n", "\n")
+}
+
+
+
+
+
+
+func TestManagedCustomAMIPreBootstrapOnly(t *testing.T) {
+	ng := &api.ManagedNodeGroup{
+		NodeGroupBase: &api.NodeGroupBase{
+			Name:                 "custom-ami-pre",
+			InstanceType:         "m5.xlarge",
+			AMI:                  "ami-custom",
+			PreBootstrapCommands: []string{"echo pre-one-PRECMDA", "echo pre-two-PRECMDB"},
+		},
+	}
+	actual := runManagedUserData(t, ng)
+
+	if !strings.Contains(actual, "echo pre-one-PRECMDA") {
+		t.Fatalf("expected user data to contain first pre-bootstrap command, got:\n%s", actual)
+	}
+	if !strings.Contains(actual, "echo pre-two-PRECMDB") {
+		t.Fatalf("expected user data to contain second pre-bootstrap command, got:\n%s", actual)
+	}
+	idxA := strings.Index(actual, "echo pre-one-PRECMDA")
+	idxB := strings.Index(actual, "echo pre-two-PRECMDB")
+	if idxA >= idxB {
+		t.Fatalf("expected pre-one before pre-two, got indices %d, %d in:\n%s", idxA, idxB, actual)
+	}
+}
+
+
+
+func TestManagedCustomAMIPreBootstrapAndOverride(t *testing.T) {
+	ng := &api.ManagedNodeGroup{
+		NodeGroupBase: &api.NodeGroupBase{
+			Name:                     "custom-ami-both",
+			InstanceType:             "m5.xlarge",
+			AMI:                      "ami-custom",
+			PreBootstrapCommands:     []string{"echo pre-one-PRECMDX"},
+			OverrideBootstrapCommand: aws.String("echo override-OVRCMDY"),
+		},
+	}
+	actual := runManagedUserData(t, ng)
+
+	if !strings.Contains(actual, "echo pre-one-PRECMDX") {
+		t.Fatalf("expected user data to contain pre-bootstrap command, got:\n%s", actual)
+	}
+	if !strings.Contains(actual, "echo override-OVRCMDY") {
+		t.Fatalf("expected user data to contain override command, got:\n%s", actual)
+	}
+	idxPre := strings.Index(actual, "echo pre-one-PRECMDX")
+	idxOver := strings.Index(actual, "echo override-OVRCMDY")
+	if idxPre >= idxOver {
+		t.Fatalf("expected pre-bootstrap before override, got indices %d, %d in:\n%s",
+			idxPre, idxOver, actual)
+	}
+}
+
+
+
+func TestManagedCustomAMIOverrideOnlyUsesMIME(t *testing.T) {
+	ng := &api.ManagedNodeGroup{
+		NodeGroupBase: &api.NodeGroupBase{
+			Name:                     "custom-ami-override",
+			InstanceType:             "m5.xlarge",
+			AMI:                      "ami-custom",
+			OverrideBootstrapCommand: aws.String("echo override-ONLYCMD"),
+		},
+	}
+	actual := runManagedUserData(t, ng)
+
+	if !strings.Contains(actual, "echo override-ONLYCMD") {
+		t.Fatalf("expected user data to contain override command, got:\n%s", actual)
+	}
+}
+
+
+
+func TestManagedCustomAMINoCommandsEmpty(t *testing.T) {
+	ng := &api.ManagedNodeGroup{
+		NodeGroupBase: &api.NodeGroupBase{
+			Name:         "custom-ami-empty",
+			InstanceType: "m5.xlarge",
+			AMI:          "ami-custom",
+		},
+	}
+	api.SetManagedNodeGroupDefaults(ng, &api.ClusterMeta{Name: "cluster"})
+	bs := nodebootstrap.NewManagedAL2Bootstrapper(ng)
+	bs.UserDataMimeBoundary = "//"
+	ud, err := bs.UserData()
+	if err != nil {
+		t.Fatalf("UserData err: %v", err)
+	}
+	if ud != "" {
+		t.Fatalf("expected empty user data, got %q", ud)
+	}
+}
+
+
+
+
+
+func TestManagedCustomAMIPreAndOverrideContainBoth(t *testing.T) {
+	ng := &api.ManagedNodeGroup{
+		NodeGroupBase: &api.NodeGroupBase{
+			Name:                     "custom-ami-both2",
+			InstanceType:             "m5.xlarge",
+			AMI:                      "ami-1234",
+			PreBootstrapCommands:     []string{"PRECOMMAND_ALPHA", "PRECOMMAND_BETA"},
+			OverrideBootstrapCommand: aws.String("OVERRIDE_GAMMA"),
+		},
+	}
+	actual := runManagedUserData(t, ng)
+
+	for _, needle := range []string{"PRECOMMAND_ALPHA", "PRECOMMAND_BETA", "OVERRIDE_GAMMA"} {
+		if !strings.Contains(actual, needle) {
+			t.Fatalf("expected user data to contain %q, got:\n%s", needle, actual)
+		}
+	}
+
+	idxPreA := strings.Index(actual, "PRECOMMAND_ALPHA")
+	idxPreB := strings.Index(actual, "PRECOMMAND_BETA")
+	idxOver := strings.Index(actual, "OVERRIDE_GAMMA")
+	if !(idxPreA < idxPreB && idxPreB < idxOver) {
+		t.Fatalf("expected ordering pre-alpha < pre-beta < override, got %d, %d, %d in:\n%s",
+			idxPreA, idxPreB, idxOver, actual)
+	}
+}
