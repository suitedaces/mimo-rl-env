diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,188 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+export GOMODCACHE="${GOMODCACHE:-/root/go/pkg/mod}"
+export GOPROXY=off
+export GOSUMDB=off
+export GOTOOLCHAIN=local
+export GOFLAGS="-mod=readonly"
+
+TMPROOT=$(mktemp -d)
+trap 'rm -rf "$TMPROOT"' EXIT
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+( cd /workspace/repo && go build -o "$TMPROOT/notesium" . ) \
+    || fail "build"
+BIN="$TMPROOT/notesium"
+
+FIXTURES=/workspace/repo/usercase-test-coderl/fixtures/notes
+NOTES="$TMPROOT/notes"
+mkdir -p "$NOTES"
+cp "$FIXTURES"/*.md "$NOTES"/
+export NOTESIUM_DIR="$NOTES"
+
+cd "$TMPROOT" || fail "cd tmp"
+
+run_notesium() {
+    "$BIN" "$@" >out 2>err
+    ec=$?
+}
+
+expect_stdout() {
+    label=$1
+    expected=$2
+    printf "%b" "$expected" >want
+    cmp -s out want || fail "$label stdout mismatch: got $(sed -n l out | tr '\n' ' ')"
+}
+
+expect_stdout_lines_any_order() {
+    label=$1
+    expected=$2
+    printf "%b" "$expected" | sort >want
+    sort out >got
+    cmp -s got want || fail "$label stdout lines mismatch: got $(sed -n l out | tr '\n' ' ')"
+}
+
+expect_empty_stderr() {
+    label=$1
+    [ ! -s err ] || fail "$label unexpected stderr: $(cat err)"
+}
+
+expect_empty_stdout() {
+    label=$1
+    [ ! -s out ] || fail "$label unexpected stdout: $(cat out)"
+}
+
+
+
+
+run_notesium links
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+expect_stdout F1 "00000001.md:3: alpha note \342\206\222 beta note
+00000001.md:4: alpha note \342\206\222 gamma note
+00000002.md:3: beta note \342\206\222 gamma note
+00000002.md:3: beta note \342\206\222 00000009.md
+"
+expect_empty_stderr F1
+
+
+
+
+run_notesium links 00000001.md
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+expect_stdout F2 "00000002.md:1: outgoing beta note
+00000003.md:1: outgoing gamma note
+"
+expect_empty_stderr F2
+
+
+
+
+run_notesium links --filename=00000001.md
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+expect_stdout F3 "00000002.md:1: outgoing beta note
+00000003.md:1: outgoing gamma note
+"
+expect_empty_stderr F3
+
+
+
+
+run_notesium links --outgoing 00000002.md
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+expect_stdout F4 "00000003.md:1: gamma note
+"
+expect_empty_stderr F4
+
+
+
+
+run_notesium links --incoming 00000002.md
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+expect_stdout F5 "00000001.md:3: alpha note
+"
+expect_empty_stderr F5
+
+
+
+
+run_notesium links --incoming --outgoing 00000002.md
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+
+expect_stdout_lines_any_order F6 "00000003.md:1: outgoing gamma note
+00000001.md:3: incoming alpha note
+"
+expect_empty_stderr F6
+
+
+
+
+run_notesium links --dangling
+[ "$ec" -eq 0 ] || fail "F7 exit $ec; want 0"
+expect_stdout F7 "00000002.md:3: beta note \342\206\222 00000009.md
+"
+expect_empty_stderr F7
+
+
+
+
+run_notesium links --color
+[ "$ec" -eq 0 ] || fail "F8 exit $ec; want 0"
+expect_stdout F8 "00000001.md:3: \033[0;36malpha note\033[0m \342\206\222 beta note
+00000001.md:4: \033[0;36malpha note\033[0m \342\206\222 gamma note
+00000002.md:3: \033[0;36mbeta note\033[0m \342\206\222 gamma note
+00000002.md:3: \033[0;36mbeta note\033[0m \342\206\222 00000009.md
+"
+expect_empty_stderr F8
+
+
+
+
+run_notesium links --color 00000002.md
+[ "$ec" -eq 0 ] || fail "F9 exit $ec; want 0"
+expect_stdout F9 "00000003.md:1: \033[0;36moutgoing\033[0m gamma note
+00000001.md:3: \033[0;36mincoming\033[0m alpha note
+"
+expect_empty_stderr F9
+
+
+
+
+run_notesium links --outgoing
+[ "$ec" -ne 0 ] || fail "F10 exit $ec; want nonzero"
+expect_empty_stdout F10
+grep -q "filename is required" err || fail "F10 stderr missing filename is required: $(cat err)"
+
+
+
+
+run_notesium links --incoming
+[ "$ec" -ne 0 ] || fail "F11 exit $ec; want nonzero"
+expect_empty_stdout F11
+grep -q "filename is required" err || fail "F11 stderr missing filename is required: $(cat err)"
+
+
+
+
+run_notesium links --dangling 00000001.md
+[ "$ec" -ne 0 ] || fail "F12 exit $ec; want nonzero"
+expect_empty_stdout F12
+grep -q "filename not supported" err || fail "F12 stderr missing filename not supported: $(cat err)"
+
+
+
+
+run_notesium help
+
+cat out err >help_output
+grep -Eq "links[[:space:]]+\\[filename\\]" help_output || fail "F13 help missing links [filename]"
+grep -Eq "(^|[[:space:]])--color([[:space:]]|$)" help_output || fail "F13 help missing --color"
+grep -Eq "(^|[[:space:]])--outgoing([[:space:]]|$)" help_output || fail "F13 help missing --outgoing"
+grep -Eq "(^|[[:space:]])--incoming([[:space:]]|$)" help_output || fail "F13 help missing --incoming"
+grep -Eq "(^|[[:space:]])--dangling([[:space:]]|$)" help_output || fail "F13 help missing --dangling"
+
+echo "PASS"
+exit 0
