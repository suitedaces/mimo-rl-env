diff --git a/test/configCases/plugins/banner-plugin-function/index.js b/test/configCases/plugins/banner-plugin-function/index.js
new file mode 100644
index 000000000..d2cd63dc0
--- /dev/null
+++ b/test/configCases/plugins/banner-plugin-function/index.js
@@ -0,0 +1,25 @@
+it("should accept a function in the banner field and receive chunk data", function() {
+	var fs = require("fs");
+	var source = fs.readFileSync(__filename, "utf-8");
+
+	expect(source).toMatch("chunkname=bundle0");
+
+	expect(source).toMatch("filename=bundle0.js");
+
+	expect(source).toMatch("basename=bundle0.js");
+});
+
+it("should substitute placeholders in the string returned from the banner function", function() {
+	var fs = require("fs");
+	var source = fs.readFileSync(__filename, "utf-8");
+
+	expect(source).toMatch("placeholder=bundle0");
+	expect(source).not.toMatch(/placeholder=\[name\]/);
+});
+
+it("should wrap the function-returned banner in a comment by default", function() {
+	var fs = require("fs");
+	var source = fs.readFileSync(__filename, "utf-8");
+
+	expect(source.indexOf("/*! chunkname=bundle0")).toBe(0);
+});
diff --git a/test/configCases/plugins/banner-plugin-function/webpack.config.js b/test/configCases/plugins/banner-plugin-function/webpack.config.js
new file mode 100644
index 000000000..28e54b548
--- /dev/null
+++ b/test/configCases/plugins/banner-plugin-function/webpack.config.js
@@ -0,0 +1,30 @@
+"use strict";
+
+var webpack = require("../../../../");
+module.exports = {
+	node: {
+		__dirname: false,
+		__filename: false
+	},
+	entry: {
+		bundle0: ["./index.js"]
+	},
+	output: {
+		filename: "[name].js"
+	},
+	plugins: [
+		new webpack.BannerPlugin({
+			banner: function(data) {
+				return (
+					"chunkname=" +
+					data.chunk.name +
+					";filename=" +
+					data.filename +
+					";basename=" +
+					data.basename +
+					";placeholder=[name]"
+				);
+			}
+		})
+	]
+};
