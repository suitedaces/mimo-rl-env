+from weblate.auth.models import Group
+from weblate.trans.models import Project
+from weblate.trans.tests.test_views import ViewTestCase
+from weblate.utils.state import STATE_APPROVED
+
+
+class SourceReviewTest(ViewTestCase):
+    def set_review(self, source_review=False, translation_review=False):
+        self.project.source_review = source_review
+        self.project.translation_review = translation_review
+        self.project.save()
+
+    def test_defaults(self):
+
+        project = Project.objects.create(name="Defaults", slug="defaults")
+        self.assertFalse(project.source_review)
+        self.assertFalse(project.translation_review)
+
+    def test_translation_enable_review_disabled(self):
+        self.set_review(source_review=False, translation_review=False)
+        self.assertFalse(self.get_translation("cs").enable_review)
+        self.assertFalse(self.get_translation("en").enable_review)
+
+    def test_translation_enable_review_translation(self):
+        self.set_review(source_review=False, translation_review=True)
+
+        self.assertTrue(self.get_translation("cs").enable_review)
+
+        self.assertFalse(self.get_translation("en").enable_review)
+
+    def test_translation_enable_review_source(self):
+        self.set_review(source_review=True, translation_review=False)
+
+        self.assertTrue(self.get_translation("en").enable_review)
+
+        self.assertFalse(self.get_translation("cs").enable_review)
+
+    def test_review_permission_disabled(self):
+        self.make_manager()
+        self.set_review(source_review=False, translation_review=False)
+        self.assertFalse(self.user.has_perm("unit.review", self.get_translation("cs")))
+        self.assertFalse(self.user.has_perm("unit.review", self.component))
+        self.assertFalse(self.user.has_perm("unit.review", self.project))
+
+    def test_review_permission_translation(self):
+        self.make_manager()
+        self.set_review(source_review=False, translation_review=True)
+
+        self.assertTrue(self.user.has_perm("unit.review", self.get_translation("cs")))
+
+        self.assertTrue(self.user.has_perm("unit.review", self.component))
+        self.assertTrue(self.user.has_perm("unit.review", self.project))
+
+    def test_review_permission_source_only(self):
+        self.make_manager()
+        self.set_review(source_review=True, translation_review=False)
+
+        self.assertFalse(self.user.has_perm("unit.review", self.get_translation("cs")))
+
+        self.assertTrue(self.user.has_perm("unit.review", self.component))
+        self.assertTrue(self.user.has_perm("unit.review", self.project))
+
+    def test_approve_with_translation_review(self):
+        self.make_manager()
+        self.set_review(source_review=False, translation_review=True)
+        self.edit_unit(
+            "Hello, world!\n", "Nazdar svete!\n", review=str(STATE_APPROVED)
+        )
+        unit = self.get_unit()
+        self.assertTrue(unit.approved)
+
+    def test_approve_without_translation_review(self):
+        self.make_manager()
+        self.set_review(source_review=False, translation_review=False)
+        self.edit_unit(
+            "Hello, world!\n", "Nazdar svete!\n", review=str(STATE_APPROVED)
+        )
+        unit = self.get_unit()
+        self.assertFalse(unit.approved)
+
+    def review_group(self):
+        return Group.objects.filter(name="{}@Review".format(self.project.name))
+
+    def test_review_group_disabled(self):
+        self.project.access_control = Project.ACCESS_PUBLIC
+        self.set_review(source_review=False, translation_review=False)
+        self.assertFalse(self.review_group().exists())
+
+    def test_review_group_translation(self):
+        self.project.access_control = Project.ACCESS_PUBLIC
+        self.set_review(source_review=False, translation_review=True)
+        self.assertTrue(self.review_group().exists())
+
+    def test_review_group_source(self):
+        self.project.access_control = Project.ACCESS_PUBLIC
+        self.set_review(source_review=True, translation_review=False)
+        self.assertTrue(self.review_group().exists())
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,80 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+
+
+
+pg_ctlcluster 16 main start >/dev/null 2>&1 || true
+for _ in $(seq 1 30); do
+    pg_isready -h /var/run/postgresql >/dev/null 2>&1 && break
+    sleep 1
+done
+sudo -u postgres psql -tc "SELECT 1 FROM pg_roles WHERE rolname='weblate'" \
+    | grep -q 1 || sudo -u postgres psql -c \
+    "CREATE USER weblate WITH PASSWORD 'weblate' CREATEDB SUPERUSER;"
+sudo -u postgres psql -c "ALTER ROLE weblate SET timezone TO 'UTC';" >/dev/null
+
+
+
+python3 - <<'PY'
+import django.db.backends.postgresql.utils as m
+import pathlib
+p = pathlib.Path(m.__file__)
+text = p.read_text()
+if "timedelta" not in text:
+    p.write_text(
+        "from datetime import timedelta\n\n"
+        "from django.utils.timezone import utc\n\n\n"
+        "def utc_tzinfo_factory(offset):\n"
+        "    if offset not in (0, timedelta(0)):\n"
+        "        raise AssertionError(\"database connection isn't set to UTC\")\n"
+        "    return utc\n"
+    )
+PY
+
+
+
+python3 - <<'PY'
+import pathlib
+p = pathlib.Path("/testbed/weblate/utils/django_hacks.py")
+text = p.read_text()
+fixed = text.replace(
+    "cls.on_commit_mgr.__exit__()",
+    "cls.on_commit_mgr.__exit__(None, None, None)",
+)
+if fixed != text:
+    p.write_text(fixed)
+PY
+
+export DJANGO_SETTINGS_MODULE=weblate.settings_test
+export CI_DATABASE=postgresql
+export CI_DB_USER=weblate
+export CI_DB_PASSWORD=weblate
+export CI_DB_HOST=localhost
+
+
+
+
+
+
+
+
+
+
+
+./manage.py test \
+    weblate.auth.tests.test_permissions \
+    weblate.trans.tests.test_models \
+    weblate.trans.tests.test_source_review \
+    --noinput
