+from pathlib import Path
+
+
+def test_hyab_documentation_entry():
+
+
+    documentation = Path(__file__).parents[1] / "colour.difference.rst"
+    text = documentation.read_text(encoding="utf8")
+
+    assert "HyAB" in text
+    assert "delta_E_HyAB" in text
+    assert text.index("HyAB") < text.index("delta_E_HyAB")
