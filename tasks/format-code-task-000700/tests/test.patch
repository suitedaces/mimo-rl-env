diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,46 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set +u
+python3 -m venv /testbed/.venv
+source /testbed/.venv/bin/activate
+pip install --no-input -e ".[tests]" pytest pytest-xdist 2>/dev/null
+set -u
+
+
+TEST_PATCH=/testbed/mimo_test.patch
+
+case "${1:-}" in
+  base)
+    tmpdir=$(mktemp -d)
+    cp colour/difference/tests/test_delta_e.py "$tmpdir/test_delta_e.py"
+    had_docs_test=0
+    if [ -f docs/tests/test_colour_difference_docs.py ]; then
+      had_docs_test=1
+      cp docs/tests/test_colour_difference_docs.py "$tmpdir/test_colour_difference_docs.py"
+    fi
+    git apply --reverse --whitespace=nowarn "$TEST_PATCH"
+    python -m pytest colour/difference/tests/test_delta_e.py -v
+    status=$?
+    cp "$tmpdir/test_delta_e.py" colour/difference/tests/test_delta_e.py
+    if [ "$had_docs_test" -eq 1 ]; then
+      mkdir -p docs/tests
+      cp "$tmpdir/test_colour_difference_docs.py" docs/tests/test_colour_difference_docs.py
+    fi
+    rm -rf "$tmpdir"
+    exit "$status"
+    ;;
+  new)
+    python -m pytest \
+      colour/difference/tests/test_delta_e.py::TestDelta_E_HyAB::test_delta_E_HyAB \
+      colour/difference/tests/test_delta_e.py::TestDelta_E_HyAB::test_delta_E_HyAB_method_and_registry \
+      docs/tests/test_colour_difference_docs.py::test_hyab_documentation_entry \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
