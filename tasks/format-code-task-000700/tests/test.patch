     delta_E_CMC,
+    delta_E_HyAB,
     delta_E_ITP,
 )
 from colour.utilities import domain_range_scale, ignore_numpy_errors
@@ -37,6 +40,7 @@ __all__ = [
     "TestDelta_E_CIE2000",
     "TestDelta_E_CMC",
