 ]
 
 
@@ -745,3 +749,53 @@ class TestDelta_E_ITP:
         cases = [-1.0, 0.0, 1.0, -np.inf, np.inf, np.nan]
         cases = np.array(list(set(product(cases, repeat=3))))
         delta_E_ITP(cases, cases)
+
+
+class TestDelta_E_HyAB:
+    """
+    Define :func:`colour.difference.delta_E_HyAB` definition unit tests
+    methods.
+    """
+
+    def test_delta_E_HyAB(self):
+        """Test :func:`colour.difference.delta_E_HyAB` definition."""
+
+        Lab_1 = np.array(
+            [
+                [62.9, 28.3, 95.1],
+                [15.3, 3.8, 29.3],
+            ]
+        )
+        Lab_2 = np.array(
+            [
+                [15.3, 3.8, 29.3],
+                [62.9, 28.3, 95.1],
+            ]
+        )
+        expected = np.abs(Lab_1[..., 0] - Lab_2[..., 0]) + euclidean_distance(
+            Lab_1[..., 1:], Lab_2[..., 1:]
+        )
+
+        np.testing.assert_allclose(
+            delta_E_HyAB(Lab_1, Lab_2),
+            expected,
+            atol=TOLERANCE_ABSOLUTE_TESTS,
+        )
+
+    def test_delta_E_HyAB_method_and_registry(self):
+        """
+        Test :func:`colour.difference.delta_E` HyAB method selection and
+        public method discovery.
+        """
+
+        Lab_1 = np.array([10.0, -20.0, 30.0])
+        Lab_2 = np.array([40.0, 5.0, -15.0])
+
+        assert "HyAB" in DELTA_E_METHODS
+        assert callable(DELTA_E_METHODS["HyAB"])
+
+        np.testing.assert_allclose(
+            delta_E(Lab_1, Lab_2, method="HyAB"),
+            delta_E_HyAB(Lab_1, Lab_2),
+            atol=TOLERANCE_ABSOLUTE_TESTS,
+        )
