diff --git a/tests/unit/test_rf_graph_trigger.py b/tests/unit/test_rf_graph_trigger.py
new file mode 100644
index 000000000..e046dc935
--- /dev/null
+++ b/tests/unit/test_rf_graph_trigger.py
@@ -0,0 +1,204 @@
+
+
+
+
+
+
+
+
+import pytest
+
+from tracecat.dsl.common import ActionStatement
+from tracecat.dsl.graph import RFGraph
+from tracecat.types.exceptions import TracecatValidationError
+
+TRIGGER_ID = "trigger-wf"
+
+
+def udf(node_id: str, title: str, args=None):
+    return {
+        "id": node_id,
+        "type": "udf",
+        "data": {
+            "type": "core.action",
+            "title": title,
+            "args": args or {},
+        },
+    }
+
+
+def trigger(node_id: str = TRIGGER_ID):
+    return {"id": node_id, "type": "trigger", "data": {"title": "Trigger"}}
+
+
+def trigger_edge(target: str, source: str = TRIGGER_ID):
+    return {"source": source, "target": target, "label": "\u26a1 Trigger"}
+
+
+def edge(source: str, target: str):
+    return {"id": f"{source}_{target}", "source": source, "target": target}
+
+
+def simple_sequence():
+
+    return {
+        "nodes": [
+            trigger(),
+            udf("a", "Action A", {"test": 1}),
+            udf("b", "Action B", {"test": 2}),
+            udf("c", "Action C", {"test": 3}),
+        ],
+        "edges": [
+            trigger_edge("a"),
+            edge("a", "b"),
+            edge("b", "c"),
+        ],
+    }
+
+
+def kite():
+
+
+
+
+
+
+
+
+
+
+
+    return {
+        "nodes": [
+            trigger(),
+            udf("a", "Action A"),
+            udf("b", "Action B"),
+            udf("c", "Action C"),
+            udf("d", "Action D"),
+            udf("e", "Action E"),
+            udf("f", "Action F"),
+            udf("g", "Action G"),
+        ],
+        "edges": [
+            trigger_edge("a"),
+            edge("a", "b"),
+            edge("b", "c"),
+            edge("c", "f"),
+            edge("a", "d"),
+            edge("d", "e"),
+            edge("e", "f"),
+            edge("f", "g"),
+        ],
+    }
+
+
+def test_action_nodes_exclude_trigger_and_preserve_order():
+    graph = RFGraph.from_dict(simple_sequence())
+    assert [n.id for n in graph.action_nodes()] == ["a", "b", "c"]
+    assert [n.ref for n in graph.action_nodes()] == [
+        "action_a",
+        "action_b",
+        "action_c",
+    ]
+
+
+def test_trigger_accessor():
+    graph = RFGraph.from_dict(simple_sequence())
+    assert graph.trigger.id == TRIGGER_ID
+    assert graph.trigger.type == "trigger"
+
+
+def test_entrypoint_is_the_trigger_target():
+    graph = RFGraph.from_dict(simple_sequence())
+    assert graph.entrypoint.id == "a"
+    assert graph.entrypoint.ref == "action_a"
+
+
+def test_action_edges_exclude_the_trigger_edge():
+    graph = RFGraph.from_dict(simple_sequence())
+    pairs = {(e.source, e.target) for e in graph.action_edges()}
+    assert pairs == {("a", "b"), ("b", "c")}
+    assert all(TRIGGER_ID not in (e.source, e.target) for e in graph.action_edges())
+
+
+def _assert_valid_topological_order(graph: RFGraph, order: list[str]):
+    action_ids = {n.id for n in graph.action_nodes()}
+    assert set(order) == action_ids
+    assert len(order) == len(action_ids)
+    position = {node_id: i for i, node_id in enumerate(order)}
+    for e in graph.action_edges():
+        assert position[e.source] < position[e.target]
+
+
+def test_topological_order_simple_sequence():
+    graph = RFGraph.from_dict(simple_sequence())
+    assert graph.topsort_order() == ["a", "b", "c"]
+
+
+def test_topological_order_kite_is_valid():
+    graph = RFGraph.from_dict(kite())
+    _assert_valid_topological_order(graph, graph.topsort_order())
+
+
+def test_action_statements_simple_sequence():
+    graph = RFGraph.from_dict(simple_sequence())
+    statements = graph.action_statements()
+    assert statements == [
+        ActionStatement(ref="action_a", action="core.action", args={"test": 1}),
+        ActionStatement(
+            ref="action_b",
+            action="core.action",
+            args={"test": 2},
+            depends_on=["action_a"],
+        ),
+        ActionStatement(
+            ref="action_c",
+            action="core.action",
+            args={"test": 3},
+            depends_on=["action_b"],
+        ),
+    ]
+
+
+def test_action_statements_dependencies_are_sorted_and_complete():
+    graph = RFGraph.from_dict(kite())
+    by_ref = {s.ref: s for s in graph.action_statements()}
+
+
+    assert by_ref["action_a"].depends_on == []
+    assert by_ref["action_b"].depends_on == ["action_a"]
+    assert by_ref["action_d"].depends_on == ["action_a"]
+
+    assert by_ref["action_f"].depends_on == ["action_c", "action_e"]
+    assert by_ref["action_g"].depends_on == ["action_f"]
+
+
+def test_missing_trigger_node_raises():
+    obj = {
+        "nodes": [udf("a", "Action A"), udf("b", "Action B")],
+        "edges": [edge("a", "b")],
+    }
+    with pytest.raises(TracecatValidationError):
+        RFGraph.from_dict(obj)
+
+
+def test_multiple_trigger_nodes_raise():
+    obj = simple_sequence()
+    obj["nodes"].append(trigger("trigger-extra"))
+    with pytest.raises(TracecatValidationError):
+        RFGraph.from_dict(obj)
+
+
+def test_no_action_nodes_raises():
+    obj = {"nodes": [trigger()], "edges": []}
+    with pytest.raises(TracecatValidationError):
+        RFGraph.from_dict(obj)
+
+
+def test_trigger_pointing_to_multiple_actions_raises():
+    obj = {
+        "nodes": [trigger(), udf("a", "Action A"), udf("b", "Action B")],
+        "edges": [trigger_edge("a"), trigger_edge("b"), edge("a", "b")],
+    }
+    with pytest.raises(TracecatValidationError):
+        RFGraph.from_dict(obj)
