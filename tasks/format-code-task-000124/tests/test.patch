@@ -0,0 +1,121 @@
+from typing import Dict
+
+from fastapi.testclient import TestClient
+from sqlalchemy.orm import Session
+
+from app import crud, schemas
+from app.config import settings
+from tests.utils.models import create_model
+
+
+def create_model_stage(db: Session, user_id: int, name: str = "best", map: float = 0.5):
+    model = create_model(db, user_id)
+    stage_in = schemas.ModelStageCreate(
+        name=name,
+        timestamp=100,
+        map=map,
+        model_id=model.id,
+    )
+    stage = crud.model_stage.create(db, obj_in=stage_in)
+    return model, stage
+
+
+class TestGetModelStage:
+    def test_get_model_stage(
+        self,
+        db: Session,
+        client: TestClient,
+        user_id: int,
+        normal_user_token_headers: Dict[str, str],
+    ):
+        model, stage = create_model_stage(db, user_id, name="best")
+        r = client.get(
+            f"{settings.API_V1_STR}/model_stages/{stage.id}",
+            headers=normal_user_token_headers,
+        )
+        assert r.status_code == 200
+        result = r.json()["result"]
+        assert result["id"] == stage.id
+        assert result["name"] == "best"
+        assert result["model_id"] == model.id
+
+        assert result["model"]["id"] == model.id
+        assert result["model"]["hash"] == model.hash
+
+    def test_get_model_stage_not_found(
+        self,
+        db: Session,
+        client: TestClient,
+        normal_user_token_headers: Dict[str, str],
+    ):
+        r = client.get(
+            f"{settings.API_V1_STR}/model_stages/9999999",
+            headers=normal_user_token_headers,
+        )
+        assert r.status_code == 404
+        assert r.json()["code"] == 112001
+
+    def test_get_model_stage_invalid_name(
+        self,
+        db: Session,
+        client: TestClient,
+        user_id: int,
+        normal_user_token_headers: Dict[str, str],
+    ):
+        for bad_name in ["1stage", "with space", "a-b", ""]:
+            _, stage = create_model_stage(db, user_id, name=bad_name)
+            r = client.get(
+                f"{settings.API_V1_STR}/model_stages/{stage.id}",
+                headers=normal_user_token_headers,
+            )
+            assert r.json()["code"] == 112002
+            assert r.status_code != 200
+
+    def test_get_model_stage_valid_names_ok(
+        self,
+        db: Session,
+        client: TestClient,
+        user_id: int,
+        normal_user_token_headers: Dict[str, str],
+    ):
+        for good_name in ["stage_1", "_tmp", "Best2"]:
+            _, stage = create_model_stage(db, user_id, name=good_name)
+            r = client.get(
+                f"{settings.API_V1_STR}/model_stages/{stage.id}",
+                headers=normal_user_token_headers,
+            )
+            assert r.status_code == 200
+            assert r.json()["result"]["name"] == good_name
+
+
+class TestBatchGetModelStages:
+    def test_batch_existing_subset(
+        self,
+        db: Session,
+        client: TestClient,
+        user_id: int,
+        normal_user_token_headers: Dict[str, str],
+    ):
+        _, stage_a = create_model_stage(db, user_id, name="alpha")
+        _, stage_b = create_model_stage(db, user_id, name="beta")
+        r = client.get(
+            f"{settings.API_V1_STR}/model_stages/batch",
+            headers=normal_user_token_headers,
+            params={"ids": f"{stage_a.id},{stage_b.id},9999999"},
+        )
+        assert r.status_code == 200
+        returned_ids = {s["id"] for s in r.json()["result"]}
+        assert returned_ids == {stage_a.id, stage_b.id}
+
+    def test_batch_all_missing(
+        self,
+        client: TestClient,
+        normal_user_token_headers: Dict[str, str],
+    ):
+        r = client.get(
+            f"{settings.API_V1_STR}/model_stages/batch",
+            headers=normal_user_token_headers,
+            params={"ids": "8888881,8888882"},
+        )
+        assert r.status_code == 200
+        assert r.json()["result"] == []
