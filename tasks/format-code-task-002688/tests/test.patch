+func waitForWriteCalls(t *testing.T, clusters []*scriptedCluster, insertCalls, deleteCalls, totalCalls int) {
+	t.Helper()
+	deadline := time.Now().Add(500 * time.Millisecond)
+	for time.Now().Before(deadline) {
+		allReady := true
+		for _, c := range clusters {
+			s := c.snapshot()
+			if s.insertCalls < insertCalls || s.deleteCalls < deleteCalls || s.insertCalls+s.deleteCalls < totalCalls {
+				allReady = false
+				break
+			}
+		}
+		if allReady {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	for _, c := range clusters {
+		t.Fatalf("timed out waiting for %s writes: got %+v", c.name, c.snapshot())
+	}
+}
