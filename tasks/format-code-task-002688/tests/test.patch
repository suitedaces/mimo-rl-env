+func assertCounts(t *testing.T, name string, got, expected clusterSnapshot) {
+	t.Helper()
+	if !reflect.DeepEqual(got, expected) {
+		t.Fatalf("%s: expected %+v, got %+v", name, expected, got)
+	}
+}
