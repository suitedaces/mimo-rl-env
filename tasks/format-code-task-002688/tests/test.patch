+func (c *scriptedCluster) snapshot() clusterSnapshot {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return clusterSnapshot{
+		insertCalls:   c.insertCalls,
+		deleteCalls:   c.deleteCalls,
+		insertBatches: cloneBatches(c.insertBatches),
+		deleteBatches: cloneBatches(c.deleteBatches),
