+func TestInsertBroadcastsBatchAndSucceedsAtWriteQuorum(t *testing.T) {
+
+
+	c1 := newScriptedCluster("cluster-a", nil, 0)
+	c2 := newScriptedCluster("cluster-b", nil, 5*time.Millisecond)
+	c3 := newScriptedCluster("cluster-c", errors.New("cluster-c denied"), 30*time.Millisecond)
+	instr := &recordingInstrumentation{}
+	f := farm.New([]cluster.Cluster{c1, c2, c3}, 2, farm.SendAllReadAll, farm.NoRepairs, instr)
+
+	err := f.Insert(batch)
+	if err != nil {
+		t.Fatalf("expected nil insert error, got %v", err)
+	}
+	waitForWriteCalls(t, []*scriptedCluster{c1, c2, c3}, 1, 0, 1)
+
+	assertCounts(t, "cluster-a", c1.snapshot(), clusterSnapshot{
+		insertCalls: 1,
+		deleteCalls: 0,
+		insertBatches: [][]common.KeyScoreMember{
+			{
+				{Key: "alpha", Score: 11, Member: "one"},
+				{Key: "beta", Score: 22, Member: "two"},
+			},
+		},
+		deleteBatches: [][]common.KeyScoreMember{},
+	})
+	assertCounts(t, "cluster-b", c2.snapshot(), clusterSnapshot{
+		insertCalls: 1,
+		deleteCalls: 0,
+		insertBatches: [][]common.KeyScoreMember{
+			{
+				{Key: "alpha", Score: 11, Member: "one"},
+				{Key: "beta", Score: 22, Member: "two"},
+			},
+		},
+		deleteBatches: [][]common.KeyScoreMember{},
+	})
+	assertCounts(t, "cluster-c", c3.snapshot(), clusterSnapshot{
+		insertCalls: 1,
+		deleteCalls: 0,
+		insertBatches: [][]common.KeyScoreMember{
+			{
+				{Key: "alpha", Score: 11, Member: "one"},
+				{Key: "beta", Score: 22, Member: "two"},
+			},
+		},
+		deleteBatches: [][]common.KeyScoreMember{},
+	})
+	assertInstrumentation(t, instr.snapshot(), instrumentationSnapshot{
+		insertCalls:               1,
+		insertRecordCountTotal:    2,
+		insertCallDurationCalls:   1,
+		insertRecordDurationCalls: 1,
+		insertQuorumFailures:      0,
+		deleteCalls:               0,
+		deleteRecordCountTotal:    0,
+		deleteCallDurationCalls:   0,
+		deleteRecordDurationCalls: 0,
+		deleteQuorumFailures:      0,
+	})
+}
