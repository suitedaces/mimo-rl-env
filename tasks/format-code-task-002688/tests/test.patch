+type scriptedCluster struct {
+	name          string
+	writeErr      error
+	writeDelay    time.Duration
+	mu            sync.Mutex
+	insertCalls   int
+	deleteCalls   int
+	insertBatches [][]common.KeyScoreMember
+	deleteBatches [][]common.KeyScoreMember
+}
+
+func newScriptedCluster(name string, writeErr error, writeDelay time.Duration) *scriptedCluster {
+	return &scriptedCluster{name: name, writeErr: writeErr, writeDelay: writeDelay}
+}
+
+func (c *scriptedCluster) Insert(tuples []common.KeyScoreMember) error {
+	c.mu.Lock()
+	c.insertCalls++
+	c.insertBatches = append(c.insertBatches, cloneBatch(tuples))
+	c.mu.Unlock()
+	time.Sleep(c.writeDelay)
+	return c.writeErr
+}
+
+func (c *scriptedCluster) Delete(tuples []common.KeyScoreMember) error {
+	c.mu.Lock()
+	c.deleteCalls++
+	c.deleteBatches = append(c.deleteBatches, cloneBatch(tuples))
+	c.mu.Unlock()
+	time.Sleep(c.writeDelay)
+	return c.writeErr
+}
