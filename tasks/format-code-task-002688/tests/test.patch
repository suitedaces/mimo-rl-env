+func assertQuorumError(t *testing.T, err error, expectedMessages []string) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("expected non-nil quorum error")
+	}
+	got := fmt.Sprint(err)
+	const prefix = "no quorum ("
+	if !strings.HasPrefix(got, prefix) || !strings.HasSuffix(got, ")") {
+		t.Fatalf("expected quorum error formatted as %q, got %q", "no quorum (<cluster errors>)", got)
+	}
+	body := strings.TrimSuffix(strings.TrimPrefix(got, prefix), ")")
+	parts := strings.Split(body, "; ")
+	if len(parts) != len(expectedMessages) {
+		t.Fatalf("expected quorum errors %v, got %v", expectedMessages, parts)
+	}
+	counts := map[string]int{}
+	for _, msg := range expectedMessages {
+		counts[msg]++
+	}
+	for _, msg := range parts {
+		counts[msg]--
+	}
+	for msg, count := range counts {
+		if count != 0 {
+			t.Fatalf("expected quorum errors %v, got %v; mismatch at %q", expectedMessages, parts, msg)
+		}
+	}
+}
