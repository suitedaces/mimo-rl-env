+func cloneBatch(in []common.KeyScoreMember) []common.KeyScoreMember {
+	out := make([]common.KeyScoreMember, len(in))
+	copy(out, in)
+	return out
+}
+
+func cloneBatches(in [][]common.KeyScoreMember) [][]common.KeyScoreMember {
+	out := make([][]common.KeyScoreMember, len(in))
+	for i := range in {
+		out[i] = cloneBatch(in[i])
+	}
+	return out
+}
