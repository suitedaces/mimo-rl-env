+test('postSynthesize() is invoked on components by default (no disable env var)', () => {
+  withEnv(undefined, () => {
+    const p = new HookSpyProject();
+    const c = new HookSpyComponent(p);
+
+    p.synth();
+
+    expect(c.postCalls).toBe(1);
+    expect(p.projectPostCalls).toBe(1);
+  });
+});
+
+test('disable-post env var (true) skips component.postSynthesize and project.postSynthesize', () => {
+  withEnv('true', () => {
+    const p = new HookSpyProject();
+    const c = new HookSpyComponent(p);
+
+    p.synth();
+
+    expect(c.postCalls).toBe(0);
+    expect(p.projectPostCalls).toBe(0);
+  });
+});
+
+test('disable-post env var (false) still runs postSynthesize hooks', () => {
+  withEnv('false', () => {
+    const p = new HookSpyProject();
+    const c = new HookSpyComponent(p);
+
+    p.synth();
+
+    expect(c.postCalls).toBe(1);
+    expect(p.projectPostCalls).toBe(1);
+  });
+});
+
+test('disable-post env var set to empty string still runs postSynthesize hooks', () => {
+  withEnv('', () => {
+    const p = new HookSpyProject();
+    const c = new HookSpyComponent(p);
+
+    p.synth();
+
+    expect(c.postCalls).toBe(1);
+    expect(p.projectPostCalls).toBe(1);
+  });
+});
+
+test('disable-post env var (true) does not affect synthesize() (only postSynthesize)', () => {
+  withEnv('true', () => {
+    const p = new HookSpyProject();
+    new TextFile(p, 'still-emitted.txt', { lines: ['hi'] });
+
+    p.synth();
+
+
+    const fs = require('fs') as typeof import('fs');
+    expect(fs.existsSync(path.join(p.outdir, 'still-emitted.txt'))).toBe(true);
+  });
