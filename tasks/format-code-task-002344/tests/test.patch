+import { Component, JsonFile, Project, TextFile } from '../src';
 import { TestProject } from './util';
 
+class HookSpyComponent extends Component {
+  public postCalls = 0;
+  public postSynthesize() {
+    this.postCalls += 1;
+  }
+}
+
+class HookSpyProject extends TestProject {
+  public projectPostCalls = 0;
+  public postSynthesize() {
+    this.projectPostCalls += 1;
+  }
+}
+
+
+
+
+const DISABLE_POST_ENV_VARS = [
+  'PROJEN_DISABLE_POST',
+  'PROJEN_DISABLE_POST_SYNTH',
+];
+
+function withEnv(value: string | undefined, fn: () => void) {
+  const prev: Record<string, string | undefined> = {};
+  for (const name of DISABLE_POST_ENV_VARS) {
+    prev[name] = process.env[name];
+    if (value === undefined) {
+      delete process.env[name];
+    } else {
+      process.env[name] = value;
+    }
+  }
+  try {
+    fn();
+  } finally {
+    for (const name of DISABLE_POST_ENV_VARS) {
+      if (prev[name] === undefined) {
+        delete process.env[name];
+      } else {
+        process.env[name] = prev[name];
+      }
+    }
+  }
+}
+
 test('file paths are relative to the project outdir', () => {
   // GIVEN
   const p = new TestProject();
