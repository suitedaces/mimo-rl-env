index 00000000..35d19ca6
--- /dev/null
+++ b/tests/python/common/data/test_wiki_network.py
@@ -0,0 +1,113 @@
+import builtins
+import os
+import unittest
+
+import backend as F
+import dgl
+import pytest
+
+try:
+    import torch
+except ImportError:  # pragma: no cover - tests below skip without torch.
+    torch = None
+
+
+@unittest.skipIf(
+    F._default_context_str == "gpu",
+    reason="Datasets don't need to be tested on GPU.",
+)
+@unittest.skipIf(dgl.backend.backend_name != "pytorch", reason="only supports pytorch")
+def test_chameleon_dataset_public_api_and_basic_graph():
+    from dgl.data import ChameleonDataset
+
+    dataset = ChameleonDataset(force_reload=True)
+    assert len(dataset) == 1
+    g = dataset[0]
+    assert g.num_nodes() == 2277
+    assert hasattr(g, "ndata")
+
+    def mark_graph(graph):
+        graph.ndata["transform_marker"] = torch.ones(
+            graph.num_nodes(), dtype=torch.bool
+        )
+        return graph
+
+    transformed = ChameleonDataset(force_reload=True, transform=mark_graph)[0]
+    assert "transform_marker" in transformed.ndata
+    assert transformed.ndata["transform_marker"].all().item()
+
+
+@unittest.skipIf(
+    F._default_context_str == "gpu",
+    reason="Datasets don't need to be tested on GPU.",
+)
+@unittest.skipIf(dgl.backend.backend_name != "pytorch", reason="only supports pytorch")
+def test_chameleon_node_data_and_num_classes():
+    dataset = dgl.data.ChameleonDataset(force_reload=True)
+    g = dataset[0]
+    assert "feat" in g.ndata
+    assert "label" in g.ndata
+
+    feat = g.ndata["feat"]
+    assert feat.shape[0] == g.num_nodes()
+    assert feat.numel() > 0
+    assert torch.count_nonzero(feat).item() > 0
+
+    label = g.ndata["label"]
+    assert label.shape[0] == g.num_nodes()
+    assert not torch.is_floating_point(label)
+    assert torch.unique(label).numel() > 1
+
+    assert dataset.num_classes == int(label.max().item()) + 1
+    assert dataset.num_classes == 5
+
+
+@unittest.skipIf(
+    F._default_context_str == "gpu",
+    reason="Datasets don't need to be tested on GPU.",
+)
+@unittest.skipIf(dgl.backend.backend_name != "pytorch", reason="only supports pytorch")
+def test_chameleon_split_masks():
+    g = dgl.data.ChameleonDataset(force_reload=True)[0]
+
+    for key in ("train_mask", "val_mask", "test_mask"):
+        assert key in g.ndata
+        mask = g.ndata[key]
+        assert mask.dtype == torch.bool
+        assert tuple(mask.shape) == (g.num_nodes(), 10)
+
+    train_mask = g.ndata["train_mask"]
+    val_mask = g.ndata["val_mask"]
+    test_mask = g.ndata["test_mask"]
+    for split_idx in range(10):
+        train_col = train_mask[:, split_idx]
+        val_col = val_mask[:, split_idx]
+        test_col = test_mask[:, split_idx]
+        assert train_col.any().item()
+        assert val_col.any().item()
+        assert test_col.any().item()
+        assert not torch.logical_and(train_col, val_col).any().item()
+        assert not torch.logical_and(train_col, test_col).any().item()
+        assert not torch.logical_and(val_col, test_col).any().item()
+
+
+def test_chameleon_requires_pytorch_for_processing(monkeypatch, tmp_path):
+    original_import = builtins.__import__
+
+    def import_without_torch(name, *args, **kwargs):
+        if name == "torch":
+            raise ImportError("blocked torch for this test")
+        return original_import(name, *args, **kwargs)
+
+    monkeypatch.setattr(builtins, "__import__", import_without_torch)
+    monkeypatch.setattr(
+        dgl.data.ChameleonDataset,
+        "download",
+        lambda self: os.makedirs(self.raw_path, exist_ok=True),
+    )
+
+    with pytest.raises(ModuleNotFoundError) as excinfo:
+        dgl.data.ChameleonDataset(raw_dir=str(tmp_path), force_reload=True)
+    message = str(excinfo.value)
+    assert "PyTorch" in message or "pytorch" in message
+    assert "backend" in message
