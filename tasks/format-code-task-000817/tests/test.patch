@@ -0,0 +1,29 @@
+import numpy as np
+from scipy import io
+
+import dgl
+
+
+def test_qm7b_loads_legacy_single_raw_file_with_url_distinct_cache_paths(
+    monkeypatch, tmp_path
+):
+    raw_file = tmp_path / "qm7b.mat"
+    io.savemat(
+        raw_file,
+        {
+            "T": np.ones((1, 14), dtype=np.float32),
+            "X": np.array([[[0.0, 1.0], [1.0, 0.0]]], dtype=np.float32),
+        },
+    )
+
+    monkeypatch.setattr(dgl.data.QM7bDataset, "download", lambda self: None)
+
+    dataset = dgl.data.QM7bDataset(
+        raw_dir=str(tmp_path), force_reload=True, verbose=False
+    )
+
+    assert len(dataset) == 1
+    graph, label = dataset[0]
+    assert graph.num_nodes() == 2
+    assert graph.num_edges() == 2
+    assert tuple(label.shape) == (14,)
diff --git a/tests/python/common/data/test_wiki_network.py b/tests/python/common/data/test_wiki_network.py
