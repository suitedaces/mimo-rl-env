--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,35 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+export PYTHONPATH="/testbed/python:/testbed/tests:${PYTHONPATH:-}"
+export DGLBACKEND="pytorch"
+if [ -d /tmp/dgl_extract/dgl ]; then
+  export DGL_LIBRARY_PATH="/tmp/dgl_extract/dgl"
+fi
+
+case "$1" in
+  base)
+    if [ ! -f /testbed/tests/python/common/data/test_wiki_network.py ]; then
+      exit 0
+    fi
+    python3 -m pytest /testbed/tests/python/common/data/test_wiki_network.py -k "not chameleon" -v
+    status=$?
+    if [ "$status" -eq 5 ]; then
+      exit 0
+    fi
+    exit "$status"
+    ;;
+  new)
+    python3 -m pytest \
+      /testbed/tests/python/common/data/test_wiki_network.py \
+      /testbed/tests/python/common/data/test_dgl_dataset_cache_paths.py \
+      /testbed/tests/python/common/data/test_qm7b_single_raw_file.py \
+      /testbed/tests/python/common/data/test_wiki_network_docs.py \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
