@@ -0,0 +1,73 @@
+import os
+
+from dgl.data import DGLDataset
+
+
+class CachePathDataset(DGLDataset):
+    def __init__(self, name, url, raw_dir, save_dir):
+        super().__init__(
+            name=name,
+            url=url,
+            raw_dir=str(raw_dir),
+            save_dir=str(save_dir),
+            force_reload=False,
+            verbose=False,
+        )
+
+    def download(self):
+        pass
+
+    def process(self):
+        pass
+
+    def save(self):
+        pass
+
+    def load(self):
+        pass
+
+    def has_cache(self):
+        return True
+
+    def __getitem__(self, idx):
+        raise IndexError(idx)
+
+    def __len__(self):
+        return 0
+
+
+def test_url_distinct_raw_and_save_paths(tmp_path):
+    raw_dir = tmp_path / "raw"
+    save_dir = tmp_path / "save"
+    ds_a1 = CachePathDataset("toy", "https://example.com/a.zip", raw_dir, save_dir)
+    ds_a2 = CachePathDataset("toy", "https://example.com/a.zip", raw_dir, save_dir)
+    assert ds_a1.raw_path == ds_a2.raw_path
+    assert ds_a1.save_path == ds_a2.save_path
+
+    ds_b = CachePathDataset("toy", "https://example.com/b.zip", raw_dir, save_dir)
+    assert ds_a1.raw_path != ds_b.raw_path
+    assert ds_a1.save_path != ds_b.save_path
+    assert os.path.normpath(ds_a1.raw_path) != os.path.join(str(raw_dir), "toy")
+    assert os.path.normpath(ds_a1.save_path) != os.path.join(str(save_dir), "toy")
+
+    ds_no_url = CachePathDataset("toy", None, raw_dir, save_dir)
+    assert os.path.normpath(ds_no_url.raw_path) == os.path.join(str(raw_dir), "toy")
+    assert os.path.normpath(ds_no_url.save_path) == os.path.join(str(save_dir), "toy")
+
+
+def test_url_change_uses_separate_cache_location(tmp_path):
+    raw_dir = tmp_path / "raw"
+    save_dir = tmp_path / "save"
+    ds_a = CachePathDataset("toy", "https://example.com/a.zip", raw_dir, save_dir)
+    ds_b = CachePathDataset("toy", "https://example.com/b.zip", raw_dir, save_dir)
+
+    assert ds_a.raw_path != ds_b.raw_path
+    assert ds_a.save_path != ds_b.save_path
+
+    os.makedirs(ds_a.raw_path, exist_ok=True)
+    os.makedirs(ds_a.save_path, exist_ok=True)
+    open(os.path.join(ds_a.raw_path, "raw.marker"), "w").close()
+    open(os.path.join(ds_a.save_path, "save.marker"), "w").close()
+
+    assert not os.path.exists(os.path.join(ds_b.raw_path, "raw.marker"))
+    assert not os.path.exists(os.path.join(ds_b.save_path, "save.marker"))
