+
+      const extractResponseSubprotocols = (response: any): string[] => {
+        const values: string[] = [];
+
+        const headerValue =
+          response.headers && response.headers['Sec-WebSocket-Protocol'];
+        const multiHeaderValue =
+          response.multiValueHeaders &&
+          response.multiValueHeaders['Sec-WebSocket-Protocol'];
+
+        if (headerValue != null) {
+          values.push(headerValue);
+        }
+
+        if (multiHeaderValue != null) {
+          values.push(...multiHeaderValue);
+        }
+
+        return values;
+      };
+
+      const createConnectEvent = (overrides: Record<string, unknown> = {}) =>
+        ({
+          ...overrides,
+          requestContext: {
+            connectionId: '1',
+            domainName: 'domain',
+            routeKey: '$connect',
+            stage: 'stage',
+          },
+        } as any);
+
+      it.each(['graphql-ws', 'graphql-transport-ws'])(
+
+        'echoes requested websocket subprotocol header %s',
+        async (subprotocol) => {
+          (connectionManager.registerConnection as jest.Mock).mockResolvedValueOnce(
+            {},
+          );
+
+          const response = await handler(
+            createConnectEvent({
+              headers: {
+                'Sec-WebSocket-Protocol': subprotocol,
+              },
+            }),
+            {} as any,
+          );
+
+          expect(response.statusCode).toBe(200);
+          expect(extractResponseSubprotocols(response)).toContain(subprotocol);
+        },
+      );
+
+      it('echoes requested websocket subprotocol from header values', async () => {
+        const subprotocol = 'graphql-transport-ws';
+        (connectionManager.registerConnection as jest.Mock).mockResolvedValueOnce(
+          {},
+        );
+
+        const response = await handler(
+          createConnectEvent({
+            multiValueHeaders: {
+              'Sec-WebSocket-Protocol': [subprotocol],
+            },
+          }),
+          {} as any,
+        );
+
+        expect(response.statusCode).toBe(200);
+        expect(extractResponseSubprotocols(response)).toContain(subprotocol);
+      });
+
+      it('does not add websocket subprotocol when request omitted it', async () => {
+        (connectionManager.registerConnection as jest.Mock).mockResolvedValueOnce(
+          {},
+        );
+
+        const response = await handler(createConnectEvent(), {} as any);
+
+        expect(response.statusCode).toBe(200);
+        expect(extractResponseSubprotocols(response)).toEqual([]);
+      });
     });
 
