--- a/mypy/test/data/check-inference-context.test
+++ b/mypy/test/data/check-inference-context.test
@@ -730,3 +730,45 @@ def f2(iterable: Iterable[Tuple[str, Any]], **kw: Any) -> None:
     pass
 [builtins fixtures/dict.py]
 [out]
+
+
+-- Lambda in Callable[..., T] context
+-- ----------------------------------
+
+
+[case testLambdaNoArgsInEllipsisCallableContext]
+from typing import TypeVar, Callable
+T = TypeVar('T')
+def foo(arg: Callable[..., T]) -> None: pass
+foo(lambda: 1)
+x = lambda: 1
+foo(x)
+
+[case testLambdaWithArgInEllipsisCallableContext]
+from typing import TypeVar, Callable
+T = TypeVar('T')
+def foo(arg: Callable[..., T]) -> None: pass
+foo(lambda x: 1)
+
+[case testLambdaMultipleArgsInEllipsisCallableContext]
+from typing import TypeVar, Callable
+T = TypeVar('T')
+def foo(arg: Callable[..., T]) -> None: pass
+foo(lambda x, y: 1)
+
+[case testLambdaReturnTypeInferredFromEllipsisCallableContext]
+from typing import TypeVar, Callable
+T = TypeVar('T')
+def foo(arg: Callable[..., T]) -> T: pass
+reveal_type(foo(lambda: 1))  # E: Revealed type is 'builtins.int*'
+reveal_type(foo(lambda x: 'a'))  # E: Revealed type is 'builtins.str*'
+reveal_type(foo(lambda x, y: 1))  # E: Revealed type is 'builtins.int*'
+
+[case testLambdaInSpecificCallableContextStillErrorsOnArgMismatch]
+from typing import TypeVar, Callable
+T = TypeVar('T')
+def bar(arg: Callable[[int], T]) -> None: pass
+bar(lambda: 1)
+[out]
+main:4: error: Cannot infer type of lambda
+main:4: error: Argument 1 to "bar" has incompatible type Callable[[], int]; expected Callable[[int], int]
