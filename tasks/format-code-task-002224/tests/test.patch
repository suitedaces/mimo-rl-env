+
+
+class TestDivisionByObjectArray:
+
+
+
+    def test_truediv_allnat_object_returns_timedelta_array(self):
+
+        arr = pd.array(["NaT", "NaT"], dtype="timedelta64[ns]")
+        result = arr / np.array([2, 2], dtype=object)
+        expected = pd.array(["NaT", "NaT"], dtype="timedelta64[ns]")
+        assert isinstance(result, TimedeltaArray)
+        assert result.dtype == np.dtype("timedelta64[ns]")
+        tm.assert_timedelta_array_equal(result, expected)
+
+    def test_floordiv_allnat_object_returns_timedelta_array(self):
+
+        arr = pd.array(["NaT", "NaT"], dtype="timedelta64[ns]")
+        result = arr // np.array([2, 2], dtype=object)
+        expected = pd.array(["NaT", "NaT"], dtype="timedelta64[ns]")
+        assert isinstance(result, TimedeltaArray)
+        assert result.dtype == np.dtype("timedelta64[ns]")
+        tm.assert_timedelta_array_equal(result, expected)
+
+    def test_truediv_allnat_object_float_divisors(self):
+
+
+        arr = pd.array(["NaT", "NaT"], dtype="timedelta64[ns]")
+        result = arr / np.array([2.0, 2.0], dtype=object)
+        assert isinstance(result, TimedeltaArray)
+        assert result.dtype == np.dtype("timedelta64[ns]")
+        assert result.isna().all()
+
+    def test_floordiv_allnat_object_float_divisors(self):
+        arr = pd.array(["NaT", "NaT"], dtype="timedelta64[ns]")
+        result = arr // np.array([2.0, 2.0], dtype=object)
+        assert isinstance(result, TimedeltaArray)
+        assert result.dtype == np.dtype("timedelta64[ns]")
+        assert result.isna().all()
+
+    def test_truediv_non_nat_object_preserved(self):
+
+
+
+        arr = pd.array(["1 days", "2 days"], dtype="timedelta64[ns]")
+        result = arr / np.array([2, 2], dtype=object)
+        expected = pd.array(["12:00:00", "1 days"], dtype="timedelta64[ns]")
+        assert isinstance(result, TimedeltaArray)
+        tm.assert_timedelta_array_equal(result, expected)
+
+    def test_floordiv_non_nat_object_preserved(self):
+        arr = pd.array(["1 days", "2 days"], dtype="timedelta64[ns]")
+        result = arr // np.array([2, 2], dtype=object)
+        expected = pd.array(["12:00:00", "1 days"], dtype="timedelta64[ns]")
+        assert isinstance(result, TimedeltaArray)
+        tm.assert_timedelta_array_equal(result, expected)
+
+    def test_truediv_allnat_non_object_preserved(self):
+
+
+        arr = pd.array(["NaT", "NaT"], dtype="timedelta64[ns]")
+        result = arr / np.array([2, 2])
+        expected = pd.array(["NaT", "NaT"], dtype="timedelta64[ns]")
+        assert isinstance(result, TimedeltaArray)
+        tm.assert_timedelta_array_equal(result, expected)
+
+    def test_truediv_mixed_nat_object_returns_timedelta_array(self):
+
+
+        arr = pd.array(["NaT", "2 days"], dtype="timedelta64[ns]")
+        result = arr / np.array([2, 2], dtype=object)
+        expected = pd.array(["NaT", "1 days"], dtype="timedelta64[ns]")
+        assert isinstance(result, TimedeltaArray)
+        tm.assert_timedelta_array_equal(result, expected)
+
+    def test_floordiv_mixed_nat_object_returns_timedelta_array(self):
+        arr = pd.array(["NaT", "2 days"], dtype="timedelta64[ns]")
+        result = arr // np.array([2, 2], dtype=object)
+        expected = pd.array(["NaT", "1 days"], dtype="timedelta64[ns]")
+        assert isinstance(result, TimedeltaArray)
+        tm.assert_timedelta_array_equal(result, expected)
