+
+func TestConfigTrustedBuildersCLI_AliasesCoverListAndMutatingSubcommands(t *testing.T) {
+	packHome := newPackHome(t)
+	builder := "example.com/hidden/trusted-alias-builder:one"
+
+	add := runPack(t, packHome, nil, "config", "trust-builder", "add", builder)
+	if add.err != nil {
+		t.Fatalf("trust-builder add failed: %v\n%s", add.err, add.stderr)
+	}
+
+	listAfterAdd := runPack(t, packHome, nil, "config", "trusted-builders")
+	if listAfterAdd.err != nil {
+		t.Fatalf("trusted-builders list after alias add failed: %v\n%s", listAfterAdd.err, listAfterAdd.stderr)
+	}
+	assertContains(t, listAfterAdd.stdout, builder)
+
+	aliasList := runPack(t, packHome, nil, "config", "trust-builders")
+	if aliasList.err != nil {
+		t.Fatalf("trust-builders list failed: %v\n%s", aliasList.err, aliasList.stderr)
+	}
+	assertContains(t, aliasList.stdout, builder)
+
+	remove := runPack(t, packHome, nil, "config", "trust-builders", "remove", builder)
+	if remove.err != nil {
+		t.Fatalf("trust-builders remove failed: %v\n%s", remove.err, remove.stderr)
+	}
+
+	listAfterRemove := runPack(t, packHome, nil, "config", "trusted-builders")
+	if listAfterRemove.err != nil {
+		t.Fatalf("trusted-builders list after alias remove failed: %v\n%s", listAfterRemove.err, listAfterRemove.stderr)
+	}
+	assertNotContains(t, listAfterRemove.stdout, builder)
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,25 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+if ! id testuser >/dev/null 2>&1; then
+    useradd -m testuser
+fi
+
+chmod -R a+rwX /root/go/pkg/mod 2>/dev/null || true
+chmod -R a+rwX /testbed 2>/dev/null || true
+
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 ./cmd
+    ;;
+  new)
+    go test -v -count=1 ./hidden
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
