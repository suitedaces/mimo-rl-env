+func TestConfigDefaultBuilderCLI_UnsetClearsDifferentExistingDefault(t *testing.T) {
+	packHome := newPackHome(t)
+	builder := "example.com/hidden/clear-me-different:one"
+	writeConfig(t, packHome, "default-builder-image = \""+builder+"\"\n")
