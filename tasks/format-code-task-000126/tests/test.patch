@@ -0,0 +1,89 @@
+import sys
+import types
+
+import torch
+import torch.nn as nn
+
+
+def _install_optional_dependency_stubs():
+    diffdist = types.ModuleType("diffdist")
+    diffdist_functional = types.ModuleType("diffdist.functional")
+    diffdist.functional = diffdist_functional
+    sys.modules.setdefault("diffdist", diffdist)
+    sys.modules.setdefault("diffdist.functional", diffdist_functional)
+    sys.modules.setdefault("libmr", types.ModuleType("libmr"))
+    sys.modules.setdefault("faiss", types.ModuleType("faiss"))
+
+
+_install_optional_dependency_stubs()
+
+from openood.postprocessors.opengan_postprocessor import OpenGanPostprocessor
+from openood.postprocessors.utils import get_postprocessor
+from openood.trainers.opengan_trainer import OpenGanTrainer
+from openood.trainers.utils import get_trainer
+
+
+class AttrDict(dict):
+    def __getattr__(self, name):
+        try:
+            value = self[name]
+        except KeyError as exc:
+            raise AttributeError(name) from exc
+        if isinstance(value, dict):
+            value = AttrDict(value)
+            self[name] = value
+        return value
+
+    def __setattr__(self, name, value):
+        self[name] = value
+
+
+def test_opengan_postprocessor_registry_accepts_lowercase_name():
+    config = AttrDict(
+        {
+            "postprocessor": {"name": "opengan"},
+            "network": {"name": "opengan"},
+            "dataset": {"name": "cifar10", "num_classes": 10},
+            "num_classes": 10,
+        }
+    )
+
+    postprocessor = get_postprocessor(config)
+
+    assert isinstance(postprocessor, OpenGanPostprocessor)
+
+
+class TinyGenerator(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(1))
+
+    def forward(self, z):
+        return z[:, :1] * self.weight.view(1, 1, 1, 1)
+
+
+class TinyDiscriminator(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(1))
+
+    def forward(self, x):
+        dims = tuple(range(1, x.ndim))
+        return torch.sigmoid(x.mean(dim=dims, keepdim=True) * self.weight)
+
+
+def test_opengan_trainer_registry_accepts_lowercase_name():
+    config = AttrDict(
+        {
+            "trainer": {"name": "opengan"},
+            "optimizer": {"num_epochs": 1, "lr": 0.001, "beta1": 0.5},
+            "dataset": {"num_classes": 10},
+            "network": {"name": "opengan", "nz": 2},
+            "num_classes": 10,
+        }
+    )
+    net = {"netG": TinyGenerator(), "netD": TinyDiscriminator()}
+
+    trainer = get_trainer(net, [], config)
+
+    assert isinstance(trainer, OpenGanTrainer)
