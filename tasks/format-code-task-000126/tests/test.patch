+++ b/mimo_test_command.sh
@@ -0,0 +1,46 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set +u
+source /testbed/.build_env/.venv/bin/activate
+set -u
+
+
+NEW_TESTS=(
+  tests/test_conf_branch_pipeline.py
+  tests/test_opengan_registry.py
+)
+
+case "${1:-}" in
+  base)
+    base_tests=()
+    if [ -d tests ]; then
+      while IFS= read -r test_file; do
+        skip=false
+        for new_test in "${NEW_TESTS[@]}"; do
+          if [ "$test_file" = "$new_test" ]; then
+            skip=true
+            break
+          fi
+        done
+        if [ "$skip" = false ]; then
+          base_tests+=("$test_file")
+        fi
+      done < <(find tests -type f -name 'test*.py' | sort)
+    fi
+    if [ "${#base_tests[@]}" -eq 0 ]; then
+      echo "No pre-existing tests to run for base regression."
+      exit 0
+    fi
+    python -m pytest -q "${base_tests[@]}"
+    ;;
+  new)
+    python -m pytest -q "${NEW_TESTS[@]}"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
