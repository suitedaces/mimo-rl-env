+use calamine::{Cell, Range};
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+#[test]
+fn codespec_sparse_cells_accept_arbitrary_order_and_last_duplicate_wins() {
+    assert!(Range::<i32>::from_sparse(Vec::new()).is_empty());
+
+    let result = catch_unwind(AssertUnwindSafe(|| {
+        Range::from_sparse(vec![
+            Cell::new((4, 5), 45_i32),
+            Cell::new((2, 2), 20_i32),
+            Cell::new((6, 8), 68_i32),
+            Cell::new((2, 2), 22_i32),
+            Cell::new((3, 7), 37_i32),
+        ])
+    }));
+    assert!(
+        result.is_ok(),
+        "from_sparse must not depend on the first and last cells being row bounds"
+    );
+
+    let range = result.unwrap();
+    assert_eq!(range.start(), Some((2, 2)));
+    assert_eq!(range.end(), Some((6, 8)));
+    assert_eq!(range.get_size(), (5, 7));
+    assert_eq!(range.get_value((2, 2)), Some(&22));
+    assert_eq!(range.get_value((4, 5)), Some(&45));
+    assert_eq!(range.get_value((6, 8)), Some(&68));
+    assert_eq!(range.get_value((5, 4)), Some(&0));
+}
+
+#[test]
+fn codespec_set_value_initializes_an_empty_range() {
+    let result = catch_unwind(AssertUnwindSafe(|| {
+        let mut range = Range::<i32>::empty();
+        range.set_value((7, 11), 711);
+        range
+    }));
+    assert!(result.is_ok(), "set_value must initialize an empty range");
+
+    let range = result.unwrap();
+    assert_eq!(range.start(), Some((7, 11)));
+    assert_eq!(range.end(), Some((7, 11)));
+    assert_eq!(range.get_size(), (1, 1));
+    assert_eq!(range.get_value((7, 11)), Some(&711));
+}
+
+#[test]
+fn codespec_set_value_expands_upward_without_losing_cells() {
+    let result = catch_unwind(AssertUnwindSafe(|| {
+        let mut range = Range::<i32>::new((4, 4), (5, 5));
+        range.set_value((4, 4), 44);
+        range.set_value((5, 5), 55);
+        range.set_value((2, 4), 24);
+        range
+    }));
+    assert!(
+        result.is_ok(),
+        "set_value must grow above the current range"
+    );
+
+    let range = result.unwrap();
+    assert_eq!(range.start(), Some((2, 4)));
+    assert_eq!(range.end(), Some((5, 5)));
+    assert_eq!(range.get_size(), (4, 2));
+    assert_eq!(range.get_value((2, 4)), Some(&24));
+    assert_eq!(range.get_value((4, 4)), Some(&44));
+    assert_eq!(range.get_value((5, 5)), Some(&55));
+    assert_eq!(range.get_value((3, 5)), Some(&0));
+}
+
+#[test]
+fn codespec_set_value_expands_leftward_without_losing_cells() {
+    let result = catch_unwind(AssertUnwindSafe(|| {
+        let mut range = Range::<i32>::new((4, 4), (5, 5));
+        range.set_value((4, 4), 44);
+        range.set_value((5, 5), 55);
+        range.set_value((4, 1), 41);
+        range
+    }));
+    assert!(
+        result.is_ok(),
+        "set_value must grow to the left of the current range"
+    );
+
+    let range = result.unwrap();
+    assert_eq!(range.start(), Some((4, 1)));
+    assert_eq!(range.end(), Some((5, 5)));
+    assert_eq!(range.get_size(), (2, 5));
+    assert_eq!(range.get_value((4, 1)), Some(&41));
+    assert_eq!(range.get_value((4, 4)), Some(&44));
+    assert_eq!(range.get_value((5, 5)), Some(&55));
+    assert_eq!(range.get_value((5, 2)), Some(&0));
+}
+
+#[test]
+fn codespec_set_value_retains_downward_and_rightward_growth() {
+    let mut range = Range::<i32>::new((4, 4), (5, 5));
+    range.set_value((4, 4), 44);
+    range.set_value((7, 5), 75);
+    range.set_value((5, 8), 58);
+
+    assert_eq!(range.start(), Some((4, 4)));
+    assert_eq!(range.end(), Some((7, 8)));
+    assert_eq!(range.get_size(), (4, 5));
+    assert_eq!(range.get_value((4, 4)), Some(&44));
+    assert_eq!(range.get_value((7, 5)), Some(&75));
+    assert_eq!(range.get_value((5, 8)), Some(&58));
+    assert_eq!(range.get_value((6, 7)), Some(&0));
+    assert!(range.rows().all(|row| row.len() == 5));
+}
+
+#[test]
+fn codespec_relative_get_rejects_each_out_of_bounds_dimension() {
+    let range = Range::<i32>::new((10, 20), (11, 21));
+
+    assert_eq!(range.get((0, 0)), Some(&0));
+    assert_eq!(range.get((1, 1)), Some(&0));
+    assert_eq!(range.get((0, 2)), None, "a column may not wrap to the next row");
+    assert_eq!(range.get((2, 0)), None);
+    assert_eq!(range.get((usize::MAX, 0)), None);
+}
+
+#[test]
+fn codespec_subrange_of_empty_range_is_a_default_filled_selection() {
+    let result = catch_unwind(AssertUnwindSafe(|| {
+        Range::<i32>::empty().range((0, 0), (1, 2))
+    }));
+    assert!(
+        result.is_ok(),
+        "selecting coordinates that include the empty range sentinel must not panic"
+    );
+
+    let selected = result.unwrap();
+    assert_eq!(selected.start(), Some((0, 0)));
+    assert_eq!(selected.end(), Some((1, 2)));
+    assert_eq!(selected.get_size(), (2, 3));
+    assert!(selected.cells().all(|(_, _, value)| *value == 0));
+}
+
+#[test]
+fn codespec_growth_keeps_iterators_relative_and_row_major() {
+    let mut range = Range::<i32>::new((4, 4), (4, 4));
+    range.set_value((4, 4), 44);
+    range.set_value((2, 2), 22);
+    range.set_value((5, 6), 56);
+
+    let used: Vec<_> = range
+        .used_cells()
+        .map(|(row, col, value)| (row, col, *value))
+        .collect();
+    assert_eq!(used, vec![(0, 0, 22), (2, 2, 44), (3, 4, 56)]);
+
+    let coordinates: Vec<_> = range.cells().map(|(row, col, _)| (row, col)).collect();
+    assert_eq!(coordinates.len(), 20);
+    assert_eq!(coordinates[0], (0, 0));
+    assert_eq!(coordinates[4], (0, 4));
+    assert_eq!(coordinates[5], (1, 0));
+    assert_eq!(coordinates[19], (3, 4));
+}
