+  describe('input shape preservation (issue #2486)', function() {
+    var OPTIONS = {
+      from: 'en',
+      to: 'es'
+    };
+
+    describe('translate', function() {
+      it('should return a string when input is a single string', function(done) {
+        var apiResponse = {
+          data: {
+            translations: [{ translatedText: 'Hola' }]
+          }
+        };
+        translate.request = function(reqOpts, callback) {
+          callback(null, apiResponse);
+        };
+        translate.translate('Hello', OPTIONS, function(err, translations) {
+          assert.ifError(err);
+          assert.strictEqual(Array.isArray(translations), false);
+          assert.strictEqual(translations, 'Hola');
+          done();
+        });
+      });
+
+      it('should return a single-element array when input is a single-element array', function(done) {
+        var apiResponse = {
+          data: {
+            translations: [{ translatedText: 'Hola' }]
+          }
+        };
+        translate.request = function(reqOpts, callback) {
+          callback(null, apiResponse);
+        };
+        translate.translate(['Hello'], OPTIONS, function(err, translations) {
+          assert.ifError(err);
+          assert.strictEqual(Array.isArray(translations), true);
+          assert.deepEqual(translations, ['Hola']);
+          done();
+        });
+      });
+
+      it('should return an array when input is a multi-element array', function(done) {
+        var apiResponse = {
+          data: {
+            translations: [
+              { translatedText: 'Hola' },
+              { translatedText: 'Adios' }
+            ]
+          }
+        };
+        translate.request = function(reqOpts, callback) {
+          callback(null, apiResponse);
+        };
+        translate.translate(['Hello', 'Goodbye'], OPTIONS, function(err, translations) {
+          assert.ifError(err);
+          assert.strictEqual(Array.isArray(translations), true);
+          assert.deepEqual(translations, ['Hola', 'Adios']);
+          done();
+        });
+      });
+    });
+
+    describe('detect', function() {
+      it('should return a single object when input is a single string', function(done) {
+        var apiResponse = {
+          data: {
+            detections: [
+              [{ language: 'en', confidence: 1 }]
+            ]
+          }
+        };
+        translate.request = function(reqOpts, callback) {
+          callback(null, apiResponse);
+        };
+        translate.detect('Hello', function(err, results) {
+          assert.ifError(err);
+          assert.strictEqual(Array.isArray(results), false);
+          assert.strictEqual(results.language, 'en');
+          assert.strictEqual(results.input, 'Hello');
+          done();
+        });
+      });
+
+      it('should return a single-element array when input is a single-element array', function(done) {
+        var apiResponse = {
+          data: {
+            detections: [
+              [{ language: 'en', confidence: 1 }]
+            ]
+          }
+        };
+        translate.request = function(reqOpts, callback) {
+          callback(null, apiResponse);
+        };
+        translate.detect(['Hello'], function(err, results) {
+          assert.ifError(err);
+          assert.strictEqual(Array.isArray(results), true);
+          assert.strictEqual(results.length, 1);
+          assert.strictEqual(results[0].language, 'en');
+          assert.strictEqual(results[0].input, 'Hello');
+          done();
+        });
+      });
+
+      it('should return an array when input is a multi-element array', function(done) {
+        var apiResponse = {
+          data: {
+            detections: [
+              [{ language: 'en', confidence: 1 }],
+              [{ language: 'es', confidence: 1 }]
+            ]
+          }
+        };
+        translate.request = function(reqOpts, callback) {
+          callback(null, apiResponse);
+        };
+        translate.detect(['Hello', 'Hola'], function(err, results) {
+          assert.ifError(err);
+          assert.strictEqual(Array.isArray(results), true);
+          assert.strictEqual(results.length, 2);
+          done();
+        });
+      });
+    });
+  });
