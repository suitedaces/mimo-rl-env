+class TestBuilderName(unittest.TestCase):
+    """Tests that Builder extracts `_name` as the node name, not as an attribute."""
+
+    def _make_input(self):
+        return ir.Value(
+            name="x", type=ir.TensorType(ir.DataType.FLOAT), shape=ir.Shape((1, 2))
+        )
+
+    def test_single_output_name_sets_node_name(self):
+        builder = _tape.Builder()
+        inp = self._make_input()
+        out = builder.Relu(inp, _name="my_relu_node")
+        node = out.producer()
+        self.assertEqual(node.name, "my_relu_node")
+
+    def test_single_output_name_not_added_as_attribute(self):
+        builder = _tape.Builder()
+        inp = self._make_input()
+        out = builder.Relu(inp, _name="my_relu_node")
+        node = out.producer()
+        attr_names = list(dict(node.attributes).keys())
+        self.assertNotIn("_name", attr_names)
+        self.assertNotIn("name", attr_names)
+
+    def test_multi_output_name_sets_node_name(self):
+        builder = _tape.Builder()
+        inp = self._make_input()
+        outs = builder.Split(inp, _outputs=2, _name="split_node")
+
+        self.assertEqual(outs[0].producer().name, "split_node")
+        self.assertEqual(outs[1].producer().name, "split_node")
+
+    def test_multi_output_name_not_added_as_attribute(self):
+        builder = _tape.Builder()
+        inp = self._make_input()
+        outs = builder.Split(inp, _outputs=2, _name="split_node")
+        node = outs[0].producer()
+        attr_names = list(dict(node.attributes).keys())
+        self.assertNotIn("_name", attr_names)
+        self.assertNotIn("name", attr_names)
+
+    def test_name_coexists_with_other_attributes(self):
+        builder = _tape.Builder()
+        inp = self._make_input()
+        out = builder.SomeOp(inp, alpha=1.5, _name="custom_name")
+        node = out.producer()
+        self.assertEqual(node.name, "custom_name")
+
+        attrs = dict(node.attributes)
+        self.assertIn("alpha", attrs)
+        self.assertNotIn("_name", attrs)
+
+    def test_default_when_name_not_passed(self):
+
+        builder = _tape.Builder()
+        inp = self._make_input()
+        out = builder.Add(inp, inp)
+        node = out.producer()
+        self.assertIsNone(node.name)
+
+        attr_names = list(dict(node.attributes).keys())
+        self.assertNotIn("_name", attr_names)
+        self.assertNotIn("name", attr_names)
+
+
+class TestRewriterNamePropagation(unittest.TestCase):
+    """End-to-end: the issue's reproduction — replacement op can carry a name."""
+
+    def test_replacement_pattern_can_set_node_name(self):
+        import onnx_ir as ir_top
+        from onnxscript.rewriter import pattern, rewrite
+
+        def target_pattern(op, x):
+            return op.Relu(x, _outputs=["relu"])
+
+        def replacement_pattern(op, x, relu):
+            ir_node = relu.producer()
+            return op.Clip(x, _name=ir_node.name)
+
+        rules = [pattern.RewriteRule(target_pattern, replacement_pattern)]
+
+        ir_model = ir_top.from_onnx_text(
+            """
+            < ir_version: 10, opset_import: ["" : 20] >
+            test_model (float[N, 16, 16] X) => (float [N, ?, ?] Y)
+            {
+                Y = Relu(X)
+            }
+        """
+        )
+
+
+
+        ir_model.graph[0].name = "user_supplied_relu_name_xyz"
+
+        ir_model = rewrite(ir_model, rules)
+        new_node = ir_model.graph[0]
+        self.assertEqual(new_node.op_type, "Clip")
+        self.assertEqual(new_node.name, "user_supplied_relu_name_xyz")
+
+        attr_names = list(dict(new_node.attributes).keys())
+        self.assertNotIn("_name", attr_names)
+        self.assertNotIn("name", attr_names)
+
+
 if __name__ == "__main__":
     unittest.main()
