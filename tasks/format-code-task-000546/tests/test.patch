+func sessionHandle(seed byte) *hiveserver.TSessionHandle {
+	return &hiveserver.TSessionHandle{SessionId: handleIdentifier(seed)}
+}
+
+func handleIdentifier(seed byte) *hiveserver.THandleIdentifier {
+	return &hiveserver.THandleIdentifier{
+		GUID:   []byte{seed, seed + 1, seed + 2, seed + 3},
+		Secret: []byte{seed + 4, seed + 5, seed + 6, seed + 7},
+	}
+}
