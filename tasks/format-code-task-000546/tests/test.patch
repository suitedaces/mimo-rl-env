+func TestConnectorConnectRetainsConfigAndExecutesDatabaseSelection(t *testing.T) {
+
+
+	server := startFakeHiveServer(t, nil)
+	cfg := connectorConfig(server)
+	cfg.Database = "analytics"
+
+	connector := gohive.NewConnector(cfg)
+	if got := reflect.TypeOf(connector).String(); got != "*gohive.HiveConnector" {
+		t.Fatalf("connector type = %q, want %q", got, "*gohive.HiveConnector")
+	}
+
+	conn, err := connector.Connect(context.Background())
+	if err != nil {
+		t.Fatalf("Connect returned error: %v", err)
+	}
+
+	if conn == nil {
+		t.Fatal("Connect returned nil driver.Conn")
+	}
+	defer conn.Close()
+
+	openCount, opens, statements, _ := server.service.snapshot()
+	if openCount != 1 {
+		t.Fatalf("open session count = %d, want %d", openCount, 1)
+	}
+	if opens[0].username != "alice" {
+		t.Fatalf("open session username = %q, want %q", opens[0].username, "alice")
+	}
+	if opens[0].password != "secret" {
+		t.Fatalf("open session password = %q, want %q", opens[0].password, "secret")
+	}
+	if !reflect.DeepEqual(opens[0].configuration, map[string]string{"hive.server2.thrift.sasl.qop": "auth-conf", "spark.sql.shuffle.partitions": "9"}) {
+		t.Fatalf("open session configuration = %#v, want %#v", opens[0].configuration, map[string]string{"hive.server2.thrift.sasl.qop": "auth-conf", "spark.sql.shuffle.partitions": "9"})
+	}
+	if !reflect.DeepEqual(statements, []string{"USE analytics"}) {
+		t.Fatalf("statements = %#v, want %#v", statements, []string{"USE analytics"})
+	}
+
+}
