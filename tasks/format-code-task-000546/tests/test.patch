+	}
+
+	if got := strings.HasPrefix(err.Error(), "invalid certification "); got != true || !strings.Contains(err.Error(), invalidCA) {
+		t.Fatalf("invalid PEM error contains certification marker and path = %t, want %t; error=%q", got, true, err.Error())
+	}
