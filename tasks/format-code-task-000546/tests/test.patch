+	}
+	defer defaultConn.Close()
+
+	defaultOpenCount, defaultOpens, defaultStatements, _ := defaultServer.service.snapshot()
+	if defaultOpenCount != 1 {
+		t.Fatalf("default HTTP open session count = %d, want %d", defaultOpenCount, 1)
+	}
+	if defaultOpens[0].username != "http-user" {
+		t.Fatalf("default HTTP username = %q, want %q", defaultOpens[0].username, "http-user")
+	}
+	if defaultOpens[0].password != "http-pass" {
+		t.Fatalf("default HTTP password = %q, want %q", defaultOpens[0].password, "http-pass")
+	}
+
+	if len(defaultStatements) != 0 {
+		t.Fatalf("default HTTP statement count = %d, want %d; statements=%#v", len(defaultStatements), 0, defaultStatements)
+	}
+	defaultPaths := defaultServer.pathSnapshot()
+
+	if len(defaultPaths) != 1 || defaultPaths[0] == "" || defaultPaths[0] == "/" {
+		t.Fatalf("default HTTP request paths = %#v, want one non-empty default path", defaultPaths)
+	}
+
+	customServer := startFakeHTTPHiveServer(t)
+	customCfg := httpConnectorConfig(customServer)
+	customCfg.HTTPPath = "custom/hive"
+
+	customConn, err := gohive.NewConnector(customCfg).Connect(context.Background())
+	if err != nil {
+		t.Fatalf("custom HTTP Connect returned error: %v", err)
+	}
+	defer customConn.Close()
+
+	customOpenCount, customOpens, customStatements, _ := customServer.service.snapshot()
+	if customOpenCount != 1 {
+		t.Fatalf("custom HTTP open session count = %d, want %d", customOpenCount, 1)
+	}
+	if customOpens[0].username != "http-user" {
+		t.Fatalf("custom HTTP username = %q, want %q", customOpens[0].username, "http-user")
+	}
+	if customOpens[0].password != "http-pass" {
+		t.Fatalf("custom HTTP password = %q, want %q", customOpens[0].password, "http-pass")
+	}
+
+	if len(customStatements) != 0 {
+		t.Fatalf("custom HTTP statement count = %d, want %d; statements=%#v", len(customStatements), 0, customStatements)
+	}
+	if !reflect.DeepEqual(customServer.pathSnapshot(), []string{"/custom/hive"}) {
+		t.Fatalf("custom HTTP request paths = %#v, want %#v", customServer.pathSnapshot(), []string{"/custom/hive"})
+	}
+}
