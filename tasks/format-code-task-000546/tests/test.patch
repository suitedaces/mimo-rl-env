+func TestConnectCloseCyclesDoNotLeakFDsOrGoroutines(t *testing.T) {
+
+
+	server := startFakeHiveServer(t, nil)
+	runtime.GC()
+	baseFDs := fdCount(t)
+	baseGoroutines := runtime.NumGoroutine()
+
+	for i := 0; i < 100; i++ {
+		db := gohive.OpenDB(connectorConfig(server))
+		if err := db.PingContext(context.Background()); err != nil {
+			t.Fatalf("PingContext cycle %d returned error: %v", i, err)
+		}
+		if err := db.Close(); err != nil {
+			t.Fatalf("DB Close cycle %d returned error: %v", i, err)
+		}
+	}
+
+	deadline := time.Now().Add(2 * time.Second)
+	var gotFDs int
+	var gotGoroutines int
+	for time.Now().Before(deadline) {
+		runtime.GC()
+		gotFDs = fdCount(t)
+		gotGoroutines = runtime.NumGoroutine()
+		if gotFDs <= baseFDs+8 && gotGoroutines <= baseGoroutines+12 {
+			break
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	if gotFDs > baseFDs+8 {
+		t.Fatalf("fd count after 100 OpenDB/Ping/Close cycles = %d, want <= %d", gotFDs, baseFDs+8)
+	}
+	if gotGoroutines > baseGoroutines+12 {
+		t.Fatalf("goroutine count after 100 OpenDB/Ping/Close cycles = %d, want <= %d", gotGoroutines, baseGoroutines+12)
+	}
+}
