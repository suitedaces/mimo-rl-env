+func (s *fakeHiveService) OpenSession(ctx context.Context, req *hiveserver.TOpenSessionReq) (*hiveserver.TOpenSessionResp, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	cfg := map[string]string{}
+	for k, v := range req.GetConfiguration() {
+		cfg[k] = v
+	}
+	s.openSessions = append(s.openSessions, recordedOpenSession{
+		username:      req.GetUsername(),
+		password:      req.GetPassword(),
+		configuration: cfg,
+	})
+
+	return &hiveserver.TOpenSessionResp{
+		Status:                successStatus(),
+		ServerProtocolVersion: hiveserver.TProtocolVersion_HIVE_CLI_SERVICE_PROTOCOL_V6,
+		SessionHandle:         sessionHandle(byte(len(s.openSessions))),
+	}, nil
+}
+
+func (s *fakeHiveService) ExecuteStatement(ctx context.Context, req *hiveserver.TExecuteStatementReq) (*hiveserver.TExecuteStatementResp, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	statement := req.GetStatement()
+	s.statements = append(s.statements, statement)
+	hasResultSet := strings.HasPrefix(strings.ToUpper(statement), "SELECT")
+	modified := float64(7)
+	return &hiveserver.TExecuteStatementResp{
+		Status: successStatus(),
+		OperationHandle: &hiveserver.TOperationHandle{
+			OperationId:      handleIdentifier(90 + byte(len(s.statements))),
+			OperationType:    hiveserver.TOperationType_EXECUTE_STATEMENT,
+			HasResultSet:     hasResultSet,
+			ModifiedRowCount: &modified,
+		},
+	}, nil
+}
