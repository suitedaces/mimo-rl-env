+	server  *httptest.Server
+	mu      sync.Mutex
+	paths   []string
+}
+
+func startFakeHiveServer(t *testing.T, serverTLS *tls.Config) *fakeHiveServer {
+	t.Helper()
+
+	service := &fakeHiveService{}
+	processor := hiveserver.NewTCLIServiceProcessor(service)
+	var serverTransport thrift.TServerTransport
+	var addrProvider interface{ Addr() net.Addr }
+	var closeProvider interface{ Close() error }
+	var err error
+	if serverTLS == nil {
+		socket, socketErr := thrift.NewTServerSocket("127.0.0.1:0")
+		serverTransport, addrProvider, closeProvider, err = socket, socket, socket, socketErr
+	} else {
+		socket, socketErr := thrift.NewTSSLServerSocket("127.0.0.1:0", serverTLS)
+		serverTransport, addrProvider, closeProvider, err = socket, socket, socket, socketErr
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	server := thrift.NewTSimpleServer4(
+		processor,
+		serverTransport,
+		thrift.NewTBufferedTransportFactory(4096),
+		thrift.NewTBinaryProtocolFactoryDefault(),
+	)
+	if err := server.Listen(); err != nil {
+		t.Fatal(err)
+	}
+
+	tcpAddr := addrProvider.Addr().(*net.TCPAddr)
+	done := make(chan error, 1)
+	go func() {
+		done <- server.AcceptLoop()
+	}()
+	t.Cleanup(func() {
+		_ = closeProvider.Close()
+		if err := server.Stop(); err != nil {
+			t.Fatalf("server stop failed: %v", err)
+		}
+		select {
+		case err := <-done:
+			if err != nil && !strings.Contains(err.Error(), "use of closed network connection") {
+				t.Fatalf("server loop failed: %v", err)
+			}
+		case <-time.After(2 * time.Second):
+			t.Fatal("server loop did not stop")
+		}
+	})
+
+	return &fakeHiveServer{
+		host:    "127.0.0.1",
+		port:    tcpAddr.Port,
+		service: service,
+		server:  server,
+	}
+}
+
+func startFakeHTTPHiveServer(t *testing.T) *fakeHTTPHiveServer {
+	t.Helper()
+
+	service := &fakeHiveService{}
+	processor := hiveserver.NewTCLIServiceProcessor(service)
+	thriftHandler := thrift.NewThriftHandlerFunc(
+		processor,
+		thrift.NewTBinaryProtocolFactoryDefault(),
+		thrift.NewTBinaryProtocolFactoryDefault(),
+	)
+	fake := &fakeHTTPHiveServer{service: service}
+	httpServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		fake.mu.Lock()
+		fake.paths = append(fake.paths, r.URL.Path)
+		fake.mu.Unlock()
+		thriftHandler(w, r)
+	}))
+	t.Cleanup(httpServer.Close)
+
+	host, portText, err := net.SplitHostPort(strings.TrimPrefix(httpServer.URL, "http://"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var port int
+	if _, err := fmt.Sscanf(portText, "%d", &port); err != nil {
+		t.Fatal(err)
+	}
+	fake.host = host
+	fake.port = port
+	fake.server = httpServer
+	return fake
+}
