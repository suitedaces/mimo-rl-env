+func (s *fakeHiveService) snapshot() (int, []recordedOpenSession, []string, int) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	opens := append([]recordedOpenSession(nil), s.openSessions...)
+	statements := append([]string(nil), s.statements...)
+	return len(s.openSessions), opens, statements, s.closeOperations
+}
+
+func (s *fakeHTTPHiveServer) pathSnapshot() []string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return append([]string(nil), s.paths...)
+}
