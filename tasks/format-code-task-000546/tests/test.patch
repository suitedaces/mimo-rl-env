+func (s *fakeHiveService) CloseOperation(ctx context.Context, req *hiveserver.TCloseOperationReq) (*hiveserver.TCloseOperationResp, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.closeOperations++
+	return &hiveserver.TCloseOperationResp{Status: successStatus()}, nil
