+func TestOpenDBUsesConnectorForDatabaseSQLExecAndQuery(t *testing.T) {
+
+
+	server := startFakeHiveServer(t, nil)
+	var db *sql.DB = gohive.OpenDB(connectorConfig(server))
+	if got := reflect.TypeOf(db).String(); got != "*sql.DB" {
+		t.Fatalf("OpenDB type = %q, want %q", got, "*sql.DB")
+	}
+	defer db.Close()
+
+	result, err := db.ExecContext(context.Background(), "CREATE TABLE sample (id INT)")
+	if err != nil {
+		t.Fatalf("ExecContext returned error: %v", err)
+	}
+
+	if result == nil {
+		t.Fatal("ExecContext returned nil Result")
+	}
+
+	rows, err := db.QueryContext(context.Background(), "SELECT id FROM sample")
+	if err != nil {
+		t.Fatalf("QueryContext returned error: %v", err)
+	}
+	if err := rows.Close(); err != nil {
+		t.Fatalf("rows close returned error: %v", err)
+	}
+
+	openCount, _, statements, _ := server.service.snapshot()
+	if openCount != 1 {
+		t.Fatalf("open session count = %d, want %d", openCount, 1)
+	}
+	if !reflect.DeepEqual(statements, []string{"CREATE TABLE sample (id INT)", "SELECT id FROM sample"}) {
+		t.Fatalf("statements = %#v, want %#v", statements, []string{"CREATE TABLE sample (id INT)", "SELECT id FROM sample"})
+	}
+
+}
