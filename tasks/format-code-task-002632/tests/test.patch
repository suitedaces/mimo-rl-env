diff --git a/lib/plugins/aws/deploy/compile/events/schedule/tests/index.js b/lib/plugins/aws/deploy/compile/events/schedule/tests/index.js
index 633435650..cef687c77 100644
--- a/lib/plugins/aws/deploy/compile/events/schedule/tests/index.js
+++ b/lib/plugins/aws/deploy/compile/events/schedule/tests/index.js
@@ -115,5 +115,124 @@ describe('AwsCompileScheduledEvents', () => {
           .Resources
       ).to.deep.equal({});
     });
+
+    it('should accept schedule.input as a string and populate Targets[0].Input', () => {
+      awsCompileScheduledEvents.serverless.service.functions = {
+        first: {
+          events: [
+            {
+              schedule: {
+                rate: 'rate(10 minutes)',
+                enabled: true,
+                input: 'some-string-input',
+              },
+            },
+          ],
+        },
+      };
+
+      awsCompileScheduledEvents.compileScheduledEvents();
+
+      const target = awsCompileScheduledEvents.serverless.service
+        .provider.compiledCloudFormationTemplate.Resources
+        .FirstEventsRuleSchedule1.Properties.Targets[0];
+
+      expect(target.Input).to.equal('some-string-input');
+    });
+
+    it('should accept schedule.input as an object and stringify it to JSON', () => {
+      awsCompileScheduledEvents.serverless.service.functions = {
+        first: {
+          events: [
+            {
+              schedule: {
+                rate: 'rate(10 minutes)',
+                enabled: true,
+                input: {
+                  key1: 'value1',
+                  key2: 'value2',
+                },
+              },
+            },
+          ],
+        },
+      };
+
+      awsCompileScheduledEvents.compileScheduledEvents();
+
+      const target = awsCompileScheduledEvents.serverless.service
+        .provider.compiledCloudFormationTemplate.Resources
+        .FirstEventsRuleSchedule1.Properties.Targets[0];
+
+      expect(target.Input).to.be.a('string');
+      expect(target.Input).to.equal('{"key1":"value1","key2":"value2"}');
+    });
+
+    it('should accept schedule.inputPath and populate Targets[0].InputPath', () => {
+      awsCompileScheduledEvents.serverless.service.functions = {
+        first: {
+          events: [
+            {
+              schedule: {
+                rate: 'rate(10 minutes)',
+                enabled: true,
+                inputPath: '$.stageVariables',
+              },
+            },
+          ],
+        },
+      };
+
+      awsCompileScheduledEvents.compileScheduledEvents();
+
+      const target = awsCompileScheduledEvents.serverless.service
+        .provider.compiledCloudFormationTemplate.Resources
+        .FirstEventsRuleSchedule1.Properties.Targets[0];
+
+      expect(target.InputPath).to.equal('$.stageVariables');
+    });
+
+    it('should throw an error when both input and inputPath are set', () => {
+      awsCompileScheduledEvents.serverless.service.functions = {
+        first: {
+          events: [
+            {
+              schedule: {
+                rate: 'rate(10 minutes)',
+                enabled: true,
+                input: 'some-input',
+                inputPath: '$.stageVariables',
+              },
+            },
+          ],
+        },
+      };
+
+      expect(() => awsCompileScheduledEvents.compileScheduledEvents()).to.throw(Error);
+    });
+
+    it('should not set Input or InputPath when neither is provided', () => {
+      awsCompileScheduledEvents.serverless.service.functions = {
+        first: {
+          events: [
+            {
+              schedule: {
+                rate: 'rate(10 minutes)',
+                enabled: true,
+              },
+            },
+          ],
+        },
+      };
+
+      awsCompileScheduledEvents.compileScheduledEvents();
+
+      const target = awsCompileScheduledEvents.serverless.service
+        .provider.compiledCloudFormationTemplate.Resources
+        .FirstEventsRuleSchedule1.Properties.Targets[0];
+
+      expect(target).to.not.have.property('Input');
+      expect(target).to.not.have.property('InputPath');
+    });
   });
 });
