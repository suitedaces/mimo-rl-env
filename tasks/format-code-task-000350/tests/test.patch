+package usercase_test_coderl
+
+import (
+	_ "crypto/sha256"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/AliyunContainerService/image-syncer/pkg/utils"
+)
+
+
+
+
+
+
+type repoSnapshot struct {
+	String                string
+	Registry              string
+	Repo                  string
+	TagOrDigest           string
+	RepoWithTagOrDigest   string
+	URLWithoutTagOrDigest string
+	HasDigest             bool
+}
+
+type providerCall struct {
+	Registry   string
+	Repository string
+}
+
+func captureRepoURLs(t *testing.T, raw string, tags []string, providerErr error) ([]repoSnapshot, []providerCall, error) {
+	t.Helper()
+
+	var calls []providerCall
+	urls, err := utils.GenerateRepoURLs(raw, func(registry, repository string) ([]string, error) {
+		calls = append(calls, providerCall{Registry: registry, Repository: repository})
+		if providerErr != nil {
+			return nil, providerErr
+		}
+		return tags, nil
+	})
+	if err != nil {
+		return nil, calls, err
+	}
+	return snapshotRepoURLs(urls), calls, nil
+}
+
+func snapshotRepoURLs(urls []*utils.RepoURL) []repoSnapshot {
+	result := make([]repoSnapshot, 0, len(urls))
+	for _, u := range urls {
+		result = append(result, repoSnapshot{
+			String:                u.String(),
+			Registry:              u.GetRegistry(),
+			Repo:                  u.GetRepo(),
+			TagOrDigest:           u.GetTagOrDigest(),
+			RepoWithTagOrDigest:   u.GetRepoWithTagOrDigest(),
+			URLWithoutTagOrDigest: u.GetURLWithoutTagOrDigest(),
+			HasDigest:             u.HasDigest(),
+		})
+	}
+	return result
+}
+
+func requireEqual[T any](t *testing.T, actual, expected T) {
+	t.Helper()
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("mismatch\nactual: %#v\nexpected: %#v", actual, expected)
+	}
+}
+
+
+func requireRepoSpecFields(t *testing.T, actual, expected []repoSnapshot) {
+	t.Helper()
+	if len(actual) != len(expected) {
+		t.Fatalf("unexpected repo count\nactual: %#v\nexpected: %#v", actual, expected)
+	}
+	for i := range expected {
+		if expected[i].String != "" && actual[i].String != expected[i].String {
+			t.Fatalf("entry %d String mismatch\nactual: %q\nexpected: %q", i, actual[i].String, expected[i].String)
+		}
+		if expected[i].Registry != "" && actual[i].Registry != expected[i].Registry {
+			t.Fatalf("entry %d Registry mismatch\nactual: %q\nexpected: %q", i, actual[i].Registry, expected[i].Registry)
+		}
+		if expected[i].Repo != "" && actual[i].Repo != expected[i].Repo {
+			t.Fatalf("entry %d Repo mismatch\nactual: %q\nexpected: %q", i, actual[i].Repo, expected[i].Repo)
+		}
+		if expected[i].TagOrDigest != "" && actual[i].TagOrDigest != expected[i].TagOrDigest {
+			t.Fatalf("entry %d TagOrDigest mismatch\nactual: %q\nexpected: %q", i, actual[i].TagOrDigest, expected[i].TagOrDigest)
+		}
+		if expected[i].RepoWithTagOrDigest != "" && actual[i].RepoWithTagOrDigest != expected[i].RepoWithTagOrDigest {
+			t.Fatalf("entry %d RepoWithTagOrDigest mismatch\nactual: %q\nexpected: %q", i, actual[i].RepoWithTagOrDigest, expected[i].RepoWithTagOrDigest)
+		}
+	}
+}
+
+func requireError(t *testing.T, err error) {
+	t.Helper()
+	if err == nil {
+		t.Fatal("expected non-nil error")
+	}
+}
+
+func requireErrorMentionsAny(t *testing.T, err error, terms ...string) {
+	t.Helper()
+	requireError(t, err)
+	lower := strings.ToLower(err.Error())
+	for _, term := range terms {
+		if strings.Contains(lower, strings.ToLower(term)) {
+			return
+		}
+	}
+	t.Fatalf("error %q did not mention any of %v", err.Error(), terms)
+}
+
+func requireProviderErrorWithContext(t *testing.T, err error, providerMessage string) {
+	t.Helper()
+	requireError(t, err)
+	if !strings.Contains(err.Error(), providerMessage) {
+		t.Fatalf("provider error was not propagated\nactual: %q\nprovider: %q", err.Error(), providerMessage)
+	}
+	if err.Error() == providerMessage {
+		t.Fatalf("provider error lacks contextual wrapping: %q", err.Error())
+	}
+}
+
+func TestGenerateRepoURLsConcreteTagNormalizesDockerHubAndSkipsProvider(t *testing.T) {
+
+
+	actual, calls, err := captureRepoURLs(t, "nginx:v1", []string{"latest"}, nil)
+	if err != nil {
+		t.Fatalf("GenerateRepoURLs returned error: %v", err)
+	}
+
+
+	requireRepoSpecFields(t, actual, []repoSnapshot{{
+		String:      "docker.io/library/nginx:v1",
+		Registry:    "docker.io",
+		Repo:        "library/nginx",
+		TagOrDigest: "v1",
+	}})
+	requireEqual(t, calls, []providerCall(nil))
+}
+
+func TestGenerateRepoURLsMultipleCommaTagsPreservesOrder(t *testing.T) {
+
+
+	actual, calls, err := captureRepoURLs(t, "127.0.0.1:300/library/nginx:v1,v2", []string{"latest"}, nil)
+	if err != nil {
+		t.Fatalf("GenerateRepoURLs returned error: %v", err)
+	}
+
+
+	requireRepoSpecFields(t, actual, []repoSnapshot{
+		{
+			Registry:    "127.0.0.1:300",
+			Repo:        "library/nginx",
+			TagOrDigest: "v1",
+		},
+		{
+			Registry:    "127.0.0.1:300",
+			Repo:        "library/nginx",
+			TagOrDigest: "v2",
+		},
+	})
+	requireEqual(t, calls, []providerCall(nil))
+}
+
+func TestGenerateRepoURLsNoTagExpandsProviderTagsInOrder(t *testing.T) {
+
+
+	actual, calls, err := captureRepoURLs(t, "registry.hub.docker.io/library/nginx", []string{"1.25", "mainline", "stable"}, nil)
+	if err != nil {
+		t.Fatalf("GenerateRepoURLs returned error: %v", err)
+	}
+
+
+	requireRepoSpecFields(t, actual, []repoSnapshot{
+		{
+			Registry:    "registry.hub.docker.io",
+			Repo:        "library/nginx",
+			TagOrDigest: "1.25",
+		},
+		{
+			Registry:    "registry.hub.docker.io",
+			Repo:        "library/nginx",
+			TagOrDigest: "mainline",
+		},
+		{
+			Registry:    "registry.hub.docker.io",
+			Repo:        "library/nginx",
+			TagOrDigest: "stable",
+		},
+	})
+	requireEqual(t, calls, []providerCall{{Registry: "registry.hub.docker.io", Repository: "library/nginx"}})
+}
+
+func TestGenerateRepoURLsNoTagReturnsEmptyWhenProviderHasNoTags(t *testing.T) {
+
+
+	actual, calls, err := captureRepoURLs(t, "registry.hub.docker.io/library/empty", []string{}, nil)
+	if err != nil {
+		t.Fatalf("GenerateRepoURLs returned error: %v", err)
+	}
+
+	requireEqual(t, actual, []repoSnapshot{})
+	requireEqual(t, calls, []providerCall{{Registry: "registry.hub.docker.io", Repository: "library/empty"}})
+}
+
+func TestGenerateRepoURLsRegexFiltersProviderTags(t *testing.T) {
+
+
+	actual, calls, err := captureRepoURLs(t, "test-regex/test:/b+/", []string{"aaa", "bbb"}, nil)
+	if err != nil {
+		t.Fatalf("GenerateRepoURLs returned error: %v", err)
+	}
+
+
+	requireRepoSpecFields(t, actual, []repoSnapshot{{
+		TagOrDigest: "bbb",
+	}})
+
+	if len(calls) != 1 {
+		t.Fatalf("expected provider to be called once for regex expansion, got %#v", calls)
+	}
+}
+
+func TestGenerateRepoURLsDigestPreservesDigestAndAtConnector(t *testing.T) {
+
+
+	actual, calls, err := captureRepoURLs(t, "registry.cn-beijing.aliyuncs.com/hhyasdf/hybridnet@sha256:df2ef9e979fc063645dcbed51374233c6bcf4ab49308c0478702565e96b9bc9e", []string{"latest"}, nil)
+	if err != nil {
+		t.Fatalf("GenerateRepoURLs returned error: %v", err)
+	}
+
+
+	requireRepoSpecFields(t, actual, []repoSnapshot{{
+		Repo:                "hhyasdf/hybridnet",
+		TagOrDigest:         "sha256:df2ef9e979fc063645dcbed51374233c6bcf4ab49308c0478702565e96b9bc9e",
+		RepoWithTagOrDigest: "hhyasdf/hybridnet@sha256:df2ef9e979fc063645dcbed51374233c6bcf4ab49308c0478702565e96b9bc9e",
+	}})
+	requireEqual(t, calls, []providerCall(nil))
+}
+
+func TestGenerateRepoURLsRejectsRegexWithoutTrailingSlash(t *testing.T) {
+
+
+	actual, calls, err := captureRepoURLs(t, "test-regex/test:/b+", []string{"bbb"}, nil)
+	requireEqual(t, actual, []repoSnapshot(nil))
+
+	requireError(t, err)
+	_ = calls
+}
+
+func TestGenerateRepoURLsRejectsInvalidRegex(t *testing.T) {
+
+
+	actual, calls, err := captureRepoURLs(t, "test-regex/test:/[/", []string{"bbb"}, nil)
+	requireEqual(t, actual, []repoSnapshot(nil))
+
+	requireErrorMentionsAny(t, err, "regex", "regexp")
+	_ = calls
+}
+
+func TestGenerateRepoURLsRejectsInvalidRepositoryReference(t *testing.T) {
+
+
+	actual, calls, err := captureRepoURLs(t, "@@@", []string{"latest"}, nil)
+	requireEqual(t, actual, []repoSnapshot(nil))
+
+	requireErrorMentionsAny(t, err, "parse", "reference")
+	_ = calls
+}
+
+func TestGenerateRepoURLsPropagatesProviderErrorWithContext(t *testing.T) {
+
+
+	actual, calls, err := captureRepoURLs(t, "registry.hub.docker.io/library/nginx", nil, errors.New("registry unavailable"))
+	requireEqual(t, actual, []repoSnapshot(nil))
+	requireEqual(t, calls, []providerCall{{Registry: "registry.hub.docker.io", Repository: "library/nginx"}})
+
+	requireProviderErrorWithContext(t, err, "registry unavailable")
+}
+
+func TestGenerateRepoURLsReferentialTransparency(t *testing.T) {
+	first, _, err := captureRepoURLs(t, "registry.hub.docker.io/library/nginx", []string{"1.25", "mainline"}, nil)
+	if err != nil {
+		t.Fatalf("first call returned error: %v", err)
+	}
+	second, _, err := captureRepoURLs(t, "registry.hub.docker.io/library/nginx", []string{"1.25", "mainline"}, nil)
+	if err != nil {
+		t.Fatalf("second call returned error: %v", err)
+	}
+	requireEqual(t, second, first)
+}
+
+func TestGenerateRepoURLsDoesNotMutateProviderReturnedTags(t *testing.T) {
+	providerTags := []string{"1.25", "mainline", "stable"}
+
+	actual, _, err := captureRepoURLs(t, "registry.hub.docker.io/library/nginx", providerTags, nil)
+	if err != nil {
+		t.Fatalf("GenerateRepoURLs returned error: %v", err)
+	}
+
+
+	requireRepoSpecFields(t, actual, []repoSnapshot{
+		{Registry: "registry.hub.docker.io", Repo: "library/nginx", TagOrDigest: "1.25"},
+		{Registry: "registry.hub.docker.io", Repo: "library/nginx", TagOrDigest: "mainline"},
+		{Registry: "registry.hub.docker.io", Repo: "library/nginx", TagOrDigest: "stable"},
+	})
+}
+
+func TestGenerateRepoURLsDoesNotKeepObservableGlobalState(t *testing.T) {
+	expected, _, err := captureRepoURLs(t, "registry.hub.docker.io/library/nginx", []string{"1.25", "mainline"}, nil)
+	if err != nil {
+		t.Fatalf("initial call returned error: %v", err)
+	}
+
+	if _, _, err := captureRepoURLs(t, "127.0.0.1:300/library/nginx:v1,v2", []string{"ignored"}, nil); err != nil {
+		t.Fatalf("noise multi-tag call returned error: %v", err)
+	}
+	if _, _, err := captureRepoURLs(t, "test-regex/test:/b+/", []string{"aaa", "bbb"}, nil); err != nil {
+		t.Fatalf("noise regex call returned error: %v", err)
+	}
+
+	actual, _, err := captureRepoURLs(t, "registry.hub.docker.io/library/nginx", []string{"1.25", "mainline"}, nil)
+	if err != nil {
+		t.Fatalf("repeat call returned error: %v", err)
+	}
+	requireEqual(t, actual, expected)
+}
+
+func TestGenerateRepoURLsDoesNotWriteFilesForConcreteTag(t *testing.T) {
+	tmp := t.TempDir()
+	previous, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd failed: %v", err)
+	}
+	if err := os.Chdir(tmp); err != nil {
+		t.Fatalf("Chdir temp failed: %v", err)
+	}
+	t.Cleanup(func() {
+		if err := os.Chdir(previous); err != nil {
+			t.Fatalf("restore cwd failed: %v", err)
+		}
+	})
+
+	before := listRelativeFiles(t, tmp)
+	urls, err := utils.GenerateRepoURLs("nginx:v1", func(string, string) ([]string, error) {
+		t.Fatalf("provider should not be called for a concrete tag")
+		return nil, nil
+	})
+	if err != nil {
+		t.Fatalf("GenerateRepoURLs returned error: %v", err)
+	}
+
+	requireRepoSpecFields(t, snapshotRepoURLs(urls), []repoSnapshot{{
+		String:      "docker.io/library/nginx:v1",
+		Registry:    "docker.io",
+		Repo:        "library/nginx",
+		TagOrDigest: "v1",
+	}})
+	after := listRelativeFiles(t, tmp)
+	requireEqual(t, after, before)
+}
+
+func listRelativeFiles(t *testing.T, root string) []string {
+	t.Helper()
+
+	var files []string
+	err := filepath.WalkDir(root, func(path string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if path == root {
+			return nil
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		if entry.IsDir() {
+			files = append(files, rel+"/")
+		} else {
+			files = append(files, rel)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("WalkDir failed: %v", err)
+	}
+	sort.Strings(files)
+	return files
+}
