--- a/tests/test_commands.py
+++ b/tests/test_commands.py
@@ -120,3 +120,162 @@ def test_error_is_raised_when_group_subcommand_decorators_are_used_without_paren
         @root.command
         def subcommand():
             pass
+
+
+
+
+
+class _CustomCommand(cloup.Command):
+    def __init__(self, *args, **kwargs):
+        kwargs.setdefault(
+            "context_settings", {"help_option_names": ("--help", "--my-fancy-help")}
+        )
+        super().__init__(*args, **kwargs)
+
+
+class _CustomSubGroup(cloup.Group):
+    pass
+
+
+def test_group_command_decorator_uses_command_class():
+    class CustomGroup(cloup.Group):
+        command_class = _CustomCommand
+
+    @cloup.group(cls=CustomGroup)
+    def my_cli():
+        pass
+
+    @my_cli.command()
+    def subcommand():
+        pass
+
+    cmd = my_cli.commands["subcommand"]
+    assert type(cmd) is _CustomCommand
+    assert isinstance(cmd, _CustomCommand)
+
+
+def test_group_command_decorator_uses_command_class_help_output(runner):
+    """The issue's exact reproduction: --my-fancy-help shows up on subcommand."""
+
+    class CustomGroup(cloup.Group):
+        command_class = _CustomCommand
+
+    @cloup.group(cls=CustomGroup)
+    def my_cli():
+        pass
+
+    @my_cli.command()
+    def subcommand():
+        pass
+
+    res = runner.invoke(my_cli, ["subcommand", "--help"])
+    assert res.exit_code == 0
+    assert "--my-fancy-help" in res.output
+
+
+def test_group_group_decorator_uses_group_class():
+    class CustomGroup(cloup.Group):
+        group_class = _CustomSubGroup
+
+    @cloup.group(cls=CustomGroup)
+    def my_cli():
+        pass
+
+    @my_cli.group()
+    def subgroup():
+        pass
+
+    sg = my_cli.commands["subgroup"]
+    assert type(sg) is _CustomSubGroup
+    assert isinstance(sg, _CustomSubGroup)
+
+
+def test_group_group_decorator_uses_group_class_type_sentinel():
+    """When group_class = type, sub-groups should be instances of the parent's class."""
+
+    class CustomGroup(cloup.Group):
+        group_class = type
+
+    @cloup.group(cls=CustomGroup)
+    def my_cli():
+        pass
+
+    @my_cli.group()
+    def subgroup():
+        pass
+
+    sg = my_cli.commands["subgroup"]
+    assert type(sg) is CustomGroup
+    assert isinstance(sg, CustomGroup)
+
+
+def test_default_group_command_creates_cloup_Command():
+    """Preservation: default Group with no command_class still uses cloup.Command."""
+
+    @cloup.group()
+    def my_cli():
+        pass
+
+    @my_cli.command()
+    def subcommand():
+        pass
+
+    cmd = my_cli.commands["subcommand"]
+    assert type(cmd) is cloup.Command
+
+
+def test_default_group_group_creates_cloup_Group():
+    """Preservation: default Group with no group_class still uses cloup.Group."""
+
+    @cloup.group()
+    def my_cli():
+        pass
+
+    @my_cli.group()
+    def subgroup():
+        pass
+
+    sg = my_cli.commands["subgroup"]
+    assert type(sg) is cloup.Group
+
+
+def test_group_command_explicit_cls_overrides_command_class():
+    """Explicit cls= on @group.command() should win over command_class."""
+
+    class ExplicitCommand(cloup.Command):
+        pass
+
+    class CustomGroup(cloup.Group):
+        command_class = _CustomCommand
+
+    @cloup.group(cls=CustomGroup)
+    def my_cli():
+        pass
+
+    @my_cli.command(cls=ExplicitCommand)
+    def subcommand():
+        pass
+
+    cmd = my_cli.commands["subcommand"]
+    assert type(cmd) is ExplicitCommand
+
+
+def test_group_group_explicit_cls_overrides_group_class():
+    """Explicit cls= on @group.group() should win over group_class."""
+
+    class ExplicitGroup(cloup.Group):
+        pass
+
+    class CustomGroup(cloup.Group):
+        group_class = _CustomSubGroup
+
+    @cloup.group(cls=CustomGroup)
+    def my_cli():
+        pass
+
+    @my_cli.group(cls=ExplicitGroup)
+    def subgroup():
+        pass
+
+    sg = my_cli.commands["subgroup"]
+    assert type(sg) is ExplicitGroup
