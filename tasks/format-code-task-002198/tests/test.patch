diff --git a/pandas/tests/tseries/test_frequencies.py b/pandas/tests/tseries/test_frequencies.py
index 54d12317b0..f5a6ca3644 100644
--- a/pandas/tests/tseries/test_frequencies.py
+++ b/pandas/tests/tseries/test_frequencies.py
@@ -855,3 +855,80 @@ def test_is_superperiod_subperiod():
 
     assert (frequencies.is_superperiod(offsets.Micro(), offsets.Nano()))
     assert (frequencies.is_subperiod(offsets.Nano(), offsets.Micro()))
+
+
+
+def test_to_offset_Y_alias():
+    result = frequencies.to_offset('Y')
+    expected = frequencies.to_offset('A')
+    assert result == expected
+    assert isinstance(result, offsets.YearEnd)
+
+
+def test_to_offset_YS_alias():
+    result = frequencies.to_offset('YS')
+    expected = frequencies.to_offset('AS')
+    assert result == expected
+    assert isinstance(result, offsets.YearBegin)
+
+
+def test_to_offset_BY_alias():
+    result = frequencies.to_offset('BY')
+    expected = frequencies.to_offset('BA')
+    assert result == expected
+    assert isinstance(result, offsets.BYearEnd)
+
+
+def test_to_offset_BYS_alias():
+    result = frequencies.to_offset('BYS')
+    expected = frequencies.to_offset('BAS')
+    assert result == expected
+    assert isinstance(result, offsets.BYearBegin)
+
+
+def test_date_range_freq_Y():
+    result = date_range('2017-01-01', periods=3, freq='Y')
+    expected = date_range('2017-01-01', periods=3, freq='A')
+    tm.assert_index_equal(result, expected)
+
+
+def test_date_range_freq_YS():
+    result = date_range('2017-01-01', periods=3, freq='YS')
+    expected = date_range('2017-01-01', periods=3, freq='AS')
+    tm.assert_index_equal(result, expected)
+
+
+def test_date_range_freq_BY():
+    result = date_range('2017-01-01', periods=3, freq='BY')
+    expected = date_range('2017-01-01', periods=3, freq='BA')
+    tm.assert_index_equal(result, expected)
+
+
+def test_date_range_freq_BYS():
+    result = date_range('2017-01-01', periods=3, freq='BYS')
+    expected = date_range('2017-01-01', periods=3, freq='BAS')
+    tm.assert_index_equal(result, expected)
+
+
+def test_period_str_to_code_Y():
+    assert frequencies._period_str_to_code('Y') == 1000
+    assert (frequencies._period_str_to_code('Y') ==
+            frequencies._period_str_to_code('A'))
+
+
+def test_period_str_to_code_Y_month():
+
+    assert (frequencies._period_str_to_code('Y-DEC') ==
+            frequencies._period_str_to_code('A-DEC'))
+    assert (frequencies._period_str_to_code('Y-JAN') ==
+            frequencies._period_str_to_code('A-JAN'))
+    assert (frequencies._period_str_to_code('Y-MAY') ==
+            frequencies._period_str_to_code('A-MAY'))
+
+
+def test_A_alias_still_works():
+
+    assert frequencies.to_offset('A') == offsets.YearEnd()
+    assert frequencies.to_offset('AS') == offsets.YearBegin()
+    assert frequencies.to_offset('BA') == offsets.BYearEnd()
+    assert frequencies.to_offset('BAS') == offsets.BYearBegin()
