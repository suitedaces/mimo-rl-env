+package usercase_test_coderl
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/brettbuddin/shaden/lisp"
+	"github.com/brettbuddin/shaden/lisp/builtin"
+)
+
+const fixtures = "/workspace/repo/usercase-test-coderl/fixtures"
+
+
+
+
+
+
+func newLoadedEnv(t *testing.T, loadPath ...string) *lisp.Environment {
+	t.Helper()
+	t.Setenv("SHADEN_LISP_PATH", strings.Join(loadPath, string(filepath.ListSeparator)))
+	env := lisp.NewEnvironment()
+	builtin.Load(env)
+	return env
+}
+
+func evalSource(t *testing.T, env *lisp.Environment, source string) (any, error) {
+	t.Helper()
+	node, err := lisp.Parse(bytes.NewBufferString(source))
+	if err != nil {
+		t.Fatalf("parse setup source: %v", err)
+	}
+	return env.Eval(node)
+}
+
+func requireNoError(t *testing.T, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
+
+func requireEqual(t *testing.T, want, got any) {
+	t.Helper()
+	if fmt.Sprintf("%#v", got) != fmt.Sprintf("%#v", want) {
+		t.Fatalf("got %#v, want %#v", got, want)
+	}
+}
+
+
+func requireErrorContains(t *testing.T, err error, parts ...string) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("got nil error, want error containing %q", parts)
+	}
+	message := err.Error()
+	for _, part := range parts {
+		if !strings.Contains(message, part) {
+			t.Fatalf("got error %q, want it to contain %q", message, part)
+		}
+	}
+}
+
+func countOpenFDs(t *testing.T) int {
+	t.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		t.Fatalf("count /proc/self/fd: %v", err)
+	}
+	return len(entries)
+}
+
+func TestLoadPathInitializedFromEnvironment(t *testing.T) {
+
+
+	env := newLoadedEnv(t, fixtures+"/one", fixtures+"/two")
+
+	got, err := env.GetSymbol("load-path")
+	requireNoError(t, err)
+	requireEqual(t, lisp.List{fixtures + "/one", fixtures + "/two"}, got)
+}
+
+func TestLoadSearchesDefaultPathAndEvaluatesFileInSameEnvironment(t *testing.T) {
+
+
+	env := newLoadedEnv(t, fixtures+"/missing", fixtures)
+
+	got, err := evalSource(t, env, `(load "testdata/load-example.lisp")`)
+	requireNoError(t, err)
+	requireEqual(t, 2, got)
+
+	got, err = evalSource(t, env, `(load "testdata/stateful-define.lisp") loaded-value`)
+	requireNoError(t, err)
+	requireEqual(t, 41, got)
+}
+
+func TestLoadUsesReplacedLoadPathForRelativeFiles(t *testing.T) {
+
+
+	env := newLoadedEnv(t, fixtures)
+
+	got, err := evalSource(t, env, `(set! load-path (list "/workspace/repo/usercase-test-coderl/fixtures/testdata/load-path/")) (load "load-path-example.lisp")`)
+	requireNoError(t, err)
+	requireEqual(t, 2, got)
+
+	loadPath, err := env.GetSymbol("load-path")
+	requireNoError(t, err)
+	requireEqual(t, lisp.List{"/workspace/repo/usercase-test-coderl/fixtures/testdata/load-path/"}, loadPath)
+}
+
+func TestLoadEvaluatesPathArgumentBeforeOpening(t *testing.T) {
+
+
+	env := newLoadedEnv(t, fixtures)
+
+	got, err := evalSource(t, env, `(define file-name "testdata/evaluated-name.lisp") (load file-name)`)
+	requireNoError(t, err)
+	requireEqual(t, 15, got)
+}
+
+func TestLoadArgumentErrorsAreSpecific(t *testing.T) {
+
+
+	env := newLoadedEnv(t, fixtures)
+
+	_, err := evalSource(t, env, `(load)`)
+
+	requireErrorContains(t, err, "load", "1", "0")
+
+	_, err = evalSource(t, env, `(load "a" "b")`)
+
+	requireErrorContains(t, err, "load", "1", "2")
+
+	_, err = evalSource(t, env, `(load 123)`)
+
+	requireErrorContains(t, err, "load", "string")
+
+	_, err = evalSource(t, env, `(load missing-path-symbol)`)
+
+	requireErrorContains(t, err, "missing-path-symbol")
+	if strings.Contains(err.Error(), "load-path") {
+		t.Fatalf("got path lookup error %q, want evaluated argument failure before file lookup", err.Error())
+	}
+}
+
+func TestBuiltinLoadRegistersLoadForm(t *testing.T) {
+
+
+	t.Setenv("SHADEN_LISP_PATH", fixtures)
+	env := lisp.NewEnvironment()
+	builtin.Load(env)
+
+	got, err := evalSource(t, env, `(load "testdata/load-example.lisp")`)
+
+	requireNoError(t, err)
+	requireEqual(t, 2, got)
+}
+
+func TestLoadMissingFileReportsPathAndLoadPath(t *testing.T) {
+
+
+	env := newLoadedEnv(t, fixtures)
+
+	_, err := evalSource(t, env, `(load "testdata/doesntexist.lisp")`)
+
+	requireErrorContains(t, err, "testdata/doesntexist.lisp", "load-path")
+}
+
+func TestLoadParseAndEvaluationFailuresIncludeFileContext(t *testing.T) {
+
+
+	env := newLoadedEnv(t, fixtures+"/bad")
+
+	_, err := evalSource(t, env, `(load "parse-error.lisp")`)
+
+	requireErrorContains(t, err, "parse-error.lisp")
+
+	_, err = evalSource(t, env, `(load "eval-error.lisp")`)
+
+	requireErrorContains(t, err, "eval-error.lisp", "missing-symbol")
+}
+
+func TestLoadPathStateIsIndependentAcrossEnvironments(t *testing.T) {
+
+
+	a := newLoadedEnv(t, fixtures)
+	b := newLoadedEnv(t, fixtures)
+
+	got, err := evalSource(t, a, `(set! load-path (list "/workspace/repo/usercase-test-coderl/fixtures/testdata/load-path/")) (load "load-path-example.lisp")`)
+	requireNoError(t, err)
+	requireEqual(t, 2, got)
+
+	aPath, err := a.GetSymbol("load-path")
+	requireNoError(t, err)
+	requireEqual(t, lisp.List{"/workspace/repo/usercase-test-coderl/fixtures/testdata/load-path/"}, aPath)
+
+	bPath, err := b.GetSymbol("load-path")
+	requireNoError(t, err)
+	requireEqual(t, lisp.List{fixtures}, bPath)
+}
+
+func TestLoadCanBeCalledRepeatedlyOnSameEnvironment(t *testing.T) {
+
+
+	env := newLoadedEnv(t, fixtures)
+
+	got, err := evalSource(t, env, `(load "testdata/load-example.lisp") (load "testdata/load-example.lisp")`)
+	requireNoError(t, err)
+	requireEqual(t, 2, got)
+}
+
+func TestLoadRepeatedCyclesDoNotLeakFileDescriptors(t *testing.T) {
+
+
+	runtime.GC()
+	before := countOpenFDs(t)
+
+	for i := 0; i < 150; i++ {
+		env := newLoadedEnv(t, fixtures)
+		got, err := evalSource(t, env, `(load "testdata/load-example.lisp")`)
+		requireNoError(t, err)
+		requireEqual(t, 2, got)
+	}
+
+	runtime.GC()
+	after := countOpenFDs(t)
+	if after > before+4 {
+		t.Fatalf("open file descriptors grew from %d to %d, want at most %d", before, after, before+4)
+	}
+}
