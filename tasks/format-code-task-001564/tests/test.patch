+func TestComputeRetryDelayOverflow(t *testing.T) {
+	hs := test.NewTestService(t, "http://localhost:8888")
+	opts := write.DefaultOptions()
+	srv := NewService("my-org", "my-bucket", hs, opts)
+
+
+
+	assert.NotPanics(t, func() {
+		assert.EqualValues(t, opts.MaxRetryInterval(), srv.computeRetryDelay(51))
+	})
+
+
+
+	assert.NotPanics(t, func() {
+		assert.EqualValues(t, opts.MaxRetryInterval(), srv.computeRetryDelay(64))
+	})
+
+
+	assert.NotPanics(t, func() {
+		d := srv.computeRetryDelay(100)
+		assert.LessOrEqual(t, d, opts.MaxRetryInterval())
+	})
+
+
+	assert.NotPanics(t, func() {
+		d := srv.computeRetryDelay(0)
+		assert.True(t, d >= 5_000 && d <= 10_000)
+	})
+}
