+import boto3
+import pytest
+from botocore.exceptions import ClientError
+
+from moto import mock_rds
+
+
+@mock_rds
+def test_create_db_instance_mismatch_engine_aurora_postgresql_raises():
+
+    client = boto3.client("rds", "us-east-1")
+    client.create_db_cluster(
+        DBClusterIdentifier="test-cluster",
+        Engine="aurora-postgresql",
+        EngineVersion="12.14",
+        MasterUsername="test-user",
+        MasterUserPassword="password",
+    )
+    with pytest.raises(ClientError) as exc:
+        client.create_db_instance(
+            DBClusterIdentifier="test-cluster",
+            Engine="mysql",
+            EngineVersion="12.14",
+            DBInstanceIdentifier="test-instance",
+            DBInstanceClass="db.t4g.medium",
+        )
+    err = exc.value.response["Error"]
+    assert err["Code"] == "InvalidParameterCombination"
+
+    assert "mysql" in err["Message"]
+    assert "aurora-postgresql" in err["Message"]
+
+
+@mock_rds
+def test_create_db_instance_matching_engine_aurora_postgresql_succeeds():
+    client = boto3.client("rds", "us-east-1")
+    client.create_db_cluster(
+        DBClusterIdentifier="test-cluster",
+        Engine="aurora-postgresql",
+        EngineVersion="12.14",
+        MasterUsername="test-user",
+        MasterUserPassword="password",
+    )
+
+    client.create_db_instance(
+        DBClusterIdentifier="test-cluster",
+        Engine="aurora-postgresql",
+        DBInstanceIdentifier="test-instance",
+        DBInstanceClass="db.t4g.medium",
+    )
+    cluster = client.describe_db_clusters()["DBClusters"][0]
+    members = cluster["DBClusterMembers"]
+    assert len(members) == 1
+    assert members[0]["DBInstanceIdentifier"] == "test-instance"
+
+
+@mock_rds
+def test_create_db_instance_mismatch_engine_non_aurora_cluster_raises():
+
+
+    client = boto3.client("rds", "us-east-1")
+    client.create_db_cluster(
+        DBClusterIdentifier="dbci",
+        Engine="mysql",
+        MasterUsername="masterusername",
+        MasterUserPassword="hunter2_",
+    )
+    with pytest.raises(ClientError) as exc:
+        client.create_db_instance(
+            DBInstanceIdentifier="dbi",
+            DBClusterIdentifier="dbci",
+            DBInstanceClass="db.r5.large",
+            Engine="postgres",
+        )
+    err = exc.value.response["Error"]
+    assert err["Code"] == "InvalidParameterCombination"
+    assert "postgres" in err["Message"]
+    assert "mysql" in err["Message"]
+
+
+@mock_rds
+def test_create_db_instance_mismatch_engine_aurora_mysql_raises():
+
+    client = boto3.client("rds", "us-east-1")
+    client.create_db_cluster(
+        DBClusterIdentifier="amc",
+        Engine="aurora-mysql",
+        MasterUsername="u",
+        MasterUserPassword="password",
+    )
+    with pytest.raises(ClientError) as exc:
+        client.create_db_instance(
+            DBInstanceIdentifier="ami",
+            DBClusterIdentifier="amc",
+            DBInstanceClass="db.r5.large",
+            Engine="aurora-postgresql",
+        )
+    err = exc.value.response["Error"]
+    assert err["Code"] == "InvalidParameterCombination"
