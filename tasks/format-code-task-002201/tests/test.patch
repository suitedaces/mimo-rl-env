+    def test_astype_column_metadata(self):
+
+
+        columns = pd.UInt64Index([100, 200, 300], name='foo')
+        df = DataFrame(np.arange(9).reshape(3, 3), columns=columns)
+        original_columns = df.columns.copy()
+
+        result = df.astype({100: 'float64', 200: 'uint64'})
+
+
+
+        tm.assert_index_equal(result.columns, original_columns)
+        assert isinstance(result.columns, pd.UInt64Index)
+        assert result.columns.name == 'foo'
+        assert result.columns.dtype == np.uint64
+
+
+        assert result.dtypes[100] == np.float64
+        assert result.dtypes[200] == np.uint64
+
+    def test_astype_column_metadata_categorical(self):
+
+
+        columns = pd.UInt64Index([100, 200, 300], name='foo')
+        df = DataFrame(np.arange(9).reshape(3, 3), columns=columns)
+        original_columns = df.columns.copy()
+
+        result = df.astype('category')
+
+        tm.assert_index_equal(result.columns, original_columns)
+        assert isinstance(result.columns, pd.UInt64Index)
+        assert result.columns.name == 'foo'
+        assert result.columns.dtype == np.uint64
+
+
+        for col in result.columns:
+            assert isinstance(result[col].dtype, CategoricalDtype)
+
