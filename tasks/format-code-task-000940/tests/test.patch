+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+export BUNDLE_APP_CONFIG="${BUNDLE_APP_CONFIG:-/usr/local/bundle}"
+export BUNDLE_GEMFILE=/workspace/repo/Gemfile
+unset BUNDLE_PATH
+unset BUNDLE_DEPLOYMENT
+unset BUNDLE_WITHOUT
+unset BUNDLE_ONLY
+export BUNDLE_FROZEN=true
+export BUNDLE_DISABLE_VERSION_CHECK=true
+export GEM_HOME="${GEM_HOME:-/usr/local/bundle}"
+export GEM_PATH="${GEM_PATH:-/usr/local/bundle:/usr/local/lib/ruby/gems/3.3.0}"
+
+if ! bundle check >/dev/null 2>&1; then
+  echo "Bundled gems are not installed locally; refusing to install during offline test run." >&2
+  exit 1
+fi
+exec bundle exec ruby /workspace/repo/usercase-test-coderl/skunk_score_acceptance_test.rb
