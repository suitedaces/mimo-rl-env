diff --git a/usercase-test-coderl/skunk_score_acceptance_test.rb b/usercase-test-coderl/skunk_score_acceptance_test.rb
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/skunk_score_acceptance_test.rb
@@ -0,0 +1,452 @@
+# frozen_string_literal: true
+
+
+
+
+
+
+
+
+
+require "fileutils"
+require "json"
+require "minitest/autorun"
+require "open3"
+require "pathname"
+require "rbconfig"
+require "tmpdir"
+
+require "rubycritic/configuration"
+require "skunk/rubycritic/analysed_module"
+require "skunk/rubycritic/analysed_modules_collection"
+
+class SkunkScoreAcceptanceTest < Minitest::Test
+  FIXTURE_ROOT = "usercase-test-coderl/fixtures/project"
+
+  def setup
+    RubyCritic::Config.ruby_extensions = [".rb"]
+  end
+
+  def test_skunk_score_uses_rounded_cost_at_perfect_coverage
+
+
+    analysed_module = module_fixture("lib/rounded.rb", cost: 2.345, coverage: 100, churn: 1)
+
+    assert_equal 2.35, analysed_module.skunk_score
+  end
+
+  def test_skunk_score_for_cost_100_and_full_coverage
+
+
+    analysed_module = module_fixture("lib/full.rb", cost: 100, coverage: 100, churn: 1)
+
+    assert_equal 100.0, analysed_module.skunk_score
+  end
+
+  def test_skunk_score_for_cost_100_and_zero_coverage
+
+
+    analysed_module = module_fixture("lib/none.rb", cost: 100, coverage: 0, churn: 1)
+
+    assert_equal 10_000.0, analysed_module.skunk_score
+  end
+
+  def test_skunk_score_and_penalty_factor_for_partial_coverage
+
+
+    analysed_module = module_fixture("lib/partial.rb", cost: 100, coverage: 75, churn: 1)
+
+    assert_equal 25, analysed_module.penalty_factor
+    assert_equal 2_500.0, analysed_module.skunk_score
+  end
+
+  def test_penalty_factor_truncates_fractional_coverage_to_integer
+
+
+    analysed_module = module_fixture("lib/fractional.rb", cost: 12.345, coverage: 87.65, churn: 4)
+
+    assert_equal 13, analysed_module.penalty_factor
+    assert_equal 160.49, analysed_module.skunk_score
+  end
+
+  def test_churn_times_cost_with_positive_churn
+
+
+    analysed_module = module_fixture("lib/churn_three.rb", cost: 2.34, coverage: 100, churn: 3)
+
+    assert_equal 7.02, analysed_module.churn_times_cost
+  end
+
+  def test_churn_times_cost_treats_zero_churn_as_one
+
+
+    analysed_module = module_fixture("lib/churn_zero.rb", cost: 2.34, coverage: 100, churn: 0)
+
+    assert_equal 2.34, analysed_module.churn_times_cost
+  end
+
+  def test_churn_times_cost_treats_negative_churn_as_one
+
+
+    analysed_module = module_fixture("lib/churn_negative.rb", cost: 2.34, coverage: 100, churn: -4)
+
+    assert_equal 2.34, analysed_module.churn_times_cost
+  end
+
+  def test_module_to_hash_exports_all_rounded_skunk_fields
+
+
+    analysed_module = module_fixture("app/models/order.rb", cost: 12.345, coverage: 87.65, churn: 4)
+
+
+    assert_hash_fields(
+      {
+        file: "app/models/order.rb",
+        skunk_score: 160.49,
+        churn_times_cost: 49.38,
+        churn: 4,
+        cost: 12.35,
+        coverage: 87.65
+      },
+      analysed_module.to_hash
+    )
+  end
+
+  def test_collection_metrics_ignore_test_files_and_rank_worst_first
+
+
+    collection = fixture_collection
+
+    assert_equal 2, collection.analysed_modules_count
+    assert_equal 30.0, collection.skunk_score_total
+    assert_equal 15.0, collection.skunk_score_average
+    assert_equal 12.0, collection.total_churn_times_cost
+    assert_equal(
+      [
+        "usercase-test-coderl/fixtures/project/lib/b.rb",
+        "usercase-test-coderl/fixtures/project/lib/a.rb"
+      ],
+      collection.sorted_modules.map { |analysed_module| analysed_module.pathname.to_s }
+    )
+
+
+    assert_equal "usercase-test-coderl/fixtures/project/lib/b.rb", collection.worst_module.pathname.to_s
+  end
+
+  def test_collection_excludes_every_declared_test_path_shape_from_public_lists
+
+
+    collection = fixture_collection
+
+
+
+    assert_equal(
+      [
+        "usercase-test-coderl/fixtures/project/lib/a.rb",
+        "usercase-test-coderl/fixtures/project/lib/b.rb"
+      ],
+      collection.non_test_modules.map { |analysed_module| analysed_module.pathname.to_s }.sort
+    )
+
+
+    assert_equal(
+      [
+        {
+          file: "usercase-test-coderl/fixtures/project/lib/b.rb",
+          skunk_score: 20.0,
+          churn_times_cost: 7.0,
+          churn: 35,
+          cost: 0.2,
+          coverage: 0.0
+        },
+        {
+          file: "usercase-test-coderl/fixtures/project/lib/a.rb",
+          skunk_score: 10.0,
+          churn_times_cost: 5.0,
+          churn: 50,
+          cost: 0.1,
+          coverage: 0.0
+        }
+      ],
+      spec_file_hashes(collection.files_as_hash)
+    )
+  end
+
+  def test_collection_excludes_paths_under_directories_beginning_with_test_or_spec
+
+
+    Dir.mktmpdir do |directory|
+      Dir.chdir(directory) do
+        FileUtils.mkdir_p(["spec", "test", "source"])
+        File.write("spec/starts_spec.rb", "class StartsSpec\nend\n")
+        File.write("test/starts_test.rb", "class StartsTest\nend\n")
+        File.write("source/live.rb", "class Live\nend\n")
+
+        modules = [
+          module_fixture("spec/starts_spec.rb", cost: 1.11, coverage: 0, churn: 1),
+          module_fixture("test/starts_test.rb", cost: 2.22, coverage: 0, churn: 1),
+          module_fixture("source/live.rb", cost: 0.44, coverage: 0, churn: 2)
+        ]
+        collection = RubyCritic::AnalysedModulesCollection.new(
+          ["spec/starts_spec.rb", "test/starts_test.rb", "source/live.rb"],
+          modules
+        )
+
+        assert_equal ["source/live.rb"], collection.non_test_modules.map { |analysed_module| analysed_module.pathname.to_s }
+        assert_equal 1, collection.analysed_modules_count
+        assert_equal 44.0, collection.skunk_score_total
+        assert_equal 0.88, collection.total_churn_times_cost
+      end
+    end
+  end
+
+  def test_empty_collection_returns_zero_average_and_nil_worst_module
+
+
+    collection = RubyCritic::AnalysedModulesCollection.new([], [])
+
+    assert_equal 0, collection.analysed_modules_count
+    assert_equal 0, collection.skunk_score_total
+    assert_equal 0.0, collection.skunk_score_average
+    assert_equal 0, collection.total_churn_times_cost
+    assert_nil collection.worst_module
+    assert_equal [], collection.sorted_modules
+    assert_equal [], collection.files_as_hash
+  end
+
+  def test_collection_to_hash_exports_summary_and_sorted_file_hashes
+
+
+    collection = fixture_collection
+
+    actual = collection.to_hash
+
+
+
+    assert_hash_fields(
+      {
+        analysed_modules_count: 2,
+        skunk_score_total: 30.0,
+        skunk_score_average: 15.0,
+        total_churn_times_cost: 12.0,
+        worst_score: 20.0
+      },
+      actual
+    )
+    assert_equal "usercase-test-coderl/fixtures/project/lib/b.rb", hash_value(actual, :worst_pathname).to_s
+    assert_equal(
+      [
+        {
+          file: "usercase-test-coderl/fixtures/project/lib/b.rb",
+          skunk_score: 20.0,
+          churn_times_cost: 7.0,
+          churn: 35,
+          cost: 0.2,
+          coverage: 0.0
+        },
+        {
+          file: "usercase-test-coderl/fixtures/project/lib/a.rb",
+          skunk_score: 10.0,
+          churn_times_cost: 5.0,
+          churn: 50,
+          cost: 0.1,
+          coverage: 0.0
+        }
+      ],
+      spec_file_hashes(hash_value(actual, :files))
+    )
+  end
+
+  def test_metric_methods_are_public_zero_argument_methods
+    analysed_module = module_fixture("lib/zero_argument.rb", cost: 1.0, coverage: 100, churn: 1)
+    collection = RubyCritic::AnalysedModulesCollection.new(["lib/zero_argument.rb"], [analysed_module])
+
+
+
+    %i[skunk_score penalty_factor churn_times_cost to_hash].each do |method_name|
+      assert analysed_module.respond_to?(method_name), "#{method_name} should be public"
+      assert_equal 0, analysed_module.method(method_name).arity
+    end
+    %i[
+      analysed_modules_count
+      skunk_score_total
+      skunk_score_average
+      total_churn_times_cost
+      worst_module
+      sorted_modules
+      non_test_modules
+      files_as_hash
+      to_hash
+    ].each do |method_name|
+      assert collection.respond_to?(method_name), "#{method_name} should be public"
+      assert_equal 0, collection.method(method_name).arity
+    end
+  end
+
+  def test_referential_transparency_for_same_module_metrics
+    analysed_module = module_fixture("lib/repeatable.rb", cost: 3.21, coverage: 45.5, churn: 6)
+
+
+
+    assert_equal spec_file_hashes([analysed_module.to_hash]), spec_file_hashes([analysed_module.to_hash])
+  end
+
+  def test_metric_methods_do_not_mutate_caller_visible_module_attributes
+    analysed_module = module_fixture("lib/no_mutation.rb", cost: 4.56, coverage: 78.9, churn: 2)
+    before = visible_module_attributes(analysed_module)
+
+    analysed_module.skunk_score
+    analysed_module.penalty_factor
+    analysed_module.churn_times_cost
+    analysed_module.to_hash
+
+    assert_equal before, visible_module_attributes(analysed_module)
+  end
+
+  def test_same_input_matches_fresh_ruby_process_after_in_process_noise
+    analysed_module = module_fixture("lib/fresh_process.rb", cost: 6.78, coverage: 91.2, churn: 3)
+    in_process = analysed_module.to_hash
+
+    module_fixture("lib/noise_a.rb", cost: 100, coverage: 0, churn: 1).to_hash
+    module_fixture("lib/noise_b.rb", cost: 2.34, coverage: 100, churn: 0).to_hash
+
+    stdout, stderr, status = Open3.capture3(
+      RbConfig.ruby,
+      "-I/workspace/repo/lib",
+      "-e",
+      fresh_process_script
+    )
+
+    assert status.success?, stderr
+
+
+    assert_hash_fields(
+      {
+        file: "lib/fresh_process.rb",
+        skunk_score: 61.02,
+        churn_times_cost: 20.34,
+        churn: 3,
+        cost: 6.78,
+        coverage: 91.2
+      },
+      in_process
+    )
+    assert_hash_fields(
+      {
+        file: "lib/fresh_process.rb",
+        skunk_score: 61.02,
+        churn_times_cost: 20.34,
+        churn: 3,
+        cost: 6.78,
+        coverage: 91.2
+      },
+      JSON.parse(stdout, symbolize_names: true)
+    )
+  end
+
+  def test_metric_methods_return_spec_fields_for_relative_path
+    Dir.mktmpdir do |directory|
+      Dir.chdir(directory) do
+        analysed_module = module_fixture("side_effect_probe.rb", cost: 1.25, coverage: 70, churn: 4)
+
+        assert_equal 37.5, analysed_module.skunk_score
+        assert_equal 5.0, analysed_module.churn_times_cost
+
+
+        assert_hash_fields(
+          {
+            file: "side_effect_probe.rb",
+            skunk_score: 37.5,
+            churn_times_cost: 5.0,
+            churn: 4,
+            cost: 1.25,
+            coverage: 70.0
+          },
+          analysed_module.to_hash
+        )
+      end
+    end
+  end
+
+  private
+
+  def module_fixture(path, cost:, coverage:, churn:)
+    RubyCritic::AnalysedModule.new(
+      pathname: Pathname.new(path),
+      complexity: cost * 25.0,
+      coverage: coverage,
+      churn: churn,
+      methods_count: 1,
+      name: path
+    )
+  end
+
+  def fixture_collection
+    modules = [
+      module_fixture("#{FIXTURE_ROOT}/lib/a.rb", cost: 0.10, coverage: 0, churn: 50),
+      module_fixture("#{FIXTURE_ROOT}/lib/b.rb", cost: 0.20, coverage: 0, churn: 35),
+      module_fixture("#{FIXTURE_ROOT}/test/a_test.rb", cost: 9.99, coverage: 0, churn: 1),
+      module_fixture("#{FIXTURE_ROOT}/spec/b_spec.rb", cost: 8.88, coverage: 0, churn: 1),
+      module_fixture("#{FIXTURE_ROOT}/engines/orders/spec/nested_sample.rb", cost: 7.77, coverage: 0, churn: 1),
+      module_fixture("#{FIXTURE_ROOT}/app/models/account_spec.rb", cost: 6.66, coverage: 0, churn: 1),
+      module_fixture("#{FIXTURE_ROOT}/app/models/account_test.rb", cost: 5.55, coverage: 0, churn: 1)
+    ]
+
+    RubyCritic::AnalysedModulesCollection.new([FIXTURE_ROOT], modules)
+  end
+
+  def visible_module_attributes(analysed_module)
+    {
+      pathname: analysed_module.pathname,
+      coverage: analysed_module.coverage,
+      churn: analysed_module.churn,
+      cost: analysed_module.cost
+    }
+  end
+
+  def assert_hash_fields(expected, actual)
+    assert_kind_of Hash, actual
+    expected.each do |key, expected_value|
+      assert_equal expected_value, hash_value(actual, key)
+    end
+  end
+
+  def spec_file_hashes(files)
+    files.map do |file_hash|
+      {
+        file: hash_value(file_hash, :file),
+        skunk_score: hash_value(file_hash, :skunk_score),
+        churn_times_cost: hash_value(file_hash, :churn_times_cost),
+        churn: hash_value(file_hash, :churn),
+        cost: hash_value(file_hash, :cost),
+        coverage: hash_value(file_hash, :coverage)
+      }
+    end
+  end
+
+  def hash_value(hash, key)
+    return hash.fetch(key) if hash.key?(key)
+
+    hash.fetch(key.to_s)
+  end
+
+  def fresh_process_script
+    <<~RUBY
+      require "json"
+      require "pathname"
+      require "skunk/rubycritic/analysed_module"
+
+      analysed_module = RubyCritic::AnalysedModule.new(
+        pathname: Pathname.new("lib/fresh_process.rb"),
+        complexity: 6.78 * 25.0,
+        coverage: 91.2,
+        churn: 3,
+        methods_count: 1,
+        name: "lib/fresh_process.rb"
+      )
+
+      STDOUT.write(JSON.generate(analysed_module.to_hash))
+    RUBY
+  end
+
+end
