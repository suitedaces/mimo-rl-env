diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,56 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+dev-switch python3 3.11
+
+
+if ! command -v g++-15 >/dev/null 2>&1; then
+    apt-get update
+    apt-get install -y gcc-15 g++-15
+fi
+export CC=gcc-15
+export CXX=g++-15
+
+
+if [ ! -d /testbed/.build_env/.venv ]; then
+    python3 -m venv /testbed/.build_env/.venv
+fi
+set +u
+source /testbed/.build_env/.venv/bin/activate
+set -u
+
+
+pip install --quiet setuptools
+
+
+python3 setup.py build_ext --inplace 2>&1 | tail -5
+
+
+case "${1:-}" in
+  base)
+    rm -rf TEST_TMP/run/cpp/cpp_stl_vector*
+    python3 runtests.py --no-c \
+      cpp_stl_vector
+    ;;
+  new)
+    rm -rf \
+      TEST_TMP/run/cpp/cpp_stl_numeric_ops_cpp17* \
+      TEST_TMP/run/cpp/cpp_stl_numeric_ops_cpp20* \
+      TEST_TMP/run/cpp/cpp_stl_associated_containers_contains_cpp20* \
+      TEST_TMP/run/cpp/cpp_stl_string_cpp20* \
+      TEST_TMP/run/cpp/cpp_stl_string_cpp23*
+    python3 runtests.py --no-c \
+      cpp_stl_numeric_ops_cpp17 \
+      cpp_stl_numeric_ops_cpp20 \
+      cpp_stl_associated_containers_contains_cpp20 \
+      cpp_stl_string_cpp20 \
+      cpp_stl_string_cpp23
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
