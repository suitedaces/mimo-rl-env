@@ -0,0 +1,143 @@
+from pathlib import Path
+
+import pytest
+
+from wikidict.parse import process
+
+
+LANGUAGE_SECTION = "== {{langue|fr}} =="
+
+
+def write_dump(tmp_path: Path, namespace: str, pages: str) -> Path:
+    path = tmp_path / "pages-codespec.xml"
+    xml = f'<mediawiki xmlns="{namespace}">{pages}</mediawiki>'
+    path.write_text(xml, encoding="utf-8")
+    return path
+
+
+def legacy_page(title: str, text: str, namespace: int = 0) -> str:
+    return f"""
+    <page>
+      <title>{title}</title><ns>{namespace}</ns><id>1</id>
+      <revision>
+        <id>2</id><parentid>1</parentid><timestamp>2024-01-01T00:00:00Z</timestamp>
+        <contributor><username>Editor</username><id>3</id></contributor>
+        <comment>edit</comment><model>wikitext</model><format>text/x-wiki</format>
+        <text xml:space="preserve">{text}</text>
+      </revision>
+    </page>
+    """
+
+
+@pytest.mark.parametrize(
+    "namespace",
+    [
+        "http://www.mediawiki.org/xml/export-0.10/",
+        "http://www.mediawiki.org/xml/export-0.11/",
+    ],
+)
+def test_codespec_accepts_supported_export_namespaces(tmp_path, namespace):
+    dump = write_dump(tmp_path, namespace, legacy_page("bonjour", LANGUAGE_SECTION))
+
+    assert process(dump, "fr") == {"bonjour": LANGUAGE_SECTION}
+
+
+def test_codespec_reads_main_slot_with_reordered_optional_metadata(tmp_path):
+    pages = f"""
+    <page>
+      <id>10</id><ns>0</ns><title>moderne</title>
+      <revision>
+        <timestamp>2024-01-01T00:00:00Z</timestamp><id>11</id>
+        <slots>
+          <slot role="auxiliary">
+            <model>json</model><format>application/json</format>
+            <text>{{"ignored": true}}</text>
+          </slot>
+          <slot role="main">
+            <format>text/x-wiki</format>
+            <text bytes="24" xml:space="preserve">{LANGUAGE_SECTION}</text>
+            <model>wikitext</model>
+          </slot>
+        </slots>
+      </revision>
+    </page>
+    """
+    dump = write_dump(
+        tmp_path, "http://www.mediawiki.org/xml/export-0.11/", pages
+    )
+
+    assert process(dump, "fr") == {"moderne": LANGUAGE_SECTION}
+
+
+def test_codespec_legacy_revision_does_not_require_metadata_positions(tmp_path):
+    pages = f"""
+    <page>
+      <ns>0</ns><title>minimal</title><id>20</id>
+      <revision>
+        <text xml:space="preserve">{LANGUAGE_SECTION}</text><id>21</id>
+      </revision>
+    </page>
+    """
+    dump = write_dump(
+        tmp_path, "http://www.mediawiki.org/xml/export-0.10/", pages
+    )
+
+    assert process(dump, "fr") == {"minimal": LANGUAGE_SECTION}
+
+
+def test_codespec_filters_pages_by_numeric_namespace(tmp_path):
+    pages = "".join(
+        [
+            legacy_page("reconstruction:mot", LANGUAGE_SECTION, namespace=0),
+            legacy_page("Sandbox", LANGUAGE_SECTION, namespace=2),
+        ]
+    )
+    dump = write_dump(
+        tmp_path, "http://www.mediawiki.org/xml/export-0.10/", pages
+    )
+
+    assert process(dump, "fr") == {"reconstruction:mot": LANGUAGE_SECTION}
+
+
+def test_codespec_skips_explicit_redirects(tmp_path):
+    pages = f"""
+    <page>
+      <title>redirected</title><ns>0</ns><id>30</id>
+      <redirect title="target"/>
+      <revision><id>31</id><text>{LANGUAGE_SECTION}</text></revision>
+    </page>
+    {legacy_page("retained", LANGUAGE_SECTION)}
+    """
+    dump = write_dump(
+        tmp_path, "http://www.mediawiki.org/xml/export-0.10/", pages
+    )
+
+    assert process(dump, "fr") == {"retained": LANGUAGE_SECTION}
+
+
+@pytest.mark.parametrize(
+    "incomplete_page",
+    [
+        "<page><title>missing revision</title><ns>0</ns><id>40</id></page>",
+        """<page><title>missing text</title><ns>0</ns><id>50</id>
+        <revision><id>51</id><comment>unfinished</comment></revision></page>""",
+        """<page><title>empty text</title><ns>0</ns><id>60</id>
+        <revision><id>61</id><text/></revision></page>""",
+    ],
+    ids=["missing-revision", "missing-text", "empty-text"],
+)
+def test_codespec_skips_incomplete_pages_without_losing_later_pages(
+    tmp_path, incomplete_page
+):
+    pages = f"""
+    {incomplete_page}
+    <page>
+      <title>retained</title><ns>0</ns><id>70</id>
+      <revision><id>71</id><text>{LANGUAGE_SECTION}</text></revision>
+    </page>
+    """
+    dump = write_dump(
+        tmp_path, "http://www.mediawiki.org/xml/export-0.10/", pages
+    )
+
+    assert process(dump, "fr") == {"retained": LANGUAGE_SECTION}
