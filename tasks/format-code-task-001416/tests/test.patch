diff --git a/usercase-test-coderl/test_asx_action_adapters.py b/usercase-test-coderl/test_asx_action_adapters.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_asx_action_adapters.py
@@ -0,0 +1,232 @@
+import gc
+import tracemalloc
+
+import numpy as np
+
+from asx_gym.envs import (
+    AsxAction,
+    AsxTransaction,
+    BUY_STOCK,
+    HOLD_STOCK,
+    SELL_STOCK,
+    TOP_UP_FUND,
+    WITHDRAW_FUND,
+)
+
+
+
+
+
+
+
+
+
+def _empty_env_action(size=3):
+    return {
+        "company_count": 0,
+        "end_batch": 0,
+        "company_id": np.array([0] * size, dtype=np.int64),
+        "volume": np.array([0.0] * size, dtype=np.float32),
+        "price": np.array([0.0] * size, dtype=np.float32),
+        "stock_operation": np.array([0] * size, dtype=np.int64),
+    }
+
+
+def test_transaction_json_formats_all_operation_labels_and_rounds_values():
+
+
+
+
+    transactions = [
+        AsxTransaction("7", BUY_STOCK, 12.345, 6.789),
+        AsxTransaction("7", SELL_STOCK, 12.345, 6.789),
+        AsxTransaction("7", HOLD_STOCK, 12.345, 6.789),
+        AsxTransaction("7", TOP_UP_FUND, 12.345, 6.789),
+        AsxTransaction("7", WITHDRAW_FUND, 12.345, 6.789),
+        AsxTransaction("7", 99, 12.345, 6.789),
+    ]
+
+    assert [tx.to_json_obj() for tx in transactions] == [
+        {"company_id": 7, "stock_operation": "buy", "volume": 12.35, "price": 6.79},
+        {"company_id": 7, "stock_operation": "sell", "volume": 12.35, "price": 6.79},
+        {"company_id": 7, "stock_operation": "hold", "volume": 12.35, "price": 6.79},
+        {"company_id": 7, "stock_operation": "top_up", "volume": 12.35, "price": 6.79},
+        {"company_id": 7, "stock_operation": "withdraw", "volume": 12.35, "price": 6.79},
+        {"company_id": 7, "stock_operation": "unknown", "volume": 12.35, "price": 6.79},
+    ]
+
+
+def test_action_session_adds_transactions_then_copies_to_env_action_in_order():
+
+
+
+
+    action = AsxAction(1)
+    assert action.to_json_obj() == {"end_batch": 1, "transactions": []}
+
+    action.add_transaction(AsxTransaction(7, BUY_STOCK, 3, 10.5))
+    assert action.to_json_obj() == {
+        "end_batch": 1,
+        "transactions": [
+            {"company_id": 7, "stock_operation": "buy", "volume": 3.0, "price": 10.5}
+        ],
+    }
+
+    action.add_transaction(AsxTransaction(8, SELL_STOCK, 4, 9.25))
+    assert action.to_json_obj() == {
+        "end_batch": 1,
+        "transactions": [
+            {"company_id": 7, "stock_operation": "buy", "volume": 3.0, "price": 10.5},
+            {"company_id": 8, "stock_operation": "sell", "volume": 4.0, "price": 9.25},
+        ],
+    }
+
+    env_action = _empty_env_action()
+    returned = action.copy_to_env_action(env_action)
+
+    assert returned is env_action
+    assert env_action["company_count"] == 2
+    assert env_action["end_batch"] == 1
+    assert env_action["company_id"][:2].tolist() == [7, 8]
+    assert env_action["volume"][:2].tolist() == [3.0, 4.0]
+    assert env_action["price"][:2].tolist() == [10.5, 9.25]
+    assert env_action["stock_operation"][:2].tolist() == [1, 2]
+
+
+def test_from_env_action_reconstructs_ordered_session_and_json():
+
+
+
+
+    env_action = {
+        "company_count": 3,
+        "end_batch": 0,
+        "company_id": np.array([4, 5, 6], dtype=np.int64),
+        "volume": np.array([1.111, 2.222, 3.333], dtype=np.float32),
+        "price": np.array([8.888, 9.999, 10.555], dtype=np.float32),
+        "stock_operation": np.array([HOLD_STOCK, TOP_UP_FUND, WITHDRAW_FUND], dtype=np.int64),
+    }
+
+    action = AsxAction.from_env_action(env_action)
+
+    assert action.to_json_obj() == {
+        "end_batch": 0,
+        "transactions": [
+            {"company_id": 4, "stock_operation": "hold", "volume": 1.11, "price": 8.89},
+            {"company_id": 5, "stock_operation": "top_up", "volume": 2.22, "price": 10.0},
+            {"company_id": 6, "stock_operation": "withdraw", "volume": 3.33, "price": 10.56},
+        ],
+    }
+
+
+def test_from_env_action_zero_company_count_yields_empty_session():
+
+
+
+
+    env_action = {
+        "company_count": 0,
+        "end_batch": 0,
+        "company_id": np.array([9, 9], dtype=np.int64),
+        "volume": np.array([9.0, 9.0], dtype=np.float32),
+        "price": np.array([9.0, 9.0], dtype=np.float32),
+        "stock_operation": np.array([9, 9], dtype=np.int64),
+    }
+
+    action = AsxAction.from_env_action(env_action)
+
+    assert action.to_json_obj() == {"end_batch": 0, "transactions": []}
+
+
+def test_separate_asx_actions_do_not_share_transaction_lists():
+
+
+
+
+    a = AsxAction(1)
+    b = AsxAction(0)
+
+    a.add_transaction(AsxTransaction(7, BUY_STOCK, 3, 10.5))
+    a.add_transaction(AsxTransaction(8, SELL_STOCK, 4, 9.25))
+    b.add_transaction(AsxTransaction(3, HOLD_STOCK, 1, 2.345))
+
+    assert a.to_json_obj() == {
+        "end_batch": 1,
+        "transactions": [
+            {"company_id": 7, "stock_operation": "buy", "volume": 3.0, "price": 10.5},
+            {"company_id": 8, "stock_operation": "sell", "volume": 4.0, "price": 9.25},
+        ],
+    }
+    assert b.to_json_obj() == {
+        "end_batch": 0,
+        "transactions": [
+            {"company_id": 3, "stock_operation": "hold", "volume": 1.0, "price": 2.35}
+        ],
+    }
+
+
+def test_from_env_action_reads_required_indexed_arrays():
+
+
+
+
+    env_action = {
+        "company_count": 1,
+        "end_batch": 1,
+        "company_id": np.array([12], dtype=np.int64),
+        "volume": np.array([2.5], dtype=np.float32),
+        "price": np.array([7.25], dtype=np.float32),
+        "stock_operation": np.array([BUY_STOCK], dtype=np.int64),
+    }
+
+    action = AsxAction.from_env_action(env_action)
+
+
+    assert action.to_json_obj() == {
+        "end_batch": 1,
+        "transactions": [
+            {"company_id": 12, "stock_operation": "buy", "volume": 2.5, "price": 7.25}
+        ],
+    }
+
+
+def test_repeated_adapter_sessions_do_not_accumulate_hidden_heap_state():
+
+
+
+
+
+    def exercise_session_once(i):
+        action = AsxAction(i % 2)
+        action.add_transaction(AsxTransaction(7, BUY_STOCK, 3, 10.5))
+        action.add_transaction(AsxTransaction(8, SELL_STOCK, 4, 9.25))
+        env_action = {
+            "company_count": 0,
+            "end_batch": 0,
+            "company_id": [0, 0],
+            "volume": [0.0, 0.0],
+            "price": [0.0, 0.0],
+            "stock_operation": [0, 0],
+        }
+        action.copy_to_env_action(env_action)
+        AsxAction.from_env_action(env_action).to_json_obj()
+
+    for i in range(20):
+        exercise_session_once(i)
+
+    gc.collect()
+    tracemalloc.start()
+    gc.collect()
+    start_current, _ = tracemalloc.get_traced_memory()
+
+    for i in range(250):
+        exercise_session_once(i)
+        if i % 25 == 0:
+            gc.collect()
+
+    gc.collect()
+    end_current, _ = tracemalloc.get_traced_memory()
+    tracemalloc.stop()
+
+
+    assert end_current - start_current <= 64 * 1024
