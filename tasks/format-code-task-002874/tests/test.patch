+def test_install_uses_quiet_flag(newconfig, mocksession):
+    """The conda install command should use --quiet to avoid polluting the log
+    with carriage-return progress-bar output (see issue about log pollution)."""
+    config = newconfig(
+        [],
+        """
+        [testenv:py123]
+        conda_deps=
+            pytest
+            asdf
+    """,
+    )
+
+    venv, action, pcalls = create_test_env(config, mocksession, "py123")
+
+    tox_testenv_install_deps(action=action, venv=venv)
+    assert len(pcalls) >= 1
+
+    call = pcalls[0]
+    conda_cmd = call.args
+    assert "conda" in os.path.split(conda_cmd[0])[-1]
+    assert "install" in conda_cmd
+    assert "--quiet" in conda_cmd, (
+        "conda install should include --quiet to suppress progress bar output; "
+        "got args: {!r}".format(conda_cmd)
+    )
+
+
