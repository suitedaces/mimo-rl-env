+@skipIfNoModule("soundfile")
+class TestInfoEncoding(TempDirMixin, PytorchTestCase):
+    """Tests for the new `encoding` attribute on AudioMetaData via soundfile_backend.info."""
+
+    @parameterize(
+        [
+            ('PCM_16', 'PCM_S'),
+            ('PCM_24', 'PCM_S'),
+            ('PCM_32', 'PCM_S'),
+            ('PCM_U8', 'PCM_U'),
+            ('FLOAT', 'PCM_F'),
+            ('DOUBLE', 'PCM_F'),
+            ('ULAW', 'ULAW'),
+            ('ALAW', 'ALAW'),
+        ],
+    )
+    def test_wav_encoding(self, subtype_and_encoding):
+        """WAV subtypes map to the correct ``encoding`` string."""
+        subtype, expected_encoding = subtype_and_encoding
+        sample_rate = 8000
+        num_channels = 1
+        num_frames = sample_rate
+        data = torch.randn(num_frames, num_channels).numpy()
+        path = self.get_temp_path(f"data_{subtype}.wav")
+        soundfile.write(path, data, sample_rate, subtype=subtype)
+
+        info = soundfile_backend.info(path)
+        assert info.encoding == expected_encoding, (
+            f"Expected encoding {expected_encoding} for subtype {subtype}, got {info.encoding}"
+        )
+
+    @skipIfFormatNotSupported("FLAC")
+    def test_flac_encoding(self):
+        """FLAC files report encoding 'FLAC' (driven by `format`, not `subtype`)."""
+        sample_rate = 8000
+        num_channels = 1
+        data = torch.randn(sample_rate, num_channels).numpy()
+        path = self.get_temp_path("data.flac")
+        soundfile.write(path, data, sample_rate)
+
+        info = soundfile_backend.info(path)
+        assert info.encoding == "FLAC", f"Expected 'FLAC', got {info.encoding!r}"
+
+    @skipIfFormatNotSupported("OGG")
+    def test_ogg_vorbis_encoding(self):
+        """OGG/Vorbis files report encoding 'VORBIS'."""
+        sample_rate = 8000
+        num_channels = 1
+        data = torch.randn(sample_rate, num_channels).numpy()
+        path = self.get_temp_path("data.ogg")
+        soundfile.write(path, data, sample_rate)
+
+        info = soundfile_backend.info(path)
+        assert info.encoding == "VORBIS", f"Expected 'VORBIS', got {info.encoding!r}"
+
+    @skipIfFormatNotSupported("NIST")
+    def test_nist_encoding(self):
+        """NIST/Sphere files with PCM subtype report encoding 'PCM_S'."""
+        sample_rate = 8000
+        num_channels = 1
+        data = torch.randn(sample_rate, num_channels).numpy()
+        path = self.get_temp_path("data.nist")
+        soundfile.write(path, data, sample_rate, subtype="PCM_24")
+
+        info = soundfile_backend.info(path)
+        assert info.encoding == "PCM_S", f"Expected 'PCM_S', got {info.encoding!r}"
+
+    def test_unknown_subtype_encoding(self):
+        """Unknown subtype yields encoding 'UNKNOWN'."""
+        def _mock_info_func(_):
+            class MockSoundFileInfo:
+                samplerate = 8000
+                frames = 356
+                channels = 2
+                subtype = 'UNSEEN_SUBTYPE'
+                format = 'UNSEEN_FORMAT'
+            return MockSoundFileInfo()
+
+        with patch("soundfile.info", _mock_info_func):
+            with warnings.catch_warnings(record=True):
+                info = soundfile_backend.info("foo")
+        assert info.encoding == "UNKNOWN", f"Expected 'UNKNOWN', got {info.encoding!r}"
+
+
