diff --git a/test_commands.json b/test_commands.json
new file mode 100644
index 0000000..929c182
--- /dev/null
+++ b/test_commands.json
@@ -0,0 +1,3 @@
+{
+  "test_commands": ["python -m pytest tests/test_core.py -k \"set_crs and (no_spatial_partitions or preserves_spatial_partitions or updates_spatial_partitions or geoseries_preserves)\" -v"]
+}
diff --git a/tests/test_core.py b/tests/test_core.py
index f882443..ffc6a5d 100644
--- a/tests/test_core.py
+++ b/tests/test_core.py
@@ -378,3 +378,64 @@ def test_geoseries_apply(geoseries_polygons):
 def test_geodataframe_html_repr(geodf_points):
     dask_obj = dask_geopandas.from_geopandas(geodf_points, npartitions=2)
     assert "Dask-GeoPandas GeoDataFrame" in dask_obj._repr_html_()
+
+
+def test_set_crs_no_spatial_partitions(geodf_points):
+
+
+    dask_obj = dask_geopandas.from_geopandas(geodf_points, npartitions=2)
+    assert dask_obj.spatial_partitions is None
+    new = dask_obj.set_crs("EPSG:4326")
+    assert new.spatial_partitions is None
+    assert new.crs == "EPSG:4326"
+
+
+def test_set_crs_preserves_spatial_partitions(geodf_points):
+
+    dask_obj = dask_geopandas.from_geopandas(geodf_points, npartitions=2)
+    dask_obj.calculate_spatial_partitions()
+    assert dask_obj.spatial_partitions is not None
+    original_partitions = dask_obj.spatial_partitions
+
+    new = dask_obj.set_crs("EPSG:4326")
+
+    assert new.spatial_partitions is not None
+
+    assert all(new.spatial_partitions.geometry.values == original_partitions.geometry.values)
+
+
+def test_set_crs_updates_spatial_partitions_crs(geodf_points):
+
+
+
+
+    dask_obj = dask_geopandas.from_geopandas(geodf_points, npartitions=2)
+    dask_obj.calculate_spatial_partitions()
+
+    assert dask_obj.spatial_partitions.crs is None
+
+    new_crs = "EPSG:4326"
+    new = dask_obj.set_crs(new_crs)
+
+    assert new.spatial_partitions is not None
+
+    from pyproj import CRS
+    assert new.spatial_partitions.crs is not None
+    assert CRS.from_user_input(new.spatial_partitions.crs) == CRS.from_user_input(
+        new_crs
+    )
+
+
+def test_set_crs_geoseries_preserves_spatial_partitions(geoseries_points):
+
+    dask_obj = dask_geopandas.from_geopandas(geoseries_points, npartitions=2)
+    dask_obj.calculate_spatial_partitions()
+    assert dask_obj.spatial_partitions is not None
+
+    new = dask_obj.set_crs("EPSG:4326")
+
+    assert new.spatial_partitions is not None
+    from pyproj import CRS
+    assert CRS.from_user_input(new.spatial_partitions.crs) == CRS.from_user_input(
+        "EPSG:4326"
+    )
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+
+set -uo pipefail
+cd /testbed
+rc=0
+python -m pytest -v -rA tests/test_core.py::test_set_crs_no_spatial_partitions tests/test_core.py::test_set_crs_preserves_spatial_partitions tests/test_core.py::test_set_crs_updates_spatial_partitions_crs tests/test_core.py::test_set_crs_geoseries_preserves_spatial_partitions
+rc=$(( rc | $? ))
+exit $rc
