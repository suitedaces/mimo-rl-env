+func TestRepositoriesService_CreateRelease_makeLatest(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+
+	input := &RepositoryRelease{
+		TagName:    String("v1.0"),
+		MakeLatest: String("true"),
+	}
+
+	var gotBody string
+	mux.HandleFunc("/repos/o/r/releases", func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, "POST")
+		buf := new(bytes.Buffer)
+		buf.ReadFrom(r.Body)
+		gotBody = buf.String()
+		fmt.Fprint(w, `{"id":1}`)
+	})
+
+	ctx := context.Background()
+	_, _, err := client.Repositories.CreateRelease(ctx, "o", "r", input)
+	if err != nil {
+		t.Fatalf("Repositories.CreateRelease returned error: %v", err)
+	}
+
+	if !strings.Contains(gotBody, `"make_latest":"true"`) {
+		t.Errorf("CreateRelease request body = %q, want it to contain `\"make_latest\":\"true\"`", gotBody)
+	}
+}
