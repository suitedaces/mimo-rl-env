+func TestRepositoryRelease_MakeLatest_field(t *testing.T) {
+
+	want := "legacy"
+	r := &RepositoryRelease{MakeLatest: &want}
+	if r.MakeLatest == nil || *r.MakeLatest != want {
+		t.Errorf("RepositoryRelease.MakeLatest pointer not set correctly")
+	}
+
+	data, err := json.Marshal(r)
+	if err != nil {
+		t.Fatalf("json.Marshal returned error: %v", err)
+	}
+	if !strings.Contains(string(data), `"make_latest":"legacy"`) {
+		t.Errorf("Marshalled RepositoryRelease = %s, want it to contain `\"make_latest\":\"legacy\"`", data)
+	}
+
+
+	var got RepositoryRelease
+	if err := json.Unmarshal([]byte(`{"make_latest":"true"}`), &got); err != nil {
+		t.Fatalf("json.Unmarshal returned error: %v", err)
+	}
+	if got.MakeLatest == nil || *got.MakeLatest != "true" {
+		t.Errorf("Unmarshalled RepositoryRelease.MakeLatest = %v, want pointer to \"true\"", got.MakeLatest)
+	}
+}
