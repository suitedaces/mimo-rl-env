+package usercase_test_coderl
+
+import (
+	"fmt"
+	"math"
+	"math/rand"
+	"testing"
+
+	eaopt "github.com/MaxHalford/eaopt"
+)
+
+func styblinskiTang(x []float64) (y float64) {
+	for _, xi := range x {
+		y += math.Pow(xi, 4) - 16*math.Pow(xi, 2) + 5*xi
+	}
+	return 0.5 * y
+}
+
+func bowl(x []float64) (y float64) {
+	for _, xi := range x {
+		y += xi * xi
+	}
+	return y
+}
+
+func assertFiniteBowlResult(t *testing.T, x []float64, y float64, nDims int) {
+	t.Helper()
+	if len(x) != nDims {
+		t.Fatalf("len(x) = %d, want %d; x=%v", len(x), nDims, x)
+	}
+	if math.IsNaN(y) || math.IsInf(y, 0) {
+		t.Fatalf("y = %.17g, want finite", y)
+	}
+	if y < 0 {
+		t.Fatalf("bowl y = %.17g, want non-negative", y)
+	}
+}
+
+func assertFloat64Near(t *testing.T, name string, actual, expected, tol float64) {
+	t.Helper()
+	if math.Abs(actual-expected) > tol {
+		t.Fatalf("%s = %.17g, want %.17g +/- %.17g", name, actual, expected, tol)
+	}
+}
+
+func assertFloat64SliceNear(t *testing.T, actual []float64, expected []float64, tol float64) {
+	t.Helper()
+	if len(actual) != len(expected) {
+		t.Fatalf("len(actual) = %d, want %d; actual=%v", len(actual), len(expected), actual)
+	}
+	for i := range expected {
+		if math.Abs(actual[i]-expected[i]) > tol {
+			t.Fatalf("actual[%d] = %.17g, want %.17g +/- %.17g; actual=%v", i, actual[i], expected[i], tol, actual)
+		}
+	}
+}
+
+func TestDefaultSPSOSessionDeterministicStyblinskiTang(t *testing.T) {
+
+
+	spso, err := eaopt.NewDefaultSPSO()
+	if err != nil {
+		t.Fatalf("NewDefaultSPSO error = %v, want nil", err)
+	}
+
+
+	if spso.GA.ParallelEval != false {
+		t.Fatalf("fresh GA.ParallelEval = %v, want false", spso.GA.ParallelEval)
+	}
+
+	spso.GA.RNG = rand.New(rand.NewSource(42))
+	x, y, err := spso.Minimize(styblinskiTang, 2)
+	if err != nil {
+		t.Fatalf("Minimize error = %v, want nil", err)
+	}
+
+
+	assertFloat64SliceNear(t, x, []float64{-2.8586916496046983, -2.9619895273744623}, 1e-6)
+	assertFloat64Near(t, "y", y, -78.23783, 1e-5)
+}
+
+func TestNewSPSONilRNGIsUsableAndEvolvesState(t *testing.T) {
+
+
+	spso, err := eaopt.NewSPSO(5, 3, -1, 1, 0.5, false, nil)
+	if err != nil {
+		t.Fatalf("NewSPSO nil RNG error = %v, want nil", err)
+	}
+
+
+	if spso.GA.ParallelEval != false {
+		t.Fatalf("fresh GA.ParallelEval = %v, want false", spso.GA.ParallelEval)
+	}
+	if spso.GA.RNG == nil {
+		t.Fatalf("fresh GA.RNG is nil, want non-nil")
+	}
+	spso.GA.RNG = rand.New(rand.NewSource(7))
+	calls := 0
+	boundedBowl := func(x []float64) float64 {
+		calls++
+		if calls <= 5 {
+			if len(x) != 2 {
+				t.Fatalf("initial eval len(x) = %d, want 2; x=%v", len(x), x)
+			}
+			for _, xi := range x {
+				if xi < -1 || xi > 1 {
+					t.Fatalf("initial eval x = %v, want coordinates within [-1, 1]", x)
+				}
+			}
+		}
+		return bowl(x)
+	}
+	x, y, err := spso.Minimize(boundedBowl, 2)
+	if err != nil {
+		t.Fatalf("Minimize error = %v, want nil", err)
+	}
+
+
+	assertFiniteBowlResult(t, x, y, 2)
+	if calls < 5 {
+		t.Fatalf("objective calls = %d, want at least one initial evaluation per particle", calls)
+	}
+	if calls <= 5 {
+		t.Fatalf("objective calls = %d, want evolution after initial particle evaluation", calls)
+	}
+}
+
+func TestParallelEvalBowlSessionCompletesWithPinnedState(t *testing.T) {
+
+
+	spso, err := eaopt.NewDefaultSPSO()
+	if err != nil {
+		t.Fatalf("NewDefaultSPSO error = %v, want nil", err)
+	}
+	if spso.GA.ParallelEval != false {
+		t.Fatalf("fresh GA.ParallelEval = %v, want false", spso.GA.ParallelEval)
+	}
+
+	spso.GA.ParallelEval = true
+	spso.GA.RNG = rand.New(rand.NewSource(99))
+	x, y, err := spso.Minimize(bowl, 2)
+	if err != nil {
+		t.Fatalf("parallel Minimize error = %v, want nil", err)
+	}
+
+	if spso.GA.ParallelEval != true {
+		t.Fatalf("after field mutation GA.ParallelEval = %v, want true", spso.GA.ParallelEval)
+	}
+
+	assertFiniteBowlResult(t, x, y, 2)
+}
+
+func TestInvalidConstructionFailsBeforeMinimization(t *testing.T) {
+
+
+	testCases := []struct {
+		name string
+		make func() (*eaopt.SPSO, error)
+	}{
+		{
+			name: "min_ge_max",
+			make: func() (*eaopt.SPSO, error) {
+				return eaopt.NewSPSO(40, 30, 5, -5, 0.5, false, nil)
+			},
+		},
+		{
+			name: "zero_particles",
+			make: func() (*eaopt.SPSO, error) {
+				return eaopt.NewSPSO(0, 30, -5, 5, 0.5, false, nil)
+			},
+		},
+		{
+			name: "zero_steps",
+			make: func() (*eaopt.SPSO, error) {
+				return eaopt.NewSPSO(40, 0, -5, 5, 0.5, false, nil)
+			},
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			spso, err := tc.make()
+
+			if err == nil {
+				t.Fatalf("spso = %#v, err = nil; want non-nil error", spso)
+			}
+		})
+	}
+}
+
+func TestIndependentSPSOInstancesDoNotShareSessionState(t *testing.T) {
+
+
+	a, err := eaopt.NewSPSO(3, 2, -1, 1, 0.25, false, rand.New(rand.NewSource(11)))
+	if err != nil {
+		t.Fatalf("NewSPSO a error = %v, want nil", err)
+	}
+	b, err := eaopt.NewSPSO(4, 3, -2, 2, 0.75, true, rand.New(rand.NewSource(12)))
+	if err != nil {
+		t.Fatalf("NewSPSO b error = %v, want nil", err)
+	}
+
+
+	if a.GA.ParallelEval != false {
+		t.Fatalf("fresh a parallel = %v, want false", a.GA.ParallelEval)
+	}
+
+	if b.GA.ParallelEval != true {
+		t.Fatalf("fresh b parallel = %v, want true", b.GA.ParallelEval)
+	}
+
+	a.GA.RNG = rand.New(rand.NewSource(13))
+	aCalls := 0
+	aObjective := func(x []float64) float64 {
+		aCalls++
+		if aCalls <= 3 {
+			for _, xi := range x {
+				if xi < -1 || xi > 1 {
+					t.Fatalf("initial a x = %v, want coordinates within [-1, 1]", x)
+				}
+			}
+		}
+		return bowl(x)
+	}
+	ax, ay, err := a.Minimize(aObjective, 2)
+	if err != nil {
+		t.Fatalf("a Minimize error = %v, want nil", err)
+	}
+
+	assertFiniteBowlResult(t, ax, ay, 2)
+	if aCalls <= 3 {
+		t.Fatalf("a objective calls = %d, want evolution after initial particle evaluation", aCalls)
+	}
+	if b.GA.ParallelEval != true {
+		t.Fatalf("after a Minimize b.GA.ParallelEval = %v, want true", b.GA.ParallelEval)
+	}
+
+}
+
+func TestRepeatedParallelSPSOSessionsComplete(t *testing.T) {
+
+
+
+	for i := 0; i < 100; i++ {
+		spso, err := eaopt.NewSPSO(6, 2, -1, 1, 0.5, true, rand.New(rand.NewSource(int64(1000+i))))
+		if err != nil {
+			t.Fatalf("cycle %d NewSPSO error = %v, want nil", i, err)
+		}
+		spso.GA.RNG = rand.New(rand.NewSource(int64(2000 + i)))
+		_, _, err = spso.Minimize(bowl, 2)
+		if err != nil {
+			t.Fatalf("cycle %d Minimize error = %v, want nil", i, err)
+		}
+	}
+}
+
+func TestNoExplicitCleanupLifecycleExistsForSPSO(t *testing.T) {
+
+
+	spso, err := eaopt.NewSPSO(5, 3, -1, 1, 0.5, false, rand.New(rand.NewSource(7)))
+	if err != nil {
+		t.Fatalf("NewSPSO error = %v, want nil", err)
+	}
+	spso.GA.RNG = rand.New(rand.NewSource(7))
+	_, y, err := spso.Minimize(bowl, 2)
+	if err != nil {
+		t.Fatalf("Minimize error = %v, want nil", err)
+	}
+
+	if math.IsNaN(y) || math.IsInf(y, 0) {
+		t.Fatalf("y = %.17g, want finite", y)
+	}
+	if fmt.Sprintf("%T", spso) != "*eaopt.SPSO" {
+		t.Fatalf("public session type = %s, want *eaopt.SPSO", fmt.Sprintf("%T", spso))
+	}
+}
