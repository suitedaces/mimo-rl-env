diff --git a/test/yargs-parser.js b/test/yargs-parser.js
index ee76e41..21148a3 100644
--- a/test/yargs-parser.js
+++ b/test/yargs-parser.js
@@ -1788,6 +1788,87 @@ describe('yargs-parser', function () {
 
       result.foo.should.eql('a')
     })
+
+    it('treats next "true" as positional when boolean has narg 0 (issue example)', function () {
+      var result = parser(['--all', 'true'], {
+        boolean: ['all'],
+        narg: { all: 0 }
+      })
+      result.all.should.equal(true)
+      result._.should.deep.equal(['true'])
+    })
+
+    it('treats next "false" as positional when boolean has narg 0 (all stays true via default)', function () {
+      var result = parser(['--all', 'false'], {
+        boolean: ['all'],
+        narg: { all: 0 }
+      })
+      result.all.should.equal(true)
+      result._.should.deep.equal(['false'])
+    })
+
+    it('treats non-boolean-looking next arg as positional when boolean has narg 0', function () {
+      var result = parser(['--all', 'echo', 'hi'], {
+        boolean: ['all'],
+        narg: { all: 0 },
+        configuration: { 'halt-at-non-option': true }
+      })
+      result.all.should.equal(true)
+      result._.should.deep.equal(['echo', 'hi'])
+    })
+
+    it('sets boolean default when narg-0 boolean is the only arg', function () {
+      var result = parser(['--all'], {
+        boolean: ['all'],
+        narg: { all: 0 }
+      })
+      result.all.should.equal(true)
+      result._.should.deep.equal([])
+    })
+
+    it('handles --no- negation with narg 0 boolean followed by "true"', function () {
+      var result = parser(['--no-all', 'true'], {
+        boolean: ['all'],
+        narg: { all: 0 }
+      })
+      result.all.should.equal(false)
+      result._.should.deep.equal(['true'])
+    })
+
+    it('handles --no- negation with narg 0 boolean followed by "false"', function () {
+      var result = parser(['--no-all', 'false'], {
+        boolean: ['all'],
+        narg: { all: 0 }
+      })
+      result.all.should.equal(false)
+      result._.should.deep.equal(['false'])
+    })
+
+    it('does not consume any next arg after a narg-0 boolean, even an arbitrary positional', function () {
+      var result = parser(['--all', 'foo'], {
+        boolean: ['all'],
+        narg: { all: 0 }
+      })
+      result.all.should.equal(true)
+      result._.should.deep.equal(['foo'])
+    })
+
+    it('narg 1 still consumes one value (preservation)', function () {
+      var result = parser(['--foo', 'bar'], {
+        narg: { foo: 1 }
+      })
+      result.foo.should.equal('bar')
+      result._.should.deep.equal([])
+    })
+
+    it('--all=true with narg 0 does not duplicate inline value into positionals', function () {
+      var result = parser(['--all=true'], {
+        boolean: ['all'],
+        narg: { all: 0 }
+      })
+      result.all.should.equal(true)
+      result._.should.deep.equal([])
+    })
   })
 
