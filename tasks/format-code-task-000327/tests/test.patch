+++ b/airbyte-integrations/connectors/source-hubspot/unit_tests/test_version_metadata.py
@@ -0,0 +1,43 @@
+import re
+from pathlib import Path
+
+
+def _repo_root():
+    current = Path(__file__).resolve()
+    for parent in current.parents:
+        if (parent / "airbyte-config").is_dir() and (parent / "airbyte-integrations").is_dir():
+            return parent
+    raise AssertionError("Could not locate repository root")
+
+
+def _read_repo_file(*parts):
+    return (_repo_root().joinpath(*parts)).read_text()
+
+
+def _hubspot_seed_block():
+    text = _read_repo_file("airbyte-config", "init", "src", "main", "resources", "seed", "source_definitions.yaml")
+    match = re.search(r"- name: HubSpot\n(?P<block>(?:  .*\n)+)", text)
+    assert match, "HubSpot source definition block not found"
+    return match.group("block")
+
+
+def test_hubspot_seed_definition_uses_fixed_version():
+    block = _hubspot_seed_block()
+    assert "dockerRepository: airbyte/source-hubspot" in block
+    tag = re.search(r"^\s+dockerImageTag:\s*(?P<tag>\S+)\s*$", block, re.MULTILINE)
+    assert tag, "HubSpot dockerImageTag not found"
+    assert tag.group("tag") == "0.1.69"
+
+
+def test_hubspot_spec_uses_fixed_version():
+    text = _read_repo_file("airbyte-config", "init", "src", "main", "resources", "seed", "source_specs.yaml")
+    match = re.search(r'- dockerImage:\s*"(?P<image>airbyte/source-hubspot:[^"]+)"', text)
+    assert match, "HubSpot source spec dockerImage not found"
+    assert match.group("image") == "airbyte/source-hubspot:0.1.69"
+
+
+def test_hubspot_docker_label_uses_fixed_version():
+    text = _read_repo_file("airbyte-integrations", "connectors", "source-hubspot", "Dockerfile")
+    match = re.search(r"^LABEL io\.airbyte\.version=(?P<version>\S+)\s*$", text, re.MULTILINE)
+    assert match, "HubSpot Dockerfile version label not found"
+    assert match.group("version") == "0.1.69"
