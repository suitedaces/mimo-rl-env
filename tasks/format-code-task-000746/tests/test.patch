diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,26 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set +u
+source /testbed/.build_env/venv/bin/activate
+set -u
+cd /testbed/python_modules/dagster-graphql
+
+
+BASE_FILTER="not postgres and not (test_dry_run_with_dynamic_partition_requests and lazy_repository) and not code_server_cli_env and not test_stop_sensor_accepts_queried_id and not test_sensor_state_id_matches_sensor_id_and_can_be_reused and not test_stop_sensor_accepts_queried_id_in_legacy_origin_arg and not test_stop_sensor_requires_id_or_complete_legacy_pair and not test_stop_schedule_accepts_queried_id and not test_schedule_state_id_matches_schedule_id_and_can_be_reused and not test_stop_schedule_accepts_queried_id_in_legacy_origin_arg and not test_stop_schedule_requires_id_or_complete_legacy_pair"
+NEW_FILTER="not postgres and not code_server_cli_env and (test_stop_sensor_accepts_queried_id or test_sensor_state_id_matches_sensor_id_and_can_be_reused or test_stop_sensor_accepts_queried_id_in_legacy_origin_arg or test_stop_sensor_requires_id_or_complete_legacy_pair or test_stop_schedule_accepts_queried_id or test_schedule_state_id_matches_schedule_id_and_can_be_reused or test_stop_schedule_accepts_queried_id_in_legacy_origin_arg or test_stop_schedule_requires_id_or_complete_legacy_pair)"
+
+case "${1:-}" in
+  base)
+    python -m pytest dagster_graphql_tests/graphql/test_scheduler.py dagster_graphql_tests/graphql/test_sensors.py -v -k "$BASE_FILTER"
+    ;;
+  new)
+    python -m pytest dagster_graphql_tests/graphql/test_scheduler.py dagster_graphql_tests/graphql/test_sensors.py -v -k "$NEW_FILTER"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
