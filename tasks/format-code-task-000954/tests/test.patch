diff --git a/js/plugins/dotprompt/tests/prompt_test.ts b/js/plugins/dotprompt/tests/prompt_test.ts
index d1dd4ce3..2010c50d 100644
--- a/js/plugins/dotprompt/tests/prompt_test.ts
+++ b/js/plugins/dotprompt/tests/prompt_test.ts
@@ -22,7 +22,7 @@ import { toJsonSchema, ValidationError } from '@genkit-ai/core/schema';
 import z from 'zod';
 import { registerPluginProvider } from '../../../core/src/registry.js';
 import { defineJsonSchema, defineSchema } from '../../../core/src/schema.js';
-import { defineDotprompt, Dotprompt, prompt } from '../src/index.js';
+import { defineDotprompt, Dotprompt, prompt, promptRef } from '../src/index.js';
 import { PromptMetadata } from '../src/metadata.js';
 
 function registerDotprompt() {
@@ -250,4 +250,85 @@ output:
       assert.equal('And this is its variant.', variantPrompt.template);
     });
   });
+
+  describe('promptRef', () => {
+    function setupRefPrompts() {
+      registerDotprompt();
+      defineDotprompt(
+        {
+          name: 'refPromptName',
+          model: 'echo',
+        },
+        `Hello {{name}}, this is a ref prompt.`
+      );
+      defineDotprompt(
+        {
+          name: 'refPromptName',
+          variant: 'refVariantName',
+          model: 'echo',
+        },
+        `Greetings {{name}}, from the variant.`
+      );
+    }
+
+    it('returns synchronously without await and exposes name', () => {
+      setupRefPrompts();
+      const refResult = promptRef('refPromptName');
+
+      assert.ok(refResult, 'promptRef must return a value synchronously');
+      assert.notStrictEqual(
+        typeof (refResult as any).then === 'function' &&
+          typeof (refResult as any).generate !== 'function',
+        true,
+        'promptRef must not return a bare Promise'
+      );
+      assert.strictEqual(
+        typeof (refResult as any).generate,
+        'function',
+        'promptRef result must expose generate()'
+      );
+      assert.strictEqual(
+        typeof (refResult as any).render,
+        'function',
+        'promptRef result must expose render()'
+      );
+      assert.strictEqual((refResult as any).name, 'refPromptName');
+    });
+
+    it('generate produces same text as the async prompt API', async () => {
+      setupRefPrompts();
+      const ref = promptRef('refPromptName');
+      const response = await ref.generate({ input: { name: 'Alice' } });
+      assert.equal(response.text(), `Hello Alice, this is a ref prompt.`);
+    });
+
+    it('render produces rendered messages from a synchronously-created ref', async () => {
+      setupRefPrompts();
+      const ref = promptRef('refPromptName');
+      const rendered = await ref.render({ input: { name: 'Bob' } });
+      assert.deepStrictEqual(rendered.prompt, [
+        { text: 'Hello Bob, this is a ref prompt.' },
+      ]);
+    });
+
+    it('resolves the variant when provided in options', async () => {
+      setupRefPrompts();
+      const variantRef = promptRef('refPromptName', {
+        variant: 'refVariantName',
+      });
+      const response = await variantRef.generate({
+        input: { name: 'Carol' },
+      });
+      assert.equal(response.text(), `Greetings Carol, from the variant.`);
+    });
+
+    it('async prompt() still returns a Dotprompt with template (preservation)', async () => {
+      setupRefPrompts();
+      const p = await prompt('refPromptName');
+
+
+      assert.strictEqual(typeof (p as any).template, 'string');
+      assert.equal(p.template, 'Hello {{name}}, this is a ref prompt.');
+    });
+  });
 });
