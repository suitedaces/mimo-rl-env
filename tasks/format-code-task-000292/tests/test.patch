+package v1
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	rbacv1 "k8s.io/api/rbac/v1"
+)
+
+
+func rule(scopes []string, r rbacv1.PolicyRule) PolicyRule {
+	return PolicyRule{PolicyRule: r, Scopes: scopes}
+}
+
+func TestGrantsExactAndMissing(t *testing.T) {
+	const ns = "acorn"
+
+	tests := []struct {
+		name        string
+		granted     Permissions
+		requested   Permissions
+		wantOK      bool
+		wantMissing []PolicyRule
+	}{
+		{
+			name: "exact match grants everything",
+			granted: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"pods"}}),
+			}},
+			requested: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"pods"}}),
+			}},
+			wantOK: true,
+		},
+		{
+			name: "missing verb is reported",
+			granted: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"pods"}}),
+			}},
+			requested: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get", "list"}, APIGroups: []string{""}, Resources: []string{"pods"}}),
+			}},
+			wantOK: false,
+			wantMissing: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get", "list"}, APIGroups: []string{""}, Resources: []string{"pods"}}),
+			},
+		},
+		{
+			name: "star verb covers any verb",
+			granted: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"*"}, APIGroups: []string{""}, Resources: []string{"pods"}}),
+			}},
+			requested: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get", "list", "delete"}, APIGroups: []string{""}, Resources: []string{"pods"}}),
+			}},
+			wantOK: true,
+		},
+		{
+			name: "suffix wildcard on resources",
+			granted: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"secret*"}}),
+			}},
+			requested: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"secrets"}}),
+			}},
+			wantOK: true,
+		},
+		{
+			name: "suffix wildcard does not match different prefix",
+			granted: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"secret*"}}),
+			}},
+			requested: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"configmaps"}}),
+			}},
+			wantOK: false,
+			wantMissing: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"configmaps"}}),
+			},
+		},
+		{
+			name: "empty granted resourceNames allows any requested resourceName",
+			granted: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"secrets"}}),
+			}},
+			requested: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"secrets"}, ResourceNames: []string{"db-creds"}}),
+			}},
+			wantOK: true,
+		},
+		{
+			name: "specific granted resourceName does not cover an extra requested one",
+			granted: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"secrets"}, ResourceNames: []string{"db-creds"}}),
+			}},
+			requested: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"secrets"}, ResourceNames: []string{"db-creds", "api-key"}}),
+			}},
+			wantOK: false,
+			wantMissing: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"secrets"}, ResourceNames: []string{"db-creds", "api-key"}}),
+			},
+		},
+		{
+			name: "requested empty resourceNames is not narrowed by specific granted resourceName",
+			granted: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"secrets"}, ResourceNames: []string{"db-creds"}}),
+			}},
+			requested: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"secrets"}}),
+			}},
+			wantOK: true,
+		},
+		{
+			name: "service name mismatch grants nothing",
+			granted: Permissions{ServiceName: "other", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"*"}, APIGroups: []string{"*"}, Resources: []string{"*"}}),
+			}},
+			requested: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"pods"}}),
+			}},
+			wantOK: false,
+			wantMissing: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"pods"}}),
+			},
+		},
+		{
+			name:   "no requested rules is trivially granted",
+			granted: Permissions{ServiceName: "svc"},
+			requested: Permissions{ServiceName: "svc"},
+			wantOK: true,
+		},
+		{
+			name: "only some requested rules are missing",
+			granted: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"pods"}}),
+			}},
+			requested: Permissions{ServiceName: "svc", Rules: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"pods"}}),
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"delete"}, APIGroups: []string{""}, Resources: []string{"pods"}}),
+			}},
+			wantOK: false,
+			wantMissing: []PolicyRule{
+				rule(nil, rbacv1.PolicyRule{Verbs: []string{"delete"}, APIGroups: []string{""}, Resources: []string{"pods"}}),
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			missing, ok := Grants(tt.granted, ns, tt.requested)
+			assert.Equal(t, tt.wantOK, ok)
+			assert.Equal(t, tt.requested.ServiceName, missing.ServiceName, "missing must carry the requested service name")
+			assert.Equal(t, tt.wantMissing, missing.Rules)
+		})
+	}
+}
+
+func TestGrantsNamespaceScoping(t *testing.T) {
+	const ns = "acorn"
+
+
+
+
+	missing, ok := Grants(
+		Permissions{ServiceName: "svc", Rules: []PolicyRule{
+			rule(nil, rbacv1.PolicyRule{Verbs: []string{"*"}, APIGroups: []string{"*"}, Resources: []string{"*"}}),
+		}},
+		ns,
+		Permissions{ServiceName: "svc", Rules: []PolicyRule{
+			rule([]string{"cluster"}, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"nodes"}}),
+		}},
+	)
+	assert.False(t, ok)
+	assert.Len(t, missing.Rules, 1)
+
+
+
+	_, ok = Grants(
+		Permissions{ServiceName: "svc", Rules: []PolicyRule{
+			rule([]string{"cluster"}, rbacv1.PolicyRule{Verbs: []string{"*"}, APIGroups: []string{"*"}, Resources: []string{"*"}}),
+		}},
+		ns,
+		Permissions{ServiceName: "svc", Rules: []PolicyRule{
+			rule([]string{"cluster"}, rbacv1.PolicyRule{Verbs: []string{"get"}, APIGroups: []string{""}, Resources: []string{"nodes"}}),
+		}},
+	)
+	assert.True(t, ok)
+}
+
+func TestGrantsNonResourceURLs(t *testing.T) {
+	const ns = "acorn"
+
+
+	_, ok := Grants(
+		Permissions{ServiceName: "svc", Rules: []PolicyRule{
+			rule(nil, rbacv1.PolicyRule{NonResourceURLs: []string{"/metrics"}}),
+		}},
+		ns,
+		Permissions{ServiceName: "svc", Rules: []PolicyRule{
+			rule(nil, rbacv1.PolicyRule{NonResourceURLs: []string{"/metrics"}}),
+		}},
+	)
+	assert.True(t, ok)
+
+
+	_, ok = Grants(
+		Permissions{ServiceName: "svc", Rules: []PolicyRule{
+			rule(nil, rbacv1.PolicyRule{NonResourceURLs: []string{"/api/*"}}),
+		}},
+		ns,
+		Permissions{ServiceName: "svc", Rules: []PolicyRule{
+			rule(nil, rbacv1.PolicyRule{NonResourceURLs: []string{"/api/v1"}}),
+		}},
+	)
+	assert.True(t, ok)
+
+
+	missing, ok := Grants(
+		Permissions{ServiceName: "svc", Rules: []PolicyRule{
+			rule(nil, rbacv1.PolicyRule{NonResourceURLs: []string{"/metrics"}, Resources: []string{"pods"}, Verbs: []string{"get"}}),
+		}},
+		ns,
+		Permissions{ServiceName: "svc", Rules: []PolicyRule{
+			rule(nil, rbacv1.PolicyRule{NonResourceURLs: []string{"/metrics"}}),
+		}},
+	)
+	assert.False(t, ok)
+	assert.Len(t, missing.Rules, 1)
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+
+export GOFLAGS=-mod=mod
+export GOPROXY=off
+export GOSUMDB=off
+MODCACHE="$(go env GOMODCACHE)"
+for mod in aml baaah; do
+    ver="$(ls "$MODCACHE/github.com/acorn-io/" 2>/dev/null | grep -E "^${mod}@" | head -n1 | sed "s/^${mod}@//")"
+    if [ -n "$ver" ]; then
+        go mod edit -require="github.com/acorn-io/${mod}@${ver}"
+    fi
+done
+
+PKG=./pkg/apis/internal.acorn.io/v1/
+
+
+go test "$PKG" -run 'Test' -skip 'TestGrants'
+
+
+go test "$PKG" -run 'TestGrants'
