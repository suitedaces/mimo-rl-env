diff --git a/tests/test_byteswarning.py b/tests/test_byteswarning.py
new file mode 100644
index 0000000..c416f4f
--- /dev/null
+++ b/tests/test_byteswarning.py
@@ -0,0 +1,137 @@
+
+
+
+
+
+
+
+
+
+import io
+import subprocess
+import sys
+import textwrap
+
+import numpy as np
+import pytest
+
+import imageio
+
+
+def _valid_png_bytes():
+    buf = io.BytesIO()
+    imageio.imwrite(buf, np.zeros((2, 2), dtype="uint8"), format="PNG")
+    return buf.getvalue()
+
+
+def _run_with_bb(code: str):
+
+    return subprocess.run(
+        [sys.executable, "-bb", "-c", textwrap.dedent(code)],
+        capture_output=True,
+        text=True,
+    )
+
+
+
+
+
+def test_imread_valid_bytes_under_bb_succeeds():
+    png_bytes = _valid_png_bytes()
+    code = f"""
+        import imageio
+        image = imageio.imread({png_bytes!r})
+        print('SHAPE', image.shape)
+    """
+    result = _run_with_bb(code)
+    assert result.returncode == 0, (
+        f"imread(valid bytes) under -bb failed.\n"
+        f"stdout={result.stdout!r}\nstderr={result.stderr!r}"
+    )
+    assert "BytesWarning" not in result.stderr
+    assert "SHAPE (2, 2)" in result.stdout
+
+
+
+
+
+
+def test_imread_invalid_bytes_under_bb_raises_imageio_error_not_byteswarning():
+    code = """
+        import imageio
+        try:
+            imageio.imread(b'definitely not a valid image')
+        except BytesWarning as bw:
+            print('BYTESWARNING', bw)
+        except Exception as e:
+            print('OK', type(e).__name__)
+    """
+    result = _run_with_bb(code)
+    assert result.returncode == 0, (
+        f"subprocess unexpectedly errored.\n"
+        f"stdout={result.stdout!r}\nstderr={result.stderr!r}"
+    )
+    assert "BYTESWARNING" not in result.stdout, (
+        "imread(bytes) raised BytesWarning under -bb (the regressed behavior)."
+    )
+    assert "BytesWarning" not in result.stderr
+
+    assert "OK" in result.stdout
+    assert "ValueError" in result.stdout or "OSError" in result.stdout
+
+
+
+
+
+
+
+
+
+def test_imread_wrong_format_bytes_under_bb_raises_can_not_handle():
+    png_bytes = _valid_png_bytes()
+    code = f"""
+        import imageio
+        try:
+            imageio.imread({png_bytes!r}, format='JPEG')
+        except BytesWarning as bw:
+            print('BYTESWARNING', bw)
+        except Exception as e:
+            print('TYPE', type(e).__name__)
+            print('MSG', str(e))
+    """
+    result = _run_with_bb(code)
+    assert result.returncode == 0, (
+        f"subprocess unexpectedly errored.\n"
+        f"stdout={result.stdout!r}\nstderr={result.stderr!r}"
+    )
+    assert "BYTESWARNING" not in result.stdout
+    assert "BytesWarning" not in result.stderr
+
+
+
+    assert "RuntimeError" in result.stdout
+    assert "can not handle" in result.stdout
+    assert "unknown error" not in result.stdout.lower()
+
+
+
+
+
+
+
+
+def test_imread_invalid_bytes_error_message_uses_bytes_placeholder():
+    payload = b"definitely not a valid image"
+    with pytest.raises((ValueError, OSError)) as excinfo:
+        imageio.imread(payload)
+    msg = str(excinfo.value)
+
+
+
+    assert "<bytes" in msg, (
+        f"Expected a '<bytes...>'-style placeholder in error message, got: {msg!r}"
+    )
+
+    assert "definitely not a valid image" not in msg, (
+        f"Raw bytes payload leaked into error message: {msg!r}"
+    )
