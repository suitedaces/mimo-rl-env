@@ -0,0 +1,393 @@
+
+
+
+
+
+
+
+import json
+import os
+import socket
+import subprocess
+import sys
+import textwrap
+
+import pytest
+import tensorflow as tf
+
+from tf_quant_finance import datetime as dates
+
+
+def _weekend_calendar():
+  return dates.create_holiday_calendar(
+      weekend_mask=dates.WeekendMask.SATURDAY_SUNDAY,
+      start_year=2020,
+      end_year=2020)
+
+
+def _holiday_calendar():
+  return dates.create_holiday_calendar(
+      weekend_mask=dates.WeekendMask.SATURDAY_SUNDAY,
+      holidays=dates.dates_from_tuples([(2020, 3, 20)]))
+
+
+def _friday_saturday_calendar():
+  return dates.create_holiday_calendar(
+      weekend_mask=dates.WeekendMask.FRIDAY_SATURDAY,
+      start_year=2020,
+      end_year=2020)
+
+
+def _make_dates(ymd):
+  return dates.dates_from_tuples(ymd)
+
+
+def _schedule_tensor(start, end, calendar, backward=False):
+  schedule = dates.BusinessDaySchedule(
+      start_date=_make_dates(start),
+      end_date=_make_dates(end),
+      holiday_calendar=calendar,
+      backward=backward)
+  return schedule.dates().to_tensor().numpy().tolist()
+
+
+def _schedule_ordinals(start, end, calendar, backward=False):
+  schedule = dates.BusinessDaySchedule(
+      start_date=_make_dates(start),
+      end_date=_make_dates(end),
+      holiday_calendar=calendar,
+      backward=backward)
+  return schedule.dates().ordinal().numpy().tolist()
+
+
+def _assert_spec_example_ordinals_shape(ordinals):
+
+  assert len(ordinals) == 1
+  assert len(ordinals[0]) == 5
+  assert all(isinstance(value, int) for value in ordinals[0])
+  assert ordinals[0] == sorted(ordinals[0])
+  assert len(set(ordinals[0])) == 5
+
+
+def test_non_batched_inclusive_weekend_schedule():
+
+
+
+  actual = _schedule_tensor(
+      [(2020, 3, 19)], [(2020, 3, 25)], _weekend_calendar())
+
+  assert actual == [[
+      [2020, 3, 19],
+      [2020, 3, 20],
+      [2020, 3, 23],
+      [2020, 3, 24],
+      [2020, 3, 25],
+  ]]
+
+
+def test_start_date_on_weekend_rolls_forward():
+
+
+
+  actual = _schedule_tensor(
+      [(2020, 3, 21)], [(2020, 3, 25)], _weekend_calendar())
+
+  assert actual == [[
+      [2020, 3, 23],
+      [2020, 3, 24],
+      [2020, 3, 25],
+  ]]
+
+
+def test_end_date_on_weekend_rolls_backward():
+
+
+
+  actual = _schedule_tensor(
+      [(2020, 3, 19)], [(2020, 3, 22)], _weekend_calendar())
+
+  assert actual == [[
+      [2020, 3, 19],
+      [2020, 3, 20],
+  ]]
+
+
+def test_single_business_day_range_is_inclusive():
+
+
+
+  actual = _schedule_tensor(
+      [(2020, 3, 23)], [(2020, 3, 23)], _weekend_calendar())
+
+  assert actual == [[[2020, 3, 23]]]
+
+
+def test_supplied_holiday_is_excluded_from_schedule():
+
+
+
+  actual = _schedule_tensor(
+      [(2020, 3, 19)], [(2020, 3, 25)], _holiday_calendar())
+
+  assert actual == [[
+      [2020, 3, 19],
+      [2020, 3, 23],
+      [2020, 3, 24],
+      [2020, 3, 25],
+  ]]
+
+
+def test_holiday_end_date_rolls_backward():
+
+
+
+  actual = _schedule_tensor(
+      [(2020, 3, 19)], [(2020, 3, 20)], _holiday_calendar())
+
+  assert actual == [[[2020, 3, 19]]]
+
+
+def test_batched_forward_generation_pads_short_rows_at_end():
+
+
+
+  actual = _schedule_tensor(
+      [(2020, 3, 19), (2020, 3, 23), (2020, 3, 21)],
+      [(2020, 3, 25), (2020, 3, 24), (2020, 3, 25)],
+      _weekend_calendar(),
+      backward=False)
+
+  assert actual == [
+      [
+          [2020, 3, 19],
+          [2020, 3, 20],
+          [2020, 3, 23],
+          [2020, 3, 24],
+          [2020, 3, 25],
+      ],
+      [
+          [2020, 3, 23],
+          [2020, 3, 24],
+          [2020, 3, 24],
+          [2020, 3, 24],
+          [2020, 3, 24],
+      ],
+      [
+          [2020, 3, 23],
+          [2020, 3, 24],
+          [2020, 3, 25],
+          [2020, 3, 25],
+          [2020, 3, 25],
+      ],
+  ]
+
+
+def test_batched_backward_generation_pads_short_rows_at_beginning():
+
+
+
+  actual = _schedule_tensor(
+      [(2020, 3, 19), (2020, 3, 23), (2020, 3, 21)],
+      [(2020, 3, 25), (2020, 3, 24), (2020, 3, 25)],
+      _weekend_calendar(),
+      backward=True)
+
+  assert actual == [
+      [
+          [2020, 3, 19],
+          [2020, 3, 20],
+          [2020, 3, 23],
+          [2020, 3, 24],
+          [2020, 3, 25],
+      ],
+      [
+          [2020, 3, 23],
+          [2020, 3, 23],
+          [2020, 3, 23],
+          [2020, 3, 23],
+          [2020, 3, 24],
+      ],
+      [
+          [2020, 3, 23],
+          [2020, 3, 23],
+          [2020, 3, 23],
+          [2020, 3, 24],
+          [2020, 3, 25],
+      ],
+  ]
+
+
+def test_forward_generation_broadcasts_end_date_to_start_shape():
+
+
+
+  actual = _schedule_tensor(
+      [(2020, 3, 19), (2020, 3, 23)],
+      [(2020, 3, 25)],
+      _weekend_calendar(),
+      backward=False)
+
+  assert actual == [
+      [
+          [2020, 3, 19],
+          [2020, 3, 20],
+          [2020, 3, 23],
+          [2020, 3, 24],
+          [2020, 3, 25],
+      ],
+      [
+          [2020, 3, 23],
+          [2020, 3, 24],
+          [2020, 3, 25],
+          [2020, 3, 25],
+          [2020, 3, 25],
+      ],
+  ]
+
+
+def test_backward_generation_broadcasts_start_date_to_end_shape():
+
+
+
+  actual = _schedule_tensor(
+      [(2020, 3, 19)],
+      [(2020, 3, 23), (2020, 3, 25)],
+      _weekend_calendar(),
+      backward=True)
+
+  assert actual == [
+      [
+          [2020, 3, 19],
+          [2020, 3, 19],
+          [2020, 3, 19],
+          [2020, 3, 20],
+          [2020, 3, 23],
+      ],
+      [
+          [2020, 3, 19],
+          [2020, 3, 20],
+          [2020, 3, 23],
+          [2020, 3, 24],
+          [2020, 3, 25],
+      ],
+  ]
+
+
+def test_supplied_calendar_controls_business_day_definition():
+
+
+
+  actual = _schedule_tensor(
+      [(2020, 3, 19)], [(2020, 3, 25)], _friday_saturday_calendar())
+
+  assert actual == [[
+      [2020, 3, 19],
+      [2020, 3, 22],
+      [2020, 3, 23],
+      [2020, 3, 24],
+      [2020, 3, 25],
+  ]]
+
+
+def test_invalid_adjusted_range_raises_tensorflow_invalid_argument():
+
+
+
+  schedule = dates.BusinessDaySchedule(
+      start_date=_make_dates([(2020, 3, 21)]),
+      end_date=_make_dates([(2020, 3, 22)]),
+      holiday_calendar=_weekend_calendar())
+
+  with pytest.raises(
+      tf.errors.InvalidArgumentError, match="End date must be >= Start date."):
+    schedule.dates().to_tensor().numpy().tolist()
+
+
+def test_referential_transparency_same_inputs_return_same_ordinals():
+  first = _schedule_ordinals(
+      [(2020, 3, 19)], [(2020, 3, 25)], _weekend_calendar())
+  second = _schedule_ordinals(
+      [(2020, 3, 19)], [(2020, 3, 25)], _weekend_calendar())
+
+  assert first == second
+  _assert_spec_example_ordinals_shape(first)
+
+
+def test_does_not_mutate_input_date_tensors_or_holiday_calendar():
+  start = _make_dates([(2020, 3, 19)])
+  end = _make_dates([(2020, 3, 25)])
+  calendar = _holiday_calendar()
+  probe = _make_dates([(2020, 3, 20), (2020, 3, 21), (2020, 3, 23)])
+
+  start_before = start.to_tensor().numpy().tolist()
+  end_before = end.to_tensor().numpy().tolist()
+  calendar_before = calendar.is_business_day(probe).numpy().tolist()
+  actual = dates.BusinessDaySchedule(
+      start_date=start,
+      end_date=end,
+      holiday_calendar=calendar).dates().to_tensor().numpy().tolist()
+  start_after = start.to_tensor().numpy().tolist()
+  end_after = end.to_tensor().numpy().tolist()
+  calendar_after = calendar.is_business_day(probe).numpy().tolist()
+
+  assert actual == [[
+      [2020, 3, 19],
+      [2020, 3, 23],
+      [2020, 3, 24],
+      [2020, 3, 25],
+  ]]
+  assert start_after == start_before == [[2020, 3, 19]]
+  assert end_after == end_before == [[2020, 3, 25]]
+  assert calendar_after == calendar_before == [False, False, True]
+
+
+def test_same_input_matches_fresh_process_result():
+  in_process = _schedule_ordinals(
+      [(2020, 3, 19)], [(2020, 3, 25)], _weekend_calendar())
+  script = textwrap.dedent("""
+      import json
+      import sys
+      sys.path.insert(0, "/workspace/repo")
+      from tf_quant_finance import datetime as dates
+
+      calendar = dates.create_holiday_calendar(
+          weekend_mask=dates.WeekendMask.SATURDAY_SUNDAY,
+          start_year=2020,
+          end_year=2020)
+      schedule = dates.BusinessDaySchedule(
+          start_date=dates.dates_from_tuples([(2020, 3, 19)]),
+          end_date=dates.dates_from_tuples([(2020, 3, 25)]),
+          holiday_calendar=calendar)
+      sys.stdout.write(json.dumps(schedule.dates().ordinal().numpy().tolist()))
+  """)
+
+  completed = subprocess.run(
+      [sys.executable, "-c", script],
+      check=True,
+      stdout=subprocess.PIPE,
+      stderr=subprocess.PIPE,
+      text=True)
+  fresh_process = json.loads(completed.stdout)
+
+  assert in_process == fresh_process
+  _assert_spec_example_ordinals_shape(fresh_process)
+
+
+def test_no_undeclared_cwd_files_or_network_access(tmp_path, monkeypatch):
+  def fail_socket(*unused_args, **unused_kwargs):
+    raise AssertionError("BusinessDaySchedule must not open network sockets")
+
+  monkeypatch.setattr(socket, "socket", fail_socket)
+  original_cwd = os.getcwd()
+  try:
+    os.chdir(tmp_path)
+    before = sorted(path.name for path in tmp_path.iterdir())
+    actual = _schedule_ordinals(
+        [(2020, 3, 19)], [(2020, 3, 25)], _weekend_calendar())
+    after = sorted(path.name for path in tmp_path.iterdir())
+  finally:
+    os.chdir(original_cwd)
+
+  _assert_spec_example_ordinals_shape(actual)
+  assert before == []
+  assert after == []
