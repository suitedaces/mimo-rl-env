+test('fresh Node process returns the same deterministic output after in-process calls', () => {
+  transformIcon(sources.plainIconOnly, 'noise-plain.vue')
+  transformIcon(sources.clearAttr, 'noise-clear.vue')
+  const inProcess = transformIcon(sources.duplicateIcon, 'global-state.vue')
+
+  const script = `
+const { transform } = require('/workspace/repo/packages/gogocode-plugin-element')
+const gogocode = require('/workspace/repo/packages/gogocode-core')
+const source = ${JSON.stringify(sources.duplicateIcon)}
+const output = transform(
+  { path: '/workspace/repo/usercase-test-coderl/fixtures/global-state.vue', source },
+  { gogocode },
+  { 'include-rules': 'icon' }
+)
+process.stdout.write(JSON.stringify(output))
+`
+  const freshProcess = JSON.parse(
+    childProcess.execFileSync(process.execPath, ['-e', script], {
+      encoding: 'utf8',
+    })
