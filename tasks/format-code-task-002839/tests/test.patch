+function escapeRegExp(value) {
+  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+}
+
+function expectIconImport(output, importedName, alias) {
+  const aliasPattern = `${escapeRegExp(importedName)}\\s+as\\s+${escapeRegExp(
+    alias
+  )}`
+
+  expect(output).toMatch(
+    new RegExp(
+      `import\\s*\\{[\\s\\S]*\\b${aliasPattern}\\b[\\s\\S]*\\}\\s*from\\s*['"]@element-plus/icons['"]`
+    )
+  )
+}
+
+function expectSingleIconImportAlias(output, importedName, alias) {
+
+  expect(
+    output.match(
+      new RegExp(
+        `\\b${escapeRegExp(importedName)}\\s+as\\s+${escapeRegExp(alias)}\\b`,
+        'g'
+      )
+    ) || []
+  ).toHaveLength(1)
+}
+
+function expectDataExposure(output, alias) {
+
+  expect(output).toMatch(
+    new RegExp(`\\bdata\\s*\\([^)]*\\)\\s*\\{[\\s\\S]*\\breturn\\s*\\{`)
+  )
+
+  expect(output).toMatch(
+    new RegExp(`\\breturn\\s*\\{[^}]*\\b${escapeRegExp(alias)}\\b[^}]*\\}`)
+  )
+}
+
+function expectComponentsRegistration(output, alias) {
+
+  expect(output).toMatch(
+    new RegExp(
+      `\\bcomponents\\s*:\\s*\\{[^}]*\\b${escapeRegExp(alias)}\\b[^}]*\\}`
+    )
+  )
+}
+
+function expectBoundAttribute(output, tagName, boundAttr, alias) {
+
+  expect(output).toMatch(
+    new RegExp(
+      `<${escapeRegExp(tagName)}\\b[^>]*\\s${escapeRegExp(
+        boundAttr
+      )}\\s*=\\s*["']${escapeRegExp(alias)}["'][^>]*>`
+    )
+  )
+}
+
+function expectNoStaticLegacyAttr(output, attr, legacyIcon) {
+
+  expect(output).not.toMatch(
+    new RegExp(
+      `\\s${escapeRegExp(attr)}\\s*=\\s*["']${escapeRegExp(legacyIcon)}["']`
+    )
+  )
+}
+
+function expectElementIconMigration({
+  output,
+  tagName,
+  originalAttr,
+  boundAttr,
+  legacyIcon,
+  importedName,
+  alias,
+}) {
+  expectBoundAttribute(output, tagName, boundAttr, alias)
+  expectNoStaticLegacyAttr(output, originalAttr, legacyIcon)
+  expectIconImport(output, importedName, alias)
+  expectDataExposure(output, alias)
+}
+
+function expectPlainIconMigration({
+  output,
+  legacyTag,
+  importedName,
+  alias,
+  restClass,
+  stylePattern,
+}) {
+
+  expect(output).toMatch(
+    new RegExp(
+      `<el-icon\\b[\\s\\S]*<${escapeRegExp(
+        legacyTag
+      )}\\b[^>]*(?:/>|></${escapeRegExp(legacyTag)}>)?[\\s\\S]*</el-icon>`
+    )
+  )
+
+  expect(output).not.toMatch(/<\/?i(?:\s|>)/)
+  expectIconImport(output, importedName, alias)
+  expectComponentsRegistration(output, alias)
+
+  if (restClass) {
+
+    expect(output).toMatch(
+      new RegExp(
+        `<el-icon\\b[^>]*\\sclass\\s*=\\s*["'][^"']*\\b${escapeRegExp(
+          restClass
+        )}\\b[^"']*["']`
+      )
+    )
+  }
+
+
+  expect(output).not.toMatch(
+    new RegExp(
+      `\\sclass\\s*=\\s*["'][^"']*\\b${escapeRegExp(legacyTag)}\\b[^"']*["']`
+    )
+  )
+
+  if (stylePattern) {
+
+    expect(output).toMatch(
+      new RegExp(`<el-icon\\b[^>]*\\sstyle\\s*=\\s*["'][^"']*${stylePattern}`)
+    )
+  }
+}
