+test('icon transform does not write cwd files or use network APIs', () => {
+  const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'icon-migration-'))
+  const originalCwd = process.cwd()
+  const originals = {
+    netConnect: net.connect,
+    netCreateConnection: net.createConnection,
+    httpRequest: http.request,
+    httpGet: http.get,
+    httpsRequest: https.request,
+    httpsGet: https.get,
+  }
+  const failNetwork = () => {
+    throw new Error('network side effect attempted')
+  }
+
+  process.chdir(tempDir)
+  net.connect = failNetwork
+  net.createConnection = failNetwork
+  http.request = failNetwork
+  http.get = failNetwork
+  https.request = failNetwork
+  https.get = failNetwork
+
+  try {
+    const before = fs.readdirSync(tempDir)
+    const output = transformIcon(sources.suffixAttr, 'side-effects.vue')
+
+
+    expectElementIconMigration({
+      output,
+      tagName: 'el-input',
+      originalAttr: 'suffix-icon',
+      boundAttr: ':suffix-icon',
+      legacyIcon: 'el-icon-date',
+      importedName: 'Date',
+      alias: 'ElIconDate',
+    })
+    const after = fs.readdirSync(tempDir)
+    expect(after).toEqual(before)
+  } finally {
+    net.connect = originals.netConnect
+    net.createConnection = originals.netCreateConnection
+    http.request = originals.httpRequest
+    http.get = originals.httpGet
+    https.request = originals.httpsRequest
+    https.get = originals.httpsGet
+    process.chdir(originalCwd)
+    fs.rmSync(tempDir, { recursive: true, force: true })
+  }
+})
