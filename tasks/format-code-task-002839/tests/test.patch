+
+
+  expect(inProcess).toBe(freshProcess)
+  expectBoundAttribute(inProcess, 'el-button', ':icon', 'ElIconSearch')
+  expectBoundAttribute(inProcess, 'el-input', ':prefix-icon', 'ElIconSearch')
+  expectSingleIconImportAlias(inProcess, 'Search', 'ElIconSearch')
+})
