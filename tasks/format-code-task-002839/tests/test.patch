+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+export NO_UPDATE_NOTIFIER=1
+export npm_config_audit=false
+export npm_config_fund=false
+export npm_config_offline=true
+export BROWSERSLIST_IGNORE_OLD_DATA=1
+
+for required_path in \
+  node_modules \
+  node_modules/.bin/jest \
+  packages/gogocode-core/node_modules \
+  packages/gogocode-plugin-element/node_modules
+do
+  if [ ! -e "$required_path" ]; then
+    echo "Offline dependency is missing: $required_path" >&2
+    exit 127
+  fi
+done
+
+exec /workspace/repo/node_modules/.bin/jest --runTestsByPath /workspace/repo/usercase-test-coderl/icon-migration.test.js --runInBand --no-watchman
