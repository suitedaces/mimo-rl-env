+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+if [ ! -x node_modules/.bin/jest ] || [ ! -d node_modules/ts-jest ]; then
+  npm ci --no-audit --no-fund
+fi
+
+
+case "${1:-}" in
+  base)
+    exit 0
+    ;;
+  new)
+    ./node_modules/.bin/jest --runInBand --no-coverage --runTestsByPath src/components/__tests__/LeftPanel.test.tsx
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
