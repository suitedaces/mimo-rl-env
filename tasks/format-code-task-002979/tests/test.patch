+/**
+ * @jest-environment jsdom
+ */
+import React, { useState } from 'react'
+
+import { act, render, screen } from 'rtl'
+import { IconNames } from '@blueprintjs/icons'
+import { runInAction } from 'mobx'
+
+import { AppState } from '$src/state/appState'
+import { FavoritesState } from '$src/state/favoritesState'
+import { SettingsState } from '$src/state/settingsState'
+
+import { LeftPanel } from '../LeftPanel'
+
+describe('LeftPanel favorites rendering', () => {
+    const options = {
+        providerProps: {
+            appState: null as AppState,
+            settingsState: null as SettingsState,
+        },
+    }
+
+    const makeFavorite = (label: string, path: string) => ({
+        label,
+        path,
+        icon: IconNames.FOLDER_CLOSE,
+        isReadOnly: false,
+    })
+
+    let originalEnv: Record<string, unknown>
+    let buildDrivesListSpy: jest.SpyInstance
+    let setHide: React.Dispatch<React.SetStateAction<boolean>> = () => undefined
+
+    const Harness = ({ initialHide = false }: { initialHide?: boolean }) => {
+        const [hide, updateHide] = useState(initialHide)
+        setHide = updateHide
+        return <LeftPanel hide={hide} />
+    }
+
+    beforeEach(async () => {
+        buildDrivesListSpy = jest.spyOn(FavoritesState.prototype, 'buildDrivesList').mockImplementation(function (this: FavoritesState) {
+            this.buildShortcuts()
+        })
+        const appState = new AppState()
+        options.providerProps.appState = appState
+        options.providerProps.settingsState = appState.settingsState
+        await options.providerProps.appState.loadSettingsAndPrepareViews()
+        originalEnv = (window as any).ENV
+        ;(window as any).ENV = { ...(originalEnv ?? {}), CY: true }
+        setHide = () => undefined
+    })
+
+    afterEach(() => {
+        buildDrivesListSpy.mockRestore()
+        ;(window as any).ENV = originalEnv
+    })
+
+    it('renders_distribution_favorites_in_test_environment_when_present', () => {
+        const { favoritesState } = options.providerProps.appState
+        const suffix = `dist-${Date.now()}-${Math.random()}`
+        const ubuntuLabel = `Ubuntu favorite ${suffix}`
+        const debianLabel = `Debian favorite ${suffix}`
+        runInAction(() => {
+            favoritesState.distributions.push(
+                makeFavorite(ubuntuLabel, `/wsl/${suffix}/ubuntu`),
+                makeFavorite(debianLabel, `/wsl/${suffix}/debian`),
+            )
+        })
+
+        render(<Harness initialHide={false} />, options)
+
+        expect(screen.getByText(ubuntuLabel)).toBeInTheDocument()
+        expect(screen.getByText(debianLabel)).toBeInTheDocument()
+    })
+
+    it('reflects_place_and_distribution_changes_made_while_hidden_after_showing', () => {
+        const { favoritesState } = options.providerProps.appState
+        const suffix = `hidden-${Date.now()}-${Math.random()}`
+        const stalePlaceLabel = `Removed place ${suffix}`
+        const freshPlaceLabel = `Fresh place ${suffix}`
+        const staleDistroLabel = `Removed distro ${suffix}`
+        const freshDistroLabel = `Fresh distro ${suffix}`
+        runInAction(() => {
+            favoritesState.places.push(makeFavorite(stalePlaceLabel, `/tmp/${suffix}/removed-place`))
+            favoritesState.distributions.push(makeFavorite(staleDistroLabel, `/wsl/${suffix}/removed-distro`))
+        })
+        render(<Harness initialHide={false} />, options)
+        expect(screen.getByText(stalePlaceLabel)).toBeInTheDocument()
+
+        act(() => {
+            setHide(true)
+        })
+
+        act(() => {
+            runInAction(() => {
+                const stalePlaceIndex = favoritesState.places.findIndex((favorite) => favorite.label === stalePlaceLabel)
+                if (stalePlaceIndex !== -1) {
+                    favoritesState.places.splice(stalePlaceIndex, 1)
+                }
+                const staleDistroIndex = favoritesState.distributions.findIndex(
+                    (favorite) => favorite.label === staleDistroLabel,
+                )
+                if (staleDistroIndex !== -1) {
+                    favoritesState.distributions.splice(staleDistroIndex, 1)
+                }
+                favoritesState.places.push(makeFavorite(freshPlaceLabel, `/tmp/${suffix}/fresh-place`))
+                favoritesState.distributions.push(makeFavorite(freshDistroLabel, `/wsl/${suffix}/fresh-distro`))
+            })
+        })
+
+        expect(screen.getByText(freshPlaceLabel)).toBeInTheDocument()
+        expect(screen.getByText(freshDistroLabel)).toBeInTheDocument()
+        expect(screen.queryByText(stalePlaceLabel)).not.toBeInTheDocument()
+        expect(screen.queryByText(staleDistroLabel)).not.toBeInTheDocument()
+
+        act(() => {
+            setHide(false)
+        })
+
+        expect(screen.getByText(freshPlaceLabel)).toBeInTheDocument()
+        expect(screen.getByText(freshDistroLabel)).toBeInTheDocument()
+        expect(screen.queryByText(stalePlaceLabel)).not.toBeInTheDocument()
+        expect(screen.queryByText(staleDistroLabel)).not.toBeInTheDocument()
+    })
+})
