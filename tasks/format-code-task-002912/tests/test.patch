diff --git a/test/api/function-as-assertion.spec.js b/test/api/function-as-assertion.spec.js
new file mode 100644
index 00000000..6d454c7f
--- /dev/null
+++ b/test/api/function-as-assertion.spec.js
@@ -0,0 +1,116 @@
+
+describe('expect with a function as the assertion', () => {
+  describe('at the top level', () => {
+    it('succeeds when the function does not throw', () => {
+      expect(5, n => {
+        expect(n, 'to be a number');
+      });
+    });
+
+    it('treats a function that returns without throwing as a success regardless of return value', () => {
+      expect('anything', () => 'some truthy return value');
+    });
+
+    it('fails with the error thrown by the function', () => {
+      expect(
+        () => {
+          expect(5, n => {
+            expect(n, 'to be a string');
+          });
+        },
+        'to throw',
+        'expected 5 to be a string'
+      );
+    });
+
+    it('no longer raises the "second parameter" error for a function', () => {
+
+
+      expect(5, () => {});
+    });
+
+    it('does not call the function more than once', () => {
+      let calls = 0;
+      expect('foo', () => {
+        calls += 1;
+      });
+      expect(calls, 'to equal', 1);
+    });
+  });
+
+  describe('with an asynchronous function', () => {
+    it('succeeds when the returned promise is fulfilled', () => {
+      return expect('foo', value =>
+        expect.promise(run => {
+          setTimeout(run(() => expect(value, 'to equal', 'foo')));
+        })
+      );
+    });
+
+    it('fails when the returned promise is rejected', () => {
+      return expect(
+        () =>
+          expect('foo', value =>
+            expect.promise(run => {
+              setTimeout(run(() => expect(value, 'to equal', 'bar')));
+            })
+          ),
+        'to be rejected with',
+        "expected 'foo' to equal 'bar'\n" + '\n' + '-foo\n' + '+bar'
+      );
+    });
+  });
+
+  describe('from inside a custom assertion', () => {
+    const clonedExpect = expect
+      .clone()
+      .addAssertion('<any> to pass the check <function>', (expect, subject, fn) =>
+        expect(subject, fn)
+      );
+
+    it('succeeds when the function does not throw', () => {
+      clonedExpect(5, 'to pass the check', n => {
+        expect(n, 'to be a number');
+      });
+    });
+
+    it("reports the function's failure nested within the surrounding assertion", () => {
+      clonedExpect(
+        () => {
+          clonedExpect(5, 'to pass the check', n => {
+            expect(n, 'to be a string');
+          });
+        },
+        'to throw',
+        err => {
+          expect(err.message, 'to contain', 'to pass the check');
+          expect(err.message, 'to contain', 'expected 5 to be a string');
+        }
+      );
+    });
+  });
+
+  describe('compatibility with existing argument kinds', () => {
+    it('still supports string assertions', () => {
+      expect(2, 'to be a number');
+      expect(
+        () => {
+          expect(2, 'to be a string');
+        },
+        'to throw',
+        'expected 2 to be a string'
+      );
+    });
+
+    it('still supports expect.it expressions', () => {
+      expect('foo', expect.it('to be a string'));
+      expect(
+        () => {
+          expect(5, expect.it('to be a string'));
+        },
+        'to throw',
+        'expected 5 to be a string'
+      );
+    });
+  });
+});
