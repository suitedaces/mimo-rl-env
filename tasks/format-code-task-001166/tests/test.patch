diff --git a/test/codespec-import-bindings.mjs b/test/codespec-import-bindings.mjs
new file mode 100644
index 00000000..e87a0e14
--- /dev/null
+++ b/test/codespec-import-bindings.mjs
@@ -0,0 +1,99 @@
+import assert from 'node:assert/strict';
+import {ESLint} from 'eslint';
+import plugin from '../src/index.js';
+
+const lint = async (code, filePath) => {
+  const eslint = new ESLint({
+    overrideConfigFile: true,
+    overrideConfig: {
+      files: ['**/*'],
+      plugins: {jsdoc: plugin},
+      rules: {
+        'jsdoc/check-values': 'error',
+        'jsdoc/no-undefined-types': 'error',
+      },
+      settings: {jsdoc: {mode: 'typescript'}},
+    },
+  });
+  const [result] = await eslint.lintText(code, {filePath});
+  return result.messages;
+};
+
+const ruleMessages = (messages, ruleId) => {
+  return messages.filter(({ruleId: currentRule}) => currentRule === ruleId);
+};
+
+
+
+{
+  const messages = await lint(
+    "/** @import { ExternalName as LocalName, OtherName } from 'pkg' */\n" +
+    '/** @type {LocalName} */\nconst first = null;\n' +
+    '/** @type {OtherName} */\nconst second = null;',
+    'codespec-named.js',
+  );
+  assert.deepEqual(ruleMessages(messages, 'jsdoc/check-values'), []);
+  assert.deepEqual(ruleMessages(messages, 'jsdoc/no-undefined-types'), []);
+}
+
+
+
+{
+  const messages = await lint(
+    "/** @import DefaultType, { NamedType as LocalNamed } from 'pkg' */\n" +
+    "/** @import * as Namespace from 'pkg' */\n" +
+    '/** @type {DefaultType} */\nconst first = null;\n' +
+    '/** @type {LocalNamed} */\nconst named = null;\n' +
+    '/** @type {Namespace.Member} */\nconst second = null;',
+    'codespec-default-namespace.js',
+  );
+  assert.deepEqual(ruleMessages(messages, 'jsdoc/check-values'), []);
+  assert.deepEqual(ruleMessages(messages, 'jsdoc/no-undefined-types'), []);
+}
+
+
+{
+  const messages = await lint(
+    "/** @import type TypeOnly, { ExternalType as LocalType } from 'pkg' */\n" +
+    '/** @type {TypeOnly} */\nconst first = null;\n' +
+    '/** @type {LocalType} */\nconst second = null;',
+    'codespec-type-only.js',
+  );
+  assert.deepEqual(ruleMessages(messages, 'jsdoc/check-values'), []);
+  assert.deepEqual(ruleMessages(messages, 'jsdoc/no-undefined-types'), []);
+}
+
+
+{
+  const messages = await lint(
+    "/** @import { ExternalType as LocalType } from 'pkg' */\n" +
+    '/** @type {ExternalType} */\nconst value = null;',
+    'codespec-alias-scope.js',
+  );
+  const undefinedMessages = ruleMessages(messages, 'jsdoc/no-undefined-types');
+  assert.equal(undefinedMessages.length, 1);
+  assert.equal(undefinedMessages[0].message, "The type 'ExternalType' is undefined.");
+}
+
+
+{
+  const messages = await lint(
+    "/** @import { MissingName from 'pkg' */\nconst value = null;",
+    'codespec-malformed.js',
+  );
+  assert.equal(ruleMessages(messages, 'jsdoc/check-values').length, 1);
+  assert.equal(ruleMessages(messages, 'jsdoc/check-values')[0].message, 'Bad @import tag');
+}
+
+
+{
+  const messages = await lint(
+    '/**\n * @import { ExistingName } from \'pkg\'\n */\n' +
+    '/** @type {ExistingName} */\nconst value = null;',
+    'codespec-multiline.js',
+  );
+  assert.deepEqual(ruleMessages(messages, 'jsdoc/check-values'), []);
+  assert.deepEqual(ruleMessages(messages, 'jsdoc/no-undefined-types'), []);
+}
+
+console.log('codespec import binding checks passed');
