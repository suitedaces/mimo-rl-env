diff --git a/test/unit/web-server.spec.coffee b/test/unit/web-server.spec.coffee
index 2c941b3b..717a68c8 100644
--- a/test/unit/web-server.spec.coffee
+++ b/test/unit/web-server.spec.coffee
@@ -312,6 +312,76 @@ describe 'web-server', ->
       karmaSrcHandler new httpMock.ServerRequest('/_karma_/context.html'), response, nextSpy
 
 
+    it 'should serve context.html with link tags for css files', (done) ->
+      includedFiles [{path: '/style.css', mtime: new Date 12345}]
+
+      response.once 'end', ->
+        expect(nextSpy).not.to.have.been.called
+        expect(response._content.toString()).to.equal  'CONTEXT\n' +
+        '<link type="text/css" href="/absolute/style.css?12345" rel="stylesheet">'
+        expect(response.statusCode).to.equal 200
+        done()
+
+      karmaSrcHandler new httpMock.ServerRequest('/_karma_/context.html'), response, nextSpy
+
+
+    it 'should serve debug.html with link tags for css files without timestamps', (done) ->
+      includedFiles [{path: '/style.css', mtime: new Date 12345}]
+
+      response.once 'end', ->
+        expect(nextSpy).not.to.have.been.called
+        expect(response._content.toString()).to.equal  'RUNNER\n' +
+        '<link type="text/css" href="/absolute/style.css" rel="stylesheet">'
+        expect(response.statusCode).to.equal 200
+        done()
+
+      karmaSrcHandler new httpMock.ServerRequest('/_karma_/debug.html'), response, nextSpy
+
+
+    it 'should serve context.html with mixed js and css files', (done) ->
+      includedFiles [{path: '/first.js', mtime: new Date 12345},
+          {path: '/style.css', mtime: new Date 67890}]
+
+      response.once 'end', ->
+        expect(nextSpy).not.to.have.been.called
+        expect(response._content.toString()).to.equal  'CONTEXT\n' +
+        '<script type="text/javascript" src="/absolute/first.js?12345"></script>\n' +
+        '<link type="text/css" href="/absolute/style.css?67890" rel="stylesheet">'
+        expect(response.statusCode).to.equal 200
+        done()
+
+      karmaSrcHandler new httpMock.ServerRequest('/_karma_/context.html'), response, nextSpy
+
+
+    it 'should serve css files from /base, /adapter, /absolute paths', (done) ->
+      includedFiles [{path: '/some/abs/a.css', mtime: new Date 12345},
+        {path: '/base/path/b.css', mtime: new Date 67890},
+        {path: '/karma/adapter/c.css', mtime: new Date 321}]
+
+      response.once 'end', ->
+        expect(nextSpy).not.to.have.been.called
+        expect(response._content.toString()).to.equal  'CONTEXT\n' +
+        '<link type="text/css" href="/absolute/some/abs/a.css?12345" rel="stylesheet">\n' +
+        '<link type="text/css" href="/base/b.css?67890" rel="stylesheet">\n' +
+        '<link type="text/css" href="/adapter/c.css?321" rel="stylesheet">'
+        expect(response.statusCode).to.equal 200
+        done()
+
+      karmaSrcHandler new httpMock.ServerRequest('/_karma_/context.html'), response, nextSpy
+
+
+    it 'should serve url css files as link tags unchanged', (done) ->
+      includedFiles [{path: 'http://some.url.com/style.css', isUrl: true}]
+
+      response.once 'end', ->
+        expect(response._content.toString()).to.equal  'CONTEXT\n' +
+        '<link type="text/css" href="http://some.url.com/style.css" rel="stylesheet">'
+        expect(response.statusCode).to.equal 200
+        done()
+
+      karmaSrcHandler new httpMock.ServerRequest('/_karma_/context.html'), response, nextSpy
+
+
