diff --git a/acl/policy_test.go b/acl/policy_test.go
index e53917f25c..f17400d2d3 100644
--- a/acl/policy_test.go
+++ b/acl/policy_test.go
@@ -208,3 +208,60 @@ func TestParse(t *testing.T) {
 		})
 	}
 }
+
+
+
+
+
+
+
+func TestParseRejectsEmptyDecodedPolicy(t *testing.T) {
+
+	issueJSON := `{"Name":"my-policy","Description":"This is a great policy","Rules":"anything"}`
+	if _, err := Parse(issueJSON); err == nil {
+		t.Fatalf("expected error parsing issue example, got nil")
+	}
+
+
+	if _, err := Parse(`{}`); err == nil {
+		t.Fatalf("expected error parsing empty JSON object, got nil")
+	}
+
+
+	if _, err := Parse(`{ }`); err == nil {
+		t.Fatalf("expected error parsing empty HCL body, got nil")
+	}
+}
+
+
+
+func TestParseEmptyRulesAllowed(t *testing.T) {
+	p, err := Parse("")
+	if err != nil {
+		t.Fatalf("unexpected error for empty rules: %v", err)
+	}
+	if p == nil {
+		t.Fatalf("expected non-nil policy for empty rules")
+	}
+	if p.Raw != "" {
+		t.Fatalf("expected empty Raw, got %q", p.Raw)
+	}
+}
+
+
+
+
+func TestParseValidPolicyStillParses(t *testing.T) {
+	cases := []string{
+		`namespace "default" { policy = "read" }`,
+		`agent { policy = "read" }`,
+		`node { policy = "write" }`,
+		`operator { policy = "deny" }`,
+		`quota { policy = "read" }`,
+	}
+	for _, raw := range cases {
+		if _, err := Parse(raw); err != nil {
+			t.Fatalf("unexpected error parsing %q: %v", raw, err)
+		}
+	}
+}
