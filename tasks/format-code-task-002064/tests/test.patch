diff --git a/src/test/unit_tests/jest_tests/test_nc_nsfs_config_schema_validation.test.js b/src/test/unit_tests/jest_tests/test_nc_nsfs_config_schema_validation.test.js
index 394df9489..bb53e041f 100644
--- a/src/test/unit_tests/jest_tests/test_nc_nsfs_config_schema_validation.test.js
+++ b/src/test/unit_tests/jest_tests/test_nc_nsfs_config_schema_validation.test.js
@@ -170,7 +170,95 @@ describe('schema validation NC NSFS config', () => {
             assert_validation(config_data, reason, message);
         });
 
+        it('nsfs_config invalid VIRTUAL_HOSTS - number', () => {
+            const config_data = {
+                VIRTUAL_HOSTS: 123,
+            };
+            const reason = 'Test should have failed because of wrong type ' +
+                'VIRTUAL_HOSTS with number (instead of string)';
+            const message = 'must be string';
+            assert_validation(config_data, reason, message);
+        });
+
+        it('nsfs_config invalid VIRTUAL_HOSTS - boolean', () => {
+            const config_data = {
+                VIRTUAL_HOSTS: false,
+            };
+            const reason = 'Test should have failed because of wrong type ' +
+                'VIRTUAL_HOSTS with boolean (instead of string)';
+            const message = 'must be string';
+            assert_validation(config_data, reason, message);
+        });
+
+
+    });
+
+    describe('config with valid VIRTUAL_HOSTS values', () => {
+
+        it('nsfs_config valid VIRTUAL_HOSTS - single domain', () => {
+            const config_data = {
+                VIRTUAL_HOSTS: 'my.virtual.host.io',
+            };
+            nsfs_schema_utils.validate_nsfs_config_schema(config_data);
+        });
 
+        it('nsfs_config valid VIRTUAL_HOSTS - multiple domains space separated', () => {
+            const config_data = {
+                VIRTUAL_HOSTS: 'host1.example.com host2.example.com host3.example.com',
+            };
+            nsfs_schema_utils.validate_nsfs_config_schema(config_data);
+        });
+
+        it('nsfs_config valid VIRTUAL_HOSTS - empty string', () => {
+            const config_data = {
+                VIRTUAL_HOSTS: '',
+            };
+            nsfs_schema_utils.validate_nsfs_config_schema(config_data);
+        });
+    });
+
+    describe('config VIRTUAL_HOSTS reads from env', () => {
+
+        const ENV_KEY = 'VIRTUAL_HOSTS';
+        let saved_env;
+
+        beforeEach(() => {
+            saved_env = process.env[ENV_KEY];
+        });
+
+        afterEach(() => {
+            if (saved_env === undefined) {
+                delete process.env[ENV_KEY];
+            } else {
+                process.env[ENV_KEY] = saved_env;
+            }
+            jest.resetModules();
+        });
+
+        it('config.VIRTUAL_HOSTS picks up env value', () => {
+            process.env[ENV_KEY] = 'envhost.example.com other.example.com';
+            jest.resetModules();
+            // eslint-disable-next-line global-require
+            const fresh_config = require('../../../../config');
+            expect(fresh_config.VIRTUAL_HOSTS).toBe('envhost.example.com other.example.com');
+        });
+
+        it('config.VIRTUAL_HOSTS defaults to empty string when env not set', () => {
+            delete process.env[ENV_KEY];
+            jest.resetModules();
+            // eslint-disable-next-line global-require
+            const fresh_config = require('../../../../config');
+            expect(fresh_config.VIRTUAL_HOSTS).toBe('');
+        });
+
+        it('config.VIRTUAL_HOSTS is a string property', () => {
+            process.env[ENV_KEY] = 'just.one.host';
+            jest.resetModules();
+            // eslint-disable-next-line global-require
+            const fresh_config = require('../../../../config');
+            expect(typeof fresh_config.VIRTUAL_HOSTS).toBe('string');
+            expect(fresh_config.VIRTUAL_HOSTS).toBe('just.one.host');
+        });
     });
 });
 
