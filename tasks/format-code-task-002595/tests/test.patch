index 12e71b6e..611d752a 100644
--- a/test/test_lazy.py
+++ b/test/test_lazy.py
@@ -422,3 +422,103 @@ def test_(request, case):
     result.stdout.re_match_lines(
         [r"E       Failed: Body parameters are defined for GET request.",]
     )
+
+
+def test_hooks_apply_per_test_function(testdir, simple_openapi):
+
+    testdir.make_test(
+        """
+from hypothesis import strategies as st
+
+@pytest.fixture
+def simple_schema():
+    return schema
+
+lazy_schema = schemathesis.from_pytest_fixture("simple_schema")
+
+def before_generate_query(context, strategy):
+    return st.just({"id": "from_apply_hook"})
+
+@lazy_schema.hooks.apply(before_generate_query)
+@lazy_schema.parametrize()
+@settings(max_examples=1)
+def test_(request, case):
+    request.config.HYPOTHESIS_CASES += 1
+    assert case.query["id"] == "from_apply_hook"
+""",
+        schema=simple_openapi,
+    )
+    result = testdir.runpytest("-v", "-s")
+
+    result.assert_outcomes(passed=1)
+    result.stdout.re_match_lines([r"Hypothesis calls: 1$"])
+
+
+def test_hooks_apply_per_test_function_named(testdir, simple_openapi):
+
+    testdir.make_test(
+        """
+from hypothesis import strategies as st
+
+@pytest.fixture
+def simple_schema():
+    return schema
+
+lazy_schema = schemathesis.from_pytest_fixture("simple_schema")
+
+def replacement(context, strategy):
+    return st.just({"id": "named_apply"})
+
+@lazy_schema.hooks.apply(replacement, name="before_generate_query")
+@lazy_schema.parametrize()
+@settings(max_examples=1)
+def test_(request, case):
+    request.config.HYPOTHESIS_CASES += 1
+    assert case.query["id"] == "named_apply"
+""",
+        schema=simple_openapi,
+    )
+    result = testdir.runpytest("-v", "-s")
+
+    result.assert_outcomes(passed=1)
+    result.stdout.re_match_lines([r"Hypothesis calls: 1$"])
+
+
+def test_hooks_register_schema_level(testdir, simple_openapi):
+
+    testdir.make_test(
+        """
+from hypothesis import strategies as st
+
+@pytest.fixture
+def simple_schema():
+    return schema
+
+lazy_schema = schemathesis.from_pytest_fixture("simple_schema")
+
+@lazy_schema.hooks.register("before_generate_query")
+def schema_hook(context, strategy):
+    return st.just({"id": "from_schema_level"})
+
+@lazy_schema.parametrize()
+@settings(max_examples=1)
+def test_(request, case):
+    request.config.HYPOTHESIS_CASES += 1
+    assert case.query["id"] == "from_schema_level"
+""",
+        schema=simple_openapi,
+    )
+    result = testdir.runpytest("-v", "-s")
+
+    result.assert_outcomes(passed=1)
+    result.stdout.re_match_lines([r"Hypothesis calls: 1$"])
+
+
+def test_hooks_attribute_on_lazy_schema():
+
+    import schemathesis
+    from schemathesis.hooks import HookDispatcher
+
+    lazy_schema = schemathesis.from_pytest_fixture("anything")
+
+    assert isinstance(lazy_schema.hooks, HookDispatcher)
