+package fields
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestFieldDataValidateReportsAllInputAndSchemaProblems(t *testing.T) {
+	d := &FieldData{
+		Schema: map[string]*FieldSchema{
+			"name":    {Type: TypeString, Required: true},
+			"enabled": {Type: TypeBool},
+			"labels":  {Type: TypeMap, Required: true},
+			"mode":    {Type: TypeInvalid},
+		},
+		Raw: map[string]interface{}{
+			"enabled": "definitely-not-a-bool",
+			"labels":  map[string]interface{}{},
+			"extra":   "not declared",
+		},
+	}
+
+	var err error
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				t.Fatalf("Validate panicked: %v", r)
+			}
+		}()
+		err = d.Validate()
+	}()
+	if err == nil {
+		t.Fatal("Validate returned nil for invalid data")
+	}
+	message := err.Error()
+	for _, want := range []string{
+		`field "name" is required`,
+		`field "enabled" with input`,
+		`field "labels" is required, but no value was found`,
+		`"extra" is an invalid field`,
+		`unknown field type unknown type for field mode`,
+	} {
+		if !strings.Contains(message, want) {
+			t.Errorf("Validate error %q does not contain %q", message, want)
+		}
+	}
+}
+
+func TestFieldDataValidateRequiredArrayAndMapDoesNotPanic(t *testing.T) {
+	for _, typ := range []FieldType{TypeMap, TypeArray} {
+		t.Run(typ.String(), func(t *testing.T) {
+			d := &FieldData{
+				Schema: map[string]*FieldSchema{
+					"items": {Type: typ, Required: true},
+				},
+				Raw: map[string]interface{}{
+					"items": map[string]interface{}{},
+				},
+			}
+			if typ == TypeArray {
+				d.Raw["items"] = []interface{}{}
+			}
+
+			var err error
+			func() {
+				defer func() {
+					if r := recover(); r != nil {
+						t.Fatalf("Validate panicked for %s: %v", typ, r)
+					}
+				}()
+				err = d.Validate()
+			}()
+			if err == nil || !strings.Contains(err.Error(), `is required, but no value was found`) {
+				t.Fatalf("Validate error = %v; want required empty %s failure", err, typ)
+			}
+		})
+	}
+}
+
+func TestFieldDataValidateAcceptsValidValuesAndOptionalEmptyCollections(t *testing.T) {
+	d := &FieldData{
+		Schema: map[string]*FieldSchema{
+			"name":    {Type: TypeString, Required: true},
+			"count":   {Type: TypeInt, Required: true},
+			"enabled": {Type: TypeBool, Required: true},
+			"labels":  {Type: TypeMap},
+			"items":   {Type: TypeArray},
+		},
+		Raw: map[string]interface{}{
+			"name":    "worker",
+			"count":   3,
+			"enabled": true,
+			"labels":  map[string]interface{}{},
+			"items":   []interface{}{},
+		},
+	}
+	if err := d.Validate(); err != nil {
+		t.Fatalf("Validate rejected valid values: %v", err)
+	}
+}
+
+func TestFieldDataValidateRejectsRequiredScalarZeroValues(t *testing.T) {
+	d := &FieldData{
+		Schema: map[string]*FieldSchema{
+			"text":   {Type: TypeString, Required: true},
+			"count":  {Type: TypeInt, Required: true},
+			"active": {Type: TypeBool, Required: true},
+		},
+		Raw: map[string]interface{}{
+			"text":   "",
+			"count":  0,
+			"active": false,
+		},
+	}
+	err := d.Validate()
+	if err == nil {
+		t.Fatal("Validate accepted zero values for required fields")
+	}
+	for _, field := range []string{"text", "count", "active"} {
+		if !strings.Contains(err.Error(), `field "`+field+`" is required, but no value was found`) {
+			t.Errorf("Validate error %q does not reject required %s", err, field)
+		}
+	}
+}
+
+func TestFieldDataValidateChecksInvalidSchemaWithoutRawValue(t *testing.T) {
+	d := &FieldData{Schema: map[string]*FieldSchema{
+		"future": {Type: TypeInvalid},
+	}}
+	if err := d.Validate(); err == nil || !strings.Contains(err.Error(), "unknown field type") {
+		t.Fatalf("Validate error = %v; want unknown schema type", err)
+	}
+}
+
+func TestFieldDataGetKeepsExplicitZeroValues(t *testing.T) {
+	d := &FieldData{
+		Schema: map[string]*FieldSchema{
+			"text":   {Type: TypeString, Default: "fallback"},
+			"count":  {Type: TypeInt, Default: 9},
+			"active": {Type: TypeBool, Default: true},
+			"labels": {Type: TypeMap, Default: map[string]interface{}{"default": "yes"}},
+		},
+		Raw: map[string]interface{}{
+			"text":   "",
+			"count":  0,
+			"active": false,
+			"labels": map[string]interface{}{},
+		},
+	}
+
+	want := map[string]interface{}{
+		"text":   "",
+		"count":  0,
+		"active": false,
+		"labels": map[string]interface{}{},
+	}
+	for key, expected := range want {
+		if got := d.Get(key); !reflect.DeepEqual(got, expected) {
+			t.Errorf("Get(%q) = %#v; want %#v", key, got, expected)
+		}
+	}
+}
+
+func TestFieldDataGetOkDistinguishesPresence(t *testing.T) {
+	d := &FieldData{
+		Schema: map[string]*FieldSchema{
+			"flag": {Type: TypeBool},
+			"name": {Type: TypeString},
+		},
+		Raw: map[string]interface{}{"flag": false},
+	}
+
+	if got, ok := d.GetOk("flag"); !ok || got != false {
+		t.Fatalf("GetOk(flag) = %#v, %v; want explicit false, true", got, ok)
+	}
+	if got, ok := d.GetOk("name"); ok || got != nil {
+		t.Fatalf("GetOk(name) = %#v, %v; want nil, false", got, ok)
+	}
+	if got, ok := d.GetOk("unknown"); ok || got != nil {
+		t.Fatalf("GetOk(unknown) = %#v, %v; want nil, false", got, ok)
+	}
+}
+
+func TestFieldDataGetOkErrReportsUnknownAndConversionErrors(t *testing.T) {
+	d := &FieldData{
+		Schema: map[string]*FieldSchema{
+			"count": {Type: TypeInt},
+		},
+		Raw: map[string]interface{}{"count": "not-an-integer"},
+	}
+
+	if value, ok, err := d.GetOkErr("count"); err == nil || !ok {
+		t.Fatalf("GetOkErr(count) = %#v, %v, %v; want conversion error with presence", value, ok, err)
+	}
+	d.Raw = map[string]interface{}{}
+	if value, ok, err := d.GetOkErr("count"); err != nil || ok || value != nil {
+		t.Fatalf("GetOkErr(absent count) = %#v, %v, %v; want nil, false, nil", value, ok, err)
+	}
+	if _, ok, err := d.GetOkErr("unknown"); err == nil || ok {
+		t.Fatalf("GetOkErr(unknown) = ok=%v err=%v; want schema error", ok, err)
+	}
+}
+
