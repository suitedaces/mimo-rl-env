+	"sigs.k8s.io/controller-runtime/pkg/webhook/admission"
+)
+
+
+
+func buildModelcarConfigMap(storageInitializer string) *v1.ConfigMap {
+	return &v1.ConfigMap{
+		TypeMeta: metav1.TypeMeta{
+			Kind:       "ConfigMap",
+			APIVersion: "v1",
+		},
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      constants.InferenceServiceConfigMapName,
+			Namespace: constants.KServeNamespace,
+		},
+		Data: map[string]string{
+			StorageInitializerConfigMapKeyName: storageInitializer,
+			LoggerConfigMapKeyName: `{
+				"image" : "kserve/agent:latest",
+				"memoryRequest": "100Mi",
+				"memoryLimit": "1Gi",
+				"cpuRequest": "100m",
+				"cpuLimit": "1",
+				"defaultUrl": "http://default-broker"
+			}`,
+			BatcherConfigMapKeyName: `{
+				"image" : "kserve/agent:latest",
+				"memoryRequest": "1Gi",
+				"memoryLimit": "1Gi",
+				"cpuRequest": "1",
+				"cpuLimit": "1"
+			}`,
+			constants.AgentConfigMapKeyName: `{
+				"image" : "kserve/agent:latest",
+				"memoryRequest": "100Mi",
+				"memoryLimit": "1Gi",
+				"cpuRequest": "100m",
+				"cpuLimit": "1"
+			}`,
+		},
+	}
+}
+
+
+
+func buildPodWithStorageUri(storageUri string) *v1.Pod {
+	return &v1.Pod{
+		TypeMeta: metav1.TypeMeta{
+			Kind:       "Pod",
+			APIVersion: "v1",
+		},
+		ObjectMeta: metav1.ObjectMeta{
+			Labels: map[string]string{
+				constants.InferenceServicePodLabelKey: "",
+			},
+			Annotations: map[string]string{
+				constants.StorageInitializerSourceUriInternalAnnotationKey: storageUri,
+			},
+		},
+		Spec: v1.PodSpec{
+			Containers: []v1.Container{
+				{
+					Name: constants.InferenceServiceContainerName,
+				},
+			},
+		},
+	}
+}
+
+func runMutate(t *testing.T, pod *v1.Pod, configMap *v1.ConfigMap) {
+	t.Helper()
+	mutator := Mutator{Client: c, Decoder: admission.NewDecoder(c.Scheme())}
+	if err := mutator.mutate(pod, configMap); err != nil {
+		t.Fatalf("mutate returned unexpected error: %v", err)
+	}
+}
+
+func findContainer(pod *v1.Pod, name string) *v1.Container {
+	for i := range pod.Spec.Containers {
+		if pod.Spec.Containers[i].Name == name {
+			return &pod.Spec.Containers[i]
+		}
+	}
+	return nil
+}
+
+func findInitContainer(pod *v1.Pod, name string) *v1.Container {
+	for i := range pod.Spec.InitContainers {
+		if pod.Spec.InitContainers[i].Name == name {
+			return &pod.Spec.InitContainers[i]
+		}
+	}
+	return nil
+}
+
+func findEnv(c *v1.Container, name string) *v1.EnvVar {
+	for i := range c.Env {
+		if c.Env[i].Name == name {
+			return &c.Env[i]
+		}
+	}
+	return nil
+}
+
+func findVolume(pod *v1.Pod, name string) *v1.Volume {
+	for i := range pod.Spec.Volumes {
+		if pod.Spec.Volumes[i].Name == name {
+			return &pod.Spec.Volumes[i]
+		}
+	}
+	return nil
+}
+
+func TestModelcarInjectedForOciUri(t *testing.T) {
+	g := gomega.NewGomegaWithT(t)
+
+	cm := buildModelcarConfigMap(`{
+		"image" : "kserve/storage-initializer:latest",
+		"memoryRequest": "100Mi",
+		"memoryLimit": "1Gi",
+		"cpuRequest": "100m",
+		"cpuLimit": "1",
+		"enableModelcar": true
+	}`)
+	pod := buildPodWithStorageUri("oci://myrepo/mymodel:1.0")
+
+	runMutate(t, pod, cm)
+
+
+	modelcar := findContainer(pod, "modelcar")
+	g.Expect(modelcar).ShouldNot(gomega.BeNil(), "expected a sidecar container named 'modelcar'")
+	g.Expect(modelcar.Image).Should(gomega.Equal("myrepo/mymodel:1.0"))
+
+
+	g.Expect(modelcar.Resources.Requests.Cpu().Cmp(resource.MustParse("10m"))).Should(gomega.Equal(0))
+	g.Expect(modelcar.Resources.Requests.Memory().Cmp(resource.MustParse("15Mi"))).Should(gomega.Equal(0))
+	g.Expect(modelcar.Resources.Limits.Cpu().Cmp(resource.MustParse("10m"))).Should(gomega.Equal(0))
+	g.Expect(modelcar.Resources.Limits.Memory().Cmp(resource.MustParse("15Mi"))).Should(gomega.Equal(0))
+
+
+	g.Expect(pod.Spec.ShareProcessNamespace).ShouldNot(gomega.BeNil())
+	g.Expect(*pod.Spec.ShareProcessNamespace).Should(gomega.BeTrue())
+
+
+	userContainer := findContainer(pod, constants.InferenceServiceContainerName)
+	g.Expect(userContainer).ShouldNot(gomega.BeNil())
+	initModeEnv := findEnv(userContainer, "MODEL_INIT_MODE")
+	g.Expect(initModeEnv).ShouldNot(gomega.BeNil(), "expected MODEL_INIT_MODE env var on the user container")
+	g.Expect(initModeEnv.Value).Should(gomega.Equal("async"))
+
+
+	var sharedMount *v1.VolumeMount
+	for i := range userContainer.VolumeMounts {
+		if userContainer.VolumeMounts[i].MountPath == "/mnt" {
+			sharedMount = &userContainer.VolumeMounts[i]
+		}
+	}
+	g.Expect(sharedMount).ShouldNot(gomega.BeNil(), "expected a volume mount at /mnt on the user container")
+	vol := findVolume(pod, sharedMount.Name)
+	g.Expect(vol).ShouldNot(gomega.BeNil())
+	g.Expect(vol.EmptyDir).ShouldNot(gomega.BeNil(), "the shared volume must be an emptyDir")
+
+
+	g.Expect(findInitContainer(pod, StorageInitializerContainerName)).Should(gomega.BeNil())
+}
+
+func TestModelcarRespectsConfiguredResources(t *testing.T) {
+	g := gomega.NewGomegaWithT(t)
+
+	cm := buildModelcarConfigMap(`{
+		"image" : "kserve/storage-initializer:latest",
+		"memoryRequest": "100Mi",
+		"memoryLimit": "1Gi",
+		"cpuRequest": "100m",
+		"cpuLimit": "1",
+		"enableModelcar": true,
+		"cpuModelcar": "20m",
+		"memoryModelcar": "30Mi"
+	}`)
+	pod := buildPodWithStorageUri("oci://myrepo/mymodel:1.0")
+
+	runMutate(t, pod, cm)
+
+	modelcar := findContainer(pod, "modelcar")
+	g.Expect(modelcar).ShouldNot(gomega.BeNil())
+	g.Expect(modelcar.Resources.Requests.Cpu().Cmp(resource.MustParse("20m"))).Should(gomega.Equal(0))
+	g.Expect(modelcar.Resources.Requests.Memory().Cmp(resource.MustParse("30Mi"))).Should(gomega.Equal(0))
+	g.Expect(modelcar.Resources.Limits.Cpu().Cmp(resource.MustParse("20m"))).Should(gomega.Equal(0))
+	g.Expect(modelcar.Resources.Limits.Memory().Cmp(resource.MustParse("30Mi"))).Should(gomega.Equal(0))
+}
+
+func TestModelcarUidOverride(t *testing.T) {
+	g := gomega.NewGomegaWithT(t)
+
+	cm := buildModelcarConfigMap(`{
+		"image" : "kserve/storage-initializer:latest",
+		"memoryRequest": "100Mi",
+		"memoryLimit": "1Gi",
+		"cpuRequest": "100m",
+		"cpuLimit": "1",
+		"enableModelcar": true,
+		"uidModelcar": 1010
+	}`)
+	pod := buildPodWithStorageUri("oci://myrepo/mymodel:1.0")
+
+	runMutate(t, pod, cm)
+
+	userContainer := findContainer(pod, constants.InferenceServiceContainerName)
+	g.Expect(userContainer).ShouldNot(gomega.BeNil())
+	g.Expect(userContainer.SecurityContext).ShouldNot(gomega.BeNil(), "expected a security context on the user container")
+	g.Expect(userContainer.SecurityContext.RunAsUser).ShouldNot(gomega.BeNil())
+	g.Expect(*userContainer.SecurityContext.RunAsUser).Should(gomega.Equal(int64(1010)))
+}
+
+func TestModelcarNoUidLeavesSecurityContextUnchanged(t *testing.T) {
+	g := gomega.NewGomegaWithT(t)
+
+	cm := buildModelcarConfigMap(`{
+		"image" : "kserve/storage-initializer:latest",
+		"memoryRequest": "100Mi",
+		"memoryLimit": "1Gi",
+		"cpuRequest": "100m",
+		"cpuLimit": "1",
+		"enableModelcar": true
+	}`)
+	pod := buildPodWithStorageUri("oci://myrepo/mymodel:1.0")
+
+	runMutate(t, pod, cm)
+
+	userContainer := findContainer(pod, constants.InferenceServiceContainerName)
+	g.Expect(userContainer).ShouldNot(gomega.BeNil())
+	if userContainer.SecurityContext != nil {
+		g.Expect(userContainer.SecurityContext.RunAsUser).Should(gomega.BeNil())
+	}
+}
+
+func TestModelcarNotInjectedForNonOciUri(t *testing.T) {
+	g := gomega.NewGomegaWithT(t)
+
+	cm := buildModelcarConfigMap(`{
+		"image" : "kserve/storage-initializer:latest",
+		"memoryRequest": "100Mi",
+		"memoryLimit": "1Gi",
+		"cpuRequest": "100m",
+		"cpuLimit": "1",
+		"enableModelcar": true
+	}`)
+	pod := buildPodWithStorageUri("pvc://mypvcname/some/path")
+
+	runMutate(t, pod, cm)
+
+	g.Expect(findContainer(pod, "modelcar")).Should(gomega.BeNil())
+	g.Expect(pod.Spec.ShareProcessNamespace).Should(gomega.BeNil())
+}
+
+func TestModelcarNotInjectedWhenFeatureDisabled(t *testing.T) {
+	g := gomega.NewGomegaWithT(t)
+
+	cm := buildModelcarConfigMap(`{
+		"image" : "kserve/storage-initializer:latest",
+		"memoryRequest": "100Mi",
+		"memoryLimit": "1Gi",
+		"cpuRequest": "100m",
+		"cpuLimit": "1",
+		"enableModelcar": false
+	}`)
+	pod := buildPodWithStorageUri("oci://myrepo/mymodel:1.0")
+
+	runMutate(t, pod, cm)
+
+	g.Expect(findContainer(pod, "modelcar")).Should(gomega.BeNil())
+	g.Expect(pod.Spec.ShareProcessNamespace).Should(gomega.BeNil())
+}
