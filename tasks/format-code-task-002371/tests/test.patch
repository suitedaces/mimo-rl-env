@@ -337,3 +337,158 @@ def test_recursive_parsing():
     # test recursive parsing with dict keys
     obj = dict(bb=dict(aa=1))
     assert ModelB.from_orm(obj) == ModelB(b=ModelA(a=1))
+
+
+def test_nested_orm_model_from_dict():
+    """Issue: nested ORM-mode models initialized from nested dictionaries."""
+
+    class User(BaseModel):
+        first_name: str
+        last_name: str
+
+        class Config:
+            orm_mode = True
+
+    class State(BaseModel):
+        user: User
+
+    state = State(**{'user': {'first_name': 'John', 'last_name': 'Appleseed'}})
+    assert state.user.first_name == 'John'
+    assert state.user.last_name == 'Appleseed'
+    assert state.dict() == {'user': {'first_name': 'John', 'last_name': 'Appleseed'}}
+
+
+def test_nested_orm_model_from_orm_preserved():
+    """Preservation: ORM-mode model + from_orm with SimpleNamespace still works."""
+    from types import SimpleNamespace
+
+    class User(BaseModel):
+        first_name: str
+        last_name: str
+
+        class Config:
+            orm_mode = True
+
+    class State(BaseModel):
+        user: User
+
+        class Config:
+            orm_mode = True
+
+    state = State.from_orm(
+        SimpleNamespace(user=SimpleNamespace(first_name='John', last_name='Appleseed'))
+    )
+    assert state.user.first_name == 'John'
+    assert state.user.last_name == 'Appleseed'
+    assert state.dict() == {'user': {'first_name': 'John', 'last_name': 'Appleseed'}}
+
+
+def test_nested_orm_model_from_dict_via_parse_obj():
+    """parse_obj path: nested ORM-mode dict initialization works through parse_obj."""
+
+    class User(BaseModel):
+        first_name: str
+        last_name: str
+
+        class Config:
+            orm_mode = True
+
+    class State(BaseModel):
+        user: User
+
+    state = State.parse_obj({'user': {'first_name': 'John', 'last_name': 'Appleseed'}})
+    assert state.dict() == {'user': {'first_name': 'John', 'last_name': 'Appleseed'}}
+
+
+def test_nested_orm_model_list_from_list_of_dicts():
+    """List[OrmModel] field initialized from list of dicts works."""
+
+    class User(BaseModel):
+        first_name: str
+        last_name: str
+
+        class Config:
+            orm_mode = True
+
+    class State(BaseModel):
+        users: List[User]
+
+    state = State(**{
+        'users': [
+            {'first_name': 'John', 'last_name': 'Appleseed'},
+            {'first_name': 'Jane', 'last_name': 'Doe'},
+        ]
+    })
+    assert state.users[0].first_name == 'John'
+    assert state.users[0].last_name == 'Appleseed'
+    assert state.users[1].first_name == 'Jane'
+    assert state.users[1].last_name == 'Doe'
+
+
+def test_nested_orm_dict_init_with_extra_forbid():
+    """Extra key in nested ORM-mode dict triggers ValidationError when extra=forbid.
+
+    With the fix, dicts go through cls(**value) which uses the standard validation
+    path with extra-key detection. A buggy fix that still routes through
+    from_orm(dict) would lose extra-key detection because GetterDict.extra_keys()
+    returns an empty set.
+    """
+
+    class User(BaseModel):
+        first_name: str
+        last_name: str
+
+        class Config:
+            orm_mode = True
+            extra = 'forbid'
+
+    class State(BaseModel):
+        user: User
+
+    with pytest.raises(ValidationError) as exc_info:
+        State(**{'user': {'first_name': 'John', 'last_name': 'Appleseed', 'extra_key': 'X'}})
+    errors = exc_info.value.errors()
+    assert any(err['loc'] == ('user', 'extra_key') for err in errors)
+
+
+def test_nested_orm_dict_init_with_extra_allow():
+    """Extra key in nested ORM-mode dict is preserved when extra=allow.
+
+    With the fix, dicts go through cls(**value), so extras are retained as
+    attributes. A buggy fix routing through from_orm(dict) loses the extras.
+    """
+
+    class User(BaseModel):
+        first_name: str
+        last_name: str
+
+        class Config:
+            orm_mode = True
+            extra = 'allow'
+
+    class State(BaseModel):
+        user: User
+
+    state = State(**{
+        'user': {'first_name': 'John', 'last_name': 'Appleseed', 'extra_key': 'X'}
+    })
+    assert state.user.dict() == {
+        'first_name': 'John',
+        'last_name': 'Appleseed',
+        'extra_key': 'X',
+    }
+
+
+def test_top_level_orm_model_from_dict_init():
+    """Preservation: top-level ORM-mode model initialized from a dict still works."""
+
+    class User(BaseModel):
+        first_name: str
+        last_name: str
+
+        class Config:
+            orm_mode = True
+
+    user = User(**{'first_name': 'John', 'last_name': 'Appleseed'})
+    assert user.first_name == 'John'
+    assert user.last_name == 'Appleseed'
