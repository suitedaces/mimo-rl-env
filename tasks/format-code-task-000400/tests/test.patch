+import { Group } from '@antv/g-canvas';
+import {
+  getResizeAreaAttrs,
+  getResizeAreaGroupById,
+} from '@/utils/interaction/resize';
+
+const resizeAreaTheme = {
+  background: '#000',
+  backgroundOpacity: 1,
+  size: 3,
+};
+
+const commonConfig = {
+  offsetX: 0,
+  offsetY: 0,
+  width: 20,
+  height: 20,
+  effect: 'cell',
+  theme: resizeAreaTheme,
+};
+
+describe('Resize Utils Tests', () => {
+  describe('#getResizeAreaAttrs()', () => {
+    test('should build fill / opacity / cursor from theme and type', () => {
+      const attrs = getResizeAreaAttrs({
+        ...commonConfig,
+        type: 'col',
+      });
+
+      expect(attrs.fill).toEqual(resizeAreaTheme.background);
+      expect(attrs.fillOpacity).toEqual(resizeAreaTheme.backgroundOpacity);
+      expect(attrs.cursor).toEqual('col-resize');
+    });
+
+    test('should use a row cursor for row hotspots', () => {
+      const attrs = getResizeAreaAttrs({
+        ...commonConfig,
+        type: 'row',
+      });
+
+      expect(attrs.cursor).toEqual('row-resize');
+    });
+
+    test('should size a col hotspot as a vertical bar', () => {
+      const attrs = getResizeAreaAttrs({
+        ...commonConfig,
+        type: 'col',
+      });
+
+      expect(attrs.width).toEqual(resizeAreaTheme.size);
+      expect(attrs.height).toBeNull();
+    });
+
+    test('should size a row hotspot as a horizontal bar', () => {
+      const attrs = getResizeAreaAttrs({
+        ...commonConfig,
+        type: 'row',
+      });
+
+      expect(attrs.height).toEqual(resizeAreaTheme.size);
+      expect(attrs.width).toBeNull();
+    });
+
+    test('should flag the shape as a resize hotspot in appendInfo', () => {
+      const attrs = getResizeAreaAttrs({
+        ...commonConfig,
+        type: 'col',
+      });
+
+      expect(attrs.appendInfo).toBeDefined();
+      expect(attrs.appendInfo.isResizeArea).toEqual(true);
+    });
+
+    test('should carry type / effect / geometry into appendInfo', () => {
+      const attrs = getResizeAreaAttrs({
+        ...commonConfig,
+        type: 'col',
+        effect: 'field',
+        offsetX: 5,
+        offsetY: 7,
+        width: 20,
+        height: 30,
+      });
+
+      expect(attrs.appendInfo).toMatchObject({
+        type: 'col',
+        effect: 'field',
+        offsetX: 5,
+        offsetY: 7,
+        width: 20,
+        height: 30,
+      });
+    });
+
+    test('should carry id and caption into appendInfo when provided', () => {
+      const attrs = getResizeAreaAttrs({
+        ...commonConfig,
+        type: 'row',
+        id: 'price',
+        caption: 'Total',
+      });
+
+      expect(attrs.appendInfo.id).toEqual('price');
+      expect(attrs.appendInfo.caption).toEqual('Total');
+    });
+
+    test('should default id to undefined when not provided', () => {
+      const attrs = getResizeAreaAttrs({
+        ...commonConfig,
+        type: 'row',
+      });
+
+      expect(attrs.appendInfo.id).toBeUndefined();
+    });
+
+    test('should not leak the theme into appendInfo', () => {
+      const attrs = getResizeAreaAttrs({
+        ...commonConfig,
+        type: 'col',
+      });
+
+      expect(attrs.appendInfo.theme).toBeUndefined();
+    });
+
+    test('appendInfo width/height are the cell dimensions, not the bar thickness', () => {
+      const attrs = getResizeAreaAttrs({
+        ...commonConfig,
+        type: 'col',
+        width: 100,
+        height: 200,
+      });
+
+
+      expect(attrs.width).toEqual(resizeAreaTheme.size);
+
+      expect(attrs.appendInfo.width).toEqual(100);
+      expect(attrs.appendInfo.height).toEqual(200);
+    });
+
+    test('appendInfo keeps cell width for a row hotspot while bar height is the theme size', () => {
+      const attrs = getResizeAreaAttrs({
+        ...commonConfig,
+        type: 'row',
+        width: 100,
+        height: 200,
+      });
+
+      expect(attrs.height).toEqual(resizeAreaTheme.size);
+      expect(attrs.appendInfo.width).toEqual(100);
+      expect(attrs.appendInfo.height).toEqual(200);
+    });
+  });
+
+  describe('#getResizeAreaGroupById()', () => {
+    test('should create a new group registered under the id when none exists', () => {
+      const s2 = { foregroundGroup: new Group({}) } as any;
+
+      const group = getResizeAreaGroupById(s2, 'resize-area-id');
+
+      expect(group).toBeDefined();
+      expect(s2.foregroundGroup.findById('resize-area-id')).toBe(group);
+      expect(s2.foregroundGroup.getChildren()).toHaveLength(1);
+    });
+
+    test('should reuse the existing group instead of creating duplicates', () => {
+      const s2 = { foregroundGroup: new Group({}) } as any;
+      const id = 'resize-area-id';
+
+      const first = getResizeAreaGroupById(s2, id);
+      const second = getResizeAreaGroupById(s2, id);
+      const third = getResizeAreaGroupById(s2, id);
+
+      expect(second).toBe(first);
+      expect(third).toBe(first);
+      expect(s2.foregroundGroup.getChildren()).toHaveLength(1);
+    });
+
+    test('should keep distinct ids in separate groups', () => {
+      const s2 = { foregroundGroup: new Group({}) } as any;
+
+      getResizeAreaGroupById(s2, 'a');
+      getResizeAreaGroupById(s2, 'b');
+
+      expect(s2.foregroundGroup.getChildren()).toHaveLength(2);
+    });
+
+    test('should return nothing when there is no foreground group', () => {
+      const s2 = { foregroundGroup: undefined } as any;
+
+      expect(getResizeAreaGroupById(s2, 'resize-area-id')).toBeFalsy();
+    });
+  });
+});
