@@ -0,0 +1,43 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+dev-switch python3 3.11
+
+
+set +u
+source /testbed/.build_env/venv/bin/activate
+set -u
+
+
+if [ ! -f /testbed/github.txt ]; then
+    echo "1.0.0|dev" > /testbed/github.txt
+fi
+
+
+pip install --no-input -e /testbed 2>/dev/null || true
+
+
+
+export BILI_SESSDATA="dummy_sessdata"
+export BILI_CSRF="dummy_csrf"
+export BILI_BUVID3="dummy_buvid3"
+export BILI_DEDEUSERID="dummy_dedeuserid"
+
+
+export PYTHONPATH="/testbed/.build_env:/testbed:${PYTHONPATH:-}"
+
+case "${1:-}" in
+  base)
+    python -m pytest -q tests/test_comment.py --collect-only
+    ;;
+  new)
+    python -m pytest -q tests/test_comment_report.py
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
