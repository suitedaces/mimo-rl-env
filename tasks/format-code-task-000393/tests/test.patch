diff --git a/src/molecule/test/unit/provisioner/test_ansible.py b/src/molecule/test/unit/provisioner/test_ansible.py
index 11b7e981..748c1f32 100644
--- a/src/molecule/test/unit/provisioner/test_ansible.py
+++ b/src/molecule/test/unit/provisioner/test_ansible.py
@@ -715,3 +715,80 @@ def test_absolute_path_for_raises_with_missing_key(_instance):
 
     with pytest.raises(KeyError):
         _instance._absolute_path_for(env, "invalid")
+
+
+
+
+
+
+
+def _collections_paths(_instance):
+    """Return the list of collection paths from default_env split by ':'."""
+    env = _instance.default_env
+    return env[_instance._config.ansible_collections_path].split(":")
+
+
+def test_default_env_no_collection_indicator_does_not_inject_path(_instance):
+    """When project_directory has no 'ansible_collections', no project-derived
+    collection path is injected (only ephemeral, ~/.ansible, /usr/share, /etc).
+    """
+    _instance._config.project_directory = "/tmp/no_collection_here/proj"
+    paths = _collections_paths(_instance)
+
+
+    assert "/tmp/no_collection_here/proj" not in paths
+    assert "/tmp/no_collection_here" not in paths
+    assert "/tmp" not in paths
+
+
+def test_default_env_single_collection_indicator(_instance):
+    """A single 'ansible_collections' segment: collection_path is the parent
+    directory before the indicator.
+    """
+    _instance._config.project_directory = (
+        "/srv/work/ansible_collections/ns/coll/roles/r"
+    )
+    paths = _collections_paths(_instance)
+
+    assert "/srv/work" in paths
+
+
+def test_default_env_double_nested_does_not_raise(_instance):
+    """Double-nested 'ansible_collections' must NOT raise ValueError."""
+    _instance._config.project_directory = (
+        "/srv/meta/ansible_collections/outer/inner/"
+        "ansible_collections/ns/coll/roles/r"
+    )
+
+    env = _instance.default_env
+    assert _instance._config.ansible_collections_path in env
+
+
+def test_default_env_double_nested_uses_rightmost_split(_instance):
+    """For double-nested paths, the injected collection_path must correspond
+    to the LAST occurrence of 'ansible_collections' (rsplit semantics), not
+    the first (split semantics).
+    """
+    _instance._config.project_directory = (
+        "/A/ansible_collections/B/ansible_collections/C/coll"
+    )
+    paths = _collections_paths(_instance)
+
+
+    assert "/A/ansible_collections/B" in paths
+
+    assert "/A" not in paths
+
+
+def test_default_env_triple_nested_uses_rightmost_split(_instance):
+    """Triple-nested 'ansible_collections' should also use rightmost split."""
+    _instance._config.project_directory = (
+        "/x/ansible_collections/a/ansible_collections/b/"
+        "ansible_collections/c/coll"
+    )
+    paths = _collections_paths(_instance)
+
+    expected = "/x/ansible_collections/a/ansible_collections/b"
+    assert expected in paths
+
+    assert "/x" not in paths
