+#!/bin/bash
+set -euo pipefail
+
+
+py.test -q \
+  f5/bigip/test/test_collection_pagination_contract.py \
+  f5/bigip/test/test_REST_interface_collections.py::test_delete_all \
+  f5/bigip/test/test_REST_interface_collections.py::test_delete_all_startswith \
+  f5/bigip/test/test_REST_interface_collections.py::test_delete_all_fail \
+  f5/bigip/test/test_REST_interface_collections.py::test_delete_all_http_error
