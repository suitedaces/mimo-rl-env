+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+export GOFLAGS=-mod=mod
+export GOPROXY=off
+
+
+go test ./pkg/ingress/...
+
+
+go test ./pkg/ingress/ -run 'Test_referenceIndexer'
