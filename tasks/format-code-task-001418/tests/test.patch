--- /dev/null
+++ b/usercase-test-coderl/test_parse_mm_uuids.py
@@ -0,0 +1,308 @@
+
+
+
+
+
+
+
+
+
+from __future__ import annotations
+
+import builtins
+import copy
+import importlib
+import json
+import os
+import socket
+import subprocess
+import sys
+import textwrap
+import types
+import typing
+
+import pytest
+
+
+REPO = "/workspace/repo"
+
+
+STUB_IMPORTS = r"""
+import sys
+import types
+import typing
+
+REPO = "/workspace/repo"
+if REPO not in sys.path:
+    sys.path.insert(0, REPO)
+
+
+class Tensor:
+    pass
+
+
+class Module:
+    pass
+
+
+torch = types.ModuleType("torch")
+torch.Tensor = Tensor
+torch.nn = types.SimpleNamespace(Module=Module)
+sys.modules["torch"] = torch
+
+numpy = types.ModuleType("numpy")
+
+
+class ndarray:
+    pass
+
+
+numpy.ndarray = ndarray
+numpy.array = lambda value, *args, **kwargs: value
+sys.modules["numpy"] = numpy
+
+sys.modules["vllm.env_override"] = types.ModuleType("vllm.env_override")
+
+vllm_inputs = types.ModuleType("vllm.inputs")
+
+
+class ModalityData:
+    def __class_getitem__(cls, item):
+        return typing.Any
+
+
+vllm_inputs.ModalityData = ModalityData
+vllm_inputs.MultiModalDataDict = dict
+vllm_inputs.MultiModalUUIDDict = dict
+sys.modules["vllm.inputs"] = vllm_inputs
+
+utils_pkg = types.ModuleType("vllm.utils")
+utils_pkg.__path__ = []
+sys.modules["vllm.utils"] = utils_pkg
+
+collection_utils = types.ModuleType("vllm.utils.collection_utils")
+
+
+def is_list_of(value, typ, *, check="first"):
+    if not isinstance(value, list):
+        return False
+    if check == "all":
+        return all(isinstance(item, typ) for item in value)
+    return len(value) == 0 or isinstance(value[0], typ)
+
+
+collection_utils.is_list_of = is_list_of
+sys.modules["vllm.utils.collection_utils"] = collection_utils
+
+import_utils = types.ModuleType("vllm.utils.import_utils")
+
+
+class LazyLoader:
+    def __init__(self, *args, **kwargs):
+        class Image:
+            pass
+
+        self.Image = Image
+
+
+import_utils.LazyLoader = LazyLoader
+sys.modules["vllm.utils.import_utils"] = import_utils
+
+multimodal_pkg = types.ModuleType("vllm.multimodal")
+multimodal_pkg.__path__ = [REPO + "/vllm/multimodal"]
+sys.modules["vllm.multimodal"] = multimodal_pkg
+
+audio = types.ModuleType("vllm.multimodal.audio")
+
+
+class AudioResampler:
+    def __init__(self, *args, **kwargs):
+        pass
+
+
+class AudioSpec:
+    def __init__(self, *args, **kwargs):
+        pass
+
+
+audio.AudioResampler = AudioResampler
+audio.AudioSpec = AudioSpec
+audio.normalize_audio = lambda value, spec: value
+sys.modules["vllm.multimodal.audio"] = audio
+
+image = types.ModuleType("vllm.multimodal.image")
+image.convert_image_mode = lambda value, to_mode, *args, **kwargs: value
+image.normalize_image = lambda value: value
+sys.modules["vllm.multimodal.image"] = image
+
+multimodal_inputs = types.ModuleType("vllm.multimodal.inputs")
+for name in (
+    "AudioItem",
+    "HfAudioItem",
+    "HfImageItem",
+    "HfVideoItem",
+    "ImageItem",
+    "MultiModalFieldConfig",
+    "MultiModalKwargsItems",
+    "VideoItem",
+):
+    setattr(multimodal_inputs, name, typing.Any)
+sys.modules["vllm.multimodal.inputs"] = multimodal_inputs
+
+media = types.ModuleType("vllm.multimodal.media")
+_T = typing.TypeVar("_T")
+
+
+class MediaWithBytes(typing.Generic[_T]):
+    def __init__(self, media, original_bytes=b""):
+        self.media = media
+        self.original_bytes = original_bytes
+
+
+media.MediaWithBytes = MediaWithBytes
+sys.modules["vllm.multimodal.media"] = media
+"""
+
+
+def _install_import_stubs() -> None:
+    exec(STUB_IMPORTS, {})
+    importlib.invalidate_caches()
+
+
+def _parse_mm_uuids():
+    _install_import_stubs()
+    from vllm.multimodal.parse import parse_mm_uuids
+
+    return parse_mm_uuids
+
+
+def test_none_returns_empty_mapping():
+
+
+
+
+    parse_mm_uuids = _parse_mm_uuids()
+
+    actual = parse_mm_uuids(None)
+
+    assert actual == {}
+
+
+def test_single_uuid_string_becomes_one_item_for_modality():
+
+
+
+
+    parse_mm_uuids = _parse_mm_uuids()
+
+    actual = parse_mm_uuids({"image": "hash_cherry"})
+
+    assert actual == {"image": ["hash_cherry"]}
+
+
+def test_list_and_modality_none_values_pass_through_unchanged():
+
+
+
+
+    parse_mm_uuids = _parse_mm_uuids()
+
+    actual = parse_mm_uuids({"image": [None, "hash_stop"], "video": None})
+
+    assert actual == {"image": [None, "hash_stop"], "video": None}
+
+
+def test_length_and_modality_validation_are_not_performed_by_helper():
+
+
+
+
+    parse_mm_uuids = _parse_mm_uuids()
+
+    actual = parse_mm_uuids({"depth": "cache_depth", "image": []})
+
+    assert actual == {"depth": ["cache_depth"], "image": []}
+
+
+def test_empty_mapping_returns_empty_mapping():
+    parse_mm_uuids = _parse_mm_uuids()
+
+    actual = parse_mm_uuids({})
+
+
+
+    assert actual == {}
+
+
+def test_referential_transparency_for_same_input():
+    parse_mm_uuids = _parse_mm_uuids()
+    mm_uuids = {"audio": "clip_alpha", "video": ["scene_01", None], "image": []}
+
+    assert parse_mm_uuids(mm_uuids) == parse_mm_uuids(mm_uuids)
+    assert parse_mm_uuids(mm_uuids) == {
+        "audio": ["clip_alpha"],
+        "video": ["scene_01", None],
+        "image": [],
+    }
+
+
+def test_does_not_mutate_caller_mapping_or_lists():
+    parse_mm_uuids = _parse_mm_uuids()
+    mm_uuids = {"image": [None, "hash_stop"], "video": None}
+    original = copy.deepcopy(mm_uuids)
+
+    actual = parse_mm_uuids(mm_uuids)
+
+    assert actual == {"image": [None, "hash_stop"], "video": None}
+    assert mm_uuids == original
+
+
+def test_same_input_matches_in_fresh_interpreter_without_global_state():
+    parse_mm_uuids = _parse_mm_uuids()
+    mm_uuids = {"image": "hash_cherry"}
+    in_process = parse_mm_uuids(mm_uuids)
+
+    script = (
+        STUB_IMPORTS
+        + textwrap.dedent(
+            """
+            import json
+            from vllm.multimodal.parse import parse_mm_uuids
+
+            result = parse_mm_uuids({"image": "hash_cherry"})
+            sys.stdout.write(json.dumps(result, sort_keys=True))
+            """
+        )
+    )
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        capture_output=True,
+    )
+    fresh_process = json.loads(completed.stdout)
+
+    assert in_process == {"image": ["hash_cherry"]}
+    assert fresh_process == {"image": ["hash_cherry"]}
+    assert fresh_process == in_process
+
+
+def test_no_filesystem_or_network_side_effects(tmp_path, monkeypatch):
+    parse_mm_uuids = _parse_mm_uuids()
+
+    def blocked_socket(*args, **kwargs):
+        raise AssertionError("parse_mm_uuids must not open network sockets")
+
+    def blocked_open(*args, **kwargs):
+        raise AssertionError("parse_mm_uuids must not open files")
+
+    monkeypatch.setattr(socket, "socket", blocked_socket)
+    monkeypatch.setattr(builtins, "open", blocked_open)
+    monkeypatch.chdir(tmp_path)
+
+    before = set(os.listdir(tmp_path))
+    actual = parse_mm_uuids({"image": "hash_cherry"})
+    after = set(os.listdir(tmp_path))
+
+    assert actual == {"image": ["hash_cherry"]}
+    assert after == before
