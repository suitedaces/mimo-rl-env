--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,31 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+set +u
+dev-switch go 1.23
+
+mkdir -p /root/go/src/github.com/ligato
+ln -sfn /testbed /root/go/src/github.com/ligato/vpp-agent
+
+export GOPATH=/root/go
+export GO111MODULE=off
+
+cd /root/go/src/github.com/ligato/vpp-agent
+set -u
+
+
+case "${1:-}" in
+	base)
+		go test -tags=mockvpp -count=1 ./plugins/defaultplugins/aclplugin/ -run '^$'
+		;;
+	new)
+		go test -tags=mockvpp -count=1 ./plugins/defaultplugins/aclplugin/ -run 'TestModifyACL(UpdatesOnlyChangedIngressBindings|UpdatesOnlyChangedEgressBindings|MixedIngressEgressDiff|SameBindingsSkipsInterfaceVPPCalls|SameBindingSetDifferentOrderSkipsInterfaceVPPCalls|NoEmptyBindingOperationsForOneSidedDiff)$'
+		;;
+	*)
+		echo "usage: $0 base|new"
+		exit 2
+		;;
+esac
