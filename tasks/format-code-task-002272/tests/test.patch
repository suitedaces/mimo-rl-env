+package router_test
+
+import (
+	"testing"
+
+	router "github.com/pingcap/tidb/util/table-router"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCaseInsensitiveFetchExtendColumnNormalizesOnlyMatching(t *testing.T) {
+	schemaRule := &router.TableRule{
+		SchemaPattern: "Sales_*",
+		TargetSchema:  "archive",
+		SchemaExtractor: &router.SchemaExtractor{
+			TargetColumn: "schema_fallback",
+			SchemaRegexp:  `Sales_(.*)`,
+		},
+	}
+	rule := &router.TableRule{
+		SchemaPattern: "Sales_*",
+		TablePattern:  "Orders_*",
+		TargetSchema:  "archive",
+		TargetTable:   "orders",
+		TableExtractor: &router.TableExtractor{
+			TargetColumn: "table_suffix",
+			TableRegexp:  `Orders_(.*)`,
+		},
+		SchemaExtractor: &router.SchemaExtractor{
+			TargetColumn: "schema_suffix",
+			SchemaRegexp:  `Sales_(.*)`,
+		},
+		SourceExtractor: &router.SourceExtractor{
+			TargetColumn: "source_suffix",
+			SourceRegexp:  `source_(.*)`,
+		},
+	}
+	r, err := router.NewTableRouter(false, []*router.TableRule{schemaRule, rule})
+	require.NoError(t, err)
+	require.Equal(t, "Sales_*", schemaRule.SchemaPattern)
+	require.Equal(t, "Sales_*", rule.SchemaPattern)
+	require.Equal(t, "Orders_*", rule.TablePattern)
+
+	gotSchema, gotTable, err := r.Route("SALES_EU", "ORDERS_2024")
+	require.NoError(t, err)
+	require.Equal(t, "archive", gotSchema)
+	require.Equal(t, "orders", gotTable)
+
+	cols, vals := r.FetchExtendColumn("SALES_EU", "ORDERS_2024", "source_BATCH")
+	require.Equal(t, []string{"table_suffix", "schema_suffix", "source_suffix"}, cols)
+
+
+	require.Equal(t, []string{"2024", "EU", "BATCH"}, vals)
+}
+
+func TestCaseSensitiveFetchExtendColumnRemainsCaseSensitive(t *testing.T) {
+	rule := &router.TableRule{
+		SchemaPattern: "sales_*",
+		TablePattern:  "orders_*",
+		TargetSchema:  "archive",
+		TargetTable:   "orders",
+		TableExtractor: &router.TableExtractor{
+			TargetColumn: "table_suffix",
+			TableRegexp:  `orders_(.*)`,
+		},
+	}
+	r, err := router.NewTableRouter(true, []*router.TableRule{rule})
+	require.NoError(t, err)
+
+	gotSchema, gotTable, err := r.Route("SALES_EU", "ORDERS_2024")
+	require.NoError(t, err)
+	require.Equal(t, "SALES_EU", gotSchema)
+	require.Equal(t, "ORDERS_2024", gotTable)
+	cols, vals := r.FetchExtendColumn("SALES_EU", "ORDERS_2024", "source_BATCH")
+	require.Empty(t, cols)
+	require.Empty(t, vals)
+}
