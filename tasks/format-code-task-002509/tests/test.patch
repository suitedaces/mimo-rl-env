+++ b/x/ecocredit/params_validate_hidden_test.go
@@ -0,0 +1,75 @@
+package ecocredit_test
+
+import (
+	"testing"
+
+	sdk "github.com/cosmos/cosmos-sdk/types"
+	sdkerrors "github.com/cosmos/cosmos-sdk/types/errors"
+	"github.com/stretchr/testify/require"
+
+	"github.com/regen-network/regen-ledger/x/ecocredit"
+)
+
+func TestParamsValidateAcceptsDefaultParams(t *testing.T) {
+	params := ecocredit.DefaultGenesisState().Params
+	require.NoError(t, params.Validate())
+}
+
+func TestParamsValidateRejectsInvalidFields(t *testing.T) {
+	tests := []struct {
+		name   string
+		mutate func(*ecocredit.Params)
+	}{
+		{
+			name: "invalid credit type definition",
+			mutate: func(params *ecocredit.Params) {
+				params.CreditTypes = []*ecocredit.CreditType{{
+					Name:         "carbon",
+					Abbreviation: "C",
+					Unit:         "metric ton CO2 equivalent",
+					Precision:    7,
+				}}
+			},
+		},
+		{
+			name: "invalid allowed creator address",
+			mutate: func(params *ecocredit.Params) {
+				params.AllowedClassCreators = []string{"not-a-valid-regen-address"}
+			},
+		},
+		{
+			name: "invalid credit class fee",
+			mutate: func(params *ecocredit.Params) {
+				params.CreditClassFee = sdk.Coins{{Denom: "bad denom", Amount: sdk.NewInt(1)}}
+			},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			params := ecocredit.DefaultGenesisState().Params
+			tc.mutate(&params)
+
+			require.Error(t, params.Validate())
+		})
+	}
+}
+
+func TestParamsValidateInvalidAllowedClassCreatorError(t *testing.T) {
+	for _, invalidAddress := range []string{
+		"not-a-valid-regen-address",
+		"regen1thisisnotavalidbech32address",
+	} {
+		t.Run(invalidAddress, func(t *testing.T) {
+			params := ecocredit.DefaultGenesisState().Params
+			params.AllowedClassCreators = []string{invalidAddress}
+
+			err := params.Validate()
+
+			require.Error(t, err)
+			codespace, code, _ := sdkerrors.ABCIInfo(err, false)
+			require.Equal(t, sdkerrors.ErrInvalidAddress.Codespace(), codespace)
+			require.Equal(t, sdkerrors.ErrInvalidAddress.ABCICode(), code)
+		})
+	}
+}
diff --git a/x/ecocredit/genesis_validate_hidden_test.go b/x/ecocredit/genesis_validate_hidden_test.go
new file mode 100644
index 0000000..2c5618a
--- /dev/null
+++ b/x/ecocredit/genesis_validate_hidden_test.go
@@ -0,0 +1,124 @@
+package ecocredit_test
+
+import (
+	"bytes"
+	"testing"
+
+	sdk "github.com/cosmos/cosmos-sdk/types"
+	sdkerrors "github.com/cosmos/cosmos-sdk/types/errors"
+	"github.com/stretchr/testify/require"
+
+	"github.com/regen-network/regen-ledger/x/ecocredit"
+)
+
+func TestGenesisValidateRejectsInvalidParams(t *testing.T) {
+	for _, invalidAddress := range []string{
+		"definitely-not-a-bech32-address",
+		"regen1alternateinvalidcreator",
+	} {
+		t.Run("invalid allowed class creator address "+invalidAddress, func(t *testing.T) {
+			genesisState := ecocredit.DefaultGenesisState()
+			genesisState.Params.AllowedClassCreators = []string{invalidAddress}
+
+			err := genesisState.Validate()
+
+			require.Error(t, err)
+			codespace, code, _ := sdkerrors.ABCIInfo(err, false)
+			require.Equal(t, sdkerrors.ErrInvalidAddress.Codespace(), codespace)
+			require.Equal(t, sdkerrors.ErrInvalidAddress.ABCICode(), code)
+		})
+	}
+
+	for _, precision := range []uint32{7, 5} {
+		t.Run("invalid credit type precision", func(t *testing.T) {
+			genesisState := ecocredit.DefaultGenesisState()
+			genesisState.Params.CreditTypes = []*ecocredit.CreditType{{
+				Name:         "carbon",
+				Abbreviation: "C",
+				Unit:         "metric ton CO2 equivalent",
+				Precision:    precision,
+			}}
+
+			err := genesisState.Validate()
+
+			require.Error(t, err)
+		})
+	}
+}
+
+func TestGenesisValidateRejectsUnknownClassInfoCreditType(t *testing.T) {
+	for _, abbreviation := range []string{"F", "XYZ", "NO"} {
+		t.Run(abbreviation, func(t *testing.T) {
+			genesisState := ecocredit.DefaultGenesisState()
+			creditType := *genesisState.Params.CreditTypes[0]
+			creditType.Abbreviation = abbreviation
+			genesisState.ClassInfo = []*ecocredit.ClassInfo{
+				validClassInfoWithCreditType(&creditType),
+			}
+
+			err := genesisState.Validate()
+
+			require.Error(t, err)
+		})
+	}
+}
+
+func TestGenesisValidateRejectsMismatchedClassInfoCreditType(t *testing.T) {
+	tests := []struct {
+		name   string
+		mutate func(*ecocredit.CreditType)
+	}{
+		{
+			name: "name mismatch",
+			mutate: func(creditType *ecocredit.CreditType) {
+				creditType.Name = "forest carbon"
+			},
+		},
+		{
+			name: "alternate name mismatch",
+			mutate: func(creditType *ecocredit.CreditType) {
+				creditType.Name = "soil carbon"
+			},
+		},
+		{
+			name: "unit mismatch",
+			mutate: func(creditType *ecocredit.CreditType) {
+				creditType.Unit = "kilogram CO2 equivalent"
+			},
+		},
+		{
+			name: "alternate unit mismatch",
+			mutate: func(creditType *ecocredit.CreditType) {
+				creditType.Unit = "pound CO2 equivalent"
+			},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			genesisState := ecocredit.DefaultGenesisState()
+			creditType := *genesisState.Params.CreditTypes[0]
+			tc.mutate(&creditType)
+			genesisState.ClassInfo = []*ecocredit.ClassInfo{
+				validClassInfoWithCreditType(&creditType),
+			}
+
+			err := genesisState.Validate()
+
+			require.Error(t, err)
+		})
+	}
+}
+
+func validClassInfoWithCreditType(creditType *ecocredit.CreditType) *ecocredit.ClassInfo {
+	addr1 := sdk.AccAddress(bytes.Repeat([]byte{1}, 20)).String()
+	addr2 := sdk.AccAddress(bytes.Repeat([]byte{2}, 20)).String()
+
+	return &ecocredit.ClassInfo{
+		ClassId:    "1",
+		Admin:      addr1,
+		Issuers:    []string{addr1, addr2},
+		Metadata:   []byte("meta-data"),
+		CreditType: creditType,
+	}
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,42 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+run_base() {
+  cd /testbed/x/ecocredit || exit 1
+  local hidden_files=(genesis_validate_hidden_test.go params_validate_hidden_test.go)
+  local moved=()
+  restore_hidden_files() {
+    local f
+    for f in "${moved[@]}"; do
+      if [ -f "$f.fixturea-hidden" ]; then
+        mv "$f.fixturea-hidden" "$f"
+      fi
+    done
+  }
+  trap restore_hidden_files RETURN
+  for f in "${hidden_files[@]}"; do
+    if [ -f "$f" ]; then
+      mv "$f" "$f.fixturea-hidden"
+      moved+=("$f")
+    fi
+  done
+  go test -v -count=1 -run "TestGenesisValidate|TestGenesisDefaultParams" ./...
+  local rc=$?
+  restore_hidden_files
+  trap - RETURN
+  return "$rc"
+}
+
+case "${1:-}" in
+  base)
+    run_base
+    ;;
+  new)
+    cd /testbed/x/ecocredit && go test -v -count=1 -run "TestParamsValidateAcceptsDefaultParams|TestParamsValidateRejectsInvalidFields|TestParamsValidateInvalidAllowedClassCreatorError|TestGenesisValidateRejectsInvalidParams|TestGenesisValidateRejectsUnknownClassInfoCreditType|TestGenesisValidateRejectsMismatchedClassInfoCreditType" ./...
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
