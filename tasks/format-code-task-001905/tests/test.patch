+test.serial('hooks and retry options are passed through', async t => {
+
+
+
+
+  let attempts = 0
+
+  await withServer((req, res) => {
+    attempts += 1
+    if (attempts === 1) {
+      jsonResponse(
+        res,
+        500,
+        {
+          status: 'error',
+          data: { url: 'try again' },
+          code: 'ERETRYME',
+          message: 'retry me'
+        },
+        { 'x-case': 'retry-first' }
+      )
+      return
+    }
+
+    jsonResponse(
+      res,
+      200,
+      {
+        status: 'success',
+        data: { attempt: attempts, hookHeader: req.headers['x-hooked'] }
+      },
+      { 'x-case': 'retry-success' }
+    )
+  }, async endpoint => {
+    const apiUrl = `${endpoint}retry?url=https%3A%2F%2Fexample.com`
+    let beforeRetryCount = 0
+    const afterResponseStatuses = []
+
+    const actual = normalizeSuccess(
+      await fetchFromApi(apiUrl, {
+        responseType: 'json',
+        hooks: {
+          beforeRequest: [
+            ({ request }) => {
+              request.headers.set('x-hooked', 'from-before-request')
+            }
+          ],
+          afterResponse: [
+            ({ response }) => {
+              afterResponseStatuses.push(response.status)
+              return response
+            }
+          ],
+          beforeRetry: [
+            () => {
+              beforeRetryCount += 1
+            }
+          ]
+        },
+        retry: { limit: 1, statusCodes: [500], methods: ['get'] }
+      })
+    )
+
+    t.is(beforeRetryCount, 1)
+
+    t.deepEqual([...afterResponseStatuses].sort((a, b) => a - b), [200, 500])
+    t.is(attempts, 2)
+
+    t.deepEqual({
+      status: actual.status,
+      data: actual.data,
+      response: {
+        url: actual.response.url,
+        body: actual.response.body,
+        statusCode: actual.response.statusCode
+      }
+    }, {
+      status: 'success',
+      data: { attempt: 2, hookHeader: 'from-before-request' },
+      response: {
+        url: apiUrl,
+        body: {
+          status: 'success',
+          data: { attempt: 2, hookHeader: 'from-before-request' }
+        },
+        statusCode: 200
+      }
+    })
+    assertHeadersInclude(t, actual.response.headers, {
+      'content-type': 'application/json',
+      'x-case': 'retry-success'
+    })
+  })
+})
