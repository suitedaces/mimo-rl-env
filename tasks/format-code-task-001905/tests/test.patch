+++ b/usercase-test-coderl/fetch-from-api.test.js
@@ -0,0 +1,779 @@
+'use strict'
+
+
+
+
+const childProcess = require('child_process')
+const http = require('http')
+const test = require('ava')
+const { promisify } = require('util')
+
+const mql = require('@microlink/mql')
+const { fetchFromApi } = mql
+const execFile = promisify(childProcess.execFile)
+
+const listen = server =>
+  new Promise(resolve => {
+    server.listen(0, '127.0.0.1', () => {
+      resolve(`http://127.0.0.1:${server.address().port}/`)
+    })
+  })
+
+const close = server => new Promise(resolve => server.close(resolve))
+
+const withServer = async (handler, fn) => {
+  const server = http.createServer(handler)
+  const endpoint = await listen(server)
+  try {
+    return await fn(endpoint)
+  } finally {
+    await close(server)
+  }
+}
+
+const jsonResponse = (res, statusCode, body, extraHeaders = {}) => {
+  const text = JSON.stringify(body)
+  res.sendDate = false
+  res.statusCode = statusCode
+  res.setHeader('connection', 'close')
+  res.setHeader('content-type', 'application/json')
+  res.setHeader('content-length', Buffer.byteLength(text))
+  for (const [key, value] of Object.entries(extraHeaders)) {
+    res.setHeader(key, value)
+  }
+  res.end(text)
+}
+
+const headersToObject = headers => {
+  if (!headers) return {}
+  const entries =
+    typeof headers.entries === 'function'
+      ? Array.from(headers.entries())
+      : Object.entries(headers)
+
+  return Object.fromEntries(
+    entries.map(([key, value]) => [
+      String(key).toLowerCase(),
+      Array.isArray(value) ? value.join(', ') : String(value)
+    ])
+  )
+}
+
+const assertHeadersInclude = (t, headers, expected) => {
+  const actual = headersToObject(headers)
+
+  for (const [key, value] of Object.entries(expected)) {
+    t.is(actual[key.toLowerCase()], value)
+  }
+}
+
+const normalizeSuccess = value => ({
+  status: value.status,
+  data: value.data,
+  response: {
+    url: value.response.url,
+    body: value.response.body,
+    headers: headersToObject(value.response.headers),
+    statusCode: value.response.statusCode
+  }
+})
+
+const normalizeArrayBuffer = value => ({
+  url: value.url,
+  body: Array.from(new Uint8Array(value.body)),
+  headers: headersToObject(value.headers),
+  statusCode: value.statusCode
+})
+
+const assertFatalClientError = (t, error, { apiUrl, statusCode, headers, usefulIncludes }) => {
+
+  t.is(error.status, 'error')
+  t.is(error.code, 'EFATALCLIENT')
+  t.is(error.url, apiUrl)
+  t.is(error.statusCode, statusCode)
+  t.true(typeof error.data?.url === 'string')
+  t.true(error.data.url.length > 0)
+  if (usefulIncludes) t.true(error.data.url.includes(usefulIncludes))
+  assertHeadersInclude(t, error.headers, headers)
+}
+
