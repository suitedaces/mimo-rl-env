+test.serial('does not perform undeclared side effects beyond the API request', async t => {
+  const script = `
+    const fs = require('fs')
+    const http = require('http')
+    const os = require('os')
+    const path = require('path')
+    const { fetchFromApi } = require('@microlink/mql')
+
+    const listen = server =>
+      new Promise(resolve => {
+        server.listen(0, '127.0.0.1', () => {
+          resolve(\`http://127.0.0.1:\${server.address().port}/\`)
+        })
+      })
+    const close = server => new Promise(resolve => server.close(resolve))
+    const headersToObject = headers => {
+      if (!headers) return {}
+      const entries = typeof headers.entries === 'function'
+        ? Array.from(headers.entries())
+        : Object.entries(headers)
+      return Object.fromEntries(entries.map(([key, value]) => [
+        String(key).toLowerCase(),
+        Array.isArray(value) ? value.join(', ') : String(value)
+      ]))
+    }
+
+    ;(async () => {
+      let requestCount = 0
+      const server = http.createServer((req, res) => {
+        requestCount += 1
+        const text = JSON.stringify({ status: 'success', data: { sideEffects: false } })
+        res.sendDate = false
+        res.statusCode = 200
+        res.setHeader('connection', 'close')
+        res.setHeader('content-type', 'application/json')
+        res.setHeader('content-length', Buffer.byteLength(text))
+        res.setHeader('x-case', 'side-effects')
+        res.end(text)
+      })
+      const endpoint = await listen(server)
+      const apiUrl = \`\${endpoint}side-effects?url=https%3A%2F%2Fexample.com\`
+      const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'mql-fetch-from-api-'))
+      const oldCwd = process.cwd()
+
+      try {
+        process.chdir(tmpDir)
+        const before = fs.readdirSync(tmpDir).sort()
+        const value = await fetchFromApi(apiUrl, { responseType: 'json', retry: 0 })
+        const after = fs.readdirSync(tmpDir).sort()
+        process.stdout.write(JSON.stringify({
+          apiUrl,
+          requestCount,
+          before,
+          after,
+          actual: {
+            status: value.status,
+            data: value.data,
+            response: {
+              url: value.response.url,
+              body: value.response.body,
+              headers: headersToObject(value.response.headers),
+              statusCode: value.response.statusCode
+            }
+          }
+        }))
+      } finally {
+        process.chdir(oldCwd)
+        fs.rmSync(tmpDir, { recursive: true, force: true })
+        await close(server)
+      }
+    })().then(() => process.exit(0)).catch(error => {
+      console.error(error)
+      process.exit(1)
+    })
+  `
+
+  const { stdout } = await execFile(process.execPath, ['-e', script], {
+    cwd: '/workspace/repo',
+    encoding: 'utf8'
+  })
+  const result = JSON.parse(stdout)
+
+
+  t.is(result.requestCount, 1)
+
+  t.deepEqual({
+    status: result.actual.status,
+    data: result.actual.data,
+    response: {
+      url: result.actual.response.url,
+      body: result.actual.response.body,
+      statusCode: result.actual.response.statusCode
+    }
+  }, {
+    status: 'success',
+    data: { sideEffects: false },
+    response: {
