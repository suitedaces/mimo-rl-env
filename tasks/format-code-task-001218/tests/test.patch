diff --git a/fsspec/implementations/tests/test_memory.py b/fsspec/implementations/tests/test_memory.py
index 3738935..e271612 100644
--- a/fsspec/implementations/tests/test_memory.py
+++ b/fsspec/implementations/tests/test_memory.py
@@ -83,3 +83,69 @@ def test_moves(m):
     m.touch("source2.txt")
     m.mv("source2.txt", "target2.txt", recursive=True)
     assert m.find("") == ["target.txt", "target2.txt"]
+
+
+def _reset(m):
+    m.store.clear()
+    m.pseudo_dirs.clear()
+
+
+def test_ls_no_duplicate_after_mkdir_then_touch(m):
+
+    _reset(m)
+    m.mkdir("a/b")
+    m.touch("a/b/c.d")
+    listed = m.ls("a")
+    assert listed == ["a/b/"]
+
+
+def test_ls_root_no_duplicate_after_mkdir_then_touch(m):
+    _reset(m)
+    m.mkdir("a/b")
+    m.touch("a/b/c.d")
+    listed = m.ls("")
+    assert listed == ["a/"]
+
+
+def test_ls_only_touch_no_dup(m):
+
+    _reset(m)
+    m.touch("a/b/c.d")
+    assert m.ls("a") == ["a/b/"]
+
+
+def test_ls_detail_no_duplicate_after_mkdir_then_touch(m):
+    _reset(m)
+    m.mkdir("a/b")
+    m.touch("a/b/c.d")
+    detail = m.ls("a", detail=True)
+    assert len(detail) == 1
+    assert detail[0]["name"] == "a/b/"
+    assert detail[0]["type"] == "directory"
+
+
+def test_ls_mkdir_only_still_shows_directory(m):
+
+    _reset(m)
+    m.mkdir("a/b")
+    assert m.ls("a") == ["a/b/"]
+
+
+def test_ls_multiple_files_in_mkdir_dir_no_dup(m):
+    _reset(m)
+    m.mkdir("a/b")
+    m.touch("a/b/c.d")
+    m.touch("a/b/e.f")
+    listed = m.ls("a")
+
+
+    assert listed == ["a/b/"]
+
+
+def test_ls_no_duplicate_with_leading_slash(m):
+
+    _reset(m)
+    m.mkdir("/a/b")
+    m.touch("/a/b/c.d")
+    listed = m.ls("/a")
+    assert listed == ["/a/b/"]
