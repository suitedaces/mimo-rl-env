@@ -0,0 +1,20 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export QT_QPA_PLATFORM=offscreen
+
+
+case "${1:-}" in
+  base)
+    python -m pytest leo/unittests/test_gui.py -x -v -k 'not TestWrapperCompatibility'
+    ;;
+  new)
+    python -m pytest leo/unittests/test_gui.py::TestWrapperCompatibility -x -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
