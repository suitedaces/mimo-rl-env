             result = c.frame.log.put_html_links(s)
             self.assertEqual(result, expected, msg=repr(s))
     #@-others
+
+class TestWrapperCompatibility(LeoUnitTest):
+    """Focused tests for shared wrapper compatibility calls."""
+
+
+    def make_qt_status_line(self):
+        status_line = object.__new__(LeoQtFrame.QtStatusLineClass)
+        status_line.textWidget1 = object()
+        return status_line
+
+    def make_qheadline_wrapper(self):
+        wrapper = object.__new__(QHeadlineWrapper)
+        wrapper.widget = object()
+        return wrapper
+
+
+    def test_string_text_wrapper_enable_disable_are_safe_noops(self):
+        wrapper = StringTextWrapper(None, 'body')
+
+        wrapper.disable()
+        wrapper.enable()
+        self.assertEqual(wrapper.getAllText(), '')
+
+
+    def test_qt_status_line_enable_disable_focus_are_safe_noops(self):
+        status_line = self.make_qt_status_line()
+
+        status_line.disable()
+        status_line.disable(None)
+        status_line.disable("gray")
+        status_line.enable()
+        status_line.enable("blue")
+        status_line.enable(None)
+        status_line.setFocus()
+
+
+    def test_qt_status_line_is_enabled_returns_stable_boolean(self):
+        status_line = self.make_qt_status_line()
+
+        self.assertIsInstance(status_line.isEnabled(), bool)
+        for action in (status_line.enable, status_line.disable, status_line.enable, status_line.disable):
+            action()
+            self.assertIsInstance(status_line.isEnabled(), bool)
+
+
+    def test_qheadline_wrapper_scroll_methods_are_compatible_noops(self):
+        wrapper = self.make_qheadline_wrapper()
+        first_x = wrapper.getXScrollPosition()
+        first_y = wrapper.getYScrollPosition()
+        self.assertIsInstance(first_x, int)
+        self.assertIsInstance(first_y, int)
+
+        wrapper.setXScrollPosition(3)
+        wrapper.setXScrollPosition(5)
+        wrapper.setYScrollPosition(4)
+        wrapper.setYScrollPosition(6)
+        self.assertEqual(wrapper.getXScrollPosition(), first_x)
+        self.assertEqual(wrapper.getXScrollPosition(), first_x)
+        self.assertEqual(wrapper.getYScrollPosition(), first_y)
+
+
+    def test_qheadline_wrapper_flash_character_is_safe_noop(self):
+        wrapper = self.make_qheadline_wrapper()
+
+        wrapper.flashCharacter(0)
+        wrapper.flashCharacter(1, "yellow", "blue", 1, 1)
+        wrapper.flashCharacter(2)
+
 #@-others
 #@-leo
