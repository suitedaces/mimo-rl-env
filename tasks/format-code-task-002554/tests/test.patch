+    def test_add_active_history_skips_duplicate_nzo_id(self):
+        """Race window: when a postproc NZO shares its nzo_id with an item
+        already in the list (from history DB), it must NOT be appended again.
+        The kept entry must be the DB one with its storage path filled."""
+        shared_id = "SABnzbd_nzo_h4h4kvnz"
+
+        db_storage = "/media/downloads/usenet/comics/foo.cbr"
+        items = [
+            {
+                "nzo_id": shared_id,
+                "storage": db_storage,
+                "name": "from_db",
+                "status": "Completed",
+            }
+        ]
+
+        nzo = _make_pp_nzo(shared_id, final_name="from_pp")
+
+        api.add_active_history([nzo], items)
+
+
+        nzo_ids = [item["nzo_id"] for item in items]
+        assert nzo_ids.count(shared_id) == 1
+        assert len(items) == 1
+
+
+
+        assert items[0]["storage"] == db_storage
+        assert items[0]["name"] == "from_db"
+
+    def test_add_active_history_appends_when_no_duplicate(self):
+        """Normal path: postproc nzo_id not in items - append it (preservation)."""
+        items = [
+            {
+                "nzo_id": "db_only_id",
+                "storage": "/db/path",
+                "name": "from_db",
+                "status": "Completed",
+            }
+        ]
+        nzo = _make_pp_nzo("pp_only_id", final_name="from_pp")
+
+        api.add_active_history([nzo], items)
+
+        assert len(items) == 2
+        nzo_ids = [item["nzo_id"] for item in items]
+        assert "db_only_id" in nzo_ids
+        assert "pp_only_id" in nzo_ids
+
+    def test_add_active_history_empty_items_appends_all(self):
+        """Empty items + non-empty postproc: all postproc items appended."""
+        items = []
+        nzo = _make_pp_nzo("solo_pp")
+
+        api.add_active_history([nzo], items)
+
+        assert len(items) == 1
+        assert items[0]["nzo_id"] == "solo_pp"
+
+        assert items[0]["storage"] == ""
+
+    def test_add_active_history_empty_postproc_unchanged(self):
+        """Empty postproc: items unchanged."""
+        items = [
+            {"nzo_id": "A", "storage": "/a", "name": "n_a"},
+            {"nzo_id": "B", "storage": "/b", "name": "n_b"},
+        ]
+        snapshot = [dict(item) for item in items]
+
+        api.add_active_history([], items)
+
+        assert items == snapshot
+
+    def test_add_active_history_mixed_duplicates(self):
+        """Realistic mix: some postproc nzo_ids duplicate, some not.
+        Only the non-duplicate ones get appended, and the DB items keep their
+        original storage/name fields."""
+        items = [
+            {"nzo_id": "shared_1", "storage": "/db/1", "name": "db1", "status": "Completed"},
+            {"nzo_id": "shared_2", "storage": "/db/2", "name": "db2", "status": "Completed"},
+            {"nzo_id": "db_only", "storage": "/db/3", "name": "db3", "status": "Completed"},
+        ]
+        nzo_dup_1 = _make_pp_nzo("shared_1", final_name="pp_shared_1")
+        nzo_new = _make_pp_nzo("pp_only", final_name="pp_only_name")
+        nzo_dup_2 = _make_pp_nzo("shared_2", final_name="pp_shared_2")
+
+        api.add_active_history([nzo_dup_1, nzo_new, nzo_dup_2], items)
+
+
+        assert len(items) == 4
+        nzo_ids = [item["nzo_id"] for item in items]
+        assert sorted(nzo_ids) == ["db_only", "pp_only", "shared_1", "shared_2"]
+
+        by_id = {item["nzo_id"]: item for item in items}
+
+        assert by_id["shared_1"]["storage"] == "/db/1"
+        assert by_id["shared_1"]["name"] == "db1"
+        assert by_id["shared_2"]["storage"] == "/db/2"
+        assert by_id["shared_2"]["name"] == "db2"
+        assert by_id["db_only"]["storage"] == "/db/3"
+
+        assert by_id["pp_only"]["storage"] == ""
+        assert by_id["pp_only"]["name"] == "pp_only_name"
