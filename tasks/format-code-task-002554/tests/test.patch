+def _make_pp_nzo(nzo_id, final_name=None):
+    """Build a mock NZO suitable for add_active_history()."""
+    nzo = mock.Mock()
+    nzo.nzo_id = nzo_id
+    nzo.final_name = final_name or ("pp_" + nzo_id)
+    nzo.filename = nzo.final_name + ".nzb"
+    nzo.cat = "*"
+    nzo.repair, nzo.unpack, nzo.delete = pp_to_opts(0)
+    nzo.script = "None"
+    nzo.url = ""
+    nzo.status = "Extracting"
+    nzo.download_path = "/incomplete/" + nzo_id
+    nzo.nzo_info = {"download_time": 1}
+    nzo.bytes_downloaded = 1024
+    nzo.fail_msg = ""
+    nzo.duplicate_key = ""
+    nzo.correct_password = ""
+    nzo.action_line = ""
+    nzo.pp_active = False
+    nzo.unpack_info = {}
+    return nzo
+
