@@ -0,0 +1,98 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+export PYTHONDONTWRITEBYTECODE=1
+
+REPO=/workspace/repo
+FIXTURES="$REPO/usercase-test-coderl/fixtures"
+BIN="$REPO/Code/autopkg"
+export PYTHONPATH="$REPO/Code${PYTHONPATH:+:$PYTHONPATH}"
+
+[ -x "$BIN" ] || { echo "FAIL: autopkg entry point is not executable" >&2; exit 1; }
+python3 - <<'PY' || { echo "FAIL: missing Python runtime dependencies" >&2; exit 1; }
+import appdirs
+import yaml
+PY
+
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || exit 1
+fail() { echo "FAIL: $*" >&2; exit 1; }
+run_autopkg() { python3 "$BIN" "$@"; }
+
+
+
+
+run_autopkg repo-list --prefs "$FIXTURES/repos-multiple.json" >out 2>err; ec=$?
+cat >expected <<'EOF'
+/tmp/alpha-recipes (https://github.com/example/alpha-recipes)
+/tmp/beta-recipes (ssh://git@example.com/team/beta-recipes.git)
+/var/tmp/zeta-recipes (https://github.com/example/zeta-recipes)
+
+EOF
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+cmp -s out expected || fail "F1 stdout: $(cat out)"
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+
+
+
+
+run_autopkg repo-list --prefs "$FIXTURES/repos-empty.json" >out 2>err; ec=$?
+printf 'No recipe repos.\n' >expected
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+cmp -s out expected || fail "F2 stdout: $(cat out)"
+[ ! -s err ] || fail "F2 unexpected stderr: $(cat err)"
+
+
+
+
+run_autopkg repo-list --prefs "$FIXTURES/repos-absent.json" >out 2>err; ec=$?
+printf 'No recipe repos.\n' >expected
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+cmp -s out expected || fail "F3 stdout: $(cat out)"
+[ ! -s err ] || fail "F3 unexpected stderr: $(cat err)"
+
+
+
+
+run_autopkg list-repos --prefs "$FIXTURES/repos-single.json" >out 2>err; ec=$?
+cat >expected <<'EOF'
+/opt/recipes (git@example.com:team/recipes.git)
+
+EOF
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+cmp -s out expected || fail "F4 stdout: $(cat out)"
+[ ! -s err ] || fail "F4 unexpected stderr: $(cat err)"
+
+
+
+
+run_autopkg repo-list --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+
+grep -Fxq 'Usage: autopkg repo-list' out || fail "F5 missing usage line: $(cat out)"
+grep -Eiq 'list(s)? all installed recipe repos|list(s)? installed recipe repos' out || fail "F5 missing repository-listing description: $(cat out)"
+[ ! -s err ] || fail "F5 unexpected stderr: $(cat err)"
+
+
+
+
+run_autopkg help >out 2>err; ec=$?
+
+[ "$ec" -eq 0 ] || [ "$ec" -eq 1 ] || fail "F6 exit $ec; want successful/help-style exit"
+grep -Eq '(^|[[:space:]])repo-list([[:space:]]|$).*List installed recipe repos' out || fail "F6 missing repo-list help entry"
+grep -Eq '(^|[[:space:]])list-repos([[:space:]]|$).*see repo-list' out || fail "F6 missing list-repos help entry"
+[ ! -s err ] || fail "F6 unexpected stderr: $(cat err)"
+
+
+
+
+run_autopkg repo-list --prefs >out 2>err; ec=$?
+
+[ "$ec" -ne 0 ] || fail "F7 exit $ec; want non-zero"
+[ ! -s out ] || fail "F7 unexpected stdout: $(cat out)"
+[ -s err ] || fail "F7 expected an error message for missing --prefs path"
+grep -Eq -- '--prefs|Usage: autopkg repo-list' err || fail "F7 stderr should identify the invalid option or usage: $(cat err)"
+
+echo "PASS"
+exit 0
