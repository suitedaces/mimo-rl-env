diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,37 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export PATH="$HOME/.pyenv/bin:$PATH"
+eval "$(pyenv init -)"
+pyenv global 3.5.10
+
+
+case "${1:-}" in
+  base)
+    git apply --reverse --check /testbed/mimo_test.patch >/tmp/fixture_reverse_check.log 2>&1
+    reverse_available=$?
+    if [ "$reverse_available" -eq 0 ]; then
+      git apply --reverse --whitespace=nowarn /testbed/mimo_test.patch
+    fi
+    DJANGO_SETTINGS_MODULE=ralph.settings.test django-admin test \
+      ralph.data_center.tests.test_models -v2
+    test_exit=$?
+    if [ "$reverse_available" -eq 0 ]; then
+      git apply --whitespace=nowarn /testbed/mimo_test.patch
+    fi
+    exit "$test_exit"
+    ;;
+  new)
+    DJANGO_SETTINGS_MODULE=ralph.settings.test django-admin test \
+      ralph.data_center.tests.test_models.DataCenterAssetTest.test_direct_children_rack_follows_parent_when_parent_rack_changes \
+      ralph.data_center.tests.test_models.DataCenterAssetTest.test_rack_sync_is_limited_to_direct_children \
+      ralph.data_center.tests.test_models.DataCenterAssetTest.test_saving_parent_without_rack_change_does_not_change_child_rack \
+      -v2
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
