diff --git a/src/ralph/data_center/tests/test_models.py b/src/ralph/data_center/tests/test_models.py
index b6fe9cac85..6e3f5c2c4a 100644
--- a/src/ralph/data_center/tests/test_models.py
+++ b/src/ralph/data_center/tests/test_models.py
@@ -255,3 +255,47 @@ class DataCenterAssetTest(RalphTestCase):
         self.dc_asset.rack = RackFactory(max_u_height=rack_max_height)
         with self.assertRaises(ValidationError):
             self.dc_asset._validate_position_in_rack()
+
+    def test_direct_children_rack_follows_parent_when_parent_rack_changes(self):
+        old_rack = RackFactory()
+        new_rack = RackFactory()
+        self.dc_asset.rack = old_rack
+        self.dc_asset.save()
+        first_child = DataCenterAssetFactory(
+            parent=self.dc_asset,
+            rack=old_rack,
+        )
+        second_child = DataCenterAssetFactory(
+            parent=self.dc_asset,
+            rack=old_rack,
+        )
+
+        self.dc_asset.rack = new_rack
+        self.dc_asset.save()
+        first_child.refresh_from_db()
+        second_child.refresh_from_db()
+
+        self.assertEqual(first_child.rack_id, new_rack.id)
+        self.assertEqual(second_child.rack_id, new_rack.id)
+
+    def test_rack_sync_is_limited_to_direct_children(self):
+        old_rack = RackFactory()
+        new_rack = RackFactory()
+        self.dc_asset.rack = old_rack
+        self.dc_asset.save()
+        direct_child = DataCenterAssetFactory(parent=self.dc_asset, rack=old_rack)
+        unrelated_asset = DataCenterAssetFactory(rack=old_rack)
+
+        self.dc_asset.rack = new_rack
+        self.dc_asset.save()
+        direct_child.refresh_from_db()
+        unrelated_asset.refresh_from_db()
+
+        self.assertEqual(direct_child.rack_id, new_rack.id)
+        self.assertEqual(unrelated_asset.rack_id, old_rack.id)
+
+    def test_saving_parent_without_rack_change_does_not_change_child_rack(self):
+        parent_rack = RackFactory()
+        child_rack = RackFactory()
+        self.dc_asset.rack = parent_rack
+        self.dc_asset.save()
+        child = DataCenterAssetFactory(parent=self.dc_asset, rack=child_rack)
+
+        self.dc_asset.save()
+        child.refresh_from_db()
+
+        self.assertEqual(child.rack_id, child_rack.id)
