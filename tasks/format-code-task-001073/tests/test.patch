diff --git a/pandas/tests/frame/methods/test_explode_mismatch_codespec.py b/pandas/tests/frame/methods/test_explode_mismatch_codespec.py
new file mode 100644
index 0000000000..24d9345a3f
--- /dev/null
+++ b/pandas/tests/frame/methods/test_explode_mismatch_codespec.py
@@ -0,0 +1,181 @@
+import numpy as np
+import pytest
+
+import pandas as pd
+import pandas._testing as tm
+
+
+def _explode_with_mismatch(frame, columns, mismatch, *, ignore_index=False):
+
+    try:
+        return frame.explode(
+            columns, ignore_index=ignore_index, mismatch=mismatch
+        )
+    except TypeError as err:
+        if "mismatch" in str(err):
+            raise AssertionError(
+                "DataFrame.explode does not support the mismatch policy"
+            ) from err
+        raise
+
+
+def test_codespec_explode_mismatch_raise_is_strict_and_explicit():
+    frame = pd.DataFrame(
+        {"left": [[1, 2], [3]], "right": [["a", "b"], ["c"]]},
+        index=["first", "second"],
+    )
+
+    expected = frame.explode(["left", "right"])
+    result = _explode_with_mismatch(frame, ["left", "right"], "raise")
+    tm.assert_frame_equal(result, expected)
+
+    ragged = pd.DataFrame({"left": [[1, 2]], "right": [["a"]]})
+    with pytest.raises(ValueError):
+        _explode_with_mismatch(ragged, ["left", "right"], "raise")
+    with pytest.raises(ValueError):
+        ragged.explode(["left", "right"])
+
+
+def test_codespec_explode_mismatch_rejects_unknown_policy_for_one_column():
+    frame = pd.DataFrame({"values": [[1, 2]]})
+
+    with pytest.raises(ValueError):
+        _explode_with_mismatch(frame, "values", "zip")
+
+
+def test_codespec_explode_mismatch_broadcasts_scalar_singleton_and_empty():
+    frame = pd.DataFrame(
+        {
+            "left": [[1, 2, 3], [4, 5]],
+            "right": ["fixed", ["only"]],
+            "optional": [[], ["u", "v"]],
+            "payload": [10, 20],
+        },
+        index=pd.Index(["three", "two"], name="source"),
+    )
+
+    result = _explode_with_mismatch(
+        frame, ["left", "right", "optional"], "broadcast"
+    )
+    expected = pd.DataFrame(
+        {
+            "left": np.array([1, 2, 3, 4, 5], dtype=object),
+            "right": np.array(
+                ["fixed", "fixed", "fixed", "only", "only"], dtype=object
+            ),
+            "optional": np.array([np.nan, np.nan, np.nan, "u", "v"], dtype=object),
+            "payload": [10, 10, 10, 20, 20],
+        },
+        index=pd.Index(
+            ["three", "three", "three", "two", "two"], name="source"
+        ),
+    )
+    tm.assert_frame_equal(result, expected)
+
+
+def test_codespec_explode_mismatch_broadcast_rejects_non_singleton_shorter_list():
+    frame = pd.DataFrame(
+        {"left": [[1, 2, 3]], "right": [["a", "b"]], "payload": [5]}
+    )
+
+    with pytest.raises(ValueError):
+        _explode_with_mismatch(frame, ["left", "right"], "broadcast")
+
+
+def test_codespec_explode_mismatch_pad_distinguishes_sequences_from_scalars():
+    frame = pd.DataFrame(
+        {
+            "left": [[1, 2, 3], [4, 5]],
+            "right": [["only"], "fixed"],
+            "optional": [[], ["u"]],
+            "payload": [10, 20],
+        },
+        index=["three", "two"],
+    )
+
+    result = _explode_with_mismatch(frame, ["left", "right", "optional"], "pad")
+    expected = pd.DataFrame(
+        {
+            "left": np.array([1, 2, 3, 4, 5], dtype=object),
+            "right": np.array(
+                ["only", np.nan, np.nan, "fixed", "fixed"], dtype=object
+            ),
+            "optional": np.array([np.nan, np.nan, np.nan, "u", np.nan], dtype=object),
+            "payload": [10, 10, 10, 20, 20],
+        },
+        index=["three", "three", "three", "two", "two"],
+    )
+    tm.assert_frame_equal(result, expected)
+
+
+def test_codespec_explode_mismatch_preserves_multiindex_and_tuple_columns():
+    columns = pd.MultiIndex.from_tuples(
+        [("data", "left"), ("data", "right"), ("meta", "value")]
+    )
+    index = pd.MultiIndex.from_tuples(
+        [("group", 1), ("group", 2)], names=["kind", "number"]
+    )
+    frame = pd.DataFrame(
+        [[[1, 2], "x", 10], [[3, 4, 5], ["a"], 20]],
+        columns=columns,
+        index=index,
+    )
+
+    result = _explode_with_mismatch(
+        frame, [("data", "left"), ("data", "right")], "broadcast"
+    )
+    expected_index = pd.MultiIndex.from_tuples(
+        [
+            ("group", 1),
+            ("group", 1),
+            ("group", 2),
+            ("group", 2),
+            ("group", 2),
+        ],
+        names=["kind", "number"],
+    )
+    expected = pd.DataFrame(
+        {
+            ("data", "left"): np.array([1, 2, 3, 4, 5], dtype=object),
+            ("data", "right"): np.array(["x", "x", "a", "a", "a"], dtype=object),
+            ("meta", "value"): [10, 10, 20, 20, 20],
+        },
+        index=expected_index,
+    )
+    tm.assert_frame_equal(result, expected)
+
+
+def test_codespec_explode_mismatch_ignore_index_and_single_column_compatibility():
+    frame = pd.DataFrame(
+        {"values": [[1, 2], [], 3], "payload": ["a", "b", "c"]},
+        index=[7, 8, 9],
+    )
+
+    for ignore_index in [False, True]:
+        baseline = frame.explode("values", ignore_index=ignore_index)
+        for mismatch in ["raise", "broadcast", "pad"]:
+            result = _explode_with_mismatch(
+                frame, "values", mismatch, ignore_index=ignore_index
+            )
+            tm.assert_frame_equal(result, baseline)
+            if ignore_index:
+                assert isinstance(result.index, pd.RangeIndex)
+
+
+@pytest.mark.parametrize("mismatch", ["broadcast", "pad"])
+def test_codespec_explode_mismatch_all_empty_sequences_keep_one_row(mismatch):
+    frame = pd.DataFrame(
+        {"left": [[]], "right": [np.array([])], "payload": [10]},
+        index=pd.Index(["empty"], name="source"),
+    )
+
+    result = _explode_with_mismatch(frame, ["left", "right"], mismatch)
+    expected = pd.DataFrame(
+        {
+            "left": np.array([np.nan], dtype=object),
+            "right": np.array([np.nan], dtype=object),
+            "payload": [10],
+        },
+        index=pd.Index(["empty"], name="source"),
+    )
+    tm.assert_frame_equal(result, expected)
