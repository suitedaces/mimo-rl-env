diff --git a/tests/analyzers_manager/test_phishing_army.py b/tests/analyzers_manager/test_phishing_army.py
new file mode 100644
index 00000000..28056b1b
--- /dev/null
+++ b/tests/analyzers_manager/test_phishing_army.py
@@ -0,0 +1,91 @@
+
+
+
+import os
+from unittest.mock import MagicMock, patch
+
+from django.conf import settings
+from kombu import uuid
+
+from api_app.analyzers_manager.classes import ObservableAnalyzer
+from api_app.analyzers_manager.models import AnalyzerConfig
+from api_app.models import Job
+from tests import CustomTestCase
+
+
+BLOCKLIST = b"bad.example.com\nevil.test\n91.192.100.61"
+
+
+def _get_phishing_army_class():
+
+    for subclass in ObservableAnalyzer.all_subclasses():
+        if subclass.__name__ == "PhishingArmy":
+            return subclass
+    return None
+
+
+class PhishingArmyAnalyzerTestCase(CustomTestCase):
+    fixtures = [
+        "api_app/fixtures/0001_user.json",
+    ]
+
+    def setUp(self):
+        super().setUp()
+
+
+        os.makedirs(settings.MEDIA_ROOT, exist_ok=True)
+
+    def _run_analyzer(self, observable_name, classification, content=BLOCKLIST):
+        cls = _get_phishing_army_class()
+        self.assertIsNotNone(
+            cls,
+            "an observable analyzer named 'PhishingArmy' must be available",
+        )
+        config = AnalyzerConfig.objects.first()
+        job = Job.objects.create(
+            user=self.superuser,
+            observable_name=observable_name,
+            observable_classification=classification,
+        )
+        analyzer = cls(config, job.pk, runtime_configuration={}, task_id=uuid())
+        response = MagicMock()
+        response.content = content
+        response.text = content.decode()
+        response.status_code = 200
+        response.raise_for_status = lambda: None
+        try:
+            with patch("requests.get", return_value=response):
+                return analyzer.run()
+        finally:
+            job.delete()
+
+    def test_returns_found_flag(self):
+        result = self._run_analyzer("bad.example.com", "domain")
+        self.assertIsInstance(result, dict)
+        self.assertIn("found", result)
+        self.assertIsInstance(result["found"], bool)
+
+    def test_domain_on_blocklist(self):
+        result = self._run_analyzer("bad.example.com", "domain")
+        self.assertTrue(result["found"])
+
+    def test_domain_not_on_blocklist(self):
+        result = self._run_analyzer("good.example.com", "domain")
+        self.assertFalse(result["found"])
+
+    def test_ip_on_blocklist(self):
+        result = self._run_analyzer("91.192.100.61", "ip")
+        self.assertTrue(result["found"])
+
+    def test_url_matches_on_hostname(self):
+
+        result = self._run_analyzer("http://bad.example.com/some/path?a=1", "url")
+        self.assertTrue(result["found"])
+
+    def test_url_only_hostname_is_considered(self):
+
+
+        result = self._run_analyzer(
+            "http://good.example.com/redirect?to=bad.example.com", "url"
+        )
+        self.assertFalse(result["found"])
