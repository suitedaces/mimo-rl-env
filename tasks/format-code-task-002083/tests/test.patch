diff --git a/usercase-test-coderl/local_redis_transport.test.js b/usercase-test-coderl/local_redis_transport.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/local_redis_transport.test.js
@@ -0,0 +1,299 @@
+var fs = require("fs");
+var path = require("path");
+var test = require("tape");
+
+var repoRoot = path.join(__dirname, "..");
+var jobsFile = path.join(repoRoot, ".jobs");
+var redisFactoryPath = path.join(repoRoot, "lib", "transports", "redis");
+
+
+
+
+
+
+
+
+
+
+function resetJobsFile(contents) {
+  try {
+    fs.unlinkSync(jobsFile);
+  } catch (e) {
+    if (e.code !== "ENOENT") {
+      throw e;
+    }
+  }
+
+  if (contents !== undefined) {
+    fs.writeFileSync(jobsFile, contents);
+  }
+}
+
+function resetRedisModules() {
+  Object.keys(require.cache).forEach(function(cachePath) {
+    if (cachePath.indexOf(path.join("lib", "transports", "redis")) !== -1) {
+      delete require.cache[cachePath];
+    }
+  });
+}
+
+function createLocalJobs(settings) {
+  return require(redisFactoryPath)(settings || {});
+}
+
+function readJobsJson() {
+  return JSON.parse(fs.readFileSync(jobsFile, "utf8"));
+}
+
+
+function expectJobList(t, jobs, expected, cb) {
+  jobs.getJobList(function(err, list) {
+    t.equal(err, null);
+    t.deepEqual(list, expected);
+    cb();
+  });
+}
+
+function expectJob(t, jobs, expected, cb) {
+  jobs.getJob(function(err, job) {
+    t.equal(err, null);
+    t.deepEqual(job, expected);
+    cb();
+  });
+}
+
+function expectHash(t, jobs, key, expected, cb) {
+  jobs.getHash(key, function(err, hash) {
+    t.equal(err, null);
+    t.deepEqual(hash, expected);
+    cb();
+  });
+}
+
+test("factory without redisHost creates a local persistent job store", function(t) {
+
+
+
+
+  resetJobsFile();
+  resetRedisModules();
+
+  var jobs = createLocalJobs({});
+
+  t.equal(fs.existsSync(jobsFile), true);
+
+  t.deepEqual(readJobsJson(), {});
+
+  [
+    "addJob",
+    "cleanJobs",
+    "getHash",
+    "getJob",
+    "getJobList",
+    "incrementField",
+    "quit",
+    "setField",
+    "workerDelay"
+  ].forEach(function(methodName) {
+    t.equal(typeof jobs[methodName], "function");
+  });
+  t.end();
+});
+
+test("local jobs are appended, listed, and popped in FIFO order", function(t) {
+
+
+
+
+  resetJobsFile("{}");
+  var jobs = createLocalJobs({});
+
+  expectJobList(t, jobs, [], function() {
+
+    t.doesNotThrow(function() {
+      jobs.addJob({ id: "a", caption: "one" });
+    });
+
+    t.doesNotThrow(function() {
+      jobs.addJob({ id: "b" });
+    });
+    expectJobList(t, jobs, [
+      { id: "a", caption: "one" },
+      { id: "b" }
+    ], function() {
+      expectJob(t, jobs, { id: "a", caption: "one" }, function() {
+        expectJob(t, jobs, { id: "b" }, function() {
+          expectJob(t, jobs, null, function() {
+
+            t.equal(fs.existsSync(jobsFile), true);
+            t.equal(typeof readJobsJson(), "object");
+            t.end();
+          });
+        });
+      });
+    });
+  });
+});
+
+test("job status hashes support set, missing lookup, and increment from zero", function(t) {
+
+
+
+
+  resetJobsFile("{}");
+  var jobs = createLocalJobs({});
+
+  expectHash(t, jobs, "missing", null, function() {
+
+    t.doesNotThrow(function() {
+      jobs.setField("video-1", "status", "frames");
+    });
+    expectHash(t, jobs, "video-1", { status: "frames" }, function() {
+
+      t.doesNotThrow(function() {
+        jobs.incrementField("video-1", "framesComplete");
+      });
+
+      t.doesNotThrow(function() {
+        jobs.incrementField("video-1", "framesComplete");
+      });
+      expectHash(t, jobs, "video-1", { status: "frames", framesComplete: 2 }, function() {
+
+        t.equal(fs.existsSync(jobsFile), true);
+        t.equal(typeof readJobsJson(), "object");
+        t.end();
+      });
+    });
+  });
+});
+
+test("local transport instances share the persisted .jobs state", function(t) {
+
+
+
+
+  resetJobsFile("{}");
+  var a = createLocalJobs({});
+  var b = createLocalJobs({ local: true });
+
+
+  t.doesNotThrow(function() {
+    a.addJob({ id: "a", caption: "one" });
+  });
+  expectJobList(t, a, [{ id: "a", caption: "one" }], function() {
+    expectJobList(t, b, [{ id: "a", caption: "one" }], function() {
+
+      t.doesNotThrow(function() {
+        a.setField("video-1", "status", "frames");
+      });
+      expectHash(t, a, "video-1", { status: "frames" }, function() {
+        expectHash(t, b, "video-1", { status: "frames" }, function() {
+          t.end();
+        });
+      });
+    });
+  });
+});
+
+test("cleanJobs reports completion without pinning later missing-file internals", function(t) {
+
+
+
+
+  resetJobsFile("{}");
+  var jobs = createLocalJobs({});
+
+  jobs.cleanJobs(function(cleanErr) {
+    t.equal(cleanErr, null);
+    t.equal(fs.existsSync(jobsFile), false);
+
+
+    t.doesNotThrow(function() {
+      jobs.quit();
+    });
+
+    t.end();
+  });
+});
+
+test("quit is idempotent and does not throw", function(t) {
+
+
+
+
+  resetJobsFile("{}");
+  var jobs = createLocalJobs({});
+
+
+  t.doesNotThrow(function() {
+    jobs.quit();
+    jobs.quit();
+  });
+  t.end();
+});
+
+test("cleanJobs deletes the local persistence file through its callback", function(t) {
+
+
+
+
+  resetJobsFile("{}");
+  var jobs = createLocalJobs({});
+
+  t.equal(fs.existsSync(jobsFile), true);
+  jobs.cleanJobs(function(err) {
+    t.equal(err, null);
+    t.equal(fs.existsSync(jobsFile), false);
+    t.end();
+  });
+});
+
+test("workerDelay uses the documented local polling range", function(t) {
+
+
+
+
+  resetJobsFile("{}");
+  var jobs = createLocalJobs({});
+
+  [jobs.workerDelay(), jobs.workerDelay(), jobs.workerDelay()].forEach(function(delay) {
+    t.equal(typeof delay, "number");
+    t.ok(delay >= 0);
+    t.ok(delay < 1000);
+  });
+  t.end();
+});
+
+test("construct-use-clean cycles keep the .jobs resource counter bounded", function(t) {
+
+
+
+
+  var cycle = 0;
+
+  function runCycle() {
+    if (cycle === 100) {
+      t.end();
+      return;
+    }
+
+    resetJobsFile();
+    resetRedisModules();
+
+    var jobs = createLocalJobs({});
+    t.equal(fs.existsSync(jobsFile), true);
+
+    t.doesNotThrow(function() {
+      jobs.addJob({ id: "cycle-" + cycle });
+    });
+
+    jobs.cleanJobs(function(err) {
+      t.equal(err, null);
+      t.equal(fs.existsSync(jobsFile), false);
+      cycle++;
+      runCycle();
+    });
+  }
+
+  runCycle();
+});
