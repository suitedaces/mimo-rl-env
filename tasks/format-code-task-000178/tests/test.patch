@@ -0,0 +1,40 @@
+import subprocess
+from pathlib import Path
+
+from odoo.tests import common
+
+
+class TestSaleForceInvoicedDocs(common.TransactionCase):
+    @classmethod
+    def _module_root(cls):
+        return Path(__file__).resolve().parents[1]
+
+    @classmethod
+    def _read_usage_document(cls, relative_path):
+        return (cls._module_root() / relative_path).read_text(encoding="utf-8")
+
+    @classmethod
+    def _read_base_usage_document(cls, relative_path):
+        module_path = Path("sale_force_invoiced") / relative_path
+        return subprocess.check_output(
+            ["git", "-C", str(cls._module_root().parents[0]), "show", f"HEAD:{module_path}"],
+            text=True,
+        )
+
+    def test_usage_documentation_is_updated(self):
+        module_root = Path(__file__).resolve().parents[1]
+        candidates = [
+            Path("readme") / "USAGE.md",
+            Path("README.rst"),
+        ]
+        updated_documents = [
+            relative_path
+            for relative_path in candidates
+            if (module_root / relative_path).exists()
+            and self._read_usage_document(relative_path)
+            != self._read_base_usage_document(relative_path)
+        ]
+        self.assertTrue(
+            updated_documents,
+            "Usage documentation should be updated for the new line-level Force Invoiced behavior.",
+        )
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,39 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+
+DB_NAME="sale_force_invoiced_test"
+ADDONS_PATH="/opt/odoo/addons,/testbed"
+
+reset_db() {
+    pg_ctlcluster 16 main start 2>/dev/null || true
+    dropdb --if-exists "$DB_NAME" 2>/dev/null || true
+    createdb "$DB_NAME"
+}
+
+run_odoo() {
+    python3 /opt/odoo/odoo-bin \
+        -d "$DB_NAME" \
+        --addons-path="$ADDONS_PATH" \
+        -i sale_force_invoiced \
+        --stop-after-init \
+        --log-level=test "$@"
+}
+
+case "${1:-}" in
+    base)
+        reset_db
+        run_odoo
+        ;;
+    new)
+        reset_db
+        run_odoo --test-tags=/sale_force_invoiced:TestSaleForceInvoiced.test_sales_order,/sale_force_invoiced:TestSaleForceInvoicedDocs.test_usage_documentation_is_updated
+        ;;
+    *)
+        echo "usage: $0 base|new"
+        exit 2
+        ;;
+esac
