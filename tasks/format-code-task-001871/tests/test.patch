@@ -0,0 +1,40 @@
+package runewidth
+
+import "testing"
+
+func TestFullwidthRunesHaveWidthTwo(t *testing.T) {
+	ranges := []struct {
+		name string
+		lo   rune
+		hi   rune
+	}{
+		{"ideographic space", '\u3000', '\u3000'},
+		{"fullwidth ASCII and punctuation", 0xFF01, 0xFF60},
+		{"fullwidth signs", 0xFFE0, 0xFFE6},
+	}
+	for _, rg := range ranges {
+		for r := rg.lo; r <= rg.hi; r++ {
+			if got := RuneWidth(r); got != 2 {
+				t.Fatalf("%s: RuneWidth(%U) = %d, want 2", rg.name, r, got)
+			}
+		}
+	}
+	if got := StringWidth("\u3000"); got != 2 {
+		t.Fatalf("StringWidth(%q) = %d, want 2", "\u3000", got)
+	}
+}
+
+func TestFullwidthStringWidthAggregatesPerRune(t *testing.T) {
+	tests := []struct {
+		s    string
+		want int
+	}{
+		{"\u3000！？Ａ", 8},
+		{"＃＄ｚ", 6},
+	}
+	for _, tt := range tests {
+		if got := StringWidth(tt.s); got != tt.want {
+			t.Fatalf("StringWidth(%q) = %d, want %d", tt.s, got, tt.want)
+		}
+	}
+}
diff --git a/script/generate_fullwidth_hidden_test.go b/script/generate_fullwidth_hidden_test.go
new file mode 100644
index 0000000..74149ad
--- /dev/null
+++ b/script/generate_fullwidth_hidden_test.go
@@ -0,0 +1,73 @@
+package main
+
+import (
+	"bytes"
+	"regexp"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+func TestGeneratedWidthDataIncludesFullwidthRecords(t *testing.T) {
+	fixture := strings.NewReader(strings.Join([]string{
+		"3000;F # IDEOGRAPHIC SPACE",
+		"3001;W # IDEOGRAPHIC COMMA",
+		"FF01..FF03;F # FULLWIDTH EXCLAMATION MARK..FULLWIDTH NUMBER SIGN",
+		"FFE0..FFE1;F # FULLWIDTH CENT SIGN..FULLWIDTH POUND SIGN",
+		"0041;Na # LATIN CAPITAL LETTER A",
+		"",
+	}, "\n"))
+
+	var out bytes.Buffer
+	if err := eastasian(&out, fixture); err != nil {
+		t.Fatalf("eastasian returned error: %v", err)
+	}
+
+	ranges := parseGeneratedRanges(t, out.String())
+	for _, r := range []rune{0x3000, 0x3001, 0xFF01, 0xFF03, 0xFFE0, 0xFFE1} {
+		if !rangesContain(ranges, r) {
+			t.Fatalf("generated width data does not include %U as double-width; output:\n%s", r, out.String())
+		}
+	}
+	if rangesContain(ranges, 0x0041) {
+		t.Fatalf("generated width data unexpectedly includes narrow rune U+0041; output:\n%s", out.String())
+	}
+}
+
+type generatedRange struct {
+	lo rune
+	hi rune
+}
+
+func parseGeneratedRanges(t *testing.T, generated string) []generatedRange {
+	t.Helper()
+
+	re := regexp.MustCompile(`\{\s*0x([0-9a-fA-F]+)\s*,\s*0x([0-9a-fA-F]+)\s*\}`)
+	matches := re.FindAllStringSubmatch(generated, -1)
+	if len(matches) == 0 {
+		t.Fatalf("no generated ranges found in output:\n%s", generated)
+	}
+
+	ranges := make([]generatedRange, 0, len(matches))
+	for _, m := range matches {
+		lo, err := strconv.ParseInt(m[1], 16, 32)
+		if err != nil {
+			t.Fatalf("failed to parse generated range lower bound %q: %v", m[1], err)
+		}
+		hi, err := strconv.ParseInt(m[2], 16, 32)
+		if err != nil {
+			t.Fatalf("failed to parse generated range upper bound %q: %v", m[2], err)
+		}
+		ranges = append(ranges, generatedRange{lo: rune(lo), hi: rune(hi)})
+	}
+	return ranges
+}
+
+func rangesContain(ranges []generatedRange, r rune) bool {
+	for _, rg := range ranges {
+		if rg.lo <= r && r <= rg.hi {
+			return true
+		}
+	}
+	return false
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,35 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+
+
+case "${1:-}" in
+  base)
+    base_tests='^(TestIsEastAsian|TestIsEastAsianLCCTYPE|TestIsEastAsianLANG|TestSorted|TestRuneWidth|TestIsAmbiguousWidth|TestStringWidth|TestStringWidthInvalid|TestTruncateSmaller|TestTruncate|TestTruncateFit|TestTruncateJustFit|TestWrap|TestTruncateNoNeeded|TestIsNeutralWidth|TestFillLeft|TestFillLeftFit|TestFillRight|TestFillRightFit|TestEnv|TestZeroWidthJointer)$'
+    go test -v -run "$base_tests" .
+    root_rc=$?
+    go test -v -run '^$' ./script
+    script_rc=$?
+    if [ "$root_rc" -ne 0 ]; then
+      exit "$root_rc"
+    fi
+    exit "$script_rc"
+    ;;
+  new)
+    go test -v -run 'TestFullwidthRunesHaveWidthTwo|TestFullwidthStringWidthAggregatesPerRune' .
+    root_rc=$?
+    go test -v -run 'TestGeneratedWidthDataIncludesFullwidthRecords' ./script
+    script_rc=$?
+    if [ "$root_rc" -ne 0 ]; then
+      exit "$root_rc"
+    fi
+    exit "$script_rc"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
