diff --git a/core/tests/window/test_window_lifecycle.py b/core/tests/window/test_window_lifecycle.py
new file mode 100644
index 000000000..48a8679f7
--- /dev/null
+++ b/core/tests/window/test_window_lifecycle.py
@@ -0,0 +1,228 @@
+from unittest.mock import Mock
+
+import pytest
+
+import toga
+from toga.constants import WindowState
+
+
+def test_lifecycle_handlers_default(window):
+
+    for name in ("on_gain_focus", "on_lose_focus", "on_show", "on_hide"):
+        handler = getattr(window, name)
+        assert callable(handler)
+        assert handler._raw is None
+
+
+def test_lifecycle_handlers_constructor():
+
+    on_gain_focus = Mock()
+    on_lose_focus = Mock()
+    on_show = Mock()
+    on_hide = Mock()
+
+    window = toga.Window(
+        on_gain_focus=on_gain_focus,
+        on_lose_focus=on_lose_focus,
+        on_show=on_show,
+        on_hide=on_hide,
+    )
+
+    assert window.on_gain_focus._raw == on_gain_focus
+    assert window.on_lose_focus._raw == on_lose_focus
+    assert window.on_show._raw == on_show
+    assert window.on_hide._raw == on_hide
+
+
+def test_lifecycle_handlers_property(window):
+
+    on_gain_focus = Mock()
+    on_lose_focus = Mock()
+    on_show = Mock()
+    on_hide = Mock()
+
+    window.on_gain_focus = on_gain_focus
+    window.on_lose_focus = on_lose_focus
+    window.on_show = on_show
+    window.on_hide = on_hide
+
+    assert window.on_gain_focus._raw == on_gain_focus
+    assert window.on_lose_focus._raw == on_lose_focus
+    assert window.on_show._raw == on_show
+    assert window.on_hide._raw == on_hide
+
+
+def test_on_show_hide_via_methods(window):
+
+    on_show = Mock()
+    on_hide = Mock()
+    window.on_show = on_show
+    window.on_hide = on_hide
+
+
+    window.show()
+    on_show.assert_called_once_with(window)
+    on_hide.assert_not_called()
+
+    on_show.reset_mock()
+
+
+    window.show()
+    on_show.assert_not_called()
+    on_hide.assert_not_called()
+
+
+    window.hide()
+    on_hide.assert_called_once_with(window)
+    on_show.assert_not_called()
+
+    on_hide.reset_mock()
+
+
+    window.hide()
+    on_hide.assert_not_called()
+    on_show.assert_not_called()
+
+
+def test_on_show_hide_via_visible_property(window):
+
+    on_show = Mock()
+    on_hide = Mock()
+    window.on_show = on_show
+    window.on_hide = on_hide
+
+    window.visible = True
+    on_show.assert_called_once_with(window)
+    on_hide.assert_not_called()
+
+    on_show.reset_mock()
+
+    window.visible = False
+    on_hide.assert_called_once_with(window)
+    on_show.assert_not_called()
+
+
+def test_on_hide_show_on_minimize_restore(window):
+
+    on_show = Mock()
+    on_hide = Mock()
+    window.on_show = on_show
+    window.on_hide = on_hide
+
+    window.show()
+    on_show.reset_mock()
+    on_hide.reset_mock()
+
+
+    window.state = WindowState.MINIMIZED
+    on_hide.assert_called_once_with(window)
+    on_show.assert_not_called()
+
+    on_hide.reset_mock()
+
+
+    window.state = WindowState.NORMAL
+    on_show.assert_called_once_with(window)
+    on_hide.assert_not_called()
+
+
+def test_minimize_no_op_does_not_fire(window):
+
+    on_show = Mock()
+    on_hide = Mock()
+    window.on_show = on_show
+    window.on_hide = on_hide
+
+    window.show()
+    window.state = WindowState.MINIMIZED
+    on_show.reset_mock()
+    on_hide.reset_mock()
+
+
+    window.state = WindowState.MINIMIZED
+    on_show.assert_not_called()
+    on_hide.assert_not_called()
+
+
+@pytest.mark.parametrize(
+    "other_state",
+    [
+        WindowState.MAXIMIZED,
+        WindowState.FULLSCREEN,
+        WindowState.PRESENTATION,
+    ],
+)
+def test_non_minimize_state_change_does_not_fire(window, other_state):
+
+    on_show = Mock()
+    on_hide = Mock()
+    window.on_show = on_show
+    window.on_hide = on_hide
+
+    window.show()
+    on_show.reset_mock()
+    on_hide.reset_mock()
+
+    window.state = other_state
+    on_show.assert_not_called()
+    on_hide.assert_not_called()
+
+
+def test_focus_handlers_on_current_window_change(app):
+
+    main_window = app.main_window
+
+    main_on_lose = Mock()
+    main_on_gain = Mock()
+    main_window.on_lose_focus = main_on_lose
+    main_window.on_gain_focus = main_on_gain
+
+    other_on_lose = Mock()
+    other_on_gain = Mock()
+    other_window = toga.Window(
+        on_lose_focus=other_on_lose,
+        on_gain_focus=other_on_gain,
+    )
+
+
+
+    app.current_window = other_window
+    main_on_lose.assert_called_once_with(main_window)
+    other_on_gain.assert_called_once_with(other_window)
+    main_on_gain.assert_not_called()
+    other_on_lose.assert_not_called()
+
+    main_on_lose.reset_mock()
+    other_on_gain.reset_mock()
+
+
+    app.current_window = main_window
+    other_on_lose.assert_called_once_with(other_window)
+    main_on_gain.assert_called_once_with(main_window)
+    other_on_gain.assert_not_called()
+    main_on_lose.assert_not_called()
+
+
+def test_focus_no_op_does_not_fire(app):
+
+    main_window = app.main_window
+
+    main_on_lose = Mock()
+    main_on_gain = Mock()
+    main_window.on_lose_focus = main_on_lose
+    main_window.on_gain_focus = main_on_gain
+
+    app.current_window = main_window
+    main_on_lose.assert_not_called()
+    main_on_gain.assert_not_called()
+
+
+def test_lifecycle_handlers_do_not_disturb_on_close(window):
+
+    on_close = Mock(return_value=True)
+    window.on_close = on_close
+    assert window.on_close._raw == on_close
+
+
+    other = toga.Window()
+    assert other.on_close._raw is None
