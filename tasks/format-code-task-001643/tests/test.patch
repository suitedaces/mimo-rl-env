+
+func TestStopBoundsGoroutinesAndFileDescriptorsAcrossManyCycles(t *testing.T) {
+
+
+	resetGPSPath(t)
+	writeGPSFile(t, `{"latitude":0.25,"longitude":0.5,"speed":0.75,"accuracy":1.25}`, time.Now())
+
+	runtime.GC()
+	beforeGoroutines := runtime.NumGoroutine()
+	beforeFDs := countFDs(t)
+
+	for i := 0; i < 120; i++ {
+		p := location.NewTermuxLocationProvider(testLogger())
+		waitForAvailable(t, p)
+		p.Stop()
+	}
+
+	deadline := time.Now().Add(2 * time.Second)
+	var afterGoroutines int
+	for time.Now().Before(deadline) {
+		runtime.GC()
+		afterGoroutines = runtime.NumGoroutine()
+		if afterGoroutines <= beforeGoroutines+10 {
+			break
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	afterFDs := countFDs(t)
+	if afterGoroutines > beforeGoroutines+10 {
+		t.Fatalf("goroutines after cycles = %d, want <= %d", afterGoroutines, beforeGoroutines+10)
+	}
+	if afterFDs > beforeFDs+10 {
+		t.Fatalf("fds after cycles = %d, want <= %d", afterFDs, beforeFDs+10)
+	}
+}
+
+func countFDs(t *testing.T) int {
+	t.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		t.Fatalf("read /proc/self/fd: %v", err)
+	}
+	return len(entries)
+}
