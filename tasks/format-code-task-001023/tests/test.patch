--- /dev/null
+++ b/tests/codespec_boot_argument_provenance_test.py
@@ -0,0 +1,159 @@
+
+
+import unittest
+
+from pyanaconda.argument_parsing import AnacondaArgumentParser
+from pyanaconda.core.kernel import KernelArguments
+
+
+class BootArgumentProvenanceTestCase(unittest.TestCase):
+
+    @staticmethod
+    def _make_parser(require_prefix):
+        parser = AnacondaArgumentParser(
+            prog="boot-argument-test",
+            add_help=False,
+            bootarg_prefix="inst.",
+            require_prefix=require_prefix,
+        )
+        parser.add_argument("--stage2", default=None)
+        parser.add_argument("--vnc", action="store_true", default=False)
+        parser.add_argument("--addrepo", action="append", default=[])
+        return parser
+
+    def test_raw_occurrences_and_normalized_view(self):
+        arguments = KernelArguments.from_string(
+            "inst.stage2=first stage2=legacy inst.stage2=last "
+            "inst.addrepo=one addrepo=old inst.addrepo=two "
+            "modprobe.blacklist=floppy "
+            "inst.modprobe.blacklist=nouveau modprobe.blacklist=firewire"
+        )
+
+        self.assertEqual(
+            list(arguments.items_raw()),
+            [
+                ("inst.stage2", "first"),
+                ("stage2", "legacy"),
+                ("inst.stage2", "last"),
+                ("inst.addrepo", "one"),
+                ("addrepo", "old"),
+                ("inst.addrepo", "two"),
+                ("modprobe.blacklist", "floppy"),
+                ("inst.modprobe.blacklist", "nouveau"),
+                ("modprobe.blacklist", "firewire"),
+            ],
+        )
+        self.assertEqual(arguments.get("stage2"), "last")
+        self.assertEqual(arguments.get("addrepo"), ["one", "old", "two"])
+        self.assertEqual(
+            arguments.get("modprobe.blacklist"),
+            "floppy nouveau firewire",
+        )
+        self.assertEqual(
+            dict(arguments.items()),
+            {
+                "stage2": "last",
+                "addrepo": ["one", "old", "two"],
+                "modprobe.blacklist": "floppy nouveau firewire",
+            },
+        )
+
+    def test_required_prefix_filters_each_occurrence(self):
+        parser = self._make_parser(require_prefix=True)
+        options = parser.parse_boot_cmdline(
+            KernelArguments.from_string(
+                "inst.stage2=trusted stage2=legacy stage2=last "
+                "inst.vnc vnc=off"
+            )
+        )
+
+        self.assertEqual(options.stage2, "trusted")
+        self.assertTrue(options.vnc)
+        self.assertEqual(
+            parser.removed_no_inst_bootargs,
+            ["stage2", "stage2", "vnc"],
+        )
+
+        parser = self._make_parser(require_prefix=True)
+        options = parser.parse_boot_cmdline(
+            KernelArguments.from_string(
+                "stage2=legacy inst.stage2=first inst.stage2=last"
+            )
+        )
+        self.assertEqual(options.stage2, "last")
+        self.assertEqual(parser.removed_no_inst_bootargs, ["stage2"])
+
+    def test_optional_prefix_uses_original_occurrence_order(self):
+        parser = self._make_parser(require_prefix=False)
+        options = parser.parse_boot_cmdline(
+            KernelArguments.from_string(
+                "inst.stage2=first stage2=second inst.stage2=third"
+            )
+        )
+        self.assertEqual(options.stage2, "third")
+
+        parser = self._make_parser(require_prefix=False)
+        options = parser.parse_boot_cmdline(
+            KernelArguments.from_string("inst.stage2=first stage2=second")
+        )
+        self.assertEqual(options.stage2, "second")
+        self.assertEqual(parser.removed_no_inst_bootargs, ["stage2"])
+
+    def test_list_options_keep_only_accepted_values_in_order(self):
+        boot_arguments = KernelArguments.from_string(
+            "addrepo=legacy-a inst.addrepo=trusted-a "
+            "addrepo=legacy-b inst.addrepo=trusted-b"
+        )
+
+        strict_parser = self._make_parser(require_prefix=True)
+        strict_options = strict_parser.parse_boot_cmdline(boot_arguments)
+        self.assertEqual(strict_options.addrepo, ["trusted-a", "trusted-b"])
+        self.assertEqual(
+            strict_parser.removed_no_inst_bootargs,
+            ["addrepo", "addrepo"],
+        )
+
+        compatible_parser = self._make_parser(require_prefix=False)
+        compatible_options = compatible_parser.parse_boot_cmdline(boot_arguments)
+        self.assertEqual(
+            compatible_options.addrepo,
+            ["legacy-a", "trusted-a", "legacy-b", "trusted-b"],
+        )
+
+    def test_documented_mapping_input_obeys_the_same_rules(self):
+        parser = self._make_parser(require_prefix=True)
+        boot_arguments = {
+            "stage2": "legacy",
+            "inst.stage2": "trusted",
+            "inst.addrepo": ["one", "two"],
+            "addrepo": ["old-one", "old-two"],
+        }
+
+        try:
+            options = parser.parse_boot_cmdline(boot_arguments)
+        except AttributeError as error:
+            self.fail("parse_boot_cmdline must accept plain mappings: {}".format(error))
+
+        self.assertEqual(options.stage2, "trusted")
+        self.assertEqual(options.addrepo, ["one", "two"])
+        self.assertEqual(
+            parser.removed_no_inst_bootargs,
+            ["stage2", "addrepo"],
+        )
+        self.assertEqual(
+            boot_arguments["inst.addrepo"],
+            ["one", "two"],
+        )
+
+    def test_program_arguments_still_override_boot_scalars(self):
+        parser = self._make_parser(require_prefix=True)
+        options = parser.parse_args(
+            ["--stage2=from-program"],
+            boot_cmdline=KernelArguments.from_string("inst.stage2=from-boot"),
+        )
+
+        self.assertEqual(options.stage2, "from-program")
+
+
+if __name__ == "__main__":
+    unittest.main()
