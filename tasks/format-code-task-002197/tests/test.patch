diff --git a/pandas/tests/reshape/test_merge.py b/pandas/tests/reshape/test_merge.py
index d3257243d7..a015e8e2a6 100644
--- a/pandas/tests/reshape/test_merge.py
+++ b/pandas/tests/reshape/test_merge.py
@@ -1403,3 +1403,142 @@ class TestMergeOnIndexes(object):
                           how=how,
                           sort=sort)
         tm.assert_frame_equal(result, expected)
+
+
+class TestMergeValidate(object):
+
+    def setup_method(self, method):
+        self.left_unique = DataFrame({'a': [1, 2, 3, 4],
+                                      'left_val': [10, 20, 30, 40]})
+        self.right_unique = DataFrame({'a': [1, 2, 3, 4],
+                                       'right_val': [100, 200, 300, 400]})
+        self.left_dup = DataFrame({'a': [1, 1, 2, 3],
+                                   'left_val': [10, 11, 20, 30]})
+        self.right_dup = DataFrame({'a': [1, 2, 2, 3],
+                                    'right_val': [100, 200, 201, 300]})
+
+    def test_validate_one_to_one_passes(self):
+        result = pd.merge(self.left_unique, self.right_unique,
+                          on='a', validate='one_to_one')
+        assert len(result) == 4
+        assert list(result['a']) == [1, 2, 3, 4]
+
+    def test_validate_one_to_one_raises_left_dup(self):
+        with pytest.raises(ValueError) as excinfo:
+            pd.merge(self.left_dup, self.right_unique,
+                     on='a', validate='one_to_one')
+        msg = str(excinfo.value).lower()
+        assert 'left' in msg
+
+    def test_validate_one_to_one_raises_right_dup(self):
+        with pytest.raises(ValueError) as excinfo:
+            pd.merge(self.left_unique, self.right_dup,
+                     on='a', validate='one_to_one')
+        msg = str(excinfo.value).lower()
+        assert 'right' in msg
+
+    def test_validate_one_to_many_passes_when_left_unique(self):
+
+        result = pd.merge(self.left_unique, self.right_dup,
+                          on='a', validate='one_to_many')
+        assert len(result) == 4
+
+    def test_validate_one_to_many_raises_left_dup(self):
+        with pytest.raises(ValueError) as excinfo:
+            pd.merge(self.left_dup, self.right_unique,
+                     on='a', validate='one_to_many')
+        msg = str(excinfo.value).lower()
+        assert 'left' in msg
+
+    def test_validate_many_to_one_passes_when_right_unique(self):
+
+        result = pd.merge(self.left_dup, self.right_unique,
+                          on='a', validate='many_to_one')
+        assert len(result) == 4
+
+    def test_validate_many_to_one_raises_right_dup(self):
+        with pytest.raises(ValueError) as excinfo:
+            pd.merge(self.left_unique, self.right_dup,
+                     on='a', validate='many_to_one')
+        msg = str(excinfo.value).lower()
+        assert 'right' in msg
+
+    def test_validate_many_to_many_passes_with_dups(self):
+
+        result = pd.merge(self.left_dup, self.right_dup,
+                          on='a', validate='many_to_many')
+
+        assert isinstance(result, DataFrame)
+
+    def test_validate_short_alias_1_to_1_passes(self):
+        result = pd.merge(self.left_unique, self.right_unique,
+                          on='a', validate='1:1')
+        assert len(result) == 4
+
+    def test_validate_short_alias_1_to_1_raises(self):
+        with pytest.raises(ValueError):
+            pd.merge(self.left_dup, self.right_unique,
+                     on='a', validate='1:1')
+
+    def test_validate_short_alias_1_to_m_raises_left_dup(self):
+        with pytest.raises(ValueError):
+            pd.merge(self.left_dup, self.right_unique,
+                     on='a', validate='1:m')
+
+    def test_validate_short_alias_m_to_1_raises_right_dup(self):
+        with pytest.raises(ValueError):
+            pd.merge(self.left_unique, self.right_dup,
+                     on='a', validate='m:1')
+
+    def test_validate_short_alias_m_to_m_passes(self):
+        result = pd.merge(self.left_dup, self.right_dup,
+                          on='a', validate='m:m')
+        assert isinstance(result, DataFrame)
+
+    def test_validate_invalid_string_raises(self):
+        with pytest.raises(ValueError):
+            pd.merge(self.left_unique, self.right_unique,
+                     on='a', validate='jibberish')
+
+    def test_validate_default_none_no_check(self):
+
+        result = pd.merge(self.left_dup, self.right_dup, on='a')
+        assert isinstance(result, DataFrame)
+
+    def test_validate_via_dataframe_method(self):
+
+        with pytest.raises(ValueError):
+            self.left_dup.merge(self.right_unique,
+                                on='a', validate='one_to_one')
+
+        result = self.left_unique.merge(self.right_unique,
+                                        on='a', validate='one_to_one')
+        assert len(result) == 4
+
+    def test_validate_multi_key_combination_unique(self):
+
+
+
+        left = DataFrame({'a': [1, 1, 2, 2],
+                          'b': [1, 2, 1, 2],
+                          'left_val': [10, 11, 12, 13]})
+        right = DataFrame({'a': [1, 1, 2, 2],
+                           'b': [1, 2, 1, 2],
+                           'right_val': [20, 21, 22, 23]})
+        result = pd.merge(left, right, on=['a', 'b'], validate='one_to_one')
+        assert len(result) == 4
+
+    def test_validate_with_left_index_right_index(self):
+
+        left = DataFrame({'left_val': [10, 20, 30]}, index=[1, 2, 3])
+        right = DataFrame({'right_val': [100, 200, 300]}, index=[1, 2, 3])
+        result = pd.merge(left, right, left_index=True, right_index=True,
+                          validate='one_to_one')
+        assert len(result) == 3
+
+
+        right_dup_idx = DataFrame({'right_val': [100, 101, 200, 300]},
+                                  index=[1, 1, 2, 3])
+        with pytest.raises(ValueError):
+            pd.merge(left, right_dup_idx, left_index=True, right_index=True,
+                     validate='one_to_one')
