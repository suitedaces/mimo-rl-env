diff --git a/tests/dialects/test_duckdb.py b/tests/dialects/test_duckdb.py
index 22d25f7ef..c135cb67e 100644
--- a/tests/dialects/test_duckdb.py
+++ b/tests/dialects/test_duckdb.py
@@ -1900,3 +1900,67 @@ class TestDuckDB(Validator):
         self.validate_identity(
             "WITH RECURSIVE tbl(a, b) USING KEY (a, b) AS (SELECT a, b FROM (VALUES (1, 3), (2, 4)) AS t(a, b) UNION SELECT a + 1, b FROM tbl WHERE a < 3) SELECT * FROM tbl"
         )
+
+    def test_values_with_query_modifiers(self):
+        def _parse_and_reparse(sql):
+
+
+
+
+            expr = parse_one(sql, dialect="duckdb")
+            out = expr.sql(dialect="duckdb")
+
+
+
+            parse_one(out, dialect="duckdb")
+            return expr, out
+
+
+        issue_sql = "SELECT 1 FROM ( SELECT 1 ) t( c ) WHERE ( ( VALUES(1), (c) LIMIT 1 ) INTERSECT ( SELECT 1 ) );"
+        expr, out = _parse_and_reparse(issue_sql)
+
+
+        self.assertIsNotNone(expr.find(exp.Limit))
+
+
+
+
+        expr, _ = _parse_and_reparse("(VALUES (1), (2) LIMIT 1) UNION (SELECT 3)")
+        self.assertIsNotNone(expr.find(exp.Limit))
+
+
+        expr, _ = _parse_and_reparse(
+            "(VALUES (1), (2), (3) ORDER BY 1 DESC) UNION (SELECT 4)"
+        )
+        self.assertIsNotNone(expr.find(exp.Order))
+
+
+        expr, _ = _parse_and_reparse(
+            "(VALUES (1), (2), (3) OFFSET 1) UNION (SELECT 4)"
+        )
+        self.assertIsNotNone(expr.find(exp.Offset))
+
+
+
+        expr, _ = _parse_and_reparse(
+            "(VALUES (1), (2), (3) ORDER BY 1 DESC LIMIT 2 OFFSET 1) UNION (SELECT 0)"
+        )
+        self.assertIsNotNone(expr.find(exp.Order))
+        self.assertIsNotNone(expr.find(exp.Limit))
+        self.assertIsNotNone(expr.find(exp.Offset))
+
+
+
+        expr, _ = _parse_and_reparse(
+            "(VALUES (1), (2), (3) ORDER BY 1 DESC LIMIT 2 OFFSET 1)"
+        )
+        limit_node = expr.find(exp.Limit)
+        offset_node = expr.find(exp.Offset)
+        self.assertIsNotNone(limit_node)
+        self.assertIsNotNone(offset_node)
+        self.assertEqual(limit_node.expression.sql(dialect="duckdb"), "2")
+        self.assertEqual(offset_node.expression.sql(dialect="duckdb"), "1")
+
+
+
+        self.validate_identity("(VALUES (1), (2)) UNION (SELECT 3)")
