+#!/bin/bash
+set -euo pipefail
+
+
+export PYTHONPATH="${PWD}${PYTHONPATH:+:${PYTHONPATH}}"
+PYDP_BUNDLED_LIBS=/usr/local/lib/python3.14/dist-packages/python_dp.libs
+test -d "${PYDP_BUNDLED_LIBS}"
+export LD_LIBRARY_PATH="${PYDP_BUNDLED_LIBS}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
+pytest -q tests/algorithms/test_laplacian_batch_stream_contract.py
