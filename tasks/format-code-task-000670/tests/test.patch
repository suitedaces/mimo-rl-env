+import pathlib
+
+from pympress.document import Document, PdfPage
+
+
+def _pdf_string(text):
+    escaped = text.replace("\\", "\\\\").replace("(", "\\(").replace(")", "\\)")
+    return f"({escaped})"
+
+
+def _write_pdf(path, pages, labels=None):
+
+    objects = [None, None]
+    page_object_ids = []
+
+    for width, height in pages:
+        content = b"q\n1 1 1 rg\n0 0 10 10 re f\nQ\n"
+        content_id = len(objects) + 1
+        objects.append(
+            f"<< /Length {len(content)} >>\nstream\n".encode("ascii")
+            + content
+            + b"endstream"
+        )
+
+        page_id = len(objects) + 1
+        objects.append(
+            f"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 {width:g} {height:g}] "
+            f"/Contents {content_id} 0 R /Resources << >> >>"
+        )
+        page_object_ids.append(page_id)
+
+    label_id = None
+    if labels:
+        label_id = len(objects) + 1
+        nums = " ".join(
+            f"{page_index} << /P {_pdf_string(label)} >>"
+            for page_index, label in labels.items()
+        )
+        objects.append(f"<< /Nums [ {nums} ] >>")
+
+    objects[1] = (
+        f"<< /Type /Pages /Count {len(page_object_ids)} /Kids ["
+        + " ".join(f"{page_id} 0 R" for page_id in page_object_ids)
+        + "] >>"
+    )
+    objects[0] = (
+        "<< /Type /Catalog /Pages 2 0 R"
+        + (f" /PageLabels {label_id} 0 R" if label_id else "")
+        + " >>"
+    )
+
+    pdf = bytearray(b"%PDF-1.4\n%\xe2\xe3\xcf\xd3\n")
+    offsets = []
+    for object_id, obj in enumerate(objects, start=1):
+        offsets.append(len(pdf))
+        if isinstance(obj, str):
+            obj = obj.encode("utf-8")
+        pdf += f"{object_id} 0 obj\n".encode("ascii") + obj + b"\nendobj\n"
+
+    xref_offset = len(pdf)
+    pdf += f"xref\n0 {len(objects) + 1}\n0000000000 65535 f \n".encode("ascii")
+    for offset in offsets:
+        pdf += f"{offset:010d} 00000 n \n".encode("ascii")
+    pdf += (
+        f"trailer\n<< /Size {len(objects) + 1} /Root 1 0 R >>\n"
+        f"startxref\n{xref_offset}\n%%EOF\n"
+    ).encode("ascii")
+
+    pathlib.Path(path).write_bytes(pdf)
+
+
+def _document(tmp_path, filename, pages, labels=None):
+    path = tmp_path / filename
+    _write_pdf(path, pages, labels)
+    return Document.create(None, path.as_uri())
+
+
+def _notes_mapping_snapshot(doc):
+    if doc.notes_mapping is None:
+        return None
+    return list(doc.notes_mapping)
+
+
+def test_notes_prefix_label_selects_mapping_mode_without_mutating_state(tmp_path):
+
+
+
+    doc = _document(
+        tmp_path,
+        "labels-map.pdf",
+        [(100, 100), (100, 100)],
+        labels={0: "slide", 1: "notes:"},
+    )
+
+    assert doc.nb_pages == 2
+    assert doc.pages_number() == 2
+    assert doc.page_labels == ["slide", "notes:"]
+    assert doc.notes_mapping is None
+
+    before_mapping = _notes_mapping_snapshot(doc)
+    assert doc.guess_notes("left", "top", 0) is PdfPage.MAP
+
+    assert _notes_mapping_snapshot(doc) == before_mapping
+
+
+def test_unrenderable_or_unresolved_current_page_returns_none(tmp_path):
+
+
+
+    empty_doc = Document.create(None, None)
+    assert empty_doc.pages_number() == 0
+    assert empty_doc.page_labels == []
+    assert empty_doc.notes_mapping is None
+    empty_mapping = _notes_mapping_snapshot(empty_doc)
+    assert empty_doc.guess_notes("left", "top", 0) is PdfPage.NONE
+
+    assert _notes_mapping_snapshot(empty_doc) == empty_mapping
+
+    doc = _document(tmp_path, "ordinary-one-page.pdf", [(160, 90)])
+    assert doc.nb_pages == 1
+    assert doc.pages_number() == 1
+    assert doc.page_labels == ["1"]
+    assert doc.notes_mapping is None
+    before_mapping = _notes_mapping_snapshot(doc)
+    assert doc.guess_notes("left", "top", 99) is PdfPage.NONE
+
+    assert _notes_mapping_snapshot(doc) == before_mapping
+
+
+def test_even_document_with_two_uniform_aspect_ratio_halves_selects_after(tmp_path):
+
+
+
+    doc = _document(
+        tmp_path,
+        "libreoffice-after.pdf",
+        [(160, 90), (160, 90), (100, 100), (100, 100)],
+    )
+
+    assert doc.nb_pages == 4
+    assert doc.pages_number() == 4
+    assert doc.page_labels == ["1", "2", "3", "4"]
+    assert doc.notes_mapping is None
+    assert round(doc.page(0).get_aspect_ratio(), 12) == 1.777777777778
+    assert round(doc.page(2).get_aspect_ratio(), 12) == 1.0
+
+    before_mapping = _notes_mapping_snapshot(doc)
+    assert doc.guess_notes("left", "top", 0) is PdfPage.AFTER
+
+    assert _notes_mapping_snapshot(doc) == before_mapping
+
+
+def test_wide_current_page_uses_horizontal_preference_and_right_fallback(tmp_path):
+
+
+
+    doc = _document(tmp_path, "wide-side-notes.pdf", [(200, 100)])
+
+    assert doc.nb_pages == 1
+    assert doc.pages_number() == 1
+    assert doc.page_labels == ["1"]
+    assert doc.notes_mapping is None
+    assert doc.page(0).get_aspect_ratio() == 2.0
+
+    before_mapping = _notes_mapping_snapshot(doc)
+    assert doc.guess_notes("LeFt", "top", 0) is PdfPage.LEFT
+
+    assert _notes_mapping_snapshot(doc) == before_mapping
+
+    assert doc.guess_notes("sideways", "top", 0) is PdfPage.RIGHT
+
+    assert _notes_mapping_snapshot(doc) == before_mapping
+
+
+def test_paper_ratios_are_not_detected_as_vertical_notes(tmp_path):
+
+
+
+    letter = _document(tmp_path, "letter.pdf", [(85, 110)])
+    iso = _document(tmp_path, "iso.pdf", [(100, 141.4213562373095)])
+
+    assert letter.nb_pages == 1
+    assert letter.page_labels == ["1"]
+    assert letter.notes_mapping is None
+    letter_mapping = _notes_mapping_snapshot(letter)
+    assert letter.guess_notes("left", "top", 0) is PdfPage.NONE
+
+    assert _notes_mapping_snapshot(letter) == letter_mapping
+
+    assert iso.nb_pages == 1
+    assert iso.page_labels == ["1"]
+    assert iso.notes_mapping is None
+    iso_mapping = _notes_mapping_snapshot(iso)
+    assert iso.guess_notes("left", "top", 0) is PdfPage.NONE
+
+    assert _notes_mapping_snapshot(iso) == iso_mapping
+
+
+def test_tall_current_page_uses_vertical_preference_and_bottom_fallback(tmp_path):
+
+
+
+    doc = _document(tmp_path, "tall-bottom-notes.pdf", [(70, 100)])
+
+    assert doc.nb_pages == 1
+    assert doc.pages_number() == 1
+    assert doc.page_labels == ["1"]
+    assert doc.notes_mapping is None
+    assert doc.page(0).get_aspect_ratio() == 0.7
+
+    before_mapping = _notes_mapping_snapshot(doc)
+    assert doc.guess_notes("left", "tOp", 0) is PdfPage.TOP
+
+    assert _notes_mapping_snapshot(doc) == before_mapping
+
+    assert doc.guess_notes("left", "upward", 0) is PdfPage.BOTTOM
+
+    assert _notes_mapping_snapshot(doc) == before_mapping
+
+
+def test_ordinary_slide_ratio_returns_none(tmp_path):
+
+
+
+    doc = _document(tmp_path, "ordinary-slide.pdf", [(160, 90)])
+
+    assert doc.nb_pages == 1
+    assert doc.pages_number() == 1
+    assert doc.page_labels == ["1"]
+    assert doc.notes_mapping is None
+    assert round(doc.page(0).get_aspect_ratio(), 12) == 1.777777777778
+
+    before_mapping = _notes_mapping_snapshot(doc)
+    assert doc.guess_notes("left", "top", 0) is PdfPage.NONE
+
+    assert _notes_mapping_snapshot(doc) == before_mapping
+
+
+def test_existing_notes_mapping_is_preserved(tmp_path):
+
+
+
+    doc = _document(tmp_path, "mapped-odd-document.pdf", [(160, 90), (160, 90), (160, 90)])
+
+    before_mapping = _notes_mapping_snapshot(doc)
+    assert doc.guess_notes("left", "top", 0) is PdfPage.NONE
+
+    assert _notes_mapping_snapshot(doc) == before_mapping
+
+    doc.set_notes_pos(PdfPage.ODD.direction())
+    existing_mapping = _notes_mapping_snapshot(doc)
+
+    assert existing_mapping
+
+    assert doc.guess_notes("left", "top", 0) is PdfPage.NONE
+
+    assert _notes_mapping_snapshot(doc) == existing_mapping
+
+
+def test_guess_notes_state_is_independent_between_document_instances(tmp_path):
+
+
+
+    mapped = _document(tmp_path, "first.pdf", [(160, 90), (160, 90), (160, 90)])
+    tall = _document(tmp_path, "second.pdf", [(70, 100)])
+
+    mapped.set_notes_pos(PdfPage.ODD.direction())
+    mapped_mapping = _notes_mapping_snapshot(mapped)
+    assert mapped.guess_notes("left", "top", 0) is PdfPage.NONE
+
+    assert _notes_mapping_snapshot(mapped) == mapped_mapping
+
+    tall_mapping = _notes_mapping_snapshot(tall)
+    assert tall.guess_notes("left", "top", 0) is PdfPage.TOP
+
+    assert _notes_mapping_snapshot(tall) == tall_mapping
+
+
+def test_repeated_public_document_sessions_keep_guessing_wide_pages(tmp_path):
+
+
+
+    pdf_path = tmp_path / "fd-floor.pdf"
+    _write_pdf(pdf_path, [(200, 100)])
+    uri = pdf_path.as_uri()
+
+    for _ in range(120):
+        doc = Document.create(None, uri)
+        assert doc.nb_pages == 1
+        before_mapping = _notes_mapping_snapshot(doc)
+        assert doc.guess_notes("left", "top", 0) is PdfPage.LEFT
+
+        assert _notes_mapping_snapshot(doc) == before_mapping
