+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+python3 -m pip install -e . >/tmp/fixturea_pip_install.log 2>&1
+if [ $? -ne 0 ]; then
+  cat /tmp/fixturea_pip_install.log
+  exit 1
+fi
+
+case "$1" in
+  base)
+    python3 -m pytest tests/hf/test_hamiltonians.py -v \
+      -k 'not (test_simplify_is_public_and_returns_hamiltonian or test_simplify_combines_duplicate_pauli_words or test_simplify_combines_multiple_duplicate_groups_without_order_dependence or test_simplify_drops_terms_cancelled_by_combination or test_simplify_drops_terms_at_or_below_custom_cutoff or test_simplify_respects_custom_cutoff_boundary or test_simplify_applies_cutoff_after_combining_duplicates or test_hf_hamiltonian_result_has_no_duplicate_pauli_words or test_hf_hamiltonian_respects_cutoff_for_small_terms)'
+    ;;
+  new)
+    python3 -m pytest tests/hf/test_hamiltonians.py -v \
+      -k 'test_simplify_is_public_and_returns_hamiltonian or test_simplify_combines_duplicate_pauli_words or test_simplify_combines_multiple_duplicate_groups_without_order_dependence or test_simplify_drops_terms_cancelled_by_combination or test_simplify_drops_terms_at_or_below_custom_cutoff or test_simplify_respects_custom_cutoff_boundary or test_simplify_applies_cutoff_after_combining_duplicates or test_hf_hamiltonian_result_has_no_duplicate_pauli_words or test_hf_hamiltonian_respects_cutoff_for_small_terms'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
