+func TestExecuteCommandRejectsDisallowedBeforeOpeningSession(t *testing.T) {
+
+
+	srv, host := newDashboardSSHServer(t, func(_ int32, cmd string) commandResult {
+		return commandResult{output: "should not run " + cmd + "\n"}
+	})
+
+	client, err := dashboard.NewSSHClient(host)
+	if err != nil {
+		t.Fatalf("NewSSHClient() error: %v", err)
+	}
+	defer client.Close()
+
+	out, err := client.ExecuteCommand("  uname -a  ")
+	if out != "" {
+		t.Fatalf("ExecuteCommand(uname) output = %q, want empty string", out)
+	}
+	if err == nil {
+		t.Fatal("ExecuteCommand(uname) error = nil, want allowlist error")
+	}
+	if err.Error() != "command not in allowed list:   uname -a  " {
+		t.Fatalf("ExecuteCommand(uname) error = %q, want %q", err.Error(), "command not in allowed list:   uname -a  ")
+	}
+	if got := srv.sessionCount.Load(); got != 0 {
+		t.Fatalf("server session count = %d, want 0", got)
+	}
+	if got := srv.commands(); len(got) != 0 {
+		t.Fatalf("server commands = %#v, want empty list", got)
+	}
+}
