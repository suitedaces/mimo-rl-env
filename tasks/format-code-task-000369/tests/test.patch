+func TestSSHClientsUseIndependentConnections(t *testing.T) {
+
+
+	_, host := newDashboardSSHServer(t, func(connID int32, cmd string) commandResult {
+		return commandResult{output: fmt.Sprintf("conn=%d command=%s\n", connID, cmd)}
+	})
+
+	a, err := dashboard.NewSSHClient(host)
+	if err != nil {
+		t.Fatalf("NewSSHClient(a) error: %v", err)
+	}
+	defer a.Close()
+	b, err := dashboard.NewSSHClient(host)
+	if err != nil {
+		t.Fatalf("NewSSHClient(b) error: %v", err)
+	}
+	defer b.Close()
+
+	outA, err := a.ExecuteCommand("amd-smi monitor")
+	if err != nil {
+		t.Fatalf("ExecuteCommand(a) error: %v", err)
+	}
+	if outA != "conn=1 command=amd-smi monitor\n" {
+		t.Fatalf("ExecuteCommand(a) output = %q, want %q", outA, "conn=1 command=amd-smi monitor\n")
+	}
+
+	outB, err := b.ExecuteCommand("rocm-smi --showuse")
+	if err != nil {
+		t.Fatalf("ExecuteCommand(b) error: %v", err)
+	}
+	if outB != "conn=2 command=rocm-smi --showuse\n" {
+		t.Fatalf("ExecuteCommand(b) output = %q, want %q", outB, "conn=2 command=rocm-smi --showuse\n")
+	}
+}
