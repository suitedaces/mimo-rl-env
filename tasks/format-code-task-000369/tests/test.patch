+func TestExecuteCommandAllowedSuccessUsesFreshSessionAndOriginalCommand(t *testing.T) {
+
+
+	srv, host := newDashboardSSHServer(t, func(_ int32, cmd string) commandResult {
+		switch cmd {
+		case "\t free -m | grep Mem: \n":
+			return commandResult{output: "Mem: 1000 400 600\n"}
+		case "top -bn1 | grep 'Cpu(s)'":
+			return commandResult{output: "Cpu(s): 12.5 us\n"}
+		default:
+			return commandResult{output: "unexpected command: " + cmd + "\n", exitStatus: 9}
+		}
+	})
+
+	client, err := dashboard.NewSSHClient(host)
+	if err != nil {
+		t.Fatalf("NewSSHClient() error: %v", err)
+	}
+	defer client.Close()
+
+	out, err := client.ExecuteCommand("\t free -m | grep Mem: \n")
+	if err != nil {
+		t.Fatalf("ExecuteCommand(free) error: %v", err)
+	}
+	if out != "Mem: 1000 400 600\n" {
+		t.Fatalf("ExecuteCommand(free) output = %q, want %q", out, "Mem: 1000 400 600\n")
+	}
+
+	out, err = client.ExecuteCommand("top -bn1 | grep 'Cpu(s)'")
+	if err != nil {
+		t.Fatalf("ExecuteCommand(top) error: %v", err)
+	}
+	if out != "Cpu(s): 12.5 us\n" {
+		t.Fatalf("ExecuteCommand(top) output = %q, want %q", out, "Cpu(s): 12.5 us\n")
+	}
+
+	if got := srv.sessionCount.Load(); got != 2 {
+		t.Fatalf("server session count = %d, want 2", got)
+	}
+	if got := srv.commands(); !stringSlicesEqual(got, []string{"\t free -m | grep Mem: \n", "top -bn1 | grep 'Cpu(s)'"}) {
+		t.Fatalf("server commands = %#v, want %#v", got, []string{"\t free -m | grep Mem: \n", "top -bn1 | grep 'Cpu(s)'"})
+	}
+}
+
+func TestExecuteCommandAllowedNonZeroExitReturnsOutputAndSSHError(t *testing.T) {
+
+
+	_, host := newDashboardSSHServer(t, func(_ int32, cmd string) commandResult {
+		if cmd == "df -h | grep -E '^/dev/'" {
+			return commandResult{output: "warn\n", exitStatus: 7}
+		}
+		return commandResult{output: "unexpected\n", exitStatus: 9}
+	})
+
+	client, err := dashboard.NewSSHClient(host)
+	if err != nil {
+		t.Fatalf("NewSSHClient() error: %v", err)
+	}
+	defer client.Close()
+
+	out, err := client.ExecuteCommand("df -h | grep -E '^/dev/'")
+	if out != "warn\n" {
+		t.Fatalf("ExecuteCommand(df) output = %q, want %q", out, "warn\n")
+	}
+	if err == nil {
+		t.Fatal("ExecuteCommand(df) error = nil, want non-zero SSH exit error")
+	}
+	var exitErr *ssh.ExitError
+
+	if !errors.As(err, &exitErr) {
+		t.Fatalf("ExecuteCommand(df) error type = %T, want *ssh.ExitError", err)
+	}
+}
