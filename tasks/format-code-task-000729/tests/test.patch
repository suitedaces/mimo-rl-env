@@ -0,0 +1,16 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "$1" in
+  base)
+    go test -v -count=1 ./pkg/terraform/ -run '^(TestWriteTFState|TestWriteMainTF)$'
+    ;;
+  new)
+    go test -v -count=1 ./pkg/terraform/ -run '^(TestWriteTFState_OperationTimeoutsPrivateMetadata|TestWriteMainTF_OperationTimeoutsParameterUnchanged)$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
