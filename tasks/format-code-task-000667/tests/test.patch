diff --git a/usercase-test-coderl/market_manager_execute_order_test.cpp b/usercase-test-coderl/market_manager_execute_order_test.cpp
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/market_manager_execute_order_test.cpp
@@ -0,0 +1,408 @@
+
+
+#include "trader/matching/market_manager.h"
+
+#include <cstdint>
+#include <cstdlib>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+using namespace CppTrader::Matching;
+
+namespace {
+
+struct EventRecorder : MarketHandler
+{
+    struct ExecuteEvent
+    {
+        uint64_t id;
+        uint64_t event_price;
+        uint64_t event_qty;
+        uint64_t order_price;
+        uint64_t executed_quantity;
+        uint64_t leaves_quantity;
+    };
+
+    struct OrderEvent
+    {
+        uint64_t id;
+        uint64_t price;
+        uint64_t quantity;
+        uint64_t executed_quantity;
+        uint64_t leaves_quantity;
+    };
+
+    struct LevelEvent
+    {
+        uint64_t price;
+        uint64_t total_volume;
+        uint64_t visible_volume;
+        uint64_t hidden_volume;
+        uint64_t orders;
+    };
+
+    std::vector<std::string> events;
+    std::vector<ExecuteEvent> execute_events;
+    std::vector<OrderEvent> update_events;
+    std::vector<OrderEvent> delete_events;
+    std::vector<LevelEvent> update_level_events;
+    std::vector<LevelEvent> delete_level_events;
+
+    size_t execute_count = 0;
+    size_t update_count = 0;
+    size_t delete_count = 0;
+    size_t add_level_count = 0;
+    size_t update_level_count = 0;
+    size_t delete_level_count = 0;
+
+    void record(const std::string& event) { events.push_back(event); }
+
+    void onAddSymbol(const Symbol& symbol) override
+    {
+        std::ostringstream stream;
+        stream << "add_symbol id=" << symbol.Id;
+        record(stream.str());
+    }
+
+    void onAddOrderBook(const OrderBook& order_book) override
+    {
+        std::ostringstream stream;
+        stream << "add_book symbol=" << order_book.symbol().Id;
+        record(stream.str());
+    }
+
+    void onDeleteOrderBook(const OrderBook& order_book) override
+    {
+        std::ostringstream stream;
+        stream << "delete_book symbol=" << order_book.symbol().Id;
+        record(stream.str());
+    }
+
+    void onAddLevel(const OrderBook&, const Level& level, bool top) override
+    {
+        ++add_level_count;
+        std::ostringstream stream;
+        stream << "add_level price=" << level.Price << " total=" << level.TotalVolume
+               << " visible=" << level.VisibleVolume << " hidden=" << level.HiddenVolume
+               << " orders=" << level.Orders << " top=" << top;
+        record(stream.str());
+    }
+
+    void onUpdateLevel(const OrderBook&, const Level& level, bool top) override
+    {
+        ++update_level_count;
+        update_level_events.push_back({ level.Price, level.TotalVolume, level.VisibleVolume, level.HiddenVolume, level.Orders });
+        std::ostringstream stream;
+        stream << "update_level price=" << level.Price << " total=" << level.TotalVolume
+               << " visible=" << level.VisibleVolume << " hidden=" << level.HiddenVolume
+               << " orders=" << level.Orders << " top=" << top;
+        record(stream.str());
+    }
+
+    void onDeleteLevel(const OrderBook&, const Level& level, bool top) override
+    {
+        ++delete_level_count;
+        delete_level_events.push_back({ level.Price, level.TotalVolume, level.VisibleVolume, level.HiddenVolume, level.Orders });
+        std::ostringstream stream;
+        stream << "delete_level price=" << level.Price << " total=" << level.TotalVolume
+               << " visible=" << level.VisibleVolume << " hidden=" << level.HiddenVolume
+               << " orders=" << level.Orders << " top=" << top;
+        record(stream.str());
+    }
+
+    void onAddOrder(const Order& order) override
+    {
+        std::ostringstream stream;
+        stream << "add_order id=" << order.Id << " price=" << order.Price
+               << " qty=" << order.Quantity << " exec=" << order.ExecutedQuantity
+               << " leaves=" << order.LeavesQuantity;
+        record(stream.str());
+    }
+
+    void onUpdateOrder(const Order& order) override
+    {
+        ++update_count;
+        update_events.push_back({ order.Id, order.Price, order.Quantity, order.ExecutedQuantity, order.LeavesQuantity });
+        std::ostringstream stream;
+        stream << "update_order id=" << order.Id << " price=" << order.Price
+               << " qty=" << order.Quantity << " exec=" << order.ExecutedQuantity
+               << " leaves=" << order.LeavesQuantity;
+        record(stream.str());
+    }
+
+    void onDeleteOrder(const Order& order) override
+    {
+        ++delete_count;
+        delete_events.push_back({ order.Id, order.Price, order.Quantity, order.ExecutedQuantity, order.LeavesQuantity });
+        std::ostringstream stream;
+        stream << "delete_order id=" << order.Id << " price=" << order.Price
+               << " qty=" << order.Quantity << " exec=" << order.ExecutedQuantity
+               << " leaves=" << order.LeavesQuantity;
+        record(stream.str());
+    }
+
+    void onExecuteOrder(const Order& order, uint64_t price, uint64_t quantity) override
+    {
+        ++execute_count;
+        execute_events.push_back({ order.Id, price, quantity, order.Price, order.ExecutedQuantity, order.LeavesQuantity });
+        std::ostringstream stream;
+        stream << "execute_order id=" << order.Id << " event_price=" << price
+               << " event_qty=" << quantity << " order_price=" << order.Price
+               << " exec_before=" << order.ExecutedQuantity
+               << " leaves_before=" << order.LeavesQuantity;
+        record(stream.str());
+    }
+};
+
+struct Session
+{
+    EventRecorder handler;
+    MarketManager market;
+
+    Session() : handler(), market(handler) {}
+};
+
+void fail(const char* file, int line, const std::string& expr)
+{
+    std::cerr << file << ":" << line << ": assertion failed: " << expr << std::endl;
+    std::exit(1);
+}
+
+#define CHECK(expr) do { if (!(expr)) fail(__FILE__, __LINE__, #expr); } while (false)
+
+Symbol sample_symbol()
+{
+    return Symbol(0, "ABCDEF  ");
+}
+
+void add_symbol_book_and_order(Session& session)
+{
+    const Symbol symbol = sample_symbol();
+    CHECK(session.market.AddSymbol(symbol) == ErrorCode::OK);
+    CHECK(session.market.AddOrderBook(symbol) == ErrorCode::OK);
+    CHECK(session.market.AddOrder(Order::BuyLimit(10, 0, 101, 100)) == ErrorCode::OK);
+}
+
+const LevelNode* bid101(const MarketManager& market)
+{
+    const OrderBook* book = market.GetOrderBook(0);
+    CHECK(book != nullptr);
+    return book->GetBid(101);
+}
+
+bool has_execute_event(const EventRecorder& handler, uint64_t id, uint64_t price, uint64_t quantity)
+{
+    for (const auto& event : handler.execute_events)
+    {
+        if ((event.id == id) && (event.event_price == price) && (event.event_qty == quantity))
+            return true;
+    }
+    return false;
+}
+
+bool has_order_event(const std::vector<EventRecorder::OrderEvent>& events, uint64_t id, uint64_t executed, uint64_t leaves)
+{
+    for (const auto& event : events)
+    {
+        if ((event.id == id) && (event.executed_quantity == executed) && (event.leaves_quantity == leaves))
+            return true;
+    }
+    return false;
+}
+
+bool has_level_event(const std::vector<EventRecorder::LevelEvent>& events, uint64_t price, uint64_t total, uint64_t visible, uint64_t hidden, uint64_t orders)
+{
+    for (const auto& event : events)
+    {
+        if ((event.price == price) && (event.total_volume == total) && (event.visible_volume == visible) &&
+            (event.hidden_volume == hidden) && (event.orders == orders))
+            return true;
+    }
+    return false;
+}
+
+void test_partial_and_capped_execution_session()
+{
+
+
+    Session session;
+    add_symbol_book_and_order(session);
+
+    CHECK(session.market.orders().size() == 1);
+    CHECK(session.market.GetOrder(10) != nullptr);
+    CHECK(session.market.GetOrder(10)->Id == 10);
+    CHECK(session.market.GetOrder(10)->Price == 101);
+    CHECK(session.market.GetOrder(10)->Quantity == 100);
+    CHECK(session.market.GetOrder(10)->ExecutedQuantity == 0);
+    CHECK(session.market.GetOrder(10)->LeavesQuantity == 100);
+    CHECK(bid101(session.market) != nullptr);
+    CHECK(bid101(session.market)->TotalVolume == 100);
+    CHECK(bid101(session.market)->VisibleVolume == 100);
+    CHECK(bid101(session.market)->HiddenVolume == 0);
+    CHECK(bid101(session.market)->Orders == 1);
+
+    CHECK(session.market.ExecuteOrder(10, 25) == ErrorCode::OK);
+
+    CHECK(session.market.orders().size() == 1);
+    CHECK(session.market.GetOrder(10) != nullptr);
+    CHECK(session.market.GetOrder(10)->ExecutedQuantity == 25);
+    CHECK(session.market.GetOrder(10)->LeavesQuantity == 75);
+    CHECK(bid101(session.market) != nullptr);
+    CHECK(bid101(session.market)->TotalVolume == 75);
+    CHECK(bid101(session.market)->VisibleVolume == 75);
+    CHECK(bid101(session.market)->HiddenVolume == 0);
+    CHECK(bid101(session.market)->Orders == 1);
+
+    CHECK(session.handler.execute_count == 1);
+    CHECK(session.handler.update_count == 1);
+    CHECK(has_execute_event(session.handler, 10, 101, 25));
+    CHECK(has_order_event(session.handler.update_events, 10, 25, 75));
+
+    CHECK(session.market.ExecuteOrder(10, 99, 80) == ErrorCode::OK);
+
+    CHECK(session.market.orders().size() == 0);
+    CHECK(session.market.GetOrder(10) == nullptr);
+    CHECK(session.market.GetOrderBook(0) != nullptr);
+    CHECK(session.market.GetOrderBook(0)->size() == 0);
+    CHECK(session.market.GetOrderBook(0)->GetBid(101) == nullptr);
+    CHECK(session.market.GetOrderBook(0)->best_bid() == nullptr);
+
+    CHECK(has_execute_event(session.handler, 10, 99, 75));
+    CHECK(has_order_event(session.handler.delete_events, 10, 100, 0));
+    CHECK(session.handler.execute_count == 2);
+    CHECK(session.handler.update_count == 1);
+    CHECK(session.handler.delete_count == 1);
+}
+
+void test_rejects_invalid_ids_quantities_and_unknown_orders()
+{
+
+
+    Session session;
+    add_symbol_book_and_order(session);
+
+    CHECK(session.market.ExecuteOrder(0, 25) == ErrorCode::ORDER_ID_INVALID);
+    CHECK(session.market.ExecuteOrder(0, 99, 25) == ErrorCode::ORDER_ID_INVALID);
+    CHECK(session.market.ExecuteOrder(10, 0) == ErrorCode::ORDER_QUANTITY_INVALID);
+    CHECK(session.market.ExecuteOrder(10, 99, 0) == ErrorCode::ORDER_QUANTITY_INVALID);
+    CHECK(session.market.ExecuteOrder(999, 1) == ErrorCode::ORDER_NOT_FOUND);
+    CHECK(session.market.ExecuteOrder(999, 99, 1) == ErrorCode::ORDER_NOT_FOUND);
+    CHECK(session.market.orders().size() == 1);
+    CHECK(session.market.GetOrder(10)->ExecutedQuantity == 0);
+    CHECK(session.market.GetOrder(10)->LeavesQuantity == 100);
+}
+
+void test_returns_order_book_not_found_for_stored_order_without_book()
+{
+
+
+    Session session;
+    add_symbol_book_and_order(session);
+
+    CHECK(session.market.DeleteOrderBook(0) == ErrorCode::OK);
+    CHECK(session.market.GetOrderBook(0) == nullptr);
+    CHECK(session.market.GetOrder(10) != nullptr);
+    CHECK(session.market.GetOrder(10)->ExecutedQuantity == 0);
+    CHECK(session.market.GetOrder(10)->LeavesQuantity == 100);
+    CHECK(session.market.ExecuteOrder(10, 1) == ErrorCode::ORDER_BOOK_NOT_FOUND);
+    CHECK(session.market.ExecuteOrder(10, 99, 1) == ErrorCode::ORDER_BOOK_NOT_FOUND);
+    CHECK(session.market.GetOrder(10) != nullptr);
+    CHECK(session.market.GetOrder(10)->ExecutedQuantity == 0);
+    CHECK(session.market.GetOrder(10)->LeavesQuantity == 100);
+}
+
+void test_automatic_matching_runs_after_successful_manual_execution()
+{
+
+
+    Session session;
+    const Symbol symbol = sample_symbol();
+    CHECK(session.market.AddSymbol(symbol) == ErrorCode::OK);
+    CHECK(session.market.AddOrderBook(symbol) == ErrorCode::OK);
+    CHECK(session.market.AddOrder(Order::BuyLimit(10, 0, 101, 100)) == ErrorCode::OK);
+    CHECK(session.market.AddOrder(Order::SellStop(20, 0, 99, 40)) == ErrorCode::OK);
+    CHECK(session.market.IsMatchingEnabled() == false);
+    session.market.EnableMatching();
+    CHECK(session.market.IsMatchingEnabled() == true);
+
+    CHECK(session.market.GetOrder(10) != nullptr);
+    CHECK(session.market.GetOrder(10)->ExecutedQuantity == 0);
+    CHECK(session.market.GetOrder(10)->LeavesQuantity == 100);
+    CHECK(session.market.GetOrder(20) != nullptr);
+    CHECK(session.market.GetOrder(20)->ExecutedQuantity == 0);
+    CHECK(session.market.GetOrder(20)->LeavesQuantity == 40);
+
+    CHECK(session.market.ExecuteOrder(10, 99, 100) == ErrorCode::OK);
+
+    CHECK(session.market.orders().size() == 0);
+    CHECK(session.market.GetOrder(10) == nullptr);
+    CHECK(session.market.GetOrder(20) == nullptr);
+    CHECK(session.market.GetOrderBook(0)->size() == 0);
+
+    CHECK(has_execute_event(session.handler, 10, 99, 100));
+    CHECK(has_order_event(session.handler.delete_events, 10, 100, 0));
+    CHECK(session.handler.execute_count == 1);
+    CHECK(session.handler.delete_count >= 1);
+}
+
+void test_two_market_managers_keep_independent_order_state()
+{
+
+
+    Session a;
+    Session b;
+    add_symbol_book_and_order(a);
+    add_symbol_book_and_order(b);
+
+    CHECK(a.market.ExecuteOrder(10, 25) == ErrorCode::OK);
+    CHECK(b.market.ExecuteOrder(10, 25) == ErrorCode::OK);
+
+    CHECK(a.market.orders().size() == 1);
+    CHECK(a.market.GetOrder(10)->ExecutedQuantity == 25);
+    CHECK(a.market.GetOrder(10)->LeavesQuantity == 75);
+    CHECK(bid101(a.market)->TotalVolume == 75);
+    CHECK(b.market.orders().size() == 1);
+    CHECK(b.market.GetOrder(10)->ExecutedQuantity == 25);
+    CHECK(b.market.GetOrder(10)->LeavesQuantity == 75);
+    CHECK(bid101(b.market)->TotalVolume == 75);
+}
+
+void test_manual_execution_contract_repeats_in_fresh_sessions()
+{
+
+    for (int i = 0; i < 3; ++i)
+    {
+        Session session;
+        add_symbol_book_and_order(session);
+
+        CHECK(session.market.ExecuteOrder(10, 25) == ErrorCode::OK);
+        CHECK(session.market.GetOrder(10) != nullptr);
+        CHECK(session.market.GetOrder(10)->ExecutedQuantity == 25);
+        CHECK(session.market.GetOrder(10)->LeavesQuantity == 75);
+        CHECK(bid101(session.market)->TotalVolume == 75);
+        CHECK(has_execute_event(session.handler, 10, 101, 25));
+        CHECK(has_order_event(session.handler.update_events, 10, 25, 75));
+
+        CHECK(session.market.ExecuteOrder(10, 99, 80) == ErrorCode::OK);
+        CHECK(session.market.GetOrder(10) == nullptr);
+        CHECK(session.market.GetOrderBook(0)->GetBid(101) == nullptr);
+        CHECK(has_execute_event(session.handler, 10, 99, 75));
+        CHECK(has_order_event(session.handler.delete_events, 10, 100, 0));
+    }
+}
+
+}
+
+int main()
+{
+    test_partial_and_capped_execution_session();
+    test_rejects_invalid_ids_quantities_and_unknown_orders();
+    test_returns_order_book_not_found_for_stored_order_without_book();
+    test_automatic_matching_runs_after_successful_manual_execution();
+    test_two_market_managers_keep_independent_order_state();
+    test_manual_execution_contract_repeats_in_fresh_sessions();
+    std::cout << "market_manager_execute_order acceptance tests passed" << std::endl;
+    return 0;
+}
