+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+CXX="${CXX:-g++}"
+OUT="/tmp/market_manager_execute_order_test"
+
+
+mapfile -t MATCHING_SOURCES < <(find /workspace/repo/source/trader/matching -maxdepth 1 -type f -name '*.cpp' | sort)
+
+"${CXX}" -std=c++17 -O0 -g -DNDEBUG \
+  -I/workspace/repo/include \
+  -I/workspace/repo/modules/CppCommon/include \
+  -I/workspace/repo/modules/CppCommon/modules/fmt/include \
+  /workspace/repo/usercase-test-coderl/market_manager_execute_order_test.cpp \
+  "${MATCHING_SOURCES[@]}" \
+  /workspace/repo/modules/CppCommon/source/memory/memory.cpp \
+  /workspace/repo/modules/CppCommon/source/errors/exceptions.cpp \
+  /workspace/repo/modules/CppCommon/source/errors/system_error.cpp \
+  /workspace/repo/modules/CppCommon/modules/fmt/src/format.cc \
+  -o "${OUT}"
+
+exec "${OUT}"
