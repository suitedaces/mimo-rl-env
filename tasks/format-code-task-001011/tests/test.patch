+package config
+
+import (
+	"testing"
+
+	"github.com/semi-technologies/weaviate/usecases/auth/authorization/adminlist"
+)
+
+func TestFromEnvBooleanOverridesAndValidation(t *testing.T) {
+	base := Config{
+		Authentication: Authentication{
+			AnonymousAccess: AnonymousAccess{Enabled: true},
+			OIDC:            OIDC{Enabled: true, SkipClientIDCheck: true},
+		},
+		Authorization: Authorization{AdminList: adminListConfig(true, "admin")},
+		AutoSchema:    AutoSchema{Enabled: true, DefaultString: "string", DefaultNumber: "int", DefaultDate: "string"},
+	}
+
+	t.Setenv("AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED", "FaLsE")
+	t.Setenv("AUTHENTICATION_OIDC_ENABLED", "0")
+	t.Setenv("AUTHENTICATION_OIDC_SKIP_CLIENT_ID_CHECK", "false")
+	t.Setenv("AUTHORIZATION_ADMINLIST_ENABLED", "OFF")
+	t.Setenv("AUTOSCHEMA_ENABLED", "FALSE")
+
+	if err := FromEnv(&base); err != nil {
+		t.Fatalf("FromEnv returned unexpected error: %v", err)
+	}
+	if base.Authentication.AnonymousAccess.Enabled {
+		t.Error("explicit false must disable anonymous access")
+	}
+	if base.Authentication.OIDC.Enabled {
+		t.Error("explicit false must disable OIDC")
+	}
+	if base.Authentication.OIDC.SkipClientIDCheck {
+		t.Error("explicit false must disable OIDC client-id skipping")
+	}
+	if base.Authorization.AdminList.Enabled {
+		t.Error("explicit false must disable admin-list authorization")
+	}
+	if base.AutoSchema.Enabled {
+		t.Error("explicit false must disable autoschema")
+	}
+
+	base.Authentication.AnonymousAccess.Enabled = true
+	base.Authentication.OIDC.Enabled = true
+	base.Authentication.OIDC.SkipClientIDCheck = true
+	base.Authorization.AdminList.Enabled = true
+	base.AutoSchema.Enabled = true
+	for _, name := range []string{"AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED", "AUTHENTICATION_OIDC_ENABLED", "AUTHENTICATION_OIDC_SKIP_CLIENT_ID_CHECK", "AUTHORIZATION_ADMINLIST_ENABLED", "AUTOSCHEMA_ENABLED"} {
+		t.Setenv(name, "")
+	}
+	if err := FromEnv(&base); err != nil {
+		t.Fatalf("FromEnv returned unexpected error for unset booleans: %v", err)
+	}
+	if !base.Authentication.AnonymousAccess.Enabled || !base.Authentication.OIDC.Enabled || !base.Authentication.OIDC.SkipClientIDCheck || !base.Authorization.AdminList.Enabled || !base.AutoSchema.Enabled {
+		t.Error("unset boolean variables must preserve configured values")
+	}
+}
+
+func TestFromEnvAcceptsCaseInsensitiveTrueAndRejectsUnknownBoolean(t *testing.T) {
+	config := Config{}
+	t.Setenv("AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED", "ENABLED")
+	if err := FromEnv(&config); err != nil {
+		t.Fatalf("FromEnv returned unexpected error: %v", err)
+	}
+	if !config.Authentication.AnonymousAccess.Enabled {
+		t.Error("case-insensitive true token should enable anonymous access")
+	}
+
+	t.Setenv("AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED", "sometimes")
+	if err := FromEnv(&Config{}); err == nil {
+		t.Error("unknown boolean token must return an error")
+	}
+}
+
+func TestFromEnvAdminListTrimsEntriesAndPreservesUnsetLists(t *testing.T) {
+	config := Config{Authorization: Authorization{AdminList: adminListConfig(true, "file-admin")}}
+	t.Setenv("AUTHORIZATION_ADMINLIST_ENABLED", "true")
+	t.Setenv("AUTHORIZATION_ADMINLIST_USERS", " alice, bob ,, ")
+	t.Setenv("AUTHORIZATION_ADMINLIST_READONLY_USERS", " carol, , dave ")
+	if err := FromEnv(&config); err != nil {
+		t.Fatalf("FromEnv returned unexpected error: %v", err)
+	}
+	if got, want := config.Authorization.AdminList.Users, []string{"alice", "bob"}; !equalStrings(got, want) {
+		t.Fatalf("users = %#v, want %#v", got, want)
+	}
+	if got, want := config.Authorization.AdminList.ReadOnlyUsers, []string{"carol", "dave"}; !equalStrings(got, want) {
+		t.Fatalf("readonly users = %#v, want %#v", got, want)
+	}
+
+	config = Config{Authorization: Authorization{AdminList: adminListConfig(true, "file-admin")}}
+	config.Authorization.AdminList.ReadOnlyUsers = []string{"file-readonly"}
+	t.Setenv("AUTHORIZATION_ADMINLIST_USERS", "new-admin")
+	t.Setenv("AUTHORIZATION_ADMINLIST_READONLY_USERS", "")
+	if err := FromEnv(&config); err != nil {
+		t.Fatalf("FromEnv returned unexpected error: %v", err)
+	}
+	if got := config.Authorization.AdminList.Users; !equalStrings(got, []string{"new-admin"}) {
+		t.Fatalf("unset users override changed file value: %#v", got)
+	}
+	if got := config.Authorization.AdminList.ReadOnlyUsers; !equalStrings(got, []string{"file-readonly"}) {
+		t.Fatalf("unset readonly users override changed file value: %#v", got)
+	}
+}
+
+func TestFromEnvAutoschemaDefaultsRespectFileValuesAndFillEmptyConfig(t *testing.T) {
+	fileConfig := Config{AutoSchema: AutoSchema{Enabled: true, DefaultString: "string", DefaultNumber: "int", DefaultDate: "text"}}
+	for _, name := range []string{"AUTOSCHEMA_ENABLED", "AUTOSCHEMA_DEFAULT_STRING", "AUTOSCHEMA_DEFAULT_NUMBER", "AUTOSCHEMA_DEFAULT_DATE"} {
+		t.Setenv(name, "")
+	}
+	if err := FromEnv(&fileConfig); err != nil {
+		t.Fatalf("FromEnv returned unexpected error: %v", err)
+	}
+	if got := fileConfig.AutoSchema; got != (AutoSchema{Enabled: true, DefaultString: "string", DefaultNumber: "int", DefaultDate: "text"}) {
+		t.Fatalf("unset autoschema env changed file config: %#v", got)
+	}
+
+	defaults := Config{}
+	if err := FromEnv(&defaults); err != nil {
+		t.Fatalf("FromEnv returned unexpected error: %v", err)
+	}
+	if got, want := defaults.AutoSchema, (AutoSchema{Enabled: true, DefaultString: "text", DefaultNumber: "number", DefaultDate: "date"}); got != want {
+		t.Fatalf("empty autoschema config = %#v, want %#v", got, want)
+	}
+
+	partial := Config{AutoSchema: AutoSchema{DefaultString: "string"}}
+	if err := FromEnv(&partial); err != nil {
+		t.Fatalf("FromEnv returned unexpected error: %v", err)
+	}
+	if got, want := partial.AutoSchema, (AutoSchema{Enabled: true, DefaultString: "string", DefaultNumber: "number", DefaultDate: "date"}); got != want {
+		t.Fatalf("partial autoschema config = %#v, want %#v", got, want)
+	}
+}
+
+func TestFromEnvRejectsNegativeQueryLimit(t *testing.T) {
+	t.Setenv("QUERY_DEFAULTS_LIMIT", "-1")
+	if err := FromEnv(&Config{}); err == nil {
+		t.Error("negative query limit must return an error")
+	}
+	t.Setenv("QUERY_DEFAULTS_LIMIT", "0")
+	config := Config{}
+	if err := FromEnv(&config); err != nil || config.QueryDefaults.Limit != 0 {
+		t.Fatalf("zero query limit should be accepted, got limit=%d err=%v", config.QueryDefaults.Limit, err)
+	}
+}
+
+func adminListConfig(enabled bool, users ...string) adminlist.Config {
+	return adminlist.Config{Enabled: enabled, Users: users}
+}
+
+func equalStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
