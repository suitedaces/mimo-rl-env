@@ -1,6 +1,63 @@
 module TestCatElements
 using Test
 using Catlab.GATs, Catlab.Theories, Catlab.Graphs, Catlab.CategoricalAlgebra
+import Catlab.CategoricalAlgebra.CSets: ACSetTransformation
+import ACSets
+import ACSets: ACSet, acset_schema, add_parts!, codom_parts, dom_parts,
+  has_part, has_subpart, incident, IntParts, nparts, parts, set_subpart!,
+  subpart
+
+struct WrappedGraph <: ACSet{IntParts}
+  data::Graph
+end
+WrappedGraph() = WrappedGraph(Graph())
+
+acset_schema(::WrappedGraph) = acset_schema(Graph())
+nparts(g::WrappedGraph, p::Symbol) = nparts(g.data, p)
+parts(g::WrappedGraph, p::Symbol) = parts(g.data, p)
+add_parts!(g::WrappedGraph, p::Symbol, n::Int) = add_parts!(g.data, p, n)
+set_subpart!(g::WrappedGraph, part::Int, f::Symbol, val) =
+  set_subpart!(g.data, part, f, val)
+subpart(g::WrappedGraph, f::Symbol) = subpart(g.data, f)
+subpart(g::WrappedGraph, part, f::Symbol) = subpart(g.data, part, f)
+subpart(g::WrappedGraph, names::Tuple{Vararg{Symbol}}) = subpart(g.data, names)
+subpart(g::WrappedGraph, part, names::Tuple{Vararg{Symbol}}) =
+  subpart(g.data, part, names)
+dom_parts(g::WrappedGraph, f::Symbol) = dom_parts(g.data, f)
+codom_parts(g::WrappedGraph, f::Symbol) = codom_parts(g.data, f)
+has_part(g::WrappedGraph, p::Symbol) = has_part(g.data, p)
+has_subpart(g::WrappedGraph, f::Symbol) = has_subpart(g.data, f)
+incident(g::WrappedGraph, part, f::Symbol) = incident(g.data, part, f)
+incident(g::WrappedGraph, part, names::Tuple{Vararg{Symbol}}) =
+  incident(g.data, part, names)
+ACSetTransformation(components, X::WrappedGraph, Y::WrappedGraph) =
+  ACSetTransformation(components, X.data, Y.data)
+
+@testset "Custom ACSet category-of-elements APIs" begin
+  arr = path_graph(Graph, 2)
+  wrapped_arr = WrappedGraph(arr)
+  @test elements(wrapped_arr) == elements(arr)
+
+  wrapped_two_edge = WrappedGraph(path_graph(Graph, 3))
+  el_wrapped_two_edge = elements(wrapped_two_edge)
+  @test nparts(el_wrapped_two_edge, :El) == 5
+  @test nparts(el_wrapped_two_edge, :Arr) == 4
+
+  round_trip_wrapped = inverse_elements(el_wrapped_two_edge, WrappedGraph())
+  @test nparts(round_trip_wrapped, :V) == 3
+  @test nparts(round_trip_wrapped, :E) == 2
+  @test subpart(round_trip_wrapped, :src) == [1, 2]
+  @test subpart(round_trip_wrapped, :tgt) == [2, 3]
+
+  graph_two_edge = path_graph(Graph, 3)
+  graph_hom = homomorphism(arr, graph_two_edge; initial=(V=[1, 2], E=[1]))
+  el_hom = elements(graph_hom)
+  inv_wrapped_hom = inverse_elements(el_hom, WrappedGraph())
+  @test nparts(dom(inv_wrapped_hom), :E) == 1
+  @test nparts(codom(inv_wrapped_hom), :E) == 2
+  @test collect(force(inv_wrapped_hom)[:V]) == [1, 2]
+  @test collect(force(inv_wrapped_hom)[:E]) == [1]
+end
 
 arr = @acset Graph begin
   V = 2
