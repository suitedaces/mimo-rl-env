+++ b/mimo_test_command.sh
@@ -0,0 +1,60 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+set -e
+pkg_instantiate() {
+  if ! julia --project=. -e 'using Pkg; Pkg.instantiate()' > /tmp/fixture_pkg_instantiate.log 2>&1; then
+    cat /tmp/fixture_pkg_instantiate.log
+    return 1
+  fi
+}
+
+pkg_instantiate
+ACSETS_DIR=$(julia --project=. -e 'using ACSets; println(dirname(dirname(pathof(ACSets))))')
+sed -i 's/abstract type SimpleACSet{PT} <: ACSet{PT} end/abstract type SimpleACSet{PT<:PartsType} <: ACSet{PT} end/' "$ACSETS_DIR/src/DenseACSets.jl"
+sed -i 's/struct DynamicACSet{PT} <: SimpleACSet{PT}/struct DynamicACSet{PT<:PartsType} <: SimpleACSet{PT}/' "$ACSETS_DIR/src/DenseACSets.jl"
+rm -rf /root/.julia/compiled/v1.10/ACSets /root/.julia/compiled/v1.10/Catlab
+
+
+instantiate() {
+  pkg_instantiate
+}
+
+case "${1:-}" in
+  base)
+    instantiate
+    awk '
+      /^@testset "Custom ACSet category-of-elements APIs" begin$/ { skip=1; next }
+      skip && /^end$/ { skip=0; next }
+      !skip { print }
+    ' test/categorical_algebra/CatElements.jl > /tmp/cat_elements_base.jl
+    julia --project=. /tmp/cat_elements_base.jl
+    ;;
+  new)
+    instantiate
+    printf '%s\n' 'module FixtureDynamicCatElements' > /tmp/cat_elements_dynamic.jl
+    printf '%s\n' 'using Test' >> /tmp/cat_elements_dynamic.jl
+    printf '%s\n' 'using Catlab.GATs, Catlab.Theories, Catlab.Graphs, Catlab.CategoricalAlgebra' >> /tmp/cat_elements_dynamic.jl
+    set +e
+    awk '
+      /^import Catlab.CategoricalAlgebra.CSets: ACSetTransformation$/ { capture=1 }
+      capture && /^arr = @acset Graph begin$/ { found=1; exit }
+      capture { print }
+      END { if (!found) exit 3 }
+    ' test/categorical_algebra/CatElements.jl >> /tmp/cat_elements_dynamic.jl
+    awk_status=$?
+    set -e
+    printf '%s\n' 'end # module' >> /tmp/cat_elements_dynamic.jl
+    if [ "$awk_status" -ne 0 ]; then
+      echo "Custom ACSet testset not found in CatElements test file"
+      exit "$awk_status"
+    fi
+    julia --project=. /tmp/cat_elements_dynamic.jl
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
