+#!/usr/bin/env bash
+
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+python3 -m unittest -v \
+    tests.test_utils.AdjustTests \
+    tests.test_utils.PythonNormalizationTests \
+    tests.test_utils.JavaNormalizationTests.test_no_exception \
+    tests.test_utils.JavaNormalizationTests.test_exception_in_clinit \
+    tests.test_utils.JavaNormalizationTests.test_exception_in_clinit_after_output \
+    tests.test_utils.JavaNormalizationTests.test_exception_in_constructor \
+    tests.test_utils.JavaNormalizationTests.test_float \
+    tests.test_utils.JavaNormalizationTests.test_memory_reference
+
+
+python3 -m unittest -v tests.test_cleanse_java
