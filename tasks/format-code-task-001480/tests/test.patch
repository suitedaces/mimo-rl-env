diff --git a/tests/components/hassio/test_init.py b/tests/components/hassio/test_init.py
index 31ee73013da..0bbd635258c 100644
--- a/tests/components/hassio/test_init.py
+++ b/tests/components/hassio/test_init.py
@@ -943,3 +943,48 @@ def test_hostname_from_addon_slug() -> None:
         hostname_from_addon_slug("core_silabs_multiprotocol")
         == "core-silabs-multiprotocol"
     )
+
+
+def test_valid_addon_accepts_dash_in_slug() -> None:
+    """Bug case: addon slug with a dash should be accepted (e.g. ccab4aaf_frigate-fa)."""
+    from homeassistant.components.hassio import valid_addon
+
+    assert valid_addon("ccab4aaf_frigate-fa") == "ccab4aaf_frigate-fa"
+
+
+def test_valid_addon_accepts_multiple_dashes() -> None:
+    """Multiple dashes in the addon slug should be accepted."""
+    from homeassistant.components.hassio import valid_addon
+
+    assert valid_addon("a-b-c-d") == "a-b-c-d"
+
+
+def test_valid_addon_accepts_underscore_only_slug() -> None:
+    """Conventional underscore-only slugs must continue to work (preservation)."""
+    from homeassistant.components.hassio import valid_addon
+
+    assert valid_addon("core_mosquitto") == "core_mosquitto"
+
+
+def test_valid_addon_rejects_space() -> None:
+    """Whitespace remains an invalid addon-slug character."""
+    from homeassistant.components.hassio import valid_addon
+
+    with pytest.raises(Invalid):
+        valid_addon("Has Space")
+
+
+def test_valid_addon_rejects_special_char() -> None:
+    """Characters outside [-_.A-Za-z0-9] must still be rejected."""
+    from homeassistant.components.hassio import valid_addon
+
+    with pytest.raises(Invalid):
+        valid_addon("addon@bad")
+
+
+def test_valid_addon_rejects_slash() -> None:
+    """A slash is outside the accepted addon-slug character set."""
+    from homeassistant.components.hassio import valid_addon
+
+    with pytest.raises(Invalid):
+        valid_addon("addon/bad")
