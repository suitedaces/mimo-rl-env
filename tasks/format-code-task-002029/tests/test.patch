new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+
+
+
+
+case "${1:-}" in
+  base)
+    go test -v -short ./pkg/common -run '^TestCartesianProduct$'
+    ;;
+  new)
+    go test -v . -run '^(TestHelpIncludesContainerArchitecture|TestReadmeDocumentsContainerArchitecture|TestCLIContainerArchitectureReachesDockerRuntime|TestCLIContainerArchitectureAcceptsNonExampleValue|TestDefaultRunUsesCurrentArchitectureWhenPlatformOmitted)$' &&
+      go test -v ./pkg/runner -run '^TestConfigExposesContainerArchitecture$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
