+package runner_test
+
+import (
+	"testing"
+
+	"github.com/nektos/act/pkg/runner"
+)
+
+func TestConfigExposesContainerArchitecture(t *testing.T) {
+	const requested = "linux/arm64"
+
+	cfg := &runner.Config{
+		ContainerArchitecture: requested,
+	}
+
+	if cfg.ContainerArchitecture != requested {
+		t.Fatalf("expected runner.Config to preserve requested container architecture %q, got %q",
+			requested, cfg.ContainerArchitecture)
+	}
+}
