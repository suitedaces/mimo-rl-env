index 0000000..aa495a9
--- /dev/null
+++ b/test/junit-report.test.js
@@ -0,0 +1,244 @@
+/* eslint-env mocha */
+const chai = require('chai')
+chai.should()
+const fs = require('fs')
+const os = require('os')
+const path = require('path')
+const sax = require('sax')
+const generateReport = require('../lib/cucumber-junit-report')
+
+const outDir = path.join(os.tmpdir(), 'nwc-junit-report-test')
+
+let counter = 0
+function generate (featureOutput, options) {
+  counter += 1
+  const output = path.join(outDir, `report-${counter}.xml`)
+  generateReport(Object.assign({ output }, options), featureOutput)
+  return parse(fs.readFileSync(output, 'utf8'))
+}
+
+
+
+function parse (xml) {
+  const parser = sax.parser(true)
+  const suites = []
+  let suite
+  let testCase
+  parser.onopentag = (node) => {
+    const attrs = node.attributes
+    switch (node.name) {
+      case 'testsuite':
+        suite = { name: attrs.name, cases: [] }
+        suites.push(suite)
+        break
+      case 'testcase':
+        testCase = {
+          classname: attrs.classname,
+          name: attrs.name,
+          failure: null,
+          error: null,
+          skipped: false
+        }
+        suite.cases.push(testCase)
+        break
+      case 'failure':
+        testCase.failure = attrs.message || ''
+        break
+      case 'error':
+        testCase.error = attrs.message || ''
+        break
+      case 'skipped':
+        testCase.skipped = true
+        break
+    }
+  }
+  parser.write(xml).close()
+  return { suites }
+}
+
+function step (name, status, errorMessage) {
+  return {
+    keyword: 'Given ',
+    name,
+    match: { location: 'steps.js:1' },
+    result: errorMessage ? { status, error_message: errorMessage } : { status }
+  }
+}
+
+function scenario (name, steps) {
+  return { name, type: 'scenario', steps }
+}
+
+function feature (name, scenarios) {
+  return { name, elements: scenarios }
+}
+
+describe('JUnit report generation', () => {
+  it('emits one suite per feature and one case per scenario with default naming', () => {
+    const report = generate([
+      feature('addition', [
+        scenario('small numbers', [step('a', 'passed')]),
+        scenario('big numbers', [step('b', 'passed')])
+      ]),
+      feature('subtraction', [
+        scenario('small numbers', [step('c', 'passed')])
+      ])
+    ])
+
+    report.suites.length.should.equal(2)
+    report.suites[0].name.should.equal('Feature: addition')
+    report.suites[1].name.should.equal('Feature: subtraction')
+
+    report.suites[0].cases.length.should.equal(2)
+    report.suites[0].cases[0].classname.should.equal('Feature: addition')
+    report.suites[0].cases[0].name.should.equal('Scenario: small numbers')
+    report.suites[0].cases[1].name.should.equal('Scenario: big numbers')
+    report.suites[1].cases[0].classname.should.equal('Feature: subtraction')
+    report.suites[1].cases[0].name.should.equal('Scenario: small numbers')
+  })
+
+  it('honors configurable name prefixes', () => {
+    const report = generate([
+      feature('addition', [scenario('small numbers', [step('a', 'passed')])])
+    ], {
+      suiteNamePrefix: 'F> ',
+      classNamePrefix: 'C> ',
+      scenarioNamePrefix: 'S> '
+    })
+
+    report.suites[0].name.should.equal('F> addition')
+    report.suites[0].cases[0].classname.should.equal('C> addition')
+    report.suites[0].cases[0].name.should.equal('S> small numbers')
+  })
+
+  it('emits an empty suite for a feature without scenarios', () => {
+    const report = generate([feature('empty', [])])
+
+    report.suites.length.should.equal(1)
+    report.suites[0].name.should.equal('Feature: empty')
+    report.suites[0].cases.length.should.equal(0)
+  })
+
+  it('marks a passing scenario clean', () => {
+    const report = generate([
+      feature('f', [scenario('all good', [step('a', 'passed'), step('b', 'passed')])])
+    ])
+
+    const c = report.suites[0].cases[0]
+    chai.expect(c.failure).to.equal(null)
+    chai.expect(c.error).to.equal(null)
+    c.skipped.should.equal(false)
+  })
+
+  it('records a scenario with a failed step as a failure naming the step and its error', () => {
+    const report = generate([
+      feature('f', [
+        scenario('boom', [
+          step('a', 'passed'),
+          step('explode', 'failed', 'expected 8 but got 9')
+        ])
+      ])
+    ])
+
+    const c = report.suites[0].cases[0]
+    c.failure.should.be.a('string')
+    c.failure.should.contain('explode')
+    c.failure.should.contain('expected 8 but got 9')
+    chai.expect(c.error).to.equal(null)
+    c.skipped.should.equal(false)
+  })
+
+  it('mentions every failing step in the failure message', () => {
+    const report = generate([
+      feature('f', [
+        scenario('multi', [
+          step('first bad', 'failed', 'first error'),
+          step('second bad', 'failed', 'second error')
+        ])
+      ])
+    ])
+
+    const c = report.suites[0].cases[0]
+    c.failure.should.contain('first bad')
+    c.failure.should.contain('first error')
+    c.failure.should.contain('second bad')
+    c.failure.should.contain('second error')
+  })
+
+  it('records a scenario with an ambiguous step as an error naming the step', () => {
+    const report = generate([
+      feature('f', [
+        scenario('amb', [step('a', 'passed'), step('which one', 'ambiguous')])
+      ])
+    ])
+
+    const c = report.suites[0].cases[0]
+    c.error.should.be.a('string')
+    c.error.should.contain('which one')
+    chai.expect(c.failure).to.equal(null)
+    c.skipped.should.equal(false)
+  })
+
+  it('records a scenario with an undefined step as skipped', () => {
+    const report = generate([
+      feature('f', [scenario('undef', [step('a', 'passed'), step('b', 'undefined')])])
+    ])
+
+    const c = report.suites[0].cases[0]
+    c.skipped.should.equal(true)
+    chai.expect(c.failure).to.equal(null)
+    chai.expect(c.error).to.equal(null)
+  })
+
+  it('records a scenario with a pending step as skipped', () => {
+    const report = generate([
+      feature('f', [scenario('pend', [step('a', 'passed'), step('b', 'pending')])])
+    ])
+
+    const c = report.suites[0].cases[0]
+    c.skipped.should.equal(true)
+    chai.expect(c.failure).to.equal(null)
+    chai.expect(c.error).to.equal(null)
+  })
+
+  it('lets a failure outrank an undefined step in the same scenario', () => {
+    const report = generate([
+      feature('f', [
+        scenario('mixed', [
+          step('bad', 'failed', 'kaboom'),
+          step('missing', 'undefined')
+        ])
+      ])
+    ])
+
+    const c = report.suites[0].cases[0]
+    c.failure.should.be.a('string')
+    c.skipped.should.equal(false)
+    chai.expect(c.error).to.equal(null)
+  })
+
+  it('lets an ambiguous step outrank a pending step when no step failed', () => {
+    const report = generate([
+      feature('f', [
+        scenario('mixed', [
+          step('which one', 'ambiguous'),
+          step('later', 'pending')
+        ])
+      ])
+    ])
+
+    const c = report.suites[0].cases[0]
+    c.error.should.be.a('string')
+    c.skipped.should.equal(false)
+    chai.expect(c.failure).to.equal(null)
+  })
+
+  it('produces a self-contained document per invocation', () => {
+    generate([feature('first', [scenario('s1', [step('a', 'passed')])])])
+    const second = generate([feature('second', [scenario('s2', [step('b', 'passed')])])])
+
+    second.suites.length.should.equal(1)
+    second.suites[0].name.should.equal('Feature: second')
+    second.suites.map((s) => s.name).should.not.contain('Feature: first')
+  })
+})
