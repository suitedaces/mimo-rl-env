+import { describe, expect, it } from "vitest";
+import { mergeHeaders } from "../../src/utils/internal/proxy";
+
+describe("mergeHeaders (unit)", () => {
+  it("merges a Headers instance passed as a later input (issue repro)", () => {
+
+    const headers = new Headers();
+    headers.set("Authorization", "Bearer token-xyz");
+    headers.set("X-Domain", "example.com");
+
+
+    const eventHeaders = { "content-type": "application/json" };
+
+    const merged = mergeHeaders(eventHeaders, headers);
+
+    expect(merged).toBeInstanceOf(Headers);
+    expect((merged as Headers).get("Authorization")).toBe("Bearer token-xyz");
+    expect((merged as Headers).get("X-Domain")).toBe("example.com");
+
+    expect((merged as Headers).get("content-type")).toBe("application/json");
+  });
+
+  it("merges multiple Headers instances", () => {
+    const a = new Headers();
+    a.set("X-A", "a-value");
+    const b = new Headers();
+    b.set("X-B", "b-value");
+
+    const merged = mergeHeaders({}, a, b) as Headers;
+
+    expect(merged.get("X-A")).toBe("a-value");
+    expect(merged.get("X-B")).toBe("b-value");
+  });
+
+  it("uses a Headers instance as defaults", () => {
+    const defaults = new Headers();
+    defaults.set("X-Default", "from-default");
+
+    const merged = mergeHeaders(defaults, {
+      "x-extra": "from-extra",
+    }) as Headers;
+
+    expect(merged.get("X-Default")).toBe("from-default");
+    expect(merged.get("X-Extra")).toBe("from-extra");
+  });
+
+  it("later Headers override earlier ones for the same key", () => {
+    const first = new Headers();
+    first.set("X-Token", "old-value");
+    const second = new Headers();
+    second.set("X-Token", "new-value");
+
+    const merged = mergeHeaders({}, first, second) as Headers;
+
+    expect(merged.get("X-Token")).toBe("new-value");
+  });
+
+  it("merges array-of-tuples HeadersInit input", () => {
+    const arr: [string, string][] = [
+      ["X-Arr-One", "v1"],
+      ["X-Arr-Two", "v2"],
+    ];
+
+    const merged = mergeHeaders({}, arr) as Headers;
+
+    expect(merged.get("X-Arr-One")).toBe("v1");
+    expect(merged.get("X-Arr-Two")).toBe("v2");
+  });
+
+  it("merges plain object headers (preservation)", () => {
+    const merged = mergeHeaders(
+      { "x-base": "base" },
+      { "x-extra": "extra" },
+    ) as Headers;
+
+    expect(merged.get("x-base")).toBe("base");
+    expect(merged.get("x-extra")).toBe("extra");
+  });
+
+  it("skips undefined values in plain object inputs", () => {
+    const merged = mergeHeaders(
+      { "x-keep": "kept" },
+      { "x-skip": undefined as unknown as string, "x-add": "added" },
+    ) as Headers;
+
+    expect(merged.get("x-keep")).toBe("kept");
+    expect(merged.get("x-add")).toBe("added");
+    expect(merged.get("x-skip")).toBeNull();
+  });
+
+  it("merges a mix of plain object, Headers, and array inputs", () => {
+    const headersInput = new Headers();
+    headersInput.set("X-From-Headers", "h-val");
+    const arrInput: [string, string][] = [["X-From-Array", "a-val"]];
+    const objInput = { "x-from-object": "o-val" };
+
+    const merged = mergeHeaders(
+      { "x-base": "base-val" },
+      objInput,
+      headersInput,
+      arrInput,
+    ) as Headers;
+
+    expect(merged.get("x-base")).toBe("base-val");
+    expect(merged.get("x-from-object")).toBe("o-val");
+    expect(merged.get("x-from-headers")).toBe("h-val");
+    expect(merged.get("x-from-array")).toBe("a-val");
+  });
+
+  it("plain object value overrides a Headers value when ordered after it", () => {
+    const headersInput = new Headers();
+    headersInput.set("X-Conflict", "from-headers");
+
+    const merged = mergeHeaders({}, headersInput, {
+      "x-conflict": "from-object",
+    }) as Headers;
+
+    expect(merged.get("x-conflict")).toBe("from-object");
+  });
+
+  it("Headers value overrides an earlier plain object value", () => {
+    const headersInput = new Headers();
+    headersInput.set("X-Conflict", "from-headers");
+
+    const merged = mergeHeaders(
+      {},
+      { "x-conflict": "from-object" },
+      headersInput,
+    ) as Headers;
+
+    expect(merged.get("x-conflict")).toBe("from-headers");
+  });
+
+  it("Headers instance in defaults preserves entries when later inputs do not overwrite them", () => {
+    const defaults = new Headers();
+    defaults.set("Authorization", "Bearer default-token");
+    const later = new Headers();
+    later.set("X-Other", "other");
+
+    const merged = mergeHeaders(defaults, later) as Headers;
+
+    expect(merged.get("Authorization")).toBe("Bearer default-token");
+    expect(merged.get("X-Other")).toBe("other");
+  });
+});
