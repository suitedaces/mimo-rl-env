diff --git a/usercase-test-coderl/ascii8_stateful.test.js b/usercase-test-coderl/ascii8_stateful.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/ascii8_stateful.test.js
@@ -0,0 +1,260 @@
+const assert = require("assert");
+const fs = require("fs");
+const path = require("path");
+const vm = require("vm");
+const zlib = require("zlib");
+
+const REPO_ROOT = "/workspace/repo";
+
+function loadWebMSX() {
+  const context = {
+    console: { log() {}, warn() {}, error() {}, info() {} },
+    window: {},
+    WMSX_IMAGES_PATH: "",
+    btoa: str => Buffer.from(str, "binary").toString("base64"),
+    atob: str => Buffer.from(str, "base64").toString("binary"),
+    JSZip: {
+      compressions: {
+        DEFLATE: {
+          compress: arr => Array.from(zlib.deflateRawSync(Buffer.from(arr))),
+          uncompress: str => Array.from(zlib.inflateRawSync(Buffer.from(Array.from(str, ch => ch.charCodeAt(0) & 0xff))))
+        }
+      }
+    }
+  };
+  context.window = context;
+  vm.createContext(context);
+
+  [
+    "src/main/WMSX.js",
+    "src/main/util/Util.js",
+    "src/main/util/SHA1.js",
+    "src/main/util/EmbeddedFiles.js",
+    "src/main/msx/rom/ROMDatabase.js",
+    "src/main/msx/rom/ROM.js",
+    "src/main/msx/slots/SlotCreator.js",
+    "src/main/msx/slots/SlotFormats.js",
+    "src/main/msx/slots/Slot.js",
+    "src/main/msx/slots/SlotNormal.js",
+    "src/main/msx/slots/SlotPlainROM.js",
+    "src/main/msx/slots/cartridges/CartridgeASCII8K.js",
+    "src/main/msx/slots/cartridges/CartridgeASCII16K.js"
+  ].forEach(rel => {
+    vm.runInContext(fs.readFileSync(path.join(REPO_ROOT, rel), "utf8"), context, { filename: rel });
+  });
+
+  const wmsx = context.wmsx;
+  wmsx.Util.log = function() {};
+  wmsx.Configurator = { adaptROMSourceForOldState: source => source };
+  wmsx.CartridgePAC = { isPACFileContentValid: () => false };
+  wmsx.SlotCreator.setUserROMFormats({ getForROM: () => null });
+  return wmsx;
+}
+
+function makeAscii8Bytes(size, starts) {
+  const bankStarts = starts || [0x41, 0x11, 0x22, 0x33];
+  const bytes = new Array(size).fill(0);
+  bytes[0] = 0x41;
+  bytes[1] = 0x42;
+  for (let bank = 0; bank < bankStarts.length && bank * 8192 < size; bank++) {
+    bytes[bank * 8192] = bankStarts[bank];
+  }
+  return bytes;
+}
+
+function makeROM(wmsx, name, bytes, formatHint) {
+  return new wmsx.ROM(name, bytes.slice(), null, formatHint);
+}
+
+function sampleROM(wmsx, formatHint) {
+  return makeROM(wmsx, "ascii8.rom", makeAscii8Bytes(32768), formatHint);
+}
+
+function readProbe(cart) {
+  return [
+    cart.read(0x0000), cart.read(0x3fff),
+    cart.read(0x4000), cart.read(0x5fff),
+    cart.read(0x6000), cart.read(0x7fff),
+    cart.read(0x8000), cart.read(0x9fff),
+    cart.read(0xa000), cart.read(0xbfff),
+    cart.read(0xc000)
+  ];
+}
+
+function mappedStarts(cart) {
+  return [cart.read(0x4000), cart.read(0x6000), cart.read(0x8000), cart.read(0xa000)];
+}
+
+function test(name, fn) {
+  try {
+    fn();
+    console.log("ok - " + name);
+  } catch (err) {
+    console.error("not ok - " + name);
+    throw err;
+  }
+}
+
+test("ASCII8 user option and automatic acceptance boundaries", () => {
+
+
+  const wmsx = loadWebMSX();
+  assert.strictEqual(wmsx.SlotFormatsUserOptions.includes("ASCII8"), true);
+
+  assert.strictEqual(!!wmsx.SlotFormats.ASCII8.priorityForRom(sampleROM(wmsx)), true);
+
+  assert.strictEqual(!!wmsx.SlotFormats.ASCII8.priorityForRom(makeROM(wmsx, "badlen.rom", makeAscii8Bytes(24577))), false);
+  const noHeader = makeAscii8Bytes(32768);
+  noHeader[0] = 0x00;
+  noHeader[1] = 0x00;
+
+  assert.strictEqual(!!wmsx.SlotFormats.ASCII8.priorityForRom(makeROM(wmsx, "noheader.rom", noHeader)), false);
+});
+
+test("SlotCreator can create ASCII8 cartridge from public ROM with explicit user format hint", () => {
+
+
+  const wmsx = loadWebMSX();
+  const cart = wmsx.SlotCreator.createFromROM(sampleROM(wmsx, "ASCII8"));
+  assert.strictEqual(cart.format.name, "ASCII8");
+  assert.strictEqual(cart instanceof wmsx.CartridgeASCII8K, true);
+  cart.reset();
+  assert.deepStrictEqual(readProbe(cart), [255, 255, 65, 0, 65, 0, 65, 0, 65, 0, 255]);
+});
+
+test("reset maps all four pages to bank zero and outside reads to 0xff", () => {
+
+
+  const wmsx = loadWebMSX();
+  const cart = new wmsx.CartridgeASCII8K(sampleROM(wmsx));
+
+  ["powerOn", "reset", "write", "read", "saveState", "loadState"].forEach(method => {
+    assert.strictEqual(typeof cart[method], "function");
+  });
+  cart.reset();
+  assert.deepStrictEqual(readProbe(cart), [255, 255, 65, 0, 65, 0, 65, 0, 65, 0, 255]);
+});
+
+test("powerOn resets all pages to bank zero", () => {
+
+
+  const wmsx = loadWebMSX();
+  const cart = new wmsx.CartridgeASCII8K(sampleROM(wmsx));
+  cart.powerOn();
+  assert.deepStrictEqual(readProbe(cart), [255, 255, 65, 0, 65, 0, 65, 0, 65, 0, 255]);
+});
+
+test("writes update the addressed 8 KiB page and use modulo bank selection", () => {
+
+
+  const wmsx = loadWebMSX();
+  const cart = new wmsx.CartridgeASCII8K(sampleROM(wmsx));
+  cart.reset();
+  assert.deepStrictEqual(readProbe(cart), [255, 255, 65, 0, 65, 0, 65, 0, 65, 0, 255]);
+  cart.write(0x6000, 2);
+  assert.deepStrictEqual(readProbe(cart), [255, 255, 34, 0, 65, 0, 65, 0, 65, 0, 255]);
+  cart.write(0x6800, 3);
+  assert.deepStrictEqual(readProbe(cart), [255, 255, 34, 0, 51, 0, 65, 0, 65, 0, 255]);
+  cart.write(0x7000, 5);
+  assert.deepStrictEqual(readProbe(cart), [255, 255, 34, 0, 51, 0, 17, 0, 65, 0, 255]);
+});
+
+test("writes below 0x6000 are ignored", () => {
+
+
+  const wmsx = loadWebMSX();
+  const cart = new wmsx.CartridgeASCII8K(sampleROM(wmsx));
+  cart.reset();
+  cart.write(0x6000, 2);
+  cart.write(0x6800, 3);
+  cart.write(0x7000, 5);
+  assert.deepStrictEqual(readProbe(cart), [255, 255, 34, 0, 51, 0, 17, 0, 65, 0, 255]);
+  cart.write(0x5fff, 3);
+  assert.deepStrictEqual(readProbe(cart), [255, 255, 34, 0, 51, 0, 17, 0, 65, 0, 255]);
+});
+
+test("saveState serializes format, ROM state, ROM bytes, selected offsets, and bank count", () => {
+
+
+  const wmsx = loadWebMSX();
+  const cart = new wmsx.CartridgeASCII8K(sampleROM(wmsx));
+  cart.reset();
+  cart.write(0x6000, 2);
+  cart.write(0x6800, 3);
+  cart.write(0x7000, 5);
+  const state = cart.saveState();
+  const serialized = JSON.stringify(state);
+  const parsed = JSON.parse(serialized);
+
+
+  assert.strictEqual(serialized.includes("ASCII8"), true);
+
+  const loaded = new wmsx.CartridgeASCII8K();
+  loaded.loadState(parsed);
+
+  assert.deepStrictEqual(readProbe(loaded), [255, 255, 34, 0, 51, 0, 17, 0, 65, 0, 255]);
+
+  loaded.write(0x6000, 5);
+
+  assert.strictEqual(loaded.read(0x4000), 17);
+
+  const viaCreator = wmsx.SlotCreator.recreateFromSaveState(parsed);
+
+  assert.deepStrictEqual(mappedStarts(viaCreator), [34, 51, 17, 65]);
+});
+
+test("loadState and recreateFromSaveState preserve mapped reads and reusable slot", () => {
+
+
+  const wmsx = loadWebMSX();
+  const cart = new wmsx.CartridgeASCII8K(sampleROM(wmsx));
+  cart.reset();
+  cart.write(0x6000, 2);
+  cart.write(0x6800, 3);
+  cart.write(0x7000, 5);
+  const state = cart.saveState();
+
+  const loaded = new wmsx.CartridgeASCII8K();
+  loaded.loadState(state);
+  assert.deepStrictEqual(readProbe(loaded), [255, 255, 34, 0, 51, 0, 17, 0, 65, 0, 255]);
+
+  const reusable = new wmsx.CartridgeASCII8K(makeROM(wmsx, "reusable.rom", makeAscii8Bytes(32768, [0x41, 0xaa, 0xbb, 0xcc])));
+  reusable.reset();
+  const recreated = wmsx.CartridgeASCII8K.recreateFromSaveState(state, reusable);
+  assert.strictEqual(recreated === reusable, true);
+  assert.deepStrictEqual(readProbe(recreated), [255, 255, 34, 0, 51, 0, 17, 0, 65, 0, 255]);
+
+  const viaCreator = wmsx.SlotCreator.recreateFromSaveState(state, recreated);
+  assert.strictEqual(viaCreator === recreated, true);
+  assert.deepStrictEqual(readProbe(viaCreator), [255, 255, 34, 0, 51, 0, 17, 0, 65, 0, 255]);
+});
+
+test("separate ASCII8 instances keep independent selected-bank state", () => {
+
+
+  const wmsx = loadWebMSX();
+  const a = new wmsx.CartridgeASCII8K(makeROM(wmsx, "a.rom", makeAscii8Bytes(32768)));
+  const b = new wmsx.CartridgeASCII8K(makeROM(wmsx, "b.rom", makeAscii8Bytes(32768)));
+  a.reset();
+  b.reset();
+  a.write(0x6000, 2);
+  b.write(0x6800, 3);
+  assert.deepStrictEqual([a.read(0x4000), a.read(0x6000), a.read(0x8000), a.read(0xa000)], [34, 65, 65, 65]);
+  assert.deepStrictEqual([b.read(0x4000), b.read(0x6000), b.read(0x8000), b.read(0xa000)], [65, 51, 65, 65]);
+});
+
+test("repeated construct-use-save-recreate cycles preserve ASCII8 behavior", () => {
+
+
+  const wmsx = loadWebMSX();
+
+  for (let i = 0; i < 500; i++) {
+    const cart = wmsx.SlotCreator.createFromROM(sampleROM(wmsx, "ASCII8"));
+    cart.reset();
+    cart.write(0x6000, 2);
+    assert.strictEqual(cart.read(0x4000), 34);
+    const state = cart.saveState();
+    const recreated = wmsx.CartridgeASCII8K.recreateFromSaveState(state);
+    assert.strictEqual(recreated.read(0x4000), 34);
+  }
+});
