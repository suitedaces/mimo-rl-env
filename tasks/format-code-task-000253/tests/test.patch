+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+PY=/testbed/.build_env/venv/bin/python
+
+
+
+cat > /testbed/local_settings.py <<'EOF'
+# -*- coding: utf-8 -*-
+DATABASES = {"default": {"ENGINE": "django.db.backends.sqlite3", "NAME": "db.sqlite3"}}
+LOG_LEVEL = "DEBUG"
+BK_IAM_SKIP = 1
+COMPATIBLE_MODULE_MAP = {}
+ROOT_URLCONF = "_minimal_urls"
+EOF
+
+
+
+
+SHIM_DIR="$(mktemp -d)"
+cat > "$SHIM_DIR/sitecustomize.py" <<'EOF'
+try:
+    import celery
+    if not hasattr(celery, "task"):
+        celery.task = celery.shared_task
+except Exception:
+    pass
+EOF
+cat > "$SHIM_DIR/_minimal_urls.py" <<'EOF'
+urlpatterns = []
+EOF
+
+# shellcheck disable=SC1091
+source scripts/develop/sites/community/env.sh
+export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
+export BKAPP_AUTO_UPDATE_VARIABLE_MODELS=0
+export BKAPP_AUTO_UPDATE_COMPONENT_MODELS=0
+export PYTHONPATH="$SHIM_DIR:${PYTHONPATH:-}"
+
+
+"$PY" manage.py test \
+    pipeline_web.tests.parser.format.test_format_web_data_to_pipeline \
+    gcloud.tests.taskflow3.domains.test_auto_retry
+
+
+"$PY" manage.py test gcloud.tests.taskflow3.test_node_timeout_feature
