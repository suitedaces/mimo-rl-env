+test("separate Gists and Gist instances keep independent arrays", () => {
+
+
+  const { Gh3 } = installGh3((request) => {
+    const bodies = {
+      "users/alpha/gists": [{ id: "alpha-1", description: "alpha only", comments: 0 }],
+      "users/beta/gists": [
+        { id: "beta-1", description: "beta first", comments: 0 },
+        { id: "beta-2", description: "beta second", comments: 0 }
+      ],
+      "gists/one": {
+        id: "one",
+        files: { "one.js": { filename: "one.js", size: 1 } }
+      },
+      "gists/one/comments": [
+        { id: 101, body: "one comment", user: { login: "one-user" } }
+      ]
+    };
+
+    return { body: bodies[request.endpoint] };
+  });
+
+  const alpha = new Gh3.Gists(new Gh3.User("alpha"));
+  const beta = new Gh3.Gists(new Gh3.User("beta"));
+  alpha.fetch({ page: 1 }, null, () => {});
+  assert.deepStrictEqual(alpha.getGists().map((gist) => gist.id), ["alpha-1"]);
+  assert.deepStrictEqual(beta.getGists().map((gist) => gist.id), []);
+
+  beta.fetch({ page: 1 }, null, () => {});
+  assert.deepStrictEqual(alpha.getGists().map((gist) => gist.id), ["alpha-1"]);
+  assert.deepStrictEqual(beta.getGists().map((gist) => gist.id), ["beta-1", "beta-2"]);
+
+  const one = new Gh3.Gist({
+    id: "one",
+    files: [{ filename: "one-seed" }],
+    comments: [{ id: 11, body: "one seed" }]
+  });
+  const two = new Gh3.Gist({
+    id: "two",
+    files: [{ filename: "two-seed" }],
+    comments: [{ id: 22, body: "two seed" }]
+  });
+  one.fetchContents(() => {});
+  one.fetchComments(() => {});
+
+  assert.deepStrictEqual(one.getFiles().map((file) => file.filename), ["one.js"]);
+  assert.deepStrictEqual(two.getFiles().map((file) => file.filename), ["two-seed"]);
+  assert.deepStrictEqual(one.getComments().map((comment) => `${comment.id}:${comment.body}`), ["101:one comment"]);
+  assert.deepStrictEqual(two.getComments().map((comment) => `${comment.id}:${comment.body}`), ["22:two seed"]);
+});
+
+test("repeated public gist sessions keep independent arrays", () => {
+
+
+  const observedLists = [];
+  const observedGists = [];
+
+  const { Gh3 } = installGh3((request) => {
+    if (request.endpoint.indexOf("/comments") !== -1) {
+      return { body: [{ id: 1, body: "cycle comment", user: { login: "cycle" } }] };
+    }
+    if (request.endpoint.indexOf("gists/cycle-") === 0) {
+      return { body: { id: request.endpoint.slice("gists/".length), files: { "cycle.js": { filename: "cycle.js", size: 1 } } } };
+    }
+    return { body: [{ id: "cycle-list", description: "cycle", comments: 1 }] };
+  });
+
+  for (let index = 0; index < 120; index += 1) {
+    const list = new Gh3.Gists(new Gh3.User(`cycle-user-${index}`));
+    list.fetch({ page: 1, per_page: 1 }, null, () => {});
+    assert.deepStrictEqual(list.getGists().map((gist) => gist.id), ["cycle-list"]);
+
+    const gist = new Gh3.Gist({ id: `cycle-${index}` });
+    gist.fetchContents(() => {});
+    gist.fetchComments(() => {});
+    assert.deepStrictEqual(gist.getFiles().map((file) => file.filename), ["cycle.js"]);
+    assert.deepStrictEqual(gist.getComments().map((comment) => comment.body), ["cycle comment"]);
+    if (index < 2) {
+      observedLists.push(list);
+      observedGists.push(gist);
+    }
+  }
+
+
+
+  observedLists[0].getGists().push(new Gh3.Gist({ id: "manual-list-mutation" }));
+  assert.deepStrictEqual(observedLists[1].getGists().map((gist) => gist.id), ["cycle-list"]);
+  observedGists[0].getFiles().push({ filename: "manual-file-mutation" });
+  observedGists[0].getComments().push(new Gh3.GistComment({ id: 999, body: "manual-comment-mutation" }));
+  assert.deepStrictEqual(observedGists[1].getFiles().map((file) => file.filename), ["cycle.js"]);
+  assert.deepStrictEqual(observedGists[1].getComments().map((comment) => comment.body), ["cycle comment"]);
+});
diff --git a/usercase-test-coderl/offline_network_guard.cjs b/usercase-test-coderl/offline_network_guard.cjs
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/offline_network_guard.cjs
@@ -0,0 +1,60 @@
+
+"use strict";
+
+const blocked = (api) => function blockedNetworkCall() {
+  throw new Error(`local offline network guard blocked ${api}`);
+};
+
+const patchFunction = (object, name, api) => {
+  if (object && typeof object[name] === "function") {
+    object[name] = blocked(api);
+  }
+};
+
+for (const moduleName of ["node:http", "node:https", "node:http2"]) {
+  try {
+    const mod = require(moduleName);
+    patchFunction(mod, "request", `${moduleName}.request`);
+    patchFunction(mod, "get", `${moduleName}.get`);
+    patchFunction(mod, "connect", `${moduleName}.connect`);
+  } catch (_) {
+
+  }
+}
+
+try {
+  const net = require("node:net");
+  patchFunction(net, "connect", "node:net.connect");
+  patchFunction(net, "createConnection", "node:net.createConnection");
+  patchFunction(net.Socket && net.Socket.prototype, "connect", "node:net.Socket.connect");
+} catch (_) {}
+
+try {
+  const tls = require("node:tls");
+  patchFunction(tls, "connect", "node:tls.connect");
+} catch (_) {}
+
+try {
+  const dgram = require("node:dgram");
+  patchFunction(dgram, "createSocket", "node:dgram.createSocket");
+} catch (_) {}
+
+try {
+  const dns = require("node:dns");
+  for (const name of ["lookup", "resolve", "resolve4", "resolve6", "resolveCname", "resolveMx", "resolveTxt", "resolveSrv", "resolveNs", "resolveSoa", "reverse"]) {
+    patchFunction(dns, name, `node:dns.${name}`);
+  }
+  if (dns.promises) {
+    for (const name of ["lookup", "resolve", "resolve4", "resolve6", "resolveCname", "resolveMx", "resolveTxt", "resolveSrv", "resolveNs", "resolveSoa", "reverse"]) {
+      patchFunction(dns.promises, name, `node:dns.promises.${name}`);
+    }
+  }
+} catch (_) {}
+
+if (typeof globalThis.fetch === "function") {
+  globalThis.fetch = blocked("globalThis.fetch");
+}
+
+if (typeof globalThis.WebSocket === "function") {
+  globalThis.WebSocket = blocked("globalThis.WebSocket");
+}
