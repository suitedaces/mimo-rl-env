+
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+const GH3_PATH = "/workspace/repo/gh3.js";
+
+
+
+function endpointFrom(params) {
+  if (typeof params.url === "string" && params.url.length > 0) {
+    try {
+      return new URL(params.url, "https://api.github.com").pathname.replace(/^\/+/, "");
+    } catch (_) {
+      return params.url.split("?")[0].replace(/^\/+/, "");
+    }
+  }
+  if (typeof params.service === "string") {
+    return params.service.replace(/^\/+/, "");
+  }
+  return undefined;
+}
+
+function queryFrom(params) {
+  const query = {};
+  if (typeof params.url === "string") {
+    try {
+      const url = new URL(params.url, "https://api.github.com");
+      for (const [key, value] of url.searchParams) {
+        query[key] = value;
+      }
+    } catch (_) {}
+  }
+  if (params.data && typeof params.data === "object") {
+    Object.assign(query, params.data);
+  }
+  return query;
+}
+
+function assertRequest(request, endpoint, expectedQuery) {
+  assert.equal(request.endpoint, endpoint);
+  if (expectedQuery) {
+    for (const [key, value] of Object.entries(expectedQuery)) {
+      assert.equal(String(request.query[key]), String(value));
+    }
+  }
+}
+
+function installGh3(handler) {
+  const requests = [];
+
+  global.window = { XDomainRequest: null };
+  global.$ = {
+    support: { cors: true },
+    ajaxSetup: {},
+    isFunction(fn) {
+      return typeof fn === "function";
+    },
+    ajax(params) {
+      const request = {
+        endpoint: endpointFrom(params),
+        query: queryFrom(params),
+        service: params.service,
+        url: params.url
+      };
+      if (Object.prototype.hasOwnProperty.call(params, "data")) {
+        request.data = params.data;
+      }
+      requests.push(request);
+
+      const response = handler(request, requests.length);
+      if (response && response.error) {
+        params.error(response.error);
+      } else {
+        params.success(response ? response.body : undefined);
+      }
+    }
+  };
+
+  global._ = {
+    each(value, callback) {
+      if (value == null) return;
+      if (Array.isArray(value)) {
+        value.forEach(callback);
+        return;
+      }
+      Object.keys(value).forEach((key) => callback(value[key], key));
+    },
+    find(value, comparator) {
+      if (value == null) return undefined;
+      for (const item of value) {
+        if (comparator(item)) return item;
+      }
+      return undefined;
+    },
+    filter(value, comparator) {
+      const matches = [];
+      if (value == null) return matches;
+      for (const item of value) {
+        if (comparator(item)) matches.push(item);
+      }
+      return matches;
+    }
+  };
+
+  delete require.cache[require.resolve(GH3_PATH)];
+  return { Gh3: require(GH3_PATH), requests };
+}
+
+test("Gh3.Gists fetch appends pages and exposes the accumulated list", () => {
+
+
+  let fetchCall = 0;
+  const { Gh3, requests } = installGh3((request) => {
+
+    assert.equal(request.endpoint, "users/octo/gists");
+    fetchCall += 1;
+    return {
+      body: fetchCall === 1
+        ? [{ id: "g-1", description: "first page", comments: 1 }]
+        : [
+          { id: "g-2", description: "second page", comments: 0 },
+          { id: "g-3", description: "second more", comments: 2 }
+        ]
+    };
+  });
+
+  const gists = new Gh3.Gists(new Gh3.User("octo"));
+  assert.deepStrictEqual(gists.getGists().map((gist) => gist.id), []);
+
+  let firstCallback = { err: "not-called", sameInstance: false };
+  gists.fetch({ page: 1, per_page: 1 }, null, (err, result) => {
+    firstCallback = { err, sameInstance: result === gists };
+  });
+
+  assertRequest(requests[0], "users/octo/gists", { page: 1, per_page: 1 });
+  assert.equal(firstCallback.err, null);
+  assert.equal(firstCallback.sameInstance, true);
+  assert.deepStrictEqual(gists.getGists().map((gist) => gist.id), ["g-1"]);
+  assert.deepStrictEqual(gists.getGists().map((gist) => gist.description), ["first page"]);
+  assert.deepStrictEqual(gists.getGists().map((gist) => gist.constructor === Gh3.Gist), [true]);
+
+  let secondCallback = { err: "not-called", sameInstance: false };
+  gists.fetch({ page: 2, per_page: 2 }, "next", (err, result) => {
+    secondCallback = { err, sameInstance: result === gists };
+  });
+
+  assertRequest(requests[1], "users/octo/gists", { page: 2, per_page: 2 });
+  assert.equal(secondCallback.err, null);
+  assert.equal(secondCallback.sameInstance, true);
+  assert.deepStrictEqual(gists.getGists().map((gist) => gist.id), ["g-1", "g-2", "g-3"]);
+
+  const eachDescriptions = [];
+  gists.eachGist((gist) => eachDescriptions.push(gist.description));
+  assert.deepStrictEqual(eachDescriptions, ["first page", "second page", "second more"]);
+  assert.deepStrictEqual(gists.filter((gist) => gist.comments > 0).map((gist) => gist.id), ["g-1", "g-3"]);
+});
+
+test("Gh3.Gists fetch reports GitHub API errors as Error(message) with raw response", () => {
+
+
+  const { Gh3, requests } = installGh3(() => ({
+    error: { responseJSON: { message: "No gists for ghost" }, status: 404 }
+  }));
+
+  const gists = new Gh3.Gists(new Gh3.User("ghost"));
+  let callback = { errName: "not-called", message: "", status: 0, sameResponse: false };
+  gists.fetch({ page: 9 }, "next", (err, response) => {
+    callback = {
+      errName: err.constructor.name,
+      message: err.message,
+      status: response.status,
+      sameResponse: response.responseJSON.message === "No gists for ghost"
+    };
+  });
+
+
+  assertRequest(requests[0], "users/ghost/gists", { page: 9 });
+  assert.deepStrictEqual(callback, {
+    errName: "Error",
+    message: "No gists for ghost",
+    status: 404,
+    sameResponse: true
+  });
+  assert.deepStrictEqual(gists.getGists().map((gist) => gist.id), []);
+});
+
+test("Gh3.Gist fetchContents resets files, copies metadata, and exposes file helpers", () => {
+
+
+  let contentCall = 0;
+  const { Gh3, requests } = installGh3((request) => {
+
+    assert.equal(request.endpoint, "gists/detail-1");
+    contentCall += 1;
+    return {
+      body: contentCall === 1
+        ? {
+          id: "detail-1",
+          revision: "first",
+          description: "first content",
+          files: {
+            "old.js": { filename: "old.js", language: "JavaScript", type: "application/javascript", size: 3, content: "old" }
+          }
+        }
+        : {
+          id: "detail-1",
+          revision: "second",
+          description: "second content",
+          public: true,
+          owner: { login: "octo" },
+          files: {
+            "new.js": { filename: "new.js", language: "JavaScript", type: "application/javascript", size: 4, content: "new" },
+            "note.txt": { filename: "note.txt", language: "Text", type: "text/plain", size: 5, content: "note" }
+          }
+        }
+    };
+  });
+
+  const gist = new Gh3.Gist({
+    id: "detail-1",
+    description: "seed",
+    files: [{ filename: "stale.txt" }],
+    comments: [{ id: 99 }]
+  });
+  assert.deepStrictEqual({
+    id: gist.id,
+    description: gist.description,
+    files: gist.files.map((file) => file.filename),
+    comments: gist.comments.map((comment) => comment.id)
+  }, {
+    id: "detail-1",
+    description: "seed",
+    files: ["stale.txt"],
+    comments: [99]
+  });
+
+  let firstCallback = { err: "not-called", sameInstance: false };
+  gist.fetchContents((err, result) => {
+    firstCallback = { err, sameInstance: result === gist };
+  });
+
+  assertRequest(requests[0], "gists/detail-1");
+  assert.equal(firstCallback.err, null);
+  assert.equal(firstCallback.sameInstance, true);
+  assert.deepStrictEqual({
+    revision: gist.revision,
+    description: gist.description,
+    files: gist.getFiles().map((file) => file.filename)
+  }, {
+    revision: "first",
+    description: "first content",
+    files: ["old.js"]
+  });
+
+  let secondCallback = { err: "not-called", sameInstance: false };
+  gist.fetchContents((err, result) => {
+    secondCallback = { err, sameInstance: result === gist };
+  });
+  assert.equal(secondCallback.err, null);
+  assert.equal(secondCallback.sameInstance, true);
+  const secondFileNames = gist.getFiles().map((file) => file.filename);
+  assert.deepStrictEqual({
+    revision: gist.revision,
+    description: gist.description,
+    public: gist.public,
+    owner: gist.owner
+  }, {
+    revision: "second",
+    description: "second content",
+    public: true,
+    owner: { login: "octo" }
+  });
+
+  assert.deepStrictEqual(new Set(secondFileNames), new Set(["new.js", "note.txt"]));
+  assert.deepStrictEqual(gist.getFileByName("new.js"), {
+    filename: "new.js",
+    language: "JavaScript",
+    type: "application/javascript",
+    size: 4,
+    content: "new"
+  });
+
+  const eachFiles = [];
+  gist.eachFile((file) => eachFiles.push(`${file.filename}:${file.size}`));
+
+  assert.deepStrictEqual(new Set(eachFiles), new Set(["new.js:4", "note.txt:5"]));
+});
+
