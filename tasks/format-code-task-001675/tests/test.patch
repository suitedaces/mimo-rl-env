+test("Gh3.Gist fetchComments resets comments and exposes comment helpers", () => {
+
+
+  let commentCall = 0;
+  const { Gh3, requests } = installGh3((request) => {
+
+    assert.equal(request.endpoint, "gists/detail-1/comments");
+    commentCall += 1;
+    return {
+      body: commentCall === 1
+        ? [
+          { id: 1, body: "old", user: { login: "olduser" } },
+          { id: 2, body: "extra", user: { login: "olduser" } }
+        ]
+        : [
+          { id: 3, body: "new", user: { login: "newuser" } }
+        ]
+    };
+  });
+
+  const gist = new Gh3.Gist({
+    id: "detail-1",
+    comments: [{ id: 99, body: "stale", user: { login: "seed" } }]
+  });
+  assert.deepStrictEqual(gist.getComments().map((comment) => `${comment.id}:${comment.body}`), ["99:stale"]);
+
+  let firstCallback = { err: "not-called", sameInstance: false };
+  gist.fetchComments((err, result) => {
+    firstCallback = { err, sameInstance: result === gist };
+  });
+
+  assertRequest(requests[0], "gists/detail-1/comments");
+  assert.equal(firstCallback.err, null);
+  assert.equal(firstCallback.sameInstance, true);
+  assert.deepStrictEqual(gist.getComments().map((comment) => `${comment.id}:${comment.body}`), ["1:old", "2:extra"]);
+  assert.deepStrictEqual(gist.getComments().map((comment) => comment.constructor === Gh3.GistComment), [true, true]);
+
+  let secondCallback = { err: "not-called", sameInstance: false };
+  gist.fetchComments((err, result) => {
+    secondCallback = { err, sameInstance: result === gist };
+  });
+  assert.equal(secondCallback.err, null);
+  assert.equal(secondCallback.sameInstance, true);
+  assert.deepStrictEqual(gist.getComments().map((comment) => `${comment.id}:${comment.body}`), ["3:new"]);
+  assert.deepStrictEqual(gist.getComments().map((comment) => comment.constructor === Gh3.GistComment), [true]);
+
+  const eachComments = [];
+  gist.eachComment((comment) => eachComments.push(`${comment.id}:${comment.user.login}`));
+  assert.deepStrictEqual(eachComments, ["3:newuser"]);
+  assert.deepStrictEqual(gist.filterComments((comment) => comment.user.login === "newuser").map((comment) => comment.body), ["new"]);
+});
