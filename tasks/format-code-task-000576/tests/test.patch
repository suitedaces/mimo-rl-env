+++ b/src/commands/workspaces/__tests__/exec.test.js
@@ -0,0 +1,39 @@
+
+import { workspacesExec, toWorkspacesExecOptions } from '../exec';
+import { copyFixtureIntoTempDir } from 'jest-fixtures';
+import * as path from 'path';
+import * as processes from '../../../utils/processes';
+
+jest.mock('../../../utils/processes');
+
+const unsafeProcesses: any & typeof processes = processes;
+const binDir = path.join('node_modules', '.bin');
+
+describe('pyarn workspaces exec', () => {
+  test('runs in every workspace', async () => {
+    let { tempDir: projectDir } = await copyFixtureIntoTempDir(
+      __dirname,
+      'project-with-bins'
+    );
+    let fooWorkspaceDir = path.join(projectDir, 'packages', 'foo');
+    let barWorkspaceDir = path.join(projectDir, 'packages', 'bar');
+
+    await workspacesExec(
+      toWorkspacesExecOptions([], {
+        cwd: projectDir,
+        '--': ['dep-with-bin']
+      })
+    );
+
+    expect(unsafeProcesses.spawn).toHaveBeenCalledTimes(2);
+
+    let calledCwds = unsafeProcesses.spawn.mock.calls.map(call => call[2].cwd);
+    expect(calledCwds).toContain(fooWorkspaceDir);
+    expect(calledCwds).toContain(barWorkspaceDir);
+
+    unsafeProcesses.spawn.mock.calls.forEach(call => {
+      expect(call[0]).toBe('dep-with-bin');
+      expect(call[1]).toEqual([]);
+    });
+  });
+});
