@@ -0,0 +1,303 @@
+import { TSGhostAdminAPI } from "../packages/ts-ghost-admin-api/src/index";
+import {
+  APIComposer,
+  HTTPClientFactory,
+  baseTagsSchema,
+  slugOrIdSchema,
+} from "../packages/ts-ghost-core-api/src/index";
+
+
+
+
+
+
+
+
+
+const ADMIN_KEY =
+  "1efedd9db174adee2d23d982:4b74dca0219bad629852191af326a45037346c2231240e0f7aec1f9371cc14e8";
+
+type QueuedFetch =
+  | { kind: "response"; status: number; body?: unknown }
+  | { kind: "throw"; error: Error };
+
+type FetchCall = {
+  url: string;
+  method: string | undefined;
+};
+
+type ExpectedDeleteCall = {
+  origin: string;
+  pathname: string;
+  key?: string;
+};
+
+const queuedFetches: QueuedFetch[] = [];
+const fetchCalls: FetchCall[] = [];
+
+function installFetchStub() {
+  queuedFetches.length = 0;
+  fetchCalls.length = 0;
+
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async (url: string, init?: RequestInit) => {
+      fetchCalls.push({
+        url,
+        method: init?.method,
+      });
+
+      const next = queuedFetches.shift();
+      if (!next) {
+        throw new Error("missing queued fetch response");
+      }
+      if (next.kind === "throw") {
+        throw next.error;
+      }
+
+      return new Response(next.body === undefined ? null : JSON.stringify(next.body), {
+        status: next.status,
+        headers: { "Content-Type": "application/json" },
+      });
+    }),
+  );
+}
+
+function makeAdminAPI(url = "https://ghost.org") {
+  return new TSGhostAdminAPI(url, ADMIN_KEY, "v6.0");
+}
+
+function makeCustomTagClient() {
+  return new APIComposer(
+    "tags",
+    {
+      schema: baseTagsSchema,
+      identitySchema: slugOrIdSchema,
+      include: baseTagsSchema,
+    },
+    new HTTPClientFactory({
+      url: "https://ghost.org",
+      key: ADMIN_KEY,
+      version: "v6.0",
+      endpoint: "admin",
+    }),
+  ).access(["delete"]);
+}
+
+function expectDeleteCall(call: FetchCall | undefined, expected: ExpectedDeleteCall) {
+  expect(call).toBeDefined();
+  expect(call?.method).toBe("DELETE");
+  const url = new URL(call?.url ?? "http://invalid.local");
+  expect(url.origin).toBe(expected.origin);
+
+  expect(url.pathname.replace(/\/+$/, "")).toBe(expected.pathname.replace(/\/+$/, ""));
+  if (expected.key !== undefined) {
+    expect(url.searchParams.get("key")).toBe(expected.key);
+  } else {
+    expect(url.search).toBe("");
+  }
+}
+
+beforeEach(() => {
+  installFetchStub();
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+test("admin resource clients expose delete methods", () => {
+
+
+  const api = makeAdminAPI();
+
+  expect(typeof api.posts.delete).toBe("function");
+  expect(typeof api.pages.delete).toBe("function");
+  expect(typeof api.members.delete).toBe("function");
+  expect(typeof api.tags.delete).toBe("function");
+  expect(typeof api.webhooks.delete).toBe("function");
+});
+
+test("admin delete sends resource identity DELETE requests and resolves 204 successes", async () => {
+
+
+  const api = makeAdminAPI();
+  queuedFetches.push(
+    { kind: "response", status: 204 },
+    { kind: "response", status: 204 },
+    { kind: "response", status: 204 },
+    { kind: "response", status: 204 },
+    { kind: "response", status: 204 },
+  );
+
+  await expect(api.posts.delete("post-id-1")).resolves.toStrictEqual({ success: true });
+
+  expect(fetchCalls).toHaveLength(1);
+  expectDeleteCall(fetchCalls[0], {
+    origin: "https://ghost.org",
+    pathname: "/ghost/api/admin/posts/post-id-1",
+  });
+
+  await expect(api.pages.delete("page-id-1")).resolves.toStrictEqual({ success: true });
+
+  expect(fetchCalls).toHaveLength(2);
+  expectDeleteCall(fetchCalls[1], {
+    origin: "https://ghost.org",
+    pathname: "/ghost/api/admin/pages/page-id-1",
+  });
+
+  await expect(api.members.delete("member-id-1")).resolves.toStrictEqual({ success: true });
+
+  expect(fetchCalls).toHaveLength(3);
+  expectDeleteCall(fetchCalls[2], {
+    origin: "https://ghost.org",
+    pathname: "/ghost/api/admin/members/member-id-1",
+  });
+
+  await expect(api.tags.delete("tag-id-1")).resolves.toStrictEqual({ success: true });
+
+  expect(fetchCalls).toHaveLength(4);
+  expectDeleteCall(fetchCalls[3], {
+    origin: "https://ghost.org",
+    pathname: "/ghost/api/admin/tags/tag-id-1",
+  });
+
+  await expect(api.webhooks.delete("webhook-id-1")).resolves.toStrictEqual({ success: true });
+
+  expect(fetchCalls).toHaveLength(5);
+  expectDeleteCall(fetchCalls[4], {
+    origin: "https://ghost.org",
+    pathname: "/ghost/api/admin/webhooks/webhook-id-1",
+  });
+});
+
+test("admin delete resolves Ghost error JSON with status", async () => {
+
+
+  const api = makeAdminAPI();
+  queuedFetches.push({
+    kind: "response",
+    status: 404,
+    body: {
+      errors: [{ type: "NotFoundError", message: "Resource not found", context: "Could not find Post" }],
+    },
+  });
+
+  await expect(api.posts.delete("missing-post")).resolves.toStrictEqual({
+    success: false,
+    errors: [{ type: "NotFoundError", message: "Resource not found", context: "Could not find Post" }],
+    status: 404,
+  });
+
+  expect(fetchCalls).toHaveLength(1);
+  expectDeleteCall(fetchCalls[0], {
+    origin: "https://ghost.org",
+    pathname: "/ghost/api/admin/posts/missing-post",
+  });
+});
+
+test("admin delete resolves fetch throws as status zero FetchError", async () => {
+
+
+  const api = makeAdminAPI();
+  queuedFetches.push({ kind: "throw", error: new Error("socket exploded") });
+
+  const result = await api.pages.delete("page-id-1");
+
+
+  expect(result.success).toBe(false);
+  if (!result.success) {
+    expect(result.status).toBe(0);
+    expect(result.errors).toHaveLength(1);
+    expect(result.errors[0]?.type).toBe("FetchError");
+  }
+
+  expect(fetchCalls).toHaveLength(1);
+  expectDeleteCall(fetchCalls[0], {
+    origin: "https://ghost.org",
+    pathname: "/ghost/api/admin/pages/page-id-1",
+  });
+});
+
+test("delete rejects empty id before making a request", async () => {
+
+
+  const api = makeAdminAPI();
+  const error = await api.posts.delete("").then(
+    () => undefined,
+    (caught) => caught,
+  );
+
+
+  expect(error).toBeDefined();
+  expect(fetchCalls).toHaveLength(0);
+});
+
+test("custom APIComposer resource clients expose and run delete", async () => {
+
+
+  const customTags = makeCustomTagClient();
+  queuedFetches.push({ kind: "response", status: 204 });
+
+  expect(typeof customTags.delete).toBe("function");
+  await expect(customTags.delete("custom-tag")).resolves.toStrictEqual({ success: true });
+
+  expect(fetchCalls).toHaveLength(1);
+  expectDeleteCall(fetchCalls[0], {
+    origin: "https://ghost.org",
+    pathname: "/ghost/api/admin/tags/custom-tag",
+  });
+});
+
+test("separate admin client instances keep their own base URL state", async () => {
+
+
+  const a = makeAdminAPI("https://ghost-a.example");
+  const b = makeAdminAPI("https://ghost-b.example/blog");
+  queuedFetches.push({ kind: "response", status: 204 }, { kind: "response", status: 204 });
+
+  await expect(a.tags.delete("tag-a")).resolves.toStrictEqual({ success: true });
+
+  expect(fetchCalls).toHaveLength(1);
+  expectDeleteCall(fetchCalls[0], {
+    origin: "https://ghost-a.example",
+    pathname: "/ghost/api/admin/tags/tag-a",
+  });
+
+  await expect(b.tags.delete("tag-b")).resolves.toStrictEqual({ success: true });
+
+  expect(fetchCalls).toHaveLength(2);
+  expectDeleteCall(fetchCalls[1], {
+    origin: "https://ghost-b.example",
+    pathname: "/blog/ghost/api/admin/tags/tag-b",
+  });
+});
+
+test("repeated constructed delete sessions do not leave active Node resources", async () => {
+
+
+  const beforeActiveResources = process.getActiveResourcesInfo().length;
+
+  for (let i = 0; i < 100; i += 1) {
+    queuedFetches.push({ kind: "response", status: 204 });
+    const api = makeAdminAPI();
+    await expect(api.posts.delete(`cycle-${i}`)).resolves.toStrictEqual({ success: true });
+  }
+  await new Promise((resolve) => setImmediate(resolve));
+
+  const activeResourceDelta = process.getActiveResourcesInfo().length - beforeActiveResources;
+
+  expect(Number.isFinite(activeResourceDelta)).toBe(true);
+  expect(fetchCalls.length).toBe(100);
+  expect(fetchCalls.every((call) => call.method === "DELETE")).toBe(true);
+
+  expectDeleteCall(fetchCalls[0], {
+    origin: "https://ghost.org",
+    pathname: "/ghost/api/admin/posts/cycle-0",
+  });
+  expectDeleteCall(fetchCalls[99], {
+    origin: "https://ghost.org",
+    pathname: "/ghost/api/admin/posts/cycle-99",
+  });
+});
