+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+
+
+
+required_paths=(
+  "packages/ts-ghost-admin-api/node_modules/.bin/vitest"
+  "packages/ts-ghost-admin-api/node_modules/vitest/dist/cli.js"
+  "packages/ts-ghost-admin-api/node_modules/vite/dist/node/index.js"
+  "packages/ts-ghost-admin-api/node_modules/vite-tsconfig-paths/dist/index.js"
+  "packages/ts-ghost-admin-api/node_modules/typescript/lib/typescript.js"
+  "packages/ts-ghost-admin-api/node_modules/zod/index.cjs"
+  "packages/ts-ghost-admin-api/node_modules/validator/index.js"
+  "packages/ts-ghost-admin-api/node_modules/@ts-ghost/core-api/src/index.ts"
+  "packages/ts-ghost-core-api/node_modules/jose/dist/webapi/index.js"
+  "node_modules/.pnpm/rollup@4.52.5/node_modules/rollup/dist/rollup.js"
+  "node_modules/.pnpm/@rollup+rollup-linux-x64-gnu@4.52.5/node_modules/@rollup/rollup-linux-x64-gnu/rollup.linux-x64-gnu.node"
+  "node_modules/.pnpm/esbuild@0.27.2/node_modules/esbuild/lib/main.js"
+  "node_modules/.pnpm/@esbuild+linux-x64@0.27.2/node_modules/@esbuild/linux-x64/bin/esbuild"
+)
+for path in "${required_paths[@]}"; do
+  if [[ ! -e "$path" ]]; then
+    echo "missing preinstalled offline dependency: $path" >&2
+    exit 127
+  fi
+done
+
+exec packages/ts-ghost-admin-api/node_modules/.bin/vitest run \
+  --config packages/ts-ghost-admin-api/vitest.config.ts \
+  /workspace/repo/usercase-test-coderl/admin-delete.test.ts \
+  --reporter=verbose
