+    def test_color_and_marker_style_issue21003(self):
+
+
+        df = DataFrame(np.random.random((7, 4)))
+
+        ax = df.plot(color="green", style="d")
+        for line in ax.get_lines():
+            assert line.get_color() == "green"
+            assert line.get_marker() == "d"
+
+    @pytest.mark.parametrize("marker", ["d", "h", "o", "p", "s", "v", "x"])
+    def test_color_list_with_marker_style(self, marker):
+
+
+        df = DataFrame(np.random.random((7, 4)))
+        colors = ["red", "blue", "green", "orange"]
+        ax = df.plot(color=colors, style=marker + "-")
+        line_colors = [line.get_color() for line in ax.get_lines()]
+        assert line_colors == colors
+        for line in ax.get_lines():
+            assert line.get_marker() == marker
+            assert line.get_linestyle() == "-"
+
+    def test_subplots_with_marker_style(self):
+
+
+        df = DataFrame(np.random.random((7, 4)))
+        axes = df.plot(subplots=True, style="d-")
+        line_colors = []
+        for ax in axes:
+            lines = ax.get_lines()
+            assert len(lines) == 1
+            line_colors.append(lines[0].get_color())
+            assert lines[0].get_marker() == "d"
+
+        assert len(set(line_colors)) == len(line_colors)
+
+    def test_colormap_with_marker_style(self):
+
+
+        df = DataFrame(np.random.random((7, 4)))
+        ax_cmap = df.plot(colormap="jet", style="d-")
+
+
+
+        cmap_colors = [line.get_color() for line in ax_cmap.get_lines()]
+
+        assert len({tuple(c) if not isinstance(c, str) else c
+                    for c in cmap_colors}) == len(cmap_colors)
+
+        first = cmap_colors[0]
+
+
+        assert not (isinstance(first, str) and first == "#1f77b4")
+
+    def test_color_and_style_color_letter_still_raises(self):
+
+
+        df = DataFrame(np.random.random((7, 4)))
+        with pytest.raises(ValueError):
+            df.plot(color="green", style="b-")
+
