diff --git a/controllers/auth_config_controller_anonymous_test.go b/controllers/auth_config_controller_anonymous_test.go
new file mode 100644
index 00000000..0920ab94
--- /dev/null
+++ b/controllers/auth_config_controller_anonymous_test.go
@@ -0,0 +1,181 @@
+package controllers
+
+import (
+	"context"
+	"testing"
+
+	api "github.com/kuadrant/authorino/api/v1beta1"
+	"github.com/kuadrant/authorino/pkg/evaluators"
+	identity_evaluators "github.com/kuadrant/authorino/pkg/evaluators/identity"
+	mock_cache "github.com/kuadrant/authorino/pkg/cache/mocks"
+
+	"github.com/golang/mock/gomock"
+	"gotest.tools/assert"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"sigs.k8s.io/controller-runtime/pkg/reconcile"
+)
+
+
+func newTestAuthConfigNoIdentity() api.AuthConfig {
+	return api.AuthConfig{
+		TypeMeta: metav1.TypeMeta{
+			Kind:       "AuthConfig",
+			APIVersion: "authorino.kuadrant.io/v1beta1",
+		},
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "auth-config-anon",
+			Namespace: "authorino",
+		},
+		Spec: api.AuthConfigSpec{
+			Hosts:    []string{"echo-api-anon"},
+			Identity: nil,
+		},
+	}
+}
+
+
+func newTestAuthConfigSingleAPIKey() api.AuthConfig {
+	return api.AuthConfig{
+		TypeMeta: metav1.TypeMeta{
+			Kind:       "AuthConfig",
+			APIVersion: "authorino.kuadrant.io/v1beta1",
+		},
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "auth-config-apikey",
+			Namespace: "authorino",
+		},
+		Spec: api.AuthConfigSpec{
+			Hosts: []string{"echo-api-apikey"},
+			Identity: []*api.Identity{
+				{
+					Name: "my-api-key",
+					APIKey: &api.Identity_APIKey{
+						LabelSelectors: map[string]string{"group": "friends"},
+					},
+				},
+			},
+		},
+	}
+}
+
+
+
+
+func TestReconcileAuthConfigEmptyIdentityDefaultsAnonymous(t *testing.T) {
+	mockController := gomock.NewController(t)
+	defer mockController.Finish()
+	cacheMock := mock_cache.NewMockCache(mockController)
+
+	authConfig := newTestAuthConfigNoIdentity()
+	authConfigName := types.NamespacedName{Name: authConfig.Name, Namespace: authConfig.Namespace}
+	client := newTestK8sClient(&authConfig)
+	reconciler := newTestAuthConfigReconciler(client, cacheMock)
+
+	var captured evaluators.AuthConfig
+	cacheMock.EXPECT().FindKeys(authConfigName.String()).Return([]string{})
+	cacheMock.EXPECT().FindId("echo-api-anon").Return("", false)
+	cacheMock.EXPECT().Set(
+		"authorino/auth-config-anon",
+		"echo-api-anon",
+		gomock.Any(),
+		true,
+	).Do(func(_ string, _ string, cfg evaluators.AuthConfig, _ bool) {
+		captured = cfg
+	}).Return(nil)
+
+	_, err := reconciler.Reconcile(context.Background(), reconcile.Request{NamespacedName: authConfigName})
+	assert.NilError(t, err)
+
+
+	assert.Equal(t, 1, len(captured.IdentityConfigs), "expected one default identity config to be added")
+
+	idCfg, ok := captured.IdentityConfigs[0].(*evaluators.IdentityConfig)
+	assert.Assert(t, ok, "expected *evaluators.IdentityConfig as the default identity entry")
+	assert.Equal(t, "anonymous", idCfg.Name)
+	assert.Assert(t, idCfg.Noop != nil, "expected the default identity config to be of Noop type")
+
+	assert.Assert(t, idCfg.OAuth2 == nil)
+	assert.Assert(t, idCfg.OIDC == nil)
+	assert.Assert(t, idCfg.APIKey == nil)
+	assert.Assert(t, idCfg.KubernetesAuth == nil)
+	assert.Assert(t, idCfg.MTLS == nil)
+	assert.Assert(t, idCfg.HMAC == nil)
+}
+
+
+
+
+func TestReconcileAuthConfigEmptyIdentityProducesNoopEvaluator(t *testing.T) {
+	mockController := gomock.NewController(t)
+	defer mockController.Finish()
+	cacheMock := mock_cache.NewMockCache(mockController)
+
+	authConfig := newTestAuthConfigNoIdentity()
+	authConfigName := types.NamespacedName{Name: authConfig.Name, Namespace: authConfig.Namespace}
+	client := newTestK8sClient(&authConfig)
+	reconciler := newTestAuthConfigReconciler(client, cacheMock)
+
+	var captured evaluators.AuthConfig
+	cacheMock.EXPECT().FindKeys(authConfigName.String()).Return([]string{})
+	cacheMock.EXPECT().FindId("echo-api-anon").Return("", false)
+	cacheMock.EXPECT().Set(
+		"authorino/auth-config-anon",
+		"echo-api-anon",
+		gomock.Any(),
+		true,
+	).Do(func(_ string, _ string, cfg evaluators.AuthConfig, _ bool) {
+		captured = cfg
+	}).Return(nil)
+
+	_, err := reconciler.Reconcile(context.Background(), reconcile.Request{NamespacedName: authConfigName})
+	assert.NilError(t, err)
+
+	assert.Equal(t, 1, len(captured.IdentityConfigs))
+
+	idCfg, ok := captured.IdentityConfigs[0].(*evaluators.IdentityConfig)
+	assert.Assert(t, ok)
+
+
+	evaluator := idCfg.GetAuthConfigEvaluator()
+	assert.Assert(t, evaluator != nil, "expected a non-nil evaluator for the anonymous identity")
+	noop, ok := evaluator.(*identity_evaluators.Noop)
+	assert.Assert(t, ok, "expected the default identity evaluator to be of *identity.Noop type")
+	assert.Assert(t, noop == idCfg.Noop, "evaluator should be the same Noop instance as IdentityConfig.Noop")
+}
+
+
+
+func TestReconcileAuthConfigSingleIdentityNotOverridden(t *testing.T) {
+	mockController := gomock.NewController(t)
+	defer mockController.Finish()
+	cacheMock := mock_cache.NewMockCache(mockController)
+
+	authConfig := newTestAuthConfigSingleAPIKey()
+	authConfigName := types.NamespacedName{Name: authConfig.Name, Namespace: authConfig.Namespace}
+	client := newTestK8sClient(&authConfig)
+	reconciler := newTestAuthConfigReconciler(client, cacheMock)
+
+	var captured evaluators.AuthConfig
+	cacheMock.EXPECT().FindKeys(authConfigName.String()).Return([]string{})
+	cacheMock.EXPECT().FindId("echo-api-apikey").Return("", false)
+	cacheMock.EXPECT().Set(
+		"authorino/auth-config-apikey",
+		"echo-api-apikey",
+		gomock.Any(),
+		true,
+	).Do(func(_ string, _ string, cfg evaluators.AuthConfig, _ bool) {
+		captured = cfg
+	}).Return(nil)
+
+	_, err := reconciler.Reconcile(context.Background(), reconcile.Request{NamespacedName: authConfigName})
+	assert.NilError(t, err)
+
+
+	assert.Equal(t, 1, len(captured.IdentityConfigs), "expected exactly the user-declared identity")
+	idCfg, ok := captured.IdentityConfigs[0].(*evaluators.IdentityConfig)
+	assert.Assert(t, ok)
+	assert.Equal(t, "my-api-key", idCfg.Name)
+	assert.Assert(t, idCfg.APIKey != nil, "expected APIKey identity to be preserved")
+	assert.Assert(t, idCfg.Noop == nil, "anonymous Noop must NOT be injected when explicit identity is present")
+}
