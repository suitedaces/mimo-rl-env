diff --git a/test/test.config.version.js b/test/test.config.version.js
new file mode 100644
index 0000000..33b17f6
--- /dev/null
+++ b/test/test.config.version.js
@@ -0,0 +1,122 @@
+
+
+
+
+
+
+var assert = require('assert');
+var path = require('path');
+
+
+
+process.on('unhandledRejection', function () {});
+
+function loadFreshLocalForage() {
+    var resolved = require.resolve('../dist/localforage.js');
+    delete require.cache[resolved];
+    var lf = require('../dist/localforage.js');
+
+    lf._ready = null;
+    return lf;
+}
+
+describe('config() version validation', function () {
+    var localforage;
+
+    beforeEach(function () {
+        localforage = loadFreshLocalForage();
+    });
+
+    it('returns an Error when version is the string "1.0"', function () {
+        var result = localforage.config({ version: '1.0' });
+        assert.ok(
+            result instanceof Error,
+            'expected config({version: "1.0"}) to return an Error, got: ' + result
+        );
+    });
+
+    it('returns an Error when version is a non-numeric string like "1.3a"', function () {
+        var result = localforage.config({ version: '1.3a' });
+        assert.ok(
+            result instanceof Error,
+            'expected config({version: "1.3a"}) to return an Error, got: ' + result
+        );
+    });
+
+    it('returns an Error whose message is "Database version must be a number."', function () {
+        var result = localforage.config({ version: '1.0' });
+        assert.ok(result instanceof Error);
+        assert.strictEqual(result.message, 'Database version must be a number.');
+    });
+
+    it('returns an Error when version is null', function () {
+        var result = localforage.config({ version: null });
+        assert.ok(
+            result instanceof Error,
+            'expected config({version: null}) to return an Error, got: ' + result
+        );
+    });
+
+    it('returns an Error when version is a boolean', function () {
+        var result = localforage.config({ version: true });
+        assert.ok(
+            result instanceof Error,
+            'expected config({version: true}) to return an Error, got: ' + result
+        );
+    });
+
+    it('does NOT throw when version is invalid (returns Error instead)', function () {
+
+
+
+
+        var threw = false;
+        var caught;
+        var result;
+        try {
+            result = localforage.config({ version: '1.0' });
+        } catch (e) {
+            threw = true;
+            caught = e;
+        }
+        assert.strictEqual(threw, false,
+            'config() should not throw; it should return an Error. ' +
+            'Thrown: ' + (caught && caught.message));
+        assert.ok(result instanceof Error,
+            'config() should return an Error instance');
+    });
+
+    it('does not change stored version when an invalid version is rejected', function () {
+        var beforeVersion = localforage.config('version');
+        localforage.config({ version: '1.0' });
+        var afterVersion = localforage.config('version');
+        assert.strictEqual(afterVersion, beforeVersion,
+            'stored version should remain at default when invalid version was rejected');
+    });
+
+    it('returns true and stores version when version is a valid float number', function () {
+        var result = localforage.config({ version: 2.5 });
+        assert.strictEqual(result, true,
+            'config() with numeric version should return true');
+        assert.strictEqual(localforage.config('version'), 2.5,
+            'numeric version should be stored on the config');
+    });
+
+    it('returns true and stores version when version is an integer', function () {
+        var result = localforage.config({ version: 3 });
+        assert.strictEqual(result, true);
+        assert.strictEqual(localforage.config('version'), 3);
+    });
+
+    it('still accepts other valid options alongside a valid numeric version', function () {
+        var result = localforage.config({
+            name: 'MyCoolApp',
+            version: 2.0,
+            storeName: 'myStoreName'
+        });
+        assert.strictEqual(result, true);
+        assert.strictEqual(localforage.config('name'), 'MyCoolApp');
+        assert.strictEqual(localforage.config('version'), 2.0);
+        assert.strictEqual(localforage.config('storeName'), 'myStoreName');
+    });
+});
