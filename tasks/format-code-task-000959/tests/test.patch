+func TestContractConfigValidateUsesPerInstanceRules(t *testing.T) {
+	valid := []config.Config{
+		{PIHoleProtocol: "http", PIHoleHostname: "pi.example", PIHolePort: 80},
+		{PIHoleProtocol: "https", PIHoleHostname: "2001:db8::10", PIHolePort: 443, PIHoleApiToken: "token"},
+		{PIHoleProtocol: "https", PIHoleHostname: "[2001:db8::13]", PIHolePort: 443},
+	}
+	for _, cfg := range valid {
+		if err := cfg.Validate(); err != nil {
+			t.Errorf("Validate rejected valid config %+v: %v", cfg, err)
+		}
+	}
+
+	invalid := []config.Config{
+		{PIHoleProtocol: "ftp", PIHoleHostname: "pi.example", PIHolePort: 80},
+		{PIHoleProtocol: "http", PIHoleHostname: "", PIHolePort: 80},
+		{PIHoleProtocol: "http", PIHoleHostname: "https://pi.example", PIHolePort: 80},
+		{PIHoleProtocol: "http", PIHoleHostname: "pi.example/path", PIHolePort: 80},
+		{PIHoleProtocol: "http", PIHoleHostname: "pi.example?mode=test", PIHolePort: 80},
+		{PIHoleProtocol: "http", PIHoleHostname: "pi.example#fragment", PIHolePort: 80},
+		{PIHoleProtocol: "http", PIHoleHostname: "user@pi.example", PIHolePort: 80},
+		{PIHoleProtocol: "http", PIHoleHostname: "pi.example:8080", PIHolePort: 80},
+		{PIHoleProtocol: "http", PIHoleHostname: "pi.example", PIHolePort: 80, PIHolePassword: "password", PIHoleApiToken: "token"},
+	}
+	for _, cfg := range invalid {
+		if err := cfg.Validate(); err == nil {
+			t.Errorf("Validate accepted invalid config %+v", cfg)
+		}
+	}
+}
