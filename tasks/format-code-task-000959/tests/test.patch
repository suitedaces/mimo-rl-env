+func TestContractURLGenerationIsIPv6SafeAndBackwardCompatible(t *testing.T) {
+	const statsSuffix = "/admin/api.php?summaryRaw&overTimeData&topItems&recentItems&getQueryTypes&getForwardDestinations&getQuerySources&overTimeData10mins&jsonForceObject"
+	tests := []struct {
+		name      string
+		cfg       config.Config
+		wantBase  string
+	}{
+		{"dns with port", config.Config{PIHoleProtocol: "http", PIHoleHostname: "pi.example", PIHolePort: 8080}, "http://pi.example:8080"},
+		{"dns without port", config.Config{PIHoleProtocol: "https", PIHoleHostname: "pi.example"}, "https://pi.example"},
+		{"bare IPv6", config.Config{PIHoleProtocol: "https", PIHoleHostname: "2001:db8::11", PIHolePort: 8443}, "https://[2001:db8::11]:8443"},
+		{"bracketed IPv6", config.Config{PIHoleProtocol: "https", PIHoleHostname: "[2001:db8::12]", PIHolePort: 8443}, "https://[2001:db8::12]:8443"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := tc.cfg.PIHoleLoginURL(); got != tc.wantBase+"/admin/index.php?login" {
+				t.Errorf("PIHoleLoginURL() = %q, want %q", got, tc.wantBase+"/admin/index.php?login")
+			}
+			if got := tc.cfg.PIHoleStatsURL(); got != tc.wantBase+statsSuffix {
+				t.Errorf("PIHoleStatsURL() = %q, want %q", got, tc.wantBase+statsSuffix)
+			}
+		})
+	}
+}
