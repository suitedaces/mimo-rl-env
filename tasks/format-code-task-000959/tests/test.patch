+func TestContractSplitNormalizesBroadcastValuesAndIPv6(t *testing.T) {
+	env := config.EnvConfig{
+		PIHoleHostname: []string{" DNS-A.Example. ", "2001:db8::7", "[2001:db8::8]"},
+		PIHoleProtocol: []string{" HTTP "},
+		PIHolePort:     []uint16{8080},
+		PIHolePassword: []string{" shared-secret "},
+	}
+
+	got, err := env.Split()
+	if err != nil {
+		t.Fatalf("Split returned an error for valid instances: %v", err)
+	}
+	if len(got) != 3 {
+		t.Fatalf("Split returned %d instances, want 3", len(got))
+	}
+
+	wantHosts := []string{"dns-a.example", "2001:db8::7", "2001:db8::8"}
+	wantStatsURLs := []string{
+		"http://dns-a.example:8080/admin/api.php?summaryRaw&overTimeData&topItems&recentItems&getQueryTypes&getForwardDestinations&getQuerySources&overTimeData10mins&jsonForceObject",
+		"http://[2001:db8::7]:8080/admin/api.php?summaryRaw&overTimeData&topItems&recentItems&getQueryTypes&getForwardDestinations&getQuerySources&overTimeData10mins&jsonForceObject",
+		"http://[2001:db8::8]:8080/admin/api.php?summaryRaw&overTimeData&topItems&recentItems&getQueryTypes&getForwardDestinations&getQuerySources&overTimeData10mins&jsonForceObject",
+	}
+	for i := range got {
+		if got[i].PIHoleHostname != wantHosts[i] {
+			t.Errorf("instance %d hostname = %q, want %q", i+1, got[i].PIHoleHostname, wantHosts[i])
+		}
+		if got[i].PIHoleProtocol != "http" {
+			t.Errorf("instance %d protocol = %q, want http", i+1, got[i].PIHoleProtocol)
+		}
+		if got[i].PIHolePort != 8080 {
+			t.Errorf("instance %d port = %d, want 8080", i+1, got[i].PIHolePort)
+		}
+		if got[i].PIHolePassword != "shared-secret" {
+			t.Errorf("instance %d password was not trimmed and broadcast", i+1)
+		}
+		if got[i].PIHoleStatsURL() != wantStatsURLs[i] {
+			t.Errorf("instance %d stats URL = %q, want %q", i+1, got[i].PIHoleStatsURL(), wantStatsURLs[i])
+		}
+	}
+}
