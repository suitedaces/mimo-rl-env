+func TestContractSplitDefaultsAndKeepsCredentialSlotsAligned(t *testing.T) {
+	t.Run("omitted optional lists use defaults", func(t *testing.T) {
+		got, err := (config.EnvConfig{PIHoleHostname: []string{"one.example", "two.example"}}).Split()
+		if err != nil {
+			t.Fatalf("Split returned an error: %v", err)
+		}
+		for i := range got {
+			if got[i].PIHoleProtocol != "http" || got[i].PIHolePort != 80 {
+				t.Errorf("instance %d defaults = protocol %q, port %d; want http and 80", i+1, got[i].PIHoleProtocol, got[i].PIHolePort)
+			}
+		}
+	})
+
+	t.Run("empty per-host values retain their positions", func(t *testing.T) {
+		env := config.EnvConfig{
+			PIHoleHostname: []string{"one.example", "two.example"},
+			PIHoleProtocol: []string{"", " HTTPS "},
+			PIHolePort:     []uint16{0, 443},
+			PIHolePassword: []string{" first-password ", ""},
+			PIHoleApiToken: []string{"", " second-token "},
+		}
+		got, err := env.Split()
+		if err != nil {
+			t.Fatalf("Split returned an error: %v", err)
+		}
+		if got[0].PIHoleProtocol != "http" || got[0].PIHolePort != 80 || got[0].PIHolePassword != "first-password" || got[0].PIHoleApiToken != "" {
+			t.Errorf("first instance was misaligned or not defaulted: %+v", got[0])
+		}
+		if got[1].PIHoleProtocol != "https" || got[1].PIHolePort != 443 || got[1].PIHolePassword != "" || got[1].PIHoleApiToken != "second-token" {
+			t.Errorf("second instance was misaligned or not normalized: %+v", got[1])
+		}
+	})
+}
