+func TestContractSplitRejectsDuplicateEffectiveEndpoints(t *testing.T) {
+	tests := []config.EnvConfig{
+		{
+			PIHoleHostname: []string{"Pi.Example", "pi.example."},
+			PIHoleProtocol: []string{"http"},
+			PIHolePort:     []uint16{8080},
+		},
+		{
+			PIHoleHostname: []string{"2001:db8::9", "[2001:db8::9]"},
+			PIHoleProtocol: []string{"https"},
+			PIHolePort:     []uint16{443},
+		},
+		{
+			PIHoleHostname: []string{"same.example", "SAME.EXAMPLE."},
+			PIHoleProtocol: []string{"http"},
+			PIHolePort:     []uint16{80},
+			PIHolePassword: []string{"first-password", "second-password"},
+		},
+	}
+
+	for i, env := range tests {
+		got, err := env.Split()
+		if err == nil {
+			t.Fatalf("case %d: Split accepted duplicate endpoints as %#v", i+1, got)
+		}
+		if got != nil {
+			t.Errorf("case %d: Split returned partial configs %#v", i+1, got)
+		}
+		message := strings.ToLower(err.Error())
+		for _, fragment := range []string{"duplicate", "1", "2"} {
+			if !strings.Contains(message, fragment) {
+				t.Errorf("case %d: error %q does not identify duplicate instances", i+1, err)
+			}
+		}
+	}
+}
