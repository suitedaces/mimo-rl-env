+func TestContractSplitRejectsInvalidInstanceValuesAtomically(t *testing.T) {
+	tests := []struct {
+		name      string
+		env       config.EnvConfig
+		fragments []string
+	}{
+		{
+			name:      "no instances",
+			env:       config.EnvConfig{},
+			fragments: []string{"hostname"},
+		},
+		{
+			name: "empty second hostname",
+			env: config.EnvConfig{
+				PIHoleHostname: []string{"valid.example", "  "},
+				PIHoleProtocol: []string{"http"},
+				PIHolePort:     []uint16{80},
+			},
+			fragments: []string{"hostname", "2"},
+		},
+		{
+			name: "invalid second protocol",
+			env: config.EnvConfig{
+				PIHoleHostname: []string{"one.example", "two.example"},
+				PIHoleProtocol: []string{"http", "ftp"},
+				PIHolePort:     []uint16{80},
+			},
+			fragments: []string{"protocol", "2"},
+		},
+		{
+			name: "both authentication methods",
+			env: config.EnvConfig{
+				PIHoleHostname: []string{"one.example"},
+				PIHoleProtocol: []string{"http"},
+				PIHolePort:     []uint16{80},
+				PIHolePassword: []string{"do-not-print-password"},
+				PIHoleApiToken: []string{"do-not-print-token"},
+			},
+			fragments: []string{"password", "api", "1"},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := tc.env.Split()
+			if err == nil {
+				t.Fatalf("Split returned configs %#v, want an error", got)
+			}
+			if got != nil {
+				t.Errorf("Split returned partial configs %#v with error %v", got, err)
+			}
+			message := strings.ToLower(err.Error())
+			for _, fragment := range tc.fragments {
+				if !strings.Contains(message, fragment) {
+					t.Errorf("error %q does not identify %q", err, fragment)
+				}
+			}
+			if strings.Contains(message, "do-not-print-password") || strings.Contains(message, "do-not-print-token") {
+				t.Errorf("error exposes authentication material: %q", err)
+			}
+		})
+	}
+}
