+func TestContractSplitAllowsSameHostnameAtDistinctEndpoints(t *testing.T) {
+	env := config.EnvConfig{
+		PIHoleHostname: []string{"same.example", "SAME.EXAMPLE.", "same.example"},
+		PIHoleProtocol: []string{"http", "https", "http"},
+		PIHolePort:     []uint16{80, 80, 8080},
+	}
+	got, err := env.Split()
+	if err != nil {
+		t.Fatalf("Split rejected distinct effective endpoints: %v", err)
+	}
+	if len(got) != 3 {
+		t.Fatalf("Split returned %d instances, want 3", len(got))
+	}
+	for i, cfg := range got {
+		if cfg.PIHoleHostname != "same.example" {
+			t.Errorf("instance %d hostname = %q, want normalized same.example", i+1, cfg.PIHoleHostname)
+		}
+	}
+}
