+func TestContractSplitRejectsMismatchedOptionCounts(t *testing.T) {
+	tests := []struct {
+		name      string
+		env       config.EnvConfig
+		fragments []string
+	}{
+		{
+			name: "protocol count",
+			env: config.EnvConfig{PIHoleProtocol: []string{"http", "https"}},
+			fragments: []string{"protocol", "2", "3"},
+		},
+		{
+			name: "port count",
+			env: config.EnvConfig{PIHolePort: []uint16{80, 81}},
+			fragments: []string{"port", "2", "3"},
+		},
+		{
+			name: "password count",
+			env: config.EnvConfig{PIHolePassword: []string{"one", "two"}},
+			fragments: []string{"password", "2", "3"},
+		},
+		{
+			name: "API token count",
+			env: config.EnvConfig{PIHoleApiToken: []string{"one", "two"}},
+			fragments: []string{"api", "token", "2", "3"},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			tc.env.PIHoleHostname = []string{"one.example", "two.example", "three.example"}
+			got, err := tc.env.Split()
+			if err == nil {
+				t.Fatalf("Split returned configs %#v, want a count error", got)
+			}
+			if got != nil {
+				t.Errorf("Split returned partial configs %#v", got)
+			}
+			message := strings.ToLower(err.Error())
+			for _, fragment := range tc.fragments {
+				if !strings.Contains(message, fragment) {
+					t.Errorf("error %q does not identify option and counts; missing %q", err, fragment)
+				}
+			}
+		})
+	}
+}
