+func TestContractSplitRejectsNonHostnameSyntax(t *testing.T) {
+	for _, hostname := range []string{
+		"https://pi.example",
+		"pi.example/admin",
+		"pi.example?mode=test",
+		"pi.example#fragment",
+		"user@pi.example",
+		"pi.example:8080",
+	} {
+		t.Run(hostname, func(t *testing.T) {
+			got, err := (config.EnvConfig{
+				PIHoleHostname: []string{hostname},
+				PIHoleProtocol: []string{"http"},
+				PIHolePort:     []uint16{80},
+			}).Split()
+			if err == nil {
+				t.Fatalf("Split accepted non-hostname input %q as %#v", hostname, got)
+			}
+			if got != nil {
+				t.Errorf("Split returned partial configs %#v", got)
+			}
+			message := strings.ToLower(err.Error())
+			if !strings.Contains(message, "hostname") || !strings.Contains(message, "1") {
+				t.Errorf("error %q does not identify hostname instance 1", err)
+			}
+		})
+	}
+}
