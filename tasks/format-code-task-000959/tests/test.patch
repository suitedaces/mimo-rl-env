+func TestContractConfigStringNeverExposesAuthenticationMaterial(t *testing.T) {
+	cfg := config.Config{
+		PIHoleProtocol: "https", PIHoleHostname: "pi.example", PIHolePort: 443,
+		PIHolePassword: "visible-password", PIHoleApiToken: "visible-token",
+	}
+	got := cfg.String()
+	if strings.Contains(got, "visible-password") || strings.Contains(got, "visible-token") {
+		t.Fatalf("Config.String exposed authentication material: %s", got)
+	}
+}
