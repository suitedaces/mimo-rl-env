+func TestHttp_ParseRangeQuery_Step_Errors(t *testing.T) {
+	t.Parallel()
+
+	tests := map[string]struct {
+		reqPath string
+	}{
+		"should error on unparseable step": {
+			reqPath: "/loki/api/v1/query_range?query={}&start=0&end=3600000000000&step=invalid",
+		},
+		"should error on zero step": {
+			reqPath: "/loki/api/v1/query_range?query={}&start=0&end=3600000000000&step=0",
+		},
+	}
+
+	for testName, testData := range tests {
+		testData := testData
+
+		t.Run(testName, func(t *testing.T) {
+			req := httptest.NewRequest("GET", testData.reqPath, nil)
+			_, err := ParseRangeQuery(req)
+			assert.Error(t, err)
+		})
+	}
+}
