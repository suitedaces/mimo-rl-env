diff --git a/synth_behavior_test.php b/synth_behavior_test.php
new file mode 100644
index 0000000..0ee18a9
--- /dev/null
+++ b/synth_behavior_test.php
@@ -0,0 +1,85 @@
+<?php
+interface PHP_CodeSniffer_Sniff {}
+class PHP_CodeSniffer_File {}
+class FakeFile extends PHP_CodeSniffer_File {
+    private $tokens;
+    private $filename;
+    public $errors = array();
+    public function __construct($code, $filename) {
+        $this->filename = $filename;
+        $this->tokens = array();
+        foreach (token_get_all($code) as $tok) {
+            if (is_array($tok)) {
+                $this->tokens[] = array('code' => $tok[0], 'type' => token_name($tok[0]), 'content' => $tok[1], 'line' => $tok[2]);
+            } else {
+                $this->tokens[] = array('code' => ord($tok), 'type' => $tok, 'content' => $tok, 'line' => 0);
+            }
+        }
+        $line = 1;
+        foreach ($this->tokens as &$token) {
+            $token['line'] = $line;
+            $line += substr_count($token['content'], "\n");
+        }
+    }
+    public function getTokens() { return $this->tokens; }
+    public function getFilename() { return $this->filename; }
+    public function addError($msg, $ptr) { $this->errors[] = array($msg, $ptr); }
+    public function findNext($wanted, $start, $end = null) {
+        $wanted = (array) $wanted;
+        $end = $end === null ? count($this->tokens) : $end;
+        for ($i = $start; $i < $end; $i++) {
+            if (in_array($this->tokens[$i]['code'], $wanted, true)) {
+                return $i;
+            }
+        }
+        return false;
+    }
+    public function findPrevious($wanted, $start, $end = null) {
+        $wanted = (array) $wanted;
+        $end = $end === null ? -1 : $end;
+        for ($i = $start; $i > $end; $i--) {
+            if (in_array($this->tokens[$i]['code'], $wanted, true)) {
+                return $i;
+            }
+        }
+        return false;
+    }
+    public function getDeclarationName($ptr) {
+        $name = $this->findNext(T_STRING, $ptr + 1);
+        return $name === false ? null : $this->tokens[$name]['content'];
+    }
+}
+require __DIR__.'/Symfony2/Sniffs/Classes/MultipleClassesOneFileSniff.php';
+function scan($sniff, $code, $filename) {
+    $file = new FakeFile($code, $filename);
+    $wanted = $sniff->register();
+    foreach ($file->getTokens() as $i => $token) {
+        if (in_array($token['code'], $wanted, true)) {
+            $sniff->process($file, $i);
+        }
+    }
+    return $file->errors;
+}
+function expect($ok, $message) {
+    if (!$ok) {
+        fwrite(STDERR, "FAIL: $message\n");
+        exit(1);
+    }
+}
+$s = new Symfony2_Sniffs_Classes_MultipleClassesOneFileSniff();
+expect(count(scan($s, '<?php class One {}', 'single.php')) === 0, 'single class');
+expect(count(scan($s, '<?php interface One {}', 'interface.php')) === 0, 'single interface');
+expect(count(scan($s, '<?php trait One {}', 'trait.php')) === 0, 'single trait');
+expect(count(scan($s, '<?php class One {} interface Two {}', 'class-interface.php')) === 1, 'class and interface');
+expect(count(scan($s, '<?php class One {} trait Two {}', 'class-trait.php')) === 1, 'class and trait');
+expect(count(scan($s, '<?php class One {} interface Two {} trait Three {}', 'three-named.php')) === 2, 'every declaration after first is reported');
+expect(count(scan($s, '<?php $a = new class {}; $b = new class {};', 'anonymous.php')) === 0, 'anonymous classes ignored');
+expect(count(scan($s, '<?php $a = new class {}; class One {}', 'anonymous-first.php')) === 0, 'anonymous class does not consume declaration slot');
+$errors = scan($s, '<?php class One {} $a = new class {}; class Two {}', 'mixed.php');
+expect(count($errors) === 1, 'anonymous class does not add a duplicate error');
+expect(count(scan($s, '<?php abstract class One {} final class Two {}', 'modifiers.php')) === 1, 'modifiers do not hide declarations');
+expect(count(scan($s, '<?php namespace A; class One {} namespace B; interface Two {}', 'namespaces.php')) === 1, 'namespaces do not reset file declaration count');
+$s2 = new Symfony2_Sniffs_Classes_MultipleClassesOneFileSniff();
+expect(count(scan($s2, '<?php class One {}', 'first.php')) === 0, 'first file');
+expect(count(scan($s2, '<?php class Two {}', 'second.php')) === 0, 'state resets between files');
+echo "ok\n";
