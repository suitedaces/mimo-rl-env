diff --git a/src/rules/indentation/__tests__/hierarchical.js b/src/rules/indentation/__tests__/hierarchical.js
new file mode 100644
index 000000000..0d01c7155
--- /dev/null
+++ b/src/rules/indentation/__tests__/hierarchical.js
@@ -0,0 +1,125 @@
+/* eslint-disable indent, no-multiple-empty-lines */
+
+import {
+  ruleTester,
+  warningFreeBasics
+} from "../../../testUtils"
+import rule, { ruleName, messages } from ".."
+
+const testRule = ruleTester(rule, ruleName)
+
+
+testRule(2, { hierarchicalSelectors: true }, tr => {
+warningFreeBasics(tr)
+
+
+tr.ok(
+`a {
+  color: pink;
+}`)
+
+tr.ok(
+`@media print {
+  a {
+    color: pink;
+  }
+}`)
+
+
+tr.ok(
+`.foo {}
+  .foo-sub {}`)
+
+
+tr.ok(
+`#foo ul {}
+  #foo ul > li {}
+    #foo ul > li > a {}
+#bar ul {}`)
+
+
+tr.ok(
+`.foo {}
+  .foo-one {}
+  .foo-two {}
+    .foo-two-sub {}
+  .foo-three {}
+.bar {}`)
+
+
+
+tr.ok(
+`.foo {}
+  @media print {
+    .foo-one {}
+    .foo-two {}
+  }
+.bar {}`)
+
+
+
+tr.ok(
+`.foo {}
+@media print {
+  .foo-one {}
+  .bar {}
+}`)
+
+
+tr.notOk(
+`.foo {}
+.foo-sub {}`,
+messages.expected("2 spaces at line 2"))
+
+
+tr.notOk(
+`.foo {}
+    .foo-sub {}`,
+messages.expected("2 spaces at line 2"))
+
+
+tr.notOk(
+`.foo {}
+  .foo-two {}
+  .foo-two-sub {}`,
+messages.expected("4 spaces at line 3"))
+
+
+tr.notOk(
+`.foo {}
+  @media print {
+  .foo-one {}
+  }`,
+messages.expected("4 spaces at line 3"))
+
+})
+
+
+testRule("tab", { hierarchicalSelectors: true }, tr => {
+warningFreeBasics(tr)
+
+tr.ok(
+`.foo {}
+\t.foo-sub {}`)
+
+tr.notOk(
+`.foo {}
+.foo-sub {}`,
+messages.expected("1 tab at line 2"))
+
+})
+
+
+testRule(2, tr => {
+warningFreeBasics(tr)
+
+tr.ok(
+`.foo {}
+.foo-sub {}`)
+
+tr.notOk(
+`.foo {}
+  .foo-sub {}`,
+messages.expected("0 spaces at line 2"))
+
+})
