diff --git a/test/ERC6551.t.sol b/test/ERC6551.t.sol
index 9c4b259..6e1b018 100644
--- a/test/ERC6551.t.sol
+++ b/test/ERC6551.t.sol
@@ -361,6 +361,70 @@ contract ERC6551Test is SoladyTest {
         assertEq(calls[1].target.balance, 456);
     }
 
+
+    function _callIsValidSigner(address account, address signer, bytes memory context)
+        internal
+        view
+        returns (bool ok, bytes4 result)
+    {
+        bytes memory data;
+        (ok, data) = account.staticcall(
+            abi.encodeWithSignature("isValidSigner(address,bytes)", signer, context)
+        );
+        if (ok && data.length >= 4) {
+            result = abi.decode(data, (bytes4));
+        }
+    }
+
+    function testIsValidSignerAcceptsCurrentOwnerWithArbitraryContext() public {
+        _TestTemps memory t = _testTemps();
+
+        (bool ok, bytes4 result) = _callIsValidSigner(
+            address(t.account), t.owner, abi.encodePacked(bytes32(uint256(0xabc123)), uint8(7))
+        );
+
+        assertTrue(ok);
+
+        assertEq(result, bytes4(0x523e3260));
+    }
+
+    function testIsValidSignerRejectsMultipleInvalidSigners() public {
+        _TestTemps memory t = _testTemps();
+        address invalidSigner0 = address(uint160(t.owner) ^ uint160(0x1111111111111111111111111111111111111111));
+        address invalidSigner1 = address(uint160(t.owner) ^ uint160(0x2222222222222222222222222222222222222222));
+
+        (bool ok0, bytes4 result0) =
+            _callIsValidSigner(address(t.account), invalidSigner0, hex"0102030405");
+        (bool ok1, bytes4 result1) =
+            _callIsValidSigner(address(t.account), invalidSigner1, abi.encode(uint256(0xdeadbeef)));
+
+        assertTrue(ok0);
+        assertTrue(ok1);
+
+        assertTrue(result0 != bytes4(0x523e3260));
+        assertTrue(result1 != bytes4(0x523e3260));
+    }
+
+    function testIsValidSignerUsesSignerArgumentInsteadOfCaller() public {
+        _TestTemps memory t = _testTemps();
+        address invalidSigner = address(uint160(t.owner) ^ uint160(0x3333333333333333333333333333333333333333));
+        address nonOwnerCaller = address(uint160(t.owner) ^ uint160(0x4444444444444444444444444444444444444444));
+
+        vm.prank(nonOwnerCaller);
+        (bool okValid, bytes4 validResult) =
+            _callIsValidSigner(address(t.account), t.owner, abi.encodePacked("valid-signer-parameter"));
+
+        vm.prank(t.owner);
+        (bool okInvalid, bytes4 invalidResult) =
+            _callIsValidSigner(address(t.account), invalidSigner, abi.encodePacked("invalid-signer-parameter"));
+
+        assertTrue(okValid);
+
+        assertEq(validResult, bytes4(0x523e3260));
+        assertTrue(okInvalid);
+        assertTrue(invalidResult != bytes4(0x523e3260));
+    }
+
     function testIsValidSignature() public {
         _TestTemps memory t = _testTemps();
         (t.signer, t.privateKey) = _randomSigner();
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+export PATH="$HOME/.foundry/bin:$PATH"
+
+
+NEW_TEST_REGEX='testIsValidSigner(AcceptsCurrentOwnerWithArbitraryContext|RejectsMultipleInvalidSigners|UsesSignerArgumentInsteadOfCaller)'
+
+case "${1:-}" in
+  base)
+    forge test --match-path test/ERC6551.t.sol --no-match-test "$NEW_TEST_REGEX" -q
+    ;;
+  new)
+    forge test --match-path test/ERC6551.t.sol --match-test "$NEW_TEST_REGEX" -q
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
