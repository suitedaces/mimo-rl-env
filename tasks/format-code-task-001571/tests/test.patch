+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+PYTHON_BIN="${PYTHON_BIN:-/workspace/stage4a-venv/bin/python}"
+if [ ! -x "$PYTHON_BIN" ]; then
+  echo "local offline venv is missing: $PYTHON_BIN" >&2
+  exit 1
+fi
+
+export PIP_NO_INDEX=1
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+export CARGO_NET_OFFLINE=true
+export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
+
+NATIVE_SO="$(find "$(dirname "$PYTHON_BIN")/../lib" -path '*/site-packages/libcst/native*.so' -print -quit)"
+if [ -n "$NATIVE_SO" ] && ! compgen -G "/workspace/repo/libcst/native*.so" >/dev/null; then
+  cp "$NATIVE_SO" /workspace/repo/libcst/
+fi
+
+cd /workspace/repo
+exec "$PYTHON_BIN" -m pytest /workspace/repo/usercase-test-coderl/test_remove_imports_stateful.py -v
