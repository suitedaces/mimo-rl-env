+import Report from './Report';
+import StatusEnum from './StatusEnum';
+
+function rawReport() {
+  return {
+    name: 'structured filter fixture',
+    nameUrl: '',
+    version: 'test',
+    config: {},
+    envVars: {},
+    warnings: [],
+    summary: { total: 5, passed: 2, failed: 1, skipped: 1, errored: 1 },
+    tests: [
+      {
+        id: 'checkout-retry',
+        className: 'shop.payments.CardFlowTest',
+        shortContainerId: 'Card payments',
+        scenario: 'Checkout retries declined card',
+        status: StatusEnum.FAILED,
+        httpCalls: [
+          {
+            id: 'charge-post',
+            method: 'POST',
+            url: 'https://pay.example.test/v1/charges?retry=true',
+            elapsedTime: 40,
+            mismatches: [{ message: 'declined' }],
+          },
+          {
+            id: 'audit-get',
+            method: 'GET',
+            url: 'https://pay.example.test/v1/audit/owner:platform',
+            elapsedTime: 8,
+            mismatches: [],
+          },
+        ],
+      },
+      {
+        id: 'checkout-cash',
+        className: 'shop.checkout.CashFlowTest',
+        shortContainerId: 'Cash desk',
+        scenario: 'Checkout accepts cash',
+        status: StatusEnum.PASSED,
+        httpCalls: [
+          {
+            id: 'cash-post',
+            method: 'POST',
+            url: 'https://shop.example.test/v1/orders/cash',
+            elapsedTime: 12,
+            mismatches: [],
+          },
+        ],
+      },
+      {
+        id: 'refund-card',
+        className: 'shop.payments.RefundFlowTest',
+        shortContainerId: 'Card payments',
+        scenario: 'Refund settled card payment',
+        status: StatusEnum.PASSED,
+        httpCalls: [
+          {
+            id: 'refund-delete',
+            method: 'DELETE',
+            url: 'https://pay.example.test/v1/refunds/settled',
+            elapsedTime: 20,
+            mismatches: [],
+          },
+        ],
+      },
+      {
+        id: 'inventory-sync',
+        className: 'shop.stock.InventoryJobTest',
+        shortContainerId: 'Night jobs',
+        scenario: 'Inventory sync timed out',
+        status: StatusEnum.ERRORED,
+        httpCalls: [
+          {
+            id: 'inventory-put',
+            method: 'PUT',
+            url: 'https://stock.example.test/v2/inventory/sync',
+            elapsedTime: 100,
+            mismatches: [],
+            errorMessage: 'timeout',
+          },
+        ],
+      },
+      {
+        id: 'owner-literal',
+        className: 'shop.ops.TriageTest',
+        shortContainerId: 'Operations',
+        scenario: 'Triage owner:platform alert',
+        status: StatusEnum.SKIPPED,
+        httpCalls: [],
+      },
+    ],
+  };
+}
+
+function ids(entries) {
+  return entries.map((entry) => entry.id);
+}
+
+describe('structured report filters', () => {
+  let report;
+
+  beforeEach(() => {
+    report = new Report(rawReport());
+  });
+
+  test('keeps plain searches, status intersection, case folding, and empty filters compatible', () => {
+    expect(ids(report.testsWithStatusAndFilteredByText('', 'cHeCkOuT'))).toEqual([
+      'checkout-retry',
+      'checkout-cash',
+    ]);
+    expect(ids(report.testsWithStatusAndFilteredByText(StatusEnum.PASSED, 'checkout'))).toEqual([
+      'checkout-cash',
+    ]);
+    expect(ids(report.testsWithStatusAndFilteredByText('', '   '))).toEqual([
+      'checkout-retry',
+      'checkout-cash',
+      'refund-card',
+      'inventory-sync',
+      'owner-literal',
+    ]);
+  });
+
+  test('combines test clauses with AND and keeps scenario and container scopes separate', () => {
+    expect(ids(report.testsWithStatusAndFilteredByText('', 'checkout payments'))).toEqual(['checkout-retry']);
+    expect(ids(report.testsWithStatusAndFilteredByText('', 'scenario:payments'))).toEqual([]);
+    expect(ids(report.testsWithStatusAndFilteredByText('', 'container:payments scenario:refund'))).toEqual([
+      'refund-card',
+    ]);
+    expect(ids(report.testsWithStatusAndFilteredByText('', 'SCENARIO:checkout CONTAINER:cash'))).toEqual([
+      'checkout-cash',
+    ]);
+    expect(ids(report.testsWithStatusAndFilteredByText('', 'status:passed container:payments'))).toEqual([
+      'refund-card',
+    ]);
+  });
+
+  test('supports quoted phrases, alternatives, negation, and literal unknown prefixes for tests', () => {
+    expect(ids(report.testsWithStatusAndFilteredByText('', 'scenario:"checkout retries"'))).toEqual([
+      'checkout-retry',
+    ]);
+    expect(ids(report.testsWithStatusAndFilteredByText('', 'scenario:checkout|scenario:refund'))).toEqual([
+      'checkout-retry',
+      'checkout-cash',
+      'refund-card',
+    ]);
+    expect(ids(report.testsWithStatusAndFilteredByText('', 'container:payments -scenario:refund'))).toEqual([
+      'checkout-retry',
+    ]);
+    expect(ids(report.testsWithStatusAndFilteredByText('', 'owner:platform'))).toEqual(['owner-literal']);
+  });
+
+  test('keeps ordinary HTTP searches compatible and supports method, URL, and status scopes', () => {
+    expect(ids(report.httpCallsWithStatusAndFilteredByText('', 'po'))).toEqual(['charge-post', 'cash-post']);
+    expect(ids(report.httpCallsWithStatusAndFilteredByText(StatusEnum.PASSED, 'POST'))).toEqual(['cash-post']);
+    expect(ids(report.httpCallsWithStatusAndFilteredByText('', '   '))).toEqual([
+      'charge-post',
+      'audit-get',
+      'cash-post',
+      'refund-delete',
+      'inventory-put',
+    ]);
+    expect(ids(report.httpCallsWithStatusAndFilteredByText('', 'method:delete'))).toEqual(['refund-delete']);
+    expect(ids(report.httpCallsWithStatusAndFilteredByText('', 'url:/v1/charges status:failed'))).toEqual([
+      'charge-post',
+    ]);
+    expect(ids(report.httpCallsWithStatusAndFilteredByText('', 'url:inventory'))).toEqual(['inventory-put']);
+    expect(ids(report.httpCallsWithStatusAndFilteredByText('', 'owner:platform'))).toEqual(['audit-get']);
+  });
+
+  test('filters HTTP calls by owning test and composes alternatives with negative clauses', () => {
+    expect(ids(report.httpCallsWithStatusAndFilteredByText('', 'test:"card payments"'))).toEqual([
+      'charge-post',
+      'audit-get',
+      'refund-delete',
+    ]);
+    expect(ids(report.httpCallsWithStatusAndFilteredByText('', 'method:get|method:delete'))).toEqual([
+      'audit-get',
+      'refund-delete',
+    ]);
+    expect(ids(report.httpCallsWithStatusAndFilteredByText('', 'test:checkout -url:audit'))).toEqual([
+      'charge-post',
+      'cash-post',
+    ]);
+    expect(ids(report.httpCallsWithStatusAndFilteredByText('', 'status:passed -method:post'))).toEqual([
+      'audit-get',
+      'refund-delete',
+    ]);
+  });
+});
