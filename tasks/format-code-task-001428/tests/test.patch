+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export NODE_BACKEND=js
+unset BCRYPTO_FORCE_TORSION
+
+if [ ! -d node_modules ]; then
+  echo "node_modules is missing; dependencies must be preinstalled for offline tests." >&2
+  exit 1
+fi
+
+if [ ! -x ./node_modules/.bin/bmocha ]; then
+  echo "bmocha is missing from node_modules; dependencies must be preinstalled for offline tests." >&2
+  exit 1
+fi
+
+node -e "require('bsert'); require('bmocha'); require('./lib/hd')" >/dev/null
+
+exec ./node_modules/.bin/bmocha --no-config --reporter spec \
+  /workspace/repo/usercase-test-coderl/hd_path_derivation.test.js
