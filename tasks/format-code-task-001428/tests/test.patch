diff --git a/usercase-test-coderl/hd_path_derivation.test.js b/usercase-test-coderl/hd_path_derivation.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/hd_path_derivation.test.js
@@ -0,0 +1,242 @@
+'use strict';
+
+const assert = require('bsert');
+const HD = require('../lib/hd');
+
+const SEED_PRIVATE = Buffer.from(
+  '000102030405060708090a0b0c0d0e0f',
+  'hex');
+
+const SEED_PUBLIC = Buffer.from(
+  'fffcf9f6f3f0edeae7e4e1dedbd8d5d2'
+  + 'cfccc9c6c3c0bdbab7b4b1aeaba8a5a2'
+  + '9f9c999693908d8a8784817e7b7875726f'
+  + '6c696663605d5a5754514e4b484542',
+  'hex');
+
+function resetCache() {
+  HD.common.cache.reset();
+}
+
+function privateMaster() {
+  resetCache();
+  return HD.PrivateKey.fromSeed(SEED_PRIVATE);
+}
+
+function publicMaster() {
+  resetCache();
+  return HD.PrivateKey.fromSeed(SEED_PUBLIC).toPublic();
+}
+
+function assertPathError(fn) {
+
+  assert.throws(fn, {
+    name: 'Error'
+  });
+}
+
+describe('Usercase HD path derivation', function() {
+  beforeEach(() => resetCache());
+
+  it('derives private children from slash-separated hardened and non-hardened paths', () => {
+
+
+
+
+    const key = privateMaster();
+
+    assert.strictEqual(key.derivePath('m').equals(key), true);
+
+    const first = key.derivePath('m/0\'');
+    assert.strictEqual(first.toBase58('main'),
+      'xprv9uHRZZhk6KAJC1avXpDAp4MDc3sQKNxDiPvvkX8Br5ngLNv1TxvUxt4cV1rGL5hj6KCesnDYUhd7oWgT11eZG7XnxHrnYeSvkzY7d2bhkJ7');
+
+    assert.strictEqual(first.equals(key.derive(0, true)), true);
+
+    const pathChild = key.derivePath('m/0\'/1/2\'/2/1000000000');
+    assert.strictEqual(pathChild.toBase58('main'),
+      'xprvA41z7zogVVwxVSgdKUHDy1SKmdb533PjDz7J6N6mV6uS3ze1ai8FHa8kmHScGpWmj4WggLyQjgPie1rFSruoUihUZREPSL39UNdE3BBDu76');
+
+    const sequential = key
+      .derive(0, true)
+      .derive(1)
+      .derive(2, true)
+      .derive(2)
+      .derive(1000000000);
+
+    assert.strictEqual(pathChild.equals(sequential), true);
+  });
+
+  it('accepts private path roots and unsigned 32-bit boundary indexes', () => {
+
+
+
+
+    const key = privateMaster();
+
+    assert.strictEqual(HD.PrivateKey.isValidPath('m'), true);
+    assert.strictEqual(HD.PrivateKey.isValidPath('M'), true);
+    assert.strictEqual(HD.PrivateKey.isValidPath('m\''), true);
+    assert.strictEqual(HD.PrivateKey.isValidPath('M\''), true);
+    assert.strictEqual(HD.PrivateKey.isValidPath('M/0/1\''), true);
+    assert.strictEqual(HD.PrivateKey.isValidPath('m/0/4294967295'), true);
+
+
+    assert.strictEqual(key.derivePath('m').equals(key), true);
+    assert.strictEqual(key.derivePath('M').equals(key), true);
+    assert.strictEqual(key.derivePath('m\'').equals(key), true);
+    assert.strictEqual(key.derivePath('M\'').equals(key), true);
+
+    const mixed = key.derivePath('M/0/1\'');
+
+    assert.strictEqual(mixed.equals(key.derive(0).derive(1, true)), true);
+
+    const max = key.derivePath('m/0/4294967295');
+
+    assert.strictEqual(max.equals(key.derive(0).derive(4294967295)), true);
+  });
+
+  it('derives public children only for non-hardened paths', () => {
+
+
+
+
+    const pub = publicMaster();
+
+    assert.strictEqual(pub.derivePath('m').equals(pub), true);
+
+    const first = pub.derivePath('m/0');
+    assert.strictEqual(first.toBase58('main'),
+      'xpub69H7F5d8KSRgmmdJg2KhpAK8SR3DjMwAdkxj3ZuxV27CprR9LgpeyGmXUbC6wb7ERfvrnKZjXoUmmDznezpbZb7ap6r1D3tgFxHmwMkQTPH');
+
+    assert.strictEqual(first.equals(pub.derive(0)), true);
+
+    const pathChild = pub.derivePath('M/0/2147483647/1');
+
+    const sequential = pub.derive(0).derive(2147483647).derive(1);
+
+    assert.strictEqual(pathChild.equals(sequential), true);
+
+    const edge = pub.derivePath('m/2147483647');
+
+    assert.strictEqual(edge.equals(pub.derive(2147483647)), true);
+  });
+
+  it('validates private and public paths without mutating key state', () => {
+
+
+
+
+    const key = privateMaster();
+    const pub = publicMaster();
+
+    assert.strictEqual(HD.PrivateKey.isValidPath('m/0\''), true);
+    assert.strictEqual(HD.PrivateKey.isValidPath('M/0/1\''), true);
+    assert.strictEqual(HD.PrivateKey.isValidPath('x/0'), false);
+    assert.strictEqual(HD.PrivateKey.isValidPath('m/not'), false);
+    assert.strictEqual(HD.PrivateKey.isValidPath('m/12345678901'), false);
+    assert.strictEqual(HD.PrivateKey.isValidPath('m/4294967296'), false);
+
+    assert.strictEqual(HD.PublicKey.isValidPath('m'), true);
+    assert.strictEqual(HD.PublicKey.isValidPath('M\''), true);
+    assert.strictEqual(HD.PublicKey.isValidPath('m/0'), true);
+    assert.strictEqual(HD.PublicKey.isValidPath('m/2147483647'), true);
+    assert.strictEqual(HD.PublicKey.isValidPath('m/0\''), false);
+    assert.strictEqual(HD.PublicKey.isValidPath('x/0'), false);
+    assert.strictEqual(HD.PublicKey.isValidPath('m/not'), false);
+    assert.strictEqual(HD.PublicKey.isValidPath('m/12345678901'), false);
+    assert.strictEqual(HD.PublicKey.isValidPath('m/4294967296'), false);
+
+    assert.strictEqual(key.depth, 0);
+    assert.strictEqual(key.childIndex, 0);
+    assert.strictEqual(pub.depth, 0);
+    assert.strictEqual(pub.childIndex, 0);
+
+    assert.strictEqual(key.derivePath('m').equals(key), true);
+    assert.strictEqual(pub.derivePath('m').equals(pub), true);
+  });
+
+  it('throws Error for malformed or disallowed paths', () => {
+
+
+
+
+    const key = privateMaster();
+    const pub = publicMaster();
+
+    assertPathError(() => key.derivePath('x/0'));
+    assertPathError(() => key.derivePath('m/not'));
+    assertPathError(() => key.derivePath('m/12345678901'));
+    assertPathError(() => key.derivePath('m/4294967296'));
+    assertPathError(() => pub.derivePath('m/0\''));
+    assertPathError(() => pub.derivePath('x/0'));
+    assertPathError(() => pub.derivePath('m/not'));
+    assertPathError(() => pub.derivePath('m/12345678901'));
+    assertPathError(() => pub.derivePath('m/4294967296'));
+
+    assert.strictEqual(key.depth, 0);
+    assert.strictEqual(key.childIndex, 0);
+    assert.strictEqual(pub.depth, 0);
+    assert.strictEqual(pub.childIndex, 0);
+  });
+
+  it('keeps repeated derivation and separate key instances independent', () => {
+
+
+
+
+    const a = HD.PrivateKey.fromSeed(SEED_PRIVATE);
+    const b = HD.PrivateKey.fromSeed(SEED_PUBLIC);
+
+    const a1 = a.derivePath('m/0\'/1');
+    const a2 = a.derivePath('m/0\'/1');
+    const b1 = b.derivePath('m/0');
+
+
+    assert.strictEqual(a1.equals(a2), true);
+    assert.strictEqual(a1.equals(a.derive(0, true).derive(1)), true);
+    assert.strictEqual(a.derivePath('m').equals(a), true);
+
+
+    assert.strictEqual(b1.equals(b.derive(0)), true);
+    assert.strictEqual(b.derivePath('m').equals(b), true);
+  });
+
+  it('handles root-only paths as no-op derivations', () => {
+
+
+
+
+    const key = privateMaster();
+    const pub = key.toPublic();
+
+
+    assert.strictEqual(key.derivePath('m').equals(key), true);
+    assert.strictEqual(key.derivePath('M').equals(key), true);
+    assert.strictEqual(key.derivePath('m\'').equals(key), true);
+    assert.strictEqual(key.derivePath('M\'').equals(key), true);
+    assert.strictEqual(pub.derivePath('m').equals(pub), true);
+    assert.strictEqual(pub.derivePath('M').equals(pub), true);
+  });
+
+  it('keeps repeated path derivation independent across repeated sessions', () => {
+
+
+
+
+    resetCache();
+
+    for (let i = 0; i < 250; i++) {
+      const key = HD.PrivateKey.fromSeed(SEED_PRIVATE);
+      const child = key.derivePath('m/0\'/1/2\'/2/1000000000');
+      const sequential = key
+        .derive(0, true)
+        .derive(1)
+        .derive(2, true)
+        .derive(2)
+        .derive(1000000000);
+
+      assert.strictEqual(child.equals(sequential), true);
+    }
+  });
+});
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
