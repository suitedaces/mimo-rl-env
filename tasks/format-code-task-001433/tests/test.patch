+def test_two_bus_instances_keep_independent_periodic_state() -> None:
+
+
+
+
+    bus_a = RecordingBus()
+    bus_b = RecordingBus()
+    task_a = bus_a.send_periodic(can.Message(arbitration_id=0x141, data=[1]), 0.01)
+    task_b = bus_b.send_periodic(
+        can.Message(arbitration_id=0x142, data=[2]), 0.01, autostart=False
+    )
+
+    try:
+        assert wait_for_sends(bus_a, 3)[:3] == [
+            (321, None, b"\x01"),
+            (321, None, b"\x01"),
+            (321, None, b"\x01"),
+        ]
+        time.sleep(0.04)
+        assert bus_b.snapshot() == []
+        task_b.start()
+        assert wait_for_sends(bus_b, 2)[:2] == [
+            (322, None, b"\x02"),
+            (322, None, b"\x02"),
+        ]
+    finally:
+        task_a.stop()
+        task_b.stop()
+        bus_a.shutdown()
+        bus_b.shutdown()
+
+
+def test_periodic_cleanup_does_not_leak_sender_threads() -> None:
+
+
+
+
+    stopped_buses = []
+
+    for index in range(30):
+        bus = RecordingBus()
+        task = bus.send_periodic(
+            can.Message(arbitration_id=0x170 + index, data=[1]), 0.005
+        )
+        wait_for_sends(bus, 1)
+        task.stop()
+        bus.shutdown()
+        bus.clear()
+        stopped_buses.append(bus)
+
+    time.sleep(0.08)
+
+    assert all(bus.snapshot() == [] for bus in stopped_buses)
+
+
+def test_thread_safe_bus_allows_periodic_and_normal_send() -> None:
+
+
+
+
+    channel = "fixture-threadsafe-periodic"
+    with can.ThreadSafeBus(
+        channel=channel, interface="virtual", receive_own_messages=True
+    ) as bus:
+        task = bus.send_periodic(can.Message(arbitration_id=0x160, data=[6]), 0.01)
+        try:
+            periodic_messages = []
+            deadline = time.monotonic() + 0.5
+            while len(periodic_messages) < 3 and time.monotonic() < deadline:
+                msg = bus.recv(timeout=0.05)
+                if msg is not None:
+                    periodic_messages.append(
+                        (msg.arbitration_id, bytes(msg.data))
+                    )
+
+
+            assert periodic_messages[:3] == [
+                (352, b"\x06"),
+                (352, b"\x06"),
+                (352, b"\x06"),
+            ]
+
+            task.stop()
+            while bus.recv(timeout=0.01) is not None:
+                pass
+
+            bus.send(can.Message(arbitration_id=0x161, data=[7]))
+            normal_msg = bus.recv(timeout=0.2)
+            normal_observed = (
+                None
+                if normal_msg is None
+                else (
+                    normal_msg.arbitration_id,
+                    bytes(normal_msg.data),
+                )
+            )
+
+            assert normal_observed == (353, b"\x07")
+        finally:
+            task.stop()
