+func Test_Push_TLS_Scheme(t *testing.T) {
+	backoffCfg := backoff.Config{
+		MinBackoff: 300 * time.Millisecond,
+		MaxBackoff: 5 * time.Minute,
+		MaxRetries: 10,
+	}
+
+	addr := "loki-internal.alb:443"
+
+	cases := []struct {
+		name       string
+		useTLS     bool
+		withTLSCfg bool
+		wantScheme string
+	}{
+		{
+			name:       "useTLS=true with nil tlsCfg uses https",
+			useTLS:     true,
+			withTLSCfg: false,
+			wantScheme: "https",
+		},
+		{
+			name:       "useTLS=false with nil tlsCfg uses http",
+			useTLS:     false,
+			withTLSCfg: false,
+			wantScheme: "http",
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var tlsCfg *tls.Config
+			if tc.withTLSCfg {
+				tlsCfg = &tls.Config{}
+			}
+			push, err := NewPush(
+				addr, "test1", 2*time.Second,
+				config.DefaultHTTPClientConfig,
+				"name", "loki-canary",
+				"stream", "stdout",
+				tc.useTLS,
+				tlsCfg,
+				"",
+				"", "",
+				&backoffCfg,
+				log.NewNopLogger(),
+			)
+			require.NoError(t, err)
+			require.NotNil(t, push)
+
+			wantURL := tc.wantScheme + "://" + addr + pushEndpoint
+			assert.Equal(t, wantURL, push.lokiURL,
+				"useTLS=%v should produce URL with scheme %q",
+				tc.useTLS, tc.wantScheme)
+			assert.True(t, strings.HasPrefix(push.lokiURL, tc.wantScheme+"://"),
+				"lokiURL %q should start with %q://", push.lokiURL, tc.wantScheme)
+		})
+	}
+}
