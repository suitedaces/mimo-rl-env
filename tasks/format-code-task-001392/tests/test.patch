+
+func Test_Push_IssueRepro_TLSTrueProducesHTTPSURL(t *testing.T) {
+	backoffCfg := backoff.Config{
+		MinBackoff: 300 * time.Millisecond,
+		MaxBackoff: 5 * time.Minute,
+		MaxRetries: 10,
+	}
+
+	push, err := NewPush(
+		"loki-internal.alb:443",
+		"",
+		10*time.Second,
+		config.DefaultHTTPClientConfig,
+		"canary-id", "canary-1234",
+		"source", "stdout",
+		true,
+		nil,
+		"",
+		"LOKI_USER", "LOKI_PASSWORD",
+		&backoffCfg,
+		log.NewNopLogger(),
+	)
+	require.NoError(t, err)
+	require.NotNil(t, push)
+
+	assert.True(t, strings.HasPrefix(push.lokiURL, "https://"),
+		"expected https URL when -tls=true was passed, got %q", push.lokiURL)
+	assert.False(t, strings.HasPrefix(push.lokiURL, "http://"),
+		"URL must NOT be http:// when -tls=true (the original bug)")
+	assert.Equal(t, "https://loki-internal.alb:443/loki/api/v1/push", push.lokiURL)
+}
