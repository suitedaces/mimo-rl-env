+++ b/bundles/binding/org.openhab.binding.samsungac.test/src/test/java/org/openhab/binding/samsungac/communicator/ResponseParserSemanticContractTest.java
@@ -0,0 +1,186 @@
+
+
+
+
+
+
+
+
+package org.openhab.binding.samsungac.communicator;
+
+import java.util.Map;
+import java.lang.reflect.Method;
+
+import junit.framework.TestCase;
+
+import org.openhab.binding.samsungac.internal.CommandEnum;
+import org.openhab.binding.samsungac.internal.ResponseParser;
+import org.xml.sax.SAXException;
+
+public class ResponseParserSemanticContractTest extends TestCase {
+
+    public void testProtocolGreetingMustMatchTheWholeTrimmedLine() {
+        assertTrue(ResponseParser.isFirstLine("  DRC-1.00  "));
+        assertTrue(ResponseParser.isFirstLine("DPLUG-1.6"));
+        assertFalse(ResponseParser.isFirstLine("noise DRC-1.00"));
+        assertFalse(ResponseParser.isFirstLine("DPLUG-1.60"));
+        assertFalse(ResponseParser.isFirstLine(null));
+    }
+
+    public void testCompletedTokenResponseUsesXmlAttributesAndDecodesTheValue() {
+        String reordered = "<?xml version='1.0'?><Update Token='abc&amp;&quot;42' Status='Completed' Type='GetToken'/>";
+        assertTrue(ResponseParser.isResponseWithToken(reordered));
+        assertEquals("abc&\"42", ResponseParser.parseTokenFromResponse(reordered));
+
+        assertFalse(ResponseParser.isResponseWithToken("<Update Type='GetToken' Status='Ready' Token='abc'/>"));
+        assertFalse(ResponseParser.isResponseWithToken("<Update Type='GetToken' Status='Completed' Token=''/>"));
+        assertFalse(ResponseParser.isResponseWithToken("<!-- Update Type=\"GetToken\" Status=\"Completed\" Token=\"abc\" -->"));
+        assertNull(ResponseParser.parseTokenFromResponse("<Update Type='GetToken' Status='Completed'/>") );
+        assertNull(ResponseParser.parseTokenFromResponse("not xml"));
+        assertNull(ResponseParser.parseTokenFromResponse(null));
+    }
+
+    public void testAuthenticationFailuresUseExactAttributes() {
+        assertTrue(ResponseParser
+                .isFailedAuthenticationResponse("<Response ErrorCode='301' Type='Authenticate' Status='Fail'/>") );
+        assertFalse(ResponseParser
+                .isFailedAuthenticationResponse("<Response ErrorCode='103' Type='Authenticate' Status='Fail'/>") );
+        assertFalse(ResponseParser
+                .isFailedAuthenticationResponse("<Response ErrorCode='3010' Type='Authenticate' Status='Fail'/>") );
+
+        assertTrue(ResponseParser.isFailedResponse("<Response Type='Authenticate' ErrorCode='103' Status='Fail' />"));
+        assertFalse(ResponseParser.isFailedResponse("<Response Type='Authenticate' ErrorCode='301' Status='Fail' />"));
+        assertFalse(ResponseParser.isFailedResponse("<Response Type='Other' ErrorCode='103' Status='Fail' />"));
+    }
+
+    public void testAuthenticationProgressAndInvalidationUseRootAttributes() {
+        assertTrue(ResponseParser.isSuccessfulLoginResponse("<Response Status='Okay' Type='AuthToken'/>") );
+        assertFalse(ResponseParser.isSuccessfulLoginResponse("<Response Status='Fail' Type='AuthToken'/>") );
+
+        assertTrue(ResponseParser.isReadyForTokenResponse("<Response Status='Ready' Type='GetToken' />"));
+        assertFalse(ResponseParser.isReadyForTokenResponse("<Response Status='Completed' Type='GetToken' />"));
+
+        assertTrue(ResponseParser.isNotLoggedInResponse("<Update Reason='expired' Type='InvalidateAccount'/>") );
+        assertFalse(ResponseParser.isNotLoggedInResponse("<Response Type='InvalidateAccount'/>") );
+        assertFalse(ResponseParser.isNotLoggedInResponse("<Update Type='InvalidateAccountAgain'/>") );
+    }
+
+    public void testDeviceControlAndStatusUpdateUseExactRootKinds() {
+        assertTrue(ResponseParser.isDeviceControl("<Response Status='Okay' Type='DeviceControl'/>") );
+        assertFalse(ResponseParser.isDeviceControl("<Update Type='DeviceControl'/>") );
+        assertFalse(ResponseParser.isDeviceControl("<Response Type='DeviceController'/>") );
+
+        assertTrue(ResponseParser.isUpdateStatus("<Update DUID='unit-1' Type='Status'/>") );
+        assertFalse(ResponseParser.isUpdateStatus("<Response Type='Status'/>") );
+        assertFalse(ResponseParser.isUpdateStatus("<Update Type='StatusChanged'/>") );
+    }
+
+    public void testDeviceStateExcludesEveryCommandResponse() {
+        assertTrue(ResponseParser.isDeviceState("<Response Status='Okay' Type='DeviceState' DUID='unit-1'/>") );
+        assertFalse(ResponseParser
+                .isDeviceState("<Response CommandID='request-7' Status='Okay' Type='DeviceState'/>") );
+        assertFalse(ResponseParser
+                .isDeviceState("<Response CommandID='' Status='Okay' Type='DeviceState'/>") );
+        assertFalse(ResponseParser.isDeviceState("<Response Status='Fail' Type='DeviceState'/>") );
+        assertFalse(ResponseParser.isDeviceState("<Update Status='Okay' Type='DeviceState'/>") );
+    }
+
+    public void testCommandCorrelationIsExactAndIgnoresMarkupText() {
+        String response = "<Response Type='DeviceControl' CommandID='cmd-8'><!-- CommandID=\"cmd-7\" --></Response>";
+        assertTrue(ResponseParser.isCorrectCommandResponse(response, "cmd-8"));
+        assertFalse(ResponseParser.isCorrectCommandResponse(response, "cmd-7"));
+        assertFalse(ResponseParser.isCorrectCommandResponse(response, "cmd"));
+        assertFalse(ResponseParser.isCorrectCommandResponse(response, null));
+    }
+
+    public void testMalformedOrAbsentXmlNeverMatchesPredicates() {
+        String malformed = "<Response Type='DeviceControl'";
+        assertFalse(ResponseParser.isResponseWithToken(malformed));
+        assertFalse(ResponseParser.isFailedAuthenticationResponse(malformed));
+        assertFalse(ResponseParser.isFailedResponse(malformed));
+        assertFalse(ResponseParser.isCorrectCommandResponse(malformed, "cmd"));
+        assertFalse(ResponseParser.isSuccessfulLoginResponse(malformed));
+        assertFalse(ResponseParser.isNotLoggedInResponse(malformed));
+        assertFalse(ResponseParser.isReadyForTokenResponse(malformed));
+        assertFalse(ResponseParser.isDeviceControl(malformed));
+        assertFalse(ResponseParser.isDeviceState(malformed));
+        assertFalse(ResponseParser.isUpdateStatus(malformed));
+
+        String[] predicateNames = { "isResponseWithToken", "isFailedAuthenticationResponse", "isFailedResponse",
+                "isSuccessfulLoginResponse", "isNotLoggedInResponse", "isReadyForTokenResponse",
+                "isDeviceControl", "isDeviceState", "isUpdateStatus" };
+        for (String predicateName : predicateNames) {
+            try {
+                Method predicate = ResponseParser.class.getMethod(predicateName, String.class);
+                assertEquals(Boolean.FALSE, predicate.invoke(null, new Object[] { null }));
+            } catch (Exception e) {
+                fail(predicateName + " must return false for null input, not throw " + e);
+            }
+        }
+        try {
+            assertFalse(ResponseParser.isCorrectCommandResponse(null, "cmd"));
+        } catch (Exception e) {
+            fail("isCorrectCommandResponse must return false for null input, not throw " + e);
+        }
+    }
+
+    public void testCanonicalProtocolFormsRemainSupported() throws Exception {
+        assertTrue(ResponseParser.isResponseWithToken(
+                "<Update Type=\"GetToken\" Status=\"Completed\" Token=\"token-1\"/>"));
+        assertEquals("token-1", ResponseParser.parseTokenFromResponse(
+                "<Update Type=\"GetToken\" Status=\"Completed\" Token=\"token-1\"/>"));
+        assertTrue(ResponseParser.isFailedAuthenticationResponse(
+                "<Response Status=\"Fail\" Type=\"Authenticate\" ErrorCode=\"301\" />"));
+        assertTrue(ResponseParser.isFailedResponse(
+                "<Response Status=\"Fail\" Type=\"Authenticate\" ErrorCode=\"103\" />"));
+        assertTrue(ResponseParser.isSuccessfulLoginResponse("<Response Type=\"AuthToken\" Status=\"Okay\"/>"));
+        assertTrue(ResponseParser.isReadyForTokenResponse("<Response Type=\"GetToken\" Status=\"Ready\"/>"));
+        assertTrue(ResponseParser.isNotLoggedInResponse("<Update Type=\"InvalidateAccount\"/>"));
+        assertTrue(ResponseParser.isDeviceControl("<Response Type=\"DeviceControl\"/>"));
+        assertTrue(ResponseParser.isDeviceState("<Response Type=\"DeviceState\" Status=\"Okay\"/>"));
+        assertTrue(ResponseParser.isUpdateStatus("<Update Type=\"Status\"/>"));
+        assertTrue(ResponseParser.isCorrectCommandResponse("<Response CommandID=\"cmd1\"/>", "cmd1"));
+    }
+
+    public void testStatusParsingAcceptsOnlyStatusPayloadsAndUsesLastKnownValue() throws Exception {
+        String unrelated = "<Response Type='DeviceControl'><Attr ID='AC_FUN_POWER' Value='On'/></Response>";
+        assertTrue(ResponseParser.parseStatusResponse(unrelated).isEmpty());
+        String failedState = "<Response Type='DeviceState' Status='Fail'><Attr ID='AC_FUN_POWER' Value='On'/></Response>";
+        assertTrue(ResponseParser.parseStatusResponse(failedState).isEmpty());
+
+        String response = "<Response Status='Okay' Type='DeviceState'><DeviceState><Device>"
+                + "<Attr Value='On' ID='AC_FUN_POWER'/>"
+                + "<Attr ID='VENDOR_EXTENSION' Value='ignored'/>"
+                + "<Attr Value='missing-id'/>"
+                + "<Attr ID='AC_FUN_TEMPSET' Value='20&amp;half'/>"
+                + "<Attr ID='AC_FUN_POWER' Value='Off'/>"
+                + "</Device></DeviceState></Response>";
+        Map<CommandEnum, String> result = ResponseParser.parseStatusResponse(response);
+        assertEquals(2, result.size());
+        assertEquals("Off", result.get(CommandEnum.AC_FUN_POWER));
+        assertEquals("20&half", result.get(CommandEnum.AC_FUN_TEMPSET));
+
+        String update = "<Update Type='Status'><Attr ID='AC_FUN_TEMPNOW' Value='21'/></Update>";
+        assertEquals("21", ResponseParser.parseStatusResponse(update).get(CommandEnum.AC_FUN_TEMPNOW));
+    }
+
+    public void testMalformedStatusXmlPropagatesAsSaxException() {
+        try {
+            ResponseParser.parseStatusResponse("<Response Type='DeviceState'>");
+            fail("Malformed status XML must throw SAXException");
+        } catch (SAXException expected) {
+
+        }
+    }
+
+    public void testDoctypeIsRejectedBeforeEntityExpansion() throws Exception {
+        String response = "<!DOCTYPE Response [<!ENTITY injected 'On'>]>"
+                + "<Response Type='DeviceState' Status='Okay'><Attr ID='AC_FUN_POWER' Value='&injected;'/></Response>";
+        try {
+            ResponseParser.parseStatusResponse(response);
+            fail("Status XML containing a DOCTYPE must be rejected");
+        } catch (SAXException expected) {
+
+        }
+    }
+}
