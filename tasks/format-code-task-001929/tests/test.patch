+
+func TestCJKExactSpeedBoundaryRoundsToOneMinute(t *testing.T) {
+
+
+	got := readingtime.EstimateReadingTime("漢字仮名", 200, 4)
+	want := 1
+	if got != want {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, want)
