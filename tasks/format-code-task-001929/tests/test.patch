+
+func TestEmptyContentReturnsZero(t *testing.T) {
+
+
+	got := readingtime.EstimateReadingTime("", 200, 500)
+	want := 0
+	if got != want {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, want)
+	}
+}
+
+func TestNonCJKPositiveSpeedDividesDetectedWordCount(t *testing.T) {
+
+	got := readingtime.EstimateReadingTime("one two", 1, 500)
+	want := 2
+	if got != want {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, want)
+	}
+}
+
+func TestReferentialTransparencySameInputSameResult(t *testing.T) {
+	content := "<p>alpha beta gamma delta epsilon</p>"
+	first := readingtime.EstimateReadingTime(content, 4, 100)
+	second := readingtime.EstimateReadingTime(content, 4, 100)
+	if first != 2 || second != 2 {
+		t.Fatalf("repeated calls returned (%d, %d), want (2, 2)", first, second)
+	}
+	if first != second {
+		t.Fatalf("same input returned different results: %d then %d", first, second)
+	}
+}
+
+func TestDoesNotMutateInputString(t *testing.T) {
+	content := "<article>alpha beta <strong>gamma</strong></article>"
+	before := strings.Clone(content)
+
+	got := readingtime.EstimateReadingTime(content, 2, 100)
+	if got != 2 {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, 2)
+	}
+	if content != before {
+		t.Fatalf("content mutated to %q, want %q", content, before)
+	}
+}
+
+func TestNoGlobalStateWithInProcessNoise(t *testing.T) {
+	content := "alpha beta gamma delta epsilon"
+	first := readingtime.EstimateReadingTime(content, 4, 100)
+
+	noiseInputs := []struct {
+		content             string
+		defaultReadingSpeed int
+		cjkReadingSpeed     int
+		want                int
+	}{
+		{"漢字漢字漢字漢字", 200, 4, 2},
+		{"one two three four", 2, 500, 2},
+		{"", 200, 500, 0},
+	}
+	for _, noise := range noiseInputs {
+		if got := readingtime.EstimateReadingTime(noise.content, noise.defaultReadingSpeed, noise.cjkReadingSpeed); got != noise.want {
+			t.Fatalf("noise call returned %d, want %d for %q", got, noise.want, noise.content)
+		}
+	}
+
+	again := readingtime.EstimateReadingTime(content, 4, 100)
+	if first != 2 || again != 2 {
+		t.Fatalf("base calls returned (%d, %d), want (2, 2)", first, again)
+	}
+}
+
+func TestNoRelativeFilesystemSideEffects(t *testing.T) {
+	tempDir := t.TempDir()
+	originalDir, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd failed: %v", err)
+	}
+	if err := os.Chdir(tempDir); err != nil {
+		t.Fatalf("Chdir(%q) failed: %v", tempDir, err)
+	}
+	defer func() {
+		if err := os.Chdir(originalDir); err != nil {
+			t.Fatalf("restore Chdir(%q) failed: %v", originalDir, err)
+		}
+	}()
+
+	before := listRelativeFiles(t, tempDir)
+	got := readingtime.EstimateReadingTime("<p>alpha beta gamma</p>", 2, 100)
+	after := listRelativeFiles(t, tempDir)
+
+	if got != 2 {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, 2)
+	}
+	if !reflect.DeepEqual(after, before) {
+		t.Fatalf("working directory changed from %#v to %#v", before, after)
+	}
+}
+
+func listRelativeFiles(t *testing.T, root string) []string {
+	t.Helper()
+
+	var files []string
+	err := filepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if path == root {
+			return nil
+		}
+		relativePath, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		files = append(files, relativePath)
+		if d.IsDir() {
+			files = append(files, relativePath+"/")
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("WalkDir(%q) failed: %v", root, err)
+	}
+	sort.Strings(files)
+	return files
+}
