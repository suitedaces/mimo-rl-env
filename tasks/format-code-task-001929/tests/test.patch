+
+func TestMixedCJKMajorityUsesRuneCounting(t *testing.T) {
+
+
+	got := readingtime.EstimateReadingTime("abc漢字かな한글", 200, 5)
+	want := 2
+	if got != want {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, want)
+	}
