+func TestMixedMostlyNonCJKUsesWordCounting(t *testing.T) {
+
+
+	got := readingtime.EstimateReadingTime("Tofu Japanese 豆腐 Korean 두부", 3, 1)
+	want := 2
+	if got != want {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, want)
