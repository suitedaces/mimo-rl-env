+
+func TestNonCJKWordsUseDefaultReadingSpeed(t *testing.T) {
+
+
+	got := readingtime.EstimateReadingTime("one two three four", 2, 500)
+	want := 2
+	if got != want {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, want)
+	}
+}
+
+func TestHTMLTagsAreStrippedBeforeWordCounting(t *testing.T) {
+
+
+	got := readingtime.EstimateReadingTime("<p>one <strong>two</strong> three</p>", 2, 500)
+	want := 2
+	if got != want {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, want)
+	}
+}
+
+func TestXMLTagsAndMixedWhitespaceAreStrippedBeforeCounting(t *testing.T) {
+
+
+	content := "<article>\nalpha\tbeta\n <b>gamma</b> delta epsilon</article>"
+	got := readingtime.EstimateReadingTime(content, 3, 500)
+	want := 2
+	if got != want {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, want)
+	}
+}
+
+func TestNonCJKExactSpeedBoundaryRoundsToOneMinute(t *testing.T) {
+
+
+	got := readingtime.EstimateReadingTime("alpha beta gamma delta", 4, 500)
+	want := 1
+	if got != want {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, want)
+	}
+}
+
+func TestNonCJKOnePastSpeedBoundaryRoundsUp(t *testing.T) {
+
+
+	got := readingtime.EstimateReadingTime("alpha beta gamma delta epsilon", 4, 500)
+	want := 2
+	if got != want {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, want)
+	}
+}
+
+func TestCJKMajorityRunesUseCJKReadingSpeed(t *testing.T) {
+
+
+	got := readingtime.EstimateReadingTime("漢字漢字漢字漢字", 200, 4)
+	want := 2
+	if got != want {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, want)
+	}
+}
+
+func TestCJKTagsAreStrippedBeforeRuneCounting(t *testing.T) {
+
+
+	got := readingtime.EstimateReadingTime("<p>漢字<strong>仮名</strong></p>", 200, 3)
+	want := 2
+	if got != want {
+		t.Fatalf("EstimateReadingTime returned %d, want %d", got, want)
