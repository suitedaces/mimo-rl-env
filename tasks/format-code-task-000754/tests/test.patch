+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+cd /workspace/repo
+
+export TS_NODE_COMPILER_OPTIONS='{"module":"commonjs","jsx":"react-jsx","target":"es2019","moduleResolution":"node","esModuleInterop":true,"allowSyntheticDefaultImports":true}'
+
+export CI="${CI:-true}"
+export NO_UPDATE_NOTIFIER=1
+export npm_config_update_notifier=false
+export npm_config_offline=true
+
+if [ ! -x ./node_modules/.bin/jest ]; then
+  echo "Missing local Jest binary at /workspace/repo/node_modules/.bin/jest; refusing to install in offline test command." >&2
+  exit 127
+fi
+
+exec ./node_modules/.bin/jest /workspace/repo/usercase-test-coderl/select-next.test.ts \
+  --runInBand \
+  --no-cache \
+  --env=node \
+  --config '{"testEnvironment":"node","watchman":false,"roots":["/workspace/repo/usercase-test-coderl","/workspace/repo/packages/common/src"],"transform":{"^.+\\.[tj]sx?$":["ts-jest",{"tsconfig":"/workspace/repo/packages/common/tsconfig.spec.json","diagnostics":false,"isolatedModules":true}]},"moduleFileExtensions":["ts","tsx","js","jsx","json"],"testRegex":"select-next\\.test\\.ts$"}'
