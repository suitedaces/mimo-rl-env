+++ b/usercase-test-coderl/select-next.test.ts
@@ -0,0 +1,226 @@
+jest.mock(
+  '@data-driven-forms/react-form-renderer',
+  () => ({
+    useFormApi: () => ({}),
+    WizardContext: { Provider: ({ children }: { children: unknown }) => children },
+  }),
+  { virtual: true }
+);
+
+const { execFileSync } = require('child_process');
+const { selectNext } = require('../packages/common/src/wizard');
+
+describe('public selectNext wizard helper', () => {
+  test('returns a string next step unchanged', () => {
+
+
+    const actual = selectNext('shipping', () => ({ values: { choice: 'x' } }));
+
+    expect(actual).toBe('shipping');
+  });
+
+  test('resolves an object mapper from a direct value path', () => {
+
+
+    const nextStep = {
+      when: 'choice',
+      stepMapper: {
+        business: 'business-details',
+        personal: 'personal-details',
+      },
+    };
+
+    const actual = selectNext(nextStep, () => ({ values: { choice: 'business' } }));
+
+    expect(actual).toBe('business-details');
+  });
+
+  test('resolves a different object mapper branch from the same direct path', () => {
+
+
+    const nextStep = {
+      when: 'choice',
+      stepMapper: {
+        business: 'business-details',
+        personal: 'personal-details',
+      },
+    };
+
+    const actual = selectNext(nextStep, () => ({ values: { choice: 'personal' } }));
+
+    expect(actual).toBe('personal-details');
+  });
+
+  test('resolves an object mapper through a lodash-style nested array path', () => {
+
+
+    const nextStep = {
+      when: ['account', 'type'],
+      stepMapper: {
+        paid: 'billing',
+        free: 'summary',
+      },
+    };
+
+    const actual = selectNext(nextStep, () => ({ values: { account: { type: 'paid' } } }));
+
+    expect(actual).toBe('billing');
+  });
+
+  test('resolves another nested object mapper branch from the same lodash path', () => {
+
+
+    const nextStep = {
+      when: ['account', 'type'],
+      stepMapper: {
+        paid: 'billing',
+        free: 'summary',
+      },
+    };
+
+    const actual = selectNext(nextStep, () => ({ values: { account: { type: 'free' } } }));
+
+    expect(actual).toBe('summary');
+  });
+
+  test('calls a function nextStep with only the current values wrapper', () => {
+
+
+    const nextStep = (context: { values: { route: string } }) =>
+      Object.prototype.hasOwnProperty.call(context, 'ignored') ? 'leaked-state' : context.values.route;
+
+    const actual = selectNext(nextStep, () => ({ values: { route: 'review' }, ignored: 'secret' }));
+
+    expect(actual).toBe('review');
+  });
+
+  test('returns the promise produced by a function nextStep', async () => {
+
+
+    const expectedPromise = Promise.resolve('async-review');
+    const nextStep = ({ values }: { values: { route: string } }) => (values.route === 'async-review' ? expectedPromise : Promise.resolve('wrong'));
+
+    const actualPromise = selectNext(nextStep, () => ({ values: { route: 'async-review' } }));
+
+    expect(actualPromise).toBe(expectedPromise);
+    await expect(actualPromise).resolves.toBe('async-review');
+  });
+
+  test('throws TypeError for an object-style nextStep missing stepMapper', () => {
+    const nextStep = { when: 'choice' };
+    const getState = () => ({ values: { choice: 'business' } });
+
+    expect(() => selectNext(nextStep, getState)).toThrow(TypeError);
+  });
+
+  test('is referentially transparent for the same nextStep and state result', () => {
+    const nextStep = {
+      when: 'choice',
+      stepMapper: {
+        business: 'business-details',
+        personal: 'personal-details',
+      },
+    };
+    const getState = () => ({ values: { choice: 'personal' } });
+
+    const first = selectNext(nextStep, getState);
+    const second = selectNext(nextStep, getState);
+
+    expect(first).toBe(second);
+    expect(first).toBe('personal-details');
+    expect(second).toBe('personal-details');
+  });
+
+  test('does not mutate the nextStep definition or the state returned by getState', () => {
+    const nextStep = {
+      when: ['account', 'type'],
+      stepMapper: {
+        paid: 'billing',
+        free: 'summary',
+      },
+    };
+    const state = {
+      values: {
+        account: {
+          type: 'paid',
+          metadata: { tier: 3 },
+        },
+      },
+    };
+    const originalNextStep = JSON.parse(JSON.stringify(nextStep));
+    const originalState = JSON.parse(JSON.stringify(state));
+
+    const actual = selectNext(nextStep, () => state);
+
+    expect(actual).toBe('billing');
+    expect(nextStep).toEqual(originalNextStep);
+    expect(state).toEqual(originalState);
+  });
+
+  test('matches the same result in a fresh Node process', () => {
+    const nextStep = {
+      when: ['account', 'type'],
+      stepMapper: {
+        paid: 'billing',
+        free: 'summary',
+      },
+    };
+    const inProcess = selectNext(nextStep, () => ({ values: { account: { type: 'paid' } } }));
+    const script = `
+      const Module = require('module');
+      const originalLoad = Module._load;
+      Module._load = function(request, parent, isMain) {
+        if (request === '@data-driven-forms/react-form-renderer') {
+          return { useFormApi: () => ({}), WizardContext: { Provider: ({ children }) => children } };
+        }
+        return originalLoad.apply(this, arguments);
+      };
+      require('ts-node/register/transpile-only');
+      const { selectNext } = require('/workspace/repo/packages/common/src/wizard');
+      const actual = selectNext(
+        { when: ['account', 'type'], stepMapper: { paid: 'billing', free: 'summary' } },
+        () => ({ values: { account: { type: 'paid' } } })
+      );
+      process.stdout.write(JSON.stringify(actual));
+    `;
+    const fresh = JSON.parse(
+      execFileSync(process.execPath, ['-e', script], {
+        cwd: '/workspace/repo',
+        env: {
+          ...process.env,
+          TS_NODE_COMPILER_OPTIONS: JSON.stringify({
+            module: 'commonjs',
+            jsx: 'react-jsx',
+            target: 'es2019',
+            moduleResolution: 'node',
+            esModuleInterop: true,
+            allowSyntheticDefaultImports: true,
+          }),
+        },
+        encoding: 'utf8',
+      })
+    );
+
+    expect(inProcess).toBe('billing');
+    expect(fresh).toBe('billing');
+    expect(fresh).toBe(inProcess);
+  });
+
+  test('uses values for object-style selection without mutating inputs', () => {
+    const nextStep = { when: ['account', 'type'], stepMapper: { paid: 'billing', free: 'summary' } };
+    const state = {
+      account: { type: 'free' },
+      values: { account: { type: 'paid' } },
+    };
+    const originalNextStep = JSON.parse(JSON.stringify(nextStep));
+    const originalState = JSON.parse(JSON.stringify(state));
+
+    const actual = selectNext(nextStep, () => state);
+
+
+    expect(actual).toBe('billing');
+
+    expect(nextStep).toEqual(originalNextStep);
+    expect(state).toEqual(originalState);
+  });
+});
