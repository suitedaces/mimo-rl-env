+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+GOPATH_DIR="${TMPDIR:-/tmp}/lars-fixture-gopath"
+LOCALA_DEPS="/opt/stage4a_deps/lars-gopath/src"
+rm -rf "$GOPATH_DIR"
+mkdir -p "$GOPATH_DIR/src/github.com/go-playground" \
+         "$GOPATH_DIR/src/github.com/gorilla" \
+         "$GOPATH_DIR/src/gopkg.in/go-playground"
+
+ln -s /workspace/repo "$GOPATH_DIR/src/github.com/go-playground/lars"
+
+for dep in \
+  github.com/go-playground/form \
+  github.com/gorilla/websocket \
+  gopkg.in/go-playground/assert.v1
+do
+  if [ ! -d "$LOCALA_DEPS/$dep" ]; then
+    echo "missing staged offline dependency: $LOCALA_DEPS/$dep" >&2
+    exit 1
+  fi
+done
+
+ln -s "$LOCALA_DEPS/github.com/go-playground/form" \
+  "$GOPATH_DIR/src/github.com/go-playground/form"
+ln -s "$LOCALA_DEPS/github.com/gorilla/websocket" \
+  "$GOPATH_DIR/src/github.com/gorilla/websocket"
+ln -s "$LOCALA_DEPS/gopkg.in/go-playground/assert.v1" \
+  "$GOPATH_DIR/src/gopkg.in/go-playground/assert.v1"
+
+cd "$GOPATH_DIR/src/github.com/go-playground/lars"
+exec env GOPATH="$GOPATH_DIR" GO111MODULE=off GOPROXY=off GOSUMDB=off go test -v -count=1 ./usercase-test-coderl/...
