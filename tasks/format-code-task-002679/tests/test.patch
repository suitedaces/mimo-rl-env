diff --git a/test/tree.spec.js b/test/tree.spec.js
index fe91984..69bdf01 100644
--- a/test/tree.spec.js
+++ b/test/tree.spec.js
@@ -523,4 +523,284 @@ describe('Tree Functions', () => {
     await walkAsyncTest
     expect(tree.a.b.c.length).to.equal(4)
   })
+  it('mapTree preserves shape and passes traversal context', () => {
+    let getChildren = node => node.children
+    let tree = {
+      id: 'root',
+      children: [
+        { id: 'left', children: [{ id: 'left.a' }, { id: 'left.b' }] },
+        { id: 'right', children: [{ id: 'right.a' }] },
+      ],
+    }
+
+    let result = F.mapTree(getChildren)(
+      (node, index, parents = [], parentIndexes = []) => ({
+        ...node,
+        children: node.children ? node.children.slice() : node.children,
+        marker: parents.length
+          ? `${parents[0].id}:${index}:${parentIndexes.join('.')}`
+          : 'root',
+      }),
+      tree
+    )
+
+    expect(result).to.include({ id: 'root', marker: 'root' })
+    expect(_.map('id', result.children)).to.deep.equal(['left', 'right'])
+    expect(result.children[0].children[1]).to.include({ id: 'left.b' })
+    expect(result.children[1].children[0]).to.include({ id: 'right.a' })
+    expect(result.children[0]).to.include({
+      id: 'left',
+      marker: 'root:0:',
+    })
+    expect(result.children[1]).to.include({
+      id: 'right',
+      marker: 'root:1:',
+    })
+
+    let context = F.mapTree(getChildren)(
+      (node, index, parents = [], parentIndexes = []) => ({
+        ...node,
+        children: node.children ? node.children.slice() : node.children,
+        context: {
+          index,
+          parent: parents[0] && parents[0].id,
+          parentIndexDepth: parentIndexes.length,
+        },
+      }),
+      tree
+    )
+    expect({
+      ...context.children[0].context,
+      index: `${context.children[0].context.index}`,
+    }).to.deep.equal({
+      index: '0',
+      parent: 'root',
+      parentIndexDepth: 1,
+    })
+  })
+
+  it('mapTreeLeaves maps only leaves', () => {
+    let getChildren = node => node.children
+    let tree = {
+      id: 'root',
+      children: [
+        { id: 'branch', children: [{ id: 'leaf-a' }, { id: 'leaf-b' }] },
+        { id: 'leaf-c' },
+      ],
+    }
+
+    let result = F.mapTreeLeaves(getChildren)(
+      node => ({ ...node, leaf: true, id: `${node.id}!` }),
+      tree
+    )
+
+    expect(result.id).to.equal('root')
+    expect(result.children[0].id).to.equal('branch')
+    expect(result.children[0].children).to.deep.equal([
+      { id: 'leaf-a!', leaf: true },
+      { id: 'leaf-b!', leaf: true },
+    ])
+    expect(result.children[1]).to.deep.equal({ id: 'leaf-c!', leaf: true })
+
+    expect(F.mapTreeLeaves()(x => x * 10, 7)).to.equal(70)
+    expect(F.mapTreeLeaves()(x => (_.isNumber(x) ? x + 1 : x), {
+      a: {
+        b: {
+          c: {
+            d: 4,
+          },
+        },
+      },
+    })).to.deep.equal({
+      a: {
+        b: {
+          c: {
+            d: 5,
+          },
+        },
+      },
+    })
+  })
+
+  it('leavesBy customizes collected leaves with context', () => {
+    let getChildren = node => node.children
+    let tree = {
+      id: 'root',
+      children: [
+        { id: 'group', children: [{ id: 'alpha' }, { id: 'beta' }] },
+        { id: 'gamma' },
+      ],
+    }
+
+    let result = F.leavesBy(getChildren)((node, index, parents) => ({
+      id: node.id,
+      index,
+      parent: parents[0] && parents[0].id,
+      depth: parents.length,
+    }), tree)
+
+    expect(result).to.deep.equal([
+      { id: 'alpha', index: 0, parent: 'group', depth: 2 },
+      { id: 'beta', index: 1, parent: 'group', depth: 2 },
+      { id: 'gamma', index: 1, parent: 'root', depth: 1 },
+    ])
+
+    let calls = []
+    let values = F.leavesBy(getChildren)(
+      (node, index, parents, parentIndexes = []) => {
+        calls.push(node.id)
+        return {
+          id: node.id,
+          parentIndexDepth: parentIndexes.length,
+          parentIndexHead: parentIndexes[0],
+        }
+      },
+      tree
+    )
+    expect(calls).to.deep.equal(['alpha', 'beta', 'gamma'])
+    expect(values).to.deep.equal([
+      { id: 'alpha', parentIndexDepth: 2, parentIndexHead: 0 },
+      { id: 'beta', parentIndexDepth: 2, parentIndexHead: 0 },
+      { id: 'gamma', parentIndexDepth: 1, parentIndexHead: undefined },
+    ])
+
+    let anonymousLeaves = F.leavesBy(getChildren)(
+      node => node.label,
+      { children: [{ label: 'nameless' }] }
+    )
+    expect(anonymousLeaves).to.deep.equal(['nameless'])
+  })
+
+  it('treeToArrayBy passes traversal context', () => {
+    let getChildren = node => node.children
+    let tree = {
+      id: 'root',
+      children: [
+        { id: 'first', children: [{ id: 'first.leaf' }] },
+        { id: 'second' },
+      ],
+    }
+
+    let result = F.treeToArrayBy(getChildren)(
+      (node, index, parents = [], parentIndexes = []) => ({
+        id: node.id,
+        index,
+        parent: parents[0] && parents[0].id,
+        depth: parents.length,
+        parentIndexDepth: parentIndexes.length,
+      }),
+      tree
+    )
+
+    expect(result).to.deep.equal([
+      {
+        id: 'root',
+        index: undefined,
+        parent: undefined,
+        depth: 0,
+        parentIndexDepth: 0,
+      },
+      {
+        id: 'first',
+        index: 0,
+        parent: 'root',
+        depth: 1,
+        parentIndexDepth: 1,
+      },
+      {
+        id: 'first.leaf',
+        index: 0,
+        parent: 'first',
+        depth: 2,
+        parentIndexDepth: 2,
+      },
+      {
+        id: 'second',
+        index: 1,
+        parent: 'root',
+        depth: 1,
+        parentIndexDepth: 1,
+      },
+    ])
+
+    let parentIndexValues = F.treeToArrayBy(getChildren)(
+      (node, index, parents = [], parentIndexes = []) => ({
+        id: node.id,
+        parentIndexes,
+      }),
+      tree
+    )
+    expect(parentIndexValues[2]).to.deep.equal({
+      id: 'first.leaf',
+      parentIndexes: [0, undefined],
+    })
+  })
+
+  it('tree factory exposes map leavesBy and mapLeaves', () => {
+    let getChildren = node => node.children
+    let helpers = F.tree(getChildren)
+    let tree = {
+      id: 'root',
+      children: [
+        { id: 'branch', children: [{ id: 'leaf-a' }] },
+        { id: 'leaf-b' },
+      ],
+    }
+
+    expect(helpers.map).to.be.a('function')
+    expect(helpers.mapLeaves).to.be.a('function')
+    expect(helpers.leavesBy).to.be.a('function')
+
+    expect(helpers.leavesBy(node => node.id, tree)).to.deep.equal([
+      'leaf-a',
+      'leaf-b',
+    ])
+
+    let mapped = helpers.map(
+      node => ({
+        ...node,
+        children: node.children ? node.children.slice() : node.children,
+        seen: true,
+      }),
+      tree
+    )
+    expect(mapped).to.include({ id: 'root', seen: true })
+    expect(mapped.children[0]).to.include({ id: 'branch', seen: true })
+    expect(mapped.children[0].children[0]).to.include({ id: 'leaf-a' })
+
+    let leafMapped = helpers.mapLeaves(node => ({ ...node, leaf: true }), tree)
+    expect(leafMapped.children[0].id).to.equal('branch')
+    expect(leafMapped.children[0].children[0]).to.include({ leaf: true })
+    expect(leafMapped.children[1]).to.include({ id: 'leaf-b', leaf: true })
+
+    let helperLeafContext = helpers.leavesBy(
+      (node, index, parents = [], parentIndexes = []) => ({
+        id: node.id,
+        parent: parents[0] && parents[0].id,
+        parentIndexDepth: parentIndexes.length,
+      }),
+      tree
+    )
+    expect(helperLeafContext).to.deep.equal([
+      { id: 'leaf-a', parent: 'branch', parentIndexDepth: 2 },
+      { id: 'leaf-b', parent: 'root', parentIndexDepth: 1 },
+    ])
+
+    let deepLeafMapped = helpers.mapLeaves(
+      node => ({ ...node, marked: true }),
+      {
+        id: 'deep-root',
+        children: [
+          {
+            id: 'level-1',
+            children: [{ id: 'level-2', children: [{ id: 'level-3' }] }],
+          },
+        ],
+      }
+    )
+    expect(deepLeafMapped.children[0].children[0].children[0]).to.include({
+      id: 'level-3',
+      marked: true,
+    })
+  })
 })
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,24 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+if [ ! -d node_modules ]; then
+  npm install --legacy-peer-deps
+fi
+
+run_mocha() {
+  node ./node_modules/babel-cli/bin/babel-node.js ./node_modules/mocha/bin/_mocha --require ./test/init.js "$@"
+}
+
+case "${1:-}" in
+  base)
+    run_mocha --invert --grep '(mapTree preserves shape and passes traversal context|mapTreeLeaves maps only leaves|leavesBy customizes collected leaves with context|treeToArrayBy passes traversal context|tree factory exposes map leavesBy and mapLeaves)' test/tree.spec.js
+    ;;
+  new)
+    run_mocha --grep '(mapTree preserves shape and passes traversal context|mapTreeLeaves maps only leaves|leavesBy customizes collected leaves with context|treeToArrayBy passes traversal context|tree factory exposes map leavesBy and mapLeaves)$' test/tree.spec.js
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
