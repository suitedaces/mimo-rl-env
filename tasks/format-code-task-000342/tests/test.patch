@@ -1484,3 +1484,125 @@ func TestMustParsePrintsVersion(t *testing.T) {
 	assert.Equal(t, 0, *exitCode)
 	assert.Equal(t, "example 3.2.1\n", b.String())
 }
+
+func TestParserMustParseValidArgs(t *testing.T) {
+	originalExit := osExit
+	originalStdout := stdout
+	originalStderr := stderr
+	defer func() {
+		osExit = originalExit
+		stdout = originalStdout
+		stderr = originalStderr
+	}()
+
+	var exitCode *int
+	osExit = func(code int) { exitCode = &code }
+	stdout = &bytes.Buffer{}
+	stderr = &bytes.Buffer{}
+
+	var args struct {
+		Foo string
+	}
+	p, err := NewParser(Config{Program: "myprog"}, &args)
+	require.NoError(t, err)
+
+	p.MustParse([]string{"--foo", "hello"})
+	assert.Nil(t, exitCode, "osExit should not be called for valid args")
+	assert.Equal(t, "hello", args.Foo)
+}
+
+func TestParserMustParsePrintsHelp(t *testing.T) {
+	originalExit := osExit
+	originalStdout := stdout
+	defer func() {
+		osExit = originalExit
+		stdout = originalStdout
+	}()
+
+	var exitCode *int
+	osExit = func(code int) { exitCode = &code }
+	var b bytes.Buffer
+	stdout = &b
+
+	var args struct {
+		Foo string
+	}
+	p, err := NewParser(Config{Program: "myprog"}, &args)
+	require.NoError(t, err)
+
+	p.MustParse([]string{"--help"})
+	require.NotNil(t, exitCode)
+	assert.Equal(t, 0, *exitCode)
+	assert.Contains(t, b.String(), "myprog")
+}
+
+func TestParserMustParsePrintsVersion(t *testing.T) {
+	originalExit := osExit
+	originalStdout := stdout
+	defer func() {
+		osExit = originalExit
+		stdout = originalStdout
+	}()
+
+	var exitCode *int
+	osExit = func(code int) { exitCode = &code }
+	var b bytes.Buffer
+	stdout = &b
+
+	var args versioned
+	p, err := NewParser(Config{Program: "myprog"}, &args)
+	require.NoError(t, err)
+
+	p.MustParse([]string{"--version"})
+	require.NotNil(t, exitCode)
+	assert.Equal(t, 0, *exitCode)
+	assert.Equal(t, "example 3.2.1\n", b.String())
+}
+
+func TestParserMustParseFailsOnInvalidArgs(t *testing.T) {
+	originalExit := osExit
+	originalStderr := stderr
+	defer func() {
+		osExit = originalExit
+		stderr = originalStderr
+	}()
+
+	var exitCode *int
+	osExit = func(code int) { exitCode = &code }
+	var b bytes.Buffer
+	stderr = &b
+
+	var args struct {
+		Foo string
+	}
+	p, err := NewParser(Config{Program: "myprog"}, &args)
+	require.NoError(t, err)
+
+	p.MustParse([]string{"--nonexistent-flag"})
+	require.NotNil(t, exitCode)
+	assert.Equal(t, -1, *exitCode)
+	assert.Contains(t, b.String(), "myprog")
+}
+
+func TestParserMustParseUsesCustomConfigProgram(t *testing.T) {
+	originalExit := osExit
+	originalStderr := stderr
+	defer func() {
+		osExit = originalExit
+		stderr = originalStderr
+	}()
+
+	osExit = func(code int) {}
+	var b bytes.Buffer
+	stderr = &b
+
+	var args struct {
+		Foo string
+	}
+	p, err := NewParser(Config{Program: "customname123"}, &args)
+	require.NoError(t, err)
+
+	p.MustParse([]string{"--bogus"})
+	assert.Contains(t, b.String(), "customname123",
+		"failure output should reflect custom Config.Program")
+}
