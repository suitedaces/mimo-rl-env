diff --git a/test/messageId.js b/test/messageId.js
new file mode 100644
index 0000000..d1f9d53
--- /dev/null
+++ b/test/messageId.js
@@ -0,0 +1,128 @@
+
+
+var assert = require("assert");
+
+var index = require("../index");
+
+function buildEmail(messageIdHeaderLine) {
+  var lines = [
+    "Return-Path: <betsy@example.com>",
+    "From: Betsy <betsy@example.com>",
+    "To: info@example.com",
+    "Subject: Test message"
+  ];
+  if (messageIdHeaderLine) {
+    lines.push(messageIdHeaderLine);
+  }
+  lines.push("Date: Fri, 11 Mar 2016 01:20:54 -0500");
+  lines.push("");
+  lines.push("Body of message.");
+  lines.push("");
+  return lines.join("\r\n");
+}
+
+function makeData(emailData) {
+  return {
+    config: {},
+    email: {
+      source: "betsy@example.com"
+    },
+    emailData: emailData,
+    log: function() {},
+    recipients: ["jim@example.com"],
+    originalRecipient: "info@example.com"
+  };
+}
+
+describe('Message-ID header handling', function() {
+  describe('#processMessage()', function() {
+    it('should strip a Message-ID header (uppercase ID)', function(done) {
+      var input = buildEmail(
+        "Message-ID: <UPPER-ID-123@example.com>");
+      index.processMessage(makeData(input))
+        .then(function(data) {
+          assert.equal(/^Message-ID:/mi.test(data.emailData), false,
+            "Message-ID header should be stripped from emailData");
+          assert.equal(data.emailData.indexOf("UPPER-ID-123@example.com"), -1,
+            "Message-ID value should not appear in emailData");
+          done();
+        })
+        .catch(done);
+    });
+
+    it('should strip a Message-Id header (mixed case)', function(done) {
+      var input = buildEmail(
+        "Message-Id: <Mixed-ID-456@example.com>");
+      index.processMessage(makeData(input))
+        .then(function(data) {
+          assert.equal(/^Message-Id:/mi.test(data.emailData), false,
+            "Message-Id header should be stripped from emailData");
+          assert.equal(data.emailData.indexOf("Mixed-ID-456@example.com"), -1,
+            "Message-Id value should not appear in emailData");
+          done();
+        })
+        .catch(done);
+    });
+
+    it('should strip a message-id header (all lowercase)', function(done) {
+      var input = buildEmail(
+        "message-id: <lower-id-789@example.com>");
+      index.processMessage(makeData(input))
+        .then(function(data) {
+          assert.equal(/^message-id:/mi.test(data.emailData), false,
+            "message-id header should be stripped from emailData");
+          assert.equal(data.emailData.indexOf("lower-id-789@example.com"), -1,
+            "message-id value should not appear in emailData");
+          done();
+        })
+        .catch(done);
+    });
+
+    it('should still process emails without a Message-ID header',
+      function(done) {
+        var input = buildEmail(null);
+        index.processMessage(makeData(input))
+          .then(function(data) {
+
+            assert.notEqual(data.emailData.indexOf(
+              "From: Betsy at betsy@example.com <info@example.com>"), -1,
+              "From header should be rewritten to original recipient");
+
+            assert.equal(/^Message-ID:/mi.test(data.emailData), false,
+              "No Message-ID header should be present");
+            done();
+          })
+          .catch(done);
+      });
+
+    it('should preserve a Message-ID-like string in the body',
+      function(done) {
+        var bodyMarker = "Message-ID: <body-marker-999@example.com>";
+        var lines = [
+          "From: Betsy <betsy@example.com>",
+          "To: info@example.com",
+          "Subject: Test message",
+          "Message-ID: <header-id-111@example.com>",
+          "Date: Fri, 11 Mar 2016 01:20:54 -0500",
+          "",
+          "This body line should be preserved:",
+          bodyMarker,
+          ""
+        ];
+        var input = lines.join("\r\n");
+        index.processMessage(makeData(input))
+          .then(function(data) {
+
+            assert.equal(data.emailData.indexOf(
+              "header-id-111@example.com"), -1,
+              "Message-ID header value should be stripped");
+
+            assert.notEqual(data.emailData.indexOf(
+              "body-marker-999@example.com"), -1,
+              "Message-ID-like text in body should be preserved");
+            done();
+          })
+          .catch(done);
+      });
+  });
+});
