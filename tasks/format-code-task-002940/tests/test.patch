+++ b/usercase-test-coderl/fixtures/sitecustomize.py
@@ -0,0 +1,141 @@
+import builtins
+import json
+import os
+from json import JSONDecodeError
+
+
+if os.environ.get("KRAKENEX_ACCEPTANCE_MODE"):
+    _original_open = builtins.open
+
+    def _log_path():
+        return os.environ["KRAKENEX_ACCEPTANCE_LOG"]
+
+    def _append_log(line):
+        with _original_open(_log_path(), "a", encoding="utf-8") as fd:
+            fd.write(line + "\n")
+
+    def _open(path, mode="r", *args, **kwargs):
+        try:
+            path_text = os.fspath(path)
+        except TypeError:
+            path_text = path
+        if path_text == "/path/to/export-data.key" and "r" in mode:
+            _append_log("OPEN_KEY /path/to/export-data.key")
+        return _original_open(path, mode, *args, **kwargs)
+
+    builtins.open = _open
+
+    import requests
+    import socket
+    import time
+
+    _not_ready_remaining = int(os.environ.get("KRAKENEX_ACCEPTANCE_NOT_READY", "0"))
+    _retrieve_kind = os.environ.get("KRAKENEX_ACCEPTANCE_RETRIEVE", "zip")
+    _report_id = os.environ.get("KRAKENEX_ACCEPTANCE_REPORT_ID", "RID-acceptance")
+    _zip_bytes = bytes.fromhex(os.environ.get("KRAKENEX_ACCEPTANCE_ZIP_HEX", "504b0304"))
+
+    class _FakeResponse:
+        status_code = 200
+
+        def __init__(self, method, payload):
+            self.method = method
+            self.payload = payload
+            self.content = _zip_bytes if method == "RetrieveExport" and _retrieve_kind == "zip" else b""
+
+        def raise_for_status(self):
+            return None
+
+        def json(self, **kwargs):
+            global _not_ready_remaining
+            if self.method == "AddExport":
+                return {"error": [], "result": {"id": _report_id}}
+            if self.method == "ExportStatus":
+                if _not_ready_remaining > 0:
+                    _not_ready_remaining -= 1
+                    return {"error": ["EExport:Not ready"]}
+                return {"error": [], "result": [{"id": _report_id, "status": "Processed"}]}
+            if self.method == "RetrieveExport":
+                if _retrieve_kind == "json":
+                    return {"error": [], "result": {"id": _report_id, "status": "available"}}
+                raise JSONDecodeError("Expecting value", "PK", 0)
+            return {"error": ["unexpected method"]}
+
+    def _method_from_url(url):
+        return url.rstrip("/").rsplit("/", 1)[-1]
+
+    def _log_post(method, data, headers):
+        api_key = headers.get("API-Key", "")
+        sign = headers.get("API-Sign", "")
+        common = "nonce=%s api_key=%s sign=%s" % (
+            "yes" if "nonce" in data else "no",
+            api_key,
+            "yes" if sign else "no",
+        )
+        if method == "AddExport":
+            line = (
+                "POST AddExport description=%s format=%s report=%s %s"
+                % (data.get("description"), data.get("format"), data.get("report"), common)
+            )
+        elif method == "ExportStatus":
+            line = "POST ExportStatus report=%s %s" % (data.get("report"), common)
+        elif method == "RetrieveExport":
+            line = "POST RetrieveExport id=%s %s" % (data.get("id"), common)
+        else:
+            line = "POST %s data=%s %s" % (method, json.dumps(data, sort_keys=True), common)
+        _append_log(line)
+
+    def _post(self, url, data=None, headers=None, timeout=None):
+        method = _method_from_url(url)
+        data = {} if data is None else dict(data)
+        headers = {} if headers is None else dict(headers)
+        _log_post(method, data, headers)
+        return _FakeResponse(method, data)
+
+    def _module_post(url, data=None, headers=None, timeout=None, **kwargs):
+
+        return _post(None, url, data=data, headers=headers, timeout=timeout)
+
+    def _module_request(method, url, *args, **kwargs):
+        if str(method).upper() == "POST":
+            return _module_post(url, *args, **kwargs)
+        raise RuntimeError("isolated offline guard blocked %s %s" % (method, url))
+
+    def _blocked_request(self, method, url, *args, **kwargs):
+
+        raise RuntimeError("isolated offline guard blocked %s %s" % (method, url))
+
+    def _blocked_get(self, url, *args, **kwargs):
+
+        raise RuntimeError("isolated offline guard blocked GET %s" % url)
+
+    def _sleep(seconds):
+        _append_log("SLEEP %s" % seconds)
+
+    _original_getaddrinfo = socket.getaddrinfo
+    _original_socket_connect = socket.socket.connect
+
+    def _is_local_address(host):
+        return host in ("localhost", "127.0.0.1", "::1", "0.0.0.0") or str(host).startswith("127.")
+
+    def _getaddrinfo(host, *args, **kwargs):
+
+        if not _is_local_address(host):
+            raise RuntimeError("isolated offline guard blocked DNS for %s" % host)
+        return _original_getaddrinfo(host, *args, **kwargs)
+
+    def _connect(self, address):
+
+        host = address[0] if isinstance(address, tuple) and address else address
+        if not _is_local_address(host):
+            raise RuntimeError("isolated offline guard blocked socket connect to %s" % (host,))
+        return _original_socket_connect(self, address)
+
+    requests.sessions.Session.post = _post
+    requests.sessions.Session.get = _blocked_get
+    requests.sessions.Session.request = _blocked_request
+    requests.post = _module_post
+    requests.request = _module_request
+    requests.get = lambda url, *args, **kwargs: _blocked_get(None, url, *args, **kwargs)
+    socket.getaddrinfo = _getaddrinfo
+    socket.socket.connect = _connect
+    time.sleep = _sleep
