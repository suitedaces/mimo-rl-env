diff --git a/src/action.test.js b/src/action.test.js
index 1837eaf..9c585d8 100644
--- a/src/action.test.js
+++ b/src/action.test.js
@@ -332,3 +332,85 @@ with blank lines
         expect(core.setOutput).toBeCalledWith('key', multiLineString);
     })
 });
+
+describe('parseSecretsInput optional', () => {
+    it('returns empty array for empty string', () => {
+        expect(parseSecretsInput('')).toEqual([]);
+    });
+});
+
+describe('exportSecrets optional secrets', () => {
+    beforeEach(() => {
+        jest.resetAllMocks();
+
+        when(core.getInput)
+            .calledWith('url')
+            .mockReturnValueOnce('http://vault:8200');
+
+        when(core.getInput)
+            .calledWith('token')
+            .mockReturnValueOnce('EXAMPLE');
+
+
+
+        got.extend.mockReturnValue({
+            get: async () => ({ body: JSON.stringify({ data: { data: {} } }) })
+        });
+    });
+
+    it('exports only VAULT_TOKEN when secrets is empty and exportToken=true', async () => {
+        when(core.getInput)
+            .calledWith('secrets')
+            .mockReturnValueOnce('');
+        when(core.getInput)
+            .calledWith('exportToken')
+            .mockReturnValueOnce('true');
+
+        await exportSecrets();
+
+        expect(core.exportVariable).toBeCalledTimes(1);
+        expect(core.exportVariable).toBeCalledWith('VAULT_TOKEN', 'EXAMPLE');
+        expect(core.setOutput).not.toHaveBeenCalled();
+    });
+
+    it('does not mark secrets input as required', async () => {
+        when(core.getInput)
+            .calledWith('secrets')
+            .mockReturnValueOnce('');
+        when(core.getInput)
+            .calledWith('exportToken')
+            .mockReturnValueOnce('true');
+
+        await exportSecrets();
+
+
+
+
+
+        expect(core.getInput).not.toHaveBeenCalledWith('secrets', expect.objectContaining({ required: true }));
+    });
+
+    it('does not throw when secrets is empty and exportToken is not set', async () => {
+        when(core.getInput)
+            .calledWith('secrets')
+            .mockReturnValueOnce('');
+
+        await expect(exportSecrets()).resolves.toBeUndefined();
+
+        expect(core.exportVariable).not.toHaveBeenCalled();
+        expect(core.setOutput).not.toHaveBeenCalled();
+    });
+
+    it('exports VAULT_TOKEN when secrets input is missing entirely and exportToken=true', async () => {
+
+        when(core.getInput)
+            .calledWith('exportToken')
+            .mockReturnValueOnce('true');
+
+        await exportSecrets();
+
+        expect(core.exportVariable).toBeCalledTimes(1);
+        expect(core.exportVariable).toBeCalledWith('VAULT_TOKEN', 'EXAMPLE');
+        expect(core.setOutput).not.toHaveBeenCalled();
+    });
+});
