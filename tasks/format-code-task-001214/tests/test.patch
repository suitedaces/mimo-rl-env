diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,91 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+command -v xvfb-run >/dev/null 2>&1 || fail "xvfb-run is required to initialize wxWidgets in this environment"
+
+( cd /workspace/repo && make NOGUI=1 NOASM=1 NOTEST=1 ) \
+    || fail "build"
+
+BIN=/workspace/repo/Main/truecrypt
+[ -x "$BIN" ] || fail "built binary not found at $BIN"
+
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || fail "tmpdir"
+
+run_tc() {
+    xvfb-run -a "$BIN" "$@"
+}
+
+
+EXPECTED_VERSION_FILE="$TMP/expected-version.txt"
+printf 'TrueCrypt 7.1a\n' >"$EXPECTED_VERSION_FILE"
+
+assert_exact_version_stdout() {
+    cmp -s out "$EXPECTED_VERSION_FILE" || fail "$1 stdout: $(od -An -tx1 -c out)"
+}
+
+
+
+
+run_tc --version >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_exact_version_stdout F1
+[ ! -s err ] || fail "F1 unexpected stderr: $(cat err)"
+
+
+
+
+run_tc --version --create >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_exact_version_stdout F2
+[ ! -s err ] || fail "F2 unexpected stderr: $(cat err)"
+
+
+
+
+run_tc --create --version >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+assert_exact_version_stdout F3
+[ ! -s err ] || fail "F3 unexpected stderr: $(cat err)"
+
+
+
+
+run_tc --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+[ ! -s err ] || fail "F4 unexpected stderr: $(cat err)"
+awk '
+    /^Commands:$/ { in_commands = 1; next }
+    /^MOUNTED_VOLUME:$/ { in_commands = 0 }
+    in_commands { print }
+' out >commands
+
+
+VERSION_HELP_ENTRY="$(
+    awk '
+        /--version/ { in_entry = 1 }
+        in_entry { print }
+        in_entry && /^[[:space:]]*$/ { exit }
+    ' commands
+)"
+[ -n "$VERSION_HELP_ENTRY" ] || fail "F4 missing --version in Commands"
+printf '%s\n' "$VERSION_HELP_ENTRY" | grep -q -- '--version' \
+    || fail "F4 missing --version in help entry: $VERSION_HELP_ENTRY"
+printf '%s\n' "$VERSION_HELP_ENTRY" | grep -qF 'Display program version.' \
+    || fail "F4 missing version description in help entry: $VERSION_HELP_ENTRY"
+
+
+
+
+
+run_tc --version --list >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+assert_exact_version_stdout F5
+[ ! -s err ] || fail "F5 unexpected stderr: $(cat err)"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
