diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,71 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+if [ ! -d node_modules ] || [ ! -d node_modules/capture-exit ]; then
+  npx --yes yarn@1 install --ignore-engines --non-interactive
+fi
+
+
+run_mocha() {
+  local grep_pattern="$1"
+  local invert="$2"
+
+  MOCHA_GREP="$grep_pattern" MOCHA_INVERT="$invert" node <<'NODE'
+'use strict';
+
+const captureExit = require('capture-exit');
+captureExit.captureExit();
+
+const Mocha = require('mocha');
+const RSVP = require('rsvp');
+const fs = require('fs-extra');
+
+fs.removeSync('.deps-tmp');
+
+let grepPattern = process.env.MOCHA_GREP;
+let invert = process.env.MOCHA_INVERT === '1';
+let mocha = new Mocha({
+  timeout: 5000,
+  reporter: process.env.MOCHA_REPORTER || (process.env.CI ? 'tap' : 'spec'),
+  retries: 2,
+});
+
+if (grepPattern) {
+  mocha.grep(new RegExp(grepPattern));
+}
+
+if (invert) {
+  mocha.invert();
+}
+
+mocha.addFile('tests/integration/models/blueprint-test.js');
+
+RSVP.resolve()
+  .then(() => {
+    mocha.run(failures => {
+      process.exit(failures);
+    });
+  })
+  .catch(error => {
+    console.error(error);
+    console.error(error.stack);
+    process.exit(1);
+  });
+NODE
+}
+
+case "${1:-}" in
+  base)
+    run_mocha "Blueprint removePackagesFromProject skips uninstall if no matching package exists" 1
+    ;;
+  new)
+    run_mocha "Blueprint removePackagesFromProject" 0
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
