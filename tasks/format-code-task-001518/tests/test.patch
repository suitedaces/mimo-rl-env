@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+if [ ! -x ./node_modules/.bin/jest ]; then
+  echo "Missing local Jest dependency: ./node_modules/.bin/jest" >&2
+  exit 127
+fi
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --expose-gc"
+exec ./node_modules/.bin/jest --config jest.json --runInBand \
+  --roots /workspace/repo/usercase-test-coderl \
+  --testMatch '**/*.test.ts' \
+  /workspace/repo/usercase-test-coderl/page_text_drawing.test.ts
