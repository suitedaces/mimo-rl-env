+    def test_period_sub_period_24H_gh23915(self):
+
+
+        sd = pd.Period('20180101', freq='24H')
+        bd = pd.Period('19700101', freq='24H')
+        offset = sd - bd
+
+        assert bd + offset == sd
+
+
+
+        assert offset.n == 420768
+
+    def test_period_sub_period_5H_gh23915(self):
+
+        p1 = pd.Period('20180101 00:00', freq='5H')
+        p2 = pd.Period('20180101 15:00', freq='5H')
+        offset = p2 - p1
+        assert p1 + offset == p2
+
+        assert offset.n == 15
+
+    def test_period_sub_period_2D_gh23915(self):
+
+        p1 = pd.Period('2018-01-01', freq='2D')
+        p2 = pd.Period('2018-01-05', freq='2D')
+        offset = p2 - p1
+        assert p1 + offset == p2
+
+        assert offset.n == 4
+
+    def test_period_sub_period_unit_freq_preservation(self):
+
+        p1 = pd.Period('2018-01-01 00:00', freq='H')
+        p2 = pd.Period('2018-01-01 05:00', freq='H')
+        offset = p2 - p1
+        assert offset.n == 5
+        assert p1 + offset == p2
+
+        d1 = pd.Period('2018-01-01', freq='D')
+        d2 = pd.Period('2018-01-15', freq='D')
+        offset = d2 - d1
+        assert offset.n == 14
+        assert d1 + offset == d2
+
+    def test_periodindex_sub_periodindex_24H_gh23915(self):
+
+
+        pi = pd.period_range('2018-01-01', periods=3, freq='24H')
+        pi2 = pd.period_range('1970-01-01', periods=3, freq='24H')
+        diff = pi - pi2
+
+        for off in diff:
+            assert off.n == 420768
+        result = pi2 + diff
+        tm.assert_index_equal(result, pi)
+
