diff --git a/usercase-test-coderl/test_importers.py b/usercase-test-coderl/test_importers.py
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_importers.py
@@ -0,0 +1,293 @@
+
+
+
+import json
+
+from pybossa.importers import ImportReport, Importer
+
+
+DEFAULT_IMPORTERS = ["csv", "gdocs", "epicollect", "s3", "localCSV", "iiif"]
+DEFAULT_AUTOIMPORTERS = ["csv", "gdocs", "epicollect", "localCSV", "iiif"]
+REGISTERED_IMPORTERS = [
+    "csv",
+    "gdocs",
+    "epicollect",
+    "s3",
+    "localCSV",
+    "iiif",
+    "flickr",
+    "dropbox",
+    "twitter",
+    "youtube",
+]
+REGISTERED_AUTOIMPORTERS = [
+    "csv",
+    "gdocs",
+    "epicollect",
+    "localCSV",
+    "iiif",
+    "flickr",
+    "twitter",
+    "youtube",
+]
+
+
+def assert_names_match(actual_names, expected_names):
+
+    actual_names = list(actual_names)
+    assert set(actual_names) == set(expected_names)
+    assert len(actual_names) == len(expected_names)
+
+
+class TaskRepoStub:
+    def __init__(self, existing=None):
+        self.existing = set(existing or [])
+        self.saved = []
+
+    def get_task_by(self, project_id, info):
+        key = (project_id, json.dumps(info, sort_keys=True))
+        return object() if key in self.existing else None
+
+    def save(self, task):
+        self.saved.append(task)
+
+
+def task_key(project_id, info):
+    return (project_id, json.dumps(info, sort_keys=True))
+
+
+def install_fake_flickr_importer(monkeypatch, payload, metadata):
+    init_calls = []
+
+    class FakeFlickrImporter:
+        def __init__(self, **kwargs):
+            init_calls.append(kwargs)
+
+        def count_tasks(self):
+            return len(payload)
+
+        def tasks(self):
+            return list(payload)
+
+        def import_metadata(self):
+            return metadata
+
+    monkeypatch.setattr("pybossa.importers.importer.BulkTaskFlickrImport", FakeFlickrImporter)
+    return init_calls
+
+
+def test_default_and_registered_importer_names():
+
+
+
+    importer = Importer()
+    assert_names_match(importer.get_all_importer_names(), DEFAULT_IMPORTERS)
+    assert_names_match(importer.get_autoimporter_names(), DEFAULT_AUTOIMPORTERS)
+
+    importer.register_flickr_importer({"api_key": "api-123"})
+    importer.register_dropbox_importer()
+    importer.register_twitter_importer({"consumer_key": "twitter-key"})
+    importer.register_youtube_importer({"api_key": "youtube-key"})
+
+    assert_names_match(importer.get_all_importer_names(), REGISTERED_IMPORTERS)
+    assert_names_match(importer.get_autoimporter_names(), REGISTERED_AUTOIMPORTERS)
+
+
+def test_importer_instances_keep_independent_registries():
+
+
+
+    a = Importer()
+    b = Importer()
+
+    a.register_flickr_importer({"api_key": "api-123"})
+    a.register_dropbox_importer()
+
+    assert_names_match(a.get_all_importer_names(), [
+        "csv",
+        "gdocs",
+        "epicollect",
+        "s3",
+        "localCSV",
+        "iiif",
+        "flickr",
+        "dropbox",
+    ])
+    assert_names_match(a.get_autoimporter_names(), [
+        "csv",
+        "gdocs",
+        "epicollect",
+        "localCSV",
+        "iiif",
+        "flickr",
+    ])
+    assert_names_match(b.get_all_importer_names(), DEFAULT_IMPORTERS)
+    assert_names_match(b.get_autoimporter_names(), DEFAULT_AUTOIMPORTERS)
+
+
+def test_count_tasks_to_import_merges_registered_flickr_credentials(monkeypatch):
+
+
+
+    init_calls = install_fake_flickr_importer(
+        monkeypatch,
+        [
+            {"info": {"question": "question"}},
+            {"info": {"question": "second question"}},
+        ],
+        {"source": "flickr", "page": 1},
+    )
+
+    importer = Importer()
+    importer.register_flickr_importer({"api_key": "api-123"})
+
+    count = importer.count_tasks_to_import(type="flickr", album_id="album-456")
+
+    assert init_calls == [{"api_key": "api-123", "album_id": "album-456"}]
+    assert count == 2
+
+
+def test_flickr_unavailable_before_registration():
+
+
+
+    importer = Importer()
+
+
+    assert "flickr" not in set(importer.get_all_importer_names())
+    assert "flickr" not in set(importer.get_autoimporter_names())
+
+
+def test_create_tasks_saves_one_new_task_and_returns_singular_report_with_metadata(monkeypatch):
+
+
+
+    install_fake_flickr_importer(
+        monkeypatch,
+        [
+            {
+                "info": {"question": "question"},
+                "state": "ongoing",
+                "n_answers": 5,
+                "priority_0": 0.25,
+            }
+        ],
+        {"source": "flickr", "page": 1},
+    )
+
+    importer = Importer()
+    importer.register_flickr_importer({"api_key": "api-123"})
+    repo = TaskRepoStub()
+
+    report = importer.create_tasks(repo, 17, type="flickr", album_id="album-456")
+
+    assert report.message == "1 new task was imported successfully"
+    assert report.metadata == {"source": "flickr", "page": 1}
+    assert report.total == 1
+    assert len(repo.saved) == 1
+    saved = repo.saved[0]
+    assert saved.project_id == 17
+    assert saved.info == {"question": "question"}
+    assert saved.state == "ongoing"
+    assert saved.n_answers == 5
+    assert saved.priority_0 == 0.25
+
+
+def test_create_tasks_saves_two_new_tasks_and_returns_plural_report(monkeypatch):
+
+
+
+    install_fake_flickr_importer(
+        monkeypatch,
+        [
+            {
+                "info": {"question": "question"},
+                "state": "ongoing",
+                "n_answers": 5,
+                "priority_0": 0.25,
+            },
+            {
+                "info": {"question": "second question"},
+                "state": "completed",
+                "n_answers": 2,
+                "quorum": 1,
+            },
+        ],
+        {"source": "flickr", "page": 2},
+    )
+
+    importer = Importer()
+    importer.register_flickr_importer({"api_key": "api-123"})
+    repo = TaskRepoStub()
+
+    report = importer.create_tasks(repo, 17, type="flickr", album_id="album-456")
+
+    assert report.message == "2 new tasks were imported successfully"
+    assert report.metadata == {"source": "flickr", "page": 2}
+    assert report.total == 2
+    assert len(repo.saved) == 2
+
+    saved_by_question = {task.info["question"]: task for task in repo.saved}
+    assert set(saved_by_question) == {"question", "second question"}
+    first = saved_by_question["question"]
+    assert first.project_id == 17
+    assert first.info == {"question": "question"}
+    assert first.state == "ongoing"
+    assert first.n_answers == 5
+    second = saved_by_question["second question"]
+    assert second.project_id == 17
+    assert second.info == {"question": "second question"}
+    assert second.state == "completed"
+    assert second.n_answers == 2
+    assert second.quorum == 1
+
+
+def test_create_tasks_returns_empty_report_for_duplicates_and_empty_sources(monkeypatch):
+
+
+
+    install_fake_flickr_importer(
+        monkeypatch,
+        [
+            {
+                "info": {"question": "question"},
+                "state": "ongoing",
+            }
+        ],
+        {"source": "flickr", "page": 3},
+    )
+    duplicate_repo = TaskRepoStub(existing=[task_key(17, {"question": "question"})])
+    duplicate_importer = Importer()
+    duplicate_importer.register_flickr_importer({"api_key": "api-123"})
+
+    duplicate_report = duplicate_importer.create_tasks(
+        duplicate_repo, 17, type="flickr", album_id="album-456"
+    )
+
+    assert duplicate_report.message == "It looks like there were no new records to import"
+    assert duplicate_report.metadata is None
+    assert duplicate_report.total == 0
+    assert duplicate_repo.saved == []
+
+    install_fake_flickr_importer(monkeypatch, [], {"source": "flickr", "page": 4})
+    empty_repo = TaskRepoStub()
+    empty_importer = Importer()
+    empty_importer.register_flickr_importer({"api_key": "api-123"})
+
+    empty_report = empty_importer.create_tasks(empty_repo, 17, type="flickr", album_id="album-456")
+
+    assert empty_report.message == "It looks like there were no new records to import"
+    assert empty_report.metadata is None
+    assert empty_report.total == 0
+    assert empty_repo.saved == []
+
+
+def test_import_report_exposes_message_metadata_and_total():
+
+
+
+    report = ImportReport("1 new task was imported successfully", {"source": "flickr"}, 1)
+
+    assert report.message == "1 new task was imported successfully"
+    assert report.metadata == {"source": "flickr"}
+    assert report.total == 1
