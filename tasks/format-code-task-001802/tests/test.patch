+module com.livecode.modulo.tests
+
+public handler TestModIntegerPositiveDivisor()
+	test "pos pos" when 10 mod 3 = 1
+	test "neg pos" when -10 mod 3 = 2
+	test "exact" when 9 mod 3 = 0
+	test "zero dividend" when 0 mod 5 = 0
+	test "smaller pos" when 2 mod 5 = 2
+	test "smaller neg" when -2 mod 5 = 3
+end handler
+
+public handler TestModIntegerNegativeDivisor()
+	test "pos neg" when 10 mod -3 = -2
+	test "neg neg" when -10 mod -3 = -1
+	test "smaller pos" when 2 mod -5 = -3
+	test "smaller neg" when -2 mod -5 = -2
+end handler
+
+public handler TestModIntegerEqualMagnitude()
+	test "equal" when 7 mod 7 = 0
+	test "neg equal" when -7 mod 7 = 0
+	test "opposite" when 7 mod -7 = 0
+end handler
+
+public handler TestModRealPositiveDivisor()
+	test "pos pos" when 5.5 mod 2 = 1.5
+	test "neg pos" when -5.5 mod 2 = 0.5
+end handler
+
+public handler TestModRealNegativeDivisor()
+	test "pos neg" when 5.5 mod -2 = -0.5
+	test "neg neg" when -5.5 mod -2 = -1.5
+end handler
+
+end module
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,73 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+mkdir -p .build_env/icu-compat
+: > .build_env/icu-compat/icu_compat_preinclude.h
+
+
+find /testbed -type f ! -path '*/.git/*' -exec touch -d '2001-01-01 00:00:00' {} + 2>/dev/null || true
+
+
+find /testbed/_cache /testbed/_build /testbed/libscript/src/_mlc \
+     -type f -exec touch -d '2002-01-01 00:00:00' {} + 2>/dev/null || true
+touch -d '2001-01-01 00:00:00' .build_env/icu-compat/icu_compat_preinclude.h
+
+
+{ git diff --name-only -- \
+        'libfoundation/*.cpp' 'libfoundation/*.h' 'libfoundation/*.c' \
+        'libscript/*.cpp' 'libscript/*.h' 'libscript/*.mlc' 'libscript/*.c' \
+        'engine/*.cpp' 'engine/*.h' 2>/dev/null
+  git diff --cached --name-only -- \
+        'libfoundation/*.cpp' 'libfoundation/*.h' 'libfoundation/*.c' \
+        'libscript/*.cpp' 'libscript/*.h' 'libscript/*.mlc' 'libscript/*.c' \
+        'engine/*.cpp' 'engine/*.h' 2>/dev/null
+} | sort -u | while read -r f; do
+    [ -f "$f" ] && touch "$f"
+done
+
+
+make -C libfoundation libfoundation
+make -C libscript libstdscript
+make -C toolchain lc-run
+
+
+
+
+
+
+
+
+
+
+make -C tests/lcb check
+
+
+LC_RUN=_build/linux/x86_64/debug/lc-run
+TESTRUNNER=_tests/lcb/_testrunner.lcm
+"$LC_RUN" --handler SummarizeTests "$TESTRUNNER" \
+    --summary-log /tmp/modulo-summary.log \
+    _tests/lcb/stdlib/modulo.log
