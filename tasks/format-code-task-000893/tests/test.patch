diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,199 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+REPO=/workspace/repo
+REAL_CARGO=$(command -v cargo)
+
+
+( cd "$REPO" && "$REAL_CARGO" build --locked --offline -p xtask ) \
+    || { echo "FAIL: build" >&2; exit 1; }
+BIN="$REPO/target/debug/xtask"
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+mkdir -p "$TMP/fakebin"
+cat > "$TMP/fakebin/cargo" <<'FAKECARGO'
+#!/usr/bin/env bash
+if [ "${1-}" = "fmt" ]; then
+    #
+    printf '%s\n' "$PWD" >> "${FIXTURE_FMT_ATTEMPT_LOG:?}"
+    if [ "${FIXTURE_FMT_FAIL:-0}" = "1" ]; then
+        echo "fixture cargo fmt forced failure" >&2
+        exit 42
+    fi
+    printf '%s\n' "$PWD" >> "${FIXTURE_FMT_LOG:?}"
+    exit 0
+fi
+exec "${FIXTURE_REAL_CARGO:?}" "$@"
+FAKECARGO
+chmod +x "$TMP/fakebin/cargo"
+
+export FIXTURE_REAL_CARGO="$REAL_CARGO"
+export FIXTURE_FMT_LOG="$TMP/fmt.log"
+
+export FIXTURE_FMT_ATTEMPT_LOG="$TMP/fmt-attempts.log"
+export PATH="$TMP/fakebin:$PATH"
+
+cd "$TMP"
+
+assert_nonempty() {
+
+    local label=$1 path=$2
+    [ -s "$path" ] || fail "$label missing or empty: $path"
+}
+
+assert_contains() {
+    local label=$1 path=$2 needle=$3
+    grep -Fq "$needle" "$path" || fail "$label missing: $needle"
+}
+
+assert_matches() {
+
+    local label=$1 path=$2 pattern=$3
+    grep -Eq "$pattern" "$path" || fail "$label missing pattern: $pattern"
+}
+
+assert_not_matches() {
+
+    local label=$1 path=$2 pattern=$3
+    if grep -Eq "$pattern" "$path"; then
+        fail "$label unexpectedly matches pattern: $pattern"
+    fi
+}
+
+assert_not_contains() {
+    local label=$1 path=$2 needle=$3
+    if grep -Fq "$needle" "$path"; then
+        fail "$label unexpectedly contains: $needle"
+    fi
+}
+
+
+
+
+"$BIN" generate --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+
+cat out err >combined
+assert_nonempty "F1 help output" combined
+tr '[:upper:]' '[:lower:]' <combined >combined.lower
+assert_contains "F1 help names generate" combined.lower "generate"
+assert_contains "F1 help names chips argument" combined.lower "chips"
+
+
+
+
+printf 'fixture sentinel\n' > "$REPO/esp32c3/src/__fixture_parse_sentinel.rs"
+"$BIN" generate not-a-chip >out 2>err; ec=$?
+
+[ "$ec" -ne 0 ] || fail "F2 expected non-zero exit"
+[ -f "$REPO/esp32c3/src/__fixture_parse_sentinel.rs" ] || fail "F2 generation removed sentinel"
+rm -f "$REPO/esp32c3/src/__fixture_parse_sentinel.rs"
+
+
+
+
+printf 'fixture prepatch sentinel\n' > "$REPO/esp32c3/src/__fixture_prepatch_sentinel.rs"
+mv "$REPO/esp32c3/svd/patches/esp32c3.yaml" "$TMP/esp32c3.yaml.saved"
+"$BIN" generate esp32c3 >out 2>err; ec=$?
+mv "$TMP/esp32c3.yaml.saved" "$REPO/esp32c3/svd/patches/esp32c3.yaml"
+[ "$ec" -ne 0 ] || fail "F3 expected non-zero exit"
+
+[ -f "$REPO/esp32c3/src/__fixture_prepatch_sentinel.rs" ] || fail "F3 src was replaced after patch failure"
+rm -f "$REPO/esp32c3/src/__fixture_prepatch_sentinel.rs"
+
+
+
+
+: > "$FIXTURE_FMT_LOG"
+: > "$FIXTURE_FMT_ATTEMPT_LOG"
+FIXTURE_FMT_FAIL=1 "$BIN" generate esp32s2-ulp >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F4 expected non-zero exit"
+
+assert_contains "F4 fmt attempt log" "$FIXTURE_FMT_ATTEMPT_LOG" "$REPO/esp32s2-ulp"
+[ ! -s "$FIXTURE_FMT_LOG" ] || fail "F4 fake formatter should have failed before recording success"
+
+
+
+
+: > "$FIXTURE_FMT_LOG"
+printf 'fixture stale\n' > "$REPO/esp32/src/__fixture_stale.rs"
+printf 'fixture stale\n' > "$REPO/esp32c3/src/__fixture_stale.rs"
+printf 'fixture untouched\n' > "$REPO/esp32s2/src/__fixture_unrequested.rs"
+printf '<not an svd>\n' > "$REPO/esp32/svd/esp32.svd"
+printf '<not an svd>\n' > "$REPO/esp32c3/svd/esp32c3.svd"
+"$BIN" generate esp32 esp32c3 >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0; stderr: $(cat err)"
+
+[ ! -e "$REPO/esp32/src/__fixture_stale.rs" ] || fail "F5 esp32 stale src was not replaced"
+[ ! -e "$REPO/esp32c3/src/__fixture_stale.rs" ] || fail "F5 esp32c3 stale src was not replaced"
+[ -f "$REPO/esp32s2/src/__fixture_unrequested.rs" ] || fail "F5 unrequested esp32s2 was generated"
+rm -f "$REPO/esp32s2/src/__fixture_unrequested.rs"
+[ ! -e "$REPO/esp32/lib.rs" ] || fail "F5 esp32 temporary lib.rs remained"
+[ ! -e "$REPO/esp32c3/lib.rs" ] || fail "F5 esp32c3 temporary lib.rs remained"
+assert_contains "F5 fmt log" "$FIXTURE_FMT_LOG" "$REPO/esp32"
+assert_contains "F5 fmt log" "$FIXTURE_FMT_LOG" "$REPO/esp32c3"
+
+assert_nonempty "F5 esp32 src/lib.rs" "$REPO/esp32/src/lib.rs"
+assert_nonempty "F5 esp32 device.x" "$REPO/esp32/device.x"
+assert_nonempty "F5 esp32 build.rs" "$REPO/esp32/build.rs"
+assert_nonempty "F5 esp32 svd" "$REPO/esp32/svd/esp32.svd"
+assert_nonempty "F5 esp32c3 src/lib.rs" "$REPO/esp32c3/src/lib.rs"
+assert_nonempty "F5 esp32c3 device.x" "$REPO/esp32c3/device.x"
+assert_nonempty "F5 esp32c3 build.rs" "$REPO/esp32c3/build.rs"
+assert_nonempty "F5 esp32c3 svd" "$REPO/esp32c3/svd/esp32c3.svd"
+assert_contains "F5 esp32 svd name" "$REPO/esp32/svd/esp32.svd" "<name>ESP32</name>"
+assert_contains "F5 esp32c3 svd name" "$REPO/esp32c3/svd/esp32c3.svd" "<name>ESP32-C3</name>"
+assert_contains "F5 esp32 docs logo attribute" "$REPO/esp32/src/lib.rs" 'html_logo_url'
+assert_contains "F5 esp32 doc_cfg" "$REPO/esp32/src/lib.rs" 'doc_cfg'
+assert_not_contains "F5 esp32 no doc_auto_cfg" "$REPO/esp32/src/lib.rs" 'doc_auto_cfg'
+assert_matches "F5 esp32 debug feature gate" "$REPO/esp32/src/aes.rs" 'feature[[:space:]]*=[[:space:]]*"impl-register-debug"'
+assert_matches "F5 esp32 debug impls" "$REPO/esp32/src/aes.rs" 'derive[[:space:]]*\([^)]*Debug'
+assert_matches "F5 esp32 defmt feature gate" "$REPO/esp32/src/lib.rs" 'feature[[:space:]]*=[[:space:]]*"defmt"'
+assert_matches "F5 esp32 defmt derive" "$REPO/esp32/src/lib.rs" 'defmt[[:space:]]*::[[:space:]]*Format'
+assert_contains "F5 esp32 interrupt section" "$REPO/esp32/src/lib.rs" '.rwtext.interrupt'
+assert_matches "F5 esp32 xtensa vector" "$REPO/esp32/src/lib.rs" 'pub[[:space:]]+static[[:space:]]+__INTERRUPTS[[:space:]]*:'
+assert_matches "F5 esp32 constant-case enum type" "$REPO/esp32/src/rtc_cntl/clk_conf.rs" 'pub[[:space:]]+enum[[:space:]]+[A-Z][A-Z0-9_]*'
+assert_matches "F5 esp32 constant-case enum read type" "$REPO/esp32/src/rtc_cntl/clk_conf.rs" 'pub[[:space:]]+type[[:space:]]+[A-Z][A-Z0-9_]*_R'
+assert_contains "F5 esp32 PascalCase enum value" "$REPO/esp32/src/rtc_cntl/clk_conf.rs" 'Div128'
+assert_matches "F5 esp32 constant-case interrupt value" "$REPO/esp32/src/lib.rs" 'TG0_T0_LEVEL[[:space:]]*='
+assert_not_matches "F5 esp32 no top-level peripherals" "$REPO/esp32/src/lib.rs" 'pub[[:space:]]+struct[[:space:]]+Peripherals'
+assert_matches "F5 esp32 build script" "$REPO/esp32/build.rs" 'include_bytes[[:space:]]*![[:space:]]*\([[:space:]]*"device.x"'
+assert_contains "F5 esp32c3 docs logo attribute" "$REPO/esp32c3/src/lib.rs" 'html_logo_url'
+assert_matches "F5 esp32c3 riscv vector" "$REPO/esp32c3/src/lib.rs" 'pub[[:space:]]+static[[:space:]]+__EXTERNAL_INTERRUPTS[[:space:]]*:'
+assert_not_matches "F5 esp32c3 no top-level peripherals" "$REPO/esp32c3/src/lib.rs" 'pub[[:space:]]+struct[[:space:]]+Peripherals'
+
+
+
+
+: > "$FIXTURE_FMT_LOG"
+rm -rf "$REPO/esp32s2-ulp/src"
+"$BIN" generate esp32s2-ulp >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0; stderr: $(cat err)"
+
+cat out err >combined
+assert_nonempty "F6 warning output" combined
+tr '[:upper:]' '[:lower:]' <combined >combined.lower
+assert_contains "F6 warning mentions src" combined.lower "src"
+assert_contains "F6 fmt log" "$FIXTURE_FMT_LOG" "$REPO/esp32s2-ulp"
+[ -d "$REPO/esp32s2-ulp/src" ] || fail "F6 src directory was not recreated"
+[ ! -e "$REPO/esp32s2-ulp/lib.rs" ] || fail "F6 temporary lib.rs remained"
+
+assert_nonempty "F6 esp32s2-ulp src/lib.rs" "$REPO/esp32s2-ulp/src/lib.rs"
+assert_nonempty "F6 esp32s2-ulp device.x" "$REPO/esp32s2-ulp/device.x"
+assert_nonempty "F6 esp32s2-ulp build.rs" "$REPO/esp32s2-ulp/build.rs"
+assert_nonempty "F6 esp32s2-ulp svd" "$REPO/esp32s2-ulp/svd/esp32s2-ulp.svd"
+assert_contains "F6 esp32s2-ulp svd name" "$REPO/esp32s2-ulp/svd/esp32s2-ulp.svd" "<name>ESP32-S2-ULP</name>"
+assert_contains "F6 docs logo attribute" "$REPO/esp32s2-ulp/src/lib.rs" 'html_logo_url'
+assert_contains "F6 doc_cfg" "$REPO/esp32s2-ulp/src/lib.rs" 'doc_cfg'
+assert_not_contains "F6 no doc_auto_cfg" "$REPO/esp32s2-ulp/src/lib.rs" 'doc_auto_cfg'
+assert_matches "F6 riscv vector" "$REPO/esp32s2-ulp/src/lib.rs" 'pub[[:space:]]+static[[:space:]]+__EXTERNAL_INTERRUPTS[[:space:]]*:'
+assert_matches "F6 peripherals struct" "$REPO/esp32s2-ulp/src/lib.rs" 'pub[[:space:]]+struct[[:space:]]+Peripherals'
+assert_matches "F6 peripherals take" "$REPO/esp32s2-ulp/src/lib.rs" 'pub[[:space:]]+fn[[:space:]]+take[[:space:]]*\('
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+
+export CARGO_NET_OFFLINE=true
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
