+#!/usr/bin/env bash
+set -e
+
+if [ -n "${OPT_LOG:-}" ]; then
+  printf 'jpegtran' >> "$OPT_LOG"
+  for arg in "$@"; do
+    case "$arg" in
+      "$PWD"/*) printf '\t.%s' "${arg#"$PWD"}" >> "$OPT_LOG" ;;
+      *) printf '\t%s' "$arg" >> "$OPT_LOG" ;;
+    esac
+  done
+  printf '\n' >> "$OPT_LOG"
+fi
+
+
+if [ "${JPEGTRAN_FAIL:-0}" = "1" ]; then
+  echo "jpegtran fixture failure" >&2
+  exit 37
+fi
+
+out=
+input=
+while [ "$#" -gt 0 ]; do
+  case "$1" in
+    -outfile)
+      out=$2
+      shift 2
+      ;;
+    -*)
+      shift
+      ;;
+    *)
+      input=$1
+      shift
+      ;;
+  esac
+done
+
+printf 'JPEG_OPT:%s' "$(cat "$input")" > "$out"
