+#!/usr/bin/env bash
+set -e
+
+if [ -n "${OPT_LOG:-}" ]; then
+  printf 'optipng' >> "$OPT_LOG"
+  for arg in "$@"; do
+    case "$arg" in
+      "$PWD"/*) printf '\t.%s' "${arg#"$PWD"}" >> "$OPT_LOG" ;;
+      *) printf '\t%s' "$arg" >> "$OPT_LOG" ;;
+    esac
+  done
+  printf '\n' >> "$OPT_LOG"
+fi
+
+
+if [ "${OPTIPNG_FAIL:-0}" = "1" ]; then
+  echo "optipng fixture failure" >&2
+  exit 43
+fi
+
+out=
+input=
+while [ "$#" -gt 0 ]; do
+  case "$1" in
+    -out)
+      out=$2
+      shift 2
+      ;;
+    -*)
+      shift
+      ;;
+    *)
+      input=$1
+      shift
+      ;;
+  esac
+done
+
+printf 'PNG_OPT:%s' "$(cat "$input")" > "$out"
+printf 'backup' > "$out.bak"
diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,214 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+
+( cd /workspace/repo && node - <<'NODE'
+const pkg = require('./package.json');
+const deps = Object.keys(pkg.dependencies || {});
+for (const dep of deps) {
+  require.resolve(dep, { paths: [process.cwd()] });
+}
+NODE
+) || { echo "FAIL: build" >&2; exit 1; }
+
+BIN=/workspace/repo/nodefront.js
+FIXTURES=/workspace/repo/usercase-test-coderl/fixtures
+chmod +x "$FIXTURES/jpegtran" "$FIXTURES/optipng"
+
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+assert_file() {
+  file=$1
+  expected=$2
+  [ -f "$file" ] || fail "missing file $file"
+  actual=$(cat "$file")
+  [ "$actual" = "$expected" ] || fail "$file content: $actual"
+}
+
+assert_line() {
+  line=$1
+  file=$2
+  grep -Fx -- "$line" "$file" >/dev/null || fail "missing line: $line"
+}
+
+assert_optimizer_input() {
+  optimizer=$1
+  input=$2
+  file=$3
+
+  awk -v optimizer="$optimizer" -v input="$input" '
+    function normalize(path) {
+      sub(/^\.\//, "", path)
+      return path
+    }
+    $1 == optimizer {
+      for (i = 2; i <= NF; i++) {
+        if (normalize($i) == input) {
+          found = 1
+        }
+      }
+    }
+    END { exit(found ? 0 : 1) }
+  ' "$file" || fail "missing $optimizer call for $input"
+}
+
+assert_forced_output() {
+  input=$1
+  expected=$2
+  stdout_file=$3
+  shift 3
+  for candidate in "$@"; do
+    if [ -f "$candidate" ]; then
+      assert_file "$candidate" "$expected"
+      assert_line "Optimized $input to $candidate." "$stdout_file"
+      return
+    fi
+  done
+  fail "missing optimized output for $input"
+}
+
+
+
+
+work=$TMP/help
+mkdir -p "$work"
+cd "$work"
+"$BIN" minify --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_help exit $ec; want 0"
+
+images_help=$(awk '/-i, --images/ {capture=1} capture && /^    -[a-z], --/ && $0 !~ /-i, --images/ {exit} capture {print}' out)
+[ -n "$images_help" ] || fail "F_help missing -i, --images help"
+printf '%s\n' "$images_help" | grep -Ei -- 'optimi[sz]e' >/dev/null \
+  || fail "F_help -i, --images does not describe optimization"
+printf '%s\n' "$images_help" | grep -Ei -- 'jpe?g' >/dev/null \
+  || fail "F_help -i, --images missing JPEG"
+printf '%s\n' "$images_help" | grep -Ei -- 'png' >/dev/null \
+  || fail "F_help -i, --images missing PNG"
+
+type_help=$(awk '/-t, --type/ {capture=1} capture && /^    -[a-z], --/ && $0 !~ /-t, --type/ {exit} capture {print}' out)
+[ -n "$type_help" ] || fail "F_help missing --type help"
+printf '%s\n' "$type_help" | grep -F -- "jpg" >/dev/null || fail "F_help --type missing jpg"
+printf '%s\n' "$type_help" | grep -F -- "jpeg" >/dev/null || fail "F_help --type missing jpeg"
+printf '%s\n' "$type_help" | grep -F -- "png" >/dev/null || fail "F_help --type missing png"
+
+[ -s out ] || fail "F_help missing stdout"
+
+
+
+
+work=$TMP/images-long
+mkdir -p "$work"
+cd "$work"
+printf 'JPG_A' > photo.jpg
+printf 'JPEG_B' > banner.jpeg
+printf 'PNG_C' > icon.png
+OPT_LOG=$work/optimizer.log PATH="$FIXTURES:$PATH" "$BIN" minify --images >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_images exit $ec; want 0"
+assert_line "Optimized banner.jpeg to banner.min.jpeg." out
+assert_line "Optimized icon.png to icon.min.png." out
+assert_line "Optimized photo.jpg to photo.min.jpg." out
+[ "$(grep -c '^Optimized ' out)" -eq 3 ] || fail "F_images optimized line count: $(cat out)"
+assert_file banner.min.jpeg "JPEG_OPT:JPEG_B"
+assert_file icon.min.png "PNG_OPT:PNG_C"
+assert_file photo.min.jpg "JPEG_OPT:JPG_A"
+
+[ -s out ] || fail "F_images missing stdout"
+assert_optimizer_input jpegtran banner.jpeg optimizer.log
+assert_optimizer_input optipng icon.png optimizer.log
+assert_optimizer_input jpegtran photo.jpg optimizer.log
+
+
+
+
+work=$TMP/images-short
+mkdir -p "$work"
+cd "$work"
+printf 'ALIAS_PNG' > alias.png
+OPT_LOG=$work/optimizer.log PATH="$FIXTURES:$PATH" "$BIN" minify -i >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_alias exit $ec; want 0"
+
+assert_line "Optimized alias.png to alias.min.png." out
+[ "$(grep -c '^Optimized ' out)" -eq 1 ] || fail "F_alias optimized line count: $(cat out)"
+
+[ -s out ] || fail "F_alias missing stdout"
+assert_file alias.min.png "PNG_OPT:ALIAS_PNG"
+assert_optimizer_input optipng alias.png optimizer.log
+
+
+
+
+work=$TMP/plain-jpg
+mkdir -p "$work/images"
+cd "$work"
+printf 'PLAIN_JPG' > images/photo.jpg
+OPT_LOG=$work/optimizer.log PATH="$FIXTURES:$PATH" "$BIN" minify -p images/photo.jpg -t jpg >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_plain_jpg exit $ec; want 0"
+
+[ -s out ] || fail "F_plain_jpg missing stdout"
+
+assert_forced_output images/photo.jpg "JPEG_OPT:PLAIN_JPG" out images/photo.jpg.min.jpg images/photo.min.jpg
+assert_optimizer_input jpegtran images/photo.jpg optimizer.log
+
+
+
+
+work=$TMP/plain-png
+mkdir -p "$work/images"
+cd "$work"
+printf 'PLAIN_PNG' > images/icon.png
+OPT_LOG=$work/optimizer.log PATH="$FIXTURES:$PATH" "$BIN" minify -p images/icon.png -t png >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_plain_png exit $ec; want 0"
+
+[ -s out ] || fail "F_plain_png missing stdout"
+
+assert_forced_output images/icon.png "PNG_OPT:PLAIN_PNG" out images/icon.png.min.png images/icon.min.png
+assert_optimizer_input optipng images/icon.png optimizer.log
+
+
+
+
+work=$TMP/plain-jpeg
+mkdir -p "$work"
+cd "$work"
+printf 'FORCED_JPEG' > raw-image
+OPT_LOG=$work/optimizer.log PATH="$FIXTURES:$PATH" "$BIN" minify -p raw-image -t jpeg >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F_plain_jpeg exit $ec; want 0"
+
+assert_line "Optimized raw-image to raw-image.min.jpeg." out
+[ "$(grep -c '^Optimized ' out)" -eq 1 ] || fail "F_plain_jpeg optimized line count: $(cat out)"
+
+[ -s out ] || fail "F_plain_jpeg missing stdout"
+assert_file raw-image.min.jpeg "JPEG_OPT:FORCED_JPEG"
+assert_optimizer_input jpegtran raw-image optimizer.log
+
+
+
+
+work=$TMP/jpeg-error
+mkdir -p "$work"
+cd "$work"
+printf 'BAD_JPEG' > broken.jpg
+OPT_LOG=$work/optimizer.log JPEGTRAN_FAIL=1 PATH="$FIXTURES:$PATH" "$BIN" minify -p broken.jpg -t jpg >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F_jpeg_error exit 0; want non-zero"
+! grep -F -- "Optimized broken.jpg" out >/dev/null || fail "F_jpeg_error printed success"
+
+assert_optimizer_input jpegtran broken.jpg optimizer.log
+
+
+
+
+work=$TMP/png-error
+mkdir -p "$work"
+cd "$work"
+printf 'BAD_PNG' > broken.png
+OPT_LOG=$work/optimizer.log OPTIPNG_FAIL=1 PATH="$FIXTURES:$PATH" "$BIN" minify -p broken.png -t png >out 2>err; ec=$?
+[ "$ec" -ne 0 ] || fail "F_png_error exit 0; want non-zero"
+! grep -F -- "Optimized broken.png" out >/dev/null || fail "F_png_error printed success"
+
+assert_optimizer_input optipng broken.png optimizer.log
+
+echo "PASS"
+exit 0
