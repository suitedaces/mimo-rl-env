@@ -834,6 +834,49 @@ class IndexingTest(jtu.JaxTestCase):
     self._CheckAgainstNumpy(np_fun, jnp_fun, args_maker)
     self._CompileAndCheck(jnp_fun, args_maker)
 
+  def testBooleanIndexingWithEllipsis(self):
+
+    x = jnp.ones((4, 3, 2))
+
+
+    ans = x[..., np.array([True, False])]
+    expected = np.ones((4, 3, 2))[..., np.array([True, False])]
+    self.assertEqual(ans.shape, expected.shape)
+    self.assertAllClose(ans, expected, check_dtypes=False)
+
+
+    ans = x[np.array([True, False, True, False]), ...]
+    expected = np.ones((4, 3, 2))[np.array([True, False, True, False]), ...]
+    self.assertEqual(ans.shape, expected.shape)
+    self.assertAllClose(ans, expected, check_dtypes=False)
+
+
+    ans = x[np.array([True, False, True, False]), ...,
+            np.array([True, False])]
+    expected = np.ones((4, 3, 2))[np.array([True, False, True, False]), ...,
+                                  np.array([True, False])]
+    self.assertEqual(ans.shape, expected.shape)
+    self.assertAllClose(ans, expected, check_dtypes=False)
+
+
+    mask2d = np.array([[True, False], [False, True], [True, True]])
+    ans = x[..., mask2d]
+    expected = np.ones((4, 3, 2))[..., mask2d]
+    self.assertEqual(ans.shape, expected.shape)
+    self.assertAllClose(ans, expected, check_dtypes=False)
+
+
+    ans = x[:, :, np.array([True, False])]
+    expected = np.ones((4, 3, 2))[:, :, np.array([True, False])]
+    self.assertEqual(ans.shape, expected.shape)
+    self.assertAllClose(ans, expected, check_dtypes=False)
+
+  def testBooleanIndexingMultipleEllipsisError(self):
+
+    x = jnp.ones((4, 3, 2))
+    with self.assertRaises(IndexError):
+      x[..., ..., np.array([True, False])]
+
