diff --git a/unittests/internaltests.py b/unittests/internaltests.py
index 23d08e6e2..8d874ef61 100644
--- a/unittests/internaltests.py
+++ b/unittests/internaltests.py
@@ -2100,3 +2100,87 @@ class InternalTests(unittest.TestCase):
                 self.assertEqual(actual.compile_args, expected.compile_args)
                 self.assertEqual(actual.link_args, expected.link_args)
                 self.assertEqual(actual.cmake, expected.cmake)
+
+    def test_kernel_mappings_has_gnu_entry(self) -> None:
+
+
+
+
+        self.assertIn('gnu', mesonbuild.environment.KERNEL_MAPPINGS)
+        self.assertEqual(mesonbuild.environment.KERNEL_MAPPINGS['gnu'], 'gnu')
+
+    def test_detect_kernel_gnu_returns_gnu(self) -> None:
+
+
+
+
+        result = mesonbuild.environment.detect_kernel('gnu')
+        self.assertIsNotNone(result)
+        self.assertEqual(result, 'gnu')
+
+    def test_detect_kernel_preserves_existing_systems(self) -> None:
+
+        self.assertEqual(mesonbuild.environment.detect_kernel('linux'), 'linux')
+        self.assertEqual(mesonbuild.environment.detect_kernel('freebsd'), 'freebsd')
+        self.assertEqual(mesonbuild.environment.detect_kernel('windows'), 'nt')
+        self.assertEqual(mesonbuild.environment.detect_kernel('darwin'), 'xnu')
+
+    def test_detect_kernel_unknown_system_returns_none(self) -> None:
+
+
+        self.assertIsNone(mesonbuild.environment.detect_kernel('definitely-not-a-real-os'))
+
+    def test_env2mfile_deb_hurd_kernel_is_gnu(self) -> None:
+
+
+
+
+
+
+        to_machine_info = mesonbuild.scripts.env2mfile.dpkg_architecture_to_machine_info
+
+        def locate_path(program: str) -> T.List[str]:
+            if os.path.isabs(program):
+                return [program]
+            return ['/usr/bin/' + program]
+
+        dpkg_arch_output = textwrap.dedent(
+            '''
+            DEB_HOST_ARCH=hurd-i386
+            DEB_HOST_ARCH_ABI=base
+            DEB_HOST_ARCH_BITS=32
+            DEB_HOST_ARCH_CPU=i386
+            DEB_HOST_ARCH_ENDIAN=little
+            DEB_HOST_ARCH_LIBC=gnu
+            DEB_HOST_ARCH_OS=hurd
+            DEB_HOST_GNU_CPU=i686
+            DEB_HOST_GNU_SYSTEM=gnu
+            DEB_HOST_GNU_TYPE=i686-gnu
+            DEB_HOST_MULTIARCH=i386-gnu
+            '''
+        )
+
+        with unittest.mock.patch.dict('os.environ', {'PATH': '/usr/bin'}, clear=True), \
+                unittest.mock.patch('mesonbuild.scripts.env2mfile.locate_path') as mock_locate_path:
+            mock_locate_path.side_effect = locate_path
+            options = argparse.Namespace()
+            options.gccsuffix = ''
+            actual = to_machine_info(dpkg_arch_output, options)
+
+
+        self.assertEqual(actual.kernel, 'gnu')
+
+
+
+        self.assertEqual(actual.system, 'gnu')
+        self.assertEqual(actual.subsystem, 'gnu')
+
+    def test_env2mfile_deb_kernel_map_preserves_kfreebsd(self) -> None:
+
+
+        self.assertEqual(mesonbuild.scripts.env2mfile.deb_kernel_map.get('kfreebsd'), 'freebsd')
+
+    def test_env2mfile_deb_kernel_map_has_hurd_entry(self) -> None:
+
+
+        self.assertEqual(mesonbuild.scripts.env2mfile.deb_kernel_map.get('hurd'), 'gnu')
