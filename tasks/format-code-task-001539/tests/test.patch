+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+
+
+set -euo pipefail
+cd /workspace/repo
+
+if [ ! -x /workspace/repo/node_modules/.bin/vitest ]; then
+  echo "Missing local vitest binary at /workspace/repo/node_modules/.bin/vitest" >&2
+  exit 1
+fi
+
+exec /workspace/repo/node_modules/.bin/vitest run /workspace/repo/usercase-test-coderl/cached_async_buffer.test.js
