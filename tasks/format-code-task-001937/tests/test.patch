diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,164 @@
+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+
+
+
+
+
+
+NEW_CASES=(
+  "preformatted code preserves repeated internal spaces"
+  "preformatted code with leading whitespace"
+  "preformatted code with trailing whitespace"
+  "inline code default still collapses spaces"
+  "inline code explicit false still collapses spaces"
+  "preformatted code tightly surrounded"
+  "preformatted code loosely surrounded"
+  "preformatted code with newlines"
+  "preformatted code does not flank neighboring inline whitespace"
+  "preformatted code preserves tabs"
+  "preformatted code handles longer snippets"
+  "preformatted code preserves every code span"
+  "inline code default collapses other repeated spaces"
+  "preformatted code with single leading space does not flank neighbors"
+)
+
+ensure_deps() {
+  if [ ! -d node_modules/turndown-attendant ] || [ ! -x node_modules/.bin/rollup ]; then
+    npm ci --ignore-scripts || npm install --ignore-scripts
+  fi
+}
+
+build_lib() {
+  npm run build
+}
+
+check_readme_docs() {
+  node - <<'NODE'
+const fs = require('fs')
+const text = fs.readFileSync('README.md', 'utf8')
+const lower = text.toLowerCase()
+const idx = lower.indexOf('preformattedcode')
+if (idx === -1) {
+  console.error('README.md does not mention preformattedCode')
+  process.exit(1)
+}
+const context = lower.slice(Math.max(0, idx - 800), idx + 800)
+if (!context.includes('option')) {
+  console.error('README.md mentions preformattedCode outside option documentation context')
+  process.exit(1)
+}
+if (!context.includes('false')) {
+  console.error('README.md preformattedCode documentation does not indicate default false')
+  process.exit(1)
+}
+NODE
+}
+
+check_cross_cwd_preformatted_code() {
+  node - <<'NODE'
+process.chdir('/tmp')
+const TurndownService = require('/testbed/lib/turndown.cjs')
+
+const enabled = new TurndownService({ preformattedCode: true }).turndown('<code>outside    cwd</code>')
+if (enabled !== '`outside    cwd`') {
+  console.error('preformattedCode failed outside /testbed cwd: ' + enabled)
+  process.exit(1)
+}
+
+const defaultOutput = new TurndownService().turndown('<code>outside    cwd</code>')
+if (defaultOutput !== '`outside cwd`') {
+  console.error('default inline code behavior changed outside /testbed cwd: ' + defaultOutput)
+  process.exit(1)
+}
+NODE
+}
+
+run_selected_fixture_cases() {
+  node - "$@" <<'NODE'
+const fs = require('fs')
+const os = require('os')
+const path = require('path')
+const { JSDOM } = require('jsdom')
+const Attendant = require('turndown-attendant')
+const TurndownService = require('./lib/turndown.cjs')
+
+const names = process.argv.slice(2)
+const wanted = new Set(names)
+const source = fs.readFileSync('test/index.html', 'utf8')
+const document = new JSDOM(source).window.document
+const selected = []
+
+for (const testCase of Array.from(document.querySelectorAll('.case'))) {
+  const name = testCase.getAttribute('data-name')
+  if (wanted.has(name)) selected.push(testCase.outerHTML)
+}
+
+if (selected.length !== names.length) {
+  const found = new Set(selected.map(html => new JSDOM(html).window.document.querySelector('.case').getAttribute('data-name')))
+  const missing = names.filter(name => !found.has(name))
+  console.error('Missing expected fixture cases: ' + missing.join(', '))
+  process.exit(1)
+}
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'turndown-fixture-'))
+const file = path.join(dir, 'index.html')
+fs.writeFileSync(file, '<!doctype html><html><body>' + selected.join('\n') + '</body></html>')
+
+const attendant = new Attendant({
+  file: file,
+  TurndownService: TurndownService
+})
+attendant.run()
+NODE
+}
+
+run_base_regression() {
+  local backup
+  backup="$(mktemp)"
+  cp test/index.html "$backup"
+  restore() {
+    cp "$backup" test/index.html
+    rm -f "$backup"
+  }
+  trap 'cp "$backup" test/index.html; rm -f "$backup"' EXIT
+
+  node - "${NEW_CASES[@]}" <<'NODE'
+const fs = require('fs')
+const { JSDOM } = require('jsdom')
+const names = new Set(process.argv.slice(2))
+const source = fs.readFileSync('test/index.html', 'utf8')
+const dom = new JSDOM(source)
+for (const testCase of Array.from(dom.window.document.querySelectorAll('.case'))) {
+  if (names.has(testCase.getAttribute('data-name'))) testCase.remove()
+}
+fs.writeFileSync('test/index.html', dom.serialize())
+NODE
+
+  npm run build-test
+  ./node_modules/.bin/standard ./src/**/*.js
+  node test/turndown-test.js
+  trap - EXIT
+  restore
+}
+
+case "${1:-}" in
+  base)
+    ensure_deps
+    build_lib
+    run_base_regression
+    ;;
+  new)
+    ensure_deps
+    build_lib
+    run_selected_fixture_cases "${NEW_CASES[@]}"
+    check_cross_cwd_preformatted_code
+    check_readme_docs
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
