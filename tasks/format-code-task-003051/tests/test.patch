diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,264 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C LC_ALL=C TZ=UTC
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+REPO=/workspace/repo
+FIXTURES="$REPO/usercase-test-coderl/fixtures"
+BUILD_DIR=$(mktemp -d)
+TMP=$(mktemp -d)
+trap 'rm -rf "$BUILD_DIR" "$TMP"' EXIT
+
+( cd "$REPO" && go build -o "$BUILD_DIR/kube-score" ./cmd/kube-score ) \
+    || fail "build"
+BIN="$BUILD_DIR/kube-score"
+
+COMMON_POD_IGNORE=(
+    --ignore-test container-ephemeral-storage-request-and-limit
+    --ignore-test container-image-pull-policy
+    --ignore-test container-image-tag
+    --ignore-test container-resources
+    --ignore-test container-security-context-privileged
+    --ignore-test container-security-context-readonlyrootfilesystem
+    --ignore-test container-security-context-user-group-id
+    --ignore-test pod-probes
+    --ignore-test pod-probes-identical
+    --ignore-test pod-topology-spread-constraints
+)
+DEPLOY_IGNORE=(
+    --ignore-test deployment-has-host-podantiaffinity
+    --ignore-test deployment-has-poddisruptionbudget
+    --ignore-test deployment-strategy
+    --ignore-test deployment-targeted-by-hpa-does-not-have-replicas-configured
+)
+
+assert_check() {
+    local json_file=$1 object_name=$2 check_id=$3 expected_grade=$4 expected_skipped=$5
+    local expected_path=$6 expected_summary=$7 expected_description=$8
+    python3 - "$json_file" "$object_name" "$check_id" "$expected_grade" "$expected_skipped" "$expected_path" "$expected_summary" "$expected_description" <<'PY'
+import json
+import sys
+
+json_file, object_name, check_id, expected_grade, expected_skipped, expected_path, expected_summary, expected_description = sys.argv[1:]
+with open(json_file, encoding="utf-8") as fh:
+    data = json.load(fh)
+
+obj = next((o for o in data if o.get("object_name") == object_name), None)
+if obj is None:
+    raise SystemExit(f"object not found: {object_name}")
+check = next((c for c in obj.get("checks", []) if c.get("check", {}).get("id") == check_id), None)
+if check is None:
+    raise SystemExit(f"check {check_id} not found on {object_name}")
+
+if check.get("grade") != int(expected_grade):
+    raise SystemExit(f"{object_name} {check_id} grade {check.get('grade')} != {expected_grade}")
+want_skipped = expected_skipped == "true"
+if check.get("skipped") is not want_skipped:
+    raise SystemExit(f"{object_name} {check_id} skipped {check.get('skipped')} != {want_skipped}")
+
+comments = check.get("comments")
+if expected_path == "__NO_COMMENTS__":
+
+
+    pass
+else:
+    if not comments:
+        raise SystemExit(f"{object_name} {check_id} missing comments")
+    comment = comments[0]
+
+
+    if expected_path != "__ANY_PATH__" and comment.get("path", "") != expected_path:
+        raise SystemExit(f"{object_name} {check_id} path {comment.get('path', '')!r} != {expected_path!r}")
+    if expected_summary and comment.get("summary", "") != expected_summary:
+        raise SystemExit(f"{object_name} {check_id} summary {comment.get('summary', '')!r} != {expected_summary!r}")
+    if expected_description != "__ANY_DESCRIPTION__" and comment.get("description", "") != expected_description:
+        raise SystemExit(f"{object_name} {check_id} description {comment.get('description', '')!r} != {expected_description!r}")
+PY
+}
+
+assert_ingress_missing_comments() {
+    local json_file=$1 object_name=$2 check_id=$3 expected_grade=$4 expected_json=$5
+    python3 - "$json_file" "$object_name" "$check_id" "$expected_grade" "$expected_json" <<'PY'
+import json
+import sys
+
+json_file, object_name, check_id, expected_grade, expected_json = sys.argv[1:]
+with open(json_file, encoding="utf-8") as fh:
+    data = json.load(fh)
+expected = json.loads(expected_json)
+obj = next((o for o in data if o.get("object_name") == object_name), None)
+if obj is None:
+    raise SystemExit(f"object not found: {object_name}")
+check = next((c for c in obj.get("checks", []) if c.get("check", {}).get("id") == check_id), None)
+if check is None:
+    raise SystemExit(f"check {check_id} not found on {object_name}")
+if check.get("grade") != int(expected_grade):
+    raise SystemExit(f"{object_name} {check_id} grade {check.get('grade')} != {expected_grade}")
+if check.get("skipped") is not False:
+    raise SystemExit(f"{object_name} {check_id} should not be skipped")
+comments = check.get("comments") or []
+
+
+if len(comments) < len(expected):
+    raise SystemExit(f"{object_name} {check_id} comments {comments!r} shorter than expected {expected!r}")
+remaining = list(comments)
+for want in expected:
+    for idx, comment in enumerate(remaining):
+        if comment.get("summary", "") != want.get("summary", ""):
+            continue
+        want_desc = want.get("description", "__ANY_DESCRIPTION__")
+        if want_desc != "__ANY_DESCRIPTION__" and comment.get("description", "") != want_desc:
+            continue
+        del remaining[idx]
+        break
+    else:
+        raise SystemExit(f"{object_name} {check_id} missing comment matching {want!r}; got {comments!r}")
+PY
+}
+
+assert_suppressed_check() {
+    local json_file=$1 object_name=$2 check_id=$3
+    python3 - "$json_file" "$object_name" "$check_id" <<'PY'
+import json
+import sys
+
+json_file, object_name, check_id = sys.argv[1:]
+with open(json_file, encoding="utf-8") as fh:
+    data = json.load(fh)
+obj = next((o for o in data if o.get("object_name") == object_name), None)
+if obj is None:
+    raise SystemExit(f"object not found: {object_name}")
+check = next((c for c in obj.get("checks", []) if c.get("check", {}).get("id") == check_id), None)
+if check is None:
+    raise SystemExit(0)
+
+
+if check.get("skipped") is not True:
+    raise SystemExit(f"check {check_id} present but not skipped on {object_name}")
+PY
+}
+
+allow_stderr() {
+    local label=$1 file=$2
+
+
+    :
+}
+
+assert_list_row() {
+    local check_id=$1 kind=$2
+
+
+    awk -F, -v id="$check_id" -v kind="$kind" '$1 == id && $2 == kind && $NF == "default" { found = 1 } END { exit(found ? 0 : 1) }' "$TMP/list.out" \
+        || fail "missing default list row for $check_id,$kind"
+}
+
+
+
+
+"$BIN" list >"$TMP/list.out" 2>"$TMP/list.err"; ec=$?
+[ "$ec" -eq 0 ] || fail "F0 exit $ec; want 0"
+allow_stderr F0 "$TMP/list.err"
+assert_list_row "ingress-targets-service" "Ingress"
+assert_list_row "pod-networkpolicy" "Pod"
+assert_list_row "networkpolicy-targets-pod" "NetworkPolicy"
+assert_list_row "service-targets-pod" "Service"
+assert_list_row "service-type" "Service"
+
+
+
+
+"$BIN" score --output-format json "${COMMON_POD_IGNORE[@]}" "${DEPLOY_IGNORE[@]}" "$FIXTURES/deployment_service_full.yaml" >"$TMP/f1.out" 2>"$TMP/f1.err"; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+allow_stderr F1 "$TMP/f1.err"
+assert_check "$TMP/f1.out" "Service/v1/app-ns/web-svc" "service-targets-pod" 10 false "__NO_COMMENTS__" "" ""
+assert_check "$TMP/f1.out" "Service/v1/app-ns/web-svc" "service-type" 10 false "__NO_COMMENTS__" "" ""
+assert_check "$TMP/f1.out" "Deployment/apps/v1/app-ns/web-deploy" "pod-networkpolicy" 10 false "__NO_COMMENTS__" "" ""
+assert_check "$TMP/f1.out" "NetworkPolicy/networking.k8s.io/v1/app-ns/all-pods-default-both" "networkpolicy-targets-pod" 10 false "__NO_COMMENTS__" "" ""
+
+
+
+
+"$BIN" score --output-format json "${COMMON_POD_IGNORE[@]}" --ignore-test pod-networkpolicy "$FIXTURES/service_no_match.yaml" >"$TMP/f2.out" 2>"$TMP/f2.err"; ec=$?
+[ "$ec" -eq 1 ] || fail "F2 exit $ec; want 1"
+allow_stderr F2 "$TMP/f2.err"
+assert_check "$TMP/f2.out" "Service/v1/left/orphan-svc" "service-targets-pod" 1 false "__ANY_PATH__" "The services selector does not match any pods" "__ANY_DESCRIPTION__"
+assert_check "$TMP/f2.out" "Service/v1/left/orphan-svc" "service-type" 10 false "__NO_COMMENTS__" "" ""
+
+
+
+
+"$BIN" score --output-format json "$FIXTURES/externalname.yaml" >"$TMP/f3.out" 2>"$TMP/f3.err"; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+allow_stderr F3 "$TMP/f3.err"
+assert_check "$TMP/f3.out" "Service/v1/ext/external-api" "service-targets-pod" 10 false "__NO_COMMENTS__" "" ""
+assert_check "$TMP/f3.out" "Service/v1/ext/external-api" "service-type" 10 false "__NO_COMMENTS__" "" ""
+
+
+
+
+"$BIN" score --output-format json "${COMMON_POD_IGNORE[@]}" "$FIXTURES/nodeport.yaml" >"$TMP/f4.out" 2>"$TMP/f4.err"; ec=$?
+[ "$ec" -eq 0 ] || fail "F4 default exit $ec; want 0"
+allow_stderr F4 "$TMP/f4.err"
+assert_check "$TMP/f4.out" "Service/v1/np/nodeport-svc" "service-targets-pod" 10 false "__NO_COMMENTS__" "" ""
+assert_check "$TMP/f4.out" "Service/v1/np/nodeport-svc" "service-type" 5 false "__ANY_PATH__" "The service is of type NodePort" "__ANY_DESCRIPTION__"
+"$BIN" score --exit-one-on-warning --output-format json "${COMMON_POD_IGNORE[@]}" "$FIXTURES/nodeport.yaml" >"$TMP/f4w.out" 2>"$TMP/f4w.err"; ec=$?
+[ "$ec" -eq 1 ] || fail "F4 warning exit $ec; want 1"
+allow_stderr F4-warning "$TMP/f4w.err"
+
+
+
+
+"$BIN" score --output-format json "${COMMON_POD_IGNORE[@]}" "$FIXTURES/pod_np_only_ingress.yaml" >"$TMP/f5.out" 2>"$TMP/f5.err"; ec=$?
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+allow_stderr F5 "$TMP/f5.err"
+assert_check "$TMP/f5.out" "Pod/v1/pol/ingress-only-pod" "pod-networkpolicy" 5 false "__ANY_PATH__" "The pod does not have a matching egress NetworkPolicy" "__ANY_DESCRIPTION__"
+assert_check "$TMP/f5.out" "NetworkPolicy/networking.k8s.io/v1/pol/ingress-only" "networkpolicy-targets-pod" 10 false "__NO_COMMENTS__" "" ""
+
+
+
+
+"$BIN" score --output-format json "${COMMON_POD_IGNORE[@]}" "$FIXTURES/pod_np_only_egress.yaml" >"$TMP/f6.out" 2>"$TMP/f6.err"; ec=$?
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+allow_stderr F6 "$TMP/f6.err"
+assert_check "$TMP/f6.out" "Pod/v1/pol/egress-only-pod" "pod-networkpolicy" 5 false "__ANY_PATH__" "The pod does not have a matching ingress NetworkPolicy" "__ANY_DESCRIPTION__"
+assert_check "$TMP/f6.out" "NetworkPolicy/networking.k8s.io/v1/pol/egress-only" "networkpolicy-targets-pod" 10 false "__NO_COMMENTS__" "" ""
+
+
+
+
+"$BIN" score --output-format json "${COMMON_POD_IGNORE[@]}" "$FIXTURES/pod_np_none_and_np_miss.yaml" >"$TMP/f7.out" 2>"$TMP/f7.err"; ec=$?
+[ "$ec" -eq 1 ] || fail "F7 exit $ec; want 1"
+allow_stderr F7 "$TMP/f7.err"
+assert_check "$TMP/f7.out" "Pod/v1/pol/uncovered-pod" "pod-networkpolicy" 1 false "__ANY_PATH__" "The pod does not have a matching NetworkPolicy" "__ANY_DESCRIPTION__"
+assert_check "$TMP/f7.out" "NetworkPolicy/networking.k8s.io/v1/pol/selects-no-pods" "networkpolicy-targets-pod" 1 false "__ANY_PATH__" "The NetworkPolicys selector doesn't match any pods" "__ANY_DESCRIPTION__"
+
+
+
+
+"$BIN" score --output-format json --ignore-test service-targets-pod "$FIXTURES/ingress_ok.yaml" >"$TMP/f8.out" 2>"$TMP/f8.err"; ec=$?
+[ "$ec" -eq 0 ] || fail "F8 exit $ec; want 0"
+allow_stderr F8 "$TMP/f8.err"
+assert_check "$TMP/f8.out" "Ingress/networking.k8s.io/v1/ing/web-ing" "ingress-targets-service" 10 false "__NO_COMMENTS__" "" ""
+
+
+
+
+"$BIN" score --output-format json --ignore-test service-targets-pod "$FIXTURES/ingress_bad.yaml" >"$TMP/f9.out" 2>"$TMP/f9.err"; ec=$?
+[ "$ec" -eq 1 ] || fail "F9 exit $ec; want 1"
+allow_stderr F9 "$TMP/f9.err"
+assert_ingress_missing_comments "$TMP/f9.out" "Ingress/networking.k8s.io/v1/ing/bad-ing" "ingress-targets-service" 1 '[{"summary":"No service match was found","description":"No service with name missing-svc and port number 999 was found"},{"summary":"No service match was found","description":"No service with name web and port named grpc was found"},{"summary":"No service match was found","description":"__ANY_DESCRIPTION__"}]'
+
+
+
+
+"$BIN" score --output-format json "${COMMON_POD_IGNORE[@]}" --ignore-test pod-networkpolicy --ignore-test service-targets-pod "$FIXTURES/service_no_match.yaml" >"$TMP/f10.out" 2>"$TMP/f10.err"; ec=$?
+[ "$ec" -eq 0 ] || fail "F10 exit $ec; want 0"
+allow_stderr F10 "$TMP/f10.err"
+assert_suppressed_check "$TMP/f10.out" "Service/v1/left/orphan-svc" "service-targets-pod"
+assert_check "$TMP/f10.out" "Service/v1/left/orphan-svc" "service-type" 10 false "__NO_COMMENTS__" "" ""
+
+echo "PASS"
+exit 0
