index 00000000000..0e1c2fed46a
--- /dev/null
+++ b/tests/components/test_config_entry_forwarding.py
@@ -0,0 +1,48 @@
+
+import importlib.machinery
+import sys
+import types
+
+import pytest
+
+from homeassistant import config_entries
+from homeassistant.setup import async_setup_component
+
+
+pytestmark = pytest.mark.parametrize("entity_domain", ["binary_sensor", "sensor", "scene"])
+
+
+async def test_base_entity_component_forwards_config_entries(
+        hass, monkeypatch, entity_domain):
+
+    calls = []
+    integration_domain = "forwarding_probe_{}".format(entity_domain)
+    platform_name = "homeassistant.components.{}.{}".format(
+        entity_domain, integration_domain)
+
+    platform = types.ModuleType(platform_name)
+    platform.__spec__ = importlib.machinery.ModuleSpec(
+        platform_name, None, origin="fixture-test")
+
+    async def async_setup_entry(hass_arg, entry_arg, async_add_entities):
+
+        calls.append((hass_arg, entry_arg, async_add_entities))
+        return True
+
+    platform.async_setup_entry = async_setup_entry
+
+    monkeypatch.setitem(sys.modules, platform_name, platform)
+
+    assert await async_setup_component(hass, entity_domain, {}) is True
+
+    entry = config_entries.ConfigEntry(
+        1, integration_domain, "Forwarding probe", {}, "test")
+    hass.config_entries._entries.append(entry)
+
+    result = await hass.config_entries.async_forward_entry_setup(
+        entry, entity_domain)
+
+    assert result is not False
+    assert len(calls) == 1
+    assert calls[0][0] is hass
+    assert calls[0][1] is entry
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
