+
+from unittest.mock import Mock, patch
+
+from homeassistant import config_entries
+from homeassistant.components import deconz
+from homeassistant.components.binary_sensor import deconz as deconz_binary_sensor
+
+from tests.common import mock_coro_func
+
+
+SENSORS = {
+    "1": {
+        "id": "sensor-1-id",
+        "name": "Sensor 1 name",
+        "type": "ZHAPresence",
+        "state": {"presence": False},
+        "config": {}
+    },
+    "2": {
+        "id": "sensor-2-id",
+        "name": "Sensor 2 name",
+        "type": "ZHAOpenClose",
+        "state": {"open": True},
+        "config": {}
+    }
+}
+
+
+async def setup_bridge(hass, data):
+
+    from pydeconz import DeconzSession
+
+    entry = Mock()
+    entry.data = {'host': '1.2.3.4', 'port': 80, 'api_key': '1234567890ABCDEF'}
+    bridge = DeconzSession(Mock(), Mock(), **entry.data)
+    with patch('pydeconz.DeconzSession.async_get_state',
+               new=mock_coro_func(data)):
+        await bridge.async_load_parameters()
+
+    hass.data[deconz.DOMAIN] = bridge
+    hass.data[deconz.DATA_DECONZ_ID] = {}
+
+    config_entry = config_entries.ConfigEntry(
+        1, deconz.DOMAIN, 'Mock Title', {'host': 'mock-host'}, 'test')
+    hass.config_entries._entries.append(config_entry)
+    await hass.config_entries.async_forward_entry_setup(
+        config_entry, 'binary_sensor')
+    await hass.async_block_till_done()
+
+
+async def test_no_binary_sensors(hass):
+
+    await setup_bridge(hass, {})
+
+    assert hass.states.async_all() == []
+
+
+async def test_binary_sensors_added_from_config_entry(hass):
+
+    await setup_bridge(hass, {"sensors": SENSORS})
+
+    assert hass.states.get("binary_sensor.sensor_1_name") is not None
+    assert hass.states.get("binary_sensor.sensor_2_name") is not None
+    assert len(hass.states.async_all()) == 2
+
+
+async def test_legacy_setup_platform_does_not_add_binary_sensors(hass):
+
+    added = []
+
+    async def async_add_devices(devices):
+        added.extend(devices)
+
+    await deconz_binary_sensor.async_setup_platform(
+        hass, {}, async_add_devices, discovery_info={"host": "mock-host"})
+
+    assert added == []
