--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,53 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+set +u
+if [ ! -x /testbed/.venv/bin/python ]; then
+  python3 -m venv /testbed/.venv
+fi
+source /testbed/.venv/bin/activate
+set -u
+
+if [ ! -f /testbed/.venv/.stage3_deconz_deps ]; then
+  python -m pip install --upgrade 'pip<24' wheel 'setuptools==57.5.0'
+  python -m pip install \
+    -e . \
+    'Jinja2==2.11.3' \
+    'MarkupSafe==2.0.1' \
+    'PyDispatcher==2.0.5' \
+    'pydeconz==36' \
+    'pytest==3.4.2' \
+    'pytest-aiohttp==0.3.0' \
+    'pytest-timeout==1.2.1' \
+    'requests_mock==1.4' \
+    'pytest-cov==2.5.1' \
+    'pytest-sugar==0.9.1' \
+    'asynctest>=0.11.1' \
+    'mock-open==1.3.1'
+  touch /testbed/.venv/.stage3_deconz_deps
+fi
+
+case "${1:-}" in
+  base)
+    python -m pytest tests/components/deconz/test_init.py -v -k \
+      "test_config_with_host_passed_to_config_entry or test_config_import_from_config_file or test_config_discovery"
+    ;;
+  new)
+    python -m pytest \
+      tests/components/test_config_entry_forwarding.py \
+      tests/components/binary_sensor/test_deconz.py \
+      tests/components/deconz/test_init.py::test_setup_entry_already_registered_bridge \
+      tests/components/deconz/test_init.py::test_setup_entry_no_available_bridge \
+      tests/components/deconz/test_init.py::test_setup_entry_successful_forwards_supported_platforms \
+      tests/components/deconz/test_init.py::test_setup_entry_can_create_forwarded_entities \
+      tests/components/light/test_deconz.py \
+      tests/components/scene/test_deconz.py \
+      tests/components/sensor/test_deconz.py \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
