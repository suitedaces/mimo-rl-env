 def test_no_iteration_allowed():
     metric = DummyMetric()
-    with pytest.raises(NotImplementedError, match="Metrics does not support iteration."):  # noqa: PT012
+    with pytest.raises(TypeError):  # noqa: PT012
         for m in metric:
             continue
 
 
+def test_iter_does_not_raise_not_implemented_error():
+    """Calling iter() on a metric must not raise NotImplementedError (PyCharm flags this as abstract)."""
+    metric = DummyMetric()
+
+    with pytest.raises(TypeError):
+        iter(metric)
+
+    raised = None
+    try:
+        iter(metric)
+    except BaseException as e:  # noqa: BLE001
+        raised = e
+    assert raised is not None
+    assert not isinstance(raised, NotImplementedError)
+
+
+def test_metric_is_not_iterable_via_isinstance():
+    """A Metric instance must not be considered Iterable by Python's protocol."""
+    from collections.abc import Iterable
+
+    metric = DummyMetric()
+    assert not isinstance(metric, Iterable)
+
