+func TestDAGContainerSetTerminationDoesNotHang(t *testing.T) {
+	wf := wfv1.MustUnmarshalWorkflow(`
+apiVersion: argoproj.io/v1alpha1
+kind: Workflow
+metadata:
+  name: container-set-termination-demo
+  namespace: argo
+spec:
+  entrypoint: main
+  templates:
+    - name: main
+      dag:
+        tasks:
+          - name: using-container-set-template
+            template: problematic-container-set
+    - name: problematic-container-set
+      containerSet:
+        containers:
+          - name: step-1
+            image: alpine
+            command: [sh, -c, "sleep 10"]
+          - name: step-2
+            image: alpine
+            command: [sh, -c, "sleep 10"]
+`)
+
+	cancel, controller := newController(wf)
+	defer cancel()
+
+	ctx := context.Background()
+	woc := newWorkflowOperationCtx(wf, controller)
+	woc.operate(ctx)
+
+
+
+	containerNodes := map[string]wfv1.NodePhase{}
+	for _, n := range woc.wf.Status.Nodes {
+		if n.Type == wfv1.NodeTypeContainer {
+			containerNodes[n.DisplayName] = n.Phase
+		}
+	}
+	assert.Equal(t, wfv1.NodePending, containerNodes["step-1"],
+		"step-1 container child should start in Pending")
+	assert.Equal(t, wfv1.NodePending, containerNodes["step-2"],
+		"step-2 container child should start in Pending")
+
+
+	makePodsPhase(ctx, woc, apiv1.PodPending)
+	wfOut := woc.wf
+	wfOut.Spec.Shutdown = wfv1.ShutdownStrategyTerminate
+
+	woc1 := newWorkflowOperationCtx(wfOut, controller)
+	woc1.operate(ctx)
+
+
+
+
+	containerCount := 0
+	for _, n := range woc1.wf.Status.Nodes {
+		if n.Type == wfv1.NodeTypeContainer {
+			containerCount++
+			assert.Equal(t, wfv1.NodeFailed, n.Phase,
+				"container child %s must be Failed after Terminate, was %s",
+				n.DisplayName, n.Phase)
+		}
+	}
+	assert.Equal(t, 2, containerCount, "expected to find both container child nodes")
+	assert.NotEqual(t, wfv1.WorkflowRunning, woc1.wf.Status.Phase,
+		"workflow must not remain Running after Terminate — that is the hang the fix addresses")
+}
