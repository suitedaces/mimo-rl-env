+func TestDirectContainerSetTerminationStillWorks(t *testing.T) {
+	wf := wfv1.MustUnmarshalWorkflow(`
+apiVersion: argoproj.io/v1alpha1
+kind: Workflow
+metadata:
+  name: direct-container-set-termination
+  namespace: argo
+spec:
+  entrypoint: problematic-container-set
+  templates:
+    - name: problematic-container-set
+      containerSet:
+        containers:
+          - name: step-1
+            image: alpine
+            command: [sh, -c, "sleep 10"]
+`)
+
+	cancel, controller := newController(wf)
+	defer cancel()
+
+	ctx := context.Background()
+	woc := newWorkflowOperationCtx(wf, controller)
+	woc.operate(ctx)
+
+	makePodsPhase(ctx, woc, apiv1.PodPending)
+	wfOut := woc.wf
+	wfOut.Spec.Shutdown = wfv1.ShutdownStrategyTerminate
+
+	woc1 := newWorkflowOperationCtx(wfOut, controller)
+	woc1.operate(ctx)
+
+	assert.NotEqual(t, wfv1.WorkflowRunning, woc1.wf.Status.Phase,
+		"direct-containerset workflow must not remain Running after Terminate")
+	for _, n := range woc1.wf.Status.Nodes {
+		if n.Type == wfv1.NodeTypeContainer {
+			assert.Equal(t, wfv1.NodeFailed, n.Phase,
+				"container child %s must be Failed after Terminate, was %s",
+				n.DisplayName, n.Phase)
+		}
+	}
+}
