+import { describe, expect, it, vi } from 'vitest';
+import { get } from 'svelte/store';
+import { createPagination } from '../pagination';
+
+function pageItems(api: ReturnType<typeof createPagination>) {
+	return get(api.items).filter((item) => item.type === 'page');
+}
+
+describe('pagination state contract', () => {
+	it('clamps the initial page and never emits onChange during construction', () => {
+		const onChange = vi.fn();
+		const api = createPagination({ total: 25, perPage: 10, page: 99, onChange });
+
+		expect(get(api.page)).toBe(3);
+		expect(pageItems(api).map((item) => item.page)).toEqual([1, 2, 3]);
+		expect(get(api.start)).toBe(21);
+		expect(get(api.end)).toBe(25);
+		expect(onChange).not.toHaveBeenCalled();
+	});
+
+	it('clamps explicit page assignments and only reports effective changes', () => {
+		const onChange = vi.fn();
+		const api = createPagination({ total: 25, perPage: 10, page: 2, onChange });
+
+		api.page.set(0);
+		expect(get(api.page)).toBe(1);
+		expect(onChange).toHaveBeenLastCalledWith(1);
+
+		api.page.set(100);
+		expect(get(api.page)).toBe(3);
+		expect(onChange).toHaveBeenLastCalledWith(3);
+
+		api.page.set(3);
+		expect(onChange).toHaveBeenCalledTimes(2);
+	});
+
+	it('normalizes invalid total and per-page values and keeps an empty result well-defined', () => {
+		const api = createPagination({ total: -4, perPage: 0, page: 7 });
+
+		expect(get(api.total)).toBe(0);
+		expect(get(api.perPage)).toBe(1);
+		expect(get(api.page)).toBe(1);
+		expect(get(api.items).filter((item) => item.type === 'page')).toEqual([]);
+		expect(get(api.start)).toBe(0);
+		expect(get(api.end)).toBe(0);
+
+		api.total.set(-10);
+		api.perPage.set(-2);
+		expect(get(api.total)).toBe(0);
+		expect(get(api.perPage)).toBe(1);
+	});
+
+	it('re-clamps the page when total shrinks and emits one correction', () => {
+		const onChange = vi.fn();
+		const api = createPagination({ total: 100, perPage: 10, page: 8, onChange });
+
+		api.total.set(25);
+		expect(get(api.page)).toBe(3);
+		expect(onChange).toHaveBeenCalledTimes(1);
+		expect(onChange).toHaveBeenLastCalledWith(3);
+		expect(pageItems(api).map((item) => item.page)).toEqual([1, 2, 3]);
+
+		api.total.set(24);
+		expect(get(api.page)).toBe(3);
+		expect(onChange).toHaveBeenCalledTimes(1);
+	});
+
+	it('recomputes the page range when perPage changes and preserves a valid page', () => {
+		const onChange = vi.fn();
+		const api = createPagination({ total: 100, perPage: 10, page: 5, onChange });
+
+		api.perPage.set(25);
+		expect(get(api.perPage)).toBe(25);
+		expect(get(api.page)).toBe(4);
+		expect(onChange).toHaveBeenCalledTimes(1);
+		expect(get(api.start)).toBe(76);
+		expect(get(api.end)).toBe(100);
+
+		api.perPage.set(20);
+		expect(get(api.page)).toBe(4);
+		expect(onChange).toHaveBeenCalledTimes(1);
+		expect(pageItems(api).map((item) => item.page)).toEqual([1, 2, 3, 4, 5]);
+	});
+
+	it('keeps navigation controls and selected pages within the current range', () => {
+		const api = createPagination({ total: 35, perPage: 10, page: 1, hideFirstButton: false, hideLastButton: false });
+		const items = get(api.items);
+
+		expect(items.filter((item) => item.type === 'page').every((item) => (item.page ?? 0) >= 1 && (item.page ?? 0) <= 4)).toBe(true);
+		expect(items.filter((item) => item.type === 'page').map((item) => item.page)).toEqual([1, 2, 3, 4]);
+		expect(items.filter((item) => item.selected).map((item) => item.page)).toEqual([1]);
+		expect(items.find((item) => item.type === 'first')).toMatchObject({ page: 1, disabled: true });
+		expect(items.find((item) => item.type === 'previous')).toMatchObject({ page: 0, disabled: true });
+		expect(items.find((item) => item.type === 'next')).toMatchObject({ page: 2, disabled: false });
+		expect(items.find((item) => item.type === 'last')).toMatchObject({ page: 4, disabled: false });
+
+		api.page.set(4);
+		const endItems = get(api.items);
+		expect(endItems.filter((item) => item.selected).map((item) => item.page)).toEqual([4]);
+		expect(endItems.find((item) => item.type === 'next')).toMatchObject({ page: 5, disabled: true });
+		expect(endItems.find((item) => item.type === 'last')).toMatchObject({ page: 4, disabled: true });
+	});
+
+	it('keeps ellipses as disabled gap markers without duplicating page numbers', () => {
+		const api = createPagination({ total: 200, perPage: 10, page: 10, boundaryCount: 2, siblingCount: 1 });
+		const items = get(api.items);
+		const pages = items.filter((item) => item.type === 'page').map((item) => item.page as number);
+
+		expect(new Set(pages).size).toBe(pages.length);
+		expect(pages).toEqual([1, 2, 9, 10, 11, 19, 20]);
+		expect(items.filter((item) => item.type.startsWith('ellipsis-')).every((item) => item.disabled && item.page === null)).toBe(true);
+	});
+});
