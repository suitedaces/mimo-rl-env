+import os
+
 import mock
 import pytest
 
 from piptools._compat import PackageFinder
 from piptools._compat.pip_compat import PIP_VERSION, Link, Session, path_to_url
+from piptools.repositories import PyPIRepository
 from piptools.repositories.pypi import open_local_or_remote_file
 
 
@@ -176,3 +179,96 @@ def test_wheel_cache_cleanup_called(
     ireq = from_line("six==1.10.0")
     pypi_repository.get_dependencies(ireq)
     WheelCache.return_value.cleanup.assert_called_once_with()
+
+
+def test_relative_cache_dir_arg_is_normalized_to_absolute(tmpdir_cwd):
+    """
+    Test that a relative `cache_dir` argument to PyPIRepository is normalized
+    to an absolute path so it can be safely used with newer pip versions
+    (regression test for pip>=20.0 cache_dir AssertionError).
+    """
+    relative_cache_dir = "relative-cache-dir-arg"
+    pypi_repository = PyPIRepository(
+        ["--index-url", PyPIRepository.DEFAULT_INDEX_URL],
+        cache_dir=relative_cache_dir,
+    )
+    assert os.path.isabs(pypi_repository._cache_dir)
+
+
+def test_relative_cache_dir_in_pip_args_is_normalized(tmpdir_cwd):
+    """
+    A relative path supplied via `--cache-dir` in pip_args must be normalized
+    to an absolute path, otherwise pip>=20.0's `_build_session` will fail with
+    an AssertionError on `os.path.isabs(options.cache_dir)`.
+    """
+    relative_pip_cache = "relative-pip-cache"
+    pypi_repository = PyPIRepository(
+        [
+            "--index-url",
+            PyPIRepository.DEFAULT_INDEX_URL,
+            "--cache-dir",
+            relative_pip_cache,
+        ],
+        cache_dir=str(tmpdir_cwd / "abs-cache-dir"),
+    )
+    assert os.path.isabs(pypi_repository.options.cache_dir)
+
+
+def test_relative_cache_dir_in_pip_args_does_not_raise(tmpdir_cwd):
+    """
+    Constructing a PyPIRepository with a relative `--cache-dir` in pip_args
+    must not raise the AssertionError introduced in pip 20.0.2.
+    """
+    PyPIRepository(
+        [
+            "--index-url",
+            PyPIRepository.DEFAULT_INDEX_URL,
+            "--cache-dir",
+            "another-relative-pip-cache",
+        ],
+        cache_dir=str(tmpdir_cwd / "abs-cache"),
+    )
+
+
+def test_absolute_cache_dir_arg_remains_absolute(tmpdir):
+    """
+    Preservation test: when an already-absolute cache_dir is given, it stays
+    absolute (and equivalent in path-meaning).
+    """
+    abs_cache_dir = str(tmpdir / "absolute-cache-dir")
+    pypi_repository = PyPIRepository(
+        ["--index-url", PyPIRepository.DEFAULT_INDEX_URL],
+        cache_dir=abs_cache_dir,
+    )
+    assert os.path.isabs(pypi_repository._cache_dir)
+
+    assert os.path.realpath(pypi_repository._cache_dir) == os.path.realpath(
+        abs_cache_dir
+    )
+
+
+def test_download_dirs_are_absolute_when_cache_dir_relative(tmpdir_cwd):
+    """
+    The download paths are derived from `_cache_dir`. If `_cache_dir` is
+    normalized to absolute, the derived `_download_dir` and `_wheel_download_dir`
+    must also be absolute.
+    """
+    pypi_repository = PyPIRepository(
+        ["--index-url", PyPIRepository.DEFAULT_INDEX_URL],
+        cache_dir="another-relative-cache-arg",
+    )
+    assert os.path.isabs(pypi_repository._download_dir)
+    assert os.path.isabs(pypi_repository._wheel_download_dir)
+
+
+def test_pypi_repository_with_no_cache_dir_option_in_pip_args(tmpdir):
+    """
+    The `if self.options.cache_dir` guard must allow construction when
+    `--no-cache-dir` is specified in pip_args (options.cache_dir is False/None).
+    """
+    pypi_repository = PyPIRepository(
+        ["--index-url", PyPIRepository.DEFAULT_INDEX_URL, "--no-cache-dir"],
+        cache_dir=str(tmpdir / "abs-cache"),
+    )
+
+    assert not pypi_repository.options.cache_dir
