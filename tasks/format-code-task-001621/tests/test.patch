+    @Test
+    public void canGetPullAuthorFromMock() throws Exception {
+        final String login = "alice";
+        final Repo repo = new MkGithub(login).repos().create(
+            Json.createObjectBuilder().add("name", "test-repo").build()
+        );
+        final Pull pull = repo.pulls().create("hello", "head", "base");
+        MatcherAssert.assertThat(
