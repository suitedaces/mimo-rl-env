+    @Test
+    public void readsAuthorLoginFromPullJson() throws Exception {
+        final String login = "bob-the-author";
+        final Repo repo = new MkGithub(login).repos().create(
+            Json.createObjectBuilder().add("name", "another-repo").build()
+        );
+        final Pull pull = Mockito.mock(Pull.class);
+        Mockito.doReturn(
+            Json.createObjectBuilder()
+                .add(
+                    "user",
+                    Json.createObjectBuilder().add("login", login).build()
+                )
+                .build()
+        ).when(pull).json();
+        Mockito.when(pull.repo()).thenReturn(repo);
+        MatcherAssert.assertThat(
+            new Pull.Smart(pull).author().login(),
+            Matchers.equalTo(login)
+        );
+    }
