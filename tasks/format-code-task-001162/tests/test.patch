diff --git a/tests/lib/rules/no-invalid-html-attribute-create-element.js b/tests/lib/rules/no-invalid-html-attribute-create-element.js
new file mode 100644
index 00000000..05a108a5
--- /dev/null
+++ b/tests/lib/rules/no-invalid-html-attribute-create-element.js
@@ -0,0 +1,125 @@
+
+
+
+
+'use strict';
+
+const RuleTester = require('eslint').RuleTester;
+const rule = require('../../../lib/rules/no-invalid-html-attribute');
+
+const parserOptions = {
+  ecmaVersion: 2018,
+  sourceType: 'module',
+  ecmaFeatures: {
+    jsx: true,
+  },
+};
+
+const ruleTester = new RuleTester({ parserOptions });
+
+ruleTester.run('no-invalid-html-attribute createElement parity', rule, {
+  valid: [
+    {
+      code: 'React.createElement("link", { rel: "alternate stylesheet" })',
+    },
+    {
+      code: 'React.createElement("link", { rel: "alternate\\tstylesheet" })',
+    },
+    {
+      code: 'React.createElement("link", { rel: "shortcut icon" })',
+    },
+    {
+      code: 'React.createElement("a", { rel: ["alternate", "tag"] })',
+    },
+    {
+      code: 'React.createElement("a", { rel: getRel() })',
+    },
+    {
+      code: 'React.createElement("a", { rel: [getRel(), relValue] })',
+    },
+    {
+      code: 'React.createElement("Widget", { rel: "not-a-standard-token" })',
+    },
+    {
+      code: 'const rel = "alternate"; React.createElement("a", { rel })',
+    },
+    {
+      code: '<link rel="alternate stylesheet" />',
+    },
+  ],
+  invalid: [
+    {
+      code: 'React.createElement("link", { rel: "alternate mystery" })',
+      errors: [{
+        messageId: 'neverValid',
+        data: { attributeName: 'rel', reportingValue: 'mystery' },
+      }],
+    },
+    {
+      code: 'React.createElement("a", { rel: "alternate canonical" })',
+      errors: [{
+        messageId: 'notValidFor',
+        data: {
+          attributeName: 'rel',
+          reportingValue: 'canonical',
+          elementName: 'a',
+        },
+      }],
+    },
+    {
+      code: 'React.createElement("link", { rel: "shortcut" })',
+      errors: [{
+        messageId: 'notAlone',
+        data: { reportingValue: 'shortcut', missingValue: 'icon' },
+      }],
+    },
+    {
+      code: 'React.createElement("link", { rel: "shortcut stylesheet" })',
+      errors: [{
+        messageId: 'notPaired',
+        data: {
+          reportingValue: 'shortcut',
+          secondValue: 'stylesheet',
+          missingValue: 'icon',
+        },
+      }],
+    },
+    {
+      code: 'React.createElement("link", { rel: "shortcut\\tstylesheet" })',
+      errors: [{
+        messageId: 'notPaired',
+        data: {
+          reportingValue: 'shortcut',
+          secondValue: 'stylesheet',
+          missingValue: 'icon',
+        },
+      }],
+    },
+    {
+      code: 'React.createElement("link", { rel: ["shortcut", "alternate"] })',
+      errors: [{
+        messageId: 'notAlone',
+        data: { reportingValue: 'shortcut', missingValue: 'icon' },
+      }],
+    },
+    {
+      code: 'React.createElement("link", { rel: ["alternate mystery", "shortcut icon"] })',
+      errors: [{
+        messageId: 'neverValid',
+        data: { attributeName: 'rel', reportingValue: 'mystery' },
+      }],
+    },
+    {
+      code: '<a rel="alternate canonical" />',
+      output: '<a rel="alternate " />',
+      errors: [{
+        messageId: 'notValidFor',
+        data: {
+          attributeName: 'rel',
+          reportingValue: 'canonical',
+          elementName: 'a',
+        },
+      }],
+    },
+  ],
+});
