diff --git a/tests/test_utilities/test_csvlook.py b/tests/test_utilities/test_csvlook.py
index ac92d8c..a1bebb1 100644
--- a/tests/test_utilities/test_csvlook.py
+++ b/tests/test_utilities/test_csvlook.py
@@ -86,3 +86,72 @@ class TestCSVLook(CSVKitTestCase, EmptyFileTests):
             '|  1;2;3  |',
             '|---------|',
         ])
+
+    def test_default_does_not_truncate_rows(self):
+
+        lines = self.get_output_as_list(['examples/iris.csv'])
+
+
+        self.assertEqual(len(lines), 155)
+
+        joined = '\n'.join(lines)
+        self.assertNotIn('|           ... |         ... |          ... |',
+                         joined)
+
+        self.assertIn('Iris-virginica', joined)
+
+    def test_default_does_not_truncate_columns(self):
+
+
+        output = self.get_output(['examples/realdata/ks_1033_data.csv'])
+
+
+
+        lines = output.split('\n')
+        header = lines[1]
+
+
+        self.assertIn('ship_date', header)
+        self.assertIn('acquisition_cost', header)
+
+        self.assertNotIn('| ...  |', header)
+
+    def test_default_does_not_truncate_column_width(self):
+
+
+
+        output = self.get_output(['examples/realdata/ks_1033_data.csv'])
+
+        self.assertIn('RIFLE,5.56 MILLIMETER', output)
+
+        self.assertNotIn('RIFLE,5.56 MILLIM...', output)
+
+    def test_max_rows_option(self):
+        self.assertLines(['--max-rows', '1', 'examples/dummy3.csv'], [
+            '|-------+---+----|',
+            '|     a | b | c  |',
+            '|-------+---+----|',
+            '|  True | 2 | 3  |',
+            '|   ... | ... | ...  |',
+            '|-------+---+----|',
+        ])
+
+    def test_max_columns_option(self):
+        self.assertLines(['--max-columns', '2', 'examples/dummy3.csv'], [
+            '|-------+---+------|',
+            '|     a | b | ...  |',
+            '|-------+---+------|',
+            '|  True | 2 | ...  |',
+            '|  True | 4 | ...  |',
+            '|-------+---+------|',
+        ])
+
+    def test_max_column_width_option(self):
+        self.assertLines(['--max-column-width', '3', 'examples/dummy3.csv'], [
+            '|------+---+----|',
+            '|    a | b | c  |',
+            '|------+---+----|',
+            '|  ... | 2 | 3  |',
+            '|  ... | 4 | 5  |',
+            '|------+---+----|',
+        ])
