diff --git a/test-data/unit/check-async-await.test b/test-data/unit/check-async-await.test
index a9c6507bc..41035eba5 100644
--- a/test-data/unit/check-async-await.test
+++ b/test-data/unit/check-async-await.test
@@ -864,3 +864,68 @@ async with C() as x: # E: "async with" outside async function
 
 [builtins fixtures/async_await.pyi]
 [typing fixtures/typing-async.pyi]
+
+[case testAwaitOnNoneReturningFunctionAssignment]
+# Regression test for: mypy did not complain about assigning the result of
+# awaiting an async function that returns None.
+
+async def async_nothing() -> None: ...
+
+async def async_foo() -> None:
+    x = await async_nothing()  # E: Function does not return a value
+[builtins fixtures/async_await.pyi]
+[typing fixtures/typing-async.pyi]
+
+[case testAwaitOnNoneReturningFunctionExpressionStmt]
+# Bare await as expression statement should not error.
+
+async def async_nothing() -> None: ...
+
+async def async_foo() -> None:
+    await async_nothing()
+[builtins fixtures/async_await.pyi]
+[typing fixtures/typing-async.pyi]
+
+[case testAwaitOnNoneReturningFunctionReturnStmt]
+# Returning await of a None-returning async fn from a -> None async fn should not error.
+
+async def async_nothing() -> None: ...
+
+async def async_foo() -> None:
+    return await async_nothing()
+[builtins fixtures/async_await.pyi]
+[typing fixtures/typing-async.pyi]
+
+[case testAwaitOnNonNoneReturningFunctionAssignment]
+# Preservation: assigning the result of awaiting a non-None async fn is OK.
+
+async def async_int() -> int:
+    return 0
+
+async def async_foo() -> None:
+    x = await async_int()
+    reveal_type(x)  # N: Revealed type is "builtins.int"
+[builtins fixtures/async_await.pyi]
+[typing fixtures/typing-async.pyi]
+
+[case testSyncCallNoneReturningFunctionAssignment]
+# Preservation/control: synchronous case still errors.
+
+def nothing() -> None: ...
+
+def foo() -> None:
+    x = nothing()  # E: "nothing" does not return a value
+[builtins fixtures/async_await.pyi]
+[typing fixtures/typing-async.pyi]
+
+[case testAwaitOnNoneReturningFunctionAsArgument]
+# Using the result of `await none_coroutine()` as an argument should error.
+
+async def async_nothing() -> None: ...
+
+def take(x: object) -> None: ...
+
+async def async_foo() -> None:
+    take(await async_nothing())  # E: Function does not return a value
+[builtins fixtures/async_await.pyi]
+[typing fixtures/typing-async.pyi]
