+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+cd /testbed/build
+ninja -j 4 clspv-opt
+
+
+PYTHON="$(command -v python3)"
+LIT=/testbed/third_party/llvm/llvm/utils/lit/lit.py
+run_lit() {
+    "$PYTHON" "$LIT" -v "$@" \
+        -DCLSPV_TARGET="-arch=spir" \
+        --path /testbed/build/third_party/llvm/bin \
+        --path /testbed/build/third_party/SPIRV-Tools/tools \
+        --path /testbed/build/bin
+}
+
+
+run_lit \
+    test/RewritePackedStructs/packed_struct.cl \
+    test/RewritePackedStructs/packed_struct2.ll \
+    test/RewritePackedStructs/packed_struct3.ll \
+    test/RewritePackedStructs/packed_struct4.ll \
+    test/RewritePackedStructs/packed_struct_opaque.ll
+
+
+run_lit test/RewritePackedStructs/packed_struct_opaque_lowering.ll
