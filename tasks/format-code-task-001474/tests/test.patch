+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+const TIMEBASE = path.join(__dirname, '..', 'src', 'waax.timebase.js');
+
+function loadWX(randomValues) {
+  let randomIndex = 0;
+
+  function FixedDate(...args) {
+    if (this instanceof FixedDate) {
+      return args.length ? new Date(...args) : new Date(1600000000000);
+    }
+    return new Date(1600000000000).toString();
+  }
+  FixedDate.now = () => 4660;
+  FixedDate.UTC = Date.UTC;
+  FixedDate.parse = Date.parse;
+  FixedDate.prototype = Date.prototype;
+
+  const fixedMath = Object.create(Math);
+  fixedMath.random = () => randomValues[randomIndex++] ?? 0;
+
+  const context = {
+    Date: FixedDate,
+    Math: fixedMath,
+    requestAnimationFrame: () => 0,
+    WX: {
+      now: 0,
+      clamp: (value, min, max) => Math.min(Math.max(value, min), max),
+      isBoolean: (value) => typeof value === 'boolean',
+      Log: {
+        error: (message) => {
+          throw new Error(message);
+        }
+      }
+    }
+  };
+
+  vm.createContext(context);
+  vm.runInContext(fs.readFileSync(TIMEBASE, 'utf8'), context, {
+    filename: 'waax.timebase.js'
+  });
+  return context.WX;
+}
+
+function plainArray(values) {
+  return Array.from(values);
+}
+
+function sortedCopy(values) {
+  return plainArray(values).sort();
+}
+
+function assertSameMembers(actual, expected) {
+  assert.deepStrictEqual(sortedCopy(actual), sortedCopy(expected));
+}
+
+function assertNoteFields(note, expected) {
+  assert.notStrictEqual(note, null);
+  assert.strictEqual(note.pitch, expected.pitch);
+  assert.strictEqual(note.velocity, expected.velocity);
+  assert.strictEqual(note.start, expected.start);
+  assert.strictEqual(note.duration, expected.duration);
+}
+
+function assertSameObjects(actual, expected) {
+  assert.ok(Array.isArray(actual));
+  assert.strictEqual(actual.length, expected.length);
+  for (const item of expected) {
+    assert.ok(actual.includes(item));
+  }
+}
+
+function runTest(name, fn) {
+  try {
+    fn();
+    console.log(`ok - ${name}`);
+  } catch (error) {
+    console.error(`not ok - ${name}`);
+    throw error;
+  }
+}
+
+runTest('push/get/hasId keep note state under deterministic unique IDs', () => {
+
+
+  const WX = loadWX([0, 0.25, 0.5, 0.75]);
+  const clip = WX.NoteClip();
+  const note = WX.Note(60, 64, 0, 120);
+
+  assert.strictEqual(clip.getSize(), 0);
+  assert.deepStrictEqual(plainArray(clip.getAllId()), []);
+
+  const id = clip.push(note);
+
+  assert.strictEqual(typeof id, 'string');
+  assert.notStrictEqual(id, '');
+  assert.strictEqual(clip.getSize(), 1);
+  assert.strictEqual(clip.hasId(id), true);
+  assert.strictEqual(clip.get(id), note);
+  assertNoteFields(clip.get(id), { pitch: 60, velocity: 64, start: 0, duration: 120 });
+  assertSameMembers(clip.getAllId(), [id]);
+});
+
+runTest('push avoids a generated ID collision already present in that clip', () => {
+
+
+  const WX = loadWX([
+    0, 0.25, 0.5, 0.75,
+    0, 0.25, 0.5, 0.75,
+    0.1, 0.2, 0.3, 0.4
+  ]);
+  const clip = WX.NoteClip();
+
+  const firstId = clip.push(WX.Note(1, 2, 3, 4));
+  const secondId = clip.push(WX.Note(5, 6, 7, 8));
+
+
+  assert.strictEqual(typeof firstId, 'string');
+  assert.strictEqual(typeof secondId, 'string');
+  assert.notStrictEqual(firstId, secondId);
+  assert.strictEqual(clip.getSize(), 2);
+  assertSameMembers(clip.getAllId(), [firstId, secondId]);
+  assertNoteFields(clip.get(firstId), { pitch: 1, velocity: 2, start: 3, duration: 4 });
+  assertNoteFields(clip.get(secondId), { pitch: 5, velocity: 6, start: 7, duration: 8 });
+});
+
+runTest('delete existing and missing IDs returns concrete values and updates state', () => {
+
+
+  const WX = loadWX([
+    0, 0.25, 0.5, 0.75,
+    0.1, 0.2, 0.3, 0.4,
+    0.9, 0.8, 0.7, 0.6
+  ]);
+  const clip = WX.NoteClip();
+  const keptIdA = clip.push(WX.Note(60, 64, 0, 120));
+  const deleteId = clip.push(WX.Note(62, 80, 120, 60));
+  const keptIdB = clip.push(WX.Note(64, 90, 240, 120));
+
+
+  assert.strictEqual(clip.delete('not-here'), null);
+  assert.strictEqual(clip.getSize(), 3);
+  assertSameMembers(clip.getAllId(), [keptIdA, deleteId, keptIdB]);
+
+  const deleted = clip.delete(deleteId);
+  assertNoteFields(deleted, { pitch: 62, velocity: 80, start: 120, duration: 60 });
+  assert.strictEqual(clip.getSize(), 2);
+  assert.strictEqual(clip.hasId(deleteId), false);
+  assert.strictEqual(clip.get(deleteId), null);
+  assertSameMembers(clip.getAllId(), [keptIdA, keptIdB]);
+});
+
+runTest('empty is idempotent cleanup and removes all observable note state', () => {
+
+
+  const WX = loadWX([
+    0, 0.25, 0.5, 0.75,
+    0.1, 0.2, 0.3, 0.4
+  ]);
+  const clip = WX.NoteClip();
+  const id = clip.push(WX.Note(60, 64, 0, 120));
+  clip.push(WX.Note(62, 80, 120, 60));
+
+
+  assert.strictEqual(typeof id, 'string');
+  assert.strictEqual(clip.getSize(), 2);
+
+  clip.empty();
+  assert.strictEqual(clip.getSize(), 0);
+  assert.deepStrictEqual(plainArray(clip.getAllId()), []);
+  assert.strictEqual(clip.get(id), null);
+  assert.strictEqual(clip.hasId(id), false);
+  assert.strictEqual(clip.findNoteIdAtPosition(60, 0), null);
+  assert.strictEqual(clip.findNotesIdInArea(0, 127, 0, 999), null);
+  assert.strictEqual(clip.scanNotesInTimeSpan(0, 999), null);
+
+  clip.empty();
+  assert.strictEqual(clip.getSize(), 0);
+  assert.deepStrictEqual(plainArray(clip.getAllId()), []);
+});
+
+runTest('piano-roll point, area, and span selection use inclusive boundaries', () => {
+
+
+  const WX = loadWX([
+    0, 0.25, 0.5, 0.75,
+    0.1, 0.2, 0.3, 0.4,
+    0.9, 0.8, 0.7, 0.6
+  ]);
+  const clip = WX.NoteClip();
+  const note60 = WX.Note(60, 64, 0, 120);
+  const note62 = WX.Note(62, 80, 120, 60);
+  const note64 = WX.Note(64, 90, 240, 120);
+  const id60 = clip.push(note60);
+  const id62 = clip.push(note62);
+  const id64 = clip.push(note64);
+
+
+  assert.strictEqual(clip.findNoteIdAtPosition(60, 0), id60);
+  assert.strictEqual(clip.findNoteIdAtPosition(60, 120), id60);
+  assert.strictEqual(clip.findNoteIdAtPosition(62, 119), null);
+  assert.strictEqual(clip.findNoteIdAtPosition(62, 120), id62);
+  assert.strictEqual(clip.findNoteIdAtPosition(62, 180), id62);
+  assert.strictEqual(clip.findNoteIdAtPosition(64, 361), null);
+
+
+  assertSameMembers(clip.findNotesIdInArea(60, 64, 0, 240), [id60, id62, id64]);
+  assertSameMembers(clip.findNotesIdInArea(61, 63, 100, 200), [id62]);
+  assert.strictEqual(clip.findNotesIdInArea(70, 72, 0, 500), null);
+
+
+  assertSameObjects(clip.scanNotesInTimeSpan(0, 120), [note60, note62]);
+  assert.strictEqual(clip.scanNotesInTimeSpan(121, 239), null);
+  assertSameObjects(clip.scanNotesInTimeSpan(200, 300), [note64]);
+});
+
+runTest('set updates existing notes through the note API and stores absent IDs', () => {
+
+
+  const WX = loadWX([0.11, 0.22, 0.33, 0.44]);
+  const clip = WX.NoteClip();
+  const original = WX.Note(60, 64, 0, 120);
+  const id = clip.push(original);
+
+
+  assert.strictEqual(typeof id, 'string');
+  assertNoteFields(clip.get(id), { pitch: 60, velocity: 64, start: 0, duration: 120 });
+
+  const replacement = WX.Note(65, 70, 240, 80);
+  clip.set(id, replacement);
+  assert.strictEqual(clip.get(id), original);
+  assert.strictEqual(clip.get(id) === replacement, false);
+  assertNoteFields(clip.get(id), { pitch: 65, velocity: 70, start: 240, duration: 80 });
+
+  const manual = WX.Note(67, 90, 300, 40);
+  clip.set('manual-id', manual);
+  assert.strictEqual(clip.hasId('manual-id'), true);
+  assert.strictEqual(clip.get('manual-id'), manual);
+  assertNoteFields(clip.get('manual-id'), { pitch: 67, velocity: 90, start: 300, duration: 40 });
+  assertSameMembers(clip.getAllId(), [id, 'manual-id']);
+});
+
+runTest('iterate calls back once per stored note with id, note, and index', () => {
+
+
+  const WX = loadWX([0.11, 0.22, 0.33, 0.44]);
+  const clip = WX.NoteClip();
+  const pushedNote = WX.Note(60, 64, 0, 120);
+  const manualNote = WX.Note(67, 90, 300, 40);
+  const pushedId = clip.push(pushedNote);
+  clip.set('manual-id', manualNote);
+
+  const seen = [];
+  clip.iterate((id, note, index) => {
+    seen.push([id, note, index]);
+  });
+
+
+  assert.strictEqual(seen.length, 2);
+  assertSameMembers(seen.map((entry) => entry[0]), [pushedId, 'manual-id']);
+  assertSameMembers(seen.map((entry) => entry[2]), [0, 1]);
+  assert.strictEqual(seen.find((entry) => entry[0] === pushedId)[1], pushedNote);
+  assert.strictEqual(seen.find((entry) => entry[0] === 'manual-id')[1], manualNote);
+});
+
+runTest('two NoteClip instances keep independent stores and sizes', () => {
+
+
+  const WX = loadWX([0.11, 0.22, 0.33, 0.44]);
+  const a = WX.NoteClip();
+  const b = WX.NoteClip();
+
+  const id = a.push(WX.Note(70, 50, 10, 20));
+
+
+  assert.strictEqual(typeof id, 'string');
+  assert.strictEqual(a.getSize(), 1);
+  assert.strictEqual(b.getSize(), 0);
+  assertSameMembers(a.getAllId(), [id]);
+  assert.deepStrictEqual(plainArray(b.getAllId()), []);
+  assertNoteFields(a.get(id), { pitch: 70, velocity: 50, start: 10, duration: 20 });
+  assert.strictEqual(b.get(id), null);
+  assert.strictEqual(b.hasId(id), false);
+});
+
+runTest('repeated use and cleanup cycles leave public resource counters bounded', () => {
+
+
+  const WX = loadWX([]);
+  const clip = WX.NoteClip();
+  let totalSizeAfterCleanup = 0;
+  let totalIdsAfterCleanup = 0;
+
+  for (let i = 0; i < 150; i += 1) {
+    clip.set(`cycle-${i}-a`, WX.Note(60, 64, 0, 120));
+    clip.set(`cycle-${i}-b`, WX.Note(61, 65, 120, 60));
+    clip.set(`cycle-${i}-c`, WX.Note(62, 66, 240, 30));
+    assert.strictEqual(clip.getAllId().length, 3);
+
+    clip.empty();
+    totalSizeAfterCleanup += clip.getSize();
+    totalIdsAfterCleanup += clip.getAllId().length;
+  }
+
+  assert.strictEqual(totalSizeAfterCleanup, 0);
+  assert.strictEqual(totalIdsAfterCleanup, 0);
+  assert.strictEqual(clip.getSize(), 0);
+  assert.deepStrictEqual(plainArray(clip.getAllId()), []);
+});
