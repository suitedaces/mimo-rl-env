+package fs
+
+import (
+	"context"
+	"io/ioutil"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestFsckRemovesEmptyDirectories(t *testing.T) {
+	dir, err := ioutil.TempDir("", "gopass-fsck-")
+	assert.NoError(t, err)
+	defer os.RemoveAll(dir)
+
+	emptyDir := filepath.Join(dir, "stale-empty-dir")
+	assert.NoError(t, os.MkdirAll(emptyDir, 0700))
+
+	s := New(dir)
+
+	err = s.fsckCheckDir(context.Background(), emptyDir)
+	assert.NoError(t, err)
+
+	_, statErr := os.Stat(emptyDir)
+	assert.True(t, os.IsNotExist(statErr), "empty directory should be removed")
+}
