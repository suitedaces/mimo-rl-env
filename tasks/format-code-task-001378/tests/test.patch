+func TestFsckContinuesAfterSubStoreFailureAndReturnsAllFailures(t *testing.T) {
+	u := gptest.NewUnitTester(t)
+	defer u.Remove()
+
+	ctx := context.Background()
+	rs, err := createRootStore(ctx, u)
+	assert.NoError(t, err)
+
+	var seen []string
+	alphaErr := errors.New("alpha injected failure")
+	betaErr := errors.New("beta injected failure")
+
+	rs.mounts = map[string]storepkg.Store{
+		"alpha": &recordingStore{name: "alpha", err: alphaErr, seen: &seen},
+		"beta":  &recordingStore{name: "beta", err: betaErr, seen: &seen},
+	}
+
+	buf := &bytes.Buffer{}
+	oldOut := out.Stdout
+	out.Stdout = buf
+	defer func() {
+		out.Stdout = oldOut
+	}()
+	color.NoColor = true
+
+	err = rs.Fsck(ctx, "")
+	assert.Error(t, err)
+
+	assert.Contains(t, seen, "alpha:")
+	assert.Contains(t, seen, "beta:")
+
+	errText := err.Error()
+	assert.Contains(t, errText, "alpha injected failure")
+	assert.Contains(t, errText, "beta injected failure")
+
+	assert.NotEmpty(t, buf.String(), "fsck should report mounted-store failures")
+}
+
+func TestFsckPrefixesMountedStoreOutputWithAlias(t *testing.T) {
+	u := gptest.NewUnitTester(t)
+	defer u.Remove()
+
+	ctx := context.Background()
+	ctx = backend.WithCryptoBackend(ctx, backend.Plain)
+	ctx = backend.WithRCSBackend(ctx, backend.Noop)
+
+	rs, err := createRootStore(ctx, u)
+	assert.NoError(t, err)
+
+	assert.NoError(t, u.InitStore("alpha"))
+	assert.NoError(t, u.InitStore("beta"))
+	assert.NoError(t, os.Chmod(filepath.Join(u.StoreDir("alpha"), "foo.txt"), 0644))
+	assert.NoError(t, os.Chmod(filepath.Join(u.StoreDir("beta"), "foo.txt"), 0644))
+
+	assert.NoError(t, rs.AddMount(ctx, "alpha", u.StoreDir("alpha")))
+	assert.NoError(t, rs.AddMount(ctx, "beta", u.StoreDir("beta")))
+
+	buf := &bytes.Buffer{}
+	oldOut := out.Stdout
+	out.Stdout = buf
+	defer func() {
+		out.Stdout = oldOut
+	}()
+	color.NoColor = true
+
+	assert.NoError(t, rs.Fsck(ctx, ""))
+
+	got := buf.String()
+	assertOutputLineWithPrefixContains(t, got, "alpha", u.StoreDir("alpha"))
+	assertOutputLineWithPrefixContains(t, got, "beta", u.StoreDir("beta"))
+}
+
+func assertOutputLineWithPrefixContains(t *testing.T, output, alias, text string) {
+	t.Helper()
+	prefix := "[" + alias + "]"
+	for _, line := range strings.Split(output, "\n") {
+		if strings.HasPrefix(line, prefix) && strings.Contains(line, text) {
+			return
+		}
+	}
+	t.Fatalf("expected output line for %s to contain %q, got %q", alias, text, output)
+}
