+func TestFsckPrintsStartupAndProgress(t *testing.T) {
+	u := gptest.NewUnitTester(t)
+	defer u.Remove()
+	addFsckEntries(t, u, "alpha", "beta", "gamma")
+
+	ctx := context.Background()
+	ctx = ctxutil.WithTerminal(ctx, false)
+	act, err := newMock(ctx, u)
+	assert.NoError(t, err)
+
+	color.NoColor = true
+	app := cli.NewApp()
+	c := cli.NewContext(app, flag.NewFlagSet("default", flag.ContinueOnError), nil)
+
+	got, err := captureProcessStdout(t, func() error {
+		return act.Fsck(ctx, c)
+	})
+	assert.NoError(t, err)
+	assert.True(t, firstOutputLineBefore(got, "Extra recipients on foo"), "fsck should print startup output before longer checks")
+
+	assert.True(t, hasVisibleProgressUpdate(got, len(u.Entries)+3), "fsck should report checked/total progress, got %q", got)
+}
+
+func TestFsckSuppressesProgressWhenOutputHidden(t *testing.T) {
+	u := gptest.NewUnitTester(t)
+	defer u.Remove()
+	addFsckEntries(t, u, "alpha", "beta", "gamma")
+
+	ctx := context.Background()
+	ctx = ctxutil.WithTerminal(ctx, false)
+	ctx = out.WithHidden(ctx, true)
+	act, err := newMock(ctx, u)
+	assert.NoError(t, err)
+
+	color.NoColor = true
+	app := cli.NewApp()
+	c := cli.NewContext(app, flag.NewFlagSet("default", flag.ContinueOnError), nil)
+
+	got, err := captureProcessStdout(t, func() error {
+		return act.Fsck(ctx, c)
+	})
+	assert.NoError(t, err)
+	assert.False(t, hasVisibleProgressUpdate(got, 1), "hidden output should not leak progress, got %q", got)
+}
+
+func addFsckEntries(t *testing.T, u *gptest.Unit, names ...string) {
+	for _, name := range names {
+		fn := filepath.Join(u.StoreDir(""), name+".txt")
+		assert.NoError(t, ioutil.WriteFile(fn, []byte("secret"), 0600))
+	}
+}
+
+func firstOutputLineBefore(output, later string) bool {
+	for _, line := range strings.Split(output, "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+		return !strings.Contains(line, later)
+	}
+	return false
+}
+
+func hasVisibleProgressUpdate(output string, minTotal int) bool {
+	fields := strings.FieldsFunc(output, func(r rune) bool {
+		return r < '0' || r > '9'
+	})
+	for i := 0; i+1 < len(fields); i++ {
+		current, err := strconv.Atoi(fields[i])
+		if err != nil {
+			continue
+		}
+		total, err := strconv.Atoi(fields[i+1])
+		if err != nil {
+			continue
+		}
+		if current > 0 && total >= minTotal && current <= total {
+			return true
+		}
+	}
+	return false
+}
+
+func captureProcessStdout(t *testing.T, fn func() error) (string, error) {
+	t.Helper()
+
+	oldOut := out.Stdout
+	oldStdout := stdout
+	defer func() {
+		out.Stdout = oldOut
+		stdout = oldStdout
+	}()
+
+	origFD, err := syscall.Dup(int(os.Stdout.Fd()))
+	if err != nil {
+		return "", err
+	}
+	defer syscall.Close(origFD)
+
+	r, w, err := os.Pipe()
+	if err != nil {
+		return "", err
+	}
+
+	var buf bytes.Buffer
+	done := make(chan error, 1)
+	go func() {
+		_, copyErr := io.Copy(&buf, r)
+		done <- copyErr
+	}()
+
+	if err := syscall.Dup2(int(w.Fd()), int(os.Stdout.Fd())); err != nil {
+		_ = r.Close()
+		_ = w.Close()
+		return "", err
+	}
+	out.Stdout = os.Stdout
+	stdout = os.Stdout
+
+	runErr := fn()
+
+	_ = syscall.Dup2(origFD, int(os.Stdout.Fd()))
+	_ = w.Close()
+	copyErr := <-done
+	_ = r.Close()
+	if copyErr != nil {
+		return buf.String(), copyErr
+	}
+	return buf.String(), runErr
+}
