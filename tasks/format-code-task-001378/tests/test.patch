--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,33 @@
+#!/bin/bash
+set -euo pipefail
+cd /testbed
+
+
+export GOROOT=/opt/go-1.10
+export GOPATH=/root/go
+export GO111MODULE=off
+export PATH=$GOROOT/bin:$PATH
+
+
+mkdir -p /root/go/src/github.com/gopasspw
+ln -sfn /testbed /root/go/src/github.com/gopasspw/gopass
+
+
+rm -rf /root/.cache/go-build
+
+cd /root/go/src/github.com/gopasspw/gopass
+
+case "${1:-}" in
+  base)
+    go test -count=1 -v -run '^TestAction$' ./pkg/action/
+    ;;
+  new)
+    go test -count=1 -v -run '^(TestFsck|TestFsckPrintsStartupAndProgress|TestFsckSuppressesProgressWhenOutputHidden)$' ./pkg/action/
+    go test -count=1 -v -run '^TestFsckRemovesEmptyDirectories$' ./pkg/backend/storage/fs/
+    go test -count=1 -v -run '^(TestFsckContinuesAfterSubStoreFailureAndReturnsAllFailures|TestFsckPrefixesMountedStoreOutputWithAlias)$' ./pkg/store/root/
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
