+
+def test_same_input_matches_fresh_python_process_after_in_process_noise():
+    content = """<html><body>
+    <div itemscope itemtype="https://schema.org/Article">
+      <meta itemprop="name" content="Fresh Process Title">
+      <meta itemprop="description" content="Fresh Process Desc">
+      <meta itemprop="image" content="/fresh-process.jpg">
+    </div>
+    </body></html>"""
+    noisy_content = """<html><body>
+    <script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","name":"Noise Title","description":"Noise Desc","image":"/noise.jpg"}</script>
+    </body></html>"""
+    expected = {
+        "site_name": "example.com",
+        "title": "Fresh Process Title",
+        "description": "Fresh Process Desc",
+        "image": "/fresh-process.jpg",
+    }
+
+    in_process = preview_fields(content)
+    assert preview_fields(noisy_content) == {
+        "site_name": "example.com",
+        "title": "Noise Title",
+        "description": "Noise Desc",
+        "image": "/noise.jpg",
+    }
+    assert preview_fields(content) == expected
+
+    script = f"""
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+from linkpreview import link_preview
+content = {content!r}
+preview = link_preview("https://example.com/page", content=content)
+sys.stdout.write(json.dumps({{
+    "site_name": preview.site_name,
+    "title": preview.title,
+    "description": preview.description,
+    "image": preview.image,
+}}, sort_keys=True))
+"""
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        capture_output=True,
+    )
+    fresh_process = json.loads(completed.stdout)
+
+    assert in_process == expected
+    assert fresh_process == expected
+
+
+def test_supplied_content_does_not_touch_network(monkeypatch):
+    content = """<html><body>
+    <div itemscope itemtype="https://schema.org/Article">
+      <meta itemprop="name" content="Side Effect Title">
+      <meta itemprop="description" content="Side Effect Desc">
+      <meta itemprop="image" content="/side-effect.jpg">
+    </div>
+    </body></html>"""
+
+    def fail_socket(*args, **kwargs):
+        raise AssertionError("unexpected network access")
+
+    monkeypatch.setattr(socket, "socket", fail_socket)
+
+
+    assert preview_fields(content) == {
+        "site_name": "example.com",
+        "title": "Side Effect Title",
+        "description": "Side Effect Desc",
+        "image": "/side-effect.jpg",
+    }
