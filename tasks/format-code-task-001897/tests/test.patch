+    content = """<html><body>
+    <script type="application/ld+json">[
+      {"@context":"https://schema.org","name":"No Type Title","description":"No Type Desc","image":"/no-type.jpg"},
+      {"@context":"https://schema.org","@type":"Article","name":"Array Article","description":"Array Desc","image":"/array.jpg"}
+    ]</script>
+    <title>Generic Title</title><meta name="description" content="Generic Desc"><img src="/generic.jpg">
+    </body></html>"""
