+      {"@context":"https://schema.org","@type":"WebSite","name":"The Website","description":"Website Desc","image":"/website.jpg"},
+      {"@context":"https://schema.org","@type":"Article","name":"The Article","description":"Article Desc","image":"/article.jpg"}
