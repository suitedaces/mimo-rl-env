+import json
+import socket
+import subprocess
+import sys
+
+from linkpreview import link_preview
+
+
+def preview_fields(content, url="https://example.com/page", **kwargs):
+    preview = link_preview(url, content=content, **kwargs)
+    return {
+        "site_name": preview.site_name,
+        "title": preview.title,
+        "description": preview.description,
+        "image": preview.image,
+    }
+
+
+def test_microdata_article_fields_populate_preview_before_generic_fallback():
+
+
+
+
+    content = """<html><head></head><body>
+    <div itemscope itemtype="https://schema.org/Article">
+      <meta itemprop="name" content="Micro Title">
+      <meta itemprop="description" content="Micro Desc">
+      <meta itemprop="image" content="/img/micro.jpg">
+    </div>
+    <title>Generic Title</title><h1>Generic H1</h1>
+    <p>Generic paragraph</p><img src="/generic.jpg">
+    </body></html>"""
+
+    assert preview_fields(content) == {
+        "site_name": "example.com",
+        "title": "Micro Title",
+        "description": "Micro Desc",
+        "image": "/img/micro.jpg",
+    }
+
+
+def test_invalid_microdata_records_are_ignored_and_do_not_fill_fields():
+
+
+
+
+    content = """<html><head>
+    <title>Generic Title</title>
+    <meta name="description" content="Generic Desc">
+    </head><body>
+    <div itemtype="https://schema.org/Article">
+      <meta itemprop="name" content="Missing Scope Title">
+      <meta itemprop="description" content="Missing Scope Desc">
+      <meta itemprop="image" content="/missing-scope.jpg">
+    </div>
+    <div itemscope>
+      <meta itemprop="name" content="Missing Type Title">
+      <meta itemprop="description" content="Missing Type Desc">
+      <meta itemprop="image" content="/missing-type.jpg">
+    </div>
+    <div itemscope itemtype="https://schema.com/Article">
+      <meta itemprop="name" content="Wrong Domain Title">
+      <meta itemprop="description" content="Wrong Domain Desc">
+      <meta itemprop="image" content="/wrong-domain.jpg">
+    </div>
+    <div itemscope itemtype="https://schema.org/Article">
+      <span itemprop="name">No Content Title</span>
+      <span itemprop="description">No Content Desc</span>
+      <span itemprop="image">/no-content.jpg</span>
+    </div>
+    <h1>Generic H1</h1><p>Generic paragraph</p><img src="/generic.jpg">
+    </body></html>"""
+
+    assert preview_fields(content) == {
+        "site_name": "example.com",
+        "title": "Generic Title",
+        "description": "Generic Desc",
+        "image": "/generic.jpg",
+    }
+
+
+def test_jsonld_single_object_uses_description_and_image_object_url():
+
+
+
+
+    content = """<html><body>
+    <script type="application/ld+json">{"@context":"https://schema.org","@type":"NewsArticle","description":"JSON Desc","image":{"@type":"ImageObject","url":"https://cdn.example.com/json.jpg"}}</script>
+    <title>Generic Title</title><p>Generic paragraph</p><img src="/generic.jpg">
+    </body></html>"""
+
+    assert preview_fields(content) == {
+        "site_name": "example.com",
+        "title": "Generic Title",
+        "description": "JSON Desc",
+        "image": "https://cdn.example.com/json.jpg",
+    }
+
+
+def test_jsonld_array_ignores_objects_without_type():
