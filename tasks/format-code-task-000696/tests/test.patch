+package cli_test
+
+import (
+	"bytes"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/coder/coder/cli/clitest"
+	"github.com/coder/coder/coderd"
+	"github.com/coder/coder/coderd/coderdtest"
+	"github.com/coder/coder/codersdk"
+)
+
+func TestProjectList(t *testing.T) {
+	t.Parallel()
+
+	t.Run("EmptyShowsCreateHint", func(t *testing.T) {
+		t.Parallel()
+		client := coderdtest.New(t)
+		coderdtest.CreateInitialUser(t, client)
+
+		output := runProjectListCommand(t, client, "projects", "list")
+
+		require.Contains(t, output, "coder projects create <directory>")
+		require.NotContains(t, output, "Last Updated")
+		require.NotContains(t, output, "Used By")
+	})
+
+	t.Run("ListShowsProjectTable", func(t *testing.T) {
+		t.Parallel()
+		client := coderdtest.New(t)
+		user := coderdtest.CreateInitialUser(t, client)
+		project := createReadyProject(t, client, user.Organization)
+
+		output := runProjectListCommand(t, client, "projects", "list")
+
+		require.Contains(t, output, project.Name)
+		require.Contains(t, output, "Project")
+		require.Contains(t, output, "Source")
+		require.Contains(t, output, "Last Updated")
+		require.Contains(t, output, "Used By")
+	})
+
+	t.Run("AliasShowsProjectTable", func(t *testing.T) {
+		t.Parallel()
+		client := coderdtest.New(t)
+		user := coderdtest.CreateInitialUser(t, client)
+		project := createReadyProject(t, client, user.Organization)
+
+		output := runProjectListCommand(t, client, "projects", "ls")
+
+		require.Contains(t, output, project.Name)
+		require.Contains(t, output, "Project")
+		require.Contains(t, output, "Source")
+		require.Contains(t, output, "Last Updated")
+		require.Contains(t, output, "Used By")
+	})
+
+	t.Run("UsedByPluralization", func(t *testing.T) {
+		t.Parallel()
+		client := coderdtest.New(t)
+		user := coderdtest.CreateInitialUser(t, client)
+		zeroOwnerProject := createReadyProject(t, client, user.Organization)
+		oneOwnerProject := createReadyProject(t, client, user.Organization)
+		_ = coderdtest.CreateWorkspace(t, client, "", oneOwnerProject.ID)
+
+		output := runProjectListCommand(t, client, "projects", "list")
+
+		require.Contains(t, output, zeroOwnerProject.Name)
+		require.Contains(t, output, oneOwnerProject.Name)
+		zeroUsedBy := usedByFields(t, output, zeroOwnerProject.Name)
+		oneUsedBy := usedByFields(t, output, oneOwnerProject.Name)
+		require.Equal(t, strconv.Itoa(0), zeroUsedBy[0])
+		require.Equal(t, strconv.Itoa(1), oneUsedBy[0])
+		require.NotEqual(t, zeroUsedBy[1], oneUsedBy[1])
+	})
+}
+
+func runProjectListCommand(t *testing.T, client *codersdk.Client, args ...string) string {
+	t.Helper()
+
+	cmd, root := clitest.New(t, args...)
+	clitest.SetupConfig(t, client, root)
+
+	var stdout bytes.Buffer
+	cmd.SetOut(&stdout)
+	err := cmd.Execute()
+	require.NoError(t, err)
+	return stdout.String()
+}
+
+func usedByFields(t *testing.T, output string, projectName string) []string {
+	t.Helper()
+
+	for _, line := range strings.Split(output, "\n") {
+		if !strings.Contains(line, projectName) {
+			continue
+		}
+		fields := strings.Fields(line)
+		require.GreaterOrEqual(t, len(fields), 2)
+		return fields[len(fields)-2:]
+	}
+	require.FailNowf(t, "project row not found", "project %q was not present in output:\n%s", projectName, output)
+	return nil
+}
+
+func createReadyProject(t *testing.T, client *codersdk.Client, organization string) coderd.Project {
+	t.Helper()
+
+	daemon := coderdtest.NewProvisionerDaemon(t, client)
+	defer daemon.Close()
+
+	job := coderdtest.CreateProjectImportJob(t, client, organization, nil)
+	coderdtest.AwaitProjectImportJob(t, client, organization, job.ID)
+	return coderdtest.CreateProject(t, client, organization, job.ID)
+}
