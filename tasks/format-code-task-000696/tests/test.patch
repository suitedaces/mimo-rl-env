+++ b/mimo_test_command.sh
@@ -0,0 +1,16 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 -run 'TestProject(Create|Plan|Update)' ./cli/
+    ;;
+  new)
+    go test -v -count=1 -run 'TestProjectList|TestProjects/ListWorkspaceOwnerCountDistinctOwners|TestProjectsByOrganization/ListWorkspaceOwnerCountDistinctOwners' ./cli/ ./coderd/
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
