+
+func createProjectForUsageCount(t *testing.T, client *codersdk.Client, organization string) coderd.Project {
+	t.Helper()
+
+	daemon := coderdtest.NewProvisionerDaemon(t, client)
+	defer daemon.Close()
+
+	job := coderdtest.CreateProjectImportJob(t, client, organization, nil)
+	coderdtest.AwaitProjectImportJob(t, client, organization, job.ID)
+	return coderdtest.CreateProject(t, client, organization, job.ID)
+}
+
+func projectUsageCountsByName(t *testing.T, client *codersdk.Client, organization string) map[string]float64 {
+	t.Helper()
+
+	route := "/api/v2/projects"
+	if organization != "" {
+		route += "/" + organization
+	}
+	serverURL, err := client.URL.Parse(route)
+	require.NoError(t, err)
+	req, err := http.NewRequestWithContext(context.Background(), http.MethodGet, serverURL.String(), nil)
+	require.NoError(t, err)
+	req.AddCookie(&http.Cookie{
+		Name:  httpmw.AuthCookie,
+		Value: client.SessionToken,
+	})
+	res, err := http.DefaultClient.Do(req)
+	require.NoError(t, err)
+	defer res.Body.Close()
+	require.Equal(t, http.StatusOK, res.StatusCode)
+
+	var projects []map[string]interface{}
+	require.NoError(t, json.NewDecoder(res.Body).Decode(&projects))
+	counts := make(map[string]float64, len(projects))
+	for _, project := range projects {
+		name, ok := project["name"].(string)
+		require.True(t, ok)
+		count, ok := project["workspace_owner_count"].(float64)
+		require.True(t, ok)
+		counts[name] = count
+	}
+	return counts
+}
