diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,197 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+export PIP_NO_INDEX=1
+export PIP_FIND_LINKS=/opt/stage4a_wheelhouse
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+python -m venv "$TMP/venv" || fail "create venv"
+"$TMP/venv/bin/python" -m pip install --no-index --find-links /opt/stage4a_wheelhouse -e /workspace/repo >"$TMP/build.out" 2>"$TMP/build.err" || {
+    cat "$TMP/build.out" >&2
+    cat "$TMP/build.err" >&2
+    fail "build/install"
+}
+
+BIN="$TMP/venv/bin/ftfy"
+[ -x "$BIN" ] || fail "installed ftfy command not found at $BIN"
+
+cd "$TMP"
+
+assert_file_eq() {
+    actual=$1
+    expected=$2
+    label=$3
+    cmp -s "$actual" "$expected" || {
+        echo "FAIL: $label" >&2
+        echo "actual bytes:" >&2
+        od -An -tx1 "$actual" >&2
+        echo "expected bytes:" >&2
+        od -An -tx1 "$expected" >&2
+        exit 1
+    }
+}
+
+assert_empty() {
+    file=$1
+    label=$2
+    [ ! -s "$file" ] || fail "$label: $(cat "$file")"
+}
+
+
+
+
+"$BIN" --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_empty err "F1 unexpected stderr"
+
+grep -Eiq -- "usage" out || fail "F1 missing usage"
+grep -Fq -- "ftfy" out || fail "F1 missing command name"
+grep -Fq -- "filename" out || fail "F1 missing filename argument"
+grep -Fq -- "-o" out || fail "F1 missing short output flag"
+grep -Fq -- "--output" out || fail "F1 missing long output flag"
+grep -Fq -- "-g" out || fail "F1 missing short guess flag"
+grep -Fq -- "--guess" out || fail "F1 missing long guess flag"
+grep -Fq -- "-e" out || fail "F1 missing short encoding flag"
+grep -Fq -- "--encoding" out || fail "F1 missing long encoding flag"
+grep -Fq -- "-n" out || fail "F1 missing short normalization flag"
+grep -Fq -- "--normalization" out || fail "F1 missing long normalization flag"
+grep -Fq -- "--preserve-entities" out || fail "F1 missing preserve-entities flag"
+
+
+
+
+printf '\303\242\305\223\342\200\235 No problems\n' >input.txt
+"$BIN" input.txt >out 2>err; ec=$?
+printf '\342\234\224 No problems\n' >expected
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_file_eq out expected "F2 stdout"
+assert_empty err "F2 unexpected stderr"
+
+
+
+
+"$BIN" -o fixed.txt input.txt >out 2>err; ec=$?
+printf '\342\234\224 No problems\n' >expected
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+assert_empty out "F3 unexpected stdout"
+assert_empty err "F3 unexpected stderr"
+assert_file_eq fixed.txt expected "F3 fixed file"
+
+
+
+
+"$BIN" <input.txt >out 2>err; ec=$?
+printf '\342\234\224 No problems\n' >expected
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+assert_file_eq out expected "F4 stdout"
+assert_empty err "F4 unexpected stderr"
+
+
+
+
+"$BIN" - -o - <input.txt >out 2>err; ec=$?
+printf '\342\234\224 No problems\n' >expected
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+assert_file_eq out expected "F5 stdout"
+assert_empty err "F5 unexpected stderr"
+
+
+
+
+printf '\342\234\224 No problems\n' >rawcheck.txt
+"$BIN" -e windows-1252 rawcheck.txt >out 2>err; ec=$?
+printf '\342\234\224 No problems\n' >expected
+[ "$ec" -eq 0 ] || fail "F6 exit $ec; want 0"
+assert_file_eq out expected "F6 stdout"
+assert_empty err "F6 unexpected stderr"
+
+
+
+
+"$BIN" -g -e ascii rawcheck.txt >out 2>err; ec=$?
+printf '\342\234\224 No problems\n' >expected
+[ "$ec" -eq 0 ] || fail "F7 exit $ec; want 0"
+assert_file_eq out expected "F7 stdout"
+assert_empty err "F7 unexpected stderr"
+
+
+
+
+printf 'AT&amp;T\n' >entity.txt
+"$BIN" entity.txt >out 2>err; ec=$?
+printf 'AT&T\n' >expected
+[ "$ec" -eq 0 ] || fail "F8 exit $ec; want 0"
+assert_file_eq out expected "F8 stdout"
+assert_empty err "F8 unexpected stderr"
+
+
+
+
+"$BIN" --preserve-entities entity.txt >out 2>err; ec=$?
+printf 'AT&amp;T\n' >expected
+[ "$ec" -eq 0 ] || fail "F9 exit $ec; want 0"
+assert_file_eq out expected "F9 stdout"
+assert_empty err "F9 unexpected stderr"
+
+
+
+
+printf 'e\314\201\n' >decomposed.txt
+"$BIN" -n none decomposed.txt >out 2>err; ec=$?
+printf 'e\314\201\n' >expected
+[ "$ec" -eq 0 ] || fail "F10 exit $ec; want 0"
+assert_file_eq out expected "F10 stdout"
+assert_empty err "F10 unexpected stderr"
+
+
+
+
+printf '\302\265\n' >micro.txt
+"$BIN" -n NFKC micro.txt >out 2>err; ec=$?
+printf '\316\274\n' >expected
+[ "$ec" -eq 0 ] || fail "F11 exit $ec; want 0"
+assert_file_eq out expected "F11 stdout"
+assert_empty err "F11 unexpected stderr"
+
+
+
+
+"$BIN" -o input.txt input.txt >out 2>err; ec=$?
+[ "$ec" -eq 1 ] || fail "F12 exit $ec; want 1"
+assert_empty out "F12 unexpected stdout"
+
+grep -q '^ftfy error:' err || fail "F12 stderr missing ftfy error prefix: $(cat err)"
+
+
+
+
+printf '\201\n' >bad.bin
+"$BIN" -e windows-1252 bad.bin >out 2>err; ec=$?
+[ "$ec" -eq 1 ] || fail "F13 exit $ec; want 1"
+assert_empty out "F13 unexpected stdout"
+
+grep -Fq -- "windows-1252" err || fail "F13 stderr missing encoding: $(cat err)"
+grep -Eiq -- "decod(e|ed|ing)" err || fail "F13 stderr missing decode explanation: $(cat err)"
+grep -Fq -- "0x81" err || fail "F13 stderr missing underlying decode exception byte: $(cat err)"
+grep -Fq -- "ftfy -g" err || fail "F13 stderr missing guess guidance: $(cat err)"
+grep -Fq -- "ftfy -e latin-1" err || fail "F13 stderr missing latin-1 guidance: $(cat err)"
+
+
+
+
+PYTHONIOENCODING=ascii "$BIN" input.txt >out 2>err; ec=$?
+[ "$ec" -eq 1 ] || fail "F14 exit $ec; want 1"
+assert_empty out "F14 unexpected stdout"
+
+grep -q '^ftfy error:' err || fail "F14 stderr missing ftfy error prefix: $(cat err)"
+grep -Fq -- "Unicode" err || fail "F14 stderr missing Unicode support explanation: $(cat err)"
+grep -Fq -- "locale" err || fail "F14 stderr missing Unix locale guidance: $(cat err)"
+grep -Fq -- "UTF-8" err || fail "F14 stderr missing UTF-8 locale guidance: $(cat err)"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+export PIP_DISABLE_PIP_VERSION_CHECK=1
+export PIP_NO_INDEX=1
+export PIP_FIND_LINKS=/opt/stage4a_wheelhouse
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
