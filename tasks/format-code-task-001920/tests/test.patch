+import {
+  Provide,
+  Controller,
+  Get,
+  Post,
+  Query,
+  HttpCode,
+} from '@midwayjs/decorator';
+
+@Provide()
+@Controller('/api')
+export class APIController {
+  @Get('/')
+  async home() {
+    return 'home';
+  }
+
+  @Get('/api_data', { routerName: 'apiData' })
+  async apiData(@Query('name') name: string) {
+    return name;
+  }
+
+  @Post('/data/detail', { description: 'detail desc', summary: 'detail sum' })
+  @HttpCode(201)
+  async detail() {
+    return 'detail';
+  }
+}
