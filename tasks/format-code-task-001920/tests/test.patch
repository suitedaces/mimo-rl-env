+import * as assert from 'assert';
+import { join } from 'path';
+import {
+  WebRouterCollector,
+  clearAllModule,
+  clearContainerCache,
+} from '../src';
+
+const baseDir = join(__dirname, './fixtures/base-app-controller/src');
+
+describe('/test/webRouterCollector.test.ts', () => {
+  let routerTable: Map<string, any[]>;
+  let flatten: any[];
+  let priorityList: any[];
+
+  beforeAll(async () => {
+    clearAllModule();
+    clearContainerCache();
+    const collector = new WebRouterCollector(baseDir);
+    routerTable = await collector.getRouterTable();
+    flatten = await collector.getFlattenRouterTable();
+    priorityList = await collector.getRoutePriorityList();
+  });
+
+  it('should group routes into a Map keyed by controller prefix', () => {
+    assert(routerTable instanceof Map);
+    const keys = [...routerTable.keys()].sort();
+    assert.deepStrictEqual(keys, ['/', '/api', '/user']);
+
+    assert.strictEqual(routerTable.get('/api').length, 3);
+    assert.strictEqual(routerTable.get('/user').length, 1);
+    assert.strictEqual(routerTable.get('/').length, 1);
+  });
+
+  it('should expose the documented fields for each collected route', () => {
+    const detail = routerTable
+      .get('/api')
+      .find(route => route.method === 'detail');
+
+    assert.strictEqual(detail.prefix, '/api');
+    assert.strictEqual(detail.url, '/data/detail');
+    assert.strictEqual(detail.requestMethod, 'post');
+    assert.strictEqual(detail.method, 'detail');
+    assert.strictEqual(detail.description, 'detail desc');
+    assert.strictEqual(detail.summary, 'detail sum');
+    assert.strictEqual(typeof detail.controllerId, 'string');
+    assert(detail.controllerId.length > 0);
+
+    assert.strictEqual(detail.handlerName, `${detail.controllerId}.detail`);
+  });
+
+  it('should default routerName/description/summary to empty strings', () => {
+    const home = routerTable
+      .get('/api')
+      .find(route => route.method === 'home');
+    assert.strictEqual(home.routerName, '');
+    assert.strictEqual(home.description, '');
+    assert.strictEqual(home.summary, '');
+  });
+
+  it('should keep the explicit routerName when provided', () => {
+    const apiData = routerTable
+      .get('/api')
+      .find(route => route.method === 'apiData');
+    assert.strictEqual(apiData.routerName, 'apiData');
+  });
+
+  it('should capture request parameter metadata for route arguments', () => {
+    const apiData = routerTable
+      .get('/api')
+      .find(route => route.method === 'apiData');
+    const home = routerTable
+      .get('/api')
+      .find(route => route.method === 'home');
+
+    assert(Array.isArray(apiData.requestMetadata));
+    assert(apiData.requestMetadata.length > 0);
+
+
+    assert(Array.isArray(home.requestMetadata));
+    assert.strictEqual(home.requestMetadata.length, 0);
+  });
+
+  it('should capture response metadata declared by response decorators', () => {
+    const detail = routerTable
+      .get('/api')
+      .find(route => route.method === 'detail');
+    const home = routerTable
+      .get('/api')
+      .find(route => route.method === 'home');
+
+    assert(Array.isArray(detail.responseMetadata));
+    assert(detail.responseMetadata.length > 0);
+
+    assert(Array.isArray(home.responseMetadata));
+    assert.strictEqual(home.responseMetadata.length, 0);
+  });
+
+  it('should sort routes inside a prefix by path specificity', () => {
+    const urls = routerTable.get('/api').map(route => route.url);
+
+    assert.deepStrictEqual(urls, ['/data/detail', '/api_data', '/']);
+  });
+
+  it('should flatten every route into a single list', () => {
+    assert(Array.isArray(flatten));
+    assert.strictEqual(flatten.length, 5);
+
+    const expected = [];
+    for (const routes of routerTable.values()) {
+      for (const route of routes) {
+        expected.push(route.handlerName);
+      }
+    }
+    const flattenHandlers = flatten.map(route => route.handlerName).sort();
+    assert.deepStrictEqual(flattenHandlers, expected.sort());
+  });
+
+  it('should order the prefix priority list from high to low priority', () => {
+    const prefixes = priorityList.map(item => item.prefix);
+    assert.deepStrictEqual(prefixes.slice().sort(), ['/', '/api', '/user']);
+
+
+    for (let i = 1; i < priorityList.length; i++) {
+      assert(priorityList[i - 1].priority >= priorityList[i].priority);
+    }
+
+    const byPrefix = name =>
+      priorityList.find(item => item.prefix === name);
+
+
+    assert(byPrefix('/user').priority > byPrefix('/api').priority);
+
+    assert(byPrefix('/').priority < byPrefix('/api').priority);
+
+    assert.strictEqual(priorityList[priorityList.length - 1].prefix, '/');
+
+    assert.strictEqual(typeof byPrefix('/api').controllerId, 'string');
+  });
+});
