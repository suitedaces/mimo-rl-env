+// @vitest-environment jsdom
+
+import React, { type ReactNode } from 'react';
+import { execFileSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, describe, expect, test, vi } from 'vitest';
+import { cleanup, renderHook, waitFor } from '@testing-library/react';
+import { QueryClient, QueryClientProvider, type UseQueryOptions, type UseQueryResult } from '@tanstack/react-query';
+
+import {
+    useGitHubAutomatedRepos as useRootGitHubAutomatedRepos,
+    type IGitHubRepos as RootGitHubRepos,
+} from '../src/index';
+import {
+    useGitHubAutomatedRepos as useReactQueryGitHubAutomatedRepos,
+    type IGitHubRepos as ReactQueryGitHubRepos,
+} from '../src/react-query';
+
+type RootHookState = {
+    data: RootGitHubRepos[] | undefined;
+    isLoading: boolean;
+    error: { name: string; message: string } | null;
+};
+
+type QueryHookState = {
+    data: ReactQueryGitHubRepos[] | undefined;
+    status: string;
+    fetchStatus: string;
+    isPending: boolean;
+    isLoading: boolean;
+    isFetching: boolean;
+    error: { name: string; message: string } | null;
+};
+
+type RootSignature = typeof useRootGitHubAutomatedRepos extends (
+    gitHubUsername: string,
+    keyWord: string
+) => { data: RootGitHubRepos[] | undefined; isLoading: boolean; error: Error | null }
+    ? true
+    : never;
+
+type ReactQuerySignature = typeof useReactQueryGitHubAutomatedRepos extends (
+    gitHubUsername: string,
+    keyWord: string,
+    options?: Omit<
+        UseQueryOptions<ReactQueryGitHubRepos[], Error, ReactQueryGitHubRepos[], [string, string, string]>,
+        'queryKey' | 'queryFn'
+    >
+) => UseQueryResult<ReactQueryGitHubRepos[], Error>
+    ? true
+    : never;
+
+const rootSignatureCheck: RootSignature = true;
+const reactQuerySignatureCheck: ReactQuerySignature = true;
+
+const rootTypeFixture: RootGitHubRepos = {
+    name: 'portfolio-site',
+    topics: ['portfolio', 'react'],
+    html_url: 'https://github.com/octocat/portfolio-site',
+    description: 'Portfolio',
+    id: 1,
+    homepage: 'https://octocat.example',
+    banner: ['https://raw.example/banner.png'],
+};
+
+const reactQueryTypeFixture: ReactQueryGitHubRepos = {
+    name: 'attached-tool',
+    topics: ['attached', 'typescript'],
+    html_url: 'https://github.com/octocat/attached-tool',
+    description: 'Attached tool',
+    id: 2,
+    homepage: 'https://attached.example',
+    banner: ['https://raw.example/hero-banner.svg'],
+};
+
+void rootSignatureCheck;
+void reactQuerySignatureCheck;
+void rootTypeFixture;
+void reactQueryTypeFixture;
+
+const GITHUB_REPOS_API = [
+    {
+        id: 1,
+        name: 'portfolio-site',
+        topics: ['portfolio', 'react'],
+        html_url: 'https://github.com/octocat/portfolio-site',
+        description: 'Portfolio',
+        homepage: 'https://octocat.example',
+    },
+    {
+        id: 2,
+        name: 'attached-tool',
+        topics: ['attached', 'typescript'],
+        html_url: 'https://github.com/octocat/attached-tool',
+        description: 'Attached tool',
+        homepage: 'https://attached.example',
+    },
+];
+
+const PORTFOLIO_RESULT = [
+    {
+        id: 1,
+        name: 'portfolio-site',
+        html_url: 'https://github.com/octocat/portfolio-site',
+        description: 'Portfolio',
+        topics: ['portfolio', 'react'],
+        homepage: 'https://octocat.example',
+        banner: ['https://raw.example/banner.png'],
+    },
+];
+
+const ATTACHED_RESULT = [
+    {
+        id: 2,
+        name: 'attached-tool',
+        html_url: 'https://github.com/octocat/attached-tool',
+        description: 'Attached tool',
+        topics: ['attached', 'typescript'],
+        homepage: 'https://attached.example',
+        banner: ['https://raw.example/hero-banner.svg'],
+    },
+];
+
+const repositoryFeedResponse = () => {
+    const response = [...GITHUB_REPOS_API] as typeof GITHUB_REPOS_API & {
+        items: typeof GITHUB_REPOS_API;
+        total_count: number;
+    };
+    response.items = GITHUB_REPOS_API;
+    response.total_count = GITHUB_REPOS_API.length;
+    return response;
+};
+
+const expectRepositoryFeedStarted = (calls: string[], gitHubUsername: string): void => {
+
+    expect(calls.length).toBeGreaterThan(0);
+    expect(calls.some((url) => url.includes(gitHubUsername))).toBe(true);
+};
+
+const expectRepositoryFeedNotStarted = (calls: string[]): void => {
+    expect(calls).toEqual([]);
+};
+
+const requestUrl = (input: RequestInfo | URL): string => {
+
+    return input instanceof Request ? input.url : String(input);
+};
+
+const jsonResponse = (value: unknown): Response =>
+    ({
+        ok: true,
+        json: async () => value,
+    }) as Response;
+
+const installSuccessfulFetch = (): string[] => {
+    const calls: string[] = [];
+
+    vi.stubGlobal(
+        'fetch',
+        vi.fn(async (input: RequestInfo | URL): Promise<Response> => {
+            const url = requestUrl(input);
+            calls.push(url);
+
+
+            if (url.includes('portfolio-site')) {
+                return jsonResponse([{ name: 'banner.png', type: 'file', download_url: 'https://raw.example/banner.png' }]);
+            }
+
+            if (url.includes('attached-tool')) {
+                return jsonResponse([{ name: 'hero-banner.svg', type: 'file', download_url: 'https://raw.example/hero-banner.svg' }]);
+            }
+
+            if (url.includes('octocat')) {
+                return jsonResponse(repositoryFeedResponse());
+            }
+
+            throw new Error(`Unexpected fetch URL: ${url}`);
+        })
+    );
+
+    return calls;
+};
+
+const installRejectingFetch = (reason: unknown): string[] => {
+    const calls: string[] = [];
+
+    vi.stubGlobal(
+        'fetch',
+        vi.fn(async (input: RequestInfo | URL): Promise<Response> => {
+            calls.push(requestUrl(input));
+            throw reason;
+        })
+    );
+
+    return calls;
+};
+
+const snapshotRoot = (value: {
+    data: RootGitHubRepos[] | undefined;
+    isLoading: boolean;
+    error: Error | null;
+}): RootHookState => ({
+    data: value.data,
+    isLoading: value.isLoading,
+    error: value.error ? { name: value.error.name, message: value.error.message } : null,
+});
+
+const snapshotQuery = (value: UseQueryResult<ReactQueryGitHubRepos[], Error>): QueryHookState => ({
+    data: value.data,
+    status: value.status,
+    fetchStatus: value.fetchStatus,
+    isPending: value.isPending,
+    isLoading: value.isLoading,
+    isFetching: value.isFetching,
+    error: value.error ? { name: value.error.name, message: value.error.message } : null,
+});
+
+const renderRootUntilSettled = async (gitHubUsername: string, keyWord: string): Promise<RootHookState> => {
+    const { result } = renderHook(() => useRootGitHubAutomatedRepos(gitHubUsername, keyWord));
+    await waitFor(() => {
+        if (result.current.isLoading || !result.current.data) {
+            throw new Error('waiting for root hook data');
+        }
+    });
+    return snapshotRoot(result.current);
+};
+
+const createQueryClient = (): QueryClient =>
+    new QueryClient({
+        defaultOptions: {
+            queries: {
+                retry: false,
+                gcTime: 0,
+            },
+        },
+    });
+
+const withQueryClient =
+    (client: QueryClient) =>
+    ({ children }: { children: ReactNode }) =>
+        React.createElement(QueryClientProvider, { client }, children);
+
+afterEach(() => {
+    cleanup();
+    vi.unstubAllGlobals();
+    vi.restoreAllMocks();
+});
+
+describe('useGitHubAutomatedRepos public hook exports', () => {
+    test('root hook exposes initial, loading, and resolved repository states', async () => {
+
+
+
+
+        const calls = installSuccessfulFetch();
+        const seen: RootHookState[] = [];
+
+        const { result } = renderHook(() => {
+            const value = useRootGitHubAutomatedRepos('octocat', 'portfolio');
+            seen.push(snapshotRoot(value));
+            return value;
+        });
+
+        await waitFor(() => {
+            if (result.current.isLoading || !result.current.data) {
+                throw new Error('waiting for root hook data');
+            }
+        });
+
+
+        expect(seen[0]).toEqual({ data: undefined, isLoading: false, error: null });
+        expect(seen).toContainEqual({ data: undefined, isLoading: true, error: null });
+        expect(snapshotRoot(result.current)).toEqual({
+            data: PORTFOLIO_RESULT,
+            isLoading: false,
+            error: null,
+        });
+        expectRepositoryFeedStarted(calls, 'octocat');
+    });
+
+    test('root hook with empty username keeps idle state and does not fetch', async () => {
+
+
+
+
+        const calls = installSuccessfulFetch();
+        const seen: RootHookState[] = [];
+
+        const { result } = renderHook(() => {
+            const value = useRootGitHubAutomatedRepos('', 'portfolio');
+            seen.push(snapshotRoot(value));
+            return value;
+        });
+
+        await Promise.resolve();
+
+
+        expect(seen.every((state) => state.data === undefined && state.isLoading === false && state.error === null)).toBe(true);
+        expect(snapshotRoot(result.current)).toEqual({ data: undefined, isLoading: false, error: null });
+        expectRepositoryFeedNotStarted(calls);
+    });
+
+    test('root hook with empty keyword keeps idle state and does not fetch', async () => {
+
+
+
+
+        const calls = installSuccessfulFetch();
+        const seen: RootHookState[] = [];
+
+        const { result } = renderHook(() => {
+            const value = useRootGitHubAutomatedRepos('octocat', '');
+            seen.push(snapshotRoot(value));
+            return value;
+        });
+
+        await Promise.resolve();
+
+
+        expect(seen.every((state) => state.data === undefined && state.isLoading === false && state.error === null)).toBe(true);
+        expect(snapshotRoot(result.current)).toEqual({ data: undefined, isLoading: false, error: null });
+        expectRepositoryFeedNotStarted(calls);
+    });
+
+    test('root hook exposes a rejected Error value unchanged', async () => {
+
+
+
+
+        const calls = installRejectingFetch(new Error('feed exploded'));
+        const seen: RootHookState[] = [];
+
+        const { result } = renderHook(() => {
+            const value = useRootGitHubAutomatedRepos('octocat', 'portfolio');
+            seen.push(snapshotRoot(value));
+            return value;
+        });
+
+        await waitFor(() => {
+            if (result.current.isLoading || !result.current.error) {
+                throw new Error('waiting for root hook error');
+            }
+        });
+
+        expect(result.current.error).toBeInstanceOf(Error);
+
+        expect(seen[0]).toEqual({ data: undefined, isLoading: false, error: null });
+        expect(seen).toContainEqual({ data: undefined, isLoading: true, error: null });
+        expect(snapshotRoot(result.current)).toEqual({
+            data: undefined,
+            isLoading: false,
+            error: { name: 'Error', message: 'feed exploded' },
+        });
+        expectRepositoryFeedStarted(calls, 'octocat');
+    });
+
+    test('root hook converts a non-Error rejection to Unknown error occurred', async () => {
+
+
+
+
+        const calls = installRejectingFetch('plain rejection');
+
+        const { result } = renderHook(() => useRootGitHubAutomatedRepos('octocat', 'portfolio'));
+
+        await waitFor(() => {
+            if (result.current.isLoading || !result.current.error) {
+                throw new Error('waiting for root hook non-Error conversion');
+            }
+        });
+
+        expect(result.current.error).toBeInstanceOf(Error);
+        expect(snapshotRoot(result.current)).toEqual({
+            data: undefined,
+            isLoading: false,
+            error: { name: 'Error', message: 'Unknown error occurred' },
+        });
+        expectRepositoryFeedStarted(calls, 'octocat');
+    });
+
+    test('react-query hook uses the requested key, passes options, and returns portfolio data', async () => {
+
+
+
+
+        const calls = installSuccessfulFetch();
+        const client = createQueryClient();
+
+        const { result, unmount } = renderHook(
+            () =>
+                useReactQueryGitHubAutomatedRepos('octocat', 'portfolio', {
+                    staleTime: 600000,
+                    refetchInterval: false,
+                    refetchOnWindowFocus: false,
+                }),
+            { wrapper: withQueryClient(client) }
+        );
+
+        await waitFor(() => {
+            if (!result.current.data) {
+                throw new Error('waiting for react-query hook data');
+            }
+        });
+
+        expect(snapshotQuery(result.current)).toEqual({
+            data: PORTFOLIO_RESULT,
+            status: 'success',
+            fetchStatus: 'idle',
+            isPending: false,
+            isLoading: false,
+            isFetching: false,
+            error: null,
+        });
+        expect(client.getQueryData(['githubRepos', 'octocat', 'portfolio'])).toEqual(PORTFOLIO_RESULT);
+        const query = client.getQueryCache().find({ queryKey: ['githubRepos', 'octocat', 'portfolio'] });
+        const queryOptions = query?.options as
+            | UseQueryOptions<ReactQueryGitHubRepos[], Error, ReactQueryGitHubRepos[], [string, string, string]>
+            | undefined;
+        expect(queryOptions?.staleTime).toBe(600000);
+        expect(queryOptions?.refetchInterval).toBe(false);
+        expect(queryOptions?.refetchOnWindowFocus).toBe(false);
+        expectRepositoryFeedStarted(calls, 'octocat');
+
+        unmount();
+        client.clear();
+    });
+
+    test('react-query hook caches portfolio and attached keywords separately', async () => {
+
+
+
+
+        const calls = installSuccessfulFetch();
+        const client = createQueryClient();
+        const wrapper = withQueryClient(client);
+
+        const first = renderHook(
+            () =>
+                useReactQueryGitHubAutomatedRepos('octocat', 'portfolio', {
+                    staleTime: 600000,
+                    refetchInterval: false,
+                    refetchOnWindowFocus: false,
+                }),
+            { wrapper }
+        );
+
+        await waitFor(() => {
+            if (!first.result.current.data) {
+                throw new Error('waiting for portfolio data');
+            }
+        });
+        const second = renderHook(
+            () =>
+                useReactQueryGitHubAutomatedRepos('octocat', 'attached', {
+                    staleTime: 600000,
+                    refetchInterval: false,
+                    refetchOnWindowFocus: false,
+                }),
+            { wrapper }
+        );
+
+        await waitFor(() => {
+            if (!second.result.current.data) {
+                throw new Error('waiting for attached data');
+            }
+        });
+
+        expect(client.getQueryData(['githubRepos', 'octocat', 'portfolio'])).toEqual(PORTFOLIO_RESULT);
+        expect(client.getQueryData(['githubRepos', 'octocat', 'attached'])).toEqual(ATTACHED_RESULT);
+        expect(snapshotQuery(second.result.current)).toEqual({
+            data: ATTACHED_RESULT,
+            status: 'success',
+            fetchStatus: 'idle',
+            isPending: false,
+            isLoading: false,
+            isFetching: false,
+            error: null,
+        });
+        expectRepositoryFeedStarted(calls, 'octocat');
+
+        first.unmount();
+        second.unmount();
+        client.clear();
+    });
+
+    test('react-query enabled false leaves the request disabled', async () => {
+
+
+
+
+        const calls = installSuccessfulFetch();
+        const client = createQueryClient();
+
+        const { result, unmount } = renderHook(() => useReactQueryGitHubAutomatedRepos('octocat', 'portfolio', { enabled: false }), {
+            wrapper: withQueryClient(client),
+        });
+
+        await Promise.resolve();
+
+        expect(snapshotQuery(result.current)).toEqual({
+            data: undefined,
+            status: 'pending',
+            fetchStatus: 'idle',
+            isPending: true,
+            isLoading: false,
+            isFetching: false,
+            error: null,
+        });
+        expect(client.getQueryData(['githubRepos', 'octocat', 'portfolio'])).toBeUndefined();
+        expectRepositoryFeedNotStarted(calls);
+
+        unmount();
+        client.clear();
+    });
+});
+
+describe('Lib-Pure contract checks for the hook surfaces', () => {
+    test('referential transparency: repeated root calls with the same arguments settle to the same literal result', async () => {
+        installSuccessfulFetch();
+        const first = await renderRootUntilSettled('octocat', 'portfolio');
+        cleanup();
+
+        installSuccessfulFetch();
+        const second = await renderRootUntilSettled('octocat', 'portfolio');
+
+        expect(first).toEqual({
+            data: PORTFOLIO_RESULT,
+            isLoading: false,
+            error: null,
+        });
+        expect(second).toEqual(first);
+    });
+
+    test('passes caller-provided React Query options through', async () => {
+        const calls = installSuccessfulFetch();
+        const client = createQueryClient();
+        const options = {
+            staleTime: 600000,
+            refetchInterval: false,
+            refetchOnWindowFocus: false,
+            meta: { source: 'acceptance-test' },
+        } satisfies Omit<
+            UseQueryOptions<ReactQueryGitHubRepos[], Error, ReactQueryGitHubRepos[], [string, string, string]>,
+            'queryKey' | 'queryFn'
+        >;
+        const before = structuredClone(options);
+
+        const { result, unmount } = renderHook(() => useReactQueryGitHubAutomatedRepos('octocat', 'portfolio', options), {
+            wrapper: withQueryClient(client),
+        });
+
+        await waitFor(() => {
+            if (!result.current.data) {
+                throw new Error('waiting for react-query data');
+            }
+        });
+
+        const query = client.getQueryCache().find({ queryKey: ['githubRepos', 'octocat', 'portfolio'] });
+        const queryOptions = query?.options as
+            | UseQueryOptions<ReactQueryGitHubRepos[], Error, ReactQueryGitHubRepos[], [string, string, string]>
+            | undefined;
+
+        expect(queryOptions?.staleTime).toBe(before.staleTime);
+        expect(queryOptions?.refetchInterval).toBe(before.refetchInterval);
+        expect(queryOptions?.refetchOnWindowFocus).toBe(before.refetchOnWindowFocus);
+        expect(queryOptions?.meta).toEqual(before.meta);
+        expect(snapshotQuery(result.current).data).toEqual(PORTFOLIO_RESULT);
+        expectRepositoryFeedStarted(calls, 'octocat');
+
+        unmount();
+        client.clear();
+    });
+
+    test('no global state: root hook matches a fresh Node process for the same arguments', async () => {
+        installSuccessfulFetch();
+        const inProcess = await renderRootUntilSettled('octocat', 'portfolio');
+        const childScript = `
+            import { createRequire } from 'node:module';
+            import { JSDOM } from 'jsdom';
+            const require = createRequire(import.meta.url);
+            const dom = new JSDOM('<!doctype html><html><body></body></html>');
+            globalThis.window = dom.window;
+            globalThis.document = dom.window.document;
+            Object.defineProperty(globalThis, 'navigator', { value: dom.window.navigator, configurable: true });
+            globalThis.HTMLElement = dom.window.HTMLElement;
+            globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+            const { renderHook, waitFor, cleanup } = require('@testing-library/react');
+            const { useGitHubAutomatedRepos } = await import('/workspace/repo/src/index.ts');
+            const calls = [];
+            globalThis.fetch = async (input) => {
+                //
+                const url = input instanceof Request ? input.url : String(input);
+                calls.push(url);
+                //
+                if (url.includes('portfolio-site')) {
+                    return { ok: true, json: async () => [{ name: 'banner.png', type: 'file', download_url: 'https://raw.example/banner.png' }] };
+                }
+                if (url.includes('octocat')) {
+                    const repos = ${JSON.stringify(GITHUB_REPOS_API)};
+                    repos.items = repos;
+                    repos.total_count = repos.length;
+                    return { ok: true, json: async () => repos };
+                }
+                throw new Error('Unexpected fetch URL: ' + url);
+            };
+            const { result } = renderHook(() => useGitHubAutomatedRepos('octocat', 'portfolio'));
+            await waitFor(() => {
+                if (result.current.isLoading || !result.current.data) {
+                    throw new Error('waiting for data');
+                }
+            });
+            const out = {
+                data: result.current.data,
+                isLoading: result.current.isLoading,
+                error: result.current.error ? { name: result.current.error.name, message: result.current.error.message } : null,
+                calls,
+            };
+            cleanup();
+            process.stdout.write(JSON.stringify(out));
+        `;
+
+        const child = JSON.parse(
+            execFileSync(process.execPath, ['--import', 'tsx', '--input-type=module', '-e', childScript], {
+                cwd: '/workspace/repo',
+                encoding: 'utf8',
+            })
+        ) as RootHookState & { calls: string[] };
+
+        expect(inProcess).toEqual({
+            data: PORTFOLIO_RESULT,
+            isLoading: false,
+            error: null,
+        });
+        expect(child).toEqual({
+            data: PORTFOLIO_RESULT,
+            isLoading: false,
+            error: null,
+            calls: expect.any(Array),
+        });
+        expectRepositoryFeedStarted(child.calls, 'octocat');
+    });
+
+    test('root hook returns the same observable data from a different cwd', async () => {
+        const originalCwd = process.cwd();
+        const temporaryCwd = mkdtempSync(join(tmpdir(), 'github-automated-repos-fixture-'));
+
+        try {
+            process.chdir(temporaryCwd);
+            const calls = installSuccessfulFetch();
+            const state = await renderRootUntilSettled('octocat', 'portfolio');
+
+            expect(state).toEqual({
+                data: PORTFOLIO_RESULT,
+                isLoading: false,
+                error: null,
+            });
+
+            expectRepositoryFeedStarted(calls, 'octocat');
+        } finally {
+            process.chdir(originalCwd);
+            rmSync(temporaryCwd, { recursive: true, force: true });
+        }
+    });
+});
