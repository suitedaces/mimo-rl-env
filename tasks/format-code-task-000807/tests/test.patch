+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+set -e
+cd /workspace/repo
+set -euo pipefail
+
+cd /workspace/repo
+
+export PATH="/workspace/repo/node_modules/.bin:${PATH}"
+export npm_config_offline=true
+export npm_config_audit=false
+export npm_config_fund=false
+export npm_config_update_notifier=false
+
+for required_bin in ./node_modules/.bin/tsc ./node_modules/.bin/vitest ./node_modules/.bin/tsx; do
+    if [[ ! -x "${required_bin}" ]]; then
+        echo "Missing offline test dependency: ${required_bin}" >&2
+        exit 127
+    fi
+done
+
+./node_modules/.bin/tsc --noEmit \
+    --strict \
+    --jsx react \
+    --esModuleInterop \
+    --module esnext \
+    --moduleResolution node \
+    --target es2017 \
+    --lib es6,dom,es2017 \
+    --types vitest,node \
+    --skipLibCheck \
