@@ -672,3 +672,108 @@ tester.run('no-ref-as-operand', rule, {
     }
   ]
 })
+
+
+
+const tsTester = new RuleTester({
+  parser: require.resolve('vue-eslint-parser'),
+  parserOptions: {
+    ecmaVersion: 2020,
+    sourceType: 'module',
+    parser: require.resolve('@typescript-eslint/parser')
+  }
+})
+
+tsTester.run('no-ref-as-operand (ts/no-init)', rule, {
+  valid: [
+
+
+    {
+      filename: 'test.ts',
+      code: `
+      import { ref, Ref } from 'vue'
+      let foo: Ref<number> | undefined;
+      if (!foo) {
+        foo = ref(5);
+      }
+      `
+    },
+
+
+    {
+      filename: 'test.js',
+      code: `
+      import { ref } from 'vue'
+      let foo;
+      if (!foo) {
+        foo = ref(5);
+      }
+      `
+    }
+  ],
+  invalid: [
+
+
+
+    {
+      filename: 'test.js',
+      code: `
+      import { ref } from 'vue'
+      let count = ref(0)
+      count++
+      `,
+      output: `
+      import { ref } from 'vue'
+      let count = ref(0)
+      count.value++
+      `,
+      errors: [
+        {
+          messageId: 'requireDotValue',
+          line: 4
+        }
+      ]
+    },
+
+    {
+      filename: 'test.js',
+      code: `
+      import { ref } from 'vue'
+      const foo = ref(0)
+      if (foo) {}
+      `,
+      output: `
+      import { ref } from 'vue'
+      const foo = ref(0)
+      if (foo.value) {}
+      `,
+      errors: [
+        {
+          messageId: 'requireDotValue',
+          line: 4
+        }
+      ]
+    },
+
+
+    {
+      filename: 'test.ts',
+      code: `
+      import { ref, Ref } from 'vue'
+      let foo: Ref<number> = ref(0)
+      foo++
+      `,
+      output: `
+      import { ref, Ref } from 'vue'
+      let foo: Ref<number> = ref(0)
+      foo.value++
+      `,
+      errors: [
+        {
+          messageId: 'requireDotValue',
+          line: 4
+        }
+      ]
+    }
+  ]
+})
