diff --git a/test/python/pulse/test_transforms.py b/test/python/pulse/test_transforms.py
index d803aee0d..039f000a5 100644
--- a/test/python/pulse/test_transforms.py
+++ b/test/python/pulse/test_transforms.py
@@ -695,6 +695,67 @@ class TestAlignEquispaced(QiskitTestCase):
 
         self.assertEqual(sched, reference)
 
+    def test_equispaced_multi_channel_longer_duration(self):
+        """Children on different channels with requested duration > sum of child durations.
+        Bug: schedule.duration is the per-channel max so total interval was overestimated,
+        causing the result duration to exceed the requested duration."""
+        d0 = pulse.DriveChannel(0)
+        d1 = pulse.DriveChannel(1)
+
+        sched = pulse.Schedule()
+        sched.insert(0, Delay(20, d0), inplace=True)
+        sched.insert(0, Delay(10, d1), inplace=True)
+
+
+        result = transforms.align_equispaced(sched, duration=60)
+
+
+        self.assertEqual(result.duration, 60)
+
+
+        instr_times = sorted([(t, inst.duration, inst.channels[0])
+                              for t, inst in result.instructions])
+        self.assertIn((0, 20, d0), instr_times)
+        self.assertIn((50, 10, d1), instr_times)
+
+    def test_equispaced_multi_channel_issue_reproduction(self):
+        """Issue's exact case: requested duration sits between schedule.duration and
+        sum of children. Reference returns the input schedule unchanged because the
+        request can't accommodate sequential layout of all children."""
+        d0 = pulse.DriveChannel(0)
+        d1 = pulse.DriveChannel(1)
+
+        sched = pulse.Schedule()
+        sched.insert(0, Play(GaussianSquare(duration=600, amp=.5, sigma=30, width=400),
+                             d0), inplace=True)
+        sched.insert(0, Play(GaussianSquare(duration=300, amp=.5, sigma=30, width=100),
+                             d1), inplace=True)
+
+
+        result = transforms.align_equispaced(sched, duration=800)
+
+
+
+        self.assertNotEqual(result.duration, 1100)
+        self.assertLessEqual(result.duration, 800)
+        self.assertEqual(result.duration, 600)
+
+    def test_equispaced_multi_channel_in_between(self):
+        """Requested duration > schedule.duration but < sum of children. Reference treats
+        this as 'too short' and returns the schedule unchanged."""
+        d0 = pulse.DriveChannel(0)
+        d1 = pulse.DriveChannel(1)
+
+        sched = pulse.Schedule()
+        sched.insert(0, Delay(20, d0), inplace=True)
+        sched.insert(0, Delay(10, d1), inplace=True)
+
+
+        result = transforms.align_equispaced(sched, duration=25)
+
+
+        self.assertEqual(result.duration, 20)
+
 
 class TestAlignFunc(QiskitTestCase):
