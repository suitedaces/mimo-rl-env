+function createFormEchoServer () {
+  return new Promise((resolve) => {
+    const server = http.createServer((req, res) => {
+      const chunks = []
+
+      req.on('data', (chunk) => {
+        chunks.push(chunk)
+      })
+
+      req.on('end', () => {
+        res.setHeader('content-type', 'application/json')
+        res.end(JSON.stringify({
+          method: req.method,
+          headers: req.headers,
+          body: Buffer.concat(chunks).toString('utf8')
+        }))
+      })
+    })
+
+    server.listen(0, 'localhost', () => {
+      const { port } = server.address()
+      resolve({
+        url: `http://localhost:${port}/`,
+        close: () => new Promise((resolveClose) => server.close(resolveClose))
+      })
+    })
+  })
+}
+
+function getMultipartBoundary (contentType) {
+  const match = /(?:^|;\s*)boundary=([^;]+)/i.exec(contentType || '')
+  return match && match[1]
+}
+
+function getMultipartParts (rawBody, boundary) {
+  return rawBody
+    .split(`--${boundary}`)
+    .slice(1, -1)
+    .map((section) => {
+      const trimmed = section
+        .replace(/^\r\n/, '')
+        .replace(/\r\n$/, '')
+      const separator = trimmed.indexOf('\r\n\r\n')
+
+      expect(separator).to.be.greaterThan(-1)
+
+      const rawHeaders = trimmed.slice(0, separator)
+      const body = trimmed.slice(separator + 4)
+      const headers = {}
+
+      for (const line of rawHeaders.split('\r\n')) {
+        const idx = line.indexOf(':')
+        expect(idx).to.be.greaterThan(-1)
+        headers[line.slice(0, idx).toLowerCase()] = line.slice(idx + 1).trim()
+      }
+
+      return { headers, body }
+    })
+}
+
+function findMultipartPart (parts, name) {
+  return parts.find((part) => {
+    const disposition = part.headers['content-disposition'] || ''
+    return new RegExp(`(?:^|;\\s*)name="${name}"(?:;|$)`).test(disposition)
+  })
+}
+
