+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+if [ ! -d node_modules/chai ] || [ ! -d node_modules/mocha ]; then
+  npm install --no-audit --no-fund --ignore-scripts
+fi
+
+
+BASE_GREP='should allow POST request with object body|constructing a Response with URLSearchParams as body should have a Content-Type|constructing a Request with URLSearchParams as body should have a Content-Type|Reading a body with URLSearchParams should echo back the result|constructing a Request/Response with URLSearchParams and mutating it should not affected body|should allow POST request with URLSearchParams as body|should still recognize URLSearchParams when extended'
+NEW_GREP='should expose constructable FormData and File from undici|should allow POST request with form-data as body|should send file entries in multipart FormData bodies|should parse urlencoded response bodies with formData|should parse urlencoded request bodies with formData|should reject multipart formData parsing with a clear unsupported error'
+
+case "${1:-}" in
+  base)
+    npx mocha test/node-fetch/main.js --exit --timeout 30000 --grep "$BASE_GREP"
+    ;;
+  new)
+    npx mocha test/node-fetch/main.js --exit --timeout 30000 --grep "$NEW_GREP"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
