diff --git a/internal/configs/configmaps_test.go b/internal/configs/configmaps_test.go
index 3a1c43d8d..8532dd7bf 100644
--- a/internal/configs/configmaps_test.go
+++ b/internal/configs/configmaps_test.go
@@ -1166,3 +1166,95 @@ func TestParseZoneSyncResolverIPV6MapResolverIPV6(t *testing.T) {
 func makeEventLogger() record.EventRecorder {
 	return record.NewFakeRecorder(1024)
 }
+
+func TestParseConfigMapOpenTracingDisabledClearsTracerSettings(t *testing.T) {
+	t.Parallel()
+	cm := &v1.ConfigMap{
+		Data: map[string]string{
+			"opentracing":               "False",
+			"opentracing-tracer":        "/usr/local/lib/libzipkin_opentracing_plugin.so",
+			"opentracing-tracer-config": `{"collector_host":null,"sample_rate":1,"service_name":"nginx-ingress"}`,
+		},
+	}
+	result, _ := ParseConfigMap(context.Background(), cm, true, false, false, false, makeEventLogger())
+	if result.MainOpenTracingEnabled {
+		t.Errorf("MainOpenTracingEnabled: want false, got true")
+	}
+	mainCfg := GenerateNginxMainConfig(&StaticConfigParams{}, result, nil)
+	if mainCfg.OpenTracingEnabled {
+		t.Errorf("MainConfig.OpenTracingEnabled: want false, got true (opentracing should be disabled)")
+	}
+	if mainCfg.OpenTracingLoadModule {
+		t.Errorf("MainConfig.OpenTracingLoadModule: want false, got true (load_module directive would be emitted, causing nginx crash)")
+	}
+}
+
+func TestParseConfigMapOpenTracingEnabledWithTracer(t *testing.T) {
+	t.Parallel()
+	tracer := "/usr/local/lib/libzipkin_opentracing_plugin.so"
+	tracerCfg := `{"collector_host":"jaeger","sample_rate":1,"service_name":"nginx-ingress"}`
+	cm := &v1.ConfigMap{
+		Data: map[string]string{
+			"opentracing":               "True",
+			"opentracing-tracer":        tracer,
+			"opentracing-tracer-config": tracerCfg,
+		},
+	}
+	result, configOk := ParseConfigMap(context.Background(), cm, true, false, false, false, makeEventLogger())
+	if !configOk {
+		t.Errorf("configOk: want true, got false")
+	}
+	if !result.MainOpenTracingEnabled {
+		t.Errorf("MainOpenTracingEnabled: want true, got false")
+	}
+	if !result.MainOpenTracingLoadModule {
+		t.Errorf("MainOpenTracingLoadModule: want true, got false")
+	}
+	if result.MainOpenTracingTracer != tracer {
+		t.Errorf("MainOpenTracingTracer: want %q, got %q", tracer, result.MainOpenTracingTracer)
+	}
+	if result.MainOpenTracingTracerConfig != tracerCfg {
+		t.Errorf("MainOpenTracingTracerConfig: want %q, got %q", tracerCfg, result.MainOpenTracingTracerConfig)
+	}
+}
+
+func TestParseConfigMapOpenTracingNoKeyWithTracer(t *testing.T) {
+	t.Parallel()
+	tracer := "/usr/local/lib/libzipkin_opentracing_plugin.so"
+	tracerCfg := `{"collector_host":"jaeger","sample_rate":1,"service_name":"nginx-ingress"}`
+	cm := &v1.ConfigMap{
+		Data: map[string]string{
+			"opentracing-tracer":        tracer,
+			"opentracing-tracer-config": tracerCfg,
+		},
+	}
+	result, configOk := ParseConfigMap(context.Background(), cm, true, false, false, false, makeEventLogger())
+	if !configOk {
+		t.Errorf("configOk: want true, got false")
+	}
+	if result.MainOpenTracingEnabled {
+		t.Errorf("MainOpenTracingEnabled: want false (default when no opentracing key), got true")
+	}
+	if !result.MainOpenTracingLoadModule {
+		t.Errorf("MainOpenTracingLoadModule: want true, got false")
+	}
+	if result.MainOpenTracingTracer != tracer {
+		t.Errorf("MainOpenTracingTracer: want %q, got %q", tracer, result.MainOpenTracingTracer)
+	}
+	if result.MainOpenTracingTracerConfig != tracerCfg {
+		t.Errorf("MainOpenTracingTracerConfig: want %q, got %q", tracerCfg, result.MainOpenTracingTracerConfig)
+	}
+}
+
+func TestParseConfigMapOpenTracingEnabledWithoutTracerErrors(t *testing.T) {
+	t.Parallel()
+	cm := &v1.ConfigMap{
+		Data: map[string]string{
+			"opentracing": "True",
+		},
+	}
+	_, configOk := ParseConfigMap(context.Background(), cm, true, false, false, false, makeEventLogger())
+	if configOk {
+		t.Errorf("configOk: want false (opentracing requires tracer & tracer-config), got true")
+	}
+}
