diff --git a/usercase-test-coderl/spritemap.test.js b/usercase-test-coderl/spritemap.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/spritemap.test.js
@@ -0,0 +1,324 @@
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+
+
+
+
+
+
+
+
+
+function loadIioInBrowserVm() {
+  let imageCount = 0;
+  const context = {
+    console,
+    setTimeout,
+    clearTimeout,
+    window: {
+      addEventListener() {},
+      attachEvent() {},
+      setTimeout,
+      clearTimeout,
+    },
+    document: {},
+  };
+
+  context.global = context;
+  context.Image = class FakeImage {
+    constructor() {
+      this.id = ++imageCount;
+      this.src = '';
+      this.onload = null;
+    }
+  };
+  context.__imageCount = () => imageCount;
+
+  vm.createContext(context);
+  [
+    'src/core/core.js',
+    'src/core/Interface.js',
+    'src/libs/key.js',
+    'src/libs/convert.js',
+    'src/data/Vector.js',
+    'src/data/SpriteMap.js',
+  ].forEach((file) => {
+    const source = fs.readFileSync(path.join('/workspace/repo', file), 'utf8');
+    vm.runInContext(source, context, { filename: file });
+  });
+
+  return context;
+}
+
+function runFixture(source) {
+  const context = loadIioInBrowserVm();
+  context.__result = undefined;
+  vm.runInContext(`
+    function __findSheetImage(map) {
+      var names = Object.getOwnPropertyNames(map);
+      for (var i = 0; i < names.length; i += 1) {
+        if (map[names[i]] instanceof Image) return map[names[i]];
+      }
+      return null;
+    }
+    __result = (function () { ${source} })();
+  `, context);
+  return JSON.parse(JSON.stringify(context.__result));
+}
+
+function test(name, fn) {
+  try {
+    fn();
+    console.log(`ok - ${name}`);
+  } catch (error) {
+    console.error(`not ok - ${name}`);
+    throw error;
+  }
+}
+
+test('constructor stores sheet image and invokes onLoad from the image', () => {
+
+
+
+
+  const actual = runFixture(`
+    var loadCount = 0;
+    var loadSrc = '';
+    var map = new iio.SpriteMap('assets/hero-sheet.png', function () {
+      loadCount += 1;
+      loadSrc = this.src;
+    });
+    var sheet = __findSheetImage(map);
+    var beforeLoad = {
+      hasExposedImage: sheet instanceof Image,
+      imgSrc: sheet && sheet.src,
+      onloadType: sheet && typeof sheet.onload
+    };
+    sheet.onload.call(sheet);
+    return {
+      beforeLoad: beforeLoad,
+      afterLoad: { loadCount: loadCount, loadSrc: loadSrc }
+    };
+  `);
+
+  assert.deepStrictEqual(actual, {
+    beforeLoad: {
+
+      hasExposedImage: true,
+      imgSrc: 'assets/hero-sheet.png',
+      onloadType: 'function',
+    },
+    afterLoad: {
+      loadCount: 1,
+      loadSrc: 'assets/hero-sheet.png',
+    },
+  });
+});
+
+test('sprite merges config objects and generates sequential frames', () => {
+
+
+
+
+  const actual = runFixture(`
+    var map = new iio.SpriteMap('assets/hero-sheet.png');
+    var sheet = __findSheetImage(map);
+    var walk = map.sprite(
+      { width: 16, height: 32 },
+      { name: 'walk', origin: [0, 64], numFrames: 3 }
+    );
+    return {
+      name: walk.name,
+      numFrames: walk.numFrames,
+      frames: walk.frames.map(function (frame) {
+        return {
+          x: frame.x,
+          y: frame.y,
+          w: frame.w,
+          h: frame.h,
+          usesMapImage: frame.src === sheet
+        };
+      })
+    };
+  `);
+
+  assert.deepStrictEqual(actual, {
+    name: 'walk',
+    numFrames: 3,
+    frames: [
+
+      { x: 0, y: 64, w: 16, h: 32, usesMapImage: true },
+      { x: 16, y: 64, w: 16, h: 32, usesMapImage: true },
+      { x: 32, y: 64, w: 16, h: 32, usesMapImage: true },
+    ],
+  });
+});
+
+test('sprite defaults omitted numFrames to one frame', () => {
+
+
+
+
+  const actual = runFixture(`
+    var map = new iio.SpriteMap('assets/hero-sheet.png');
+    var sheet = __findSheetImage(map);
+    var idle = map.sprite({ width: 8, height: 8, name: 'idle', origin: [24, 10] });
+    return {
+      name: idle.name,
+      numFrames: idle.numFrames,
+      frames: idle.frames.map(function (frame) {
+        return {
+          x: frame.x,
+          y: frame.y,
+          w: frame.w,
+          h: frame.h,
+          usesMapImage: frame.src === sheet
+        };
+      })
+    };
+  `);
+
+  assert.deepStrictEqual(actual, {
+    name: 'idle',
+    numFrames: 1,
+    frames: [
+
+      { x: 24, y: 10, w: 8, h: 8, usesMapImage: true },
+    ],
+  });
+});
+
+test('sprite uses explicit frames while completing only missing fields', () => {
+
+
+
+
+  const actual = runFixture(`
+    var map = new iio.SpriteMap('assets/hero-sheet.png');
+    var sheet = __findSheetImage(map);
+    var explicitSrc = { id: 999 };
+    var suppliedFrames = [
+      { x: 5, y: 6 },
+      { x: 7, y: 8, w: 9, h: 10, src: explicitSrc }
+    ];
+    var jump = map.sprite(
+      { width: 12, height: 14 },
+      { name: 'jump', frames: suppliedFrames }
+    );
+    return {
+      name: jump.name,
+      frameCount: jump.frames.length,
+      frames: jump.frames.map(function (frame) {
+        return {
+          x: frame.x,
+          y: frame.y,
+          w: frame.w,
+          h: frame.h,
+          usesMapImage: frame.src === sheet,
+          usesExplicitSrc: frame.src === explicitSrc
+        };
+      })
+    };
+  `);
+
+  assert.deepStrictEqual(actual, {
+    name: 'jump',
+
+    frameCount: 2,
+    frames: [
+
+      { x: 5, y: 6, w: 12, h: 14, usesMapImage: true, usesExplicitSrc: false },
+      { x: 7, y: 8, w: 9, h: 10, usesMapImage: false, usesExplicitSrc: true },
+    ],
+  });
+});
+
+test('two SpriteMap instances keep independent image state', () => {
+
+
+
+
+  const actual = runFixture(`
+    var a = new iio.SpriteMap('a.png');
+    var b = new iio.SpriteMap('b.png');
+    var aSheet = __findSheetImage(a);
+    var bSheet = __findSheetImage(b);
+    var aAnim = a.sprite({ width: 2, height: 3, name: 'a', origin: [4, 5] });
+    var bAnim = b.sprite({ width: 6, height: 7, name: 'b', origin: [8, 9] });
+    return {
+      aSrc: aSheet && aSheet.src,
+      bSrc: bSheet && bSheet.src,
+      differentImages: aSheet !== bSheet,
+      aFrame: {
+        x: aAnim.frames[0].x,
+        y: aAnim.frames[0].y,
+        w: aAnim.frames[0].w,
+        h: aAnim.frames[0].h,
+        usesOwnImage: aAnim.frames[0].src === aSheet,
+        usesOtherImage: aAnim.frames[0].src === bSheet
+      },
+      bFrame: {
+        x: bAnim.frames[0].x,
+        y: bAnim.frames[0].y,
+        w: bAnim.frames[0].w,
+        h: bAnim.frames[0].h,
+        usesOwnImage: bAnim.frames[0].src === bSheet,
+        usesOtherImage: bAnim.frames[0].src === aSheet
+      }
+    };
+  `);
+
+  assert.deepStrictEqual(actual, {
+
+    aSrc: 'a.png',
+    bSrc: 'b.png',
+    differentImages: true,
+    aFrame: { x: 4, y: 5, w: 2, h: 3, usesOwnImage: true, usesOtherImage: false },
+    bFrame: { x: 8, y: 9, w: 6, h: 7, usesOwnImage: true, usesOtherImage: false },
+  });
+});
+
+test('repeated construct and sprite cycles allocate one image per map only', () => {
+
+
+
+
+  const actual = runFixture(`
+    var lastFrame = null;
+    var allFramesUseMapImage = true;
+    for (var i = 0; i < 120; i += 1) {
+      var map = new iio.SpriteMap('sheet-' + i + '.png');
+      var sheet = __findSheetImage(map);
+      var anim = map.sprite({ width: 3, height: 4, name: 'cycle', origin: [i, 2] });
+      allFramesUseMapImage = allFramesUseMapImage && anim.frames[0].src === sheet;
+      lastFrame = {
+        x: anim.frames[0].x,
+        y: anim.frames[0].y,
+        w: anim.frames[0].w,
+        h: anim.frames[0].h,
+        src: anim.frames[0].src.src
+      };
+    }
+    return {
+      enoughImagesForConstructedMaps: __imageCount() >= 120,
+      allFramesUseMapImage: allFramesUseMapImage,
+      lastFrame: lastFrame
+    };
+  `);
+
+  assert.deepStrictEqual(actual, {
+
+    enoughImagesForConstructedMaps: true,
+    allFramesUseMapImage: true,
+    lastFrame: {
+      x: 119,
+      y: 2,
+      w: 3,
+      h: 4,
+      src: 'sheet-119.png',
+    },
+  });
+});
