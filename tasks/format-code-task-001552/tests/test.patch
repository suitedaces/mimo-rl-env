diff --git a/ibis/tests/expr/test_relocate.py b/ibis/tests/expr/test_relocate.py
index 6e34967a9..5485e8a90 100644
--- a/ibis/tests/expr/test_relocate.py
+++ b/ibis/tests/expr/test_relocate.py
@@ -86,3 +86,80 @@ def test_no_arguments():
     t = ibis.table(dict(x="int", y="int", z="int"))
     with pytest.raises(exc.IbisInputError, match="At least one selector"):
         assert t.relocate()
+
+
+def test_positional_string_before_selector_preserves_order():
+
+
+    t = ibis.table(
+        {
+            "species": "string",
+            "island": "string",
+            "bill_length_mm": "float",
+            "bill_depth_mm": "float",
+            "flipper_length_mm": "int",
+            "body_mass_g": "int",
+            "sex": "string",
+            "year": "int",
+        }
+    )
+    assert t.relocate("year", s.numeric()).columns == [
+        "year",
+        "bill_length_mm",
+        "bill_depth_mm",
+        "flipper_length_mm",
+        "body_mass_g",
+        "species",
+        "island",
+        "sex",
+    ]
+
+
+def test_positional_selector_before_string_preserves_order():
+
+
+
+    t = ibis.table(
+        {
+            "species": "string",
+            "island": "string",
+            "bill_length_mm": "float",
+            "bill_depth_mm": "float",
+            "flipper_length_mm": "int",
+            "body_mass_g": "int",
+            "sex": "string",
+            "year": "int",
+        }
+    )
+    assert t.relocate(s.numeric(), "year").columns == [
+        "bill_length_mm",
+        "bill_depth_mm",
+        "flipper_length_mm",
+        "body_mass_g",
+        "year",
+        "species",
+        "island",
+        "sex",
+    ]
+
+
+def test_positional_duplicate_first_occurrence_wins():
+
+
+    t = ibis.table(
+        dict(a="int", b="string", c="int", d="string")
+    )
+    assert t.relocate("b", s.of_type("string")).columns == ["b", "d", "a", "c"]
+
+
+def test_kwarg_duplicate_rename_last_wins():
+
+    t = ibis.table(dict(a="int", b="string", c="int", d="string"))
+    assert t.relocate(e="d", f="d").columns == ["f", "a", "b", "c"]
+
+
+def test_positional_then_kwarg_rename_of_same_column():
+
+
+    t = ibis.table(dict(x="int", y="int"))
+    assert t.relocate("x", z="x").columns == ["z", "y"]
