+package function
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/lf-edge/ekuiper/internal/conf"
+	kctx "github.com/lf-edge/ekuiper/internal/topo/context"
+	"github.com/lf-edge/ekuiper/internal/topo/state"
+	"github.com/lf-edge/ekuiper/pkg/api"
+)
+
+type namedFunctionExecutorForContextTest interface {
+
+	ExecWithName(args []interface{}, ctx api.FunctionContext, name string) (interface{}, bool)
+}
+
+func executeArrayFunctionForContextTest(t *testing.T, name string, args []interface{}) string {
+	t.Helper()
+
+	contextLogger := conf.Log.WithField("rule", "testExec")
+	ctx := kctx.WithValue(kctx.Background(), kctx.LoggerKey, contextLogger)
+	tempStore, _ := state.CreateStore("contextRule", api.AtMostOnce)
+	fctx := kctx.NewDefaultFuncContext(ctx.WithMeta("contextRule", "test", tempStore), 2)
+
+	fn, err := Function(name)
+	if err != nil {
+		t.Fatalf("Function(%q) returned error: %v", name, err)
+	}
+	named, ok := fn.(namedFunctionExecutorForContextTest)
+	if !ok {
+		t.Fatalf("Function(%q) does not support named execution", name)
+	}
+	result, ok := named.ExecWithName(args, fctx, name)
+	if ok {
+		t.Fatalf("%s(%v) succeeded with result %#v; want validation error", name, args, result)
+	}
+	errResult, ok := result.(error)
+	if !ok {
+		t.Fatalf("%s(%v) returned %#v; want error result", name, args, result)
+	}
+	return errResult.Error()
+}
+
+func assertArrayValidationNamesCallback(t *testing.T, got, callback string) {
+	t.Helper()
+	const oldGeneric = "validate function arguments failed."
+
+	if got == oldGeneric {
+		t.Fatalf("error is still the old generic-only message: %q", got)
+	}
+	if !strings.Contains(got, callback) {
+		t.Fatalf("error %q does not identify failing callback function %q", got, callback)
+	}
+}
+
+func TestArrayFunctionArgumentValidationErrorIncludesFunctionName(t *testing.T) {
+	tests := []struct {
+		callback string
+		args     []interface{}
+	}{
+		{
+			callback: "pow",
+			args:     []interface{}{"pow", []interface{}{0, -0.4, 1.2}},
+		},
+		{
+			callback: "power",
+			args:     []interface{}{"power", []interface{}{1, 2, 3}},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.callback, func(t *testing.T) {
+			got := executeArrayFunctionForContextTest(t, "array_map", tt.args)
+			assertArrayValidationNamesCallback(t, got, tt.callback)
+		})
+	}
+}
