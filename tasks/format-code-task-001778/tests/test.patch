@@ -0,0 +1,80 @@
+package planner
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/lf-edge/ekuiper/internal/pkg/store"
+	"github.com/lf-edge/ekuiper/internal/xsql"
+	"github.com/lf-edge/ekuiper/pkg/api"
+	"github.com/lf-edge/ekuiper/pkg/ast"
+)
+
+func analyzeSQLForContextTest(t *testing.T, sql string) string {
+	t.Helper()
+
+
+	streamStore, err := store.GetKV("stream")
+	if err != nil {
+		t.Fatalf("get stream store: %v", err)
+	}
+	streamSQL := `CREATE STREAM src1 (
+		id1 BIGINT,
+		temp BIGINT,
+		name string,
+		next STRUCT(NAME STRING, NID BIGINT)
+	) WITH (DATASOURCE="src1", FORMAT="json", KEY="ts");`
+	streamInfo, err := json.Marshal(&xsql.StreamInfo{
+		StreamType: ast.TypeStream,
+		Statement:  streamSQL,
+	})
+	if err != nil {
+		t.Fatalf("marshal stream info: %v", err)
+	}
+	if err := streamStore.Set("src1", string(streamInfo)); err != nil {
+		t.Fatalf("set stream info: %v", err)
+	}
+
+	_, err = PlanSQLWithSourcesAndSinks(&api.Rule{
+		Id:  "context_validation_rule",
+		Sql: sql,
+		Options: &api.RuleOption{
+			SendError: true,
+		},
+	}, nil, nil)
+	if err == nil {
+		t.Fatalf("PlanSQLWithSourcesAndSinks(%q) succeeded; want validation error", sql)
+	}
+	return err.Error()
+}
+
+func assertHavingContext(t *testing.T, got string, tokens ...string) {
+	t.Helper()
+	const oldGeneric = "Not allowed to call non-aggregate functions in HAVING clause."
+
+	if got == oldGeneric {
+		t.Fatalf("error is still the old generic-only message: %q", got)
+	}
+	for _, token := range tokens {
+		if !strings.Contains(got, token) {
+			t.Fatalf("error %q does not include HAVING expression token %q", got, token)
+		}
+	}
+}
+
+func TestAnalyzerValidationErrorIncludesHavingExpressionContext(t *testing.T) {
+	t.Run("simple having expression", func(t *testing.T) {
+		got := analyzeSQLForContextTest(t,
+			`SELECT count(*) FROM src1 HAVING sin(temp) > 0.3`,
+		)
+		assertHavingContext(t, got, "sin", "temp")
+	})
+
+	t.Run("compound having expression", func(t *testing.T) {
+		got := analyzeSQLForContextTest(t,
+			`SELECT sum(temp) FROM src1 HAVING sum(temp) > 10 OR cos(temp) > 0`,
+		)
+		assertHavingContext(t, got, "cos", "temp")
+	})
+}
diff --git a/internal/topo/planner/analyzer_test.go b/internal/topo/planner/analyzer_test.go
index 02ff3008..2a3ed979 100644
--- a/internal/topo/planner/analyzer_test.go
+++ b/internal/topo/planner/analyzer_test.go
@@ -60,6 +60,101 @@ func (e *errorStruct) Serr() string {
 	return e.err
 }
 
+func plannerValidationErrorMatches(expected, actual, sql string) bool {
+	if expected == actual {
+		return true
+	}
+	if expected == "" || actual == "" {
+		return false
+	}
+	if plannerGenericClause(expected) != "" {
+		return plannerValidationErrorHasSQLContext(actual, sql, expected)
+	}
+	return false
+}
+
+func plannerGenericClause(expected string) string {
+	switch expected {
+	case "Not allowed to call aggregate functions in WHERE clause.":
+		return "WHERE"
+	case "Not allowed to call aggregate functions in GROUP BY clause.":
+		return "GROUP BY"
+	case "Not allowed to call non-aggregate functions in HAVING clause.":
+		return "HAVING"
+	default:
+		return ""
+	}
+}
+
+func plannerValidationErrorHasSQLContext(actual, sql, expected string) bool {
+	tokens := plannerClauseTokens(sql, plannerGenericClause(expected))
+	if len(tokens) == 0 {
+		return false
+	}
+	needed := 2
+	if len(tokens) < needed {
+		needed = len(tokens)
+	}
+	found := 0
+	actualLower := strings.ToLower(actual)
+	for _, token := range tokens {
+		if strings.Contains(actualLower, strings.ToLower(token)) {
+			found++
+		}
+	}
+	return found >= needed
+}
+
+func plannerClauseTokens(sql, clause string) []string {
+	expr := plannerClauseExpression(sql, clause)
+	return plannerSignificantTokens(expr)
+}
+
+func plannerClauseExpression(sql, clause string) string {
+	upper := strings.ToUpper(sql)
+	idx := strings.Index(upper, clause)
+	if idx < 0 {
+		return ""
+	}
+	start := idx + len(clause)
+	end := len(sql)
+	for _, marker := range []string{" WHERE ", " GROUP BY ", " HAVING ", " ORDER BY ", " LIMIT "} {
+		next := strings.Index(upper[start:], marker)
+		if next >= 0 && start+next < end {
+			end = start + next
+		}
+	}
+	return sql[start:end]
+}
+
+func plannerSignificantTokens(expr string) []string {
+	seen := map[string]bool{}
+	var tokens []string
+	for _, token := range strings.FieldsFunc(expr, func(r rune) bool {
+		return !(r == '_' || r >= '0' && r <= '9' || r >= 'A' && r <= 'Z' || r >= 'a' && r <= 'z')
+	}) {
+		if token == "" || plannerAllDigits(token) {
+			continue
+		}
+		lower := strings.ToLower(token)
+		if seen[lower] || lower == "and" || lower == "or" || lower == "true" || lower == "false" || lower == "as" {
+			continue
+		}
+		seen[lower] = true
+		tokens = append(tokens, token)
+	}
+	return tokens
+}
+
+func plannerAllDigits(s string) bool {
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return s != ""
+}
