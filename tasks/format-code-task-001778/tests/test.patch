diff --git a/internal/xsql/sqlValidator_context_test.go b/internal/xsql/sqlValidator_context_test.go
new file mode 100644
index 00000000..f535607e
--- /dev/null
+++ b/internal/xsql/sqlValidator_context_test.go
@@ -0,0 +1,194 @@
+package xsql
+
+import (
+	"regexp"
+	"strings"
+	"testing"
+)
+
+var validationFunctionCallRE = regexp.MustCompile(`(?is)\bselect\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*\(`)
+
+func validationErrorMatchesContext(expected, actual, sql string) bool {
+	if expected == actual {
+		return true
+	}
+	if expected == "" || actual == "" {
+		return false
+	}
+	if validationGenericClause(expected) != "" {
+		return validationErrorHasSQLContext(actual, sql, expected)
+	}
+	if strings.Contains(actual, expected) {
+		name := firstValidationFunctionName(sql)
+		return name == "" || strings.Contains(strings.ToLower(actual), strings.ToLower(name))
+	}
+	return false
+}
+
+func validationGenericClause(expected string) string {
+	switch expected {
+	case "Not allowed to call aggregate functions in WHERE clause.":
+		return "WHERE"
+	case "Not allowed to call aggregate functions in GROUP BY clause.":
+		return "GROUP BY"
+	default:
+		return ""
+	}
+}
+
+func validationErrorHasSQLContext(actual, sql, expected string) bool {
+	tokens := validationClauseTokens(sql, validationGenericClause(expected))
+	if len(tokens) == 0 {
+		return false
+	}
+	needed := 2
+	if len(tokens) < needed {
+		needed = len(tokens)
+	}
+	found := 0
+	actualLower := strings.ToLower(actual)
+	for _, token := range tokens {
+		if strings.Contains(actualLower, strings.ToLower(token)) {
+			found++
+		}
+	}
+	return found >= needed
+}
+
+func validationClauseTokens(sql, clause string) []string {
+	expr := validationClauseExpression(sql, clause)
+	return validationSignificantTokens(expr)
+}
+
+func validationClauseExpression(sql, clause string) string {
+	upper := strings.ToUpper(sql)
+	idx := strings.Index(upper, clause)
+	if idx < 0 {
+		return ""
+	}
+	start := idx + len(clause)
+	end := len(sql)
+	for _, marker := range []string{" WHERE ", " GROUP BY ", " HAVING ", " ORDER BY ", " LIMIT "} {
+		next := strings.Index(upper[start:], marker)
+		if next >= 0 && start+next < end {
+			end = start + next
+		}
+	}
+	return sql[start:end]
+}
+
+func validationSignificantTokens(expr string) []string {
+	seen := map[string]bool{}
+	var tokens []string
+	for _, token := range strings.FieldsFunc(expr, func(r rune) bool {
+		return !(r == '_' || r >= '0' && r <= '9' || r >= 'A' && r <= 'Z' || r >= 'a' && r <= 'z')
+	}) {
+		if token == "" || validationAllDigits(token) {
+			continue
+		}
+		lower := strings.ToLower(token)
+		if seen[lower] || lower == "and" || lower == "or" || lower == "true" || lower == "false" || lower == "as" {
+			continue
+		}
+		seen[lower] = true
+		tokens = append(tokens, token)
+	}
+	return tokens
+}
+
+func validationAllDigits(s string) bool {
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return s != ""
+}
+
+func firstValidationFunctionName(sql string) string {
+	matches := validationFunctionCallRE.FindStringSubmatch(sql)
+	if len(matches) < 2 {
+		return ""
+	}
+	return matches[1]
+}
+
+func validateSQLForContextTest(t *testing.T, sql string) string {
+	t.Helper()
+	parser := NewParser(strings.NewReader(sql))
+	_, err := parser.Parse()
+	if err == nil {
+		t.Fatalf("Parse(%q) succeeded; want validation error", sql)
+	}
+	return err.Error()
+}
+
+func assertContextualValidationError(t *testing.T, got, oldGeneric string, tokens ...string) {
+	t.Helper()
+	if got == oldGeneric {
+		t.Fatalf("error is still the old generic-only message: %q", got)
+	}
+	for _, token := range tokens {
+		if !strings.Contains(got, token) {
+			t.Fatalf("error %q does not include offending-expression token %q", got, token)
+		}
+	}
+}
+
+func TestValidationErrorIncludesWhereExpressionContext(t *testing.T) {
+	got := validateSQLForContextTest(t,
+		`SELECT temp FROM src1 WHERE sum(temp) > 10 AND device = "demo"`,
+	)
+
+	assertContextualValidationError(t, got,
+		"Not allowed to call aggregate functions in WHERE clause.",
+		"sum", "temp",
+	)
+}
+
+func TestValidationErrorIncludesGroupByExpressionContext(t *testing.T) {
+	got := validateSQLForContextTest(t,
+		`SELECT temp FROM src1 GROUP BY max(temp + 1)`,
+	)
+
+	assertContextualValidationError(t, got,
+		"Not allowed to call aggregate functions in GROUP BY clause.",
+		"max", "temp",
+	)
+}
+
+func parseSQLFunctionValidationErrorForContextTest(t *testing.T, sql string) string {
+	t.Helper()
+	_, err := NewParser(strings.NewReader(sql)).Parse()
+	if err == nil {
+		t.Fatalf("Parse(%q) succeeded; want validation error", sql)
+	}
+	return err.Error()
+}
+
+func assertFunctionValidationContext(t *testing.T, got, functionName string, reasonTokens ...string) {
+	t.Helper()
+	if !strings.Contains(got, functionName) {
+		t.Fatalf("error %q does not identify function %q", got, functionName)
+	}
+	for _, token := range reasonTokens {
+		if !strings.Contains(got, token) {
+			t.Fatalf("error %q does not preserve underlying reason token %q", got, token)
+		}
+	}
+}
+
+func TestFunctionValidationErrorIncludesNameAndUnderlyingReason(t *testing.T) {
+	got := parseSQLFunctionValidationErrorForContextTest(t, `SELECT sum() FROM tbl`)
+	assertFunctionValidationContext(t, got,
+		"sum",
+		"Expect 1 arguments but found 0.",
+	)
+
+	got = parseSQLFunctionValidationErrorForContextTest(t, `SELECT abs(true) FROM tbl`)
+	assertFunctionValidationContext(t, got,
+		"abs",
+		"Expect number",
+		"parameter 1",
+	)
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,30 @@
+#!/bin/bash
+set -uo pipefail
+cd /testbed
+
+
+mkdir -p /tmp/kuiper_base/{etc,data,log,plugins}
+cp -r /testbed/etc/* /tmp/kuiper_base/etc/ 2>/dev/null || true
+export KuiperBaseKey=/tmp/kuiper_base
+
+
+packages=(
+  ./internal/binder/function/
+  ./internal/topo/planner/
+  ./internal/xsql/
+)
+
+case "${1:-}" in
+  base)
+    go test -v -count=1 "${packages[@]}" \
+      -run '^TestArrayCommonFunctions$|^Test_validation$|^TestInvoke$|^TestFuncValidator$|^TestParser_ParseStatement$'
+    ;;
+  new)
+    go test -v -count=1 "${packages[@]}" \
+      -run '^TestArrayFunctionArgumentValidationErrorIncludesFunctionName$|^TestAnalyzerValidationErrorIncludesHavingExpressionContext$|^TestValidationErrorIncludesWhereExpressionContext$|^TestValidationErrorIncludesGroupByExpressionContext$|^TestFunctionValidationErrorIncludesNameAndUnderlyingReason$'
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
