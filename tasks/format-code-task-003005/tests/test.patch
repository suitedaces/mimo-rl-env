+class TestGPUStatFan(unittest.TestCase):
+    """Tests for the fan speed feature (issue: show fan speed)."""
+
+    @mock.patch('psutil.Process')
+    @mock.patch('gpustat.core.N')
+    def test_fan_speed_in_entry_dict(self, N, Process):
+        """
+        User queries via library and observes fan.speed in entry dict.
+        """
+        _configure_mock(N, Process)
+        gpustats = gpustat.new_query()
+
+
+        self.assertEqual(gpustats[0].entry['fan.speed'], 16)
+        self.assertEqual(gpustats[1].entry['fan.speed'], 53)
+        self.assertIsNone(gpustats[2].entry['fan.speed'])
+
+    @mock.patch('psutil.Process')
+    @mock.patch('gpustat.core.N')
+    def test_formatted_output_includes_fan_when_show_fan(self, N, Process):
+        """
+        User calls print_formatted(show_fan=True), observes fan percentage
+        rendered for each GPU in the output text.
+        """
+        _configure_mock(N, Process)
+        gpustats = gpustat.new_query()
+
+        fp = StringIO()
+        gpustats.print_formatted(fp=fp, no_color=True, show_fan=True,
+                                 show_header=False)
+        out = remove_ansi_codes(fp.getvalue())
+
+
+        lines = [line for line in out.split('\n') if line]
+        self.assertEqual(len(lines), 3)
+
+
+        self.assertIn(" 16 %", lines[0])
+        self.assertIn(" 53 %", lines[1])
+        self.assertIn(" ?? %", lines[2])
+
+    @mock.patch('psutil.Process')
+    @mock.patch('gpustat.core.N')
+    def test_formatted_output_default_omits_fan(self, N, Process):
+        """
+        User calls print_formatted() without the fan flag; output should be
+        unchanged from the original (no fan column).
+        """
+        _configure_mock(N, Process)
+        gpustats = gpustat.new_query()
+
+        fp = StringIO()
+        gpustats.print_formatted(fp=fp, no_color=True, show_header=False)
+        out = remove_ansi_codes(fp.getvalue())
+
+        lines = [line for line in out.split('\n') if line]
+        self.assertEqual(len(lines), 3)
+
+
+
+
+        self.assertNotIn(" 16 %", lines[0])
+        self.assertNotIn(" 53 %", lines[1])
+
+        self.assertEqual(out, MOCK_EXPECTED_OUTPUT_DEFAULT)
+
+    @mock.patch('psutil.Process')
+    @mock.patch('gpustat.core.N')
+    def test_json_output_includes_fan_speed(self, N, Process):
+        """
+        User calls print_json() and observes fan.speed for each GPU.
+        """
+        _configure_mock(N, Process)
+        gpustats = gpustat.new_query()
+
+        fp = StringIO()
+        gpustats.print_json(fp=fp)
+
+        import json
+        j = json.loads(fp.getvalue())
+        gpus = j['gpus']
+        self.assertEqual(len(gpus), 3)
+        self.assertEqual(gpus[0]['fan.speed'], 16)
+        self.assertEqual(gpus[1]['fan.speed'], 53)
+        self.assertIsNone(gpus[2]['fan.speed'])
+
+    @unittest.skipIf(sys.version_info < (3, 4), "Only in Python 3.4+")
+    @mock.patch('psutil.Process')
+    @mock.patch('gpustat.core.N')
+    def test_cli_long_flag_shows_fan(self, N, Process):
+        """
+        End-to-end: running `gpustat --show-fan` shows fan speed in output.
+        """
+        _configure_mock(N, Process)
+
+        f = StringIO()
+        import contextlib
+        with contextlib.redirect_stdout(f):
+            try:
+                gpustat.main('gpustat', '--no-color', '--show-fan')
+            except SystemExit:
+                raise AssertionError(
+                    "Argparse failed (see above error message)"
+                )
+        s = remove_ansi_codes(f.getvalue())
+        body_lines = [line for line in s.split('\n')[1:] if line]
+        self.assertEqual(len(body_lines), 3)
+        self.assertIn(" 16 %", body_lines[0])
+        self.assertIn(" 53 %", body_lines[1])
+        self.assertIn(" ?? %", body_lines[2])
+
+    @unittest.skipIf(sys.version_info < (3, 4), "Only in Python 3.4+")
+    @mock.patch('psutil.Process')
+    @mock.patch('gpustat.core.N')
+    def test_cli_default_omits_fan(self, N, Process):
+        """
+        End-to-end: running `gpustat` (no fan flag) does not include fan.
+        """
+        _configure_mock(N, Process)
+
+        f = StringIO()
+        import contextlib
+        with contextlib.redirect_stdout(f):
+            try:
+                gpustat.main('gpustat', '--no-color')
+            except SystemExit:
+                raise AssertionError(
+                    "Argparse failed (see above error message)"
+                )
+        s = remove_ansi_codes(f.getvalue())
+        body = '\n'.join(s.split('\n')[1:])
+        self.assertEqual(body, MOCK_EXPECTED_OUTPUT_DEFAULT)
+
+
 if __name__ == '__main__':
     unittest.main()
