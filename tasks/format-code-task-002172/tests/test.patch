new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/test_loadavg.py
@@ -0,0 +1,494 @@
+
+
+
+import json
+import os
+import pkgutil
+import socket
+import subprocess
+import sys
+import types
+from enum import Enum, IntFlag
+
+import pytest
+
+
+
+
+DRGN_STUB_BOOTSTRAP = r"""
+import pkgutil
+import sys
+import types
+from enum import Enum, IntFlag
+
+
+class Architecture(Enum):
+    X86_64 = "x86_64"
+
+
+class PlatformFlags(IntFlag):
+    IS_64_BIT = 1
+    IS_LITTLE_ENDIAN = 2
+
+
+class Platform:
+    def __init__(self, architecture, flags):
+        self.architecture = architecture
+        self.flags = flags
+
+
+class NoDefaultProgramError(Exception):
+    pass
+
+
+class ObjectNotFoundError(LookupError):
+    def __init__(self, name):
+        self.name = name
+        super().__init__(name)
+
+    def __str__(self):
+        return f"could not find {self.name!r}"
+
+
+class _ScalarObject:
+    def __init__(self, prog, value):
+        self.prog_ = prog
+        self._value = value
+
+    def value_(self):
+        return self._value
+
+    def __int__(self):
+        return int(self._value)
+
+    def __index__(self):
+        return int(self._value)
+
+    def __float__(self):
+        return float(self._value)
+
+    def __truediv__(self, other):
+        return self._value / other
+
+
+class Object(_ScalarObject):
+    def __init__(self, prog, type_=None, value=None, *, address=None, **kwargs):
+        if value is None and address is not None:
+            value = address
+        super().__init__(prog, value)
+        self.type_ = type_
+        self._items = [
+            item if hasattr(item, "value_") else _ScalarObject(prog, item)
+            for item in value
+        ] if isinstance(value, list) else None
+
+    def __getitem__(self, index):
+        if self._items is None:
+            raise TypeError("object is not subscriptable")
+        return self._items[index]
+
+    def __len__(self):
+        if self._items is None:
+            raise TypeError("object has no len()")
+        return len(self._items)
+
+    def __iter__(self):
+        if self._items is None:
+            raise TypeError("object is not iterable")
+        return iter(self._items)
+
+
+_default_prog = None
+
+
+class Program:
+    def __init__(self, platform=None):
+        self.platform = platform
+        self.cache = {}
+        self._object_finders = {}
+        self._enabled_object_finders = []
+
+    def int_type(self, *args, **kwargs):
+        return ("int", args, tuple(sorted(kwargs.items())))
+
+    def array_type(self, element_type, length):
+        return ("array", element_type, length)
+
+    def register_object_finder(self, name, finder, *, enable_index=None):
+        self._object_finders[name] = finder
+        if enable_index is None:
+            self._enabled_object_finders.append(name)
+        else:
+            self._enabled_object_finders.insert(enable_index, name)
+
+    def registered_object_finders(self):
+        return list(self._object_finders)
+
+    def enabled_object_finders(self):
+        return list(self._enabled_object_finders)
+
+    def __getitem__(self, name):
+        for finder_name in self._enabled_object_finders:
+            found = self._object_finders[finder_name](self, name, None, None)
+            if found is not None:
+                return found
+        raise ObjectNotFoundError(name)
+
+    def object(self, name):
+        return self[name]
+
+
+def get_default_prog():
+    if _default_prog is None:
+        raise NoDefaultProgramError()
+    return _default_prog
+
+
+def set_default_prog(prog):
+    global _default_prog
+    _default_prog = prog
+
+
+def _unused_native_helper(*args, **kwargs):
+    raise NotImplementedError("native helper is outside this loadavg test")
+
+
+def NULL(prog=None, type_=None):
+    return Object(prog, type_, 0)
+
+
+def cast(type_, obj):
+    return obj
+
+
+def container_of(obj, type_, member):
+    return obj
+
+
+def sizeof(obj):
+    return 0
+
+
+class _Dummy:
+    def __init__(self, *args, **kwargs):
+        pass
+
+    def __class_getitem__(cls, item):
+        return cls
+
+
+fake_drgn = types.ModuleType("_drgn")
+for name, value in {
+    "Architecture": Architecture,
+    "Platform": Platform,
+    "PlatformFlags": PlatformFlags,
+    "Program": Program,
+    "Object": Object,
+    "NoDefaultProgramError": NoDefaultProgramError,
+    "ObjectNotFoundError": ObjectNotFoundError,
+    "NULL": NULL,
+    "IntegerLike": int,
+    "cast": cast,
+    "container_of": container_of,
+    "get_default_prog": get_default_prog,
+    "set_default_prog": set_default_prog,
+    "sizeof": sizeof,
+}.items():
+    setattr(fake_drgn, name, value)
+
+for name in [
+    "AbsenceReason", "BadDataError", "DebugInfoOptions", "ExtraModule",
+    "FaultError", "FindObjectFlags", "KmodSearchMethod", "Language",
+    "MainModule", "MemorySearchIterator", "MissingDebugInfoError", "Module",
+    "ModuleFileStatus", "ObjectAbsentError", "OutOfBoundsError", "Path",
+    "PrimitiveType", "ProgramFlags", "Qualifiers", "Register",
+    "RelocatableModule", "SharedLibraryModule", "SourceLocation",
+    "SourceLocationList", "StackFrame", "StackTrace", "SupplementaryFileKind",
+    "Symbol", "SymbolBinding", "SymbolIndex", "SymbolKind", "Thread", "Type",
+    "TypeEnumerator", "TypeKind", "TypeKindSet", "TypeMember",
+    "TypeParameter", "TypeTemplateParameter", "UnsupportedOperation",
+    "VdsoModule", "WantedSupplementaryFile",
+]:
+    setattr(fake_drgn, name, _Dummy)
+
+for name in [
+    "_elfutils_version", "_enable_dlopen_debuginfod", "_have_debuginfod",
+    "_with_json_c", "_with_libkdumpfile", "_with_lzma", "_with_pcre2",
+    "_with_pcre2_utf",
+]:
+    setattr(fake_drgn, name, False)
+
+for name in [
+    "_linux_helper_cpu_curr", "_linux_helper_idle_task",
+    "_linux_helper_task_cpu", "_linux_helper_task_on_cpu",
+    "_linux_helper_task_thread_info",
+]:
+    setattr(fake_drgn, name, _unused_native_helper)
+
+for name in [
+    "alignof", "filename_matches", "host_platform", "implicit_convert",
+    "offsetof", "program_from_core_dump", "program_from_kernel",
+    "program_from_pid", "reinterpret",
+]:
+    setattr(fake_drgn, name, _unused_native_helper)
+
+sys.modules["_drgn"] = fake_drgn
+
+for module_name, exports in {
+    "drgn.helpers.linux.cgroup": {"cgroup_name": _unused_native_helper},
+    "drgn.helpers.linux.list": {
+        "list_for_each_entry": _unused_native_helper,
+    },
+    "drgn.helpers.linux.percpu": {
+        "per_cpu": _unused_native_helper,
+        "per_cpu_ptr": _unused_native_helper,
+    },
+    "drgn.helpers.linux.rbtree": {
+        "rbtree_inorder_for_each_entry": _unused_native_helper,
+    },
+}.items():
+    module = types.ModuleType(module_name)
+    module.__all__ = tuple(exports)
+    for export_name, export_value in exports.items():
+        setattr(module, export_name, export_value)
+    sys.modules[module_name] = module
+
+_real_iter_modules = pkgutil.iter_modules
+
+
+def _loadavg_only_iter_modules(path=None, prefix=""):
+    #
+    if prefix == "drgn.helpers.linux.":
+        yield pkgutil.ModuleInfo(None, prefix + "sched", False)
+    elif prefix == "drgn.helpers.common.":
+        yield pkgutil.ModuleInfo(None, prefix + "prog", False)
+    else:
+        yield from _real_iter_modules(path, prefix)
+
+
+pkgutil.iter_modules = _loadavg_only_iter_modules
+"""
+
+
+exec(DRGN_STUB_BOOTSTRAP)
+
+from drgn import (
+    Architecture,
+    NoDefaultProgramError,
+    Object,
+    ObjectNotFoundError,
+    Platform,
+    PlatformFlags,
+    Program,
+    get_default_prog,
+    set_default_prog,
+)
+from drgn.helpers.linux import loadavg as package_loadavg
+from drgn.helpers.linux.sched import loadavg
+
+
+PLATFORM = Platform(
+    Architecture.X86_64,
+    PlatformFlags.IS_64_BIT | PlatformFlags.IS_LITTLE_ENDIAN,
+)
+
+
+def make_program(raw_values):
+    prog = Program(PLATFORM)
+    avenrun = Object(
+        prog,
+        prog.array_type(prog.int_type("unsigned long", 8, False), 3),
+        list(raw_values),
+    )
+
+    def find_avenrun(candidate_prog, name, flags, filename):
+        if candidate_prog is prog and name == "avenrun":
+            return avenrun
+        return None
+
+    prog.register_object_finder("usercase_avenrun", find_avenrun, enable_index=0)
+    return prog, avenrun
+
+
+def raw_avenrun_values(avenrun):
+    return [avenrun[i].value_() for i in range(3)]
+
+
+def with_default_program(prog):
+    class DefaultProgramContext:
+        def __enter__(self):
+            try:
+                self.old_prog = get_default_prog()
+            except NoDefaultProgramError:
+                self.old_prog = None
+            set_default_prog(prog)
+
+        def __exit__(self, exc_type, exc, tb):
+            set_default_prog(self.old_prog)
+
+    return DefaultProgramContext()
+
+
+def test_sched_module_import_explicit_program_converts_zero_avenrun():
+
+
+
+
+    prog, avenrun = make_program([0, 0, 0])
+
+    assert loadavg(prog) == (0.0, 0.0, 0.0)
+    assert raw_avenrun_values(avenrun) == [0, 0, 0]
+
+
+def test_top_level_linux_import_converts_example_values_in_order():
+
+
+
+
+    prog, avenrun = make_program([2048, 1024, 512])
+
+    assert package_loadavg(prog) == (1.0, 0.5, 0.25)
+    assert raw_avenrun_values(avenrun) == [2048, 1024, 512]
+
+
+def test_default_program_call_uses_current_default_program():
+
+
+
+
+    prog, _ = make_program([2048, 1024, 512])
+
+    with with_default_program(prog):
+        assert loadavg() == (1.0, 0.5, 0.25)
+
+
+def test_fixed_point_boundaries_around_one_unit():
+
+
+
+
+    prog, avenrun = make_program([1, 2047, 2049])
+
+    assert loadavg(prog) == (0.00048828125, 0.99951171875, 1.00048828125)
+    assert raw_avenrun_values(avenrun) == [1, 2047, 2049]
+
+
+def test_larger_fixed_point_values_are_returned_as_distinct_floats():
+
+
+
+
+    prog, _ = make_program([4096, 8192, 16384])
+
+    assert loadavg(prog) == (2.0, 4.0, 8.0)
+
+
+def test_arbitrary_raw_values_preserve_fractional_precision():
+
+
+
+
+    prog, avenrun = make_program([123456, 654321, 42])
+
+    assert loadavg(prog) == (60.28125, 319.49267578125, 0.0205078125)
+    assert raw_avenrun_values(avenrun) == [123456, 654321, 42]
+
+
+def test_missing_avenrun_propagates_drgn_lookup_failure():
+
+
+
+
+    prog = Program(PLATFORM)
+
+    with pytest.raises(ObjectNotFoundError) as exc_info:
+        loadavg(prog)
+    assert exc_info.value.name == "avenrun"
+
+    assert str(exc_info.value)
+
+
+def test_referential_transparency_same_program_same_tuple():
+    prog, _ = make_program([2048, 1024, 512])
+
+    assert loadavg(prog) == loadavg(prog)
+    assert loadavg(prog) == (1.0, 0.5, 0.25)
+
+
+def test_does_not_mutate_program_or_avenrun_objects():
+    prog, avenrun = make_program([1, 2047, 2049])
+    before_raw_values = raw_avenrun_values(avenrun)
+    before_registered_finders = set(prog.registered_object_finders())
+    before_enabled_finders = list(prog.enabled_object_finders())
+
+    assert loadavg(prog) == (0.00048828125, 0.99951171875, 1.00048828125)
+
+    assert raw_avenrun_values(avenrun) == before_raw_values
+    assert set(prog.registered_object_finders()) == before_registered_finders
+    assert list(prog.enabled_object_finders()) == before_enabled_finders
+
+
+def test_no_global_state_after_other_program_calls_matches_fresh_process():
+    first_prog, _ = make_program([0, 0, 0])
+    second_prog, _ = make_program([4096, 8192, 16384])
+    target_prog, _ = make_program([2048, 1024, 512])
+    assert loadavg(first_prog) == (0.0, 0.0, 0.0)
+    assert loadavg(second_prog) == (2.0, 4.0, 8.0)
+    in_process = loadavg(target_prog)
+
+    script = DRGN_STUB_BOOTSTRAP + r"""
+import json
+from drgn import Architecture, Object, Platform, PlatformFlags, Program
+from drgn.helpers.linux.sched import loadavg
+
+platform = Platform(
+    Architecture.X86_64,
+    PlatformFlags.IS_64_BIT | PlatformFlags.IS_LITTLE_ENDIAN,
+)
+prog = Program(platform)
+avenrun = Object(
+    prog,
+    prog.array_type(prog.int_type("unsigned long", 8, False), 3),
+    [2048, 1024, 512],
+)
+
+def find_avenrun(candidate_prog, name, flags, filename):
+    if candidate_prog is prog and name == "avenrun":
+        return avenrun
+    return None
+
+prog.register_object_finder("usercase_avenrun", find_avenrun, enable_index=0)
+print(json.dumps(loadavg(prog)))
+"""
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        cwd="/workspace/repo",
+    )
+    fresh_process = tuple(json.loads(completed.stdout))
+
+    assert in_process == (1.0, 0.5, 0.25)
+    assert fresh_process == (1.0, 0.5, 0.25)
+    assert in_process == fresh_process
+
+
+def test_no_filesystem_or_network_side_effects(tmp_path, monkeypatch):
+    def deny_socket(*args, **kwargs):
+        raise AssertionError("loadavg must not open network sockets")
+
+    monkeypatch.setattr(socket, "socket", deny_socket)
+    prog, _ = make_program([2048, 1024, 512])
+
+    old_cwd = os.getcwd()
+    try:
+        os.chdir(tmp_path)
+        before = sorted(path.relative_to(tmp_path) for path in tmp_path.rglob("*"))
+        assert loadavg(prog) == (1.0, 0.5, 0.25)
+        after = sorted(path.relative_to(tmp_path) for path in tmp_path.rglob("*"))
+    finally:
+        os.chdir(old_cwd)
+
+    assert after == before == []
