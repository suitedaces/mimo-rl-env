+func TestProcessPlatformReportOOMRequiresQualifyingReport(t *testing.T) {
+	testCases := []struct {
+		name       string
+		status     string
+		memoryUsed float64
+		memorySize float64
+	}{
+		{
+			name:       "non-error status at memory limit",
+			status:     "success",
+			memoryUsed: 256,
+			memorySize: 256,
+		},
+		{
+			name:       "error status below memory limit",
+			status:     "error",
+			memoryUsed: 255,
+			memorySize: 256,
+		},
+		{
+			name:       "error status with zero memory used",
+			status:     "error",
+			memoryUsed: 0,
+			memorySize: 256,
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			demux := aggregator.InitTestAgentDemultiplexerWithFlushInterval(time.Hour)
+			defer demux.Stop(false)
+
+			requestID := "negative-" + strings.ReplaceAll(tc.name, " ", "-")
+			message := unmarshalPlatformReport(t, platformReportJSON(requestID, tc.status, tc.memoryUsed, tc.memorySize))
+			lc := newOOMTestCollector(t, demux, requestID)
+
+			received, timed := processAndWaitForSamples(lc, *message, 6)
+			assert.Len(t, timed, 0)
+			assert.Equal(t, 0, countMetricsByName(received, serverlessMetrics.OutOfMemoryMetric))
+		})
+	}
+}
