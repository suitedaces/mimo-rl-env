+func TestOutOfMemoryEnhancedMetricsAreDedupedPerRequest(t *testing.T) {
+	demux := aggregator.InitTestAgentDemultiplexerWithFlushInterval(time.Hour)
+	defer demux.Stop(false)
+
+	requestID := "fa7d55f7-4054-412f-9567-8f607c8376db"
+	lc := newOOMTestCollector(t, demux, requestID)
+	functionOOM := &LambdaLogAPIMessage{
+		logType:      logTypeFunction,
+		time:         time.Now(),
+		stringRecord: "JavaScript heap out of memory",
+	}
+	reportOOM := unmarshalPlatformReport(t, platformReportJSON(requestID, "error", 1024, 1024))
+
+	lc.Start()
+	lc.In <- []LambdaLogAPIMessage{*functionOOM, *reportOOM}
+
+	received, timed := demux.WaitForNumberOfSamples(8, 0, 100*time.Millisecond)
+	assert.Len(t, timed, 0)
+	assert.Equal(t, 1, countMetricsByName(received, serverlessMetrics.OutOfMemoryMetric))
+}
