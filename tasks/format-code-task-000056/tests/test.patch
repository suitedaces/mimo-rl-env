+	t.Cleanup(func() {
+		_ = os.Remove(stateFile)
+	})
+
+	requestID := "2b11979d-d2f0-4e1a-8840-5357f2c20b42"
+	lc := newOOMTestCollector(t, demux, requestID)
+	firstReport := unmarshalPlatformReport(t, platformReportJSON(requestID, "error", 640, 512))
+
+	received, timed := processAndWaitForSamples(lc, *firstReport, 8)
+	require.Len(t, timed, 0)
+	require.Equal(t, 1, countMetricsByName(received, serverlessMetrics.OutOfMemoryMetric))
+
+	require.NoError(t, lc.executionContext.SaveCurrentExecutionContext())
+
+	restoredCollector := newOOMTestCollector(t, demux, requestID)
+	require.NoError(t, restoredCollector.executionContext.RestoreCurrentStateFromFile())
+	replayedReport := unmarshalPlatformReport(t, platformReportJSON(requestID, "error", 640, 512))
+
+	restoredCollector.Start()
+	restoredCollector.In <- []LambdaLogAPIMessage{*replayedReport}
+
+	replayed, replayedTimed := demux.WaitForNumberOfSamples(14, 0, 100*time.Millisecond)
+	assert.Len(t, replayedTimed, 0)
+	assert.Equal(t, 1, countMetricsByName(replayed, serverlessMetrics.OutOfMemoryMetric))
 }
 
