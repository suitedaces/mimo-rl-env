diff --git a/skypy/pipeline/tests/test_config.py b/skypy/pipeline/tests/test_config.py
index a3d8164..6200455 100644
--- a/skypy/pipeline/tests/test_config.py
+++ b/skypy/pipeline/tests/test_config.py
@@ -1,3 +1,4 @@
+from astropy.units import Quantity
 from astropy.utils.data import get_pkg_data_filename
 from collections.abc import Callable
 import pytest
@@ -31,3 +32,52 @@ def test_load_skypy_yaml():
     filename = get_pkg_data_filename('data/bad_module.yml')
     with pytest.raises(ImportError):
         load_skypy_yaml(filename)
+
+
+def test_quantity_config():
+    filename = get_pkg_data_filename('data/quantities.yml')
+    config = load_skypy_yaml(filename)
+
+
+    v = config['explicit_tag']
+    assert isinstance(v, Quantity)
+    assert v.value == 1000.0
+    assert v.unit.to_string() == 'deg2'
+
+
+    v = config['implicit_resolution']
+    assert isinstance(v, Quantity)
+    assert v.value == 1000.0
+    assert v.unit.to_string() == 'deg2'
+
+
+    v = config['decimal_value']
+    assert isinstance(v, Quantity)
+    assert v.value == 3.14
+    assert v.unit.to_string() == 'm'
+
+
+    v = config['negative_value']
+    assert isinstance(v, Quantity)
+    assert v.value == -5.0
+    assert v.unit.to_string() == 'km'
+
+
+    v = config['positive_signed']
+    assert isinstance(v, Quantity)
+    assert v.value == 5.0
+    assert v.unit.to_string() == 'km'
+
+
+    assert isinstance(config['plain_int'], int)
+    assert not isinstance(config['plain_int'], Quantity)
+    assert config['plain_int'] == 42
+
+
+    assert isinstance(config['plain_float'], float)
+    assert not isinstance(config['plain_float'], Quantity)
+    assert config['plain_float'] == 1.0
+
+
+    assert isinstance(config['plain_str'], str)
+    assert config['plain_str'] == 'hello world'
