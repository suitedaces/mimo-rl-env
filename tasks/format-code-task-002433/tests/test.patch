diff --git a/test-data/unit/check-expressions.test b/test-data/unit/check-expressions.test
index 78ef78e9a..d1af5bb6a 100644
--- a/test-data/unit/check-expressions.test
+++ b/test-data/unit/check-expressions.test
@@ -2245,3 +2245,64 @@ T = TypeVar("T")
 x: int
 x + T  # E: Unsupported operand types for + ("int" and "object")
 T()  # E: "object" not callable
+
+[case testStrictEqualityListsCustomEqOnItemRight]
+# flags: --strict-equality
+class C: pass
+class D:
+    def __eq__(self, other: object) -> bool: ...
+a = [C()]
+b = [D()]
+a == b  # OK
+[builtins fixtures/primitives.pyi]
+
+[case testStrictEqualityListsCustomEqIssueRepro]
+# flags: --strict-equality
+class C: pass
+class D:
+    def __eq__(self, other): return True  # type: ignore
+a = [C()]
+b = [D()]
+C() == D()  # OK, no error
+a == b  # OK, no error
+[builtins fixtures/primitives.pyi]
+
+[case testStrictEqualityListsCustomEqOnItemLeft]
+# flags: --strict-equality
+class C:
+    def __eq__(self, other: object) -> bool: ...
+class D: pass
+a = [C()]
+b = [D()]
+a == b  # OK
+[builtins fixtures/primitives.pyi]
+
+[case testStrictEqualityListsNoCustomEqStillFlags]
+# flags: --strict-equality
+class C: pass
+class D: pass
+a = [C()]
+b = [D()]
+a == b  # E: Non-overlapping equality check (left operand type: "List[C]", right operand type: "List[D]")
+[builtins fixtures/primitives.pyi]
+
+[case testStrictEqualityHomogeneousTuplesCustomEqOnItem]
+# flags: --strict-equality
+from typing import Tuple
+class C: pass
+class D:
+    def __eq__(self, other: object) -> bool: ...
+a: Tuple[C, ...]
+b: Tuple[D, ...]
+a == b  # OK
+[builtins fixtures/primitives.pyi]
+
+[case testStrictEqualityHomogeneousTuplesNoCustomEqStillFlags]
+# flags: --strict-equality
+from typing import Tuple
+class C: pass
+class D: pass
+a: Tuple[C, ...]
+b: Tuple[D, ...]
+a == b  # E: Non-overlapping equality check (left operand type: "Tuple[C, ...]", right operand type: "Tuple[D, ...]")
+[builtins fixtures/primitives.pyi]
