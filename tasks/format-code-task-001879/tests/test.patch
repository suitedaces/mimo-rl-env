diff --git a/usercase-test-coderl/format.test.js b/usercase-test-coderl/format.test.js
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/format.test.js
@@ -0,0 +1,316 @@
+const assert = require('node:assert/strict');
+const { execFileSync } = require('node:child_process');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const test = require('node:test');
+const vm = require('node:vm');
+
+
+
+const CSSUA_PATH = '/workspace/repo/cssua.js';
+
+function installBrowserGlobals(html) {
+  Object.defineProperty(globalThis, 'document', {
+    configurable: true,
+    value: { documentElement: html },
+  });
+  Object.defineProperty(globalThis, 'navigator', {
+    configurable: true,
+    value: { userAgent: '', standalone: false },
+  });
+}
+
+function loadCssua(html = { className: 'no-js' }) {
+  installBrowserGlobals(html);
+  vm.runInThisContext(fs.readFileSync(CSSUA_PATH, 'utf8'), {
+    filename: CSSUA_PATH,
+  });
+  return globalThis.cssua;
+}
+
+function cleanupBrowserGlobals() {
+  delete globalThis.cssua;
+  delete globalThis.document;
+  delete globalThis.navigator;
+}
+
+function stableClone(value) {
+  return JSON.parse(JSON.stringify(value));
+}
+
+function assertFormatClassGroups(actual, groups) {
+  assert.match(actual, /^(?: ua-[^\s]+)*$/);
+  const tokens = actual === '' ? [] : actual.slice(1).split(' ');
+  const expectedTokens = groups.flat();
+
+  assert.deepEqual([...tokens].sort(), [...expectedTokens].sort());
+  for (const group of groups) {
+    let previousIndex = -1;
+    for (const className of group) {
+      const index = tokens.indexOf(className);
+      assert.notEqual(index, -1);
+      assert.ok(index > previousIndex);
+      previousIndex = index;
+    }
+  }
+}
+
+test('formats Windows NT and IE version classes', () => {
+
+
+  const cssua = loadCssua();
+  try {
+    const input = { windows_nt: '5.0', os: 'windows', ie: '5.5' };
+    assert.equal(
+      cssua.format(input),
+      ' ua-windows_nt ua-windows_nt-5 ua-windows_nt-5-0 ua-os ua-os-windows ua-ie ua-ie-5 ua-ie-5-5',
+    );
+  } finally {
+    cleanupBrowserGlobals();
+  }
+});
+
+test('formats Gecko and Firefox progressively specific classes', () => {
+
+
+  const cssua = loadCssua();
+  try {
+    const input = { gecko: '1.9.2.13', firefox: '3.6.13' };
+    assert.equal(
+      cssua.format(input),
+      ' ua-gecko ua-gecko-1 ua-gecko-1-9 ua-gecko-1-9-2 ua-gecko-1-9-2-13 ua-firefox ua-firefox-3 ua-firefox-3-6 ua-firefox-3-6-13',
+    );
+  } finally {
+    cleanupBrowserGlobals();
+  }
+});
+
+test('formats a boolean indicator as only the base class', () => {
+
+
+  const cssua = loadCssua();
+  try {
+    const input = { standalone: true };
+    assert.equal(cssua.format(input), ' ua-standalone');
+  } finally {
+    cleanupBrowserGlobals();
+  }
+});
+
+test('normalizes dotted keys, dotted string values, and spaced string values', () => {
+
+
+  const cssua = loadCssua();
+  try {
+    const input = { 'engine.webkit': '537.51.1', mobile: 'windows phone os' };
+
+    assertFormatClassGroups(cssua.format(input), [
+      [
+        'ua-engine-webkit',
+        'ua-engine-webkit-537',
+        'ua-engine-webkit-537-51',
+        'ua-engine-webkit-537-51-1',
+      ],
+      ['ua-mobile', 'ua-mobile-windows_phone_os'],
+    ]);
+  } finally {
+    cleanupBrowserGlobals();
+  }
+});
+
+test('ignores inherited enumerable properties', () => {
+
+
+  const cssua = loadCssua();
+  try {
+    const input = Object.assign(Object.create({ inherited: '9.9' }), {
+      opera: '12.16',
+    });
+    assert.equal(cssua.format(input), ' ua-opera ua-opera-12 ua-opera-12-16');
+  } finally {
+    cleanupBrowserGlobals();
+  }
+});
+
+test('formats an empty map as an empty string', () => {
+
+
+  const cssua = loadCssua();
+  try {
+    assert.equal(cssua.format({}), '');
+  } finally {
+    cleanupBrowserGlobals();
+  }
+});
+
+test('formats a false boolean indicator as only the base class', () => {
+  const cssua = loadCssua();
+  try {
+    const input = { standalone: false };
+
+    assert.equal(cssua.format(input), ' ua-standalone');
+  } finally {
+    cleanupBrowserGlobals();
+  }
+});
+
+test('format is referentially transparent for the same input', () => {
+  const cssua = loadCssua();
+  try {
+    const input = { webkit: '525.13', chrome: '0.2.149.30' };
+
+    assertFormatClassGroups(cssua.format(input), [
+      ['ua-webkit', 'ua-webkit-525', 'ua-webkit-525-13'],
+      [
+        'ua-chrome',
+        'ua-chrome-0',
+        'ua-chrome-0-2',
+        'ua-chrome-0-2-149',
+        'ua-chrome-0-2-149-30',
+      ],
+    ]);
+    assert.equal(cssua.format(input), cssua.format(input));
+  } finally {
+    cleanupBrowserGlobals();
+  }
+});
+
+test('format does not mutate the caller input', () => {
+  const cssua = loadCssua();
+  try {
+    const input = {
+      standalone: true,
+      mobile: 'windows phone os',
+      webkit: '537.51.1',
+    };
+    const before = stableClone(input);
+
+    assertFormatClassGroups(cssua.format(input), [
+      ['ua-standalone'],
+      ['ua-mobile', 'ua-mobile-windows_phone_os'],
+      ['ua-webkit', 'ua-webkit-537', 'ua-webkit-537-51', 'ua-webkit-537-51-1'],
+    ]);
+    assert.deepEqual(input, before);
+  } finally {
+    cleanupBrowserGlobals();
+  }
+});
+
+test('format has no same-input process-local dependency', () => {
+  const cssua = loadCssua();
+  try {
+    const input = { gecko: '1.9.2.13', firefox: '3.6.13' };
+    const inProcess = cssua.format(input);
+    const script = `
+      const fs = require('node:fs');
+      const vm = require('node:vm');
+      Object.defineProperty(globalThis, 'document', {
+        configurable: true,
+        value: { documentElement: { className: 'no-js' } },
+      });
+      Object.defineProperty(globalThis, 'navigator', {
+        configurable: true,
+        value: { userAgent: '', standalone: false },
+      });
+      vm.runInThisContext(fs.readFileSync(${JSON.stringify(CSSUA_PATH)}, 'utf8'), {
+        filename: ${JSON.stringify(CSSUA_PATH)},
+      });
+      process.stdout.write(JSON.stringify(globalThis.cssua.format(${JSON.stringify(input)})));
+    `;
+    const freshProcess = JSON.parse(
+      execFileSync(process.execPath, ['-e', script], {
+        encoding: 'utf8',
+      }),
+    );
+    assert.equal(
+      inProcess,
+      ' ua-gecko ua-gecko-1 ua-gecko-1-9 ua-gecko-1-9-2 ua-gecko-1-9-2-13 ua-firefox ua-firefox-3 ua-firefox-3-6 ua-firefox-3-6-13',
+    );
+    assert.equal(freshProcess, inProcess);
+  } finally {
+    cleanupBrowserGlobals();
+  }
+});
+
+test('format does not use filesystem, network, DOM, or ambient globals', () => {
+  const html = {
+    _className: 'no-js',
+    get className() {
+      return this._className;
+    },
+    set className(value) {
+      this._className = value;
+    },
+  };
+  const cssua = loadCssua(html);
+  const originalCwd = process.cwd();
+  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cssua-format-'));
+  const originalWriteFileSync = fs.writeFileSync;
+  const originalAppendFileSync = fs.appendFileSync;
+  const originalFetch = globalThis.fetch;
+  const originalDocument = globalThis.document;
+  const originalNavigator = globalThis.navigator;
+  let classNameReads = 0;
+  let classNameWrites = 0;
+
+  Object.defineProperty(html, 'className', {
+    configurable: true,
+    get() {
+      classNameReads += 1;
+      return this._className;
+    },
+    set(value) {
+      classNameWrites += 1;
+      this._className = value;
+    },
+  });
+
+  try {
+    process.chdir(tmpDir);
+    const beforeEntries = fs.readdirSync(tmpDir).sort();
+    fs.writeFileSync = () => {
+      throw new Error('format attempted to write a file');
+    };
+    fs.appendFileSync = () => {
+      throw new Error('format attempted to append a file');
+    };
+    globalThis.fetch = () => {
+      throw new Error('format attempted to use the network');
+    };
+    globalThis.document = new Proxy(originalDocument, {
+      get() {
+        throw new Error('format attempted to read the DOM');
+      },
+      set() {
+        throw new Error('format attempted to write the DOM');
+      },
+    });
+    globalThis.navigator = new Proxy(originalNavigator, {
+      get() {
+        throw new Error('format attempted to read navigator');
+      },
+      set() {
+        throw new Error('format attempted to write navigator');
+      },
+    });
+
+
+    assertFormatClassGroups(cssua.format({ standalone: true, mobile: 'windows phone os' }), [
+      ['ua-standalone'],
+      ['ua-mobile', 'ua-mobile-windows_phone_os'],
+    ]);
+    assert.deepEqual(fs.readdirSync(tmpDir).sort(), beforeEntries);
+    assert.equal(classNameReads, 0);
+    assert.equal(classNameWrites, 0);
+  } finally {
+    fs.writeFileSync = originalWriteFileSync;
+    fs.appendFileSync = originalAppendFileSync;
+    globalThis.fetch = originalFetch;
+    globalThis.document = originalDocument;
+    globalThis.navigator = originalNavigator;
+    process.chdir(originalCwd);
+    cleanupBrowserGlobals();
+    fs.rmSync(tmpDir, { recursive: true, force: true });
+  }
+});
