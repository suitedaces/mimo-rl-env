+func matchesFixtureResource(req *http.Request, resource string) bool {
+	fixtureURL, err := url.ParseRequestURI(resource)
+	if err != nil {
+		return req.RequestURI == resource
+	}
+	return req.URL.Path == fixtureURL.Path && queryValuesEqual(req.URL.Query(), fixtureURL.Query())
+}
+
+func queryValuesEqual(left, right url.Values) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	for key, leftValues := range left {
+		rightValues, ok := right[key]
+		if !ok || len(leftValues) != len(rightValues) {
+			return false
+		}
+		leftSorted := append([]string(nil), leftValues...)
+		rightSorted := append([]string(nil), rightValues...)
+		sort.Strings(leftSorted)
+		sort.Strings(rightSorted)
+		for i := range leftSorted {
+			if leftSorted[i] != rightSorted[i] {
+				return false
+			}
+		}
+	}
+	return true
+}
