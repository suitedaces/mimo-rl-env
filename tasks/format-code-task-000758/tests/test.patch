+package scim
+
+import (
+	"context"
+	"testing"
+
+	"github.com/databricks/terraform-provider-databricks/common"
+	"github.com/databricks/terraform-provider-databricks/qa"
+)
+
+func TestUsersAPIListExcludesRolesWithoutFilter(t *testing.T) {
+	qa.HTTPFixturesApply(t, []qa.HTTPFixture{
+		{
+			Method:   "GET",
+			Resource: "/api/2.0/preview/scim/v2/Users?excludedAttributes=roles",
+			Response: UserList{
+				Resources: []User{
+					{ID: "u-list-1", UserName: "list-user@example.com"},
+				},
+			},
+		},
+	}, func(ctx context.Context, client *common.DatabricksClient) {
+		users, err := NewUsersAPI(ctx, client).Filter("")
+		if err != nil {
+			t.Fatalf("filter users without filter: %v", err)
+		}
+		if len(users) != 1 || users[0].ID != "u-list-1" {
+			t.Fatalf("unexpected users response: %#v", users)
+		}
+	})
