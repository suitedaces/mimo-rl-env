+import json
+import os
+
+import pyarrow as pa
+import pyarrow.parquet as pq
+
+
+def load_dataset(*args, **kwargs):
+    if args:
+        kwargs = dict(kwargs)
+        kwargs.setdefault("path", args[0])
+    if kwargs.get("revision") is None:
+        kwargs.pop("revision", None)
+
+    log_path = os.environ.get("AM_FAKE_LOG")
+    if log_path:
+        with open(log_path, "w", encoding="utf-8") as handle:
+            json.dump(kwargs, handle, sort_keys=True, separators=(",", ":"))
+
+    data_path = os.environ["AM_FAKE_DATA"]
+    with open(data_path, "r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+class Dataset:
+    def __init__(self, rows):
+        self.rows = list(rows)
+
+    @classmethod
+    def from_list(cls, rows):
+        return cls(rows)
+
+    def __len__(self):
+        return len(self.rows)
+
+    def to_parquet(self, output_path):
+
+
+        table = pa.Table.from_pylist(self.rows)
+        pq.write_table(table, output_path)
