diff --git a/tests/unit/fem/test_paraview_restart.cpp b/tests/unit/fem/test_paraview_restart.cpp
new file mode 100644
index 0000000000..af06e9a538
--- /dev/null
+++ b/tests/unit/fem/test_paraview_restart.cpp
@@ -0,0 +1,164 @@
+
+
+
+
+
+
+
+
+
+
+
+#include "mfem.hpp"
+#include "catch.hpp"
+
+#include <cstdlib>
+#include <fstream>
+#include <string>
+#include <vector>
+
+using namespace mfem;
+
+namespace
+{
+
+
+
+void RemoveCollection(const std::string &name)
+{
+   std::string cmd = "rm -rf " + name;
+   int unused = std::system(cmd.c_str());
+   (void)unused;
+}
+
+
+
+
+std::vector<double> ReadTimesteps(const std::string &pvd_path)
+{
+   std::vector<double> times;
+   std::ifstream in(pvd_path.c_str());
+   if (!in.good()) { return times; }
+
+   std::string line;
+   const std::string key = "timestep=\"";
+   while (std::getline(in, line))
+   {
+      if (line.find("<DataSet") == std::string::npos) { continue; }
+      std::size_t pos = line.find(key);
+      if (pos == std::string::npos) { continue; }
+      pos += key.size();
+      std::size_t end = line.find('"', pos);
+      if (end == std::string::npos) { continue; }
+      times.push_back(std::atof(line.substr(pos, end - pos).c_str()));
+   }
+   return times;
+}
+
+
+
+
+void WriteSeries(const std::string &name, bool restart,
+                 const std::vector<int> &cycles)
+{
+   Mesh mesh(2, 2, Element::QUADRILATERAL, 0, 1.0, 1.0);
+   LinearFECollection fec;
+   FiniteElementSpace fes(&mesh, &fec);
+   GridFunction u(&fes);
+   u = 1.0;
+
+   ParaViewDataCollection dc(name, &mesh);
+   dc.SetDataFormat(VTKFormat::ASCII);
+   dc.RegisterField("u", &u);
+   dc.UseRestartMode(restart);
+   for (std::size_t i = 0; i < cycles.size(); ++i)
+   {
+      dc.SetCycle(cycles[i]);
+      dc.SetTime(double(cycles[i]));
+      dc.Save();
+   }
+
+}
+
+}
+
+TEST_CASE("ParaView restart mode", "[ParaViewRestart]")
+{
+   const std::string name = "ParaViewRestartUnitTest";
+   const std::string pvd_path = name + "/" + name + ".pvd";
+
+   SECTION("Restart off (default) recreates the index")
+   {
+      RemoveCollection(name);
+
+
+      WriteSeries(name, false, {0, 1, 2, 3, 4});
+      REQUIRE(ReadTimesteps(pvd_path) == std::vector<double>({0, 1, 2, 3, 4}));
+
+
+      WriteSeries(name, false, {0});
+      REQUIRE(ReadTimesteps(pvd_path) == std::vector<double>({0}));
+
+      RemoveCollection(name);
+   }
+
+   SECTION("Restart preserves history before the restart time and drops the rest")
+   {
+      RemoveCollection(name);
+
+      WriteSeries(name, false, {0, 1, 2, 3, 4});
+      REQUIRE(ReadTimesteps(pvd_path) == std::vector<double>({0, 1, 2, 3, 4}));
+
+
+
+      WriteSeries(name, true, {2});
+      REQUIRE(ReadTimesteps(pvd_path) == std::vector<double>({0, 1, 2}));
+
+      RemoveCollection(name);
+   }
+
+   SECTION("Restart then continue appends the remaining steps")
+   {
+      RemoveCollection(name);
+
+      WriteSeries(name, false, {0, 1, 2, 3, 4});
+
+
+      WriteSeries(name, true, {2, 3, 4});
+      REQUIRE(ReadTimesteps(pvd_path) == std::vector<double>({0, 1, 2, 3, 4}));
+
+      RemoveCollection(name);
+   }
+
+   SECTION("Restart with no existing index starts a new series")
+   {
+      RemoveCollection(name);
+
+      WriteSeries(name, true, {0, 1});
+      REQUIRE(ReadTimesteps(pvd_path) == std::vector<double>({0, 1}));
+
+      RemoveCollection(name);
+   }
+
+   SECTION("Restart resulting index remains a well-formed collection")
+   {
+      RemoveCollection(name);
+
+      WriteSeries(name, false, {0, 1, 2, 3, 4});
+      WriteSeries(name, true, {2});
+
+      std::ifstream in(pvd_path.c_str());
+      REQUIRE(in.good());
+      std::string content((std::istreambuf_iterator<char>(in)),
+                           std::istreambuf_iterator<char>());
+      REQUIRE(content.find("<VTKFile") != std::string::npos);
+      REQUIRE(content.find("<Collection>") != std::string::npos);
+      REQUIRE(content.find("</Collection>") != std::string::npos);
+      REQUIRE(content.find("</VTKFile>") != std::string::npos);
+
+      REQUIRE(content.find("<Collection>") < content.find("</Collection>"));
+      REQUIRE(content.find("</Collection>") < content.find("</VTKFile>"));
+
+      RemoveCollection(name);
+   }
+}
