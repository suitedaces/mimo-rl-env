+
+@pytest.mark.asyncio
+async def test_appstore_aenter_returns_self_for_async_with_as(appstore_validator: AppStoreValidator):
+    """Verifies the issue's reported working example: `async with validator as v`
+    must yield the validator instance (i.e. `__aenter__` must return self),
+    so that the user can call methods on the bound name `v`.
+    """
+    fake_session = MagicMock()
+    fake_session.close = AsyncMock()
+    with patch.object(appstore_module, "ClientSession", return_value=fake_session):
+        async with appstore_validator as v:
+            assert v is appstore_validator
+            assert v is not None
+
+            assert v.url == "https://buy.itunes.apple.com/verifyReceipt"
+
+
+@pytest.mark.asyncio
+async def test_appstore_aenter_initializes_session(appstore_validator: AppStoreValidator):
+    """Preservation: __aenter__ still initializes _session so that post_json
+    (which uses self._session.post) does not see None.
+    """
+    fake_session = MagicMock()
+    fake_session.close = AsyncMock()
+    assert appstore_validator._session is None
+    with patch.object(appstore_module, "ClientSession", return_value=fake_session):
+        async with appstore_validator:
+            assert appstore_validator._session is fake_session
+            assert appstore_validator._session is not None
+
+
+@pytest.mark.asyncio
+async def test_appstore_aexit_closes_and_clears_session(appstore_validator: AppStoreValidator):
+    """Preservation: __aexit__ still closes and clears the session."""
+    fake_session = MagicMock()
+    fake_session.close = AsyncMock()
+    with patch.object(appstore_module, "ClientSession", return_value=fake_session):
+        async with appstore_validator:
+            pass
+    fake_session.close.assert_awaited_once()
+    assert appstore_validator._session is None
+
+
+@pytest.mark.asyncio
+async def test_appstore_async_with_as_then_validate(appstore_validator: AppStoreValidator):
+    """End-to-end repro of the issue's working example pattern:
+        async with validator as v:
+            result = await v.validate(...)
+    The bound `v` must be the validator instance so the validate call lands on it.
+    """
+    fake_session = MagicMock()
+    fake_session.close = AsyncMock()
+
+    async def post_json(self, request_json):
+        return {"status": 0, "ok": True}
+
+    with patch.object(appstore_module, "ClientSession", return_value=fake_session):
+        with patch.object(AppStoreValidator, "post_json", new=post_json):
+            async with appstore_validator as v:
+
+                result = await v.validate(receipt="test-receipt", shared_secret="s")
+    assert result == {"status": 0, "ok": True}
