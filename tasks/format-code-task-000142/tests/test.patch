+def test_lightning_getattr_raises_attribute_error_on_missing_model_only():
+    """lightning_getattr must raise AttributeError (not ValueError) when attribute is missing."""
+
+    class TestModel:
+        batch_size = 1
+
+    model = TestModel()
+    with pytest.raises(AttributeError):
+        lightning_getattr(model, 'learning_rate')
+
+
+def test_lightning_getattr_raises_attribute_error_on_missing_with_hparams_and_datamodule():
+    """lightning_getattr must raise AttributeError when attribute is missing across model/hparams/datamodule."""
+    models = _get_test_cases()
+
+    model4 = models[3]
+    with pytest.raises(AttributeError):
+        lightning_getattr(model4, 'learning_rate')
+
+
+    model5 = models[4]
+    with pytest.raises(AttributeError):
+        lightning_getattr(model5, 'learning_rate')
+
+
+def test_lightning_getattr_not_value_error():
+    """Regression: lightning_getattr must NOT raise ValueError when attribute is missing."""
+
+    class TestModel:
+        pass
+
+    model = TestModel()
+    with pytest.raises(AttributeError):
+        lightning_getattr(model, 'nonexistent_attr')
+
+    try:
+        lightning_getattr(model, 'nonexistent_attr')
+    except ValueError:
+        pytest.fail("lightning_getattr raised ValueError; expected AttributeError")
+    except AttributeError:
+        pass
+
+
+def test_lightning_setattr_raises_attribute_error_on_missing():
+    """lightning_setattr must raise AttributeError (not ValueError) when attribute is missing."""
+
+    class TestModel:
+        batch_size = 1
+
+    model = TestModel()
+    with pytest.raises(AttributeError):
+        lightning_setattr(model, 'learning_rate', 10)
+
+
+def test_lightning_setattr_not_value_error():
+    """Regression: lightning_setattr must NOT raise ValueError when attribute is missing."""
+
+    class TestModel:
+        pass
+
+    model = TestModel()
+    with pytest.raises(AttributeError):
+        lightning_setattr(model, 'nonexistent_attr', 1)
+    try:
+        lightning_setattr(model, 'nonexistent_attr', 1)
+    except ValueError:
+        pytest.fail("lightning_setattr raised ValueError; expected AttributeError")
+    except AttributeError:
+        pass
+
+
+def test_lightning_getattr_preserves_successful_access():
+    """Preservation: lightning_getattr still returns correct values for present attributes."""
+    models = _get_test_cases()
+    for i, m in enumerate(models[:3]):
+        assert lightning_getattr(m, 'learning_rate') == i
+
+    model5, model6, model7 = models[4:]
+    assert lightning_getattr(model5, 'batch_size') == 8
+    assert lightning_getattr(model6, 'batch_size') == 8
+    assert lightning_getattr(model7, 'batch_size') == 8
