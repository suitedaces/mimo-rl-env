+++ b/src/blocks/blockAllContributors.prettierIgnore.test.ts
@@ -0,0 +1,51 @@
+import { testBlock } from "bingo-stratum-testers";
+import { describe, expect, it } from "vitest";
+
+import { blockAllContributors } from "./blockAllContributors.js";
+import { blockPrettier } from "./blockPrettier.js";
+import { optionsBase } from "./options.fakes.js";
+
+describe("blockAllContributors prettier ignore", () => {
+	it("registers a Prettier addon ignoring .all-contributorsrc by default", () => {
+		const creation = testBlock(blockAllContributors, { options: optionsBase });
+
+		const prettierAddons = (creation.addons ?? []).filter(
+			// eslint-disable-next-line @typescript-eslint/no-explicit-any
+			(addon: any) => addon.block === blockPrettier,
+		);
+
+		expect(prettierAddons).toHaveLength(1);
+		// eslint-disable-next-line @typescript-eslint/no-explicit-any
+		expect((prettierAddons[0] as any).addons).toEqual({
+			ignores: ["/.all-contributorsrc"],
+		});
+	});
+
+	it("registers a Prettier addon ignoring .all-contributorsrc when contributors are provided", () => {
+		const creation = testBlock(blockAllContributors, {
+			options: {
+				...optionsBase,
+				contributors: [
+					{
+						avatar_url: "https://avatars.githubusercontent.com/u/3335181?v=4",
+						contributions: ["code"],
+						login: "JoshuaKGoldberg",
+						name: "Josh Goldberg",
+						profile: "http://www.joshuakgoldberg.com",
+					},
+				],
+			},
+		});
+
+		const prettierAddons = (creation.addons ?? []).filter(
+			// eslint-disable-next-line @typescript-eslint/no-explicit-any
+			(addon: any) => addon.block === blockPrettier,
+		);
+
+		expect(prettierAddons).toHaveLength(1);
+		// eslint-disable-next-line @typescript-eslint/no-explicit-any
+		expect((prettierAddons[0] as any).addons).toEqual({
+			ignores: ["/.all-contributorsrc"],
+		});
+	});
+});
