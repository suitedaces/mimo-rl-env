+"""Acceptance tests for funcy.decorator.
+
+Design-time expected values were captured from GT with public imports only.
+The cwd snapshot in the side-effect contract test catches relative-path writes,
+but does not catch absolute-path writes such as /tmp or user cache directories
+without a process sandbox.
+"""
+
+import copy
+import json
+import os
+import socket
+import subprocess
+import sys
+
+import pytest
+
+from funcy import decorator
+
+
+def test_direct_decorator_increments_wrapped_return():
+
+
+
+
+    @decorator
+    def inc(call):
+        return call() + 1
+
+    @inc
+    def ten():
+        return 10
+
+    assert ten() == 11
+
+
+def test_positional_decorator_factory_binds_decorator_argument():
+
+
+
+
+    @decorator
+    def add(call, n):
+        return call() + n
+
+    @add(2)
+    def ten():
+        return 10
+
+    assert ten() == 12
+
+
+def test_call_object_stores_original_call_and_appends_arguments():
+
+
+
+
+    @decorator
+    def inspect_call(call):
+        return {
+            "plain": call(),
+            "append_pos": call(3),
+            "append_kw": call(z=4),
+        }
+
+    def collect(x, *extra, **kw):
+        return {"x": x, "extra": extra, "kw": kw}
+
+    decorated = inspect_call(collect)
+
+
+    assert decorated(1, y=2) == {
+        "plain": {"x": 1, "extra": (), "kw": {"y": 2}},
+        "append_pos": {"x": 1, "extra": (3,), "kw": {"y": 2}},
+        "append_kw": {"x": 1, "extra": (), "kw": {"y": 2, "z": 4}},
+    }
+
+
+def test_call_attribute_reads_positional_argument():
+
+
+
+
+    @decorator
+    def expose_x(call):
+        return call.x
+
+    assert expose_x(lambda x: None)(10) == 10
+
+
+def test_call_attribute_reads_default_argument():
+
+
+
+
+    @decorator
+    def expose_x(call):
+        return call.x
+
+    assert expose_x(lambda x=11: None)() == 11
+
+
+def test_call_attribute_reads_keyword_only_argument_and_default():
+
+
+
+
+    @decorator
+    def expose_limit(call):
+        return (call.limit, call.mode)
+
+    def target(*, limit, mode="burst"):
+        return None
+
+    assert expose_limit(target)(limit=5) == (5, "burst")
+
+
+def test_call_attribute_reads_varargs_tuple():
+
+
+
+
+    @decorator
+    def expose_x(call):
+        return call.x
+
+    assert expose_x(lambda *x: None)(1, 2) == (1, 2)
+
+
+def test_call_attribute_reads_varkwargs_dict():
+
+
+
+
+    @decorator
+    def expose_x(call):
+        return call.x
+
+    assert expose_x(lambda **x: None)(a=1, b=2) == {"a": 1, "b": 2}
+
+
+def test_unknown_argument_name_raises_attribute_error():
+
+
+
+
+    @decorator
+    def missing_name(call):
+        return call.nope
+
+    with pytest.raises(AttributeError) as excinfo:
+        missing_name(lambda x: None)(1)
+
+
+    assert isinstance(excinfo.value, AttributeError)
+
+
+def test_missing_required_argument_raises_attribute_error():
+
+
+
+
+    @decorator
+    def missing_required(call):
+        return call.x
+
+    with pytest.raises(AttributeError) as excinfo:
+        missing_required(lambda x: None)()
+
+
+    assert isinstance(excinfo.value, AttributeError)
+
+
+def test_keyword_only_decorator_supports_no_parentheses_and_configured_call():
+
+
+
+
+    @decorator
+    def rate_limit(call, *, bonus=3):
+        return call() + bonus
+
+    @rate_limit
+    def base_no_parentheses():
+        return 20
+
+    @rate_limit(bonus=4)
+    def base_with_keyword_option():
+        return 20
+
+    assert (base_no_parentheses(), base_with_keyword_option()) == (23, 24)
+
+
+def test_decorated_function_preserves_metadata_and_nested_original():
+
+
+
+
+    @decorator
+    def mark(call):
+        return call()
+
+    @decorator
+    def add_bang(call):
+        return call() + "!"
+
+    def original():
+        """Inner docs."""
+        return "go"
+
+    original.__module__ = "acceptance_meta_module"
+
+    first = mark(original)
+    second = add_bang(first)
+
+    assert {
+        "second_name": second.__name__,
+        "second_module": second.__module__,
+        "second_doc": second.__doc__,
+        "second_wrapped_is_first": second.__wrapped__ is first,
+        "second_original_is_original": second.__original__ is original,
+        "first_wrapped_is_original": first.__wrapped__ is original,
+        "first_original_is_original": first.__original__ is original,
+        "result": second(),
+    } == {
+        "second_name": "original",
+        "second_module": "acceptance_meta_module",
+        "second_doc": "Inner docs.",
+        "second_wrapped_is_first": True,
+        "second_original_is_original": True,
+        "first_wrapped_is_original": True,
+        "first_original_is_original": True,
+        "result": "go!",
+    }
+
+
+def test_decorator_factory_preserves_wrapper_metadata_and_introspection_fields():
+
+
+
+
+    def meta(call):
+        """Wrapper documentation."""
+        return call()
+
+    def add(call, n, **options):
+        return call() + n + options.get("bonus", 0)
+
+    meta_decorator = decorator(meta)
+    add_factory = decorator(add)
+    configured = add_factory(5, bonus=7)
+
+    def exposed_values(obj):
+        values = []
+        for name in dir(obj):
+            if name.startswith("__") and name != "__wrapped__":
+                continue
+            try:
+                values.append(getattr(obj, name))
+            except Exception:
+                continue
+        return values
+
+    def exposes_identity(obj, expected):
+        return any(value is expected for value in exposed_values(obj))
+
+    def exposes_equal_value(obj, expected):
+        return any(value == expected for value in exposed_values(obj))
+
+    assert {
+        "meta_name": meta_decorator.__name__,
+        "meta_doc": meta_decorator.__doc__,
+        "configured_name": configured.__name__,
+        "configured_result": configured(lambda: 30)(),
+    } == {
+        "meta_name": "meta",
+        "meta_doc": "Wrapper documentation.",
+        "configured_name": "add",
+        "configured_result": 42,
+    }
+
+    assert exposes_identity(meta_decorator, meta)
+    assert exposes_identity(configured, add)
+    assert exposes_equal_value(configured, (5,))
+    assert exposes_equal_value(configured, {"bonus": 7})
+
+
+def test_referential_transparency_for_same_call_arguments():
+    @decorator
+    def summarize(call):
+        return (call.x, call.scale, call())
+
+    def target(x, *, scale=2):
+        return x * scale
+
+    decorated = summarize(target)
+
+
+    assert decorated(6, scale=7) == decorated(6, scale=7)
+
+
+def test_decorator_does_not_mutate_caller_inputs():
+    @decorator
+    def expose_payload(call):
+        return call.payload
+
+    def target(payload):
+        return None
+
+    payload = {"numbers": [1, 2], "nested": {"flag": True}}
+    before = copy.deepcopy(payload)
+
+    assert expose_payload(target)(payload) == {"numbers": [1, 2], "nested": {"flag": True}}
+    assert payload == before
+
+
+def test_no_global_state_for_same_input_across_fresh_python_process():
+    @decorator
+    def add_tag(call):
+        return {"value": call(), "tag": "fresh-process-check"}
+
+    @add_tag
+    def target():
+        return 13
+
+    in_process = target()
+    script = """
+import json
+import sys
+sys.path.insert(0, '/workspace/repo')
+from funcy import decorator
+
+@decorator
+def add_tag(call):
+    return {'value': call(), 'tag': 'fresh-process-check'}
+
+@add_tag
+def target():
+    return 13
+
+sys.stdout.write(json.dumps(target(), sort_keys=True))
+"""
+    proc = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+    fresh_process = json.loads(proc.stdout)
+
+    assert in_process == {"value": 13, "tag": "fresh-process-check"}
+    assert fresh_process == {"tag": "fresh-process-check", "value": 13}
+
+
+def test_decorator_helper_has_no_filesystem_or_network_side_effects(tmp_path, monkeypatch):
+    @decorator
+    def passthrough(call):
+        return call()
+
+    @passthrough
+    def target(x):
+        return x * 2
+
+    def blocked_socket(*args, **kwargs):
+        raise AssertionError("funcy.decorator attempted undeclared network access")
+
+    monkeypatch.setattr(socket, "socket", blocked_socket)
+    monkeypatch.chdir(tmp_path)
+    before = sorted(os.listdir(tmp_path))
+
+    assert target(9) == 18
+
+    after = sorted(os.listdir(tmp_path))
+    assert before == []
+    assert after == []
