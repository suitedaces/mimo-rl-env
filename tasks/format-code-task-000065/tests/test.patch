diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,26 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+if [ ! -x node_modules/.bin/mocha ]; then
+  npm install
+fi
+
+
+NEW_TEST_PATTERN='erases span tags and metrics after a completed trace is flushed|sends formatted data before erasing span metadata|does not retain flushed spans in trace span collections|erases metadata for a flushed single consumer span|uses the parent trace object for child spans|uses the parent trace object even after the parent trace has completed'
+TEST_FILES='packages/dd-trace/test/writer.spec.js packages/dd-trace/test/opentracing/span.spec.js'
+
+case "${1:-}" in
+  base)
+    npx mocha --exit --file packages/dd-trace/test/setup/core.js $TEST_FILES --grep "$NEW_TEST_PATTERN" --invert
+    ;;
+  new)
+    npx mocha --exit --file packages/dd-trace/test/setup/core.js $TEST_FILES --grep "$NEW_TEST_PATTERN"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
