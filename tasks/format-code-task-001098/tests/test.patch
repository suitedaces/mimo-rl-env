+import { FetchContractCreationTxMethods } from "@ethereum-sourcify/lib-sourcify";
+
+const customCreatorConfig: FetchContractCreationTxMethods = {
+  customApi: [
+    {
+      url: "https://creator.example/chains/${CHAIN_ID}/accounts/${ADDRESS}",
+      responsePath: "data.deployments.0.hash",
+      headers: [
+        {
+          headerName: "X-API-Key",
+          headerEnvName: "CREATOR_API_KEY",
+        },
+      ],
+    },
+  ],
+};
+
+void customCreatorConfig;
