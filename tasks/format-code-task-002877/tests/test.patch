diff --git a/usercase-test-coderl/usecase.sh b/usercase-test-coderl/usecase.sh
new file mode 100755
--- /dev/null
+++ b/usercase-test-coderl/usecase.sh
@@ -0,0 +1,215 @@
+#!/usr/bin/env bash
+
+set -u
+export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+
+( cd /workspace/repo && cmake -S . -B Builds/fixture -DCMAKE_BUILD_TYPE=Release -DPLUGINVAL_VST3_VALIDATOR=OFF -DCPM_SOURCE_CACHE="${CPM_SOURCE_CACHE:-/opt/stage4a_cpm_cache}" -DFETCHCONTENT_FULLY_DISCONNECTED=ON -DFETCHCONTENT_UPDATES_DISCONNECTED=ON >/dev/null ) \
+    || fail "configure"
+( cd /workspace/repo && cmake --build Builds/fixture --config Release --target pluginval -j2 >/dev/null ) \
+    || fail "build"
+
+BIN=/workspace/repo/Builds/fixture/pluginval_artefacts/Release/pluginval
+[ -x "$BIN" ] || fail "missing built binary at $BIN"
+
+TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
+cd "$TMP" || fail "tmp cd"
+
+assert_empty_stderr() {
+    local fixture=$1
+    [ ! -s err ] || fail "$fixture unexpected stderr: $(cat err)"
+}
+
+assert_strictness_output_shape() {
+    local fixture=$1
+    local expected_header=$2
+
+    [ "$(sed -n '1p' out)" = "$expected_header" ] || fail "$fixture header: $(sed -n '1p' out)"
+    [ "$(sed -n '2p' out)" = "" ] || fail "$fixture missing blank line after header"
+    [ "$(tail -n 1 out)" = "" ] || fail "$fixture missing trailing blank line"
+}
+
+assert_strictness_body_shape() {
+    local fixture=$1
+
+
+    local body
+    body=$(sed '1,2d;$d' out)
+    [ -n "$body" ] || fail "$fixture missing test lines"
+    sed '1,2d;$d' out | grep -Eqv '^  .+' && fail "$fixture has a test line without two-space prefix"
+    sed '1,2d;$d' out | grep -Eq '^  [^ ].*:[^ ]' && fail "$fixture description separator is not colon-space"
+}
+
+assert_strictness_order() {
+    local fixture=$1
+    local previous=0
+    local level line
+
+
+    while IFS= read -r line; do
+        case "$line" in
+            "  Plugin info:"*|"  Locale stability:"*) level=1 ;;
+            "  Plugin programs:"*|"  Automatable Parameters:"*|"  Plugin state:"*|"  Editor:"*) level=2 ;;
+            "  Audio processing:"*|"  Automation:"*) level=3 ;;
+            "  Open editor whilst processing:"*|"  Basic bus:"*|"  Bus layout processing:"*) level=4 ;;
+            "  Editor Automation:"*|"  auval:"*|"  vst3 validator:"*) level=5 ;;
+            "  Non-releasing audio processing:"*|"  Plugin state restoration:"*|"  Fuzz parameters:"*) level=6 ;;
+            "  Parameters:"*|"  Background thread state:"*|"  Parameter thread safety:"*) level=7 ;;
+            *) fail "$fixture unknown strictness-help line: $line" ;;
+        esac
+
+        [ "$level" -ge "$previous" ] || fail "$fixture strictness levels are not sorted ascending"
+        previous=$level
+    done < <(sed '1,2d;$d' out)
+}
+
+expected_body_level_1() {
+    cat <<'EOF'
+  Plugin info: Logs getName(), getAlternateDisplayNames(), supportsDoublePrecisionProcessing(), getLatencySamples(), getTailLengthSeconds()
+  Locale stability: Checks that the plugin doesn't change the system locale. Some plugins or GUI frameworks change locale settings (e.g., decimal separator from '.' to ','). This can corrupt preset files, break float parsing in other plugins, or crash the host
+EOF
+}
+
+expected_body_level_3() {
+    cat <<'EOF'
+  Plugin info: Logs getName(), getAlternateDisplayNames(), supportsDoublePrecisionProcessing(), getLatencySamples(), getTailLengthSeconds()
+  Locale stability: Checks that the plugin doesn't change the system locale. Some plugins or GUI frameworks change locale settings (e.g., decimal separator from '.' to ','). This can corrupt preset files, break float parsing in other plugins, or crash the host
+  Plugin programs: Calls getNumPrograms() and getProgramName() for each, then randomly switches programs 5 times via setCurrentProgram()
+  Automatable Parameters: For each non-bypass automatable parameter: logs index, name, defaultValue, label, numSteps, isDiscrete, isBoolean, isAutomatable, category
+  Plugin state: Saves state via getStateInformation(), randomises all automatable params, restores via setStateInformation()
+  Editor: Calls createEditor() twice (cold and warm), logs time taken, expects non-null editor pointer
+  Audio processing: Processes 10 blocks at each sample rate / block size combo. For instruments, sends noteOn/noteOff. Checks for NaNs, Infs, subnormals
+  Automation: Processes in 32-sample sub-blocks, randomly changing up to 10 params between each. Checks for NaNs, Infs; subnormals logged as warnings
+EOF
+}
+
+expected_body_level_5() {
+    cat <<'EOF'
+  Plugin info: Logs getName(), getAlternateDisplayNames(), supportsDoublePrecisionProcessing(), getLatencySamples(), getTailLengthSeconds()
+  Locale stability: Checks that the plugin doesn't change the system locale. Some plugins or GUI frameworks change locale settings (e.g., decimal separator from '.' to ','). This can corrupt preset files, break float parsing in other plugins, or crash the host
+  Plugin programs: Calls getNumPrograms() and getProgramName() for each, then randomly switches programs 5 times via setCurrentProgram()
+  Automatable Parameters: For each non-bypass automatable parameter: logs index, name, defaultValue, label, numSteps, isDiscrete, isBoolean, isAutomatable, category
+  Plugin state: Saves state via getStateInformation(), randomises all automatable params, restores via setStateInformation()
+  Editor: Calls createEditor() twice (cold and warm), logs time taken, expects non-null editor pointer
+  Audio processing: Processes 10 blocks at each sample rate / block size combo. For instruments, sends noteOn/noteOff. Checks for NaNs, Infs, subnormals
+  Automation: Processes in 32-sample sub-blocks, randomly changing up to 10 params between each. Checks for NaNs, Infs; subnormals logged as warnings
+  Open editor whilst processing: Starts async thread calling processBlock() repeatedly, then calls createEditor() on message thread. Tests concurrent access
+  Basic bus: Tests audio bus configuration: lists all supported input/output layouts (named channel sets like stereo/5.1 and discrete channels), tests enableAllBuses() and disableNonMainBuses(), then verifies the default layout can be restored
+  Bus layout processing: For every supported combination of mono/stereo on each input and output bus (including sidechain), calls setBusesLayout(), prepareToPlay() and processBlock(). Detects crashes in plugins that mis-handle non-default channel counts (e.g. mono main with stereo sidechain).
+  Editor Automation: With editor open, loops 100x calling setValue(random) on ALL parameters with 10ms sleep between iterations
+  auval: Runs 'auval -strict -v <type> <subtype> <manu>' (Audio Units only)
+  vst3 validator: Disabled (not built with VST3 validator support)
+EOF
+}
+
+expected_body_level_10() {
+    cat <<'EOF'
+  Plugin info: Logs getName(), getAlternateDisplayNames(), supportsDoublePrecisionProcessing(), getLatencySamples(), getTailLengthSeconds()
+  Locale stability: Checks that the plugin doesn't change the system locale. Some plugins or GUI frameworks change locale settings (e.g., decimal separator from '.' to ','). This can corrupt preset files, break float parsing in other plugins, or crash the host
+  Plugin programs: Calls getNumPrograms() and getProgramName() for each, then randomly switches programs 5 times via setCurrentProgram()
+  Automatable Parameters: For each non-bypass automatable parameter: logs index, name, defaultValue, label, numSteps, isDiscrete, isBoolean, isAutomatable, category
+  Plugin state: Saves state via getStateInformation(), randomises all automatable params, restores via setStateInformation()
+  Editor: Calls createEditor() twice (cold and warm), logs time taken, expects non-null editor pointer
+  Audio processing: Processes 10 blocks at each sample rate / block size combo. For instruments, sends noteOn/noteOff. Checks for NaNs, Infs, subnormals
+  Automation: Processes in 32-sample sub-blocks, randomly changing up to 10 params between each. Subnormals treated as errors
+  Open editor whilst processing: Starts async thread calling processBlock() repeatedly, then calls createEditor() on message thread. Tests concurrent access
+  Basic bus: Tests audio bus configuration: lists all supported input/output layouts (named channel sets like stereo/5.1 and discrete channels), tests enableAllBuses() and disableNonMainBuses(), then verifies the default layout can be restored
+  Bus layout processing: For every supported combination of mono/stereo on each input and output bus (including sidechain), calls setBusesLayout(), prepareToPlay() and processBlock(). Detects crashes in plugins that mis-handle non-default channel counts (e.g. mono main with stereo sidechain).
+  Editor Automation: With editor open, loops 1000x calling setValue(random) on ALL parameters with 10ms sleep between iterations
+  auval: Runs 'auval -strict -stress 20 -v <type> <subtype> <manu>' (Audio Units only)
+  vst3 validator: Disabled (not built with VST3 validator support)
+  Non-releasing audio processing: Same as audio processing, but calls prepareToPlay() at new sample rate WITHOUT calling releaseResources() first
+  Plugin state restoration: For each param: saves original value, randomises, restores state, expects value within 0.1 of original. Also requires exact binary state match
+  Fuzz parameters: For each parameter, sets 5 random values and calls getValue(), getText(), getValueForText(), getCurrentValueAsText(). Tests that text/value conversion functions don't crash or hang with arbitrary inputs
+  Parameters: Same as automatable parameters test - logs info for all non-bypass automatable parameters
+  Background thread state: Opens editor on message thread. From background thread: getStateInformation(), randomise params, setStateInformation(). Sleeps 2s for async updates
+  Parameter thread safety: Message thread calls setValueNotifyingHost() 500x on all params. Simultaneously, this thread calls setValue() and processBlock() 500x
+EOF
+}
+
+assert_body_set_matches() {
+    local fixture=$1
+    local expected_func=$2
+
+
+    sed '1,2d;$d' out | sort >actual_body
+    "$expected_func" | sort >expected_body
+    cmp -s actual_body expected_body || {
+        diff -u expected_body actual_body >&2 || true
+        fail "$fixture strictness-help body differs"
+    }
+}
+
+
+
+
+"$BIN" --strictness-help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F1 exit $ec; want 0"
+assert_empty_stderr F1
+assert_strictness_output_shape F1 "Tests at strictness level 5:"
+assert_strictness_body_shape F1
+
+assert_body_set_matches F1 expected_body_level_5
+assert_strictness_order F1
+! grep -q 'Started validating:' out || fail "F1 started plugin validation"
+
+
+
+
+"$BIN" --strictness-help 3 >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F2 exit $ec; want 0"
+assert_empty_stderr F2
+assert_strictness_output_shape F2 "Tests at strictness level 3:"
+assert_strictness_body_shape F2
+
+assert_body_set_matches F2 expected_body_level_3
+assert_strictness_order F2
+! grep -q 'Started validating:' out || fail "F2 started plugin validation"
+
+
+
+
+"$BIN" --strictness-help 0 >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F3 exit $ec; want 0"
+assert_empty_stderr F3
+assert_strictness_output_shape F3 "Tests at strictness level 1:"
+assert_strictness_body_shape F3
+
+assert_body_set_matches F3 expected_body_level_1
+assert_strictness_order F3
+
+
+
+
+"$BIN" --strictness-help 999 >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F4 exit $ec; want 0"
+assert_empty_stderr F4
+assert_strictness_output_shape F4 "Tests at strictness level 10:"
+assert_strictness_body_shape F4
+
+assert_body_set_matches F4 expected_body_level_10
+assert_strictness_order F4
+
+
+
+
+"$BIN" --help >out 2>err; ec=$?
+[ "$ec" -eq 0 ] || fail "F5 exit $ec; want 0"
+assert_empty_stderr F5
+
+grep -q -- '--strictness-help \[level\]' out || fail "F5 missing strictness-help usage"
+awk '
+    index($0, "--strictness-help [level]") { window = 4 }
+    window > 0 {
+        text = tolower($0)
+        if (text ~ /test/ && text ~ /strictness/ && text ~ /level/)
+            ok = 1
+        --window
+    }
+    END { exit ok ? 0 : 1 }
+' out || fail "F5 missing nearby strictness-help description"
+
+echo "PASS"
+exit 0
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+
+
+
+
+export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Xmx3g -XX:+UseG1GC"
+export TEST_JVM_OPTS="${TEST_JVM_OPTS:-} -Xmx3g"
+
+export CPM_SOURCE_CACHE="${CPM_SOURCE_CACHE:-/opt/stage4a_cpm_cache}"
+set -e
+cd /workspace/repo
+exec bash /workspace/repo/usercase-test-coderl/usecase.sh
