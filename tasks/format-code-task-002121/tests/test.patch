+
+package core_test
+
+import (
+	"encoding/json"
+	"testing"
+
+	"go.opentelemetry.io/api/core"
+)
+
+func TestTraceIDFromHexValid(t *testing.T) {
+	for _, h := range []string{
+		"80f198ee56343ba864fe8b2a57d3eff7",
+		"0102030405060708090a0b0c0d0e0f10",
+		"ffffffffffffffffffffffffffffffff",
+		"00000000000000000000000000000001",
+	} {
+		tid, err := core.TraceIDFromHex(h)
+		if err != nil {
+			t.Errorf("expected %q to be valid, got error: %v", h, err)
+			continue
+		}
+
+		sc := core.SpanContext{TraceID: tid}
+		if got := sc.TraceIDString(); got != h {
+			t.Errorf("round-trip failed for %q: TraceIDString() = %q", h, got)
+		}
+		if !sc.HasTraceID() {
+			t.Errorf("expected HasTraceID() to be true for %q", h)
+		}
+	}
+}
+
+func TestTraceIDFromHexInvalid(t *testing.T) {
+	for _, testcase := range []struct {
+		name string
+		hex  string
+	}{
+		{"too short", "80f198ee56343ba864fe8b2a57d3eff"},
+		{"too long", "80f198ee56343ba864fe8b2a57d3eff700"},
+		{"empty", ""},
+		{"invalid character", "80f198ee56343ba864fe8b2a57d3efg7"},
+		{"uppercase letters", "80f198ee56343ba864fe8b2a57d3efF7"},
+		{"all zero", "00000000000000000000000000000000"},
+	} {
+		t.Run(testcase.name, func(t *testing.T) {
+			if _, err := core.TraceIDFromHex(testcase.hex); err == nil {
+				t.Errorf("expected error for %q, got nil", testcase.hex)
+			}
+		})
+	}
+}
+
+func TestTraceIDFromHexEquality(t *testing.T) {
+	a, err := core.TraceIDFromHex("0102030405060708090a0b0c0d0e0f10")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	b, err := core.TraceIDFromHex("0102030405060708090a0b0c0d0e0f10")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if a != b {
+		t.Errorf("parsing the same hex string produced different trace ids: %v vs %v", a, b)
+	}
+
+	c, err := core.TraceIDFromHex("0102030405060708090a0b0c0d0e0f11")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if a == c {
+		t.Errorf("parsing distinct hex strings produced equal trace ids: %v", a)
+	}
+}
+
+func TestSpanContextMarshalJSON(t *testing.T) {
+	tid, err := core.TraceIDFromHex("0102030405060708090a0b0c0d0e0f10")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	sc := core.SpanContext{
+		TraceID:    tid,
+		SpanID:     uint64(0x00000000075bcd15),
+		TraceFlags: core.TraceFlagsSampled,
+	}
+
+	data, err := json.Marshal(sc)
+	if err != nil {
+		t.Fatalf("json.Marshal returned error: %v", err)
+	}
+
+	var decoded map[string]interface{}
+	if err := json.Unmarshal(data, &decoded); err != nil {
+		t.Fatalf("could not unmarshal marshaled SpanContext %s: %v", data, err)
+	}
+
+	if got, ok := decoded["TraceID"].(string); !ok || got != sc.TraceIDString() {
+		t.Errorf("TraceID field = %#v, want hex string %q", decoded["TraceID"], sc.TraceIDString())
+	}
+
+	if got, ok := decoded["SpanID"].(string); !ok || got != sc.SpanIDString() {
+		t.Errorf("SpanID field = %#v, want hex string %q", decoded["SpanID"], sc.SpanIDString())
+	}
+
+	if got, ok := decoded["TraceFlags"].(float64); !ok || byte(got) != sc.TraceFlags {
+		t.Errorf("TraceFlags field = %#v, want numeric %d", decoded["TraceFlags"], sc.TraceFlags)
+	}
+}
diff --git a/mimo_test_command.sh b/mimo_test_command.sh
new file mode 100755
--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+
+
+
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd /testbed
+
+
+
+
+
+
+
+
+GOMODCACHE="$(go env GOMODCACHE)"
+rm -rf vendor
+mkdir -p vendor
+
+
+
+awk '
+  /^require \(/ {f=1; next}
+  /^\)/         {f=0}
+  f {
+      line=$0; sub(/\/\/.*/, "", line);
+      n=split(line, a, " ");
+      if (n >= 2) { print "# " a[1] " " a[2]; print "## explicit" }
+  }
+' go.mod > vendor/modules.txt
+
+
+mkdir -p vendor/github.com/google/go-cmp
+cp -r "${GOMODCACHE}"/github.com/google/go-cmp@v0.3.1/cmp \
+      vendor/github.com/google/go-cmp/cmp
+chmod -R u+w vendor
+
+
+go test -mod=vendor -count=1 \
+    -run 'TestIsValid|TestHasTraceID|TestHasSpanID|TestSpanIDString|TestTraceIDString|TestSpanContextIsSampled|TestBool|TestInt64|TestUint64|TestFloat64|TestInt32|TestUint32|TestFloat32|TestString|TestBytes|TestInt|TestUint|TestDefined|TestEmit' \
+    ./api/core/
+
+
+go test -mod=vendor -count=1 \
+    -run 'TestTraceIDFromHexValid|TestTraceIDFromHexInvalid|TestTraceIDFromHexEquality|TestSpanContextMarshalJSON' \
+    ./api/core/
