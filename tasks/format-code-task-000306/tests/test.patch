diff --git a/tests/test_sklearn_api.py b/tests/test_sklearn_api.py
new file mode 100644
index 0000000..80bc800
--- /dev/null
+++ b/tests/test_sklearn_api.py
@@ -0,0 +1,228 @@
+
+
+import pickle
+
+import numpy as np
+import pytest
+
+from sklearn.base import clone
+
+from tensorflow import keras
+
+from sklearn_keras_wrap.wrappers import KerasClassifier, KerasRegressor
+
+
+INPUT_DIM = 4
+N_SAMPLES = 30
+
+
+def _data(seed=0):
+    rng = np.random.RandomState(seed)
+    return rng.rand(N_SAMPLES, INPUT_DIM)
+
+
+def build_clf(hidden_dim=8, n_classes=3):
+    model = keras.Sequential(
+        [
+            keras.layers.Input((INPUT_DIM,)),
+            keras.layers.Dense(hidden_dim, activation="relu"),
+            keras.layers.Dense(n_classes, activation="softmax"),
+        ]
+    )
+    model.compile(
+        optimizer="adam",
+        loss="sparse_categorical_crossentropy",
+        metrics=["accuracy"],
+    )
+    return model
+
+
+def build_binary_single_output(hidden_dim=8):
+    model = keras.Sequential(
+        [
+            keras.layers.Input((INPUT_DIM,)),
+            keras.layers.Dense(hidden_dim, activation="relu"),
+            keras.layers.Dense(1, activation="sigmoid"),
+        ]
+    )
+    model.compile(
+        optimizer="adam", loss="binary_crossentropy", metrics=["accuracy"]
+    )
+    return model
+
+
+def build_reg(hidden_dim=8):
+    model = keras.Sequential(
+        [
+            keras.layers.Input((INPUT_DIM,)),
+            keras.layers.Dense(hidden_dim, activation="relu"),
+            keras.layers.Dense(1),
+        ]
+    )
+    model.compile(optimizer="adam", loss="mse")
+    return model
+
+
+class CallableClassBuilder:
+    def __call__(self, hidden_dim=8):
+        return build_clf(hidden_dim)
+
+
+class InheritedClassifier(KerasClassifier):
+    def __call__(self, hidden_dim=8):
+        return build_clf(hidden_dim)
+
+
+
+
+
+def test_get_params_contains_build_fn_and_extra_kwargs():
+    clf = KerasClassifier(build_fn=build_clf, hidden_dim=10)
+    params = clf.get_params()
+    assert params["build_fn"] is build_clf
+    assert params["hidden_dim"] == 10
+
+    assert clf.get_params(deep=False)["hidden_dim"] == 10
+
+
+def test_set_params_updates_and_returns_self():
+    clf = KerasClassifier(build_fn=build_clf, hidden_dim=10)
+    returned = clf.set_params(hidden_dim=4)
+    assert returned is clf
+    assert clf.get_params()["hidden_dim"] == 4
+
+
+def test_clone_returns_unfitted_equivalent():
+    clf = KerasClassifier(build_fn=build_clf, hidden_dim=7)
+    cloned = clone(clf)
+    assert cloned is not clf
+    assert cloned.get_params() == clf.get_params()
+
+    with pytest.raises(Exception):
+        cloned.predict(_data())
+
+
+def test_clone_works_for_subclass_build_fn_none():
+    clf = InheritedClassifier(build_fn=None, hidden_dim=6)
+    cloned = clone(clf)
+    assert isinstance(cloned, InheritedClassifier)
+    assert cloned.get_params() == clf.get_params()
+
+
+def test_clone_works_for_callable_class_instance():
+    clf = KerasClassifier(build_fn=CallableClassBuilder(), hidden_dim=6)
+    cloned = clone(clf)
+
+
+    assert isinstance(cloned, KerasClassifier)
+    assert not hasattr(cloned, "model_")
+
+
+
+
+
+def test_fit_returns_self_and_sets_classes():
+    X = _data()
+    y = np.array([1, 2, 5] * (N_SAMPLES // 3))
+    clf = KerasClassifier(build_fn=build_clf, hidden_dim=8)
+    returned = clf.fit(X, y, epochs=2, batch_size=8)
+    assert returned is clf
+    assert list(clf.classes_) == [1, 2, 5]
+    assert clf.n_classes_ == 3
+
+
+def test_predict_returns_original_labels():
+    X = _data()
+    y = np.array([1, 2, 5] * (N_SAMPLES // 3))
+    clf = KerasClassifier(build_fn=build_clf, hidden_dim=8)
+    clf.fit(X, y, epochs=2)
+    preds = clf.predict(X)
+    assert preds.shape == (N_SAMPLES,)
+    assert set(np.unique(preds)).issubset({1, 2, 5})
+
+
+def test_predict_proba_shape_and_normalization():
+    X = _data()
+    y = np.array([0, 1, 2] * (N_SAMPLES // 3))
+    clf = KerasClassifier(build_fn=build_clf, hidden_dim=8)
+    clf.fit(X, y, epochs=2)
+    proba = clf.predict_proba(X)
+    assert proba.shape == (N_SAMPLES, 3)
+    assert np.allclose(np.sum(proba, axis=1), np.ones(N_SAMPLES))
+
+
+def test_binary_single_output_returns_two_columns():
+    X = _data()
+    y = np.array([0, 1] * (N_SAMPLES // 2))
+    clf = KerasClassifier(build_fn=build_binary_single_output)
+    clf.fit(X, y, epochs=2)
+    proba = clf.predict_proba(X)
+    assert proba.shape == (N_SAMPLES, 2)
+    assert np.allclose(np.sum(proba, axis=1), np.ones(N_SAMPLES))
+    preds = clf.predict(X)
+    assert preds.shape == (N_SAMPLES,)
+    assert set(np.unique(preds)).issubset({0, 1})
+
+
+def test_score_is_accuracy_in_unit_interval():
+    X = _data()
+    y = np.array([0, 1, 2] * (N_SAMPLES // 3))
+    clf = KerasClassifier(build_fn=build_clf, hidden_dim=8)
+    clf.fit(X, y, epochs=2)
+    score = clf.score(X, y)
+    assert np.isscalar(score) or np.ndim(score) == 0
+    assert 0.0 <= float(score) <= 1.0
+
+    expected = np.mean(clf.predict(X) == y)
+    assert np.isclose(float(score), expected)
+
+
+def test_classifier_works_with_callable_class_and_subclass():
+    X = _data()
+    y = np.array([0, 1, 2] * (N_SAMPLES // 3))
+    for clf in (
+        KerasClassifier(build_fn=CallableClassBuilder(), hidden_dim=6),
+        InheritedClassifier(build_fn=None, hidden_dim=6),
+    ):
+        clf.fit(X, y, epochs=1)
+        assert clf.predict(X).shape == (N_SAMPLES,)
+
+
+
+
+
+def test_regressor_predict_and_score():
+    X = _data()
+    rng = np.random.RandomState(1)
+    y = rng.rand(N_SAMPLES)
+    reg = KerasRegressor(build_fn=build_reg, hidden_dim=8)
+    returned = reg.fit(X, y, epochs=2)
+    assert returned is reg
+    preds = reg.predict(X)
+    assert preds.shape == (N_SAMPLES,)
+    score = reg.score(X, y)
+
+    assert float(score) <= 1.0
+
+
+
+
+
+def test_classifier_pickle_roundtrip_predictions():
+    X = _data()
+    y = np.array([0, 1, 2] * (N_SAMPLES // 3))
+    clf = KerasClassifier(build_fn=build_clf, hidden_dim=8)
+    clf.fit(X, y, epochs=2)
+    restored = pickle.loads(pickle.dumps(clf))
+    assert np.array_equal(restored.predict(X), clf.predict(X))
+    assert np.allclose(restored.predict_proba(X), clf.predict_proba(X))
+
+
+def test_regressor_pickle_roundtrip_predictions():
+    X = _data()
+    rng = np.random.RandomState(2)
+    y = rng.rand(N_SAMPLES)
+    reg = KerasRegressor(build_fn=build_reg, hidden_dim=8)
+    reg.fit(X, y, epochs=2)
+    restored = pickle.loads(pickle.dumps(reg))
+    assert np.allclose(restored.predict(X), reg.predict(X))
