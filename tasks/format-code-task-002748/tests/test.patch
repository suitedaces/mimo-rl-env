diff --git a/test/keyprefix.js b/test/keyprefix.js
index 8b17adc..30f14ca 100644
--- a/test/keyprefix.js
+++ b/test/keyprefix.js
@@ -160,4 +160,157 @@ describe('keyprefix', () => {
         .then(status => expect(status).toBe('OK'))
         .then(() => expect(redis2.data.get('hello')).toBe('ioredis')));
   });
+
+  describe('createConnectedClient with different keyPrefix', () => {
+    it('should return null on connected client with different prefix when parent has data', () => {
+      const redis1 = new MockRedis({
+        data: {
+          foo: 'bar',
+          hello: 'world',
+        },
+        keyPrefix: 'test:',
+      });
+      const redis2 = redis1.createConnectedClient({
+        keyPrefix: 'test2:',
+      });
+
+      return redis2.get('foo').then(result => expect(result).toBe(null));
+    });
+
+    it('should not let one prefix read a key set by another prefix (connected clients off shared base)', () => {
+      const redisBase = new MockRedis({
+        data: {
+          foo: 'bar',
+          hello: 'world',
+        },
+      });
+      const redis1 = redisBase.createConnectedClient({
+        keyPrefix: 'test:',
+      });
+      const redis2 = redis1.createConnectedClient({
+        keyPrefix: 'test2:',
+      });
+
+      return redis2
+        .set('hello', 'ioredis')
+        .then(status => expect(status).toBe('OK'))
+        .then(() => redis1.get('hello'))
+        .then(result => expect(result).toBe(null));
+    });
+
+    it('parent should still see its own pre-existing data after a different-prefix connected client is created', () => {
+      const redis1 = new MockRedis({
+        data: { foo: 'bar' },
+        keyPrefix: 'test:',
+      });
+
+      redis1.createConnectedClient({ keyPrefix: 'test2:' });
+
+      return redis1.get('foo').then(result => expect(result).toBe('bar'));
+    });
+
+    it('connected client with a different prefix can read its own writes', () => {
+      const redis1 = new MockRedis({
+        data: { foo: 'bar' },
+        keyPrefix: 'test:',
+      });
+      const redis2 = redis1.createConnectedClient({
+        keyPrefix: 'test2:',
+      });
+
+      return redis2
+        .set('foo', 'baz')
+        .then(status => expect(status).toBe('OK'))
+        .then(() => redis2.get('foo'))
+        .then(result => expect(result).toBe('baz'));
+    });
+
+    it('a set by a different-prefix connected client must not be visible through the parent prefix', () => {
+      const redis1 = new MockRedis({
+        data: { foo: 'bar' },
+        keyPrefix: 'test:',
+      });
+      const redis2 = redis1.createConnectedClient({
+        keyPrefix: 'test2:',
+      });
+
+      return redis2
+        .set('foo', 'baz')
+        .then(() => redis1.get('foo'))
+        .then(result => expect(result).toBe('bar'));
+    });
+
+    it('two connected clients with the SAME prefix should share data', () => {
+      const redisBase = new MockRedis();
+      const redisA = redisBase.createConnectedClient({ keyPrefix: 'same:' });
+      const redisB = redisBase.createConnectedClient({ keyPrefix: 'same:' });
+
+      return redisA
+        .set('shared', 'yes')
+        .then(() => redisB.get('shared'))
+        .then(result => expect(result).toBe('yes'));
+    });
+
+    it('del on a connected client with a different prefix must not delete the parent prefix key', () => {
+      const redis1 = new MockRedis({
+        data: { foo: 'bar' },
+        keyPrefix: 'test:',
+      });
+      const redis2 = redis1.createConnectedClient({
+        keyPrefix: 'test2:',
+      });
+
+      return redis2
+        .set('foo', 'baz')
+        .then(() => redis2.del('foo'))
+        .then(numDeleted => expect(numDeleted).toBe(1))
+        .then(() => redis1.get('foo'))
+        .then(result => expect(result).toBe('bar'));
+    });
+
+    it('exists on different-prefix connected client returns 0 for parent keys that only exist under parent prefix', () => {
+      const redis1 = new MockRedis({
+        data: { foo: 'bar' },
+        keyPrefix: 'test:',
+      });
+      const redis2 = redis1.createConnectedClient({
+        keyPrefix: 'test2:',
+      });
+
+      return redis2.exists('foo').then(result => expect(result).toBe(0));
+    });
+
+    it('flushdb on a connected client clears data across all prefixes (shared DB semantics)', () => {
+      const redis1 = new MockRedis({
+        data: { foo: 'bar' },
+        keyPrefix: 'test:',
+      });
+      const redis2 = redis1.createConnectedClient({
+        keyPrefix: 'test2:',
+      });
+
+      return redis2
+        .set('hello', 'world')
+        .then(() => redis2.flushdb())
+        .then(() => redis1.get('foo'))
+        .then(result => expect(result).toBe(null));
+    });
+
+    it('expire set by one prefix must not affect another prefix key with the same logical name', () => {
+      const redis1 = new MockRedis({
+        data: { foo: 'bar' },
+        keyPrefix: 'test:',
+      });
+      const redis2 = redis1.createConnectedClient({
+        keyPrefix: 'test2:',
+      });
+
+
+      return redis2
+        .expire('foo', 1000)
+        .then(result => expect(result).toBe(0))
+        .then(() => redis1.get('foo'))
+        .then(result => expect(result).toBe('bar'));
+    });
+  });
 });
