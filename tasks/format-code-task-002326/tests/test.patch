+"use strict";
+
+const prettier = require("prettier/local");
+
+function format(input) {
+  return prettier.format(input, { parser: "html" });
+}
+
+test("issue: paired IE conditional with closing-only tags should not throw", () => {
+  const input = [
+    "<!DOCTYPE html>",
+    "<html>",
+    "  <head>",
+    '    <meta name="viewport" content="width=device-width, initial-scale=1" />',
+    "    <title></title>",
+    "  </head>",
+    "",
+    '  <body width="100%" align="center">',
+    "    <center>",
+    '      <!--[if (gte mso 9)|(IE)]><table cellpadding="0" cellspacing="0" border="0" width="600" align="center"><tr><td><![endif]-->',
+    "      <div></div>",
+    "      <!--[if (gte mso 9)|(IE)]></td></tr></table><![endif]-->",
+    "    </center>",
+    "  </body>",
+    "</html>",
+    ""
+  ].join("\n");
+
+  let output;
+  expect(() => {
+    output = format(input);
+  }).not.toThrow();
+
+  expect(output).toBe(
+    [
+      "<!DOCTYPE html>",
+      "<html>",
+      "  <head>",
+      '    <meta name="viewport" content="width=device-width, initial-scale=1" />',
+      "    <title></title>",
+      "  </head>",
+      "",
+      '  <body width="100%" align="center">',
+      "    <center>",
+      '      <!--[if (gte mso 9)|(IE)]><table cellpadding="0" cellspacing="0" border="0" width="600" align="center"><tr><td><![endif]-->',
+      "      <div></div>",
+      "      <!--[if (gte mso 9)|(IE)]></td></tr></table><![endif]-->",
+      "    </center>",
+      "  </body>",
+      "</html>",
+      ""
+    ].join("\n")
+  );
+});
+
+test("closing-only IE conditional comment at root formats unchanged", () => {
+  const input = "<!--[if IE]></td></tr></table><![endif]-->\n";
+  const output = format(input);
+  expect(output).toBe("<!--[if IE]></td></tr></table><![endif]-->\n");
+});
+
+test("closing-only IE conditional comment inside an element does not throw", () => {
+  const input = "<div>\n  <!--[if IE]></td></tr></table><![endif]-->\n</div>\n";
+  expect(() => format(input)).not.toThrow();
+
+
+  const output = format(input);
+  expect(output).toContain("<!--[if IE]></td></tr></table><![endif]-->");
+});
+
+test("valid IE conditional comment with parseable content still formats", () => {
+  const input = "<!--[if IE 5]>This is IE 5<br><![endif]-->\n";
+  const output = format(input);
+  expect(output).toBe("<!--[if IE 5]>This is IE 5<br /><![endif]-->\n");
+});
+
+test("IE conditional comment with only opening tag (pre-existing case) still works", () => {
+  const input =
+    '<!--[if lt IE 9]><html lang="zh-CN"><div><![endif]-->\n<html lang="zh-CN">\n  <head></head>\n  <body></body>\n</html>\n';
+  expect(() => format(input)).not.toThrow();
+  const output = format(input);
+  expect(output).toContain(
+    '<!--[if lt IE 9]><html lang="zh-CN"><div><![endif]-->'
+  );
+});
+
+test("whitespace inside an unparseable IE conditional comment is preserved verbatim", () => {
+  const input = "<div>\n<!--[if IE]>  </td>  hello  <![endif]-->\n</div>\n";
+  const output = format(input);
+
+
+  expect(output).toContain("<!--[if IE]>  </td>  hello  <![endif]-->");
+});
+
+test("multiline content of unparseable IE conditional comment is preserved", () => {
+  const input =
+    "<div>\n  <!--[if IE]></td>\n  </tr></table><![endif]-->\n</div>\n";
+  const output = format(input);
+
+  expect(output).toContain("<!--[if IE]></td>\n  </tr></table><![endif]-->");
+});
