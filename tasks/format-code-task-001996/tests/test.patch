+#!/bin/bash
+set -euo pipefail
+
+cd /testbed
+
+dev-switch node 20
+
+if [ ! -x ./node_modules/.bin/mocha ] || [ ! -d ./node_modules/babel-register ]; then
+  npm install --legacy-peer-deps --ignore-scripts
+fi
+
+NORMAL_TEST_GREP='accepts false as an unselected index on mount and update|hides active selection and indicator when index is false|accepts false for single-tab and scrollable layouts without invalid-index feedback|clears a visible indicator when updating to false|does not throw and warns for out-of-range indexes|does not throw and warns for additional invalid indexes|keeps updates safe when the selected tab cannot be resolved|keeps unresolved selection safe for non-fixture indexes|keeps width-only updates safe before tab refs resolve'
+DEV_TEST_GREP='keeps false valid and hidden in development mode'
+ALL_TEST_GREP="$NORMAL_TEST_GREP|$DEV_TEST_GREP"
+
+case "${1:-}" in
+  base)
+    NODE_ENV=test NODE_NO_WARNINGS=1 ./node_modules/.bin/mocha \
+      src/Tabs/Tabs.spec.js \
+      src/test-utils/consoleErrorMock.spec.js \
+      --grep "$ALL_TEST_GREP" \
+      --invert
+    ;;
+  new)
+    NODE_ENV=test NODE_NO_WARNINGS=1 ./node_modules/.bin/mocha \
+      src/Tabs/Tabs.spec.js \
+      --grep "$NORMAL_TEST_GREP"
+    NODE_ENV=development NODE_NO_WARNINGS=1 ./node_modules/.bin/mocha \
+      src/Tabs/Tabs.spec.js \
+      --grep "$DEV_TEST_GREP"
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
