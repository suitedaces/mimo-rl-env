diff --git a/test/unit/view/server-side-rendering.spec.js b/test/unit/view/server-side-rendering.spec.js
new file mode 100644
index 00000000..30a81d4a
--- /dev/null
+++ b/test/unit/view/server-side-rendering.spec.js
@@ -0,0 +1,76 @@
+
+import createStyleMarshal from '../../../src/view/style-marshal/style-marshal';
+import { resetServerContext } from '../../../src/';
+import type { StyleMarshal } from '../../../src/view/style-marshal/style-marshal-types';
+
+describe('server side rendering', () => {
+  beforeEach(() => {
+    jest.spyOn(console, 'error').mockImplementation(() => { });
+  });
+
+  afterEach(() => {
+    console.error.mockRestore();
+  });
+
+  it('should export resetServerContext as a function from the package entry point', () => {
+    expect(resetServerContext).toBeDefined();
+    expect(typeof resetServerContext).toBe('function');
+  });
+
+  it('should increment the styleContext on each call to createStyleMarshal by default', () => {
+    const first: StyleMarshal = createStyleMarshal();
+    const second: StyleMarshal = createStyleMarshal();
+    const third: StyleMarshal = createStyleMarshal();
+
+
+    expect(Number(second.styleContext)).toBe(Number(first.styleContext) + 1);
+    expect(Number(third.styleContext)).toBe(Number(second.styleContext) + 1);
+  });
+
+  it('should reset the counter so the next createStyleMarshal returns styleContext "0"', () => {
+
+    createStyleMarshal();
+    createStyleMarshal();
+    createStyleMarshal();
+
+
+    resetServerContext();
+
+    const after: StyleMarshal = createStyleMarshal();
+    expect(after.styleContext).toBe('0');
+  });
+
+  it('should support being called repeatedly across simulated server renders', () => {
+
+    resetServerContext();
+    const firstRender: StyleMarshal = createStyleMarshal();
+    expect(firstRender.styleContext).toBe('0');
+
+
+    resetServerContext();
+    const secondRender: StyleMarshal = createStyleMarshal();
+    expect(secondRender.styleContext).toBe('0');
+
+
+    resetServerContext();
+    const thirdRender: StyleMarshal = createStyleMarshal();
+    expect(thirdRender.styleContext).toBe('0');
+  });
+
+  it('should continue incrementing from 0 after a reset', () => {
+    resetServerContext();
+    const first: StyleMarshal = createStyleMarshal();
+    const second: StyleMarshal = createStyleMarshal();
+    const third: StyleMarshal = createStyleMarshal();
+
+    expect(first.styleContext).toBe('0');
+    expect(second.styleContext).toBe('1');
+    expect(third.styleContext).toBe('2');
+  });
+
+  it('should not raise or change behaviour when resetServerContext is called before any marshal is created', () => {
+    resetServerContext();
+    const marshal: StyleMarshal = createStyleMarshal();
+    expect(marshal.styleContext).toBe('0');
+  });
+});
