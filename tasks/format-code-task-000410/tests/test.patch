diff --git a/tests/providers/google/cloud/transfers/test_bigquery_to_gcs.py b/tests/providers/google/cloud/transfers/test_bigquery_to_gcs.py
index 3360084642..46313d2210 100644
--- a/tests/providers/google/cloud/transfers/test_bigquery_to_gcs.py
+++ b/tests/providers/google/cloud/transfers/test_bigquery_to_gcs.py
@@ -152,3 +152,68 @@ class TestBigQueryToGCSOperator:
             retry=DEFAULT_RETRY,
             nowait=True,
         )
+
+
+class TestBigQueryToGCSOperatorNowait:
+    """Tests for the fix that BigQueryToGCSOperator must wait for completion in non-deferrable mode."""
+
+    @mock.patch("airflow.providers.google.cloud.transfers.bigquery_to_gcs.BigQueryHook")
+    def test_execute_non_deferrable_passes_nowait_false(self, mock_hook):
+        """In default (non-deferrable) mode, insert_job must be called with nowait=False
+        so the operator waits for completion. Regression for issue where nowait=True
+        caused BigQueryToGCSOperator to return before CSVs were written."""
+        source_project_dataset_table = f"{PROJECT_ID}:{TEST_DATASET}.{TEST_TABLE_ID}"
+        destination_cloud_storage_uris = ["gs://some-bucket/some-file.txt"]
+        job_id = "123456"
+        hash_ = "hash"
+        real_job_id = f"{job_id}_{hash_}"
+
+        mock_hook.return_value.split_tablename.return_value = (PROJECT_ID, TEST_DATASET, TEST_TABLE_ID)
+        mock_hook.return_value.generate_job_id.return_value = real_job_id
+        mock_hook.return_value.insert_job.return_value = MagicMock(job_id="real_job_id", error_result=False)
+        mock_hook.return_value.project_id = PROJECT_ID
+
+        operator = BigQueryToGCSOperator(
+            task_id=TASK_ID,
+            source_project_dataset_table=source_project_dataset_table,
+            destination_cloud_storage_uris=destination_cloud_storage_uris,
+        )
+        operator.execute(context=mock.MagicMock())
+
+
+        _, kwargs = mock_hook.return_value.insert_job.call_args
+        assert kwargs["nowait"] is False, (
+            f"In non-deferrable mode, insert_job must be called with nowait=False so the "
+            f"operator waits for completion; got nowait={kwargs.get('nowait')!r}."
+        )
+
+    @mock.patch("airflow.providers.google.cloud.transfers.bigquery_to_gcs.BigQueryHook")
+    def test_execute_deferrable_passes_nowait_true(self, mock_hook):
+        """In deferrable mode, insert_job must be called with nowait=True so the
+        operator submits the job and defers immediately to the trigger."""
+        source_project_dataset_table = f"{PROJECT_ID}:{TEST_DATASET}.{TEST_TABLE_ID}"
+        destination_cloud_storage_uris = ["gs://some-bucket/some-file.txt"]
+        job_id = "123456"
+        hash_ = "hash"
+        real_job_id = f"{job_id}_{hash_}"
+
+        mock_hook.return_value.split_tablename.return_value = (PROJECT_ID, TEST_DATASET, TEST_TABLE_ID)
+        mock_hook.return_value.generate_job_id.return_value = real_job_id
+        mock_hook.return_value.insert_job.return_value = MagicMock(job_id="real_job_id", error_result=False)
+        mock_hook.return_value.project_id = PROJECT_ID
+
+        operator = BigQueryToGCSOperator(
+            project_id=PROJECT_ID,
+            task_id=TASK_ID,
+            source_project_dataset_table=source_project_dataset_table,
+            destination_cloud_storage_uris=destination_cloud_storage_uris,
+            deferrable=True,
+        )
+        with pytest.raises(TaskDeferred):
+            operator.execute(context=mock.MagicMock())
+
+        _, kwargs = mock_hook.return_value.insert_job.call_args
+        assert kwargs["nowait"] is True, (
+            f"In deferrable mode, insert_job must be called with nowait=True; "
+            f"got nowait={kwargs.get('nowait')!r}."
+        )
