diff --git a/test/codespec-redirect-rewrite-test.js b/test/codespec-redirect-rewrite-test.js
new file mode 100644
index 0000000..244e0f2
--- /dev/null
+++ b/test/codespec-redirect-rewrite-test.js
@@ -0,0 +1,55 @@
+var expect = require('expect.js');
+var rewrite = require('../lib/http-proxy/passes/web-outgoing').setRedirectHostRewrite;
+
+function apply(statusCode, location, options, request) {
+  var proxyRes = { statusCode: statusCode, headers: { location: location } };
+  rewrite(request || { headers: { host: 'public.example:8443' } }, {}, proxyRes, options || {});
+  return proxyRes.headers.location;
+}
+
+describe('redirect location rewriting', function() {
+  it('autoRewrite follows the public host and port on a 301 redirect', function() {
+    expect(apply(301, 'http://internal.example/login?next=1', { autoRewrite: true }))
+      .to.eql('http://public.example:8443/login?next=1');
+  });
+
+  it('autoRewrite also handles a 308 redirect', function() {
+    expect(apply(308, 'https://internal.example/final', { autoRewrite: true }))
+      .to.eql('https://public.example:8443/final');
+  });
+
+  it('protocolRewrite changes only the scheme', function() {
+    expect(apply(302, 'http://internal.example/login?next=1', { protocolRewrite: 'https' }))
+      .to.eql('https://internal.example/login?next=1');
+  });
+
+  it('explicit hostRewrite wins over autoRewrite while protocol remains independent', function() {
+    expect(apply(307, 'http://internal.example/path?q=1', {
+      hostRewrite: 'canonical.example:9443', autoRewrite: true, protocolRewrite: 'https'
+    }, { headers: { host: 'public.example:8080' } }))
+      .to.eql('https://canonical.example:9443/path?q=1');
+  });
+
+  it('uses the request host without its default port when autoRewrite is enabled', function() {
+    expect(apply(301, 'http://internal.example/path', { autoRewrite: true },
+      { headers: { host: 'public.example:80' } }))
+      .to.eql('http://public.example/path');
+  });
+
+  it('does not rewrite relative locations', function() {
+    expect(apply(301, '/relative/path?x=1', {
+      autoRewrite: true, protocolRewrite: 'https', hostRewrite: 'canonical.example'
+    })).to.eql('/relative/path?x=1');
+  });
+
+  it('does not rewrite Location on non-redirect responses', function() {
+    expect(apply(200, 'http://internal.example/not-a-redirect', {
+      autoRewrite: true, protocolRewrite: 'https', hostRewrite: 'canonical.example'
+    })).to.eql('http://internal.example/not-a-redirect');
+  });
+
+  it('leaves absolute redirects unchanged when rewriting options are omitted', function() {
+    expect(apply(301, 'http://internal.example/unchanged', {}))
+      .to.eql('http://internal.example/unchanged');
+  });
+});
