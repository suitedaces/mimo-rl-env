+def _assert_agent_error_shape(body):
+    assert isinstance(body, dict)
+    assert isinstance(body.get("message"), dict)
+    assert isinstance(body["message"].get("text"), str)
+    assert body["message"]["text"]
+    nested_payloads = [
+        value
+        for key, value in body.items()
+        if key != "message" and isinstance(value, dict)
+    ]
+    assert nested_payloads
+    assert any(
+        isinstance(value, str) and value
+        for payload in nested_payloads
+        for value in payload.values()
+    )
+
+
+def _diagnostic_text(body):
+    return _text_blob(body)
+
+
+def test_agent_exception_is_returned_as_structured_response(dummy_agent):
+    client = testclient.TestClient(dummy_agent.app(), raise_server_exceptions=False)
+    response = client.post(
+        "/raises_agent_exception",
+        json={"message": {"text": "Howdy"}},
+        headers={"Authorization": "Bearer fixie-test-token"},
+    )
+
+    assert response.status_code == 409
+    body = response.json()
+    _assert_agent_error_shape(body)
+    assert body["message"]["text"] == "Please try the custom path again."
+    assert _contains_value(body, "ERR_CUSTOM_VISIBLE")
+    assert _contains_value(body, "The custom failure was intentional.")
+    assert _contains_value(body, 7)
+
+
+def test_unknown_func_returns_structured_agent_response(dummy_agent):
+    client = testclient.TestClient(dummy_agent.app(), raise_server_exceptions=False)
+    headers = {"Authorization": "Bearer fixie-test-token"}
+
+    for missing_name in ("not_registered_alpha", "not_registered_beta"):
+        response = client.post(
+            f"/{missing_name}",
+            json={"message": {"text": "Howdy"}},
+            headers=headers,
+        )
+
+        assert response.status_code == 404
+        body = response.json()
+        _assert_agent_error_shape(body)
+        assert missing_name in _text_blob(body)
+
+
+@pytest.mark.parametrize(
+    "func_name",
+    [
+        "raises_value_error",
+        "raises_runtime_error",
+    ],
+)
+def test_unhandled_func_exception_returns_structured_error(dummy_agent, func_name):
+    client = testclient.TestClient(dummy_agent.app(), raise_server_exceptions=False)
+    response = client.post(
+        f"/{func_name}",
+        json={"message": {"text": "Howdy"}},
+        headers={"Authorization": "Bearer fixie-test-token"},
+    )
+
+    assert response.status_code >= 500
+    body = response.json()
+    _assert_agent_error_shape(body)
+
+
+def test_user_storage_rejects_anonymous_request_through_agent_route(
