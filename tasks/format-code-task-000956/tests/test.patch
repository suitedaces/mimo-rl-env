+
+def _claims(*, anonymous=False, agent_id="fake agent id", bearer="fake token"):
+    attempts = (
+        lambda: token.VerifiedTokenClaims(
+            agent_id=agent_id, is_anonymous=anonymous, token=bearer
+        ),
+        lambda: token.VerifiedTokenClaims(agent_id, anonymous, bearer),
+        lambda: token.VerifiedTokenClaims(
+            agent_id=agent_id, anonymous=anonymous, bearer_token=bearer
+        ),
+    )
+    for make_claims in attempts:
+        try:
+            return make_claims()
+        except TypeError:
+            pass
+    return _FakeClaims(anonymous=anonymous, agent_id=agent_id, bearer=bearer)
+
+
+def _make_agent_exception(
+    response_message,
+    error_code,
+    error_message,
+    http_status_code,
+    **details,
+):
+    attempts = (
+        lambda: exceptions.AgentException(
+            response_message=response_message,
+            error_code=error_code,
+            error_message=error_message,
+            http_status_code=http_status_code,
+            **details,
+        ),
+        lambda: exceptions.AgentException(
+            response_message, error_code, error_message, http_status_code, **details
+        ),
+        lambda: exceptions.AgentException(
+            message=response_message,
+            code=error_code,
+            error_message=error_message,
+            status_code=http_status_code,
+            details=details,
+        ),
+    )
+    for make_exception in attempts:
+        try:
+            return make_exception()
+        except TypeError:
+            pass
+    raise AssertionError("AgentException did not accept a structured public payload")
+
+
+def _walk_values(obj):
+    yield obj
+    if isinstance(obj, dict):
+        for value in obj.values():
+            yield from _walk_values(value)
+    elif isinstance(obj, (list, tuple)):
+        for value in obj:
+            yield from _walk_values(value)
+
+
+def _text_blob(obj):
+    return " ".join(str(value) for value in _walk_values(obj))
+
+
+def _contains_value(obj, expected):
+    return any(value == expected for value in _walk_values(obj))
+
+
