--- /dev/null
+++ b/mimo_test_command.sh
@@ -0,0 +1,44 @@
+#!/bin/bash
+set -uo pipefail
+
+cd /testbed
+
+
+set +u
+source /testbed/.build_env/venv/bin/activate
+set -u
+
+
+
+pip install --no-input /testbed 2>&1 | tail -3
+
+case "${1:-}" in
+  base)
+    python -m pytest \
+      --import-mode=importlib \
+      fixieai/agents/agent_base_test.py::test_registering_func_with_custom_name \
+      fixieai/agents/agent_base_test.py::test_invalid_token \
+      fixieai/agents/standalone_test.py::test_invalid_token \
+      -v
+    ;;
+  new)
+    python -m pytest \
+      --import-mode=importlib \
+      fixieai/agents/agent_base_test.py::test_simple_agent_func_calls \
+      fixieai/agents/agent_base_test.py::test_agent_exception_is_returned_as_structured_response \
+      fixieai/agents/agent_base_test.py::test_unknown_func_returns_structured_agent_response \
+      fixieai/agents/agent_base_test.py::test_unhandled_func_exception_returns_structured_error \
+      fixieai/agents/agent_base_test.py::test_user_storage_rejects_anonymous_request_through_agent_route \
+      fixieai/agents/agent_func_test.py::test_create_from_python_type_coercion \
+      fixieai/agents/agent_func_test.py::test_custom_argument_mapper_receives_verified_claims \
+      fixieai/agents/standalone_test.py::test_standalone_query_stream \
+      fixieai/agents/standalone_test.py::test_streaming_func_exception_yields_error_response \
+      fixieai/agents/user_storage_test.py::test_user_storage \
+      fixieai/agents/user_storage_test.py::test_user_storage_constructor_rejects_anonymous_claims \
+      -v
+    ;;
+  *)
+    echo "usage: $0 base|new"
+    exit 2
+    ;;
+esac
