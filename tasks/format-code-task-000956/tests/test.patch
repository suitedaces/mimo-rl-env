+def test_custom_argument_mapper_receives_verified_claims():
+    observed = {}
+
+    claims = _claims(
+        agent_id="agent-from-claims",
+        anonymous=True,
+        bearer="bearer-token-from-claims",
+    )
+
+    def mapper(query, received_claims):
+        observed["claims"] = received_claims
+        observed["agent_id"] = _claim_value(
+            received_claims, "agent_id", "agent_identity"
+        )
+        observed["bearer"] = _claim_value(
+            received_claims, "token", "bearer_token", "access_token"
+        )
+        observed["anonymous"] = _claim_value(
+            received_claims, "is_anonymous", "anonymous"
+        )
+        return "claims observed"
+
+    def impl(mapped_claim_data):
+        return mapped_claim_data
+
+    func = agent_func.AgentFunc(
+        impl=impl,
+        argument_mappers=[("mapped_claim_data", mapper)],
+        allow_multiple_responses=False,
+    )
+
+    responses = list(func(api.AgentQuery(api.Message("ignored")), claims))
+
+    observed_claims = observed["claims"]
+    assert observed_claims is claims
+    assert observed["agent_id"] == "agent-from-claims"
+    assert observed["bearer"] == "bearer-token-from-claims"
+    assert observed["anonymous"] is True
+    assert responses[0].message.text == "claims observed"
