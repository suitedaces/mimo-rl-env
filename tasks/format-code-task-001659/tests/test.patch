+import copy
+import json
+import subprocess
+import sys
+
+import pytest
+
+from pdfplumber.utils import dedupe_chars
+
+
+def test_default_extra_attrs_collapse_near_duplicates_and_keep_other_text():
+
+
+
+
+    chars = [
+        {
+            "id": "lead",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        },
+        {
+            "id": "dup",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.4,
+            "x0": 20.5,
+        },
+        {
+            "id": "other",
+            "text": "B",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 12.0,
+            "x0": 25.0,
+        },
+    ]
+
+    actual = dedupe_chars(chars)
+
+    assert actual == [
+        {
+            "id": "lead",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        },
+        {
+            "id": "other",
+            "text": "B",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 12.0,
+            "x0": 25.0,
+        },
+    ]
+    assert (actual is chars) is False
+
+
+def test_default_extra_attrs_keep_different_fontname():
+
+
+
+
+    chars = [
+        {
+            "id": "f1",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        },
+        {
+            "id": "f2",
+            "text": "A",
+            "upright": True,
+            "fontname": "F2",
+            "size": 12,
+            "doctop": 10.4,
+            "x0": 20.5,
+        },
+    ]
+
+    assert dedupe_chars(chars) == [
+        {
+            "id": "f1",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        },
+        {
+            "id": "f2",
+            "text": "A",
+            "upright": True,
+            "fontname": "F2",
+            "size": 12,
+            "doctop": 10.4,
+            "x0": 20.5,
+        },
+    ]
+
+
+def test_empty_extra_attrs_ignores_fontname_difference():
+
+
+
+
+    chars = [
+        {
+            "id": "f1",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        },
+        {
+            "id": "f2",
+            "text": "A",
+            "upright": True,
+            "fontname": "F2",
+            "size": 12,
+            "doctop": 10.4,
+            "x0": 20.5,
+        },
+    ]
+
+    assert dedupe_chars(chars, extra_attrs=()) == [
+        {
+            "id": "f1",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        }
+    ]
+
+
+def test_lower_tolerance_keeps_positions_outside_tolerance():
+
+
+
+
+    chars = [
+        {
+            "id": "base",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        },
+        {
+            "id": "near_but_outside",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.2,
+            "x0": 20.0,
+        },
+    ]
+
+    assert dedupe_chars(chars, tolerance=0.1) == [
+        {
+            "id": "base",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        },
+        {
+            "id": "near_but_outside",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.2,
+            "x0": 20.0,
+        },
+    ]
+
+
+def test_cluster_keeps_smallest_position_then_returns_original_input_order():
+
+
+
+
+    chars = [
+        {
+            "id": "first_kept_later_position",
+            "text": "Q",
+            "upright": True,
+            "fontname": "F1",
+            "size": 11,
+            "doctop": 50.5,
+            "x0": 8.0,
+        },
+        {
+            "id": "different_text_between",
+            "text": "Z",
+            "upright": True,
+            "fontname": "F1",
+            "size": 11,
+            "doctop": 40.0,
+            "x0": 1.0,
+        },
+        {
+            "id": "cluster_smallest_position",
+            "text": "Q",
+            "upright": True,
+            "fontname": "F1",
+            "size": 11,
+            "doctop": 50.0,
+            "x0": 7.5,
+        },
+    ]
+
+    assert dedupe_chars(chars) == [
+        {
+            "id": "different_text_between",
+            "text": "Z",
+            "upright": True,
+            "fontname": "F1",
+            "size": 11,
+            "doctop": 40.0,
+            "x0": 1.0,
+        },
+        {
+            "id": "cluster_smallest_position",
+            "text": "Q",
+            "upright": True,
+            "fontname": "F1",
+            "size": 11,
+            "doctop": 50.0,
+            "x0": 7.5,
+        },
+    ]
+
+
+def test_different_upright_values_do_not_collapse():
+
+
+
+
+    chars = [
+        {
+            "id": "upright",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        },
+        {
+            "id": "rotated",
+            "text": "A",
+            "upright": False,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.2,
+            "x0": 20.2,
+        },
+    ]
+
+    assert dedupe_chars(chars) == [
+        {
+            "id": "upright",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        },
+        {
+            "id": "rotated",
+            "text": "A",
+            "upright": False,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.2,
+            "x0": 20.2,
+        },
+    ]
+
+
+def test_empty_input_returns_empty_new_list():
+
+
+
+
+    chars = []
+
+    actual = dedupe_chars(chars)
+
+    assert actual == []
+    assert (actual is chars) is False
+
+
+@pytest.mark.parametrize(
+    "chars,kwargs",
+    [
+        ([{"upright": True, "fontname": "F1", "size": 12, "doctop": 10.0, "x0": 20.0}], {}),
+        ([{"text": "A", "fontname": "F1", "size": 12, "doctop": 10.0, "x0": 20.0}], {}),
+        ([{"text": "A", "upright": True, "fontname": "F1", "size": 12, "x0": 20.0}], {}),
+        ([{"text": "A", "upright": True, "fontname": "F1", "size": 12, "doctop": 10.0}], {}),
+        ([{"text": "A", "upright": True, "size": 12, "doctop": 10.0, "x0": 20.0}], {}),
+        (
+            [
+                {
+                    "text": "A",
+                    "upright": True,
+                    "fontname": "F1",
+                    "size": 12,
+                    "doctop": 10.0,
+                    "x0": 20.0,
+                }
+            ],
+            {"extra_attrs": ("color",)},
+        ),
+    ],
+)
+def test_missing_required_or_requested_fields_raise_keyerror(chars, kwargs):
+
+
+
+
+    with pytest.raises(KeyError):
+        dedupe_chars(chars, **kwargs)
+
+
+def test_referential_transparency_for_equal_calls():
+    chars = [
+        {
+            "id": "base",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        },
+        {
+            "id": "dup",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.5,
+            "x0": 20.4,
+        },
+    ]
+
+    assert dedupe_chars(chars) == dedupe_chars(chars)
+
+
+def test_does_not_mutate_input_list_or_character_dicts():
+    chars = [
+        {
+            "id": "base",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        },
+        {
+            "id": "dup",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.5,
+            "x0": 20.4,
+        },
+    ]
+    original = copy.deepcopy(chars)
+
+    dedupe_chars(chars)
+
+    assert chars == original
+
+
+def test_no_global_state_matches_fresh_process_result():
+    chars = [
+        {
+            "id": "base",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        },
+        {
+            "id": "dup",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.5,
+            "x0": 20.4,
+        },
+        {
+            "id": "other",
+            "text": "B",
+            "upright": True,
+            "fontname": "F2",
+            "size": 10,
+            "doctop": 5.0,
+            "x0": 2.0,
+        },
+    ]
+    in_process = dedupe_chars(chars)
+    chars_json = json.dumps(chars)
+    script = f"""
+import json
+import sys
+sys.path.insert(0, "/workspace/repo")
+from pdfplumber.utils import dedupe_chars
+chars = json.loads({chars_json!r})
+sys.stdout.write(json.dumps(dedupe_chars(chars), sort_keys=True))
+"""
+
+    completed = subprocess.run(
+        [sys.executable, "-c", script],
+        check=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+
+    assert json.loads(completed.stdout) == in_process
+
+
+def test_default_call_dedupes_without_requiring_side_effect_instrumentation():
+    chars = [
+        {
+            "id": "base",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        },
+        {
+            "id": "dup",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.5,
+            "x0": 20.4,
+        },
+    ]
+
+    actual = dedupe_chars(chars)
+
+
+    assert actual == [
+        {
+            "id": "base",
+            "text": "A",
+            "upright": True,
+            "fontname": "F1",
+            "size": 12,
+            "doctop": 10.0,
+            "x0": 20.0,
+        }
+    ]
