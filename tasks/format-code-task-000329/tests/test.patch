+import io
+import json
 import os
 from pathlib import Path
 from typing import Any, Mapping
@@ -161,3 +163,54 @@ class TestJsonlParser(AbstractTestParser):
                 "fails": [],
             },
         }
+
+
+def _jsonl_bytes(rows):
+    payload = "".join(json.dumps(row) + "\n" for row in rows)
+    return io.BytesIO(payload.encode("utf-8"))
+
+
+def test_jsonl_nested_objects_do_not_prevent_record_emission():
+    parser = JsonlParser({"filetype": "jsonl"})
+    rows_with_scalar = [
+        {"id": 1, "meta": {"foo": "bar"}},
+        {"id": 2, "meta": {"baz": "qux", "count": 3}},
+    ]
+
+    inferred_schema = parser.get_inferred_schema(_jsonl_bytes(rows_with_scalar))
+    assert "id" in inferred_schema
+
+    records = list(parser.stream_records(_jsonl_bytes(rows_with_scalar)))
+    assert len(records) == len(rows_with_scalar)
+    assert [record.get("id") for record in records] == [1, 2]
+
+    object_only_rows = [
+        {"details": {"name": "alpha"}},
+        {"context": {"name": "beta", "nested": {"ok": True}}},
+        {"extra": {"items": [1, 2, 3]}},
+    ]
+    object_only_records = list(parser.stream_records(_jsonl_bytes(object_only_rows)))
+    assert len(object_only_records) == len(object_only_rows)
+
+
+def test_jsonl_flat_scalar_records_still_stream():
+    parser = JsonlParser({"filetype": "jsonl"})
+    rows = [
+        {"id": 10, "name": "alice", "active": True},
+        {"id": 11, "name": "bob", "active": False},
+    ]
+
+    assert list(parser.stream_records(_jsonl_bytes(rows))) == rows
+
+def test_jsonl_nested_objects_stream_with_inferred_master_schema():
+    rows = [
+        {"id": 1, "profile": {"name": "alpha"}},
+        {"id": 2, "profile": {"name": "beta", "nested": {"ok": True}}},
+    ]
+
+    inferred_schema = JsonlParser({"filetype": "jsonl"}).get_inferred_schema(_jsonl_bytes(rows))
+    parser = JsonlParser({"filetype": "jsonl"}, master_schema=inferred_schema)
+    records = list(parser.stream_records(_jsonl_bytes(rows)))
+
+    assert len(records) == len(rows)
+    assert [record.get("id") for record in records] == [1, 2]
diff --git a/airbyte-integrations/connectors/source-s3/unit_tests/test_source_metadata.py b/airbyte-integrations/connectors/source-s3/unit_tests/test_source_metadata.py
