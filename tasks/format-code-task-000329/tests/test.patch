--- /dev/null
+++ b/airbyte-integrations/connectors/source-s3/unit_tests/test_source_metadata.py
@@ -0,0 +1,22 @@
+import re
+from pathlib import Path
+
+
+REPO_ROOT = Path(__file__).resolve().parents[4]
+
+
+def test_s3_version_metadata_is_consistent():
+    source_definitions = (REPO_ROOT / "airbyte-config/init/src/main/resources/seed/source_definitions.yaml").read_text()
+    source_specs = (REPO_ROOT / "airbyte-config/init/src/main/resources/seed/source_specs.yaml").read_text()
+    dockerfile = (REPO_ROOT / "airbyte-integrations/connectors/source-s3/Dockerfile").read_text()
+
+
+    s3_definition_pattern = (
+        r"- name: S3\s+"
+        r"sourceDefinitionId: [^\n]+\s+"
+        r"dockerRepository: airbyte/source-s3\s+"
+        r"dockerImageTag: 0\.1\.20\b"
+    )
+    assert re.search(s3_definition_pattern, source_definitions)
+    assert 'dockerImage: "airbyte/source-s3:0.1.20"' in source_specs
+    assert "LABEL io.airbyte.version=0.1.20" in dockerfile
