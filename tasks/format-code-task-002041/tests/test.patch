diff --git a/test/unit/spans/span-event-default-limit.test.js b/test/unit/spans/span-event-default-limit.test.js
new file mode 100644
index 000000000..c411111c3
--- /dev/null
+++ b/test/unit/spans/span-event-default-limit.test.js
@@ -0,0 +1,139 @@
+
+
+
+
+
+'use strict'
+
+const tap = require('tap')
+const sinon = require('sinon')
+
+const SpanEventAggregator = require('../../../lib/spans/span-event-aggregator')
+const Metrics = require('../../../lib/metrics')
+
+const RUN_ID = 1337
+const EXPECTED_DEFAULT_LIMIT = 2000
+const DEFAULT_PERIOD = 60000
+
+function makeAggregator() {
+  return new SpanEventAggregator(
+    {
+      runId: RUN_ID,
+      limit: EXPECTED_DEFAULT_LIMIT,
+      periodMs: DEFAULT_PERIOD
+    },
+    {},
+    new Metrics(5, {}, {})
+  )
+}
+
+tap.test(
+  'SpanEventAggregator default limit should be 2000 when max_samples_stored is empty string',
+  (t) => {
+    const aggregator = makeAggregator()
+    const fakeConfig = {
+      getAggregatorConfig: sinon.stub().returns(null),
+      span_events: {
+        enabled: true,
+        max_samples_stored: ''
+      }
+    }
+
+    aggregator.reconfigure(fakeConfig)
+
+    t.equal(aggregator.limit, 2000, 'limit should default to 2000')
+    t.equal(aggregator._items.limit, 2000, 'queue limit should be 2000')
+    t.not(aggregator.limit, 1000, 'limit should not be the old default of 1000')
+    t.end()
+  }
+)
+
+tap.test(
+  'SpanEventAggregator default limit should be 2000 when max_samples_stored is undefined',
+  (t) => {
+    const aggregator = makeAggregator()
+    const fakeConfig = {
+      getAggregatorConfig: sinon.stub().returns(null),
+      span_events: {
+        enabled: true
+
+      }
+    }
+
+    aggregator.reconfigure(fakeConfig)
+
+    t.equal(aggregator.limit, 2000, 'limit should default to 2000 when missing')
+    t.equal(aggregator._items.limit, 2000, 'queue limit should be 2000 when missing')
+    t.end()
+  }
+)
+
+tap.test(
+  'SpanEventAggregator default limit should be 2000 when max_samples_stored is 0',
+  (t) => {
+    const aggregator = makeAggregator()
+    const fakeConfig = {
+      getAggregatorConfig: sinon.stub().returns(null),
+      span_events: {
+        enabled: true,
+        max_samples_stored: 0
+      }
+    }
+
+    aggregator.reconfigure(fakeConfig)
+
+    t.equal(aggregator.limit, 2000, 'limit should default to 2000 when zero')
+    t.equal(aggregator._items.limit, 2000, 'queue limit should be 2000 when zero')
+    t.end()
+  }
+)
+
+tap.test(
+  'SpanEventAggregator should report 2000 as Supportability/SpanEvent/Limit metric when default applies',
+  (t) => {
+    const aggregator = makeAggregator()
+    const recordValueStub = sinon.stub()
+    aggregator._metrics.getOrCreateMetric = sinon
+      .stub()
+      .returns({ recordValue: recordValueStub })
+
+    const fakeConfig = {
+      getAggregatorConfig: sinon.stub().returns(null),
+      span_events: {
+        enabled: true,
+        max_samples_stored: ''
+      }
+    }
+
+    aggregator.reconfigure(fakeConfig)
+
+    t.equal(
+      aggregator._metrics.getOrCreateMetric.args[0][0],
+      'Supportability/SpanEvent/Limit',
+      'should name event appropriately'
+    )
+    t.equal(recordValueStub.args[0][0], 2000, 'should record default limit of 2000')
+    t.end()
+  }
+)
+
+tap.test(
+  'SpanEventAggregator should still honor explicit max_samples_stored (preservation)',
+  (t) => {
+    const aggregator = makeAggregator()
+    const expectedLimit = 5000
+    const fakeConfig = {
+      getAggregatorConfig: sinon.stub().returns(null),
+      span_events: {
+        enabled: true,
+        max_samples_stored: expectedLimit
+      }
+    }
+
+    aggregator.reconfigure(fakeConfig)
+
+    t.equal(aggregator.limit, expectedLimit, 'should respect explicit configured limit')
+    t.equal(aggregator._items.limit, expectedLimit, 'queue limit should respect configured')
+    t.end()
+  }
+)
