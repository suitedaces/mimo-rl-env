@@ -0,0 +1,8 @@
+#!/bin/bash
+set -euo pipefail
+
+/opt/cirq_venv/bin/python -m pytest -q -W ignore::DeprecationWarning \
+  cirq/measurement_key_mapping_test.py \
+  cirq/protocols/measurement_key_test.py \
+  cirq/ops/common_gates_test.py \
+  -k measurement
