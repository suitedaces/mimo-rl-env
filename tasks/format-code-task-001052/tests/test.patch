diff --git a/cirq/measurement_key_mapping_test.py b/cirq/measurement_key_mapping_test.py
new file mode 100644
index 00000000..11111111
--- /dev/null
+++ b/cirq/measurement_key_mapping_test.py
@@ -0,0 +1,117 @@
+import pytest
+
+import cirq
+
+
+def test_protocol_dispatches_to_magic_method():
+    class Carrier:
+        def _with_measurement_key_mapping_(self, key_map):
+            return ('mapped', key_map)
+
+    assert cirq.with_measurement_key_mapping(
+        Carrier(), {'old': 'new'}) == ('mapped', {'old': 'new'})
+
+
+def test_protocol_no_method_fallback_and_error():
+    assert cirq.with_measurement_key_mapping(
+        object(), {'old': 'new'}, default=None) is None
+    with pytest.raises(TypeError, match='with_measurement_key_mapping'):
+        cirq.with_measurement_key_mapping(object(), {'old': 'new'})
+
+
+def test_protocol_not_implemented_fallback_and_error():
+    class ReturnsNotImplemented:
+        def _with_measurement_key_mapping_(self, key_map):
+            return NotImplemented
+
+    assert cirq.with_measurement_key_mapping(
+        ReturnsNotImplemented(), {'old': 'new'}, default='unchanged') == 'unchanged'
+    with pytest.raises(TypeError, match='with_measurement_key_mapping'):
+        cirq.with_measurement_key_mapping(
+            ReturnsNotImplemented(), {'old': 'new'})
+
+
+def test_measurement_gate_mapping_is_simultaneous_and_keeps_unmapped_keys():
+    gate = cirq.MeasurementGate(2, key='a', invert_mask=(True, False))
+    mapped = cirq.with_measurement_key_mapping(gate, {'a': 'b', 'b': 'c'})
+
+    assert isinstance(mapped, cirq.MeasurementGate)
+    assert mapped.key == 'b'
+    assert cirq.with_measurement_key_mapping(
+        cirq.MeasurementGate(1, key='untouched'), {'a': 'b'}).key == 'untouched'
+
+
+def test_measurement_gate_mapping_preserves_metadata_and_source():
+    gate = cirq.MeasurementGate(2, key='a', invert_mask=(True, False))
+    mapped = cirq.with_measurement_key_mapping(gate, {'a': 'renamed'})
+
+    assert mapped.num_qubits() == 2
+    assert mapped.invert_mask == (True, False)
+    assert gate.key == 'a'
+
+
+def test_gate_operation_propagates_mapping_and_leaves_other_ops_equal():
+    q0 = cirq.LineQubit(0)
+    op = cirq.MeasurementGate(1, key='m', invert_mask=(True,)).on(q0)
+    mapped_op = cirq.with_measurement_key_mapping(op, {'m': 'renamed'})
+    assert mapped_op.qubits == op.qubits
+    assert mapped_op.gate.key == 'renamed'
+    assert mapped_op.gate.invert_mask == (True,)
+    non_measurement = cirq.X(q0)
+    assert cirq.with_measurement_key_mapping(
+        non_measurement, {'m': 'renamed'}) == non_measurement
+
+
+def test_controlled_operation_propagates_mapping():
+    q0, q1 = cirq.LineQubit.range(2)
+
+    controlled = cirq.ControlledOperation([q0], cirq.measure(q1, key='m'))
+    mapped_controlled = cirq.with_measurement_key_mapping(
+        controlled, {'m': 'renamed'})
+    assert isinstance(mapped_controlled, cirq.ControlledOperation)
+    assert mapped_controlled.controls == controlled.controls
+    assert mapped_controlled.sub_operation.gate.key == 'renamed'
+
+
+def _circuit_with_two_measurements():
+    q0, q1 = cirq.GridQubit(0, 0), cirq.GridQubit(0, 1)
+    return cirq.Circuit.from_ops(
+        cirq.measure(q0, key='a', invert_mask=(True,)),
+        cirq.X(q1),
+        cirq.measure(q1, key='b'),
+        device=cirq.google.Foxtail)
+
+
+def test_moment_mapping_preserves_structure():
+    circuit = _circuit_with_two_measurements()
+    q1 = cirq.GridQubit(0, 1)
+
+    mapped_moment = cirq.with_measurement_key_mapping(
+        circuit[0], {'a': 'b', 'b': 'c'})
+    assert [cirq.measurement_key(op) for op in mapped_moment.operations
+            if cirq.is_measurement(op)] == ['b']
+    assert mapped_moment.operations[0].gate.invert_mask == (True,)
+    assert mapped_moment.operations[1] == cirq.X(q1)
+
+
+def test_circuit_mapping_preserves_structure_device_and_source():
+    circuit = _circuit_with_two_measurements()
+    device = circuit.device
+
+    mapped = cirq.with_measurement_key_mapping(circuit, {'a': 'b', 'b': 'c'})
+    assert mapped is not circuit
+    assert mapped.device is device
+    assert len(mapped) == len(circuit)
+    assert [cirq.measurement_key(op) for op in mapped.all_operations()
+            if cirq.is_measurement(op)] == ['b', 'c']
+    assert [cirq.measurement_key(op) for op in circuit.all_operations()
+            if cirq.is_measurement(op)] == ['a', 'b']
+
+
+def test_circuit_mapping_is_visible_in_qasm():
+    mapped = cirq.with_measurement_key_mapping(
+        _circuit_with_two_measurements(), {'a': 'b', 'b': 'c'})
+    qasm = cirq.qasm(mapped)
+    assert "m_b[0]" in qasm
+    assert "m_c[0]" in qasm
+    assert "m_a[0]" not in qasm
