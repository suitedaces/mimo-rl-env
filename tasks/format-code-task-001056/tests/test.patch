new file mode 100644
index 0000000000..5da6d30fa8
--- /dev/null
+++ b/pkg/util/table-filter/import_recursive_test.go
@@ -0,0 +1,57 @@
+
+
+package filter_test
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	filter "github.com/pingcap/tidb/pkg/util/table-filter"
+	"github.com/stretchr/testify/require"
+)
+
+func writeFilterFile(t *testing.T, path, contents string) {
+	t.Helper()
+	require.NoError(t, os.MkdirAll(filepath.Dir(path), 0755))
+	require.NoError(t, os.WriteFile(path, []byte(contents), 0644))
+}
+
+func TestRecursiveImportsResolveRelativeToIncludingFile(t *testing.T) {
+	dir := t.TempDir()
+	root := filepath.Join(dir, "root.rules")
+	allow := filepath.Join(dir, "sub", "allow.rules")
+	deep := filepath.Join(dir, "sub", "nested", "allow.rules")
+
+	writeFilterFile(t, root, "!db.*\n@sub/allow.rules\n")
+	writeFilterFile(t, allow, "!db.keep\n@nested/allow.rules\n")
+	writeFilterFile(t, deep, "db.keep\n")
+
+	f, err := filter.Parse([]string{"@" + root})
+	require.NoError(t, err)
+	require.True(t, f.MatchTable("db", "keep"), "the deepest include must override earlier exclusions")
+	require.False(t, f.MatchTable("db", "drop"))
+
+	columnsRoot := filepath.Join(dir, "columns", "root.rules")
+	writeFilterFile(t, columnsRoot, "!secret\n@nested.rules\n")
+	writeFilterFile(t, filepath.Join(dir, "columns", "nested.rules"), "secret\n")
+	cf, err := filter.ParseColumnFilter([]string{"@" + columnsRoot})
+	require.NoError(t, err)
+	require.True(t, cf.MatchColumn("secret"))
+	require.False(t, cf.MatchColumn("other"))
+}
+
+func TestRecursiveImportCycleIsReported(t *testing.T) {
+	dir := t.TempDir()
+	a := filepath.Join(dir, "a.rules")
+	b := filepath.Join(dir, "nested", "b.rules")
+	writeFilterFile(t, a, "@nested/b.rules\n")
+	writeFilterFile(t, b, "@../a.rules\n")
+
+	_, err := filter.Parse([]string{"@" + a})
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "cycle")
+	require.Contains(t, err.Error(), filepath.Base(a))
+	require.Contains(t, err.Error(), filepath.Base(b))
+}
