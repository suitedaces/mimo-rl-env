--- a/tests/test_parser.py
+++ b/tests/test_parser.py
@@ -191,3 +191,17 @@ class TestParser(unittest.TestCase):
             "Expected table name",
             logger,
         )
+
+    def test_in_subquery_still_works(self):
+
+        expr = parse_one("x IN (SELECT y FROM t)")
+        self.assertIsInstance(expr, exp.In)
+        self.assertIsNotNone(expr.args.get("query"))
+
+    def test_in_list_still_works(self):
+
+        expr = parse_one("x IN (1, 2, 3)")
+        self.assertIsInstance(expr, exp.In)
+        exprs = expr.args.get("expressions")
+        self.assertEqual(len(exprs), 3)
+        self.assertEqual(expr.sql(), "x IN (1, 2, 3)")
