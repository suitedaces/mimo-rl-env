--- a/tests/dialects/test_clickhouse.py
+++ b/tests/dialects/test_clickhouse.py
@@ -1,9 +1,31 @@
+from sqlglot import exp, parse_one
+
 from tests.dialects.test_dialect import Validator
 
 
 class TestClickhouse(Validator):
     dialect = "clickhouse"
 
+    def test_in_function_call_clickhouse(self):
+
+        expr = parse_one("'a' IN mapKeys(map('a', 1, 'b', 2))", read="clickhouse")
+        self.assertIsInstance(expr, exp.In)
+
+        self.assertEqual(
+            expr.sql(dialect="clickhouse"),
+            "'a' IN mapKeys(map('a', 1, 'b', 2))",
+        )
+
+    def test_in_function_call_clickhouse_identity(self):
+
+        self.validate_identity("'a' IN mapKeys(map('a', 1, 'b', 2))")
+
+    def test_in_function_call_clickhouse_simple(self):
+
+        expr = parse_one("x IN someFunc(y)", read="clickhouse")
+        self.assertIsInstance(expr, exp.In)
+        self.assertEqual(expr.sql(dialect="clickhouse"), "x IN someFunc(y)")
+
     def test_clickhouse(self):
         self.validate_identity("dictGet(x, 'y')")
         self.validate_identity("SELECT * FROM x FINAL")
diff --git a/tests/test_parser.py b/tests/test_parser.py
