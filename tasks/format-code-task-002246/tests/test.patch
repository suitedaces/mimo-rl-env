diff --git a/usercase-test-coderl/convert_to_paragraph_test.go b/usercase-test-coderl/convert_to_paragraph_test.go
new file mode 100644
--- /dev/null
+++ b/usercase-test-coderl/convert_to_paragraph_test.go
@@ -0,0 +1,357 @@
+package usercase_test_coderl
+
+import (
+	"errors"
+	"os"
+	"reflect"
+	"strings"
+	"testing"
+
+	"pault.ag/go/debian/control"
+)
+
+
+
+
+
+
+type basicFixture struct {
+	Foo     string
+	Count   int
+	Enabled bool
+}
+
+type taggedFixture struct {
+	Package  string   `control:"Source"`
+	Arches   []string `control:"Architecture" delim:", "`
+	Empty    string
+	Required string `required:"true"`
+}
+
+type skippedFixture struct {
+	First  string
+	Secret string `control:"-"`
+	Last   string
+}
+
+type pointerScalarFixture struct {
+	Pointer  *string `control:"Pointer"`
+	Words    []string
+	Signed   int
+	Unsigned uint
+	Disabled bool
+	Note     string `multiline:"true"`
+}
+
+type embeddedFixture struct {
+	control.Paragraph
+	Source string `control:"Source"`
+	Count  int
+}
+
+type customValue struct {
+	Text string
+}
+
+func (c customValue) MarshalControl() (string, error) {
+	return "custom:" + c.Text, nil
+}
+
+type customFixture struct {
+	Field customValue `control:"Custom"`
+}
+
+var errMarshalSentinel = errors.New("sentinel marshal failure")
+
+type failingValue struct{}
+
+func (f failingValue) MarshalControl() (string, error) {
+	return "", errMarshalSentinel
+}
+
+type failingFixture struct {
+	Field failingValue `control:"Failure"`
+}
+
+type plainNested struct {
+	Value string
+}
+
+type badNestedFixture struct {
+	Field plainNested `control:"Nested"`
+}
+
+func requireParagraph(t *testing.T, actual *control.Paragraph, expectedOrder []string, expectedValues map[string]string) {
+	t.Helper()
+	if actual == nil {
+		t.Fatal("ConvertToParagraph returned nil paragraph")
+	}
+	if !reflect.DeepEqual(actual.Order, expectedOrder) {
+		t.Fatalf("Order mismatch:\nactual:   %#v\nexpected: %#v", actual.Order, expectedOrder)
+	}
+	if !reflect.DeepEqual(actual.Values, expectedValues) {
+		t.Fatalf("Values mismatch:\nactual:   %#v\nexpected: %#v", actual.Values, expectedValues)
+	}
+}
+
+func mustConvert(t *testing.T, incoming interface{}) *control.Paragraph {
+	t.Helper()
+	paragraph, err := control.ConvertToParagraph(incoming)
+	if err != nil {
+		t.Fatalf("ConvertToParagraph returned error: %v", err)
+	}
+	return paragraph
+}
+
+
+
+func TestConvertToParagraphBasicPrimitiveFields(t *testing.T) {
+	input := &basicFixture{Foo: "hello", Count: 2, Enabled: true}
+	actual := mustConvert(t, input)
+	requireParagraph(t, actual,
+		[]string{"Foo", "Count", "Enabled"},
+		map[string]string{"Foo": "hello", "Count": "2", "Enabled": "yes"},
+	)
+}
+
+
+
+func TestConvertToParagraphSkipsHyphenTaggedFields(t *testing.T) {
+	input := &skippedFixture{First: "alpha", Secret: "hidden", Last: "omega"}
+	actual := mustConvert(t, input)
+	requireParagraph(t, actual,
+		[]string{"First", "Last"},
+		map[string]string{"First": "alpha", "Last": "omega"},
+	)
+}
+
+
+
+func TestConvertToParagraphTaggedRequiredAndDelimitedFields(t *testing.T) {
+	input := &taggedFixture{Package: "demo", Arches: []string{"amd64", "arm64"}}
+	actual := mustConvert(t, input)
+	requireParagraph(t, actual,
+		[]string{"Source", "Architecture", "Required"},
+		map[string]string{"Source": "demo", "Architecture": "amd64, arm64", "Required": ""},
+	)
+}
+
+
+
+func TestConvertToParagraphPointersScalarsDefaultSliceAndMultiline(t *testing.T) {
+	pointed := "target"
+	input := &pointerScalarFixture{
+		Pointer:  &pointed,
+		Words:    []string{"one", "two", "three"},
+		Signed:   -7,
+		Unsigned: 42,
+		Disabled: false,
+		Note:     "line one\nline two",
+	}
+	actual := mustConvert(t, input)
+	requireParagraph(t, actual,
+		[]string{"Pointer", "Words", "Signed", "Unsigned", "Disabled", "Note"},
+		map[string]string{
+			"Pointer":  "target",
+			"Words":    "one two three",
+			"Signed":   "-7",
+			"Unsigned": "42",
+			"Disabled": "no",
+			"Note":     "\nline one\nline two",
+		},
+	)
+}
+
+
+
+func TestConvertToParagraphEmbeddedParagraphIsPreservedAndOverlaid(t *testing.T) {
+	input := &embeddedFixture{
+		Paragraph: control.Paragraph{
+			Order: []string{"X-Unknown", "Source", "Trailing"},
+			Values: map[string]string{
+				"X-Unknown": "keep me",
+				"Source":    "old-source",
+				"Trailing":  "after-source",
+			},
+		},
+		Source: "new-source",
+		Count:  7,
+	}
+	actual := mustConvert(t, input)
+	if actual == nil {
+		t.Fatal("ConvertToParagraph returned nil paragraph")
+	}
+	expectedValues := map[string]string{
+		"X-Unknown": "keep me",
+		"Source":    "new-source",
+		"Trailing":  "after-source",
+		"Count":     "7",
+	}
+	if !reflect.DeepEqual(actual.Values, expectedValues) {
+		t.Fatalf("Values mismatch:\nactual:   %#v\nexpected: %#v", actual.Values, expectedValues)
+	}
+
+
+	seen := map[string]int{}
+	sourceIndex, countIndex := -1, -1
+	for i, key := range actual.Order {
+		seen[key]++
+		if key == "Source" {
+			sourceIndex = i
+		}
+		if key == "Count" {
+			countIndex = i
+		}
+	}
+	if !reflect.DeepEqual(seen, map[string]int{"X-Unknown": 1, "Source": 1, "Trailing": 1, "Count": 1}) {
+		t.Fatalf("Order must contain preserved and derived fields exactly once, got %#v", actual.Order)
+	}
+	if sourceIndex == -1 || countIndex == -1 || sourceIndex > countIndex {
+		t.Fatalf("derived field order mismatch: Source index %d, Count index %d, order %#v", sourceIndex, countIndex, actual.Order)
+	}
+}
+
+
+
+func TestConvertToParagraphUsesMarshallableStructValue(t *testing.T) {
+	input := &customFixture{Field: customValue{Text: "value"}}
+	actual := mustConvert(t, input)
+	requireParagraph(t, actual,
+		[]string{"Custom"},
+		map[string]string{"Custom": "custom:value"},
+	)
+}
+
+
+
+func TestConvertToParagraphPropagatesMarshallableError(t *testing.T) {
+	_, err := control.ConvertToParagraph(&failingFixture{Field: failingValue{}})
+	if !errors.Is(err, errMarshalSentinel) {
+		t.Fatalf("expected sentinel marshal error, got %v", err)
+	}
+}
+
+
+
+func TestConvertToParagraphRejectsNonPointer(t *testing.T) {
+	_, err := control.ConvertToParagraph(basicFixture{Foo: "hello", Count: 2, Enabled: true})
+
+	if err == nil {
+		t.Fatal("expected non-pointer error, got nil")
+	}
+}
+
+
+
+func TestConvertToParagraphRejectsPointerToNonStruct(t *testing.T) {
+	input := []string{"not", "a", "struct"}
+	_, err := control.ConvertToParagraph(&input)
+
+	if err == nil {
+		t.Fatal("expected pointer-to-non-struct error, got nil")
+	}
+}
+
+
+
+func TestConvertToParagraphRejectsNestedStructWithoutMarshallable(t *testing.T) {
+	_, err := control.ConvertToParagraph(&badNestedFixture{Field: plainNested{Value: "raw"}})
+
+	if err == nil || !strings.Contains(err.Error(), "plainNested") {
+		t.Fatalf("expected nested struct error naming plainNested, got %v", err)
+	}
+}
+
+func TestConvertToParagraphReferentialTransparency(t *testing.T) {
+	input := &basicFixture{Foo: "hello", Count: 2, Enabled: true}
+	first := mustConvert(t, input)
+	second := mustConvert(t, input)
+	if !reflect.DeepEqual(first, second) {
+		t.Fatalf("same input produced different paragraphs:\nfirst:  %#v\nsecond: %#v", first, second)
+	}
+	requireParagraph(t, second,
+		[]string{"Foo", "Count", "Enabled"},
+		map[string]string{"Foo": "hello", "Count": "2", "Enabled": "yes"},
+	)
+}
+
+func TestConvertToParagraphDoesNotMutateInput(t *testing.T) {
+	pointed := "target"
+	input := &pointerScalarFixture{
+		Pointer:  &pointed,
+		Words:    []string{"one", "two", "three"},
+		Signed:   -7,
+		Unsigned: 42,
+		Disabled: false,
+		Note:     "line one\nline two",
+	}
+	pointedCopy := *input.Pointer
+	before := &pointerScalarFixture{
+		Pointer:  &pointedCopy,
+		Words:    append([]string(nil), input.Words...),
+		Signed:   input.Signed,
+		Unsigned: input.Unsigned,
+		Disabled: input.Disabled,
+		Note:     input.Note,
+	}
+	_ = mustConvert(t, input)
+	if !reflect.DeepEqual(input, before) {
+		t.Fatalf("input mutated:\nafter:  %#v\nbefore: %#v", input, before)
+	}
+}
+
+func TestConvertToParagraphNoGlobalStateWithNoiseInputs(t *testing.T) {
+	input := &basicFixture{Foo: "hello", Count: 2, Enabled: true}
+	first := mustConvert(t, input)
+
+	_ = mustConvert(t, &taggedFixture{Package: "demo", Arches: []string{"amd64", "arm64"}})
+	pointed := "target"
+	_ = mustConvert(t, &pointerScalarFixture{
+		Pointer:  &pointed,
+		Words:    []string{"one", "two", "three"},
+		Signed:   -7,
+		Unsigned: 42,
+		Disabled: false,
+		Note:     "line one\nline two",
+	})
+
+	second := mustConvert(t, input)
+	if !reflect.DeepEqual(first, second) {
+		t.Fatalf("paragraph changed after noise inputs:\nfirst:  %#v\nsecond: %#v", first, second)
+	}
+	requireParagraph(t, second,
+		[]string{"Foo", "Count", "Enabled"},
+		map[string]string{"Foo": "hello", "Count": "2", "Enabled": "yes"},
+	)
+}
+
+func TestConvertToParagraphDoesNotWriteCurrentDirectory(t *testing.T) {
+	oldwd, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd failed: %v", err)
+	}
+	defer func() {
+		if err := os.Chdir(oldwd); err != nil {
+			t.Fatalf("failed to restore cwd: %v", err)
+		}
+	}()
+
+	dir := t.TempDir()
+	if err := os.Chdir(dir); err != nil {
+		t.Fatalf("Chdir failed: %v", err)
+	}
+	before, err := os.ReadDir(".")
+	if err != nil {
+		t.Fatalf("ReadDir before call failed: %v", err)
+	}
+
+	_ = mustConvert(t, &basicFixture{Foo: "hello", Count: 2, Enabled: true})
+
+	after, err := os.ReadDir(".")
+	if err != nil {
+		t.Fatalf("ReadDir after call failed: %v", err)
+	}
+	if !reflect.DeepEqual(before, after) {
+		t.Fatalf("current directory changed:\nbefore: %#v\nafter:  %#v", before, after)
+	}
+}
